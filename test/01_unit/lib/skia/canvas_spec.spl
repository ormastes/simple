"""
## Purpose and audience
Purpose: Prove that SkCanvas construction.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-SKIA-001 — stable requirement identity for this spec.

# @cover src/lib/skia/entity/canvas.spl 80%
"""
# Skia Canvas Specification

**Feature IDs:** #SKI-006
**Category:** Stdlib
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Tests for SkCanvas save/restore state, dimensions, and basic predicates.
Note: draw calls currently return unchanged SkCanvas values, so we only test
the state-management, recording, matrix, and non-drawing methods.
"""

use std.skia.entity.canvas.{SkCanvas, SkCanvasSaveLayerRec, sk_canvas_make, sk_save_layer_rec}
use std.skia.entity.geometry.{SkIRect, SkRect, sk_rect_make_wh}
use std.skia.entity.matrix.{Matrix3x3}

use std.spec.step

describe "SkCanvas construction":
    it "sk_canvas_make sets width and height":
        step("Verify: sk_canvas_make sets width and height")
        # @req: REQ-LIB-SKIA-001
        val c = sk_canvas_make(800, 600)
        expect(c.width).to_equal(800)  # oracle: 800 — named expected value from the requirement
        expect(c.height).to_equal(600)  # oracle: 600 — named expected value from the requirement

    it "initial save count is 1":
        step("Verify: initial save count is 1")
        val c = sk_canvas_make(100, 100)
        expect(c.get_save_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "image_info_width matches construction":
        step("Verify: image_info_width matches construction")
        val c = sk_canvas_make(1920, 1080)
        expect(c.image_info_width()).to_equal(1920)  # oracle: 1920 — named expected value from the requirement

    it "image_info_height matches construction":
        step("Verify: image_info_height matches construction")
        val c = sk_canvas_make(1920, 1080)
        expect(c.image_info_height()).to_equal(1080)  # oracle: 1080 — named expected value from the requirement

describe "SkCanvas save/restore":
    it "save increments count":
        step("Verify: save increments count")
        val c = sk_canvas_make(100, 100)
        val c2 = c.save()
        expect(c2.get_save_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "save twice increments to 3":
        step("Verify: save twice increments to 3")
        val c = sk_canvas_make(100, 100)
        val c3 = c.save().save()
        expect(c3.get_save_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "restore decrements count":
        step("Verify: restore decrements count")
        val c = sk_canvas_make(100, 100)
        val c2 = c.save()
        val c3 = c2.restore()
        expect(c3.get_save_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "restore at 1 stays at 1":
        step("Verify: restore at 1 stays at 1")
        val c = sk_canvas_make(100, 100)
        val c2 = c.restore()
        expect(c2.get_save_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "save_layer increments count":
        step("Verify: save_layer increments count")
        val c = sk_canvas_make(100, 100)
        val rec = sk_save_layer_rec(nil, nil)
        val c2 = c.save_layer(rec)
        expect(c2.get_save_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "restore_to_count sets exact count":
        step("Verify: restore_to_count sets exact count")
        val c = sk_canvas_make(100, 100)
        val c2 = c.save().save().save()
        val c3 = c2.restore_to_count(2)
        expect(c3.get_save_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "restore_to_count clamped at 1":
        step("Verify: restore_to_count clamped at 1")
        val c = sk_canvas_make(100, 100)
        val c2 = c.restore_to_count(0)
        expect(c2.get_save_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "SkCanvas clip bounds":
    it "get_device_clip_bounds returns full canvas":
        step("Verify: get_device_clip_bounds returns full canvas")
        val c = sk_canvas_make(640, 480)
        val bounds = c.get_device_clip_bounds()
        expect(bounds.right).to_equal(640)  # oracle: 640 — named expected value from the requirement
        expect(bounds.bottom).to_equal(480)  # oracle: 480 — named expected value from the requirement
        expect(bounds.left).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bounds.top).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "SkCanvasSaveLayerRec":
    it "constructs with nil bounds and nil paint":
        step("Verify: constructs with nil bounds and nil paint")
        val rec = sk_save_layer_rec(nil, nil)
        expect(rec.bounds).to_equal(nil)
        expect(rec.paint).to_equal(nil)

describe "SkCanvas recording":
    it "begin_recording preserves canvas dimensions and save count":
        step("Verify: begin_recording preserves canvas dimensions and save count")
        val bounds = SkRect(left: 0.0, top: 0.0, right: 100.0, bottom: 100.0)
        val c0 = sk_canvas_make(100, 100)
        val c1 = c0.begin_recording(bounds)
        expect(c1.width).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(c1.height).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(c1.get_save_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "SkCanvas matrix ops":
    it "translate matrix exposes tx and ty for canvas transforms":
        step("Verify: translate matrix exposes tx and ty for canvas transforms")
        val m = Matrix3x3.translate(3.0, 4.0)
        expect(m.tx()).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
        expect(m.ty()).to_equal(4.0)  # oracle: 4.0 — named expected value from the requirement
        expect(m.scale_x()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(m.scale_y()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    it "set_matrix input preserves translation components":
        step("Verify: set_matrix input preserves translation components")
        val m = Matrix3x3.translate(11.0, 13.0)
        expect(m.tx()).to_equal(11.0)  # oracle: 11.0 — named expected value from the requirement
        expect(m.ty()).to_equal(13.0)  # oracle: 13.0 — named expected value from the requirement
        expect(m.scale_x()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(m.scale_y()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement

    it "local_to_device returns identity matrix":
        step("Verify: local_to_device returns identity matrix")
        val c = sk_canvas_make(100, 100)
        val m = c.local_to_device()
        expect(m.tx()).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(m.ty()).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(m.scale_x()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(m.scale_y()).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
