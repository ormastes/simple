"""

## Purpose and audience
## Operator workflow
## Compatibility and limitations

# Matrix3x3.is_identity

Regression + detection specs for
`doc/08_tracking/bug/skia_matrix3x3_missing_is_identity_2026-07-20.md`.

(a) reproducing spec: `Matrix3x3` (re-exported by `std.skia.entity.matrix`
    from `std.common.drawing.vector`) had no `is_identity()` at all, so the
    5 examples in `matrix_spec.spl` that call it could not run.
(b) detection spec: generalises the class — a predicate over a 9-element
    matrix must be sensitive to EVERY element, not just the ones the happy
    path happens to touch.
"""
# @manual: primary
# @req: REQ-LIB-SKIA_MATRIX_IS_IDENTITY-001
# doc-path: doc/01_research/local/simpleos_server_execution_matrix.md
# doc-path: doc/03_plan/cert/sanitizer_matrix_plan.md
# doc-path: doc/04_architecture/ui/wm_host_platform_matrix.md
# doc-path: doc/05_design/backend_layer_artifact_matrix.md

use std.spec.step
use std.spec.{describe, it, expect}
use std.skia.entity.matrix.{Matrix3x3}

fn _perturbed(slot: i64) -> Matrix3x3:
    val i = Matrix3x3.identity()
    val d = 1.0
    if slot == 0:
        Matrix3x3(m00: i.m00 + d, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22)
    else:
        if slot == 1:
            Matrix3x3(m00: i.m00, m01: i.m01 + d, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22)
        else:
            if slot == 2:
                Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02 + d, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22)
            else:
                if slot == 3:
                    Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10 + d, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22)
                else:
                    if slot == 4:
                        Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11 + d, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22)
                    else:
                        if slot == 5:
                            Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12 + d, m20: i.m20, m21: i.m21, m22: i.m22)
                        else:
                            if slot == 6:
                                Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20 + d, m21: i.m21, m22: i.m22)
                            else:
                                if slot == 7:
                                    Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21 + d, m22: i.m22)
                                else:
                                    Matrix3x3(m00: i.m00, m01: i.m01, m02: i.m02, m10: i.m10, m11: i.m11, m12: i.m12, m20: i.m20, m21: i.m21, m22: i.m22 + d)

describe "Matrix3x3.is_identity":
    it "returns true for the identity and for identity-equivalent factories":
        # @req: REQ-LIB-SKIA_MATRIX_IS_IDENTITY-001
        step("Verify: returns true for the identity and for identity-equivalent factories")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(Matrix3x3.identity().is_identity()).to_equal(true)
        expect(Matrix3x3.scale(sx: 1.0, sy: 1.0).is_identity()).to_equal(true)
        expect(Matrix3x3.rotate_degrees(deg: 0.0).is_identity()).to_equal(true)
        expect(Matrix3x3.identity().mul(Matrix3x3.identity()).is_identity()).to_equal(true)

    it "returns false for a translation":
        # @req: REQ-LIB-SKIA_MATRIX_IS_IDENTITY-001
        step("Verify: returns false for a translation")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        expect(Matrix3x3.translate(tx: 10.0, ty: 20.0).is_identity()).to_equal(false)

describe "Matrix3x3.is_identity element sensitivity (detection)":
    it "rejects a matrix perturbed in any single one of the nine slots":
        # @req: REQ-LIB-SKIA_MATRIX_IS_IDENTITY-001
        step("Verify: rejects a matrix perturbed in any single one of the nine slots")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        var missed = 0
        var slot = 0
        while slot < 9:
            if _perturbed(slot).is_identity():
                missed = missed + 1
            slot = slot + 1
        expect(missed).to_equal(0)  # oracle: pinned constant asserted by this scenario
