# @tag: unit, skia, draw_ir, REQ-2D-001, REQ-2D-002

use std.spec.*
use std.skia.entity.geometry.{SkRect, sk_rect_make_xywh}
use std.skia.entity.color.{sk_color_argb}
use std.skia.entity.paint.{sk_paint_fill, sk_paint_stroke}
use std.skia.entity.enums.{SkBlendMode}
use std.skia.entity.picture.{SkPicture, SkPictureOp, SkPictureOpKind, sk_picture_op_draw_rect}
use std.skia.bridge.picture_draw_ir.{skia_picture_to_draw_ir_strict}
use std.skia.backend.upstream_ganesh_vulkan.provider.{upstream_skia_ganesh_vulkan_preflight}

fn _draw_ir_picture(ops: [SkPictureOp]) -> SkPicture:
    SkPicture(
        cull_rect: SkRect(left: 0.0, top: 0.0, right: 16.0, bottom: 16.0),
        op_count: ops.len().to_i64(), ops: ops)

fn _draw_ir_rect() -> SkPictureOp:
    sk_picture_op_draw_rect(sk_rect_make_xywh(1.25, 2.5, 3.75, 4.125),
        sk_paint_fill(sk_color_argb(255, 0x33, 0x66, 0x99)).with_anti_alias(false))

fn _draw_ir_clear() -> SkPictureOp:
    sk_picture_op_draw_rect(sk_rect_make_xywh(0.0, 0.0, 16.0, 16.0),
        sk_paint_fill(sk_color_argb(255, 0, 0, 0)).with_anti_alias(false))

fn _draw_ir_rejection(picture: SkPicture) -> text:
    match skia_picture_to_draw_ir_strict(picture, 16, 16):
        Ok(_): "unexpected-success"
        Err(reason): reason

describe "strict SkPicture to shared DrawIR producer":
    it "preserves f64 rectangle geometry, color, and paint order":
        # @req REQ-2D-001 REQ-2D-002
        val picture = _draw_ir_picture([_draw_ir_clear(), _draw_ir_rect()])
        match skia_picture_to_draw_ir_strict(picture, 16, 16):
            Ok(composition):
                expect(composition.backend_target).to_equal("gpu")
                expect(composition.batches.len()).to_equal(1)
                val batch = composition.batches[0]
                expect(batch.embedding.width).to_equal(16)
                expect(batch.embedding.height).to_equal(16)
                expect(batch.commands.len()).to_equal(2)
                expect(batch.commands[0].color).to_equal(0xff000000u32)
                expect(batch.commands[0].fractional_geometry == nil).to_equal(true)
                expect(batch.commands[0].width).to_equal(16)
                expect(batch.commands[0].height).to_equal(16)
                expect(batch.commands[1].color).to_equal(0xff336699u32)
                if val geometry = batch.commands[1].fractional_geometry:
                    expect(geometry.x).to_equal(1.25)
                    expect(geometry.y).to_equal(2.5)
                    expect(geometry.width).to_equal(3.75)
                    expect(geometry.height).to_equal(4.125)
                else:
                    fail("fractional geometry missing")
                val upstream = upstream_skia_ganesh_vulkan_preflight(composition)
                expect(upstream.accepted).to_equal(true)
            Err(_): assert(false)

    it "rejects a later path before producing a partial composition":
        # @req REQ-2D-001
        var unsupported = _draw_ir_rect()
        unsupported.kind = SkPictureOpKind.DrawPath
        val reason = _draw_ir_rejection(_draw_ir_picture([_draw_ir_clear(), unsupported]))
        expect(reason).to_contain("op 1")
        expect(reason).to_contain("unsupported-op: DrawPath")

    it "rejects every unsupported operation class including state and clips":
        # @req REQ-2D-001
        val kinds = [SkPictureOpKind.Save, SkPictureOpKind.SaveLayer,
            SkPictureOpKind.Restore, SkPictureOpKind.DrawOval,
            SkPictureOpKind.DrawPath, SkPictureOpKind.DrawText,
            SkPictureOpKind.DrawImage, SkPictureOpKind.ClipRect,
            SkPictureOpKind.SetMatrix, SkPictureOpKind.DrawPaint,
            SkPictureOpKind.DrawPoints, SkPictureOpKind.DrawRRect,
            SkPictureOpKind.DrawTextBlob]
        for kind in kinds:
            var unsupported = _draw_ir_rect()
            unsupported.kind = kind
            expect(_draw_ir_rejection(_draw_ir_picture([unsupported]))).to_contain("op 0: unsupported-op")

    it "rejects paint style, anti-aliasing, blending, and alpha":
        # @req REQ-2D-001
        val rect = sk_rect_make_xywh(1.0, 1.0, 4.0, 4.0)
        val opaque = sk_color_argb(255, 1, 2, 3)
        val stroke = sk_picture_op_draw_rect(rect,
            sk_paint_stroke(opaque, 1.0).with_anti_alias(false))
        expect(_draw_ir_rejection(_draw_ir_picture([stroke]))).to_contain("paint-style")
        val aa = sk_picture_op_draw_rect(rect, sk_paint_fill(opaque))
        expect(_draw_ir_rejection(_draw_ir_picture([aa]))).to_contain("paint-anti-alias")
        val blended = sk_picture_op_draw_rect(rect,
            sk_paint_fill(opaque).with_anti_alias(false).with_blend_mode(SkBlendMode.Multiply))
        expect(_draw_ir_rejection(_draw_ir_picture([blended]))).to_contain("paint-blend-mode")
        val translucent = sk_picture_op_draw_rect(rect,
            sk_paint_fill(sk_color_argb(128, 1, 2, 3)).with_anti_alias(false))
        expect(_draw_ir_rejection(_draw_ir_picture([translucent]))).to_contain("paint-alpha")

    it "rejects invalid rectangle geometry and malformed picture metadata":
        # @req REQ-2D-001
        val empty = sk_picture_op_draw_rect(
            sk_rect_make_xywh(1.0, 1.0, 0.0, 2.0),
            sk_paint_fill(sk_color_argb(255, 0, 0, 0)).with_anti_alias(false))
        expect(_draw_ir_rejection(_draw_ir_picture([empty]))).to_contain("rectangle-empty-or-inverted")
        var malformed = _draw_ir_picture([_draw_ir_rect()])
        malformed.op_count = 2
        expect(_draw_ir_rejection(malformed)).to_equal("picture-op-count-mismatch")
        match skia_picture_to_draw_ir_strict(_draw_ir_picture([_draw_ir_rect()]), 0, 16):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_equal("invalid-canvas-size")

    it "rejects empty pictures and recordings with different cull bounds":
        # @req REQ-2D-001
        expect(_draw_ir_rejection(_draw_ir_picture([]))).to_equal("picture-empty")
        var cropped = _draw_ir_picture([_draw_ir_rect()])
        cropped.cull_rect = SkRect(left: 1.0, top: 0.0, right: 16.0, bottom: 16.0)
        expect(_draw_ir_rejection(cropped)).to_equal("picture-cull-not-full-surface")

    it "requires an opaque full-surface initializer and bounded later rectangles":
        # @req REQ-2D-001 REQ-2D-006
        expect(_draw_ir_rejection(_draw_ir_picture([_draw_ir_rect()]))).to_contain(
            "integer-full-surface-clear-required-first")
        val outside = sk_picture_op_draw_rect(
            sk_rect_make_xywh(15.0, 1.0, 2.0, 2.0),
            sk_paint_fill(sk_color_argb(255, 0, 0, 0)).with_anti_alias(false))
        val reason = _draw_ir_rejection(_draw_ir_picture([_draw_ir_clear(), outside]))
        expect(reason).to_contain("op 1")
        expect(reason).to_contain("rectangle-outside-canvas")
