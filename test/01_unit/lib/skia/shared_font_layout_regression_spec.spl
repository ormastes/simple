"""# Shared Font Layout Regressions

Real pinned Noto faces that the OpenType layout validators used to reject:
NotoSansSC's GPOS FeatureVariations shares alternate FeatureTables between
records, and NotoSansDevanagari's 53 default GSUB lookups exhausted a 65536
work budget on the six-glyph Hindi witness.
Bug: doc/08_tracking/bug/macos_vulkan_2d_vector_font_empty_batch_native_fault_2026-07-26.md
"""

use std.spipe.*
use std.skia.feature.shaper.font_fallback.{fallback_chain_new}
use std.skia.feature.shaper.shaper.{shaper_new, shaper_with_ot_face, shaper_shape_with_language, shaped_run_to_font_glyph_run}
use std.skia.feature.glyph.ot_parser.{parse_offset_table}
use std.skia.feature.glyph.ot_parser_layout.{select_gpos_lookup_plan}
use std.skia.entity.font.{sk_typeface_from_attached_font, sk_font_new, sk_font_style_normal}
use std.nogc_sync_mut.io.font_sffi.{load_font}
use std.nogc_sync_mut.sffi.io.{file_read_bytes}

val SC_PATH = "assets/fonts/google-fonts/ofl/notosanssc/NotoSansSC[wght].ttf"
val DEVANAGARI_PATH = "assets/fonts/google-fonts/ofl/notosansdevanagari/NotoSansDevanagari[wdth,wght].ttf"

describe "shared OpenType layout tables in real fonts":
    # @req REQ-007 REQ-014
    it "should accept GPOS FeatureVariations records that share an alternate FeatureTable":
        # @req REQ-SSPEC-LIB
        step("should accept GPOS FeatureVariations records that share an alternate FeatureTable")
        val parsed = parse_offset_table(file_read_bytes(SC_PATH)).unwrap()
        # script 'latn', default language system, no default features
        val plan = select_gpos_lookup_plan(parsed, 1818326126u32, 0u32, [])
        expect plan.valid to_equal true

    # @req REQ-007 REQ-014
    it "should position Latin text in NotoSansSC completely":
        # @req REQ-SSPEC-LIB
        step("should position Latin text in NotoSansSC completely")
        val handle = load_font(SC_PATH).?
        val parsed = parse_offset_table(file_read_bytes(SC_PATH)).unwrap()
        val font = sk_font_new(sk_typeface_from_attached_font("Noto Sans SC", sk_font_style_normal(), SC_PATH, handle.handle), 32.0)
        val codepoints = [69u32, 110u32, 103u32, 108u32, 105u32, 115u32, 104u32]
        val bound = shaper_with_ot_face(shaper_new(fallback_chain_new(font)), handle.handle, parsed)
        val run = shaper_shape_with_language(bound, codepoints, font, 0.0, 0.0, "en")[0]
        expect run.positioning_complete to_equal true
        expect shaped_run_to_font_glyph_run(run).valid to_equal true

    # @req REQ-007 REQ-014
    it "should complete Devanagari GSUB without exhausting the work budget":
        # @req REQ-SSPEC-LIB
        step("should complete Devanagari GSUB without exhausting the work budget")
        val handle = load_font(DEVANAGARI_PATH).?
        val parsed = parse_offset_table(file_read_bytes(DEVANAGARI_PATH)).unwrap()
        val font = sk_font_new(sk_typeface_from_attached_font("Noto Sans Devanagari", sk_font_style_normal(), DEVANAGARI_PATH, handle.handle), 32.0)
        val codepoints = [2361u32, 2367u32, 2344u32, 2381u32, 2342u32, 2368u32]
        val bound = shaper_with_ot_face(shaper_new(fallback_chain_new(font)), handle.handle, parsed)
        val run = shaper_shape_with_language(bound, codepoints, font, 0.0, 0.0, "hi")[0]
        expect run.substitution_complete to_equal true
        expect shaped_run_to_font_glyph_run(run).valid to_equal true
