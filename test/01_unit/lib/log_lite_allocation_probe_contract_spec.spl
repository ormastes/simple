# codex-system-test
# @req DEBUG-LOG-CONTEXT/09-10
# Reviewed contract with real native observer wiring. Compiled Simple interval UNRUN.
# Requires dedicated single-carrier core-c-alloc-observer-v1 process and closure audit.
# Timestamp boxing remains covered and may correctly make the hot assertion fail.
use std.spec.*
use std.spec.step
use std.log.{alloc_probe_reset, alloc_probe_count, alloc_probe_coverage, LOG_INFO, SUBSYS_KERN}
use std.log.ring.{log_ring_init, log_ring_push, log_ring_drain, log_ring_pending}

describe "Actual allocator sensitivity before ring measurement", tag: ["only-compiled"]:
    it "observes ring allocation before accepting a zero allocation hot path":
        step("Require the versioned native owner profile before measuring")
        expect(alloc_probe_coverage()).to_equal(65551)
        step("Initialize one capacity then force an actual ring buffer resize")
        log_ring_init(6)
        alloc_probe_reset()
        log_ring_init(7)
        val allocated = alloc_probe_count()
        step("Reject a disconnected probe before measuring the fast path")
        expect(allocated).to_be_greater_than(0)
        step("Measure scalar push and drain without assertions inside the interval")
        # Warm clock resolution and the probe wrappers before the hot interval.
        val warm_push = log_ring_push(LOG_INFO, SUBSYS_KERN, 0, 1, 0, 0)
        val warm_drain = log_ring_drain(1)
        expect(warm_push).to_equal(true)
        expect(warm_drain).to_equal(1)
        alloc_probe_reset()
        val pushed = log_ring_push(LOG_INFO, SUBSYS_KERN, 0, 42, 0, 0)
        val drained = log_ring_drain(1)
        val hot_allocations = alloc_probe_count()
        step("Check actual record progress and allocator delta")
        expect(pushed).to_equal(true)
        expect(drained).to_equal(1)
        expect(log_ring_pending()).to_equal(0)
        expect(hot_allocations).to_equal(0)
        step("Retain a second real resize sensitivity control after the hot snapshot")
        alloc_probe_reset()
        log_ring_init(8)
        val allocated_after = alloc_probe_count()
        expect(allocated_after).to_be_greater_than(0)
