"""
# DELETE ... WHERE col [NOT] IN (SELECT ...) specification

Regression: UiAccessStore retention runs
`DELETE FROM ui_access_events WHERE id NOT IN (SELECT id FROM ui_access_events
ORDER BY sequence DESC, id DESC LIMIT 64)`, which the rt_sqlite emulation
rejected as an unsupported DELETE WHERE clause.
"""

use std.spec.step
use std.database.sql.types.{DbValue, DbRow, DbError}
use std.database.sql.connection.{Database}

fn _seeded() -> Database:
    var db = Database.memory().unwrap()
    db.exec_sql("CREATE TABLE ev (id INTEGER PRIMARY KEY AUTOINCREMENT, seq INTEGER)").unwrap()
    # ids 1..5 with seq 50,10,40,20,30
    db.exec_sql("INSERT INTO ev (seq) VALUES (50)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (10)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (40)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (20)").unwrap()
    db.exec_sql("INSERT INTO ev (seq) VALUES (30)").unwrap()
    db

fn _ids(db: Database) -> [i64]:
    var d = db
    val rows = d.query("SELECT id FROM ev", []).unwrap()
    var out: [i64] = []
    for r in rows:
        # The interpreter emulation currently surfaces INTEGER columns as text.
        val as_int = r.get_int("id")
        if as_int.?:
            out.push(as_int.unwrap())
        else:
            out.push(r.get_text("id").unwrap().to_int())
    out

describe "DELETE with IN subquery":
    it "NOT IN keeps the top-N rows by ORDER BY ... DESC LIMIT":
        step("retention")
        var db = _seeded()
        val r = db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev ORDER BY seq DESC, id DESC LIMIT 2)")
        expect(r.is_ok()).to_equal(true)
        # top-2 by seq are ids 1 (50) and 3 (40)
        expect(_ids(db)).to_equal([1, 3])
        db.close().unwrap()

    it "NOT IN with LIMIT larger than the table deletes nothing":
        step("retention no-op")
        var db = _seeded()
        db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev ORDER BY seq DESC LIMIT 64)").unwrap()
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()

    it "IN deletes only the subquery rows (ASC order)":
        step("in")
        var db = _seeded()
        db.exec_sql("DELETE FROM ev WHERE id IN (SELECT id FROM ev ORDER BY seq ASC LIMIT 2)").unwrap()
        # lowest seq are ids 2 (10) and 4 (20)
        expect(_ids(db)).to_equal([1, 3, 5])
        db.close().unwrap()

    it "fails closed on an unsupported subquery instead of widening the delete":
        step("where in subquery")
        var db = _seeded()
        val r = db.exec_sql("DELETE FROM ev WHERE id NOT IN (SELECT id FROM ev WHERE seq > 10)")
        expect(r.is_err()).to_equal(true)
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()

    it "errors on an unknown subquery table":
        step("bad table")
        var db = _seeded()
        expect(db.exec_sql("DELETE FROM ev WHERE id IN (SELECT id FROM nope)").is_err()).to_equal(true)
        expect(_ids(db).len()).to_equal(5)
        db.close().unwrap()
