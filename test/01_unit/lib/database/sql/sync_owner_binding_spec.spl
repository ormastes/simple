# Regression: typed SQL binds the sync validator, not the filtered async facade.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.database.sql.escape.{validate_ident, quote_ident}

describe "typed SQL canonical sync owner":
    it "accepts and quotes a safe savepoint identifier":
        val accepted = validate_ident("savepoint_1")
        expect(accepted.is_ok()).to_equal(true)
        expect(accepted.unwrap()).to_equal("savepoint_1")
        expect(quote_ident(accepted.unwrap())).to_equal("\"savepoint_1\"")

    it "retains rejection of empty and injected savepoint names":
        expect(validate_ident("").is_err()).to_equal(true)
        expect(validate_ident("sp1;DROP TABLE task").is_err()).to_equal(true)
        expect(validate_ident("sp1--comment").is_err()).to_equal(true)
