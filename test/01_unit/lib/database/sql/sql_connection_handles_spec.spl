"""
# SQL connection handle specification

Regression: the interpreter's rt_sqlite emulation handed out dense handles 1,2,3...
and the Simple-side validity check rejects 3 (the runtime's tagged nil), so the
third live connection failed with "Invalid connection".
"""

use std.spec.step
use std.database.sql.connection.{Database}

describe "Database handles":
    it "opens six connections without closing any":
        step("open")
        var dbs: [Database] = []
        var i = 0
        while i < 6:
            val r = Database.memory()
            expect(r.is_ok()).to_equal(true)
            dbs.push(r.unwrap())
            i = i + 1
        expect(dbs.len()).to_equal(6)
        var j = 0
        while j < dbs.len():
            var d = dbs[j]
            d.close().unwrap()
            j = j + 1

    it "keeps connections independent":
        step("two tables")
        var a = Database.memory().unwrap()
        var b = Database.memory().unwrap()
        var c = Database.memory().unwrap()
        a.exec_sql("CREATE TABLE only_a (id INTEGER)").unwrap()
        expect(c.exec_sql("CREATE TABLE only_a (id INTEGER)").is_ok()).to_equal(true)
        expect(b.exec_sql("INSERT INTO only_a (id) VALUES (1)").is_err()).to_equal(true)
