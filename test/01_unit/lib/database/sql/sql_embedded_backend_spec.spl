# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
#
# Embedded-engine backing of the sqlite-shaped raw handle API.
#
# The Phase 4 full-CLI link (2026-10-19) demanded 27 `rt_sqlite_*` symbols
# through `cli browser -> UiAccessStore -> Database.open`; their only hosted
# provider wrapped the external libsqlite3, which CLAUDE.md forbids. The raw
# handle layer is now `std.nogc_sync_mut.io.sqlite_embedded`, implemented over
# `PureDatabase`. These scenarios pin the handle contract the wrappers and
# `database/sql/statement.spl` rely on, and the structural fact that the
# wrapper no longer references any `rt_sqlite_*` extern.
#
# Rows carry explicit primary keys: an omitted `INTEGER PRIMARY KEY` stays NULL
# in the embedded engine (named gap in sqlite_embedded.spl), which is engine
# behaviour, not part of the handle contract pinned here.

use std.spec.step

use std.nogc_sync_mut.io.sqlite_embedded.{
    sqlite_raw_open_memory, sqlite_raw_close, sqlite_raw_execute, sqlite_raw_execute_batch,
    sqlite_raw_query, sqlite_raw_query_next, sqlite_raw_query_done,
    sqlite_raw_column_count, sqlite_raw_column_name, sqlite_raw_column_text,
    sqlite_raw_column_int, sqlite_raw_column_float, sqlite_raw_column_type,
    sqlite_raw_prepare, sqlite_raw_bind_text, sqlite_raw_bind_int, sqlite_raw_bind_null,
    sqlite_raw_reset, sqlite_raw_finalize,
    sqlite_raw_begin, sqlite_raw_rollback,
    sqlite_raw_last_insert_rowid, sqlite_raw_changes, sqlite_raw_error_message}
use std.io.sqlite_sffi.{sqlite_handle_valid}
use std.database.sql.connection.{Database}
use std.database.sql.types.{DbValue}

extern fn rt_file_read_text(path: text) -> text

describe "sqlite_embedded raw handle contract":
    it "opens an in-memory database with a handle the wrappers accept":
        # @req REQ-SSPEC-UNIT
        step("open memory")
        val conn = sqlite_raw_open_memory()
        expect(sqlite_handle_valid(conn)).to_equal(true)
        expect(sqlite_raw_close(conn)).to_equal(1)
        expect(sqlite_raw_close(conn)).to_equal(0)

    it "executes DDL and DML and reports changes and rowids":
        # @req REQ-SSPEC-UNIT
        step("create, insert, count")
        val conn = sqlite_raw_open_memory()
        expect(sqlite_raw_execute(conn, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL)")).to_equal(1)
        expect(sqlite_raw_execute(conn, "INSERT INTO users (id, name, score) VALUES (1, 'alice', 1.5)")).to_equal(1)
        expect(sqlite_raw_changes(conn)).to_equal(1)
        expect(sqlite_raw_last_insert_rowid(conn)).to_equal(1)
        expect(sqlite_raw_execute_batch(conn, "INSERT INTO users (id, name, score) VALUES (2, 'bob', 2.5); INSERT INTO users (id, name, score) VALUES (3, 'carol', 3.5);")).to_equal(1)
        expect(sqlite_raw_last_insert_rowid(conn)).to_equal(3)
        sqlite_raw_close(conn)

    it "steps typed rows through query handles":
        # @req REQ-SSPEC-UNIT
        step("query rows")
        val conn = sqlite_raw_open_memory()
        sqlite_raw_execute(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, score REAL)")
        sqlite_raw_execute(conn, "INSERT INTO t (id, name, score) VALUES (1, 'alice', 1.5)")
        val stmt = sqlite_raw_query(conn, "SELECT id, name, score FROM t")
        expect(sqlite_handle_valid(stmt)).to_equal(true)
        expect(sqlite_raw_column_count(stmt)).to_equal(3)
        expect(sqlite_raw_column_name(stmt, 1)).to_equal("name")
        expect(sqlite_raw_query_next(stmt)).to_equal(1)
        expect(sqlite_raw_column_type(stmt, 0)).to_equal("integer")
        expect(sqlite_raw_column_int(stmt, 0)).to_equal(1)
        expect(sqlite_raw_column_type(stmt, 1)).to_equal("text")
        expect(sqlite_raw_column_text(stmt, 1)).to_equal("alice")
        expect(sqlite_raw_column_type(stmt, 2)).to_equal("real")
        expect(sqlite_raw_column_float(stmt, 2)).to_equal(1.5)
        expect(sqlite_raw_query_next(stmt)).to_equal(0)
        sqlite_raw_query_done(stmt)
        sqlite_raw_close(conn)

    it "binds positional parameters on prepared statements and resets them":
        # @req REQ-SSPEC-UNIT
        step("prepare, bind, step, reset")
        val conn = sqlite_raw_open_memory()
        sqlite_raw_execute(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT, score INTEGER)")
        val ins = sqlite_raw_prepare(conn, "INSERT INTO t (id, name, score) VALUES (?, ?, ?)")
        expect(sqlite_handle_valid(ins)).to_equal(true)
        expect(sqlite_raw_bind_int(ins, 1, 1)).to_equal(1)
        expect(sqlite_raw_bind_text(ins, 2, "dave")).to_equal(1)
        expect(sqlite_raw_bind_int(ins, 3, 7)).to_equal(1)
        expect(sqlite_raw_bind_int(ins, 0, 7)).to_equal(0)
        expect(sqlite_raw_query_next(ins)).to_equal(0)
        expect(sqlite_raw_changes(conn)).to_equal(1)
        expect(sqlite_raw_reset(ins)).to_equal(1)
        expect(sqlite_raw_bind_int(ins, 1, 2)).to_equal(1)
        expect(sqlite_raw_bind_null(ins, 3)).to_equal(1)
        expect(sqlite_raw_query_next(ins)).to_equal(0)
        sqlite_raw_finalize(ins)
        val count = sqlite_raw_query(conn, "SELECT COUNT(*) FROM t")
        expect(sqlite_raw_query_next(count)).to_equal(1)
        expect(sqlite_raw_column_int(count, 0)).to_equal(2)
        sqlite_raw_query_done(count)
        val sel = sqlite_raw_prepare(conn, "SELECT score FROM t WHERE id = ?")
        sqlite_raw_bind_int(sel, 1, 1)
        expect(sqlite_raw_query_next(sel)).to_equal(1)
        expect(sqlite_raw_column_int(sel, 0)).to_equal(7)
        expect(sqlite_raw_query_next(sel)).to_equal(0)
        sqlite_raw_finalize(sel)
        sqlite_raw_close(conn)

    it "rolls back a transaction and reports engine errors":
        # @req REQ-SSPEC-UNIT
        step("begin, rollback, error message")
        val conn = sqlite_raw_open_memory()
        sqlite_raw_execute(conn, "CREATE TABLE t (id INTEGER PRIMARY KEY, name TEXT)")
        expect(sqlite_raw_begin(conn)).to_equal(1)
        sqlite_raw_execute(conn, "INSERT INTO t (id, name) VALUES (1, 'temp')")
        expect(sqlite_raw_rollback(conn)).to_equal(1)
        val count = sqlite_raw_query(conn, "SELECT COUNT(*) FROM t")
        expect(sqlite_raw_query_next(count)).to_equal(1)
        expect(sqlite_raw_column_int(count, 0)).to_equal(0)
        sqlite_raw_query_done(count)
        expect(sqlite_raw_execute(conn, "INSERT INTO missing_table (x) VALUES (1)")).to_equal(0)
        expect(sqlite_raw_error_message(conn) != "").to_equal(true)
        expect(sqlite_raw_error_message(99)).to_equal("invalid connection")
        sqlite_raw_close(conn)

    it "accepts PRAGMA statements as documented no-ops":
        # @req REQ-SSPEC-UNIT
        step("pragma no-op")
        val conn = sqlite_raw_open_memory()
        expect(sqlite_raw_execute(conn, "PRAGMA journal_mode=wal")).to_equal(1)
        sqlite_raw_close(conn)

describe "Database facade over the embedded backend":
    it "round-trips typed values without any rt_sqlite_* extern":
        # @req REQ-SSPEC-UNIT
        step("facade round trip")
        var db = Database.memory().unwrap()
        expect(db.exec("CREATE TABLE items (id INTEGER PRIMARY KEY, label TEXT, qty INTEGER)", []).is_ok()).to_equal(true)
        val inserted = db.exec("INSERT INTO items (id, label, qty) VALUES (?, ?, ?)", [DbValue.Integer(value: 1), DbValue.Text(value: "bolt"), DbValue.Integer(value: 12)])
        expect(inserted.is_ok()).to_equal(true)
        val rows = db.query("SELECT label, qty FROM items", []).unwrap()
        expect(rows.len()).to_equal(1)
        expect(rows[0].columns).to_equal(["label", "qty"])
        expect(rows[0].values[0].to_text()).to_equal("bolt")
        expect(rows[0].values[1].to_text()).to_equal("12")
        db.close()

    it "leaves no rt_sqlite_ reference in the wrapper or statement sources":
        # @req REQ-SSPEC-UNIT
        step("structural: no external sqlite extern")
        val wrapper = rt_file_read_text("src/lib/nogc_sync_mut/io/sqlite_sffi.spl")
        val statement = rt_file_read_text("src/lib/nogc_sync_mut/database/sql/statement.spl")
        val embedded = rt_file_read_text("src/lib/nogc_sync_mut/io/sqlite_embedded.spl")
        expect(wrapper.len() > 0).to_equal(true)
        expect(wrapper.contains("extern fn rt_sqlite_")).to_equal(false)
        expect(statement.contains("rt_sqlite_")).to_equal(false)
        expect(embedded.contains("extern fn")).to_equal(false)
