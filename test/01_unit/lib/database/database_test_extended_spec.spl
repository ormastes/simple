"""
## Extended test database evidence

These scenarios exercise the database API directly. They prove that timing
observations remain cohort-specific, approved baselines move only through the
explicit promotion operation, and resource observations use volatile run rows.
"""

use std.spec.{step, expect, expect_not, fail}
use std.database.test_extended.factory.{create_test_database_extended}

describe "Extended test evidence persistence":
    # @req: REQ-005, REQ-007, REQ-008
    it "promotes only observations from the selected cohort":
        step("Create one stable test subject")
        var db = create_test_database_extended(":memory:")
        val run_id = db.start_run()
        db.update_test_result("cohort_spec.spl", "spec", "cohort_spec.spl", "passed", 90.0, run_id, "cohort-a")
        val test_id = match db.get_test_id("cohort_spec.spl", "spec", "cohort_spec.spl"):
            case Some(value): value
            case nil: -1
        expect(test_id).to_be_greater_than(-1)

        step("Record observations in incompatible cohorts")
        db.add_timing_run(test_id, 98.0, "a1", "cohort-a")
        db.add_timing_run(test_id, 100.0, "a2", "cohort-a")
        db.add_timing_run(test_id, 300.0, "b1", "cohort-b")
        db.update_test_result("cohort_spec.spl", "spec", "cohort_spec.spl", "failed", 999.0, run_id, "cohort-a")

        step("Promote the reviewed cohort explicitly")
        expect(db.promote_timing_baseline(test_id, "cohort-a")).to_be(true)
        match db.get_timing_summary(test_id):
            case Some(value):
                expect(value.baseline_state).to_equal("approved")
                expect(value.baseline_cohort_id).to_equal("cohort-a")
                expect(value.baseline_samples).to_contain("98")
                expect_not(value.baseline_samples.contains("300"))
                expect_not(value.baseline_samples.contains("999"))
            case nil:
                fail("promoted timing summary is missing")

        step("Supersede the prior immutable generation on the next promotion")
        db.add_timing_run(test_id, 110.0, "c1", "cohort-c")
        expect(db.promote_timing_baseline(test_id, "cohort-c")).to_be(true)
        val states = db.baseline_history_states(test_id)
        expect(states).to_contain("superseded")
        expect(states).to_contain("approved")

    # @req: REQ-005, REQ-011
    it "persists resource evidence as a volatile run observation":
        step("Create one stable test subject")
        var db = create_test_database_extended(":memory:")
        val run_id = db.start_run()
        db.update_test_result("resource_spec.spl", "spec", "resource_spec.spl", "passed", 80.0, run_id)
        val test_id = match db.get_test_id("resource_spec.spl", "spec", "resource_spec.spl"):
            case Some(value): value
            case nil: -1
        expect(test_id).to_be_greater_than(-1)

        step("Append one resource receipt without changing the subject")
        db.record_resource_run(
            run_id, "resource_spec.spl", "system", "cohort-resource",
            10, 70, 80, 30, 10, 4096, 2048, 100, 200, 2,
            "exact_tree", "exited", 0, 0, "pass", "warning")
        expect(db.prior_anomaly_warning("resource_spec.spl", "cohort-resource")).to_be(true)
        expect(db.prior_anomaly_warning("resource_spec.spl", "different-cohort")).to_be(false)
