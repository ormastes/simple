"""Source contract for the scalar pgwire socket-worker frontend."""

use std.spec
use std.io_runtime.{file_read}

describe "Postgres mimic scalar pgwire frontend":
    it "keeps worker protocol state local and database transport scalar":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_frontend.spl")
        expect(source).to_contain("class PgWireScalarFrontend:")
        expect(source).to_contain("port: PgScalarFrontendAdapter")
        expect(source).to_contain("pending_request_id: i64")
        expect(source).to_contain("fn poll_port(")
        expect(source).to_contain("self.port.publish_startup(")
        expect(source).to_contain("self.port.publish_query(")
        expect(source).to_contain("self.port.poll_receipt(request)")
        expect(source).to_contain("self.port.release_blob(blob)")
        expect(source).to_contain("self.port.release_result(receipt)")
        expect(source.contains("PgDispatchGate")).to_equal(false)
        expect(source.contains("PgDatabaseOwner")).to_equal(false)

    it "fails closed on malformed or mismatched scalar completions":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_frontend.spl")
        expect(source).to_contain("database command cancelled or timed out")
        expect(source).to_contain("invalid database completion")
        expect(source).to_contain("database completion operation mismatch")
        expect(source).to_contain("return self.reject_and_close")

    it "uses the immutable request deadline rather than a worker-local extension":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl")
        expect(source).to_contain("val deadline = self.scalar.claim_deadline(claim)")
        expect(source).to_contain("deadline <= now_ms")
        expect(source).to_contain("val remaining_timeout = deadline - now_ms")

    it "requires scalar config bytes before a worker reconstructs local text":
        val abi = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_runtime_abi.spl")
        val runtime = file_read("src/runtime/runtime_db.c")
        expect(abi).to_contain("rt_pg_wire_server_config_scalar_byte")
        expect(runtime).to_contain("int64_t rt_pg_wire_server_config_scalar_byte(")
        expect(runtime).to_contain("Returning a\n * runtime text value here would reintroduce")

    it "keeps the socket worker free of database-owner and dispatch-gate values":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl")
        val start = source.index_of("class PgScalarSocketWorkerV1:")
        val end = source.index_of("class PgParallelControl:")
        val worker = source.slice(start, end)
        expect(worker).to_contain("PgWireScalarFrontend.create")
        expect(worker).to_contain("PgScalarFrontendAdapter(port_token")
        expect(worker.contains("PgDatabaseOwner")).to_equal(false)
        expect(worker.contains("PgDispatchGate")).to_equal(false)
        expect(worker.contains("rt_pg_dispatch_gate_registry")).to_equal(false)

    it "reconstructs descriptor state only from scalar fields before starting a worker":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl")
        expect(source).to_contain("fn pg_scalar_register_descriptor(")
        expect(source).to_contain("rt_pg_worker_descriptor_new(worker_id, listener_fd,")
        expect(source).to_contain("control_id, port_token, limits_id, config_id)")
        expect(source).to_contain("fn pg_scalar_socket_worker_from_descriptor(")
        expect(source).to_contain("pg_scalar_limits_from_token(limits_id)?")
        expect(source).to_contain("pg_scalar_worker_config_from_token(config_id)?")
        expect(source).to_contain("fn pg_scalar_release_descriptor(descriptor: i64)")

    it "keeps database execution on the parent scalar pump and joins before release":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl")
        expect(source).to_contain("me serve_scalar_parallel_bounded(max_connections: i64)")
        expect(source).to_contain("PgScalarDispatchPortV1.create()")
        expect(source).to_contain("pg_scalar_spawn_slot(slots[spawn_index])")
        expect(source).to_contain("owner_pump.pump_one(self.owner")
        expect(source).to_contain("for handle in handles: handle.join()")
        expect(source).to_contain("pg_scalar_unregister(slots)")
        expect(source).to_contain("scalar_port.release()")
        expect(source).to_contain("idle_deadline = pg_parallel_now_ms() + self.limits.read_timeout_ms")

    it "lets the parent request bounded drain before joining workers":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/parallel_linux_server.spl")
        expect(source).to_contain("var drain_started = false")
        expect(source).to_contain("control.active_count() == 0")
        expect(source).to_contain("control.begin_drain()")
        expect(source).to_contain("while not drain_started or control.stopped_count() < self.worker_count")
        expect(source).to_contain("for handle in handles: handle.join()")

        val drain = source.index_of("                    control.begin_drain()\n                    drain_started = true")
        val stopped = source.index_of("        while not drain_started or control.stopped_count() < self.worker_count:")
        val joined = source.index_of("        for handle in handles: handle.join()\n        pg_scalar_unregister(slots)")
        val unregistered = source.index_of("        pg_scalar_unregister(slots)\n        val completed = control.completed_count()")
        val port_released = source.index_of("        val _ = scalar_port.release()\n        val _ = control.release()")
        val control_released = source.index_of("        val _ = control.release()\n        Ok(completed)")
        expect(drain).to_be_less_than(stopped)
        expect(stopped).to_be_less_than(joined)
        expect(joined).to_be_less_than(unregistered)
        expect(unregistered).to_be_less_than(port_released)
        expect(port_released).to_be_less_than(control_released)
