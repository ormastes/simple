# SQLite header probe specs (plan section 3.3 item 1).
# Ground truth comes from test/fixtures/database/sqlite/ground_truth.json,
# generated by python sqlite3 3.50.4 (gen_fixtures.py).

use std.spec
use std.nogc_sync_mut.database.sqlite_format.{sqlite_format_probe, sqlite_verify_bytes}
use std.nogc_sync_mut.database.sqlite_format.header.{sqlite_header_parse}
use std.nogc_sync_mut.database.sqlite_format.types.{SqliteError}
use std.io_runtime.{file_read_bytes_result}

val FIXTURE: text = "test/fixtures/database/sqlite/messenger.sqlite"

describe "sqlite_format header probe":

    it "reads magic page size and page count from the fixture":  # oracle: ground_truth.json page_size 4096, page_count 6
        match sqlite_format_probe(FIXTURE):
            Ok(info):
                expect(info.page_size).to_equal(4096)
                expect(info.page_count).to_equal(6)
                expect(info.file_bytes).to_equal(24576)
                expect(info.text_encoding).to_equal(1)
                expect(info.read_version).to_equal(1)
                expect(info.write_version).to_equal(1)
                expect(info.schema_cookie).to_equal(4)
                expect(info.file_change_counter).to_equal(5)
                expect(info.reserved_bytes).to_equal(0)
                expect(info.schema_format).to_equal(4)
            Err(e):
                expect(e.message()).to_equal("")

    it "parses the raw header bytes identically":  # oracle: same facts via the bytes-level entry
        match file_read_bytes_result(FIXTURE):
            Ok(bytes):
                match sqlite_header_parse(bytes):
                    Ok(info):
                        expect(info.page_size).to_equal(4096)
                        expect(info.page_count).to_equal(6)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(_):
                expect(false).to_equal(true)

    it "rejects a bad magic with the typed error":  # oracle: bytes 0..15 wrong
        var buf: [u8] = []
        var i: i64 = 0
        while i < 128:
            buf.push(0u8)
            i = i + 1
        buf[0] = 0x4Eu8
        match sqlite_header_parse(buf):
            Ok(info):
                expect(info.page_size).to_equal(-1)
            Err(SqliteError.BadMagic(found: _)):
                expect(true).to_equal(true)
            Err(e):
                expect(e.message()).to_equal("")

    it "rejects a non power of two page size":  # oracle: page size field 1000 (0x03E8)
        match file_read_bytes_result(FIXTURE):
            Ok(raw):
                val bytes = mutable_copy(raw)
                bytes[16] = 0x03u8
                bytes[17] = 0xE8u8
                match sqlite_header_parse(bytes):
                    Ok(info):
                        expect(info.page_size).to_equal(-1)
                    Err(SqliteError.UnsupportedPageSize(value: 1000)):
                        expect(true).to_equal(true)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(_):
                expect(false).to_equal(true)

    it "accepts the 65536 page size encoding of 1":  # oracle: raw value 1 means 65536; craft 1-page file
        var buf: [u8] = []
        var i: i64 = 0
        while i < 65536:
            buf.push(0u8)
            i = i + 1
        val magic = "SQLite format 3"
        var mi: i64 = 0
        while mi < 15:
            val cps = char_code_at(magic, mi)
            buf[mi] = (cps & 0xFF) as u8
            mi = mi + 1
        buf[16] = 0x00u8
        buf[17] = 0x01u8
        buf[18] = 1u8
        buf[19] = 1u8
        buf[20] = 0u8
        buf[21] = 64u8
        buf[22] = 32u8
        buf[23] = 32u8
        put_u32(buf, 28, 1)
        put_u32(buf, 44, 4)
        put_u32(buf, 56, 1)
        match sqlite_header_parse(buf):
            Ok(info):
                expect(info.page_size).to_equal(65536)
            Err(e):
                expect(e.message()).to_equal("")

    it "rejects a truncated file":  # oracle: 60 bytes < 100-byte header
        var buf: [u8] = []
        var i: i64 = 0
        while i < 60:
            buf.push(0u8)
            i = i + 1
        match sqlite_header_parse(buf):
            Ok(info):
                expect(info.page_size).to_equal(-1)
            Err(SqliteError.TruncatedFile(expected: 100, actual: 60)):
                expect(true).to_equal(true)
            Err(e):
                expect(e.message()).to_equal("")

    it "rejects a header whose page count exceeds the file":  # oracle: page_count field claims 99 pages
        match file_read_bytes_result(FIXTURE):
            Ok(raw):
                val bytes = mutable_copy(raw)
                put_u32(bytes, 28, 99)
                match sqlite_header_parse(bytes):
                    Ok(info):
                        expect(info.page_count).to_equal(-1)
                    Err(SqliteError.TruncatedFile(expected: 405504, actual: 24576)):
                        expect(true).to_equal(true)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(_):
                expect(false).to_equal(true)

    it "rejects an unknown text encoding":  # oracle: encoding field 9 is not 1/2/3
        match file_read_bytes_result(FIXTURE):
            Ok(raw):
                val bytes = mutable_copy(raw)
                put_u32(bytes, 56, 9)
                match sqlite_header_parse(bytes):
                    Ok(info):
                        expect(info.text_encoding).to_equal(-1)
                    Err(SqliteError.UnsupportedFeature(what: _)):
                        expect(true).to_equal(true)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(_):
                expect(false).to_equal(true)

    it "full verify decodes every table in the fixture":  # oracle: structural pass over all pages and records
        match file_read_bytes_result(FIXTURE):
            Ok(bytes):
                match sqlite_verify_bytes(bytes):
                    Ok(info):
                        expect(info.page_count).to_equal(6)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(_):
                expect(false).to_equal(true)

fn mutable_copy(bytes: [u8]) -> [u8]:
    var out: [u8] = []
    for b in bytes:
        out.push(b)
    out

fn char_code_at(s: text, i: i64) -> i64:
    use std.common.encoding.utf8.{text_codepoints}
    val cps = text_codepoints(s)
    if i < cps.len():
        return cps[i]
    0

fn put_u32(buf: [u8], off: i64, v: i64):
    buf[off] = ((v >> 24) & 0xFF) as u8
    buf[off + 1] = ((v >> 16) & 0xFF) as u8
    buf[off + 2] = ((v >> 8) & 0xFF) as u8
    buf[off + 3] = (v & 0xFF) as u8
