# Typed table read specs: rows must match the python-inserted ground truth
# EXACTLY (NULL/INTEGER/REAL/TEXT/BLOB) in ascending rowid order.

use std.spec
use std.nogc_sync_mut.database.sqlite_format.{sqlite_format_read_table}
use std.nogc_sync_mut.database.sql.types.{DbValue}

val FIXTURE: text = "test/fixtures/database/sqlite/messenger.sqlite"

describe "sqlite_format read_table":

    it "reads room rows exactly as python inserted them":  # oracle: ground_truth.json room rows
        match sqlite_format_read_table(FIXTURE, "room"):
            Ok(rows):
                expect(rows.len()).to_equal(2)
                expect(rows[0].get_int("id") ?? -1).to_equal(1)
                expect(rows[0].get_text("title") ?? "").to_equal("general")
                expect(rows[0].get_int("created_at") ?? -1).to_equal(1700000000)
                expect(rows[1].get_int("id") ?? -1).to_equal(2)
                expect(rows[1].get_text("title") ?? "").to_equal("random")
                expect(rows[1].get_int("created_at") ?? -1).to_equal(1700000100)
            Err(e):
                expect(e.message()).to_equal("")

    it "reads room_member in rowid order":  # oracle: ground_truth.json room_member rows
        match sqlite_format_read_table(FIXTURE, "room_member"):
            Ok(rows):
                expect(rows.len()).to_equal(3)
                expect(rows[0].get_int("room_id") ?? -1).to_equal(1)
                expect(rows[0].get_int("user_id") ?? -1).to_equal(101)
                expect(rows[2].get_int("room_id") ?? -1).to_equal(2)
                expect(rows[2].get_int("joined_at") ?? -1).to_equal(1700000101)
            Err(e):
                expect(e.message()).to_equal("")

    it "reads messages with typed null reply_to_id":  # oracle: ground_truth.json messages rows
        match sqlite_format_read_table(FIXTURE, "messages"):
            Ok(rows):
                expect(rows.len()).to_equal(4)
                expect(rows[0].get_text("body") ?? "").to_equal("hello world")
                expect(rows[0].get("reply_to_id") ?? DbValue.Integer(9)).to_equal(DbValue.Null)
                expect(rows[1].get_int("reply_to_id") ?? -1).to_equal(1)
                expect(rows[2].get_text("body") ?? "").to_equal("unicode: héllo wörld ✓")
                expect(rows[2].get_int("seq") ?? -1).to_equal(3)
                expect(rows[3].get_text("body") ?? "").to_equal("")
            Err(e):
                expect(e.message()).to_equal("")

    it "reads every SQL type exactly including the overflow blob":  # oracle: ground_truth.json type_probe rows, blob pattern (i*7+13)%256
        match sqlite_format_read_table(FIXTURE, "type_probe"):
            Ok(rows):
                expect(rows.len()).to_equal(6)
                # row 1: 0, 0.0, "", empty blob
                expect(rows[0].get_int("n") ?? -1).to_equal(0)
                expect(rows[0].get_real("r") ?? -1.0).to_equal(0.0)
                expect(rows[0].get_text("t") ?? "x").to_equal("")
                match rows[0].get("b"):
                    Some(DbValue.Blob(b)): expect(b.len()).to_equal(0)
                    _: expect(false).to_equal(true)
                # row 2: 1, 1.5, "text", [1,2,3]
                expect(rows[1].get_int("n") ?? -1).to_equal(1)
                expect(rows[1].get_real("r") ?? 0.0).to_equal(1.5)
                expect(rows[1].get_text("t") ?? "").to_equal("text")
                match rows[1].get("b"):
                    Some(DbValue.Blob(b)): expect(b).to_equal([1u8, 2u8, 3u8])
                    _: expect(false).to_equal(true)
                # row 3: -1, -2.25, "héllo ✓", [255,254,253,252]
                expect(rows[2].get_int("n") ?? 0).to_equal(-1)
                expect(rows[2].get_real("r") ?? 0.0).to_equal(-2.25)
                expect(rows[2].get_text("t") ?? "").to_equal("héllo ✓")
                match rows[2].get("b"):
                    Some(DbValue.Blob(b)): expect(b).to_equal([255u8, 254u8, 253u8, 252u8])
                    _: expect(false).to_equal(true)
                # row 4: i64 min, -0.5, "x", [0]
                expect(rows[3].get_int("n") ?? 0).to_equal(-9223372036854775808)
                expect(rows[3].get_real("r") ?? 0.0).to_equal(-0.5)
                match rows[3].get("b"):
                    Some(DbValue.Blob(b)): expect(b).to_equal([0u8])
                    _: expect(false).to_equal(true)
                # row 5: i64 max, pi, "y", 5000-byte overflow blob
                expect(rows[4].get_int("n") ?? 0).to_equal(9223372036854775807)
                expect(rows[4].get_real("r") ?? 0.0).to_equal(3.141592653589793)
                match rows[4].get("b"):
                    Some(DbValue.Blob(b)):
                        expect(b.len()).to_equal(5000)
                        expect(b[0]).to_equal(13u8)
                        expect(b[1]).to_equal(20u8)
                        expect(b[2]).to_equal(27u8)
                        expect(b[100]).to_equal(201u8)
                        expect(b[4999]).to_equal(190u8)
                    _: expect(false).to_equal(true)
                # row 6: all NULL
                expect(rows[5].get("n") ?? DbValue.Integer(9)).to_equal(DbValue.Null)
                expect(rows[5].get("r") ?? DbValue.Integer(9)).to_equal(DbValue.Null)
                expect(rows[5].get("t") ?? DbValue.Integer(9)).to_equal(DbValue.Null)
                expect(rows[5].get("b") ?? DbValue.Integer(9)).to_equal(DbValue.Null)
            Err(e):
                expect(e.message()).to_equal("")

    it "rowids ascend and INTEGER PRIMARY KEY reads as the rowid":  # oracle: ids are 1..N in insertion order
        match sqlite_format_read_table(FIXTURE, "messages"):
            Ok(rows):
                var prev: i64 = 0
                for r in rows:
                    val id = r.get_int("id") ?? -1
                    expect(id > prev).to_equal(true)
                    prev = id
            Err(e):
                expect(e.message()).to_equal("")
