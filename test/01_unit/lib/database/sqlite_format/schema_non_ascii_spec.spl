"""
## Purpose and audience
Purpose: As a user opening a SQLite file whose schema has non-ASCII names or
defaults, I want the column list parsed exactly as for ASCII schemas.
Audience: maintainers of std.nogc_sync_mut.database.sqlite_format.
"""
use std.spec
use std.nogc_sync_mut.database.sqlite_format.schema.{parse_create_table_columns}

describe "sqlite_format schema on non-ASCII SQL":
    it "reads columns of a table with a non-ASCII quoted name":
        match parse_create_table_columns("CREATE TABLE \"té\" (a INT, b INT)"):
            Ok(cols):
                expect(cols).to_equal(["a", "b"])
            Err(e):
                expect(e.message()).to_equal("")

    it "reads columns after a non-ASCII default value":
        match parse_create_table_columns("CREATE TABLE t (a TEXT DEFAULT 'é', bb INT)"):
            Ok(cols):
                expect(cols).to_equal(["a", "bb"])
            Err(e):
                expect(e.message()).to_equal("")
