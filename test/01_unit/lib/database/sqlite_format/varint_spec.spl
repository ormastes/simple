# SQLite varint codec specs (plan section 3.3 item 2).
# Boundary forms for every width 1..9, max values, malformed/truncated
# rejection, and encode/decode round-trips.

use std.spec
use std.nogc_sync_mut.database.sqlite_format.varint.{
    sqlite_varint_decode, sqlite_varint_encode, sqlite_varint_len
}
use std.nogc_sync_mut.database.sqlite_format.types.{SqliteError}

describe "sqlite_format varint":

    it "decodes every 1-byte value 0..127 as itself":  # oracle: RFC-style boundary, 0x7F is the 1-byte max
        for v in 0..128:
            val buf = [v as u8]
            match sqlite_varint_decode(buf, 0):
                Ok(res):
                    expect(res.0).to_equal(v as u64)
                    expect(res.1).to_equal(1)
                Err(e):
                    expect(e.message()).to_equal("")

    it "decodes the 2-byte form 300 as 0x82 0x2C":  # oracle: 300 = 0b1_0101100 -> 0x82,0x2C per fileformat2
        val buf = [0x82u8, 0x2Cu8]
        match sqlite_varint_decode(buf, 0):
            Ok(res):
                expect(res.0).to_equal(300u64)
                expect(res.1).to_equal(2)
            Err(e):
                expect(e.message()).to_equal("")

    it "decodes max values at every width boundary":  # oracle: width w<9 max is 2^(7w)-1; 9-byte max is 2^64-1
        var cases: [[u8]] = []
        var one27: [u8] = [0x7Fu8]
        cases.push(one27)
        var two: [u8] = [0xFFu8, 0x7Fu8]
        cases.push(two)
        var three: [u8] = [0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(three)
        var four: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(four)
        var five: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(five)
        var six: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(six)
        var seven: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(seven)
        var eight: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0x7Fu8]
        cases.push(eight)
        var nine: [u8] = [0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8]
        cases.push(nine)
        # widths 1..8 max out at 2^(7w)-1; the 9-byte form adds a full byte
        var expected: u64 = 127u64
        var width: i64 = 1
        for case_buf in cases:
            match sqlite_varint_decode(case_buf, 0):
                Ok(res):
                    expect(res.0).to_equal(expected)
                    expect(res.1).to_equal(width)
                Err(e):
                    expect(e.message()).to_equal("")
            if width == 8:
                expected = (expected << 8) | 0xFFu64
            else:
                expected = (expected << 7) | 0x7Fu64
            width = width + 1

    it "rejects a truncated varint with a typed error":  # oracle: 0x80 promises a continuation byte that never comes
        val buf = [0x80u8]
        match sqlite_varint_decode(buf, 0):
            Ok(res):
                expect(res.1).to_equal(-1)
            Err(SqliteError.MalformedVarint(offset: 0)):
                expect(true).to_equal(true)
            Err(e):
                expect(e.message()).to_equal("")

    it "rejects an out-of-range offset":  # oracle: offset 5 in a 2-byte buffer
        val buf = [0x01u8, 0x02u8]
        match sqlite_varint_decode(buf, 5):
            Ok(res):
                expect(res.1).to_equal(-1)
            Err(SqliteError.MalformedVarint(offset: 5)):
                expect(true).to_equal(true)
            Err(e):
                expect(e.message()).to_equal("")

    it "encodes round-trip across boundary widths":  # oracle: value v decodes back from its own encoding
        var values: [u64] = []
        values.push(0u64)
        values.push(1u64)
        values.push(127u64)
        values.push(128u64)
        values.push(300u64)
        values.push(16383u64)
        values.push(16384u64)
        values.push(2097151u64)
        values.push(2097152u64)
        values.push(268435455u64)
        values.push(268435456u64)
        values.push(0xFFFFFFFFFFFFFFu64)
        values.push(0x100000000000000u64)
        values.push(18446744073709551615u64)
        for v in values:
            val enc = sqlite_varint_encode(v)
            expect(enc.len()).to_equal(sqlite_varint_len(v))
            match sqlite_varint_decode(enc, 0):
                Ok(res):
                    expect(res.0).to_equal(v)
                    expect(res.1).to_equal(enc.len())
                Err(e):
                    expect(e.message()).to_equal("")

    it "9-byte form carries the low 8 bits in the final byte":  # oracle: 2^56 = bit 48 set -> groups [0,0x40,0,0,0,0,0,0], low byte 0
        val enc = sqlite_varint_encode(72057594037927936u64)
        expect(enc.len()).to_equal(9)
        expect(enc[0]).to_equal(0x80u8)
        expect(enc[1]).to_equal(0xC0u8)
        expect(enc[8]).to_equal(0x00u8)
        match sqlite_varint_decode(enc, 0):
            Ok(res):
                expect(res.0).to_equal(72057594037927936u64)
            Err(e):
                expect(e.message()).to_equal("")
