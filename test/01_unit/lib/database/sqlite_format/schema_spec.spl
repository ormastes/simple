# sqlite_schema decode specs: table names, rootpages, column counts
# (plan section 3.3 item 5). Ground truth: ground_truth.json from python.

use std.spec
use std.nogc_sync_mut.database.sqlite_format.schema.{
    sqlite_schema_scan, find_table_schema, parse_create_table_columns, parse_create_table_ipk
}
use std.nogc_sync_mut.database.sqlite_format.{sqlite_format_probe}
use std.nogc_sync_mut.database.sqlite_format.pager.{SqlitePager}
use std.io_runtime.{file_read_bytes_result}

val FIXTURE: text = "test/fixtures/database/sqlite/messenger.sqlite"

fn fixture_pager():
    match file_read_bytes_result(FIXTURE):
        Ok(bytes):
            match sqlite_format_probe(FIXTURE):
                Ok(info):
                    return [SqlitePager.open(bytes, info.page_size, info.page_count, info.reserved_bytes)]
                Err(_):
                    return []
        Err(_):
            []

describe "sqlite_format schema":

    it "finds all four tables with python-created rootpages":  # oracle: ground_truth.json room=2 room_member=3 messages=4 type_probe=5
        val pagers = fixture_pager()
        expect(pagers.len()).to_equal(1)
        match sqlite_schema_scan(pagers[0], 1):
            Ok(entries):
                expect(entries.len()).to_equal(4)
                expect(entries[0].obj_type).to_equal("table")
                expect(entries[0].name).to_equal("room")
                expect(entries[0].rootpage).to_equal(2)
                expect(entries[1].name).to_equal("room_member")
                expect(entries[1].rootpage).to_equal(3)
                expect(entries[2].name).to_equal("messages")
                expect(entries[2].rootpage).to_equal(4)
                expect(entries[3].name).to_equal("type_probe")
                expect(entries[3].rootpage).to_equal(5)
                for e in entries:
                    expect(e.tbl_name).to_equal(e.name)
                    expect(e.sql.starts_with("CREATE TABLE")).to_equal(true)
            Err(e):
                expect(e.message()).to_equal("")

    it "parses column lists matching python PRAGMA table_info":  # oracle: ground_truth.json columns arrays
        val pagers = fixture_pager()
        match sqlite_schema_scan(pagers[0], 1):
            Ok(entries):
                match find_table_schema(entries, "room"):
                    Ok(def):
                        expect(def.columns).to_equal(["id", "title", "created_at"])
                        expect(def.rootpage).to_equal(2)
                        expect(def.ipk).to_equal(0)
                    Err(e):
                        expect(e.message()).to_equal("")
                match find_table_schema(entries, "room_member"):
                    Ok(def):
                        expect(def.columns).to_equal(["id", "room_id", "user_id", "joined_at"])
                        expect(def.ipk).to_equal(0)
                    Err(e):
                        expect(e.message()).to_equal("")
                match find_table_schema(entries, "messages"):
                    Ok(def):
                        expect(def.columns).to_equal(["id", "room_id", "sender_id", "body", "created_at", "seq", "reply_to_id"])
                        expect(def.columns.len()).to_equal(7)
                        expect(def.ipk).to_equal(0)
                    Err(e):
                        expect(e.message()).to_equal("")
                match find_table_schema(entries, "type_probe"):
                    Ok(def):
                        expect(def.columns).to_equal(["id", "n", "r", "t", "b"])
                        expect(def.ipk).to_equal(0)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(e):
                expect(e.message()).to_equal("")

    it "finds tables case-insensitively":  # oracle: SQLite identifiers fold ASCII case
        val pagers = fixture_pager()
        match sqlite_schema_scan(pagers[0], 1):
            Ok(entries):
                match find_table_schema(entries, "ROOM"):
                    Ok(def):
                        expect(def.name).to_equal("room")
                    Err(e):
                        expect(e.message()).to_equal("")
                match find_table_schema(entries, "Type_Probe"):
                    Ok(def):
                        expect(def.rootpage).to_equal(5)
                    Err(e):
                        expect(e.message()).to_equal("")
            Err(e):
                expect(e.message()).to_equal("")

    it "fails closed for a missing table":  # oracle: no such table in fixture
        val pagers = fixture_pager()
        match sqlite_schema_scan(pagers[0], 1):
            Ok(entries):
                match find_table_schema(entries, "nope"):
                    Ok(def):
                        expect(def.rootpage).to_equal(-1)
                    Err(e):
                        expect(e.message()).to_equal("table not found in sqlite_schema: nope")
            Err(e):
                expect(e.message()).to_equal("")

    it "parses CREATE TABLE with constraints and quoting":  # oracle: keyword/constraint handling
        val cols = parse_create_table_columns("CREATE TABLE \"order\" (id INTEGER PRIMARY KEY, title TEXT NOT NULL, ref_id INTEGER REFERENCES other(id), amount REAL DEFAULT 0, UNIQUE(title));")
        match cols:
            Ok(c):
                expect(c).to_equal(["id", "title", "ref_id", "amount"])
            Err(e):
                expect(e.message()).to_equal("")
        val ipk = parse_create_table_ipk("CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT);")
        expect(ipk).to_equal(0)
        val no_ipk = parse_create_table_ipk("CREATE TABLE t (id INTEGER, v TEXT PRIMARY KEY);")
        expect(no_ipk).to_equal(-1)
        val br = parse_create_table_columns("CREATE TABLE [weird name] (`a` TEXT, [b] INTEGER);")
        match br:
            Ok(c):
                expect(c).to_equal(["a", "b"])
            Err(e):
                expect(e.message()).to_equal("")
