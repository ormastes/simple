# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
#
# SQLCipher 4 key session — locked `sqlcipher4_4k_sha512` KDF pipeline (lane cipher-b).
#
# Design authority: master plan 2026-10-21 §4.3 (exact pipeline), §4.1 (locked profile).
# Module under test: src/lib/nogc_sync_mut/database/codec/sqlcipher4_keys.spl
#
# Evidence chain (all REAL assertions, no placeholders):
#   1. Golden vectors pinned below were computed independently with Python
#      hashlib.pbkdf2_hmac("sha512", ...) on 2026-10-22 (same independent
#      oracle the runtime's own PBKDF2 native-helper unit tests cross-check
#      against):
#        passphrase = b"sqlcipher4-test-passphrase" (26 bytes)
#        file_salt  = 00 01 02 03 04 05 06 07 08 09 0a 0b 0c 0d 0e 0f
#        page_key   = PBKDF2-HMAC-SHA512(passphrase, file_salt, 256000, 32)
#                   = 62cdca2d1db1835c5a76ec534374686f74dead0da8a20c3bc812f4e37b2956fa
#        hmac_salt  = file_salt ^ 0x3a per byte
#                   = 3a3b38393e3f3c3d3233303136373435
#        hmac_key   = PBKDF2-HMAC-SHA512(page_key, hmac_salt, 2, 32)
#                   = 621bed95da0558c7a630f900b61b6fe9e9c80e83da228d085e9a6cdf6b0a0f53
#   2. The 2-iteration HMAC-key leg is additionally re-derived IN THIS SPEC
#      through the pure-Simple canonical reference (std.crypto.pbkdf2) and
#      must agree with the session — an independent implementation cross-check
#      (the base industry-vector specs already prove both implementations at
#      c=1/c=2; the 256000-iteration page-key leg is checked against the
#      Python golden vector plus determinism across two opens).
#   3. Performance: one real open() at the mandatory 256000 iterations is
#      timed and asserted within the 120 s budget; the measured ms is printed
#      as recorded evidence. The KDF executes through the seed runtime's
#      native PBKDF2 helper (byte-exact with the pure-Simple reference); the
#      pure-Simple loop at 256000 iterations costs ~177 ms per HMAC-SHA512 in
#      this interpreter (hours per derivation), which is the cost fact plan
#      §4.4 records for the compiled native/SMF path. Iteration counts are
#      never reduced, and no "native is faster" claim is made.

use std.spec.step

use std.spipe.*
use std.crypto.pbkdf2.{pbkdf2_sha512_bytes}
use std.crypto.types.{bytes_to_hex}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use std.nogc_sync_mut.database.codec.sqlcipher4_keys.{
    Sqlcipher4KeySession, Sqlcipher4KeyError, Sqlcipher4KeyType,
    sqlcipher4_key_session_open, sqlcipher4_key_session_open_typed,
    sqlcipher4_key_session_open_profile, sqlcipher4_hmac_salt_from_file_salt,
    sqlcipher4_key_error_text,
    SQLCIPHER4_KDF_ITER, SQLCIPHER4_KEY_BYTES, SQLCIPHER4_SALT_BYTES,
    SQLCIPHER4_HMAC_KDF_ITER, SQLCIPHER4_HMAC_SALT_MASK,
    SQLCIPHER4_HMAC_KEY_BYTES}

# ============================================================================
# Fixed secret inputs and independent oracles
# ============================================================================

fn _passphrase() -> [u8]:
    # b"sqlcipher4-test-passphrase" (26 bytes) — fixed throwaway test secret,
    # not any real credential (plan §4.6: isolated throwaway test keys).
    [0x73, 0x71, 0x6c, 0x63, 0x69, 0x70, 0x68, 0x65, 0x72, 0x34, 0x2d,
     0x74, 0x65, 0x73, 0x74, 0x2d, 0x70, 0x61, 0x73, 0x73, 0x70, 0x68,
     0x72, 0x61, 0x73, 0x65]

fn _file_salt() -> [u8]:
    # 00..0f — fixed 16-byte file salt
    var s: [u8] = []
    var i = 0
    while i < 16:
        s.push(i.to_u8())
        i = i + 1
    s

fn _short_salt_15() -> [u8]:
    var s: [u8] = []
    var i = 0
    while i < 15:
        s.push(i.to_u8())
        i = i + 1
    s

fn _long_salt_17() -> [u8]:
    var s: [u8] = []
    var i = 0
    while i < 17:
        s.push(i.to_u8())
        i = i + 1
    s

fn _other_salt() -> [u8]:
    # 10..1f — a different valid 16-byte file salt
    var s: [u8] = []
    var i = 0
    while i < 16:
        s.push((16 + i).to_u8())
        i = i + 1
    s

fn _empty_bytes() -> [u8]:
    []

fn _u8_to_i64_bytes(src: [u8]) -> [i64]:
    var out: [i64] = []
    var i = 0
    val n = src.len().to_i64()
    while i < n:
        out.push(src[i].to_i64())
        i = i + 1
    out

fn _hex(src: [u8]) -> text:
    bytes_to_hex(_u8_to_i64_bytes(src))

fn _error_code(res: Result<Sqlcipher4KeySession, Sqlcipher4KeyError>) -> text:
    # Public surface only: variant -> safe structured code. Never touches key
    # material, so rendering for assertions cannot leak secrets.
    match res:
        Ok(_): "ok"
        Err(e): sqlcipher4_key_error_text(e)

# ============================================================================
# Locked profile constants (plan §4.1 — never mutable)
# ============================================================================

describe "sqlcipher4 key session — locked profile constants":
    # @req REQ-SSPEC-UNIT

    it "profile fields equal the sqlcipher4_4k_sha512 lock":
        step("profile fields equal the sqlcipher4_4k_sha512 lock")
        expect(SQLCIPHER4_KDF_ITER).to_equal(256000)
        expect(SQLCIPHER4_KEY_BYTES).to_equal(32)
        expect(SQLCIPHER4_SALT_BYTES).to_equal(16)
        expect(SQLCIPHER4_HMAC_KDF_ITER).to_equal(2)
        expect(SQLCIPHER4_HMAC_SALT_MASK).to_equal(0x3a)
        expect(SQLCIPHER4_HMAC_KEY_BYTES).to_equal(32)

# ============================================================================
# Exact derivation shape (plan §4.3)
# ============================================================================

describe "sqlcipher4 key session — exact derivation shape":
    # @req REQ-SSPEC-UNIT

    it "page_key equals PBKDF2-HMAC-SHA512(passphrase, salt, 256000, 32) (Python hashlib golden)":
        step("page_key equals PBKDF2-HMAC-SHA512(passphrase, salt, 256000, 32) (Python hashlib golden)")
        val opened = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        var page_hex = ""
        match opened:
            Ok(session):
                page_hex = _hex(session.page_key)
                session.close()
            Err(e):
                page_hex = sqlcipher4_key_error_text(e)
        expect(page_hex).to_equal(
            "62cdca2d1db1835c5a76ec534374686f74dead0da8a20c3bc812f4e37b2956fa")

    it "hmac_key equals the pinned golden AND the pure-Simple 2-iteration re-derivation":
        step("hmac_key equals the pinned golden AND the pure-Simple 2-iteration re-derivation")
        val opened = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        var session_hex = ""
        match opened:
            Ok(session):
                session_hex = _hex(session.hmac_key)
                # Independent leg: re-derive hmac_key through the PURE-SIMPLE
                # canonical reference from the session's own page_key and the
                # module's masked salt. Two independent implementations must
                # agree byte-for-byte.
                val page_i64 = _u8_to_i64_bytes(session.page_key)
                val masked = sqlcipher4_hmac_salt_from_file_salt(_file_salt())
                var pure_hex = "mask-error"
                match masked:
                    Ok(masked_bytes):
                        pure_hex = bytes_to_hex(
                            pbkdf2_sha512_bytes(
                                page_i64, _u8_to_i64_bytes(masked_bytes),
                                SQLCIPHER4_HMAC_KDF_ITER, SQLCIPHER4_HMAC_KEY_BYTES))
                    Err(e):
                        pure_hex = sqlcipher4_key_error_text(e)
                expect(session_hex).to_equal(pure_hex)
                session.close()
            Err(e):
                session_hex = sqlcipher4_key_error_text(e)
        expect(session_hex).to_equal(
            "621bed95da0558c7a630f900b61b6fe9e9c80e83da228d085e9a6cdf6b0a0f53")

    it "hmac_salt = file_salt XOR 0x3a per byte, and differs from file_salt":
        step("hmac_salt = file_salt XOR 0x3a per byte, and differs from file_salt")
        val masked = sqlcipher4_hmac_salt_from_file_salt(_file_salt())
        var mask_hex = ""
        match masked:
            Ok(masked_bytes): mask_hex = _hex(masked_bytes)
            Err(e): mask_hex = sqlcipher4_key_error_text(e)
        expect(mask_hex).to_equal("3a3b38393e3f3c3d3233303136373435")
        expect(mask_hex != _hex(_file_salt())).to_equal(true)

# ============================================================================
# Strict rejection — typed errors, never silent adaptation
# ============================================================================

describe "sqlcipher4 key session — strict rejection":
    # @req REQ-SSPEC-UNIT

    it "empty passphrase is rejected with MissingSecret":
        step("empty passphrase is rejected with MissingSecret")
        expect(_error_code(sqlcipher4_key_session_open(_empty_bytes(), _file_salt()))).to_equal(
            "missing_secret")

    it "15-byte file salt is rejected with CipherProfileMismatch on kdf_salt_bytes":
        step("15-byte file salt is rejected with CipherProfileMismatch on kdf_salt_bytes")
        expect(_error_code(sqlcipher4_key_session_open(_passphrase(), _short_salt_15()))).to_equal(
            "cipher_profile_mismatch:kdf_salt_bytes:16:15")

    it "17-byte file salt is rejected with CipherProfileMismatch on kdf_salt_bytes":
        step("17-byte file salt is rejected with CipherProfileMismatch on kdf_salt_bytes")
        expect(_error_code(sqlcipher4_key_session_open(_passphrase(), _long_salt_17()))).to_equal(
            "cipher_profile_mismatch:kdf_salt_bytes:16:17")

    it "raw-key mode request is rejected with UnsupportedKeyType":
        step("raw-key mode request is rejected with UnsupportedKeyType")
        expect(_error_code(sqlcipher4_key_session_open_typed(
            _passphrase(), _file_salt(), Sqlcipher4KeyType.RawKey))).to_equal(
            "unsupported_key_type")

    it "passphrase key type derives successfully (typed entry point)":
        step("passphrase key type derives successfully (typed entry point)")
        expect(_error_code(sqlcipher4_key_session_open_typed(
            _passphrase(), _file_salt(), Sqlcipher4KeyType.Passphrase))).to_equal("ok")

    it "profile request with kdf_iter 128000 is rejected (no silent downgrade)":
        step("profile request with kdf_iter 128000 is rejected (no silent downgrade)")
        expect(_error_code(sqlcipher4_key_session_open_profile(
            _passphrase(), _file_salt(), 128000, 32))).to_equal(
            "cipher_profile_mismatch:kdf_iter:256000:128000")

    it "profile request with 16-byte key is rejected (no silent resize)":
        step("profile request with 16-byte key is rejected (no silent resize)")
        expect(_error_code(sqlcipher4_key_session_open_profile(
            _passphrase(), _file_salt(), 256000, 16))).to_equal(
            "cipher_profile_mismatch:cipher_key_bytes:32:16")

    it "profile request with the locked constants derives successfully":
        step("profile request with the locked constants derives successfully")
        expect(_error_code(sqlcipher4_key_session_open_profile(
            _passphrase(), _file_salt(), 256000, 32))).to_equal("ok")

# ============================================================================
# Determinism and key separation
# ============================================================================

describe "sqlcipher4 key session — determinism and separation":
    # @req REQ-SSPEC-UNIT

    it "same inputs produce identical derived keys across two opens":
        step("same inputs produce identical derived keys across two opens")
        val first = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        val second = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        var first_page = ""
        var first_hmac = ""
        var second_page = ""
        var second_hmac = ""
        match first:
            Ok(a):
                first_page = _hex(a.page_key)
                first_hmac = _hex(a.hmac_key)
                a.close()
            Err(e): first_page = sqlcipher4_key_error_text(e)
        match second:
            Ok(b):
                second_page = _hex(b.page_key)
                second_hmac = _hex(b.hmac_key)
                b.close()
            Err(e): second_page = sqlcipher4_key_error_text(e)
        expect(first_page).to_equal(second_page)
        expect(first_hmac).to_equal(second_hmac)

    it "a different file salt produces different page and hmac keys":
        step("a different file salt produces different page and hmac keys")
        val base = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        val other = sqlcipher4_key_session_open(_passphrase(), _other_salt())
        var base_page = ""
        var base_hmac = ""
        var other_page = ""
        var other_hmac = ""
        match base:
            Ok(a):
                base_page = _hex(a.page_key)
                base_hmac = _hex(a.hmac_key)
                a.close()
            Err(e): base_page = sqlcipher4_key_error_text(e)
        match other:
            Ok(b):
                other_page = _hex(b.page_key)
                other_hmac = _hex(b.hmac_key)
                b.close()
            Err(e): other_page = sqlcipher4_key_error_text(e)
        expect(base_page != other_page).to_equal(true)
        expect(base_hmac != other_hmac).to_equal(true)

# ============================================================================
# Secret hygiene and zeroization
# ============================================================================

describe "sqlcipher4 key session — secret hygiene and zeroization":
    # @req REQ-SSPEC-UNIT

    it "error texts carry safe codes only — no passphrase or key material":
        step("error texts carry safe codes only — no passphrase or key material")
        val empty_err = _error_code(sqlcipher4_key_session_open(_empty_bytes(), _file_salt()))
        val salt_err = _error_code(sqlcipher4_key_session_open(_passphrase(), _short_salt_15()))
        val type_err = _error_code(sqlcipher4_key_session_open_typed(
            _passphrase(), _file_salt(), Sqlcipher4KeyType.RawKey))
        expect(empty_err).to_equal("missing_secret")
        expect(salt_err).to_equal("cipher_profile_mismatch:kdf_salt_bytes:16:15")
        expect(type_err).to_equal("unsupported_key_type")
        # The fixed passphrase must not appear in any error rendering.
        expect(empty_err.contains("sqlcipher4-test-passphrase")).to_equal(false)
        expect(salt_err.contains("sqlcipher4-test-passphrase")).to_equal(false)
        expect(type_err.contains("sqlcipher4-test-passphrase")).to_equal(false)
        expect(empty_err.contains("62cdca2d")).to_equal(false)

    it "a fresh session owns 32-byte page and hmac keys and is open":
        step("a fresh session owns 32-byte page and hmac keys and is open")
        val opened = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        var sizes = ""
        var open_state = false
        match opened:
            Ok(session):
                sizes = "{session.page_key.len().to_i64()}:{session.hmac_key.len().to_i64()}"
                open_state = session.is_open()
                session.close()
            Err(e): sizes = sqlcipher4_key_error_text(e)
        expect(sizes).to_equal("32:32")
        expect(open_state).to_equal(true)

    it "close() zeroizes both key buffers and closes the session":
        step("close() zeroizes both key buffers and closes the session")
        val opened = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        var verified = false
        var len_after = ""
        var open_after = true
        match opened:
            Ok(session):
                verified = session.close()
                len_after = "{session.page_key.len().to_i64()}:{session.hmac_key.len().to_i64()}"
                open_after = session.is_open()
            Err(e): len_after = sqlcipher4_key_error_text(e)
        expect(verified).to_equal(true)
        expect(len_after).to_equal("0:0")
        expect(open_after).to_equal(false)

# ============================================================================
# Performance honesty — one open() at the mandatory 256000 iterations
# ============================================================================

describe "sqlcipher4 key session — performance honesty":
    # @req REQ-SSPEC-UNIT

    slow_it "one open() at the locked 256000-iteration profile completes within 120 s":
        step("one open() at 256000 iterations — wall-clock recorded")
        val t0 = time_now_unix_micros()
        val opened = sqlcipher4_key_session_open(_passphrase(), _file_salt())
        val elapsed_ms = (time_now_unix_micros() - t0) / 1000
        print "sqlcipher4_keys perf: one open() [PBKDF2-HMAC-SHA512(256000,32) + PBKDF2-HMAC-SHA512(2,32)] = {elapsed_ms} ms"
        var derived = false
        match opened:
            Ok(session):
                derived = session.page_key.len().to_i64() == SQLCIPHER4_KEY_BYTES
                session.close()
            Err(_): derived = false
        expect(derived).to_equal(true)
        expect(elapsed_ms).to_be_greater_than(0)
        expect(elapsed_ms).to_be_less_than(120000)
