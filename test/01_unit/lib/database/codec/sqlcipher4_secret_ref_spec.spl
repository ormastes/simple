# SecretRef indirection spec — the integration lane's replacement for the
# cipher-c open_key passphrase shim.
#
# Pins codec/secret_ref.spl:
#   1. Parse: secret://<name> admitted; everything else (bare passphrase,
#      file path, traversal, empty name, forbidden chars, oversized) is a
#      typed MissingSecret rejection — never coerced.
#   2. Env binding: the ref maps to exactly one SIMPLE_SECRET_* variable
#      with the documented folding ('-', '.' -> '_', uppercased).
#   3. Resolution: the env value arrives as wipeable bytes equal to the
#      UTF-8 value; unset/empty env fails closed with MissingSecret and the
#      error names only the env var, never a value.
#   4. Integration: sqlcipher4_page_open_key now takes a reference (the
#      passphrase shim is gone) — opening with an unresolved ref is a
#      MissingSecret, not a derivation over the ref text. (Full open with a
#      resolved ref is pinned in the storage-port spec; the KDF golden
#      itself is pinned by the cipher-b keys spec.)
#
# @req: REQ-SQLCIPHER-SECRETREF-001 — SecretRef indirection replaces the
#       open_key passphrase shim (plan §4.2).

"""
## Purpose and audience
Purpose: Verify SecretRef parsing, env binding, resolution, and its
adoption by the SQLCipher 4 page codec open path.
Audience: codec integration maintainers, security review.
"""

use std.spec.*
use nogc_sync_mut.database.codec.sqlcipher4.{Sqlcipher4Error}
use nogc_sync_mut.database.codec.secret_ref.{
    SecretRef, secret_ref_parse, secret_ref_env_key, secret_ref_resolve,
    secret_ref_resolve_uri
}
use nogc_sync_mut.database.codec.sqlcipher4_page.{sqlcipher4_page_open_key}
use std.nogc_sync_mut.io.env_ops.{env_set}

fn _salt16() -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < 16:
        out.push((0x40 + i).to_u8())
        i = i + 1
    out

# --- module-level outcome helpers (match arms RETURN; the it-block
#     var-mutation footgun makes in-place branch assignment unreliable) ---

fn _parse_outcome(uri: text) -> text:
    match secret_ref_parse(uri):
        Err(Sqlcipher4Error.MissingSecret(_)):
            "missing_secret"
        Err(_):
            "other_error"
        Ok(_):
            "ok"

fn _parse_key_or(uri: text, fallback: text) -> text:
    match secret_ref_parse(uri):
        Err(_):
            fallback
        Ok(r):
            secret_ref_env_key(r)

fn _resolve_outcome(uri: text) -> text:
    match secret_ref_resolve_uri(uri):
        Err(Sqlcipher4Error.MissingSecret(d)):
            "missing_secret:{d}"
        Err(_):
            "other_error"
        Ok(_):
            "ok"

fn _resolve_len_or(uri: text, fallback: i64) -> i64:
    match secret_ref_parse(uri):
        Err(_):
            fallback
        Ok(r):
            match secret_ref_resolve(r):
                Err(_):
                    fallback
                Ok(bytes):
                    bytes.len()

fn _resolve_byte_or(uri: text, idx: i64, fallback: i64) -> i64:
    match secret_ref_parse(uri):
        Err(_):
            fallback
        Ok(r):
            match secret_ref_resolve(r):
                Err(_):
                    fallback
                Ok(bytes):
                    (bytes[idx] as i64) & 0xFF

fn _open_outcome(ref_uri: text) -> text:
    match sqlcipher4_page_open_key(ref_uri, _salt16()):
        Err(Sqlcipher4Error.MissingSecret(_)):
            "missing_secret"
        Err(e):
            "other:{e}"
        Ok(_):
            "ok"

describe "secret_ref parse + env binding":
    it "admits a well-formed secret:// reference and binds one env var":
        step("parse secret://messenger/fixture")
        expect(_parse_outcome("secret://messenger/fixture")).to_equal("ok")
        expect(_parse_key_or("secret://messenger/fixture", "")).to_equal(
            "SIMPLE_SECRET_MESSENGER_FIXTURE")

    it "folds dash and dot to underscore and uppercases the name":
        step("parse secret://Team.Alpha-1")
        expect(_parse_key_or("secret://Team.Alpha-1", "")).to_equal(
            "SIMPLE_SECRET_TEAM_ALPHA_1")

    it "rejects a bare passphrase as a reference (never coerced)":
        step("parse 'hunter2' -> MissingSecret")
        expect(_parse_outcome("hunter2")).to_equal("missing_secret")

    it "rejects path traversal and platform separators in the name":
        step("parse secret://../etc/passwd, secret://a:b, secret://a\\b")
        expect(_parse_outcome("secret://../etc/passwd")).to_equal("missing_secret")
        expect(_parse_outcome("secret://a:b")).to_equal("missing_secret")
        expect(_parse_outcome("secret://a\\b")).to_equal("missing_secret")

    it "rejects empty name, wrong scheme, and oversized names":
        step("parse edge cases")
        expect(_parse_outcome("secret://")).to_equal("missing_secret")
        expect(_parse_outcome("env://thing")).to_equal("missing_secret")
        var big = "secret://"
        var i = 0
        while i < 200:
            big = big + "a"
            i = i + 1
        expect(_parse_outcome(big)).to_equal("missing_secret")

describe "secret_ref resolution":
    it "resolves the env value to UTF-8 bytes":
        step("set env, resolve, compare")
        val _ = env_set("SIMPLE_SECRET_SECRETREF_SPEC", "sëcret ✓ value")
        expect(_resolve_len_or("secret://secretref/spec", -1)).to_equal(17)
        expect(_resolve_byte_or("secret://secretref/spec", 0, -1)).to_equal(0x73)
        expect(_resolve_byte_or("secret://secretref/spec", 1, -1)).to_equal(0xC3)
        expect(_resolve_byte_or("secret://secretref/spec", 11, -1)).to_equal(0x20)
        expect(_resolve_byte_or("secret://secretref/spec", 16, -1)).to_equal(0x65)

    it "fails closed on an unset env var, naming only the var":
        step("resolve secret://secretref/absent (unset)")
        val outcome = _resolve_outcome("secret://secretref/absent")
        expect(outcome.starts_with("missing_secret:")).to_equal(true)
        expect(outcome.contains("SIMPLE_SECRET_SECRETREF_ABSENT")).to_equal(true)
        expect(outcome.contains("hunter")).to_equal(false)

    it "fails closed on an explicitly empty env value":
        step("set empty env, resolve")
        val _ = env_set("SIMPLE_SECRET_SECRETREF_EMPTY", "")
        expect(_resolve_outcome("secret://secretref/empty").starts_with("missing_secret")).to_equal(true)

describe "page codec open path takes a reference (shim replaced)":
    it "open_key with an unresolved ref is MissingSecret, not a KDF over the ref text":
        step("open_key('secret://cipher_c/spec_unset', salt)")
        expect(_open_outcome("secret://cipher_c/spec_unset")).to_equal("missing_secret")

    it "open_key with a non-reference argument is rejected (no passphrase shim)":
        step("open_key('cipher-c-integration-passphrase', salt) must NOT derive")
        expect(_open_outcome("cipher-c-integration-passphrase")).to_equal("missing_secret")
