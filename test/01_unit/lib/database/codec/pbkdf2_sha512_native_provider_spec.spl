# @cover src/runtime/runtime_native.c
# @cover src/lib/nogc_sync_mut/database/codec/sqlcipher4_keys.spl
# Independent expected octets: Python hashlib.pbkdf2_hmac("sha512", ...).
use std.spec.*
use std.spec.step
use std.database.codec.sqlcipher4_keys.{_sqlcipher4_pbkdf2_sha512}
use std.common.crypto.pbkdf2.{pbkdf2_sha512_bytes as pure_sha512_reference}

describe "Native SQLCipher SHA512 key derivation":
    it "should preserve the one-round SHA512 vector":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8], [115u8, 97u8, 108u8, 116u8], 1, 64)
        expect(actual).to_equal([134u8, 127u8, 112u8, 207u8, 26u8, 222u8, 2u8, 207u8, 243u8, 117u8, 37u8, 153u8, 163u8, 165u8, 61u8, 196u8, 175u8, 52u8, 199u8, 166u8, 105u8, 129u8, 90u8, 229u8, 213u8, 19u8, 85u8, 78u8, 28u8, 140u8, 242u8, 82u8, 192u8, 45u8, 71u8, 10u8, 40u8, 90u8, 5u8, 1u8, 186u8, 217u8, 153u8, 191u8, 233u8, 67u8, 192u8, 143u8, 5u8, 2u8, 53u8, 215u8, 214u8, 139u8, 29u8, 165u8, 94u8, 99u8, 247u8, 59u8, 96u8, 165u8, 127u8, 206u8])

    it "should preserve the multiple output blocks":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8], [115u8, 97u8, 108u8, 116u8], 2, 96)
        expect(actual).to_equal([225u8, 217u8, 193u8, 106u8, 166u8, 129u8, 112u8, 138u8, 69u8, 245u8, 199u8, 196u8, 226u8, 21u8, 206u8, 182u8, 110u8, 1u8, 26u8, 46u8, 159u8, 0u8, 64u8, 113u8, 63u8, 24u8, 174u8, 253u8, 184u8, 102u8, 213u8, 60u8, 247u8, 108u8, 171u8, 40u8, 104u8, 163u8, 155u8, 159u8, 120u8, 64u8, 237u8, 206u8, 79u8, 239u8, 90u8, 130u8, 190u8, 103u8, 51u8, 92u8, 119u8, 166u8, 6u8, 142u8, 4u8, 17u8, 39u8, 84u8, 242u8, 124u8, 207u8, 78u8, 71u8, 62u8, 49u8, 26u8, 216u8, 39u8, 182u8, 137u8, 69u8, 244u8, 226u8, 221u8, 219u8, 32u8, 76u8, 120u8, 228u8, 14u8, 36u8, 149u8, 20u8, 30u8, 65u8, 28u8, 210u8, 114u8, 208u8, 32u8, 100u8, 13u8, 103u8, 60u8])

    it "should preserve the long HMAC key and salt":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8, 112u8], [115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8, 115u8], 3, 65)
        expect(actual).to_equal([117u8, 46u8, 77u8, 244u8, 189u8, 21u8, 7u8, 84u8, 115u8, 94u8, 200u8, 150u8, 107u8, 111u8, 189u8, 81u8, 96u8, 189u8, 39u8, 11u8, 208u8, 174u8, 24u8, 144u8, 152u8, 96u8, 249u8, 21u8, 75u8, 188u8, 34u8, 109u8, 12u8, 214u8, 43u8, 242u8, 178u8, 97u8, 67u8, 189u8, 208u8, 27u8, 53u8, 181u8, 155u8, 14u8, 191u8, 77u8, 198u8, 106u8, 157u8, 161u8, 65u8, 42u8, 15u8, 52u8, 221u8, 46u8, 199u8, 70u8, 118u8, 132u8, 95u8, 54u8, 204u8])

    it "should preserve the empty inputs and zero-round compatibility":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([], [], 0, 32)
        expect(actual).to_equal([109u8, 46u8, 203u8, 187u8, 251u8, 46u8, 109u8, 205u8, 112u8, 86u8, 250u8, 249u8, 175u8, 106u8, 160u8, 110u8, 174u8, 89u8, 67u8, 145u8, 219u8, 152u8, 50u8, 121u8, 166u8, 191u8, 39u8, 224u8, 235u8, 34u8, 134u8, 20u8])

    it "should preserve the binary inputs with zero and high octets":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([0u8, 255u8, 128u8], [0u8, 128u8], 5, 73)
        expect(actual).to_equal([49u8, 215u8, 12u8, 109u8, 188u8, 79u8, 109u8, 197u8, 151u8, 156u8, 0u8, 172u8, 92u8, 20u8, 206u8, 235u8, 192u8, 249u8, 175u8, 29u8, 194u8, 139u8, 57u8, 102u8, 218u8, 106u8, 57u8, 33u8, 87u8, 172u8, 67u8, 241u8, 127u8, 183u8, 102u8, 94u8, 56u8, 148u8, 132u8, 109u8, 234u8, 2u8, 147u8, 164u8, 48u8, 230u8, 180u8, 214u8, 239u8, 187u8, 25u8, 228u8, 229u8, 153u8, 132u8, 101u8, 162u8, 177u8, 137u8, 69u8, 103u8, 207u8, 207u8, 242u8, 25u8, 145u8, 5u8, 231u8, 167u8, 110u8, 70u8, 45u8, 46u8])

    it "should preserve the 4096-round vector":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8], [115u8, 97u8, 108u8, 116u8], 4096, 32)
        expect(actual).to_equal([209u8, 151u8, 177u8, 179u8, 61u8, 176u8, 20u8, 62u8, 1u8, 139u8, 18u8, 243u8, 209u8, 209u8, 71u8, 158u8, 108u8, 222u8, 189u8, 204u8, 151u8, 197u8, 192u8, 248u8, 127u8, 105u8, 2u8, 224u8, 114u8, 244u8, 87u8, 181u8])

    it "should preserve the empty derived output":
        step("Derive synthetic bytes through the production KDF owner")
        val actual = _sqlcipher4_pbkdf2_sha512([112u8, 97u8, 115u8, 115u8, 119u8, 111u8, 114u8, 100u8], [115u8, 97u8, 108u8, 116u8], 1, 0)
        expect(actual).to_equal([])

    it "should match the canonical Simple reference through its alias":
        step("Compare native and pure Simple derivation for the same synthetic octets")
        val native = _sqlcipher4_pbkdf2_sha512([112u8, 97u8, 115u8, 115u8], [115u8, 97u8, 108u8, 116u8], 1, 32)
        val reference = pure_sha512_reference([112, 97, 115, 115], [115, 97, 108, 116], 1, 32)
        expect(native.len()).to_equal(32)
        expect(reference.len()).to_equal(32)
        var index: i64 = 0
        while index < 32:
            expect(native[index] as i64).to_equal(reference[index])
            index = index + 1
