# SQLCipher 4 page codec — geometry, CBC page encryption, per-page HMAC spec.
#
# Pins the sqlcipher4_4k_sha512 page layer of
# src/lib/nogc_sync_mut/database/codec/sqlcipher4_page.spl:
#
#   1. Round-trip: pages 1 and 7 encode then decode to the identical 4016-byte
#      virtual body under deterministic fixed keys/IVs.
#   2. Geometry: encoded pages are exactly 4096 bytes; salt at [0,16) of an
#      encoded page 1; IV at [4016,4032); HMAC-SHA512 at [4032,4096); the HMAC
#      matches an independent HMAC-SHA512 over ciphertext || IV || pgno_le32.
#   3. HMAC binding: flipping one byte in the ciphertext, the IV, or the
#      stored HMAC, and swapping the page-number binding, each yields
#      AuthenticationFailed with NO plaintext returned.
#   4. Wrong keys: wrong HMAC key -> AuthenticationFailed; wrong AES key on
#      page 1 -> CorruptPage via the SQLite-magic structural guard. Neither
#      discloses plaintext.
#   5. Constant-time comparator: equal only on exact matches (positive and
#      negative vectors, including all-0x00 vs all-0xFF HMACs of equal length).
#   6. Raw CBC known vector: NIST SP 800-38A F.2.5 (AES-256 CBC) key/IV on a
#      4016-byte page-7 body; the first two ciphertext blocks must equal the
#      published vector — proving raw CBC chaining with NO padding (the padded
#      std.common.aes.modes path appends a block and would differ).
#   7. PageCodecV1 integration (codec_registry.spl): the page factory
#      registers against the locked profile, resolves lazily, and encodes /
#      decodes / authenticates / closes a full session through the record fns
#      with a fresh rng-drawn IV per encode.

"""
## Purpose and audience
Purpose: Verify the SQLCipher 4 page codec (geometry + CBC + per-page HMAC).
Audience: codec maintainers and the sibling crypto-primitive lanes.
"""

# @timeout_secs 2400 (interpreted-mode AES suites are slow; the directive is an
# honest runtime record, not a relaxed gate)
# @req: REQ-CIPHER-PAGE-001 — stable requirement identity for this spec.

use std.spec.*
use nogc_sync_mut.database.codec.sqlcipher4.{
    Sqlcipher4Error, sqlcipher4_profile
}
use nogc_sync_mut.database.codec.codec_registry.{
    CodecRegistry, codec_registry_sqlcipher4_entry
}
use nogc_sync_mut.database.codec.sqlcipher4_page.{
    SQLCIPHER4_PAGE_SIZE,
    SQLCIPHER4_PAGE_BODY_BYTES,
    SQLCIPHER4_PAGE1_SALT_BYTES,
    SQLCIPHER4_IV_OFFSET,
    SQLCIPHER4_HMAC_OFFSET,
    SQLCIPHER4_SESSION_MATERIAL_BYTES,
    sqlcipher4_encode_page,
    sqlcipher4_decode_page,
    sqlcipher4_page1_salt,
    sqlcipher4_constant_time_eq,
    sqlcipher4_page_factory
}
use std.common.crypto.hmac.{hmac_sha512_bytes}
use std.nogc_sync_mut.io.env_ops.{env_set}

extern fn rt_bytes_u8_at(arr: [u8], idx: i64) -> i64

# ============================================================================
# Helpers (module-level to avoid the it-block var-mutation footgun)
# ============================================================================

fn _to_list(arr: [u8], n: i64) -> list:
    _to_list_at(arr, 0, n)

fn _to_list_at(arr: [u8], off: i64, n: i64) -> list:
    var out = []
    var i = 0
    while i < n:
        out.append(rt_bytes_u8_at(arr, off + i) & 0xFF)
        i = i + 1
    out

fn _to_i64_flat(arr: list) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < arr.length():
        out.append(arr[i] & 0xFF)
        i = i + 1
    out

fn _to_i64_u8(arr: [u8]) -> [i64]:
    var out: [i64] = []
    var i = 0
    while i < arr.len():
        out.push(rt_bytes_u8_at(arr, i) & 0xFF)
        i = i + 1
    out

fn _to_u8(arr: list) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < arr.length():
        out.push((arr[i] & 0xFF).to_u8())
        i = i + 1
    out

# Deterministic 4016-byte virtual page body for page 1. [0,16) is the DB
# salt; [16,18) carries the SQLite page-size field 0x10 0x00 (4096, the
# profile-pinned size) so the body's structural guard accepts it.
fn _body_page1() -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < SQLCIPHER4_PAGE_BODY_BYTES:
        out.push(((i * 7 + 3) & 0xFF).to_u8())
        i = i + 1
    out[16] = 0x10u8
    out[17] = 0x00u8
    out

# Deterministic 4016-byte body for pages >= 2.
fn _body_page7() -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < SQLCIPHER4_PAGE_BODY_BYTES:
        out.push(((i * 11 + 5) & 0xFF).to_u8())
        i = i + 1
    out

fn _aes_key() -> [u8]:
    _to_u8([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
            0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
            0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
            0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f])

fn _hmac_key() -> [u8]:
    _to_u8([0xa0, 0xa1, 0xa2, 0xa3, 0xa4, 0xa5, 0xa6, 0xa7,
            0xa8, 0xa9, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf,
            0xb0, 0xb1, 0xb2, 0xb3, 0xb4, 0xb5, 0xb6, 0xb7,
            0xb8, 0xb9, 0xba, 0xbb, 0xbc, 0xbd, 0xbe, 0xbf])

fn _wrong_key() -> [u8]:
    _to_u8([0xff, 0xfe, 0xfd, 0xfc, 0xfb, 0xfa, 0xf9, 0xf8,
            0xf7, 0xf6, 0xf5, 0xf4, 0xf3, 0xf2, 0xf1, 0xf0,
            0xef, 0xee, 0xed, 0xec, 0xeb, 0xea, 0xe9, 0xe8,
            0xe7, 0xe6, 0xe5, 0xe4, 0xe3, 0xe2, 0xe1, 0xe0])

fn _iv1() -> [u8]:
    _to_u8([0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
            0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f])

fn _iv7() -> [u8]:
    _to_u8([0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77,
            0x78, 0x79, 0x7a, 0x7b, 0x7c, 0x7d, 0x7e, 0x7f])

fn _encode_page1() -> [u8]:
    match sqlcipher4_encode_page(1, _body_page1(), _iv1(), _aes_key(), _hmac_key()):
        case Ok(page):
            page
        case Err(e):
            fail("page 1 encode failed: {e}")

fn _encode_page7() -> [u8]:
    match sqlcipher4_encode_page(7, _body_page7(), _iv7(), _aes_key(), _hmac_key()):
        case Ok(page):
            page
        case Err(e):
            fail("page 7 encode failed: {e}")

# Return a copy of `page` with one byte flipped. (In-place mutation is
# unreliable on this build: arrays bound through call/match boundaries can
# arrive frozen, and a silent no-op flip would make every tamper vector
# below pass vacuously. A locally push-built copy is always writable.)
fn _flip(page: [u8], idx: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < page.len():
        out.push(page[i])
        i = i + 1
    out[idx] = ((rt_bytes_u8_at(out, idx) & 0xFF) ^ 0x01).to_u8()
    out

# Independent HMAC input assembly (mirrors the codec contract, built here so
# a wrong HMAC extent in the codec fails this spec).
fn _le32(n: i64) -> list:
    [n & 0xFF, (n >> 8) & 0xFF, (n >> 16) & 0xFF, (n >> 24) & 0xFF]

fn _hmac_input(ct_off: i64, ct_len: i64, page: [u8], page_no: i64) -> list:
    var input = []
    var i = 0
    while i < ct_len:
        input.append(rt_bytes_u8_at(page, ct_off + i) & 0xFF)
        i = i + 1
    var v = 0
    while v < 16:
        input.append(rt_bytes_u8_at(page, SQLCIPHER4_IV_OFFSET + v) & 0xFF)
        v = v + 1
    var pg = _le32(page_no)
    var g = 0
    while g < 4:
        input.append(pg[g])
        g = g + 1
    input

# ============================================================================
# Round-trip
# ============================================================================

describe "SQLCipher 4 page codec — round-trip":

    it "round-trips page 1 to the identical 4016-byte virtual body":
        step("Verify: page 1 encode/decode round-trip")
        # @req: REQ-CIPHER-PAGE-001
        val page = _encode_page1()
        match sqlcipher4_decode_page(1, page, _aes_key(), _hmac_key()):
            case Ok(pt):
                expect(pt.len()).to_equal(SQLCIPHER4_PAGE_BODY_BYTES)  # oracle: authoritative expected value documented by this spec's contract
                expect(_to_list(pt, pt.len())).to_equal(_to_list(_body_page1(), SQLCIPHER4_PAGE_BODY_BYTES))
            case Err(e):
                fail("page 1 decode failed: {e}")

    it "round-trips page 7 to the identical 4016-byte virtual body":
        step("Verify: page 7 encode/decode round-trip")
        val page = _encode_page7()
        match sqlcipher4_decode_page(7, page, _aes_key(), _hmac_key()):
            case Ok(pt):
                expect(pt.len()).to_equal(SQLCIPHER4_PAGE_BODY_BYTES)  # oracle: authoritative expected value documented by this spec's contract
                expect(_to_list(pt, pt.len())).to_equal(_to_list(_body_page7(), SQLCIPHER4_PAGE_BODY_BYTES))
            case Err(e):
                fail("page 7 decode failed: {e}")

# ============================================================================
# Geometry
# ============================================================================

describe "SQLCipher 4 page codec — page geometry":

    it "emits exactly 4096 bytes with the trailer at the exact offsets":
        step("Verify: encoded page length and trailer offsets")
        val p1 = _encode_page1()
        val p7 = _encode_page7()
        expect(p1.len()).to_equal(4096)  # oracle: authoritative expected value documented by this spec's contract
        expect(p7.len()).to_equal(4096)  # oracle: authoritative expected value documented by this spec's contract
        # IV occupies [4016,4032) and equals the caller-supplied IV.
        expect(_to_list_at(p7, SQLCIPHER4_IV_OFFSET, 16)).to_equal(_to_list(_iv7(), 16))
        expect(_to_list_at(p1, SQLCIPHER4_IV_OFFSET, 16)).to_equal(_to_list(_iv1(), 16))

    it "stores the salt plaintext at [0,16) of an encoded page 1":
        step("Verify: page 1 salt is plaintext at [0,16)")
        val p1 = _encode_page1()
        val body = _body_page1()
        val salt_region = _to_list(p1, SQLCIPHER4_PAGE1_SALT_BYTES)
        expect(salt_region).to_equal(_to_list(body, SQLCIPHER4_PAGE1_SALT_BYTES))

    it "exposes the page 1 salt separately via sqlcipher4_page1_salt":
        step("Verify: sqlcipher4_page1_salt returns the plaintext salt")
        val p1 = _encode_page1()
        match sqlcipher4_page1_salt(p1):
            case Ok(salt):
                expect(salt.len()).to_equal(16)  # oracle: authoritative expected value documented by this spec's contract
                expect(_to_list(salt, 16)).to_equal(_to_list(_body_page1(), 16))
            case Err(e):
                fail("salt extraction failed: {e}")

    it "stores HMAC-SHA512 at [4032,4096) matching an independent computation":
        step("Verify: trailer HMAC matches ciphertext || IV || pgno_le32")
        # Page 7: ciphertext extent is [0,4016).
        val p7 = _encode_page7()
        val expected7 = hmac_sha512_bytes(_to_i64_u8(_hmac_key()), _to_i64_flat(_hmac_input(0, 4016, p7, 7)))
        expect(_to_list_at(p7, SQLCIPHER4_HMAC_OFFSET, 64)).to_equal(expected7)
        # Page 1: ciphertext extent is [16,4016) — the salt is NOT HMACed.
        val p1 = _encode_page1()
        val expected1 = hmac_sha512_bytes(_to_i64_u8(_hmac_key()), _to_i64_flat(_hmac_input(16, 4000, p1, 1)))
        expect(_to_list_at(p1, SQLCIPHER4_HMAC_OFFSET, 64)).to_equal(expected1)

    it "binds the page number LITTLE-endian, not big-endian":
        step("Verify: HMAC input uses LE page number (CIPHER_FLAG_LE_PGNO)")
        val p7 = _encode_page7()
        val le = hmac_sha512_bytes(_to_i64_u8(_hmac_key()), _to_i64_flat(_hmac_input(0, 4016, p7, 7)))
        # Same input with the page number big-endian must NOT authenticate.
        var be_input = []
        var i = 0
        while i < 4016:
            be_input.append(rt_bytes_u8_at(p7, i) & 0xFF)
            i = i + 1
        var v = 0
        while v < 16:
            be_input.append(rt_bytes_u8_at(p7, SQLCIPHER4_IV_OFFSET + v) & 0xFF)
            v = v + 1
        be_input.append((7 >> 24) & 0xFF)
        be_input.append((7 >> 16) & 0xFF)
        be_input.append((7 >> 8) & 0xFF)
        be_input.append(7 & 0xFF)
        val be = hmac_sha512_bytes(_to_i64_u8(_hmac_key()), _to_i64_flat(be_input))
        expect(be == le).to_equal(false)

# ============================================================================
# HMAC binding — tampering yields AuthenticationFailed, zero plaintext
# ============================================================================

describe "SQLCipher 4 page codec — HMAC authentication binding":

    it "rejects a flipped ciphertext byte with AuthenticationFailed and no plaintext":
        step("Verify: ciphertext tamper -> AuthenticationFailed, no plaintext")
        val page = _encode_page7()
        match sqlcipher4_decode_page(7, _flip(page, 100), _aes_key(), _hmac_key()):
            case Ok(_):
                fail("tampered ciphertext must not release plaintext")
            case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                pass
            case Err(e):
                fail("expected AuthenticationFailed, got {e}")

    it "rejects a flipped IV byte with AuthenticationFailed and no plaintext":
        step("Verify: IV tamper -> AuthenticationFailed, no plaintext")
        val page = _encode_page7()
        match sqlcipher4_decode_page(7, _flip(page, SQLCIPHER4_IV_OFFSET + 3), _aes_key(), _hmac_key()):
            case Ok(_):
                fail("tampered IV must not release plaintext")
            case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                pass
            case Err(e):
                fail("expected AuthenticationFailed, got {e}")

    it "rejects a flipped stored-HMAC byte with AuthenticationFailed and no plaintext":
        step("Verify: HMAC tamper -> AuthenticationFailed, no plaintext")
        val page = _encode_page7()
        match sqlcipher4_decode_page(7, _flip(page, SQLCIPHER4_HMAC_OFFSET + 20), _aes_key(), _hmac_key()):
            case Ok(_):
                fail("tampered HMAC must not release plaintext")
            case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                pass
            case Err(e):
                fail("expected AuthenticationFailed, got {e}")

    it "rejects a swapped page-number binding with AuthenticationFailed and no plaintext":
        step("Verify: decoding page 7 bytes as page 8 -> AuthenticationFailed")
        val page = _encode_page7()
        match sqlcipher4_decode_page(8, page, _aes_key(), _hmac_key()):
            case Ok(_):
                fail("page-number swap must not release plaintext")
            case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                pass
            case Err(e):
                fail("expected AuthenticationFailed, got {e}")

    it "does not reveal whether the key or the data was wrong":
        step("Verify: AuthenticationFailed text is identical for wrong key vs tampered data")
        val tampered = _flip(_encode_page7(), 100)
        val wrong_key_page = _encode_page7()
        var msg_tamper = ""
        var msg_wrongkey = ""
        match sqlcipher4_decode_page(7, tampered, _aes_key(), _hmac_key()):
            case Err(Sqlcipher4Error.AuthenticationFailed(m)):
                msg_tamper = m
            case _:
                fail("tampered page must fail authentication")
        match sqlcipher4_decode_page(7, wrong_key_page, _aes_key(), _wrong_key()):
            case Err(Sqlcipher4Error.AuthenticationFailed(m)):
                msg_wrongkey = m
            case _:
                fail("wrong HMAC key must fail authentication")
        expect(msg_tamper).to_equal(msg_wrongkey)

# ============================================================================
# Wrong keys
# ============================================================================

describe "SQLCipher 4 page codec — wrong-key fail-closed behavior":

    it "wrong HMAC key on page 7 yields AuthenticationFailed with no plaintext":
        step("Verify: wrong HMAC key -> AuthenticationFailed")
        val page = _encode_page7()
        match sqlcipher4_decode_page(7, page, _aes_key(), _wrong_key()):
            case Ok(_):
                fail("wrong HMAC key must not release plaintext")
            case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                pass
            case Err(e):
                fail("expected AuthenticationFailed, got {e}")

    it "wrong AES key on page 1 yields CorruptPage via the page-size field guard":
        step("Verify: wrong AES key on page 1 -> CorruptPage, no plaintext")
        val page = _encode_page1()
        match sqlcipher4_decode_page(1, page, _wrong_key(), _hmac_key()):
            case Ok(_):
                fail("wrong AES key must not release page 1 plaintext")
            case Err(Sqlcipher4Error.CorruptPage(_)):
                pass
            case Err(e):
                fail("expected CorruptPage, got {e}")

# ============================================================================
# Geometry / header error taxonomy
# ============================================================================

describe "SQLCipher 4 page codec — typed geometry and header errors":

    it "rejects a wrong-sized page with InvalidPageGeometry":
        step("Verify: decode of a 4000-byte page -> InvalidPageGeometry")
        var short: [u8] = []
        var i = 0
        while i < 4000:
            short.push(0u8)
            i = i + 1
        match sqlcipher4_decode_page(7, short, _aes_key(), _hmac_key()):
            case Err(Sqlcipher4Error.InvalidPageGeometry(_)):
                pass
            case _:
                fail("short page must be rejected as InvalidPageGeometry")

    it "rejects a wrong-sized plaintext body with InvalidPageGeometry":
        step("Verify: encode of a 4000-byte body -> InvalidPageGeometry")
        var short: [u8] = []
        var i = 0
        while i < 4000:
            short.push(0u8)
            i = i + 1
        match sqlcipher4_encode_page(7, short, _iv7(), _aes_key(), _hmac_key()):
            case Err(Sqlcipher4Error.InvalidPageGeometry(_)):
                pass
            case _:
                fail("short plaintext must be rejected as InvalidPageGeometry")

    it "rejects out-of-range and zero page numbers with CorruptPage":
        step("Verify: page numbers are 1-based and bounded")
        match sqlcipher4_encode_page(0, _body_page7(), _iv7(), _aes_key(), _hmac_key()):
            case Err(Sqlcipher4Error.CorruptPage(_)):
                pass
            case _:
                fail("page number 0 must be rejected as CorruptPage")

    it "rejects an encoded page 1 with a plaintext SQLite header":
        step("Verify: plaintext-header variant -> UnsupportedPlaintextHeader")
        val page = _encode_page1()
        val magic = [0x53, 0x51, 0x4C, 0x69, 0x74, 0x65, 0x20, 0x66,
                     0x6F, 0x72, 0x6D, 0x61, 0x74, 0x20, 0x33, 0x00]
        var i = 0
        while i < 16:
            page[i] = (magic[i]).to_u8()
            i = i + 1
        match sqlcipher4_decode_page(1, page, _aes_key(), _hmac_key()):
            case Err(Sqlcipher4Error.UnsupportedPlaintextHeader(_)):
                pass
            case _:
                fail("plaintext SQLite header must be rejected before authentication")

# ============================================================================
# Constant-time comparator
# ============================================================================

describe "SQLCipher 4 page codec — constant-time HMAC comparator":

    it "returns true only for exact matches":
        step("Verify: positive and negative comparator vectors")
        var a: [i64] = []
        var b: [i64] = []
        var i = 0
        while i < 64:
            a.push(i & 0xFF)
            b.push(i & 0xFF)
            i = i + 1
        expect(sqlcipher4_constant_time_eq(a, b)).to_equal(true)
        b[63] = (b[63] & 0xFF) ^ 0x01
        expect(sqlcipher4_constant_time_eq(a, b)).to_equal(false)
        b[63] = a[63]
        b[0] = (b[0] & 0xFF) ^ 0x80
        expect(sqlcipher4_constant_time_eq(a, b)).to_equal(false)

    it "distinguishes all-0x00 from all-0xFF HMACs of equal length":
        step("Verify: all-0x00 vs all-0xFF, equal length")
        var zeros: [i64] = []
        var ones: [i64] = []
        var i = 0
        while i < 64:
            zeros.push(0)
            ones.push(0xFF)
            i = i + 1
        expect(sqlcipher4_constant_time_eq(zeros, ones)).to_equal(false)
        expect(sqlcipher4_constant_time_eq(zeros, zeros)).to_equal(true)
        expect(sqlcipher4_constant_time_eq(ones, ones)).to_equal(true)

    it "returns false for different lengths without scanning content":
        step("Verify: length mismatch is false")
        var short: [i64] = []
        var long: [i64] = []
        var i = 0
        while i < 64:
            long.push(0xAB)
            i = i + 1
        var j = 0
        while j < 63:
            short.push(0xAB)
            j = j + 1
        expect(sqlcipher4_constant_time_eq(short, long)).to_equal(false)
        expect(sqlcipher4_constant_time_eq(long, short)).to_equal(false)

# ============================================================================
# Raw CBC known vector (NIST SP 800-38A F.2.5, AES-256-CBC)
# ============================================================================

describe "SQLCipher 4 page codec — raw CBC chaining (no padding)":

    it "matches the F.2.5 AES-256-CBC vector on the first two blocks of a 4016-byte body":
        step("Verify: NIST SP 800-38A F.2.5 first two blocks, no padding")
        # @req: REQ-CIPHER-PAGE-001
        val key = _to_u8([0x60, 0x3d, 0xeb, 0x10, 0x15, 0xca, 0x71, 0xbe,
                          0x2b, 0x73, 0xae, 0xf0, 0x85, 0x7d, 0x77, 0x81,
                          0x1f, 0x35, 0x2c, 0x07, 0x3b, 0x61, 0x08, 0xd7,
                          0x2d, 0x98, 0x10, 0xa3, 0x09, 0x14, 0xdf, 0xf4])
        val iv = _to_u8([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
                         0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f])
        # Body whose first two 16-byte blocks are the F.2 plaintext blocks.
        var body: [u8] = []
        var i = 0
        while i < 4016:
            body.push(((i * 13 + 1) & 0xFF).to_u8())
            i = i + 1
        val f2_pt1 = [0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
                      0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a]
        val f2_pt2 = [0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
                      0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51]
        var f = 0
        while f < 16:
            body[f] = (f2_pt1[f]).to_u8()
            body[16 + f] = (f2_pt2[f]).to_u8()
            f = f + 1
        # Encode as page 7: ciphertext occupies [0,4016) — no padding block.
        val hmac_key = _hmac_key()
        match sqlcipher4_encode_page(7, body, iv, key, hmac_key):
            case Ok(page):
                expect(page.len()).to_equal(4096)  # oracle: authoritative expected value documented by this spec's contract
                # F.2.5 published first two ciphertext blocks.
                expect(_to_list(page, 16)).to_equal(
                    [0xf5, 0x8c, 0x4c, 0x04, 0xd6, 0xe5, 0xf1, 0xba,
                     0x77, 0x9e, 0xab, 0xfb, 0x5f, 0x7b, 0xfb, 0xd6])
                expect(_to_list_at(page, 16, 16)).to_equal(
                    [0x9c, 0xfc, 0x4e, 0x96, 0x7e, 0xdb, 0x80, 0x8d,
                     0x67, 0x9f, 0x77, 0x7b, 0xc6, 0x70, 0x2c, 0x7d])
                # IV trailer still at [4016,4032): proves no padding shifted it.
                expect(_to_list_at(page, SQLCIPHER4_IV_OFFSET, 16)).to_equal(_to_list(iv, 16))
            case Err(e):
                fail("F.2.5 encode failed: {e}")


# ============================================================================
# PageCodecV1 registry integration (codec_registry.spl)
# ============================================================================

fn _salt16() -> [u8]:
    _to_u8([0x5a, 0x1e, 0xc0, 0xde, 0x11, 0x22, 0x33, 0x44,
            0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0xcc])

# Deterministic rng for the PageCodecV1 encode path.
var _rng_calls: i64 = 0

fn _test_rng(n: i64) -> [u8]:
    _rng_calls = _rng_calls + 1
    var out: [u8] = []
    var i = 0
    while i < n:
        out.push(((_rng_calls * 31 + i * 7 + 5) & 0xFF).to_u8())
        i = i + 1
    out

fn _registered_registry() -> CodecRegistry:
    var registry = CodecRegistry.new()
    match registry.register_profile(sqlcipher4_profile(), 1):
        case Ok(_):
            registry
        case Err(e):
            fail("profile registration failed: {e}")

describe "SQLCipher 4 page codec — PageCodecV1 registry integration":

    it "resolves the page codec through the registry against the locked profile":
        step("Verify: factory registers, resolves lazily, exposes profile + manifest")
        var registry = _registered_registry()
        val entry = codec_registry_sqlcipher4_entry(sqlcipher4_page_factory, 1)
        match registry.register_codec(entry):
            case Ok(_):
                pass
            case Err(e):
                fail("codec admission failed: {e}")
        match registry.resolve("sqlcipher4"):
            case Ok(codec):
                expect(codec.codec_id).to_equal("sqlcipher4")
                expect(codec.profile_fn().page_size).to_equal(4096)  # oracle: authoritative expected value documented by this spec's contract
                expect(codec.manifest_fn().profile_digest).to_equal(entry.profile_digest)
            case Err(e):
                fail("codec resolve failed: {e}")

    it "encodes and decodes a full session through the PageCodecV1 record fns":
        step("Verify: open_key(secret://ref) -> encode(rng IV) -> decode round-trip via record fns")
        val _env1 = env_set("SIMPLE_SECRET_CIPHER_C_INTEGRATION", "cipher-c-integration-passphrase")
        var registry = _registered_registry()
        match registry.register_codec(codec_registry_sqlcipher4_entry(sqlcipher4_page_factory, 1)):
            case Ok(_):
                pass
            case Err(e):
                fail("codec admission failed: {e}")
        match registry.resolve("sqlcipher4"):
            case Err(e):
                fail("codec resolve failed: {e}")
            case Ok(codec):
                match codec.open_key_fn("secret://cipher_c/integration", _salt16()):
                    case Err(e):
                        fail("open_key failed: {e}")
                    case Ok(session):
                        expect(session.codec_id).to_equal("sqlcipher4")
                        expect(session.open).to_equal(true)
                        expect(session.secret_material.len()).to_equal(SQLCIPHER4_SESSION_MATERIAL_BYTES)  # oracle: authoritative expected value documented by this spec's contract
                        val body = _body_page7()
                        _rng_calls = 0
                        match codec.encode_page_fn(7, body, session, _test_rng):
                            case Err(e):
                                fail("session encode failed: {e}")
                            case Ok(page):
                                expect(page.len()).to_equal(4096)  # oracle: authoritative expected value documented by this spec's contract
                                # The encode drew exactly one fresh IV from rng.
                                expect(_rng_calls).to_equal(1)
                                match codec.decode_page_fn(7, page, session):
                                    case Err(e):
                                        fail("session decode failed: {e}")
                                    case Ok(pt):
                                        expect(_to_list(pt, pt.len())).to_equal(_to_list(body, body.len()))
                                # Tampering still authenticates before decrypt.
                                match codec.decode_page_fn(7, _flip(page, 200), session):
                                    case Ok(_):
                                        fail("tampered page must not release plaintext")
                                    case Err(Sqlcipher4Error.AuthenticationFailed(_)):
                                        pass
                                    case Err(e):
                                        fail("expected AuthenticationFailed, got {e}")
                        match codec.close_fn(session):
                            case Ok(_):
                                pass
                            case Err(e):
                                fail("close failed: {e}")

    it "draws a fresh IV per encoded page through the record encode path":
        step("Verify: two encodes of the same page consume two different IVs")
        val _env2 = env_set("SIMPLE_SECRET_CIPHER_C_IV_FRESHNESS", "cipher-c-iv-freshness-passphrase")
        var registry = _registered_registry()
        match registry.register_codec(codec_registry_sqlcipher4_entry(sqlcipher4_page_factory, 1)):
            case Ok(_):
                pass
            case Err(e):
                fail("codec admission failed: {e}")
        match registry.resolve("sqlcipher4"):
            case Err(e):
                fail("codec resolve failed: {e}")
            case Ok(codec):
                match codec.open_key_fn("secret://cipher_c/iv_freshness", _salt16()):
                    case Err(e):
                        fail("open_key failed: {e}")
                    case Ok(session):
                        val body = _body_page7()
                        _rng_calls = 0
                        match codec.encode_page_fn(7, body, session, _test_rng):
                            case Ok(first):
                                match codec.encode_page_fn(7, body, session, _test_rng):
                                    case Ok(second):
                                        expect(_rng_calls).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
                                        expect(_to_list_at(first, SQLCIPHER4_IV_OFFSET, 16) == _to_list_at(second, SQLCIPHER4_IV_OFFSET, 16)).to_equal(false)
                                        # Fresh IV changed the ciphertext too.
                                        expect(_to_list_at(first, 0, 16) == _to_list_at(second, 0, 16)).to_equal(false)
                                    case Err(e):
                                        fail("second encode failed: {e}")
                            case Err(e):
                                fail("first encode failed: {e}")
