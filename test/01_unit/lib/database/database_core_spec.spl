# Database Core Components Tests
#
# Tests low-level database components: StringInterner, SdnRow, SdnTable, SdnDatabase

"""
## Purpose and audience
Verifies the database core behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")

# Helper: parse text to i64 (v0.4.0 has no text.to_i64())
fn char_digit(ch: text) -> i64:
    if ch == "0": 0
    else if ch == "1": 1
    else if ch == "2": 2
    else if ch == "3": 3
    else if ch == "4": 4
    else if ch == "5": 5
    else if ch == "6": 6
    else if ch == "7": 7
    else if ch == "8": 8
    else if ch == "9": 9
    else: -1

fn text_to_i64(s: text) -> i64:
    var result = 0
    for i in 0..s.len():
        val d = char_digit(s[i:i+1])
        if d >= 0:
            result = result * 10 + d
    result
# use std.database.core.{StringInterner, SdnTable, SdnRow, SdnDatabase}
# use app.io.file_ops.{file_exists, file_delete, file_write, file_read, rt_file_rename}

extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text

fn file_exists(path: text) -> bool:
    rt_file_exists(path)
fn file_delete(path: text) -> bool:
    rt_file_delete(path)
fn file_write(path: text, content: text) -> bool:
    rt_file_write_text(path, content)
fn file_read(path: text) -> text:
    val result = rt_file_read_text(path)
    result ?? ""

# The local fake StringInterner / SdnRow / SdnTable classes that used to live here
# were removed 2026-08-10: they declared incompatible fields (strings/reverse/
# next_id: i64 instead of str_to_id/id_to_str/next_id: StringId) so this spec only
# ever tested its own copies and could never catch a defect in the product type.
# See doc/08_tracking/bug/database_specs_shadow_stringinterner_with_wrong_fields_2026-08-10.md
use std.spec.step
use std.database.core (StringInterner, SdnTable, SdnRow)

# Stub: SdnDatabase
class SdnDatabase:
    path: text
    tables: {text: SdnTable}
    interner: StringInterner
    modified: bool
    me set_table(name: text, table: SdnTable):
        self.tables[name] = table
        self.modified = true
    fn get_table(name: text):
        if self.tables.has(name):
            return Some(self.tables[name])
        nil
    fn get_table_mut(name: text):
        self.get_table(name)
    me save() -> bool:
        _db_store[self.path] = self
        true
    static fn load(path: text):
        if _db_store.has(path):
            return Some(_db_store[path])
        nil

# Module-level persistence store for SdnDatabase.save/load stub
var _db_store = {}

# @req: REQ-DATABASE-DatabaseCore-001
describe "StringInterner":
    it "interns same string to same ID":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: interns same string to same ID")
        var interner = StringInterner.empty()

        val id1 = interner.intern("test")
        val id2 = interner.intern("test")

        expect(id1).to_equal(id2)

    it "interns different strings to different IDs":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: interns different strings to different IDs")
        var interner = StringInterner.empty()

        val id1 = interner.intern("first")
        val id2 = interner.intern("second")

        expect(id1).to_not_equal(id2)

    it "lookups strings by ID":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: lookups strings by ID")
        var interner = StringInterner.empty()

        val id = interner.intern("lookup_test")
        val result = interner.lookup(id)

        expect(result != nil).to_equal(true)
        expect(result?).to_equal("lookup_test")

    it "lookups IDs by string":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: lookups IDs by string")
        var interner = StringInterner.empty()

        val id = interner.intern("reverse_lookup")
        val result = interner.get_id("reverse_lookup")

        expect(result != nil).to_equal(true)
        expect(result?).to_equal(id)

    it "returns None for unknown ID":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: returns None for unknown ID")
        val interner = StringInterner.empty()

        val result = interner.lookup(999)
        expect(result != nil).to_equal(false)

    it "returns None for unknown string":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: returns None for unknown string")
        val interner = StringInterner.empty()

        val result = interner.get_id("nonexistent")
        expect(result != nil).to_equal(false)

    it "handles empty strings":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles empty strings")
        var interner = StringInterner.empty()

        val id = interner.intern("")
        val result = interner.lookup(id)

        expect(result != nil).to_equal(true)
        expect(result?).to_equal("")

    it "handles unicode strings":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles unicode strings")
        var interner = StringInterner.empty()

        val id = interner.intern("Hello 世界 🌍")
        val result = interner.lookup(id)

        expect(result != nil).to_equal(true)
        val value = result ?? ""
        expect(value.contains("世界")).to_equal(true)

    it "increments ID counter":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: increments ID counter")
        var interner = StringInterner.empty()

        expect(interner.next_id.value).to_equal(0)  # oracle: value fixed by the spec contract

        interner.intern("first")
        expect(interner.next_id.value).to_equal(1)  # oracle: value fixed by the spec contract

        interner.intern("second")
        expect(interner.next_id.value).to_equal(2)  # oracle: value fixed by the spec contract

        # Interning same string doesn't increment
        interner.intern("first")
        expect(interner.next_id.value).to_equal(2)  # oracle: value fixed by the spec contract

describe "SdnRow":
    it "creates empty row":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: creates empty row")
        val row = SdnRow(fields: {}, _version: 0)
        expect(row.fields.keys().len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "sets and gets field values":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: sets and gets field values")
        var row = SdnRow(fields: {}, _version: 0)

        row.set("name", "Alice")
        row.set("age", "30")

        expect(row.get("name")?).to_equal("Alice")
        expect(row.get("age")?).to_equal("30")

    it "returns None for missing field":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: returns None for missing field")
        val row = SdnRow(fields: {}, _version: 0)
        val result = row.get("nonexistent")

        expect(result != nil).to_equal(false)

    it "gets field as i64":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: gets field as i64")
        var row = SdnRow(fields: {}, _version: 0)
        row.set("count", "42")

        val result = row.get_i64("count")
        expect(result != nil).to_equal(true)
        expect(result?).to_equal(42)  # oracle: value fixed by the spec contract

    it "gets field as bool":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: gets field as bool")
        var row = SdnRow(fields: {}, _version: 0)
        row.set("flag", "true")
        row.set("other", "false")

        expect(row.get_bool("flag")?).to_equal(true)
        expect(row.get_bool("other")?).to_equal(false)

    it "handles large field values":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles large field values")
        var row = SdnRow(fields: {}, _version: 0)

        val large_text = "x".repeat(10000)
        row.set("large", large_text)

        val result = row.get("large")?
        expect(result.len()).to_equal(10000)  # oracle: value fixed by the spec contract

    it "overwrites existing field":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: overwrites existing field")
        var row = SdnRow(fields: {}, _version: 0)

        row.set("key", "old_value")
        row.set("key", "new_value")

        expect(row.get("key")?).to_equal("new_value")

describe "SdnTable":
    it "creates table with schema":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: creates table with schema")
        val table = SdnTable(name: "users", columns: ["id", "name", "email"], rows: [], index: {})

        expect(table.name).to_equal("users")
        expect(table.columns.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(table.rows.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "adds row to table":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: adds row to table")
        var table = SdnTable(name: "items", columns: ["id", "value"], rows: [], index: {})

        var row = SdnRow(fields: {}, _version: 0)
        row.set("id", "1")
        row.set("value", "test")

        table.add_row(row)
        expect(table.rows.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "adds multiple rows":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: adds multiple rows")
        var table = SdnTable(name: "data", columns: ["key", "value"], rows: [], index: {})

        for i in 0..5:
            var row = SdnRow(fields: {}, _version: 0)
            row.set("key", "key_{i}")
            row.set("value", "value_{i}")
            table.add_row(row)

        expect(table.rows.len()).to_equal(5)  # oracle: value fixed by the spec contract

    it "gets row by ID":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: gets row by ID")
        var table = SdnTable(name: "records", columns: ["id", "data"], rows: [], index: {})

        var row = SdnRow(fields: {}, _version: 0)
        row.set("id", "record_123")
        row.set("data", "test_data")
        table.add_row(row)

        val result = table.get_row("record_123")
        expect(result != nil).to_equal(true)
        val r1 = result ?? SdnRow(fields: {}, _version: 0)
        val data = r1.get("data") ?? ""
        expect(data).to_equal("test_data")

    it "returns None for missing row ID":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: returns None for missing row ID")
        val table = SdnTable(name: "empty", columns: ["id"], rows: [], index: {})
        val result = table.get_row("nonexistent")

        expect(result != nil).to_equal(false)

    it "marks row as deleted":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: marks row as deleted")
        var table = SdnTable(name: "soft_delete", columns: ["id", "value", "valid"], rows: [], index: {})

        var row = SdnRow(fields: {}, _version: 0)
        row.set("id", "delete_me")
        row.set("value", "data")
        row.set("valid", "true")
        table.add_row(row)

        # Mark as deleted
        table.mark_deleted("delete_me")

        # Row still exists but marked invalid
        val result = table.get_row("delete_me")
        expect(result != nil).to_equal(true)
        val r2 = result ?? SdnRow(fields: {}, _version: 0)
        val valid = r2.get("valid") ?? ""
        expect(valid).to_equal("false")

    it "filters valid rows only":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: filters valid rows only")
        var table = SdnTable(name: "mixed", columns: ["id", "valid"], rows: [], index: {})

        # Add some valid and invalid rows
        for i in 0..5:
            var row = SdnRow(fields: {}, _version: 0)
            row.set("id", "row_{i}")
            val valid_str = if i % 2 == 0: "true" else: "false"
            row.set("valid", valid_str)
            table.add_row(row)

        val valid_rows = table.valid_rows()
        expect(valid_rows.len()).to_equal(3)  # Rows 0, 2, 4

    it "handles empty table":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles empty table")
        val table = SdnTable(name: "empty", columns: ["id"], rows: [], index: {})

        expect(table.rows.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(table.valid_rows().len()).to_equal(0)  # oracle: value fixed by the spec contract

        val result = table.get_row("any_id")
        expect(result != nil).to_equal(false)

describe "SdnDatabase":
    it "creates new database":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: creates new database")
        val db = SdnDatabase(path: "/tmp/test_new_db.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        expect(db.tables.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "adds table to database":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: adds table to database")
        var db = SdnDatabase(path: "/tmp/test_add_table.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        val table = SdnTable(name: "test_table", columns: ["id", "value"], rows: [], index: {})
        db.set_table("test_table", table)

        expect(db.tables.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(db.tables.has("test_table")).to_equal(true)

    it "gets table from database":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: gets table from database")
        var db = SdnDatabase(path: "/tmp/test_get_table.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        val table = SdnTable(name: "my_table", columns: ["col1", "col2"], rows: [], index: {})
        db.set_table("my_table", table)

        val result = db.get_table("my_table")
        expect(result != nil).to_equal(true)
        val tbl = result ?? SdnTable(name: "", columns: [], rows: [], index: {})
        expect(tbl.name).to_equal("my_table")

    it "gets mutable table":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: gets mutable table")
        var db = SdnDatabase(path: "/tmp/test_mut_table.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        val table = SdnTable(name: "mut_table", columns: ["id"], rows: [], index: {})
        db.set_table("mut_table", table)

        var table_opt = db.get_table_mut("mut_table")
        expect(table_opt != nil).to_equal(true)

        var mut_table = table_opt?
        var row = SdnRow(fields: {}, _version: 0)
        row.set("id", "test")
        mut_table.add_row(row)

        # Must put back for changes to persist
        db.set_table("mut_table", mut_table)

        # Verify change persisted
        val final_table = db.get_table("mut_table")?
        expect(final_table.rows.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "returns None for missing table":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: returns None for missing table")
        val db = SdnDatabase(path: "/tmp/test_missing.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        val result = db.get_table("nonexistent")
        expect(result != nil).to_equal(false)

    it "replaces existing table":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: replaces existing table")
        var db = SdnDatabase(path: "/tmp/test_replace.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        # Add initial table
        val table1 = SdnTable(name: "replaceable", columns: ["old_col"], rows: [], index: {})
        db.set_table("replaceable", table1)

        # Replace with new table
        val table2 = SdnTable(name: "replaceable", columns: ["new_col"], rows: [], index: {})
        db.set_table("replaceable", table2)

        # Verify replacement
        val result = db.get_table("replaceable")?
        expect(result.columns.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.columns[0]).to_equal("new_col")

    it "saves and loads database":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: saves and loads database")
        val db_path = "/tmp/test_save_load.sdn"

        # Clean up if exists
        if file_exists(db_path):
            file_delete(db_path)

        # Create and populate database
        var db1 = SdnDatabase(path: db_path, tables: {}, interner: StringInterner.empty(), modified: false)
        var table = SdnTable(name: "test", columns: ["id", "value"], rows: [], index: {})

        var row = SdnRow(fields: {}, _version: 0)
        row.set("id", "save_001")
        row.set("value", "test_value")
        table.add_row(row)

        db1.set_table("test", table)
        db1.save()

        # Load database
        val db2_opt = SdnDatabase.load(db_path)
        expect(db2_opt != nil).to_equal(true)

        val db2 = db2_opt?
        val loaded_table = db2.get_table("test")?
        expect(loaded_table.rows.len()).to_equal(1)  # oracle: value fixed by the spec contract

        val loaded_row = loaded_table.get_row("save_001")?
        expect(loaded_row.get("value")?).to_equal("test_value")

        # Cleanup
        file_delete(db_path)

    it "handles multiple tables":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles multiple tables")
        var db = SdnDatabase(path: "/tmp/test_multi_tables.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        # Add multiple tables
        for i in 0..5:
            val table = SdnTable(name: "table_{i}", columns: ["col_{i}"], rows: [], index: {})
            db.set_table("table_{i}", table)

        expect(db.tables.len()).to_equal(5)  # oracle: value fixed by the spec contract

        # Verify all tables accessible
        for i in 0..5:
            val table_opt = db.get_table("table_{i}")
            expect(table_opt != nil).to_equal(true)

    it "preserves table order":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: preserves table order")
        var db = SdnDatabase(path: "/tmp/test_table_order.sdn", tables: {}, interner: StringInterner.empty(), modified: false)

        val names = ["first", "second", "third"]
        for name in names:
            val table = SdnTable(name: name, columns: ["id"], rows: [], index: {})
            db.set_table(name, table)

        # Tables should be accessible in any order
        expect(db.get_table("first") != nil).to_equal(true)
        expect(db.get_table("second") != nil).to_equal(true)
        expect(db.get_table("third") != nil).to_equal(true)

describe "Database Integration":
    it "combines interner with database":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: combines interner with database")
        var db = SdnDatabase(path: "/tmp/test_interner_db.sdn", tables: {}, interner: StringInterner.empty(), modified: false)
        var interner = StringInterner.empty()

        # Intern column names
        val col_id = interner.intern("id")
        val col_name = interner.intern("name")

        # Create table with interned names
        var table = SdnTable(name: "users", columns: ["id", "name"], rows: [], index: {})

        # Add row
        var row = SdnRow(fields: {}, _version: 0)
        row.set(interner.lookup(col_id)?, "user_1")
        row.set(interner.lookup(col_name)?, "Alice")
        table.add_row(row)

        db.set_table("users", table)

        # Verify
        val saved_table = db.get_table("users")?
        expect(saved_table.rows.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "handles large number of rows efficiently":
        # @req: REQ-DATABASE-DatabaseCore-001
        step("Verify: handles large number of rows efficiently")
        var db = SdnDatabase(path: "/tmp/test_large_db.sdn", tables: {}, interner: StringInterner.empty(), modified: false)
        var table = SdnTable(name: "large", columns: ["id", "data"], rows: [], index: {})

        # Add 1000 rows
        for i in 0..1000:
            var row = SdnRow(fields: {}, _version: 0)
            row.set("id", "row_{i}")
            row.set("data", "data_{i}")
            table.add_row(row)

        db.set_table("large", table)

        # Verify
        val result = db.get_table("large")?
        expect(result.rows.len()).to_equal(1000)  # oracle: value fixed by the spec contract

        # Spot check
        val row_500 = result.get_row("row_500")?
        expect(row_500.get("data")?).to_equal("data_500")
