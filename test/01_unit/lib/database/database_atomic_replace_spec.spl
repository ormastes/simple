use std.spec.{describe, expect, it}
use std.io.{file_read, file_delete}
use std.nogc_sync_mut.database.atomic.{atomic_write}

describe "Database atomic write replace":
    it "creates a new file":
        val path = "build/test_tmp/atomic_replace_new.txt"
        file_delete(path)
        expect(atomic_write(path, "first")).to_equal(true)
        expect(file_read(path)).to_equal("first")
        file_delete(path)

    it "replaces an existing file":
        val path = "build/test_tmp/atomic_replace_existing.txt"
        file_delete(path)
        expect(atomic_write(path, "first")).to_equal(true)
        expect(atomic_write(path, "second")).to_equal(true)
        expect(file_read(path)).to_equal("second")
        file_delete(path)
