"""Exact accepted StartupMessage aggregate-transport regression fixture.

The native acceptance client was reset after sending this packet.  No retained
program counter exists, so this fixture does not assign a crash cause.  It
guards the repaired boundary on that path: `wire` retains the nested decoded
aggregate and `connection` consumes only scalar/text projections from its
owned decoder before creating the transport action.
"""

use std.spec
use std.database.postgres_mimic.wire.{
    PgWireDecodeStatus, PgWireMessageKind, pgwire_decoder
}
use std.database.postgres_mimic.connection.{PgWireSslPolicy}
use std.database.postgres_mimic.transport.{
    PgWireTransportEventKind, pgwire_transport_driver
}
use std.database.postgres_mimic.server.{PostgresMimicServer}
use std.database.postgres_mimic.wire_encode.{pgwire_encode_startup}

fn accepted_startup_packet() -> [i64]:
    # Byte-for-byte equivalent to the retained strict-acceptance Python client:
    # struct.pack("!II", len(startup) + 8, 196608) + startup.
    val startup = "user\0local\0database\0default\0application_name\0strict-acceptance\0\0".bytes()
    val length = startup.len() + 8
    [length / 16777216, (length / 65536) % 256,
        (length / 256) % 256, length % 256,
        0, 3, 0, 0] + startup

describe "Postgres mimic accepted StartupMessage aggregate boundary":
    it "keeps the decoded aggregate in wire and exposes owned projections":
        var decoder = pgwire_decoder()
        val status = decoder.decode_startup(accepted_startup_packet(), 1024, 64)

        expect(status).to_equal(PgWireDecodeStatus.Decoded)
        expect(decoder.message_kind()).to_equal(PgWireMessageKind.Startup)
        expect(decoder.user()).to_equal("local")
        expect(decoder.database()).to_equal("default")
        expect(decoder.application_name()).to_equal("strict-acceptance")
        expect(decoder.consumed()).to_equal(accepted_startup_packet().len())

    it "preserves every decoded text field through wire connection and transport":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 1024, 64, 2048)
        driver.feed(accepted_startup_packet())
        val events = driver.drain_events()

        expect(events.len()).to_equal(1)
        expect(events[0].kind).to_equal(PgWireTransportEventKind.Authenticate)
        expect(events[0].user).to_equal("local")
        expect(events[0].database).to_equal("default")
        expect(events[0].application_name).to_equal("strict-acceptance")
        expect(driver.buffered_bytes()).to_equal(0)

    it "crosses production boundaries as scalars through exact AuthReady bytes":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 1024, 64, 2048)
        driver.feed(accepted_startup_packet())

        expect(driver.next_event_kind()).to_equal(PgWireTransportEventKind.Authenticate)
        expect(driver.event_user()).to_equal("local")
        expect(driver.event_database()).to_equal("default")
        expect(driver.event_application_name()).to_equal("strict-acceptance")
        val startup_user = driver.event_user()
        val startup_database = driver.event_database()
        val startup_application = driver.event_application_name()
        expect(driver.next_event_kind()).to_equal(PgWireTransportEventKind.None)

        var database = PostgresMimicServer.memory().unwrap()
        val session_id = database.startup(startup_user, startup_database,
            startup_application).unwrap()
        val auth_ready = pgwire_encode_startup(database.startup_responses(session_id), 1024).unwrap()
        expect(auth_ready).to_equal([
            82, 0, 0, 0, 8, 0, 0, 0, 0,
            83, 0, 0, 0, 31,
            115, 101, 114, 118, 101, 114, 95, 118, 101, 114, 115, 105, 111, 110, 0,
            49, 54, 46, 48, 45, 115, 105, 109, 112, 108, 101, 0,
            90, 0, 0, 0, 5, 73
        ])

        driver.authentication_succeeded()
        expect(driver.next_event_kind()).to_equal(PgWireTransportEventKind.NeedInput)
        expect(driver.event_required()).to_equal(5)
        expect(driver.next_event_kind()).to_equal(PgWireTransportEventKind.None)
