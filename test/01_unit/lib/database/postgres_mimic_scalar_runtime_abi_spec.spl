# @tag: unit, contract, database, abi

use std.spec
use std.io_runtime.{file_read}

describe "postgres mimic flattened scalar runtime ABI":
    it "declares only scalar operations and owner-held result cursors":
        val source = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_runtime_abi.spl")
        val declarations = [
            "extern fn rt_pg_db_control_create(owner_handle: i64,",
            "extern fn rt_pg_db_control_operation(owner_handle: i64,",
            "extern fn rt_pg_db_control_release(owner_handle: i64,",
            "extern fn rt_pg_db_result_get(owner_handle: i64,",
            "extern fn rt_pg_db_result_ok(owner_handle: i64,",
            "extern fn rt_pg_db_result_status(owner_handle: i64,",
            "extern fn rt_pg_db_result_value(owner_handle: i64,",
            "extern fn rt_pg_db_result_started_count(owner_handle: i64,",
            "extern fn rt_pg_db_result_completed_count(owner_handle: i64,",
            "extern fn rt_pg_db_result_active_count(owner_handle: i64,",
            "extern fn rt_pg_db_result_draining(owner_handle: i64,",
            "extern fn rt_pg_db_result_release(owner_handle: i64,"
        ]
        for declaration in declarations:
            expect(source).to_contain(declaration)
        expect(source).to_contain("result_cursor: i64")
        expect(source).to_contain(") -> i64")
        expect(source).to_contain("PG_DB_ABI_FALSE: i64 = 0")
        expect(source).to_contain("PG_DB_ABI_TRUE: i64 = 1")
        expect(source.contains("-> bool")).to_equal(false)
        expect(source.contains("-> text")).to_equal(false)
        expect(source.contains("-> Any")).to_equal(false)
        expect(source.contains(": bool")).to_equal(false)
        expect(source.contains(": text")).to_equal(false)
        expect(source.contains("PgDb")).to_equal(false)
        expect(source.contains("PgWire")).to_equal(false)
        expect(source.contains("class ")).to_equal(false)
        expect(source.contains("struct ")).to_equal(false)
        expect(source.contains("enum ")).to_equal(false)
