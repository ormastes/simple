"""Focused proof for the scalar-only pgwire config owner."""

use std.spec
use std.database.postgres_mimic.connection.{PgWireSslPolicy}
use std.database.postgres_mimic.scalar_config.{
    PgWireServerConfigOwner, pgwire_server_config_intern,
    pgwire_server_config_tls_policy, pgwire_server_config_user_id,
    pgwire_server_config_database_id, pgwire_server_config_user_matches,
    pgwire_server_config_database_matches, pgwire_server_config_valid,
    pgwire_server_config_release
}

describe "Postgres mimic scalar server config owner":
    it "publishes TLS and interned identity values through i64 getters":
        var owner = PgWireServerConfigOwner.create(101, 2)
        val handle = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Required, "simple", "app")
        expect(handle).to_be_greater_than(0)
        expect(pgwire_server_config_tls_policy(owner, handle)).to_equal(3)
        expect(pgwire_server_config_user_id(owner, handle)).to_be_greater_than(0)
        expect(pgwire_server_config_database_id(owner, handle)).to_be_greater_than(0)
        expect(pgwire_server_config_user_matches(owner, handle, "simple")).to_equal(true)
        expect(pgwire_server_config_database_matches(owner, handle, "app")).to_equal(true)

    it "rejects a wrong-owner handle without exposing any config field":
        var owner = PgWireServerConfigOwner.create(201, 1)
        var foreign_owner = PgWireServerConfigOwner.create(202, 1)
        val handle = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Disabled, "simple", "app")
        expect(pgwire_server_config_valid(foreign_owner, handle)).to_equal(false)
        expect(pgwire_server_config_tls_policy(foreign_owner, handle)).to_equal(0)
        expect(pgwire_server_config_user_id(foreign_owner, handle)).to_equal(0)
        expect(pgwire_server_config_database_id(foreign_owner, handle)).to_equal(0)

    it "rejects stale handles after parent release and slot reuse":
        var owner = PgWireServerConfigOwner.create(301, 1)
        val old_handle = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Optional, "old", "old_db")
        expect(pgwire_server_config_release(owner, old_handle)).to_equal(true)
        expect(pgwire_server_config_valid(owner, old_handle)).to_equal(false)
        val new_handle = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Disabled, "new", "new_db")
        expect(new_handle).to_be_greater_than(0)
        expect(new_handle).to_equal(old_handle + 2048)
        expect(pgwire_server_config_tls_policy(owner, old_handle)).to_equal(0)
        expect(pgwire_server_config_user_matches(owner, old_handle, "old")).to_equal(false)

    it "enforces the configured slot bound":
        var owner = PgWireServerConfigOwner.create(401, 1)
        val first = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Disabled, "one", "one")
        val second = pgwire_server_config_intern(owner,
            PgWireSslPolicy.Disabled, "two", "two")
        expect(first).to_be_greater_than(0)
        expect(second).to_equal(0)
