# Purpose and audience: executable specification evidence that documents how
# SdnTable.parse treats an over-wide row, so a future change is deliberate.
# @req REQ-SSPEC-LIB
#
# Extra fields are NOT an error: they are kept as an opaque tail, so a row with
# 10 fields under a 4-column table loads silently as a 4-column row. That is
# how 18 bugs-shaped rows hid under `bug_scope` in bug_db.sdn
# (guard: scripts/check/check-bug-db-table-shape.shs).

use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.database.core.{SdnTable, sdn_opaque_tail_key}

describe "SdnTable.parse over-wide rows":
    it "folds extra fields into an opaque tail instead of rejecting the row":
        # @req REQ-SSPEC-LIB
        step("parse a 4-column table whose row carries 10 fields")
        val src = "bug_scope |bug_id, scope, root_layer, note|\n    b1, P1, open, \"t\", f, 1, r, c, u, true\n"
        val table = SdnTable.parse(src).unwrap()
        expect(table.rows.len()).to_equal(1)
        val row = table.rows[0]
        expect(row.get("bug_id") ?? "").to_equal("b1")
        expect(row.get("scope") ?? "").to_equal("P1")
        expect(row.get("root_layer") ?? "").to_equal("open")
        expect((row.get(sdn_opaque_tail_key()) ?? "").len() > 0).to_equal(true)
