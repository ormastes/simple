use std.spec.{describe, it, expect}
use std.database.sql.types.{DbValue}
use std.database.pure_sql.debug_query_v1.{
    sanitize_pure_sql_template_v1, pure_sql_bind_shape_v1,
}

describe "pure-Simple SQL query debug privacy":
    it "sanitizes literals and records only bind types":
        val template = sanitize_pure_sql_template_v1(
            "SELECT * FROM users WHERE name = 'secret-user' AND age = 42")
        expect(template.contains("secret-user")).to_equal(false)
        expect(template.contains("42")).to_equal(false)
        expect(template).to_contain("name = ?")
        expect(pure_sql_bind_shape_v1([
            DbValue.Text("not-retained"), DbValue.Integer(42), DbValue.Null,
        ])).to_equal("text,integer,null")
