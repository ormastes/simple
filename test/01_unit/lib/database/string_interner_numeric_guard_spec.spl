extern fn rt_file_read_text(path: text) -> text

describe "database string interner numeric guard":
    it "skips malformed SDN string ids":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/database/core.spl") ?? ""

        expect(source).to_contain("val parsed = try_parse_int(id_str)")
        expect(source).to_contain("if parsed == nil:")
        expect(source.contains("id_str.to_int()")).to_equal(false)
