# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "database row numeric guard":
    # @manual scenario evidence
    it "returns nil for malformed row integer fields":
        # @req REQ-SSPEC-LIB
        step("returns nil for malformed row integer fields")
        val source = rt_file_read_text("src/lib/nogc_sync_mut/database/core.spl") ?? ""

        expect(source).to_contain("val parsed = value.to_int()")
        expect(source).to_contain("if parsed == nil:")
        expect(source).to_contain("return nil")
        expect(source.contains("Some(value.to_int())")).to_equal(false)
