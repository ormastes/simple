# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step
use std.nogc_sync_mut.database.core.{SdnRow}

# Regression guard for row integer field parsing.
#
# History: get_i32/get_i64 used `value.to_int()` + `if parsed == nil` -- a dead
# guard, because `.to_int()` is typed `i64?` but its runtime returns a plain
# int64_t and can never produce nil, so "abc" was admitted as 0. The behavioral
# oracle below calls the row accessors directly and pins the fail-closed
# contract: a malformed integer field yields nil, never a coerced 0.
describe "database row numeric guard":
    it "returns nil for malformed row integer fields":
        # @req REQ-SSPEC-LIB
        step("read integer fields from a row carrying malformed values")
        # evidence(protocol_json): the nil-vs-value results asserted below are the complete typed oracle
        val row = SdnRow(fields: {"count": "abc", "id": "7"}, _version: 0)
        expect(row.get_i64("count")).to_be_nil()
        expect(row.get_i32("count")).to_be_nil()

    it "parses well-formed integer fields without coercion":
        # @req REQ-SSPEC-LIB
        step("read integer fields from a row carrying valid values")
        # evidence(protocol_json): the parsed values asserted below are the complete typed oracle
        val row = SdnRow(fields: {"count": "42", "id": "7"}, _version: 0)
        expect(row.get_i64("count")).to_equal(42)
        expect(row.get_i32("id")).to_equal(7)

    it "returns nil for a missing integer column rather than fabricating zero":
        # @req REQ-SSPEC-LIB
        step("read an integer field the row does not carry")
        # evidence(protocol_json): the nil result asserted below is the complete typed oracle
        val row = SdnRow(fields: {}, _version: 0)
        expect(row.get_i64("missing")).to_be_nil()
        expect(row.get_i32("missing")).to_be_nil()
