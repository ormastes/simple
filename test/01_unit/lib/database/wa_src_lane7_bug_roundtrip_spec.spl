# @cover src/lib/nogc_sync_mut/database/bug.spl
# @cover src/lib/nogc_sync_mut/database/core.spl
# Regression for bug_database_roundtrip_drops_overwide_legacy_rows_2026_10_27:
# Full BugDatabase load -> update/resolve/add -> save round-trips must preserve
# overwide opaque legacy row payloads and extra declared columns in single-file
# and shard modes, and handle CRLF multi-table payloads.
use std.spec.*
use std.env.{env_get}
use std.io.file_ops.{secure_temp_dir}
use std.io.dir_ops.{dir_remove_all}
use std.io_runtime.{dir_create_all, file_write, read_file_text_result}
use std.nogc_sync_mut.database.core.{SdnDatabase, SdnTable, SdnRow, sdn_opaque_tail_key}
use std.nogc_sync_mut.database.csm_seal.{csm_write_sealed}
use std.nogc_sync_mut.database.bug.{
    Bug, BugSeverity, BugStatus, BugDatabase,
    create_bug_database, load_bug_database, bug_shard_dir
}

fn lane7_db_workspace() -> text:
    var parent = env_get("TMPDIR")
    if parent == "": parent = env_get("TEMP")
    if parent == "": parent = env_get("TMP")
    if parent == "": parent = "/tmp"
    secure_temp_dir(parent, "wa-lane7-bug-roundtrip").unwrap()

fn lane7_bug_record(id: text, status: BugStatus, title: text) -> Bug:
    Bug(
        id: id,
        severity: BugSeverity.P2,
        status: status,
        title: title,
        description: ["roundtrip description"],
        file: "src/lib/nogc_sync_mut/database/bug.spl",
        line: 1,
        reproducible_by: "test/01_unit/lib/database/wa_src_lane7_bug_roundtrip_spec.spl",
        fix_strategy: ["preserve opaque legacy payloads"],
        investigation_log: ["roundtrip verification"],
        created_at: "2026-10-27",
        updated_at: "2026-11-26",
        valid: true
    )

fn legacy_overwide_crlf_payload() -> text:
    val cols = "id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid"
    val parts: [text] = [
        "strings |id, value|",
        "",
        "bugs_active |{cols}|",
        "    legacy_active, P2, open, Legacy active title, sentinel.spl, 0, N/A, 2026-10-01, 2026-10-01, true, EXTRA_ACTIVE_1, \"q,uoted\"",
        "    legacy_empty_tail, P3, open, Empty tail title, sentinel.spl, 0, N/A, 2026-10-01, 2026-10-01, true, ",
        "",
        "bugs |{cols}|",
        "    legacy_closed, P1, closed, Legacy closed title, old.spl, 7, N/A, 2026-10-01, 2026-10-02, true, EXTRA_CLOSED_1",
        "",
        "bug_descriptions |bug_id, line_num, content|",
        "    legacy_active, 0, Keep this description",
        "",
        "bug_investigation_logs |bug_id, line_num, content|",
        "",
        "bug_fix_strategies |bug_id, line_num, content|",
        "",
        "bug_scope |bug_id, scope, layer, note|",
        "    legacy_active, lib, std, keep_scope, EXTRA_SCOPE_TAIL",
        ""
    ]
    parts.join("\r\n")

describe "BugDatabase overwide legacy row roundtrip":
    it "loads CRLF multi-table registries and preserves overwide rows on full save":
        val root = lane7_db_workspace()
        val path = root + "/bug_db.sdn"
        val wrote = csm_write_sealed(path, legacy_overwide_crlf_payload())
        var db = load_bug_database(path).unwrap()
        expect(db.add_bug(lane7_bug_record("added_open", BugStatus.Open, "Newly added"))).to_equal(true)
        val saved = db.save()
        val reloaded = load_bug_database(path).unwrap()
        val active_row = reloaded.db.get_table("bugs_active").unwrap().get_row("legacy_active").unwrap()
        val empty_tail_row = reloaded.db.get_table("bugs_active").unwrap().get_row("legacy_empty_tail").unwrap()
        val scope_row = reloaded.db.get_table("bug_scope").unwrap().get_row("legacy_active").unwrap()
        val out = read_file_text_result(path).unwrap()
        val cleaned = dir_remove_all(root)
        expect(wrote and saved and cleaned).to_equal(true)
        expect(reloaded.get_bug("added_open") != nil).to_equal(true)
        expect(active_row.get(sdn_opaque_tail_key())).to_equal(Some("EXTRA_ACTIVE_1, \"q,uoted\""))
        expect(empty_tail_row.has_column(sdn_opaque_tail_key())).to_equal(true)
        expect(scope_row.get(sdn_opaque_tail_key())).to_equal(Some("EXTRA_SCOPE_TAIL"))
        expect(out).to_contain("EXTRA_ACTIVE_1, \"q,uoted\"\n")
        expect(out).to_contain("EXTRA_SCOPE_TAIL\n")

    it "keeps opaque tails and extra declared columns across same-table update_bug":
        val root = lane7_db_workspace()
        val path = root + "/bug_db.sdn"
        val schema_with_owner = [
            "strings |id, value|",
            "",
            "bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid, legacy_owner|",
            "    legacy_extra_col, P2, open, Initial title, sentinel.spl, 0, N/A, 2026-10-01, 2026-10-01, true, team_alpha, OVERWIDE_TAIL",
            "",
            "bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid, legacy_owner|",
            "",
            "bug_descriptions |bug_id, line_num, content|",
            "",
            "bug_investigation_logs |bug_id, line_num, content|",
            "",
            "bug_fix_strategies |bug_id, line_num, content|",
            ""
        ].join("\n")
        val wrote = csm_write_sealed(path, schema_with_owner)
        var db = load_bug_database(path).unwrap()
        val updated_bug = lane7_bug_record("legacy_extra_col", BugStatus.Investigating, "Updated title")
        val updated = db.update_bug("legacy_extra_col", updated_bug)
        val saved = db.save()
        val reloaded = load_bug_database(path).unwrap()
        val row = reloaded.db.get_table("bugs_active").unwrap().get_row("legacy_extra_col").unwrap()
        val cleaned = dir_remove_all(root)
        expect(wrote and updated and saved and cleaned).to_equal(true)
        expect(row.get("title")).to_equal(Some("Updated title"))
        expect(row.get("legacy_owner")).to_equal(Some("team_alpha"))
        expect(row.get(sdn_opaque_tail_key())).to_equal(Some("OVERWIDE_TAIL"))

    it "preserves opaque tails across resolve_bug table moves in single-file and shard modes":
        val root = lane7_db_workspace()
        val path = root + "/bug_db.sdn"
        val wrote = csm_write_sealed(path, legacy_overwide_crlf_payload())
        expect(dir_create_all(bug_shard_dir(path))).to_equal(true)
        var db = load_bug_database(path).unwrap()
        val resolved = db.resolve_bug("legacy_active", "2026-11-26")
        val saved = db.save()
        val reloaded = load_bug_database(path).unwrap()
        val moved_row = reloaded.db.get_table("bugs").unwrap().get_row("legacy_active").unwrap()
        val cleaned = dir_remove_all(root)
        expect(wrote and resolved and saved and cleaned).to_equal(true)
        expect(moved_row.get("status")).to_equal(Some("closed"))
        expect(moved_row.get(sdn_opaque_tail_key())).to_equal(Some("EXTRA_ACTIVE_1, \"q,uoted\""))

    it "does not copy positional opaque tail across mismatched table column schemas":
        val root = lane7_db_workspace()
        val path = root + "/bug_db.sdn"
        val mixed_schema = [
            "strings |id, value|",
            "",
            "bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|",
            "    schema_mismatch, P2, open, Active title, sentinel.spl, 0, N/A, 2026-10-01, 2026-10-01, true, POSITIONAL_ACTIVE_ONLY",
            "",
            "bugs |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid, legacy_extra|",
            "",
            "bug_descriptions |bug_id, line_num, content|",
            "",
            "bug_investigation_logs |bug_id, line_num, content|",
            "",
            "bug_fix_strategies |bug_id, line_num, content|",
            ""
        ].join("\n")
        val wrote = csm_write_sealed(path, mixed_schema)
        var db = load_bug_database(path).unwrap()
        val resolved = db.resolve_bug("schema_mismatch", "2026-11-26")
        val saved = db.save()
        val reloaded = load_bug_database(path).unwrap()
        val moved_row = reloaded.db.get_table("bugs").unwrap().get_row("schema_mismatch").unwrap()
        val cleaned = dir_remove_all(root)
        expect(wrote and resolved and saved and cleaned).to_equal(true)
        expect(moved_row.get("status")).to_equal(Some("closed"))
        expect(moved_row.has_column(sdn_opaque_tail_key())).to_equal(false)

    it "keeps append_open_bugs_preserving_legacy working for byte-preserving appends":
        val root = lane7_db_workspace()
        val path = root + "/bug_db.sdn"
        val payload = legacy_overwide_crlf_payload()
        val wrote = csm_write_sealed(path, payload)
        var db = create_bug_database(path)
        val appended = db.append_open_bugs_preserving_legacy([lane7_bug_record("appended_open", BugStatus.Open, "Appended open")])
        val content = read_file_text_result(path).unwrap()
        val reloaded = load_bug_database(path).unwrap()
        val cleaned = dir_remove_all(root)
        expect(wrote and appended and cleaned).to_equal(true)
        expect(content).to_contain("EXTRA_ACTIVE_1, \"q,uoted\"\r\n")
        expect(reloaded.get_bug("appended_open") != nil).to_equal(true)
