# Feature Database Utilities Tests
#
# Parser-safe local coverage for metadata helpers.

use nogc_sync_mut.database.feature_utils.{parse_spipe_metadata, parse_attr_list,
    extract_quoted_string, extract_category_from_path, compare_feature_id}

## Operator workflow

1. Run `bin/simple test test/01_unit/lib/database/database_feature_utils_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

describe "Database Feature Utils":
    it "parses attribute lists":
        val modes = parse_attr_list("modes(\"pure\", \"hybrid\")", "modes")
        check(modes.len() == 2)
        check(modes[0] == "pure")
        check(modes[1] == "hybrid")

    it "extracts quoted names":
        check(extract_quoted_string("describe \"My Feature\":") == "My Feature")

    it "extracts categories from feature paths":
        check(extract_category_from_path("test/system/features/control_flow/loops_spec.spl") == "control_flow")
        check(extract_category_from_path("spec.spl") == "uncategorized")

    it "compares feature ids semantically":
        check(compare_feature_id("1.2", "1.10") < 0)
        check(compare_feature_id("1.10.1", "1.2.20") > 0)
        check(compare_feature_id("alpha", "beta") < 0)

    it "parses spipe metadata from a temp file":
        val path = write_spec("metadata", """
#[id("feature_001")]
#[modes("pure", "hybrid")]
#[skip_modes("jit")]
#[platforms("linux", "macos")]
#[ignore]
describe "My Feature":
    pass

    it "Option payload binding":
        step("Verify: Option payload binding")
        # @req: REQ-LIB-DATABASE-001
        val opt = Some(99)
        var chosen = 0
        match opt:
            Some(x): chosen = x
            nil: chosen = -1
        expect(chosen).to_equal(99)  # oracle: Some arm binds payload

    it "returns empty metadata for missing file":
        check(parse_spipe_metadata("/nonexistent/database_feature_utils_spec.spl").len() == 0)
