# @tag: unit, contract, database, parallel, scalar
"""Contract gate for the isolated scalar pgwire dispatch vertical slice.

This test is intentionally source-level: the runtime-backed port is not wired
into the Linux server yet. It proves that the admitted names and boundary
shapes are present, while keeping the live-wiring prerequisite visible.
"""

use std.spec
use std.io_runtime.{file_read}

describe "Postgres mimic isolated scalar dispatch adapter":
    it "keeps the database dispatch gate on the parent owner":
        val owner = file_read(
            "src/lib/nogc_sync_mut/database/postgres_mimic/database_owner.spl")
        val adapter = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl")
        expect(owner).to_contain("class PgDatabaseOwner:")
        expect(owner).to_contain("dispatch: PgDispatchGate")
        expect(adapter.contains("PgDispatchGate")).to_equal(false)

    it "uses only scalar handles for admitted request and completion calls":
        val adapter = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl")
        expect(adapter).to_contain("port_token: i64")
        expect(adapter).to_contain("fn publish_startup_scalars(")
        expect(adapter).to_contain("fn publish_query_scalars(session: i64,")
        expect(adapter).to_contain("fn poll_receipt(request: i64) -> i64")
        expect(adapter).to_contain("fn result_blob(receipt: i64) -> i64")
        expect(adapter).to_contain("fn claim_next() -> i64")
        expect(adapter).to_contain("fn claim_text_byte_at(claim: i64,")
        expect(adapter).to_contain("fn publish_blob(claim: i64, status: i64,")
        expect(adapter).to_contain("fn publish_encoded_scalars(")
        expect(adapter).to_contain("payload_ptr: i64, payload_len: i64")
        expect(adapter).to_contain(
            "rt_pg_dispatch_complete_by_claim(claim, status, blob)")
        expect(adapter).to_contain("rt_pg_dispatch_abort_claim(claim, safe_status)")

    it "does not expose aggregate values through extern declarations":
        val adapter = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl")
        expect(adapter.contains("extern fn .*PgScalarFrontendResult")).to_equal(false)
        expect(adapter.contains("extern fn .*-> [u8]")).to_equal(false)
        expect(adapter.contains("extern fn .*-> text")).to_equal(false)
        expect(adapter.contains("extern fn .*-> bool")).to_equal(false)

    it "documents the exact live-wiring boundary still outstanding":
        val adapter = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl")
        expect(adapter).to_contain(
            "not part of the admitted worker contract")
        expect(adapter).to_contain(
            "The pointer is never retained or transported")

    it "owns one non-live scalar port lifecycle and creates scalar views":
        val adapter = file_read(
            "src/lib/nogc_async_mut/database/postgres_mimic/scalar_dispatch_adapter.spl")
        expect(adapter).to_contain("class PgScalarDispatchPortV1:")
        expect(adapter).to_contain(
            "extern fn rt_pg_dispatch_port_new() -> i64")
        expect(adapter).to_contain(
            "extern fn rt_pg_dispatch_port_release(port: i64) -> i64")
        expect(adapter).to_contain(
            "extern fn rt_pg_dispatch_port_pending_count(port: i64) -> i64")
        expect(adapter).to_contain(
            "static fn create() -> PgScalarDispatchPortV1?:")
        expect(adapter).to_contain("val token = rt_pg_dispatch_port_new()")
        expect(adapter).to_contain(
            "fn frontend(connection_id: i64) -> PgScalarFrontendAdapter?:")
        expect(adapter).to_contain("fn owner() -> PgScalarDispatchOwner?:")
        expect(adapter).to_contain(
            "rt_pg_dispatch_port_release(self.port_token)")
        expect(adapter).to_contain("if self.released: return false")
        expect(adapter.contains("PgDispatchGate")).to_equal(false)
        expect(adapter.contains("PgWireServerConfig")).to_equal(false)
        expect(adapter.contains("extern fn .*Any")).to_equal(false)

    it "requires shutdown to invalidate claims and result blobs before port reuse":
        val runtime = file_read("src/runtime/runtime_db.c")
        val selfcheck = file_read(
            "src/runtime/test/rt_pg_dispatch_port_shutdown_selfcheck.c")
        expect(runtime).to_contain("pg_dp_release_dependents_locked")
        expect(runtime).to_contain("rt_pg_dispatch_port_pending_count")
        expect(selfcheck).to_contain("rt_pg_dispatch_claim_get(claim, 0) == INT64_MIN")
        expect(selfcheck).to_contain("rt_pg_completion_blob_get(blob, 0) == INT64_MIN")
