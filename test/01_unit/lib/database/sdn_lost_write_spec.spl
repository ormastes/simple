# Reproduce spec for the fail-open half of:
#   doc/08_tracking/bug/test_db_update_row_keys_nonexistent_id_column_2026-08-21.md
#
# A write that cannot succeed must surface as an error, never as a quiet no-op.

use std.database.core.{SdnTable, SdnRow}

describe "SDN lost write":
    it "reports an update that matched no row":
        val table = SdnTable(name: "test_runs", columns: ["run_id", "status"], rows: [], index: {})
        val ghost = SdnRow.empty()
        val outcome = table.update_row_checked("run_missing", ghost)
        val ok = match outcome:
            case Ok(_): true
            case Err(_): false
        assert_true(ok == false)
        val applied = table.update_row("run_missing", ghost)
        assert_true(applied == false)
