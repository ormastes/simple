"""The socket-neutral pgwire transport bounds and incrementally drains input."""

use std.spec
use std.database.postgres_mimic.{
    PgWireSslPolicy, PgWireTransportEventKind, PgWireTransportError,
    pgwire_transport_driver
}

fn transport_be32(value: i64) -> [i64]:
    [value / 16777216, (value / 65536) % 256, (value / 256) % 256, value % 256]

fn transport_startup(user: text) -> [i64]:
    val payload = [0, 3, 0, 0] + "user".bytes() + [0] + user.bytes() + [0, 0]
    transport_be32(payload.len() + 4) + payload

fn transport_query(sql: text) -> [i64]:
    val payload = sql.bytes() + [0]
    [81] + transport_be32(payload.len() + 4) + payload

describe "Postgres mimic socket-neutral transport":
    it "retains every octet when startup arrives one byte at a time":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 128, 8, 256)
        val frame = transport_startup("simple")
        var i = 0
        while i < frame.len():
            driver.feed([frame[i]])
            i = i + 1
        val events = driver.drain_events()
        var user = ""
        for event in events:
            if event.kind == PgWireTransportEventKind.Authenticate:
                user = event.user
        expect(user).to_equal("simple")
        expect(driver.buffered_bytes()).to_equal(0)

    it "retains partial startup and emits authentication only after completion":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 128, 8, 256)
        val frame = transport_startup("simple")
        driver.feed(frame.slice(0, 3))
        val partial = driver.drain_events()
        expect(partial.len()).to_equal(1)
        expect(partial[0].kind).to_equal(PgWireTransportEventKind.NeedInput)
        expect(driver.buffered_bytes()).to_equal(3)
        driver.feed(frame.slice(3, frame.len()))
        val complete = driver.drain_events()
        expect(complete.len()).to_equal(1)
        expect(complete[0].kind).to_equal(PgWireTransportEventKind.Authenticate)
        expect(complete[0].user).to_equal("simple")
        expect(driver.buffered_bytes()).to_equal(0)

    it "drains concatenated queries after authentication and preserves order":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 256, 8, 512)
        driver.feed(transport_startup("simple"))
        driver.drain_events()
        driver.authentication_succeeded()
        driver.drain_events()
        driver.feed(transport_query("SELECT 1") + transport_query("SELECT 2"))
        val events = driver.drain_events()
        expect(events.len()).to_equal(3)
        expect(events[0].kind).to_equal(PgWireTransportEventKind.ExecuteQuery)
        expect(events[0].query).to_equal("SELECT 1")
        expect(events[1].kind).to_equal(PgWireTransportEventKind.ExecuteQuery)
        expect(events[1].query).to_equal("SELECT 2")
        expect(events[2].kind).to_equal(PgWireTransportEventKind.NeedInput)

    it "holds pipelined startup bytes across TLS and authentication boundaries":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Required, 256, 8, 512)
        val ssl = [0, 0, 0, 8, 4, 210, 22, 47]
        driver.feed(ssl + transport_startup("secure"))
        val tls_event = driver.drain_events()
        expect(tls_event.len()).to_equal(1)
        expect(tls_event[0].kind).to_equal(PgWireTransportEventKind.SendSslSupported)
        expect(driver.buffered_bytes()).to_be_greater_than(0)
        driver.tls_established()
        val auth_event = driver.drain_events()
        expect(auth_event[auth_event.len() - 1].kind).to_equal(PgWireTransportEventKind.Authenticate)
        expect(auth_event[auth_event.len() - 1].user).to_equal("secure")

    it "fails closed on overflow and emits one drainable close event":
        var driver = pgwire_transport_driver(PgWireSslPolicy.Disabled, 8, 8, 8)
        driver.feed([0, 0, 0, 8, 0, 3, 0, 0, 1])
        val events = driver.drain_events()
        expect(events.len()).to_equal(1)
        expect(events[0].kind).to_equal(PgWireTransportEventKind.Close)
        expect(events[0].transport_error).to_equal(PgWireTransportError.BufferOverflow)
        expect(driver.closed).to_equal(true)
        expect(driver.buffered_bytes()).to_equal(0)
        expect(driver.drain_events().len()).to_equal(0)

    it "queues remote cancellation and local cancellation without socket effects":
        var remote = pgwire_transport_driver(PgWireSslPolicy.Disabled, 64, 8, 128)
        remote.feed([0, 0, 0, 16, 4, 210, 22, 46, 0, 0, 0, 7, 0, 0, 0, 9])
        val cancel = remote.drain_events()
        expect(cancel.len()).to_equal(1)
        expect(cancel[0].kind).to_equal(PgWireTransportEventKind.CancelRequest)
        expect(cancel[0].process_id).to_equal(7)
        expect(cancel[0].secret_key).to_equal(9)
        var local = pgwire_transport_driver(PgWireSslPolicy.Disabled, 64, 8, 128)
        local.cancel("shutdown")
        val close = local.drain_events()
        expect(close[0].transport_error).to_equal(PgWireTransportError.LocallyCancelled)
        expect(close[0].detail).to_equal("shutdown")
