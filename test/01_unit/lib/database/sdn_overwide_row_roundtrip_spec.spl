# @cover src/lib/nogc_sync_mut/database/core.spl
# Regression: bug_database_roundtrip_drops_overwide_legacy_rows_2026_10_27
use std.spec.*
use std.nogc_sync_mut.database.core.{SdnTable}

describe "SdnTable overwide legacy rows":
    it "parses a row with more fields than columns instead of failing the table":
        val src = "t |id, v|\n    a, 1\n    b, 2, EXTRA_one, EXTRA_two\n"
        val table = SdnTable.parse(src)
        expect(table != nil).to_equal(true)
        expect(table!.rows.len()).to_equal(2)
        expect(table!.rows[1].get("id")).to_equal(Some("b"))
        expect(table!.rows[1].get("v")).to_equal(Some("2"))

    it "round-trips the opaque tail byte for byte":
        val src = "t |id, v|\n    a, 1\n    b, 2, EXTRA_one, \"q,uoted\"\n"
        val table = SdnTable.parse(src)!
        val out = table.to_sdn()
        expect(out).to_contain("    b, 2, EXTRA_one, \"q,uoted\"\n")
        expect(out).to_contain("    a, 1\n")

    it "still rejects underwide rows":
        val table = SdnTable.parse("t |id, v|\n    a\n")
        expect(table == nil).to_equal(true)
