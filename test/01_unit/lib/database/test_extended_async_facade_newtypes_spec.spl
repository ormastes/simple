# @req REQ-TEST-DB-REPORT-001
# The nogc_async_mut test_extended facades are what `std.database.test_extended.*`
# resolves to first (async tier precedes sync). They must route every public
# newtype of nogc_sync_mut .../types.spl, or HIR reports
# [hir-reexport-chase-unresolved] for TestRowId behind TestDatabaseExtended.
use nogc_async_mut.database.test_extended.types.{TestRowId, TestRunCount, TestRunAgeHours, TestRunKeepCount, TestStageMs, TestDurationMs, TestByteCount, TestProcessCount, TestSignalNumber, TestExitCode, TestAnomalyWarning, TestTimingOutcome}
use nogc_async_mut.database.test_extended.source_revision.{TestSourceRevision, test_source_revision_of}
use nogc_async_mut.database.test_extended.{TestRowId as PkgTestRowId, TestDurationMs as PkgTestDurationMs, current_test_source_revision}

describe "async test_extended facade newtypes":
    it "routes the scalar newtypes through types.spl":
        expect(TestRowId(value: 7).value).to_equal(7)
        expect(TestRunCount(value: 3).value).to_equal(3)
        expect(TestRunAgeHours(value: 24).value).to_equal(24)
        expect(TestRunKeepCount(value: 5).value).to_equal(5)
        expect(TestStageMs(value: 11).value).to_equal(11)
        expect(TestByteCount(value: 12).value).to_equal(12)
        expect(TestProcessCount(value: 2).value).to_equal(2)
        expect(TestSignalNumber(value: 9).value).to_equal(9)
        expect(TestExitCode(value: 1).value).to_equal(1)

    it "routes the enums through types.spl":
        expect(TestAnomalyWarning.Quiet == TestAnomalyWarning.Quiet).to_equal(true)
        expect(TestTimingOutcome.Applied == TestTimingOutcome.Applied).to_equal(true)
        expect(TestDurationMs(value: 1.5).value).to_equal(1.5)

    it "routes the newtypes through the package __init__":
        expect(PkgTestRowId(value: 4).value).to_equal(4)
        expect(PkgTestDurationMs(value: 2.5).value).to_equal(2.5)

    it "routes TestSourceRevision through source_revision and package __init__":
        val sha = "0123456789abcdef0123456789abcdef01234567"
        val rev: TestSourceRevision? = test_source_revision_of(Some(sha), Some(""))
        val direct = TestSourceRevision(value: sha)
        val _cur: TestSourceRevision? = current_test_source_revision()
        expect(rev.?).to_equal(true)
        expect(rev.unwrap().value).to_equal(sha)
        expect(direct.value).to_equal(sha)
