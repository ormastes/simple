"""
## Purpose and audience
Purpose: Prove that Postgres mimic server.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-DATABASE-001 — stable requirement identity for this spec.

"""PostgreSQL-like sessions execute through the pure-Simple database engine."""

use std.spec
use std.database.postgres_mimic.{PostgresMimicServer, PgResponseKind}

describe "Postgres mimic server":
    it "should start a session and advertise compatibility":
        step("Verify: should start a session and advertise compatibility")
        # @req: REQ-LIB-DATABASE-001
        var server = PostgresMimicServer.memory().unwrap()
        val session = server.startup("simple", "app", "sspec").unwrap()
        val responses = server.startup_responses(session)
        expect(responses.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(responses[0].kind == PgResponseKind.AuthenticationOk).to_equal(true)
        expect(responses[1].message).to_equal("16.0-simple")

    it "should execute commands and return rows":
        step("Verify: should execute commands and return rows")
        var server = PostgresMimicServer.memory().unwrap()
        val session = server.startup("simple", "app", "sspec").unwrap()
        expect(server.simple_query(session, "CREATE TABLE notes (id INTEGER, body TEXT)").kind == PgResponseKind.CommandComplete).to_equal(true)
        expect(server.simple_query(session, "INSERT INTO notes (id, body) VALUES (1, 'hello')").tag).to_start_with("INSERT")
        val selected = server.simple_query(session, "SELECT id, body FROM notes")
        expect(selected.kind == PgResponseKind.RowSet).to_equal(true)
        expect(selected.rows.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(selected.columns).to_contain("body")

    it "should expose PostgreSQL transaction status":
        step("Verify: should expose PostgreSQL transaction status")
        var server = PostgresMimicServer.memory().unwrap()
        val session = server.startup("simple", "app", "sspec").unwrap()
        expect(server.simple_query(session, "BEGIN").transaction_status).to_equal("T")
        expect(server.simple_query(session, "ROLLBACK").transaction_status).to_equal("I")

    it "should reject missing and terminated sessions":
        step("Verify: should reject missing and terminated sessions")
        var server = PostgresMimicServer.memory().unwrap()
        expect(server.simple_query(99, "SELECT 1").sqlstate).to_equal("08003")
        val session = server.startup("simple", "app", "sspec").unwrap()
        expect(server.terminate(session)).to_equal(true)
        expect(server.simple_query(session, "SELECT 1").sqlstate).to_equal("08003")
