# AUTOINCREMENT after INTEGER PRIMARY KEY is accepted by the embedded engine
# (UiAccessStore.memory() schema uses it).
# @req REQ-LIB-PURE-DATABASE-AUTOINCREMENT-001

use std.spec.{describe, it, expect}
use std.database.pure_sql.{PureDatabase}

describe "PureDatabase AUTOINCREMENT":
    it "creates a table whose INTEGER PRIMARY KEY is AUTOINCREMENT":
        val db = PureDatabase.memory().unwrap()
        expect(db.exec_sql("CREATE TABLE ev (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL)").is_ok()).to_equal(true)

    it "rejects AUTOINCREMENT on a non-primary-key column":
        val db = PureDatabase.memory().unwrap()
        expect(db.exec_sql("CREATE TABLE ev (id INTEGER AUTOINCREMENT, name TEXT)").is_err()).to_equal(true)
