use std.testing.sspec.{describe, expect, it}
use std.io.{read_file}

describe("pgwire scalar worker config boundary"):
    it("copies policy and allow-list bytes through scalar accessors only"):
        val source = read_file("src/lib/nogc_async_mut/database/postgres_mimic/scalar_worker_config.spl")
        expect(source).to_contain("rt_pg_wire_server_config_scalar_get")
        expect(source).to_contain("rt_pg_wire_server_config_scalar_byte")
        expect(source).to_contain("rt_bytes_to_text(bytes)")
        expect(source).to_contain("length > PG_SCALAR_CONFIG_MAX_TEXT")

    it("does not expose aggregate or runtime-text configuration externs"):
        val source = read_file("src/lib/nogc_async_mut/database/postgres_mimic/scalar_worker_config.spl")
        expect(source.contains("PgWireServerConfig)")).to_equal(false)
        expect(source.contains("scalar_user")).to_equal(false)
        expect(source.contains("scalar_database")).to_equal(false)
