# Checkpoint74 groupD. Authored real-owner regressions; runtime UNRUN.
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_delete}
use test.fixtures.compiler.database_optional_receiver_prefix_probe.{db_optional_mutation_probe_v1, db_query_prefix_probe_v1}

describe "checkpoint74 actual database receiver and query prefix":
    it "retains optional async-facade table receiver and persists mutations":
        step("Update and soft-delete real backend rows through inferred optional table receivers")
        val directory = secure_temp_dir("/tmp", "simple-db-optional-").unwrap()
        val path = directory + "/records.sdn"
        val result = db_optional_mutation_probe_v1(path)
        val removed = file_delete(path)
        expect(result).to_equal(0)
        expect(removed).to_be(true)

    it "clamps ordered prefix results and keeps returned rows independent":
        step("Check zero, short, equal, long and negative limits after actual filtering and sorting")
        expect(db_query_prefix_probe_v1()).to_equal(0)
