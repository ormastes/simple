# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @req REQ-LIB-DATABASE-001
"""
# Pure-Simple SQL: parameter-free SELECT results stay current after INSERT

Embedded tier (`std.database.pure_sql`, see
doc/07_guide/lib/database/db_implementations_map.md). A parameter-free
SELECT is cached per table keyed by its SQL text; a plain INSERT must
invalidate that slot so a byte-identical literal `WHERE` re-run sees the
new row, exactly like the `?`-bound form (which never consults the cache).
Reproduces doc/08_tracking/bug/llm_caret_pure_sql_where_text_pk_returns_no_rows_2026-08-25.md.
"""

use std.spec.step

use std.spec.*
use std.database.pure_sql.{PureDatabase}
use nogc_sync_mut.database.sql.types.{DbValue}
use std.io_runtime.{file_delete, file_read, file_write}

fn fresh() -> PureDatabase:
    val db = PureDatabase.memory().unwrap()
    expect(db.exec_sql("CREATE TABLE mm (id TEXT PRIMARY KEY, value TEXT, n INTEGER)").is_ok()).to_equal(true)
    db

fn count(db: PureDatabase, sql: text) -> i64:
    db.query(sql, []).unwrap().len()

fn count_bound(db: PureDatabase, sql: text, p: DbValue) -> i64:
    db.query(sql, [p]).unwrap().len()

fn main() -> ():
    describe("pure_sql literal WHERE after INSERT", fn() -> ():
        it("re-runs a byte-identical text-pk literal SELECT after a plain INSERT", fn() -> ():
            # @req REQ-SSPEC-UNIT
            # @req REQ-LIB-DATABASE-001
        # @req REQ-SSPEC-UNIT
        # @req REQ-LIB-DATABASE-001
    # @req REQ-SSPEC-UNIT
    # @req REQ-LIB-DATABASE-001
            val db = fresh()
            val sql = "SELECT value FROM mm WHERE id = 'schema_version'"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('schema_version','1',1)").is_ok()).to_equal(true)
            expect(count(db, sql)).to_equal(1)
            expect(count_bound(db, "SELECT value FROM mm WHERE id = ?", DbValue.Text(value: "schema_version"))).to_equal(1)
        )

        it("answers identically before and after checkpoint on a deferred file store", fn() -> ():
            val path = "/tmp/pure_sql_select_cache_spec.db"
            val db = PureDatabase.open_deferred(path).unwrap()
            expect(db.exec_sql("CREATE TABLE IF NOT EXISTS mm (id TEXT PRIMARY KEY, value TEXT, n INTEGER)").is_ok()).to_equal(true)
            expect(db.exec_sql("DELETE FROM mm").is_ok()).to_equal(true)
            val sql = "SELECT value FROM mm WHERE id = 'schema_version'"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('schema_version','1',1)").is_ok()).to_equal(true)
            expect(db.checkpoint().is_ok()).to_equal(true)
            db.set_auto_checkpoint(true)
            expect(count(db, sql)).to_equal(1)
            expect(count_bound(db, "SELECT value FROM mm WHERE id = ?", DbValue.Text(value: "schema_version"))).to_equal(1)
        )

        it("reopens a checkpointed NOT NULL schema", fn() -> ():
            val path = "/tmp/pure_sql_select_cache_not_null_reopen.db"
            file_delete(path)
            val first = PureDatabase.open_deferred(path).unwrap()
            expect(first.exec_sql("CREATE TABLE mm (id TEXT PRIMARY KEY, value TEXT NOT NULL)").is_ok()).to_equal(true)
            expect(first.exec_sql("INSERT INTO mm (id,value) VALUES ('schema_version','1')").is_ok()).to_equal(true)
            expect(first.checkpoint().is_ok()).to_equal(true)
            val reopened = PureDatabase.open_deferred(path).unwrap()
            expect(reopened.exec_sql("CREATE TABLE IF NOT EXISTS mm (id TEXT PRIMARY KEY, value TEXT NOT NULL)").is_ok()).to_equal(true)
            expect(reopened.exec_sql("INSERT INTO mm (id,value) VALUES ('schema_version_2','2')").is_ok()).to_equal(true)
            expect(reopened.checkpoint().is_ok()).to_equal(true)
            val reopened_again = PureDatabase.open_deferred(path).unwrap()
            expect(count(reopened_again, "SELECT value FROM mm")).to_equal(2)
            file_delete(path)
        )

        it("round-trips disk-v3 delimiter and control text and rejects truncation", fn() -> ():
            val path = "/tmp/pure_sql_select_cache_framed_text.db"
            val truncated_path = "/tmp/pure_sql_select_cache_framed_text_truncated.db"
            file_delete(path)
            file_delete(truncated_path)
            val exact = "left|right\tline1\r\nline2%tail"
            val first = PureDatabase.open_deferred(path).unwrap()
            expect(first.exec_sql("CREATE TABLE framed (id TEXT PRIMARY KEY, value TEXT NOT NULL)").is_ok()).to_equal(true)
            expect(first.exec("INSERT INTO framed (id,value) VALUES (?, ?)", [
                DbValue.Text(value: "key"), DbValue.Text(value: exact)
            ]).is_ok()).to_equal(true)
            expect(first.checkpoint().is_ok()).to_equal(true)
            val reopened = PureDatabase.open_deferred(path).unwrap()
            val value = reopened.query_value("SELECT value FROM framed WHERE id = ?", [DbValue.Text(value: "key")]).unwrap().unwrap()
            match value:
                case Text(actual): expect(actual).to_equal(exact)
                case _: assert_true(false)

            val durable = file_read(path)
            expect(durable.starts_with("simple-pure-db-v3\n")).to_equal(true)
            expect(file_write(truncated_path, durable.slice(0, durable.len() - 1))).to_equal(true)
            expect(PureDatabase.open_deferred(truncated_path).is_err()).to_equal(true)
            file_delete(path)
            file_delete(truncated_path)
        )

        it("reads an unambiguous v1 image and migrates it only on publication", fn() -> ():
            val path = "/tmp/pure_sql_select_cache_v1_compat.db"
            val ambiguous_path = "/tmp/pure_sql_select_cache_v1_ambiguous.db"
            file_delete(path)
            file_delete(ambiguous_path)
            expect(file_write(ambiguous_path,
                "simple-pure-db-v1\ntable|legacy|id,value\nrow|legacy|T:key\tT:left|right"
            )).to_equal(true)
            expect(PureDatabase.open_deferred(ambiguous_path).is_err()).to_equal(true)
            expect(file_write(path,
                "simple-pure-db-v1\ntable|legacy|id,value\nrow|legacy|T:key\tT:old"
            )).to_equal(true)
            val legacy = PureDatabase.open_deferred(path).unwrap()
            val before = legacy.query_value("SELECT value FROM legacy WHERE id = ?", [
                DbValue.Text(value: "key")
            ]).unwrap().unwrap()
            match before:
                case Text(actual): expect(actual).to_equal("old")
                case _: assert_true(false)
            expect(file_read(path).starts_with("simple-pure-db-v1\n")).to_equal(true)
            expect(legacy.exec("INSERT INTO legacy (id,value) VALUES (?, ?)", [
                DbValue.Text(value: "key2"), DbValue.Text(value: "new|value\twith\nlines")
            ]).is_ok()).to_equal(true)
            expect(legacy.checkpoint().is_ok()).to_equal(true)
            expect(file_read(path).starts_with("simple-pure-db-v3\n")).to_equal(true)
            val migrated = PureDatabase.open_deferred(path).unwrap()
            expect(migrated.query("SELECT value FROM legacy", []).unwrap().len()).to_equal(2)
            file_delete(path)
            file_delete(ambiguous_path)
        )

        it("single-quoted literal with spaces", fn() -> ():
            val db = fresh()
            val sql = "SELECT n FROM mm WHERE id = 'two words here'"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('two words here','x',2)").is_ok()).to_equal(true)
            expect(count(db, sql)).to_equal(1)
        )

        it("literal with an escaped quote", fn() -> ():
            val db = fresh()
            val sql = "SELECT n FROM mm WHERE id = 'it''s'"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('it''s','x',3)").is_ok()).to_equal(true)
            expect(count(db, sql)).to_equal(1)
            expect(count_bound(db, "SELECT n FROM mm WHERE id = ?", DbValue.Text(value: "it's"))).to_equal(1)
        )

        it("WHERE on a non-pk text column", fn() -> ():
            val db = fresh()
            val sql = "SELECT id FROM mm WHERE value = 'needle'"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('k1','needle',4)").is_ok()).to_equal(true)
            expect(count(db, sql)).to_equal(1)
        )

        it("WHERE on an integer literal", fn() -> ():
            val db = fresh()
            val sql = "SELECT id FROM mm WHERE n = 42"
            expect(count(db, sql)).to_equal(0)
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('k2','x',42)").is_ok()).to_equal(true)
            expect(count(db, sql)).to_equal(1)
        )

        it("bound and literal forms agree after every insert", fn() -> ():
            val db = fresh()
            val lit = "SELECT value FROM mm WHERE id = 'a'"
            val bound = "SELECT value FROM mm WHERE id = ?"
            expect(count(db, lit)).to_equal(count_bound(db, bound, DbValue.Text(value: "a")))
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('a','1',1)").is_ok()).to_equal(true)
            expect(count(db, lit)).to_equal(count_bound(db, bound, DbValue.Text(value: "a")))
            expect(db.exec_sql("INSERT INTO mm (id,value,n) VALUES ('b','2',2)").is_ok()).to_equal(true)
            expect(count(db, "SELECT id FROM mm")).to_equal(2)
            expect(count(db, lit)).to_equal(1)
        )
    )
