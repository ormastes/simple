use std.spec.{describe, it, expect}
use std.nogc_async_mut.database.postgres_mimic.parallel_linux_server.{PgServeBoundary}

describe "postgres mimic native serve scalar boundary":
    it "records success using only scalar inputs and observations":
        var boundary = PgServeBoundary.create()
        expect(boundary.record_success(17)).to_equal(0)
        expect(boundary.status_code).to_equal(0)
        expect(boundary.completed).to_equal(17)
        expect(boundary.error_text).to_equal("")

    it "records failure without exporting an IoError aggregate":
        var boundary = PgServeBoundary.create()
        expect(boundary.record_failure(7, "bind denied")).to_equal(7)
        expect(boundary.status_code).to_equal(7)
        expect(boundary.completed).to_equal(0)
        expect(boundary.error_text).to_equal("bind denied")

    it "normalizes invalid failure codes":
        var boundary = PgServeBoundary.create()
        expect(boundary.record_failure(0, "unknown")).to_equal(1)
        expect(boundary.status_code).to_equal(1)
