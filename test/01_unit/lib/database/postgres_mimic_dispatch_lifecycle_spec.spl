"""Parallel pgwire front workers retain single-owner database mutation."""

use std.spec
use std.database.postgres_mimic.{
    PgResponse, PgResponseKind,
    PgDispatchState, PgDispatchOperation, PgDispatchSubmitResult,
    PgDispatchTakeResult, PgDispatchCompletion, PgDispatchLifecycle
}

fn dispatch_ok() -> PgResponse:
    PgResponse(kind: PgResponseKind.CommandComplete, tag: "SELECT 1",
        columns: [], rows: [], sqlstate: "", message: "",
        transaction_status: "I")

fn dispatch_completion() -> PgDispatchCompletion:
    PgDispatchCompletion(session_id: 3, responses: [dispatch_ok()],
        close_connection: false)

describe "Postgres mimic database-owner dispatch lifecycle":
    it "bounds retained work and completes exactly once":
        var lifecycle = PgDispatchLifecycle.create(1)
        val accepted = lifecycle.submit(10, 3, PgDispatchOperation.Query,
            "SELECT 1", 100, 50)
        val job_id = match accepted:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        expect(job_id).to_be_greater_than(0)
        expect(lifecycle.submit(11, 4, PgDispatchOperation.Query,
            "SELECT 2", 100, 50)).to_equal(PgDispatchSubmitResult.Rejected)
        expect(lifecycle.start(job_id, 101)).to_equal(true)
        expect(lifecycle.complete(job_id, dispatch_completion())).to_equal(true)
        expect(lifecycle.complete(job_id, dispatch_completion())).to_equal(false)
        val taken = lifecycle.take(job_id)
        val taken_tag = match taken:
            PgDispatchTakeResult.Ready(response): response.responses[0].tag
            _: ""
        expect(taken_tag).to_equal("SELECT 1")
        expect(lifecycle.take(job_id)).to_equal(PgDispatchTakeResult.Gone)

    it "cancels queued socket work but never interrupts an executing mutation":
        var lifecycle = PgDispatchLifecycle.create(2)
        val queued = lifecycle.submit(20, 1, PgDispatchOperation.Query,
            "UPDATE t SET v = 1", 0, 100)
        val running = lifecycle.submit(20, 1, PgDispatchOperation.Query,
            "COMMIT", 0, 100)
        val queued_id = match queued:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        val running_id = match running:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        expect(lifecycle.start(running_id, 1)).to_equal(true)
        expect(lifecycle.cancel_connection(20)).to_equal(1)
        expect(lifecycle.state_of(queued_id)).to_equal(Some(PgDispatchState.Cancelled))
        expect(lifecycle.state_of(running_id)).to_equal(Some(PgDispatchState.Executing))
        expect(lifecycle.complete(running_id, dispatch_completion())).to_equal(true)

    it "drain rejects new work while preserving the executing owner command":
        var lifecycle = PgDispatchLifecycle.create(3)
        val running = lifecycle.submit(30, 2, PgDispatchOperation.Query,
            "INSERT INTO t VALUES (1)", 0, 100)
        val queued = lifecycle.submit(31, 3, PgDispatchOperation.Query,
            "SELECT 1", 0, 100)
        val running_id = match running:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        val queued_id = match queued:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        expect(lifecycle.start(running_id, 1)).to_equal(true)
        expect(lifecycle.begin_drain()).to_equal(1)
        expect(lifecycle.state_of(running_id)).to_equal(Some(PgDispatchState.Executing))
        expect(lifecycle.state_of(queued_id)).to_equal(Some(PgDispatchState.Submitted))
        expect(lifecycle.submit(32, 4, PgDispatchOperation.Query,
            "SELECT 2", 1, 100)).to_equal(PgDispatchSubmitResult.Rejected)

    it "cancels queued commands only during forced shutdown":
        var lifecycle = PgDispatchLifecycle.create(1)
        val queued = lifecycle.submit(40, 5, PgDispatchOperation.Query,
            "SELECT 1", 0, 100)
        val queued_id = match queued:
            PgDispatchSubmitResult.Accepted(id): id
            PgDispatchSubmitResult.Rejected: 0
        expect(lifecycle.cancel_queued()).to_equal(1)
        expect(lifecycle.state_of(queued_id)).to_equal(Some(PgDispatchState.Cancelled))
