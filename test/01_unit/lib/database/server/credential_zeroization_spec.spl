# @cover src/lib/nogc_sync_mut/database/server/capability.spl
# @req doc/08_tracking/bug/simpleos_server_credential_zeroization_gap_2026-08-14.md
#
# A database credential must never have to become an immutable `text` in order
# to be registered. `text` has no zeroization surface, so every such copy
# outlives any wipe the caller performs and can reach a core dump, a crash
# receipt, or a retained acceptance image. `register_authenticated_bytes`
# closes that by hashing caller-owned MUTABLE bytes directly.
#
# The load-bearing claim is INTERCHANGEABILITY: a principal registered from
# bytes must authenticate against the same wire credential as one registered
# from text, and must reject everything else. A spec that only checked "the
# bytes path returns without error" would pass while storing a digest nothing
# on the wire can ever match — a silent lock-out, or worse, a digest collision
# with the unknown-principal sentinel.

use std.spec
use std.database.server.capability.{
    CapabilityTable, DbCapability, capability_with, grant_key
}
use std.common.crypto.secure_memory.{secure_zero_u8_slots, secure_zero_u8_range}

extern fn rt_text_to_bytes(s: text) -> [u8]

fn operator_capability() -> DbCapability:
    capability_with("operator", [
        grant_key("records", "read"), grant_key("records", "write")
    ])

describe "database server credential registration without a text copy":
    it "authenticates the same wire credential as the text registration path":
        """
        An operator's key file holds `srvdb-acceptance-key`. The SimpleOS server
        reads it as bytes and registers it without ever building a `text`. A
        client then presents that key over the wire, where it necessarily IS
        text. Both must agree, or the byte path has silently locked the operator
        out of their own database.
        """
        step("Register a principal from caller-owned credential bytes")
        var from_bytes = CapabilityTable.new()
        val registered = from_bytes.register_authenticated_bytes(
            operator_capability(), rt_text_to_bytes("srvdb-acceptance-key"))
        assert_true(registered)

        step("Register the same principal the legacy way, from text")
        var from_text = CapabilityTable.new()
        from_text.register_authenticated(operator_capability(), "srvdb-acceptance-key")

        step("The wire credential authenticates against both registrations")
        assert_true(from_bytes.authenticate("operator", "srvdb-acceptance-key"))
        assert_true(from_text.authenticate("operator", "srvdb-acceptance-key"))

    it "rejects a wrong credential registered through the byte path":
        """
        Interchangeability is only meaningful if the byte path still denies.
        A digest that matched everything would pass the previous scenario.
        """
        step("Register from bytes, then present a near-miss credential")
        var policy = CapabilityTable.new()
        policy.register_authenticated_bytes(
            operator_capability(), rt_text_to_bytes("srvdb-acceptance-key"))

        step("A one-character difference is denied")
        assert_false(policy.authenticate("operator", "srvdb-acceptance-keys"))

        step("An empty credential is denied")
        assert_false(policy.authenticate("operator", ""))

        step("An unregistered principal is denied even with the right key")
        assert_false(policy.authenticate("intruder", "srvdb-acceptance-key"))

    it "refuses to register an empty credential from bytes":
        """
        Same fail-closed rule the text path has: a configured principal must
        never become name-only authenticated because its key file was empty.
        Without this, a zero-length /SYS/SRVDB.KEY would grant records
        read+write to anyone who guessed the principal name.
        """
        step("Register the operator with a zero-length credential")
        var policy = CapabilityTable.new()
        var empty_credential: [u8] = []
        policy.register_authenticated_bytes(operator_capability(), empty_credential)

        step("No credential authenticates, including the empty one")
        assert_false(policy.authenticate("operator", ""))
        assert_false(policy.authenticate("operator", "anything"))

    it "leaves the caller's buffer wipeable after registration":
        """
        The contract is that `register_authenticated_bytes` retains only the
        digest, so the caller can zero its buffer immediately. Prove the
        registration survives the wipe — if the table had kept a reference to
        the live buffer instead of hashing it, zeroing would destroy the stored
        credential and authentication would start failing.
        """
        step("Register from a buffer, then zero every byte of that buffer")
        var policy = CapabilityTable.new()
        var buffer = rt_text_to_bytes("srvdb-acceptance-key")
        policy.register_authenticated_bytes(operator_capability(), buffer)
        val wipe = secure_zero_u8_slots(buffer)

        step("The buffer really is zeroed")
        assert_true(wipe.verified())
        assert_equal(buffer[0u64] as i64, 0)

        step("Authentication still succeeds from the retained digest alone")
        assert_true(policy.authenticate("operator", "srvdb-acceptance-key"))

    it "wipes an exact byte range without touching adjacent canaries":
        step("Place secrets between canaries in one allocation")
        var guarded: [u8] = [170u8, 17u8, 34u8, 51u8, 68u8, 187u8]

        step("Wipe only the four credential bytes")
        val wipe = secure_zero_u8_range(guarded, 1u64, 4u64)

        step("Every requested byte is zero and both canaries survive")
        assert_true(wipe.verified())
        assert_equal(wipe.slot_count as i64, 4)
        assert_equal(guarded[0u64] as i64, 170)
        assert_equal(guarded[1u64] as i64, 0)
        assert_equal(guarded[4u64] as i64, 0)
        assert_equal(guarded[5u64] as i64, 187)

    it "rejects an out-of-bounds byte range without changing canaries":
        step("Request a range extending beyond the allocation")
        var guarded: [u8] = [170u8, 17u8, 187u8]
        val wipe = secure_zero_u8_range(guarded, 1u64, 3u64)

        step("The report fails closed and the allocation is unchanged")
        assert_false(wipe.verified())
        assert_equal(wipe.overwritten_slots as i64, 0)
        assert_equal(guarded[0u64] as i64, 170)
        assert_equal(guarded[1u64] as i64, 17)
        assert_equal(guarded[2u64] as i64, 187)
