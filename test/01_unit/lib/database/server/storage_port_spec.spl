# DatabaseStoragePortV1 spec — the std.database.server format= open path.
#
# Pins src/lib/nogc_sync_mut/database/server/storage_port.spl:
#   1. Registry -> backend selection: the standard port admits native
#      (primary, D01), sqlite3 (plaintext pager) and sqlcipher4 (cipher-c
#      page codec) backends; unknown formats fail closed with
#      UnsupportedFormat — never a silent fallback.
#   2. Admission: interface_version mismatch is rejected; duplicate
#      backend_id is latest-wins with a recorded diagnostic; a custom
#      backend for a new format is selectable.
#   3. Explicit-format policy (D01): a SecretRef is admissible ONLY for
#      sqlcipher4; sqlcipher4 without a secret fails MissingSecret; a
#      non-page-multiple file fails CorruptSource.
#   4. sqlite3 backend reads the plaintext pager fixture with real decoded
#      rows (typed values incl. UTF-8 text and REAL/BLOB probes).
#   5. sqlcipher4 backend opens the SQLCipher-4 messenger fixture through a
#      SecretRef, authenticates+decodes all pages, and serves typed rows;
#      a wrong passphrase fails AuthenticationFailed with no plaintext; a
#      tampered page fails AuthenticationFailed; close_view zeroizes the
#      snapshot.
#
# Fixtures: test/fixtures/database/sqlcipher4/{messenger_plain.sqlite,
# messenger.sqlcipher4} generated by gen_sqlcipher4_fixture.py (oracles:
# python sqlite3 opens both the plaintext image and the decrypted
# sqlcipher4 file; see the generator header).
#
# @timeout_secs 1800 (interpreted-mode AES suites are slow; the directive is an
# honest runtime record, not a relaxed gate)
# @req: REQ-STORAGE-PORT-001 — versioned storage port, native primary,
#       SQLite/SQLCipher second backends, explicit format selection (D01).

"""
## Purpose and audience
Purpose: Verify the storage port's registry/admission/selection semantics
and both file backends against pinned fixtures.
Audience: database server maintainers, integration lane reviewers.
"""

use std.spec.*
use std.database.server.storage_port.{
    DatabaseStoragePortV1, database_storage_port_v1,
    StorageBackendV1, StorageOpenResult, StorageReadView, StoragePortError,
    STORAGE_FORMAT_NATIVE, STORAGE_FORMAT_SQLITE3, STORAGE_FORMAT_SQLCIPHER4
}
use std.database.sql.types.{DbRow, DbValue}
use std.nogc_sync_mut.io.env_ops.{env_set}

val PLAIN_FIXTURE: text = "test/fixtures/database/sqlcipher4/messenger_plain.sqlite"
val ENC_FIXTURE: text = "test/fixtures/database/sqlcipher4/messenger.sqlcipher4"
val ENC_SECRET_REF: text = "secret://messenger/fixture"
val ENC_ENV_VAR: text = "SIMPLE_SECRET_MESSENGER_FIXTURE"
val TAMPERED_FIXTURE: text = "test/fixtures/database/sqlcipher4/messenger_tampered.sqlcipher4"
val SHORT_FIXTURE: text = "test/fixtures/database/sqlcipher4/not_page_multiple.bin"

# --- outcome helpers (flat match arms; arms RETURN values) ------------------

fn _open_outcome(path: text, format_name: text, secret: text) -> text:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            _error_outcome(e)
        Ok(opened):
            match opened:
                StorageOpenResult.NativeStore(_s):
                    "native_store"
                StorageOpenResult.SqliteView(_v):
                    "sqlite_view"

fn _error_outcome(e: StoragePortError) -> text:
    match e:
        StoragePortError.UnsupportedFormat(d):
            "unsupported_format:{d}"
        StoragePortError.InvalidFormat(d):
            "invalid_format:{d}"
        StoragePortError.MissingSecret(d):
            "missing_secret:{d}"
        StoragePortError.AuthenticationFailed(d):
            "authentication_failed:{d}"
        StoragePortError.CorruptSource(d):
            "corrupt_source:{d}"
        StoragePortError.Io(d):
            "io:{d}"

fn _view_facts(path: text, format_name: text, secret: text) -> text:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return "open_error|{e.code()}"
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.SqliteView(view):
                    "{view.format}|{view.page_size}|{view.page_count}|{view.reserved_bytes}|{view.text_encoding}|{view.image.len()}"
                StorageOpenResult.NativeStore(_s):
                    "native_store"
            return inner

fn _table_cell_text(path: text, format_name: text, secret: text, table: text, row_idx: i64, col: text) -> text:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return "open_error|{e.code()}"
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.NativeStore(_s):
                    "native_store"
                StorageOpenResult.SqliteView(view):
                    match port.read_table(view, table):
                        Err(e2):
                            "read_error|{e2.code()}"
                        Ok(rows):
                            if row_idx < 0 or row_idx >= rows.len():
                                "no_such_row"
                            else:
                                _row_col_text(rows[row_idx], col)
            return inner

fn _table_len(path: text, format_name: text, secret: text, table: text) -> i64:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return -1
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.NativeStore(_s):
                    -2
                StorageOpenResult.SqliteView(view):
                    match port.read_table(view, table):
                        Err(e2):
                            -3
                        Ok(rows):
                            rows.len()
            return inner

# Function-level row join (arm-local loop mutation is unreliable in the
# seed interpreter; recursion at fn level is the house parser pattern).
fn _join_bodies(rows: [DbRow], i: i64) -> text:
    if i >= rows.len():
        return ""
    _row_col_text(rows[i], "body") + "\n" + _join_bodies(rows, i + 1)

# Single-open messages dump ("body" column, newline-separated) to keep
# AES decode cost linear in test count.
fn _bodies_dump(path: text, format_name: text, secret: text) -> text:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return "open_error|{e.code()}"
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.NativeStore(_s):
                    "native_store"
                StorageOpenResult.SqliteView(view):
                    match port.read_table(view, "messages"):
                        Err(e2):
                            "read_error|{e2.code()}"
                        Ok(rows):
                            _join_bodies(rows, 0)
            return inner

fn _row_col_text(row: DbRow, name: text) -> text:
    var i = 0
    while i < row.columns.len():
        if row.columns[i] == name:
            return row.values[i].to_text()
        i = i + 1
    return "no_such_column"

fn _read_error_code(path: text, format_name: text, secret: text, table: text) -> text:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return "open:{e.code()}"
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.NativeStore(_s):
                    "native"
                StorageOpenResult.SqliteView(view):
                    match port.read_table(view, table):
                        Err(e2):
                            e2.code()
                        Ok(_rows):
                            "ok"
            return inner

# close_view zeroizes the plaintext snapshot in place.
fn _closed_image_byte0(path: text, format_name: text, secret: text) -> i64:
    val port = database_storage_port_v1()
    match port.open(path, format_name, secret):
        Err(e):
            return -1
        Ok(opened):
            val inner = match opened:
                StorageOpenResult.NativeStore(_s):
                    -2
                StorageOpenResult.SqliteView(view):
                    val _z = port.close_view(view)
                    view.image[0] as i64
            return inner

# Custom-backend dispatch probe: a backend that always answers with a
# recognizable UnsupportedFormat-class error proves selection reached it.
fn _custom_backend_error(path: text, secret: text) -> Result<StorageOpenResult, StoragePortError>:
    Err(StoragePortError.UnsupportedFormat(detail: "custom-backend-reached"))

fn _custom_dispatch_outcome(format_name: text) -> text:
    var port = DatabaseStoragePortV1.new()
    val _r = port.register_backend(StorageBackendV1(
        backend_id: "storage.custom",
        format_name: "custom_format",
        interface_version: 1,
        open_fn: _custom_backend_error))
    match port.open("whatever", format_name, ""):
        Err(e):
            _error_outcome(e)
        Ok(_o):
            "unexpected_ok"

fn _admit_bad_version() -> text:
    var port = DatabaseStoragePortV1.new()
    match port.register_backend(StorageBackendV1(
        backend_id: "storage.bad",
        format_name: "bad",
        interface_version: 99,
        open_fn: _custom_backend_error)):
        Err(e):
            e.code()
        Ok(_u):
            "admitted"

fn _dup_backend_diagnostic() -> text:
    var port = DatabaseStoragePortV1.new()
    val b1 = StorageBackendV1(
        backend_id: "storage.dup", format_name: "dupfmt",
        interface_version: 1, open_fn: _custom_backend_error)
    val b2 = StorageBackendV1(
        backend_id: "storage.dup", format_name: "dupfmt2",
        interface_version: 1, open_fn: _custom_backend_error)
    val _r1 = port.register_backend(b1)
    val _r2 = port.register_backend(b2)
    if port.list_diagnostics().len() == 1:
        port.list_diagnostics()[0]
    else:
        "no-diagnostic"

describe "storage port registry -> backend selection":
    it "standard port admits native, sqlite3, and sqlcipher4 backends":
        step("known formats of database_storage_port_v1()")
        val port = database_storage_port_v1()
        expect(port.known_formats().contains("native")).to_equal(true)
        expect(port.known_formats().contains("sqlite3")).to_equal(true)
        expect(port.known_formats().contains("sqlcipher4")).to_equal(true)

    it "unknown format fails closed with UnsupportedFormat":
        step("open with format=paradox")
        val outcome = _open_outcome("whatever", "paradox", "")
        expect(outcome.starts_with("unsupported_format:")).to_equal(true)

    it "selection is explicit: a registered custom backend receives the open":
        step("register custom_format backend, dispatch to it")
        expect(_custom_dispatch_outcome("custom_format")).to_equal("unsupported_format:custom-backend-reached")

    it "admission rejects an interface version mismatch":
        step("register backend with interface_version 99")
        expect(_admit_bad_version()).to_equal("STORAGE_PORT_INVALID_FORMAT")

    it "duplicate backend_id is latest-wins with a recorded diagnostic":
        step("register storage.dup twice")
        expect(_dup_backend_diagnostic().contains("latest-wins")).to_equal(true)

describe "explicit-format policy (D01)":
    it "a SecretRef is rejected for the native and sqlite3 formats":
        step("open plaintext formats with a secret argument")
        expect(_open_outcome("whatever", "native", "secret://x/y").starts_with("invalid_format:")).to_equal(true)
        expect(_open_outcome("whatever", "sqlite3", "secret://x/y").starts_with("invalid_format:")).to_equal(true)

    it "sqlcipher4 without a secret fails MissingSecret":
        step("open the encrypted fixture with an empty ref")
        expect(_open_outcome(ENC_FIXTURE, "sqlcipher4", "").starts_with("missing_secret:")).to_equal(true)

    it "a file that is not a whole number of pages fails CorruptSource":
        step("open not_page_multiple.bin as sqlcipher4")
        expect(_open_outcome(SHORT_FIXTURE, "sqlcipher4", ENC_SECRET_REF).starts_with("corrupt_source:")).to_equal(true)

describe "sqlite3 backend over the plaintext pager fixture":
    it "opens the plaintext fixture and reports its page facts":
        step("open messenger_plain.sqlite as sqlite3")
        expect(_view_facts(PLAIN_FIXTURE, "sqlite3", "")).to_equal("sqlite3|4096|5|80|1|20480")

    it "reads typed rows (text, integer, real, blob, unicode)":
        step("read room/messages/type_probe rows")
        expect(_table_len(PLAIN_FIXTURE, "sqlite3", "", "room")).to_equal(2)
        expect(_table_cell_text(PLAIN_FIXTURE, "sqlite3", "", "room", 0, "title")).to_equal("general")
        expect(_table_cell_text(PLAIN_FIXTURE, "sqlite3", "", "messages", 2, "body")).to_equal(
            "unicode: héllo wörld ✓")
        expect(_table_cell_text(PLAIN_FIXTURE, "sqlite3", "", "type_probe", 1, "r")).to_equal("1.5")
        expect(_table_cell_text(PLAIN_FIXTURE, "sqlite3", "", "type_probe", 2, "b")).to_equal("<blob:4 bytes>")

    it "unknown table is a typed read error, never a silent empty":
        step("read table 'nope'")
        expect(_read_error_code(PLAIN_FIXTURE, "sqlite3", "", "nope")).to_equal("STORAGE_PORT_CORRUPT_SOURCE")

describe "sqlcipher4 backend over the encrypted fixture (SecretRef path)":
    it "opens through a SecretRef and serves real decoded rows (single open, facts + messages)":
        step("set env, open messenger.sqlcipher4 as sqlcipher4, dump messages")
        val _ = env_set(ENC_ENV_VAR, "messenger-fixture-passphrase")
        val facts = _view_facts(ENC_FIXTURE, "sqlcipher4", ENC_SECRET_REF)
        expect(facts).to_equal("sqlcipher4|4096|5|80|1|20480")
        val dump = _bodies_dump(ENC_FIXTURE, "sqlcipher4", ENC_SECRET_REF)
        expect(dump.contains("hello world")).to_equal(true)
        expect(dump.contains("hi there")).to_equal(true)
        expect(dump.contains("unicode: héllo wörld ✓")).to_equal(true)
        expect(dump.contains("second room says hi")).to_equal(true)

    it "wrong passphrase fails AuthenticationFailed with no plaintext released":
        step("set a wrong env value, open")
        val _ = env_set(ENC_ENV_VAR, "wrong-passphrase")
        val outcome = _open_outcome(ENC_FIXTURE, "sqlcipher4", ENC_SECRET_REF)
        expect(outcome.starts_with("authentication_failed:")).to_equal(true)
        val _restore = env_set(ENC_ENV_VAR, "messenger-fixture-passphrase")

    it "a tampered ciphertext page fails AuthenticationFailed":
        step("open messenger_tampered.sqlcipher4 (one flipped byte in page 2)")
        val _ = env_set(ENC_ENV_VAR, "messenger-fixture-passphrase")
        expect(_open_outcome(TAMPERED_FIXTURE, "sqlcipher4", ENC_SECRET_REF).starts_with("authentication_failed:")).to_equal(true)

    it "close_view zeroizes the plaintext snapshot":
        step("open, close, inspect image byte 0")
        expect(_closed_image_byte0(ENC_FIXTURE, "sqlcipher4", ENC_SECRET_REF)).to_equal(0)
