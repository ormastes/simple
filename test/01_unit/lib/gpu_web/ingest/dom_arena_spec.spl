"""
## Purpose and audience
Purpose: Prove that gpu web dom arena — empty input.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GPU-WEB-001 — stable requirement identity for this spec.

# Behaviour spec for the GPU-web DOM arena contract and its CPU-reference
# ordered tree-builder commit.
#
# Lane: HTML-DOM parse side, wave 1
#   doc/03_plan/platform/structural_compute/html_css_parser_plan.md
#
# NOTE ON PLACEMENT: the plan's owned-paths block lists source
# `.../gpu_web/dom/` but only `test/01_unit/lib/gpu_web/ingest/` and
# `.../style/` on the test side — there is no `test/.../gpu_web/dom/` in the
# plan. This spec therefore lives under `ingest/`, the nearest owned test
# directory for DOM ingestion. That is an interpretation, not the plan's words.
#
# Assertions are behavioural: tree shape, ordering, receipts, capacity
# verdicts. Nothing here asserts on source text.

use std.spec.*
use std.common.ui.gpu_web_capacity_manifest.{
    GpuWebCapacityManifest,
    gpu_web_capacity_manifest_compile_time_default,
    gpu_web_capacity_manifest_zero
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.dom.*

fn manifest_ok() -> GpuWebCapacityManifest:
    gpu_web_capacity_manifest_compile_time_default()

# <html><body id="b" class="c">hi<!--note--></body></html>
fn sample_document() -> DomBuildResult:
    var b = dom_builder_new()
    b = dom_builder_open_document(b)
    b = dom_builder_open_element(b, "html", "")
    b = dom_builder_open_element(b, "body", "")
    b = dom_builder_attribute(b, "id", "b", "")
    b = dom_builder_attribute(b, "class", "c", "")
    b = dom_builder_text(b, "hi")
    b = dom_builder_comment(b, "note")
    b = dom_builder_close(b)
    b = dom_builder_close(b)
    b = dom_builder_close(b)
    dom_builder_finish(b, manifest_ok())

use std.spec.step

describe "gpu web dom arena — empty input":
    it "accepts an empty build and produces an empty arena":
        step("Verify: accepts an empty build and produces an empty arena")
        # @req: REQ-LIB-GPU-WEB-001
        val result = dom_builder_finish(dom_builder_new(), manifest_ok())
        expect(result.ok).to_equal(true)
        expect(result.error_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.reason).to_equal("")
        expect(dom_arena_node_count(result.arena)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dom_string_count(result.arena.strings)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "serializes an empty arena to empty canonical output":
        step("Verify: serializes an empty arena to empty canonical output")
        val result = dom_builder_finish(dom_builder_new(), manifest_ok())
        expect(dom_arena_canonical_lines(result.arena).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dom_arena_canonical_text(result.arena)).to_equal("")

    it "fits even a fully unset manifest because every total is zero":
        step("Verify: fits even a fully unset manifest because every total is zero")
        val result = dom_builder_finish(dom_builder_new(), gpu_web_capacity_manifest_zero())
        expect(result.ok).to_equal(true)
        expect(result.verdict.accepted).to_equal(true)

describe "gpu web dom arena — tree shape":
    it "appends nodes in document order":
        step("Verify: appends nodes in document order")
        val result = sample_document()
        expect(result.ok).to_equal(true)
        expect(dom_arena_node_count(result.arena)).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(dom_arena_kind(result.arena, 0)).to_equal(DOM_NODE_KIND_DOCUMENT)
        expect(dom_arena_kind(result.arena, 1)).to_equal(DOM_NODE_KIND_ELEMENT)
        expect(dom_arena_kind(result.arena, 2)).to_equal(DOM_NODE_KIND_ELEMENT)
        expect(dom_arena_kind(result.arena, 3)).to_equal(DOM_NODE_KIND_TEXT)
        expect(dom_arena_kind(result.arena, 4)).to_equal(DOM_NODE_KIND_COMMENT)

    it "links parents so depth follows nesting":
        step("Verify: links parents so depth follows nesting")
        val result = sample_document()
        expect(dom_arena_depth(result.arena, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(dom_arena_depth(result.arena, 1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(dom_arena_depth(result.arena, 2)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dom_arena_depth(result.arena, 3)).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(dom_arena_parent(result.arena, 0)).to_equal(DOM_NO_ID_I64)
        expect(dom_arena_parent(result.arena, 3)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "walks children in insertion order":
        step("Verify: walks children in insertion order")
        val result = sample_document()
        val kids = dom_arena_children(result.arena, 2)
        expect(kids.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(kids[0]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(kids[1]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(dom_arena_children(result.arena, 3).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "records element and leaf payloads through the string table":
        step("Verify: records element and leaf payloads through the string table")
        val result = sample_document()
        expect(dom_arena_name(result.arena, 1)).to_equal("html")
        expect(dom_arena_name(result.arena, 2)).to_equal("body")
        expect(dom_arena_value(result.arena, 3)).to_equal("hi")
        expect(dom_arena_value(result.arena, 4)).to_equal("note")

    it "produces identical canonical output for identically shaped trees":
        step("Verify: produces identical canonical output for identically shaped trees")
        val a = sample_document()
        val b = sample_document()
        expect(dom_arena_canonical_text(a.arena)).to_equal(dom_arena_canonical_text(b.arena))
        expect(dom_arena_canonical_lines(a.arena).len()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "distinguishes canonical output when only tree shape differs":
        step("Verify: distinguishes canonical output when only tree shape differs")
        var flat = dom_builder_new()
        flat = dom_builder_open_document(flat)
        flat = dom_builder_open_element(flat, "html", "")
        flat = dom_builder_close(flat)
        flat = dom_builder_open_element(flat, "body", "")
        flat = dom_builder_close(flat)
        flat = dom_builder_close(flat)
        val flat_result = dom_builder_finish(flat, manifest_ok())

        var nested = dom_builder_new()
        nested = dom_builder_open_document(nested)
        nested = dom_builder_open_element(nested, "html", "")
        nested = dom_builder_open_element(nested, "body", "")
        nested = dom_builder_close(nested)
        nested = dom_builder_close(nested)
        nested = dom_builder_close(nested)
        val nested_result = dom_builder_finish(nested, manifest_ok())

        expect(flat_result.ok).to_equal(true)
        expect(nested_result.ok).to_equal(true)
        expect(dom_arena_node_count(flat_result.arena))
            .to_equal(dom_arena_node_count(nested_result.arena))
        expect(dom_arena_canonical_text(flat_result.arena)
            == dom_arena_canonical_text(nested_result.arena)).to_equal(false)

describe "gpu web dom arena — attributes":
    it "stores a node's attributes as a contiguous span":
        step("Verify: stores a node's attributes as a contiguous span")
        val result = sample_document()
        val span = dom_arena_attribute_span(result.arena, 2)
        expect(span.count.to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dom_arena_attribute_span(result.arena, 1).count.to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "resolves attribute values by name":
        step("Verify: resolves attribute values by name")
        val result = sample_document()
        expect(dom_arena_attribute_value(result.arena, 2, "id")).to_equal("b")
        expect(dom_arena_attribute_value(result.arena, 2, "class")).to_equal("c")

    it "reports an absent attribute without an error":
        step("Verify: reports an absent attribute without an error")
        val result = sample_document()
        expect(dom_arena_attribute_index(result.arena, 2, "href")).to_equal(DOM_NO_ID_I64)
        expect(dom_arena_attribute_value(result.arena, 2, "href")).to_equal("")

describe "gpu web dom arena — interning":
    it "gives repeated strings the same id":
        step("Verify: gives repeated strings the same id")
        var b = dom_builder_new()
        val first = dom_builder_intern(b, "div")
        val second = dom_builder_intern(first.builder, "div")
        val third = dom_builder_intern(second.builder, "span")
        expect(first.id).to_equal(second.id)
        expect(third.id == first.id).to_equal(false)
        expect(dom_string_count(third.builder.arena.strings)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "round-trips interned text through the flat byte column":
        step("Verify: round-trips interned text through the flat byte column")
        var b = dom_builder_new()
        val res = dom_builder_intern(b, "data-value")
        expect(dom_string_text(res.builder.arena.strings, res.id)).to_equal("data-value")

    it "returns empty text for an out-of-range string id":
        step("Verify: returns empty text for an out-of-range string id")
        val result = dom_builder_finish(dom_builder_new(), manifest_ok())
        expect(dom_string_text(result.arena.strings, 7)).to_equal("")

describe "gpu web dom arena — malformed input carries a receipt":
    it "rejects a close with no open element":
        step("Verify: rejects a close with no open element")
        var b = dom_builder_new()
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, manifest_ok())
        expect(result.ok).to_equal(false)
        expect(result.error_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.reason.starts_with(DOM_BUILD_ERR_UNBALANCED_CLOSE)).to_equal(true)

    it "rejects a build that leaves elements open":
        step("Verify: rejects a build that leaves elements open")
        var b = dom_builder_new()
        b = dom_builder_open_element(b, "html", "")
        b = dom_builder_open_element(b, "body", "")
        val result = dom_builder_finish(b, manifest_ok())
        expect(result.ok).to_equal(false)
        expect(result.reason.starts_with(DOM_BUILD_ERR_UNCLOSED_ELEMENTS)).to_equal(true)

    it "rejects an attribute that would tear a node's span":
        step("Verify: rejects an attribute that would tear a node's span")
        var b = dom_builder_new()
        b = dom_builder_open_element(b, "body", "")
        b = dom_builder_text(b, "hi")
        b = dom_builder_attribute(b, "id", "late", "")
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, manifest_ok())
        expect(result.ok).to_equal(false)
        expect(result.reason.starts_with(DOM_BUILD_ERR_ATTRIBUTE_WITHOUT_ELEMENT)).to_equal(true)
        expect(dom_arena_attribute_span(result.arena, 0).count.to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps every receipt, not only the first":
        step("Verify: keeps every receipt, not only the first")
        var b = dom_builder_new()
        b = dom_builder_close(b)
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, manifest_ok())
        expect(result.error_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result.reasons.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "commits the well-formed prefix of a malformed sequence":
        step("Verify: commits the well-formed prefix of a malformed sequence")
        var b = dom_builder_new()
        b = dom_builder_open_element(b, "body", "")
        b = dom_builder_text(b, "hi")
        b = dom_builder_close(b)
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, manifest_ok())
        expect(result.ok).to_equal(false)
        expect(dom_arena_node_count(result.arena)).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "gpu web dom arena — capacity is checked, never clamped":
    it "counts nodes, attributes, edges and string bytes into the plan":
        step("Verify: counts nodes, attributes, edges and string bytes into the plan")
        val result = sample_document()
        expect(result.plan.nodes.to_i64()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(result.plan.attributes.to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result.plan.dom_edges.to_i64()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(result.plan.string_bytes.to_i64() > 0).to_equal(true)

    it "rejects a build that exceeds an unset bound and names it":
        step("Verify: rejects a build that exceeds an unset bound and names it")
        var b = dom_builder_new()
        b = dom_builder_open_element(b, "html", "")
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, gpu_web_capacity_manifest_zero())
        expect(result.ok).to_equal(false)
        expect(result.verdict.accepted).to_equal(false)
        expect(result.verdict.first_breach_bound).to_equal("max_input_bytes")
        expect(result.reason.starts_with(DOM_BUILD_ERR_CAPACITY)).to_equal(true)

    it "does not shrink the arena when capacity is refused":
        step("Verify: does not shrink the arena when capacity is refused")
        var b = dom_builder_new()
        b = dom_builder_open_element(b, "html", "")
        b = dom_builder_close(b)
        val result = dom_builder_finish(b, gpu_web_capacity_manifest_zero())
        expect(dom_arena_node_count(result.arena)).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "gpu web dom arena — snapshots":
    it "treats a later epoch as superseding an earlier one":
        step("Verify: treats a later epoch as superseding an earlier one")
        val result = sample_document()
        val older = dom_build_result_snapshot(result, 1u64)
        val newer = dom_build_result_snapshot(result, 2u64)
        expect(dom_snapshot_supersedes(newer, older)).to_equal(true)
        expect(dom_snapshot_supersedes(older, newer)).to_equal(false)

    it "accepts a node id whose generation still matches its slot":
        step("Verify: accepts a node id whose generation still matches its slot")
        val result = sample_document()
        val snap = dom_build_result_snapshot(result, 1u64)
        val id = dom_arena_node_id(result.arena, 2)
        expect(dom_snapshot_id_live(snap, id)).to_equal(true)

    it "rejects a node id whose generation no longer matches":
        step("Verify: rejects a node id whose generation no longer matches")
        val result = sample_document()
        val snap = dom_build_result_snapshot(result, 1u64)
        expect(dom_snapshot_id_live(snap, dom_node_id(2u32, 9u32))).to_equal(false)

    it "rejects a node id pointing past the arena":
        step("Verify: rejects a node id pointing past the arena")
        val result = sample_document()
        val snap = dom_build_result_snapshot(result, 1u64)
        expect(dom_snapshot_id_live(snap, dom_node_id(99u32, 0u32))).to_equal(false)

describe "gpu web dom arena — accessors are total":
    it "answers absent for out-of-range indices instead of trapping":
        step("Verify: answers absent for out-of-range indices instead of trapping")
        val result = sample_document()
        expect(dom_arena_in_range(result.arena, 99)).to_equal(false)
        expect(dom_arena_kind(result.arena, 99)).to_equal(DOM_NODE_KIND_NONE)
        expect(dom_arena_parent(result.arena, 99)).to_equal(DOM_NO_ID_I64)
        expect(dom_arena_depth(result.arena, 99)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(dom_arena_name(result.arena, -1)).to_equal("")
        expect(dom_arena_children(result.arena, 99).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
