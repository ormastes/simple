# Repro: std_spec_package_shadows_file_print_summary_2026-07-17.
# After a top-level describe has run one passing example, the imported
# get_executed_test_count() must report 1 (it reported 0 because describe/it
# update interpreter-side counters, not the vars spec.spl's summary reads).
use std.spec.{describe, it, expect}
use std.env.{env_get}
use std.io_runtime.{host_os, getpid}
use std.io.process_ops.{process_run_bounded}
use std.process.run

val FIXTURE = "test/fixtures/lib/std_spec_summary/main.spl"

fn _simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != "":
        return configured
    if host_os() == "windows":
        val (out, _e, code) = process_run_bounded("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", "(Get-Process -Id {getpid()}).Path"], 20000, 65536)
        if code == 0:
            return out.trim()
        return ""
    val (ps_out, _pe, ps_code) = process_run_bounded("ps", ["-o", "comm=", "-p", "{getpid()}"], 2000, 65536)
    if ps_code == 0: ps_out.trim() else: ""

describe "std.spec summary accessors after describe":
    it "reports the executed example through get_executed_test_count":
        val bin = _simple_binary()
        expect(bin != "").to_equal(true)
        val result = run(bin, ["run", FIXTURE])
        expect(result.stdout).to_contain("COUNT_AFTER_DESCRIBE=1")
