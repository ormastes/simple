# Focused native regression for exact-size PoolAllocator objects and reuse.
# The entry returns a distinct nonzero status for each violated invariant.
use std.gc_async_mut.allocator.{PoolAllocator, Allocator}

fn main() -> i64:
    val pool = PoolAllocator.new(object_size: 8, capacity: 2)
    var a = pool.allocate(8, 8).unwrap()
    var b = pool.allocate(8, 8).unwrap()
    if a.len() != 8 or b.len() != 8:
        return 1
    a[0] = 11u8
    b[0] = 23u8
    if a[0] != 11u8 or b[0] != 23u8:
        return 2
    if pool.allocate(8, 8).?:
        return 3

    pool.deallocate(a, 8, 8)
    val recycled = pool.allocate(8, 8).unwrap()
    if recycled.len() != 8 or recycled[0] != 11u8:
        return 4
    if b[0] != 23u8 or pool.available() != 0:
        return 5

    val empty = PoolAllocator.new(object_size: 8, capacity: 0)
    if empty.allocate(8, 8).?:
        return 6
    if empty.available() != 0 or empty.total_allocated() != 0:
        return 7
    return 0
