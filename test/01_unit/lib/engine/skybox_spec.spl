"""
## Purpose and audience
Purpose: Prove that Cubemap.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Skybox — cubemap, reflection probe, and skybox manager tests

Tests cubemap face management, completeness checks, reflection probe
creation, skybox manager assignment, gradient sky, and clear behavior.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.skybox.{Cubemap, CubemapFace, ReflectionProbe, SkyboxManager}

describe "Cubemap":
    it "starts empty":
        step("Verify: starts empty")
        # @req: REQ-LIB-ENGINE-001
        val cm = Cubemap.new("test_sky")
        expect(cm.name).to_equal("test_sky")
        expect(cm.face_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(cm.is_complete()).to_equal(false)

    it "set_face adds a face":
        step("Verify: set_face adds a face")
        var cm = Cubemap.new("sky")
        cm.set_face("px", "tex/px.png")
        expect(cm.face_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(cm.get_face("px")).to_equal("tex/px.png")

    it "set_face updates existing face":
        step("Verify: set_face updates existing face")
        var cm = Cubemap.new("sky")
        cm.set_face("px", "old.png")
        cm.set_face("px", "new.png")
        expect(cm.face_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(cm.get_face("px")).to_equal("new.png")

    it "get_face returns empty for missing face":
        step("Verify: get_face returns empty for missing face")
        val cm = Cubemap.new("sky")
        expect(cm.get_face("px")).to_equal("")

    it "is_complete returns true with all 6 faces":
        step("Verify: is_complete returns true with all 6 faces")
        var cm = Cubemap.new("sky")
        cm.set_face("px", "a.png")
        cm.set_face("nx", "b.png")
        cm.set_face("py", "c.png")
        cm.set_face("ny", "d.png")
        cm.set_face("pz", "e.png")
        expect(cm.is_complete()).to_equal(false)
        cm.set_face("nz", "f.png")
        expect(cm.is_complete()).to_equal(true)
        expect(cm.face_count()).to_equal(6)  # oracle: 6 — named expected value from the requirement

describe "ReflectionProbe":
    it "creates with correct fields":
        step("Verify: creates with correct fields")
        val probe = ReflectionProbe.new("probe1", 1.0, 2.0, 3.0, 10.0, 256)
        expect(probe.name).to_equal("probe1")
        expect(probe.position_x).to_equal(1.0)  # oracle: 1.0 — named expected value from the requirement
        expect(probe.position_y).to_equal(2.0)  # oracle: 2.0 — named expected value from the requirement
        expect(probe.position_z).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
        expect(probe.radius).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
        expect(probe.resolution).to_equal(256)  # oracle: 256 — named expected value from the requirement

describe "SkyboxManager":
    it "starts with no skybox":
        step("Verify: starts with no skybox")
        val mgr = SkyboxManager.new()
        expect(mgr.has_skybox()).to_equal(false)
        expect(mgr.probe_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "set_skybox enables skybox":
        step("Verify: set_skybox enables skybox")
        var mgr = SkyboxManager.new()
        var cm = Cubemap.new("sky")
        cm.set_face("px", "a.png")
        mgr.set_skybox(cm)
        expect(mgr.has_skybox()).to_equal(true)

    it "set_gradient updates colors":
        step("Verify: set_gradient updates colors")
        var mgr = SkyboxManager.new()
        mgr.set_gradient(0.2, 0.4, 0.8, 0.1, 0.1, 0.1)
        expect(mgr.sky_color_top_r).to_equal(0.2)  # oracle: 0.2 — named expected value from the requirement
        expect(mgr.sky_color_top_g).to_equal(0.4)  # oracle: 0.4 — named expected value from the requirement
        expect(mgr.sky_color_top_b).to_equal(0.8)  # oracle: 0.8 — named expected value from the requirement
        expect(mgr.sky_color_bottom_r).to_equal(0.1)  # oracle: 0.1 — named expected value from the requirement
        expect(mgr.sky_color_bottom_g).to_equal(0.1)  # oracle: 0.1 — named expected value from the requirement
        expect(mgr.sky_color_bottom_b).to_equal(0.1)  # oracle: 0.1 — named expected value from the requirement

    it "add_probe returns index":
        step("Verify: add_probe returns index")
        var mgr = SkyboxManager.new()
        val p0 = ReflectionProbe.new("p0", 0.0, 0.0, 0.0, 5.0, 128)
        val p1 = ReflectionProbe.new("p1", 1.0, 1.0, 1.0, 10.0, 256)
        val idx0 = mgr.add_probe(p0)
        val idx1 = mgr.add_probe(p1)
        expect(idx0).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(idx1).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(mgr.probe_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "clear resets everything":
        step("Verify: clear resets everything")
        var mgr = SkyboxManager.new()
        var cm = Cubemap.new("sky")
        cm.set_face("px", "a.png")
        mgr.set_skybox(cm)
        mgr.set_gradient(1.0, 1.0, 1.0, 0.5, 0.5, 0.5)
        val probe = ReflectionProbe.new("p", 0.0, 0.0, 0.0, 5.0, 128)
        mgr.add_probe(probe)
        mgr.clear()
        expect(mgr.has_skybox()).to_equal(false)
        expect(mgr.probe_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(mgr.sky_color_top_r).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(mgr.sky_color_bottom_r).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
