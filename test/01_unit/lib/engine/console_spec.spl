# Game Console Tests

"""
## Purpose and audience
Verifies the console behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.core.console.{GameConsole}

# @req: REQ-ENGINE-Console-001
describe "GameConsole":
    it "creates an empty console":
        # @req: REQ-ENGINE-Console-001
        step("Verify: creates an empty console")
        val console = GameConsole.new(100)
        expect(console.command_count()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(console.is_visible()).to_equal(false)

    it "registers a command":
        # @req: REQ-ENGINE-Console-001
        step("Verify: registers a command")
        var console = GameConsole.new(100)
        console.register_command("help", "Show available commands")
        expect(console.command_count()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(console.has_command("help")).to_equal(true)

    it "reports missing commands":
        # @req: REQ-ENGINE-Console-001
        step("Verify: reports missing commands")
        var console = GameConsole.new(100)
        expect(console.has_command("nope")).to_equal(false)

    it "executes a registered command":
        # @req: REQ-ENGINE-Console-001
        step("Verify: executes a registered command")
        var console = GameConsole.new(100)
        console.register_command("ping", "Pong!")
        val output = console.execute("ping")
        expect(output).to_contain("ping")
        expect(output).to_contain("Pong!")

    it "returns unknown for unregistered commands":
        # @req: REQ-ENGINE-Console-001
        step("Verify: returns unknown for unregistered commands")
        var console = GameConsole.new(100)
        val output = console.execute("foo")
        expect(output).to_contain("unknown command")

    it "stores input and output in history":
        # @req: REQ-ENGINE-Console-001
        step("Verify: stores input and output in history")
        var console = GameConsole.new(100)
        console.register_command("test", "A test")
        console.execute("test")
        val hist = console.get_history()
        expect(hist.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(hist[0].is_input).to_equal(true)
        expect(hist[0].content).to_equal("test")
        expect(hist[1].is_input).to_equal(false)

    it "toggles visibility":
        # @req: REQ-ENGINE-Console-001
        step("Verify: toggles visibility")
        var console = GameConsole.new(100)
        expect(console.is_visible()).to_equal(false)
        console.toggle()
        expect(console.is_visible()).to_equal(true)
        console.toggle()
        expect(console.is_visible()).to_equal(false)

    it "adds output lines":
        # @req: REQ-ENGINE-Console-001
        step("Verify: adds output lines")
        var console = GameConsole.new(100)
        console.add_output("Welcome to the console")
        val hist = console.get_history()
        expect(hist.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(hist[0].content).to_equal("Welcome to the console")
        expect(hist[0].is_input).to_equal(false)

    it "clears history":
        # @req: REQ-ENGINE-Console-001
        step("Verify: clears history")
        var console = GameConsole.new(100)
        console.add_output("line1")
        console.add_output("line2")
        console.clear_history()
        expect(console.get_history().len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "trims history to max_history":
        # @req: REQ-ENGINE-Console-001
        step("Verify: trims history to max_history")
        var console = GameConsole.new(3)
        console.add_output("a")
        console.add_output("b")
        console.add_output("c")
        console.add_output("d")
        val hist = console.get_history()
        expect(hist.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(hist[0].content).to_equal("b")

    it "registers multiple commands":
        # @req: REQ-ENGINE-Console-001
        step("Verify: registers multiple commands")
        var console = GameConsole.new(100)
        console.register_command("help", "Show help")
        console.register_command("quit", "Exit game")
        console.register_command("stats", "Show stats")
        expect(console.command_count()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(console.has_command("quit")).to_equal(true)
        expect(console.has_command("stats")).to_equal(true)
