"""
## Purpose and audience
Purpose: Prove that ObjectPool.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# Object Pool Tests

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.core.object_pool.{ObjectPool}

describe "ObjectPool":
    it "creates an empty pool":
        step("Verify: creates an empty pool")
        # @req: REQ-LIB-ENGINE-001
        val pool = ObjectPool.new(4)
        expect(pool.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "acquires a slot and returns index 0":
        step("Verify: acquires a slot and returns index 0")
        var pool = ObjectPool.new(4)
        val idx = pool.acquire("bullet")
        expect(idx).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pool.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "gets the tag of an acquired slot":
        step("Verify: gets the tag of an acquired slot")
        var pool = ObjectPool.new(4)
        val idx = pool.acquire("enemy")
        expect(pool.get_tag(idx)).to_equal("enemy")

    it "reports active status correctly":
        step("Verify: reports active status correctly")
        var pool = ObjectPool.new(4)
        val idx = pool.acquire("item")
        expect(pool.is_active(idx)).to_equal(true)

    it "releases a slot by index":
        step("Verify: releases a slot by index")
        var pool = ObjectPool.new(4)
        val idx = pool.acquire("bullet")
        pool.release(idx)
        expect(pool.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pool.is_active(idx)).to_equal(false)

    it "reuses released slots":
        step("Verify: reuses released slots")
        var pool = ObjectPool.new(4)
        val idx0 = pool.acquire("a")
        pool.acquire("b")
        pool.release(idx0)
        val idx2 = pool.acquire("c")
        expect(idx2).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pool.get_tag(idx2)).to_equal("c")

    it "returns -1 when pool is full":
        step("Verify: returns -1 when pool is full")
        var pool = ObjectPool.new(2)
        pool.acquire("a")
        pool.acquire("b")
        val idx = pool.acquire("c")
        expect(idx).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "releases all slots by tag":
        step("Verify: releases all slots by tag")
        var pool = ObjectPool.new(8)
        pool.acquire("bullet")
        pool.acquire("enemy")
        pool.acquire("bullet")
        pool.release_by_tag("bullet")
        expect(pool.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clears all slots":
        step("Verify: clears all slots")
        var pool = ObjectPool.new(4)
        pool.acquire("a")
        pool.acquire("b")
        pool.acquire("c")
        pool.clear()
        expect(pool.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "increments generation on reuse":
        step("Verify: increments generation on reuse")
        var pool = ObjectPool.new(2)
        val idx = pool.acquire("first")
        pool.release(idx)
        pool.acquire("second")
        expect(pool.slots[0].generation).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "starts live slots at generation 1 so generation 0 never validates":
        step("Verify: starts live slots at generation 1 so generation 0 never validates")
        var pool = ObjectPool.new(2)
        val idx = pool.acquire("first")
        expect(pool.generation_of(idx)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pool.is_valid(idx, 0)).to_equal(false)

    it "rejects stale generation handles after slot reuse":
        step("Verify: rejects stale generation handles after slot reuse")
        var pool = ObjectPool.new(2)
        val idx = pool.acquire("first")
        val gen = pool.generation_of(idx)
        expect(pool.is_valid(idx, gen)).to_equal(true)
        pool.release(idx)
        expect(pool.is_valid(idx, gen)).to_equal(false)
        pool.acquire("second")
        val gen2 = pool.generation_of(idx)
        expect(pool.is_valid(idx, gen)).to_equal(false)
        expect(pool.is_valid(idx, gen2)).to_equal(true)
        expect(pool.is_valid(-1, gen2)).to_equal(false)
