# Engine Units — Domain-specific custom type tests
#
# Tests the 12 unit types exported by std.common.engine.units:
# Seconds, Angle, Volume, ZIndex, KeyCode, MouseButtonId,
# Distance, ZoomLevel, TileCoord, TileIndex, Speed, Tolerance
#
# Contract note (2026-11): the unit classes are deliberately slim single-field
# wrappers — arithmetic/conversion happens on the raw `value`/`code` field at
# call sites. RGBA8 moved to std.common.engine.color as Rgba8; GamepadButtonId,
# PixelSize, and FrameIndex were removed from the engine units entirely.

"""
## Purpose and audience
Verifies the units behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, it, expect}
use std.common.engine.units.{Seconds, Angle, Volume, ZIndex, KeyCode, MouseButtonId, Distance, ZoomLevel, TileCoord, TileIndex, Speed, Tolerance}

# @req: REQ-ENGINE-Units-001
describe "Engine Units":
    describe "Seconds":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val s = Seconds(value: 1.5)
            expect(s.value).to_equal(1.5)  # oracle: value fixed by the spec contract

        it "creates zero Seconds":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates zero Seconds")
            val s = Seconds.zero()
            expect(s.value).to_equal(0.0)  # oracle: value fixed by the spec contract

    describe "Angle":
        it "creates with radians":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with radians")
            val a = Angle(radians: 3.14)
            expect(a.radians).to_equal(3.14)  # oracle: value fixed by the spec contract

        it "converts to degrees":
            # @req: REQ-ENGINE-Units-001
            step("Verify: converts to degrees")
            val a = Angle(radians: 1.0)
            val deg = a.to_degrees()
            expect(deg).to_be_greater_than(57.0)
            expect(deg).to_be_less_than(58.0)

        it "creates from degrees":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates from degrees")
            val a = Angle.from_degrees(180.0)
            expect(a.radians).to_be_greater_than(3.14)
            expect(a.radians).to_be_less_than(3.15)

        it "creates zero angle":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates zero angle")
            val a = Angle.zero()
            expect(a.radians).to_equal(0.0)  # oracle: value fixed by the spec contract

    describe "Volume":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val v = Volume(value: 0.8)
            expect(v.value).to_equal(0.8)  # oracle: value fixed by the spec contract

        it "creates full volume":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates full volume")
            val v = Volume.full()
            expect(v.value).to_equal(1.0)  # oracle: value fixed by the spec contract

        it "creates silent volume":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates silent volume")
            # Named `silent` in the current API (was `mute_vol`).
            val v = Volume.silent()
            expect(v.value).to_equal(0.0)  # oracle: value fixed by the spec contract

    describe "ZIndex":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val z = ZIndex(value: 5)
            expect(z.value).to_equal(5)  # oracle: value fixed by the spec contract

        it "creates zero ZIndex":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates zero ZIndex")
            val z = ZIndex.zero()
            expect(z.value).to_equal(0)  # oracle: value fixed by the spec contract

    describe "KeyCode":
        it "creates with code":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with code")
            val k = KeyCode(code: 65)
            expect(k.code).to_equal(65)  # oracle: value fixed by the spec contract

        it "creates unknown KeyCode":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates unknown KeyCode")
            val k = KeyCode.unknown()
            expect(k.code).to_equal(0)  # oracle: value fixed by the spec contract

    describe "MouseButtonId":
        it "creates with code":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with code")
            val m = MouseButtonId(code: 0)
            expect(m.code).to_equal(0)  # oracle: value fixed by the spec contract

        it "creates left right middle buttons":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates left right middle buttons")
            expect(MouseButtonId.left().code).to_equal(0)  # oracle: value fixed by the spec contract
            expect(MouseButtonId.right().code).to_equal(1)  # oracle: value fixed by the spec contract
            expect(MouseButtonId.middle().code).to_equal(2)  # oracle: value fixed by the spec contract

    describe "Distance":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val d = Distance(value: 100.0)
            expect(d.value).to_equal(100.0)  # oracle: value fixed by the spec contract

        it "creates zero Distance":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates zero Distance")
            val d = Distance.zero()
            expect(d.value).to_equal(0.0)  # oracle: value fixed by the spec contract

    describe "ZoomLevel":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val z = ZoomLevel(value: 2.0)
            expect(z.value).to_equal(2.0)  # oracle: value fixed by the spec contract

        it "creates default zoom":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates default zoom")
            val z = ZoomLevel.default_zoom()
            expect(z.value).to_equal(1.0)  # oracle: value fixed by the spec contract

    describe "TileCoord":
        it "creates with col and row":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with col and row")
            val t = TileCoord(col: 3, row: 7)
            expect(t.col).to_equal(3)  # oracle: value fixed by the spec contract
            expect(t.row).to_equal(7)  # oracle: value fixed by the spec contract

    describe "TileIndex":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val t = TileIndex(value: 42)
            expect(t.value).to_equal(42)  # oracle: value fixed by the spec contract

    describe "Speed":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val s = Speed(value: 5.5)
            expect(s.value).to_equal(5.5)  # oracle: value fixed by the spec contract

        it "creates zero Speed":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates zero Speed")
            val s = Speed.zero()
            expect(s.value).to_equal(0.0)  # oracle: value fixed by the spec contract

    describe "Tolerance":
        it "creates with value":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates with value")
            val t = Tolerance(value: 0.001)
            expect(t.value).to_equal(0.001)  # oracle: value fixed by the spec contract

        it "creates default tolerance":
            # @req: REQ-ENGINE-Units-001
            step("Verify: creates default tolerance")
            val t = Tolerance.default_tolerance()
            expect(t.value).to_equal(0.25)  # oracle: value fixed by the spec contract
