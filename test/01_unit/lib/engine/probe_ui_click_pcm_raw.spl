use std.nogc_sync_mut.engine.audio.ui_click_pcm_raw.{
    UI_CLICK_PCM_FRAME_COUNT,
    UI_CLICK_PCM_SAMPLE_COUNT,
    ui_click_pcm_create,
    ui_click_pcm_checksum,
    ui_click_pcm_release,
}

fn main() -> i64:
    if (UI_CLICK_PCM_FRAME_COUNT != 2880 or
        UI_CLICK_PCM_SAMPLE_COUNT != 5760):
        return 1
    val addr = ui_click_pcm_create()
    if addr == 0:
        return 2
    val checksum = ui_click_pcm_checksum(addr)
    ui_click_pcm_release(addr)
    if checksum == 0u64 or checksum == 1469598103934665603u64:
        return 3
    0
