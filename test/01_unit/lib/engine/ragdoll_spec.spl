"""
## Purpose and audience
Purpose: Prove that Ragdoll.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""Ragdoll Physics Tests"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.ragdoll.{Ragdoll, RagdollBone, RagdollJoint}

describe "Ragdoll":
    it "creates empty ragdoll":
        step("Verify: creates empty ragdoll")
        # @req: REQ-LIB-ENGINE-001
        var rd = Ragdoll.new("humanoid")
        expect(rd.name).to_equal("humanoid")
        expect(rd.bone_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(rd.joint_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(rd.is_active()).to_equal(false)

    it "adds bones":
        step("Verify: adds bones")
        var rd = Ragdoll.new("test")
        val i0 = rd.add_bone("spine", 0, 100, 5.0, 0.4)
        val i1 = rd.add_bone("head", 1, 101, 3.0, 0.2)
        expect(rd.bone_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(i0).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(i1).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "retrieves bone by index":
        step("Verify: retrieves bone by index")
        var rd = Ragdoll.new("test")
        rd.add_bone("torso", 0, 50, 10.0, 0.5)
        if val Some(b) = rd.get_bone(0):
            expect(b.name).to_equal("torso")
            expect(b.mass).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
        else:
            expect("bone missing").to_equal("bone found")

    it "returns nil for invalid bone index":
        step("Verify: returns nil for invalid bone index")
        var rd = Ragdoll.new("test")
        val result = rd.get_bone(99)
        # Can't use to_be_nil; check bone_count instead
        expect(rd.bone_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "adds joints":
        step("Verify: adds joints")
        var rd = Ragdoll.new("test")
        rd.add_bone("a", 0, 1, 5.0, 0.3)
        rd.add_bone("b", 1, 2, 3.0, 0.2)
        val ji = rd.add_joint(0, 1, -45.0, 45.0)
        expect(rd.joint_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(ji).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "activates and deactivates":
        step("Verify: activates and deactivates")
        var rd = Ragdoll.new("test")
        expect(rd.is_active()).to_equal(false)
        rd.activate()
        expect(rd.is_active()).to_equal(true)
        rd.deactivate()
        expect(rd.is_active()).to_equal(false)

    it "computes total mass":
        step("Verify: computes total mass")
        var rd = Ragdoll.new("test")
        rd.add_bone("a", 0, 1, 5.0, 0.3)
        rd.add_bone("b", 1, 2, 3.0, 0.2)
        rd.add_bone("c", 2, 3, 2.0, 0.1)
        expect(rd.total_mass()).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement

    it "total mass of empty ragdoll is zero":
        step("Verify: total mass of empty ragdoll is zero")
        var rd = Ragdoll.new("empty")
        expect(rd.total_mass()).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
