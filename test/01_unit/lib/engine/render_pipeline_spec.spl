"""
## Purpose and audience
Purpose: Prove that RenderPassConfig.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Render Pipeline — multi-pass pipeline configuration tests

Tests forward/deferred pipeline creation, pass insertion, removal,
enable/disable, active pass filtering, and stats.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.render_pipeline.{RenderPassConfig, RenderPipeline, PipelineStats}

describe "RenderPassConfig":
    it "creates with defaults":
        step("Verify: creates with defaults")
        # @req: REQ-LIB-ENGINE-001
        val cfg = RenderPassConfig.new("shadow", "shadow", 5)
        expect(cfg.name).to_equal("shadow")
        expect(cfg.pass_type).to_equal("shadow")
        expect(cfg.priority).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(cfg.enabled).to_equal(true)
        expect(cfg.clear_color).to_equal(true)
        expect(cfg.clear_depth).to_equal(true)

describe "RenderPipeline":
    it "forward creates 5 default passes":
        step("Verify: forward creates 5 default passes")
        val p = RenderPipeline.forward()
        expect(p.pass_count()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(p.is_deferred()).to_equal(false)

    it "deferred creates 6 default passes":
        step("Verify: deferred creates 6 default passes")
        val p = RenderPipeline.deferred()
        expect(p.pass_count()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(p.is_deferred()).to_equal(true)

    it "add_pass inserts sorted by priority":
        step("Verify: add_pass inserts sorted by priority")
        var p = RenderPipeline.forward()
        val custom = RenderPassConfig.new("custom_shadow", "shadow", 1)
        p.add_pass(custom)
        expect(p.pass_count()).to_equal(6)  # oracle: 6 — named expected value from the requirement
        # custom_shadow has priority 1, should be between geometry(0) and lighting(1->shifted)
        val active = p.get_active_passes()
        expect(active.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "remove_pass removes by name":
        step("Verify: remove_pass removes by name")
        var p = RenderPipeline.forward()
        val removed = p.remove_pass("debug")
        expect(removed).to_equal(true)
        expect(p.pass_count()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "remove_pass returns false for missing":
        step("Verify: remove_pass returns false for missing")
        var p = RenderPipeline.forward()
        val removed = p.remove_pass("nonexistent")
        expect(removed).to_equal(false)
        expect(p.pass_count()).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "set_pass_enabled disables a pass":
        step("Verify: set_pass_enabled disables a pass")
        var p = RenderPipeline.forward()
        val found = p.set_pass_enabled("debug", false)
        expect(found).to_equal(true)
        val active = p.get_active_passes()
        expect(active.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "set_pass_enabled returns false for missing":
        step("Verify: set_pass_enabled returns false for missing")
        var p = RenderPipeline.forward()
        val found = p.set_pass_enabled("nonexistent", false)
        expect(found).to_equal(false)

    it "get_pass returns config":
        step("Verify: get_pass returns config")
        val p = RenderPipeline.forward()
        val pass_cfg = p.get_pass("geometry")
        if val Some(cfg) = pass_cfg:
            expect(cfg.name).to_equal("geometry")
            expect(cfg.pass_type).to_equal("geometry")
            expect(cfg.priority).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "get_pass returns nil for missing":
        step("Verify: get_pass returns nil for missing")
        val p = RenderPipeline.forward()
        val pass_cfg = p.get_pass("nonexistent")
        expect(pass_cfg).to_equal(nil)

    it "get_active_passes returns enabled sorted":
        step("Verify: get_active_passes returns enabled sorted")
        var p = RenderPipeline.forward()
        p.set_pass_enabled("debug", false)
        p.set_pass_enabled("ui", false)
        val active = p.get_active_passes()
        expect(active.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "get_stats reports correct counts":
        step("Verify: get_stats reports correct counts")
        var p = RenderPipeline.deferred()
        p.set_pass_enabled("debug", false)
        val stats = p.get_stats()
        expect(stats.pass_count).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(stats.active_pass_count).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(stats.pipeline_type).to_equal("deferred")
