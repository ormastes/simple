"""
## Purpose and audience
Purpose: Prove that Destructible.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

# Destruction spec — mesh fracturing and fragment physics

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.destruction.{Destructible}

describe "Destructible":
    it "starts intact with full health":
        step("Verify: starts intact with full health")
        # @req: REQ-LIB-ENGINE-001
        val dest = Destructible.new("wall", 100.0)
        expect(dest.is_destroyed()).to_equal(false)
        expect(dest.get_health()).to_equal(100.0)  # oracle: 100.0 — named expected value from the requirement
        expect(dest.fragment_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "takes damage without destroying":
        step("Verify: takes damage without destroying")
        var dest = Destructible.new("wall", 100.0)
        val destroyed = dest.apply_damage(30.0)
        expect(destroyed).to_equal(false)
        expect(dest.get_health()).to_equal(70.0)  # oracle: 70.0 — named expected value from the requirement
        expect(dest.is_destroyed()).to_equal(false)

    it "destroys when health reaches zero":
        step("Verify: destroys when health reaches zero")
        var dest = Destructible.new("crate", 50.0)
        dest.add_fragment(0.0, 0.0, 0.0, 1.0)
        dest.add_fragment(1.0, 0.0, 0.0, 0.5)
        val destroyed = dest.apply_damage(60.0)
        expect(destroyed).to_equal(true)
        expect(dest.is_destroyed()).to_equal(true)
        expect(dest.get_health()).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "activates all fragments on destruction":
        step("Verify: activates all fragments on destruction")
        var dest = Destructible.new("pot", 10.0)
        dest.add_fragment(0.0, 0.0, 0.0, 1.0)
        dest.add_fragment(1.0, 0.0, 0.0, 0.5)
        dest.add_fragment(0.0, 1.0, 0.0, 0.5)
        expect(dest.active_fragment_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        dest.apply_damage(20.0)
        expect(dest.active_fragment_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "applies impulse to fragment":
        step("Verify: applies impulse to fragment")
        var dest = Destructible.new("box", 10.0)
        val fid = dest.add_fragment(0.0, 0.0, 0.0, 1.0)
        dest.apply_damage(20.0)
        dest.apply_impulse(fid, 5.0, 10.0, 0.0)
        dest.update(1.0)
        # Fragment should have moved by velocity * dt

    it "updates fragment positions over time":
        step("Verify: updates fragment positions over time")
        var dest = Destructible.new("vase", 10.0)
        dest.add_fragment(0.0, 0.0, 0.0, 1.0)
        dest.apply_damage(20.0)
        dest.apply_impulse(1, 2.0, 0.0, 0.0)
        dest.update(0.5)
        # Fragment moved 2.0 * 0.5 = 1.0 in x

    it "does not update fragments before destruction":
        step("Verify: does not update fragments before destruction")
        var dest = Destructible.new("shelf", 100.0)
        dest.add_fragment(0.0, 0.0, 0.0, 1.0)
        dest.apply_impulse(1, 10.0, 0.0, 0.0)
        dest.update(1.0)
        # Not destroyed, so no movement

    it "tracks fragment count":
        step("Verify: tracks fragment count")
        var dest = Destructible.new("column", 200.0)
        dest.add_fragment(0.0, 0.0, 0.0, 2.0)
        dest.add_fragment(0.0, 1.0, 0.0, 1.0)
        dest.add_fragment(0.0, 2.0, 0.0, 1.0)
        dest.add_fragment(0.0, 3.0, 0.0, 0.5)
        expect(dest.fragment_count()).to_equal(4)  # oracle: 4 — named expected value from the requirement
