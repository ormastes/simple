"""
## Purpose and audience
Purpose: Prove that Engine IDs.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine ID System — Generational Handle Tests

Tests RawHandle, NodeId, TextureId type-safe wrappers.
"""

use std.spec.{describe, it, expect}
use std.common.engine.ids.{Generation, RawHandle, NodeId, TextureId, SpriteId}

describe "Engine IDs":
    describe "Generation":
        it "compares equal generations":
            step("Verify: compares equal generations")
            # @req: REQ-LIB-ENGINE-001
            val g1 = Generation(value: 5)
            val g2 = Generation(value: 5)
            expect(g1.eq(g2)).to_equal(true)

        it "compares unequal generations":
            step("Verify: compares unequal generations")
            val g1 = Generation(value: 1)
            val g2 = Generation(value: 2)
            expect(g1.eq(g2)).to_equal(false)

    describe "RawHandle":
        it "creates a valid handle with new":
            step("Verify: creates a valid handle with new")
            val h = RawHandle.new(0, 1)
            expect(h.is_valid()).to_equal(true)
            expect(h.to_index()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates an invalid handle":
            step("Verify: creates an invalid handle")
            val h = RawHandle.invalid()
            expect(h.is_valid()).to_equal(false)

        it "compares equal handles":
            step("Verify: compares equal handles")
            val h1 = RawHandle.new(3, 2)
            val h2 = RawHandle.new(3, 2)
            expect(h1.eq(h2)).to_equal(true)

        it "compares different handles":
            step("Verify: compares different handles")
            val h1 = RawHandle.new(0, 1)
            val h2 = RawHandle.new(1, 1)
            expect(h1.eq(h2)).to_equal(false)

        it "detects generation mismatch":
            step("Verify: detects generation mismatch")
            val h1 = RawHandle.new(0, 1)
            val h2 = RawHandle.new(0, 2)
            expect(h1.eq(h2)).to_equal(false)

    describe "NodeId":
        it "wraps a valid RawHandle":
            step("Verify: wraps a valid RawHandle")
            val raw = RawHandle.new(5, 1)
            val nid = NodeId(raw: raw)
            expect(nid.is_valid()).to_equal(true)
            expect(nid.to_index()).to_equal(5)  # oracle: 5 — named expected value from the requirement

        it "creates an invalid NodeId":
            step("Verify: creates an invalid NodeId")
            val nid = NodeId.invalid()
            expect(nid.is_valid()).to_equal(false)

        it "compares equal NodeIds":
            step("Verify: compares equal NodeIds")
            val a = NodeId(raw: RawHandle.new(2, 3))
            val b = NodeId(raw: RawHandle.new(2, 3))
            expect(a.eq(b)).to_equal(true)

    describe "TextureId":
        it "wraps a valid RawHandle":
            step("Verify: wraps a valid RawHandle")
            val tid = TextureId(raw: RawHandle.new(0, 1))
            expect(tid.is_valid()).to_equal(true)
            expect(tid.to_index()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "creates an invalid TextureId":
            step("Verify: creates an invalid TextureId")
            val tid = TextureId.invalid()
            expect(tid.is_valid()).to_equal(false)

    describe "SpriteId":
        it "wraps a valid RawHandle":
            step("Verify: wraps a valid RawHandle")
            val sid = SpriteId(raw: RawHandle.new(7, 2))
            expect(sid.is_valid()).to_equal(true)
            expect(sid.to_index()).to_equal(7)  # oracle: 7 — named expected value from the requirement
