# Physics2 BVH2D — Unit Tests

"""
## Purpose and audience
Verifies the bvh2d behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.io_runtime
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.broadphase.bvh2d.{DynamicBvh2D, AABB2D, NULL_NODE}

# @req: REQ-PHYSICS2-Bvh2d-001
describe "DynamicBvh2D":
    it "empty tree has null root":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: empty tree has null root")
        val bvh = DynamicBvh2D.create(0.1)
        expect(bvh.root).to_equal(NULL_NODE)

    it "inserting one body sets root":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: inserting one body sets root")
        var bvh = DynamicBvh2D.create(0.1)
        val aabb = AABB2D(min_x: -1.0, min_y: -1.0, max_x: 1.0, max_y: 1.0)
        bvh.insert(aabb, 0)
        expect(bvh.root != NULL_NODE).to_equal(true)

    it "two non-overlapping produce no pairs":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: two non-overlapping produce no pairs")
        var bvh = DynamicBvh2D.create(0.0)
        val a = AABB2D(min_x: 0.0, min_y: 0.0, max_x: 1.0, max_y: 1.0)
        val b = AABB2D(min_x: 5.0, min_y: 5.0, max_x: 6.0, max_y: 6.0)
        bvh.insert(a, 0)
        bvh.insert(b, 1)
        val pairs = bvh.query_all_pairs()
        expect(pairs.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "two overlapping produce one pair":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: two overlapping produce one pair")
        var bvh = DynamicBvh2D.create(0.0)
        val a = AABB2D(min_x: 0.0, min_y: 0.0, max_x: 2.0, max_y: 2.0)
        val b = AABB2D(min_x: 1.0, min_y: 1.0, max_x: 3.0, max_y: 3.0)
        bvh.insert(a, 0)
        bvh.insert(b, 1)
        val pairs = bvh.query_all_pairs()
        expect(pairs.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "three bodies all overlapping produces three pairs":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: three bodies all overlapping produces three pairs")
        var bvh = DynamicBvh2D.create(0.0)
        val a = AABB2D(min_x: 0.0, min_y: 0.0, max_x: 2.0, max_y: 2.0)
        val b = AABB2D(min_x: 1.0, min_y: 1.0, max_x: 3.0, max_y: 3.0)
        val c = AABB2D(min_x: 2.0, min_y: 2.0, max_x: 4.0, max_y: 4.0)
        bvh.insert(a, 0)
        bvh.insert(b, 1)
        bvh.insert(c, 2)
        val pairs = bvh.query_all_pairs()
        expect(pairs.len()).to_equal(3)  # oracle: value fixed by the spec contract

    it "AABB overlap detection works":
        # @req: REQ-PHYSICS2-Bvh2d-001
        step("Verify: AABB overlap detection works")
        val a = AABB2D(min_x: 0.0, min_y: 0.0, max_x: 2.0, max_y: 2.0)
        val b = AABB2D(min_x: 1.5, min_y: 1.5, max_x: 3.0, max_y: 3.0)
        val c = AABB2D(min_x: 5.0, min_y: 5.0, max_x: 6.0, max_y: 6.0)
        expect(a.overlaps(b)).to_equal(true)
        expect(a.overlaps(c)).to_equal(false)
        expect(b.overlaps(c)).to_equal(false)
