# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Physics2 Raycast — Unit Tests

use std.spec.step

use std.io_runtime
use std.spec.{describe, it, expect}
use std.common.engine.ids.{NodeId, RawHandle}
use std.nogc_sync_mut.engine.physics.config.{default_physics_config_2d}
use std.nogc_sync_mut.engine.physics.world2d.{PhysicsWorld2D}
use std.nogc_sync_mut.engine.physics.simple.query.raycast2d.{raycast_2d}

fn make_node(idx: i64) -> NodeId:
    NodeId(raw: RawHandle.new(idx, 1))

describe "Raycast2D":
    # @manual scenario evidence
    it "hits a box collider":
        # @req REQ-SSPEC-UNIT
        step("hits a box collider")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_static_body(node, 5.0, 0.0)
        world.add_box_collider(node, 1.0, 1.0)
        val hit = raycast_2d(0.0, 0.0, 1.0, 0.0, 100.0, world.bodies, world.colliders)
        expect(hit.has_hit).to_equal(true)
        expect(hit.distance > 3.5).to_equal(true)
        expect(hit.distance < 4.5).to_equal(true)
        world.destroy()

    it "misses when ray points away":
        # @req REQ-SSPEC-UNIT
        step("misses when ray points away")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_static_body(node, 5.0, 0.0)
        world.add_box_collider(node, 1.0, 1.0)
        val hit = raycast_2d(0.0, 0.0, -1.0, 0.0, 100.0, world.bodies, world.colliders)
        expect(hit.has_hit).to_equal(false)
        world.destroy()

    it "hits circle collider":
        # @req REQ-SSPEC-UNIT
        step("hits circle collider")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        val node = make_node(1)
        world.add_static_body(node, 0.0, 5.0)
        world.add_circle_collider(node, 1.0)
        val hit = raycast_2d(0.0, 0.0, 0.0, 1.0, 100.0, world.bodies, world.colliders)
        expect(hit.has_hit).to_equal(true)
        expect(hit.distance > 3.5).to_equal(true)
        expect(hit.distance < 4.5).to_equal(true)
        world.destroy()

    it "returns closest hit":
        # @req REQ-SSPEC-UNIT
        step("returns closest hit")
        val config = default_physics_config_2d()
        var world = PhysicsWorld2D.create(config)
        world.add_static_body(make_node(1), 5.0, 0.0)
        world.add_box_collider(make_node(1), 0.5, 0.5)
        world.add_static_body(make_node(2), 10.0, 0.0)
        world.add_box_collider(make_node(2), 0.5, 0.5)
        val hit = raycast_2d(0.0, 0.0, 1.0, 0.0, 100.0, world.bodies, world.colliders)
        expect(hit.has_hit).to_equal(true)
        expect(hit.distance < 6.0).to_equal(true)
        world.destroy()
