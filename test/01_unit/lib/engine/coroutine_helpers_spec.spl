# Coroutine Helpers Tests

"""
## Purpose and audience
Verifies the coroutine helpers behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.core.coroutine_helpers.{WaitTimer, FrameCounter, ConditionWait}

# @req: REQ-ENGINE-CoroutineHelpers-001
describe "WaitTimer":
    it "creates a timer with duration":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: creates a timer with duration")
        val timer = WaitTimer.wait_seconds(2.0)
        expect(timer.is_done()).to_equal(false)
        expect(timer.elapsed).to_equal(0.0)  # oracle: value fixed by the spec contract
        expect(timer.duration).to_equal(2.0)  # oracle: value fixed by the spec contract

    it "advances with tick and returns false before done":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: advances with tick and returns false before done")
        var timer = WaitTimer.wait_seconds(1.0)
        val result = timer.tick(0.3)
        expect(result).to_equal(false)
        expect(timer.elapsed).to_equal(0.3)  # oracle: value fixed by the spec contract

    it "returns true when timer completes":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: returns true when timer completes")
        var timer = WaitTimer.wait_seconds(0.5)
        timer.tick(0.3)
        val result = timer.tick(0.3)
        expect(result).to_equal(true)
        expect(timer.is_done()).to_equal(true)

    it "clamps elapsed to duration":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: clamps elapsed to duration")
        var timer = WaitTimer.wait_seconds(1.0)
        timer.tick(2.0)
        expect(timer.elapsed).to_equal(1.0)  # oracle: value fixed by the spec contract

    it "reports progress from 0 to 1":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: reports progress from 0 to 1")
        var timer = WaitTimer.wait_seconds(2.0)
        expect(timer.progress()).to_equal(0.0)  # oracle: value fixed by the spec contract
        timer.tick(1.0)
        expect(timer.progress()).to_equal(0.5)  # oracle: value fixed by the spec contract
        timer.tick(1.0)
        expect(timer.progress()).to_equal(1.0)  # oracle: value fixed by the spec contract

    it "handles zero duration":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: handles zero duration")
        var timer = WaitTimer.wait_seconds(0.0)
        expect(timer.progress()).to_equal(1.0)  # oracle: value fixed by the spec contract

    it "stays done after completion":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: stays done after completion")
        var timer = WaitTimer.wait_seconds(0.1)
        timer.tick(0.2)
        val result = timer.tick(0.1)
        expect(result).to_equal(true)
        expect(timer.is_done()).to_equal(true)

describe "FrameCounter":
    it "creates a counter with target frames":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: creates a counter with target frames")
        val counter = FrameCounter.wait_frames(5)
        expect(counter.is_done()).to_equal(false)
        expect(counter.current).to_equal(0)  # oracle: value fixed by the spec contract
        expect(counter.target).to_equal(5)  # oracle: value fixed by the spec contract

    it "advances by one frame per tick":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: advances by one frame per tick")
        var counter = FrameCounter.wait_frames(3)
        val r1 = counter.tick()
        expect(r1).to_equal(false)
        expect(counter.current).to_equal(1)  # oracle: value fixed by the spec contract

    it "returns true when target reached":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: returns true when target reached")
        var counter = FrameCounter.wait_frames(2)
        counter.tick()
        val result = counter.tick()
        expect(result).to_equal(true)
        expect(counter.is_done()).to_equal(true)

    it "stays done after completion":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: stays done after completion")
        var counter = FrameCounter.wait_frames(1)
        counter.tick()
        val result = counter.tick()
        expect(result).to_equal(true)

describe "ConditionWait":
    it "stores a condition function name":
        # @req: REQ-ENGINE-CoroutineHelpers-001
        step("Verify: stores a condition function name")
        val cw = ConditionWait(check_fn_name: "is_level_loaded", done: false)
        expect(cw.check_fn_name).to_equal("is_level_loaded")
        expect(cw.done).to_equal(false)
