"""
## Purpose and audience
Purpose: Prove that ImageData.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine ImageData Tests

Tests ImageData struct construction, validity, pixel_count, and size_bytes.
Does not test FFI extern functions (those require runtime).
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.image_ffi.{ImageData, create_image_data}

describe "ImageData":
    describe "create_image_data":
        it "creates with correct dimensions":
            step("Verify: creates with correct dimensions")
            # @req: REQ-LIB-ENGINE-001
            val img = create_image_data(32, 16, [])
            expect(img.width).to_equal(32)  # oracle: 32 — named expected value from the requirement
            expect(img.height).to_equal(16)  # oracle: 16 — named expected value from the requirement

        it "defaults to 4 channels (RGBA)":
            step("Verify: defaults to 4 channels (RGBA)")
            val img = create_image_data(8, 8, [])
            expect(img.channels).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "stores pixel data":
            step("Verify: stores pixel data")
            val pixels: [i64] = [255, 0, 128, 64]
            val img = create_image_data(2, 2, pixels)
            expect(img.pixels.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    describe "is_valid":
        it "returns true for positive dimensions":
            step("Verify: returns true for positive dimensions")
            val img = create_image_data(10, 20, [])
            expect(img.is_valid()).to_equal(true)

        it "returns false for zero width":
            step("Verify: returns false for zero width")
            val img = ImageData(width: 0, height: 10, channels: 4, pixels: [])
            expect(img.is_valid()).to_equal(false)

        it "returns false for zero height":
            step("Verify: returns false for zero height")
            val img = ImageData(width: 10, height: 0, channels: 4, pixels: [])
            expect(img.is_valid()).to_equal(false)

        it "returns false for zero width and zero height":
            step("Verify: returns false for zero width and zero height")
            val img = ImageData(width: 0, height: 0, channels: 4, pixels: [])
            expect(img.is_valid()).to_equal(false)

    describe "pixel_count":
        it "returns width times height":
            step("Verify: returns width times height")
            val img = create_image_data(8, 4, [])
            expect(img.pixel_count()).to_equal(32)  # oracle: 32 — named expected value from the requirement

        it "returns zero for zero-dimension image":
            step("Verify: returns zero for zero-dimension image")
            val img = ImageData(width: 0, height: 5, channels: 4, pixels: [])
            expect(img.pixel_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    describe "size_bytes":
        it "returns width times height times channels":
            step("Verify: returns width times height times channels")
            val img = create_image_data(10, 10, [])
            # 10 * 10 * 4 = 400
            expect(img.size_bytes()).to_equal(400)  # oracle: 400 — named expected value from the requirement

        it "respects channel count":
            step("Verify: respects channel count")
            val img = ImageData(width: 4, height: 4, channels: 3, pixels: [])
            # 4 * 4 * 3 = 48
            expect(img.size_bytes()).to_equal(48)  # oracle: 48 — named expected value from the requirement

        it "returns zero for invalid image":
            step("Verify: returns zero for invalid image")
            val img = ImageData(width: 0, height: 10, channels: 4, pixels: [])
            expect(img.size_bytes()).to_equal(0)  # oracle: 0 — named expected value from the requirement
