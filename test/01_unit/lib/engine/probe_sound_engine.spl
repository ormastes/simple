use std.common.engine.audio.sound_contract.{SoundBackendCapability}
use std.nogc_sync_mut.engine.audio.sound_engine.{SoundEngine}

fn main() -> i64:
    var engine = SoundEngine(
        capability: SoundBackendCapability(
            platform: "ci",
            status: "portable",
            backend: "no-audio",
            reason: "deterministic test backend"
        ),
        command_log: [],
        teardown_count: 0,
        device_started: false,
        device_handle: 0,
        playback_handles: [],
        mixed_pcm_frames: 0,
        mixed_pcm_checksum: 0u64,
        underrun_count: 0
    )
    if engine.play_ui_click():
        print "FAIL no-audio playback"
        return 1
    if engine.mixed_pcm_frames != 2880:
        print "FAIL pcm frame count"
        return 2
    if engine.mixed_pcm_checksum == 0u64:
        print "FAIL pcm checksum"
        return 3
    engine.teardown()
    engine.teardown()
    if engine.device_started or engine.device_handle != 0:
        print "FAIL idempotent teardown"
        return 4
    print "SOUND ENGINE PROBE: PASS"
    0
