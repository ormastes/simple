"""
## Purpose and audience
Purpose: Prove that CharacterConfig.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Engine Character Controller — CharacterController Tests

Tests character movement, gravity, jumping, ground detection, and slope handling.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.physics.character_controller.{
    GroundInfo, CharacterConfig, CharacterController
}

describe "CharacterConfig":
    it "creates default config":
        step("Verify: creates default config")
        # @req: REQ-LIB-ENGINE-001
        val cfg = CharacterConfig.default_config()
        expect(cfg.step_height).to_equal(0.3)  # oracle: 0.3 — named expected value from the requirement
        expect(cfg.slope_limit).to_equal(45.0)  # oracle: 45.0 — named expected value from the requirement
        expect(cfg.skin_width).to_equal(0.01)  # oracle: 0.01 — named expected value from the requirement
        expect(cfg.gravity).to_equal(9.81)  # oracle: 9.81 — named expected value from the requirement

describe "CharacterController":
    it "initializes at given position":
        step("Verify: initializes at given position")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(5.0, 10.0, cfg)
        expect(ctrl.get_position_x()).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement
        expect(ctrl.get_position_y()).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement
        expect(ctrl.is_grounded()).to_equal(false)

    it "moves by displacement":
        step("Verify: moves by displacement")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.move_by(3.0, 4.0)
        expect(ctrl.get_position_x()).to_equal(3.0)  # oracle: 3.0 — named expected value from the requirement
        expect(ctrl.get_position_y()).to_equal(4.0)  # oracle: 4.0 — named expected value from the requirement

    it "applies gravity when airborne":
        step("Verify: applies gravity when airborne")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.apply_gravity(1.0)
        expect(ctrl.velocity_y).to_equal(9.81)  # oracle: 9.81 — named expected value from the requirement

    it "does not apply gravity when grounded":
        step("Verify: does not apply gravity when grounded")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_grounded(true, 0.0, 0.0, 1.0)
        ctrl.apply_gravity(1.0)
        expect(ctrl.velocity_y).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "updates position from velocity":
        step("Verify: updates position from velocity")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_velocity(10.0, 0.0)
        ctrl.update(0.5)
        expect(ctrl.get_position_x()).to_equal(5.0)  # oracle: 5.0 — named expected value from the requirement

    it "sets grounded and zeros velocity_y":
        step("Verify: sets grounded and zeros velocity_y")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_velocity(0.0, 20.0)
        ctrl.set_grounded(true, 10.0, 0.0, 1.0)
        expect(ctrl.is_grounded()).to_equal(true)
        expect(ctrl.velocity_y).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(ctrl.get_slope_angle()).to_equal(10.0)  # oracle: 10.0 — named expected value from the requirement

    it "jumps when grounded":
        step("Verify: jumps when grounded")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_grounded(true, 0.0, 0.0, 1.0)
        ctrl.jump(5.0)
        expect(ctrl.velocity_y).to_equal(-5.0)  # oracle: -5.0 — named expected value from the requirement

    it "does not jump when airborne":
        step("Verify: does not jump when airborne")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.jump(5.0)
        expect(ctrl.velocity_y).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement

    it "checks climbable slope":
        step("Verify: checks climbable slope")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_grounded(true, 30.0, 0.0, 1.0)
        expect(ctrl.can_climb_slope()).to_equal(true)

    it "rejects steep slope":
        step("Verify: rejects steep slope")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_grounded(true, 60.0, 0.0, 1.0)
        expect(ctrl.can_climb_slope()).to_equal(false)

    it "stops all velocity":
        step("Verify: stops all velocity")
        val cfg = CharacterConfig.default_config()
        var ctrl = CharacterController.new(0.0, 0.0, cfg)
        ctrl.set_velocity(5.0, 10.0)
        ctrl.stop()
        expect(ctrl.velocity_x).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
        expect(ctrl.velocity_y).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
