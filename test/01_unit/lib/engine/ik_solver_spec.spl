"""IK Solver — FABRIK Tests"""
## Purpose and audience

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.animation.ik_solver.{IKChain, IKJoint}

# @req: REQ-ENGINE-IkSolver-001
describe "IKChain":
    it "creates empty chain":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: creates empty chain")
        var chain = IKChain.new(0.01, 10)
        expect(chain.joint_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "adds joints":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: adds joints")
        var chain = IKChain.new(0.01, 10)
        chain.add_joint(0.0, 0.0, 1.0)
        chain.add_joint(1.0, 0.0, 1.0)
        chain.add_joint(2.0, 0.0, 0.0)
        expect(chain.joint_count()).to_equal(3)  # oracle: value fixed by the spec contract

    it "computes total chain length":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: computes total chain length")
        var chain = IKChain.new(0.01, 10)
        chain.add_joint(0.0, 0.0, 2.0)
        chain.add_joint(2.0, 0.0, 3.0)
        chain.add_joint(5.0, 0.0, 0.0)
        expect(chain.total_chain_length()).to_equal(5.0)  # oracle: value fixed by the spec contract

    it "returns end effector position":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: returns end effector position")
        var chain = IKChain.new(0.01, 10)
        chain.add_joint(0.0, 0.0, 1.0)
        chain.add_joint(1.0, 0.0, 1.0)
        chain.add_joint(2.0, 0.0, 0.0)
        expect(chain.end_effector_x()).to_equal(2.0)  # oracle: value fixed by the spec contract
        expect(chain.end_effector_y()).to_equal(0.0)  # oracle: value fixed by the spec contract

    it "solves reachable target":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: solves reachable target")
        var chain = IKChain.new(0.1, 20)
        chain.add_joint(0.0, 0.0, 1.0)
        chain.add_joint(1.0, 0.0, 1.0)
        chain.add_joint(2.0, 0.0, 0.0)
        val ok = chain.solve(1.5, 1.0)
        # End effector should be near target
        val ex = chain.end_effector_x()
        val ey = chain.end_effector_y()
        expect(ex).to_be_greater_than(1.0)
        expect(ey).to_be_greater_than(0.5)

    it "returns false for unreachable target":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: returns false for unreachable target")
        var chain = IKChain.new(0.01, 10)
        chain.add_joint(0.0, 0.0, 1.0)
        chain.add_joint(1.0, 0.0, 1.0)
        chain.add_joint(2.0, 0.0, 0.0)
        val ok = chain.solve(100.0, 0.0)
        expect(ok).to_equal(false)

    it "preserves root position after solve":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: preserves root position after solve")
        var chain = IKChain.new(0.1, 20)
        chain.add_joint(0.0, 0.0, 1.0)
        chain.add_joint(1.0, 0.0, 1.0)
        chain.add_joint(2.0, 0.0, 0.0)
        chain.solve(1.5, 1.0)
        if val Some(root) = chain.get_joint(0):
            expect(root.x).to_equal(0.0)  # oracle: value fixed by the spec contract
            expect(root.y).to_equal(0.0)  # oracle: value fixed by the spec contract

    it "returns false for chain with less than 2 joints":
        # @req: REQ-ENGINE-IkSolver-001
        step("Verify: returns false for chain with less than 2 joints")
        var chain = IKChain.new(0.01, 10)
        chain.add_joint(0.0, 0.0, 1.0)
        val ok = chain.solve(1.0, 0.0)
        expect(ok).to_equal(false)
