"""
## Purpose and audience
Purpose: Prove that Scene3DLayer.create.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-ENGINE-001 — stable requirement identity for this spec.

"""
Scene3DLayer pure-decision tests (interpreter-green).

Covers the 3D↔compositor adapter's pure decision logic WITHOUT constructing a
LayerTree or List: default/explicit z-index, geometry fields, z-index mutation
via the me-method, the derived display entry, and the back-to-front z ordering
oracle.

LayerTree attach/composite integration (the List-backed path) is covered by the
compiled GUI sanity lane, not here: interpreter List construction is broken
(`List<T>()` returns nil in the seed interpreter). See bug doc
`doc/08_tracking/bug/interpreter_list_generic_nil_2026-06-12.md`.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.engine.render.surface_layer.{Scene3DLayer, z_paint_order}

describe "Scene3DLayer.create":
    it "defaults z_index to 0 and exposes target geometry":
        step("Verify: defaults z_index to 0 and exposes target geometry")
        # @req: REQ-LIB-ENGINE-001
        val scene = Scene3DLayer.create(42, 1280, 720, 0)
        expect(scene.target_id).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(scene.z_index).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(scene.width).to_equal(1280)  # oracle: 1280 — named expected value from the requirement
        expect(scene.height).to_equal(720)  # oracle: 720 — named expected value from the requirement

    it "carries an explicit z-index":
        step("Verify: carries an explicit z-index")
        val scene = Scene3DLayer.create(7, 640, 480, 3)
        expect(scene.target_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(scene.z_index).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(scene.width).to_equal(640)  # oracle: 640 — named expected value from the requirement
        expect(scene.height).to_equal(480)  # oracle: 480 — named expected value from the requirement

    it "updates z_index via the me-method":
        step("Verify: updates z_index via the me-method")
        var scene = Scene3DLayer.create(7, 640, 480, 0)
        scene.set_z_index(20)
        expect(scene.z_index).to_equal(20)  # oracle: 20 — named expected value from the requirement

describe "Scene3DLayer.display_entry":
    it "derives a display entry at the adapter's z-index using target_id when unattached":
        step("Verify: derives a display entry at the adapter's z-index using target_id when unattached")
        val scene = Scene3DLayer.create(99, 800, 600, 5)
        val entry = scene.display_entry()
        expect(entry.id).to_equal(99)  # oracle: 99 — named expected value from the requirement
        expect(entry.z_index).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "tracks z-index changes in the derived entry":
        step("Verify: tracks z-index changes in the derived entry")
        var scene = Scene3DLayer.create(11, 320, 240, 0)
        scene.set_z_index(-2)
        val entry = scene.display_entry()
        expect(entry.id).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(entry.z_index).to_equal(-2)  # oracle: -2 — named expected value from the requirement

describe "z_paint_order":
    it "sorts z-index values ascending = back-to-front":
        step("Verify: sorts z-index values ascending = back-to-front")
        val ordered = z_paint_order([10, -5, 0])
        expect(ordered.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(ordered[0]).to_equal(-5)  # oracle: -5 — named expected value from the requirement
        expect(ordered[1]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ordered[2]).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "leaves the input array unchanged (value-type copy)":
        step("Verify: leaves the input array unchanged (value-type copy)")
        val src = [10, -5, 0]
        val ordered = z_paint_order(src)
        expect(ordered[0]).to_equal(-5)  # oracle: -5 — named expected value from the requirement
        expect(src[0]).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(src[1]).to_equal(-5)  # oracle: -5 — named expected value from the requirement
        expect(src[2]).to_equal(0)  # oracle: 0 — named expected value from the requirement
