# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, assert_equal}


# Vacuity probe for gap 6 (bare `min`/`max`/`abs` under
# `SIMPLE_EXECUTION_MODE=jit`): before the fix, HIR lowering routed these
# three builtins through the same generic "call an external symbol named
# after the builtin" path as `sqrt`/`floor`/`ceil`/`pow` — but unlike those,
# no runtime or libc symbol literally named `min`/`max`/`abs` exists, so the
# cranelift/JIT backend failed with `unresolved external symbol 'min'`
# (`[jit-fallback]`, or a hard error under `SIMPLE_JIT_STRICT=1`). This spec
# pins the intended behavior (matches the interpreter's own contract in
# `interpreter_extern/math.rs`: 2-arg min/max, 1-arg abs, i64) so a
# regression in the MIR-level lowering (`lower_min_max_abs` in
# `mir/lower/lowering_expr_builtin.rs`) is caught under whichever engine
# runs this suite. Confirmed under `SIMPLE_EXECUTION_MODE=jit
# SIMPLE_JIT_STRICT=1` directly against the real web-pipeline repro that the
# unresolved-symbol error is gone post-fix (see
# doc/08_tracking/bug/jit_drawirrendertarget_moduleresolver_gap_2026-07-30.md).
describe "builtin min/max/abs (bare-function form)":
    # @manual scenario evidence
    it "min returns the smaller of two ints, either order":
        # @req REQ-SSPEC-UNIT
        step("min returns the smaller of two ints, either order")
        assert_equal(min(3, 7), 3)
        assert_equal(min(7, 3), 3)

    it "min handles negatives and ties":
        # @req REQ-SSPEC-UNIT
        step("min handles negatives and ties")
        assert_equal(min(-5, 5), -5)
        assert_equal(min(5, 5), 5)

    it "max returns the larger of two ints, either order":
        # @req REQ-SSPEC-UNIT
        step("max returns the larger of two ints, either order")
        assert_equal(max(3, 7), 7)
        assert_equal(max(7, 3), 7)

    it "max handles negatives and ties":
        # @req REQ-SSPEC-UNIT
        step("max handles negatives and ties")
        assert_equal(max(-5, 5), 5)
        assert_equal(max(5, 5), 5)

    it "abs returns the magnitude, zero and large values included":
        # @req REQ-SSPEC-UNIT
        step("abs returns the magnitude, zero and large values included")
        assert_equal(abs(5), 5)
        assert_equal(abs(-5), 5)
        assert_equal(abs(0), 0)
        assert_equal(abs(-9223372036854775807), 9223372036854775807)

    it "matches the exact site that motivated this fix: clamping to a deadline":
        # @req REQ-SSPEC-UNIT
        step("matches the exact site that motivated this fix: clamping to a deadline")
        val current_time_ms = 1000
        val end_ms = 1010
        assert_equal(min(current_time_ms + 16, end_ms), 1010)
        val current_time_ms2 = 1000
        val end_ms2 = 2000
        assert_equal(min(current_time_ms2 + 16, end_ms2), 1016)
