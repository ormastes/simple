use std.spec.{describe, it, assert_equal}

# Regression pin for gap 7 in the JIT web-pipeline chase (2026-07-30):
# `showcase_resolution_dims()` (examples/06_io/ui/web_render_file_gui.spl)
# parses "480x360" via `parts[0].trim().to_i64()` / `parts[1].trim().to_i64()`
# and used to return visibly correct dims under the interpreter but silently
# wrong, large-magnitude garbage under `SIMPLE_EXECUTION_MODE=jit` (no
# crash, no `[jit-fallback]`, no unresolved-symbol error — SIMPLE_JIT_STRICT
# has nothing to catch here since nothing fails to link).
#
# FIXED (2026-07-30, same day): root cause was a missing `types_map` arm in
# `codegen/instr/body.rs`'s pre-pass — the dest VReg of a `MethodCallStatic`
# for "trim"/"trim_start"/"trim_end"/"appended"/"prepended" was never typed
# STRING, so a call CHAINED directly off one of these (no intermediate
# `val`) reached the outer dispatch with an untyped receiver and
# mis-resolved. Confirmed via a full before/after `simple run` transcript
# on BOTH the canonical deployed binary (bug reproduces identically there,
# not an artifact of any one build) and the fixed build (matches the
# interpreter exactly, including a 3rd chained occurrence landing exactly
# 64 bytes from the 1st — the address/missing-load signature that pointed
# at this bug). See the doc for the full transcript and hex deltas.
#
# NOT fully fixed: the real `showcase_resolution_dims()` call site assigns
# its result to a MODULE-LEVEL `val` (`val SHOWCASE_DIMS = ...`), and
# module-level `val`s initialized via ANY function call (not just this
# chained-method pattern — even a trivial `fn f() -> i32: 480` assigned to
# a global) independently read as `0` under JIT. That is a separate, larger
# bug (documented in the doc update, not this spec, not fixed here) that
# still blocks the real file from producing a non-degenerate result even
# with this fix landed.
#
# IMPORTANT — this spec does NOT vacuity-probe the JIT bug, fixed or not.
# `simple test` never routes through the cranelift/JIT backend even under
# `SIMPLE_EXECUTION_MODE=jit` (proved for gap 6, the same conclusion holds
# here — confirmed directly: this spec passes identically regardless of
# whether the fix is present). It only pins the INTENDED behavior, which
# the interpreter already got right even before the fix. The only real
# evidence for gap 7 (and its fix) is `simple run` under
# `SIMPLE_EXECUTION_MODE=jit SIMPLE_JIT_STRICT=1` on the minimal repro below
# (captured verbatim in
# doc/08_tracking/bug/jit_drawirrendertarget_moduleresolver_gap_2026-07-30.md):
#
#   fn main():
#       val a = "480"
#       val b = "360"
#       val pw = a.trim().to_i64()
#       val ph = b.trim().to_i64()
#       print "pw={pw} ph={ph}"
#
#   SIMPLE_EXECUTION_MODE=interpreter                  -> pw=480 ph=360 (always correct)
#   SIMPLE_EXECUTION_MODE=jit SIMPLE_JIT_STRICT=1 (pre-fix)  -> pw=<garbage> ph=<garbage>, exactly 32 apart
#   SIMPLE_EXECUTION_MODE=jit SIMPLE_JIT_STRICT=1 (post-fix) -> pw=480 ph=360 (matches interpreter)
describe "chained two-hop method calls ending in to_i64() (interpreter oracle)":
    it "parses a single trimmed numeric string":
        assert_equal("  480  ".trim().to_i64(), 480)

    it "parses two independent trimmed numeric strings in the same function":
        val pw = "480".trim().to_i64()
        val ph = "360".trim().to_i64()
        assert_equal(pw, 480)
        assert_equal(ph, 360)

    it "matches the exact motivating pattern: split + index + trim + to_i64":
        val parts = "480x360".split("x")
        val pw = parts[0].trim().to_i64()
        val ph = parts[1].trim().to_i64()
        assert_equal(pw, 480)
        assert_equal(ph, 360)

    it "generalizes beyond trim(): any text-returning hop before to_i64()":
        val pw = "480".lower().to_i64()
        val ph = "360".lower().to_i64()
        assert_equal(pw, 480)
        assert_equal(ph, 360)
