use std.spec.{describe, it, expect}
use std.nogc_async_mut.simd.fixed.{FixedVec, fixedvec_from_array}
use std.nogc_async_mut.simd.mask.{Mask}

describe "SIMD fixed scalar square root and mask identity":
    it "computes per-lane square root through the existing numeric owner":
        val vector = fixedvec_from_array([4.0, 16.0])
        val roots = vector.sqrt()
        expect(roots.elements[0]).to_equal(2.0)
        expect(roots.elements[1]).to_equal(4.0)
        val reciprocal = vector.recip_sqrt()
        expect(reciprocal.elements[0]).to_equal(0.5)
        expect(reciprocal.elements[1]).to_equal(0.25)

    it "preserves both mask bits and lane count without an undefined associated type":
        val original = Mask<FixedVec<f64>>(bits: 1, lane_count: 2)
        val copied = Mask<FixedVec<f64>>.from_cmp(original)
        expect(copied.bits).to_equal(1)
        expect(copied.lane_count).to_equal(2)
        expect(copied.any()).to_equal(true)
        expect(copied.all()).to_equal(false)
