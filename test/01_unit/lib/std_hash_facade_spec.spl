# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# std_hash_facade_spec
#
# `src/std` is a symlink to `lib`, so `src/lib/hash.spl` WINS the `std.hash`
# name and shadows the `nogc_async_mut_noalloc/hash/` package that previously
# answered it. The facade must therefore be a SUPERSET: the Hash trait (which
# `use std.hash` could not reach before the facade existed) AND the four
# allocation-free hash functions the shadowed package documented.
#
# Both directions are asserted here so a future facade edit cannot silently
# drop one half. See
# doc/08_tracking/bug/primitive_receiver_trait_impl_dispatch_2026-08-07.md

use std.spec.step

use std.spec
use std.spec.step
use std.hash.{Hash, hash_combine, hash_array, rt_hash_text}
use std.hash.{fnv1a_hash_bytes, fnv1a_hash_i64, crc32_byte, crc32_bytes}


struct FacadePoint:
    x: i64
    y: i64

impl Hash for FacadePoint:
    fn hash() -> i64:
        self.x * 31 + self.y

describe "std.hash facade — trait half":
    # @manual scenario evidence

    it "resolves the Hash trait through `use std.hash`":
        # @req REQ-SSPEC-LIB
        step("resolves the Hash trait through `use std.hash`")
        val p = FacadePoint(x: 2, y: 3)
        expect(p.hash()).to_equal(65)

    it "hashes text through the trait impl in hash.spl":
        # @req REQ-SSPEC-LIB
        step("hashes text through the trait impl in hash.spl")
        val h = "abc".hash()
        expect(h != 0).to_be_true()

    it "exposes hash_combine":
        # @req REQ-SSPEC-LIB
        step("exposes hash_combine")
        val combined = hash_combine(1, 2)
        expect(combined != 0).to_be_true()

describe "std.hash facade — function half must not be dropped":

    it "exposes hash_array":
        # @req REQ-SSPEC-LIB
        step("exposes hash_array")
        val h = hash_array([1, 2, 3])
        expect(h != 0).to_be_true()

    it "exposes rt_hash_text":
        # @req REQ-SSPEC-LIB
        step("exposes rt_hash_text")
        val a = rt_hash_text("a")
        val b = rt_hash_text("b")
        expect(a != b).to_be_true()

    # The four allocation-free functions of the SHADOWED
    # nogc_async_mut_noalloc/hash package are asserted below.
    #
    # HISTORY (kept — two lanes measured opposite results from sound runs):
    # `@noalloc` was never registered as a known annotation in any parser, so
    # the Rust seed interpreter treated an unrecognised `@X` on a function as a
    # Python-style runtime decorator and evaluated the bare identifier `X` in
    # the module env — hence `error: semantic: variable noalloc not found` on
    # `bin/simple test` (interpreter path) while `bin/simple run` (JIT path,
    # which never evaluates decorator expressions) succeeded. Fixed in the seed
    # 2026-08-08 (interpreter_eval.rs skip-list) and redeployed; the re-export
    # landed in src/lib/hash.spl afterwards. The assertions below are the guard
    # the facade bug record asked for — see
    # doc/08_tracking/bug/std_hash_facade_shadows_noalloc_hash_package_2026-08-08.md

    it "exposes the shadowed package's fnv1a_hash_i64":
        # @req REQ-SSPEC-LIB
        step("exposes the shadowed package's fnv1a_hash_i64")
        val a = fnv1a_hash_i64(42)
        val b = fnv1a_hash_i64(43)
        expect(a != 0).to_be_true()
        expect(a != b).to_be_true()

    it "exposes the shadowed package's fnv1a_hash_bytes":
        # @req REQ-SSPEC-LIB
        step("exposes the shadowed package's fnv1a_hash_bytes")
        val h = fnv1a_hash_bytes([97, 98, 99], 3)
        val g = fnv1a_hash_bytes([97, 98, 100], 3)
        expect(h != 0).to_be_true()
        expect(h != g).to_be_true()

    it "exposes the shadowed package's crc32_byte and crc32_bytes":
        # @req REQ-SSPEC-LIB
        step("exposes the shadowed package's crc32_byte and crc32_bytes")
        val cb = crc32_byte(0, 97)
        expect(cb != 0).to_be_true()
        val c1 = crc32_bytes([97, 98, 99], 3)
        val c2 = crc32_bytes([97, 98, 100], 3)
        expect(c1 != 0).to_be_true()
        expect(c1 != c2).to_be_true()
