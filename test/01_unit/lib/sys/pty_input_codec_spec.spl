"""
Portable text PTY adapter UTF-8 prefix boundaries. Pure production codec only;
no provider write, delivery or nonblocking capability is claimed.
# @manual: primary
Execution and documentation generation pending TEST_BLOCKED.
"""
use std.spec.{describe, it, expect, step}
use std.sys.pty_input_codec.{pty_input_prefix}
use std.common.text_bytes.{text_to_bytes}

describe "portable PTY input UTF-8 prefix codec":
    it "should retain a four byte emoji split by a 4096 byte write prefix":
        # @req REQ-SMUX-INPUT-002
        var ascii = ""
        var i = 0
        while i < 4095:
            ascii = ascii + "x"
            i = i + 1
        val bytes = text_to_bytes(ascii + "😀")
        step("Decode a bounded prefix ending after the emoji leading byte")
        val first = pty_input_prefix(bytes[0:4096])
        expect(first.is_ok()).to_equal(true)
        expect(first.unwrap().accepted).to_equal(4095)
        expect(first.unwrap().content).to_equal(ascii)
        step("Retry from the accepted byte count with the complete emoji")
        val next = pty_input_prefix(bytes[first.unwrap().accepted:])
        expect(next.is_ok()).to_equal(true)
        expect(next.unwrap().accepted).to_equal(4)
        expect(next.unwrap().content).to_equal("😀")

    it "should retain incomplete two byte and three byte endings":
        # @req REQ-SMUX-INPUT-002
        step("Trim only incomplete trailing scalar bytes")
        val two = pty_input_prefix([65, 195]).unwrap()
        expect(two.accepted).to_equal(1)
        expect(two.content).to_equal("A")
        val three_lead = pty_input_prefix([65, 231]).unwrap()
        expect(three_lead.accepted).to_equal(1)
        expect(three_lead.content).to_equal("A")
        val three_partial = pty_input_prefix([65, 231, 149]).unwrap()
        expect(three_partial.accepted).to_equal(1)
        expect(three_partial.content).to_equal("A")

    it "should retain every incomplete four byte ending":
        # @req REQ-SMUX-INPUT-002
        step("Trim one two or three bytes of an unfinished four byte scalar")
        expect(pty_input_prefix([65, 240]).unwrap().accepted).to_equal(1)
        expect(pty_input_prefix([65, 240, 159]).unwrap().accepted).to_equal(1)
        expect(pty_input_prefix([65, 240, 159, 152]).unwrap().accepted).to_equal(1)

    it "should accept complete two three and four byte scalars exactly":
        # @req REQ-SMUX-INPUT-002
        step("Validate complete UTF-8 and verify the original byte roundtrip")
        val bytes = text_to_bytes("é界😀")
        val prefix = pty_input_prefix(bytes)
        expect(prefix.is_ok()).to_equal(true)
        expect(prefix.unwrap().accepted).to_equal(9)
        expect(prefix.unwrap().content).to_equal("é界😀")
        expect(text_to_bytes(prefix.unwrap().content)).to_equal(bytes)

    it "should reject stray continuation invalid leads and broken continuations":
        # @req REQ-SMUX-INPUT-002
        step("Refuse malformed complete input instead of replacing bytes")
        expect(pty_input_prefix([128]).unwrap_err()).to_equal("invalid UTF-8 pty input")
        expect(pty_input_prefix([255]).unwrap_err()).to_equal("invalid UTF-8 pty input")
        expect(pty_input_prefix([195, 65]).unwrap_err()).to_equal("invalid UTF-8 pty input")
        expect(pty_input_prefix([65, 231, 149, 65]).unwrap_err()).to_equal("invalid UTF-8 pty input")

    it "should reject overlong surrogate and out of range scalar encodings":
        # @req REQ-SMUX-INPUT-002
        step("Validate scalar bounds before trimming or decoding")
        expect(pty_input_prefix([192, 175]).is_err()).to_equal(true)
        expect(pty_input_prefix([224, 128, 175]).is_err()).to_equal(true)
        expect(pty_input_prefix([237, 160, 128]).is_err()).to_equal(true)
        expect(pty_input_prefix([240, 128, 128, 175]).is_err()).to_equal(true)
        expect(pty_input_prefix([244, 144, 128, 128]).is_err()).to_equal(true)
        expect(pty_input_prefix([245, 128, 128, 128]).is_err()).to_equal(true)
        step("An already invalid partial scalar is refused rather than deferred")
        expect(pty_input_prefix([224, 128]).is_err()).to_equal(true)
        expect(pty_input_prefix([244, 144]).is_err()).to_equal(true)

    it "should return zero for empty input or an unfinished initial scalar":
        # @req REQ-SMUX-INPUT-002
        step("Keep pending bytes without inventing replacement text")
        val empty = pty_input_prefix([]).unwrap()
        expect(empty.accepted).to_equal(0)
        expect(empty.content).to_equal("")
        val partial = pty_input_prefix([240, 159, 152]).unwrap()
        expect(partial.accepted).to_equal(0)
        expect(partial.content).to_equal("")

    it "should accept valid replacement codepoints and scalar range endpoints":
        # @req REQ-SMUX-INPUT-002
        step("Distinguish explicitly encoded replacement text from malformed bytes")
        expect(pty_input_prefix([239, 191, 189]).unwrap().accepted).to_equal(3)
        expect(pty_input_prefix([224, 160, 128]).unwrap().accepted).to_equal(3)
        expect(pty_input_prefix([237, 159, 191]).unwrap().accepted).to_equal(3)
        expect(pty_input_prefix([240, 144, 128, 128]).unwrap().accepted).to_equal(4)
        expect(pty_input_prefix([244, 143, 191, 191]).unwrap().accepted).to_equal(4)
