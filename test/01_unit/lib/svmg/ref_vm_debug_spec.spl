# DBG-1 / PROF-1 debug semantics on the host reference VM (stream P5).
#
# Drives test/fixtures/svmg/debug_conformance_vectors.spl against `ref_vm`.
# The same table is what the CUDA/Vulkan/Metal wrappers will be diffed
# against, so the comparison here is deliberately field-for-field rather
# than "did it stop somewhere plausible": stop reason, sentinel, saved
# pc/sp/csp, saved operand stack, saved call stack, accumulated
# DBG_STEP_COUNT, and the cumulative log + records in the arena.
#
# One `it` per vector, so a regression names the failing scenario.
#
# The first describe block is the one that matters most: DBG_FLAGS == 0 must
# be byte-for-byte today's behavior. The full pre-existing conformance suite
# is the real gate for that (it runs with DBG_FLAGS == 0 throughout and must
# stay green), but these cases pin the specific observables — no debug
# break, a zero step count, and an untouched DBG block — so a regression is
# reported here in terms of DBG-1 rather than as a mystery failure in a
# vector about integer division.

use std.spipe.*
use std.common.svmg.assembler.{svmg_asm}
use std.common.svmg.mailbox_const.{
    DEFAULT_LOG_CAP, DBG_FLAG_ENABLED, DBG_FLAG_RESUME, DBG_FLAG_SINGLE_STEP,
    SENTINEL_DEBUG_BREAK, SENTINEL_EXIT_MASK,
}
use std.common.svmg.ref_vm.{
    build_arena, run_arena, assemble_and_run, read_log, read_records,
    dbg_set_flags, dbg_set_breakpoints, dbg_read_saved_pc, dbg_read_saved_sp,
    dbg_read_saved_csp, dbg_read_step_count, dbg_read_saved_stack_slot,
    dbg_read_saved_call_slot, dbg_read_flags,
}
use test.fixtures.svmg.debug_conformance_vectors.{DebugVector, DebugLaunch, all_debug_vectors}

fn _find(name: text) -> DebugVector:
    for vec in all_debug_vectors():
        if vec.name == name:
            return vec
    panic("svmg debug conformance: no vector named '{name}'")

fn _check_launch(v: DebugVector, launch_index: i64, lch: DebugLaunch, code: [u8], arena_in: [u8]) -> [u8]:
    var arena = arena_in
    if lch.set_breakpoints:
        arena = dbg_set_breakpoints(arena, lch.breakpoints)
    var flags = DBG_FLAG_ENABLED
    if lch.resume:
        flags = flags | DBG_FLAG_RESUME
    if lch.single_step:
        flags = flags | DBG_FLAG_SINGLE_STEP
    arena = dbg_set_flags(arena, flags)

    val r = run_arena(code, arena)
    val out = r.arena

    # --- stop reason ---
    assert_equal(r.debug_break, lch.expect_debug_break)
    assert_equal(r.trapped, lch.expect_trapped)
    assert_equal(r.timed_out, lch.expect_timed_out)
    assert_equal(r.sentinel, lch.expect_sentinel)

    # --- saved execution state, read back out of the arena (not out of the
    # in-memory VM), because the arena is the ONLY channel a device kernel
    # has to report it ---
    assert_equal(dbg_read_saved_pc(out), lch.expect_saved_pc)
    assert_equal(dbg_read_saved_sp(out), lch.expect_saved_sp)
    assert_equal(dbg_read_saved_csp(out), lch.expect_saved_csp)
    assert_equal(dbg_read_saved_sp(out), lch.expect_stack.len())
    assert_equal(dbg_read_saved_csp(out), lch.expect_calls.len())

    var i = 0
    while i < lch.expect_stack.len():
        assert_equal(dbg_read_saved_stack_slot(out, i), lch.expect_stack[i])
        i = i + 1
    i = 0
    while i < lch.expect_calls.len():
        assert_equal(dbg_read_saved_call_slot(out, i), lch.expect_calls[i])
        i = i + 1

    # --- PROF-1 step count, from both the result struct and the arena ---
    assert_equal(r.step_count, lch.expect_step_count)
    assert_equal(dbg_read_step_count(out), lch.expect_step_count)

    # --- cumulative mailbox side effects ---
    assert_equal(read_log(out, r.log_cap), lch.expect_log)
    assert_equal(r.record_count, lch.expect_records.len())
    val records = read_records(out, r.log_cap, r.record_count)
    i = 0
    while i < lch.expect_records.len():
        assert_equal(records[i].passed, lch.expect_records[i].passed)
        assert_equal(records[i].value, lch.expect_records[i].value)
        i = i + 1

    out

fn _check(name: text):
    val v = _find(name)
    val code = svmg_asm(v.source)
    var arena = build_arena(code, [], v.step_budget, v.entry_pc, DEFAULT_LOG_CAP)
    var idx = 0
    for lch in v.launches:
        arena = _check_launch(v, idx, lch, code, arena)
        idx = idx + 1
    # A session that asserted nothing would pass silently; require that the
    # vector actually ran the launches it declared.
    assert_equal(idx, v.launches.len())
    assert_true(idx > 0)

describe "DBG-1 inertness — DBG_FLAGS == 0 behaves exactly as before":

    it "a normal run reports no debug break and a zero step count":
        val r = assemble_and_run(svmg_asm("PUSHI 1\nPUSHI 5\nSYS_RESULT\nHALT 0"), 1000, 0)
        assert_equal(r.debug_break, false)
        assert_equal(r.step_count, 0)
        assert_equal(r.sentinel, SENTINEL_EXIT_MASK | 0)

    it "a normal run leaves the DBG-1 block completely untouched":
        val r = assemble_and_run(svmg_asm("PUSHI 1\nPUSHI 5\nSYS_RESULT\nHALT 0"), 1000, 0)
        assert_equal(dbg_read_flags(r.arena), 0)
        assert_equal(dbg_read_saved_pc(r.arena), 0)
        assert_equal(dbg_read_saved_sp(r.arena), 0)
        assert_equal(dbg_read_saved_csp(r.arena), 0)
        assert_equal(dbg_read_step_count(r.arena), 0)

    it "a timeout with debugging off still writes only the timeout sentinel":
        val r = assemble_and_run(svmg_asm("NOP\nJMP -4"), 5, 0)
        assert_equal(r.timed_out, true)
        assert_equal(r.debug_break, false)
        assert_equal(dbg_read_step_count(r.arena), 0)

describe "DBG-1 debug conformance vectors on ref_vm":

    it "break-at-pc stops before the breakpoint instruction and resumes to completion":
        _check("break_at_pc")

    it "single-step advances exactly one instruction per launch":
        _check("step_n")

    it "clearing the breakpoint table lets a resume run to completion":
        _check("resume_to_completion_after_clearing_breakpoints")

    it "a breakpoint inside a loop fires once per iteration with distinct state":
        _check("break_inside_loop")

    it "a resumed launch sees the log and records written before the break":
        _check("resume_with_persisted_arena")

    it "a break inside a subroutine preserves the call stack across the launch":
        _check("break_in_subroutine_preserves_call_stack")

    it "the step budget still expires while debugging, and state is still saved":
        _check("budget_expiry_while_debugging")

    it "a full breakpoint table honours its last entry":
        _check("breakpoint_table_full")

describe "PROF-1 step counting":

    it "DBG_STEP_COUNT equals the exact instruction count of a straight-line program":
        _check("step_count_accuracy_straightline")

    it "DBG_STEP_COUNT equals the exact instruction count of a looping program":
        _check("step_count_accuracy_loop")

    it "DBG_STEP_COUNT accumulates across resumes rather than resetting per launch":
        # The distinction PROF-1 exists for: `steps_used` is per-launch,
        # DBG_STEP_COUNT is per-program. Asserted directly here so the
        # difference is not merely implied by the vector table.
        val v = _find("break_at_pc")
        val code = svmg_asm(v.source)
        var arena = build_arena(code, [], v.step_budget, v.entry_pc, DEFAULT_LOG_CAP)
        arena = dbg_set_breakpoints(arena, [10])
        arena = dbg_set_flags(arena, DBG_FLAG_ENABLED)
        val first = run_arena(code, arena)
        assert_equal(first.step_count, 2)
        assert_equal(first.steps_used, 2)

        arena = dbg_set_flags(first.arena, DBG_FLAG_ENABLED | DBG_FLAG_RESUME)
        val second = run_arena(code, arena)
        # 5 instructions ran in the second launch...
        assert_equal(second.steps_used, 5)
        # ...but the program has executed 7 in total.
        assert_equal(second.step_count, 7)

describe "DBG-1 saved-state fidelity":

    it "saves negative operand-stack values as signed i32, not as a huge unsigned":
        val code = svmg_asm("PUSHI -7\nPUSHI 3\nADD\nHALT 0")
        var arena = build_arena(code, [], 1000, 0, DEFAULT_LOG_CAP)
        arena = dbg_set_flags(arena, DBG_FLAG_ENABLED | DBG_FLAG_SINGLE_STEP)
        val r = run_arena(code, arena)
        assert_equal(r.debug_break, true)
        assert_equal(r.sentinel, SENTINEL_DEBUG_BREAK)
        assert_equal(dbg_read_saved_sp(r.arena), 1)
        assert_equal(dbg_read_saved_stack_slot(r.arena, 0), -7)

    it "restores a negative operand-stack value correctly on resume":
        val code = svmg_asm("PUSHI -7\nPUSHI 3\nADD\nPUSHI 1\nSWAP\nSYS_RESULT\nHALT 0")
        var arena = build_arena(code, [], 1000, 0, DEFAULT_LOG_CAP)
        arena = dbg_set_breakpoints(arena, [5])
        arena = dbg_set_flags(arena, DBG_FLAG_ENABLED)
        val first = run_arena(code, arena)
        assert_equal(first.debug_break, true)
        assert_equal(dbg_read_saved_stack_slot(first.arena, 0), -7)

        arena = dbg_set_flags(first.arena, DBG_FLAG_ENABLED | DBG_FLAG_RESUME)
        val second = run_arena(code, arena)
        assert_equal(second.debug_break, false)
        assert_equal(second.record_count, 1)
        # -7 + 3 = -4, which only comes out right if the restore sign-extended.
        assert_equal(read_records(second.arena, second.log_cap, 1)[0].value, -4)
