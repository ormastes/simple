use std.nogc_sync_mut.smtp.send.{email_list_to_recipients as sync_recipients}
use std.nogc_async_mut.smtp.send.{email_list_to_recipients as async_recipients}
use std.gc_async_mut.smtp.send.{email_list_to_recipients as gc_recipients}

fn require_text_recipients(values: [text]) -> [text]:
    values

describe "SMTP recipient arrays preserve configured implementation families":
    it "trims nonempty recipients in the synchronous owner":
        val result = require_text_recipients(sync_recipients(" alice@example.test , , bob@example.test "))
        expect(result).to_equal(["alice@example.test", "bob@example.test"])

    it "uses the same concrete text element type in asynchronous owners":
        expect(require_text_recipients(async_recipients(" alice@example.test , bob@example.test "))).to_equal(["alice@example.test", "bob@example.test"])
        expect(require_text_recipients(gc_recipients(" alice@example.test , bob@example.test "))).to_equal(["alice@example.test", "bob@example.test"])

    it "omits empty and whitespace-only recipient segments":
        expect(require_text_recipients(sync_recipients(" , , "))).to_equal([])
        expect(require_text_recipients(async_recipients(""))).to_equal([])
        expect(require_text_recipients(gc_recipients("  "))).to_equal([])
