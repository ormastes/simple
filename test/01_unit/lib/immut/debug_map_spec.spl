# Debug VersionedSnapshot

"""
## Purpose and audience
Purpose: Verify Debug VersionedSnapshot.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-DEBUG-MAP-001 — stable requirement identity for this spec.

use std.versioned.{VersionedSnapshot, VersionedSnapshot__new, Snapshot}

use std.spec.step

describe "Debug VersionedSnapshot":
    it "snapshot get":
        step("Verify: snapshot get")
        # @req: REQ-LIB-DEBUG-MAP-001
        val vs = VersionedSnapshot.new(42)
        val snap = vs.snapshot()
        expect(snap.get()).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

    it "snapshot get_version":
        step("Verify: snapshot get_version")
        val vs = VersionedSnapshot.new(42)
        val snap = vs.snapshot()
        expect(snap.get_version()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "snapshot version field":
        step("Verify: snapshot version field")
        val vs = VersionedSnapshot.new(42)
        val snap = vs.snapshot()
        expect(snap.version).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "direct snapshot new":
        step("Verify: direct snapshot new")
        val snap = Snapshot(version: 0, value: 42)
        expect(snap.get()).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract
        expect(snap.get_version()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
