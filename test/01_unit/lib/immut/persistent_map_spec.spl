# PersistentMap Specification
#
# Comprehensive tests for the HAMT-based immutable PersistentMap.
# Covers construction, lookup, mutation (returns new map), removal,
# bulk operations, iteration, conversion, and persistence guarantees.

"""
## Purpose and audience
Purpose: Verify PersistentMap.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-PERSISTENT-MAP-001 — stable requirement identity for this spec.

use std.persistent_map.{PersistentMap, PersistentMap__empty, PersistentMap__from_entries, PersistentMap__from_dict}

use std.spec.step

describe "PersistentMap":

    describe "empty map":
        it "has zero length":
            step("Verify: has zero length")
            # @req: REQ-LIB-PERSISTENT-MAP-001
            val m = PersistentMap.empty()
            expect(m.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "is empty":
            step("Verify: is empty")
            val m = PersistentMap.empty()
            expect(m.is_empty()).to_equal(true)

        it "get returns nil for any key":
            step("Verify: get returns nil for any key")
            val m = PersistentMap.empty()
            expect(m.get("key")).to_be_nil()
            expect(m.get("anything")).to_be_nil()

        it "contains returns false for any key":
            step("Verify: contains returns false for any key")
            val m = PersistentMap.empty()
            expect(m.contains("x")).to_equal(false)

        it "keys returns empty array":
            step("Verify: keys returns empty array")
            val m = PersistentMap.empty()
            val k = m.keys()
            expect(k.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "values returns empty array":
            step("Verify: values returns empty array")
            val m = PersistentMap.empty()
            val v = m.values()
            expect(v.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "entries returns empty array":
            step("Verify: entries returns empty array")
            val m = PersistentMap.empty()
            val e = m.entries()
            expect(e.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "set and get":
        it "stores and retrieves a single value":
            step("Verify: stores and retrieves a single value")
            val m = PersistentMap.empty().set("a", 1)
            expect(m.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "returns new map on set - original unchanged":
            step("Verify: returns new map on set - original unchanged")
            val m1 = PersistentMap.empty()
            val m2 = m1.set("a", 1)
            expect(m1.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(m1.get("a")).to_be_nil()
            expect(m2.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "overwrites existing key with same length":
            step("Verify: overwrites existing key with same length")
            val m = PersistentMap.empty().set("a", 1).set("a", 2)
            expect(m.get("a")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "handles two keys":
            step("Verify: handles two keys")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            expect(m.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "handles three keys":
            step("Verify: handles three keys")
            val m = PersistentMap.empty().set("a", 1).set("b", 2).set("c", 3)
            expect(m.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("c")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "stores text values":
            step("Verify: stores text values")
            val m = PersistentMap.empty().set("name", "Alice")
            expect(m.get("name")).to_equal("Alice")

        it "stores integer keys":
            step("Verify: stores integer keys")
            val m = PersistentMap.empty().set(1, "one").set(2, "two")
            expect(m.get(1)).to_equal("one")
            expect(m.get(2)).to_equal("two")

        it "returns nil for missing key":
            step("Verify: returns nil for missing key")
            val m = PersistentMap.empty().set("a", 1)
            expect(m.get("b")).to_be_nil()

        it "is no longer empty after set":
            step("Verify: is no longer empty after set")
            val m = PersistentMap.empty().set("x", 42)
            expect(m.is_empty()).to_equal(false)

    describe "persistence across multiple sets":
        it "preserves snapshots":
            step("Verify: preserves snapshots")
            val m0 = PersistentMap.empty()
            val m1 = m0.set("a", 1)
            val m2 = m1.set("b", 2)
            val m3 = m2.set("c", 3)
            expect(m0.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(m1.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m3.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(m1.get("b")).to_be_nil()
            expect(m2.get("c")).to_be_nil()

        it "overwrite does not affect earlier version":
            step("Verify: overwrite does not affect earlier version")
            val m1 = PersistentMap.empty().set("key", "old")
            val m2 = m1.set("key", "new")
            expect(m1.get("key")).to_equal("old")
            expect(m2.get("key")).to_equal("new")

    describe "remove":
        it "removes an existing key":
            step("Verify: removes an existing key")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            val m2 = m.remove("a")
            expect(m2.get("a")).to_be_nil()
            expect(m2.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify original on remove":
            step("Verify: does not modify original on remove")
            val m1 = PersistentMap.empty().set("a", 1)
            val m2 = m1.remove("a")
            expect(m1.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m1.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.get("a")).to_be_nil()
            expect(m2.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "handles removing non-existent key":
            step("Verify: handles removing non-existent key")
            val m = PersistentMap.empty().set("a", 1)
            val m2 = m.remove("b")
            expect(m2.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "removes last key to get empty map":
            step("Verify: removes last key to get empty map")
            val m = PersistentMap.empty().set("only", 99)
            val m2 = m.remove("only")
            expect(m2.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.is_empty()).to_equal(true)

        it "removes from multi-key map":
            step("Verify: removes from multi-key map")
            val m = PersistentMap.empty().set("a", 1).set("b", 2).set("c", 3)
            val m2 = m.remove("b")
            expect(m2.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.get("b")).to_be_nil()
            expect(m2.get("c")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "contains":
        it "returns true for existing key":
            step("Verify: returns true for existing key")
            val m = PersistentMap.empty().set("x", 42)
            expect(m.contains("x")).to_equal(true)

        it "returns false for missing key":
            step("Verify: returns false for missing key")
            val m = PersistentMap.empty().set("x", 42)
            expect(m.contains("y")).to_equal(false)

        it "returns false after removal":
            step("Verify: returns false after removal")
            val m = PersistentMap.empty().set("x", 42).remove("x")
            expect(m.contains("x")).to_equal(false)

    describe "get_or":
        it "returns default for missing key":
            step("Verify: returns default for missing key")
            val m = PersistentMap.empty()
            expect(m.get_or("x", 42)).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

        it "returns value for existing key":
            step("Verify: returns value for existing key")
            val m = PersistentMap.empty().set("x", 10)
            expect(m.get_or("x", 42)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

        it "returns default with text fallback":
            step("Verify: returns default with text fallback")
            val m = PersistentMap.empty()
            expect(m.get_or("name", "unknown")).to_equal("unknown")

    describe "from_entries":
        it "builds from key-value pairs":
            step("Verify: builds from key-value pairs")
            val m = PersistentMap.from_entries([["a", 1], ["b", 2]])
            expect(m.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "handles empty entries":
            step("Verify: handles empty entries")
            val m = PersistentMap.from_entries([])
            expect(m.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.is_empty()).to_equal(true)

        it "handles single entry":
            step("Verify: handles single entry")
            val m = PersistentMap.from_entries([["only", 99]])
            expect(m.get("only")).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "last value wins for duplicate keys":
            step("Verify: last value wins for duplicate keys")
            val m = PersistentMap.from_entries([["a", 1], ["a", 2]])
            expect(m.get("a")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    describe "from_dict":
        it "builds from mutable dict":
            step("Verify: builds from mutable dict")
            var d = {}
            d["x"] = 10
            d["y"] = 20
            val m = PersistentMap.from_dict(d)
            expect(m.get("x")).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("y")).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "handles empty dict":
            step("Verify: handles empty dict")
            val d = {}
            val m = PersistentMap.from_dict(d)
            expect(m.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "keys and values":
        it "returns correct number of keys":
            step("Verify: returns correct number of keys")
            val m = PersistentMap.empty().set("x", 1).set("y", 2)
            val k = m.keys()
            expect(k.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "returns correct number of values":
            step("Verify: returns correct number of values")
            val m = PersistentMap.empty().set("x", 10).set("y", 20)
            val v = m.values()
            expect(v.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "single key map":
            step("Verify: single key map")
            val m = PersistentMap.empty().set("only", 42)
            val k = m.keys()
            val v = m.values()
            expect(k.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(v.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    describe "entries":
        it "returns key-value pairs":
            step("Verify: returns key-value pairs")
            val m = PersistentMap.empty().set("a", 1)
            val e = m.entries()
            expect(e.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            val pair = e[0]
            expect(pair[0]).to_equal("a")
            expect(pair[1]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "returns correct count for multi-entry map":
            step("Verify: returns correct count for multi-entry map")
            val m = PersistentMap.empty().set("a", 1).set("b", 2).set("c", 3)
            val e = m.entries()
            expect(e.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "merge":
        it "merges two disjoint maps":
            step("Verify: merges two disjoint maps")
            val m1 = PersistentMap.empty().set("a", 1)
            val m2 = PersistentMap.empty().set("b", 2)
            val merged = m1.merge(m2)
            expect(merged.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "other takes precedence on conflict":
            step("Verify: other takes precedence on conflict")
            val m1 = PersistentMap.empty().set("a", 1)
            val m2 = PersistentMap.empty().set("a", 99)
            val merged = m1.merge(m2)
            expect(merged.get("a")).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "merge with empty returns self":
            step("Verify: merge with empty returns self")
            val m1 = PersistentMap.empty().set("a", 1)
            val m2 = PersistentMap.empty()
            val merged = m1.merge(m2)
            expect(merged.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "empty merge with other returns other":
            step("Verify: empty merge with other returns other")
            val m1 = PersistentMap.empty()
            val m2 = PersistentMap.empty().set("b", 2)
            val merged = m1.merge(m2)
            expect(merged.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify originals":
            step("Verify: does not modify originals")
            val m1 = PersistentMap.empty().set("a", 1)
            val m2 = PersistentMap.empty().set("b", 2)
            val merged = m1.merge(m2)
            expect(m1.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(merged.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "filter":
        it "keeps entries matching predicate":
            step("Verify: keeps entries matching predicate")
            val m = PersistentMap.empty().set("a", 1).set("b", 2).set("c", 3)
            val filtered = m.filter(fn(k, v): v > 1)
            expect(filtered.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(filtered.get("a")).to_be_nil()
            expect(filtered.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(filtered.get("c")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "returns empty when nothing matches":
            step("Verify: returns empty when nothing matches")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            val filtered = m.filter(fn(k, v): v > 100)
            expect(filtered.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(filtered.is_empty()).to_equal(true)

        it "returns all when everything matches":
            step("Verify: returns all when everything matches")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            val filtered = m.filter(fn(k, v): v > 0)
            expect(filtered.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "map_values":
        it "transforms all values":
            step("Verify: transforms all values")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            val doubled = m.map_values(fn(v): v * 2)
            expect(doubled.get("a")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(doubled.get("b")).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(doubled.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "does not modify original":
            step("Verify: does not modify original")
            val m = PersistentMap.empty().set("a", 5)
            val mapped = m.map_values(fn(v): v + 10)
            expect(m.get("a")).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(mapped.get("a")).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract

    describe "fold":
        it "sums all values":
            step("Verify: sums all values")
            val m = PersistentMap.empty().set("a", 1).set("b", 2).set("c", 3)
            val total = m.fold(0, fn(acc, k, v): acc + v)
            expect(total).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract

        it "fold over empty returns init":
            step("Verify: fold over empty returns init")
            val m = PersistentMap.empty()
            val result = m.fold(42, fn(acc, k, v): acc + v)
            expect(result).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

    describe "update":
        it "updates existing key":
            step("Verify: updates existing key")
            val m = PersistentMap.empty().set("count", 5)
            val m2 = m.update("count", fn(v): v + 1)
            expect(m2.get("count")).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
            expect(m.get("count")).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract

        it "creates key when missing":
            step("Verify: creates key when missing")
            val m = PersistentMap.empty()
            val m2 = m.update("new", fn(v): 42)
            expect(m2.get("new")).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

    describe "copy":
        it "returns identical map":
            step("Verify: returns identical map")
            val m = PersistentMap.empty().set("a", 1).set("b", 2)
            val c = m.copy()
            expect(c.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(c.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "to_dict":
        it "converts to mutable dict":
            step("Verify: converts to mutable dict")
            val m = PersistentMap.empty().set("x", 10).set("y", 20)
            val d = m.to_dict()
            expect(d["x"]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(d["y"]).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract

        it "empty map converts to empty dict":
            step("Verify: empty map converts to empty dict")
            val m = PersistentMap.empty()
            val d = m.to_dict()
            expect(d.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "stress test":
        it "handles many elements via helper fn":
            step("Verify: handles many elements via helper fn")
            fn run_stress() -> i64:
                var m = PersistentMap.empty()
                var i = 0
                while i < 100:
                    m = m.set("key_{i}", i)
                    i = i + 1
                m.len()
            expect(run_stress()).to_equal(100)  # oracle: authoritative expected value documented by this spec's contract

        it "set and get many elements":
            step("Verify: set and get many elements")
            fn run_get_stress() -> i64:
                var m = PersistentMap.empty()
                var i = 0
                while i < 50:
                    m = m.set("k_{i}", i * 10)
                    i = i + 1
                var ok_count = 0
                i = 0
                while i < 50:
                    val v = m.get("k_{i}")
                    if v == i * 10:
                        ok_count = ok_count + 1
                    i = i + 1
                ok_count
            expect(run_get_stress()).to_equal(50)  # oracle: authoritative expected value documented by this spec's contract

        it "remove many elements":
            step("Verify: remove many elements")
            fn run_remove_stress() -> i64:
                var m = PersistentMap.empty()
                var i = 0
                while i < 30:
                    m = m.set("r_{i}", i)
                    i = i + 1
                i = 0
                while i < 15:
                    m = m.remove("r_{i}")
                    i = i + 1
                m.len()
            expect(run_remove_stress()).to_equal(15)  # oracle: authoritative expected value documented by this spec's contract

    describe "edge cases":
        it "set same key same value returns same map":
            step("Verify: set same key same value returns same map")
            val m = PersistentMap.empty().set("a", 1)
            val m2 = m.set("a", 1)
            expect(m2.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(m2.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "empty key string":
            step("Verify: empty key string")
            val m = PersistentMap.empty().set("", "empty_key")
            expect(m.get("")).to_equal("empty_key")
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "nil value stored and retrieved":
            step("Verify: nil value stored and retrieved")
            val m = PersistentMap.empty().set("nil_val", nil)
            expect(m.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "remove from empty map":
            step("Verify: remove from empty map")
            val m = PersistentMap.empty()
            val m2 = m.remove("nothing")
            expect(m2.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
