# PersistentVecBuilder and PersistentMapBuilder Specification
#
# Tests for the transient builder types from nogc_async_immut.
# Builders provide mutable batch construction that freezes into
# immutable collections via .build(). After freeze, mutations
# are silently ignored.

"""
## Purpose and audience
Purpose: Verify PersistentVecBuilder.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-PERSISTENT-BUILDER-001 — stable requirement identity for this spec.

use std.persistent_vec.transient.{
    PersistentVecBuilder, PersistentVecBuilder__new, PersistentVecBuilder__from
}
use std.persistent_map.transient.{
    PersistentMapBuilder, PersistentMapBuilder__new, PersistentMapBuilder__from_entries
}

use std.spec.step

describe "PersistentVecBuilder":

    describe "creation":
        it "starts empty":
            step("Verify: starts empty")
            # @req: REQ-LIB-PERSISTENT-BUILDER-001
            val b = PersistentVecBuilder.new()
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

        it "starts not frozen":
            step("Verify: starts not frozen")
            val b = PersistentVecBuilder.new()
            expect(b.is_frozen()).to_equal(false)

    describe "from factory":
        it "pre-populates with items":
            step("Verify: pre-populates with items")
            val b = PersistentVecBuilder.from([10, 20, 30])
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "is not frozen after creation":
            step("Verify: is not frozen after creation")
            val b = PersistentVecBuilder.from([1, 2])
            expect(b.is_frozen()).to_equal(false)

        it "empty array gives empty builder":
            step("Verify: empty array gives empty builder")
            val b = PersistentVecBuilder.from([])
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

    describe "push":
        it "adds single element":
            step("Verify: adds single element")
            var b = PersistentVecBuilder.new()
            b.push(42)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract

        it "adds multiple elements in order":
            step("Verify: adds multiple elements in order")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.push(2)
            b.push(3)
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "is no longer empty after push":
            step("Verify: is no longer empty after push")
            var b = PersistentVecBuilder.new()
            b.push(99)
            expect(b.is_empty()).to_equal(false)

    describe "push_all":
        it "adds all items from array":
            step("Verify: adds all items from array")
            var b = PersistentVecBuilder.new()
            b.push_all([10, 20, 30])
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "appends to existing items":
            step("Verify: appends to existing items")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.push_all([2, 3, 4])
            expect(b.len()).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(3)).to_equal(4)  # oracle: authoritative expected value documented by this spec's contract

        it "empty array is no-op":
            step("Verify: empty array is no-op")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.push_all([])
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    describe "set_at":
        it "replaces element at index":
            step("Verify: replaces element at index")
            var b = PersistentVecBuilder.from([10, 20, 30])
            b.set_at(1, 99)
            expect(b.get(1)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

        it "preserves other elements":
            step("Verify: preserves other elements")
            var b = PersistentVecBuilder.from([1, 2, 3])
            b.set_at(0, 99)
            expect(b.get(0)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "ignores negative index":
            step("Verify: ignores negative index")
            var b = PersistentVecBuilder.from([1, 2, 3])
            b.set_at(-1, 99)
            expect(b.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "ignores out of bounds index":
            step("Verify: ignores out of bounds index")
            var b = PersistentVecBuilder.from([1, 2])
            b.set_at(10, 99)
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "pop":
        it "removes last element":
            step("Verify: removes last element")
            var b = PersistentVecBuilder.from([1, 2, 3])
            b.pop()
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "clear":
        it "removes all elements":
            step("Verify: removes all elements")
            var b = PersistentVecBuilder.from([1, 2, 3])
            b.clear()
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

        it "allows push after clear":
            step("Verify: allows push after clear")
            var b = PersistentVecBuilder.from([1, 2])
            b.clear()
            b.push(99)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(99)  # oracle: authoritative expected value documented by this spec's contract

    describe "get":
        it "returns element at index":
            step("Verify: returns element at index")
            val b = PersistentVecBuilder.from([10, 20, 30])
            expect(b.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(2)).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "returns nil for out of bounds":
            step("Verify: returns nil for out of bounds")
            val b = PersistentVecBuilder.from([1, 2])
            expect(b.get(5)).to_be_nil()

        it "returns nil for negative index":
            step("Verify: returns nil for negative index")
            val b = PersistentVecBuilder.from([1, 2])
            expect(b.get(-1)).to_be_nil()

    describe "to_array":
        it "returns copy of items":
            step("Verify: returns copy of items")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.push(2)
            b.push(3)
            val arr = b.to_array()
            expect(arr.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[0]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(arr[2]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "empty builder returns empty array":
            step("Verify: empty builder returns empty array")
            val b = PersistentVecBuilder.new()
            val arr = b.to_array()
            expect(arr.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "build and freeze":
        it "returns items as array":
            step("Verify: returns items as array")
            var b = PersistentVecBuilder.new()
            b.push(10)
            b.push(20)
            b.push(30)
            val items = b.build()
            expect(items.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(items[0]).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(items[2]).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "marks builder as frozen":
            step("Verify: marks builder as frozen")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.build()
            expect(b.is_frozen()).to_equal(true)

        it "push is no-op after freeze":
            step("Verify: push is no-op after freeze")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.push(2)
            b.build()
            b.push(3)
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "push_all is no-op after freeze":
            step("Verify: push_all is no-op after freeze")
            var b = PersistentVecBuilder.new()
            b.push(1)
            b.build()
            b.push_all([2, 3, 4])
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "set_at is no-op after freeze":
            step("Verify: set_at is no-op after freeze")
            var b = PersistentVecBuilder.from([10, 20])
            b.build()
            b.set_at(0, 99)
            expect(b.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract

        it "clear is no-op after freeze":
            step("Verify: clear is no-op after freeze")
            var b = PersistentVecBuilder.from([1, 2, 3])
            b.build()
            b.clear()
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "reads still work after freeze":
            step("Verify: reads still work after freeze")
            var b = PersistentVecBuilder.new()
            b.push(10)
            b.push(20)
            b.build()
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(0)).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get(1)).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(false)

describe "PersistentMapBuilder":

    describe "creation":
        it "starts empty":
            step("Verify: starts empty")
            val b = PersistentMapBuilder.new()
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

        it "starts not frozen":
            step("Verify: starts not frozen")
            val b = PersistentMapBuilder.new()
            expect(b.is_frozen()).to_equal(false)

    describe "from_entries factory":
        it "pre-populates with entries":
            step("Verify: pre-populates with entries")
            val b = PersistentMapBuilder.from_entries([["a", 1], ["b", 2]])
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "is not frozen after creation":
            step("Verify: is not frozen after creation")
            val b = PersistentMapBuilder.from_entries([["x", 10]])
            expect(b.is_frozen()).to_equal(false)

        it "empty entries gives empty builder":
            step("Verify: empty entries gives empty builder")
            val b = PersistentMapBuilder.from_entries([])
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

        it "handles duplicate keys in entries":
            step("Verify: handles duplicate keys in entries")
            val b = PersistentMapBuilder.from_entries([["a", 1], ["a", 2]])
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

    describe "set and get":
        it "stores and retrieves a value":
            step("Verify: stores and retrieves a value")
            var b = PersistentMapBuilder.new()
            b.set("name", "Alice")
            expect(b.get("name")).to_equal("Alice")

        it "stores multiple key-value pairs":
            step("Verify: stores multiple key-value pairs")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            b.set("c", 3)
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("c")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

        it "overwrites existing key":
            step("Verify: overwrites existing key")
            var b = PersistentMapBuilder.new()
            b.set("key", "old")
            b.set("key", "new")
            expect(b.get("key")).to_equal("new")
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "returns nil for missing key":
            step("Verify: returns nil for missing key")
            val b = PersistentMapBuilder.new()
            expect(b.get("nothing")).to_be_nil()

        it "stores integer keys":
            step("Verify: stores integer keys")
            var b = PersistentMapBuilder.new()
            b.set(1, "one")
            b.set(2, "two")
            expect(b.get(1)).to_equal("one")
            expect(b.get(2)).to_equal("two")

    describe "set_all":
        it "adds multiple entries":
            step("Verify: adds multiple entries")
            var b = PersistentMapBuilder.new()
            b.set_all([["x", 10], ["y", 20], ["z", 30]])
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("x")).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("z")).to_equal(30)  # oracle: authoritative expected value documented by this spec's contract

        it "appends to existing entries":
            step("Verify: appends to existing entries")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set_all([["b", 2], ["c", 3]])
            expect(b.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    describe "contains":
        it "returns true for existing key":
            step("Verify: returns true for existing key")
            var b = PersistentMapBuilder.new()
            b.set("x", 42)
            expect(b.contains("x")).to_equal(true)

        it "returns false for missing key":
            step("Verify: returns false for missing key")
            var b = PersistentMapBuilder.new()
            b.set("x", 42)
            expect(b.contains("y")).to_equal(false)

        it "returns false for empty builder":
            step("Verify: returns false for empty builder")
            val b = PersistentMapBuilder.new()
            expect(b.contains("anything")).to_equal(false)

    describe "remove":
        it "removes an existing key":
            step("Verify: removes an existing key")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            b.remove("a")
            expect(b.get("a")).to_be_nil()
            expect(b.contains("a")).to_equal(false)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "preserves other entries":
            step("Verify: preserves other entries")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            b.set("c", 3)
            b.remove("b")
            expect(b.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("c")).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "remove non-existent key is safe":
            step("Verify: remove non-existent key is safe")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.remove("zzz")
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    describe "clear":
        it "removes all entries":
            step("Verify: removes all entries")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            b.clear()
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.is_empty()).to_equal(true)

        it "allows set after clear":
            step("Verify: allows set after clear")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.clear()
            b.set("b", 2)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("b")).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_be_nil()

    describe "keys and values":
        it "returns correct keys":
            step("Verify: returns correct keys")
            var b = PersistentMapBuilder.new()
            b.set("x", 10)
            b.set("y", 20)
            val k = b.keys()
            expect(k.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "returns correct values":
            step("Verify: returns correct values")
            var b = PersistentMapBuilder.new()
            b.set("x", 10)
            b.set("y", 20)
            val v = b.values()
            expect(v.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "empty builder has empty keys and values":
            step("Verify: empty builder has empty keys and values")
            val b = PersistentMapBuilder.new()
            expect(b.keys().len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.values().len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "to_entries":
        it "returns key-value pairs":
            step("Verify: returns key-value pairs")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            val entries = b.to_entries()
            expect(entries.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            val first = entries[0]
            expect(first[0]).to_equal("a")
            expect(first[1]).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "empty builder returns empty entries":
            step("Verify: empty builder returns empty entries")
            val b = PersistentMapBuilder.new()
            val entries = b.to_entries()
            expect(entries.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    describe "build and freeze":
        it "returns entries as array of pairs":
            step("Verify: returns entries as array of pairs")
            var b = PersistentMapBuilder.new()
            b.set("name", "Alice")
            b.set("age", 30)
            val entries = b.build()
            expect(entries.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract

        it "marks builder as frozen":
            step("Verify: marks builder as frozen")
            var b = PersistentMapBuilder.new()
            b.set("x", 1)
            b.build()
            expect(b.is_frozen()).to_equal(true)

        it "set is no-op after freeze":
            step("Verify: set is no-op after freeze")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.build()
            b.set("b", 2)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("b")).to_be_nil()

        it "set_all is no-op after freeze":
            step("Verify: set_all is no-op after freeze")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.build()
            b.set_all([["b", 2], ["c", 3]])
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "remove is no-op after freeze":
            step("Verify: remove is no-op after freeze")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("b", 2)
            b.build()
            b.remove("a")
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "clear is no-op after freeze":
            step("Verify: clear is no-op after freeze")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.build()
            b.clear()
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "reads still work after freeze":
            step("Verify: reads still work after freeze")
            var b = PersistentMapBuilder.new()
            b.set("x", 42)
            b.set("y", 99)
            b.build()
            expect(b.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("x")).to_equal(42)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.contains("y")).to_equal(true)
            expect(b.is_empty()).to_equal(false)

        it "build returns well-formed entries":
            step("Verify: build returns well-formed entries")
            var b = PersistentMapBuilder.new()
            b.set("key", "value")
            val entries = b.build()
            expect(entries.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            val pair = entries[0]
            expect(pair[0]).to_equal("key")
            expect(pair[1]).to_equal("value")

    describe "edge cases":
        it "empty key string":
            step("Verify: empty key string")
            var b = PersistentMapBuilder.new()
            b.set("", "empty_key")
            expect(b.get("")).to_equal("empty_key")
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "nil value stored and retrieved":
            step("Verify: nil value stored and retrieved")
            var b = PersistentMapBuilder.new()
            b.set("nil_val", nil)
            expect(b.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        it "overwrite then remove":
            step("Verify: overwrite then remove")
            var b = PersistentMapBuilder.new()
            b.set("a", 1)
            b.set("a", 2)
            b.remove("a")
            expect(b.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(b.get("a")).to_be_nil()
