class Inner:
    blob: [u8]

class Outer:
    name: text
    inner: Inner?

var _cache: [Outer] = []

fn store():
    _cache.push(Outer(name: "a", inner: Some(Inner(blob: [1u8, 2u8, 3u8]))))

fn main():
    store()
    val got = _cache[0]
    print("name=" + got.name)
    if val i = got.inner:
        print("blob_len=" + i.blob.len().to_string())
    else:
        print("blob_len=NIL")
