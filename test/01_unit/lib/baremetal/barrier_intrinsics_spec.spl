# ============================================================================
# Spec: barrier / cache-op / wait intrinsics (plan 1.2, design A.7 F2)
#
# Host contract: every intrinsic is a single skipped asm statement, so it is
# a no-op that returns and never touches memory — the property this spec can
# check on the host is exactly "callable, returns, no side effect on Simple
# state". The mnemonic match per arch (`fence rw,rw`, `fence.i`, `dmb ish`,
# `dsb sy`, `isb`, `dc civac`, `mfence`, `clflush`, `pause`, `wfi`) is pinned
# by the seed objdump fixtures build/hal_fx/{f1_rv,f1_x86} (impl_B_REPORT.md).
# ============================================================================

use std.nogc_async_mut_noalloc.baremetal.riscv.barrier as rv
use std.nogc_async_mut_noalloc.baremetal.arm64.barrier as a64
use std.nogc_async_mut_noalloc.baremetal.x86_64.barrier as x86

describe "riscv barriers are host no-ops":
    it "fence family, sfence.vma, wfi and cpu_relax return":
        var guard = 1
        rv.fence_rw()
        rv.fence_full()
        rv.fence_r()
        rv.fence_w()
        rv.fence_io()
        rv.fence_i()
        rv.sfence_vma_all()
        rv.sfence_vma_addr(0x1000)
        rv.cpu_relax()
        rv.nop()
        guard = guard + 1
        expect guard == 2

describe "aarch64 barriers are host no-ops":
    it "dmb/dsb/isb, dc/ic ops, tlbi and wait hints return":
        var guard = 1
        a64.dmb_ish()
        a64.dmb_sy()
        a64.dsb_ish()
        a64.dsb_sy()
        a64.isb()
        a64.fence_full()
        a64.dc_civac(0x1000)
        a64.dc_cvac(0x1000)
        a64.dc_ivac(0x1000)
        a64.ic_ivau(0x1000)
        a64.ic_ialluis()
        a64.tlbi_vmalle1()
        a64.cpu_relax()
        a64.nop()
        guard = guard + 1
        expect guard == 2

describe "x86_64 barriers are host no-ops":
    it "mfence/lfence/sfence, clflush, invlpg and pause return":
        var guard = 1
        x86.mfence()
        x86.lfence()
        x86.sfence()
        x86.fence_full()
        x86.clflush(0x1000)
        x86.invlpg(0x1000)
        x86.cpu_relax()
        x86.nop()
        guard = guard + 1
        expect guard == 2
