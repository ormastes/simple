# ============================================================================
# Spec: typed bitfield MMIO register views (plan 1.6, design A.7 F4)
#
# Host contract via mmio_test_shim. The native contract — two volatile stores
# keep order and width in objdump, field write is RMW of the containing word,
# `reg_write` (set_raw) is a single plain store — is pinned by the seed
# fixture build/hal_fx/f4_mmio (objdump evidence in impl_B_REPORT.md).
# ============================================================================

use std.nogc_async_mut_noalloc.baremetal.mmio_reg.{
    mmio_field, mmio_field_mask, mmio_fields_check_disjoint,
    reg_read, reg_write, reg_field_read, reg_field_write, reg_field_is_set,
    mmio_test_shim, mmio_test_shim_clear
}

val UART_BASE: u64 = 0x10000000
val UART_STATUS: u64 = UART_BASE + 0x04

describe "MmioField layout":
    it "computes masks from lo/width":
        expect mmio_field_mask(mmio_field(0, 1)) == 0x1
        expect mmio_field_mask(mmio_field(5, 1)) == 0x20
        expect mmio_field_mask(mmio_field(8, 4)) == 0xF00
        expect mmio_field_mask(mmio_field(0, 32)) == 0xFFFFFFFF

    it "rejects overlapping fields (E-LAYOUT)":
        expect mmio_fields_check_disjoint([mmio_field(0, 1), mmio_field(5, 1), mmio_field(8, 4)])
        expect not mmio_fields_check_disjoint([mmio_field(0, 4), mmio_field(3, 2)])

describe "register field access (host shim)":
    it "field read is full-width load then mask":
        mmio_test_shim([UART_STATUS], [0x00000121])
        expect reg_field_read(UART_STATUS, mmio_field(0, 1)) == 1      # rx_avail
        expect reg_field_is_set(UART_STATUS, mmio_field(5, 1))          # tx_ready
        expect reg_field_read(UART_STATUS, mmio_field(8, 4)) == 1
        mmio_test_shim_clear()

    it "field write is RMW of the containing word only":
        mmio_test_shim([UART_STATUS], [0x00000F21])
        reg_field_write(UART_STATUS, mmio_field(8, 4), 0xA)
        expect reg_read(UART_STATUS) == 0x00000A21
        reg_field_write(UART_STATUS, mmio_field(0, 1), 0)
        expect reg_read(UART_STATUS) == 0x00000A20
        mmio_test_shim_clear()

    it "reg_write (set_raw) replaces the whole word, no read-modify":
        mmio_test_shim([UART_STATUS], [0xFFFFFFFF])
        reg_write(UART_STATUS, 0x20)
        expect reg_read(UART_STATUS) == 0x20
        mmio_test_shim_clear()
