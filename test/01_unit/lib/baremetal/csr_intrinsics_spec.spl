# ============================================================================
# Spec: CSR / sysreg / MSR intrinsics (plan 1.1, design A.7 F1)
#
# Host contract: the asm statement is skipped by the interpreter, so every
# intrinsic reads/writes through the installed test shim; a read without a
# shim raises E-INTRINSIC-HOST (not tested here: panic is process-fatal).
#
# Native contract (objdump of a one-call fn contains exactly the mnemonic) is
# pinned by the seed fixtures in build/hal_fx/{f1_rv,f1_x86,red_csr,red_rv}
# and recorded in impl_B_REPORT.md; the seed's native-build takes minutes per
# fixture, so it is not run from this spec.
# ============================================================================

use std.nogc_async_mut_noalloc.baremetal.riscv.csr.{
    csr_read, csr_write, csr_set_bits, csr_clear_bits, csr_read_write,
    csr_is_supported, csr_test_shim, csr_test_shim_clear,
    CSR_SSTATUS, CSR_SIE, CSR_SATP, CSR_MHARTID, CSR_TIME, CSR_PMPADDR1
}
use std.nogc_async_mut_noalloc.baremetal.arm64.sysreg.{
    sysreg_read, sysreg_write, sysreg_test_shim, sysreg_test_shim_clear,
    daif_mask_all, daif_unmask_all, current_el,
    SYSREG_CURRENTEL, SYSREG_VBAR_EL1, SYSREG_DAIF
}
use std.nogc_async_mut_noalloc.baremetal.x86_64.msr.{
    msr_read, msr_write, msr_test_shim, msr_test_shim_clear, MSR_EFER, MSR_LSTAR
}

describe "riscv csr intrinsics (host shim)":
    it "csr_read returns the scripted value per CSR":
        csr_test_shim([CSR_SSTATUS, CSR_MHARTID], [0x4000000200006000, 3])
        expect csr_read(CSR_SSTATUS) == 0x4000000200006000
        expect csr_read(CSR_MHARTID) == 3
        csr_test_shim_clear()

    it "csr_write is observable through csr_read":
        csr_test_shim([CSR_SATP], [0])
        csr_write(CSR_SATP, 0x4000000000080000)
        expect csr_read(CSR_SATP) == 0x4000000000080000
        csr_test_shim_clear()

    it "csr_set_bits / csr_clear_bits are read-modify-write on the mask only":
        csr_test_shim([CSR_SIE], [0x200])
        csr_set_bits(CSR_SIE, 0x20)
        expect csr_read(CSR_SIE) == 0x220
        csr_clear_bits(CSR_SIE, 0x200)
        expect csr_read(CSR_SIE) == 0x20
        csr_clear_bits(CSR_SIE, 0x200)   # clearing a clear bit is a no-op
        expect csr_read(CSR_SIE) == 0x20
        csr_test_shim_clear()

    it "csr_read_write swaps atomically and returns the old value":
        csr_test_shim([CSR_SSTATUS], [0x2])
        expect csr_read_write(CSR_SSTATUS, 0x22) == 0x2
        expect csr_read(CSR_SSTATUS) == 0x22
        csr_test_shim_clear()

    it "csr_is_supported names exactly the CSRs that have an intrinsic arm (E-CSR-UNKNOWN otherwise)":
        expect csr_is_supported(CSR_SSTATUS)
        expect csr_is_supported(CSR_TIME)
        expect csr_is_supported(CSR_MHARTID)
        expect not csr_is_supported(CSR_PMPADDR1)
        expect not csr_is_supported(0x7FF)

describe "aarch64 sysreg intrinsics (host shim)":
    it "sysreg_read / sysreg_write round-trip and current_el decodes CurrentEL[3:2]":
        sysreg_test_shim([SYSREG_CURRENTEL, SYSREG_VBAR_EL1], [0x4, 0])
        expect current_el() == 1
        sysreg_write(SYSREG_VBAR_EL1, 0x80000000)
        expect sysreg_read(SYSREG_VBAR_EL1) == 0x80000000
        sysreg_test_shim_clear()

    it "daif mask/unmask are visible as DAIF writes":
        sysreg_test_shim([SYSREG_DAIF], [0])
        daif_mask_all()
        expect sysreg_read(SYSREG_DAIF) == 0x3C0
        daif_unmask_all()
        expect sysreg_read(SYSREG_DAIF) == 0
        sysreg_test_shim_clear()

describe "x86_64 msr intrinsics (host shim)":
    it "msr_read / msr_write round-trip 64-bit values":
        msr_test_shim([MSR_EFER], [0x500])
        expect msr_read(MSR_EFER) == 0x500
        msr_write(MSR_LSTAR, 0x7FFFFFFF80001000)
        expect msr_read(MSR_LSTAR) == 0x7FFFFFFF80001000
        msr_test_shim_clear()
