# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# std.nogc_sync_mut.path: `dirname` and `basename` support both `/` and `\`

## Overview

Windows paths (such as AOT object cache targets `C:\dev\cache\aot-x.o` passed to
`dirname` in `llvm_backend_tools.spl`) use backslash separators or mixed `/` and
`\` separators. `dirname` and `basename` in `std.nogc_sync_mut.path` must split
on both `/` and `\` while preserving POSIX semantics and Windows drive roots
(`C:\` / `C:/`).
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.path.{basename, dirname, extension, stem, dir_name, parent_dir}

describe "std.nogc_sync_mut.path dirname and basename separator handling":
    it "preserves POSIX path semantics":
        expect(dirname("/a/b/c")).to_equal("/a/b")
        expect(basename("/a/b/c")).to_equal("c")
        expect(dirname("/a")).to_equal("/")
        expect(basename("/a")).to_equal("a")
        expect(dirname("/")).to_equal("/")
        expect(basename("/")).to_equal("")
        expect(dirname("///")).to_equal("/")
        expect(basename("///")).to_equal("")
        expect(dirname("/a/b/")).to_equal("/a")
        expect(basename("/a/b/")).to_equal("b")
        expect(dirname("/a/")).to_equal("/")
        expect(basename("/a/")).to_equal("a")

    it "handles empty and relative paths with forward and backward slashes":
        expect(dirname("")).to_equal(".")
        expect(basename("")).to_equal("")
        expect(dirname("file.txt")).to_equal(".")
        expect(basename("file.txt")).to_equal("file.txt")
        expect(dirname("file.txt/")).to_equal(".")
        expect(basename("file.txt/")).to_equal("file.txt")
        expect(dirname("file.txt\\")).to_equal(".")
        expect(basename("file.txt\\")).to_equal("file.txt")
        expect(dirname("a/b")).to_equal("a")
        expect(basename("a/b")).to_equal("b")
        expect(dirname("a\\b")).to_equal("a")
        expect(basename("a\\b")).to_equal("b")
        expect(dirname("a\\b\\c")).to_equal("a\\b")
        expect(basename("a\\b\\c")).to_equal("c")
        expect(dirname("a/b\\")).to_equal("a")
        expect(basename("a/b\\")).to_equal("b")

    it "handles Windows drive paths and drive roots":
        expect(dirname("C:\\dev\\cache\\aot-x.o")).to_equal("C:\\dev\\cache")
        expect(basename("C:\\dev\\cache\\aot-x.o")).to_equal("aot-x.o")
        expect(dirname("C:\\foo")).to_equal("C:\\")
        expect(basename("C:\\foo")).to_equal("foo")
        expect(dirname("C:/foo")).to_equal("C:/")
        expect(basename("C:/foo")).to_equal("foo")
        expect(dirname("c:\\foo")).to_equal("c:\\")
        expect(basename("c:\\foo")).to_equal("foo")
        expect(dirname("C:\\")).to_equal("C:\\")
        expect(basename("C:\\")).to_equal("")
        expect(dirname("C:/")).to_equal("C:/")
        expect(basename("C:/")).to_equal("")
        expect(dirname("C:\\\\")).to_equal("C:\\")
        expect(basename("C:\\\\")).to_equal("")
        expect(dirname("C:///")).to_equal("C:/")
        expect(basename("C:///")).to_equal("")

    it "handles Windows trailing separators and mixed separators":
        expect(dirname("C:\\dev\\cache\\")).to_equal("C:\\dev")
        expect(basename("C:\\dev\\cache\\")).to_equal("cache")
        expect(dirname("C:\\foo\\")).to_equal("C:\\")
        expect(basename("C:\\foo\\")).to_equal("foo")
        expect(dirname("C:/foo/")).to_equal("C:/")
        expect(basename("C:/foo/")).to_equal("foo")
        expect(dirname("C:\\dev/cache\\aot-x.o")).to_equal("C:\\dev/cache")
        expect(basename("C:\\dev/cache\\aot-x.o")).to_equal("aot-x.o")
        expect(dirname("C:\\dev\\cache/aot-x.o")).to_equal("C:\\dev\\cache")
        expect(basename("C:\\dev\\cache/aot-x.o")).to_equal("aot-x.o")

    it "handles backslash root, UNC paths, and multibyte UTF-8 paths":
        expect(dirname("\\")).to_equal("\\")
        expect(basename("\\")).to_equal("")
        expect(dirname("\\\\")).to_equal("\\")
        expect(basename("\\\\")).to_equal("")
        expect(dirname("\\foo")).to_equal("\\")
        expect(basename("\\foo")).to_equal("foo")
        expect(dirname("\\\\server\\share\\src\\main.spl")).to_equal("\\\\server\\share\\src")
        expect(basename("\\\\server\\share\\src\\main.spl")).to_equal("main.spl")
        expect(dirname("C:\\작업\\소스\\main.spl")).to_equal("C:\\작업\\소스")
        expect(basename("C:\\작업\\소스\\main.spl")).to_equal("main.spl")
        expect(dirname("C:\\작업\\소스\\파일.spl")).to_equal("C:\\작업\\소스")
        expect(basename("C:\\작업\\소스\\파일.spl")).to_equal("파일.spl")
        expect(dirname("가\\나\\다.spl")).to_equal("가\\나")
        expect(basename("가\\나\\다.spl")).to_equal("다.spl")
        expect(dirname("가\\")).to_equal(".")
        expect(basename("가\\")).to_equal("가")

    it "propagates backslash awareness to extension, stem, dir_name, and parent_dir":
        expect(extension("C:\\dev\\cache\\aot-x.o")).to_equal("o")
        expect(stem("C:\\dev\\cache\\aot-x.o")).to_equal("aot-x")
        expect(extension("C:\\dev.v1\\README")).to_equal("")
        expect(stem("C:\\dev.v1\\README")).to_equal("README")
        expect(parent_dir("C:\\dev\\cache\\aot-x.o")).to_equal("C:\\dev\\cache")
        expect(dir_name("C:\\dev\\cache\\")).to_equal("cache")
