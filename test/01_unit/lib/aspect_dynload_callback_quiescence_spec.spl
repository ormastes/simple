# Focused generation/lease/quiescence contract for aspect dynload execution.
use std.spec.{describe, it, expect, step}
use std.common.aspect_dynload_lifecycle_v1

fn lifecycle(device_fences: bool = false) -> AspectDynloadLifecycleHandleV1:
    aspect_dynload_lifecycle_create_v1("trace/Callback", 7, 8, device_fences).unwrap()

describe "aspect dynload callback quiescence":
    it "holds quiescing through a nested callback":
        val owner = lifecycle()
        val outer = aspect_dynload_callback_begin_v1(owner).unwrap()
        expect(aspect_dynload_unload_v1(owner).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        val nested = aspect_dynload_nested_callback_begin_v1(owner, outer).unwrap()
        expect(aspect_dynload_lease_complete_v1(owner, outer).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        expect(aspect_dynload_lease_complete_v1(owner, nested).unwrap().state).to_equal(ASPECT_DYNLOAD_RETIRED_V1)

    it "atomically carries an around continuation":
        val owner = lifecycle()
        val callback = aspect_dynload_callback_begin_v1(owner).unwrap()
        val continuation = aspect_dynload_around_suspend_v1(owner, callback).unwrap()
        expect(aspect_dynload_lease_complete_v1(owner, callback).is_err()).to_equal(true)
        expect(aspect_dynload_unload_v1(owner).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        val resumed = aspect_dynload_around_resume_v1(owner, continuation).unwrap()
        expect(aspect_dynload_lease_complete_v1(owner, continuation).is_err()).to_equal(true)
        expect(aspect_dynload_lease_complete_v1(owner, resumed).unwrap().state).to_equal(ASPECT_DYNLOAD_RETIRED_V1)

    it "waits for an applicable device fence":
        val owner = lifecycle(true)
        val callback = aspect_dynload_callback_begin_v1(owner).unwrap()
        val fence = aspect_dynload_device_fence_begin_v1(owner, callback).unwrap()
        expect(aspect_dynload_unload_v1(owner).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        expect(aspect_dynload_lease_complete_v1(owner, callback).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        expect(aspect_dynload_lease_complete_v1(owner, fence).unwrap().state).to_equal(ASPECT_DYNLOAD_RETIRED_V1)
        val cpu = lifecycle(false)
        val cpu_callback = aspect_dynload_callback_begin_v1(cpu).unwrap()
        expect(aspect_dynload_device_fence_begin_v1(cpu, cpu_callback).is_err()).to_equal(true)

    it "binds copied handles to one canonical row":
        val owner = lifecycle()
        val copied = owner
        val callback = aspect_dynload_callback_begin_v1(copied).unwrap()
        expect(aspect_dynload_lifecycle_snapshot_v1(owner).unwrap().callback_count).to_equal(1)
        expect(aspect_dynload_unload_v1(owner).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        expect(aspect_dynload_lease_complete_v1(copied, callback).unwrap().state).to_equal(ASPECT_DYNLOAD_RETIRED_V1)

    it "rejects duplicate-owner, copied-result, duplicate, and stale coordinates":
        val first = lifecycle()
        val second = lifecycle()
        expect(first.lifecycle_id == second.lifecycle_id).to_equal(false)
        val first_lease = aspect_dynload_callback_begin_v1(first).unwrap()
        val second_lease = aspect_dynload_callback_begin_v1(second).unwrap()
        expect(first_lease.lease_id).to_equal(second_lease.lease_id)
        expect(aspect_dynload_lease_complete_v1(second, first_lease).is_err()).to_equal(true)
        val copied_result = first_lease
        expect(aspect_dynload_unload_v1(first).unwrap().state).to_equal(ASPECT_DYNLOAD_QUIESCING_V1)
        expect(aspect_dynload_callback_begin_v1(first).is_err()).to_equal(true)
        expect(aspect_dynload_lease_complete_v1(first, copied_result).unwrap().state).to_equal(ASPECT_DYNLOAD_RETIRED_V1)
        expect(aspect_dynload_lease_complete_v1(first, first_lease).is_err()).to_equal(true)
        expect(aspect_dynload_publish_next_generation_v1(first).unwrap()).to_equal(8)
        expect(aspect_dynload_lease_complete_v1(first, first_lease).is_err()).to_equal(true)
        expect(aspect_dynload_lease_complete_v1(second, second_lease).is_ok()).to_equal(true)

    it "reuses retired storage for more than the lifecycle capacity":
        var first_slot: i64 = 0
        var previous_incarnation: i64 = 0
        var completed: i64 = 0
        while completed < ASPECT_DYNLOAD_MAX_LIFECYCLE_CAPACITY_V1 + 1:
            val owner = lifecycle()
            if first_slot == 0:
                first_slot = owner.lifecycle_id
            expect(owner.lifecycle_id).to_equal(first_slot)
            expect(owner.incarnation).to_be_greater_than(previous_incarnation)
            val lease = aspect_dynload_callback_begin_v1(owner).unwrap()
            expect(lease.lease_id).to_equal(1)
            expect(lease.incarnation).to_equal(owner.incarnation)
            expect(aspect_dynload_unload_v1(owner).unwrap().state).to_equal(
                ASPECT_DYNLOAD_QUIESCING_V1)
            expect(aspect_dynload_lease_complete_v1(owner, lease).unwrap().state).to_equal(
                ASPECT_DYNLOAD_RETIRED_V1)
            expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(true)
            expect(aspect_dynload_lifecycle_snapshot_v1(owner).is_err()).to_equal(true)
            previous_incarnation = owner.incarnation
            completed = completed + 1
        expect(completed).to_equal(ASPECT_DYNLOAD_MAX_LIFECYCLE_CAPACITY_V1 + 1)

    it "rejects copied handles and leases after exact-slot reuse":
        val owner = lifecycle()
        val copied = owner
        val old_lease = aspect_dynload_callback_begin_v1(owner).unwrap()
        aspect_dynload_unload_v1(owner).unwrap()
        aspect_dynload_lease_complete_v1(owner, old_lease).unwrap()
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(true)
        val fresh = lifecycle()
        val fresh_lease = aspect_dynload_callback_begin_v1(fresh).unwrap()
        expect(fresh.lifecycle_id).to_equal(copied.lifecycle_id)
        expect(fresh.incarnation).to_equal(copied.incarnation + 1)
        expect(fresh_lease.facet_key).to_equal(old_lease.facet_key)
        expect(fresh_lease.generation).to_equal(old_lease.generation)
        expect(fresh_lease.lease_id).to_equal(old_lease.lease_id)
        expect(aspect_dynload_callback_begin_v1(copied).is_err()).to_equal(true)
        expect(aspect_dynload_publish_next_generation_v1(copied).is_err()).to_equal(true)
        expect(aspect_dynload_unload_v1(copied).is_err()).to_equal(true)
        expect(aspect_dynload_lifecycle_snapshot_v1(copied).is_err()).to_equal(true)
        expect(aspect_dynload_lifecycle_reclaim_v1(copied)).to_equal(false)
        expect(aspect_dynload_lease_complete_v1(fresh, old_lease).is_err()).to_equal(true)
        expect(aspect_dynload_lease_complete_v1(copied, fresh_lease).is_err()).to_equal(true)
        expect(aspect_dynload_lifecycle_snapshot_v1(fresh).unwrap().callback_count).to_equal(1)
        expect(aspect_dynload_lease_complete_v1(fresh, fresh_lease).is_ok()).to_equal(true)
        aspect_dynload_unload_v1(fresh).unwrap()
        expect(aspect_dynload_lifecycle_reclaim_v1(fresh)).to_equal(true)

    it "refuses reclaim until active ownership and all continuation fences drain":
        val active = lifecycle()
        expect(aspect_dynload_lifecycle_reclaim_v1(active)).to_equal(false)
        expect(aspect_dynload_lifecycle_snapshot_v1(active).unwrap().state).to_equal(
            ASPECT_DYNLOAD_ACTIVE_V1)
        aspect_dynload_unload_v1(active).unwrap()
        expect(aspect_dynload_lifecycle_reclaim_v1(active)).to_equal(true)

        val owner = lifecycle(true)
        val callback = aspect_dynload_callback_begin_v1(owner).unwrap()
        val continuation = aspect_dynload_around_suspend_v1(owner, callback).unwrap()
        val fence = aspect_dynload_device_fence_begin_v1(owner, continuation).unwrap()
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(false)
        expect(aspect_dynload_lifecycle_snapshot_v1(owner).unwrap().outstanding_count).to_equal(2)
        aspect_dynload_unload_v1(owner).unwrap()
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(false)
        expect(aspect_dynload_lease_complete_v1(owner, continuation).unwrap().outstanding_count).to_equal(1)
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(false)
        expect(aspect_dynload_lease_complete_v1(owner, fence).unwrap().state).to_equal(
            ASPECT_DYNLOAD_RETIRED_V1)
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(true)
        expect(aspect_dynload_lifecycle_reclaim_v1(owner)).to_equal(false)

    it "refuses allocation incarnation wrap":
        expect(aspect_dynload_lifecycle_checked_next_incarnation_v1(-1)).to_equal(0)
        expect(aspect_dynload_lifecycle_checked_next_incarnation_v1(0)).to_equal(1)
        expect(aspect_dynload_lifecycle_checked_next_incarnation_v1(
            ASPECT_DYNLOAD_MAX_I64_V1 - 1)).to_equal(ASPECT_DYNLOAD_MAX_I64_V1)
        expect(aspect_dynload_lifecycle_checked_next_incarnation_v1(
            ASPECT_DYNLOAD_MAX_I64_V1)).to_equal(0)
