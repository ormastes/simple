use std.spec.*
use std.http_server.ssr_scalar_service.*

fn valid_scalar_ssr_command() -> SsrScalarRenderCommandV1:
    SsrScalarRenderCommandV1(job_id: 7, payload_lease_id: 11,
        payload_bytes: 1024, width: 320, height: 240,
        max_body_bytes: 4096, backend_code: SSR_SCALAR_BACKEND_AUTO,
        config_revision: 3, completion_port_id: 13)

describe "SSR scalar service capability boundary":
    it "exposes an explicit unavailable startup capability":
        val owner = SsrScalarServiceOwnerV1.unavailable(8)
        val capability = owner.capability()
        expect(capability.protocol_revision).to_equal(1)
        expect(capability.command_words).to_equal(9)
        expect(capability.queue_limit).to_equal(8)
        expect(capability.bridge_ready).to_equal(false)
        expect(owner.pending_count()).to_equal(0)

    it "rejects a valid scalar command without spawning work":
        var owner = SsrScalarServiceOwnerV1.unavailable(8)
        val receipt = owner.submit(valid_scalar_ssr_command())
        expect(receipt.job_id).to_equal(7)
        expect(receipt.service_lease_id).to_equal(0)
        expect(receipt.status_code).to_equal(SSR_SCALAR_RECEIPT_REJECTED)
        expect(receipt.reason_code).to_equal(SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)
        expect(owner.pending_count()).to_equal(0)
        expect(owner.rejected_total()).to_equal(1)

    it "validates bounds before capability readiness":
        var owner = SsrScalarServiceOwnerV1.unavailable(8)
        val invalid = SsrScalarRenderCommandV1(job_id: 9,
            payload_lease_id: 15, payload_bytes: 1024,
            width: 16384, height: 16384, max_body_bytes: 4096,
            backend_code: SSR_SCALAR_BACKEND_CPU, config_revision: 3,
            completion_port_id: 17)
        val receipt = owner.submit(invalid)
        expect(receipt.reason_code).to_equal(SSR_SCALAR_REASON_INVALID_COMMAND)
        expect(owner.pending_count()).to_equal(0)

    it "rejects commands beyond the bounded scalar transport capacity":
        val oversized_payload = SsrScalarRenderCommandV1(job_id: 10,
            payload_lease_id: 16, payload_bytes: SSR_SCALAR_MAX_PAYLOAD_BYTES + 1,
            width: 320, height: 240, max_body_bytes: SSR_SCALAR_MAX_RESULT_BYTES,
            backend_code: SSR_SCALAR_BACKEND_CPU, config_revision: 3,
            completion_port_id: 18)
        val oversized_result = SsrScalarRenderCommandV1(job_id: 11,
            payload_lease_id: 17, payload_bytes: 1024,
            width: 320, height: 240,
            max_body_bytes: SSR_SCALAR_MAX_RESULT_BYTES + 1,
            backend_code: SSR_SCALAR_BACKEND_CPU, config_revision: 3,
            completion_port_id: 19)
        expect(ssr_scalar_command_well_formed(oversized_payload)).to_equal(false)
        expect(ssr_scalar_command_well_formed(oversized_result)).to_equal(false)

    it "defines fixed scalar completion and result receipts":
        val command = valid_scalar_ssr_command()
        val completion = SsrScalarRenderCompletionV1(job_id: 7,
            service_lease_id: 19, payload_lease_id: 11,
            result_blob_lease_id: 23, result_bytes: 2048,
            status_code: SSR_SCALAR_RECEIPT_COMPLETED,
            reason_code: SSR_SCALAR_REASON_NONE, config_revision: 3,
            completion_port_id: 13)
        val result = SsrScalarResultMetadataV1(job_id: 7,
            service_lease_id: 19, result_blob_lease_id: 23,
            result_bytes: 2048, content_type_code: 1,
            content_status_code: 200, config_revision: 3)
        expect(SSR_SCALAR_SERVICE_COMPLETION_WORDS_V1).to_equal(9)
        expect(SSR_SCALAR_SERVICE_RESULT_WORDS_V1).to_equal(7)
        expect(ssr_scalar_completion_well_formed(completion)).to_equal(true)
        expect(ssr_scalar_completion_matches_command(command, completion)).to_equal(true)
        expect(ssr_scalar_result_metadata_well_formed(result)).to_equal(true)

    it "models cancellation release and late results without a transport":
        var owner = SsrScalarServiceOwnerV1.unavailable(4)
        val cancel = owner.cancel(7, 19)
        val release = owner.release(7, 19)
        expect(owner.lifecycle()).to_equal(SSR_SCALAR_LIFECYCLE_UNAVAILABLE)
        expect(ssr_scalar_can_cancel(SSR_SCALAR_LEASE_PENDING)).to_equal(true)
        expect(ssr_scalar_can_release(SSR_SCALAR_LEASE_CANCELED)).to_equal(true)
        expect(ssr_scalar_can_release(SSR_SCALAR_LEASE_COMPLETED)).to_equal(true)
        expect(ssr_scalar_completion_is_late(SSR_SCALAR_LEASE_CANCELED)).to_equal(true)
        expect(ssr_scalar_completion_is_late(SSR_SCALAR_LEASE_RELEASED)).to_equal(true)
        expect(cancel.reason_code).to_equal(SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)
        expect(release.reason_code).to_equal(SSR_SCALAR_REASON_BRIDGE_UNAVAILABLE)

    it "contains no detached task or aggregate transport surface":
        extern fn rt_file_read_text(path: text) -> text
        val source = rt_file_read_text(
            "src/lib/gc_async_mut/http_server/ssr_scalar_service.spl"
        ) ?? ""
        expect(source.find("multicore_green_spawn")).to_equal(-1)
        expect(source.find("Any")).to_equal(-1)
        expect(source.find("raw_ptr")).to_equal(-1)
        expect(source.find("HttpRequestData")).to_equal(-1)
        expect(source.find("result_blob_lease_id")).to_be_greater_than(-1)
        expect(source).to_contain("SSR_SCALAR_SERVICE_COMPLETION_WORDS_V1: i64 = 9")
        expect(source).to_contain("SSR_SCALAR_SERVICE_RESULT_WORDS_V1: i64 = 7")
        expect(source).to_contain("future cancellation or release must be reported as a late result")
        expect(source).to_contain("payload token is an opaque lease identifier")
        expect(source).to_contain("bridge_ready: false")
