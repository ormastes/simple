# Request Validation Specification
#
# **Feature IDs:** #SEC-013
# **Category:** HTTP Server Security
# **Difficulty:** 2/5
# **Status:** Implemented
#
# ## Overview
# Tests for request path validation and URI safety checks.
# Validates rejection of path traversal, null bytes, and overly long URIs.

use std.http_server.request_validation.{validate_request_path, validate_uri_length, default_max_uri_length}

# ============================================================================
# Test Group 1: Path traversal detection
# ============================================================================

# @req: REQ-HTTPSERV-RequestValidation-001
describe "Request path validation":
    it "rejects path traversal with ../":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects path traversal with ../")
        expect(path_accepted("/../etc/passwd")).to_equal(false)
        expect(rejection_status("/../etc/passwd")).to_equal(400)

    it "rejects path traversal with encoded ../":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects path traversal with encoded ../")
        expect(path_accepted("/%2e%2e/etc/passwd")).to_equal(false)

    it "rejects path traversal in middle of path":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects path traversal in middle of path")
        expect(path_accepted("/api/../admin/secret")).to_equal(false)

# ============================================================================
# Test Group 2: Null byte detection
# ============================================================================

describe "Null byte rejection":
    it "rejects null bytes in path":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects null bytes in path")
        val path = "/api/resource\x00.html"
        expect(contains_null_byte(path)).to_equal(true)
        expect(path_accepted(path)).to_equal(false)
        expect(rejection_status(path)).to_equal(400)  # oracle: value fixed by the spec contract

    it "rejects URL-encoded null bytes in path":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects URL-encoded null bytes in path")
        expect(contains_null_byte("/api/resource%00.html")).to_equal(true)
        expect(path_accepted("/api/resource%00.html")).to_equal(false)

# ============================================================================
# Test Group 3: Normal path acceptance
# ============================================================================

describe "Valid path acceptance":
    it "accepts normal paths":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: accepts normal paths")
        expect(path_accepted("/api/users/123")).to_equal(true)

    it "accepts root path":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: accepts root path")
        expect(path_accepted("/")).to_equal(true)

    it "accepts path with query string":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: accepts path with query string")
        expect(uri_accepted("/search", "q=hello")).to_equal(true)

    it "accepts path with dots in filename":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: accepts path with dots in filename")
        expect(path_accepted("/static/style.min.css")).to_equal(true)

# ============================================================================
# Test Group 4: URI length validation
# ============================================================================

describe "URI length validation":
    it "rejects overly long URIs":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: rejects overly long URIs")
        var long_uri = "/"
        var i = 0
        while i < 10000:
            long_uri = long_uri + "a"
            i = i + 1
        expect(long_uri.len() > MAX_URI_SIZE).to_equal(true)
        expect(path_accepted(long_uri)).to_equal(false)
        expect(rejection_status(long_uri)).to_equal(400)  # oracle: value fixed by the spec contract

    it "accepts normal length URIs":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: accepts normal length URIs")
        expect(path_accepted("/api/data")).to_equal(true)

    it "default max URI length is reasonable":
        # @req: REQ-HTTPSERV-RequestValidation-001
        step("Verify: default max URI length is reasonable")
        val is_reasonable = MAX_URI_SIZE > 0 and MAX_URI_SIZE <= 65536
        expect(is_reasonable).to_equal(true)
