use std.spec
use std.http_server.response_cache.{ResponseCache}

describe "HTTP response cache capacity":
    it "replaces an existing entry without evicting another path":
        val cache = ResponseCache.create(2)
        cache.put("/a", "a1", 2, 1)
        cache.put("/b", "b1", 2, 2)
        cache.put("/a", "a2", 2, 3)

        expect(cache.get("/a")).to_equal(Some("a2"))
        expect(cache.get("/b")).to_equal(Some("b1"))
        expect(cache.entries.len()).to_equal(2)

    it "keeps a zero-capacity cache disabled":
        val cache = ResponseCache.create(0)
        cache.put("/a", "body", 4, 1)

        expect(cache.get("/a")).to_be_nil()
        expect(cache.entries.len()).to_equal(0)

    it "evicts an empty-path key without exceeding capacity":
        val cache = ResponseCache.create(1)
        cache.put("", "empty", 5, 1)
        cache.put("/next", "next", 4, 2)

        expect(cache.get("")).to_be_nil()
        expect(cache.get("/next")).to_equal(Some("next"))
        expect(cache.entries.len()).to_equal(1)
