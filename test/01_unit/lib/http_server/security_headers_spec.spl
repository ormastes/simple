# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Security Headers Specification
#
# **Feature IDs:** #SEC-010
# **Category:** HTTP Server Security
# **Difficulty:** 2/5
# **Status:** Implemented
#
# ## Overview
# Tests for SecurityHeaders middleware configuration and header value building.
# Validates default CSP, X-Content-Type-Options, and X-Frame-Options settings.

use std.http_server.security_headers.{SecurityHeadersConfig, build_hsts_value, collect_security_headers}

# ============================================================================
# Test Group 1: Default security headers configuration
# ============================================================================

describe "SecurityHeaders middleware":
    # @manual scenario evidence
    it "adds CSP header by default":
        val config = SecurityHeadersConfig.default()
        expect(config.enable_csp).to_equal(true)

    it "adds X-Content-Type-Options header":
        val config = SecurityHeadersConfig.default()
        expect(config.enable_content_type_options).to_equal(true)

    it "adds X-Frame-Options header":
        val config = SecurityHeadersConfig.default()
        expect(config.enable_frame_options).to_equal(true)

    it "default CSP contains self":
        val config = SecurityHeadersConfig.default()
        expect(config.csp_value).to_contain("default-src 'self'")

# ============================================================================
# Test Group 2: Header value building
# ============================================================================

describe "security header values":
    it "default frame option value is DENY":
        val config = SecurityHeadersConfig.default()
        expect(config.frame_options_value).to_equal("DENY")

    it "builds HSTS header value":
        val value = build_hsts_value(31536000, false)
        expect(value).to_contain("max-age=")

    it "builds nosniff header value":
        val headers = collect_security_headers(SecurityHeadersConfig.default())
        var found = ""
        for h in headers:
            if h.0 == "X-Content-Type-Options":
                found = h.1
        expect(found).to_equal("nosniff")
