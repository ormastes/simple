use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "SSR scalar native-runtime adapter contract":
    it "uses leases and scoped copied byte loans without a worker or renderer":
        val source = rt_file_read_text(
            "src/lib/gc_async_mut/http_server/ssr_scalar_runtime_adapter.spl")
        expect(source).to_contain("rt_ssr_payload_lease_new(bytes_ptr: i64, length: i64)")
        expect(source).to_contain("rt_ssr_command_claim_complete(claim: i64, status: i64")
        expect(source).to_contain("rt_ssr_completion_port_new() -> i64")
        expect(source).to_contain("completion_port: i64, request_id: i64")
        expect(source).to_contain("is_completion_port: bool")
        expect(source).to_contain("self.released or self.is_completion_port")
        expect(source).to_contain("self.released or not self.is_completion_port")
        expect(source).to_contain("rt_ssr_command_port_receipt_take(port: i64)")
        expect(source).to_contain("Transfer one FIFO completion receipt; caller must release")
        expect(source).to_contain("rt_array_data_ptr_u8(bytes), length")
        expect(source).to_contain("native call copies the bytes before it returns")
        expect(source.find("HttpRequestData")).to_equal(-1)
        expect(source.find("multicore_green_spawn")).to_equal(-1)
        expect(source.find("FontRenderer")).to_equal(-1)
        expect(source.find("Any")).to_equal(-1)

    it "keeps the copied native buffers and scalar ABI bounded":
        val source = rt_file_read_text("src/runtime/runtime_ssr.c")
        expect(source).to_contain("#define SSR_PAYLOAD_MAX 65536")
        expect(source).to_contain("#define SSR_BLOB_MAX 262144")
        expect(source).to_contain("#define SSR_PORT_DEPTH 32")
        expect(source).to_contain("Completion copies the blob")
        expect(source).to_contain("Cancellation only applies before claim")
        expect(source).to_contain("SSR_PORT_ROLE_COMPLETION")
        expect(source).to_contain("completion_port_token")
        expect(source).to_contain("receipt_count >= SSR_PORT_DEPTH")
        expect(source).to_contain("rt_ssr_command_port_receipt_take")
