use std.spec
use std.nogc_sync_mut.io.windows_image_owner.{windows_image_decode}

describe "strict Windows kernel image UTF16 contract":
    it "REQ-WIN-IMAGE-001 preserves drive paths and supplementary Unicode":
        expect(windows_image_decode([67, 58, 92, 55357, 56832, 0], 5, 8)).to_equal(Ok("C:\\😀"))
        expect(windows_image_decode([92, 92, 115, 92, 97, 0], 5, 8)).to_equal(Ok("\\\\s\\a"))
    it "REQ-WIN-IMAGE-002 rejects failure and truncation":
        expect(windows_image_decode([], 0, 8)).to_equal(Err("Windows image query failed or truncated"))
        expect(windows_image_decode([], 1, 32769)).to_equal(Err("Windows image query failed or truncated"))
        expect(windows_image_decode([67, 58, 92, 0], 4, 4)).to_equal(Err("Windows image query failed or truncated"))
    it "REQ-WIN-IMAGE-002 rejects malformed units without replacement":
        expect(windows_image_decode([67, 58, 92, 55357, 0], 4, 8)).to_equal(Err("Windows image query unpaired high surrogate"))
        expect(windows_image_decode([67, 58, 92, 56320, 0], 4, 8)).to_equal(Err("Windows image query unpaired low surrogate"))
        expect(windows_image_decode([67, 58, 92, 55357, 65, 0], 5, 8)).to_equal(Err("Windows image query invalid surrogate pair"))
        expect(windows_image_decode([67, 58, 92, 65536, 0], 4, 8)).to_equal(Err("Windows image query invalid UTF16 unit"))
    it "REQ-WIN-IMAGE-002 rejects missing terminator embedded NUL and relative paths":
        expect(windows_image_decode([67, 58, 92, 1], 3, 8)).to_equal(Err("Windows image query missing terminator"))
        expect(windows_image_decode([67, 58, 92, 0, 65, 0], 5, 8)).to_equal(Err("Windows image query invalid UTF16 unit"))
        expect(windows_image_decode([65, 0], 1, 8)).to_equal(Err("Windows image query returned a relative path"))
