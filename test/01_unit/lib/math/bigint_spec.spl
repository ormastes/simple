# @cover src/lib/common/math/bigint.spl 80%
# @manual_section: Shared bigint module — Montgomery and Barrett reducers
"""
## Purpose and audience
Unit coverage for `src/lib/common/math/bigint.spl`, the shared 30-bit-limb
bigint module required by
doc/03_plan/lib/crypto/rsa_modexp_montgomery_barrett.md Phase 1-3.

## Operator workflow
bin/simple test test/01_unit/lib/math/bigint_spec.spl

## Compatibility and limitations
Every modular-exponentiation result is compared against `_ref_pow_mod`, a
square-and-multiply reference built only from schoolbook multiply and
`bi_mod` — it shares no code with either reducer under test, so an error in
the Montgomery or Barrett path cannot cancel out against the oracle.
"""
# doc-path: doc/03_plan/lib/crypto/rsa_modexp_montgomery_barrett.md

use std.spec.step
use std.common.math.bigint.{
    bi_normalize, bi_cmp, bi_add, bi_sub, bi_mul, bi_mod,
    bi_bit_length, bi_get_bit, bi_shift_left, bi_shift_right,
    MontgomeryCtx, bi_montgomery_setup, bi_montgomery_mul,
    bi_to_montgomery, bi_from_montgomery, bi_mod_exp_montgomery,
    BarrettCtx, bi_barrett_setup, bi_barrett_reduce, bi_mod_exp_barrett
}

# Independent reference: square-and-multiply over schoolbook multiply plus
# `bi_mod` (binary long division). Shares no code with Montgomery or Barrett.
fn _ref_pow_mod(base: [i64], exp: [i64], m: [i64]) -> [i64]:
    var acc: [i64] = [1]
    val b = bi_mod(base, m)
    var i = bi_bit_length(exp) - 1
    while i >= 0:
        acc = bi_mod(bi_mul(acc, acc), m)
        if bi_get_bit(exp, i) == 1:
            acc = bi_mod(bi_mul(acc, b), m)
        i = i - 1
    bi_normalize(acc)

# Deterministic 30-bit LCG so the "random inputs" of the plan's acceptance
# criterion are reproducible run to run.
fn _lcg(seed: i64) -> i64:
    (seed * 1103515245 + 12345) & 1073741823

describe "shared bigint module (src/lib/common/math/bigint.spl)":

    it "computes single-limb arithmetic that matches hand-worked values":
        # @req REQ-RSA-MODEXP-004
        step("Multiply, add and subtract single-limb bigints")
        assert_equal(bi_cmp(bi_mul(bi_normalize([6]), bi_normalize([7])), [42]), 0)
        assert_equal(bi_cmp(bi_add(bi_normalize([40]), bi_normalize([2])), [42]), 0)
        assert_equal(bi_cmp(bi_sub(bi_normalize([50]), bi_normalize([8])), [42]), 0)
        step("Bit accessors agree with the binary expansion of 42 = 0b101010")
        assert_equal(bi_bit_length(bi_normalize([42])), 6)
        assert_equal(bi_get_bit(bi_normalize([42]), 0), 0)
        assert_equal(bi_get_bit(bi_normalize([42]), 1), 1)
        assert_equal(bi_get_bit(bi_normalize([42]), 5), 1)

    it "shifts across limb boundaries reversibly":
        # @req REQ-RSA-MODEXP-004
        step("A left shift past two whole limbs then an equal right shift restores the value")
        val v = bi_normalize([948473291, 55512347, 703001])
        assert_equal(bi_cmp(bi_shift_right(bi_shift_left(v, 77), 77), v), 0)
        step("Shifting by one doubles a small value")
        assert_equal(bi_cmp(bi_shift_left(bi_normalize([21]), 1), [42]), 0)

    it "round-trips values through Montgomery form and multiplies correctly":
        # @req REQ-RSA-MODEXP-005
        step("Encode 7 and 3 mod 13, multiply in Montgomery form, decode")
        val m = bi_normalize([13])
        val ctx: MontgomeryCtx = bi_montgomery_setup(m)
        val product = bi_from_montgomery(bi_montgomery_mul(bi_to_montgomery(bi_normalize([7]), ctx), bi_to_montgomery(bi_normalize([3]), ctx), ctx), ctx)
        # oracle: 7*3 = 21, 21 mod 13 = 8, hand-computed.
        assert_equal(bi_cmp(product, [8]), 0)
        step("Encode-then-decode is the identity for every residue mod 13")
        var v: i64 = 0
        var mismatches: i64 = 0
        while v < 13:
            if bi_cmp(bi_from_montgomery(bi_to_montgomery(bi_normalize([v]), ctx), ctx), bi_normalize([v])) != 0:
                mismatches = mismatches + 1
            v = v + 1
        assert_equal(mismatches, 0)

    it "reduces with Barrett exactly as binary long division does":
        # @req REQ-RSA-MODEXP-005
        step("Barrett-reduce a multi-limb product and compare against bi_mod")
        val m = bi_normalize([948473291, 55512347, 703001])
        val bctx: BarrettCtx = bi_barrett_setup(m)
        var seed: i64 = 987654321
        var trial: i64 = 0
        var mismatches: i64 = 0
        while trial < 8:
            seed = _lcg(seed)
            val lo = seed
            seed = _lcg(seed)
            val mid = seed
            seed = _lcg(seed)
            val a = bi_mul(bi_normalize([lo, mid, seed % 703001]), bi_normalize([mid, lo]))
            if bi_cmp(bi_barrett_reduce(a, bctx), bi_mod(a, m)) != 0:
                mismatches = mismatches + 1
            trial = trial + 1
        assert_equal(mismatches, 0)

    it "agrees between Montgomery, Barrett and the schoolbook reference on every vector":
        # @req REQ-RSA-MODEXP-005
        step("Both reducers must equal the independent square-and-multiply reference — the cross-check the plan's correctness risk calls for")
        val m = bi_normalize([948473291, 55512347, 703001])
        var seed: i64 = 123456789
        var trial: i64 = 0
        var mont_mismatches: i64 = 0
        var barrett_mismatches: i64 = 0
        var cross_mismatches: i64 = 0
        while trial < 6:
            seed = _lcg(seed)
            val b0 = seed
            seed = _lcg(seed)
            val b1 = seed
            seed = _lcg(seed)
            val base = bi_normalize([b0, b1, seed % 703001])
            seed = _lcg(seed)
            val e = bi_normalize([seed, 65537])
            val reference = _ref_pow_mod(base, e, m)
            val montgomery = bi_mod_exp_montgomery(base, e, m)
            val barrett = bi_mod_exp_barrett(base, e, m)
            if bi_cmp(reference, montgomery) != 0:
                mont_mismatches = mont_mismatches + 1
            if bi_cmp(reference, barrett) != 0:
                barrett_mismatches = barrett_mismatches + 1
            if bi_cmp(montgomery, barrett) != 0:
                cross_mismatches = cross_mismatches + 1
            trial = trial + 1
        assert_equal(mont_mismatches, 0)
        assert_equal(barrett_mismatches, 0)
        assert_equal(cross_mismatches, 0)
        step("Small hand-checkable vector: 7^3 mod 13 = 343 mod 13 = 5")
        assert_equal(bi_cmp(bi_mod_exp_montgomery(bi_normalize([7]), bi_normalize([3]), bi_normalize([13])), [5]), 0)
        assert_equal(bi_cmp(bi_mod_exp_barrett(bi_normalize([7]), bi_normalize([3]), bi_normalize([13])), [5]), 0)

    it "refuses an even modulus rather than returning a wrong Montgomery result":
        # @req REQ-RSA-MODEXP-005
        step("Montgomery needs n odd; an even modulus must yield the zero sentinel, not silent garbage")
        val even_ctx: MontgomeryCtx = bi_montgomery_setup(bi_normalize([12]))
        assert_equal(even_ctx.n_prime, 0)
        assert_equal(bi_cmp(bi_mod_exp_montgomery(bi_normalize([7]), bi_normalize([3]), bi_normalize([12])), [0]), 0)
