# Native source-authority repair intent. Execution UNRUN: admitted runtime required.
use std.spec.*
use std.spec.step
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.env_ops.{cwd}
use std.nogc_sync_mut.ffi.io.{path_absolute}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write, file_read, file_exists, file_delete}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use std.test_runner.test_result_wrapper.{preprocess_spipe_native_result_file_in}
use std.test_runner.test_runner_execute.{native_test_compile_args_with_threads}
use std.nogc_sync_mut.test_runner.native_test_source_stage.{NativeTestSourceStageV1, native_test_stage_source_v1, native_test_cleanup_source_v1}
use app.cli.native_build_main.{native_build_authority_request_v1}

fn item4_native_authority_root() -> text:
    match secure_temp_dir(get_temp_dir(), "item4-native-authority-"):
        Ok(path): path.replace("\\", "/")
        Err(message): panic(message)

describe "native generated source authority owner":
    it "stages exact transformed spec bytes uniquely inside the actual checkout":
        step("Transform a genuine spec suffix through the production wrapper")
        val root = item4_native_authority_root()
        val source = root + "/input_spec.spl"
        val authored = "describe \"staged owner\":\n    it \"checks arithmetic\":\n        expect(17 + 25).to_equal(42)\n"
        val wrote = file_write(source, authored)
        expect(wrote).to_be(true)
        if not wrote: return
        val transformed = preprocess_spipe_native_result_file_in(source, root)
        val transformed_ok = transformed != source and transformed.len() > 0 and file_exists(transformed)
        expect(transformed_ok).to_be(true)
        if not transformed_ok: return
        val bytes = file_read(transformed)
        expect(bytes == authored).to_be(false)
        step("Stage generated bytes under checkout authority")
        val checkout = path_absolute(cwd()).replace("\\", "/")
        val first_result = native_test_stage_source_v1(checkout, transformed)
        expect(first_result.is_ok()).to_be(true)
        if first_result.is_err(): return
        val first = first_result.unwrap()
        val second_result = native_test_stage_source_v1(checkout, transformed)
        expect(second_result.is_ok()).to_be(true)
        if second_result.is_err():
            native_test_cleanup_source_v1(first, false)
            return
        val second = second_result.unwrap()
        expect(first.directory.starts_with(checkout + "/test/native-generated-")).to_be(true)
        expect(first.path).to_equal(first.directory + "/entry.spl")
        expect(first.path.ends_with("_spec.spl")).to_be(false)
        expect(first.directory == second.directory).to_be(false)
        expect(file_read(first.path)).to_equal(bytes)
        expect(file_read(second.path)).to_equal(bytes)
        step("Retain then remove only owned generated artifacts")
        expect(native_test_cleanup_source_v1(first, true)).to_be(true)
        expect(file_exists(first.path)).to_be(true)
        expect(native_test_cleanup_source_v1(first, false)).to_be(true)
        expect(file_exists(first.path)).to_be(false)
        expect(native_test_cleanup_source_v1(second, false)).to_be(true)
        expect(file_read(source)).to_equal(authored)
        expect(file_read(transformed)).to_equal(bytes)
        expect(file_delete(transformed)).to_be(true)
        expect(file_delete(source)).to_be(true)
        expect(dir_remove(root, false)).to_be(true)

    it "consumes refresh only at the coordinator and preserves all other arguments":
        step("Parse the actual coordinator authority request")
        val args = ["--entry", "test/native-generated-owned/entry.spl", "--refresh-source-authority", "--output", "build/owned"]
        val parsed = native_build_authority_request_v1(args, false)
        expect(parsed.is_ok()).to_be(true)
        if parsed.is_err(): return
        expect(parsed.unwrap().refresh).to_be(true)
        expect(parsed.unwrap().args).to_equal(["--entry", "test/native-generated-owned/entry.spl", "--output", "build/owned"])
        val ordinary_args = ["--entry", "src/app/main.spl"]
        val ordinary = native_build_authority_request_v1(ordinary_args, false)
        expect(ordinary.is_ok()).to_be(true)
        if ordinary.is_err(): return
        expect(ordinary.unwrap().refresh).to_be(false)
        expect(ordinary.unwrap().args).to_equal(ordinary_args)
        val duplicate = native_build_authority_request_v1(["--refresh-source-authority", "--refresh-source-authority"], false)
        expect(duplicate.is_err()).to_be(true)
        if duplicate.is_ok(): return
        expect(duplicate.unwrap_err()).to_contain("duplicate")
        val worker = native_build_authority_request_v1(args, true)
        expect(worker.is_err()).to_be(true)
        if worker.is_ok(): return
        expect(worker.unwrap_err()).to_contain("internal worker")

    it "requests refreshed default source discovery from the real native compile argv owner":
        step("Construct compile arguments for the staged entry")
        val args = native_test_compile_args_with_threads("test/native-generated-owned/entry.spl", "build/owned", "llvm", 3)
        expect(args).to_contain("--refresh-source-authority")
        expect(args.contains("--source")).to_be(false)
        expect(args.contains("src/lib")).to_be(false)
        expect(args).to_contain("--entry-closure")
        expect(args).to_contain("test/native-generated-owned/entry.spl")
        expect(args).to_contain("llvm")
        expect(args).to_contain("core-c-bootstrap")
        expect(args).to_contain("3")
        expect(args).to_contain("build/owned.cache")
