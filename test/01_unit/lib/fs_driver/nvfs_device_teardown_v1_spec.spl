"""Static specifications for owned NVFS/DBFS teardown. Not executed here."""

use std.spec.*
use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.fs_driver.nvfs_posix_driver.{NvfsPosixDriver}
use std.fs_driver.types.{Path, OpenFlags}
use std.fs_driver.error.{FsError}
use std.db.dbfs_driver.device_commit_owner.{dbfs_device_registration_count}

describe "owned NVFS device teardown v1":
    it "unregisters exactly once and makes copied drivers stale":
        val before = dbfs_device_registration_count()
        var driver = NvfsPosixDriver.new_on_owned_device(
            "owned-normal", MemBlockDevice.new(1024u64, 512u32),
            70001u64, 0, 1024).unwrap()
        var copied = driver
        expect(driver.close_owned_device().unwrap()).to_equal(true)
        expect(dbfs_device_registration_count()).to_equal(before)
        expect(copied.root().unwrap_err()).to_equal(FsError.StaleHandle)
        expect(copied.close_owned_device().unwrap_err()).to_equal(FsError.StaleHandle)

    it "refuses busy close and permits one retry after the handle closes":
        val before = dbfs_device_registration_count()
        var driver = NvfsPosixDriver.new_on_owned_device(
            "owned-busy", MemBlockDevice.new(1024u64, 512u32),
            70002u64, 0, 1024).unwrap()
        val handle = driver.open_path(
            Path(raw: "/busy"), OpenFlags.write_only().with_create()).unwrap()
        expect(driver.close_owned_device().unwrap_err()).to_equal(FsError.Busy)
        expect(dbfs_device_registration_count()).to_equal(before + 1)
        expect(driver.close_handle(handle).is_ok()).to_equal(true)
        expect(driver.close_owned_device().unwrap()).to_equal(true)
        expect(dbfs_device_registration_count()).to_equal(before)

    it "binds cleanup to the immutable owner identity instead of mutable copies":
        var first = NvfsPosixDriver.new_on_owned_device(
            "owned-first", MemBlockDevice.new(1024u64, 512u32),
            70003u64, 0, 1024).unwrap()
        var second = NvfsPosixDriver.new_on_owned_device(
            "owned-second", MemBlockDevice.new(1024u64, 512u32),
            70004u64, 0, 1024).unwrap()
        var forged = first
        forged.inst_id = second.inst_id
        expect(forged.close_owned_device().unwrap_err()).to_equal(FsError.StaleHandle)
        expect(second.root().is_ok()).to_equal(true)
        expect(first.close_owned_device().unwrap()).to_equal(true)
        expect(second.close_owned_device().unwrap()).to_equal(true)

    it "treats directory descriptors as busy and provides a release path":
        var driver = NvfsPosixDriver.new_on_owned_device(
            "owned-directory", MemBlockDevice.new(1024u64, 512u32),
            70005u64, 0, 1024).unwrap()
        val directory = driver.opendir_path(Path(raw: "/")).unwrap()
        expect(driver.close_owned_device().unwrap_err()).to_equal(FsError.Busy)
        expect(driver.close_dir_handle(directory).is_ok()).to_equal(true)
        expect(driver.close_owned_device().unwrap()).to_equal(true)
