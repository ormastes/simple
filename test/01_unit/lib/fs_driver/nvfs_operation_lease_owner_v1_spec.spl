"""Static lifecycle coverage for the bounded NVFS operation owner. Not run here."""

use std.spec.*
use std.fs_driver.nvfs_device_identity_owner_v1.*
use std.fs_driver.nvfs_operation_lease_owner_v1.*

fn _operation_binding(owner_id: u64, inner_id: i64) -> (
    NvfsDeviceIdentityBindingV1, NvfsDeviceRegionIdentityV1
):
    val region = NvfsDeviceRegionIdentityV1(
        device_owner_id: owner_id, base_block: 0, block_count: 1024)
    val reservation = nvfs_device_identity_reserve_v1(region).unwrap()
    val binding = nvfs_device_identity_activate_v1(reservation, inner_id).unwrap()
    expect(nvfs_operation_owner_register_v1(
        binding, binding.outer_instance_id(), inner_id, region).unwrap()).to_be(true)
    (binding, region)

fn _finish_operation_binding(
    binding: NvfsDeviceIdentityBindingV1,
    fence: NvfsOperationCloseFenceV1
):
    expect(nvfs_operation_close_complete_v1(fence).unwrap()).to_be(true)
    expect(nvfs_device_identity_mark_terminal_v1(binding).unwrap()).to_be(true)
    expect(nvfs_device_identity_evict_terminal_v1(binding).unwrap()).to_be(true)

describe "NVFS operation lease owner v1":
    it "serializes copied bindings and rejects replayed operation leases":
        val pair = _operation_binding(81001u64, 91001)
        val binding = pair[0]
        val region = pair[1]
        val lease = nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91001, region).unwrap()
        expect(nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91001, region).unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Busy)
        expect(nvfs_operation_end_v1(lease).unwrap()).to_be(true)
        expect(nvfs_operation_end_v1(lease).unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Replay)
        val fence = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91001, region).unwrap()
        _finish_operation_binding(binding, fence)

    it "fences new operations while close drains and permits one retry":
        val pair = _operation_binding(81002u64, 91002)
        val binding = pair[0]
        val region = pair[1]
        val lease = nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91002, region).unwrap()
        expect(nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91002, region).unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Busy)
        expect(nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91002, region).unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Closing)
        expect(nvfs_operation_end_v1(lease).unwrap()).to_be(true)
        val fence = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91002, region).unwrap()
        expect(nvfs_operation_close_retryable_v1(fence).unwrap()).to_be(true)
        val retry = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91002, region).unwrap()
        _finish_operation_binding(binding, retry)

    it "restores operation admission after a determinate busy preflight":
        val pair = _operation_binding(81003u64, 91003)
        val binding = pair[0]
        val region = pair[1]
        val fence = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91003, region).unwrap()
        expect(nvfs_operation_close_busy_v1(fence).unwrap()).to_be(true)
        val lease = nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91003, region).unwrap()
        expect(nvfs_operation_end_v1(lease).unwrap()).to_be(true)
        val final_fence = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91003, region).unwrap()
        _finish_operation_binding(binding, final_fence)

    it "serializes hosted global state against an owned-device operation":
        val pair = _operation_binding(81004u64, 91004)
        val binding = pair[0]
        val region = pair[1]
        val hosted = nvfs_global_operation_begin_v1().unwrap()
        expect(nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91004, region).unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Busy)
        expect(nvfs_operation_end_v1(hosted).unwrap()).to_be(true)
        val owned = nvfs_operation_begin_v1(
            binding, binding.outer_instance_id(), 91004, region).unwrap()
        expect(nvfs_global_operation_begin_v1().unwrap_err()
        ).to_equal(NvfsOperationLeaseErrorV1.Busy)
        expect(nvfs_operation_end_v1(owned).unwrap()).to_be(true)
        val fence = nvfs_operation_begin_close_v1(
            binding, binding.outer_instance_id(), 91004, region).unwrap()
        _finish_operation_binding(binding, fence)

    it "retains a terminal identity as fail-stop quarantine when it cannot be evicted":
        val region = NvfsDeviceRegionIdentityV1(
            device_owner_id: 81005u64, base_block: 0, block_count: 1024)
        val reservation = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reservation, 91005).unwrap()
        expect(nvfs_device_identity_mark_terminal_v1(binding).unwrap()).to_be(true)
        val before = nvfs_device_identity_quarantined_count_v1()
        expect(nvfs_device_identity_quarantine_terminal_v1(binding).unwrap()).to_be(true)
        expect(nvfs_device_identity_quarantined_count_v1()).to_equal(before + 1)
