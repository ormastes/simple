"""Static lifecycle coverage for the unwired NVFS device identity owner."""

use std.spec.*
use std.fs_driver.nvfs_device_identity_owner_v1.*

fn _nvfs_region_v1(device: u64, base: i64) -> NvfsDeviceRegionIdentityV1:
    NvfsDeviceRegionIdentityV1(
        device_owner_id: device, base_block: base, block_count: 128)

describe "NVFS outer to inner device identity owner v1":
    it "reserves before activation and validates the exact complete binding":
        val region = _nvfs_region_v1(8101u64, 64)
        val reserved = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reserved, 9101).unwrap()
        expect(binding.outer_instance_id()).to_equal(reserved.outer_instance_id())
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id(), 9101, region).is_ok()).to_be(true)
        expect(nvfs_device_identity_mark_terminal_v1(binding).is_ok()).to_be(true)
        expect(nvfs_device_identity_evict_terminal_v1(binding).is_ok()).to_be(true)

    it "rejects mutable outer identity and inner or device substitution":
        val region = _nvfs_region_v1(8102u64, 256)
        val reserved = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reserved, 9102).unwrap()
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id() + 1, 9102, region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.BindingMismatch)
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id(), 9992, region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.BindingMismatch)
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id(), 9102,
            _nvfs_region_v1(8192u64, 256)).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.BindingMismatch)
        expect(nvfs_device_identity_mark_terminal_v1(binding).is_ok()).to_be(true)
        expect(nvfs_device_identity_evict_terminal_v1(binding).is_ok()).to_be(true)

    it "makes copied bindings stale after terminal eviction and slot reuse":
        val first_region = _nvfs_region_v1(8103u64, 512)
        val first_reservation = nvfs_device_identity_reserve_v1(first_region).unwrap()
        val stale = nvfs_device_identity_activate_v1(first_reservation, 9103).unwrap()
        expect(nvfs_device_identity_mark_terminal_v1(stale).is_ok()).to_be(true)
        expect(nvfs_device_identity_evict_terminal_v1(stale).is_ok()).to_be(true)
        val second_region = _nvfs_region_v1(8104u64, 768)
        val second_reservation = nvfs_device_identity_reserve_v1(second_region).unwrap()
        val current = nvfs_device_identity_activate_v1(second_reservation, 9104).unwrap()
        expect(current.generation()).to_be_greater_than(stale.generation())
        expect(nvfs_device_identity_validate_v1(
            stale, stale.outer_instance_id(), 9103, first_region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.StaleIdentity)
        expect(nvfs_device_identity_validate_v1(
            current, current.outer_instance_id(), 9104, second_region).is_ok()).to_be(true)
        expect(nvfs_device_identity_mark_terminal_v1(current).is_ok()).to_be(true)
        expect(nvfs_device_identity_evict_terminal_v1(current).is_ok()).to_be(true)

    it "retains terminal identity until explicit eviction and rejects replay":
        val region = _nvfs_region_v1(8105u64, 1024)
        val reservation = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reservation, 9105).unwrap()
        expect(nvfs_device_identity_mark_terminal_v1(binding).is_ok()).to_be(true)
        expect(nvfs_device_identity_mark_terminal_v1(binding).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.WrongState)
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id(), 9105, region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.WrongState)
        expect(nvfs_device_identity_evict_terminal_v1(binding).is_ok()).to_be(true)
        expect(nvfs_device_identity_evict_terminal_v1(binding).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.StaleIdentity)

    it "supports pre-registration rollback and bounded fail-stop quarantine":
        val rollback_region = _nvfs_region_v1(8106u64, 1280)
        val live_before = nvfs_device_identity_live_count_v1()
        val rollback = nvfs_device_identity_reserve_v1(rollback_region).unwrap()
        expect(nvfs_device_identity_abort_reservation_v1(rollback).is_ok()).to_be(true)
        val invalid_activation = nvfs_device_identity_activate_v1(rollback, 9106)
        expect(invalid_activation.unwrap_err()).to_equal(NvfsDeviceIdentityErrorV1.StaleIdentity)
        expect(nvfs_device_identity_live_count_v1()).to_equal(live_before)
        val replacement = nvfs_device_identity_reserve_v1(rollback_region).unwrap()
        expect(replacement.generation()).to_be_greater_than(rollback.generation())
        expect(nvfs_device_identity_abort_reservation_v1(replacement).is_ok()).to_be(true)
        expect(nvfs_device_identity_live_count_v1()).to_equal(live_before)

        val region = _nvfs_region_v1(8107u64, 1536)
        val reservation = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reservation, 9107).unwrap()
        val before = nvfs_device_identity_quarantined_count_v1()
        expect(nvfs_device_identity_mark_indeterminate_v1(binding).is_ok()).to_be(true)
        expect(nvfs_device_identity_quarantined_count_v1()).to_equal(before + 1)
        expect(nvfs_device_identity_validate_v1(
            binding, binding.outer_instance_id(), 9107, region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.WrongState)

    it "rejects overlapping regions for one device but permits adjacency":
        val first = NvfsDeviceRegionIdentityV1(
            device_owner_id: 8108u64, base_block: 2048, block_count: 128)
        val overlap = NvfsDeviceRegionIdentityV1(
            device_owner_id: 8108u64, base_block: 2100, block_count: 128)
        val adjacent = NvfsDeviceRegionIdentityV1(
            device_owner_id: 8108u64, base_block: 2176, block_count: 128)
        val first_reservation = nvfs_device_identity_reserve_v1(first).unwrap()
        expect(nvfs_device_identity_reserve_v1(overlap).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.BindingMismatch)
        val adjacent_reservation = nvfs_device_identity_reserve_v1(adjacent).unwrap()
        expect(nvfs_device_identity_abort_reservation_v1(first_reservation).is_ok()).to_be(true)
        expect(nvfs_device_identity_abort_reservation_v1(adjacent_reservation).is_ok()).to_be(true)

    it "serializes busy rollback, retryable cleanup, and terminal completion":
        val region = _nvfs_region_v1(8109u64, 2304)
        val reservation = nvfs_device_identity_reserve_v1(region).unwrap()
        val binding = nvfs_device_identity_activate_v1(reservation, 9109).unwrap()
        val busy = nvfs_device_identity_begin_close_v1(
            binding, binding.outer_instance_id(), 9109, region).unwrap()
        expect(nvfs_device_identity_begin_close_v1(
            binding, binding.outer_instance_id(), 9109, region).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.WrongState)
        expect(nvfs_device_identity_close_busy_v1(busy).is_ok()).to_be(true)
        val retry = nvfs_device_identity_begin_close_v1(
            binding, binding.outer_instance_id(), 9109, region).unwrap()
        expect(nvfs_device_identity_close_retryable_v1(retry).is_ok()).to_be(true)
        val final_ticket = nvfs_device_identity_begin_close_v1(
            binding, binding.outer_instance_id(), 9109, region).unwrap()
        expect(nvfs_device_identity_close_complete_v1(final_ticket).is_ok()).to_be(true)
        expect(nvfs_device_identity_close_complete_v1(final_ticket).unwrap_err()
        ).to_equal(NvfsDeviceIdentityErrorV1.WrongState)
        expect(nvfs_device_identity_evict_terminal_v1(binding).is_ok()).to_be(true)
