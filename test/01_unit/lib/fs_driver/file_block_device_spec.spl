use std.spipe.*
use std.fs_driver.file_block_device.{FileBlockDevice}
use std.fs_driver.block_device.{BlockDevice}
use std.io.file.{File}

val FILE_BLOCK_DEVICE_SPEC_PATH = "/tmp/simple_file_block_device_spec.img"

fn filled_sector(size: i64, value: u8) -> [u8]:
    var bytes: [u8] = []
    var i: i64 = 0
    while i < size:
        bytes.push(value)
        i = i + 1
    bytes

describe "FileBlockDevice":
    it "creates exact geometry and persists exact sector writes":
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)
        var device = FileBlockDevice.create(FILE_BLOCK_DEVICE_SPEC_PATH, 4u64, 512u32).unwrap()
        val payload = filled_sector(512, 0x5au8)
        expect(device.sector_size()).to_equal(512u32)
        expect(device.sector_count()).to_equal(4u64)
        expect(device.write_sector(2u64, payload).unwrap()).to_equal(true)
        expect(device.has_unflushed_writes()).to_equal(true)
        expect(device.close().is_err()).to_equal(true)
        expect(device.flush_and_close().unwrap()).to_equal(true)

        var reopened = FileBlockDevice.open(FILE_BLOCK_DEVICE_SPEC_PATH, 512u32).unwrap()
        expect(reopened.read_sector(2u64).unwrap()).to_equal(payload)
        expect(reopened.close().unwrap()).to_equal(true)
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)

    it "rejects short, long, and out-of-range sector operations":
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)
        var device = FileBlockDevice.create(FILE_BLOCK_DEVICE_SPEC_PATH, 2u64, 512u32).unwrap()
        expect(device.write_sector(0u64, filled_sector(511, 1u8)).is_err()).to_equal(true)
        expect(device.write_sector(0u64, filled_sector(513, 1u8)).is_err()).to_equal(true)
        expect(device.read_sector(2u64).is_err()).to_equal(true)
        expect(device.write_sector(2u64, filled_sector(512, 1u8)).is_err()).to_equal(true)
        expect(device.close().unwrap()).to_equal(true)
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)

    it "keeps one close authority across copied adapter values":
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)
        var device = FileBlockDevice.create(FILE_BLOCK_DEVICE_SPEC_PATH, 2u64, 512u32).unwrap()
        var copied = device
        expect(copied.is_open()).to_equal(true)
        expect(copied.close().unwrap()).to_equal(true)
        expect(device.is_open()).to_equal(false)
        expect(device.close().is_err()).to_equal(true)
        val _ = File.delete(FILE_BLOCK_DEVICE_SPEC_PATH)

    it "rejects invalid and overflowing image geometry":
        expect(FileBlockDevice.create(FILE_BLOCK_DEVICE_SPEC_PATH, 1u64, 0u32).is_err()).to_equal(true)
        expect(FileBlockDevice.create(FILE_BLOCK_DEVICE_SPEC_PATH, 9223372036854775807u64, 512u32).is_err()).to_equal(true)
