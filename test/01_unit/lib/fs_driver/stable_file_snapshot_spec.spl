"""Generation-bound, bounded stable-file snapshots across filesystem backends."""

use std.spec.*
use std.db.dbfs_driver.{DbFsDriver}
use std.fs_driver.error.{FsError}
use std.fs_driver.fat32_stub.{FsFat32Driver}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.mount_table.{MountTable, PositionedDriverKind, StableFileSnapshotLeaseV1, StableFileSnapshotSealV1}
use std.fs_driver.nvfs_driver.{NvfsDriver}
use std.fs_driver.types.{MountOptions, OpenFlags, ExecuteTrust}

val SNAPSHOT_SHA256_A: text = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
val SNAPSHOT_SHA256_B: text = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn dbfs_table_with_bytes(path: text, data: [u8]) -> MountTable:
    var table = MountTable.new()
    table.mount("/", DriverInstance.DbFs(DbFsDriver.new_hosted()), MountOptions.default()).unwrap()
    val file = table.open(path, OpenFlags.create_write()).unwrap()
    table.positioned_write_bytes(file.id, PositionedDriverKind.Dbfs, 0u64, data).unwrap()
    table.close(file).unwrap()
    table

fn nvfs_table_with_bytes(path: text, data: [u8]) -> MountTable:
    var table = MountTable.new()
    table.mount("/", DriverInstance.Nvfs(NvfsDriver.new("stable-snapshot")), MountOptions.default()).unwrap()
    val file = table.open(path, OpenFlags.create_write()).unwrap()
    table.positioned_write_bytes(file.id, PositionedDriverKind.Nvfs, 0u64, data).unwrap()
    table.close(file).unwrap()
    table

describe "stable file snapshot leases":
    it "returns independently owned binary chunks with exact EOF on DBFS and NVFS":
        var dbfs = dbfs_table_with_bytes("/payload.bin", [0u8, 1u8, 255u8, 4u8])
        val db = dbfs.open_stable_snapshot("/payload.bin", 16u64).unwrap()
        var first = dbfs.read_stable_snapshot(db.lease, 1u64, 3u64).unwrap()
        expect(first).to_equal([1u8, 255u8, 4u8])
        first[0] = 99u8
        expect(dbfs.read_stable_snapshot(db.lease, 1u64, 3u64).unwrap()).to_equal([1u8, 255u8, 4u8])
        expect(dbfs.read_stable_snapshot(db.lease, 4u64, 1u64).unwrap()).to_equal([])
        dbfs.close_stable_snapshot(db.lease).unwrap()

        var nvfs = nvfs_table_with_bytes("/payload.bin", [9u8, 0u8, 8u8, 7u8])
        val nv = nvfs.open_stable_snapshot("/payload.bin", 16u64).unwrap()
        expect(nvfs.read_stable_snapshot(nv.lease, 2u64, 64u64).unwrap()).to_equal([8u8, 7u8])
        nvfs.close_stable_snapshot(nv.lease).unwrap()

    it "uses true FAT32 offsets and short EOF without cursor coupling":
        var fat = FsFat32Driver.new_ram_backed_with_file("HELLO.BIN", "abcdef")
        var table = MountTable.new()
        table.mount("/", DriverInstance.Fat32(fat), MountOptions.default()).unwrap()
        val snapshot = table.open_stable_snapshot("/HELLO.BIN", 16u64).unwrap()
        var full = table.read_stable_snapshot(snapshot.lease, 3u64, 2u64).unwrap()
        expect(full).to_equal([100u8, 101u8])
        full[0] = 0u8
        expect(table.read_stable_snapshot(
            snapshot.lease, 3u64, 2u64).unwrap()).to_equal([100u8, 101u8])
        expect(table.read_stable_snapshot(snapshot.lease, 1u64, 2u64).unwrap()).to_equal([98u8, 99u8])
        expect(table.read_stable_snapshot(snapshot.lease, 5u64, 8u64).unwrap()).to_equal([102u8])
        table.close_stable_snapshot(snapshot.lease).unwrap()

    it "rejects malformed ranges forged leases oversize files and close replay":
        var table = dbfs_table_with_bytes("/bounded.bin", [1u8, 2u8, 3u8])
        expect(table.open_stable_snapshot("/bounded.bin", 2u64).unwrap_err()).to_equal(FsError.TooLarge)
        val snapshot = table.open_stable_snapshot("/bounded.bin", 3u64).unwrap()
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 0u64).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 65537u64).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(table.read_stable_snapshot(snapshot.lease, 0xffffffffffffffffu64, 2u64).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(table.read_stable_snapshot(StableFileSnapshotLeaseV1(id: 1u64), 0u64, 1u64).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close_stable_snapshot(snapshot.lease).unwrap()
        expect(table.close_stable_snapshot(snapshot.lease).unwrap_err()).to_equal(FsError.StaleHandle)
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 1u64).unwrap_err()).to_equal(FsError.StaleHandle)

    it "invalidates reads on content or namespace changes but permits one close":
        var table = dbfs_table_with_bytes("/mutable.bin", [10u8, 20u8, 30u8])
        val stale_content = table.open_stable_snapshot("/mutable.bin", 16u64).unwrap()
        val writer = table.open("/mutable.bin", OpenFlags.write_only()).unwrap()
        table.positioned_write_bytes(writer.id, PositionedDriverKind.Dbfs, 1u64, [99u8]).unwrap()
        expect(table.read_stable_snapshot(stale_content.lease, 0u64, 3u64).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close_stable_snapshot(stale_content.lease).unwrap()
        table.close(writer).unwrap()

        val stale_namespace = table.open_stable_snapshot("/mutable.bin", 16u64).unwrap()
        table.mkdir("/other", 0o755).unwrap()
        expect(table.read_stable_snapshot(stale_namespace.lease, 0u64, 1u64).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close_stable_snapshot(stale_namespace.lease).unwrap()

    it "blocks unmount while leased and prevents replay after slot reuse":
        var table = nvfs_table_with_bytes("/leased.bin", [4u8, 5u8])
        val first = table.open_stable_snapshot("/leased.bin", 8u64).unwrap()
        expect(table.unmount("/").unwrap_err()).to_equal(FsError.Busy)
        table.close_stable_snapshot(first.lease).unwrap()
        val second = table.open_stable_snapshot("/leased.bin", 8u64).unwrap()
        expect(second.lease.id == first.lease.id).to_be(false)
        expect(table.read_stable_snapshot(first.lease, 0u64, 1u64).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close_stable_snapshot(second.lease).unwrap()
        table.unmount("/").unwrap()

    it "keeps snapshot mount identity stable across unrelated unmount and slot reuse":
        var table = MountTable.new()
        table.mount("/first", DriverInstance.DbFs(DbFsDriver.new_hosted()), MountOptions.default()).unwrap()
        table.mount("/kept", DriverInstance.DbFs(DbFsDriver.new_hosted()), MountOptions.default()).unwrap()
        val file = table.open("/kept/payload.bin", OpenFlags.create_write()).unwrap()
        table.positioned_write_bytes(
            file.id, PositionedDriverKind.Dbfs, 0u64, [7u8, 8u8, 9u8]).unwrap()
        table.close(file).unwrap()
        val snapshot = table.open_stable_snapshot("/kept/payload.bin", 8u64).unwrap()

        # Removing the earlier compact-list entry must not renumber the live
        # snapshot's stable identity. Reusing that freed slot must also not
        # alias the still-live binding because MountId is checked with the slot.
        table.unmount("/first").unwrap()
        table.mount("/replacement", DriverInstance.DbFs(DbFsDriver.new_hosted()), MountOptions.default()).unwrap()
        expect(table.read_stable_snapshot(
            snapshot.lease, 0u64, 3u64).unwrap()).to_equal([7u8, 8u8, 9u8])
        table.close_stable_snapshot(snapshot.lease).unwrap()

    it "finishes into immutable owner metadata without closing the lease":
        var table = dbfs_table_with_bytes("/sealed.bin", [97u8, 98u8, 99u8])
        val snapshot = table.open_stable_snapshot("/sealed.bin", 8u64).unwrap()
        table.begin_stable_snapshot_promotion_hash_v1(snapshot.lease).unwrap()
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 3u64).unwrap()).to_equal([97u8, 98u8, 99u8])
        val seal = table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_A).unwrap()
        expect(seal.lease_id).to_equal(snapshot.lease.id)
        expect(seal.size).to_equal(3u64)
        expect(seal.content_sha256).to_equal(SNAPSHOT_SHA256_A)
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 1u64).unwrap_err()).to_equal(FsError.StaleHandle)
        val repeated = table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_A).unwrap()
        expect(repeated.lease_id).to_equal(seal.lease_id)
        expect(repeated.content_sha256).to_equal(seal.content_sha256)
        expect(table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_B).unwrap_err()).to_equal(FsError.Permission)
        table.close_stable_snapshot(snapshot.lease).unwrap()
        expect(table.close_stable_snapshot(snapshot.lease).unwrap_err()).to_equal(FsError.StaleHandle)

    it "promotes the existing handle once without reopening the path":
        var table = nvfs_table_with_bytes("/program.bin", [97u8, 98u8, 99u8])
        val snapshot = table.open_stable_snapshot("/program.bin", 8u64).unwrap()
        expect(table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_A).unwrap_err()).to_equal(FsError.InvalidArg)
        table.begin_stable_snapshot_promotion_hash_v1(snapshot.lease).unwrap()
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 3u64).unwrap()).to_equal([97u8, 98u8, 99u8])
        val seal = table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_A).unwrap()
        val execute = table.promote_stable_snapshot_for_execute_v1(
            snapshot.lease, seal, ExecuteTrust.Trusted).unwrap()
        expect(execute.size).to_equal(3)
        expect(execute.canonical_source_path).to_equal("/program.bin")
        expect(table.execute_binding_is_current(execute)).to_be(true)
        expect(table.promote_stable_snapshot_for_execute_v1(
            snapshot.lease, seal, ExecuteTrust.Trusted).unwrap_err()).to_equal(FsError.StaleHandle)
        expect(table.close_stable_snapshot(snapshot.lease).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close(execute.file_handle).unwrap()

    it "fails closed on forged seal policy denial and generation change":
        var table = dbfs_table_with_bytes("/policy.bin", [97u8, 98u8, 99u8])
        val snapshot = table.open_stable_snapshot("/policy.bin", 8u64).unwrap()
        table.begin_stable_snapshot_promotion_hash_v1(snapshot.lease).unwrap()
        expect(table.read_stable_snapshot(snapshot.lease, 0u64, 3u64).unwrap()).to_equal([97u8, 98u8, 99u8])
        val seal = table.finish_stable_snapshot_v1(snapshot.lease, SNAPSHOT_SHA256_A).unwrap()
        val forged = StableFileSnapshotSealV1(
            lease_id: seal.lease_id, mount_id: seal.mount_id,
            backend_name: "forged", backend_kind: seal.backend_kind,
            canonical_source_path: seal.canonical_source_path,
            mount_generation: seal.mount_generation,
            namespace_generation: seal.namespace_generation,
            content_generation: seal.content_generation, size: seal.size,
            content_sha256: seal.content_sha256)
        expect(table.promote_stable_snapshot_for_execute_v1(
            snapshot.lease, forged, ExecuteTrust.Trusted).unwrap_err()).to_equal(FsError.Permission)
        expect(table.promote_stable_snapshot_for_execute_v1(
            snapshot.lease, seal, ExecuteTrust.Untrusted).unwrap_err()).to_equal(FsError.Permission)
        table.bump_content_generation(seal.mount_id).unwrap()
        expect(table.promote_stable_snapshot_for_execute_v1(
            snapshot.lease, seal, ExecuteTrust.Trusted).unwrap_err()).to_equal(FsError.StaleHandle)
        table.close_stable_snapshot(snapshot.lease).unwrap()

    it "rejects incomplete unordered and digest-mismatched completion":
        var unordered = dbfs_table_with_bytes("/unordered.bin", [97u8, 98u8, 99u8])
        val unordered_snapshot = unordered.open_stable_snapshot("/unordered.bin", 8u64).unwrap()
        unordered.begin_stable_snapshot_promotion_hash_v1(unordered_snapshot.lease).unwrap()
        expect(unordered.read_stable_snapshot(unordered_snapshot.lease, 1u64, 2u64).unwrap()).to_equal([98u8, 99u8])
        expect(unordered.finish_stable_snapshot_v1(
            unordered_snapshot.lease, SNAPSHOT_SHA256_A).unwrap_err()).to_equal(FsError.Corrupt)
        unordered.close_stable_snapshot(unordered_snapshot.lease).unwrap()

        var mismatch = nvfs_table_with_bytes("/mismatch.bin", [97u8, 98u8, 99u8])
        val mismatch_snapshot = mismatch.open_stable_snapshot("/mismatch.bin", 8u64).unwrap()
        mismatch.begin_stable_snapshot_promotion_hash_v1(mismatch_snapshot.lease).unwrap()
        mismatch.read_stable_snapshot(mismatch_snapshot.lease, 0u64, 3u64).unwrap()
        expect(mismatch.finish_stable_snapshot_v1(
            mismatch_snapshot.lease, SNAPSHOT_SHA256_B).unwrap_err()).to_equal(FsError.Corrupt)
        expect(mismatch.finish_stable_snapshot_v1(
            mismatch_snapshot.lease, SNAPSHOT_SHA256_A).unwrap_err()).to_equal(FsError.Corrupt)
        expect(mismatch.read_stable_snapshot(
            mismatch_snapshot.lease, 0u64, 1u64).unwrap_err()).to_equal(FsError.Corrupt)
        mismatch.close_stable_snapshot(mismatch_snapshot.lease).unwrap()

    it "hashes incrementally across the SHA-256 block boundary":
        val sixty_four_as: [u8] = [97u8; 64]
        var table = nvfs_table_with_bytes("/boundary.bin", sixty_four_as)
        val snapshot = table.open_stable_snapshot("/boundary.bin", 64u64).unwrap()
        table.begin_stable_snapshot_promotion_hash_v1(snapshot.lease).unwrap()
        table.read_stable_snapshot(snapshot.lease, 0u64, 31u64).unwrap()
        table.read_stable_snapshot(snapshot.lease, 31u64, 33u64).unwrap()
        val seal = table.finish_stable_snapshot_v1(
            snapshot.lease,
            "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb").unwrap()
        expect(seal.size).to_equal(64u64)
        table.close_stable_snapshot(snapshot.lease).unwrap()

        # One complete update takes the direct full-block path and must produce
        # the same digest as the split partial-block sequence above.
        var direct = nvfs_table_with_bytes("/direct.bin", sixty_four_as)
        val direct_snapshot = direct.open_stable_snapshot("/direct.bin", 64u64).unwrap()
        direct.begin_stable_snapshot_promotion_hash_v1(direct_snapshot.lease).unwrap()
        direct.read_stable_snapshot(direct_snapshot.lease, 0u64, 64u64).unwrap()
        val direct_seal = direct.finish_stable_snapshot_v1(
            direct_snapshot.lease,
            "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb").unwrap()
        expect(direct_seal.content_sha256).to_equal(seal.content_sha256)
        direct.close_stable_snapshot(direct_snapshot.lease).unwrap()
