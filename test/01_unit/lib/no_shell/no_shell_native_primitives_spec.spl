# REPRODUCING SPEC for the /bin/sh runtime dependency
# (sibling of doc/08_tracking/bug/is_dir_always_false_shell_dependency_2026-09-02.md)
#
# Every operation exercised here used to be a `process_run("/bin/sh", ["-c", ...])`
# shell-out. That form cannot run on a bare Windows host -- there is no /bin/sh --
# and under the interpreter process_run returns the -1 failure sentinel for EVERY
# command, so each of these helpers was a latent no-op that reported the falsy
# answer for all inputs. They now call native runtime primitives directly.
#
# WHY BOTH DIRECTIONS ARE ASSERTED: an extern with no runtime backing silently
# returns nil, which is falsy. A spec that only asserted the false case would
# pass just as happily against a completely unbacked primitive. Each case below
# therefore pins a true AND a false, so "always false" cannot masquerade as green.

use std.nogc_sync_mut.shell.dir.{exist}
use std.nogc_sync_mut.shell.env.{cwd}
use std.nogc_sync_mut.env.config.{write_dotenv, source_file}
extern fn rt_file_delete(path: text) -> bool

use std.spec.step

describe "No-shell native primitives":
    it "reports directory existence in both directions (was false for everything)":
        # The shell-out form returned false here even for the repo root.
        expect(exist("src")).to_equal(true)
        expect(exist("src/definitely_not_a_real_directory_zz")).to_equal(false)

    it "returns a real working directory, not the '.' fallback":
        val here = cwd()
        expect(here).to_not_equal(".")
        expect(here).to_not_equal("")
        # Assert on LENGTH as well as content: the lexer silently drops `\`
        # inside string literals, so a path comparison written with escapes can
        # be quietly comparing a different string than it appears to.
        expect(here.len() > 1).to_equal(true)

    it "round-trips a dotenv file with no shell involved":
        # Previously `cat` for the read and `echo '...' >` for the write. The
        # write also appended echo's newline and could not handle a path
        # containing a space; rt_file_write_text writes the bytes exactly.
        val p = "no_shell_spec_roundtrip.env"
        write_dotenv(path: p, vars: [("FOO", "bar"), ("BAZ", "qux")])
        val got = source_file(path: p)
        expect(got.len()).to_equal(2)
        val (k0, v0) = got[0]
        expect(k0).to_equal("FOO")
        expect(v0).to_equal("bar")

        # Clean up: the repo root is fenced by FILE.md manifests and
        # check-workspace-root-guard, so a spec must not leave a file behind.
        val removed = unsafe(capabilities: [ffi]):
            rt_file_delete(p)
        expect(removed).to_equal(true)
