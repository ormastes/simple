# Bounded pure-GC owner contract.
#
# PureGcRuntime is the sole canonical mutable owner. GcHandle is a copied,
# scalar-only bearer that must match owner, generation, slot, and allocation
# authorization. This contract deliberately makes no concurrent-use claim.
use std.spec.*
use std.gc_async_mut.pure.runtime.{
    GcHandle,
    PureGcRuntime,
    RuntimeValue,
    PURE_GC_DEFAULT_CAPACITY,
    PURE_GC_HANDLE_STRIDE,
    PURE_GC_MAX_GENERATION,
    alloc,
    dealloc,
    gc_collect,
    gc_stats,
    pure_gc_runtime_new
}

fn rv(data: text, type_tag: i64) -> RuntimeValue:
    RuntimeValue(data: data, type_tag: type_tag)

describe "pure gc runtime owner":

    it "keeps equal values in distinct authorized slots":
        val heap = pure_gc_runtime_new(4)
        val first = heap.alloc(rv("same", 7))
        val second = heap.alloc(rv("same", 7))
        expect(first.owner_id).to_equal(heap.owner_identity())
        expect(second.owner_id).to_equal(heap.owner_identity())
        expect(first.id).to_be_greater_than(0)
        expect(second.id).to_be_greater_than(first.id)
        expect(second.authorization).to_be_greater_than(first.authorization)
        if val value = heap.get(first):
            expect(value.data).to_equal("same")
        else:
            fail("first authorized allocation was not readable")

    it "rejects cross-owner and malformed bearer values":
        val first_heap = pure_gc_runtime_new(2)
        val second_heap = pure_gc_runtime_new(2)
        val live = first_heap.alloc(rv("owned", 8))
        val wrong_authorization = GcHandle(owner_id: live.owner_id,
            id: live.id, authorization: live.authorization + 1)
        val wrong_owner = GcHandle(owner_id: second_heap.owner_identity(),
            id: live.id, authorization: live.authorization)
        val zero = GcHandle(owner_id: 0, id: 0, authorization: 0)
        val malformed_slot = GcHandle(owner_id: first_heap.owner_identity(),
            id: PURE_GC_HANDLE_STRIDE + PURE_GC_DEFAULT_CAPACITY,
            authorization: live.authorization)
        expect(second_heap.get(live)).to_be_nil()
        expect(second_heap.release(live)).to_be(false)
        expect(first_heap.get(wrong_authorization)).to_be_nil()
        expect(first_heap.dealloc(wrong_owner)).to_be(false)
        expect(first_heap.get(zero)).to_be_nil()
        expect(first_heap.release(malformed_slot)).to_be(false)
        expect(first_heap.is_valid(live)).to_be(true)

    it "rejects exhaustion and reuses a slot only with new authority":
        val heap = pure_gc_runtime_new(1)
        val old_handle = heap.alloc(rv("old", 1))
        val exhausted = heap.alloc(rv("blocked", 2))
        expect(exhausted.owner_id).to_equal(0)
        expect(exhausted.id).to_equal(-1)
        expect(exhausted.authorization).to_equal(0)
        expect(heap.dealloc(old_handle)).to_be(true)
        expect(heap.is_valid(old_handle)).to_be(false)
        val new_handle = heap.alloc(rv("new", 3))
        expect(new_handle.owner_id).to_equal(old_handle.owner_id)
        expect(new_handle.id).to_be_greater_than(old_handle.id)
        expect(new_handle.authorization).to_be_greater_than(old_handle.authorization)
        expect(heap.is_valid(old_handle)).to_be(false)
        if val value = heap.get(new_handle):
            expect(value.data).to_equal("new")
        else:
            fail("replacement generation was not readable")

    it "makes deallocation idempotent and reports lifecycle states":
        val heap = PureGcRuntime.new(2)
        val eager = heap.alloc(rv("eager", 9))
        val deferred = heap.alloc(rv("deferred", 10))
        expect(heap.dealloc(eager)).to_be(true)
        expect(heap.dealloc(eager)).to_be(false)
        expect(heap.release(deferred)).to_be(true)
        val pending = heap.stats()
        expect(pending.live_objects).to_equal(0)
        expect(pending.pending_reclamation).to_equal(1)
        expect(pending.available_slots).to_equal(1)
        expect(pending.retired_slots).to_equal(0)
        expect(pending.total_allocated).to_equal(2)
        expect(pending.total_freed).to_equal(1)
        expect(pending.collections).to_equal(1)
        expect(heap.collect()).to_equal(1)
        val swept = heap.stats()
        expect(swept.pending_reclamation).to_equal(0)
        expect(swept.available_slots).to_equal(2)
        expect(swept.total_freed).to_equal(2)
        expect(swept.collections).to_equal(2)

    it "defines zero negative and oversized capacity policy":
        val zero = pure_gc_runtime_new(0)
        val negative = pure_gc_runtime_new(-7)
        val oversized = pure_gc_runtime_new(PURE_GC_DEFAULT_CAPACITY + 9)
        val zero_stats = zero.stats()
        val negative_stats = negative.stats()
        val oversized_stats = oversized.stats()
        expect(zero_stats.capacity).to_equal(0)
        expect(negative_stats.capacity).to_equal(0)
        expect(oversized_stats.capacity).to_equal(PURE_GC_DEFAULT_CAPACITY)
        val rejected = zero.alloc(rv("none", 1))
        expect(rejected.id).to_equal(-1)
        expect(zero.get(rejected)).to_be_nil()
        expect(zero.dealloc(rejected)).to_be(false)

    it "keeps the largest generation encoding inside signed i64":
        expect(PURE_GC_MAX_GENERATION).to_equal(0x7ffffffffffff)
        val largest_encoded = (PURE_GC_MAX_GENERATION * PURE_GC_HANDLE_STRIDE
            + PURE_GC_DEFAULT_CAPACITY - 1)
        expect(largest_encoded).to_equal(0x7ffffffffffff03f)
        expect(largest_encoded).to_be_greater_than(0)

    it "keeps the lazy compatibility owner and counters coherent":
        val (live_before, allocated_before, freed_before) = gc_stats()
        val handle = alloc(rv("default", 22))
        val (live_allocated, allocated_after, freed_allocated) = gc_stats()
        expect(handle.owner_id).to_be_greater_than(0)
        expect(live_allocated).to_equal(live_before + 1)
        expect(allocated_after).to_equal(allocated_before + 1)
        expect(freed_allocated).to_equal(freed_before)
        expect(dealloc(handle)).to_be(true)
        val (live_freed, allocated_final, freed_final) = gc_stats()
        expect(live_freed).to_equal(live_before)
        expect(allocated_final).to_equal(allocated_after)
        expect(freed_final).to_equal(freed_before + 1)
        expect(gc_collect()).to_equal(0)
