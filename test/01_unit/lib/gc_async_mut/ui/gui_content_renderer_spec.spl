# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use common.ui.builder.{build_tree, column, label}
use nogc_sync_mut.ui.session.{UISession}
use common.ui.render_opt.damage_tiles.{DirtyTilePyramid}
use common.ui.render_opt.damage_plan.{
    DamagePlan, DamagePlanPolicy, build_damage_plan,
    DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL
}
use common.ui.draw_ir.{
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config,
    draw_ir_rect, draw_ir_box_with_style, draw_ir_style_prop,
    draw_ir_rect_bounds, draw_ir_no_rect
}
use std.gc_async_mut.ui.gui_content_renderer.{
    GuiRetainedRenderSession, gui_content_frame_clear_color,
    gui_session_content_frame
}

use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    engine2d_draw_ir_adv_fresh_device_composition_with_images
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

describe "GUI content renderer theme seed":
    # @manual scenario evidence
    it "starts neutral so canonical widget Draw IR owns the package seed":
        # @req REQ-SSPEC-LIB
        step("starts neutral so canonical widget Draw IR owns the package seed")
        expect(gui_content_frame_clear_color()).to_equal(0u32)

    it "reuses a seeded idle frame without rebuilding widget DrawIR":
        val tree = build_tree(column("root", [label("message", "ready")]))
        var session = UISession.new(tree)
        var retained = GuiRetainedRenderSession.create(32, 16, "cpu")
        expect(retained.seed(session)).to_equal(true)
        val seeded_revision = session.draw_ir_submission_revision

        var pyramid = DirtyTilePyramid.create(32, 16, [8], [8])
        pyramid.begin_frame()
        val plan = build_damage_plan(
            pyramid, 0, DamagePlanPolicy.create(8, 60))
        expect(plan.mode).to_equal(DAMAGE_PLAN_NONE)

        val idle = retained.render_damage(session, plan, false)
        expect(idle.ops_rendered).to_equal(0)
        expect(idle.tiles_rendered).to_equal(0)
        expect(idle.readback.source).to_equal("not_requested")
        expect(session.draw_ir_submission_revision).to_equal(seeded_revision)

        val evidence = retained.render_damage(session, plan, true)
        expect(evidence.ops_rendered).to_equal(0)
        expect(evidence.readback.source).to_equal("cpu_mirror")
        expect(evidence.readback.pixel_count).to_equal(32 * 16)
        expect(session.draw_ir_submission_revision).to_equal(seeded_revision)
        retained.shutdown()

    it "seeds the first damaged-render call with one valid full-frame plan":
        val tree = build_tree(column("root", [label("message", "ready")]))
        var session = UISession.new(tree)
        var retained = GuiRetainedRenderSession.create(32, 16, "cpu")
        var pyramid = DirtyTilePyramid.create(32, 16, [8], [8])
        pyramid.begin_frame()
        val empty = build_damage_plan(
            pyramid, 0, DamagePlanPolicy.create(8, 60))

        val first = retained.render_damage(session, empty, true)
        expect(first.unsupported_kinds).to_equal("none")
        expect(first.ops_rendered).to_equal(0)
        expect(first.readback.source).to_equal("cpu_mirror")
        expect(first.readback.pixel_count).to_equal(32 * 16)
        val first_revision = session.draw_ir_submission_revision

        val idle = retained.render_damage(session, empty, true)
        expect(idle.ops_rendered).to_equal(0)
        expect(idle.readback.pixels).to_equal(first.readback.pixels)
        expect(session.draw_ir_submission_revision).to_equal(first_revision)
        retained.shutdown()

    # Bug gui_retained_render_session_cpu_seed_preflight_rejected_2026-11-13:
    # the label box is laid out from font metrics, so it is wider than a narrow
    # window. The retained seed must paint it clipped to the target exactly
    # like the one-shot content frame does, not reject the whole window.
    it "seeds a label wider than its target identically to the one-shot frame":
        val tree = build_tree(column("root", [label("message", "ready")]))
        var probe = UISession.new(tree)
        val composition = probe.submit_widget_draw_ir(32, 16, "cpu")
        var overflowing = 0
        for batch in composition.batches:
            for command in batch.commands:
                if command.kind == "text" and command.x + command.width > 32:
                    overflowing = overflowing + 1
        expect(overflowing).to_equal(1)

        var one_shot_session = UISession.new(tree)
        val one_shot = gui_session_content_frame(
            one_shot_session, "w", "", 0, 0, 32, 16, 1, 1, [])
        expect(one_shot.pixels.len()).to_equal(32 * 16)

        var session = UISession.new(tree)
        var retained = GuiRetainedRenderSession.create(32, 16, "cpu")
        expect(retained.seed(session)).to_equal(true)
        var pyramid = DirtyTilePyramid.create(32, 16, [8], [8])
        pyramid.begin_frame()
        val plan = build_damage_plan(
            pyramid, 0, DamagePlanPolicy.create(8, 60))
        val evidence = retained.render_damage(session, plan, true)
        expect(evidence.readback.source).to_equal("cpu_mirror")
        expect(evidence.readback.pixels).to_equal(one_shot.pixels)
        retained.shutdown()

    it "keeps the fresh-device composition lane strict for unbounded text":
        val tree = build_tree(column("root", [label("message", "ready")]))
        var session = UISession.new(tree)
        val composition = session.submit_widget_draw_ir(32, 16, "cpu")
        var engine = Engine2D.create_with_backend(32, 16, "cpu")
        val result = engine2d_draw_ir_adv_fresh_device_composition_with_images(
            engine, composition, [])
        expect(result.readback_source).to_equal("preflight_rejected")
        expect(result.fallback_reason).to_contain(
            "fresh-device-command-preflight-required")
        engine.shutdown()

    it "replays DAMAGE_PLAN_FULL and parent-sampling DAMAGE_PLAN_LOCAL cleanly":
        # @req REQ-SGUI-007
        step("Build a backdrop + window-surface-glass composition")
        val bg_emb = draw_ir_embedding_config("", "bg_batch", 0, 0, 64, 64, 0, 1000, false)
        val bg_cmd = draw_ir_rect("bg_rect", 0, 0, 64, 64, 0xFF102030u32)
        val bg_batch = draw_ir_batch("bg_batch", "cpu", bg_emb, [bg_cmd])

        val glass_emb = draw_ir_embedding_config("", "glass_batch", 16, 16, 32, 32, 0, 1000, false)
        val g_bounds = draw_ir_rect_bounds(0, 0, 32, 32)
        val glass_cmd = draw_ir_box_with_style(
            "glass_panel", 0, 0, 32, 32, 0x33FFFFFFu32,
            g_bounds, g_bounds, g_bounds, draw_ir_no_rect(), [
            draw_ir_style_prop("background-color", "#33FFFFFF"),
            draw_ir_style_prop("wm-material-request", "window-surface-glass"),
            draw_ir_style_prop("backdrop-filter-capability", "engine2d-cpu-composited-material-v1"),
            draw_ir_style_prop("backdrop-filter-realized-blur-radius-px", "4"),
        ], "")
        val glass_batch = draw_ir_batch("glass_batch", "cpu", glass_emb, [glass_cmd])
        val comp = draw_ir_composition("glass_comp", "glass_scene", "cpu", [bg_batch, glass_batch])

        val tree = build_tree(column("root", [label("seed_lbl", "ok")]))
        var session = UISession.new(tree)
        var retained = GuiRetainedRenderSession.create(64, 64, "cpu")
        expect(retained.seed(session)).to_equal(true)

        step("Verify DAMAGE_PLAN_LOCAL overlapping the glass surface succeeds")
        val local_plan = DamagePlan(
            rects: [20, 20, 16, 16], mode: DAMAGE_PLAN_LOCAL,
            source_tile_count: 1, output_rect_count: 1, merged_tile_count: 0,
            dirty_pixels: 256, planned_pixels: 256, full_fallback_count: 0,
            fallback_reason: 0, tiles_examined: 1)
        val local_out = retained.render_composition_damage(comp, local_plan, true)
        expect(local_out.unsupported_kinds).to_equal("none")
        expect(local_out.readback.pixels.len()).to_equal(64 * 64)

        step("Verify DAMAGE_PLAN_FULL succeeds through full ordered replay")
        val full_plan = DamagePlan(
            rects: [0, 0, 64, 64], mode: DAMAGE_PLAN_FULL,
            source_tile_count: 1, output_rect_count: 1, merged_tile_count: 0,
            dirty_pixels: 4096, planned_pixels: 4096, full_fallback_count: 1,
            fallback_reason: 1, tiles_examined: 1)
        val full_out = retained.render_composition_damage(comp, full_plan, true)
        expect(full_out.unsupported_kinds).to_equal("none")
        expect(full_out.readback.pixels.len()).to_equal(64 * 64)
        retained.shutdown()
