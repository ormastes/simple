use std.spec.{describe, it, expect}
use std.gc_async_mut.ui.gui_content_renderer.{
    gui_content_frame_cache_clear, gui_content_frame_cache_hit_count,
    gui_content_frame_render_count, gui_content_frame_cache_pixels,
    gui_session_content_frame
}
use common.ui.builder.{build_tree_with_title, column, text_widget}
use nogc_sync_mut.ui.session.{UISession}

fn _window_session(label: text) -> UISession:
    UISession.new(build_tree_with_title(
        column("root-{label}", [text_widget("label-{label}", "retained")]),
        "Retained", "default"))

describe "GUI multi-window retained content cache":
    it "retains two alternating windows without reraster thrash":
        gui_content_frame_cache_clear()
        val session_a = _window_session("A")
        val session_b = _window_session("B")
        val first_a = gui_session_content_frame(
            session_a, "window-a", "", 0, 0, 48, 32, 1, 10, [])
        val first_b = gui_session_content_frame(
            session_b, "window-b", "", 0, 0, 48, 32, 1, 20, [])
        val second_a = gui_session_content_frame(
            session_a, "window-a", "", 0, 0, 48, 32, 2, 10, [])
        val second_b = gui_session_content_frame(
            session_b, "window-b", "", 0, 0, 48, 32, 2, 20, [])

        expect(gui_content_frame_render_count()).to_equal(2)
        expect(gui_content_frame_cache_hit_count()).to_equal(2)
        expect(gui_content_frame_cache_pixels()).to_equal(48 * 32 * 2)
        expect(second_a.checksum).to_equal(first_a.checksum)
        expect(second_b.checksum).to_equal(first_b.checksum)
        expect(second_a.pixels).to_equal(first_a.pixels)
        expect(second_b.pixels).to_equal(first_b.pixels)
        gui_content_frame_cache_clear()
