"""
## Purpose and audience
Purpose: Prove that web render pixel backend runtime queue provenance.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @tag: unit, ui, web_render, host_gpu_queue
"""
# Web Render Pixel Backend Runtime Queue Spec

## Overview

This focused spec proves the shared WebRenderArtifact boundary carries
host/GPU runtime queue submit and drain provenance for GPU-backed web pixel
artifacts. BrowserBackend mirrors these fields from the artifact after
`render_frame`.

## Requirements

**Requirements:** N/A

## Plan

**Plan:** doc/03_plan/agent_tasks/real_host_gpu_runtime_queue_emission.md

## Design

**Design:** doc/04_architecture/ui/simple_gui_stack.md

## Research

**Research:** N/A

## Examples

The GPU scenario renders a tiny HTML fixture through the Vulkan-selected
Engine2D pixel backend, then asserts that the `WebRenderArtifact` records a
submitted packet, one drained packet, and the runtime backend handle. The
software scenario asserts the same artifact fields remain queue-neutral.

Nothing is asserted from `Engine2D.probe_backend`: that probe is a second,
independent create, so its answer is only a prediction about the artifact
create that already happened. Every queue assertion reads the artifact the
create actually produced, a probe/create divergence is disclosed on a
`[toctou]` line, and each example prints either `GPU-PROVEN` or an explicit
`GPU BRANCH SKIPPED`. A pass with no `GPU-PROVEN` line attests nothing about
the GPU path.

Known production divergence, disclosed rather than asserted: the runtime-queue
receipt is stamped from the resolved backend NAME, and
`web_render_resolved_engine2d_backend_name` resolves that name independently of
the renderer's own `_resolved_render_backend`. Under fd pressure the two
disagree, so the artifact can report `engine2d_backend=vulkan` with
`gpu_readback_source=cpu_mirror` and a full drained queue receipt for a frame
the CPU produced (reproduced 3/3 at `ulimit -n 44` on unmodified source). That
is a second probe-then-create divergence one layer down in production code; this
spec prints a `FABRICATED DEVICE RECEIPT` line for it and refuses to count the
run as GPU-PROVEN, but does not assert on it, because doing so would reintroduce
exactly the false red this spec exists to remove.
"""

use std.spec.*
use common.ui.web_render_api.{
    WEB_RENDER_ENGINE2D_STATUS_UNAVAILABLE,
    WEB_RENDER_ENGINE2D_STATUS_RENDERED,
    WEB_RENDER_QUEUE_STATUS_DRAINED,
    WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED,
    WEB_RENDER_QUEUE_STATUS_SUBMITTED,
    WEB_RENDER_TARGET_PURE_SIMPLE,
    web_render_adapter_request
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.backend_probe.{BackendStatus}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    draw_ir_batch,
    draw_ir_box_with_style,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_no_rect,
    draw_ir_rect,
    draw_ir_style_prop
}
use std.gc_async_mut.ui.web_render_pixel_backend.{web_render_draw_ir_request_to_pixel_artifact, web_render_html_request_to_pixel_artifact_with_backend}

extern fn rt_host_gpu_queue_reset()

# PROBE-THEN-CREATE TOCTOU (doc/08_tracking/bug/gpu_probe_then_create_toctou_2026-08-04.md)
# Engine2D.probe_backend runs its own create+init+shutdown and throws it away;
# web_render_html_request_to_pixel_artifact_with_backend performs a SECOND,
# independent create with nothing cached between them. The probe answer is only a
# PREDICTION. Nothing below is asserted from the probe: every assertion reads the
# artifact the create actually produced, and a probe/create divergence is
# DISCLOSED on a [toctou] line rather than asserted.

# The complete honest readback vocabulary emitted by the engine2d backends, plus
# the "engine2d_pixel_readback" receipt label the web-render layer substitutes
# when the engine reports a frame with no source at all.
fn _source_is_device(source: text) -> bool:
    source == "device_readback" or source == "host_cache_after_device_present" or source == "host_cache_after_device_copy" or
        source == "swapchain_present" or source == "framebuffer_surface"

fn _source_is_cpu(source: text) -> bool:
    source == "cpu_mirror" or source == "cpu_fallback"

# Every no-frame source carries an EMPTY pixel array, so frame-content
# assertions must not run on them.
fn _source_is_no_frame(source: text) -> bool:
    source == "completion_unknown" or source == "readback_failed" or
        source == "not_requested" or source == "device_identity_unknown" or
        source == "preflight_rejected"

# A frame WAS produced but the engine attributed no source to it.
fn _source_is_unattributed(source: text) -> bool:
    source == "engine2d_pixel_readback"

fn _source_is_known(source: text) -> bool:
    _source_is_device(source) or _source_is_cpu(source) or
        _source_is_no_frame(source) or _source_is_unattributed(source)

# The runtime queue is only wired for the real GPU backends; every other backend
# name is a software lane and must stay queue-neutral.
fn _backend_has_runtime_queue(backend: text) -> bool:
    backend == "vulkan" or backend == "cuda" or backend == "metal" or
        backend == "rocm" or backend == "hip"

# Device proof is create-side ONLY: a GPU-queue backend that actually submitted
# and drained a full-size packet under a live backend handle.
# Device proof is create-side ONLY, and the queue half alone is not enough: the
# queue evidence is synthesized from the resolved backend NAME, so it must be
# corroborated by a device-sourced readback before it counts as proof.
fn _device_proven(backend: text, source: text, submit_status: text, drain_status: text, handle: i64, payload_size: i64, expected_bytes: i64) -> bool:
    _backend_has_runtime_queue(backend) and _source_is_device(source) and
        submit_status == WEB_RENDER_QUEUE_STATUS_SUBMITTED and
        drain_status == WEB_RENDER_QUEUE_STATUS_DRAINED and handle > 0 and
        payload_size == expected_bytes

# Runs unconditionally on every outcome and every backend — this is where the
# teeth live. Deliberately NOT asserting handle == 0 on CPU sources: the seed
# surfaces those as nil under fd exhaustion.
fn _assert_queue_invariants(label: text, backend: text, source: text, pixel_count: i64,
    submit_status: text, drain_status: text, packet_id: i64, drained: i64, handle: i64,
    payload_size: i64, payload_hash: i64, payload_text: text, reason: text,
    checksum: i64, expected_px: i64, expected_bytes: i64):
    if not _source_is_known(source):
        print "[probe-provenance] {label}: UNKNOWN READBACK SOURCE '{source}' — outside the honest vocabulary, failing closed"
    expect(_source_is_known(source)).to_equal(true)
    if source == "device_readback":
        expect(pixel_count).to_equal(expected_px)
    if _source_is_cpu(source):
        expect(_source_is_device(source)).to_equal(false)
    if _backend_has_runtime_queue(backend):
        # The queue receipt is stamped from the resolved backend NAME alone, so a
        # GPU-named backend can carry drained queue evidence for a frame the CPU
        # produced. That mismatch is DISCLOSED, never asserted, because it occurs
        # on UNMODIFIED source: web_render_resolved_engine2d_backend_name and the
        # renderer's own _resolved_render_backend
        # (simple_web_engine2d_renderer.spl:1146) resolve the backend
        # INDEPENDENTLY, and under fd pressure they disagree — the facade stamps
        # "vulkan" while the renderer rasterises and reports "cpu_mirror"
        # (reproduced 3/3 at `ulimit -n 44`). That is a second probe-then-create
        # divergence one layer down in PRODUCTION code, not a spec defect;
        # asserting it here would only reintroduce the false red this spec exists
        # to remove. Tracked in the bug doc. The teeth that stay HARD below are
        # the queue-evidence fields, and _device_proven still requires a
        # device-sourced readback so a name-derived stamp can never read as
        # GPU-PROVEN.
        if not _source_is_device(source):
            print "[probe-provenance] {label}: FABRICATED DEVICE RECEIPT — backend={backend} stamped runtime-queue evidence but the frame came from source='{source}'; disclosed, not asserted (see spec header). This run proves NOTHING about the GPU path"
        expect(submit_status).to_equal(WEB_RENDER_QUEUE_STATUS_SUBMITTED)
        expect(drain_status).to_equal(WEB_RENDER_QUEUE_STATUS_DRAINED)
        expect(packet_id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(drained).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(handle).to_be_greater_than(0)
        expect(payload_size).to_equal(expected_bytes)
        expect(payload_hash).to_equal(checksum)
        expect(payload_text).to_contain("web-render-frame;backend={backend};pixels={expected_px};checksum=")
        expect(reason).to_contain("drained runtime queue")
    else:
        expect(submit_status).to_equal(WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED)
        expect(drain_status).to_equal(WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED)
        expect(packet_id).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(drained).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(handle).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(payload_size).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(payload_hash).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(payload_text).to_equal("")
        expect(_device_proven(backend, source, submit_status, drain_status, handle, payload_size, expected_bytes)).to_equal(false)

fn _report_outcome(label: text, backend: text, source: text, submit_status: text,
    drain_status: text, packet_id: i64, drained: i64, handle: i64, payload_size: i64,
    expected_bytes: i64) -> bool:
    if _device_proven(backend, source, submit_status, drain_status, handle, payload_size, expected_bytes):
        print "[probe-gpu] {label}: GPU-PROVEN — a device runtime queue carried this frame (backend={backend} source={source} handle={handle} packet={packet_id} drained={drained} bytes={payload_size})"
        return true
    if _backend_has_runtime_queue(backend):
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — a GPU backend was selected but produced no drained queue evidence (backend={backend} source={source} submit={submit_status} drain={drain_status} handle={handle}); this example proves NOTHING about the GPU path"
    else if source == "cpu_fallback":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — the device was unavailable at use time (backend={backend} source=cpu_fallback); the probe's prediction did not survive to the create. This example proves NOTHING about the GPU path"
    else if source == "cpu_mirror":
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — CPU/software lane (backend={backend} source=cpu_mirror); this example proves NOTHING about the GPU path"
    else:
        print "[probe-gpu] {label}: GPU BRANCH SKIPPED — no device-backed frame (backend={backend} source={source}); this example proves NOTHING about the GPU path"
    false

use std.spec.step

describe "web render pixel backend runtime queue provenance":

    it "rejects an invalid Draw IR viewport before Engine2D creation":
        step("Verify: rejects an invalid Draw IR viewport before Engine2D creation")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Draw IR", "", "", "", 0, 48).with_pixel_output()
        val composition = draw_ir_composition("invalid", "invalid", DRAW_IR_BACKEND_CPU, [])
        val artifact = web_render_draw_ir_request_to_pixel_artifact(req, composition, "software")

        expect(artifact.engine2d_status).to_equal(WEB_RENDER_ENGINE2D_STATUS_UNAVAILABLE)
        expect(artifact.pixels.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(artifact.queue_submit_status).to_equal(WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED)

    it "preserves the executor readback source without fabricating queue dispatch":
        step("Verify: preserves the executor readback source without fabricating queue dispatch")
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Draw IR", "", "", "", 8, 8).with_pixel_output()
        val embedding = draw_ir_embedding_config("surface", "rect", 0, 0, 8, 8, 0, 1000, false)
        val batch = draw_ir_batch("rect", DRAW_IR_BACKEND_CPU, embedding, [draw_ir_rect("rect", 0, 0, 8, 8, 0xff112233u32)])
        val artifact = web_render_draw_ir_request_to_pixel_artifact(req, draw_ir_composition("rect", "rect", DRAW_IR_BACKEND_CPU, [batch]), "software")

        expect(artifact.engine2d_status).to_equal(WEB_RENDER_ENGINE2D_STATUS_RENDERED)
        expect(artifact.pixels.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(artifact.gpu_readback_source).to_equal("cpu_mirror")
        expect(artifact.queue_submit_status).to_equal(WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED)
        expect(artifact.queue_dispatch_status).to_equal(WEB_RENDER_QUEUE_STATUS_NOT_REQUESTED)

    it "preserves realized fallback provenance for direct Draw IR execution":
        step("Verify: preserves realized fallback provenance for direct Draw IR execution")
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Draw IR", "", "", "", 8, 8).with_pixel_output()
        val embedding = draw_ir_embedding_config("surface", "fallback", 0, 0, 8, 8, 0, 1000, false)
        val no_rect = draw_ir_no_rect()
        val style = [
            draw_ir_style_prop("backdrop-filter-fallback", "solid-material"),
            draw_ir_style_prop("background-color", "18,52,86,255"),
            draw_ir_style_prop("color", "254,220,186,255"),
            draw_ir_style_prop("background-image", "none")
        ]
        val command = draw_ir_box_with_style("fallback", 0, 0, 8, 8, 0xff123456u32, no_rect, no_rect, no_rect, no_rect, style)
        val batch = draw_ir_batch("fallback", DRAW_IR_BACKEND_CPU, embedding, [command])
        val artifact = web_render_draw_ir_request_to_pixel_artifact(req, draw_ir_composition("fallback", "fallback", DRAW_IR_BACKEND_CPU, [batch]), "software")

        expect(artifact.material_fallback.kind).to_equal("solid-material")
        expect(artifact.material_fallback.reason).to_equal("cpu-raster-backdrop-sampling-unavailable")
        expect(artifact.material_fallback.material_sha256.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "stamps GPU web render artifacts with runtime queue submit and drain evidence":
        step("Verify: stamps GPU web render artifacts with runtime queue submit and drain evidence")
        rt_host_gpu_queue_reset()
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Queue", "<main><p>queued</p></main>", "", "", 64, 48).with_pixel_output()
        val artifact = web_render_html_request_to_pixel_artifact_with_backend(req, "<html><body><main><p>queued</p></main></body></html>", "vulkan")
        # The probe is a SECOND, INDEPENDENT create. It is checked only for
        # SELF-consistency and used only for disclosure — never asserted from.
        val probe = Engine2D.probe_backend(64, 48, "vulkan")
        expect(probe.available).to_equal(probe.status == BackendStatus.Initialized)
        if not probe.available:
            expect(probe.fallback_reason.len() > 0 or probe.reason.len() > 0).to_equal(true)

        val probe_ready = probe.status == BackendStatus.Initialized
        val served_gpu = _backend_has_runtime_queue(artifact.engine2d_backend)
        if probe_ready != served_gpu:
            print "[toctou] vulkan-queue: probe predicted ready={probe_ready} but the independent create served backend={artifact.engine2d_backend} — the prediction did not survive the gap; asserting on the CREATE, not the probe"

        # Holds on ANY backend that actually served a frame — no longer gated on
        # the probe. A no-frame source carries an EMPTY pixel array, so the
        # frame-content assertions are gated on that FACT and the skip is stated.
        if _source_is_no_frame(artifact.gpu_readback_source):
            print "[probe-gpu] vulkan-queue: FRAME ASSERTIONS SKIPPED — source={artifact.gpu_readback_source} produced no frame; this run proves NOTHING about rendering correctness"
        else:
            expect(artifact.engine2d_status).to_equal(WEB_RENDER_ENGINE2D_STATUS_RENDERED)
            expect(artifact.pixels.len()).to_equal(64 * 48)
            expect(artifact.readback_checksum).to_be_greater_than(0)

        _assert_queue_invariants("vulkan-queue", artifact.engine2d_backend,
            artifact.gpu_readback_source, artifact.pixels.len().to_i64(),
            artifact.queue_submit_status, artifact.queue_drain_status,
            artifact.queue_packet_id, artifact.queue_drained, artifact.queue_backend_handle,
            artifact.queue_payload_size, artifact.queue_payload_hash,
            artifact.queue_payload_text, artifact.queue_reason,
            artifact.readback_checksum, 3072, 64 * 48 * 4)

        if _report_outcome("vulkan-queue", artifact.engine2d_backend,
            artifact.gpu_readback_source, artifact.queue_submit_status,
            artifact.queue_drain_status, artifact.queue_packet_id, artifact.queue_drained,
            artifact.queue_backend_handle, artifact.queue_payload_size, 64 * 48 * 4):
            # Device-only claims hang off the PROVEN fact, never off the probe.
            expect(artifact.engine2d_backend).to_equal("vulkan")
            expect(artifact.queue_backend_handle).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(artifact.queue_payload_text).to_contain("web-render-frame;backend=vulkan;pixels=3072;checksum=")

    it "keeps software web render artifacts queue-neutral":
        step("Verify: keeps software web render artifacts queue-neutral")
        rt_host_gpu_queue_reset()
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Queue", "<main><p>host</p></main>", "", "", 64, 48).with_pixel_output()
        val artifact = web_render_html_request_to_pixel_artifact_with_backend(req, "<html><body><main><p>host</p></main></body></html>", "software")

        # A strict "software" request is pure raster with no device, so this gate
        # stays hard and deterministic — it must ALWAYS hold.
        expect(artifact.engine2d_backend).to_equal("software")
        expect(_backend_has_runtime_queue(artifact.engine2d_backend)).to_equal(false)
        _assert_queue_invariants("software-queue", artifact.engine2d_backend,
            artifact.gpu_readback_source, artifact.pixels.len().to_i64(),
            artifact.queue_submit_status, artifact.queue_drain_status,
            artifact.queue_packet_id, artifact.queue_drained, artifact.queue_backend_handle,
            artifact.queue_payload_size, artifact.queue_payload_hash,
            artifact.queue_payload_text, artifact.queue_reason,
            artifact.readback_checksum, 3072, 64 * 48 * 4)
        expect(_report_outcome("software-queue", artifact.engine2d_backend,
            artifact.gpu_readback_source, artifact.queue_submit_status,
            artifact.queue_drain_status, artifact.queue_packet_id, artifact.queue_drained,
            artifact.queue_backend_handle, artifact.queue_payload_size, 64 * 48 * 4)).to_equal(false)

        print "[probe-gpu] RUN VERDICT: this run's GPU evidence is exactly the set of '[probe-gpu] <label>: GPU-PROVEN' lines above."
        print "[probe-gpu] RUN VERDICT: every '[probe-gpu] <label>: GPU BRANCH SKIPPED' line marks an example that proves NOTHING about the GPU path."
        print "[probe-gpu] RUN VERDICT: a PASS with no GPU-PROVEN line does NOT attest any GPU backend — read it as 'device unavailable', not as 'GPU works'."
