# @cover src/lib/gc_async_mut/cuda/mod.spl 50%
# Purpose and audience: executable specification evidence for the owning engineering team.
# design: doc/05_design/lib/runtime/cuda_driver_dynamic_load.md
#
# With the host driver present, the cuda_driver() gate passes and the entry
# point reaches the runtime provider.

use std.spec.*
use std.nogc_sync_mut.sffi.dynamic.{platform_name}
use std.gc_async_mut.cuda.driver_loader.{CUDA_DRIVER_SYMBOLS, cuda_driver_library_candidates, cuda_driver_resolve}
use std.gc_async_mut.cuda.{cuda_init_checked}

fn _driver_present() -> bool:
    val r = unsafe(capabilities: [ffi, raw_ptr]):
        cuda_driver_resolve(cuda_driver_library_candidates(platform_name()), CUDA_DRIVER_SYMBOLS)
    r.is_ok()

describe "CUDA entry points with a driver":
    if not _driver_present():
        skip("cuda_init_checked passes the driver gate", "no CUDA driver on this host")
    else:
        it "cuda_init_checked passes the driver gate":
            val r = cuda_init_checked()
            expect(r.is_ok()).to_equal(true)
