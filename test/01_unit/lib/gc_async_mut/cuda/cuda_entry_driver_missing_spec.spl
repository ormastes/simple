# @cover src/lib/gc_async_mut/cuda/mod.spl 50%
# Purpose and audience: executable specification evidence for the owning engineering team.
# design: doc/05_design/lib/runtime/cuda_driver_dynamic_load.md
#
# CUDA entry points go through cuda_driver() at first GPU use. With the driver
# library overridden to a nonexistent path, they report CUDA-E001 instead of
# reaching the runtime provider.

use std.spec.*
use std.nogc_sync_mut.io_runtime.{env_set_process}
use std.gc_async_mut.cuda.{cuda_available, cuda_init, cuda_init_checked, CUDA_ERROR_NOT_INITIALIZED}

describe "CUDA entry points without a driver":
    it "cuda_init_checked returns CUDA-E001 naming the override":
        env_set_process("SIMPLE_CUDA_DRIVER_LIBRARY", "simple_no_such_cuda_driver.dll")
        val r = cuda_init_checked()
        expect(r.is_err()).to_equal(true)
        val msg = r.unwrap_err()
        expect(msg.contains("CUDA-E001")).to_equal(true)
        expect(msg.contains("simple_no_such_cuda_driver.dll")).to_equal(true)

    it "cuda_available is false and cuda_init is not-initialized":
        env_set_process("SIMPLE_CUDA_DRIVER_LIBRARY", "simple_no_such_cuda_driver.dll")
        expect(cuda_available()).to_equal(false)
        expect(cuda_init()).to_equal(CUDA_ERROR_NOT_INITIALIZED)
