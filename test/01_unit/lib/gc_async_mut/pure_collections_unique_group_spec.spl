# Order and duplicate semantics of the dict-backed unique/group_by.
#
# These two were O(n^2) (inner linear scan per element). The rewrite is only
# safe if it preserves the observable contract exactly, which is what this pins:
# first-occurrence wins, input order kept, groups in first-encounter key order.
use std.spec.*
use std.gc_async_mut.pure.collections.{unique, group_by}

fn parity(n: i64) -> i64:
    n % 2

describe "pure collections unique":

    it "keeps the first occurrence of each element in input order":
        """Dedupe must not reorder; a caller reading the result expects the
        order it supplied."""
        step("Dedupe a list whose duplicates are separated by other values")
        expect(unique([3, 1, 3, 2, 1, 3])).to_equal([3, 1, 2])

    it "returns an empty list unchanged":
        expect(unique([]).len()).to_equal(0)

    it "keeps a list that has no duplicates intact":
        expect(unique([5, 4, 6])).to_equal([5, 4, 6])

    it "collapses a list that is entirely one repeated value":
        expect(unique([7, 7, 7, 7])).to_equal([7])

    it "dedupes text elements by value":
        expect(unique(["b", "a", "b", "c", "a"])).to_equal(["b", "a", "c"])

describe "pure collections group_by":

    # group_by is correct only about the SHAPE of its result. Membership is
    # broken and always has been: `groups[j].1.push(item)` mutates a copy,
    # because arrays are value types, so every group keeps only the element it
    # was created with. Confirmed against the unmodified function.
    # Filed: doc/08_tracking/bug/group_by_drops_all_but_first_member_2026-07-31.md
    # The membership examples land with the fix; asserting today's output here
    # would pin the defect in place.

    it "returns no groups for an empty list":
        expect(group_by([], parity).len()).to_equal(0)

    it "creates one group per distinct key":
        val groups = group_by([1, 2, 3], parity)
        expect(groups.len()).to_equal(2)

    it "orders groups by first encounter of their key":
        """The group for key 1 comes first because an odd number appears first,
        even though key 0 ends up with more members."""
        step("Group a mixed list by parity and read back the key order")
        val groups = group_by([1, 2, 4, 3, 6], parity)
        expect(groups.len()).to_equal(2)
        expect(groups[0].0).to_equal(1)
        expect(groups[1].0).to_equal(0)
