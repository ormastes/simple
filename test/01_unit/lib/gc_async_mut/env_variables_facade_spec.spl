use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn env_variables_source() -> text:
    rt_file_read_text("src/lib/gc_async_mut/env/variables.spl") ?? ""

describe "GC async environment variables facade":
    it "delegates environment reads to the canonical GC async facade":
        val source = env_variables_source()
        expect(source).to_contain("use std.io_runtime.\{env_get_opt\}")
        expect(source).to_contain("env_get_opt(key)")
        expect(source).to_not_contain("extern fn rt_env_get")

    it "preserves empty environment values as absence":
        val io_source = rt_file_read_text("src/lib/nogc_sync_mut/io_runtime.spl") ?? ""
        expect(io_source).to_contain("if value == \"\"")
        expect(io_source).to_contain("return nil")
