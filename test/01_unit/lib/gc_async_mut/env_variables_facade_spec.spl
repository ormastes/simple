use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn env_variables_source() -> text:
    rt_file_read_text("src/lib/gc_async_mut/env/variables.spl") ?? ""

describe "GC async environment variables facade":
    it "delegates environment reads to the canonical GC async facade":
        val source = env_variables_source()
        expect(source).to_contain("use std.gc_async_mut.io.env_ops.{env_get as gc_env_get}")
        expect(source).to_contain("val v = gc_env_get(key)")
        expect(source).not_to_contain("extern fn rt_env_get")

    it "preserves empty environment values as absence":
        val source = env_variables_source()
        expect(source).to_contain("if v == \"\":")
        expect(source).to_contain("return nil")
