# Purpose and audience: executable specification evidence for the owning engineering team.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec
use std.gc_async_mut.src.tooling.regex_utils.{extract_numbers, is_valid_email, regex_find, regex_is_match, regex_replace_all, regex_split}
use std.gc_async_mut.src.tooling.easy_fix.{EasyFix, FixConfidence, Replacement}

describe "gc_async_mut src tooling facade":

    """
    Purpose: this manual pins the behavior named "gc_async_mut src tooling facade":
" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    it "re-exports regex utilities":
        # @req REQ-SSPEC-UNIT
        step("re-exports regex utilities")
        expect(regex_is_match(r"\d+", "build 42 passed")).to_equal(true)
        val found = regex_find(r"\d+", "run 128 ms")
        match found:
            Some(m):
                expect(m.text).to_equal("128")
                expect(m.start).to_equal(4)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
            nil:
                fail("regex_find did not return a match for digits")
        expect(regex_replace_all(r"\d+", "p50=12 p95=48", "N")).to_equal("pN=N pN=N")
        expect(regex_split(r",\s*", "alpha, beta,gamma")[1]).to_equal("beta")
        expect(is_valid_email("dev@example.com")).to_equal(true)
        expect(extract_numbers("x=7 y=11")[1]).to_equal("11")

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
    it "re-exports easy-fix records":
        # @req REQ-SSPEC-UNIT
        step("re-exports easy-fix records")
        val fix = EasyFix.create("demo.fix", "demo", FixConfidence.Safe)
        fix.add_replacement(Replacement.create("file.spl", 1, 2, 1, 2, "x"))
        expect(fix.is_safe()).to_equal(true)
        expect(fix.replacements.len() as i64).to_equal(1)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)