# @cover src/lib/gc_async_mut/processing/cuda_fill_u32.spl 10%

use std.spec.{describe, it, expect, expect_not}
use std.common.processing.processing_ir.{ProcessingIr, processing_ir_fill_u32}
use std.gc_async_mut.processing.cuda_fill_u32.{
    ProcessingCudaResult, ProcessingCudaExecutor,
    processing_ir_execute_cuda, processing_ir_execute_cuda_with_executor
}

fn _expect_rejected(result: ProcessingCudaResult, reason: text):
    expect_not(result.completed)
    expect(result.reason).to_equal(reason)
    expect(result.values.len()).to_equal(0)
    expect(result.backend_handle).to_equal(0)
    expect(result.device_identity).to_equal(0)

describe "CUDA ProcessingIR pre-device validation":
    """Host-independent CUDA validation before any driver operation."""

    it "rejects invalid IR with zero device provenance":
        val zero = processing_ir_execute_cuda(processing_ir_fill_u32(0, 7u32))
        expect(zero.reason).to_equal("invalid-element-count")
        _expect_rejected(zero, "invalid-element-count")
        _expect_rejected(processing_ir_execute_cuda(processing_ir_fill_u32(536870912, 7u32)), "output-size-overflow")
        _expect_rejected(processing_ir_execute_cuda(ProcessingIr(op: 99, element_count: 1, value: 7u32)), "unsupported-op")

    it "rejects work after executor shutdown without touching CUDA":
        var executor = ProcessingCudaExecutor.create()
        executor.shutdown()
        _expect_rejected(
            processing_ir_execute_cuda_with_executor(
                executor, processing_ir_fill_u32(8, 7u32)),
            "cuda-executor-closed")
