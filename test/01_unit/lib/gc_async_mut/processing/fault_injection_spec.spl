use std.spec.{describe, it, expect}
use std.io_runtime.{env_set}
use std.gc_async_mut.processing.fault_injection.{
    processing_ir_fault_injected, processing_ir_fault_reason
}

describe "ProcessingIR fault injection":
    it "keeps the gate disabled by default and can skip one exact match":
        env_set("SIMPLE_GPU_TEST", "")
        env_set("SIMPLE_GPU_FAULT_INJECT", "")
        env_set("SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES", "")

    it "maps Vulkan dispatch statuses to exact failure reasons":
        env_set("SIMPLE_GPU_TEST", "1")
        env_set("SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES", "")
        env_set("SIMPLE_GPU_FAULT_INJECT", "vulkan:dispatch-ineligible")
        expect(processing_ir_fault_reason("vulkan", "dispatch-ineligible")).to_equal(
            "vulkan-dispatch-ineligible")
        env_set("SIMPLE_GPU_TEST", "")
        env_set("SIMPLE_GPU_FAULT_INJECT", "")
        expect(processing_ir_fault_injected("cuda", "submit")).to_equal(false)

        env_set("SIMPLE_GPU_TEST", "1")
        env_set("SIMPLE_GPU_FAULT_INJECT", "cuda:submit")
        env_set("SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES", "1")
        expect(processing_ir_fault_injected("cuda", "readback")).to_equal(false)
        expect(processing_ir_fault_injected("cuda", "submit")).to_equal(false)
        expect(processing_ir_fault_injected("cuda", "submit")).to_equal(true)

        env_set("SIMPLE_GPU_FAULT_INJECT", "vulkan:init")
        expect(processing_ir_fault_injected("vulkan", "init")).to_equal(false)
        expect(processing_ir_fault_injected("vulkan", "init")).to_equal(true)

        env_set("SIMPLE_GPU_TEST", "")
        env_set("SIMPLE_GPU_FAULT_INJECT", "")
        env_set("SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES", "")
