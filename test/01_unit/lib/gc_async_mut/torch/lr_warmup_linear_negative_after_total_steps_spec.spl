# Regression spec: lr_warmup_linear must never return a negative learning
# rate once `step` exceeds `total_steps`. The sibling cosine schedule
# (lr_warmup_cosine) clamps its decay factor at 0.0; the linear schedule was
# missing the equivalent clamp and could return a negative learning rate.

use std.gc_async_mut.torch.ops.{lr_warmup_linear}

describe "lr_warmup_linear":
    it "does not go negative once step exceeds total_steps":
        val lr = lr_warmup_linear(20, 2, 10, 1.0)
        expect(lr).to_be_greater_than(-0.0000001)

    it "returns base_lr at the end of warmup":
        val lr = lr_warmup_linear(2, 2, 10, 1.0)
        expect(lr).to_equal(1.0)

    it "decays linearly to 0 at total_steps":
        val lr = lr_warmup_linear(10, 2, 10, 1.0)
        expect(lr).to_equal(0.0)
