# @req: REQ-LIB-GC-ASYNC-MUT-001

# svllm tensor_pack — data type surface + A2 writer specs
#
# A2 adds plan_chunks/write_chunk/sha256_chunk. These tests fail until Phase 5.

use std.gc_async_mut.svllm.model_executor.model_loader.tensor_pack.{TensorPack, TensorInfo, ChunkInfo, plan_chunks, write_chunk, sha256_chunk, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES}
use std.gc_async_mut.svllm.model_executor.model_loader.weight_utils.{Dtype}

use std.spec.step

describe "TensorPack.empty":
    it "has the supplied pack_root":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: has the supplied pack_root")
        val pack = TensorPack.empty("/models/llama3-8b")
        expect(pack.pack_root).to_equal("/models/llama3-8b")

    it "has zero tensors and chunks":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: has zero tensors and chunks")
        val pack = TensorPack.empty("/x")
        expect(pack.tensor_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pack.chunk_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "has empty model_id and revision":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: has empty model_id and revision")
        val pack = TensorPack.empty("/x")
        expect(pack.model_id).to_equal("")
        expect(pack.revision).to_equal("")

describe "TensorPack.find_tensor":
    it "returns empty-named TensorInfo when missing":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns empty-named TensorInfo when missing")
        val pack = TensorPack.empty("/x")
        val t = pack.find_tensor("missing")
        expect(t.name).to_equal("")

    it "finds a tensor that is present":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds a tensor that is present")
        var pack = TensorPack.empty("/x")
        val shape: [i64] = [4, 8]
        pack.tensors.push(TensorInfo(
            name: "w0",
            shape: shape,
            dtype: Dtype.F16,
            chunk_id: 0,
            offset_in_chunk: 0,
            byte_len: 64
        ))
        val t = pack.find_tensor("w0")
        expect(t.name).to_equal("w0")
        expect(t.byte_len).to_equal(64)  # oracle: 64 — named expected value from the requirement

describe "ChunkInfo":
    it "stores relative path and digest":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: stores relative path and digest")
        val c = ChunkInfo(
            id: 0,
            relative_path: "data-000.bin",
            byte_len: 2097152,
            digest_hex: "0011aabb"
        )
        expect(c.relative_path).to_equal("data-000.bin")
        expect(c.digest_hex).to_equal("0011aabb")

# ----- A2 writer specs (failing until Phase 5) -----

describe "DEFAULT constants (A2)":
    it "chunk align is 4 KiB":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: chunk align is 4 KiB")
        expect(DEFAULT_CHUNK_ALIGN).to_equal(4096)  # oracle: 4096 — named expected value from the requirement

    it "preferred chunk bytes is 2 MiB":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: preferred chunk bytes is 2 MiB")
        expect(DEFAULT_PREFERRED_CHUNK_BYTES).to_equal(2097152)  # oracle: 2097152 — named expected value from the requirement

describe "plan_chunks (A2)":
    it "emits a single chunk for two small tensors (16B + 24B, fits in one 2 MiB chunk)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: emits a single chunk for two small tensors (16B + 24B, fits in one 2 MiB chunk)")
        val tensors = [
            TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 16),
            TensorInfo(name: "b", shape: [3], dtype: Dtype.I64,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 24)
        ]
        val pack = plan_chunks(tensors, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES)
        expect(pack.chunk_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pack.tensor_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "aligns the second tensor to DEFAULT_CHUNK_ALIGN (4096)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: aligns the second tensor to DEFAULT_CHUNK_ALIGN (4096)")
        val tensors = [
            TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 16),
            TensorInfo(name: "b", shape: [3], dtype: Dtype.I64,
                       chunk_id: 0, offset_in_chunk: 0, byte_len: 24)
        ]
        val pack = plan_chunks(tensors, DEFAULT_CHUNK_ALIGN, DEFAULT_PREFERRED_CHUNK_BYTES)
        val second = pack.tensors[1]
        # 16 bytes then align-up to 4096.
        expect(second.offset_in_chunk).to_equal(4096)  # oracle: 4096 — named expected value from the requirement

describe "write_chunk (A2)":
    it "emits chunk bytes of expected length (tensor bytes + align padding)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: emits chunk bytes of expected length (tensor bytes + align padding)")
        val t = TensorInfo(name: "w", shape: [2, 2], dtype: Dtype.F32,
                           chunk_id: 0, offset_in_chunk: 0, byte_len: 16)
        var src: [u8] = []
        var i = 0
        while i < 16:
            src.push(0xAB as u8)
            i = i + 1
        val out = write_chunk(t, src, DEFAULT_CHUNK_ALIGN)
        # First 16 bytes are the tensor; remainder (if any) is zero padding.
        expect(out.len()).to_be_greater_than(15)

describe "sha256_chunk (A2)":
    it "returns a 64-char lowercase hex digest":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns a 64-char lowercase hex digest")
        var bytes: [u8] = []
        var i = 0
        while i < 16:
            bytes.push(0 as u8)
            i = i + 1
        val hex = sha256_chunk(bytes)
        expect(hex.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "is deterministic (same input => same hex)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: is deterministic (same input => same hex)")
        var a: [u8] = []
        var b: [u8] = []
        var i = 0
        while i < 8:
            a.push(0x42 as u8)
            b.push(0x42 as u8)
            i = i + 1
        expect(sha256_chunk(a)).to_equal(sha256_chunk(b))
