use std.spec
use std.gpu.session.session_types.{GpuSessionHandle}
use std.gpu.session.session_frame.{
    GpuSessionFrame,
    backend_session_begin_frame,
    backend_session_end_frame,
    backend_session_sync_readback
}

describe "backend session frame lifecycle":
    it "rejects invalid handles and dimensions":
        val missing = GpuSessionHandle.invalid()
        val valid = GpuSessionHandle.create(1, "vulkan", "managed")
        val invalid_handle = backend_session_begin_frame(missing, 0, 1, 1, false)
        val invalid_size = backend_session_begin_frame(valid, 0, 0, 1, false)

        expect(invalid_handle.is_active).to_equal(false)
        expect(invalid_size.is_active).to_equal(false)

    it "records draws in production frame state":
        val handle = GpuSessionHandle.create(7, "vulkan", "managed")
        var frame = backend_session_begin_frame(handle, 3, 64, 32, false)
        frame = GpuSessionFrame.record_draw(frame)
        frame = GpuSessionFrame.record_draw(frame)
        val stats = backend_session_end_frame(frame)

        expect(stats.valid).to_equal(true)
        expect(stats.session_id).to_equal(7)
        expect(stats.frame_index).to_equal(3)
        expect(stats.draw_call_count).to_equal(2)

    it "gates synchronous readback":
        val handle = GpuSessionHandle.create(8, "metal", "managed")
        val disabled = backend_session_begin_frame(handle, 0, 1, 1, false)
        val enabled = backend_session_begin_frame(handle, 1, 1, 1, true)
        val disabled_pixel = backend_session_sync_readback(disabled)
        val pixel = backend_session_sync_readback(enabled)

        expect(disabled_pixel.len()).to_equal(0)
        expect(pixel.len()).to_equal(4)
        expect(pixel[0]).to_equal(0)
        expect(pixel[1]).to_equal(0)
        expect(pixel[2]).to_equal(0)
        expect(pixel[3]).to_equal(255)

    it "rejects a closed frame":
        val handle = GpuSessionHandle.create(9, "cuda", "managed")
        val frame = backend_session_begin_frame(handle, 4, 4, 4, true)
        val closed = GpuSessionFrame.close(frame)
        val stats = backend_session_end_frame(closed)
        val pixel = backend_session_sync_readback(closed)

        expect(stats.valid).to_equal(false)
        expect(pixel.len()).to_equal(0)
