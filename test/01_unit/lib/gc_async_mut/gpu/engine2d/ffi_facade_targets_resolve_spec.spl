# Engine2D gc_async_mut FFI facade resolution — REPRODUCING spec
#
# Bug: doc/08_tracking/bug/gc_async_mut_gpu_ffi_facades_are_dangling_2026-08-09.md
#
# The four gc_async_mut engine2d `ffi_*` facades re-exported
#   `std.nogc_async_mut.gpu.engine2d.ffi_<vendor>.*`
# but that directory only ever held `sffi_*` modules. The dangling `export use`
# is a WARNING, not an error, so every facade compiled clean and exported
# nothing. A caller importing a symbol through the facade got
# `error[E1002]: function ... not found` — or, in JIT, an
# `unresolved external symbol` NULL-jump deferral — instead of the binding.
#
# RED before the fix (measured 2026-08-17):
#   $ bin/simple run <repro>
#   error[E1002]: function `cuda_engine2d_pack_args_4` not found
#
# Run: bin/simple test test/01_unit/lib/gc_async_mut/gpu/engine2d/ffi_facade_targets_resolve_spec.spl

use std.spec.{describe, context, it, assert_true}

use std.gc_async_mut.gpu.engine2d.ffi_cuda.{ cuda_engine2d_pack_args_4 }
use std.gc_async_mut.gpu.engine2d.ffi_vulkan.{ vulkan_sffi_is_available }

describe "gc_async_mut engine2d ffi_* facades actually re-export their symbols":

    context "ffi_cuda":

        it "cuda_engine2d_pack_args_4 is reachable through the GC facade":
            val packed = cuda_engine2d_pack_args_4(1, 2, 3, 4)
            # The value is opaque; reaching the call at all is the assertion.
            assert_true(true)

    context "ffi_vulkan":

        it "vulkan_sffi_is_available is reachable through the GC facade":
            val avail = vulkan_sffi_is_available()
            # Host-dependent bool. Resolving the symbol is the assertion.
            assert_true(avail == true or avail == false)
