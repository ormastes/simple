"""
## Purpose and audience
Depth-5 probe scenario for the Engine2D GPU draw-event helper surface: it keeps
one cheap executable sentinel that the shared provenance helper module
(`test/helpers/gpu_draw_event_shared.spl`) stays loadable and still exposes the
provenance and outcome-reporting contracts other engine2d specs lean on.
Audience: engine2d test-infrastructure owners and bootstrap depth probes.

## Operator workflow
Run this file with the Simple test runner from the repository root
(`simple run test/01_unit/lib/gc_async_mut/gpu/engine2d/_zz_probe_depth5_spec.spl`);
the single scenario reads the helper module, extracts its contract tokens, and
asserts they are still shipped.

## Compatibility and limitations
The probe is deliberately one scenario and source-contract shaped: it must stay
loadable in shallow bootstrap lanes where the GPU runtime itself is unavailable,
so it never instantiates backends or opens devices.

## Verification guidance and troubleshooting
A failure means the helper module was renamed or its provenance helper was
removed; fix the helper module first, then re-check the token here. The probe
must never be deleted — bootstrap depth checks expect exactly one scenario.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: engine2d depth probes

use std.spec.step

use std.spec.*
use test.helpers.gpu_draw_event_shared.*

extern fn rt_file_read_text(path: text) -> text

describe "depth5 probe":
    # @manual scenario evidence
    it "resolves":
        # @req REQ-ENGINE2D-PROBE-001
        # @capture(bit_table): probe resolution evidence retained as a source contract
        step("Resolve the depth5 probe against the shared GPU draw-event helper module")
        val helper_source = rt_file_read_text("test/helpers/gpu_draw_event_shared.spl")
        val exposes_provenance_helper = helper_source.contains("fn assert_provenance_invariants(")
        val exposes_outcome_reporter = helper_source.contains("fn report_outcome(")
        val exposes_backend_probe = helper_source.contains("fn probe_backend(")
        expect(exposes_provenance_helper).to_equal(true)  # oracle: the provenance invariant helper is the probe's load-bearing contract
        expect(exposes_outcome_reporter).to_equal(true)  # oracle: outcome reporting is the probe's verdict channel
        expect(exposes_backend_probe).to_equal(true)  # oracle: backend probing is the helper's discovery surface
