# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag: rendering, engine2d, draw_text_bg
# @cover src/lib/gc_async_mut/gpu/engine2d/backend.spl 30%
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_cpu.spl 20%
# @cover src/lib/gc_async_mut/gpu/engine2d/engine.spl 20%
#
# D3 (gui_layer_contract_fix_plan §3) — Engine2DExtended.draw_text_bg
#
# Verifies that the new Engine2D.draw_text_bg facade paints the per-glyph
# background where the glyph bounding box sits and leaves pixels outside
# the glyph cell untouched. The CPU backend is always constructable in
# tests, so it is the single backend exercised here.

use std.spec.step

use std.spec.{describe, context, it, expect}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.color.{color_r}
use std.io_runtime.{file_exists}


fn _has_intermediate_red(pixels: [u32], width: i32, x: i32, y: i32, w: i32, h: i32) -> bool:
    var row: i32 = 0
    while row < h:
        var col: i32 = 0
        while col < w:
            val idx = (y + row) * width + (x + col)
            if idx >= 0 and idx < pixels.len():
                val r = color_r(pixels[idx])
                if r > 0 and r < 255:
                    return true
            col = col + 1
        row = row + 1
    false

# 'A' on the 5x7 bitmap face at scale 1 ('#' = fg, '.' = bg), read back from
# the cpu and software backends (identical) on 2026-11-15.
val A_CELL: [text] = [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"]

fn _cell_mismatches(pixels: [u32], width: i32, fg: u32, bg: u32) -> i32:
    var bad = 0
    var row = 0
    while row < 7:
        var col = 0
        while col < 5:
            val want = if A_CELL[row][col:col + 1] == "#": fg else: bg
            if pixels[row * width + col] != want:
                bad = bad + 1
            col = col + 1
        row = row + 1
    bad

# ============================================================================
# Tests
# ============================================================================

describe "Engine2DExtended.draw_text_bg (CPU backend)":

    context "glyph cell vs outside":

        it "paints bg inside the glyph cell and preserves clear outside":
            # @req REQ-SSPEC-LIB
            step("paints bg inside the glyph cell and preserves clear outside")
            val GREEN: u32 = 0xFF00FF00
            val BLACK: u32 = 0xFF000000
            val WHITE: u32 = 0xFFFFFFFF

            var engine = Engine2D.create_with_backend(32, 16, "cpu")
            engine.clear(GREEN)

            # Paint a single 'A' glyph at the origin on the 7 px face at
            # scale 1 (pixel-sharp rule: one font pixel = one device pixel).
            # The draw_text_bg contract says the glyph cell fills with BLACK
            # and glyph foreground pixels are WHITE. Pixels outside the
            # 5x7 cell must stay GREEN.
            engine.draw_text_bg(0, 0, "A", WHITE, BLACK, 7)
            engine.present()

            val pixels = engine.read_pixels()

            # Cell-outside pixel (far right of the 32-wide scene) must
            # remain GREEN — draw_text_bg must not scribble on the whole
            # framebuffer.
            val outside_idx = 8 * 32 + 30
            expect(pixels[outside_idx]).to_equal(GREEN)

            # Every pixel of the 5x7 cell is exactly fg or bg.
            expect(_cell_mismatches(pixels, 32, WHITE, BLACK)).to_equal(0)
            # Just past the cell (right column, first row below) stays clear.
            expect(pixels[0 * 32 + 5]).to_equal(GREEN)
            expect(pixels[7 * 32 + 0]).to_equal(GREEN)

            engine.shutdown()

        it "paints the scale-1 glyph cell pixel-sharp, with no in-between value":
            # @req REQ-SSPEC-LIB
            step("paints the scale-1 glyph cell pixel-sharp, with no in-between value")
            # Owner rule 2026-11-15: render checks run pixel-sharp. The old
            # row drew at font_size 16 (scale 2) and asserted the bilinear
            # blur that enlargement produces; at scale 1 one font pixel is
            # one device pixel, so the contract is the opposite: every cell
            # pixel is exactly fg or bg.
            val BLACK: u32 = 0xFF000000
            val WHITE: u32 = 0xFFFFFFFF

            var engine = Engine2D.create_with_backend(32, 16, "cpu")
            engine.clear(BLACK)
            engine.draw_text_bg(0, 0, "A", WHITE, BLACK, 7)
            engine.present()

            val pixels = engine.read_pixels()
            expect(_has_intermediate_red(pixels, 32, 0, 0, 16, 16)).to_be(false)
            expect(_cell_mismatches(pixels, 32, WHITE, BLACK)).to_equal(0)

            engine.shutdown()

        it "returns without panic on an empty string":
            # @req REQ-SSPEC-LIB
            step("returns without panic on an empty string")
            val GREEN: u32 = 0xFF00FF00
            var engine = Engine2D.create_with_backend(16, 16, "cpu")
            engine.clear(GREEN)
            engine.draw_text_bg(2, 2, "", 0xFFFFFFFF, 0xFF000000, 7)
            engine.present()
            val pixels = engine.read_pixels()
            # Empty string must touch no pixels — whole scene still GREEN.
            expect(pixels[0]).to_equal(GREEN)
            engine.shutdown()

# Vector face at high dpi (owner rule: >= 300 dpi, device scale >= 3.125):
# a 16 CSS px run at scale 3.125 is 50 device px. Same font, same size on
# every backend. This restores the antialiased-coverage check the scale-1
# bitmap rows above cannot make (#9443 traded it away).
val SANS: text = "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf"
val LVP_ICD: text = "/usr/share/vulkan/icd.d/lvp_icd.json"
val HW: i32 = 96
val HH: i32 = 64
val HI_DPI_SIZE: i32 = 50

fn _hidpi_frame(backend: text) -> [u32]:
    var e = if backend == "vulkan": Engine2D.create_with_backend_fast(HW, HH, backend) else: Engine2D.create_with_backend(HW, HH, backend)
    expect(e.load_font(SANS)).to_be(true)
    expect(e.selected_font_identity() != "").to_be(true)
    if backend == "vulkan":
        expect(e.backend_name()).to_equal("vulkan")
    e.clear(0xFF00FF00u32)
    e.draw_text_bg(2, 2, "Ab", 0xFFFFFFFFu32, 0xFF000000u32, HI_DPI_SIZE)
    e.submit_batch()
    val px = e.read_pixels()
    e.shutdown()
    px

fn _hidpi_intermediate(px: [u32]) -> i32:
    var n = 0
    for c in px:
        val r = color_r(c)
        if r > 0 and r < 255:
            n = n + 1
    n

fn _hidpi_diff(a: [u32], b: [u32]) -> i32:
    var n = 0
    var i = 0
    while i < HW * HH:
        if a[i] != b[i]:
            n = n + 1
        i = i + 1
    n

describe "Engine2D.draw_text_bg vector face at high dpi":
    it "blends antialiased edges identically on cpu, software and vulkan":
        if not file_exists(SANS):
            print("[skip] draw-text-bg-hidpi: no Liberation Sans at {SANS}; this row was not exercised")
            return
        val cpu = _hidpi_frame("cpu")
        val soft = _hidpi_frame("software")
        val inter = _hidpi_intermediate(cpu)
        step("50 px glyph edges carry real coverage between fg and bg (333 px, read back 2026-11-15)")
        expect(inter).to_equal(333)
        step("cpu and software paint the same bytes")
        expect(_hidpi_diff(cpu, soft)).to_equal(0)
        if not file_exists(LVP_ICD):
            print("[skip] draw-text-bg-hidpi vulkan: no llvmpipe ICD at {LVP_ICD}; the Vulkan half was not exercised")
            return
        val vk = _hidpi_frame("vulkan")
        step("vulkan paints the same bytes as cpu")
        expect(_hidpi_diff(cpu, vk)).to_equal(0)
        expect(_hidpi_intermediate(vk)).to_equal(333)
