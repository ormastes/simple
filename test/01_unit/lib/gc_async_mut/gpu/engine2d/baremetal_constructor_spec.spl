"""
## Purpose and audience
Purpose: Prove that Engine2D baremetal constructor.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @tag: engine2d, baremetal
# @cover src/lib/gc_async_mut/gpu/engine2d/engine.spl 20%
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_baremetal.spl 15%

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.backend_baremetal.{BaremetalBackend}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}

use std.spec.step

describe "Engine2D baremetal constructor":

    it "preserves explicit dimensions on the sized baremetal path":
        step("Verify: preserves explicit dimensions on the sized baremetal path")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        val fb = FramebufferDriver.from_buffer(8, 6)
        val backend = BaremetalBackend.create(fb)

        val engine = Engine2D.create_with_baremetal_backend_dims(8, 6, backend)

        expect(engine.backend_name()).to_equal("baremetal")
        expect(engine.width()).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(engine.height()).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "keeps the legacy baremetal constructor contract":
        step("Verify: keeps the legacy baremetal constructor contract")
        val fb = FramebufferDriver.from_buffer(11, 7)
        val backend = BaremetalBackend.create(fb)

        val engine = Engine2D.create_with_baremetal_backend(backend)

        expect(engine.backend_name()).to_equal("baremetal")
        expect(engine.width()).to_equal(11)  # oracle: 11 — named expected value from the requirement
        expect(engine.height()).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "reads host-backed framebuffer pixels in row-major order":
        step("Verify: reads host-backed framebuffer pixels in row-major order")
        val fb = FramebufferDriver.from_buffer(4, 3)
        val backend = BaremetalBackend.create(fb)

        val engine = Engine2D.create_with_baremetal_backend_dims(4, 3, backend)
        engine.clear(0xFF010203u32)
        engine.draw_rect_filled(1, 1, 2, 1, 0xFFABCDEFu32)
        val pixels = engine.read_pixels()

        expect(pixels.len()).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(pixels[0]).to_equal(0xFF010203u32)
        expect(pixels[5]).to_equal(0xFFABCDEFu32)
        expect(pixels[6]).to_equal(0xFFABCDEFu32)
        expect(pixels[11]).to_equal(0xFF010203u32)

    it "host-backed image spans match software alpha and edge clipping":
        step("Verify: host-backed image spans match software alpha and edge clipping")
        val fb = FramebufferDriver.from_buffer(7, 3)
        val backend = BaremetalBackend.create(fb)
        var bare = Engine2D.create_with_baremetal_backend_dims(7, 3, backend)
        var software = Engine2D.create_with_backend(7, 3, "software")
        bare.clear(0x80402010u32)
        software.clear(0x80402010u32)
        val image: [u32] = [
            0x00000000u32, 0x40FF0000u32, 0x8000FF00u32,
            0xFFFFFFFFu32, 0x7F1020F0u32,
            0x010000FFu32, 0xC0FF8040u32, 0x20010203u32,
            0xFF112233u32, 0x80808080u32
        ]
        bare.draw_image_blend(-2, 1, 5, 2, image)
        software.draw_image_blend(-2, 1, 5, 2, image)
        expect(bare.read_pixels()).to_equal(software.read_pixels())
        bare.shutdown()
        software.shutdown()

    it "draw_text_bg preserves filled background and foreground glyph pixels":
        step("Verify: draw_text_bg preserves filled background and foreground glyph pixels")
        val fb = FramebufferDriver.from_buffer(8, 8)
        val backend = BaremetalBackend.create(fb)

        val engine = Engine2D.create_with_baremetal_backend_dims(8, 8, backend)
        engine.clear(0xFF000000u32)
        engine.draw_text_bg(1, 1, "A", 0xFFFFFFFFu32, 0xFF112233u32, 7)
        val pixels = engine.read_pixels()

        expect(pixels[1 * 8 + 1]).to_equal(0xFF112233u32)
        expect(pixels[1 * 8 + 3]).to_equal(0xFFFFFFFFu32)
        expect(pixels[4 * 8 + 1]).to_equal(0xFFFFFFFFu32)
        expect(pixels[7 * 8 + 6]).to_equal(0xFF112233u32)

    it "draw_text writes foreground glyph pixels without filling background":
        step("Verify: draw_text writes foreground glyph pixels without filling background")
        val fb = FramebufferDriver.from_buffer(8, 8)
        val backend = BaremetalBackend.create(fb)

        val engine = Engine2D.create_with_baremetal_backend_dims(8, 8, backend)
        engine.clear(0xFF000000u32)
        engine.draw_text(1, 1, "A", 0xFFFFFFFFu32, 7)
        val pixels = engine.read_pixels()

        expect(pixels[1 * 8 + 1]).to_equal(0xFF000000u32)
        expect(pixels[1 * 8 + 3]).to_equal(0xFFFFFFFFu32)
        expect(pixels[4 * 8 + 1]).to_equal(0xFFFFFFFFu32)
