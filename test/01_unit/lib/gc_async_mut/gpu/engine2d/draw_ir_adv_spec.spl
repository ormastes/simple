    it "coalesces consecutive horizontal plain fills without losing logical count":
        val plan = engine2d_draw_ir_coalesce_plain_fills([
            draw_ir_rect("a", 0, 2, 4, 3, RED),
            draw_ir_rect("b", 4, 2, 4, 3, RED),
            draw_ir_rect("c", 8, 2, 4, 3, RED)
        ])

        expect(plan.commands.len()).to_equal(1)
        expect(plan.commands[0].x).to_equal(0)
        expect(plan.commands[0].y).to_equal(2)
        expect(plan.commands[0].width).to_equal(12)
        expect(plan.commands[0].height).to_equal(3)
        expect(plan.logical_weights).to_equal([3])

    it "coalesces consecutive vertical plain fills":
