# @cover src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl 80%
# @tag: unit, ui, draw_ir, engine2d
"""
# Engine2D Draw IR Advanced Executor Specification

## Overview

This unit spec covers the Simple2D-facing Draw IR executor. It proves Draw IR
batches and compositions choose the CPU fallback when GPU execution is
unavailable, render supported rectangle commands into the Engine2D pixel buffer,
skip unsupported future commands, and expose the same Draw IR batch through
SGTTI before raster so semantic assertions and pixel readback are paired.

## Evidence Model

The first scenario is the SGTTI Phase 5 gate: it builds a Draw IR batch, asserts
the pre-raster semantic node with `SgttiTestDriver`, then renders the same batch
through Engine2D and checks pixel output.

**Requirements:** N/A

This is implementation evidence for the active SGTTI and Draw IR plans rather
than a numbered product requirement.

**Plan:** doc/03_plan/ui/ui_test/ui_test_sgtti_plan.md

**Design:** doc/04_architecture/ui/ui_test_architecture.md

**Research:** doc/01_research/ui/draw_ir/draw_io_sdn_draw_ir.md

## Syntax

The spec uses normal `std.spec` scenarios. Assertions stay on the canonical
SPipe matcher set; SGTTI is used as a helper inside an `it` block, not as a
replacement test framework.
"""

use std.spec
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    DRAW_IR_BACKEND_GPU,
    DrawIrCommand,
    draw_ir_batch,
    draw_ir_box_with_style,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_empty_glyph_run_payload,
    draw_ir_glyph_run_payload,
    draw_ir_image_command,
    draw_ir_no_rect,
    draw_ir_rect_bounds,
    draw_ir_rect,
    draw_ir_text,
    draw_ir_text_styled,
    draw_ir_text_styled_clipped,
    draw_ir_text_shaped_font,
    draw_ir_style_prop
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{Engine2dResolvedDrawIrImage, engine2d_draw_ir_adv_batch, engine2d_draw_ir_adv_batch_with_images, engine2d_draw_ir_adv_composition, engine2d_draw_ir_adv_composition_with_images, engine2d_draw_ir_adv_composition_present_with_images, engine2d_draw_ir_adv_fresh_device_composition_with_images, engine2d_draw_ir_adv_strict_vulkan_primitives_with_images, engine2d_draw_ir_coalesce_plain_fills, engine2d_draw_ir_render_damaged, engine2d_draw_ir_render_composition_damaged, engine2d_draw_ir_render_composition_damaged_deferred_cpu_with_images, engine2d_draw_ir_render_composition_damaged_with_images, engine2d_draw_ir_render_tiled, engine2d_resolved_draw_ir_image}
use std.gc_async_mut.gpu.engine2d.draw_ir_runtime_adv.{engine2d_draw_ir_adv_batch_runtime_queue}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.host_gpu_event_queue.{engine2d_host_gpu_runtime_queue_with_backend_handle, engine2d_host_gpu_runtime_reset}
use std.gc_async_mut.ui_test.sgtti.{SgttiTestDriver, sgtti_snapshot_from_draw_ir_batch}
use std.common.encoding.font_registry.{selected_font_asset_candidates, selected_font_asset_identity}

val BG: u32 = 0xff000000u32
val RED: u32 = 0xffff0000u32
val GREEN: u32 = 0xff00ff00u32
val BLUE: u32 = 0xff0000ffu32
val YELLOW: u32 = 0xffffff00u32
val HALF_RED: u32 = 0x80ff0000u32
val HALF_RED_OVER_BG: u32 = 0xff800000u32

fn _css_background_style(repeat: text, tile_x: text, tile_y: text, tile_width: text, tile_height: text) -> [DrawIrStyleProp]:
    [
        draw_ir_style_prop("image-role", "css-background"),
        draw_ir_style_prop("background-repeat", repeat),
        draw_ir_style_prop("background-tile-x", tile_x),
        draw_ir_style_prop("background-tile-y", tile_y),
        draw_ir_style_prop("background-tile-width", tile_width),
        draw_ir_style_prop("background-tile-height", tile_height),
        draw_ir_style_prop("background-shape-x", "0"),
        draw_ir_style_prop("background-shape-y", "0"),
        draw_ir_style_prop("background-shape-width", "2147483647"),
        draw_ir_style_prop("background-shape-height", "2147483647"),
        draw_ir_style_prop("background-radius-tl-x", "0"),
        draw_ir_style_prop("background-radius-tl-y", "0"),
        draw_ir_style_prop("background-radius-tr-x", "0"),
        draw_ir_style_prop("background-radius-tr-y", "0"),
        draw_ir_style_prop("background-radius-br-x", "0"),
        draw_ir_style_prop("background-radius-br-y", "0"),
        draw_ir_style_prop("background-radius-bl-x", "0"),
        draw_ir_style_prop("background-radius-bl-y", "0")
    ]

fn _css_background_result(style: [DrawIrStyleProp], command_x: i32, command_y: i32, command_width: i32, command_height: i32, target_width: i32, target_height: i32):
    var engine = Engine2D.create_with_backend(target_width, target_height, "cpu")
    engine.clear(BG)
    val command = draw_ir_image_command(
        "css-background", command_x, command_y, command_width, command_height,
        "image://css-background", style)
    val batch = draw_ir_batch(
        "css-background", DRAW_IR_BACKEND_CPU,
        draw_ir_embedding_config(
            "surface", "window", 0, 0, target_width, target_height,
            0, 1000, false),
        [command])
    val image = engine2d_resolved_draw_ir_image(
        "image://css-background", 2, 2, [RED, GREEN, BLUE, HALF_RED])
    val result = engine2d_draw_ir_adv_batch_with_images(
        engine, batch, false, [image])
    engine.shutdown()
    result

describe "Engine2D advanced Draw IR executor":

    it "reuses tile command scratch without replaying a prior tile":
        var engine = Engine2D.create_with_backend(4, 1, "cpu")
        engine.clear(BG)
        val outcome = engine2d_draw_ir_render_tiled(
            engine,
            [
                draw_ir_rect("left-tile", 0, 0, 2, 1, RED),
                draw_ir_rect("right-tile", 2, 0, 2, 1, GREEN)
            ],
            [0, 2], [0, 0], [2, 2], [1, 1],
            [true, true], [0, 1, 2], [0, 1])
        engine = outcome.engine
        expect(outcome.tiles_rendered).to_equal(2)
        expect(outcome.ops_rendered).to_equal(2)
        expect(outcome.readback.pixels).to_equal([RED, RED, GREEN, GREEN])
        engine.shutdown()

    it "updates only exact retained-frame damage":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        engine.present()
        val command = draw_ir_rect("full-red", 0, 0, 8, 4, RED)
        val outcome = engine2d_draw_ir_render_damaged(
            engine, [command], [2, 1, 2, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.ops_rendered).to_equal(1)
        expect(outcome.readback.pixels).to_equal([
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, RED, RED, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG
        ])
        engine.shutdown()

    it "reuses one coalesced command plan across disjoint retained damage":
        var engine = Engine2D.create_with_backend(8, 3, "cpu")
        engine.clear(BG)
        engine.present()
        # These adjacent commands coalesce into one physical command while
        # retaining a logical weight of two. Both disjoint damage rectangles
        # must replay that same plan and preserve the logical receipt count.
        val commands = [
            draw_ir_rect("left", 0, 0, 4, 3, RED),
            draw_ir_rect("right", 4, 0, 4, 3, RED)
        ]
        val outcome = engine2d_draw_ir_render_damaged(
            engine, commands, [0, 0, 2, 1, 6, 2, 2, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.ops_rendered).to_equal(4)
        expect(outcome.ops_skipped).to_equal(0)
        expect(outcome.readback.pixels).to_equal([
            RED, RED, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, RED, RED
        ])
        engine.shutdown()

    it "culls only exact commands outside retained damage":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        engine.present()
        val outside = draw_ir_rect("outside", 0, 0, 1, 1, BLUE)
        val styled_outside = draw_ir_box_with_style(
            "styled-outside", 0, 0, 1, 1, GREEN,
            draw_ir_no_rect(), draw_ir_no_rect(), draw_ir_no_rect(),
            draw_ir_no_rect(), [draw_ir_style_prop("box-shadow", "1 1 2 black")])
        val inside = draw_ir_rect("inside", 2, 1, 2, 1, RED)
        val outcome = engine2d_draw_ir_render_damaged(
            engine, [outside, styled_outside, inside], [2, 1, 2, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.ops_rendered).to_equal(2)
        expect(outcome.ops_skipped).to_equal(1)
        expect(outcome.commands_considered).to_equal(2)
        expect(outcome.commands_culled_by_damage).to_equal(1)
        expect(outcome.readback.pixels[0]).to_equal(BG)
        expect(outcome.readback.pixels[1 * 8 + 2]).to_equal(RED)
        engine.shutdown()

    it "deduplicates coalesced logical fills while filtering retained damage":
        var engine = Engine2D.create_with_backend(512, 2, "cpu")
        engine.clear(BG)
        engine.present()
        # The adjacent fills coalesce into one physical command with logical
        # weight two. A clip at the far edge must consider it once and retain
        # both logical operation receipts.
        val commands = [
            draw_ir_rect("left", 0, 0, 256, 2, HALF_RED),
            draw_ir_rect("right", 256, 0, 256, 2, HALF_RED),
            draw_ir_rect("outside", 0, 0, 1, 1, BLUE)
        ]
        val outcome = engine2d_draw_ir_render_damaged(
            engine, commands, [255, 1, 2, 1], true)
        engine = outcome.engine
        expect(outcome.ops_rendered).to_equal(2)
        expect(outcome.ops_skipped).to_equal(1)
        expect(outcome.commands_considered).to_equal(1)
        expect(outcome.commands_culled_by_damage).to_equal(1)
        # Exact source-over result for HALF_RED over BG. If the cross-cell
        # command is selected twice, both pixels become visibly more red.
        expect(outcome.readback.pixels[1 * 512 + 255]).to_equal(4286578688u32)
        expect(outcome.readback.pixels[1 * 512 + 256]).to_equal(4286578688u32)
        expect(outcome.readback.pixels[0]).to_equal(BG)
        engine.shutdown()

    it "rejects overlapping retained damage before raster":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        val command = draw_ir_rect("full-red", 0, 0, 8, 4, RED)
        val outcome = engine2d_draw_ir_render_damaged(
            engine, [command], [0, 0, 4, 2, 3, 1, 2, 2], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("invalid-damage-plan")
        expect(outcome.ops_rendered).to_equal(0)
        expect(engine.read_pixels()).to_equal([
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG
        ])
        engine.shutdown()

    it "accepts one opaque full-target GUI composition for retained damage":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        engine.present()
        val batch = draw_ir_batch(
            "widget-root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "widget-surface", "widget", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("root", 0, 0, 8, 4, GREEN)])
        val composition = draw_ir_composition(
            "widget-composition", "widget:8x4", DRAW_IR_BACKEND_CPU, [batch])
        val outcome = engine2d_draw_ir_render_composition_damaged(
            engine, composition, [4, 2, 2, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.readback.pixels[2 * 8 + 4]).to_equal(GREEN)
        expect(outcome.readback.pixels[0]).to_equal(BG)
        engine.shutdown()

    it "leaves CPU dirty state intact until the retained region presenter consumes it":
        var engine = Engine2D.create_with_backend(8, 4, "cpu_simd")
        engine.clear(BG)
        val seed = engine.read_pixels_damaged(16)
        expect(seed[0]).to_equal(BG)
        engine.present()
        val batch = draw_ir_batch(
            "cpu-root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "cpu", "cpu", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("damage", 2, 1, 2, 1, RED)])
        val composition = draw_ir_composition(
            "cpu-retained", "cpu:8x4", DRAW_IR_BACKEND_CPU, [batch])
        val outcome = engine2d_draw_ir_render_composition_damaged_deferred_cpu_with_images(
            engine, composition, [], [2, 1, 2, 1])
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.readback.source).to_equal("not_requested")
        val mirror = engine.read_pixels_damaged(16)
        expect(mirror[1 * 8 + 2]).to_equal(RED)
        expect(mirror[0]).to_equal(BG)
        engine.present()
        engine.shutdown()

    it "rejects malformed composition damage before narrowing coordinates":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        val batch = draw_ir_batch(
            "root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "root", "root", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 8, 4, BG)])
        val composition = draw_ir_composition(
            "root", "root:8x4", DRAW_IR_BACKEND_CPU, [batch])
        val malformed = engine2d_draw_ir_render_composition_damaged_with_images(
            engine, composition, [], [4294967296, 0, 1, 1], true)
        engine = malformed.engine
        expect(malformed.unsupported_kinds).to_equal("invalid-damage-plan")
        expect(malformed.ops_rendered).to_equal(0)
        expect(engine.read_pixels()).to_equal([
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG,
            BG, BG, BG, BG, BG, BG, BG, BG
        ])
        engine.shutdown()

    it "resolves retained GUI image commands while clipping damaged replay":
        var engine = Engine2D.create_with_backend(8, 4, "cpu")
        engine.clear(BG)
        engine.present()
        val image = engine2d_resolved_draw_ir_image(
            "image://retained-widget", 2, 1, [RED, GREEN])
        val command = draw_ir_image_command(
            "retained-widget", 3, 1, 2, 1, image.image_uri, [])
        val batch = draw_ir_batch(
            "widget-root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "widget-surface", "widget", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 8, 4, BG), command])
        val composition = draw_ir_composition(
            "widget-composition", "widget:8x4", DRAW_IR_BACKEND_CPU, [batch])
        val outcome = engine2d_draw_ir_render_composition_damaged_with_images(
            engine, composition, [image], [4, 1, 1, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.ops_rendered).to_equal(2)
        expect(outcome.readback.pixels[1 * 8 + 3]).to_equal(BG)
        expect(outcome.readback.pixels[1 * 8 + 4]).to_equal(GREEN)
        engine.shutdown()

    it "matches full redraw for ordered opaque multi-batch damage":
        val root = draw_ir_batch(
            "desktop", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "desktop", "desktop", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 8, 4, BG)])
        val window = draw_ir_batch(
            "window", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "window", "window", 3, 1, 3, 2, 1, 1000, true),
            [draw_ir_rect("window-fill", 0, 0, 3, 2, GREEN)])
        val composition = draw_ir_composition(
            "wm", "wm:8x4", DRAW_IR_BACKEND_CPU, [root, window])
        var images: [Engine2dResolvedDrawIrImage] = []

        var expected_engine = Engine2D.create_with_backend(8, 4, "cpu")
        expected_engine.clear(BG)
        val expected = engine2d_draw_ir_adv_composition_with_images(
            expected_engine, composition, false, images)

        var damaged_engine = Engine2D.create_with_backend(8, 4, "cpu")
        damaged_engine.clear(BG)
        damaged_engine.present()
        val damaged = engine2d_draw_ir_render_composition_damaged_with_images(
            damaged_engine, composition, images, [3, 1, 3, 2], true)
        damaged_engine = damaged.engine
        expect(damaged.unsupported_kinds).to_equal("none")
        expect(damaged.ops_skipped).to_equal(0)
        expect(damaged.readback.pixels).to_equal(expected.pixels)
        expected_engine.shutdown()
        damaged_engine.shutdown()

    it "reuses immutable batch plans across disjoint retained damage":
        val root = draw_ir_batch(
            "desktop-plan", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "desktop-plan", "desktop", 0, 0, 8, 4, 0, 1000, false),
            [draw_ir_rect("background-plan", 0, 0, 8, 4, BG)])
        val window = draw_ir_batch(
            "window-plan", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "window-plan", "window", 3, 1, 3, 2, 1, 1000, true),
            [draw_ir_rect("window-fill-plan", 0, 0, 3, 2, GREEN)])
        val composition = draw_ir_composition(
            "wm-plan", "wm-plan:8x4", DRAW_IR_BACKEND_CPU, [root, window])
        var images: [Engine2dResolvedDrawIrImage] = []
        var expected_engine = Engine2D.create_with_backend(8, 4, "cpu")
        expected_engine.clear(BG)
        val expected = engine2d_draw_ir_adv_composition_with_images(
            expected_engine, composition, false, images)
        var damaged_engine = Engine2D.create_with_backend(8, 4, "cpu")
        damaged_engine.clear(BG)
        damaged_engine.present()
        val damaged = engine2d_draw_ir_render_composition_damaged_with_images(
            damaged_engine, composition, images,
            [0, 0, 1, 1, 3, 1, 3, 2], true)
        damaged_engine = damaged.engine
        expect(damaged.unsupported_kinds).to_equal("none")
        expect(damaged.ops_rendered).to_equal(3)
        expect(damaged.ops_skipped).to_equal(0)
        expect(damaged.readback.pixels).to_equal(expected.pixels)
        expected_engine.shutdown()
        damaged_engine.shutdown()

    it "indexes embedded batch damage without scanning distant plain fills":
        var commands: [DrawIrCommand] = [
            draw_ir_rect("background", 0, 0, 511, 2, BG),
            draw_ir_rect("changed", 5, 0, 1, 1, RED)
        ]
        var i = 0
        while i < 512:
            commands.push(draw_ir_rect(
                "distant-{i}", 300 + (i % 200), 1,
                1, 1, BLUE))
            i += 1
        val batch = draw_ir_batch(
            "embedded-index", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "embedded-index", "window", 1, 1, 511, 2,
                1, 1000, true), commands)
        val composition = draw_ir_composition(
            "embedded-index", "embedded-index:512x2",
            DRAW_IR_BACKEND_CPU, [batch])
        var engine = Engine2D.create_with_backend(512, 2, "cpu")
        engine.clear(BG)
        engine.present()
        # The damage begins outside the embedded surface; the executor must
        # clamp it before local grid selection, then raster only its 1x1
        # overlap at the nonzero embedding offset.
        val outcome = engine2d_draw_ir_render_composition_damaged(
            engine, composition, [0, 1, 7, 1], true)
        engine = outcome.engine
        expect(outcome.unsupported_kinds).to_equal("none")
        expect(outcome.ops_rendered).to_equal(2)
        expect(outcome.commands_considered).to_equal(2)
        expect(outcome.commands_culled_by_damage).to_equal(512)
        engine.shutdown()

    it "matches full redraw for cropped translucent retained images":
        val root = draw_ir_batch(
            "desktop", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "desktop", "desktop", 0, 0, 4, 2, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 4, 2, BG)])
        val image = engine2d_resolved_draw_ir_image(
            "image://alpha", 2, 1, [HALF_RED, GREEN])
        val old_image = engine2d_resolved_draw_ir_image(
            "image://alpha", 2, 1, [BLUE, GREEN])
        val overlay = draw_ir_batch(
            "overlay", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "overlay", "overlay", 1, 0, 2, 1, 1, 1000, false),
            [draw_ir_image_command(
                "alpha", 0, 0, 2, 1, image.image_uri, [])])
        val composition = draw_ir_composition(
            "alpha-wm", "alpha:4x2", DRAW_IR_BACKEND_CPU,
            [root, overlay])
        var expected_engine = Engine2D.create_with_backend(4, 2, "cpu")
        expected_engine.clear(BG)
        val expected = engine2d_draw_ir_adv_composition_with_images(
            expected_engine, composition, false, [image])
        var damaged_engine = Engine2D.create_with_backend(4, 2, "cpu")
        damaged_engine.clear(BG)
        val old_frame = engine2d_draw_ir_adv_composition_present_with_images(
            damaged_engine, composition, false, [old_image])
        val damaged = engine2d_draw_ir_render_composition_damaged_with_images(
            damaged_engine, composition, [image], [1, 0, 1, 1], true)
        damaged_engine = damaged.engine
        expect(damaged.unsupported_kinds).to_equal("none")
        expect(damaged.readback.pixels).to_equal(expected.pixels)
        expect(damaged.readback.pixels[1]).to_equal(HALF_RED_OVER_BG)
        expected_engine.shutdown()
        damaged_engine.shutdown()

    it "matches full redraw for clipped repeating CSS background damage":
        val root = draw_ir_batch(
            "root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "root", "root", 0, 0, 4, 3, 0, 1000, false),
            [
                draw_ir_rect("background", 0, 0, 4, 3, BG),
                draw_ir_image_command(
                    "css", 0, 0, 4, 3, "image://damage-css",
                    _css_background_style("repeat", "1", "1", "2", "2"))
            ])
        val composition = draw_ir_composition(
            "css-damage", "css:4x3", DRAW_IR_BACKEND_CPU, [root])
        val image = engine2d_resolved_draw_ir_image(
            "image://damage-css", 2, 2, [RED, GREEN, BLUE, HALF_RED])
        var expected_engine = Engine2D.create_with_backend(4, 3, "cpu")
        expected_engine.clear(BG)
        val expected = engine2d_draw_ir_adv_composition_with_images(
            expected_engine, composition, false, [image])
        var damaged_engine = Engine2D.create_with_backend(4, 3, "cpu")
        damaged_engine.clear(BG)
        val retained = engine2d_draw_ir_adv_composition_present_with_images(
            damaged_engine, composition, false, [image])
        val damaged = engine2d_draw_ir_render_composition_damaged_with_images(
            damaged_engine, composition, [image], [2, 1, 1, 1], true)
        damaged_engine = damaged.engine
        expect(damaged.unsupported_kinds).to_equal("none")
        expect(damaged.readback.pixels).to_equal(expected.pixels)
        expected_engine.shutdown()
        damaged_engine.shutdown()

    it "matches full redraw for non-integer scaled image damage":
        val root = draw_ir_batch(
            "root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "root", "root", 0, 0, 7, 4, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 7, 4, BG)])
        val image = engine2d_resolved_draw_ir_image(
            "image://scaled-damage", 2, 2,
            [RED, GREEN, BLUE, HALF_RED])
        val old_image = engine2d_resolved_draw_ir_image(
            "image://scaled-damage", 2, 2,
            [RED, GREEN, BLUE, YELLOW])
        val overlay = draw_ir_batch(
            "scaled", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "scaled", "scaled", 1, 1, 5, 3, 1, 1000, false),
            [draw_ir_image_command(
                "scaled", 0, 0, 5, 3, image.image_uri, [])])
        val composition = draw_ir_composition(
            "scaled-damage", "scaled:7x4", DRAW_IR_BACKEND_CPU,
            [root, overlay])
        var expected_engine = Engine2D.create_with_backend(7, 4, "cpu")
        expected_engine.clear(BG)
        val expected = engine2d_draw_ir_adv_composition_with_images(
            expected_engine, composition, false, [image])
        var damaged_engine = Engine2D.create_with_backend(7, 4, "cpu")
        damaged_engine.clear(BG)
        val old_frame = engine2d_draw_ir_adv_composition_present_with_images(
            damaged_engine, composition, false, [old_image])
        val damaged = engine2d_draw_ir_render_composition_damaged_with_images(
            damaged_engine, composition, [image], [4, 3, 2, 1], true)
        damaged_engine = damaged.engine
        expect(damaged.unsupported_kinds).to_equal("none")
        expect(damaged.readback.pixels).to_equal(expected.pixels)
        expected_engine.shutdown()
        damaged_engine.shutdown()

    it "matches full redraw for non-integer downscaled image damage":
        val root = draw_ir_batch(
            "root", DRAW_IR_BACKEND_CPU,
            draw_ir_embedding_config(
                "root", "root", 0, 0, 5, 4, 0, 1000, false),
            [draw_ir_rect("background", 0, 0, 5, 4, BG)])
        val image = engine2d_resolved_draw_ir_image(
            "image://downscaled-damage", 3, 3,
            [RED, GREEN, BLUE, BLUE, HALF_RED, RED,
             GREEN, BLUE, RED])
        val old_image = engine2d_resolved_draw_ir_image(
            "image://downscaled-damage", 3, 3,
            [RED, GREEN, BLUE, BLUE, YELLOW, RED,
             GREEN, BLUE, RED])
        val overlay = draw_ir_batch(
            "downscaled", DRAW_IR_BACKEND_CPU,
