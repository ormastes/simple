            draw_ir_rect("top", 3, 0, 5, 4, GREEN),
            draw_ir_rect("bottom", 3, 4, 5, 6, GREEN)
        ])

        expect(plan.commands.len()).to_equal(1)
        expect(plan.commands[0].x).to_equal(3)
        expect(plan.commands[0].y).to_equal(0)
        expect(plan.commands[0].width).to_equal(5)
        expect(plan.commands[0].height).to_equal(10)
        expect(plan.logical_weights).to_equal([2])

    it "keeps color gaps and non-rectangle barriers unmerged":
        val different_color = engine2d_draw_ir_coalesce_plain_fills([
            draw_ir_rect("red", 0, 0, 4, 2, RED),
            draw_ir_rect("green", 4, 0, 4, 2, GREEN)
        ])
        val gap = engine2d_draw_ir_coalesce_plain_fills([
            draw_ir_rect("left", 0, 0, 4, 2, RED),
            draw_ir_rect("right", 5, 0, 4, 2, RED)
        ])
        val text_barrier = engine2d_draw_ir_coalesce_plain_fills([
            draw_ir_rect("left", 0, 0, 4, 2, RED),
            draw_ir_text("text", 4, 0, "x", GREEN),
            draw_ir_rect("right", 4, 0, 4, 2, RED)
        ])

        expect(different_color.commands.len()).to_equal(2)
        expect(different_color.logical_weights.len()).to_equal(0)
        expect(gap.commands.len()).to_equal(2)
        expect(gap.logical_weights.len()).to_equal(0)
        expect(text_barrier.commands.len()).to_equal(3)
        expect(text_barrier.logical_weights.len()).to_equal(0)

    it "renders coalesced fills exactly while preserving logical command receipts":
        var engine = Engine2D.create_with_backend(12, 3, "cpu")
        engine.clear(BG)
