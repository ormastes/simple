"""
# A translucent rect blend reads only its own pixels back

`emu_draw_rect_blend` (Engine2D's `draw_rect_blend` on the software / cpu /
cpu_simd lanes) read the WHOLE frame back with `core.read_pixels()` to blend
one rect. The disclosure-triangle path fill blends each anti-aliased edge
pixel as a 1x1 rect, so forms-media at device scale 4 (3600x3040) copied the
frame ~100 times: +9 GB RSS under the JIT in one 44x44 path command, ~1 s of
paint, and ~20 s more once the run hit an 8 GB memory cap.

The fixture blends 200 small rects onto a 3000x3000 cpu_simd frame in a JIT
child. Measured on seed d9dcc6f7: 6.07 s and 8.36 GB with the full-frame read.
The budget (200 ms) is far below that. The blended pixels must equal the
interpreter's, including a rect clipped by the frame's right edge.
"""
use std.spec.step

use std.spipe.*
use std.io.{process_run, env_get, env_set}

fn simple_binary() -> text:
    var configured = env_get("SIMPLE_BIN") ?? ""
    if configured == "":
        configured = env_get("SIMPLE_BINARY") ?? ""
    if configured.len() > 0:
        return configured
    "bin/simple"

val FIXTURE = "test/fixtures/engine2d_blend_region/small_blend_loop.spl"

fn run_fixture(mode: text) -> (text, text, i64):
    val previous = env_get("SIMPLE_EXECUTION_MODE") ?? ""
    val prev_warn = env_get("SIMPLE_RUST_SEED_WARNING") ?? ""
    env_set("SIMPLE_EXECUTION_MODE", mode)
    env_set("SIMPLE_RUST_SEED_WARNING", "0")
    val result = process_run(simple_binary(), ["run", FIXTURE])
    env_set("SIMPLE_RUST_SEED_WARNING", prev_warn)
    env_set("SIMPLE_EXECUTION_MODE", previous)
    result

# Value of `key=` on the fixture's report line, or "" when absent.
fn report_field(stdout: text, key: text) -> text:
    for line in stdout.split("\n"):
        if line.starts_with("backend="):
            for part in line.split(" "):
                if part.starts_with(key + "="):
                    return part.substring(key.len() + 1, part.len())
    ""

describe "translucent rect blend reads back only the rect":
    # @manual scenario evidence

    it "200 small blends on a 3000x3000 frame take under 200 ms on the JIT":
        # @req: REQ-SSPEC-UNIT
        val (stdout, stderr, code) = run_fixture("jit")
        expect code == 0
        expect report_field(stdout, "backend") == "cpu_simd"
        val loop_us = report_field(stdout, "loop_us").to_int() ?? -1
        expect loop_us >= 0
        expect loop_us < 200000

    it "JIT blended pixels equal the interpreter's":
        # @req: REQ-SSPEC-UNIT
        val (jit_out, jit_err, jit_code) = run_fixture("jit")
        val (int_out, int_err, int_code) = run_fixture("interpreter")
        expect jit_code == 0
        expect int_code == 0
        expect report_field(jit_out, "acc") != ""
        expect report_field(jit_out, "acc") == report_field(int_out, "acc")
        expect report_field(jit_out, "edge") == report_field(int_out, "edge")
