"""
## Purpose and audience
Purpose: Prove that Engine2D Vulkan backend compute matches the reference.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @tag: unit, gpu, engine2d, vulkan, oracle
"""
# Vulkan Compute Oracle

**Category:** Runtime
**Status:** Implemented
**Requirements:** N/A
**Plan:** doc/03_plan/ui/production_readiness_master_plan_2026-07-02.md
**Design:** doc/04_architecture/ui/simple_gui_stack.md
**Research:** doc/09_report/linux_renderdoc_simpleos_hardening_evidence_current_2026-07-02.md

## Overview

A *real* reference test for the Engine2D Vulkan backend. It dispatches real
SPIR-V compute kernels through `VulkanBackend`, reads the framebuffer back from
device memory, and compares every pixel against an independent reference: either
a pure-Simple first-principles oracle, or the `SoftwareBackend` rendering of the
same primitive. The two emulation backends (`metal-on-vulkan`,
`directx-on-vulkan`) are checked the same way. Unlike a sentinel "selection
path" check, this proves real GPU output equals the expected pixels.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Reference oracle | First-principles `oracle_pixel`, or `SoftwareBackend` rendering the same call — never the GPU compared to itself |
| Classic-interpret gate | Real `rt_vulkan_*` only run under `SIMPLE_EXECUTION_MODE=interpret`; elsewhere the device count is 0 and the test asserts that honestly |
| Emulation disclosure | A `metal`/`directx-on-vulkan` request must report a backend name that does not claim a native driver |

## Related Specifications

- [Web-Render Engine2D Surface](../../ui/web_render_engine2d_surface_spec.md) — the same backends on the web-render API surface

## Syntax

The scenarios use `std.spec` steps and concrete pixel comparisons. Vulkan
unavailability is not skipped silently: off-host runs must prove the device
count is zero before returning.
"""

use std.spec.*
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}
use std.gc_async_mut.gpu.engine2d.backend_software.{SoftwareBackend}
use std.common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    DRAW_IR_COMMAND_EDGE,
    DRAW_IR_EDGE_BEZIER,
    DRAW_IR_EDGE_STRAIGHT,
    DrawIrComposition,
    draw_edge,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_edge_command,
    draw_ir_embedding_config,
    draw_ir_path_command,
    draw_ir_point,
    draw_ir_rect,
    draw_ir_style_prop,
    draw_ir_text_resolved_font
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{engine2d_draw_ir_adv_batch, engine2d_draw_ir_adv_composition, engine2d_draw_ir_adv_strict_vulkan_primitives_with_images}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.text_layout.font_renderer.{resolve_font_metrics}
use std.nogc_sync_mut.gpu.engine2d.sffi_vulkan.{vulkan_sffi_device_count}

# Count pixels that differ between two equal-length framebuffers.
fn pixel_mismatches(a: [u32], b: [u32]) -> i64:
    var m = 0
    var i = 0
    val n = if a.len() < b.len(): a.len() else: b.len()
    while i < n:
        if a[i] != b[i]:
            m = m + 1
        i = i + 1
    m

# Pure-Simple first-principles oracle: a clear to `bg` followed by a filled rect
# of `fg` covering [rx, rx+rw) x [ry, ry+rh). Returns the expected ARGB per pixel.
fn oracle_pixel(x: i32, y: i32, rx: i32, ry: i32, rw: i32, rh: i32, bg: u32, fg: u32) -> u32:
    val inside = (x >= rx and x < rx + rw and y >= ry and y < ry + rh)
    if inside:
        return fg
    bg

# Independent integer Bresenham oracle for the promoted opaque width-1 line.
fn line_oracle(w: i32, h: i32, x1: i32, y1: i32, x2: i32, y2: i32, bg: u32, fg: u32) -> [u32]:
    var pixels: [u32] = [bg; w * h]
    oracle_line_into(pixels, w, h, x1, y1, x2, y2, fg)

fn oracle_line_into(base: [u32], w: i32, h: i32, x1: i32, y1: i32, x2: i32, y2: i32, fg: u32) -> [u32]:
    var pixels = base
    var dx = x2 - x1
    var dy = y2 - y1
    if dx < 0: dx = -dx
    if dy < 0: dy = -dy
    var sx: i32 = 1
    if x1 > x2: sx = -1
    var sy: i32 = 1
    if y1 > y2: sy = -1
    var err = dx - dy
    var cx = x1
    var cy = y1
    while true:
        if cx >= 0 and cx < w and cy >= 0 and cy < h:
            pixels[cy * w + cx] = fg
        if cx == x2 and cy == y2:
            return pixels
        val e2 = 2 * err
        if e2 > -dy:
            err = err - dy
            cx = cx + sx
        if e2 < dx:
            err = err + dx
            cy = cy + sy
    pixels

# A performance receipt is accepted only when an external live runner records
# exactly twenty positive frame/RSS samples and reports the nearest-rank p95.
# This unit suite intentionally supplies no synthetic positive timings.
fn warm_perf_receipt_schema_valid(frame_ns: [i64], rss_kib: [i64], p95_ns: i64) -> bool:
    if frame_ns.len() != 20 or rss_kib.len() != 20 or p95_ns <= 0:
        return false
    var less = 0
    var equal = 0
    for sample in frame_ns:
        if sample <= 0:
            return false
        if sample < p95_ns:
            less = less + 1
        elif sample == p95_ns:
            equal = equal + 1
    for rss in rss_kib:
        if rss <= 0:
            return false
    # ceil(20 * .95) == 19; p95 must itself be a measured sample.
    less < 19 and less + equal >= 19

fn showcase_vulkan_frame(
    frame_id: text, marker_x: i32, family: text, identity: text,
    advances: [i32], text_width: i32, line_height: i32
) -> DrawIrComposition:
    val text = draw_ir_text_resolved_font(
        "showcase-title", 8, 8, "Simple2D Vulkan", 0xFFF0DCB4u32,
        family, identity, advances, text_width, line_height, 18)
    val batch = draw_ir_batch(
        "showcase-batch-" + frame_id, DRAW_IR_BACKEND_GPU,
        draw_ir_embedding_config("showcase", "vulkan", 0, 0, 128, 72, 0, 1000, false),
        [draw_ir_rect("background", 0, 0, 128, 72, 0xFF03070Bu32),
         draw_ir_rect("animated-marker", marker_x, 48, 16, 12, 0xFF22D3EEu32),
         text])
    draw_ir_composition(
        "showcase-frame-" + frame_id, "simple2d-showcase",
        DRAW_IR_BACKEND_GPU, [batch])

# First-principles vertical-gradient oracle: an endpoint-exact integer lerp.
# row 0 == top color, row h-1 == bottom color; channel = top + (bot-top)*row/max_t
# with max_t = max(h-1, 1) and truncating integer division. Independent of both
# the GPU blob and SoftwareBackend (which happens to use the same convention).
fn _gr(c: u32) -> i64: ((c / 65536u32) % 256u32).to_i64()
fn _gg(c: u32) -> i64: ((c / 256u32) % 256u32).to_i64()
fn _gb(c: u32) -> i64: (c % 256u32).to_i64()
fn _ga(c: u32) -> i64: ((c / 16777216u32) % 256u32).to_i64()

fn gradient_oracle_row(row: i32, h: i32, top: u32, bot: u32) -> u32:
    var max_t = h - 1
    if max_t < 1:
        max_t = 1
    val mt = max_t.to_i64()
    val rw = row.to_i64()
    val r = _gr(top) + (_gr(bot) - _gr(top)) * rw / mt
    val g = _gg(top) + (_gg(bot) - _gg(top)) * rw / mt
    val b = _gb(top) + (_gb(bot) - _gb(top)) * rw / mt
    val a = _ga(top) + (_ga(bot) - _ga(top)) * rw / mt
    (a * 16777216 + r * 65536 + g * 256 + b).to_u32()

use std.spec.step

describe "Engine2D Vulkan backend compute matches the reference":

    # @capture
    it "real GPU clear+rect equals the first-principles CPU oracle":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        val w: i32 = 16
        val h: i32 = 8
        val bg: u32 = 0xFF112233u32
        val fg: u32 = 0xFFAABBCCu32
        val rx: i32 = 4
        val ry: i32 = 2
        val rw: i32 = 6
        val rh: i32 = 3

        step("Create and initialize the Vulkan backend")
        var be = VulkanBackend.create()
        val available = be.init(w, h)

        step("If real Vulkan is unavailable, assert the device count is honestly zero")
        if not available:
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Dispatch a real GPU clear and a filled rect, then read the framebuffer back")
        be.clear(bg)
        be.draw_rect_filled(rx, ry, rw, rh, fg)
        val px = be.read_pixels()
        expect(px.len()).to_equal(w * h)

        step("Every pixel equals the independent first-principles oracle")
        var mismatches = 0
        var y = 0
        while y < h:
            var x = 0
            while x < w:
                val idx = y * w + x
                val expected = oracle_pixel(x, y, rx, ry, rw, rh, bg, fg)
                if px[idx] != expected:
                    mismatches = mismatches + 1
                x = x + 1
            y = y + 1
        expect(mismatches).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "Vulkan raster kernels match the SoftwareBackend reference":
        # Regression guard for the no-op-shader wiring bug: these primitives were
        # dispatched on a no-op SPIR-V shader and rendered nothing. Wired to their
        # real validated kernels, they must be bit-exact with the independent
        # SoftwareBackend reference. rounded_rect and circle_outline additionally
        # fixed SoftwareBackend bugs (outline vs fill, Bresenham vs distance-ring);
        # line and gradient were recovered via spirv-dis of the blobs.
        val w: i32 = 64
        val h: i32 = 48
        val bg: u32 = 0xFF0A0A12u32
        val fg: u32 = 0xFF40C0A0u32

        step("Create the Vulkan backend; if unavailable, assert zero devices honestly")
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Create the SoftwareBackend reference at the same size")
        var sw = SoftwareBackend.create()
        sw.init(w, h)

        # Only the kernels bit-exact with the (Metal-bit-exact) SoftwareBackend
        # are checked here: circle_filled, rect_outline, triangle_filled and
        # the promoted exact line lane. Circle outline and rounded rect remain
        # out of the promoted set because their shipped blobs diverge from the
        # shared CPU contract.
        step("circle_filled, rect_outline, triangle_filled and line match the reference")
        vk.clear(bg)
        sw.clear(bg)
        vk.draw_circle_filled(30, 24, 12, fg)
        sw.draw_circle_filled(30, 24, 12, fg)
        vk.draw_rect(5, 5, 40, 30, fg)
        sw.draw_rect(5, 5, 40, 30, fg)
        vk.draw_triangle_filled(10, 44, 30, 6, 54, 44, fg)
        sw.draw_triangle_filled(10, 44, 30, 6, 54, 44, fg)
        expect(pixel_mismatches(vk.read_pixels(), sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "exact opaque Vulkan line has device receipt and CPU-oracle parity":
        step("Verify: exact opaque Vulkan line has device receipt and CPU-oracle parity")
        val w: i32 = 16
        val h: i32 = 12
        val bg: u32 = 0xFF101018u32
        val fg: u32 = 0xFF40C0A0u32
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return
        vk.clear(bg)
        vk.draw_line(1, 1, 13, 8, fg, 1)
        val readback = vk.read_pixels_with_source()
        val expected = line_oracle(w, h, 1, 1, 13, 8, bg, fg)
        expect(readback.source).to_equal("device_readback")
        expect(readback.backend_handle).to_be_greater_than(0)
        expect(readback.device_identity).to_be_greater_than(0)
        expect(vk.cpu_fallback_used).to_be(false)
        expect(pixel_mismatches(readback.pixels, expected)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        vk.shutdown()

    it "strict DrawIR clear, rect, EDGE and PATH require exact device-readback oracle parity":
        step("Verify: strict DrawIR clear, rect, EDGE and PATH require exact device-readback oracle parity")
        val w: i32 = 16
        val h: i32 = 12
        val bg: u32 = 0xFF101018u32
        val red: u32 = 0xFFFF4040u32
        val green: u32 = 0xFF40C0A0u32

        # Strict creation is the provenance gate: this test must never accept
        # Engine2D's ordinary CPU fallback as GPU evidence.
        val created = Engine2D.create_with_backend_strict(w, h, "vulkan")
        if not created.is_ok():
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return
        var engine = created.unwrap()

        # EDGE is a single shared-line primitive; PATH is deliberately
        # multi-segment to prove the batch executes every linear segment on
        # the same persistent Vulkan Engine2D/session.
        val edge = draw_ir_edge_command(draw_edge(
            "device-edge", "left", "right", DRAW_IR_EDGE_STRAIGHT,
            [draw_ir_point(1, 1), draw_ir_point(5, 3)],
            [draw_ir_style_prop("stroke-color", "{red}"),
             draw_ir_style_prop("stroke-width", "1")]
        ))
        val path = draw_ir_path_command(
            "device-path",
            [draw_ir_point(8, 2), draw_ir_point(8, 5),
             draw_ir_point(12, 5), draw_ir_point(9, 8),
             draw_ir_point(6, 6), draw_ir_point(6, 6)],
            [draw_ir_style_prop("stroke-color", "{green}"),
             draw_ir_style_prop("stroke-width", "1")]
        )
        val batch = draw_ir_batch(
            "vulkan-linear-primitives", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, w, h, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, w, h, bg),
             draw_ir_rect("rect", 2, 7, 4, 3, 0xFF4060E0u32),
             edge, path]
        )
        val composition = draw_ir_composition(
            "vulkan-linear-primitives", "scene", DRAW_IR_BACKEND_GPU,
            [batch])

        # Build the oracle directly from primitive semantics; no renderer or
        # fallback backend contributes pixels to the accepted result.
        var expected: [u32] = [bg; w * h]
        var ry = 7
        while ry < 10:
            var rx = 2
            while rx < 6:
                expected[ry * w + rx] = 0xFF4060E0u32
                rx = rx + 1
            ry = ry + 1
        expected = oracle_line_into(expected, w, h, 1, 1, 5, 3, red)
        expected = oracle_line_into(expected, w, h, 8, 2, 8, 5, green)
        expected = oracle_line_into(expected, w, h, 8, 5, 12, 5, green)
        expected = oracle_line_into(expected, w, h, 12, 5, 9, 8, green)
        expected = oracle_line_into(expected, w, h, 9, 8, 6, 6, green)
        expected = oracle_line_into(expected, w, h, 6, 6, 6, 6, green)

        val result = engine2d_draw_ir_adv_strict_vulkan_primitives_with_images(
            engine, composition, [])
        expect(engine.backend_name()).to_equal("vulkan")
        expect(result.selected_backend).to_equal(DRAW_IR_BACKEND_GPU)
        expect(result.rendered_command_count).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(result.skipped_command_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.fallback_required).to_be(false)
        expect(result.readback_source).to_equal("device_readback")
        expect(result.backend_handle).to_be_greater_than(0)
        expect(result.device_identity).to_be_greater_than(0)
        expect(pixel_mismatches(result.pixels, expected)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        engine.shutdown()

    it "Simple2D showcase animation reuses one Vulkan font batch/session and produces distinct device frames":
        step("Verify: Simple2D showcase animation reuses one Vulkan font batch/session and produces distinct device frames")
        val width: i32 = 128
        val height: i32 = 72
        val font_path = "assets/fonts/google-fonts/ofl/notosansmono/NotoSansMono[wdth,wght].ttf"
        val content = "Simple2D Vulkan"
        val created = Engine2D.create_with_backend_strict(width, height, "vulkan")
        if not created.is_ok():
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return
        var engine = created.unwrap()
        expect(engine.load_font(font_path)).to_be(true)
        val metrics = resolve_font_metrics(font_path, content, 18)
        expect(metrics.valid).to_be(true)
        expect(metrics.identity).to_equal(engine.selected_font_identity())

        # Frame state changes only the marker position. Text remains the same
        # semantic DrawIR command so the FontRenderer/FontRenderBatch cache is
        # required to stay owned by the persistent Engine2D session.
        val first_frame = showcase_vulkan_frame(
            "1", 12, metrics.family, metrics.identity, metrics.advances,
            metrics.width, metrics.line_height)
        val second_frame = showcase_vulkan_frame(
            "2", 72, metrics.family, metrics.identity, metrics.advances,
            metrics.width, metrics.line_height)
        val font_before = engine.font_cache_stats()
        val cold = engine2d_draw_ir_adv_composition(engine, first_frame, true)
        val font_cold = engine.font_cache_stats()
        val warm = engine2d_draw_ir_adv_composition(engine, second_frame, true)
        val font_warm = engine.font_cache_stats()

        expect(engine.backend_name()).to_equal("vulkan")
        expect(cold.selected_backend).to_equal(DRAW_IR_BACKEND_GPU)
        expect(cold.rendered_command_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(cold.skipped_command_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(cold.fallback_required).to_be(false)
        expect(cold.fallback_reason).to_equal("")
        expect(cold.readback_source).to_equal("device_readback")
        expect(cold.backend_handle).to_be_greater_than(0)
        expect(cold.device_identity).to_be_greater_than(0)
        expect(cold.readback_checksum).to_be_greater_than(0)
        expect(cold.font_execution_target).to_equal("vulkan")
        expect(cold.font_identity).to_equal(metrics.identity)
        expect(cold.font_batch_identity != "").to_be(true)
        expect(cold.font_readback_source).to_equal("device_readback")
        expect(cold.font_device_checksum).to_be_greater_than(0)
        expect(cold.font_device_checksum).to_equal(cold.font_oracle_checksum)
        expect(cold.font_readback_nonblank_pixels).to_be_greater_than(0)
        expect(cold.font_parity).to_be(true)
        expect(cold.font_device_executed).to_be(true)
        expect(cold.font_promotion_ready).to_be(true)
        expect(cold.font_atlas_upload_count).to_be_greater_than(0)
        expect(cold.font_atlas_upload_bytes).to_be_greater_than(0)
        expect(cold.font_atlas_payload_sha256.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement

        expect(warm.rendered_command_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(warm.skipped_command_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(warm.fallback_required).to_be(false)
        expect(warm.fallback_reason).to_equal("")
        expect(warm.readback_source).to_equal("device_readback")
        expect(warm.backend_handle).to_equal(cold.backend_handle)
        expect(warm.device_identity).to_equal(cold.device_identity)
        expect(warm.readback_checksum).to_be_greater_than(0)
        expect(warm.readback_checksum == cold.readback_checksum).to_be(false)
        expect(warm.font_execution_target).to_equal("vulkan")
        expect(warm.font_batch_identity).to_equal(cold.font_batch_identity)
        expect(warm.font_readback_source).to_equal("device_readback")
        expect(warm.font_device_checksum).to_equal(warm.font_oracle_checksum)
        expect(warm.font_parity).to_be(true)
        expect(warm.font_device_executed).to_be(true)
        expect(warm.font_promotion_ready).to_be(true)
        expect(warm.font_atlas_upload_count).to_equal(cold.font_atlas_upload_count)
        expect(warm.font_atlas_upload_bytes).to_equal(cold.font_atlas_upload_bytes)
        expect(warm.font_atlas_payload_sha256).to_equal(cold.font_atlas_payload_sha256)
        expect(font_cold.rasterizations - font_before.rasterizations).to_be_greater_than(0)
        expect(font_warm.rasterizations - font_cold.rasterizations).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(font_warm.hits - font_cold.hits).to_be_greater_than(0)
        engine.shutdown()

    it "does not certify unmeasured or short showcase performance receipts":
        step("Verify: does not certify unmeasured or short showcase performance receipts")
        # Do not manufacture frame times/RSS in a unit test. A live wrapper is
        # responsible for filling this schema with twenty real warm samples.
        expect(warm_perf_receipt_schema_valid([], [], 0)).to_be(false)

    it "DrawIR curved EDGE fails closed before Vulkan dispatch":
        step("Verify: DrawIR curved EDGE fails closed before Vulkan dispatch")
        val w: i32 = 12
        val h: i32 = 12
        val bg: u32 = 0xFF101018u32
        val red: u32 = 0xFFFF4040u32
        val created = Engine2D.create_with_backend_strict(w, h, "vulkan")
        if not created.is_ok():
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return
        var engine = created.unwrap()
        engine.clear(bg)
        val curved = draw_ir_edge_command(draw_edge(
            "curve-rejected", "left", "right", DRAW_IR_EDGE_BEZIER,
            [draw_ir_point(1, 1), draw_ir_point(8, 8)],
            [draw_ir_style_prop("stroke-color", "{red}"),
             draw_ir_style_prop("stroke-width", "1")]
        ))
        val batch = draw_ir_batch(
            "vulkan-curve-rejected", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, w, h, 0, 1000, false),
            [curved]
        )

        val result = engine2d_draw_ir_adv_batch(engine, batch, true)
        expect(result.rendered_command_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.skipped_command_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.fallback_required).to_be(true)
        expect(result.fallback_reason).to_contain(DRAW_IR_COMMAND_EDGE)
        expect(result.readback_source).to_equal("device_readback")
        expect(result.pixels[1 * w + 1]).to_equal(bg)
        engine.shutdown()

    it "Vulkan draw_image uploads source pixels into the device framebuffer":
        val w: i32 = 16
        val h: i32 = 16
        val bg: u32 = 0xFF102030u32
        val src = [
            0xFF010203u32, 0xFF112233u32,
            0xFFAABBCCu32, 0xFFDDEEFFu32
        ]

        step("Create the Vulkan backend; if unavailable, assert zero devices honestly")
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Blit a 2x2 image and verify device readback matches the source")
        vk.clear(bg)
        vk.draw_image(8, 8, 2, 2, src)
        val px = vk.read_pixels()
        expect(px[8 * w + 8]).to_equal(src[0])
        expect(px[8 * w + 9]).to_equal(src[1])
        expect(px[9 * w + 8]).to_equal(src[2])
        expect(px[9 * w + 9]).to_equal(src[3])
        expect(px[7 * w + 7]).to_equal(bg)

    it "Vulkan draw_image clipping matches the SoftwareBackend reference":
        val w: i32 = 6
        val h: i32 = 5
        val bg: u32 = 0xFF102030u32
        val src = [
            0xFF010203u32, 0xFF112233u32, 0xFF223344u32,
            0xFFAABBCCu32, 0xFFBBCCDDu32, 0xFFDDEEFFu32
        ]

        step("Create the Vulkan backend; if unavailable, assert zero devices honestly")
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Render the same partially clipped image through Vulkan and SoftwareBackend")
        var sw = SoftwareBackend.create()
        sw.init(w, h)
        vk.clear(bg)
        sw.clear(bg)
        vk.draw_image(-1, 2, 3, 2, src)
        sw.draw_image(-1, 2, 3, 2, src)

        step("Every readback pixel matches the software clipping contract")
        expect(pixel_mismatches(vk.read_pixels(), sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement

        step("An active Engine2D clip rectangle is also honored")
        vk.clear(bg)
        sw.clear(bg)
        vk.set_clip(1, 2, 1, 1)
        sw.set_clip(1, 2, 1, 1)
        vk.draw_image(-1, 2, 3, 2, src)
        sw.draw_image(-1, 2, 3, 2, src)
        val clipped = vk.read_pixels()
        expect(pixel_mismatches(clipped, sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(clipped[2 * w + 0]).to_equal(bg)
        expect(clipped[2 * w + 1]).to_equal(src[2])
        expect(clipped[3 * w + 1]).to_equal(bg)

        step("An active Engine2D mask is also honored")
        val mask = [
            1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
            1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
            1u8, 0u8, 1u8, 1u8, 1u8, 1u8,
            1u8, 1u8, 1u8, 1u8, 1u8, 1u8,
            1u8, 1u8, 1u8, 1u8, 1u8, 1u8
        ]
        vk.clear_clip()
        sw.clear_clip()
        vk.set_mask(mask, w, h)
        sw.set_mask(mask, w, h)
        vk.clear(bg)
        sw.clear(bg)
        vk.draw_image(-1, 2, 3, 2, src)
        sw.draw_image(-1, 2, 3, 2, src)
        val masked = vk.read_pixels()
        expect(pixel_mismatches(masked, sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(masked[2 * w + 0]).to_equal(src[1])
        expect(masked[2 * w + 1]).to_equal(bg)

    it "Vulkan alpha image compositing stays device-backed and matches SoftwareBackend":
        val w: i32 = 6
        val h: i32 = 5
        val bg: u32 = 0xFF102030u32
        val src = [
            0x004080C0u32, 0x804080C0u32, 0xFF112233u32,
            0x4000FF00u32, 0xC0FF0000u32, 0x200000FFu32
        ]

        step("Create the Vulkan backend; if unavailable, assert zero devices honestly")
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Render one clipped alpha IMAGE through Vulkan src-over")
        var sw = SoftwareBackend.create()
        sw.init(w, h)
        vk.clear(bg)
        sw.clear(bg)
        vk.set_clip(1, 1, 3, 3)
        sw.set_clip(1, 1, 3, 3)
        vk.draw_image_blend(-1, 1, 3, 2, src)
        sw.draw_image_blend(-1, 1, 3, 2, src)

        step("Every pixel matches the software oracle without CPU fallback")
        val readback = vk.read_pixels_with_source()
        expect(pixel_mismatches(readback.pixels, sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(readback.source).to_equal("device_readback")
        expect(readback.backend_handle).to_be_greater_than(0)
        expect(vk.cpu_fallback_used).to_be(false)
        expect(vk.completion_unknown).to_be(false)

        step("Opacity 500 uses the same checked device path and integer alpha scaling")
        val half_alpha_src = [
            0x004080C0u32, 0x404080C0u32, 0x7F112233u32,
            0x2000FF00u32, 0x60FF0000u32, 0x100000FFu32
        ]
        vk.clear_clip()
        sw.clear_clip()
        vk.clear(bg)
        sw.clear(bg)
        vk.set_clip(1, 1, 3, 3)
        sw.set_clip(1, 1, 3, 3)
        val opacity_status = vk._draw_image_blend_native(-1, 1, 3, 2, src, 500)
        sw.draw_image_blend(-1, 1, 3, 2, half_alpha_src)
        val opacity_readback = vk.read_pixels_with_source()
        expect(opacity_status).to_be_greater_than(0)
        expect(pixel_mismatches(opacity_readback.pixels, sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(opacity_readback.source).to_equal("device_readback")
        expect(opacity_readback.backend_handle).to_be_greater_than(0)
        expect(vk._draw_image_blend_native(0, 0, 3, 2, src, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "real GPU vertical gradient matches the endpoint-exact first-principles oracle":
        # Reconciliation guard (bug vulkan_raster_kernels_noop_and_divergent):
        # the gradient SPIR-V blob originally divided its integer lerp by the rect
        # height rh, so the bottom row never reached the bottom color. Its divisor
        # was fixed in SPIR-V to max(rh-1, 1); the kernel is now bit-exact with an
        # independent endpoint-exact integer-lerp oracle AND with SoftwareBackend.
        val w: i32 = 64
        val h: i32 = 48
        val top: u32 = 0xFF204080u32
        val bot: u32 = 0xFFC0E0F0u32

        step("Create the Vulkan backend; if unavailable, assert zero devices honestly")
        var vk = VulkanBackend.create()
        if not vk.init(w, h):
            expect(vulkan_sffi_device_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            return

        step("Dispatch the real GPU gradient and read the framebuffer back")
        vk.clear(0xFF000000u32)
        vk.draw_gradient_rect(0, 0, w, h, top, bot)
        val px = vk.read_pixels()
        expect(px.len()).to_equal(w * h)

        step("Every pixel equals the independent endpoint-exact integer-lerp oracle")
        var mismatches = 0
        var y = 0
        while y < h:
            val expected = gradient_oracle_row(y, h, top, bot)
            var x = 0
            while x < w:
                if px[y * w + x] != expected:
                    mismatches = mismatches + 1
                x = x + 1
            y = y + 1
        expect(mismatches).to_equal(0)  # oracle: 0 — named expected value from the requirement

        step("The top row is exactly the top color and the bottom row reaches the bottom color (the bug that was fixed)")
        expect(px[0]).to_equal(top)
        expect(px[(h - 1) * w]).to_equal(bot)

        step("Cross-check against the SoftwareBackend reference (same convention)")
        var sw = SoftwareBackend.create()
        sw.init(w, h)
        sw.clear(0xFF000000u32)
        sw.draw_gradient_rect(0, 0, w, h, top, bot)
        expect(pixel_mismatches(px, sw.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "Metal-on-Vulkan emulation renders through real Vulkan, matching the reference":
        val w: i32 = 56
        val h: i32 = 40

        step("Request the explicit Metal-on-Vulkan compatibility surface from Engine2D")
        val r = Engine2D.create_requested_backend(w, h, "metal-on-vulkan")
        if not r.is_ok():
            return
        var eng = r.unwrap()

        step("The backend name discloses emulation (or an honest CPU fallback) — never a fake native Metal driver")
        val name = eng.backend_name()
        val honest_name = (name == "metal-on-vulkan" or name == "metal" or name == "cpu" or name == "software")
        expect(honest_name).to_be(true)
        if name != "metal-on-vulkan":
            return

        step("Render verified primitives through the emulated backend and match the SoftwareBackend reference")
        eng.clear(0xFF0A0A12u32)
        eng.draw_rect_filled(4, 4, 30, 20, 0xFFCC2020u32)
        eng.draw_circle_filled(40, 20, 9, 0xFF3060FFu32)
        var sw2 = SoftwareBackend.create()
        sw2.init(w, h)
        sw2.clear(0xFF0A0A12u32)
        sw2.draw_rect_filled(4, 4, 30, 20, 0xFFCC2020u32)
        sw2.draw_circle_filled(40, 20, 9, 0xFF3060FFu32)
        expect(pixel_mismatches(eng.read_pixels(), sw2.read_pixels())).to_equal(0)  # oracle: 0 — named expected value from the requirement

