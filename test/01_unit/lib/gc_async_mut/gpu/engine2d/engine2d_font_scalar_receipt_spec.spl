"""Regression contract for native-safe Engine2D font producer receipts."""

use std.io_runtime.{file_read}
use std.spec.*

describe "Engine2D font scalar receipts":
    it "keeps plan and cache evidence off aggregate return channels":
        val engine = file_read("src/lib/gc_async_mut/gpu/engine2d/engine.spl")
        val font_types = file_read("src/lib/nogc_sync_mut/text_layout/font_types.spl")
        val renderer = file_read("src/lib/nogc_sync_mut/text_layout/font_renderer.spl")
        val rasterizer = file_read("src/lib/nogc_sync_mut/text_layout/font_rasterizer.spl")
        val spl_fonts = file_read("src/lib/nogc_sync_mut/sffi/spl_fonts.spl")
        val advances = file_read("src/lib/nogc_sync_mut/text_layout/font_advance_layout.spl")
        val probe = file_read("test/02_integration/rendering/engine2d_font_state_native_probe.spl")
        val draw_start = engine.index_of("    me draw_text_configured(") ?? -1
        val draw_end = engine.index_of("    me draw_text_with_advances(") ?? -1
        val draw_text = engine.substring(draw_start, draw_end)
        expect(draw_start).to_be_greater_than(-1)
        expect(draw_end).to_be_greater_than(draw_start)
        expect(draw_text).to_contain("val plan_count = font_execution_plan_into(")
        expect(draw_text).to_contain("var plan = self._font_plan_scratch")
        expect(draw_text).to_contain("if plan.len() == 0:")
        expect(draw_text.contains("var plan: [text] = []")).to_be(false)
        expect(draw_text.index_of("plan.len().to_i64() != plan_count") ?? -1).to_equal(-1)
        expect(draw_text.index_of("val plan = font_execution_plan(config,") ?? -1).to_equal(-1)
        val shaped_start = engine.index_of("    me draw_shaped_text_configured(") ?? -1
        val shaped_end = engine.index_of("    me load_font(") ?? -1
        val draw_shaped = engine.substring(shaped_start, shaped_end)
        expect(shaped_start).to_be_greater_than(-1)
        expect(shaped_end).to_be_greater_than(shaped_start)
        expect(draw_shaped).to_contain("val plan_count = font_execution_plan_into(")
        expect(draw_shaped).to_contain("var plan = self._font_plan_scratch")
        expect(draw_shaped).to_contain("if plan.len() == 0:")
        expect(draw_shaped.contains("var plan: [text] = []")).to_be(false)
        expect(draw_shaped.contains("val plan = font_execution_plan(config,")).to_be(false)
        expect(engine).to_contain("val ENGINE2D_FONT_EXECUTION_TARGETS: [text]")
        expect(engine).to_contain("_font_plan_scratch: [text] = []")
        val constructor_count = engine.split("Engine2D(").len() - 1
        val scratch_pin_count = engine.split("_font_plan_scratch: [],").len() - 1
        val attempt_scratch_pin_count = engine.split("_font_attempt_scratch: [],").len() - 1
        expect(constructor_count).to_equal(23)
        expect(scratch_pin_count).to_equal(constructor_count)
        expect(attempt_scratch_pin_count).to_equal(constructor_count)
        expect(engine).to_contain("_font_attempt_scratch: [text] = []")
        expect(engine).to_contain("var attempts = self._font_attempt_scratch\n        attempts.clear()")
        expect(engine.contains("var attempts: [text] = []")).to_be(false)
        expect(engine).to_contain("self._font_attempt_scratch = attempts")
        expect(engine).to_contain("self.last_font_execution_attempts = attempts")
        expect(engine.contains("var attempt_snapshot: [text] = []")).to_be(false)
        expect(engine.split("evidence.clear_fallback_pixels()").len()).to_equal(3)
        expect(engine.contains("if val Some(retained) = self.last_vulkan_font_evidence:")).to_be(false)
        expect(engine).to_contain("fn font_execution_attempts() -> [text]:\n        var snapshot: [text] = []")
        expect(engine).to_contain("for attempt in self.last_font_execution_attempts:")
        expect(engine).to_contain("snapshot.push(attempt)")
        expect(engine.contains("var atlas: [u32] = []")).to_be(false)
        expect(font_types).to_contain("plan_out.clear()")
        expect(font_types.contains("var order: [text] = []")).to_be(false)
        expect(engine).to_contain("me font_receipt_plan_admitted() -> bool:")
        expect(engine).to_contain("me draw_text_points_dpi(")
        expect(engine).to_contain("me font_receipt_size_100px() -> bool:")
        expect(engine).to_contain("last_font_size_is_100: bool = false")
        expect(engine.index_of("last_font_size_pixels") ?? -1).to_equal(-1)
        expect(engine).to_contain("val config = FontRenderConfig(")
        expect(renderer).to_contain("me reset_cache_stats_receipt() -> bool:")
        expect(engine).to_contain("val reset_ok = fonts.reset_cache_stats_receipt()")
        expect(draw_text).to_contain("var fonts: FontRenderer = self.font_owner.active[0]")
        expect(draw_text).to_contain("self.font_owner.active[0] = fonts")
        expect(engine).to_contain("me font_receipt_cache_rasterizations_zero() -> bool:")
        expect(engine).to_contain("me font_receipt_execution_target_cpu() -> bool:")
        expect(renderer).to_contain("me receipt_cache_rasterizations_positive() -> bool:")
        expect(renderer).to_contain("me receipt_cache_hits_zero() -> bool:")
        expect(renderer).to_contain("me receipt_staged_quads_nonempty() -> bool:")
        expect(renderer).to_contain("me receipt_staged_atlas_has_alpha() -> bool:")
        expect(renderer).to_contain("self.atlas_codepoints = self.atlas_codepoints.push(glyph.codepoint)")
        expect(renderer).to_contain("layout = layout.push(LayoutGlyph(")
        expect(renderer).to_contain("fallback_cps = fallback_cps.push(codepoint)")
        expect(renderer).to_contain("quads = quads.push(quad)")
        expect(renderer).to_contain("entries = entries.push(configured)")
        expect(renderer).to_contain("quad_phase_local_nonempty: bool = false")
        expect(renderer).to_contain("self.quad_phase_inbound_nonempty = batch.quads.len() > 0")
        expect(renderer).to_contain("self.quad_phase_stored_nonempty = self.staged_quads.len() > 0")
        expect(engine).to_contain("me font_receipt_quad_phase_local_nonempty(token: bool) -> bool:")
        expect(renderer).to_contain("me receipt_quad_phase_local_nonempty(token: bool) -> bool:")
        expect(probe).to_contain("engine.font_receipt_quad_phase_local_nonempty(true)")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-local-quads")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-inbound-quads")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-stored-quads")
        expect(renderer).to_contain("self.text_phase_layout_nonempty = layout.len() > 0")
        expect(renderer).to_contain("self.text_phase_glyph_positive = true")
        expect(renderer).to_contain("self.text_phase_atlas_index_valid = true")
        expect(renderer).to_contain("self.text_phase_quad_appended = true")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-text-layout")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-text-glyph")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-text-atlas-index")
        expect(probe).to_contain("engine2d_font_state_native_status=fail-text-quad-append")
        expect(rasterizer).to_contain("pixels = pixels.push(alpha.to_i32().to_u8())")
        expect(spl_fonts).to_contain("args = args.push(codepoint)")
        expect(spl_fonts).to_contain("glyphs = glyphs.push(LayoutGlyph(")
        expect(renderer).to_contain("identities = identities.push(identity)")
        expect(advances).to_contain("byte_offsets = byte_offsets.push(byte_offset)")
        expect(advances).to_contain("shifted_xs = shifted_xs.push(shifted_x.to_i32())")
        expect(probe).to_contain("Bungee-Regular.ttf")
        expect(probe).to_contain("val font_points: i32 = 24")
        expect(probe).to_contain("val font_dpi: i32 = 300")
        expect(probe).to_contain("(font_points * font_dpi + 36) / 72")
        expect(probe).to_contain("if font_size_24pt_300dpi != 100:")
        expect(probe).to_contain("engine.draw_text_points_dpi(")
        expect(probe).to_contain("if not engine.font_receipt_size_100px():")
        expect(probe).to_contain("if not engine.font_receipt_staged_quads_nonempty():")
        expect(probe).to_contain("if not engine.font_receipt_staged_atlas_has_alpha():")
        expect(probe).to_contain("if not engine.font_receipt_cache_rasterizations_zero():")
        expect(probe).to_contain("if not engine.font_receipt_cache_hits_positive():")
        expect(probe).to_contain("if not engine.font_receipt_execution_target_cpu():")
        expect(probe.index_of("engine.fonts()") ?? -1).to_equal(-1)
        expect(probe.index_of("font_cache_stats()") ?? -1).to_equal(-1)
