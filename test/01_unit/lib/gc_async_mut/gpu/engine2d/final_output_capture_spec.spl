# @tag: unit, engine2d, vulkan, final_output
# @req REQ-2D-003 NFR-2D-004

use std.spec.*
use common.ui.draw_ir.{DRAW_IR_BACKEND_GPU, DRAW_IR_SCHEMA_VERSION,
    DRAW_IR_SCHEMA_VERSION_V4}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    Engine2dDrawIrAdvResult, Engine2dDrawIrAdvSubmitResult}
use std.gc_async_mut.gpu.engine2d.final_output_capture.{
    engine2d_strict_vulkan_final_capture,
    engine2d_strict_vulkan_capture_completed_submission}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use common.ui.draw_ir.{draw_ir_composition}

fn completed_result() -> Engine2dDrawIrAdvResult:
    Engine2dDrawIrAdvResult(
        schema: DRAW_IR_SCHEMA_VERSION, unit_id: "controlled-frame",
        selected_backend: DRAW_IR_BACKEND_GPU, fallback_required: false,
        fallback_reason: "", rendered_command_count: 2,
        skipped_command_count: 0,
        pixels: [0xff010203u32, 0xff040506u32],
        readback_source: "device_readback", backend_handle: 7,
        device_identity: 8, readback_checksum: 2114258700,
        device_submit_count: 1, device_fence_count: 1,
        submission_generation: 4, frame_width: 2, frame_height: 1)

fn capture_reason(result: Engine2dDrawIrAdvResult) -> text:
    match engine2d_strict_vulkan_final_capture(result,
        "controlled-opaque-rect-v1",
        "90fc023c54e082fff358647440e8213d45185a6d949d81b6d848c553839484b3",
        "frame-1"):
        Ok(_): "unexpected-success"
        Err(reason): reason

describe "Engine2D strict Vulkan final-output adapter":
    it "decodes a linked ARGB readback into its declared RGBA domain":
        # @req REQ-2D-003
        match engine2d_strict_vulkan_final_capture(completed_result(),
            "controlled-opaque-rect-v1",
            "90fc023c54e082fff358647440e8213d45185a6d848c553839484b3",
            "frame-1"):
            Ok(capture):
                expect(capture.metadata.resource_id).to_equal(
                    "engine2d-vulkan-framebuffer-7")
                expect(capture.metadata.submission_token).to_equal("8:4")
                expect(capture.metadata.completion_token).to_equal("8:4")
                expect(capture.metadata.alpha_mode).to_equal("opaque")
                expect(capture.pixel_bytes).to_equal(
                    [1, 2, 3, 255, 4, 5, 6, 255])
            Err(_): assert(false)

    it "accepts a completed v4 readback and rejects an unknown schema":
        # @req REQ-2D-003 NFR-2D-004
        var v4 = completed_result()
        v4.schema = DRAW_IR_SCHEMA_VERSION_V4
        match engine2d_strict_vulkan_final_capture(v4,
            "controlled-opaque-rect-v1",
            "90fc023c54e082fff358647440e8213d45185a6d949d81b6d848c553839484b3",
            "frame-v4"):
            Ok(capture):
                expect(capture.metadata.frame_id).to_equal("frame-v4")
                expect(capture.pixel_bytes).to_equal(
                    [1, 2, 3, 255, 4, 5, 6, 255])
            Err(_): assert(false)
        var unknown = completed_result()
        unknown.schema = "simple-draw-ir-v5"
        expect(capture_reason(unknown)).to_contain("receipt incomplete")

    it "retains owner, checksum, and pixel-domain gates for v4":
        # @req REQ-2D-003 NFR-2D-004
        var stale_checksum = completed_result()
        stale_checksum.schema = DRAW_IR_SCHEMA_VERSION_V4
        stale_checksum.readback_checksum = 0
        expect(capture_reason(stale_checksum)).to_contain("checksum mismatch")
        var unlinked = completed_result()
        unlinked.schema = DRAW_IR_SCHEMA_VERSION_V4
        unlinked.device_identity = 0
        expect(capture_reason(unlinked)).to_contain("receipt incomplete")
        var translucent = completed_result()
        translucent.schema = DRAW_IR_SCHEMA_VERSION_V4
        translucent.pixels = [0x80010203u32, 0xff040506u32]
        expect(capture_reason(translucent)).to_contain("contains transparency")

    it "rejects a stale checksum or non-device provenance":
        # @req REQ-2D-003 NFR-2D-004
        var altered = completed_result()
        altered.pixels = [0xff010203u32, 0xff040507u32]
        expect(capture_reason(altered)).to_contain("checksum mismatch")
        var mirror = completed_result()
        mirror.readback_source = "cpu_mirror"
        expect(capture_reason(mirror)).to_contain("receipt incomplete")
        var unlinked = completed_result()
        unlinked.submission_generation = 0
        expect(capture_reason(unlinked)).to_contain("receipt incomplete")

    it "uses backend-owned extent and refuses a nonopaque pixel":
        # @req REQ-2D-003 NFR-2D-004
        var no_extent = completed_result()
        no_extent.frame_width = 0
        expect(capture_reason(no_extent)).to_contain("extent invalid")
        var translucent = completed_result()
        translucent.pixels = [0x80010203u32, 0xff040506u32]
        expect(capture_reason(translucent)).to_contain("contains transparency")

    it "rejects a CPU owner even with a fabricated successful device receipt":
        # @req REQ-2D-003 NFR-2D-004
        var owner = Engine2D.create_with_backend(2, 1, "cpu")
        val fake = Engine2dDrawIrAdvSubmitResult(
            engine: owner,
            composition: draw_ir_composition("cpu-fake", "scene", DRAW_IR_BACKEND_GPU, []),
            selected_backend: "vulkan", fallback_required: false,
            fallback_reason: "none", rendered_command_count: 1,
            skipped_command_count: 0, backend_handle: 7,
            device_identity: 1, device_submit_count: 1,
            device_fence_count: 1, completion_known: true,
            no_readback: true, readback_bytes: 0,
            font_evidence_valid: true, submission_generation: 1)
        match engine2d_strict_vulkan_capture_completed_submission(
            fake, "fixture", "digest", "frame"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("owner receipt incomplete")
        owner.shutdown()

    it "rejects a stale submission generation on a live Vulkan owner":
        # @req REQ-2D-003 NFR-2D-004
        val created = Engine2D.create_with_backend_strict(2, 1, "vulkan")
        if not created.is_ok():
            fail("blocked: physical Vulkan device required for stale-owner evidence")
        var owner = created.unwrap()
        val fake = Engine2dDrawIrAdvSubmitResult(
            engine: owner,
            composition: draw_ir_composition("stale-fake", "scene", DRAW_IR_BACKEND_GPU, []),
            selected_backend: "vulkan", fallback_required: false,
            fallback_reason: "none", rendered_command_count: 1,
            skipped_command_count: 0, backend_handle: 7,
            device_identity: 1, device_submit_count: 1,
            device_fence_count: 1, completion_known: true,
            no_readback: true, readback_bytes: 0,
            font_evidence_valid: true, submission_generation: 42)
        match engine2d_strict_vulkan_capture_completed_submission(
            fake, "fixture", "digest", "frame"):
            Ok(_): assert(false)
            Err(reason): expect(reason).to_contain("submission generation stale")
        owner.shutdown()
