# Device-free lifecycle regression. Not executed: user verification waiver.
use std.spec.{describe, it, expect}
use std.spec.step
use std.gc_async_mut.gpu.engine2d.backend_vulkan_session.{VulkanSessionBackend}

describe "Vulkan session adapter initialization ownership":
    it "preserves the live session when initialization is requested again":
        step("Represent an already initialized adapter without creating a device")
        var backend = VulkanSessionBackend.create("default")
        backend.initialized = true
        backend.handle = 37
        backend.device_name = "existing-device"
        backend.shader_mode = "spirv_precompiled"
        backend.clear_count = 2
        backend.rect_count = 3
        backend.readback_count = 1
        step("Repeat initialization and retain the existing owner state")
        expect(backend.init_device()).to_equal("")
        expect(backend.handle).to_equal(37)
        expect(backend.initialized).to_equal(true)
        expect(backend.device_name).to_equal("existing-device")
        expect(backend.shader_mode).to_equal("spirv_precompiled")
        expect(backend.clear_count).to_equal(2)
        expect(backend.rect_count).to_equal(3)
        expect(backend.readback_count).to_equal(1)
        # No cleanup: the sentinel models ownership, it is not a provider handle.
