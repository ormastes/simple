use std.spec.{describe, it, expect}
use common.ui.draw_ir.{
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_rect
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    engine2d_draw_ir_adv_composition_window_present_with_images
}

fn window_present_fixture():
    val embedding = draw_ir_embedding_config(
        "gui", "root", 0, 0, 2, 2, 0, 1000, true)
    draw_ir_composition(
        "window-present", "gui", "vulkan", [
            draw_ir_batch("root", "vulkan", embedding, [
                draw_ir_rect("background", 0, 0, 2, 2, 0xFF2563EBu32)
            ])
        ])

describe "Engine2D retained Vulkan window presentation":
    it "does not invent a Vulkan receipt for a software engine":
        var engine = Engine2D.create_with_backend(2, 2, "software")
        expect(engine.present_window_device()).to_equal(false)
        expect(engine.latest_vulkan_frame_receipt()).to_be_nil()
        engine.shutdown()

    it "renders DrawIR but fails closed when no window swapchain is owned":
        var engine = Engine2D.create_with_backend(2, 2, "software")
        val result = engine2d_draw_ir_adv_composition_window_present_with_images(
            engine, window_present_fixture(), [])
        expect(result.rendered_command_count).to_equal(1)
        expect(result.fallback_required).to_equal(true)
        expect(result.fallback_reason).to_equal("vulkan-window-present-failed")
        engine.shutdown()
