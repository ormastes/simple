# @cover src/lib/gc_async_mut/gpu/engine2d/backend_metal_font.spl 60%
# @tag: unit, gpu, metal, vulkan, font, perf
"""
# Metal Font Packed-Batch Parity Spec

## Overview

Proves the Metal font composite carries the same frame-batching optimization
Vulkan received: one packed word buffer per text batch, one dispatch covering
every glyph, and a per-frame contract of exactly one command buffer, one
commit and one completion wait.

## Requirements

**Requirements:** N/A

## Plan

**Plan:** doc/03_plan/ui/gpu_scheduler_hardening_gpu_resident_rendering.md

## Design

**Design:** doc/05_design/gpu_scheduler_hardening_gpu_resident_rendering.md

## Research

**Research:** doc/01_research/local/metal_2d_frame_cost_perf.md

## Syntax

The packed packer and the frame contract are pure functions, so this spec runs
without a Metal device. Device execution remains a separate hardware gate.

## Examples

```simple
val packed = metal_font_packed_params(batch, 0, 0, 64, 32)
expect(packed.len()).to_equal(15)
```

## Acceptance

The Metal packed word layout matches the Vulkan packed word layout produced by
`vulkan_font_packed_params` for the same batch, and the Metal frame contract
accepts only a one-command, one-commit, one-wait frame.
"""

use std.spec.*
use std.gpu.engine2d.backend_metal_font.{
    METAL_FONT_FRAME_GLYPH_CAP,
    METAL_FONT_PACKED_GLYPH_WORDS,
    METAL_FONT_PACKED_HEADER_WORDS,
    metal_font_dispatch_groups,
    metal_font_frame_batch_contract,
    metal_font_packed_params
}
use std.gc_async_mut.gpu.engine2d.backend_vulkan_font.{
    VULKAN_FONT_FRAME_GLYPH_CAP,
    VULKAN_FONT_PACKED_GLYPH_WORDS,
    VULKAN_FONT_PACKED_HEADER_WORDS,
    vulkan_font_dispatch_groups,
    vulkan_font_packed_params
}
use std.gc_async_mut.text_layout.font_renderer.{FontRenderBatch, FontRenderQuad}

fn two_glyph_batch() -> FontRenderBatch:
    var atlas: [u32] = [0u32; 64]
    var i = 0
    while i < 64:
        atlas[i] = 0xFF204060u32
        i = i + 1
    FontRenderBatch(
        valid: true,
        program_version: 1,
        atlas_width: 8,
        atlas_height: 8,
        atlas_generation: 3,
        atlas_pixels: atlas,
        quads: [
            FontRenderQuad(atlas_x: 0, atlas_y: 0, width: 3, height: 2, dst_x: 1, dst_y: 1, color: 0xFFFF0000u32),
            FontRenderQuad(atlas_x: 4, atlas_y: 4, width: 2, height: 4, dst_x: 5, dst_y: 2, color: 0xFF00FF00u32)
        ]
    )

describe "Metal font packed-batch parity with Vulkan":

    it "packs the same word layout Vulkan packs":
        # @req REQ-SSPEC-UNIT
        step("Pack one two-glyph batch through both backends")
        val batch = two_glyph_batch()
        val metal_words = metal_font_packed_params(batch, 0, 0, 16, 12)
        val vulkan_bytes = vulkan_font_packed_params(batch, 0, 0, 16, 12)

        step("Both packers agree on size and on every word")
        expect(metal_words.len()).to_equal(22)
        expect(vulkan_bytes.len()).to_equal(88)
        var index = 0
        var mismatches = 0
        while index < metal_words.len():
            val base = index * 4
            val rebuilt = (vulkan_bytes[base].to_i64()) |
                (vulkan_bytes[base + 1].to_i64() << 8) |
                (vulkan_bytes[base + 2].to_i64() << 16) |
                (vulkan_bytes[base + 3].to_i64() << 24)
            if rebuilt != metal_words[index].to_i64():
                mismatches = mismatches + 1
            index = index + 1
        expect(mismatches).to_equal(0)

    it "shares Vulkan's header shape, glyph cap and dispatch geometry":
        # @req REQ-SSPEC-UNIT
        step("Compare the frozen packing constants")
        expect(METAL_FONT_PACKED_HEADER_WORDS).to_equal(VULKAN_FONT_PACKED_HEADER_WORDS)
        expect(METAL_FONT_PACKED_GLYPH_WORDS).to_equal(VULKAN_FONT_PACKED_GLYPH_WORDS)
        expect(METAL_FONT_FRAME_GLYPH_CAP).to_equal(VULKAN_FONT_FRAME_GLYPH_CAP)
        step("Compare the dispatch group arithmetic")
        expect(metal_font_dispatch_groups(0)).to_equal(vulkan_font_dispatch_groups(0))
        expect(metal_font_dispatch_groups(1)).to_equal(vulkan_font_dispatch_groups(1))
        expect(metal_font_dispatch_groups(64)).to_equal(vulkan_font_dispatch_groups(64))
        expect(metal_font_dispatch_groups(65)).to_equal(vulkan_font_dispatch_groups(65))

    it "records the widest glyph so one dispatch covers every glyph":
        # @req REQ-SSPEC-UNIT
        step("Pack a batch whose glyphs differ in pixel count")
        val packed = metal_font_packed_params(two_glyph_batch(), 0, 0, 16, 12)
        step("Header word 6 counts glyphs and word 7 bounds the dispatch width")
        expect(packed[6].to_i64()).to_equal(2)
        expect(packed[7].to_i64()).to_equal(8)
        expect(metal_font_dispatch_groups(packed[7].to_i64())).to_equal(1)

    it "accepts only a one-command, one-commit, one-wait frame":
        # @req REQ-SSPEC-UNIT
        step("A frame that drew text must have submitted exactly once")
        expect(metal_font_frame_batch_contract(30, 1, 1, 1)).to_be(true)
        step("Per-quad or per-batch submission is rejected")
        expect(metal_font_frame_batch_contract(30, 30, 30, 30)).to_be(false)
        expect(metal_font_frame_batch_contract(30, 1, 1, 0)).to_be(false)
        expect(metal_font_frame_batch_contract(30, 2, 1, 1)).to_be(false)
        step("A frame with no text makes no claim at all")
        expect(metal_font_frame_batch_contract(0, 1, 1, 1)).to_be(false)

    it "rejects a batch that would overflow the frame glyph cap":
        # @req REQ-SSPEC-UNIT
        step("Pack a batch one glyph past the cap")
        var quads: [FontRenderQuad] = []
        var i: i64 = 0
        while i < METAL_FONT_FRAME_GLYPH_CAP + 1:
            quads.push(FontRenderQuad(atlas_x: 0, atlas_y: 0, width: 1, height: 1, dst_x: 0, dst_y: 0, color: 0xFFFFFFFFu32))
            i = i + 1
        val oversized = FontRenderBatch(valid: true, program_version: 1, atlas_width: 8, atlas_height: 8,
            atlas_generation: 1, atlas_pixels: [0xFFFFFFFFu32; 64], quads: quads)
        expect(metal_font_packed_params(oversized, 0, 0, 16, 12).len()).to_equal(0)
