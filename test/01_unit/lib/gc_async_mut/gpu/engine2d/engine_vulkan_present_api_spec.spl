use std.spec.{describe, it, expect}

extern fn rt_fs_read_text(path: text) -> text?

# Regression: 8a87db7d9eb deleted Engine2D Vulkan present/readback methods
# that compositor_engine2d, hosted_entry, draw_ir_adv and the wm_compare
# producers still call. Every name below must stay defined on Engine2D.
describe "Engine2D Vulkan present API surface":
    it "defines every Vulkan present/readback method that has live callers":
        val engine = rt_fs_read_text("src/lib/gc_async_mut/gpu/engine2d/engine.spl") ?? ""
        expect(engine).to_contain("static fn create_vulkan_window_present(width: i32, height: i32, vsync: bool = true)")
        expect(engine).to_contain("static fn create_vulkan_external_window_present(kind: i64, display: i64, window: i64,")
        expect(engine).to_contain(" vulkan_present_readback_bytes() -> i64:")
        expect(engine).to_contain(" vulkan_device_finalize_no_readback_count() -> i64:")
        expect(engine).to_contain("me stage_present_damage(rects: [i64]) -> bool:")
        expect(engine).to_contain("me finalize_compute_frame_no_readback() -> bool:")
        expect(engine).to_contain("me present_window_device() -> bool:")
        expect(engine).to_contain(" latest_vulkan_frame_receipt() -> VulkanFrameReceipt?:")
        expect(engine).to_contain(" window_present_enabled() -> bool:")
        expect(engine).to_contain("me read_pixels_damaged(max_rects: i32) -> [u32]:")
        expect(engine).to_contain("me invalidate_damage_mirror():")

    it "keeps the compositor wrappers pointed at the Engine2D constructors":
        val compositor = rt_fs_read_text("src/os/compositor/compositor_engine2d.spl") ?? ""
        expect(compositor).to_contain("Engine2D.create_vulkan_window_present(")
        expect(compositor).to_contain("Engine2D.create_vulkan_external_window_present(")
