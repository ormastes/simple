# @cover src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl 80%
"""Retained DrawIR composition damage replay under the outcome contract.

`engine2d_draw_ir_render_composition_damage_with_images` accepts only an exact
LOCAL plan whose batches can replay directly on the parent surface; every other
input is rejected with `accepted == false` and a machine-readable reason, and
the CALLER owns the canonical full-replay fallback (see
src/os/compositor/compositor_engine2d.spl). Branches proven here:

- valid LOCAL plan + root-origin opaque batch -> accepted local replay with an
  exact clip (outside sentinels preserved)
- empty / NONE plan -> "damage-plan-not-exact-local", no pixel mutation
- overflowing rect coordinates -> "damage-plan-not-exact-local"
- overlapping damage rects -> "damage-plan-not-exact-local"
- translucent embedding -> "damage-batch-requires-full-replay"
- translated (offset) embedding -> "damage-batch-requires-full-replay"
  (producer damage receipts carry no batch identity, so an origin offset
  cannot be replayed; branch added 2026-08 in _engine2d_draw_ir_damage_batch_direct_safe)
"""

use std.spec.{describe, context, it, expect, step}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    engine2d_draw_ir_render_composition_damage_with_images
}
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU,
    draw_ir_batch, draw_ir_composition, draw_ir_embedding_config, draw_ir_rect
}
use common.ui.render_opt.damage_plan.{
    DamageFramePlan, DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL,
    DAMAGE_FALLBACK_NONE
}
use std.gpu.engine2d.color.{rgb}

fn composition_damage_plan(mode: i64, rects: [i64]) -> DamageFramePlan:
    DamageFramePlan(
        rects: rects, mode: mode,
        source_tile_count: rects.len() / 4,
        output_rect_count: rects.len() / 4,
        merged_tile_count: 0,
        dirty_pixels: 0,
        planned_pixels: 0,
        tiles_examined: 0,
        full_fallback_count: 0,
        fallback_reason: DAMAGE_FALLBACK_NONE)

fn damage_test_composition(opacity_milli: i32, color: u32):
    val embedding = draw_ir_embedding_config(
        "root", "root", 0, 0, 8, 8, 0, opacity_milli, false)
    val batch = draw_ir_batch(
        "root", DRAW_IR_BACKEND_CPU, embedding,
        [draw_ir_rect("changed", 0, 0, 8, 8, color)])
    draw_ir_composition("damage", "scene", DRAW_IR_BACKEND_CPU, [batch])

describe "DrawIR composition damage replay":
    context "direct local replay":
        it "replays only the exact local clip and preserves every outside sentinel":
            val background = rgb(7, 11, 13)
            val changed = rgb(210, 70, 30)
            var damaged = Engine2D.create_with_backend(8, 8, "software")
            damaged.clear(background)
            step("Replay a full-scene command through a two-by-two damage clip")
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                damaged, damage_test_composition(1000, changed),
                composition_damage_plan(DAMAGE_PLAN_LOCAL, [2, 3, 2, 2]),
                background, [])
            damaged = outcome.engine
            expect(outcome.accepted).to_equal(true)
            expect(outcome.reason).to_equal("damage-composition-local-replayed")
            expect(outcome.rects_replayed).to_equal(1)
            expect(outcome.ops_skipped).to_equal(0)
            val pixels = damaged.read_pixels()
            var mismatches = 0
            var y = 0
            while y < 8:
                var x = 0
                while x < 8:
                    val expected = if x >= 2 and x < 4 and y >= 3 and y < 5: changed else: background
                    if pixels[y * 8 + x] != expected:
                        mismatches = mismatches + 1
                    x = x + 1
                y = y + 1
            expect(mismatches).to_equal(0)
            damaged.shutdown()

        it "replays two disjoint rects in one plan":
            val background = rgb(3, 4, 5)
            val changed = rgb(90, 140, 20)
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(background)
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, damage_test_composition(1000, changed),
                composition_damage_plan(DAMAGE_PLAN_LOCAL, [0, 0, 2, 2, 6, 6, 2, 2]),
                background, [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(true)
            expect(outcome.rects_replayed).to_equal(2)
            val pixels = engine.read_pixels()
            expect(pixels[0]).to_equal(changed)
            expect(pixels[7 * 8 + 7]).to_equal(changed)
            expect(pixels[3 * 8 + 3]).to_equal(background)
            engine.shutdown()

    context "plan rejection (caller owns full replay)":
        it "rejects a NONE plan without submission or pixel mutation":
            val background = rgb(20, 30, 40)
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(background)
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, damage_test_composition(1000, rgb(200, 0, 0)),
                composition_damage_plan(DAMAGE_PLAN_NONE, []), background, [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(false)
            expect(outcome.reason).to_equal("damage-plan-not-exact-local")
            expect(outcome.ops_rendered).to_equal(0)
            expect(engine.read_pixels()[27]).to_equal(background)
            engine.shutdown()

        it "rejects overflowing local damage coordinates before clip conversion":
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(rgb(1, 2, 3))
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, damage_test_composition(1000, rgb(90, 80, 70)),
                composition_damage_plan(DAMAGE_PLAN_LOCAL,
                    [9223372036854775800, 0, 16, 1]), rgb(1, 2, 3), [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(false)
            expect(outcome.reason).to_equal("damage-plan-not-exact-local")
            engine.shutdown()

        it "rejects overlapping damage rects that would double-replay alpha":
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(rgb(0, 0, 0))
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, damage_test_composition(1000, rgb(10, 20, 30)),
                composition_damage_plan(DAMAGE_PLAN_LOCAL, [0, 0, 3, 3, 2, 2, 3, 3]),
                rgb(0, 0, 0), [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(false)
            expect(outcome.reason).to_equal("damage-plan-not-exact-local")
            engine.shutdown()

    context "batch rejection (requires canonical full replay)":
        it "rejects translucent embeddings":
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(rgb(0, 0, 0))
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, damage_test_composition(500, rgb(200, 80, 20)),
                composition_damage_plan(DAMAGE_PLAN_LOCAL, [2, 3, 2, 2]),
                rgb(0, 0, 0), [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(false)
            expect(outcome.reason).to_equal("damage-batch-requires-full-replay")
            expect(outcome.ops_rendered).to_equal(0)
            engine.shutdown()

        it "rejects translated embeddings whose damage receipts carry no batch identity":
            val changed = rgb(120, 60, 200)
            var engine = Engine2D.create_with_backend(8, 8, "software")
            engine.clear(rgb(0, 0, 0))
            val embedding = draw_ir_embedding_config(
                "root", "root", 2, 1, 6, 6, 0, 1000, false)
            val batch = draw_ir_batch(
                "root", DRAW_IR_BACKEND_CPU, embedding,
                [draw_ir_rect("changed", 0, 0, 4, 4, changed)])
            val composition = draw_ir_composition(
                "damage-offset", "scene", DRAW_IR_BACKEND_CPU, [batch])
            val outcome = engine2d_draw_ir_render_composition_damage_with_images(
                engine, composition,
                composition_damage_plan(DAMAGE_PLAN_LOCAL, [0, 0, 2, 2]),
                rgb(0, 0, 0), [])
            engine = outcome.engine
            expect(outcome.accepted).to_equal(false)
            expect(outcome.reason).to_equal("damage-batch-requires-full-replay")
            expect(outcome.ops_rendered).to_equal(0)
            engine.shutdown()
