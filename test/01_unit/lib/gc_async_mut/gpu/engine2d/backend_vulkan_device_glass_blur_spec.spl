"""
## Purpose and audience
For the Engine2D Vulkan maintainer landing the DEVICE-side backdrop blur and
glass material, the readback half of
`doc/08_tracking/bug/vulkan_glass_seed_host_roundtrip_2026-09-12.md`. Before
this change, painting a blurred backdrop on the Vulkan lane read the ENTIRE
framebuffer back to the host, blurred one rect with an interpreted scalar loop,
and uploaded that rect again -- 900x760 = 684,000 words off the device per
blurred rect per frame, and the second of the two full-surface readbacks the
GPU-boundary audit counts. This file answers the only question that matters
about moving that work onto the device: does the kernel paint EXACTLY the same
pixels the host twin did?

## Operator workflow
`SIMPLE_EXECUTION_MODE=interpreter SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_2D_BACKEND=vulkan \
 SIMPLE_VK_READBACK=native SIMPLE_VK_IMAGE_UPLOAD=u32 SIMPLE_VK_RECT_UPLOAD=u32 \
 <vulkan-capable simple> run \
 test/01_unit/lib/gc_async_mut/gpu/engine2d/backend_vulkan_device_glass_blur_spec.spl`

## Compatibility and limitations
This file REQUIRES a real Vulkan device and says so by FAILING, never skipping:
the first expectation asserts `backend_name() == "vulkan"`. A CPU fallback
would paint correct-looking pixels through the very host path this change
exists to remove, and would therefore prove the opposite of what is claimed.

The oracle is the CPU backend running the SAME public call, not a
reimplementation of the algorithm inside this file. That is deliberate: both
kernels are exact integer twins of `emu_draw_blur_rect` /
`engine2d_draw_ir_glass_material_pixels`, so the only honest oracle is those
functions themselves. A hand-written expectation would drift from them, and the
whole claim is byte-equality, not approximate similarity.

## Verification guidance and troubleshooting
The sabotage that proves this file discriminates is to re-enable the host path:
make `_draw_blur_rect_device` return `false` unconditionally and the pixel
expectations still PASS (they must -- the host twin is the oracle) while
`blur_device_rect_count` drops to 0 and `cpu_fallback_reason` becomes
`glass-device-unavailable`. That pair is what separates "the device did the
work" from "something painted the right pixels".

If pixels differ by exactly one in a channel, suspect the truncation shape: the
blur kernel keeps RAW sums and divides ONCE, while the glass kernel packs each
row average to 8 bits BEFORE the vertical pass. Swapping those two conventions
is the single most likely way to break parity while still looking correct.
"""
# Lifecycle: doc/08_tracking/bug/vulkan_glass_seed_host_roundtrip_2026-09-12.md
# @manual_section: vulkan_device_glass_blur
# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl 4%
# @cover src/lib/gc_async_mut/gpu/engine2d/shaders/blur_rect.comp 90%
# @cover src/lib/gc_async_mut/gpu/engine2d/shaders/glass_material.comp 90%
# @tag: unit, gpu, engine2d, vulkan, glass, perf

use std.spec.*
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.draw_ir_glass_material.{
    Engine2dGlassMaterialConfig, engine2d_draw_ir_glass_material_pixels}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{
    vulkan_readback_count, vulkan_device_blur_rect_count,
    vulkan_device_material_census_reset, vulkan_device_glass_material_count}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_resolved_engine2d_backend}

# The WM Web material fixture's own surface (simple_web_renderer_spec):
# rgba(31,31,33,0.80) projects "wm-material-surface-alpha-milli" 800 and
# "background-color" 0xCC1F1F21, under the layered rgba(255,255,255,0.08) ->
# rgba(255,255,255,0.025) gradient.
fn wm_material_config() -> Engine2dGlassMaterialConfig:
    Engine2dGlassMaterialConfig(
        framebuffer_width: FB_W, framebuffer_height: FB_H,
        x: 20, y: 10, width: 100, height: 80,
        radius: 12, blur_radius: 4, saturation_milli: 1700,
        surface_alpha_milli: 800, surface_color: 0xCC1F1F21u32,
        gradient_from: 0x14FFFFFFu32, gradient_to: 0x06FFFFFFu32,
        gradient_enabled: true, gradient_layered_over_surface: true)

fn glass_region_mismatches(config: Engine2dGlassMaterialConfig, want_region: [u32], after: [u32]) -> i64:
    var wrong: i64 = 0
    var py: i32 = 0
    while py < config.height:
        var px: i32 = 0
        while px < config.width:
            val want = want_region[py.to_i64() * config.width.to_i64() + px.to_i64()]
            val got = after[(config.y + py).to_i64() * FB_W.to_i64()
                + (config.x + px).to_i64()]
            if want != got:
                wrong = wrong + 1
            px = px + 1
        py = py + 1
    wrong

val FB_W: i32 = 160
val FB_H: i32 = 120

fn paint_backdrop(mut e: Engine2D) -> Engine2D:
    """A backdrop with two hard colour edges and one translucent rect.

    Hard edges matter: a blur whose window is off by one pixel, or whose
    out-of-bounds sample count is wrong, changes the colour AT an edge and
    nowhere else, so a flat backdrop would hide exactly the defects this file
    is looking for.
    """
    e.clear(0xFF102030u32)
    e.draw_rect_filled(0, 0, 80, 120, 0xFFC04020u32)
    e.draw_rect_filled(40, 20, 30, 30, 0xFF20FF60u32)
    e.draw_rect_filled(100, 60, 55, 55, 0x8000FFFFu32)
    e

fn glass_config() -> Engine2dGlassMaterialConfig:
    Engine2dGlassMaterialConfig(
        framebuffer_width: FB_W, framebuffer_height: FB_H,
        x: 20, y: 10, width: 100, height: 80,
        radius: 12, blur_radius: 4, saturation_milli: 1400,
        surface_alpha_milli: 300, surface_color: 0xFFFFFFFFu32,
        gradient_from: 0x40FFFFFFu32, gradient_to: 0x10202020u32,
        gradient_enabled: true, gradient_layered_over_surface: true)

fn mismatch_count(want: [u32], got: [u32]) -> i64:
    if want.len() != got.len():
        return -1
    var wrong: i64 = 0
    var i: i64 = 0
    while i < want.len():
        if want[i] != got[i]:
            wrong = wrong + 1
        i = i + 1
    wrong

describe "The Vulkan backdrop blur and glass material run on the device, pixel-for-pixel":

    it "runs on a real Vulkan device, and fails rather than skipping when it cannot":
        # PRECONDITION. Every claim below is about DEVICE pixels; a CPU
        # fallback would exercise the host round trip this change removes.
        val e = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        val name = e.backend_name()
        e.shutdown()
        expect(name).to_equal("vulkan")

    it "blurs a rect on the device byte-identically to the CPU backend":
        # The core parity claim. Both engines run the SAME public call on the
        # SAME backdrop; the CPU one is the frozen oracle.
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        dev.draw_blur_rect(20, 10, 100, 80, 4)
        val got = dev.read_pixels()
        dev.shutdown()

        var cpu = Engine2D.create_with_backend_fast(FB_W, FB_H, "cpu_simd")
        cpu = paint_backdrop(cpu)
        cpu.draw_blur_rect(20, 10, 100, 80, 4)
        val want = cpu.read_pixels()
        cpu.shutdown()

        expect(mismatch_count(want, got)).to_equal(0)

    it "leaves every pixel outside the blurred rect untouched":
        # A kernel that wrote outside its rect would still match the oracle
        # inside it, so this is a separate claim, not a restatement.
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        val before = dev.read_pixels()
        dev.draw_blur_rect(20, 10, 100, 80, 4)
        val after = dev.read_pixels()
        dev.shutdown()
        var changed_outside: i64 = 0
        var py: i32 = 0
        while py < FB_H:
            var px: i32 = 0
            while px < FB_W:
                val inside = px >= 20 and px < 120 and py >= 10 and py < 90
                val idx = py.to_i64() * FB_W.to_i64() + px.to_i64()
                if not inside and before[idx] != after[idx]:
                    changed_outside = changed_outside + 1
                px = px + 1
            py = py + 1
        expect(changed_outside).to_equal(0)

    it "counts the blur as device work and records no CPU fallback":
        # Pixels alone cannot tell the two lanes apart -- that is the whole
        # point of the parity above. This is the counter that can.
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        vulkan_device_material_census_reset()
        dev.draw_blur_rect(20, 10, 100, 80, 4)
        val painted_on_device = vulkan_device_blur_rect_count()
        val fallback = dev.vulkan_cpu_fallback_reason()
        dev.shutdown()
        expect(painted_on_device).to_equal(1)
        expect(fallback).to_equal("")

    it "declines a degenerate blur exactly as the host twin does":
        # A zero radius is a no-op for the CPU reference; the device path must
        # not paint one either, or the two lanes disagree on an edge case.
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        val before = dev.read_pixels()
        vulkan_device_material_census_reset()
        dev.draw_blur_rect(20, 10, 100, 80, 0)
        val after = dev.read_pixels()
        val painted_on_device = vulkan_device_blur_rect_count()
        dev.shutdown()
        expect(mismatch_count(before, after)).to_equal(0)
        expect(painted_on_device).to_equal(0)

    it "applies the glass material on the device byte-identically to its CPU twin":
        # Same parity claim for the richer kernel: box blur, saturation,
        # rounded corners, surface tint and a vertical gradient, all integer.
        val config = glass_config()
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        val want_region = engine2d_draw_ir_glass_material_pixels(
            dev.read_pixels(), config)
        val outcome = dev.draw_ir_apply_glass_material(config)
        val after = dev.read_pixels()
        dev.shutdown()

        expect(outcome.applied).to_equal(true)
        expect(outcome.execution_target).to_equal("vulkan-device-glass-v1")

        var wrong: i64 = 0
        var py: i32 = 0
        while py < config.height:
            var px: i32 = 0
            while px < config.width:
                val want = want_region[py.to_i64() * config.width.to_i64() + px.to_i64()]
                val got = after[(config.y + py).to_i64() * FB_W.to_i64()
                    + (config.x + px).to_i64()]
                if want != got:
                    wrong = wrong + 1
                px = px + 1
            py = py + 1
        expect(wrong).to_equal(0)

    it "reads the framebuffer zero times while painting the glass material":
        # The invariant the GPU-boundary audit enforces, asserted here at the
        # backend rather than through a whole page render: the glass pass must
        # not move the surface across the PCIe boundary at all.
        val config = glass_config()
        var dev = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        dev = paint_backdrop(dev)
        val before = vulkan_readback_count()
        val outcome = dev.draw_ir_apply_glass_material(config)
        val after = vulkan_readback_count()
        dev.shutdown()
        expect(outcome.applied).to_equal(true)
        expect(after - before).to_equal(0)

    it "paints the WM material's 800 per-mille surface as 80 % opacity on the device, over opaque and half-alpha backdrops":
        # The Metal kernel (backend_metal_msl.spl kernel_glass_material) and
        # this Vulkan kernel both tint with alpha 255 * milli / 1000 and blend
        # straight-alpha src-over, then COPY the result in place (Metal writes
        # framebuffer[...] directly; Vulkan copies back with
        # VK_IMAGE_COMPOSITE_COPY). So the CPU twin is the oracle for both,
        # and a translucent backdrop must not change that.
        val config = wm_material_config()
        var opaque = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        opaque = paint_backdrop(opaque)
        val opaque_want = engine2d_draw_ir_glass_material_pixels(
            opaque.read_pixels(), config)
        val opaque_outcome = opaque.draw_ir_apply_glass_material(config)
        val opaque_after = opaque.read_pixels()
        opaque.shutdown()

        var half = Engine2D.create_with_backend_fast(FB_W, FB_H, "vulkan")
        half.clear(0x80336699u32)
        half.draw_rect_filled(0, 0, 80, 120, 0x80C04020u32)
        val half_want = engine2d_draw_ir_glass_material_pixels(
            half.read_pixels(), config)
        val half_outcome = half.draw_ir_apply_glass_material(config)
        val half_after = half.read_pixels()
        half.shutdown()

        expect(opaque_outcome.execution_target).to_equal("vulkan-device-glass-v1")
        expect(half_outcome.execution_target).to_equal("vulkan-device-glass-v1")
        expect(glass_region_mismatches(config, opaque_want, opaque_after)).to_equal(0)
        expect(glass_region_mismatches(config, half_want, half_after)).to_equal(0)

    it "renders the WM Web material page on the device with the surface at 80 % opacity, as cpu_simd does":
        # End to end: HTML -> Draw IR ("wm-material-surface-alpha-milli" 800)
        # -> Engine2D on the Vulkan device. The card covers (0,0)..(11,7) on
        # a white canvas; rgb(31,31,33) at alpha 204 over white is
        # (75,75,77). Read as transparency (alpha 51) it would be (210,210,211).
        val html = "<html><body style='margin:0;background:#ffffff'><section id='card' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' style='display:block;width:12px;height:8px;background:rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)'></section></body></html>"
        vulkan_device_material_census_reset()
        val device = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(html, 32, 20, "vulkan")
        val device_glass = vulkan_device_glass_material_count()
        val cpu = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(html, 32, 20, "cpu_simd")
        expect(device_glass).to_equal(1)
        expect(device[2 * 32 + 2]).to_equal(0xFF4B4B4Du32)
        expect(mismatch_count(cpu, device)).to_equal(0)

    it "renders the legacy widget frame and offset text through Draw IR on the device, as cpu_simd does":
        # Legacy widget chrome (widget-panel, no <style>) lowers its frame
        # rects and its sparse offset text to Draw IR rect commands, so the
        # Vulkan device paints them exactly as cpu_simd. Page A takes the
        # generated chrome text, page B the x+8 / y+7 offset text.
        val chrome_page = "<html><body><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        val offset_page = "<html><body><div>Menu</div><section class='widget-panel'></section></body></html>"
        val readbacks_before = vulkan_readback_count()
        val device_a = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(chrome_page, 40, 64, "vulkan")
        val device_b = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(offset_page, 40, 64, "vulkan")
        val readbacks_after = vulkan_readback_count()
        val cpu_a = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(chrome_page, 40, 64, "cpu_simd")
        val cpu_b = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(offset_page, 40, 64, "cpu_simd")
        # Both frames were read back from the device, not a CPU fallback.
        expect(readbacks_after - readbacks_before >= 2).to_equal(true)
        # Frame: focus border, image swatch and chips, button frame / face / icon,
        # and the bottom-corner page-base patch.
        expect(device_a[0]).to_equal(0xFF0066CCu32)
        expect(device_a[63 * 40 + 39]).to_equal(0xFF0066CCu32)
        expect(device_a[34 * 40 + 6]).to_equal(0xFF2563EBu32)
        expect(device_a[38 * 40 + 10]).to_equal(0xFFF59E0Bu32)
        expect(device_a[39 * 40 + 20]).to_equal(0xFF22C55Eu32)
        expect(device_a[50 * 40 + 5]).to_equal(0xFF64748Bu32)
        expect(device_a[52 * 40 + 7]).to_equal(0xFFCBD5E1u32)
        expect(device_a[57 * 40 + 12]).to_equal(0xFF2563EBu32)
        expect(device_a[63 * 40 + 2]).to_equal(0xFFF5F5F5u32)
        expect(device_b[0]).to_equal(0xFF0066CCu32)
        expect(mismatch_count(cpu_a, device_a)).to_equal(0)
        expect(mismatch_count(cpu_b, device_b)).to_equal(0)
        # The offset text really paints on the device: page B differs from
        # the same page without its text.
        val bare_page = "<html><body><div></div><section class='widget-panel'></section></body></html>"
        val device_bare = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(bare_page, 40, 64, "vulkan")
        expect(mismatch_count(device_bare, device_b) > 0).to_equal(true)

    it "suppresses the widget-mode page background, widget-node box paint and image placeholder on the device, as cpu_simd does":
        # Legacy widget mode paints the page base, not the body / widget-node
        # background, frame or widget-image placeholder: Draw IR now carries
        # no paint for them, so the Vulkan device matches cpu_simd and the
        # raster at the same pixels.
        val body_page = "<html><body style='background-color:#ff0000'><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        val frame_page = "<html><body><section class='widget-panel' style='background-color:#00ff00;border:2px solid #0000ff;box-shadow:2px 2px 0 #ff0000;outline:2px solid #00ff00'></section></body></html>"
        val img_page = "<html><body><section class='widget-panel'><img class='widget-image' style='width:20px;height:12px'></section></body></html>"
        val readbacks_before = vulkan_readback_count()
        val device_body = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(body_page, 40, 64, "vulkan")
        val device_frame = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(frame_page, 40, 64, "vulkan")
        val device_img = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(img_page, 40, 64, "vulkan")
        val readbacks_after = vulkan_readback_count()
        val cpu_body = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(body_page, 40, 64, "cpu_simd")
        val cpu_frame = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(frame_page, 40, 64, "cpu_simd")
        val cpu_img = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(img_page, 40, 64, "cpu_simd")
        expect(readbacks_after - readbacks_before >= 3).to_equal(true)
        expect(device_body[8 * 40 + 11]).to_equal(0xFFF5F5F5u32)
        expect(device_frame[10 * 40 + 10]).to_equal(0xFFF5F5F5u32)
        expect(device_img[11 * 40 + 8]).to_equal(0xFFF5F5F5u32)
        expect(device_body[0]).to_equal(0xFF0066CCu32)
        expect(mismatch_count(cpu_body, device_body)).to_equal(0)
        expect(mismatch_count(cpu_frame, device_frame)).to_equal(0)
        expect(mismatch_count(cpu_img, device_img)).to_equal(0)

    it "paints no widget-mode inline svg, input text or scrollbar on the device, as cpu_simd does":
        # Legacy widget mode paints the page base where an inline svg, an
        # input value and an overflow-y:scroll scrollbar sit: Draw IR now
        # emits none of them, so the Vulkan device matches cpu_simd and the
        # raster at the same pixels.
        val svg_page = "<html><body><section class='widget-panel'><svg width='20' height='10'><rect width='20' height='10' fill='#ff0000'></rect></svg></section></body></html>"
        val input_page = "<html><body><section class='widget-panel'><input type='text' value='ABCD'></section></body></html>"
        val scroll_page = "<html><body><div style='overflow-y:scroll;height:20px;width:30px'></div><section class='widget-panel'></section></body></html>"
        val readbacks_before = vulkan_readback_count()
        val device_svg = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(svg_page, 40, 64, "vulkan")
        val device_input = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(input_page, 40, 64, "vulkan")
        val device_scroll = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(scroll_page, 40, 64, "vulkan")
        val readbacks_after = vulkan_readback_count()
        val cpu_svg = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(svg_page, 40, 64, "cpu_simd")
        val cpu_input = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(input_page, 40, 64, "cpu_simd")
        val cpu_scroll = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(scroll_page, 40, 64, "cpu_simd")
        expect(readbacks_after - readbacks_before >= 3).to_equal(true)
        expect(device_svg[13 * 40 + 8]).to_equal(0xFFF5F5F5u32)
        expect(device_input[15 * 40 + 13]).to_equal(0xFFF5F5F5u32)
        expect(device_scroll[8 * 40 + 23]).to_equal(0xFFF5F5F5u32)
        expect(mismatch_count(cpu_svg, device_svg)).to_equal(0)
        expect(mismatch_count(cpu_input, device_input)).to_equal(0)
        expect(mismatch_count(cpu_scroll, device_scroll)).to_equal(0)
