# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# @cover src/lib/gc_async_mut/gpu/engine2d/draw_ir_box_effects.spl 39%
# @tag: unit, engine2d, draw-ir, border-radius, box-shadow
#
# Box-effect geometry decisions of the Simple 2D Draw IR executor that had no
# direct spec: the typed four-corner radius schema (all four longhands exactly
# once, each a plain non-negative decimal), the uniform-radius reduction and
# its half-extent clamp, the legacy `border-radius` fallback, the transient
# mask safety bound (16,777,216 pixels, i32 extents) and the typed shadow key
# admission list (24 layers x 6 fields + schema + count).

use std.spec.{describe, context, it, expect}
use std.common.ui.draw_ir.{DrawIrStyleProp}
use std.gc_async_mut.gpu.engine2d.draw_ir_box_effects.{
    Engine2dDrawIrBoxShadowLayer,
    engine2d_draw_ir_typed_corner_radii, engine2d_draw_ir_uniform_corner_radius,
    engine2d_draw_ir_clamp_uniform_radius, engine2d_draw_ir_uniform_corners,
    engine2d_draw_ir_legacy_uniform_radius, engine2d_draw_ir_mask_geometry_safe,
    engine2d_draw_ir_typed_shadow_key_supported, engine2d_draw_ir_has_inset_shadow
}

fn _corners(tl: text, tr: text, br: text, bl: text) -> [DrawIrStyleProp]:
    [
        DrawIrStyleProp(key: "border-top-left-radius", value: tl),
        DrawIrStyleProp(key: "border-top-right-radius", value: tr),
        DrawIrStyleProp(key: "border-bottom-right-radius", value: br),
        DrawIrStyleProp(key: "border-bottom-left-radius", value: bl)
    ]

fn _layer(kind: text) -> Engine2dDrawIrBoxShadowLayer:
    Engine2dDrawIrBoxShadowLayer(kind: kind, offset_x: 0, offset_y: 0,
        blur_radius: 0, spread_radius: 0, color: 0xFF000000)

describe "Draw IR box corner and mask geometry":

    context "typed corner radii":

        it "reads four distinct corners in CSS order":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("4", "8", "12", "16"))
            expect(r.schema_present).to_equal(true)
            expect(r.valid).to_equal(true)
            expect(r.top_left).to_equal(4)
            expect(r.top_right).to_equal(8)
            expect(r.bottom_right).to_equal(12)
            expect(r.bottom_left).to_equal(16)

        it "reports no schema when no corner longhand is present":
            var style: [DrawIrStyleProp] = [DrawIrStyleProp(key: "border-radius", value: "6")]
            val r = engine2d_draw_ir_typed_corner_radii(style)
            expect(r.schema_present).to_equal(false)
            expect(r.valid).to_equal(false)
            expect(r.top_left).to_equal(0)

        it "is invalid when a corner is missing":
            var style: [DrawIrStyleProp] = [
                DrawIrStyleProp(key: "border-top-left-radius", value: "4"),
                DrawIrStyleProp(key: "border-top-right-radius", value: "4"),
                DrawIrStyleProp(key: "border-bottom-right-radius", value: "4")
            ]
            val r = engine2d_draw_ir_typed_corner_radii(style)
            expect(r.schema_present).to_equal(true)
            expect(r.valid).to_equal(false)
            expect(r.top_left).to_equal(0)

        it "is invalid when a corner is repeated":
            var style = _corners("4", "4", "4", "4")
            style.push(DrawIrStyleProp(key: "border-top-left-radius", value: "9"))
            val r = engine2d_draw_ir_typed_corner_radii(style)
            expect(r.schema_present).to_equal(true)
            expect(r.valid).to_equal(false)

        it "rejects a negative radius and zeroes every corner":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("4", "-1", "4", "4"))
            expect(r.valid).to_equal(false)
            expect(r.top_left).to_equal(0)
            expect(r.bottom_left).to_equal(0)

        it "rejects a value with a unit suffix":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("4px", "4", "4", "4"))
            expect(r.valid).to_equal(false)

    context "uniform radius reduction":

        it "returns the shared radius when all four corners agree":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("7", "7", "7", "7"))
            expect(engine2d_draw_ir_uniform_corner_radius(r)).to_equal(7)

        it "returns -1 when corners differ":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("7", "7", "7", "8"))
            expect(engine2d_draw_ir_uniform_corner_radius(r)).to_equal(-1)

        it "returns -1 for an invalid schema":
            val r = engine2d_draw_ir_typed_corner_radii(_corners("x", "7", "7", "7"))
            expect(engine2d_draw_ir_uniform_corner_radius(r)).to_equal(-1)

        it "builds uniform corners and floors a negative radius at zero":
            val r = engine2d_draw_ir_uniform_corners(5)
            expect(r.valid).to_equal(true)
            expect(r.schema_present).to_equal(false)
            expect(r.top_left).to_equal(5)
            expect(r.top_right).to_equal(5)
            expect(r.bottom_right).to_equal(5)
            expect(r.bottom_left).to_equal(5)
            expect(engine2d_draw_ir_uniform_corners(-3).top_left).to_equal(0)

    context "radius clamp":

        it "keeps a radius that fits":
            expect(engine2d_draw_ir_clamp_uniform_radius(10, 100, 60)).to_equal(10)

        it "clamps to half the shorter side":
            expect(engine2d_draw_ir_clamp_uniform_radius(80, 100, 60)).to_equal(30)
            expect(engine2d_draw_ir_clamp_uniform_radius(80, 40, 60)).to_equal(20)

        it "rounds the half extent down for odd sizes":
            expect(engine2d_draw_ir_clamp_uniform_radius(99, 7, 9)).to_equal(3)

        it "returns zero for an empty box":
            expect(engine2d_draw_ir_clamp_uniform_radius(10, 0, 60)).to_equal(0)
            expect(engine2d_draw_ir_clamp_uniform_radius(10, 60, -1)).to_equal(0)

        it "passes the non-uniform sentinel through unchanged":
            expect(engine2d_draw_ir_clamp_uniform_radius(-1, 100, 60)).to_equal(-1)

    context "legacy border-radius":

        it "reads the first integer of the legacy value":
            var style: [DrawIrStyleProp] = [DrawIrStyleProp(key: "border-radius", value: "12px 4px")]
            expect(engine2d_draw_ir_legacy_uniform_radius(style)).to_equal(12)

        it "is zero when absent, non-numeric or negative":
            var none: [DrawIrStyleProp] = []
            expect(engine2d_draw_ir_legacy_uniform_radius(none)).to_equal(0)
            var word: [DrawIrStyleProp] = [DrawIrStyleProp(key: "border-radius", value: "round")]
            expect(engine2d_draw_ir_legacy_uniform_radius(word)).to_equal(0)
            var neg: [DrawIrStyleProp] = [DrawIrStyleProp(key: "border-radius", value: "-6")]
            expect(engine2d_draw_ir_legacy_uniform_radius(neg)).to_equal(0)

    context "transient mask safety":

        it "admits an ordinary box":
            expect(engine2d_draw_ir_mask_geometry_safe(10, 20, 300, 200)).to_equal(true)

        it "admits exactly 16,777,216 pixels and rejects one row more":
            expect(engine2d_draw_ir_mask_geometry_safe(0, 0, 4096, 4096)).to_equal(true)
            expect(engine2d_draw_ir_mask_geometry_safe(0, 0, 4096, 4097)).to_equal(false)

        it "rejects empty and negative extents":
            expect(engine2d_draw_ir_mask_geometry_safe(0, 0, 0, 10)).to_equal(false)
            expect(engine2d_draw_ir_mask_geometry_safe(0, 0, 10, -1)).to_equal(false)

        it "rejects a right edge past the i32 range":
            expect(engine2d_draw_ir_mask_geometry_safe(2147483600, 0, 100, 1)).to_equal(false)
            expect(engine2d_draw_ir_mask_geometry_safe(2147483547, 0, 100, 1)).to_equal(true)

    context "typed shadow keys":

        it "admits the schema, the count and every field of layers 0..23":
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-schema")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-count")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-0-kind")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-5-offset-x")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-5-offset-y")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-11-blur-radius")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-23-spread-radius")).to_equal(true)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-23-color")).to_equal(true)

        it "rejects layer 24, unknown fields and unrelated keys":
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-24-kind")).to_equal(false)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow-layer-0-inset")).to_equal(false)
            expect(engine2d_draw_ir_typed_shadow_key_supported("box-shadow")).to_equal(false)

    context "inset detection":

        it "finds an inset layer anywhere in the list":
            expect(engine2d_draw_ir_has_inset_shadow([_layer("outer"), _layer("inset")])).to_equal(true)

        it "is false for outer-only and empty lists":
            expect(engine2d_draw_ir_has_inset_shadow([_layer("outer"), _layer("outer")])).to_equal(false)
            var none: [Engine2dDrawIrBoxShadowLayer] = []
            expect(engine2d_draw_ir_has_inset_shadow(none)).to_equal(false)
