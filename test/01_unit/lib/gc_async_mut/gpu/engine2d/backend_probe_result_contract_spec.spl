use std.spec.*
use std.io_runtime.{file_read}

describe "Engine2D backend probe result contract":
    it "routes native probe predicates through one owner function":
        val source = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_probe.spl")
        expect(source).to_contain("fn backend_probe_initialized(probe: BackendProbeResult) -> bool:")
        expect(source).to_contain("fn is_usable() -> bool:\n        backend_probe_initialized(self)")
        expect(source).to_contain("fn is_ok() -> bool:\n        backend_probe_initialized(self)")
