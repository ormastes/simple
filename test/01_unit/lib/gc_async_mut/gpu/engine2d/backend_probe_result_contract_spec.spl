use std.spec.*
use std.io_runtime.{file_read}

describe "Engine2D backend probe result contract":
    it "uses the stored availability bit for native probe predicates":
        val source = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_probe.spl")
        expect(source).to_contain("fn is_usable() -> bool:\n        self.available")
        expect(source).to_contain("fn is_ok() -> bool:\n        self.available")
