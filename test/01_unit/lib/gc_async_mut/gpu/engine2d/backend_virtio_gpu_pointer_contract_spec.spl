use std.spec.*
use std.io_runtime.{file_read}

describe "VirtIO-GPU framebuffer pointer contract":
    it "uses the shared runtime array pointer hook":
        val backend = file_read("src/lib/gc_async_mut/gpu/engine2d/backend_virtio_gpu.spl")
        val hooks = file_read("src/lib/gc_async_mut/gpu/engine2d/framebuffer_hooks.spl")
        expect(backend).to_contain("framebuffer_pixels_address(self.buf)")
        expect(backend.contains("self.buf.data()")).to_equal(false)
        expect(hooks).to_contain("rt_array_data_ptr(pixels)")
