# @tag: unit, draw_ir, engine2d, vulkan
"""
# Strict Vulkan affine coverage rectangle

REQ-2D-002: one DrawIR v4 local f64 rectangle is transformed into a device
parallelogram and covered by pixel-square area, with a surface-space clip.
These scenarios require a physical Vulkan device and must fail when absent.
"""

use std.spec
use std.common.ui.draw_ir.{DRAW_IR_BACKEND_GPU,
    DRAW_IR_RASTER_COVERAGE_AA, draw_ir_affine2d, draw_ir_affine_rect,
    draw_ir_batch_v4, draw_ir_composition_v4, draw_ir_embedding_config,
    draw_ir_rect, draw_ir_rect_bounds}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    engine2d_draw_ir_adv_strict_vulkan_primitives_with_images,
    engine2d_draw_ir_adv_strict_vulkan_submit_with_images}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

val AFFINE_BG: u32 = 0xff000000u32
val AFFINE_FG: u32 = 0xffffffffu32

describe "strict Vulkan affine coverage":
    it "paints interior, clipped exterior, and a fractional rotated edge on device":
        # @req REQ-2D-002
        val created = Engine2D.create_with_backend_strict(8, 8, "vulkan")
        if not created.is_ok():
            fail("blocked: strict Vulkan device required for affine coverage pixels")
        var engine = created.unwrap()
        var rotated = draw_ir_affine_rect("diamond", 4.0, 4.0, AFFINE_FG,
            draw_ir_affine2d(0.7071067811865476, 0.7071067811865476,
                -0.7071067811865476, 0.7071067811865476,
                4.0, 1.1715728752538097), DRAW_IR_RASTER_COVERAGE_AA)
        rotated.clip_rect = draw_ir_rect_bounds(3, 1, 4, 6)
        val batch = draw_ir_batch_v4("affine-coverage", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, 8, 8, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, 8, 8, AFFINE_BG), rotated])
        val result = engine2d_draw_ir_adv_strict_vulkan_primitives_with_images(
            engine, draw_ir_composition_v4("affine-coverage", "scene", DRAW_IR_BACKEND_GPU,
                [batch]), [])
        expect(result.fallback_required).to_equal(false)
        expect(result.readback_source).to_equal("device_readback")
        expect(result.device_identity).to_be_greater_than(0)
        expect(result.submission_generation).to_be_greater_than(0)
        expect(result.pixels[4 * 8 + 4]).to_equal(AFFINE_FG)
        expect(result.pixels[4 * 8 + 2]).to_equal(AFFINE_BG)
        val edge = (result.pixels[3 * 8 + 6] >> 16) & 255u32
        expect(edge.to_i64()).to_be_greater_than(0)
        expect(edge.to_i64()).to_be_less_than(255)
        engine.shutdown()

    it "rejects a later singular affine before any strict submission":
        # @req REQ-2D-002
        val created = Engine2D.create_with_backend_strict(8, 8, "vulkan")
        if not created.is_ok():
            fail("blocked: strict Vulkan device required for affine preflight evidence")
        var engine = created.unwrap()
        val valid = draw_ir_affine_rect("valid", 2.0, 2.0, AFFINE_FG,
            draw_ir_affine2d(1.0, 0.0, 0.0, 1.0, 2.0, 2.0),
            DRAW_IR_RASTER_COVERAGE_AA)
        val singular = draw_ir_affine_rect("singular", 2.0, 2.0, AFFINE_FG,
            draw_ir_affine2d(1.0, 1.0, 1.0, 1.0, 2.0, 2.0),
            DRAW_IR_RASTER_COVERAGE_AA)
        val batch = draw_ir_batch_v4("affine-singular", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, 8, 8, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, 8, 8, AFFINE_BG), valid, singular])
        val result = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(
            engine, draw_ir_composition_v4("affine-singular", "scene", DRAW_IR_BACKEND_GPU,
                [batch]), [])
        expect(result.fallback_required).to_equal(true)
        expect(result.fallback_reason).to_equal("strict-vulkan-affine-coverage-required")
        expect(result.rendered_command_count).to_equal(0)
        expect(result.device_submit_count).to_equal(0)
        expect(result.device_fence_count).to_equal(0)
        result.engine.shutdown()

    it "rejects ignored image payload on an affine rect before submission":
        # @req REQ-2D-002
        val created = Engine2D.create_with_backend_strict(8, 8, "vulkan")
        if not created.is_ok():
            fail("blocked: strict Vulkan device required for affine payload preflight")
        var engine = created.unwrap()
        var malformed = draw_ir_affine_rect("malformed", 2.0, 2.0, AFFINE_FG,
            draw_ir_affine2d(1.0, 0.0, 0.0, 1.0, 2.0, 2.0),
            DRAW_IR_RASTER_COVERAGE_AA)
        malformed.image_uri = "asset://ignored-by-coverage-shader"
        val batch = draw_ir_batch_v4("affine-extra-payload", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, 8, 8, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, 8, 8, AFFINE_BG), malformed])
        val result = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(
            engine, draw_ir_composition_v4("affine-extra-payload", "scene",
                DRAW_IR_BACKEND_GPU, [batch]), [])
        expect(result.fallback_required).to_equal(true)
        expect(result.fallback_reason).to_equal("strict-vulkan-affine-plain-rect-required")
        expect(result.rendered_command_count).to_equal(0)
        expect(result.device_submit_count).to_equal(0)
        expect(result.device_fence_count).to_equal(0)
        result.engine.shutdown()
