"""
Source contract for the Engine2D Vulkan order-trace environment boundary.

This deliberately static spec keeps the production module on its GC-async
environment facade without arming a process-global trace flag during a test.
"""

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

fn vulkan_helpers_source() -> text:
    file_read("src/lib/gc_async_mut/gpu/engine2d/backend_vulkan_helpers.spl") ?? ""

describe "Vulkan helpers environment facade source contract":
    it "uses exactly the GC-async facade and preserves disabled tracing semantics":
        val source = vulkan_helpers_source()
        expect(source).to_contain("use std.gc_async_mut.io.env_ops.{env_get}")
        expect(source.contains("use std.nogc_sync_mut.io.env_ops.{env_get}")).to_equal(false)
        expect(source.contains("rt_env_get")).to_equal(false)
        expect(source).to_contain("(env_get(\"SIMPLE_VK_ORDER_TRACE\") ?? \"\") == \"1\"")
        expect(source).to_contain("fn vulkan_order_trace_enabled() -> bool:")
