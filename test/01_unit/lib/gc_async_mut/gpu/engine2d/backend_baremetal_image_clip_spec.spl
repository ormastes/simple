"""Baremetal image clipping and blend parity for the bounded scan path."""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.engine2d.backend_baremetal.{BaremetalBackend}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use std.gpu.engine2d.color.{rgb, rgba, blend}

describe "BaremetalBackend bounded image scan":
    it "clips negative and edge-overflowing images without shifting source pixels":
        val background = rgb(3, 5, 7)
        val fb = FramebufferDriver.from_buffer(4, 3)
        var backend = BaremetalBackend.create(fb)
        backend.clear(background)
        val pixels = [
            rgb(10, 0, 0), rgb(20, 0, 0), rgb(30, 0, 0), rgb(40, 0, 0),
            rgb(50, 0, 0), rgb(60, 0, 0), rgb(70, 0, 0), rgb(80, 0, 0)
        ]
        backend.draw_image(-2, 1, 4, 2, pixels)
        expect(backend.last_image_source_pixels).to_equal(8)
        expect(backend.last_image_examined_pixels).to_equal(4)
        val out = backend.read_pixels()
        expect(out[4]).to_equal(rgb(30, 0, 0))
        expect(out[5]).to_equal(rgb(40, 0, 0))
        expect(out[8]).to_equal(rgb(70, 0, 0))
        expect(out[9]).to_equal(rgb(80, 0, 0))
        expect(out[6]).to_equal(background)

    it "intersects the engine clip once and preserves alpha and mask semantics":
        val background = rgb(20, 30, 40)
        val translucent = rgba(200, 100, 50, 128)
        val opaque = rgb(1, 220, 3)
        val fb = FramebufferDriver.from_buffer(5, 4)
        var backend = BaremetalBackend.create(fb)
        backend.clear(background)
        backend.set_clip(1, 1, 3, 2)
        var mask = [1u8; 20]
        mask[2 * 5 + 2] = 0u8
        backend.set_mask(mask, 5, 4)
        backend.draw_image(0, 0, 5, 4, [translucent; 20])
        backend.draw_image(2, 2, 1, 1, [opaque])
        expect(backend.last_image_source_pixels).to_equal(1)
        expect(backend.last_image_examined_pixels).to_equal(1)
        val out = backend.read_pixels()
        expect(out[1 * 5 + 1]).to_equal(blend(translucent, background))
        expect(out[2 * 5 + 2]).to_equal(background)
        expect(out[0]).to_equal(background)

    it "bulk-blends unmasked pixels and records one rectangular damage region":
        val background = rgb(12, 24, 36)
        val translucent = rgba(220, 80, 20, 128)
        val fb = FramebufferDriver.from_buffer(5, 4)
        var backend = BaremetalBackend.create(fb)
        backend.clear(background)
        backend.fb.clear_dirty()
        backend.draw_image(1, 1, 2, 1, [translucent, rgba(1, 2, 3, 0)])
        val out = backend.read_pixels()
        val damage = backend.fb.dirty_rect()
        expect(out[1 * 5 + 1]).to_equal(blend(translucent, background))
        expect(out[1 * 5 + 2]).to_equal(background)
        expect(damage.valid).to_be(true)
        expect(damage.x1).to_equal(1u32)
        expect(damage.y1).to_equal(1u32)
        expect(damage.x2).to_equal(3u32)
        expect(damage.y2).to_equal(2u32)
