# @tag: unit, draw_ir, engine2d, vulkan
"""
# Strict Vulkan fractional rectangle specification

REQ-2D-002: authoritative f64 rectangle geometry covers a framebuffer pixel
when its center lies inside the half-open rectangle. The device readback is
the oracle; without a Vulkan device these scenarios cannot prove pixels.
"""

use std.spec
use std.common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    draw_ir_batch,
    draw_ir_composition,
    draw_ir_embedding_config,
    draw_ir_fractional_rect,
    draw_ir_rect
}
use std.gc_async_mut.gpu.engine2d.draw_ir_adv.{
    engine2d_draw_ir_adv_strict_vulkan_primitives_with_images,
    engine2d_draw_ir_adv_strict_vulkan_submit_with_images
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

val FRACTIONAL_BG: u32 = 0xff0000ffu32
val FRACTIONAL_FG: u32 = 0xffff0000u32

describe "strict Vulkan fractional rectangles":
    it "covers precisely the pixel centers inside an authoritative f64 rectangle":
        # @req REQ-2D-002
        val created = Engine2D.create_with_backend_strict(6, 4, "vulkan")
        if not created.is_ok():
            fail("blocked: strict Vulkan device required for fractional pixel evidence")
        var engine = created.unwrap()
        val batch = draw_ir_batch(
            "fractional-centers", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, 6, 4, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, 6, 4, FRACTIONAL_BG),
             draw_ir_fractional_rect("fractional", 1.49, 0.49, 2.02, 2.02, FRACTIONAL_FG)])
        val composition = draw_ir_composition(
            "fractional-centers", "scene", DRAW_IR_BACKEND_GPU, [batch])

        val result = engine2d_draw_ir_adv_strict_vulkan_primitives_with_images(
            engine, composition, [])

        expect(result.fallback_required).to_equal(false)
        expect(result.readback_source).to_equal("device_readback")
        expect(result.backend_handle).to_be_greater_than(0)
        expect(result.device_identity).to_be_greater_than(0)
        expect(result.submission_generation).to_be_greater_than(0)
        expect(result.pixels).to_equal([
            FRACTIONAL_BG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_BG, FRACTIONAL_BG,
            FRACTIONAL_BG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_BG, FRACTIONAL_BG,
            FRACTIONAL_BG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_FG, FRACTIONAL_BG, FRACTIONAL_BG,
            FRACTIONAL_BG, FRACTIONAL_BG, FRACTIONAL_BG, FRACTIONAL_BG, FRACTIONAL_BG, FRACTIONAL_BG
        ])
        engine.shutdown()

    it "rejects a later empty fractional rectangle before the whole picture submits":
        # @req REQ-2D-002
        val created = Engine2D.create_with_backend_strict(6, 4, "vulkan")
        if not created.is_ok():
            fail("blocked: strict Vulkan device required for preflight submission evidence")
        var engine = created.unwrap()
        val batch = draw_ir_batch(
            "fractional-empty", DRAW_IR_BACKEND_GPU,
            draw_ir_embedding_config("surface", "scene", 0, 0, 6, 4, 0, 1000, false),
            [draw_ir_rect("clear", 0, 0, 6, 4, FRACTIONAL_BG),
             draw_ir_fractional_rect("valid", 1.49, 0.49, 2.02, 2.02, FRACTIONAL_FG),
             draw_ir_fractional_rect("empty", 0.1, 0.1, 0.2, 0.2, FRACTIONAL_FG)])
        val composition = draw_ir_composition(
            "fractional-empty", "scene", DRAW_IR_BACKEND_GPU, [batch])

        val result = engine2d_draw_ir_adv_strict_vulkan_submit_with_images(
            engine, composition, [])

        expect(result.fallback_required).to_equal(true)
        expect(result.fallback_reason).to_equal(
            "strict-vulkan-fractional-rect-coverage-required")
        expect(result.rendered_command_count).to_equal(0)
        expect(result.device_submit_count).to_equal(0)
        expect(result.device_fence_count).to_equal(0)
        expect(result.submission_generation).to_equal(0)
        result.engine.shutdown()
