describe "RocmBackend read_pixels and present guards (GPU-less)":

    it "read_pixels() on uninitialized backend returns empty array":
        # @req REQ-GPU-ROCM-014
        # @capture(statistics): the pixel count read back before init, retained for review
        step("Read pixels back before init and count them")
        var b = RocmBackend.create()
        val pixels = b.read_pixels()
        expect(pixels.len()).to_equal(0)  # oracle: no framebuffer exists before init, so the readback is empty

    it "present() on uninitialized backend does not crash":
        # @req REQ-GPU-ROCM-014
        # @capture(statistics): the initialized flag after an uninitialized present, retained for review
        step("Present before init and read the backend state")
        var b = RocmBackend.create()
        b.present()
        expect(b.initialized).to_equal(false)  # oracle: an uninitialized present is a safe no-op

    it "width() returns 0 before init":
        # @req REQ-GPU-ROCM-015
        # @capture(statistics): the reported surface width before init, retained for review
        step("Query the surface width before init")
        var b = RocmBackend.create()
        expect(b.width()).to_equal(0)  # oracle: without init there is no surface, so the width is zero

    it "height() returns 0 before init":
        # @req REQ-GPU-ROCM-015
        # @capture(statistics): the reported surface height before init, retained for review
        step("Query the surface height before init")
        var b = RocmBackend.create()
        expect(b.height()).to_equal(0)  # oracle: without init there is no surface, so the height is zero

describe "RocmBackend probe error classification":

    it "probe_rocm feature_gate distinguishes hip-toolchain-missing from rocm-device-unavailable":
        # @req REQ-GPU-ROCM-016
        # @capture(statistics): the feature gate this host's probe classifies into, retained for review
        step("Run the standalone probe and check its gate is a known classification")
        val probe = probe_rocm()
        if probe.status != BackendStatus.Initialized:
            val gate = probe.feature_gate
            val known = (gate == "hip-toolchain-missing" or
                         gate == "rocm-init-failed" or
                         gate == "rocm-device-unavailable" or
                         gate == "rocm-kernel-gap")
            expect(known).to_equal(true)  # oracle: every non-initialized host must land in one of the four documented gates

    it "probe_rocm sets has_compute false when no device":
        # @req REQ-GPU-ROCM-017
        # @capture(statistics): the capability triad reported for a toolchain-less host, retained for review
        step("Run the probe on a toolchain-less host and read the capability triad")
        val probe = probe_rocm()
        if probe.feature_gate == "hip-toolchain-missing":
            expect(probe.has_compute).to_equal(false)  # oracle: without the toolchain nothing can compile, so no compute
            expect(probe.has_graphics).to_equal(false)  # oracle: and no graphics
            expect(probe.has_present).to_equal(false)  # oracle: and no present path

    it "after init() last_probe feature_gate matches probe_rocm on this host":
        # @req REQ-GPU-ROCM-018
        # @capture(statistics): the backend's gate against the standalone probe's gate, retained for review
        step("Fail an init, then compare the backend gate with a standalone probe")
        var b = RocmBackend.create()
        b.init(64, 64)
        val standalone = probe_rocm()
        if standalone.status != BackendStatus.Initialized:
            expect(b.last_probe.feature_gate).to_equal(standalone.feature_gate)  # oracle: init and the standalone probe must classify this host identically

    it "shutdown() after failed init does not crash":
        # @req REQ-GPU-ROCM-019
        # @capture(statistics): the initialized flag after shutdown on a failed init, retained for review
        step("Shut down a backend whose init failed and read the state")
        var b = RocmBackend.create()
        b.init(64, 64)
        b.shutdown()
        expect(b.initialized).to_equal(false)  # oracle: shutdown after a failed init stays safely uninitialized
