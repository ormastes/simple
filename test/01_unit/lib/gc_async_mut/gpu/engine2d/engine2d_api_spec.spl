"""
## Purpose and audience
Purpose: Prove that Engine2D API kind/mode resolution.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/engine2d/engine2d_api.spl 90%
# @tag: unit, gpu, engine2d, api
"""
# Engine2D API Surface Specification

## Overview

Covers every branch of the session-aware Engine2D API surface:
- `resolve_kind` / `resolved_kind_name`: all ten backend-name mappings plus
  the unknown-name Cpu default (round-tripped so both functions' branches run).
- `resolve_mode`: legacy / perf / managed-default policies.
- The three constructors (legacy, managed, caller-owned session).
- The initialized / not-initialized branch of fill, blit, present, read_pixels.

**Requirements:** N/A
"""

use std.spec.*
use std.gc_async_mut.gpu.engine2d.engine2d_api.{
    Engine2DApiSessionKind,
    Engine2DApiSessionMode,
    Engine2D,
    resolve_kind,
    resolve_mode,
    resolved_kind_name
}

use std.spec.step

describe "Engine2D API kind/mode resolution":

    it "round-trips every recognized backend kind name":
        step("Verify: round-trips every recognized backend kind name")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        val names = ["cuda", "hip", "rocm", "opencl", "cpu_simd",
                     "vulkan", "metal", "webgpu", "qualcomm", "cpu"]
        for name in names:
            expect(resolved_kind_name(name)).to_equal(name)

    it "defaults unknown backend names to cpu":
        step("Verify: defaults unknown backend names to cpu")
        expect(resolved_kind_name("")).to_equal("cpu")
        expect(resolved_kind_name("directx")).to_equal("cpu")
        assert_true(resolve_kind("nonsense") == Engine2DApiSessionKind.Cpu)

    it "resolves session policies with managed as default":
        step("Verify: resolves session policies with managed as default")
        assert_true(resolve_mode("legacy") == Engine2DApiSessionMode.LegacyNoSession)
        assert_true(resolve_mode("perf") == Engine2DApiSessionMode.PerfExclusive)
        assert_true(resolve_mode("managed") == Engine2DApiSessionMode.ManagedShared)
        assert_true(resolve_mode("") == Engine2DApiSessionMode.ManagedShared)

describe "Engine2D constructors":

    it "creates a legacy no-session surface":
        step("Verify: creates a legacy no-session surface")
        val e = Engine2D.create(800, 600)
        expect(e.width).to_equal(800)  # oracle: 800 — named expected value from the requirement
        expect(e.height).to_equal(600)  # oracle: 600 — named expected value from the requirement
        expect(e.get_session_handle()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_true(e.session_mode == Engine2DApiSessionMode.LegacyNoSession)
        assert_true(e.session_kind == Engine2DApiSessionKind.Cpu)
        assert_true(e.initialized)

    it "creates a managed session with resolved kind, policy, and synthetic handle":
        step("Verify: creates a managed session with resolved kind, policy, and synthetic handle")
        val e = Engine2D.create_managed(64, 32, "vulkan", "perf")
        expect(e.get_session_handle()).to_equal(64 * 32)
        assert_true(e.session_kind == Engine2DApiSessionKind.Vulkan)
        assert_true(e.session_mode == Engine2DApiSessionMode.PerfExclusive)
        val d = Engine2D.create_managed(4, 4, "unknown", "unknown")
        assert_true(d.session_kind == Engine2DApiSessionKind.Cpu)
        assert_true(d.session_mode == Engine2DApiSessionMode.ManagedShared)

    it "adopts a caller-owned session handle":
        step("Verify: adopts a caller-owned session handle")
        val e = Engine2D.create_with_session(16, 16, 42)
        expect(e.get_session_handle()).to_equal(42)  # oracle: 42 — named expected value from the requirement
        assert_true(e.session_mode == Engine2DApiSessionMode.ManagedShared)
        assert_true(e.session_kind == Engine2DApiSessionKind.Cpu)

describe "Engine2D rendering operations":

    it "succeeds on an initialized surface":
        step("Verify: succeeds on an initialized surface")
        val e = Engine2D.create(8, 8)
        expect(e.fill(0, 0, 8, 8, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(e.blit(0, 0, 1, 1, 4, 4)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(e.present()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(e.read_pixels(0, 0, 8, 8)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects operations on an uninitialized surface":
        step("Verify: rejects operations on an uninitialized surface")
        val e = Engine2D(
            width: 8,
            height: 8,
            session_handle_id: 0,
            session_mode: Engine2DApiSessionMode.LegacyNoSession,
            session_kind: Engine2DApiSessionKind.Cpu,
            initialized: false
        )
        expect(e.fill(0, 0, 8, 8, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(e.blit(0, 0, 1, 1, 4, 4)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(e.present()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(e.read_pixels(0, 0, 8, 8)).to_equal(0)  # oracle: 0 — named expected value from the requirement
