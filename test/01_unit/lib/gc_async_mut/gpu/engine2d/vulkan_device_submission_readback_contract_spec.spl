# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl

use std.spec.{describe, it, expect, assert_true}
use std.gc_async_mut.gpu.engine2d.backend_vulkan.{VulkanBackend}

describe "Vulkan Engine2D device submission contract":
    it "selects a device, submits a draw, and returns device readback without CPU fallback":
        var backend = VulkanBackend.create()
        assert_true(backend.init(4, 4))

        val selected_device = backend.session.selected_device_index
        val device_handle = backend.session.device
        val framebuffer_handle = backend.d_framebuffer

        backend.clear(0x101010FFu32)
        backend.draw_rect_filled(1, 1, 2, 2, 0xFF0000FFu32)
        val readback = backend.read_pixels_with_source()
        val offloaded = not backend.cpu_fallback_used
        backend.shutdown()

        expect(selected_device).to_equal(0)
        expect(device_handle).to_be_greater_than(0)
        expect(framebuffer_handle).to_be_greater_than(0)
        expect(readback.source).to_equal("device_readback")
        expect(readback.backend_handle).to_be_greater_than(0)
        expect(readback.device_identity).to_be_greater_than(0)
        expect(readback.pixel_count).to_equal(16)
        expect(offloaded).to_equal(true)
