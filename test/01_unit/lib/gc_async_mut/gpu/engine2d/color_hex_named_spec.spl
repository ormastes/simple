# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# @cover src/lib/gc_async_mut/gpu/engine2d/color.spl 49%
# @tag: unit, engine2d, color
#
# Hex parsing/formatting and the named-colour constants of the Simple 2D colour
# module. Before this spec the hex and named-constant half of color.spl
# (hex_to_color, color_to_hex, color_white..color_gray) had no direct spec;
# engine2d_color_spec.spl covers only rgb/rgba/blend/lerp_color.
# Colours are packed 0xAARRGGBB, so every expectation below is a channel value
# read back through color_a/r/g/b or the exact "#AARRGGBB" text.

use std.spec.{describe, context, it, expect}
use std.gpu.engine2d.color.{
    rgb, rgba, color_r, color_g, color_b, color_a,
    hex_to_color, color_to_hex,
    color_black, color_white, color_red, color_green, color_blue,
    color_yellow, color_cyan, color_magenta, color_transparent, color_gray
}

describe "Engine2D colour hex conversion and named constants":

    context "hex_to_color":

        it "parses #RRGGBB as opaque":
            val c = hex_to_color("#FF8040")
            expect(color_a(c)).to_equal(255)
            expect(color_r(c)).to_equal(255)
            expect(color_g(c)).to_equal(128)
            expect(color_b(c)).to_equal(64)

        it "parses RRGGBB without the hash":
            val c = hex_to_color("102030")
            expect(color_a(c)).to_equal(255)
            expect(color_r(c)).to_equal(16)
            expect(color_g(c)).to_equal(32)
            expect(color_b(c)).to_equal(48)

        it "parses #AARRGGBB with the alpha byte first":
            val c = hex_to_color("#80FF0001")
            expect(color_a(c)).to_equal(128)
            expect(color_r(c)).to_equal(255)
            expect(color_g(c)).to_equal(0)
            expect(color_b(c)).to_equal(1)

        it "accepts lower-case and mixed-case digits":
            val c = hex_to_color("#abCDef")
            expect(color_r(c)).to_equal(171)
            expect(color_g(c)).to_equal(205)
            expect(color_b(c)).to_equal(239)

        it "falls back to opaque black for an unsupported length":
            val c = hex_to_color("#FFF")
            expect(color_a(c)).to_equal(255)
            expect(color_r(c)).to_equal(0)
            expect(color_g(c)).to_equal(0)
            expect(color_b(c)).to_equal(0)

    context "color_to_hex":

        it "formats as upper-case #AARRGGBB":
            expect(color_to_hex(rgba(255, 128, 64, 32))).to_equal("#20FF8040")

        it "zero-pads channels below 16":
            expect(color_to_hex(rgba(1, 2, 3, 4))).to_equal("#04010203")

        it "round-trips an 8-digit hex string":
            expect(color_to_hex(hex_to_color("#7FA1B2C3"))).to_equal("#7FA1B2C3")

        it "adds an opaque alpha when round-tripping 6 digits":
            expect(color_to_hex(hex_to_color("#0A0B0C"))).to_equal("#FF0A0B0C")

    context "named constants":

        it "black and white are opaque extremes":
            expect(color_to_hex(color_black())).to_equal("#FF000000")
            expect(color_to_hex(color_white())).to_equal("#FFFFFFFF")

        it "primaries set exactly one channel":
            expect(color_to_hex(color_red())).to_equal("#FFFF0000")
            expect(color_to_hex(color_green())).to_equal("#FF00FF00")
            expect(color_to_hex(color_blue())).to_equal("#FF0000FF")

        it "secondaries set exactly two channels":
            expect(color_to_hex(color_yellow())).to_equal("#FFFFFF00")
            expect(color_to_hex(color_cyan())).to_equal("#FF00FFFF")
            expect(color_to_hex(color_magenta())).to_equal("#FFFF00FF")

        it "transparent has zero alpha and zero colour":
            expect(color_to_hex(color_transparent())).to_equal("#00000000")

        it "gray repeats the level on all three channels":
            expect(color_to_hex(color_gray(96))).to_equal("#FF606060")

        it "gray clamps levels outside 0..255":
            expect(color_to_hex(color_gray(300))).to_equal("#FFFFFFFF")
            expect(color_to_hex(color_gray(-5))).to_equal("#FF000000")
