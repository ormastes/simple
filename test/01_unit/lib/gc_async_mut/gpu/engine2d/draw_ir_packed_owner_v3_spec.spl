# @cover src/lib/gc_async_mut/gpu/engine2d/draw_ir_packed_owner_v3.spl 80%

use spec
use common.mission_critical.draw_ir_packed_generation_store_v3.*
use common.ui.draw_ir_v3.*
use common.ui.draw_ir.*
use std.gc_async_mut.gpu.engine2d.draw_ir_packed_composition_owner_v3.*
use std.gc_async_mut.gpu.engine2d.draw_ir_packed_owner_v3.*
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

fn _packed_rect_scene(generation: u32, color: u32) -> DrawIrV3Scene:
    var scene = draw_ir_v3_empty_scene(19u32, generation)
    scene.geometry = draw_ir_v3_geometry_append(scene.geometry, 1, 1, 2, 2, 0)
    scene.paint = draw_ir_v3_paint_append(scene.paint, color, 0u32, 0, 1000, 0u16)
    var command = draw_ir_v3_empty_command()
    command.kind = DRAW_IR_V3_KIND_RECT
    command.geometry_id = 0u32
    command.paint_id = 0u32
    draw_ir_v3_scene_push_command(scene, command)

fn _packed_rect_composition(identity: text, color: u32) -> DrawIrComposition:
    val command = draw_ir_box_with_style(
        "{identity}-rect", 1, 1, 2, 2, color,
        draw_ir_rect_bounds(1, 1, 2, 2), draw_ir_rect_bounds(1, 1, 2, 2),
        draw_ir_rect_bounds(1, 1, 2, 2), draw_ir_no_rect(), []
    )
    val batch = draw_ir_batch(
        "{identity}-batch", "cpu",
        draw_ir_embedding_config("", "", 0, 0, 4, 4, 0, 1000, false),
        [command]
    )
    draw_ir_composition(identity, "scene", "cpu", [batch])

fn _publish_scene(store: DrawIrPackedGenerationStoreV3, scene: DrawIrV3Scene) -> DrawIrPackedGenerationStoreV3:
    var owned = store
    val rows = engine2d_draw_ir_v3_identity_rows(scene)
    var generation_ref = DrawIrPackedGenerationRefV3(arena_id: 0u64, generation: 0u64, slot: 0u32)
    match owned.admit(rows.len() as u32):
        DrawIrPackedAdmissionV3.Admitted(value): generation_ref = value
        DrawIrPackedAdmissionV3.Refused(reason): return owned
    for row in rows:
        if owned.write(generation_ref, row) != DRAW_IR_PACKED_REASON_OK:
            return owned
    match owned.seal(generation_ref):
        DrawIrPackedSealV3.Sealed(submission):
            owned.publish(submission)
        DrawIrPackedSealV3.Refused(reason):
            return owned
    owned

describe "Engine2D packed DrawIR-v3 owner boundary":
    it "adopts a canonical rect composition through the bounded generation owner":
        val composition = _packed_rect_composition("production", 0xff224466u32)
        val engine = Engine2D.create_with_backend(4, 4, "cpu")
        val (rendered_engine, returned_store, receipt) = engine2d_draw_ir_v3_render_composition(
            engine, engine2d_packed_v3_store(91u64), composition
        )
        expect(receipt.accepted).to_equal(true)
        expect(receipt.arena_id).to_equal(91u64)
        expect(receipt.generation).to_be_greater_than(0u64)
        expect(receipt.storage_released).to_equal(true)
        expect(rendered_engine.read_pixels()[5]).to_equal(0xff224466u32)
        match returned_store.admit(262144u32):
            DrawIrPackedAdmissionV3.Admitted(value): expect(value.generation).to_be_greater_than(receipt.generation)
            DrawIrPackedAdmissionV3.Refused(reason): expect(false).to_equal(true)

    it "renders only the queued sealed scene and releases its slot":
        val scene = _packed_rect_scene(7u32, 0xff336699u32)
        var store = DrawIrPackedGenerationStoreV3.bounded(77u64, 1u32, 17u32, 1u32)
        store = _publish_scene(store, scene)
        val engine = Engine2D.create_with_backend(4, 4, "cpu")
        val (rendered_engine, returned_store, receipt) = engine2d_draw_ir_v3_take_and_render(engine, store, scene)
        expect(receipt.accepted).to_equal(true)
        expect(receipt.reason).to_equal(ENGINE2D_PACKED_V3_OK)
        expect(receipt.rendered_command_count).to_equal(1u32)
        expect(receipt.storage_released).to_equal(true)
        expect(receipt.content_hash.len()).to_equal(16)  # oracle: _draw_ir_packed_hash_v3 renders one FNV-1a u64 as 16 hex digits
        val pixels = rendered_engine.read_pixels()
        expect(pixels[5]).to_equal(0xff336699u32)
        match returned_store.admit(17u32):
            DrawIrPackedAdmissionV3.Admitted(value): expect(value.generation).to_be_greater_than(receipt.generation)
            DrawIrPackedAdmissionV3.Refused(reason): expect(false).to_equal(true)

    it "rejects a mutated scene instead of bypassing the queued identity":
        val sealed_scene = _packed_rect_scene(8u32, 0xff112233u32)
        val mutated_scene = _packed_rect_scene(8u32, 0xff445566u32)
        var store = DrawIrPackedGenerationStoreV3.bounded(78u64, 1u32, 17u32, 1u32)
        store = _publish_scene(store, sealed_scene)
        val engine = Engine2D.create_with_backend(4, 4, "cpu")
        val (returned_engine, returned_store, receipt) = engine2d_draw_ir_v3_take_and_render(engine, store, mutated_scene)
        expect(receipt.accepted).to_equal(false)
        expect(receipt.reason).to_equal(ENGINE2D_PACKED_V3_IDENTITY_MISMATCH)
        expect(receipt.rendered_command_count).to_equal(0u32)
        expect(receipt.storage_released).to_equal(true)
        expect(returned_engine.read_pixels()[5]).to_equal(0u32)
        match returned_store.admit(17u32):
            DrawIrPackedAdmissionV3.Admitted(value): expect(true).to_equal(true)
            DrawIrPackedAdmissionV3.Refused(reason): expect(false).to_equal(true)

    it "freezes the composition bytes and exact rows for IN_FLIGHT finalization":
        val composition = _packed_rect_composition("snapshot", 0xff224466u32)
        var store = engine2d_packed_v3_store(93u64)
        val prepared = engine2d_packed_v3_prepare_identity(store, composition)
        store = prepared.0
        expect(prepared.1.ok).to_equal(true)
        expect(prepared.1.snapshot.row_count).to_equal(prepared.1.snapshot.rows.len().to_u32())
        expect(prepared.1.snapshot.composition_hash.len()).to_equal(64)
        expect(prepared.1.snapshot.packed_hash).to_equal(prepared.1.submission.content_hash)
        expect(engine2d_packed_v3_identity_artifact(prepared.1.snapshot)).to_contain(
            "packed_identity_schema=draw-ir-packed-identity-v3")
        expect(engine2d_packed_v3_verify_identity_snapshot(
            prepared.1.snapshot, prepared.1.submission, composition)).to_equal(true)
        var changed = composition
        changed.composition_id = "changed-after-admission"
        expect(engine2d_packed_v3_verify_identity_snapshot(
            prepared.1.snapshot, prepared.1.submission, changed)).to_equal(false)
        val finalized = engine2d_packed_v3_finalize_identity(
            store, prepared.1, changed, true)
        expect(finalized.1).to_equal(false)
        expect(finalized.0.terminal).to_equal(true)

    it "poisons an in-flight generation when authoritative packed storage changes":
        val composition = _packed_rect_composition("store-mutation", 0xff335577u32)
        var store = engine2d_packed_v3_store(94u64)
        val prepared = engine2d_packed_v3_prepare_identity(store, composition)
        store = prepared.0
        expect(prepared.1.ok).to_equal(true)
        val slot = prepared.1.submission.generation_ref.slot
        val offset = slot as u64 * store.rows_per_slot as u64
        store.packed_rows[offset] = store.packed_rows[offset] + 1u64
        val finalized = engine2d_packed_v3_finalize_identity(
            store, prepared.1, composition, true)
        expect(finalized.1).to_equal(false)
        expect(finalized.0.terminal).to_equal(true)

    it "poisons the in-flight generation when the renderer receipt is rejected":
        val composition = _packed_rect_composition("render-rejection", 0xff38597au32)
        var store = engine2d_packed_v3_store(97u64)
        val prepared = engine2d_packed_v3_prepare_identity(store, composition)
        store = prepared.0
        expect(prepared.1.ok).to_equal(true)
        val finalized = engine2d_packed_v3_finalize_identity(
            store, prepared.1, composition, false)
        expect(finalized.1).to_equal(false)
        expect(finalized.0.terminal).to_equal(true)

    it "rejects reordered copied rows without mutating the authentic snapshot":
        val composition = _packed_rect_composition("row-reorder", 0xff446688u32)
        var store = engine2d_packed_v3_store(95u64)
        val prepared = engine2d_packed_v3_prepare_identity(store, composition)
        store = prepared.0
        var reordered_rows = prepared.1.snapshot.rows
        val first = reordered_rows[0]
        reordered_rows[0] = reordered_rows[1]
        reordered_rows[1] = first
        var reordered_snapshot = prepared.1.snapshot
        reordered_snapshot.rows = reordered_rows
        expect(engine2d_packed_v3_verify_identity_snapshot(
            prepared.1.snapshot, prepared.1.submission, composition)).to_equal(true)
        expect(engine2d_packed_v3_verify_identity_snapshot(
            reordered_snapshot, prepared.1.submission, composition)).to_equal(false)
        val forged = Engine2dPackedIdentityHandoffV3(
            ok: true, reason: DRAW_IR_PACKED_REASON_OK,
            submission: prepared.1.submission, snapshot: reordered_snapshot)
        val finalized = engine2d_packed_v3_finalize_identity(
            store, forged, composition, true)
        expect(finalized.1).to_equal(false)
        expect(finalized.0.terminal).to_equal(true)

    it "rejects an old handoff after the fixed slot is reused by a new generation":
        val composition = _packed_rect_composition("aba-replay", 0xff557799u32)
        var store = engine2d_packed_v3_store(96u64)
        val first = engine2d_packed_v3_prepare_identity(store, composition)
        store = first.0
        val first_done = engine2d_packed_v3_finalize_identity(
            store, first.1, composition, true)
        expect(first_done.1).to_equal(true)
        store = first_done.0
        val second = engine2d_packed_v3_prepare_identity(store, composition)
        store = second.0
        expect(second.1.ok).to_equal(true)
        expect(second.1.submission.generation_ref.generation).to_be_greater_than(
            first.1.submission.generation_ref.generation)
        val replayed = engine2d_packed_v3_finalize_identity(
            store, first.1, composition, true)
        expect(replayed.1).to_equal(false)
        expect(replayed.0.terminal).to_equal(true)
        expect(replayed.0.slot_states[second.1.submission.generation_ref.slot]).to_equal(
            DRAW_IR_PACKED_SLOT_IN_FLIGHT)
