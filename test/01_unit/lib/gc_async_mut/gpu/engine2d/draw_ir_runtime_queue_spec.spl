"""
## Purpose and audience
Purpose: Prove that Engine2D Draw IR runtime queue bridge.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

# @cover src/lib/gc_async_mut/gpu/engine2d/draw_ir_adv.spl 80%
# @tag: unit, gpu, draw_ir, host_gpu_queue
"""
# Engine2D Draw IR Runtime Queue Spec

## Overview

This focused spec covers the production bridge from a GPU-selected Draw IR
batch into the host/GPU runtime queue. It intentionally avoids SGTTI and broad
browser imports so native verification stays scoped to Engine2D, Draw IR, and
the runtime queue API.

## Requirements

**Requirements:** N/A

## Plan

**Plan:** doc/03_plan/agent_tasks/real_host_gpu_runtime_queue_emission.md

## Design

**Design:** doc/04_architecture/ui/simple_gui_stack.md

## Research

**Research:** N/A

## Examples

The scenario creates a Draw IR batch that requests the GPU backend, submits it
through an Engine2D host/GPU runtime queue with queue identity `1` and backend
handle `7`, renders the batch, drains the runtime queue, and asserts that the
runtime drain reports the backend handle rather than the queue id.
"""

use std.spec.*
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_GPU,
    draw_ir_batch,
    draw_ir_embedding_config,
    draw_ir_rect
}
use std.gc_async_mut.gpu.engine2d.draw_ir_runtime_adv.{engine2d_draw_ir_adv_batch_runtime_queue}
use std.gc_async_mut.gpu.engine2d.draw_ir_runtime_queue.{
    engine2d_draw_ir_payload_checksum,
    engine2d_draw_ir_payload_summary,
    engine2d_draw_ir_runtime_queue_dispatch_only
}
use common.ui.draw_ir.{DRAW_IR_BACKEND_CPU}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use std.gc_async_mut.gpu.engine2d.host_gpu_event_queue.{engine2d_host_gpu_runtime_queue_with_backend_handle, engine2d_host_gpu_runtime_reset}

val BG: u32 = 0xff000000u32
val GREEN: u32 = 0xff00ff00u32

use std.spec.step

describe "Engine2D Draw IR runtime queue bridge":

    it "submits and drains a GPU-selected Draw IR batch through the runtime queue":
        step("Verify: submits and drains a GPU-selected Draw IR batch through the runtime queue")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        engine2d_host_gpu_runtime_reset()
        var engine = Engine2D.create_with_backend(32, 24, "cpu")
        engine.clear(BG)
        val batch = draw_ir_batch("batch-runtime", DRAW_IR_BACKEND_GPU, draw_ir_embedding_config("surf1", "win1", 0, 0, 20, 16, 10, 1000, false), [
            draw_ir_rect("body", 2, 3, 6, 5, GREEN)
        ])
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)

        val result = engine2d_draw_ir_adv_batch_runtime_queue(engine, batch, true, queue)

        # Runtime-queued batches dispatch through a "runtime-"-tagged composition
        # (see draw_ir_runtime_queue.spl payload summary), so the rendered unit id
        # reflects that composition id, not the bare batch id.
        expect(result.render.unit_id).to_equal("runtime-batch-runtime")
        expect(result.render.selected_backend).to_equal("gpu")
        expect(result.render.rendered_command_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.runtime_submit.submitted).to_be(true)
        expect(result.runtime_submit.packet_id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.runtime_drain.drained).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.runtime_drain.status).to_equal("completed")
        expect(result.runtime_drain.queue_handle).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.runtime_drain.last_backend_handle).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(result.queued_for_gpu).to_be(true)
        expect(result.render.pixels[3 * 32 + 2]).to_equal(GREEN)
        engine.shutdown()

    it "keeps a CPU-selected batch on the host path without touching the queue":
        step("Verify: keeps a CPU-selected batch on the host path without touching the queue")
        engine2d_host_gpu_runtime_reset()
        val batch = draw_ir_batch("batch-cpu", DRAW_IR_BACKEND_CPU, draw_ir_embedding_config("surf1", "win1", 0, 0, 8, 8, 10, 1000, false), [
            draw_ir_rect("body", 1, 1, 2, 2, GREEN)
        ])
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)

        val result = engine2d_draw_ir_runtime_queue_dispatch_only(batch, false, queue)

        expect(result.queued_for_gpu).to_equal(false)
        expect(result.runtime_submit.submitted).to_equal(false)
        expect(result.runtime_submit.status).to_equal("host")
        expect(result.runtime_drain.drained).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.runtime_drain.status).to_equal("empty")
        expect(result.runtime_dispatch.dispatched).to_equal(false)
        expect(result.runtime_dispatch.status).to_equal("host")

    it "refuses to queue when the runtime is unavailable":
        step("Verify: refuses to queue when the runtime is unavailable")
        engine2d_host_gpu_runtime_reset()
        val batch = draw_ir_batch("batch-noruntime", DRAW_IR_BACKEND_GPU, draw_ir_embedding_config("surf1", "win1", 0, 0, 8, 8, 10, 1000, false), [
            draw_ir_rect("body", 1, 1, 2, 2, GREEN)
        ])
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, false, 4096)

        val result = engine2d_draw_ir_runtime_queue_dispatch_only(batch, true, queue)

        expect(result.queued_for_gpu).to_equal(false)
        expect(result.runtime_submit.submitted).to_equal(false)
        expect(result.runtime_drain.drained).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.runtime_dispatch.dispatched).to_equal(false)

    it "computes a stable, content-sensitive payload checksum and summary":
        step("Verify: computes a stable, content-sensitive payload checksum and summary")
        val cfg = draw_ir_embedding_config("surfX", "winX", 0, 0, 8, 8, 10, 1000, false)
        val a = draw_ir_batch("chk", DRAW_IR_BACKEND_GPU, cfg, [
            draw_ir_rect("one", 1, 2, 3, 4, GREEN),
            draw_ir_rect("two", 5, 6, 7, 8, BG)
        ])
        # Same command count, different geometry: checksum must differ.
        # (The checksum is deliberately NOT order-sensitive: the index term
        # (i+1)*17 sums identically under permutation.)
        val b = draw_ir_batch("chk", DRAW_IR_BACKEND_GPU, cfg, [
            draw_ir_rect("one", 1, 2, 3, 5, GREEN),
            draw_ir_rect("two", 5, 6, 7, 8, BG)
        ])
        val empty = draw_ir_batch("chk-empty", DRAW_IR_BACKEND_GPU, cfg, [])

        expect(engine2d_draw_ir_payload_checksum(a)).to_equal(engine2d_draw_ir_payload_checksum(a))
        assert_true(engine2d_draw_ir_payload_checksum(a) != engine2d_draw_ir_payload_checksum(b))
        expect(engine2d_draw_ir_payload_checksum(empty)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        val summary = engine2d_draw_ir_payload_summary(a, 128)
        expect(summary.batch_id).to_equal("chk")
        expect(summary.command_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(summary.packet_bytes).to_equal(128)  # oracle: 128 — named expected value from the requirement
        assert_true(summary.payload_sdn_bytes > 0)
        assert_true(summary.summary.contains("batch=chk"))
        assert_true(summary.summary.contains("commands=2"))
