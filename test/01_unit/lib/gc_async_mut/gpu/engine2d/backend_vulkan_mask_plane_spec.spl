        assert_masked_line_literal(1, 0, -1, -4, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
        assert_masked_line_literal(-1, -4, 1, 0, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
        assert_masked_line_literal(1, 0, 3, -4, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
        assert_masked_line_literal(3, -4, 1, 0, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
