        assert_masked_line_literal(1, 0, -3, 2, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
        assert_masked_line_literal(-3, 2, 1, 0, [0u32, OPAQUE_BLUE, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32])
