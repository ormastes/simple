"""Bit-exact tests for the bounded Engine2D emulation blur."""

use std.spec.*
use std.gc_async_mut.gpu.engine2d.backend_software.{SoftwareBackend}

fn _pixel(r: i32, g: i32, b: i32, a: i32) -> u32:
    (a.to_u32() << 24) | (r.to_u32() << 16) | (g.to_u32() << 8) | b.to_u32()

fn _fixture(width: i32, height: i32) -> [u32]:
    var pixels: [u32] = [0u32; width * height]
    var i = 0
    while i < pixels.len():
        pixels[i] = _pixel(
            (i * 37 + 11) % 256,
            (i * 53 + 29) % 256,
            (i * 71 + 47) % 256,
            (i * 19 + 131) % 256
        )
        i = i + 1
    pixels

fn _reference_blur(
    source: [u32], framebuffer_width: i32, framebuffer_height: i32,
    x: i32, y: i32, width: i32, height: i32, radius: i32
) -> [u32]:
    var result = source
    var py = 0
    while py < height:
        var px = 0
        while px < width:
            var sr = 0
            var sg = 0
            var sb = 0
            var sa = 0
            var count = 0
            var ky = -radius
            while ky <= radius:
                var kx = -radius
                while kx <= radius:
                    val fx = x + px + kx
                    val fy = y + py + ky
                    if (
                        fx >= 0 and fx < framebuffer_width and
                        fy >= 0 and fy < framebuffer_height
                    ):
                        val p = source[fy * framebuffer_width + fx]
                        sr = sr + (((p >> 16) & 0xFFu32) as i32)
                        sg = sg + (((p >> 8) & 0xFFu32) as i32)
                        sb = sb + ((p & 0xFFu32) as i32)
                        sa = sa + (((p >> 24) & 0xFFu32) as i32)
                        count = count + 1
                    kx = kx + 1
                ky = ky + 1
            val dx = x + px
            val dy = y + py
            if (
                count > 0 and dx >= 0 and dx < framebuffer_width and
                dy >= 0 and dy < framebuffer_height
            ):
                result[dy * framebuffer_width + dx] = _pixel(
                    sr / count, sg / count, sb / count, sa / count
                )
            px = px + 1
        py = py + 1
    result

fn _render_blur(
    source: [u32], framebuffer_width: i32, framebuffer_height: i32,
    x: i32, y: i32, width: i32, height: i32, radius: i32
) -> [u32]:
    var backend = SoftwareBackend.create()
    backend.init(framebuffer_width, framebuffer_height)
    backend.draw_image(
        0, 0, framebuffer_width, framebuffer_height, source
    )
    backend.draw_blur_rect(x, y, width, height, radius)
    backend.read_pixels()

describe "Engine2D emulation blur":

    it "matches the full square-tap oracle without intermediate rounding":
        val source = _fixture(8, 6)
        val actual = _render_blur(source, 8, 6, 1, 1, 6, 4, 4)
        val expected = _reference_blur(source, 8, 6, 1, 1, 6, 4, 4)

        expect(actual).to_equal(expected)

    it "preserves clipped-edge sample counts":
        val source = _fixture(7, 5)
        val actual = _render_blur(source, 7, 5, -2, -1, 6, 5, 2)
        val expected = _reference_blur(source, 7, 5, -2, -1, 6, 5, 2)

        expect(actual).to_equal(expected)

    it "matches the oracle at the packed rolling-sum radius bound":
        val source = _fixture(7, 5)
        val actual = _render_blur(source, 7, 5, 2, 1, 2, 2, 127)
        val expected = _reference_blur(source, 7, 5, 2, 1, 2, 2, 127)

        expect(actual).to_equal(expected)
