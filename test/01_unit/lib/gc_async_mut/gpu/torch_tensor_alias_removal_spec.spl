use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "Torch tensor compatibility alias removal":
    it "uses Tensor directly across the facade and GPU memory consumer":
        val owner = file_read("src/lib/gc_async_mut/torch/mod.spl")
        val facade = file_read("src/lib/gc_async_mut/torch/__init__.spl")
        val consumer = file_read("src/lib/gc_async_mut/gpu/memory.spl")

        expect(owner.contains("val TorchTensorWrapper = Tensor")).to_equal(false)
        expect(facade.contains("export TorchTensorWrapper")).to_equal(false)
        expect(facade).to_contain("use std.torch.{Tensor, torch_available}")
        expect(consumer).to_contain("use std.torch.{Tensor}")
        expect(consumer).to_contain("torch_tensor: Tensor?")
        expect(consumer).to_contain("Tensor.from_handle(gpu_handle)")
        expect(consumer).to_contain("Tensor.tensor_zeros([count])")
        expect(consumer.contains("TorchTensorWrapper")).to_equal(false)
