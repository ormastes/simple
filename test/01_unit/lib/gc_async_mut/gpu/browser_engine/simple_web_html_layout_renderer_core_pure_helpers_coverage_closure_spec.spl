describe "core.spl: rule-list merge helpers":
    it "merge_two_sorted_rule_lists_unique returns the non-empty side when one side is empty":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: merge_two_sorted_rule_lists_unique returns the non-empty side when one side is empty")
        val left: [i32] = []
        val right: [i32] = [1, 2, 3]
        val merged = merge_two_sorted_rule_lists_unique(left, right)
        expect(merged.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val left2: [i32] = [4, 5]
        val right2: [i32] = []
        val merged2 = merge_two_sorted_rule_lists_unique(left2, right2)
        expect(merged2.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "merge_two_sorted_rule_lists_unique dedupes overlapping ids":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: merge_two_sorted_rule_lists_unique dedupes overlapping ids")
        val left: [i32] = [1, 3, 5]
        val right: [i32] = [2, 3, 5, 7]
        val merged = merge_two_sorted_rule_lists_unique(left, right)
        # union deduped: 1,2,3,5,7 -> 5 entries
        expect(merged.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(merged[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(merged[1]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(merged[2]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(merged[3]).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(merged[4]).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "merge_sorted_rule_lists_unique_count handles 0, 1, and 2-list cases":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: merge_sorted_rule_lists_unique_count handles 0, 1, and 2-list cases")
        val zero: [[i32]] = []
        expect(merge_sorted_rule_lists_unique_count(zero, 0).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val one_list: [i32] = [9, 9, 10]
        val one: [[i32]] = [one_list]
        expect(merge_sorted_rule_lists_unique_count(one, 1).len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val a: [i32] = [1, 2]
        val b: [i32] = [2, 3]
        val two: [[i32]] = [a, b]
        expect(merge_sorted_rule_lists_unique_count(two, 2).len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "merge_sorted_rule_lists_unique_count merges 3+ lists with dedupe (k-way path)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: merge_sorted_rule_lists_unique_count merges 3+ lists with dedupe (k-way path)")
        val a: [i32] = [1, 4, 7]
        val b: [i32] = [2, 4, 8]
        val c: [i32] = [3, 4, 9]
        val lists: [[i32]] = [a, b, c]
        val merged = merge_sorted_rule_lists_unique_count(lists, 3)
        # union deduped: 1,2,3,4,7,8,9 -> 7 entries
        expect(merged.len()).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(merged[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(merged[3]).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(merged[6]).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "rule_lists_from_counts allocates one list per requested count":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rule_lists_from_counts allocates one list per requested count")
        val counts: [i32] = [2, 0, 3]
        val lists = rule_lists_from_counts(counts)
        expect(lists.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(lists[0].len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(lists[1].len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(lists[2].len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

describe "core.spl: selector bucket / small array helpers":
    it "selector_bucket_value_from_base extracts an id":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base extracts an id")
        expect(selector_bucket_value_from_base("#foo")).to_equal("foo")

    it "selector_bucket_value_from_base extracts a single class":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base extracts a single class")
        expect(selector_bucket_value_from_base(".bar")).to_equal("bar")

    it "selector_bucket_value_from_base extracts the id from a tag#id compound":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base extracts the id from a tag#id compound")
        expect(selector_bucket_value_from_base("div#foo")).to_equal("foo")

    it "selector_bucket_value_from_base extracts the first class from a tag.class compound":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base extracts the first class from a tag.class compound")
        expect(selector_bucket_value_from_base("div.bar")).to_equal("bar")

    it "selector_bucket_value_from_base returns empty for an empty base":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base returns empty for an empty base")
        expect(selector_bucket_value_from_base("")).to_equal("")

    it "selector_bucket_value_from_base returns the bare tag when no id/class present":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: selector_bucket_value_from_base returns the bare tag when no id/class present")
        expect(selector_bucket_value_from_base("div")).to_equal("div")

    it "text_seen_before finds a prior duplicate and reports absence otherwise":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: text_seen_before finds a prior duplicate and reports absence otherwise")
        val values: [text] = ["a", "b", "a"]
        expect(text_seen_before(values, 2, "a")).to_equal(true)
        expect(text_seen_before(values, 2, "c")).to_equal(false)
        expect(text_seen_before(values, 0, "a")).to_equal(false)

    it "i32_list_prefix copies the first `count` elements":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: i32_list_prefix copies the first `count` elements")
        val values: [i32] = [10, 20, 30, 40]
        val prefix = i32_list_prefix(values, 2)
        expect(prefix.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(prefix[0]).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(prefix[1]).to_equal(20)  # oracle: 20 — named expected value from the requirement

    it "text_key_index_count finds a key's index and reports -1 when absent":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: text_key_index_count finds a key's index and reports -1 when absent")
        val keys: [text] = ["x", "y", "z"]
        expect(text_key_index_count(keys, "y", 3)).to_equal(1)
        expect(text_key_index_count(keys, "q", 3)).to_equal(-1)

    it "dict_key_index_count prefers the O(1) dict when the key is present":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: dict_key_index_count prefers the O(1) dict when the key is present")
        var d: Dict<text, i32> = {}
        d["y"] = 99
        val keys: [text] = ["x", "y", "z"]
        expect(dict_key_index_count(d, keys, "y", 3)).to_equal(99)

    it "dict_key_index_count falls back to the linear scan when the key is absent from the dict":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: dict_key_index_count falls back to the linear scan when the key is absent from the dict")
        val d: Dict<text, i32> = {}
        val keys: [text] = ["x", "y", "z"]
        expect(dict_key_index_count(d, keys, "z", 3)).to_equal(2)
        expect(dict_key_index_count(d, keys, "q", 3)).to_equal(-1)

describe "core.spl: attribute/class matching helpers":
    it "unquote_css_attr_value strips matching double or single quotes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: unquote_css_attr_value strips matching double or single quotes")
        expect(unquote_css_attr_value("\"foo\"")).to_equal("foo")
        expect(unquote_css_attr_value("'foo'")).to_equal("foo")
        expect(unquote_css_attr_value("foo")).to_equal("foo")

    it "attr_selector_matches evaluates the presence-only form":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches evaluates the presence-only form")
        expect(attr_selector_matches("disabled=\"disabled\"", "disabled")).to_equal(true)
        expect(attr_selector_matches("", "disabled")).to_equal(false)

    it "attr_selector_matches evaluates the exact-match form":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches evaluates the exact-match form")
        expect(attr_selector_matches("type=\"text\"", "type=\"text\"")).to_equal(true)
        expect(attr_selector_matches("type=\"text\"", "type=\"radio\"")).to_equal(false)

    it "attr_selector_matches evaluates the ^= prefix form":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches evaluates the ^= prefix form")
        expect(attr_selector_matches("href=\"https://example.com\"", "href^=\"https\"")).to_equal(true)
        expect(attr_selector_matches("href=\"https://example.com\"", "href^=\"ftp\"")).to_equal(false)

    it "attr_selector_matches evaluates the $= suffix form":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches evaluates the $= suffix form")
        expect(attr_selector_matches("href=\"file.png\"", "href$=\".png\"")).to_equal(true)
        expect(attr_selector_matches("href=\"file.png\"", "href$=\".jpg\"")).to_equal(false)

    it "attr_selector_matches evaluates the case-insensitive ` i` flag":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches evaluates the case-insensitive ` i` flag")
        expect(attr_selector_matches("type=\"TEXT\"", "type=\"text\" i")).to_equal(true)

    it "attr_selector_matches rejects an empty expression":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: attr_selector_matches rejects an empty expression")
        expect(attr_selector_matches("anything", "")).to_equal(false)

    it "class_words_has finds an exact class word":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: class_words_has finds an exact class word")
        val words: [text] = ["a", "b", "c"]
        expect(class_words_has(words, "b")).to_equal(true)
        expect(class_words_has(words, "z")).to_equal(false)

    it "class_has_all requires every dotted class to be present":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: class_has_all requires every dotted class to be present")
        val words: [text] = ["a", "b", "c"]
        expect(class_has_all(words, ".a.b")).to_equal(true)
        expect(class_has_all(words, ".a.z")).to_equal(false)

    it "base_selector_matches matches by tag, class, and id":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: base_selector_matches matches by tag, class, and id")
        val class_words: [text] = ["a", "b"]
        expect(base_selector_matches("div.a", "div", "a b", class_words, "foo")).to_equal(true)
        expect(base_selector_matches("#foo", "div", "a b", class_words, "foo")).to_equal(true)
        expect(base_selector_matches("span", "div", "a b", class_words, "foo")).to_equal(false)

    it "base_selector_matches matches the universal selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: base_selector_matches matches the universal selector")
        val class_words: [text] = []
        expect(base_selector_matches("*", "div", "", class_words, "")).to_equal(true)
