    merge_two_sorted_rule_lists_unique,
    merge_sorted_rule_lists_unique_count,
    rule_lists_from_counts,
    selector_bucket_value_from_base,
    text_seen_before,
    i32_list_prefix,
    text_key_index_count,
    dict_key_index_count,
    attr_selector_matches,
    base_selector_matches,
    class_words_has,
    class_has_all,
    unquote_css_attr_value
}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{
    renderer_default_style
}

use std.spec.step

describe "core.spl: _css_root_prefix_is_preamble":
    it "accepts an empty/whitespace-only prefix":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: accepts an empty/whitespace-only prefix")
        expect(_css_root_prefix_is_preamble("")).to_equal(true)
        expect(_css_root_prefix_is_preamble("   ")).to_equal(true)

    it "accepts a comment-only preamble":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: accepts a comment-only preamble")
        expect(_css_root_prefix_is_preamble("/* c */")).to_equal(true)

    it "accepts an at-rule preamble terminated by ;":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: accepts an at-rule preamble terminated by ;")
        expect(_css_root_prefix_is_preamble("@media screen;")).to_equal(true)

    it "rejects an at-rule preamble whose { comes before ;":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects an at-rule preamble whose ( comes before ;")
        expect(_css_root_prefix_is_preamble("@media screen{")).to_equal(false)

    it "rejects a non-comment non-at-rule prefix":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a non-comment non-at-rule prefix")
        expect(_css_root_prefix_is_preamble("body ")).to_equal(false)

    it "rejects an unterminated comment":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects an unterminated comment")
        expect(_css_root_prefix_is_preamble("/* unterminated")).to_equal(false)

describe "core.spl: _is_interaction_state_pseudo":
    it "recognizes every unconditional interaction pseudo-class":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: recognizes every unconditional interaction pseudo-class")
        expect(_is_interaction_state_pseudo("hover", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("active", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("focus", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("focus-visible", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("focus-within", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("visited", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("target", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("checked", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("placeholder-shown", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("autofill", "")).to_equal(true)

    it "treats :disabled as interaction-state only when the disabled attr is absent":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: treats :disabled as interaction-state only when the disabled attr is absent")
        expect(_is_interaction_state_pseudo("disabled", "")).to_equal(true)
        expect(_is_interaction_state_pseudo("disabled", "disabled")).to_equal(false)

    it "rejects an unknown pseudo-class name":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects an unknown pseudo-class name")
        expect(_is_interaction_state_pseudo("nth-child", "")).to_equal(false)

describe "core.spl: _nth_child_matches":
    it "matches the odd/even keywords":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches the odd/even keywords")
        expect(_nth_child_matches("odd", 1)).to_equal(true)
        expect(_nth_child_matches("odd", 2)).to_equal(false)
        expect(_nth_child_matches("even", 2)).to_equal(true)
        expect(_nth_child_matches("even", 3)).to_equal(false)

    it "matches an+b with positive a":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches an+b with positive a")
        # 2n+1 -> 1, 3, 5, ...
        expect(_nth_child_matches("2n+1", 1)).to_equal(true)
        expect(_nth_child_matches("2n+1", 2)).to_equal(false)
        expect(_nth_child_matches("2n+1", 5)).to_equal(true)

    it "matches n+b with implicit a=1":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches n+b with implicit a=1")
        expect(_nth_child_matches("n+3", 3)).to_equal(true)
        expect(_nth_child_matches("n+3", 2)).to_equal(false)

    it "matches -n+b with implicit a=-1":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches -n+b with implicit a=-1")
        # -n+3: rem = pos - 3; rem < 0 -> false (pos=2); rem >= 0 -> true
        # (any rem is divisible by -1, so pos=3 and above all match)
        expect(_nth_child_matches("-n+3", 3)).to_equal(true)
        expect(_nth_child_matches("-n+3", 2)).to_equal(false)

    it "matches a plain integer b":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches a plain integer b")
        expect(_nth_child_matches("3", 3)).to_equal(true)
        expect(_nth_child_matches("3", 4)).to_equal(false)

    it "rejects a negative remainder (rem < 0) case for an+b with a<>0":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a negative remainder (rem < 0) case for an+b with a<>0")
        # 2n+5, pos=1 -> rem = 1-5 = -4 < 0 -> false
        expect(_nth_child_matches("2n+5", 1)).to_equal(false)

describe "core.spl: _part_specificity":
    it "scores an id selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores an id selector")
        # #foo -> 100
        expect(_part_specificity("#foo", 0)).to_equal(100)

    it "scores an id.class compound selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores an id.class compound selector")
        # #foo.bar -> 110
        expect(_part_specificity("#foo.bar", 0)).to_equal(110)

    it "scores a single class selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a single class selector")
        expect(_part_specificity(".bar", 0)).to_equal(10)

    it "scores a multi-class compound selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a multi-class compound selector")
        # .a.b.c -> 3 classes * 10 = 30
        expect(_part_specificity(".a.b.c", 0)).to_equal(30)

    it "scores a bare tag selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a bare tag selector")
        expect(_part_specificity("div", 0)).to_equal(1)

    it "scores the universal selector as zero":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores the universal selector as zero")
        expect(_part_specificity("*", 0)).to_equal(0)

    it "scores a tag.class compound selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a tag.class compound selector")
        # div.a.b -> 1 + 2*10 = 21
        expect(_part_specificity("div.a.b", 0)).to_equal(21)

    it "scores a tag#id compound selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a tag#id compound selector")
        # div#foo -> 101 (no dot after hash)
        expect(_part_specificity("div#foo", 0)).to_equal(101)

    it "scores a tag#id.class compound selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: scores a tag#id.class compound selector")
        # div#foo.bar -> 111
        expect(_part_specificity("div#foo.bar", 0)).to_equal(111)

    it "adds 10 per [attr] selector":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: adds 10 per [attr] selector")
        # div[disabled] -> 1 + 10 = 11
        expect(_part_specificity("div[disabled]", 0)).to_equal(11)

    it "adds 10 per plain pseudo-class":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: adds 10 per plain pseudo-class")
        # div:hover -> 1 + 10 = 11
        expect(_part_specificity("div:hover", 0)).to_equal(11)

    it "adds 10 for a :nth-child(...) functional pseudo-class":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: adds 10 for a :nth-child(...) functional pseudo-class")
        # div:nth-child(2n+1) -> 1 + 10 = 11
        expect(_part_specificity("div:nth-child(2n+1)", 0)).to_equal(11)

    it "returns the max-option specificity for :is()":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns the max-option specificity for :is()")
        # div:is(#a, .b) -> base 1 + max(100, 10) = 101
        expect(_part_specificity("div:is(#a, .b)", 0)).to_equal(101)

    it "rejects a malformed pseudo-class chain (bare colon with no name)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a malformed pseudo-class chain (bare colon with no name)")
        expect(_part_specificity("div:", 0)).to_equal(-1000000)

    it "rejects an unknown functional pseudo-class name":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects an unknown functional pseudo-class name")
        expect(_part_specificity("div:unknown-fn(x)", 0)).to_equal(-1000000)

    it "rejects recursion beyond depth 32":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects recursion beyond depth 32")
        expect(_part_specificity("div", 33)).to_equal(-1000000)

describe "core.spl: _group_specificity":
    it "sums per-part specificity, skipping empty and combinator parts":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: sums per-part specificity, skipping empty and combinator parts")
        # ["div", "", ">", ".a"] -> 1 + 0 + 0 + 10 = 11
        val parts: [text] = ["div", "", ">", ".a"]
        expect(_group_specificity(parts, 0)).to_equal(11)  # oracle: 11 — named expected value from the requirement

    it "propagates a malformed-part failure as -1000000":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: propagates a malformed-part failure as -1000000")
        val parts: [text] = ["div:"]
        expect(_group_specificity(parts, 0)).to_equal(-1000000)  # oracle: -1000000 — named expected value from the requirement

    it "rejects recursion beyond depth 32":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects recursion beyond depth 32")
        val parts: [text] = ["div"]
        expect(_group_specificity(parts, 33)).to_equal(-1000000)  # oracle: -1000000 — named expected value from the requirement

describe "core.spl: _sort_candidates_by_specificity":
    it "returns the input unchanged for 0 or 1 candidates":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns the input unchanged for 0 or 1 candidates")
        val empty: [i32] = []
        val specs: [i32] = []
        expect(_sort_candidates_by_specificity(empty, specs).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val one: [i32] = [5]
        val one_specs: [i32] = [10, 20, 30, 40, 50, 60]
        val sorted_one = _sort_candidates_by_specificity(one, one_specs)
        expect(sorted_one[0]).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "sorts candidates ascending by specificity, tie-broken by index":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: sorts candidates ascending by specificity, tie-broken by index")
        # candidate 0 spec=30, candidate 1 spec=10, candidate 2 spec=30, candidate 3 spec=20
        val candidates: [i32] = [0, 1, 2, 3]
        val specs: [i32] = [30, 10, 30, 20]
        val sorted = _sort_candidates_by_specificity(candidates, specs)
        # expected order: 1 (10), 3 (20), 0 (30, index 0<2), 2 (30, index 2)
        expect(sorted[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(sorted[1]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(sorted[2]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(sorted[3]).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "sorts a longer list spanning multiple merge widths":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: sorts a longer list spanning multiple merge widths")
        val candidates: [i32] = [0, 1, 2, 3, 4, 5, 6, 7]
        val specs: [i32] = [80, 70, 60, 50, 40, 30, 20, 10]
        val sorted = _sort_candidates_by_specificity(candidates, specs)
        expect(sorted[0]).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(sorted[7]).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "core.spl: z-index and style-order merge sorts":
    it "returns empty for count <= 0":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns empty for count <= 0")
        val idx: [i32] = []
        val styles: [gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.Style] = []
        expect(_sort_positive_z_indices(idx, 0, styles).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_sort_style_order_indices(idx, 0, styles).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "sorts indices ascending by z_index, tie-broken by index":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: sorts indices ascending by z_index, tie-broken by index")
        var s0 = renderer_default_style()
