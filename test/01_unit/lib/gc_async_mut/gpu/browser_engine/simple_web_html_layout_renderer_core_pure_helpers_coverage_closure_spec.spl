        var s1 = renderer_default_style()
        s1.z_index = 10
        var s2 = renderer_default_style()
        s2.z_index = 30
        var s3 = renderer_default_style()
        s3.z_index = 20
        val styles = [s0, s1, s2, s3]
        val idx: [i32] = [0, 1, 2, 3]
        val sorted = _sort_positive_z_indices(idx, 4, styles)
        expect(sorted[0]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(sorted[1]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(sorted[2]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(sorted[3]).to_equal(2)  # oracle: 2 — named expected value from the requirement

