# Purpose: fb_rect / fb_rect_clip are the renderer's busiest primitives — every
# solid background, all four border sides, outlines, underlines and form
# controls reach one of them, over the whole viewport, several times a frame.
# Both ran one interpreted store per pixel and now build ONE native row and
# bulk-write it per line. A constant fill deliberately has no span-kernel path
# (the extern round trip was measured slower than the stores it replaces), so
# `write_span` is the mechanism.
#
# Measured 1920x384 full-viewport fill: 1963 ms -> 33 ms, output identical.
# @req REQ-SSPEC-LIB

use std.spec.step
use std.spec.{describe, it, assert_equal}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_primitives.{
    fb_fill_rows_const, _scalar_fill_rows_const
}

fn ramp(n: i64) -> [u32]:
    var b: [u32] = []
    var i: i64 = 0
    while i < n:
        b.push((0xFF000000u32 | ((i * 7 + 3) as u32)))
        i = i + 1
    b

fn fbs_equal(a: [u32], b: [u32]) -> bool:
    if a.len() != b.len():
        return false
    var i: i64 = 0
    while i < a.len():
        if a[i.to_i32()] != b[i.to_i32()]:
            return false
        i = i + 1
    true

fn pair_matches(fbw: i64, fbh: i64, x0: i64, y0: i64, x1: i64, y1: i64, color: u32) -> bool:
    val total = fbw * fbh
    val t = fb_fill_rows_const(ramp(total), fbw.to_i32(), x0.to_i32(), y0.to_i32(), x1.to_i32(), y1.to_i32(), color)
    val s = _scalar_fill_rows_const(ramp(total), fbw.to_i32(), x0.to_i32(), y0.to_i32(), x1.to_i32(), y1.to_i32(), color)
    fbs_equal(t, s)

describe "solid fill row template matches its scalar twin":
    it "matches for a full-width, full-height fill":
        step("the whole-viewport background case")
        assert_equal(pair_matches(32, 8, 0, 0, 32, 8, 0xFF3366CCu32), true)

    it "matches for sub-rects that do not start at x = 0 or y = 0":
        step("a stride bug cannot hide behind an origin-anchored rect")
        assert_equal(pair_matches(32, 8, 5, 2, 27, 6, 0xFF10A0F0u32), true)
        assert_equal(pair_matches(64, 10, 1, 1, 2, 9, 0xFF10A0F0u32), true)

    it "matches for widths straddling the 16-lane AVX-512 u32 boundary":
        step("the row is built natively; its width must not change results")
        var bad = 0
        var w = 1
        while w <= 40:
            if not pair_matches(48, 4, 3, 1, 3 + w, 3, 0xFF884422u32):
                bad = bad + 1
            w = w + 1
        assert_equal(bad, 0)

    it "matches for single-row and single-column rects":
        step("borders and underlines are exactly these degenerate shapes")
        assert_equal(pair_matches(32, 8, 4, 3, 28, 4, 0xFFAABBCCu32), true)
        assert_equal(pair_matches(32, 8, 4, 1, 5, 7, 0xFFAABBCCu32), true)

    it "leaves the framebuffer untouched for an empty rect":
        step("a zero or inverted extent must be a no-op, not a partial write")
        val total: i64 = 32 * 8
        val before = ramp(total)
        assert_equal(fbs_equal(fb_fill_rows_const(ramp(total), 32, 4, 2, 4, 6, 0xFF000000u32), before), true)
        assert_equal(fbs_equal(fb_fill_rows_const(ramp(total), 32, 4, 2, 2, 6, 0xFF000000u32), before), true)
        assert_equal(fbs_equal(fb_fill_rows_const(ramp(total), 32, 4, 6, 20, 6, 0xFF000000u32), before), true)

    it "writes nothing outside the rect":
        step("the row kernel must not run past x1 or spill into the next line")
        val fbw: i64 = 24
        val fbh: i64 = 10
        val total = fbw * fbh
        val before = ramp(total)
        val out = fb_fill_rows_const(ramp(total), fbw.to_i32(), 6, 3, 18, 8, 0xFF123456u32)
        var leaked = 0
        var row: i64 = 0
        while row < fbh:
            var col: i64 = 0
            while col < fbw:
                val inside = row >= 3 and row < 8 and col >= 6 and col < 18
                val idx = (row * fbw + col).to_i32()
                if not inside and out[idx] != before[idx]:
                    leaked = leaked + 1
                if inside and out[idx] != 0xFF123456u32:
                    leaked = leaked + 1
                col = col + 1
            row = row + 1
        assert_equal(leaked, 0)
