# Correctness + proportionality coverage for the invalidation-set layer
# built on top of SelectorRuleIndex (style_invalidation.spl).
#
# Correctness requirement: after a subset of nodes have their id/class
# mutated and the mutation is reported via invalidate_node_discriminant_change,
# apply_css_rules_to_tree_invalidated (using the memoized/dirty-tracked
# incremental path) must style every node IDENTICALLY to a from-scratch full
# re-match of the same mutated tree using style_block.spl's own
# apply_css_rules_to_tree_linear as the ground-truth oracle.
#
# Proportionality requirement: when only a handful of nodes in a larger tree
# are mutated, the invalidation pass must re-match strictly fewer nodes than
# the tree size (observable via InvalidationState.rematch_count) — otherwise
# it is a full rebuild with extra bookkeeping, not real invalidation.
#
# NOTE on the oracle choice: style_block.spl's apply_rules_to_node /
# apply_rules_to_node_indexed (used by apply_css_rules_to_tree_linear and
# apply_css_rules_to_tree) used to call be_dom_set_children(node, new_kids)
# as a bare statement and discard its return value, so a re-styled child's
# descendants never got written back into the tree. That write-back bug has
# since been fixed (be_dom_set_children's return value is now threaded
# through apply_rules_to_node / apply_rules_to_node_indexed as the function's
# return value, verified independently by
# style_block_descendant_writeback_spec.spl), so apply_css_rules_to_tree_linear
# is now safe to use as this spec's correctness oracle.
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/style_invalidation.spl
use std.spec.{describe, it, expect}

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_children, be_dom_set_children}
use std.gc_async_mut.gpu.browser_engine.style_block.{CssRule, CssDecl, build_selector_rule_index, apply_css_rules_to_tree_linear}
use std.gc_async_mut.gpu.browser_engine.style_invalidation.{
    new_invalidation_state, apply_css_rules_to_tree_invalidated,
    invalidate_node_discriminant_change}

fn el(node_id: i64, tag: text, id: text, class_val: text) -> BeDomNode:
    var attrs: Dict<text, text> = {}
    if id != "":
        attrs["id"] = id
    if class_val != "":
        attrs["class"] = class_val
    BeDomNode(
        node_id: node_id,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: [],
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

fn el_children(node_id: i64, tag: text, id: text, class_val: text, kids: [BeDomNode]) -> BeDomNode:
    var attrs: Dict<text, text> = {}
    if id != "":
        attrs["id"] = id
    if class_val != "":
        attrs["class"] = class_val
    BeDomNode(
        node_id: node_id,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: kids,
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

fn decl(prop: text, value: text) -> CssDecl:
    CssDecl(property: prop, value: value)

fn rule(selector: text, prop: text, value: text) -> CssRule:
    CssRule(selector: selector, declarations: [decl(prop, value)])

fn colors_flat(root: BeDomNode) -> [text]:
    """Collects color + background-color of root then every descendant, DFS order."""
    var out: [text] = [root.style.color, root.style.background_color]
    val kids = be_dom_get_children(root)
    var i = 0
    while i < kids.len():
        val sub = colors_flat(kids[i])
        var j = 0
        while j < sub.len():
            out.push(sub[j])
            j = j + 1
        i = i + 1
    out

fn count_nodes(root: BeDomNode) -> i64:
    var n = 1
    val kids = be_dom_get_children(root)
    var i = 0
    while i < kids.len():
        n = n + count_nodes(kids[i])
        i = i + 1
    n

# Builds a tree of `width` groups of 4 leaf nodes each, i.e. 1 + width*(1+4)
# nodes total.
fn build_wide_tree(width: i32) -> BeDomNode:
    var groups: [BeDomNode] = []
    var g = 0
    var next_id = 1000
    while g < width:
        val a = el(next_id, "span", "", "leaf tag-a")
        next_id = next_id + 1
        val b = el(next_id, "p", "", "leaf tag-b group-" + g.to_text())
        next_id = next_id + 1
        val c = el(next_id, "em", "", "leaf tag-c")
        next_id = next_id + 1
        val d = el(next_id, "i", "", "leaf tag-d")
        next_id = next_id + 1
        val group = el_children(next_id, "div", "", "group", [a, b, c, d])
        next_id = next_id + 1
        groups.push(group)
        g = g + 1
    el_children(0, "section", "root", "", groups)

# The interpreter copies class instances on array index/push, so a fetched
# child is a detached copy: mutating it does nothing to the real tree unless
# the change is written back through be_dom_set_children (itself a pure
# constructor, see the module note above) at every level up to the root, and
# the caller must use the RETURNED root from then on.
fn mutate_leaf_class(root: BeDomNode, group_idx: i32, leaf_idx: i32, new_class: text) -> BeDomNode:
    val groups = be_dom_get_children(root)
    var group = groups[group_idx]
    val leaves = be_dom_get_children(group)
    var leaf = leaves[leaf_idx]
    leaf.attributes["class"] = new_class
    var new_leaves: [BeDomNode] = []
    var i = 0
    while i < leaves.len():
        if i == leaf_idx:
            new_leaves.push(leaf)
        else:
            new_leaves.push(leaves[i])
        i = i + 1
    val updated_group = be_dom_set_children(group, new_leaves)
    var new_groups: [BeDomNode] = []
    var j = 0
    while j < groups.len():
        if j == group_idx:
            new_groups.push(updated_group)
        else:
            new_groups.push(groups[j])
        j = j + 1
    be_dom_set_children(root, new_groups)

val rules: [CssRule] = [
    rule("*", "background-color", "gray"),
    rule("div", "background-color", "blue"),
    rule(".tag-b", "color", "green"),
    rule(".group-3", "color", "yellow"),
    rule(".retargeted", "color", "purple"),
    rule("section .leaf", "background-color", "orange")]

describe "style invalidation correctness":

    it "matches a from-scratch full re-match after mutating one node's class":
        var tree_gt = build_wide_tree(6)
        var tree_inv = build_wide_tree(6)
        val idx = build_selector_rule_index(rules)

        # Establish baseline: full pass on both trees first (the shared
        # apply_css_rules_to_tree_linear is the ground-truth oracle, run
        # fresh from scratch every time it's used).
        tree_gt = apply_css_rules_to_tree_linear(tree_gt, rules)
        var state = new_invalidation_state()
        tree_inv = apply_css_rules_to_tree_invalidated(tree_inv, rules, idx, state)
        expect(colors_flat(tree_inv)).to_equal(colors_flat(tree_gt))

        # Mutate one leaf's class in both trees (group 2, node b -> add "retargeted").
        val old_class = "leaf tag-b group-2"
        val new_class = "leaf tag-b group-2 retargeted"
        tree_gt = mutate_leaf_class(tree_gt, 2, 1, new_class)
        tree_inv = mutate_leaf_class(tree_inv, 2, 1, new_class)
        invalidate_node_discriminant_change(
            state, idx,
            "p", "", old_class.split(" "),
            "p", "", new_class.split(" "))

        # Ground truth: full re-match from scratch via the shared oracle.
        tree_gt = apply_css_rules_to_tree_linear(tree_gt, rules)
        # Invalidation-aware path: reuses memoized state, should only
        # re-match the mutated node (and any node in the buckets it moved
        # between) yet must still reach the SAME final styling.
        tree_inv = apply_css_rules_to_tree_invalidated(tree_inv, rules, idx, state)

        expect(colors_flat(tree_inv)).to_equal(colors_flat(tree_gt))

describe "style invalidation proportionality":

    it "re-matches far fewer nodes than the tree size when only 2 of many nodes mutate":
        var tree = build_wide_tree(20)
        val total_nodes = count_nodes(tree)
        val idx = build_selector_rule_index(rules)
        var state = new_invalidation_state()

        tree = apply_css_rules_to_tree_invalidated(tree, rules, idx, state)
        expect(state.rematch_count).to_equal(total_nodes)

        tree = mutate_leaf_class(tree, 0, 1, "leaf tag-b group-0 retargeted")
        tree = mutate_leaf_class(tree, 5, 1, "leaf tag-b group-5 retargeted")
        invalidate_node_discriminant_change(
            state, idx,
            "p", "", "leaf tag-b group-0".split(" "),
            "p", "", "leaf tag-b group-0 retargeted".split(" "))
        invalidate_node_discriminant_change(
            state, idx,
            "p", "", "leaf tag-b group-5".split(" "),
            "p", "", "leaf tag-b group-5 retargeted".split(" "))

        state.rematch_count = 0
        tree = apply_css_rules_to_tree_invalidated(tree, rules, idx, state)

        expect(state.rematch_count).to_be_less_than(total_nodes)
        # 21 nodes (root + 20 groups) touch the universal bucket regardless
        # (universal always applies), so real proportionality is checked
        # against re-matching every leaf, not just "less than everything".
        val total_leaves = 20 * 4
        expect(state.rematch_count).to_be_less_than(total_leaves)
