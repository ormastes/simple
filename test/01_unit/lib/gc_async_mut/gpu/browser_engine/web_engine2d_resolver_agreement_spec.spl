# Purpose and audience: executable regression specification proving that the
# web-render facade, SimpleWebRenderer, SimpleWebEngine2DRenderer, and
# SimpleWebEngine2DStaticPixelCache resolve Engine2D backends through one path
# and report the backend that actually produced the frame.
# @req REQ-SSPEC-LIB
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_engine2d_renderer.spl 80%
# @tag: unit, browser_engine, engine2d, backend, resolver

use std.spec.{describe, it, expect, step}
use std.env.variables.{env_set}
use common.ui.web_render_api.{
    WEB_RENDER_QUEUE_STATUS_DRAINED,
    WEB_RENDER_TARGET_PURE_SIMPLE,
    web_render_adapter_request
}
use std.gc_async_mut.ui.web_render_pixel_backend.{
    web_render_resolved_engine2d_backend_name,
    web_render_html_request_to_pixel_artifact_with_backend
}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_resolved_engine2d_backend_name,
    simple_web_render_html_to_readback_result_with_engine2d_backend
}
use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    SimpleWebEngine2DStaticPixelCache,
    SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC,
    simple_web_engine2d_resolved_backend_name,
    simple_web_engine2d_render_html_readback,
    simple_web_engine2d_render_html_presentable
}

val TEST_HTML: text = "<!doctype html><html><body style=\"background:#224466\"><div style=\"width:20px;height:12px;background:#ddeeff\">hi</div></body></html>"

describe "Web Engine2D unified backend resolver agreement":
    it "facade, SimpleWebRenderer, and Engine2D renderer agree under SIMPLE_2D_PROBE_FAULT=vulkan":
        step("Inject SIMPLE_2D_PROBE_FAULT=vulkan and verify every entry resolves to software without GPU queue claims")
        env_set("SIMPLE_2D_PROBE_FAULT", "vulkan")
        val r_facade = web_render_resolved_engine2d_backend_name(64, 48, "vulkan")
        val r_web = simple_web_resolved_engine2d_backend_name(64, 48, "vulkan")
        val r_eng = simple_web_engine2d_resolved_backend_name(64, 48, "vulkan")
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Resolver", "<main><p>ok</p></main>", "", "", 64, 48).with_pixel_output()
        val artifact = web_render_html_request_to_pixel_artifact_with_backend(req, TEST_HTML, "vulkan")
        val readback = simple_web_engine2d_render_html_readback(TEST_HTML, 64, 48, "vulkan")
        env_set("SIMPLE_2D_PROBE_FAULT", "")

        expect(r_facade).to_equal("software")
        expect(r_web).to_equal("software")
        expect(r_eng).to_equal("software")
        expect(artifact.engine2d_backend).to_equal("software")
        expect(artifact.queue_drain_status == WEB_RENDER_QUEUE_STATUS_DRAINED).to_equal(false)
        expect(artifact.gpu_readback_source == "device_readback").to_equal(false)
        expect(readback.source).to_equal("cpu_mirror")

    it "facade reports actual executed backend when create falls back after a healthy probe":
        step("Inject SIMPLE_2D_CREATE_FAULT=cpu_simd so probe predicts cpu_simd while create falls back to cpu")
        env_set("SIMPLE_2D_CREATE_FAULT", "cpu_simd")
        val result = simple_web_render_html_to_readback_result_with_engine2d_backend(TEST_HTML, 64, 48, "cpu_simd")
        val req = web_render_adapter_request(WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Resolver", "<main><p>ok</p></main>", "", "", 64, 48).with_pixel_output()
        val artifact = web_render_html_request_to_pixel_artifact_with_backend(req, TEST_HTML, "cpu_simd")
        env_set("SIMPLE_2D_CREATE_FAULT", "")

        expect(result.resolved_backend).to_equal("cpu")
        expect(artifact.engine2d_backend).to_equal("cpu")
        expect(artifact.pixels.len()).to_equal(64 * 48)

    it "SimpleWebEngine2DStaticPixelCache resolves once at create and does not re-probe per render":
        step("Create cache cleanly, inject probe fault afterwards, and verify result_for_html keeps the create resolution")
        var cache = SimpleWebEngine2DStaticPixelCache.create(64, 48, "cpu_simd")
        expect(cache.resolved_backend).to_equal("cpu_simd")
        env_set("SIMPLE_2D_PROBE_FAULT", "cpu_simd")
        val r = cache.result_for_html(TEST_HTML, SIMPLE_WEB_PIXEL_CACHE_MODE_UNTIMED_STATIC, 1)
        env_set("SIMPLE_2D_PROBE_FAULT", "")

        expect(r.resolved_backend).to_equal("cpu_simd")
        expect(r.readback.pixels.len()).to_equal(64 * 48)

    it "zero-size viewports leave executed resolved_backend empty and render_html_presentable completes cleanly":
        val r0 = simple_web_render_html_to_readback_result_with_engine2d_backend(TEST_HTML, 0, 48, "auto")
        val rb0 = simple_web_engine2d_render_html_readback(TEST_HTML, 0, 48, "auto")
        val pf = simple_web_engine2d_render_html_presentable("<div>ok</div>", 64, 48, "cpu_simd")

        expect(r0.resolved_backend).to_equal("")
        expect(rb0.source).to_equal("not_requested")
        expect(pf.pixels.len()).to_equal(64 * 48)
