        # Chrome 159 paints 8px Liberation text with AA ink only: 0 exact #111827
        # pixels, 244 ink pixels (measured 2026-11-15). The old exact-colour pin
        # described the upscaled 5x7 bitmap face, so ink is what is asserted.
        expect(_ink_near_chrome(_count_non_color_rect(right_pixels, 80, 0, 0, 80, 48, 0xFFFFFFFFu32), 244)).to_equal(true)
