        expect(_draw_ir_style_value(card, "left")).to_equal("7")
        expect(_draw_ir_style_value(card, "top")).to_equal("9")
        expect(_draw_ir_style_value(card, "right")).to_equal("10")
        expect(_draw_ir_style_value(card, "bottom")).to_equal("6")
        # Chrome 159 (chrome-headless-shell 159.0.8154.6, this exact `html`
        # with `--dump-dom` and `getBoundingClientRect()` of #card, captured
        # 2026-11-15): card 7,9 8x6 -- with both insets and a definite size
        # the box is over-constrained and right/bottom are ignored (CSS 2.2
        # 10.3.7 / 10.6.4). The old pins (22, 12) were the right/bottom-wins
        # positions, not a Chrome measurement. Probes: (x 7, y 12) is inside
        # the card (rows 9..14, columns 7..14) and (x 6, y 12) is the panel
        # just left of it.
        expect(card.x).to_equal(7)
        expect(card.y).to_equal(9)
        expect(pixels[12 * 48 + 7]).to_equal(0xFF1D4ED8u32)
        expect(pixels[12 * 48 + 6]).to_equal(0xFFE5E7EBu32)

