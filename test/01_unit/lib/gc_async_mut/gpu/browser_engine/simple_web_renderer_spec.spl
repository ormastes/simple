        val raster_scroll = simple_web_layout_render_html_software_pixels(scroll_page, 40, 64)
        val cpu_scroll = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(scroll_page, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(raster_svg, cpu_svg)).to_equal(0)
        expect(_pixel_mismatches(raster_input, cpu_input)).to_equal(0)
        expect(_pixel_mismatches(raster_scroll, cpu_scroll)).to_equal(0)
        expect(cpu_svg[13 * 40 + 8]).to_equal(0xFFF5F5F5u32)
        expect(cpu_input[15 * 40 + 13]).to_equal(0xFFF5F5F5u32)
        expect(cpu_scroll[8 * 40 + 23]).to_equal(0xFFF5F5F5u32)
        expect(_count_color(cpu_svg, 0xFFFF0000u32)).to_equal(0)
        # Outside widget mode (a <style> element) Draw IR paints all three.
        val styled_svg = "<html><head><style></style></head><body><section class='widget-panel'><svg width='20' height='10'><rect width='20' height='10' fill='#ff0000'></rect></svg></section></body></html>"
        val styled_input = "<html><head><style></style></head><body><section class='widget-panel'><input type='text' value='ABCD'></section></body></html>"
        val styled_scroll = "<html><head><style></style></head><body><div style='overflow-y:scroll;height:20px;width:30px'></div><section class='widget-panel'></section></body></html>"
        val cpu_styled_svg = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_svg, 40, 64, "cpu_simd")
        val cpu_styled_input = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_input, 40, 64, "cpu_simd")
        val cpu_styled_scroll = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_scroll, 40, 64, "cpu_simd")
        val raster_styled_svg = simple_web_layout_render_html_software_pixels(styled_svg, 40, 64)
