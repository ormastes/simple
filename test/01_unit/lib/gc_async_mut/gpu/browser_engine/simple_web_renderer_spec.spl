    it "preserves supported Engine2D backend names before runtime fallback":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "preserves supported Engine2D backend names before runtime fallback"
        step("Verify: preserves supported Engine2D backend names before runtime fallback")
        expect(SimpleWebRenderer.create_with_backend(96, 64, "auto").backend_name).to_equal(simple_web_resolved_engine2d_backend_name(96, 64, "auto"))
        expect(_backend_name_kept_or_software(SimpleWebRenderer.create_with_backend(96, 64, "cuda").backend_name, "cuda")).to_equal(true)
        expect(_backend_name_kept_or_software(SimpleWebRenderer.create_with_backend(96, 64, "hip").backend_name, "rocm")).to_equal(true)
        expect(_backend_name_kept_or_software(SimpleWebRenderer.create_with_backend(96, 64, "opencl").backend_name, "opencl")).to_equal(true)
        expect(_vulkan_name_ok(SimpleWebRenderer.create_with_backend(96, 64, "vulkan").backend_name)).to_equal(true)
        expect(_backend_name_kept_or_software(SimpleWebRenderer.create_with_backend(96, 64, "metal").backend_name, "metal")).to_equal(true)
        expect(SimpleWebRenderer.create_with_backend(96, 64, "cpu_simd").backend_name).to_equal("cpu_simd")
        expect(SimpleWebRenderer.create_with_backend(96, 64, "simd_cpu").backend_name).to_equal("cpu_simd")
        # Alias canonicalization is host-independent even where the backend is absent.
        expect(backend_canonical_name("hip")).to_equal("rocm")
        expect(_backend_resolution_is_honest("cuda", "cuda")).to_equal(true)
        expect(_backend_resolution_is_honest("hip", "rocm")).to_equal(true)
        expect(_backend_resolution_is_honest("opencl", "opencl")).to_equal(true)
        expect(_vulkan_resolution_ok()).to_equal(true)
        expect(_backend_resolution_is_honest("metal", "metal")).to_equal(true)
        expect(simple_web_resolved_engine2d_backend_name(96, 64, "cpu_simd")).to_equal("cpu_simd")

