        val svg_page = "<html><body><section class='widget-panel'><svg width='20' height='10'><rect width='20' height='10' fill='#ff0000'></rect></svg></section></body></html>"
        val input_page = "<html><body><section class='widget-panel'><input type='text' value='ABCD'></section></body></html>"
        val scroll_page = "<html><body><div style='overflow-y:scroll;height:20px;width:30px'></div><section class='widget-panel'></section></body></html>"
        val raster_svg = simple_web_layout_render_html_software_pixels(svg_page, 40, 64)
