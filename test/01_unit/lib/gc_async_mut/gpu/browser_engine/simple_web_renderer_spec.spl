        # @capture(gui_image): retained evidence for scenario "matches Chrome background shorthand fallback and declaration order"
        step("Verify: matches Chrome background shorthand fallback and declaration order")
        val html = "<html><head><style>html,body{margin:0;padding:0;width:96px;height:64px;overflow:hidden;background-color:#f8fafc}.shell{background:url(hero.png) #dbeafe no-repeat;padding:4px;width:88px;height:56px}.rgb{background:rgb(34,197,94) no-repeat;width:20px;height:10px}.later-bg{background-color:#ef4444;background:#1d4ed8;width:18px;height:8px;margin-top:4px}.later-bg-color{background:#f59e0b;background-color:#334155;width:16px;height:8px;margin-top:4px}</style></head><body><section class='shell'><div class='rgb'></div><div class='later-bg'></div><div class='later-bg-color'></div></section></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 96, 64)
        expect(pixels.len()).to_equal(96 * 64)
        expect(_count_color(pixels, 0xFFDBEAFEu32)).to_equal(5672)  # oracle: 5672 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFF22C55Eu32)).to_equal(200)  # oracle: 200 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFF1D4ED8u32)).to_equal(144)  # oracle: 144 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFF334155u32)).to_equal(128)  # oracle: 128 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFFEF4444u32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFFF59E0Bu32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

    it "paints famous-site corpus block geometry with Chrome default body margin":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "paints famous-site corpus block geometry with Chrome default body margin"
        step("Verify: paints famous-site corpus block geometry with Chrome default body margin")
        val html = "<html><body><div data-font-corpus=\"known-site-fonts\" style='width: 120px; height: 40px; background-color: #7c3aed; font-family: \"IBM Plex Sans\", Arial, sans-serif'>Twitch commerce deterministic compatibility fixture</div></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 160, 120)
        expect(pixels.len()).to_equal(160 * 120)
        expect(pixels[7 + 7 * 160]).to_equal(0xFFFFFFFFu32)
        expect(pixels[8 + 8 * 160]).to_equal(0xFF7C3AEDu32)
        expect(pixels[127 + 47 * 160]).to_equal(0xFF7C3AEDu32)
        expect(pixels[128 + 48 * 160]).to_equal(0xFFFFFFFFu32)
        # Text probe, re-derived 2026-11-14 from Chrome 159 (160x120, scale 1):
        # (9,10) is the top bar of the "T" (rows 10-11, x 7..17) and is
        # 0xFF000000 in Chrome. This example was written with that value
        # (f21f5ec711d); ff2dc6ed375 flipped it to the block colour when the
        # pasted Chrome pixels moved to the fixture renderer and this renderer
        # painted no text at all. It paints real glyphs now, and a family list
        # whose first name is unavailable resolves to Arial like Chrome's.
        expect(pixels[9 + 10 * 160]).to_equal(0xFF000000u32)
        # (32,93): ff2dc6ed375 had pinned it to white ("no text"). Chrome 159
        # has glyph ink there (fifth line, rows 82-93). The line rows are
        # pinned in test/01_unit/browser_engine/
        # wrapped_line_advance_normal_line_height_spec.spl; Chrome's exact
        # 0xFF000000 is in the in-development
        # corpus_fifth_line_exact_pixel_spec.spl (rasterizer edge coverage).

    it "keeps exact Twitch corpus pixels in the fixture renderer":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "keeps exact Twitch corpus pixels in the fixture renderer"
        step("Verify: keeps exact Twitch corpus pixels in the fixture renderer")
        val html = "<html><body><div data-font-corpus=\"known-site-fonts\" style='width: 120px; height: 40px; background-color: #7c3aed; font-family: \"IBM Plex Sans\", Arial, sans-serif'>Twitch commerce deterministic compatibility fixture</div></body></html>"
        val pixels = simple_web_render_html_to_pixels_with_corpus_fixtures(html, 160, 120)
        expect(pixels.len()).to_equal(160 * 120)
        expect(pixels[9 + 10 * 160]).to_equal(0xFF000000u32)
        expect(pixels[52 + 14 * 160]).to_equal(0xFF4930E5u32)
        expect(pixels[32 + 93 * 160]).to_equal(0xFF000000u32)

