        )

    it "projects a complete WM Web material request with explicit bounded realization":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "projects a complete WM Web material request with explicit bounded realization"
        step("Verify: projects a complete WM Web material request with explicit bounded realization")
        val html = "<html><body><section id='card' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' style='display:block;width:12px;height:8px;background:linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.025)),rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)'></section></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(html, 32, 20)
        val card = _draw_ir_command_by_id(composition.batches[0].commands, "card")

        expect(card.color).to_equal(0xFF123456u32)
        expect(_draw_ir_style_value(card, "background-color")).to_equal("3424591649")
        expect(_draw_ir_style_value(card, "backdrop-filter")).to_equal("blur(30px) saturate(170%)")
        expect(_draw_ir_style_value(card, "backdrop-filter-capability")).to_equal("engine2d-cpu-composited-material-v1")
        expect(_draw_ir_style_value(card, "backdrop-filter-realized")).to_equal("blur(4px) saturate(170%)")
        expect(_draw_ir_style_value(card, "backdrop-filter-realized-blur-radius-px")).to_equal("4")
        expect(_draw_ir_style_value(card, "backdrop-filter-realized-saturation-milli")).to_equal("1700")
        expect(_draw_ir_style_value(card, "backdrop-filter-reduction-reason")).to_equal("cpu-blur-radius-bounded-to-4")
        # Surface OPACITY in per-mille: 0.80 -> alpha 0xCC (204, the same
        # alpha "background-color" 3424591649 = 0xCC1F1F21 carries above) ->
        # 204 * 1000 / 255 = 800. It is backend-neutral: the CPU twin, Metal
        # and Vulkan all read it as 255 * milli / 1000 straight alpha, so
        # 800 is the expected value for Metal AND for Vulkan (see the next
        # row and backend_vulkan_device_glass_blur_spec). The old oracle 200
        # was a transparency value no consumer reads; on any backend it would
        # paint a 20 % surface.
        expect(_draw_ir_style_value(card, "wm-material-surface-alpha-milli")).to_equal("800")
        expect(_draw_ir_style_value(card, "background-image-composite-mode")).to_equal("surface-then-alpha-gradient")
        expect(_draw_ir_style_value(card, "background-layers-raw")).to_equal("")

    it "reads the WM material surface alpha as per-mille opacity on the CPU twin, Metal and Vulkan":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "reads the WM material surface alpha as per-mille opacity on the CPU twin, Metal and Vulkan"
        step("Verify: reads the WM material surface alpha as per-mille opacity on the CPU twin, Metal and Vulkan")
        # No gradient, so the hand oracle stays one blend: the card covers
        # (0,0) on a white canvas, the blurred backdrop is flat white, and
        # rgb(31,31,33) at alpha 255 * 800 / 1000 = 204 over white is
        # (31*204 + 255*51) / 255 = 75 and (33*204 + 255*51) / 255 = 77.
        # Read as transparency (alpha 51) it would be 210/211 instead.
        val html = "<html><body style='margin:0;background:#ffffff'><section id='card' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' style='display:block;width:12px;height:8px;background:rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)'></section></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(html, 32, 20)
        val card = _draw_ir_command_by_id(composition.batches[0].commands, "card")
        expect(_draw_ir_style_value(card, "wm-material-surface-alpha-milli")).to_equal("800")
        val cpu = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(html, 32, 20, "cpu_simd")
        expect(cpu[2 * 32 + 2]).to_equal(0xFF4B4B4Du32)
        # Metal is static analysis on a Linux host: the kernel's surface and
        # gradient tints read the same per-mille opacity, with the src-over
        # blend bit-identical to the CPU twin's.
        val msl = _engine2d_msl()
        expect(msl.contains("int alpha = 255 * glass_clamp(p.surface_alpha_milli, 0, 1000) / 1000;")).to_equal(true)
        expect(msl.contains(": (uint)(255 * glass_clamp(p.surface_alpha_milli, 0, 1000) / 1000);")).to_equal(true)
        # Vulkan: the SPIR-V is pinned to this GLSL by
        # check-glass-material-spirv-pinned.shs; the device pixels are proven
        # on lavapipe by backend_vulkan_device_glass_blur_spec.
        val glsl = read_file("src/lib/gc_async_mut/gpu/engine2d/shaders/glass_material.comp")
        expect(glsl.contains("255 * clampi(pc.surface_alpha_milli, 0, 1000) / 1000, 0, 255);")).to_equal(true)

    it "claims CPU material provenance only with a matching execution receipt":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "claims CPU material provenance only with a matching execution receipt"
        step("Verify: claims CPU material provenance only with a matching execution receipt")
        val html = "<html><body><section id='card' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' style='display:block;width:12px;height:8px;background:linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.025)),rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)'></section></body></html>"
        val layout = simple_web_layout_render_html_draw_ir_result(
            html, 32, 20)
        val without_receipt =
            simple_web_layout_material_provenance_after_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20, 0)
        val with_receipt =
            simple_web_layout_material_provenance_after_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20, 1)

        expect(layout.material_fallback.kind).to_equal("none")
        expect(without_receipt.kind).to_equal("none")
        expect(with_receipt.kind).to_equal("cpu-composited-material")
        expect(with_receipt.reason).to_equal(
            "native-device-backdrop-path-pending")
        expect(with_receipt.material_sha256.len()).to_equal(64)  # oracle: 64 is the pinned authoritative contract value

    it "requires an independent Metal glass dispatch receipt":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "requires an independent Metal glass dispatch receipt"
        step("Verify: requires an independent Metal glass dispatch receipt")
        val html = "<html><body><section id='card' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' style='display:block;width:12px;height:8px;background:rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)'></section></body></html>"
        val layout = simple_web_layout_render_html_draw_ir_result(
            html, 32, 20)
        val final_device_readback_after_cpu =
            simple_web_layout_material_provenance_after_backend_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20,
                1, 0, "cpu-scalar-glass-v1", "device_readback", 7, 11)
        val missing_dispatch =
            simple_web_layout_material_provenance_after_backend_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20,
                0, 0, "unavailable", "device_readback", 7, 11)
        val mismatched_dispatch =
            simple_web_layout_material_provenance_after_backend_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20,
                0, 2, "metal-device-glass-v1",
                "device_readback", 7, 11)
        val metal =
            simple_web_layout_material_provenance_after_backend_execution(
                layout.material_witness, 0, 32 * 20, 32 * 20,
                0, 1, "metal-device-glass-v1",
                "device_readback", 7, 11)

        expect(final_device_readback_after_cpu.kind).to_equal(
            "cpu-composited-material")
        expect(missing_dispatch.kind).to_equal("none")
        expect(mismatched_dispatch.kind).to_equal("none")
        expect(metal.kind).to_equal("metal-device-composited-material")
        expect(metal.reason).to_equal("metal-device-glass-dispatch")
        expect(metal.material_sha256).to_equal(
            layout.material_witness.cpu_composited_sha256)

    it "executes Aetheric shorthand through Style Draw IR and the typed CPU receipt":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "executes Aetheric shorthand through Style Draw IR and the typed CPU receipt"
        step("Verify: executes Aetheric shorthand through Style Draw IR and the typed CPU receipt")
        # This is the closest integrated public path: the CSS shorthand is
        # cascaded into Style, lowered to Draw IR, executed by Engine2D, then
        # admitted only through the producer witness plus CPU receipt.
        val html = "<html><head><style>#aetheric{display:block;width:12px;height:8px;background:linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.025)),rgba(31,31,33,0.80);backdrop-filter:blur(30px) saturate(170%)}</style></head><body><section id='aetheric' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456'></section></body></html>"
        val layout = simple_web_layout_render_html_draw_ir_result(html, 32, 20)
        val card = _draw_ir_command_by_id(layout.composition.batches[0].commands, "aetheric")
        val execution = simple_web_layout_render_html_readback_engine2d_result(
            html, 32, 20, "software")

        expect(card.kind).to_equal("rect")
        expect(_draw_ir_style_value(card, "backdrop-filter-realized")).to_equal("blur(4px) saturate(170%)")
        expect(layout.material_witness.cpu_composited_count).to_equal(1)  # oracle: 1 is the pinned authoritative contract value
        expect(layout.material_witness.cpu_composited_sha256.len()).to_equal(64)  # oracle: 64 is the pinned authoritative contract value
        expect(execution.readback.pixels.len()).to_equal(32 * 20)
        expect(execution.material_fallback.kind).to_equal("cpu-composited-material")
        expect(execution.material_fallback.material_sha256).to_equal(layout.material_witness.cpu_composited_sha256)

