        expect(_count_color(raster_styled_svg, 0xFFFF0000u32) > 0).to_equal(true)
        # The value text itself paints: more ink than the same empty input.
        val styled_empty_input = "<html><head><style></style></head><body><section class='widget-panel'><input type='text' value=''></section></body></html>"
        val cpu_styled_empty_input = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_empty_input, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(cpu_styled_input, cpu_styled_empty_input) > 0).to_equal(true)
        expect(_count_color(cpu_styled_input, 0xFF000000u32) > _count_color(cpu_styled_empty_input, 0xFF000000u32)).to_equal(true)
        expect(_count_color(cpu_styled_scroll, 0xFF6B7280u32) > 0).to_equal(true)

    it "paints no URL background layer or its border overlay for a widget node on Draw IR in legacy widget mode":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "paints no URL background layer or its border overlay for a widget node on Draw IR in legacy widget mode"
        step("Verify: paints no URL background layer or its border overlay for a widget node on Draw IR in legacy widget mode")
        # The raster skips the whole box paint of a widget-* node in widget
        # mode. Draw IR still emitted the node's URL background image and the
        # background border overlay, which rebuilds the border from the raw
        # style and so repainted the suppressed border.
        val tile = simpleos_host_gpu_image_resource("image://tile", 4, 2, [0xFFFF0000u32; 8])
        val widget_page = "<html><body><section class='widget-panel' style='width:20px;height:12px;border:2px solid #0000ff;background-image:url(image://tile);background-repeat:no-repeat'></section></body></html>"
        val styled_page = "<html><head><style></style></head><body><section class='widget-panel' style='width:20px;height:12px;border:2px solid #0000ff;background-image:url(image://tile);background-repeat:no-repeat'></section></body></html>"
        var widget_background_commands = 0
        for batch in simple_web_layout_render_html_draw_ir_with_images(widget_page, 40, 64, [tile]).batches:
            for command in batch.commands:
                if command.component_id.contains("_background_image") or command.component_id.contains("_background_border_overlay"):
                    widget_background_commands = widget_background_commands + 1
        expect(widget_background_commands).to_equal(0)
        val raster_widget = simple_web_layout_render_html_software_pixels(widget_page, 40, 64)
        val cpu_widget = simple_web_layout_render_html_engine2d_result_with_images(widget_page, 40, 64, "cpu_simd", [tile]).pixels
        expect(_pixel_mismatches(raster_widget, cpu_widget)).to_equal(0)
        expect(_count_color(cpu_widget, 0xFF0000FFu32)).to_equal(0)
        expect(_count_color(cpu_widget, 0xFFFF0000u32)).to_equal(0)
        # Outside widget mode the same markup lowers the image and overlay.
        var styled_background_commands = 0
        for batch in simple_web_layout_render_html_draw_ir_with_images(styled_page, 40, 64, [tile]).batches:
            for command in batch.commands:
                if command.component_id.contains("_background_image") or command.component_id.contains("_background_border_overlay"):
                    styled_background_commands = styled_background_commands + 1
        expect(styled_background_commands).to_equal(2)
        val cpu_styled = simple_web_layout_render_html_engine2d_result_with_images(styled_page, 40, 64, "cpu_simd", [tile]).pixels
        expect(_count_color(cpu_styled, 0xFF0000FFu32) > 0).to_equal(true)
        expect(_count_color(cpu_styled, 0xFFFF0000u32) > 0).to_equal(true)

    it "keeps lowercase browser text glyphs distinct from uppercase glyphs":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "keeps lowercase browser text glyphs distinct from uppercase glyphs"
        step("Verify: keeps lowercase browser text glyphs distinct from uppercase glyphs")
        val lower_html = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}.label{color:#111827;font-size:8px;background-color:#ffffff}</style></head><body><div class='label'>chrome baseline</div></body></html>"
        val upper_html = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}.label{color:#111827;font-size:8px;background-color:#ffffff}</style></head><body><div class='label'>CHROME BASELINE</div></body></html>"
        val lower = simple_web_render_html_to_pixels(lower_html, 96, 32)
        val upper = simple_web_render_html_to_pixels(upper_html, 96, 32)
        expect(lower.len()).to_equal(96 * 32)
        # Chrome 159: 0 exact #111827 pixels, 226 ink pixels at 8px (2026-11-15).
        expect(_ink_near_chrome(_count_non_color_rect(lower, 96, 0, 0, 96, 32, 0xFFFFFFFFu32), 226)).to_equal(true)
        expect(_pixels_equal(lower, upper)).to_equal(false)

    it "renders the text-raster fixture with genuine glyph ink (no memorized Chrome overlay)":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "renders the text-raster fixture with genuine glyph ink (no memorized Chrome overlay)"
        step("Verify: renders the text-raster fixture with genuine glyph ink (no memorized Chrome overlay)")
        # The renderer used to paste a hard-coded captured-Chrome pixel table over
        # this scene so it could assert Chrome's antialiased counts (4881/316/163/1).
        # That overlay was a machine/version-specific tautology and was removed; these
        # assertions now describe the renderer's own honest software-rasterized output
        # (solid 5x7 glyph ink + a 1px panel border). Per-pixel parity vs Chrome's
        # font rasterizer is intentionally NOT asserted here — it is tracked as
        # known-divergent in the electron web-layout manifest (track-text-divergence).
        val html = "<html><head><style>html,body{margin:0;padding:0;width:96px;height:64px;overflow:hidden;background-color:#ffffff}.panel{background-color:#f8fafc;border:1px solid #334155;padding:4px;width:86px;height:54px}.title{color:#0f172a;font-size:16px;background-color:#f8fafc}.sub{color:#475569;font-size:8px;background-color:#f8fafc;margin-top:4px}</style></head><body><section class='panel'><div class='title'>TEXT RASTER</div><div class='sub'>Chrome AA baseline</div></section></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 96, 64)
        expect(pixels.len()).to_equal(96 * 64)
        expect(_count_color(pixels, 0xFF334155u32)).to_equal(316)  # oracle: 316 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFFF8FAFCu32)).to_be_greater_than(4000)
        expect(_count_color(pixels, 0xFF0F172Au32)).to_be_greater_than(0)
        # Chrome 159 paints the 8px subtitle with 0 exact #475569 pixels
        # (2026-11-15; the 16px title has 15 exact #0f172a). Assert its ink in
        # the subtitle band, below the title, instead.
        # Chrome 159: 453 non-panel pixels in this band (2026-11-15).
        expect(_ink_near_chrome(_count_non_color_rect(pixels, 96, 5, 26, 91, 44, 0xFFF8FAFCu32), 453)).to_equal(true)
        expect(_count_color(pixels, 0xFFFFFFFFu32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

    it "uses explicit line-height for wrapped text layout":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "uses explicit line-height for wrapped text layout"
        step("Verify: uses explicit line-height for wrapped text layout")
        val html = "<html><head><style>html,body{margin:0;padding:0;width:96px;height:64px;overflow:hidden;background-color:#f8fafc}.shell{background-color:#e5e7eb;padding:4px;width:60px;height:56px}.copy{background-color:#dbeafe;color:#0f172a;font-size:8px;line-height:12px;width:22px}.after{background-color:#f59e0b;width:10px;height:6px;margin-top:2px}</style></head><body><section class='shell'><div class='copy'>ALPHA BETA GAMMA</div><div class='after'></div></section></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 96, 64)
        expect(pixels.len()).to_equal(96 * 64)
        # The .after box lands at y=42 because the explicit 12px line-height pushes
        # the wrapped .copy text down — this is the actual line-height behaviour.
        expect(pixels[4 + 42 * 96]).to_equal(0xFFF59E0Bu32)
        # The wrapped copy text renders genuine glyph ink. Re-pinned 2026-11-17 for
        # LCD subpixel text (owner: same as Chrome). At 8 px, LCD coverage never
        # saturates all three channels on a 1 px stem, so no pixel is exactly the
        # text colour #0f172a. Chrome 159 also paints 0 such pixels on this HTML;
        # its darkest ink pixel is 0xFF4B3E5A (1 pixel). Re-pinned again 2026-11-17
        # for slight vertical hinting: the 8 px caps now take Chrome's 6 rows and
        # the text box mismatches Chrome on 709 px (was 711), while the summed
        # channel delta grew 1.3% (45,684 -> 46,282) because the L stem's pen
        # phase still sits ~1/2 px left of Chrome's (open, skill doc). The pin
        # tracks the engine's darkest ink pixel: 0xFF283151, exactly 3 pixels
        # (was 0xFF352A44 x2). Re-pinned a third time 2026-11-17 for horizontal-stem
        # edge snapping (glyph_hstem_snap_chrome159_spec): whole-image mismatch
        # against Chrome 159 (any channel delta > 8) 419 -> 412 px and summed
        # channel delta 52,265 -> 50,769 (-2.9%), so the engine is closer to Chrome;
        # the darkest ink pixel is now 0xFF1B2A4B, exactly 1 pixel (Chrome: 0xFF4B3E5A,
        # 1 pixel). Re-pinned a fourth time 2026-11-17 for the 8 px x-height fit
        # (small_text_vertical_hint_chrome159_spec): Chrome refuses the x-height
        # round-up at 8 px, so the glyphs lose 1-2 rows and the darkest ink pixel
        # moves 0xFF1B2A4B -> 0xFF42375F (Chrome 0xFF4B3E5A), exactly 1 pixel. On
        # THIS page the whole-image mismatch against Chrome is not a clean metric:
        # it has no font-family, Chrome draws it in Liberation Serif and the engine
        # in the sans face (412 -> 426 px, summed delta 50,769 -> 63,370). With
        # font-family:sans-serif on both sides the same text goes 318 -> 106 px and
        # 60,346 -> 7,607. The pin still tracks the engine, not Chrome.
        expect(_count_color(pixels, 0xFF42375Fu32)).to_equal(1)

