    it "lowers the generated widget chrome text into Draw IR from the raster's own point table":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "lowers the generated widget chrome text into Draw IR from the raster's own point table"
        step("Verify: lowers the generated widget chrome text into Draw IR from the raster's own point table")
        val html_with_widget_text = "<html><body><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        # Widget mode, but the text sits BEFORE the panel and under no widget
        # ancestor. (After an empty panel it would be off screen: the panel
        # fills the viewport height in Draw IR layout.)
        val html_without_widget_text = "<html><body><div>Menu</div><section class='widget-panel'></section></body></html>"
        val table = generated_widget_chrome_text_pixels()
        val with_text = simple_web_layout_render_html_draw_ir(html_with_widget_text, 40, 64)
        val without_text = simple_web_layout_render_html_draw_ir(html_without_widget_text, 40, 64)
        var chrome_points = 0
        var text_runs = 0
        for batch in with_text.batches:
            for command in batch.commands:
                if command.component_id.starts_with("widget-chrome-text-"):
                    chrome_points = chrome_points + 1
                if command.text_value != "":
                    text_runs = text_runs + 1
        var chrome_points_without = 0
        var text_runs_without = 0
        var offset_text_without = 0
        for batch in without_text.batches:
            for command in batch.commands:
                if command.component_id.starts_with("widget-chrome-text-"):
                    chrome_points_without = chrome_points_without + 1
                if command.component_id.starts_with("widget-offset-text-"):
                    offset_text_without = offset_text_without + 1
                if command.text_value != "":
                    text_runs_without = text_runs_without + 1
        # Every table point once; the generated text replaces the node glyphs.
        expect(chrome_points).to_equal(table.xs.len())
        expect(text_runs).to_equal(0)
        # No widget-ancestor text: the node text paints and no table point
        # does. As in the raster it paints as legacy sparse offset text, not
        # as a text run.
        expect(chrome_points_without).to_equal(0)
        expect(offset_text_without > 0).to_equal(true)
        expect(text_runs_without).to_equal(0)
        # Pixel API (Draw IR -> Engine2D) paints every table point exactly.
        val pixels = simple_web_render_html_to_pixels(html_with_widget_text, 40, 64)
        var wrong = 0
        var k = 0
        while k < table.xs.len():
            if pixels[table.ys[k] * 40 + table.xs[k]] != table.colors[k]:
                wrong = wrong + 1
            k = k + 1
        expect(wrong).to_equal(0)
        # Below 38x62 the table does not fit, in Draw IR exactly as in raster.
        val small = simple_web_layout_render_html_draw_ir(html_with_widget_text, 37, 64)
        var small_points = 0
        for batch in small.batches:
            for command in batch.commands:
                if command.component_id.starts_with("widget-chrome-text-"):
                    small_points = small_points + 1
        expect(small_points).to_equal(0)

    it "lowers the legacy widget frame rects into Draw IR, so cpu_simd paints the raster's frame":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "lowers the legacy widget frame rects into Draw IR, so cpu_simd paints the raster's frame"
        step("Verify: lowers the legacy widget frame rects into Draw IR, so cpu_simd paints the raster's frame")
        val html = "<html><body><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        val raster = simple_web_layout_render_html_software_pixels(html, 40, 64)
        val cpu = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(html, 40, 64, "cpu_simd")
        expect(_draw_ir_component_count(html, 40, 64, "widget-frame-") > 0).to_equal(true)
        # The 1px focus border, the image swatch with its two chips, and the
        # button frame / face / icon, at points the chrome text does not cover.
        expect(cpu[0]).to_equal(0xFF0066CCu32)
        expect(cpu[63 * 40 + 39]).to_equal(0xFF0066CCu32)
        expect(cpu[34 * 40 + 6]).to_equal(0xFF2563EBu32)
        expect(cpu[38 * 40 + 10]).to_equal(0xFFF59E0Bu32)
        expect(cpu[39 * 40 + 20]).to_equal(0xFF22C55Eu32)
        expect(cpu[50 * 40 + 5]).to_equal(0xFF64748Bu32)
        expect(cpu[52 * 40 + 7]).to_equal(0xFFCBD5E1u32)
        expect(cpu[57 * 40 + 12]).to_equal(0xFF2563EBu32)
        # fbh <= 66: the two bottom-corner patches restore the page base.
        expect(cpu[63 * 40 + 2]).to_equal(0xFFF5F5F5u32)
        # The whole frame, chrome text included, is the raster's.
        expect(_pixel_mismatches(raster, cpu)).to_equal(0)
        # A non-legacy page carries no widget frame.
        val styled = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}</style></head><body><section class='widget-panel'>Menu</section></body></html>"
        expect(_draw_ir_component_count(styled, 40, 64, "widget-frame-")).to_equal(0)

    it "paints legacy widget offset text through Draw IR exactly as the raster does":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "paints legacy widget offset text through Draw IR exactly as the raster does"
        step("Verify: paints legacy widget offset text through Draw IR exactly as the raster does")
        # Widget mode without the chrome text gate: text under no widget
        # ancestor, and a frame too narrow for the generated table. Both take
        # the sparse x+8 / y+7 offset text path instead of a normal text run.
        val no_widget_text = "<html><body><div>Menu</div><section class='widget-panel'></section></body></html>"
        val narrow = "<html><body><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        expect(_draw_ir_component_count(no_widget_text, 40, 64, "widget-offset-text-") > 0).to_equal(true)
        expect(_draw_ir_component_count(narrow, 37, 64, "widget-offset-text-") > 0).to_equal(true)
        val raster_a = simple_web_layout_render_html_software_pixels(no_widget_text, 40, 64)
        val cpu_a = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(no_widget_text, 40, 64, "cpu_simd")
        val raster_b = simple_web_layout_render_html_software_pixels(narrow, 37, 64)
        val cpu_b = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(narrow, 37, 64, "cpu_simd")
        # The sparse glyphs really paint: the same page without the text
        # differs from it on cpu_simd.
        val bare = "<html><body><div></div><section class='widget-panel'></section></body></html>"
        val cpu_bare = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(bare, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(cpu_bare, cpu_a) > 0).to_equal(true)
        expect(_pixel_mismatches(raster_a, cpu_a)).to_equal(0)
        expect(_pixel_mismatches(raster_b, cpu_b)).to_equal(0)

    it "suppresses the page and widget-node box paint on Draw IR in legacy widget mode, as the raster does":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "suppresses the page and widget-node box paint on Draw IR in legacy widget mode, as the raster does"
        step("Verify: suppresses the page and widget-node box paint on Draw IR in legacy widget mode, as the raster does")
        # Legacy widget mode (widget-panel, no <style>) paints the page base
        # instead of the html/body background, and paints no background,
        # border, outline or shadow for a widget-* / icon-image node. Draw IR
        # used to paint them all (549 / 549 / 752 mismatching pixels).
        val body_bg = "<html><body style='background-color:#ff0000'><section class='widget-panel'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        val panel_bg = "<html><body><section class='widget-panel' style='background-color:#00ff00'><div class='widget-button'><span>Menu</span></div></section></body></html>"
        val panel_frame = "<html><body><section class='widget-panel' style='border:2px solid #0000ff;box-shadow:2px 2px 0 #ff0000;outline:2px solid #00ff00'></section></body></html>"
        val raster_body = simple_web_layout_render_html_software_pixels(body_bg, 40, 64)
        val cpu_body = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(body_bg, 40, 64, "cpu_simd")
        val raster_panel = simple_web_layout_render_html_software_pixels(panel_bg, 40, 64)
        val cpu_panel = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(panel_bg, 40, 64, "cpu_simd")
        val raster_frame = simple_web_layout_render_html_software_pixels(panel_frame, 40, 64)
        val cpu_frame = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(panel_frame, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(raster_body, cpu_body)).to_equal(0)
        expect(_pixel_mismatches(raster_panel, cpu_panel)).to_equal(0)
        expect(_pixel_mismatches(raster_frame, cpu_frame)).to_equal(0)
        expect(cpu_body[8 * 40 + 11]).to_equal(0xFFF5F5F5u32)
        expect(cpu_panel[8 * 40 + 11]).to_equal(0xFFF5F5F5u32)
        expect(_count_color(cpu_body, 0xFFFF0000u32)).to_equal(0)
        expect(_count_color(cpu_panel, 0xFF00FF00u32)).to_equal(0)
        expect(_count_color(cpu_frame, 0xFF0000FFu32)).to_equal(0)
        # A non-widget node keeps its inline background in widget mode.
        val plain_div = "<html><body><div style='background-color:#ff00ff;height:4px'></div><section class='widget-panel'></section></body></html>"
        val raster_plain = simple_web_layout_render_html_software_pixels(plain_div, 40, 64)
        val cpu_plain = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(plain_div, 40, 64, "cpu_simd")
        expect(_count_color(cpu_plain, 0xFFFF00FFu32) > 0).to_equal(true)
        expect(_pixel_mismatches(raster_plain, cpu_plain)).to_equal(0)
        # Outside widget mode (a <style> element) the same markup paints them.
        val styled_body = "<html><head><style></style></head><body style='background-color:#ff0000'><div></div></body></html>"
        val styled_panel = "<html><head><style></style></head><body><section class='widget-panel' style='background-color:#00ff00;border:2px solid #0000ff'></section></body></html>"
        val cpu_styled_body = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_body, 40, 64, "cpu_simd")
        val cpu_styled_panel = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_panel, 40, 64, "cpu_simd")
        expect(_count_color(cpu_styled_body, 0xFFFF0000u32) > 0).to_equal(true)
        expect(_count_color(cpu_styled_panel, 0xFF00FF00u32) > 0).to_equal(true)
        expect(_count_color(cpu_styled_panel, 0xFF0000FFu32) > 0).to_equal(true)

    it "paints a widget-mode body radial gradient on the canvas on Draw IR exactly as the raster does":
        # @req REQ-WEB-RENDER-001
        step("Verify: paints a widget-mode body radial gradient on the canvas on Draw IR exactly as the raster does")
        # PR #9930 residual: the raster painted the first stop fading by
        # distance inside the body box, Draw IR an opaque box-centred circle
        # (1203 mismatching pixels). Chrome 159 propagates the body radial to
        # the canvas, positioned on the html box (at least the viewport;
        # Chrome pixels are pinned at device scale 4 in web_device_scale_spec).
        # Both lanes now share one evaluator, so they agree exactly.
        val image_page = "<html><body style='background-image:radial-gradient(circle,#ff0000 0%,#0000ff 100%)'><section class='widget-panel'></section></body></html>"
        val shorthand_page = "<html><body style='background:radial-gradient(circle,#ff0000 0%,#0000ff 100%)'><div class='widget-panel'>x</div></body></html>"
        val raster_image = simple_web_layout_render_html_software_pixels(image_page, 40, 64)
        val cpu_image = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(image_page, 40, 64, "cpu_simd")
        val raster_short = simple_web_layout_render_html_software_pixels(shorthand_page, 40, 64)
        val cpu_short = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(shorthand_page, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(raster_image, cpu_image)).to_equal(0)
        expect(_pixel_mismatches(raster_short, cpu_short)).to_equal(0)
        # (35, 18) lies outside the body box: Chrome paints the gradient there
        # (the canvas), not the widget page base.
        expect(cpu_image[18 * 40 + 35] != 0xFFF5F5F5u32).to_equal(true)
        expect(cpu_short[18 * 40 + 35] != 0xFFF5F5F5u32).to_equal(true)

    it "paints no widget-image placeholder or form-control chrome on Draw IR in legacy widget mode, as the raster does":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "paints no widget-image placeholder or form-control chrome on Draw IR in legacy widget mode, as the raster does"
        step("Verify: paints no widget-image placeholder or form-control chrome on Draw IR in legacy widget mode, as the raster does")
        # The raster paints the widget-image placeholder, the checkbox accent
        # control and the select chevron only outside widget mode; Draw IR
        # used to paint them always (240 / 169 / 16 mismatching pixels).
        val img_page = "<html><body><section class='widget-panel'><img class='widget-image' style='width:20px;height:12px'></section></body></html>"
        val checkbox_page = "<html><body><section class='widget-panel'><input type='checkbox' checked style='accent-color:#ff0000'></section></body></html>"
        val select_page = "<html><body><section class='widget-panel'><select><option>A</option></select></section></body></html>"
        var placeholders = 0
        for batch in simple_web_layout_render_html_draw_ir(img_page, 40, 64).batches:
            for command in batch.commands:
                if command.component_id.contains("::placeholder-"):
                    placeholders = placeholders + 1
        expect(placeholders).to_equal(0)
        val raster_img = simple_web_layout_render_html_software_pixels(img_page, 40, 64)
        val cpu_img = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(img_page, 40, 64, "cpu_simd")
        val raster_checkbox = simple_web_layout_render_html_software_pixels(checkbox_page, 40, 64)
        val cpu_checkbox = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(checkbox_page, 40, 64, "cpu_simd")
        val raster_select = simple_web_layout_render_html_software_pixels(select_page, 40, 64)
        val cpu_select = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(select_page, 40, 64, "cpu_simd")
        expect(_pixel_mismatches(raster_img, cpu_img)).to_equal(0)
        expect(_pixel_mismatches(raster_checkbox, cpu_checkbox)).to_equal(0)
        expect(_pixel_mismatches(raster_select, cpu_select)).to_equal(0)
        expect(cpu_img[11 * 40 + 8]).to_equal(0xFFF5F5F5u32)
        # Outside widget mode the placeholder paints, on the raster and Draw IR.
        val styled_img = "<html><head><style></style></head><body><section class='widget-panel'><img class='widget-image' style='width:20px;height:12px'></section></body></html>"
        val raster_styled_img = simple_web_layout_render_html_software_pixels(styled_img, 40, 64)
        val cpu_styled_img = simple_web_render_html_to_pixels_with_resolved_engine2d_backend(styled_img, 40, 64, "cpu_simd")
        expect(_count_color(raster_styled_img, 0xFF2563EBu32) > 0).to_equal(true)
        expect(_count_color(cpu_styled_img, 0xFF2563EBu32) > 0).to_equal(true)

    it "paints no inline svg, input text or scrollbar on Draw IR in legacy widget mode, as the raster does":
        # @req REQ-WEB-RENDER-001
