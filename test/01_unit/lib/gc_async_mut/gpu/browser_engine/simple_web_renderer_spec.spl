    expect(simple_web_layout_debug_style_by_id(
        fixtures[0], "term", "display"
    )).to_equal("inline")
    expect(simple_web_layout_debug_style_by_id(
        fixtures[1], "term", "display"
    )).to_equal("inline")
    expect(simple_web_layout_debug_style_by_id(
        fixtures[2], "term", "display"
    )).to_equal("block")

fn check_time_layout_and_draw_ir_parity(fixtures: [text]):
    val time_commands = simple_web_layout_render_html_draw_ir(
        fixtures[0], 128, 48
    ).batches[0].commands
    val span_commands = simple_web_layout_render_html_draw_ir(
        fixtures[1], 128, 48
    ).batches[0].commands
    val block_commands = simple_web_layout_render_html_draw_ir(
        fixtures[2], 128, 48
    ).batches[0].commands
    val time_term = _draw_ir_command_by_id(time_commands, "term")
    val span_term = _draw_ir_command_by_id(span_commands, "term")
    val block_term = _draw_ir_command_by_id(block_commands, "term")
    val time_mid = _draw_ir_text_command(time_commands, "MID")
    val span_mid = _draw_ir_text_command(span_commands, "MID")
    val time_right = _draw_ir_text_command(time_commands, "RIGHT")
    val span_right = _draw_ir_text_command(span_commands, "RIGHT")
    val block_right = _draw_ir_text_command(block_commands, "RIGHT")

    expect(_draw_ir_style_value(time_term, "tag")).to_equal("time")
    expect(time_term.parent_id).to_equal("row")
    expect(_draw_ir_style_value(time_term, "display")).to_equal("inline")
    expect([
        time_term.x, time_term.y, time_term.width, time_term.height
    ]).to_equal([
        span_term.x, span_term.y, span_term.width, span_term.height
    ])
    expect([
        time_mid.x, time_mid.y, time_mid.width, time_mid.height
    ]).to_equal([
        span_mid.x, span_mid.y, span_mid.width, span_mid.height
    ])
    expect([
        time_right.x, time_right.y, time_right.width, time_right.height
    ]).to_equal([
        span_right.x, span_right.y, span_right.width, span_right.height
    ])
    expect(time_mid.advance_widths).to_equal(span_mid.advance_widths)
    expect(time_right.advance_widths).to_equal(span_right.advance_widths)
    expect([
        time_term.x, time_term.y, time_term.width, time_term.height
    ]).not.to_equal([
        block_term.x, block_term.y, block_term.width, block_term.height
    ])
    expect([
        time_right.x, time_right.y, time_right.width, time_right.height
    ]).not.to_equal([
        block_right.x, block_right.y, block_right.width, block_right.height
    ])

fn check_time_cpu_pixel_parity(fixtures: [text]):
    val time_pixels = simple_web_render_html_to_pixels_with_cpu_draw_ir_backend(
        fixtures[0], 128, 48, "cpu"
    )
    val span_pixels = simple_web_render_html_to_pixels_with_cpu_draw_ir_backend(
        fixtures[1], 128, 48, "cpu"
    )
    val block_pixels = simple_web_render_html_to_pixels_with_cpu_draw_ir_backend(
        fixtures[2], 128, 48, "cpu"
    )
    expect(time_pixels).to_equal(span_pixels)
    expect(time_pixels).not.to_equal(block_pixels)

fn _wm_material_section(component_id: text, image_declarations: text) -> text:
    (
        "<section id='" + component_id + "'" +
        " data-wm-theme-material-mode='engine2d-cpu-composited-material-v1'" +
        " data-wm-theme-fallback='solid-material'" +
        " data-wm-theme-bg='#123456'" +
        " style='display:block;width:12px;height:8px;" +
        "background:rgba(255,255,255,0.2);" +
        image_declarations +
        "backdrop-filter:blur(4px) saturate(120%)'></section>"
    )

fn _wm_material_section_with_backdrop(component_id: text, backdrop: text) -> text:
    (
        "<section id='" + component_id + "'" +
        " data-wm-theme-material-mode='engine2d-cpu-composited-material-v1'" +
        " data-wm-theme-fallback='solid-material'" +
        " data-wm-theme-bg='#123456'" +
        " style='display:block;width:12px;height:8px;" +
        "background:rgba(255,255,255,0.2);" +
        "backdrop-filter:" + backdrop + "'></section>"
    )

describe "SimpleWebRenderer":

    it "renders HTML through the canonical browser engine to RenderScene":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "renders HTML through the canonical browser engine to RenderScene"
        step("Verify: renders HTML through the canonical browser engine to RenderScene")
        val html = "<html><body><div style='width: 80px; height: 40px; background-color: #2050a0'></div></body></html>"
        val scene = simple_web_render_html_to_scene(html, 120, 80)
        expect(scene.width).to_equal(120)  # oracle: 120 is the pinned authoritative contract value
        expect(scene.height).to_equal(80)  # oracle: 80 is the pinned authoritative contract value
        expect(scene.commands.len()).to_be_greater_than(0)

    it "renders inline url background shorthand fallback colors through RenderScene":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "renders inline url background shorthand fallback colors through RenderScene"
        step("Verify: renders inline url background shorthand fallback colors through RenderScene")
        val html = "<html><body><div style='width: 80px; height: 40px; background: url(hero.png) #0f8 no-repeat'></div></body></html>"
        expect(_simple_scene_has_fill_color(html, 0xFF00FF88u32)).to_equal(true)

    it "renders style block url background shorthand fallback colors through RenderScene":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "renders style block url background shorthand fallback colors through RenderScene"
        step("Verify: renders style block url background shorthand fallback colors through RenderScene")
        val html = "<html><head><style>.card { width: 80px; height: 40px; background: url(hero.png) #0f8 no-repeat; }</style></head><body><div class='card'></div></body></html>"
        expect(_simple_scene_has_fill_color(html, 0xFF00FF88u32)).to_equal(true)

    it "resolves repeated CSS custom properties without dropping unresolved vars":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "resolves repeated CSS custom properties without dropping unresolved vars"
        step("Verify: resolves repeated CSS custom properties without dropping unresolved vars")
        val html = "<html><head><style>:root{--panel:#1d4ed8;--accent:#f59e0b}.card{width:40px;height:18px;background-color:var(--panel);border:2px solid var(--accent)}.missing{width:8px;height:8px;background-color:var(--missing)}</style></head><body><div class='card'></div><div class='missing'></div></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 80, 48)
        expect(pixels.len()).to_equal(80 * 48)
        expect(_count_color(pixels, 0xFF1D4ED8u32)).to_be_greater_than(0)
        expect(_count_color(pixels, 0xFFF59E0Bu32)).to_be_greater_than(0)
        expect(_count_color(pixels, 0xFF141418u32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

    it "renders HTML to pixels for framebuffer and host adapters":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "renders HTML to pixels for framebuffer and host adapters"
        step("Verify: renders HTML to pixels for framebuffer and host adapters")
        val html = "<html><body><div style='width: 80px; height: 40px; background-color: #2050a0'></div></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 120, 80)
        expect(pixels.len()).to_equal(120 * 80)
        expect(_count_non_bg(pixels, 0xFFFFFFFF)).to_be_greater_than(0)

    it "applies style block colors in the generic layout renderer":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "applies style block colors in the generic layout renderer"
        step("Verify: applies style block colors in the generic layout renderer")
        val html = "<html><head><style>header { background-color:#1d4ed8; color:#ffffff; font-size:8px; padding:1px; }</style></head><body><header>CMD</header></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 96, 64)
        expect(pixels.len()).to_equal(96 * 64)
        expect(_count_color(pixels, 0xFF1D4ED8u32)).to_be_greater_than(0)
        expect(_count_color(pixels, 0xFF141418u32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

    it "keeps styled widget panels on authored CSS instead of legacy widget chrome":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "keeps styled widget panels on authored CSS instead of legacy widget chrome"
        step("Verify: keeps styled widget panels on authored CSS instead of legacy widget chrome")
        val html = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}section.widget-panel{display:block;width:20px;height:10px;border:2px solid #0f172a;background-color:#bfdbfe}</style></head><body><section class='widget-panel'></section></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 40, 24)
        expect(simple_web_layout_uses_legacy_widget_chrome(html)).to_equal(false)
        expect(pixels.len()).to_equal(40 * 24)
        expect(pixels[0]).to_equal(0xFF0F172Au32)
        expect(_count_color(pixels, 0xFF0066CCu32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

    it "honors border-style none while preserving solid border paint":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "honors border-style none while preserving solid border paint"
        step("Verify: honors border-style none while preserving solid border paint")
        val html = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}.solid{display:block;width:12px;height:8px;border-width:2px;border-style:solid;border-color:#ef4444;background-color:#22c55e}.none{display:block;width:12px;height:8px;border-width:2px;border-style:none;border-color:#1d4ed8;background-color:#f59e0b;margin-top:4px}</style></head><body><div class='solid'></div><div class='none'></div></body></html>"
        val pixels = simple_web_render_html_to_pixels(html, 40, 32)
        expect(pixels.len()).to_equal(40 * 32)
        expect(_count_color(pixels, 0xFFEF4444u32)).to_be_greater_than(0)
        expect(_count_color(pixels, 0xFF1D4ED8u32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value
        expect(_count_color(pixels, 0xFFF59E0Bu32)).to_be_greater_than(0)

    it "emits input values as Draw IR text over the input box":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "emits input values as Draw IR text over the input box"
        step("Verify: emits input values as Draw IR text over the input box")
        val html = "<html><body><input id='query' value='Simple'><input id='secret' type='password' value='é'></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(
            html, 160, 40
        )
        val commands = composition.batches[0].commands
        val query_box = _draw_ir_command_by_id(commands, "query")
        val query_text = _draw_ir_command_by_id(commands, "query_value")
        val password_text = _draw_ir_command_by_id(
            commands, "secret_value"
        )

        # Draw IR has no "box" kind (rect/text/edge/path/image/group/port; none
        # in any revision since 073b9614489 added this row). The input box is a rect.
        expect(query_box.kind).to_equal("rect")
        expect(query_text.kind).to_equal("text")
        expect(query_text.text_value).to_equal("Simple")
        expect(password_text.kind).to_equal("text")
        # Chrome 159: one U+2022 disc for the one-codepoint value "é"
        # (computed -webkit-text-security: disc; was "*").
        expect(password_text.text_value).to_equal("•")

    it "shares transformed aligned clipped themed input text with Draw IR":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "shares transformed aligned clipped themed input text with Draw IR"
        step("Verify: shares transformed aligned clipped themed input text with Draw IR")
        val html = "<html><head><style>html,body{margin:0;padding:0;background:#fff}.clip{display:block;width:22px;height:16px;overflow:hidden}#query{display:block;width:40px;height:16px;padding:2px;border:1px solid #111827;color:#22c55e;font-size:8px;text-transform:uppercase;direction:rtl;text-align:center}#hint{display:block;width:20px;height:14px;padding:1px;border:1px solid #111827;color:#ef4444}</style></head><body><div class='clip'><input id='query' value='abcdefghijk'></div><input id='hint' placeholder='hint'></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(html, 64, 48)
        val commands = composition.batches[0].commands
        val query = _draw_ir_command_by_id(commands, "query_value")
        val hint = _draw_ir_command_by_id(commands, "hint_value")
        val pixels = simple_web_render_html_to_pixels(html, 64, 48)

        expect(query.kind).to_equal("text")
        # Chrome 159 paints Latin "ABCDEFGHIJK" in logical order under
        # direction:rtl (bidi); the engine used to reverse it to KJIHGFEDCBA.
        # Owner decision 2026-11-16: "all same as chrome".
        expect(query.text_value).to_equal("ABCDEFGHIJK")
        # Chrome 159 (2026-11-16): the 11-glyph value is 56px wide in a 34px
        # content box (scrollWidth 56 > clientWidth 34), so text-align:center
        # is ignored and the RTL run is end-anchored at the content box's
        # right edge: center, start and left paint identical ink columns.
        # Chrome x = 37 - 56 = -19. The engine applies the same rule:
        # content right 37 (Chrome's UA box-sizing:border-box makes the
        # 40x16 input's content box 3,3,34,10, as in Chrome; it was 43 on the
        # old content-box 46-wide input) minus the full 11 x 5px run = -18
        # (Chrome's Arial run is 56). The old 1 assumed 4px glyphs, a 9-glyph
        # cap and centring of an overflowing run.
        expect(query.x).to_equal(37 - 11 * 5)
        # Content y 3 + (content h 10 - 7-row cell) / 2; was 7 on the 22-tall
        # content-box input.
        expect(query.y).to_equal(4)
        expect(query.clip_rect.present).to_be(true)
        expect(query.clip_rect.x).to_equal(3)  # oracle: 3 is the pinned authoritative contract value
        expect(query.clip_rect.y).to_equal(3)  # oracle: 3 is the pinned authoritative contract value
        expect(query.clip_rect.width).to_equal(19)  # oracle: 19 is the pinned authoritative contract value
        # Chrome 159 content box height 10 (border-box 16 - 2*1 border -
        # 2*2 padding); was 13 when the input grew to 22 under content-box.
        expect(query.clip_rect.height).to_equal(10)
        expect(query.color).to_equal(0xFF22C55Eu32)
        expect(hint.kind).to_equal("text")
        expect(hint.color).to_equal(0xFFEF4444u32)
        # Chrome 159 screenshot of this page: text ink only in columns
        # 4..21 (inside the 3..22 clip), and (5,7) itself is NOT ink there
        # (#e3fdff), so the old single-pixel (5,7) pin was an artefact of
        # the 4px-glyph x=1 run. Pin ink inside the clip in the exact text
        # color, and no paint at all right of the clip across the whole
        # input row (a superset of the old (25,7) white check).
        expect(_count_non_color_rect(pixels, 64, 3, 3, 22, 16, 0xFF22C55Eu32)).to_be_less_than(19 * 13)
        # Chrome 159: 101 non-white pixels in the 3..22 x 3..16 clip region.
        expect(_ink_near_chrome(_count_non_color_rect(pixels, 64, 3, 3, 22, 16, 0xFFFFFFFFu32), 101)).to_equal(true)
        expect(pixels[7 * 64 + 25]).to_equal(0xFFFFFFFFu32)
        expect(_count_non_color_rect(pixels, 64, 22, 0, 64, 16, 0xFFFFFFFFu32)).to_equal(0)  # oracle: Chrome 159 paints nothing right of the .clip box

    it "maps logical border block and inline properties to physical edges":
        # @req REQ-WEB-RENDER-001
        # @capture(gui_image): retained evidence for scenario "maps logical border block and inline properties to physical edges"
        step("Verify: maps logical border block and inline properties to physical edges")
        val html = "<html><head><style>html,body{margin:0;padding:0;background-color:#ffffff}#card{display:block;width:10px;height:8px;background-color:#111827;border-block:1px solid #64748b;border-inline:1px solid #64748b;border-block-width:3px 5px;border-inline-width:2px 4px;border-block-color:#94a3b8;border-inline-color:#94a3b8;border-block-style:solid;border-inline-style:solid;border-block-start:3px solid #ef4444;border-block-start-width:3px;border-block-start-color:#ef4444;border-block-start-style:solid;border-block-end:5px solid #1d4ed8;border-block-end-width:5px;border-block-end-color:#1d4ed8;border-block-end-style:solid;border-inline-start:2px solid #f59e0b;border-inline-start-width:2px;border-inline-start-color:#f59e0b;border-inline-start-style:solid;border-inline-end:4px solid #22c55e;border-inline-end-width:4px;border-inline-end-color:#22c55e;border-inline-end-style:solid}#none{display:block;width:8px;height:6px;margin-top:4px;background-color:#e5e7eb;border-block:2px solid #7c3aed;border-inline:2px solid #7c3aed;border-block-style:none;border-inline-style:none;border-block-start-style:none;border-block-end-style:none;border-inline-start-style:none;border-inline-end-style:none}</style></head><body><div id='card'></div><div id='none'></div></body></html>"
        val composition = simple_web_layout_render_html_draw_ir(html, 40, 40)
        val batch = composition.batches[0]
        val card = _draw_ir_command_by_id(batch.commands, "card")
        val pixels = simple_web_render_html_to_pixels(html, 40, 40)

        expect(_draw_ir_style_value(card, "border-left-width")).to_equal("2")
        expect(_draw_ir_style_value(card, "border-top-width")).to_equal("3")
        expect(_draw_ir_style_value(card, "border-right-width")).to_equal("4")
        expect(_draw_ir_style_value(card, "border-bottom-width")).to_equal("5")
        expect(pixels[3]).to_equal(0xFFEF4444u32)
        expect(pixels[160]).to_equal(0xFFF59E0Bu32)
        expect(pixels[175]).to_equal(0xFF22C55Eu32)
        expect(pixels[603]).to_equal(0xFF1D4ED8u32)
        expect(pixels[122]).to_equal(0xFF111827u32)
        expect(_count_color(pixels, 0xFF7C3AEDu32)).to_equal(0)  # oracle: 0 is the pinned authoritative contract value

