            html, 32, 32).batches[0].commands
        expect(_draw_ir_command_index(commands, "hidden")).to_equal(-1)  # oracle: -1 is the pinned authoritative contract value
        expect(_draw_ir_command_index(commands, "child")).to_equal(-1)  # oracle: -1 is the pinned authoritative contract value
        val target = simple_web_layout_hit_test_target_at_time(
            "<html style='margin:0'><body style='margin:0'>" +
            "<button id='invisible-button' style='opacity:0;width:16px;" +
            "height:16px'>click</button></body></html>",
            32, 32, 4, 4, 0)
        # Chrome 159 elementFromPoint(4,4) is the button: opacity:0 still hit-tests.
        # Target keys are canonical body paths (see input_overlay "keeps
        # duplicate author IDs distinct through canonical path keys"), so the
        # button, body's first element child, is `path:0`, not `id:...`.
        expect(target).to_equal("path:0")
        val beside = simple_web_layout_hit_test_target_at_time(
            "<html style='margin:0'><body style='margin:0'>" +
            "<button id='invisible-button' style='opacity:0;width:16px;" +
            "height:16px'>click</button></body></html>",
            32, 32, 24, 4, 0)
        expect(beside).to_not_equal("path:0")

