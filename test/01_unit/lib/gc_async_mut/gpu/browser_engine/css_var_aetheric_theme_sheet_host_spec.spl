"""
# Aetheric theme sheet resolves its custom properties on the host

Host pin for doc/08_tracking/bug/wm_guest_css_var_unresolved_blocks_material_admission_2026-08-09.md.
The SimpleOS guest reported `css-var-unresolved ... props=0` for the
`aetheric_dark` window sheet. This spec feeds the SAME generated sheet
(`aetheric_dark_theme_render_snapshot().composed_css`) to the pure-Simple
resolver on the host and checks the two terms the WM material admission
needs. A guest-only regression therefore cannot be blamed on the sheet or on
the resolver's logic.
"""

use std.spec.step

use std.spec.*
use std.common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_debug_style_by_id}

fn _doc() -> text:
    val css = aetheric_dark_theme_render_snapshot().composed_css
    "<html><head><style>" + css + "</style></head><body>" +
        "<div id=\"t\" class=\"wm-window\">x</div></body></html>"

fn _probe(field: text) -> text:
    simple_web_layout_debug_style_by_id(_doc(), "t", field)

describe "aetheric_dark sheet custom properties (host)":
    it "resolves --app-surface in the .wm-window background":
        # @req REQ-SSPEC-UNIT
        step("Window background colour is --app-surface rgba(31,31,33,0.80) = 0xCC1F1F21")
        # The guest reported bg=352321535 (0x14FFFFFF, the gradient's first stop).
        expect(_probe("background_color")).to_equal("3424591649")

    it "resolves --blur-surface in the .wm-window backdrop":
        # @req REQ-SSPEC-UNIT
        step("Backdrop filter has a px blur, not blur(var(...)) or blur()")
        val backdrop = _probe("backdrop_filter_raw")
        expect(backdrop.contains("blur(30px)")).to_be_true()
        expect(backdrop.contains("var(")).to_be_false()
