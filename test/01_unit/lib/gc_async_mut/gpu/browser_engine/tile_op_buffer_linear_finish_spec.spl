"""Focused coverage for the linear tile paint-op buffer finish path."""

use std.spec.{describe, it, expect}
use std.spec.step
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles.{
    TileOp, tile_op, tile_op_buffer_finish
}

describe "tile op buffer linear finish":
    it "returns only the used paint-ordered prefix":
        step("Finish a spare-capacity tile op buffer")
        val hidden = tile_op(0, -1, 0, 0, 0, 0, true, false, 0, -1)
        var buffer: [TileOp] = [hidden; 6]
        buffer[0] = tile_op(0, 10, 1, 2, 3, 4, false, true, 11, 12)
        buffer[1] = tile_op(2, 20, 5, 6, 7, 8, false, false, 21, 22)
        val finished = tile_op_buffer_finish(buffer, 2)

        expect(finished.len()).to_equal(2)
        expect(finished[0].node).to_equal(10)
        expect(finished[1].node).to_equal(20)
        expect(finished[0].opaque).to_be(true)
        expect(finished[1].kind).to_equal(2)

    it "returns an empty list when no slots were used":
        step("Finish an unused tile op buffer")
        val hidden = tile_op(0, -1, 0, 0, 0, 0, true, false, 0, -1)
        expect(tile_op_buffer_finish([hidden; 3], 0).len()).to_equal(0)
