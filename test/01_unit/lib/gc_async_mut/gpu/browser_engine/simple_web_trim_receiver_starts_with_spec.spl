"""
Pins simpleos_simple_web_decode_string_fault_storm_2026-07-12: `.starts_with`
on a `.trim()`-chain receiver could bind to `Path.starts_with` under native
codegen and fault in `decode_string`. Renderer sites now use the byte-compare
`text_starts_with_portable`. Native (QEMU/board) re-check remains open.
"""
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{text_starts_with_portable}

describe "simple web trim-receiver starts_with":
    it "byte-compares prefixes on trimmed receivers":
        val inner = "  /div ".trim()
        expect(text_starts_with_portable(inner, "/")).to_equal(true)
        val opt = " > .x ".trim()
        expect(text_starts_with_portable(opt, "> ")).to_equal(true)
        expect(text_starts_with_portable(".x", "> ")).to_equal(false)
        expect(text_starts_with_portable("", "/")).to_equal(false)

