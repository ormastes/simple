use std.spec.*

use std.gc_async_mut.gpu.browser_engine.net.browser_http_transport.{
    BrowserHttpTransport
}
use std.gc_async_mut.gpu.browser_engine.net.net_delegate.{NetDelegate}
use std.gc_async_mut.gpu.browser_engine.net.fetch_dispatch.{FetchDispatch}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{
    FetchRequest, RequestMode
}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url}
use std.gc_async_mut.gpu.browser_engine.net.entity.tls_types.{
    TlsConfig, TlsVersion, hosted_system_root_store
}
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{
    H1Client, MockResponseRegistry, observed_mock_request,
    set_mock_registry
}
use std.gc_async_mut.gpu.browser_engine.net.dns.{DnsResolver}
use std.gc_async_mut.gpu.browser_engine.net.tls.{TlsManager}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{
    Logger, BrowserLogLevel
}

fn test_transport() -> BrowserHttpTransport:
    val logger = Logger.new("browser-http-test", BrowserLogLevel.Error)
    val tls_config = TlsConfig(
        min_version: TlsVersion.Tls13,
        verify_peer: true,
        sni_hostname: "",
        root_store: hosted_system_root_store(),
        enable_x25519_mlkem768: false,
        require_x25519_mlkem768: false
    )
    BrowserHttpTransport.with_client(H1Client.new(
        logger,
        DnsResolver.new(logger, 300),
        TlsManager.new(logger, tls_config)
    ))

fn as_net_delegate(transport: BrowserHttpTransport) -> NetDelegate:
    transport

fn as_fetch_dispatch(transport: BrowserHttpTransport) -> FetchDispatch:
    transport

describe "Browser HTTP transport adapter":
    it "routes navigation GET through the canonical H1 client":
        var registry = MockResponseRegistry.create()
        registry.register("adapter-nav.test/page", 200, "render me")
        set_mock_registry(registry)
        var delegate = as_net_delegate(test_transport())

        val response = delegate.navigate(
            Url.parse_or_opaque("http://adapter-nav.test/page")
        )

        expect(response.status).to_equal(200)
        expect(response.body_text()).to_equal("render me")
        val observed = observed_mock_request("adapter-nav.test/page")
        expect(observed.is_some()).to_equal(true)
        expect(observed.unwrap().method).to_equal("GET")
        expect(observed.unwrap().mode).to_equal(RequestMode.Navigate)

    it "preserves POST headers and bytes through FetchDispatch":
        var registry = MockResponseRegistry.create()
        registry.register("adapter-post.test/submit", 201, "created")
        set_mock_registry(registry)
        var dispatch = as_fetch_dispatch(test_transport())
        val request = FetchRequest(
            method: "POST",
            url: Url.parse_or_opaque("http://adapter-post.test/submit"),
            headers: "Content-Type: application/json\r\n",
            body: [123u8, 125u8],
            mode: RequestMode.SameOrigin,
            credentials: "same-origin"
        )

        val response = dispatch.dispatch(request)

        expect(response.status).to_equal(201)
        val observed = observed_mock_request("adapter-post.test/submit")
        expect(observed.is_some()).to_equal(true)
        expect(observed.unwrap().method).to_equal("POST")
        expect(observed.unwrap().headers).to_contain("application/json")
        expect(observed.unwrap().body).to_equal([123u8, 125u8])

    it "keeps transport failure typed instead of claiming an HTTP response":
        set_mock_registry(MockResponseRegistry.create())
        var transport = test_transport()
        val request = FetchRequest(
            method: "GET",
            url: Url.parse_or_opaque("file:///not-network"),
            headers: "",
            body: [],
            mode: RequestMode.Navigate,
            credentials: "omit"
        )

        val response = transport.fetch(request)

        expect(response.status).to_equal(0)
        expect(transport.failure().is_some()).to_equal(true)
        expect(transport.failure().unwrap().operation).to_equal("fetch")
        expect(transport.failure().unwrap().message).to_contain(
            "unsupported URL scheme"
        )
