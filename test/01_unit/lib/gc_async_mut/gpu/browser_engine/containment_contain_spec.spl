# Proves CSS `contain: style` / `contain: layout` fast-skip
# (src/lib/gc_async_mut/gpu/browser_engine/containment.spl, and the bolted-on
# fast-skip in style_invalidation.spl's apply_rules_to_node_invalidated).
#
# Two independent claims:
#   (a) correctness  — contained vs uncontained produce IDENTICAL final
#       output (styles / box measurements), for representative trees.
#   (b) proportionality — a mutation OUTSIDE a `contain: style`/`contain:
#       layout` subtree does not force recomputation INSIDE it, and vice
#       versa (measured via rematch_count / contain_skip_count /
#       recompute_count counters exposed on the real state objects, not a
#       local re-implementation).
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/containment.spl
# @cover src/lib/gc_async_mut/gpu/browser_engine/style_invalidation.spl
use std.spec.{describe, it, expect}

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_get_children, be_dom_get_style}
use std.gc_async_mut.gpu.browser_engine.style_block.{
    CssRule, CssDecl, SelectorRuleIndex, build_selector_rule_index}
use std.gc_async_mut.gpu.browser_engine.style_invalidation.{
    InvalidationState, new_invalidation_state, apply_css_rules_to_tree_invalidated,
    invalidate_node_discriminant_change}
use std.gc_async_mut.gpu.browser_engine.containment.{
    LayoutContainState, new_layout_contain_state, layout_contain_compute,
    layout_contain_mark_dirty}

fn rule(selector: text, property: text, value: text) -> CssRule:
    CssRule(selector: selector, declarations: [CssDecl(property: property, value: value)])

fn el(node_id: i64, tag: text, contain_val: text, kids: [BeDomNode]) -> BeDomNode:
    var attrs: Dict<text, text> = {}
    attrs["class"] = tag
    if contain_val != "":
        attrs["contain"] = contain_val
    BeDomNode(
        node_id: node_id,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: kids,
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

# Tree:
#   root(1)
#     contained(2)  [contain: style]  -- boundary
#       inner(3)
#     plain(4)
fn build_tree() -> BeDomNode:
    val inner = el(3, "span", "", [])
    val contained = el(2, "div", "style", [inner])
    val plain = el(4, "p", "", [])
    el(1, "section", "", [contained, plain])

fn build_index(rules: [CssRule]) -> SelectorRuleIndex:
    build_selector_rule_index(rules)

describe "CSS contain fast-skip":

    it "(a) correctness: contain:style produces the SAME computed styles as no containment":
        val rules = [rule(".span", "color", "red"), rule(".div", "color", "blue")]
        val idx = build_index(rules)

        var st_contained = new_invalidation_state()
        val tree_contained = build_tree()
        val out_contained = apply_css_rules_to_tree_invalidated(tree_contained, rules, idx, st_contained)

        var st_plain = new_invalidation_state()
        val tree_plain = el(3, "span", "", [])
        val mid_plain = el(2, "div", "", [tree_plain])
        val plain_sib = el(4, "p", "", [])
        val root_plain = el(1, "section", "", [mid_plain, plain_sib])
        val out_plain = apply_css_rules_to_tree_invalidated(root_plain, rules, idx, st_plain)

        val kids_c = be_dom_get_children(out_contained)
        val kids_p = be_dom_get_children(out_plain)
        val inner_c = be_dom_get_children(kids_c[0])[0]
        val inner_p = be_dom_get_children(kids_p[0])[0]
        expect(be_dom_get_style(inner_c).color).to_equal(be_dom_get_style(inner_p).color)
        expect(be_dom_get_style(inner_c).color).to_equal("red")
        expect(be_dom_get_style(kids_c[0]).color).to_equal(be_dom_get_style(kids_p[0]).color)

    it "(b) proportionality: a mutation OUTSIDE the contain:style boundary does not force the contained subtree to rematch":
        val rules = [rule(".span", "color", "red"), rule(".p", "color", "green")]
        val idx = build_index(rules)
        var state = new_invalidation_state()
        var tree = build_tree()
        tree = apply_css_rules_to_tree_invalidated(tree, rules, idx, state)
        val rematch_after_first_pass = state.rematch_count

        # Mutate a discriminant OUTSIDE the contained subtree: the sibling
        # "plain" node's class changes, which dirties the ".p"-family
        # buckets only — no bucket the contained subtree belongs to.
        invalidate_node_discriminant_change(
            state, idx, "p", "", ["p"], "p", "", ["p", "moved"])
        tree = apply_css_rules_to_tree_invalidated(tree, rules, idx, state)

        # The contained subtree must have been skipped outright (not just
        # cheaply rematched): contain_skip_count advances.
        expect(state.contain_skip_count > 0).to_equal(true)

    it "(b) proportionality: layout containment skips recompute when the contained subtree is unchanged":
        var lstate = new_layout_contain_state()
        val inner = el(3, "span", "", [])
        val contained_node = el(2, "div", "layout", [inner])

        val h1 = layout_contain_compute(lstate, contained_node, 0, 0)
        val recompute_after_first = lstate.recompute_count

        # Recompute again with nothing marked dirty: must hit the cache,
        # not recompute (recompute_count stays flat).
        val h2 = layout_contain_compute(lstate, contained_node, 0, 0)
        expect(h2).to_equal(h1)
        expect(lstate.recompute_count).to_equal(recompute_after_first)

        # Now mark it dirty and recompute: must actually recompute again.
        layout_contain_mark_dirty(lstate, contained_node.node_id)
        val h3 = layout_contain_compute(lstate, contained_node, 0, 0)
        expect(h3).to_equal(h1)
        expect(lstate.recompute_count > recompute_after_first).to_equal(true)
