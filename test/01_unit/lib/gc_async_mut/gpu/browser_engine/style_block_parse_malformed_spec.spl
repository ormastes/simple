# @req: REQ-LIB-GC-ASYNC-MUT-001

# Malformed-input coverage for the browser engine's CSS block parser.
#
# Union coverage of style_block_parse.spl against every spec that reaches it by
# import was 91% (448/488). Almost every uncovered line was a defensive
# `break` / tail-append guard for CSS that is truncated or otherwise malformed
# -- exactly the inputs a browser must survive and exactly the ones no existing
# example supplied. All are driven here through the three public entry points
# `extract_keyframes`, `extract_style_blocks` and `parse_css_rules`.
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/style_block_parse.spl
use std.spec.{describe, it, expect}

use std.gc_async_mut.gpu.browser_engine.style_block_parse.{
    extract_keyframes, extract_style_blocks, parse_css_rules, collect_css_vars,
    resolve_css_vars_in_rules, parse_declarations}

fn lb() -> text:
    123.chr()

fn rb() -> text:
    125.chr()

fn kf_entry_count(css: text) -> i64:
    extract_keyframes(css).entries.len()

fn kf_frame_count(css: text) -> i64:
    """Frames on the first registered @keyframes rule, or -1 if none registered."""
    val reg = extract_keyframes(css)
    if reg.entries.len() == 0:
        return -1
    reg.entries[0].frames.len()

use std.spec.step

describe "style_block_parse @keyframes truncation":

    it "registers nothing when @keyframes has no opening brace":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: registers nothing when @keyframes has no opening brace")
        expect(kf_entry_count("@keyframes spin")).to_equal(0)

    it "registers nothing when the @keyframes block is never closed":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: registers nothing when the @keyframes block is never closed")
        val css = "@keyframes spin " + lb() + "from" + lb() + "opacity:0" + rb()
        expect(kf_entry_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "registers an empty rule when a keyframe offset has no block":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: registers an empty rule when a keyframe offset has no block")
        val css = "@keyframes spin " + lb() + " 0% opacity: 0 " + rb()
        expect(kf_frame_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "registers both keyframes of a well-formed rule":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: registers both keyframes of a well-formed rule")
        val css = ("@keyframes spin " + lb() + "from " + lb() + "opacity:0" + rb() +
                   " to " + lb() + "opacity:1" + rb() + rb())
        expect(kf_frame_count(css)).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "style_block_parse keyframe offsets and values":

    it "accepts a percentage declaration value inside a keyframe":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: accepts a percentage declaration value inside a keyframe")
        val css = "@keyframes g " + lb() + "from " + lb() + "width:50%" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects a percentage offset with no number at all":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a percentage offset with no number at all")
        val css = "@keyframes g " + lb() + "% " + lb() + "opacity:0" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects a percentage offset that is only a sign":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a percentage offset that is only a sign")
        val css = "@keyframes g " + lb() + "+% " + lb() + "opacity:0" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects a percentage offset with two exponent markers":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a percentage offset with two exponent markers")
        val css = "@keyframes g " + lb() + "1e2e3% " + lb() + "opacity:0" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "accepts a signed exponent in a percentage offset":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: accepts a signed exponent in a percentage offset")
        # 1e+1% is 10%, inside the 0..100 range.
        val css = "@keyframes g " + lb() + "1e+1% " + lb() + "opacity:0" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects a non-digit in the exponent of a percentage offset":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: rejects a non-digit in the exponent of a percentage offset")
        val css = "@keyframes g " + lb() + "1ex% " + lb() + "opacity:0" + rb() + rb()
        expect(kf_frame_count(css)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "style_block_parse <style> extraction":

    it "finds no blocks in markup with no style tag":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds no blocks in markup with no style tag")
        expect(extract_style_blocks("<p>hi</p>").len()).to_equal(0)

    it "finds no blocks when the style tag is never closed with >":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds no blocks when the style tag is never closed with >")
        expect(extract_style_blocks("<p></p><style").len()).to_equal(0)

    it "finds no blocks when </style> is missing":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds no blocks when </style> is missing")
        expect(extract_style_blocks("<style>p{color:red}").len()).to_equal(0)

    it "finds a well-formed style block":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds a well-formed style block")
        val html = "<style>p " + lb() + "color:red" + rb() + "</style>"
        expect(extract_style_blocks(html).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "style_block_parse at-rule flattening on truncated input":

    it "keeps the tail when @supports has no opening brace":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when @supports has no opening brace")
        expect(parse_css_rules("@supports (display:flex)").len()).to_equal(0)

    it "keeps the tail when the @supports block is never closed":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when the @supports block is never closed")
        val css = "@supports (display:flex) " + lb() + "p " + lb() + "color:red" + rb()
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "keeps the tail when @layer has no opening brace":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when @layer has no opening brace")
        expect(parse_css_rules("@layer base").len()).to_equal(0)

    it "keeps the tail when the @layer block is never closed":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when the @layer block is never closed")
        val css = "@layer base " + lb() + "p " + lb() + "color:red" + rb()
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "keeps the tail when a trailing @keyframes has no opening brace":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when a trailing @keyframes has no opening brace")
        val css = "p " + lb() + "color:red" + rb() + " @keyframes spin"
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "keeps the tail when a trailing @keyframes block is never closed":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps the tail when a trailing @keyframes block is never closed")
        val css = ("p " + lb() + "color:red" + rb() + " @keyframes spin " + lb() +
                   "from " + lb() + "opacity:0" + rb())
        expect(parse_css_rules(css).len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "style_block_parse rule scanning on truncated input":

    it "parses no rule when there is no opening brace at all":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: parses no rule when there is no opening brace at all")
        expect(parse_css_rules("p color: red").len()).to_equal(0)

    it "skips a block whose selector is empty and keeps the next rule":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: skips a block whose selector is empty and keeps the next rule")
        val css = lb() + "color:red" + rb() + " p " + lb() + "color:blue" + rb()
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "parses no rule when the closing brace is missing":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: parses no rule when the closing brace is missing")
        expect(parse_css_rules("p " + lb() + "color:red").len()).to_equal(0)

describe "style_block_parse nested-rule flattening":

    it "keeps trailing declarations after the last nested block":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps trailing declarations after the last nested block")
        val css = ("p " + lb() + "color:red; & span " + lb() + "color:blue" + rb() +
                   " trailing" + rb())
        expect(parse_css_rules(css).len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "drops a nested at-rule that cannot be combined with its parent":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: drops a nested at-rule that cannot be combined with its parent")
        val css = "p " + lb() + "@media screen " + lb() + "color:blue" + rb() + rb()
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "parses two sibling rules unchanged":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: parses two sibling rules unchanged")
        val css = "p " + lb() + "color:red" + rb() + " a " + lb() + "color:blue" + rb()
        expect(parse_css_rules(css).len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

fn resolved_value(css: text, prop: text) -> text:
    """Value of `prop` after collect_css_vars + resolve_css_vars_in_rules."""
    val rules = parse_css_rules(css)
    val vars = collect_css_vars(rules)
    val resolved = resolve_css_vars_in_rules(rules, vars)
    var ri = 0
    while ri < resolved.len():
        val r = resolved[ri]
        ri = ri + 1
        var di = 0
        while di < r.declarations.len():
            val d = r.declarations[di]
            di = di + 1
            if d.property == prop:
                return d.value
    "<none>"

fn decl_props(text_val: text) -> text:
    """Flatten parse_declarations output to `prop=value;` pairs."""
    val ds = parse_declarations(text_val)
    var out = ""
    var i = 0
    while i < ds.len():
        out = out + ds[i].property + "=" + ds[i].value + ";"
        i = i + 1
    out

describe "style_block_parse nested-rule tails":

    it "keeps declarations that follow the last nested block":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps declarations that follow the last nested block")
        val css = "p " + lb() + "& span " + lb() + "color:blue" + rb() + " color:red" + rb()
        expect(parse_css_rules(css).len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "drops a nested at-rule while keeping a sibling parent-reference rule":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: drops a nested at-rule while keeping a sibling parent-reference rule")
        val css = ("p " + lb() + "@media screen " + lb() + "color:blue" + rb() +
                   " & a " + lb() + "color:red" + rb() + rb())
        expect(parse_css_rules(css).len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "style_block_parse custom property resolution":

    it "substitutes a defined custom property":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: substitutes a defined custom property")
        val css = ":root " + lb() + "--brand: teal" + rb() + " p " + lb() + "color: var(--brand)" + rb()
        expect(resolved_value(css, "color")).to_equal("teal")

    it "falls back when the custom property is undefined":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: falls back when the custom property is undefined")
        val css = (":root " + lb() + "--brand: teal" + rb() + " p " + lb() +
                   "color: var(--missing, blue)" + rb())
        expect(resolved_value(css, "color")).to_equal("blue")

    it "leaves the reference intact when undefined with no fallback":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: leaves the reference intact when undefined with no fallback")
        val css = (":root " + lb() + "--brand: teal" + rb() + " p " + lb() +
                   "color: var(--missing)" + rb())
        expect(resolved_value(css, "color")).to_equal("var(--missing)")

    it "leaves an empty var() reference intact":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: leaves an empty var() reference intact")
        val css = ":root " + lb() + "--brand: teal" + rb() + " p " + lb() + "color: var()" + rb()
        expect(resolved_value(css, "color")).to_equal("var()")

    it "leaves an unterminated var( reference intact":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: leaves an unterminated var( reference intact")
        val css = ":root " + lb() + "--brand: teal" + rb() + " p " + lb() + "color: var(--brand" + rb()
        expect(resolved_value(css, "color")).to_equal("var(--brand")

    it "returns the rules untouched when no custom properties were collected":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns the rules untouched when no custom properties were collected")
        val css = "p " + lb() + "color: var(--brand)" + rb()
        expect(resolved_value(css, "color")).to_equal("var(--brand)")

describe "style_block_parse background shorthand":

    it "keeps a bare color as background-color":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps a bare color as background-color")
        expect(decl_props("background: red")).to_equal("background-color=red;")

    it "keeps a gradient as background":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps a gradient as background")
        expect(decl_props("background: linear-gradient(red, blue)")).to_equal(
            "background=linear-gradient(red, blue);")

    it "keeps two url() layers as background":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps two url() layers as background")
        expect(decl_props("background: url(a.png) url(b.png)")).to_equal(
            "background=url(a.png) url(b.png);")

    it "keeps an unterminated url( as background":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps an unterminated url( as background")
        expect(decl_props("background: url(")).to_equal("background=url(;")

    it "emits nothing for a declaration with an empty value":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: emits nothing for a declaration with an empty value")
        expect(decl_props("background:")).to_equal("")
