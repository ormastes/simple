# @cover src/lib/gc_async_mut/gpu/browser_engine/web_paint_chunk_frame.spl 80%
# @tag: unit, web, draw_ir, render_perf, o2

use std.spec.*
use common.ui.draw_ir.{
    draw_ir_batch_with_source, draw_ir_composition,
    draw_ir_embedding_config, draw_ir_image_command, draw_ir_rect,
    draw_ir_rect_bounds, draw_ir_source_manual, draw_ir_style_prop,
    draw_ir_text_styled_clipped
}
use common.ui.render_opt.chunk_occlusion.{
    CHUNK_OPAQUE_EXACT_RECT, CHUNK_OPAQUE_UNKNOWN
}
use std.gc_async_mut.gpu.browser_engine.web_paint_chunk_frame.{
    WebPaintChunkProducerProof,
    web_paint_chunk_frame_from_composition,
    web_paint_chunk_frame_from_composition_with_proofs,
    web_paint_chunk_frame_matches
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result
}

fn paint_chunk_identity_composition():
    val source = draw_ir_source_manual()
    val first = draw_ir_batch_with_source(
        "base", "cpu",
        draw_ir_embedding_config(
            "surface-base", "document", 0, 0, 80, 60, 0, 1000, true),
        [
            draw_ir_rect("canvas", 0, 0, 80, 60, 0xFFFFFFFFu32),
            draw_ir_rect("box-a", 2, 3, 20, 10, 0xFF112233u32)
        ],
        source)
    val second = draw_ir_batch_with_source(
        "overlay", "cpu",
        draw_ir_embedding_config(
            "surface-overlay", "overlay-root", 4, 5, 30, 20, 1, 750, true),
        [draw_ir_rect("box-b", 6, 7, 8, 9, 0x80445566u32)],
        source)
    draw_ir_composition("revision-1", "scene-1", "cpu", [first, second])

fn paint_chunk_semantic_composition(
    text_value: text, style_value: text, clip_width: i32, image_uri: text
):
    val source = draw_ir_source_manual()
    val batch = draw_ir_batch_with_source(
        "semantic", "cpu",
        draw_ir_embedding_config(
            "surface-semantic", "document", 0, 0, 80, 60, 0, 1000, true),
        [
            draw_ir_text_styled_clipped(
                "semantic-text", 2, 3, text_value, 0xFF112233u32,
                [draw_ir_style_prop("font-weight", style_value)],
                draw_ir_rect_bounds(0, 0, clip_width, 20)
            ),
            draw_ir_image_command(
                "semantic-image", 6, 7, 8, 9, image_uri,
                [draw_ir_style_prop("object-fit", "contain")]
            )
        ],
        source)
    draw_ir_composition(
        "semantic-revision", "semantic-scene", "cpu", [batch])

fn paint_chunk_proof_for(
    proofs: [WebPaintChunkProducerProof], command_id: text
) -> u32:
    for proof in proofs:
        if proof.command_id == command_id:
            return proof.opaque_proof
    CHUNK_OPAQUE_UNKNOWN

describe "Simple Web producer PaintChunk frame identity":
    it "keeps every canonical command in lockstep with its original batch":
        val composition = paint_chunk_identity_composition()
        val frame = web_paint_chunk_frame_from_composition(composition)
        expect(frame.valid).to_equal(true)
        expect(frame.reason).to_equal("")
        expect(frame.culling_enabled).to_equal(false)
        expect(frame.chunks.chunk_count).to_equal(3)
        expect(frame.rects.rect_count).to_equal(3)
        expect(frame.visibility.count).to_equal(3)
        expect(frame.stable_command_ids).to_equal([
            "canvas", "box-a", "box-b"
        ])
        expect(frame.command_batch_indices).to_equal([0, 0, 1])
        expect(frame.batches.len()).to_equal(2)
        expect(frame.batches[0].batch_id).to_equal("base")
        expect(frame.batches[0].surface_id).to_equal("surface-base")
        expect(frame.batches[0].command_count).to_equal(2)
        expect(frame.batches[1].batch_id).to_equal("overlay")
        expect(frame.batches[1].surface_id).to_equal("surface-overlay")
        expect(frame.batches[1].opacity_milli).to_equal(750)
        expect(frame.visibility.opaque_proof).to_equal([
            CHUNK_OPAQUE_UNKNOWN,
            CHUNK_OPAQUE_UNKNOWN,
            CHUNK_OPAQUE_UNKNOWN
        ])
        expect(web_paint_chunk_frame_matches(frame, composition)).to_equal(true)

    it "fails the complete sidecar closed when stable command identity repeats":
        val source = draw_ir_source_manual()
        val batch = draw_ir_batch_with_source(
            "duplicate-test", "cpu",
            draw_ir_embedding_config(
                "surface", "document", 0, 0, 32, 32, 0, 1000, true),
            [
                draw_ir_rect("duplicate", 0, 0, 8, 8, 0xFFFFFFFFu32),
                draw_ir_rect("duplicate", 8, 0, 8, 8, 0xFF000000u32)
            ],
            source)
        val composition = draw_ir_composition(
            "revision-duplicate", "scene-duplicate", "cpu", [batch])
        val frame = web_paint_chunk_frame_from_composition(composition)
        expect(frame.valid).to_equal(false)
        expect(frame.reason).to_equal(
            "web-paint-chunk-invalid-command-identity")
        expect(frame.chunks.chunk_count).to_equal(0)
        expect(frame.stable_command_ids.len()).to_equal(0)
        expect(composition.batches[0].commands.len()).to_equal(2)
        expect(web_paint_chunk_frame_matches(frame, composition)).to_equal(false)

    it "rejects changed command semantics with identical identity and geometry":
        val baseline = paint_chunk_semantic_composition(
            "before", "400", 20, "before.png")
        val frame = web_paint_chunk_frame_from_composition(baseline)
        expect(frame.valid).to_equal(true)
        expect(frame.culling_enabled).to_equal(false)
        expect(web_paint_chunk_frame_matches(frame, baseline)).to_equal(true)
        expect(web_paint_chunk_frame_matches(
            frame,
            paint_chunk_semantic_composition(
                "after", "400", 20, "before.png")
        )).to_equal(false)
        expect(web_paint_chunk_frame_matches(
            frame,
            paint_chunk_semantic_composition(
                "before", "700", 20, "before.png")
        )).to_equal(false)
        expect(web_paint_chunk_frame_matches(
            frame,
            paint_chunk_semantic_composition(
                "before", "400", 19, "before.png")
        )).to_equal(false)
        expect(web_paint_chunk_frame_matches(
            frame,
            paint_chunk_semantic_composition(
                "before", "400", 20, "after.png")
        )).to_equal(false)

    it "rejects tampered unowned property-tree and cache columns":
        val baseline = paint_chunk_semantic_composition(
            "before", "400", 20, "before.png")
        var frame = web_paint_chunk_frame_from_composition(baseline)
        expect(web_paint_chunk_frame_matches(frame, baseline)).to_equal(true)
        frame.chunks.clip_node[0] = 1u32
        expect(web_paint_chunk_frame_matches(frame, baseline)).to_equal(false)

    it "accepts only command-order-aligned producer proof attestations":
        val composition = paint_chunk_identity_composition()
        val proofs = [
            WebPaintChunkProducerProof(
                command_id: "canvas", opaque_proof: CHUNK_OPAQUE_UNKNOWN,
                batch_id: "base", surface_id: "surface-base",
                embedding_opacity_milli: 1000, embedding_clip: true),
            WebPaintChunkProducerProof(
                command_id: "box-a", opaque_proof: CHUNK_OPAQUE_EXACT_RECT,
                batch_id: "base", surface_id: "surface-base",
                embedding_opacity_milli: 1000, embedding_clip: true),
            WebPaintChunkProducerProof(
                command_id: "box-b", opaque_proof: CHUNK_OPAQUE_UNKNOWN,
                batch_id: "overlay", surface_id: "surface-overlay",
                embedding_opacity_milli: 750, embedding_clip: true)
        ]
        val frame = web_paint_chunk_frame_from_composition_with_proofs(
            composition, proofs)
        expect(frame.valid).to_equal(true)
        expect(frame.culling_enabled).to_equal(false)
        expect(frame.visibility.opaque_proof).to_equal([
            CHUNK_OPAQUE_UNKNOWN,
            CHUNK_OPAQUE_EXACT_RECT,
            CHUNK_OPAQUE_UNKNOWN
        ])
        expect(web_paint_chunk_frame_matches(frame, composition)).to_equal(true)
        val bad = web_paint_chunk_frame_from_composition_with_proofs(
            composition, [
                WebPaintChunkProducerProof(
                    command_id: "box-a", opaque_proof: CHUNK_OPAQUE_EXACT_RECT,
                    batch_id: "base", surface_id: "surface-base",
                    embedding_opacity_milli: 1000, embedding_clip: true)
            ])
        expect(bad.valid).to_equal(false)
        expect(bad.reason).to_equal("web-paint-chunk-producer-proof-mismatch")

    it "attests only an exact opaque flat Web rect before composition":
        val result = simple_web_layout_render_html_draw_ir_result(
            "<style>#box{width:24px;height:12px;background:#123456}</style><div id='box'></div>",
            80, 60)
        expect(result.producer_paint_chunk_proofs.len()).to_be_greater_than(0)
        expect(paint_chunk_proof_for(
            result.producer_paint_chunk_proofs, "box")).to_equal(
            CHUNK_OPAQUE_EXACT_RECT)
        val frame = web_paint_chunk_frame_from_composition_with_proofs(
            result.composition, result.producer_paint_chunk_proofs)
        expect(frame.valid).to_equal(true)
        expect(frame.culling_enabled).to_equal(false)
        expect(web_paint_chunk_frame_matches(
            frame, result.composition)).to_equal(true)
        val translucent = simple_web_layout_render_html_draw_ir_result(
            "<style>#box{width:24px;height:12px;background:rgba(18,52,86,.5)}</style><div id='box'></div>",
            80, 60)
        expect(paint_chunk_proof_for(
            translucent.producer_paint_chunk_proofs, "box")).to_equal(
            CHUNK_OPAQUE_UNKNOWN)
        val ancestor_opacity = simple_web_layout_render_html_draw_ir_result(
            "<style>#parent{opacity:.5}#box{width:24px;height:12px;background:#123456}</style><div id='parent'><div id='box'></div></div>",
            80, 60)
        expect(paint_chunk_proof_for(
            ancestor_opacity.producer_paint_chunk_proofs, "box")).to_equal(
            CHUNK_OPAQUE_UNKNOWN)

    it "builds the disabled sidecar only when explicitly requested":
        val result = simple_web_layout_render_html_draw_ir_result(
            "<style>#box{width:24px;height:12px;background:#123456}</style><div id='box'>ok</div>",
            80, 60)
        val frame = web_paint_chunk_frame_from_composition(result.composition)
        expect(frame.valid).to_equal(true)
        expect(frame.culling_enabled).to_equal(false)
        expect(web_paint_chunk_frame_matches(
            frame, result.composition)).to_equal(true)
        expect(frame.composition_id).to_equal(
            result.composition.composition_id)
        expect(frame.scene_key).to_equal(
            result.composition.scene_key)
