a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-LIB-GC-ASYNC-MUT-001
doc/01_research/local/REQ-LIB-GC-ASYNC-MUT-001.md
doc/03_plan/sys_test/REQ-LIB-GC-ASYNC-MUT-001.md
doc/04_architecture/REQ-LIB-GC-ASYNC-MUT-001.md
doc/05_design/REQ-LIB-GC-ASYNC-MUT-001.md
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001

# @cover src/lib/gc_async_mut/gpu/browser_engine/browser_script_execute.spl 90%
# @cover src/lib/gc_async_mut/gpu/browser_engine/browser_script_render.spl 90%
"""# Browser GPU-Runnable Script Load and Animation

Loads scripts into the browser script-render lane, executes them against the
rendered document, and drives animation ticks by re-rendering successive frames.
Verifies per-frame render evidence: pixel buffer size, frame-to-frame pixel
deltas for the animated element, and byte-identical output for static content.
"""

use std.spec.*

use std.gc_async_mut.gpu.browser_engine.browser_script_execute.{execute_scripts_in_html}
use std.gc_async_mut.gpu.browser_engine.browser_script_render.{
    render_html_to_pixels_with_scripts,
    browser_renderer_parse_html_with_scripts,
    BeScriptParseResult, BeScriptRenderResult}
use std.gc_async_mut.gpu.browser_engine.browser_renderer.{render_html_to_pixels_with_viewport}

val WIDTH: i32 = 40
val HEIGHT: i32 = 30
val WHITE_BG: u32 = 0xFFFFFFFF

# NOTE(bug): BeScriptRenderResult.pixels is empty on the live render path —
# BeRenderResult.success_html hard-codes `pixels: []` and carries the real
# frame in `pixel_data: [u32]`, which render_html_to_pixels_with_scripts does
# not forward. Per-frame pixel evidence below is therefore taken from the
# renderer's pixel_data lane for the same HTML.
fn _pixels_equal(a: [u32], b: [u32]) -> bool:
    if a.len() != b.len():
        return false
    var idx: i32 = 0
    while idx < a.len():
        if a[idx] != b[idx]:
            return false
        idx = idx + 1
    true

# Painted area: pixels that differ from the white page background.
fn _painted_area(pixels: [u32]) -> i64:
    var count: i64 = 0
    var idx: i32 = 0
    while idx < pixels.len():
        if pixels[idx] != WHITE_BG:
            count = count + 1
        idx = idx + 1
    count

fn _frame_pixels(html: text) -> [u32]:
    render_html_to_pixels_with_viewport(html, WIDTH, HEIGHT).pixel_data

fn _frame_html(tick: i64) -> text:
    val side = 8 + tick * 5
    val dim = side.to_text()
    "<html><head></head><body style='margin:0; background:#ffffff'>" +
        "<div style='width:" + dim + "px; height:" + dim + "px; background-color:#ff0000'></div>" +
        "<script>console.log(\"frame " + tick.to_text() + "\");</script>" +
        "</body></html>"

use std.spec.step

describe "Browser script load into render lane":

    context "script collection for the render session":

        it "collects an inline script body with empty type":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: collects an inline script body with empty type")
            val html = "<html><head></head><body><script>let x = 1</script></body></html>"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts[0]).to_equal("let x = 1")
            expect(result.script_types[0]).to_equal("")
            expect(result.src_paths.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "collects script type metadata from single-quoted attributes":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: collects script type metadata from single-quoted attributes")
            val html = "<html><body><script type='text/javascript'>let x = 1</script></body></html>"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.script_types[0]).to_equal("text/javascript")

        it "collects external src path and type from double-quoted attributes":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: collects external src path and type from double-quoted attributes")
            val html = "<html><head><script src=\"app.js\" type=\"module\"></script></head><body></body></html>"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.src_paths.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.src_paths[0]).to_equal("app.js")
            expect(result.src_types[0]).to_equal("module")

        it "collects multiple script bodies in document order":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: collects multiple script bodies in document order")
            val html = "<html><head><script>let a = 1</script></head><body><script>let b = 2</script></body></html>"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(result.scripts[0]).to_equal("let a = 1")
            expect(result.scripts[1]).to_equal("let b = 2")

        it "returns empty collection for script-free HTML":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: returns empty collection for script-free HTML")
            val html = "<html><head></head><body><div>hello</div></body></html>"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.src_paths.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "stops safely on an unterminated script tag":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: stops safely on an unterminated script tag")
            val html = "<html><body><script>let a = 1"
            val result = browser_renderer_parse_html_with_scripts(html)
            expect(result.scripts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.src_paths.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "constructs empty parse and render results with allocated evidence buffer":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: constructs empty parse and render results with allocated evidence buffer")
            val parse = BeScriptParseResult.empty()
            expect(parse.scripts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(parse.src_types.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            val render = BeScriptRenderResult.empty(WIDTH, HEIGHT)
            expect(render.pixels.len()).to_equal(WIDTH * HEIGHT * 4)
            expect(render.ok).to_equal(true)
            expect(render.scripts_collected).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(render.console_output.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "hardened script execution":

        it "executes a double-quoted console.log literal":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: executes a double-quoted console.log literal")
            val html = "<html><body><script>console.log(\"hello gpu\")</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_collected).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_denied).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.console_output.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("hello gpu")

        it "executes a single-quoted print literal":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: executes a single-quoted print literal")
            val html = "<html><body><script>print('tick')</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("tick")

        it "resolves assigned variables through print and console.log":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: resolves assigned variables through print and console.log")
            val html = "<html><body><script>const msg = \"animated\"; print(msg); console.log(msg);</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.console_output.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("animated")
            expect(result.console_output[1]).to_equal("animated")

        it "splits semicolon-joined statements and keeps output order":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: splits semicolon-joined statements and keeps output order")
            val html = "<html><body><script>console.log(\"one\");console.log(\"two\");print(\"three\")</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.console_output.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("one")
            expect(result.console_output[1]).to_equal("two")
            expect(result.console_output[2]).to_equal("three")

        it "normalizes carriage returns between statements":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: normalizes carriage returns between statements")
            val html = "<html><body><script>console.log(\"cr1\")\rconsole.log(\"cr2\")</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.console_output.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("cr1")
            expect(result.console_output[1]).to_equal("cr2")

        it "skips unknown statements and non-literal assignments without denying":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: skips unknown statements and non-literal assignments without denying")
            val html = "<html><body><script>let n = 41; n++; print(n); doSomething()</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_denied).to_equal(0)  # oracle: 0 — named expected value from the requirement
            # non-literal rhs stores empty value, print(n) emits nothing
            expect(result.console_output.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "denies external src scripts with a diagnostic":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: denies external src scripts with a diagnostic")
            val html = "<html><head><script src='cdn/app.js'></script></head><body></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_collected).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_denied).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_executed).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.diagnostics[0]).to_equal("external script src denied: cdn/app.js")

        it "denies unsupported script types with a diagnostic":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: denies unsupported script types with a diagnostic")
            val html = "<html><body><script type='text/simple'>let x = 1</script></body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_denied).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.diagnostics[0]).to_equal("unsupported script type denied: text/simple")

        it "executes all accepted browser JS type spellings":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: executes all accepted browser JS type spellings")
            val html = "<html><body>" +
                "<script type='text/javascript'>console.log(\"a\")</script>" +
                "<script type='application/javascript'>console.log(\"b\")</script>" +
                "<script type='MODULE'>console.log(\"c\")</script>" +
                "</body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_collected).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(result.scripts_executed).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(result.console_output.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "denies every host-escape family with the exact diagnostic":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: denies every host-escape family with the exact diagnostic")
            val html = "<html><body>" +
                "<script>host.shell(\"ls\")</script>" +
                "<script>spawn(\"sh\")</script>" +
                "<script>require(\"fs\")</script>" +
                "<script>let e = process.env</script>" +
                "<script>fs.readFile(\"/etc/passwd\")</script>" +
                "<script>fetch(\"http://x\")</script>" +
                "</body></html>"
            val result = execute_scripts_in_html(html)
            expect(result.scripts_collected).to_equal(6)  # oracle: 6 — named expected value from the requirement
            expect(result.scripts_denied).to_equal(6)  # oracle: 6 — named expected value from the requirement
            expect(result.scripts_executed).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.diagnostics.len()).to_equal(6)  # oracle: 6 — named expected value from the requirement
            expect(result.diagnostics[0]).to_equal("host shell access denied")
            expect(result.diagnostics[1]).to_equal("child process access denied")
            expect(result.diagnostics[2]).to_equal("module loader access denied")
            expect(result.diagnostics[3]).to_equal("ambient environment access denied")
            expect(result.diagnostics[4]).to_equal("filesystem access denied")
            expect(result.diagnostics[5]).to_equal("network access denied")

describe "Browser script render animation frames":

    context "render evidence per frame":

        it "merges render metadata and script execution into one frame result":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: merges render metadata and script execution into one frame result")
            val html = _frame_html(0)
            val result = render_html_to_pixels_with_scripts(html, WIDTH, HEIGHT)
            expect(result.ok).to_equal(true)
            expect(result.width).to_equal(WIDTH)
            expect(result.height).to_equal(HEIGHT)
            expect(result.scripts_collected).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(result.scripts_denied).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(result.console_output[0]).to_equal("frame 0")

        it "advances animation ticks with monotonically growing painted area":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: advances animation ticks with monotonically growing painted area")
            var previous_area: i64 = 0
            var tick: i64 = 0
            while tick < 4:
                val html = _frame_html(tick)
                val frame = render_html_to_pixels_with_scripts(html, WIDTH, HEIGHT)
                expect(frame.ok).to_equal(true)
                expect(frame.scripts_executed).to_equal(1)  # oracle: 1 — named expected value from the requirement
                expect(frame.console_output[0]).to_equal("frame " + tick.to_text())
                val pixels = _frame_pixels(html)
                expect(pixels.len()).to_equal(WIDTH * HEIGHT)
                val area = _painted_area(pixels)
                expect(area).to_be_greater_than(previous_area)
                previous_area = area
                tick = tick + 1

        it "produces different pixel evidence between consecutive animation frames":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: produces different pixel evidence between consecutive animation frames")
            val frame0 = _frame_pixels(_frame_html(0))
            val frame1 = _frame_pixels(_frame_html(1))
            expect(_pixels_equal(frame0, frame1)).to_equal(false)

        it "keeps static content pixel-identical while script output changes":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: keeps static content pixel-identical while script output changes")
            val base = "<html><body style='margin:0; background:#ffffff'>" +
                "<div style='width:8px; height:8px; background-color:#ff0000'></div>"
            val html_a = base + "<script>console.log(\"tick a\")</script></body></html>"
            val html_b = base + "<script>console.log(\"tick b\")</script></body></html>"
            expect(_pixels_equal(_frame_pixels(html_a), _frame_pixels(html_b))).to_equal(true)
            val frame_a = render_html_to_pixels_with_scripts(html_a, WIDTH, HEIGHT)
            val frame_b = render_html_to_pixels_with_scripts(html_b, WIDTH, HEIGHT)
            expect(frame_a.console_output[0]).to_equal("tick a")
            expect(frame_b.console_output[0]).to_equal("tick b")

        it "is deterministic for repeated renders of the same frame":
            # @req: REQ-LIB-GC-ASYNC-MUT-001
            step("Verify: is deterministic for repeated renders of the same frame")
            val html = _frame_html(2)
            expect(_pixels_equal(_frame_pixels(html), _frame_pixels(html))).to_equal(true)
