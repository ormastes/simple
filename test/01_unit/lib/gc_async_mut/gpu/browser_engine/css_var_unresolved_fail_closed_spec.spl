# CSS custom-property substitution: an UNRESOLVABLE `var()` must not be
# silently spliced out to the empty string.
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl 5%
#
# Regression guard for
# doc/08_tracking/bug/wm_guest_css_var_unresolved_blocks_material_admission_2026-08-09.md
#
# `_css_resolve_vars` used to substitute an undefined custom property with ""
# and still report the pass `Resolved`. CSS makes such a declaration invalid at
# computed-value time (css-variables-1 3.2); splicing empty instead
# manufactures a syntactically parseable but semantically WRONG value. On the
# `aetheric_dark` sheet that turned
#   backdrop-filter: blur(var(--blur-surface)) saturate(170%)
# into `blur() saturate(170%)` (21 chars, which the backdrop admission rejects
# because the blur term no longer ends in `px)`) and
#   background: linear-gradient(...), var(--app-surface)
# into `linear-gradient(...),` (73 chars, a bare trailing comma) whose colour
# was then read off the gradient's FIRST STOP rather than the surface. Those
# three numbers are exactly what the SimpleOS WM x86_64 lane reported, and they
# read as a theme/content mismatch instead of as dead variables.
#
# Fail-closed replacement: the `var(...)` source text is preserved verbatim, so
# the value is unparseable and stays a rejection witness downstream.

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_debug_style_by_id}

fn doc(css: text) -> text:
    "<html><head><style>" + css + "</style></head><body>" +
        "<div id=\"t\">x</div></body></html>"

fn probe(css: text, field: text) -> text:
    simple_web_layout_debug_style_by_id(doc(css), "t", field)

# The two `aetheric_dark` declarations at the heart of the WM lane rejection.
val DECLS: text = (
    "#t{background: linear-gradient(180deg, rgba(255,255,255,0.08), " +
    "rgba(255,255,255,0.025)), var(--app-surface);" +
    "backdrop-filter: blur(var(--blur-surface)) saturate(170%);}"
)

val ROOT: text = (
    ":root{--app-surface: rgba(31,31,33,0.80);--blur-surface: 30px;}"
)

describe "css var: undefined property is fail-closed, not spliced empty":

    it "keeps the var() source text when the property is undefined":
        val layers = probe(DECLS, "background_layers_raw")
        expect(layers.contains("var(--app-surface)")).to_be_true()

    it "does not emit the bare trailing comma that the old splice produced":
        val layers = probe(DECLS, "background_layers_raw")
        expect(layers.ends_with(",")).to_be_false()

    it "keeps the blur var() so the backdrop term is not degraded to blur()":
        val backdrop = probe(DECLS, "backdrop_filter_raw")
        expect(backdrop.contains("blur(var(--blur-surface))")).to_be_true()

    it "does not produce the degraded `blur()` term":
        val backdrop = probe(DECLS, "backdrop_filter_raw")
        expect(backdrop.contains("blur()")).to_be_false()

describe "css var: a DEFINED property still resolves":

    it "substitutes the surface colour when :root is in scope":
        val layers = probe(ROOT + DECLS, "background_layers_raw")
        expect(layers.contains("rgba(31,31,33,0.80)")).to_be_true()

    it "leaves no literal var() behind when :root is in scope":
        val layers = probe(ROOT + DECLS, "background_layers_raw")
        expect(layers.contains("var(")).to_be_false()

    it "resolves the blur length to a px term":
        val backdrop = probe(ROOT + DECLS, "backdrop_filter_raw")
        expect(backdrop.contains("blur(30px)")).to_be_true()

describe "css var: an explicit fallback still wins over the source text":

    it "uses the fallback for an undefined property":
        val layers = probe(
            "#t{background: linear-gradient(180deg, rgba(9,9,9,0.1), " +
            "rgba(8,8,8,0.2)), var(--missing, rgba(1,2,3,0.5));}",
            "background_layers_raw"
        )
        expect(layers.contains("rgba(1,2,3,0.5)")).to_be_true()
