"""Layout-phase coverage spec for the simple_web_html_layout_renderer family.

The web-rendering pipeline is tokenize -> dom -> style -> layout -> paint ->
tiles -> present. The LAYOUT phase modules had never been measured at all; this
spec drives their PUBLIC entry points so `SIMPLE_COVERAGE=1` reports a real
number for each file instead of an unmeasured blank.

Every example drives a public `simple_web_layout_*` entry point -- no private
internals are imported. The fixtures are picked from the measured uncovered-line
map rather than guessed, and every expectation was read off a throwaway probe
before being asserted (that is how `animation_end_ms` on an `infinite`
animation turned out to be -2, not the -1 a guess would have written).

Framebuffers are deliberately tiny. The paint primitives under measurement
(`fb_background_radial_stack_clip`, `fb_soft_box_shadow`,
`fb_rounded_rect_opacity_clip`) are per-pixel loops, so raster cost is the
budget here: one feature per small fixture keeps the whole spec affordable
while still entering each primitive. A single 96x192 tile-parity pair pushed an
earlier revision of this spec past 25 minutes.

@tag: rendering, simple-web, layout, coverage
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_decl_apply.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_foundation.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_primitives.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_tiles.spl
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_style.spl
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result,
    simple_web_layout_render_html_draw_ir_result_at_time,
    simple_web_layout_render_html_software_pixels,
    simple_web_layout_render_html_software_pixels_at_scroll,
    simple_web_layout_render_html_software_pixels_traced,
    simple_web_layout_render_html_software_pixels_tile_lane,
    simple_web_layout_render_html_gpu_frame,
    simple_web_layout_debug_gpu_paint_state_visits,
    simple_web_layout_reconcile_animation_instances,
    simple_web_layout_animation_instances_next_ms,
    simple_web_layout_animation_end_ms,
    simple_web_layout_animation_needs_layout,
    simple_web_layout_hit_test_target_at_time,
    simple_web_layout_debug_capped_node_count,
    simple_web_layout_debug_capped_input_node_count,
    simple_web_layout_debug_dump_nodes,
    simple_web_layout_debug_attr_by_id,
    simple_web_layout_debug_layout_by_id,
    simple_web_layout_debug_style_by_id,
    simple_web_layout_uses_legacy_widget_chrome
}

# --- fixtures ---------------------------------------------------------------
# A single-property brace group like {color:red} lexes as a string
# interpolation ({var:format}); every CSS brace below is doubled to escape it.

fn _head(rules: text) -> text:
    "<html><head><style>html,body{{margin:0;padding:0;background:#ffffff}}" +
        rules + "</style></head><body>"

fn _grad_doc() -> text:
    _head(".lin{{background:linear-gradient(90deg,#ff0000 0%,#00ff00 50%,#0000ff 100%);height:8px}}" +
          ".lin2{{background:linear-gradient(to right,#123456,#abcdef);height:6px}}") +
        "<div class=\"lin\"></div><div class=\"lin2\"></div></body></html>"

fn _rad_doc() -> text:
    _head(".rad{{background:radial-gradient(circle at 30% 40%,#ffff00 0%,#ff00ff 100%);height:8px}}") +
        "<div class=\"rad\"></div></body></html>"

fn _shadow_doc() -> text:
    _head(".soft{{box-shadow:3px 3px 5px #64748b;background:#e2e8f0;height:8px;margin:4px}}") +
        "<div class=\"soft\"></div></body></html>"

fn _round_doc() -> text:
    _head(".round{{border-radius:6px;background:#3b82f6;height:8px;opacity:0.5}}" +
          ".frac{{opacity:0.25;background:#10b981;height:6px}}") +
        "<div class=\"round\"></div><div class=\"frac\"></div></body></html>"

fn _text_doc() -> text:
    _head(".under{{text-decoration:underline;color:#0000ff;font-size:10px}}") +
        "<p class=\"under\">underlined &#65;&#x42;&amp;&lt;&gt;</p></body></html>"

fn _anim_doc() -> text:
    "<html><head><style>" +
        "html,body{{margin:0;padding:0;background:#ffffff}}" +
        "@keyframes slide{{from{{left:0px}}to{{left:100px}}}}" +
        "@keyframes fade{{0%{{opacity:0.1}}50%{{opacity:0.6}}100%{{opacity:1}}}}" +
        ".a1{{animation:slide 2s linear 0s infinite alternate;height:8px;background:#ef4444}}" +
        ".a2{{animation:fade 1500ms ease-in-out 250ms 3 normal;height:8px;background:#22c55e}}" +
        ".t1{{transition:opacity 300ms ease 100ms;height:6px;background:#3b82f6}}" +
        "</style></head><body>" +
        "<div class=\"a1\"></div><div class=\"a2\"></div><div class=\"t1\"></div>" +
        "</body></html>"

fn _selector_doc() -> text:
    """Attribute, :nth-child, :not and media-query selectors plus z-index and
    specificity ordering -- the core selector clusters measured as never-called."""
    "<html><head><style>" +
        "html,body{{margin:0;padding:0;background:#ffffff}}" +
        "div[data-role]{{color:#111111}}" +
        "div[data-role=\"card\"]{{background:#3b82f6}}" +
        "div[data-tags~=\"beta\"]{{border:1px solid #ff0000}}" +
        "li:nth-child(2){{background:#fde68a}}" +
        "li:nth-child(2n+1){{color:#dc2626}}" +
        "li:first-child{{font-weight:bold}}" +
        "li:last-child{{font-style:italic}}" +
        "div:not(.skip){{padding:2px}}" +
        "section > p{{margin:4px}}" +
        ".z1{{position:relative;z-index:5;background:#22c55e;height:6px}}" +
        ".z2{{position:relative;z-index:-1;background:#a855f7;height:6px}}" +
        ".z3{{position:relative;z-index:10;background:#f97316;height:6px}}" +
        "@media (max-width:2000px){{.wide{{color:#0000ff}}}}" +
        "@media (min-width:99999px){{.never{{color:#00ff00}}}}" +
        "</style></head><body>" +
        "<div id=\"c1\" data-role=\"card\" data-tags=\"alpha beta\">card</div>" +
        "<div class=\"skip\">skipped</div>" +
        "<ul><li>one</li><li>two</li><li>three</li></ul>" +
        "<section><p>para</p></section>" +
        "<div class=\"z1\"></div><div class=\"z2\"></div><div class=\"z3\"></div>" +
        "<div class=\"wide\">wide</div>" +
        "</body></html>"

fn _layout_doc() -> text:
    """Block, inline, flex, grid, table, positioning and wrapping."""
    "<html><head><style>" +
        "html,body{{margin:0;padding:0;background:#ffffff;color:#111111}}" +
        ".flex{{display:flex;flex-direction:row;gap:4px;height:16px}}" +
        ".rev{{display:flex;flex-direction:row-reverse;height:10px}}" +
        ".item{{flex:1 1 0%;background:#ef4444;min-width:6px}}" +
        ".grid{{display:grid;grid-template-columns:1fr 2fr;height:16px}}" +
        ".abs{{position:absolute;top:4px;left:6px;width:10px;height:8px;background:#000000}}" +
        ".rel{{position:relative;top:2px;height:8px;background:#888888}}" +
        ".stick{{position:sticky;top:0px;height:6px;background:#cccccc}}" +
        ".ib{{display:inline-block;width:12px;height:8px;background:#0ea5e9}}" +
        ".wrapped{{width:40px;font-size:8px;line-height:10px}}" +
        ".ell{{width:24px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}" +
        "table{{border-collapse:collapse;border-spacing:2px}}" +
        "td{{border:1px solid #333333;padding:1px}}" +
        "</style></head><body>" +
        "<h1>Head</h1><h2>Sub</h2>" +
        "<div class=\"flex\"><div class=\"item\">a</div><div class=\"item\">b</div></div>" +
        "<div class=\"rev\"><div class=\"item\">r1</div><div class=\"item\">r2</div></div>" +
        "<div class=\"grid\"><div>g1</div><div>g2</div></div>" +
        "<div class=\"abs\"></div><div class=\"rel\"></div><div class=\"stick\"></div>" +
        "<span class=\"ib\">ib</span>" +
        "<p class=\"wrapped\">the quick brown fox jumps</p>" +
        "<p class=\"ell\">an overlong single line</p>" +
        "<table><tr><td>c1</td><td>c2</td></tr><tr><td>c3</td><td>c4</td></tr></table>" +
        "<ul><li>one</li><li>two</li></ul><ol><li>first</li></ol>" +
        "<input type=\"text\" value=\"typed\">" +
        "<details><summary>more</summary><p>hidden</p></details>" +
        "</body></html>"

fn _lane_doc() -> text:
    """Light raster fixture: solid boxes, a border and some text -- enough to
    enter the paint and tile lanes without the table/flex/grid cost of
    `_layout_doc`, which the (much cheaper) draw-ir path already covers."""
    _head(".a{{height:8px;background:#3b82f6}}" +
          ".b{{height:6px;background:#ef4444;border:1px solid #333333}}" +
          ".c{{height:6px;background:#22c55e;margin:2px}}") +
        "<div class=\"a\">t1</div><div class=\"b\"></div><div class=\"c\">t2</div>" +
        "</body></html>"

fn _box_doc() -> text:
    """One absolutely-sized box, for exact layout/style read-back assertions."""
    "<html><head><style>html,body{{margin:0}}" +
        "#b1{{width:20px;height:10px;background:#3b82f6;color:#ff0000}}" +
        "</style></head><body><div id=\"b1\">x</div></body></html>"

# --- examples ---------------------------------------------------------------

describe "layout phase: draw-ir composition lane":

    it "composes a non-empty batch list for a full-feature document":
        val res = simple_web_layout_render_html_draw_ir_result(_layout_doc(), 64, 64)
        expect(res.composition.batches.len() > 0).to_be(true)

    it "composes the selector document":
        val res = simple_web_layout_render_html_draw_ir_result(_selector_doc(), 64, 64)
        expect(res.composition.batches.len() > 0).to_be(true)

    it "composes the animation document at a mid-animation time":
        val res = simple_web_layout_render_html_draw_ir_result_at_time(_anim_doc(), 48, 32, 700)
        expect(res.composition.batches.len() > 0).to_be(true)

    it "reports that an animation touching a layout property needs relayout":
        # measured: `slide` animates `left`, a layout property, so the frame
        # cannot be replayed from the retained display list alone. A fixture
        # animating only `opacity` is the false case.
        val res = simple_web_layout_render_html_draw_ir_result_at_time(_anim_doc(), 48, 32, 700)
        expect(simple_web_layout_animation_needs_layout(res)).to_be(true)

describe "layout phase: paint primitives":

    # These assert PIXEL CONTENT, not buffer length. A length-only expectation
    # stays green with the painter sabotaged, so each count below was read off
    # a probe and pins what the primitive actually put in the framebuffer.
    # `_distinct` is the number of distinct ARGB values in the frame.

    fn _distinct(px: [u32]) -> i32:
        var seen: dict<text, bool> = {}
        var n = 0
        for p in px:
            val k = "{p}"
            if not seen.contains_key(k):
                seen[k] = true
                n = n + 1
        n

    it "blends a soft box shadow across many intermediate values":
        # The load-bearing one: 78 distinct values over a 32x24 frame can only
        # come from `fb_soft_box_shadow` actually running its falloff. A solid
        # fill would leave 2 or 3.
        val px = simple_web_layout_render_html_software_pixels(_shadow_doc(), 32, 24, 3600000)
        expect(px.len()).to_be(768)
        expect(_distinct(px) > 10).to_be(true)

    it "rasters a linear-gradient stack":
        val px = simple_web_layout_render_html_software_pixels(_grad_doc(), 32, 24, 3600000)
        expect(px.len()).to_be(768)
        expect(_distinct(px)).to_be(3)

    it "rasters rounded corners under fractional opacity":
        val px = simple_web_layout_render_html_software_pixels(_round_doc(), 32, 24, 3600000)
        expect(px.len()).to_be(768)
        expect(_distinct(px)).to_be(3)

    it "enters the radial-gradient painter":
        # Measured: this fixture currently resolves to 2 distinct values, i.e.
        # the radial stack flattens to a solid fill at this box size rather
        # than painting a visible ramp. The example is kept because it does
        # enter `fb_background_radial_stack_clip`, and the pinned count will
        # move the day that flattening changes -- it is NOT evidence that a
        # radial gradient renders correctly.
        val px = simple_web_layout_render_html_software_pixels(_rad_doc(), 32, 24, 3600000)
        expect(px.len()).to_be(768)
        expect(_distinct(px)).to_be(2)

    it "rasters a text run carrying decoded numeric entities":
        # Same caveat: 2 distinct values means no glyph ink landed in this
        # frame. Pinned as measured, not asserted as a rendering guarantee.
        val px = simple_web_layout_render_html_software_pixels(_text_doc(), 40, 24, 3600000)
        expect(px.len()).to_be(960)
        expect(_distinct(px)).to_be(2)

describe "layout phase: software raster lane":

    it "rasters the paint lane end to end":
        expect(simple_web_layout_render_html_software_pixels(_lane_doc(), 48, 48, 3600000).len()).to_be(2304)

    it "rasters at a scroll offset":
        expect(simple_web_layout_render_html_software_pixels_at_scroll(_lane_doc(), 48, 48, 20, 3600000).len()).to_be(2304)

    it "returns an empty buffer for a zero-width viewport":
        expect(simple_web_layout_render_html_software_pixels_at_scroll(_lane_doc(), 0, 48, 0, 3600000).len()).to_be(0)

    it "rasters the full-feature layout document":
        expect(simple_web_layout_render_html_software_pixels(_layout_doc(), 32, 32, 3600000).len()).to_be(1024)

    it "rasters through the traced lane":
        expect(simple_web_layout_render_html_software_pixels_traced(_box_doc(), 32, 24).len()).to_be(768)

describe "layout phase: tile lane parity":

    it "produces identical pixels through the tiled and classic lanes":
        val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
            _lane_doc(), 32, 32, 0, 32, true)
        val classic = simple_web_layout_render_html_software_pixels_tile_lane(
            _lane_doc(), 32, 32, 0, 32, false)
        expect(tiled.len()).to_be(classic.len())
        expect(tiled).to_be(classic)

describe "layout phase: gpu display-list frame":

    it "builds a gpu paint frame carrying solid-fill ops":
        val frame = simple_web_layout_render_html_gpu_frame(_lane_doc(), 48, 48, 3600000)
        expect(frame.width).to_be(48)
        expect(frame.height).to_be(48)
        expect(frame.fill_ops.len() > 0).to_be(true)

    it "counts gpu paint state visits":
        expect(simple_web_layout_debug_gpu_paint_state_visits(_lane_doc(), 64) >= 0).to_be(true)

describe "layout phase: css animation scheduling":

    it "reconciles animation instances and schedules their next tick":
        val insts = simple_web_layout_reconcile_animation_instances(_anim_doc(), 64, 0, 0, false, [])
        expect(insts.len() > 0).to_be(true)
        expect(simple_web_layout_animation_instances_next_ms(insts, 0) >= 0).to_be(true)

    it "reports no next tick for an empty instance list":
        expect(simple_web_layout_animation_instances_next_ms([], 0)).to_be(-1)

    it "reports the -2 never-ends sentinel for an infinite animation":
        # measured, not guessed: -1 means "no @keyframes at all", -2 means
        # "declared, but never reaches an end time".
        expect(simple_web_layout_animation_end_ms(_anim_doc(), 64)).to_be(-2)

    it "reports -1 end time for a document with no @keyframes":
        expect(simple_web_layout_animation_end_ms(_layout_doc(), 64)).to_be(-1)

describe "layout phase: hit testing and debug read-back":

    it "hit tests a point inside the document":
        expect(simple_web_layout_hit_test_target_at_time(_layout_doc(), 64, 64, 4, 4, 0).len() >= 0).to_be(true)

    it "reads laid-out geometry back by node id":
        expect(simple_web_layout_debug_layout_by_id(_box_doc(), 64, 48, "b1", "w")).to_be("20")
        expect(simple_web_layout_debug_layout_by_id(_box_doc(), 64, 48, "b1", "h")).to_be("10")
        expect(simple_web_layout_debug_layout_by_id(_box_doc(), 64, 48, "b1", "x")).to_be("0")

    it "reads a resolved style field back by node id":
        # `color` is not one of the fields this debug entry answers; `display`
        # is, and a bare <div> resolves to block.
        expect(simple_web_layout_debug_style_by_id(_box_doc(), "b1", "display")).to_be("block")

    it "reads an attribute back by node id":
        expect(simple_web_layout_debug_attr_by_id(_selector_doc(), "c1", "data-role")).to_be("card")

    it "counts capped nodes and capped input bytes":
        expect(simple_web_layout_debug_capped_node_count(_layout_doc(), 4096) > 0).to_be(true)
        expect(simple_web_layout_debug_capped_input_node_count(_layout_doc(), 65536) > 0).to_be(true)

    it "dumps parsed nodes":
        expect(simple_web_layout_debug_dump_nodes(_layout_doc()).len() > 0).to_be(true)

    it "classifies legacy widget chrome usage":
        expect(simple_web_layout_uses_legacy_widget_chrome(_layout_doc())).to_be(false)
