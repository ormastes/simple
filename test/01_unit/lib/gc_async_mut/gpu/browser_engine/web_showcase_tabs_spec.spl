# @req REQ-WEB4K-003
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.web_showcase_tabs.*

describe "Web showcase tabs":
    it "starts with one selected and focused overview tab":
        val state = web_showcase_state()
        expect(state.tabs.len()).to_equal(7)
        expect(state.focused_index).to_equal(0)
        expect(state.selected_index).to_equal(0)
        val html = web_showcase_tab_markup(state)
        expect(html).to_contain("role=\"tablist\"")
        expect(html).to_contain("role=\"tabpanel\"")
        expect(html).to_contain("aria-selected=\"true\"")

    it "moves focus without changing selection and activates by keyboard":
        val initial = web_showcase_state()
        val focused = web_showcase_focus_key(initial, "ArrowRight")
        expect(focused.focused_index).to_equal(1)
        expect(focused.selected_index).to_equal(0)
        val active = web_showcase_activate_focused(focused, "Enter")
        expect(active.selected_index).to_equal(1)

    it "wraps arrow focus and supports Home and End":
        val initial = web_showcase_state()
        val left = web_showcase_focus_key(initial, "ArrowLeft")
        expect(left.focused_index).to_equal(6)
        val home = web_showcase_focus_key(left, "Home")
        expect(home.focused_index).to_equal(0)
        val last = web_showcase_focus_key(home, "End")
        expect(last.focused_index).to_equal(6)

    it "uses the same selected and focused state for pointer activation":
        val active = web_showcase_activate_pointer(web_showcase_state(), 4)
        expect(active.focused_index).to_equal(4)
        expect(active.selected_index).to_equal(4)
        expect(web_showcase_tab_markup(active)).to_contain("panel-forms-media")

    it "fails closed for malformed empty or out-of-range state":
        val empty = WebShowcaseState(tabs: [], focused_index: 9, selected_index: 9)
        expect(web_showcase_tab_markup(empty)).to_equal("")
        expect(web_showcase_focus_key(empty, "ArrowRight").tabs.len()).to_equal(0)
        val invalid = WebShowcaseState(tabs: web_showcase_tabs(), focused_index: 0, selected_index: 99)
        expect(web_showcase_tab_markup(invalid)).to_equal("")
