# Simple Web CPU raster parity adapter: render fixture to RGBA8 and exact-compare.
# @req REQ-SSPEC-LIB
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.rendering_parity_adapter.{
    simple_web_rendering_parity_render_rgba8, simple_web_rendering_parity_check
}

describe "Simple Web rendering parity CPU render":
    it "renders a fixture to tightly packed RGBA8":
        val html = "<style>body{margin:0;background:#102030}</style><div></div>"
        val rgba = simple_web_rendering_parity_render_rgba8(html, 8, 4).unwrap()
        expect(rgba.len()).to_equal(8 * 4 * 4)
        expect(rgba[3]).to_equal(0xFFu8)

    it "rejects a non-positive viewport":
        expect(simple_web_rendering_parity_render_rgba8("<div></div>", 0, 4).is_err()).to_be(true)

    it "passes against its own frame and fails against a perturbed frame":
        val html = "<style>body{margin:0;background:#102030}#b{width:4px;height:4px;background:#abcdef}</style><div id=\"b\"></div>"
        val frame = simple_web_rendering_parity_render_rgba8(html, 8, 8).unwrap()
        val same = simple_web_rendering_parity_check(html, frame, 8, 8)
        expect(same.status).to_equal("pass")
        var bad = frame
        bad[0] = (frame[0] + 1u8)
        val diff = simple_web_rendering_parity_check(html, bad, 8, 8)
        expect(diff.status).to_equal("fail")
        expect(diff.reason).to_contain("differ")

    it "reports unsupported with a reason when the render cannot run":
        val v = simple_web_rendering_parity_check("<div></div>", [], 0, 4)
        expect(v.status).to_equal("unsupported")
        expect(v.reason).to_contain("viewport")
