"""Regression contract for browser custom-property CSS type ownership."""

use std.io_runtime.{file_read}
use std.spec.*

describe "browser custom-property CSS type ownership":
    it "uses the compatible browser-style declaration owner":
        val source = file_read("src/lib/gc_async_mut/gpu/browser_engine/style/custom_properties.spl")
        val animation = file_read("src/lib/gc_async_mut/gpu/browser_engine/style/animation.spl")
        expect(source).to_contain("use std.gc_async_mut.gpu.browser_engine.style.animation.{CSSValue, CSSDeclaration}")
        expect(source).to_not_contain("use examples.browser.entity.dom.css_types")
        expect(source).to_contain("CSSValue.Initial")
        expect(source).to_contain("important: decl.important")
        expect(animation).to_contain("enum CSSValue:")
        expect(animation).to_contain("Initial")
        expect(animation).to_contain("class CSSDeclaration:")
        expect(animation).to_contain("important: bool")
