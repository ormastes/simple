# @tag:unit, gpu, web, bootstrap

use std.spec.*

extern fn rt_file_read_text(path: text) -> text
extern fn rt_dir_walk(path: text) -> [text]

describe "Simple web HTML layout renderer module split":
    it "keeps every parser input below 128 KiB":
        val root = "src/lib/gc_async_mut/gpu/browser_engine/"
        var discovered = 0
        for path in rt_dir_walk(root):
            if path.contains("simple_web_html_layout_renderer") and path.ends_with(".spl"):
                val source = rt_file_read_text(path) ?? ""
                expect(source.len()).to_be_greater_than(0)
                expect(source.len()).to_be_less_than(128 * 1024)
                discovered = discovered + 1
        expect(discovered).to_be_greater_than(0)

    it "keeps every required split module present and discoverable":
        val root = "src/lib/gc_async_mut/gpu/browser_engine/"
        val names = [
            "simple_web_html_layout_renderer.spl",
            "simple_web_html_layout_renderer_core.spl",
            "simple_web_html_layout_renderer_core_css_rules.spl",
            "simple_web_html_layout_renderer_core_selectors.spl",
            "simple_web_html_layout_renderer_core_types.spl",
            "simple_web_html_layout_renderer_decl_apply.spl",
            "simple_web_html_layout_renderer_declarations.spl",
            "simple_web_html_layout_renderer_foundation.spl",
            "simple_web_html_layout_renderer_geometry.spl",
            "simple_web_html_layout_renderer_layout.spl",
            "simple_web_html_layout_renderer_layout_engine.spl",
            "simple_web_html_layout_renderer_layout_foundation.spl",
            "simple_web_html_layout_renderer_paint_layout.spl",
            "simple_web_html_layout_renderer_paint_primitives.spl",
            "simple_web_html_layout_renderer_paint_raster.spl",
            "simple_web_html_layout_renderer_paint_tiles.spl",
            "simple_web_html_layout_renderer_paint_tiles_gpu.spl",
            "simple_web_html_layout_renderer_style.spl"
        ]
        for name in names:
            val source = rt_file_read_text(root + name) ?? ""
            expect(source.len()).to_be_greater_than(0)

        # The fixed list catches deletion of a required helper.  The directory
        # walk catches a newly added family module that was omitted from it.
        var discovered = 0
        for path in rt_dir_walk(root):
            if path.contains("simple_web_html_layout_renderer") and path.ends_with(".spl"):
                discovered = discovered + 1
        expect(discovered).to_equal(names.len())

    it "keeps the original module as the public facade":
        val facade = rt_file_read_text("src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""

        expect(facade).to_contain("export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.*")
        expect(facade).to_contain("export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_layout.*")
        expect(facade).to_contain("class SimpleWebLayoutDrawIrResult:")
        expect(facade).to_contain("class SimpleWebLayoutPixelResult:")
        expect(facade).to_contain("class WebGpuPaintFrame:")
        expect(facade).to_contain("pub fn simple_web_layout_render_html_software_pixels(")
        expect(facade).to_contain("pub fn simple_web_layout_render_html_gpu_frame(")
