# @tag:unit, gpu, web, bootstrap

use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "Simple web HTML layout renderer module split":
    it "keeps every parser input below 128 KiB":
        val facade = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""
        val foundation = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_foundation.spl") ?? ""
        val style = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_style.spl") ?? ""
        val declarations = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_declarations.spl") ?? ""
        val decl_apply = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_decl_apply.spl") ?? ""
        val core = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl") ?? ""
        val primitives = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_primitives.spl") ?? ""
        val layout = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl") ?? ""
        val paint = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_layout.spl") ?? ""

        expect(facade.len()).to_be_less_than(128 * 1024)
        expect(foundation.len()).to_be_less_than(128 * 1024)
        expect(style.len()).to_be_less_than(128 * 1024)
        expect(declarations.len()).to_be_less_than(128 * 1024)
        expect(decl_apply.len()).to_be_less_than(128 * 1024)
        expect(core.len()).to_be_less_than(128 * 1024)
        expect(primitives.len()).to_be_less_than(128 * 1024)
        expect(layout.len()).to_be_less_than(128 * 1024)
        expect(paint.len()).to_be_less_than(128 * 1024)
        expect(foundation).to_contain("rt_time_now_micros()")
        expect(foundation.contains(
            "rt_time_now_unix_micros()"
        )).to_be(false)
        expect(declarations).to_contain("st.display = display_v")
        expect(declarations).to_contain("st.text_align = text_align_v")
        expect(declarations).to_contain("st.resolved_font_advances = []")
        expect(decl_apply).to_contain("st.display = display_v")
        expect(decl_apply).to_contain("st.background_gradient_from = background_gradient_from_v")
        expect(decl_apply.contains("Style(bg: bg_v")).to_be(false)

    it "uses a globally unique free-function name for browser box layout":
        val facade = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""
        val layout = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout.spl") ?? ""

        expect(layout).to_contain("fn simple_web_layout_boxes(")
        expect(layout).to_contain("val computed = simple_web_layout_boxes(")
        expect(facade).to_contain("val raw_boxes = simple_web_layout_boxes(")
        expect(facade.contains("val raw_boxes = layout(")).to_be(false)

    it "keeps the original module as the public facade":
        val facade = rt_file_read_text("src/std/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer.spl") ?? ""

        expect(facade).to_contain("export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.*")
        expect(facade).to_contain("export use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_layout.*")
        expect(facade).to_contain("class SimpleWebLayoutDrawIrResult:")
        expect(facade).to_contain("class SimpleWebLayoutPixelResult:")
        expect(facade).to_contain("class WebGpuPaintFrame:")
        expect(facade).to_contain("pub fn simple_web_layout_render_html_software_pixels(")
        expect(facade).to_contain("pub fn simple_web_layout_render_html_gpu_frame(")
