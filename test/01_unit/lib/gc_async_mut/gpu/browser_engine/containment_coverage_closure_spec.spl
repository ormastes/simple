# U4.4 coverage closure for containment.spl. Baseline (containment_contain_spec.spl
# alone, artifact-measured via SIMPLE_COVERAGE_OUTPUT): 87% (28/32 lines) —
# uncovered lines were containment.spl:43-45 (contain_has_token's mid-string
# token-match branch, only reachable with a MULTI-token `contain` value where
# the target token is not the last one) and containment.spl:126 (the
# `state.cached.contains_key(node_id)` branch inside layout_contain_mark_dirty,
# only reachable when marking dirty a node that already has a cache entry).
#
# This spec closes both gaps with real oracle assertions (no assertion-free
# calls): it does not re-derive contain_has_token's algorithm, it exercises
# the exported node_contains_* / layout_contain_* API exactly as the rest of
# the package does and asserts on real return values.
#
# @cover src/lib/gc_async_mut/gpu/browser_engine/containment.spl
use std.spec.{describe, it, expect}

use std.gc_async_mut.gpu.browser_engine.dom.{BeDomNode, StyleProps}
use std.gc_async_mut.gpu.browser_engine.containment.{
    node_contains_layout, node_contains_paint, node_contains_style,
    new_layout_contain_state, layout_contain_compute, layout_contain_mark_dirty}

fn el(node_id: i64, tag: text, contain_val: text, kids: [BeDomNode]) -> BeDomNode:
    var attrs: Dict<text, text> = {}
    attrs["class"] = tag
    if contain_val != "":
        attrs["contain"] = contain_val
    BeDomNode(
        node_id: node_id,
        tag_name: tag,
        data: "",
        attributes: attrs,
        style: StyleProps.empty(),
        children: kids,
        parent_id: -1,
        event_listener_types: [],
        event_listener_actions: [],
        event_listener_capture: [])

describe "containment.spl coverage closure":

    it "contain_has_token matches a token that is NOT the last one in a multi-token contain value":
        # "layout paint" — "layout" is found mid-string (idx > seg_start,
        # slice matches, hits the return-true branch at line 44), not via
        # the tail-segment fallback at line 47/48.
        val node = el(5, "div", "layout paint", [])
        expect(node_contains_layout(node)).to_equal(true)
        expect(node_contains_paint(node)).to_equal(true)
        # A token that is absent even though a prefix-sharing token is
        # present must NOT match (proves the mid-string branch does a real
        # segment-boundary compare, not a substring search).
        expect(node_contains_style(node)).to_equal(false)

    it "layout_contain_mark_dirty on a node that already has a cache entry re-evaluates the existing-entry branch":
        var lstate = new_layout_contain_state()
        val grandchild = el(8, "span", "", [])
        val node = el(6, "div", "layout", [grandchild])

        # First compute populates state.cached[node_id] = true and, because
        # the node has a child, exercises box_measure's recursive descent
        # (containment.spl:137-138).
        val h1 = layout_contain_compute(lstate, node, 0, 0)

        # Recompute with nothing marked dirty: must hit the cache (the
        # `state.cached[nid]` == true fast-return branch, containment.spl:147)
        # rather than recompute.
        val recompute_after_first = lstate.recompute_count
        val h_cached = layout_contain_compute(lstate, node, 0, 0)
        expect(h_cached).to_equal(h1)
        expect(lstate.recompute_count).to_equal(recompute_after_first)

        # Mark dirty AGAIN while a cache entry already exists: this is the
        # `state.cached.contains_key(node_id)` == true branch (line 126),
        # which flips the existing entry to false rather than a no-op.
        layout_contain_mark_dirty(lstate, node.node_id)
        val recompute_before = lstate.recompute_count
        val h2 = layout_contain_compute(lstate, node, 0, 0)
        expect(h2).to_equal(h1)
        expect(lstate.recompute_count > recompute_before).to_equal(true)

        # Marking dirty a node with NO cache entry yet must not crash (the
        # contains_key == false side of the same branch).
        val fresh = el(7, "div", "layout", [])
        layout_contain_mark_dirty(lstate, fresh.node_id)
        expect(lstate.dirty_below[fresh.node_id]).to_equal(true)
