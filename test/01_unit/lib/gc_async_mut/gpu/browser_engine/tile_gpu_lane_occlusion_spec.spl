# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_tiles_gpu.spl 5%

use std.spec.{describe, it, expect}
use common.ui.draw_ir.draw_ir_rect
use std.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles_gpu.tile_lane_render_commands

describe "Web tile lane consumes DrawIR opaque barriers":
    it "reports the same exact skip and pixels on software and Vulkan lanes":
        val commands = [
            draw_ir_rect("under", 0, 0, 128, 128, 0xFFDC2626u32),
            draw_ir_rect("barrier", 0, 0, 128, 128, 0xFF2563EBu32)
        ]
        val cpu = tile_lane_render_commands(
            commands, 128, 128, 128, 128, 0, 0xFF000000u32, "software")
        val gpu = tile_lane_render_commands(
            commands, 128, 128, 128, 128, 0, 0xFF000000u32, "vulkan")
        expect(cpu.ops_occluded).to_equal(1)
        expect(cpu.ops_rendered).to_equal(1)
        expect(gpu.ops_occluded).to_equal(1)
        expect(gpu.ops_rendered).to_equal(1)
        expect(gpu.pixels).to_equal(cpu.pixels)
        expect(cpu.pixels).to_equal([0xFF2563EBu32; 16384])
