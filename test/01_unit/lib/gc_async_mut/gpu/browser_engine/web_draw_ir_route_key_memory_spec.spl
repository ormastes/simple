"""
## Purpose and audience

Purpose: guard the bounded, collision-resistant Draw IR route-cache identity.
Audience: renderer maintainers reviewing retained-memory and stale-frame risks.

## Operator workflow

Inspect the owning implementation and confirm that retained keys use SHA-256
plus encoded byte length rather than the serialized scene or legacy DJB2 hash.

## Verification guidance

This is a source-contract unit guard, not rendering or performance acceptance.

## Recovery and troubleshooting

If the key format changes, update this guard only after cache invalidation and
stale-frame tests establish the replacement contract.

research: doc/01_research/local/web_renderer_vulkan_4k_showcase_hardening.md
plan: doc/03_plan/sys_test/web_renderer_vulkan_4k_showcase_hardening.md
architecture: doc/04_architecture/web_renderer_vulkan_4k_showcase_hardening.md
design: doc/05_design/web_renderer_vulkan_4k_showcase_hardening.md
"""

# @tag: web, draw-ir, gpu, memory
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_layout_engine2d_fast.spl

use std.spec.*
use std.io_runtime.{file_read}
use std.common.spec.scenario_helpers.{capture_text}

val ROUTE_KEY_NOT_FOUND: i64 = -1

# @manual_section: Supporting cache-key source contract
describe "Draw IR route key memory":
    # @capture(text)
    it "should retain a document identity rather than any per-frame content":
        # @req REQ-WEB4K-005 REQ-WEB4K-008
        # Superseded 2026-09-11: the key used to carry the composition
        # generation, falling back to a SHA-256 of the serialized scene. Both
        # gave every scroll and animation tick a fresh key, so the route
        # sampler re-armed and re-ran the software oracle on an already-proven
        # device. The key is now device + surface + extent + document, and
        # neither the serialized scene nor any hash of it is retained at all.
        # See doc/08_tracking/bug/web_draw_ir_sampler_rearms_on_generation_2026-09-11.md
        step("Inspect the bounded route-key implementation")
        val source = file_read(
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_layout_engine2d_fast.spl")
        val evidence = capture_text(
            "Non-acceptance Draw IR route-key source contract",
            "implementation bytes={source.len()}")
        expect(source).to_contain("_web_draw_ir_key_text(document_identity)")
        expect(source).to_contain("_web_draw_ir_key_text(device_token)")
        expect(source.find("draw-ir-sha256=")).to_equal(ROUTE_KEY_NOT_FOUND)
        expect(source.find("draw-ir-generation=")).to_equal(ROUTE_KEY_NOT_FOUND)
        expect(source.find("djb2_hash_text(serialized)")).to_equal(ROUTE_KEY_NOT_FOUND)
        expect(source.find(
            "_web_draw_ir_key_text(draw_ir_to_sdn(composition))")).to_equal(ROUTE_KEY_NOT_FOUND)
        expect(evidence.body).to_contain("implementation bytes=")
