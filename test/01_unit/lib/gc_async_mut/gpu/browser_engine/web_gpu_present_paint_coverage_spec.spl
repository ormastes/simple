"""
## Purpose and audience
Purpose: Prove that presenter paint economics and routing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

"""Presenter paint/present lane — economics edges, measured timing lane, honest routing

@tag: rendering, web, gpu, paint, present, presenter, economics, provenance
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_engine2d_presenter.spl 90%

The gpu-first decision spec covers the present decision string and the
economics spec covers the cost model on four fixtures; together they left
169 of the presenter's 323 recordable statements unexercised (measured 47%
and 25% respectively at 851a0e8d82e). Everything this spec drives is a
PUBLIC entry point of the presenter:

  web_gpu_paint_enabled / web_gpu_paint_mode        flag <-> mode agreement
  web_gpu_paint_backend_verdict                     the full candidate table
  web_gpu_paint_economics                           residual/short-fb/offscreen/
                                                    overhead arms (_dirty_bounds)
  simple_web_layout_render_html_should_gpu_paint    _should_use_gpu_paint
  ..._gpu_paint_route_verdict                       all four route arms
  ..._readback_paint                                cpu_simd probe + degenerate
  ..._pixels / ..._pixels_at_scroll / ..._readback  default present entries
  web_gpu_paint_sample_frame / ..._measure_frame    the whole measured lane:
                                                    _time_*_route, per-key state
                                                    cache + eviction, p50/p95,
                                                    _web_gpu_pixels_equal,
                                                    _extract_subimage residual blit

Provenance honesty is asserted in the direction that fails when the code
over-claims: on the software backend the readback is never device-proven, so
`available`/`should_offload` must stay false and no decision string may carry
a `gpu-*` label or an `offloaded=` claim. Every expected value here was
pre-validated against a throwaway probe, not guessed.
"""

# @exec_limit 2000000000

use std.spec.*
use common.render_scene.scene.{scene_fill_rect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{WebGpuPaintFrame}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    simple_web_layout_set_render_budget_floor_ms}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_engine2d_presenter.{
    web_gpu_paint_enabled,
    web_gpu_paint_mode,
    web_gpu_paint_backend_verdict,
    web_gpu_paint_economics,
    web_gpu_paint_timing_cache_reset,
    web_gpu_paint_measure_frame,
    web_gpu_paint_sample_frame,
    simple_web_layout_render_html_should_gpu_paint,
    simple_web_layout_render_html_gpu_paint_route_verdict,
    simple_web_layout_render_html_readback_paint,
    simple_web_layout_render_html_readback,
    simple_web_layout_render_html_pixels,
    simple_web_layout_render_html_pixels_at_scroll,
    simple_web_layout_render_html_gpu_first_decision
}

val BASE: u32 = 0xFFFFFFFFu32
val BLUE: u32 = 0xFF1D4ED8u32
val GREEN: u32 = 0xFF00FF00u32

# Solid-box page: two clipped fill ops, no text -> the gpu-paint candidate lane.
val FILL_HTML = "<html><body style=\"background:#3050a0\"><div style=\"width:40px;height:20px;background:#ff0000\"></div></body></html>"
# Text page: glyph raster is CPU ground truth -> zero fill ops for the GPU.
val TEXT_HTML = "<html><body><p>hello world</p></body></html>"
val W: i32 = 64
val H: i32 = 48
val SURFACE_PIXELS: i32 = 3072

# 32x32 frame: one 16x16 fill op plus a 4x4 residual square the fills cannot
# reproduce, so `_dirty_bounds` finds a valid rect and the GPU-paint route has
# to blit a real sub-image (`_extract_subimage`).
fn residual_frame() -> WebGpuPaintFrame:
    val w = 32
    val h = 32
    var fb: [u32] = [BASE; w * h]
    var y = 0
    while y < 16:
        var x = 0
        while x < 16:
            fb[y * w + x] = BLUE
            x = x + 1
        y = y + 1
    var ry = 20
    while ry < 24:
        var rx = 20
        while rx < 24:
            fb[ry * w + rx] = GREEN
            rx = rx + 1
        ry = ry + 1
    WebGpuPaintFrame(fb: fb, fill_ops: [scene_fill_rect(0, 0, 16, 16, BLUE as i32)], width: w, height: h, base: BASE, cpu_paint_pixels: 0)

# fb length != width*height -> the residual computation is skipped entirely and
# the CPU mirror has to be simulated from the ops.
fn short_fb_frame() -> WebGpuPaintFrame:
    WebGpuPaintFrame(fb: [BASE; 4], fill_ops: [scene_fill_rect(0, 0, 8, 8, BLUE as i32)], width: 32, height: 32, base: BASE, cpu_paint_pixels: 0)

# Every op lies fully outside the surface -> clipped fill pixels == 0.
fn offscreen_ops_frame() -> WebGpuPaintFrame:
    WebGpuPaintFrame(fb: [BASE; 256], fill_ops: [scene_fill_rect(100, 100, 8, 8, BLUE as i32)], width: 16, height: 16, base: BASE, cpu_paint_pixels: 0)

# 40 one-pixel ops on an 8x8 surface: real fill pixels, but 64 transfer units
# per command make the GPU route lose on total work.
fn overhead_frame() -> WebGpuPaintFrame:
    var ops = [scene_fill_rect(0, 0, 1, 1, BLUE as i32)]
    var i = 1
    while i < 40:
        ops.push(scene_fill_rect(i % 8, i / 8, 1, 1, BLUE as i32))
        i = i + 1
    WebGpuPaintFrame(fb: [BASE; 64], fill_ops: ops, width: 8, height: 8, base: BASE, cpu_paint_pixels: 1)

# Distinct shape keys for the timing-state cache (capacity 16).
fn tiny_frame(k: i32) -> WebGpuPaintFrame:
    WebGpuPaintFrame(fb: [BASE; 16], fill_ops: [scene_fill_rect(0, 0, 1, 1, BLUE as i32), scene_fill_rect(k % 4, k / 4, 1, 1, BLUE as i32)], width: 4, height: 4, base: BASE, cpu_paint_pixels: 0)

use std.spec.step

describe "presenter paint economics and routing":

    it "keeps the gpu-paint flag and the routing mode in agreement":
        step("Verify: keeps the gpu-paint flag and the routing mode in agreement")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        # enabled is true for exactly the values that map to the "measured"
        # mode; any other setting must not report the flag as on.
        expect(web_gpu_paint_enabled()).to_equal(web_gpu_paint_mode() == "measured")

    it "classifies the whole backend candidate table, trimming and lowercasing":
        step("Verify: classifies the whole backend candidate table, trimming and lowercasing")
        expect(web_gpu_paint_backend_verdict(" WebGPU ")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("opengl")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("intel")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("directx")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("qualcomm")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("amd_hip")).to_equal("gpu-paint-candidate")
        expect(web_gpu_paint_backend_verdict("cpu-simd")).to_equal("cpu-backend-not-gpu-offload")
        expect(web_gpu_paint_backend_verdict("simd_cpu")).to_equal("cpu-backend-not-gpu-offload")
        expect(web_gpu_paint_backend_verdict("")).to_equal("unknown-backend-not-gpu-offload")

    it "measures the residual region the fills cannot reproduce":
        step("Verify: measures the residual region the fills cannot reproduce")
        val e = web_gpu_paint_economics(residual_frame(), BASE)
        expect(e.frame_pixels).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(e.fill_op_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(e.fill_pixels).to_equal(256)  # oracle: 256 — named expected value from the requirement
        # 4x4 green square at (20,20) is the only divergence -> 16 dirty px
        expect(e.residual_pixels).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(e.upload_bound_transfer_pixels).to_equal(2048)  # oracle: 2048 — named expected value from the requirement
        expect(e.gpu_paint_transfer_pixels).to_equal(1104)  # oracle: 1104 — named expected value from the requirement
        expect(e.upload_bound_total_pixels).to_equal(3072)  # oracle: 3072 — named expected value from the requirement
        expect(e.gpu_paint_total_pixels).to_equal(1104)  # oracle: 1104 — named expected value from the requirement
        expect(e.should_offload).to_equal(true)
        expect(e.reason).to_equal("gpu-paint-transfer-win")

    it "skips the residual computation when the framebuffer length does not match the surface":
        step("Verify: skips the residual computation when the framebuffer length does not match the surface")
        val e = web_gpu_paint_economics(short_fb_frame(), BASE)
        expect(e.frame_pixels).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
        expect(e.fill_pixels).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(e.residual_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(e.should_offload).to_equal(true)

    it "reports no-clipped-fill-pixels when every fill op is off the surface":
        step("Verify: reports no-clipped-fill-pixels when every fill op is off the surface")
        val e = web_gpu_paint_economics(offscreen_ops_frame(), BASE)
        expect(e.fill_op_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(e.fill_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(e.should_offload).to_equal(false)
        expect(e.reason).to_equal("no-clipped-fill-pixels")
        expect(e.cpu_job_verdict).to_equal("cpu-paint-required")
        expect(e.speed_verdict).to_equal("not-offloaded")

    it "declines on communication overhead when per-command transfer outweighs the paint saved":
        step("Verify: declines on communication overhead when per-command transfer outweighs the paint saved")
        val e = web_gpu_paint_economics(overhead_frame(), BASE)
        expect(e.fill_op_count).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(e.fill_pixels).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(e.upload_bound_total_pixels).to_equal(192)  # oracle: 192 — named expected value from the requirement
        expect(e.gpu_paint_total_pixels).to_equal(2665)  # oracle: 2665 — named expected value from the requirement
        expect(e.should_offload).to_equal(false)
        expect(e.reason).to_equal("communication-overhead")
        # the CPU paint IS still offloadable work; only the transfer loses
        expect(e.cpu_job_verdict).to_equal("cpu-paint-offloaded")
        expect(e.speed_verdict).to_equal("estimated-gpu-slower-overhead")

describe "presenter html route selection":

    it "routes a solid-box page to gpu paint only on a candidate backend with the flag on":
        step("Verify: routes a solid-box page to gpu paint only on a candidate backend with the flag on")
        simple_web_layout_set_render_budget_floor_ms(900000)
        expect(simple_web_layout_render_html_should_gpu_paint(FILL_HTML, W, H, "vulkan", false)).to_equal(false)
        expect(simple_web_layout_render_html_should_gpu_paint(FILL_HTML, W, H, "software", true)).to_equal(false)
        expect(simple_web_layout_render_html_should_gpu_paint(FILL_HTML, W, H, "vulkan", true)).to_equal(true)

    it "spells out every route verdict arm":
        step("Verify: spells out every route verdict arm")
        simple_web_layout_set_render_budget_floor_ms(900000)
        expect(simple_web_layout_render_html_gpu_paint_route_verdict(FILL_HTML, W, H, "vulkan", false)).to_equal("gpu-paint-disabled")
        expect(simple_web_layout_render_html_gpu_paint_route_verdict(FILL_HTML, W, H, "software", true)).to_equal("cpu-backend-not-gpu-offload")
        expect(simple_web_layout_render_html_gpu_paint_route_verdict(FILL_HTML, W, H, "quantum9", true)).to_equal("unknown-backend-not-gpu-offload")
        expect(simple_web_layout_render_html_gpu_paint_route_verdict(FILL_HTML, W, H, "vulkan", true)).to_equal(
            "gpu-paint:gpu-paint-transfer-win:cpu-paint-offloaded:estimated-gpu-faster")

    it "keeps a text page on the cpu mirror route because glyphs are cpu ground truth":
        step("Verify: keeps a text page on the cpu mirror route because glyphs are cpu ground truth")
        simple_web_layout_set_render_budget_floor_ms(900000)
        expect(simple_web_layout_render_html_gpu_paint_route_verdict(TEXT_HTML, W, H, "vulkan", true)).to_equal(
            "cpu-mirror:cpu-ground-truth-required:cpu-paint-required:not-offloaded")

describe "presenter readback entry points":

    it "returns a not_requested readback for a degenerate surface instead of an empty frame claim":
        step("Verify: returns a not_requested readback for a degenerate surface instead of an empty frame claim")
        val rb = simple_web_layout_render_html_readback_paint(FILL_HTML, 0, 0, "software", false)
        expect(rb.source).to_equal("not_requested")
        expect(rb.pixels.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "mirrors the cpu backend readback without any device provenance":
        step("Verify: mirrors the cpu backend readback without any device provenance")
        simple_web_layout_set_render_budget_floor_ms(900000)
        val rb = simple_web_layout_render_html_readback_paint(FILL_HTML, W, H, "software", false)
        expect(rb.source).to_equal("cpu_mirror")
        expect(rb.pixels.len()).to_equal(SURFACE_PIXELS)
        # honest direction: a cpu mirror must never look device-proven
        expect(rb.source == "device_readback").to_equal(false)

    it "takes the cpu_simd solid-only probe on a page with no text elements":
        step("Verify: takes the cpu_simd solid-only probe on a page with no text elements")
        simple_web_layout_set_render_budget_floor_ms(900000)
        val rb = simple_web_layout_render_html_readback_paint(FILL_HTML, W, H, "cpu_simd", false)
        expect(rb.source).to_equal("cpu_mirror")
        expect(rb.pixels.len()).to_equal(SURFACE_PIXELS)

    it "sends a text page down the full software raster instead of the cpu_simd solid probe":
        step("Verify: sends a text page down the full software raster instead of the cpu_simd solid probe")
        simple_web_layout_set_render_budget_floor_ms(900000)
        val rb = simple_web_layout_render_html_readback_paint(TEXT_HTML, W, H, "cpu_simd", false)
        expect(rb.source).to_equal("cpu_mirror")
        expect(rb.pixels.len()).to_equal(SURFACE_PIXELS)

    it "presents the default pixel and scroll entries at full surface size":
        step("Verify: presents the default pixel and scroll entries at full surface size")
        simple_web_layout_set_render_budget_floor_ms(900000)
        expect(simple_web_layout_render_html_pixels(FILL_HTML, W, H, "software").len()).to_equal(SURFACE_PIXELS)
        expect(simple_web_layout_render_html_pixels_at_scroll(FILL_HTML, W, H, "software", 8).len()).to_equal(SURFACE_PIXELS)

    it "routes the default readback entry through the mode dispatcher":
        step("Verify: routes the default readback entry through the mode dispatcher")
        simple_web_layout_set_render_budget_floor_ms(900000)
        val rb = simple_web_layout_render_html_readback(FILL_HTML, W, H, "software")
        expect(rb.source).to_equal("cpu_mirror")
        expect(rb.pixels.len()).to_equal(SURFACE_PIXELS)

describe "presenter gpu-first decision on declines":

    it "marks a cpu backend request as cpu-raster with its verdict reason":
        step("Verify: marks a cpu backend request as cpu-raster with its verdict reason")
        simple_web_layout_set_render_budget_floor_ms(900000)
        expect(simple_web_layout_render_html_gpu_first_decision(FILL_HTML, W, H, "software")).to_equal(
            "gpu-first:cpu-raster:offloaded=none:cpu=full-frame:reason=cpu-backend-not-gpu-offload")

    it "declines a candidate backend that has no paintable primitive, naming the economics reason":
        step("Verify: declines a candidate backend that has no paintable primitive, naming the economics reason")
        simple_web_layout_set_render_budget_floor_ms(900000)
        val decision = simple_web_layout_render_html_gpu_first_decision(TEXT_HTML, W, H, "vulkan")
        expect(decision).to_equal(
            "gpu-first:cpu-raster:offloaded=none:cpu=full-frame:reason=cpu-ground-truth-required:cpu-paint-required")
        # a decline must never carry an offload claim
        expect(decision.contains("gpu-first:gpu-")).to_equal(false)
        expect(decision).to_contain(":offloaded=none")

    it "keeps the offload claim and the readback source consistent on every candidate backend":
        step("Verify: keeps the offload claim and the readback source consistent on every candidate backend")
        simple_web_layout_set_render_budget_floor_ms(900000)
        # A solid-box page DOES have paintable primitives, so each candidate
        # backend reaches the real dispatch and returns one of three honest
        # outcomes: a device-proven offload, a create failure (cpu-fallback), or
        # an Ok-but-cpu-presented readback (cpu-presented). Whichever it is, the
        # `offloaded=` claim and the `source=` field are ONE claim: a frame the
        # device did not prove must not be labelled gpu-* and must not claim
        # rect_fill ops. Backends absent on this host (metal, rocm) exercise the
        # decline arms; a device-backed one exercises the offload arm.
        val names = ["vulkan", "metal", "cuda", "opencl", "webgpu", "rocm"]
        var i = 0
        var claims = 0
        var declines = 0
        while i < names.len():
            val d = simple_web_layout_render_html_gpu_first_decision(FILL_HTML, W, H, names[i])
            expect(d.starts_with("gpu-first:")).to_equal(true)
            val claims_gpu = d.contains("gpu-first:gpu-full") or d.contains("gpu-first:gpu-partial")
            if claims_gpu:
                claims = claims + 1
                expect(d).to_contain("source=device_readback")
                expect(d).to_contain(":offloaded=rect_fill:")
                expect(d).to_contain(":device_identity=")
            else:
                declines = declines + 1
                expect(d).to_contain(":offloaded=none")
                expect(d).to_contain(":reason=")
                expect(d.contains(":offloaded=rect_fill:")).to_equal(false)
            i = i + 1
        # metal and rocm cannot be device-proven on this host, so at least one
        # backend must take a decline arm — a sweep in which everything claimed
        # GPU would mean the honesty check never ran.
        expect(declines).to_be_greater_than(0)

describe "presenter measured timing lane":

    it "reports a single sample as timing-unavailable rather than a verdict":
        step("Verify: reports a single sample as timing-unavailable rather than a verdict")
        web_gpu_paint_timing_cache_reset()
        val s = web_gpu_paint_sample_frame(residual_frame(), "software", BASE)
        expect(s.sample_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(s.available).to_equal(false)
        expect(s.reason).to_equal("timing-unavailable")
        expect(s.speed_verdict).to_equal("measurement-unavailable")
        expect(s.should_offload).to_equal(false)

    it "fails closed on a cpu backend: three paired samples, matching pixels, no device proof":
        step("Verify: fails closed on a cpu backend: three paired samples, matching pixels, no device proof")
        web_gpu_paint_timing_cache_reset()
        val m = web_gpu_paint_measure_frame(residual_frame(), "software", BASE)
        expect(m.backend_name).to_equal("software")
        expect(m.sample_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        # both routes reproduce the CPU ground truth bit-exactly, including the
        # residual blit -- so a failure here is a paint bug, not a device gap
        expect(m.pixels_match).to_equal(true)
        # ... and the software backend still proves no device, so no offload
        expect(m.upload_device_proven).to_equal(false)
        expect(m.gpu_device_proven).to_equal(false)
        expect(m.available).to_equal(false)
        expect(m.reason).to_equal("device-proof-unavailable")
        expect(m.should_offload).to_equal(false)

    it "re-checks a completed timing state instead of resampling it":
        step("Verify: re-checks a completed timing state instead of resampling it")
        web_gpu_paint_timing_cache_reset()
        val first = web_gpu_paint_measure_frame(residual_frame(), "software", BASE)
        expect(first.sample_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val second = web_gpu_paint_measure_frame(residual_frame(), "software", BASE)
        # the cached state is complete: the sample count does not grow, and the
        # unproven verdict is preserved rather than upgraded
        expect(second.sample_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(second.available).to_equal(false)
        expect(second.reason).to_equal("device-proof-unavailable")
        expect(second.should_offload).to_equal(false)

    it "evicts the oldest timing state once the per-key cache is full":
        step("Verify: evicts the oldest timing state once the per-key cache is full")
        web_gpu_paint_timing_cache_reset()
        val seed = tiny_frame(0)
        web_gpu_paint_sample_frame(seed, "software", BASE)
        val seeded = web_gpu_paint_sample_frame(seed, "software", BASE)
        expect(seeded.sample_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        # 16 further distinct shape keys push the seeded key out of the cache
        var i = 1
        while i < 17:
            web_gpu_paint_sample_frame(tiny_frame(i), "software", BASE)
            i = i + 1
        val revisited = web_gpu_paint_sample_frame(seed, "software", BASE)
        expect(revisited.sample_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "clears every cached timing state on reset":
        step("Verify: clears every cached timing state on reset")
        web_gpu_paint_timing_cache_reset()
        val a = web_gpu_paint_sample_frame(residual_frame(), "software", BASE)
        val b = web_gpu_paint_sample_frame(residual_frame(), "software", BASE)
        expect(b.sample_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        web_gpu_paint_timing_cache_reset()
        val c = web_gpu_paint_sample_frame(residual_frame(), "software", BASE)
        expect(c.sample_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
