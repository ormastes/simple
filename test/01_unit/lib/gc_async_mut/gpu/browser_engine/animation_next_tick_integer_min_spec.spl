use std.spec
use std.common.animation.timing.{TimingFunction}
use std.gc_async_mut.gpu.browser_engine.style.animation.{BrowserCssAnimationInstance}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_animation_instances_next_ms}

fn finite_tick_instance(start_ms: i64) -> BrowserCssAnimationInstance:
    BrowserCssAnimationInstance(
        target_key: "target", signature: "tick", start_time_ms: start_ms,
        paused: false, paused_elapsed_ms: 0, duration_ms: 100, delay_ms: 0,
        timing: TimingFunction.Linear, iteration_count: 1.0
    )

describe "finite animation ticks use the integer minimum owner":
    it "schedules the next frame when it precedes the end":
        val instance = finite_tick_instance(0)
        expect(simple_web_layout_animation_instances_next_ms([instance], 0)).to_equal(16)

    it "clamps the last frame to the end then stops scheduling":
        val instance = finite_tick_instance(0)
        expect(simple_web_layout_animation_instances_next_ms([instance], 91)).to_equal(100)
        expect(simple_web_layout_animation_instances_next_ms([instance], 100)).to_equal(-1)

    it "preserves integer millisecond precision above the exact f64 range":
        val start_ms: i64 = 9007199254740993
        val instance = finite_tick_instance(start_ms)
        expect(simple_web_layout_animation_instances_next_ms([instance], start_ms + 91)).to_equal(start_ms + 100)
