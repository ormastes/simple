use std.spec.*
use std.common.web.browser_renderer_protocol.{
    BrowserTextInputOverlay, browser_text_input_overlay_empty
}
use std.gc_async_mut.web.browser_session.{
    BrowserRenderRevisions, BrowserRenderSnapshot
}
use std.gc_async_mut.gpu.browser_engine.simple_web_render_session.{
    SimpleWebRenderSession
}
use common.ui.render_opt.damage_plan.{
    DAMAGE_PLAN_FULL, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_NONE
}

fn damage_snapshot(html: text?) -> BrowserRenderSnapshot:
    BrowserRenderSnapshot(
        document_generation: 1,
        revisions: BrowserRenderRevisions(
            document_revision: 1,
            style_revision: 1,
            resource_revision: 1
        ),
        document_html: html,
        resources_changed: false
    )

fn damage_overlay(target: text, visible: bool) -> BrowserTextInputOverlay:
    BrowserTextInputOverlay(
        target_key: target,
        anchor_byte: 0,
        focus_byte: 0,
        view_start_byte: 0,
        caret_visible: visible
    )

describe "SimpleWebRenderSession damage classification":
    it "classifies initial, exact reuse, and input overlay frames conservatively":
        val width: i32 = 96
        val height: i32 = 64
        val session = SimpleWebRenderSession.create()
        val initial = session.render(
            damage_snapshot(Some("<input value='caret'>")),
            width, height, 0, 0, browser_text_input_overlay_empty(), [], []
        )
        expect(session.damage_mode).to_equal(DAMAGE_PLAN_FULL)
        expect(session.damage_rects).to_equal([0, 0, 96, 64])

        val reused = session.render(
            damage_snapshot(nil), width, height, 0, 0,
            browser_text_input_overlay_empty(), [], []
        )
        expect(session.damage_mode).to_equal(DAMAGE_PLAN_NONE)
        expect(session.damage_rects.len()).to_equal(0)
        expect(reused.composition).to_equal(initial.composition)

        val changed = session.render(
            damage_snapshot(nil), width, height, 0, 0,
            damage_overlay("path:0", true), [], []
        )
        expect(session.damage_mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(session.damage_reason).to_equal("text-input-overlay")
        expect(session.damage_rects.len()).to_equal(4)
        expect(session.damage_rects[0]).to_be_greater_than(-1)
        expect(session.damage_rects[1]).to_be_greater_than(-1)
        expect(session.damage_rects[2]).to_be_greater_than(0)
        expect(session.damage_rects[3]).to_be_greater_than(0)
        expect(changed.composition == reused.composition).to_equal(false)
        session.close()

    it "fails open to full damage when overlay geometry is unavailable":
        val session = SimpleWebRenderSession.create()
        session.render(
            damage_snapshot(Some("<input value='caret'>")),
            96, 64, 0, 0, browser_text_input_overlay_empty(), [], []
        )
        session.render(
            damage_snapshot(nil), 96, 64, 0, 0,
            damage_overlay("missing-target", true), [], []
        )
        expect(session.damage_mode).to_equal(DAMAGE_PLAN_FULL)
        expect(session.damage_rects).to_equal([0, 0, 96, 64])
        expect(session.damage_reason).to_equal("overlay-geometry-unavailable")
        session.close()
