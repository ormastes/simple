# @req: REQ-LIB-GC-ASYNC-MUT-001

# @tag: unit, gpu, web, css, gradient, regression
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_foundation.spl 20%
#
# GAP-2 (doc/03_plan/ui/unified_2d_engine/drawir_feature_gap_2026-07-31.md):
# gradients were linear-only, 2-stop, and `parse_linear_gradient_color` had a
# parser bug where a numeric angle token ("45deg", ...) fell through the
# `elif item_index == target: return parse_color_any(part)` branch exactly
# like a real color stop, because only the `to <side>` keyword form was
# recognized as a direction token to skip. That shifted every stop index by
# one whenever the gradient carried an explicit angle.
#
# This spec proves: (1) the bug is fixed (regression), (2) N-stop (3+) parsing
# with both implicit even-spacing and explicit "%" positions, (3) angle
# parsing for both numeric and keyword forms, (4) radial-gradient detection
# and stop extraction.

use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    parse_linear_gradient_color, parse_gradient_stops, parse_gradient_angle_deg,
    is_radial_gradient, GradientStopSpec
}

val RED: u32 = 0xFFFF0000u32
val GREEN: u32 = 0xFF00FF00u32
val BLUE: u32 = 0xFF0000FFu32

use std.spec.step

describe "parse_linear_gradient_color angle-token regression (GAP-2 bug)":

    it "does not let a numeric angle token shift the color stop index":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: does not let a numeric angle token shift the color stop index")
        val css = "linear-gradient(45deg, #ff0000, #0000ff)"
        # Before the fix: target=0 returned parse_color_any("45deg") == 0,
        # and target=1 returned the FIRST color (red) instead of the second.
        expect(parse_linear_gradient_color(css, 0)).to_equal(RED)
        expect(parse_linear_gradient_color(css, 1)).to_equal(BLUE)

    it "still shifts on other numeric angle units (grad/rad/turn)":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: still shifts on other numeric angle units (grad/rad/turn)")
        expect(parse_linear_gradient_color("linear-gradient(0.5turn, #ff0000, #0000ff)", 0)).to_equal(RED)
        expect(parse_linear_gradient_color("linear-gradient(200grad, #ff0000, #0000ff)", 0)).to_equal(RED)
        expect(parse_linear_gradient_color("linear-gradient(1rad, #ff0000, #0000ff)", 0)).to_equal(RED)

    it "keeps working with no direction token at all":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps working with no direction token at all")
        val css = "linear-gradient(#ff0000, #0000ff)"
        expect(parse_linear_gradient_color(css, 0)).to_equal(RED)
        expect(parse_linear_gradient_color(css, 1)).to_equal(BLUE)

    it "keeps working with the pre-existing keyword direction form":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps working with the pre-existing keyword direction form")
        val css = "linear-gradient(to bottom, #ff0000, #0000ff)"
        expect(parse_linear_gradient_color(css, 0)).to_equal(RED)
        expect(parse_linear_gradient_color(css, 1)).to_equal(BLUE)

describe "parse_gradient_angle_deg":

    it "reads a numeric degree angle":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: reads a numeric degree angle")
        expect(parse_gradient_angle_deg("linear-gradient(45deg, #ff0000, #0000ff)")).to_equal(45)

    it "reads keyword directions":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: reads keyword directions")
        expect(parse_gradient_angle_deg("linear-gradient(to top, #ff0000, #0000ff)")).to_equal(0)
        expect(parse_gradient_angle_deg("linear-gradient(to right, #ff0000, #0000ff)")).to_equal(90)
        expect(parse_gradient_angle_deg("linear-gradient(to left, #ff0000, #0000ff)")).to_equal(270)

    it "defaults to 180 (CSS 'to bottom') with no direction token":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: defaults to 180 (CSS 'to bottom') with no direction token")
        expect(parse_gradient_angle_deg("linear-gradient(#ff0000, #0000ff)")).to_equal(180)

describe "parse_gradient_stops N-stop upgrade":

    it "parses 3 stops with implicit even spacing":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: parses 3 stops with implicit even spacing")
        val stops = parse_gradient_stops("linear-gradient(180deg, #ff0000, #00ff00, #0000ff)")
        expect(stops.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(stops[0].color).to_equal(RED)
        expect(stops[0].pos_permille).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(stops[1].color).to_equal(GREEN)
        expect(stops[1].pos_permille).to_equal(500)  # oracle: 500 — named expected value from the requirement
        expect(stops[2].color).to_equal(BLUE)
        expect(stops[2].pos_permille).to_equal(1000)  # oracle: 1000 — named expected value from the requirement

    it "honors explicit percentage stop positions":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: honors explicit percentage stop positions")
        val stops = parse_gradient_stops("linear-gradient(#ff0000 10%, #00ff00 50%, #0000ff 90%)")
        expect(stops.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(stops[0].pos_permille).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(stops[1].pos_permille).to_equal(500)  # oracle: 500 — named expected value from the requirement
        expect(stops[2].pos_permille).to_equal(900)  # oracle: 900 — named expected value from the requirement

    it "does not misparse an angle token as a 4th stop":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: does not misparse an angle token as a 4th stop")
        val stops = parse_gradient_stops("linear-gradient(45deg, #ff0000, #00ff00, #0000ff)")
        expect(stops.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(stops[0].color).to_equal(RED)
        expect(stops[2].color).to_equal(BLUE)

describe "radial-gradient detection and N-stop parsing":

    it "distinguishes radial from linear":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: distinguishes radial from linear")
        expect(is_radial_gradient("radial-gradient(#ff0000, #00ff00)")).to_equal(true)
        expect(is_radial_gradient("linear-gradient(#ff0000, #00ff00)")).to_equal(false)

    it "parses radial stops with no shape/position prefix":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: parses radial stops with no shape/position prefix")
        val stops = parse_gradient_stops("radial-gradient(#ff0000, #00ff00, #0000ff)")
        expect(stops.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(stops[0].color).to_equal(RED)
        expect(stops[1].color).to_equal(GREEN)
        expect(stops[2].color).to_equal(BLUE)

    it "skips a leading shape/position prefix":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: skips a leading shape/position prefix")
        val stops = parse_gradient_stops("radial-gradient(circle at center, #ff0000, #0000ff)")
        expect(stops.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(stops[0].color).to_equal(RED)
        expect(stops[1].color).to_equal(BLUE)
