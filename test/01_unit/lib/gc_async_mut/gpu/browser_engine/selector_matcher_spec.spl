# @cover src/lib/gc_async_mut/gpu/browser_engine/selector_matcher.spl
use std.spec.*

use std.gc_async_mut.gpu.browser_engine.selector_matcher.{
    br_selector_list_contains_not_self, br_tag_name_from_content}

describe "browser engine selector matcher":

    it "matches :not when an attribute substring option is absent":
        val tag = "a href=\"https://example.test/docs\" class=\"nav\""
        expect(br_selector_list_contains_not_self("a:not([href*=\"admin\"])", "a", tag)).to_equal(true)

    it "rejects :not when an attribute substring option is present":
        val tag = "a href=\"https://example.test/admin\" class=\"nav\""
        expect(br_selector_list_contains_not_self("a:not([href*=\"admin\"])", "a", tag)).to_equal(false)

    it "matches :not with compound class options":
        val tag = "button class=\"secondary\""
        expect(br_selector_list_contains_not_self("button:not(button.primary)", "button", tag)).to_equal(true)

    it "rejects :not with compound class options":
        val tag = "button class=\"primary\""
        expect(br_selector_list_contains_not_self("button:not(button.primary)", "button", tag)).to_equal(false)

    # --- single-quoted attribute values -----------------------------------
    # _sel_attr_value looks for `attr="` first and only then `attr='`. Every
    # existing example used double quotes, so the whole single-quote arm
    # (selector_matcher.spl lines 15-20) had never executed.

    it "rejects :not with a compound class written in single quotes":
        val tag = "button class='primary'"
        expect(br_selector_list_contains_not_self("button:not(button.primary)", "button", tag)).to_equal(false)

    it "matches :not when the single-quoted class differs":
        val tag = "button class='secondary'"
        expect(br_selector_list_contains_not_self("button:not(button.primary)", "button", tag)).to_equal(true)

    it "treats an unterminated single-quoted attribute as absent":
        # No closing quote, so the `close >= 0` guard fails and the option
        # cannot match -- the element stays a valid :not() match.
        val tag = "button class='primary"
        expect(br_selector_list_contains_not_self("button:not(button.primary)", "button", tag)).to_equal(true)

    # --- degenerate selector / markup inputs ------------------------------

    it "reports no tag name for markup with an empty tag body":
        expect(br_tag_name_from_content("<>")).to_equal("")

    it "reports the tag name for ordinary markup":
        expect(br_tag_name_from_content("<a>")).to_equal("a")

    it "rejects a selector that never names the element with :not":
        expect(br_selector_list_contains_not_self("p.foo", "a", "a")).to_equal(false)

    it "rejects a :not selector whose parenthesis is never closed":
        expect(br_selector_list_contains_not_self("a:not(b", "a", "a")).to_equal(false)
