use std.spec.*
use std.io_runtime.{env_set}
use std.gc_async_mut.gpu.browser_engine.browser_renderer.{render_html_to_pixels_with_viewport}

# WEB_RULE_DECL_QUOTA (256) is documented as a PER-RULE abuse bound: "a rule
# carrying more than the cap is dropped wholesale (graceful -- the cascade
# continues with the remaining rules)". css_declaration_priority_split already
# enforces it on each rule as it is extracted.
#
# compute_styles_with_material merges every matching rule's declarations into
# ONE string per node and calls apply_decls once (a perf change), then hands
# that MERGED string back to the same per-rule guard in
# _apply_decls_on_writing_mode. A node matching several rules that each
# individually pass the quota can exceed it once merged, and the guard then
# discards the node's ENTIRE author cascade instead of one offending rule --
# so the winning background/width/height never apply and the element renders
# as if no stylesheet rule matched it at all.

# The 10s default render budget is sized for AOT/JIT execution; `simple test`
# runs this engine on the tree-walk interpreter, where it trips mid-page and
# every node past the break loses its cascade for an unrelated reason. Opt in
# to the documented interpreted-lane override so this spec measures the quota
# bound and not the wall clock.
val _budget_armed: bool = env_set("SIMPLE_WEB_RENDER_BUDGET_MS", "600000")

val TEST_WIDTH: i32 = 24
val TEST_HEIGHT: i32 = 16
val WINNER: u32 = 0xFF7E22CEu32

# `count` inert declarations. Unknown property names are ignored by apply_decls
# but still consume one slot each in the quota's semicolon count.
fn _filler(prefix: text, count: i32) -> text:
    var out = ""
    var i = 0
    while i < count:
        out = out + prefix + "{i}: 0px; "
        i = i + 1
    out

# Two rules match `<div class='box'>`. The winning declarations live in the
# higher-specificity rule (`div.box`), so they are last in cascade order.
fn _page(filler_count: i32) -> text:
    val low = ".box { " + _filler("zza", filler_count) + " }"
    val high = (
        "div.box { " + _filler("zzb", filler_count) +
        " background-color: #7e22ce; width: 12px; height: 8px; }"
    )
    (
        "<html><head><style>body { margin: 0; background-color: #ffffff; } " +
        low + " " + high +
        "</style></head><body><div class='box'></div></body></html>"
    )

fn _count_color(pixels: [u32], color: u32) -> i32:
    var count: i32 = 0
    var idx: i32 = 0
    while idx < pixels.len():
        if pixels[idx] == color:
            count = count + 1
        idx = idx + 1
    count

describe "merged cascade declaration quota":

    it "control: two rules well under the merged quota paint the winner":
        # 2 * 40 + 3 = 83 declarations merged, far below the 256 quota.
        assert_true(_budget_armed)
        val result = render_html_to_pixels_with_viewport(
            _page(40), TEST_WIDTH, TEST_HEIGHT
        )
        expect(_count_color(result.pixel_data, WINNER)).to_be_greater_than(0)

    it "two rules that each pass the per-rule quota still paint the winner when merged":
        # 2 * 130 + 3 = 263 declarations merged; each RULE carries at most 133,
        # so both are legitimately admitted, yet the merged string trips the
        # per-rule guard and the whole node cascade is discarded.
        val result = render_html_to_pixels_with_viewport(
            _page(130), TEST_WIDTH, TEST_HEIGHT
        )
        expect(_count_color(result.pixel_data, WINNER)).to_be_greater_than(0)
