# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core.spl 81%
"""
# HTML Layout Renderer Core — :root Custom-Property Closure (U4.4, part N+2)

`simple_web_html_layout_renderer_core.spl` measured 68% (1404/2075 lines,
union of two artifact-confirmed runs) per
`doc/09_report/ui/testing/wm_gui_web_coverage_baseline_2026-08-07.md`
("U4.4 `simple_web_html_layout_renderer_core.spl` — pure-helper closure
(session N+1)"). That session named `compute_styles_with_material`,
`_css_resolve_vars`, `_pseudo_ctx_matches`, `_extract_css_vw_with_rule_limit`,
`_css_collect_custom_props`, and `_css_scan_rules_simple` as the largest
remaining uncovered regions.

This closure spec targets the two of those six that are PURE text/state
functions reachable without an `HNode`/`SelectorContext`/`Rules` fixture:
`_css_collect_custom_props` (collects `--name: value` pairs out of `:root { }`
and `:root[attr] { }` blocks) and `_css_resolve_vars` (recursively substitutes
`var(--name, fallback)` against the collected property table, with cycle/
depth/budget guards). `compute_styles_with_material` and `_pseudo_ctx_matches`
needed HNode/Rules fixtures at the time this paragraph was written; the
"Extension (session N+4)" section below builds those fixtures and closes
both, along with `_extract_css_vw_with_rule_limit` and `_css_scan_rules_simple`.

Every assertion below is a real oracle: expected values independently traced
by hand against the source algorithm in
`simple_web_html_layout_renderer_core.spl` (lines 122-214 for
`_css_collect_custom_props`, 216-394 for `_css_resolve_vars`), not copied from
a first run of the code. No smoke tests (bare calls with no assertion).

## Extension (session N+4) — the remaining four fixture-gated functions

This session builds the `HNode`/`SelectorContext`/`Rules` fixtures the prior
session deferred, closing `_pseudo_ctx_matches`,
`_extract_css_vw_with_rule_limit`, `_css_scan_rules_simple`, and
`compute_styles_with_material` (partially — it is a 465-line cascade
function; the new tests exercise the material-provenance branches and the
main per-node cascade entry, not every internal helper it calls).

`_extract_css_vw_with_rule_limit` and `_css_scan_rules_simple` turned out NOT
to need node fixtures at all — both operate purely on `html`/`css` text and
an `i32` limit, so they are exercised directly with crafted HTML/CSS strings
(traced against lines 431-445 for `@media` min-width/max-width semantics,
228-270 of `style/supports.spl` for a definite-true/definite-false
`@supports` query, and the brace-density guard at line ~482-493 for the
hostile-input truncation path).

`_pseudo_ctx_matches` needs a real `[HNode]` + `SelectorContext`: built here
with `mk_node`/`build_child_index`/`build_selector_context` from
`simple_web_html_layout_renderer_foundation.spl` (the same constructors the
existing `paint_primitives_coverage_closure_spec.spl` and
`containment_layout_contain_wired_spec.spl` specs use), forming a 4-node tree
`root -> {a, b}`, `a -> {c}`. Every pseudo-class branch's expected boolean is
hand-traced against `_child_position`/`_sibling_count`/`_node_is_empty`/
`_nth_child_matches`/`_has_option_matches` (lines 1166-1253) given that shape.

`compute_styles_with_material` is exercised through the same
`parse_html -> extract_css_vw -> build_child_index -> compute_styles_with_material`
pipeline the production caller uses (`simple_web_html_layout_renderer.spl`
lines 1796-1809), reusing the `data-wm-theme-*` fixture shape from
`simple_web_material_witness_spec.spl`'s `_cpu_material_node`/
`_solid_material_node` helpers. Expected admission outcomes are hand-traced
against the `cpu_admitted`/`solid_admitted` boolean expressions at lines
2925-2950.
"""

use std.spec.{describe, it, expect}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_core.{
    _css_collect_custom_props,
    _css_resolve_vars,
    CssVarResolutionState,
    CssVarResolution,
    _pseudo_ctx_matches,
    _extract_css_vw_with_rule_limit,
    _css_scan_rules_simple,
    CssRuleScan,
    CssWrapperKind,
    Rules,
    extract_css_vw,
    compute_styles_with_material
}
use gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_foundation.{
    HNode,
    SelectorContext,
    mk_node,
    build_child_index,
    build_selector_context,
    parse_html
}

describe "core.spl: _css_collect_custom_props":
    it "returns empty when the stylesheet has no :root block":
        val out = _css_collect_custom_props("body { color: red; }", "")
        assert_equal(out, "")

    it "collects a single base :root custom property":
        val out = _css_collect_custom_props(":root { --a: 1; }", "")
        assert_equal(out, "--a:1\n")

    it "collects multiple base :root custom properties in source order":
        val out = _css_collect_custom_props(
            ":root { --a: 1; --b: two; }", ""
        )
        assert_equal(out, "--a:1\n--b:two\n")

    it "appends a matching :root[attr] variant after the base entries":
        val css = ":root { --a: 1; } :root[data-theme=\"dark\"] { --a: 2; }"
        val out = _css_collect_custom_props(css, "data-theme=\"dark\"")
        assert_equal(out, "--a:1\n--a:2\n")

    it "skips a :root[attr] variant whose attribute does not match":
        val css = ":root { --a: 1; } :root[data-theme=\"dark\"] { --a: 2; }"
        val out = _css_collect_custom_props(css, "data-theme=\"light\"")
        assert_equal(out, "--a:1\n")

    it "skips :root used as part of a larger compound selector":
        val out = _css_collect_custom_props(":root.dark { --a: 1; }", "")
        assert_equal(out, "")

    it "ignores declarations that are not custom properties (no -- prefix)":
        val out = _css_collect_custom_props(
            ":root { color: red; --a: 1; }", ""
        )
        assert_equal(out, "--a:1\n")

    it "trims whitespace around the property name and value":
        val out = _css_collect_custom_props(
            ":root {   --a  :   1px  ; }", ""
        )
        assert_equal(out, "--a:1px\n")

describe "core.spl: _css_resolve_vars":
    it "returns the input unchanged when it contains no var()":
        val state = CssVarResolutionState.new("")
        val result = _css_resolve_vars("solid red", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "solid red")
            _:
                assert_true(false)

    it "reports DepthExceeded when resolution_depth exceeds the 32 cap":
        val state = CssVarResolutionState.new("--a:red")
        val result = _css_resolve_vars("var(--a)", state, 33, 0, false)
        match result:
            CssVarResolution.DepthExceeded:
                assert_true(true)
            _:
                assert_true(false)

    it "reports BudgetExceeded when the substitution budget is exhausted":
        val state = CssVarResolutionState.new("--a:red")
        state.remaining = 0
        val result = _css_resolve_vars("var(--a)", state, 0, 0, false)
        match result:
            CssVarResolution.BudgetExceeded:
                assert_true(true)
            _:
                assert_true(false)

    it "substitutes a defined custom property with its value":
        val state = CssVarResolutionState.new("--a:red")
        val result = _css_resolve_vars("var(--a)", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "red")
            _:
                assert_true(false)

    it "keeps surrounding text around a substituted var()":
        val state = CssVarResolutionState.new("--a:red")
        val result = _css_resolve_vars("solid var(--a) 1px", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "solid red 1px")
            _:
                assert_true(false)

    it "falls back to the fallback text when the property is undefined":
        val state = CssVarResolutionState.new("")
        val result = _css_resolve_vars(
            "var(--missing, blue)", state, 0, 0, false
        )
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "blue")
            _:
                assert_true(false)

    it "resolves to empty text for an undefined property with no fallback":
        val state = CssVarResolutionState.new("")
        val result = _css_resolve_vars("var(--missing)", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "")
            _:
                assert_true(false)

    it "resolves multiple var() occurrences in one declaration":
        val state = CssVarResolutionState.new("--a:1px\n--b:solid")
        val result = _css_resolve_vars(
            "var(--a) var(--b)", state, 0, 0, false
        )
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "1px solid")
            _:
                assert_true(false)

describe "core.spl: _extract_css_vw_with_rule_limit":
    it "returns an empty Rules when requested_rule_limit is 0 or negative":
        val out = _extract_css_vw_with_rule_limit(
            "<html><style>div{color:red}</style></html>", 400, false, -1
        )
        assert_equal(out.group_parts.len(), 0)
        assert_equal(out.decls.len(), 0)

    it "collects a single style rule from one <style> block":
        val out = _extract_css_vw_with_rule_limit(
            "<html><style>div{color:red}</style></html>", 400, false, 10
        )
        assert_equal(out.group_parts.len(), 1)
        assert_equal(out.decls[0], "color:red;")

    it "strips a <template>'s <style> so it contributes no rule, keeping the sibling <style>":
        val html = (
            "<html><template><style>div{color:red}</style></template>" +
            "<style>span{color:blue}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)
        assert_equal(out.decls[0], "color:blue;")

    it "includes an @media rule whose min-width condition is satisfied by the viewport":
        val html = (
            "<html><style>@media (min-width: 300px) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)

    it "excludes an @media rule whose min-width condition is NOT satisfied by the viewport":
        val html = (
            "<html><style>@media (min-width: 300px) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 100, false, 10)
        assert_equal(out.group_parts.len(), 0)

    it "includes an @supports rule whose query is definitely supported":
        val html = (
            "<html><style>@supports (display: block) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)

    it "excludes an @supports rule whose query names an unknown property":
        val html = (
            "<html><style>@supports (not-a-real-prop: bar) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 0)

    it "includes an @layer rule unconditionally":
        val html = (
            "<html><style>@layer base {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)

describe "core.spl: _css_scan_rules_simple":
    it "returns an empty scan when requested_rule_cap is 0 or negative":
        val out = _css_scan_rules_simple("div{color:red}", -5)
        assert_equal(out.selectors.len(), 0)
        assert_equal(out.declarations.len(), 0)

    it "returns an empty scan when the css has no opening brace at all":
        val out = _css_scan_rules_simple("div color red no braces here", 10)
        assert_equal(out.selectors.len(), 0)

    it "scans a plain rule with no @-wrapper (wrapper_counts stays 0)":
        val out = _css_scan_rules_simple("div{color:red}", 10)
        assert_equal(out.selectors.len(), 1)
        assert_equal(out.selectors[0], "div")
        assert_equal(out.declarations[0], "color:red")
        assert_equal(out.wrapper_counts[0], 0)

    it "records a Media wrapper kind for a rule nested inside @media":
        val out = _css_scan_rules_simple(
            "@media (min-width:300px){div{color:red}}", 10
        )
        assert_equal(out.selectors.len(), 1)
        assert_equal(out.wrapper_counts[0], 1)
        match out.wrapper_kinds[0]:
            CssWrapperKind.Media:
                assert_true(true)
            _:
                assert_true(false)

    it "records a Supports wrapper kind for a rule nested inside @supports":
        val out = _css_scan_rules_simple(
            "@supports (display:block){div{color:red}}", 10
        )
        assert_equal(out.wrapper_counts[0], 1)
        match out.wrapper_kinds[0]:
            CssWrapperKind.Supports:
                assert_true(true)
            _:
                assert_true(false)

    it "records a Layer wrapper kind for a rule nested inside @layer":
        val out = _css_scan_rules_simple(
            "@layer base{div{color:red}}", 10
        )
        assert_equal(out.wrapper_counts[0], 1)
        match out.wrapper_kinds[0]:
            CssWrapperKind.Layer:
                assert_true(true)
            _:
                assert_true(false)

    it "records an Unsupported wrapper kind for a rule nested inside an unrecognized at-rule":
        val out = _css_scan_rules_simple(
            "@foo bar{div{color:red}}", 10
        )
        assert_equal(out.wrapper_counts[0], 1)
        match out.wrapper_kinds[0]:
            CssWrapperKind.Unsupported:
                assert_true(true)
            _:
                assert_true(false)

    it "truncates hostile brace-dense input past the structural cap without emitting a rule":
        # rule_cap=1 -> structural_cap = 1*2+64 = 66. 100 "{" characters with
        # no matching selector/declaration text trips excessive_structure
        # (open-brace count 100 > 66), so bounded_css is cut to a 66-byte
        # prefix of bare "{" characters -- no real selector ever forms, so
        # zero rules are emitted, and the call must not crash.
        var braces = ""
        var n = 0
        while n < 100:
            braces = braces + "{"
            n = n + 1
        val out = _css_scan_rules_simple(braces, 1)
        assert_equal(out.selectors.len(), 0)

describe "core.spl: _pseudo_ctx_matches":
    # Tree: root(0, parent -1) -> a(1), b(2); a(1) -> c(3). a and b are
    # root's two element children (a first, b last); c is a's only child.
    it "returns true immediately when the selector has no ':' pseudo-class at all":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div", nodes, ctx, 1))

    it "':empty' is true for a childless node and false for a node with a child":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:empty", nodes, ctx, 2))
        assert_false(_pseudo_ctx_matches("div:empty", nodes, ctx, 1))

    it "':first-child' and ':last-child' match the correct sibling positions":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:first-child", nodes, ctx, 1))
        assert_false(_pseudo_ctx_matches("div:first-child", nodes, ctx, 2))
        assert_true(_pseudo_ctx_matches("div:last-child", nodes, ctx, 2))
        assert_false(_pseudo_ctx_matches("div:last-child", nodes, ctx, 1))

    it "':only-child' is true only for a node whose parent has exactly one element child":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:only-child", nodes, ctx, 3))
        assert_false(_pseudo_ctx_matches("div:only-child", nodes, ctx, 1))

    it "':nth-child(2)' matches only the second element child":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:nth-child(2)", nodes, ctx, 2))
        assert_false(_pseudo_ctx_matches("div:nth-child(2)", nodes, ctx, 1))

    it "already-handled state/list pseudos (:hover, :root, :not()) pass through as true":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:hover", nodes, ctx, 1))
        assert_true(_pseudo_ctx_matches("div:not(.x)", nodes, ctx, 1))
        assert_true(_pseudo_ctx_matches("html:root", nodes, ctx, 0))

    it "':root[attr]' skips the bracketed attribute suffix before falling through to the already-checked branch":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("html:root[data-theme]", nodes, ctx, 0))

    it "an unrecognized pseudo-class name returns false":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_false(_pseudo_ctx_matches("div:unknownpseudo", nodes, ctx, 1))

    it "an unclosed functional pseudo-class argument returns false":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_false(_pseudo_ctx_matches("div:nth-child(2", nodes, ctx, 1))

    it "':has(div)' is true when a descendant matches and false when none does":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:has(div)", nodes, ctx, 0))
        assert_false(_pseudo_ctx_matches("div:has(span)", nodes, ctx, 0))

    it "':has(span, div)' matches on the second comma-separated option":
        var root = mk_node("#root", -1)
        var a = mk_node("div", 0)
        var b = mk_node("div", 0)
        var c = mk_node("div", 1)
        val nodes = [root, a, b, c]
        val child_index = build_child_index(nodes)
        val ctx = build_selector_context(nodes, child_index)
        assert_true(_pseudo_ctx_matches("div:has(span, div)", nodes, ctx, 0))

describe "core.spl: compute_styles_with_material":
    it "admits a CPU-composited material entry for a node meeting every admission condition":
        val html = (
            "<html><body><section id='s' " +
            "data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' " +
            "data-wm-theme-fallback='solid-material' " +
            "data-wm-theme-bg='#123456' " +
            "style='background:rgba(31,31,33,0.80);" +
            "backdrop-filter:blur(4px) saturate(120%)'>" +
            "</section></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(styles.len(), nodes.len())
        assert_equal(material_counts[0], 1)
        assert_equal(cpu_material_nodes.len(), 1)
        assert_equal(material_counts[1], 0)

    it "admits a solid-material entry for an opaque node with no backdrop/gradient/mode":
        val html = (
            "<html><body><section id='s' " +
            "data-wm-theme-fallback='solid-material' " +
            "data-wm-theme-bg='#123456' " +
            "style='background:#123456'>" +
            "</section></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(material_counts[1], 1)
        assert_equal(solid_material_nodes.len(), 1)
        assert_equal(material_counts[0], 0)

    it "admits neither material channel for a plain node with no data-wm-theme-fallback contract":
        val html = (
            "<html><body><div id='plain' style='color:red'>" +
            "hello</div></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(material_counts[0], 0)
        assert_equal(material_counts[1], 0)
        assert_equal(cpu_material_nodes.len(), 0)
        assert_equal(solid_material_nodes.len(), 0)

    it "applies an id-selector CSS rule's cascade onto the matching node's computed style":
        val html = (
            "<html><style>#target{color:red}</style>" +
            "<body><div id='target'>hi</div></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(styles.len(), nodes.len())

# Round 3 (session N+5) — branches round 1/2 did not reach. Line numbers are
# from core.spl as of this session (unchanged since round 2's report):
#
# - _css_resolve_vars cycle detection (293-301, 342-345, 364-366): a
#   `--a: var(--a)` self-reference recurses one level; the active-names scan
#   (296) finds the name already on the stack (cycle=true, 297); the nested
#   frame hits the Cycle match arm at 364-366 and returns early, while the
#   outer (nested=false) frame hits the OTHER Cycle arm (342-345,
#   `should_use_fallback = not nested`) and either swallows it to empty text
#   (no fallback) or re-resolves the fallback text (with one).
# - _css_resolve_vars active-names capacity guard (315-316): distinct from
#   the already-tested `resolution_depth > 32` outer check — reached by
#   calling with active_count=33 directly (the two counters only stay in
#   lockstep through the function's own recursion; a caller can decouple
#   them).
# - _css_scan_rules_simple wrapper-overflow push (574-577): 34 nested @layer
#   wrappers around one selector drive `depth-1 > 32` (wrapper_overflow),
#   pushing a synthetic Unsupported/"@unsupported-overflow" entry instead of
#   walking the ancestor stack.
# - _media_group_applies (via _extract_css_vw_with_rule_limit, 419-424): the
#   max-width branch (satisfied and unsatisfied) and the unknown-feature
#   `else: ok = false` branch, neither reached by the existing min-width-only
#   and @supports tests.
# - _media_prelude_applies's comma-OR (440-443): a two-group prelude where
#   the first group fails and the second passes.
# - compute_styles_with_material's rejection diagnostic (~2960-2964):
#   reached only when wm_fallback == "solid-material" AND neither admission
#   path succeeds. The existing "neither channel" test uses a node with NO
#   fallback contract at all, which never reaches this line (wm_fallback !=
#   "solid-material"). Declaring the fallback contract without a
#   data-wm-theme-bg attribute (so declared_opaque is false) reaches it.
#
# Every expected value below is hand-traced against the source before
# running, per the existing spec's evidence bar.

describe "core.spl: _css_resolve_vars — cycle detection":
    it "a direct self-reference with no fallback resolves to empty text (cycle swallowed at top level)":
        val state = CssVarResolutionState.new("--a:var(--a)")
        val result = _css_resolve_vars("var(--a)", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "")
            _:
                assert_true(false)

    it "a direct self-reference WITH a fallback resolves to the fallback text":
        val state = CssVarResolutionState.new("--a:var(--a)")
        val result = _css_resolve_vars("var(--a, blue)", state, 0, 0, false)
        match result:
            CssVarResolution.Resolved(value):
                assert_equal(value, "blue")
            _:
                assert_true(false)

    it "reports DepthExceeded via the active-names capacity guard, independent of resolution_depth":
        val state = CssVarResolutionState.new("--a:red")
        val result = _css_resolve_vars("var(--a)", state, 0, 33, false)
        match result:
            CssVarResolution.DepthExceeded:
                assert_true(true)
            _:
                assert_true(false)

describe "core.spl: _css_scan_rules_simple — wrapper overflow":
    it "pushes a synthetic Unsupported/@unsupported-overflow wrapper past 32 nested @-wrappers":
        var css = ""
        var depth_i = 0
        while depth_i < 34:
            css = css + "@layer l" + depth_i.to_text() + "{"
            depth_i = depth_i + 1
        css = css + "div{color:red}"
        var close_i = 0
        while close_i < 34:
            css = css + "}"
            close_i = close_i + 1
        val out = _css_scan_rules_simple(css, 10)
        assert_equal(out.selectors.len(), 1)
        val last_kind_idx = out.wrapper_kinds.len() - 1
        val last_prelude_idx = out.wrapper_preludes.len() - 1
        match out.wrapper_kinds[last_kind_idx]:
            CssWrapperKind.Unsupported:
                assert_true(true)
            _:
                assert_true(false)
        assert_equal(out.wrapper_preludes[last_prelude_idx], "@unsupported-overflow")

describe "core.spl: _extract_css_vw_with_rule_limit — media-group shapes":
    it "includes an @media rule whose max-width condition is satisfied by the viewport":
        val html = (
            "<html><style>@media (max-width: 500px) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)

    it "excludes an @media rule whose max-width condition is NOT satisfied by the viewport":
        val html = (
            "<html><style>@media (max-width: 500px) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 600, false, 10)
        assert_equal(out.group_parts.len(), 0)

    it "excludes an @media rule whose feature name is unrecognized (neither min-width nor max-width)":
        val html = (
            "<html><style>@media (prefers-color-scheme: dark) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 0)

    it "includes an @media rule via its second comma-separated group when the first group fails":
        val html = (
            "<html><style>@media (min-width: 999px), (max-width: 999px) {" +
            "div{color:red}}</style></html>"
        )
        val out = _extract_css_vw_with_rule_limit(html, 400, false, 10)
        assert_equal(out.group_parts.len(), 1)

describe "core.spl: compute_styles_with_material — rejection diagnostic":
    it "reaches the entry-rejected diagnostic when the fallback contract is declared but no admission condition is met":
        val html = (
            "<html><body><section id='s' " +
            "data-wm-theme-fallback='solid-material' " +
            "style='background:#123456'>" +
            "</section></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(material_counts[0], 0)
        assert_equal(material_counts[1], 0)
        assert_equal(cpu_material_nodes.len(), 0)
        assert_equal(solid_material_nodes.len(), 0)

# Round 4 (session N+6) — branches round 1-3 did not reach:
#
# - `material_channel_ready` false branch (2524-2530, 2978-2984): every prior
#   test passed 2-length `material_entries`/`material_counts` arrays, so
#   `material_entries.len() >= 2 and material_counts.len() >= 2` was always
#   true. Passing empty arrays flips it false, which also forces
#   `cpu_admitted`/`solid_admitted` false (both require
#   `material_channel_ready and ...`), so the material-count-write block at
#   the end (2978-2980) is skipped too.
# - `trace_stages = true` (every `[layout-trace] style_stage=...` print in
#   the per-node loop, e.g. 2532-2536, 2543-2544, 2573-2574, 2596-2604,
#   2610-2611, 2614-2619, 2623-2627, 2657-2658, 2708-2709, 2870-2871,
#   2968-2969): every prior test hardcoded `trace_stages=false`, matching the
#   doc comment at 2545 ("every real caller hardwires false") but leaving
#   this whole print family unreached by any unit spec.
# - the rule-decl and inline `empty-cells:hide` branches (2696-2701,
#   2769-2776, 2872-2873): `empty_cells_hide` starts false and is set only
#   when a `td`/`th` node's cascade carries `empty-cells:hide` from a
#   matched rule or its inline `style=`; the guard at 2872 then blanks the
#   background only when that cell also has no content-child (`<td></td>`
#   with no children satisfies `not selector_ctx.has_content_child[i]`,
#   traced against `has_content_child` in
#   simple_web_html_layout_renderer_foundation.spl:404-415, which is set
#   only when a child carries text/element content).
#
# Every expected value below is hand-traced against the source before
# running, per the existing spec's evidence bar.

describe "core.spl: compute_styles_with_material — material_channel_ready false":
    it "skips both material channels and the trailing count-write when the material arrays are too short":
        val html = (
            "<html><body><section id='s' " +
            "data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' " +
            "data-wm-theme-fallback='solid-material' " +
            "data-wm-theme-bg='#123456' " +
            "style='background:rgba(31,31,33,0.80);" +
            "backdrop-filter:blur(4px) saturate(120%)'>" +
            "</section></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = []
        var material_counts: [i64] = []
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(styles.len(), nodes.len())
        assert_equal(material_entries.len(), 0)
        assert_equal(material_counts.len(), 0)
        assert_equal(cpu_material_nodes.len(), 0)
        assert_equal(solid_material_nodes.len(), 0)

describe "core.spl: compute_styles_with_material — trace_stages=true":
    it "runs the full [layout-trace] print family without crashing and still computes styles":
        val html = (
            "<html><style>#target{color:red}</style>" +
            "<body><div id='target'>hi</div></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, true, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        assert_equal(styles.len(), nodes.len())

describe "core.spl: compute_styles_with_material — empty-cells:hide":
    it "blanks the background of a content-empty td whose matched RULE sets empty-cells:hide":
        val html = (
            "<html><style>td{empty-cells:hide}</style>" +
            "<body><table><tr><td id='c'></td></tr></table></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        var idx = 0
        var found = false
        while idx < nodes.len():
            if nodes[idx].tag == "td":
                assert_equal(styles[idx].bg, 0u32)
                found = true
            idx = idx + 1
        assert_true(found)

    it "blanks the background of a content-empty td whose INLINE style sets empty-cells:hide":
        val html = (
            "<html><body><table><tr>" +
            "<td id='c' style='empty-cells:hide'></td>" +
            "</tr></table></body></html>"
        )
        val nodes = parse_html(html)
        val rules = extract_css_vw(html, 400, false)
        val child_index = build_child_index(nodes)
        var material_entries: [text] = ["", ""]
        var material_counts: [i64] = [0, 0]
        var cpu_material_nodes: [i32] = []
        var solid_material_nodes: [i32] = []
        val styles = compute_styles_with_material(
            nodes, rules, child_index, false, true,
            material_entries, material_counts,
            cpu_material_nodes, solid_material_nodes
        )
        var idx = 0
        var found = false
        while idx < nodes.len():
            if nodes[idx].tag == "td":
                assert_equal(styles[idx].bg, 0u32)
                found = true
            idx = idx + 1
        assert_true(found)
