"""
## Purpose and audience
Purpose: Prove that Browser CSS animation target identity.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001 — stable requirement identity for this spec.

use std.spec.*

use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, BrowserLogLevel}
use std.gc_async_mut.gpu.browser_engine.style.animation.{
    Animation, AnimationEngine, CSSDeclaration, CSSValue, Keyframe, Transition,
    interpolate, sample_keyframes, sample_keyframes_with_underlying,
    style_animation_capacity_available
}
use std.gc_async_mut.gpu.browser_engine.style_block_parse.{extract_keyframes}
use std.common.animation.timing.{TimingFunction}
use std.common.color.types.{from_rgba}

describe "Browser CSS animation target identity":

    it "bounds active style animation state":
        step("Verify: bounds active style animation state")
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        expect(style_animation_capacity_available(1023)).to_equal(true)
        expect(style_animation_capacity_available(1024)).to_equal(false)

    it "emits interpolated updates for the animated DOM node":
        step("Verify: emits interpolated updates for the animated DOM node")
        val start = Keyframe.create(
            0.0, [CSSDeclaration.create("opacity", CSSValue.Number(v: 0.0))]
        )
        val finish = Keyframe.create(
            1.0, [CSSDeclaration.create("opacity", CSSValue.Number(v: 1.0))]
        )
        val logger = Logger.new("style-animation-spec", BrowserLogLevel.Error)
        val engine = AnimationEngine.new(logger)
        engine.add_animation(
            Animation.create_for_node(42, "fade", [start, finish], 100.0)
        )

        expect(engine.tick(0.0).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val updates = engine.tick(50.0)
        expect(updates.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(updates[0].node_id).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(updates[0].property).to_equal("opacity")

    it "emits transition updates for the transitioned DOM node":
        step("Verify: emits transition updates for the transitioned DOM node")
        val logger = Logger.new("style-transition-spec", BrowserLogLevel.Error)
        val engine = AnimationEngine.new(logger)
        engine.add_transition(Transition.create_for_node(
            77, "width", CSSValue.Number(v: 10.0),
            CSSValue.Number(v: 20.0), 100.0
        ))

        expect(engine.tick(0.0).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val updates = engine.tick(50.0)
        expect(updates.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(updates[0].node_id).to_equal(77)  # oracle: 77 — named expected value from the requirement
        expect(updates[0].property).to_equal("width")

    it "starts the next iteration at the first keyframe":
        step("Verify: starts the next iteration at the first keyframe")
        val start = Keyframe.create(
            0.0, [CSSDeclaration.create("opacity", CSSValue.Number(v: 0.0))]
        )
        val finish = Keyframe.create(
            1.0, [CSSDeclaration.create("opacity", CSSValue.Number(v: 1.0))]
        )
        val logger = Logger.new("style-animation-boundary", BrowserLogLevel.Error)
        val engine = AnimationEngine.new(logger)
        var animation = Animation.create_for_node(
            42, "repeat", [start, finish], 100.0
        )
        animation.iteration_count = 2.0
        animation.timing = TimingFunction.Linear
        engine.add_animation(animation)

        expect(engine.tick(0.0).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val updates = engine.tick(100.0)
        match updates[0].value:
            CSSValue.Number(v):
                expect(v).to_equal(0.0)  # oracle: 0.0 — named expected value from the requirement
            _:
                fail("Expected repeated animation boundary value")

    it "parses typed keyframe values before interpolating them":
        step("Verify: parses typed keyframe values before interpolating them")
        val registry = extract_keyframes("""
            @keyframes fade {
                from { background-color: #ff0000; width: 10px; opacity: 0; }
                to { background-color: #0000ff; width: 20px; opacity: 1; }
            }
        """)
        expect(registry.entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        val updates = sample_keyframes(42, registry.entries[0].frames, 0.5)
        expect(updates.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        match updates[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(127)  # oracle: 127 — named expected value from the requirement
                expect(color.g).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(color.b).to_equal(127)  # oracle: 127 — named expected value from the requirement
            _:
                expect(false).to_equal(true)
        match updates[1].value:
            CSSValue.Length(v, unit):
                expect(v).to_equal(15.0)  # oracle: 15.0 — named expected value from the requirement
                expect(unit).to_equal("px")
            _:
                expect(false).to_equal(true)
        match updates[2].value:
            CSSValue.Number(v):
                expect(v).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
            _:
                expect(false).to_equal(true)

    it "uses the underlying value for omitted keyframe endpoints":
        step("Verify: uses the underlying value for omitted keyframe endpoints")
        val registry = extract_keyframes("""
            @keyframes peak {
                50% { background-color: #2563eb; }
            }
        """)
        val underlying = [CSSDeclaration.create(
            "background-color",
            CSSValue.Color(color: from_rgba(239, 68, 68, 255))
        )]
        val start = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 0.0, underlying
        )
        val midpoint = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 0.5, underlying
        )
        val finish = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 1.0, underlying
        )

        match start[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(239)  # oracle: 239 — named expected value from the requirement
                expect(color.g).to_equal(68)  # oracle: 68 — named expected value from the requirement
                expect(color.b).to_equal(68)  # oracle: 68 — named expected value from the requirement
            _:
                fail("Expected implicit start color")
        match midpoint[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(37)  # oracle: 37 — named expected value from the requirement
                expect(color.g).to_equal(99)  # oracle: 99 — named expected value from the requirement
                expect(color.b).to_equal(235)  # oracle: 235 — named expected value from the requirement
            _:
                fail("Expected authored midpoint color")
        match finish[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(239)  # oracle: 239 — named expected value from the requirement
                expect(color.g).to_equal(68)  # oracle: 68 — named expected value from the requirement
                expect(color.b).to_equal(68)  # oracle: 68 — named expected value from the requirement
            _:
                fail("Expected implicit end color")

    it "samples mixed midpoint properties independently":
        step("Verify: samples mixed midpoint properties independently")
        val registry = extract_keyframes("""
            @keyframes peak {
                50% { background-color: #2563eb; width: auto; }
            }
        """)
        val underlying = [
            CSSDeclaration.create(
                "background-color",
                CSSValue.Color(color: from_rgba(239, 68, 68, 255))
            ),
            CSSDeclaration.create(
                "width", CSSValue.Length(v: 8.0, unit: "px")
            )
        ]
        val start = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 0.0, underlying
        )
        val midpoint = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 0.5, underlying
        )
        val finish = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 1.0, underlying
        )
        expect(start.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        match start[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(239)  # oracle: 239 — named expected value from the requirement
                expect(color.g).to_equal(68)  # oracle: 68 — named expected value from the requirement
                expect(color.b).to_equal(68)  # oracle: 68 — named expected value from the requirement
            _:
                fail("Expected independently sampled start color")
        match start[1].value:
            CSSValue.Length(v, unit):
                expect(v).to_equal(8.0)  # oracle: 8.0 — named expected value from the requirement
                expect(unit).to_equal("px")
            _:
                fail("Expected implicit start width")
        match midpoint[1].value:
            CSSValue.Keyword(v):
                expect(v).to_equal("auto")
            _:
                fail("Expected authored discrete midpoint width")
        match finish[1].value:
            CSSValue.Length(v, unit):
                expect(v).to_equal(8.0)  # oracle: 8.0 — named expected value from the requirement
                expect(unit).to_equal("px")
            _:
                fail("Expected implicit end width")

    it "interpolates incompatible percentage and length values discretely":
        step("Verify: interpolates incompatible percentage and length values discretely")
        val early = interpolate(
            CSSValue.Percentage(v: 50.0),
            CSSValue.Length(v: 8.0, unit: "px"),
            0.25
        )
        val late = interpolate(
            CSSValue.Percentage(v: 50.0),
            CSSValue.Length(v: 8.0, unit: "px"),
            0.5
        )
        match early:
            CSSValue.Percentage(v):
                expect(v).to_equal(50.0)  # oracle: 50.0 — named expected value from the requirement
            _:
                fail("Expected early percentage value")
        match late:
            CSSValue.Length(v, unit):
                expect(v).to_equal(8.0)  # oracle: 8.0 — named expected value from the requirement
                expect(unit).to_equal("px")
            _:
                fail("Expected late length value")

    it "samples background around unrelated endpoint properties":
        step("Verify: samples background around unrelated endpoint properties")
        val registry = extract_keyframes("""
            @keyframes peak {
                0% { opacity: 1; }
                50% { background-color: #2563eb; }
                100% { opacity: 1; }
            }
        """)
        val underlying = [CSSDeclaration.create(
            "background-color",
            CSSValue.Color(color: from_rgba(239, 68, 68, 255))
        )]
        val updates = sample_keyframes_with_underlying(
            42, registry.entries[0].frames, 0.25, underlying
        )
        expect(updates.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(updates[0].property).to_equal("background-color")
        match updates[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(138)  # oracle: 138 — named expected value from the requirement
                expect(color.g).to_equal(83)  # oracle: 83 — named expected value from the requirement
                expect(color.b).to_equal(151)  # oracle: 151 — named expected value from the requirement
            _:
                fail("Expected background independent of opacity endpoints")

    it "sorts reversed keyframes and caps hostile frame counts":
        step("Verify: sorts reversed keyframes and caps hostile frame counts")
        val reversed = extract_keyframes("""
            @keyframes reverse {
                to { opacity: 1; }
                from { opacity: 0; }
            }
        """)
        val updates = sample_keyframes(
            42, reversed.entries[0].frames, 0.25
        )
        match updates[0].value:
            CSSValue.Number(v):
                expect(v).to_equal(0.25)  # oracle: 0.25 — named expected value from the requirement
            _:
                fail("Expected sorted keyframe interpolation")

        var hostile = "@keyframes bounded {"
        var index = 0
        while index < 300:
            hostile = hostile + "{index}% { opacity: {index}; }"
            index = index + 1
        hostile = hostile + "}"
        val bounded = extract_keyframes(hostile)
        expect(bounded.entries[0].frames.len()).to_equal(256)  # oracle: 256 — named expected value from the requirement

        val hostile_offsets = "@keyframes offsets {" +
            "0%,".repeat(300) + "100% { opacity: 1; } }"
        expect(extract_keyframes(
            hostile_offsets
        ).entries[0].frames.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        val hostile_decls = "@keyframes declarations { from {" +
            "unused:value;".repeat(300) + "} }"
        expect(extract_keyframes(
            hostile_decls
        ).entries[0].frames[0].properties.len()).to_equal(256)  # oracle: 256 — named expected value from the requirement

        var hostile_rules = ""
        index = 0
        while index < 1030:
            hostile_rules = hostile_rules + "@keyframes k{index} { from { opacity: 0; } to { opacity: 1; } }"
            index = index + 1
        expect(extract_keyframes(hostile_rules).entries.len()).to_equal(1024)  # oracle: 1024 — named expected value from the requirement

    it "cascades duplicate keyframe offsets in source order":
        step("Verify: cascades duplicate keyframe offsets in source order")
        val registry = extract_keyframes("""
            @keyframes duplicate-offset {
                0% { background-color: #ef4444; opacity: 0; }
                50% { background-color: #2563eb; opacity: 0.5; }
                50% { background-color: #22c55e; }
                100% { background-color: #000000; opacity: 1; }
            }
        """)
        expect(registry.entries[0].frames.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val midpoint_properties = registry.entries[0].frames[1].properties
        expect(midpoint_properties.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(midpoint_properties[0].property).to_equal("opacity")
        match midpoint_properties[0].value:
            CSSValue.Number(v):
                expect(v).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
            _:
                fail("Expected earlier same-offset opacity to survive")
        expect(midpoint_properties[1].property).to_equal("background-color")
        match midpoint_properties[1].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(34)  # oracle: 34 — named expected value from the requirement
                expect(color.g).to_equal(197)  # oracle: 197 — named expected value from the requirement
                expect(color.b).to_equal(94)  # oracle: 94 — named expected value from the requirement
            _:
                fail("Expected later same-offset background color to win")
        val updates = sample_keyframes(
            42, registry.entries[0].frames, 0.5
        )
        expect(updates.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        match updates[0].value:
            CSSValue.Color(color):
                expect(color.r).to_equal(34)  # oracle: 34 — named expected value from the requirement
                expect(color.g).to_equal(197)  # oracle: 197 — named expected value from the requirement
                expect(color.b).to_equal(94)  # oracle: 94 — named expected value from the requirement
            _:
                fail("Expected later duplicate-offset color")
        match updates[1].value:
            CSSValue.Number(v):
                expect(v).to_equal(0.5)  # oracle: 0.5 — named expected value from the requirement
            _:
                fail("Expected cascaded midpoint opacity")
