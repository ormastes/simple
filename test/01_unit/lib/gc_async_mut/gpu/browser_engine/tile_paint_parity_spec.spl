# @req: REQ-LIB-GC-ASYNC-MUT-001

"""Tile paint parity spec (T2 CPU lane gate)

Pixel-parity oracle for the CPU tile-render-culling lane: the tiled painter
must produce a visible region identical to the classic paint() on the same
pipeline, while the tile counters prove real op-level culling (no
fabrication: ops_painted/tiles_skipped are recorded by paint_tiled itself).

Fixtures: a 95%-offscreen tall scrolling document, a mixed
text/border/shadow document compared over the FULL framebuffer, and a tall
document with a full-width opaque overlay driving T3 occlusion.

Plan gate: ops-painted <= 30% of baseline on the offscreen/occluded
fixtures. Plan: doc/03_plan/ui/rendering/tile_render_culling_plan.md

@tag: rendering, simple-web, tiles, culling, parity
"""

# @timeout_secs 2400
# Measured 2026-08-09 on the Rust seed: 7 examples, 0 failures in 1108s.
# The cost is irreducible here, not a runaway: the parity oracle needs the
# CLASSIC full-document paint as its reference, and both lanes allocate and
# fill a width x doc_height framebuffer (256x5120, one at 256x10240) — 12 such
# renders through the tree-walk interpreter at ~85s each. Under the default
# 120s per-spec budget the child was killed mid-run and the file reported
# "Process timed out" with NO verdict line, so it could never go red; the
# `slow_it` 600s floor is also short of what an honest run needs.

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_pixels_tile_lane
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles.{
    tile_stats_ops_painted, tile_stats_ops_total, tile_stats_tiles_live,
    tile_stats_tiles_occluded, tile_stats_tiles_skipped, tile_stats_reset
}

val DOC_W: i32 = 256
val TALL_DOC_H: i32 = 5120
val DEEP_DOC_H: i32 = 10240
val VIEW_H: i32 = 256

# `rows` alternating 100px rows + border, every 5th carrying text. 50 rows
# in a 5120px document = ~20x the 256px viewport (~95% offscreen at any one
# scroll position); 100 rows in 10240px for the culling-gate fixture.
fn _tall_doc_html(rows: i32) -> text:
    var body = ""
    var r = 0
    while r < rows:
        val cls = if r % 2 == 0: "row" else: "row alt"
        val label = if r % 5 == 0: "row {r} content" else: ""
        body = body + "<div class=\"{cls}\">{label}</div>"
        r = r + 1
    "<html><head><style>" +
        "html,body{margin:0;padding:0;background:#ffffff}" +
        ".row{height:98px;margin:0;background:#3b82f6;border-bottom:2px solid #1e3a5f;color:#ffffff}" +
        # Single-property brace groups like {background:#ef4444} would lex as
        # a string interpolation ({var:format}); double braces escape them.
        ".alt{{background:#ef4444}}" +
        "</style></head><body>" + body + "</body></html>"

fn _mixed_doc_html() -> text:
    "<html><head><style>" +
        "html,body{margin:0;padding:0;background:#f8fafc}" +
        ".card{margin:12px;padding:8px;background:#ffffff;border:2px solid #94a3b8;color:#111827}" +
        ".shadowed{box-shadow:4px 4px 4px #64748b;background:#e2e8f0;height:60px;margin:16px}" +
        ".outlined{outline:2px solid #dc2626;outline-offset:2px;height:40px;margin:16px;background:#fde68a}" +
        ".deep{height:120px;background:#0f172a}" +
        "</style></head><body>" +
        "<div class=\"card\">alpha card text</div>" +
        "<div class=\"shadowed\"></div>" +
        "<div class=\"outlined\"></div>" +
        "<div class=\"card\">beta card with a longer text run for glyphs</div>" +
        "<div class=\"deep\"></div>" +
        "<div class=\"card\">gamma</div>" +
        "</body></html>"

# Tall document plus a full-width opaque overlay pinned over the mid
# viewport: two full 256px tile rows (256x512 at y=1024) whose earlier row
# boxes must be occlusion-culled, never painted, and still pixel-correct.
fn _occluded_doc_html() -> text:
    var body = ""
    var r = 0
    while r < 50:
        val cls = if r % 2 == 0: "row" else: "row alt"
        body = body + "<div class=\"{cls}\"></div>"
        r = r + 1
    "<html><head><style>" +
        "html,body{margin:0;padding:0;background:#ffffff}" +
        ".row{height:98px;margin:0;background:#3b82f6;border-bottom:2px solid #1e3a5f}" +
        ".alt{{background:#ef4444}}" +
        ".overlay{position:absolute;left:0;top:1024px;width:256px;height:512px;background:#111827;z-index:5}" +
        "</style></head><body>" + body + "<div class=\"overlay\"></div></body></html>"

fn _diff_rows(a: [u32], b: [u32], w: i32, y0: i32, y1: i32) -> i64:
    var diffs: i64 = 0
    var y = y0
    while y < y1:
        val row = y * w
        var x = 0
        while x < w:
            if a[row + x] != b[row + x]:
                diffs = diffs + 1
            x = x + 1
        y = y + 1
    diffs

fn _parity_at(html: text, doc_h: i32, viewport_y: i32) -> i64:
    val base = simple_web_layout_render_html_software_pixels_tile_lane(
        html, DOC_W, doc_h, viewport_y, VIEW_H, false
    )
    val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
        html, DOC_W, doc_h, viewport_y, VIEW_H, true
    )
    expect(base.len()).to_equal(tiled.len())
    _diff_rows(base, tiled, DOC_W, viewport_y, viewport_y + VIEW_H)

use std.spec.step

describe "tile paint parity":

    it "matches the classic painter on the 95%-offscreen tall doc at scroll 0":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches the classic painter on the 95%-offscreen tall doc at scroll 0")
        expect(_parity_at(_tall_doc_html(50), TALL_DOC_H, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "matches the classic painter on the tall doc at mid scroll":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches the classic painter on the tall doc at mid scroll")
        expect(_parity_at(_tall_doc_html(50), TALL_DOC_H, 2432)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "matches the classic painter on the tall doc near the end":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: matches the classic painter on the tall doc near the end")
        expect(_parity_at(_tall_doc_html(50), TALL_DOC_H, TALL_DOC_H - VIEW_H)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "is byte-identical over the FULL framebuffer on the mixed document":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: is byte-identical over the FULL framebuffer on the mixed document")
        # Viewport covers the whole (short) document: every tile is live, so
        # any diff would expose a non-conservative cull or a raster change.
        val html = _mixed_doc_html()
        val base = simple_web_layout_render_html_software_pixels_tile_lane(
            html, DOC_W, 512, 0, 512, false
        )
        val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
            html, DOC_W, 512, 0, 512, true
        )
        expect(_diff_rows(base, tiled, DOC_W, 0, 512)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "stays pixel-identical while occlusion-culling under the opaque overlay":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: stays pixel-identical while occlusion-culling under the opaque overlay")
        expect(_parity_at(_occluded_doc_html(), TALL_DOC_H, 1024)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "tile culling effectiveness":

    it "paints at most 30% of baseline ops on the deep scrolled doc":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: paints at most 30% of baseline ops on the deep scrolled doc")
        tile_stats_reset()
        val html = _tall_doc_html(100)
        val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
            html, DOC_W, DEEP_DOC_H, 4992, VIEW_H, true
        )
        expect(tiled.len() > 0).to_equal(true)
        val total = tile_stats_ops_total()
        val painted = tile_stats_ops_painted()
        print "[tile-bench] fixture=deep_97pct_offscreen ops_total={total} ops_painted={painted} tiles_live={tile_stats_tiles_live()} tiles_skipped={tile_stats_tiles_skipped()}"
        expect(total > 0).to_equal(true)
        expect(painted > 0).to_equal(true)
        # Plan T5 gate: ops-painted <= 30% of baseline on the K=20 fixture.
        expect(painted * 100 <= total * 30).to_equal(true)
        expect(tile_stats_tiles_skipped() > 0).to_equal(true)

    it "occlusion-culls tiles fully covered by the opaque overlay":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: occlusion-culls tiles fully covered by the opaque overlay")
        tile_stats_reset()
        val html = _occluded_doc_html()
        val tiled = simple_web_layout_render_html_software_pixels_tile_lane(
            html, DOC_W, TALL_DOC_H, 1024, VIEW_H, true
        )
        expect(tiled.len() > 0).to_equal(true)
        val occluded = tile_stats_tiles_occluded()
        val painted = tile_stats_ops_painted()
        val total = tile_stats_ops_total()
        print "[tile-bench] fixture=occluded_overlay ops_total={total} ops_painted={painted} tiles_occluded={occluded}"
        # The 256x512 overlay fully covers 2 tiles.
        expect(occluded >= 2).to_equal(true)
        expect(painted * 100 <= total * 30).to_equal(true)
