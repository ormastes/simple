# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_engine.spl 1%
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_layout_foundation.spl 1%
# @tag: unit, browser_engine, layout, flex, grid, table, chrome159
#
# Box geometry of text-free pages through the full layout renderer: flex
# rows, wrapping lines and columns (justify-content, align-items/-self,
# align-content, auto margins, grow/shrink/basis, order, min/max on the
# container, absolutely positioned children, direction:rtl), grid placement
# (named areas, explicit lines, column auto-flow, fr tracks, repeat(), gaps),
# tables (captions, fixed layout, border-spacing), overflow:hidden and
# min/max-height blocks, replaced elements (canvas, video, audio, svg
# default object sizes with padding and border, svg viewBox ratios) and
# percentage min/max sizes.
#
# Oracle: Chrome 159.0.8154.6 headless shell, 900x2000 viewport, each page
# `<html><head><style>body{margin:0;font:16px/1 sans-serif}</style></head>
# <body>...` with the markup below, `getBoundingClientRect()` of each id as
# `x,y,w,h`, run 2026-11-15. No box holds text, so every value is
# font-independent. Rows whose Chrome value is fractional are not used.
#
# Rows where this renderer disagrees with Chrome are filed, not asserted:
# doc/08_tracking/bug/web_layout_flex_grid_table_chrome159_divergences_2026-11-15.md.

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_debug_layout_by_id}

fn _box(body: text, id: text) -> text:
    val p = "<html><head><style>body{{margin:0;font:16px/1 sans-serif}}</style></head><body>" + body + "</body></html>"
    simple_web_layout_debug_layout_by_id(p, 900, 2000, id, "x") + "," + simple_web_layout_debug_layout_by_id(p, 900, 2000, id, "y") + "," + simple_web_layout_debug_layout_by_id(p, 900, 2000, id, "w") + "," + simple_web_layout_debug_layout_by_id(p, 900, 2000, id, "h")

describe "Flex rows":

    it "flex row margin auto":
        val page = "<div id=\"c\" style=\"display:flex;width:200px\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px;margin-left:auto\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,40,10")
        expect(_box(page, "b")).to_equal("160,0,40,10")

    it "flex row margin auto both":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px\"><div id=\"a\" style=\"width:40px;height:10px;margin:auto\"></div></div>"
        expect(_box(page, "a")).to_equal("80,20,40,10")

    it "flex row justify end":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;justify-content:flex-end\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("120,0,40,10")
        expect(_box(page, "b")).to_equal("160,0,40,10")

    it "flex row justify center":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;justify-content:center\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("60,0,40,10")
        expect(_box(page, "b")).to_equal("100,0,40,10")

    it "flex row justify around":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;justify-content:space-around\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("30,0,40,10")
        expect(_box(page, "b")).to_equal("130,0,40,10")

    it "flex row justify evenly":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;justify-content:space-evenly\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("40,0,40,10")
        expect(_box(page, "b")).to_equal("120,0,40,10")

    it "flex row align center":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px;align-items:center\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:30px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,20,40,10")
        expect(_box(page, "b")).to_equal("40,10,40,30")

    it "flex row align end":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px;align-items:flex-end\"><div id=\"a\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,40,40,10")

    it "flex row align self end":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px\"><div id=\"a\" style=\"width:40px;height:10px;align-self:flex-end\"></div><div id=\"b\" style=\"width:40px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,40,40,10")
        expect(_box(page, "b")).to_equal("40,0,40,50")

    it "flex row stretch minmax":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px\"><div id=\"a\" style=\"width:40px;max-height:20px\"></div><div id=\"b\" style=\"width:40px;min-height:60px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,40,20")
        expect(_box(page, "b")).to_equal("40,0,40,60")
        expect(_box(page, "c")).to_equal("0,0,200,50")

    it "flex row shrink":
        val page = "<div id=\"c\" style=\"display:flex;width:100px\"><div id=\"a\" style=\"width:80px;height:10px\"></div><div id=\"b\" style=\"width:80px;height:10px;flex-shrink:3\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,65,10")
        expect(_box(page, "b")).to_equal("65,0,35,10")

    it "flex row min height container":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;min-height:40px\"><div id=\"a\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,40,10")
        expect(_box(page, "c")).to_equal("0,0,200,40")

    it "flex row max height container":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;max-height:20px\"><div id=\"a\" style=\"width:40px;height:50px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,40,50")
        expect(_box(page, "c")).to_equal("0,0,200,20")

    it "flex row abs child":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;height:50px;position:relative\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"position:absolute;right:5px;bottom:5px;width:20px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,40,10")
        expect(_box(page, "b")).to_equal("175,35,20,10")

    it "flex row rtl":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;direction:rtl\"><div id=\"a\" style=\"width:40px;height:10px\"></div><div id=\"b\" style=\"width:30px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("160,0,40,10")
        expect(_box(page, "b")).to_equal("130,0,30,10")

    it "flex row padding border":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;padding:5px 7px;border:3px solid\"><div id=\"a\" style=\"width:40px;height:10px;margin:2px 4px\"></div></div>"
        expect(_box(page, "a")).to_equal("14,10,40,10")
        expect(_box(page, "c")).to_equal("0,0,220,30")

    it "flex row order":
        val page = "<div id=\"c\" style=\"display:flex;width:200px\"><div id=\"a\" style=\"width:40px;height:10px;order:2\"></div><div id=\"b\" style=\"width:30px;height:10px;order:1\"></div></div>"
        expect(_box(page, "a")).to_equal("30,0,40,10")
        expect(_box(page, "b")).to_equal("0,0,30,10")

    it "flex row gap nowrap":
        val page = "<div id=\"c\" style=\"display:flex;width:200px;gap:8px\"><div id=\"a\" style=\"width:50px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,50,10")
        expect(_box(page, "b")).to_equal("58,0,40,10")

    it "flex row basis grow int":
        val page = "<div id=\"c\" style=\"display:flex;width:220px\"><div id=\"a\" style=\"flex:1 1 50px;height:10px\"></div><div id=\"b\" style=\"flex:2 1 20px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,10")
        expect(_box(page, "b")).to_equal("100,0,120,10")

describe "Flex wrapping lines":

    it "flex wrap align content center":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;height:100px;align-content:center\"><div id=\"a\" style=\"width:60px;height:10px\"></div><div id=\"b\" style=\"width:60px;height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,35,60,10")
        expect(_box(page, "b")).to_equal("0,45,60,20")

    it "flex wrap align content end":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;height:100px;align-content:flex-end\"><div id=\"a\" style=\"width:60px;height:10px\"></div><div id=\"b\" style=\"width:60px;height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,70,60,10")
        expect(_box(page, "b")).to_equal("0,80,60,20")

    it "flex wrap align content between":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;height:100px;align-content:space-between\"><div id=\"a\" style=\"width:60px;height:10px\"></div><div id=\"b\" style=\"width:60px;height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,60,10")
        expect(_box(page, "b")).to_equal("0,80,60,20")

    it "flex wrap justify center":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;justify-content:center\"><div id=\"a\" style=\"width:60px;height:10px\"></div><div id=\"b\" style=\"width:30px;height:10px\"></div><div id=\"d\" style=\"width:30px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("5,0,60,10")
        expect(_box(page, "b")).to_equal("65,0,30,10")
        expect(_box(page, "d")).to_equal("35,10,30,10")

    it "flex wrap grow":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px\"><div id=\"a\" style=\"width:60px;height:10px;flex-grow:1\"></div><div id=\"b\" style=\"width:30px;height:10px;flex-grow:1\"></div><div id=\"d\" style=\"width:70px;height:10px;flex-grow:1\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,65,10")
        expect(_box(page, "b")).to_equal("65,0,35,10")
        expect(_box(page, "d")).to_equal("0,10,100,10")

    it "flex wrap gap single":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;gap:6px\"><div id=\"a\" style=\"width:50px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div><div id=\"d\" style=\"width:50px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,50,10")
        expect(_box(page, "b")).to_equal("56,0,40,10")
        expect(_box(page, "d")).to_equal("0,16,50,10")
        expect(_box(page, "c")).to_equal("0,0,100,26")

    it "flex wrap gap longhands":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;row-gap:5px;column-gap:10px\"><div id=\"a\" style=\"width:50px;height:10px\"></div><div id=\"b\" style=\"width:40px;height:10px\"></div><div id=\"d\" style=\"width:50px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,50,10")
        expect(_box(page, "b")).to_equal("60,0,40,10")
        expect(_box(page, "d")).to_equal("0,15,50,10")
        expect(_box(page, "c")).to_equal("0,0,100,25")

    it "flex wrap align content around int":
        val page = "<div id=\"c\" style=\"display:flex;flex-wrap:wrap;width:100px;height:100px;align-content:space-around\"><div id=\"a\" style=\"width:60px;height:10px\"></div><div id=\"b\" style=\"width:60px;height:30px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,15,60,10")
        expect(_box(page, "b")).to_equal("0,55,60,30")

describe "Flex columns":

    it "flex col justify center":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:100px;justify-content:center\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,35,100,10")
        expect(_box(page, "b")).to_equal("0,45,100,20")

    it "flex col justify end":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:100px;justify-content:flex-end\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,70,100,10")
        expect(_box(page, "b")).to_equal("0,80,100,20")

    it "flex col justify between":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:100px;justify-content:space-between\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:20px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,10")
        expect(_box(page, "b")).to_equal("0,80,100,20")

    it "flex col align center":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;align-items:center\"><div id=\"a\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("30,0,40,10")

    it "flex col align end":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;align-items:flex-end\"><div id=\"a\" style=\"width:40px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("60,0,40,10")

    it "flex col margin auto":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:100px\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:20px;margin-top:auto\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,10")
        expect(_box(page, "b")).to_equal("0,80,100,20")

    it "flex col minmax container":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;min-height:60px\"><div id=\"a\" style=\"height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,10")
        expect(_box(page, "c")).to_equal("0,0,100,60")

    it "flex col abs child":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:60px;position:relative\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"position:absolute;left:5px;top:7px;width:20px;height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,10")
        expect(_box(page, "b")).to_equal("5,7,20,10")

    it "flex col justify around int":
        val page = "<div id=\"c\" style=\"display:flex;flex-direction:column;width:100px;height:100px;justify-content:space-around\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:30px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,15,100,10")
        expect(_box(page, "b")).to_equal("0,55,100,30")

describe "Grid placement and tracks":

    it "grid areas":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:50px 70px;grid-template-rows:20px 30px;grid-template-areas:'h h' 's m';width:120px\"><div id=\"a\" style=\"grid-area:m\"></div><div id=\"b\" style=\"grid-area:h\"></div><div id=\"d\" style=\"grid-area:s\"></div></div>"
        expect(_box(page, "a")).to_equal("50,20,70,30")
        expect(_box(page, "d")).to_equal("0,20,50,30")

    it "grid explicit place":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:30px 40px 50px;grid-template-rows:10px 20px;width:120px\"><div id=\"a\" style=\"grid-column:2 / 4;grid-row:2\"></div><div id=\"b\"></div></div>"
        expect(_box(page, "b")).to_equal("0,0,30,10")

    it "grid auto flow column":
        val page = "<div id=\"c\" style=\"display:grid;grid-auto-flow:column;grid-template-rows:10px 20px;grid-template-columns:30px 40px;width:70px\"><div id=\"a\"></div><div id=\"b\"></div><div id=\"d\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,30,10")
        expect(_box(page, "b")).to_equal("0,10,30,20")
        expect(_box(page, "d")).to_equal("30,0,40,10")

    it "grid fr tracks":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:1fr 3fr;width:200px\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:10px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,50,10")
        expect(_box(page, "b")).to_equal("50,0,150,10")

    it "grid gap single":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:30px 40px;grid-template-rows:10px 20px;gap:6px;width:100px\"><div id=\"a\"></div><div id=\"b\"></div><div id=\"d\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,30,10")
        expect(_box(page, "b")).to_equal("36,0,40,10")
        expect(_box(page, "d")).to_equal("0,16,30,20")
        expect(_box(page, "c")).to_equal("0,0,100,36")

    it "grid gap longhands":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:30px 40px;grid-template-rows:10px 20px;row-gap:5px;column-gap:7px;width:100px\"><div id=\"a\"></div><div id=\"b\"></div><div id=\"d\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,30,10")
        expect(_box(page, "b")).to_equal("37,0,40,10")
        expect(_box(page, "d")).to_equal("0,15,30,20")
        expect(_box(page, "c")).to_equal("0,0,100,35")

    it "grid repeat":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:repeat(3, 20px);width:60px\"><div id=\"a\" style=\"height:5px\"></div><div id=\"b\" style=\"height:5px\"></div><div id=\"d\" style=\"height:5px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,20,5")
        expect(_box(page, "b")).to_equal("20,0,20,5")
        expect(_box(page, "d")).to_equal("40,0,20,5")

    it "grid padding border":
        val page = "<div id=\"c\" style=\"display:grid;grid-template-columns:30px 40px;padding:3px;border:2px solid;width:70px\"><div id=\"a\" style=\"height:10px\"></div><div id=\"b\" style=\"height:12px\"></div></div>"
        expect(_box(page, "a")).to_equal("5,5,30,10")
        expect(_box(page, "b")).to_equal("35,5,40,12")
        expect(_box(page, "c")).to_equal("0,0,80,22")

describe "Tables":

    it "table caption bottom":
        val page = "<table id=\"t\" style=\"border-spacing:4px;caption-side:bottom\"><caption id=\"cap\" style=\"height:10px\"></caption><tr><td id=\"a\" style=\"width:30px;height:12px;padding:0\"></td><td id=\"b\" style=\"width:20px;height:12px;padding:0\"></td></tr></table>"
        expect(_box(page, "t")).to_equal("0,0,62,30")
        expect(_box(page, "cap")).to_equal("0,20,62,10")
        expect(_box(page, "a")).to_equal("4,4,30,12")
        expect(_box(page, "b")).to_equal("38,4,20,12")

    it "table caption top":
        val page = "<table id=\"t\" style=\"border-spacing:2px\"><caption id=\"cap\" style=\"height:10px\"></caption><tr><td id=\"a\" style=\"width:30px;height:12px;padding:0\"></td></tr></table>"
        expect(_box(page, "t")).to_equal("0,0,34,26")
        expect(_box(page, "cap")).to_equal("0,0,34,10")
        expect(_box(page, "a")).to_equal("2,12,30,12")

    it "table fixed":
        val page = "<table id=\"t\" style=\"table-layout:fixed;width:200px;border-spacing:0\"><tr><td id=\"a\" style=\"width:50px;height:10px;padding:0\"></td><td id=\"b\" style=\"height:10px;padding:0\"></td></tr></table>"
        expect(_box(page, "a")).to_equal("0,0,50,10")

describe "Blocks and replaced elements":

    it "block overflow hidden minh":
        val page = "<div id=\"a\" style=\"overflow:hidden;min-height:30px;padding:5px;border:2px solid;width:50px\"></div><div id=\"b\" style=\"height:5px\"></div>"
        expect(_box(page, "a")).to_equal("0,0,64,44")
        expect(_box(page, "b")).to_equal("0,44,900,5")

    it "block overflow hidden h":
        val page = "<div id=\"a\" style=\"overflow:hidden;height:20px;width:50px;box-sizing:border-box;padding:4px\"><div style=\"height:100px\"></div></div><div id=\"b\" style=\"height:5px\"></div>"
        expect(_box(page, "a")).to_equal("0,0,50,20")
        expect(_box(page, "b")).to_equal("0,20,900,5")

    it "block minmax h":
        val page = "<div id=\"a\" style=\"height:10px;min-height:25px;width:50px\"></div><div id=\"b\" style=\"height:50px;max-height:15px;width:50px\"></div>"
        expect(_box(page, "a")).to_equal("0,0,50,25")
        expect(_box(page, "b")).to_equal("0,25,50,15")

    it "svg default size":
        val page = "<div><svg id=\"s\"></svg></div>"
        expect(_box(page, "s")).to_equal("0,0,300,150")

    it "svg width attr":
        val page = "<div><svg id=\"s\" width=\"40\" viewBox=\"0 0 20 10\"></svg></div>"
        expect(_box(page, "s")).to_equal("0,0,40,20")

describe "Replaced elements and percentage min/max":

    it "replaced canvas border":
        val page = "<canvas id=\"a\" style=\"display:block;border:2px solid;padding:3px\"></canvas>"
        expect(_box(page, "a")).to_equal("0,0,310,160")

    it "replaced canvas border box":
        val page = "<canvas id=\"a\" style=\"display:block;border:2px solid;padding:3px;box-sizing:border-box\"></canvas>"
        expect(_box(page, "a")).to_equal("0,0,310,160")

    it "replaced video border":
        val page = "<video id=\"a\" style=\"display:block;border:2px solid;padding:3px\"></video>"
        expect(_box(page, "a")).to_equal("0,0,310,160")

    it "replaced svg default":
        val page = "<svg id=\"a\" style=\"display:block;border:2px solid;padding:3px\"></svg>"
        expect(_box(page, "a")).to_equal("0,0,310,160")

    it "replaced audio controls":
        val page = "<audio id=\"a\" controls style=\"display:block;border:2px solid;padding:3px;box-sizing:border-box\"></audio>"
        expect(_box(page, "a")).to_equal("0,0,300,54")

    it "replaced video width attr":
        val page = "<video id=\"a\" width=\"120\" style=\"display:block\"></video>"
        expect(_box(page, "a")).to_equal("0,0,120,150")

    it "replaced canvas attrs":
        val page = "<canvas id=\"a\" width=\"40\" height=\"30\" style=\"display:block\"></canvas>"
        expect(_box(page, "a")).to_equal("0,0,40,30")

    it "svg viewbox height":
        val page = "<svg id=\"a\" viewBox=\"0 0 24 24\" style=\"display:block;height:32px\"></svg>"
        expect(_box(page, "a")).to_equal("0,0,32,32")

    it "svg viewbox auto":
        val page = "<svg id=\"a\" viewBox=\"0 0 200 50\" style=\"display:block\"></svg>"
        expect(_box(page, "a")).to_equal("0,0,900,225")

    it "svg viewbox extreme":
        val page = "<svg id=\"a\" viewBox=\"0 0 0.001 1000000\" width=\"100\" style=\"display:block\"></svg>"
        expect(_box(page, "a")).to_equal("0,0,100,150")

    it "svg viewbox width attr":
        val page = "<svg id=\"a\" viewBox=\"0 0 20 10\" width=\"60\" style=\"display:block\"></svg>"
        expect(_box(page, "a")).to_equal("0,0,60,30")

    it "pct min width":
        val page = "<div style=\"width:200px\"><div id=\"a\" style=\"width:10px;min-width:50%;height:5px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,100,5")

    it "pct max width":
        val page = "<div style=\"width:200px\"><div id=\"a\" style=\"width:150px;max-width:25%;height:5px\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,50,5")

    it "pct min height":
        val page = "<div style=\"height:200px\"><div id=\"a\" style=\"height:10px;min-height:50%\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,900,100")

    it "pct max height":
        val page = "<div style=\"height:200px\"><div id=\"a\" style=\"height:150px;max-height:10%\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,900,20")

    it "abs pct min width":
        val page = "<div style=\"position:relative;width:200px;height:100px\"><div id=\"a\" style=\"position:absolute;left:0;top:0;width:10px;height:10px;min-width:30%\"></div></div>"
        expect(_box(page, "a")).to_equal("0,0,60,10")
