# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/ui/gpu_offload/cpu_gpu_boundary_census_2026-09-11.md ; plan: doc/03_plan/ui/gpu_offload/web_vulkan_cpu_gpu_boundary_fix_plan_2026-09-11.md

use std.spec.step
use std.spec.*
use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    simple_web_engine2d_resolved_backend_name,
    simple_web_engine2d_resolved_backend_name_with_reason}

describe "SimpleWebEngine2DRenderer backend fallback reason":
    it "reports empty reason for a viable cpu backend":
        # @req REQ-SSPEC-LIB
        step("reports empty reason for a viable cpu backend")
        val (resolved, reason) = simple_web_engine2d_resolved_backend_name_with_reason(32, 24, "cpu_simd")
        expect(resolved).to_equal("cpu_simd")
        expect(reason).to_equal("")

    it "surfaces a non-empty reason when a requested backend cannot be probed and falls back to software":
        # @req REQ-SSPEC-LIB
        # oracle: an unknown backend name always fails Engine2D.probe_backend
        # (unrecognized backend), so this fixture reproduces a probe failure
        # without depending on any specific GPU being present on the host.
        step("surfaces a non-empty reason on probe failure")
        val (resolved, reason) = simple_web_engine2d_resolved_backend_name_with_reason(32, 24, "not_a_real_backend")
        expect(resolved).to_equal("software")
        expect(reason == "").to_equal(false)

    it "keeps the legacy resolver name-only for existing callers":
        # @req REQ-SSPEC-LIB
        step("keeps the legacy resolver name-only for existing callers")
        val resolved = simple_web_engine2d_resolved_backend_name(32, 24, "not_a_real_backend")
        expect(resolved).to_equal("software")
