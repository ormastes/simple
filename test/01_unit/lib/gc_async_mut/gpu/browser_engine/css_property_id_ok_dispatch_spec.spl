# @req: REQ-LIB-GC-ASYNC-MUT-001

use std.spec
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_declarations.{
    _APPLY_DECLS_DISPATCH_PROPS, apply_decls
}
use std.gc_async_mut.gpu.browser_engine.simple_web_css_property_id.{
    css_prop_id, css_prop_mask, css_prop_mask_has, CSS_PROP_UNKNOWN,
    CSS_PROP_COLOR, CSS_PROP_WIDTH,
    css_probe_reset, css_probe_count
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_style.{renderer_default_style}

# Force the SAME declarations through the pre-existing full-probe body by
# appending a property that is NOT dispatch-handled (letter-spacing does not
# interact with any field compared below). Dispatch vs probe must agree.
fn _probe_twin(decls: text) -> text:
    decls + ";letter-spacing:1px"

describe "css_prop_id stays in lockstep with the dispatch allowlist":
    it "every dispatch prop has a nonzero id and unknown names are zero":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: every dispatch prop has a nonzero id and unknown names are zero")
        var i = 0
        var missing = 0
        while i < _APPLY_DECLS_DISPATCH_PROPS.len():
            if css_prop_id(_APPLY_DECLS_DISPATCH_PROPS[i]) == CSS_PROP_UNKNOWN:
                missing = missing + 1
            i = i + 1
        expect(missing).to_equal(0)  # oracle: 0 — named expected value from the requirement
        # anti-vacuity: the allowlist was actually traversed
        expect(_APPLY_DECLS_DISPATCH_PROPS.len() > 20).to_equal(true)
        expect(css_prop_id("letter-spacing")).to_equal(CSS_PROP_UNKNOWN)
        expect(css_prop_id("not-a-property")).to_equal(CSS_PROP_UNKNOWN)

    it "mask reflects presence of declared properties":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: mask reflects presence of declared properties")
        val tbl: [text] = ["color", "#ff0000", "width", "10px"]
        val mask = css_prop_mask(tbl)
        expect(css_prop_mask_has(mask, CSS_PROP_COLOR)).to_equal(true)
        expect(css_prop_mask_has(mask, CSS_PROP_WIDTH)).to_equal(true)
        val empty_mask = css_prop_mask([])
        expect(empty_mask).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "apply_decls dispatch path is O(k) in declarations, not O(props)":
    it "2 declarations cost at most 2*k + 2 probes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: 2 declarations cost at most 2*k + 2 probes")
        val st = renderer_default_style()
        css_probe_reset()
        apply_decls(st, "color:#ff0000;width:10px", 16)
        val probes = css_probe_count()
        # k=2. Pre-Stage-3 the dispatch body probed every allowlisted
        # property (~25+ table scans) regardless of presence.
        expect(probes <= 6).to_equal(true)
        expect(probes >= 2).to_equal(true)

    it "single declaration costs O(1) probes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: single declaration costs O(1) probes")
        val st = renderer_default_style()
        css_probe_reset()
        apply_decls(st, "z-index:3", 16)
        val probes = css_probe_count()
        expect(probes <= 3).to_equal(true)
        expect(probes >= 1).to_equal(true)

describe "gated dispatch families stay parity-equal with the probe body":
    it "margin family: longhand after shorthand wins on both paths":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: margin family: longhand after shorthand wins on both paths")
        val d = "margin:1px 2px 3px 4px;margin-left:9px"
        val a = apply_decls(renderer_default_style(), d, 16)
        val b = apply_decls(renderer_default_style(), _probe_twin(d), 16)
        expect(a.margin_l).to_equal(b.margin_l)
        expect(a.margin_l).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(a.margin_t).to_equal(b.margin_t)
        expect(a.margin_r).to_equal(b.margin_r)
        expect(a.margin_b).to_equal(b.margin_b)

    it "margin family: shorthand after longhand wins on both paths":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: margin family: shorthand after longhand wins on both paths")
        val d = "margin-left:9px;margin:1px 2px 3px 4px"
        val a = apply_decls(renderer_default_style(), d, 16)
        val b = apply_decls(renderer_default_style(), _probe_twin(d), 16)
        expect(a.margin_l).to_equal(b.margin_l)
        expect(a.margin_l).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "border-radius family parity across paths":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: border-radius family parity across paths")
        val d = "border-radius:5px;border-top-left-radius:8px"
        val a = apply_decls(renderer_default_style(), d, 16)
        val b = apply_decls(renderer_default_style(), _probe_twin(d), 16)
        expect(a.border_radius_tl_px).to_equal(b.border_radius_tl_px)
        expect(a.border_radius_br_px).to_equal(b.border_radius_br_px)

    it "gap / overflow / box-shadow / color / z-index parity across paths":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: gap / overflow / box-shadow / color / z-index parity across paths")
        val d = "gap:7px;overflow:hidden;box-shadow:none;color:#ff0000;z-index:3"
        val a = apply_decls(renderer_default_style(), d, 16)
        val b = apply_decls(renderer_default_style(), _probe_twin(d), 16)
        expect(a.gap_px).to_equal(b.gap_px)
        expect(a.gap_px).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(a.overflow_hidden).to_equal(b.overflow_hidden)
        expect(a.box_shadow_raw).to_equal(b.box_shadow_raw)
        expect(a.fg).to_equal(b.fg)
        expect(a.z_index).to_equal(b.z_index)

    it "absent properties leave style untouched on the dispatch path":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: absent properties leave style untouched on the dispatch path")
        val base = renderer_default_style()
        val a = apply_decls(renderer_default_style(), "width:10px", 16)
        expect(a.width_px).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(a.fg).to_equal(base.fg)
        expect(a.margin_l).to_equal(base.margin_l)
        expect(a.gap_px).to_equal(base.gap_px)
