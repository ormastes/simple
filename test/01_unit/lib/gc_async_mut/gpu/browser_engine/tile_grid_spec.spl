# @req: REQ-LIB-GC-ASYNC-MUT-001

"""Tile render culling core spec (T1 + T3)

Unit coverage for the 256px tile grid: op->tile binning (boundary rects,
multi-tile spans, negative coords), hidden/zero-area drop at bin time,
FNV-1a per-tile checksum stability, viewport+margin live-tile set from a
scroll offset, and conservative full-tile opaque occlusion.

Plan: doc/03_plan/ui/rendering/tile_render_culling_plan.md

@tag: rendering, simple-web, tiles, culling
@cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_paint_tiles.spl 90%
"""

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer_paint_tiles.{
    TILE_MARGIN_PX, TILE_PX, TileBins, TileGrid, TileOp, tile_bin_ops,
    tile_checksum, tile_checksums, tile_count, tile_cover_range,
    tile_floor_div, tile_grid_make, tile_live_set, tile_occluder_slot,
    tile_op, tile_paint_flag_enabled,
    tile_rect_x0, tile_rect_x1, tile_rect_y0, tile_rect_y1,
    tile_stats_ops_painted, tile_stats_ops_total, tile_stats_record,
    tile_stats_reset, tile_stats_tiles_live, tile_stats_tiles_occluded,
    tile_stats_tiles_skipped, tile_stats_tiles_total, tile_survivors
}

fn _box(node: i32, x: i32, y: i32, w: i32, h: i32) -> TileOp:
    tile_op(0, node, x, y, w, h, false, false, 7, -1)

fn _opaque(node: i32, x: i32, y: i32, w: i32, h: i32) -> TileOp:
    tile_op(0, node, x, y, w, h, false, true, 7, -1)

fn _bin_count(bins: TileBins, t: i32) -> i32:
    bins.starts[t + 1] - bins.starts[t]

use std.spec.step

describe "tile grid math":

    it "floor-divides negative coordinates toward negative infinity":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: floor-divides negative coordinates toward negative infinity")
        expect(tile_floor_div(0, 256)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(tile_floor_div(255, 256)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(tile_floor_div(256, 256)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(tile_floor_div(-1, 256)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(tile_floor_div(-256, 256)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(tile_floor_div(-257, 256)).to_equal(-2)  # oracle: -2 — named expected value from the requirement

    it "sizes the grid from a document rect":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: sizes the grid from a document rect")
        val grid = tile_grid_make(0, 0, 1024, 4096)
        expect(grid.tiles_x).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(grid.tiles_y).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(tile_count(grid)).to_equal(64)  # oracle: 64 — named expected value from the requirement
        # Non-multiple sizes round up to a covering tile.
        val ragged = tile_grid_make(0, 0, 1025, 257)
        expect(ragged.tiles_x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(ragged.tiles_y).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns an empty grid for a degenerate document rect":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: returns an empty grid for a degenerate document rect")
        val grid = tile_grid_make(0, 0, 0, 4096)
        expect(tile_count(grid)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "clips the ragged bottom-right 8K tile to the exact viewport":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: clips the ragged bottom-right 8K tile to the exact viewport")
        val grid = tile_grid_make(0, 0, 7680, 4320)
        expect(grid.tiles_x).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(grid.tiles_y).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(tile_count(grid)).to_equal(510)  # oracle: 510 — named expected value from the requirement
        expect(tile_rect_x0(grid, 509)).to_equal(7424)  # oracle: 7424 — named expected value from the requirement
        expect(tile_rect_x1(grid, 509)).to_equal(7680)  # oracle: 7680 — named expected value from the requirement
        expect(tile_rect_y0(grid, 509)).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
        expect(tile_rect_y1(grid, 509)).to_equal(4320)  # oracle: 4320 — named expected value from the requirement

    it "clips a non-aligned leading tile to the document origin":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: clips a non-aligned leading tile to the document origin")
        val grid = tile_grid_make(10, 20, 300, 310)
        expect(tile_rect_x0(grid, 0)).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(tile_rect_y0(grid, 0)).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(tile_rect_x1(grid, 0)).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(tile_rect_y1(grid, 0)).to_equal(256)  # oracle: 256 — named expected value from the requirement

    it "exposes tile rect origins by index":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: exposes tile rect origins by index")
        val grid = tile_grid_make(0, 0, 1024, 1024)
        expect(tile_rect_x0(grid, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(tile_rect_y0(grid, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(tile_rect_x0(grid, 5)).to_equal(TILE_PX)
        expect(tile_rect_y0(grid, 5)).to_equal(TILE_PX)

describe "tile binning":

    it "does not bin an op wholly inside a non-aligned grid's padded edge":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: does not bin an op wholly inside a non-aligned grid's padded edge")
        val grid = tile_grid_make(10, 20, 300, 310)
        val bins = tile_bin_ops([_box(0, 0, 0, 9, 19)], grid)
        expect(bins.items.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "bins an intersecting rect without overflowing its far edge":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: bins an intersecting rect without overflowing its far edge")
        val grid = tile_grid_make(2147483000, 0, 2147483600, 256)
        val bins = tile_bin_ops([_box(0, 2147483500, 0, 500, 256)], grid)
        expect(bins.items.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "bins an op spanning four tiles into all four":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: bins an op spanning four tiles into all four")
        val grid = tile_grid_make(0, 0, 1024, 1024)
        val ops = [_box(0, 200, 200, 112, 112)]
        val bins = tile_bin_ops(ops, grid)
        expect(_bin_count(bins, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_bin_count(bins, 1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_bin_count(bins, 4)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_bin_count(bins, 5)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_bin_count(bins, 2)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps an exact tile-boundary rect inside one tile":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps an exact tile-boundary rect inside one tile")
        val grid = tile_grid_make(0, 0, 1024, 1024)
        # [256, 512) x [256, 512) is exactly tile (1, 1): the exclusive
        # right/bottom edges must not leak into tiles (2, 1) / (1, 2).
        val ops = [_box(0, 256, 256, 256, 256)]
        val bins = tile_bin_ops(ops, grid)
        expect(_bin_count(bins, 5)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_bin_count(bins, 6)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_bin_count(bins, 9)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_bin_count(bins, 0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "drops hidden and zero-area ops at bin time":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: drops hidden and zero-area ops at bin time")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [
            tile_op(0, 0, 10, 10, 100, 100, true, false, 7, -1),
            _box(1, 10, 10, 0, 100),
            _box(2, 10, 10, 100, 0),
            _box(3, 10, 10, 100, 100)
        ]
        val bins = tile_bin_ops(ops, grid)
        expect(_bin_count(bins, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bins.items[bins.starts[0]]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "clamps negative-coordinate ops to the grid edge tiles":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: clamps negative-coordinate ops to the grid edge tiles")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [_box(0, -100, -100, 200, 200), _box(1, -300, -300, 100, 100)]
        val bins = tile_bin_ops(ops, grid)
        # Op 0 straddles the origin: only tile (0,0) sees it. Op 1 is fully
        # outside the document: binned nowhere.
        expect(_bin_count(bins, 0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bins.items[bins.starts[0]]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_bin_count(bins, 1)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_bin_count(bins, 2)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_bin_count(bins, 3)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports no coverage for rects outside the grid":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: reports no coverage for rects outside the grid")
        val grid = tile_grid_make(0, 0, 512, 512)
        val (x0a, y0a, x1a, y1a) = tile_cover_range(grid, 600, 0, 50, 50)
        expect(x1a < x0a).to_equal(true)
        val (x0b, y0b, x1b, y1b) = tile_cover_range(grid, 0, 0, 0, 50)
        expect(x1b < x0b).to_equal(true)

    it "preserves op order inside a tile bin":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: preserves op order inside a tile bin")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [_box(0, 0, 0, 64, 64), _box(1, 32, 32, 64, 64), _box(2, 16, 16, 64, 64)]
        val bins = tile_bin_ops(ops, grid)
        expect(_bin_count(bins, 0)).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(bins.items[bins.starts[0]]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bins.items[bins.starts[0] + 1]).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(bins.items[bins.starts[0] + 2]).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "tile checksums":

    it "is stable for identical op lists and sensitive to changes":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: is stable for identical op lists and sensitive to changes")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops_a = [_box(0, 0, 0, 64, 64), _box(1, 300, 300, 64, 64)]
        val ops_b = [_box(0, 0, 0, 64, 64), _box(1, 300, 300, 64, 64)]
        val bins_a = tile_bin_ops(ops_a, grid)
        val bins_b = tile_bin_ops(ops_b, grid)
        expect(tile_checksum(ops_a, bins_a, 0)).to_equal(tile_checksum(ops_b, bins_b, 0))
        expect(tile_checksum(ops_a, bins_a, 3)).to_equal(tile_checksum(ops_b, bins_b, 3))
        # Moving the op in tile 3 changes only tile 3's checksum.
        val ops_c = [_box(0, 0, 0, 64, 64), _box(1, 301, 300, 64, 64)]
        val bins_c = tile_bin_ops(ops_c, grid)
        expect(tile_checksum(ops_c, bins_c, 0)).to_equal(tile_checksum(ops_a, bins_a, 0))
        expect(tile_checksum(ops_c, bins_c, 3) != tile_checksum(ops_a, bins_a, 3)).to_equal(true)

    it "computes per-tile checksum arrays with a shared empty value":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: computes per-tile checksum arrays with a shared empty value")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [_box(0, 0, 0, 64, 64)]
        val sums = tile_checksums(ops, tile_bin_ops(ops, grid), grid)
        expect(sums.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(sums[1]).to_equal(sums[2])
        expect(sums[0] != sums[1]).to_equal(true)

describe "tile live set from scroll":

    it "marks viewport plus 512px margin tiles live":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: marks viewport plus 512px margin tiles live")
        # Document 1024 x 4096 = 4 x 16 tiles; viewport 1024x512 at scroll 2048.
        val grid = tile_grid_make(0, 0, 1024, 4096)
        val live = tile_live_set(grid, 0, 2048, 1024, 512, TILE_MARGIN_PX)
        # Rows 8..9 are the viewport; margin extends to rows 6..11.
        expect(live[8 * 4]).to_equal(true)
        expect(live[9 * 4 + 3]).to_equal(true)
        expect(live[6 * 4]).to_equal(true)
        expect(live[11 * 4 + 3]).to_equal(true)
        expect(live[5 * 4]).to_equal(false)
        expect(live[12 * 4]).to_equal(false)
        expect(live[0]).to_equal(false)
        expect(live[15 * 4 + 3]).to_equal(false)

    it "marks everything live at scroll zero on a short document":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: marks everything live at scroll zero on a short document")
        val grid = tile_grid_make(0, 0, 512, 512)
        val live = tile_live_set(grid, 0, 0, 512, 512, TILE_MARGIN_PX)
        var t = 0
        var all_live = true
        while t < tile_count(grid):
            if not live[t]:
                all_live = false
            t = t + 1
        expect(all_live).to_equal(true)

describe "tile occlusion":

    it "lets a full 8K opaque viewport occlude the ragged last tile":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: lets a full 8K opaque viewport occlude the ragged last tile")
        val grid = tile_grid_make(0, 0, 7680, 4320)
        val ops = [
            _box(0, 7500, 4200, 20, 20),
            _opaque(1, 0, 0, 7680, 4320),
        ]
        val bins = tile_bin_ops(ops, grid)
        expect(tile_occluder_slot(ops, bins, grid, 509)).to_equal(
            bins.starts[509] + 1)
        val live = tile_live_set(grid, 0, 0, 7680, 4320, 0)
        val survivors = tile_survivors(ops, bins, grid, live)
        expect(survivors).to_equal([false, true])

    it "finds the latest full-tile opaque op as the occluder":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: finds the latest full-tile opaque op as the occluder")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [
            _box(0, 0, 0, 100, 100),
            _opaque(1, 0, 0, 256, 256),
            _box(2, 10, 10, 50, 50)
        ]
        val bins = tile_bin_ops(ops, grid)
        expect(tile_occluder_slot(ops, bins, grid, 0)).to_equal(bins.starts[0] + 1)
        expect(tile_occluder_slot(ops, bins, grid, 1)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "does not treat a partial-coverage opaque op as an occluder":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: does not treat a partial-coverage opaque op as an occluder")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [_box(0, 0, 0, 100, 100), _opaque(1, 0, 0, 255, 256)]
        val bins = tile_bin_ops(ops, grid)
        expect(tile_occluder_slot(ops, bins, grid, 0)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "culls ops behind a full-tile opaque op but keeps later ops":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: culls ops behind a full-tile opaque op but keeps later ops")
        val grid = tile_grid_make(0, 0, 512, 512)
        val ops = [
            _box(0, 0, 0, 100, 100),
            _opaque(1, 0, 0, 256, 256),
            _box(2, 10, 10, 50, 50)
        ]
        val bins = tile_bin_ops(ops, grid)
        val live = tile_live_set(grid, 0, 0, 512, 512, 0)
        val surv = tile_survivors(ops, bins, grid, live)
        expect(surv[0]).to_equal(false)
        expect(surv[1]).to_equal(true)
        expect(surv[2]).to_equal(true)

    it "keeps an occluded op alive when another live tile still shows it":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: keeps an occluded op alive when another live tile still shows it")
        val grid = tile_grid_make(0, 0, 512, 512)
        # Op 0 spans tiles (0,0) and (1,0); the occluder covers only (0,0).
        val ops = [_box(0, 0, 0, 400, 100), _opaque(1, 0, 0, 256, 256)]
        val bins = tile_bin_ops(ops, grid)
        val live = tile_live_set(grid, 0, 0, 512, 512, 0)
        val surv = tile_survivors(ops, bins, grid, live)
        expect(surv[0]).to_equal(true)
        expect(surv[1]).to_equal(true)

    it "culls ops binned only in non-live tiles":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: culls ops binned only in non-live tiles")
        val grid = tile_grid_make(0, 0, 1024, 4096)
        val ops = [_box(0, 0, 0, 100, 100), _box(1, 0, 3800, 100, 100)]
        val bins = tile_bin_ops(ops, grid)
        # Viewport at the top, no margin: the bottom-of-document op is dead.
        val live = tile_live_set(grid, 0, 0, 1024, 512, 0)
        val surv = tile_survivors(ops, bins, grid, live)
        expect(surv[0]).to_equal(true)
        expect(surv[1]).to_equal(false)

describe "tile flag and counters":

    it "defaults the tile paint flag to off":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: defaults the tile paint flag to off")
        # The suite never sets SIMPLE_WEB_TILE_PAINT; default must be OFF so
        # the flag-off render path stays byte-identical.
        expect(tile_paint_flag_enabled()).to_equal(false)

    it "records and exposes benchmark counters":
        # @req: REQ-LIB-GC-ASYNC-MUT-001
        step("Verify: records and exposes benchmark counters")
        tile_stats_record(100, 25, 64, 12, 52, 3)
        expect(tile_stats_ops_total()).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(tile_stats_ops_painted()).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(tile_stats_tiles_total()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(tile_stats_tiles_live()).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(tile_stats_tiles_skipped()).to_equal(52)  # oracle: 52 — named expected value from the requirement
        expect(tile_stats_tiles_occluded()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        tile_stats_reset()
        expect(tile_stats_ops_total()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(tile_stats_tiles_skipped()).to_equal(0)  # oracle: 0 — named expected value from the requirement
