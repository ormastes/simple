# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-BROWSER_ENGINE
# @cover src/lib/gc_async_mut/gpu/browser_engine/simple_web_html_layout_renderer_core_selectors.spl 1%
# @tag: unit, browser_engine, css, selectors, chrome159
#
# Selector matching through the full layout renderer, one selector per page:
# every element is `display:block; width:10px`, and the selector under test
# sets `width:77px`, so the laid-out width of `#t` says whether it matched.
# This drives the pre-parsed selector path (`parse_selector_part`, attribute
# operators with the `i`/`s` flags, structural and logical pseudo-classes,
# `:has`, combinators, compound tag/id/class parts).
#
# Oracle: Chrome 159.0.8154.6 headless shell, the same page (base sheet
# `body{margin:0} section,div,p,span,b,i,h1{display:block;width:10px;
# height:4px;margin:0;padding:0;border:0}` plus `<selector>{width:77px}`),
# `document.getElementById("t").getBoundingClientRect().width`, 900x2000,
# run 2026-11-15. Every row is the Chrome value; widths are whole pixels and
# independent of fonts.
#
# Rows where this renderer disagrees with Chrome are filed, not asserted:
# doc/08_tracking/bug/web_selector_attr_colon_empty_operand_universal_compound_2026-11-15.md
# (`div[data-v^="http:"]`, `[data-v^=""]`, `*.a`).

use std.spec.{describe, it, expect}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{simple_web_layout_debug_layout_by_id}

fn _w(sel: text, body: text) -> text:
    simple_web_layout_debug_layout_by_id("<html><head><style>body{{margin:0}} section,div,p,span,b,i,h1{{display:block;width:10px;height:4px;margin:0;padding:0;border:0}} " + sel + "{{width:77px}}</style></head><body>" + body + "</body></html>", 900, 2000, "t", "w")

describe "Attribute selectors":

    it "matches: [data-x] (attr_presence_valueless)":
        expect(_w("[data-x]", "<div id=\"t\" data-x></div>")).to_equal("77")

    it "matches: [data-x] (attr_presence_empty)":
        expect(_w("[data-x]", "<div id=\"t\" data-x=\"\"></div>")).to_equal("77")

    it "does not match: [data-x] (attr_presence_absent)":
        expect(_w("[data-x]", "<div id=\"t\" data-y=\"1\"></div>")).to_equal("10")

    it "matches: [data-v='abc'] (attr_exact)":
        expect(_w("[data-v=\"abc\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "does not match: [data-v='abc'] (attr_exact_miss)":
        expect(_w("[data-v=\"abc\"]", "<div id=\"t\" data-v=\"abcd\"></div>")).to_equal("10")

    it "matches: [data-v='AbC' i] (attr_exact_ci)":
        expect(_w("[data-v=\"AbC\" i]", "<div id=\"t\" data-v=\"aBc\"></div>")).to_equal("77")

    it "does not match: [data-v='AbC' s] (attr_exact_cs_flag)":
        expect(_w("[data-v=\"AbC\" s]", "<div id=\"t\" data-v=\"aBc\"></div>")).to_equal("10")

    it "matches: [data-v^='ab'] (attr_prefix)":
        expect(_w("[data-v^=\"ab\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "does not match: [data-v^='bc'] (attr_prefix_miss)":
        expect(_w("[data-v^=\"bc\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("10")

    it "matches: [data-v^='AB' i] (attr_prefix_ci)":
        expect(_w("[data-v^=\"AB\" i]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "matches: [data-v$='bc'] (attr_suffix)":
        expect(_w("[data-v$=\"bc\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "matches: [data-v$='BC' i] (attr_suffix_ci)":
        expect(_w("[data-v$=\"BC\" i]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "matches: [data-v*='b'] (attr_substr)":
        expect(_w("[data-v*=\"b\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "matches: [data-v*='B' i] (attr_substr_ci)":
        expect(_w("[data-v*=\"B\" i]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("77")

    it "does not match: [data-v*='z'] (attr_substr_miss)":
        expect(_w("[data-v*=\"z\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("10")

    it "matches: [data-v~='b'] (attr_token)":
        expect(_w("[data-v~=\"b\"]", "<div id=\"t\" data-v=\"a b c\"></div>")).to_equal("77")

    it "does not match: [data-v~='b'] (attr_token_miss)":
        expect(_w("[data-v~=\"b\"]", "<div id=\"t\" data-v=\"abc\"></div>")).to_equal("10")

    it "matches: [data-v~='B' i] (attr_token_ci)":
        expect(_w("[data-v~=\"B\" i]", "<div id=\"t\" data-v=\"a b\"></div>")).to_equal("77")

    it "does not match: [data-v~=''] (attr_token_empty)":
        expect(_w("[data-v~=\"\"]", "<div id=\"t\" data-v=\"a b\"></div>")).to_equal("10")

    it "matches: [lang|='en'] (attr_dash)":
        expect(_w("[lang|=\"en\"]", "<div id=\"t\" lang=\"en-US\"></div>")).to_equal("77")

    it "matches: [lang|='en'] (attr_dash_exact)":
        expect(_w("[lang|=\"en\"]", "<div id=\"t\" lang=\"en\"></div>")).to_equal("77")

    it "does not match: [lang|='en'] (attr_dash_miss)":
        expect(_w("[lang|=\"en\"]", "<div id=\"t\" lang=\"english\"></div>")).to_equal("10")

    it "matches: [lang|='EN' i] (attr_dash_ci)":
        expect(_w("[lang|=\"EN\" i]", "<div id=\"t\" lang=\"en-gb\"></div>")).to_equal("77")

    it "matches: div[data-a='1'][data-b='2'] (attr_two_groups)":
        expect(_w("div[data-a=\"1\"][data-b=\"2\"]", "<div id=\"t\" data-a=\"1\" data-b=\"2\"></div>")).to_equal("77")

    it "does not match: div[data-a='1'][data-b='3'] (attr_two_groups_miss)":
        expect(_w("div[data-a=\"1\"][data-b=\"3\"]", "<div id=\"t\" data-a=\"1\" data-b=\"2\"></div>")).to_equal("10")

describe "Structural pseudo-classes":

    it "matches: section > div:first-child (first_child)":
        expect(_w("section > div:first-child", "<section><div id=\"t\"></div><div></div></section>")).to_equal("77")

    it "does not match: section > div:first-child (first_child_miss)":
        expect(_w("section > div:first-child", "<section><div></div><div id=\"t\"></div></section>")).to_equal("10")

    it "matches: section > div:last-child (last_child)":
        expect(_w("section > div:last-child", "<section><div></div><div id=\"t\"></div></section>")).to_equal("77")

    it "matches: section > div:only-child (only_child)":
        expect(_w("section > div:only-child", "<section><div id=\"t\"></div></section>")).to_equal("77")

    it "does not match: section > div:only-child (only_child_miss)":
        expect(_w("section > div:only-child", "<section><div id=\"t\"></div><div></div></section>")).to_equal("10")

    it "matches: section > div:nth-child(2n+1) (nth_child_odd)":
        expect(_w("section > div:nth-child(2n+1)", "<section><div></div><div></div><div id=\"t\"></div></section>")).to_equal("77")

    it "does not match: section > div:nth-child(even) (nth_child_even_miss)":
        expect(_w("section > div:nth-child(even)", "<section><div></div><div></div><div id=\"t\"></div></section>")).to_equal("10")

    it "matches: section > div:nth-last-child(2) (nth_last_child)":
        expect(_w("section > div:nth-last-child(2)", "<section><div></div><div id=\"t\"></div><div></div></section>")).to_equal("77")

    it "matches: section > div:nth-of-type(2) (nth_of_type)":
        expect(_w("section > div:nth-of-type(2)", "<section><p></p><div></div><p></p><div id=\"t\"></div></section>")).to_equal("77")

    it "matches: section > p:nth-last-of-type(1) (nth_last_of_type)":
        expect(_w("section > p:nth-last-of-type(1)", "<section><p></p><div></div><p id=\"t\"></p><div></div></section>")).to_equal("77")

    it "does not match: section > div:nth-child(foo) (nth_invalid)":
        expect(_w("section > div:nth-child(foo)", "<section><div id=\"t\"></div></section>")).to_equal("10")

    it "matches: div:empty (empty_match)":
        expect(_w("div:empty", "<div id=\"t\"></div>")).to_equal("77")

    it "does not match: div:empty (empty_miss)":
        expect(_w("div:empty", "<div id=\"t\">x</div>")).to_equal("10")

describe "Logical, state and unsupported pseudo-classes":

    it "matches: div:not(.a) (not_class)":
        expect(_w("div:not(.a)", "<div id=\"t\" class=\"b\"></div>")).to_equal("77")

    it "does not match: div:not(.a) (not_class_miss)":
        expect(_w("div:not(.a)", "<div id=\"t\" class=\"a\"></div>")).to_equal("10")

    it "matches: div:is(.a, .b) (is_list)":
        expect(_w("div:is(.a, .b)", "<div id=\"t\" class=\"b\"></div>")).to_equal("77")

    it "matches: body > :where(#t) (where_list)":
        expect(_w("body > :where(#t)", "<div id=\"t\"></div>")).to_equal("77")

    it "matches: section:has(> b) (has_child)":
        expect(_w("section:has(> b)", "<section id=\"t\"><b></b></section>")).to_equal("77")

    it "does not match: section:has(> b) (has_child_miss)":
        expect(_w("section:has(> b)", "<section id=\"t\"><i></i></section>")).to_equal("10")

    it "matches: input:checked + span (checked_sibling)":
        expect(_w("input:checked + span", "<input type=\"checkbox\" checked><span id=\"t\"></span>")).to_equal("77")

    it "does not match: input:checked + span (checked_sibling_miss)":
        expect(_w("input:checked + span", "<input type=\"checkbox\"><span id=\"t\"></span>")).to_equal("10")

    it "does not match: div:hover (hover_never)":
        expect(_w("div:hover", "<div id=\"t\"></div>")).to_equal("10")

    it "does not match: div::before (pseudo_element_dead)":
        expect(_w("div::before", "<div id=\"t\"></div>")).to_equal("10")

    it "does not match: div:bogus (unknown_pseudo)":
        expect(_w("div:bogus", "<div id=\"t\"></div>")).to_equal("10")

    it "matches: :root > body > #t (root_html)":
        expect(_w(":root > body > #t", "<div id=\"t\"></div>")).to_equal("77")

describe "Combinators and compound parts":

    it "matches: section > b (child_comb)":
        expect(_w("section > b", "<section><b id=\"t\"></b></section>")).to_equal("77")

    it "does not match: section > b (child_comb_miss)":
        expect(_w("section > b", "<section><div><b id=\"t\"></b></div></section>")).to_equal("10")

    it "matches: section b (descendant)":
        expect(_w("section b", "<section><div><b id=\"t\"></b></div></section>")).to_equal("77")

    it "matches: h1 + p (adjacent)":
        expect(_w("h1 + p", "<h1></h1><p id=\"t\"></p>")).to_equal("77")

    it "does not match: h1 + p (adjacent_miss)":
        expect(_w("h1 + p", "<h1></h1><div></div><p id=\"t\"></p>")).to_equal("10")

    it "matches: h1 ~ p (general_sibling)":
        expect(_w("h1 ~ p", "<h1></h1><div></div><p id=\"t\"></p>")).to_equal("77")

    it "matches: div#t.a.b (tag_id_class)":
        expect(_w("div#t.a.b", "<div id=\"t\" class=\"a b\"></div>")).to_equal("77")

    it "does not match: #t.c (id_class_miss)":
        expect(_w("#t.c", "<div id=\"t\" class=\"a b\"></div>")).to_equal("10")
