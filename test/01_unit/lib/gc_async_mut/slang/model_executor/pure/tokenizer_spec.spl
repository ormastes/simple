# slang pure backend — tokenizer specs.
# Inline: a hand-made BPE vocab in the tokenizer.json line layout.
# Reference: ids from llama-tokenize (llama.cpp, GGUF of the same model),
# gated on the stories15M model directory existing under SLANG_MODEL_ROOT
# (default C:/dev/model).

use std.gc_async_mut.slang.model_executor.pure.tokenizer.{pure_tokenizer_from_json, pure_tokenizer_load, pure_tokenizer_encode, pure_tokenizer_decode}
use std.spec.{skip}
use std.io_runtime.{is_dir, env_get}

fn model_dir() -> text:
    val root = env_get("SLANG_MODEL_ROOT") ?? ""
    if root == "":
        return "C:/dev/model/llama2c-stories15M"
    root + "/llama2c-stories15M"

fn tiny_json() -> text:
    var s = "\{\n  \"model\": \{\n    \"type\": \"BPE\",\n    \"vocab\": \{\n"
    s = s + "      \"<unk>\": 0,\n      \"<s>\": 1,\n      \"</s>\": 2,\n"
    s = s + "      \"<0x0A>\": 3,\n      \"▁\": 4,\n      \"a\": 5,\n      \"b\": 6,\n      \"▁a\": 7,\n      \"ab\": 8,\n      \"▁ab\": 9,\n      \"\\\\\": 10\n"
    s = s + "    \},\n    \"merges\": [\n      \"▁ a\",\n      \"a b\",\n      \"▁a b\"\n    ]\n  \}\n\}\n"
    s

describe "pure tokenizer — inline vocab":
    it "applies merges by rank and prepends BOS":
        val tok = pure_tokenizer_from_json(tiny_json()).unwrap()
        expect(pure_tokenizer_encode(tok, "ab", true)).to_equal([1, 9])
        expect(pure_tokenizer_encode(tok, "ab", false)).to_equal([9])

    it "turns spaces into the word marker and falls back to byte tokens":
        val tok = pure_tokenizer_from_json(tiny_json()).unwrap()
        expect(pure_tokenizer_encode(tok, "a b", true)).to_equal([1, 7, 4, 6])
        expect(pure_tokenizer_encode(tok, "a\nb", false)).to_equal([7, 3, 6])

    it "decodes pieces, markers and byte tokens":
        val tok = pure_tokenizer_from_json(tiny_json()).unwrap()
        expect(pure_tokenizer_decode(tok, [1, 7, 4, 6])).to_equal(" a b")
        expect(pure_tokenizer_decode(tok, [7, 3, 6])).to_equal(" a\nb")

    it "unescapes a backslash vocab entry":
        val tok = pure_tokenizer_from_json(tiny_json()).unwrap()
        expect(pure_tokenizer_decode(tok, [10])).to_equal("\\")

    it "rejects a document without vocab and merges":
        expect(pure_tokenizer_from_json("\{\}").is_err()).to_equal(true)

describe "pure tokenizer — stories15M vs llama-tokenize":
    it "matches the reference ids for three prompts":
        val dir = model_dir()
        if not is_dir(dir):
            # skip() inside an it body is counted as a pass by the runner
            # (doc/08_tracking/bug/spec_skip_reported_as_pass_2026-11-19.md), so leave
            # evidence that nothing was checked.
            print "SKIPPED: tokenizer reference ids -- stories15M not under " + dir
            skip("matches the reference ids for three prompts", "stories15M model directory not present")
        else:
            val tok = pure_tokenizer_load(dir).unwrap()
            expect(pure_tokenizer_encode(tok, "Once upon a time", true)).to_equal([1, 9038, 2501, 263, 931])
            expect(pure_tokenizer_encode(tok, "Hello, world!", true)).to_equal([1, 15043, 29892, 3186, 29991])
            expect(pure_tokenizer_encode(tok, "The cat sat on the mat.\nIt was é fun.", true)).to_equal([1, 450, 6635, 3290, 373, 278, 1775, 29889, 13, 3112, 471, 904, 2090, 29889])
            expect(pure_tokenizer_decode(tok, [29892, 727, 471, 263, 2217])).to_equal(", there was a little")
