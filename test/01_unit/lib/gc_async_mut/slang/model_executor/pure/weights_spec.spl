# slang pure backend — weights loader specs
#
# Fixture: a tiny safetensors buffer built inline with golden IEEE-754 bytes.
#   - "a" : F32  shape [2]   = [1.0 (00 00 80 3F), -2.5 (00 00 20 C0)]
#   - "b" : BF16 shape [3]   = [1.0 (80 3F), -2.0 (00 C0), 0.15625 (20 3E)]

use std.gc_async_mut.slang.model_executor.pure.weights.{pure_weights_from_bytes, pure_weights_find, pure_weights_count}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops.{tensor_numel, tensor_value_at, tensor_shape}
use std.common.base_encoding.{base_encoding_facade_text_to_bytes as text_to_bytes}

fn push_ascii(buf: [u8], s: text) -> [u8]:
    val bytes = text_to_bytes(s)
    var i = 0
    while i < bytes.len():
        buf.push(bytes[i])
        i = i + 1
    buf

fn push_u64_le(buf: [u8], v: i64) -> [u8]:
    var remaining = v
    var i = 0
    while i < 8:
        buf.push((remaining % 256) as u8)
        remaining = remaining / 256
        i = i + 1
    buf

fn push_list(buf: [u8], xs: [i64]) -> [u8]:
    for x in xs:
        buf.push(x as u8)
    buf

fn build_fixture(header_json: text, payload: [i64]) -> [u8]:
    var buf: [u8] = []
    buf = push_u64_le(buf, header_json.len() as i64)
    buf = push_ascii(buf, header_json)
    buf = push_list(buf, payload)
    buf

fn golden() -> [u8]:
    val j = "{\"a\":{\"dtype\":\"F32\",\"shape\":[2],\"data_offsets\":[0,8]},\"b\":{\"dtype\":\"BF16\",\"shape\":[3],\"data_offsets\":[8,14]}}"
    build_fixture(j, [0, 0, 128, 63, 0, 0, 32, 192, 128, 63, 0, 192, 32, 62])

describe "pure weights — golden decode":
    it "loads both tensors":
        val w = pure_weights_from_bytes(golden()).unwrap()
        expect(pure_weights_count(w)).to_equal(2)

    it "decodes F32 little-endian golden bytes":
        val w = pure_weights_from_bytes(golden()).unwrap()
        val a = pure_weights_find(w, "a").unwrap()
        expect(tensor_numel(a)).to_equal(2)
        expect(tensor_value_at(a, 0)).to_equal(1.0)
        expect(tensor_value_at(a, 1)).to_equal(-2.5)

    it "decodes BF16 golden bytes as the high half of an F32":
        val w = pure_weights_from_bytes(golden()).unwrap()
        val b = pure_weights_find(w, "b").unwrap()
        expect(tensor_shape(b)[0]).to_equal(3)
        expect(tensor_value_at(b, 0)).to_equal(1.0)
        expect(tensor_value_at(b, 1)).to_equal(-2.0)
        expect(tensor_value_at(b, 2)).to_equal(0.15625)

    it "returns None for an absent tensor name":
        val w = pure_weights_from_bytes(golden()).unwrap()
        expect(pure_weights_find(w, "missing").is_none()).to_equal(true)

describe "pure weights — error paths":
    it "rejects a byte length that does not match the shape":
        val j = "{\"a\":{\"dtype\":\"F32\",\"shape\":[3],\"data_offsets\":[0,8]}}"
        val r = pure_weights_from_bytes(build_fixture(j, [0, 0, 128, 63, 0, 0, 32, 192]))
        expect(r.is_err()).to_equal(true)

    it "rejects an unsupported dtype":
        val j = "{\"a\":{\"dtype\":\"I32\",\"shape\":[1],\"data_offsets\":[0,4]}}"
        val r = pure_weights_from_bytes(build_fixture(j, [1, 0, 0, 0]))
        expect(r.is_err()).to_equal(true)

    it "rejects a truncated buffer":
        val r = pure_weights_from_bytes(push_list([], [1, 2, 3]))
        expect(r.is_err()).to_equal(true)
