# slang pure backend — pure parts of the Vulkan ops provider (no GPU needed):
# the SPIR-V emitter and the generated kernels. Nothing here loads the Vulkan
# loader.

use std.gc_async_mut.gpu.vulkan.spirv_compute.{spv_module_new, spv_inst, spv_string_words, SPV_BUILTIN_GLOBAL_INVOCATION_ID}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops_vulkan_kernels.{vk_spv_matvec, vk_spv_rmsnorm, vk_spv_add, vk_spv_mul, vk_spv_silu, vk_spv_attention, vk_spv_rope, vk_spv_kv_write, vk_spv_row, vk_spv_argmax}
use std.gc_async_mut.gpu.vulkan.vk_compute.{vk_loader_name}

fn word(b: [u8], i: i64) -> i64:
    (b[i * 4] as i64) + (b[i * 4 + 1] as i64) * 256 + (b[i * 4 + 2] as i64) * 65536 + (b[i * 4 + 3] as i64) * 16777216

describe "SPIR-V emitter":
    it "encodes an instruction header as word count and opcode":
        expect(spv_inst(17, [1])).to_equal([131089, 1])

    it "pads strings to whole NUL-terminated words":
        expect(spv_string_words("main").len()).to_equal(2)
        expect(spv_string_words("abc").len()).to_equal(1)
        expect(spv_string_words("GLSL.std.450").len()).to_equal(4)

    it "emits a module with the SPIR-V magic, version 1.3 and a sane id bound":
        val m = spv_module_new()
        val out = m.ssbo()
        m.push_block([0])
        val gi = m.builtin_uvec3(SPV_BUILTIN_GLOBAL_INVOCATION_ID)
        m.begin_main()
        val gid = m.builtin_x(gi)
        val guard = m.if_begin(m.ult(gid, m.pc(0)))
        m.store(m.buf_ptr(out, gid), m.cf(1.0))
        m.if_end(guard)
        val bytes = m.finish(64)
        expect(bytes.len() % 4).to_equal(0)
        expect(word(bytes, 0)).to_equal(119734787)
        expect(word(bytes, 1)).to_equal(66304)
        expect(word(bytes, 3) > 10).to_equal(true)
        expect(word(bytes, 3) < bytes.len() / 4).to_equal(true)

describe "Vulkan kernels":
    it "generates every kernel as non-empty SPIR-V words":
        val all = [vk_spv_matvec(), vk_spv_rmsnorm(), vk_spv_add(), vk_spv_mul(), vk_spv_silu(), vk_spv_attention(), vk_spv_rope(), vk_spv_kv_write(), vk_spv_row(), vk_spv_argmax()]
        for k in all:
            expect(k.len() > 100).to_equal(true)
            expect(k.len() % 4).to_equal(0)
            expect(word(k, 0)).to_equal(119734787)

    it "generates deterministically":
        expect(vk_spv_matvec()).to_equal(vk_spv_matvec())

    it "differs between add and mul":
        expect(vk_spv_add() == vk_spv_mul()).to_equal(false)

describe "Vulkan loader name per host OS":
    it "uses the platform loader, MoltenVK on macOS":
        expect(vk_loader_name("windows")).to_equal("vulkan-1.dll")
        expect(vk_loader_name("linux")).to_equal("libvulkan.so.1")
        expect(vk_loader_name("macos")).to_equal("libvulkan.1.dylib")
