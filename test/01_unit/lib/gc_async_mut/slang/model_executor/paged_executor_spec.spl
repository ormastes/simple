"""
## Purpose and audience
Proves the physical paged executor's fail-closed lifecycle when no compatible
provider has been activated. Provider-backed generation parity is exercised by
the native real-provider smoke fixture.
"""

# Requirements: doc/02_requirements/feature/slang_paged_kv_backend.md
# @req: REQ-015

use std.spec.step
use std.gc_async_mut.slang.model_executor.paged_executor.{PagedExecutorError, paged_executor_active, paged_executor_generate, paged_executor_shutdown}

describe "Slang physical paged executor lifecycle":
    it "rejects generation before activation and permits idle shutdown":
        step("observe the inactive physical owner")
        expect(paged_executor_active()).to_equal(false)
        expect(paged_executor_generate("hello", 1).unwrap_err()).to_equal(
            PagedExecutorError.ProviderUnavailable)

        step("shut down an already inactive owner")
        expect(paged_executor_shutdown().is_ok()).to_equal(true)
