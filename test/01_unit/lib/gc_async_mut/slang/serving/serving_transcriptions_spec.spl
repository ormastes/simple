# @cover src/lib/gc_async_mut/slang/entrypoints/openai/serving/serving_transcriptions.spl 80%
"""
## Purpose and audience
Purpose: pin the request validation, the wrong-model-kind refusal and the
Qwen3-ASR prefix stripping of /v1/audio/transcriptions. Audience: engineers
changing slang's audio-to-text path.

## Operator workflow
I POST {model, file_b64, format}. A model that cannot hear audio must be
refused with 400 wrong_model_kind; a transcript must never be invented.

## Compatibility and limitations
No model is loaded here (fixture directories only); the live transcription of
a real recording is in test/03_system/lib/slang/feature/slang_asr_live_spec.spl.
"""

use std.spec.step
use std.spec.{describe, it, expect}

use std.gc_async_mut.slang.entrypoints.openai.protocol.{json_string_field}
use std.gc_async_mut.slang.entrypoints.openai.serving.serving_transcriptions.{serve_transcriptions, strip_asr_prefix, transcription_response}
use std.gc_async_mut.slang.engine.llm_engine.{engine_set_lib_path}
use std.io_runtime.{dir_create_all, file_write, dir_remove_all}

fn _root() -> text:
    val root = "build/test/slang_asr/gguf"
    dir_remove_all(root)
    dir_create_all(root + "/tiny-gguf")
    file_write(root + "/tiny-gguf/model.gguf", "GGUF not a loadable model, only the magic")
    engine_set_lib_path("build/test/slang_asr/no-such-backend.dll")
    root

fn _body(model: text, b64: text) -> text:
    "{\"model\":\"" + model + "\",\"file_b64\":\"" + b64 + "\",\"format\":\"wav\"}"

describe "Qwen3-ASR answer prefix":
    it "keeps only the transcript after the asr_text tag":
        expect(strip_asr_prefix("language English<asr_text>The capital of France is Paris.")).to_equal("The capital of France is Paris.")
    it "returns an empty transcript for silence":
        expect(strip_asr_prefix("language None<asr_text>")).to_equal("")
    it "passes an untagged answer through trimmed":
        expect(strip_asr_prefix("  hello  ")).to_equal("hello")

describe "transcription envelope":
    it "escapes quotes in the transcript":
        val response = transcription_response("say \"hi\"")
        expect(response.status).to_equal(200)
        expect(json_string_field(response.body, "text")).to_equal("say \"hi\"")

describe "transcription request validation":
    it "requires a model":
        val response = serve_transcriptions(_root(), "{\"file_b64\":\"AAAA\"}")
        expect(response.status).to_equal(400)
        expect(json_string_field(response.body, "code")).to_equal("invalid_request")
    it "requires the audio":
        val response = serve_transcriptions(_root(), "{\"model\":\"tiny-gguf\"}")
        expect(response.status).to_equal(400)
        expect(json_string_field(response.body, "code")).to_equal("invalid_request")
    it "refuses non-base64 audio":
        val response = serve_transcriptions(_root(), _body("tiny-gguf", "not base64!"))
        expect(response.status).to_equal(400)
        expect(json_string_field(response.body, "code")).to_equal("invalid_media")
    it "refuses a response format it cannot serve":
        val response = serve_transcriptions(_root(), "{\"model\":\"tiny-gguf\",\"file_b64\":\"AAAA\",\"response_format\":\"srt\"}")
        expect(response.status).to_equal(400)
    it "answers 404 for an unknown model":
        val response = serve_transcriptions(_root(), _body("nope", "AAAA"))
        expect(response.status).to_equal(404)
        expect(json_string_field(response.body, "code")).to_equal("model_not_found")
    it "refuses a text-only model as the wrong kind":
        step("A GGUF with no audio projector is not an ASR model")
        val response = serve_transcriptions(_root(), _body("tiny-gguf", "AAAA"))
        expect(response.status).to_equal(400)
        expect(json_string_field(response.body, "code")).to_equal("wrong_model_kind")
