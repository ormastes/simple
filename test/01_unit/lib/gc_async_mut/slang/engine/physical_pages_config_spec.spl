"""
## Purpose and audience
Proves that physical paged execution remains explicit opt-in configuration and
rejects invalid resource bounds before a model/backend is opened.
"""

# Requirements: doc/02_requirements/feature/slang_paged_kv_backend.md
# @req: REQ-001
# @req: REQ-007
# @req: REQ-015

use std.spec.step
use std.gc_async_mut.slang.engine.llm_engine.{engine_set_physical_pages_config, engine_unload}

fn physical_pages(enabled: text, page_tokens: text, page_capacity: text,
                  prefix_capacity: text, byte_limit: text) -> bool:
    engine_set_physical_pages_config(enabled + "|" + page_tokens + "|" +
        page_capacity + "|" + prefix_capacity + "|" + byte_limit)

describe "Slang physical-page engine configuration":
    it "validates bounds while preserving an explicit disable path":
        step("reject invalid enabled geometry")
        expect(physical_pages("true", "0", "128", "4", "2147483648")).to_equal(false)
        expect(physical_pages("true", "256", "0", "4", "2147483648")).to_equal(false)
        expect(physical_pages("true", "256", "128", "0", "2147483648")).to_equal(false)
        expect(physical_pages("true", "256", "128", "4", "0")).to_equal(false)
        expect(physical_pages("true", "bad", "128", "4", "2147483648")).to_equal(false)
        expect(physical_pages("true", "-256", "128", "4", "2147483648")).to_equal(false)
        expect(physical_pages("true", "+256", "128", "4", "2147483648")).to_equal(false)

        step("accept bounded opt-in and restore the default disabled mode")
        expect(physical_pages("true", "256", "128", "4", "2147483648")).to_equal(true)
        expect(physical_pages("false", "256", "128", "4", "2147483648")).to_equal(true)
        expect(engine_unload().is_ok()).to_equal(true)
