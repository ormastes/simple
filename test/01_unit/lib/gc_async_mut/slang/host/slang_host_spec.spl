"""
## Purpose and audience
Purpose: Pin slang's per-OS decisions (shim and ROCm library names, search
directories, path joins, memory-probe parsing) as pure functions, so the Linux
and macOS branches are checked on any host. Audience: engineers porting slang
to a host they cannot boot.

## Compatibility and limitations
Pure functions take `os` explicitly; the real OS is only exercised by the
wrapper checks, which assert the host's own answer. Importing the slang
entrypoints must not load any native library (lazy first use).
"""

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{dir_create_all, write_file}

use std.gc_async_mut.slang.host.slang_host.{ggml_lib_default, rocm_bin_default_for, hip_lib_names, hiprtc_lib_names, host_libc_name, host_join, parse_meminfo_bytes, parse_int_text, parse_vm_stat_page_size, parse_vm_stat_available_pages, darwin_available_bytes, host_os_name, host_file_exists, slang_windows_available_bytes_fast, host_file_size, host_file_mtime, host_is_dir, host_read_bytes_at, host_file_read}
use std.gc_async_mut.slang.engine.llm_engine.{engine_loaded_model, engine_backend_available, engine_lib_path, engine_set_lib_path}
use std.gc_async_mut.slang.model_executor.model_loader.native_formats.{dir_byte_size}
use std.gc_async_mut.slang.model_executor.model_loader.memory_budget.{check_fit_with_available, mem_available_bytes, mem_total_bytes, default_headroom_bytes, reset_mem_total_cache_for_test}

val MEMINFO = "MemTotal:       16384000 kB\nMemFree:          100000 kB\nMemAvailable:    8192000 kB\nBuffers:           1000 kB\n"
val VM_STAT = "Mach Virtual Memory Statistics: (page size of 16384 bytes)\nPages free:                               5000.\nPages active:                            100000.\nPages inactive:                           90000.\nPages speculative:                         3000.\nPages wired down:                         50000.\nPages purgeable:                           7000.\nPages occupied by compressor:             25000.\n"

describe "slang host library names per OS":
    it "names the ggml shim per OS":
        expect(ggml_lib_default("windows")).to_equal("build/sffi/slang_ggml.dll")
        expect(ggml_lib_default("linux")).to_equal("build/sffi/libslang_ggml.so")
        expect(ggml_lib_default("macos")).to_equal("build/sffi/libslang_ggml.dylib")

    it "names ROCm HIP and hipRTC per OS":
        expect(rocm_bin_default_for("windows")).to_equal("C:\\Program Files\\AMD\\ROCm\\7.2\\bin")
        # escape-independent: an unescaped "\7" literal becomes BEL (0x07), so "7.2" vanishes
        expect(rocm_bin_default_for("windows").contains("ROCm")).to_equal(true)
        expect(rocm_bin_default_for("windows").contains("7.2")).to_equal(true)
        expect(rocm_bin_default_for("linux")).to_equal("/opt/rocm/lib")
        expect(rocm_bin_default_for("macos")).to_equal("")
        expect(hip_lib_names("windows")).to_equal(["amdhip64_7.dll"])
        expect(hip_lib_names("linux")).to_equal(["libamdhip64.so", "libamdhip64.so.7"])
        expect(hiprtc_lib_names("windows")).to_equal(["hiprtc0702.dll"])
        expect(hiprtc_lib_names("linux")).to_equal(["libhiprtc.so", "libhiprtc.so.7"])
        expect(hip_lib_names("macos").len()).to_equal(0)

    it "picks the C library that provides malloc":
        expect(host_libc_name("windows")).to_equal("ucrtbase.dll")
        expect(host_libc_name("linux")).to_equal("libc.so.6")
        expect(host_libc_name("macos")).to_equal("libSystem.B.dylib")
        expect(host_libc_name("freebsd")).to_equal("libc.so.7")

    it "joins paths with the OS separator without doubling it":
        expect(host_join("windows", "C:\\rocm\\bin", "a.dll")).to_equal("C:\\rocm\\bin\\a.dll")
        expect(host_join("windows", "C:\\rocm\\bin\\", "a.dll")).to_equal("C:\\rocm\\bin\\a.dll")
        expect(host_join("windows", "C:/rocm/bin/", "a.dll")).to_equal("C:/rocm/bin/a.dll")
        expect(host_join("linux", "/opt/rocm/lib", "liba.so")).to_equal("/opt/rocm/lib/liba.so")
        expect(host_join("linux", "/opt/rocm/lib/", "liba.so")).to_equal("/opt/rocm/lib/liba.so")
        expect(host_join("linux", "", "liba.so")).to_equal("liba.so")

describe "slang memory probe parsing":
    it "reads MemAvailable and MemTotal from /proc/meminfo content":
        expect(parse_meminfo_bytes(MEMINFO, "MemAvailable")).to_equal(8192000 * 1024)
        expect(parse_meminfo_bytes(MEMINFO, "MemTotal")).to_equal(16384000 * 1024)

    it "answers -1 for an absent key or empty content":
        expect(parse_meminfo_bytes(MEMINFO, "SwapFree")).to_equal(-1)
        expect(parse_meminfo_bytes("", "MemAvailable")).to_equal(-1)

    it "parses a probe's integer stdout and rejects non-numbers":
        expect(parse_int_text("27051000000\r\n")).to_equal(27051000000)
        expect(parse_int_text("  17179869184\n")).to_equal(17179869184)
        expect(parse_int_text("")).to_equal(-1)
        expect(parse_int_text("error: no such key")).to_equal(-1)
        expect(parse_int_text("0")).to_equal(-1)

    it "sums vm_stat free + inactive + speculative pages, not purgeable":
        expect(parse_vm_stat_available_pages(VM_STAT)).to_equal(5000 + 90000 + 3000)
        expect(parse_vm_stat_available_pages("nothing useful")).to_equal(-1)

    it "reads the page size from vm_stat's own header":
        expect(parse_vm_stat_page_size(VM_STAT)).to_equal(16384)
        expect(parse_vm_stat_page_size("Pages free: 5.")).to_equal(-1)

    it "derives macOS availability as reclaimable pages capped at hw.memsize":
        val total = 17179869184
        expect(darwin_available_bytes(total, 16384, 98000)).to_equal(98000 * 16384)
        expect(darwin_available_bytes(total, 16384, 99999999)).to_equal(total)
        expect(darwin_available_bytes(0, 16384, 1)).to_equal(-1)
        expect(darwin_available_bytes(total, 16384, -1)).to_equal(-1)

describe "slang host wrappers and lazy native loading":
    it "reports a known host OS through SOSIX":
        val os = host_os_name()
        expect(os == "windows" or os == "linux" or os == "macos" or os == "freebsd").to_equal(true)

    it "answers backend availability from the file on disk without loading a model":
        step("Verify: availability tracks host_file_exists of the resolved path; the engine stays empty")
        expect(engine_loaded_model()).to_equal("")
        expect(engine_backend_available()).to_equal(host_file_exists(engine_lib_path()))
        # A path that exists but is no loadable library: a dlopen would fail,
        # a file probe answers true. Neither loads a model.
        engine_set_lib_path("test/01_unit/lib/gc_async_mut/slang/host/slang_host_spec.spl")
        expect(engine_backend_available()).to_equal(true)
        engine_set_lib_path("build/sffi/does-not-exist-slang-host-spec.bin")
        expect(engine_backend_available()).to_equal(false)
        engine_set_lib_path("")
        expect(engine_loaded_model()).to_equal("")

    it "probes fast Windows available memory via SOSIX GlobalMemoryStatusEx":
        val os = host_os_name()
        val fast = slang_windows_available_bytes_fast()
        if os == "windows":
            expect(fast).to_be_greater_than(0)
            expect(mem_available_bytes()).to_be_greater_than(0)
        else:
            expect(fast).to_equal(0)

    it "memoizes positive mem_total_bytes across calls and supports test cache reset":
        reset_mem_total_cache_for_test()
        val first = mem_total_bytes()
        expect(first).to_be_greater_than(0)
        val second = mem_total_bytes()
        expect(second).to_equal(first)
        expect(default_headroom_bytes()).to_be_greater_than(0)
        reset_mem_total_cache_for_test()
        expect(mem_total_bytes()).to_equal(first)

describe "slang model size is unknown, not zero, when the directory cannot be listed":
    it "reports -1 for a directory that cannot be listed":
        expect(dir_byte_size("build/probe/no-such-model-dir-slang-host-spec")).to_equal(-1)

    it "refuses the fit check for an unknown model size":
        val verdict = check_fit_with_available(-1, 0, 0, 1099511627776)
        expect(verdict.fits).to_equal(false)
        expect(verdict.reason.contains("model size")).to_equal(true)

describe "slang host file seam (size, mtime, dir test, ranged read)":
    it "answers size, mtime, dir test and a ranged read for a real file":
        step("Verify: the non-SOSIX wrappers agree with the bytes written")
        dir_create_all("build/test/slang_host_seam")
        val p = "build/test/slang_host_seam/f.bin"
        write_file(p, "0123456789")
        expect(host_file_size(p)).to_equal(10)
        expect(host_file_mtime(p)).to_be_greater_than(0)
        expect(host_is_dir("build/test/slang_host_seam")).to_equal(true)
        expect(host_is_dir(p)).to_equal(false)
        match host_read_bytes_at(p, 3, 4):
            Ok(b):
                expect(b.len()).to_equal(4)
                expect(b[0] as i64).to_equal(51)
            Err(why):
                expect(why).to_equal("")
        expect(host_file_size("build/test/slang_host_seam/missing.bin") < 0).to_equal(true)

    it "keeps the kind resolver and model discovery on the slang_host seam":
        step("Verify: kind_registry and serving_models import no io_runtime / external_file host primitive")
        for src in ["src/lib/gc_async_mut/slang/modality/kind_registry.spl", "src/lib/gc_async_mut/slang/entrypoints/openai/serving_models.spl"]:
            val body = host_file_read(src)
            expect(body.len() > 0).to_equal(true)
            expect(body.contains("use std.io_runtime")).to_equal(false)
            expect(body.contains("use std.nogc_sync_mut.io.external_file")).to_equal(false)
