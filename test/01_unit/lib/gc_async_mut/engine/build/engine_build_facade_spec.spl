use std.spec
use std.nogc_async_mut.engine.build.build_config.{BuildTarget, AssetBundleEntry, AssetBundle}
use std.nogc_async_mut.engine.build.build_pipeline.{BuildStep, BuildResult, BuildPipeline}

describe "gc_async_mut engine build facade":

    it "re-exports build targets and asset bundles":
        val target = BuildTarget.linux_x64()
        expect(target.triple()).to_equal("x86_64-linux")

        var bundle = AssetBundle.new("main")
        bundle.add_entry(AssetBundleEntry(name: "player", source_path: "assets/player.png", asset_type: "texture", compressed: true, size_bytes: 100))
        bundle.add_entry(AssetBundleEntry(name: "level", source_path: "assets/level.json", asset_type: "data", compressed: false, size_bytes: 40))
        expect(bundle.entry_count()).to_equal(2)
        expect(bundle.total_compressed_size()).to_equal(100)
        expect(bundle.find_by_type("texture").length()).to_equal(1)

    it "re-exports build pipeline and result helpers":
        var pipeline = BuildPipeline.new()
        pipeline.add_target(BuildTarget.web())
        pipeline.add_default_steps()
        expect(pipeline.target_count()).to_equal(1)
        expect(pipeline.step_count()).to_equal(3)
        expect(pipeline.complete_step(0, 12.5)).to_equal(true)
        expect(pipeline.get_step(0).completed).to_equal(true)

        val result = pipeline.build_for_target(BuildTarget.web())
        expect(result.is_success()).to_equal(true)
        expect(result.step_count()).to_equal(3)
        var failed = BuildResult.new(BuildTarget.web())
        failed.add_error("compile failed")
        expect(failed.error_count()).to_equal(1)
        val step = BuildStep(name: "package", step_type: "package", completed: true, duration_ms: 1.0)
        failed.add_step(step)
        expect(failed.step_count()).to_equal(1)
