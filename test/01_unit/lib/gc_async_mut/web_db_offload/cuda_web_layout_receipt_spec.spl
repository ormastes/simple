# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""Verify CUDA web-layout proof conversion without fabricated provenance."""

use std.spec.step

use std.spec.{describe, it, expect, step}
use std.common.structural.layout.{LayoutExecutionProof}
use std.gc_async_mut.web_db_offload.cuda_web_layout.{
    web_cuda_layout_device_receipt
}
use std.web_db_offload.device_backend.{
    gpu_wdb_device_receipt_valid,
    gpu_wdb_device_receipt_reason
}

fn exact_cuda_web_proof() -> LayoutExecutionProof:
    LayoutExecutionProof(
        candidate_backend: "hybrid_vector_gpu",
        executed_backend: "hybrid_vector_gpu",
        executed: true,
        submitted: true,
        synchronized: true,
        device_readback: true,
        oracle_verified: true,
        backend_handle: 73,
        device_identity: 9001,
        readback_source: "device_readback",
        expected_checksum: 123456,
        actual_checksum: 123456,
        mismatch_count: 0,
        device_time_us: 17,
        device_allocation_count: 1,
        host_allocation_count: 1,
        transfer_bytes: 128,
        device_storage_bytes: 256,
        host_storage_bytes: 336,
        reason: "")

describe "CUDA web layout device receipt":
    # @manual scenario evidence
    it "should preserve exact device provenance":
        # @req REQ-SSPEC-LIB
        step("should preserve exact device provenance")
        step("Convert a complete CUDA layout proof")
        val receipt = web_cuda_layout_device_receipt(exact_cuda_web_proof())

        step("Require every production receipt invariant")
        expect(gpu_wdb_device_receipt_valid(receipt)).to_be(true)
        expect(receipt.backend_handle).to_equal(73)
        expect(receipt.device_identity).to_equal(9001)
        expect(receipt.actual_checksum).to_equal(123456)

    it "should reject CPU-oracle mismatch without hiding its checksum"):
        # @req REQ-SSPEC-LIB
        step("should reject CPU-oracle mismatch without hiding its checksum")
        step("Corrupt an otherwise complete layout proof")
        var proof = exact_cuda_web_proof()
        proof.oracle_verified = false
        proof.actual_checksum = 123455
        proof.mismatch_count = 1
        val receipt = web_cuda_layout_device_receipt(proof)

        step("Fail closed with retained mismatch evidence")
        expect(gpu_wdb_device_receipt_valid(receipt)).to_be(false)
        expect(gpu_wdb_device_receipt_reason(receipt)).to_equal("device-not-completed")
        expect(receipt.expected_checksum).to_equal(123456)
        expect(receipt.actual_checksum).to_equal(123455)
        expect(receipt.mismatch_count).to_equal(1)

    it "should reject a CPU backend carrying copied device-looking fields":
        # @req REQ-SSPEC-LIB
        step("should reject a CPU backend carrying copied device-looking fields")
        step("Change only the executed backend identity")
        var proof = exact_cuda_web_proof()
        proof.executed_backend = "serial_cpu"
        val receipt = web_cuda_layout_device_receipt(proof)

        step("Refuse synthetic cross-backend promotion")
        expect(gpu_wdb_device_receipt_valid(receipt)).to_be(false)
        expect(receipt.completed).to_be(false)
