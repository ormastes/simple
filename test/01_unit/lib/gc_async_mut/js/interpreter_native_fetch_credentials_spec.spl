use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn interpreter_native_source_at(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "JS native fetch credentials":
    it "keeps credential propagation aligned across runtime families":
        for path in [
            "src/lib/gc_async_mut/js/engine/interpreter_native.spl",
            "src/lib/nogc_async_mut/js/engine/interpreter_native.spl",
            "src/lib/nogc_sync_mut/js/engine/interpreter_native.spl"
        ]:
            val source = interpreter_native_source_at(path)
            expect(source).to_contain(
                "var credentials = \"same-origin\""
            )
            expect(source).to_contain(
                "get_object_property(opts_id, \"credentials\")"
            )
            expect(source).to_contain(
                "normalized == \"omit\""
            )
            expect(source).to_contain(
                "normalized == \"same-origin\""
            )
            expect(source).to_contain(
                "normalized == \"include\""
            )
            expect(source).to_contain(
                "set_object_property(request_obj_id, \"credentials\""
            )
