# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/gc_async_mut/js/engine/interpreter_native.spl
#
# This spec used to read interpreter_native.spl as TEXT and assert that certain
# source lines were present in three tier copies. That could not observe the
# credential value actually reaching a request: it stayed green for any
# behavioural regression that preserved the source spelling, and it would have
# gone red for a pure refactor that changed nothing observable.
#
# It now drives a real BrowserSession, evaluates `window.fetch(...)` with each
# credentials mode, and asserts on the credentials carried by the emitted
# BrowserRequest.

use std.spec.step

use std.spec.*
use std.gc_async_mut.web.browser_session.{BrowserSession, BrowserResponse}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*

fn _fetch_request_credentials(script: text) -> text:
    var session = BrowserSession.new()
    session.open_html(
        "https://example.com/credentials.html",
        "<html><body>credentials</body></html>"
    )
    match session.eval_script(script):
        Ok(_): pass_dn
        Err(err):
            fail("script error: {err}")
            return "SCRIPT-ERROR"
    match session.take_pending_request():
        Some(request):
            if request.kind != "fetch":
                fail("expected a fetch request, got {request.kind}")
                return "WRONG-KIND"
            request.credentials
        _:
            fail("fetch emitted no pending request")
            "NO-REQUEST"

describe "JS native fetch credentials":
    # @manual scenario evidence
    it "defaults an option-less fetch to same-origin credentials":
        # @req REQ-SSPEC-UNIT
        step("defaults an option-less fetch to same-origin credentials")
        expect(_fetch_request_credentials(
            "window.fetch('/a'); 'ok'"
        )).to_equal("same-origin")

    it "propagates an explicit include credentials mode to the request":
        # @req REQ-SSPEC-UNIT
        step("propagates an explicit include credentials mode to the request")
        expect(_fetch_request_credentials(
            "window.fetch('/a', { credentials: 'include' }); 'ok'"
        )).to_equal("include")

    it "propagates an explicit omit credentials mode to the request":
        # @req REQ-SSPEC-UNIT
        step("propagates an explicit omit credentials mode to the request")
        expect(_fetch_request_credentials(
            "window.fetch('/a', { credentials: 'omit' }); 'ok'"
        )).to_equal("omit")

    it "normalizes credentials case and surrounding whitespace":
        # @req REQ-SSPEC-UNIT
        step("normalizes credentials case and surrounding whitespace")
        expect(_fetch_request_credentials(
            "window.fetch('/a', { credentials: '  INCLUDE  ' }); 'ok'"
        )).to_equal("include")

    it "ignores an unrecognized credentials mode and keeps the same-origin default":
        # @req REQ-SSPEC-UNIT
        step("ignores an unrecognized credentials mode and keeps the same-origin default")
        expect(_fetch_request_credentials(
            "window.fetch('/a', { credentials: 'bogus-mode' }); 'ok'"
        )).to_equal("same-origin")
