# game2d Camera2D Tests

"""
## Purpose and audience
Verifies the camera behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use std.game2d.camera.{Camera2D, Rect}

# @req: REQ-GAME2D-Camera-001
describe "Camera2D":
    describe "create":
        it "stores viewport dimensions":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: stores viewport dimensions")
            val cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            expect(cam.viewport_w).to_equal(800.0)  # oracle: value fixed by the spec contract
            expect(cam.viewport_h).to_equal(600.0)  # oracle: value fixed by the spec contract

        it "defaults zoom to 1.0":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: defaults zoom to 1.0")
            val cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            expect(cam.zoom).to_equal(1.0)  # oracle: value fixed by the spec contract

    describe "world_to_screen / screen_to_world round-trip":
        it "round-trips the origin at identity":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: round-trips the origin at identity")
            val cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            val (sx, sy) = cam.world_to_screen(0.0, 0.0)
            val (wx, wy) = cam.screen_to_world(sx, sy)
            expect(wx).to_equal(0.0)  # oracle: value fixed by the spec contract
            expect(wy).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "maps world origin to viewport centre":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: maps world origin to viewport centre")
            val cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            val (sx, sy) = cam.world_to_screen(0.0, 0.0)
            expect(sx).to_equal(400.0)  # oracle: value fixed by the spec contract
            expect(sy).to_equal(300.0)  # oracle: value fixed by the spec contract

        it "round-trips an off-centre point":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: round-trips an off-centre point")
            val cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            val world_x = 123.0
            val world_y = -45.0
            val (sx, sy) = cam.world_to_screen(world_x, world_y)
            val (wx, wy) = cam.screen_to_world(sx, sy)
            expect(wx).to_equal(world_x)
            expect(wy).to_equal(world_y)

    describe "zoom":
        it "zoom=2 doubles distance from centre":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: zoom=2 doubles distance from centre")
            var cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            cam.set_zoom(2.0)
            val (sx1, _) = cam.world_to_screen(10.0, 0.0)
            # centre is 400; offset should be 10*2=20 so sx=420
            expect(sx1).to_equal(420.0)  # oracle: value fixed by the spec contract

        it "round-trip holds at zoom=2":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: round-trip holds at zoom=2")
            var cam = Camera2D.create(0.0, 0.0, 800.0, 600.0)
            cam.set_zoom(2.0)
            val (sx, sy) = cam.world_to_screen(50.0, -30.0)
            val (wx, wy) = cam.screen_to_world(sx, sy)
            expect(wx).to_equal(50.0)  # oracle: value fixed by the spec contract
            expect(wy).to_equal(-30.0)  # oracle: value fixed by the spec contract

describe "Rect":
    describe "create":
        it "stores all fields":
            # @req: REQ-GAME2D-Camera-001
            step("Verify: stores all fields")
            val r = Rect.create(10.0, 20.0, 100.0, 50.0)
            expect(r.x).to_equal(10.0)  # oracle: value fixed by the spec contract
            expect(r.y).to_equal(20.0)  # oracle: value fixed by the spec contract
            expect(r.w).to_equal(100.0)  # oracle: value fixed by the spec contract
            expect(r.h).to_equal(50.0)  # oracle: value fixed by the spec contract
