use std.spec
use std.nogc_async_mut.game2d.audio.{AudioError, play}
use std.nogc_async_mut.game2d.audio.sound.{Sound, LoopMode, SpatialMode}

describe "gc_async_mut game2d audio facade":

    it "re-exports sound metadata and audio diagnostics":
        val sfx = Sound.sfx("click.wav")
        expect(sfx.bus_name).to_equal("sfx")
        expect(sfx.looped == LoopMode.Once).to_equal(true)
        expect(sfx.spatial == SpatialMode.Flat).to_equal(true)
        expect(sfx.with_volume(0.5).volume).to_equal(0.5)
        expect(Sound.music("theme.ogg").looped == LoopMode.Loop).to_equal(true)
        expect(Sound.spatial_sfx("hit.wav").spatial == SpatialMode.Positional).to_equal(true)
        expect(Sound(clip_path: "", bus_name: "sfx", volume: 1.0, looped: LoopMode.Once, spatial: SpatialMode.Flat).is_null()).to_equal(true)

        expect(AudioError.backend_missing().code).to_equal("GAME-AUDIO-001")
        expect(play(sfx).is_err()).to_equal(true)
