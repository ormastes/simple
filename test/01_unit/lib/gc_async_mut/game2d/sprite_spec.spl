# game2d Sprite Tests

"""
## Purpose and audience
Verifies the sprite behaviour end to end.
Audience: engineers maintaining this component and its specs.
"""

use std.spec.step
use std.game2d.sprite.{Sprite, AnimatedSprite, FrameRef}

# @req: REQ-GAME2D-Sprite-001
describe "Sprite":
    describe "create":
        it "stores texture_id":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores texture_id")
            val s = Sprite.create(42, 10.0, 20.0, 32, 32)
            expect(s.texture_id).to_equal(42)  # oracle: value fixed by the spec contract

        it "stores position via transform":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores position via transform")
            val s = Sprite.create(1, 10.0, 20.0, 64, 64)
            val (wx, wy) = s.transform.world_position()
            expect(wx).to_equal(10.0)  # oracle: value fixed by the spec contract
            expect(wy).to_equal(20.0)  # oracle: value fixed by the spec contract

        it "stores width and height":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores width and height")
            val s = Sprite.create(1, 0.0, 0.0, 48, 64)
            expect(s.width).to_equal(48)  # oracle: value fixed by the spec contract
            expect(s.height).to_equal(64)  # oracle: value fixed by the spec contract

        it "defaults tint_color to white (0xFFFFFFFF)":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: defaults tint_color to white (0xFFFFFFFF)")
            val s = Sprite.create(1, 0.0, 0.0, 32, 32)
            expect(s.tint_color).to_equal(0xFFFFFFFF)

        it "defaults z to 0":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: defaults z to 0")
            val s = Sprite.create(1, 0.0, 0.0, 32, 32)
            expect(s.z).to_equal(0.0)  # oracle: value fixed by the spec contract

        it "defaults visible to true":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: defaults visible to true")
            val s = Sprite.create(1, 0.0, 0.0, 16, 16)
            expect(s.visible).to_equal(true)

    describe "create_full":
        it "stores explicit z value":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores explicit z value")
            val s = Sprite.create_full(2, 5.0, 10.0, 16, 16, 0.0, 0.0, 1.0, 1.0, 0xFFFF0000, 3.0)
            expect(s.z).to_equal(3.0)  # oracle: value fixed by the spec contract

        it "stores explicit tint_color":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores explicit tint_color")
            val s = Sprite.create_full(2, 0.0, 0.0, 16, 16, 0.0, 0.0, 1.0, 1.0, 0xFFFF0000, 0.0)
            expect(s.tint_color).to_equal(0xFFFF0000)

    describe "set_z":
        it "updates z field":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: updates z field")
            var s = Sprite.create(1, 0.0, 0.0, 16, 16)
            s.set_z(5.0)
            expect(s.z).to_equal(5.0)  # oracle: value fixed by the spec contract

    describe "set_visible":
        it "can hide sprite":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: can hide sprite")
            var s = Sprite.create(1, 0.0, 0.0, 16, 16)
            s.set_visible(false)
            expect(s.visible).to_equal(false)

describe "FrameRef":
    describe "create":
        it "stores all fields":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores all fields")
            val f = FrameRef.create(7, 0.0, 0.0, 0.5, 0.5)
            expect(f.texture_id).to_equal(7)  # oracle: value fixed by the spec contract
            expect(f.u1).to_equal(0.5)  # oracle: value fixed by the spec contract
            expect(f.v1).to_equal(0.5)  # oracle: value fixed by the spec contract

describe "AnimatedSprite":
    describe "create":
        it "starts at frame 0":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: starts at frame 0")
            val f1 = FrameRef.create(1, 0.0, 0.0, 0.5, 1.0)
            val f2 = FrameRef.create(1, 0.5, 0.0, 1.0, 1.0)
            val anim = AnimatedSprite.create([f1, f2], 100.0, 0.0, 0.0, 32, 32)
            expect(anim.current_frame).to_equal(0)  # oracle: value fixed by the spec contract

        it "stores frame_duration_ms":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: stores frame_duration_ms")
            val f1 = FrameRef.create(1, 0.0, 0.0, 1.0, 1.0)
            val anim = AnimatedSprite.create([f1], 200.0, 0.0, 0.0, 16, 16)
            expect(anim.frame_duration_ms).to_equal(200.0)  # oracle: value fixed by the spec contract

    describe "tick":
        it "advances frame after duration elapses":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: advances frame after duration elapses")
            val f1 = FrameRef.create(1, 0.0, 0.0, 0.5, 1.0)
            val f2 = FrameRef.create(1, 0.5, 0.0, 1.0, 1.0)
            var anim = AnimatedSprite.create([f1, f2], 100.0, 0.0, 0.0, 32, 32)
            anim.tick(110.0)
            expect(anim.current_frame).to_equal(1)  # oracle: value fixed by the spec contract

        it "wraps back to frame 0 after last frame":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: wraps back to frame 0 after last frame")
            val f1 = FrameRef.create(1, 0.0, 0.0, 0.5, 1.0)
            val f2 = FrameRef.create(1, 0.5, 0.0, 1.0, 1.0)
            var anim = AnimatedSprite.create([f1, f2], 100.0, 0.0, 0.0, 32, 32)
            anim.tick(110.0)
            anim.tick(110.0)
            expect(anim.current_frame).to_equal(0)  # oracle: value fixed by the spec contract

        it "does not advance when not playing":
            # @req: REQ-GAME2D-Sprite-001
            step("Verify: does not advance when not playing")
            val f1 = FrameRef.create(1, 0.0, 0.0, 0.5, 1.0)
            val f2 = FrameRef.create(1, 0.5, 0.0, 1.0, 1.0)
            var anim = AnimatedSprite.create([f1, f2], 100.0, 0.0, 0.0, 32, 32)
            anim.stop()
            anim.tick(200.0)
            expect(anim.current_frame).to_equal(0)  # oracle: value fixed by the spec contract
