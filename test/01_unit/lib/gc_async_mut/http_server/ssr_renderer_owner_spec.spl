"""Focused contract for the isolated SSR renderer admission owner."""

use std.spec
use std.gc_async_mut.http_server.ssr_renderer_owner.{
    SsrRenderJob, SsrRendererOwner, ssr_render_job_well_formed
}

fn valid_job(id: i64, backend: text) -> SsrRenderJob:
    val job = SsrRenderJob.create(id, "POST", "<p>owned</p>", 8, 8,
        4096, backend, 1)
    match job:
        Some(value): value
        nil: fail("valid bounded SSR job was rejected")

describe "SSR renderer owner boundary":
    it "accepts only bounded immutable request/config values":
        val job = valid_job(1, "auto")
        expect(ssr_render_job_well_formed(job)).to_equal(true)
        expect(SsrRenderJob.create(2, "GET", "<p>x</p>", 8, 8,
            4096, "cpu", 1)).to_be_nil()
        expect(SsrRenderJob.create(3, "POST", "", 8, 8,
            4096, "cpu", 1)).to_be_nil()
        expect(SsrRenderJob.create(4, "POST", "<p>x</p>", 8, 8,
            4096, "unknown", 1)).to_be_nil()

    it "serializes admission and binds completion to the exact job lease":
        val owner_value = SsrRendererOwner.create(2, false)
        match owner_value:
            nil: fail("owner creation unexpectedly failed")
            Some(owner):
                val first = owner.admit(valid_job(10, "gpu"))
                expect(first.accepted).to_equal(true)
                expect(first.selected_backend).to_equal("cpu")
                expect(first.fallback_reason).to_equal(
                    "gpu-unavailable-cpu-fallback")
                val busy = owner.admit(valid_job(11, "cpu"))
                expect(busy.accepted).to_equal(false)
                expect(busy.fallback_reason).to_equal(
                    "renderer-admission-busy-fail-closed")
                val done = owner.complete(first, true)
                expect(done.completed).to_equal(true)
                expect(done.rendered).to_equal(true)
                expect(done.job_id).to_equal(10)
                expect(owner.in_flight()).to_equal(false)

    it "records a GPU admission only when the capability is advertised":
        val owner_value = SsrRendererOwner.create(1, true)
        match owner_value:
            nil: fail("GPU-capable owner creation unexpectedly failed")
            Some(owner):
                val receipt = owner.admit(valid_job(20, "gpu"))
                expect(receipt.selected_backend).to_equal("gpu")
                expect(receipt.fallback_reason).to_equal("")
                expect(owner.gpu_admissions()).to_equal(1)
                val done = owner.cancel(receipt)
                expect(done.completed).to_equal(true)
                expect(done.rendered).to_equal(false)
