# std.gc_async_mut.cache TTL unit: ttl_seconds must be seconds, not milliseconds,
# and the real cache implementation must not be shadowed by no-op stubs.

use std.gc_async_mut.cache.{cache_ttl_new, cache_ttl_put, cache_ttl_get}
use std.nogc_sync_mut.src.time.{sleep_ms}

describe "std.gc_async_mut.cache TTL unit handling":
    it "keeps an entry alive for the requested number of seconds, not milliseconds":
        val cache = cache_ttl_new(10, 60)
        cache_ttl_put(cache, "k", "v")
        sleep_ms(150)
        val got = cache_ttl_get(cache, "k")
        expect(got).to_equal("v")
