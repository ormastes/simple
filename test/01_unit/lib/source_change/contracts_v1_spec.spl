# @cover src/lib/common/source_change/contracts_v1.spl
# REQ-003/007/024: shared carriers and bounded shape checks, not root admission.
use std.spec.*
use std.spec.step
use std.common.source_change.contracts_v1.*
use test.fixtures.compiler.source_change_contract_cases.*

describe "SourceChange shared contract shape":
    it "REQ-003 preserves hints and distinguishes shape from proof":
        step("Inspect a well-formed incomplete batch without promoting completeness")
        val hint = source_contract_batch_v1()
        expect(source_change_batch_shape_v1(hint, source_contract_limits_v1()).valid).to_equal(true)
        expect(hint.complete).to_equal(false)
        expect(source_contract_case_v1(1).reason).to_equal("well_formed_change_batch")

    it "REQ-007 rejects wrong schema, zero sequence and malformed roots":
        step("Refuse incompatible headers before visiting edit payloads")
        expect(source_contract_case_v1(2).reason).to_equal("unsupported_schema")
        expect(source_contract_case_v1(3).reason).to_equal("invalid_sequence")
        expect(source_contract_case_v1(4).reason).to_equal("invalid_root_digest")
        expect(source_contract_case_v1(5).reason).to_equal("invalid_payload_digest")

    it "REQ-003 refuses unsafe paths and missing version identities":
        step("Check repository-relative spelling and required edit identities")
        expect(source_contract_case_v1(6).reason).to_equal("invalid_path")
        expect(source_contract_case_v1(7).reason).to_equal("missing_edit_identity")
        expect(source_change_path_shape_v1("src/a.spl", 128)).to_equal(true)
        expect(source_change_path_shape_v1("/src/a.spl", 128)).to_equal(false)
        expect(source_change_path_shape_v1("src//a.spl", 128)).to_equal(false)
        expect(source_change_path_shape_v1("src/./a.spl", 128)).to_equal(false)
        expect(source_change_path_shape_v1("src/\\a.spl", 128)).to_equal(false)
        expect(source_change_path_shape_v1("src/\0a.spl", 128)).to_equal(false)

    it "REQ-024 bounds coordinates, replacement claims and cardinality":
        step("Check byte extents and cumulative payload claims without overflow")
        expect(source_contract_case_v1(8).reason).to_equal("byte_extent_over_bound")
        expect(source_contract_case_v1(9).reason).to_equal("byte_extent_over_bound")
        expect(source_contract_case_v1(10).reason).to_equal("edit_count_over_bound")
        expect(source_contract_case_v1(14).reason).to_equal("payload_over_bound")

    it "REQ-024 bounds metadata even when a transaction ID equals a path":
        step("Bound every identity independently before subtracting from the remaining budget")
        expect(source_contract_case_v1(11).reason).to_equal("identity_over_bound")
        expect(source_contract_case_v1(12).reason).to_equal("metadata_over_bound")
        expect(source_contract_case_v1(13).reason).to_equal("metadata_over_bound")
        expect(source_contract_case_v1(15).reason).to_equal("identity_over_bound")
