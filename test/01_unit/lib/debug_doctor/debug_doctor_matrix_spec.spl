"""
debug-doctor capability matrix unit spec (P11).

The doctor is the acceptance test for "does this host properly support DAP
and profile", so this spec checks that its cells are PRODUCED, not declared:

  * the host profile cell comes from an elapsed time really measured here
  * every row a target reports is driven by the capability registry, so a
    registered target changes the row and an unregistered one reports a
    truthful absence naming the stream that will land it
  * GPU rows are host-aware: a fake probe drives the deterministic cases,
    and the live-host assertions accept "ok" OR a stated skip reason but
    never an empty/invented one
  * Metal on a non-macOS host must SKIP, with its own reason
    ("skip:metal-unavailable-not-macos" from metal_lane_session.spl:149).
    That skip is correct and is asserted as correct — never fixed up, never
    replaced with a fabricated Metal result.

Design: doc/05_design/app/tools/unified_debug_profile_capability_architecture_2026-08-09.md §1.5, §5
Plan:   doc/03_plan/agent_tasks/unified_debug_profile_capability_parallel_plan_2026-08-09.md (P11)
"""

use std.spec
use std.debug_doctor.matrix.{
    RegisteredCapability, CapabilityRegistry, doctor_rows, host_row, gpu_row,
    render_doctor_matrix, measure_host_wall_ns, row_is_attachable
}
use std.notebook.gpu_mode_resolver.{GpuBackendProbe}
use std.notebook.gpu_mode_probe_live.{LiveGpuBackendProbe}

class StubProbe:
    available: [text]

impl StubProbe:
    static fn with_available(available: [text]) -> StubProbe:
        StubProbe(available: available)

impl GpuBackendProbe for StubProbe:
    me probe_backend(backend: text) -> text:
        for name in self.available:
            if name == backend:
                return ""
        if backend == "cuda": return "skip:cuda-driver-unavailable"
        if backend == "vulkan": return "skip:vulkan-loader-unavailable"
        if backend == "metal": return "skip:metal-unavailable-not-macos"
        "skip:unknown-backend-{backend}"

fn empty_registry() -> CapabilityRegistry:
    CapabilityRegistry.create()

describe "debug-doctor — host row is measured, not declared":

    it "measures a positive wall interval with the host clock":
        val wall_ns = measure_host_wall_ns()
        # A real elapsed measurement over real work. If the host clock did
        # not advance this is 0 and the doctor reports Unavailable -- the
        # assertion is on the measurement, not on a constant.
        assert_true(wall_ns > 0)

    it "reports host profile as Native (wall) carrying the measured value":
        val row = host_row(empty_registry(), "")
        expect(row.target).to_equal("host")
        expect(row.attach).to_equal("ok")
        assert_true(row.profile.starts_with("Native (wall)"))
        assert_true(row.profile.contains("measured "))
        # `steps` is not available until P4's interpreter counter lands, and
        # the row says so instead of implying it.
        assert_true(row.profile.contains("steps pending P4"))

    it "does not claim a host DebugTarget while none is registered":
        val row = host_row(empty_registry(), "")
        assert_true(row.debug.starts_with("Unavailable"))
        assert_true(row.debug.contains("host_debug_target.spl"))

    it "skips attach when the named program does not exist":
        val row = host_row(empty_registry(), "no/such/program_p11.spl")
        assert_true(row.attach.starts_with("skip:host-program-not-found"))
        assert_false(row_is_attachable(row))

describe "debug-doctor — rows follow the capability registry":

    it "reports a registered host DebugTarget instead of the pending note":
        var registry = CapabilityRegistry.create()
        registry.register(RegisteredCapability(
            target: "host", debug_level: "Native", debug_detail: "line",
            profile_level: "Native", profile_detail: "wall+steps"))
        val row = host_row(registry, "")
        expect(row.debug).to_equal("Native (line)")
        expect(row.profile).to_equal("Native (wall+steps)")

    it "reports a registered GPU DebugTarget on an attachable backend":
        var registry = CapabilityRegistry.create()
        registry.register(RegisteredCapability(
            target: "cuda", debug_level: "Native", debug_detail: "svmg_pc",
            profile_level: "Emulated", profile_detail: "steps"))
        var probe = StubProbe.with_available(["cuda"])
        val row = gpu_row(registry, "cuda", probe)
        expect(row.attach).to_equal("ok")
        expect(row.debug).to_equal("Native (svmg_pc)")
        expect(row.profile).to_equal("Emulated (steps)")

    it "never prints capabilities for a backend that did not attach":
        var registry = CapabilityRegistry.create()
        # Registered, but the hardware is absent: the row must still show
        # the skip and no capability, because the capability cannot be
        # exercised on this machine.
        registry.register(RegisteredCapability(
            target: "cuda", debug_level: "Native", debug_detail: "svmg_pc",
            profile_level: "Native", profile_detail: "cuEvent"))
        var probe = StubProbe.with_available([])
        val row = gpu_row(registry, "cuda", probe)
        expect(row.attach).to_equal("skip:cuda-driver-unavailable")
        expect(row.debug).to_equal("-")
        expect(row.profile).to_equal("-")

describe "debug-doctor — matrix shape and rendering":

    it "emits one host row plus one row per GPU backend in a fixed order":
        var probe = StubProbe.with_available(["cuda"])
        val rows = doctor_rows(empty_registry(), probe, "")
        expect(rows.len()).to_equal(4)
        expect(rows[0].target).to_equal("host")
        expect(rows[1].target).to_equal("cuda")
        expect(rows[2].target).to_equal("vulkan")
        expect(rows[3].target).to_equal("metal")

    it "renders a header and one line per row without truncating reasons":
        var probe = StubProbe.with_available([])
        val rows = doctor_rows(empty_registry(), probe, "")
        val rendered = render_doctor_matrix(rows)
        val lines = rendered.split("\n")
        expect(lines.len()).to_equal(5)
        assert_true(lines[0].contains("target"))
        assert_true(lines[0].contains("attach"))
        assert_true(lines[0].contains("debug"))
        assert_true(lines[0].contains("profile"))
        # The full skip reason survives into the rendered cell.
        assert_true(rendered.contains("skip:metal-unavailable-not-macos"))

describe "debug-doctor — live host probe (host-aware)":

    it "gives every GPU row either ok or a stated skip reason, never a blank":
        var probe = LiveGpuBackendProbe.create()
        val rows = doctor_rows(empty_registry(), probe, "")
        for row in rows:
            assert_false(row.attach == "")
            if not row_is_attachable(row):
                # A non-attachable target must always say WHY.
                assert_true(row.attach.starts_with("skip:") or row.attach.starts_with("blocked:"))
                assert_true(row.attach.len() > 6)

    it "skips metal cleanly on a non-macOS host, for metal's own reason":
        var probe = LiveGpuBackendProbe.create()
        val row = gpu_row(empty_registry(), "metal", probe)
        if row.attach == "ok":
            # A real Metal host (a Mac): the skip contract does not apply.
            assert_true(true)
        else:
            # Linux/Windows: rt_metal_is_available() hard-returns false, and
            # this is the CORRECT result -- asserted as such.
            assert_true(row.attach.starts_with("skip:metal-"))
            expect(row.debug).to_equal("-")
            expect(row.profile).to_equal("-")

    it "reports the host row as attachable on any host":
        var probe = LiveGpuBackendProbe.create()
        val rows = doctor_rows(empty_registry(), probe, "")
        assert_true(row_is_attachable(rows[0]))
