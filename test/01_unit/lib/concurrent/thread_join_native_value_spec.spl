# Native-run spec: thread join returns the worker's value, not its tagged word.
# Binary: env THREAD_JOIN_NATIVE_BIN, built from test/fixtures/native/thread_join_value_probe.spl.

"""
## Purpose and audience
Purpose: a natively compiled program that spawns a worker returning 1 gets 1 back from
`join()`, exactly like the interpreter, instead of the runtime's tagged word (8).
Audience: concurrency stdlib maintainers.
"""

use std.spec.*
use std.io_runtime.{process_run, env_get_opt}

val BUILD_CMD: text = "SIMPLE_NATIVE_BUILD_RUST=1 SIMPLE_NATIVE_INCREMENTAL=1 $SEED native-build test/fixtures/native/thread_join_value_probe.spl -o build/nb/tj_probe.exe --cache-dir build/nb/cache"

fn probe_bin() -> text:
    match env_get_opt("THREAD_JOIN_NATIVE_BIN"):
        case Some(v): v
        case None: ""

val tj_bin = probe_bin()
val tj_run = if tj_bin == "": ("", "", -1) else: process_run(tj_bin, [])

describe "native thread join value":
    it "has the native probe binary available":
        step("Require THREAD_JOIN_NATIVE_BIN; otherwise report blocked with the build command")
        val msg = if tj_bin == "": "BLOCKED: THREAD_JOIN_NATIVE_BIN unset; build with: {BUILD_CMD}" else: "available"
        expect(msg).to_equal("available")

    it "exits cleanly":
        expect(tj_run.2).to_equal(0)

    it "returns 1 from a worker that returned 1":
        step("The bug returned Some(8): the tagged word 1 << 3")
        expect(tj_run.0.contains("i64_one=1\n")).to_equal(true)

    it "returns 42 from a worker that returned 42":
        expect(tj_run.0.contains("i64_42=42\n")).to_equal(true)

    it "returns the sum from a two-argument worker":
        expect(tj_run.0.contains("args_sum=42\n")).to_equal(true)

    it "returns the product through the scalar join-by-id facade":
        expect(tj_run.0.contains("by_id=30\n")).to_equal(true)

    it "returns none on a second join of the same handle":
        expect(tj_run.0.contains("rejoin=none")).to_equal(true)
