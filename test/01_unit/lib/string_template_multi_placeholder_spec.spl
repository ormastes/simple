# string_template_multi_placeholder_slot_not_found_2026-07-30
#
# Two bare `_` placeholders inside ONE string template passed to a
# single-argument callback must share one implicit slot. Before the fix the
# placeholder transform counted occurrences, synthesised `__p0` AND `__p1`,
# and died with `semantic: variable __p1 not found`.

describe "string template multi-placeholder":
    it "two bare placeholders with different tuple indexes share one slot":
        val pairs = [("count", 1), ("ready", 2)]
        val out = pairs.map("{_.0}: {_.1}")
        expect(out.join(", ")).to_equal("count: 1, ready: 2")

    it "the same bare placeholder index reused twice shares one slot":
        val pairs = [("count", 1), ("ready", 2)]
        val out = pairs.map("{_.0}-{_.0}")
        expect(out.join(", ")).to_equal("count-count, ready-ready")

    it "two bare placeholders without any tuple indexing share one slot":
        val out = ["a", "b"].map("{_}-{_}")
        expect(out.join(", ")).to_equal("a-a, b-b")

    it "numbered placeholder used twice in one template collapses to one slot":
        val out = [("x", 10), ("y", 20)].map("{_1.0}={_1.1}")
        expect(out.join(",")).to_equal("x=10,y=20")

    it "two distinct numbered placeholders still get two params (reduce)":
        val total = [1, 2, 3].reduce(0, _1 + _2)
        expect(total).to_equal(6)
