use std.editor.services.command_palette.{PaletteEntry, palette_new, palette_update_query}

describe "command palette ranked filtering":
    it "keeps every matching entry after removing the highest score":
        val entries = [
            PaletteEntry(description: "", name: "alpha", command_name: "alpha", command_payload: "a"),
            PaletteEntry(description: "", name: "atlas", command_name: "atlas", command_payload: "b"),
            PaletteEntry(description: "", name: "amber", command_name: "amber", command_payload: "c")
        ]
        val filtered = palette_update_query(palette_new(entries), "a").filtered
        expect(filtered.len()).to_equal(3)
        expect(filtered[0].command_payload != filtered[1].command_payload).to_equal(true)
        expect(filtered[1].command_payload != filtered[2].command_payload).to_equal(true)
        expect(filtered[0].command_payload != filtered[2].command_payload).to_equal(true)
