# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

# Bug: native_text_literal_brace_escape_unprocessed_2026-11-26.
#
# The lsp_build_* builders concatenate JSON from string literals. A literal
# brace there must mean the same thing under the seed lexer and the
# self-hosted CoreLexer, so every brace is spelled doubled (`{{` / `}}`,
# one brace each in both). This spec checks that each builder output parses
# as strict JSON (the seed meaning), and that every builder literal lexes to
# the same no-hole value with the self-hosted lexer.

use std.spec.step

use std.editor.services.lsp_transport.*
use std.common.json.parser.{json_parse_strict_bounded_with_error, json_parse_limits_default}
use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.frontend.core.lexer_struct.{CoreLexer, make_core_lexer, core_lexer_next_token, core_lexer_token_text}
use compiler.frontend.core.string_interpolation_expand.{parse_string_interpolation_regions, decode_interpolation_brace_escapes}

val LB = "{{"
val RB = "}}"

fn json_error(value: text) -> text:
    val (_v, err) = json_parse_strict_bounded_with_error(value, json_parse_limits_default())
    err

# Length of the longest odd run of one brace character in `line`, or 0.
fn odd_brace_run(line: text, brace: text) -> i64:
    var run = 0
    var i = 0
    val n = line.len()
    while i <= n:
        val ch = if i < n: line[i:i + 1] else: ""
        if ch == brace:
            run = run + 1
        else:
            if run % 2 == 1:
                return run
            run = 0
        i = i + 1
    0

# Builder lines with a single (undoubled) brace, or whose string literals
# open a hole or decode differently under the self-hosted lexer. The last
# entry counts the string tokens checked, so the scan cannot pass vacuously.
fn self_hosted_mismatches() -> [text]:
    val lines = file_read("src/lib/editor/services/lsp_transport.spl").split("\n")
    var bad: [text] = []
    var in_builder = false
    var strings_checked = 0
    for line in lines:
        if line.starts_with("fn ") or line.starts_with("pub fn "):
            in_builder = line.contains("fn lsp_build_")
            continue
        if not in_builder or (not line.contains(LB) and not line.contains(RB)):
            continue
        if odd_brace_run(line, LB) > 0 or odd_brace_run(line, RB) > 0:
            bad.push("odd brace run: " + line.trim())
        var lx: CoreLexer = make_core_lexer(line.trim())
        var n = 0
        while n < 300:
            val r = core_lexer_next_token(lx)
            lx = r.0
            if r.1 == 3:
                strings_checked = strings_checked + 1
                val tok = core_lexer_token_text(lx)
                val (rewritten, parts) = parse_string_interpolation_regions(tok)
                val value = decode_interpolation_brace_escapes(rewritten)
                val want = tok.replace(LB + LB, LB).replace(RB + RB, RB)
                if parts.len() > 0 or value != want:
                    bad.push(line.trim())
            n = n + 1
    bad.push("strings_checked>30=" + (strings_checked > 30).to_text())
    bad

describe "lsp_build_* JSON builders":
    # @manual scenario evidence
    it "emit strict JSON for every builder":
        # @req REQ-SSPEC-UNIT
        step("each builder output parses with the strict JSON parser")
        expect(json_error(lsp_build_initialize_params("file:///r", "cli"))).to_equal("")
        expect(json_error(lsp_build_did_open_params("u", "spl", 1, "abc"))).to_equal("")
        expect(json_error(lsp_build_did_change_params("u", 2, "abc"))).to_equal("")
        expect(json_error(lsp_build_did_change_watched_file_params("u", 1))).to_equal("")
        expect(json_error(lsp_build_workspace_folder_event_params("u", "n", true))).to_equal("")
        expect(json_error(lsp_build_workspace_folder_event_params("u", "n", false))).to_equal("")
        expect(json_error(lsp_build_position_params("u", 1, 2))).to_equal("")
        expect(json_error(lsp_build_selection_range_params("u", 1, 2))).to_equal("")
        expect(json_error(lsp_build_document_params("u"))).to_equal("")
        expect(json_error(lsp_build_workspace_symbol_params("q"))).to_equal("")
        expect(json_error(lsp_build_full_range_params("u"))).to_equal("")
        expect(json_error(lsp_build_code_action_params("u", 1, 2))).to_equal("")
        expect(json_error(lsp_build_references_params("u", 1, 2))).to_equal("")
        expect(json_error(lsp_build_rename_params("u", 1, 2, "nn"))).to_equal("")
        expect(json_error(lsp_build_formatting_params("u"))).to_equal("")
        expect(json_error(lsp_build_range_formatting_params("u", 1, 2, 3, 4))).to_equal("")

    it "lexes every builder literal to the same value with the self-hosted lexer":
        # @req REQ-SSPEC-UNIT
        step("no hole, and the doubled-brace decode, for each builder literal")
        expect(self_hosted_mismatches()).to_equal(["strings_checked>30=true"])
