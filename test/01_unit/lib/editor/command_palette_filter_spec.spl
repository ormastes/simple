use std.spec.*
use std.editor.services.command_palette.{PaletteEntry, palette_new, palette_update_query}

fn entry(name: text, command_name: text) -> PaletteEntry:
    PaletteEntry(description: "", name: name, command_name: command_name, command_payload: "")

describe "command palette filtering":
    it "ranks matches stably without removing from the scored array":
        val state = palette_new([
            entry("Open File", "open_file"),
            entry("Open Folder", "open_folder"),
            entry("Close", "close"),
        ])
        val filtered = palette_update_query(state, "open").filtered
        expect(filtered.len()).to_equal(2)
        expect(filtered[0].command_name).to_equal("open_file")
        expect(filtered[1].command_name).to_equal("open_folder")
