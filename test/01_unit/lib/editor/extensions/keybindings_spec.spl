# Keybinding contribution registry: chord resolution, when-gating, and
# conflict listing.

use std.spec
use std.editor.extensions.keybindings.*
use std.editor.extensions.api.{ContextKeys, WhenPredicate}

describe "KeybindingRegistry resolve":

    it "resolves a chord with no when clause":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+b", command_id: "sidebar.toggle", when: None))
        match reg.resolve("ctrl+b", ContextKeys.new()):
            case Some(cmd):
                expect(cmd).to_equal("sidebar.toggle")
            case None:
                expect("resolved").to_equal("none")

    it "an unregistered chord resolves to None":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+b", command_id: "sidebar.toggle", when: None))
        match reg.resolve("ctrl+k", ContextKeys.new()):
            case Some(_):
                expect("none").to_equal("resolved")
            case None:
                expect(true).to_equal(true)

    it "a when clause gates resolution: no match -> None":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+shift+f",
            command_id: "search.find", when: Some(WhenPredicate.Truthy(key: "editorFocus"))))
        match reg.resolve("ctrl+shift+f", ContextKeys.new()):
            case Some(_):
                expect("none").to_equal("resolved")
            case None:
                expect(true).to_equal(true)

    it "a when clause gates resolution: match -> resolves":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+shift+f",
            command_id: "search.find", when: Some(WhenPredicate.Truthy(key: "editorFocus"))))
        val ctx = ContextKeys.new()
        ctx.set("editorFocus", "true")
        match reg.resolve("ctrl+shift+f", ctx):
            case Some(cmd):
                expect(cmd).to_equal("search.find")
            case None:
                expect("resolved").to_equal("none")

    it "last-registered-wins among when-matching entries for the same chord":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.legacy", when: None))
        reg.register("ext-b", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.new", when: None))
        match reg.resolve("ctrl+p", ContextKeys.new()):
            case Some(cmd):
                expect(cmd).to_equal("quickopen.new")
            case None:
                expect("resolved").to_equal("none")

    it "a later non-matching when clause does not shadow an earlier matching one":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.base", when: None))
        reg.register("ext-b", KeybindingDescriptor(key_chord: "ctrl+p",
            command_id: "quickopen.python", when: Some(WhenPredicate.Equals(key: "lang", value: "python"))))
        val ctx = ContextKeys.new()
        ctx.set("lang", "simple")
        match reg.resolve("ctrl+p", ctx):
            case Some(cmd):
                expect(cmd).to_equal("quickopen.base")
            case None:
                expect("resolved").to_equal("none")

describe "KeybindingRegistry conflicts":

    it "lists chords with more than one registration":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.legacy", when: None))
        reg.register("ext-b", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.new", when: None))
        reg.register("ext-c", KeybindingDescriptor(key_chord: "ctrl+b", command_id: "sidebar.toggle", when: None))
        val conflicts = reg.conflicts()
        expect(conflicts.len()).to_equal(1)
        expect(conflicts[0]).to_equal("ctrl+p")

    it "dispose_owner removes an owner's bindings and clears the conflict":
        val reg = KeybindingRegistry.new()
        reg.register("ext-a", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.legacy", when: None))
        val d = reg.register("ext-b", KeybindingDescriptor(key_chord: "ctrl+p", command_id: "quickopen.new", when: None))
        expect(reg.conflicts().len()).to_equal(1)
        expect(reg.dispose(d.id)).to_equal(true)
        expect(reg.conflicts().len()).to_equal(0)
        expect(reg.count()).to_equal(1)
