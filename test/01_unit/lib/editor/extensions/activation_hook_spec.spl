# Extension activation entrypoint wiring (lane L6b).
#
# Proves ExtensionHost.register_activation_hook / activate() close the gap
# recorded in .spipe/ide_extension_kernel/state.md ("builtin registration
# functions are NOT auto-invoked -- callers must register manually because
# activation doesn't execute extension entry code"): a hook runs exactly
# once the first time its extension activates, an Err hook becomes a
# diagnostic + recorded crash-state failure instead of crashing the host,
# and the sheets/slides builtin fixtures (DOUBLE(n), title_diagram) are now
# reachable through extension_host_with_builtins() alone -- no manual
# `*_register_builtins()` call required.

use std.spec
use std.editor.extensions.host.*
use std.editor.extensions.manifest.*
use app.office.sheets.function_registry.{sheet_function_registry_has, sheet_function_registry_reset}
use app.office.slides.layout_registry.{slide_layout_registry_has, slide_layout_registry_reset}

var _hook_calls: i64 = 0

fn _counting_hook(name: text) -> Result<text, text>:
    _hook_calls = _hook_calls + 1
    Ok("counted:" + name)

fn _failing_hook(name: text) -> Result<text, text>:
    Err("boom:" + name)

fn hook_demo_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "hook-demo", "1.0.0", "",
        ["onStartup"],
        [],
        []
    )

fn failing_demo_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "hook-fail-demo", "1.0.0", "",
        ["onStartup"],
        [],
        []
    )

fn sibling_demo_manifest() -> ExtensionManifest:
    extension_manifest_basic(
        "hook-sibling-demo", "1.0.0", "",
        ["onCommand:sibling.ping"],
        [ExtensionCommand(id: "sibling.ping", title: "Sibling Ping", category: "Demo")],
        []
    )

fn sibling_handler(payload: text) -> Result<text, text>:
    Ok("pong:" + payload)

describe "extension activation hooks (L6b)":

    it "does not run the hook before activation, then runs it exactly once":
        _hook_calls = 0
        val host = ExtensionHost.new()
        host.register_manifest(hook_demo_manifest(), "<test>")
        host.register_activation_hook("hook-demo", _counting_hook)
        expect(_hook_calls).to_equal(0)
        expect(host.activation_hook_ran("hook-demo")).to_equal(false)

        val activated = host.activate("hook-demo")
        expect(activated).to_equal(true)
        expect(_hook_calls).to_equal(1)
        expect(host.activation_hook_ran("hook-demo")).to_equal(true)

    it "does not re-run the hook across a deactivate/activate cycle (guard against re-activation)":
        _hook_calls = 0
        val host = ExtensionHost.new()
        host.register_manifest(hook_demo_manifest(), "<test>")
        host.register_activation_hook("hook-demo", _counting_hook)
        host.activate("hook-demo")
        expect(_hook_calls).to_equal(1)
        expect(host.deactivate("hook-demo")).to_equal(true)
        expect(host.activate("hook-demo")).to_equal(true)
        expect(_hook_calls).to_equal(1)

    it "an Err hook becomes a diagnostic and does not crash the host; the extension still activates":
        val host = ExtensionHost.new()
        host.register_manifest(failing_demo_manifest(), "<test>")
        host.register_activation_hook("hook-fail-demo", _failing_hook)
        val before_diag = host.activation_diagnostic_count()

        val activated = host.activate("hook-fail-demo")
        expect(activated).to_equal(true)
        expect(host.is_active("hook-fail-demo")).to_equal(true)
        expect(host.activation_diagnostic_count()).to_equal(before_diag + 1)
        expect(host.last_activation_diagnostic().contains("hook-fail-demo")).to_equal(true)

    it "host stays functional after a failing hook: an unrelated extension still activates and dispatches":
        val host = ExtensionHost.new()
        host.register_manifest(failing_demo_manifest(), "<test>")
        host.register_activation_hook("hook-fail-demo", _failing_hook)
        host.activate("hook-fail-demo")

        host.register_manifest(sibling_demo_manifest(), "<test>")
        host.register_command_handler("hook-sibling-demo", "sibling.ping", "Sibling Ping", sibling_handler)
        match host.dispatch_command("sibling.ping", "hi"):
            case Ok(out):
                expect(out).to_equal("pong:hi")
            case Err(_):
                expect("sibling dispatch").to_equal("should have succeeded")

    it "an extension with no registered hook activates normally (no-op)":
        val host = ExtensionHost.new()
        host.register_manifest(sibling_demo_manifest(), "<test>")
        expect(host.activate("hook-sibling-demo")).to_equal(true)
        expect(host.activation_hook_ran("hook-sibling-demo")).to_equal(false)

    it "sheets DOUBLE is reachable via the function registry after activating the builtin, no manual registration call":
        sheet_function_registry_reset()
        expect(sheet_function_registry_has("DOUBLE")).to_equal(false)
        val host = extension_host_with_builtins()
        expect(host.is_active("sheets-function-registry-demo")).to_equal(true)
        expect(sheet_function_registry_has("DOUBLE")).to_equal(true)

    it "slides title_diagram is reachable via the layout registry after activating the builtin, no manual registration call":
        slide_layout_registry_reset()
        expect(slide_layout_registry_has("title_diagram")).to_equal(false)
        val host = extension_host_with_builtins()
        expect(host.is_active("slides-layout-registry-demo")).to_equal(true)
        expect(slide_layout_registry_has("title_diagram")).to_equal(true)
