"""
## Purpose and audience
Purpose: Prove that extension manifest SDN decode (simple.ide.extension/1).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-EDITOR-001 — stable requirement identity for this spec.

# Extension manifest SDN decoder — schema "simple.ide.extension/1".
#
# Covers: full realistic manifest decode (incl. themes, keybindings,
# custom editors, debug adapters), duplicate command id diagnostic,
# missing required field diagnostic with line info, legacy quote-style
# manifest compatibility, empty input.

use std.spec
use std.editor.extensions.manifest.*
use std.editor.extensions.manifest_sdn.*

fn realistic_manifest_source() -> text:
    "extension:\n" +
    "  schema: simple.ide.extension/1\n" +
    "  id: acme.notes\n" +
    "  display_name: Acme Notes\n" +
    "  version: 1.2.3\n" +
    "  engine: \">=0.5.0 <2.0.0\"\n" +
    "  entry: main.spl\n" +
    "  host: in_process\n" +
    "permissions:\n" +
    "  workspace_read: true\n" +
    "  network_client: false\n" +
    "activation:\n" +
    '  events: ["onCommand:acme.notes.hello", "onLanguage:acmenotes"]' + "\n" +
    "contributes:\n" +
    '  commands: [{id: "acme.notes.hello", title: "Acme: Hello", category: "Acme"}, {id: "acme.notes.open", title: "Acme: Open"}]' + "\n" +
    '  languages: [{id: "acmenotes", extensions: [".an", ".acme"]}]' + "\n" +
    '  custom_editors: [{id: "acme.editor", document_kind: "acme.doc", priority: 2}]' + "\n" +
    '  keybindings: [{command: "acme.notes.hello", key: "ctrl+h", when: "editorFocus"}]' + "\n" +
    '  themes: [{id: "acme-dark", label: "Acme Dark", ui_theme: "dark", path: "themes/dark.sdn"}]' + "\n" +
    '  debug_adapters: [{id: "acme-dap", label: "Acme Debug", program: "bin/acme"}]' + "\n"

describe "extension manifest SDN decode (simple.ide.extension/1)":

    it "decodes a realistic manifest with zero issues":
        step("Verify: decodes a realistic manifest with zero issues")
        # @req: REQ-LIB-EDITOR-001
        val load = extension_manifest_decode(realistic_manifest_source())
        expect(load.ok).to_equal(true)
        expect(load.issues.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val m = load.manifest
        expect(m.schema_version).to_equal("simple.ide.extension/1")
        expect(m.name).to_equal("acme.notes")
        expect(m.display_name).to_equal("Acme Notes")
        expect(m.version).to_equal("1.2.3")
        expect(m.engine).to_equal(">=0.5.0 <2.0.0")
        expect(m.entry).to_equal("main.spl")
        expect(m.main).to_equal("main.spl")
        expect(m.host).to_equal("in_process")

    it "decodes default-deny permissions with explicit grants":
        step("Verify: decodes default-deny permissions with explicit grants")
        val m = extension_manifest_decode(realistic_manifest_source()).manifest
        expect(m.permissions.workspace_read).to_equal(true)
        expect(m.permissions.workspace_write).to_equal(false)
        expect(m.permissions.process_spawn).to_equal(false)
        expect(m.permissions.network_client).to_equal(false)
        expect(m.permissions.secrets).to_equal(false)
        expect(m.permissions.native_ffi).to_equal(false)

    it "decodes activation events and command contributions":
        step("Verify: decodes activation events and command contributions")
        val m = extension_manifest_decode(realistic_manifest_source()).manifest
        expect(m.activation_events.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(m.activation_events[0]).to_equal("onCommand:acme.notes.hello")
        expect(m.contributes_commands.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(m.contributes_commands[0].id).to_equal("acme.notes.hello")
        expect(m.contributes_commands[0].title).to_equal("Acme: Hello")
        expect(m.contributes_commands[0].category).to_equal("Acme")
        expect(m.contributes_commands[1].category).to_equal("")

    it "decodes languages with file extensions (not the old empty list)":
        step("Verify: decodes languages with file extensions (not the old empty list)")
        val m = extension_manifest_decode(realistic_manifest_source()).manifest
        expect(m.contributes_languages.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(m.contributes_languages[0].id).to_equal("acmenotes")
        expect(m.contributes_languages[0].extensions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(m.contributes_languages[0].extensions[0]).to_equal(".an")

    it "decodes custom editors, keybindings, themes, debug adapters for real":
        step("Verify: decodes custom editors, keybindings, themes, debug adapters for real")
        val m = extension_manifest_decode(realistic_manifest_source()).manifest
        expect(m.contributes_custom_editors.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(m.contributes_custom_editors[0].document_kind).to_equal("acme.doc")
        expect(m.contributes_custom_editors[0].priority).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(m.contributes_keybindings.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(m.contributes_keybindings[0].command).to_equal("acme.notes.hello")
        expect(m.contributes_keybindings[0].key).to_equal("ctrl+h")
        expect(m.contributes_keybindings[0].when).to_equal("editorFocus")
        expect(m.contributes_themes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(m.contributes_themes[0].id).to_equal("acme-dark")
        expect(m.contributes_themes[0].ui_theme).to_equal("dark")
        expect(m.contributes_themes[0].path).to_equal("themes/dark.sdn")
        expect(m.contributes_debug_adapters.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(m.contributes_debug_adapters[0].program).to_equal("bin/acme")

    it "reports duplicate command ids as a diagnostic and keeps the first":
        step("Verify: reports duplicate command ids as a diagnostic and keeps the first")
        val source =
            "extension:\n" +
            "  schema: simple.ide.extension/1\n" +
            "  id: demo\n" +
            "  version: 1.0.0\n" +
            "contributes:\n" +
            '  commands: [{id: "demo.run", title: "First"}, {id: "demo.run", title: "Second"}]' + "\n"
        val load = extension_manifest_decode(source)
        expect(load.ok).to_equal(true)
        expect(load.manifest.contributes_commands.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(load.manifest.contributes_commands[0].title).to_equal("First")
        var found = false
        for issue in load.issues:
            if issue.message.contains("duplicate command id 'demo.run'"):
                found = true
        expect(found).to_equal(true)

    it "reports a missing required field with line info from the span map":
        step("Verify: reports a missing required field with line info from the span map")
        val source =
            "extension:\n" +
            "  schema: simple.ide.extension/1\n" +
            "  id: demo\n"
        val load = extension_manifest_decode(source)
        var found_line = -1
        for issue in load.issues:
            if issue.path == "extension.version" and issue.message.contains("missing required field"):
                found_line = issue.line
        expect(found_line).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "collects multiple issues instead of aborting on the first":
        step("Verify: collects multiple issues instead of aborting on the first")
        val source =
            "extension:\n" +
            "  schema: wrong.schema/9\n" +
            "  id: demo\n" +
            "  version: not-a-version\n" +
            "  host: mars\n"
        val load = extension_manifest_decode(source)
        expect(load.ok).to_equal(true)
        expect(load.issues.len() >= 3).to_equal(true)

    it "reports a duplicate key inside a contributed command as a diagnostic with line info":
        step("Verify: reports a duplicate key inside a contributed command as a diagnostic with line info")
        val source =
            "extension:\n" +
            "  schema: simple.ide.extension/1\n" +
            "  id: demo\n" +
            "  version: 1.0.0\n" +
            "contributes:\n" +
            '  commands: [{id: "demo.run", id: "demo.other", title: "First"}]' + "\n"
        val load = extension_manifest_decode(source)
        var found = false
        var found_line = -1
        for issue in load.issues:
            if issue.path == "contributes.commands.0.id" and issue.message.contains("duplicate key"):
                found = true
                found_line = issue.line
        expect(found).to_equal(true)
        expect(found_line).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "still loads legacy quote-style manifests":
        step("Verify: still loads legacy quote-style manifests")
        val source = "{\n" +
            "  \"name\": \"demo-extension\",\n" +
            "  \"version\": \"1.0.0\",\n" +
            "  \"main\": \"main.spl\",\n" +
            "  \"activation_events\": [\"onCommand:demo.hello\"],\n" +
            "  \"contributes_commands\": [{\"id\": \"demo.hello\", \"title\": \"Demo Hello\"}]\n" +
            "}\n"
        val load = extension_manifest_decode(source)
        expect(load.ok).to_equal(true)
        expect(load.manifest.name).to_equal("demo-extension")
        expect(load.manifest.main).to_equal("main.spl")
        expect(load.manifest.activation_events.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(load.manifest.contributes_commands.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(load.manifest.contributes_commands[0].id).to_equal("demo.hello")

    it "rejects empty content with a diagnostic":
        step("Verify: rejects empty content with a diagnostic")
        val load = extension_manifest_decode("")
        expect(load.ok).to_equal(false)
        expect(load.issues.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
