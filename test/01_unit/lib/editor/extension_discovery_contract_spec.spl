# Editor extension discovery contract.

"""
## Purpose and audience
Purpose: Verify editor extension discovery contract.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-EXTENSION-DISCOVERY-CONT-001 — stable requirement identity for this spec.

use std.spec
use std.editor.extensions.host.*
use std.editor.extensions.roots.{editor_extension_roots_from_inputs}
use std.io_runtime.{file_write, dir_create_all}

fn extension_discovery_tmp_root() -> text:
    val root = "build/test/editor_extension_discovery"
    dir_create_all(root + "/demo")
    root

describe "editor extension discovery contract":

    it "discovers and activates a real manifest from an extension root":
        step("Verify: discovers and activates a real manifest from an extension root")
        # @req: REQ-LIB-EXTENSION-DISCOVERY-CONT-001
        val root = extension_discovery_tmp_root()
        val manifest = "{\n" +
            "  \"name\": \"demo-extension\",\n" +
            "  \"version\": \"1.0.0\",\n" +
            "  \"main\": \"main.spl\",\n" +
            "  \"activation_events\": [\"onCommand:demo.hello\"],\n" +
            "  \"contributes_commands\": [{\"id\": \"demo.hello\", \"title\": \"Demo Hello\"}]\n" +
            "}\n"
        expect(file_write(root + "/demo/extension.sdn", manifest)).to_equal(true)

        var host = ExtensionHost.new()
        expect(host.discover_extensions([root])).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.extension_count()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.is_active("demo-extension")).to_equal(false)
        expect(host.command_registered("demo.hello")).to_equal(false)

        expect(host.activate_command("demo.hello")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.is_active("demo-extension")).to_equal(true)
        expect(host.command_registered("demo.hello")).to_equal(true)
        val entry = host.find_command("demo.hello")
        expect(extension_command_entry_name(entry)).to_equal("demo-extension")
        expect(extension_command_entry_command_id(entry)).to_equal("demo.hello")

    it "discovers the embedded IDE example extension manifest":
        step("Verify: discovers the embedded IDE example extension manifest")
        var host = ExtensionHost.new()
        expect(host.discover_extensions(["examples/10_tooling/ide/extensions"])).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.extension_count()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.activate_language("markdown")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.command_registered("markdown.notes.preview")).to_equal(true)
        val entry = host.find_command("markdown.notes.preview")
        expect(extension_command_entry_name(entry)).to_equal("markdown-notes")

    it "resolves the embedded IDE extension runtime entrypoint behind sandbox policy":
        step("Verify: resolves the embedded IDE extension runtime entrypoint behind sandbox policy")
        var host = ExtensionHost.new()
        expect(host.discover_extensions(["examples/10_tooling/ide/extensions"])).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        host.set_runtime_policy(extension_runtime_policy_sandboxed(["examples/10_tooling/ide/extensions"]))
        val invocation = host.dispatch_external_command("markdown.notes.preview", "")
        expect(invocation.status).to_equal("pending-runtime")
        expect(host.drain_invocation_queue()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        val record = host.last_runtime_dispatch()
        expect(record.extension_name).to_equal("markdown-notes")
        expect(record.main).to_equal("examples/10_tooling/ide/extensions/markdown-notes/main.spl")
        expect(record.status).to_equal("ready-sandbox")
        expect(record.reason).to_equal("sandbox runner required")

    # Builtins are lazy, same as the disk-discovered path above:
    # extension_host_with_builtins() == extension_host_with_builtins_indexed()
    # (no eager activate-all loop). Fixed 2026-07-31, was pinned eager here
    # until then. See
    # doc/08_tracking/bug/builtin_extensions_activate_eagerly_2026-07-30.md
    it "registers the built-in sdn-graph language extension lazily, on its declared onLanguage event":
        step("Verify: registers the built-in sdn-graph language extension lazily, on its declared onLanguage event")
        var host = extension_host_with_builtins()
        expect(host.is_active("sdn-graph-language")).to_equal(false)
        expect(host.command_registered("graph.render")).to_equal(false)
        # A matching activation event activates it -- exactly once.
        expect(host.activate_language("sdn-graph")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(host.is_active("sdn-graph-language")).to_equal(true)
        expect(host.command_registered("graph.render")).to_equal(true)
        expect(host.command_registered("graph.showCanonical")).to_equal(true)
        val entry = host.find_command("graph.render")
        expect(extension_command_entry_name(entry)).to_equal("sdn-graph-language")
        # Already active, so the same event activates nothing new.
        expect(host.activate_language("sdn-graph")).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "resolves extension roots with workspace first, then configured, user, system":
        step("Verify: resolves extension roots with workspace first, then configured, user, system")
        val roots = editor_extension_roots_from_inputs("/opt/a:/opt/b", "/home/u")
        expect(roots.contains("/opt/a")).to_equal(true)
        expect(roots.contains("/opt/b")).to_equal(true)
        expect(roots.contains("/home/u/.simple/editor/extensions")).to_equal(true)
        expect(roots.contains("/usr/local/share/simple/editor/extensions")).to_equal(true)
        # Workspace-relative roots are searched before any configured path.
        expect(roots[0]).to_equal(".simple/editor/extensions")

    it "resolves extension roots with no configured path list":
        step("Verify: resolves extension roots with no configured path list")
        val roots = editor_extension_roots_from_inputs("", "/home/u")
        expect(roots.contains("/home/u/.simple/editor/extensions")).to_equal(true)
        expect(roots.contains("/opt/a")).to_equal(false)
