# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-EDITOR-MD-009
# plan: doc/03_plan/app/editor/editor_markdown_editing_subsystem.md

# Markdown editor command dispatch: enter, tab, and the line commands.

use std.spec
use std.spec.step
use std.editor.view.md_editing.{
    md_editor_state_new, md_commands_dispatch
}

describe "markdown command dispatch":

    it "continues a list on enter and starts a bare newline otherwise":
        # @req REQ-EDITOR-MD-009
        step("Enter on a bullet line carries the bullet to the next line")
        val state = md_editor_state_new()
        val bullet = md_commands_dispatch("enter", state, "- item one", 0, 10)
        expect(bullet.status_message).to_equal("list continuation inserted")
        expect(bullet.insert_text).to_equal("\n- ")
        step("Enter on a plain paragraph inserts only the newline")
        val plain = md_commands_dispatch("enter", state, "paragraph", 0, 9)
        expect(plain.status_message).to_equal("newline inserted")
        expect(plain.insert_text).to_equal("\n")

    it "indents on tab and outdents on shift-tab":
        # @req REQ-EDITOR-MD-009
        step("Tab on an unindented paragraph adds the two-space indent unit")
        val state = md_editor_state_new()
        val indented = md_commands_dispatch("tab", state, "paragraph", 0, 0)
        expect(indented.status_message).to_equal("indented")
        expect(indented.replace_line).to_equal("  paragraph")
        step("Shift-tab removes it again")
        val outdented = md_commands_dispatch("shift-tab", state, "  paragraph", 0, 2)
        expect(outdented.status_message).to_equal("outdented")
        expect(outdented.replace_line).to_equal("paragraph")

    it "deletes and duplicates the cursor line":
        # @req REQ-EDITOR-MD-009
        step("Delete line 1 of a three-line document")
        val state = md_editor_state_new()
        val content = "one\ntwo\nthree"
        val deleted = md_commands_dispatch("delete-line", state, content, 1, 0)
        expect(deleted.status_message).to_equal("line deleted")
        expect(deleted.content).to_equal("one\nthree")
        step("Duplicate line 1 of the same document")
        val duplicated = md_commands_dispatch("duplicate-line", state, content, 1, 0)
        expect(duplicated.status_message).to_equal("line duplicated")
        expect(duplicated.content).to_equal("one\ntwo\ntwo\nthree")

    it "moves the cursor line up and down and refuses at the edges":
        # @req REQ-EDITOR-MD-009
        step("Swap line 1 with the line above and below it")
        val state = md_editor_state_new()
        val content = "one\ntwo\nthree"
        val up = md_commands_dispatch("move-up", state, content, 1, 0)
        expect(up.content).to_equal("two\none\nthree")
        val down = md_commands_dispatch("move-down", state, content, 1, 0)
        expect(down.content).to_equal("one\nthree\ntwo")
        step("The first line cannot move up and the last cannot move down")
        expect(md_commands_dispatch("move-up", state, content, 0, 0).status_message).to_equal("line already at top")
        expect(md_commands_dispatch("move-down", state, content, 2, 0).status_message).to_equal("line already at bottom")

    it "cycles heading level and inserts emphasis markers":
        # @req REQ-EDITOR-MD-009
        step("Heading-toggle promotes a paragraph then deepens the heading")
        val state = md_editor_state_new()
        val promoted = md_commands_dispatch("heading-toggle", state, "Title", 0, 0)
        expect(promoted.replace_line).to_equal("# Title")
        val deepened = md_commands_dispatch("heading-toggle", state, "# Title", 0, 0)
        expect(deepened.replace_line).to_equal("## Title")
        step("Bold and italic insert their marker pairs with the cursor between them")
        val bold = md_commands_dispatch("bold", state, "", 0, 0)
        expect(bold.insert_text).to_equal("****")
        expect(bold.cursor_delta_col).to_equal(2)
        val italic = md_commands_dispatch("italic", state, "", 0, 0)
        expect(italic.insert_text).to_equal("**")
        expect(italic.cursor_delta_col).to_equal(1)

    it "accepts the markdown-prefixed spelling of the same command":
        # @req REQ-EDITOR-MD-009
        step("`markdown.delete-line` routes exactly like the bare name")
        val state = md_editor_state_new()
        val prefixed = md_commands_dispatch("markdown.delete-line", state, "one\ntwo", 0, 0)
        expect(prefixed.status_message).to_equal("line deleted")
        expect(prefixed.content).to_equal("two")

    it "echoes an unrecognised command name back unchanged":
        # @req REQ-EDITOR-MD-009
        step("The fallback arm is what the acceptance oracle keys on, so pin it")
        val state = md_editor_state_new()
        val unknown = md_commands_dispatch("no-such-command", state, "one", 0, 0)
        expect(unknown.status_message).to_equal("no-such-command")
