# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: restoring a serialized call-hierarchy selection must fall back to the
current selection when the serialized number is not parseable, not crash or
reset to 0.
Audience: editor and tooling engineers who maintain the LSP result panel.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.editor.view.lsp_result_panel.{
    lsp_result_panel_new,
    lsp_result_panel_select,
    lsp_result_panel_call_state,
    lsp_result_panel_restore_call_state
}

describe "editor LSP result panel numeric guard":
    # @manual scenario evidence
    it "round-trips a valid serialized selection":
        # @req REQ-SSPEC-LIB
        step("Verify: a valid serialized selection restores exactly")
        val panel = lsp_result_panel_select(lsp_result_panel_new("callHierarchy"), 0)
        val restored = lsp_result_panel_restore_call_state(panel, lsp_result_panel_call_state(lsp_result_panel_select(panel, 0)))
        expect(restored.selected).to_equal(panel.selected)  # oracle: round-trip is identity

    it "falls back to the current selection on a non-numeric serialized selection":
        # @req REQ-SSPEC-LIB
        step("Verify: non-numeric serialized selection keeps the current selection")
        val panel = lsp_result_panel_new("callHierarchy")
        val restored = lsp_result_panel_restore_call_state(panel, "callHierarchy|not-a-number")
        expect(restored.selected).to_equal(panel.selected)  # oracle: parse failure must not move the cursor

    it "keeps the current selection when the state has no selection field":
        # @req REQ-SSPEC-LIB
        step("Verify: truncated serialized state is rejected unchanged")
        val panel = lsp_result_panel_new("callHierarchy")
        val restored = lsp_result_panel_restore_call_state(panel, "callHierarchy")
        expect(restored.selected).to_equal(panel.selected)  # oracle: <2 parts returns the panel unchanged
