# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: restoring a serialized call-hierarchy selection must fall back to the
current selection when the serialized number is not parseable, not crash or
reset to 0.
Audience: editor and tooling engineers who maintain the LSP result panel.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.editor.view.lsp_result_panel.{
    lsp_result_panel_new,
    lsp_result_panel_select,
    lsp_result_panel_call_state,
    lsp_result_panel_restore_call_state
}

describe "editor LSP result panel numeric guard":
    it "guards serialized selection parsing":
        val source = rt_file_read_text("src/lib/editor/view/lsp_result_panel.spl") ?? ""

        expect(source).to_contain("val sel = parts[1].to_int() ?? panel.selected")
        expect(source.contains("val sel = parts[1].to_int()\n")).to_equal(false)
