# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-EDITOR-MD-009
# plan: doc/03_plan/app/editor/editor_markdown_editing_subsystem.md

# Markdown table structural edits: add/delete row and column, tab navigation,
# and the auto-format re-pad.

use std.spec
use std.spec.step
use std.editor.view.md_editing.{
    md_table_insert_row_after, md_table_insert_column_after,
    md_table_delete_row, md_table_delete_column, md_table_auto_format,
    md_table_next_cell, md_table_prev_cell, md_table_set_cell
}

describe "markdown table operations":

    it "inserts a row after the cursor row":
        # @req REQ-EDITOR-MD-009
        step("Insert after the body row of a three-line table")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val inserted = md_table_insert_row_after(table, 2)
        expect(inserted.changed).to_equal(true)
        expect(inserted.content.split("\n").len()).to_equal(4)
        expect(inserted.content.split("\n")[3]).to_equal("|  |  |")

    it "deletes the cursor row and refuses to delete the separator":
        # @req REQ-EDITOR-MD-009
        step("Delete the body row, leaving header and separator")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val deleted = md_table_delete_row(table, 2)
        expect(deleted.changed).to_equal(true)
        expect(deleted.content).to_equal("| A | B |\n| --- | --- |")
        step("The separator row is structural and must not be deletable")
        val refused = md_table_delete_row(table, 1)
        expect(refused.changed).to_equal(false)
        expect(refused.message).to_equal("cannot delete the table separator row")

    it "inserts and deletes a column across every row of the table":
        # @req REQ-EDITOR-MD-009
        step("Insert a column after column 0, then delete it again")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val widened = md_table_insert_column_after(table, 0, 2)
        expect(widened.changed).to_equal(true)
        expect(widened.content.split("\n")[0]).to_equal("| A |  | B |")
        val narrowed = md_table_delete_column(widened.content, 0, 6)
        expect(narrowed.changed).to_equal(true)
        expect(narrowed.content.split("\n")[0]).to_equal("| A | B |")

    it "navigates cells forward and backward with tab":
        # @req REQ-EDITOR-MD-009
        step("Hand-count `| A | B |` -- cells start at columns 2 and 6")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val forward = md_table_next_cell(table, 0, 2)
        expect(forward.found).to_equal(true)
        expect(forward.line).to_equal(0)
        expect(forward.col).to_equal(6)
        step("From the last cell of the header, tab skips the separator to the body row")
        val wrapped = md_table_next_cell(table, 0, 6)
        expect(wrapped.found).to_equal(true)
        expect(wrapped.line).to_equal(2)
        val back = md_table_prev_cell(table, 0, 6)
        expect(back.found).to_equal(true)
        expect(back.col).to_equal(2)

    it "auto-format re-pads columns without changing the row count":
        # @req REQ-EDITOR-MD-009
        step("Re-pad a ragged table whose widest first-column cell is 5 characters")
        val ragged = "|A|Beta|\n|---|---|\n|Gamma|B|"
        val formatted = md_table_auto_format(ragged)
        expect(formatted.split("\n").len()).to_equal(3)
        expect(formatted.split("\n")[0]).to_equal("| A     | Beta |")
        expect(formatted.split("\n")[1]).to_equal("| ----- | ---- |")
        expect(formatted.split("\n")[2]).to_equal("| Gamma | B    |")

    it "sets a single cell value in place":
        # @req REQ-EDITOR-MD-009
        step("Write into the second cell of the body row")
        val table = "| A | B |\n| --- | --- |\n| 1 | 2 |"
        val updated = md_table_set_cell(table, 2, 1, "99")
        expect(updated.changed).to_equal(true)
        expect(updated.content.split("\n")[2]).to_equal("| 1 | 99 |")
