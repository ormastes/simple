use std.spec
use std.spec.step
use std.editor.services.command_palette.{
    PaletteEntry,
    command_palette_new,
    command_palette_filter,
}

fn palette_entry(name: text) -> PaletteEntry:
    PaletteEntry(
        description: "",
        name: name,
        command_name: name,
        command_payload: "",
    )

describe "command palette Phase 2 array compatibility":
    it "ranks every matching entry once without Array.remove_at":
        step("Filter and rank three matching entries through the public palette API")
        val palette = command_palette_new([
            palette_entry("open alpha"),
            palette_entry("alpha"),
            palette_entry("close alpha"),
        ])
        val filtered = command_palette_filter(palette, "alpha")

        step("The exact match ranks first and rebuilding the remainder loses no entries")
        expect(filtered.filtered.len()).to_equal(3)
        expect(filtered.filtered[0].name).to_equal("alpha")
        expect(filtered.filtered[1].name == filtered.filtered[2].name).to_equal(false)
