"""
# Editor services declare tuple return arity (stage2 bare-tuple regression)

Regression spec for stage2_bare_tuple_return_type_index_arity_2026-11-07.
A bare `-> tuple` annotation lowers to HIR `Tuple([])`, so indexing the
result is a fatal "tuple index N is out of range for a 0-element tuple" in
MIR. The editor services in the stage3 closure must declare element types.
"""
# @cover src/lib/editor/services/md_sgrid.spl
# @cover src/lib/editor/services/sdn_graph.spl
# @tag:unit
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn bare_tuple_return_lines(src: text) -> text:
    var out = ""
    var n = 0
    for line in src.split("\n"):
        n = n + 1
        if line.trim().starts_with("fn ") and line.contains("-> tuple:"):
            out = out + "{n}: " + line + "\n"
    out

describe "editor services tuple return arity":
    it "md_sgrid helpers declare element types":
        expect(bare_tuple_return_lines(file_read("src/lib/editor/services/md_sgrid.spl"))).to_equal("")

    it "sdn_graph helpers declare element types":
        expect(bare_tuple_return_lines(file_read("src/lib/editor/services/sdn_graph.spl"))).to_equal("")

    it "scanner detects a bare tuple return (non-vacuity)":
        expect(bare_tuple_return_lines("fn a() -> tuple:\n    (1, 2)\n")).to_equal("1: fn a() -> tuple:\n")
