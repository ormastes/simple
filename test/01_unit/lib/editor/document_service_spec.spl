# Document service skeleton + S3 depth: registry open/apply/undo/mark_saved/
# close, multi-view invalidation callbacks, autosave polling, hot exit.
# Covers .claude S3 exit criteria for
# doc/03_plan/app/ide_extension_kernel/parallel_agent_shared_foundation_plan.md.

"""
## Purpose and audience
Purpose: Verify document service skeleton.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-DOCUMENT-SERVICE-001 — stable requirement identity for this spec.

use std.spec
use std.editor.document.model.*
use std.editor.document.transaction.*
use std.editor.document.registry.*
use std.editor.document.traits.*

# ---- module-level capture arrays for view-invalidation callback specs ----
# Nested closures can READ but not MODIFY outer vars (see
# .claude/rules/language.md "Nested closure capture"); top-level fn
# callbacks writing to module-level vars is the working pattern (mirrors
# test/01_unit/compiler/cache/cache_validator_spec.spl's mock helpers).
var view_a_calls: [i64] = []
var view_b_calls: [i64] = []

fn document_spec_view_a_on_invalidate(version: i64):
    view_a_calls = view_a_calls + [version]

fn document_spec_view_b_on_invalidate(version: i64):
    view_b_calls = view_b_calls + [version]

describe "document service skeleton":

    it "opens a document with version 1 and clean state":
        step("Verify: opens a document with version 1 and clean state")
        # @req: REQ-LIB-DOCUMENT-SERVICE-001
        var registry = DocumentRegistry.new()
        val handle = registry.open("file:///a.txt", "hello world")
        expect(handle.uri).to_equal("file:///a.txt")
        expect(handle.version).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect_not(handle.dirty)
        expect(document_handle_content(handle)).to_equal("hello world")
        expect(registry.is_open("file:///a.txt")).to_equal(true)

    it "applying a transaction updates content, bumps version, marks dirty":
        step("Verify: applying a transaction updates content, bumps version, marks dirty")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        val applied = registry.apply("file:///a.txt", document_transaction_new([edit]))
        expect(applied).to_equal(true)
        val handle = registry.get("file:///a.txt")
        expect(document_handle_content(handle)).to_equal("goodbye world")
        expect(handle.version).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(handle.dirty).to_equal(true)

    it "undo restores the previous content and pops the undo stack":
        step("Verify: undo restores the previous content and pops the undo stack")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        val undone = registry.undo("file:///a.txt")
        expect(undone).to_equal(true)
        val handle = registry.get("file:///a.txt")
        expect(document_handle_content(handle)).to_equal("hello world")
        expect(handle.version).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(handle.dirty).to_equal(true)
        expect(handle.undo_stack.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "undo on an empty undo stack is a safe no-op":
        step("Verify: undo on an empty undo stack is a safe no-op")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val undone = registry.undo("file:///a.txt")
        expect_not(undone)

    it "mark_saved clears the dirty flag without changing content":
        step("Verify: mark_saved clears the dirty flag without changing content")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        val saved = registry.mark_saved("file:///a.txt")
        expect(saved).to_equal(true)
        val handle = registry.get("file:///a.txt")
        expect_not(handle.dirty)
        expect(document_handle_content(handle)).to_equal("goodbye world")

    it "close removes the handle":
        step("Verify: close removes the handle")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        registry.close("file:///a.txt")
        expect_not(registry.is_open("file:///a.txt"))
        val handle = registry.get("file:///a.txt")
        expect(handle.version).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

    it "PlainTextCodec round-trips content through the DocumentCodec trait":
        step("Verify: PlainTextCodec round-trips content through the DocumentCodec trait")
        val codec = PlainTextCodec.new()
        expect(codec.probe("file:///a.txt", "raw content")).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        val loaded = match codec.load("raw content"):
            case Ok(text_value): text_value
            case _: "LOAD_FAILED"
        expect(loaded).to_equal("raw content")
        val saved = match codec.save("raw content"):
            case Ok(text_value): text_value
            case _: "SAVE_FAILED"
        expect(saved).to_equal("raw content")

describe "document service depth: multi-view sync":

    it "register_view on an open uri returns a view-kind disposable":
        step("Verify: register_view on an open uri returns a view-kind disposable")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val d = registry.register_view("file:///a.txt", "view-1", document_spec_view_a_on_invalidate)
        expect(d.kind).to_equal("view")

    it "two views on one doc are both notified with the same post-transaction version":
        step("Verify: two views on one doc are both notified with the same post-transaction version")
        view_a_calls = []
        view_b_calls = []
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        registry.register_view("file:///a.txt", "view-1", document_spec_view_a_on_invalidate)
        registry.register_view("file:///a.txt", "view-2", document_spec_view_b_on_invalidate)
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        expect(view_a_calls.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_b_calls.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_a_calls[0]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_b_calls[0]).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        registry.undo("file:///a.txt")
        expect(view_a_calls.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_b_calls.len()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_a_calls[1]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_b_calls[1]).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "dispose_view stops further notifications for that view only":
        step("Verify: dispose_view stops further notifications for that view only")
        view_a_calls = []
        view_b_calls = []
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val d1 = registry.register_view("file:///a.txt", "view-1", document_spec_view_a_on_invalidate)
        registry.register_view("file:///a.txt", "view-2", document_spec_view_b_on_invalidate)
        expect(registry.dispose_view("file:///a.txt", d1.id)).to_equal(true)
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        expect(view_a_calls.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(view_b_calls.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

    it "register_view on a uri that isn't open returns a view-noop disposable":
        step("Verify: register_view on a uri that isn't open returns a view-noop disposable")
        var registry = DocumentRegistry.new()
        val d = registry.register_view("file:///missing.txt", "view-1", document_spec_view_a_on_invalidate)
        expect(d.kind).to_equal("view-noop")

describe "document service depth: autosave":

    it "autosave_pending lists dirty docs whose version-age meets the threshold":
        step("Verify: autosave_pending lists dirty docs whose version-age meets the threshold")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        expect(registry.autosave_pending(1).len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        expect(registry.autosave_pending(3).len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        val pending = registry.autosave_pending(2)
        expect(pending.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(pending[0]).to_equal("file:///a.txt")

    it "mark_autosaved resets the age window without clearing dirty":
        step("Verify: mark_autosaved resets the age window without clearing dirty")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        expect(registry.mark_autosaved("file:///a.txt")).to_equal(true)
        val handle = registry.get("file:///a.txt")
        expect(handle.dirty).to_equal(true)
        expect(registry.autosave_pending(2).len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        registry.apply("file:///a.txt", document_transaction_new(
            [DocumentEdit(start: 0, end_ex: 7, new_text: "later", old_text: "goodbye")]))
        registry.apply("file:///a.txt", document_transaction_new(
            [DocumentEdit(start: 0, end_ex: 5, new_text: "again", old_text: "later")]))
        expect(registry.autosave_pending(2).len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

describe "document service depth: hot exit":

    it "serialize_state/restore_state round-trips dirty content and version":
        step("Verify: serialize_state/restore_state round-trips dirty content and version")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        val edit = DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")
        registry.apply("file:///a.txt", document_transaction_new([edit]))
        registry.open("file:///b.txt", "clean doc")

        val serialized = registry.serialize_state()
        val restore_result = DocumentRegistry.restore_state(serialized)
        var restore_ok = false
        var restored = DocumentRegistry.new()
        match restore_result:
            case Ok(r):
                restored = r
                restore_ok = true
            case Err(_):
                restore_ok = false
        expect(restore_ok).to_equal(true)

        expect(restored.is_open("file:///a.txt")).to_equal(true)
        val a = restored.get("file:///a.txt")
        expect(document_handle_content(a)).to_equal("goodbye world")
        expect(a.version).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(a.dirty).to_equal(true)
        expect(a.undo_stack.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(a.restored_undo_depth).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract

        expect(restored.is_open("file:///b.txt")).to_equal(true)
        val b = restored.get("file:///b.txt")
        expect(document_handle_content(b)).to_equal("clean doc")
        expect(b.version).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(b.dirty).to_equal(false)

    it "a restored document accepts new transactions":
        step("Verify: a restored document accepts new transactions")
        var registry = DocumentRegistry.new()
        registry.open("file:///a.txt", "hello world")
        registry.apply("file:///a.txt", document_transaction_new(
            [DocumentEdit(start: 0, end_ex: 5, new_text: "goodbye", old_text: "hello")]))
        val serialized = registry.serialize_state()
        val restore_result = DocumentRegistry.restore_state(serialized)
        var restored = DocumentRegistry.new()
        match restore_result:
            case Ok(r): restored = r
            case Err(_): pass
        val applied = restored.apply("file:///a.txt", document_transaction_new(
            [DocumentEdit(start: 0, end_ex: 7, new_text: "farewell", old_text: "goodbye")]))
        expect(applied).to_equal(true)
        val handle = restored.get("file:///a.txt")
        expect(document_handle_content(handle)).to_equal("farewell world")
        expect(handle.version).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
