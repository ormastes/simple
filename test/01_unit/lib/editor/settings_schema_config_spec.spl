# IDE settings schema on std.config — lane CFG4.
#
# `src/lib/editor/00.common/settings_schema.spl` used to own a `SettingDescriptor`
# record plus 24 hand-written descriptor literals that restated key/type/default
# for fields the loader schemas already declared, plus verbatim copies of the
# core's category/platform filters and a descriptor search.
#
# This spec pins:
#   1. the UI schema is now `ConfigFieldDescriptor` and is DERIVED, so a default
#      exists exactly once (UI default == loader default for every shared key),
#   2. default resolution, an override layer beating the default, and the
#      mandatory-as-ceiling clamp, driven from the UI schema descriptors,
#   3. the filters/search the editor no longer implements.

"""
## Purpose and audience
Purpose: Verify IDE settings schema routed through std.config.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-SETTINGS-SCHEMA-CONFIG-001 — stable requirement identity for this spec.

use std.spec.{step}
use std.common.config_core.schema.{ConfigFieldDescriptor}
use std.common.config_core.schema.{config_with_ui, config_ui_field, config_empty_field}
use std.common.config_core.schema.{config_int_field, config_schema_index, config_validate_value}
use std.common.config_core.schema.{config_categories, config_search}
use std.common.config_core.schema.{config_filter_by_category, config_filter_by_platform}
use std.common.config_core.layers.{ConfigEntry}
use std.common.config_core.layers.{config_resolve, config_resolve_valid}
use std.editor.common.config.{editor_config_schema}
use std.editor.common.platform.{platform_config_schema}
use std.editor.common.settings_schema.{editor_settings_schema, platform_settings_schema}
use std.editor.common.settings_schema.{keybinding_settings_schema, full_settings_schema}
use std.editor.common.settings_schema.{settings_filter_by_platform, settings_search}

fn ui_field(key: text) -> ConfigFieldDescriptor:
    val schema = editor_settings_schema()
    val idx = config_schema_index(schema, key)
    if idx < 0:
        return config_empty_field()
    schema[idx]

fn loader_field(key: text) -> ConfigFieldDescriptor:
    val schema = editor_config_schema()
    val idx = config_schema_index(schema, key)
    if idx < 0:
        return config_empty_field()
    schema[idx]

describe "IDE settings schema routed through std.config":

    describe "single-sourced defaults":
        it "derives every shared editor key from the loader schema":
            # @req: REQ-LIB-SETTINGS-SCHEMA-CONFIG-001
            step("compare the UI default against the loader default, key by key")
            val loader = editor_config_schema()
            var i = 0
            var mismatches = 0
            while i < loader.len():
                val key = loader[i].key
                if ui_field(key).default_value != loader[i].default_value:
                    mismatches = mismatches + 1
                i = i + 1
            expect(loader.len()).to_equal(10)  # oracle: authoritative expected value documented by this spec's contract
            expect(mismatches).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "keeps the exact defaults the hand-written UI schema declared":
            step("Verify: keeps the exact defaults the hand-written UI schema declared")
            expect(ui_field("theme").default_value).to_equal("dark")
            expect(ui_field("font_size").default_value).to_equal("14")
            expect(ui_field("tab_size").default_value).to_equal("4")
            expect(ui_field("insert_spaces").default_value).to_equal("true")
            expect(ui_field("word_wrap").default_value).to_equal("false")
            expect(ui_field("line_numbers").default_value).to_equal("true")
            expect(ui_field("minimap").default_value).to_equal("false")
            expect(ui_field("auto_save").default_value).to_equal("false")
            expect(ui_field("auto_save_delay_ms").default_value).to_equal("30000")
            expect(ui_field("hover_delay_ms").default_value).to_equal("300")

        it "carries the loader minimum through into the UI descriptor":
            step("font_size had an open-coded n > 0 guard; it is now declared")
            expect(loader_field("font_size").has_min).to_equal(true)
            expect(ui_field("font_size").has_min).to_equal(true)
            expect(ui_field("font_size").min_value).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(ui_field("hover_delay_ms").min_value).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "keeps the UI metadata the settings panel renders":
            step("Verify: keeps the UI metadata the settings panel renders")
            expect(ui_field("font_size").label).to_equal("Font Size")
            expect(ui_field("font_size").category).to_equal("Appearance")
            expect(ui_field("tab_size").category).to_equal("Editor")
            expect(ui_field("minimap").platform).to_equal("desktop")
            expect(ui_field("auto_save").category).to_equal("Files")

        it "presents theme as an enum even though the loader accepts free text":
            step("Verify: presents theme as an enum even though the loader accepts free text")
            expect(loader_field("theme").value_type).to_equal("text")
            expect(ui_field("theme").value_type).to_equal("enum")
            expect(ui_field("theme").enum_options.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(ui_field("theme").enum_options[0]).to_equal("dark")
            expect(ui_field("theme").enum_options[1]).to_equal("light")
            expect(ui_field("theme").enum_options[2]).to_equal("solarized")

        it "derives the platform rows from platform_config_schema":
            step("Verify: derives the platform rows from platform_config_schema")
            val platform_ui = platform_settings_schema()
            expect(platform_ui.len()).to_equal(6)  # oracle: authoritative expected value documented by this spec's contract
            val loader = platform_config_schema()
            val li = config_schema_index(loader, "max_open_files")
            val ui = config_schema_index(platform_ui, "max_open_files")
            expect(loader[li].default_value).to_equal("256")
            expect(platform_ui[ui].default_value).to_equal("256")
            expect(platform_ui[ui].label).to_equal("Max Open Files")

    describe "resolution from the UI descriptors":
        it "resolves the compiled default when no layer contributes":
            step("Verify: resolves the compiled default when no layer contributes")
            val resolved = config_resolve(ui_field("font_size"), [])
            expect(resolved.value).to_equal("14")
            expect(resolved.layer).to_equal("compiled_default")
            expect(resolved.rank).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(resolved.locked).to_equal(false)

        it "lets a user layer beat the compiled default":
            step("the user settings document sets font_size: 18")
            val entries = [ConfigEntry(key: "font_size", value: "18", layer: "user")]
            val resolved = config_resolve(ui_field("font_size"), entries)
            expect(resolved.value).to_equal("18")
            expect(resolved.layer).to_equal("user")
            expect(resolved.rank).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(resolved.locked).to_equal(false)

        it "lets workspace beat user for the theme row":
            step("Verify: lets workspace beat user for the theme row")
            val entries = [
                ConfigEntry(key: "theme", value: "light", layer: "user"),
                ConfigEntry(key: "theme", value: "solarized", layer: "workspace")
            ]
            val resolved = config_resolve(ui_field("theme"), entries)
            expect(resolved.value).to_equal("solarized")
            expect(resolved.layer).to_equal("workspace")
            expect(resolved.rank).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract

    describe "mandatory policy is a ceiling":
        it "pins a mandatory value even when a later session entry raises it":
            step("policy caps font_size at 12; a session document asks for 72")
            val entries = [
                ConfigEntry(key: "font_size", value: "12", layer: "mandatory"),
                ConfigEntry(key: "font_size", value: "72", layer: "session")
            ]
            val resolved = config_resolve(ui_field("font_size"), entries)
            expect(resolved.value).to_equal("12")
            expect(resolved.layer).to_equal("mandatory")
            expect(resolved.rank).to_equal(9)  # oracle: authoritative expected value documented by this spec's contract
            expect(resolved.locked).to_equal(true)

        it "clamps an over-limit value declared by a max constraint":
            step("a policy schema caps font_size at 24; 72 is above the maximum")
            val capped = ConfigFieldDescriptor(
                key: "font_size",
                label: "Font Size",
                description: "",
                category: "Appearance",
                value_type: "i64",
                default_value: "14",
                enum_options: [],
                platform: "all",
                min_value: 1,
                max_value: 24,
                has_min: true,
                has_max: true
            )
            val verdict = config_validate_value(capped, "72")
            expect(verdict.ok).to_equal(false)
            expect(verdict.code).to_equal("above_max")
            step("resolution drops the over-limit entry and keeps the lower layer")
            val entries = [
                ConfigEntry(key: "font_size", value: "18", layer: "user"),
                ConfigEntry(key: "font_size", value: "72", layer: "session")
            ]
            val resolved = config_resolve_valid(capped, entries)
            expect(resolved.value).to_equal("18")
            expect(resolved.layer).to_equal("user")

        it "keeps a below-minimum entry from displacing the default":
            step("font_size: 0 fails the n > 0 guard the loader schema declares")
            val entries = [ConfigEntry(key: "font_size", value: "0", layer: "user")]
            val resolved = config_resolve_valid(ui_field("font_size"), entries)
            expect(resolved.value).to_equal("14")
            expect(resolved.layer).to_equal("compiled_default")

    describe "filters and search now come from the core":
        it "filters by category":
            step("Verify: filters by category")
            val appearance = config_filter_by_category(editor_settings_schema(), "Appearance")
            expect(appearance.len()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
            expect(appearance[0].key).to_equal("theme")

        it "filters by platform, keeping the all-platform rows":
            step("Verify: filters by platform, keeping the all-platform rows")
            val simpleos = settings_filter_by_platform(full_settings_schema(), "simpleos")
            expect(simpleos.len()).to_equal(20)  # oracle: authoritative expected value documented by this spec's contract
            expect(config_schema_index(simpleos, "minimap")).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract
            expect(config_schema_index(simpleos, "file_watcher_enabled")).to_equal(-1)  # oracle: authoritative expected value documented by this spec's contract
            expect(config_schema_index(simpleos, "theme")).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract

        it "searches key, label and description":
            step("Verify: searches key, label and description")
            val hits = settings_search(editor_settings_schema(), "minimap")
            expect(hits.len()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(hits[0].key).to_equal("minimap")

        it "derives the distinct category list in declaration order":
            step("Verify: derives the distinct category list in declaration order")
            val cats = config_categories(full_settings_schema())
            expect(cats.len()).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
            expect(cats[0]).to_equal("Appearance")
            expect(cats[1]).to_equal("Editor")
            expect(cats[2]).to_equal("Files")
            expect(cats[3]).to_equal("Keybindings")
            expect(cats[4]).to_equal("Platform")

    describe "keybinding rows are generated":
        it "renders label and description from the bound command":
            step("Verify: renders label and description from the bound command")
            val binds = keybinding_settings_schema()
            expect(binds.len()).to_equal(7)  # oracle: authoritative expected value documented by this spec's contract
            expect(binds[0].key).to_equal("bind.h")
            expect(binds[0].label).to_equal("move-left")
            expect(binds[0].default_value).to_equal("h")
            expect(binds[0].description).to_equal("Key: h → Command: move-left (mode: normal)")
            expect(binds[0].category).to_equal("Keybindings")
            expect(binds[5].key).to_equal("bind.colon")
            expect(binds[5].default_value).to_equal(":")
            expect(binds[5].label).to_equal("enter-command")

    describe "the empty descriptor the settings view used to open-code":
        it "reports empty strings and no options":
            step("Verify: reports empty strings and no options")
            val empty = config_empty_field()
            expect(empty.key).to_equal("")
            expect(empty.label).to_equal("")
            expect(empty.value_type).to_equal("")
            expect(empty.enum_options.len()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
            expect(empty.has_min).to_equal(false)

    describe "config_with_ui preserves loader facts":
        it "keeps key, type, default and range while replacing metadata":
            step("Verify: keeps key, type, default and range while replacing metadata")
            val base = config_int_field(key: "tab_size", default_value: "4", min_value: 1)
            val decorated = config_with_ui(base, "Tab Size", "Spaces per tab", "Editor", [], "all")
            expect(decorated.key).to_equal("tab_size")
            expect(decorated.value_type).to_equal("i64")
            expect(decorated.default_value).to_equal("4")
            expect(decorated.min_value).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
            expect(decorated.has_min).to_equal(true)
            expect(decorated.label).to_equal("Tab Size")
            expect(decorated.category).to_equal("Editor")
