use nogc_sync_mut.config_parser.{ConfigSection, get_config_float}

describe("config parser concrete f64 conversion"):
    it("parses decimal configuration values"):
        val section = ConfigSection(name: "float", fields: {"ratio": "1.25"})
        expect(get_config_float(section, "ratio", 9.5)).to_equal(1.25)

    it("returns the supplied default for a missing value"):
        val section = ConfigSection(name: "float", fields: {})
        expect(get_config_float(section, "missing", 7.0)).to_equal(7.0)

    it("returns the supplied default for malformed nonempty input"):
        val section = ConfigSection(name: "float", fields: {"ratio": "not-a-number"})
        expect(get_config_float(section, "ratio", 9.5)).to_equal(9.5)
