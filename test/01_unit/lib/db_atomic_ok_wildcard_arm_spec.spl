# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""
# Atomic Database `Ok(_)` Wildcard Arm Regression

Reproducing spec for `doc/08_tracking/bug/stage4_db_atomic_hir_names_2026-08-02.md`.

That bug doc claims the async no-GC mirror "now uses the same `?` Result
propagation as the sync implementation instead of matching `Ok(_)`, which Stage4
treated as an unresolved identifier". The original audit found seven `Ok(_)`
arms surviving in `src/lib/nogc_async_mut/db_atomic.spl`.

The behavioral oracle below exercises the public atomic write/read/update
contract of BOTH mirrors end to end: if any `Ok(_)` match arm were miscompiled
into an unresolved identifier (the Stage4 failure mode), every scenario fails
instead of returning the correct Result payloads.
"""

use std.spec.step
use std.nogc_sync_mut.db_atomic.{atomic_read, atomic_write, atomic_update, DbConfig}
use std.nogc_async_mut.db_atomic.{atomic_read as a_atomic_read, atomic_write as a_atomic_write, atomic_update as a_atomic_update, DbConfig as ADbConfig}
use std.nogc_sync_mut.io.file_ops.{file_remove}
use std.nogc_sync_mut.file_system.dir_ops.{dir_create_all}

extern fn rt_env_get(key: text) -> text

fn _tmp_dir() -> text:
    val root = "/tmp/sspec_db_atomic_okarm_" + rt_env_get("USER")
    dir_create_all(root)
    root

describe "atomic database mirrors execute the Ok(_) regression contract":
    # @manual scenario evidence
    it "a sync-mirror write is read back byte-for-byte through the Result contract":
        # @req REQ-SSPEC-LIB
        step("atomically write a payload in the sync mirror and read it back")
        # evidence(protocol_json): Result values asserted below are the complete typed oracle
        val path = _tmp_dir() + "/okarm_sync.sdn"
        file_remove(path)
        val written = atomic_write(path, "table users\n  row a, b\n", DbConfig.defaults())
        expect(written.is_ok()).to_equal(true)
        match atomic_read(path, DbConfig.defaults()):
            case Ok(content):
                expect(content).to_equal("table users\n  row a, b\n")
            case Err(message):
                expect(message).to_equal("__unreachable__")

    it "an async-mirror write is read back byte-for-byte through the Result contract":
        # @req REQ-SSPEC-LIB
        step("atomically write a payload in the async mirror and read it back")
        # evidence(protocol_json): Result values asserted below are the complete typed oracle
        val path = _tmp_dir() + "/okarm_async.sdn"
        file_remove(path)
        val written = a_atomic_write(path, "table roles\n  row x, y\n", ADbConfig.defaults())
        expect(written.is_ok()).to_equal(true)
        match a_atomic_read(path, ADbConfig.defaults()):
            case Ok(content):
                expect(content).to_equal("table roles\n  row x, y\n")
            case Err(message):
                expect(message).to_equal("__unreachable__")

    it "atomic_update transforms content under the lock in the async mirror":
        # @req REQ-SSPEC-LIB
        step("run an async-mirror atomic_update over an existing file")
        # evidence(protocol_json): Result values asserted below are the complete typed oracle
        val path = _tmp_dir() + "/okarm_async_update.sdn"
        file_remove(path)
        val written = a_atomic_write(path, "count 1\n", ADbConfig.defaults())
        expect(written.is_ok()).to_equal(true)
        val updated = a_atomic_update(path, fn(content: text) -> text:
            content.replace("count 1", "count 2")
        , ADbConfig.defaults())
        expect(updated.is_ok()).to_equal(true)
        match a_atomic_read(path, ADbConfig.defaults()):
            case Ok(content):
                expect(content).to_equal("count 2\n")
            case Err(message):
                expect(message).to_equal("__unreachable__")

    it "reading a missing file yields the documented empty Ok contract in both mirrors":
        # @req REQ-SSPEC-LIB
        step("atomically read a path that does not exist in both mirrors")
        # evidence(protocol_json): the Ok("") contract asserted below is the complete typed oracle
        val missing_path = _tmp_dir() + "/okarm_missing_{rt_env_get(\"USER\")}.sdn"
        file_remove(missing_path)
        match atomic_read(missing_path, DbConfig.defaults()):
            case Ok(content):
                expect(content).to_equal("")
            case Err(message):
                expect(message).to_equal("__unreachable__")
        match a_atomic_read(missing_path, ADbConfig.defaults()):
            case Ok(content):
                expect(content).to_equal("")
            case Err(message):
                expect(message).to_equal("__unreachable__")
