# @req: REQ-GEN-LIB-001

"""
# Atomic Database HIR Contract

Locks concrete runtime owners and native-safe Result propagation in both
no-GC database mirrors.
"""

extern fn rt_file_read_text(path: text) -> text?

fn check_owner_imports(source: text):
    expect(source).to_contain("use std.nogc_sync_mut.io.file_ops.\{file_exists, file_read, file_atomic_write, file_copy, file_lock, file_unlock\}")
    expect(source).to_contain("use std.nogc_sync_mut.io.sysinfo_ops.\{getpid\}")
    expect(source).to_contain("use std.nogc_sync_mut.io.time_ops.\{time_now_unix_micros\}")
    expect(source.contains("use std.io (file_exists")).to_equal(false)

fn check_native_safe_row_serialization(source: text):
    expect(source).to_contain("row.map(\\value:")
    expect(source).to_contain("value.contains(\",\") or value.contains(\" \")")
    expect(source.contains("_.contains(\",\") or _.contains(\" \")")).to_equal(false)
    expect(source.contains("\"\\\"\{_\}\\\"\"")).to_equal(false)

use std.spec.step

describe "atomic database HIR contract":
    it "uses concrete owners and Result propagation in the async mirror":
        # @req: REQ-GEN-LIB-001
        step("Verify: uses concrete owners and Result propagation in the async mirror")
        val source = rt_file_read_text("src/lib/nogc_async_mut/db_atomic.spl") ?? ""
        check_owner_imports(source)
        check_native_safe_row_serialization(source)
        expect(source).to_contain("val lock = FileLock.acquire(path, config.lock_timeout_secs)?")
        expect(source.contains("Ok(_): return Err(\"Failed to acquire lock without error\")")).to_equal(false)

    it "uses the same concrete owners in the sync mirror":
        # @req: REQ-GEN-LIB-001
        step("Verify: uses the same concrete owners in the sync mirror")
        val source = rt_file_read_text("src/lib/nogc_sync_mut/db_atomic.spl") ?? ""
        check_owner_imports(source)
        check_native_safe_row_serialization(source)
        expect(source).to_contain("val lock = FileLock.acquire(path, config.lock_timeout_secs)?")
