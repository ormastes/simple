# Per-file revision reuse: a new revision reuses the verified content object
# of the published revision for every inventory row it shares, re-reading no
# source. Since 2026-11-13 a materialized row is a HARD LINK to its sealed
# (0444) content-addressed chunk, not a copy, so these pin: the shared inode,
# that the seal refuses an in-place write through any name, that a replaced
# or absent chunk is a miss, that a corrupt chunk is repaired through a new
# inode, and that the copy fallback never writes over an existing destination.
# The fixture publishes through the production materializer so it carries the
# production topology (chunk + linked row), never two independent files.
use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use std.scv.compile_snapshot.{
    scv_compile_snapshot_reuse_marks_v1, scv_compile_snapshot_reuse_source_v1,
    scv_compile_snapshot_materialize_source_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1}
use app.io.mod.{dir_create, file_exists, file_delete, file_hash_sha256, process_run}
use app.io.file_ops.{path_absolute}
use std.nogc_sync_mut.io_runtime.{getpid}
use std.nogc_sync_mut.io.file_ops.{file_write_bytes}
use std.common.text_bytes.{text_to_utf8_bytes}

fn reuse_root(label: text) -> text:
    path_absolute("build/test-artifacts/snapshot-reuse-{getpid()}-{label}").replace("\\", "/")

# Inode of a path as the host reports it; "" when unavailable so two missing
# files never compare equal. Linux-only observation (`stat -c %i`).
fn reuse_inode(path: text) -> text:
    val (out, _err, code) = process_run("stat", ["-c", "%i", path])
    if code != 0: return ""
    out.trim()

fn reuse_entry(relative: text, content: text) -> CompileSourceInventoryEntryV1:
    val digest = sha256_text(content)
    CompileSourceInventoryEntryV1(relative, digest, digest, digest, digest, digest, content.len())

fn reuse_chunk(root: text, content: text) -> text:
    "{root}/build/scv/objects/chunks/sha256_{sha256_text(content)}.blob"

# Function-level fixture: a checkout root whose working file holds `source`, a
# cache root whose chunk store and `published` revision were produced by the
# production materializer from `published` bytes, and a fresh staging dir.
# Byte writes only: app.io.mod.file_write returns false under the test lane
# (measured 2026-10-19, tracked-seed-3d9d) while file_write_bytes succeeds.
fn reuse_unit_fixture(root: text, relative: text, source: text, published: text) -> bool:
    if not dir_create("{root}/src", true): return false
    if not dir_create("{root}/build/scv/snapshots/published", true): return false
    if not dir_create("{root}/staging", true): return false
    if not file_write_bytes("{root}/{relative}", text_to_utf8_bytes(published)): return false
    val made = scv_compile_snapshot_materialize_source_v1(root, "{root}/build/scv",
        "{root}/build/scv/snapshots/published", reuse_entry(relative, published))
    if made.reason != "ok": return false
    # The working-copy edit the inventory does not know about.
    file_write_bytes("{root}/{relative}", text_to_utf8_bytes(source))

fn reuse_once(root: text, relative: text, content: text) -> text:
    scv_compile_snapshot_reuse_source_v1(root, "{root}/build/scv", "{root}/staging",
        "{root}/build/scv/snapshots/published", reuse_entry(relative, content)).reason

describe "SCV snapshot revision reuse (per-file)":
    it "marks exactly the planned rows a published inventory shares, by exact row":
        val planned = ["src/a.spl|sha256_1|3", "src/b.spl|sha256_2|4", "src/c.spl|sha256_3|5"]
        val published = ["src/a.spl|sha256_1|3", "src/b.spl|sha256_9|4", "src/d.spl|sha256_3|5"]
        expect(scv_compile_snapshot_reuse_marks_v1(planned, published)).to_equal([true, false, false])
        expect(scv_compile_snapshot_reuse_marks_v1(planned, [])).to_equal([false, false, false])

    it "links a reused row to its content-addressed chunk with no source read":
        val root = reuse_root("unit-link")
        val content = "# published\nfn kept() -> i64:\n    1\n"
        # The working file differs at equal length: a source read would refuse it.
        val edited = "# published\nfn kept() -> i64:\n    2\n"
        expect(reuse_unit_fixture(root, "src/kept.spl", edited, content)).to_equal(true)
        val result = scv_compile_snapshot_reuse_source_v1(root, "{root}/build/scv", "{root}/staging",
            "{root}/build/scv/snapshots/published", reuse_entry("src/kept.spl", content))
        expect(result.reason).to_equal("ok")
        expect(result.row).to_equal("src/kept.spl|sha256_{sha256_text(content)}|{content.len()}")
        expect(result.source_drifted).to_equal(false)
        expect(file_hash_sha256("{root}/staging/src/kept.spl").unwrap()).to_equal(sha256_text(content))
        expect(reuse_inode("{root}/staging/src/kept.spl")).to_equal(reuse_inode(reuse_chunk(root, content)))

    it "misses when the working file's length no longer matches the admitted row":
        val root = reuse_root("unit-size")
        val content = "# published\n"
        expect(reuse_unit_fixture(root, "src/kept.spl", content + "# longer\n", content)).to_equal(true)
        expect(reuse_once(root, "src/kept.spl", content)).to_equal("snapshot-reuse-miss:src/kept.spl")
        expect(file_exists("{root}/staging/src/kept.spl")).to_equal(false)

    it "seals the chunk: an in-place write through a published row is refused and every name keeps the admitted bytes":
        val root = reuse_root("unit-sealed")
        val content = "# published\n"
        expect(reuse_unit_fixture(root, "src/kept.spl", content, content)).to_equal(true)
        expect(file_write_bytes("{root}/build/scv/snapshots/published/src/kept.spl", text_to_utf8_bytes("# tampered\n"))).to_equal(false)
        expect(file_write_bytes(reuse_chunk(root, content), text_to_utf8_bytes("# tampered\n"))).to_equal(false)
        expect(file_hash_sha256("{root}/build/scv/snapshots/published/src/kept.spl").unwrap()).to_equal(sha256_text(content))
        expect(file_hash_sha256(reuse_chunk(root, content)).unwrap()).to_equal(sha256_text(content))
        expect(reuse_once(root, "src/kept.spl", content)).to_equal("ok")

    it "misses when the chunk was replaced by an object that does not hash to the row, or is absent":
        val root = reuse_root("unit-chunk")
        val content = "# published\n"
        expect(reuse_unit_fixture(root, "src/kept.spl", content, content)).to_equal(true)
        # A replacement through a NEW inode is the only way past the seal.
        expect(file_delete(reuse_chunk(root, content))).to_equal(true)
        expect(file_write_bytes(reuse_chunk(root, content), text_to_utf8_bytes("# other\n"))).to_equal(true)
        expect(reuse_once(root, "src/kept.spl", content)).to_equal("snapshot-reuse-miss:src/kept.spl")
        expect(file_exists("{root}/staging/src/kept.spl")).to_equal(false)
        expect(reuse_once(root, "src/absent.spl", content)).to_equal("snapshot-reuse-miss:src/absent.spl")

    it "links a freshly materialized row to the sealed chunk it just published":
        val root = reuse_root("unit-fresh")
        val content = "# fresh\nfn fresh() -> i64:\n    1\n"
        expect(dir_create("{root}/src", true)).to_equal(true)
        expect(dir_create("{root}/staging", true)).to_equal(true)
        expect(file_write_bytes("{root}/src/fresh.spl", text_to_utf8_bytes(content))).to_equal(true)
        val result = scv_compile_snapshot_materialize_source_v1(root, "{root}/build/scv", "{root}/staging",
            reuse_entry("src/fresh.spl", content))
        expect(result.reason).to_equal("ok")
        expect(file_hash_sha256("{root}/staging/src/fresh.spl").unwrap()).to_equal(sha256_text(content))
        expect(reuse_inode("{root}/staging/src/fresh.spl")).to_equal(reuse_inode(reuse_chunk(root, content)))
        expect(file_write_bytes(reuse_chunk(root, content), text_to_utf8_bytes("# tampered\n"))).to_equal(false)

    it "repairs a corrupt chunk through a new inode instead of failing every later revision":
        val root = reuse_root("unit-repair")
        val content = "# published\n"
        expect(reuse_unit_fixture(root, "src/kept.spl", content, content)).to_equal(true)
        expect(file_delete(reuse_chunk(root, content))).to_equal(true)
        expect(file_write_bytes(reuse_chunk(root, content), text_to_utf8_bytes("# corrupt\n"))).to_equal(true)
        val corrupt_inode = reuse_inode(reuse_chunk(root, content))
        val result = scv_compile_snapshot_materialize_source_v1(root, "{root}/build/scv", "{root}/staging",
            reuse_entry("src/kept.spl", content))
        expect(result.reason).to_equal("ok")
        expect(file_hash_sha256(reuse_chunk(root, content)).unwrap()).to_equal(sha256_text(content))
        expect(reuse_inode(reuse_chunk(root, content)) != corrupt_inode).to_equal(true)
        expect(reuse_inode("{root}/staging/src/kept.spl")).to_equal(reuse_inode(reuse_chunk(root, content)))

    it "never writes over a pre-existing destination when the link is refused":
        val root = reuse_root("unit-noclobber")
        val content = "# published\n"
        val other = "# already here\n"
        expect(dir_create("{root}/src", true)).to_equal(true)
        expect(dir_create("{root}/staging/src", true)).to_equal(true)
        expect(file_write_bytes("{root}/src/kept.spl", text_to_utf8_bytes(content))).to_equal(true)
        expect(file_write_bytes("{root}/staging/src/kept.spl", text_to_utf8_bytes(other))).to_equal(true)
        val result = scv_compile_snapshot_materialize_source_v1(root, "{root}/build/scv", "{root}/staging",
            reuse_entry("src/kept.spl", content))
        expect(result.reason).to_equal("snapshot-materialize-failed:src/kept.spl")
        expect(file_hash_sha256("{root}/staging/src/kept.spl").unwrap()).to_equal(sha256_text(other))
