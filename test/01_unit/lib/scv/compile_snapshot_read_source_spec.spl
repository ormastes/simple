use std.spec.*
use std.scv.compile_snapshot.{scv_compile_snapshot_read_source_v1, scv_compile_snapshot_source_digest_v1}
use std.scv.compile_snapshot_values_v1.{scv_compile_snapshot_read_text_v1}

describe "SCV snapshot source reads":
    it "returns raw bytes and the admitted digest for generated logging config":
        val path = "build/os/generated/generated/simpleos_log_config.spl"
        val bytes = scv_compile_snapshot_read_source_v1(path)
        expect(bytes == nil).to_equal(false)
        expect(bytes!.len()).to_equal(216)
        expect(scv_compile_snapshot_source_digest_v1(path)).to_equal(
            "sha256_36e3b10b50a2c8ffb3805dfd681da4119d0febfc5a3f306716dfc0502462ed0d")
        expect(scv_compile_snapshot_read_text_v1(path)).to_contain(
            "fn simpleos_log_compile_mode_name() -> text:")
