# Pins scv_split_parent_ids: merge commits/operations store `parents:` space-joined;
# legacy objects used commas. Every reader must accept both.
# Bug: scv_merge_commit_parents_separator_inconsistent_2026-08-26
use std.spec.{describe, it, expect}
use std.scv.core.{scv_split_parent_ids}

describe "scv_split_parent_ids":
    it "splits a space-joined merge parent field":
        val ids = scv_split_parent_ids("op_a op_b")
        expect(ids.len()).to_equal(2)
        expect(ids[0]).to_equal("op_a")
        expect(ids[1]).to_equal("op_b")
    it "still accepts legacy comma-joined parents":
        val ids = scv_split_parent_ids("op_a,op_b")
        expect(ids.len()).to_equal(2)
        expect(ids[1]).to_equal("op_b")
    it "tolerates mixed separators and blanks":
        val ids = scv_split_parent_ids(" op_a, op_b  op_c ,")
        expect(ids.len()).to_equal(3)
        expect(ids[2]).to_equal("op_c")
    it "returns empty for an empty field":
        expect(scv_split_parent_ids("").len()).to_equal(0)
