# @cover src/lib/scv/gateway_draft_protocol_v1.spl 80%
use std.spec.*
use std.scv.gateway_draft_protocol_v1.*
use std.common.crypto.sha256.{sha256_u8_hex}

fn draft_protocol_put_v1(bytes: [u8]) -> ScvGatewayDraftRequestV1:
    ScvGatewayDraftRequestV1(version: 1, id: "wire-1", repository: "repo-alpha",
        method: "put", request_id: "retry-1", content_sha256: sha256_u8_hex(bytes), bytes: bytes)

describe "SCV native draft transfer protocol v1":
    it "round trips binary payload bytes through canonical bounded SDN":
        val request = draft_protocol_put_v1([0u8, 255u8, 65u8, 128u8])
        val wire = scv_gateway_draft_request_encode_v1(request, "repo-alpha").unwrap()
        val decoded = scv_gateway_draft_request_decode_v1(wire).unwrap()
        expect(decoded).to_equal(request)
        expect(wire).to_contain("payload_encoding:")

    it "rejects malformed digest and unsupported request method":
        var request = draft_protocol_put_v1([1u8])
        request.content_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        expect(scv_gateway_draft_request_encode_v1(request, "repo-alpha").is_err()).to_equal(true)
        request = draft_protocol_put_v1([1u8])
        request.method = "publish"
        expect(scv_gateway_draft_request_encode_v1(request, "repo-alpha").is_err()).to_equal(true)

    it "rejects noncanonical base64 pad bits even when they decode to the same byte":
        val request = draft_protocol_put_v1([1u8])
        val wire = scv_gateway_draft_request_encode_v1(request, "repo-alpha").unwrap()
        expect(wire.contains("AQ==")).to_equal(true)
        expect(scv_gateway_draft_request_decode_v1(wire.replace("AQ==", "AR==")).is_err()).to_equal(true)

    it "enforces exact repository pin and request size before transport":
        val request = draft_protocol_put_v1([1u8])
        expect(scv_gateway_draft_request_encode_v1(request, "repo-beta").is_err()).to_equal(true)
        var too_large: [u8] = []
        for index in 0..1048577:
            too_large.push(0u8)
        val bounded = draft_protocol_put_v1(too_large)
        expect(scv_gateway_draft_request_encode_v1(bounded, "repo-alpha").is_err()).to_equal(true)

    it "binds durable receipts to the exact server principal and byte count":
        val request = draft_protocol_put_v1([0u8, 255u8, 65u8])
        val receipt = ScvGatewayDraftResponseV1(version: 1, id: "wire-1", repository: "repo-alpha",
            principal_id: "principal-1", method: "put", request_id: "retry-1", status: "ok",
            content_sha256: request.content_sha256, byte_count: 3, state: "local_durable", payload: [], error: "")
        val wire = scv_gateway_draft_response_encode_v1(receipt, request, "repo-alpha", "principal-1").unwrap()
        expect(scv_gateway_draft_response_decode_v1(wire, request, "repo-alpha", "principal-1").unwrap()).to_equal(receipt)
        expect(scv_gateway_draft_response_decode_v1(wire, request, "repo-alpha", "principal-2").is_err()).to_equal(true)
        var forged = receipt
        forged.byte_count = 2
        expect(scv_gateway_draft_response_encode_v1(forged, request, "repo-alpha", "principal-1").is_err()).to_equal(true)
