# Deterministic publisher interleaving: A renames its verified directory,
# B acquires before A publishes the receipt, then A finishes publication.
# No threads, sleeps, production hooks, live cache or forged admission flags.
use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use std.common.text_bytes.{text_to_utf8_bytes}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1, CompileSourceInventoryV1, compile_source_inventory_git_event_v1, compile_source_inventory_apply_event_v1}
use std.scv.compile_source_inventory.{compile_source_inventory_publish_v1}
use std.scv.compile_snapshot.{scv_compile_snapshot_materialize_source_v1, scv_compile_snapshot_revision_id_v1, scv_compile_snapshot_provenance_v1, scv_compile_snapshot_receipt_v1, scv_compile_snapshot_acquire_v1}
use app.io.mod.{dir_create, file_exists}
use app.io.file_ops.{path_absolute}
use std.nogc_sync_mut.io.file_ops.{file_write_bytes, secure_temp_dir_raw}
use std.nogc_sync_mut.io_runtime.{file_rename, file_hash_sha256, dir_remove}
use std.nogc_sync_mut.sffi.fs.{file_create_excl}

val GAP_CONTENT = "fn sample(): 17\n"
extern fn rt_getpid() -> i64

struct ScvGapFixtureV1:
    root: text
    cache: text
    destination: text
    revision: text
    provenance: text

fn gap_write(path: text, content: text) -> bool:
    file_write_bytes(path, text_to_utf8_bytes(content))

fn gap_fixture() -> ScvGapFixtureV1:
    expect(dir_create("build/test-artifacts", true)).to_equal(true)
    val owned = secure_temp_dir_raw("build/test-artifacts", "scv-publication-gap-")
    expect(owned == "").to_equal(false)
    val root = path_absolute(owned).replace("\\", "/")
    val cache = root + "/build/scv"
    expect(dir_create(root + "/src", true)).to_equal(true)
    expect(dir_create(cache + "/snapshots", true)).to_equal(true)
    expect(gap_write(root + "/src/a.spl", GAP_CONTENT)).to_equal(true)
    val event = compile_source_inventory_git_event_v1("create", "src/a.spl", GAP_CONTENT)
    val applied = compile_source_inventory_apply_event_v1(CompileSourceInventoryV1(1, 0, []), event)
    expect(applied.valid).to_equal(true)
    val published = compile_source_inventory_publish_v1(cache, applied.inventory!)
    expect(published == "").to_equal(false)
    val entry = CompileSourceInventoryEntryV1(event.source_identity, event.content_digest,
        event.semantic_digest, event.export_digest, event.initializer_digest,
        event.provider_digest, event.byte_count)
    val staging = secure_temp_dir_raw(cache + "/snapshots", ".tmp.{rt_getpid()}.")
    expect(staging == "").to_equal(false)
    val materialized = scv_compile_snapshot_materialize_source_v1(root, cache, staging, entry)
    expect(materialized.reason).to_equal("ok")
    expect(materialized.source_drifted).to_equal(false)
    val digest = sha256_text(materialized.row)
    val tree = "scv-tree-v1-" + digest
    val commit = "scv-compile-v1-" + sha256_text("simple/scv-compile-commit/v1|{tree}|1")
    val revision = scv_compile_snapshot_revision_id_v1(tree, digest)
    val provenance = scv_compile_snapshot_provenance_v1(revision, commit, tree, digest, 1)
    expect(gap_write(staging + "/SCV_COMPILE_INVENTORY", materialized.row)).to_equal(true)
    expect(gap_write(staging + "/SCV_COMPILE_SNAPSHOT", provenance)).to_equal(true)
    # Test-owned witness survives iff B never deletes/recreates A's directory.
    expect(gap_write(staging + "/publisher-A-witness", "A owns this publication")).to_equal(true)
    val destination = cache + "/snapshots/" + revision
    # Exact production publication primitive, stopped at its real transaction gap.
    expect(file_rename(staging, destination)).to_equal(true)
    expect(file_exists(cache + "/receipts/" + revision + ".receipt")).to_equal(false)
    ScvGapFixtureV1(root, cache, destination, revision, provenance)

fn gap_finish_a(fixture: ScvGapFixtureV1):
    expect(dir_create(fixture.cache + "/receipts", true)).to_equal(true)
    val receipt = scv_compile_snapshot_receipt_v1(fixture.provenance, fixture.revision)
    expect(file_create_excl(fixture.cache + "/receipts/" + fixture.revision + ".receipt", receipt)).to_equal(true)

fn gap_cleanup(fixture: ScvGapFixtureV1):
    val owned_parent = path_absolute("build/test-artifacts").replace("\\", "/") + "/"
    expect(fixture.root.starts_with(owned_parent)).to_equal(true)
    expect(dir_remove(fixture.root, true)).to_equal(true)

describe "snapshot publication gap never authorizes deleting another publisher":
    it "preserves A across B's pre-receipt acquire and allows reuse after A finishes":
        val fixture = gap_fixture()
        val blocked = scv_compile_snapshot_acquire_v1(fixture.root, fixture.cache, [fixture.root + "/src"])
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        expect(blocked.valid).to_equal(false)
        expect(blocked.reason).to_equal("snapshot-existing-invalid:snapshot-open-receipt-mismatch")
        expect(file_hash_sha256(fixture.destination + "/src/a.spl")).to_equal(sha256_text(GAP_CONTENT))
        gap_finish_a(fixture)
        val reused = scv_compile_snapshot_acquire_v1(fixture.root, fixture.cache, [fixture.root + "/src"])
        expect(reused.valid).to_equal(true)
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        gap_cleanup(fixture)

    it "fails closed on a partial receipt without deleting or overwriting it":
        val fixture = gap_fixture()
        expect(dir_create(fixture.cache + "/receipts", true)).to_equal(true)
        val receipt_path = fixture.cache + "/receipts/" + fixture.revision + ".receipt"
        expect(gap_write(receipt_path, "partial")).to_equal(true)
        val blocked = scv_compile_snapshot_acquire_v1(fixture.root, fixture.cache, [fixture.root + "/src"])
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        expect(blocked.valid).to_equal(false)
        expect(blocked.reason).to_equal("snapshot-existing-invalid:snapshot-open-receipt-mismatch")
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        expect(file_hash_sha256(receipt_path)).to_equal(sha256_text("partial"))
        gap_cleanup(fixture)

    it "still accepts an already complete immutable publication":
        val fixture = gap_fixture()
        gap_finish_a(fixture)
        val reused = scv_compile_snapshot_acquire_v1(fixture.root, fixture.cache, [fixture.root + "/src"])
        expect(reused.valid).to_equal(true)
        expect(reused.revision_id).to_equal(fixture.revision)
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        gap_cleanup(fixture)

    it "does not bless a tampered manifest merely because a receipt exists":
        val fixture = gap_fixture()
        gap_finish_a(fixture)
        expect(gap_write(fixture.destination + "/SCV_COMPILE_INVENTORY", "tampered")).to_equal(true)
        val blocked = scv_compile_snapshot_acquire_v1(fixture.root, fixture.cache, [fixture.root + "/src"])
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        expect(blocked.valid).to_equal(false)
        expect(blocked.reason).to_equal("snapshot-existing-invalid:snapshot-open-inventory-mismatch")
        expect(file_exists(fixture.destination + "/publisher-A-witness")).to_equal(true)
        gap_cleanup(fixture)
