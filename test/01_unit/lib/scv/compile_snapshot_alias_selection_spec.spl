use std.spec.{describe, it, expect}
use std.scv.compile_snapshot.{scv_compile_snapshot_logical_member_v1,
    scv_compile_snapshot_physical_source_owned_v1}

describe "SCV snapshot logical source alias selection":
    it "keeps a logical app module whose declared owner is in examples":
        val root = "C:/source"
        expect(scv_compile_snapshot_logical_member_v1(root,
            [root + "/src/app"], "src/app/t32_cli/mod.spl")).to_equal(true)
        expect(scv_compile_snapshot_physical_source_owned_v1(root,
            root + "/examples/10_tooling/trace32_tools/t32_cli/mod.spl")).to_equal(true)

    it "keeps an explicit alias selector in its logical namespace":
        expect(scv_compile_snapshot_logical_member_v1("/repo",
            ["/repo/src/app/t32_cli"], "src/app/t32_cli/mod.spl")).to_equal(true)
        expect(scv_compile_snapshot_logical_member_v1("/repo",
            ["/repo/src/app/t32_cli"], "src/app/t32_cli_extra/mod.spl")).to_equal(false)

    it "does not include physical owner siblings solely because an alias is selected":
        expect(scv_compile_snapshot_logical_member_v1("/repo",
            ["/repo/src/app"], "examples/10_tooling/trace32_tools/t32_cli/mod.spl")).to_equal(false)

    it "rejects traversal and similarly prefixed checkout owners":
        expect(scv_compile_snapshot_logical_member_v1("/repo",
            ["/repo/src"], "src/../outside.spl")).to_equal(false)
        expect(scv_compile_snapshot_physical_source_owned_v1("/repo", "/repo-other/file.spl")).to_equal(false)
        expect(scv_compile_snapshot_physical_source_owned_v1("/repo", "")).to_equal(false)

    it "rejects selected aliases into either managed cache":
        expect(scv_compile_snapshot_physical_source_owned_v1("/repo",
            "/repo/build/scv/snapshots/old/src/a.spl")).to_equal(false)
        expect(scv_compile_snapshot_physical_source_owned_v1("/repo",
            "/repo/.simple/scv/a.spl")).to_equal(false)
        expect(scv_compile_snapshot_physical_source_owned_v1("/repo",
            "/repo/build/scv-other/a.spl")).to_equal(true)
