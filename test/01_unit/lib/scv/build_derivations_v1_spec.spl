# TDD contract: source authored before owner implementation; native audit pending.
use std.spec.{describe, it, expect}
use std.scv.build_derivations_v1.*

fn derivation_use(id: text, producer: text, kind: text = "generic", scope: text = "") -> ScvBuildUseV1:
    ScvBuildUseV1(use_id: id, kind: kind, producer_uid: producer,
        facet_digest: "facet-v1", scope_root: scope)

fn derivation_registered(consumer: text = "module-a", attempt: text = "attempt-a") -> ScvBuildGraphStateV1:
    val state = scv_build_graph_empty_v1("snapshot-exact-1").unwrap()
    scv_build_register_attempt_v1(state, state.root_id, consumer, 1, attempt).unwrap()

fn derivation_replace(state: ScvBuildGraphStateV1, uses: [ScvBuildUseV1],
        consumer: text = "module-a", attempt: text = "attempt-a",
        scopes: [ScvBuildCandidateScopeV1] = []) -> Result<ScvBuildGraphStateV1, text>:
    scv_build_replace_consumer_v1(state, state.root_id, "snapshot-exact-1", consumer,
        1, attempt, uses, scopes)

fn derivation_persist_refuse(expected_root: text, candidate: ScvBuildGraphStateV1) -> Result<text, text>:
    Err("owner-journal-unavailable")

fn derivation_persist_wrong(expected_root: text, candidate: ScvBuildGraphStateV1) -> Result<text, text>:
    Ok(expected_root)

describe "SCV complete outgoing derivation manifests (REQ-SCV-DER-001..008)":
    it "derives exact reverse-user and demand sets from complete consumer replacement":
        val registered = derivation_registered()
        val old = derivation_replace(registered, [derivation_use("u1", "generic-a"),
            derivation_use("u2", "generic-a"), derivation_use("u3", "macro-a", "macro")]).unwrap()
        expect(scv_build_reverse_users_v1(old, "generic-a")).to_equal(["module-a"])
        expect(scv_build_demand_v1(old, "generic-a", "facet-v1")).to_equal(["module-a/u1", "module-a/u2"])
        val current = scv_build_register_attempt_v1(old, old.root_id, "module-a", 2, "attempt-b").unwrap()
        val next = scv_build_replace_consumer_v1(current, current.root_id, current.snapshot_id,
            "module-a", 2, "attempt-b", [derivation_use("u4", "generic-b")], []).unwrap()
        expect(scv_build_reverse_users_v1(next, "generic-a")).to_equal([])
        expect(scv_build_demand_v1(next, "generic-a", "facet-v1")).to_equal([])
        expect(scv_build_reverse_users_v1(next, "generic-b")).to_equal(["module-a"])
        expect(scv_build_reverse_users_v1(old, "generic-a")).to_equal(["module-a"])

    it "preserves a shared producer demanded by a different consumer":
        val first = derivation_replace(derivation_registered(), [derivation_use("same", "producer")]).unwrap()
        val registered = scv_build_register_attempt_v1(first, first.root_id, "module-b", 1, "attempt-b").unwrap()
        val both = derivation_replace(registered, [derivation_use("same", "producer")], "module-b", "attempt-b").unwrap()
        val removing = scv_build_register_attempt_v1(both, both.root_id, "module-a", 2, "attempt-c").unwrap()
        val next = scv_build_replace_consumer_v1(removing, removing.root_id, removing.snapshot_id,
            "module-a", 2, "attempt-c", [], []).unwrap()
        expect(scv_build_reverse_users_v1(next, "producer")).to_equal(["module-b"])
        expect(scv_build_demand_v1(next, "producer", "facet-v1")).to_equal(["module-b/same"])

    it "rejects stale roots, snapshot mismatch, unregistered and superseded attempts":
        val state = derivation_registered()
        expect(scv_build_replace_consumer_v1(state, "stale", state.snapshot_id,
            "module-a", 1, "attempt-a", [], [])).to_equal(Err("derivation-root-cas"))
        expect(scv_build_replace_consumer_v1(state, state.root_id, "other-snapshot",
            "module-a", 1, "attempt-a", [], [])).to_equal(Err("derivation-snapshot-mismatch"))
        expect(derivation_replace(state, [], "module-a", "unknown")).to_equal(Err("derivation-attempt-stale"))
        val newer = scv_build_register_attempt_v1(state, state.root_id, "module-a", 2, "new-attempt").unwrap()
        expect(derivation_replace(newer, [])).to_equal(Err("derivation-attempt-stale"))

    it "replays an identical operation without changing the published root and rejects changed payload":
        val state = derivation_registered()
        val uses = [derivation_use("u", "producer")]
        val committed = derivation_replace(state, uses).unwrap()
        val replay = scv_build_replace_consumer_v1(committed, state.root_id, state.snapshot_id,
            "module-a", 1, "attempt-a", uses, []).unwrap()
        expect(replay.root_id).to_equal(committed.root_id)
        expect(scv_build_replace_consumer_v1(committed, state.root_id, state.snapshot_id,
            "module-a", 1, "attempt-a", [], [])).to_equal(Err("derivation-replay-payload-mismatch"))

    it "does not accept duplicate use identities or a scope omitted from complete manifest":
        val state = derivation_registered()
        val item = derivation_use("u", "producer")
        expect(derivation_replace(state, [item, item])).to_equal(Err("derivation-duplicate-use"))
        expect(derivation_replace(state, [item, derivation_use("u", "other")])).to_equal(Err("derivation-duplicate-use"))
        expect(derivation_replace(state, [derivation_use("p", "aspect", "pointcut", "scope-1")])).to_equal(Err("derivation-scope-missing"))

    it "retains negative and empty pointcut candidate universes and compares old plus new":
        val state = derivation_registered()
        val old_scope = ScvBuildCandidateScopeV1(scope_root: "scope-old", candidate_uids: ["negative-old", "matched"])
        val old = derivation_replace(state, [derivation_use("p", "aspect", "pointcut", "scope-old")],
            scopes: [old_scope]).unwrap()
        val registered = scv_build_register_attempt_v1(old, old.root_id, "module-a", 2, "attempt-b").unwrap()
        val new_scope = ScvBuildCandidateScopeV1(scope_root: "scope-new", candidate_uids: ["negative-new", "matched"])
        val empty_scope = ScvBuildCandidateScopeV1(scope_root: "scope-empty", candidate_uids: [])
        val next = scv_build_replace_consumer_v1(registered, registered.root_id, registered.snapshot_id,
            "module-a", 2, "attempt-b", [], [new_scope, empty_scope]).unwrap()
        expect(scv_build_pointcut_candidates_v1(old, next, "module-a")).to_equal(["matched", "negative-new", "negative-old"])
        expect(next.manifests[0].scopes.len()).to_equal(2)
        expect(scv_build_candidate_users_v1(next, "negative-new")).to_equal(["module-a"])

    it "rejects failed and cancelled producers before persistence and preserves previous users":
        val old = derivation_replace(derivation_registered(), [derivation_use("u", "producer")]).unwrap()
        val state = scv_build_register_attempt_v1(old, old.root_id, "module-a", 2, "attempt-b").unwrap()
        expect(scv_build_publish_consumer_v1(state, state.root_id, state.snapshot_id, "module-a",
            2, "attempt-b", [], [], "failed", derivation_persist_refuse)).to_equal(Err("derivation-producer-not-successful"))
        expect(scv_build_publish_consumer_v1(state, state.root_id, state.snapshot_id, "module-a",
            2, "attempt-b", [], [], "cancelled", derivation_persist_refuse)).to_equal(Err("derivation-producer-not-successful"))
        expect(scv_build_reverse_users_v1(state, "producer")).to_equal(["module-a"])

    it "requires persistence owner to commit the exact candidate before returning publication":
        val state = derivation_registered()
        expect(scv_build_publish_consumer_v1(state, state.root_id, state.snapshot_id, "module-a",
            1, "attempt-a", [], [], "completed", derivation_persist_refuse)).to_equal(Err("owner-journal-unavailable"))
        expect(scv_build_publish_consumer_v1(state, state.root_id, state.snapshot_id, "module-a",
            1, "attempt-a", [], [], "completed", derivation_persist_wrong)).to_equal(Err("derivation-owner-root-mismatch"))
        expect(state.manifests.len()).to_equal(0)

    it "uses canonical ordering and refuses tampered roots without trusting supplied identity":
        val state = derivation_registered()
        val a = derivation_use("a", "producer-a")
        val b = derivation_use("b", "producer-b")
        expect(derivation_replace(state, [a, b]).unwrap().root_id).to_equal(derivation_replace(state, [b, a]).unwrap().root_id)
        var tampered = state
        tampered.snapshot_id = "forged-snapshot"
        expect(derivation_replace(tampered, [])).to_equal(Err("derivation-root-invalid"))

    it "invalidates bound receipt identities in the same root as a manifest replacement":
        val old = derivation_replace(derivation_registered(), [derivation_use("u", "producer")]).unwrap()
        val binding = ScvBuildReceiptBindingV1(receipt_id: "receipt-1", consumer_uid: "module-a",
            manifest_digest: old.manifests[0].manifest_digest)
        val bound = scv_build_bind_receipt_v1(old, old.root_id, binding).unwrap()
        val registered = scv_build_register_attempt_v1(bound, bound.root_id, "module-a", 2, "attempt-b").unwrap()
        val next = scv_build_replace_consumer_v1(registered, registered.root_id, registered.snapshot_id,
            "module-a", 2, "attempt-b", [], []).unwrap()
        expect(next.invalidated_receipt_ids).to_equal(["receipt-1"])
        expect(next.receipts.len()).to_equal(0)
        expect(bound.receipts.len()).to_equal(1)
        expect(bound.invalidated_receipt_ids).to_equal([])
        expect(scv_build_bind_receipt_v1(next, next.root_id, binding)).to_equal(Err("derivation-receipt-invalid"))

    it "supports a new retry at the same source generation without resurrecting a superseded ID":
        val old = derivation_registered()
        val retry = scv_build_register_attempt_v1(old, old.root_id, "module-a", 1, "retry-a").unwrap()
        expect(scv_build_register_attempt_v1(retry, retry.root_id, "module-a", 1, "attempt-a")).to_equal(Err("derivation-attempt-reused"))
        expect(derivation_replace(retry, [])).to_equal(Err("derivation-attempt-stale"))
        expect(derivation_replace(retry, [], attempt: "retry-a").unwrap().manifests[0].attempt_id).to_equal("retry-a")

    it "binds a new exact snapshot while preserving old users until a successful new producer":
        val old = derivation_replace(derivation_registered(), [derivation_use("u", "producer")]).unwrap()
        val binding = ScvBuildReceiptBindingV1(receipt_id: "receipt-1", consumer_uid: "module-a",
            manifest_digest: old.manifests[0].manifest_digest)
        val bound = scv_build_bind_receipt_v1(old, old.root_id, binding).unwrap()
        val next = scv_build_advance_snapshot_v1(bound, bound.root_id, "snapshot-exact-2").unwrap()
        expect(next.snapshot_id).to_equal("snapshot-exact-2")
        expect(next.manifests[0].snapshot_id).to_equal("snapshot-exact-1")
        expect(next.attempts).to_equal([])
        expect(next.invalidated_receipt_ids).to_equal(["receipt-1"])
        expect(scv_build_reverse_users_v1(next, "producer")).to_equal(["module-a"])
        expect(scv_build_replace_consumer_v1(next, next.root_id, next.snapshot_id,
            "module-a", 1, "attempt-a", [], [])).to_equal(Err("derivation-replay-payload-mismatch"))

    it "copies submitted nested candidate storage and escapes demand identities without collisions":
        var candidates = ["negative"]
        var submitted = [derivation_use("a/b", "producer", "generic", "scope")]
        val state = derivation_registered("c")
        val scope = ScvBuildCandidateScopeV1(scope_root: "scope", candidate_uids: candidates)
        val committed = derivation_replace(state, submitted, "c", scopes: [scope]).unwrap()
        candidates[0] = "changed"
        submitted[0] = derivation_use("other", "other")
        expect(scv_build_candidate_users_v1(committed, "negative")).to_equal(["c"])
        expect(scv_build_demand_v1(committed, "producer", "facet-v1")).to_equal(["c/a%2Fb"])
        expect(scv_build_graph_valid_v1(committed)).to_equal(true)

    it "rejects unsupported kinds, repeated scope candidates and receipts for an unknown manifest":
        val state = derivation_registered()
        expect(derivation_replace(state, [derivation_use("u", "p", "unknown")])).to_equal(Err("derivation-use-kind"))
        val scope = ScvBuildCandidateScopeV1(scope_root: "scope", candidate_uids: ["a", "a"])
        expect(derivation_replace(state, [], scopes: [scope])).to_equal(Err("derivation-candidate-invalid"))
        val receipt = ScvBuildReceiptBindingV1(receipt_id: "r", consumer_uid: "module-a", manifest_digest: "missing")
        expect(scv_build_bind_receipt_v1(state, state.root_id, receipt)).to_equal(Err("derivation-receipt-manifest-mismatch"))

    it "keeps producer kinds distinct and refuses conflicting content for an immutable scope root":
        val state = derivation_registered()
        val scope = ScvBuildCandidateScopeV1(scope_root: "scope", candidate_uids: ["a"])
        val first = derivation_replace(state, [derivation_use("g", "p"), derivation_use("m", "p", "macro")], scopes: [scope]).unwrap()
        expect(scv_build_kind_demand_v1(first, "generic", "p", "facet-v1")).to_equal(["module-a/g"])
        expect(scv_build_kind_demand_v1(first, "macro", "p", "facet-v1")).to_equal(["module-a/m"])
        expect(scv_build_reverse_kind_users_v1(first, "pointcut", "p")).to_equal([])
        val registered = scv_build_register_attempt_v1(first, first.root_id, "module-a", 2, "attempt-b").unwrap()
        val conflict = ScvBuildCandidateScopeV1(scope_root: "scope", candidate_uids: ["b"])
        expect(scv_build_replace_consumer_v1(registered, registered.root_id, registered.snapshot_id,
            "module-a", 2, "attempt-b", [], [conflict])).to_equal(Err("derivation-scope-root-conflict"))

    it "cannot attach a new receipt to a historical manifest after snapshot advance":
        val old = derivation_replace(derivation_registered(), [derivation_use("u", "producer")]).unwrap()
        val advanced = scv_build_advance_snapshot_v1(old, old.root_id, "snapshot-exact-2").unwrap()
        val late = ScvBuildReceiptBindingV1(receipt_id: "late-receipt", consumer_uid: "module-a",
            manifest_digest: old.manifests[0].manifest_digest)
        expect(scv_build_bind_receipt_v1(advanced, advanced.root_id, late)).to_equal(Err("derivation-receipt-snapshot-mismatch"))
        var forged = advanced
        forged.receipts = [late]
        forged.root_id = scv_build_graph_digest_v1(forged)
        expect(scv_build_graph_valid_v1(forged)).to_equal(false)
        val registered = scv_build_register_attempt_v1(advanced, advanced.root_id, "module-a", 2, "attempt-new-snapshot").unwrap()
        val current = scv_build_replace_consumer_v1(registered, registered.root_id, registered.snapshot_id,
            "module-a", 2, "attempt-new-snapshot", [derivation_use("u", "producer")], []).unwrap()
        val fresh = ScvBuildReceiptBindingV1(receipt_id: "current-receipt", consumer_uid: "module-a",
            manifest_digest: current.manifests[0].manifest_digest)
        val rebound = scv_build_bind_receipt_v1(current, current.root_id, fresh).unwrap()
        expect(rebound.receipts).to_equal([fresh])
        expect(scv_build_graph_valid_v1(rebound)).to_equal(true)
