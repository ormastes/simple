use std.spec.*
use std.io_runtime.{process_run}

describe "SCV profiling requires canonical producer admission":
    it "rejects fabricated schemas authority candidate runtime and sanity before invoking a producer":
        val (report, errors, code) = process_run("/bin/sh", ["test/fixtures/scv_inventory_memory/admission_rejections.shs"])
        print errors
        expect(code).to_equal(0)
        for defect in ["schema", "authority", "candidate", "runtime", "sanity"]:
            expect(report).to_contain("{defect}_exit=1\n")
            expect(report).to_contain("{defect}_invoked=0\n")
