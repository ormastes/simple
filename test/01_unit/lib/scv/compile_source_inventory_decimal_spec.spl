# Public decoder regression for canonical decimal fields and native small words.
use std.spec
use std.spec.step
use std.scv.compile_source_inventory.{compile_source_inventory_decode_v1,
    compile_source_inventory_encode_v1, CompileSourceInventoryEntryV1,
    CompileSourceInventoryV1}

fn decimal_inventory_wire(generation: text, count: text, size: text) -> text:
    val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    "simple-compile-source-inventory-v1\ngeneration=" + generation + "\ncount=" + count +
        "\nsrc/probe.spl|" + digest + "|" + digest + "|" + digest + "|" + digest + "|" + digest + "|" + size

describe "compile source inventory canonical decimals":
    it "roundtrips small reserved native words zero and maximum i64":
        step("decodes actual public inventory fields without optional integer presence")
        val digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val values: [i64] = [0, 1, 2, 3, 4, 7, 8, 15, 16, 24, 9223372036854775807]
        for value in values:
            val entry = CompileSourceInventoryEntryV1("src/probe.spl", digest, digest, digest, digest, digest, value)
            val wire = compile_source_inventory_encode_v1(CompileSourceInventoryV1(1, value, [entry]))
            expect(wire.len()).to_be_greater_than(0)
            val decoded = compile_source_inventory_decode_v1(wire)
            expect(decoded.valid).to_equal(true)
            expect(decoded.inventory!.generation).to_equal(value)
            expect(decoded.inventory!.entries[0].byte_count).to_equal(value)
            expect(compile_source_inventory_encode_v1(decoded.inventory!)).to_equal(wire)
        val empty = compile_source_inventory_decode_v1("simple-compile-source-inventory-v1\ngeneration=0\ncount=0")
        expect(empty.valid).to_equal(true)
        expect(empty.inventory!.entries.len()).to_equal(0)

    it "rejects malformed signed noncanonical and overflowing decimal fields":
        step("independently rejects each invalid spelling in generation count and size")
        val invalid = ["", "-1", "+3", " 3", "3 ", "03", "00", "3x", "3.0", "\t3",
            "9223372036854775808", "9999999999999999999999999999"]
        for value in invalid:
            expect(compile_source_inventory_decode_v1(decimal_inventory_wire(value, "1", "24")).valid).to_equal(false)
            expect(compile_source_inventory_decode_v1(decimal_inventory_wire("3", value, "24")).valid).to_equal(false)
            expect(compile_source_inventory_decode_v1(decimal_inventory_wire("3", "1", value)).valid).to_equal(false)

    it "retains count row and canonical inventory rejection":
        step("refuses mismatched counts malformed rows invalid paths and trailing newlines")
        val wire = decimal_inventory_wire("3", "1", "24")
        expect(compile_source_inventory_decode_v1(wire).valid).to_equal(true)
        expect(compile_source_inventory_decode_v1(decimal_inventory_wire("3", "0", "24")).valid).to_equal(false)
        expect(compile_source_inventory_decode_v1(decimal_inventory_wire("3", "9223372036854775807", "24")).valid).to_equal(false)
        expect(compile_source_inventory_decode_v1(wire + "|extra").valid).to_equal(false)
        expect(compile_source_inventory_decode_v1(wire + "\n").valid).to_equal(false)
        expect(compile_source_inventory_decode_v1(wire.replace("src/probe.spl", "../probe.spl")).valid).to_equal(false)
        expect(compile_source_inventory_decode_v1(wire.replace("generation=3", "generation=３")).valid).to_equal(false)
