use std.spec.*
use std.scv.compile_source_inventory.{compile_source_inventory_plain_checkout_v1}

# Interpreter behaviour pin for compile_source_inventory_plain_checkout_v1. The frozen
# Phase 2 native defect it guards against does not reproduce in the interpreter; the
# native evidence is in doc/08_tracking/bug/phase2_var_reassign_runtime_text_branch_lost_2026-11-17.md.

fn runtime_text(parts: [text], sep: text) -> text:
    parts.join(sep)

describe "plain checkout path normalisation":
    it "strips the verbatim prefix from a literal":
        expect(compile_source_inventory_plain_checkout_v1("//?/C:/x")).to_equal("C:/x")
    it "strips the verbatim prefix from a runtime-built text":
        val built = runtime_text(["//?", "C:", "x"], "/")
        expect(compile_source_inventory_plain_checkout_v1(built)).to_equal("C:/x")
    it "rewrites a verbatim UNC path":
        val built = runtime_text(["//?", "UNC", "host", "share"], "/")
        expect(compile_source_inventory_plain_checkout_v1(built)).to_equal("//host/share")
        expect(compile_source_inventory_plain_checkout_v1("//?/UNC/host/share")).to_equal("//host/share")
    it "converts backslash verbatim drive paths":
        expect(compile_source_inventory_plain_checkout_v1("\\\\?\\C:\\x")).to_equal("C:/x")
        val built = "\\\\?\\C:\\" + runtime_text(["x", "y"], "\\")
        expect(compile_source_inventory_plain_checkout_v1(built)).to_equal("C:/x/y")
    it "trims trailing slashes and rejects dot components":
        expect(compile_source_inventory_plain_checkout_v1("C:/x//")).to_equal("C:/x")
        expect(compile_source_inventory_plain_checkout_v1("C:/x/../y")).to_equal("")
