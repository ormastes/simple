# @cover src/lib/common/mcdc/masking_context.spl 90%
use std.spec.*
use std.common.mcdc.masking_context.*

fn context() -> McdcMaskingContext:
    McdcMaskingContext(
        decision_id: 10, target_ordinal: 0, proof_id: 20,
        context_id: 30, requirement_count: 2, strong_coupling: false)

fn evidence(sequence: i64, satisfied: i64, masked: i64) -> McdcMaskingContextEvidence:
    McdcMaskingContextEvidence(
        decision_id: 10, owner_id: 1, sequence: sequence, target_ordinal: 0,
        proof_id: 20, context_id: 30,
        satisfied0: satisfied, satisfied1: 0, satisfied2: 0, satisfied3: 0,
        masked0: masked, masked1: 0, masked2: 0, masked3: 0)

describe "formal masking MC/DC context contract":
    it "accepts a sound one-sided short-circuit witness":
        # Requirement zero is masked on the left and demonstrated on the
        # right. Requirement one is demonstrated by both rows.
        val left = evidence(1, 2, 1)
        val right = evidence(2, 3, 0)
        expect(mcdc_masking_pair_context_valid(context(), left, right)).to_equal(true)

    it "rejects the all-other-leaves projection false positive":
        # Both rows call requirement zero masked. Projecting that leaf away
        # would falsely award coverage; no member proves its neutral outcome.
        val left = evidence(1, 2, 1)
        val right = evidence(2, 2, 1)
        expect(mcdc_masking_pair_context_valid(context(), left, right)).to_equal(false)

    it "rejects evidence from another compiler proof":
        var wrong = evidence(2, 3, 0)
        wrong.proof_id = 21
        expect(mcdc_masking_pair_context_valid(
            context(), evidence(1, 3, 0), wrong)).to_equal(false)

    it "rejects contradictory satisfied-and-masked bits":
        expect(mcdc_masking_evidence_matches_context(
            context(), evidence(1, 3, 1))).to_equal(false)

    it "rejects incomplete and out-of-bound contexts":
        expect(mcdc_masking_evidence_matches_context(
            context(), evidence(1, 1, 0))).to_equal(false)
        var invalid = context()
        invalid.requirement_count = 257
        expect(mcdc_masking_context_error(invalid)).to_equal("MCDC-E-CONTEXT-BOUND")
