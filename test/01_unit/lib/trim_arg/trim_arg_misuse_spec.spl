# text.trim_start/trim_end take no argument (whitespace only). package_utils
# passed "^" / "~" / ">=" to them, which silently trimmed nothing.
use std.spec.*
use std.nogc_sync_mut.cli.package_utils.{generate_lockfile_content}

fn lock_ver(version: text) -> text:
    val out = generate_lockfile_content([("pkg", version)])
    # row format: "  name, ver, registry, ..."
    val row = out.split("\n")[7]
    row.split(", ")[1]

describe "package_utils lockfile version prefixes":
    it "strips a leading ^":
        expect(lock_ver("^1.2.3")).to_equal("1.2.3")

    it "strips a leading ~":
        expect(lock_ver("~1.2.3")).to_equal("1.2.3")

    it "strips a leading >=":
        expect(lock_ver(">=1.2.3")).to_equal("1.2.3")

    it "maps * to 0.0.0 and leaves plain versions alone":
        expect(lock_ver("*")).to_equal("0.0.0")
        expect(lock_ver("1.2.3")).to_equal("1.2.3")
