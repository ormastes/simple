# @cover src/lib/common/oauth_token_cache.spl
use std.spec.*
use std.common.oauth_token_cache.{oauth_token_cache_render, oauth_token_cache_parse}

describe "OAuth cache canonical SDN payload":
    it "should round trip Unicode quotes backslashes and control characters":
        step("Render an opaque token containing escaped SDN delimiters")
        val token = "café日本🙂 \"quote\" \\slash\nexpires_at: 1\t\r"
        val payload = oauth_token_cache_render(token, 4102444800)
        step("Parse the canonical SDN document without interpreting token contents as fields")
        val parsed: (text, i64) = oauth_token_cache_parse(payload)
        expect(parsed.0).to_equal(token)
        expect(parsed.1).to_equal(4102444800)

    it "should reject duplicate token fields rather than select a winner":
        step("Parse a cache with two conflicting access token fields")
        val parsed: (text, i64) = oauth_token_cache_parse("access_token: first\naccess_token: second\nexpires_at: 4102444800\n")
        expect(parsed.0).to_equal("")
        expect(parsed.1).to_equal(0)

    it "should reject malformed or incorrectly typed cache documents":
        step("Parse a scalar root and an incorrectly typed token")
        val scalar: (text, i64) = oauth_token_cache_parse("not_a_cache")
        val wrong_type: (text, i64) = oauth_token_cache_parse("access_token: 42\nexpires_at: 4102444800\n")
        expect(scalar.0).to_equal("")
        expect(scalar.1).to_equal(0)
        expect(wrong_type.0).to_equal("")
        expect(wrong_type.1).to_equal(0)
