# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "filesystem walk runtime contract":
    # @manual scenario evidence
    it "maps runtime paths instead of binding an unrelated walk_dir symbol":
        # @req REQ-SSPEC-LIB
        step("maps runtime paths instead of binding an unrelated walk_dir symbol")
        # The flat fs modules moved into their packages as std.fs.flat
        # (fs_file_class_collision_wrong_static_method_2026-09-01: one module
        # owner for the `std.fs` name).
        val sync_source = rt_file_read_text("src/lib/nogc_sync_mut/fs/flat.spl") ?? ""
        val async_source = rt_file_read_text("src/lib/nogc_async_mut/fs/flat.spl") ?? ""

        for source in [sync_source, async_source]:
            # The walk contract: dir_walk comes from the real io_runtime
            # owner (no locally-declared rt_dir_walk extern), and walk_dir
            # builds DirEntry records.
            expect(source).to_contain("use std.io_runtime.")
            expect(source).to_contain("dir_walk")
            expect(source).to_contain("entries.push(DirEntry(")
            expect(source.contains("extern fn walk_dir")).to_equal(false)
