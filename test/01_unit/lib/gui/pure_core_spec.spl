# Pure Simple GUI command boundary tests

"""
## Purpose and audience
Executable contract for the pure-Simple GUI command boundary in
`std.gui.pure_core`: dispatched pointer/key events must land in command and
dirty-region batches without touching pixel output, the batch counters must
decide the sub-millisecond hot-response target both ways, the representative
hot-probe helpers must agree with a real dispatch, and the shipped core must
stay free of the removed eager iteration conversion. Owned by the GUI core
team; performance engineers tuning input latency are the audience.
## Operator workflow
Run `simple run test/01_unit/lib/gui/pure_core_spec.spl`. Each scenario builds
events with `gui_pointer_event`/`gui_key_event`, dispatches them through
`gui_dispatch_events`, and checks batch contents or counters against the value
justified in the oracle comment.
## Compatibility and limitations
The boundary is model-level only: no window, no raster, no backend is
involved, so pixel-output claims are proven by batch shape rather than frames.
The closing scenario inspects shipped source text — a contract check on the
implementation shape, not runtime evidence.
## Verification guidance and troubleshooting
A dispatch-scenario failure means event routing changed shape: compare command
kinds first, then counter totals. A hot-target scenario failing means the
counter arithmetic or the threshold comparison drifted; re-run with a single
pointer_down event to isolate. The dynlib probe scenarios failing while
dispatch passes point at the exported probe helpers, not the dispatcher.
"""
# Lifecycle: doc/01_research/ui/tui/harden_tui_gui_layout_comparison.md ;
# doc/03_plan/gui/gui_hardening_current_plan_2026-06-01.md ;
# doc/04_architecture/ui/00_ui_architecture.md ;
# doc/05_design/ui/renderer_unification_2026-06-15.md
# @manual_section: pure GUI command boundary

use std.spipe.*
use std.gui.pure_core.{gui_pointer_event, gui_key_event, gui_empty_batch, gui_dispatch_events, gui_batch_meets_hot_response_target, gui_representative_hot_probe_command_count, gui_representative_hot_probe_event_tick, gui_dynlib_hot_probe_tick}

extern fn rt_file_read_text(path: text) -> text

describe "pure GUI command boundary":
    it "dispatches pointer and key events into command and dirty-region batches":
        step("Dispatch two pointer events and one key event through the boundary")
        # @req REQ-GUI-PURECORE-001
        # @capture(statistics): command/dirty-region/counter totals for the three-event dispatch
        val events = [
            gui_pointer_event("pointer_move", "button.save", 12, 24),
            gui_pointer_event("pointer_down", "button.save", 12, 24),
            gui_key_event("input.name", "A", "a")
        ]
        val batch = gui_dispatch_events(events, 700)
        expect(batch.commands.len()).to_equal(3)  # oracle: one command per dispatched event
        expect(batch.dirty_regions.len()).to_equal(3)  # oracle: every event dirties exactly one region
        expect(batch.counters.event_count).to_equal(3)  # oracle: the counter mirrors the dispatched event list length
        expect(batch.counters.command_count).to_equal(3)  # oracle: the counter mirrors the produced command list length
        expect(batch.counters.dirty_region_count).to_equal(3)  # oracle: the counter mirrors the dirty-region list length

    it "records command kinds without touching pixel output":
        step("Dispatch a hover and a press and read back their command kinds")
        # @req REQ-GUI-PURECORE-002
        # @capture(statistics): command kind sequence hover then commit
        val events = [
            gui_pointer_event("pointer_move", "button.save", 12, 24),
            gui_pointer_event("pointer_up", "button.save", 12, 24)
        ]
        val batch = gui_dispatch_events(events, 800)
        expect(batch.commands[0].kind).to_equal("hover")  # oracle: pointer_move maps to the hover command kind
        expect(batch.commands[1].kind).to_equal("commit")  # oracle: pointer_up maps to the commit command kind

    it "checks the sub millisecond hot response target from counters":
        step("Dispatch one press and evaluate the target just under one millisecond")
        # @req REQ-GUI-PURECORE-003
        # @capture(statistics): hot-target verdict for a 999us budget
        val events = [gui_pointer_event("pointer_down", "button.save", 12, 24)]
        val batch = gui_dispatch_events(events, 999)
        expect(gui_batch_meets_hot_response_target(batch, 1000)).to_equal(true)  # oracle: a 999us batch stays under the 1000us hot-response bound

    it "fails the hot response target at one millisecond or above":
        step("Dispatch one press and evaluate the target exactly at one millisecond")
        # @req REQ-GUI-PURECORE-004
        # @capture(statistics): hot-target verdict at the 1000us boundary
        val events = [gui_pointer_event("pointer_down", "button.save", 12, 24)]
        val batch = gui_dispatch_events(events, 1000)
        expect(gui_batch_meets_hot_response_target(batch, 1000)).to_equal(false)  # oracle: the target is strict, so an at-bound batch must fail it

    it "creates an empty batch with zero counters":
        step("Construct the empty batch and read its lists and counters")
        # @req REQ-GUI-PURECORE-005
        # @capture(statistics): zeroed empty-batch counters
        val batch = gui_empty_batch()
        expect(batch.commands.len()).to_equal(0)  # oracle: the empty batch carries no commands
        expect(batch.dirty_regions.len()).to_equal(0)  # oracle: the empty batch carries no dirty regions
        expect(batch.counters.elapsed_us).to_equal(0)  # oracle: an undispatched batch accrued no elapsed time

    it "keeps scalar hot probe count equivalent to representative dispatch":
        step("Dispatch the representative event mix and compare probe counts")
        # @req REQ-GUI-PURECORE-006
        # @capture(statistics): probe count vs dispatched command count equivalence
        val events = [
            gui_pointer_event("pointer_move", "button.save", 19, 24),
            gui_pointer_event("pointer_down", "button.save", 12, 24),
            gui_pointer_event("pointer_up", "button.save", 12, 24),
            gui_key_event("input.name", "A", "a")
        ]
        val batch = gui_dispatch_events(events, 0)
        expect(gui_representative_hot_probe_command_count(7)).to_equal(batch.commands.len().to_i64())  # oracle: the scalar probe must reproduce the real dispatch's command count

    it "exposes an allocation-light event-field dynlib hot probe symbol":
        step("Call the event-field and dynlib probes with fixed inputs")
        # @req REQ-GUI-PURECORE-007
        # @capture(statistics): fixed-input probe tick counts for both exported helpers
        expect(gui_representative_hot_probe_event_tick(7, 19, 24, 65)).to_equal(4)  # oracle: the in-range event contributes its four fields to the tick
        expect(gui_representative_hot_probe_event_tick(7, -1, 24, 65)).to_equal(1)  # oracle: the out-of-range event collapses to its single tag field
        expect(gui_dynlib_hot_probe_tick(7)).to_equal(4)  # oracle: the dynlib probe reproduces the in-range event's four-field tick

    it "keeps representative hot count free of unused iteration conversion":
        step("Inspect the shipped pure-core source for the removed conversion")
        # @req REQ-GUI-PURECORE-008
        # @capture(statistics): source-contract boolean for the dropped eager conversion
        val pure_core_source = rt_file_read_text("src/lib/gui/pure_core.spl")
        val still_converts_iteration_eagerly = pure_core_source.contains("val _i = iteration.to_i32()")
        expect(still_converts_iteration_eagerly).to_equal(false)  # oracle: the eager to_i32 conversion was deleted; the probe reads fields without it
