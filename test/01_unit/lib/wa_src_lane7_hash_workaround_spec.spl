# @cover src/lib/nogc_sync_mut/src/hash.spl
# Regression guard for primitive_receiver_trait_impl_dispatch_2026-08-07 (KEPT-WITH-REASON):
# Verifies hash_text_fnv1a stays identical to impl Hash for text and std.hash.rt_hash_text.
use std.spec.*
use std.nogc_sync_mut.src.hash.{Hash, hash_text_fnv1a}
use std.hash.{rt_hash_text}

describe "hash_text_fnv1a primitive dispatch parity":
    it "matches impl Hash for text across empty, ASCII, embedded NUL, and UTF-8":
        val samples: [text] = ["", "a", "hello", "foobar", "a\u{0}b", "é"]
        for sample in samples:
            expect(hash_text_fnv1a(sample)).to_equal(sample.hash())
            expect(rt_hash_text(sample)).to_equal(sample.hash())
