"""
## Purpose and audience
Purpose: Verify config_parser upgrades legacy v1 credential records atomically on load and write.
Audience: terminal, credential, and security maintainers.
"""

# @req: REQ-LIB-CREDENTIAL-CONFIG-UPGRADE-001

use std.spec.*
use std.terminal.credential.config_parser.{
    parse_terminal_config_with_key,
    parse_power_config_with_key,
    config_write_atomic,
    config_save_atomic,
    config_update_entry_field_atomic
}
use std.terminal.credential.store.{
    credential_decrypt,
    credential_needs_upgrade
}
use std.common.aes.utilities.{bytes_to_hex, hex_to_bytes, aes_text_to_bytes as text_to_bytes}
use std.common.aes.modes.{aes_ctr_encrypt}
use std.io_runtime.{env_get, dir_create_all}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_file_remove(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool

fn _tmp_dir() -> text:
    val base = env_get("TEMP") ?? (env_get("TMPDIR") ?? "/tmp")
    val dir = "{base}/simple_cred_cfg_upgrade_test"
    dir_create_all(dir)
    dir

fn _key_hex() -> text:
    "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4"

fn _write_key(path: text) -> bool:
    rt_file_write_text(path, _key_hex())

fn _v1_record(secret: text) -> text:
    val key = hex_to_bytes(_key_hex())
    var iv: [i64] = []
    var i = 0
    while i < 16:
        iv.push((i * 11 + 5) & 0xFF)
        i = i + 1
    val ct = aes_ctr_encrypt(text_to_bytes(secret), key, iv)
    "encrypted:{bytes_to_hex(iv)}{bytes_to_hex(ct)}"

fn _extract_password_token(content: text) -> text:
    val hit = content.index_of("password:") ?? -1
    if hit < 0:
        return ""
    val rest = content[(hit + 9)..]
    val eol = rest.index_of("\n") ?? -1
    val line_val = if eol >= 0: rest[0..eol] else: rest
    line_val.trim()

describe "Credential v1 upgrade-on-write in config_parser":

    it "upgrades v1 SSH credentials to v2 on parse_terminal_config_with_key and stays idempotent":
        val dir = _tmp_dir()
        val key_path = "{dir}/term_load.key"
        val cfg_path = "{dir}/term_load.sdn"
        rt_file_remove(cfg_path)
        expect(_write_key(key_path)).to_equal(true)

        val secret = "ssh-secret-v1"
        val v1 = _v1_record(secret)
        expect(credential_needs_upgrade(v1)).to_equal(true)

        val raw = "# board terminal config\n\nterminals\n  board_a\n    kind: ssh\n    host: 10.0.0.5\n    port: 22\n    username: ops\n    auth: password\n    password: {v1}\n"
        expect(rt_file_write_text(cfg_path, raw)).to_equal(true)

        val parsed = parse_terminal_config_with_key(cfg_path, key_path)
        expect(parsed.len()).to_equal(1)
        expect(parsed[0].name).to_equal("board_a")
        expect(parsed[0].credential).to_equal(secret)

        val after = rt_file_read_text(cfg_path) ?? ""
        val upgraded_tok = _extract_password_token(after)
        expect(after).to_contain("# board terminal config")
        expect(after.contains(v1)).to_equal(false)
        expect(upgraded_tok).to_start_with("encrypted:v2:")
        expect(credential_needs_upgrade(upgraded_tok)).to_equal(false)
        expect(credential_decrypt(upgraded_tok, key_path)).to_equal(secret)

        # Second load leaves file byte-identical and resolves cleanly
        val parsed2 = parse_terminal_config_with_key(cfg_path, key_path)
        expect(parsed2.len()).to_equal(1)
        expect(parsed2[0].credential).to_equal(secret)
        expect(rt_file_read_text(cfg_path) ?? "").to_equal(after)

        rt_file_remove(cfg_path)
        rt_file_remove(key_path)

    it "upgrades v1 host power credentials to v2 on parse_power_config_with_key":
        val dir = _tmp_dir()
        val key_path = "{dir}/power_load.key"
        val cfg_path = "{dir}/power_load.sdn"
        rt_file_remove(cfg_path)
        expect(_write_key(key_path)).to_equal(true)

        val secret = "power-secret-v1"
        val v1 = _v1_record(secret)
        val raw = "# power config\npower\n  bench_host\n    kind: host\n    host: 10.0.0.9\n    ssh_port: 22\n    username: pwr\n    auth: password\n    password: {v1}\n    mac: AA:BB:CC:DD:EE:FF\n"
        expect(rt_file_write_text(cfg_path, raw)).to_equal(true)

        val parsed = parse_power_config_with_key(cfg_path, key_path)
        expect(parsed.len()).to_equal(1)
        expect(parsed[0].name).to_equal("bench_host")
        expect(parsed[0].credential).to_equal(secret)

        val after = rt_file_read_text(cfg_path) ?? ""
        val upgraded_tok = _extract_password_token(after)
        expect(after).to_contain("mac: AA:BB:CC:DD:EE:FF")
        expect(after.contains(v1)).to_equal(false)
        expect(upgraded_tok).to_start_with("encrypted:v2:")
        expect(credential_decrypt(upgraded_tok, key_path)).to_equal(secret)

        rt_file_remove(cfg_path)
        rt_file_remove(key_path)

    it "atomically updates an entry field and upgrades untouched v1 credentials via config_update_entry_field_atomic":
        val dir = _tmp_dir()
        val key_path = "{dir}/update_mod.key"
        val cfg_path = "{dir}/update_mod.sdn"
        rt_file_remove(cfg_path)
        expect(_write_key(key_path)).to_equal(true)

        val secret = "modify-keep-secret"
        val v1 = _v1_record(secret)
        val raw = "# header comment\nterminals\n  board_b\n    kind: ssh\n    host: 10.0.0.7\n    port: 22\n    username: admin\n    auth: password\n    password: {v1}\n"
        expect(rt_file_write_text(cfg_path, raw)).to_equal(true)

        val ok = config_update_entry_field_atomic(cfg_path, "terminals", "board_b", "port", "2222", key_path)
        expect(ok).to_equal(true)

        val after = rt_file_read_text(cfg_path) ?? ""
        val upgraded_tok = _extract_password_token(after)
        expect(after).to_contain("# header comment")
        expect(after).to_contain("port: 2222")
        expect(after.contains("port: 22\n")).to_equal(false)
        expect(after.contains(v1)).to_equal(false)
        expect(upgraded_tok).to_start_with("encrypted:v2:")
        expect(credential_decrypt(upgraded_tok, key_path)).to_equal(secret)

        rt_file_remove(cfg_path)
        rt_file_remove(key_path)

    it "writes config atomically and upgrades v1 records via config_save_atomic":
        val dir = _tmp_dir()
        val key_path = "{dir}/save_atomic.key"
        val cfg_path = "{dir}/save_atomic.sdn"
        rt_file_remove(cfg_path)
        expect(_write_key(key_path)).to_equal(true)

        val secret = "save-atomic-secret"
        val v1 = _v1_record(secret)
        val raw = "terminals\n  board_c\n    kind: ssh\n    host: 10.0.0.8\n    port: 22\n    username: userc\n    auth: password\n    password: {v1}\n"

        val upgraded = config_save_atomic(cfg_path, raw, key_path)
        expect(upgraded).to_equal(1)

        val after = rt_file_read_text(cfg_path) ?? ""
        val upgraded_tok = _extract_password_token(after)
        expect(after.contains(v1)).to_equal(false)
        expect(upgraded_tok).to_start_with("encrypted:v2:")
        expect(credential_decrypt(upgraded_tok, key_path)).to_equal(secret)

        rt_file_remove(cfg_path)
        rt_file_remove(key_path)

    it "leaves v1 config untouched when key file is absent and fails closed on unwritable paths":
        val dir = _tmp_dir()
        val absent_key = "{dir}/missing_key_file.key"
        val cfg_path = "{dir}/untouched_v1.sdn"
        rt_file_remove(absent_key)
        rt_file_remove(cfg_path)

        val v1 = _v1_record("keep-untouched")
        val raw = "terminals\n  board_d\n    kind: ssh\n    host: 10.0.0.9\n    port: 22\n    username: userd\n    auth: password\n    password: {v1}\n"
        expect(rt_file_write_text(cfg_path, raw)).to_equal(true)

        val parsed = parse_terminal_config_with_key(cfg_path, absent_key)
        expect(parsed.len()).to_equal(1)
        expect(rt_file_read_text(cfg_path) ?? "").to_equal(raw)

        # Target whose parent is an existing regular file cannot be created.
        val blocked_child = "{cfg_path}/child.sdn"
        expect(config_write_atomic(blocked_child, "test")).to_equal(false)
        expect(config_save_atomic(blocked_child, raw, absent_key)).to_equal(-1)
        expect(config_update_entry_field_atomic("{dir}/absent.sdn", "terminals", "board_d", "port", "2222", absent_key)).to_equal(false)
        expect(config_update_entry_field_atomic(cfg_path, "terminals", "missing_entry", "port", "2222", absent_key)).to_equal(false)
        expect(rt_file_read_text(cfg_path) ?? "").to_equal(raw)

        rt_file_remove(cfg_path)
