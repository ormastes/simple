# Credential store: real AES-256-CBC, random IV, and v1 legacy compatibility
#
# Guards the fix for
# doc/08_tracking/bug/credential_store_aes_cbc_label_is_actually_ctr_with_deterministic_iv_2026-08-07.md
#
# Before 2026-08-08, credential_encrypt derived its IV from a weighted checksum
# of the PLAINTEXT and ran AES-CTR (behind a function named aes_cbc_encrypt),
# so encrypting the same secret twice under the same long-lived key produced
# the identical ciphertext under the identical keystream — leaking
# plaintext_A XOR plaintext_B for any two stored secrets that collided.
#
# This spec pins:
#   - two encryptions of the SAME plaintext differ (the IV is now random)
#   - v2 records round-trip
#   - v1 records written by the old CTR path are STILL readable (migration)

use std.spec.*
use std.terminal.credential.store.{credential_encrypt, credential_decrypt, credential_is_encrypted}
use std.common.aes.modes.{aes_ctr_encrypt}
use std.common.aes.utilities.{aes_text_to_bytes as text_to_bytes, bytes_to_hex, hex_to_bytes}

extern fn rt_file_write_text(path: text, content: text) -> bool

# ============================================================================
# Fixture: a fixed 32-byte AES key written to a scratch key file
# ============================================================================

fn _key_hex() -> text:
    "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4"

fn _key_path() -> text:
    "/tmp/simple_cred_cbc_spec_key.hex"

fn _ensure_key() -> bool:
    rt_file_write_text(_key_path(), _key_hex())

# A v1 (pre-2026-08-08) record: "encrypted:" + hex(iv) + hex(ctr_ciphertext),
# with NO version marker. Built here exactly the way the old code built it, so
# the legacy read path is tested against a real legacy payload rather than a
# guess about its shape.
fn _legacy_v1_record(plaintext: text) -> text:
    val key = hex_to_bytes(_key_hex())
    val pt_bytes = text_to_bytes(plaintext)
    # The old deterministic IV: any fixed 16 bytes reproduce the same shape.
    var iv = []
    var i = 0
    while i < 16:
        iv.append((i * 11 + 5) & 0xFF)
        i = i + 1
    val ct = aes_ctr_encrypt(pt_bytes, key, iv)
    "encrypted:{bytes_to_hex(iv)}{bytes_to_hex(ct)}"

# ============================================================================
# Specs
# ============================================================================

describe "credential store — random-IV AES-256-CBC (v2)":

    it "writes records carrying the v2 version marker":
        expect(_ensure_key()).to_equal(true)
        val enc = credential_encrypt("hunter2", _key_path())
        expect(enc.starts_with("encrypted:v2:")).to_equal(true)

    it "round-trips a credential through encrypt/decrypt":
        expect(_ensure_key()).to_equal(true)
        val enc = credential_encrypt("correct horse battery staple", _key_path())
        expect(credential_decrypt(enc, _key_path())).to_equal("correct horse battery staple")

    it "produces DIFFERENT ciphertext for the SAME plaintext (IV is random)":
        # This is the security-critical assertion. Under the old deterministic
        # plaintext-derived IV these two strings were byte-identical.
        expect(_ensure_key()).to_equal(true)
        val a = credential_encrypt("same_secret_value", _key_path())
        val b = credential_encrypt("same_secret_value", _key_path())
        expect(a == b).to_equal(false)
        expect(credential_decrypt(a, _key_path())).to_equal("same_secret_value")
        expect(credential_decrypt(b, _key_path())).to_equal("same_secret_value")

    it "round-trips a long multi-block credential":
        expect(_ensure_key()).to_equal(true)
        val secret = "0123456789abcdef0123456789abcdef0123456789abcdefEXTRA"
        val enc = credential_encrypt(secret, _key_path())
        expect(credential_decrypt(enc, _key_path())).to_equal(secret)

    it "still reports v2 records as encrypted":
        expect(_ensure_key()).to_equal(true)
        expect(credential_is_encrypted(credential_encrypt("x", _key_path()))).to_equal(true)

describe "credential store — v1 legacy records remain readable (migration)":

    it "decrypts a pre-2026-08-08 CTR record that has no version marker":
        expect(_ensure_key()).to_equal(true)
        val legacy = _legacy_v1_record("legacy_password")
        expect(legacy.starts_with("encrypted:v2:")).to_equal(false)
        expect(credential_decrypt(legacy, _key_path())).to_equal("legacy_password")

    it "decrypts a legacy record whose length is not a multiple of 16":
        # CTR preserved length, so v1 ciphertexts are frequently unaligned —
        # feeding one to the new CBC decryptor would return nothing.
        expect(_ensure_key()).to_equal(true)
        val legacy = _legacy_v1_record("seven17")
        expect(credential_decrypt(legacy, _key_path())).to_equal("seven17")

    it "rejects a value with no encrypted: prefix":
        expect(credential_decrypt("plain_text_value", _key_path())).to_equal("")
