# The v1->v2 credential upgrade PERSISTER, and the mode-carrying write path
# that secret-bearing files land through.
#
# Guards the two follow-ups left open by the 2026-08-08 cipher fix:
#
#   1. credential_upgrade_record had no caller that could WRITE anything --
#      config_parser is entirely read-only -- so v1 records encrypted under the
#      old CTR-with-plaintext-derived-IV scheme lingered on disk forever.
#      credential_upgrade_file is the write owner. The dangerous part is not the
#      crypto, it is the REWRITE: a data-loss path here is worse than the weak
#      encryption it replaces, so the atomicity and byte-preservation cases
#      below are the point of this file.
#
#   2. No write path in the tree accepted a file mode, so every secret was
#      created world/group-readable and only then chmod'd. rt_file_atomic_write_mode
#      closes that window; rt_file_mode is what lets us assert the mode that
#      actually landed on disk instead of trusting chmod's own return value.
#
# DELIBERATELY BCRYPT-FREE. Not one case here calls credential_key_generate or
# eksblowfish_setup -- key files are written with a literal key. A spec that
# performs several key DERIVATIONS aborts the test child with rc=255 and NO
# verdict line at all, which greps identically to "never ran"; see
# doc/08_tracking/bug/credential_kdf_multi_derivation_spec_aborts_runner_2026-08-08.md
#
# REQUIRES the mode externs, which exist only in a seed built after
# 2026-08-08. Run with a freshly built seed if bin/simple predates them.

use std.spec.*
use std.terminal.credential.store.{
    credential_decrypt, credential_needs_upgrade, credential_upgrade_record,
    credential_upgrade_file
}
use std.common.aes.utilities.{bytes_to_hex, hex_to_bytes, aes_text_to_bytes as text_to_bytes}
use std.common.aes.modes.{aes_ctr_encrypt}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_remove(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_atomic_write_mode(path: text, content: text, mode: i32) -> bool
extern fn rt_file_mode(path: text) -> i64
extern fn rt_ensure_dir(path: text) -> bool
extern fn rt_package_chmod(path: text, mode: i32) -> i64

# Fixed 32-byte AES key (NIST SP 800-38A F.2), written straight to a key file so
# no derivation is ever needed.
fn _key_hex() -> text:
    "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4"

fn _write_key(path: text) -> bool:
    rt_file_write_text(path, _key_hex())

# Build a genuine v1 record the way the pre-2026-08-08 code did: AES-CTR under a
# deterministic IV, with no version marker.
fn _v1_record(secret: text) -> text:
    val key = hex_to_bytes(_key_hex())
    var iv: list[i64] = []
    var i = 0
    while i < 16:
        iv.push((i * 11 + 5) & 0xFF)
        i = i + 1
    val ct = aes_ctr_encrypt(text_to_bytes(secret), key, iv)
    "encrypted:{bytes_to_hex(iv)}{bytes_to_hex(ct)}"

# ============================================================================
# P1 -- the persister rewrites records and NOTHING else
# ============================================================================

describe "P1 upgrade persister byte preservation":

    it "upgrades the record and leaves every other byte of the file identical":
        val key_path = "/tmp/simple_cred_persist_p1.key"
        val cfg = "/tmp/simple_cred_persist_p1.sdn"
        expect(_write_key(key_path)).to_equal(true)

        val secret = "hunter2-but-longer"
        val v1 = _v1_record(secret)

        # A config with the things a lossy reparse would destroy: a comment, a
        # blank line, odd indentation, an unrelated key, and NO trailing newline.
        val prefix = "# managed by itf -- do not edit\n\nterminal:\n    name: \"board-a\"\n      password: \""
        val suffix = "\"\n    port: 22\n# trailing comment, no newline after this"
        val before = "{prefix}{v1}{suffix}"
        expect(rt_file_write_text(cfg, before)).to_equal(true)

        val n = credential_upgrade_file(cfg, key_path)
        expect(n).to_equal(1)

        val after = rt_file_read_text(cfg)
        val new_record = after[prefix.length()..(after.length() - suffix.length())]
        # THE byte-exactness oracle. starts_with(prefix) + ends_with(suffix)
        # would only pin the two ENDS: a splice that duplicated the record, or
        # dropped or added bytes between the prefix and the record, passes both
        # of those and still passes a starts_with check on the slice. Asserting
        # the full reconstruction is what actually proves every non-record byte
        # survived and the record appears exactly once.
        expect(prefix + new_record + suffix).to_equal(after)
        # The record itself is now v2...
        expect(new_record.starts_with("encrypted:v2:")).to_equal(true)
        expect(credential_needs_upgrade(new_record)).to_equal(false)
        # ...it is a real re-encryption, not a relabel...
        expect(new_record == v1).to_equal(false)
        # ...and it still decrypts to exactly the original plaintext.
        expect(credential_decrypt(new_record, key_path)).to_equal(secret)

    it "upgrades EVERY v1 record in the file, not just the first":
        val key_path = "/tmp/simple_cred_persist_p1b.key"
        val cfg = "/tmp/simple_cred_persist_p1b.sdn"
        expect(_write_key(key_path)).to_equal(true)

        val a = _v1_record("secret-alpha")
        val b = _v1_record("secret-beta")
        expect(rt_file_write_text(cfg, "x: \"{a}\"\ny: \"{b}\"\n")).to_equal(true)

        expect(credential_upgrade_file(cfg, key_path)).to_equal(2)
        val after = rt_file_read_text(cfg)
        expect(after.contains("encrypted:v2:")).to_equal(true)
        # No v1 record survives: the only "encrypted:" occurrences are v2 ones.
        expect(credential_needs_upgrade(a)).to_equal(true)
        expect(after.contains(a)).to_equal(false)
        expect(after.contains(b)).to_equal(false)

# ============================================================================
# P2 -- no-op when there is nothing to upgrade (no churn, no rewrite loop)
# ============================================================================

describe "P2 clean config is never rewritten":

    it "returns 0 and leaves an all-v2 file byte-identical":
        val key_path = "/tmp/simple_cred_persist_p2.key"
        val cfg = "/tmp/simple_cred_persist_p2.sdn"
        expect(_write_key(key_path)).to_equal(true)

        val v1 = _v1_record("only-once")
        expect(rt_file_write_text(cfg, "p: \"{v1}\"\n")).to_equal(true)
        expect(credential_upgrade_file(cfg, key_path)).to_equal(1)

        val once = rt_file_read_text(cfg)
        # Second pass has nothing to do. If this ever returns > 0 or changes a
        # byte, two sessions reading the same config would rewrite it forever.
        expect(credential_upgrade_file(cfg, key_path)).to_equal(0)
        expect(rt_file_read_text(cfg)).to_equal(once)

    it "ignores the words 'encrypted:' in prose and does not rewrite the file":
        # "encrypted:" occurs in ordinary comments. The scanner finds the
        # substring there too, and credential_needs_upgrade("encrypted:")
        # answers TRUE for the bare prefix -- so without a minimum-body guard
        # every prose mention would be fed to the decryptor, and a decryptor
        # that ever returned non-empty for a body-less record would splice
        # garbage into a comment.
        val key_path = "/tmp/simple_cred_persist_p2c.key"
        val cfg = "/tmp/simple_cred_persist_p2c.sdn"
        expect(_write_key(key_path)).to_equal(true)
        val prose = "# note: the password below is encrypted: yes\n" +
                    "# see docs for encrypted: storage\n" +
                    "name: \"board-c\"\n"
        expect(rt_file_write_text(cfg, prose)).to_equal(true)
        expect(credential_upgrade_file(cfg, key_path)).to_equal(0)
        expect(rt_file_read_text(cfg)).to_equal(prose)

    it "leaves a file with no credential records completely alone":
        val key_path = "/tmp/simple_cred_persist_p2b.key"
        val cfg = "/tmp/simple_cred_persist_p2b.sdn"
        expect(_write_key(key_path)).to_equal(true)
        val plain = "terminal:\n    name: \"board-b\"\n    port: 23\n"
        expect(rt_file_write_text(cfg, plain)).to_equal(true)
        expect(credential_upgrade_file(cfg, key_path)).to_equal(0)
        expect(rt_file_read_text(cfg)).to_equal(plain)

# ============================================================================
# P3 -- the interrupted / failed write leaves the ORIGINAL intact
# ============================================================================

describe "P3 failure leaves the original readable":

    it "keeps the v1 file exactly as it was when the key cannot be read":
        # No key file => credential_upgrade_record cannot round-trip-verify, so
        # nothing may be written. This is the case that would silently blank a
        # credential if the persister trusted the upgrade primitive's output.
        val missing_key = "/tmp/simple_cred_persist_p3_absent.key"
        rt_file_remove(missing_key)
        expect(rt_file_exists(missing_key)).to_equal(false)

        val cfg = "/tmp/simple_cred_persist_p3.sdn"
        val v1 = _v1_record("must-survive")
        val before = "p: \"{v1}\"\n"
        expect(rt_file_write_text(cfg, before)).to_equal(true)

        # 0 upgrades -- and critically NOT a rewrite with an empty credential.
        expect(credential_upgrade_file(cfg, missing_key)).to_equal(0)
        expect(rt_file_read_text(cfg)).to_equal(before)

        # The original is still decryptable under its real key afterwards.
        val key_path = "/tmp/simple_cred_persist_p3.key"
        expect(_write_key(key_path)).to_equal(true)
        expect(credential_decrypt(v1, key_path)).to_equal("must-survive")

    it "leaves the ORIGINAL byte-intact when the atomic write itself fails":
        # The case above only proves the NO-OP path (nothing was ever written).
        # This one actually reaches the write and makes it fail: the config
        # lives in a directory made non-writable, so the same-directory temp
        # cannot be created and the rename never happens. That is the
        # interrupted-write shape -- rename(2) is all-or-nothing, so the
        # original must still be there, complete, and still decryptable.
        val dir = "/tmp/simple_cred_persist_p3ro"
        val cfg = "{dir}/cfg.sdn"
        val key_path = "/tmp/simple_cred_persist_p3ro.key"
        expect(_write_key(key_path)).to_equal(true)
        rt_ensure_dir(dir)
        rt_package_chmod(dir, 0o700)

        val secret = "survives-a-failed-write"
        val v1 = _v1_record(secret)
        val before = "# keep me\np: \"{v1}\"\n"
        expect(rt_file_write_text(cfg, before)).to_equal(true)

        # Sanity: this record IS upgradeable, so a -1 below is the WRITE
        # failing, not "nothing to do". Without this the case would pass
        # vacuously if the record were silently unreadable.
        expect(credential_needs_upgrade(v1)).to_equal(true)
        expect(credential_upgrade_record(v1, key_path).starts_with("encrypted:v2:")).to_equal(true)

        # Now take away write permission on the directory and retry.
        rt_package_chmod(dir, 0o500)
        expect(credential_upgrade_file(cfg, key_path)).to_equal(-1)

        # The original file is byte-for-byte intact, and still decrypts.
        expect(rt_file_read_text(cfg)).to_equal(before)
        expect(credential_decrypt(v1, key_path)).to_equal(secret)

        # Restore so the tree is not left with an unwritable temp dir.
        rt_package_chmod(dir, 0o700)

    it "reports -1 for a file that does not exist and creates nothing":
        val absent = "/tmp/simple_cred_persist_p3_nofile.sdn"
        rt_file_remove(absent)
        expect(credential_upgrade_file(absent, "/tmp/simple_cred_persist_p3.key")).to_equal(-1)
        expect(rt_file_exists(absent)).to_equal(false)

# ============================================================================
# P4 -- the mode-carrying write primitive
# ============================================================================

describe "P4 secret files land at the requested mode":

    it "creates the file at 0600 with no wider window, verified on disk":
        # rt_file_mode is a real stat, not chmod's self-report. Before this
        # primitive existed there was no way to assert this at all.
        val p = "/tmp/simple_cred_persist_p4_600.txt"
        rt_file_remove(p)
        expect(rt_file_atomic_write_mode(p, "SECRET", 0o600)).to_equal(true)
        expect(rt_file_mode(p)).to_equal(0o600)
        expect(rt_file_read_text(p)).to_equal("SECRET")

    it "honours a mode that is NOT 0600 rather than hardcoding one":
        # Sabotage guard: a primitive that always chmod'd 0600 would pass the
        # case above while being wrong.
        val p = "/tmp/simple_cred_persist_p4_644.txt"
        rt_file_remove(p)
        expect(rt_file_atomic_write_mode(p, "PLAIN", 0o644)).to_equal(true)
        expect(rt_file_mode(p)).to_equal(0o644)

    it "NARROWS an existing permissive file instead of inheriting its mode":
        # rt_file_atomic_write (no mode) copies the EXISTING target's
        # permissions onto the temp, so re-writing a secret into an already-0644
        # file would keep it 0644. The mode argument must override that.
        val p = "/tmp/simple_cred_persist_p4_narrow.txt"
        rt_file_remove(p)
        expect(rt_file_atomic_write_mode(p, "was-public", 0o644)).to_equal(true)
        expect(rt_file_mode(p)).to_equal(0o644)
        expect(rt_file_atomic_write_mode(p, "now-secret", 0o600)).to_equal(true)
        expect(rt_file_mode(p)).to_equal(0o600)
        expect(rt_file_read_text(p)).to_equal("now-secret")

    it "reports -1 for the mode of a file that does not exist":
        val p = "/tmp/simple_cred_persist_p4_absent.txt"
        rt_file_remove(p)
        expect(rt_file_mode(p)).to_equal(-1)
