# Credential KEY-FILE format migration, the legacy-clobber guard, and the v1
# record upgrade primitive.
#
# Guards findings F2, F5 and F6 of
# doc/09_report/lib/crypto/credential_store_aes_cbc_adversarial_review_2026-08-08.md
#
# DELIBERATELY BCRYPT-FREE. Not one case here calls eksblowfish_setup, so the
# whole file runs at AES/hex speed. That is a hard constraint, not a
# convenience: a spec performing several key DERIVATIONS aborts the test child
# with rc=255 and no verdict at all under the interpreter -- see
# doc/08_tracking/bug/credential_kdf_multi_derivation_spec_aborts_runner_2026-08-08.md
# Keep derivation-dependent cases in their own file, at most two per file.
#
# What this pins is also the riskiest part of the change: the key-file format
# is versioned, both formats must stay readable, and regenerating over a legacy
# key file must be REFUSED rather than silently destroying every credential
# already stored under that key.

use std.spec.*
use std.terminal.credential.store.{
    credential_load_key, credential_key_generate, credential_kdf_cost,
    credential_encrypt, credential_decrypt,
    credential_needs_upgrade, credential_upgrade_record
}
use std.common.aes.utilities.{bytes_to_hex, hex_to_bytes, aes_text_to_bytes as text_to_bytes}
use std.common.aes.modes.{aes_ctr_encrypt}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text

# A fixed 32-byte AES key (NIST SP 800-38A F.2 key), written straight to a key
# file so no derivation is ever needed.
fn _key_hex() -> text:
    "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4"

# ============================================================================
# F2 -- key-file format: v2 carries a salt, legacy stays readable forever
# ============================================================================

describe "F2 key-file format migration":

    it "loads a LEGACY bare-hex key file unchanged":
        # A pre-2026-08-08 key file is 64 bare hex characters holding the FINAL
        # key. It must keep yielding exactly those bytes -- re-deriving under a
        # new salt would make every credential already on disk unreadable.
        val path = "/tmp/simple_cred_fmt_legacy_spec.key"
        expect(rt_file_write_text(path, _key_hex())).to_equal(true)
        val loaded = credential_load_key(path)
        expect(loaded.length()).to_equal(32)
        expect(bytes_to_hex(loaded)).to_equal(_key_hex())

    it "loads a v2 key file and recovers the KEY, not the salt":
        val salt_hex = "aabbccddeeff00112233445566778899"
        val path = "/tmp/simple_cred_fmt_v2_spec.key"
        expect(rt_file_write_text(path, "v2:{salt_hex}:{_key_hex()}")).to_equal(true)
        val loaded = credential_load_key(path)
        expect(loaded.length()).to_equal(32)
        expect(bytes_to_hex(loaded)).to_equal(_key_hex())

    it "keeps the two formats disjoint in both directions":
        # 'v' and ':' are not hex characters, so a legacy file can never be
        # read as v2 and a v2 file can never be read as legacy.
        expect(_key_hex().starts_with("v2:")).to_equal(false)
        expect("v2:aabb:ccdd".starts_with("v2:")).to_equal(true)

    it "rejects a v2 key file whose key is the wrong length":
        val path = "/tmp/simple_cred_fmt_short_spec.key"
        expect(rt_file_write_text(path, "v2:aabbccddeeff00112233445566778899:0011")).to_equal(true)
        expect(credential_load_key(path).length()).to_equal(0)

    it "returns no key when the file does not exist":
        expect(credential_load_key("/tmp/simple_cred_fmt_absent_spec.key").length()).to_equal(0)

# ============================================================================
# F2 -- the data-loss guard (the most dangerous path in this change)
# ============================================================================

describe "F2 regeneration never clobbers a legacy key file":

    it "REFUSES to overwrite a legacy key file and leaves it byte-identical":
        # The derivation changed with this revision, so regenerating here could
        # not reproduce the key this file holds under ANY salt -- and that key
        # is the only thing that can read the credentials stored under it.
        # Refusing turns silent total data loss into an explicit no-op.
        # (Returns false at the legacy check, BEFORE any derivation runs.)
        val path = "/tmp/simple_cred_fmt_noclobber_spec.key"
        expect(rt_file_write_text(path, _key_hex())).to_equal(true)
        expect(credential_key_generate("any passphrase at all", path)).to_equal(false)
        expect(rt_file_read_text(path).trim()).to_equal(_key_hex())
        expect(bytes_to_hex(credential_load_key(path))).to_equal(_key_hex())

    it "rejects an empty passphrase before doing any work":
        expect(credential_key_generate("", "/tmp/simple_cred_fmt_empty_spec.key")).to_equal(false)

# ============================================================================
# F6 -- the cost gate defaults to production
# ============================================================================

describe "F6 KDF cost resolution":

    it "resolves the production cost of 10 by default":
        # The env gate is opt-in. Unset, out-of-range or unparseable values all
        # fall back to the production default rather than to something weaker.
        #
        # KNOWN RED -- deliberately left failing, see
        # doc/08_tracking/bug/credential_store_module_level_val_reads_wrong_2026-08-08.md
        # Asserted as an EXACT value on purpose: the previous range form
        # (c >= 4 and c <= 16) reported only "false", so three revisions of the
        # implementation were tried without ever learning what the function
        # actually returns. to_equal prints the received value.
        expect(credential_kdf_cost()).to_equal(10)

# ============================================================================
# F5 -- v1 records upgrade to v2, losslessly, with no file I/O in the decryptor
# ============================================================================

describe "F5 legacy v1 record upgrade":

    it "flags a v1 record and leaves v2 and plaintext alone":
        expect(credential_needs_upgrade("encrypted:abcdef0123")).to_equal(true)
        expect(credential_needs_upgrade("encrypted:v2:abcdef0123")).to_equal(false)
        expect(credential_needs_upgrade("just_a_plaintext_password")).to_equal(false)

    it "upgrades a real v1 record to v2 and preserves the plaintext":
        val path = "/tmp/simple_cred_fmt_upgrade_spec.key"
        expect(rt_file_write_text(path, _key_hex())).to_equal(true)

        val secret = "hunter2-but-longer"
        # Build a genuine v1 record exactly the way the pre-2026-08-08 code did:
        # AES-CTR under a deterministic IV, no version marker.
        val key = hex_to_bytes(_key_hex())
        var iv: list[i64] = []
        var i = 0
        while i < 16:
            iv.push((i * 11 + 5) & 0xFF)
            i = i + 1
        val ct = aes_ctr_encrypt(text_to_bytes(secret), key, iv)
        val v1 = "encrypted:{bytes_to_hex(iv)}{bytes_to_hex(ct)}"

        expect(credential_decrypt(v1, path)).to_equal(secret)

        val v2 = credential_upgrade_record(v1, path)
        expect(v2.starts_with("encrypted:v2:")).to_equal(true)
        # The upgrade is a real re-encryption, not a relabel...
        expect(v2 == v1).to_equal(false)
        # ...and it round-trips back to exactly the original plaintext.
        expect(credential_decrypt(v2, path)).to_equal(secret)

    it "returns empty when there is no key to read the record with":
        # "" means "keep what you have", never "write an empty credential".
        val v1 = "encrypted:00000000000000000000000000000000ffffffffffffffffffffffffffffffff"
        expect(credential_upgrade_record(v1, "/tmp/simple_cred_fmt_nokey_spec.key")).to_equal("")

    it "returns empty for a v2 record (nothing to upgrade)":
        val path = "/tmp/simple_cred_fmt_upgrade_spec.key"
        expect(rt_file_write_text(path, _key_hex())).to_equal(true)
        val v2 = credential_encrypt("already current", path)
        expect(v2.starts_with("encrypted:v2:")).to_equal(true)
        expect(credential_upgrade_record(v2, path)).to_equal("")
