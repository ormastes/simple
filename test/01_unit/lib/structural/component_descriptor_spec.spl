# @cover src/lib/common/structural/component/descriptor.spl 80%
"""
# Component Descriptor Specification

## Overview

Verifies the component descriptor contract: fail-closed SDN-subset parsing
of ComponentDescriptor blocks (id, version, presence/placement/activation
axes, provided interfaces, dependencies), validation (unknown axis values,
duplicate ids, dangling dependency references are explicit errors), and the
resolve step whose effective setting string feeds the landed
dynsmf_dynload_setting_parse comma key=value grammar.

## Examples

A two-component catalog parses and validates cleanly; the effective setting
string "presence=auto,placement=auto,activation=command" is accepted by
dynsmf_dynload_setting_parse with matching axis values. Unknown keys,
malformed lines, missing ids, duplicate ids, and dangling dependencies are
all explicit errors.

**Research:** doc/01_research/compiler/startup_performance/startup_perf_architecture_2026-08-17.md
"""

use std.spec
use std.common.structural.component.descriptor.{
    ComponentDescriptor,
    component_descriptor_default,
    component_descriptor_parse_sdn,
    component_catalog_validate,
    component_effective_dynload_setting
}
use os.smf.dynsmf_session.{
    DynSmfManifestEntry,
    dynsmf_dynload_setting_parse
}

fn spec_catalog() -> text:
    "# catalog\n" +
        "component:\n" +
        "  id: compiler.frontend\n" +
        "  version: 1\n" +
        "  presence: on\n" +
        "  placement: static\n" +
        "  activation: command\n" +
        "  provides: frontend.parse, frontend.lex\n" +
        "component:\n" +
        "  id: optimizer.basic\n" +
        "  version: 2\n" +
        "  presence: auto\n" +
        "  placement: auto\n" +
        "  activation: command\n" +
        "  dependencies: compiler.frontend\n"

fn spec_manifest_entry(id: text) -> DynSmfManifestEntry:
    DynSmfManifestEntry(id: id, path: "build/dynsmf/" + id + ".smf", source_module: "test.mod." + id, artifact_kind: "precompiled_smf", abi_version: "1", default_autoload: false, exports: ["run"])

describe "component descriptor SDN parsing":
    it "parses a two-component catalog round trip":
        val out = component_descriptor_parse_sdn(spec_catalog())
        expect(out.ok).to_be_true()
        expect(out.descriptors.len()).to_equal(2)
        val first = out.descriptors[0]
        expect(first.id).to_equal("compiler.frontend")
        expect(first.version).to_equal("1")
        expect(first.presence).to_equal("on")
        expect(first.placement).to_equal("static")
        expect(first.activation).to_equal("command")
        expect(first.provides.len()).to_equal(2)
        expect(first.provides[1]).to_equal("frontend.lex")
        val second = out.descriptors[1]
        expect(second.id).to_equal("optimizer.basic")
        expect(second.dependencies.len()).to_equal(1)
        expect(second.dependencies[0]).to_equal("compiler.frontend")

    it "defaults omitted axes to auto/auto/first_use":
        val out = component_descriptor_parse_sdn("component:\n  id: bare\n")
        expect(out.ok).to_be_true()
        val d = out.descriptors[0]
        expect(d.presence).to_equal("auto")
        expect(d.placement).to_equal("auto")
        expect(d.activation).to_equal("first_use")

    it "fails closed on an unknown key":
        val out = component_descriptor_parse_sdn("component:\n  id: a\n  colour: red\n")
        expect(out.ok).to_be_false()
        expect(out.reason).to_equal("unknown_key:colour")

    it "fails closed on a malformed line":
        val out = component_descriptor_parse_sdn("component:\n  id: a\n  garbage\n")
        expect(out.ok).to_be_false()
        expect(out.reason).to_equal("malformed_line:garbage")

    it "fails closed on a key outside any component block":
        val out = component_descriptor_parse_sdn("id: stray\n")
        expect(out.ok).to_be_false()
        expect(out.reason).to_equal("key_outside_component_block:id: stray")

    it "fails closed on a block without an id":
        val out = component_descriptor_parse_sdn("component:\n  version: 1\n")
        expect(out.ok).to_be_false()
        expect(out.reason).to_equal("missing_id_in_component_block")

describe "component catalog validation":
    it "accepts a clean catalog":
        val out = component_descriptor_parse_sdn(spec_catalog())
        val v = component_catalog_validate(out.descriptors)
        expect(v.ok).to_be_true()
        expect(v.errors.len()).to_equal(0)

    it "rejects duplicate ids explicitly":
        var descs: [ComponentDescriptor] = []
        descs.push(component_descriptor_default("dup.id", "1"))
        descs.push(component_descriptor_default("dup.id", "2"))
        val v = component_catalog_validate(descs)
        expect(v.ok).to_be_false()
        expect(v.errors[0]).to_equal("duplicate_id:dup.id")

    it "rejects unknown axis values explicitly":
        var d = component_descriptor_default("axis.bad", "1")
        d.presence = "maybe"
        d.placement = "floating"
        d.activation = "hotspot"
        var descs: [ComponentDescriptor] = []
        descs.push(d)
        val v = component_catalog_validate(descs)
        expect(v.ok).to_be_false()
        expect(v.errors.len()).to_equal(3)
        expect(v.errors[0]).to_equal("unknown_presence:axis.bad:maybe")
        expect(v.errors[1]).to_equal("unknown_placement:axis.bad:floating")
        expect(v.errors[2]).to_equal("unknown_activation:axis.bad:hotspot")

    it "rejects a dangling dependency reference explicitly":
        var d = component_descriptor_default("needy", "1")
        d.dependencies = ["ghost.component"]
        var descs: [ComponentDescriptor] = []
        descs.push(d)
        val v = component_catalog_validate(descs)
        expect(v.ok).to_be_false()
        expect(v.errors[0]).to_equal("dangling_dependency:needy:ghost.component")

describe "resolve step feeds the landed dynsmf pipeline":
    it "produces a setting string dynsmf_dynload_setting_parse accepts":
        val out = component_descriptor_parse_sdn(spec_catalog())
        expect(out.ok).to_be_true()
        val d = out.descriptors[0]
        val spec_text = component_effective_dynload_setting(d)
        expect(spec_text).to_equal("presence=on,placement=static,activation=command")
        val parsed = dynsmf_dynload_setting_parse(spec_manifest_entry(d.id), spec_text)
        expect(parsed.ok).to_be_true()
        expect(parsed.setting.presence).to_equal("on")
        expect(parsed.setting.placement).to_equal("static")
        expect(parsed.setting.activation).to_equal("command")

    it "handshake stays fail-closed for an invalid axis value on both sides":
        var d = component_descriptor_default("bad.axis", "1")
        d.activation = "hotspot"
        val spec_text = component_effective_dynload_setting(d)
        val parsed = dynsmf_dynload_setting_parse(spec_manifest_entry(d.id), spec_text)
        expect(parsed.ok).to_be_false()
        expect(parsed.reason).to_equal("unknown_activation:hotspot")
