"""
## Purpose and audience
Purpose: Prove that PARSE cpu-reference runtime.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-STRUCTURAL-001 — stable requirement identity for this spec.

# codex-system-test
# @tag: unit, structural_compute, parse
# @cover src/lib/common/structural/parse/ 80%
#
# Behaviour spec for the wave-1 PARSE CPU-reference runtime.
# Plan: doc/03_plan/platform/structural_compute/parser_framework_plan.md
#
# Asserts observable behaviour only — never source text.

use std.spec.*
use common.structural.parse.*

# --------------------------------------------------------------------------
# Test dialect: a four-class, four-state DFA.
#   class 0 = other   class 1 = digit   class 2 = space   class 3 = letter
#   state 0 = start (non-accepting)
#   state 1 = number  (kind 1)
#   state 2 = spacing (kind 2, SKIP - trivia, consumed but never emitted)
#   state 3 = ident   (kind 3)
# --------------------------------------------------------------------------
val T_NUMBER: i64 = 1
val T_SPACE: i64 = 2
val T_IDENT: i64 = 3

fn fixture_byte_class() -> [u8]:
    var out: [u8] = []
    var b = 0
    while b < 256:
        var cls = 0
        if b >= 48 and b <= 57:
            cls = 1
        elif b == 32:
            cls = 2
        elif (b >= 97 and b <= 122) or (b >= 65 and b <= 90):
            cls = 3
        out = out.push(cls as u8)
        b = b + 1
    out

fn fixture_transitions() -> [u32]:
    val no = PARSE_NO_ID
    # rows: state 0..3, columns: class 0..3
    [no, 1u32, 2u32, 3u32,
     no, 1u32, no, no,
     no, no, 2u32, no,
     no, 3u32, no, 3u32]

fn fixture_dialect() -> ParseDialect:
    val program = parse_lex_program(
        7u32,
        4,
        4,
        0u32,
        fixture_byte_class(),
        fixture_transitions(),
        [0u16, 1u16, 2u16, 3u16],
        [PARSE_STATE_FLAG_NONE, PARSE_STATE_FLAG_NONE, PARSE_STATE_FLAG_SKIP, PARSE_STATE_FLAG_NONE])
    parse_dialect_lexical(11u32, program)

fn roomy_capacity() -> ParseCapacityManifest:
    # Bounds supplied BY THE TEST. The product invents no default: an unset
    # bound fails closed, which the fail-closed examples below assert.
    parse_capacity_manifest(max_source_bytes: 4096, max_tokens: 256, max_diagnostics: 64)

fn request_for(source: text, mode: text) -> ParseRequest:
    parse_request(
        parse_source_blob_from_text(source),
        0u32,
        PARSE_OUTPUT_TOKENS | PARSE_OUTPUT_DIAGNOSTICS,
        PARSE_TAG_DEMAND_OFF,
        mode,
        roomy_capacity())

fn run_cpu(source: text) -> ParseResult:
    parse_run(fixture_dialect(), request_for(source, PARSE_MODE_CPU_REFERENCE))

use std.spec.step

describe "PARSE cpu-reference runtime":
    """The wave-1 oracle: a scalar maximal-munch DFA over a flat byte buffer.

    Every later SIMD or GPU executor must reproduce these tokens,
    diagnostics and deterministic hashes exactly.
    """

    it "produces no tokens and no diagnostics for empty input":
        step("Verify: produces no tokens and no diagnostics for empty input")
        # @req: REQ-LIB-STRUCTURAL-001
        val result = run_cpu("")

        expect(parse_token_arena_len(result.tokens)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_diagnostic_arena_len(result.diagnostics)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.receipt.item_count_in).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.receipt.malformed_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_true(result.ok)

    it "emits one span token per maximal munch rather than one per byte":
        step("Verify: emits one span token per maximal munch rather than one per byte")
        val result = run_cpu("1234")

        expect(parse_token_arena_len(result.tokens)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val token = parse_token_at(result.tokens, 0)
        expect(token.kind.to_i64()).to_equal(T_NUMBER)
        expect(token.start.to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(token.count.to_i64()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "records byte spans into the source blob instead of copying text":
        step("Verify: records byte spans into the source blob instead of copying text")
        val result = run_cpu("ab 12")

        expect(parse_token_arena_len(result.tokens)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val ident = parse_token_at(result.tokens, 0)
        val number = parse_token_at(result.tokens, 1)
        expect(ident.kind.to_i64()).to_equal(T_IDENT)
        expect(ident.start.to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ident.count.to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(number.kind.to_i64()).to_equal(T_NUMBER)
        expect(number.start.to_i64()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(number.count.to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "consumes trivia states without emitting a token for them":
        step("Verify: consumes trivia states without emitting a token for them")
        val result = run_cpu("a   b")

        expect(parse_token_arena_len(result.tokens)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parse_token_at(result.tokens, 1).start.to_i64()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        var space_tokens = 0
        var i = 0
        while i < parse_token_arena_len(result.tokens):
            if parse_token_at(result.tokens, i).kind.to_i64() == T_SPACE:
                space_tokens = space_tokens + 1
            i = i + 1
        expect(space_tokens).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports one diagnostic spanning a whole unrecognized run":
        step("Verify: reports one diagnostic spanning a whole unrecognized run")
        val result = run_cpu("a##b")

        expect(parse_diagnostic_arena_len(result.diagnostics)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val diag = parse_diagnostic_at(result.diagnostics, 0)
        expect(diag.code.to_i64()).to_equal(PARSE_DIAG_UNRECOGNIZED_BYTE.to_i64())
        expect(diag.start.to_i64()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(diag.count.to_i64()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(result.receipt.malformed_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        assert_false(result.ok)

    it "still recovers the tokens that follow an unrecognized run":
        step("Verify: still recovers the tokens that follow an unrecognized run")
        val result = run_cpu("a##b")

        expect(parse_token_arena_len(result.tokens)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parse_token_at(result.tokens, 0).start.to_i64()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_token_at(result.tokens, 1).start.to_i64()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "rejects a request whose capacity bounds are unset":
        step("Verify: rejects a request whose capacity bounds are unset")
        val dialect = fixture_dialect()
        val request = parse_request(
            parse_source_blob_from_text("ab"),
            0u32,
            PARSE_OUTPUT_TOKENS,
            PARSE_TAG_DEMAND_OFF,
            PARSE_MODE_CPU_REFERENCE,
            parse_capacity_manifest_zero())
        val result = parse_run(dialect, request)

        expect(result.receipt.fallback_reason).to_equal("parse_capacity_bound_unset:max_source_bytes")
        expect(parse_token_arena_len(result.tokens)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_false(result.ok)

    it "names the exceeded bound when the source is larger than the manifest allows":
        step("Verify: names the exceeded bound when the source is larger than the manifest allows")
        val dialect = fixture_dialect()
        val request = parse_request(
            parse_source_blob_from_text("abcdef"),
            0u32,
            PARSE_OUTPUT_TOKENS,
            PARSE_TAG_DEMAND_OFF,
            PARSE_MODE_CPU_REFERENCE,
            parse_capacity_manifest(2, 8, 8))
        val result = parse_run(dialect, request)

        expect(result.receipt.fallback_reason).to_equal("parse_capacity_exceeded:max_source_bytes")
        assert_false(result.ok)

    it "fails closed rather than truncating when the token bound is reached":
        step("Verify: fails closed rather than truncating when the token bound is reached")
        val dialect = fixture_dialect()
        val request = parse_request(
            parse_source_blob_from_text("a b c d"),
            0u32,
            PARSE_OUTPUT_TOKENS | PARSE_OUTPUT_DIAGNOSTICS,
            PARSE_TAG_DEMAND_OFF,
            PARSE_MODE_CPU_REFERENCE,
            parse_capacity_manifest(64, 2, 8))
        val result = parse_run(dialect, request)

        expect(result.receipt.fallback_reason).to_equal("parse_capacity_exceeded:max_tokens")
        expect(parse_token_arena_len(result.tokens)).to_equal(2)  # oracle: 2 — named expected value from the requirement
        assert_false(result.ok)

    it "rejects a structurally malformed lex program instead of coercing it":
        step("Verify: rejects a structurally malformed lex program instead of coercing it")
        val broken = parse_lex_program(
            7u32,
            4,
            4,
            0u32,
            fixture_byte_class(),
            [0u32, 1u32],
            [0u16, 1u16, 2u16, 3u16],
            [0u16, 0u16, 0u16, 0u16])
        val dialect = parse_dialect_lexical(11u32, broken)
        val result = parse_run(dialect, request_for("ab", PARSE_MODE_CPU_REFERENCE))

        expect(result.receipt.fallback_reason).to_equal("parse_lex_program_malformed")
        assert_false(result.ok)

    it "allocates no tags when tag demand is off":
        step("Verify: allocates no tags when tag demand is off")
        val result = run_cpu("ab 12 cd")

        expect(result.tags_emitted).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_token_arena_len(result.tokens)).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "counts a tag only once tag demand is enabled":
        step("Verify: counts a tag only once tag demand is enabled")
        # `on` and `off` are soft keywords — do not name locals after them.
        val demand_off = parse_sink_emit_tag(parse_action_sink_new(PARSE_TAG_DEMAND_OFF), 5u32)
        val demand_all = parse_sink_emit_tag(parse_action_sink_new(PARSE_TAG_DEMAND_ALL), 5u32)

        expect(demand_off.tags_emitted).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(demand_all.tags_emitted).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "demotes an unimplemented accelerated mode and records why":
        step("Verify: demotes an unimplemented accelerated mode and records why")
        val result = parse_run(fixture_dialect(), request_for("ab 12", PARSE_MODE_HYBRID_VECTOR_GPU))

        expect(result.receipt.candidate_backend).to_equal("hybrid_vector_gpu")
        expect(result.receipt.backend).to_equal("cpu_reference")
        expect(result.receipt.fallback_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.receipt.fallback_reason).to_equal("parse_mode_unimplemented")
        assert_true(result.ok)

    it "produces results identical to the oracle when a mode is demoted":
        step("Verify: produces results identical to the oracle when a mode is demoted")
        val oracle = run_cpu("ab 12 cd")
        val demoted = parse_run(fixture_dialect(), request_for("ab 12 cd", PARSE_MODE_RESIDENT_GPU))

        expect(demoted.receipt.deterministic_hash).to_equal(oracle.receipt.deterministic_hash)
        expect(parse_token_arena_len(demoted.tokens)).to_equal(parse_token_arena_len(oracle.tokens))
        expect(demoted.receipt.fallback_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(oracle.receipt.fallback_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "hard rejects an unknown execution mode instead of defaulting":
        step("Verify: hard rejects an unknown execution mode instead of defaulting")
        val result = parse_run(fixture_dialect(), request_for("ab 12", "turbo"))

        expect(result.receipt.fallback_reason).to_equal("parse_mode_unknown")
        expect(parse_token_arena_len(result.tokens)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.receipt.fallback_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_false(result.ok)

    it "gives the same deterministic hash for repeated runs of the same input":
        step("Verify: gives the same deterministic hash for repeated runs of the same input")
        val a1 = run_cpu("ab 12")
        val a2 = run_cpu("ab 12")

        expect(a1.receipt.deterministic_hash).to_equal(a2.receipt.deterministic_hash)
        expect(a1.receipt.deterministic_hash).to_equal(a1.receipt.output_hash)

    it "hashes the token stream structurally, so a different stream hashes differently":
        step("Verify: hashes the token stream structurally, so a different stream hashes differently")
        # "ab 13" has the SAME kinds and spans as "ab 12"; the parity hash
        # covers the token stream, not the source bytes.
        val same_stream = run_cpu("ab 13")
        val other_stream = run_cpu("abc 12")
        val baseline = run_cpu("ab 12")

        expect(same_stream.receipt.deterministic_hash).to_equal(baseline.receipt.deterministic_hash)
        assert_false(other_stream.receipt.deterministic_hash == baseline.receipt.deterministic_hash)

    it "suppresses token output when the output mask does not request tokens":
        step("Verify: suppresses token output when the output mask does not request tokens")
        val dialect = fixture_dialect()
        val request = parse_request(
            parse_source_blob_from_text("ab 12"),
            0u32,
            PARSE_OUTPUT_DIAGNOSTICS,
            PARSE_TAG_DEMAND_OFF,
            PARSE_MODE_CPU_REFERENCE,
            roomy_capacity())
        val result = parse_run(dialect, request)

        expect(parse_token_arena_len(result.tokens)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.receipt.item_count_in).to_equal(5)  # oracle: 5 — named expected value from the requirement
        assert_true(result.ok)
