# codex-system-test
# @tag: unit, structural_compute, layout
# @req REQ-001
# @req REQ-002
# @req REQ-004
# @req REQ-005
# @req REQ-007
# @req REQ-008
# @cover src/lib/common/structural/layout/ 80%

use std.spec.step

use std.spec.*
use common.structural.layout.*
use common.structural.execution.contracts.{STRUCTURAL_EXECUTION_CONTRACT_VERSION, LAYOUT_EXECUTION_CONTRACT_VERSION, BackendId, CostEstimate, ExecutionMode, Hash256, StageId, StageReceipt}
use common.compute.placement_contracts.handles.{ArenaResidency, ObjectRef}

fn unit_execution(mode: text, cpu_us: i64, kernel_us: i64, scheduling_us: i64) -> LayoutExecutionProfile:
    layout_execution_profile(mode, cpu_us, kernel_us, scheduling_us, 1024, 1024, 2, 10, 5)

fn unit_node(
    id: i64,
    parent_id: i64,
    profile_id: text,
    boundary: bool,
    contained: bool,
    estimated_work: i64,
    required_iterations: i64
) -> LayoutNodeInput:
    layout_node(
        id,
        parent_id,
        profile_id,
        boundary,
        contained,
        layout_box(id, id * 10, id * 5, 100, 20),
        if id == 3: 1 else: 0,
        estimated_work,
        profile_id == "inline",
        required_iterations
    )

fn unit_input(nodes: [LayoutNodeInput], dependencies: [LayoutDependency], cap: i64) -> LayoutInputSnapshot:
    layout_input(nodes, dependencies, [3], unit_execution("hybrid_vector_gpu", 200, 40, 20), cap)

describe "layout framework unit contract":
    it "should preserve versioned flat input values":
        # @req REQ-SSPEC-LIB
        step("should preserve versioned flat input values")
        val box = layout_box(7, 10, 20, 300, 40)
        val node = layout_node(7, 0, "block", true, false, box, 5, 9, false, 1)
        val dependency = layout_dependency(7, 8, "intrinsic-size", 4)
        val input = layout_input([node], [dependency], [7], unit_execution("serial_cpu", 80, 30, 10), 4)

        expect(input.contract_version).to_equal(1)
        expect(input.nodes[0].oracle_box).to_equal(box)
        expect(input.nodes[0].dirty_bits).to_equal(5)
        expect(input.nodes[0].dirty.bits).to_equal(5)
        expect(input.dependencies[0].kind).to_equal("intrinsic-size")
        expect(input.dependencies[0].invalidates.bits).to_equal(4)
        expect(input.invalidated_ids).to_equal([7])
        expect(input.fixed_point_cap).to_equal(4)

    it "should expose the complete serial profile catalog":
        # @req REQ-SSPEC-LIB
        step("should expose the complete serial profile catalog")
        val catalog = layout_profile_catalog()
        expect(catalog.len()).to_equal(8)
        expect(catalog[0].profile_id()).to_equal("block")
        expect(catalog[1].profile_id()).to_equal("inline")
        expect(catalog[2].profile_id()).to_equal("flex")
        expect(catalog[3].profile_id()).to_equal("grid")
        expect(catalog[4].profile_id()).to_equal("table")
        expect(catalog[5].profile_id()).to_equal("absolute-sticky")
        expect(catalog[6].profile_id()).to_equal("scroll")
        expect(catalog[7].profile_id()).to_equal("replaced")
        val catalog_evidence = scenario_api_evidence("layout profile catalog", "GET", "layout/profile-catalog", 200, "count={catalog.len()} last={catalog[catalog.len() - 1].profile_id()}", "layout-framework", "catalog")
        expect(catalog_evidence.body).to_contain("count=8 last=replaced")

    it "should discover stable boundary and containment islands":
        # @req REQ-SSPEC-LIB
        step("should discover stable boundary and containment islands")
        val nodes = [
            unit_node(1, 0, "block", true, false, 10, 1),
            unit_node(2, 1, "block", false, false, 5, 1),
            unit_node(3, 1, "flex", true, false, 20, 1),
            unit_node(4, 3, "grid", false, true, 30, 1)
        ]
        val input = unit_input(nodes, [], 4)
        val first = layout_discover_islands(input)
        val second = layout_discover_islands(input)

        expect(first.fault).to_equal("")
        expect(first.islands).to_equal(second.islands)
        expect(first.islands.len()).to_equal(3)
        expect(first.islands[0].node_ids).to_equal([1, 2])
        expect(first.islands[0].estimated_work).to_equal(15)
        expect(first.islands[1].node_ids).to_equal([3])
        expect(first.islands[2].node_ids).to_equal([4])
        val island_evidence = scenario_api_evidence("island partition", "GET", "layout/islands", 200, "islands={first.islands.len()} first={first.islands[0].node_ids}", "layout-framework", "islands")
        expect(island_evidence.body).to_contain("islands=3 first=[1, 2]")

    it "should condense cycles and emit deterministic topological waves":
        # @req REQ-SSPEC-LIB
        step("should condense cycles and emit deterministic topological waves")
        val nodes = [
            unit_node(1, 0, "block", true, false, 10, 1),
            unit_node(2, 0, "block", true, false, 10, 2),
            unit_node(3, 0, "block", true, false, 10, 2),
            unit_node(4, 0, "block", true, false, 10, 1)
        ]
        val dependencies = [
            layout_dependency(1, 2, "containing-block", 1),
            layout_dependency(2, 3, "percentage", 1),
            layout_dependency(3, 2, "baseline", 1),
            layout_dependency(3, 4, "track-column", 1)
        ]
        val islands = layout_discover_islands(unit_input(nodes, dependencies, 3)).islands
        val scheduled = layout_schedule_waves(islands, dependencies, 3)

        expect(scheduled.converged).to_equal(true)
        expect(scheduled.reason).to_equal("")
        expect(scheduled.iterations).to_equal(2)
        expect(scheduled.waves.len()).to_equal(3)
        expect(scheduled.waves[0].island_ids).to_equal([1])
        expect(scheduled.waves[1].island_ids).to_equal([2, 3])
        expect(scheduled.waves[2].island_ids).to_equal([4])
        val wave_evidence = scenario_api_evidence("scheduled waves", "GET", "layout/waves", 200, "waves={scheduled.waves.len()} cyclic={scheduled.cyclic_island_ids}", "layout-framework", "waves")
        expect(wave_evidence.body).to_contain("waves=3 cyclic=[2, 3]")

    it "should leave cyclic convergence to execution":
        # @req REQ-SSPEC-LIB
        step("should leave cyclic convergence to execution")
        val nodes = [
            unit_node(1, 0, "block", true, false, 10, 3),
            unit_node(2, 0, "block", true, false, 10, 3)
        ]
        val dependencies = [
            layout_dependency(1, 2, "percentage", 1),
            layout_dependency(2, 1, "intrinsic-size", 1)
        ]
        val islands = layout_discover_islands(unit_input(nodes, dependencies, 2)).islands
        val scheduled = layout_schedule_waves(islands, dependencies, 2)

        expect(scheduled.converged).to_equal(false)
        expect(scheduled.iterations).to_equal(2)
        expect(scheduled.reason).to_equal("non-convergent")

    it "should reject malformed scheduler inputs explicitly":
        # @req REQ-SSPEC-LIB
        step("should reject malformed scheduler inputs explicitly")
        val nodes = [unit_node(1, 0, "block", true, false, 10)]
        val missing = [layout_dependency(1, 99, "percentage", 1)]
        val islands = layout_discover_islands(unit_input(nodes, missing, 1)).islands

        expect(layout_schedule_waves(islands, missing, 1).reason).to_equal("missing-dependency-endpoint")
        expect(layout_schedule_waves(islands, [], 0).reason).to_equal("invalid-fixed-point-cap")
        val reject_evidence = scenario_api_evidence("scheduler rejection", "GET", "layout/schedule", 400, "reason={layout_schedule_waves(islands, missing, 1).reason}", "layout-framework", "reject")
        expect(reject_evidence.body).to_contain("reason=missing-dependency-endpoint")

    it "should propagate incremental dependencies from producer to consumer":
        # @req REQ-SSPEC-LIB
        step("should propagate incremental dependencies from producer to consumer")
        val nodes = [
            unit_node(1, 0, "block", true, false, 10),
            unit_node(2, 1, "block", false, false, 10)
        ]
        val dependencies = [layout_dependency(1, 2, "containing-context", 1)]
        val input = layout_input(
            nodes, dependencies, [1], unit_execution("serial_cpu", 80, 30, 10), 4,
            0, 0, [], [
                layout_box(1, 0, 0, 10, 10),
                layout_box(2, 0, 10, 10, 10)
            ]
        )
        val result = layout_run_incremental(input, layout_text_measure_port_unavailable())

        expect(result.receipt.mode).to_equal("incremental")
        expect(result.receipt.visited_island_ids).to_equal([1, 2])
        val receipt_evidence = scenario_api_evidence("incremental receipt", "GET", "layout/incremental", 200, "mode={result.receipt.mode}", "layout-framework", "incremental")
        expect(receipt_evidence.body).to_contain("mode=incremental")

    it "should include scheduling transfer and synchronization in backend cost":
        # @req REQ-SSPEC-LIB
        step("should include scheduling transfer and synchronization in backend cost")
        val nodes = [
            unit_node(1, 0, "grid", true, false, 100, 1),
            unit_node(2, 0, "grid", true, false, 100, 1)
        ]
        val islands = layout_discover_islands(unit_input(nodes, [], 2)).islands
        val gpu = layout_choose_backend(islands, layout_execution_profile("hybrid_vector_gpu", 200, 40, 20, 1024, 1024, 2, 10, 5))
        val cpu = layout_choose_backend(islands, layout_execution_profile("hybrid_vector_gpu", 80, 40, 20, 1024, 1024, 2, 10, 5))

        expect(gpu.gpu_us).to_equal(90)
        expect(gpu.cpu_us).to_equal(200)
        expect(gpu.backend).to_equal("hybrid_vector_gpu")
        expect(cpu.gpu_us).to_equal(90)
        expect(cpu.backend).to_equal("serial_cpu")
        expect(cpu.reason).to_equal("gpu-cost-not-lower")
        val cost_evidence = scenario_api_evidence("backend cost split", "GET", "layout/backend-cost", 200, "gpu={gpu.gpu_us} cpu={gpu.cpu_us} backend={gpu.backend}", "layout-framework", "cost")
        expect(cost_evidence.body).to_contain("gpu=90 cpu=200 backend=hybrid_vector_gpu")

    it "should keep text and unsupported profiles on the CPU":
        # @req REQ-SSPEC-LIB
        step("should keep text and unsupported profiles on the CPU")
        val inline_nodes = [unit_node(1, 0, "inline", true, false, 100)]
        val table_nodes = [unit_node(1, 0, "table", true, false, 100)]
        val inline_islands = layout_discover_islands(unit_input(inline_nodes, [], 2)).islands
        val table_islands = layout_discover_islands(unit_input(table_nodes, [], 2)).islands
        val fast_gpu = layout_execution_profile("hybrid_vector_gpu", 500, 10, 5, 0, 0, 0, 0, 0)

        expect(layout_choose_backend(inline_islands, fast_gpu).reason).to_equal("text-measure-required")
        expect(layout_choose_backend(table_islands, fast_gpu).reason).to_equal("unsupported-gpu-profile")
        expect(layout_choose_backend(inline_islands, fast_gpu).backend).to_equal("serial_cpu")
        val fallback_evidence = scenario_api_evidence("CPU fallback reasons", "GET", "layout/backend", 200, "inline={layout_choose_backend(inline_islands, fast_gpu).reason} table={layout_choose_backend(table_islands, fast_gpu).reason}", "layout-framework", "fallback")
        expect(fallback_evidence.body).to_contain("inline=text-measure-required table=unsupported-gpu-profile")

    it "should reject heterogeneous GPU batches before execution":
        # @req REQ-SSPEC-LIB
        step("should reject heterogeneous GPU batches before execution")
        val nodes = [
            unit_node(1, 0, "block", true, false, 100, 1),
            unit_node(2, 0, "grid", true, false, 100, 1)
        ]
        val islands = layout_discover_islands(unit_input(nodes, [], 2)).islands
        val fast_gpu = layout_execution_profile("hybrid_vector_gpu", 500, 10, 5, 0, 0, 0, 0, 0)
        expect(layout_choose_backend(islands, fast_gpu).backend).to_equal("serial_cpu")
        expect(layout_choose_backend(islands, fast_gpu).reason).to_equal("heterogeneous-gpu-batch")
        val hetero_evidence = scenario_api_evidence("heterogeneous batch", "GET", "layout/backend", 200, "backend={layout_choose_backend(islands, fast_gpu).backend} reason={layout_choose_backend(islands, fast_gpu).reason}", "layout-framework", "heterogeneous")
        expect(hetero_evidence.body).to_contain("backend=serial_cpu reason=heterogeneous-gpu-batch")
