# @cover src/lib/common/structural/component/resolver.spl 90%
"""Pure component candidate parser, validator, and resolution kernel."""

use std.spec.{describe, it, assert_eq}
use std.common.structural.component.resolver.{
    ComponentResolverCatalog,
    component_resolver_catalog_default,
    static_component_candidate,
    dynamic_component_locator,
    component_resolve_request,
    component_resolver_parse_status,
    component_resolve_verdict
}

fn resolver_catalog() -> ComponentResolverCatalog:
    var catalog = component_resolver_catalog_default()
    catalog.static_candidates.push(static_component_candidate("compiler.frontend", "frontend.parse", "frontend.static", "1", "sha-static", 3, ["linux-x86_64"], ["release"] ))
    catalog.dynamic_locators.push(dynamic_component_locator("compiler.frontend", "frontend.parse", "frontend.smf", "1", "sha-smf", 7, ["*"], ["release", "debug"], "smf_artifact", "build/components/frontend.smf"))
    catalog.dynamic_locators.push(dynamic_component_locator("optimizer.basic", "optimizer.run", "optimizer.remote", "1", "sha-remote", 1, ["linux-x86_64"], ["release"], "remote", "component://optimizer.basic"))
    catalog

fn resolver_source() -> text:
    "static_candidate:\n" +
        "  component_id: compiler.frontend\n" +
        "  interface_name: frontend.parse\n" +
        "  implementation_id: frontend.static\n" +
        "  version: 1\n" +
        "  impl_digest: sha-static\n" +
        "  capability_bits: 3\n" +
        "  targets: linux-x86_64\n" +
        "  profiles: release\n" +
        "dynamic_locator:\n" +
        "  component_id: optimizer.basic\n" +
        "  interface_name: optimizer.run\n" +
        "  implementation_id: optimizer.smf\n" +
        "  version: 1\n" +
        "  impl_digest: sha-smf\n" +
        "  capability_bits: 1\n" +
        "  targets: *\n" +
        "  profiles: release, debug\n" +
        "  source_kind: smf_artifact\n" +
        "  locator: build/components/optimizer.smf\n"

describe "component resolver catalog parser":
    it "parses and validates static candidates and dynamic locators":
        assert_eq(component_resolver_parse_status(resolver_source()), "ok:1:1")

    it "fails closed on unknown fields and invalid capability text":
        assert_eq(component_resolver_parse_status("static_candidate:\n  mystery: value\n"), "err:unknown_key:mystery")
        assert_eq(component_resolver_parse_status("static_candidate:\n  capability_bits: -1\n"), "err:invalid_capability_bits:-1")

    it "reports incomplete records through validation":
        assert_eq(component_resolver_parse_status("dynamic_locator:\n  component_id: only.id\n"), "err:incomplete_dynamic_locator:only.id||")

describe "component resolver policy":
    it "prefers the compatible static candidate":
        val req = component_resolve_request("compiler.frontend", "frontend.parse", 1, "linux-x86_64", "release")
        assert_eq(component_resolve_verdict(resolver_catalog(), req), "ok:static:frontend.static:static_candidate:")

    it "uses the dynamic locator when static target gating rejects it":
        val req = component_resolve_request("compiler.frontend", "frontend.parse", 4, "macos-arm64", "debug")
        assert_eq(component_resolve_verdict(resolver_catalog(), req), "ok:dynamic:frontend.smf:smf_artifact:build/components/frontend.smf")

    it "discriminates missing identity, target, profile, and capability":
        assert_eq(component_resolve_verdict(resolver_catalog(), component_resolve_request("missing", "iface", 0, "linux-x86_64", "release")), "err:component_interface_not_found")
        assert_eq(component_resolve_verdict(resolver_catalog(), component_resolve_request("optimizer.basic", "optimizer.run", 0, "macos-arm64", "release")), "err:target_denied")
        assert_eq(component_resolve_verdict(resolver_catalog(), component_resolve_request("optimizer.basic", "optimizer.run", 0, "linux-x86_64", "debug")), "err:profile_denied")
        assert_eq(component_resolve_verdict(resolver_catalog(), component_resolve_request("optimizer.basic", "optimizer.run", 2, "linux-x86_64", "release")), "err:capability_denied")

    it "fails closed when two compatible implementations occupy one tier":
        var catalog = resolver_catalog()
        catalog.static_candidates.push(static_component_candidate("compiler.frontend", "frontend.parse", "frontend.static.alt", "1", "sha-alt", 3, ["linux-x86_64"], ["release"] ))
        val req = component_resolve_request("compiler.frontend", "frontend.parse", 1, "linux-x86_64", "release")
        assert_eq(component_resolve_verdict(catalog, req), "err:ambiguous_static_candidate")
