"""
## Purpose and audience
Purpose: Prove that damage_plan branch coverage.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-UI-001 — stable requirement identity for this spec.

# @cover src/lib/common/ui/render_opt/damage_plan.spl 60%
# @cover src/lib/common/ui/render_opt/damage_tiles.spl 60%
# @tag: unit, ui, render_opt, damage_plan, damage_tiles, branch_coverage
#
# EXCLUSION (see doc/08_tracking/bug/
# spec_runner_indexed_augmented_assignment_unsupported_2026-08-15.md):
# the spec-runner interpreter rejects indexed augmented assignment
# (`arr[i] += v`, `self.field[i] += v`) with "semantic: invalid assignment:
# unsupported augmented assignment target", while `bin/simple run` executes
# the same code fine. This makes three library paths untestable from specs:
#   - DirtyTilePyramid.mark_rect (self.dirty_len[level] += 1) — worked
#     around below by writing tile_epoch slots directly via mark_tile();
#     mark_rect's own clamp/guard branches stay uncovered.
#   - damage_tiles_mark_property_damage with a non-empty damage list
#     (it calls mark_rect); only the empty-list path is exercised.
#   - build_damage_plan's vertical run merge (rects[rect_index + 3] += h);
#     no test creates vertically mergeable equal-width runs, so
#     merged-across-rows behavior is asserted only for the horizontal case.
# Measured with the workaround: damage_plan 89% (17/19) and damage_tiles
# 93% (15/16) branch decisions; the remainder is the excluded code above.

use std.spec
use common.ui.render_opt.property_trees.PropertyTrees
use common.ui.render_opt.damage_tiles.{
    DirtyTilePyramid, damage_tiles_mark_property_damage
}
use common.ui.render_opt.damage_plan.{
    DamagePlanPolicy, DamagePlan, build_damage_plan,
    DAMAGE_PLAN_NONE, DAMAGE_PLAN_LOCAL, DAMAGE_PLAN_FULL,
    DAMAGE_FALLBACK_NONE, DAMAGE_FALLBACK_AREA, DAMAGE_FALLBACK_CAP,
    DAMAGE_FALLBACK_INVALID
}

fn grid(w: i64, h: i64, tile: i64) -> DirtyTilePyramid:
    DirtyTilePyramid.create(w, h, [tile], [tile])

# Direct-epoch marking workaround for the mark_rect exclusion above.
fn mark_tile(d: DirtyTilePyramid, level: i64, tx: i64, ty: i64):
    val slot = d.level_offset[level] + ty * d.cols[level] + tx
    d.tile_epoch[slot] = d.frame_epoch

fn plan_with(d: DirtyTilePyramid, cap: i64, threshold: i64) -> DamagePlan:
    build_damage_plan(d, 0, DamagePlanPolicy.create(cap, threshold))

fn plan(d: DirtyTilePyramid) -> DamagePlan:
    plan_with(d, 64, 60)

describe "damage_plan branch coverage":
    it "returns NONE for a zero-area viewport (invalid pyramid, no full fallback)":
        step("Verify: returns NONE for a zero-area viewport (invalid pyramid, no full fallback)")
        # @req: REQ-LIB-UI-001
        val d = grid(0, 0, 64)
        expect(d.valid).to_equal(false)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_NONE)
        expect(p.output_rect_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_NONE)
        expect(p.tiles_examined).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.full_fallback_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns NONE with all tiles examined when nothing is marked":
        step("Verify: returns NONE with all tiles examined when nothing is marked")
        val d = grid(128, 128, 64)
        expect(d.valid).to_equal(true)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_NONE)
        expect(p.source_tile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.planned_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.tiles_examined).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "plans LOCAL for a single dirty tile with the exact tile rect":
        step("Verify: plans LOCAL for a single dirty tile with the exact tile rect")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.output_rect_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.rects.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(p.rects[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[1]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[2]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[3]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.source_tile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
        expect(p.planned_pixels).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
        expect(p.full_fallback_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_NONE)
        expect(p.tiles_examined).to_equal(80)  # oracle: 80 — named expected value from the requirement

    it "merges a horizontal run of tiles into one rect":
        step("Verify: merges a horizontal run of tiles into one rect")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 1, 0)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.source_tile_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(p.output_rect_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.rects[0]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[1]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[2]).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(p.rects[3]).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "keeps rows with different run widths as separate rects":
        step("Verify: keeps rows with different run widths as separate rects")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 0, 1)
        mark_tile(d, 0, 1, 1)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.source_tile_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(p.output_rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.rects[4]).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[5]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[6]).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(p.rects[7]).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "emits two rects for two disjoint dirty tiles":
        step("Verify: emits two rects for two disjoint dirty tiles")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 4, 4)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.output_rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[4]).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(p.rects[5]).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(p.rects[6]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[7]).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "falls back to FULL when dirty area meets the threshold exactly":
        step("Verify: falls back to FULL when dirty area meets the threshold exactly")
        val d = grid(128, 128, 64)
        mark_tile(d, 0, 0, 0)
        val p = plan_with(d, 64, 25)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_AREA)
        expect(p.full_fallback_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.rects.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(p.rects[2]).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(p.rects[3]).to_equal(128)  # oracle: 128 — named expected value from the requirement
        expect(p.source_tile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(4096)  # oracle: 4096 — named expected value from the requirement
        expect(p.planned_pixels).to_equal(16384)  # oracle: 16384 — named expected value from the requirement
        expect(p.tiles_examined).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "stays LOCAL just under the threshold":
        step("Verify: stays LOCAL just under the threshold")
        val d = grid(128, 128, 64)
        mark_tile(d, 0, 0, 0)
        val p = plan_with(d, 64, 26)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_NONE)

    it "falls back to FULL when every tile is dirty":
        step("Verify: falls back to FULL when every tile is dirty")
        val d = grid(128, 128, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 1, 0)
        mark_tile(d, 0, 0, 1)
        mark_tile(d, 0, 1, 1)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_AREA)
        expect(p.source_tile_count).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(p.merged_tile_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(16384)  # oracle: 16384 — named expected value from the requirement
        expect(p.planned_pixels).to_equal(16384)  # oracle: 16384 — named expected value from the requirement

    it "falls back to FULL when the rect cap is exceeded":
        step("Verify: falls back to FULL when the rect cap is exceeded")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 2, 0)
        val p = plan_with(d, 1, 60)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_CAP)
        expect(p.full_fallback_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.source_tile_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(8192)  # oracle: 8192 — named expected value from the requirement
        expect(p.tiles_examined).to_equal(80)  # oracle: 80 — named expected value from the requirement
        expect(p.rects[2]).to_equal(640)  # oracle: 640 — named expected value from the requirement
        expect(p.rects[3]).to_equal(480)  # oracle: 480 — named expected value from the requirement

    it "treats a negative level as invalid with FULL fallback":
        step("Verify: treats a negative level as invalid with FULL fallback")
        val d = grid(100, 100, 64)
        val p = build_damage_plan(d, -1, DamagePlanPolicy.create(64, 60))
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)
        expect(p.source_tile_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.planned_pixels).to_equal(10000)  # oracle: 10000 — named expected value from the requirement
        expect(p.tiles_examined).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[2]).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(p.rects[3]).to_equal(100)  # oracle: 100 — named expected value from the requirement

    it "treats an out-of-range level as invalid with FULL fallback":
        step("Verify: treats an out-of-range level as invalid with FULL fallback")
        val d = grid(100, 100, 64)
        val p = build_damage_plan(d, 1, DamagePlanPolicy.create(64, 60))
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "treats max_rects <= 0 as invalid with FULL fallback":
        step("Verify: treats max_rects <= 0 as invalid with FULL fallback")
        val d = grid(100, 100, 64)
        val p = plan_with(d, 0, 60)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "treats threshold <= 0 as invalid with FULL fallback":
        step("Verify: treats threshold <= 0 as invalid with FULL fallback")
        val d = grid(100, 100, 64)
        val p = plan_with(d, 64, 0)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "treats threshold > 100 as invalid with FULL fallback":
        step("Verify: treats threshold > 100 as invalid with FULL fallback")
        val d = grid(100, 100, 64)
        val p = plan_with(d, 64, 101)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "treats an invalid pyramid with a positive viewport as FULL fallback":
        step("Verify: treats an invalid pyramid with a positive viewport as FULL fallback")
        val d = grid(100, 100, 0)
        expect(d.valid).to_equal(false)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)
        expect(p.planned_pixels).to_equal(10000)  # oracle: 10000 — named expected value from the requirement

    it "treats a grid-capacity overflow as an invalid pyramid with FULL fallback":
        step("Verify: treats a grid-capacity overflow as an invalid pyramid with FULL fallback")
        val d = grid(100000, 100000, 1)
        expect(d.valid).to_equal(false)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "treats a viewport whose area overflows the guard as invalid":
        step("Verify: treats a viewport whose area overflows the guard as invalid")
        val big = 10000000000
        val d = grid(big, big, big)
        expect(d.valid).to_equal(true)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)
        expect(p.planned_pixels).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(p.rects[2]).to_equal(big)

    it "clamps tile rects at the viewport edge":
        step("Verify: clamps tile rects at the viewport edge")
        val d = grid(100, 100, 64)
        mark_tile(d, 0, 1, 1)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.rects[0]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[1]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[2]).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(p.rects[3]).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(1296)  # oracle: 1296 — named expected value from the requirement

    it "begin_frame clears previous marks via epoch bump":
        step("Verify: begin_frame clears previous marks via epoch bump")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        d.begin_frame()
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_NONE)
        expect(p.tiles_examined).to_equal(80)  # oracle: 80 — named expected value from the requirement

    it "marks after begin_frame belong to the new frame":
        step("Verify: marks after begin_frame belong to the new frame")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        d.begin_frame()
        mark_tile(d, 0, 4, 4)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.output_rect_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.rects[0]).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(p.rects[1]).to_equal(256)  # oracle: 256 — named expected value from the requirement

    it "re-marking the same tile in one frame counts it once":
        step("Verify: re-marking the same tile in one frame counts it once")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 0, 0)
        mark_tile(d, 0, 0, 0)
        val p = plan(d)
        expect(p.source_tile_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(p.dirty_pixels).to_equal(4096)  # oracle: 4096 — named expected value from the requirement

    it "plans a non-zero pyramid level using its own tile size and offset":
        step("Verify: plans a non-zero pyramid level using its own tile size and offset")
        val d = DirtyTilePyramid.create(128, 128, [16, 64], [16, 64])
        expect(d.level_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(d.level_offset[1]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        mark_tile(d, 1, 0, 0)
        val p = build_damage_plan(d, 1, DamagePlanPolicy.create(64, 90))
        expect(p.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p.rects[2]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.rects[3]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p.tiles_examined).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "bridging an empty PropertyTrees damage list marks nothing":
        step("Verify: bridging an empty PropertyTrees damage list marks nothing")
        val d = grid(640, 480, 64)
        val trees = PropertyTrees.create()
        damage_tiles_mark_property_damage(d, trees)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_NONE)

    it "dirty_count rejects bad levels and dirty_rects reports clamped rects":
        step("Verify: dirty_count rejects bad levels and dirty_rects reports clamped rects")
        val d = grid(100, 100, 64)
        mark_tile(d, 0, 1, 1)
        expect(d.dirty_count(-1)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(d.dirty_count(5)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val r = d.dirty_rects(0)
        expect(r.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r[0]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(r[1]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(r[2]).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(r[3]).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(d.dirty_rects(3).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(d.dirty_rects(-1).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(d.dirty_count(0)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "dirty_rects keeps interior tiles unclamped":
        step("Verify: dirty_rects keeps interior tiles unclamped")
        val d = grid(640, 480, 64)
        mark_tile(d, 0, 1, 1)
        val r = d.dirty_rects(0)
        expect(r.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r[0]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(r[1]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(r[2]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(r[3]).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "rejects a level whose tile capacity exceeds the pyramid budget":
        step("Verify: rejects a level whose tile capacity exceeds the pyramid budget")
        val d = grid(5000, 5000, 1)
        expect(d.valid).to_equal(false)
        val p = plan(d)
        expect(p.mode).to_equal(DAMAGE_PLAN_FULL)
        expect(p.fallback_reason).to_equal(DAMAGE_FALLBACK_INVALID)

    it "begin_frame wraps the epoch counter at the i64 maximum":
        step("Verify: begin_frame wraps the epoch counter at the i64 maximum")
        val d = grid(128, 128, 64)
        d.frame_epoch = 9223372036854775807
        mark_tile(d, 0, 0, 0)
        d.begin_frame()
        expect(d.frame_epoch).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val p0 = plan(d)
        expect(p0.mode).to_equal(DAMAGE_PLAN_NONE)
        mark_tile(d, 0, 1, 1)
        val p1 = plan(d)
        expect(p1.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(p1.rects[0]).to_equal(64)  # oracle: 64 — named expected value from the requirement
        expect(p1.rects[1]).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "create rejects mismatched or empty tile lists":
        step("Verify: create rejects mismatched or empty tile lists")
        val a = DirtyTilePyramid.create(100, 100, [], [])
        expect(a.valid).to_equal(false)
        val b = DirtyTilePyramid.create(100, 100, [16, 32], [16])
        expect(b.valid).to_equal(false)
