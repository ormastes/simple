# @cover src/lib/common/env_access/plan_sdn.spl 80%
use std.spec
use std.common.env_access.plan_sdn.*

val PLAN_SHA = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn valid_plan_sdn(extra: text = "", version: i64 = 1) -> text:
    return "{schema: simple-env-access-plan-v1, version: " + version.to_text() +
        ", plan_id: cold-main, canonical_repo_root: /workspace/repo" + extra +
        ", max_total_bytes: 512, max_processes: 1" +
        ", instructions: [{kind: run-allowed-tool, resource: c-comparator, arguments: [], timeout_ms: 100, max_stdout_bytes: 128, max_stderr_bytes: 128}]" +
        ", tools: [{tool_id: c-comparator, canonical_path: /workspace/tools/c-comparator, identity_hash: " + PLAN_SHA + "}]" +
        ", hardware_probes: [{probe_id: board-id, schema_id: board-id-v1, max_arguments: 0, max_timeout_ms: 100, max_stdout_bytes: 64, max_stderr_bytes: 64}]" +
        ", install: {compare_c: true, compare_rust: false, c_tool_id: c-comparator, rust_tool_id: \"\", worker_count: 1, queue_capacity: 1, timeout_ticks: 100, max_output_bytes: 128}}"

describe "strict environment plan SDN codec":
    it "parses typed tool and hardware identities then validates the parent plan":
        val loaded = env_access_plan_parse_sdn_v1(valid_plan_sdn()).unwrap()
        expect(loaded.plan.allowed_tools.len()).to_equal(1)
        expect(loaded.plan.allowed_hardware_probes.len()).to_equal(1)
        expect(loaded.c_tool_id).to_equal("c-comparator")
        val encoded = env_access_plan_encode_sdn_v1(loaded).unwrap()
        expect(env_access_plan_parse_sdn_v1(encoded).unwrap().plan.plan_id).to_equal("cold-main")

    it "rejects unknown and duplicate fields":
        expect(env_access_plan_parse_sdn_v1(valid_plan_sdn(", surprise: true")).unwrap_err()).to_contain("unknown plan field")
        val duplicate = valid_plan_sdn().replace("plan_id: cold-main", "plan_id: cold-main, plan_id: shadow")
        expect(env_access_plan_parse_sdn_v1(duplicate).unwrap_err()).to_contain("duplicate fields")

    it "rejects unsupported versions before installation":
        expect(env_access_plan_parse_sdn_v1(valid_plan_sdn("", 2)).unwrap_err()).to_equal("ENV-E-PLAN-VERSION")
