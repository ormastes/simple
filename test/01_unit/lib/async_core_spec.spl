# Regression for the std.async_core shared vocabulary module.
#
# Twelve modules across src/lib/nogc_async_mut import std.async_core. Before
# this module existed every one of those imports was a live reference to a
# module no file provided, so the first call through them failed at runtime
# with E1002. This spec pins both halves of the module: the two types it
# declares (AsyncError, Priority) and the three it re-exports from the
# `async` subtree (Poll, TaskState, CancellationToken).

"""
## Purpose and audience
Purpose: Verify std.async_core.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-LIB-ASYNC-CORE-001 — stable requirement identity for this spec.

use std.async_core.{AsyncError, Poll, Priority, TaskState, CancellationToken}

use std.spec.step

describe "std.async_core":
    it "orders Priority so that smaller is more urgent":
        step("Verify: orders Priority so that smaller is more urgent")
        # @req: REQ-LIB-ASYNC-CORE-001
        # The schedulers in this tier pick with `if pri < best_priority`, so
        # Critical MUST be the smallest key. A reordering here silently
        # inverts scheduling, which is why the exact keys are pinned.
        expect(Priority.Critical.to_i32()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.High.to_i32()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.Normal.to_i32()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.Low.to_i32()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        assert_true(Priority.Critical.to_i32() < Priority.Low.to_i32())

    it "round-trips Priority through its scheduler sort key":
        step("Verify: round-trips Priority through its scheduler sort key")
        expect(Priority.from_i32(0).to_i32()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.from_i32(1).to_i32()).to_equal(1)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.from_i32(2).to_i32()).to_equal(2)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.from_i32(3).to_i32()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract
        # Out-of-range clamps rather than inventing a variant.
        expect(Priority.from_i32(-5).to_i32()).to_equal(0)  # oracle: authoritative expected value documented by this spec's contract
        expect(Priority.from_i32(99).to_i32()).to_equal(3)  # oracle: authoritative expected value documented by this spec's contract

    it "declares every AsyncError variant the tier constructs":
        step("Verify: declares every AsyncError variant the tier constructs")
        var seen = ""
        match AsyncError.CapacityExceeded:
            case AsyncError.CapacityExceeded: seen = seen + "C"
            case _: seen = seen + "?"
        match AsyncError.Timeout:
            case AsyncError.Timeout: seen = seen + "T"
            case _: seen = seen + "?"
        match AsyncError.JoinError("no result"):
            case AsyncError.JoinError(_): seen = seen + "J"
            case _: seen = seen + "?"
        expect(seen).to_equal("CTJ")

    it "carries the payload of AsyncError.JoinError":
        step("Verify: carries the payload of AsyncError.JoinError")
        var msg = ""
        match AsyncError.JoinError("task vanished"):
            case AsyncError.JoinError(m): msg = m
            case _: msg = "unmatched"
        expect(msg).to_equal("task vanished")

    it "re-exports Poll from the async subtree":
        step("Verify: re-exports Poll from the async subtree")
        val ready: Poll<i64> = Poll.Ready(5)
        assert_true(ready.is_ready())
        expect(ready.unwrap()).to_equal(5)  # oracle: authoritative expected value documented by this spec's contract
        val pending: Poll<i64> = Poll.Pending
        assert_true(pending.is_pending())

    it "re-exports the non-generic TaskState, not the generic one":
        step("Verify: re-exports the non-generic TaskState, not the generic one")
        # async/runtime.spl also declares a TaskState<T> with Running/Ready/
        # Failed. The tier's importers use Pending/Running/Suspended/
        # Completed, which is async/task.spl's enum -- pin that one.
        var seen = ""
        match TaskState.Pending:
            case TaskState.Pending: seen = seen + "P"
            case _: seen = seen + "?"
        match TaskState.Suspended:
            case TaskState.Suspended: seen = seen + "S"
            case _: seen = seen + "?"
        match TaskState.Completed:
            case TaskState.Completed: seen = seen + "C"
            case _: seen = seen + "?"
        expect(seen).to_equal("PSC")

    it "re-exports a constructible CancellationToken":
        step("Verify: re-exports a constructible CancellationToken")
        val token = CancellationToken.new()
        assert_false(token.is_cancelled())
