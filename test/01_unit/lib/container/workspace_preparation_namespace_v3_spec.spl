# AUTHORED_NOT_RUN. Regresses the actual release namespace collision: the old
# staging codec remains callable while deadline math lives in a separate leaf.
use std.spec.{describe, it, expect, step}
use std.common.contracts.container.workspace_preparation_v3.{ContainerWorkspacePreparationRequestV3,
    container_workspace_preparation_encode_v3, container_workspace_preparation_decode_v3}
use std.common.contracts.container.workspace_preparation_window_v3.container_workspace_preparation_deadline_v3

# Real production typed call contract; no alternate codec implementation.
fn preserved_workspace_codec_call_v3(request: ContainerWorkspacePreparationRequestV3) -> Result<text, text>:
    container_workspace_preparation_encode_v3(request)

describe "Workspace staging codec and deadline window occupy distinct modules":
    it "calls the original codec and the new arithmetic without replacing either":
        step("Resolve both real production imports, including the preexisting request type")
        val old = container_workspace_preparation_decode_v3("")
        expect(old.unwrap_err()).to_equal("container-workspace-source-size")
        val window = container_workspace_preparation_deadline_v3(1000, 2, 1000, 5000, 1000)
        expect(window.unwrap()).to_equal(2001000)
