# AUTHORED_NOT_RUN. milestone_0030 N6-a guard (DESIGN 14.3 "byte-identity proof obligation",
# 14.8 step 1): the agent arm's request projection, Create argv and created-config expectations are
# pinned with LITERAL expected values before the remote-build arm is added, and must stay green after.
# Every agent argument goes through `golden_primary_v3()`; the N6-a commit changes only that one
# helper body (to wrap the profile in LinuxWorkspacePrimaryV3.Agent) and no expected literal.
# @req REQ-M0030-N6A-AGENT-BYTE-IDENTITY
use std.spec.{describe, it, expect, step}
use std.common.contracts.container.linux_workspace_profile_v1.*
use std.common.contracts.container.linux_agent_workspace_profile_v1.*
use std.common.contracts.container.linux_fresh_workspace_v3.*
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.container.linux_fresh_workspace_inspect_v3.*
use std.common.contracts.container.linux_fresh_epoch_v1.LinuxFreshEpochProfileV1
use std.common.contracts.container.execution_v2.*
use std.nogc_sync_mut.io.linux_fresh_workspace_launch_v3.linux_fresh_workspace_argv_v3
use std.nogc_async_mut.container.providers.linux.request_v1.{LinuxOciRequestV1, linux_oci_request_digest_v1}
use std.nogc_async_mut.container.providers.linux.request_codec_v1.linux_oci_retained_request_encode_v1
use std.common.sdn.value.SdnValue
use std.common.crypto.sha256.sha256_text
use std.common.json.value.*

fn golden_policy_v3() -> LinuxWorkspaceInstalledProfileV1:
    LinuxWorkspaceInstalledProfileV1(machine_policy_digest: "a".repeat(64), provider_policy_digest: "b".repeat(64),
        containment_profile_digest: "c".repeat(64), protected_parent: "/srv/workspaces", leaf_name: "slot_1",
        expected_pool_id: "xfs:1:2:3:4", expected_workspace_id: "inode:1:2:3:20001", quota_id: 17,
        hard_bytes: 1073741824, guest_root: "/workspace", read_only: false)

fn golden_agent_v3() -> LinuxAgentWorkspaceProfileV1:
    LinuxAgentWorkspaceProfileV1(machine_policy_digest: "a".repeat(64),
        workspace_profile_digest: sha256_text(linux_workspace_installed_profile_encode_v1(golden_policy_v3()).unwrap()),
        assets_root: "/srv/approved-assets", repository_ref: "repo_1", revision_oid: "1".repeat(40), object_format: "sha1",
        source_manifest_digest: "2".repeat(64), bootstrap_digest: "3".repeat(64), git_digest: "4".repeat(64), agent_digest: "5".repeat(64),
        bootstrap_program: "/opt/simple/bootstrap", image: "registry.example/agent@sha256:" + "6".repeat(64),
        agent_program: "/usr/bin/codex", image_config_id: "7".repeat(64))

# The ONE line the N6-a commit changes: the agent arm selector passed to every re-signed function.
fn golden_primary_v3() -> LinuxWorkspacePrimaryV3:
    LinuxWorkspacePrimaryV3.Agent(golden_agent_v3())

fn golden_native_v3(terminal_mode: text) -> LinuxOciRequestV1:
    LinuxOciRequestV1(pod_uid: "job_1", attempt: 1, operation_id: "operation_1", image: "registry.example/agent@sha256:" + "6".repeat(64),
        bundle_path: "", command: ["/opt/simple/bootstrap"], args: ["--invocation-manifest-sha256", "8".repeat(64)],
        timeout_ms: 30000, cpu_limit_millis: 1000, memory_limit_bytes: 1342177280, pid_limit: 128,
        network_policy: "none", filesystem_policy: "read-only", replace_entrypoint: true, working_directory: "/workspace",
        terminal_mode: terminal_mode, user_uid: 20001, user_gid: 20001, user_namespace_mode: "keep-id",
        containment_profile_digest: "c".repeat(64),
        mounts: [ContainerMountProjectionV2(host_root: "/srv/workspaces/slot_1", guest_root: "/workspace", read_only: false)])

fn golden_scope_v3() -> ContainerHostScopeV2:
    ContainerHostScopeV2(physical_host_id: "host_1", service_scope_id: "epoch-" + "9".repeat(64),
        boot_id: "boot_1", provider_generation: 7, native_machine_id: "f".repeat(32), continuity_mode: "native-boot-incarnation-v1", continuity_id: "boot_1")

fn golden_request_v3(native: LinuxOciRequestV1) -> ContainerExecutionRequestV2:
    val scope = golden_scope_v3()
    val plan = ContainerExecutionPlanV2(backend: "linux-podman", workload_uid: native.pod_uid, attempt: native.attempt,
        operation_id: native.operation_id, request_digest: linux_oci_request_digest_v1(native).unwrap(), physical_host_id: scope.physical_host_id,
        service_scope_id: scope.service_scope_id, boot_id: scope.boot_id, provider_generation: scope.provider_generation,
        native_machine_id: scope.native_machine_id, continuity_mode: scope.continuity_mode, continuity_id: scope.continuity_id)
    ContainerExecutionRequestV2(plan, linux_oci_retained_request_encode_v1(native).unwrap())

fn golden_command_v3(action: LinuxFreshWorkloadActionV2, native_id: text) -> LinuxFreshWorkspaceCommandV3:
    LinuxFreshWorkspaceCommandV3(command: LinuxFreshWorkloadCommandV2(request: golden_request_v3(golden_native_v3("tty")),
        scope: golden_scope_v3(), action: action, native_id: native_id, image: "registry.example/agent@sha256:" + "6".repeat(64),
        entrypoint: ["/opt/simple/bootstrap"], args: ["--invocation-manifest-sha256", "8".repeat(64)],
        cpu_millis: 1000, memory_bytes: 1342177280, pid_limit: 128, timeout_ms: 30000,
        helper_cpu_millis: 500, helper_memory_bytes: 134217728))

fn golden_epoch_v3() -> LinuxFreshEpochProfileV1:
    LinuxFreshEpochProfileV1(fields: {"graphRoot": SdnValue.String("/srv/provider/graph"), "runRoot": SdnValue.String("/srv/provider/run"),
        "delegatedCgroup": SdnValue.String("/simple/containers"), "serviceUid": SdnValue.Int(20001), "serviceGid": SdnValue.Int(20001),
        "subuidStart": SdnValue.Int(100000), "subuidCount": SdnValue.Int(65536), "subgidStart": SdnValue.Int(200000), "subgidCount": SdnValue.Int(65536)})

fn golden_created_v3(command: LinuxFreshWorkspaceCommandV3) -> JsonValue:
    var value = JsonValue.Object([], [])
    for key in linux_fresh_workspace_inspect_field_names_v3(): value = json_value_object_set(value, key, JsonValue.Null)
    val c = command.command
    for pair in [("id", c.native_id), ("pod_uid", "job_1"), ("attempt", "1"),
            ("node_boot_id", container_scope_fence_id_v2(c.scope).unwrap()), ("provider_generation", "7"),
            ("operation_id", "operation_1"), ("cgroup", ""), ("status", "created"), ("runtime", "crun"), ("manager", "cgroupfs"),
            ("cgroup_mode", "private"), ("pid_mode", "private"), ("cgroups", "default"), ("network_mode", "none"), ("userns_mode", "private"),
            ("image_digest", "sha256:" + "6".repeat(64)), ("image_name", "registry.example/agent@sha256:" + "6".repeat(64)),
            ("path", "/opt/simple/bootstrap"), ("workdir", "/workspace"), ("configured_user", "20001:20001"), ("cgroup_parent", "/simple/containers")]:
        value = json_value_object_set(value, pair.0, JsonValue.Str(pair.1))
    for pair in [("pid", 0), ("effective_caps", 0), ("bounding_caps", 0), ("cpu_period", 100000), ("cpu_quota", 100000),
            ("memory_bytes", 1342177280), ("memory_swap", 1342177280), ("pids_limit", 128)]:
        value = json_value_object_set(value, pair.0, JsonValue.Int(pair.1))
    for pair in [("privileged", false), ("readonly_rootfs", true), ("no_new_privileges", true), ("tty", true), ("open_stdin", true), ("stdin_once", false)]:
        value = json_value_object_set(value, pair.0, JsonValue.Bool(pair.1))
    value = json_value_object_set(value, "args", json_value_str_array(["--invocation-manifest-sha256", "8".repeat(64)]))
    value = json_value_object_set(value, "environment", json_value_str_array(["PATH=/usr/bin", "TERM=xterm"]))
    value = json_value_object_set(value, "security_options", json_value_str_array(["no-new-privileges"]))
    value = json_value_object_set(value, "create_command", json_value_str_array(["/usr/bin/podman", "create"]))
    var mount = JsonValue.Object([], [])
    for pair in [("Type", "bind"), ("Source", "/srv/workspaces/slot_1"), ("Destination", "/workspace"), ("Driver", ""), ("Mode", ""), ("Propagation", "rprivate")]:
        mount = json_value_object_set(mount, pair.0, JsonValue.Str(pair.1))
    mount = json_value_object_set(mount, "Options", json_value_str_array(["rbind", "nosuid", "nodev"]))
    mount = json_value_object_set(mount, "RW", JsonValue.Bool(true))
    value = json_value_object_set(value, "mounts", JsonValue.Array([mount]))
    value = json_value_object_set(value, "binds", json_value_str_array(["/srv/workspaces/slot_1:/workspace:rw,rbind,rprivate,nosuid,nodev"]))
    value

describe "Agent workspace arm byte identity (milestone_0030 N6-a guard)":
    it "projects exactly the installed agent image, bootstrap entrypoint and invocation args":
        step("Project the installed agent request and compare every field with literals")
        val projected = linux_fresh_workspace_request_v3(golden_request_v3(golden_native_v3("tty")), golden_policy_v3(),
            golden_primary_v3(), "8".repeat(64), 20001, 20001).unwrap()
        expect(projected.image).to_equal("registry.example/agent@sha256:" + "6".repeat(64))
        expect(projected.entrypoint).to_equal(["/opt/simple/bootstrap"])
        expect(projected.args).to_equal(["--invocation-manifest-sha256", "8".repeat(64)])
        expect(projected.cpu_millis).to_equal(1000)
        expect(projected.memory_bytes).to_equal(1342177280)
        expect(projected.pid_limit).to_equal(128)
        expect(projected.timeout_ms).to_equal(30000)

    it "refuses an agent request whose bytes differ from the TTY projection by terminal mode alone":
        step("Encode the same request with terminalMode none; the agent projection must not accept it")
        val changed = linux_fresh_workspace_request_v3(golden_request_v3(golden_native_v3("none")), golden_policy_v3(),
            golden_primary_v3(), "8".repeat(64), 20001, 20001)
        expect(changed.is_err()).to_equal(true)
        expect(changed.unwrap_err()).to_equal("fresh-workspace-request-not-exact-installed-projection")

    it "emits the exact agent Create argv including the TTY flags":
        step("Compare the whole Create argv with a literal list")
        val command = golden_command_v3(LinuxFreshWorkloadActionV2.Create, "")
        val fence = container_scope_fence_id_v2(golden_scope_v3()).unwrap()
        val expected = ["--remote=false", "--log-level=error", "--cgroup-manager=cgroupfs", "--root", "/srv/provider/graph",
            "--runroot", "/srv/provider/run", "--storage-driver", "vfs", "--tmpdir", "/srv/provider/run/tmp",
            "create", "--quiet", "--pull=never", "--name", "simple-job_1-1",
            "--label", "io.simpleorch.pod_uid=job_1", "--label", "io.simpleorch.attempt=1",
            "--label", "io.simpleorch.node_boot_id=" + fence,
            "--label", "io.simpleorch.provider_generation=7",
            "--label", "io.simpleorch.operation_id=operation_1",
            "--cpu-period=100000", "--cpu-quota=100000",
            "--memory=1342177280", "--memory-swap=1342177280",
            "--pids-limit=128", "--network=none", "--read-only", "--read-only-tmpfs=false",
            "--security-opt=no-new-privileges", "--cap-drop=ALL", "--cgroups=enabled", "--cgroupns=private", "--pid=private",
            "--privileged=false", "--http-proxy=false", "--cgroup-parent=/simple/containers",
            "--tty", "--interactive", "--userns=keep-id", "--user=20001:20001",
            "--workdir", "/workspace", "--mount", "type=bind,src=/srv/workspaces/slot_1,dst=/workspace,rw,nosuid,nodev,bind-propagation=rprivate",
            "--entrypoint", "/opt/simple/bootstrap", "--", "registry.example/agent@sha256:" + "6".repeat(64),
            "--invocation-manifest-sha256", "8".repeat(64)]
        expect(linux_fresh_workspace_argv_v3(golden_epoch_v3(), golden_policy_v3(), golden_primary_v3(), "8".repeat(64), 20001, 20001, command).unwrap()).to_equal(expected)

    it "accepts the agent created config and refuses a non-TTY one":
        step("The TTY/open_stdin expectations are the agent arm's")
        val command = golden_command_v3(LinuxFreshWorkloadActionV2.Inspect, "3".repeat(64))
        val original = golden_created_v3(command)
        expect(linux_fresh_workspace_created_config_validate_v3(golden_policy_v3(), golden_primary_v3(), "8".repeat(64), 20001, 20001,
            command, json_value_serialize(original)).is_ok()).to_equal(true)
        val flipped = json_value_object_set(json_value_object_set(original, "tty", JsonValue.Bool(false)), "open_stdin", JsonValue.Bool(false))
        val refused = linux_fresh_workspace_created_config_validate_v3(golden_policy_v3(), golden_primary_v3(), "8".repeat(64), 20001, 20001,
            command, json_value_serialize(flipped))
        expect(refused.unwrap_err()).to_equal("fresh-workspace-created-security-tty-correspondence")
        val wrong_path = json_value_object_set(original, "path", JsonValue.Str("/opt/simple/build-launcher"))
        expect(linux_fresh_workspace_created_config_validate_v3(golden_policy_v3(), golden_primary_v3(), "8".repeat(64), 20001, 20001,
            command, json_value_serialize(wrong_path)).unwrap_err()).to_equal("fresh-workspace-created-config-correspondence")
