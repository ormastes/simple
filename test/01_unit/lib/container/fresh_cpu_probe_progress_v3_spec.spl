# AUTHORED_NOT_RUN. Actual production decisions; no native/opaque owners forged.
use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.container.machine_fresh_probe_record_v3.{machine_fresh_probe_wait_output_v3,
    machine_fresh_probe_selection_require_v3}

describe "Owned CPU probe V3 publication and actual wait-output decisions":
    it "refuses staged and unknown selection before any native permission":
        step("Call the production selection gate used by the canonical action owner")
        for phase in ["selection-staged", "publication-unknown", "", "reset", "closed"]:
            expect(machine_fresh_probe_selection_require_v3(phase).is_err()).to_equal(true)
        expect(machine_fresh_probe_selection_require_v3("selected").is_ok()).to_equal(true)

    it "distinguishes helper success from exact payload wait success":
        step("Require the real wait command's one decimal exit result, without stripping warnings")
        for output in ["0", "0\n", "0\r\n"]:
            expect(machine_fresh_probe_wait_output_v3(output).unwrap()).to_equal(0)
        for output in ["", "1\n", "137\n", "0\n0\n", "warning\n0\n", " 0\n", "0\nwarning"]:
            expect(machine_fresh_probe_wait_output_v3(output).is_err()).to_equal(true)
