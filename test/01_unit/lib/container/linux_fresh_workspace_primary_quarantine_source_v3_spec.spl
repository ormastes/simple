# AUTHORED_NOT_RUN. Read actual production bodies, not a boolean model or
# synthetic registry/native owner. This is source-path regression coverage,
# NOT dynamic close-fault/copied-capability/retirement qualification.
# @req REQ-LINUX-WORKSPACE-NATIVE-003
# @req REQ-LINUX-WORKSPACE-NATIVE-004
use std.spec.{describe, it, expect, step}
use std.io_runtime.file_read

fn quarantine_source_body_v3(source: text, name: text) -> text:
    val parts = source.split("fn " + name + "(")
    if parts.len() < 2: return ""
    parts[1].split("\nfn ")[0]

fn quarantine_order_v3(body: text, first: text, later: text) -> bool:
    val left = body.split(first)
    val right = body.split(later)
    left.len() >= 2 and right.len() >= 2 and left[0].byte_len() < right[0].byte_len()

describe "Actual workspace primary quarantine production control paths":
    it "reads the canonical error before every reopen hash and successful observation latch":
        step("Source-path check; copied handles use this same private slot, not a model")
        val source = file_read("src/lib/nogc_sync_mut/io/linux_fresh_workload_subject_v2.spl")
        val guard = quarantine_source_body_v3(source, "subject_primary_effect_v3")
        expect(quarantine_order_v3(guard, "if state.primary_error !=", "subject_workspace_key_v3(")).to_equal(true)
        val body = quarantine_source_body_v3(source, "subject_primary_body_v3")
        for effect in ["subject_primary_open_v3(", "linux_fresh_primary_chunk_v3(", "linux_fresh_primary_hash_step_v3(", ".primary_observed = true"]:
            expect(quarantine_order_v3(body, "subject_primary_effect_v3(", effect)).to_equal(true)
        val retry = quarantine_source_body_v3(source, "subject_workspace_primary_v3")
        expect(quarantine_order_v3(retry, "if state.primary_error !=", "subject_primary_close_v3(")).to_equal(true)
        expect(source.contains(".primary_error = \"\"")).to_equal(false)

    it "consumes descriptors once and retains the first primary failure before returning":
        step("No guessed close fault or fake native capability is constructed")
        val source = file_read("src/lib/nogc_sync_mut/io/linux_fresh_workload_subject_v2.spl")
        val body = quarantine_source_body_v3(source, "subject_primary_close_v3")
        expect(quarantine_order_v3(body, ".primary_exe = -1", "close(fd as i32)")).to_equal(true)
        expect(quarantine_order_v3(body, ".primary_cmdline = -1", "close(fd as i32)")).to_equal(true)
        expect(body).to_contain("if subject_slots_v2[slot].primary_error == \"\": subject_slots_v2[slot].primary_error = error")
        expect(quarantine_order_v3(body, ".primary_error = error", "return Err(subject_slots_v2[slot].primary_error)")).to_equal(true)

    it "requires the actual cached subject gate before attach projection but leaves native retirement independent":
        step("Follow actual successor-to-native-to-subject call edges")
        val native = file_read("src/lib/nogc_sync_mut/io/linux_fresh_workload_native_v2.spl")
        val lookup = quarantine_source_body_v3(native, "workload_workspace_primary_effect_v3")
        expect(quarantine_order_v3(lookup, "subject.matches_workspace_v3(", "subject.validate_workspace_primary_effect_v3(")).to_equal(true)
        val parent = file_read("src/lib/nogc_sync_mut/io/linux_installed_fresh_epoch_owner_v1.spl")
        val attach = quarantine_source_body_v3(parent, "fresh_workspace_attach_v3")
        expect(quarantine_order_v3(attach, "observer.validate_workspace_primary_effect_v3(", "binding.project_primary_attach_v3(")).to_equal(true)
        val subject = file_read("src/lib/nogc_sync_mut/io/linux_fresh_workload_subject_v2.spl")
        for name in ["subject_native_retire_v3", "subject_native_retirement_current_v3", "subject_workspace_closure_v3", "subject_close_v2"]:
            val body = quarantine_source_body_v3(subject, name)
            expect(body.byte_len()).to_be_greater_than(0)
            expect(body.contains("subject_primary_effect_v3(")).to_equal(false)
            expect(body.contains("if state.primary_error !=")).to_equal(false)
