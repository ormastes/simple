# NOT_RUN. Pure production reducers only; metadata cannot mint native authority.
use std.spec.*
use std.nogc_async_mut.container.providers.windows.primary_geometry_owner_v2.*
use std.nogc_sync_mut.io.windows_engine_pipe_owner_v1.*
use std.nogc_async_mut.container.providers.windows.docker_inspection_freshness_v4.windows_primary_inspection_fresh_v4
use std.nogc_sync_mut.io.time_ops.time_sample_monotonic_nanos_or_failure

fn geometry_control() -> WindowsEnginePipeControlV2:
    WindowsEnginePipeControlV2(target_digest: "a".repeat(64), binding_digest: "b".repeat(64), kind: "geometry",
        nonce_digest: "c".repeat(64), revision: 7, expires_monotonic_ns: 9000000000)

fn geometry_receipt(status: WindowsEnginePipeWriteStatusV2, accepted: i64) -> WindowsEnginePipeWriteReceiptV2:
    WindowsEnginePipeWriteReceiptV2(attempt: WindowsEnginePipeAttemptV2(control: geometry_control(),
        sequence: 1, frame_sequence: 1, payload_digest: "d".repeat(64), payload_bytes: 128,
        offset: 0, requested_bytes: 128), status: status, accepted_bytes: accepted)

describe "Windows primary Geometry one-write production reducers":
    it "expires original probe evidence after modeled cleanup delay using an actual monotonic sample":
        step("Keep the original clock sample across probe completion and cleanup delay")
        val probe_started = time_sample_monotonic_nanos_or_failure()
        assert(probe_started > 0 and probe_started < 9223372035854775806)
        expect(windows_primary_inspection_fresh_v4(probe_started, probe_started + 1000000000, 5000)).to_equal(true)
        expect(windows_primary_inspection_fresh_v4(probe_started, probe_started + 1000000001, 5000)).to_equal(false)
        expect(windows_primary_inspection_fresh_v4(probe_started, probe_started + 250000001, 250)).to_equal(false)
        expect(windows_primary_inspection_fresh_v4(probe_started, probe_started - 1, 5000)).to_equal(false)

    it "preserves Unknown after attempted write and acknowledgment through cleanup errors":
        step("Classify actual owner outcome state without inventing observed terminal size")
        expect(windows_primary_geometry_disposition_v2(false, false)).to_equal("rejected")
        expect(windows_primary_geometry_disposition_v2(true, false)).to_equal("unknown")
        expect(windows_primary_geometry_disposition_v2(true, true)).to_equal("acknowledged")

    it "waits for queued completion and accepts only the complete exact payload":
        step("Use the same native receipt reducer as the production write and completion paths")
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Queued, 0),
            geometry_control(), "d".repeat(64), 128).unwrap()).to_equal("write-wait")
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Completed, 128),
            geometry_control(), "d".repeat(64), 128).unwrap()).to_equal("read")
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Completed, 127),
            geometry_control(), "d".repeat(64), 128).unwrap_err()).to_equal("windows-primary-geometry-partial-write-unknown")
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Unknown, 0),
            geometry_control(), "d".repeat(64), 128).unwrap_err()).to_equal("windows-primary-geometry-write-unknown")

    it "rejects altered receipt identity and invented queued accepted bytes":
        step("Prevent another revision or payload from completing this exact attempt")
        var control = geometry_control()
        control.revision = 8
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Completed, 128),
            control, "d".repeat(64), 128).unwrap_err()).to_equal("windows-primary-geometry-write-receipt-mismatch")
        expect(windows_primary_geometry_write_phase_v2(geometry_receipt(WindowsEnginePipeWriteStatusV2.Queued, 1),
            geometry_control(), "d".repeat(64), 128).unwrap_err()).to_equal("windows-primary-geometry-queued-bytes-unknown")

    it "matches actual endpoint facts by exact server and protected trusted rights":
        step("Compare observed endpoint metadata without claiming it was observed by this pure test")
        val before = WindowsEnginePipeObservationV1(server_pid: 123, owner_class: "system",
            dacl_protected: true, untrusted_control_rights: false)
        expect(windows_primary_geometry_endpoint_match_v2(before, before).is_ok()).to_equal(true)
        var changed = before
        changed.server_pid = 124
        expect(windows_primary_geometry_endpoint_match_v2(before, changed).is_err()).to_equal(true)
        changed = before
        changed.untrusted_control_rights = true
        expect(windows_primary_geometry_endpoint_match_v2(before, changed).is_err()).to_equal(true)
        changed = before
        changed.dacl_protected = false
        expect(windows_primary_geometry_endpoint_match_v2(before, changed).is_err()).to_equal(true)
