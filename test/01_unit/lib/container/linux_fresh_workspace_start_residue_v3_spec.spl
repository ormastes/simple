# A workspace start asks for the leader-residue move exactly like a plain start, and its owner retires the
# engine group before either workspace settle.
#
# Why (doc/08_tracking/bug/container_fresh_route_start_helper_kills_conmon_2026-11-27.md, "Workspace
# starts"): the engine forks the container's monitor from the `start` helper whatever projection built the
# command line. The workspace projection is a separate function and did not set `leader_residue_mode`, so a
# workspace container that outlived its start helper lost its monitor and every later engine command failed.
#
# Executed here: the production workspace projection, over DATA only. The settle order and the other
# start-like paths are source pins; the stateful owners cannot run under the seed (native origin check).
use std.spec.{describe, it, expect, step}
use std.io.file_read_text
use std.common.contracts.container.linux_agent_workspace_profile_v1.*
use std.common.contracts.container.linux_workspace_profile_v1.*
use std.common.contracts.container.linux_fresh_workspace_v3.*
use std.common.contracts.container.linux_fresh_workload_v2.*
use std.common.contracts.container.linux_fresh_epoch_v1.LinuxFreshEpochProfileV1
use std.common.contracts.container.execution_v2.*
use std.common.build_manager.group_process_stream_protocol_v2.{GroupProcessStreamLaunchV2, GroupProcessStreamRequestV2,
    group_process_child_argv_digest_v2}
use std.common.build_manager.group_process_stream_profile_v3.{GroupProcessCpuQuotaV3, GroupProcessBrokerBudgetV3,
    GroupProcessStreamProfileV3, group_process_stream_profile_encode_v3, group_process_stream_profile_residue_words_v3,
    GROUP_PROCESS_LEADER_RESIDUE_ENGINE_GROUP_V3}
use std.nogc_sync_mut.io.linux_fresh_workspace_launch_v3.linux_fresh_workspace_project_launch_v3
use std.nogc_sync_mut.container.machine_fresh_workload_engine_group_v3.machine_fresh_engine_group_requested_v3
use std.nogc_async_mut.container.providers.linux.request_v1.{LinuxOciRequestV1, linux_oci_request_digest_v1}
use std.nogc_async_mut.container.providers.linux.request_codec_v1.linux_oci_retained_request_encode_v1
use std.common.sdn.value.SdnValue
use std.common.crypto.sha256.sha256_text

val SR_RUN_ROOT: text = "/srv/workspaces/slot_1/" + linux_workspace_run_leaf_v1("operation_1")

fn sr_policy_v3() -> LinuxWorkspaceInstalledProfileV1:
    LinuxWorkspaceInstalledProfileV1(machine_policy_digest: "a".repeat(64), provider_policy_digest: "b".repeat(64),
        containment_profile_digest: "c".repeat(64), protected_parent: "/srv/workspaces", leaf_name: "slot_1",
        expected_pool_id: "xfs:1:2:3:4", expected_workspace_id: "inode:1:2:3:20001", quota_id: 17,
        hard_bytes: 1073741824, guest_root: "/workspace", read_only: false)

fn sr_agent_v3() -> LinuxAgentWorkspaceProfileV1:
    LinuxAgentWorkspaceProfileV1(machine_policy_digest: "a".repeat(64),
        workspace_profile_digest: sha256_text(linux_workspace_installed_profile_encode_v1(sr_policy_v3()).unwrap()),
        assets_root: "/srv/approved-assets", repository_ref: "repo_1", revision_oid: "1".repeat(40), object_format: "sha1",
        source_manifest_digest: "2".repeat(64), bootstrap_digest: "3".repeat(64), git_digest: "4".repeat(64), agent_digest: "5".repeat(64),
        bootstrap_program: "/opt/simple/bootstrap", image: "registry.example/agent@sha256:" + "6".repeat(64),
        agent_program: "/usr/bin/codex", image_config_id: "7".repeat(64))

fn sr_primary_v3() -> LinuxWorkspacePrimaryV3:
    LinuxWorkspacePrimaryV3.Agent(sr_agent_v3())

# The TTY (agent) arm: `create --tty --interactive`, then the same detached `start -- <id>` as every arm.
fn sr_command_v3(action: LinuxFreshWorkloadActionV2) -> LinuxFreshWorkspaceCommandV3:
    val policy = sr_policy_v3()
    val agent = sr_agent_v3()
    val native = LinuxOciRequestV1(pod_uid: "job_1", attempt: 1, operation_id: "operation_1", image: agent.image,
        bundle_path: "", command: [agent.bootstrap_program], args: ["--invocation-manifest-sha256", "8".repeat(64)],
        timeout_ms: 30000, cpu_limit_millis: 1000, memory_limit_bytes: 1342177280, pid_limit: 128,
        network_policy: "none", filesystem_policy: "read-only", replace_entrypoint: true, working_directory: policy.guest_root,
        terminal_mode: "tty", user_uid: 20001, user_gid: 20001, user_namespace_mode: "keep-id",
        containment_profile_digest: policy.containment_profile_digest,
        mounts: [ContainerMountProjectionV2(host_root: SR_RUN_ROOT, guest_root: policy.guest_root, read_only: false)])
    val scope = ContainerHostScopeV2(physical_host_id: "host_1", service_scope_id: "epoch-" + "9".repeat(64),
        boot_id: "boot_1", provider_generation: 7, native_machine_id: "f".repeat(32), continuity_mode: "native-boot-incarnation-v1", continuity_id: "boot_1")
    val plan = ContainerExecutionPlanV2(backend: "linux-podman", workload_uid: native.pod_uid, attempt: native.attempt,
        operation_id: native.operation_id, request_digest: linux_oci_request_digest_v1(native).unwrap(), physical_host_id: scope.physical_host_id,
        service_scope_id: scope.service_scope_id, boot_id: scope.boot_id, provider_generation: scope.provider_generation,
        native_machine_id: scope.native_machine_id, continuity_mode: scope.continuity_mode, continuity_id: scope.continuity_id)
    val created = action == LinuxFreshWorkloadActionV2.Create
    LinuxFreshWorkspaceCommandV3(command: LinuxFreshWorkloadCommandV2(request: ContainerExecutionRequestV2(plan, linux_oci_retained_request_encode_v1(native).unwrap()),
        scope: scope, action: action, native_id: if created: "" else: "d".repeat(64), image: native.image, entrypoint: native.command, args: native.args,
        cpu_millis: native.cpu_limit_millis, memory_bytes: native.memory_limit_bytes, pid_limit: native.pid_limit, timeout_ms: native.timeout_ms,
        helper_cpu_millis: 500, helper_memory_bytes: 134217728))

fn sr_epoch_v3() -> LinuxFreshEpochProfileV1:
    LinuxFreshEpochProfileV1(fields: {"graphRoot": SdnValue.String("/srv/provider/graph"), "runRoot": SdnValue.String("/srv/provider/run"),
        "delegatedCgroup": SdnValue.String("/simple/containers"), "serviceUid": SdnValue.Int(20001), "serviceGid": SdnValue.Int(20001),
        "partitionCpuMillis": SdnValue.Int(8000), "reservedCpuMillis": SdnValue.Int(1000),
        "partitionMemoryBytes": SdnValue.Int(8589934592), "reservedMemoryBytes": SdnValue.Int(1073741824)})

# The bound base the installed owner hands the projection: a never-spawned `version` command with the
# helper sub-charge of the command. `carried` is what a caller's template might already hold.
fn sr_base_v3(carried: text) -> GroupProcessStreamLaunchV2:
    val request = GroupProcessStreamRequestV2(program: "/usr/bin/podman", producer_digest: "b".repeat(64), args: ["version"],
        environment: [], directory: "/", inputs: [], timeout_ms: 30000, broker_program: "/opt/simple/broker",
        broker_digest: "c".repeat(64), child_argv_digest: group_process_child_argv_digest_v2("/usr/bin/podman", ["version"]),
        launch_deadline_unix_ms: 1)
    val resources = GroupProcessStreamProfileV3(helper_cpu: GroupProcessCpuQuotaV3(500, 50000, 100000),
        broker: GroupProcessBrokerBudgetV3("/sys/fs/cgroup/service/broker", 11, 22, 7, "d".repeat(64),
            250000, 1000000, 250, 67108864, 134217728), child_image_mode: "trusted-local-admin-image-fd-v1",
        leader_residue_mode: carried)
    GroupProcessStreamLaunchV2(root: "/srv/broker/workspace", worker_id: "operation_1", generation: 7,
        snapshot_digest: "e".repeat(64), cache_identity: "f".repeat(64), memory_limit_bytes: 134217728,
        request: request, delegated_cgroup_path: "/sys/fs/cgroup/service", transport_generation: 0, profile_v3: Some(resources))

fn sr_project_v3(carried: text, action: LinuxFreshWorkloadActionV2) -> Result<GroupProcessStreamLaunchV2, text>:
    linux_fresh_workspace_project_launch_v3(sr_epoch_v3(), sr_policy_v3(), sr_primary_v3(), "8".repeat(64), 20001, 20001,
        sr_base_v3(carried), sr_command_v3(action))

fn sr_body_v3(source: text, anchor: text, stop_at: text) -> text:
    val at = source.index_of(anchor)
    if at < 0: return ""
    val tail = source.substring(at, source.byte_len())
    val stop = tail.index_of(stop_at)
    if stop >= 0: tail.substring(0, stop) else: tail

describe "Linux fresh workspace start residue V3":
    it "asks for the move on a workspace Start, as part of the launch the owner captures":
        val projected = sr_project_v3("", LinuxFreshWorkloadActionV2.Start)
        expect(projected.is_ok()).to_equal(true)
        val launch = projected.unwrap()
        val args = launch.request.args
        expect(args[args.len() - 3]).to_equal("start")
        expect(args[args.len() - 1]).to_equal("d".repeat(64))
        step("The thirteenth profile word is present, so the runtime moves what the reaped leader left")
        val profile = launch.profile_v3.unwrap()
        expect(profile.leader_residue_mode).to_equal(GROUP_PROCESS_LEADER_RESIDUE_ENGINE_GROUP_V3)
        expect(group_process_stream_profile_residue_words_v3(profile)).to_equal([1])
        step("capture_v2 records the engine group from this predicate over the captured launch")
        expect(machine_fresh_engine_group_requested_v3(launch)).to_equal(true)
        step("Nothing else of the bound base moved: same sub-charge, same broker budget")
        val base = sr_base_v3("").profile_v3.unwrap()
        expect(profile.helper_cpu.cpu_millis).to_equal(base.helper_cpu.cpu_millis)
        expect(profile.child_image_mode).to_equal(base.child_image_mode)
        expect(launch.memory_limit_bytes).to_equal(134217728)

    it "clears it for every other workspace action, whatever the base carried":
        for action in [LinuxFreshWorkloadActionV2.Create, LinuxFreshWorkloadActionV2.Inspect, LinuxFreshWorkloadActionV2.Stop,
                LinuxFreshWorkloadActionV2.Remove, LinuxFreshWorkloadActionV2.Absence, LinuxFreshWorkloadActionV2.ConfigurationBefore]:
            val carried = sr_project_v3(GROUP_PROCESS_LEADER_RESIDUE_ENGINE_GROUP_V3, action)
            expect(carried.is_ok()).to_equal(true)
            expect(carried.unwrap().profile_v3.unwrap().leader_residue_mode).to_equal("")
            expect(machine_fresh_engine_group_requested_v3(carried.unwrap())).to_equal(false)
            step("A plain base stays byte-identical: same wire profile, twelve runtime words")
            val plain = sr_project_v3("", action).unwrap().profile_v3.unwrap()
            expect(group_process_stream_profile_encode_v3(plain)).to_equal(group_process_stream_profile_encode_v3(sr_base_v3("").profile_v3.unwrap()))
            expect(group_process_stream_profile_residue_words_v3(plain).len()).to_equal(0)

    it "sets it in one statement of the workspace projection and nowhere else in that file":
        val launch = file_read_text("src/lib/nogc_sync_mut/io/linux_fresh_workspace_launch_v3.spl")
        val project = sr_body_v3(launch, "pub fn linux_fresh_workspace_project_launch_v3(", "\n\n")
        expect(project.contains("    resource.leader_residue_mode = if command.action == LinuxFreshWorkloadActionV2.Start: GROUP_PROCESS_LEADER_RESIDUE_ENGINE_GROUP_V3 else: \"\"\n    result.profile_v3 = Some(resource)\n")).to_equal(true)
        expect(launch.split("leader_residue_mode").len()).to_equal(2)

    it "retires the engine group before both workspace settles, after the settled early return":
        val transition = file_read_text("src/lib/nogc_sync_mut/container/machine_fresh_workspace_source_transition_v3.spl")
        val settle = sr_body_v3(transition, "pub(package) fn machine_workspace_settle_v3(", "\n\n")
        val settled_at = settle.index_of("    if state.settled_v2()?: return Ok(())")
        val retire_at = settle.index_of("    machine_fresh_workload_engine_group_retire_v3(native, state)?")
        expect(settled_at > 0).to_equal(true)
        expect(retire_at > settled_at).to_equal(true)
        step("Before the retained branch, whose native retirement commits ahead of the settlement gate")
        expect(settle.index_of("        return machine_workspace_settle_retained_v3(storage, native, state)") > retire_at).to_equal(true)
        step("Before the plain workspace settle")
        expect(settle.index_of("    machine_fresh_workload_settle_workspace_v3(storage, native, state)") > retire_at).to_equal(true)
        expect(transition.split("machine_fresh_workload_engine_group_retire_v3(").len()).to_equal(2)
        step("Both settles pass the same gate, so neither can settle past a recorded group")
        val retained = sr_body_v3(transition, "fn machine_workspace_settle_retained_v3(", "\n\n")
        expect(retained.contains("state.prepare_settlement_v2(record, absence, at)?")).to_equal(true)
        val effects = file_read_text("src/lib/nogc_sync_mut/container/machine_fresh_workload_effects_v3.spl")
        val plain = sr_body_v3(effects, "pub(package) fn machine_fresh_workload_settle_workspace_v3(", "\n\n")
        expect(plain.contains("state.prepare_settlement_v2(record, absence, ")).to_equal(true)
        val lifecycle = file_read_text("src/lib/nogc_sync_mut/container/machine_fresh_workload_lifecycle_v2.spl")
        val gate = sr_body_v3(lifecycle, "    pub fn prepare_settlement_v2(", "\n\n")
        expect(gate.contains("machine_fresh_engine_group_settle_gate_v3(state.engine_groups)?")).to_equal(true)

    it "runs the workspace Stop, Remove and Absence the retirement order reads, on the shared helper path":
        val workflow = file_read_text("src/lib/nogc_sync_mut/container/machine_fresh_workspace_workflow_v3.spl")
        val effect = sr_body_v3(workflow, "fn workspace_workflow_effect_v3(", "\nfn ")
        val destroy = sr_body_v3(effect, "        case ContainerWorkspaceActionV3.Destroy:", "        case _: pass")
        expect(destroy.contains("return Some((LinuxFreshWorkloadActionV2.Stop, \"stop\"))")).to_equal(true)
        expect(destroy.contains("return Some((LinuxFreshWorkloadActionV2.Remove, \"remove\"))")).to_equal(true)
        expect(destroy.contains("return Some((LinuxFreshWorkloadActionV2.Absence, \"absence\"))")).to_equal(true)
        step("The same begin and progress as a plain start: capture_v2 records, the start completion observes")
        expect(workflow.contains("machine_fresh_workload_begin_v3(storage, custody, state, generation, selected.0, name, deadline)")).to_equal(true)
        expect(workflow.contains("machine_fresh_workload_progress_v3(storage, custody, state)?")).to_equal(true)
        val effects = file_read_text("src/lib/nogc_sync_mut/container/machine_fresh_workload_effects_v3.spl")
        val complete = sr_body_v3(effects, "pub(package) fn machine_fresh_workload_complete_v3(", "\n\n")
        expect(complete.contains("    if name == \"start\": workload_engine_group_observe_v3(custody, state)?")).to_equal(true)

    it "leaves the other helpers of a workspace without the move":
        step("Primary attach (TTY arm): built on the Inspect projection, which clears the mode; its leader lives as long as the transport")
        val binding = file_read_text("src/lib/nogc_sync_mut/io/linux_fresh_workspace_binding_v3.spl")
        val attach = sr_body_v3(binding, "    pub fn project_primary_attach_v3(", "\n\n")
        val inspect_at = attach.index_of("        if attach.workspace.command.action != LinuxFreshWorkloadActionV2.Inspect:\n            return Err(\"fresh-workspace-primary-attach-inspect-identity-required\")")
        expect(inspect_at > 0).to_equal(true)
        expect(attach.index_of("        var projected = self.project_launch_v3(epoch, base, attach.workspace)?") > inspect_at).to_equal(true)
        expect(attach.contains("leader_residue_mode")).to_equal(false)
        expect(binding.contains("leader_residue_mode")).to_equal(false)
        step("Wait and Logs probes: built on a verified Inspect projection of the plain route")
        val probe = file_read_text("src/lib/common/contracts/container/linux_fresh_workload_probe_v3.spl")
        expect(probe.contains("leader_residue_mode")).to_equal(false)
        expect(probe.contains("return Err(\"fresh-probe-closed-inspect-tail-required\")")).to_equal(true)
        step("Secondary exec, TTY or not: the engine socket, never a helper group")
        val exec = file_read_text("src/lib/nogc_async_mut/container/providers/linux/engine_exec_owner_v3.spl")
        expect(exec.contains("local_unix_connect_v1(self.policy.socket_path, self.policy.expected_service_uid, ")).to_equal(true)
        expect(exec.contains("GroupProcessStreamLaunchV2")).to_equal(false)
