"""OAuth CSRF-state / PKCE randomness specification.

generate_state() (CSRF protection) and generate_code_verifier() (PKCE) rely
on random_int(), which previously derived "randomness" from a hardcoded mock
timestamp (get_current_timestamp() always returned 1707753600). That made
every generated state/verifier value on a given run byte-for-byte identical
and fully predictable to an attacker, defeating CSRF protection.

NOTE: random_int()/generate_random_string() internally call `string.char_at`,
which is unresolvable via the legacy `import string` shim in this module
family (a separate, pre-existing defect — `string.char_at` is not among the
members the src/lib/string.spl shim re-exports; only `str_char_at` is).
That blocks exercising random_int() end-to-end through this spec today, so
this spec verifies the two concrete pieces of the fix that ARE reachable:
get_current_timestamp() no longer being pinned to the mock value, and the
underlying CSPRNG source (rt_random_hex) actually producing fresh entropy
per call.
"""

mod nogc_sync_mut.oauth.utilities

use std.nogc_sync_mut.oauth.utilities.{get_current_timestamp}

extern fn rt_random_hex(length: i64) -> text?

describe "OAuth random_int / state entropy":
    """random_int() must not be derived from a fixed mock timestamp."""

    it "get_current_timestamp is not the hardcoded mock value":
        val now = get_current_timestamp()
        expect(now == 1707753600).to_equal(false)

    it "the CSPRNG source backing random_int() produces different values per call":
        # random_int() (used by generate_state/generate_code_verifier) is
        # implemented in terms of rt_random_hex. Before the fix, random_int
        # derived its output from get_current_timestamp() % range, which
        # was always the same mock value within a run -- i.e. deterministic,
        # predictable CSRF state / PKCE verifiers.
        val a = rt_random_hex(8) ?? "MISSING"
        val b = rt_random_hex(8) ?? "MISSING"
        val c = rt_random_hex(8) ?? "MISSING"
        val all_equal = (a == b) and (b == c)
        expect(all_equal).to_equal(false)
