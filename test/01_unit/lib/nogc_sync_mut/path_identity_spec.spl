use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.path_identity.*

describe "Authoritative path identity comparisons":
    it "compares authoritative identities rather than caller path spelling":
        val original = HostFinalPath(path: "C:/Mixed/Root", identity: "//?/Volume{123}/Mixed/Root")
        val alias = HostFinalPath(path: "D:/alias", identity: original.identity)
        expect(path_identity_same(original, alias)).to_be(true)
        expect(path_identity_contains(original, alias)).to_be(true)
        val child = HostFinalPath(path: "D:/alias/child", identity: original.identity + "/child")
        expect(path_identity_contains(original, child)).to_be(true)
        expect(path_identity_contains(child, original)).to_be(false)

    it "requires path-segment boundaries and preserves case-sensitive identities":
        val parent = HostFinalPath(path: "/root", identity: "/root")
        expect(path_identity_contains(parent, HostFinalPath(path: "/root2", identity: "/root2"))).to_be(false)
        expect(path_identity_same(parent, HostFinalPath(path: "/ROOT", identity: "/ROOT"))).to_be(false)
        expect(path_identity_contains(HostFinalPath(path: "/", identity: "/"), parent)).to_be(true)
        expect(path_identity_contains(HostFinalPath(path: "", identity: ""), parent)).to_be(false)

    it "rejects invalid input and capacity before reaching the host":
        expect(path_final_existing("")).to_equal(Err("PATH_IDENTITY_INPUT"))
        expect(path_final_existing("safe\0hidden")).to_equal(Err("PATH_IDENTITY_INPUT"))
        expect(path_final_existing_with_capacity("existing", 0)).to_equal(Err("PATH_IDENTITY_CAPACITY"))
        expect(path_final_existing_with_capacity("existing", 32769)).to_equal(Err("PATH_IDENTITY_CAPACITY"))
        expect(path_entry_present("")).to_equal(Err("PATH_IDENTITY_INPUT"))
        expect(path_entry_present("/parent/..")).to_equal(Err("PATH_ENTRY_LEAF"))
        expect(path_entry_present("/parent/.")).to_equal(Err("PATH_ENTRY_LEAF"))
        expect(path_entry_present("/parent/")).to_equal(Err("PATH_ENTRY_LEAF"))
        expect(path_entry_present("relative-leaf")).to_equal(Err("PATH_ENTRY_LEAF"))
