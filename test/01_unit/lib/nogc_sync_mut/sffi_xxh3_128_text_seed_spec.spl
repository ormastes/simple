"""
## Purpose and audience
Purpose: Prove `rt_xxh3_128_text` is callable from specs (seed interpreter
and native), so frontend parse-cache keys can be exercised directly.
Audience: compiler cache engineers.
"""

use std.spec
use std.nogc_sync_mut.sffi.runtime.{xxh3_128_text}

describe "xxh3_128_text extern":
    it "returns the 32-hex XXH3-128 of a known input":
        expect(xxh3_128_text("abc")).to_equal("06b05ab6733a618578af5f94892f3950")

    it "is deterministic and input-sensitive":
        expect(xxh3_128_text("frontend|x")).to_equal(xxh3_128_text("frontend|x"))
        expect(xxh3_128_text("a") == xxh3_128_text("b")).to_equal(false)
