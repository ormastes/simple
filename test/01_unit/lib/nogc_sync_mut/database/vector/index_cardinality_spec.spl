use std.spec
use std.database.vector.index.{BruteForceIndex}

describe "Vector index cardinality":
    it "tracks live identities across replacement and removal":
        val index = BruteForceIndex.create(2)
        expect(index.size()).to_equal(0)
        expect(index.add("a", [1.0, 0.0]).is_ok()).to_equal(true)
        expect(index.size()).to_equal(1)
        expect(index.add("a", [0.0, 1.0]).is_ok()).to_equal(true)
        expect(index.size()).to_equal(1)
        expect(index.add("b", [1.0, 1.0]).is_ok()).to_equal(true)
        expect(index.size()).to_equal(2)
        expect(index.remove("a").is_ok()).to_equal(true)
        expect(index.size()).to_equal(1)
        expect(index.remove("missing").is_err()).to_equal(true)
        expect(index.size()).to_equal(1)

    it "clear releases every retained vector":
        val index = BruteForceIndex.create(2)
        expect(index.add("a", [1.0, 0.0]).is_ok()).to_equal(true)
        expect(index.add("b", [0.0, 1.0]).is_ok()).to_equal(true)
        index.clear()
        expect(index.size()).to_equal(0)
