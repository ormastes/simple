# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Behavioral oracle for the lsp_query numeric guards: extract_symbol_at
# must reject out-of-range line/column numbers instead of indexing out of
# bounds, and must resolve a real word at a real position.

use std.spec.step
use std.nogc_sync_mut.lsp.lsp_query.{extract_symbol_at}

describe "lsp_query numeric guards":
    # @manual scenario evidence
    it "defaults malformed line and column arguments":
        # @req REQ-SSPEC-LIB
        step("out-of-range line and column indices return empty")
        val file = "src/lib/nogc_sync_mut/lsp/lsp_query.spl"
        # oracle: line 0 / negative / beyond EOF are all rejected as ""
        expect(extract_symbol_at(file, 0, 1)).to_equal("")
        expect(extract_symbol_at(file, -5, 1)).to_equal("")
        expect(extract_symbol_at(file, 100000, 1)).to_equal("")

    it "resolves the symbol at a real line and column":
        # @req REQ-SSPEC-LIB
        step("line 17 col 1 lands on the extract_symbol_at declaration")
        val file = "src/lib/nogc_sync_mut/lsp/lsp_query.spl"
        # oracle: line 17 of lsp_query.spl is the extract_symbol_at decl
        expect(extract_symbol_at(file, 17, 1)).to_equal("extract_symbol_at")
        expect(extract_symbol_at(file, 18, 20)).to_equal("rt_file_read_text")
