use std.nogc_sync_mut.storage_roots.environment_owner.{storage_root_environment_snapshot}
use std.nogc_sync_mut.env.variables.{env_set, env_unset}

describe "storage root environment owner":
    it "captures only the two root authorities and ignores temporary authority":
        env_set("SIMPLE_USER_STORAGE_ROOT", "/fixture/user")
        env_set("SIMPLE_WORKTREE_STORAGE_ROOT", "/fixture/worktree")
        env_set("TMPDIR", "/forbidden/third/root")
        val snapshot = storage_root_environment_snapshot()
        expect(snapshot.user_root).to_equal(Some("/fixture/user"))
        expect(snapshot.worktree_root).to_equal(Some("/fixture/worktree"))
        expect(snapshot.user_root == Some("/forbidden/third/root")).to_equal(false)
        expect(snapshot.worktree_root == Some("/forbidden/third/root")).to_equal(false)
        env_unset("SIMPLE_USER_STORAGE_ROOT")
        env_unset("SIMPLE_WORKTREE_STORAGE_ROOT")
        env_unset("TMPDIR")
