# @cover src/lib/nogc_sync_mut/ui/compare_view_host.spl 60%
# @tag: rendering, pixel-compare, inspection
"""
## Purpose and audience
Proves the effectful half of compare-view inspection without opening any
window: off (the default) touches nothing, and an enabled run writes the two
images plus the inspection page and reports where they are when no viewer is
available. Written for rendering-parity test owners.
## Operator workflow
`SIMPLE_COMPARE_VIEW=stay|auto bin/simple test <compare spec>` opens the
viewer; this spec never does.
"""
use std.spec.*
use std.io_runtime.{file_exists, file_read, file_size, dir_remove_all, host_os}
use std.nogc_sync_mut.ui.compare_view_host.{compare_view_inspect_with, compare_view_inspect, compare_view_find_browser, compare_view_host_screen}

fn _solid(n: i64, argb: u32) -> [u32]:
    var px: [u32] = []
    var i = 0
    while i < n:
        px.push(argb)
        i = i + 1
    px

describe "compare_view host":

    it "does nothing when off":
        dir_remove_all("build/compare_view/host_spec_off")
        val status = compare_view_inspect_with("off", 1920, 1040, "", 0,
            "host spec off", "simple", _solid(4, 0xFFFF0000u32), 2, 2, "ref", _solid(4, 0xFF00FF00u32), 2, 2)
        expect(status).to_equal("off")
        expect(file_exists("build/compare_view/host_spec_off/index.html")).to_equal(false)

    it "is off through the environment default":
        val status = compare_view_inspect("host spec env", "simple", _solid(4, 0xFFFF0000u32), 2, 2, "ref", _solid(4, 0xFF00FF00u32), 2, 2)
        expect(status).to_equal("off")

    it "writes both images and the page, and reports them when no viewer exists":
        dir_remove_all("build/compare_view/host_spec_on")
        val status = compare_view_inspect_with("stay", 1920, 1040, "", 0,
            "host spec on", "simple", _solid(12, 0xFFFF0000u32), 4, 3, "chrome", _solid(12, 0xFF00FF00u32), 4, 3)
        expect(status).to_start_with("no-viewer:")
        expect(status).to_end_with("build/compare_view/host_spec_on/index.html")
        expect(file_size("build/compare_view/host_spec_on/a.png") > 0).to_equal(true)
        expect(file_size("build/compare_view/host_spec_on/b.png") > 0).to_equal(true)
        val html = file_read("build/compare_view/host_spec_on/index.html")
        expect(html).to_contain("A: simple 4x3")
        expect(html).to_contain("B: chrome 4x3")
        expect(file_size("build/compare_view/host_spec_on/diff.png") > 0).to_equal(true)
        expect(html).to_contain("DIFF: 12 px differ")

    it "rejects a buffer whose length does not match its size":
        val status = compare_view_inspect_with("stay", 1920, 1040, "", 0,
            "host spec bad", "simple", _solid(3, 0xFFFF0000u32), 2, 2, "ref", _solid(4, 0xFF00FF00u32), 2, 2)
        expect(status).to_start_with("bad-buffer:")

    it "keeps a second pair with the same name apart from the first":
        val first = compare_view_inspect_with("stay", 1920, 1040, "", 0,
            "host spec dup", "simple", _solid(4, 0xFFFF0000u32), 2, 2, "ref", _solid(4, 0xFF00FF00u32), 2, 2)
        val second = compare_view_inspect_with("stay", 1920, 1040, "", 0,
            "host spec dup", "simple", _solid(4, 0xFF0000FFu32), 2, 2, "ref", _solid(4, 0xFF00FF00u32), 2, 2)
        expect(first).to_end_with("build/compare_view/host_spec_dup/index.html")
        expect(second).to_end_with("build/compare_view/host_spec_dup__2/index.html")

    it "treats a missing viewer path as no viewer":
        expect(compare_view_find_browser("definitely/not/a/browser.exe")).to_equal("")

    it "writes a.png, b.png, diff.png, heatmap.png, and index.html in html mode":
        dir_remove_all("build/compare_view/host_spec_html")
        val status = compare_view_inspect_with("html", 1920, 1040, "/usr/bin/true", 0,
            "host spec html", "simple", _solid(12, 0xFFFF0000u32), 4, 3, "chrome", _solid(12, 0xFFFF0200u32), 4, 3)
        expect(status).to_start_with("written:")
        expect(status).to_end_with("build/compare_view/host_spec_html/index.html")
        expect(file_size("build/compare_view/host_spec_html/a.png") > 0).to_equal(true)
        expect(file_size("build/compare_view/host_spec_html/b.png") > 0).to_equal(true)
        expect(file_size("build/compare_view/host_spec_html/diff.png") > 0).to_equal(true)
        expect(file_size("build/compare_view/host_spec_html/heatmap.png") > 0).to_equal(true)
        val html = file_read("build/compare_view/host_spec_html/index.html")
        expect(html).to_contain("DIFF: 12 px differ")
        expect(html).to_contain("match: 0.00%")
        expect(html).to_contain("SMALL BUFFER")
        expect(file_size("build/compare_view/host_spec_html/delta.png") > 0).to_equal(true)
        expect(html).to_contain("color: 12 px")

    it "writes IDENTICAL status and delta.png for identical buffers and shape/alpha breakdown for mixed diffs":
        dir_remove_all("build/compare_view/host_spec_identical")
        val same_px = _solid(12, 0xFF1E50C8u32)
        val st_same = compare_view_inspect_with("html", 1920, 1040, "", 0,
            "host spec identical", "simple", same_px, 4, 3, "skia", same_px, 4, 3)
        expect(st_same).to_start_with("written:")
        expect(file_size("build/compare_view/host_spec_identical/delta.png") > 0).to_equal(true)
        val html_same = file_read("build/compare_view/host_spec_identical/index.html")
        expect(html_same).to_contain("IDENTICAL (0 color diff, 0 shape/alpha diff, max Δ=0)")

        dir_remove_all("build/compare_view/host_spec_mixed")
        val a_px: [u32] = [0x00000000u32, 0xFF1E50C8u32, 0xFF1E50C8u32, 0x00000000u32]
        val b_px: [u32] = [0x00000000u32, 0x00000000u32, 0xFFC83C1Eu32, 0x00000000u32]
        val st_mix = compare_view_inspect_with("html", 1920, 1040, "", 0,
            "host spec mixed", "winding", a_px, 2, 2, "evenodd", b_px, 2, 2)
        expect(st_mix).to_start_with("written:")
        expect(file_size("build/compare_view/host_spec_mixed/delta.png") > 0).to_equal(true)
        val html_mix = file_read("build/compare_view/host_spec_mixed/index.html")
        expect(html_mix).to_contain("shape/alpha: 1 px (gold=A, cyan=B) | color: 1 px")

    it "resolves a non-zero screen size on macOS":
        val os = host_os()
        if os == "macos" or os == "darwin":
            val sz = compare_view_host_screen()
            expect(sz.w > 0 and sz.h > 0).to_equal(true)
