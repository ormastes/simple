use std.spec
use common.ui.builder.{build_tree, button, column, text_field}
use common.ui.widget.{UIEvent}
use nogc_sync_mut.ui.session.{UISession}

describe "UISession physical shortcuts":
    it "selects, copies, cuts, and pastes without inserting shortcut text":
        val tree = build_tree(column("root", [
            text_field("field", "Simple123", "type")
        ]))
        var session = UISession.new(tree)
        session.dispatch(UIEvent.FocusEvent("field", "focus"))
        expect(session.dispatch_key_with_modifiers(
            "a", true, false, false, false
        )).to_equal("select_all")
        val field = tree.find_widget("field")
        if field != nil:
            expect(field.get_prop("selection_start")).to_equal("0")
            expect(field.get_prop("selection_end")).to_equal("9")

        expect(session.dispatch_key_with_modifiers(
            "c", true, false, false, false
        )).to_equal("copy")
        expect(session.dispatch_key_with_modifiers(
            "x", true, false, false, false
        )).to_equal("cut")
        if field != nil:
            expect(field.get_prop("value")).to_equal("")
        expect(session.dispatch_key_with_modifiers(
            "v", true, false, false, false
        )).to_equal("paste")
        if field != nil:
            expect(field.get_prop("value")).to_equal("Simple123")

    it "reports a focused button activation exactly once":
        val tree = build_tree(column("root", [
            button("play", "Play", "wm-demo.click")
        ]))
        var session = UISession.new(tree)
        session.dispatch(UIEvent.FocusEvent("play", "focus"))
        session.dispatch_key_with_modifiers(
            "enter", false, false, false, false
        )
        expect(session.take_pending_action()).to_equal("wm-demo.click")
        expect(session.take_pending_action()).to_equal("")
