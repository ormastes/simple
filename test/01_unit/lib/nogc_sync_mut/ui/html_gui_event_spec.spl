use std.spec
use std.nogc_sync_mut.ui.html_gui_sffi.{html_gui_decode_event}

describe "Optional HTML GUI copied event packet":
    it "retains newlines in pasted text":
        val event = html_gui_decode_event("text\nhello\nworld")
        expect(event.kind).to_equal("text")
        expect(event.data).to_equal("hello\nworld")

    it "decodes close with an empty payload":
        val event = html_gui_decode_event("close\n")
        expect(event.kind).to_equal("close")
        expect(event.data).to_equal("")

    it "preserves non-ASCII text and a line break":
        val event = html_gui_decode_event("text\n한\n🙂")
        expect(event.kind).to_equal("text")
        expect(event.data).to_equal("한\n🙂")

    it "distinguishes an idle poll from close":
        val event = html_gui_decode_event("")
        expect(event.kind).to_equal("")
        expect(event.data).to_equal("")

    it "closes on malformed framing":
        val event = html_gui_decode_event("missing delimiter")
        expect(event.kind).to_equal("close")
        expect(event.data).to_equal("invalid provider event")

    it "closes on an empty event kind":
        val event = html_gui_decode_event("\npayload")
        expect(event.kind).to_equal("close")
