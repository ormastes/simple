# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/nogc_sync_mut/ui/ui_scene_column_arena_v2.spl 80%
# @tag: unit, ui, draw_ir_v3, unified_packed_ui_scene, render_perf, f3

use std.spec.step

use std.spec
use std.spec.step
use nogc_sync_mut.ui.ui_scene_column_arena_v2.{
    UiSceneColumnArenaV2,
    UI_SCENE_V2_OK,
    UI_SCENE_V2_PARTITION_OVERFLOW,
    UI_SCENE_V2_BAD_PARTITION,
    UI_SCENE_V2_BAD_COLUMN,
    UI_SCENE_V2_SWAP_BLOCKED
}
use nogc_sync_mut.ui.draw_ir_v3_direct_writer_v2.{

    ui_scene_v2_write_row,
    ui_scene_v2_update_word,
    ui_scene_v2_commit
}

# two tables: table 0 stride 4 cap 8 rows, table 1 stride 2 cap 4 rows
fn make_arena() -> UiSceneColumnArenaV2:
    UiSceneColumnArenaV2.create([4, 2], [8, 4])

describe "UiSceneColumnArenaV2 (F3) direct writes":
    # @manual scenario evidence
    it "leases stable partitions and refuses over-capacity leases":
        # @req REQ-SSPEC-UNIT
        step("leases stable partitions and refuses over-capacity leases")
        val a = make_arena()
        val lease_storage = a.part_table.len()
        assert_true(lease_storage == 12)
        val p0 = a.lease_partition(1, 0, 5)
        val p1 = a.lease_partition(2, 0, 3)
        assert_true(p0 == 0)
        assert_true(p1 == 1)
        # table 0 is now full: 5+3 == 8
        assert_true(a.lease_partition(3, 0, 1) == -1)
        assert_true(a.lease_partition(3, 0, 0) == -1)
        assert_true(a.part_table.len() == lease_storage)
        assert_true(a.part_start_row.len() == lease_storage)
        assert_true(a.part_cap_rows.len() == lease_storage)
        assert_true(a.part_cursor_rows.len() == lease_storage)
        assert_true(a.part_producer.len() == lease_storage)

    it "writes rows directly and reads them back after swap":
        # @req REQ-SSPEC-UNIT
        step("writes rows directly and reads them back after swap")
        val a = make_arena()
        val p = a.lease_partition(1, 0, 2)
        assert_true(ui_scene_v2_write_row(a, p, 0, [10, 11, 12, 13]) == UI_SCENE_V2_OK)
        assert_true(ui_scene_v2_write_row(a, p, 1, [20, 21, 22, 23]) == UI_SCENE_V2_OK)
        assert_true(ui_scene_v2_commit(a) == UI_SCENE_V2_OK)
        assert_true(a.front_word(0, 0, 0) == 10)
        assert_true(a.front_word(0, 1, 3) == 23)

    it "refuses writes past the leased partition (typed refusal, no grow)":
        # @req REQ-SSPEC-UNIT
        step("refuses writes past the leased partition (typed refusal, no grow)")
        val a = make_arena()
        val p = a.lease_partition(1, 0, 2)
        assert_true(ui_scene_v2_write_row(a, p, 2, [1, 2, 3, 4]) == UI_SCENE_V2_PARTITION_OVERFLOW)
        assert_true(a.write_word_value(p, 0, 9, 1) == UI_SCENE_V2_BAD_COLUMN)
        assert_true(a.write_word_value(99, 0, 0, 1) == UI_SCENE_V2_BAD_PARTITION)

    it "records coalesced dirty row ranges on the back generation":
        # @req REQ-SSPEC-UNIT
        step("records coalesced dirty row ranges on the back generation")
        val a = make_arena()
        val p = a.lease_partition(1, 0, 4)
        ui_scene_v2_write_row(a, p, 0, [1, 1, 1, 1])
        ui_scene_v2_write_row(a, p, 1, [2, 2, 2, 2])
        # rows 0 and 1 are contiguous -> one coalesced range of 2
        assert_true(a.dirty_len == 1)
        assert_true(a.dirty_start[0] == 0)
        assert_true(a.dirty_count[0] == 2)
        ui_scene_v2_write_row(a, p, 3, [3, 3, 3, 3])
        assert_true(a.dirty_len == 2)

    it "keeps dirty storage fixed when interleaved writes bridge ranges":
        val a = make_arena()
        val p = a.lease_partition(1, 0, 3)
        val q = a.lease_partition(2, 1, 1)
        val storage = a.dirty_table.len()
        ui_scene_v2_write_row(a, p, 0, [1, 1, 1, 1])
        ui_scene_v2_write_row(a, p, 2, [2, 2, 2, 2])
        ui_scene_v2_write_row(a, q, 0, [3, 3])
        assert_true(a.dirty_len == 3)
        # Row 1 bridges the two table-0 ranges even though table 1 was written
        # between them.  Canonical merging prevents another dirty allocation.
        ui_scene_v2_write_row(a, p, 1, [4, 4, 4, 4])
        assert_true(a.dirty_len == 2)
        assert_true(a.dirty_table.len() == storage)
        assert_true(a.dirty_start.len() == storage)
        assert_true(a.dirty_count.len() == storage)

    it "blocks swap until the back generation is sealed":
        # @req REQ-SSPEC-UNIT
        step("blocks swap until the back generation is sealed")
        val a = make_arena()
        assert_true(a.try_swap() == UI_SCENE_V2_SWAP_BLOCKED)

    it "GATE: two warm generations, zero commit-copy bytes, one allocation":
        # @req REQ-SSPEC-UNIT
        step("GATE: two warm generations, zero commit-copy bytes, one allocation")
        val a = make_arena()
        val p = a.lease_partition(1, 0, 4)
        val q = a.lease_partition(2, 1, 2)
        # Dirty metadata is preallocated from table row capacity (8 + 4), then
        # reset only by length across every warm generation.
        val dirty_storage = a.dirty_table.len()
        assert_true(dirty_storage == 12)
        assert_true(a.dirty_start.len() == dirty_storage)
        assert_true(a.dirty_count.len() == dirty_storage)
        # generation 1
        assert_true(ui_scene_v2_write_row(a, p, 0, [1, 2, 3, 4]) == UI_SCENE_V2_OK)
        assert_true(ui_scene_v2_write_row(a, q, 0, [7, 8]) == UI_SCENE_V2_OK)
        assert_true(ui_scene_v2_commit(a) == UI_SCENE_V2_OK)
        # generation 2 — retained update of one stable word only
        assert_true(ui_scene_v2_update_word(a, p, 0, 2, 33) == UI_SCENE_V2_OK)
        assert_true(ui_scene_v2_commit(a) == UI_SCENE_V2_OK)
        # the gate from plan §12.2 F3: no commit copy, no reallocation
        assert_true(a.commit_copy_bytes == 0)
        assert_true(a.alloc_count == 1)
        assert_true(a.dirty_table.len() == dirty_storage)
        assert_true(a.dirty_start.len() == dirty_storage)
        assert_true(a.dirty_count.len() == dirty_storage)
        assert_true(a.front_word(0, 0, 2) == 33)

    it "incremental update marks exactly one dirty range":
        # @req REQ-SSPEC-UNIT
        step("incremental update marks exactly one dirty range")
        val a = make_arena()
        val p = a.lease_partition(1, 0, 4)
        ui_scene_v2_write_row(a, p, 0, [1, 2, 3, 4])
        ui_scene_v2_commit(a)
        assert_true(a.dirty_len == 0)
        ui_scene_v2_update_word(a, p, 0, 1, 99)
        assert_true(a.dirty_len == 1)
        assert_true(a.dirty_count[0] == 1)
