use std.io_runtime.{file_read}

val ENTRY: text = "src/lib/nogc_sync_mut/ui/gui_renderer.spl"

fn source() -> text:
    file_read(ENTRY)

describe "GuiRenderer diagnostics contract":

    it "preserves native event identity in every typed event":
        val s = source()
        expect(s).to_contain("native_id: i64")
        expect(s).to_contain("GuiEvent(native_id: 0, kind: GUI_EVT_NONE")
        expect(s).to_contain("GuiEvent(native_id: ev, kind: ty")
        expect(s).to_contain("dbg_event_hop(\"native-\{ev\}\", \"winit_poll\"")
        expect(s).to_contain("dbg_event_hop(\"native-\{ev\}\", \"gui_event_decode\"")

    it "records each fallible GUI creation boundary with std.diag stages":
        val s = source()
        expect(s).to_contain("use std.diag.{dbg_stage, dbg_event_hop, dbg_events_on}")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_dylib_open_start\")")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_dylib_open_failed\")")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_event_loop_create_start\")")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_event_loop_create_failed\")")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_window_create_start\")")
        expect(s).to_contain("dbg_stage(\"gui\", \"winit_window_create_failed\")")

    it "guards event detail formatting behind the events facet":
        val s = source()
        val poll_hop = s.index_of("dbg_event_hop(\"native-\{ev\}\", \"winit_poll\"")
        val decode_hop = s.index_of("dbg_event_hop(\"native-\{ev\}\", \"gui_event_decode\"")
        expect(poll_hop > 0).to_be(true)
        expect(decode_hop > poll_hop).to_be(true)
        expect(s.substring(poll_hop - 80, poll_hop)).to_contain("if dbg_events_on():")
        expect(s.substring(decode_hop - 80, decode_hop)).to_contain("if dbg_events_on():")
