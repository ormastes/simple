"""Native ABI contract for one-word, explicitly-owned channel capsules."""

use std.spec
use std.io.file_read_text

describe "Owned channel capsule native ABI":
    it "exposes one-word receive and release operations to Simple owners":
        val source = file_read_text(
            "src/lib/nogc_sync_mut/concurrent/channel.spl")
        expect(source).to_contain("extern fn rt_channel_free(channel_id: i64)")
        expect(source).to_contain("fn channel_recv_by_id(id: i64) -> Any:")
        expect(source).to_contain("fn channel_free_by_id(id: i64):")

    it "releases the core-C queue and synchronization objects exactly once":
        val source = file_read_text("src/runtime/runtime_native.c")
        expect(source).to_contain("void rt_channel_free(int64_t id)")
        expect(source).to_contain("if (!ch->in_use) return;")
        expect(source).to_contain("free(ch->queue);")
        expect(source).to_contain("pthread_cond_destroy(&ch->not_empty);")
        expect(source).to_contain("pthread_mutex_destroy(&ch->lock);")
        expect(source).to_contain("memset(ch, 0, sizeof(*ch));")
