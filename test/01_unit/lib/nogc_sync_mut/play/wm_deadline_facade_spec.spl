use std.spec
use std.nogc_sync_mut.play.wm.mod.{wm_list_windows_until, wm_focus_window_checked_until, wm_type_text_window_checked_until}
use std.play.types.{ERR_TIMEOUT}

describe "nogc_sync_mut window deadline facade":
    it "rejects an expired inventory request":
        match wm_list_windows_until(1):
            case Err(error): expect(error.code).to_equal(ERR_TIMEOUT)
            case Ok(_): fail("expired inventory unexpectedly succeeded")

    it "rejects an expired focus request before acting on a window":
        match wm_focus_window_checked_until("0", "no target", 1):
            case Err(error): expect(error.code).to_equal(ERR_TIMEOUT)
            case Ok(_): fail("expired focus unexpectedly succeeded")

    it "rejects expired target typing before sending input":
        match wm_type_text_window_checked_until("0", "no target", "must not type", 1):
            case Err(error): expect(error.code).to_equal(ERR_TIMEOUT)
            case Ok(_): fail("expired typing unexpectedly succeeded")

