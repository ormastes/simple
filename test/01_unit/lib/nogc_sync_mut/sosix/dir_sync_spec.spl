# SOSIX dir_sync: durable directory-entry sync primitive (rt_dir_sync). Real
# temp dirs, no mocks. POSIX fsyncs the directory; Windows reports true for an
# existing directory. Missing path or a regular file is false on every host.
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.sosix.fs_v1.{dir_sync, dir_create_all, dir_remove_all, file_write_bytes, secure_temp_dir_raw}

describe "sosix dir_sync":
    it "is true for an existing directory":
        dir_create_all("build/test-artifacts")
        val owned = secure_temp_dir_raw("build/test-artifacts", "dsync-")
        expect(owned == "").to_equal(false)
        expect(dir_sync(owned)).to_equal(true)
        dir_remove_all(owned)

    it "is false for a missing path":
        expect(dir_sync("build/test-artifacts/dsync-does-not-exist-xyz")).to_equal(false)

    it "is false for a regular file":
        dir_create_all("build/test-artifacts")
        val owned = secure_temp_dir_raw("build/test-artifacts", "dsync-")
        expect(owned == "").to_equal(false)
        val file = owned + "/plain.txt"
        expect(file_write_bytes(file, "x".bytes())).to_equal(true)
        expect(dir_sync(file)).to_equal(false)
        dir_remove_all(owned)
