# Windows AppContainer filesystem-confinement verdict over the SOSIX app sandbox
# (sosix_app_sandbox_run_v1). Windows only: off Windows each example prints SKIP and
# returns (visible, and never evidence). On Windows a missing seed FAILS.
# Children are copies of the running seed executing test/fixtures/container/app_sandbox_probe.spl
# `open <path>` (exit 0 readable, 5 access denied). The seed copy + probe sit in a staging dir
# granted READ; the child cwd is a second dir granted MODIFY; the outside dir is granted to
# nobody but is readable by Everyone and by the host, so a denial is the AppContainer's.
use std.spec.{describe, it, expect}
use std.platform.{is_windows, get_current_dir, get_temp_dir}
use std.nogc_sync_mut.io_runtime.{env_get, file_exists, file_copy, file_write, getpid, time_now_monotonic_ms}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all, dir_list}
use std.common.contracts.sosix.containment_v1.{SosixContainMillisV1, SosixContainExitCodeV1, SosixContainFlagV1}
use std.common.contracts.container.capability_report_v1.{container_capability_report_v1_empty}
use std.nogc_sync_mut.sosix.app_container_types_v1.{SosixAppSandboxRequestV1, SosixAppSandboxResultV1}
use std.nogc_sync_mut.sosix.app_container_v1.{sosix_app_sandbox_run_v1}
use std.nogc_sync_mut.io.windows_process_owner_abi.{windows_abi_get_module_file_name_w}
use std.common.char_from_code_pure.{char_from_code}
use std.nogc_sync_mut.sosix.windows.security_abi_v1.{sec_alloc_v1, sec_free_v1, sec_local_free_v1, sec_read_ptr_v1, sec_u16_v1, sec_get_dacl_v1, sec_set_entries_v1, sec_set_dacl_v1, sec_access_entry_v1, sec_sid_from_text_v1}
use std.nogc_sync_mut.io.windows_appcontainer_v1.{WindowsAppContainerVerdictV1, WINDOWS_APPCONTAINER_DENIED_EXIT_V1, windows_appcontainer_verdict_v1, windows_appcontainer_apply_runs_v1}

val RUN_TAG = getpid().to_string() + "_" + time_now_monotonic_ms().to_string()

# Path of the binary running this spec (GetModuleFileNameW of the process), ASCII only; "" off Windows.
fn running_binary() -> text:
    if not is_windows(): return ""
    val buffer = sec_alloc_v1(1040)
    if buffer == 0: return ""
    val count = windows_abi_get_module_file_name_w(0, buffer, 520)
    var out = ""
    var index = 0
    while index < count and index < 520:
        val unit = sec_u16_v1(buffer + index * 2)
        if unit == 0 or unit > 127: break
        out = out + char_from_code(unit)
        index = index + 1
    sec_free_v1(buffer)
    out.replace("\\", "/")

val SEED = running_binary()

fn ready() -> bool:
    is_windows() and file_exists(SEED)

fn skipped() -> bool:
    if not is_windows():
        print("SKIP: AppContainer confinement examples require Windows")
        return true
    expect(file_exists(SEED)).to_equal(true)
    false

val BASE = get_temp_dir().replace("\\", "/") + "/ac_confine_" + RUN_TAG
val STAGE = BASE + "/stage"
val WORK = BASE + "/work"
val OUTSIDE = BASE + "/outside"

# Everyone (S-1-1-0) gets read+execute on `path`: readable by a plain user, which is the case
# the AppContainer must still deny.
fn grant_everyone_read(path: text) -> bool:
    val sid = sec_sid_from_text_v1("S-1-1-0")
    val slot = sec_alloc_v1(8)
    val entries = sec_alloc_v1(48)
    var done = false
    if sid != 0 and slot != 0 and entries != 0:
        val native = path.replace("/", "\\")
        val descriptor = sec_get_dacl_v1(native, slot)
        if descriptor != 0:
            sec_access_entry_v1(entries, 0, 0x1200A9, 3, sid)
            val merged = sec_set_entries_v1(1, entries, sec_read_ptr_v1(slot))
            if merged != 0: done = sec_set_dacl_v1(native, merged)
            sec_local_free_v1(merged)
        sec_local_free_v1(descriptor)
    sec_free_v1(entries)
    sec_free_v1(slot)
    sec_local_free_v1(sid)
    done

# Number of ACEs in the DACL of a path; -1 when unreadable.
fn ace_count(path: text) -> i64:
    val slot = sec_alloc_v1(8)
    if slot == 0: return -1
    val descriptor = sec_get_dacl_v1(path.replace("/", "\\"), slot)
    var count = -1
    if descriptor != 0:
        val dacl = sec_read_ptr_v1(slot)
        if dacl != 0: count = sec_u16_v1(dacl + 4)
    sec_local_free_v1(descriptor)
    sec_free_v1(slot)
    count

# Number of sandbox profile folders (sosix-*) currently on disk.
fn profile_count() -> i64:
    val packages = env_get("LOCALAPPDATA").unwrap_or("").replace("\\", "/") + "/Packages"
    var count = 0
    for entry in dir_list(packages):
        if entry.starts_with("sosix-"): count = count + 1
    count

fn setup() -> bool:
    if not ready(): return false
    val made = dir_create_all(STAGE) and dir_create_all(WORK) and dir_create_all(OUTSIDE)
    val probe = get_current_dir().replace("\\", "/") + "/test/fixtures/container/app_sandbox_probe.spl"
    val staged = file_copy(SEED, STAGE + "/seed.exe") and file_copy(probe, STAGE + "/probe.spl")
    val files = file_write(OUTSIDE + "/user.txt", "user-private-readable") and file_write(WORK + "/inside.txt", "inside-readable")
    made and staged and files and grant_everyone_read(OUTSIDE)

val SETUP_OK = setup()
val WORK_ACES_BEFORE = if SETUP_OK: ace_count(WORK) else: -1
val STAGE_ACES_BEFORE = if SETUP_OK: ace_count(STAGE) else: -1
val PROFILES_BEFORE = if SETUP_OK: profile_count() else: -1

fn open_request(tag: text, target: text) -> SosixAppSandboxRequestV1:
    SosixAppSandboxRequestV1(scope: "ac-" + tag, program: STAGE + "/seed.exe",
        args: ["run", STAGE + "/probe.spl", "args:", "open", target], directory: WORK,
        readonly_dirs: [STAGE], writable_dirs: [WORK],
        stdout_path: BASE + "/" + tag + ".out", stderr_path: BASE + "/" + tag + ".err",
        wall: SosixContainMillisV1(120000))

fn open_run(tag: text, target: text) -> SosixAppSandboxResultV1:
    sosix_app_sandbox_run_v1(open_request(tag, target))

fn idle() -> SosixAppSandboxResultV1:
    SosixAppSandboxResultV1(reason: "not-run", exit_code: SosixContainExitCodeV1(-1), timed_out: SosixContainFlagV1(false))

fn fake(code: i64) -> SosixAppSandboxResultV1:
    SosixAppSandboxResultV1(reason: "", exit_code: SosixContainExitCodeV1(code), timed_out: SosixContainFlagV1(false))

val inside_run = if SETUP_OK: open_run("inside", WORK + "/inside.txt") else: idle()
val outside_run = if SETUP_OK: open_run("outside", OUTSIDE + "/user.txt") else: idle()
val missing_run = if SETUP_OK: open_run("missing", OUTSIDE + "/absent.txt") else: idle()
val leaky_run = if SETUP_OK: open_run("leaky", WORK + "/inside.txt") else: idle()
val WORK_ACES_AFTER = if SETUP_OK: ace_count(WORK) else: -1
val STAGE_ACES_AFTER = if SETUP_OK: ace_count(STAGE) else: -1
val PROFILES_AFTER = if SETUP_OK: profile_count() else: -1

fn not_confined(verdict: WindowsAppContainerVerdictV1, why: text) -> bool:
    match verdict:
        WindowsAppContainerVerdictV1.NotConfined(reason): reason == why
        _: false

fn is_confined(verdict: WindowsAppContainerVerdictV1) -> bool:
    match verdict:
        WindowsAppContainerVerdictV1.Confined: true
        _: false

describe "windows appcontainer filesystem confinement":
    it "reads inside the granted dir and is denied outside it":
        if skipped(): return
        expect(SETUP_OK).to_equal(true)
        expect(inside_run.reason).to_equal("")
        expect(inside_run.exit_code.value).to_equal(0)
        expect(outside_run.reason).to_equal("")
        expect(outside_run.exit_code.value).to_equal(WINDOWS_APPCONTAINER_DENIED_EXIT_V1)

    it "is Confined and flips filesystem_confinement only from the measured runs":
        if skipped(): return
        val verdict = windows_appcontainer_verdict_v1(inside_run, outside_run, OUTSIDE + "/user.txt")
        expect(is_confined(verdict)).to_equal(true)
        val report = windows_appcontainer_apply_runs_v1(container_capability_report_v1_empty(), inside_run, outside_run, OUTSIDE + "/user.txt")
        expect(report.filesystem_confinement.value).to_equal(true)
        expect(container_capability_report_v1_empty().filesystem_confinement.value).to_equal(false)

    it "is not Confined when the outside child crashed or exited negative":
        if skipped(): return
        val path = OUTSIDE + "/user.txt"
        expect(not_confined(windows_appcontainer_verdict_v1(inside_run, fake(3221225477), path), "outside-exit-not-access-denied")).to_equal(true)
        expect(not_confined(windows_appcontainer_verdict_v1(inside_run, fake(1), path), "outside-exit-not-access-denied")).to_equal(true)
        expect(not_confined(windows_appcontainer_verdict_v1(inside_run, fake(-1), path), "outside-exit-not-access-denied")).to_equal(true)
        val report = windows_appcontainer_apply_runs_v1(container_capability_report_v1_empty(), inside_run, fake(3221225477), path)
        expect(report.filesystem_confinement.value).to_equal(false)

    it "is not Confined when the outside file does not exist for the host":
        if skipped(): return
        expect(missing_run.exit_code.value).to_equal(WINDOWS_APPCONTAINER_DENIED_EXIT_V1)
        expect(not_confined(windows_appcontainer_verdict_v1(inside_run, missing_run, OUTSIDE + "/absent.txt"), "outside-control-unreadable")).to_equal(true)

    it "is not Confined when the outside read succeeds or the inside read fails":
        if skipped(): return
        expect(leaky_run.exit_code.value).to_equal(0)
        expect(not_confined(windows_appcontainer_verdict_v1(inside_run, leaky_run, WORK + "/inside.txt"), "outside-read-succeeded")).to_equal(true)
        expect(not_confined(windows_appcontainer_verdict_v1(outside_run, outside_run, OUTSIDE + "/user.txt"), "inside-read-failed")).to_equal(true)
        expect(not_confined(windows_appcontainer_verdict_v1(idle(), outside_run, OUTSIDE + "/user.txt"), "inside-run-failed")).to_equal(true)

    it "leaves no grant and no profile behind after the runs":
        if skipped(): return
        expect(WORK_ACES_AFTER).to_equal(WORK_ACES_BEFORE)
        expect(STAGE_ACES_AFTER).to_equal(STAGE_ACES_BEFORE)
        expect(PROFILES_AFTER).to_equal(PROFILES_BEFORE)
        dir_remove_all(BASE)
