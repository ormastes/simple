use std.nogc_sync_mut.src.collections.hashset.{hashset_with_capacity}
use std.nogc_sync_mut.src.collections.hashmap.{hashmap_with_capacity}

describe "nogc_sync_mut HashSet":
    it "preserves membership after removal from preallocated table":
        var set = hashset_with_capacity(3)
        set.insert("alpha")
        set.insert("beta")
        set.insert("gamma")

        expect(set.remove("beta")).to_equal(true)
        expect(set.contains("alpha")).to_equal(true)
        expect(set.contains("beta")).to_equal(false)
        expect(set.contains("gamma")).to_equal(true)

    it "deduplicates and probes across a resized table":
        var set = hashset_with_capacity(2)
        expect(set.insert("one")).to_equal(true)
        expect(set.insert("two")).to_equal(true)
        expect(set.insert("three")).to_equal(true)
        expect(set.insert("two")).to_equal(false)

        expect(set.len()).to_equal(3)
        expect(set.contains("one")).to_equal(true)
        expect(set.contains("two")).to_equal(true)
        expect(set.contains("three")).to_equal(true)
        expect(set.contains("missing")).to_equal(false)

    it "retains a compiler-sized module path set and resolution cache":
        var set = hashset_with_capacity(1024)
        var cache = hashmap_with_capacity(2048)
        var i = 0
        while i < 1000:
            val key = "module/{i}"
            expect(set.insert(key)).to_equal(true)
            cache.insert(key, "path/{i}")
            i = i + 1

        expect(set.len()).to_equal(1000)
        expect(set.contains("module/999")).to_equal(true)
        expect(set.contains("module/1000")).to_equal(false)
        expect(cache.get("module/999") ?? "").to_equal("path/999")
        expect(cache.get("module/1000")).to_be_nil()
