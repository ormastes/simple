use std.nogc_sync_mut.glob.{glob_match}

# Multi-byte regression coverage for src/lib/nogc_sync_mut/glob.spl (and its
# byte-identical mirror src/lib/nogc_async_mut/glob.spl). Glob-matches file
# paths, which are explicitly the "arbitrary/user data" example this file's
# HIGH-risk classification was based on
# (doc/08_tracking/bug/bracket_slice_byte_index_survey_2026-07-29.md).
#
# `?` used to advance the path cursor by exactly 1 BYTE regardless of the
# character at that position. For a multi-byte UTF-8 character this left the
# cursor mid-character (on a continuation byte), which can never compare
# equal to the next (ASCII) pattern byte -- so `?` silently failed to match
# a real single character whenever that character was multi-byte. A negated
# character class (`[!...]`) had the mirror-image bug: it correctly decided
# a multi-byte character satisfied "not in this class", but then also only
# consumed 1 byte, corrupting every subsequent match step for that path.

describe "glob_match multi-byte paths":
    it "'?' matches one café-style accented character (2-byte UTF-8), not one byte":
        expect(glob_match("café.txt", "caf?.txt")).to_be(true)
        # Old behavior: false (cursor landed on é's continuation byte after
        # consuming only its lead byte, then never matched '.').

    it "'?' matches one CJK character (3-byte UTF-8)":
        expect(glob_match("日report.txt", "?report.txt")).to_be(true)

    it "'?' matches one em-dash character (3-byte UTF-8) between ASCII characters":
        expect(glob_match("a—b", "a?b")).to_be(true)

    it "'?' still correctly rejects a genuinely-wrong-length multi-byte path":
        # caf???txt is 9 positions vs café.txt's 8 characters — a real
        # length mismatch. The previous example here, caf??txt, is 8
        # positions and actually MATCHES (?? legitimately covers "é." —
        # `?` matches `.` in glob; Python fnmatch agrees, and so does this
        # repo's default engine). Its `false` expectation only held while
        # the test-lane interpreter char-indexed bracket slices and
        # wrongly failed every multi-byte match
        # (doc/08_tracking/bug/test_harness_execution_divergence_2026-07-29.md).
        expect(glob_match("café.txt", "caf???txt")).to_be(false)
        expect(glob_match("café.txt", "caf?txt")).to_be(false)

    it "'?' matches '.' like standard glob (was masked by the interpreter bug)":
        expect(glob_match("café.txt", "caf??txt")).to_be(true)

    it "'*' still matches across a multi-byte character (regression guard, not a bug fix -- byte-stepping already found the same answer here, just wastefully)":
        expect(glob_match("café_report.txt", "caf*.txt")).to_be(true)
        expect(glob_match("日本語.log", "*.log")).to_be(true)

    it "negated character class '[!...]' correctly matches (and fully consumes) a multi-byte character":
        # '!' + '/' means "anything except a path separator" -- a common
        # single-path-segment glob idiom. A CJK filename segment must match.
        expect(glob_match("日", "[!/]")).to_be(true)
        expect(glob_match("é/x", "[!/]/x")).to_be(true)
        # Old behavior: [!/] matched (correctly decided é/日 aren't '/'), but
        # then only consumed 1 of é's/日's 2-3 bytes, leaving a stray
        # continuation byte that could never match the literal '/' that
        # follows -- both examples above returned false before the fix.

    it "positive ASCII character class still correctly rejects a multi-byte character":
        expect(glob_match("é", "[a-z]")).to_be(false)

    it "literal multi-byte character match still works (regression guard, was already correct)":
        expect(glob_match("café.txt", "café.txt")).to_be(true)
        expect(glob_match("café.txt", "cafe.txt")).to_be(false)

    it "pure ASCII patterns are unaffected (regression guard)":
        expect(glob_match("hello.txt", "*.txt")).to_be(true)
        expect(glob_match("hello.txt", "h?llo.txt")).to_be(true)
        expect(glob_match("hello.txt", "[hj]ello.txt")).to_be(true)
        expect(glob_match("world.txt", "[hj]ello.txt")).to_be(false)
