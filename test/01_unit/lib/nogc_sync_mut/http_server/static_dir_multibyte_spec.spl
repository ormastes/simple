# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# Regression: static_dir_response sliced the request path with prefix.len() and
# path.len() (code points) against byte-offset substring(), truncating a
# multibyte prefix or file name. Bounds use byte_len().

use std.spec.{describe, it, expect}
use std.io_runtime.{file_write}
use std.nogc_sync_mut.http_server.types.{HttpRequest, HttpMethod}
use std.nogc_sync_mut.http_server.router.{static_dir_response}

describe "static_dir_response with multibyte paths":
    it "serves a file under an ASCII prefix":
        file_write("build/tmp/static_dir_mb/a.txt", "ascii")
        val res = static_dir_response("/s", "build/tmp/static_dir_mb", HttpRequest.new(HttpMethod.Get, "/s/a.txt"))
        expect(res.body).to_equal("ascii")

    it "serves a multibyte file name under a multibyte prefix":
        file_write("build/tmp/static_dir_mb/é.txt", "utf8")
        val res = static_dir_response("/é", "build/tmp/static_dir_mb", HttpRequest.new(HttpMethod.Get, "/é/é.txt"))
        expect(res.body).to_equal("utf8")
