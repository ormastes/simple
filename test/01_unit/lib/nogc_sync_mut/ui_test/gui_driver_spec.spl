# @cover src/lib/nogc_sync_mut/ui_test/gui_driver.spl 70%
# GUI driver v1: strict resolution + center-point pointer clicks, with a
# recorded semantic-invoke fallback for no-geometry nodes.
use std.spec.{describe, it, expect, assert_true, assert_false}
use std.ui_test.gui_driver.{SgttiGuiDriver}
use common.ui.access_types.{UiAccessProp, UiAccessSurface}
use common.ui.win_text_access.{
    WinTextSnapshot,
    win_text_make_node,
    win_text_snapshot_from_parts,
    win_text_source
}

fn _fixture() -> WinTextSnapshot:
    val surface = UiAccessSurface(
        surface_id: "surface:main",
        title: "Main",
        active: true,
        window_id: "main",
        app_id: "gui_driver_test",
        root_canonical_id: "surface:main#root"
    )
    val save_btn = win_text_make_node(
        surface_id: "surface:main",
        widget_id: "btn_save",
        kind: "button",
        text_value: "Save",
        action_names: ["click"],
        props: [
            UiAccessProp(key: "x", value: "50"),
            UiAccessProp(key: "y", value: "80"),
            UiAccessProp(key: "width", value: "60"),
            UiAccessProp(key: "height", value: "20")
        ]
    )
    val semantic_btn = win_text_make_node(
        surface_id: "surface:main",
        widget_id: "btn_semantic",
        kind: "button",
        text_value: "Semantic",
        action_names: ["click"],
        props: []
    )
    val input = win_text_make_node(
        surface_id: "surface:main",
        widget_id: "formula_input",
        kind: "input",
        text_value: "",
        action_names: ["type_text"],
        props: []
    )
    val source = win_text_source(
        source_id: "gui_driver_test",
        source_kind: "in_process_semantic",
        confidence: "high",
        capabilities: ["query_text", "act_node"],
        captured_at_ms: 1000,
        max_age_ms: 5000,
        now_ms: 1000
    )
    win_text_snapshot_from_parts(
        mode: "gui_driver_test",
        active_surface: "surface:main",
        surfaces: [surface],
        nodes: [save_btn, semantic_btn, input],
        sources: [source]
    )

describe "SgttiGuiDriver":
    it "clicks at the layout center when geometry is present":
        val gui = SgttiGuiDriver.from_snapshot(_fixture())
        match gui.click("btn_save"):
            Ok(result):
                assert_true(result.ok)
                assert_true(result.used_geometry)
                expect(result.pointer_x).to_equal(80)
                expect(result.pointer_y).to_equal(90)
                expect(result.note).to_contain("pointer click")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "falls back to semantic invoke with a note on a no-geometry node":
        val gui = SgttiGuiDriver.from_snapshot(_fixture())
        match gui.click("btn_semantic"):
            Ok(result):
                assert_true(result.ok)
                assert_false(result.used_geometry)
                expect(result.note).to_contain("no geometry")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "types text via the semantic action":
        val gui = SgttiGuiDriver.from_snapshot(_fixture())
        match gui.type_text("formula_input", "=SUM(A1:A3)"):
            Ok(result):
                assert_true(result.ok)
                expect(result.target_canonical_id).to_contain("formula_input")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "rejects unknown targets with a strict unknown-id error":
        val gui = SgttiGuiDriver.from_snapshot(_fixture())
        match gui.click("btn_savee"):
            Ok(result):
                expect("unexpected match: {result.target_canonical_id}").to_equal("")
            Err(e):
                expect(e).to_contain("unknown ui id: btn_savee")

    it "exposes strict resolution and snapshot access":
        val gui = SgttiGuiDriver.from_snapshot(_fixture())
        expect(gui.snapshot().access.nodes.len()).to_equal(3)
        match gui.resolve_strict("btn_save"):
            Ok(node):
                expect(node.kind).to_equal("button")
            Err(e):
                expect("unexpected error: {e}").to_equal("")
