# @cover src/lib/nogc_sync_mut/ui_test/sgtti.spl 60%
# Strict SGTTI resolution: exactly-one-or-error (0 -> unknown-id + suggestions,
# >1 -> ambiguity listing canonical ids). Never first-match.
use std.spec.{describe, it, expect, assert_true, assert_false}
use std.ui_test.sgtti.{SgttiTestDriver, sgtti_node_geometry}
use common.ui.access_types.{UiAccessNode, UiAccessProp, UiAccessSurface}
use common.ui.win_text_access.{
    WinTextSnapshot,
    win_text_make_node,
    win_text_snapshot_from_parts,
    win_text_source
}

fn _surface(surface_id: text) -> UiAccessSurface:
    UiAccessSurface(
        surface_id: surface_id,
        title: surface_id,
        active: true,
        window_id: surface_id,
        app_id: "strict_test",
        root_canonical_id: "{surface_id}#root"
    )

fn _fixture() -> WinTextSnapshot:
    val button = win_text_make_node(
        surface_id: "surface:a",
        widget_id: "button_ok",
        kind: "button",
        text_value: "OK",
        action_names: ["click"],
        props: []
    )
    val dup_a = win_text_make_node(
        surface_id: "surface:a",
        widget_id: "dup_btn",
        kind: "button",
        text_value: "A",
        action_names: ["click"],
        props: []
    )
    val dup_b = win_text_make_node(
        surface_id: "surface:b",
        widget_id: "dup_btn",
        kind: "button",
        text_value: "B",
        action_names: ["click"],
        props: []
    )
    val boxed = win_text_make_node(
        surface_id: "surface:a",
        widget_id: "boxed_widget",
        kind: "box",
        text_value: "",
        action_names: ["click"],
        props: [
            UiAccessProp(key: "x", value: "10"),
            UiAccessProp(key: "y", value: "20"),
            UiAccessProp(key: "width", value: "100"),
            UiAccessProp(key: "height", value: "40")
        ]
    )
    val source = win_text_source(
        source_id: "strict_test",
        source_kind: "in_process_semantic",
        confidence: "high",
        capabilities: ["query_text", "act_node"],
        captured_at_ms: 1000,
        max_age_ms: 5000,
        now_ms: 1000
    )
    win_text_snapshot_from_parts(
        mode: "strict_test",
        active_surface: "surface:a",
        surfaces: [_surface("surface:a"), _surface("surface:b")],
        nodes: [button, dup_a, dup_b, boxed],
        sources: [source]
    )

describe "SGTTI resolve_strict":
    it "resolves exactly one widget-id match":
        val drv = SgttiTestDriver.new(_fixture())
        match drv.resolve_strict("button_ok"):
            Ok(node):
                expect(node.widget_id).to_equal("button_ok")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "resolves an exact canonical id even when the widget id is duplicated":
        val drv = SgttiTestDriver.new(_fixture())
        var canonical = ""
        match drv.get_elements():
            Ok(nodes):
                for n in nodes:
                    if n.widget_id == "dup_btn" and n.surface_id == "surface:b":
                        canonical = n.canonical_id
            Err(e):
                expect("unexpected error: {e}").to_equal("")
        match drv.resolve_strict(canonical):
            Ok(node):
                expect(node.text_value).to_equal("B")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "reports unknown id with suggestions":
        val drv = SgttiTestDriver.new(_fixture())
        match drv.resolve_strict("button_okk"):
            Ok(node):
                expect("unexpected match: {node.canonical_id}").to_equal("")
            Err(e):
                expect(e).to_contain("unknown ui id: button_okk")
                expect(e).to_contain("did you mean")
                expect(e).to_contain("button_ok")

    it "reports ambiguity listing canonical ids on duplicate widget ids":
        val drv = SgttiTestDriver.new(_fixture())
        match drv.resolve_strict("dup_btn"):
            Ok(node):
                expect("unexpected match: {node.canonical_id}").to_equal("")
            Err(e):
                expect(e).to_contain("ambiguous ui id: dup_btn")
                expect(e).to_contain("2 matches")
                expect(e).to_contain("surface:a")
                expect(e).to_contain("surface:b")

# Tier-collision fixture: "surface:a#collide" is the OWNER's canonical id and
# at the same time the IMPOSTOR's widget id — a collision ACROSS the two id
# tiers, not within one. Under the old tier-local resolution the canonical-tier
# match set was non-empty (the owner), so the widget-tier was never consulted
# and the collision resolved silently to the owner. The arch doc's
# exactly-one-or-error law is tier-blind, so this must be reported ambiguous.
# Nodes are built field-by-field rather than via win_text_make_node because
# that helper derives canonical_id from widget_id (and short-circuits when the
# widget id already contains "#"), which cannot express this shape.
fn _collide_node(canonical_id: text, surface_id: text, widget_id: text, text_value: text) -> UiAccessNode:
    UiAccessNode(
        canonical_id: canonical_id,
        surface_id: surface_id,
        widget_id: widget_id,
        kind: "button",
        visible: true,
        focused: false,
        enabled: true,
        selected: false,
        text_value: text_value,
        props: [],
        child_ids: [],
        action_names: ["click"]
    )

fn _collision_fixture() -> WinTextSnapshot:
    val owner = _collide_node("surface:a#collide", "surface:a", "collide", "OWNER")
    val impostor = _collide_node("surface:b#impostor", "surface:b", "surface:a#collide", "IMPOSTOR")
    val source = win_text_source(
        source_id: "strict_test",
        source_kind: "in_process_semantic",
        confidence: "high",
        capabilities: ["query_text", "act_node"],
        captured_at_ms: 1000,
        max_age_ms: 5000,
        now_ms: 1000
    )
    win_text_snapshot_from_parts(
        mode: "strict_test",
        active_surface: "surface:a",
        surfaces: [_surface("surface:a"), _surface("surface:b")],
        nodes: [owner, impostor],
        sources: [source]
    )

describe "SGTTI resolve_strict cross-tier ambiguity":
    it "reports ambiguity when a widget id collides with another node's canonical id":
        val drv = SgttiTestDriver.new(_collision_fixture())
        match drv.resolve_strict("surface:a#collide"):
            Ok(node):
                expect("unexpected match: {node.text_value}").to_equal("")
            Err(e):
                expect(e).to_contain("ambiguous ui id: surface:a#collide")
                expect(e).to_contain("2 matches")
                expect(e).to_contain("surface:a#collide")
                expect(e).to_contain("surface:b#impostor")

    it "still resolves the non-colliding widget id in that same snapshot":
        val drv = SgttiTestDriver.new(_collision_fixture())
        match drv.resolve_strict("collide"):
            Ok(node):
                expect(node.text_value).to_equal("OWNER")
            Err(e):
                expect("unexpected error: {e}").to_equal("")

describe "SGTTI geometry":
    it "returns layout rect and center anchor when props carry geometry":
        val drv = SgttiTestDriver.new(_fixture())
        match drv.geometry("boxed_widget"):
            Ok(geo):
                assert_true(geo.has_geometry)
                expect(geo.x).to_equal(10)
                expect(geo.y).to_equal(20)
                expect(geo.width).to_equal(100)
                expect(geo.height).to_equal(40)
                expect(geo.center_x).to_equal(60)
                expect(geo.center_y).to_equal(40)
            Err(e):
                expect("unexpected error: {e}").to_equal("")

    it "returns explicit no-geometry for nodes without layout props":
        val drv = SgttiTestDriver.new(_fixture())
        match drv.geometry("button_ok"):
            Ok(geo):
                assert_false(geo.has_geometry)
            Err(e):
                expect("unexpected error: {e}").to_equal("")
