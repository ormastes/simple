# Unit specs for the in-process TUI driver (wave 2, Agent F).
# Contract: doc/04_architecture/ui/testing/typed_ui_interface_arch.md §ActionPlan/drivers
use std.spec.{describe, it, expect}
use common.ui.widget.{UITree}
use common.ui.builder.{panel, button, text_field}
use nogc_sync_mut.ui_test.tui_driver.{TuiDriver}

fn small_tree() -> UITree:
    val root = panel("td_root", "App", [
        text_field("td_name", "", "your name"),
        button("td_save", "Save", "save")
    ])
    UITree.new(root)

describe "TuiDriver snapshot and strict resolve":
    it "snapshots the tree through the access lane":
        val d = TuiDriver.new(small_tree())
        val snap = d.snapshot()
        expect snap.nodes.len() to_be_greater_than 0

    it "resolves an existing id to exactly one node":
        val d = TuiDriver.new(small_tree())
        val r = d.resolve("td_save")
        expect r.found to_equal true
        expect r.node_id to_equal "td_save"

    it "reports an unknown id as an error, never first-match":
        val d = TuiDriver.new(small_tree())
        val r = d.resolve("td_nope")
        expect r.found to_equal false
        expect r.error.contains("unknown widget id") to_equal true

describe "TuiDriver input dispatch":
    it "types into a strictly-resolved text field":
        var d = TuiDriver.new(small_tree())
        val (d2, err) = d.type_text("td_name", "alice")
        expect err to_equal ""
        val r = d2.resolve("td_name")
        expect r.found to_equal true
        expect d2.steps to_be_greater_than 0

    it "refuses to type into an unknown target":
        var d = TuiDriver.new(small_tree())
        val (d2, err) = d.type_text("td_missing", "x")
        expect err.contains("unknown widget id") to_equal true
        expect d2.steps to_equal 0

    it "feeds key presses through the shared event dispatch":
        var d = TuiDriver.new(small_tree())
        d = d.press("j")
        expect d.steps to_equal 1

describe "TuiDriver render capture":
    it "interprets ANSI renderer output into the terminal frame":
        var d = TuiDriver.with_viewport(small_tree(), 20, 4)
        d = d.capture("\u{001b}[2J\u{001b}[1;1Hhello")
        expect d.frame.width to_equal 20
        expect d.frame.revision to_equal 1

    it "captures a renderer-free snapshot text projection":
        var d = TuiDriver.with_viewport(small_tree(), 40, 10)
        d = d.capture_snapshot_text()
        var joined = ""
        var row = 0
        while row < d.frame.height:
            var col = 0
            while col < d.frame.width:
                joined = joined + d.frame.cells[row * d.frame.width + col].grapheme
                col = col + 1
            row = row + 1
        expect joined to_contain "td_save"
