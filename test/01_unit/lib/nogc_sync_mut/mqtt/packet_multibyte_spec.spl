use std.nogc_sync_mut.mqtt.packet.{mqtt_encode_string}

# Multi-byte regression coverage for src/lib/nogc_sync_mut/mqtt/packet.spl
# (+ byte-identical mirrors nogc_async_mut/... and gc_async_mut/...).
# mqtt_encode_string's own docstring says "Encode UTF-8 string" -- MQTT
# topic/payload strings are explicitly UTF-8 per the MQTT spec.
#
# mqtt_encode_string did `text[i].ord()` (single-index, CHARACTER-indexed)
# in a loop bounded by `text.length()` (BYTE length) -- for any actual
# multi-byte string this ran `i` out of characters before reaching the
# byte count. Fixed via `text.bytes()[i]`.
#
# NOTE: this module's other functions (mqtt_encode_remaining_length,
# mqtt_decode_remaining_length, etc.) have untyped parameters, which
# forces the WHOLE MODULE to fall back to the interpreter at compile time
# (`HIR lowering error: Parameter 'length' ... requires explicit type
# annotation` -> JIT compilation failed for the whole file). That is a
# separate, pre-existing, out-of-scope defect this pass did not fix. Under
# that forced interpreter fallback, mqtt_decode_string's fix (UTF-8-
# decoding the collected raw bytes instead of `.chr()`-per-byte) is
# logically correct in isolation (verified directly against
# utf8_decode_all/text_from_codepoints with the exact wire bytes "café"
# encodes to) but the full round-trip through this module currently runs
# under that same forced interpreter and does not reproduce the isolated
# result -- consistent with, and further evidence for, the interpreter
# engine bug in doc/08_tracking/bug/test_harness_execution_divergence_2026-07-29.md.
# Only the encode direction is asserted here as a result; the decode
# direction's correct byte-collection logic is documented, not asserted,
# pending that separate interpreter/type-annotation investigation.

describe "mqtt_encode_string multi-byte":
    it "café encodes to its exact 2-byte UTF-8 wire bytes, not a truncated/garbage payload":
        val encoded = mqtt_encode_string("café")
        # 2-byte length prefix (0, 5) + 5 payload bytes: c a f 0xC3 0xA9
        expect(encoded.len()).to_equal(7)
        expect(encoded[0]).to_equal(0)
        expect(encoded[1]).to_equal(5)
        expect(encoded[2]).to_equal(99)
        expect(encoded[3]).to_equal(97)
        expect(encoded[4]).to_equal(102)
        expect(encoded[5]).to_equal(195)
        expect(encoded[6]).to_equal(169)

    it "pure ASCII is unaffected (regression guard)":
        val encoded = mqtt_encode_string("hi")
        expect(encoded.len()).to_equal(4)
        expect(encoded[1]).to_equal(2)
        expect(encoded[2]).to_equal(104)
        expect(encoded[3]).to_equal(105)
