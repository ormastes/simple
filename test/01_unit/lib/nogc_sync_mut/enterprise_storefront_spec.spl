"""
# Storefront Vertical — browse -> cart -> checkout -> receipt

## Overview

The customer-facing journey of the Simple Enterprise Suite, end to end against
the durable enterprise store: a customer adds and removes cart lines (an
append-only event log), then checks out to an immutable order + receipt whose
total is a pure fold over the current cart.

    cart_add / cart_remove -> checkout -> receipt_of

## Guarded sequence proven here (frozen: session -> rbac -> validation ->
## idempotency -> effects)

| Rung | Denial reason | Scenario |
|------|---------------|----------|
| session | invalid-session | inactive / cross-tenant session rejected |
| rbac | forbidden | a non-sales actor cannot shop |
| validation | invalid-record | checkout of an empty cart |
| validation | invalid-transition | checkout of an already-checked-out cart |
| idempotency | duplicate-key | replayed checkout emits no second order |

## RBAC reuse

Authorization reuses the FROZEN `sales` role via a local `storefront_role_allows`
gate (foundation.role_allows is not changed, rbac_registry.spl is not touched).
A non-sales actor therefore fails the rbac rung with `forbidden`.

**Requirements:** N/A
**Plan:** .spipe/simple_enterprise_suite/state.md (W21-B)

Lane: .spipe/simple_enterprise_suite (W21-B).
"""

use std.spec.*
use std.io_runtime.{file_exists, file_delete, dir_create_all}
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close}
use std.nogc_sync_mut.enterprise_store.records.{outbox_pending, audit_verify_chain}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext, CommandEnvelope,
    reason_allowed
}
use std.nogc_sync_mut.enterprise_storefront.storefront.{
    sf_setup, sf_cart_count, sf_cart_total, sf_order_id_of, receipt_of,
    cart_add, cart_remove, checkout
}

# Each scenario uses its own database path: the interpreter backend caches
# open databases per path in-process.
fn db_path(name: text) -> text:
    "build/test-artifacts/storefront_" + name + ".db"

fn tenant_a() -> TenantContext:
    TenantContext(tenant_id: "tenant-a", name: "Alpha Trading")

fn tenant_b() -> TenantContext:
    TenantContext(tenant_id: "tenant-b", name: "Beta Retail")

fn shopper_a() -> ActorContext:
    ActorContext(actor_id: "cust-1", role: "sales")

fn session_for(who: ActorContext, tenant: TenantContext) -> SessionContext:
    SessionContext(token: "tok-" + who.actor_id, actor_id: who.actor_id, tenant_id: tenant.tenant_id, active: true)

fn envelope(key: text, action: text) -> CommandEnvelope:
    CommandEnvelope(request_id: "req-" + key, idempotency_key: key, action: action, payload: "")

fn fresh_store(name: text):
    dir_create_all("build/test-artifacts")
    if file_exists(db_path(name)):
        file_delete(db_path(name))
    val store = store_open(db_path(name))
    sf_setup(store)
    store

# seed_cart opens a clean store and adds two lines to cart-1:
# SKU-1 x2 @ 300, SKU-2 x1 @ 500 (tenant A). Returns the store.
fn seed_cart(name: text):
    val store = fresh_store(name)
    val t = tenant_a()
    val c = shopper_a()
    val s = session_for(c, t)
    cart_add(store, s, t, c, envelope(name + "-a1", "storefront.cart.add"), "cart-1", "SKU-1", 2, 300)
    cart_add(store, s, t, c, envelope(name + "-a2", "storefront.cart.add"), "cart-1", "SKU-2", 1, 500)
    store

describe "storefront vertical — browse, cart, checkout, receipt end to end":
    it "adds lines, removes one, checks out with a folded total and chained audit":
        step("Open a clean store; customer builds a cart")
        val store = fresh_store("e2e")
        val t = tenant_a()
        val c = shopper_a()
        val s = session_for(c, t)
        val a1 = cart_add(store, s, t, c, envelope("e2e-a1", "storefront.cart.add"), "cart-1", "SKU-1", 2, 300)
        expect(a1.reason).to_equal("accepted")
        expect(reason_allowed(a1.reason)).to_be(true)
        cart_add(store, s, t, c, envelope("e2e-a2", "storefront.cart.add"), "cart-1", "SKU-2", 1, 500)
        cart_add(store, s, t, c, envelope("e2e-a3", "storefront.cart.add"), "cart-1", "SKU-3", 4, 100)
        expect(sf_cart_count(store, "tenant-a", "cart-1")).to_equal(3)
        expect(sf_cart_total(store, "tenant-a", "cart-1")).to_equal(1500)

        step("Remove SKU-3 -> total drops by 400")
        expect(cart_remove(store, s, t, c, envelope("e2e-rm", "storefront.cart.remove"), "cart-1", "SKU-3").reason).to_equal("accepted")
        expect(sf_cart_count(store, "tenant-a", "cart-1")).to_equal(2)
        expect(sf_cart_total(store, "tenant-a", "cart-1")).to_equal(1100)

        step("Checkout emits an order + receipt with the folded total")
        val co = checkout(store, s, t, c, envelope("e2e-co", "storefront.checkout"), "cart-1", "e2e-co")
        expect(co.reason).to_equal("accepted")
        expect(co.detail).to_equal("order-cart-1")
        expect(sf_order_id_of(store, "tenant-a", "cart-1")).to_equal("order-cart-1")
        expect(receipt_of(store, "tenant-a", "order-cart-1")).to_equal(1100)

        step("Audit chain recomputes end to end")
        expect(audit_verify_chain(store, "tenant-a")).to_be(true)
        store_close(store)

describe "storefront vertical — guarded denials":
    it "denies a non-sales actor at the rbac rung (reproduce first)":
        val store = fresh_store("rbac")
        val t = tenant_a()
        step("A warehouse (procurement) actor is not granted storefront actions -> forbidden")
        val ops = ActorContext(actor_id: "ops-1", role: "procurement")
        val r = cart_add(store, session_for(ops, t), t, ops, envelope("rbac-a", "storefront.cart.add"), "cart-1", "SKU-1", 1, 100)
        expect(r.ok).to_be(false)
        expect(r.reason).to_equal("forbidden")
        step("Nothing was added")
        expect(sf_cart_count(store, "tenant-a", "cart-1")).to_equal(0)
        store_close(store)

    it "denies an inactive session before any domain check":
        val store = fresh_store("session")
        val t = tenant_a()
        val c = shopper_a()
        var dead = session_for(c, t)
        dead.active = false
        val r = cart_add(store, dead, t, c, envelope("s-a", "storefront.cart.add"), "cart-1", "SKU-1", 1, 100)
        expect(r.reason).to_equal("invalid-session")
        store_close(store)

    it "denies checkout of an empty cart as invalid-record (reproduce first)":
        val store = fresh_store("empty")
        val t = tenant_a()
        val c = shopper_a()
        val r = checkout(store, session_for(c, t), t, c, envelope("empty-co", "storefront.checkout"), "cart-empty", "empty-co")
        expect(r.ok).to_be(false)
        expect(r.reason).to_equal("invalid-record")
        step("No order was emitted")
        expect(sf_order_id_of(store, "tenant-a", "cart-empty")).to_equal("")
        store_close(store)

    it "denies checkout of an already-checked-out cart as invalid-transition":
        val store = seed_cart("double")
        val t = tenant_a()
        val c = shopper_a()
        val s = session_for(c, t)
        step("First checkout succeeds")
        expect(checkout(store, s, t, c, envelope("dbl-co1", "storefront.checkout"), "cart-1", "dbl-co1").reason).to_equal("accepted")
        step("A SECOND checkout with a NEW key is an illegal transition")
        val r = checkout(store, s, t, c, envelope("dbl-co2", "storefront.checkout"), "cart-1", "dbl-co2")
        expect(r.ok).to_be(false)
        expect(r.reason).to_equal("invalid-transition")
        expect(r.detail).to_equal("cart-1:checked-out")
        store_close(store)

describe "storefront vertical — idempotent checkout produces exactly one order":
    it "replaying the same checkout key changes nothing":
        val store = seed_cart("replay")
        val t = tenant_a()
        val c = shopper_a()
        val s = session_for(c, t)
        step("Checkout once")
        expect(checkout(store, s, t, c, envelope("same-key", "storefront.checkout"), "cart-1", "same-key").reason).to_equal("accepted")
        val outbox_after = outbox_pending(store, "tenant-a").len()
        step("Replay the SAME idempotency key")
        val replay = checkout(store, s, t, c, envelope("same-key", "storefront.checkout"), "cart-1", "same-key")
        expect(replay.ok).to_be(true)
        expect(replay.reason).to_equal("duplicate-key")
        expect(replay.detail).to_equal("order-cart-1")
        step("No second order — outbox unchanged, receipt total stable")
        expect(outbox_pending(store, "tenant-a").len()).to_equal(outbox_after)
        expect(receipt_of(store, "tenant-a", "order-cart-1")).to_equal(1100)
        store_close(store)

describe "storefront vertical — tenant isolation":
    it "tenant B sees none of tenant A's cart and cannot check it out":
        val store = seed_cart("isolation")
        step("Tenant B sees an empty cart")
        expect(sf_cart_count(store, "tenant-b", "cart-1")).to_equal(0)
        expect(sf_cart_total(store, "tenant-b", "cart-1")).to_equal(0)
        step("A tenant-B shopper checking out cart-1 sees it as empty -> invalid-record")
        val tb = tenant_b()
        val cb = ActorContext(actor_id: "cust-b", role: "sales")
        val r = checkout(store, session_for(cb, tb), tb, cb, envelope("iso-co", "storefront.checkout"), "cart-1", "iso-co")
        expect(r.reason).to_equal("invalid-record")
        step("A cross-tenant session (B actor, A tenant) is rejected outright")
        val ta = tenant_a()
        expect(checkout(store, session_for(cb, tb), ta, cb, envelope("iso-co2", "storefront.checkout"), "cart-1", "iso-co2").reason).to_equal("invalid-session")
        step("Tenant A's cart is untouched")
        expect(sf_cart_total(store, "tenant-a", "cart-1")).to_equal(1100)
        expect(sf_order_id_of(store, "tenant-a", "cart-1")).to_equal("")
        store_close(store)
