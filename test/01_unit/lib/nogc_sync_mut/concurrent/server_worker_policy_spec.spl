use std.spec
use std.concurrent.server_worker_policy.{
    server_worker_plan, server_thread_handle_joinable
}

describe "server worker runtime policy":
    it "runs exactly one caller-owned worker when parallelism is unavailable":
        val plan = server_worker_plan(8, 0)
        expect(plan.worker_count).to_equal(1)
        expect(plan.spawn_count).to_equal(0)
        expect(plan.inline_count).to_equal(1)

    it "runs exactly one caller-owned worker on a one-lane SimpleOS runtime":
        val plan = server_worker_plan(8, 1)
        expect(plan.worker_count).to_equal(1)
        expect(plan.spawn_count).to_equal(0)
        expect(plan.inline_count).to_equal(1)

    it "spawns every hosted worker so start can return to its caller":
        val plan = server_worker_plan(4, 16)
        expect(plan.worker_count).to_equal(4)
        expect(plan.spawn_count).to_equal(4)
        expect(plan.inline_count).to_equal(0)

    it "never admits an invalid inline handle to join":
        expect(server_thread_handle_joinable(0)).to_equal(false)
        expect(server_thread_handle_joinable(-38)).to_equal(false)
        expect(server_thread_handle_joinable(7)).to_equal(true)
