# Regression: linux_installed_provider_inventory_v1.spl failed to parse
# (E0002 at 310/332) because two multi-line `if` expressions put `else:` on a
# continuation line. The documented expression form is single-line:
# `val r = if c: a else: b` (syntax_quick_reference.md).
use std.spec.{describe, it, expect}
use compiler.core.parser.{parse_module_silent_checked}

extern fn rt_file_read_text(path: text) -> text?

describe "linux_installed_provider_inventory_v1 parse":
    it "parses the module source without errors":
        val path = "src/lib/nogc_sync_mut/container/linux_installed_provider_inventory_v1.spl"
        val source = rt_file_read_text(path) ?? ""
        expect(source.len()).to_be_greater_than(0)
        expect(parse_module_silent_checked(source, path)).to_equal(false)

    it "accepts the single-line if-expression form used by the fix":
        val src = "fn f(n: i64) -> i64:\n    val r = if n > 0: 1 else: 2\n    r\n"
        expect(parse_module_silent_checked(src, "inline_if_expr.spl")).to_equal(false)
