# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.nogc_sync_mut.dns.wire.{

    wire_decode_name,
    wire_read_u8,
    wire_read_u16,
    wire_read_u32
}

describe "DNS wire malformed offset guards":
    # @manual scenario evidence
    it "returns default values for negative primitive read offsets":
        # @req REQ-SSPEC-LIB
        step("returns default values for negative primitive read offsets")
        val bytes: [i64] = [0x12, 0x34, 0x56, 0x78]
        expect(wire_read_u8(bytes, -1) == 0).to_equal(true)
        expect(wire_read_u16(bytes, -1) == 0).to_equal(true)
        expect(wire_read_u32(bytes, -1) == 0).to_equal(true)

    it "returns default values for truncated primitive reads":
        # @req REQ-SSPEC-LIB
        step("returns default values for truncated primitive reads")
        val bytes: [i64] = [0x12]
        expect(wire_read_u16(bytes, 0) == 0).to_equal(true)
        expect(wire_read_u32(bytes, 0) == 0).to_equal(true)

    it "stops malformed names before indexing out of bounds":
        # @req REQ-SSPEC-LIB
        step("stops malformed names before indexing out of bounds")
        val negative = wire_decode_name([0], -1)
        expect(negative.0).to_equal("")
        expect(negative.1).to_equal(0)

        val truncated_label = wire_decode_name([3, 97], 0)
        expect(truncated_label.0).to_equal("")
