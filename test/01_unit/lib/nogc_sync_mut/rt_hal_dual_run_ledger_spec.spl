"""
Dual-run soak ledger specification

## Purpose and audience
Executable specification of the soak ledger (`dual_run_ledger`), written for
the rt(hal) dual-run team and reviewers of the asm-to-Simple migration soak
gate. It pins SDN row append/parse round-trips, missing-ledger tolerance,
per-pair summary accounting, and the stability bar the soak report is judged
against.

## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/nogc_sync_mut/rt_hal_dual_run_ledger_spec.spl` from the
repository root; every scenario writes its ledger under
`build/dual_run/spec_tmp/` and never touches the default ledger.

## Compatibility and limitations
The soak summary counts clean comparisons per pair against the plan's
stability bar (>= 1000 cases, >= 30 independent runs, >= 2 binary identities,
0 mismatches). Rows here are SYNTHESISED to exercise the accounting — the
real ledger accumulates over future runs and is reported, not fabricated.

## Verification guidance and troubleshooting
A stability-bar failure means `dual_ledger_soak` changed its thresholds; a
round-trip failure means the SDN row schema drifted. Inspect the appended
`build/dual_run/spec_tmp/*.sdn` rows before changing the ledger format, and
re-run this file after any `dual_run_ledger.spl` edit.
"""
# Lifecycle: doc/01_research/domain/mcdc_rt_hal_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_rt_hal_hardening.md ;
# doc/04_architecture/mcdc_rt_hal_hardening.md ;
# doc/05_design/os/hal/asm_embedded_hal_and_dual_run.md
# @manual_section: dual run soak ledger
# @req REQ-SSPEC-LIB

use std.spec
use std.spec.step
use std.io_runtime.{mkdir_p, read_file, remove_file_if_exists}
use std.nogc_sync_mut.rt_hal.dual_run_ledger.*

val TMP_DIR = "build/dual_run/spec_tmp"

fn tmp_ledger(name: text) -> text:
    mkdir_p(TMP_DIR)
    val p = "{TMP_DIR}/{name}.sdn"
    remove_file_if_exists(p)
    p

fn row(pair: text, run_id: text, cases: i64, mismatches: i64, ident: text) -> LedgerRow:
    LedgerRow(pair: pair, mode: "value", run_id: run_id, cases: cases, mismatches: mismatches,
              first_mismatch_repr: if mismatches > 0: "ref=1 cand=2" else: "", binary_identity: ident)

describe "dual-run (6) soak ledger":
    it "appends SDN rows and parses them back losslessly":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): appended row count and reloaded field values for both rows
        step("Append two ledger rows, reload the file, and compare every field")
        val path = tmp_ledger("ledger_roundtrip")
        expect(dual_ledger_append(path, row("p1", "r1", 12, 0, "seed-a"))).to_equal(true)
        expect(dual_ledger_append(path, row("p2", "r1", 3, 1, "seed-a"))).to_equal(true)
        val body = read_file(path)
        expect(body).to_contain("dual_run_ledger:")
        expect(body).to_contain("- pair: p1")
        expect(body).to_contain("first_mismatch_repr: \"ref=1 cand=2\"")
        val rows = dual_ledger_load(path)
        expect(rows.len()).to_equal(2)  # oracle: two appends against a fresh ledger must reload as exactly two rows
        expect(rows[1].pair).to_equal("p2")
        expect(rows[1].mismatches).to_equal(1)  # oracle: the second row was appended with one deliberate mismatch, and the count must survive the round-trip
        expect(rows[1].first_mismatch_repr).to_equal("ref=1 cand=2")
        expect(rows[0].binary_identity).to_equal("seed-a")

    it "a missing ledger loads as zero rows, never an error":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): row count returned for a nonexistent ledger path
        step("Load a ledger path that was never written")
        expect(dual_ledger_load("build/dual_run/spec_tmp/does_not_exist.sdn").len()).to_equal(0)  # oracle: an absent ledger is the empty history, so the loader must answer zero rows

    it "soak summary aggregates cases, runs, identities and mismatches per pair":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): per-pair cases/runs/identities/mismatches totals for pairs p and q
        step("Build four synthetic rows across two pairs and read both soak summaries")
        var rows: [LedgerRow] = []
        rows.push(row("p", "r1", 500, 0, "seed"))
        rows.push(row("p", "r2", 600, 0, "self"))
        rows.push(row("p", "r2", 10, 0, "self"))
        rows.push(row("q", "r1", 5, 2, "seed"))
        val s = dual_ledger_soak(rows, "p")
        expect(s.cases).to_equal(1110)  # oracle: pair p sums 500 + 600 + 10 cases across its three rows
        expect(s.runs).to_equal(2)  # oracle: pair p saw exactly two distinct run ids, r1 and r2
        expect(s.identities.len()).to_equal(2)  # oracle: pair p recorded both binary identities, seed and self
        expect(s.mismatches).to_equal(0)  # oracle: none of pair p's rows carried a mismatch
        val q = dual_ledger_soak(rows, "q")
        expect(q.mismatches).to_equal(2)  # oracle: pair q's single row carries 2 mismatches and the summary must report them
        expect(q.stable).to_equal(false)

    it "stable only when >=1000 cases, >=30 runs, >=2 identities and 0 mismatches":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): stability verdicts at the bar, 29 runs, one identity, and one mismatch
        step("Exercise each stability threshold with boundary ledger rows")
        var rows: [LedgerRow] = []
        var i = 0
        while i < 30:
            rows.push(row("p", "run-{i}", 40, 0, if i % 2 == 0: "seed" else: "self"))
            i = i + 1
        expect(dual_ledger_soak(rows, "p").stable).to_equal(true)
        expect(dual_ledger_soak(rows, "p").cases).to_equal(1200)  # oracle: 30 runs of 40 cases each is exactly the 1000-case soak bar multiplied out
        # 29 runs -> not stable
        var fewer: [LedgerRow] = []
        i = 0
        while i < 29:
            fewer.push(row("p", "run-{i}", 40, 0, if i % 2 == 0: "seed" else: "self"))
            i = i + 1
        expect(dual_ledger_soak(fewer, "p").stable).to_equal(false)
        # one identity -> not stable
        var one_id: [LedgerRow] = []
        i = 0
        while i < 30:
            one_id.push(row("p", "run-{i}", 40, 0, "seed"))
            i = i + 1
        expect(dual_ledger_soak(one_id, "p").stable).to_equal(false)
        # a single mismatch anywhere -> not stable
        var dirty = rows
        dirty.push(row("p", "run-x", 1, 1, "self"))
        expect(dual_ledger_soak(dirty, "p").stable).to_equal(false)

    it "soak_all lists every pair once with its summary line":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): pair ordering and summary-line fields from soak_all
        step("Feed interleaved rows for pairs a and b and list all soak summaries")
        var rows: [LedgerRow] = []
        rows.push(row("b", "r1", 1, 0, "seed"))
        rows.push(row("a", "r1", 1, 0, "seed"))
        rows.push(row("b", "r2", 1, 0, "seed"))
        val all = dual_ledger_soak_all(rows)
        expect(all.len()).to_equal(2)  # oracle: two distinct pairs appear once each regardless of interleaved row order
        expect(dual_ledger_soak_line(all[0])).to_contain("pair=")
        expect(dual_ledger_soak_line(all[0])).to_contain("stable=")

    it "binary identity and run id come from the environment with honest defaults":
        # @req REQ-SSPEC-LIB
        # @capture(statistics): resolved identity and run-id lengths under the current environment
        step("Resolve the ambient binary identity and run id and check they are non-empty")
        expect(dual_run_binary_identity().len() > 0).to_equal(true)  # oracle: the resolver must never answer an empty identity; the default fallback is a non-empty digest
        expect(dual_run_run_id().len() > 0).to_equal(true)  # oracle: the run id likewise always resolves to at least one character so rows stay attributable
