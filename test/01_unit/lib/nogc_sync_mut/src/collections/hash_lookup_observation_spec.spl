# @tag:in-development
# Tracks: doc/08_tracking/bug/pr1870_pr1830_unreviewed_merge_fallout_2026-09-28.md
use std.spec.*
use std.nogc_sync_mut.src.collections.hashset.HashSet
use std.nogc_sync_mut.src.collections.hashmap.HashMap

describe "hash lookup observations":
    it "counts each inspected set slot without changing membership":
        var set = HashSet.with_capacity(1)
        expect(set.insert("a")).to_be(true)
        val hit = set.contains_observed("a")
        expect(hit.found).to_be(true)
        expect(hit.probes).to_equal(1)
        expect(hit.collisions).to_equal(0)
        val miss = set.contains_observed("b")
        expect(miss.found).to_be(false)
        expect(miss.probes).to_equal(1)
        expect(miss.collisions).to_equal(1)
        expect(set.contains("b")).to_be(false)
        expect(set.remove("b")).to_be(false)
        expect(set.len()).to_equal(1)

    it "counts chained map entries and the empty miss probe":
        var map = HashMap.with_capacity(1)
        map.insert("a", "value")
        val hit = map.get_observed("a")
        expect(hit.value ?? "").to_equal("value")
        expect(hit.probes).to_equal(1)
        expect(hit.collisions).to_equal(0)
        val miss = map.get_observed("b")
        expect(miss.value).to_be_nil()
        expect(miss.probes).to_equal(2)
        expect(miss.collisions).to_equal(1)
        expect(map.get("b")).to_be_nil()
