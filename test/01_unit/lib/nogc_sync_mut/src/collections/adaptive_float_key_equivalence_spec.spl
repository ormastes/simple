use std.spec.*
use std.hash.Hash
use std.common.math.ieee754_bits.{
    f32_from_bits, f64_from_bits, f64_to_bits
}
use std.nogc_sync_mut.src.collections.adaptive_map.AdaptiveMap
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveSetAttribute}

describe "adaptive float keys preserve equality and replacement semantics":
    it "hashes equal positive and negative zeros identically":
        val positive_f32 = f32_from_bits(0u32)
        val negative_f32 = f32_from_bits(0x80000000u32)
        val positive_f64 = f64_from_bits(0u64)
        val negative_f64 = f64_from_bits(0x8000000000000000u64)
        expect(positive_f32 == negative_f32).to_be(true)
        expect(positive_f64 == negative_f64).to_be(true)
        expect(positive_f32.hash()).to_equal(negative_f32.hash())
        expect(positive_f64.hash()).to_equal(negative_f64.hash())

    it "replaces an equal key consistently in linear, hash, and ordered maps":
        val negative_zero = f64_from_bits(0x8000000000000000u64)
        val positive_zero = f64_from_bits(0u64)
        var map: AdaptiveMap<f64, text> = AdaptiveMap.new()
        for algorithm in [AdaptiveSetAttribute.Linear, AdaptiveSetAttribute.Hash, AdaptiveSetAttribute.Ordered]:
            map.clear()
            map.set_attribute(algorithm)
            expect(map.put(negative_zero, "negative")).to_be(true)
            expect(map.put(positive_zero, "positive")).to_be(false)
            expect(map.len()).to_equal(1)
            expect(map.get(negative_zero) ?? "").to_equal("positive")
            val entries = map.entries()
            expect(entries.len()).to_equal(1)
            expect(f64_to_bits(entries[0].key)).to_equal(0u64)
