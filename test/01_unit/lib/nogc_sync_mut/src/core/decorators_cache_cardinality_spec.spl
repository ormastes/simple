use std.spec
use std.nogc_sync_mut.src.core.decorators.{CachedFunction}

describe "cached function cardinality":
    it "reports live entries across insertion replacement and clear":
        val cached_fn = CachedFunction(wrapped_fn: nil, cache: {}, hits: 3, misses: 2)
        expect(cached_fn.cache_info()["size"]).to_equal(0)

        cached_fn.cache["a"] = 10
        cached_fn.cache["b"] = 20
        expect(cached_fn.cache_info()["size"]).to_equal(2)

        cached_fn.cache["a"] = 30
        expect(cached_fn.cache_info()["size"]).to_equal(2)
        expect(cached_fn.cache_info()["hits"]).to_equal(3)
        expect(cached_fn.cache_info()["misses"]).to_equal(2)

        cached_fn.clear_cache()
        expect(cached_fn.cache_info()["size"]).to_equal(0)
        expect(cached_fn.cache_info()["hits"]).to_equal(0)
        expect(cached_fn.cache_info()["misses"]).to_equal(0)
