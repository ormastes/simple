use std.spec
use std.nogc_sync_mut.web_ui.input.{web_ui_primary_button}

describe "nogc_sync_mut web_ui input":

    it "recognizes the normalized SDL2 left button":
        expect(web_ui_primary_button(0)).to_equal(true)
        expect(web_ui_primary_button(1)).to_equal(false)
        expect(web_ui_primary_button(2)).to_equal(false)
