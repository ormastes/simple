# std.cache TTL unit bug — ttl_seconds treated as milliseconds
#
# cache_ttl_new(capacity, ttl_seconds) documents its second parameter as a
# seconds count ("Time to live in seconds"), but cache_ttl_put() computes the
# expiry as `now + ttl` where `now` comes from _get_timestamp(), which returns
# MILLISECONDS (rt_time_now_unix_micros() / 1000). Adding a seconds-count TTL
# directly onto a millisecond timestamp makes every entry expire ~1000x sooner
# than documented/requested — an entry created with ttl_seconds=60 (intended
# to live 60 seconds) actually expires after only 60 milliseconds.

use std.cache.{cache_ttl_new, cache_ttl_put, cache_ttl_get}
use std.time.{sleep_ms}

describe "std.cache TTL unit handling":
    it "keeps an entry alive for the requested number of seconds, not milliseconds":
        val cache = cache_ttl_new(10, 60)
        cache_ttl_put(cache, "k", "v")

        # Sleep ~150ms of wall time — far less than the requested 60s TTL,
        # but far more than the buggy 60ms effective TTL.
        sleep_ms(150)

        val got = cache_ttl_get(cache, "k")
        expect(got).to_equal("v")
