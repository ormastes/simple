"""Byte-exact positioned-read parity for DBFS and both NVFS frontends."""

use std.spec.*
use std.db.dbfs_driver.{DbFsDriver}
use std.fs_driver.nvfs_driver.{NvfsDriver}
use std.fs_driver.nvfs_posix_driver.{NvfsPosixDriver}
use std.fs_driver.error.{FsError}
use std.fs_driver.types.{FileHandle, OpenFlags, Path}

fn _seed_dbfs(driver: DbFsDriver, path: text) -> FileHandle:
    val handle = driver.open_path(Path(raw: path), OpenFlags.create_write()).unwrap()
    driver.write_bytes_handle(handle, [0u8, 255u8, 17u8, 0u8, 128u8]).unwrap()
    handle

fn _bounded_fixture_bytes() -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < 65536:
        out.push((i % 251) as u8)
        i = i + 1
    out

describe "positioned binary backend parity":
    it "DBFS preserves binary bytes and clips reads at EOF":
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs.bin")
        expect(driver.pread_bytes_handle(handle, 1, 3).unwrap()).to_equal(
            [255u8, 17u8, 0u8])
        expect(driver.pread_bytes_handle(handle, 4, 8).unwrap()).to_equal([128u8])
        expect(driver.pread_bytes_handle(handle, 5, 8).unwrap()).to_equal([])
        expect(driver.pread_bytes_handle(handle, -1, 1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(handle, 0, -1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 0).unwrap()).to_equal([])
        expect(driver.pread_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)

    it "DBFS positioned reads retain instance and inode identity with other live descriptors":
        val other = DbFsDriver.new_hosted()
        val other_handle = _seed_dbfs(other, "/other.bin")
        val driver = DbFsDriver.new_hosted()
        val decoy_handle = _seed_dbfs(driver, "/decoy.bin")
        val target_handle = driver.open_path(
            Path(raw: "/target.bin"), OpenFlags.create_write()).unwrap()
        driver.write_bytes_handle(
            target_handle, [9u8, 8u8, 7u8, 6u8, 5u8]).unwrap()
        expect(driver.pread_bytes_handle(target_handle, 1, 3).unwrap()).to_equal(
            [8u8, 7u8, 6u8])
        expect(other.pread_bytes_handle(other_handle, 0, 1).unwrap()).to_equal([0u8])
        expect(driver.pread_bytes_handle(decoy_handle, 4, 1).unwrap()).to_equal([128u8])

    it "DBFS bounded chunks accept 64 KiB and reject larger requests":
        val driver = DbFsDriver.new_hosted()
        val handle = driver.open_path(
            Path(raw: "/dbfs-bounded.bin"), OpenFlags.create_write()).unwrap()
        val seed = _bounded_fixture_bytes()
        driver.write_bytes_handle(handle, seed).unwrap()
        val got = driver.pread_bounded_bytes_handle(handle, 0, 65536).unwrap()
        expect(got.len()).to_equal(65536)
        expect(got[0]).to_equal(0u8)
        expect(got[65535]).to_equal((65535 % 251) as u8)
        got[0] = 99u8
        expect(driver.pread_bounded_bytes_handle(handle, 0, 1).unwrap()).to_equal([0u8])
        expect(driver.pread_bounded_bytes_handle(handle, 65536, 1).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(handle, 0, 0).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(
            handle, -1, 1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, -1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, 65537).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)

    it "native NVFS exposes the same binary and EOF contract":
        val driver = NvfsDriver.new("binary-native")
        val handle = driver.open(Path(raw: "/native.bin"), OpenFlags.create_write()).unwrap()
        driver.pwrite(handle, 0, [0u8, 255u8, 17u8, 0u8, 128u8]).unwrap()
        expect(driver.pread_bytes_handle(handle, 1, 3).unwrap()).to_equal(
            [255u8, 17u8, 0u8])
        expect(driver.pread_bytes_handle(handle, 4, 8).unwrap()).to_equal([128u8])
        expect(driver.pread_bytes_handle(handle, 5, 1).unwrap()).to_equal([])
        expect(driver.pread_bytes_handle(handle, -1, 1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(handle, 0, -1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)
        val native_owned = driver.pread_bounded_bytes_handle(handle, 1, 3).unwrap()
        expect(native_owned).to_equal([255u8, 17u8, 0u8])
        native_owned[0] = 1u8
        expect(driver.pread_bounded_bytes_handle(handle, 1, 1).unwrap()).to_equal([255u8])
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, 65537).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(handle, 5, 1).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(handle, 0, 0).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(
            handle, -1, 1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, -1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)
        val native_max = _bounded_fixture_bytes()
        driver.pwrite(handle, 0, native_max).unwrap()
        expect(driver.pread_bounded_bytes_handle(handle, 0, 65536).unwrap().len()).to_equal(65536)

    it "POSIX NVFS exposes the same binary and EOF contract":
        val driver = NvfsPosixDriver.new("binary-posix")
        val handle = driver.open(Path(raw: "/posix.bin"), OpenFlags.create_write()).unwrap()
        driver.pwrite(handle, 0, [0u8, 255u8, 17u8, 0u8, 128u8]).unwrap()
        expect(driver.pread_bytes_handle(handle, 1, 3).unwrap()).to_equal(
            [255u8, 17u8, 0u8])
        expect(driver.pread_bytes_handle(handle, 4, 8).unwrap()).to_equal([128u8])
        expect(driver.pread_bytes_handle(handle, 5, 1).unwrap()).to_equal([])
        expect(driver.pread_bytes_handle(handle, -1, 1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(handle, 0, -1).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pread_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)
        val posix_owned = driver.pread_bounded_bytes_handle(handle, 1, 3).unwrap()
        expect(posix_owned).to_equal([255u8, 17u8, 0u8])
        posix_owned[0] = 1u8
        expect(driver.pread_bounded_bytes_handle(handle, 1, 1).unwrap()).to_equal([255u8])
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, 65537).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(handle, 5, 1).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(handle, 0, 0).unwrap()).to_equal([])
        expect(driver.pread_bounded_bytes_handle(
            handle, -1, 1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0, -1).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(driver.pread_bounded_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, 1).unwrap_err()).to_equal(
                FsError.InvalidArg)
        val posix_max = _bounded_fixture_bytes()
        driver.pwrite(handle, 0, posix_max).unwrap()
        expect(driver.pread_bounded_bytes_handle(handle, 0, 65536).unwrap().len()).to_equal(65536)

    it "native and POSIX NVFS retain one exact executable observation":
        val native = NvfsDriver.new("execute-native")
        val native_handle = native.open(
            Path(raw: "/native-execute.bin"), OpenFlags.create_write()).unwrap()
        native.pwrite(native_handle, 0, [1u8, 2u8, 3u8]).unwrap()
        val native_observed = native.execute_observation_v1(native_handle).unwrap()
        expect(native_observed.size).to_equal(3u64)
        expect(native_observed.object_identity > 0u64).to_equal(true)
        expect(native_observed.content_generation > 0u64).to_equal(true)
        expect(native.execute_observation_current_v1(
            native_handle, native_observed)).to_equal(true)
        native.pwrite(native_handle, 1, [9u8]).unwrap()
        expect(native.execute_observation_current_v1(
            native_handle, native_observed)).to_equal(false)

        val posix = NvfsPosixDriver.new("execute-posix")
        val posix_handle = posix.open(
            Path(raw: "/posix-execute.bin"), OpenFlags.create_write()).unwrap()
        posix.pwrite(posix_handle, 0, [4u8, 5u8, 6u8]).unwrap()
        val posix_observed = posix.execute_observation_v1(posix_handle).unwrap()
        expect(posix_observed.size).to_equal(3u64)
        expect(posix_observed.object_identity > 0u64).to_equal(true)
        expect(posix_observed.content_generation > 0u64).to_equal(true)
        expect(posix.execute_observation_current_v1(
            posix_handle, posix_observed)).to_equal(true)
        posix.pwrite(posix_handle, 1, [8u8]).unwrap()
        expect(posix.execute_observation_current_v1(
            posix_handle, posix_observed)).to_equal(false)

describe "DBFS positioned binary write":
    # Reproduces the gap fixed on 2026-08-24: `pwrite_bytes_handle` had call
    # sites in nvfs_driver.spl but no definition anywhere, so building an NVFS
    # image failed with `method 'pwrite_bytes_handle' not found on type
    # 'DbFsDriver'`.  The text twin `pwrite_handle` existed; only the byte-exact
    # form was missing, which is precisely the one NVFS needs.

    it "overwrites in place and returns the byte count":
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs-pwrite.bin")
        expect(driver.pwrite_bytes_handle(handle, 1, [1u8, 2u8]).unwrap()).to_equal(2)
        expect(driver.pread_bytes_handle(handle, 0, 5).unwrap()).to_equal(
            [0u8, 1u8, 2u8, 0u8, 128u8])

    it "preserves bytes that no text round-trip could carry":
        # 0x00 and 0xFF are exactly what the text-based pwrite_handle loses.
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs-pwrite-binary.bin")
        driver.pwrite_bytes_handle(handle, 0, [0u8, 255u8, 0u8, 255u8, 0u8]).unwrap()
        expect(driver.pread_bytes_handle(handle, 0, 5).unwrap()).to_equal(
            [0u8, 255u8, 0u8, 255u8, 0u8])

    it "extends past EOF and zero-fills the hole":
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs-pwrite-hole.bin")
        expect(driver.pwrite_bytes_handle(handle, 7, [9u8]).unwrap()).to_equal(1)
        expect(driver.pread_bytes_handle(handle, 0, 8).unwrap()).to_equal(
            [0u8, 255u8, 17u8, 0u8, 128u8, 0u8, 0u8, 9u8])

    it "rejects a negative offset and an overflowing range":
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs-pwrite-invalid.bin")
        expect(driver.pwrite_bytes_handle(handle, -1, [1u8]).unwrap_err()).to_equal(
            FsError.InvalidArg)
        expect(driver.pwrite_bytes_handle(
            handle, 0x7FFFFFFFFFFFFFFF, [1u8]).unwrap_err()).to_equal(
                FsError.InvalidArg)

    it "accepts an empty patch as a no-op":
        val driver = DbFsDriver.new_hosted()
        val handle = _seed_dbfs(driver, "/dbfs-pwrite-empty.bin")
        expect(driver.pwrite_bytes_handle(handle, 2, []).unwrap()).to_equal(0)
        expect(driver.pread_bytes_handle(handle, 0, 5).unwrap()).to_equal(
            [0u8, 255u8, 17u8, 0u8, 128u8])
