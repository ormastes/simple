use std.spec
use std.nogc_sync_mut.channel.bounded_channel.{bounded_channel_new}

describe "BoundedChannel cursor-backed FIFO":
    it "reuses bounded storage after receives without changing FIFO order":
        val channel = bounded_channel_new(2)
        assert_true(channel.send(10))
        assert_true(channel.send(20))
        assert_equal(channel.recv(), 10)
        assert_true(channel.send(30))
        assert_equal(channel.len(), 2)
        assert_equal(channel.recv(), 20)
        assert_equal(channel.recv(), 30)
        assert_equal(channel.len(), 0)

    it "drains accepted values after close and then reports closed empty":
        val channel = bounded_channel_new(1)
        assert_true(channel.send(0))
        channel.close()
        assert_false(channel.send(1))
        assert_equal(channel.recv(), 0)
        assert_equal(channel.recv(), -2)
