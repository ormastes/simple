# Purpose and audience: executable specification evidence for TUI widget maintainers.
# @req REQ-SSPEC-APP

"""
## Purpose and audience
Purpose: a box content row is always exactly the box width, so its right border
lands on one column and overwrites stale cells (llm_caret chat transcript showed
old text past a short line's border).
Audience: TUI rendering engineers who maintain the box widget.
"""

use std.spec.step
use std.spec.{describe, it, expect}
use std.tui.widgets.box_widget.{make_content_row}
use std.tui.style.{make_plain_line, tui_default_style}

fn _row_text(inner: text, width: i64) -> text:
    val row = make_content_row(make_plain_line(inner), width, tui_default_style())
    var out = ""
    for seg in row.segments:
        out = out + seg.content
    out

describe "box widget content row":
    it "pads short content and truncates long content to the inner width":
        step("A short line is padded so the right border sits at the box edge")
        expect(_row_text("Bees.", 10)).to_equal("│Bees.     │")
        step("A long line is cut at the inner width, never spilling past the border")
        expect(_row_text("beet beet beet", 6)).to_equal("│beet b│")
