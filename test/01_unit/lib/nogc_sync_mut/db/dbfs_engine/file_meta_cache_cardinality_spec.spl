use std.spec
use std.db.dbfs_engine.file_meta.{InodeHintsCache}

describe "DBFS inode-hint cache admission cardinality":
    it "evicts only for new entries at capacity and preserves the hottest row":
        var cache = InodeHintsCache.new(2)
        cache.put("/a", 1, 1)
        cache.put("/b", 2, 1)
        expect(cache.entries.len()).to_equal(2)
        expect(cache.get("/a").?).to_equal(true)
        cache.put("/a", 1, 2)
        expect(cache.entries.len()).to_equal(2)
        cache.put("/c", 3, 1)
        expect(cache.entries.len()).to_equal(2)
        expect(cache.entries.contains_key("/a")).to_equal(true)
        expect(cache.entries.contains_key("/b")).to_equal(false)
        expect(cache.entries.contains_key("/c")).to_equal(true)

    it "clear releases every retained hint":
        var cache = InodeHintsCache.new(2)
        cache.put("/a", 1, 1)
        cache.put("/b", 2, 1)
        cache.clear()
        expect(cache.entries.len()).to_equal(0)
