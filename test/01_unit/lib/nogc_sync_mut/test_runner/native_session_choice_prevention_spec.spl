use std.spec
use std.test_runner.test_runner_args.{parse_test_args}

describe "native selection preserves the caller session choice":
    it "keeps defaults and honors --no-session-daemon for every native selector":
        for sel in ["--native-backend=llvm", "--native-backend=cranelift", "--native-source=src/lib"]:
            val kept = parse_test_args([sel, "fixture.spl"])
            expect(kept.no_cache).to_equal(true)
            expect(kept.session_daemon).to_equal(true)
            val off = parse_test_args([sel, "--no-session-daemon", "fixture.spl"])
            expect(off.session_daemon).to_equal(false)
            expect(off.session_share).to_equal(false)
