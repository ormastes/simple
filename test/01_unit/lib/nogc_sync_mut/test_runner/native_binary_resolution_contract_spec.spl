use std.spec
use std.io_runtime.{file_read}

describe "native test compiler resolution":
    it "honors SIMPLE_BINARY before argv and deployed fallbacks":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl")
        val env_helper = source.find("fn explicit_simple_binary_from_env()")
        val finder = source.find("fn find_simple_binary()")
        val explicit_now = source.find("val explicit_now = explicit_simple_binary_from_env()")
        val argv = source.find("val args = cli_get_args()")
        val named = source.find("explicit_binary_before_argv0(explicit_simple_binary_from_env()")
        val deployed = source.find("val candidates = [")

        expect(env_helper).to_be_greater_than(0)
        expect(finder).to_be_greater_than(env_helper)
        expect(explicit_now).to_be_greater_than(finder)
        expect(argv).to_be_greater_than(explicit_now)
        expect(named).to_be_greater_than(argv)
        expect(deployed).to_be_greater_than(named)
        expect(source).to_contain("for key in [\"SIMPLE_BINARY\", \"SIMPLE_RUNTIME\"]")
        expect(source).to_contain("_cached_binary_path = explicit_now")
        expect(source).to_contain("return explicit_now")

    it "lists Windows deployed-binary fallbacks":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl")
        expect(source).to_contain("\"bin/simple.exe\",")
        expect(source).to_contain("\"bin/release/x86_64-pc-windows-msvc/simple.exe\",")
