use std.spec
use std.io_runtime.{file_read}

describe "native test compiler resolution":
    it "honors SIMPLE_BINARY before argv and deployed fallbacks":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl")
        val configured = source.find(
            "val configured = env_get(\"SIMPLE_BINARY\")")
        val argv = source.find("val args = cli_get_args()")
        val legacy = source.find("val env_path = env_get(\"SIMPLE_RUNTIME\")")
        val deployed = source.find("\"bin/simple\",")

        expect(configured).to_be_greater_than(0)
        expect(argv).to_be_greater_than(configured)
        expect(legacy).to_be_greater_than(argv)
        expect(deployed).to_be_greater_than(legacy)
        expect(source).to_contain("_cached_binary_path = configured")
        expect(source).to_contain("return configured")
