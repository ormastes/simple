"""Real temporary compile-artifact naming contract; execution NOT RUN."""
use std.spec.{describe, it, expect}
use std.test_runner.native_compile_contract.{native_test_temporary_artifact_path}
use std.common.test_runner.wrapper_filename.{spipe_wrapper_filename}

fn temporary_artifact_basename(path: text) -> text:
    val slash = path.last_index_of("/")
    if slash < 0: path else: path[slash + 1:]

describe "bounded non-AOT test compile artifacts":
    it "bounds a long authored path with maximal host identity fields":
        var spec = "src/"
        for index in 0..80:
            spec = spec + "nested-long-authored-path/"
        spec = spec + "positive_spec.spl"
        val artifact = native_test_temporary_artifact_path("/tmp", spec, 9223372036854775807, 9223372036854775807, true, true, "/test/native-generated-private/entry.spl")
        val filename = temporary_artifact_basename(artifact)
        expect(filename).to_start_with("test-")
        expect(filename).to_end_with(".coverage-native")
        expect(filename.len()).to_be_less_than(128)
        expect((filename + ".cache").len()).to_be_less_than(255)

    it "retains coverage MC/DC and plain SMF suffix selection":
        expect(native_test_temporary_artifact_path("/tmp", "a.spl", 17, 23, true, false, "owned-source")).to_end_with(".coverage-native")
        expect(native_test_temporary_artifact_path("/tmp", "a.spl", 17, 23, false, true, "owned-source")).to_end_with(".mcdc-native")
        expect(native_test_temporary_artifact_path("/tmp", "a.spl", 17, 23, false, false, "owned-source")).to_end_with(".smf")

    it "separates flattened path aliases and process or invocation identities":
        val first_source = "/tmp/" + spipe_wrapper_filename(17, "0123456789abcdef0123456789abcdef").unwrap()
        val second_source = "/tmp/" + spipe_wrapper_filename(17, "fedcba9876543210fedcba9876543210").unwrap()
        val first = native_test_temporary_artifact_path("/tmp", "a/b_spec.spl", 17, 23, false, false, first_source)
        val alias_artifact = native_test_temporary_artifact_path("/tmp", "a_b_spec.spl", 17, 23, false, false, first_source)
        val other_process = native_test_temporary_artifact_path("/tmp", "a/b_spec.spl", 18, 23, false, false, first_source)
        val invocation = native_test_temporary_artifact_path("/tmp", "a/b_spec.spl", 17, 24, false, false, first_source)
        val same_clock_invocation = native_test_temporary_artifact_path("/tmp", "a/b_spec.spl", 17, 23, false, false, second_source)
        expect(first == alias_artifact).to_equal(false)
        expect(first == other_process).to_equal(false)
        expect(first == invocation).to_equal(false)
        expect(first == same_clock_invocation).to_equal(false)
