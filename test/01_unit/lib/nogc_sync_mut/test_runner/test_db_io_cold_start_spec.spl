# Cold-start regression: write_db_file_locked must create a missing parent
# directory instead of failing the lock (file_lock cannot create the lock file
# in a missing directory, so the first run in a fresh checkout lost its DB).

use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.nogc_sync_mut.test_runner.test_db_io.{write_db_file_locked}

describe "write_db_file_locked cold start":
    it "creates a missing parent directory and writes the file":
        val dir = "build/test_db_io_cold_start_probe"
        val path = "{dir}/nested/db.sdn"
        dir_remove_all(dir)
        val r = write_db_file_locked(path, "payload")
        val ok = r.is_ok()
        val content = if file_exists(path): file_read(path) else: ""
        dir_remove_all(dir)
        expect(ok).to_equal(true)
        expect(content).to_equal("payload")
