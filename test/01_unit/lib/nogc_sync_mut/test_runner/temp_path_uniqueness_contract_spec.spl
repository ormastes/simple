use std.spec
use std.io_runtime.{file_read}

describe "test-runner generated temp paths are per-process unique":
    it "embeds the pid in the coverage wrapper temp path":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl")
        expect(source).to_contain(
            "\"/simple_cov_\" + getpid().to_text() + \"_\" + base")

    it "embeds the pid in the native spipe_wrapped temp path":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl")
        expect(source).to_contain(
            "\"/spipe_wrapped_\" + getpid().to_text() + \"_\"")

    it "embeds the pid in the interpreter result-wrapper temp path":
        val source = file_read(
            "src/lib/nogc_sync_mut/test_runner/test_result_wrapper.spl")
        expect(source).to_contain(
            "\"/tmp/spipe_wrapped_\" + getpid().to_text() + \"_\"")
