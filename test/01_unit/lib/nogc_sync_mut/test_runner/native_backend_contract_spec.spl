use std.spec.{describe, it, expect}
use std.spec.step
use app.test_runner_new.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{TestExecutionMode}
use std.test_runner.test_runner_execute.{native_test_request_error, native_test_compile_args, native_test_compile_args_with_threads, native_test_compile_threads, native_test_invocation_receipt, cleanup_native_generated_files}
use std.common.json.parser.{json_parse_with_error}
use std.test_runner.test_executor_parsing.{build_child_args, make_result_from_output, _tp_get_temp_dir}
use std.io_runtime.{dir_create_all, dir_remove_all, file_exists, file_write, file_delete, read_file_text}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}

describe "Explicit native backend test contract":
    it "fails closed and records quarantine when cleanup cannot prove ownership":
        step("Reject cleanup of a cache outside its exact artifact binding")
        val stamp = time_now_unix_micros()
        val artifact = _tp_get_temp_dir() + "/native-quarantine-{stamp}.exe"
        val rejected_cache = artifact + ".wrong-cache"
        val quarantine = _tp_get_temp_dir() + "/native-quarantine-evidence-{stamp}.env"
        dir_create_all(rejected_cache)
        file_write(rejected_cache + "/sentinel", "must remain")
        val clean = cleanup_native_generated_files(artifact, "", "", "", "original.spl", false, rejected_cache, quarantine)
        expect(clean).to_equal(false)
        expect(file_exists(rejected_cache + "/sentinel")).to_equal(true)
        expect(read_file_text(quarantine)).to_contain("NATIVE-CACHE-CLEANUP-FAILED")
        dir_remove_all(rejected_cache)
        file_delete(quarantine)

    it "retains requested native artifacts and removes private caches otherwise":
        step("Release the completed native entry's private cache")
        val artifact = _tp_get_temp_dir() + "/native-cleanup-{time_now_unix_micros()}.exe"
        val cache = artifact + ".cache"
        dir_create_all(cache)
        file_write(cache + "/owned-object", "fixture")
        file_write(artifact, "fixture")
        cleanup_native_generated_files(artifact, "", "", "", "original.spl", true, cache)
        expect(file_exists(cache + "/owned-object")).to_equal(true)
        expect(file_exists(artifact)).to_equal(true)
        cleanup_native_generated_files(artifact, "", "", "", "original.spl", false, cache)
        expect(file_exists(cache + "/owned-object")).to_equal(false)
        expect(file_exists(artifact)).to_equal(false)
    it "selects LLVM and prevents reuse of backendless result evidence":
        step("Select the LLVM native executable contract")
        val options = parse_test_args(["--native-backend=llvm", "fixture.spl"])
        expect(options.native_backend).to_equal("llvm")
        expect(options.no_cache).to_equal(true)
        expect(options.assert_ran).to_equal(true)
        expect(options.session_daemon).to_equal(false)
        expect(options.session_share).to_equal(false)
        expect(options.mode).to_equal(TestExecutionMode.Native)

    it "preserves SMF compile semantics without an explicit backend":
        step("Keep the existing compile mode compatible")
        val options = parse_test_args(["--mode=compile"])
        expect(options.native_backend).to_equal("")
        expect(options.mode).to_equal(TestExecutionMode.Compile)

    it "constructs independent Cranelift executable compilation arguments":
        step("Build the selected backend with a private artifact cache")
        val args = native_test_compile_args("fixture.spl", "fixture.exe", "cranelift")
        expect(args[0]).to_equal("native-build")
        expect(args[2]).to_equal("cranelift")
        expect(args).to_contain("fixture.exe.cache")
        expect(args).to_contain("fixture.exe")
        expect(args).to_contain("--threads")
        expect(args[11]).to_equal("1")

    it "propagates explicit native build threads into the compiler argv":
        step("Use the validated thread count for either selected backend")
        val (threads, error) = native_test_compile_threads("20")
        expect(error).to_equal("")
        val llvm = native_test_compile_args_with_threads("fixture.spl", "llvm.exe", "llvm", threads)
        val cranelift = native_test_compile_args_with_threads("fixture.spl", "cranelift.exe", "cranelift", threads)
        expect(llvm[2]).to_equal("llvm")
        expect(llvm[10]).to_equal("--threads")
        expect(llvm[11]).to_equal("20")
        expect(cranelift[2]).to_equal("cranelift")
        expect(cranelift[10]).to_equal("--threads")
        expect(cranelift[11]).to_equal("20")

    it "rejects invalid explicit native build thread counts":
        step("Fail before native compiler launch instead of using a fallback")
        expect(native_test_compile_threads("").0).to_equal(1)
        expect(native_test_compile_threads("00020").0).to_equal(20)
        expect(native_test_compile_threads("0").1).to_contain("positive decimal")
        expect(native_test_compile_threads("-1").1).to_contain("positive decimal")
        expect(native_test_compile_threads("20x").1).to_contain("positive decimal")
        expect(native_test_compile_threads(" 20").1).to_contain("positive decimal")
        expect(native_test_compile_threads("9223372036854775808").1).to_contain("positive decimal")

    it "prints parseable exact native AOT invocation evidence when verbose":
        step("Bind producer, spec, output, backend, and escaped argv")
        val args = native_test_compile_args_with_threads("fixture with space.spl", "fixture.exe", "llvm", 20)
        val receipt = native_test_invocation_receipt("llvm", "abc123", "fixture with space.spl", "fixture.exe", "/tmp/simple", args)
        expect(receipt).to_start_with("native-aot-invocation|")
        val parsed = json_parse_with_error(receipt.replace("native-aot-invocation|", ""))
        expect(parsed.1).to_equal("")
        expect(receipt).to_contain("\"--threads\",\"20\"")
        expect(receipt).to_contain("\"spec\":\"fixture with space.spl\"")

    it "propagates native backend to a sequential child rather than interpreting source":
        step("Preserve the selected backend across a parallel worker boundary")
        val options = parse_test_args(["--native-backend", "cranelift"])
        val args = build_child_args("fixture.spl", options)
        expect(args[0]).to_equal("test")
        expect(args).to_contain("--native-backend=cranelift")
        expect(args).to_contain("--sequential")
        expect(args).to_contain("--assert-ran")

    it "rejects unknown backends and unqualified Cranelift coverage":
        step("Reject requests that cannot provide the selected backend evidence")
        expect(native_test_request_error("llvm", false)).to_equal("")
        expect(native_test_request_error("cranelift", false)).to_equal("")
        expect(native_test_request_error("unknown", false)).to_contain("Unsupported")
        expect(native_test_request_error("cranelift", true)).to_contain("refusing LLVM fallback")
        expect(native_test_request_error("llvm", false, true)).to_contain("cannot be combined")

    it "preserves positive and failing assertion counts from native executable output":
        step("Check real assertion outcomes cannot be replaced by an exit code")
        val passing = make_result_from_output("fixture.spl", "Results: 1 total, 1 passed, 0 failed", "", 0, 1, 60)
        val failing = make_result_from_output("fixture.spl", "Results: 1 total, 0 passed, 1 failed", "", 1, 1, 60)
        expect(passing.passed).to_equal(1)
        expect(passing.failed).to_equal(0)
        expect(failing.passed).to_equal(0)
        expect(failing.failed).to_equal(1)
