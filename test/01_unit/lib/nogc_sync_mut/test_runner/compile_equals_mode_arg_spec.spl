# Reproduce spec for doc/08_tracking/bug/test_runner_kinds_windows_seed_audit_2026-11-16.md
#
# `simple test --help` documents `--compile=<mode>` but the argument validator
# only knew the bare `--compile`, so `--compile=smf` died with
# `Error: unknown option: --compile=smf` before any spec ran.
# @req: REQ-TEST-RUNNER-ARGS-001

use std.nogc_sync_mut.test_runner.test_runner_args.{test_args_validation_error}

describe "test runner --compile=<mode> argument":

    it "accepts --compile=smf as a known option":
        step("validate a vector carrying the documented explicit form")
        expect(test_args_validation_error(["spec.spl", "--compile=smf"])).to_equal("")

    it "accepts the other documented explicit modes":
        step("validate native and interpreter spellings")
        expect(test_args_validation_error(["spec.spl", "--compile=native"])).to_equal("")
        expect(test_args_validation_error(["spec.spl", "--compile=interpreter"])).to_equal("")

    it "still rejects a genuinely unknown option":
        step("validate a flag the runner never defined")
        expect(test_args_validation_error(["spec.spl", "--no-such-flag"])).to_start_with("unknown option")
