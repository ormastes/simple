use std.spec.*
use std.test_runner.test_executor_parsing.{
    COMPILER_COVERAGE_BEGIN, COMPILER_COVERAGE_END,
    extract_compiler_coverage_manifest_sdn,
    strip_compiler_coverage_manifest_blocks
}

fn manifest() -> text:
    "decisions |id, file, line, column, true_count, false_count|\n" +
        "branch-1, src/owned/frame.spl, 10, 4, 0, 0\n" +
        "conditions |decision_id, condition_id, file, line, column, true_count, false_count|"

describe "compiler coverage manifest output parsing":
    it "extracts ANSI-wrapped sentinels and strips the complete block":
        val output = "before\n\x1b[32m{COMPILER_COVERAGE_BEGIN}\x1b[0m\n{manifest()}\n{COMPILER_COVERAGE_END}\nafter"
        val (payload, valid) = extract_compiler_coverage_manifest_sdn(output)
        expect(valid).to_be(true)
        expect(payload).to_equal(manifest())
        expect(strip_compiler_coverage_manifest_blocks(output)).to_equal("before\nafter")

    it "rejects a missing or unterminated manifest":
        val (missing_payload, missing_valid) = extract_compiler_coverage_manifest_sdn("ordinary output")
        expect(missing_payload).to_equal("")
        expect(missing_valid).to_be(false)
        val unterminated = "{COMPILER_COVERAGE_BEGIN}\n{manifest()}"
        val (payload, valid) = extract_compiler_coverage_manifest_sdn(unterminated)
        expect(payload).to_equal(manifest())
        expect(valid).to_be(false)

    it "rejects empty and duplicate complete manifest blocks":
        val empty = "{COMPILER_COVERAGE_BEGIN}\n{COMPILER_COVERAGE_END}"
        val (_, empty_valid) = extract_compiler_coverage_manifest_sdn(empty)
        expect(empty_valid).to_be(false)
        val block = "{COMPILER_COVERAGE_BEGIN}\n{manifest()}\n{COMPILER_COVERAGE_END}"
        val (_, duplicate_valid) = extract_compiler_coverage_manifest_sdn("{block}\n{block}")
        expect(duplicate_valid).to_be(false)
