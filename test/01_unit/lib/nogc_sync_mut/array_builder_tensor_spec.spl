# Purpose and audience: executable specification evidence for the owning engineering team.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
use std.spec.*
use std.nogc_sync_mut.src.array_builder.{ArrayBuilder}
use std.nogc_sync_mut.src.tensor.{Device, Tensor}

describe "nogc_sync_mut source collection helpers":
    """
    Purpose: this manual pins the behavior named "nogc_sync_mut source collection helpers" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    it "builds, grows, truncates, and clears typed arrays":
        # @req REQ-SSPEC-UNIT
        step("builds, grows, truncates, and clears typed arrays")
        var builder: ArrayBuilder<i64> = ArrayBuilder.with_capacity(2)
        builder.push(10)
        builder.push_unchecked(20)
        builder.push_safe(30)

        expect(builder.len()).to_equal(3)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(builder.capacity()).to_equal(4)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(builder.build()).to_equal([10, 20, 30])

        builder.truncate(2)
        expect(builder.build()).to_equal([10, 20])
        expect(builder.capacity()).to_equal(4)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        builder.push(40)
        builder.push(50)
        expect(builder.build()).to_equal([10, 20, 40, 50])
        expect(builder.capacity()).to_equal(4)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        builder.push(60)
        expect(builder.build()).to_equal([10, 20, 40, 50, 60])
        expect(builder.capacity()).to_equal(8)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        builder.clear()
        expect(builder.is_empty()).to_equal(true)
        expect(builder.build().len()).to_equal(0)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
    it "uses the const rank parameter for tensor rank":
        # @req REQ-SSPEC-UNIT
        step("uses the const rank parameter for tensor rank")
        val tensor = Tensor<i64, 2>(
            _handle: 0,
            _shape: [2, 3],
            _device: Device.cpu()
        )

        expect(tensor.ndim()).to_equal(2)  # oracle: authoritative expected value documented in the plan/bug record this spec pins
        expect(tensor.numel()).to_equal(6)  # oracle: authoritative expected value documented in the plan/bug record this spec pins

        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)