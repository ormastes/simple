# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: OIDC ID-token audience validation (OIDC Core 1.0 §2 makes "aud" a
REQUIRED claim) must reject a missing or mismatched audience and accept a
matching one.
Audience: identity/security engineers who maintain the OIDC client library.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.oidc.id_token.{IdTokenValidator, IdTokenClaims}

# @manual_section: ID-token audience claim validation

describe "IdTokenValidator.validate_claims":
    it "rejects a token with no audience claim when an audience is expected":
        # @req REQ-SSPEC-UNIT
        step("Verify: missing aud claim is rejected")
        val validator = IdTokenValidator.new("https://issuer.example.com", "expected-client-id")
        val claims = IdTokenClaims(
            issuer: "https://issuer.example.com",
            subject: "user-123",
            audience: "",
            expiry: 0,
            issued_at: 0,
            nonce: "",
            email: "",
            name: ""
        )
        val result = validator.validate_claims(claims)
        expect(result.is_err()).to_equal(true)  # oracle: aud is required, empty aud must Err

    it "accepts a token whose audience matches the expected client id":
        # @req REQ-SSPEC-UNIT
        step("Verify: matching audience is accepted")
        val validator = IdTokenValidator.new("https://issuer.example.com", "expected-client-id")
        val claims = IdTokenClaims(
            issuer: "https://issuer.example.com",
            subject: "user-123",
            audience: "expected-client-id",
            expiry: 0,
            issued_at: 0,
            nonce: "",
            email: "",
            name: ""
        )
        val result = validator.validate_claims(claims)
        expect(result.is_ok()).to_equal(true)  # oracle: exact audience match passes

    it "rejects a token whose audience does not match the expected client id":
        # @req REQ-SSPEC-UNIT
        step("Verify: mismatched audience is rejected")
        val validator = IdTokenValidator.new("https://issuer.example.com", "expected-client-id")
        val claims = IdTokenClaims(
            issuer: "https://issuer.example.com",
            subject: "user-123",
            audience: "other-client-id",
            expiry: 0,
            issued_at: 0,
            nonce: "",
            email: "",
            name: ""
        )
        val result = validator.validate_claims(claims)
        expect(result.is_err()).to_equal(true)  # oracle: wrong audience must Err
