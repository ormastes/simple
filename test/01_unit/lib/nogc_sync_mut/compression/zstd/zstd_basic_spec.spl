"""
## Purpose and audience
Behavioral specification for zstd basic.
Audience: compiler/runtime developers and spec maintainers who need
to verify this component's observable behavior and pinned values.
"""
# @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
# zstd_basic_spec.spl
#
# Smoke tests for the Zstd decoder.
#
# These tests verify:
#   - Empty input returns Err (TruncatedInput)
#   - Bad magic returns Err (InvalidHeader)
#   - A minimal Raw_Block frame decodes correctly
#   - A minimal RLE_Block frame decodes correctly
#   - Skippable frame is skipped (empty output)
#   - Chained frames: two raw-block frames concatenated

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.compression.zstd.decoder.{zstd_decode}
use std.common.compress.types.{CompressionError}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fn bytes_equal(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i = 0
    while i < a.len():
        if a[i] != b[i]:
            return false
        i = i + 1
    true

# Build a minimal Zstd frame with a single Raw_Block.
# Frame layout (Single_Segment=1, FCS=1byte, no checksum):
#   Magic(4) + FHD(1) + FCS(1) + Block_Header(3) + Block_Content(N)
fn make_raw_frame(content: [u8]) -> [u8]:
    var out: [u8] = []
    # Magic: 0xFD2FB528 LE
    out.push(0x28u8)
    out.push(0xB5u8)
    out.push(0x2Fu8)
    out.push(0xFDu8)
    # FHD: FCS_Flag=00 (1-byte FCS since single_seg=1), Single_Segment=1, no checksum, DID=0
    # FHD = 0b00100000 = 0x20  (single_seg bit)
    out.push(0x20u8)
    # FCS: 1 byte (content size <= 255)
    out.push(content.len().to_u8())
    # Block_Header: Last=1, Type=Raw(0), Size=N
    # raw: (1 | 0<<1 | N<<3) packed in 3 LE bytes
    val n = content.len()
    val hdr = 1 | (n << 3)
    out.push((hdr & 0xFF).to_u8())
    out.push(((hdr >> 8) & 0xFF).to_u8())
    out.push(((hdr >> 16) & 0xFF).to_u8())
    # Block content
    var i = 0
    while i < content.len():
        out.push(content[i])
        i = i + 1
    out

# Build a minimal Zstd frame with a single RLE_Block.
fn make_rle_frame(byte_val: i64, count: i64) -> [u8]:
    var out: [u8] = []
    # Magic
    out.push(0x28u8)
    out.push(0xB5u8)
    out.push(0x2Fu8)
    out.push(0xFDu8)
    # FHD: Single_Segment=1, FCS=1-byte
    out.push(0x20u8)
    # FCS
    out.push(count.to_u8())
    # Block_Header: Last=1, Type=RLE(1), Size=count
    val hdr = 1 | (1 << 1) | (count << 3)
    out.push((hdr & 0xFF).to_u8())
    out.push(((hdr >> 8) & 0xFF).to_u8())
    out.push(((hdr >> 16) & 0xFF).to_u8())
    # Single payload byte
    out.push(byte_val.to_u8())
    out

# Build a skippable frame (magic 0x184D2A50, payload_size=0).
fn make_skippable_frame() -> [u8]:
    var out: [u8] = []
    # Skip magic: 0x184D2A50 LE
    out.push(0x50u8)
    out.push(0x2Au8)
    out.push(0x4Du8)
    out.push(0x18u8)
    # Payload size: 0
    out.push(0x00u8)
    out.push(0x00u8)
    out.push(0x00u8)
    out.push(0x00u8)
    out

# Build a frame holding one Compressed_Block with Raw (lit_type 0) or RLE
# (lit_type 1) literals and zero sequences. size_fmt 0 = 1-byte header (5-bit
# size), 1 = 2-byte header (12-bit), 3 = 3-byte header (20-bit), RFC 8878
# §3.1.1.3.1.1. Raw content is (i*7+13)&255; RLE content is 'A'. Every frame
# built here for the specs below was decoded by host `zstd -d` 1.5.5 and
# compared equal to the expected content.
fn make_lit_frame(lit_type: i64, n: i64, size_fmt: i64) -> [u8]:
    var blk: [u8] = []
    if size_fmt == 0:
        blk.push((lit_type | (n << 3)).to_u8())
    elif size_fmt == 1:
        blk.push((lit_type | 4 | ((n & 15) << 4)).to_u8())
        blk.push((n >> 4).to_u8())
    else:
        blk.push((lit_type | 12 | ((n & 15) << 4)).to_u8())
        blk.push(((n >> 4) & 0xFF).to_u8())
        blk.push((n >> 12).to_u8())
    if lit_type == 0:
        var i = 0
        while i < n:
            blk.push(((i * 7 + 13) & 0xFF).to_u8())
            i = i + 1
    else:
        blk.push(0x41u8)
    blk.push(0x00u8)
    # Magic, FHD 0xA0 (Single_Segment, 4-byte FCS), FCS
    var out: [u8] = [0x28u8, 0xB5u8, 0x2Fu8, 0xFDu8, 0xA0u8]
    out.push((n & 0xFF).to_u8())
    out.push(((n >> 8) & 0xFF).to_u8())
    out.push(((n >> 16) & 0xFF).to_u8())
    out.push(((n >> 24) & 0xFF).to_u8())
    val hdr = 1 | (2 << 1) | (blk.len() << 3)
    out.push((hdr & 0xFF).to_u8())
    out.push(((hdr >> 8) & 0xFF).to_u8())
    out.push(((hdr >> 16) & 0xFF).to_u8())
    var j = 0
    while j < blk.len():
        out.push(blk[j])
        j = j + 1
    out

fn expected_lit_content(lit_type: i64, n: i64) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < n:
        if lit_type == 0:
            out.push(((i * 7 + 13) & 0xFF).to_u8())
        else:
            out.push(0x41u8)
        i = i + 1
    out

fn lit_frame_round_trips(lit_type: i64, n: i64, size_fmt: i64) -> bool:
    val result = zstd_decode(make_lit_frame(lit_type, n, size_fmt))
    if result.is_err():
        return false
    bytes_equal(result.unwrap(), expected_lit_content(lit_type, n))

# ---------------------------------------------------------------------------
# Specs
# ---------------------------------------------------------------------------

describe "zstd decoder":
    it "returns error on empty input":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: returns error on empty input")
        val result = zstd_decode([])
        expect(result.is_err()).to_equal(true)

    it "returns error on bad magic":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: returns error on bad magic")
        val bad: [u8] = [0x00u8, 0x01u8, 0x02u8, 0x03u8]
        val result = zstd_decode(bad)
        expect(result.is_err()).to_equal(true)

    it "decodes a single raw block frame":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: decodes a single raw block frame")
        val content: [u8] = [0x48u8, 0x65u8, 0x6Cu8, 0x6Cu8, 0x6Fu8]  # "Hello"
        val frame = make_raw_frame(content)
        val result = zstd_decode(frame)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(bytes_equal(output, content)).to_equal(true)

    it "decodes an empty raw block frame":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: decodes an empty raw block frame")
        val frame = make_raw_frame([])
        val result = zstd_decode(frame)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output.len()).to_equal(0)  # oracle: expected value pinned by spec

    it "decodes a single rle block frame":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: decodes a single rle block frame")
        val frame = make_rle_frame(0x41, 5)  # 'A' repeated 5 times
        val result = zstd_decode(frame)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output.len()).to_equal(5)  # oracle: expected value pinned by spec
        var all_a = true
        var i = 0
        while i < output.len():
            if output[i] != 0x41u8:
                all_a = false
            i = i + 1
        expect(all_a).to_equal(true)

    it "skips a skippable frame producing empty output":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: skips a skippable frame producing empty output")
        val frame = make_skippable_frame()
        val result = zstd_decode(frame)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output.len()).to_equal(0)  # oracle: expected value pinned by spec

    it "decodes chained raw-block frames":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: decodes chained raw-block frames")
        val c1: [u8] = [0x41u8, 0x42u8]   # "AB"
        val c2: [u8] = [0x43u8, 0x44u8]   # "CD"
        val f1 = make_raw_frame(c1)
        val f2 = make_raw_frame(c2)
        var combined: [u8] = []
        var i = 0
        while i < f1.len():
            combined.push(f1[i])
            i = i + 1
        var j = 0
        while j < f2.len():
            combined.push(f2[j])
            j = j + 1
        val result = zstd_decode(combined)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(output.len()).to_equal(4)  # oracle: expected value pinned by spec

    it "skippable frame followed by raw block frame":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: skippable frame followed by raw block frame")
        val content: [u8] = [0x58u8, 0x59u8]  # "XY"
        val skip = make_skippable_frame()
        val data = make_raw_frame(content)
        var combined: [u8] = []
        var i = 0
        while i < skip.len():
            combined.push(skip[i])
            i = i + 1
        var j = 0
        while j < data.len():
            combined.push(data[j])
            j = j + 1
        val result = zstd_decode(combined)
        expect(result.is_ok()).to_equal(true)
        val output = result.unwrap()
        expect(bytes_equal(output, content)).to_equal(true)

describe "zstd decoder frame header":
    it "decodes a frame with a 4-byte Frame_Content_Size (FCS flag 2)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: FHD 0xA0 carries a 4-byte FCS (RFC 8878 3.1.1.1.4); host zstd -d accepts this frame")
        val frame: [u8] = [0x28u8, 0xB5u8, 0x2Fu8, 0xFDu8, 0xA0u8, 0x05u8, 0x00u8, 0x00u8, 0x00u8,
            0x29u8, 0x00u8, 0x00u8, 0x48u8, 0x65u8, 0x6Cu8, 0x6Cu8, 0x6Fu8]
        val result = zstd_decode(frame)
        expect(result.is_ok()).to_equal(true)
        val content: [u8] = [0x48u8, 0x65u8, 0x6Cu8, 0x6Cu8, 0x6Fu8]
        expect(bytes_equal(result.unwrap(), content)).to_equal(true)

describe "zstd decoder raw/rle literals size formats":
    it "pins the 2-byte raw literals header bytes host zstd accepts":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 01 header for 100 raw literals is 0x44 0x06")
        val frame = make_lit_frame(0, 100, 1)
        expect(frame[12].to_i64()).to_equal(0x44)
        expect(frame[13].to_i64()).to_equal(0x06)

    it "decodes raw literals with a 1-byte header (31 bytes)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 00 raw literals")
        expect(lit_frame_round_trips(0, 31, 0)).to_equal(true)

    it "decodes raw literals with a 2-byte header (100 bytes, 12-bit size)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 01 raw literals")
        expect(lit_frame_round_trips(0, 100, 1)).to_equal(true)

    it "decodes raw literals with a 3-byte header (5000 bytes, 20-bit size)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 11 raw literals")
        expect(lit_frame_round_trips(0, 5000, 3)).to_equal(true)

    it "decodes rle literals with a 1-byte header (20 bytes)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 00 rle literals")
        expect(lit_frame_round_trips(1, 20, 0)).to_equal(true)

    it "decodes rle literals with a 2-byte header (100 bytes, 12-bit size)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 01 rle literals")
        expect(lit_frame_round_trips(1, 100, 1)).to_equal(true)

    it "decodes rle literals with a 3-byte header (5000 bytes, 20-bit size)":
        # @req: REQ-LIB-ZSTD_ZSTD_BASIC-001
        step("Verify: Size_Format 11 rle literals")
        expect(lit_frame_round_trips(1, 5000, 3)).to_equal(true)
