# NOT_RUN: requires the admitted compiler and matching runtime.
use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.compression.gzip.inflate.{deflate_block_parse}

describe "GZIP legacy optional block parsing":
    it "rejects nil, empty input, invalid offsets and truncated stored blocks":
        step("Reject invalid input before any indexed byte read")
        val stored: [u8] = [1, 3, 0, 252, 255, 0, 128, 255]
        val empty: [u8] = []
        expect(deflate_block_parse(nil, 0) == nil).to_equal(true)
        expect(deflate_block_parse(empty, 0) == nil).to_equal(true)
        expect(deflate_block_parse(stored, -1) == nil).to_equal(true)
        expect(deflate_block_parse(stored, -9223372036854775807) == nil).to_equal(true)
        expect(deflate_block_parse(stored, stored.len()) == nil).to_equal(true)
        expect(deflate_block_parse(stored, 99) == nil).to_equal(true)
        val short_header: [u8] = [1, 3, 0]
        val short_payload: [u8] = [1, 3, 0, 252, 255, 0]
        expect(deflate_block_parse(short_header, 0) == nil).to_equal(true)
        expect(deflate_block_parse(short_payload, 0) == nil).to_equal(true)

    it "preserves all stored-block result fields and byte values at a nonzero offset":
        step("Read a stored final block with zero and high-bit payload bytes")
        val prefixed: [u8] = [255, 1, 3, 0, 252, 255, 0, 128, 255]
        if val parsed = deflate_block_parse(prefixed, 1):
            expect(parsed.block_type).to_equal(0)
            expect(parsed.is_final).to_equal(true)
            expect(parsed.data.len()).to_equal(3)
            expect(parsed.data[0]).to_equal(0u8)
            expect(parsed.data[1]).to_equal(128u8)
            expect(parsed.data[2]).to_equal(255u8)
            expect(parsed.next_offset).to_equal(9)
        else:
            expect(false).to_equal(true)

    it "preserves fixed and dynamic marker types, flags, byte arrays and offsets":
        step("Return marker payloads without claiming Huffman decompression")
        val fixed_bytes: [u8] = [3, 0]
        val dynamic_bytes: [u8] = [255, 4, 0]
        if val fixed = deflate_block_parse(fixed_bytes, 0):
            expect(fixed.block_type).to_equal(1)
            expect(fixed.is_final).to_equal(true)
            expect(fixed.data.len()).to_equal(0)
            expect(fixed.next_offset).to_equal(0)
        else:
            expect(false).to_equal(true)
        if val dynamic = deflate_block_parse(dynamic_bytes, 1):
            expect(dynamic.block_type).to_equal(2)
            expect(dynamic.is_final).to_equal(false)
            expect(dynamic.data.len()).to_equal(0)
            expect(dynamic.next_offset).to_equal(1)
        else:
            expect(false).to_equal(true)
