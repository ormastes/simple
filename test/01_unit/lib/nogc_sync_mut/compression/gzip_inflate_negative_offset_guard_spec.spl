use std.nogc_sync_mut.compression.gzip.inflate.{deflate_block_parse}

describe "GZIP inflate negative offset guards":
    it "rejects negative legacy block offsets before indexed reads":
        val stored: [u8] = [1, 1, 0, 254, 255, 97]
        expect(deflate_block_parse(stored, -1) == nil).to_equal(true)
        expect(deflate_block_parse(stored, -9223372036854775807) == nil).to_equal(true)
        if val block = deflate_block_parse(stored, 0):
            expect(block.data).to_equal([97])
            expect(block.next_offset).to_equal(6)
        else:
            expect(false).to_equal(true)
