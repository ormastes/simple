extern fn rt_file_read_text(path: text) -> text

# Regression guard: `deflate_block_parse` must reject a negative or
# out-of-range offset BEFORE it does the indexed read `data[offset]`.
#
# Two things were wrong here and both made the guard vacuous rather than
# strict. The helper called `source.to_contain(...)`, but `to_contain` is a
# MATCHER, not a method on `text` -- the correct method is `.contains(...)`,
# and the misuse aborted the example instead of testing anything. The pinned
# signature `fn deflate_block_parse(data, offset):` also went stale when the
# function gained its `-> [Any]?` return type, so even a working helper would
# have reported the guard missing while it was in fact present at
# `inflate.spl:535`.
fn _contains_gzip_inflate_negative_guard(path: text) -> bool:
    val source = rt_file_read_text(path) ?? ""
    return source.contains("fn deflate_block_parse(data, offset) -> [Any]?:") and
        source.contains("if offset < 0:\n        return nil") and
        source.contains("if offset >= data.len():\n        return nil") and
        source.contains("val header_byte = data[offset].to_i64()")

describe "GZIP inflate negative offset guards":
    it "guards legacy block parsing before indexed reads":
        expect(_contains_gzip_inflate_negative_guard("src/lib/nogc_sync_mut/compression/gzip/inflate.spl")).to_equal(true)
