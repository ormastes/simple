# @req REQ-SSPEC-LIB
# Pins phase2_crc32_i64_width_spill_2026_10_27: a u32 result must not carry
# bits above bit 31 when widened with .to_i64() (native lane: unsigned narrow
# BinOp/UnaryOp results are re-canonicalised in cranelift_codegen_adapter.spl).
use std.spec.step
use std.spec.{describe, it, assert_equal}
use std.common.crypto.crc32.{crc32, crc32_finalize}
use std.nogc_sync_mut.compression.gzip.{crc32_calculate}

fn _u32_not(x: u32) -> u32:
    ~x

fn _u32_sub(a: u32, b: u32) -> u32:
    a - b

fn _u32_shl8(a: u32) -> u32:
    a << 8

describe "u32 to_i64 width":
    it "keeps CRC-32 of 123456789 unsigned":
        step("crc32 KAT")
        val d: [u8] = [49, 50, 51, 52, 53, 54, 55, 56, 57]
        assert_equal(crc32(d).to_i64(), 3421780262)
        assert_equal(crc32_calculate(d), 3421780262)
    it "does not spill high bits through not/sub/shl":
        step("u32 wrap ops")
        assert_equal(_u32_not(0x12345678u32).to_i64(), 3989547399)
        assert_equal(_u32_sub(0u32, 1u32).to_i64(), 4294967295)
        assert_equal(_u32_shl8(0xFF000001u32).to_i64(), 256)
        assert_equal(crc32_finalize(0x0u32).to_i64(), 4294967295)
