# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB

# @req REQ-SSPEC-LIB
"""
# Root `http_client` shim header helpers and send path

**Category:** Stdlib
**Status:** Implemented

## Purpose and Audience

Anyone importing `std.nogc_sync_mut.http_client`. The root shim's `add_header`
used to call itself through an `add_header as request_add_header` alias and
overflowed the stack (crashing every `itf wiki` command), and the shim had no
send path at all, so callers got no status.

## Scope and Preconditions

Header helpers are pure. `send_request` is exercised only against an
unresolvable host, so the assertion is platform-safe: it must fail loudly
(status -1, not a success).
"""

use std.spec.step

use std.spec.*
use std.nogc_sync_mut.http_client.{create_headers, add_header, get_header, has_header, create_request, request_add_header, send_request, response_get_status_code, response_is_success}

describe "http_client root shim":
    # @manual scenario evidence

    it "add_header returns with the header set":
        # @req REQ-SSPEC-LIB
        step("add_header returns with the header set")
        step("Add one header through the root shim (the path that recursed)")
        val headers = add_header(create_headers(), "Accept", "application/json")
        expect(headers.length()).to_equal(1)
        expect(has_header(headers, "accept")).to_equal(true)
        expect(get_header(headers, "Accept") ?? "").to_equal("application/json")

    it "request_add_header attaches a header to a request tuple":
        # @req REQ-SSPEC-LIB
        step("request_add_header attaches a header to a request tuple")
        step("Build a GET and attach a header")
        val req = request_add_header(create_request("GET", "http://example.invalid/"), "Accept", "text/plain")
        expect(req.2.length()).to_equal(1)

    it "send_request fails loudly on an unreachable host":
        # @req REQ-SSPEC-LIB
        step("send_request fails loudly on an unreachable host")
        step("Send to a host that cannot resolve")
        val resp = send_request(create_request("GET", "http://host.invalid./x"))
        expect(response_get_status_code(resp)).to_equal(-1)
        expect(response_is_success(resp)).to_equal(false)
