# Bug: src/lib/nogc_sync_mut/mcp/jj/tools_git_branch.spl used
#   val args = extract_arguments_dict(body)
#   val destination = args.get("destination") ?? ""
# in handle_git_branch / handle_git_checkout / handle_git_rebase.
#
# extract_arguments_dict(body) (std.nogc_async_mut.mcp.helpers) returns the
# raw JSON *text* substring for the "arguments" object, not a parsed dict.
# Calling `.get(key)` on that text is not a JSON lookup - Simple's text type
# has no such method, so this either resolves through an unrelated fallback
# (confirmed via `bin/simple run`: always returns nothing, even for a key
# that is present in the JSON) or is rejected outright by the interpreter
# ("method `get` not found on type `str`").
#
# Concretely this made handle_git_rebase's REQUIRED "destination" parameter
# always read back empty, so a caller supplying a valid destination still got
# "Missing required parameter: destination" on every call - the tool was
# unusable. handle_git_branch's "action"/"name"/"revision" and
# handle_git_checkout's "revision"/"create" had the same defect.
#
# Fix: switch to extract_nested_string(body, "arguments", key), the helper
# already used correctly by sibling handlers in the same file
# (handle_git_merge, handle_git_cherry_pick) and throughout the mcp/jj tree.

use std.nogc_async_mut.mcp.helpers.{extract_nested_string}
use std.io.{file_read_text}

describe "MCP jj tools_git_branch argument extraction":
    it "extract_nested_string(body, \"arguments\", key) correctly reads a present argument":
        val body = "{\"params\":{\"arguments\":{\"destination\":\"main\",\"source\":\"@\"}}}"
        expect(extract_nested_string(body, "arguments", "destination")).to_equal("main")
        expect(extract_nested_string(body, "arguments", "source")).to_equal("@")

    it "tools_git_branch.spl no longer reads arguments via the broken extract_arguments_dict().get() pattern":
        val src = file_read_text("src/lib/nogc_sync_mut/mcp/jj/tools_git_branch.spl") ?? ""
        expect(src.len()).to_be_greater_than(0)
        # Regression guard: the broken pattern must not reappear.
        assert_false(src.contains("args.get("))
        assert_false(src.contains("extract_arguments_dict"))
        # The three previously-broken handlers must now source their
        # arguments through extract_nested_string.
        assert_true(src.contains("fn handle_git_rebase"))
        assert_true(src.contains("fn handle_git_branch"))
        assert_true(src.contains("fn handle_git_checkout"))
        val rebase_idx = src.index_of("fn handle_git_rebase")
        val rebase_body = src.substring(rebase_idx, rebase_idx + 400)
        assert_true(rebase_body.contains("extract_nested_string(body, \"arguments\", \"destination\")"))
