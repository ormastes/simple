# Narrowing for text_layout_noto_sans_sc_variable_blank_raster_2026_11_05.
# The bundled NotoSansSC[wght].ttf (default wght=100 master) must rasterize
# non-zero ink at 16px for Latin and Han at the runtime font layer, so a fully
# transparent atlas is NOT caused by the face itself and must be sought in the
# Engine2D staging/atlas path above it.
extern fn rt_font_load(path: text) -> i64
extern fn rt_font_glyph_bitmap(font_handle: i64, codepoint: i64, size: f64) -> i64
extern fn rt_font_bitmap_width(h: i64) -> i64
extern fn rt_font_bitmap_height(h: i64) -> i64
extern fn rt_font_bitmap_get_pixel(h: i64, x: i64, y: i64) -> i64
extern fn rt_font_bitmap_free(h: i64)

fn ink(font: i64, cp: i64, size: f64) -> i64:
    val b = rt_font_glyph_bitmap(font, cp, size)
    if b == 0:
        return -1
    var s = 0
    var y = 0
    while y < rt_font_bitmap_height(b):
        var x = 0
        while x < rt_font_bitmap_width(b):
            s = s + rt_font_bitmap_get_pixel(b, x, y)
            x = x + 1
        y = y + 1
    rt_font_bitmap_free(b)
    s

describe "NotoSansSC[wght] raw rasterization":
    it "produces ink for Latin and Han at 16px":
        val font = rt_font_load("assets/fonts/google-fonts/ofl/notosanssc/NotoSansSC[wght].ttf")
        expect(font != 0).to_equal(true)
        expect(ink(font, 65, 16.0) > 0).to_equal(true)
        expect(ink(font, 20013, 16.0) > 0).to_equal(true)
