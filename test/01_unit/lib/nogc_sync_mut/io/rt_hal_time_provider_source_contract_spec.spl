"""
Production rt(hal) monotonic clock declaration specification

## Purpose and audience
Source-contract specification over the shipped clock sources
(`src/lib/nogc_sync_mut/io/time_ops.spl` and the drafted
`hal_clock_dispatch.spl`), written for the rt(hal) hardening reviewers who
must confirm the monotonic clock wrapper keeps the bounded critical provider
contract and a constant-time, allocation-free dispatch leaf.

## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/lib/nogc_sync_mut/io/rt_hal_time_provider_source_contract_spec.spl`
from the repository root; the scenarios read the production source with
`file_read` and assert structural properties of the real declarations.

## Compatibility and limitations
This is a source-contract spec: it asserts properties of shipped source that
has no runtime API, so it must run from a repository checkout. It pins the
CURRENT layout of `time_ops.spl`: a fail-closed `time_now_nanos` wrapper over
the single raw-sample owner `time_sample_monotonic_nanos_or_failure`. The
drafted `@rt(hal, ...)` annotation and `hal_clock_dispatch.spl` leaf from the
unlanded share-history branch are not part of the shipped layout and are not
asserted here.

## Verification guidance and troubleshooting
A failure naming `E-SFFI-TIME-002` or the raw-sample owner means the wrapper
lost its fail-closed contract or gained a second raw provider call.
If the hot-path scenario fails, someone added storage, logging, or branching
to the scalar wrapper — inspect `time_ops.spl` between the
`time_now_nanos` and `time_now_micros` declarations.
"""
# Lifecycle: doc/01_research/domain/mcdc_hal_runtime_hardening.md ;
# doc/03_plan/agent_tasks/mcdc_hal_runtime_hardening.md ;
# doc/04_architecture/mcdc_hal_runtime_hardening.md ;
# doc/05_design/mcdc_hal_runtime_hardening.md
# @manual_section: rt hal monotonic clock source contract
# @feature mcdc_hal_runtime_hardening
# @evidence-class source-contract

use std.spec.*
use std.io_runtime.{file_read}

describe "production monotonic clock declaration":
    it "keeps the public wrapper fail-closed over one raw-sample owner":
        # @req REQ-009 NFR-005
        step("Read time_ops.spl and extract the nanos wrapper")
        val source = file_read("src/lib/nogc_sync_mut/io/time_ops.spl")
        val begin = source.find("fn time_now_nanos() -> i64:")
        val finish = source.find("fn time_now_micros() -> i64:")
        expect(begin).to_be_greater_than(-1)  # oracle: the nanos wrapper must be a real declaration
        expect(finish).to_be_greater_than(begin)  # oracle: micros wrapper follows nanos and bounds the extracted body
        val wrapper = source.substring(begin, finish)
        expect(wrapper.split("time_sample_monotonic_nanos_or_failure()").len() - 1).to_equal(2)  # oracle: one call in the wrapper plus the owner declaration inside the extracted range
        expect(wrapper).to_contain("if value < 0:")
        expect(wrapper).to_contain("E-SFFI-TIME-002")
        expect(wrapper.contains("val value = rt_time_now_nanos()")).to_equal(false)  # oracle: the wrapper must sample through the owner, never the raw provider directly

    it "preserves the compatibility API and calls the raw provider exactly once":
        # @req REQ-010 REQ-015 NFR-006
        step("Count raw provider calls across time_ops.spl")
        val source = file_read("src/lib/nogc_sync_mut/io/time_ops.spl")
        expect(source).to_contain("fn current_time_unix() -> i64:")
        expect(source).to_contain("fn current_time_ms() -> i64:")
        expect(source).to_contain("pub fn time_sample_monotonic_nanos_or_failure() -> i64:")
        expect(source.split("rt_time_now_nanos()").len() - 1).to_equal(2)  # oracle: one extern declaration plus exactly one call site

    it "keeps the hot path scalar and free of dynamic storage or diagnostics":
        # @req REQ-011
        step("Extract the nanos wrapper body and scan it for storage and diagnostic tokens")
        val source = file_read("src/lib/nogc_sync_mut/io/time_ops.spl")
        val begin = source.find("fn time_now_nanos() -> i64:")
        val finish = source.find("fn time_now_micros() -> i64:")
        val wrapper = source.substring(begin, finish)
        expect(wrapper.contains("var storage: [")).to_equal(false)
        expect(wrapper.contains("[u8]")).to_equal(false)
        expect(wrapper.contains(".push(")).to_equal(false)
        expect(wrapper.contains(".to_text(")).to_equal(false)
        expect(wrapper.contains("print ")).to_equal(false)
        expect(wrapper.contains("log ")).to_equal(false)

    it "keeps the raw-sample owner constant-time and allocation-free":
        # @req REQ-012
        step("Extract the raw-sample owner and scan it for control flow and allocation")
        val source = file_read("src/lib/nogc_sync_mut/io/time_ops.spl")
        val begin = source.find("pub fn time_sample_monotonic_nanos_or_failure() -> i64:")
        val finish = source.find("fn time_now_micros() -> i64:")
        expect(begin).to_be_greater_than(-1)  # oracle: the owner must exist at a real offset
        expect(finish).to_be_greater_than(begin)  # oracle: owner precedes the micros wrapper
        val leaf = source.substring(begin, finish)
        expect(leaf.split("rt_time_now_nanos()").len() - 1).to_equal(1)  # oracle: exactly one raw provider call keeps the owner O(1)
        expect(leaf.contains("if ")).to_equal(false)
        expect(leaf.contains("while ")).to_equal(false)
        expect(leaf.contains("for ")).to_equal(false)
        expect(leaf.contains(".push(")).to_equal(false)
        expect(leaf.contains("rt_env_get")).to_equal(false)
        expect(leaf.contains("dynload")).to_equal(false)
