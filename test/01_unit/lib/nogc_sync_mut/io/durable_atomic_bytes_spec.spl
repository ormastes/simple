use std.spec.*
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_list, dir_remove}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write_bytes_durable, file_read_bytes}

const ROOT = "/tmp/simple_durable_atomic_bytes_spec"

describe "durable atomic byte publication":
    before_each:
        dir_remove(ROOT, true)
        expect(dir_create(ROOT, true)).to_be(true)

    after_each:
        dir_remove(ROOT, true)

    it "publishes arbitrary bytes and cleans staging files after rename failure":
        val target = "{ROOT}/blob"
        val bytes = [0u8, 255u8, 128u8, 10u8, 13u8, 42u8]
        expect(file_atomic_write_bytes_durable(target, bytes)).to_be(true)
        expect(file_read_bytes(target)).to_equal([0, 255, 128, 10, 13, 42])

        val blocked = "{ROOT}/blocked"
        expect(dir_create(blocked, true)).to_be(true)
        expect(file_atomic_write_bytes_durable(blocked, bytes)).to_be(false)
        expect(dir_list(ROOT).len()).to_equal(2)
