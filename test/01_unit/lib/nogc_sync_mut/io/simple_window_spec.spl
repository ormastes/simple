use std.spec
use common.io.window_event.{
    WINDOW_STATUS_OK,
    WINDOW_STATUS_INVALID_HANDLE,
    WINDOW_EVENT_KEY,
    WINDOW_ACTION_PRESS,
    WINDOW_MOD_CTRL,
    window_event_key,
}
use std.nogc_sync_mut.io.simple_window.{SimpleWindow}

fn solid_pixels(width: i64, height: i64, color: u32) -> [u32]:
    var pixels: [u32] = []
    var i = 0
    while i < width * height:
        pixels.push(color)
        i = i + 1
    pixels

describe "Simple Window headless conformance":
    it "creates, presents, routes events, and rejects a stale handle":
        var runtime = SimpleWindow.headless(8, 4)
        val baseline_windows = runtime.live_window_count()
        val baseline_pixels = runtime.pixel_surface_count()
        val window = runtime.create_window("demo", 4, 3)
        expect(window > 0).to_equal(true)
        expect(runtime.backend_identity()).to_equal("headless")

        val pixels = solid_pixels(4, 3, 0xFF224466u32)
        expect(runtime.stage_argb(window, 4, 3, pixels)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.present(window)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.frame_sequence(window)).to_equal(1)

        val key = window_event_key(window, 1, 10, 65, 30, WINDOW_ACTION_PRESS, WINDOW_MOD_CTRL)
        expect(runtime.inject_window_event(key)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.poll_event().kind).to_equal(WINDOW_EVENT_KEY)

        expect(runtime.destroy_window(window)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.present(window)).to_equal(WINDOW_STATUS_INVALID_HANDLE)
        expect(runtime.live_window_count()).to_equal(baseline_windows)
        expect(runtime.pixel_surface_count()).to_equal(baseline_pixels)
