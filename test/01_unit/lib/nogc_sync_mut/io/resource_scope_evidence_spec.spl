"""ITEM4-REQ-009 observation integrity. Authored tests UNRUN; file fixtures are not kernel enforcement evidence."""
use std.spec.*
use std.spec.step
use std.io_runtime.{dir_create_all, file_exists}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write_bytes, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use std.nogc_sync_mut.io.resource_scope.{read_cgroup_v2_observation}

fn item4_resource_evidence_write(path: text, value: text) -> bool:
    var bytes: [u8] = []
    for index in 0..value.len(): bytes.push(value.byte_at(index) as u8)
    val written = file_write_bytes(path, bytes)
    expect(written).to_equal(true)
    written

fn item4_resource_evidence_cleanup(parent: text):
    for name in ["memory.current", "memory.peak", "memory.events", "cpu.stat"]:
        if file_exists(parent + "/" + name): expect(file_remove(parent + "/" + name)).to_equal(true)
    expect(dir_remove(parent)).to_equal(true)

fn item4_resource_evidence_fixture() -> Result<text, text>:
    if not dir_create_all("build"): return Err("resource evidence build directory unavailable")
    val parent = secure_temp_dir("build", "item4-resource-evidence-")?
    if not item4_resource_evidence_write(parent + "/memory.current", "0\n"):
        item4_resource_evidence_cleanup(parent)
        return Err("memory.current fixture write failed")
    if not item4_resource_evidence_write(parent + "/memory.events", "high 0\nmax 0\noom 0\noom_kill 0\n"):
        item4_resource_evidence_cleanup(parent)
        return Err("memory.events fixture write failed")
    if not item4_resource_evidence_write(parent + "/cpu.stat", "user_usec 12\nsystem_usec 34\n"):
        item4_resource_evidence_cleanup(parent)
        return Err("cpu.stat fixture write failed")
    Ok(parent)

describe "resource scope metric-file observation integrity":
    it "ITEM4-REQ-009 refuses missing or malformed peak instead of fabricating exact zero":
        step("Create actual metric files in a unique task-owned directory without memory.peak")
        val created = item4_resource_evidence_fixture()
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val parent = created.unwrap()
        val missing = read_cgroup_v2_observation(parent)
        expect(missing.available).to_equal(false)
        expect(missing.unavailable_reason.len() > 0).to_equal(true)
        step("Read real empty invalid negative and overflowing peak files through the production reader")
        for value in ["", " \n", "invalid", "-1", "+1", "1.5", "0x10", "1_000", "18446744073709551615", "1152921504606846976"]:
            if not item4_resource_evidence_write(parent + "/memory.peak", value):
                item4_resource_evidence_cleanup(parent)
                return
            val observed = read_cgroup_v2_observation(parent)
            expect(observed.available).to_equal(false)
            expect(observed.unavailable_reason.len() > 0).to_equal(true)
        item4_resource_evidence_cleanup(parent)

    it "ITEM4-REQ-009 preserves valid zero positive and portable maximum peaks as observations":
        step("Read explicit peak counters with legitimate surrounding whitespace")
        val created = item4_resource_evidence_fixture()
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val parent = created.unwrap()
        val values = ["0\n", " 65536\n", "1152921504606846975"]
        val expected = [0i64, 65536i64, 1152921504606846975i64]
        for index in 0..values.len():
            if not item4_resource_evidence_write(parent + "/memory.peak", values[index]):
                item4_resource_evidence_cleanup(parent)
                return
            val observed = read_cgroup_v2_observation(parent)
            expect(observed.available).to_equal(true)
            expect(observed.memory_peak_bytes).to_equal(expected[index])
            expect(observed.memory_current_bytes).to_equal(0)
            expect(observed.user_cpu_micros).to_equal(12)
            expect(observed.system_cpu_micros).to_equal(34)
        item4_resource_evidence_cleanup(parent)
