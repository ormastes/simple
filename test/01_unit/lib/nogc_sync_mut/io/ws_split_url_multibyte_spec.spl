# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# Regression: _ws_split_url bounded substring() by len() (code points) while
# index_of/substring use byte offsets (owner decision 2026-11-13), so a
# multibyte path or authority was truncated. Bounds use byte_len().

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.ws_client_core.{_ws_split_url}

describe "ws url split with multibyte text":
    it "keeps the whole ASCII path":
        val (addr, host, path) = _ws_split_url("ws://h:9/a/b")
        expect(addr).to_equal("h:9")
        expect(host).to_equal("h:9")
        expect(path).to_equal("/a/b")

    it "keeps a multibyte path intact":
        val (addr, host, path) = _ws_split_url("ws://h/é/ü")
        expect(addr).to_equal("h:80")
        expect(path).to_equal("/é/ü")

    it "keeps a multibyte authority without a path intact":
        val (addr, host, path) = _ws_split_url("ws://hé")
        expect(host).to_equal("hé")
        expect(path).to_equal("/")
