use std.spec.*
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write_bytes_durable, file_read_bytes}
use std.nogc_sync_mut.ptr.raw.{raw_f64_to_bits, raw_bits_to_f64}
use std.nogc_sync_mut.io.window_sffi.{winit_compat_event_get_type}

# Host-independent guard (does not rely on a POSIX `ls`): the restored
# nogc_sync_mut APIs stay reachable and keep their contracts.
const ROOT = "/tmp/simple_durable_atomic_bytes_prevention_spec"

describe "restored nogc_sync_mut io/ptr APIs stay reachable":
    before_each:
        dir_remove(ROOT, true)
        expect(dir_create(ROOT, true)).to_be(true)

    after_each:
        dir_remove(ROOT, true)

    it "durable publish replaces content and refuses a directory target":
        val target = "{ROOT}/blob"
        expect(file_atomic_write_bytes_durable(target, [1u8, 2u8, 3u8])).to_be(true)
        expect(file_atomic_write_bytes_durable(target, [9u8])).to_be(true)
        expect(file_read_bytes(target)).to_equal([9])
        expect(dir_create("{ROOT}/dir", true)).to_be(true)
        expect(file_atomic_write_bytes_durable("{ROOT}/dir", [1u8])).to_be(false)

    it "f64 bit helpers round-trip and winit mapping defaults to 0":
        expect(raw_bits_to_f64(raw_f64_to_bits(1.5))).to_equal(1.5)
        expect(winit_compat_event_get_type(-1)).to_equal(0)
