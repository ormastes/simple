use std.spec.*
use std.nogc_sync_mut.io_runtime.{file_write, file_read, file_delete}

# Sibling of file_write_reexport_dispatch_spec: the same function imported
# directly from its defining module must behave identically.
describe "file_write imported directly from nogc_sync_mut.io_runtime":
    it "creates a missing parent directory and writes":
        val path = "build/spec_tmp/fw_direct_a/deeper/z.txt"
        file_delete(path)
        expect(file_write(path, "same")).to_equal(true)
        expect(file_read(path)).to_equal("same")
        file_delete(path)
