use std.nogc_sync_mut.io.retained_file.{retained_file_open}

# Regression: retained_file must MIR-lower (no Result<(u64,[u8]),text> tuple).
describe "retained_file metadata":
    it "reports Err for a missing path":
        val r = retained_file_open("/nonexistent/p3fix-convnodes", 16u64)
        match r:
            Ok(_): expect(false).to_equal(true)
            Err(_): expect(true).to_equal(true)
