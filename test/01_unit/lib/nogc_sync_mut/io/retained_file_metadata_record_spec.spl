use std.nogc_sync_mut.io.retained_file.{retained_file_open, retained_file_identity_unchanged}

# Regression for convnodes_retained_file_result_tuple_u64_2026-10-25.md.
# NOTE: runs in the interpreter; it does NOT prove native MIR lowering. The MIR
# proof is the Stage 2 native-build of retained_file recorded in the bug doc.
describe "retained_file metadata":
    it "reports Err for a missing path":
        val r = retained_file_open("/nonexistent/p3fix-convnodes", 16u64)
        match r:
            Ok(_): expect(false).to_equal(true)
            Err(_): expect(true).to_equal(true)

    it "reads size and identity of an existing file and sees it unchanged":
        match retained_file_open("/etc/hostname", 1048576u64):
            Err(_): expect(false).to_equal(true)
            Ok(file):
                expect(file.identity.len() > 0).to_equal(true)
                match retained_file_identity_unchanged(file):
                    Ok(same): expect(same).to_equal(true)
                    Err(_): expect(false).to_equal(true)
