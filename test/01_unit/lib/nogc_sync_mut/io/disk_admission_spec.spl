"""
## Purpose and audience
Purpose: Prove cache publishes are refused before the temp file is written when
the volume would drop under the free-space reserve, and admitted when the host
cannot measure (0).
Audience: compiler cache engineers.
"""

use std.spec
use std.nogc_sync_mut.io.disk_admission.{disk_admission_decide, disk_publish_admitted, disk_admission_reserve_bytes}

describe "cache publish disk admission":
    it "admits when the write leaves at least the reserve":
        expect(disk_admission_decide(10000, 1000, 9000)).to_equal(true)

    it "refuses when the write would cross the reserve":
        expect(disk_admission_decide(10000, 1001, 9000)).to_equal(false)
        expect(disk_admission_decide(100, 0, 9000)).to_equal(false)

    it "admits when free space cannot be measured":
        expect(disk_admission_decide(0, 1000000, 9000)).to_equal(true)

    it "has a positive default reserve and admits a tiny write on this host":
        expect(disk_admission_reserve_bytes() > 0).to_equal(true)
        expect(disk_publish_admitted(".", 1)).to_equal(true)
