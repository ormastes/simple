"""
## Purpose and audience
Purpose: Prove cache publishes are refused before the temp file is written when
the volume would drop under the free-space reserve, and admitted when the host
cannot measure (0).
Audience: compiler cache engineers.
"""

use std.spec
use std.nogc_sync_mut.io.disk_admission.{disk_admission_decide, disk_publish_admitted, disk_admission_reserve_bytes, disk_headroom_from_raw, disk_admission_decide_free, FreeBytes}

describe "cache publish disk admission":
    it "admits when the write leaves at least the reserve":
        expect(disk_admission_decide(10000, 1000, 9000)).to_equal(true)

    it "refuses when the write would cross the reserve":
        expect(disk_admission_decide(10000, 1001, 9000)).to_equal(false)
        expect(disk_admission_decide(100, 0, 9000)).to_equal(false)

    it "admits when free space cannot be measured":
        expect(disk_admission_decide(0, 1000000, 9000)).to_equal(true)

    it "has a positive default reserve and admits a tiny write on this host":
        expect(disk_admission_reserve_bytes() > 0).to_equal(true)
        expect(disk_publish_admitted(".", 1)).to_equal(true)

describe "headroom boundary wraps the raw extern into FreeBytes":
    it "wraps a valid positive headroom as a typed FreeBytes":
        val got = disk_headroom_from_raw(4096)
        expect(got.is_some()).to_equal(true)
        val f = got.unwrap()
        expect(f.value).to_equal(4096)

    it "does not wrap the cannot-measure (0) or error (<0) sentinel as a size":
        expect(disk_headroom_from_raw(0).is_some()).to_equal(false)
        expect(disk_headroom_from_raw(-1).is_some()).to_equal(false)
        expect(disk_headroom_from_raw(-22).is_some()).to_equal(false)

    it "decides on the typed value and admits when unmeasured":
        expect(disk_admission_decide_free(Some(10000 as FreeBytes), 1000, 9000)).to_equal(true)
        expect(disk_admission_decide_free(Some(10000 as FreeBytes), 1001, 9000)).to_equal(false)
        expect(disk_admission_decide_free(None, 1000000, 9000)).to_equal(true)
