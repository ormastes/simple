use std.spec.*
use std.io_runtime.{file_write, file_read, file_exists, file_delete, dir_create_all}

# `std.io_runtime` re-exports nogc_sync_mut.io_runtime.file_write. The seed
# used to rebind that re-export to io.file_ops.file_write (a same-named
# function reachable through a glob import), which neither creates the missing
# parent directory nor reports success: the call returned and wrote nothing.
describe "file_write through the std.io_runtime re-export":
    it "creates a missing parent directory and writes":
        val dir = "build/spec_tmp/fw_reexport_a"
        val path = "{dir}/nested/x.txt"
        file_delete(path)
        expect(file_write(path, "hi\n")).to_equal(true)
        expect(file_read(path)).to_contain("hi")
        file_delete(path)

    it "writes into an existing directory":
        val dir = "build/spec_tmp/fw_reexport_b"
        dir_create_all(dir)
        val path = "{dir}/y.txt"
        expect(file_write(path, "there")).to_equal(true)
        expect(file_exists(path)).to_equal(true)
        file_delete(path)
