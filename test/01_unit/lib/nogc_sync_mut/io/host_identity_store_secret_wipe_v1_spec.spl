"""
## Purpose and audience
Pins the secret-buffer wipe contract of the retained identity store that the orchestrator reads host and controller
private keys through (src/lib/nogc_sync_mut/io/host_identity_store_linux_v1.spl and _windows_v1.spl): the native
buffer that `pread` filled and the native buffer `write` drained are zeroed before `free`; the `[u8]` copy of a file is
pre-sized (no growth reallocations that drop key prefixes) and wiped on every refusal after it exists; and `path_v1`,
which re-reads the key file only to prove the target, takes the bytes out of the read result and wipes that sole holder.
Bug: doc/08_tracking/bug/host_identity_ed25519_std_temporaries_unwiped_2026-11-19.md (store section).
Written for owners of the host identity store.
## Operator workflow
Run this one file with the self-hosted runner and read `SPEC FILE VERDICT`.
Status: AUTHORED, NOT_RUN (no runnable binary when written, 2026-11-20, milestone_0055).
## Compatibility and limitations
Pinned by source shape: the wipes act on native memory and on refusal paths that need a racing filesystem (inode or
revision change between reads) to reach, neither of which a unit spec can inject. The Windows journal API carries file
contents as immutable `text`, which no wipe reaches; that residue is recorded in the bug doc, not pinned here.
## Verification guidance and troubleshooting
A failing count names the exact needle. `free(memory)` must appear only inside `identity_linux_free_wiped_v1`.
"""
use std.spec.{step}
use std.io.file_read_text

fn sw_count(source: text, needle: text) -> i64:
    source.split(needle).len() - 1

fn sw_body(source: text, start: text, end: text) -> text:
    val tail = source.substring(source.index_of(start), source.byte_len())
    tail.substring(0, tail.index_of(end))

fn sw_linux() -> text:
    file_read_text("src/lib/nogc_sync_mut/io/host_identity_store_linux_v1.spl")

describe "Identity store wipes private file bytes it held":
    it "zeroes every native read and write buffer before freeing it":
        # @req STWIPE-01
        val source = sw_linux()
        expect(sw_count(source, "fn identity_linux_free_wiped_v1(memory: i64, size: i64):")).to_equal(1)
        expect(sw_count(source, "free(memory)")).to_equal(1)
        expect(sw_count(source, "identity_linux_free_wiped_v1(memory, meta.size)")).to_equal(2)
        expect(sw_count(source, "identity_linux_free_wiped_v1(memory, bytes.len() as i64)")).to_equal(2)
        val helper = sw_body(source, "fn identity_linux_free_wiped_v1(", "@unsafe(")
        expect(sw_count(helper, "volatile_write_u8(memory + index, 0)")).to_equal(1)
        expect(helper.index_of("volatile_write_u8(") < helper.index_of("free(memory)")).to_equal(true)

    it "pre-sizes the read copy and wipes it on every refusal after it exists":
        # @req STWIPE-02
        val read = sw_body(sw_linux(), "fn identity_linux_read_v1(", "@unsafe(")
        expect(sw_count(read, "var bytes: [u8] = [0u8; meta.size]")).to_equal(1)
        expect(sw_count(read, "bytes.push(")).to_equal(0)
        expect(sw_count(read, "identity_linux_read_wiped_error_v1(slot, bytes, \"identity-store-read-changed\")")).to_equal(2)
        expect(sw_count(read, "identity_linux_read_wiped_error_v1(slot, bytes, \"identity-store-file-encoding\")")).to_equal(1)
        step("no refusal returns from inside the NUL scan, where the iterator still holds the buffer")
        expect(sw_count(read, "for byte in bytes:\n        if byte == 0u8: return")).to_equal(0)
        step("an unconfirmed close also wipes before it refuses")
        val close_at = read.index_of("if not identity_linux_file_close_v1(slot):")
        val close_tail = read.substring(close_at, read.byte_len())
        expect(close_tail.index_of("secure_zero_u8_slots(bytes)") > 0).to_equal(true)
        expect(close_tail.index_of("secure_zero_u8_slots(bytes)") < close_tail.index_of("identity-store-close-consumed-unconfirmed")).to_equal(true)
        val helper = sw_body(sw_linux(), "fn identity_linux_read_wiped_error_v1(", "@unsafe(")
        expect(sw_count(helper, "mut bytes: [u8]")).to_equal(1)
        expect(sw_count(helper, "secure_zero_u8_slots(bytes)")).to_equal(1)

    it "takes the re-read key bytes out of the read result in path_v1 and wipes that sole holder":
        # @req STWIPE-03
        val linux_path = sw_body(sw_linux(), "pub fn path_v1(", "pub fn transport_preflight_v1(")
        expect(sw_count(linux_path, "var observed = identity_linux_read_v1(")).to_equal(1)
        expect(sw_count(linux_path, "var held = observed.bytes.unwrap()\n            observed.bytes = None")).to_equal(1)
        expect(sw_count(linux_path, "secure_zero_u8_slots(held)")).to_equal(1)
        expect(sw_count(linux_path, "secure_zero_u8_slots(observed.bytes")).to_equal(0)
        val windows = file_read_text("src/lib/nogc_sync_mut/io/host_identity_store_windows_v1.spl")
        val windows_path = sw_body(windows, "pub fn path_v1(", "pub fn transport_preflight_v1(")
        expect(sw_count(windows_path, "var observed = identity_windows_read_v1(")).to_equal(1)
        expect(sw_count(windows_path, "var held = observed.bytes.unwrap()\n            observed.bytes = None")).to_equal(1)
        expect(sw_count(windows_path, "secure_zero_u8_slots(held)")).to_equal(1)
