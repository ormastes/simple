use std.spec
use std.nogc_sync_mut.io.windows_process_layout.{windows_startupinfo_size, windows_startupinfoex_size, windows_startupinfo_flags_offset, windows_startupinfo_stdin_offset, windows_startupinfoex_attributes_offset, windows_process_info_size, windows_process_info_thread_offset, windows_process_info_pid_offset, windows_security_size, windows_security_inherit_offset, windows_job_basic_limit_size, windows_job_extended_limit_size, windows_job_memory_limit_offset, windows_job_peak_job_memory_offset, windows_job_accounting_size, windows_job_accounting_active_offset, windows_handle_list_size}

describe "Windows process struct layout by pointer width":
    it "matches the Win64 SDK values for 8-byte pointers":
        expect(windows_startupinfo_size(8)).to_equal(104)
        expect(windows_startupinfo_flags_offset(8)).to_equal(60)
        expect(windows_startupinfo_stdin_offset(8)).to_equal(80)
        expect(windows_startupinfoex_attributes_offset(8)).to_equal(104)
        expect(windows_startupinfoex_size(8)).to_equal(112)
        expect(windows_process_info_size(8)).to_equal(24)
        expect(windows_process_info_thread_offset(8)).to_equal(8)
        expect(windows_process_info_pid_offset(8)).to_equal(16)
        expect(windows_security_size(8)).to_equal(24)
        expect(windows_security_inherit_offset(8)).to_equal(16)
        expect(windows_job_basic_limit_size(8)).to_equal(64)
        expect(windows_job_extended_limit_size(8)).to_equal(144)
        expect(windows_job_memory_limit_offset(8)).to_equal(120)
        expect(windows_job_peak_job_memory_offset(8)).to_equal(136)
        expect(windows_job_accounting_size(8)).to_equal(48)
        expect(windows_job_accounting_active_offset(8)).to_equal(40)
        expect(windows_handle_list_size(8)).to_equal(24)

    it "matches the Win32 SDK values for 4-byte pointers":
        expect(windows_startupinfo_size(4)).to_equal(68)
        expect(windows_startupinfo_flags_offset(4)).to_equal(44)
        expect(windows_startupinfo_stdin_offset(4)).to_equal(56)
        expect(windows_startupinfoex_attributes_offset(4)).to_equal(68)
        expect(windows_startupinfoex_size(4)).to_equal(72)
        expect(windows_process_info_size(4)).to_equal(16)
        expect(windows_process_info_thread_offset(4)).to_equal(4)
        expect(windows_process_info_pid_offset(4)).to_equal(8)
        expect(windows_security_size(4)).to_equal(12)
        expect(windows_security_inherit_offset(4)).to_equal(8)
        expect(windows_job_basic_limit_size(4)).to_equal(48)
        expect(windows_job_extended_limit_size(4)).to_equal(112)
        expect(windows_job_memory_limit_offset(4)).to_equal(100)
        expect(windows_job_peak_job_memory_offset(4)).to_equal(108)
        expect(windows_job_accounting_size(4)).to_equal(48)
        expect(windows_job_accounting_active_offset(4)).to_equal(40)
        expect(windows_handle_list_size(4)).to_equal(12)
