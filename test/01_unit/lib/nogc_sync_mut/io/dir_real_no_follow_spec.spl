use std.spec
use std.nogc_sync_mut.io.dir_ops.{dir_create, dir_remove_all, dir_is_real_no_follow}
use std.nogc_sync_mut.io.file_ops.{file_atomic_write}
use std.io_runtime.{cwd_process}

extern fn rt_package_create_symlink(target: text, link_path: text) -> i32

describe "real directory entry without following a link":
    it "accepts a directory but rejects a file, missing entry, and directory symlink":
        val base = cwd_process() + "/build/test/dir-real-no-follow"
        val real = base + "/real"
        val file = base + "/plain.txt"
        val link = base + "/link"
        dir_remove_all(base)
        expect(dir_create(real, true)).to_equal(true)
        expect(file_atomic_write(file, "plain")).to_equal(true)
        expect(dir_is_real_no_follow(real)).to_equal(true)
        expect(dir_is_real_no_follow(file)).to_equal(false)
        expect(dir_is_real_no_follow(base + "/missing")).to_equal(false)
        expect(dir_is_real_no_follow("")).to_equal(false)
        # Windows symlink creation can require Developer Mode or privilege.
        # When creation succeeds, the no-follow behavior is mandatory.
        if rt_package_create_symlink(real, link) == 0:
            expect(dir_is_real_no_follow(link)).to_equal(false)
        dir_remove_all(base)
