use std.nogc_sync_mut.io.windows_process_owner.{windows_process_command_line_v1}
use std.spec.{describe, it, expect}

# cmd.exe takes the raw tail after /c, not CRT argv: CRT-quoting a script that
# contains `&` made cmd look for a command named `"echo ...` (exit 1, not 7).
describe "windows process command line":
    it "passes a cmd /c script as one raw quoted tail":
        val line = windows_process_command_line_v1("C:/WINDOWS/system32/cmd.exe", ["/c", "echo x& exit 7"])
        expect(line).to_equal("\"C:/WINDOWS/system32/cmd.exe\" /s /c \"echo x& exit 7\"")

    it "recognises cmd by base name regardless of case and separator":
        val line = windows_process_command_line_v1("c:/Windows/System32/CMD.EXE", ["/C", "exit 3"])
        expect(line.contains("/s /C \"exit 3\"")).to_be(true)

    it "keeps CRT quoting for non-cmd programs":
        val line = windows_process_command_line_v1("C:/tools/app.exe", ["/c", "a b"])
        expect(line.contains("/s")).to_be(false)
        expect(line.contains("\"a b\"")).to_be(true)
