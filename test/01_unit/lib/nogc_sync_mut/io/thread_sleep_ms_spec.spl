# @cover src/lib/nogc_sync_mut/io/thread.spl 80%
use std.spec.{describe, it, expect, step}
use std.io_runtime.{time_now_monotonic_ms}
use app.io.mod.{thread_sleep_ms}

fn elapsed_ms(duration: i64) -> i64:
    val start = time_now_monotonic_ms()
    thread_sleep_ms(duration)
    return time_now_monotonic_ms() - start

describe "thread_sleep_ms duration":
    it "sleeps for milliseconds rather than reading them as a decimal fraction":
        step("50 ms must not become 0.50 s, and must not cost a shell process")
        val elapsed = elapsed_ms(50)
        expect(elapsed >= 40).to_equal(true)
        expect(elapsed < 400).to_equal(true)

    it "keeps a sub-second remainder on a duration over one second":
        step("1050 ms must not become 1.50 s")
        val elapsed = elapsed_ms(1050)
        expect(elapsed >= 1000).to_equal(true)
        expect(elapsed < 1400).to_equal(true)

    it "returns at once for a zero duration":
        expect(elapsed_ms(0) < 200).to_equal(true)
