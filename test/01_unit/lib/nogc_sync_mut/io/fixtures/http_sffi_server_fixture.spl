# Loopback HTTP server built only through the public http_sffi wrapper.
# Usage: http_sffi_server_fixture.spl PORT STATIC_DIR — prints `listening`,
# then blocks in http_server_start until killed by the driver.
use std.nogc_async_mut.io_runtime.{get_args}
use std.nogc_sync_mut.io.http_sffi.{http_server_new, http_server_route, http_server_static, http_server_start, HTTP_SERVER_ECHO_HANDLER}

fn main():
    val args = get_args()
    val port = args[args.len() - 2].to_int() ?? 0
    val dir = args[args.len() - 1]
    val server = http_server_new(port)
    val ok = server.is_valid and http_server_route(server, "GET", "/hello", "hello-from-simple") and http_server_route(server, "GET", "/echo", HTTP_SERVER_ECHO_HANDLER) and http_server_route(server, "POST", "/upload", HTTP_SERVER_ECHO_HANDLER) and http_server_static(server, "/static", dir)
    if not ok:
        print "setup failed"
        return
    print "listening"
    http_server_start(server)

main()
