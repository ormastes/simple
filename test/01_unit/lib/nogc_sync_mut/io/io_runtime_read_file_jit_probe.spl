# Runnable probe: every std.io_runtime text-read entry point must return the
# file, not abort the process.
#
# Pins doc/08_tracking/bug/seed_file_read_infinite_recursion_stack_overflow_2026-08-23.md
# and doc/08_tracking/bug/io_runtime_read_file_still_aborts_incomplete_fix_2026-08-24.md.
# `file_read` (io_runtime.spl) and `file_read` (io/file_ops.spl) are
# co-flattened under ONE name by the Cranelift JIT's first-definition-wins
# dedupe; when either side forwarded through `read_file_text`, the pair closed
# into `file_read -> read_file_text -> file_read -> ...` and the JIT'd code
# SIGABRTed with "fatal runtime error: stack overflow" on the first read of any
# file. A `*_spec.spl` cannot observe this (a stack overflow kills the runner,
# and specs never execute under the JIT), so it is pinned here and run by
# scripts/check/check-runnable-probes.shs on both engines.
use std.io_runtime.{read_file, file_read, read_file_text, file_read_result}

fn main():
    val path = "README.md"
    var expected = -1
    match file_read_result(path):
        case Ok(content): expected = content.len()
        case Err(_): expected = -1
    val a = read_file(path).len()
    val b = file_read(path).len()
    val c = read_file_text(path).len()
    print("expected=" + expected.to_text() + " read_file=" + a.to_text() + " file_read=" + b.to_text() + " read_file_text=" + c.to_text())
    if expected > 0 and a == expected and b == expected and c == expected:
        print("PROBE VERDICT: PASS")
        return 0
    print("PROBE VERDICT: FAIL io_runtime text-read entry points disagree with file_read_result")
    return 1
