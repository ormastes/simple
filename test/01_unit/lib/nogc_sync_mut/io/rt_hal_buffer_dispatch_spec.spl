# @feature mcdc_hal_runtime_hardening
# @req REQ-009 REQ-010 REQ-015 REQ-017 NFR-005 NFR-006

use std.spec.*
use std.io_runtime.{file_read}
use std.nogc_sync_mut.io.hal_buffer_dispatch.*

describe "mission-critical caller-owned HAL buffers":
    it "reports typed overflow without truncation":
        val exact = rt_hal_buffer_preflight_v3(32, 32)
        val captured_overflow = rt_hal_buffer_preflight_v3(33, 33)
        val output_overflow = rt_hal_buffer_preflight_v3(16, 15)
        expect(exact.accepted).to_be(true)
        expect(exact.overflow).to_equal(RtHalBufferOverflowV3.None)
        expect(captured_overflow.accepted).to_be(false)
        expect(captured_overflow.overflow).to_equal(
            RtHalBufferOverflowV3.CapturedLength)
        expect(output_overflow.accepted).to_be(false)
        expect(output_overflow.overflow).to_equal(
            RtHalBufferOverflowV3.OutputCapacity)

    it "requires structured error fields and preserves exact status codes":
        expect(rt_hal_buffer_error_v3_well_formed(0, 0, 0, 0)).to_be(true)
        expect(rt_hal_buffer_error_v3_well_formed(0, 1, 7, 0)).to_be(false)
        expect(rt_hal_buffer_error_v3_well_formed(3, 2, -5, 9)).to_be(true)
        expect(rt_hal_buffer_error_v3_well_formed(3, 0, 0, 0)).to_be(false)
        expect(rt_hal_buffer_status_v3(5)).to_equal(
            RtHalBufferStatusV3.Diverged)

    it "keeps old APIs and adds five separately tagged exact-buffer APIs":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_buffer_dispatch.spl")
        val compatibility = file_read(
            "src/lib/nogc_sync_mut/io/process_ops.spl")
        val io_runtime = file_read("src/lib/nogc_sync_mut/io_runtime.spl")
        expect(compatibility).to_contain("pub fn process_read_stdout(pid: i64) -> text:")
        expect(io_runtime).to_contain("pub fn file_read_bytes(path: text) -> [u8]:")
        expect(source).to_contain("operation: io.file.read.buffer_v3")
        expect(source).to_contain("operation: io.stream.read.buffer_v3")
        expect(source).to_contain("operation: io.stream.write.buffer_v3")
        expect(source).to_contain("operation: io.environment.get.buffer_v3")
        expect(source).to_contain("operation: io.random.fill.buffer_v3")

    it "keeps the hot owner bounded and free of dynamic containers":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_buffer_dispatch.spl")
        expect(source).to_contain("RT_HAL_BUFFER_MAX_BYTES_V3: i64 = 32")
        expect(source).to_contain("_rt_hal_buffer_access_issue_instruction_v3")
        expect(source).to_contain("rt_hal_buffer_access_consume_v3")
        expect(source.contains("rt_hal_automatic_access_metadata_v1(")).to_equal(false)
        expect(source.contains(".push(")).to_equal(false)
        expect(source.contains("Dict<")).to_equal(false)
        expect(source.contains("var storage: [")).to_equal(false)
        expect(source.contains("rt_env_get")).to_equal(false)
        expect(source.contains("substring(")).to_equal(false)

    it "requires an actual executed receipt and consumes it exactly once":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_buffer_dispatch.spl")
        val runtime = file_read("src/runtime/runtime_hal_buffer_dispatch.c")
        val selfcheck = file_read(
            "src/runtime/test/runtime_hal_buffer_dispatch_selfcheck.c")
        val extract_begin = source.find("fn _rt_hal_buffer_extract_v3(")
        val extract_end = source.find("@unsafe(reason: \"bounded caller-owned HAL buffer dispatch\"")
        val extract = source.substring(extract_begin, extract_end)
        expect(extract).to_contain("rt_hal_buffer_access_consume_v3")
        expect(extract.contains("rt_hal_automatic_access_metadata_v1")).to_equal(false)
        expect(runtime).to_contain("HAL_ACCESS_ISSUED_V3")
        expect(runtime).to_contain("HAL_ACCESS_READY_V3")
        expect(runtime).to_contain("HAL_ACCESS_CONSUMED_V3")
        expect(runtime).to_contain("HAL_ACCESS_POISONED_V3")
        expect(selfcheck).to_contain("access_consume_winners")
        expect(selfcheck).to_contain("!= 1) return 30")
        expect(selfcheck).to_contain("rt_hal_buffer_access_publish_v3")

    it "executes inside untagged owners before private tagged replay":
        val source = file_read(
            "src/lib/nogc_sync_mut/io/hal_buffer_dispatch.spl")
        val begin = source.find("fn hal_file_read_buffer_executed_v3(")
        val finish = source.find("fn hal_stream_read_buffer_executed_v3(")
        val outer = source.substring(begin, finish)
        expect(source).to_contain("val execution = executor.execute(")
        expect(source).to_contain("val generation = self.issue(")
        expect(source).to_contain("val published = self.publish(")
        expect(outer).to_contain("owner.execute(1001")
        expect(outer).to_contain("hal_file_read_buffer_v3(executed.0")
        expect(outer.contains("execution: EnvExecutionReceiptV1")).to_equal(false)
        expect(source).to_contain("export hal_file_read_buffer_executed_v3")
        expect(source.contains("export hal_file_read_buffer_v3")).to_equal(false)
        expect(source.contains("export rt_hal_file_read_buffer_direct_v3"))
            .to_equal(false)

    it "keeps configured normal socket dispatch on the canonical operation and exact trace shape":
        val simple_source = file_read(
            "src/lib/nogc_sync_mut/io/hal_process_socket_dispatch.spl")
        val runtime_source = file_read(
            "src/runtime/runtime_hal_buffer_dispatch.c")
        val selfcheck = file_read(
            "src/runtime/test/runtime_hal_buffer_dispatch_selfcheck.c")
        expect(simple_source).to_contain(
            "RT_HAL_SOCKET_CONNECT_TIMEOUT_OPERATION_V3: i64 = 1012")
        expect(runtime_source).to_contain(
            "HAL_BUFFER_OPERATION_SOCKET_CONNECT_TIMEOUT_V3 = 1012")
        expect(runtime_source).to_contain(
            "trace_length - trace_cursor != 1")
        expect(selfcheck).to_contain(
            "rt_hal_buffer_dispatch_configured_v3(1012")
        expect(selfcheck).to_contain(
            "rt_hal_buffer_dispatch_configured_v3(1008")
