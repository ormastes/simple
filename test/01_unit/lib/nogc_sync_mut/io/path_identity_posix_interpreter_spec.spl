use std.spec
use std.nogc_sync_mut.io.path_identity.{path_final_existing, path_entry_present}
use std.nogc_sync_mut.fs.host_path.{host_is_windows_host}

# path_identity calls libc directly (malloc/free/realpath/readlink and the
# errno address). The interpreter must bridge those externs to real libc
# rather than fail with `unknown extern function: malloc`. POSIX hosts only:
# Windows takes the Win32 branch (windows_abi) with `\\?\` spellings.
describe "POSIX path identity under the interpreter":
    it "canonicalizes an existing directory through realpath":
        if not host_is_windows_host():
            val r = path_final_existing("src/lib")
            expect(r.is_ok()).to_equal(true)
            expect(r.unwrap().path.ends_with("/src/lib")).to_equal(true)

    it "reports a missing path as an error":
        if not host_is_windows_host():
            expect(path_final_existing("src/lib/__definitely_absent_path_identity__").is_ok()).to_equal(false)

    it "observes entry presence through readlink errno":
        if not host_is_windows_host():
            val root = path_final_existing("src/lib").unwrap().path
            expect(path_entry_present(root + "/nogc_sync_mut/io/path_identity.spl").unwrap()).to_equal(true)
            expect(path_entry_present(root + "/__definitely_absent_path_identity__").unwrap()).to_equal(false)
