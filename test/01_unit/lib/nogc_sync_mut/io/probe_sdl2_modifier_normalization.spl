use std.nogc_sync_mut.io.window_sffi.{sdl2_normalize_modifiers}

fn main() -> i64:
    if (sdl2_normalize_modifiers(0) == 0 and
        sdl2_normalize_modifiers(3) == 1 and
        sdl2_normalize_modifiers(192) == 2 and
        sdl2_normalize_modifiers(768) == 4 and
        sdl2_normalize_modifiers(3072) == 8 and
        sdl2_normalize_modifiers(4035) == 15 and
        sdl2_normalize_modifiers(16) == 0):
        print "SDL2 MODIFIER NORMALIZATION PROBE: PASS"
        return 0
    print "SDL2 MODIFIER NORMALIZATION PROBE: FAIL"
    1
