use std.spec
use std.nogc_sync_mut.io.telnet_serial_bridge.{bridge_rx_pending}
use std.io_runtime.{cwd_process, file_write_bytes, file_delete, time_now_unix_micros}

# Regression for rt_file_read_bytes_declared_with_six_return_types_2026-08-09.
# Exercises the actual capture-file consumer, including unsigned high bytes.
describe "telnet capture-file byte ABI":
    it "widens bytes and preserves missing-file and end-of-file behavior":
        val path = cwd_process() + "/telnet-byte-abi-{time_now_unix_micros()}.bin"
        val payload: [u8] = [0, 1, 127, 128, 254, 255]
        expect(file_write_bytes(path, payload)).to_equal(true)
        expect(bridge_rx_pending(path, 0)).to_equal([0, 1, 127, 128, 254, 255])
        expect(bridge_rx_pending(path, 3)).to_equal([128, 254, 255])
        expect(bridge_rx_pending(path, 6)).to_equal([])
        expect(bridge_rx_pending(path, 9)).to_equal([])
        val empty: [u8] = []
        expect(file_write_bytes(path, empty)).to_equal(true)
        expect(bridge_rx_pending(path, 0)).to_equal([])
        expect(file_delete(path)).to_equal(true)
        expect(bridge_rx_pending(path, 0)).to_equal([])
