use std.spec
use common.io.window_event.{WINDOW_STATUS_OK, WINDOW_STATUS_UNSUPPORTED}
use common.io.window_capability.{
    WINDOW_CAP_MAXIMIZE,
    WINDOW_CAP_POSITION,
}
use std.nogc_sync_mut.io.simple_window.{SimpleWindow}

describe "Simple Window capability errors":
    it "performs supported state changes and rejects unsupported ones":
        var runtime = SimpleWindow.headless(4, 4)
        val window = runtime.create_window("capability", 8, 8)
        expect(runtime.capability(WINDOW_CAP_MAXIMIZE).supported).to_equal(true)
        expect(runtime.maximize_window(window)).to_equal(WINDOW_STATUS_OK)
        expect(runtime.restore_window(window)).to_equal(WINDOW_STATUS_OK)

        val position = runtime.capability(WINDOW_CAP_POSITION)
        expect(position.supported).to_equal(false)
        expect(position.status).to_equal(WINDOW_STATUS_UNSUPPORTED)
        expect(position.reason).to_contain("headless")
        expect(runtime.set_window_position(window, 1, 2)).to_equal(
            WINDOW_STATUS_UNSUPPORTED
        )
