use std.nogc_sync_mut.io.{
    EventLoop,
    Window,
    window_is_fullscreen,
    window_is_maximized,
    window_is_visible,
}

fn main() -> i64:
    val loop = EventLoop(handle: 0, is_valid: false)
    val window = Window(handle: 0, event_loop: loop, is_valid: false)
    if window_is_visible(window).? or window_is_maximized(window).? or window_is_fullscreen(window).?:
        return 1
    0
