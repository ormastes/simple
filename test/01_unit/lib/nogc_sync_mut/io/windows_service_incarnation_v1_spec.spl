use std.spec.*
use std.nogc_sync_mut.io.windows_service_incarnation_v1.{windows_service_incarnation_nonce_encode_v1}

describe "Windows service incarnation nonce formatting":
    it "preserves all 32 bytes with canonical lowercase hex and versioned prefix":
        val bytes: [u8] = [0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8]
        expect(windows_service_incarnation_nonce_encode_v1(bytes).unwrap()).to_equal("windows-service-incarnation-v1:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")

    it "encodes high-bit bytes without sign extension or uppercasing":
        val bytes: [u8] = [255u8; 32]
        expect(windows_service_incarnation_nonce_encode_v1(bytes).unwrap()).to_equal("windows-service-incarnation-v1:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")

    it "rejects empty, truncated and oversized byte arrays":
        expect(windows_service_incarnation_nonce_encode_v1([]).is_err()).to_equal(true)
        expect(windows_service_incarnation_nonce_encode_v1([1u8; 31]).is_err()).to_equal(true)
        expect(windows_service_incarnation_nonce_encode_v1([1u8; 33]).is_err()).to_equal(true)

    it "refuses an unchanged zero entropy sentinel instead of emitting a default nonce":
        expect(windows_service_incarnation_nonce_encode_v1([0u8; 32]).is_err()).to_equal(true)
