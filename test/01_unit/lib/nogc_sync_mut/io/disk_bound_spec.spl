"""Flat cache directories are swept oldest-first past their byte cap."""

use std.spec.*
use std.nogc_sync_mut.io.disk_bound.{disk_bound_enforce, disk_bound_dir_bytes, disk_bound_cap_bytes, disk_bound_mark_used, disk_bound_sweep, disk_bound_keep_newest_dirs, disk_bound_keep_newest_prefix_dirs, disk_bound_dir_is_idle, disk_bound_mark_dir_used}
use app.cli.native_build_parse_closure_owner.{
    native_build_parse_closure_retire_request_v1,
    native_build_parse_closure_teardown_env_v1,
    NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1,
    NATIVE_BUILD_PARSE_CLOSURE_CONSUMER_ENV_V1,
    NATIVE_BUILD_PARSE_CLOSURE_SELECTED_ENV_V1
}
use app.io.env_ops.{env_set, env_unset, env_get}
use compiler.driver.driver_build.incremental.{build_cache_open, build_cache_record_entry, build_cache_record_entry_at, build_cache_persist, build_cache_entry_is_valid_at}
use std.io_runtime.{dir_remove_all, getpid, time_now_unix_micros, file_write, file_exists, file_delete, file_read, dir_create, dir_exists}

fn bound_fixture(label: text) -> text:
    val dir = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_{label}"
    dir_create(dir + "/objects", true)
    dir_create(dir + "/.by-source", true)
    for name in ["a", "b", "c"]:
        file_write(dir + "/objects/" + name, "0123456789")
    file_write(dir + "/.by-source/t.idx", "a\nb\nc\n")
    file_write(dir + "/objects/inflight.tmp", "0123456789")
    dir

describe "disk bound":
    it "sweeps to 75% of the cap once the directory exceeds it":
        val dir = bound_fixture("over")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        expect(disk_bound_enforce(dir, 20)).to_equal(2)
        expect(disk_bound_dir_bytes(dir)).to_equal(10)
        expect(file_exists(dir + "/objects/c")).to_equal(true)
        expect(file_exists(dir + "/.by-source/t.idx")).to_equal(true)
        expect(file_exists(dir + "/objects/inflight.tmp")).to_equal(true)
        dir_remove_all(dir)

    it "leaves a directory at or under the cap alone":
        val dir = bound_fixture("under")
        expect(disk_bound_enforce(dir, 30)).to_equal(0)
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        dir_remove_all(dir)

    it "falls back to the default cap for unset or invalid env":
        expect(disk_bound_cap_bytes("SIMPLE_DISK_BOUND_SPEC_UNSET_CAP", 77)).to_equal(77)

    it "never counts or sweeps another build's candidate receipt":
        val dir = bound_fixture("candidate")
        file_write(dir + "/objects/candidate-123.receipt", "0123456789")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        disk_bound_enforce(dir, 5)
        expect(file_exists(dir + "/objects/candidate-123.receipt")).to_equal(true)
        dir_remove_all(dir)

    it "keeps a recently used entry and evicts colder ones first":
        val dir = bound_fixture("lru")
        # "a" sorts oldest by path on a same-second publish; a hit makes it hot.
        disk_bound_mark_used(dir + "/objects", dir + "/objects/a")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        expect(disk_bound_enforce(dir + "/objects", 20)).to_equal(2)
        expect(file_exists(dir + "/objects/a")).to_equal(true)
        expect(file_exists(dir + "/objects/b")).to_equal(false)
        expect(file_exists(dir + "/objects/c")).to_equal(false)
        dir_remove_all(dir)

    it "drops hit markers whose entry was deleted elsewhere":
        val dir = bound_fixture("orphan")
        disk_bound_mark_used(dir + "/objects", dir + "/objects/gone")
        disk_bound_sweep(dir + "/objects", 1000)
        expect(file_exists(dir + "/objects/.used/gone")).to_equal(false)
        dir_remove_all(dir)

    it "keeps the current scope dir plus the newest others and ignores foreign dirs":
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_scopes"
        for name in ["s0001", "s0002", "s0003", "s0004", "hir", "s01"]:
            dir_create(root + "/" + name + "/obj", true)
            file_write(root + "/" + name + "/obj/x.o", "0123456789")
        expect(disk_bound_keep_newest_dirs(root, "s0001", "s", 5, 2, 0)).to_equal(2)
        expect(file_exists(root + "/s0001/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s0004/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s0002/obj/x.o")).to_equal(false)
        expect(file_exists(root + "/s0003/obj/x.o")).to_equal(false)
        expect(file_exists(root + "/hir/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s01/obj/x.o")).to_equal(true)
        expect(disk_bound_keep_newest_dirs(root, "s0001", "s", 5, 1, 3600)).to_equal(0)
        dir_remove_all(root)

    it "the idle window is inclusive at its edge and never covers a future time":
        # Exactly 21600 s idle is evictable, as before the predicate was split out.
        expect(disk_bound_dir_is_idle(1000000 - 21600, 1000000, 21600)).to_equal(true)
        expect(disk_bound_dir_is_idle(1000000 - 21599, 1000000, 21600)).to_equal(false)
        # A last-use time ahead of the clock (skew, restored tree) is never idle.
        expect(disk_bound_dir_is_idle(1000000 + 1, 1000000, 21600)).to_equal(false)
        expect(disk_bound_dir_is_idle(1000000 + 86400, 1000000, 21600)).to_equal(false)

    it "a scope with a fresh liveness marker is not evictable":
        # Used 1 hour ago, 6 hour window: live. Used 7 hours ago: idle.
        expect(disk_bound_dir_is_idle(1000000 - 3600, 1000000, 21600)).to_equal(false)
        expect(disk_bound_dir_is_idle(1000000 - 25200, 1000000, 21600)).to_equal(true)
        # No window: retention is by count alone.
        expect(disk_bound_dir_is_idle(1000000, 1000000, 0)).to_equal(true)
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_live"
        for name in ["s0001", "s0002", "s0003"]:
            dir_create(root + "/" + name, true)
        expect(disk_bound_mark_dir_used(root + "/s0002")).to_equal(true)
        expect(file_exists(root + "/s0002/.last-use")).to_equal(true)
        expect(disk_bound_mark_dir_used(root + "/absent")).to_equal(false)
        expect(dir_exists(root + "/absent")).to_equal(false)
        expect(disk_bound_keep_newest_dirs(root, "s0001", "s", 5, 1, 21600)).to_equal(0)
        expect(dir_exists(root + "/s0002")).to_equal(true)
        dir_remove_all(root)

    it "evicts oldest variable-length closure-request-* prefix dirs while preserving min_age_s and siblings":
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_prefix"
        val names = [
            "closure-request-1-10",
            "closure-request-20-200",
            "closure-request-300-3000",
            "closure-request-4000-40000"
        ]
        for name in names:
            dir_create(root + "/" + name, true)
            file_write(root + "/" + name + "/request.v1", "req")
        dir_create(root + "/closure-request-", true)
        file_write(root + "/closure-request-/bare", "keep")
        dir_create(root + "/hir", true)
        file_write(root + "/hir/entry.hir", "keep")
        file_write(root + "/closure-request-file-99", "not-a-dir")
        # min_age_s protects active concurrent requests from eviction.
        expect(disk_bound_keep_newest_prefix_dirs(root, "closure-request-", 2, 3600)).to_equal(0)
        expect(dir_exists(root + "/closure-request-1-10")).to_equal(true)
        # With min_age_s == 0, variable-length excess dirs are evicted oldest-first.
        expect(disk_bound_keep_newest_prefix_dirs(root, "closure-request-", 2, 0)).to_equal(2)
        expect(dir_exists(root + "/closure-request-1-10")).to_equal(false)
        expect(dir_exists(root + "/closure-request-20-200")).to_equal(false)
        expect(dir_exists(root + "/closure-request-300-3000")).to_equal(true)
        expect(dir_exists(root + "/closure-request-4000-40000")).to_equal(true)
        expect(file_exists(root + "/closure-request-/bare")).to_equal(true)
        expect(file_exists(root + "/hir/entry.hir")).to_equal(true)
        expect(file_exists(root + "/closure-request-file-99")).to_equal(true)
        expect(disk_bound_keep_newest_prefix_dirs(root, "closure-request-/", 1, 0)).to_equal(0)
        expect(disk_bound_keep_newest_prefix_dirs(root, "closure-request-\\", 1, 0)).to_equal(0)
        dir_remove_all(root)

    it "prunes stale BuildCache rows with missing outputs on both save and load":
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_bcache"
        dir_create(root, true)
        val cache_path = root + "/build_cache.sdn"
        val src_live = root + "/live.spl"
        val out_live = root + "/live.o"
        val src_dead = root + "/dead.spl"
        val out_dead = root + "/dead.o"
        val src_no_out = root + "/source_only.spl"
        file_write(src_live, "pub fn live_fn() -> i64: 1\n")
        file_write(out_live, "obj-live")
        file_write(src_dead, "pub fn dead_fn() -> i64: 2\n")
        file_write(out_dead, "obj-dead")
        file_write(src_no_out, "pub fn source_only_fn() -> i64: 3\n")
        val cache = build_cache_open(cache_path)
        expect(build_cache_record_entry(cache, src_live, [], [out_live])).to_equal(true)
        expect(build_cache_record_entry(cache, src_dead, [], [out_dead])).to_equal(true)
        expect(build_cache_record_entry(cache, src_no_out, [], [])).to_equal(true)
        expect(build_cache_persist(cache)).to_equal(true)
        expect(file_read(cache_path)).to_contain("dead.spl")
        # Save-time pruning: removing dead.o prunes dead.spl on persist while keeping live and empty-output rows.
        expect(file_delete(out_dead)).to_equal(true)
        expect(build_cache_persist(cache)).to_equal(true)
        val after_save = file_read(cache_path)
        expect(after_save.contains("dead.spl")).to_equal(false)
        expect(after_save).to_contain("live.spl")
        expect(after_save).to_contain("source_only.spl")
        expect(build_cache_entry_is_valid_at(cache_path, src_live)).to_equal(true)
        expect(build_cache_entry_is_valid_at(cache_path, src_dead)).to_equal(false)
        # Load-time pruning: record dead.spl again, delete dead.o, load, then restore dead.o before persist.
        file_write(out_dead, "obj-dead-2")
        expect(build_cache_record_entry_at(cache_path, src_dead, [], [out_dead])).to_equal(true)
        expect(file_read(cache_path)).to_contain("dead.spl")
        expect(file_delete(out_dead)).to_equal(true)
        val loaded = build_cache_open(cache_path)
        file_write(out_dead, "obj-dead-restored")
        expect(build_cache_persist(loaded)).to_equal(true)
        expect(file_read(cache_path).contains("dead.spl")).to_equal(false)
        expect(file_read(cache_path)).to_contain("live.spl")
        expect(file_read(cache_path)).to_contain("source_only.spl")
        dir_remove_all(root)

    it "retires current closure-request-* dir after selection.v1 read unless SIMPLE_KEEP_CLOSURE_REQUEST=1":
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_retire"
        val req_dir = root + "/closure-request-777-88888"
        val foreign_dir = root + "/hir"
        dir_create(req_dir, true)
        dir_create(foreign_dir, true)
        file_write(req_dir + "/selection.v1", "selection")
        file_write(req_dir + "/request.v1", "request")
        file_write(foreign_dir + "/selection.v1", "not-a-request")
        expect(env_set(NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1, "1")).to_equal(true)
        expect(native_build_parse_closure_retire_request_v1(req_dir + "/selection.v1")).to_equal(false)
        expect(dir_exists(req_dir)).to_equal(true)
        expect(env_set(NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1, "")).to_equal(true)
        expect(native_build_parse_closure_retire_request_v1(foreign_dir + "/selection.v1")).to_equal(false)
        expect(dir_exists(foreign_dir)).to_equal(true)
        expect(native_build_parse_closure_retire_request_v1(req_dir + "/selection.v1")).to_equal(true)
        expect(dir_exists(req_dir)).to_equal(false)
        dir_remove_all(root)

    it "retires published SIMPLE_PARSE_CLOSURE_REQUEST on coordinator teardown when SIMPLE_KEEP_CLOSURE_REQUEST is unset or 0 and preserves when 1":
        """Verify worker coordinator teardown retires closure-request-* when SIMPLE_KEEP_CLOSURE_REQUEST is unset or 0 and preserves it when 1."""
        step("Preserve closure-request-* when SIMPLE_KEEP_CLOSURE_REQUEST == 1 and retire when 0 or unset")
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_coord_teardown"
        val req_keep = root + "/closure-request-801-11111"
        val req_zero = root + "/closure-request-802-22222"
        val req_unset = root + "/closure-request-803-33333"
        for d in [req_keep, req_zero, req_unset]:
            dir_create(d, true)
            file_write(d + "/selection.v1", "selection")
            file_write(d + "/request.v1", "request")

        # 1) SIMPLE_KEEP_CLOSURE_REQUEST == "1" preserves directory across retire_request_v1("") and teardown_env_v1.
        expect(env_set("SIMPLE_PARSE_CLOSURE_REQUEST", req_keep + "/request.v1")).to_equal(true)
        expect(env_set("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "digest_keep")).to_equal(true)
        expect(env_set(NATIVE_BUILD_PARSE_CLOSURE_CONSUMER_ENV_V1, "1")).to_equal(true)
        expect(env_set(NATIVE_BUILD_PARSE_CLOSURE_SELECTED_ENV_V1, "42")).to_equal(true)
        expect(env_set(NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1, "1")).to_equal(true)
        expect(native_build_parse_closure_retire_request_v1("")).to_equal(false)
        expect(native_build_parse_closure_teardown_env_v1(false)).to_equal(false)
        expect(dir_exists(req_keep)).to_equal(true)
        expect(env_get("SIMPLE_PARSE_CLOSURE_REQUEST") ?? "").to_equal("")

        # 2) Shard child (shard_child_run == true) never deletes sibling-shared closure-request-* on teardown.
        expect(env_set("SIMPLE_PARSE_CLOSURE_REQUEST", req_zero + "/request.v1")).to_equal(true)
        expect(env_set(NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1, "0")).to_equal(true)
        expect(native_build_parse_closure_teardown_env_v1(true)).to_equal(false)
        expect(dir_exists(req_zero)).to_equal(true)

        # 3) SIMPLE_KEEP_CLOSURE_REQUEST == "0" retires closure-request-* via coordinator retire_request_v1("").
        expect(env_set("SIMPLE_PARSE_CLOSURE_REQUEST", req_zero + "/request.v1")).to_equal(true)
        expect(native_build_parse_closure_retire_request_v1("")).to_equal(true)
        expect(dir_exists(req_zero)).to_equal(false)

        # 4) Unset SIMPLE_KEEP_CLOSURE_REQUEST retires closure-request-* on coordinator teardown_env_v1(false).
        env_unset(NATIVE_BUILD_KEEP_CLOSURE_REQUEST_ENV_V1)
        expect(env_set("SIMPLE_PARSE_CLOSURE_REQUEST", req_unset + "/request.v1")).to_equal(true)
        expect(native_build_parse_closure_teardown_env_v1(false)).to_equal(true)
        expect(dir_exists(req_unset)).to_equal(false)
        expect(env_get("SIMPLE_PARSE_CLOSURE_REQUEST") ?? "").to_equal("")
        dir_remove_all(root)
