"""Flat cache directories are swept oldest-first past their byte cap."""

use std.spec.*
use std.nogc_sync_mut.io.disk_bound.{disk_bound_enforce, disk_bound_dir_bytes, disk_bound_cap_bytes, disk_bound_mark_used, disk_bound_sweep, disk_bound_keep_newest_dirs}
use std.io_runtime.{dir_remove_all, getpid, time_now_unix_micros, file_write, file_exists, dir_create}

fn bound_fixture(label: text) -> text:
    val dir = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_{label}"
    dir_create(dir + "/objects", true)
    dir_create(dir + "/.by-source", true)
    for name in ["a", "b", "c"]:
        file_write(dir + "/objects/" + name, "0123456789")
    file_write(dir + "/.by-source/t.idx", "a\nb\nc\n")
    file_write(dir + "/objects/inflight.tmp", "0123456789")
    dir

describe "disk bound":
    it "sweeps to 75% of the cap once the directory exceeds it":
        val dir = bound_fixture("over")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        expect(disk_bound_enforce(dir, 20)).to_equal(2)
        expect(disk_bound_dir_bytes(dir)).to_equal(10)
        expect(file_exists(dir + "/objects/c")).to_equal(true)
        expect(file_exists(dir + "/.by-source/t.idx")).to_equal(true)
        expect(file_exists(dir + "/objects/inflight.tmp")).to_equal(true)
        dir_remove_all(dir)

    it "leaves a directory at or under the cap alone":
        val dir = bound_fixture("under")
        expect(disk_bound_enforce(dir, 30)).to_equal(0)
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        dir_remove_all(dir)

    it "falls back to the default cap for unset or invalid env":
        expect(disk_bound_cap_bytes("SIMPLE_DISK_BOUND_SPEC_UNSET_CAP", 77)).to_equal(77)

    it "never counts or sweeps another build's candidate receipt":
        val dir = bound_fixture("candidate")
        file_write(dir + "/objects/candidate-123.receipt", "0123456789")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        disk_bound_enforce(dir, 5)
        expect(file_exists(dir + "/objects/candidate-123.receipt")).to_equal(true)
        dir_remove_all(dir)

    it "keeps a recently used entry and evicts colder ones first":
        val dir = bound_fixture("lru")
        # "a" sorts oldest by path on a same-second publish; a hit makes it hot.
        disk_bound_mark_used(dir + "/objects", dir + "/objects/a")
        expect(disk_bound_dir_bytes(dir)).to_equal(30)
        expect(disk_bound_enforce(dir + "/objects", 20)).to_equal(2)
        expect(file_exists(dir + "/objects/a")).to_equal(true)
        expect(file_exists(dir + "/objects/b")).to_equal(false)
        expect(file_exists(dir + "/objects/c")).to_equal(false)
        dir_remove_all(dir)

    it "drops hit markers whose entry was deleted elsewhere":
        val dir = bound_fixture("orphan")
        disk_bound_mark_used(dir + "/objects", dir + "/objects/gone")
        disk_bound_sweep(dir + "/objects", 1000)
        expect(file_exists(dir + "/objects/.used/gone")).to_equal(false)
        dir_remove_all(dir)

    it "keeps the current scope dir plus the newest others and ignores foreign dirs":
        val root = "build/disk_bound_{getpid()}_{time_now_unix_micros()}_scopes"
        for name in ["s0001", "s0002", "s0003", "s0004", "hir", "s01"]:
            dir_create(root + "/" + name + "/obj", true)
            file_write(root + "/" + name + "/obj/x.o", "0123456789")
        expect(disk_bound_keep_newest_dirs(root, "s0001", "s", 5, 2, 0)).to_equal(2)
        expect(file_exists(root + "/s0001/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s0004/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s0002/obj/x.o")).to_equal(false)
        expect(file_exists(root + "/s0003/obj/x.o")).to_equal(false)
        expect(file_exists(root + "/hir/obj/x.o")).to_equal(true)
        expect(file_exists(root + "/s01/obj/x.o")).to_equal(true)
        expect(disk_bound_keep_newest_dirs(root, "s0001", "s", 5, 1, 3600)).to_equal(0)
        dir_remove_all(root)
