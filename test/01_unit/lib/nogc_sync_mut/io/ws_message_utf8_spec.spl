use std.spec
use std.nogc_sync_mut.io.ws_client_core.{ws_message_text}

describe "ws client complete-message UTF-8 decode":
    it "decodes a complete multibyte message":
        expect(ws_message_text([99u8, 97u8, 102u8, 195u8, 169u8]).unwrap()).to_equal("caf\u00e9")

    it "rejects invalid or truncated UTF-8 instead of returning text":
        expect(ws_message_text([255u8]).is_err()).to_equal(true)
        expect(ws_message_text([195u8]).is_err()).to_equal(true)
