# @cover src/lib/nogc_sync_mut/gpu/engine2d/cuda_session.spl 60%
# @tag: unit, gpu, engine2d, cuda, session, cache, leak
#
# DEFECT 2 (doc/08_tracking/bug/engine2d_simd_gpu_layer_audit_2026-08-08.md):
# CudaModuleCache is a hand-unrolled 4-slot cache. Past the 4th distinct
# module name, `cache_module()` already returned the literal "cache_full",
# but `CudaSession.load_ptx()` discarded that return value -- so a 5th (and
# every subsequent) distinct name silently re-created a native module handle
# every single call, leaking one native module per call, with no counter and
# no log surfacing it.
#
# Fix: `load_ptx()` now captures the `cache_module()` return and, on
# "cache_full", increments `session.cache_reject_count` and records
# `session.last_cache_rejection` -- making the overflow an OBSERVED,
# counted event instead of a silently-discarded one.
#
# This spec proves the cache class's own reject contract (pure logic, no
# hardware) AND drives the real wiring end-to-end against a real CUDA
# device/PTX module load, so the reject counter is proven to actually
# increment on the production `load_ptx()` path, not just in isolation.

use std.spec
use std.nogc_sync_mut.gpu.engine2d.cuda_session.{CudaSession, CudaModuleCache}
use std.nogc_sync_mut.fs.{read_text}

val PTX_PATH = "/tmp/claude-1000/-home-ormastes-dev-pub-simple/c934f8cd-84cf-4f01-9641-785d405efded/scratchpad/simple_noop.ptx"

describe "CudaModuleCache overflow contract (pure, no hardware)":

    it "rejects a 5th distinct name and leaves the first 4 slots intact":
        var cache = CudaModuleCache.create()

        assert_equal(cache.cache_module("k0", 100), "ok")
        assert_equal(cache.cache_module("k1", 101), "ok")
        assert_equal(cache.cache_module("k2", 102), "ok")
        assert_equal(cache.cache_module("k3", 103), "ok")
        assert_equal(cache.cache_module("k4", 104), "cache_full")

        assert_equal(cache.count, 4)
        assert_equal(cache.find_module("k0"), 100)
        assert_equal(cache.find_module("k1"), 101)
        assert_equal(cache.find_module("k2"), 102)
        assert_equal(cache.find_module("k3"), 103)
        # k4 was never stored -- a lookup for it must fail closed (0), not
        # silently pretend it was cached.
        assert_equal(cache.find_module("k4"), 0)

describe "CudaSession.load_ptx overflow is an observed, counted event":

    it "counts the 5th distinct module name as a rejection instead of discarding it":
        val source = read_text(PTX_PATH)
        var session = CudaSession.create(0, "managed")
        val init_result = session.init_context()
        assert_equal(init_result, "ok")

        assert_equal(session.cache_reject_count_get(), 0)

        val h0 = session.load_ptx("mod0", source)
        val h1 = session.load_ptx("mod1", source)
        val h2 = session.load_ptx("mod2", source)
        val h3 = session.load_ptx("mod3", source)
        assert_true(h0 != 0)
        assert_true(h1 != 0)
        assert_true(h2 != 0)
        assert_true(h3 != 0)
        assert_equal(session.cache_reject_count_get(), 0)

        # 5th distinct name: the underlying native module load still
        # succeeds (real hardware handle returned, that half of the leak is
        # unavoidable without an eviction policy) but the cache overflow
        # must now be observed and counted, not silently dropped.
        val h4 = session.load_ptx("mod4", source)
        assert_true(h4 != 0)
        assert_equal(session.cache_reject_count_get(), 1)
        assert_equal(session.last_cache_rejection_get(), "module:mod4")

        # A 6th distinct name must keep counting, not saturate at 1.
        val h5 = session.load_ptx("mod5", source)
        assert_true(h5 != 0)
        assert_equal(session.cache_reject_count_get(), 2)
        assert_equal(session.last_cache_rejection_get(), "module:mod5")

        # Re-requesting an already-cached name (mod0..mod3) is still a real
        # cache hit and must NOT add to the reject count.
        val h0_again = session.load_ptx("mod0", source)
        assert_equal(h0_again, h0)
        assert_equal(session.cache_reject_count_get(), 2)

        session.release_context()
