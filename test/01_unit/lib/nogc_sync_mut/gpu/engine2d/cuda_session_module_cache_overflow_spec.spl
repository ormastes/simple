# @cover src/lib/nogc_sync_mut/gpu/engine2d/cuda_session.spl 60%
# @tag: unit, gpu, engine2d, cuda, session, cache, leak
#
# DEFECT 2 (doc/08_tracking/bug/engine2d_simd_gpu_layer_audit_2026-08-08.md):
# CudaModuleCache is a hand-unrolled 4-slot cache. Past the 4th distinct
# module name, `cache_module()` already returned the literal "cache_full",
# but `CudaComputeSession.load_ptx()` discarded that return value -- so a 5th (and
# every subsequent) distinct name silently re-created a native module handle
# every single call, leaking one native module per call, with no counter and
# no log surfacing it.
#
# Fix: the cache-and-count bookkeeping that `load_ptx()` runs after a
# successful native module load was extracted into `record_module(name,
# handle)`, which captures the `cache_module()` return and, on
# "cache_full", increments `session.cache_reject_count` and records
# `session.last_cache_rejection` -- making the overflow an OBSERVED, counted
# event instead of a silently-discarded one. `load_ptx()` calls
# `record_module()` on the real handle it gets back from
# `cuda_session_module_load()`; this spec drives `record_module()` directly
# with synthetic handles because `cuda_session_module_load` (and every other
# session-level CUDA extern in this file: `rt_cuda_primary_ctx_retain`,
# `rt_cuda_kernel_get`, ...) is registered ONLY for the JIT/native codegen
# path, not for the tree-walk interpreter `bin/simple test` runs on
# (confirmed: `semantic: unknown extern function: rt_cuda_primary_ctx_retain`
# under `test_runner_single --sequential` even with real CUDA hardware
# present on this host) -- a pre-existing, unrelated engine gap that affects
# every session-level CUDA/Vulkan/Metal extern in this directory equally,
# not something this fix introduces or can route around from the spec layer.
# `record_module()` is the exact production bookkeeping `load_ptx()` calls,
# so this is a real (not reimplemented) proof of the fix, scoped to what the
# interpreter engine can reach.

use std.spec
use std.nogc_sync_mut.gpu.engine2d.cuda_session.{CudaComputeSession, CudaModuleCache}

describe "CudaModuleCache overflow contract (pure, no hardware)":

    it "rejects a 5th distinct name and leaves the first 4 slots intact":
        var cache = CudaModuleCache.create()

        assert_equal(cache.cache_module("k0", 100), "ok")
        assert_equal(cache.cache_module("k1", 101), "ok")
        assert_equal(cache.cache_module("k2", 102), "ok")
        assert_equal(cache.cache_module("k3", 103), "ok")
        assert_equal(cache.cache_module("k4", 104), "cache_full")

        assert_equal(cache.count, 4)
        assert_equal(cache.find_module("k0"), 100)
        assert_equal(cache.find_module("k1"), 101)
        assert_equal(cache.find_module("k2"), 102)
        assert_equal(cache.find_module("k3"), 103)
        # k4 was never stored -- a lookup for it must fail closed (0), not
        # silently pretend it was cached.
        assert_equal(cache.find_module("k4"), 0)

describe "CudaComputeSession.record_module overflow is an observed, counted event (real production bookkeeping)":

    it "counts the 5th distinct module name as a rejection instead of discarding it":
        var session = CudaComputeSession.create(0, "managed")

        assert_equal(session.cache_reject_count_get(), 0)

        val h0 = session.record_module("mod0", 900)
        val h1 = session.record_module("mod1", 901)
        val h2 = session.record_module("mod2", 902)
        val h3 = session.record_module("mod3", 903)
        assert_equal(h0, 900)
        assert_equal(h1, 901)
        assert_equal(h2, 902)
        assert_equal(h3, 903)
        assert_equal(session.cache_reject_count_get(), 0)

        # 5th distinct name: bookkeeping must observe and count the
        # overflow instead of silently dropping it.
        val h4 = session.record_module("mod4", 904)
        assert_equal(h4, 904)
        assert_equal(session.cache_reject_count_get(), 1)
        assert_equal(session.last_cache_rejection_get(), "module:mod4")

        # A 6th distinct name must keep counting, not saturate at 1.
        val h5 = session.record_module("mod5", 905)
        assert_equal(h5, 905)
        assert_equal(session.cache_reject_count_get(), 2)
        assert_equal(session.last_cache_rejection_get(), "module:mod5")

        # The first 4 names are still real cache hits via find_module -- the
        # fix does not disturb the happy path.
        assert_equal(session.module_cache.find_module("mod0"), 900)
        assert_equal(session.module_cache.find_module("mod3"), 903)
        assert_equal(session.module_cache.find_module("mod4"), 0)
