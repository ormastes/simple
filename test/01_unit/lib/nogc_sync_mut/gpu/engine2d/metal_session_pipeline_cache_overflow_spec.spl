# @cover src/lib/nogc_sync_mut/gpu/engine2d/metal_session.spl 60%
# @tag: unit, gpu, engine2d, metal, session, cache, leak
#
# DEFECT 2 (doc/08_tracking/bug/engine2d_simd_gpu_layer_audit_2026-08-08.md):
# same hand-unrolled 4-slot cache shape as CudaModuleCache, for Metal
# compute pipelines. `MetalComputeSession.get_or_create_pipeline()` discarded the
# `cache_pipeline()` return value past the 4th distinct name.
#
# Fix: `get_or_create_pipeline()` now captures the return and, on a non-empty
# ("full") result, increments `session.cache_reject_count` and records
# `session.last_cache_rejection`.
#
# Metal needs real macOS hardware this host does not have, so
# `MetalComputeSession.init_device()`/`get_or_create_pipeline()` cannot be driven
# end-to-end here. This spec proves the pure `MetalPipelineCache` reject
# contract directly (no hardware dependency) -- the same class whose
# discarded return value was the defect -- and drives the extracted
# `record_pipeline(name, handle)` bookkeeping (the exact code
# `get_or_create_pipeline()` calls on a real handle) with synthetic handles.

use std.spec
use std.nogc_sync_mut.gpu.engine2d.metal_session.{MetalComputeSession, MetalPipelineCache}

describe "MetalPipelineCache overflow contract (pure, no hardware)":

    it "rejects a 5th distinct pipeline name and leaves the first 4 slots intact":
        var cache = MetalPipelineCache.create()

        assert_equal(cache.cache_pipeline("p0", 200), "")
        assert_equal(cache.cache_pipeline("p1", 201), "")
        assert_equal(cache.cache_pipeline("p2", 202), "")
        assert_equal(cache.cache_pipeline("p3", 203), "")
        assert_equal(cache.cache_pipeline("p4", 204), "pipeline cache full (max 4)")

        assert_equal(cache.count, 4)
        assert_equal(cache.find_pipeline("p0"), 200)
        assert_equal(cache.find_pipeline("p1"), 201)
        assert_equal(cache.find_pipeline("p2"), 202)
        assert_equal(cache.find_pipeline("p3"), 203)
        assert_equal(cache.find_pipeline("p4"), 0)

describe "MetalComputeSession.record_pipeline overflow is an observed, counted event (real production bookkeeping)":

    it "counts the 5th distinct pipeline name as a rejection instead of discarding it":
        var session = MetalComputeSession.create("compute")

        assert_equal(session.cache_reject_count_get(), 0)

        session.record_pipeline("p0", 800)
        session.record_pipeline("p1", 801)
        session.record_pipeline("p2", 802)
        session.record_pipeline("p3", 803)
        assert_equal(session.cache_reject_count_get(), 0)

        session.record_pipeline("p4", 804)
        assert_equal(session.cache_reject_count_get(), 1)
        assert_equal(session.last_cache_rejection_get(), "pipeline:p4")

        session.record_pipeline("p5", 805)
        assert_equal(session.cache_reject_count_get(), 2)
        assert_equal(session.last_cache_rejection_get(), "pipeline:p5")

        assert_equal(session.pipeline_cache.find_pipeline("p0"), 800)
        assert_equal(session.pipeline_cache.find_pipeline("p4"), 0)
