# @cover src/lib/nogc_sync_mut/gpu/engine2d/metal_session.spl 60%
# @tag: unit, gpu, engine2d, metal, session, cache, leak
#
# DEFECT 2 (doc/08_tracking/bug/engine2d_simd_gpu_layer_audit_2026-08-08.md):
# same hand-unrolled 4-slot cache shape as CudaModuleCache, for Metal
# compute pipelines. `MetalSession.get_or_create_pipeline()` discarded the
# `cache_pipeline()` return value past the 4th distinct name.
#
# Fix: `get_or_create_pipeline()` now captures the return and, on a non-empty
# ("full") result, increments `session.cache_reject_count` and records
# `session.last_cache_rejection`.
#
# Metal is macOS-only (`rt_metal_is_available()` fails closed on Linux), so
# `MetalSession.init_device()` cannot be driven end-to-end on this host. This
# spec proves the pure `MetalPipelineCache` reject contract directly (no
# hardware dependency) -- the same class whose discarded return value was the
# defect -- and separately proves `init_device()` fails closed off-macOS
# rather than silently pretending to succeed.

use std.spec
use std.nogc_sync_mut.gpu.engine2d.metal_session.{MetalSession, MetalPipelineCache}

describe "MetalPipelineCache overflow contract (pure, no hardware)":

    it "rejects a 5th distinct pipeline name and leaves the first 4 slots intact":
        var cache = MetalPipelineCache.create()

        assert_equal(cache.cache_pipeline("p0", 200), "")
        assert_equal(cache.cache_pipeline("p1", 201), "")
        assert_equal(cache.cache_pipeline("p2", 202), "")
        assert_equal(cache.cache_pipeline("p3", 203), "")
        assert_equal(cache.cache_pipeline("p4", 204), "pipeline cache full (max 4)")

        assert_equal(cache.count, 4)
        assert_equal(cache.find_pipeline("p0"), 200)
        assert_equal(cache.find_pipeline("p1"), 201)
        assert_equal(cache.find_pipeline("p2"), 202)
        assert_equal(cache.find_pipeline("p3"), 203)
        assert_equal(cache.find_pipeline("p4"), 0)

describe "MetalSession off-macOS gate (no hardware available on this host)":

    it "fails closed on init_device() instead of pretending a device exists":
        var session = MetalSession.create("compute")
        val err = session.init_device()

        assert_equal(err, "Metal requires macOS")
        assert_equal(session.initialized, false)
        assert_equal(session.cache_reject_count_get(), 0)
