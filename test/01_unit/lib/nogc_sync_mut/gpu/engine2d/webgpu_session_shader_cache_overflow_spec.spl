# @cover src/lib/nogc_sync_mut/gpu/engine2d/webgpu_session.spl 50%
# @tag: unit, gpu, engine2d, webgpu, session, cache, leak
#
# `WebGpuSession` is intentionally a pure bounded shader-cache owner. This
# suite proves its overflow accounting and cache identity behavior; it does
# not exercise a foreign WebGPU provider.

use std.spec
use std.nogc_sync_mut.gpu.engine2d.webgpu_session.{WebGpuSession, WebGpuShaderCache}

describe "WebGpuShaderCache overflow contract (pure, no hardware)":

    it "rejects a 5th distinct WGSL source and leaves the first 4 slots intact":
        var cache = WebGpuShaderCache.create()

        assert_equal(cache.cache_shader("@compute fn a() {}", 300), "ok")
        assert_equal(cache.cache_shader("@compute fn b() {}", 301), "ok")
        assert_equal(cache.cache_shader("@compute fn c() {}", 302), "ok")
        assert_equal(cache.cache_shader("@compute fn d() {}", 303), "ok")
        assert_equal(cache.cache_shader("@compute fn e() {}", 304), "cache_full")

        assert_equal(cache.count, 4)
        assert_equal(cache.find_shader("@compute fn a() {}"), 300)
        assert_equal(cache.find_shader("@compute fn b() {}"), 301)
        assert_equal(cache.find_shader("@compute fn c() {}"), 302)
        assert_equal(cache.find_shader("@compute fn d() {}"), 303)
        # The 5th source was never stored -- a lookup must fail closed (0).
        assert_equal(cache.find_shader("@compute fn e() {}"), 0)

describe "WebGpuSession.record_shader overflow is an observed, counted cache event":

    it "counts the 5th distinct WGSL source as a rejection instead of discarding it":
        var session = WebGpuSession.create("auto")

        assert_equal(session.cache_reject_count_get(), 0)

        val h0 = session.record_shader("wgsl0", 800)
        val h1 = session.record_shader("wgsl1", 801)
        val h2 = session.record_shader("wgsl2", 802)
        val h3 = session.record_shader("wgsl3", 803)
        assert_equal(h0, 800)
        assert_equal(h1, 801)
        assert_equal(h2, 802)
        assert_equal(h3, 803)
        assert_equal(session.cache_reject_count_get(), 0)

        # 5th distinct source: bookkeeping must observe and count the overflow.
        val h4 = session.record_shader("wgsl4", 804)
        assert_equal(h4, 804)
        assert_equal(session.cache_reject_count_get(), 1)
        assert_equal(session.last_cache_rejection_get(), "shader:wgsl4")

        # A 6th distinct source must keep counting, not saturate at 1.
        val h5 = session.record_shader("wgsl5", 805)
        assert_equal(h5, 805)
        assert_equal(session.cache_reject_count_get(), 2)
        assert_equal(session.last_cache_rejection_get(), "shader:wgsl5")

        # The first 4 sources remain real cache hits -- the bound does not
        # disturb the happy path that makes the cache worth having.
        assert_equal(session.shader_cache.find_shader("wgsl0"), 800)
        assert_equal(session.shader_cache.find_shader("wgsl3"), 803)
        assert_equal(session.shader_cache.find_shader("wgsl4"), 0)
