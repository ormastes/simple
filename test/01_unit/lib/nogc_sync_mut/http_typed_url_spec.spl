use std.nogc_sync_mut.net.http.{HttpClient, Url, get, get_url}

describe "HTTP typed Url entry points":
    it "text facade rejects an invalid URL before any transport":
        val client = HttpClient.new()
        match client.get("not a url"):
            Ok(_): fail("invalid URL accepted")
            Err(_): expect(true).to_equal(true)

    it "module-level text get rejects an invalid URL":
        match get(""):
            Ok(_): fail("empty URL accepted")
            Err(_): expect(true).to_equal(true)

    it "Url.parse reports errors for non-absolute URLs":
        match Url.parse("/relative/only"):
            Ok(_): fail("relative URL parsed")
            Err(_): expect(true).to_equal(true)

    it "typed entry accepts a parsed Url":
        match Url.parse("http://127.0.0.1:1/x"):
            Ok(url):
                match get_url(url):
                    Ok(_): expect(true).to_equal(true)
                    Err(_): expect(true).to_equal(true)
            Err(_): fail("valid URL rejected")
