use std.spec.*
use std.nogc_sync_mut.spec.{_execute_it}

# skip() inside an it body must count as skipped, never as passed.
# Bug: doc/08_tracking/bug/spec_skip_reported_as_pass_2026-11-19.md
# _execute_it is the spec.spl example runner (the self-hosted and aggregate
# path); the seed's native `it` does not go through it, so drive it directly.
describe "skip() inside an it body":
    it "reports the example as skip, not pass":
        # @req REQ-SSPEC-LIB
        val outcome = _execute_it("gated example", \:
            skip("gated example", "needs a live model")
        )
        expect(outcome).to_equal("skip")

    it "keeps skip winning over a later pass":
        # @req REQ-SSPEC-LIB
        val outcome = _execute_it("gated then return", \:
            skip("gated then return", "needs a live model")
            return
        )
        expect(outcome).to_equal("skip")

    it "still reports an ordinary example as pass":
        # @req REQ-SSPEC-LIB
        val outcome = _execute_it("plain example", \:
            expect(1).to_equal(1)
        )
        expect(outcome).to_equal("pass")
