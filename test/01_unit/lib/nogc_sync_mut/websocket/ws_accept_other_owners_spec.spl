# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# @bug ws_accept_hash_sha1_bytes_reencoded_utf8_before_base64_2026_11_10

"""
# RFC 6455 Sec-WebSocket-Accept in the remaining GUID copies

Pins the RFC §1.3 example through `ws_crypto.compute_accept_key` and
`ws_handshake.ws_compute_accept_key`; both base64 the raw digest bytes.
"""

use std.spec
use std.spec.step
use std.gc_async_mut.gpu.browser_engine.net.ws_crypto.{compute_accept_key}
use std.nogc_sync_mut.http.ws.ws_handshake.{ws_compute_accept_key}

val RFC_KEY = "dGhlIHNhbXBsZSBub25jZQ=="
val RFC_ACCEPT = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="

describe "RFC 6455 accept value, other owners":
    it "browser_engine ws_crypto matches the RFC example":
        step("ws_crypto accept")
        expect(compute_accept_key(RFC_KEY)).to_equal(RFC_ACCEPT)

    it "http ws_handshake matches the RFC example":
        step("ws_handshake accept")
        expect(ws_compute_accept_key(RFC_KEY)).to_equal(RFC_ACCEPT)
