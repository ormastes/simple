# @cover src/lib/nogc_sync_mut/baremetal/transport/dedicated_hw.spl 40%
# @tag: unit, baremetal, serial, sffi, safety

use std.spec
use std.nogc_sync_mut.baremetal.transport.dedicated_hw.DedicatedHwTransport

describe "DedicatedHwTransport serial admission contract":

    it "fails closed when a caller requests the removed providerless availability probe":
        val transport = DedicatedHwTransport(
            device: "/dev/ttyS0",
            baud_rate: 115200,
            fd: 7,
            connected: true
        )

        match transport.available():
            case Err(message):
                assert_equal(message, "serial availability is not part of the admitted serial SFFI contract")
            case Ok(_):
                assert_equal(true, false)
