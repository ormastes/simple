use std.common.trace.observer_contract_v1.*
use std.nogc_sync_mut.trace.xray_llvm_adapter_v1.*

# Fake compiler-rt leaf. The real leaf (xray_llvm_host_leaf_v1) binds the C
# boundary in src/runtime/xray/; native evidence is
# scripts/check/check-xray-llvm-adapter-e2e.shs. This spec pins the control
# plane: selection -> LLVM id translation, quiescent ordering, fail-closed
# status mapping and rollback, with no executable memory touched.
class FakeXrayLeafV1:
    max_id: i64
    install_status: i64
    fail_patch_id: i64
    fail_patch_status: i64
    fail_unpatch_id: i64
    log: [text]
    patched: [i64]

impl XrayLlvmLeafV1 for FakeXrayLeafV1:
    fn max_function_id() -> i64:
        self.max_id

    me install(arena: i64, generation: u64, context: u64, module_instance: u64) -> i64:
        self.log.push("install:{arena}:{generation}")
        self.install_status

    me patch_function(id: i64) -> i64:
        self.log.push("patch:{id}")
        if id == self.fail_patch_id: return self.fail_patch_status
        self.patched.push(id)
        XRAY_LLVM_STATUS_SUCCESS_V1

    me unpatch_function(id: i64) -> i64:
        self.log.push("unpatch:{id}")
        if id == self.fail_unpatch_id: return XRAY_LLVM_STATUS_FAILED_V1
        var kept: [i64] = []
        for current in self.patched:
            if current != id: kept.push(current)
        self.patched = kept
        XRAY_LLVM_STATUS_SUCCESS_V1

fn fake_leaf_v1(max_id: i64) -> FakeXrayLeafV1:
    FakeXrayLeafV1(max_id: max_id, install_status: 1, fail_patch_id: 0,
        fail_patch_status: XRAY_LLVM_STATUS_FAILED_V1, fail_unpatch_id: 0,
        log: [], patched: [])

fn dynamic_config_v1() -> TraceConfigV1:
    TraceConfigV1(instrumentation: TraceInstrumentationV1.Dynamic,
        backend: TraceBackendV1.Llvm, consistency: TraceConsistencyV1.RawEdges,
        patch_mode: TracePatchModeV1.Quiescent, abi_profile: "linux-aarch64-llvm-xray",
        event_mask: 7, buffer_bytes: 98304, max_contexts: 1, max_depth: 128,
        max_resident_generations: 8)

fn selection_v1(sites: [u32]) -> TraceSelectionV1:
    var out: [TraceSiteV1] = []
    for site in sites:
        out.push(TraceSiteV1(module_instance: 1, site_id: site))
    TraceSelectionV1(manifest_incarnation: 1, sites: out)

fn failure_code_v1(result: Result<TracePreparedV1, TraceFailureV1>) -> u32:
    match result:
        case Ok(_): 0
        case Err(failure): trace_failure_code_v1(failure)

describe "Linux LLVM XRay adapter V1 (stage 1 control plane)":
    it "maps compiler-rt patching statuses to stable failure classes":
        expect(trace_failure_code_v1(xray_llvm_status_failure_v1(XRAY_LLVM_STATUS_NOT_INITIALIZED_V1))).to_equal(4)
        expect(trace_failure_code_v1(xray_llvm_status_failure_v1(XRAY_LLVM_STATUS_ONGOING_V1))).to_equal(6)
        expect(trace_failure_code_v1(xray_llvm_status_failure_v1(XRAY_LLVM_STATUS_FAILED_V1))).to_equal(9)
        expect(trace_failure_code_v1(xray_llvm_status_failure_v1(XRAY_LLVM_STATUS_INVALID_ID_V1))).to_equal(5)
        expect(trace_failure_code_v1(xray_llvm_status_failure_v1(77))).to_equal(9)

    it "translates a selected site to an LLVM id only inside the instrumented map":
        expect(xray_llvm_site_id_v1(TraceSiteV1(module_instance: 1, site_id: 3), 1, 3).unwrap()).to_equal(3)
        expect(xray_llvm_site_id_v1(TraceSiteV1(module_instance: 1, site_id: 4), 1, 3).is_err()).to_equal(true)
        expect(xray_llvm_site_id_v1(TraceSiteV1(module_instance: 1, site_id: 0), 1, 3).is_err()).to_equal(true)
        expect(xray_llvm_site_id_v1(TraceSiteV1(module_instance: 2, site_id: 1), 1, 3).is_err()).to_equal(true)

    it "rejects an unknown function id before anything is patched":
        val leaf = fake_leaf_v1(3)
        var adapter = XrayLlvmAdapterV1.create(1)
        expect(failure_code_v1(adapter.prepare(leaf, dynamic_config_v1(), selection_v1([1, 9])))).to_equal(5)
        expect(failure_code_v1(adapter.prepare(leaf, dynamic_config_v1(), selection_v1([2, 2])))).to_equal(5)
        expect(failure_code_v1(adapter.prepare(leaf, dynamic_config_v1(), selection_v1([])))).to_equal(5)
        expect(leaf.log.len()).to_equal(0)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_IDLE_V1)

    it "refuses absent instrumentation, other backends and unqualified modes":
        var adapter = XrayLlvmAdapterV1.create(1)
        expect(failure_code_v1(adapter.prepare(fake_leaf_v1(0), dynamic_config_v1(), selection_v1([1])))).to_equal(4)
        var off = dynamic_config_v1()
        off.instrumentation = TraceInstrumentationV1.Off
        expect(failure_code_v1(adapter.prepare(fake_leaf_v1(3), off, selection_v1([1])))).to_equal(4)
        var simple_backend = dynamic_config_v1()
        simple_backend.backend = TraceBackendV1.Simple
        expect(failure_code_v1(adapter.prepare(fake_leaf_v1(3), simple_backend, selection_v1([1])))).to_equal(1)
        var live = dynamic_config_v1()
        live.patch_mode = TracePatchModeV1.Live
        expect(failure_code_v1(adapter.prepare(fake_leaf_v1(3), live, selection_v1([1])))).to_equal(3)
        var paired = dynamic_config_v1()
        paired.consistency = TraceConsistencyV1.PairedSpans
        expect(failure_code_v1(adapter.prepare(fake_leaf_v1(3), paired, selection_v1([1])))).to_equal(3)

    it "installs the handler before patching only the selected functions":
        val leaf = fake_leaf_v1(4)
        var adapter = XrayLlvmAdapterV1.create(1)
        val prepared = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([3, 1])).unwrap()
        expect(leaf.log.len()).to_equal(0)
        val session = adapter.start(leaf, prepared, 4096).unwrap()
        expect(session.generation).to_equal(prepared.incarnation)
        expect(leaf.log[0]).to_equal("install:4096:{prepared.incarnation}")
        expect(leaf.log[1]).to_equal("patch:3")
        expect(leaf.log[2]).to_equal("patch:1")
        expect(leaf.patched.len()).to_equal(2)
        expect(adapter.patched_ids().len()).to_equal(2)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_ACTIVE_V1)
        # One serialized owner: a second selection while active is Busy.
        expect(failure_code_v1(adapter.prepare(leaf, dynamic_config_v1(), selection_v1([2])))).to_equal(6)

    it "unpatches on stop and re-patches a new generation":
        val leaf = fake_leaf_v1(4)
        var adapter = XrayLlvmAdapterV1.create(1)
        val first = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([2])).unwrap()
        val session = adapter.start(leaf, first, 4096).unwrap()
        expect(adapter.request_stop(leaf, session).unwrap() == TraceSessionStateV1.Drained).to_equal(true)
        expect(leaf.patched.len()).to_equal(0)
        expect(adapter.patched_ids().len()).to_equal(0)
        # Idempotent stop.
        expect(adapter.request_stop(leaf, session).unwrap() == TraceSessionStateV1.Drained).to_equal(true)
        val second = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([2, 4])).unwrap()
        expect(second.incarnation > first.incarnation).to_equal(true)
        val again = adapter.start(leaf, second, 8192).unwrap()
        expect(leaf.patched.len()).to_equal(2)
        # A stale handle from the earlier generation is rejected.
        expect(adapter.request_stop(leaf, session).is_err()).to_equal(true)
        expect(adapter.request_stop(leaf, again).is_ok()).to_equal(true)

    it "rolls back a partial patch failure and reports it":
        var leaf = fake_leaf_v1(4)
        leaf.fail_patch_id = 3
        var adapter = XrayLlvmAdapterV1.create(1)
        val prepared = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([1, 2, 3, 4])).unwrap()
        match adapter.start(leaf, prepared, 4096):
            case Ok(_): expect("started").to_equal("rolled back")
            case Err(failure): expect(trace_failure_code_v1(failure)).to_equal(9)
        expect(leaf.patched.len()).to_equal(0)
        expect(leaf.log.contains("patch:4")).to_equal(false)
        expect(leaf.log.contains("unpatch:2")).to_equal(true)
        expect(leaf.log.contains("unpatch:1")).to_equal(true)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_IDLE_V1)

    it "faults closed when rollback itself fails and never reports off":
        var leaf = fake_leaf_v1(4)
        leaf.fail_patch_id = 3
        leaf.fail_unpatch_id = 1
        var adapter = XrayLlvmAdapterV1.create(1)
        val prepared = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([1, 2, 3])).unwrap()
        expect(adapter.start(leaf, prepared, 4096).is_err()).to_equal(true)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_FAULTED_V1)
        expect(adapter.patched_ids().len()).to_equal(1)
        expect(adapter.patched_ids()[0]).to_equal(1)
        expect(failure_code_v1(adapter.prepare(leaf, dynamic_config_v1(), selection_v1([2])))).to_equal(9)

    it "refuses to start when the handler cannot be installed":
        var leaf = fake_leaf_v1(4)
        leaf.install_status = 0
        var adapter = XrayLlvmAdapterV1.create(1)
        val prepared = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([1])).unwrap()
        expect(adapter.start(leaf, prepared, 4096).is_err()).to_equal(true)
        expect(leaf.log.contains("patch:1")).to_equal(false)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_IDLE_V1)
        expect(adapter.start(leaf, prepared, 0).is_err()).to_equal(true)

    it "faults closed when an unpatch fails during stop":
        var leaf = fake_leaf_v1(4)
        var adapter = XrayLlvmAdapterV1.create(1)
        val prepared = adapter.prepare(leaf, dynamic_config_v1(), selection_v1([1, 2])).unwrap()
        val session = adapter.start(leaf, prepared, 4096).unwrap()
        leaf.fail_unpatch_id = 2
        expect(adapter.request_stop(leaf, session).is_err()).to_equal(true)
        expect(adapter.state_code()).to_equal(XRAY_LLVM_STATE_FAULTED_V1)
        expect(adapter.patched_ids().len()).to_equal(1)
        expect(adapter.patched_ids()[0]).to_equal(2)
