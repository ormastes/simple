use std.spec.{describe, it, assert_equal}
use std.tls.utilities.{byte_at, slice, append, len}

# Regression for doc/08_tracking/bug/byte_at_reads_zero_from_slice_result_2026-07-28.md
#
# `append`/`len` in _TlsUtilities/text_ops.spl were placeholder stubs — `append`
# returned the list unchanged and `len` returned 0 — so `slice()` (which builds
# its result with `append`) always came back empty, and every `byte_at()` on a
# sliced range read 0. `byte_at`/`slice` were also untyped, so their results were
# erased to Any and zeroed at the call boundary.

# 11 bytes; bytes 6..11 are the ALPN payload [0, 3, 2, 'h', '2'].
fn wire_block() -> [i64]:
    [9, 9, 9, 9, 9, 9, 0, 3, 2, 104, 50]

describe "TLS utilities slice/byte_at round-trip":
    it "appends an item instead of dropping it":
        val grown: [i64] = append([1, 2], 3)
        assert_equal(grown.len(), 3)
        assert_equal(byte_at(grown, 2), 3)

    it "reports the real collection length":
        assert_equal(len(wire_block()), 11)

    it "reads bytes out of the source array":
        assert_equal(byte_at(wire_block(), 9), 104)
        assert_equal(byte_at(wire_block(), 10), 50)

    it "produces a slice of the requested length":
        val s: [i64] = slice(wire_block(), 6, 11)
        assert_equal(s.len(), 5)

    it "reads the sliced bytes back, not zeros":
        val s: [i64] = slice(wire_block(), 6, 11)
        assert_equal(byte_at(s, 0), 0)
        assert_equal(byte_at(s, 1), 3)
        assert_equal(byte_at(s, 2), 2)
        assert_equal(byte_at(s, 3), 104)
        assert_equal(byte_at(s, 4), 50)

    it "decodes a big-endian u16 out of a sliced range":
        val s: [i64] = slice(wire_block(), 7, 11)
        assert_equal((byte_at(s, 0) * 256) + byte_at(s, 1), 770)

    it "clamps an out-of-range end to the source length":
        val s: [i64] = slice(wire_block(), 9, 99)
        assert_equal(s.len(), 2)
        assert_equal(byte_at(s, 0), 104)
