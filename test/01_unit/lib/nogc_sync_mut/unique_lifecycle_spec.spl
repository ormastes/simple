# @req AC-OWN-01
# Synchronous library handle lifecycle, independently of compiler heap lowering.
use std.spec
use std.spec.step
use std.nogc_sync_mut.ptr.unique.{unique_new, unique_reset, unique_get, unique_try_get, unique_is_valid, unique_move, unique_drop, unique_release, unique_into_inner}

describe "authoritative unique handle lifecycle":
    it "invalidates all source copies during move and releases once":
        step("move invalidates source copies without caller cooperation")
        unique_reset()
        val source = unique_new(42, "move")
        val alias = source
        val target = unique_move(source)
        expect(unique_is_valid(source)).to_equal(false)
        expect(unique_is_valid(alias)).to_equal(false)
        expect(unique_get(target)).to_equal(42)
        expect(unique_is_valid(unique_move(alias))).to_equal(false)
        expect(unique_drop(alias)).to_equal(false)
        expect(unique_release(target)).to_equal(true)
        expect(unique_drop(target)).to_equal(false)
        expect(unique_get(target)).to_equal(-1)

    it "does not revive stale handles on slot reuse or reset":
        step("reusing storage and resetting preserve stale handle invalidity")
        unique_reset()
        val stale = unique_new(17, "stale")
        expect(unique_drop(stale)).to_equal(true)
        val replacement = unique_new(29, "replacement")
        expect(replacement.id == stale.id).to_equal(false)
        expect(unique_is_valid(stale)).to_equal(false)
        unique_reset()
        val fresh = unique_new(31, "fresh")
        expect(fresh.id == replacement.id).to_equal(false)
        expect(unique_is_valid(replacement)).to_equal(false)
        expect(unique_drop(replacement)).to_equal(false)
        expect(unique_get(fresh)).to_equal(31)

    it "distinguishes negative payloads and consumes into inner once":
        step("checked reads distinguish the sentinel payload from invalidity")
        unique_reset()
        val negative = unique_new(-1, "negative")
        expect(unique_try_get(negative)).to_equal(Some(-1))
        expect(unique_into_inner(negative)).to_equal(-1)
        expect(unique_try_get(negative)).to_be_nil()
        expect(unique_release(negative)).to_equal(false)
        val value = unique_new(93, "take")
        expect(unique_into_inner(value)).to_equal(93)
        expect(unique_into_inner(value)).to_equal(-1)
        expect(unique_drop(value)).to_equal(false)
