# to_be_some / to_be_none matchers, positive and negated (todo 460).
# Failure-direction checks (to_be_some on None, to_be_none on Some, and the
# negated forms on the matching side) must FAIL the example; they are exercised
# by build-local probes recorded in the PR, since a spec cannot assert its own
# example failing.
use std.spec.{describe, it, expect}

fn _maybe(flag: bool) -> i64?:
    if flag: Some(7) else: None

describe "to_be_some matcher and negation":
    it "to_be_some passes on Some":
        expect(_maybe(true)).to_be_some()

    it "not_ to_be_some passes on None":
        expect(_maybe(false)).not_().to_be_some()

    it "not to_be_some passes on None":
        expect(_maybe(false)).not.to_be_some()

describe "to_be_none matcher and negation":
    it "to_be_none passes on None":
        expect(_maybe(false)).to_be_none()

    it "not_ to_be_none passes on Some":
        expect(_maybe(true)).not_().to_be_none()

    it "not to_be_none passes on Some":
        expect(_maybe(true)).not.to_be_none()
