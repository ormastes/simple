# Purpose: executable spec for the `to_be_none` matcher in
# src/lib/nogc_sync_mut/spec.spl: pass direction in-process, fail direction via
# test/fixture/spec/none_some_matcher_fixture.spl run as a real child process
# (failure state `current_test_errors` is module-private).
# to_be_some / not_() cases live in none_some_matcher_pending_spec.spl.
use std.spec.{describe, it, expect}
use std.common.spec.evidence.format.exec_capture.{capture_exec}

fn _maybe(flag: bool) -> i64?:
    if flag: Some(7) else: None

describe "to_be_none matcher":
    it "passes on None":
        expect(_maybe(false)).to_be_none()

    it "fails on Some":
        val capture = capture_exec("bin/simple", ["run", "test/fixture/spec/none_some_matcher_fixture.spl"])
        expect(capture.stdout.contains("to_be_none on Some MUST FAIL")).to_equal(true)
        expect(capture.stdout.contains("1 failure")).to_equal(true)
