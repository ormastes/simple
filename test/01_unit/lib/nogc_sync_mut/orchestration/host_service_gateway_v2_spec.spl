# @req HOST-02 ORCH-02
# NOT_RUN. Pure codec + actual private file/owned journal fixtures; scripted
# Container/root facts do not qualify native bootstrap, socket peer or send.
use std.spec.{describe, it, expect}
use std.spec.step
