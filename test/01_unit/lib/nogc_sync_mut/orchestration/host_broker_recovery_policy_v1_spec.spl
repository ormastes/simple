# AUTHORED_NOT_RUN. Pure policy/result/source boundaries only; no fake root,
# native owner, broker, cleaned session or service lifetime fixture.
use std.common.contracts.orchestration.host_broker_recovery_policy_v1.*
use std.common.contracts.container.stream_v2.{ContainerOutputIdentityV2, container_output_identity_digest_v2}
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded

fn broker_policy_data_v1() -> HostBrokerRecoveryPolicyV1:
    HostBrokerRecoveryPolicyV1("e".repeat(64), "service-a", [HostBrokerRecoveryEntryV1("f".repeat(64), "/var/lib/simple/brokers", "linux-output-primary-v1")])

fn broker_identity_data_v1() -> ContainerOutputIdentityV2:
    ContainerOutputIdentityV2("helper-a", "workload-a", "a".repeat(64), "b".repeat(64), "c".repeat(64), "d".repeat(64))

describe "installed broker recovery administrative DATA boundaries":
    it "round trips bounded canonical historical approvals":
        val value = broker_policy_data_v1()
        val source = host_broker_recovery_policy_encode_v1(value).unwrap()
        val decoded = host_broker_recovery_policy_decode_v1(source).unwrap()
        expect(decoded.entries[0].parent_path).to_equal(value.entries[0].parent_path)
        expect(host_broker_recovery_policy_encode_v1(decoded).unwrap()).to_equal(source)

    it "rejects duplicate policy selection unsupported layout and source bounds":
        var value = broker_policy_data_v1()
        value.entries.push(value.entries[0])
        expect(host_broker_recovery_policy_encode_v1(value).is_err()).to_equal(true)
        val source = host_broker_recovery_policy_encode_v1(broker_policy_data_v1()).unwrap()
        expect(host_broker_recovery_policy_decode_v1(source.replace("linux-output-primary-v1", "unknown-layout")).is_err()).to_equal(true)
        expect(host_broker_recovery_policy_decode_v1(" ".repeat(65537)).is_err()).to_equal(true)
        expect(host_broker_recovery_policy_decode_v1(source + " ").is_err()).to_equal(true)

    it "binds historical selection to exact enrolled context and consumed policy":
        val value = broker_policy_data_v1()
        expect(host_broker_recovery_policy_parent_v1(value, "e".repeat(64), "service-a", "f".repeat(64)).unwrap()).to_equal("/var/lib/simple/brokers")
        expect(host_broker_recovery_policy_parent_v1(value, "a".repeat(64), "service-a", "f".repeat(64)).is_err()).to_equal(true)
        expect(host_broker_recovery_policy_parent_v1(value, "e".repeat(64), "other-service", "f".repeat(64)).is_err()).to_equal(true)
        expect(host_broker_recovery_policy_parent_v1(value, "e".repeat(64), "service-a", "a".repeat(64)).is_err()).to_equal(true)

    it "derives distinct category leaves and rejects alias traversal parents":
        val identity = broker_identity_data_v1()
        val digest = container_output_identity_digest_v2(identity).unwrap()
        expect(host_broker_recovery_root_v1("/private/brokers", identity, HostBrokerRecoveryDomainV1.OutputFollow).unwrap()).to_equal("/private/brokers/output-" + digest)
        expect(host_broker_recovery_root_v1("/private/brokers", identity, HostBrokerRecoveryDomainV1.PrimaryAttach).unwrap()).to_equal("/private/brokers/primary-attach-" + digest)
        for path in ["/", "relative", "/x/../y", "/x/./y", "/x//y", "/x/", "/x/\0"]:
            expect(host_broker_recovery_root_v1(path, identity, HostBrokerRecoveryDomainV1.OutputFollow).is_err()).to_equal(true)
        var other = identity
        other.binding_digest = "f".repeat(64)
        expect(host_broker_recovery_root_v1("/private/brokers", other, HostBrokerRecoveryDomainV1.OutputFollow).unwrap() == "/private/brokers/output-" + digest).to_equal(false)

    it "rejects unknown fields and wrong versions in canonical documents":
        var fields: Dict<text, SdnValue> = {"version": SdnValue.Int(2), "kind": SdnValue.String("host-broker-recovery-policy"),
            "enrollmentBindingDigest": SdnValue.String("e".repeat(64)), "serviceScopeId": SdnValue.String("service-a"), "entries": SdnValue.Array([])}
        expect(host_broker_recovery_policy_decode_v1(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n").is_err()).to_equal(true)
        fields["version"] = SdnValue.Int(1)
        fields["unrecognized"] = SdnValue.Bool(true)
        expect(host_broker_recovery_policy_decode_v1(sdn_encode_canonical(SdnValue.Dict(fields)) + "\n").is_err()).to_equal(true)

    it "authorizes derived root before opening and retains every partial reader":
        val source = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_service_agent_installed_v7.spl", 262144).unwrap()
        val open = source.split("pub fn host_agent_installed_broker_recovery_open_v7(")[1].split("pub fn host_agent_installed_broker_reconcile_v7(")[0]
        expect(open.split("linux_protected_root_reader_open_v1(custody.root)")[0].contains("broker_authorized_root_v7(owner, records)")).to_equal(true)
        expect(open.contains("custody.reader = opened.owner")).to_equal(true)
        expect(open.split("if custody.opening_failed: return")[0].contains("owner.broker = Some(custody)")).to_equal(true)
        expect(source.contains("linux_protected_root_reader_open_v1(records.native.launch.root)")).to_equal(false)
        expect(source.contains("pub fn host_agent_installed_broker_cancel_v7(")).to_equal(false)

    it "requires genuine reap and committed outcome while blocking unproved reader release":
        val source = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_service_agent_installed_v7.spl", 262144).unwrap()
        expect(source.contains("row.unwrap().outcome_digest != sha256_text(evidence.unwrap())")).to_equal(true)
        expect(source.contains("custody.recovery.is_some() and not custody.evidence_verified")).to_equal(true)
        val record = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_broker_recovery_records_v7.spl", 262144).unwrap()
        expect(record.contains("recovery.validate_reap_v3(records.lease)?")).to_equal(true)
        expect(record.contains("group_process_stream_recover_v2(")).to_equal(false)
        expect(record.contains("group_process_stream_collect_reap_v2(")).to_equal(false)
        expect(record.contains("file_read_regular_no_follow_bounded(")).to_equal(false)

    it "uses actual installed source only after signed and prepared-owner checks":
        val source = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_agent_workspace_execution_v2.spl", 262144).unwrap()
        val acquire = source.split("pub fn host_agent_workspace_acquire_installed_v2(")[1].split("pub fn host_agent_workspace_archive_v2(")[0]
        val before_open = acquire.split("val opened = simple_container_workspace_source_open_installed_v3(")[0]
        expect(before_open.contains("host_agent_workspace_authenticate_v2(")).to_equal(true)
        expect(before_open.contains("if checked.is_err(): return")).to_equal(true)
        expect(acquire.contains("val current = opened.owner")).to_equal(true)
        expect(source.contains("simple_container_workspace_source_open_v3(")).to_equal(false)
        expect(source.contains("simple_container_enable_workspace_v3(container, request, state.packet.manifest.base.workspace_manifest, digest, agent_workspace_invocation_manifest_encode_v2(state.packet.manifest).unwrap())")).to_equal(true)
        val old = source.split("pub fn host_agent_workspace_acquire_v2(")[1].split("pub fn host_agent_workspace_acquire_installed_v2(")[0]
        expect(old.contains("HostAgentWorkspaceAcquireTurnV2(container, Some(lease), None, None,")).to_equal(true)
        expect(old.contains("simple_container_workspace_source_open")).to_equal(false)

    it "keeps installed begin on same canonical slot and returns both actual custody carriers":
        val source = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_authorized_execution_v2.spl", 262144).unwrap()
        val installed = source.split("pub fn host_authorized_agent_workspace_begin_installed_v2(")[1].split("fn host_agent_native_begin_installed_v2(")[0]
        expect(installed.contains("WorkspaceStorageLeaseV1")).to_equal(false)
        expect(installed.contains("host_agent_native_begin_installed_v2(")).to_equal(true)
        val core = source.split("fn host_agent_native_begin_installed_v2(")[1].split("fn host_agent_native_slot_v2(")[0]
        expect(core.contains("host_execution_progress_slots_v4.push(Some(HostExecutionProgressStateV4(")).to_equal(true)
        expect(core.split("host_execution_current_v2(owner)")[0].contains("host_agent_workspace_origin_v2()")).to_equal(true)
        val owner = file_read_regular_no_follow_bounded("src/lib/nogc_sync_mut/orchestration/host_service_agent_installed_v7.spl", 262144).unwrap()
        val wrapper = owner.split("pub fn host_service_agent_installed_begin_v7(")[1]
        expect(wrapper.contains("local.capacity = progress.owner")).to_equal(true)
        expect(wrapper.contains("local.container = progress.container")).to_equal(true)
        expect(wrapper.contains("HostAgentInstalledInvokeTurnV7(retained, Some(progress)")).to_equal(true)
