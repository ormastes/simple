# Source-only NOT_RUN. Terminal metadata fixtures contain NO actual inspection,
# native store, journal, Domain or live owner. They cannot start an inspection.
use std.nogc_sync_mut.orchestration.host_controller_inspection_session_v3.HostControllerInspectionSessionV3

describe "inspection continuation cache metadata without fabricated live authority":
    it "refuses cache association with another operation or original execute digest":
        step("Match the immutable actual execute packet identity before reusing a session")
        val session = HostControllerInspectionSessionV3(operation_id: "operation", execute_request_digest: "a".repeat(64),
            inspection: nil, response: "", error: "terminal fixture refusal", cancelled: false)
        expect(session.matches_v3("operation", "a".repeat(64))).to_equal(true)
        expect(session.matches_v3("other-operation", "a".repeat(64))).to_equal(false)
        expect(session.matches_v3("operation", "b".repeat(64))).to_equal(false)
        expect(session.matches_v3("operation", "short")).to_equal(false)
        expect(session.matches_v3("invalid\noperation", "a".repeat(64))).to_equal(false)

    it "does not promote a cached response or cleared pending state over a terminal error":
        step("Retain the first failure even when no inspection handle remains")
        val session = HostControllerInspectionSessionV3(operation_id: "operation", execute_request_digest: "a".repeat(64),
            inspection: nil, response: "fixture-only cached bytes", error: "actual failure must remain", cancelled: false)
        expect(session.pending_v3()).to_equal(false)
        expect(session.response_v3()).to_equal("fixture-only cached bytes")
        expect(session.error_v3()).to_equal("actual failure must remain")
        expect(session.exit_code_v3()).to_equal(2)

    it "keeps cancelled and unknown terminal metadata nonzero without inventing an owner":
        step("No raw response string or absent handle certifies native completion or cleanup")
        val cancelled = HostControllerInspectionSessionV3(operation_id: "operation", execute_request_digest: "a".repeat(64),
            inspection: nil, response: "fixture-only bytes", error: "", cancelled: true)
        expect(cancelled.exit_code_v3()).to_equal(2)
        val unknown = HostControllerInspectionSessionV3(operation_id: "operation", execute_request_digest: "a".repeat(64),
            inspection: nil, response: "", error: "", cancelled: false)
        expect(unknown.exit_code_v3()).to_equal(2)
