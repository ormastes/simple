# @req REQ-SSPEC-UNIT
# Regression: `test.*` imports must resolve from a spec living under
# test/01_unit/lib/nogc_sync_mut, which contains a nested `src/` directory that
# used to be mistaken for the project root and cut the ancestor climb short.
use std.spec.step
use std.spec.{describe, it, assert_equal}
use test.fixtures.url_query_contract.checks.{url_query_contract_checks_v1}

describe "test.* import resolution under a lib family test directory":
    it "resolves test.fixtures past a nested src directory":
        # @req REQ-SSPEC-UNIT
        step("imports a test fixture from the repository test root")
        assert_equal(url_query_contract_checks_v1(), 8)
