# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Regression: File.metadata called a bare `extern fn file_metadata` with no
# runtime backing, so the native full-CLI link refused it
# (doc/08_tracking/bug/full_cli_native_link_missing_symbols_2026-11-15.md).

use std.spec
use std.spec.step
use std.nogc_sync_mut.fs.flat.{File}
use std.io_runtime.{dir_create_all, dir_remove_all, file_write, getpid}


describe "nogc_sync_mut fs flat File.metadata":
    # @manual scenario evidence

    it "reports size and kind for a file and a directory, and None when missing":
        # @req REQ-SSPEC-UNIT
        val root = "/tmp/flat_file_metadata_spec_{getpid()}"
        dir_create_all(root)
        step("a written file reports its byte size as a regular file")
        file_write("{root}/a.txt", "hello")
        val file_meta = File.metadata("{root}/a.txt")
        expect(file_meta.?).to_equal(true)
        val fm = file_meta.unwrap()
        expect(fm.size).to_equal(5)
        expect(fm.is_file).to_equal(true)
        expect(fm.is_dir).to_equal(false)
        expect(fm.modified > 0).to_equal(true)

        step("a directory reports is_dir and not is_file")
        val dm = File.metadata(root).unwrap()
        expect(dm.is_dir).to_equal(true)
        expect(dm.is_file).to_equal(false)

        step("a missing path reports no metadata")
        expect(File.metadata("{root}/missing.txt").?).to_equal(false)
        dir_remove_all(root)
