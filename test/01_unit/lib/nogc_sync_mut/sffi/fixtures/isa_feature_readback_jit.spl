# Fixture for isa_feature_readback_spec.spl: run via `simple run` so the
# Cranelift externs go through the seed's hybrid-JIT interp-splice.
use std.nogc_sync_mut.sffi.codegen.{cranelift_new_aot_module_config_v2, cranelift_aot_isa_feature_v2, cranelift_aot_opt_level_v2}

fn main():
    val m = cranelift_new_aot_module_config_v2("isa_probe", "x86_64-unknown-linux-gnu", "generic", 2, ["sse4.2", "avx2"])
    print "module_ok={m != 0} opt={cranelift_aot_opt_level_v2(m)}"
    print "sse4.2={cranelift_aot_isa_feature_v2(m, "sse4.2")} avx={cranelift_aot_isa_feature_v2(m, "avx")} avx2={cranelift_aot_isa_feature_v2(m, "avx2")} fma={cranelift_aot_isa_feature_v2(m, "fma")} bogus={cranelift_aot_isa_feature_v2(m, "not_a_feature")}"
