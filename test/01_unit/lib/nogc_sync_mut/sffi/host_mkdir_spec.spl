use std.spec
use std.spec.step
use std.nogc_sync_mut.sffi.host.{mkdir}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

"""
## Purpose and audience

`host.mkdir` must create a real directory and report true. The runtime
`rt_mkdir` returns an i64 status (0 on success, -errno on failure), so the
bool wrapper must map 0 to true. Audience: SFFI and filesystem maintainers.
"""

describe "host mkdir":
    it "creates a real directory and returns true":
        step("Create a scratch root")
        val (base, _e0, code0) = rt_process_run("mktemp", ["-d"])
        expect(code0).to_equal(0)
        val root = base.trim()
        val target = root + "/made"
        step("mkdir reports true for a new directory")
        expect(mkdir(target)).to_equal(true)
        step("The directory exists on disk")
        val (_o1, _e1, probe) = rt_process_run("/bin/test", ["-d", target])
        expect(probe).to_equal(0)
        step("A second create of the same path reports false")
        expect(mkdir(target)).to_equal(false)
        rt_process_run("/bin/rm", ["-rf", root])
