# Extern return-shape canonicalisation (batch 2): rt_env_home is declared
# `-> text?` everywhere (runtime returns a RuntimeValue that may be nil).
# The text-returning wrapper std.nogc_sync_mut.platform.home_dir now maps a
# missing home to "" instead of passing nil through a `text` slot.
# Bug: doc/08_tracking/bug/seed_jit_extern_return_type_last_wins_2026-11-27.md

use std.nogc_sync_mut.platform.{home_dir}

describe "home_dir over canonical rt_env_home -> text?":
    it "returns a text value, never nil":
        val h = home_dir()
        expect(h.len() >= 0).to_equal(true)

    it "agrees with the HOME / USERPROFILE environment when set":
        val h = home_dir()
        if h.len() > 0:
            expect(h.contains("/") or h.contains("\\")).to_equal(true)
