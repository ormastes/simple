use std.spec.*
use std.nogc_sync_mut.sffi.dynamic.{
    provider_lifetime_register_bound_v1,
    provider_lifetime_begin_bound_v1,
    provider_lifetime_end_v1,
    provider_lifetime_closed_v1
}

describe "dynlib scalar identity bookkeeping V1":
    it "matches the complete digest before incrementing a synthetic handle lease":
        val identity = unsafe(capabilities: [ffi]):
            provider_lifetime_register_bound_v1(1900001, 11u64, 22u64, 33u64, 44u64)
        expect(identity > 0u64).to_be(true)
        expect(unsafe(capabilities: [ffi]):
            provider_lifetime_begin_bound_v1(identity, 11u64, 22u64, 33u64, 45u64)).to_equal(0)
        expect(unsafe(capabilities: [ffi]):
            provider_lifetime_begin_bound_v1(identity, 11u64, 22u64, 33u64, 44u64)).to_equal(1900001)
        expect(unsafe(capabilities: [ffi]): provider_lifetime_end_v1(identity)).to_be(false)
        expect(provider_lifetime_closed_v1(identity)).to_be(false)

    it "rejects an unissued identity without touching another row":
        val identity = unsafe(capabilities: [ffi]):
            provider_lifetime_register_bound_v1(1900002, 1u64, 2u64, 3u64, 4u64)
        expect(identity > 0u64).to_be(true)
        expect(unsafe(capabilities: [ffi]):
            provider_lifetime_begin_bound_v1(identity + 1000000u64, 1u64, 2u64, 3u64, 4u64)).to_equal(0)
