use std.spec.*
use std.nogc_sync_mut.sffi.dynlib_snapshot_registry_v1.{dynlib_snapshot_pin_process_v1}

# The registry used to keep its descriptor list inside the Mutex value. Under
# the Rust interpreter that struct read back nil, the first pin faulted while
# holding the lock and the process crashed (SIGSEGV) or later pins deadlocked.
# State now lives in a module-level global; the mutex is only a lock.

describe "dynlib snapshot process registry V1":
    it "accepts a new descriptor once and refuses its reuse":
        expect(dynlib_snapshot_pin_process_v1(1000001)).to_be(true)
        expect(dynlib_snapshot_pin_process_v1(1000001)).to_be(false)

    it "keeps admitting distinct descriptors after earlier pins":
        expect(dynlib_snapshot_pin_process_v1(1000002)).to_be(true)
        expect(dynlib_snapshot_pin_process_v1(1000003)).to_be(true)
        expect(dynlib_snapshot_pin_process_v1(1000002)).to_be(false)

    it "refuses out-of-range descriptors without touching the lock":
        expect(dynlib_snapshot_pin_process_v1(-1)).to_be(false)
        expect(dynlib_snapshot_pin_process_v1(2147483648)).to_be(false)
        expect(dynlib_snapshot_pin_process_v1(1000004)).to_be(true)
