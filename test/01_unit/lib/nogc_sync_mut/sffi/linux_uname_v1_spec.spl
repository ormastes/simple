# Pure native-field decoder tests; no claimed native syscall execution.
use std.spec.*
use std.nogc_sync_mut.sffi.linux_uname_v1.linux_uname_architecture_from_fields_v1

describe "Linux uname architecture field decoding":
    it "normalizes supported kernel architecture names without environment defaults":
        expect(linux_uname_architecture_from_fields_v1("Linux", "x86_64")).to_equal(Ok("x86_64"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "amd64")).to_equal(Ok("x86_64"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "aarch64")).to_equal(Ok("aarch64"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "arm64")).to_equal(Ok("aarch64"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "riscv64")).to_equal(Ok("riscv64"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "i686")).to_equal(Ok("i686"))
        expect(linux_uname_architecture_from_fields_v1("Linux", "armv7l")).to_equal(Ok("arm"))

    it "refuses foreign kernel names and unknown or malformed architecture values":
        expect(linux_uname_architecture_from_fields_v1("FreeBSD", "amd64")).to_equal(Err("linux-uname-kernel-mismatch"))
        for machine in ["", "unknown", "x86_64\0other", "x86_64\n", "a".repeat(65)]:
            expect(linux_uname_architecture_from_fields_v1("Linux", machine).is_err()).to_equal(true)
