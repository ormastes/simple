use std.spec
use std.nogc_sync_mut.sffi.host.{heap_aux_live_bytes, heap_array_capacity_bytes}

"""
## Purpose and audience

`host.heap_aux_live_bytes` reports live container backing-buffer bytes
(array element buffers + dict entry tables) and `heap_array_capacity_bytes`
the array subset. Before 2026-11-02 the C runtime had no definition of
`rt_heap_aux_live_bytes` at all (bug
stage2_runtime_missing_rt_heap_aux_live_bytes_2026-11-02), so any native
link of host.spl failed or used a 0 shim. Audience: runtime and memory
diagnostics maintainers.
"""

describe "host heap aux live bytes":
    it "reports a non-negative total that contains the array capacity subset":
        val aux = heap_aux_live_bytes()
        val cap = heap_array_capacity_bytes()
        expect(aux >= 0).to_be(true)
        expect(cap >= 0).to_be(true)
        expect(cap <= aux).to_be(true)

    it "is callable repeatedly without changing on a pure read":
        val first = heap_aux_live_bytes()
        val second = heap_aux_live_bytes()
        expect(second).to_equal(first)
