use std.nogc_sync_mut.debug.remote.protocol.gdb_mi_parser.{GdbMiParser, GdbMiRecord}

# Multi-byte regression coverage for
# src/lib/nogc_sync_mut/debug/remote/protocol/gdb_mi_parser.spl (and its
# mirrors src/lib/nogc_async_mut/... and src/app/...) — parses GDB Machine
# Interface protocol output, which can carry arbitrary debuggee string
# values (variable contents, source paths) — the "debug-adapter protocol
# carrying arbitrary text" HIGH-risk domain from
# doc/08_tracking/bug/bracket_slice_byte_index_survey_2026-07-29.md.
#
# find_char/find_closing_quote/find_matching_brace/find_matching_bracket
# (plus two inline single-index reads) all walked via single-index
# `raw[pos]` while every caller fed the returned position into a
# byte-indexed `raw[a:b]` slice. Single-index text access is
# CHARACTER-indexed on this engine (confirmed: `"café"[3]` returns the
# whole "é", not a byte); every slice in the same functions is
# byte-indexed. Once any multi-byte character appeared in a GDB/MI value,
# the character-indexed cursor silently desynced from the byte-indexed
# slices, corrupting or truncating every value parsed after it. Same bug
# class already fixed in scv/structural_match.spl and
# app/devhub/convert_storage.spl in this campaign.
#
# Vacuity-probed against the pre-fix source (2026-07-29): café-hit
# truncated to "café-hi" and the following key/value pair vanished
# entirely; 日本語 truncated to "日" and the following pair vanished; an
# em-dash inside a tuple value truncated the tuple's closing `"}`.
# Pure-ASCII input was correct in both versions (regression guard below).

describe "GdbMiParser multi-byte":
    it "café inside an async record's first quoted value does not truncate the record":
        val r = GdbMiParser.parse_line("*stopped,reason=\"café-hit\",value=\"42\"")
        match r:
            GdbMiRecord.Async(cls, data):
                expect(cls).to_equal("stopped")
                expect(data["reason"]).to_equal("café-hit")
                expect(data["value"]).to_equal("42")
            _:
                expect(false).to_be(true)  # wrong record kind

    it "CJK content in a result record's first value does not drop later keys":
        val r = GdbMiParser.parse_line("^done,name=\"日本語\",id=\"7\"")
        match r:
            GdbMiRecord.Result(token, cls, data):
                expect(cls).to_equal("done")
                expect(data["name"]).to_equal("日本語")
                expect(data["id"]).to_equal("7")
            _:
                expect(false).to_be(true)

    it "em-dash inside a nested tuple value does not desync the tuple's closing brace":
        val r = GdbMiParser.parse_line("*stopped,frame={func=\"a—b\",line=\"5\"}")
        match r:
            GdbMiRecord.Async(cls, data):
                expect(cls).to_equal("stopped")
                expect(data["frame"]).to_equal("{func=\"a—b\",line=\"5\"}")
            _:
                expect(false).to_be(true)

    it "pure ASCII is unaffected (regression guard)":
        val r = GdbMiParser.parse_line("^done,reason=\"exited\",code=\"0\"")
        match r:
            GdbMiRecord.Result(token, cls, data):
                expect(cls).to_equal("done")
                expect(data["reason"]).to_equal("exited")
                expect(data["code"]).to_equal("0")
            _:
                expect(false).to_be(true)
