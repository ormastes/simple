# std.env.platform get_temp_dir + dir_create_all — temp log folder creation
#
# A log file under a temp subfolder must be openable even when that
# subfolder does not exist yet: resolve the temp root portably, create the
# folder recursively, then write.

use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io_runtime.{dir_create_all, dir_exists, dir_remove_all, file_exists, file_write}

describe "temp log folder creation":
    it "resolves a non-empty temp root":
        val root = get_temp_dir()
        expect(root.len()).to_be_greater_than(0)

    it "creates a missing nested temp subfolder before writing a log file":
        val base = get_temp_dir() + "/simple_temp_dir_creation_spec"
        dir_remove_all(base)
        assert_false(dir_exists(base))
        val nested = base + "/mcp/run_0"
        assert_true(dir_create_all(nested))
        assert_true(dir_exists(nested))
        val log_path = nested + "/stderr.log"
        file_write(log_path, "ok")
        assert_true(file_exists(log_path))
        dir_remove_all(base)
