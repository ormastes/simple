use std.spec.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.feature_registry_v1.*

fn mask_of(feature_id: u32) -> u64:
    match environment_feature_registry_lookup_v2(feature_id):
        case Ok(entry): entry.feature_mask
        case Err(_):
            fail("expected registered feature ID")
            0u64

describe "Environment feature registry exact x86 levels V2":
    it "requires every x86-64-v3 feature independently":
        val complete = mask_of(ENV_FEATURE_X86_64_LEVEL3_V2)
        val required = [
            ENV_X86_FEATURE_BASELINE_V2,
            ENV_X86_FEATURE_CMPXCHG16B_V2, ENV_X86_FEATURE_LAHF_SAHF_V2,
            ENV_X86_FEATURE_POPCNT_V2, ENV_X86_FEATURE_SSE3_V2,
            ENV_X86_FEATURE_SSSE3_V2, ENV_X86_FEATURE_SSE41_V2,
            ENV_X86_FEATURE_SSE42_V2,
            ENV_X86_FEATURE_AVX_V2, ENV_X86_FEATURE_AVX2_V2,
            ENV_X86_FEATURE_BMI1_V2, ENV_X86_FEATURE_BMI2_V2,
            ENV_X86_FEATURE_F16C_V2, ENV_X86_FEATURE_FMA_V2,
            ENV_X86_FEATURE_LZCNT_V2, ENV_X86_FEATURE_MOVBE_V2,
            ENV_X86_FEATURE_OSXSAVE_V2]
        for feature in required:
            expect(environment_feature_registry_x86_level_complete_v2(
                ENV_FEATURE_X86_64_LEVEL3_V2, complete ^ feature)).to_equal(false)
        expect(environment_feature_registry_x86_level_complete_v2(
            ENV_FEATURE_X86_64_LEVEL3_V2, complete)).to_equal(true)

    it "requires the complete defined v4 group":
        val complete = mask_of(ENV_FEATURE_X86_64_LEVEL4_V2)
        for feature in [ENV_X86_FEATURE_AVX512F_V2,
                        ENV_X86_FEATURE_AVX512BW_V2,
                        ENV_X86_FEATURE_AVX512CD_V2,
                        ENV_X86_FEATURE_AVX512DQ_V2,
                        ENV_X86_FEATURE_AVX512VL_V2]:
            expect(environment_feature_registry_x86_level_complete_v2(
                ENV_FEATURE_X86_64_LEVEL4_V2, complete ^ feature)).to_equal(false)
        expect(environment_feature_registry_x86_level_complete_v2(
            ENV_FEATURE_X86_64_LEVEL4_V2, complete)).to_equal(true)

    it "keeps VBMI and VBMI2 outside plain x86-64-v4":
        val v4 = mask_of(ENV_FEATURE_X86_64_LEVEL4_V2)
        val vbmi = mask_of(ENV_FEATURE_X86_64_LEVEL4_VBMI_V2)
        val vbmi2 = mask_of(ENV_FEATURE_X86_64_LEVEL4_VBMI2_V2)
        expect(v4 & ENV_X86_FEATURE_AVX512VBMI_V2).to_equal(0u64)
        expect(v4 & ENV_X86_FEATURE_AVX512VBMI2_V2).to_equal(0u64)
        expect(vbmi & ENV_X86_FEATURE_AVX512VBMI_V2)
            .to_equal(ENV_X86_FEATURE_AVX512VBMI_V2)
        expect(vbmi2 & ENV_X86_FEATURE_AVX512VBMI2_V2)
            .to_equal(ENV_X86_FEATURE_AVX512VBMI2_V2)
        expect(environment_feature_registry_x86_id_subset_v2(
            ENV_FEATURE_X86_64_LEVEL4_VBMI_V2,
            ENV_FEATURE_X86_64_LEVEL4_V2)).to_equal(false)

    it "rejects partial and unknown x86 level masks":
        val v3 = mask_of(ENV_FEATURE_X86_64_LEVEL3_V2)
        expect(environment_feature_registry_x86_level_complete_v2(
            0xffffffffu32, v3)).to_equal(false)
        expect(environment_feature_registry_x86_level_complete_v2(
            ENV_FEATURE_X86_64_LEVEL4_V2, v3)).to_equal(false)

    it "keeps legacy V1 words distinct from exact V2 words":
        val legacy = environment_feature_registry_lookup_v1(
            ENV_FEATURE_X86_64_V4_V1).unwrap().feature_mask
        expect(legacy).to_equal(65535u64)
        expect(environment_feature_registry_x86_validate_v2(legacy)).to_equal(false)
        expect(environment_feature_registry_x86_level_complete_v2(
            ENV_FEATURE_X86_64_LEVEL4_V2, legacy)).to_equal(false)
describe "Environment feature registry V1":
    it "expands stable x86 presets into one arena word":
        val expansion = match environment_feature_registry_expand_v1(
            ENV_FEATURE_X86_64_V3_V1, 4u32):
            case Ok(value): value
            case Err(_):
                assert(false)
                EnvironmentFeatureRegistryExpansionV1(
                    entry: EnvironmentFeatureRegistryEntryV1(
                        feature_id: 0u32, architecture: ENV_ARCH_UNKNOWN_V1,
                        word_count: 0u32, feature_mask: 0u64),
                    feature_set: EnvironmentFeatureSetV1(
                        architecture: ENV_ARCH_UNKNOWN_V1,
                        words: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)),
                    words: [])
        expect(expansion.feature_set.architecture).to_equal(ENV_ARCH_X86_64_V1)
        expect(expansion.feature_set.words.offset).to_equal(4u32)
        expect(expansion.feature_set.words.count).to_equal(1u32)
        expect(expansion.words.len()).to_equal(1)
        expect(environment_feature_registry_validate_v1(
            expansion.feature_set, [0u64, 0u64, 0u64, 0u64, expansion.words[0]]))
            .to_equal(Ok(()))

    it "keeps AVX512 VBMI and VBMI2 as separate exact IDs":
        expect(environment_feature_registry_id_subset_v1(
            ENV_FEATURE_X86_64_V4_V1, ENV_FEATURE_X86_64_AVX512_VBMI_V1))
            .to_equal(true)
        expect(environment_feature_registry_id_subset_v1(
            ENV_FEATURE_X86_64_V4_V1,
            ENV_FEATURE_X86_64_AVX512_VBMI2_V1)).to_equal(true)
        expect(environment_feature_registry_id_subset_v1(
            ENV_FEATURE_X86_64_AVX512_VBMI_V1,
            ENV_FEATURE_X86_64_AVX512_VBMI2_V1)).to_equal(false)
        expect(ENV_FEATURE_X86_64_AVX512_VBMI_V1)
            .to_equal(0x1110u32)
        expect(ENV_FEATURE_X86_64_AVX512_VBMI2_V1)
            .to_equal(0x1111u32)

    it "accepts only architecture-local feature subsets":
        val x86 = match environment_feature_registry_expand_v1(
            ENV_FEATURE_X86_64_V2_V1, 0u32):
            case Ok(value): value
            case Err(_):
                assert(false)
                EnvironmentFeatureRegistryExpansionV1(
                    entry: EnvironmentFeatureRegistryEntryV1(
                        feature_id: 0u32, architecture: ENV_ARCH_UNKNOWN_V1,
                        word_count: 0u32, feature_mask: 0u64),
                    feature_set: EnvironmentFeatureSetV1(
                        architecture: ENV_ARCH_UNKNOWN_V1,
                        words: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)),
                    words: [])
        val neon = match environment_feature_registry_expand_v1(
            ENV_FEATURE_AARCH64_NEON_V1, 1u32):
            case Ok(value): value
            case Err(_):
                assert(false)
                EnvironmentFeatureRegistryExpansionV1(
                    entry: EnvironmentFeatureRegistryEntryV1(
                        feature_id: 0u32, architecture: ENV_ARCH_UNKNOWN_V1,
                        word_count: 0u32, feature_mask: 0u64),
                    feature_set: EnvironmentFeatureSetV1(
                        architecture: ENV_ARCH_UNKNOWN_V1,
                        words: EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)),
                    words: [])
        val arena = [x86.words[0], neon.words[0]]
        expect(environment_feature_registry_subset_v1(
            x86.feature_set, x86.feature_set, arena)).to_equal(true)
        expect(environment_feature_registry_subset_v1(
            x86.feature_set, neon.feature_set, arena)).to_equal(false)
        expect(environment_feature_registry_id_subset_v1(
            ENV_FEATURE_AARCH64_NEON_V1, ENV_FEATURE_X86_64_V4_V1))
            .to_equal(false)

    it "rejects unknown IDs, unsupported bits, and malformed arena ranges":
        expect(environment_feature_registry_architecture_v1(0xffffffffu32))
            .to_equal(ENV_ARCH_UNKNOWN_V1)
        expect(environment_feature_registry_expand_v1(0xffffffffu32, 0u32))
            .to_equal(Err(EnvironmentFeatureRegistryErrorV1.UnknownFeatureId))
        val invalid = EnvironmentFeatureSetV1(
            architecture: ENV_ARCH_RISCV64_V1,
            words: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32))
        expect(environment_feature_registry_validate_v1(invalid, [2u64]))
            .to_equal(Err(EnvironmentFeatureRegistryErrorV1.UnknownFeatureBits))
        val out_of_range = EnvironmentFeatureSetV1(
            architecture: ENV_ARCH_AARCH64_V1,
            words: EnvironmentArenaRangeV1(offset: 2u32, count: 1u32))
        expect(environment_feature_registry_validate_v1(out_of_range, [1u64]))
            .to_equal(Err(EnvironmentFeatureRegistryErrorV1.InvalidArenaRange))
