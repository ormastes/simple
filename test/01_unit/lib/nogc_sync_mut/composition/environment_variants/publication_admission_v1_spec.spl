use std.spec.*
use std.nogc_sync_mut.composition.environment_variants.contracts_v1.*
use std.nogc_sync_mut.composition.environment_variants.artifact_admission_v1.*
use std.nogc_sync_mut.composition.environment_variants.dependency_resolver_v1.*
use std.nogc_sync_mut.composition.environment_variants.publication_admission_v1.*
use std.nogc_sync_mut.composition.environment_variants.catalog_identity_v1.*

fn d(value: u64) -> EnvironmentDigest256V1:
    EnvironmentDigest256V1(w0: value, w1: 0u64, w2: 0u64, w3: 0u64)

fn empty_range() -> EnvironmentArenaRangeV1:
    EnvironmentArenaRangeV1(offset: 0u32, count: 0u32)

fn snapshot_v1() -> EnvironmentSnapshotV1:
    val features = EnvironmentFeatureSetV1(
        architecture: ENV_ARCH_X86_64_V1, words: empty_range())
    EnvironmentSnapshotV1(
        descriptor_size: 232u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        execution_architecture: ENV_ARCH_X86_64_V1,
        os_id: 1u32, abi_id: 1u32, object_format_id: 1u32,
        endian_id: 1u16, pointer_width_bits: 64u16,
        snapshot_identity: d(100u64), snapshot_generation: 2u64,
        execution_domain_identity: d(101u64), hardware_features: features,
        os_usable_features: features, policy_allowed_features: features,
        vector_state_mode: ENV_VECTOR_NONE_V1, vector_length_bits: 0u32,
        loader_permission_bits: 1u64, allowed_effect_bits: 1u64,
        numerical_contract_id: 1u32, resource_layout_digest: d(30u64),
        gpu_devices: empty_range())

fn descriptor_v1(provider: u64, variant: u64, artifact: u64, receipt: u64,
                 dependency_count: u32) -> VariantDescriptorV1:
    val empty = empty_range()
    VariantDescriptorV1(
        descriptor_size: 360u32, schema_version: ENV_VARIANT_SCHEMA_V1,
        placement: ENV_PLACEMENT_NATIVE_DYNLIB_V1,
        provider_identity: d(provider), variant_identity: d(variant),
        contract_identity: d(provider + 100u64), contract_major: 1u16,
        contract_minor: 0u16, abi_digest: d(4u64), semantic_identity: d(5u64),
        grammar_identity: d(6u64), program_identity: d(7u64),
        artifact_digest: d(artifact),
        artifact_location: EnvironmentArenaRangeV1(offset: 0u32, count: 1u32),
        target_architecture: ENV_ARCH_X86_64_V1,
        required_os_id: 1u32, required_abi_id: 1u32, required_object_format_id: 1u32,
        required_endian_id: 1u16, required_pointer_width_bits: 64u16,
        required_loader_permission_bits: 1u64,
        required_cpu_features: EnvironmentFeatureSetV1(
            architecture: ENV_ARCH_X86_64_V1, words: empty),
        required_os_state_words: empty, required_vector_state_mode: ENV_VECTOR_NONE_V1,
        required_vector_length_bits: 0u32, required_device_api: 0u32,
        minimum_device_api_version: 0u32, required_device_features: empty,
        required_memory_domain_bits: 0u64, minimum_device_buffer_bytes: 0u64,
        minimum_workgroup_invocations: 0u32, minimum_queue_family_count: 0u32,
        required_effect_bits: 1u64, numerical_contract_id: 1u32,
        resource_layout_digest: d(30u64),
        dependencies: EnvironmentArenaRangeV1(offset: 0u32, count: dependency_count),
        assurance_receipt_digest: d(receipt), startup_budget_us: 1u64,
        max_session_bytes: 1u64, max_inflight_operations: 1u32)

fn dependency_v1() -> VariantDependencyV1:
    VariantDependencyV1(
        provider_identity: d(20u64), contract_identity: d(120u64),
        minimum_contract_major: 1u16, minimum_contract_minor: 0u16,
        artifact_digest: d(18u64))

fn trust_receipt_v1(artifact: u64, receipt: u64) -> ArtifactTrustVerificationReceiptV1:
    ArtifactTrustVerificationReceiptV1(
        descriptor_size: ENV_ARTIFACT_TRUST_RECEIPT_BYTES_V1,
        schema_version: ENV_VARIANT_SCHEMA_V1,
        authentication_status: ENV_ARTIFACT_TRUST_AUTHENTICATED_V1,
        receipt_identity: d(receipt), artifact_digest: d(artifact),
        trust_policy_digest: d(200u64), verifier_identity: d(201u64),
        verifier_generation: 3u64, verification_evidence_digest: d(202u64))

fn evidence_v1(provider: u64, variant: u64, artifact: u64,
               receipt: u64, generation: u64) -> PublicationArtifactEvidenceV1:
    PublicationArtifactEvidenceV1(
        provider_identity: d(provider), variant_identity: d(variant),
        artifact_digest: d(artifact), provider_generation: generation,
        observed_artifact_digest: d(artifact), required_trust_policy_digest: d(200u64),
        required_verifier_identity: d(201u64), minimum_verifier_generation: 3u64,
        trust_receipt: trust_receipt_v1(artifact, receipt))

fn binding_v1(generation: u64, context: u64) -> VariantFacetBindingV1:
    VariantFacetBindingV1(
        facet_id: ENV_FACET_FRONTEND_V1, interface_major: 1u16,
        interface_minor: 0u16, slot_index: 0u32,
        provider_identity: d(10u64), variant_identity: d(11u64),
        provider_generation: generation, interface_handle: 500u64,
        provider_context: context)

fn resolution_v1(root: VariantDescriptorV1, rows: [VariantDescriptorV1],
                 dependencies: [VariantDependencyV1]) -> EnvironmentDependencyResolutionV1:
    match environment_dependency_resolve_v1(root, rows, dependencies):
        case Ok(value): value
        case Err(_):
            assert(false)
            EnvironmentDependencyResolutionV1(
                schema_version: 1u16, root_provider_identity: d(1u64),
                root_variant_identity: d(1u64), resolved_dependencies: [],
                closure_identity: d(1u64))

describe "Safe environment publication admission V1":
    it "computes a canonical plan over the authenticated root and dependency closure":
        val root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 1u32)
        val dependency = descriptor_v1(20u64, 21u64, 18u64, 19u64, 0u32)
        val requirements = [dependency_v1()]
        val resolution = resolution_v1(root, [root, dependency], requirements)
        val evidence = [
            evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64),
            evidence_v1(20u64, 21u64, 18u64, 19u64, 5u64)]
        val admitted = environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root, dependency], requirements,
            resolution, evidence, d(300u64), 1u64, d(301u64), d(302u64),
            1u64, [binding_v1(4u64, 0u64)])
        match admitted:
            case Ok(value):
                expect(value.dependency_closure_digest).to_equal(resolution.closure_identity)
                expect(value.admitted_artifacts.len()).to_equal(2)
                expect(value.plan.plan_digest != d(0u64)).to_equal(true)
            case Err(_): fail("authenticated closure must admit")

    it "refuses missing or unauthenticated dependency evidence":
        val root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 1u32)
        val dependency = descriptor_v1(20u64, 21u64, 18u64, 19u64, 0u32)
        val requirements = [dependency_v1()]
        val resolution = resolution_v1(root, [root, dependency], requirements)
        val root_only = [evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64)]
        expect(environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root, dependency], requirements,
            resolution, root_only, d(300u64), 1u64, d(301u64), d(302u64),
            1u64, [binding_v1(4u64, 0u64)]))
            .to_equal(Err(EnvironmentPublicationAdmissionErrorV1.MissingArtifactEvidence))
        var dependency_evidence = evidence_v1(20u64, 21u64, 18u64, 19u64, 5u64)
        dependency_evidence.trust_receipt.authentication_status = ENV_ARTIFACT_TRUST_REJECTED_V1
        expect(environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root, dependency], requirements,
            resolution, [root_only[0], dependency_evidence], d(300u64), 1u64,
            d(301u64), d(302u64), 1u64, [binding_v1(4u64, 0u64)]))
            .to_equal(Err(EnvironmentPublicationAdmissionErrorV1.ArtifactNotAuthenticated))

    it "refuses a mismatched closure or facet generation":
        val root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 1u32)
        val dependency = descriptor_v1(20u64, 21u64, 18u64, 19u64, 0u32)
        val requirements = [dependency_v1()]
        var resolution = resolution_v1(root, [root, dependency], requirements)
        val evidence = [
            evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64),
            evidence_v1(20u64, 21u64, 18u64, 19u64, 5u64)]
        resolution.closure_identity = d(999u64)
        expect(environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root, dependency], requirements,
            resolution, evidence, d(300u64), 1u64, d(301u64), d(302u64),
            1u64, [binding_v1(4u64, 0u64)]))
            .to_equal(Err(EnvironmentPublicationAdmissionErrorV1.DependencyClosureMismatch))
        resolution = resolution_v1(root, [root, dependency], requirements)
        expect(environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root, dependency], requirements,
            resolution, evidence, d(300u64), 1u64, d(301u64), d(302u64),
            1u64, [binding_v1(6u64, 0u64)]))
            .to_equal(Err(EnvironmentPublicationAdmissionErrorV1.FacetBindingMismatch))

    it "binds facet content into the internally computed plan digest":
        val root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 0u32)
        val resolution = resolution_v1(root, [root], [])
        val evidence = [evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64)]
        val first = environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root], [], resolution, evidence,
            d(300u64), 1u64, d(301u64), d(302u64), 1u64,
            [binding_v1(4u64, 0u64)])
        val second = environment_publication_admit_v1(
            snapshot_v1(), [], [], root, [root], [], resolution, evidence,
            d(300u64), 1u64, d(301u64), d(302u64), 1u64,
            [binding_v1(4u64, 7u64)])
        match first:
            case Ok(left):
                match second:
                    case Ok(right): expect(left.plan.plan_digest != right.plan.plan_digest).to_equal(true)
                    case Err(_): fail("second canonical plan must admit")
            case Err(_): fail("first canonical plan must admit")

    it "derives catalog authority from current arena content without caller digests":
        val root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 0u32)
        val resolution = resolution_v1(root, [root], [])
        val evidence = [evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64)]
        val first = environment_publication_admit_canonical_v1(
            snapshot_v1(), [65u8], [], [], root, [root], [], resolution, evidence,
            1u64, d(301u64), 1u64, [binding_v1(4u64, 0u64)])
        val second = environment_publication_admit_canonical_v1(
            snapshot_v1(), [66u8], [], [], root, [root], [], resolution, evidence,
            1u64, d(301u64), 1u64, [binding_v1(4u64, 0u64)])
        val computed = environment_catalog_identity_compute_v1([65u8], [], [root], [])
        match first:
            case Ok(left):
                match second:
                    case Ok(right):
                        expect(left.plan.catalog_digest != right.plan.catalog_digest).to_equal(true)
                        expect(left.plan.plan_digest != right.plan.plan_digest).to_equal(true)
                    case Err(_): fail("mutated arena must derive a second valid authority")
                match computed:
                    case Ok(authority):
                        expect(left.plan.catalog_digest).to_equal(authority.catalog_content_digest)
                        expect(left.plan.dependency_lock_digest).to_equal(authority.dependency_lock_digest)
                    case Err(_): fail("canonical authority must compute")
            case Err(_): fail("canonical public path must admit")

    it "rejects a selected-root mutation outside the canonical descriptor set":
        val catalog_root = descriptor_v1(10u64, 11u64, 8u64, 9u64, 0u32)
        var mutated_root = catalog_root
        mutated_root.startup_budget_us = 99u64
        val resolution = resolution_v1(mutated_root, [catalog_root], [])
        val evidence = [evidence_v1(10u64, 11u64, 8u64, 9u64, 4u64)]
        expect(environment_publication_admit_canonical_v1(
            snapshot_v1(), [65u8], [], [], mutated_root, [catalog_root], [],
            resolution, evidence, 1u64, d(301u64), 1u64,
            [binding_v1(4u64, 0u64)]))
            .to_equal(Err(EnvironmentPublicationAdmissionErrorV1.RootNotInCatalog))
