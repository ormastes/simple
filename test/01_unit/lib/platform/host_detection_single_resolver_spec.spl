# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Reproducing spec for the host-detection collapse landed 2026-09-02.
# design: doc/05_design/platform/host_detection/platform_variation_minimization_2026-09-02.md

use std.spec.step
use std.spec.*

use std.nogc_sync_mut.env.platform.{detect_os, is_windows}
use std.nogc_sync_mut.platform.{is_windows as lib_platform_is_windows}
use std.nogc_sync_mut.spec.{is_windows as spec_is_windows}
use std.nogc_sync_mut.play.xvfb.{is_windows as xvfb_is_windows}
use std.nogc_sync_mut.play.wm.mod.{wm_is_windows}

# ============================================================================
# One resolver, one answer.
#
# Before 2026-09-02 each of these predicates re-derived "am I on Windows" from
# env_get("OS") alone and returned false when it was unset -- so they disagreed
# under a stripped environment, which is exactly where a bootstrap runs. They
# now all delegate to std.nogc_sync_mut.env.platform.
#
# These assertions are host-independent: they compare the predicates to EACH
# OTHER and to the resolver, so they hold on Linux, macOS and BSD as well as
# on the Windows host they were authored on.
# ============================================================================

describe "host detection has a single resolver":
    context "every converted predicate agrees with the resolver":
        it "agrees across lib, spec and play":
            # @req REQ-SSPEC-UNIT
            step("agrees across lib, spec and play")
            val truth = is_windows()
            expect(lib_platform_is_windows()).to_equal(truth)
            expect(spec_is_windows()).to_equal(truth)
            expect(xvfb_is_windows()).to_equal(truth)
            expect(wm_is_windows()).to_equal(truth)

    context "the resolver does not fail open":
        it "never reports unknown on a hosted target":
            # @req REQ-SSPEC-UNIT
            # The fail-open regression: with OS/OSTYPE unset and no /bin/sh on
            # disk, detect_os() used to fall through to "unknown", and every
            # is_windows() built on it silently answered false on Windows.
            step("never reports unknown on a hosted target")
            val os = detect_os()
            val known = (os == "windows" or os == "macos" or os == "linux"
                         or os == "freebsd" or os == "openbsd" or os == "netbsd")
            expect(known).to_equal(true)

        it "is_windows tracks detect_os exactly":
            # @req REQ-SSPEC-UNIT
            step("is_windows tracks detect_os exactly")
            expect(is_windows()).to_equal(detect_os() == "windows")
