"""
Reproducing spec — MCP native-build HIR-entry fatal (2026-09-01).

Defect: `env_get` has multiple co-compiled definitions with two differing
signatures ((text)->text vs (text)->Optional(text)). Under the full compiler
closure, ambiguous dispatch handed `std.nogc_sync_mut.log._ensure_initialized`
an `Option::None` for an UNSET env var, and its `.len()` call died with:

    error: semantic: method `len` not found on type `enum`
    (receiver value: Option::None)

killing the pure-Simple compile of app.mcp.main before HIR completed.
[mnf-debug-spl] ... parse_all_impl -> log_debug -> debug -> _ensure_initialized

Fix: log.spl routes env reads through a local nil-guarded `_env_text` helper,
so an unset variable is always "" regardless of which `env_get` overload the
dispatcher picked.

This spec pins the caller-visible contract: with the log env vars unset, the
lazy-init logging path must complete without a fatal, and `env_get` results
must be safe to `.len()`.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.env.variables.{env_get, env_unset}
use std.log.{log_debug, log_error}

describe "log lazy init survives unset env vars (env_get nil leak)":

    it "env_get on an unset variable supports .len() and is empty":
        # The exact expression that was fatal inside _ensure_initialized.
        env_unset("SIMPLE_SPEC_NO_SUCH_VAR_XYZ")
        val v = env_get("SIMPLE_SPEC_NO_SUCH_VAR_XYZ")
        expect(v.len()).to_equal(0)

    it "log_debug does not fatal when SIMPLE_LOG_FILE_PATH is unset":
        # log_debug -> debug -> _ensure_initialized reads
        # SIMPLE_LOG_FILE_PATH / SIMPLE_LOG_DIR / SIMPLE_LOG; with all three
        # unset, the pre-fix code called .len() on Option::None and died.
        env_unset("SIMPLE_SPEC_LOG_GUARD_CANARY")
        log_debug("log_env_nil_guard_spec canary")
        # Reaching this line at all is the assertion: the fatal aborted the
        # whole process, so a surviving follow-up check is the oracle.
        assert_true(true)

    it "log_error path also survives with logging env unset":
        log_error("log_env_nil_guard_spec error-path canary")
        assert_true(true)
