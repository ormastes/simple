describe "parse_selector: pseudo-class :hover":
    it ".btn:hover produces 1 compound with 2 simples (Class + PseudoClass)":
        # @req: REQ-BLINK-SEL-RTL-ANCHOR
        step("Verify: .btn:hover produces 1 compound with 2 simples (Class + PseudoClass)")
        val result = parse_selector(".btn:hover")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val compound = sel.compounds[0]
        expect(compound.simples.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val s0 = compound.simples[0]
        val s1 = compound.simples[1]
        expect(s0.kind).to_equal(SimpleSelectorKind.Class)
        expect(s0.name).to_equal("btn")
        expect(s1.kind).to_equal(SimpleSelectorKind.PseudoClass)
        expect(s1.name).to_equal("hover")

