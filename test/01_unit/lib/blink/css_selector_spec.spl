# @req: REQ-LIB-BLINK-001

# @cover src/lib/blink/css_parser/selector.spl 80%
"""
# CSS Selector Matcher Specification

**Category:** Browser / Blink
**Status:** Active

## Overview

Tests for `parse_selector` (tokenisation + AST construction) and
`matches_compound` (single-element matching logic) defined in
`src/lib/blink/css_parser/selector.spl`.
"""

use std.spipe.*
use std.blink.css_parser.selector.{
    SimpleSelectorKind, SimpleSelector, CompoundSelector,
    Combinator, ComplexSelector,
    parse_selector, matches_compound, matches_complex,
    matches_compound_with_state, matches_complex_with_state,
    simple_selector_new, compound_selector_new
}
use std.blink.dom.node.{
    DomNode, DomTree, NodeType, Attribute,
    dom_node_new, dom_tree_new, attribute_new
}
use std.blink.dom.interaction_state.{
    InteractionState,
    interaction_state_empty, interaction_state_with_hover,
    interaction_state_with_focus
}

# ---------------------------------------------------------------------------
# parse_selector tests
# ---------------------------------------------------------------------------

describe "parse_selector: type selector":
    it "div produces 1 compound with Type selector":
        # @req: REQ-BLINK-SEL-DESCENDANT
        step("Verify: div produces 1 compound with Type selector")
        val result = parse_selector("div")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val compound = sel.compounds[0]
        expect(compound.simples.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val simple = compound.simples[0]
        expect(simple.kind).to_equal(SimpleSelectorKind.Type)
        expect(simple.name).to_equal("div")

describe "parse_selector: class selector":
    it ".foo produces 1 compound with Class selector":
        # @req: REQ-BLINK-SEL-CHILD
        step("Verify: .foo produces 1 compound with Class selector")
        val result = parse_selector(".foo")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val compound = sel.compounds[0]
        expect(compound.simples.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val simple = compound.simples[0]
        expect(simple.kind).to_equal(SimpleSelectorKind.Class)
        expect(simple.name).to_equal("foo")

describe "parse_selector: id selector":
    it "#bar produces 1 compound with Id selector":
        # @req: REQ-BLINK-SEL-RTL-ANCHOR
        step("Verify: #bar produces 1 compound with Id selector")
        val result = parse_selector("#bar")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val compound = sel.compounds[0]
        expect(compound.simples.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val simple = compound.simples[0]
        expect(simple.kind).to_equal(SimpleSelectorKind.Id)
        expect(simple.name).to_equal("bar")

describe "parse_selector: compound selector":
    it "div.foo produces 1 compound with 2 simples (Type + Class)":
        # @req: REQ-BLINK-SEL-CHAIN
        step("Verify: div.foo produces 1 compound with 2 simples (Type + Class)")
        val result = parse_selector("div.foo")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val compound = sel.compounds[0]
        expect(compound.simples.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val s0 = compound.simples[0]
        val s1 = compound.simples[1]
        expect(s0.kind).to_equal(SimpleSelectorKind.Type)
        expect(s0.name).to_equal("div")
        expect(s1.kind).to_equal(SimpleSelectorKind.Class)
        expect(s1.name).to_equal("foo")

describe "parse_selector: descendant combinator":
    it "div p produces 2 compounds with Descendant combinator":
        # @req: REQ-BLINK-SEL-BACKTRACK
        step("Verify: div p produces 2 compounds with Descendant combinator")
        val result = parse_selector("div p")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(sel.combinators.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(sel.combinators[0]).to_equal(Combinator.Descendant)
        expect(sel.compounds[0].simples[0].name).to_equal("div")
        expect(sel.compounds[1].simples[0].name).to_equal("p")

describe "parse_selector: child combinator":
    it "ul > li produces 2 compounds with Child combinator":
        # @req: REQ-LIB-BLINK-001
        step("Verify: ul > li produces 2 compounds with Child combinator")
        val result = parse_selector("ul > li")
        expect(result.is_none()).to_equal(false)
        val sel = result.unwrap()
        expect(sel.compounds.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(sel.combinators.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(sel.combinators[0]).to_equal(Combinator.Child)
        expect(sel.compounds[0].simples[0].name).to_equal("ul")
        expect(sel.compounds[1].simples[0].name).to_equal("li")

# ---------------------------------------------------------------------------
# matches_compound tests
# ---------------------------------------------------------------------------

describe "matches_compound: type selector":
    it "node with tag div matches type selector div":
        # @req: REQ-BLINK-SEL-DESCENDANT
        step("Verify: node with tag div matches type selector div")
        val node = dom_node_new(1, NodeType.Element)
        node.tag_name = "div"
        val result = parse_selector("div")
        expect(result.is_none()).to_equal(false)
        val compound = result.unwrap().compounds[0]
        expect(matches_compound(node, compound)).to_equal(true)

describe "matches_compound: class selector":
    it "node without class foo does not match .foo selector":
        # @req: REQ-BLINK-SEL-CHILD
        step("Verify: node without class foo does not match .foo selector")
        val node = dom_node_new(2, NodeType.Element)
        node.tag_name = "div"
        # No class attribute — should not match.
        val result = parse_selector(".foo")
        expect(result.is_none()).to_equal(false)
        val compound = result.unwrap().compounds[0]
        expect(matches_compound(node, compound)).to_equal(false)

