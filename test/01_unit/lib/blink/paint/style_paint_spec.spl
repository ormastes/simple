# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md




# @cover src/lib/blink/paint/style_paint.spl 90%
# @req REQ-SSPEC-LIB
"""
# Style → Paint Chunk Specification

**Category:** Browser / Blink
**Status:** Active

## Overview

I want to hand the browser a laid-out, styled document and get back the flat
rect+colour list the existing rasterizer already knows how to paint — the
missing link between `render_lane_pipeline_spec.spl`'s proven layout output
and `paint_chunk_rasterizer_spec.spl`'s proven pixel consumer.

Up to now `StyledLayout` carried computed rects and resolved styles, but
nothing turned that into `PaintChunkRects` — the array-of-ints shape the
rasterizer walks. These examples build a real HTML+CSS document through the
same pipeline the render-lane spec proves, run it through
`paint_chunks_from_styled_layout`, and assert on the resulting rect and
colour arrays directly.

Deliberately out of scope: pixels. `PaintChunkRects` is inspectable data;
turning it into a framebuffer is a separate, already-proven consumer.

@manual_section Browser Rendering
"""

use std.spec.step

use std.spipe.*
use std.blink.dom.node.{DomTree}
use std.blink.html_parser.token.{HtmlToken, HtmlTokenKind, HtmlAttribute}
use std.blink.html_parser.tree_builder.{build_html_tree}
use std.blink.css_parser.tokenizer.{tokenize_css}
use std.blink.css_parser.parser.{parse_css, CssStyleSheet}
use std.blink.layout.style_bridge.{build_styled_layout, StyledLayout}
use std.blink.paint.style_paint.{
    paint_chunks_from_styled_layout, paint_chunk_rows_from_styled_layout
}
use std.common.ui.draw_ir.{draw_ir_embedding_config, draw_ir_source_manual}
use std.common.ui.render_opt.paint_chunk_draw_ir_lowerer.{
    paint_chunk_draw_ir_lower_composition
}
use std.skia.entity.color.{sk_color_argb}

fn _start(name: text) -> HtmlToken:
    var attrs: [HtmlAttribute] = []
    HtmlToken(kind: HtmlTokenKind.StartTag, name: name, data: "",
              attributes: attrs, self_closing: false)

fn _start_class(name: text, cls: text) -> HtmlToken:
    var attrs: [HtmlAttribute] = [HtmlAttribute(name: "class", value: cls)]
    HtmlToken(kind: HtmlTokenKind.StartTag, name: name, data: "",
              attributes: attrs, self_closing: false)

fn _end(name: text) -> HtmlToken:
    var attrs: [HtmlAttribute] = []
    HtmlToken(kind: HtmlTokenKind.EndTag, name: name, data: "",
              attributes: attrs, self_closing: false)

# <body><div class="a"></div><div class="b"></div></body>
fn _page_tree() -> DomTree:
    var tokens: [HtmlToken] = [
        _start("body"),
        _start_class("div", "a"), _end("div"),
        _start_class("div", "b"), _end("div"),
        _end("body")
    ]
    build_html_tree(tokens)

fn _sheet(source: text) -> CssStyleSheet:
    parse_css(tokenize_css(source))

describe "paint_chunks_from_styled_layout":
    it "emits one opaque rect matching the box's laid-out geometry and colour":
        # @req REQ-SSPEC-LIB
        step("emits one opaque rect matching the box's laid-out geometry and colour")
        step("style a single div red, 100x50, with a 10px margin")
        val css = "div { background-color: red; width: 100px; height: 50px; margin: 10px; }"
        val layout = build_styled_layout(_page_tree(), _sheet(css), 800.0, 600.0)

        step("flatten the styled layout into paint rects")
        val rects = paint_chunks_from_styled_layout(layout)

        step("the first div (index 1: body is index 0) sits at its laid-out left/top")
        match layout.rect_for(2):
            Some(r):
                expect(rects.rect_x[1]).to_equal(r.0.to_i64())
                expect(rects.rect_y[1]).to_equal(r.1.to_i64())
            None:
                expect("first div laid out").to_equal("it did not")

        step("width/height come from CSS, unaffected by margin")
        expect(rects.rect_w[1]).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(rects.rect_h[1]).to_equal(50)  # oracle: 50 — named expected value from the requirement

        step("colour is packed opaque red, matching the sk_color_argb oracle")
        expect(rects.colour[1]).to_equal(sk_color_argb(255, 255, 0, 0))

        step("body plus both divs each contributed a rect")
        expect(rects.rect_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "contributes no rect for a display:none element":
        # @req REQ-SSPEC-LIB
        step("contributes no rect for a display:none element")
        step("hide the second div through the stylesheet")
        val css = "div { background-color: blue; width: 100px; height: 20px; } .b { display: none; }"
        val layout = build_styled_layout(_page_tree(), _sheet(css), 800.0, 600.0)

        step("flatten the styled layout into paint rects")
        val rects = paint_chunks_from_styled_layout(layout)

        step("only body and the visible div contributed a rect")
        expect(rects.rect_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "still emits a rect for a box with an unset (transparent) background":
        # @req REQ-SSPEC-LIB
        step("still emits a rect for a box with an unset (transparent) background")
        step("lay out a div with no background-color declared")
        val css = "div { width: 40px; height: 20px; }"
        val layout = build_styled_layout(_page_tree(), _sheet(css), 800.0, 600.0)

        step("flatten the styled layout into paint rects")
        val rects = paint_chunks_from_styled_layout(layout)

        step("no skip-optimization: every box's rect exists, with fully transparent colour")
        expect(rects.rect_count).to_equal(3)
        expect(rects.colour[0]).to_equal(0)
        expect(rects.colour[1]).to_equal(0)

    it "keeps transparent backgrounds in retained rows instead of inferring occlusion":
        val css = "div { width: 40px; height: 20px; }"
        val layout = build_styled_layout(_page_tree(), _sheet(css), 800.0, 600.0)

        val rows = paint_chunk_rows_from_styled_layout(layout)

        expect(rows.valid).to_equal(true)
        expect(rows.rects.rect_count).to_equal(3)
        expect(rows.chunks.chunk_count).to_equal(3)
        expect(rows.rects.colour[0]).to_equal(0)
        expect(rows.rects.colour[1]).to_equal(0)
        expect(rows.stable_command_ids[1]).to_equal("blink-bg:2:0")

    it "emits paired retained rows with semantic stable ids in the direct paint order":
        val css = "div { background-color: red; width: 20px; height: 10px; }"
        val layout = build_styled_layout(_page_tree(), _sheet(css), 800.0, 600.0)

        val rows = paint_chunk_rows_from_styled_layout(layout)

        expect(rows.valid).to_equal(true)
        expect(rows.reason).to_equal("")
        expect(rows.chunks.chunk_count).to_equal(rows.rects.rect_count)
        expect(rows.stable_command_ids.len()).to_equal(rows.rects.rect_count)
        expect(rows.stable_command_ids[0]).to_equal("blink-bg:1:0")
        expect(rows.stable_command_ids[1]).to_equal("blink-bg:2:0")
        expect(rows.stable_command_ids[2]).to_equal("blink-bg:3:0")
        expect(rows.chunks.owner[1]).to_equal(2u32)
        expect(rows.chunks.order[2]).to_equal(2u32)

        val lowered = paint_chunk_draw_ir_lower_composition(
            rows.chunks, rows.rects, rows.stable_command_ids,
            "blink-composition", "blink-scene", "cpu", "blink-backgrounds",
            draw_ir_embedding_config("blink-surface", "blink-root", 0, 0, 800, 600, 0, 1000, true),
            draw_ir_source_manual())
        expect(lowered.valid).to_equal(true)
        if val composition = lowered.composition:
            expect(composition.batches.len()).to_equal(1)
            expect(composition.batches[0].commands[0].component_id).to_equal("blink-bg:1:0")
            expect(composition.batches[0].commands[2].component_id).to_equal("blink-bg:3:0")
        else:
            expect("lowered composition").to_equal("missing")
