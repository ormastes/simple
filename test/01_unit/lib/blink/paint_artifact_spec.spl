"""
## Purpose and audience
Purpose: Prove that PaintArtifact.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LIB-BLINK-001 — stable requirement identity for this spec.

# Tests for blink::PaintArtifact and PaintChunk types.

use std.blink.entity.paint_artifact.{PaintArtifact, PaintChunk, PaintChunkProperties}
use std.common.render_scene.paint_types.{DisplayItem, PaintOp}

fn _item(z: i64) -> DisplayItem:
    DisplayItem.create(z_index: z, op: PaintOp.Clip(x: 0.0, y: 0.0, w: 1.0, h: 1.0))

use std.spec.step

describe "PaintArtifact":
    it "empty artifact has zero chunks":
        step("Verify: empty artifact has zero chunks")
        # @req: REQ-LIB-BLINK-001
        val artifact = PaintArtifact.empty()
        expect(artifact.chunk_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "empty artifact has zero items":
        step("Verify: empty artifact has zero items")
        val artifact = PaintArtifact.empty()
        expect(artifact.item_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "counts reflect the items and chunks it was built from":
        step("Verify: counts reflect the items and chunks it was built from")
        val props = PaintChunkProperties.root()
        val artifact = PaintArtifact.create(
            items: [_item(0), _item(1), _item(2)],
            chunks: [PaintChunk.create(begin_index: 0, end_index: 2, properties: props),
                     PaintChunk.create(begin_index: 2, end_index: 3, properties: props)])
        expect(artifact.item_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(artifact.chunk_count()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "item_count and chunk_count are independent counts":
        step("Verify: item_count and chunk_count are independent counts")
        val props = PaintChunkProperties.root()
        val artifact = PaintArtifact.create(
            items: [_item(0), _item(1), _item(2), _item(3), _item(4)],
            chunks: [PaintChunk.create(begin_index: 0, end_index: 5, properties: props)])
        expect(artifact.item_count()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(artifact.chunk_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

describe "PaintChunkProperties":
    it "root properties have all ids 0":
        step("Verify: root properties have all ids 0")
        val props = PaintChunkProperties.root()
        expect(props.transform_id).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(props.clip_id).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(props.effect_id).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "equals is true only when all three ids match":
        step("Verify: equals is true only when all three ids match")
        val a = PaintChunkProperties(transform_id: 7, clip_id: 2, effect_id: 3)
        val same = PaintChunkProperties(transform_id: 7, clip_id: 2, effect_id: 3)
        expect(a.equals(same)).to_equal(true)
        expect(a.equals(PaintChunkProperties(transform_id: 8, clip_id: 2, effect_id: 3))).to_equal(false)
        expect(a.equals(PaintChunkProperties(transform_id: 7, clip_id: 9, effect_id: 3))).to_equal(false)
        expect(a.equals(PaintChunkProperties(transform_id: 7, clip_id: 2, effect_id: 4))).to_equal(false)
        expect(a.equals(PaintChunkProperties.root())).to_equal(false)

describe "PaintChunk":
    it "create stores begin and end indices":
        step("Verify: create stores begin and end indices")
        val props = PaintChunkProperties.root()
        val chunk = PaintChunk.create(begin_index: 4, end_index: 9, properties: props)
        expect(chunk.begin_index).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(chunk.end_index).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "create stores property triple":
        step("Verify: create stores property triple")
        val props = PaintChunkProperties(transform_id: 1, clip_id: 2, effect_id: 3)
        val chunk = PaintChunk.create(begin_index: 0, end_index: 1, properties: props)
        expect(chunk.properties.transform_id).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(chunk.properties.clip_id).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(chunk.properties.effect_id).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "size is the half-open span of the covered items":
        step("Verify: size is the half-open span of the covered items")
        val props = PaintChunkProperties.root()
        expect(PaintChunk.create(begin_index: 4, end_index: 9, properties: props).size()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(PaintChunk.create(begin_index: 2, end_index: 3, properties: props).size()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "is_empty only when begin equals end":
        step("Verify: is_empty only when begin equals end")
        val props = PaintChunkProperties.root()
        expect(PaintChunk.create(begin_index: 3, end_index: 3, properties: props).is_empty()).to_equal(true)
        expect(PaintChunk.create(begin_index: 3, end_index: 4, properties: props).is_empty()).to_equal(false)
