# @req REQ-KPF-008
# @cover src/tool/kernel_plugin_schema/abi_vectors.spl
# @cover src/tool/kernel_plugin_schema/generate_simple.spl

use std.spec.step
use test.unit.tool.kernel_plugin_schema.generated.simple_echo_schema.{kpf_abi_layout_vectors_v1, kpf_validate_abi_layout_vector_v1}

describe "generated Simple KPF malformed ABI layout corpus":
    it "accepts only the canonical valid vectors":
        step("validate truncation oversize reserved offset and alignment cases")
        val vectors = kpf_abi_layout_vectors_v1()
        expect(vectors.len()).to_equal(9)
        for vector in vectors:
            expect(kpf_validate_abi_layout_vector_v1(vector)).to_equal(vector.expected_valid)

