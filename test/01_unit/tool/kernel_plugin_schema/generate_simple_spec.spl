# @req REQ-KPF-SCHEMA-003
# @cover src/tool/kernel_plugin_schema/generate_simple.spl

use std.spec.step
use tool.kernel_plugin_schema.compiler.{compile_kpf_schema}
use tool.kernel_plugin_schema.generate_simple.{generate_simple_schema_module}

fn schema_ab() -> text:
    """package: example.echo
version: 1.0
interfaces:
  - name: Query
    major: 1
    operations:
      - name: submit
        required: true
      - name: poll
        required: false
  - name: Admin
    major: 2
    operations:
      - name: close
        required: true
"""

fn schema_ba() -> text:
    """version: 1.0
package: example.echo
interfaces:
  - operations:
      - required: true
        name: close
    major: 2
    name: Admin
  - operations:
      - required: false
        name: poll
      - required: true
        name: submit
    major: 1
    name: Query
"""

describe "KPF Simple binding generator":
    it "is deterministic under canonical schema reordering":
        step("generate Simple bindings from equivalent schemas")
        val first = generate_simple_schema_module(compile_kpf_schema(schema_ab()).unwrap())
        val second = generate_simple_schema_module(compile_kpf_schema(schema_ba()).unwrap())
        expect(first).to_equal(second)

    it "projects canonical identities masks and operation order":
        step("compare generated Simple constants with canonical IR")
        val package_ir = compile_kpf_schema(schema_ab()).unwrap()
        val generated = generate_simple_schema_module(package_ir)
        expect(generated).to_contain("pub const KPF_SCHEMA_DIGEST: text = \"{package_ir.schema_digest}\"")
        expect(generated).to_contain("pub const KPF_INTERFACE_Admin_ID: text = \"{package_ir.interfaces[0].interface_id}\"")
        expect(generated).to_contain("pub const KPF_INTERFACE_Query_REQUIRED_OPERATION_MASK: u64 = 2u64")
        expect(generated).to_contain("KPF_INTERFACE_Query_OPERATION_poll_SLOT: u32 = 0")
        expect(generated).to_contain("KPF_INTERFACE_Query_OPERATION_poll_ID: text = \"{package_ir.interfaces[1].operations[0].operation_id}\"")
        expect(generated).to_contain("KPF_INTERFACE_Query_OPERATION_submit_SLOT: u32 = 1")
        expect(generated).to_contain("KPF_INTERFACE_Query_OPERATION_submit_ID: text = \"{package_ir.interfaces[1].operations[1].operation_id}\"")

    it "emits a dependency-free compilable module shape":
        step("inspect the generated Simple module boundary")
        val generated = generate_simple_schema_module(compile_kpf_schema(schema_ab()).unwrap())
        expect(generated).to_start_with("# Generated by simple KPF schema compiler. Do not edit.\n")
        expect(generated).to_contain("pub const KPF_ABI_V1: u32 = 1")
        expect(generated).to_contain("pub const KPF_PACKAGE_NAME: text = \"example.echo\"")
        expect(generated).to_contain("pub const KPF_PACKAGE_VERSION: text = \"1.0\"")
        expect(generated).to_end_with("\n")

    it "rejects malformed portable interface identifiers before generation":
        step("compile a schema with an invalid interface identifier")
        val result = compile_kpf_schema("""package: example.echo
version: 1.0
interfaces:
  - name: query-service
    major: 1
    operations:
      - name: submit
        required: true
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("interface.name must use ASCII letters, digits, or underscore")

    it "rejects malformed portable operation identifiers before generation":
        step("compile a schema with an invalid operation identifier")
        val result = compile_kpf_schema("""package: example.echo
version: 1.0
interfaces:
  - name: Query
    major: 1
    operations:
      - name: 2submit
        required: true
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("must not start with a digit")
