# @req REQ-KPF-008
# @cover src/tool/kernel_plugin_schema/generate_worker_wire.spl

use std.spec.step
use test.unit.tool.kernel_plugin_schema.generated.example_echo_worker_wire.*

describe "generated KPF worker-wire bounds":
    it "accepts only the canonical envelope identity":
        step("mutate magic version size digest and reserved fields")
        expect(kpf_worker_wire_validate_envelope_v1(1263552087u32, 1u32, 112, KPF_WORKER_WIRE_SCHEMA_DIGEST, 0u64)).to_be(true)
        expect(kpf_worker_wire_validate_envelope_v1(0u32, 1u32, 112, KPF_WORKER_WIRE_SCHEMA_DIGEST, 0u64)).to_be(false)
        expect(kpf_worker_wire_validate_envelope_v1(1263552087u32, 2u32, 112, KPF_WORKER_WIRE_SCHEMA_DIGEST, 0u64)).to_be(false)
        expect(kpf_worker_wire_validate_envelope_v1(1263552087u32, 1u32, 111, KPF_WORKER_WIRE_SCHEMA_DIGEST, 0u64)).to_be(false)
        expect(kpf_worker_wire_validate_envelope_v1(1263552087u32, 1u32, 112, "wrong", 0u64)).to_be(false)
        expect(kpf_worker_wire_validate_envelope_v1(1263552087u32, 1u32, 112, KPF_WORKER_WIRE_SCHEMA_DIGEST, 1u64)).to_be(false)

    it "accepts exact empty and bounded payload frames":
        step("validate canonical empty and payload-bearing frames")
        expect(kpf_worker_wire_validate_bounds_v1(112, 112, 0, 4096)).to_be(true)
        expect(kpf_worker_wire_validate_bounds_v1(144, 112, 32, 4096)).to_be(true)

    it "rejects malformed offsets lengths and frame limits":
        step("mutate every worker frame bounds authority")
        expect(kpf_worker_wire_validate_bounds_v1(111, 112, 0, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(144, 111, 32, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(144, 145, 0, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(144, 112, -1, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(144, 112, 33, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(4097, 112, 0, 4096)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(112, 112, 0, 111)).to_be(false)
        expect(kpf_worker_wire_validate_bounds_v1(112, 112, 0, 4194305)).to_be(false)

    it "rejects unknown dispatch slots and preserves requiredness":
        step("validate canonical dense worker dispatch slots")
        expect(kpf_worker_wire_operation_known_v1(0, 0)).to_be(true)
        expect(kpf_worker_wire_operation_known_v1(1, 1)).to_be(true)
        expect(kpf_worker_wire_operation_known_v1(-1, 0)).to_be(false)
        expect(kpf_worker_wire_operation_known_v1(2, 0)).to_be(false)
        expect(kpf_worker_wire_operation_known_v1(1, 2)).to_be(false)
        expect(kpf_worker_wire_operation_required_v1(0, 0)).to_be(true)
        expect(kpf_worker_wire_operation_required_v1(1, 0)).to_be(false)
        expect(kpf_worker_wire_operation_required_v1(1, 1)).to_be(true)
