#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
fixture="$repo_root/test/fixtures/kernel_plugin_schema/generated/example_echo.wit"

test "$(shasum -a 256 "$fixture" | awk '{print $1}')" = '952dc4bef4d924937c3c0d37da72f247ccbd293d3ab1cb99383b0ba7e306929a'
test "$(sed -n '1p' "$fixture")" = '// Generated by simple KPF schema compiler. Do not edit.'
test "$(grep -c '^package example:echo;$' "$fixture")" -eq 1
test "$(grep -c '^interface ' "$fixture")" -eq 2
test "$(grep -c '^  export ' "$fixture")" -eq 2
test "$(grep -c 'func(input: list<u8>) -> result<list<u8>, kpf-error>;' "$fixture")" -eq 3
test "$(grep -c '^  // kpf-operation-id: [0-9a-f][0-9a-f]*$' "$fixture")" -eq 3
test "$(grep -c '^  // kpf-operation-slot: ' "$fixture")" -eq 3
test "$(grep -c '^  // kpf-operation-required: true$' "$fixture")" -eq 2
test "$(grep -c '^  // kpf-operation-required: false$' "$fixture")" -eq 1

if command -v wasm-tools >/dev/null 2>&1; then
    wasm-tools component wit "$fixture" >/dev/null
fi

printf '%s\n' 'KPF_GENERATED_WIT_FIXTURE: PASS'
