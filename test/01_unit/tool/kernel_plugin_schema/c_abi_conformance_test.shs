#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
build_dir=$(mktemp -d "${TMPDIR:-/tmp}/simple-kpf-c-abi.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM

cc -std=c11 -Wall -Wextra -Werror \
    -I"$repo_root/include" \
    "$repo_root/test/01_unit/tool/kernel_plugin_schema/c_abi_layout.c" \
    -o "$build_dir/c_abi_layout"
"$build_dir/c_abi_layout"

c++ -std=c++17 -Wall -Wextra -Werror \
    -I"$repo_root/include" \
    -x c++ "$repo_root/test/01_unit/tool/kernel_plugin_schema/c_abi_layout.c" \
    -o "$build_dir/c_abi_layout_cpp"
"$build_dir/c_abi_layout_cpp"
