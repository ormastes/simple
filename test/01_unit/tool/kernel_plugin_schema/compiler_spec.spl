# @req REQ-KPF-SCHEMA-001
# @req REQ-KPF-SCHEMA-002
# @req REQ-KPF-SCHEMA-003
# @cover src/tool/kernel_plugin_schema/compiler.spl

use std.spec.step
use tool.kernel_plugin_schema.compiler.{compile_kpf_schema}
use tool.kernel_plugin_schema.compatibility.{check_kpf_compatibility}
use tool.kernel_plugin_schema.generate_c.{generate_c_header}
use tool.kernel_plugin_schema.generate_cpp.{generate_cpp_schema_header}
use tool.kernel_plugin_schema.generate_rust.{generate_rust_schema_module}
use tool.kernel_plugin_schema.generate_simple.{generate_simple_schema_module}

fn schema_ab() -> text:
    """package: example.echo
version: 1.0
interfaces:
  - name: Query
    major: 1
    operations:
      - name: poll
        required: false
      - name: submit
        required: true
  - name: Admin
    major: 2
    operations:
      - name: close
        required: true
"""

fn schema_ba() -> text:
    """version: 1.0
package: example.echo
interfaces:
  - name: Admin
    operations:
      - required: true
        name: close
    major: 2
  - operations:
      - required: true
        name: submit
      - required: false
        name: poll
    major: 1
    name: Query
"""

describe "KPF schema compiler":
    it "generates a deterministic canonical C ABI prefix":
        step("generate C headers from reordered equivalent schemas")
        val first = generate_c_header(compile_kpf_schema(schema_ab()).unwrap())
        val second = generate_c_header(compile_kpf_schema(schema_ba()).unwrap())
        expect(first).to_equal(second)
        expect(first).to_contain("#define SIMPLE_KPF_ABI_V1 UINT32_C(1)")
        expect(first).to_contain("typedef struct simple_kpf_interface_query_v1")
        expect(first).to_contain("simple_kpf_output_buffer_v1 *output")
        expect(first).to_contain("simple_kpf_submit_batch_fn_v1 submit_batch")
        expect(first).to_contain("SIMPLE_KPF_INTERFACE_example_echo_Query_MAJOR UINT32_C(1)")

    it "canonicalizes equivalent SDN and assigns deterministic identities":
        step("compile reordered equivalent KPF schemas")
        val first = compile_kpf_schema(schema_ab()).unwrap()
        val second = compile_kpf_schema(schema_ba()).unwrap()
        expect(first.canonical_schema).to_equal(second.canonical_schema)
        expect(first.schema_digest).to_equal(second.schema_digest)
        expect(first.schema_digest.len()).to_equal(64)
        expect(first.interfaces[0].name).to_equal("Admin")
        expect(first.interfaces[1].operations[0].name).to_equal("poll")
        expect(first.interfaces[1].operations[1].name).to_equal("submit")
        expect(first.interfaces[1].required_operation_mask).to_equal(2)
        expect(first.interfaces[1].interface_id.len()).to_equal(32)

    it "generates deterministic matching Rust and C++ schema projections":
        step("generate Rust and C++ outputs from reordered equivalent schemas")
        val package_ir = compile_kpf_schema(schema_ab()).unwrap()
        val rust_first = generate_rust_schema_module(package_ir)
        val rust_second = generate_rust_schema_module(compile_kpf_schema(schema_ba()).unwrap())
        val cpp_first = generate_cpp_schema_header(package_ir)
        val cpp_second = generate_cpp_schema_header(compile_kpf_schema(schema_ba()).unwrap())
        expect(rust_first).to_equal(rust_second)
        expect(cpp_first).to_equal(cpp_second)
        expect(rust_first).to_contain("pub const OPERATION_poll_SLOT: u32 = 0")
        expect(rust_first).to_contain("pub const OPERATION_submit_SLOT: u32 = 1")
        expect(cpp_first).to_contain("inline constexpr std::uint32_t operation_poll_slot = 0")
        expect(cpp_first).to_contain("inline constexpr std::uint64_t required_operation_mask = 2ULL")

    it "projects one canonical malformed ABI layout corpus into every binding":
        step("generate Simple C Rust and C++ ABI layout vectors")
        val package_ir = compile_kpf_schema(schema_ab()).unwrap()
        val simple = generate_simple_schema_module(package_ir)
        val c = generate_c_header(package_ir)
        val rust = generate_rust_schema_module(package_ir)
        val cpp = generate_cpp_schema_header(package_ir)
        for generated in [simple, c, rust, cpp]:
            expect(generated).to_contain("valid_append_only_tail")
            expect(generated).to_contain("truncated_prefix")
            expect(generated).to_contain("declared_oversize")
            expect(generated).to_contain("reserved_nonzero")
            expect(generated).to_contain("offset_length_overflow")
            expect(generated).to_contain("misaligned_offset")
            expect(generated).to_contain("invalid_alignment")

    it "accepts append-only optional operations and rejects breaking evolution":
        step("compare canonical schema revisions")
        val previous = compile_kpf_schema(schema_ab()).unwrap()
        val appended = compile_kpf_schema("""package: example.echo
version: 1.1
interfaces:
  - name: Query
    major: 1
    operations:
      - name: poll
        required: false
      - name: submit
        required: true
      - name: trace
        required: false
  - name: Admin
    major: 2
    operations:
      - name: close
        required: true
""").unwrap()
        val breaking = compile_kpf_schema("""package: example.echo
version: 2.0
interfaces:
  - name: Query
    major: 1
    operations:
      - name: poll
        required: true
      - name: submit
        required: true
  - name: Admin
    major: 2
    operations:
      - name: close
        required: true
""").unwrap()
        expect(check_kpf_compatibility(previous, appended).compatible).to_be(true)
        val result = check_kpf_compatibility(previous, breaking)
        expect(result.compatible).to_be(false)
        expect(result.summary).to_contain("optional operation Query.poll became required")

    it "rejects duplicate interface names":
        step("compile a schema with duplicate interface names")
        val result = compile_kpf_schema("""package: duplicate.interfaces
version: 1
interfaces:
  - name: Echo
    major: 1
    operations:
      - name: run
        required: true
  - name: Echo
    major: 1
    operations:
      - name: stop
        required: true
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("duplicate interface name Echo")

    it "rejects duplicate operation names":
        step("compile an interface with duplicate operation names")
        val result = compile_kpf_schema("""package: duplicate.operations
version: 1
interfaces:
  - name: Echo
    major: 1
    operations:
      - name: run
        required: true
      - name: run
        required: false
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("duplicate operation name Echo.run")

    it "requires every operation to declare whether it is required":
        step("compile an operation missing its required declaration")
        val result = compile_kpf_schema("""package: missing.required
version: 1
interfaces:
  - name: Echo
    major: 1
    operations:
      - name: run
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("missing required interface Echo operation run.required")

    it "rejects names that cannot produce portable SDK identifiers":
        step("compile an interface with punctuation in an operation name")
        val result = compile_kpf_schema("""package: invalid.identifiers
version: 1
interfaces:
  - name: Echo
    major: 1
    operations:
      - name: run-now
        required: true
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("must use ASCII letters, digits, or underscore")

    it "rejects duplicate SDN keys rather than accepting last-wins input":
        step("compile a schema containing a duplicate package key")
        val result = compile_kpf_schema("""package: first
package: second
version: 1
interfaces: []
""")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_contain("duplicate SDN key")
