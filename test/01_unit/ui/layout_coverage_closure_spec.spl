# @cover src/lib/common/ui/layout.spl none
"""
## Purpose and audience
Purpose: returns 0 (auto) when the columns prop is unset
Audience: compiler and tooling engineers who maintain this spec

# UI Layout — Coverage Closure Spec (U4.6, part 1/2)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md)
requires a measured line-% for this unit's acceptance criterion. That
measurement is GATED: U1.3 (the unit that would build the measurement
primitive) has not landed — see
doc/08_tracking/bug/coverage_tooling_does_not_instrument_spl_2026-08-07.md.

Per the plan's own outcome-2 fallback ("substitute the enumerated-proxy /
existence citation"), this spec instead does a STATIC spec-reference
cross-check, the same method U4.1 used (test/01_unit/os/compositor/
host_compositor_core_coverage_closure_spec.spl): every `fn` in
src/lib/common/ui/layout.spl (19 total, enumerated via
`grep -n "^fn "`) was checked against every existing spec under test/ that
references it (ripgrep -l per symbol, whole `test/` tree). 11 of the 19 had
zero references anywhere in test/. This spec closes all 11 with real oracles
(return-value assertions, not bare calls):

  get_grid_columns, get_col_span, layout_fixed, get_fixed_width, get_flex,
  get_min_width, get_max_width, get_min_height, get_max_height, clamp_dim,
  and indirectly _apply_scale's non-identity branch (private, leading
  underscore, not directly importable — exercised here through
  compute_layout's scale_permille arg, which is the only caller).

No percentage is reported or implied by this spec's existence — this is a
static reference-count closure, explicitly labeled as such, not a coverage
measurement.
"""

# @req: REQ-UI-LayoCoveClos-001

use std.spec.{describe, it, expect}
use common.ui.widget.{WidgetNode}
use common.ui.builder.{panel, text_widget, column}
use common.ui.layout.{
    compute_layout,
    get_grid_columns,
    get_col_span,
    layout_fixed,
    get_fixed_width,
    get_flex,
    get_min_width,
    get_max_width,
    get_min_height,
    get_max_height,
    clamp_dim
}

use std.spec.step
describe "get_grid_columns (U4.6 closure)":

    it "returns 0 (auto) when the columns prop is unset":
        step("Verify: returns 0 (auto) when the columns prop is unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("gc1", "T", [])
        expect(get_grid_columns(n)).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns the parsed columns prop when set":
        step("Verify: returns the parsed columns prop when set")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("gc2", "T", [])
        n = n.set_prop("columns", "3")
        expect(get_grid_columns(n)).to_equal(3)  # oracle: value fixed by the spec contract

describe "get_col_span (U4.6 closure)":

    it "defaults to 1 when col_span is unset":
        step("Verify: defaults to 1 when col_span is unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("cs1", "T", [])
        expect(get_col_span(n)).to_equal(1)  # oracle: value fixed by the spec contract

    it "returns the parsed col_span when set to a valid positive value":
        step("Verify: returns the parsed col_span when set to a valid positive value")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("cs2", "T", [])
        n = n.set_prop("col_span", "2")
        expect(get_col_span(n)).to_equal(2)  # oracle: value fixed by the spec contract

    it "clamps a col_span below 1 up to 1 (both-directions oracle)":
        step("Verify: clamps a col_span below 1 up to 1 (both-directions oracle)")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("cs3", "T", [])
        n = n.set_prop("col_span", "0")
        expect(get_col_span(n)).to_equal(1)  # oracle: value fixed by the spec contract

describe "get_fixed_width (U4.6 closure)":

    it "returns 0 when width is unset":
        step("Verify: returns 0 when width is unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("fw1", "T", [])
        expect(get_fixed_width(n)).to_equal(0)  # oracle: value fixed by the spec contract

    it "returns the parsed width prop when set":
        step("Verify: returns the parsed width prop when set")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("fw2", "T", [])
        n = n.set_prop("width", "42")
        expect(get_fixed_width(n)).to_equal(42)  # oracle: value fixed by the spec contract

describe "get_flex (U4.6 closure)":

    it "defaults to 1 when flex is unset":
        step("Verify: defaults to 1 when flex is unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("fl1", "T", [])
        expect(get_flex(n)).to_equal(1)  # oracle: value fixed by the spec contract

    it "returns the parsed flex prop when set to a positive value":
        step("Verify: returns the parsed flex prop when set to a positive value")
