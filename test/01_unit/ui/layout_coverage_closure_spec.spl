        var n = panel("fl2", "T", [])
        n = n.set_prop("flex", "5")
        expect(get_flex(n)).to_equal(5)  # oracle: value fixed by the spec contract

    it "clamps a negative flex to 0 (both-directions oracle)":
        step("Verify: clamps a negative flex to 0 (both-directions oracle)")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("fl3", "T", [])
        n = n.set_prop("flex", "-2")
        expect(get_flex(n)).to_equal(0)  # oracle: value fixed by the spec contract

describe "get_min_width / get_max_width (U4.6 closure)":

    it "defaults min_width to 0 and max_width to -1 (unset) when unset":
        step("Verify: defaults min_width to 0 and max_width to -1 (unset) when unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("mw1", "T", [])
        expect(get_min_width(n)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(get_max_width(n)).to_equal(-1)  # oracle: value fixed by the spec contract

    it "returns the parsed min_width / max_width props when set":
        step("Verify: returns the parsed min_width / max_width props when set")
        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("mw2", "T", [])
        n = n.set_prop("min_width", "10")
        n = n.set_prop("max_width", "80")
        expect(get_min_width(n)).to_equal(10)  # oracle: value fixed by the spec contract
        expect(get_max_width(n)).to_equal(80)  # oracle: value fixed by the spec contract

describe "get_min_height / get_max_height (U4.6 closure)":

    it "defaults min_height to 0 and max_height to -1 (unset) when unset":
        step("Verify: defaults min_height to 0 and max_height to -1 (unset) when unset")
        # @req: REQ-UI-LayoCoveClos-001
        val n = panel("mh1", "T", [])
        expect(get_min_height(n)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(get_max_height(n)).to_equal(-1)  # oracle: value fixed by the spec contract

    it "returns the parsed min_height / max_height props when set":
