        # @req: REQ-UI-LayoCoveClos-001
        var n = panel("mh2", "T", [])
        n = n.set_prop("min_height", "5")
        n = n.set_prop("max_height", "50")
        expect(get_min_height(n)).to_equal(5)  # oracle: value fixed by the spec contract
        expect(get_max_height(n)).to_equal(50)  # oracle: value fixed by the spec contract

describe "clamp_dim (U4.6 closure)":

    it "passes a value through unchanged when inside [min_v, max_v]":
        step("Verify: passes a value through unchanged when inside [min_v, max_v]")
        # @req: REQ-UI-LayoCoveClos-001
        expect(clamp_dim(15, 0, 30)).to_equal(15)  # oracle: value fixed by the spec contract

    it "clamps to max_v when the size exceeds it":
        step("Verify: clamps to max_v when the size exceeds it")
        # @req: REQ-UI-LayoCoveClos-001
        expect(clamp_dim(50, 0, 30)).to_equal(30)  # oracle: value fixed by the spec contract

    it "clamps to min_v when the size is below it (both-directions oracle)":
        step("Verify: clamps to min_v when the size is below it (both-directions oracle)")
        # @req: REQ-UI-LayoCoveClos-001
        expect(clamp_dim(-5, 2, 30)).to_equal(2)  # oracle: value fixed by the spec contract

    it "treats a negative max_v as uncapped":
        step("Verify: treats a negative max_v as uncapped")
        # @req: REQ-UI-LayoCoveClos-001
        expect(clamp_dim(1000, 0, -1)).to_equal(1000)  # oracle: value fixed by the spec contract

    it "never returns a negative size even after clamping up to a negative min_v":
        step("Verify: never returns a negative size even after clamping up to a negative min_v")
        # @req: REQ-UI-LayoCoveClos-001
        expect(clamp_dim(-100, -50, -1)).to_equal(0)  # oracle: value fixed by the spec contract

describe "layout_fixed (U4.6 closure)":

    it "positions every child at the full parent inner rect when no widths/heights are fixed":
        step("Verify: positions every child at the full parent inner rect when no widths/heights are fixed")
        # @req: REQ-UI-LayoCoveClos-001
        val a = text_widget("lfx_a", "A")
        val b = text_widget("lfx_b", "B")
        # column() builds a WidgetKind.Panel container, which compute_layout
        # insets by a 1px border on every side before laying out children —
        # so the inner rect handed to layout_fixed is (w-2, h-2), not (w, h).
        val parent = column("lfx_root", [a, b]).set_layout("fixed")
        val rects = compute_layout(parent, 0, 0, 100, 60)
        expect(rects.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(rects[1].w).to_equal(98)  # oracle: value fixed by the spec contract
        expect(rects[1].h).to_equal(58)  # oracle: value fixed by the spec contract
        expect(rects[2].w).to_equal(98)  # oracle: value fixed by the spec contract
        expect(rects[2].h).to_equal(58)  # oracle: value fixed by the spec contract

    it "honours a fixed width/height on individual children (both-directions oracle)":
        step("Verify: honours a fixed width/height on individual children (both-directions oracle)")
        # @req: REQ-UI-LayoCoveClos-001
        var a = text_widget("lfx2_a", "A")
        a = a.set_prop("width", "20")
        a = a.set_prop("height", "10")
        val parent = column("lfx2_root", [a]).set_layout("fixed")
        val rects = compute_layout(parent, 0, 0, 100, 60)
        expect(rects.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(rects[1].w).to_equal(20)  # oracle: value fixed by the spec contract
        expect(rects[1].h).to_equal(10)  # oracle: value fixed by the spec contract

describe "compute_layout non-identity scale_permille (U4.6 closure, exercises _apply_scale's scaled branch)":

    it "scales the root rect by the given permille factor instead of the identity default":
        step("Verify: scales the root rect by the given permille factor instead of the identity default")
        # @req: REQ-UI-LayoCoveClos-001
        val leaf = text_widget("scale_leaf", "L")
        val rects = compute_layout(leaf, 10, 10, 100, 100, 500)
        expect(rects[0].x).to_equal(5)  # oracle: value fixed by the spec contract
        expect(rects[0].y).to_equal(5)  # oracle: value fixed by the spec contract
        expect(rects[0].w).to_equal(50)  # oracle: value fixed by the spec contract
        expect(rects[0].h).to_equal(50)  # oracle: value fixed by the spec contract

    it "leaves the rect unchanged at the identity permille factor (both-directions oracle)":
        step("Verify: leaves the rect unchanged at the identity permille factor (both-directions oracle)")
        # @req: REQ-UI-LayoCoveClos-001
        val leaf = text_widget("scale_leaf_id", "L")
        val rects = compute_layout(leaf, 10, 10, 100, 100, 1000)
        expect(rects[0].x).to_equal(10)  # oracle: value fixed by the spec contract
        expect(rects[0].w).to_equal(100)  # oracle: value fixed by the spec contract
