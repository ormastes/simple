# @cover src/lib/common/ui/wm_app_process_contract.spl none
"""
## Purpose and audience
Purpose: joins the prefix with the resolved backend token
Audience: compiler and tooling engineers who maintain this spec

# WM App Process Contract — Coverage Closure Spec (U4.6, part 2/2)

Wave 4 of the WM/GUI/web system-test coverage plan
(doc/03_plan/ui/testing/wm_gui_web_system_test_coverage_plan_2026-08-07.md)
requires a measured line-% for this unit's acceptance criterion. That
measurement is GATED: U1.3 (the unit that would build the measurement
primitive) has not landed — see
doc/08_tracking/bug/coverage_tooling_does_not_instrument_spl_2026-08-07.md.

Per the plan's own outcome-2 fallback ("substitute the enumerated-proxy /
existence citation"), this spec instead does a STATIC spec-reference
cross-check, the same method U4.1 used
(test/01_unit/os/compositor/host_compositor_core_coverage_closure_spec.spl):
every `fn` in src/lib/common/ui/wm_app_process_contract.spl (51 total,
enumerated via `grep -n "^fn "`) was checked against every existing spec
under test/ that references it (ripgrep -l per symbol, whole `test/` tree).
25 had zero references anywhere in test/: 20 public functions and 5 private
(leading-underscore) helpers.

This spec closes all 20 zero-reference PUBLIC functions with real oracles
(return-value assertions, not bare calls):

  showcase_window_title, graphics_2d_showcase_window_title,
  web_standards_showcase_window_title, wm_showcase_window_title,
  wm_widget_showcase_content_text, wm_fs_resize_event,
  wm_graphics_2d_showcase_event_path, wm_graphics_2d_showcase_frame_seq_path,
  wm_graphics_2d_showcase_content_text,
  wm_graphics_2d_showcase_bridge_request_sized,
  wm_graphics_2d_showcase_bridge_request_sized_with_backend,
  wm_graphics_2d_showcase_bridge_request, wm_graphics_2d_showcase_client_env,
  wm_web_standards_showcase_event_path,
  wm_web_standards_showcase_frame_seq_path,
  wm_web_standards_showcase_content_text,
  wm_web_standards_showcase_bridge_request_sized,
  wm_web_standards_showcase_bridge_request_sized_with_backend,
  wm_web_standards_showcase_bridge_request,
  wm_web_standards_showcase_client_env

The remaining 5 zero-reference functions (`_wm_bridge_value`,
`_wm_parse_i64`, `_wm_bridge_i64`, `_wm_bridge_i32`,
`_wm_event_ch_sanitized`) are leading-underscore module-private helpers, not
importable by name from a test file; they are exercised transitively through
`wm_fs_bridge_decode` / `wm_fs_app_event_decode` / `wm_fs_app_event_encode`
(which DO already have existing spec references) but are left out of this
unit's direct-closure list per the same private-helper carve-out U4.1 used.

No percentage is reported or implied by this spec's existence — this is a
static reference-count closure, explicitly labeled as such, not a coverage
measurement.
"""

# @req: REQ-UI-WmAppProcContCoveClos-001

use std.spec.{describe, it, expect}
use common.ui.wm_app_process_contract.{
    showcase_window_title,
    graphics_2d_showcase_window_title,
    web_standards_showcase_window_title,
    wm_showcase_window_title,
    wm_widget_showcase_content_text,
    wm_fs_resize_event,
    wm_graphics_2d_showcase_event_path,
    wm_graphics_2d_showcase_frame_seq_path,
    wm_graphics_2d_showcase_content_text,
    wm_graphics_2d_showcase_bridge_request_sized,
    wm_graphics_2d_showcase_bridge_request_sized_with_backend,
    wm_graphics_2d_showcase_bridge_request,
    wm_graphics_2d_showcase_client_env,
    wm_web_standards_showcase_event_path,
    wm_web_standards_showcase_frame_seq_path,
    wm_web_standards_showcase_content_text,
    wm_web_standards_showcase_bridge_request_sized,
    wm_web_standards_showcase_bridge_request_sized_with_backend,
    wm_web_standards_showcase_bridge_request,
    wm_web_standards_showcase_client_env,
    GRAPHICS_2D_SHOWCASE_APP_SOURCE,
    GRAPHICS_2D_SHOWCASE_APP_ID,
    GRAPHICS_2D_SHOWCASE_WINDOW_W,
    GRAPHICS_2D_SHOWCASE_WINDOW_H,
    WEB_STANDARDS_SHOWCASE_APP_SOURCE,
    WEB_STANDARDS_SHOWCASE_APP_ID,
    WEB_STANDARDS_SHOWCASE_WINDOW_W,
    WEB_STANDARDS_SHOWCASE_WINDOW_H,
    WM_APP_MODE_CLIENT,
    WM_BRIDGE_FILE_ENV,
    WM_FRAME_FILE_ENV,
    WM_EVENT_FILE_ENV,
    WM_FRAME_SEQ_FILE_ENV,
    WM_CLIENT_HOLD_ENV,
    WM_APP_MODE_ENV
}

use std.spec.step
describe "showcase_window_title (U4.6 closure)":

    it "joins the prefix with the resolved backend token":
        step("Verify: joins the prefix with the resolved backend token")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        expect(showcase_window_title("gui", "vulkan")).to_equal("gui_showcase_backed_simple_gui_simple_2d_vulkan")

    it "produces a different title for a different prefix (both-directions oracle)":
        step("Verify: produces a different title for a different prefix (both-directions oracle)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val a = showcase_window_title("gui", "cpu")
        val b = showcase_window_title("other", "cpu")
        expect(a == b).to_equal(false)

describe "graphics_2d_showcase_window_title / web_standards_showcase_window_title / wm_showcase_window_title (U4.6 closure)":

    it "graphics_2d uses the 2d_showcase prefix":
        step("Verify: graphics_2d uses the 2d_showcase prefix")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        expect(graphics_2d_showcase_window_title("cpu")).to_equal("2d_showcase_showcase_backed_simple_gui_simple_2d_software")

    it "web_standards uses the web_showcase prefix":
        step("Verify: web_standards uses the web_showcase prefix")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        expect(web_standards_showcase_window_title("cpu")).to_equal("web_showcase_showcase_backed_simple_gui_simple_2d_software")

    it "wm_showcase uses the wm_showcase prefix, distinct from the other two (both-directions oracle)":
        step("Verify: wm_showcase uses the wm_showcase prefix, distinct from the other two (both-directions oracle)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val wm_title = wm_showcase_window_title("cpu")
        expect(wm_title).to_equal("wm_showcase_showcase_backed_simple_gui_simple_2d_software")
        expect(wm_title == graphics_2d_showcase_window_title("cpu")).to_equal(false)
        expect(wm_title == web_standards_showcase_window_title("cpu")).to_equal(false)

describe "wm_widget_showcase_content_text (U4.6 closure)":

    it "formats source/frame/pid into the content string":
        step("Verify: formats source/frame/pid into the content string")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val content = wm_widget_showcase_content_text("src.spl", "/tmp/frame", 42)
        expect(content).to_equal("source=src.spl frame=/tmp/frame pid=42")

describe "wm_fs_resize_event (U4.6 closure)":

    it "carries the new size in x/y and marks the event kind 'resize'":
        step("Verify: carries the new size in x/y and marks the event kind 'resize'")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val ev = wm_fs_resize_event(9, 800, 600)
        expect(ev.seq).to_equal(9)  # oracle: value fixed by the spec contract
        expect(ev.kind).to_equal("resize")
        expect(ev.x).to_equal(800)  # oracle: value fixed by the spec contract
        expect(ev.y).to_equal(600)  # oracle: value fixed by the spec contract
        expect(ev.button).to_equal(0)  # oracle: value fixed by the spec contract
        expect(ev.pressed).to_equal(false)

describe "wm_graphics_2d_showcase_event_path / _frame_seq_path / _content_text (U4.6 closure)":

    it "appends .event to the frame path":
        step("Verify: appends .event to the frame path")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        expect(wm_graphics_2d_showcase_event_path("/tmp/f")).to_equal("/tmp/f.event")

    it "appends .seq to the frame path (both-directions oracle vs event path)":
        step("Verify: appends .seq to the frame path (both-directions oracle vs event path)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val seq_path = wm_graphics_2d_showcase_frame_seq_path("/tmp/f")
        expect(seq_path).to_equal("/tmp/f.seq")
        expect(seq_path == wm_graphics_2d_showcase_event_path("/tmp/f")).to_equal(false)

    it "formats the graphics-2d content text the same way as the widget-showcase family":
        step("Verify: formats the graphics-2d content text the same way as the widget-showcase family")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val content = wm_graphics_2d_showcase_content_text("g.spl", "/tmp/g", 7)
        expect(content).to_equal("source=g.spl frame=/tmp/g pid=7")

describe "wm_graphics_2d_showcase_bridge_request_sized(_with_backend) / _bridge_request (U4.6 closure)":

    it "builds a create_window request for the graphics-2d showcase with the given size and default software backend":
        step("Verify: builds a create_window request for the graphics-2d showcase with the given size and default software backend")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val req = wm_graphics_2d_showcase_bridge_request_sized(3, "/tmp/g", 400, 300)
        expect(req.kind).to_equal("create_window")
        expect(req.source_path).to_equal(GRAPHICS_2D_SHOWCASE_APP_SOURCE)
        expect(req.app_id).to_equal(GRAPHICS_2D_SHOWCASE_APP_ID)
        expect(req.pid).to_equal(3)  # oracle: value fixed by the spec contract
        expect(req.window_w).to_equal(400)  # oracle: value fixed by the spec contract
        expect(req.window_h).to_equal(300)  # oracle: value fixed by the spec contract
        expect(req.frame_path).to_equal("/tmp/g")
        expect(req.event_path).to_equal("/tmp/g.event")
        expect(req.frame_seq_path).to_equal("/tmp/g.seq")

    it "threads a non-default backend token into the title (both-directions oracle)":
        step("Verify: threads a non-default backend token into the title (both-directions oracle)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val soft = wm_graphics_2d_showcase_bridge_request_sized_with_backend(1, "/tmp/g", 10, 10, "cpu")
        val vulkan = wm_graphics_2d_showcase_bridge_request_sized_with_backend(1, "/tmp/g", 10, 10, "vulkan")
        expect(soft.title == vulkan.title).to_equal(false)
        expect(vulkan.title).to_equal(graphics_2d_showcase_window_title("vulkan"))

    it "the unsized bridge-request helper defaults to the module's showcase window dimensions":
        step("Verify: the unsized bridge-request helper defaults to the module's showcase window dimensions")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val req = wm_graphics_2d_showcase_bridge_request(5, "/tmp/g")
        expect(req.window_w).to_equal(GRAPHICS_2D_SHOWCASE_WINDOW_W)
        expect(req.window_h).to_equal(GRAPHICS_2D_SHOWCASE_WINDOW_H)
        expect(req.pid).to_equal(5)  # oracle: value fixed by the spec contract

describe "wm_graphics_2d_showcase_client_env (U4.6 closure)":

    it "populates all six WM client-mode env vars keyed off the bridge/frame paths":
        step("Verify: populates all six WM client-mode env vars keyed off the bridge/frame paths")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val env = wm_graphics_2d_showcase_client_env("/tmp/bridge", "/tmp/g")
        expect(env[WM_APP_MODE_ENV]).to_equal(WM_APP_MODE_CLIENT)
        expect(env[WM_BRIDGE_FILE_ENV]).to_equal("/tmp/bridge")
        expect(env[WM_FRAME_FILE_ENV]).to_equal("/tmp/g")
        expect(env[WM_EVENT_FILE_ENV]).to_equal("/tmp/g.event")
        expect(env[WM_FRAME_SEQ_FILE_ENV]).to_equal("/tmp/g.seq")
        expect(env[WM_CLIENT_HOLD_ENV]).to_equal("1")

describe "wm_web_standards_showcase_event_path / _frame_seq_path / _content_text (U4.6 closure)":

    it "appends .event to the frame path":
        step("Verify: appends .event to the frame path")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        expect(wm_web_standards_showcase_event_path("/tmp/w")).to_equal("/tmp/w.event")

    it "appends .seq to the frame path (both-directions oracle vs event path)":
        step("Verify: appends .seq to the frame path (both-directions oracle vs event path)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val seq_path = wm_web_standards_showcase_frame_seq_path("/tmp/w")
        expect(seq_path).to_equal("/tmp/w.seq")
        expect(seq_path == wm_web_standards_showcase_event_path("/tmp/w")).to_equal(false)

    it "formats the web-standards content text the same way as the other two families":
        step("Verify: formats the web-standards content text the same way as the other two families")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val content = wm_web_standards_showcase_content_text("w.spl", "/tmp/w", 11)
        expect(content).to_equal("source=w.spl frame=/tmp/w pid=11")

describe "wm_web_standards_showcase_bridge_request_sized(_with_backend) / _bridge_request (U4.6 closure)":

    it "builds a create_window request for the web-standards showcase, defaulting to the cpu_simd backend":
        step("Verify: builds a create_window request for the web-standards showcase, defaulting to the cpu_simd backend")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val req = wm_web_standards_showcase_bridge_request_sized(2, "/tmp/w", 88, 68)
        expect(req.kind).to_equal("create_window")
        expect(req.source_path).to_equal(WEB_STANDARDS_SHOWCASE_APP_SOURCE)
        expect(req.app_id).to_equal(WEB_STANDARDS_SHOWCASE_APP_ID)
        expect(req.window_w).to_equal(88)  # oracle: value fixed by the spec contract
        expect(req.window_h).to_equal(68)  # oracle: value fixed by the spec contract
        expect(req.event_path).to_equal("/tmp/w.event")
        expect(req.frame_seq_path).to_equal("/tmp/w.seq")

    it "threads a non-default backend token into the title (both-directions oracle)":
        step("Verify: threads a non-default backend token into the title (both-directions oracle)")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val simd = wm_web_standards_showcase_bridge_request_sized_with_backend(1, "/tmp/w", 10, 10, "cpu_simd")
        val vulkan = wm_web_standards_showcase_bridge_request_sized_with_backend(1, "/tmp/w", 10, 10, "vulkan")
        expect(simd.title == vulkan.title).to_equal(false)
        expect(vulkan.title).to_equal(web_standards_showcase_window_title("vulkan"))

    it "the unsized bridge-request helper defaults to the module's showcase window dimensions":
        step("Verify: the unsized bridge-request helper defaults to the module's showcase window dimensions")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val req = wm_web_standards_showcase_bridge_request(6, "/tmp/w")
        expect(req.window_w).to_equal(WEB_STANDARDS_SHOWCASE_WINDOW_W)
        expect(req.window_h).to_equal(WEB_STANDARDS_SHOWCASE_WINDOW_H)
        expect(req.pid).to_equal(6)  # oracle: value fixed by the spec contract

describe "wm_web_standards_showcase_client_env (U4.6 closure)":

    it "populates all six WM client-mode env vars keyed off the bridge/frame paths":
        step("Verify: populates all six WM client-mode env vars keyed off the bridge/frame paths")
        # @req: REQ-UI-WmAppProcContCoveClos-001
        val env = wm_web_standards_showcase_client_env("/tmp/bridge", "/tmp/w")
        expect(env[WM_APP_MODE_ENV]).to_equal(WM_APP_MODE_CLIENT)
        expect(env[WM_BRIDGE_FILE_ENV]).to_equal("/tmp/bridge")
        expect(env[WM_FRAME_FILE_ENV]).to_equal("/tmp/w")
        expect(env[WM_EVENT_FILE_ENV]).to_equal("/tmp/w.event")
        expect(env[WM_FRAME_SEQ_FILE_ENV]).to_equal("/tmp/w.seq")
        expect(env[WM_CLIENT_HOLD_ENV]).to_equal("1")
