"""
## Purpose and audience

DiagnosticV1 round-trips through its JSON renderer with the fields that
drifted between the thin pure-Simple Diagnostic and the Rust seed's richer
type: a stable (non-optional) code, multi-file labels, a nested child
diagnostic, a macro expansion chain, and a confidence-scored suggested fix.
Since the extraction to `std.common.diagnostics`, it also proves that the
`compiler.common.diagnostics.*` paths are re-exports of the SAME types
(REQ-DIAG-001), for every lane that still imports the compiler path.
"""
# @cover src/compiler/00.common/diagnostics/diagnostic_v1.spl
# @cover src/lib/common/diagnostics/diagnostic_v1.spl

use std.spec
use compiler.common.diagnostics.diagnostic_v1.{DiagnosticV1, DiagnosticFix, DiagnosticFixConfidence}
use compiler.common.diagnostics.span.{Span}
use compiler.common.diagnostics.severity.{Severity}
use std.common.diagnostics.diagnostic_v1.{DiagnosticV1 as StdDiagnosticV1, render_diagnostic_v1_json}
use std.common.diagnostics.span.{Span as StdSpan}
use std.common.diagnostics.diagnostic_batch.{DiagnosticBatchV1, diagnostic_stable_id}
use std.common.string_core.{char_from_code}
use std.common.json.parser.{json_parse}
use std.common.json.object_ops.{json_object_get}
use std.common.json.types.{json_to_string}

# Takes the compiler-path type; fed a value built through the std path.
fn code_of(d: DiagnosticV1) -> text:
    d.code

# Takes the std-path span type; fed a value built through the compiler path.
fn span_len_of(s: StdSpan) -> i64:
    s.length

# @manual_section: diagnostic_v1
describe "DiagnosticV1":
    it "names the same type through the std.common and compiler.common import paths":
        # @req REQ-DIAG-001
        val compiler_span = Span.new(4, 9, 2, 5)
        # @capture(value): a std-path diagnostic flowing through compiler-path functions and back
        step("Build a diagnostic through std.common with a compiler.common Severity and Span")
        val d = StdDiagnosticV1.new(Severity.Error, "E7001", "cross-path").with_span(compiler_span)
        step("Pass it to a function typed with the compiler.common DiagnosticV1")
        expect(code_of(d)).to_equal("E7001")
        step("Pass the compiler.common Span to a function typed with the std.common Span")
        expect(span_len_of(compiler_span)).to_equal(5)  # oracle: 9 - 4
        step("Render through the std path and store in a batch; both see one value")
        val batch = DiagnosticBatchV1.new("spl", "f:1", "file:///m.spl", 1, "xxh3:0", 1)
            .push(diagnostic_stable_id("E7001", "f:1", "expr:0", 0), d)
        expect(render_diagnostic_v1_json(d)).to_equal(d.to_json())
        expect(batch.to_json().contains("\"code\":\"E7001\"")).to_equal(true)
        expect(batch.to_json().contains("\"line\":2")).to_equal(true)

    it "round-trips a stable code, multi-file labels, a nested child, and a confidence-scored fix":
        # @req REQ-DIAG-001
        # @capture(json): rendered diagnostic with labels, child and fix
        step("Build a diagnostic with every V1 field populated and render it")
        val primary_span = Span.new(4, 9, 2, 5)
        val other_file_span = Span.new(0, 3, 1, 1)

        val child = DiagnosticV1.error("E2002", "in expansion of macro `derive_eq`")
            .with_span(other_file_span)

        val fix = DiagnosticFix.new("E2001:1", "insert missing semicolon", DiagnosticFixConfidence.Likely)
            .with_replacement("main.spl", primary_span, ";")

        val diag = DiagnosticV1.error("E2001", "type mismatch")
            .with_span(primary_span)
            .with_label("main.spl", primary_span, "expected i64, found text")
            .with_label("lib.spl", other_file_span, "declared here")
            .with_note("both files must agree on type")
            .with_help("convert the value before returning it")
            .with_child(child)
            .with_fix(fix)

        val rendered = diag.to_json()

        # Stable code and severity on the parent
        expect(rendered).to_contain("\"code\":\"E2001\"")
        expect(rendered).to_contain("\"severity\":\"error\"")
        expect(rendered).to_contain("\"message\":\"type mismatch\"")

        # Multi-file labels: each label carries its own file, not a single
        # diagnostic-wide file the way the Rust seed's Diagnostic does
        expect(rendered).to_contain("\"file\":\"main.spl\"")
        expect(rendered).to_contain("\"file\":\"lib.spl\"")
        expect(rendered).to_contain("\"message\":\"expected i64, found text\"")
        expect(rendered).to_contain("\"message\":\"declared here\"")
        expect(rendered).to_contain("\"primary\":true")

        # Notes and help
        expect(rendered).to_contain("both files must agree on type")
        expect(rendered).to_contain("convert the value before returning it")

        # Nested child diagnostic, with its own stable code
        expect(rendered).to_contain("\"code\":\"E2002\"")
        expect(rendered).to_contain("in expansion of macro")

        # Confidence-scored suggested fix
        expect(rendered).to_contain("\"id\":\"E2001:1\"")
        expect(rendered).to_contain("\"confidence\":\"likely\"")
        expect(rendered).to_contain("\"new_text\":\";\"")

    it "renders zero fixes and no children as an empty array and a null fix":
        # @req REQ-DIAG-001
        # @capture(json): rendered minimal diagnostic
        step("Render a warning with only a note attached")
        val diag = DiagnosticV1.warning("W3001", "unused import")
            .with_note("prefix with _ to silence this warning")

        val rendered = diag.to_json()

        expect(rendered).to_contain("\"severity\":\"warning\"")
        expect(rendered).to_contain("\"code\":\"W3001\"")
        expect(rendered).to_contain("\"children\":[]")
        expect(rendered).to_contain("\"fix\":null")
        expect(rendered).to_contain("\"file\":null")
        expect(rendered).to_contain("\"span\":null")
        expect(rendered).to_contain("\"labels\":[]")
        expect(rendered).to_contain("\"macro_trace\":[]")

    it "renders a macro expansion chain with each frame's own file and span":
        # @req REQ-DIAG-001
        # @capture(json): rendered macro trace
        step("Render a diagnostic carrying two macro frames")
        val site = Span.new(10, 14, 5, 2)
        val diag = DiagnosticV1.error("E4001", "recursive macro expansion")
            .with_macro_frame("derive_eq", site, "macros.spl")
            .with_macro_frame("derive_ord", site, "macros.spl")

        val rendered = diag.to_json()

        expect(rendered).to_contain("\"name\":\"derive_eq\"")
        expect(rendered).to_contain("\"name\":\"derive_ord\"")
        expect(rendered).to_contain("\"file\":\"macros.spl\"")
        expect(rendered).to_contain("\"line\":5")

    it "escapes empty strings, quotes, backslashes, and whitespace controls in JSON":
        # @req REQ-DIAG-001
        step("Render diagnostics with empty text, quotes, backslashes, and whitespace controls")
        val empty_diag = StdDiagnosticV1.error("", "")
        val empty_json = empty_diag.to_json()
        expect(empty_json).to_contain("\"code\":\"\"")
        expect(empty_json).to_contain("\"message\":\"\"")
        val empty_parsed = json_parse(empty_json)
        expect(json_to_string(json_object_get(empty_parsed, "code")) ?? "MISSING").to_equal("")
        expect(json_to_string(json_object_get(empty_parsed, "message")) ?? "MISSING").to_equal("")

        val raw_msg = "quote\" slash\\ nl\n cr\r tab\t"
        val raw_file = "C:\\src\\\"dir\"\\file.spl"
        val diag = StdDiagnosticV1.error("E1001", raw_msg)
            .with_file(raw_file)
            .with_note("note\nline2\\end")
            .with_help("help\t\"quoted\"")
        val rendered = diag.to_json()

        expect(rendered).to_contain("quote\\\" slash\\\\ nl\\n cr\\r tab\\t")
        expect(rendered).to_contain("C:\\\\src\\\\\\\"dir\\\"\\\\file.spl")
        expect(rendered).to_contain("note\\nline2\\\\end")
        expect(rendered).to_contain("help\\t\\\"quoted\\\"")

        val parsed = json_parse(rendered)
        expect(json_to_string(json_object_get(parsed, "message")) ?? "").to_equal(raw_msg)
        expect(json_to_string(json_object_get(parsed, "file")) ?? "").to_equal(raw_file)

    it "escapes C0 control characters including BS, FF, NUL, and 0x01/0x1F in JSON":
        # @req REQ-DIAG-001
        step("Render diagnostics containing ASCII control bytes 0x00, 0x01, 0x08, 0x0C, 0x1F")
        val bs = char_from_code(8)
        val ff = char_from_code(12)
        val soh = char_from_code(1)
        val us = char_from_code(31)
        val nul = char_from_code(0)

        val ctrl_msg = "a" + bs + "b" + ff + "c" + soh + us + "d"
        val rendered_ctrl = DiagnosticV1.error("E1002", ctrl_msg).to_json()
        expect(rendered_ctrl).to_contain("a\\bb\\fc\\u0001\\u001fd")
        expect(rendered_ctrl.contains(bs)).to_equal(false)
        expect(rendered_ctrl.contains(ff)).to_equal(false)
        expect(rendered_ctrl.contains(soh)).to_equal(false)
        expect(rendered_ctrl.contains(us)).to_equal(false)
        expect(json_to_string(json_object_get(json_parse(rendered_ctrl), "code")) ?? "").to_equal("E1002")

        val roundtrip_ctrl = "x" + soh + us + "y"
        val parsed_ctrl = json_parse(DiagnosticV1.error("E1003", roundtrip_ctrl).to_json())
        expect(json_to_string(json_object_get(parsed_ctrl, "message")) ?? "").to_equal(roundtrip_ctrl)

        val nul_msg = "p" + nul + "q"
        val rendered_nul = DiagnosticV1.error("E1004", nul_msg).to_json()
        expect(rendered_nul).to_contain("p\\u0000q")
        expect(json_to_string(json_object_get(json_parse(rendered_nul), "message")) ?? "").to_equal(nul_msg)

    it "preserves multi-byte Unicode and non-ASCII text verbatim in JSON":
        # @req REQ-DIAG-001
        step("Render diagnostics with multi-byte UTF-8 message, file, label, note, and help")
        val uni = "한글 — é 🚀"
        val diag = StdDiagnosticV1.error("E2001", uni)
            .with_file("src/한글/é.spl")
            .with_note("참고: " + uni)
            .with_help("도움말: " + uni)
        val rendered = diag.to_json()

        expect(rendered).to_contain(uni)
        expect(rendered).to_contain("src/한글/é.spl")

        val parsed = json_parse(rendered)
        val decoded_msg = json_to_string(json_object_get(parsed, "message")) ?? ""
        expect(decoded_msg).to_equal(uni)
        expect(decoded_msg.byte_len()).to_equal(uni.byte_len())
        expect(json_to_string(json_object_get(parsed, "file")) ?? "").to_equal("src/한글/é.spl")
