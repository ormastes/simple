# Regression spec for
# doc/08_tracking/bug/interp_module_var_array_get_method_2026-07-04.md
#
# Originally reported: `.get(i)` on a MODULE-LEVEL array `var` failed with
# "semantic: unknown extern function: rt_args_count", while `.get(i)` on a
# local array worked fine -- module-scope array method dispatch was
# believed to fall through to an unrelated extern lookup.
#
# Re-verified 2026-08-09 under SIMPLE_EXECUTION_MODE=interpret: `.get(i)` on
# a module-level array var resolves and returns the correct element.
#
# Contract update 2026-11-09 (owner decision, see
# doc/08_tracking/bug/array_get_contract_drift_crypto_2026-10-18.md):
# `a.get(i)` returns `T?` on every lane -- `Some(elem)` in range, `None`
# otherwise -- and `a[i]` is the direct-element form. The earlier version of
# this spec compared `get`'s result to bare text; that pinned the pre-decision
# seed behaviour and is obsoleted here explicitly, not silently.

var _names: [text] = ["a", "b", "c"]

fn get_name(i: i32) -> text:
    match _names.get(i):
        Some(name): return name
        None: return "<absent>"

describe "module-level array var .get(i)":
    it "returns Some(element) at the first index":
        expect(get_name(0)).to_equal("a")

    it "returns Some(element) at a middle index":
        expect(get_name(1)).to_equal("b")

    it "returns Some(element) at the last index":
        expect(get_name(2)).to_equal("c")

    it "returns None past the end and for a negative index":
        expect(get_name(3)).to_equal("<absent>")
        expect(get_name(-1)).to_equal("<absent>")

    it "agrees with direct indexing on every in-range index":
        expect(get_name(2)).to_equal(_names[2])
