# Regression spec for
# doc/08_tracking/bug/interp_module_var_array_get_method_2026-07-04.md
#
# Originally reported: `.get(i)` on a MODULE-LEVEL array `var` failed with
# "semantic: unknown extern function: rt_args_count", while `.get(i)` on a
# local array worked fine -- module-scope array method dispatch was
# believed to fall through to an unrelated extern lookup.
#
# Re-verified 2026-08-09 under SIMPLE_EXECUTION_MODE=interpret: `.get(i)` on
# a module-level array var resolves and returns the correct element. No
# live defect remains on this lane.

var _names: [text] = ["a", "b", "c"]

fn get_name(i: i32) -> text:
    _names.get(i)

describe "module-level array var .get(i)":
    it "returns the element at the first index":
        expect(get_name(0)).to_equal("a")

    it "returns the element at a middle index":
        expect(get_name(1)).to_equal("b")

    it "returns the element at the last index":
        expect(get_name(2)).to_equal("c")
