# @tag:in-development
# `val has = a.?` on a None binds nil instead of false (value-position `.?`
# sentinel). Open bug: stage2_dotq_presence_value_is_nil_sentinel_2026-11-03.
# Companion of dotq_value_argument_spec.spl (argument position, passing).
use std.spec

describe ".? stored into a local":
    it "None yields false":
        val a: i64? = None
        val has = a.?
        expect(has).to_equal(false)

    it "Some yields true":
        val a: i64? = 1
        val has = a.?
        expect(has).to_equal(true)
