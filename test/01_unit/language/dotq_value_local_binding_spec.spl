# `.?` stored into a local (bug stage2_dotq_presence_value_is_nil_sentinel_2026-11-03).
# Per the syntax guide `.?` yields `T?` (payload if present, absent otherwise),
# so an UNTYPED local keeps that optional; a `bool`-declared local takes
# presence, exactly like a `bool` parameter (dotq_value_argument_spec.spl).
use std.spec

describe ".? stored into a bool local":
    it "None yields false":
        val a: i64? = None
        val has: bool = a.?
        expect(has).to_equal(false)

    it "Some yields true":
        val a: i64? = 1
        val has: bool = a.?
        expect(has).to_equal(true)

    it "Some(0) is present, not falsy":
        val a: i64? = 0
        val has: bool = a.?
        expect(has).to_equal(true)

describe ".? stored into an untyped local":
    it "None stays absent":
        val a: i64? = None
        val got = a.?
        expect(got ?? -1).to_equal(-1)

    it "Some keeps the payload":
        val a: i64? = 7
        val got = a.?
        expect(got ?? -1).to_equal(7)
