# Probe for call_root_place_order_spec.spl. A call-result place root keeps the
# assignment order contract (owner decision 2026-11-06): the right-hand side,
# then the root call, then the index, each exactly once.
# Bug: doc/08_tracking/bug/seed_interp_call_root_place_order_2026-11-06.md
# Every CASE line must read the literal on its right.

var log: [text] = []
# A fresh array: the write lands in a temporary on every engine, so only the
# order is observable. A root that returns storage something else still holds
# is covered by probe_call_root_shared_write.spl.
fn get_arr() -> [i64]:
    log.push("get")
    [10, 20, 30]

fn i() -> i64:
    log.push("i")
    1

fn rhs() -> i64:
    log.push("rhs")
    5

fn main():
    get_arr()[i()] += rhs()
    print("CASE compound_order={log.join(\",\")} want=rhs,get,i")
    log = []
    get_arr()[i()] = rhs()
    print("CASE plain_order={log.join(\",\")} want=rhs,get,i")
    print("PROBE_DONE")
