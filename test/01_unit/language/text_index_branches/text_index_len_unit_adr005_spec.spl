# Purpose and audience: executable pin of the ADR-005 length/indexing unit contract, for the text/runtime owners.
# @req REQ-SSPEC-UNIT
# @tag:in-development
# design: doc/04_architecture/adr/ADR-005-text-index-yields-char.md
# bug: text_len_bytes_vs_codepoint_index_bound_disagree_2026_11_03
#
# In development: on the seed interpreter "h\u{e9}llo".len() is 6 (bytes) while
# bracket indexing is code-point based and its bounds error reports length 5,
# and s[a:b] slices by BYTE. ADR-005 item 5 says len() counts code points.
# EXPECTED TO FAIL until the len/slice unit is unified; remove the tag then.

use std.spec.{describe, it, expect}

describe "ADR-005 length and slice units":
    it "len counts code points, not bytes":
        expect("h\u{e9}llo".len()).to_equal(5)
        expect("a\u{20ac}b".len()).to_equal(3)
        expect("a\u{1F600}b".len()).to_equal(3)

    it "len agrees with the bracket-index bound":
        val s = "h\u{e9}llo"
        expect(s[s.len() - 1].to_text()).to_equal("o")

    it "slice ranges are code-point based like bracket indexing":
        val s = "h\u{e9}llo"
        expect(s[1:3]).to_equal("\u{e9}l")
        expect(s[2:]).to_equal("llo")

    it "substring covering a multi-byte char is code-point based":
        expect("h\u{e9}llo".substring(1, 3)).to_equal("\u{e9}l")
