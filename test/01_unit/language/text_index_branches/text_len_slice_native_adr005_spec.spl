# Purpose and audience: executable pin of the ADR-005 length/slice unit on the
# native/JIT lane (rt_string_char_count / rt_len / rt_slice / rt_string_index_of),
# for the text/runtime owners. Companion of text_index_len_unit_adr005_spec.spl
# (seed interpreter lane, PR #7877).
# @req REQ-SSPEC-UNIT
# design: doc/04_architecture/adr/ADR-005-text-index-yields-char.md
# bug: text_len_bytes_vs_codepoint_index_bound_disagree_2026_11_03

use std.spec.{describe, it, expect}

describe "ADR-005 text length unit (native lane)":
    it "len counts code points":
        expect("h\u{e9}llo".len()).to_equal(5)
        expect("a\u{20ac}b".len()).to_equal(3)
        expect("a\u{1F600}b".len()).to_equal(3)
        expect("".len()).to_equal(0)

    it "byte_len stays bytes and char_count agrees with len":
        val s = "h\u{e9}llo"
        expect(s.byte_len()).to_equal(6)
        expect(s.char_count()).to_equal(5)
        expect("a\u{1F600}b".byte_len()).to_equal(6)

    it "ascii len is unchanged":
        expect("hello".len()).to_equal(5)
        expect("hello".byte_len()).to_equal(5)

    it "len agrees with the bracket-index bound":
        val s = "h\u{e9}llo"
        expect(s[s.len() - 1].to_text()).to_equal("o")
        expect(s[1].to_text()).to_equal("\u{e9}")

    it "len of a text variable through a loop bound":
        val s = "\u{e9}\u{e9}\u{e9}"
        var n = 0
        var i = 0
        while i < s.len():
            n = n + 1
            i = i + 1
        expect(n).to_equal(3)

describe "ADR-005 text slice unit (native lane)":
    it "bracket slices are code-point based":
        val s = "h\u{e9}llo"
        expect(s[1:3]).to_equal("\u{e9}l")
        expect(s[2:]).to_equal("llo")
        expect(s[:2]).to_equal("h\u{e9}")
        expect(s[-2:]).to_equal("lo")

    it "out-of-range slice bounds clamp to the code-point length":
        val s = "h\u{e9}llo"
        expect(s[3:99]).to_equal("lo")
        expect(s[9:12]).to_equal("")

    it "slice and substring methods are code-point based":
        expect("h\u{e9}llo".substring(1, 3)).to_equal("\u{e9}l")
        expect("h\u{e9}llo".slice(2, 5)).to_equal("llo")
        expect("a\u{1F600}bc".substring(1, 3)).to_equal("\u{1F600}b")

    it "ascii slices are unchanged":
        expect("hello"[1:3]).to_equal("el")
        expect("hello"[3:]).to_equal("lo")
        expect("hello".substring(1, 3)).to_equal("el")

describe "ADR-005 text search unit (native lane)":
    it "index_of returns a code-point index usable with slice":
        val s = "h\u{e9}llo"
        expect(s.index_of("l")).to_equal(2)
        expect(s.index_of("o")).to_equal(4)
        expect(s.slice(s.index_of("l"), s.len())).to_equal("llo")

    it "last_index_of returns a code-point index":
        expect("h\u{e9}llo".last_index_of("l")).to_equal(3)
        expect("hello".last_index_of("l")).to_equal(3)
