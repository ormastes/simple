# Regression: `.?` used as a VALUE argument (not a condition).
# AOT lowered f(a.?, b.?) as unwrap-or-3 truncated to a byte, so nil became 3
# (bug stage2_dotq_presence_value_is_nil_sentinel_2026-11-03; LINK_NOTES S3N-9a).
use std.spec

fn dq_pair(x: bool, y: bool) -> text:
    if x and y:
        "both"
    elif x:
        "first"
    elif y:
        "second"
    else:
        "none"

fn dq_flag(x: bool) -> bool:
    x

describe ".? as a value argument":
    it "Some/Some":
        val a: i64? = 1
        val b: i64? = 2
        expect(dq_pair(a.?, b.?)).to_equal("both")

    it "Some/None":
        val a: i64? = 1
        val b: i64? = nil
        expect(dq_pair(a.?, b.?)).to_equal("first")

    it "None/Some":
        val a: i64? = nil
        val b: i64? = 2
        expect(dq_pair(a.?, b.?)).to_equal("second")

    it "None/None":
        val a: i64? = nil
        val b: i64? = nil
        expect(dq_pair(a.?, b.?)).to_equal("none")

    it "single arg None is false, not a truthy sentinel":
        val a: text? = nil
        expect(dq_flag(a.?)).to_equal(false)

    it "single arg Some is true":
        val a: text? = "x"
        expect(dq_flag(a.?)).to_equal(true)

