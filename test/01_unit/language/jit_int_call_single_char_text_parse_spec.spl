# @tag:in-development
# Fails on deployed seed built Nov 4 16:58 (pre-173e92fe8e3); un-tag on first post-fix seed deploy.
# Bug: int_builtin_text_single_char_returns_char_code_jit_2026_11_07
#
# JIT lowered the call form int(text)/i32(text)/i8(text) to the same Cast as
# `x as T`, whose text rule is the single-character code point, so
# int("6") was 54. Fixed in seed HIR lowering by 173e92fe8e3 (Rust repro:
# src/compiler_rust/compiler/tests/conversion_call_text_parse_jit.rs).
# The sspec runner forces the interpreter, so each case runs a fixture
# through the compiler binary in strict JIT mode (`SIMPLE_BINARY` or `bin/simple`).
use std.spec
use std.io_runtime.{process_run, file_write, dir_create_all, env_get, env_set}

fn work_dir() -> text:
    val tmp = env_get("TMPDIR")
    val root = if tmp != "": tmp else: "/tmp"
    val dir = root + "/simple-spec-jit-int-call-text"
    dir_create_all(dir)
    dir

fn run_jit(name: text, source: text) -> (text, i64):
    val path = work_dir() + "/" + name + ".spl"
    assert_true(file_write(path, source))
    env_set("SIMPLE_EXECUTION_MODE", "jit")
    env_set("SIMPLE_JIT_STRICT", "1")
    env_set("SIMPLE_RUST_SEED_WARNING", "0")
    env_set("SIMPLE_TIMEOUT_SECONDS", "0")
    val configured = env_get("SIMPLE_BINARY")
    val bin = if configured == "": "bin/simple" else: configured
    val ran = process_run(bin, ["run", path])
    (ran[0].trim(), ran[2])

describe "int(text) call form parses text under the seed JIT":
    it "parses a single-character digit, not its code point":
        val (out, rc) = run_jit("single_char", """fn main():
    print("{int("6")} {int("0")} {int("9")}")
""")
        assert_equal(rc, 0)
        assert_equal(out, "6 0 9")

    it "parses sized conversion calls of single-character text":
        val (out, rc) = run_jit("sized", """fn main():
    print("{i32("4")} {i8("3")}")
""")
        assert_equal(rc, 0)
        assert_equal(out, "4 3")

    it "handles sibling shapes: negative, multi-digit, empty, lone sign":
        val (out, rc) = run_jit("siblings", """fn main():
    print("{int("-5")} {int("42")} {int("")} {int("-")}")
""")
        assert_equal(rc, 0)
        assert_equal(out, "-5 42 0 0")
