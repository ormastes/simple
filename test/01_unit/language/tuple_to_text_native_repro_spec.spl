# Repro: tuple stringification via f-string interpolation.
#
# STATUS (2026-08-07): the general "tuple prints as raw pointer" defect
# tracked in
# doc/08_tracking/bug/native_pushed_tuple_into_empty_literal_list_unboxed_2026-08-02.md
# was fixed for the Cranelift JIT lane by commit 81c58562fac
# ("fix(jit): format tuples as (a, b) not <tuple@ptr> in native/JIT value
# printer", src/compiler_rust/runtime/src/value/sffi/io_print.rs:533-550).
# `bin/simple run` (JIT, default and SIMPLE_EXECUTION_MODE=jit|native) and the
# interpreter (this spec, via `bin/simple test`) both render tuples correctly.
#
# The AOT lane (`bin/simple native-build`, LLVM backend) was fixed for the
# all-i64 case on 2026-08-07; mixed-type tuples there still render garbage.
#
# THIS SPEC CANNOT SEE THE AOT LANE. `bin/simple test` hard-defaults to the
# tree-walk interpreter and has no AOT mode, so this spec stays green whatever
# the AOT backend does -- which is exactly how the same defect got "fixed" and
# re-reported twice. The AOT regression fence is
# `scripts/check/check-native-tuple-to-text.shs`; run it, not this spec, when
# touching tuple lowering.
#
# NOTE: an explicit `t.to_text()` method call on a tuple receiver errors on
# the interpreter with "method `to_text` not found on type `tuple`" -- a
# separate, unrelated gap (interpreter method dispatch, not stringification)
# not covered by this spec.

describe "tuple to_text / interpolation":
    it "renders tuple contents via f-string interpolation":
        val t = (1, 2, 3)
        val s = "tuple={t}"
        expect(s).to_equal("tuple=(1, 2, 3)")

    it "renders mixed-type tuple contents via f-string interpolation":
        val t = (1, "abc", true)
        val s = "tuple={t}"
        expect(s).to_equal("tuple=(1, abc, true)")
