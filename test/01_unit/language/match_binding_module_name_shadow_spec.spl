# Defect-CLASS spec for
# doc/08_tracking/bug/match_binding_shadowed_by_module_namespace_2026-08-18.md
#
# The class of defect: a `match` pattern binding whose name equals the last
# segment of an imported module path resolves to that MODULE NAMESPACE instead
# of the matched payload. `color` below is such a name
# (`use std.gpu.engine2d.color.{rgb}`).
#
# CORRECT behavior (what the compiler SHOULD do): the pattern binding `color`
# shadows the module namespace inside the arm, so `color` is `7`.
#
# STATUS (re-measured 2026-08-31, Windows Rust seed bin/simple.exe
# "Simple Language v1.0.0-RC", self-identifies as a bootstrap seed):
# the defect is NARROWER than the bug record describes. It is now scope
# dependent, and the two scopes are pinned separately below:
#
#   * Inside a plain top-level `fn` -- FIXED. `_binds_payload()` returns true
#     on BOTH engines (verified via SIMPLE_EXECUTION_MODE=interpreter and
#     =jit on a standalone probe, both printing `color_is_7=true`).
#   * Inside a BDD `describe`/`it` closure BODY -- STILL BROKEN. The binding
#     resolves to the `color` module namespace object; the failure renders as
#     `expected {rgb: <fn:rgb>, color_red: <fn:color_red>, ...} to equal 7`.
#
# 2026-10-30: the closure scope is FIXED too. The BDD closure executor
# (interpreter_call/block_execution.rs) and the match-EXPRESSION evaluator
# (interpreter/expr/control.rs) bound arm variables without marking them
# block-local, so the identifier read preferred the same-named module global.
# Both now call `enter_block_local`, as the statement form always did.

use std.spec.{describe, it, expect}
use std.gpu.engine2d.color.{rgb}

fn _seven() -> Result<i64, text>:
    Ok(7)

# Returns true iff the `color` binding actually carries the matched payload.
# Measured true on this seed: the plain-function scope is fixed.
fn _binds_payload() -> bool:
    match _seven():
        Ok(color):
            return color == 7
        Err(_):
            return false
    false

# Expression form inside a plain fn, with an early `return` arm (the shape
# that broke app.test_runner_new.sdn_worker_protocol).
fn _expr_binds_payload() -> bool:
    val got = match _seven():
        Ok(color): color
        Err(_): return false
    got == 7

describe "match pattern bindings vs module namespaces":

    it "positive control: an uncolliding binding carries the payload":
        match _seven():
            Ok(v):
                expect(v).to_equal(7)
            Err(_):
                expect(false).to_equal(true)

    it "FIXED scope: in a plain fn, a binding named after a module carries the payload":
        expect(_binds_payload()).to_equal(true)

    it "in a BDD closure body a binding named after a module carries the payload":
        match _seven():
            Ok(color):
                expect(color).to_equal(7)
            Err(_):
                expect(false).to_equal(true)

    it "in a match expression a binding named after a module carries the payload":
        val got = match _seven():
            Ok(color): color
            Err(_): -1
        expect(got).to_equal(7)

    it "in a match expression with a return arm the binding carries the payload":
        expect(_expr_binds_payload()).to_equal(true)

    it "in a guard the binding named after a module carries the payload":
        match _seven():
            Ok(color) if color == 7:
                expect(color).to_equal(7)
            _:
                expect(false).to_equal(true)
