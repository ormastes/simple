# Defect-CLASS spec for
# doc/08_tracking/bug/match_binding_shadowed_by_module_namespace_2026-08-18.md
#
# The class of defect: a `match` pattern binding whose name equals the last
# segment of an imported module path resolves to that MODULE NAMESPACE instead
# of the matched payload. `color` below is such a name (`use
# std.gpu.engine2d.color.{rgb}`), and this is still RED on the current seed --
# it documents the unfixed compiler defect. The positive control in the same
# describe proves the oracle discriminates: an uncolliding binding passes.

use std.spec.{describe, it, expect}
use std.gpu.engine2d.color.{rgb}

fn _seven() -> Result<i64, text>:
    Ok(7)

describe "match pattern bindings shadow nothing":

    it "positive control: an uncolliding binding carries the payload":
        match _seven():
            Ok(v):
                expect(v).to_equal(7)
            Err(_):
                expect(false).to_equal(true)

    it "a binding named after an imported module still carries the payload":
        match _seven():
            Ok(color):
                expect(color).to_equal(7)
            Err(_):
                expect(false).to_equal(true)
