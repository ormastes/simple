# Regression spec for doc/08_tracking/bug/interp_single_line_if_or_return_2026-07-04.md
#
# Originally reported: a single-line `if A or B: return X` suite matched
# every input for the FIRST such line in the function, swallowing later
# lines and the trailing fallback value.
#
# Re-verified 2026-08-09 on the deployed seed binary (both default `run`
# and `SIMPLE_EXECUTION_MODE=interpret`): the reported misdispatch does not
# reproduce -- each single-line `or` guard now dispatches correctly and the
# trailing fallback value is reached when no guard matches. Landed as a
# regression gate rather than a source fix since no live defect remains.

fn single_line(c: text) -> i32:
    if c == "e" or c == "E": return 14
    if c == "f" or c == "F": return 15
    -1

describe "single-line if-or-return dispatch":
    it "matches the first guard for either of its alternatives":
        expect(single_line("e")).to_equal(14)
        expect(single_line("E")).to_equal(14)

    it "matches the second guard for either of its alternatives, not the first":
        expect(single_line("f")).to_equal(15)
        expect(single_line("F")).to_equal(15)

    it "falls through to the trailing value when no guard matches":
        expect(single_line("z")).to_equal(-1)
