# Run-path probe for
# doc/08_tracking/bug/seed_for_loop_enumerate_shorthand_diverges_from_pure_simple_2026-09-12.md
#
# One canonical `KEY=VALUE` line per shape so the sibling spec can run this
# probe under BOTH engines (interpreter and JIT) and assert the same answers
# in each, which is the whole point: the shapes below are exactly the ones
# where the Rust seed's interpreter used to disagree with the pure-Simple
# compiler (and with the seed's own JIT).
#
# Language rule being pinned: a bare comma pattern in a for loop is ALWAYS a
# tuple destructure, of any arity, regardless of what the iterable is. There
# is no "enumerate shorthand"; enumerate intent is written `.enumerate()`.

fn main():
    # (1) Bare two-name over an array of 2-tuples: destructure, never
    # enumerate. Identical to the parenthesized spelling by construction.
    var bare_pairs = ""
    for a, b in [(1, 2), (3, 4)]:
        bare_pairs = bare_pairs + a.to_string() + "|" + b.to_string() + ";"

    var paren_pairs = ""
    for (a2, b2) in [(1, 2), (3, 4)]:
        paren_pairs = paren_pairs + a2.to_string() + "|" + b2.to_string() + ";"

    # (2) Enumerate intent, written explicitly. No double wrap: `i` is the
    # position, `x` is the element -- NOT `(position, element)` again.
    var enum_repr = ""
    for i, x in [10, 20, 30].enumerate():
        enum_repr = enum_repr + i.to_string() + "|" + x.to_string() + ";"

    # (3) Dict views: `.items()`, `.entries()`, and direct dict iteration all
    # yield (key, value) pairs, all destructured by the same rule.
    var d: {text: i64} = {"a": 1, "b": 2, "c": 3}

    var items_total = 0
    for k, v in d.items():
        items_total = items_total + v

    var entries_total = 0
    for k2, v2 in d.entries():
        entries_total = entries_total + v2

    var dict_total = 0
    for k3, v3 in d:
        dict_total = dict_total + v3

    # (4) Arity is not limited to two: a three-name pattern over 3-tuples
    # destructures element-wise, matching the pure-Simple compiler's
    # `encode_for_tuple_binding` (which joins an arbitrary name list).
    var triples = ""
    for p, q, r in [(1, 2, 3), (4, 5, 6)]:
        triples = triples + p.to_string() + q.to_string() + r.to_string() + ";"

    # (5) A `_` in a bare comma pattern is a wildcard, not a binding.
    var wild = ""
    for wk, _ in d.items():
        wild = wild + wk

    # (6) Bare comma pattern over an array of NON-tuples. Under the
    # pure-Simple model this is a mis-typed destructure, not a shorthand:
    # element i of a non-tuple is absent, so every name binds nil. The seed
    # JIT already answered `nil` here; the interpreter used to silently
    # enumerate instead. Pinned so the two engines cannot drift again.
    #
    # Reported via `== nil` rather than `.to_string()` deliberately:
    # `nil.to_string()` is itself an UNRELATED, pre-existing engine
    # divergence (the JIT renders "nil", the interpreter raises `method
    # to_string not found on type nil`). Routing this pin through it would
    # make a for-loop spec fail for a reason that has nothing to do with
    # for loops.
    var nontuple = ""
    for na, nb in [10, 20, 30]:
        if na == nil:
            nontuple = nontuple + "nil"
        else:
            nontuple = nontuple + "set"
        if nb == nil:
            nontuple = nontuple + "|nil;"
        else:
            nontuple = nontuple + "|set;"

    print("BARE_PAIRS=" + bare_pairs)
    print("PAREN_PAIRS=" + paren_pairs)
    print("ENUM_REPR=" + enum_repr)
    print("ITEMS_TOTAL=" + items_total.to_string())
    print("ENTRIES_TOTAL=" + entries_total.to_string())
    print("DICT_TOTAL=" + dict_total.to_string())
    print("TRIPLES=" + triples)
    print("WILD_LEN=" + wild.len().to_string())
    print("NONTUPLE=" + nontuple)
    print("PROBE_DONE")
