# Regression for array_set_missing_on_interpreter_2026-08-18.
# The Rust seed reports `method 'set' not found on type 'array'` for:
#   var a: [i64] = [5, 3, 1]
#   a.set(0, 9)

describe "array set":
    it "replaces an element in place and reports success":
        var a: [i64] = [5, 3, 1]
        expect(a.set(0, 9)).to_equal(true)
        expect(a[0]).to_equal(9)
        expect(a.len()).to_equal(3)

    it "replaces a later element without changing array length":
        var a: [i64] = [5, 3, 1]
        expect(a.set(2, 8)).to_equal(true)
        expect(a[2]).to_equal(8)
        expect(a.len()).to_equal(3)

    it "supports negative indices from the end":
        var a: [i64] = [5, 3, 1]
        expect(a.set(-1, 9)).to_equal(true)
        expect(a[2]).to_equal(9)

    it "returns false and leaves elements unchanged for an invalid index":
        var a: [i64] = [5, 3, 1]
        expect(a.set(3, 9)).to_equal(false)
        expect(a[0]).to_equal(5)
        expect(a[2]).to_equal(1)

    it "returns false for an empty array":
        var a: [i64] = []
        expect(a.set(0, 9)).to_equal(false)
        expect(a.len()).to_equal(0)
