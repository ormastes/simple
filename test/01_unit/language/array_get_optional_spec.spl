# Array `.get(i)` returns `T?` (owner decision 2026-11-09).
# In range -> Some(elem); negative or past-the-end -> None (never nil in safe code). `a[i]` stays direct.
# See doc/08_tracking/bug/array_get_contract_drift_crypto_2026-10-18.md.

fn get_or(xs: [i64], i: i64, d: i64) -> i64:
    xs.get(i) ?? d

fn get_if_val(xs: [text], i: i64) -> text:
    if val s = xs.get(i):
        return s
    "<none>"

fn get_match(xs: [i64], i: i64) -> i64:
    match xs.get(i):
        Some(v): return v
        None: return -99

describe "array .get(i) is optional":
    it "in-range get unwraps via ?? to the element":
        expect(get_or([10, 20, 30], 1, -1)).to_equal(20)

    it "out-of-range get falls back via ??":
        expect(get_or([10, 20, 30], 3, -1)).to_equal(-1)
        expect(get_or([10, 20, 30], -1, -1)).to_equal(-1)

    it "if val binds the element in range and skips out of range":
        expect(get_if_val(["a", "b"], 0)).to_equal("a")
        expect(get_if_val(["a", "b"], 2)).to_equal("<none>")
        expect(get_if_val(["a", "b"], -1)).to_equal("<none>")

    it "matches Some(v) / None":
        expect(get_match([7, 8], 1)).to_equal(8)
        expect(get_match([7, 8], 5)).to_equal(-99)

    it "out-of-range get is None":
        val xs = [1, 2]
        expect(xs.get(9).is_none()).to_equal(true)
        expect(xs.get(-1).is_none()).to_equal(true)
        expect(xs.get(0).is_some()).to_equal(true)

    it "direct indexing stays the bare element":
        val xs = [4, 5, 6]
        expect(xs[2]).to_equal(6)
