# @tag:in-development
# Bug: option_class_unwrap_binding_copies_instead_of_referencing_2026-09-13
# `if val b = opt` on a typed Option<Class> binds a COPY on the interpreter path, so a
# field write through `b` is lost on the original instance. Expected to FAIL until fixed.
use std.spec

class CopyBox:
    n: i64

describe "if val unwrap keeps class reference identity":
    it "field write through typed local unwrap is visible on the original":
        val box = CopyBox(n: 1)
        val o: Option<CopyBox> = Some(box)
        if val b = o:
            b.n = 9
        expect(box.n).to_equal(9)
