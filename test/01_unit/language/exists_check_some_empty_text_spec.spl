# Bug: option_some_empty_text_dot_question_false_2026-11-06
# `.?` on `Some("")` must report present; a bare empty text stays absent.
use std.spec

fn empty_some() -> text?:
    Some("")

describe "exists check on text options":
    it "reports Some(\"\") as present":
        val a = empty_some()
        expect(a.?).to_equal(true)

    it "still reports a non-empty Some as present":
        val b: text? = Some("x")
        expect(b.?).to_equal(true)

    it "reports nil as absent":
        val c: text? = nil
        expect(c.?).to_equal(false)
