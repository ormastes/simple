# Regression spec for
# doc/08_tracking/bug/interp_dict_get_option_match_never_matches_2026-07-05.md
#
# Originally reported: `if val Some(x) = d.get(k):` silently never matched,
# even for a present key, because `Dict.get()` was believed to return a raw
# value/nil rather than a proper `Some(..)`-tagged Option.
#
# Re-verified 2026-08-09 under SIMPLE_EXECUTION_MODE=interpret (the engine
# the spec runner itself uses): the Option-match pattern correctly binds on
# a present key and correctly falls through to the else branch on a missing
# key. No live defect remains on this lane.

describe "Dict.get() as an Option-match target":
    it "matches Some(x) for a present key":
        var d: Dict<text, i32> = Dict.new()
        d.set("k", 42)
        var matched = false
        var value = 0
        if val Some(x) = d.get("k"):
            matched = true
            value = x
        expect(matched).to_equal(true)
        expect(value).to_equal(42)

    it "falls through to else for a missing key":
        var d: Dict<text, i32> = Dict.new()
        d.set("k", 42)
        var matched = false
        if val Some(x) = d.get("missing"):
            matched = true
        expect(matched).to_equal(false)
