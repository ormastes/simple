"""
## Purpose and audience
Purpose: Prove that array repeat [value; count].
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LANGUAGE-001 — stable requirement identity for this spec.

use std.spec.step

describe "array repeat [value; count]":
    it "const count builds an array of the right length":
        step("Verify: const count builds an array of the right length")
        # @req: REQ-LANGUAGE-001
        val zeros: [u32] = [0u32; 16]
        expect(zeros.len()).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "const count fills every element with the repeated value":
        step("Verify: const count fills every element with the repeated value")
        val zeros: [u32] = [0u32; 16]
        expect(zeros[0]).to_equal(0u32)
        expect(zeros[7]).to_equal(0u32)
        expect(zeros[15]).to_equal(0u32)

    it "const count repeats a non-zero i64 value":
        step("Verify: const count repeats a non-zero i64 value")
        val sevens = [7; 4]
        expect(sevens.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(sevens[0]).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(sevens[3]).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "dynamic count uses the runtime helper":
        step("Verify: dynamic count uses the runtime helper")
        val n = 5
        val v = 9
        val arr = [v; n]
        expect(arr.len()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(arr[0]).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(arr[4]).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "dynamic count of zero yields an empty array":
        step("Verify: dynamic count of zero yields an empty array")
        val n = 0
        val arr = [3; n]
        expect(arr.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
