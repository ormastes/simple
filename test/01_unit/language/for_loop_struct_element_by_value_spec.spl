# Structs are value types: a for-in / enumerate() loop variable bound to a
# struct element is a private copy; writing its field must not change the array.
# Interpreter lane here; MIR shape pinned in
# test/01_unit/compiler/50.mir/for_in_runtime_tuple_decode_spec.spl.
use std.spec

struct FvP:
    lo: i64
    hi: i64

describe "struct loop variable is bound by value":
    it "plain for does not write through to the array":
        val arr = [FvP(lo: 1, hi: 2), FvP(lo: 3, hi: 4)]
        for v in arr:
            var w = v
            w.lo = 99
        expect(arr[0].lo).to_equal(1)
        expect(arr[1].lo).to_equal(3)

    it "plain for loop variable field write does not write through":
        var arr = [FvP(lo: 1, hi: 2), FvP(lo: 3, hi: 4)]
        for v in arr:
            v.lo = 99
        expect(arr[0].lo).to_equal(1)
        expect(arr[1].hi).to_equal(4)

    it "enumerate loop variable field write does not write through":
        var arr = [FvP(lo: 1, hi: 2), FvP(lo: 3, hi: 4)]
        for (i, v) in arr.enumerate():
            v.lo = 99 + i
        expect(arr[0].lo).to_equal(1)
        expect(arr[1].lo).to_equal(3)
