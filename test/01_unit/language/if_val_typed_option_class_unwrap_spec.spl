# @tag:in-development
# Bug: seed_if_val_typed_option_class_binds_option_or_segv_2026-11-03
# Seed interpreter: `if val c = opt` where `opt` is a local explicitly typed
# `Option<Class>` (or an Option<Class> class field) binds the Option itself
# ("Function 'Option.bump_self' not found") or SEGVs (rc=139). The untyped
# `val lo = Some(x)` form unwraps correctly. Expected to FAIL until fixed.
use std.spec

class IfValCounter:
    n: i64

impl IfValCounter:
    me bump_self():
        self.n = self.n + 1

class IfValHolder:
    counter: Option<IfValCounter>

describe "if val unwrap of typed Option<Class>":
    it "unwraps an annotated Option<Class> local and reads the payload":
        val counter = IfValCounter(n: 7)
        val lt: Option<IfValCounter> = Some(counter)
        var seen = -1
        if val c = lt:
            seen = c.n
        expect(seen).to_equal(7)

    it "mutates the same instance through an Option<Class> field unwrap":
        val counter = IfValCounter(n: 0)
        val h = IfValHolder(counter: Some(counter))
        if val c = h.counter:
            c.bump_self()
        if val c = h.counter:
            c.bump_self()
        expect(counter.n).to_equal(2)
