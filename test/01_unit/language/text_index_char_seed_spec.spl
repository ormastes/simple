# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# design: doc/04_architecture/adr/ADR-005-text-index-yields-char.md
#
# The ADR-005 conversions that work without the char literal token, which is
# held until the user picks its syntax. Until the char value type lands,
# s[i] is a one-character text, so these assert through the explicit
# conversions only.
use std.spec.step

describe "ADR-005 explicit char conversions":
    it "ord of an indexed digit is its code point":
        # @req REQ-SSPEC-UNIT
        step("ord")
        assert_equal("72"[0].ord(), 55)
        assert_equal("72é"[2].ord(), 233)

    it "to_digit is an Option":
        # @req REQ-SSPEC-UNIT
        step("to_digit")
        assert_equal("72"[0].to_digit(), Some(7))
        assert_equal("72"[1].to_digit(), Some(2))
        assert_equal("a"[0].to_digit(), None)

    it "char.from_code inverts ord":
        # @req REQ-SSPEC-UNIT
        step("from_code")
        assert_equal(char.from_code(55), "7")
        assert_equal(char.from_code(233), "é")

    it "negative index counts code points from the end":
        # @req REQ-SSPEC-UNIT
        step("negative index")
        assert_equal("72é"[-1].ord(), 233)
        assert_equal("abc"[-3].ord(), 97)
