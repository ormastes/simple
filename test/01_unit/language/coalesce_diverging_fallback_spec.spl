# Regression spec for item 25 of doc/08_tracking/bug/
# unit_sweep_language_and_interpreter_gaps_2026-08-26.md
#
# Reported as an undiagnosed "expected expression, found Dedent" in three
# src/os/port/*.spl files. Two of the three shared one real grammar defect:
#
#     val payload = _archive_entry(entries, path) ??
#         return Err("payload-missing")
#
# `return`/`break`/`continue` are usable as plain identifiers in primary
# position, so the `??` fallback parser read `return` as a NAME and its operand
# as a no-paren call argument. On the multi-line form that scan then ran past
# the statement's terminating Newline and died at the enclosing block's DEDENT.
# A BARE `return` (no operand) parsed fine, which is what hid the defect.
#
# Fixed by building `Expr::UnwrapOrReturn` for a `return` fallback -- `expr ??
# return X` simply IS `expr unwrap or_return: X`, and that node already has
# diverging semantics wired through the interpreter and every backend. Building
# a DoBlock instead was tried first and evaluates to a thunk ("cannot convert
# function to int"), because a Coalesce default is lazily evaluated.
#
# `break`/`continue` fallbacks are OUT OF SCOPE: there is no loop-control
# counterpart to UnwrapOrReturn, and they only ever parsed as bare identifiers,
# so there is no working behaviour to preserve. Recorded as a sub-item of 25.
#
# (The third file, qrb2210_adreno_vulkan_kernel_transport.spl, was NOT this
# defect: it had a literal unbalanced `)` left behind by a hoist workaround.
# Fixed as source in the same change.)

fn lookup(present: bool) -> i64?:
    if present:
        return 7
    nil

fn coalesce_return(present: bool) -> i64:
    val v = lookup(present) ??
        return -1
    v * 10

fn coalesce_value(present: bool) -> i64:
    val v = lookup(present) ??
        3
    v * 10

fn coalesce_return_same_line(present: bool) -> i64:
    val v = lookup(present) ?? return -1
    v * 10

describe "diverging `??` fallback":
    it "takes the value when the option is present":
        expect(coalesce_return(true)).to_equal(70)

    it "runs the multi-line `return` fallback when the option is nil":
        expect(coalesce_return(false)).to_equal(-1)

    it "keeps the plain multi-line value fallback working":
        expect(coalesce_value(true)).to_equal(70)
        expect(coalesce_value(false)).to_equal(30)

    it "gives the single-line `?? return` form the same diverging semantics":
        expect(coalesce_return_same_line(true)).to_equal(70)
        expect(coalesce_return_same_line(false)).to_equal(-1)
