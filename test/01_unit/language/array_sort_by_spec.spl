# Regression spec: seed interpreter had no `[T].sort_by(cmp)`.
# Bug: doc/08_tracking/bug/seed_interpreter_array_sort_by_missing_2026-11-04.md
# RED on deployed seed bin/simple.exe: "Function 'Array.sort_by' not found".
# Comparator contract: int result (sign = order) or bool (true = a before b).

describe "array sort_by":
    # @manual scenario evidence
    it "sorts ascending with an int comparator":
        var xs: [i64] = [3, 1, 2]
        val ys = xs.sort_by(\a, b: a - b)
        expect(ys).to_equal([1, 2, 3])

    it "sorts descending with a reversed comparator":
        var xs: [i64] = [3, 1, 4, 1, 5]
        val ys = xs.sort_by(\a, b: b - a)
        expect(ys).to_equal([5, 4, 3, 1, 1])

    it "sorts with a bool less-than comparator":
        var xs: [text] = ["c", "a", "b"]
        val ys = xs.sort_by(\a, b: a < b)
        expect(ys).to_equal(["a", "b", "c"])

    it "is stable for equal keys":
        var xs: [(i64, text)] = [(1, "x"), (0, "y"), (1, "z")]
        val ys = xs.sort_by(\a, b: a.0 - b.0)
        expect(ys).to_equal([(0, "y"), (1, "x"), (1, "z")])

    it "handles empty and single-element arrays":
        var e: [i64] = []
        expect(e.sort_by(\a, b: a - b)).to_equal([])
        var one: [i64] = [7]
        expect(one.sort_by(\a, b: a - b)).to_equal([7])
