# @req REQ-SSPEC-COMPILER
"""
# Closures and fn refs in every value position

Regression lock for native_mir_lambda_and_enum_eq_block_caret_cs_2026_10_19:
lambdas returned from a fn, stored in a struct field, passed as call args,
captured locals, named fn refs, and unit-enum ==/!=. The same program built
natively with s3_fable44 prints a=6 b=11 c=8 d=101 e=15 f=42 (2026-11-05).
"""

# @tag: unit, language, closures

use std.spec

enum ClvKind:
    Read
    Write

fn clv_twice(x: i64) -> i64:
    x * 2

fn clv_apply(f: fn(i64) -> i64, v: i64) -> i64:
    f(v)

fn clv_make_adder(n: i64) -> fn(i64) -> i64:
    \x: x + n

struct ClvHolder:
    f: fn(i64) -> i64

describe "closure value positions":
    it "calls a capturing lambda bound to a local":
        val k = 5
        val add_k = \x: x + k
        expect(add_k(1)).to_equal(6)

    it "passes a lambda literal as a call argument":
        expect(clv_apply(\x: x + 10, 1)).to_equal(11)

    it "passes a named fn ref as a call argument":
        expect(clv_apply(clv_twice, 4)).to_equal(8)

    it "returns a capturing lambda from a fn":
        val g = clv_make_adder(100)
        expect(g(1)).to_equal(101)

    it "stores a capturing lambda in a struct field":
        val k = 5
        val h = ClvHolder(f: \x: x * k)
        expect(h.f(3)).to_equal(15)

    it "binds a named fn ref to a local":
        val r = clv_twice
        expect(r(21)).to_equal(42)

    it "compares unit enum variants":
        val m = ClvKind.Read
        expect(m == ClvKind.Read).to_equal(true)
        expect(m != ClvKind.Write).to_equal(true)
