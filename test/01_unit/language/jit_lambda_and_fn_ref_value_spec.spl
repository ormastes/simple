# Lambdas and named-function-as-value, re-verified 2026-08-07.
#
# Regression spec for the two JIT defects documented in
# doc/08_tracking/bug/jit_closure_abi_refuses_lambdas_and_miscompiles_fn_refs_2026-08-06.md.
#
# Defect 1 (guarded): any function containing a lambda makes the seed JIT
# refuse the WHOLE MODULE and fall back to the tree-walk interpreter. The
# fallback is loud (an `[INFO] ... falling back to interpreter` line) and the
# answer stays CORRECT.
#
# Defect 2 (unguarded, silent): a NAMED top-level function referenced as a
# value (not called) -- `val g = add_one` -- takes a different MIR lowering
# path that emits no `ClosureCreate`, so it passes the defect-1 guard and IS
# compiled by the JIT. Root cause, localized 2026-08-07:
#   - `emit_global_load` (src/compiler_rust/compiler/src/codegen/cranelift_emitter.rs,
#     the "static method reference" fallback branch) stores the bare code
#     ADDRESS of the function into the vreg -- not a pointer to a closure
#     struct.
#   - `compile_indirect_call` (src/compiler_rust/compiler/src/codegen/instr/closures_structs.rs)
#     unconditionally treats every indirect-call callee as a pointer to a
#     closure object and does `fn_ptr = *(i64*)(closure_ptr + 0)` before
#     calling it -- i.e. it dereferences the first 8 bytes of `add_one`'s own
#     machine code as if they were a function pointer, then calls that
#     garbage address. There is no tag/check distinguishing a bare function
#     value from a closure value.
# Result: `g(5)` returns an ASLR-shaped garbage i64 (measured
# 137602430669297 on 2026-08-07; the bug doc's 2026-08-06 run measured
# 125917636596193 / 140233366573537 / 125954009600481 -- varies per run) with
# NO diagnostic and exit 0.
#
# CAVEAT (same limitation as option_i64_value3_sentinel_spec.spl):
# `bin/simple test` runs the interpreter lane only. The interpreter is NOT
# affected by either defect (confirmed via `SIMPLE_EXECUTION_MODE=interpret
# bin/simple run` on 2026-08-07: both probes print the correct value). This
# spec is expected to be GREEN under `bin/simple test` even though the JIT
# lane (`bin/simple run`, the default engine) still returns garbage for
# defect 2. It locks in the CORRECT (interpreter) behavior and documents the
# JIT gap in prose; it does NOT exercise or prove the JIT lane. Re-confirm the
# JIT lane manually via `bin/simple run` after any change to
# `compile_indirect_call` / `emit_global_load` / the closure ABI.

describe "lambda and named-fn-value (interpreter lane)":
    it "a lambda stored in a local calls correctly":
        val f = |x| x + 1
        expect(f(5)).to_equal(6)

    it "a named top-level function used as a value calls correctly":
        expect(named_fn_used_as_value_helper(5)).to_equal(6)

    it "a lambda closing over an outer read-only var calls correctly":
        val n = 10
        val add_n = |x| x + n
        expect(add_n(5)).to_equal(15)

fn add_one(x: i64) -> i64:
    x + 1

fn named_fn_used_as_value_helper(x: i64) -> i64:
    val g = add_one
    g(x)
