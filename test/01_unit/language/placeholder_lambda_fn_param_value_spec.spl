# Regression: a placeholder lambda passed to a user free-function parameter
# must compute the same value as the equivalent explicit lambda.
# doc/08_tracking/bug/placeholder_lambda_as_fn_param_callback_unevaluated_2026-07-20.md
# Seed JIT returned the tagged/raw mix (apply(_1 + 1, 4) == 40, call_once == 88).

use std.spec.*

fn apply_typed(f: fn(i64) -> i64, x: i64) -> i64:
    f(x)

fn apply_untyped(f, x):
    f(x)

fn call_once(f):
    return f(10)

fn pmap(items, f):
    var result = []
    var i = 0
    while i < len(items):
        result.push(f(items[i]))
        i = i + 1
    result

describe "placeholder lambda through a user function parameter":
    it "typed fn param, numbered placeholder":
        expect(apply_typed(_1 + 1, 4)).to_equal(5)

    it "typed fn param, multiply":
        expect(apply_typed(_1 * 3, 4)).to_equal(12)

    it "typed fn param, bare placeholder":
        expect(apply_typed(_ + 1, 4)).to_equal(5)

    it "typed fn param, explicit lambda control":
        expect(apply_typed(\v: v + 1, 4)).to_equal(5)

    it "untyped param":
        expect(apply_untyped(_1 + 1, 7)).to_equal(8)

    it "untyped single-arg free function":
        expect(call_once(_1 + 1)).to_equal(11)

    it "pmap-shaped loop":
        expect(pmap([1, 2, 3], _1 + 1)).to_equal([2, 3, 4])
