# Probe for call_root_shared_write_spec.spl. The case runs from
# SIMPLE_CR_CASE, one per process, because the seed interpreter stops at the
# first refusal. `get_arr()` returns the array a class field holds; `view()`
# returns a fresh struct whose field is that same array. pure-Simple and the
# seed JIT write through to the shared array. The seed interpreter's
# containers are copy-on-write values, so it cannot write through and must
# refuse loudly instead of dropping the write.
# Bug: doc/08_tracking/bug/seed_interp_call_root_shared_write_dropped_2026-11-07.md
# Every CASE line must read the literal on its right.

use std.io_runtime.{env_get}

class Holder:
    arr: [i64]

struct Wrap:
    items: [i64]

val h = Holder(arr: [1, 2, 3])

fn get_arr() -> [i64]:
    h.arr

fn view() -> Wrap:
    Wrap(items: h.arr)

fn fresh() -> [i64]:
    [0, 0]

fn main():
    val c = env_get("SIMPLE_CR_CASE")
    if c == "fresh":
        fresh()[0] = 5
        fresh()[1] += 5
        print("CASE fresh_root=ok want=ok")
    elif c == "plain":
        get_arr()[0] = 9
        print("CASE shared_plain={h.arr[0]} want=9")
    elif c == "compound":
        get_arr()[1] += 5
        print("CASE shared_compound={h.arr[1]} want=7")
    elif c == "nested":
        view().items[2] = 30
        print("CASE nested_shared={h.arr[2]} want=30")
    print("PROBE_DONE")
