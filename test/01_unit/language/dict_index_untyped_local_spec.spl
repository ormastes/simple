# Regression: dict-index read into an UN-annotated local, then a method call.
# Frozen stage2: `MIR lowering error: unresolved method call: unwrap` for
# `val x = d[k]; x.unwrap()` while `val x: T? = d[k]` resolved (LINK_NOTES S3N-10).
use std.spec

struct DiItem:
    n: i64
    label: text

describe "dict index into untyped local":
    it "unwraps an Option-valued dict entry":
        var d: Dict<text, i64?> = {}
        d["k"] = 5
        val x = d["k"]
        expect(x.unwrap()).to_equal(5)

    it "unwraps a struct Option entry and reads fields":
        var d: Dict<i64, DiItem?> = {}
        d[1] = DiItem(n: 7, label: "seven")
        val x = d[1]
        val item = x.unwrap()
        expect(item.n).to_equal(7)
        expect(item.label).to_equal("seven")

    it "plain struct value read, fields intact":
        var d: Dict<text, DiItem> = {}
        d["a"] = DiItem(n: 1, label: "one")
        val x = d["a"]
        expect(x.n).to_equal(1)
        expect(x.label).to_equal("one")

    it "text value read":
        var d: Dict<i64, text> = {}
        d[3] = "three"
        val x = d[3]
        expect(x).to_equal("three")

    it "missing key yields None":
        var d: Dict<text, i64?> = {}
        val x = d.get("none")
        expect(x.?).to_equal(false)

    it "read inside a method of a class field dict":
        val h = DiHolder(m: {"q": DiItem(n: 9, label: "nine")})
        expect(h.read("q")).to_equal(9)

class DiHolder:
    m: Dict<text, DiItem>
    fn read(k: text) -> i64:
        val x = self.m[k]
        x.n
