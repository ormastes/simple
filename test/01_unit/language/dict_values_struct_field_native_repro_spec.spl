# Repro/class spec: field reads on the loop variable of `for x in d.values()`.
#
# STATUS (2026-08-24): the native (AOT) defect is FIXED -- see
# doc/08_tracking/bug/native_dict_values_loop_field_offset_collapse_2026-08-24.md
# Under native codegen every field read of such a loop variable used to collapse
# to byte offset 0 with i64 typing (`p.b` returned `p.a`), which in Stage 2 made
# build_signature dereference a nil return_type and SIGSEGV on a 2-line hello
# world.
#
# THIS SPEC CANNOT SEE THE AOT LANE. `bin/simple test` hard-defaults to the
# tree-walk interpreter, which was CORRECT throughout this defect -- so this
# spec was green before the fix and is green after it. It exists to pin the
# interpreter side of the contract and to document the class next to the code.
# The real regression fence is
# `sh scripts/check/check-native-dict-values-struct-fields.shs`; run THAT, not
# this spec, when touching dict/array element lowering in 50.mir.

struct DvPoint:
    a: i64
    b: text
    c: i64

describe "Dict.values() / .keys() loop element field reads":
    it "reads every field of a struct value, not just field 0":
        var d: Dict<i64, DvPoint> = {}
        d[1] = DvPoint(a: 7, b: "hi", c: 11)
        var seen_a = 0
        var seen_b = ""
        var seen_c = 0
        for p in d.values():
            seen_a = p.a
            seen_b = p.b
            seen_c = p.c
        expect(seen_a).to_equal(7)
        expect(seen_b).to_equal("hi")
        expect(seen_c).to_equal(11)

    it "reads every field when .values() is hoisted into a local first":
        var d: Dict<i64, DvPoint> = {}
        d[2] = DvPoint(a: 1, b: "hoisted", c: 3)
        val vs = d.values()
        var seen_b = ""
        for p in vs:
            seen_b = p.b
        expect(seen_b).to_equal("hoisted")

    it "reads every field for a dict with text keys and struct values":
        var d: Dict<text, DvPoint> = {}
        d["z"] = DvPoint(a: 1, b: "zz", c: 2)
        var seen_b = ""
        for p in d.values():
            seen_b = p.b
        expect(seen_b).to_equal("zz")

    it "keeps text keys intact through .keys()":
        var d: Dict<text, i64> = {}
        d["kx"] = 5
        var seen = ""
        for k in d.keys():
            seen = k
        expect(seen).to_equal("kx")

    it "control: d[k] direct read was never affected":
        var d: Dict<i64, DvPoint> = {}
        d[1] = DvPoint(a: 7, b: "hi", c: 11)
        expect(d[1].b).to_equal("hi")

    it "control: array-literal iteration was never affected":
        val arr: [DvPoint] = [DvPoint(a: 7, b: "hi", c: 11)]
        var seen_b = ""
        for q in arr:
            seen_b = q.b
        expect(seen_b).to_equal("hi")
