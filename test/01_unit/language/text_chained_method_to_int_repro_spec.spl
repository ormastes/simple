# Repro: chained text-producing method -> numeric conversion
#
# KNOWN DEFECT (seed Cranelift JIT, `bin/simple run` on the deployed
# bootstrap-seed binary): `<text-expr>.to_int()`/`.to_i64()` where the
# receiver is a DIRECTLY CHAINED method call result (e.g.
# `arg.substring(10).to_int()`) can return the receiver's raw heap pointer
# instead of the parsed number, with no error and exit 0. Binding the
# intermediate to a typed `val` first (the split form) is correct. Root
# cause and file:line:
# doc/08_tracking/bug/jit_substring_chained_to_int_returns_pointer_2026-08-04.md
#
# The defect is METHOD-SPECIFIC, not chain-shape-generic: `"  42  ".trim().to_i64()`
# is correct even chained (verified 2026-08-06/07), while
# `"--timeout=800".substring(10).to_int()` is not. See the bug doc's
# "trim vs substring" addendum for the isolating probe.
#
# `bin/simple test` hard-defaults to the tree-walk interpreter, which has no
# JIT variant (see doc/07_guide/infra/testing.md "run and test are different
# engines"), so this spec runs correctly and PASSES here regardless of
# whether the JIT defect is open. It does NOT gate the JIT defect. The real
# gate is the runnable probe referenced from the bug doc, executed via
# `bin/simple run` (which currently resolves to the Rust bootstrap-seed
# binary, not the pure-Simple self-hosted one -- see the bug doc for binary
# identity notes).

describe "chained text method to numeric conversion (interpreter)":
    it "parses a trimmed text chained directly into to_i64()":
        val s: text = "  42  "
        val chained = s.trim().to_i64() ?? -1
        expect(chained).to_equal(42)

    it "parses a substring chained directly into to_int()":
        val arg: text = "--timeout=800"
        val chained = arg.substring(10).to_int() ?? -1
        expect(chained).to_equal(800)

    it "matches the split (intermediate val) form for both cases":
        val s: text = "  42  "
        val t = s.trim()
        expect(t.to_i64() ?? -1).to_equal(s.trim().to_i64() ?? -1)

        val arg: text = "--timeout=800"
        val sub = arg.substring(10)
        expect(sub.to_int() ?? -1).to_equal(arg.substring(10).to_int() ?? -1)
