# Run-path probe for the DEFECT CLASS: a container mutation that one execution
# engine keeps and the other silently discards.
#
# The aliased-mut-param bug was found only because someone happened to run the
# same source under both engines. Nothing in the tree systematically compares
# them for mutation visibility, so each shape of this class has had to be found
# by hand. This probe sweeps the shapes instead: for each one it prints a single
# canonical `SHAPE <name>=<int>` line, and the sibling spec runs this probe
# under BOTH engines and requires the lines to be IDENTICAL, in addition to
# each shape matching the absolute literal the language specifies.
#
# Divergence between engines is by itself a defect regardless of which side is
# right, because the same program then produces two different answers with exit
# code 0 and no diagnostic.

fn arr_mut_only(mut a: [i64]):
    a.push(1)

fn arr_mut_aliased(mut a: [i64], b: [i64]):
    a.push(1)

fn arr_mut_aliased_thrice(mut a: [i64], b: [i64], c: [i64]):
    a.push(1)

fn dict_mut_only(mut d: {text: i64}):
    d["x"] = 1

fn dict_mut_aliased(mut d: {text: i64}, e: {text: i64}):
    d["x"] = 1

struct Holder:
    items: [i64]

fn holder_mut_only(mut h: Holder):
    h.items.push(1)

fn holder_mut_aliased(mut h: Holder, g: Holder):
    h.items.push(1)

fn nested_field_arg(mut items: [i64], other: [i64]):
    items.push(1)

class Box:
    items: [i64]

fn field_mut_obj_nonmut_struct(mut items: [i64], h: Holder):
    items.push(1)

fn obj_mut_field_nonmut_struct(mut h: Holder, items: [i64]):
    h.items.push(1)

fn obj_mut_field_nonmut_class(mut b: Box, items: [i64]):
    b.items.push(1)

fn field_mut_obj_nonmut_class(mut items: [i64], b: Box):
    items.push(1)

struct Outer:
    h: Holder

class OuterBox:
    h: Box

fn nested_struct_field_mut(mut items: [i64], n: i64):
    items.push(1)

fn nested_mut_obj_nonmut_class(mut items: [i64], b: Box):
    items.push(1)

fn main():
    var a1 = [9]
    arr_mut_only(a1)
    print("SHAPE arr_mut_only=" + a1.len().to_text())

    var a2 = [9]
    arr_mut_aliased(a2, a2)
    print("SHAPE arr_mut_aliased=" + a2.len().to_text())

    var a3 = [9]
    arr_mut_aliased_thrice(a3, a3, a3)
    print("SHAPE arr_mut_aliased_thrice=" + a3.len().to_text())

    var d1 = {"a": 1}
    dict_mut_only(d1)
    print("SHAPE dict_mut_only=" + d1.len().to_text())

    var d2 = {"a": 1}
    dict_mut_aliased(d2, d2)
    print("SHAPE dict_mut_aliased=" + d2.len().to_text())

    var h1 = Holder(items: [9])
    holder_mut_only(h1)
    print("SHAPE holder_mut_only=" + h1.items.len().to_text())

    var h2 = Holder(items: [9])
    holder_mut_aliased(h2, h2)
    print("SHAPE holder_mut_aliased=" + h2.items.len().to_text())

    var h3 = Holder(items: [9])
    nested_field_arg(h3.items, h3.items)
    print("SHAPE nested_field_aliased=" + h3.items.len().to_text())

    var x1 = Holder(items: [9])
    field_mut_obj_nonmut_struct(x1.items, x1)
    print("SHAPE field_mut_obj_nonmut_struct=" + x1.items.len().to_text())

    var x3 = Holder(items: [9])
    obj_mut_field_nonmut_struct(x3, x3.items)
    print("SHAPE obj_mut_field_nonmut_struct=" + x3.items.len().to_text())

    var x4 = Box(items: [9])
    obj_mut_field_nonmut_class(x4, x4.items)
    print("SHAPE obj_mut_field_nonmut_class=" + x4.items.len().to_text())

    var x5 = Box(items: [9])
    field_mut_obj_nonmut_class(x5.items, x5)
    print("SHAPE field_mut_obj_nonmut_class=" + x5.items.len().to_text())

    var o1 = Outer(h: Holder(items: [9]))
    nested_struct_field_mut(o1.h.items, 0)
    print("SHAPE nested_receiver_struct=" + o1.h.items.len().to_text())

    var o2 = OuterBox(h: Box(items: [9]))
    nested_struct_field_mut(o2.h.items, 0)
    print("SHAPE nested_receiver_class=" + o2.h.items.len().to_text())

    var o3 = OuterBox(h: Box(items: [9]))
    nested_mut_obj_nonmut_class(o3.h.items, o3.h)
    print("SHAPE nested_mut_obj_nonmut_class=" + o3.h.items.len().to_text())

    # Every shape above mutates exactly once through a `mut` parameter that
    # started from a 1-element container, so the language answer is 2 in all
    # fifteen cases. Any 1 is a discarded mutation.
    print("PROBE_DONE")
