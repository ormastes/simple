# Locks in the nil/presence-testing idioms that lane NILQ migrated hazardous
# call sites onto, so the containment cannot silently regress.
#
# Background: `.?` (the existence check) is mis-lowered on the JIT/native
# backend — it returns a `bool` from a raw scalar truthiness test instead of the
# specified `T?` presence value. See
#   doc/08_tracking/bug/dotq_existence_check_is_scalar_truthiness_on_jit_2026-07-27.md
#
# This spec therefore asserts ONLY the idioms that are verified correct and
# engine-agnostic. It deliberately does NOT assert bare `if x.?:` truthiness for
# an i64 / text / array receiver, because the two engines disagree there; adding
# such an assertion would freeze the bug in place.

# Option factories. `present` selects the arm so neither helper is a trivial
# constant-nil stub.
fn opt_i(n: i64, present: bool) -> i64?:
    if present:
        return n
    val absent: i64? = nil
    return absent

fn opt_t(s: text, present: bool) -> text?:
    if present:
        return s
    val absent: text? = nil
    return absent

fn some_i(n: i64) -> i64?:
    return opt_i(n, true)

fn none_i() -> i64?:
    return opt_i(0, false)

fn some_t(s: text) -> text?:
    return opt_t(s, true)

fn none_t() -> text?:
    return opt_t("", false)

describe "nil-presence idioms (engine-agnostic)":
    """
    As a Simple developer testing whether an optional value is present,
    I want `== nil` / `!= nil` and `if val x = opt.?:` to mean presence,
    so that a legitimately-zero or legitimately-empty payload is not
    mistaken for an absent one.
    """

    # --- `== nil` / `!= nil`: the containment idiom -------------------------
    # Verified 15/15 correct and mutually consistent on both the JIT and the
    # interpreter. This is what hazardous `.?` guards were migrated to.

    it "Option<i64> holding Some(0) is NOT nil":
        val v = some_i(0)
        expect_not(v == nil)
        assert_true(v != nil)

    it "Option<i64> holding Some(5) is NOT nil":
        val v = some_i(5)
        expect_not(v == nil)
        assert_true(v != nil)

    it "Option<i64> holding None IS nil":
        val v = none_i()
        assert_true(v == nil)
        expect_not(v != nil)

    it "Option<text> holding an empty string is NOT nil":
        val v = some_t("")
        expect_not(v == nil)
        assert_true(v != nil)

    it "Option<text> holding None IS nil":
        val v = none_t()
        assert_true(v == nil)
        expect_not(v != nil)

    it "== nil and != nil are always mutual opposites":
        val a = some_i(0)
        val b = none_i()
        expect(a == nil).to_equal(not (a != nil))
        expect(b == nil).to_equal(not (b != nil))

    # --- `if val x = opt.?:` binding: correct on both engines ---------------
    # The binding form is sound even though bare `.?` truthiness is not.
    # Some(0) MUST bind — this is the regression that started the lane.

    it "if val binds a Some(0) payload and yields 0":
        val v = some_i(0)
        var bound = false
        var got = 0 - 999
        if val x = v.?:
            bound = true
            got = x
        assert_true(bound)
        expect(got).to_equal(0)

    it "if val binds a Some(5) payload":
        val v = some_i(5)
        var bound = false
        var got = 0 - 999
        if val x = v.?:
            bound = true
            got = x
        assert_true(bound)
        expect(got).to_equal(5)

    it "if val does not bind a None payload":
        val v = none_i()
        var bound = false
        if val x = v.?:
            bound = true
        expect_not(bound)

describe "search-index sentinel idioms":
    """
    As a Simple developer searching within text, I want the not-found result of
    `index_of` / `last_index_of` / `find` to be guarded by an explicit sign
    test, so that a match at index 0 is accepted and the -1 sentinel is
    rejected.
    """

    # `index_of` / `last_index_of` / `find` return a PLAIN i64 with -1 for
    # not-found — they are not Options. Guarding them with `.?` was wrong in
    # both directions (it fired for a real match at index 0 and did not fire
    # for the -1 sentinel). The correct guard is an explicit sign test.

    it "index_of returns 0 for a match at the start, not a nil-ish value":
        val s = "abc"
        expect(s.index_of("a")).to_equal(0)

    it "index_of returns -1 when the needle is absent":
        val s = "abc"
        expect(s.index_of("z")).to_equal(0 - 1)

    it "last_index_of returns -1 when the needle is absent":
        val s = "abc"
        expect(s.last_index_of("z")).to_equal(0 - 1)

    it "find returns 0 for a match at index 0":
        val s = "$abc"
        expect(s.find("$")).to_equal(0)

    it "find returns -1 when the needle is absent":
        val s = "$abc"
        expect(s.find("z")).to_equal(0 - 1)

    it "the `< 0` guard accepts a match at index 0 and rejects not-found":
        val s = "$abc"
        val hit = s.find("$")
        val miss = s.find("z")
        expect_not(hit < 0)
        assert_true(miss < 0)
