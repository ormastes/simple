# @feature seed_val_match_arm_with_return_runs_twice_2026_11_12
# A match EXPRESSION arm with several statements must run each statement once.
use std.spipe.*

var arm_hits = 0

fn prep_value(ok: bool) -> Result<i64, text>:
    if ok: Ok(5) else: Err("bad")

fn note_arm(e: text):
    arm_hits = arm_hits + 1

fn val_match_return(ok: bool) -> i64:
    val v = match prep_value(ok):
        Err(e):
            note_arm(e)
            return 7
        Ok(p): p
    v

fn val_match_yield(ok: bool) -> i64:
    val v = match prep_value(ok):
        Err(e):
            note_arm(e)
            9
        Ok(p): p
    v

describe "match expression arm with several statements":
    it "runs an Err arm that ends in return exactly once":
        # @req REQ-LANG-VAL-MATCH-ONCE-001
        step("Call a function whose val-match Err arm records then returns")
        arm_hits = 0
        val got = val_match_return(false)
        expect(got).to_equal(7)
        expect(arm_hits).to_equal(1)

    it "runs an Err arm that yields a value exactly once":
        # @req REQ-LANG-VAL-MATCH-ONCE-001
        step("Call a function whose val-match Err arm records then yields")
        arm_hits = 0
        val got = val_match_yield(false)
        expect(got).to_equal(9)
        expect(arm_hits).to_equal(1)

    it "runs a multi-statement arm once inside an it block":
        # @req REQ-LANG-VAL-MATCH-ONCE-001
        step("Evaluate a val-match directly in the example body")
        arm_hits = 0
        val v = match prep_value(false):
            Err(e):
                note_arm(e)
                note_arm(e)
                3
            Ok(p): p
        expect(v).to_equal(3)
        expect(arm_hits).to_equal(2)

    it "keeps the Ok payload and skips the Err arm":
        # @req REQ-LANG-VAL-MATCH-ONCE-001
        step("Call the function on the Ok path")
        arm_hits = 0
        expect(val_match_return(true)).to_equal(5)
        expect(arm_hits).to_equal(0)
