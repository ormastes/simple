# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Regression: byte_at_reads_zero_from_slice_result_2026-07-28 — byte_at() over a
# slice() result must read the sliced bytes, not zeros.
use std.spec.step
use std.tls.utilities.{byte_at, slice}

describe "byte_at over a slice result":
    it "reads the sliced bytes":
        # @req REQ-SSPEC-UNIT
        step("slice then byte_at")
        val block: [i64] = [9, 9, 9, 9, 9, 9, 0, 3, 2, 104, 50, 9]
        val ext = slice(block, 6, 11)
        assert_equal(ext.len(), 5)
        assert_equal(byte_at(ext, 0), 0)
        assert_equal(byte_at(ext, 1), 3)
        assert_equal(byte_at(ext, 3), 104)
        assert_equal(byte_at(ext, 4), 50)
