# Probe for accessor_forwarding_spec.spl: assigning a name that is neither a
# field nor has a set_ method must be a hard error, never a silent no-op.

class Temp:
    _c: i64
    fn get_celsius() -> i64:
        self._c

fn main():
    var t = Temp(_c: 10)
    t.celsius = 40
    print("SILENT_NOOP value={t.get_celsius()}")
