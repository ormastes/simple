# Probe for accessor_forwarding_spec.spl: `alias Trait = field` forwarding.

trait Greeter:
    fn greet(name: text) -> text
    fn tag(self, n: i64) -> text
    fn wave() -> text:
        "wave-default"

class English:
    prefix: text
    fn greet(name: text) -> text:
        self.prefix + ", " + name
    fn tag(self, n: i64) -> text:
        "t" + n.to_text()
    fn wave() -> text:
        "wave-english"

class Host with Greeter:
    inner: English
    alias Greeter = inner

class LoudHost with Greeter:
    inner: English
    alias Greeter = inner
    fn greet(name: text) -> text:
        "HEY " + name

fn main():
    val h = Host(inner: English(prefix: "hello"))
    print("CASE forwarded={h.greet(\"world\")} want=hello, world")
    val l = LoudHost(inner: English(prefix: "hello"))
    print("CASE explicit_wins={l.greet(\"world\")} want=HEY world")
    print("CASE self_param={h.tag(3)} want=t3")
    print("PROBE_DONE")
