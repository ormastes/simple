# Probe for accessor_forwarding_spec.spl: compound assignment through a
# getter/setter pair. Contract (owner decision 2026-11-06): the right-hand
# side first, then one getter read, then one setter write.
# Bug: doc/08_tracking/bug/compound_assign_through_property_setter_fails_seed_2026-11-06.md
# Every CASE line must read the literal on its right.

var log: [text] = []

class Counter:
    raw: i64
    fn get_value() -> i64:
        log.push("get")
        self.raw
    me set_value(v: i64):
        log.push("set")
        self.raw = v
    me bump(n: i64):
        self.value += n

struct Meter:
    _m: i64
    fn get_meters() -> i64:
        log.push("get")
        self._m
    me set_meters(v: i64):
        log.push("set")
        self._m = v

fn rhs(v: i64) -> i64:
    log.push("rhs")
    v

fn main():
    var c = Counter(raw: 5)
    c.value += rhs(2)
    print("CASE class_add={c.raw} want=7")
    print("CASE class_add_order={log.join(\",\")} want=rhs,get,set")
    log = []
    c.value *= rhs(3)
    print("CASE class_mul={c.raw} want=21")
    print("CASE class_mul_order={log.join(\",\")} want=rhs,get,set")
    log = []
    c.bump(4)
    print("CASE self_add={c.raw} want=25")
    print("CASE self_add_order={log.join(\",\")} want=get,set")
    log = []
    var m = Meter(_m: 10)
    m.meters -= rhs(4)
    print("CASE struct_sub={m.get_meters()} want=6")
    print("CASE struct_sub_order={log.join(\",\")} want=rhs,get,set,get")
    print("PROBE_DONE")
