# Probe for accessor_forwarding_spec.spl: get_/is_/set_ forwarding on
# field-less names. Every CASE line must read the literal on its right.

class Temp:
    _c: i64
    fn get_celsius() -> i64:
        self._c
    fn set_celsius(v: i64):
        self._c = v
    fn is_hot() -> bool:
        self._c > 30

struct Meter:
    _m: i64
    fn get_meters() -> i64:
        self._m
    me set_meters(v: i64):
        self._m = v

class Both:
    level: i64
    _shadow: i64
    fn set_level(v: i64):
        self._shadow = v

fn main():
    var t = Temp(_c: 10)
    print("CASE class_get={t.celsius} want=10")
    print("CASE class_is_before={t.hot} want=false")
    t.celsius = 40
    print("CASE class_set={t.get_celsius()} want=40")
    print("CASE class_is_after={t.hot} want=true")
    var m = Meter(_m: 1)
    m.meters = 7
    print("CASE struct_set={m.get_meters()} want=7")
    var b = Both(level: 1, _shadow: 0)
    b.level = 5
    print("CASE field_beats_setter={b.level}/{b._shadow} want=5/0")
    print("PROBE_DONE")
