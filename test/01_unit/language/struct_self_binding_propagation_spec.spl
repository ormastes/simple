"""
## Purpose and audience
Purpose: Prove that struct self binding survives nested dispatch.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-LANGUAGE-001 — stable requirement identity for this spec.

# Regression probe for todo_db P2 rows 19/53/109/168/368/431/500:
# "Interpreter loses the `self` binding when a struct ...".
# The cited site (gc_async_mut/gpu/engine2d/backend_metal.spl:1304) carries no
# marker and the claim does not reproduce; this spec pins the behaviour so a
# future regression is caught rather than re-litigated from a stale citation.

use std.spec

struct SelfCounter:
    value: i64
    tags: [text]

    me bump() -> i64:
        self.value = self.value + 1
        self.value

    me bump_twice() -> i64:
        self.bump()
        self.bump()

    me via_lambda() -> i64:
        val f = fn() -> i64: self.value * 2
        f()

    me via_loop() -> i64:
        var total = 0
        for t in self.tags:
            total = total + self.value + t.len()
        total

    me via_match(k: i64) -> i64:
        match k:
            case 0: self.value
            case _: self.value + 100

    me via_free() -> i64:
        double_struct(self)

    me level1() -> i64:
        self.level2()

    me level2() -> i64:
        self.level3()

    me level3() -> i64:
        self.value + 7

class SelfHolder:
    items: [i64]

    me add(v: i64):
        self.items.push(v)

    me add_many():
        self.add(1)
        self.add(2)
        self.add(3)

fn double_struct(s: SelfCounter) -> i64:
    s.value * 2

describe "struct self binding survives nested dispatch":
    it "keeps self across a method-to-method call chain":
        step("Verify: keeps self across a method-to-method call chain")
        # @req: REQ-LANGUAGE-001
        var c = SelfCounter(value: 0, tags: [])
        expect(c.bump_twice()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(c.value).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "keeps self inside a lambda closed over the receiver":
        step("Verify: keeps self inside a lambda closed over the receiver")
        val c = SelfCounter(value: 5, tags: [])
        expect(c.via_lambda()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "keeps self inside a for loop over a self field":
        step("Verify: keeps self inside a for loop over a self field")
        val c = SelfCounter(value: 5, tags: ["ab", "cde"])
        expect(c.via_loop()).to_equal(15)  # oracle: 15 — named expected value from the requirement

    it "keeps self across match arms":
        step("Verify: keeps self across match arms")
        val c = SelfCounter(value: 5, tags: [])
        expect(c.via_match(0)).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(c.via_match(1)).to_equal(105)  # oracle: 105 — named expected value from the requirement

    it "keeps self when passed to a free function":
        step("Verify: keeps self when passed to a free function")
        val c = SelfCounter(value: 5, tags: [])
        expect(c.via_free()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "keeps self across three levels of me dispatch":
        step("Verify: keeps self across three levels of me dispatch")
        val c = SelfCounter(value: 5, tags: [])
        expect(c.level1()).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "keeps self for a class receiver mutating through nested me calls":
        step("Verify: keeps self for a class receiver mutating through nested me calls")
        val h = SelfHolder(items: [])
        h.add_many()
        expect(h.items.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "positive control: a deliberately wrong expectation must be observable":
        step("Verify: positive control: a deliberately wrong expectation must be observable")
        val c = SelfCounter(value: 5, tags: [])
        expect(c.level1()).to_not_equal(11)
        expect(c.via_free()).to_not_equal(5)
