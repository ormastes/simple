# `i64?` payload-3 vs nil disambiguation.
#
# Regression spec for the flat-`i64?` sentinel collision documented in
# doc/08_tracking/bug/interp_index_of_digit_leading_literal_2026-07-22.md.
#
# `T?` for primitives lowers to `HirType::Pointer{inner:T}`, a flat
# (non-boxed) nullable lane whose in-band "none" sentinel is bit pattern 3
# (`rt_core_nil()`). On the seed JIT, a present `i64` value of exactly 3 is
# indistinguishable from nil: `Some(3) == nil` reads `true`, and
# `Some(3) ?? default` silently takes the default branch instead of
# returning 3.
#
# CAVEAT (same limitation as list_get_hit_miss_spec.spl): `bin/simple test`
# runs the interpreter lane only, and the interpreter is NOT affected by
# this defect (confirmed via `SIMPLE_EXECUTION_MODE=interpret bin/simple
# run` -- see doc re-verification dated 2026-08-07). This spec is therefore
# expected to be GREEN under `bin/simple test` even while the JIT lane
# (`bin/simple run`, the default engine for ordinary programs) remains
# broken. It locks in the CORRECT (interpreter) behavior and documents the
# JIT gap in prose; it does NOT exercise or prove the JIT lane. Re-confirm
# the JIT lane manually via `bin/simple run` after any change to the `i64?`
# lowering path (src/compiler/50.mir, hir/lower/expr/control.rs).

describe "i64? payload-3 vs nil (interpreter lane)":
    it "Some(3) is not nil":
        val a: i64? = 3
        expect(a == nil).to_equal(false)

    it "Some(3) unwraps to 3 via ??, not the default":
        val a: i64? = 3
        val u = a ?? -1
        expect(u).to_equal(3)

    it "nil is still nil":
        val b: i64? = nil
        expect(b == nil).to_equal(true)

    it "nil unwraps to the default via ??":
        val b: i64? = nil
        val v = b ?? -1
        expect(v).to_equal(-1)

    it "non-collision payloads round-trip too (sanity band around 3)":
        val vals: List<i64> = [0, 1, 2, 3, 4, 11]
        for x in vals:
            val opt: i64? = x
            expect(opt == nil).to_equal(false)
            expect(opt ?? -99).to_equal(x)
