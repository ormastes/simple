# Synthetic positive control for the engine-divergence guard.
#
# It asserts one thing only: that SIMPLE_EXECUTION_MODE actually selects a
# different engine. The call to an undefined function makes the
# Cranelift path print a `[jit-fallback] unresolved external symbol` line, while
# the tree-walk interpreter never prints it. That difference is a property of the
# two engines existing, not of any defect, so this control cannot expire when the
# codebase improves — unlike boxed_int_61bit_probe, whose divergence WAS a bug.
# See doc/08_tracking/bug/engine_divergence_guard_control_depends_on_fixed_defect_2026-08-17.md
#
# The program's exit status and output are deliberately NOT asserted; only the
# presence/absence of the jit-fallback marker is.

fn main():
    print("C1=" + rt_engine_divergence_control_absent_symbol().to_string())

main()
