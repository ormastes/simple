struct SCell:
    var x: i64
class Counter:
    var val: i64
class Holder:
    var p: SCell

fn main():
    var arr = [Counter(val: 42)]
    var c = arr[0]
    c.val = 777
    print("A_class_in_array=" + arr[0].val.to_string())

    var h = Holder(p: SCell(x: 0))
    var cp = h.p
    cp.x = 99
    print("B_struct_from_field=" + h.p.x.to_string())

    var a = SCell(x: 0)
    var b = a
    b.x = 5
    print("C_struct_local_copy=" + a.x.to_string())

    var sarr = [SCell(x: 0)]
    var e = sarr[0]
    e.x = 7
    print("D_struct_in_array=" + sarr[0].x.to_string())

main()
