use std.js.engine.js_error.{Logger, LogLevel}
use std.js.engine.parser.{JsParser}
use std.nogc_sync_mut.js.engine.interpreter.{JsInterpreter}
use std.js.types.js_types.{JsValue}

fn run_js(source: text) -> text:
    val logger = Logger.new("probe", LogLevel.Error)
    val parser = JsParser.new(source, logger)
    val program = parser.parse_program()
    match program:
        Ok(stmts):
            val interp = JsInterpreter.new(logger)
            val result = interp.execute(stmts)
            match result:
                Ok(value):
                    match value:
                        JsValue.Number(n): return "num:{n}"
                        JsValue.String(s): return "str:{s}"
                        JsValue.Undefined: return "undefined"
                        _: return "other"
                Err(e):
                    return "Error: {e.message}"
        Err(e):
            return "SyntaxError: {e.message}"

fn main():
    print("J1_for_accum=" + run_js("var s = 0; for (var i = 0; i < 3; i = i + 1) { s = s + 1; } s;"))
    print("J2_nested_obj=" + run_js("var a = { b: { c: 1 } }; a.b.c = 42; a.b.c;"))
    print("J3_simple_assign=" + run_js("var x = 5; x = 7; x;"))
    print("J4_typeof_undef=" + run_js("typeof zzz;"))

main()
