# prelude_builtins_rebindable_by_transitive_import_2026-08-10: a transitively
# imported top-level `fn dprint` must not rebind the prelude builtin.
use std.spec
use .fixtures.dprint_shadow_mid_fixture.{mid_shadow_hits}

describe "prelude dprint":
    it "is not rebound by a transitive fn dprint":
        dprint("prelude dprint probe")
        expect(mid_shadow_hits()).to_equal(0)
