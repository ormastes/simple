# interpreter_bytes_u64_false_green_memory_2026-08-11: rt_bytes_alloc(n) is a
# zero-filled packed [u8] in every engine (the hybrid interp splice used to
# hand JIT code boxed-UInt pointers, read back as garbage bytes).
use std.spec

extern fn rt_bytes_alloc(len: u64) -> [u8]

fn byte_sum(buf: [u8]) -> u64:
    var s: u64 = 0
    for b in buf:
        s = s + b.to_u64()
    s

describe "rt_bytes_alloc":
    it "returns n zero bytes":
        val b = rt_bytes_alloc(8)
        expect(b.len()).to_equal(8)
        expect(b[0]).to_equal(0)
        expect(b[7]).to_equal(0)
        expect(byte_sum(b)).to_equal(0)
    it "zero-fills a 64 KiB buffer":
        val b = rt_bytes_alloc(65536)
        expect(b.len()).to_equal(65536)
        expect(byte_sum(b)).to_equal(0)
