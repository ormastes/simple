"""
# Bytes Alloc Bounds and Mutation Prevention Specification

Prevention tests for bug 4916 (`interpreter_bytes_u64_false_green_memory_2026-08-11`).
Verifies zero-length `rt_bytes_alloc(0)` handling, boundary indexing, isolated
buffer mutation without cross-buffer aliasing, and exact length preservation across
page-sized allocations.
"""

use std.spec.*

extern fn rt_bytes_alloc(len: u64) -> [u8]

describe "rt_bytes_alloc bounds and isolation prevention (bug 4916)":
    """Verifies boundary lengths and independent element mutability on rt_bytes_alloc."""

    it "returns empty byte slice for zero-length allocation":
        val empty = rt_bytes_alloc(0)
        expect(empty.len()).to_equal(0)

    it "isolates mutations across separate rt_bytes_alloc buffers":
        var first = rt_bytes_alloc(32)
        var second = rt_bytes_alloc(32)
        first[0] = 0xAAu8
        first[31] = 0x55u8
        expect(first.len()).to_equal(32)
        expect(second.len()).to_equal(32)
        expect(first[0]).to_equal(0xAAu8)
        expect(first[31]).to_equal(0x55u8)
        expect(second[0]).to_equal(0u8)
        expect(second[31]).to_equal(0u8)

    it "keeps first, middle, and tail zero-filled and writable across 4KiB page":
        var page = rt_bytes_alloc(4096)
        expect(page.len()).to_equal(4096)
        expect(page[0]).to_equal(0u8)
        expect(page[2048]).to_equal(0u8)
        expect(page[4095]).to_equal(0u8)
        page[2048] = 0x42u8
        page[4095] = 0x99u8
        expect(page[0]).to_equal(0u8)
        expect(page[2048]).to_equal(0x42u8)
        expect(page[4095]).to_equal(0x99u8)
