use std.spec

var _flags: [bool] = []

fn alloc() -> i64:
    val id = _flags.len()
    _flags = _flags.push(false)
    id

fn _read(id: i64) -> bool:
    _flags[id]

class Thing:
    id: i64

impl Thing:
    me mark():
        _flags[self.id] = true

    fn via_helper() -> bool:
        _read(self.id)

    fn inline_read() -> bool:
        _flags[self.id]

describe "a module-level array mutated by a method is read live through a free fn":
    it "sees the write through a free-function helper":
        var t = Thing(id: alloc())
        t.mark()
        expect(t.via_helper()).to_equal(true)

    it "sees the write inline in the owning method":
        var t = Thing(id: alloc())
        t.mark()
        expect(t.inline_read()).to_equal(true)

    it "leaves an unmarked sibling false through the helper":
        var a = Thing(id: alloc())
        var b = Thing(id: alloc())
        a.mark()
        expect(b.via_helper()).to_equal(false)
