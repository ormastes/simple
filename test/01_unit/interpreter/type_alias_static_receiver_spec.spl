# `type X = Y` must resolve as a static-call receiver (bug type_alias_static_dispatch_unresolved_2026-08-04)
use std.storage.shared.wal.{SharedWal}
use std.db.dbfs_engine.wal.{DbfsWal}

describe "type alias as static-call receiver":
    it "direct struct name works":
        val w = SharedWal.new()
        expect(w.durable_lsn).to_equal(0)
    it "imported alias name works":
        val w = DbfsWal.new()
        expect(w.durable_lsn).to_equal(0)
    it "alias and target construct the same shape":
        val a = DbfsWal.new()
        val b = SharedWal.new()
        expect(a.durable_lsn).to_equal(b.durable_lsn)
