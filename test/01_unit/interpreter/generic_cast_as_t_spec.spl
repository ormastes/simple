"""
# Generic Type Parameter `as T` Casts

Verifies explicit and inferred generic `as T` casts in functions and methods.
"""

use std.spec.{describe, it, expect}

fn cast_explicit<T>(x: f64) -> T:
    x as T

fn cast_inferred<T>(seed: T, raw: f64) -> T:
    raw as T

struct GenericBox<T>:
    items: [T]

impl GenericBox<T>:
    fn cast_from_float(self, raw: f64) -> T:
        raw as T

describe "Generic as T casts":
    it "resolves explicit call-site generic type arguments for as T":
        expect(cast_explicit<i64>(9.7)).to_equal(9)
        expect(cast_explicit<f64>(4.25)).to_equal(4.25)

    it "infers T from typed parameter values for as T":
        expect(cast_inferred(0, 7.8)).to_equal(7)
        expect(cast_inferred(0.0, 7.8)).to_equal(7.8)

    it "infers T from generic struct field values inside methods":
        val box_int = GenericBox(items: [1, 2])
        expect(box_int.cast_from_float(12.9)).to_equal(12)
        val box_flt = GenericBox(items: [1.0, 2.0])
        expect(box_flt.cast_from_float(12.5)).to_equal(12.5)
