# @req REQ-SSPEC-COMPILER
"""
# Repeated module-global writes stay visible to functions

A spec block that writes a module `var`, calls a function that reads it, and
writes it again must make the second write visible to that function. The
interpreter used to publish only the first write to the per-module owner store
(functions resolve globals through it); later writes went to the flat map only.
"""

# @tag:unit
# @tag:interpreter

use std.spec

var repeat_gv: text = "v1"

fn repeat_read() -> text:
    repeat_gv

fn repeat_outer() -> text:
    repeat_read()

describe "module global repeated write":
    it "a second write in the same block is seen by called functions":
        repeat_gv = "v2"
        expect(repeat_outer()).to_equal("v2")
        repeat_gv = "v3"
        expect(repeat_outer()).to_equal("v3")
        expect(repeat_read()).to_equal("v3")
        repeat_gv = "v1"
