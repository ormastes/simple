"""
# Top-Level friend and internal_export Visibility Spec

Verifies that top-level `friend <package>` and `internal_export <symbol>`
declarations parse, load, and execute cleanly in the seed interpreter without
falling back to `error[E1002]: function 'friend' not found`, while preserving
friend-scoped access to modules like `std.nogc_sync_mut.io.linux_protected_storage_v1`.
"""

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.linux_protected_storage_v1.{linux_protected_relative_v1}

friend lib.nogc_sync_mut.io
internal_export local_friend_helper, local_friend_tag

fn local_friend_helper(x: i64) -> i64:
    x + 10

fn local_friend_tag() -> text:
    "friend-ok"

describe "Top-level friend and internal_export declarations":
    it "allows top-level friend and internal_export directives in specs":
        expect(local_friend_helper(32)).to_equal(42)
        expect(local_friend_tag()).to_equal("friend-ok")

    it "imports and runs modules declaring friend and internal_export":
        expect(linux_protected_relative_v1("a/b/file.txt")).to_equal(true)
        expect(linux_protected_relative_v1("../escape")).to_equal(false)
