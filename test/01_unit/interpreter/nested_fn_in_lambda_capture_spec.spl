# A nested `fn` must run in the scope it captured.
#
# Bug: doc/08_tracking/bug/nested_fn_in_spec_block_loses_captured_local_2026-08-04.md
#
# `exec_block_closure_into` registers a nested `fn` twice: in the flat `functions`
# map so the body can recurse, and in the block scope as a closure over the
# block's locals. Call dispatch reached the flat entry first and ran the body
# against the CALLER's environment, discarding the capture -- so the block's own
# `val`s were simply not there.
#
# Most examples below sit inside an `it` block, which is itself a lambda body, so
# they exercise the construct under test directly rather than simulating it. The
# last one reaches a nested `fn` inside a PLAIN module-level function instead,
# which the record had listed as a separate, still-broken route.
#
# Measured through the spec runner, re-run 2026-09-19 after the fix was deployed:
#
#   pre-fix binary (the rollback copy, simple.stale-2026-09-19)   3 passed, 5 failed
#   deployed / rebuilt seed carrying the fix                      8 passed, 0 failed
#
# The three that pass on the broken binary are kept on purpose as controls --
# module var, callback and thunk. A probe of only those reports green on a broken
# binary, and that is exactly how this survived six weeks: the original repro
# used the callback shape.

use std.spec

var module_counter: i64 = 99

fn call_thunk(f: () -> i64) -> i64:
    f()

fn apply_reader(f: (i64) -> i64, at: i64) -> i64:
    f(at)

# The same shape inside a PLAIN module-level function body rather than a lambda.
# The record listed this as a remaining, undiagnosed lane split: through the spec
# runner it was said to fail on the fixed binary too. Re-measured 2026-09-19
# after deployment, the route is repaired -- the rollback copy at
# bin/release/.../simple.stale-2026-09-19 FAILS here with
# `semantic: function `fact` not found` while both deployed and rebuilt seeds
# pass.
#
# The inner fn is named `recursing_fact` and NOT `fact` on purpose. A second
# nested `fn fact` in a different scope collides with the one in the `it` block
# below -- the flat functions map is keyed by the bare name -- and the later call
# then runs the other scope's closure and cannot see its own `base`. Renaming is
# the workaround, not the fix; the collision is filed as
# doc/08_tracking/bug/nested_fn_name_collision_across_scopes_2026-09-19.md and
# has its own repro. Do not rename this back to `fact` to "match" the record.
fn recursive_nested_reading_enclosing_local() -> i64:
    val base = 10
    fn recursing_fact(n: i64) -> i64:
        if n <= 1:
            return base
        n * recursing_fact(n - 1)
    recursing_fact(4)

describe "a nested fn sees the scope it was declared in":
    it "reads a scalar local of the enclosing lambda":
        val n = 42
        fn get() -> i64:
            n
        expect(get()).to_equal(42)

    it "reads an array local of the enclosing lambda":
        val buf: [i64] = [7, 8, 9]
        fn at(i: i64) -> i64:
            buf[i]
        expect(at(1)).to_equal(8)

    it "reads a local whose name it does not itself bind":
        val standalone = 3
        fn reads_outer() -> i64:
            standalone
        expect(reads_outer()).to_equal(3)

    it "recurses while still reading the enclosing lambda's local":
        val base = 10
        fn fact(n: i64) -> i64:
            if n <= 1:
                return base
            n * fact(n - 1)
        expect(fact(4)).to_equal(240)

# DELIBERATELY NOT ASSERTED: whether a nested `fn` sees a local REBOUND after the
# `fn` was declared. Measured on the fixed binary, it does not -- the closure
# captures the block scope by value at the declaration point, so a later
# `total = 5` is invisible to it. Whether that snapshot is the intended semantics
# or a second defect is an open question this change does not settle, and
# asserting either answer here would bless one without deciding it. Recorded in
# the bug record instead.

describe "shapes that already worked stay working":
    it "still reads a module-level var from inside a nested fn":
        fn sees_module() -> i64:
            module_counter
        expect(sees_module()).to_equal(99)

    it "still works when the nested fn is passed as a callback":
        val buf: [i64] = [11, 22, 33]
        fn at(i: i64) -> i64:
            buf[i]
        expect(apply_reader(at, 2)).to_equal(33)

    it "still works when the nested fn is passed as a thunk":
        val n = 4
        fn thunk() -> i64:
            n * 2
        expect(call_thunk(thunk)).to_equal(8)

    it "recurses inside a plain module-level function body too":
        # NOT a control -- this one FAILS on the pre-fix binary, with a
        # different message than the in-`it` shape above (`function fact not
        # found` rather than `variable base not found`), which is why the two
        # were originally read as separate defects. They were one.
        expect(recursive_nested_reading_enclosing_local()).to_equal(240)
