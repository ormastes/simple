"""
# Implicit Tail Return for First-Class Function Values

Verifies that Value::Function calls return implicit tail expressions cleanly.
"""

use std.spec.{describe, it, expect}

fn apply_fn_value(f: fn(i64) -> i64, x: i64) -> i64:
    f(x)

fn wrap_with_implicit_closure(base: i64) -> fn(i64) -> i64:
    \n: base + n

fn wrap_decorator(inner: fn() -> i64) -> fn() -> i64:
    val orig = inner()
    \: orig + 10

fn target_val() -> i64:
    32

fn apply_decorator(dec, f):
    dec(f)

describe "Value::Function implicit tail return (#5893)":
    it "returns the implicit tail expression when invoked as a fn value":
        val wrapped = apply_decorator(wrap_decorator, target_val)
        expect(wrapped()).to_equal(42)

    it "returns closures from named function values without explicit return":
        val maker = wrap_with_implicit_closure
        val adder = maker(40)
        expect(apply_fn_value(adder, 2)).to_equal(42)
