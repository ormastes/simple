# os_namespace_uninitialized_array_module_var_not_found_2026-08-02:
# an imported (non-std) module's `var a: [T; N]` with no initializer is
# zero-filled storage, not "variable `a` not found".
use std.spec
use .fixtures.uninit_fixed_array_module_fixture.{q_mark, q_is_active, q_count_at}

describe "imported module-level uninitialized fixed array":
    it "starts zero-filled":
        expect(q_is_active(2)).to_equal(false)
        expect(q_count_at(2)).to_equal(0)
    it "accepts indexed writes from the module's own functions":
        q_mark(1)
        q_mark(1)
        expect(q_is_active(1)).to_equal(true)
        expect(q_count_at(1)).to_equal(2)
