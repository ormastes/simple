# Regression fixture for the seed interpreter two-hop place-chain defect
# (doc/08_tracking/bug/seed_interpreter_cross_module_struct_field_read_zero_2026-11-05.md).
#
# Shape mirrors std.fs_driver: a container struct holds an array of entries,
# each wrapping a driver struct in an enum variant. The only way to reach the
# driver is `table.mounts[0].driver` — an enum payload nested in an array
# element. Mutations made through that chain must persist.

pub struct ProbeDriver:
    fd_table: [u64]

    me fn record_fd(fd: u64):
        self.fd_table = self.fd_table.push(fd)

    me fn has_fd(fd: u64) -> bool:
        var i: i32 = 0
        while i < self.fd_table.len() as i32:
            if self.fd_table[i] == fd:
                return true
            i = i + 1
        false

pub enum ProbeDriverKind:
    Ram(ProbeDriver)

pub struct ProbeEntry:
    driver: ProbeDriverKind

pub struct ProbeTable:
    mounts: [ProbeEntry]

pub fn driver_open(kind: ProbeDriverKind, fd: u64) -> bool:
    match kind:
        case ProbeDriverKind.Ram(d):
            d.record_fd(fd)
            true
