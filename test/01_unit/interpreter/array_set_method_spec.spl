# `[T].set(i, v)` on the interpreter (present in codegen via rt_index_set).
# Bug: doc/08_tracking/bug/array_set_missing_on_interpreter_2026-08-18.md
use std.spec

class Holder:
    items: [i64]

describe "Array.set(i, v)":
    it "sets an in-range element in place on a var binding":
        var xs: [i64] = [1, 2, 3]
        xs.set(1, 9)
        expect(xs[1]).to_equal(9)
        expect(xs.len()).to_equal(3)

    it "leaves other elements untouched":
        var xs: [i64] = [1, 2, 3]
        xs.set(0, 7)
        expect(xs[2]).to_equal(3)

    it "counts a negative index from the end":
        var xs: [i64] = [1, 2, 3]
        xs.set(-1, 5)
        expect(xs[2]).to_equal(5)

    it "sets an element of an array field of a class":
        val h = Holder(items: [1, 2, 3])
        h.items.set(2, 42)
        expect(h.items[2]).to_equal(42)

    it "supports the reassigning form":
        var a: [i64] = [5, 3, 1]
        a = a.set(0, 9)
        expect(a[0]).to_equal(9)

class Registry:
    last: i64

    me set(k: i64, v: i64):
        self.last = k * 100 + v

describe "Array.set routing does not capture user types":
    it "runs a user class's own set method on a var instance":
        var r = Registry(last: 0)
        r.set(3, 4)
        expect(r.last).to_equal(304)

    it "runs a dict's own set on a var binding":
        var d: {text: i64} = {}
        d.set("a", 5)
        expect(d["a"]).to_equal(5)
