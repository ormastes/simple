# Bug: interpreter_ffi_bridge_legacy_syntax_blocks_source_check_2026-08-26
#
# src/app/interpreter/ffi/bridge.spl used to fail a direct source check with 24
# parser errors (`from ..core import`, Rust-like struct fields, `String`,
# `Array<>`, `Option<>`). The sibling core package is still legacy syntax, so
# the module cannot be imported yet; this guard pins the file text to the
# canonical forms and the public registry surface instead.
use std.spec
use std.io_runtime.{file_read_text}

val BRIDGE = "src/app/interpreter/ffi/bridge.spl"

fn _bridge_text() -> text:
    file_read_text(BRIDGE)

describe "interpreter ffi bridge canonical syntax":
    it "has no relative from-import":
        expect(_bridge_text().contains("from ..")).to_equal(false)
        expect(_bridge_text().contains("\nfrom ")).to_equal(false)
    it "uses canonical text and array types":
        val t = _bridge_text()
        expect(t.contains("String")).to_equal(false)
        expect(t.contains("Array<")).to_equal(false)
        expect(t.contains("Option<")).to_equal(false)
        expect(t.contains("&str")).to_equal(false)
    it "keeps the public registry surface":
        val t = _bridge_text()
        expect(t.contains("fn register_native(")).to_equal(true)
        expect(t.contains("fn call_native(")).to_equal(true)
        expect(t.contains("type NativeFunction")).to_equal(true)
        expect(t.contains("struct NativeRegistry")).to_equal(true)
