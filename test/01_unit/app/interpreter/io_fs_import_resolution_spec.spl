# Regression: the interpreter entry path must bind I/O through canonical
# physical owner modules before HIR name resolution. Legacy `std.io` and
# `io.fs` module aliases leave qualified `io.*` / `fs.*` names unresolved in
# strict entry-closure native builds.

use std.spec.*
use std.io_runtime.{file_read}

val MAIN_PATH = "src/app/interpreter/main.spl"
val DEBUG_PATH = "src/app/interpreter/helpers/debug.spl"
val FIXTURE_PATH = "test/fixtures/interpreter_io_owner_resolution/main.spl"

describe "interpreter I/O names resolve through canonical owners":
    it "uses exact file and diagnostic facade imports on the main entry path":
        val source = file_read(MAIN_PATH)

        expect(source).to_contain("use app.io.mod.{file_exists, file_read_text, rt_debug_stack_trace_lines}")
        expect(source).to_contain("use std.nogc_sync_mut.sffi.diag.{eprintln, print_raw, stdin_read_line, stdout_flush}")
        expect(source.contains("import std.io")).to_equal(false)
        expect(source.contains("import io.fs")).to_equal(false)
        expect(source.contains("io.eprintln(")).to_equal(false)
        expect(source.contains("io.print(")).to_equal(false)
        expect(source.contains("io.flush(")).to_equal(false)
        expect(source.contains("io.read_line(")).to_equal(false)
        expect(source.contains("fs.exists(")).to_equal(false)
        expect(source.contains("fs.read_text(")).to_equal(false)
        expect(source.contains(".*")).to_equal(false)

    it "binds debugger output to its exact diagnostic owner":
        val source = file_read(DEBUG_PATH)

        expect(source).to_contain("use std.nogc_sync_mut.sffi.diag.{println}")
        expect(source.contains("import std.io")).to_equal(false)
        expect(source.contains("io.println(")).to_equal(false)
        expect(source.contains(".*")).to_equal(false)

    it "keeps a narrow strict-native fixture on the same physical owners":
        val source = file_read(FIXTURE_PATH)

        expect(source).to_contain("use app.io.mod.{file_exists, file_read_text}")
        expect(source).to_contain("use std.nogc_sync_mut.sffi.diag.{eprintln, print_raw, stdin_read_line, stdout_flush}")
        expect(source.contains("import std.io")).to_equal(false)
        expect(source.contains("import io.fs")).to_equal(false)
        expect(source.contains(".*")).to_equal(false)
