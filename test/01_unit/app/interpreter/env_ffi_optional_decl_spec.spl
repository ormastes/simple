# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# bug: doc/08_tracking/bug/nil_return_non_optional_deferred_2026-10-31.md

# env_ffi loads with `rt_env_get_var -> auto?`
#
# `auto?` is the only optional `auto` declaration in the tree. This spec
# imports the module, so a parse or type error in that declaration fails here.
# It then checks that an unknown name on a fresh handle is absent.

use std.spec.step
use std.spec.{describe, it, expect}
use app.interpreter.ffi.env_ffi.{rt_env_new_handle, rt_env_get_var, rt_env_has_var, rt_env_free_handle}

describe "env_ffi optional variable lookup":
    it "an unknown name on a fresh handle is not defined":
        # @req REQ-SSPEC-UNIT
        step("Create a handle and look up a name that was never defined")
        val h = rt_env_new_handle()
        expect(rt_env_has_var(h, "zz_never_defined_7731")).to_equal(false)
        val v = rt_env_get_var(h, "zz_never_defined_7731")
        expect(v == nil).to_equal(true)
        rt_env_free_handle(h)
