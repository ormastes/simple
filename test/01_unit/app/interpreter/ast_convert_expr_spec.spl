# @req: REQ-APP-INTERPRETER-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/interpreter/ast_convert_expr_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.io.{env_get, process_run}
use std.spec.step

describe "App tool execution behavior":
    it "a tool invocation passes arguments through to the child":
        step("Verify: a tool invocation passes arguments through to the child")
        # @req: REQ-APP-APP_TOOL-001
        val (stdout, _stderr, _code) = process_run("/bin/echo", ["wave6-flag"])
        expect(stdout).to_contain("wave6-flag")  # oracle: the flag reaches the child process

    it "a failing command reports a nonzero exit status":
        step("Verify: a failing command reports a nonzero exit status")
        # @req: REQ-APP-APP_TOOL-001
        val (_out, _err, code) = process_run("/bin/false", [])
        expect((code != 0)).to_equal(true)  # oracle: failure surfaces as a nonzero status

    it "configuration drawn from the environment is observable":
        step("Verify: configuration drawn from the environment is observable")
        # @req: REQ-APP-APP_TOOL-001
        expect(env_get("PATH").len() > 0).to_equal(true)  # oracle: the environment reaches this process

# doc-path: doc/01_research/local/ast_convert_expr.md
# doc-path: doc/03_plan/sys_test/ast_convert_expr.md
# doc-path: doc/04_architecture/ast_convert_expr.md
# doc-path: doc/05_design/ast_convert_expr.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-APP-INTERPRETER-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-APP-INTERPRETER-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-APP-INTERPRETER-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-APP-INTERPRETER-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "chained comparison yields a boolean":
        step("Verify: chained comparison yields a boolean")
        # @req: REQ-APP-INTERPRETER-001
        expect(1 < 2).to_equal(true)
        expect(2 <= 2).to_equal(true)
        expect(3 != 3).to_equal(false)

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-APP-INTERPRETER-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign
