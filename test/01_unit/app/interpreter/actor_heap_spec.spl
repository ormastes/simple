# ActorHeap Tests
#
# Tests for per-actor heap isolation.

use std.actor_heap.{
    ActorHeap, HeapConfig, HeapStats, AllocationResult,
    HeapRegion
}

# Operator workflow
#
# 1. Run bin/simple test test/01_unit/app/interpreter/actor_heap_spec.spl.
# 2. Every scenario must pass; a failure is a regression in the
#    behavior under test.
#
# Compatibility and limitations
#
# Covers the interpreter and native lanes for the constructs
# asserted here; platform-specific behavior is out of scope.

describe "ActorHeap - Configuration":
    it "creates with default config":
        val heap = ActorHeap.new(HeapConfig.default())
        val config = heap.config

# doc-path: doc/01_research/local/actor_heap.md
# doc-path: doc/03_plan/sys_test/actor_heap.md
# doc-path: doc/04_architecture/actor_heap.md
# doc-path: doc/05_design/actor_heap.md

    it "creates with custom config":
        val config = HeapConfig(
            initial_size: ByteSize(value: 1024),
            max_size: ByteSize(value: 4096),
            gc_enabled: true,
            generational: false,
            pretenure_threshold: 5
        )
        val heap = ActorHeap.new(config)

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "creates small heap":
        val heap = ActorHeap.new(HeapConfig.small())
        expect(heap.config.initial_size.value == 512).to_equal(true)

    it "creates large heap":
        val heap = ActorHeap.new(HeapConfig.large())
        expect(heap.config.initial_size.value == 65536).to_equal(true)

describe "ActorHeap - Allocation":
    it "allocates memory":
        var heap = ActorHeap.new(HeapConfig.default())
        val result = heap.allocate(100)

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "tracks allocation stats":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(100)
        heap.allocate(200)

    it "sha256 known-answer vectors":
        step("Verify: sha256 known-answer vectors")
        # @req: REQ-APP-INTERPRETER-001
        use std.common.crypto.sha256.{sha256_text}
        expect(sha256_text("abc")).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")  # oracle: FIPS 180-2 vector for "abc"
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")  # oracle: empty-input vector

    it "fails when heap exhausted":
        val config = HeapConfig(
            initial_size: ByteSize(value: 100),
            max_size: ByteSize(value: 100),
            gc_enabled: false,
            generational: false,
            pretenure_threshold: 0
        )
        var heap = ActorHeap.new(config)

        # Fill the heap
        heap.allocate(90)

        # Next allocation should fail
        val result = heap.allocate(50)
        expect(not result.is_success()).to_equal(true)

    it "handles zero-size allocation":
        var heap = ActorHeap.new(HeapConfig.default())
        val result = heap.allocate(0)

        expect(result.is_success()).to_equal(true)

describe "ActorHeap - Garbage Collection":
    it "triggers GC when threshold reached":
        val config = HeapConfig.default()
        var heap = ActorHeap.new(config)

        heap.allocate(200 * 1024)

        val stats = heap.get_stats()
        expect(stats.allocated_bytes.value >= 0).to_equal(true)

    it "collects garbage manually":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(1000)

        heap.collect_garbage()

        val stats = heap.get_stats()
        expect(stats.gc_count.value >= 1).to_equal(true)

    it "collects young generation only":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(500)

        heap.collect_young_generation()

        val stats = heap.get_stats()
        expect(stats.young_gen_size.value >= 0).to_equal(true)

    it "respects gc_enabled flag":
        val config = HeapConfig(
            initial_size: ByteSize(value: 1024),
            max_size: ByteSize(value: 4096),
            gc_enabled: false,
            generational: false,
            pretenure_threshold: 0
        )
        var heap = ActorHeap.new(config)

        heap.collect_garbage()

        val stats = heap.get_stats()
        expect(stats.gc_count.value == 0).to_equal(true)

describe "ActorHeap - Statistics":
    it "tracks peak usage":
        var heap = ActorHeap.new(HeapConfig.default())

        heap.allocate(100)
        heap.allocate(200)

        val stats = heap.get_stats()
        expect(stats.peak_used_bytes.value >= 300).to_equal(true)

    it "reports usage percent":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(100)

        val usage = heap.usage_percent()
        expect(usage >= 0).to_equal(true)
        expect(usage <= 100).to_equal(true)

    it "checks heap health":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(1000)

        expect(heap.is_healthy()).to_equal(true)

describe "ActorHeap - Display":
    it "formats heap for display":
        val heap = ActorHeap.new(HeapConfig.default())
        val s = heap.fmt()

        expect(s.contains("ActorHeap")).to_equal(true)

    it "formats stats for display":
        val stats = HeapStats.new()
        val s = stats.fmt()

        expect(s.contains("HeapStats")).to_equal(true)

describe "ActorHeap - Region Management":
    it "tracks young generation":
        var heap = ActorHeap.new(HeapConfig.default())
        heap.allocate(100)

        expect(heap.young_generation.used.value >= 100).to_equal(true)

    it "handles non-generational heap":
        val config = HeapConfig.no_gc(1024)
        var heap = ActorHeap.new(config)

        heap.allocate(100)

        expect(not heap.has_old_generation).to_equal(true)
