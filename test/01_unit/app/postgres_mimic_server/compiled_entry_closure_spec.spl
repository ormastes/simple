# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "PostgreSQL mimic compiled entry closure":
    # @manual scenario evidence
    it "does not import the broad CLI or IO utility graph":
        # @req REQ-SSPEC-APP
        step("does not import the broad CLI or IO utility graph")
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("extern fn sys_get_args() -> [text]")
        expect(source).to_contain("fn pg_flag_value(args: [text], flag: text, fallback: text) -> text:")
        assert_false(source.contains("std.cli.cli_util"))
        assert_false(source.contains("use std.io"))

    it "keeps the pure-Simple PostgreSQL mimic database capsule":
        # @req REQ-SSPEC-APP
        step("keeps the pure-Simple PostgreSQL mimic database capsule")
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("postgres_mimic_open(path)")
        expect(source).to_contain("postgres_mimic_simple_query(server, session, sql)")

    it "uses owner-module façades instead of imported class methods":
        # @req REQ-SSPEC-APP
        step("uses owner-module façades instead of imported class methods")
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        assert_false(source.contains("PostgresMimicServer.open"))
        assert_false(source.contains("server.startup"))
        assert_false(source.contains("server.simple_query"))
        assert_false(source.contains("server.close"))
        assert_false(source.contains(".join("))
        assert_false(source.contains(".map("))
