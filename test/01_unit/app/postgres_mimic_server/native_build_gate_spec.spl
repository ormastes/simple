use app.io.mod.{file_read}

describe "PostgreSQL-mimic production native-build gate":
    it "fails before the broad database closure without compiler authority":
        val gate = file_read("scripts/check/build-postgres-mimic-server-native.shs")
        expect(gate).to_contain("simple_compiler_usable \"$SIMPLE_BIN\"")
        expect(gate).to_contain("usable pure-Simple self-hosted compiler")
        expect(gate).to_contain("authority probe rejected")

    it "uses only the exact application and library source universe":
        val gate = file_read("scripts/check/build-postgres-mimic-server-native.shs")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/app\"")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/lib\"")
        expect(gate.contains("--source \"$ROOT_DIR/src/compiler\"")).to_be(false)
        expect(gate).to_contain("--entry-closure")
        expect(gate).to_contain("src/app/postgres_mimic_server/main.spl")

    it "forbids unresolved compatibility stubs and server ownership symbols":
        val gate = file_read("scripts/check/build-postgres-mimic-server-native.shs")
        expect(gate).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(gate).to_contain("stub functions for unresolved symbols")
        expect(gate).to_contain("PgDatabaseOwner")
        expect(gate).to_contain("PgDispatchGate")
        expect(gate).to_contain("thread_spawn_with_args")
        expect(gate).to_contain("rt_struct_receiver_valid")

    it "binds the build to one admitted core-C runtime capsule and records hashes":
        val gate = file_read("scripts/check/build-postgres-mimic-server-native.shs")
        val admission = file_read("scripts/check/check-db-runtime-capsule-provenance.shs")
        expect(gate).to_contain("SIMPLE_DB_RUNTIME_CAPSULE")
        expect(gate).to_contain("SIMPLE_RUNTIME_PATH=\"$RUNTIME_CAPSULE\"")
        expect(gate).to_contain("SIMPLE_CORE_RUNTIME_PATH=\"$RUNTIME_CAPSULE\"")
        expect(gate).to_contain("--runtime-bundle core-c-bootstrap")
        expect(gate).to_contain("--runtime-path \"$RUNTIME_CAPSULE\"")
        expect(gate).to_contain("runtime-provenance.env")
        expect(admission).to_contain("archive_sha256")
        expect(admission).to_contain("repeat_archive_sha256")
        expect(admission).to_contain("manifest_value")
        expect(admission).to_contain("object_")
        expect(admission).to_contain("_sha256")
        expect(admission).to_contain("manifest/object count mismatch")

    it "rejects stale and fallback runtime selection even after a successful link":
        val gate = file_read("scripts/check/build-postgres-mimic-server-native.shs")
        expect(gate).to_contain("falling back|fallback runtime|runtime archive is STALE")
        expect(gate).to_contain("build/simple-core/libsimple_runtime")
        expect(gate).to_contain("exit 8")
