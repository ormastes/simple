use std.spec.{describe, it, expect}
extern fn rt_file_read_text(path: text) -> text?

describe "postgres mimic daemon cached entrypoint":
    it "offers bounded query and pgwire serve modes from the compiled entry":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source.contains("sys_get_args()")).to_equal(true)
        expect(source.contains("PgWireParallelLinuxServer(address: address")).to_equal(true)
        expect(source.contains("--workers")).to_equal(true)
        expect(source.contains("--scalar-parallel")).to_equal(true)
        expect(source.contains("--query")).to_equal(true)

    it "fails closed unless a user and database are explicitly allowed":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source.contains("--serve requires --listen, --allow-user, and --allow-database")).to_equal(true)
        expect(source.contains("allowed_user: allowed_user")).to_equal(true)
        expect(source.contains("allowed_database: allowed_database")).to_equal(true)
        expect(source.contains("127.0.0.1:5432")).to_equal(true)

    it "retains query mode and performs bounded persistence cleanup":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("if pg_has_flag(args, \"--serve\")")
        expect(source).to_contain("server.serve_scalar_parallel_bounded_status(max_connections)")
        expect(source).to_contain("server.serve_bounded_status(max_connections)")
        expect(source.contains("server.owner.checkpoint()")).to_equal(true)
        expect(source.contains("server.owner.close()")).to_equal(true)

    it "keeps imported Result and IoError aggregates behind a scalar boundary":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("val status = if pg_has_flag(args, \"--scalar-parallel\"):")
        expect(source).to_contain("server.serve_error_text()")
        expect(source).to_contain("if status != 0:")

    it "bounds worker and connection CLI inputs before opening the listener":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("fn pg_positive_arg(")
        expect(source).to_contain("--workers must be between 1 and 64")
        expect(source).to_contain("--max-connections must be positive")

    it "uses the single-worker SimpleOS filesystem launch profile explicitly":
        val source = rt_file_read_text("src/app/postgres_mimic_server/main.spl") ?? ""
        expect(source).to_contain("pg_has_flag(args, \"--simpleos\")")
        expect(source).to_contain("--simpleos requires a non-whitespace --launch-id")
        expect(source).to_contain("0.0.0.0:5432")
        expect(source).to_contain("/var/db/simpleos/postgres-mimic.pdb")
        expect(source).to_contain("server.serve_inline_bounded_status(max_connections)")
        expect(source).to_contain("path=/SYS/APPS/DBSRV.SMF launch_id=")
