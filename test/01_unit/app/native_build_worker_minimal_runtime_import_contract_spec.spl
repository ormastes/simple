# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use app.cli.native_build_worker.{native_build_entry_args}

use std.spec.step

use std.spec.*
use std.io_runtime.{file_read}

describe "native-build worker minimal runtime imports":
    """
    Purpose: this manual pins the behavior named "native-build worker minimal runtime imports" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    # @manual scenario evidence
    it "does not pull the general CLI facade into the compiler closure":
        # @req REQ-SSPEC-APP
        step("does not pull the general CLI facade into the compiler closure")
        val source = file_read("src/app/cli/native_build_worker.spl")

        assert_false(source.contains("use app.io.cli_ops"))
        expect(source).to_contain('use app.io.args_ops.{get_args}')
        expect(source).to_contain('use app.io.env_ops.{env_get}')
        assert_false(source.contains("extern fn rt_cli_get_args"))
        assert_false(source.contains("extern fn sys_get_args"))
        expect(source).to_contain("val raw_args = get_args()")
        expect(source).to_contain('env_get("SIMPLE_NATIVE_BUILD_WORKER")')
        assert_false(source.contains("extern fn rt_env_get"))
        expect(source).to_contain("rt_exit(1)")
        expect(source).to_contain("cli_native_build(native_build_entry_args())")
