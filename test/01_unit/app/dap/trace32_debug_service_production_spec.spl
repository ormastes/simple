# codex-system-test
# @req REQ-003 REQ-008 REQ-010 REQ-012
"""The outward DAP TRACE32 adapter binds centrally and denies mutation before t32rem."""

use std.spec.*
use std.nogc_sync_mut.dap.adapter.mod.AdapterConfig
use std.nogc_sync_mut.debug.remote.protocol.trace32.Trace32Client
use app.dap.adapter.trace32.Trace32Adapter
use std.common.debug.service_v1.central_debug_service_v1_receipts

fn fixture_client() -> Trace32Client:
    Trace32Client(
        host: "fixture.invalid",
        port: 21000,
        t32rem_path: "/fixture/must-not-run/t32rem",
        backend: "fixture",
        connected: true,
        program: "fixture.elf",
        bp_counter: 0,
    )

fn require_bound_adapter(result: Result<Trace32Adapter, text>) -> Trace32Adapter:
    match result:
        case Ok(adapter): adapter
        case Err(reason): fail("expected production TRACE32 binding: {reason}")

describe "DAP TRACE32 production DebugServiceV1 bridge":
    it "uses one central session and denies reset before invoking the existing transport":
        val config = AdapterConfig.trace32("fixture.invalid", 21000, "build-fixture-21000")
        val adapter = require_bound_adapter(Trace32Adapter.from_client_bound(fixture_client(), config))
        match adapter.debug_session_id:
            case Some(session_id):
                val result = adapter.reset()
                match result:
                    case Ok(_): fail("development policy must not permit target mutation")
                    case Err(reason): expect(reason).to_equal("mutation denied by policy")
                val receipts = central_debug_service_v1_receipts(session_id)
                expect(receipts.len()).to_equal(1)
                expect(receipts[0].action).to_equal("t32.action.RESET")
                expect(receipts[0].allowed).to_equal(false)
                expect(receipts[0].caused_execution).to_equal(false)
            case None: fail("production TRACE32 adapter lacks DebugSessionId")
