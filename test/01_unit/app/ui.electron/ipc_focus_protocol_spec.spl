use std.spec.{describe, it, expect, step}
use app.ui.ipc.protocol.{parse_ipc_message}
use common.ui.widget.{UIEvent}

describe "Electron IPC focus and widget event parsing":
    it "parses commonInputEnvelope focus events using target_id":
        step("Parse focus envelope emitted by preload.js")
        val msg = "{\"type\":\"input\",\"target\":\"electron\",\"surface_id\":\"main\",\"event_type\":\"focus\",\"target_id\":\"search_input\",\"key\":\"\",\"value\":\"\"}"
        val event = parse_ipc_message(msg)
        match event:
            UIEvent.FocusEvent(target_id, kind) =>
                expect(target_id).to_equal("search_input")
                expect(kind).to_equal("focus")
            _ =>
                expect(false).to_equal(true)

    it "parses tab, select, and toggle action envelopes":
        step("Parse action envelopes for tabs, list/select, and tree/checkbox toggles")
        val tab_ev = parse_ipc_message("{\"type\":\"input\",\"event_type\":\"action\",\"value\":\"tab_nav_tabs_1\"}")
        match tab_ev:
            UIEvent.Action(name) =>
                expect(name).to_equal("tab_nav_tabs_1")
            _ =>
                expect(false).to_equal(true)

        val sel_ev = parse_ipc_message("{\"type\":\"input\",\"event_type\":\"action\",\"value\":\"select_sidebar_list_2\"}")
        match sel_ev:
            UIEvent.Action(name) =>
                expect(name).to_equal("select_sidebar_list_2")
            _ =>
                expect(false).to_equal(true)

        val tog_ev = parse_ipc_message("{\"type\":\"input\",\"event_type\":\"action\",\"value\":\"toggle_d_test\"}")
        match tog_ev:
            UIEvent.Action(name) =>
                expect(name).to_equal("toggle_d_test")
            _ =>
                expect(false).to_equal(true)
