use std.spec.{describe, it, expect, step}
use app.ui.electron.app_launcher.{resolve_electron_app_launch,
    electron_app_launch_args}

describe "shared Electron application launch resolution":
    it "fails closed when the application package is absent":
        step("Resolve a root that cannot contain the managed Electron package")
        val launch = resolve_electron_app_launch(
            "build/test-artifacts/electron-app-launcher/missing-root")
        expect(launch.ready).to_be(false)
        expect(launch.reason).to_equal("electron_package_manifest_missing")
        expect(launch.binary).to_equal("")

    it "resolves the managed package and executable together":
        step("Resolve the repository-managed Electron application")
        val launch = resolve_electron_app_launch(".")
        expect(launch.ready).to_be(true)
        expect(launch.package_dir).to_end_with("tools/electron-shell")
        expect(launch.binary).to_contain("electron")

    it "normalizes a trailing repository separator":
        step("Resolve the same managed package from a slash-terminated root")
        val launch = resolve_electron_app_launch("./")
        expect(launch.package_dir).to_equal("./tools/electron-shell")

    it "passes the resolved application directory and URL explicitly":
        step("Build deterministic Electron arguments for a DevHub URL")
        val args = electron_app_launch_args(
            "/repo/tools/electron-shell", "http://127.0.0.1:8765/", "")
        expect(args.len()).to_equal(4)
        expect(args[0]).to_equal("--no-sandbox")
        expect(args[1]).to_equal("/repo/tools/electron-shell")
        expect(args[2]).to_equal("--url")
        expect(args[3]).to_equal("http://127.0.0.1:8765/")

    it "keeps the optional debugging port before the application path":
        step("Build Caret arguments with an explicit debugging port")
        val args = electron_app_launch_args(
            "/repo/tools/electron-shell", "http://127.0.0.1:8766/", "9222")
        expect(args.len()).to_equal(5)
        expect(args[1]).to_equal("--remote-debugging-port=9222")
        expect(args[2]).to_equal("/repo/tools/electron-shell")
