use std.spec.{describe, it, expect}
use app.bootstrap_builder.managed_suite.{managed_suite_summary_v1}

describe "managed suite result evidence":
    it "admits exactly one nonvacuous clean summary":
        expect(managed_suite_summary_v1("case passed\nResults: 3 total, 3 passed, 0 failed\n").unwrap()).to_equal((3, 0))
        expect(managed_suite_summary_v1("Results: 3 total, 2 passed, 1 failed\r\n").unwrap()).to_equal((3, 1))

    it "rejects empty, cached, skipped, inconsistent and duplicate evidence":
        for output in ["", "No test files found\n", "Results: 0 total, 0 passed, 0 failed\n",
                "Results: 3 total, 3 passed, 0 failed, 1 cached\n",
                "Results: 3 total, 3 passed, 0 failed, 1 skipped\n",
                "Results: 3 total, 3 passed, 0 failed, 0 skipped\n",
                "Results: 3 total, 1 passed, 0 failed\n",
                "Results: 3 total, 3 passed, 0 failed\nResults: 3 total, 3 passed, 0 failed\n",
                "Results: x total, 3 passed, 0 failed\n"]:
            expect(managed_suite_summary_v1(output).is_err()).to_equal(true)
