use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.linux_worker.{builder_linux_terminal_outcome_v1,
    builder_linux_parse_required_memory_v1, builder_linux_required_memory_v1}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessPollV1,
    LinuxProcessRequestV1, linux_process_request_valid_v1}

fn terminal_v1() -> LinuxProcessPollV1:
    LinuxProcessPollV1(true, true, true, 0, 0, false, false, 67108864, 0)

describe "Linux generic worker terminal admission":
    it "parses only canonical bounded positive decimal memory requirements":
        match builder_linux_parse_required_memory_v1("1125899906842624"):
            Ok(bytes): expect(bytes).to_equal(1125899906842624)
            Err(message): fail(message)
        for invalid in ["", "0", "01", "+10", "10x", "1125899906842625",
                "99999999999999999"]:
            match builder_linux_parse_required_memory_v1(invalid):
                Ok(_): fail("invalid memory requirement accepted: " + invalid)
                Err(message): expect(message).to_contain("requirement")

    it "uses the task cap by default and refuses a weaker configured reserve":
        match builder_linux_required_memory_v1("", 1073741824):
            Ok(bytes): expect(bytes).to_equal(1073741824)
            Err(message): fail(message)
        match builder_linux_required_memory_v1("2147483648", 1073741824):
            Ok(bytes): expect(bytes).to_equal(2147483648)
            Err(message): fail(message)
        match builder_linux_required_memory_v1("536870912", 1073741824):
            Ok(_): fail("configured memory below immutable task cap accepted")
            Err(message): expect(message).to_contain("below")

    it "accepts the outer seven-day task bound and rejects a longer owner lease":
        val digest = "a".repeat(64)
        var request = LinuxProcessRequestV1("/tmp/producer", digest, [], [],
            "/tmp/work", [], "/tmp/stdout.log", "/tmp/stderr.log", 604800000)
        expect(linux_process_request_valid_v1(request, "/tmp/attempt", digest,
            1073741824)).to_equal("")
        request.timeout_ms = 604800001
        expect(linux_process_request_valid_v1(request, "/tmp/attempt", digest,
            1073741824)).to_contain("bound")

    it "accepts success only after exact leader and descendant reap":
        match builder_linux_terminal_outcome_v1(terminal_v1(), false):
            Ok(outcome): expect(outcome.0).to_equal("OK")
            Err(message): fail(message)
        var incomplete = terminal_v1()
        incomplete.tree_empty = false
        incomplete.active_processes = 1
        match builder_linux_terminal_outcome_v1(incomplete, false):
            Ok(_): fail("unreaped descendant admitted")
            Err(message): expect(message).to_contain("unproven")

    it "keeps timeout and cancellation out of successful results":
        var timed = terminal_v1()
        timed.timed_out = true
        match builder_linux_terminal_outcome_v1(timed, false):
            Ok(outcome):
                expect(outcome.0).to_equal("TIMEOUT")
                expect(outcome.1).to_equal(124)
            Err(message): fail(message)
        match builder_linux_terminal_outcome_v1(terminal_v1(), true):
            Ok(outcome):
                expect(outcome.0).to_equal("ERROR")
                expect(outcome.1).to_equal(125)
            Err(message): fail(message)
