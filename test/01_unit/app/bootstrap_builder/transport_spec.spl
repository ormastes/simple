use app.bootstrap_builder.transport.{builder_transport_parent_v1, builder_transport_shell_quote_v1, builder_transport_remote_path_valid_v1}

describe "bootstrap builder transport boundaries":
    it "preserves portable local parent paths":
        expect(builder_transport_parent_v1("D:/builder/attempt/work/a.o")).to_equal("D:/builder/attempt/work")
        expect(builder_transport_parent_v1("/builder/a.o")).to_equal("/builder")

    it "quotes apostrophes without exposing shell expansion":
        expect(builder_transport_shell_quote_v1("one'two")).to_equal("'one'\"'\"'two'")
        expect(builder_transport_shell_quote_v1("$(touch /tmp/bad); x")).to_equal("'$(touch /tmp/bad); x'")

    it "admits only portable absolute remote paths":
        expect(builder_transport_remote_path_valid_v1("/build/run-9/a_1.o")).to_equal(true)
        expect(builder_transport_remote_path_valid_v1("relative/path")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build/../outside")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build/./same")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build//same")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build/a;exit")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build/a\nexit")).to_equal(false)
        expect(builder_transport_remote_path_valid_v1("/build/a b")).to_equal(false)
