# Scheduling tests use real contract digests and explicit worker-reap events.
# Native process isolation and cache file hashing are exercised by CLI tests.
use std.spec.{describe, it, expect}
use app.bootstrap_builder.contracts.{BuildInputV1, BuildTaskV1, BuildHostV1, BuildResultV1, BuildRunV1, builder_task_identity_v1}
use app.bootstrap_builder.manager.{builder_manager_start, builder_manager_ready, builder_manager_dispatch, builder_manager_reap, builder_manager_accept, builder_manager_resume, builder_manager_done, builder_manager_succeeded, builder_manager_host_slots, builder_manager_encode_v1, builder_manager_decode_v1, builder_manager_unresolved}

fn manager_test_digest() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn manager_test_task(id: text, dependencies: [text]) -> BuildTaskV1:
    BuildTaskV1(id: id, attempt: 1, phase: "module", producer_digest: manager_test_digest(), source_digest: manager_test_digest(), toolchain_digest: manager_test_digest(), dependencies: dependencies, program: "llc", args: ["-filetype=obj", "input.ll", "-o", "{id}.o"], inputs: [BuildInputV1(path: "input.ll", digest: manager_test_digest())], outputs: ["{id}.o"], cache_key: manager_test_digest(), timeout_ms: 1000, memory_limit_bytes: 1073741824, links: [])

fn manager_test_run(tasks: [BuildTaskV1], keep_going: bool, max_attempts: i64) -> BuildRunV1:
    BuildRunV1(tasks: tasks, hosts: [BuildHostV1(id: "local", transport: "local", endpoint: "", workspace: ".", worker_program: "builder", worker_digest: manager_test_digest(), slots: 2)], keep_going: keep_going, max_attempts: max_attempts)

fn manager_test_result(task: BuildTaskV1, status: text) -> BuildResultV1:
    var outputs: [BuildInputV1] = []
    var exit_code = 1
    if status == "OK":
        exit_code = 0
        for path in task.outputs:
            outputs = outputs.push(BuildInputV1(path: path, digest: manager_test_digest()))
    BuildResultV1(task_id: task.id, attempt: task.attempt, identity_digest: builder_task_identity_v1(task), host_id: "local", status: status, exit_code: exit_code, outputs: outputs, cache_hits: 0, cache_misses: 1, cache_stores: 0)

describe "Bootstrap builder parent scheduling":
    it "dispatches independent roots and gates their descendant on admitted success":
        val tasks = [manager_test_task("a", []), manager_test_task("b", []), manager_test_task("join", ["a", "b"])]
        var state = builder_manager_start(manager_test_run(tasks, true, 1))
        expect(state.error).to_equal("")
        expect(builder_manager_ready(state)).to_equal([0, 1])
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_dispatch(state, 1, "local")
        expect(builder_manager_ready(state).len()).to_equal(0)
        expect(builder_manager_host_slots(state, "local")).to_equal(0)
        state = builder_manager_reap(state, "a", 1)
        val first = manager_test_result(tasks[0], "OK")
        state = builder_manager_accept(state, first, first.outputs)
        expect(builder_manager_ready(state).len()).to_equal(0)
        state = builder_manager_reap(state, "b", 1)
        val second = manager_test_result(tasks[1], "OK")
        state = builder_manager_accept(state, second, second.outputs)
        expect(builder_manager_ready(state)).to_equal([2])
        expect(builder_manager_succeeded(state)).to_equal(false)

    it "rejects admission before the actual worker is reaped":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 2))
        state = builder_manager_dispatch(state, 0, "local")
        val receipt = manager_test_result(task, "ERROR")
        state = builder_manager_accept(state, receipt, [])
        expect(state.error).to_contain("reaped")
        expect(state.tasks[0].attempt).to_equal(1)
        expect(state.statuses[0]).to_equal("RUNNING")

    it "retries only a reaped failure with a new attempt identity":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 2))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        state = builder_manager_accept(state, manager_test_result(task, "CRASHED"), [])
        expect(state.error).to_equal("")
        expect(state.tasks[0].attempt).to_equal(2)
        expect(state.statuses[0]).to_equal("PENDING")
        expect(builder_task_identity_v1(state.tasks[0]) == builder_task_identity_v1(task)).to_equal(false)

    it "discards an earlier result without disturbing the running retry":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 2))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        state = builder_manager_accept(state, manager_test_result(task, "CRASHED"), [])
        state = builder_manager_dispatch(state, 0, "local")
        val stale = manager_test_result(task, "OK")
        state = builder_manager_accept(state, stale, stale.outputs)
        expect(state.error).to_equal("")
        expect(state.statuses[0]).to_equal("RUNNING")
        expect(state.tasks[0].attempt).to_equal(2)
        expect(state.host_ids[0]).to_equal("local")
        expect(builder_manager_host_slots(state, "local")).to_equal(1)
        expect(builder_manager_done(state)).to_equal(false)
        state = builder_manager_reap(state, "a", 2)
        val current = manager_test_result(state.tasks[0], "OK")
        state = builder_manager_accept(state, current, current.outputs)
        expect(builder_manager_succeeded(state)).to_equal(true)

    it "records deterministic rejection once and preserves independent work on replay":
        val tasks = [manager_test_task("bad", []), manager_test_task("other", [])]
        val run = manager_test_run(tasks, true, 3)
        var state = builder_manager_start(run)
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "bad", 1)
        state = builder_manager_accept(state, manager_test_result(tasks[0], "ERROR"), [])
        expect(state.error).to_equal("")
        expect(state.tasks[0].attempt).to_equal(1)
        expect(state.statuses).to_equal(["FAILED", "PENDING"])
        expect(builder_manager_ready(state)).to_equal([1])
        match builder_manager_decode_v1(run, builder_manager_encode_v1(state)):
            Ok(restored):
                expect(restored.tasks[0].attempt).to_equal(1)
                expect(builder_manager_ready(restored)).to_equal([1])
            Err(message): expect(message).to_equal("valid deterministic failure journal")

    it "rejects a future-attempt result instead of discarding it as stale":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 2))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        var future = task
        future.attempt = 2
        val receipt = manager_test_result(future, "OK")
        state = builder_manager_accept(state, receipt, receipt.outputs)
        expect(state.error).to_contain("identity")
        expect(state.statuses[0]).to_equal("REAPED")

    it "rejects current-attempt identity tampering":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 1))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        var receipt = manager_test_result(task, "OK")
        receipt.identity_digest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        state = builder_manager_accept(state, receipt, receipt.outputs)
        expect(state.error).to_contain("identity")
        expect(state.statuses[0]).to_equal("REAPED")

    it "preserves unresolved reaped attempt while independent work continues":
        val tasks = [manager_test_task("a", []), manager_test_task("child", ["a"]), manager_test_task("other", [])]
        val run = manager_test_run(tasks, true, 2)
        var state = builder_manager_start(run)
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        state = builder_manager_unresolved(state, "a", 1)
        expect(state.statuses).to_equal(["UNRESOLVED", "BLOCKED", "PENDING"])
        expect(state.tasks[0].attempt).to_equal(1)
        expect(builder_manager_host_slots(state, "local")).to_equal(2)
        expect(builder_manager_ready(state)).to_equal([2])
        match builder_manager_decode_v1(run, builder_manager_encode_v1(state)):
            Ok(restored):
                expect(restored.statuses).to_equal(["RUNNING", "PENDING", "PENDING"])
                expect(restored.tasks[0].attempt).to_equal(1)
                expect(restored.host_ids[0]).to_equal("local")
            Err(reason):
                expect(reason).to_equal("")

    it "keeps an independent branch runnable but transitively blocks failed dependents":
        val tasks = [manager_test_task("leaf", ["middle"]), manager_test_task("middle", ["root"]), manager_test_task("root", []), manager_test_task("other", [])]
        var state = builder_manager_start(manager_test_run(tasks, true, 1))
        state = builder_manager_dispatch(state, 2, "local")
        state = builder_manager_reap(state, "root", 1)
        state = builder_manager_accept(state, manager_test_result(tasks[2], "TIMEOUT"), [])
        expect(state.statuses).to_equal(["BLOCKED", "BLOCKED", "FAILED", "PENDING"])
        expect(builder_manager_ready(state)).to_equal([3])
        expect(builder_manager_done(state)).to_equal(false)

    it "fail-fast stops pending work while draining an already running independent task":
        val tasks = [manager_test_task("a", []), manager_test_task("b", []), manager_test_task("c", [])]
        var state = builder_manager_start(manager_test_run(tasks, false, 1))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_dispatch(state, 1, "local")
        state = builder_manager_reap(state, "a", 1)
        state = builder_manager_accept(state, manager_test_result(tasks[0], "ERROR"), [])
        expect(state.statuses).to_equal(["FAILED", "RUNNING", "BLOCKED"])
        expect(builder_manager_done(state)).to_equal(false)
        state = builder_manager_reap(state, "b", 1)
        val receipt = manager_test_result(tasks[1], "OK")
        state = builder_manager_accept(state, receipt, receipt.outputs)
        expect(builder_manager_done(state)).to_equal(true)
        expect(builder_manager_succeeded(state)).to_equal(false)

    it "resumes exact cached output evidence and admits descendants":
        val tasks = [manager_test_task("a", []), manager_test_task("b", ["a"])]
        var state = builder_manager_start(manager_test_run(tasks, true, 1))
        val first = manager_test_result(tasks[0], "OK")
        state = builder_manager_resume(state, first, first.outputs)
        expect(state.error).to_equal("")
        expect(builder_manager_ready(state)).to_equal([1])
        val second = manager_test_result(tasks[1], "OK")
        state = builder_manager_resume(state, second, second.outputs)
        expect(builder_manager_done(state)).to_equal(true)
        expect(builder_manager_succeeded(state)).to_equal(true)

    it "rejects cached child success until dependencies are admitted":
        val tasks = [manager_test_task("a", []), manager_test_task("b", ["a"])]
        var state = builder_manager_start(manager_test_run(tasks, true, 1))
        val receipt = manager_test_result(tasks[1], "OK")
        state = builder_manager_resume(state, receipt, receipt.outputs)
        expect(state.error).to_contain("dependencies")
        expect(state.statuses[1]).to_equal("PENDING")

    it "rejects output changed since the successful cached receipt":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 1))
        val receipt = manager_test_result(task, "OK")
        state = builder_manager_resume(state, receipt, [BuildInputV1(path: "a.o", digest: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")])
        expect(state.error).to_contain("digest")
        expect(state.statuses[0]).to_equal("PENDING")

    it "rejects result from a different host":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 1))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        var receipt = manager_test_result(task, "OK")
        receipt.host_id = "stranger"
        state = builder_manager_accept(state, receipt, receipt.outputs)
        expect(state.error).to_contain("host")

    it "bounds host occupancy even when a caller ignores ready results":
        val tasks = [manager_test_task("a", []), manager_test_task("b", []), manager_test_task("c", [])]
        var state = builder_manager_start(manager_test_run(tasks, true, 1))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_dispatch(state, 1, "local")
        state = builder_manager_dispatch(state, 2, "local")
        expect(state.error).to_contain("full")
        expect(state.statuses[2]).to_equal("PENDING")

    it "rejects duplicate result admission":
        val task = manager_test_task("a", [])
        var state = builder_manager_start(manager_test_run([task], true, 1))
        state = builder_manager_dispatch(state, 0, "local")
        state = builder_manager_reap(state, "a", 1)
        val receipt = manager_test_result(task, "OK")
        state = builder_manager_accept(state, receipt, receipt.outputs)
        state = builder_manager_accept(state, receipt, receipt.outputs)
        expect(state.error).to_contain("reaped")

    it "rejects cyclic plans before dispatch":
        val tasks = [manager_test_task("a", ["b"]), manager_test_task("b", ["a"])]
        val state = builder_manager_start(manager_test_run(tasks, true, 1))
        expect(state.error == "").to_equal(false)
        expect(builder_manager_ready(state).len()).to_equal(0)

    it "restores completed attempts as pending fresh cache verification":
        val task = manager_test_task("a", [])
        val run = manager_test_run([task], true, 1)
        var state = builder_manager_start(run)
        val receipt = manager_test_result(task, "OK")
        state = builder_manager_resume(state, receipt, receipt.outputs)
        val decoded = builder_manager_decode_v1(run, builder_manager_encode_v1(state))
        match decoded:
            Ok(restored):
                expect(restored.statuses).to_equal(["PENDING"])
                expect(builder_manager_succeeded(restored)).to_equal(false)
                expect(restored.tasks[0].attempt).to_equal(1)
            Err(reason):
                expect(reason).to_equal("")

    it "preserves live attempt and host slot until transport recovery proves termination":
        val task = manager_test_task("a", [])
        val run = manager_test_run([task], true, 1)
        var state = builder_manager_start(run)
        state = builder_manager_dispatch(state, 0, "local")
        match builder_manager_decode_v1(run, builder_manager_encode_v1(state)):
            Ok(restored):
                expect(restored.statuses[0]).to_equal("RUNNING")
                expect(restored.host_ids[0]).to_equal("local")
                expect(restored.tasks[0].attempt).to_equal(1)
                expect(builder_manager_host_slots(restored, "local")).to_equal(1)
                expect(builder_manager_done(restored)).to_equal(false)
            Err(reason):
                expect(reason).to_equal("")

    it "binds manager journal to full host and run configuration":
        val task = manager_test_task("a", [])
        val run = manager_test_run([task], true, 1)
        val state = builder_manager_start(run)
        val changed = manager_test_run([task], false, 1)
        match builder_manager_decode_v1(changed, builder_manager_encode_v1(state)):
            Ok(restored):
                expect(restored.run.keep_going).to_equal(true)
            Err(reason):
                expect(reason).to_contain("manifest identity")
