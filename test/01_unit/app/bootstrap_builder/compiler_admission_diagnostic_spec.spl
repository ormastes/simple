use std.spec.{describe, it, expect}
use app.bootstrap_builder.compiler_admission_diagnostic.{builder_compiler_admission_diagnostic_v1}

describe "compiler admission diagnostic boundary":
    it "recognizes an authority refusal despite public exit one":
        expect(builder_compiler_admission_diagnostic_v1("SCV-E-ADMISSION: source-inventory-scope-unsupported\n")).to_equal(true)
    it "recognizes prefixed CRLF authority diagnostics":
        expect(builder_compiler_admission_diagnostic_v1("error: SCV-E-ADMISSION: stale\r\n")).to_equal(true)
    it "recognizes the bare marker":
        expect(builder_compiler_admission_diagnostic_v1("SCV-E-ADMISSION:\n")).to_equal(true)
    it "does not turn parser trace text into authority failure":
        expect(builder_compiler_admission_diagnostic_v1("[parser] text=SCV-E-ADMISSION: quoted\n")).to_equal(false)
    it "does not match ordinary mentions or another diagnostic identifier":
        expect(builder_compiler_admission_diagnostic_v1("ordinary message mentions SCV-E-ADMISSION: bad\nSCV-E-ADMISSION-extra: bad\n")).to_equal(false)
