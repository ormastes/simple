use std.spec.{describe, it, expect}
use std.common.build_manager.grouped_native_contract.{NativeGroupMemberV1, NativeModuleResultV1,
    NativeGroupManifestV1, NativeGroupRunV1, NativeGroupResourceV1, native_group_scc_set_id_v1, native_module_result_encode_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.env_ops.{cwd}
use app.io.dir_ops.{dir_create_all}
use app.io.file_ops.{file_atomic_write}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use app.bootstrap_builder.grouped_native_run.{native_group_normalize_crashed_sccs_v1,
    native_group_demote_unqualified_smf_v1, native_group_blocked_payload_v1,
    native_group_blocked_marker_matches_v1, native_group_has_compile_failure_v1,
    native_group_failure_class_v1, native_group_recover_progress_v1,
    native_group_attempt_root_v1, native_group_cache_root_v1, native_group_environment_v1}

describe "grouped native terminal failure classification":
    it "retains a deterministic compiler rejection without retrying the same group":
        val rows = [NativeModuleResultV1("bad", "ERROR", 1, "SMF", "", "", false, "")]
        expect(native_group_has_compile_failure_v1(rows)).to_equal(true)
        expect(native_group_failure_class_v1(rows, 1, false)).to_equal("compile-failure")

    it "stops a resource or containment failure even when a peer reports a compiler error":
        var rows = [NativeModuleResultV1("bad", "ERROR", 1, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(rows, 1, true)).to_equal("infrastructure-abort")
        expect(native_group_failure_class_v1(rows, 137, false)).to_equal("infrastructure-abort")
        rows = rows.push(NativeModuleResultV1("peer", "TIMEOUT", 124, "SMF", "", "", false, ""))
        expect(native_group_failure_class_v1(rows, 1, false)).to_equal("infrastructure-abort")

    it "rejects unclassified worker errors and unstarted members after a signal":
        val error_rows = [NativeModuleResultV1("bad", "ERROR", 2, "SMF", "", "", false, "")]
        expect(native_group_has_compile_failure_v1(error_rows)).to_equal(false)
        expect(native_group_failure_class_v1(error_rows, 1, false)).to_equal("infrastructure-abort")
        val pending = [NativeModuleResultV1("pending", "NOT_RUN", 143, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(pending, 1, false)).to_equal("infrastructure-abort")

    it "allows success and requires a real compiler failure beside dependent blocking":
        var rows = [NativeModuleResultV1("ok", "OK", 0, "SMF", "a.smf", "", true, "")]
        expect(native_group_has_compile_failure_v1(rows)).to_equal(false)
        expect(native_group_failure_class_v1(rows, 0, false)).to_equal("complete")
        rows = rows.push(NativeModuleResultV1("blocked", "BLOCKED", 1, "SMF", "", "", false, ""))
        expect(native_group_failure_class_v1(rows, 1, false)).to_equal("infrastructure-abort")
        rows = rows.push(NativeModuleResultV1("bad", "ERROR", 1, "SMF", "", "", false, ""))
        expect(native_group_failure_class_v1(rows, 1, false)).to_equal("compile-failure")

    it "rejects exit one without any compiler rejection witness":
        val pending = [NativeModuleResultV1("pending", "NOT_RUN", 1, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(pending, 1, false)).to_equal("infrastructure-abort")
        val blocked = [NativeModuleResultV1("blocked", "BLOCKED", 1, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(blocked, 1, false)).to_equal("infrastructure-abort")
        expect(native_group_failure_class_v1([], 0, false)).to_equal("infrastructure-abort")
        val empty_success = [NativeModuleResultV1("pending", "NOT_RUN", 0, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(empty_success, 0, false)).to_equal("infrastructure-abort")
        val inconsistent = [NativeModuleResultV1("bad", "ERROR", 1, "SMF", "", "", false, "")]
        expect(native_group_failure_class_v1(inconsistent, 0, false)).to_equal("infrastructure-abort")

    it "recovers missing worker evidence through the filesystem without inventing compiler failure":
        val root = cwd().replace("\\", "/") + "/build/group-missing-result-" + str(getpid())
        expect(dir_create_all(root + "/progress")).to_equal(true)
        val digest = "a".repeat(64)
        val member = NativeGroupMemberV1("missing", "scc", "src/missing.spl", digest,
            "SMF", "smf/llvm/missing.smf")
        val manifest = NativeGroupManifestV1(digest, digest, digest, digest,
            root + "/route.sdn", digest, digest, digest, "phase4", "llvm",
            "x86_64-pc-windows-msvc", "group-1", native_group_scc_set_id_v1([member]),
            1, 1, digest, 1, 1073741824, 1, [member])
        match native_group_recover_progress_v1(root, manifest, 1, false):
            Ok(rows):
                expect(rows.len()).to_equal(1)
                expect(rows[0].status).to_equal("NOT_RUN")
                expect(native_group_failure_class_v1(rows, 1, false)).to_equal("infrastructure-abort")
            Err(reason): expect(reason).to_equal("recover missing worker rows")
        val progress = root + "/progress/" + sha256_text("missing") + ".sdn"
        expect(file_atomic_write(progress, native_module_result_encode_v1(
            NativeModuleResultV1("missing", "ERROR", 1, "SMF", "", "", false, "")))).to_equal(true)
        match native_group_recover_progress_v1(root, manifest, 1, false):
            Ok(rows): expect(native_group_failure_class_v1(rows, 1, false)).to_equal("compile-failure")
            Err(reason): expect(reason).to_equal("recover exact compiler progress")

describe "grouped native dependency decision binding":
    it "rejects a stale blocked marker from another run, inventory, or state root":
        val manifest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val inventory = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        val changed_inventory = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        val marker = native_group_blocked_payload_v1(
            "run-a", inventory, "C:/state/a", manifest)
        expect(native_group_blocked_marker_matches_v1(
            "run-a", inventory, "C:/state/a", manifest, marker)).to_equal(true)
        expect(native_group_blocked_marker_matches_v1(
            "run-b", inventory, "C:/state/a", manifest, marker)).to_equal(false)
        expect(native_group_blocked_marker_matches_v1(
            "run-a", changed_inventory, "C:/state/a", manifest, marker)).to_equal(false)
        expect(native_group_blocked_marker_matches_v1(
            "run-a", inventory, "C:/state/b", manifest, marker)).to_equal(false)
        expect(native_group_blocked_marker_matches_v1(
            "run-a", inventory, "C:/state/a", manifest,
            marker.replace("BLOCKED-2", "BLOCKED-1"))).to_equal(false)

fn crashed_scc_members_v1() -> [NativeGroupMemberV1]:
    [NativeGroupMemberV1("m1", "scc-a", "src/a.spl", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "OBJECT", "objects/a.o"),
        NativeGroupMemberV1("m2", "scc-a", "src/b.spl", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "OBJECT", "objects/b.o"),
        NativeGroupMemberV1("m3", "scc-b", "src/c.spl", "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "OBJECT", "objects/c.o")]

fn crashed_scc_progress_v1() -> [NativeModuleResultV1]:
    [NativeModuleResultV1("m1", "OK", 0, "OBJECT", "objects/a.o",
        "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", false, ""),
        NativeModuleResultV1("m2", "NOT_RUN", 139, "OBJECT", "", "", false, ""),
        NativeModuleResultV1("m3", "OK", 0, "OBJECT", "objects/c.o",
        "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", false, "")]

describe "grouped native crash SCC normalization":
    it "retries successful peers of a failed SCC while preserving independent success":
        val normalized = native_group_normalize_crashed_sccs_v1(
            crashed_scc_members_v1(), crashed_scc_progress_v1(), 139)
        expect(normalized[0].status).to_equal("BLOCKED")
        expect(normalized[0].output_path).to_equal("")
        expect(normalized[1].status).to_equal("NOT_RUN")
        expect(normalized[2].status).to_equal("OK")
        expect(normalized[2].output_path).to_equal("objects/c.o")

    it "rejects progress-only success when the process exits in failure":
        var progress = crashed_scc_progress_v1()
        progress[1] = NativeModuleResultV1("m2", "OK", 0, "OBJECT", "objects/b.o",
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", false, "")
        val normalized = native_group_normalize_crashed_sccs_v1(
            crashed_scc_members_v1(), progress, 139)
        expect(normalized[0].status).to_equal("BLOCKED")
        expect(normalized[1].status).to_equal("BLOCKED")
        expect(normalized[2].status).to_equal("BLOCKED")

    it "retries a crashed worker's unqualified SMF and its complete SCC":
        val members = [NativeGroupMemberV1("m1", "scc-a", "src/a.spl",
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "SMF", "smf/a.smf"),
            NativeGroupMemberV1("m2", "scc-a", "src/b.spl",
                "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "SMF", "smf/b.smf"),
            NativeGroupMemberV1("m3", "scc-b", "src/c.spl",
                "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
                "SMF", "smf/c.smf")]
        val rows = [NativeModuleResultV1("m1", "OK", 0, "SMF", "smf/a.smf",
                "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
                false, ""),
            NativeModuleResultV1("m2", "OK", 0, "SMF", "smf/b.smf",
                "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
                true, "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"),
            NativeModuleResultV1("m3", "OK", 0, "SMF", "smf/c.smf",
                "1111111111111111111111111111111111111111111111111111111111111111",
                true, "2222222222222222222222222222222222222222222222222222222222222222")]
        val normalized = native_group_demote_unqualified_smf_v1(
            members, rows, 139, false)
        expect(normalized[0].status).to_equal("CRASHED")
        expect(normalized[1].status).to_equal("BLOCKED")
        expect(normalized[2].status).to_equal("OK")

fn stable_manifest_v1(group_id: text, generation: i64, attempt: i64) -> NativeGroupManifestV1:
    val members = [NativeGroupMemberV1("m1", "scc-a", "src/a.spl", "a".repeat(64), "OBJECT", "objects/a.o")]
    NativeGroupManifestV1("1".repeat(64), "2".repeat(64), "9".repeat(64), "c".repeat(64),
        "C:/state/routes/group_a-1.route", "f".repeat(64),
        "3".repeat(64), "4".repeat(64),
        "phase4", "llvm", "x86_64", group_id, native_group_scc_set_id_v1(members),
        generation, attempt, "5".repeat(64), 1, 1073741824, 2, members)

fn stable_run_v1() -> NativeGroupRunV1:
    NativeGroupRunV1("run_a", "1".repeat(64), "2".repeat(64), "9".repeat(64), "a".repeat(64),
        "c".repeat(64), "3".repeat(64), "4".repeat(64),
        "phase4", "llvm", "x86_64", "5".repeat(64), 2, 1073741824, 2,
        268435456, 536870912, 1073741824,
        "C:/source/build/scv/snapshots/rev1", "rev1", "commit1", "tree1",
        "C:/state/source-inputs-before.txt", "C:/bin/tool.exe", "C:/bin/runtime.exe",
        "C:/state/variant.receipt", "d".repeat(64),
        "C:/source/build/warm-index/runtime-std.authority", "6".repeat(64),
        "C:/source/build/warm-index", "0".repeat(64),
        "C:/state/scv.receipt", "e".repeat(64),
        "C:/source", "C:/state", "C:/output", "C:/bin/simple.exe",
        "C:/bin/manager.exe", "b".repeat(64),
        "C:/bin/worker.exe", "6".repeat(64), "C:/bin/broker.exe", "7".repeat(64),
        ["MODE=release"], 3, 100, 60000, [], [], [])

fn env_assignment_v1(environment: [text], name: text) -> text:
    for item in environment:
        if item.starts_with(name + "="): return item[name.len() + 1:]
    "<missing>"

describe "grouped native stable compiler cache root":
    it "reuses one cache root across attempts and generations of a group":
        val run = stable_run_v1()
        val first = stable_manifest_v1("group-1", 1, 1)
        val retry = stable_manifest_v1("group-1", 1, 2)
        val next_generation = stable_manifest_v1("group-1", 2, 1)
        val root = native_group_cache_root_v1(run, first)
        expect(native_group_cache_root_v1(run, retry)).to_equal(root)
        expect(native_group_cache_root_v1(run, next_generation)).to_equal(root)
        expect(native_group_attempt_root_v1(run, first) != native_group_attempt_root_v1(run, retry)).to_equal(true)

    it "keys the cache root by admitted identity":
        val run = stable_run_v1()
        val manifest = stable_manifest_v1("group-1", 1, 1)
        val base = native_group_cache_root_v1(run, manifest)
        var producer = stable_run_v1()
        producer.producer_digest = "b".repeat(64)
        expect(native_group_cache_root_v1(producer, manifest) != base).to_equal(true)
        var inventory = stable_run_v1()
        inventory.inventory_digest = "b".repeat(64)
        expect(native_group_cache_root_v1(inventory, manifest) != base).to_equal(true)
        var variant = stable_run_v1()
        variant.variant_digest = "b".repeat(64)
        expect(native_group_cache_root_v1(variant, manifest) != base).to_equal(true)
        var index = stable_run_v1()
        index.index_digest = "b".repeat(64)
        expect(native_group_cache_root_v1(index, manifest) != base).to_equal(true)
        var output = stable_run_v1()
        output.output_root = "C:/output-2"
        expect(native_group_cache_root_v1(output, manifest) != base).to_equal(true)
        expect(native_group_cache_root_v1(run, stable_manifest_v1("group-2", 1, 1)) != base).to_equal(true)

    it "keeps the cache root short and under state_root":
        val run = stable_run_v1()
        val root = native_group_cache_root_v1(run, stable_manifest_v1("group-1", 1, 1))
        expect(root.starts_with(run.state_root + "/groups/")).to_equal(true)
        expect(root.len() - run.state_root.len()).to_equal(95)
        val segments = root.split("/")
        val leaf = segments[segments.len() - 1]
        expect(leaf.len()).to_equal(22)
        expect(leaf.starts_with("cache-")).to_equal(true)
        val hex = leaf[6:]
        for i in 0..16:
            expect("0123456789abcdef".contains(hex[i:i + 1])).to_equal(true)

    it "points compiler caches at the stable root and temp at the attempt root":
        val run = stable_run_v1()
        val manifest = stable_manifest_v1("group-1", 1, 1)
        val cache_root = native_group_cache_root_v1(run, manifest)
        val attempt_root = native_group_attempt_root_v1(run, manifest)
        val resource = NativeGroupResourceV1("group-1", 1, 1073741824, 1073741824, 1073741824, true, 268435456, 536870912)
        val environment = native_group_environment_v1(run, attempt_root, cache_root, resource)
        expect(env_assignment_v1(environment, "SIMPLE_NATIVE_BUILD_CACHE_DIR")).to_equal(cache_root + "/SIMPLE_NATIVE_BUILD_CACHE_DIR")
        expect(env_assignment_v1(environment, "SIMPLE_HIR_CACHE_DIR")).to_equal(cache_root + "/SIMPLE_HIR_CACHE_DIR")
        expect(env_assignment_v1(environment, "SIMPLE_CACHE")).to_equal(cache_root + "/cache")
        expect(env_assignment_v1(environment, "TMPDIR")).to_equal(attempt_root + "/private/TMPDIR")
