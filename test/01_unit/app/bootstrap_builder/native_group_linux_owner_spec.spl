use std.spec.{describe, it, expect, fail}
use std.nogc_sync_mut.io.linux_process_owner.{LinuxProcessInputV1, LinuxProcessRequestV1,
    linux_process_request_valid_v1, linux_available_capacity_v1}

fn native_linux_owner_fixture_v1() -> LinuxProcessRequestV1:
    LinuxProcessRequestV1("/frozen/bin/worker",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        ["--group-root", "/state/group"], ["SIMPLE_CACHE=/state/group/cache"],
        "/state/group", [LinuxProcessInputV1("/state/group/worker.request.sdn",
            "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")],
        "/state/group/stdout.log", "/state/group/stderr.log", 3600000)

describe "Linux grouped process owner admission":
    it "accepts a bounded absolute pinned request envelope":
        expect(linux_process_request_valid_v1(native_linux_owner_fixture_v1(),
            "/state/group", "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            1073741824)).to_equal("")

    it "rejects relative paths and environment without assignment":
        var request = native_linux_owner_fixture_v1()
        request.directory = "state/group"
        expect(linux_process_request_valid_v1(request, "/state/group",
            "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            1073741824)).to_contain("absolute")
        request = native_linux_owner_fixture_v1()
        request.environment = ["SIMPLE_CACHE"]
        expect(linux_process_request_valid_v1(request, "/state/group",
            "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
            1073741824)).to_contain("environment")

    it "fails a relative capacity path before querying the host":
        match linux_available_capacity_v1("relative/path"):
            Ok(_): fail("relative Linux capacity path admitted")
            Err(reason): expect(reason).to_contain("absolute")
