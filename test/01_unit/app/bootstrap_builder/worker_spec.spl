use app.bootstrap_builder.contracts.{BuildTaskV1, BuildInputV1}
use app.bootstrap_builder.worker.{builder_worker_verify_inputs_v1, builder_worker_outputs_v1}
use app.io.mod.{dir_create_all, file_write, getpid}

val BUILDER_ABC_SHA256 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

fn worker_fixture_task() -> BuildTaskV1:
    BuildTaskV1(id: "worker-fixture", attempt: 1, phase: "module",
        producer_digest: BUILDER_ABC_SHA256, source_digest: BUILDER_ABC_SHA256,
        toolchain_digest: BUILDER_ABC_SHA256, dependencies: [], program: "compiler",
        args: ["-o", "out.obj", "input.ll"],
        inputs: [BuildInputV1(path: "input.ll", digest: BUILDER_ABC_SHA256)],
        outputs: ["out.obj"], cache_key: BUILDER_ABC_SHA256, timeout_ms: 1000,
        memory_limit_bytes: 1073741824, links: [])

describe "bootstrap builder worker immutable staging":
    it "checks actual input and producer bytes before admitting execution":
        val root = "build/bootstrap-builder-worker-input-test-" + str(getpid())
        expect(dir_create_all(root + "/work")).to_equal(true)
        expect(file_write(root + "/producer.exe", "abc")).to_equal(true)
        expect(file_write(root + "/work/input.ll", "abc")).to_equal(true)
        expect(builder_worker_verify_inputs_v1(worker_fixture_task(), root)).to_equal("")
        expect(file_write(root + "/work/input.ll", "changed")).to_equal(true)
        expect(builder_worker_verify_inputs_v1(worker_fixture_task(), root)).to_equal("input digest mismatch: input.ll")
        expect(file_write(root + "/work/input.ll", "abc")).to_equal(true)
        expect(file_write(root + "/producer.exe", "changed")).to_equal(true)
        expect(builder_worker_verify_inputs_v1(worker_fixture_task(), root)).to_equal("producer digest mismatch")

    it "requires every declared regular output and records its actual digest":
        val root = "build/bootstrap-builder-worker-output-test-" + str(getpid())
        expect(dir_create_all(root + "/work")).to_equal(true)
        expect(builder_worker_outputs_v1(worker_fixture_task(), root).is_err()).to_equal(true)
        expect(file_write(root + "/work/out.obj", "abc")).to_equal(true)
        val outputs = builder_worker_outputs_v1(worker_fixture_task(), root).unwrap()
        expect(outputs.len()).to_equal(1)
        expect(outputs[0].path).to_equal("out.obj")
        expect(outputs[0].digest).to_equal(BUILDER_ABC_SHA256)
