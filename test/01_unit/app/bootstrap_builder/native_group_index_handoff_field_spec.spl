use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.native_group_index_handoff.{NativeGroupIndexHandoffV1}
use app.bootstrap_builder.native_group_index_handoff_field.{
    native_group_index_handoff_field_from_value_v1,
    native_group_index_handoff_field_v1}

fn handoff_field_fixture_v1() -> NativeGroupIndexHandoffV1:
    NativeGroupIndexHandoffV1("1".repeat(64), "2".repeat(64),
        "3".repeat(64), "phase4", "llvm", "x86_64-pc-windows-msvc",
        "a".repeat(64), "b".repeat(64), "c".repeat(64), 15754,
        "d".repeat(64), "e".repeat(64), "D:/attempt/work/index-cache",
        "D:/attempt/work/index-cache/package-module-index-v1/e.variant",
        "f".repeat(64),
        "D:/attempt/work/index-cache/runtime-std-authority-v1/g.receipt",
        "0".repeat(64), "D:/attempt")

describe "native index handoff field CLI projection":
    it "exports only explicit grouped pins and Phase3 inventory identity":
        val handoff = handoff_field_fixture_v1()
        match native_group_index_handoff_field_from_value_v1(handoff,
                "phase"):
            Ok(value): expect(value).to_equal("phase4")
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "backend"):
            Ok(value): expect(value).to_equal("llvm")
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "source_count"):
            Ok(value): expect(value).to_equal("15754")
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "index_read_root"):
            Ok(value): expect(value).to_equal("D:/attempt/work/index-cache")
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "variant_receipt_digest"):
            Ok(value): expect(value).to_equal("f".repeat(64))
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "runtime_std_authority_path"):
            Ok(value): expect(value).to_equal(
                "D:/attempt/work/index-cache/runtime-std-authority-v1/g.receipt")
            Err(reason): fail(reason)
        match native_group_index_handoff_field_from_value_v1(handoff,
                "manager_receipt_digest"):
            Ok(_): fail("unexported handoff field disclosed")
            Err(reason): expect(reason).to_contain("not exported")
        match native_group_index_handoff_field_from_value_v1(handoff,
                "index_read_root\nmanager_receipt_digest"):
            Ok(_): fail("arbitrary field reflection admitted")
            Err(reason): expect(reason).to_contain("not exported")

    it "requires a pinned canonical handoff before returning any field":
        match native_group_index_handoff_field_v1("relative/handoff.sdn",
                "1".repeat(64), "index_read_root"):
            Ok(_): fail("relative handoff authority accepted")
            Err(reason): expect(reason).to_contain("path")
