use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.native_group_phase2_receipt.{
    Phase2ReceiptArtifactV1, Phase2ReceiptInventoryV1,
    Phase2ReceiptScvV1, Phase2NativeAuthorityReceiptV1,
    phase2_native_authority_receipt_encode_v1,
    phase2_native_authority_receipt_decode_v1
}

fn phase2_test_receipt_v1() -> Phase2NativeAuthorityReceiptV1:
    val root = "D:/phase2-authority"
    val source = root + "/source-root"
    Phase2NativeAuthorityReceiptV1(root, source,
        "x86_64-pc-windows-msvc",
        Phase2ReceiptArtifactV1("D:/stage2/admission.receipt",
            "a".repeat(64)), "b".repeat(64),
        Phase2ReceiptArtifactV1("D:/stage2/simple.exe",
            "c".repeat(64)),
        Phase2ReceiptArtifactV1(root + "/source-inputs-before.txt",
            "d".repeat(64)),
        Phase2ReceiptInventoryV1(source + "/source.inventory",
            "e".repeat(64), 16000),
        Phase2ReceiptInventoryV1(source + "/full-source.inventory",
            "f".repeat(64), 18000),
        Phase2ReceiptInventoryV1(source + "/full-source-links.inventory",
            "1".repeat(64), 3),
        Phase2ReceiptInventoryV1(root + "/module.inventory",
            "2".repeat(64), 3),
        Phase2ReceiptInventoryV1(root + "/excluded-modules.inventory",
            "a".repeat(64), 2),
        Phase2ReceiptArtifactV1(source +
            "/src/package_ownership/native_module_roles.sdn",
            "b".repeat(64)),
        Phase2ReceiptScvV1(source + "/build/scv/snapshots/rev",
            Phase2ReceiptArtifactV1(source + "/build/scv/receipts/rev.receipt",
                "3".repeat(64)), "rev", "commit", "tree",
            "4".repeat(64), "5".repeat(64), 0, "8".repeat(64)),
        Phase2ReceiptArtifactV1(root + "/index-config-llvm.sdn",
            "6".repeat(64)),
        Phase2ReceiptArtifactV1(root + "/index-config-cranelift.sdn",
            "7".repeat(64)),
        Phase2ReceiptArtifactV1(root + "/index-config-phase3-llvm.sdn",
            "9".repeat(64)),
        Phase2ReceiptArtifactV1(root + "/index-config-phase3-cranelift.sdn",
            "0".repeat(64)))

describe "Phase2 native authority typed receipt":
    it "roundtrips every source, SCV, link and backend identity":
        val expected = phase2_test_receipt_v1()
        val payload = phase2_native_authority_receipt_encode_v1(expected)
        match phase2_native_authority_receipt_decode_v1(payload):
            Ok(actual):
                expect(actual.source_inventory.count).to_equal(16000)
                expect(actual.full_source_inventory.count).to_equal(18000)
                expect(actual.full_source_links.count).to_equal(3)
                expect(actual.module_inventory.count).to_equal(3)
                expect(actual.excluded_inventory.count).to_equal(2)
                expect(actual.module_role_policy.path).to_equal(
                    "D:/phase2-authority/source-root/src/package_ownership/native_module_roles.sdn")
                expect(actual.scv.snapshot_inventory_digest).to_equal(
                    "4".repeat(64))
                expect(actual.scv.package_policy_digest).to_equal(
                    "8".repeat(64))
                expect(actual.llvm_index_config.path).to_equal(
                    "D:/phase2-authority/index-config-llvm.sdn")
                expect(actual.phase3_llvm_index_config.path).to_equal(
                    "D:/phase2-authority/index-config-phase3-llvm.sdn")
            Err(reason): fail(reason)

    it "rejects reordered rows and config paths outside the retained root":
        val payload = phase2_native_authority_receipt_encode_v1(
            phase2_test_receipt_v1())
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "output_root=D:/phase2-authority\nsource_root=",
                "source_root=D:/phase2-authority\noutput_root=")):
            Ok(_): fail("reordered authority rows admitted")
            Err(reason): expect(reason).to_contain("order")
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "index-config-llvm.sdn", "outside-llvm.sdn")):
            Ok(_): fail("moved index config admitted")
            Err(reason): expect(reason).to_contain("ownership")

    it "rejects a Phase3 config outside its private authority root":
        val payload = phase2_native_authority_receipt_encode_v1(
            phase2_test_receipt_v1())
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "index-config-phase3-llvm.sdn", "outside-phase3.sdn")):
            Ok(_): fail("moved Phase3 config admitted")
            Err(reason): expect(reason).to_contain("ownership")

    it "rejects ledger relocation, policy relocation, and duplicate rows":
        val payload = phase2_native_authority_receipt_encode_v1(
            phase2_test_receipt_v1())
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "excluded-modules.inventory", "moved-exclusions.inventory")):
            Ok(_): fail("moved exclusion ledger admitted")
            Err(reason): expect(reason).to_contain("ownership")
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "native_module_roles.sdn", "other_policy.sdn")):
            Ok(_): fail("moved policy admitted")
            Err(reason): expect(reason).to_contain("ownership")
        match phase2_native_authority_receipt_decode_v1(payload.replace(
                "excluded_inventory_count=2\n",
                "excluded_inventory_count=2\nexcluded_inventory_count=2\n")):
            Ok(_): fail("duplicate exclusion count admitted")
            Err(reason): expect(reason).to_contain("count")
