use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.grouped_native_worker.{NativeGroupWorkerRequestV1,
    native_group_worker_request_encode_v1, native_group_worker_request_decode_v1,
    native_group_worker_request_valid_v1}

fn native_worker_fixture_v1() -> NativeGroupWorkerRequestV1:
    NativeGroupWorkerRequestV1("D:/bin/simple.exe",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "D:/state/group/group.manifest.sdn",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "D:/state/group/result.sdn", "D:/frozen", "D:/frozen/src/lib/a.spl",
        "D:/phase2/index",
        "llvm", 2, "x86_64-pc-windows-msvc", 3600000)

describe "grouped native worker request":
    it "round trips the exact pinned compiler invocation":
        val request = native_worker_fixture_v1()
        expect(native_group_worker_request_valid_v1(request)).to_equal("")
        val payload = native_group_worker_request_encode_v1(request)
        match native_group_worker_request_decode_v1(payload):
            Ok(decoded): expect(native_group_worker_request_encode_v1(decoded)).to_equal(payload)
            Err(reason): fail(reason)

    it "rejects relative paths, invalid backend, and excess threads":
        var request = native_worker_fixture_v1()
        request.group_result = "result.sdn"
        expect(native_group_worker_request_valid_v1(request)).to_contain("absolute")
        request = native_worker_fixture_v1()
        request.backend = "diagnostic"
        expect(native_group_worker_request_valid_v1(request)).to_contain("backend")
        request = native_worker_fixture_v1()
        request.threads = 257
        expect(native_group_worker_request_valid_v1(request)).to_contain("thread")

    it "rejects trailing data after a canonical worker request":
        val payload = native_group_worker_request_encode_v1(native_worker_fixture_v1())
        match native_group_worker_request_decode_v1(payload + "junk"):
            Ok(_): fail("trailing data accepted")
            Err(reason): expect(reason != "").to_equal(true)
