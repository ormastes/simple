use std.spec.{describe, it, expect}
use app.bootstrap_builder.failure_policy.{builder_failure_class_v1}

describe "managed compile failure continuation":
    it "continues only a reaped deterministic compiler rejection":
        expect(builder_failure_class_v1("ERROR", 1, true)).to_equal("compile-failure")
        expect(builder_failure_class_v1("OK", 0, true)).to_equal("complete")

    it "does not turn a no-child launch rejection into a compiler failure":
        expect(builder_failure_class_v1("ERROR", 1, false)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("OK", 0, false)).to_equal("infrastructure-abort")

    it "stops on worker diagnostics, timeout, cancellation and unknown exits":
        expect(builder_failure_class_v1("ERROR", 2, true)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("TIMEOUT", 124, true)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("ERROR", 125, true)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("CRASHED", 139, true)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("ERROR", 0, true)).to_equal("infrastructure-abort")
        expect(builder_failure_class_v1("OK", 1, true)).to_equal("infrastructure-abort")
