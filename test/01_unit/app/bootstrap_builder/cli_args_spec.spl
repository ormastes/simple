use std.spec.{describe, it, expect}
use app.bootstrap_builder.cli_args.{builder_cli_parse_v1}

describe "native bootstrap builder CLI":
    it "preserves paths as argv values":
        val parsed = builder_cli_parse_v1(["run", "--manifest", "D:/build lane/tasks.sdn",
            "--state", "D:/build lane/state", "--source-root", "D:/source lane",
            "--output-root", "D:/private output"])
        expect(parsed.error).to_equal("")
        expect(parsed.manifest).to_equal("D:/build lane/tasks.sdn")
        expect(parsed.source_root).to_equal("D:/source lane")
        expect(parsed.output_root).to_equal("D:/private output")

    it "accepts read-only verify with separate source and output roots":
        val parsed = builder_cli_parse_v1(["verify", "--manifest", "D:/private/job.sdn",
            "--state", "D:/private/state", "--source-root", "D:/snapshot",
            "--output-root", "D:/private/outputs"])
        expect(parsed.error).to_equal("")
        expect(parsed.command).to_equal("verify")
        expect(parsed.output_root).to_equal("D:/private/outputs")
        expect(builder_cli_parse_v1(["verify", "--manifest", "job.sdn"]).error).to_contain("requires")
        expect(builder_cli_parse_v1(["check", "--manifest", "job.sdn", "--output-root", "D:/other"]).error).to_contain("invalid")

    it "requires every worker boundary argument":
        expect(builder_cli_parse_v1(["worker", "--request", "task.sdn", "--attempt-root", "attempt", "--host", "local"]).error).to_equal("")
        expect(builder_cli_parse_v1(["worker", "--request", "task.sdn"]).error).to_contain("requires")

    it "rejects duplicate missing unknown and cross-command options":
        expect(builder_cli_parse_v1(["check", "--manifest", "a", "--manifest", "b"]).error).to_contain("duplicate")
        expect(builder_cli_parse_v1(["run", "--manifest"]).error).to_contain("missing")
        expect(builder_cli_parse_v1(["check", "--manifest", "a", "--state", "b"]).error).to_contain("invalid")
        expect(builder_cli_parse_v1(["run", "--manifest", "--state", "b"]).error).to_contain("missing")
        expect(builder_cli_parse_v1(["other"]).error).to_contain("unknown")
        expect(builder_cli_parse_v1([]).error).to_contain("expected")

    it "validates command-specific required options":
        expect(builder_cli_parse_v1(["run", "--manifest", "tasks.sdn"]).error).to_contain("requires")
        expect(builder_cli_parse_v1(["check"]).error).to_contain("requires")
        expect(builder_cli_parse_v1(["check", "--manifest", "tasks.sdn"]).error).to_equal("")
        expect(builder_cli_parse_v1(["--help"]).error).to_equal("")
