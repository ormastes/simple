use std.spec.{describe, it, expect}
use test.fixtures.bootstrap_builder.builder_preconditions.{builder_qualifier_precondition}
use test.fixtures.bootstrap_builder.phase4_acceptance_helpers.{phase4_binding_precondition}

# Prevention for bug ft29_4_bootstrap_builder_managed_env_unset_2026-11-28:
# managed-scope specs must report a reason (BLOCKED), never assert, when the
# managed scope did not bind its tools.
describe "managed bootstrap-builder preconditions":
    it "reports the builder qualifier as a precondition when unbound":
        expect(builder_qualifier_precondition()).to_contain("SIMPLE_BUILDER_QUALIFIER")

    it "reports the Phase4 binding as a precondition when unbound":
        expect(phase4_binding_precondition()).to_contain("SIMPLE_MANAGED_PHASE4")
