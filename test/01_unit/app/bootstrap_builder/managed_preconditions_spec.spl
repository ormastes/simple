use std.spec.{describe, it, expect}
use test.fixtures.bootstrap_builder.builder_preconditions.{builder_qualifier_reason}
use test.fixtures.bootstrap_builder.phase4_acceptance_helpers.{phase4_binding_reason}

# Prevention for ft29_4_bootstrap_builder_managed_env_unset_2026-11-28: unbound
# managed scope is a precondition; a bound-but-broken one is not.
describe "managed bootstrap-builder preconditions":
    it "reports an unbound builder qualifier":
        expect(builder_qualifier_reason("")).to_contain("SIMPLE_BUILDER_QUALIFIER")

    it "does not excuse a bound builder qualifier":
        expect(builder_qualifier_reason("C:/x/qualifier.exe")).to_equal("")

    it "reports an unbound Phase4 binding":
        expect(phase4_binding_reason("", "")).to_contain("SIMPLE_MANAGED_PHASE4")
        expect(phase4_binding_reason("cli", "")).to_contain("SIMPLE_MANAGED_PHASE4")

    it "does not excuse a bound Phase4 binding":
        expect(phase4_binding_reason("cli", "interp")).to_equal("")
