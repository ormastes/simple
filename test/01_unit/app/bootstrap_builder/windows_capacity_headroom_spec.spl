use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.windows_process_owner.{windows_capacity_headroom_v1}

describe "Windows physical and committed memory headroom":
    it "uses commit headroom when physical memory alone would over-admit":
        expect(windows_capacity_headroom_v1(8589934592, 2147483648)).to_equal(2147483648)
    it "retains the physical memory bound with abundant commit headroom":
        expect(windows_capacity_headroom_v1(2147483648, 8589934592)).to_equal(2147483648)
    it "rejects invalid or exhausted headroom":
        expect(windows_capacity_headroom_v1(-1, 8589934592)).to_equal(0)
        expect(windows_capacity_headroom_v1(8589934592, -1)).to_equal(0)
        expect(windows_capacity_headroom_v1(8589934592, 0)).to_equal(0)
