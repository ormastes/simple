use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.native_group_phase2_source_snapshot.{
    phase2_source_authority_decode_v1
}

fn phase2_rows_v1() -> text:
    "file-hex:9:7372632f612e73706c:0:" + "a".repeat(64) + "\n" +
    "file-hex:9:7372632f622e73706c:1:" + "b".repeat(64) + "\n" +
    "link-hex:7372632f6c696e6b:612e73706c:7372632f612e73706c:" +
    "a".repeat(64) + "\n"

describe "Phase2 Stage2 source authority codec":
    it "binds phase drivers, sourced libraries and executable suite fixtures in source authority":
        for pair in [
            ("scripts/bootstrap/driver.shs", "736372697074732f626f6f7473747261702f6472697665722e736873"),
            ("scripts/check/lib/authority.shs", "736372697074732f636865636b2f6c69622f617574686f726974792e736873"),
            ("test/03_system/app/bootstrap_builder/feature/phase4_spec.spl", "746573742f30335f73797374656d2f6170702f626f6f7473747261705f6275696c6465722f666561747572652f7068617365345f737065632e73706c"),
            ("test/fixtures/bootstrap_builder/input.spl", "746573742f66697874757265732f626f6f7473747261705f6275696c6465722f696e7075742e73706c")]:
            val payload = "file-hex:{pair.0.len()}:{pair.1}:0:" + "a".repeat(64) + "\n"
            match phase2_source_authority_decode_v1(payload):
                Ok(rows): expect(rows[0].relative_path).to_equal(pair.0)
                Err(reason): fail(reason)

    it "accepts canonical five-field file rows and retained link identity":
        match phase2_source_authority_decode_v1(phase2_rows_v1()):
            Ok(rows):
                expect(rows.len()).to_equal(3)
                expect(rows[0].relative_path).to_equal("src/a.spl")
                expect(rows[1].executable).to_equal(true)
                expect(rows[2].kind).to_equal("link-hex")
                expect(rows[2].link_target).to_equal("a.spl")
                expect(rows[2].resolved_path).to_equal("src/a.spl")
            Err(reason): fail(reason)

    it "rejects a wrong byte length and missing-link authority":
        match phase2_source_authority_decode_v1(
                phase2_rows_v1().replace("file-hex:9:", "file-hex:8:")):
            Ok(_): fail("wrong byte length admitted")
            Err(reason): expect(reason).to_contain("file row")
        match phase2_source_authority_decode_v1(
                "link-missing-hex:7372632f6c696e6b:612e73706c:7372632f612e73706c\n"):
            Ok(_): fail("missing link admitted")
            Err(reason): expect(reason).to_contain("missing link")

    it "rejects reversed rows and case-folded path aliases":
        val rows = phase2_rows_v1().split("\n")
        match phase2_source_authority_decode_v1(
                rows[1] + "\n" + rows[0] + "\n" + rows[2] + "\n"):
            Ok(_): fail("reversed rows admitted")
            Err(reason): expect(reason).to_contain("order")
        val duplicate = "file-hex:9:7372632f412e73706c:0:" +
            "c".repeat(64) + "\n" + phase2_rows_v1()
        match phase2_source_authority_decode_v1(duplicate):
            Ok(_): fail("case-folded alias admitted")
            Err(reason): expect(reason).to_contain("duplicated")
