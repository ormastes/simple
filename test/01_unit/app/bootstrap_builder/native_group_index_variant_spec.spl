use std.spec.{describe, it, expect, fail}
use app.bootstrap_builder.native_group_index_contract.{NativeGroupIndexConfigV1}
use app.bootstrap_builder.native_group_index_variant.{native_group_index_variant_profile_v1,
    native_group_index_variant_admit_v1, native_group_target_build_mode_v1,
    native_group_target_build_mode_for_profile_v1}
use app.bootstrap_builder.native_group_phase2_index_config.{
    native_group_phase4_profile_from_env_v1}
use compiler.driver.cache.native_full_index_variant_v1.{
    native_full_index_target_build_mode_for_profile_v1}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}
use compiler.driver.cache.package_tldr_metadata.{ConfigVariantKeyV1,
    config_variant_digest_v1}

fn index_variant_config_v1(variant: ConfigVariantKeyV1, phase: text = "phase4") -> NativeGroupIndexConfigV1:
    NativeGroupIndexConfigV1(phase, variant.backend, variant.target_triple,
        "D:/phase2/simple.exe", "a".repeat(64), "D:/frozen",
        "D:/frozen/build/scv/snapshots/rev", "rev", "commit", "tree",
        "D:/frozen/build/scv/receipts/rev.receipt", "b".repeat(64),
        "c".repeat(64), "d".repeat(64), 1, 15754,
        "D:/frozen/source-inputs-before.txt", "e".repeat(64),
        "@WORK@/index-owned", "@WORK@/index-output",
        "NONE", variant, config_variant_digest_v1(variant))

describe "native full-index variant to compiler options":
    it "derives the exact release LLVM AOT key from actual options":
        match native_group_index_variant_profile_v1("phase4", "llvm",
                "x86_64-pc-windows-msvc", "release", "simple-v1"):
            Ok(profile):
                expect(profile.options.mode.to_text()).to_equal("aot")
                expect(profile.options.backend).to_equal("llvm")
                expect(profile.options.native_target).to_equal("x86_64-pc-windows-msvc")
                expect(profile.options.release).to_equal(true)
                expect(profile.options.debug_info).to_equal(true)
                expect(profile.options.opt_level ?? -1).to_equal(2)
                expect(profile.variant.normalized_options).to_equal([
                    "managed_build_phase=phase4", "target_trace_admission_identity=absent",
                    "debug_info=1", "low_memory=1", "mode=aot",
                    "opt_level=2", "output_format=native", "target_profile_schema=1",
                    "target_profile=release", "target_debug_request=default",
                    "target_trace_resolution=disabled", "target_trace_reason="])
                expect(profile.digest).to_equal(config_variant_digest_v1(profile.variant))
                match native_group_index_variant_admit_v1(
                        index_variant_config_v1(profile.variant)):
                    Ok(admitted): expect(admitted.digest).to_equal(profile.digest)
                    Err(reason): fail(reason)
            Err(reason): fail(reason)

    it "derives debug Cranelift options and refuses unprojected knobs":
        match native_group_index_variant_profile_v1("phase3", "cranelift",
                "aarch64-unknown-linux-gnu", "debug", "simple-v1"):
            Ok(profile):
                expect(profile.options.release).to_equal(false)
                expect(profile.options.opt_level ?? -1).to_equal(0)
                expect(profile.variant.normalized_options).to_equal([
                    "managed_build_phase=phase3", "target_trace_admission_identity=absent",
                    "debug_info=1", "low_memory=1", "mode=aot",
                    "opt_level=0", "output_format=native", "target_profile_schema=1",
                    "target_profile=development", "target_debug_request=default",
                    "target_trace_resolution=unavailable",
                    "target_trace_reason=trace-backend-not-admitted-v1"])
                var altered = profile.variant
                altered.features = ["avx2"]
                match native_group_index_variant_admit_v1(index_variant_config_v1(altered, "phase3")):
                    Ok(_): fail("unmapped CPU feature admitted")
                    Err(reason): expect(reason).to_contain("does not match")
                altered = profile.variant
                altered.environment_inputs = ["TZ=UTC"]
                match native_group_index_variant_admit_v1(index_variant_config_v1(altered, "phase3")):
                    Ok(_): fail("unmapped environment input admitted")
                    Err(reason): expect(reason).to_contain("does not match")
                altered = profile.variant
                altered.normalized_options = ["opt=2"]
                match native_group_index_variant_admit_v1(index_variant_config_v1(altered, "phase3")):
                    Ok(_): fail("unknown normalized option admitted")
                    Err(reason): expect(reason).to_contain("does not match")
            Err(reason): fail(reason)

    it "rejects unsupported target, backend, build mode, and ABI":
        match native_group_index_variant_profile_v1("phase4", "llvm",
                "wasm32-unknown-unknown", "release", "simple-v1"):
            Ok(_): fail("unsupported target admitted")
            Err(reason): expect(reason).to_contain("target")
        match native_group_index_variant_profile_v1("phase4", "wasm",
                "x86_64-pc-windows-msvc", "release", "simple-v1"):
            Ok(_): fail("unsupported backend admitted")
            Err(reason): expect(reason).to_contain("backend")
        match native_group_index_variant_profile_v1("phase4", "llvm",
                "x86_64-pc-windows-msvc", "fast", "simple-v1"):
            Ok(_): fail("unsupported build mode admitted")
            Err(reason): expect(reason).to_contain("build mode")
        match native_group_index_variant_profile_v1("phase4", "llvm",
                "x86_64-pc-windows-msvc", "release", "abi-v1"):
            Ok(_): fail("unsupported language ABI admitted")
            Err(reason): expect(reason).to_contain("language ABI")

    it "rejects stale phase3 release while admitting phase4 debug with distinct variant keys":
        match native_group_index_variant_profile_v1("phase3", "llvm",
                "aarch64-unknown-linux-gnu", "release", "simple-v1"):
            Ok(_): fail("old both-release phase3 profile admitted")
            Err(reason): expect(reason).to_contain("phase does not match")
        val p4_release = match native_group_index_variant_profile_v1("phase4", "llvm",
                "aarch64-unknown-linux-gnu", "release", "simple-v1"):
            Ok(profile): profile
            Err(reason):
                fail(reason)
                return
        val p4_debug = match native_group_index_variant_profile_v1("phase4", "llvm",
                "aarch64-unknown-linux-gnu", "debug", "simple-v1"):
            Ok(profile): profile
            Err(reason):
                fail(reason)
                return
        val p3_debug = match native_group_index_variant_profile_v1("phase3", "llvm",
                "aarch64-unknown-linux-gnu", "debug", "simple-v1"):
            Ok(profile): profile
            Err(reason):
                fail(reason)
                return
        expect(p4_debug.options.release).to_equal(false)
        expect(p4_debug.options.profile).to_equal("dev")
        expect(p4_debug.options.build_mode).to_equal("debug")
        expect(p4_debug.options.managed_build_phase).to_equal("phase4")
        expect(p4_debug.options.opt_level ?? -1).to_equal(0)
        expect(p4_debug.variant.build_mode).to_equal("debug")
        expect(p4_debug.variant.normalized_options).to_equal([
            "managed_build_phase=phase4", "target_trace_admission_identity=absent",
            "debug_info=1", "low_memory=1", "mode=aot",
            "opt_level=0", "output_format=native", "target_profile_schema=1",
            "target_profile=development", "target_debug_request=default",
            "target_trace_resolution=disabled", "target_trace_reason="])
        expect(p4_debug.digest == p4_release.digest).to_equal(false)
        expect(p4_debug.digest == p3_debug.digest).to_equal(false)
        expect(p4_debug.variant.build_mode == p4_release.variant.build_mode).to_equal(false)
        match native_group_index_variant_admit_v1(index_variant_config_v1(p4_debug.variant, "phase4")):
            Ok(admitted): expect(admitted.digest).to_equal(p4_debug.digest)
            Err(reason): fail(reason)
        match native_group_index_variant_admit_v1(index_variant_config_v1(p4_debug.variant, "phase3")):
            Ok(_): fail("phase4 debug variant admitted as phase3")
            Err(reason): expect(reason).to_contain("does not match")
        match native_group_index_variant_admit_v1(index_variant_config_v1(p3_debug.variant, "phase4")):
            Ok(_): fail("phase3 debug variant admitted as phase4")
            Err(reason): expect(reason).to_contain("does not match")

    it "rejects old phase4 receipts despite a valid old variant digest":
        val old = ConfigVariantKeyV1("aarch64-unknown-linux-gnu", "llvm", [],
            "release", "simple-v1", ["debug_info=0", "low_memory=1",
            "mode=aot", "opt_level=2", "output_format=native"], [])
        match native_group_index_variant_admit_v1(index_variant_config_v1(old)):
            Ok(_): fail("pre-profile-schema receipt admitted")
            Err(reason): expect(reason).to_contain("does not match")

    it "records requested development debug as unavailable while LLVM admission is closed":
        match native_group_index_variant_profile_v1("phase3", "llvm",
                "aarch64-unknown-linux-gnu", "debug", "simple-v1"):
            Ok(profile):
                expect(profile.options.managed_build_phase).to_equal("phase3")
                expect(profile.options.xray_enabled).to_equal(false)
                expect(profile.variant.normalized_options).to_contain("target_debug_request=default")
                expect(profile.variant.normalized_options).to_contain("target_trace_resolution=unavailable")
                expect(profile.variant.normalized_options).to_contain("target_trace_reason=llvm-observer-link-handler-not-admitted-v1")
                match native_group_index_variant_admit_v1(index_variant_config_v1(profile.variant, "phase3")):
                    Ok(admitted): expect(admitted.digest).to_equal(profile.digest)
                    Err(reason): fail(reason)
            Err(reason): fail(reason)

    it "rejects config backend and target that differ from its supplied variant":
        match native_group_index_variant_profile_v1("phase4", "llvm",
                "x86_64-pc-windows-msvc", "release", "simple-v1"):
            Ok(profile):
                var wrong_backend = index_variant_config_v1(profile.variant)
                wrong_backend.backend = "cranelift"
                expect(native_group_index_variant_admit_v1(wrong_backend).is_err()).to_equal(true)
                var wrong_target = index_variant_config_v1(profile.variant)
                wrong_target.target = "aarch64-unknown-linux-gnu"
                expect(native_group_index_variant_admit_v1(wrong_target).is_err()).to_equal(true)
            Err(reason): fail(reason)

    it "maps phase4 dev/prod profiles and PHASE4_PROFILE env into debug/release build modes":
        """Verify profile-aware index target build modes default phase4 to release, select debug for phase4 dev, and reject phase3 prod."""
        expect(native_full_index_target_build_mode_for_profile_v1("phase3", "").unwrap()).to_equal("debug")
        expect(native_full_index_target_build_mode_for_profile_v1("phase3", "dev").unwrap()).to_equal("debug")
        expect(native_full_index_target_build_mode_for_profile_v1("phase3", "prod").is_err()).to_equal(true)
        expect(native_full_index_target_build_mode_for_profile_v1("phase4", "").unwrap()).to_equal("release")
        expect(native_full_index_target_build_mode_for_profile_v1("phase4", "prod").unwrap()).to_equal("release")
        expect(native_full_index_target_build_mode_for_profile_v1("phase4", "dev").unwrap()).to_equal("debug")
        expect(native_full_index_target_build_mode_for_profile_v1("phase4", "bogus").is_err()).to_equal(true)

        expect(native_group_target_build_mode_v1("phase3").unwrap()).to_equal("debug")
        expect(native_group_target_build_mode_v1("phase4").unwrap()).to_equal("release")
        expect(native_group_target_build_mode_for_profile_v1("phase4", "dev").unwrap()).to_equal("debug")
        expect(native_group_target_build_mode_for_profile_v1("phase4", "prod").unwrap()).to_equal("release")
        expect(native_group_target_build_mode_for_profile_v1("phase3", "prod").is_err()).to_equal(true)

        val saved_p4 = env_get("PHASE4_PROFILE")
        env_set("PHASE4_PROFILE", "")
        expect(native_group_phase4_profile_from_env_v1("").unwrap()).to_equal("prod")
        env_set("PHASE4_PROFILE", "dev")
        expect(native_group_phase4_profile_from_env_v1("").unwrap()).to_equal("dev")
        expect(native_group_phase4_profile_from_env_v1("prod").unwrap()).to_equal("prod")
        env_set("PHASE4_PROFILE", "invalid")
        expect(native_group_phase4_profile_from_env_v1("").is_err()).to_equal(true)
        env_set("PHASE4_PROFILE", saved_p4)
