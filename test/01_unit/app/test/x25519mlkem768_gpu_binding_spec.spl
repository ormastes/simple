# @req: REQ-APP-TEST-001

# @tag: unit, crypto, x25519mlkem768, gpu, binding
# @req REQ-013 REQ-014 NFR-007 NFR-011

use std.spipe.*
use std.common.crypto.sha256.{sha256_text}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}
use app.test.x25519mlkem768_gpu_binding.{
    X25519_MLKEM768_GPU_BINDING_SCHEMA,
    X25519MlKem768GpuBinding,
    X25519MlKem768GpuCanonicalTuple,
    x25519_mlkem768_render_gpu_binding,
    x25519_mlkem768_parse_gpu_binding,
    x25519_mlkem768_gpu_canonical_tuple_reason}

fn _binding(backend: X25519MlKem768EvidenceBackend
        ) -> X25519MlKem768GpuBinding:
    val vulkan = backend == X25519MlKem768EvidenceBackend.Vulkan
    X25519MlKem768GpuBinding(
        backend: backend,
        compiler_artifact_sha256: "a" * 64,
        compiler_provenance_sha256: "b" * 64,
        runner_artifact_sha256: "c" * 64,
        accelerator_source_sha256: "d" * 64,
        accelerator_binary_sha256: "e" * 64,
        accelerator_source_aux_sha256: if vulkan: "1" * 64 else: "",
        accelerator_binary_aux_sha256: if vulkan: "2" * 64 else: "",
        build_toolchain: "pinned-toolchain",
        device_capability: if vulkan: "vulkan1.1" else: "8.6",
        device_name: "NVIDIA RTX A6000")

fn _render(binding: X25519MlKem768GpuBinding) -> text:
    match x25519_mlkem768_render_gpu_binding(binding):
        case Ok(value): value
        case Err(reason): fail(reason)

fn _expect_render_error(binding: X25519MlKem768GpuBinding, expected: text):
    match x25519_mlkem768_render_gpu_binding(binding):
        case Ok(_): fail("GPU binding unexpectedly rendered")
        case Err(reason): expect(reason).to_equal(expected)

fn _cuda_tuple() -> X25519MlKem768GpuCanonicalTuple:
    val binary = "build/evidence/x25519mlkem768/cuda/sm_86.cubin"
    val binary_sha =
        "562bfee3e9cd630425a69a5b27a0cc6661f0a00609a85078ef376565fb5b7711"
    val toolchain = "CUDA ptxas 13.0 V13.0.88"
    val device_name = "NVIDIA RTX A6000"
    val capability = "8.6"
    X25519MlKem768GpuCanonicalTuple(
        backend: X25519MlKem768EvidenceBackend.Cuda,
        fixture_manifest: "assembler: \"" + toolchain + "\"\n" +
            "retained_artifact: \"" + binary + "\"\n" +
            "retained_artifact_sha256: \"" + binary_sha + "\"\n" +
            "name: \"" + device_name + "\" capability: \"" + capability + "\"",
        accelerator_source:
            "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.ptx",
        accelerator_source_sha256:
            "e3201ae10f48e284d703cff81d42a02d9ba7f96e4bcc9b03872094b25a5a26aa",
        accelerator_binary: binary,
        accelerator_binary_sha256: binary_sha,
        accelerator_source_aux: "", accelerator_source_aux_sha256: "",
        accelerator_binary_aux: "", accelerator_binary_aux_sha256: "",
        build_toolchain: toolchain, device_capability: capability,
        device_name: device_name)

fn _vulkan_tuple() -> X25519MlKem768GpuCanonicalTuple:
    val source =
        "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_forward.comp"
    val source_sha =
        "f29443943a381012f34e26a7ab2ac44bee51338d78662109c47e0182aa1fc668"
    val source_aux =
        "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt_inverse.comp"
    val source_aux_sha =
        "b1e5a9ed87e4331abb5ac7ab906418aa9e4c927d2e284174990110318382e09c"
    val binary =
        "build/evidence/x25519mlkem768/vulkan/x25519mlkem768_ntt_forward.spv"
    val binary_sha =
        "0865f588f0825a3ff66a1d5e2cd2a9d0c356bb75b4fceaaf5c2196ffa05f6379"
    val binary_aux =
        "build/evidence/x25519mlkem768/vulkan/x25519mlkem768_ntt_inverse.spv"
    val binary_aux_sha =
        "07a11b541ef204a4fb6c907338dafc99bdf870d2046edcfad02a3d42dcca2687"
    val toolchain =
        "glslangValidator-sha256:96ea85d4228d7065507cd58454628e0d3c9ec8bbd29a0cd20ee0f3cefaf6d026" +
        "+spirv-val-sha256:20c5998a46f02310f56bf11be238c34d374bb50104b7ccf85bb909f9da883ff9"
    val manifest = "forward_source: \"" + source + "\"\n" +
        "forward_source_sha256: \"" + source_sha + "\"\n" +
        "inverse_source: \"" + source_aux + "\"\n" +
        "inverse_source_sha256: \"" + source_aux_sha + "\"\n" +
        "forward_transient_spirv_sha256: \"" + binary_sha + "\"\n" +
        "inverse_transient_spirv_sha256: \"" + binary_aux_sha + "\"\n" +
        "retained_artifact_targets: \"" + binary + ";" + binary_aux + ";\"\n" +
        "affected_devices: \"NVIDIA RTX A6000; NVIDIA TITAN RTX\""
    X25519MlKem768GpuCanonicalTuple(
        backend: X25519MlKem768EvidenceBackend.Vulkan,
        fixture_manifest: manifest,
        accelerator_source: source, accelerator_source_sha256: source_sha,
        accelerator_binary: binary, accelerator_binary_sha256: binary_sha,
        accelerator_source_aux: source_aux,
        accelerator_source_aux_sha256: source_aux_sha,
        accelerator_binary_aux: binary_aux,
        accelerator_binary_aux_sha256: binary_aux_sha,
        build_toolchain: toolchain, device_capability: "vulkan1.1",
        device_name: "NVIDIA RTX A6000")

describe "X25519MLKEM768 pure-Simple GPU binding codec":
    it "should render canonical ten-field CUDA bindings":
        # @req: REQ-013
        step("Verify: should render canonical ten-field CUDA bindings")
        step("Render a deterministic CUDA binding")
        val encoded = _render(_binding(X25519MlKem768EvidenceBackend.Cuda))
        expect(encoded.trim().split("\n").len()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(encoded).to_start_with(
            "schema=" + X25519_MLKEM768_GPU_BINDING_SCHEMA + "\nbackend=cuda\n")
        expect(encoded).to_end_with("device_name=NVIDIA RTX A6000\n")
        expect(encoded.contains("_aux_sha256=")).to_be(false)

    it "should render paired twelve-field Vulkan bindings":
        # @req: REQ-014
        step("Verify: should render paired twelve-field Vulkan bindings")
        step("Render distinct forward and inverse artifact identities")
        val encoded = _render(_binding(X25519MlKem768EvidenceBackend.Vulkan))
        expect(encoded.trim().split("\n").len()).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(encoded).to_contain("accelerator_source_aux_sha256=" + "1" * 64)
        expect(encoded).to_contain("accelerator_binary_aux_sha256=" + "2" * 64)

    it "should render codec-only ten-field Metal bindings":
        # @req: REQ-APP-TEST-001
        step("Verify: should render codec-only ten-field Metal bindings")
        step("Render Metal shape without claiming manifest admission")
        val encoded = _render(_binding(X25519MlKem768EvidenceBackend.Metal))
        expect(encoded.trim().split("\n").len()).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(encoded).to_contain("backend=metal\n")

    it "should reject malformed and uppercase SHA-256 values":
        # @req: REQ-013
        step("Verify: should reject malformed and uppercase SHA-256 values")
        step("Mutate required digest length and alphabet")
        var short = _binding(X25519MlKem768EvidenceBackend.Cuda)
        short.compiler_artifact_sha256 = "a" * 63
        _expect_render_error(short, "gpu-binding-required-sha256-invalid")
        var uppercase = _binding(X25519MlKem768EvidenceBackend.Cuda)
        uppercase.accelerator_binary_sha256 = "A" * 64
        _expect_render_error(uppercase, "gpu-binding-required-sha256-invalid")

    it "should enforce paired auxiliary artifacts by backend":
        # @req: REQ-014
        step("Verify: should enforce paired auxiliary artifacts by backend")
        step("Reject missing Vulkan and unexpected CUDA auxiliary hashes")
        var vulkan = _binding(X25519MlKem768EvidenceBackend.Vulkan)
        vulkan.accelerator_binary_aux_sha256 = ""
        _expect_render_error(vulkan, "gpu-binding-vulkan-aux-sha256-invalid")
        var cuda = _binding(X25519MlKem768EvidenceBackend.Cuda)
        cuda.accelerator_source_aux_sha256 = "1" * 64
        _expect_render_error(cuda, "gpu-binding-unexpected-aux-sha256")

    it "should reject metadata field injection":
        # @req: REQ-APP-TEST-001
        step("Verify: should reject metadata field injection")
        step("Reject newlines equals signs and surrounding whitespace")
        var newline = _binding(X25519MlKem768EvidenceBackend.Cuda)
        newline.device_name = "GPU\nbackend=metal"
        _expect_render_error(newline, "gpu-binding-metadata-invalid")
        var whitespace = _binding(X25519MlKem768EvidenceBackend.Cuda)
        whitespace.device_capability = " 8.6"
        _expect_render_error(whitespace, "gpu-binding-metadata-invalid")

    it "should render byte-identical output for identical typed inputs":
        # @req: REQ-013
        step("Verify: should render byte-identical output for identical typed inputs")
        step("Render and hash the same binding twice")
        val binding = _binding(X25519MlKem768EvidenceBackend.Cuda)
        val first = _render(binding)
        val second = _render(binding)
        expect(second).to_equal(first)
        expect(sha256_text(second)).to_equal(sha256_text(first))

    it "should parse rendered bindings and reject duplicate or unknown keys":
        # @req: REQ-014
        step("Verify: should parse rendered bindings and reject duplicate or unknown keys")
        step("Round-trip the typed CUDA binding")
        val encoded = _render(_binding(X25519MlKem768EvidenceBackend.Cuda))
        val parsed = match x25519_mlkem768_parse_gpu_binding(encoded):
            case Ok(value): value
            case Err(reason): fail(reason)
        expect(parsed.device_name).to_equal("NVIDIA RTX A6000")
        expect(_render(parsed)).to_equal(encoded)
        step("Reject duplicate and unknown fields without last-value wins")
        match x25519_mlkem768_parse_gpu_binding(encoded + "backend=cuda\n"):
            case Ok(_): fail("duplicate backend accepted")
            case Err(reason): expect(reason).to_equal("gpu-binding-duplicate-backend")
        match x25519_mlkem768_parse_gpu_binding(encoded + "unknown=value\n"):
            case Ok(_): fail("unknown binding field accepted")
            case Err(reason): expect(reason).to_equal(
                "gpu-binding-field-unknown-unknown")

    it "should admit only exact pinned CUDA and Vulkan tuples":
        # @req: REQ-APP-TEST-001
        step("Verify: should admit only exact pinned CUDA and Vulkan tuples")
        step("Validate canonical device and binary pairs")
        expect(x25519_mlkem768_gpu_canonical_tuple_reason(
            _cuda_tuple())).to_equal("")
        expect(x25519_mlkem768_gpu_canonical_tuple_reason(
            _vulkan_tuple())).to_equal("")
        var wrong_cuda = _cuda_tuple()
        wrong_cuda.device_capability = "7.5"
        expect(x25519_mlkem768_gpu_canonical_tuple_reason(
            wrong_cuda)).to_equal(
                "cuda-device-capability-binary-tuple-mismatch")

    it "should keep Metal producer admission blocked without a pinned metallib":
        # @req: REQ-013
        step("Verify: should keep Metal producer admission blocked without a pinned metallib")
        step("Validate the stable Metal provenance blocker")
        val tuple = X25519MlKem768GpuCanonicalTuple(
            backend: X25519MlKem768EvidenceBackend.Metal,
            fixture_manifest: "",
            accelerator_source:
                "src/os/crypto/x25519_mlkem768/kernels/ml_kem_ntt.metal",
            accelerator_source_sha256:
                "e49162b2ab056ef12ca2c4f15c942fa99b4f231b45cf251f4a78dadcd22172b5",
            accelerator_binary:
                "build/evidence/x25519mlkem768/metal/x25519mlkem768_ntt.metallib",
            accelerator_binary_sha256: "a" * 64,
            accelerator_source_aux: "", accelerator_source_aux_sha256: "",
            accelerator_binary_aux: "", accelerator_binary_aux_sha256: "",
            build_toolchain: "xcrun-metal", device_capability: "metal3",
            device_name: "Apple GPU")
        expect(x25519_mlkem768_gpu_canonical_tuple_reason(tuple)).to_equal(
            "metal-binary-digest-not-pinned-by-fixture-manifest")
