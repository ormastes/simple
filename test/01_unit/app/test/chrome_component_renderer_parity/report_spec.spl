"""
## Purpose and audience
Purpose: Prove that Chrome component renderer parity fail-closed aggregate.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-CHROME-COMPONENT-RENDERER-PARITY-001 — stable requirement identity for this spec.
# @cover src/app/test/chrome_component_renderer_parity/report.spl
use std.spec.*
use app.test.chrome_component_renderer_parity.*

fn row(status: text = "exact", required: bool = true, fresh: bool = true,
        blank: bool = false, reused: bool = false, degraded: bool = false,
        fallback: bool = false, skipped: i64 = 0, physical: bool = false,
        device: text = "", readback: text = "", policy: bool = false) -> ParityRowResult:
    ParityRowResult(fixture_id: "fixture", backend: if physical: "simple_gpu" else: "simple_cpu",
        required: required, status: status, explicit_policy: policy, fresh: fresh,
        blank: blank, reused_output: reused, degraded: degraded, fallback: fallback,
        skipped_commands: skipped, physical_device_required: physical,
        device_identity: device, readback_identity: readback,
        reproduction_command: "bin/simple run parity --fixture fixture")

describe "Chrome component renderer parity fail-closed aggregate":
    it "passes exact fresh independent rows and named accepted Chrome policy":
        step("Verify: passes exact fresh independent rows and named accepted Chrome policy")
        # @req: REQ-APP-CHROME-COMPONENT-RENDERER-PARITY-001
        val report = aggregate_parity_rows([
            row(),
            row(status: "accepted_with_explicit_policy", policy: true),
            row(physical: true, device: "gpu-1", readback: "readback-1")
        ])
        expect(report.status).to_equal("pass")
        expect(report.passed_rows).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(report.blockers.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects every forbidden evidence condition":
        step("Verify: rejects every forbidden evidence condition")
        val report = aggregate_parity_rows([
            row(fresh: false), row(blank: true), row(reused: true),
            row(degraded: true), row(fallback: true), row(skipped: 1),
            row(status: "accepted_with_explicit_policy", policy: false),
            row(status: "divergent"),
            row(physical: true, device: "0", readback: "readback-1"),
            row(physical: true, device: "gpu-1", readback: "")
        ])
        expect(report.status).to_equal("fail")
        expect(report.failed_rows).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(report.blockers.len()).to_equal(10)  # oracle: 10 — named expected value from the requirement

    it "does not count optional diagnostics as pass":
        step("Verify: does not count optional diagnostics as pass")
        val report = aggregate_parity_rows([row(status: "unavailable_backend", required: false)])
        expect(report.status).to_equal("pass")
        expect(report.passed_rows).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.diagnostic_rows).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "rejects an empty aggregate":
        step("Verify: rejects an empty aggregate")
        val report = aggregate_parity_rows([])
        expect(report.status).to_equal("fail")
        expect(report.blockers.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
