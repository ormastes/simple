# @cover src/app/test/chrome_component_renderer_parity/cache.spl
use std.spec.*
use app.test.chrome_component_renderer_parity.*
use app.io.mod.{dir_create_all, file_atomic_write, file_size, file_hash_sha256}

fn identity(revision: text = "simple-rev-a") -> ParityCacheIdentity:
    ParityCacheIdentity(schema_version: "stage/v1", fixture_id: "fixture",
        fixture_hash: "fixture-sha", resource_hash: "resource-sha",
        chrome_identity: "chrome-123", chrome_configuration: "headless-srgb",
        converter_version: "converter/v1", simple_revision: revision,
        backend_identity: "cpu-avx2", comparison_policy_version: "policy/v1")

fn cache_receipt(expected: ParityCacheIdentity) -> ParityCacheReceipt:
    val root = "build/test-artifacts/chrome_component_renderer_parity_cache_unit"
    dir_create_all(root)
    val path = root + "/pixels.rgba8"
    file_atomic_write(path, "verified-artifact")
    val artifact = ParityCacheArtifact(path: path, size_bytes: file_size(path), sha256: file_hash_sha256(path))
    ParityCacheReceipt(cache_key: parity_cache_key(expected), artifact_count: 1,
        verified_artifact_count: 1, publication_complete: true,
        manifest_published_last: true, artifacts: [artifact])

describe "Chrome component renderer parity cache freshness":
    it "requires the complete identity and publication-last receipt":
        val expected = identity()
        val receipt = cache_receipt(expected)
        expect(parity_cache_receipt_fresh(expected, receipt)).to_equal(true)
        expect(parity_cache_receipt_fresh(identity("simple-rev-b"), receipt)).to_equal(false)
        expect(parity_cache_receipt_fresh(expected, ParityCacheReceipt(
            cache_key: receipt.cache_key, artifact_count: 1, verified_artifact_count: 0,
            publication_complete: true, manifest_published_last: true, artifacts: receipt.artifacts))).to_equal(false)
        expect(parity_cache_receipt_fresh(expected, ParityCacheReceipt(
            cache_key: receipt.cache_key, artifact_count: 1, verified_artifact_count: 1,
            publication_complete: false, manifest_published_last: true, artifacts: receipt.artifacts))).to_equal(false)
        expect(parity_cache_receipt_fresh(expected, ParityCacheReceipt(
            cache_key: receipt.cache_key, artifact_count: 1, verified_artifact_count: 1,
            publication_complete: true, manifest_published_last: false, artifacts: receipt.artifacts))).to_equal(false)

    it "rejects a tampered artifact after publication":
        val expected = identity()
        val receipt = cache_receipt(expected)
        file_atomic_write(receipt.artifacts[0].path, "tampered-artifact")
        expect(parity_cache_receipt_fresh(expected, receipt)).to_equal(false)

    it "rejects an incomplete cache identity even when its receipt matches":
        val incomplete = ParityCacheIdentity(schema_version: "", fixture_id: "fixture",
            fixture_hash: "fixture-sha", resource_hash: "resource-sha",
            chrome_identity: "chrome-123", chrome_configuration: "headless-srgb",
            converter_version: "converter/v1", simple_revision: "simple-rev-a",
            backend_identity: "cpu-avx2", comparison_policy_version: "policy/v1")
        val receipt = ParityCacheReceipt(cache_key: parity_cache_key(incomplete), artifact_count: 1,
            verified_artifact_count: 1, publication_complete: true,
            manifest_published_last: true, artifacts: [])
        expect(parity_cache_identity_valid(incomplete)).to_equal(false)
        expect(parity_cache_receipt_fresh(incomplete, receipt)).to_equal(false)
