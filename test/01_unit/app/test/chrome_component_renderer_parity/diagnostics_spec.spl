"""
## Purpose and audience
Purpose: Prove that Chrome renderer retained mismatch diagnostics.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-CHROME-COMPONENT-RENDERER-PARITY-001 — stable requirement identity for this spec.
# @cover src/app/test/chrome_component_renderer_parity/diagnostics.spl
use std.spec.*
use app.io.mod.{file_write, file_write_bytes}
use common.ui.rendering_parity.{CanonicalRenderOutput, backend_evidence_v1,
    canonical_render_output_v1, compare_rgba8_with_policy, rendering_stage_record_v1}
use common.ui.rendering_parity.checksum.{stable_bytes_checksum}
use app.test.chrome_component_renderer_parity.diagnostics.{ParityDiagnosticPlan,
    write_parity_mismatch_artifacts, validate_parity_mismatch_artifacts}

fn output(fixture_id: text, backend: text, rgba: [u8]) -> CanonicalRenderOutput:
    val checksum = stable_bytes_checksum(rgba)
    val stage = rendering_stage_record_v1(fixture_id, backend, "raster", 0,
        "root", "pixels", checksum, checksum, "rgba8-canonical", 1, false, false).unwrap()
    val evidence = backend_evidence_v1(fixture_id, backend, backend,
        "diagnostics-spec-" + backend, "test-revision", backend + "-implementation",
        "not-applicable", "host-memory", 2, 1, "rgba8", 1, 0, false, false,
        false, false, "", 1, 1024, "pass", "").unwrap()
    canonical_render_output_v1(fixture_id, backend, 2, 1, rgba, checksum,
        [stage], evidence, "source-artifact-" + backend).unwrap()

fn plan(fixture_id: text = "diagnostic-fixture") -> ParityDiagnosticPlan:
    ParityDiagnosticPlan(artifact_root: "build/test-artifacts/chrome-parity-diagnostics",
        fixture_id: fixture_id, expected_row: "chrome", actual_row: "simple_cpu",
        converter_id: "straight-rgba8", converter_version: 1)

describe "Chrome renderer retained mismatch diagnostics":
    it "writes and validates compact metadata and absolute RGBA differences":
        step("Verify: writes and validates compact metadata and absolute RGBA differences")
        # @req: REQ-APP-CHROME-COMPONENT-RENDERER-PARITY-001
        val expected = output("diagnostic-fixture", "chrome",
            [10u8, 20u8, 30u8, 255u8, 80u8, 90u8, 100u8, 255u8])
        val actual = output("diagnostic-fixture", "simple_cpu",
            [13u8, 18u8, 30u8, 250u8, 80u8, 95u8, 99u8, 255u8])
        val comparison = compare_rgba8_with_policy(expected.rgba8, actual.rgba8,
            2, 1, "chrome", "simple_cpu", "raster", "exact", "fixture-exact", 1, 0, 0).unwrap()
        val artifacts = write_parity_mismatch_artifacts(plan(), comparison, expected, actual).unwrap()
        expect(artifacts.mismatch_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(artifacts.min_x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(artifacts.max_x).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(artifacts.max_channel_delta).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(artifacts.converter_metadata).to_equal("straight-rgba8@1")
        expect(artifacts.reproduction_command).to_equal(
            "bin/simple run src/app/test/chrome_component_renderer_parity/main.spl --run" +
            " --fixture diagnostic-fixture --expected-row chrome --actual-row simple_cpu")
        expect(validate_parity_mismatch_artifacts(plan(), comparison, expected, actual, artifacts).unwrap()).to_equal(true)

    it "fails closed when retained bytes are tampered":
        step("Verify: fails closed when retained bytes are tampered")
        val fixture_id = "tampered-fixture"
        val expected = output(fixture_id, "chrome",
            [1u8, 2u8, 3u8, 255u8, 4u8, 5u8, 6u8, 255u8])
        val actual = output(fixture_id, "simple_cpu",
            [1u8, 2u8, 7u8, 255u8, 4u8, 5u8, 6u8, 254u8])
        val comparison = compare_rgba8_with_policy(expected.rgba8, actual.rgba8,
            2, 1, "chrome", "simple_cpu", "raster", "exact", "fixture-exact", 1, 0, 0).unwrap()
        val artifacts = write_parity_mismatch_artifacts(plan(fixture_id), comparison, expected, actual).unwrap()
        expect(file_write_bytes(artifacts.diff_path, [0u8, 0u8, 0u8, 0u8,
            0u8, 0u8, 0u8, 0u8])).to_equal(true)
        expect(validate_parity_mismatch_artifacts(plan(fixture_id), comparison,
            expected, actual, artifacts).is_err()).to_equal(true)

    it "rejects path traversal and equal comparisons without publishing":
        step("Verify: rejects path traversal and equal comparisons without publishing")
        val expected = output("safe-fixture", "chrome",
            [1u8, 2u8, 3u8, 255u8, 4u8, 5u8, 6u8, 255u8])
        val actual = output("safe-fixture", "simple_cpu", expected.rgba8)
        val comparison = compare_rgba8_with_policy(expected.rgba8, actual.rgba8,
            2, 1, "chrome", "simple_cpu", "raster", "exact", "fixture-exact", 1, 0, 0).unwrap()
        expect(write_parity_mismatch_artifacts(plan("../escape"), comparison,
            expected, actual).is_err()).to_equal(true)
        expect(write_parity_mismatch_artifacts(plan("safe-fixture"), comparison,
            expected, actual).is_err()).to_equal(true)

    it "fails closed when the SDN receipt is changed":
        step("Verify: fails closed when the SDN receipt is changed")
        val fixture_id = "receipt-tamper-fixture"
        val expected = output(fixture_id, "chrome",
            [8u8, 9u8, 10u8, 255u8, 11u8, 12u8, 13u8, 255u8])
        val actual = output(fixture_id, "simple_cpu",
            [8u8, 9u8, 20u8, 255u8, 11u8, 12u8, 13u8, 255u8])
        val comparison = compare_rgba8_with_policy(expected.rgba8, actual.rgba8,
            2, 1, "chrome", "simple_cpu", "raster", "exact", "fixture-exact", 1, 0, 0).unwrap()
        val artifacts = write_parity_mismatch_artifacts(plan(fixture_id), comparison, expected, actual).unwrap()
        expect(file_write(artifacts.summary_path, "(tampered true)\n")).to_equal(true)
        expect(validate_parity_mismatch_artifacts(plan(fixture_id), comparison,
            expected, actual, artifacts).is_err()).to_equal(true)
