use std.spec.*
use app.test.x25519mlkem768_coverage_receipt.{
    X25519MlKem768CoverageReceiptCli,
    X25519MlKem768CoverageRunManifest,
    x25519_mlkem768_compose_coverage_receipt_from_text,
    x25519_mlkem768_parse_coverage_receipt_cli,
    x25519_mlkem768_parse_coverage_run_manifest,
    x25519_mlkem768_render_coverage_receipt}
use app.test.x25519mlkem768_coverage_contract.{
    X25519_MLKEM768_COVERAGE_OWNER_COUNT,
    X25519_MLKEM768_COVERAGE_SPEC_COUNT,
    X25519_MLKEM768_CRITICAL_OUTCOME_COUNT,
    x25519_mlkem768_coverage_owner_ids,
    x25519_mlkem768_coverage_owner_paths,
    x25519_mlkem768_coverage_spec_paths}

val HASH_A = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn owner_ids() -> [text]:
    x25519_mlkem768_coverage_owner_ids()

fn owner_paths() -> [text]:
    x25519_mlkem768_coverage_owner_paths()

fn spec_paths() -> [text]:
    x25519_mlkem768_coverage_spec_paths()

fn critical_condition_count(owner_index: i64) -> i64:
    [1, 2, 2, 2, 3, 2, 4, 1, 28, 12, 2, 5, 1, 3, 1, 1, 1, 5,
     5, 1, 1, 2, 4, 4, 2, 5, 2, 68, 2, 1][owner_index]

fn valid_cli() -> X25519MlKem768CoverageReceiptCli:
    X25519MlKem768CoverageReceiptCli(
        raw_coverage: "build/evidence/run/coverage.sdn",
        run_manifest: "build/evidence/run/run_manifest.env",
        critical_inventory: "build/evidence/run/critical.psv",
        compiler_artifact: "build/evidence/run/simple",
        runtime_artifact: "build/evidence/run/libsimple_runtime.a",
        output_dir: "build/evidence/run/receipt")

fn valid_manifest() -> X25519MlKem768CoverageRunManifest:
    var sources: Dict<text, text> = {}
    for path in owner_paths(): sources[path] = HASH_A
    var specs: Dict<text, text> = {}
    var aot_paths: Dict<text, text> = {}
    var aot_hashes: Dict<text, text> = {}
    for path in spec_paths():
        specs[path] = HASH_A
        aot_paths[path] = "build/evidence/run/aot/" + path.replace("/", "_")
        aot_hashes[path] = HASH_A
    X25519MlKem768CoverageRunManifest(
        raw_coverage_path: "build/evidence/run/coverage.sdn",
        raw_coverage_sha256: HASH_A,
        compiler_artifact_path: "build/evidence/run/simple",
        compiler_artifact_sha256: HASH_A,
        compiler_provenance_path: "build/evidence/run/simple.provenance.env",
        compiler_provenance_sha256: HASH_A,
        compiler_source_revision: HASH_A,
        compiler_version_path: "VERSION",
        compiler_version_sha256: HASH_A,
        compiler_version: "1.0.0-RC",
        runtime_version: "simple-core-c-runtime-source-snapshot-v1",
        execution_environment: "linux-x86_64-llvm-native",
        runtime_artifact_path: "build/evidence/run/libsimple_runtime.a",
        runtime_artifact_sha256: HASH_A,
        measurement_tool_version: "0.8.1",
        source_sha256: sources, spec_sha256: specs,
        spec_aot_path: aot_paths, spec_aot_sha256: aot_hashes)

fn measured_raw(skip_owner: i64 = -1, false_for_hybrid: i64 = 1) -> text:
    var decisions = "# Coverage Report\nversion: 1.0\n" +
        "coverage_extension: decision-condition-v1\n\n" +
        "decisions |id, file, line, column, true_count, false_count|\n"
    var conditions = "\nconditions |decision_id, condition_id, file, line, column, true_count, false_count|\n"
    val paths = owner_paths()
    var index: i64 = 0
    while index < paths.len():
        if index != skip_owner:
            val id = index + 1
            val line = index + 10
            decisions = decisions + "    {id}, {paths[index]}, {line}, 1, 1, 1\n"
            var condition_id: i64 = 0
            while condition_id < critical_condition_count(index):
                val false_count = if index == 8 and condition_id == 0:
                    false_for_hybrid
                else:
                    1
                conditions = conditions +
                    "    {id}, {condition_id}, {paths[index]}, {line}, 1, 1, {false_count}\n"
                condition_id = condition_id + 1
        index = index + 1
    decisions + conditions + "\nsummary:\n    total_decisions: 30\n"

fn critical_inventory() -> text:
    var value = "owner|source_path|line|decision_id|condition_id|outcome\n"
    val ids = owner_ids()
    val paths = owner_paths()
    var index: i64 = 0
    while index < ids.len():
        val line = index + 10
        val decision = index + 1
        var condition_id: i64 = 0
        while condition_id < critical_condition_count(index):
            value = value +
                "{ids[index]}|{paths[index]}|{line}|{decision}|{condition_id}|true\n"
            value = value +
                "{ids[index]}|{paths[index]}|{line}|{decision}|{condition_id}|false\n"
            condition_id = condition_id + 1
        index = index + 1
    value

fn valid_run_manifest_text() -> text:
    var text_value = "schema=simple-native-coverage-run-v2\n" +
        "status=measured\ninstrumentation_active=true\nfallback_used=false\n" +
        "static_analysis=false\ncoverage_mode=llvm-native\n" +
        "runtime_bundle=core-c-bootstrap\n" +
        "raw_coverage_path=build/evidence/run/coverage.sdn\n" +
        "raw_coverage_sha256={HASH_A}\n" +
        "compiler_artifact_path=build/evidence/run/simple\n" +
        "compiler_artifact_sha256={HASH_A}\n" +
        "compiler_provenance_path=build/evidence/run/simple.provenance.env\n" +
        "compiler_provenance_sha256={HASH_A}\n" +
        "compiler_provenance_schema=simple-bootstrap-stage4-provenance-v2\n" +
        "compiler_artifact_kind=pure-simple-full-cli\n" +
        "compiler_source_revision_kind=content-sha256\n" +
        "compiler_source_revision={HASH_A}\n" +
        "compiler_source_roots=src/compiler:src/lib:src/app:src/runtime:examples/10_tooling\n" +
        "compiler_completed_gate=stage4-essential-tools-smoke\n" +
        "compiler_version_path=VERSION\ncompiler_version_sha256={HASH_A}\n" +
        "compiler_version=1.0.0-RC\n" +
        "runtime_version=simple-core-c-runtime-source-snapshot-v1\n" +
        "execution_environment=linux-x86_64-llvm-native\n" +
        "runtime_artifact_path=build/evidence/run/libsimple_runtime.a\n" +
        "runtime_artifact_sha256={HASH_A}\nmeasurement_tool_version=0.8.1\n" +
        "source_count={X25519_MLKEM768_COVERAGE_OWNER_COUNT}\n" +
        "spec_count={X25519_MLKEM768_COVERAGE_SPEC_COUNT}\n"
    val owners = owner_paths()
    var owner_index: i64 = 0
    while owner_index < owners.len():
        text_value = text_value + "source_{owner_index + 1}_path={owners[owner_index]}\n"
        text_value = text_value + "source_{owner_index + 1}_sha256={HASH_A}\n"
        owner_index = owner_index + 1
    val specs = spec_paths()
    var index: i64 = 0
    while index < specs.len():
        text_value = text_value + "spec_{index + 1}_path={specs[index]}\n"
        text_value = text_value + "spec_{index + 1}_sha256={HASH_A}\n"
        text_value = text_value + "spec_{index + 1}_aot_path=build/evidence/run/aot/spec_{index + 1}\n"
        text_value = text_value + "spec_{index + 1}_aot_sha256={HASH_A}\n"
        text_value = text_value + "spec_{index + 1}_outcome=passed\n"
        index = index + 1
    text_value

describe "X25519MLKEM768 coverage receipt composer":
    it "parses only the exact typed CLI surface":
        val args = ["--raw-coverage", "build/evidence/run/coverage.sdn",
            "--run-manifest", "build/evidence/run/run_manifest.env",
            "--critical-inventory", "build/evidence/run/critical.psv",
            "--compiler-artifact", "build/evidence/run/simple",
            "--runtime-artifact", "build/evidence/run/runtime.a",
            "--output-dir", "build/evidence/run/receipt"]
        expect(x25519_mlkem768_parse_coverage_receipt_cli(args).is_ok()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_receipt_cli(
            args + ["--raw-coverage", "again"]).is_err()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_receipt_cli(
            args + ["--allow-unbound", "true"]).is_err()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_receipt_cli(
            args + ["--compiler-version", "forged"]).is_err()).to_be(true)

    it "accepts a complete provenance-bound run manifest and rejects absence":
        val parsed = x25519_mlkem768_parse_coverage_run_manifest(
            valid_run_manifest_text())
        expect(parsed.is_ok()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_run_manifest(
            "schema=simple-native-coverage-run-v2\nstatus=measured\n").is_err()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_run_manifest(
            valid_run_manifest_text().replace("spec_4_outcome=passed", "spec_4_outcome=failed")
        ).is_err()).to_be(true)

    it "composes exact thirty-owner measured outcomes":
        val result = x25519_mlkem768_compose_coverage_receipt_from_text(
            valid_cli(), valid_manifest(), HASH_A, measured_raw(),
            critical_inventory(), HASH_A)
        expect(result.is_ok()).to_be(true)
        val receipt = result.unwrap()
        expect(receipt.owners.len()).to_equal(X25519_MLKEM768_COVERAGE_OWNER_COUNT)
        expect(receipt.branch_outcome_total).to_equal(X25519_MLKEM768_CRITICAL_OUTCOME_COUNT)
        expect(receipt.branch_outcome_covered).to_equal(X25519_MLKEM768_CRITICAL_OUTCOME_COUNT)
        expect(receipt.branch_coverage_basis_points).to_equal(10000)
        expect(receipt.critical_outcome_total).to_equal(X25519_MLKEM768_CRITICAL_OUTCOME_COUNT)
        expect(receipt.composer_source_sha256.len()).to_equal(64)
        expect(receipt.contract_source_sha256.len()).to_equal(64)
        val rendered = x25519_mlkem768_render_coverage_receipt(
            receipt, "build/evidence/run/zero.psv", HASH_A,
            "build/evidence/run/source.env", HASH_A,
            "build/evidence/run/spec.env", HASH_A, HASH_A)
        for id in owner_ids():
            expect(rendered).to_contain(id + "_source_sha256=" + HASH_A)
        expect(rendered).to_contain(
            "critical_branch_inventory_sha256=" + HASH_A)
        expect(rendered).to_contain(
            "compiler_provenance_sha256=" + HASH_A)
        expect(rendered).to_contain(
            "coverage_composer_path=src/app/test/x25519mlkem768_coverage_receipt.spl")
        expect(rendered).to_contain(
            "coverage_composer_source_sha256=" +
                receipt.composer_source_sha256)
        expect(rendered).to_contain(
            "coverage_contract_path=src/app/test/x25519mlkem768_coverage_contract.spl")
        expect(rendered).to_contain(
            "coverage_contract_source_sha256=" +
                receipt.contract_source_sha256)

    it "rejects a missing owner and an uncovered critical outcome":
        val missing = x25519_mlkem768_compose_coverage_receipt_from_text(
            valid_cli(), valid_manifest(), HASH_A, measured_raw(13),
            critical_inventory(), HASH_A)
        expect(missing.is_err()).to_be(true)
        expect(missing.unwrap_err().code).to_equal("coverage-owner-denominator-empty")
        val red = x25519_mlkem768_compose_coverage_receipt_from_text(
            valid_cli(), valid_manifest(), HASH_A, measured_raw(-1, 0),
            critical_inventory(), HASH_A)
        expect(red.is_err()).to_be(true)
        expect(red.unwrap_err().code).to_equal("critical-branch-below-100-percent")
