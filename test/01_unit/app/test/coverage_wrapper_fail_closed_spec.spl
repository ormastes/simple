# Regression: a `--coverage` run whose instrumentation wrapper fails to compile
# must NEVER be reported as a pass. Before this fix the runner degraded to a
# plain interpreter run of the unwrapped spec and returned its pass counts as a
# normal green verdict, so every green `--coverage` result was potentially
# unevidenced -- the "healthy-looking log over work that never happened" class.
#
# The degrade stays available, but only on an explicit
# SIMPLE_COVERAGE_FALLBACK=interpreter opt-in.
use std.test_runner.test_runner_execute.{
    coverage_interpreter_fallback_opted_in, coverage_wrapper_abort_error,
    coverage_wrapper_compile_failure_v1, compile_output_diagnostic_line_v1,
    cleanup_native_generated_files, coverage_wrapper_retention_note_v1
}
use std.test_runner.test_executor_parsing.{_tp_get_temp_dir}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete, file_exists}

describe "coverage wrapper compile failure fails closed":

    it "fails closed when SIMPLE_COVERAGE_FALLBACK is unset":
        expect(coverage_interpreter_fallback_opted_in("")).to_equal(false)

    it "fails closed for every value other than the exact opt-in":
        expect(coverage_interpreter_fallback_opted_in("1")).to_equal(false)
        expect(coverage_interpreter_fallback_opted_in("true")).to_equal(false)
        expect(coverage_interpreter_fallback_opted_in("yes")).to_equal(false)
        expect(coverage_interpreter_fallback_opted_in("Interpreter")).to_equal(false)

    it "allows the degrade only on the exact explicit opt-in":
        expect(coverage_interpreter_fallback_opted_in("interpreter")).to_equal(true)

    it "states that nothing was executed, not that the spec passed":
        val message = coverage_wrapper_abort_error("parse: Unexpected token")
        expect(message.contains("ABORTED BEFORE EXECUTION")).to_equal(true)
        expect(message.contains("NEVER run")).to_equal(true)
        expect(message.contains("NOT a test result")).to_equal(true)

    it "names the compiler diagnostic that caused the abort":
        val message = coverage_wrapper_abort_error("parse: Unexpected token")
        expect(message.contains("parse: Unexpected token")).to_equal(true)

    it "tells the operator how to opt in to the uninstrumented degrade":
        val message = coverage_wrapper_abort_error("boom")
        expect(message.contains("SIMPLE_COVERAGE_FALLBACK=interpreter")).to_equal(true)

    it "reports a compiler timeout distinctly and retains resource evidence":
        val failure = coverage_wrapper_compile_failure_v1(
            "98 | ) -> Result[(), PackageImageErrorV1]:", "timeout", 300035,
            "large", "within")
        val message = failure.error
        expect(failure.timed_out).to_equal(true)
        expect(failure.compile_ms).to_equal(300035)
        expect(failure.resource_class).to_equal("large")
        expect(failure.budget_status).to_equal("within")
        expect(message.contains("compilation timed out after 300035ms")).to_equal(true)
        expect(message.contains("ABORTED BEFORE EXECUTION")).to_equal(true)
        expect(message.contains("NEVER run")).to_equal(true)
        expect(message.contains("NOT a test result")).to_equal(true)
        expect(message.contains("limit=timeout")).to_equal(true)
        expect(message.contains("resource_class=large")).to_equal(true)
        expect(message.contains("budget_status=within")).to_equal(true)
        expect(message.contains("Compiler output observed before timeout:")).to_equal(true)
        expect(message.contains("SIMPLE_COVERAGE_FALLBACK=interpreter")).to_equal(true)

    it "preserves a real compiler diagnostic separately from resource evidence":
        val failure = coverage_wrapper_compile_failure_v1(
            "error: unexpected token", "", 17, "large", "failure")
        val message = failure.error
        expect(failure.timed_out).to_equal(false)
        expect(failure.compile_ms).to_equal(17)
        expect(failure.resource_class).to_equal("large")
        expect(failure.budget_status).to_equal("failure")
        expect(message.contains("failed to compile")).to_equal(true)
        expect(message.contains("Compiler diagnostic: error: unexpected token")).to_equal(true)
        expect(message.contains("compile_ms=17")).to_equal(true)
        expect(message.contains("resource_class=large")).to_equal(true)
        expect(message.contains("budget_status=failure")).to_equal(true)
        expect(message.contains("timed out")).to_equal(false)
        expect(message.contains("NOT a test result")).to_equal(true)

    it "does not misclassify a memory kill as a timeout":
        val failure = coverage_wrapper_compile_failure_v1(
            "process exceeded memory budget", "memory", 47000, "large", "failure")
        expect(failure.timed_out).to_equal(false)
        expect(failure.error.contains("failed to compile")).to_equal(true)
        expect(failure.error.contains("limit=memory")).to_equal(true)
        expect(failure.error.contains("compile_ms=47000")).to_equal(true)

describe "failed coverage wrapper is retained and named (2026-11-11)":
    # Bug coverage_wrapper_not_retained_keep_artifacts_2026-08-31: a generated
    # wrapper that failed to compile was deleted (flag-gated only), and the
    # abort text named no artifact, so the only evidence of the failure was
    # unrecoverable. The wrapper now survives cleanup regardless of
    # --keep-artifacts and its path is printed in the abort/degrade message.

    it "names the retained wrapper path in the abort message":
        val failure = coverage_wrapper_compile_failure_v1(
            "error: undefined identifier: io_runtime", "", 17, "unit", "failure",
            "/tmp/simple_cov_probe_spec.spl")
        expect(failure.error.contains("Wrapper source retained at: /tmp/simple_cov_probe_spec.spl")).to_equal(true)

    it "names the retained wrapper path for a compile timeout too":
        val failure = coverage_wrapper_compile_failure_v1(
            "compiler output", "timeout", 300000, "unit", "within",
            "/tmp/simple_cov_probe_spec.spl")
        expect(failure.error.contains("Wrapper source retained at: /tmp/simple_cov_probe_spec.spl")).to_equal(true)

    it "keeps the message shape unchanged when no wrapper path is in scope":
        val failure = coverage_wrapper_compile_failure_v1(
            "error: unexpected token", "", 17, "unit", "failure")
        expect(failure.error.contains("Wrapper source retained at:")).to_equal(false)
        expect(coverage_wrapper_retention_note_v1("")).to_equal("")

    it "retains the failed wrapper through cleanup without --keep-artifacts":
        val dir = _tp_get_temp_dir()
        # Production invariant (build_coverage_wrapper_checked): wrapped_path
        # == cleanup_path, so the wrapper is deleted via the cleanup_path arm.
        val wrapped = dir + "/cov_wrapper_retain_probe_wrapped.spl"
        val source = dir + "/cov_wrapper_retain_probe_source.spl"
        expect(file_write(wrapped, "probe wrapper")).to_equal(true)
        expect(file_write(source, "probe staged source")).to_equal(true)
        val _ok = cleanup_native_generated_files(dir + "/cov_wrapper_retain_probe.smf",
            source, wrapped, wrapped, dir + "/cov_wrapper_retain_probe_original.spl",
            false, "", "", wrapped)
        expect(file_exists(wrapped)).to_equal(true)
        expect(file_exists(source)).to_equal(false)
        expect(file_delete(wrapped)).to_equal(true)

    it "still deletes every generated file when no retention path is given":
        val dir = _tp_get_temp_dir()
        val wrapped = dir + "/cov_wrapper_no_retain_probe_wrapped.spl"
        val source = dir + "/cov_wrapper_no_retain_probe_source.spl"
        expect(file_write(wrapped, "probe wrapper")).to_equal(true)
        expect(file_write(source, "probe staged source")).to_equal(true)
        val _ok = cleanup_native_generated_files(dir + "/cov_wrapper_no_retain_probe.smf",
            source, wrapped, wrapped, dir + "/cov_wrapper_no_retain_probe_original.spl",
            false)
        expect(file_exists(wrapped)).to_equal(false)
        expect(file_exists(source)).to_equal(false)

describe "compile diagnostic selection ignores source-listing lines":
    it "does not pick a warning snippet line that merely contains an Error identifier":
        val output = "warning: unused thing\n  --> src/compiler/80.driver/smf/package_image_v1.spl:98:1\n   |\n98 | ) -> Result[(), PackageImageErrorV1]:\n   | ^\n"
        expect(compile_output_diagnostic_line_v1(output).contains("PackageImageErrorV1")).to_equal(false)

    it "still prefers a real error line over a snippet line":
        val output = "98 | ) -> Result[(), PackageImageErrorV1]:\nerror: unexpected token\n"
        expect(compile_output_diagnostic_line_v1(output)).to_equal("error: unexpected token")
