# Fail-closed digest comparison for the x25519-mlkem768 coverage run-manifest check.
# @req REQ-SSPEC-UNIT
use std.spec.step
use std.spec.{describe, it, expect}
use app.test.x25519mlkem768_coverage_receipt.{coverage_digest_matches}
use std.nogc_sync_mut.io.file_ops.{file_hash_sha256}

describe "coverage digest comparison fails closed":
    it "rejects an unreadable file against a missing (empty) manifest entry":
        step("unreadable file vs empty expected")
        expect(coverage_digest_matches("", "")).to_equal(false)

    it "rejects a non-empty actual against an empty expected":
        step("actual vs empty expected")
        expect(coverage_digest_matches("abc", "")).to_equal(false)

    it "accepts equal non-empty digests and rejects differing ones":
        step("equal and differing")
        expect(coverage_digest_matches("abc", "abc")).to_equal(true)
        expect(coverage_digest_matches("abc", "abd")).to_equal(false)

    it "file_hash_sha256 of a missing path never equals an empty expected digest":
        step("missing path hash")
        val h = file_hash_sha256("/definitely/not/a/real/path/sha")
        expect(h != "").to_equal(true)
        expect(h.len() == 64).to_equal(false)
        expect(coverage_digest_matches(h, "")).to_equal(false)
