doc/05_design/REQ-APP-TEST-001.md
"""
# @req: REQ-APP-TEST-001

# @tag: unit, crypto, x25519mlkem768, coverage, contract
# @req REQ-008 NFR-011
#
# This is a static contract test.  It proves authored inventory identity only;
# it never treats this fixture as a measured coverage receipt.

use std.spec.*
use std.sffi.io.{file_read_text}
use std.common.crypto.sha256.{sha256_text}
use app.test.x25519mlkem768_coverage_contract.{
    X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH,
    X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256,
    X25519_MLKEM768_COVERAGE_OWNER_COUNT,
    X25519_MLKEM768_COVERAGE_SPEC_COUNT,
    X25519_MLKEM768_CRITICAL_OUTCOME_COUNT,
    X25519_MLKEM768_COVERAGE_CONTRACT_PATH,
    X25519_MLKEM768_COVERAGE_COMPOSER_PATH,
    x25519_mlkem768_coverage_owner_ids,
    x25519_mlkem768_coverage_owner_paths,
    x25519_mlkem768_coverage_spec_paths}

val _COVERAGE_FIXTURE_MANIFEST =
    "test/fixtures/crypto/x25519mlkem768/manifest.sdn"
val _COVERAGE_RECEIPT_SCHEMA =
    "test/fixtures/crypto/x25519mlkem768/branch_coverage_receipt_schema.sdn"

fn _owner_rows(psv: text) -> [text]:
    var rows: [text] = []
    for line in psv.trim().split("\n"):
        if line.starts_with("owner|"): rows.push(line)
    rows

fn _critical_row_count(psv: text) -> i64:
    var count: i64 = 0
    for line in psv.trim().split("\n"):
        if line.starts_with("critical|"): count = count + 1
    count

fn _canonical_workload_spec_paths() -> [text]:
    [
        "test/01_unit/os/crypto/x25519mlkem768_absolute_spec.spl",
        "test/02_integration/os/crypto/x25519mlkem768_backend_matrix_spec.spl",
        "test/01_unit/os/tls13/x25519mlkem768_hrr_spec.spl",
        "test/03_system/app/tls/feature/x25519mlkem768_acceleration_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_hybrid_support_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_cache_lifecycle_negative_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_gpu_binary_provider_contract_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_simd_dispatch_structure_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_simd_provenance_contract_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_gpu_build_admission_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_gpu_measurement_qualification_spec.spl",
        "test/01_unit/os/crypto/x25519mlkem768_gpu_lifecycle_snapshot_spec.spl",
        "test/01_unit/app/test/x25519mlkem768_gpu_dispatch_contract_spec.spl",
        "test/01_unit/lib/common/crypto/x25519mlkem768_evidence_contract_spec.spl",
        "test/01_unit/lib/common/crypto/x25519mlkem768_matrix_receipt_spec.spl",
        "test/01_unit/lib/common/crypto/x25519mlkem768_executed_row_composer_spec.spl",
        "test/01_unit/app/web/x25519mlkem768_browser_tls_fail_closed_spec.spl",
        "test/02_integration/app/web/x25519mlkem768_web_browser_integration_spec.spl"
    ]

use std.spec.step

describe "X25519MLKEM768 coverage contract reconciliation":
    it "keeps the PSV owner order identical to the typed contract":
        # @req: REQ-008
        step("Verify: keeps the PSV owner order identical to the typed contract")
        val psv = file_read_text(X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH)
        expect(psv.starts_with("schema|x25519mlkem768-critical-symbolic-v1\n")).to_be(true)
        expect(sha256_text(psv)).to_equal(X25519_MLKEM768_CRITICAL_SYMBOLIC_SHA256)
        val ids = x25519_mlkem768_coverage_owner_ids()
        val paths = x25519_mlkem768_coverage_owner_paths()
        val rows = _owner_rows(psv)
        expect(ids.len()).to_equal(X25519_MLKEM768_COVERAGE_OWNER_COUNT)
        expect(paths.len()).to_equal(X25519_MLKEM768_COVERAGE_OWNER_COUNT)
        expect(rows.len()).to_equal(X25519_MLKEM768_COVERAGE_OWNER_COUNT)
        var index: i64 = 0
        while index < X25519_MLKEM768_COVERAGE_OWNER_COUNT:
            expect(rows[index]).to_start_with(
                "owner|" + ids[index] + "|" + paths[index] + "|")
            index = index + 1

    it "keeps exact workload and outcome cardinalities pinned":
        # @req: REQ-APP-TEST-001
        step("Verify: keeps exact workload and outcome cardinalities pinned")
        val psv = file_read_text(X25519_MLKEM768_CRITICAL_SYMBOLIC_PATH)
        val specs = x25519_mlkem768_coverage_spec_paths()
        val canonical_specs = _canonical_workload_spec_paths()
        expect(specs.len()).to_equal(X25519_MLKEM768_COVERAGE_SPEC_COUNT)
        expect(canonical_specs.len()).to_equal(X25519_MLKEM768_COVERAGE_SPEC_COUNT)
        var spec_index: i64 = 0
        while spec_index < X25519_MLKEM768_COVERAGE_SPEC_COUNT:
            expect(specs[spec_index]).to_equal(canonical_specs[spec_index])
            spec_index = spec_index + 1
        expect(_critical_row_count(psv)).to_equal(
            X25519_MLKEM768_CRITICAL_OUTCOME_COUNT)
        val schema = file_read_text(_COVERAGE_RECEIPT_SCHEMA)
        expect(schema).to_contain(
            "exact_row_count: " + X25519_MLKEM768_CRITICAL_OUTCOME_COUNT.to_text())
        val manifest = file_read_text(_COVERAGE_FIXTURE_MANIFEST)
        expect(manifest).to_contain(
            "exact_owner_count: " + X25519_MLKEM768_COVERAGE_OWNER_COUNT.to_text())
        expect(manifest).to_contain(
            "exact_workload_spec_count: " + X25519_MLKEM768_COVERAGE_SPEC_COUNT.to_text())
        expect(manifest).to_contain(
            "exact_critical_outcome_count: " +
                X25519_MLKEM768_CRITICAL_OUTCOME_COUNT.to_text())
        expect(manifest).to_contain(
            "coverage_composer_sha256: \"" + sha256_text(
                file_read_text(X25519_MLKEM768_COVERAGE_COMPOSER_PATH)) + "\"")
        expect(manifest).to_contain(
            "coverage_contract_sha256: \"" + sha256_text(
                file_read_text(X25519_MLKEM768_COVERAGE_CONTRACT_PATH)) + "\"")
