# @req: REQ-APP-TEST-001

# @tag: unit, crypto, x25519mlkem768, gpu, performance, qualification
# @req REQ-007 REQ-010 REQ-011 REQ-012 NFR-009 NFR-010 NFR-017

use std.spec.{describe, it, expect, step}
use std.common.crypto.sha256.{sha256_text}
use std.sffi.io.{file_read_text}
use test.helpers.x25519mlkem768_performance_fixture.{
    x25519_mlkem768_synthetic_measurement_qualification}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768VerificationPolicy, X25519MlKem768Config,
    X25519MlKem768Evidence}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}
use lib.common.crypto.x25519_mlkem768.measurement_qualification.{
    X25519MlKem768MeasurementQualification,
    x25519_mlkem768_measurement_qualification_sha256}
use os.crypto.x25519_mlkem768.gpu_lifecycle_snapshot.{
    X25519MlKem768GpuLifecycleDelta}
use os.crypto.x25519_mlkem768.gpu_build_admission.{
    X25519MlKem768GpuBuildAdmission,
    x25519_mlkem768_gpu_build_admission_sha256}
use app.test.x25519mlkem768_gpu_paired_measurement.{
    X25519MlKem768GpuPairedMeasurementBlocker,
    x25519_mlkem768_collect_gpu_paired_measurement}

fn _gpu_backend(backend: X25519MlKem768EvidenceBackend
        ) -> X25519MlKem768Backend:
    if backend == X25519MlKem768EvidenceBackend.Cuda:
        return X25519MlKem768Backend.Cuda
    if backend == X25519MlKem768EvidenceBackend.Vulkan:
        return X25519MlKem768Backend.Vulkan
    X25519MlKem768Backend.Metal

fn _gpu_identity(backend: X25519MlKem768EvidenceBackend) -> text:
    val admission = _admission(backend)
    if backend == X25519MlKem768EvidenceBackend.Cuda:
        return "cuda-device:42:cubin:" + admission.backend_artifact_sha256 +
            ":cache:" + admission.executor_cache_identity_sha256
    if backend == X25519MlKem768EvidenceBackend.Vulkan:
        return "vulkan-device:42:spirv-set:" +
            admission.backend_artifact_sha256 + ":cache:" +
            admission.executor_cache_identity_sha256
    "metal-device:Apple GPU:metallib:" + admission.backend_artifact_sha256

fn _admission(backend: X25519MlKem768EvidenceBackend
        ) -> X25519MlKem768GpuBuildAdmission:
    val forward =
        "0865f588f0825a3ff66a1d5e2cd2a9d0c356bb75b4fceaaf5c2196ffa05f6379"
    val inverse =
        "07a11b541ef204a4fb6c907338dafc99bdf870d2046edcfad02a3d42dcca2687"
    val cuda =
        "562bfee3e9cd630425a69a5b27a0cc6661f0a00609a85078ef376565fb5b7711"
    val vulkan = backend == X25519MlKem768EvidenceBackend.Vulkan
    val metal = backend == X25519MlKem768EvidenceBackend.Metal
    X25519MlKem768GpuBuildAdmission(
        backend: backend, runner_artifact_sha256: "1" * 64,
        backend_artifact_sha256: if vulkan:
            sha256_text("forward=" + forward + ";inverse=" + inverse)
        elif metal: "4" * 64 else: cuda,
        accelerator_source_sha256: if vulkan:
            "f29443943a381012f34e26a7ab2ac44bee51338d78662109c47e0182aa1fc668"
        elif metal:
            "e49162b2ab056ef12ca2c4f15c942fa99b4f231b45cf251f4a78dadcd22172b5"
        else:
            "e3201ae10f48e284d703cff81d42a02d9ba7f96e4bcc9b03872094b25a5a26aa",
        accelerator_binary_sha256: if vulkan: forward
            elif metal: "4" * 64 else: cuda,
        accelerator_source_aux_sha256: if vulkan:
            "b1e5a9ed87e4331abb5ac7ab906418aa9e4c927d2e284174990110318382e09c"
            else: "",
        accelerator_binary_aux_sha256: if vulkan: inverse else: "",
        build_toolchain: if vulkan:
            "glslangValidator-sha256:96ea85d4228d7065507cd58454628e0d3c9ec8bbd29a0cd20ee0f3cefaf6d026" +
            "+spirv-val-sha256:20c5998a46f02310f56bf11be238c34d374bb50104b7ccf85bb909f9da883ff9"
        elif metal: "Apple Metal compiler"
        else: "CUDA ptxas 13.0 V13.0.88",
        device_capability: if vulkan: "vulkan1.1"
            elif metal: "metal3" else: "8.6",
        device_name: if vulkan: "NVIDIA TITAN RTX"
            elif metal: "Apple GPU" else: "NVIDIA RTX A6000",
        live_device_identity: if vulkan:
            "NVIDIA TITAN RTX|vendor=000010de|device=00001d74|" +
                "driver=03753fc8|api=00403000"
        elif metal: "metal-device:Apple GPU"
        else: "cuda-device-identity:42",
        live_device_identity_tag: 42,
        executor_cache_identity_sha256: "9" * 64)

fn _qualification(backend: X25519MlKem768EvidenceBackend
        ) -> X25519MlKem768MeasurementQualification:
    var qualification =
        x25519_mlkem768_synthetic_measurement_qualification(backend)
    var admission = _admission(backend)
    var target = qualification.target
    admission.runner_artifact_sha256 = target.runner_artifact_sha256
    target.backend_artifact_sha256 = admission.backend_artifact_sha256
    target.executor_identity = _gpu_identity(backend)
    target.accelerator_build_binding_sha256 =
        x25519_mlkem768_gpu_build_admission_sha256(admission)
    qualification.target = target
    qualification.qualification_sha256 =
        x25519_mlkem768_measurement_qualification_sha256(qualification)
    qualification

fn _admission_for(qualification: X25519MlKem768MeasurementQualification
        ) -> X25519MlKem768GpuBuildAdmission:
    var admission = _admission(qualification.target.backend)
    admission.runner_artifact_sha256 =
        qualification.target.runner_artifact_sha256
    admission

fn _config(qualification: X25519MlKem768MeasurementQualification
        ) -> X25519MlKem768Config:
    X25519MlKem768Config(
        implementation_version: qualification.implementation_version,
        profile_version: qualification.profile_version,
        requested_backend: _gpu_backend(qualification.target.backend),
        selection_mode: X25519MlKem768SelectionMode.Require,
        verification_policy:
            X25519MlKem768VerificationPolicy.AbsoluteAndScalar,
        minimum_batch: 1, batch_size: qualification.batch_size)

fn _evidence(qualification: X25519MlKem768MeasurementQualification
        ) -> X25519MlKem768Evidence:
    val selected = _gpu_backend(qualification.target.backend)
    X25519MlKem768Evidence(
        requested_backend: selected, selected_backend: selected,
        attempts: [], fallback_used: false, fallback_reason: "",
        implementation_version: qualification.implementation_version,
        profile_version: qualification.profile_version,
        configuration_digest:
            qualification.target.candidate_configuration_sha256,
        input_fixture_digest: qualification.target.fixture_source_sha256,
        source_digest: "3" * 64,
        artifact_digest: qualification.target.backend_artifact_sha256,
        execution_proof_digest:
            qualification.target.backend_artifact_sha256,
        kernel_invocations: 90, simd_chunk_hits: 0,
        observed_rvv_vlen_bits: 0, operation: "batch-round-trip",
        batch_size: qualification.batch_size, output_digest: "7" * 64,
        executor_identity: qualification.target.executor_identity,
        compiled: true, submitted: true, fence_completed: true,
        device_readback: true, oracle_match: true)

fn _lifecycle() -> X25519MlKem768GpuLifecycleDelta:
    X25519MlKem768GpuLifecycleDelta(
        transfer_count: 90, launch_count: 90,
        synchronization_count: 90, readback_count: 90,
        kernel_count: 90)

describe "X25519MLKEM768 fail-closed GPU paired collector preflight":
    it "rejects invalid ABBA counts before any qualification claim":
        # @req: REQ-007
        step("Verify: rejects invalid ABBA counts before any qualification claim")
        val qualification = _qualification(
            X25519MlKem768EvidenceBackend.Cuda)
        val result = x25519_mlkem768_collect_gpu_paired_measurement(
            qualification, _config(qualification),
            _admission_for(qualification), _evidence(qualification),
            _lifecycle(), 31)
        expect(result.collected).to_be(false)
        expect(result.blocker).to_equal(
            X25519MlKem768GpuPairedMeasurementBlocker.InvalidPairCount)
        expect(result.reason).to_equal("gpu-paired-sample-count-not-even")

    it "keeps generic CUDA and Vulkan diagnostics blocked from collection":
        # @req: REQ-010
        step("Verify: keeps generic CUDA and Vulkan diagnostics blocked from collection")
        step("Caller-constructible evidence is never trusted as live proof")
        for backend in [X25519MlKem768EvidenceBackend.Cuda,
                X25519MlKem768EvidenceBackend.Vulkan]:
            val qualification = _qualification(backend)
            val result = x25519_mlkem768_collect_gpu_paired_measurement(
                qualification, _config(qualification),
                _admission_for(qualification),
                _evidence(qualification), _lifecycle(), 30)
            expect(result.collected).to_be(false)
            expect(result.blocker).to_equal(
                X25519MlKem768GpuPairedMeasurementBlocker.TrustedLiveExecutorAdmissionUnavailable)
            expect(result.reason).to_equal(
                "gpu-paired-trusted-live-executor-admission-unavailable")

    it "preserves the pinned Metal qualification blocker":
        # @req: REQ-011
        step("Verify: preserves the pinned Metal qualification blocker")
        val qualification = _qualification(X25519MlKem768EvidenceBackend.Metal)
        val result = x25519_mlkem768_collect_gpu_paired_measurement(
            qualification, _config(qualification),
            _admission_for(qualification),
            _evidence(qualification), _lifecycle(), 30)
        expect(result.collected).to_be(false)
        expect(result.blocker).to_equal(
            X25519MlKem768GpuPairedMeasurementBlocker.QualificationRejected)
        expect(result.reason).to_equal(
            "gpu-build-metal-metallib-and-live-identity-not-pinned")

    it "preserves the canonical qualification rejection reason":
        # @req: REQ-012
        step("Verify: preserves the canonical qualification rejection reason")
        val qualification = _qualification(
            X25519MlKem768EvidenceBackend.Cuda)
        var evidence = _evidence(qualification)
        evidence.fallback_used = true
        val result = x25519_mlkem768_collect_gpu_paired_measurement(
            qualification, _config(qualification),
            _admission_for(qualification), evidence,
            _lifecycle(), 30)
        expect(result.collected).to_be(false)
        expect(result.blocker).to_equal(
            X25519MlKem768GpuPairedMeasurementBlocker.QualificationRejected)
        expect(result.reason).to_equal(
            "gpu-measurement-fallback-or-oracle-mismatch")

    it "contains no timing crypto RSS or synthetic-lifecycle success path":
        # @req: REQ-APP-TEST-001
        step("Verify: contains no timing crypto RSS or synthetic-lifecycle success path")
        val source = file_read_text(
            "src/app/test/x25519mlkem768_gpu_paired_measurement.spl")
        expect(source).to_contain(
            "x25519_mlkem768_qualified_gpu_measurement_reason")
        expect(source).to_contain(
            "TrustedLiveExecutorAdmissionUnavailable")
        expect(source.contains("time_now_nanos")).to_be(false)
        expect(source.contains("platform_measurement_refresh_process_rss")).to_be(false)
        expect(source.contains("x25519_mlkem768_keygen")).to_be(false)
        expect(source.contains("lifecycle_snapshot()")).to_be(false)
