use std.spec.*
use app.test.aggregate_task_options.{aggregate_task_requested_jobs_v1, aggregate_task_concurrency_report_v1}

describe "aggregate requested jobs":
    it "accepts forty and other positive requests without an eighty-worker whitelist":
        expect(aggregate_task_requested_jobs_v1("40").unwrap()).to_equal(40)
        expect(aggregate_task_requested_jobs_v1("1").unwrap()).to_equal(1)
        expect(aggregate_task_requested_jobs_v1("80").unwrap()).to_equal(80)
        expect(aggregate_task_requested_jobs_v1("9223372036854775807").unwrap()).to_equal(9223372036854775807)

    it "rejects zero negative malformed and overflowing requests":
        for value in ["0", "-1", "", "040", "+40", "4.0", " 40", "40\n", "9223372036854775808", "999999999999999999999"]:
            expect(aggregate_task_requested_jobs_v1(value).is_err()).to_be(true)
            expect(aggregate_task_concurrency_report_v1(value).is_err()).to_be(true)

    it "reports requested forty separately from the serial execution bound":
        expect(aggregate_task_concurrency_report_v1("40").unwrap()).to_equal(
            "requested_jobs=40\nexecution_mode=serial\nexecution_worker_limit=1\n")
        expect(aggregate_task_concurrency_report_v1("80").unwrap()).to_equal(
            "requested_jobs=80\nexecution_mode=serial\nexecution_worker_limit=1\n")
