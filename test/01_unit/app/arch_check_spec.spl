"""
## Purpose and audience
Executable specification for `check-arch`, the architecture dependency
validator in src/app/cli/arch_check.spl. Written for the engineers who own the
MDSOC dimension rules (entity / feature / transform) and for reviewers who need
proof that pattern parsing, glob matching, and dimension allow/deny decisions
behave exactly as the architecture rules document promises.

## Operator workflow
Run one file: `bin/simple test test/01_unit/app/arch_check_spec.spl`.
Every scenario calls a real helper exported from app.cli.arch_check; no scenario
needs a repository checkout or network access.

## Compatibility and limitations
The private helpers (`_str_trim`, `_parse_pattern_list`, ...) are exported for
these unit scenarios but are not public CLI surface, so a rename in
arch_check.spl is a breaking change for this file by design. The end-to-end
`check-arch` repository walk is out of scope here; only the pure decision
functions are exercised.

## Verification guidance and troubleshooting
A failure in the pattern-parse groups means the arch block grammar drifted; a
failure in the dimension groups means the entity/feature/transform dependency
matrix changed. Re-read src/app/cli/arch_check.spl next to the failing expect
before changing either side.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md
# doc/03_plan/sspec_modernization_plan.md
# doc/04_architecture/sspec_documentization_maintenance.md
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: arch_check decision helpers

use app.cli.arch_check (
    _str_trim, _parse_pattern_list, _parse_string_value, _parse_arch_block,
    _module_path_from_init_file, _parse_imports_from_content,
    _match_pattern, _is_import_allowed,
    _file_is_under_module,
    _infer_dimension_from_file, _infer_dimension_from_import,
    _dim_allows_import, _arch_explicitly_allows, _transform_allows_entity_import,
    ArchRule, FileImports, ArchViolation
)
use app.io.mod (shell)
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.spec.step

# ============================================================================
# String helpers
# ============================================================================

describe "arch_check: _str_trim":
    # @manual scenario evidence
    it "trims leading spaces":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: trims leading spaces")
        val result = _str_trim("  hello")
        expect(result).to_equal("hello")

    it "trims trailing spaces":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: trims trailing spaces")
        val result = _str_trim("hello  ")
        expect(result).to_equal("hello")

    it "trims both sides":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: trims both sides")
        val result = _str_trim("  hello world  ")
        expect(result).to_equal("hello world")

    it "returns unchanged string when no whitespace":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: returns unchanged string when no whitespace")
        val result = _str_trim("hello")
        expect(result).to_equal("hello")

    it "returns empty string for all whitespace":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: returns empty string for all whitespace")
        val result = _str_trim("   ")
        expect(result).to_equal("")

# ============================================================================
# Pattern list parsing
# ============================================================================

describe "arch_check: _parse_pattern_list":
    it "parses single pattern":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: parses single pattern")
        val result = _parse_pattern_list("allow = [\"core\"]")
        expect(result.len()).to_equal(1)  # oracle: the input declares exactly one entry
        expect(result[0]).to_equal("core")

    it "parses multiple patterns":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: parses multiple patterns")
        val result = _parse_pattern_list("allow = [\"core\", \"std\"]")
        expect(result.len()).to_equal(2)  # oracle: the input declares exactly two entries
        expect(result[0]).to_equal("core")
        expect(result[1]).to_equal("std")

    it "parses glob patterns":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: parses glob patterns")
        val result = _parse_pattern_list("deny = [\"compiler/**\", \"app.io\"]")
        expect(result.len()).to_equal(2)  # oracle: the input declares exactly two entries
        expect(result[0]).to_equal("compiler/**")

    it "returns empty for missing brackets":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: returns empty for missing brackets")
        val result = _parse_pattern_list("allow = core")
        expect(result.len()).to_equal(0)  # oracle: an absent or empty list parses to zero entries by contract

    it "handles empty list":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: handles empty list")
        val result = _parse_pattern_list("deny = []")
        expect(result.len()).to_equal(0)  # oracle: an absent or empty list parses to zero entries by contract

