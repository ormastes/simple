        val root = "/root"
        val result = _module_path_from_init_file(path, root)
        expect(result).to_equal("src/compiler/10.frontend/feature/lexing")

# ============================================================================
# Import parsing
# ============================================================================

describe "arch_check: _parse_imports_from_content":
    it "extracts simple use statements":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: extracts simple use statements")
        var content = "use app.io.mod (file_read)\n"
        content = content + "fn main():\n"
        content = content + "    pass\n"
        val result = _parse_imports_from_content(content)
        expect(result.len()).to_equal(1)  # oracle: the input declares exactly one entry
        expect(result[0]).to_equal("app/io/mod")

    it "extracts multiple use statements":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: extracts multiple use statements")
        var content = "use app.io.mod (file_read)\n"
        content = content + "use std.text.\n\n"
        val result = _parse_imports_from_content(content)
        expect(result.len()).to_equal(2)  # oracle: the input declares exactly two entries
        expect(result[0]).to_equal("app/io/mod")
        expect(result[1]).to_equal("std/text")

    it "converts dots to slashes":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: converts dots to slashes")
        # Build content string without brace interpolation issues
        val open_b = "{"
        val close_b = "}"
        val content = "use compiler.core.ast." + open_b + "CoreExpr" + close_b + "\n"
        val result = _parse_imports_from_content(content)
        expect(result.len()).to_equal(1)  # oracle: the input declares exactly one entry
        expect(result[0]).to_equal("compiler/core/ast")

    it "ignores non-use lines":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: ignores non-use lines")
        var content = "# Comment\n"
        content = content + "fn foo():\n"
        content = content + "    pass\n"
        val result = _parse_imports_from_content(content)
        expect(result.len()).to_equal(0)  # oracle: an absent or empty list parses to zero entries by contract

    it "handles use with wildcard":
        # @req REQ-CLI-ARCH-CHECK-001
        # @capture(bit_table): helper verdict retained for review
        step("Run the arch_check helper and observe: handles use with wildcard")
        val content = "use app.io.*\n"
        val result = _parse_imports_from_content(content)
        expect(result.len()).to_equal(1)  # oracle: the input declares exactly one entry
        expect(result[0]).to_equal("app/io")

