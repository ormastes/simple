# GDB MI streaming-parser + token-table specification.
#
# Exercises GdbMiParser.parse_line() (the record classifier) and
# GdbBreakpoint.from_tuple() (the rich-breakpoint model that replaced the
# old "keep only `number`, discard everything else" behavior) against
# captured/fixture MI strings — no live GDB process involved, so this
# stays green regardless of whether a `gdb` binary is installed.
#
# Landmine: MI output is full of `{`/`}`. Double-quoted text literals in
# this language interpolate `{...}`, so every fixture line below uses
# single-quoted raw strings to avoid corrupting the braces.

use app.debug.remote.protocol.gdb_mi_parser.{GdbMiParser, GdbMiRecord, GdbBreakpoint}

describe "GdbMiParser.parse_line() record classification":
    it "classifies a ^done result record and keeps its token":
        val record = GdbMiParser.parse_line('3^done,value="42"')
        expect(record.is_result()).to_equal(true)
        expect(record.is_done()).to_equal(true)
        match record:
            GdbMiRecord.Result(token, cls, data):
                expect(token).to_equal(3)
                expect(cls).to_equal("done")
                expect(data.get("value") ?? "").to_equal("42")
            _:
                expect(true).to_equal(false)

    it "classifies a ^error result record with a message":
        val record = GdbMiParser.parse_line('7^error,msg="No symbol table is loaded"')
        expect(record.is_error()).to_equal(true)
        match record:
            GdbMiRecord.Result(token, cls, data):
                expect(token).to_equal(7)
                expect(data.get("msg") ?? "").to_equal("No symbol table is loaded")
            _:
                expect(true).to_equal(false)

    it "classifies a *stopped async record":
        val record = GdbMiParser.parse_line('*stopped,reason="breakpoint-hit",bkptno="1"')
        expect(record.is_stopped()).to_equal(true)
        match record:
            GdbMiRecord.Async(cls, data):
                expect(cls).to_equal("stopped")
                expect(data.get("bkptno") ?? "").to_equal("1")
            _:
                expect(true).to_equal(false)

    it "classifies an = event record separately from *stopped":
        val record = GdbMiParser.parse_line('=thread-created,id="1"')
        expect(record.is_stopped()).to_equal(false)
        match record:
            GdbMiRecord.Async(cls, _):
                expect(cls).to_equal("thread-created")
            _:
                expect(true).to_equal(false)

    it "classifies a ~console stream record and unescapes it":
        val record = GdbMiParser.parse_line('~"Reading symbols from a.out...\\n"')
        match record:
            GdbMiRecord.Stream(kind, content):
                expect(kind).to_equal("console")
                expect(content).to_contain("Reading symbols")
            _:
                expect(true).to_equal(false)

    it "classifies a (gdb) prompt line":
        val record = GdbMiParser.parse_line("(gdb)")
        match record:
            GdbMiRecord.Prompt:
                expect(true).to_equal(true)
            _:
                expect(true).to_equal(false)

    it "does not confuse two different tokens on interleaved output":
        val first = GdbMiParser.parse_line('1^done,foo="a"')
        val second = GdbMiParser.parse_line('2^done,foo="b"')
        match first:
            GdbMiRecord.Result(token, _, data):
                expect(token).to_equal(1)
                expect(data.get("foo") ?? "").to_equal("a")
            _:
                expect(true).to_equal(false)
        match second:
            GdbMiRecord.Result(token, _, data):
                expect(token).to_equal(2)
                expect(data.get("foo") ?? "").to_equal("b")
            _:
                expect(true).to_equal(false)

describe "GdbBreakpoint.from_tuple() rich-field preservation":
    it "keeps id, location, and enabled state":
        val raw = 'number="1",type="breakpoint",disp="keep",enabled="y",addr="0x0000000000401136",func="main",file="main.c",fullname="/tmp/main.c",line="5",thread-groups=["i1"],times="0",original-location="main.c:5"'
        val tuple = GdbMiParser.parse_kv_pairs(raw)
        val bp = GdbBreakpoint.from_tuple(tuple)
        expect(bp.id).to_equal(1)
        expect(bp.func_name).to_equal("main")
        expect(bp.file).to_equal("main.c")
        expect(bp.line).to_equal(5)
        expect(bp.enabled).to_equal(true)
        expect(bp.original_location).to_equal("main.c:5")

    it "does not discard the condition field on a conditional breakpoint":
        val raw = 'number="2",type="breakpoint",disp="keep",enabled="y",addr="0x0000000000401150",func="loop",file="main.c",fullname="/tmp/main.c",line="12",cond="i == 10",times="0",original-location="main.c:12"'
        val tuple = GdbMiParser.parse_kv_pairs(raw)
        val bp = GdbBreakpoint.from_tuple(tuple)
        expect(bp.condition).to_equal("i == 10")

    it "does not discard the hit count (times) field after breakpoints fire":
        val raw = 'number="3",type="breakpoint",disp="keep",enabled="y",addr="0x0000000000401160",func="tick",file="main.c",fullname="/tmp/main.c",line="20",times="4",original-location="main.c:20"'
        val tuple = GdbMiParser.parse_kv_pairs(raw)
        val bp = GdbBreakpoint.from_tuple(tuple)
        expect(bp.hit_count).to_equal(4)

    it "reports disabled breakpoints correctly":
        val raw = 'number="4",type="breakpoint",disp="keep",enabled="n",addr="0x0000000000401170",func="skip",file="main.c",fullname="/tmp/main.c",line="30",times="0",original-location="main.c:30"'
        val tuple = GdbMiParser.parse_kv_pairs(raw)
        val bp = GdbBreakpoint.from_tuple(tuple)
        expect(bp.enabled).to_equal(false)

    it "keeps the full raw field dict so nothing is silently dropped":
        val raw = 'number="5",type="breakpoint",disp="keep",enabled="y",addr="0x0000000000401180",func="extra",file="main.c",fullname="/tmp/main.c",line="40",times="0",original-location="main.c:40"'
        val tuple = GdbMiParser.parse_kv_pairs(raw)
        val bp = GdbBreakpoint.from_tuple(tuple)
        expect(bp.raw.get("type") ?? "").to_equal("breakpoint")
        expect(bp.raw.get("disp") ?? "").to_equal("keep")
