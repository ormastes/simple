#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../../.." && pwd)
subject="$repo_root/test/03_system/app/debug/remote/protocol/gdb_mi_transport_spec.spl"

fixture_root=$(mktemp -d)
trap 'rm -rf "$fixture_root"' EXIT HUP INT TERM
quote_line="$fixture_root/quote-line"
cat > "$quote_line" <<'QUOTE_LINE'
    "'" + value.replace("'", "'\\''") + "'"
QUOTE_LINE

check_spec() {
    spec=$1
    if grep -q '/home/ormastes/dev/pub/simple' "$spec"; then
        return 1
    fi
    grep -Fq 'use app.io.mod.{cwd, env_get}' "$spec" || return 1
    grep -Fq 'env_get("SIMPLE_PROJECT_ROOT")' "$spec" || return 1
    grep -Fq 'env_get("SIMPLE_LIB")' "$spec" || return 1
    grep -Fq 'val simple_bin = _repo_simple_bin(_repo_root())' "$spec" || return 1
    grep -Fq 'return "RUNNER_MISSING"' "$spec" || return 1
    grep -Fq 'return "PIPED_EXTERN_MISSING"' "$spec" || return 1
    grep -Fq '"RUNNER_FAILED"' "$spec" || return 1
    grep -Fq 'expect(piped_probe).to_equal("PIPED_OK")' "$spec" || return 1
    grep -Fq '"{_shell_quote(simple_bin)} run {_shell_quote(probe_path)} 2>/dev/null"' "$spec" || return 1
    grep -Fxq -f "$quote_line" "$spec" || return 1
    grep -Fq "/tmp/simple repo/owner's probe.spl" "$spec" || return 1
    grep -Fq "to_equal(\"'/tmp/simple repo/owner'" "$spec" || return 1
}

check_spec "$subject"

relocated="$fixture_root/repo with owner's space"
mkdir -p "$relocated/test/03_system/app/debug/remote/protocol" "$relocated/bin"
cp "$subject" "$relocated/test/03_system/app/debug/remote/protocol/gdb_mi_transport_spec.spl"
check_spec "$relocated/test/03_system/app/debug/remote/protocol/gdb_mi_transport_spec.spl"
cat > "$relocated/bin/simple" <<'FAKE_BIN'
#!/bin/sh
printf 'x\n' >> "$0.invoked"
printf 'PIPED_OK\n'
FAKE_BIN
chmod 755 "$relocated/bin/simple"
probe="$fixture_root/probe with owner's name.spl"
: > "$probe"
relocated_output=$("$relocated/bin/simple" run "$probe")
test "$relocated_output" = PIPED_OK
test "$(wc -l < "$relocated/bin/simple.invoked")" -eq 1

legacy_mutant="$fixture_root/legacy.spl"
sed 's|val simple_bin = _repo_simple_bin(_repo_root())|val simple_bin = "/home/ormastes/dev/pub/simple/bin/simple"|' "$subject" > "$legacy_mutant"
if check_spec "$legacy_mutant"; then
    echo 'error: accepted legacy-runner mutant' >&2
    exit 1
fi

unquoted_mutant="$fixture_root/unquoted.spl"
sed 's/{_shell_quote(simple_bin)}/{simple_bin}/' "$subject" > "$unquoted_mutant"
if check_spec "$unquoted_mutant"; then
    echo 'error: accepted unquoted-runner mutant' >&2
    exit 1
fi

broken_escape_mutant="$fixture_root/broken-escape.spl"
sed 's/value\.replace/value/' "$subject" > "$broken_escape_mutant"
if check_spec "$broken_escape_mutant"; then
    echo 'error: accepted broken-escape mutant' >&2
    exit 1
fi

plausible_escape_mutant="$fixture_root/plausible-broken-escape.spl"
sed 's/+ value\.replace/+ value.replace("BROKEN", "BROKEN") + value.replace/' "$subject" > "$plausible_escape_mutant"
if check_spec "$plausible_escape_mutant"; then
    echo 'error: accepted plausible broken-escape mutant' >&2
    exit 1
fi

missing_runner_mutant="$fixture_root/missing-runner-skip.spl"
sed 's/expect(piped_probe).to_equal("PIPED_OK")/print "SKIP"/' "$subject" > "$missing_runner_mutant"
if check_spec "$missing_runner_mutant"; then
    echo 'error: accepted missing-runner skip mutant' >&2
    exit 1
fi

echo 'gdb mi transport path contract: PASS'
