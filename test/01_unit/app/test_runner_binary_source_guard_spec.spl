use std.io_runtime.{file_read}
use std.spec.*

describe "test runner binary selection source guard":
    it "requires canonical current-executable identity at both child boundaries":
        val client = file_read("src/app/test_runner_new/test_runner_client.spl")
        val single = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(client).to_contain("cli_current_exe_path()")
        expect(single).to_contain("cli_current_exe_path()")
        expect(client).to_contain("val process_args = sys_get_args()")
        expect(single).to_contain("val process_args = sys_get_args()")
        expect(client).to_contain("configured != invoker")
        expect(single).to_contain("configured != current")
        expect(client).to_contain("canonical invoking candidate identity is unavailable")
        expect(single).to_contain("canonical invoking candidate identity is unavailable")

    it "never falls back to deployed bin/simple or a Rust debug seed":
        val client = file_read("src/app/test_runner_new/test_runner_client.spl")
        val single = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(client.contains("return \"bin/simple\"")).to_equal(false)
        expect(client.contains("return \"./bin/simple\"")).to_equal(false)
        expect(client.contains("src/compiler_rust/target/debug/simple")).to_equal(false)
        expect(single.contains("return \"bin/simple\"")).to_equal(false)
        expect(single.contains("return \"./bin/simple\"")).to_equal(false)
        expect(single.contains("src/compiler_rust/target/debug/simple")).to_equal(false)

    it "keeps source-entry rejection in the daemon resolvers outside this lane":
        val daemon = file_read("src/app/test_daemon/main.spl")
        val light_daemon = file_read("src/app/test_daemon/light_daemon.spl")
        val guard = "not raw[0].ends_with(\".spl\")"

        expect(daemon).to_contain(guard)
        expect(light_daemon).to_contain(guard)
