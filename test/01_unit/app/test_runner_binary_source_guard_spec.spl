use std.io_runtime.{file_read, file_write, file_delete, dir_create_all}
use std.spec.*
use app.test_daemon.light_daemon.{argv_binary_candidate}

describe "test runner binary selection source guard":
    it "never treats an in-process Simple app source path as the compiler binary":
        val client = file_read("src/app/test_runner_new/test_runner_client.spl")
        val single = file_read("src/app/test_runner_new/test_runner_single.spl")
        val daemon = file_read("src/app/test_daemon/main.spl")
        val light_daemon = file_read("src/app/test_daemon/light_daemon.spl")
        val guard = "not raw[0].ends_with(\".spl\")"

        expect(client).to_contain(guard)
        expect(single).to_contain(guard)
        expect(daemon).to_contain(guard)
        expect(light_daemon).to_contain(guard)

    it "rejects a source-mode .spl argv[0] while still accepting a real compiler path":
        val daemon_source = "src/app/test_daemon/light_daemon.spl"
        expect(argv_binary_candidate([daemon_source, "run"])).to_equal("")
        expect(argv_binary_candidate([])).to_equal("")
        expect(argv_binary_candidate(["/bin/sh"])).to_equal("")
        dir_create_all(".build/test_runner_binary_source_guard")
        val compiler = ".build/test_runner_binary_source_guard/simple"
        file_write(compiler, "probe")
        expect(argv_binary_candidate([compiler, "run"])).to_equal(compiler)
        file_delete(compiler)
