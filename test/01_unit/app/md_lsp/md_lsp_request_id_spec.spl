use std.spec
use app.md_lsp.md_lsp_handler.{md_lsp_handle_request_raw, md_lsp_initialize}
use app.md_lsp.md_lsp_workspace.{MdWorkspace}

describe "Markdown LSP request correlation":
    it "preserves lexical string and large integer IDs in success replies":
        step("Dispatch initialize with the wire ID without integer coercion")
        val workspace = MdWorkspace.new()
        val ids = ["3", "\"string-id\"", "\"a\\\"b\\\\c\"", "9007199254740993", "\"\\ud55c\\uae00\""]
        for id in ids:
            val response = md_lsp_handle_request_raw("initialize", "{" + "}", id, workspace)
            expect(response.contains("\"id\":" + id + ",")).to_equal(true)
            expect(response.contains("\"capabilities\":")).to_equal(true)

    it "preserves the same ID when returning method-not-found":
        step("Correlate an error to its original string request ID")
        val workspace = MdWorkspace.new()
        val response = md_lsp_handle_request_raw("unknown/method", "{" + "}", "\"error-id\"", workspace)
        expect(response.contains("\"id\":\"error-id\",")).to_equal(true)
        expect(response.contains("\"code\":-32601")).to_equal(true)

    it "retains the integer adapter used by existing in-process callers":
        step("Call the original integer initialize facade")
        expect(md_lsp_initialize(7).contains("\"id\":7,")).to_equal(true)
