use std.spec
use app.md_lsp.md_lsp_handler.{md_lsp_handle_request_raw, md_lsp_initialize, md_lsp_utf16_length, md_lsp_utf16_byte_offset}
use app.md_lsp.md_lsp_workspace.{MdWorkspace}

describe "Markdown LSP request correlation":
    it "maps UTF-16 columns to whole UTF-8 code points":
        step("Count BMP and supplementary characters without splitting a surrogate pair")
        val value = "한글🙂"
        expect(md_lsp_utf16_length(value)).to_equal(4)
        expect(md_lsp_utf16_byte_offset(value, 0)).to_equal(0)
        expect(md_lsp_utf16_byte_offset(value, 2)).to_equal(6)
        expect(md_lsp_utf16_byte_offset(value, 3)).to_equal(6)
        expect(md_lsp_utf16_byte_offset(value, 4)).to_equal(10)
        expect(md_lsp_utf16_byte_offset(value, 100)).to_equal(10)

    it "uses parsed headings for symbols and anchor targets":
        step("Exclude a fenced example from both symbol and definition responses")
        var workspace = MdWorkspace.new()
        workspace.open_document("file:///fenced.md", "# Visible\n```\n# Hidden\n```\n[link](#hidden)", 1)
        val document = "{" + "\"textDocument\":" + "{" + "\"uri\":\"file:///fenced.md\"" + "}" + "}"
        val symbols = md_lsp_handle_request_raw("textDocument/documentSymbol", document, "2", workspace)
        expect(symbols.contains("Visible")).to_equal(true)
        expect(symbols.contains("Hidden")).to_equal(false)
        val position = "{" + "\"textDocument\":" + "{" + "\"uri\":\"file:///fenced.md\"" + "}" + ",\"position\":" + "{" + "\"line\":4,\"character\":8" + "}" + "}"
        val definition = md_lsp_handle_request_raw("textDocument/definition", position, "3", workspace)
        expect(definition.contains("\"result\":null")).to_equal(true)

    it "preserves lexical string and large integer IDs in success replies":
        step("Dispatch initialize with the wire ID without integer coercion")
        val workspace = MdWorkspace.new()
        val ids = ["3", "\"string-id\"", "\"a\\\"b\\\\c\"", "9007199254740993", "\"\\ud55c\\uae00\""]
        for id in ids:
            val response = md_lsp_handle_request_raw("initialize", "{" + "}", id, workspace)
            expect(response.contains("\"id\":" + id + ",")).to_equal(true)
            expect(response.contains("\"capabilities\":")).to_equal(true)

    it "preserves the same ID when returning method-not-found":
        step("Correlate an error to its original string request ID")
        val workspace = MdWorkspace.new()
        val response = md_lsp_handle_request_raw("unknown/method", "{" + "}", "\"error-id\"", workspace)
        expect(response.contains("\"id\":\"error-id\",")).to_equal(true)
        expect(response.contains("\"code\":-32601")).to_equal(true)

    it "retains the integer adapter used by existing in-process callers":
        step("Call the original integer initialize facade")
        expect(md_lsp_initialize(7).contains("\"id\":7,")).to_equal(true)
