# @cover src/app/md_lsp/md_lsp_transport.spl 90%
"""
## Purpose and audience
The Markdown LSP stdio loop frames JSON-RPC with Content-Length. This spec
imports the REAL transport module (not a copied helper body) and pins the
byte-length contract on multibyte payloads plus header-block validation.
Audience: the md_lsp maintainer.
## Operator workflow
bin/simple test test/01_unit/app/md_lsp/md_lsp_transport_spec.spl
## Compatibility and limitations
Pure in-process; the stdin/stdout externs stay in md_lsp_main.spl and are not
exercised here (see test/02_integration/app/md_lsp_stdio_spec.spl).
## Verification guidance and troubleshooting
A RED on the multibyte row means Content-Length counted codepoints again.
"""
# Lifecycle: doc/03_plan/release/1.0.0/inputs_2026-11-12/unified_diagnostics_parser_recovery_fix_suggestions_plan_2026-11-12.md (Journey E, transport split)
# @manual_section: markdown-lsp-transport

use std.spec
use app.md_lsp.md_lsp_transport.*

describe "Markdown LSP transport — Content-Length framing":

    it "frames a multibyte body with its UTF-8 byte length and parses it back":
        # @req REQ-DIAG-008
        val body = "{\"name\":\"caf\u{e9}\u{e9}\"}"
        # @capture(frame_rows): header length vs byte_len vs codepoint len
        step("Frame a body containing two 2-byte codepoints, then parse the header line")
        val framed = md_lsp_frame(body)
        expect(framed.starts_with("Content-Length: ")).to_equal(true)
        val header_end = framed.index_of("\r\n\r\n")
        expect(header_end.is_some()).to_equal(true)
        val header_line = framed.slice(0, header_end.unwrap())
        val parsed = md_lsp_frame_header([header_line])
        expect(parsed.valid).to_equal(true)
        expect(parsed.content_length).to_equal(body.byte_len())
        expect(parsed.content_length).to_equal(18)  # oracle: 14 ASCII bytes ({"name":"caf"}) + 2 x 2-byte e-acute = 18; codepoint count would be 16

    it "rejects a header block with a duplicated Content-Length":
        # @req REQ-DIAG-008
        # @capture(frame_rows): valid flag under duplicate headers
        step("Parse a header block carrying two Content-Length lines")
        val parsed = md_lsp_frame_header(["Content-Length: 5", "Content-Type: application/json", "Content-Length: 5"])
        expect(parsed.valid).to_equal(false)
        expect(parsed.content_length).to_equal(0)

    it "rejects a header block with no, zero, or non-numeric Content-Length":
        # @req REQ-DIAG-008
        # @capture(frame_rows): three invalid header blocks
        step("Parse header blocks that are missing, zero, and malformed")
        expect(md_lsp_frame_header(["Content-Type: application/json"]).valid).to_equal(false)
        expect(md_lsp_frame_header(["Content-Length: 0"]).valid).to_equal(false)
        expect(md_lsp_frame_header(["Content-Length: 12x"]).valid).to_equal(false)
        expect(md_lsp_frame_header(["Content-Length:"]).valid).to_equal(false)

    it "rejects a Content-Length that would overflow i64 and accepts the maximum":
        # @req REQ-DIAG-008
        # @capture(frame_rows): boundary values
        step("Parse the i64 maximum and one past it")
        expect(md_lsp_frame_header(["Content-Length: 9223372036854775807"]).content_length).to_equal(9223372036854775807)
        expect(md_lsp_frame_header(["Content-Length: 9223372036854775808"]).valid).to_equal(false)

    it "ignores surrounding whitespace and other headers":
        # @req REQ-DIAG-008
        # @capture(frame_rows): tolerant parse
        step("Parse a header block with padded Content-Length and an extra header")
        val parsed = md_lsp_frame_header(["  Content-Length:   42  ", "Content-Type: application/vscode-jsonrpc; charset=utf-8"])
        expect(parsed.valid).to_equal(true)
        expect(parsed.content_length).to_equal(42)
