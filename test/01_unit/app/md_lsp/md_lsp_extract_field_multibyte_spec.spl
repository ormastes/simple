# @req REQ-BUG-MIXED-INDEX-MD-LSP-EXTRACT-FIELD
#
# Regression spec for
# doc/08_tracking/bug/mixed_byte_and_codepoint_indexing_defect_class_2026-08-18.md:
# `_md_lsp_extract_field` (src/app/md_lsp/md_lsp_main.spl) used to scan its
# nested-object/array and number/keyword branches with `.char_at(j)`
# (CODEPOINT-indexed) bounded by `.len()` (BYTE length), reconstructing the
# result by pushing each `.char_at(j)` codepoint and joining. For multibyte
# input the byte/codepoint length mismatch could run `j` out of the valid
# codepoint range mid-scan (silently truncating/aborting the parse before the
# real closing delimiter, observed by direct probe of `.char_at()` on an
# out-of-range codepoint index in this build).
#
# This spec duplicates `_md_lsp_extract_field`'s body rather than importing
# `src/app/md_lsp/md_lsp_main.spl` directly: that file calls
# `md_lsp_server_main()` unconditionally at module scope (its stdio JSON-RPC
# server loop), so importing it as a library executes the server and blocks
# on stdin -- unsafe to do from a spec. The duplicated body below is kept
# byte-for-byte identical to the fixed production function; any future edit
# to `_md_lsp_extract_field` must be mirrored here.
#
# Fix (applied to both the object/array branch and the number/keyword
# branch): stopped reconstructing the result byte-by-byte via
# `parts.push(ch)` / `parts.join("")`. Instead take ONE
# `.substring(0, j)` / `.substring(0, j + 1)` range slice once the scan
# position `j` (a consistent BYTE index) is known. `.substring(j, j + 1)` is
# still used to DETECT the single-byte ASCII delimiter characters
# (`{`/`}`/`[`/`]`/`,`/whitespace), which is safe.

use std.spec.{describe, it, assert_equal}

fn _md_lsp_extract_field(json: text, key: text) -> text:
    val search = "\"" + key + "\":"
    val idx = json.index_of(search)
    if idx < 0:
        return ""
    val start = idx + search.len()
    val after = json.substring(start).trim()
    if after.starts_with("\""):
        val inner = after.substring(1)
        val end_idx = inner.index_of("\"")
        if end_idx < 0:
            return ""
        return inner.substring(0, end_idx)
    elif after.starts_with("{") or after.starts_with("["):
        var depth = 0
        var j = 0
        val alen = after.len()
        while j < alen:
            val ch = after.substring(j, j + 1)
            if ch == "{" or ch == "[":
                depth = depth + 1
            elif ch == "}" or ch == "]":
                depth = depth - 1
            j = j + 1
            if depth == 0:
                return after.substring(0, j)
        return after.substring(0, alen)
    else:
        var j = 0
        val alen = after.len()
        while j < alen:
            val ch = after.substring(j, j + 1)
            if ch == "," or ch == "}" or ch == "]" or ch == " " or ch == "\n" or ch == "\r":
                return after.substring(0, j)
            j = j + 1
        after.substring(0, alen)

describe "_md_lsp_extract_field -- multibyte UTF-8 safety":
    it "extracts a string value containing a multibyte char":
        val json = "{\"name\":\"caf\u{e9}\"}"
        assert_equal(_md_lsp_extract_field(json, "name"), "caf\u{e9}")

    it "extracts a nested object containing several multibyte codepoints (reproduces the bug)":
        val json = "{\"params\":{\"name\":\"caf\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\"},\"id\":1}"
        assert_equal(
            _md_lsp_extract_field(json, "params"),
            "{\"name\":\"caf\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\u{e9}\"}"
        )

    it "extracts a nested array containing a multibyte string element":
        val json = "{\"items\":[\"caf\u{e9}\",\"b\"],\"id\":2}"
        assert_equal(_md_lsp_extract_field(json, "items"), "[\"caf\u{e9}\",\"b\"]")

    it "extracts a plain ASCII number field unaffected":
        val json = "{\"id\":42}"
        assert_equal(_md_lsp_extract_field(json, "id"), "42")

    it "extracts a purely-multibyte string value":
        val json = "{\"name\":\"\u{e9}\u{e8}\u{ea}\"}"
        assert_equal(_md_lsp_extract_field(json, "name"), "\u{e9}\u{e8}\u{ea}")
