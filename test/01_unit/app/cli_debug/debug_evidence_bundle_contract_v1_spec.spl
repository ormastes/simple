"""
## Purpose and audience
Pins the on-disk contract a future debug-evidence-bundle WRITER must satisfy,
as enforced today by the existing READER
(`src/app/cli_debug/evidence_inspect_v1.spl`). There is no writer in this repo
yet -- this spec exists so a producer implemented later has an executable
target instead of a prose description that can drift. Audience: engineers
implementing the dump/evidence writer, and reviewers checking a bundle against
the contract documented in
`doc/07_guide/app/debug/debug_evidence_bundle_contract.md`.
## Operator workflow
/Users/ormastes/simple/src/compiler_rust/target/bootstrap/simple run test/01_unit/app/cli_debug/debug_evidence_bundle_contract_v1_spec.spl
## Compatibility and limitations
Exercises only the reader (`decode_debug_evidence_manifest_summary_v1`,
`inspect_debug_evidence_bundle_v1`). It does not exercise a writer -- none
exists. Each `it` asserts against the reader's real behaviour; if a rule is
found to be UNENFORCED, the corresponding assertion is left failing rather
than weakened (see `.claude/rules/testing.md`).
## Verification guidance and troubleshooting
A RED here after a reader-side change means the on-disk contract moved and
`doc/07_guide/app/debug/debug_evidence_bundle_contract.md` is now stale --
update the doc's file:line citations together with any intentional change.
"""
# Lifecycle: doc/02_requirements/feature/simple_unified_debugging_evidence.md ;
# doc/07_guide/app/debug/debug_evidence_bundle_contract.md
# @manual_section: primary

use std.spec.*
use app.cli_debug.evidence_inspect_v1.{
    decode_debug_evidence_manifest_summary_v1, inspect_debug_evidence_bundle_v1,
}

val VALID_DIGEST = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn minimal_valid_manifest_source() -> text:
    "schema: debug-evidence-bundle-v1\n" +
        "session_id: \"contract-session-1\"\n" +
        "build_id: \"sha256:" + VALID_DIGEST + "\"\n" +
        "captured_at_ns: 100\nartifacts:\n" +
        "  - path: \"normalized/events.sdn\"\n"

describe "debug evidence bundle contract (writer target)":

    it "accepts a hand-built minimal valid bundle":
        # @req REQ-014
        step("Point the reader at a hand-built minimal valid bundle on disk")
        val outcome = inspect_debug_evidence_bundle_v1(
            "test/fixtures/debug/evidence_bundle_contract_v1")
        step("Verify the bundle is accepted, not merely non-crashing")
        match outcome:
            case Err(reason): expect(reason).to_equal("")
            case Ok(inspection):
                expect(inspection.build_id).to_equal("sha256:" + VALID_DIGEST)
                expect(inspection.captured_at_ns).to_equal(100)

    it "rejects a manifest with the wrong schema string":
        # @req REQ-014
        step("Decode a manifest whose schema string is not the exact contract value")
        val source = minimal_valid_manifest_source().replace(
            "schema: debug-evidence-bundle-v1", "schema: debug-evidence-bundle-v2")
        val outcome = decode_debug_evidence_manifest_summary_v1(source)
        step("Verify rejection names the schema, not a generic parse failure")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("schema")

    it "rejects a manifest missing session_id":
        # @req REQ-014
        step("Decode a manifest whose session_id is empty")
        val source = minimal_valid_manifest_source().replace(
            "session_id: \"contract-session-1\"", "session_id: \"\"")
        val outcome = decode_debug_evidence_manifest_summary_v1(source)
        step("Verify rejection names the missing captured session identity")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("captured session identity")

    it "rejects a manifest with a malformed build_id":
        # @req REQ-014
        step("Decode a manifest whose build_id is not sha256:<64 lowercase hex>")
        val source = minimal_valid_manifest_source().replace(
            "build_id: \"sha256:" + VALID_DIGEST + "\"", "build_id: \"latest\"")
        val outcome = decode_debug_evidence_manifest_summary_v1(source)
        step("Verify rejection names the exact build id requirement")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("exact build id")

    it "rejects a manifest with a negative captured_at_ns":
        # @req REQ-014
        step("Decode a manifest whose captured_at_ns is negative")
        val source = minimal_valid_manifest_source().replace(
            "captured_at_ns: 100", "captured_at_ns: -1")
        val outcome = decode_debug_evidence_manifest_summary_v1(source)
        step("Verify rejection names the invalid capture time, not a crash")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("invalid capture time")

    it "rejects a bundle whose receipts.sdn digest does not match the manifest":
        # @req REQ-014
        step("Point the reader at a bundle whose receipts_digest is a well-formed but wrong sha256")
        val outcome = inspect_debug_evidence_bundle_v1(
            "test/fixtures/debug/evidence_bundle_contract_v1_bad_receipts_digest")
        step("Verify the digest mismatch is caught, not silently trusted")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("receipts digest mismatch")

    it "rejects a bundle whose artifact path escapes the bundle root with '..'":
        # @req REQ-014
        step("Point the reader at a bundle whose artifact path contains a '..' segment")
        val outcome = inspect_debug_evidence_bundle_v1(
            "test/fixtures/debug/evidence_bundle_contract_v1_bad_path")
        step("Verify the unsafe path is rejected before any file is opened")
        match outcome:
            case Ok(_): expect("accepted").to_equal("rejected")
            case Err(reason): expect(reason).to_contain("path is unsafe")
