use std.spec.{describe, it, expect}
use std.common.debug.contracts_v1.{DebugRootOperationV1, DebugPerturbationV1}
use app.cli_debug.commands.{sdb_command_contract_v1}

describe "interactive debug CLI DebugServiceV1 harmony":
    it "classifies execution, probes, inspection, and file loading":
        val (run_op, run_effect, _, run_changes) = sdb_command_contract_v1("run --flag")
        expect(run_op).to_equal(DebugRootOperationV1.Control)
        expect(run_effect).to_equal(DebugPerturbationV1.Stopping)
        expect(run_changes).to_equal(true)

        val (break_op, break_effect, _, break_changes) = sdb_command_contract_v1("break main")
        expect(break_op).to_equal(DebugRootOperationV1.Probe)
        expect(break_effect).to_equal(DebugPerturbationV1.Cooperative)
        expect(break_changes).to_equal(false)

        val (print_op, print_effect, _, print_changes) = sdb_command_contract_v1("print value")
        expect(print_op).to_equal(DebugRootOperationV1.Control)
        expect(print_effect).to_equal(DebugPerturbationV1.Mutating)
        expect(print_changes).to_equal(true)

        val (file_op, file_effect, _, file_changes) = sdb_command_contract_v1("file app.spl")
        expect(file_op).to_equal(DebugRootOperationV1.Inspect)
        expect(file_effect).to_equal(DebugPerturbationV1.Cooperative)
        expect(file_changes).to_equal(false)

    it "classifies watchpoints as probes and stepping as stopping control":
        val (watch_op, watch_effect, _, watch_changes) = sdb_command_contract_v1("watch counter")
        expect(watch_op).to_equal(DebugRootOperationV1.Probe)
        expect(watch_effect).to_equal(DebugPerturbationV1.Cooperative)
        expect(watch_changes).to_equal(false)

        val (step_op, step_effect, _, step_changes) = sdb_command_contract_v1("step")
        expect(step_op).to_equal(DebugRootOperationV1.Control)
        expect(step_effect).to_equal(DebugPerturbationV1.Stopping)
        expect(step_changes).to_equal(true)
