use std.spec.{describe, it, expect}
use std.io_runtime.{file_write}
use app.cli_debug.probe_executor_v1.{load_cli_debug_probe_profile_v1, execute_cli_debug_probe_v1}

val PROFILE = "/tmp/cli_debug_probe_executor_unit.sdn"

fn write_profile(session_id: text, kind: text, perturbation: text):
    file_write(PROFILE,
        "debug_probe:\n  schema: simple.debug-probe-profile/v1\n  session_id: " + session_id +
        "\n  build_id: sha256:unit\n  kind: " + kind +
        "\n  source_anchor: _start\n  perturbation: " + perturbation +
        "\n  expires_at_ns: -1\n")

describe "CLI debug probe profile and fail-closed context":
    it "decodes the exact native stop-probe contract":
        write_profile("dbg_unit", "stop", "stopping")
        match load_cli_debug_probe_profile_v1(PROFILE):
            case Err(reason): expect(reason).to_equal("")
            case Ok(profile):
                expect(profile.session_id).to_equal("dbg_unit")
                expect(profile.kind).to_equal("stop")
                expect(profile.source_anchor).to_equal("_start")

    it "denies unsupported probe kinds instead of claiming adapter support":
        write_profile("dbg_unit", "log", "passive")
        match load_cli_debug_probe_profile_v1(PROFILE):
            case Ok(_): expect("accepted").to_equal("denied")
            case Err(reason): expect(reason).to_contain("only native stop probes")

    it "denies a profile whose adapter session is unavailable":
        write_profile("missing_session", "stop", "stopping")
        match execute_cli_debug_probe_v1("apply", PROFILE):
            case Ok(_): expect("accepted").to_equal("denied")
            case Err(reason): expect(reason).to_contain("session is unavailable")
