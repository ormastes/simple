# Reproduce spec for:
#   doc/08_tracking/bug/test_runner_exits_zero_on_failed_spec_2026-08-21.md
#
# A run that failed a test must never be reported as OK, and a run that
# verified nothing must never be reported as OK either.

use app.test_daemon.light_protocol.{ran_verdict_line, verdict_outcome_token}
use std.test_runner.test_runner_types.{TestRunOutcome, test_run_outcome_exit_code}

describe "Spec verdict invariant":

    it "never reports OK for a file with failures":
        # Pre-fix the line carried no outcome token at all, and the seed's
        # emitter printed `outcome=OK` next to `failed=1`.
        val line = ran_verdict_line("test/example_spec.spl", 2, 1)
        expect(line).to_contain("outcome=ERROR")
        expect(line).to_contain("failed=1")
        expect(verdict_outcome_token(3, 1)).to_equal("ERROR")

    it "never reports OK for a file that verified nothing":
        expect(verdict_outcome_token(0, 0)).to_equal("NOT_RUN")
        val line = ran_verdict_line("test/empty_spec.spl", 0, 0)
        expect(line).to_contain("outcome=NOT_RUN")

    it "still reports OK for a genuinely passing file":
        expect(verdict_outcome_token(3, 0)).to_equal("OK")
        expect(ran_verdict_line("test/ok_spec.spl", 3, 0)).to_contain("outcome=OK")

    it "maps a failing outcome to a non-zero exit status":
        expect(test_run_outcome_exit_code(TestRunOutcome.AssertionOrChildFailure)).to_equal(1)
        expect(test_run_outcome_exit_code(TestRunOutcome.Unverified)).to_equal(5)
        expect(test_run_outcome_exit_code(TestRunOutcome.Pass)).to_equal(0)
