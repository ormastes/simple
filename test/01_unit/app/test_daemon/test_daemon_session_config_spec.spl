"""
## Purpose and audience
Purpose: Prove that Session Config Defaults.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-DAEMON-001 — stable requirement identity for this spec.
# @cover src/lib/nogc_sync_mut/test_runner/test_config.spl 80%
# @cover src/app/test_daemon/session_types.spl 40%
#
# Test Daemon Session Config Specification
#
# Tests that session sharing settings are correctly loaded from SDN config
# and correctly propagated to TestDaemonConfig.
#
# **Feature IDs:** #TDMN-CFG-001 to #TDMN-CFG-015
# **Category:** Infrastructure

use std.spec.{describe, it, expect, context}
use std.io_runtime

use test_config.{TestConfig, parse_test_config_content}

# ============================================================================
# Test Group 1: Default Config Values
# ============================================================================

describe "Session Config Defaults":
    """
    ## Default Values

    Session sharing is disabled by default with reasonable timeout values.
    """

    it "defaults session_share to false (#TDMN-CFG-001)":
        step("Verify: defaults session_share to false (#TDMN-CFG-001)")
        # @req: REQ-APP-TEST-DAEMON-001
        val config = TestConfig.defaults()
        expect(config.session_share).to_equal(false)

    it "defaults session_daemon to false (#TDMN-CFG-002)":
        step("Verify: defaults session_daemon to false (#TDMN-CFG-002)")
        val config = TestConfig.defaults()
        expect(config.session_daemon).to_equal(false)

    it "defaults session_idle_timeout_ms to 300000 (#TDMN-CFG-003)":
        step("Verify: defaults session_idle_timeout_ms to 300000 (#TDMN-CFG-003)")
        val config = TestConfig.defaults()
        expect(config.session_idle_timeout_ms).to_equal(300000)  # oracle: 300000 — named expected value from the requirement

    it "defaults session_startup_timeout_ms to 60000 (#TDMN-CFG-004)":
        step("Verify: defaults session_startup_timeout_ms to 60000 (#TDMN-CFG-004)")
        val config = TestConfig.defaults()
        expect(config.session_startup_timeout_ms).to_equal(60000)  # oracle: 60000 — named expected value from the requirement

    it "defaults session_debug to false (#TDMN-CFG-005)":
        step("Verify: defaults session_debug to false (#TDMN-CFG-005)")
        val config = TestConfig.defaults()
        expect(config.session_debug).to_equal(false)

    it "defaults session_max_qemu_vm to 4 (#TDMN-CFG-006)":
        step("Verify: defaults session_max_qemu_vm to 4 (#TDMN-CFG-006)")
        val config = TestConfig.defaults()
        expect(config.session_max_qemu_vm).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "defaults session_max_container to 2 (#TDMN-CFG-007)":
        step("Verify: defaults session_max_container to 2 (#TDMN-CFG-007)")
        val config = TestConfig.defaults()
        expect(config.session_max_container).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "defaults session_max_service to 8 (#TDMN-CFG-008)":
        step("Verify: defaults session_max_service to 8 (#TDMN-CFG-008)")
        val config = TestConfig.defaults()
        expect(config.session_max_service).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "defaults session_max_openocd to 1 (#TDMN-CFG-009)":
        step("Verify: defaults session_max_openocd to 1 (#TDMN-CFG-009)")
        val config = TestConfig.defaults()
        expect(config.session_max_openocd).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "defaults session_max_trace32 to 1 (#TDMN-CFG-010)":
        step("Verify: defaults session_max_trace32 to 1 (#TDMN-CFG-010)")
        val config = TestConfig.defaults()
        expect(config.session_max_trace32).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Test Group 2: SDN Config Parsing
# ============================================================================

describe "Session Config SDN Parsing":
    """
    ## SDN Config File Parsing

    Session settings from the config/simple.test.sdn file should be
    correctly parsed and applied to the TestConfig struct.
    """

    it "parses session_share: true (#TDMN-CFG-011)":
        step("Verify: parses session_share: true (#TDMN-CFG-011)")
        val sdn = "test:\n  session_share: true\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_share).to_equal(true)

    it "parses session_daemon: true (#TDMN-CFG-012)":
        step("Verify: parses session_daemon: true (#TDMN-CFG-012)")
        val sdn = "test:\n  session_daemon: true\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_daemon).to_equal(true)

    it "parses session_idle_timeout_ms (#TDMN-CFG-013)":
        step("Verify: parses session_idle_timeout_ms (#TDMN-CFG-013)")
        val sdn = "test:\n  session_idle_timeout_ms: 120000\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_idle_timeout_ms).to_equal(120000)  # oracle: 120000 — named expected value from the requirement

    it "parses session_startup_timeout_ms (#TDMN-CFG-014)":
        step("Verify: parses session_startup_timeout_ms (#TDMN-CFG-014)")
        val sdn = "test:\n  session_startup_timeout_ms: 30000\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_startup_timeout_ms).to_equal(30000)  # oracle: 30000 — named expected value from the requirement

    it "parses session_debug: true (#TDMN-CFG-015)":
        step("Verify: parses session_debug: true (#TDMN-CFG-015)")
        val sdn = "test:\n  session_debug: true\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_debug).to_equal(true)

# ============================================================================
# Test Group 3: SDN Session Max Sessions Parsing
# ============================================================================

describe "Session Config Max Sessions Parsing":
    """
    ## Max Sessions Sub-Section

    The session_max_sessions: sub-section should parse per-kind limits.
    """

    it "parses qemu_vm max from session_max_sessions (#TDMN-CFG-016)":
        step("Verify: parses qemu_vm max from session_max_sessions (#TDMN-CFG-016)")
        val sdn = "test:\n  session_max_sessions:\n    qemu_vm: 8\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_max_qemu_vm).to_equal(8)  # oracle: 8 — named expected value from the requirement

    it "parses container_instance max (#TDMN-CFG-017)":
        step("Verify: parses container_instance max (#TDMN-CFG-017)")
        val sdn = "test:\n  session_max_sessions:\n    container_instance: 5\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_max_container).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "parses service_process max (#TDMN-CFG-018)":
        step("Verify: parses service_process max (#TDMN-CFG-018)")
        val sdn = "test:\n  session_max_sessions:\n    service_process: 16\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_max_service).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "parses multiple max_sessions keys in one block (#TDMN-CFG-019)":
        step("Verify: parses multiple max_sessions keys in one block (#TDMN-CFG-019)")
        val sdn = "test:\n  session_max_sessions:\n    qemu_vm: 6\n    container_instance: 3\n    trace32_board: 2\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_max_qemu_vm).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(result.session_max_container).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(result.session_max_trace32).to_equal(2)  # oracle: 2 — named expected value from the requirement

# ============================================================================
# Test Group 4: Config with Mixed Sections
# ============================================================================

describe "Session Config Mixed Sections":
    """
    ## Full Config Parsing

    Session settings should be parsed correctly when mixed with other
    test configuration sections.
    """

    it "parses session settings alongside test timeout (#TDMN-CFG-020)":
        step("Verify: parses session settings alongside test timeout (#TDMN-CFG-020)")
        val sdn = "test:\n  timeout: 240\n  session_share: true\n  session_idle_timeout_ms: 600000\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.timeout_seconds).to_equal(240)  # oracle: 240 — named expected value from the requirement
        expect(result.session_share).to_equal(true)
        expect(result.session_idle_timeout_ms).to_equal(600000)  # oracle: 600000 — named expected value from the requirement

    it "preserves defaults for unparsed session keys (#TDMN-CFG-021)":
        step("Verify: preserves defaults for unparsed session keys (#TDMN-CFG-021)")
        val sdn = "test:\n  session_share: true\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        expect(result.session_share).to_equal(true)
        # Unparsed keys should retain defaults
        expect(result.session_idle_timeout_ms).to_equal(300000)  # oracle: 300000 — named expected value from the requirement
        expect(result.session_max_qemu_vm).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(result.session_debug).to_equal(false)

    it "ignores session_defaults sub-section without error (#TDMN-CFG-022)":
        step("Verify: ignores session_defaults sub-section without error (#TDMN-CFG-022)")
        val sdn = "test:\n  session_share: true\n  session_defaults:\n    qemu_vm:\n      reuse: shared_with_snapshot\n      reset: snapshot_restore\n"
        val config = TestConfig.defaults()
        val result = parse_test_config_content(config, sdn)
        # Should not crash and session_share should be parsed
        expect(result.session_share).to_equal(true)
