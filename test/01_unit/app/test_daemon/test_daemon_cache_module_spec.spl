# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec.{describe, it, expect, after_each}
use app.test_daemon.cache.{test_result_cache_new, test_result_cache_load}
use app.io.mod.{file_write, file_delete, file_exists, dir_create_all}

val daemon_cache_spec_root = "/tmp/simple_test_daemon_cache_spec"

fn daemon_cache_test_path(name: text) -> text:
    "{daemon_cache_spec_root}/{name}"

fn daemon_cache_cleanup():
    val paths = [
        daemon_cache_test_path("daemon_cache.sdn"),
        daemon_cache_test_path("sample_spec.spl"),
        daemon_cache_test_path("dep_a.spl")
    ]
    var i = 0
    while i < paths.len():
        if file_exists(paths[i]):
            file_delete(paths[i])
        i = i + 1

use std.spec.step

describe "TestDaemon cache module":
    after_each:
        daemon_cache_cleanup()

    it "persists cached output across save and load":
        # @req REQ-SSPEC-APP
        step("persists cached output across save and load")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        dir_create_all(daemon_cache_spec_root)
        val cache_path = daemon_cache_test_path("daemon_cache.sdn")
        val test_path = daemon_cache_test_path("sample_spec.spl")
        val dep_path = daemon_cache_test_path("dep_a.spl")

        file_write(test_path, "describe \"sample\":\n    it \"runs\":\n        expect(1).to_equal(1)\n")  # oracle: 1 — named expected value from the requirement
        file_write(dep_path, "dep-a")

        val cache = test_result_cache_new(cache_path)
        cache.record_result(test_path, [dep_path], 2, 1, 0, 0, 15, "line one\nline two")
        cache.save()

        val reloaded = test_result_cache_load(cache_path)
        val entry = reloaded.check_freshness(test_path, [dep_path])

        expect(entry.result_status).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(entry.result_output).to_equal("line one\nline two")
