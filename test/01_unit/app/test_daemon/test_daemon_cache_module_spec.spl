# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec.{describe, it, expect, after_each}
use app.test_daemon.cache.{test_result_cache_new, test_result_cache_load}
use app.io.mod.{file_write, file_delete, file_exists, dir_create_all, file_read_text}

val daemon_cache_spec_root = "/tmp/simple_test_daemon_cache_spec"

fn daemon_cache_test_path(name: text) -> text:
    "{daemon_cache_spec_root}/{name}"

fn daemon_cache_cleanup():
    val paths = [
        daemon_cache_test_path("daemon_cache.sdn"),
        daemon_cache_test_path("sample_spec.spl"),
        daemon_cache_test_path("dep_a.spl")
    ]
    var i = 0
    while i < paths.len():
        if file_exists(paths[i]):
            file_delete(paths[i])
        i = i + 1

use std.spec.step

describe "TestDaemon cache module":
    after_each:
        daemon_cache_cleanup()

    it "persists cached output across save and load":
        # @req REQ-SSPEC-APP
        step("persists cached output across save and load")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        dir_create_all(daemon_cache_spec_root)
        val cache_path = daemon_cache_test_path("daemon_cache.sdn")
        val test_path = daemon_cache_test_path("sample_spec.spl")
        val dep_path = daemon_cache_test_path("dep_a.spl")

        file_write(test_path, "describe \"sample\":\n    it \"runs\":\n        expect(1).to_equal(1)\n")  # oracle: 1 — named expected value from the requirement
        file_write(dep_path, "dep-a")

        val cache = test_result_cache_new(cache_path)
        cache.record_result(test_path, [dep_path], 2, 1, 0, 0, 15, "line one\nline two")
        cache.save()

        val reloaded = test_result_cache_load(cache_path)
        val entry = reloaded.check_freshness(test_path, [dep_path])

        expect(entry.result_status).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(entry.output).to_equal("line one\nline two")
        expect(entry.cached_at).to_be_greater_than(0)

    it "preserves pipes, newlines, carriage returns, and backslashes across save and load":
        # @req REQ-SSPEC-APP
        step("preserves delimiter and newline characters in cached output")
        dir_create_all(daemon_cache_spec_root)
        val cache_path = daemon_cache_test_path("daemon_cache.sdn")
        val test_path = daemon_cache_test_path("sample_spec.spl")
        val dep_path = daemon_cache_test_path("dep_a.spl")

        file_write(test_path, "describe \"sample\":\n    it \"runs\":\n        expect(1).to_equal(1)\n")
        file_write(dep_path, "dep-a")

        val tricky_output = "col1|col2\nline2\\n\\p|end\r\n\\\\trailing\\"
        val cache = test_result_cache_new(cache_path)
        cache.record_result(test_path, [dep_path], 3, 1, 2, 0, 42, tricky_output)
        cache.save()

        val reloaded = test_result_cache_load(cache_path)
        val entry = reloaded.check_freshness(test_path, [dep_path])

        expect(entry.result_status).to_equal(3)
        expect(entry.passed).to_equal(1)
        expect(entry.failed).to_equal(2)
        expect(entry.output).to_equal(tricky_output)

    it "invalidates stale version:3 cache files and marks misses with result_status -1":
        # @req REQ-SSPEC-APP
        step("rejects version:3 cache payloads and flags uncached lookups as result_status -1")
        dir_create_all(daemon_cache_spec_root)
        val cache_path = daemon_cache_test_path("daemon_cache.sdn")
        val test_path = daemon_cache_test_path("sample_spec.spl")
        val dep_path = daemon_cache_test_path("dep_a.spl")

        file_write(test_path, "describe \"sample\":\n    it \"runs\":\n        expect(1).to_equal(1)\n")
        file_write(dep_path, "dep-a")
        file_write(cache_path, "version:3\n{test_path}|fakehash|0|1|0|0|10|1000\n")

        val reloaded = test_result_cache_load(cache_path)
        val entry = reloaded.check_freshness(test_path, [dep_path])

        expect(entry.test_path).to_equal(test_path)
        expect(entry.result_status).to_equal(-1)
        val daemon_src = file_read_text("src/app/test_daemon/daemon.spl") ?? ""
        expect(daemon_src).to_contain("cached.result_status != -1")
        expect(daemon_src.contains("cached.test_path != \"\"")).to_be(false)
