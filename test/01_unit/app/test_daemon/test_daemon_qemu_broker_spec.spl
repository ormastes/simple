"""
## Purpose and audience
Purpose: Prove that QemuBroker.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-DAEMON-001 — stable requirement identity for this spec.
use std.spec.{describe, it, expect}
use app.test_daemon.qemu_broker.{qemu_broker_new, QEMU_IDLE, QEMU_IN_USE}

describe "QemuBroker":
    it "creates a new session on first acquire":
        step("Verify: creates a new session on first acquire")
        # @req: REQ-APP-TEST-DAEMON-001
        val broker = qemu_broker_new(4)
        val session = broker.acquire("arm64", "/bin/test-a")
        expect(session.arch).to_equal("arm64")
        expect(session.status).to_equal(QEMU_IN_USE)
        expect(broker.active_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(broker.idle_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reuses an idle session with the same key":
        step("Verify: reuses an idle session with the same key")
        val broker = qemu_broker_new(4)
        val s1 = broker.acquire("arm64", "/bin/test-a")
        broker.release(s1.session_key)
        val s2 = broker.acquire("arm64", "/bin/test-a")

        expect(s2.session_key).to_equal(s1.session_key)
        expect(s2.test_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(broker.active_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "creates separate sessions for different binaries or architectures":
        step("Verify: creates separate sessions for different binaries or architectures")
        val broker = qemu_broker_new(4)
        val a = broker.acquire("arm64", "/bin/test-a")
        val b = broker.acquire("arm64", "/bin/test-b")
        val c = broker.acquire("riscv64", "/bin/test-a")

        expect(a.session_key != b.session_key).to_equal(true)
        expect(a.session_key != c.session_key).to_equal(true)
        expect(broker.active_count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "marks released sessions idle":
        step("Verify: marks released sessions idle")
        val broker = qemu_broker_new(4)
        val session = broker.acquire("arm64", "/bin/test-a")
        broker.release(session.session_key)

        expect(broker.active_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(broker.idle_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(broker.sessions[0].status).to_equal(QEMU_IDLE)

    it "evicts the oldest idle session when at limit":
        step("Verify: evicts the oldest idle session when at limit")
        val broker = qemu_broker_new(2)
        val s1 = broker.acquire("a", "/bin/a")
        broker.release(s1.session_key)
        val s2 = broker.acquire("b", "/bin/b")
        broker.release(s2.session_key)

        broker.acquire("c", "/bin/c")
        expect(broker.sessions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "cleans up idle sessions and can shut down all":
        step("Verify: cleans up idle sessions and can shut down all")
        val broker = qemu_broker_new(4)
        val s1 = broker.acquire("arm64", "/bin/test-a")
        broker.release(s1.session_key)
        broker.cleanup_idle(0)
        expect(broker.sessions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        broker.acquire("x", "/bin/x")
        broker.acquire("y", "/bin/y")
        expect(broker.sessions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        broker.shutdown_all()
        expect(broker.sessions.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
