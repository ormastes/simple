# @req: REQ-APP-MCPUNIT-001

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use app.mcp.cli_passthrough (_cli_args_for_name, _cli_positional_error, _parse_positive_int_or_zero)
use app.mcp.main_lazy_json.{_mcp_normalize_process_exit}

use std.spec.step

describe "MCP CLI argv passthrough":
    it "keeps public path and query metacharacters as literal argv values":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: keeps public path and query metacharacters as literal argv values")
        val path_args = _cli_args_for_name("check", "{\"path\":\"/tmp/a;touch nope\"}", "simple_check")
        val query_args = _cli_args_for_name("query ast-query", "{\"query\":\"name; touch nope\",\"files\":\"src/*.spl\"}", "simple_ast_query")

        expect(path_args).to_equal(["check", "/tmp/a;touch nope"])
        expect(query_args).to_equal(["query", "ast-query", "name; touch nope", "src/*.spl"])

    it "rejects timeout values that could disable the outer deadline":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: rejects timeout values that could disable the outer deadline")
        expect(_parse_positive_int_or_zero("86400")).to_equal(86400)  # oracle: 86400 — named expected value from the requirement
        expect(_parse_positive_int_or_zero("86401")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_parse_positive_int_or_zero("9223372036854775807")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_mcp_normalize_process_exit(-1, "[TIMEOUT: Process killed after 10ms]")).to_equal(124)  # oracle: 124 — named expected value from the requirement
        expect(_mcp_normalize_process_exit(0, "[TIMEOUT: Process killed after 10ms]")).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects positional child-option injection":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: rejects positional child-option injection")
        expect(_cli_positional_error("{\"path\":\"-delete\"}", "simple_check")).to_contain("option-like")
        expect(_cli_positional_error("{\"query\":\"-exec\"}", "simple_ast_query")).to_contain("option-like")
        expect(_cli_positional_error("{\"package\":\"--help\"}", "simple_remove")).to_contain("option-like")
        expect(_cli_positional_error("{\"filter\":\"-slow\"}", "simple_test")).to_equal("")

    it "maps the complete SSpec maintenance request as literal argv":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: maps the complete SSpec maintenance request as literal argv")
        val body = "{\"operation\":\"scan\",\"path\":\"test/a spec.spl\"," +
            "\"format\":\"sarif\",\"min_score\":\"80\"," +
            "\"deny_severity\":\"warning\",\"baseline\":\"base.txt\"," +
            "\"suppressions\":\"suppress.txt\",\"rule\":\"SSDOC-NAR-001\"," +
            "\"no_cache\":true,\"debug_timings\":true}"
        expect(_cli_args_for_name("sspec-maintain", body,
            "simple_sspec_maintain")).to_equal([
                "sspec-maintain", "scan", "test/a spec.spl", "--format",
                "sarif", "--min-score", "80", "--deny-severity", "warning",
                "--baseline", "base.txt", "--suppressions", "suppress.txt",
                "--rule", "SSDOC-NAR-001", "--no-cache", "--debug-timings"])
        expect(_cli_positional_error(
            "{\"operation\":\"--help\",\"path\":\"test/a.spl\"}",
            "simple_sspec_maintain")).to_contain("option-like")

    it "does not route passthrough request fields through a shell":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: does not route passthrough request fields through a shell")
        val source = file_read("src/app/mcp/cli_passthrough.spl")

        expect(source).to_contain("mcp_run_argv(_bin, args, effective_timeout_s * 1000, 1048576)")
        expect(source.contains("shell_cmd")).to_equal(false)

    it "maps the read-only SSpec scan tool without a mutable operation field":
        # @req: REQ-APP-MCPUNIT-001
        step("Verify: maps the read-only SSpec scan tool without a mutable operation field")
        val body = "{\"path\":\"test/features\",\"format\":\"json\"," +
            "\"rule\":\"SSDOC-ORA-001\",\"no_cache\":true}"
        expect(_cli_args_for_name("sspec-maintain", body,
            "simple_sspec_scan")).to_equal(["sspec-maintain", "scan",
                "test/features", "--format", "json", "--rule",
                "SSDOC-ORA-001", "--no-cache"])
