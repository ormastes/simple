# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.io_runtime.{file_read}
use app.mcp.main_lazy_diag_tools.{handle_simple_api}

extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_getpid() -> i64

use std.spec.step

describe "MCP diagnostic argv contract":
    it "does not execute diagnostic API query as shell syntax":
        # @req REQ-SSPEC-APP
        step("send a query containing shell metacharacters")
        val sentinel = "/tmp/simple_mcp_diag_argv_injection_" + str(rt_getpid())
        val _ = rt_file_delete(sentinel)
        val body = "{\"query\":\"absent; touch " + sentinel + "\"}"

        val result = handle_simple_api("1", body)

        val injected = rt_file_exists(sentinel)
        if injected:
            val _ = rt_file_delete(sentinel)
        expect(rt_file_exists(sentinel)).to_equal(false)
        step("The query reached grep as a literal argv pattern, not shell text")
        expect(result).to_contain("-- simple_api")
        expect(result).to_contain("No results found.")

    it "rejects option-like status directories before find":
        # @req REQ-SSPEC-APP
        step("request a status scan of an option-like directory")
        val result = handle_simple_status("2", "{\"paths\":\"\", \"directory\":\"-evil\"}")
        step("confirm the request is rejected with -32602")
        expect(result).to_contain("-32602")
        expect(result).to_contain("option-like paths are not allowed")

    it "routes request-derived diagnostics through argv":
        # @req REQ-SSPEC-APP
        step("request an API query routed through the grep argv pipeline")
        val result = handle_simple_api("3", "{\"query\":\"option-like paths are not allowed\"}")
        step("confirm the query reached grep as one argv token and matched the source file")
        expect(result.find("main_lazy_diag_tools.spl") ?? -1).to_be_greater_than(-1)
        val source = file_read("src/app/mcp/main_lazy_diag_tools.spl")
        expect(source).to_contain('scan_dir.starts_with("-")')
        expect(source).to_contain("option-like paths are not allowed")
        val source = file_read("src/app/mcp/main_lazy_diag_tools.spl")

        step("A module search runs find+grep as argv and returns symbol lines")
        val module_result = handle_simple_api("3", "{\"module\":\"main_lazy_diag_tools\"}")
        expect(module_result).to_contain("module=main_lazy_diag_tools")
        expect(module_result).to_contain("src/app/mcp/main_lazy_diag_tools.spl")
