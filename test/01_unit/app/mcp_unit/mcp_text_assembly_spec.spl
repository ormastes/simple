# @feature: compiler-performance-memory-efficiency
# @req: REQ-APP-MCPUNIT-001

use std.spec.*
use std.string_core.{char_from_code}
use app.mcp.main_lazy_query_tools.{
    _mcp_json_escape as _app_mcp_json_escape, _mcp_first_lines}
use std.nogc_async_mut.mcp.main_lazy_query_tools.{
    _mcp_json_escape as _std_mcp_json_escape}

fn _expect_mcp_escape(value: text, expected: text):
    expect(_app_mcp_json_escape(value)).to_equal(expected)
    expect(_std_mcp_json_escape(value)).to_equal(expected)

describe "MCP bounded text assembly":
    it "escapes JSON delimiters without corrupting Unicode":
        _expect_mcp_escape("", "")
        _expect_mcp_escape("plain", "plain")
        _expect_mcp_escape("é漢🙂", "é漢🙂")
        _expect_mcp_escape("a\\\"\nb", "a\\\\\\\"\\nb")

    it "retains the historical raw control-character policy":
        _expect_mcp_escape("a\tb\rc", "a\tb\rc")
        val nul = char_from_code(0)
        val backspace = char_from_code(8)
        val form_feed = char_from_code(12)
        _expect_mcp_escape(nul, nul)
        _expect_mcp_escape(backspace, backspace)
        _expect_mcp_escape(form_feed, form_feed)

    it "preserves empty and nonpositive first-line limits":
        expect(_mcp_first_lines("", 3)).to_equal("")
        expect(_mcp_first_lines("a\nb", 0)).to_equal("")
        expect(_mcp_first_lines("a\nb", -1)).to_equal("")

    it "preserves truncation and trailing-newline edge behavior":
        expect(_mcp_first_lines("a", 1)).to_equal("a")
        expect(_mcp_first_lines("a\nb", 1)).to_equal("a\n")
        expect(_mcp_first_lines("\n", 1)).to_equal("")
        expect(_mcp_first_lines("a\n", 2)).to_equal("a\n\n")
        expect(_mcp_first_lines("\n", 2)).to_equal("\n\n")
        expect(_mcp_first_lines("\n\n", 2)).to_equal("\n\n")
        expect(_mcp_first_lines("a\nb", 2)).to_equal("a\nb")
