# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec
use std.io_runtime.{file_read}
use app.mcp.main_lazy_json.{mcp_run_argv}
use app.mcp.main_lazy_query_tools.{handle_simple_search, _mcp_public_api_change_details}

extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_getpid() -> i64

use std.spec.step

describe "MCP argv query contract":
    it "reports declaration reordering and real API changes separately":
        # @req REQ-SSPEC-APP
        step("reports declaration reordering and real API changes separately")
        val reordered = _mcp_public_api_change_details(
            ["fn first()", "fn second()"],
            ["fn second()", "fn first()"])
        val changed = _mcp_public_api_change_details(
            ["fn old()", "class Kept"],
            ["fn new()", "class Kept"])

        expect(reordered).to_equal("(declaration order changed)\n")
        expect(changed).to_contain("- fn old()")
        expect(changed).to_contain("+ fn new()")
        expect(changed.contains("class Kept")).to_equal(false)

    it "does not execute a search query as shell syntax":
        # @req REQ-SSPEC-APP
        step("does not execute a search query as shell syntax")
        val sentinel = "/tmp/simple_mcp_query_argv_injection_" + str(rt_getpid())
        val _ = rt_file_delete(sentinel)
        val body = "{\"query\":\"needle'; touch " + sentinel + "; echo '\",\"file\":\"/tmp/no-such-simple-mcp-file\"}"

        val _result = handle_simple_search("1", body)

        val injected = rt_file_exists(sentinel)
        if injected:
            val _ = rt_file_delete(sentinel)
        expect(injected).to_equal(false)

    it "runs literal argv and normalizes bounded timeouts":
        # @req REQ-SSPEC-APP
        step("runs literal argv and normalizes bounded timeouts")
        val (output, exit_code) = mcp_run_argv(
            "/usr/bin/printf", ["%s", "argv;not-shell"], 5000, 4096)
        val (_timeout_output, timeout_code) = mcp_run_argv(
            "/bin/sh", ["-c", "sleep 1"], 10, 4096)

        expect(output).to_equal("argv;not-shell")
        expect(exit_code).to_equal(0)
        expect(timeout_code).to_equal(124)

    it "keeps the bounded argv helper defined and exported by its owner":
        # @req REQ-SSPEC-APP
        step("keeps the bounded argv helper defined and exported by its owner")
        val source = file_read("src/app/mcp/main_lazy_json.spl")

        expect(source).to_contain("fn mcp_run_argv(")
        expect(source).to_contain("process_run_bounded(")
        expect(source).to_contain(
            "export first_n_chars, strip_ansi, shell_cmd, mcp_run_argv")

    it "keeps every argv consumer bound to the canonical bounded owner":
        # @req REQ-SSPEC-APP
        step("keeps every argv consumer bound to the canonical bounded owner")
        for path in [
            "src/app/mcp/main_dispatch_core.spl",
            "src/app/mcp/main_lazy_node_tools.spl",
            "src/app/mcp/main_lazy_query_tools.spl"
        ]:
            val source = file_read(path)
            expect(source).to_contain("main_lazy_json.{")
            expect(source).to_contain("mcp_run_argv")

    it "truncates tool output at the argv helper line budget":
        # @req REQ-SSPEC-APP
        step("truncates tool output at the argv helper line budget")
        var lines: [text] = []
        var i = 0
        while i < 60:
            if i == 0:
                lines.push("FIRSTLINE")
            elif i == 49:
                lines.push("LASTKEPT")
            elif i == 50:
                lines.push("FIRSTDROPPED")
            else:
                lines.push("filler " + str(i))
            i = i + 1
        val out = _mcp_first_lines(lines.join("\n"), 50)
        expect(out).to_contain("FIRSTLINE")
        expect(out).to_contain("LASTKEPT")
        expect(out.contains("FIRSTDROPPED")).to_equal(false)
