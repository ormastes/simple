use std.spec.{describe, it, expect}
use app.mcp.main_lazy_protocol.{handle_resources_read}

describe "Lazy MCP project info":
    it "encodes a single newline before the working directory":
        val response = handle_resources_read("17", "project:///info")
        expect(response).to_contain("Simple MCP (main_lazy)\\nWorking Dir: ")
