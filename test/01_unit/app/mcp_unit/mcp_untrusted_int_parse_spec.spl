# Untrusted numeric text must reach the documented default, not a lenient prefix.
# `to_int()` is lenient (0 / leading digits), so `to_int() ?? default` never
# defaulted; MCP request params use the optional `parse_int()`.
# @req REQ-SSPEC-APP

use std.spec.{describe, it, expect}
use app.mcp.main_lazy_node_tools.{_node_repl_timeout_ms}

describe "mcp untrusted integer params":
    it "uses the default timeout when timeout_ms has trailing garbage":
        expect(_node_repl_timeout_ms("{\"timeout_ms\":\"5000ms\"}")).to_equal(_node_repl_timeout_ms("{}"))

    it "honours a well-formed timeout_ms":
        expect(_node_repl_timeout_ms("{\"timeout_ms\":\"1234\"}")).to_equal(1234)
