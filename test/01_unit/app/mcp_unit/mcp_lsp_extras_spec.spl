        val params = ["file"]
        expect(params.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(params[0]).to_equal("file")

    it "dispatch entries added for all 4 tools":
        # @req: REQ-APP-MCPUNIT-001
