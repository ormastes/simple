use std.spec.*
use std.io_runtime.{file_read}

describe "project MCP configuration":
    it "uses checkout-relative native server paths":
        val config = file_read(".mcp.json")

        expect(config).to_contain("\"cwd\": \".\"")
        expect(config).to_contain("$PWD/bin/simple_mcp_server")
        expect(config).to_contain("$PWD/bin/simple_lsp_mcp_server")
        expect(config).to_contain("\"SIMPLE_LIB\": \"src\"")
        expect(config.contains("src/app/mcp/main.spl")).to_equal(false)
        expect(config.contains("src/app/simple_lsp_mcp/main.spl")).to_equal(false)
        expect(config.contains("/home/ormastes/")).to_equal(false)
        expect(config.contains("/Users/ormastes/")).to_equal(false)

    it "keeps the installer from restoring source or machine-specific project launchers":
        val installer = file_read("config/mcp/install.shs")

        expect(installer).to_contain("SIMPLE_MCP_LAUNCH=\"exec")
        expect(installer).to_contain("SIMPLE_LSP_MCP_LAUNCH=\"exec")
        expect(installer).to_contain("STITCH_LAUNCH=\"exec node")
        expect(installer).to_contain("$PWD/bin/simple_mcp_server")
        expect(installer).to_contain("$PWD/bin/simple_lsp_mcp_server")
        expect(installer).to_contain("\"cwd\": \".\"")
        expect(installer).to_contain("\"SIMPLE_LIB\": \"src\"")
