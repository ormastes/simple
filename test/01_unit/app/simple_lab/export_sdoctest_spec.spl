# @req: REQ-APP-SIMPLELAB-001

# Tests for the notebook -> SDoctest exporter (src/app/simple_lab/export_sdoctest.spl)

use std.nogc_sync_mut.notebook.ipynb.{NbNotebook, NbCell, NbOutput, ipynb_serialize}
use app.simple_lab.export_sdoctest.{nb_to_sdoctest_markdown, export_notebook_file}
use std.io.{file_write, file_read}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.test_runner.sdoctest.extractor.{extract_blocks_from_content}
use std.common.spec.evidence.untyped_capture.{UntypedCapture, untyped_capture_to_canonical}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

val FIXTURE_DIR = "test/01_unit/app/simple_lab/fixtures"
val FIXTURE_IPYNB = "{FIXTURE_DIR}/hello.ipynb"
val FIXTURE_SDOCTEST_MD = "{FIXTURE_DIR}/hello_sdoctest.md"

fn make_hello_notebook() -> NbNotebook:
    val markdown_cell = NbCell(
        cell_type: "markdown",
        metadata_json: "{}",
        source: "# Hello, Simple Lab\n\nA minimal notebook used to verify the sdoctest exporter.",
        has_execution_count: false,
        execution_count: -1,
        outputs: []
    )
    val stream_output = NbOutput(
        output_type: "stream",
        stream_name: "stdout",
        text: "Hello, Simple Lab!\n",
        metadata_json: "{}",
        ename: "",
        evalue: "",
        traceback: ""
    )
    val code_cell = NbCell(
        cell_type: "code",
        metadata_json: "{}",
        source: "print(\"Hello, Simple Lab!\")",
        has_execution_count: true,
        execution_count: 1,
        outputs: [stream_output]
    )
    NbNotebook(nbformat_minor: 5, metadata_json: "{}", cells: [markdown_cell, code_cell])

use std.spec.step

describe "nb_to_sdoctest_markdown":
    it "passes markdown cells through unchanged":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: passes markdown cells through unchanged")
        val nb = make_hello_notebook()
        val md = nb_to_sdoctest_markdown(nb)
        expect(md).to_contain("# Hello, Simple Lab")

    it "wraps code cells in an sdoctest fence with prompted source lines":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: wraps code cells in an sdoctest fence with prompted source lines")
        val nb = make_hello_notebook()
        val md = nb_to_sdoctest_markdown(nb)
        expect(md).to_contain("```sdoctest")
        expect(md).to_contain(">>> print(\"Hello, Simple Lab!\")")
        expect(md).to_contain("```")

    it "includes the captured output beneath the prompt":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: includes the captured output beneath the prompt")
        val nb = make_hello_notebook()
        val md = nb_to_sdoctest_markdown(nb)
        expect(md).to_contain("Hello, Simple Lab!")

describe "exported fences round-trip through the real sdoctest extractor":
    it "recovers a single-line code cell's source exactly":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: recovers a single-line code cell's source exactly")
        val cell = NbCell(
            cell_type: "code",
            metadata_json: "{}",
            source: "print(\"Hello, Simple Lab!\")",
            has_execution_count: true,
            execution_count: 1,
            outputs: []
        )
        val nb = NbNotebook(nbformat_minor: 5, metadata_json: "{}", cells: [cell])
        val md = nb_to_sdoctest_markdown(nb)
        val blocks = extract_blocks_from_content(md, "x.md")
        expect(blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(blocks[0].code).to_equal(cell.source)

    it "recovers a multi-line code cell's source, including indentation and a blank line":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: recovers a multi-line code cell's source, including indentation and a blank line")
        val multiline_source = "if 1 > 0:\n    print(\"yes\")\n\nprint(\"done\")"
        val cell = NbCell(
            cell_type: "code",
            metadata_json: "{}",
            source: multiline_source,
            has_execution_count: true,
            execution_count: 1,
            outputs: []
        )
        val nb = NbNotebook(nbformat_minor: 5, metadata_json: "{}", cells: [cell])
        val md = nb_to_sdoctest_markdown(nb)
        val blocks = extract_blocks_from_content(md, "x.md")
        expect(blocks.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(blocks[0].code).to_equal(multiline_source)

    it "marks an errored cell should_fail so the exported doc still has a real verdict":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: marks an errored cell should_fail so the exported doc still has a real verdict")
        val error_output = NbOutput(
            output_type: "error",
            stream_name: "",
            text: "",
            metadata_json: "{}",
            ename: "ValueError",
            evalue: "boom",
            traceback: ""
        )
        val cell = NbCell(
            cell_type: "code",
            metadata_json: "{}",
            source: "raise_boom()",
            has_execution_count: true,
            execution_count: 1,
            outputs: [error_output]
        )
        val nb = NbNotebook(nbformat_minor: 5, metadata_json: "{}", cells: [cell])
        val md = nb_to_sdoctest_markdown(nb)
        expect(md).to_contain("```sdoctest:should_fail")

describe "export_notebook_file (hello fixture, end to end)":
    it "writes the hello-world fixture notebook":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: writes the hello-world fixture notebook")
        val nb = make_hello_notebook()
        val ipynb_text = ipynb_serialize(nb)
        val wrote = file_write(FIXTURE_IPYNB, ipynb_text)
        expect(wrote).to_equal(true)

    it "exports the fixture to an sdoctest markdown file":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: exports the fixture to an sdoctest markdown file")
        val result = export_notebook_file(FIXTURE_IPYNB, FIXTURE_SDOCTEST_MD)
        match result:
            case Ok(_):
                pass_do_nothing
            case Err(msg):
                fail("expected export to succeed, got error: {msg}")
        val written = file_read(FIXTURE_SDOCTEST_MD)
        expect(written).to_contain("```sdoctest")

        val capture = UntypedCapture(label: "hello-sdoctest-md", raw_value: written, source_kind: "log_line")
        val evidence = untyped_capture_to_canonical(capture, "export_sdoctest_spec/hello-sdoctest-md")
        val comparison = compare_evidence(evidence, oracle_spec("export_sdoctest_spec/hello-sdoctest-md", [
            check_exact("value", "# Hello, Simple Lab\n\nA minimal notebook used to verify the sdoctest exporter.\n\n```sdoctest\n>>> print(\"Hello, Simple Lab!\")\nHello, Simple Lab!\n\n```")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)

    it "produces output that passes `simple test --sdoctest`":
        # @req: REQ-APP-SIMPLELAB-001
        step("Verify: produces output that passes simple test --sdoctest")
        val run_result = process_run_bounded("bin/simple", ["test", "--sdoctest", FIXTURE_SDOCTEST_MD], 30000, 65536)
        val stdout = run_result.0
        val stderr = run_result.1
        val exit_code = run_result.2
        if exit_code != 0:
            fail("bin/simple test --sdoctest {FIXTURE_SDOCTEST_MD} exited {exit_code}\nstdout: {stdout}\nstderr: {stderr}")
        expect(exit_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
