use app.io.mod.{file_read}
use std.spec.*

describe "Vulkan DrawIR native deployment gate":
    it "requires a usable self-hosted compiler before the expensive closure":
        val gate = file_read("scripts/check/build-vulkan-drawir-showcase-native.shs")

        expect(gate).to_contain("scripts/lib/simple-compiler-select.shs")
        expect(gate).to_contain("simple_compiler_usable \"$SIMPLE_BIN\"")
        expect(gate).to_contain("usable pure-Simple self-hosted compiler")
        expect(gate).to_contain("exit 6")

    it "uses the canonical Vulkan showcase closure with durable telemetry":
        val gate = file_read("scripts/check/build-vulkan-drawir-showcase-native.shs")

        expect(gate).to_contain("src/app/ui_showcase/hosts/main_2d_vulkan.spl")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/compiler\"")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/app\"")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/lib\"")
        expect(gate).to_contain("--entry-closure")
        expect(gate).to_contain("SIMPLE_COMPILER_PHASE_PROFILE_FILE")
        expect(gate).to_contain("SIMPLE_BUILD_PROGRESS_EVENTS")
        expect(gate).to_contain("SIMPLE_NATIVE_BUILD_TRACE_CLOSURE_TIMING=1")

    it "bounds worker lifetime and refuses fabricated deployment artifacts":
        val gate = file_read("scripts/check/build-vulkan-drawir-showcase-native.shs")

        expect(gate).to_contain("SIMPLE_VULKAN_DRAWIR_BUILD_BUDGET_SECONDS")
        expect(gate).to_contain("--timeout \"$BUDGET_SECONDS\"")
        expect(gate).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(gate).to_contain("stub functions for unresolved symbols")
        expect(gate).to_contain("[ ! -x \"$OUTPUT\" ]")
