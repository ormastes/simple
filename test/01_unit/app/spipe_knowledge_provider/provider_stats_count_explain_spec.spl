use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.service_limits.{provider_live_document_count_valid, provider_live_document_allocation_count, provider_candidate_document_allocation_available}
use app.spipe_knowledge_provider.durable_records.{ProviderCandidateV1}
use app.spipe_knowledge_provider.state.{SpipeProviderStateV1}
use app.spipe_knowledge_provider.wire_query.{wire_field_stats, wire_stats_supported_on_platform}
use app.spipe_knowledge_provider.query_clock.{FixedQueryClockV1}
use app.spipe_knowledge_provider.wire_core.{provider_initialize_result}
use std.common.search.document.{SearchDocument, SearchField}
use std.common.search.snapshot.{SearchSnapshot}
use std.common.search.query.{SearchQuery}
use std.common.search.analyzer.{AnalyzerIdentity}
use std.common.json.parser.{json_parse_with_error}
use app.spipe_knowledge_provider.wire_json.{wire_canonical_json_value}

fn initialized_service(documents: [SearchDocument]) -> SpipeProviderServiceV1:
    var service = SpipeProviderServiceV1.empty()
    service.state = SpipeProviderStateV1.initialized_bound(
        "WS-PROVIDER", "spks1-" + "0" * 64, "sha256:" + "1" * 64, 1,
        "sha256:" + "0" * 64,
        SearchSnapshot.of("spks1-" + "0" * 64, "r1",
            AnalyzerIdentity.spipe_v1(), documents),
        service.state.capabilities_value, [], false)
    service

fn allocation_candidate(uid: text, state_value: text,
                        documents: [SearchDocument]) -> ProviderCandidateV1:
    ProviderCandidateV1(uid: uid, base_root: "sha256:" + "0" * 64,
        candidate_root: "sha256:" + "2" * 64,
        candidate_root_preimage: "{}", apply_operation_id: "apply-" + uid,
        apply_payload_hash: "sha256:" + "3" * 64, apply_receipt: "receipt",
        created_at_ms: 1, expires_at_ms: 2, state: state_value,
        terminal_operation_id: "", terminal_receipt_kind: "",
        terminal_receipt: "", terminal_result_root: "", terminal_at_ms: 0,
        snapshot: SearchSnapshot.of("sha256:" + "2" * 64, "candidate",
            AnalyzerIdentity.spipe_v1(), documents), document_hashes: [],
        document_hash_preimages: [])

describe "SPipe provider statistics Count and exact explanation":
    it "uses the full live corpus denominator and emits only scoped fields":
        val documents = [
            SearchDocument.of("A-1", "r1", [
                SearchField.of("identifier", "alpha one", 4000),
                SearchField.of("body", "alpha beta", 1000),
            ], []),
            SearchDocument.of("A-2", "r1", [
                SearchField.of("identifier", "alpha", 4000),
            ], []),
            SearchDocument.of("A-3", "r1", [
                SearchField.of("identifier", "alpha", 4000),
                SearchField.of("body", "gamma", 1000),
            ], []),
        ]
        val service = initialized_service(documents)
        val stats = wire_field_stats(service, "REQ-STATS",
            -1, 0, FixedQueryClockV1.at(0))
        expect(stats).to_equal(Ok("[{\"N\":3,\"average_length_scaled\":1333333,\"field\":\"identifier\",\"total_length\":4},{\"N\":3,\"average_length_scaled\":1000000,\"field\":\"body\",\"total_length\":3}]"))
        expect(service.stats()).to_equal(Ok((3, "sha256:" + "0" * 64)))
        expect(service.wire_index_open("open", "sha256:" + "0" * 64)).to_equal(
            Ok(("sha256:" + "0" * 64, 3, "opened")))

    it "admits only Count values in the closed zero-to-one-million range":
        expect(provider_live_document_count_valid(-1)).to_equal(false)
        expect(provider_live_document_count_valid(0)).to_equal(true)
        expect(provider_live_document_count_valid(1000000)).to_equal(true)
        expect(provider_live_document_count_valid(1000001)).to_equal(false)

    it "accounts current and staged allocations atomically and releases terminal reservations":
        val one = SearchDocument.of("ALLOC-1", "r1", [
            SearchField.of("identifier", "allocation", 4000),
        ], [])
        val staged = allocation_candidate("C-STAGED", "staged", [one])
        val second = allocation_candidate("C-SECOND", "staged", [one])
        val terminal = allocation_candidate("C-TERMINAL", "expired", [one])
        expect(provider_live_document_allocation_count(999999,
            [staged])).to_equal(Ok(1000000))
        expect(provider_live_document_allocation_count(999999,
            [staged, second])).to_equal(Err("limit_exceeded"))
        expect(provider_candidate_document_allocation_available(999999,
            [], 1)).to_be(true)
        expect(provider_candidate_document_allocation_available(999999,
            [], 2)).to_be(false)
        expect(provider_live_document_allocation_count(999999,
            [terminal])).to_equal(Ok(999999))

    it "advertises the exact scope partition enum and platform-truthful stats":
        val initialized = provider_initialize_result(SpipeProviderServiceV1.empty(),
                                                     "REQ-CAP")
        val parsed = json_parse_with_error(initialized)
        expect(parsed.1).to_equal("")
        expect(wire_canonical_json_value(parsed.0)).to_equal(Ok(initialized))
        expect(initialized).to_contain("\"scope_partition\":\"independent\"")
        expect(wire_stats_supported_on_platform("linux")).to_equal(true)
        expect(wire_stats_supported_on_platform("macos")).to_equal(false)
        expect(wire_stats_supported_on_platform("windows")).to_equal(false)
        expect(wire_stats_supported_on_platform("freebsd")).to_equal(false)

    it "explains an exact matching document beyond the first thousand ranks":
        var documents: [SearchDocument] = []
        var i = 0
        while i < 1000:
            documents.push(SearchDocument.of("A-" + i.to_text(), "r1", [
                SearchField.of("body", "alpha", 1000),
            ], []))
            i = i + 1
        documents.push(SearchDocument.of("Z-LAST", "r1", [
            SearchField.of("body", "alpha", 1000),
        ], []))
        val service = initialized_service(documents)
        val query = SearchQuery.of("alpha", [], 1000, "", true)
        expect(service.explain_bounded("REQ-EXACT", query, "Z-LAST", -1, 0)).to_equal(
            Ok("Z-LAST"))
        val nonmatching = SearchQuery.of("beta", [], 1000, "", true)
        expect(service.explain_bounded("REQ-NOMATCH", nonmatching, "Z-LAST",
            -1, 0)).to_equal(Err("document_not_found"))
