use std.spec.{describe, it, expect}
use std.common.string_core.{text_to_bytes}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.json.serializer.{json_escape_string}
use app.spipe_knowledge_provider.query_clock.{FixedQueryClockV1, SteppingQueryClockV1}
use test.fixtures.spipe_controlled_work.controlled_work_proof.{proof_sha256_bytes_controlled, proof_sha256_text_compatibility, proof_json_escape_bytes_controlled}

describe "SPipe controlled-work proof imports":
    it "streams SHA-256 through reusable block primitives":
        val digest = proof_sha256_bytes_controlled(text_to_bytes("abc"),
            "REQ-HASH", 0, 1000, FixedQueryClockV1.at(1))
        expect(digest).to_equal(Ok(
            "ba7816bf8f01cfea414140de5dae2223" +
            "b00361a396177a9cb410ff61f20015ad"))

    it "keeps the compatibility text hash byte-identical":
        val digest = proof_sha256_text_compatibility("abc", "REQ-TEXT",
            0, 1000, FixedQueryClockV1.at(1))
        expect(digest).to_equal(Ok(
            "ba7816bf8f01cfea414140de5dae2223" +
            "b00361a396177a9cb410ff61f20015ad"))

    it "escapes JSON bytes and observes a deadline before work":
        val escaped = proof_json_escape_bytes_controlled(
            text_to_bytes("a\n\\\""), "REQ-ESCAPE", 0, 1000,
            FixedQueryClockV1.at(1))
        expect(escaped).to_equal(Ok("a\\n\\\\\\\""))
        val clock = SteppingQueryClockV1.configured(1, 1, -1, "")
        val stopped = proof_json_escape_bytes_controlled(
            text_to_bytes("payload"), "REQ-STOP", 0, 1, clock)
        expect(stopped).to_equal(Err("deadline_exceeded"))

    it "matches existing hash and JSON semantics at block boundaries":
        val values = ["a" * 55, "a" * 56, "a" * 63, "a" * 64,
                      "a" * 65]
        var i = 0
        while i < values.len():
            val bytes = text_to_bytes(values[i])
            val controlled = proof_sha256_bytes_controlled(bytes,
                "REQ-PARITY", 0, 1000, FixedQueryClockV1.at(1))
            expect(controlled).to_equal(Ok(sha256_u8_hex(bytes)))
            i = i + 1
        val json_value = "é" + "\b\f\n\r\t\\\""
        val escaped = proof_json_escape_bytes_controlled(
            text_to_bytes(json_value), "REQ-JSON-PARITY", 0, 1000,
            FixedQueryClockV1.at(1))
        expect(escaped).to_equal(Ok(json_escape_string(json_value)))

    it "checks within work and preserves the exact one-MiB admission cap":
        val clock = SteppingQueryClockV1.configured(0, 1, -1, "")
        val stopped = proof_sha256_bytes_controlled(
            text_to_bytes("a" * 4097), "REQ-QUANTUM", 0, 1, clock)
        expect(stopped).to_equal(Err("deadline_exceeded"))
        val at_limit = proof_sha256_bytes_controlled(
            text_to_bytes("a" * 1048576), "REQ-LIMIT", 0, 1,
            FixedQueryClockV1.at(1))
        expect(at_limit).to_equal(Err("deadline_exceeded"))
        val over_limit = proof_sha256_bytes_controlled(
            text_to_bytes("a" * 1048577), "REQ-LIMIT", 0, 1000,
            FixedQueryClockV1.at(1))
        expect(over_limit).to_equal(Err("limit_exceeded"))
