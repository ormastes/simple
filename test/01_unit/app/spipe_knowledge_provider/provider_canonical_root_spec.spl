use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use std.common.json.parser.{json_parse_with_error}
use std.common.json.serializer.{json_escape_string}
use std.common.search.document.{SearchDocument, SearchField, SearchFacet}
use std.common.search.snapshot.{SearchSnapshot}
use std.common.search.analyzer.{AnalyzerIdentity}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.state.{SpipeProviderStateV1, ProviderCapabilitiesV1}
use app.spipe_knowledge_provider.durable_records.{candidate_commitment_preimage, candidate_root_from_commitment, restore_document}
use app.spipe_knowledge_provider.wire_core.{_success, _success_receipt, _scoped_document_hash, _decode_document}

fn canonical_document() -> SearchDocument:
    SearchDocument.of("DOC-CANONICAL", "REV-CANONICAL", [
        SearchField.of("identifier", "DOC-CANONICAL", 4000),
        SearchField.of("title", "Canonical title", 4000),
        SearchField.of("heading", "Canonical heading", 2500),
        SearchField.of("classification", "search", 2000),
        SearchField.of("body", "canonical body", 1000),
    ], [SearchFacet.of("component", "search")])

fn canonical_bound_fields(title_weight: i64) -> text:
    "[{\"name\":\"identifier\",\"value\":\"DOC-CANONICAL\",\"weight_milli\":4000}," +
        "{\"name\":\"title\",\"value\":\"Canonical title\",\"weight_milli\":" + title_weight.to_text() + "}," +
        "{\"name\":\"heading\",\"value\":\"Canonical heading\",\"weight_milli\":2500}," +
        "{\"name\":\"classification\",\"value\":\"search\",\"weight_milli\":2000}," +
        "{\"name\":\"body\",\"value\":\"canonical body\",\"weight_milli\":1000}]"

fn scoped_preimage(title_weight: i64) -> text:
    "{\"document_id\":\"DOC-CANONICAL\",\"facets\":[{\"name\":\"component\",\"value\":\"search\"}]," +
        "\"fields\":" + canonical_bound_fields(title_weight) +
        ",\"revision\":\"REV-CANONICAL\",\"scope_digest\":\"sha256:" + "1" * 64 +
        "\",\"visibility_digest\":\"sha256:" + "2" * 64 + "\"}"

fn durable_document_row(title_weight: i64, preimage: text) -> text:
    val scoped_hash = "sha256:" + sha256_text(preimage)
    "{\"facets\":[{\"name\":\"component\",\"value\":\"search\"}]," +
        "\"fields\":" + canonical_bound_fields(title_weight) +
        ",\"id\":\"DOC-CANONICAL\",\"revision\":\"REV-CANONICAL\"," +
        "\"scoped_hash\":\"" + scoped_hash + "\",\"scoped_hash_preimage\":\"" +
        json_escape_string(preimage) + "\"}"

fn subset_document(facets: text, scoped_hash: text) -> text:
    "{\"document_id\":\"DOC-SUBSET\",\"facets\":" + facets +
        ",\"fields\":[{\"name\":\"identifier\",\"value\":\"DOC-SUBSET\"}," +
        "{\"name\":\"body\",\"value\":\"subset body\"}]," +
        "\"revision\":\"REV-SUBSET\",\"scope_digest\":\"sha256:" + "1" * 64 +
        "\",\"scoped_content_hash\":\"" + scoped_hash +
        "\",\"visibility_digest\":\"sha256:" + "2" * 64 + "\"}"

describe "SPipe provider canonical logical state":
    it "derives one logical root from identical final documents across histories":
        val documents = [canonical_document()]
        val hashes = ["sha256:" + "a" * 64]
        val add_commitment = candidate_commitment_preimage(
            "[{\"kind\":\"add\"}]", documents, hashes).unwrap()
        val replace_commitment = candidate_commitment_preimage(
            "[{\"kind\":\"replace\"}]", documents, hashes).unwrap()
        expect(add_commitment == replace_commitment).to_equal(false)
        val zero_root = "sha256:" + "0" * 64
        val add_root = candidate_root_from_commitment(
            zero_root, "applied", add_commitment).unwrap()
        val replace_root = candidate_root_from_commitment(
            "sha256:" + "b" * 64, "applied", replace_commitment).unwrap()
        expect(add_root).to_equal(replace_root)

        val changed_hash_commitment = candidate_commitment_preimage(
            "[{\"kind\":\"add\"}]", documents,
            ["sha256:" + "c" * 64]).unwrap()
        expect(candidate_root_from_commitment(zero_root, "applied",
            changed_hash_commitment).unwrap() == add_root).to_equal(false)

    it "maps every empty final document set to the clean empty root":
        val commitment = candidate_commitment_preimage(
            "[{\"kind\":\"delete\"}]", [], []).unwrap()
        expect(candidate_root_from_commitment("sha256:" + "d" * 64,
            "applied", commitment).unwrap()).to_equal("sha256:" + "0" * 64)

    it "cryptographically binds the canonical field weights":
        val canonical_preimage = scoped_preimage(4000)
        val canonical_row = json_parse_with_error(
            durable_document_row(4000, canonical_preimage)).0
        expect(restore_document(canonical_row,
            "sha256:" + "1" * 64).is_ok()).to_equal(true)

        val row_only_drift = json_parse_with_error(
            durable_document_row(3999, canonical_preimage)).0
        expect(restore_document(row_only_drift,
            "sha256:" + "1" * 64).is_err()).to_equal(true)

        val rehashed_weight_drift = scoped_preimage(3999)
        val rehashed_row = json_parse_with_error(
            durable_document_row(3999, rehashed_weight_drift)).0
        expect(restore_document(rehashed_row,
            "sha256:" + "1" * 64).is_err()).to_equal(true)

    it "normalizes authorized field subsets and facet pair order into one root":
        val facets_forward = "[{\"name\":\"tag\",\"value\":\"alpha\"},{\"name\":\"tag\",\"value\":\"zeta\"}]"
        val facets_reverse = "[{\"name\":\"tag\",\"value\":\"zeta\"},{\"name\":\"tag\",\"value\":\"alpha\"}]"
        val forward_value = json_parse_with_error(
            subset_document(facets_forward, "sha256:" + "0" * 64)).0
        val reverse_value = json_parse_with_error(
            subset_document(facets_reverse, "sha256:" + "0" * 64)).0
        val forward_hash = _scoped_document_hash(forward_value).unwrap()
        val reverse_hash = _scoped_document_hash(reverse_value).unwrap()
        expect(forward_hash).to_equal(reverse_hash)

        val decoded_value = json_parse_with_error(
            subset_document(facets_reverse, reverse_hash)).0
        val decoded = _decode_document(decoded_value, "DOC-SUBSET",
            "sha256:" + "1" * 64).unwrap()
        expect(decoded.fields.len()).to_equal(2)
        expect(decoded.fields[0].name).to_equal("identifier")
        expect(decoded.fields[1].name).to_equal("body")
        expect(decoded.metadata.len()).to_equal(2)
        expect(decoded.metadata[0].value).to_equal("alpha")
        expect(decoded.metadata[1].value).to_equal("zeta")

        val weighted_fields = "[{\"name\":\"identifier\",\"value\":\"DOC-SUBSET\",\"weight_milli\":4000},{\"name\":\"body\",\"value\":\"subset body\",\"weight_milli\":1000}]"
        val durable_preimage = "{\"document_id\":\"DOC-SUBSET\",\"facets\":" +
            facets_forward + ",\"fields\":" + weighted_fields +
            ",\"revision\":\"REV-SUBSET\",\"scope_digest\":\"sha256:" + "1" * 64 +
            "\",\"visibility_digest\":\"sha256:" + "2" * 64 + "\"}"
        val durable_hash = "sha256:" + sha256_text(durable_preimage)
        val durable_row = "{\"facets\":" + facets_forward +
            ",\"fields\":" + weighted_fields +
            ",\"id\":\"DOC-SUBSET\",\"revision\":\"REV-SUBSET\"," +
            "\"scoped_hash\":\"" + durable_hash +
            "\",\"scoped_hash_preimage\":\"" +
            json_escape_string(durable_preimage) + "\"}"
        expect(restore_document(json_parse_with_error(durable_row).0,
            "sha256:" + "1" * 64).is_ok()).to_equal(true)

        val duplicate_pair = "[{\"name\":\"tag\",\"value\":\"alpha\"},{\"name\":\"tag\",\"value\":\"alpha\"}]"
        val duplicate_value = json_parse_with_error(
            subset_document(duplicate_pair, "sha256:" + "0" * 64)).0
        expect(_scoped_document_hash(duplicate_value).is_err()).to_equal(true)

        val reordered_fields = subset_document(facets_forward,
            "sha256:" + "0" * 64).replace(
                "{\"name\":\"identifier\",\"value\":\"DOC-SUBSET\"},{\"name\":\"body\",\"value\":\"subset body\"}",
                "{\"name\":\"body\",\"value\":\"subset body\"},{\"name\":\"identifier\",\"value\":\"DOC-SUBSET\"}")
        expect(_scoped_document_hash(
            json_parse_with_error(reordered_fields).0).is_err()).to_equal(true)

    it "emits success responses as exact lexicographically sorted JSON":
        var service = SpipeProviderServiceV1.empty()
        service.state = SpipeProviderStateV1.initialized_bound(
            "WS-CANONICAL", "spks1-" + "3" * 64,
            "sha256:" + "4" * 64, 1, "sha256:" + "0" * 64,
            SearchSnapshot.of("sha256:" + "3" * 64, "0",
                AnalyzerIdentity.spipe_v1(), []),
            ProviderCapabilitiesV1.simple_lexical(), [], false)
        val response = _success(service, "REQ-CANONICAL", "stats", "{\"a\":1}")
        val expected = "{\"ok\":true,\"operation\":\"stats\",\"operation_receipt\":null," +
            "\"protocol\":{\"major\":1,\"minor\":0},\"provider_generation\":\"pg-00000000000000000000000000000001\"," +
            "\"query_receipt\":null,\"request_id\":\"REQ-CANONICAL\",\"result\":{\"a\":1}," +
            "\"scope_digest\":\"sha256:" + "4" * 64 + "\",\"snapshot\":\"spks1-" + "3" * 64 +
            "\",\"workspace\":\"WS-CANONICAL\"}"
        expect(response).to_equal(expected)

        val receipt_response = _success_receipt(service, "REQ-CANONICAL",
            "index_apply", "{\"a\":1}", "{\"b\":2}")
        expect(receipt_response).to_contain(
            "\"request_id\":\"REQ-CANONICAL\",\"result\":{\"b\":2},\"scope_digest\":")
        expect(receipt_response).to_contain("\"operation_receipt\":{\"a\":1}")
