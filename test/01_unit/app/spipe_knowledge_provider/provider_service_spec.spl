use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}

describe "Pure Simple SPipe lexical provider":
    it "requires initialization and advertises unsupported features honestly":
        val service = SpipeProviderServiceV1.empty()
        expect(service.stats()).to_equal(Err("handshake_required"))
        expect(service.state.capabilities().semantic).to_equal(false)
        expect(service.state.capabilities().phrase).to_equal(false)
        expect(service.state.capabilities().duplicate_candidates).to_equal(false)

    it "returns closed unsupported and cancel errors":
        val service = SpipeProviderServiceV1.empty()
        expect(service.unsupported("symbols_snapshot")).to_equal(Err("handshake_required"))
        expect(service.state.cancel("")).to_equal(Err("cancel_target_not_found"))
        expect(service.state.cancel("never-admitted")).to_equal(Err("cancel_target_not_found"))
        service.state.admit_request("req-running")
        expect(service.state.cancel("req-running")).to_equal(Ok("cancelled"))
        expect(service.state.cancel("req-running")).to_equal(Ok("already_complete"))
        service.state.admit_request("req-finished")
        service.state.complete_request("req-finished")
        expect(service.state.cancel("req-finished")).to_equal(Ok("already_complete"))
