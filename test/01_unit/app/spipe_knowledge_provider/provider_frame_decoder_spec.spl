use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.transport_types.{ProviderTransportLimitsV1}
use app.spipe_knowledge_provider.frame_decoder.{ProviderFrameDecoderV1}

fn decoder_limits(max_frame: i64 = 1048576,
                  read_chunk: i64 = 4) -> ProviderTransportLimitsV1:
    val write_chunk = if max_frame < 16384: max_frame else: 16384
    ProviderTransportLimitsV1(max_frame_bytes: max_frame,
        read_chunk_bytes: read_chunk, write_chunk_bytes: write_chunk,
        max_queued_requests: 16, max_pending_bytes: 2097152,
        ingress_timeout_ms: 1000, output_timeout_ms: 1000)

describe "SPipe provider incremental frame decoder":
    it "emits one header before coalesced payload and preserves exact offsets":
        var decoder = ProviderFrameDecoderV1.configured(decoder_limits()).unwrap()
        val input = "00000006abcdef".bytes()
        val header = decoder.push(input, 0, 10)
        expect(header.consumed_bytes).to_equal(8)
        expect(header.event.kind).to_equal("header")
        expect(header.event.declared_payload_bytes.unwrap()).to_equal(6)
        expect(header.event.payload).to_be_nil()

        val first = decoder.push(input, 8, 11)
        expect(first.consumed_bytes).to_equal(4)
        expect(first.event.kind).to_equal("payload")
        expect(first.event.payload.unwrap().frame_payload_offset).to_equal(0)
        expect(first.event.payload.unwrap().count).to_equal(4)
        expect(first.event.payload.unwrap().bytes[0]).to_equal(97u8)
        expect(first.event.payload.unwrap().bytes[3]).to_equal(100u8)

        val second = decoder.push(input, 12, 12)
        expect(second.consumed_bytes).to_equal(2)
        expect(second.event.payload.unwrap().frame_payload_offset).to_equal(4)
        expect(second.event.payload.unwrap().bytes[0]).to_equal(101u8)
        expect(second.event.payload.unwrap().bytes[1]).to_equal(102u8)
        expect(second.state).to_equal("complete")
        val complete = decoder.take_complete().unwrap()
        expect(complete.payload_bytes).to_equal(6)
        expect(complete.first_header_at_ms).to_equal(10)
        expect(complete.completed_at_ms).to_equal(12)

    it "accepts a split header and does not replay input":
        var decoder = ProviderFrameDecoderV1.configured(decoder_limits()).unwrap()
        val prefix = decoder.push("0000".bytes(), 0, 20)
        expect(prefix.consumed_bytes).to_equal(4)
        expect(prefix.event.kind).to_equal("none")
        expect(prefix.event.declared_payload_bytes).to_be_nil()
        val header = decoder.push("0002xy".bytes(), 0, 21)
        expect(header.consumed_bytes).to_equal(4)
        expect(header.event.kind).to_equal("header")
        expect(header.event.declared_payload_bytes.unwrap()).to_equal(2)
        val payload = decoder.push("0002xy".bytes(), 4, 22)
        expect(payload.consumed_bytes).to_equal(2)
        expect(payload.event.payload.unwrap().frame_payload_offset).to_equal(0)
        expect(decoder.take_complete().unwrap().first_header_at_ms).to_equal(20)

    it "rejects uppercase and oversized headers before consuming payload":
        var uppercase = ProviderFrameDecoderV1.configured(decoder_limits()).unwrap()
        val malformed = uppercase.push("0000000Aanything".bytes(), 0, 30)
        expect(malformed.error_code).to_equal("malformed_frame")
        expect(malformed.consumed_bytes).to_equal(8)
        var oversized = ProviderFrameDecoderV1.configured(decoder_limits(5, 4)).unwrap()
        val too_large = oversized.push("00000006payload".bytes(), 0, 31)
        expect(too_large.error_code).to_equal("frame_too_large")
        expect(too_large.consumed_bytes).to_equal(8)
        val terminal = oversized.push("payload".bytes(), 0, 32)
        expect(terminal.consumed_bytes).to_equal(0)
        expect(terminal.error_code).to_equal("decoder_failed")

    it "handles empty frames, zero input, and truncated frames deterministically":
        var empty = ProviderFrameDecoderV1.configured(decoder_limits()).unwrap()
        val zero_input = empty.push([], 0, 40)
        expect(zero_input.consumed_bytes).to_equal(0)
        expect(zero_input.event.kind).to_equal("none")
        expect(empty.take_complete()).to_equal(Err("incomplete_frame"))
        val empty_header = empty.push("00000000".bytes(), 0, 41)
        expect(empty_header.event.kind).to_equal("header")
        expect(empty_header.state).to_equal("complete")
        expect(empty.take_complete().unwrap().payload_bytes).to_equal(0)

        var truncated = ProviderFrameDecoderV1.configured(decoder_limits()).unwrap()
        val header = truncated.push("00000003".bytes(), 0, 50)
        expect(header.event.kind).to_equal("header")
        val partial = truncated.push("ab".bytes(), 0, 51)
        expect(partial.event.payload.unwrap().count).to_equal(2)
        expect(truncated.take_complete()).to_equal(Err("incomplete_frame"))

    it "accepts the exact one MiB boundary and resets for a second frame":
        var decoder = ProviderFrameDecoderV1.configured(
            decoder_limits(1048576, 16384)).unwrap()
        val header = decoder.push("00100000".bytes(), 0, 60)
        expect(header.event.declared_payload_bytes.unwrap()).to_equal(1048576)
        var payload: [u8] = []
        var i = 0
        while i < 1048576:
            payload.push(120u8)
            i = i + 1
        var offset = 0
        while offset < payload.len():
            val step = decoder.push(payload, offset, 61 + offset)
            expect(step.event.payload.unwrap().count).to_be_less_than(16385)
            expect(step.event.payload.unwrap().frame_payload_offset).to_equal(offset)
            offset = offset + step.consumed_bytes
        expect(decoder.take_complete().unwrap().payload_bytes).to_equal(1048576)

        val second_header = decoder.push("00000001z".bytes(), 0, 2000000)
        expect(second_header.event.kind).to_equal("header")
        val second_payload = decoder.push("00000001z".bytes(), 8, 2000001)
        expect(second_payload.event.payload.unwrap().bytes[0]).to_equal(122u8)
        expect(second_payload.event.payload.unwrap().frame_payload_offset).to_equal(0)
        expect(decoder.take_complete().unwrap().payload_bytes).to_equal(1)
