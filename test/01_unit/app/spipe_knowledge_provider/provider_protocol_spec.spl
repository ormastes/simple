use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.protocol.{provider_frame_header, provider_parse_frame, provider_encode_frame, provider_prebinding_error, provider_bound_error}

describe "SPipe knowledge provider framing":
    it "encodes bounded lowercase hexadecimal payload lengths":
        expect(provider_frame_header(176)).to_equal(Ok("000000b0"))
        expect(provider_encode_frame("{}" )).to_equal(Ok("00000002{}"))

    it "rejects malformed and mismatched frames":
        expect(provider_parse_frame("xyz").error_code).to_equal("malformed_frame")
        expect(provider_parse_frame("00000003{}").error_code).to_equal("malformed_frame")
        expect(provider_parse_frame("0000000A0123456789").error_code).to_equal("malformed_frame")

    it "emits the accepted prebinding handshake vector":
        val payload = provider_prebinding_error("req-pre-1", "search", "handshake_required", "initialize first")
        expect(payload.len()).to_equal(176)
        expect(provider_encode_frame(payload).unwrap().starts_with("000000b0")).to_equal(true)

    it "marks only transient bound failures retryable":
        val transient = provider_bound_error("r1", "index_publish", "pg-1",
            "WS", "S", "sha256:x", "internal_error", "contention")
        val permanent = provider_bound_error("r2", "cancel", "pg-1",
            "WS", "S", "sha256:x", "cancel_target_not_found", "missing")
        expect(transient).to_contain("\"retryable\":true")
        expect(permanent).to_contain("\"retryable\":false")
        expect(provider_bound_error("r3", "index_apply", "pg-1", "WS", "S",
            "sha256:x", "storage_busy", "busy")).to_contain(
                "\"code\":\"internal_error\"")
        expect(provider_bound_error("r4", "search", "pg-1", "WS", "S",
            "sha256:x", "empty_query", "empty")).to_contain(
                "\"code\":\"invalid_request\"")
