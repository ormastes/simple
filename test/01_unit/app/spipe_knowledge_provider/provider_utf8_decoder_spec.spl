# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.provider_utf8_decoder.{ProviderUtf8DecoderV1}
use app.spipe_knowledge_provider.work_control.{ProviderBudgetLimitV1, ProviderBoundedBudgetV1, ProviderCheckpointProgressV1, ProviderDeterministicCheckpointV1, ProviderRequestControlHandleV1, provider_budget_category_raw_bytes, provider_budget_category_decoded_bytes, provider_budget_category_scalars, provider_budget_category_logical_allocations}

fn utf8_budget(raw_limit: i64 = 20000,
               decoded_limit: i64 = 20000,
               scalar_limit: i64 = 20000,
               allocation_limit: i64 = 20000) -> ProviderBoundedBudgetV1:
    ProviderBoundedBudgetV1.configured([
        ProviderBudgetLimitV1(category: provider_budget_category_raw_bytes(),
            limit: raw_limit),
        ProviderBudgetLimitV1(category: provider_budget_category_decoded_bytes(),
            limit: decoded_limit),
        ProviderBudgetLimitV1(category: provider_budget_category_scalars(),
            limit: scalar_limit),
        ProviderBudgetLimitV1(
            category: provider_budget_category_logical_allocations(),
            limit: allocation_limit),
    ]).unwrap()

fn utf8_checkpoint(fail_after: i64 = -1,
                   reason: text = "") -> ProviderDeterministicCheckpointV1:
    ProviderDeterministicCheckpointV1.configured(
        ProviderRequestControlHandleV1(request_id: "REQ-UTF8",
            registration_generation: 1),
        ProviderCheckpointProgressV1(stage: "maximum", bytes: 4096,
            events: 0, scalars: 1024, hash_blocks: 0, comparisons: 0),
        fail_after, reason).unwrap()

fn expect_split_scalar(encoded: [u8], split: i64, scalar: i64):
    var decoder = ProviderUtf8DecoderV1.configured()
    var budget = utf8_budget()
    var checkpoint = utf8_checkpoint()
    val first = decoder.push(encoded, 0, split, false, budget, checkpoint).unwrap()
    expect(first.len()).to_equal(0)
    expect(decoder.carry_bytes_count()).to_be_less_than(4)
    val second = decoder.push(encoded, split, encoded.len() - split, true,
        budget, checkpoint).unwrap()
    expect(second).to_equal([scalar])
    expect(decoder.carry_bytes_count()).to_equal(0)

fn expect_invalid_utf8(encoded: [u8], final_chunk: bool = true):
    var decoder = ProviderUtf8DecoderV1.configured()
    var budget = utf8_budget()
    var checkpoint = utf8_checkpoint()
    expect(decoder.push(encoded, 0, encoded.len(), final_chunk,
        budget, checkpoint)).to_equal(Err("invalid_utf8"))
    expect(decoder.push([], 0, 0, true, budget, checkpoint)).to_equal(
        Err("invalid_utf8"))

fn decode_with_partitions(encoded: [u8], partitions: [i64]) -> [i64]:
    var decoder = ProviderUtf8DecoderV1.configured()
    var budget = utf8_budget()
    var checkpoint = utf8_checkpoint()
    var actual: [i64] = []
    var offset = 0
    var partition_index = 0
    while offset < encoded.len():
        var take = partitions[partition_index % partitions.len()]
        if take > encoded.len() - offset:
            take = encoded.len() - offset
        val final_chunk = offset + take == encoded.len()
        val decoded = decoder.push(encoded, offset, take, final_chunk,
            budget, checkpoint).unwrap()
        for scalar in decoded:
            actual.push(scalar)
        offset = offset + take
        partition_index = partition_index + 1
    actual

fn decode_with_seeded_partitions(encoded: [u8], seed: i64) -> [i64]:
    var decoder = ProviderUtf8DecoderV1.configured()
    var budget = utf8_budget()
    var checkpoint = utf8_checkpoint()
    var actual: [i64] = []
    var state = seed
    var offset = 0
    while offset < encoded.len():
        # A fixed LCG makes this partition sequence reproducible while still
        # exercising irregular boundaries rather than another fixed width.
        state = (state * 1103515245 + 12345) % 2147483648
        var take = state % 7 + 1
        if take > encoded.len() - offset:
            take = encoded.len() - offset
        val final_chunk = offset + take == encoded.len()
        val decoded = decoder.push(encoded, offset, take, final_chunk,
            budget, checkpoint).unwrap()
        for scalar in decoded:
            actual.push(scalar)
        offset = offset + take
    actual

fn expect_invalid_range(offset: i64, count: i64):
    var decoder = ProviderUtf8DecoderV1.configured()
    var budget = utf8_budget()
    var checkpoint = utf8_checkpoint()
    expect(decoder.push([65u8], offset, count, false,
        budget, checkpoint)).to_equal(Err("invalid_input"))
    expect(budget.consumed(provider_budget_category_raw_bytes())).to_equal(0)
    expect(budget.consumed(provider_budget_category_decoded_bytes())).to_equal(0)
    expect(decoder.carry_bytes_count()).to_equal(0)
    expect(decoder.push([65u8], 0, 1, true,
        budget, checkpoint)).to_equal(Err("invalid_input"))

describe "SPipe provider strict incremental UTF-8 decoder":
    # @manual scenario evidence
    it "decodes exact scalar boundaries and charges admitted work before growth":
        # @req REQ-UTF8
        # @req REQ-UTF8
        # @req REQ-SSPEC-APP
        step("decodes exact scalar boundaries and charges admitted work before growth")
        var decoder = ProviderUtf8DecoderV1.configured()
        var budget = utf8_budget()
        var checkpoint = utf8_checkpoint()
        val encoded = [65u8, 194u8, 128u8, 223u8, 191u8,
            224u8, 160u8, 128u8, 237u8, 159u8, 191u8,
            238u8, 128u8, 128u8, 240u8, 144u8, 128u8, 128u8,
            244u8, 143u8, 191u8, 191u8]
        val decoded = decoder.push(encoded, 0, encoded.len(), true,
            budget, checkpoint).unwrap()
        expect(decoded).to_equal(
            [65, 128, 2047, 2048, 55295, 57344, 65536, 1114111])
        expect(budget.consumed(provider_budget_category_raw_bytes())).to_equal(22)
        expect(budget.consumed(provider_budget_category_decoded_bytes())).to_equal(22)
        expect(budget.consumed(provider_budget_category_scalars())).to_equal(8)
        expect(budget.consumed(
            provider_budget_category_logical_allocations())).to_equal(8)
        expect(checkpoint.checkpoint_count).to_equal(1)
        expect(decoder.push([], 0, 0, true, budget, checkpoint)).to_equal(
            Err("decoder_complete"))

    it "preserves explicit carry at every split position without retaining prefixes":
        # @req REQ-SSPEC-APP
        step("preserves explicit carry at every split position without retaining prefixes")
        expect_split_scalar([194u8, 162u8], 1, 162)
        expect_split_scalar([226u8, 130u8, 172u8], 1, 8364)
        expect_split_scalar([226u8, 130u8, 172u8], 2, 8364)
        expect_split_scalar([240u8, 159u8, 152u8, 128u8], 1, 128512)
        expect_split_scalar([240u8, 159u8, 152u8, 128u8], 2, 128512)
        expect_split_scalar([240u8, 159u8, 152u8, 128u8], 3, 128512)

    it "rejects invalid leaders, continuations, overlong forms, and scalar exclusions":
        # @req REQ-SSPEC-APP
        step("rejects invalid leaders, continuations, overlong forms, and scalar exclusions")
        expect_invalid_utf8([128u8])
        expect_invalid_utf8([192u8, 128u8])
        expect_invalid_utf8([193u8, 191u8])
        expect_invalid_utf8([245u8, 128u8, 128u8, 128u8])
        expect_invalid_utf8([255u8])
        expect_invalid_utf8([226u8, 40u8, 161u8])
        expect_invalid_utf8([224u8, 128u8, 128u8])
        expect_invalid_utf8([240u8, 128u8, 128u8, 128u8])
        expect_invalid_utf8([237u8, 160u8, 128u8])
        expect_invalid_utf8([244u8, 144u8, 128u8, 128u8])
        # Reject impossible prefixes as soon as their first continuation is
        # known; a later byte can never repair any of these prefixes.
        expect_invalid_utf8([224u8, 128u8], false)
        expect_invalid_utf8([237u8, 160u8], false)
        expect_invalid_utf8([240u8, 128u8], false)
        expect_invalid_utf8([244u8, 144u8], false)

    it "rejects every incomplete final sequence and accepts it only before final":
        # @req REQ-SSPEC-APP
        step("rejects every incomplete final sequence and accepts it only before final")
        expect_invalid_utf8([194u8])
        expect_invalid_utf8([226u8])
        expect_invalid_utf8([226u8, 130u8])
        expect_invalid_utf8([240u8])
        expect_invalid_utf8([240u8, 159u8])
        expect_invalid_utf8([240u8, 159u8, 152u8])

        var decoder = ProviderUtf8DecoderV1.configured()
        var budget = utf8_budget()
        var checkpoint = utf8_checkpoint()
        expect(decoder.push([240u8, 159u8, 152u8], 0, 3, false,
            budget, checkpoint).unwrap()).to_equal([])
        expect(decoder.carry_bytes_count()).to_equal(3)
        expect(decoder.push([128u8], 0, 1, true,
            budget, checkpoint).unwrap()).to_equal([128512])

    it "bounds checkpoint gaps and propagates budget and checkpoint rejection":
        # @req REQ-SSPEC-APP
        step("bounds checkpoint gaps and propagates budget and checkpoint rejection")
        var bytes: [u8] = []
        var i = 0
        while i < 4096:
            bytes.push(97u8)
            i = i + 1
        var decoder = ProviderUtf8DecoderV1.configured()
        var budget = utf8_budget()
        var checkpoint = utf8_checkpoint()
        expect(decoder.push(bytes, 0, bytes.len(), true,
            budget, checkpoint).unwrap().len()).to_equal(4096)
        expect(checkpoint.checkpoint_count).to_equal(4)

        var oversized_decoder = ProviderUtf8DecoderV1.configured()
        var oversized_budget = utf8_budget()
        var oversized_checkpoint = utf8_checkpoint()
        bytes.push(97u8)
        expect(oversized_decoder.push(bytes, 0, bytes.len(), true,
            oversized_budget, oversized_checkpoint)).to_equal(
                Err("limit_exceeded"))
        expect(oversized_budget.consumed(
            provider_budget_category_raw_bytes())).to_equal(0)

        var limited_decoder = ProviderUtf8DecoderV1.configured()
        var limited_budget = utf8_budget(1, 1, 0, 0)
        var limited_checkpoint = utf8_checkpoint()
        expect(limited_decoder.push([65u8], 0, 1, true,
            limited_budget, limited_checkpoint)).to_equal(Err("limit_exceeded"))
        expect(limited_budget.consumed(
            provider_budget_category_logical_allocations())).to_equal(0)
        expect(limited_decoder.carry_bytes_count()).to_equal(0)
        expect(limited_decoder.push([65u8], 0, 1, true,
            limited_budget, limited_checkpoint)).to_equal(Err("limit_exceeded"))

        var stopped_decoder = ProviderUtf8DecoderV1.configured()
        var stopped_budget = utf8_budget()
        var stopped_checkpoint = utf8_checkpoint(0, "deadline_exceeded")
        expect(stopped_decoder.push([65u8], 0, 1, true,
            stopped_budget, stopped_checkpoint)).to_equal(
                Err("deadline_exceeded"))
        expect(stopped_decoder.carry_bytes_count()).to_equal(0)
        expect(stopped_decoder.push([66u8], 0, 1, true,
            stopped_budget, stopped_checkpoint)).to_equal(
                Err("deadline_exceeded"))

    it "decodes the same owned scalars across varied deterministic partitions":
        # @req REQ-SSPEC-APP
        step("decodes the same owned scalars across varied deterministic partitions")
        val encoded = [65u8, 194u8, 162u8, 226u8, 130u8, 172u8,
            240u8, 159u8, 152u8, 128u8, 66u8,
            101u8, 204u8, 129u8]
        # Keep decomposed `e` + U+0301 explicit: this decoder validates and
        # owns Unicode scalars; a later normalization stage owns NFC changes.
        val expected = [65, 162, 8364, 128512, 66, 101, 769]
        for width in 1..5:
            var decoder = ProviderUtf8DecoderV1.configured()
            var budget = utf8_budget()
            var checkpoint = utf8_checkpoint()
            var actual: [i64] = []
            var offset = 0
            while offset < encoded.len():
                var take = width
                if take > encoded.len() - offset:
                    take = encoded.len() - offset
                val final_chunk = offset + take == encoded.len()
                val chunk = decoder.push(encoded, offset, take, final_chunk,
                    budget, checkpoint).unwrap()
                for scalar in chunk:
                    actual.push(scalar)
                offset = offset + take
            expect(actual).to_equal(expected)

        # Fixed mixed partitions deliberately cross the two-, three-, and
        # four-byte scalar boundaries in different combinations.
        expect(decode_with_partitions(encoded, [1, 3, 2, 5])).to_equal(expected)
        expect(decode_with_partitions(encoded, [4, 1, 1, 3, 2])).to_equal(expected)
        expect(decode_with_partitions(encoded, [6, 2, 1, 2])).to_equal(expected)

        # Fixed seeds provide deterministic pseudo-random partitions without
        # introducing a flaky runtime RNG dependency.
        expect(decode_with_seeded_partitions(encoded, 1)).to_equal(expected)
        expect(decode_with_seeded_partitions(encoded, 7)).to_equal(expected)
        expect(decode_with_seeded_partitions(encoded, 42)).to_equal(expected)
        expect(decode_with_seeded_partitions(encoded, 20260825)).to_equal(expected)

    it "rejects invalid ranges before work and remains terminal":
        # @req REQ-SSPEC-APP
        step("rejects invalid ranges before work and remains terminal")
        expect_invalid_range(-1, 1)
        expect_invalid_range(0, -1)
        expect_invalid_range(2, 0)
