# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# P6 (provider executable gap closure): §14.20 capability negotiation and the
# §14.18 TransportDiagnosticV1 / ProviderErrorV1 split.

use std.spec.step
use std.spec.{describe, it, expect}
use app.spipe_knowledge_provider.protocol.{provider_encode_frame, provider_parse_frame, provider_closed_error_code, provider_bound_error}
use app.spipe_knowledge_provider.service.{SpipeProviderServiceV1}
use app.spipe_knowledge_provider.wire.{ProviderHostBindingV1, provider_dispatch_frame_bound_owned}

fn init_frame(request_id: text) -> text:
    val payload = "{\"client\":\"spipe\",\"limits\":{\"max_frame_bytes\":1048576},\"operation\":\"initialize\",\"protocol\":{\"major\":1,\"minor\":0},\"request_id\":\"" + request_id + "\",\"required\":{\"analyzer\":\"spipe-unicode-lex-v1\",\"explanation\":\"bm25-explain-v1\",\"logical_index\":\"spipe-lexical-snapshot-v1\",\"provider\":\"spipe-search-provider/1.0\",\"score\":\"bm25-fixed-v1\"}" + "}"
    provider_encode_frame(payload).unwrap()

fn bound_frame(request_id: text, operation: text, payload: text) -> text:
    val request = "{\"deadline_ms\":30000,\"operation\":\"" + operation + "\",\"operation_receipt\":null,\"payload\":" + payload + ",\"protocol\":{\"major\":1,\"minor\":0},\"provider_generation\":\"pg-00000000000000000000000000000001\",\"query_receipt\":null,\"request_id\":\"" + request_id + "\",\"scope_digest\":\"sha256:" + "1" * 64 + "\",\"snapshot\":\"spks1-" + "0" * 64 + "\",\"workspace\":\"WS-PROVIDER\"}"
    provider_encode_frame(request).unwrap()

fn host_binding() -> ProviderHostBindingV1:
    ProviderHostBindingV1.create("WS-PROVIDER", "spks1-" + "0" * 64,
        "sha256:" + "1" * 64).unwrap()

describe "SPipe provider §14.20 capability advertisement and §14.18 transport diagnostics":
    # @manual scenario evidence
    it "advertises real §14.19 cancellation support, not a placeholder false":
        # @req REQ-SSPEC-APP
        # §14.20 freezes ProviderCapabilitiesV1.cancel:true. The design
        # correction (§2.4) required either flipping the advertisement to
        # match a real CAS, or filing the divergence -- this asserts the
        # provider actually took the "make it real" branch: the initialize
        # result advertises cancel:true, and a subsequent cancel operation
        # against an unknown target reaches the real
        # `SpipeProviderStateV1.cancel` CAS (cancel_target_not_found), never
        # the old hardcoded unsupported_capability stub.
        step("advertises real §14.19 cancellation support, not a placeholder false")
        var service = SpipeProviderServiceV1.empty()
        val initialized = provider_dispatch_frame_bound_owned(service,
            host_binding(), init_frame("init-cap-1"))
        service = initialized.service
        expect(provider_parse_frame(initialized.outcome.frame).payload).to_contain(
            "\"cancel\":true")

        val cancel_dispatch = provider_dispatch_frame_bound_owned(service,
            host_binding(), bound_frame("cancel-cap-1", "cancel",
                "{\"target_request_id\":\"work-never-admitted\"}"))
        val cancel_payload = provider_parse_frame(cancel_dispatch.outcome.frame).payload
        expect(cancel_payload).to_contain("\"code\":\"cancel_target_not_found\"")
        expect(cancel_payload.contains("\"code\":\"unsupported_capability\"")).to_equal(false)

    it "makes a previously-completed target return the real already_complete disposition":
        # @req REQ-SSPEC-APP
        # Targets the `initialize` request itself (rather than a second
        # bound operation) so this scenario stays isolated from unrelated
        # bound-operation gaps elsewhere in the provider; `admit_request`/
        # `complete_request` run for every dispatched operation including
        # `initialize` (wire_dispatch.spl), so it is already a genuine
        # completed entry in the request-control history by the time the
        # cancel frame is decoded.
        step("makes a previously-completed target return the real already_complete disposition")
        var service = SpipeProviderServiceV1.empty()
        val initialized = provider_dispatch_frame_bound_owned(service,
            host_binding(), init_frame("init-cap-2"))
        service = initialized.service
        val cancel_dispatch = provider_dispatch_frame_bound_owned(service,
            host_binding(), bound_frame("cancel-cap-2", "cancel",
                "{\"target_request_id\":\"init-cap-2\"}"))
        val payload = provider_parse_frame(cancel_dispatch.outcome.frame).payload
        expect(payload).to_contain("\"ok\":true")
        expect(payload).to_contain("\"status\":\"already_complete\"")

    it "keeps invalid_utf8 and frame_too_large out of the declared ProviderErrorV1 code set":
        # @req REQ-SSPEC-APP
        # §14.18: TransportDiagnosticV1's closed code set (invalid_utf8,
        # frame_too_large) must never be serialized as a ProviderErrorV1.
        # `provider_closed_error_code` is the single chokepoint every bound
        # error code passes through before being placed in a response; both
        # codes must map away from themselves (to the safe internal_error
        # fallback) rather than being declared pass-through codes.
        step("keeps invalid_utf8 and frame_too_large out of the declared ProviderErrorV1 code set")
        expect(provider_closed_error_code("invalid_utf8")).to_equal("internal_error")
        expect(provider_closed_error_code("frame_too_large")).to_equal("internal_error")
        val rendered_utf8 = provider_bound_error("r1", "search", "pg-1", "WS",
            "S", "sha256:x", "invalid_utf8", "should never be reachable")
        val rendered_frame = provider_bound_error("r2", "search", "pg-1", "WS",
            "S", "sha256:x", "frame_too_large", "should never be reachable")
        expect(rendered_utf8).to_contain("\"code\":\"internal_error\"")
        expect(rendered_utf8.contains("\"code\":\"invalid_utf8\"")).to_equal(false)
        expect(rendered_frame).to_contain("\"code\":\"internal_error\"")
        expect(rendered_frame.contains("\"code\":\"frame_too_large\"")).to_equal(false)

    it "closes a frame exceeding the declared frame limit silently, with zero response bytes":
        # @req REQ-SSPEC-APP
        # The host loop's own framing check (`_payload_length` bound in
        # `main.spl`) is exercised end-to-end elsewhere; at the dispatch
        # layer exercised by this spec, an over-limit declared header is
        # rejected before any operation payload is even parsed, and the
        # transport is closed with no ProviderErrorV1 payload written.
        step("closes a frame exceeding the declared frame limit silently, with zero response bytes")
        val oversized_header = "3b9aca00"
        expect(provider_parse_frame(oversized_header + "{}").error_code).to_equal(
            "frame_too_large")
        var service = SpipeProviderServiceV1.empty()
        val dispatched = provider_dispatch_frame_bound_owned(service,
            host_binding(), oversized_header + "{}")
        expect(dispatched.outcome.close_transport).to_equal(true)
        expect(dispatched.outcome.write_response).to_equal(false)
        expect(dispatched.outcome.frame).to_equal("")
        return ()
    return ()
