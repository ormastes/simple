# Strict UTF-8 decode of host-identity store bytes (no lossy U+FFFD).
use app.orchestrator.host_identity_public_v1.host_identity_store_text_v1

describe "host_identity_store_text_v1":
    it "decodes valid UTF-8 store bytes":
        val r = host_identity_store_text_v1("alias ssh-ed25519 AAAA".bytes())
        match r:
            case Ok(t): expect(t).to_equal("alias ssh-ed25519 AAAA")
            case Err(e): fail("unexpected Err {e}")

    it "rejects invalid UTF-8 instead of decoding lossily":
        val bad: [u8] = [97, 0xC3, 0x28]
        match host_identity_store_text_v1(bad):
            case Ok(_): fail("expected Err for invalid UTF-8")
            case Err(e): expect(e).to_equal("host-identity-store-invalid-utf8")
