use std.spec
use app.orchestrator.controller_gateway_v1.*
use app.orchestrator.local_controller.orchestrator_local_input_command_v1
use app.orchestrator.execution.orchestrator_execution_input_command_v2
use app.orchestrator.server_config_load_v1.{server_host_reference_validate_v1, server_host_reference_v1}
use app.orchestrator.server_command_v1.{orchestrator_server_ssh_begin_v1,
    orchestrator_server_ssh_begin_file_v1, orchestrator_server_ssh_step_v1}
use std.common.config_core.server_context_types_v1.{ResolvedServerV1, ServerRecordV1}
use std.common.contracts.orchestration.host_control_operation_v6.{HOST_AGENT_PANE_TARGET_SUB_V6, HostControlSubRequestV6,
    host_control_sub_decode_v6, host_control_sub_encode_v6}
use std.common.contracts.orchestration.host_agent_pane_stream_v6.{HostAgentPaneStreamRequestV6,
    HostAgentPaneStreamReceiptV6, host_agent_pane_stream_request_encode_v6, host_agent_pane_stream_receipt_encode_v6,
    HostAgentPaneTargetReceiptV6, host_agent_pane_target_receipt_encode_v6}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use app.orchestrator.host_action_command_v1.host_action_pane_refusal_v1
use std.common.contracts.orchestration.host_service_operation_v6.host_service_operation_request_digest_v6
use std.common.contracts.orchestration.host_service_operation_reply_v6.{HostServiceOperationReplyV6,
    host_service_operation_reply_encode_v6}
use std.nogc_sync_mut.orchestration.controller_dispatch_owner_v3.{controller_dispatch_host_effect_key_v3,
    controller_dispatch_host_action_key_v3}
use std.nogc_sync_mut.orchestration.host_linux_service_agent_v4.{HostAgentInvokeRequestV4,
    host_agent_invoke_request_encode_v4}

fn gateway_request_v1(action: text = "inspect") -> ControllerGatewayRequestV1:
    ControllerGatewayRequestV1(action: action, controller_id: "controller-a", request_uid: "request-a",
        source: "", ns: "", name: "", source_digest: "")

fn gateway_config_v1(actions: [text]) -> ControllerGatewayConfigV1:
    ControllerGatewayConfigV1(state_root: "/private/controller-a", controller_id: "controller-a", allowed_actions: actions)

fn gateway_invoke_fixture_v1(run_id: text, action: text = "agent-invoke") -> ControllerGatewayRequestV1:
    var request = gateway_request_v1(action)
    val invoke = host_agent_invoke_request_encode_v4(HostAgentInvokeRequestV4(operation_id: run_id,
        manifest: "manifest bytes for codec coverage")).unwrap()
    request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: action, frame: invoke)).unwrap()
    request

fn gateway_pane_fixture_v1(action: text, read_id: i64) -> ControllerGatewayRequestV1:
    var request = gateway_request_v1(action)
    val pane = HostAgentPaneStreamRequestV6(binding_uid: "pane-a", attach_digest: "a".repeat(64), epoch: 0, read_id: read_id)
    val frame = host_agent_pane_stream_request_encode_v6(pane)
    request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: action, frame: frame)).unwrap()
    request

fn gateway_ssh_selection_v1(transport: text) -> ResolvedServerV1:
    ResolvedServerV1(consumer: "caret", context: "work", source: "shared",
        record: ServerRecordV1(name: "build", transport: transport, host: "build.example.test", port: 22,
            container_host: "", auth_ref: "secret://ssh/build", tls_ref: "trust://ssh/build",
            remote_executable: "/opt/simple/bin/simple"))

describe "Typed selected-server controller boundary":
    it "requires an independent target grant and the canonical invocation for this run":
        val action = HOST_AGENT_PANE_TARGET_SUB_V6
        val profile = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [agent-pane-target]\n"
        expect(controller_gateway_config_decode_v1(profile).unwrap_err()).to_equal("controller-gateway-agent-pane-target-profile")
        val pinned = profile + "dispatchRoot: /private/dispatch\ndispatchConfigDigest: \"" + "a".repeat(64) + "\"\n"
        val installed = controller_gateway_config_decode_v1(pinned).unwrap()
        val request = gateway_invoke_fixture_v1("request-a", action)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        expect(controller_gateway_authorize_v1(installed, header, source).unwrap().source).to_equal(request.source)
        val generic = gateway_config_v1(["agent-attachment", "agent-invoke", "agent-pane"])
        expect(controller_gateway_authorize_v1(generic, header, source).unwrap_err()).to_equal("controller-gateway-action-denied")
        expect(controller_gateway_request_encode_v1(gateway_invoke_fixture_v1("another-run", action)).unwrap_err()).to_equal("controller-gateway-agent-pane-target-operation")
        var swapped = gateway_invoke_fixture_v1("request-a")
        swapped.action = action
        expect(controller_gateway_request_encode_v1(swapped).unwrap_err()).to_equal("controller-gateway-agent-pane-target-sub")
        val exact = host_control_sub_decode_v6(request.source).unwrap()
        swapped.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: action, frame: exact.frame + " ")).unwrap()
        expect(controller_gateway_request_encode_v1(swapped).is_err()).to_equal(true)

    it "returns target metadata for the exact run and invocation digest":
        val request = gateway_invoke_fixture_v1("request-a", HOST_AGENT_PANE_TARGET_SUB_V6)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val frame = host_control_sub_decode_v6(request.source).unwrap().frame
        var target = HostAgentPaneTargetReceiptV6(operation_id: "request-a", invoke_digest: sha256_text(frame),
            service_incarnation: "b".repeat(32), service_epoch: 9, session_id: "session-a",
            window_id: "window-a", pane_id: "pane-a")
        val receipt = host_agent_pane_target_receipt_encode_v6(target)
        expect(controller_gateway_response_v1(source, receipt).unwrap()).to_equal(receipt)
        target.operation_id = "request-b"
        expect(controller_gateway_response_v1(source, host_agent_pane_target_receipt_encode_v6(target)).unwrap_err()).to_equal("controller-gateway-agent-pane-target-receipt-mismatch")
        target.operation_id = "request-a"
        target.invoke_digest = sha256_text(request.source)
        expect(controller_gateway_response_v1(source, host_agent_pane_target_receipt_encode_v6(target)).unwrap_err()).to_equal("controller-gateway-agent-pane-target-receipt-mismatch")
        target.invoke_digest = sha256_text(frame)
        target.service_epoch = 0
        expect(controller_gateway_response_v1(source, host_agent_pane_target_receipt_encode_v6(target)).is_err()).to_equal(true)
        val unknown = controller_gateway_nonzero_reply_v1(source, 2, "remote invocation bytes")
        expect(unknown.exit_code).to_equal(2)
        expect(unknown.output.contains("remote invocation bytes")).to_equal(false)

    it "requires a separate installed pane grant and rejects swapping claim and read":
        val profile = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [agent-pane]\n"
        expect(controller_gateway_config_decode_v1(profile).unwrap_err()).to_equal("controller-gateway-agent-pane-profile")
        val pinned = profile + "dispatchRoot: /private/dispatch\ndispatchConfigDigest: \"" + "a".repeat(64) + "\"\n"
        val config = controller_gateway_config_decode_v1(pinned).unwrap()
        for action in ["agent-pane-claim", "agent-pane-read"]:
            val read_id = if action == "agent-pane-read": 1 else: 0
            val request = gateway_pane_fixture_v1(action, read_id)
            val source = controller_gateway_request_encode_v1(request).unwrap()
            val header = controller_gateway_header_v1(source).unwrap()
            expect(controller_gateway_authorize_v1(config, header, source).unwrap().request_uid).to_equal("request-a")
            expect(controller_gateway_authorize_v1(gateway_config_v1(["agent-attachment", "agent-invoke"]), header, source).unwrap_err()).to_equal("controller-gateway-action-denied")
            expect(controller_gateway_config_decode_v1(pinned.replace("[agent-pane]", "[" + action + "]")).is_err()).to_equal(true)
        var swapped = gateway_pane_fixture_v1("agent-pane-claim", 0)
        swapped.action = "agent-pane-read"
        expect(controller_gateway_request_encode_v1(swapped).unwrap_err()).to_equal("controller-gateway-agent-pane-sub")
        expect(controller_gateway_request_encode_v1(gateway_pane_fixture_v1("agent-pane-read", 0)).is_err()).to_equal(true)

    it "correlates the exact pane run, attachment, binding, epoch, read ID, and bytes":
        val request = gateway_pane_fixture_v1("agent-pane-read", 1)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val chunk: Dict<text, SdnValue> = {"stream": SdnValue.String("stdout"),
            "bytes": SdnValue.Array([SdnValue.Int(0), SdnValue.Int(255)])}
        val report: Dict<text, SdnValue> = {"kind": SdnValue.String("host-agent-pane-read"), "version": SdnValue.Int(4),
            "eof": SdnValue.Bool(false), "chunks": SdnValue.Array([SdnValue.Dict(chunk)])}
        val payload = sdn_encode_canonical(SdnValue.Dict(report))
        val exact = HostAgentPaneStreamReceiptV6(operation_id: "request-a", binding_uid: "pane-a",
            attach_digest: "a".repeat(64), epoch: 0, read_id: 1, payload: payload, payload_digest: sha256_text(payload))
        val receipt = host_agent_pane_stream_receipt_encode_v6(exact)
        expect(controller_gateway_response_v1(source, receipt).unwrap()).to_equal(receipt)
        for changed in [receipt.replace("request-a", "other-run"), receipt.replace("pane-a", "pane-b"),
                receipt.replace("a".repeat(64), "b".repeat(64))]:
            expect(controller_gateway_response_v1(source, changed).unwrap_err()).to_equal("controller-gateway-agent-pane-receipt-mismatch")
        var stale = exact
        stale.epoch = 1
        expect(controller_gateway_response_v1(source, host_agent_pane_stream_receipt_encode_v6(stale)).is_err()).to_equal(true)
        stale.epoch = 0
        stale.read_id = 2
        expect(controller_gateway_response_v1(source, host_agent_pane_stream_receipt_encode_v6(stale)).is_err()).to_equal(true)
        stale.read_id = 1
        stale.payload = payload.replace("255", "254")
        expect(controller_gateway_response_v1(source, host_agent_pane_stream_receipt_encode_v6(stale)).is_err()).to_equal(true)

    it "carries closed cursor refusals through the gateway without raw Host detail":
        val request = gateway_pane_fixture_v1("agent-pane-read", 1)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val digest = host_service_operation_request_digest_v6(request.request_uid, request.source).unwrap()
        for code in ["runtime-agent-pane-replay-gap", "runtime-agent-pane-read-out-of-order"]:
            var host = HostServiceOperationReplyV6(action: "host-control", service_incarnation: "b".repeat(32),
                operation_id: request.request_uid, scope_digest: "c".repeat(64), request_digest: digest,
                pending: false, exit_code: 2, payload: "", error: code)
            val refused = host_service_operation_reply_encode_v6(host).unwrap()
            expect(host_action_pane_refusal_v1(refused, request.request_uid, request.source).unwrap()).to_equal(code)
            expect(host_action_pane_refusal_v1(refused, request.request_uid, request.source + " ").is_err()).to_equal(true)
            host.payload = "raw-pane-byte-record"
            val contaminated = host_service_operation_reply_encode_v6(host).unwrap()
            expect(host_action_pane_refusal_v1(contaminated, request.request_uid, request.source).is_err()).to_equal(true)
            val fields: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String(request.action),
                "state": SdnValue.String("host-refused"), "operationId": SdnValue.String(request.request_uid),
                "record": SdnValue.String(""), "recordDigest": SdnValue.String(""), "detail": SdnValue.String(code)}
            val carrier = sdn_encode_canonical(SdnValue.Dict(fields)) + "\n"
            val confirmed = controller_gateway_nonzero_reply_v1(source, 1, carrier)
            expect(confirmed.exit_code).to_equal(1)
            expect(confirmed.output).to_equal(carrier)
            val foreign = controller_gateway_nonzero_reply_v1(source, 1, carrier.replace("request-a", "request-b"))
            expect(foreign.exit_code).to_equal(2)
            val unknown = controller_gateway_nonzero_reply_v1(source, 2, "raw-pane-byte-record")
            expect(unknown.exit_code).to_equal(2)
            expect(unknown.output).to_contain("server-pane-outcome-unconfirmed")
            expect(unknown.output.contains("raw-pane-byte-record")).to_equal(false)

    it "keeps non-pane remote failure framing unchanged":
        val source = controller_gateway_request_encode_v1(gateway_request_v1("inspect")).unwrap()
        val error = controller_gateway_nonzero_reply_v1(source, 17, "legacy controller refusal")
        expect(error.exit_code).to_equal(17)
        expect(error.output).to_equal("legacy controller refusal")

    it "requires separately installed dispatch pins for the opt-in attachment gateway":
        val profile = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [agent-attachment]\n"
        expect(controller_gateway_config_decode_v1(profile).unwrap_err()).to_equal("controller-gateway-attachment-profile")
        val pinned = profile + "dispatchRoot: /private/dispatch\ndispatchConfigDigest: \"" + "a".repeat(64) + "\"\n"
        val config = controller_gateway_config_decode_v1(pinned).unwrap()
        expect(config.dispatch_root).to_equal("/private/dispatch")
        expect(config.dispatch_config_digest).to_equal("a".repeat(64))

    it "restricts attachment requests to exact operation IDs and an installed action grant":
        var request = gateway_request_v1("agent-attachment")
        request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: "agent-inspect", frame: "another-run")).unwrap()
        expect(controller_gateway_request_encode_v1(request).unwrap_err()).to_equal("controller-gateway-agent-attachment-operation")
        request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: "helper-inspect", frame: request.request_uid)).unwrap()
        expect(controller_gateway_request_encode_v1(request).unwrap_err()).to_equal("controller-gateway-agent-attachment-sub")
        request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: "agent-inspect", frame: request.request_uid)).unwrap()
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        expect(controller_gateway_authorize_v1(gateway_config_v1(["inspect"]), header, source).unwrap_err()).to_equal("controller-gateway-action-denied")
        expect(controller_gateway_authorize_v1(gateway_config_v1(["agent-attachment"]), header, source).unwrap().request_uid).to_equal("request-a")

    it "opens no terminal from an inspect response and rejects foreign or extra report data":
        var request = gateway_request_v1("agent-attachment")
        request.source = host_control_sub_encode_v6(HostControlSubRequestV6(sub: "agent-inspect", frame: request.request_uid)).unwrap()
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val report = "version: 4\nkind: linux-host-agent-attachment\noperationId: request-a\nattachStage: none\n"
        val checked = controller_gateway_response_v1(source, report).unwrap()
        expect(checked).to_contain("attachStage")
        expect(checked.contains("terminalAuthority")).to_equal(false)
        expect(controller_gateway_response_v1(source, report.replace("request-a", "request-b")).unwrap_err()).to_equal("controller-gateway-attachment-report-operation")
        expect(controller_gateway_response_v1(source, report + "bearer: secret\n").is_err()).to_equal(true)

    it "keeps immutable attach and detach keys independent on the same Host run":
        val attach = controller_dispatch_host_effect_key_v3("request-a", "agent-attach")
        val detach = controller_dispatch_host_effect_key_v3("request-a", "agent-detach")
        expect(attach).to_start_with("controller-agent-attachment-v1/")
        expect(detach).to_start_with("controller-agent-attachment-v1/")
        expect(attach == detach).to_equal(false)
        expect(controller_dispatch_host_effect_key_v3("request-b", "agent-attach") == attach).to_equal(false)
        val legacy = controller_dispatch_host_action_key_v3("request-a")
        for sub in ["helper-abandon", "handoff-abandon", "retention-release"]:
            expect(controller_dispatch_host_effect_key_v3("request-a", sub)).to_equal(legacy)

    it "requires independent invoke opt-in and correlates the canonical immutable frame":
        val profile = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [agent-invoke]\n"
        expect(controller_gateway_config_decode_v1(profile).unwrap_err()).to_equal("controller-gateway-agent-invoke-profile")
        expect(controller_gateway_request_encode_v1(gateway_invoke_fixture_v1("another-run")).unwrap_err()).to_equal("controller-gateway-agent-invoke-operation")
        var request = gateway_invoke_fixture_v1("request-a")
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        expect(controller_gateway_authorize_v1(gateway_config_v1(["agent-attachment"]), header, source).unwrap_err()).to_equal("controller-gateway-action-denied")
        expect(controller_gateway_authorize_v1(gateway_config_v1(["agent-invoke"]), header, source).unwrap().source).to_equal(request.source)
        request.action = "agent-attachment"
        expect(controller_gateway_request_encode_v1(request).unwrap_err()).to_equal("controller-gateway-agent-attachment-sub")
        val key = controller_dispatch_host_effect_key_v3("request-a", "agent-invoke")
        expect(key).to_start_with("controller-agent-invoke-v1/")
        expect(key == controller_dispatch_host_effect_key_v3("request-a", "agent-attach")).to_equal(false)
        expect(key == controller_dispatch_host_effect_key_v3("request-a", "agent-detach")).to_equal(false)
        expect(key == controller_dispatch_host_action_key_v3("request-a")).to_equal(false)

    it "validates the exact invoke reply identity and progress without accepting pane data":
        val source = controller_gateway_request_encode_v1(gateway_invoke_fixture_v1("request-a")).unwrap()
        val report = "version: 4\nkind: linux-host-agent-invoke-reply\noperationId: request-a\nassociationDigest: \"" +
            "a".repeat(64) + "\"\nstage: running\nworkloadIndex: 0\noutcome: \"\"\npending: true\n"
        expect(controller_gateway_response_v1(source, report).unwrap()).to_contain("pending: true")
        expect(controller_gateway_response_v1(source, report.replace("request-a", "request-b")).unwrap_err()).to_equal("controller-gateway-agent-invoke-report-operation")
        expect(controller_gateway_response_v1(source, report.replace("pending: true", "pending: false")).unwrap_err()).to_equal("controller-gateway-agent-invoke-report-invalid")
        expect(controller_gateway_response_v1(source, report + "paneBytes: unauthorized\n").is_err()).to_equal(true)

    it "validates the request before opening an SSH profile and keeps a finished turn settled":
        val invalid = "kind: wrong-request\n"
        val selection = gateway_ssh_selection_v1("ssh")
        val rejected = orchestrator_server_ssh_begin_v1(selection, "", invalid)
        expect(rejected.owner.is_none()).to_equal(true)
        val reply = rejected.reply.unwrap()
        expect(reply.exit_code).to_equal(1)
        expect(reply.output).to_contain(controller_gateway_header_v1(invalid).unwrap_err())
        expect(reply.transport_cleanup.is_none()).to_equal(true)
        expect(reply.transport_store_cleanup.is_none()).to_equal(true)
        val stepped = orchestrator_server_ssh_step_v1(rejected, true)
        expect(stepped.owner.is_none()).to_equal(true)
        expect(stepped.reply.unwrap().output).to_equal(reply.output)

    it "rejects unreadable request input or a non-SSH selection without acquiring transport":
        val selection = gateway_ssh_selection_v1("ssh")
        val missing = orchestrator_server_ssh_begin_file_v1(selection, "", "")
        expect(missing.owner.is_none()).to_equal(true)
        expect(missing.reply.unwrap().output).to_contain("server-request-unavailable")
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        val unsupported = orchestrator_server_ssh_begin_v1(gateway_ssh_selection_v1("local"), "", source)
        expect(unsupported.owner.is_none()).to_equal(true)
        expect(unsupported.reply.unwrap().output).to_contain("server-consumer-transport-unsupported")

    it "REQ-002 decodes quoted host schema and endpoint path exactly once":
        val source = "host_config:\n  schema: \"simple-host-config-v1\"\n  server_config: \"/private/servers.sdn\"\nother:\n  server_config: /wrong/servers.sdn\n"
        expect(server_host_reference_v1(source).unwrap()).to_equal("/private/servers.sdn")

    it "REQ-002 rejects explicitly selected foreign host schema":
        expect(server_host_reference_validate_v1("host_config:\n  schema: foreign\n  server_config: /private/servers.sdn\n").unwrap_err()).to_equal("server-host-config-schema")

    it "REQ-002 rejects nontext and relative host server references":
        expect(server_host_reference_validate_v1("host_config:\n  server_config: 7\n").unwrap_err()).to_equal("server-host-config-path")
        expect(server_host_reference_validate_v1("host_config:\n  server_config: servers.sdn\n").unwrap_err()).to_equal("server-host-config-path")

    it "REQ-004 rejects malformed remote success payload":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        expect(controller_gateway_response_v1(source, "status: successful\n").is_err()).to_equal(true)

    it "REQ-004 rejects wrong controller inside a correlated successful cancellation frame":
        var request = gateway_request_v1("cancel")
        request.source_digest = "a".repeat(64)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val output = "version: 1\nkind: orchestrator-local-controller\ncontrollerId: controller-b\nrequestUid: request-a\nexecutionAuthorized: false\nstatus: intent-cancelled\nsourceDigest: \"" + request.source_digest + "\"\nterminationObserved: false\n"
        expect(controller_gateway_response_v1(source, output).unwrap_err()).to_equal("controller-cancellation-reply-mismatch")

    it "REQ-004 rejects wrong request UID in remote cancellation response":
        var request = gateway_request_v1("cancel")
        request.source_digest = "a".repeat(64)
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val output = "version: 1\nkind: orchestrator-local-controller\ncontrollerId: controller-a\nrequestUid: request-b\nexecutionAuthorized: false\nstatus: intent-cancelled\nsourceDigest: \"" + request.source_digest + "\"\nterminationObserved: false\n"
        expect(controller_gateway_response_v1(source, output).unwrap_err()).to_equal("controller-cancellation-reply-mismatch")

    it "REQ-004 preserves typed inspect request identity across encoding":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        val decoded = controller_gateway_request_decode_v1(source).unwrap()
        expect(decoded.controller_id).to_equal("controller-a")
        expect(decoded.request_uid).to_equal("request-a")
        expect(decoded.action).to_equal("inspect")

    it "REQ-004 authorizes an installed action and exact frame subject":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        val accepted = controller_gateway_authorize_v1(gateway_config_v1(["inspect"]), header, source)
        expect(accepted.unwrap().request_uid).to_equal("request-a")

    it "REQ-004 denies a caller-selected controller before domain effects":
        var request = gateway_request_v1()
        request.controller_id = "controller-b"
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        val rejected = controller_gateway_dispatch_v1(gateway_config_v1(["inspect"]), header, source)
        expect(rejected.unwrap_err()).to_equal("controller-gateway-controller-mismatch")

    it "REQ-004 refuses a valid request outside the local action grant":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        expect(controller_gateway_dispatch_v1(gateway_config_v1(["submit"]), header, source).unwrap_err()).to_equal("controller-gateway-action-denied")

    it "REQ-004 rejects frame request-id substitution":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap()
        var header = controller_gateway_header_v1(source).unwrap()
        header.request_id = "0".repeat(64)
        expect(controller_gateway_authorize_v1(gateway_config_v1(["inspect"]), header, source).unwrap_err()).to_equal("controller-gateway-frame-correlation")

    it "REQ-004 rejects hidden unused request fields":
        var request = gateway_request_v1()
        request.source = "unexpected executable or payload"
        expect(controller_gateway_request_encode_v1(request).unwrap_err()).to_equal("controller-gateway-unused-fields")

    it "REQ-004 requires immutable source digest for cancellation":
        expect(controller_gateway_request_encode_v1(gateway_request_v1("cancel")).unwrap_err()).to_equal("controller-gateway-cancel-digest")
        var request = gateway_request_v1("cancel")
        request.source_digest = "a".repeat(64)
        expect(controller_gateway_request_encode_v1(request).is_ok()).to_equal(true)

    it "REQ-004 carries signed execution packet without claiming its admission":
        var request = gateway_request_v1("dispatch")
        request.source = "version: 2\nkind: deliberately-not-a-valid-signed-dispatch\n"
        val source = controller_gateway_request_encode_v1(request).unwrap()
        val header = controller_gateway_header_v1(source).unwrap()
        val selected = controller_gateway_authorize_v1(gateway_config_v1(["dispatch"]), header, source).unwrap()
        expect(selected.source).to_equal(request.source)
        # Selection authorizes a dispatch attempt only; the real domain owner
        # must still reject the invalid signed packet/private state below.
        val reply = orchestrator_execution_input_command_v2(["dispatch", "/missing-server-test-root", "controller-a", "request-a", "framed-packet"], Some(request.source))
        expect(reply.exit_code == 0).to_equal(false)

    it "REQ-003 keeps local argument validation on source input route":
        val reply = orchestrator_local_input_command_v1(["submit"], Some("kind: invalid"))
        expect(reply.exit_code == 0).to_equal(false)
        expect(reply.output).to_contain("invalid-local-command-arguments")

    it "REQ-002 rejects duplicate gateway policy operations":
        val source = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [inspect, inspect]\n"
        expect(controller_gateway_config_decode_v1(source).unwrap_err()).to_equal("controller-gateway-actions")

    it "REQ-002 rejects administrative operations in gateway policy":
        val source = "version: 1\nstateRoot: /private/controller\ncontrollerId: controller-a\nallowedActions: [dispatch-init]\n"
        expect(controller_gateway_config_decode_v1(source).unwrap_err()).to_equal("controller-gateway-actions")

    it "REQ-002 rejects wire-selected filesystem roots":
        val source = controller_gateway_request_encode_v1(gateway_request_v1()).unwrap() + "stateRoot: /attacker\n"
        expect(controller_gateway_request_decode_v1(source).is_err()).to_equal(true)
