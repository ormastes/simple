# @feature: compiler-performance-memory-efficiency
# @req: REQ-011

use std.spec.*
use std.fs.{read_file}
use app.feature_doc.parser.{parse_feature_file}

describe "feature documentation parser block assembly":
    it "preserves empty multiline metadata and nested documentation blocks":
        val info = parse_feature_file(
            "test/fixtures/app/feature_doc/closed_blocks.txt")
        expect(info.doc_blocks.len()).to_equal(4)
        expect(info.doc_blocks[0]).to_equal("")
        expect(info.doc_blocks[1]).to_equal(
            "# Fixture Title\n\n  **Feature IDs:** #fixture\n  **Category:** Tooling\n  **Status:** Ready\n\n  alpha\n\n    beta")
        expect(info.title).to_equal("Fixture Title")
        expect(info.metadata.feature_ids).to_equal("#fixture")
        expect(info.metadata.category).to_equal("Tooling")
        expect(info.metadata.status).to_equal("Ready")
        expect(info.describes.len()).to_equal(1)
        expect(info.describes[0].doc).to_equal("Describe docs\n\n      body")
        expect(info.describes[0].contexts.len()).to_equal(1)
        expect(info.describes[0].contexts[0].doc).to_equal("Context docs")

    it "keeps an unterminated block discarded at eof":
        val info = parse_feature_file(
            "test/fixtures/app/feature_doc/unterminated.txt")
        expect(info.doc_blocks.len()).to_equal(0)
        expect(info.metadata.status).to_equal("")

    it "uses one fragment join instead of growing-prefix concatenation":
        val source = read_file("src/app/feature_doc/parser.spl")
        expect(source).to_contain("var block_lines: [text] = []")
        expect(source).to_contain("block_lines.push(bl)")
        expect(source).to_contain("block_lines.join(\"\\n\").trim()")
        expect(source).not.to_contain(
            "block_content = block_content + bl + \"\\n\"")
