# Purpose and audience: native entry-closure link regression evidence for
# launch-metadata policy helpers used by bootstrap startup.
# @req REQ-SSPEC-UNIT

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.process_run

val FIXTURE_ROOT = "test/fixtures/repro/app/startup_launch_metadata_link"
val FIXTURE_ENTRY = FIXTURE_ROOT + "/main.spl"

fn native_build_launch_metadata_fixture() -> text:
    val cmd = "set +e; d=$(mktemp -d); SIMPLE_BOOTSTRAP=1 SIMPLE_NO_STUB_FALLBACK=1 \"${{SIMPLE_TEST_BINARY:-bin/simple}}\" native-build --source src/app --source src/lib --source '{FIXTURE_ROOT}' --entry-closure --threads 2 --backend llvm --runtime-bundle core-c-bootstrap --entry '{FIXTURE_ENTRY}' --cache-dir \"$d/cache\" --output \"$d/prog\" >\"$d/build.log\" 2>&1; rc=$?; echo \"BUILD_RC=$rc\"; if [ \"$rc\" -eq 0 ]; then \"$d/prog\" 2>&1; else cat \"$d/build.log\"; fi; rm -rf \"$d\""
    val (out, _err, _code) = process_run("/bin/sh", ["-c", cmd])
    out

describe "launch metadata helpers remain in the native link closure":
    it "links and runs every startup policy helper used by retained metadata":
        # @req REQ-SSPEC-UNIT
        step("native-build the focused startup metadata entry closure")
        val out = native_build_launch_metadata_fixture()
        expect(out).to_contain("BUILD_RC=0")
        expect(out).to_contain("effective=map_selected_segments")
        expect(out).to_contain("from_hint=map_selected_segments")
        expect(out).to_contain("implies=true")
        expect(out).to_contain("valid=true")
        expect(out).to_contain("source=baremetal_got")
        expect(out).to_contain("rendered=true")
