"""
## Purpose and audience
Executable specification for the Stage-0 option router (WP-19a-s Phase C) in
src/app/startup/option_router.spl and its startup cutover neighbours
(load_policy_wiring, segment_load_plan). Written for the startup-lane owners
who need proof that `--x<ns>-<key>[=<value>]` extension splitting, the hard
`--` boundary, and the segment load plan stay fail-closed.

## Operator workflow
Run one file: `bin/simple test test/01_unit/app/startup/option_router_spec.spl`.
The load/segment scenarios call the real exported plan functions; the router
scenarios are source contracts read from the shipped option_router.spl via a
genuinely-named local, because the module cannot be imported on the seed (see
limitations).

## Compatibility and limitations
src/app/startup/option_router.spl declares a field named `namespace`
(OptionRouterNamespaceV1, option_router.spl:50), which the seed parser's
CppNamespace lint rejects everywhere, so the module is unparseable on the
seed binary and direct-call scenarios cannot run. Router scenarios therefore
bind the dispatch contract to the shipped source text instead. The
"production app-root option plan" block describes app_root_option_plan_v1,
which exists nowhere in src (grep-verified 2026-09-05); those scenarios are
fail-closed env-gated tripwires that stay RED until the API lands.

## Verification guidance and troubleshooting
A source-contract failure means the dispatch grammar or an error path changed
in option_router.spl — update the needle together with the product change, or
treat the failure as a real regression. A tripwire failure is expected while
app_root_option_plan_v1 is absent; landing the API and setting
SIMPLE_APP_ROOT_OPTION_PLAN_API=1 turns it green. Load/segment failures are
real behavioural regressions in the cutover plan.
"""

# Lifecycle: doc/01_research/compiler/startup_perf/aspect_dynload_startup_loader_perf_research_2026-08-19.md
# doc/03_plan/agent_tasks/startup_perf_parallel_plan_2026-08-17.md
# doc/04_architecture/startup/simple_app_startup.md
# doc/05_design/mcp_startup_entry_closure_split_blocker.md
# @manual_section: stage0 option router and startup cutover

# @feature option_router
# tag: unit

use std.spec
use std.spec.step
use std.io_runtime.{file_read, env_get}
use app.startup.launch_metadata.{launch_metadata_default}
use app.startup.load_policy_wiring.{
    startup_load_policy_result_v1,
    startup_load_policy_for_component_input_v1
}
use app.startup.segment_load_plan.{startup_segment_load_result_v1}

# NOTE: the option_router import is deliberately absent — the module declares
# a `namespace` field (option_router.spl:50) that the seed parser's
# CppNamespace lint rejects, so importing it fails the whole file. The router
# scenarios below pin the contract to the shipped source instead.

# ============================================================================
# Helpers
# ============================================================================

fn _router_source() -> text:
    file_read("src/app/startup/option_router.spl")

describe "stage0 option router — exact routes":
    it "routes a flag spelling to its handler route":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): exact-route dispatch lines retained
        step("Read the shipped router source and observe the exact-route path")
        val router_source = _router_source()
        expect(router_source.contains("fn option_router_dispatch_token_v1(table: OptionRouterTableV1, token: text, terminated: bool)")).to_equal(true)
        # oracle: a non-terminated --token must fall through to the exact
        # table scan, which is what binds spellings to handler routes
        expect(router_source.contains("_dispatch_exact(table, token)")).to_equal(true)
        # oracle: a table hit must report the registered option id and route
        # index so the caller can reach the owning handler
        expect(router_source.contains("ROUTER_DISPATCH_EXACT, i, -1, r.option_id")).to_equal(true)

    it "routes a valued spelling with =value to the right handler":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): valued-dispatch slice lines retained
        step("Read the shipped router source and observe the =value slice")
        val router_source = _router_source()
        # oracle: the value tail after the spelling's `=` must be sliced into
        # the dispatch result with has_value set, so handlers receive "2" not
        # "--opt-level=2"
        expect(router_source.contains("token.slice(sl + 1, n), true, CLI_ROUTE_OK")).to_equal(true)

    it "value-mode is enforced: required without = is an error, flag with = is an error":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): value-mode guard lines retained
        step("Read the shipped router source and observe both value-mode guards")
        val router_source = _router_source()
        # oracle: a required-value option matched bare must fail closed,
        # otherwise the handler would run with a missing value
        expect(router_source.contains("option requires =<value>: ")).to_equal(true)
        # oracle: a flag option given =value must fail closed, otherwise a
        # boolean flag could silently absorb the next spelling
        expect(router_source.contains("flag option takes no value: ")).to_equal(true)

    it "unknown exact option is a fail-closed error":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): unknown-option error line retained
        step("Read the shipped router source and observe the scan-exhausted error")
        val router_source = _router_source()
        # oracle: an unrecognised spelling must end in an explicit error, not
        # a positional pass-through, or typos would launch programs
        expect(router_source.contains("unknown option: " + "\" + token")).to_equal(true)

    it "reserved spellings cannot be registered":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): reserved-spelling registration guard retained
        step("Read the shipped router source and observe the registration guard")
        val router_source = _router_source()
        # oracle: registration must consult the shared reserved-spelling
        # predicate (--help, --version, the --x prefix) before accepting a route
        expect(router_source.contains("cli_spelling_reserved_v1(route.spelling)")).to_equal(true)

describe "stage0 option router — --x extension split":
    it "splits --x<ns>-<key>=<value> into namespace/key/value":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): extension-split slice lines retained
        step("Read the shipped router source and observe the extension split")
        val router_source = _router_source()
        # oracle: the lexical split must route --x tokens to the extension
        # scanner before the exact table is consulted
        expect(router_source.contains("if token.starts_with(\"--x\")")).to_equal(true)
        # oracle: a valued extension must slice the value after `=` with
        # has_value set, so the namespace provider receives the value only
        expect(router_source.contains("token.slice(eq + 1, n), true, CLI_ROUTE_OK")).to_equal(true)

    it "flag form --x<ns>-<key> has no value; key may contain dashes":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): flag-form extension dispatch retained
        step("Read the shipped router source and observe the flag-form dispatch")
        val router_source = _router_source()
        # oracle: without `=`, the extension dispatch must carry the key with
        # an empty value and has_value false — only the first `-` delimits
        expect(router_source.contains("ROUTER_DISPATCH_EXTENSION, -1, ns_index")).to_equal(true)

    it "unknown namespace and malformed --x tokens are fail-closed errors":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): extension error paths retained
        step("Read the shipped router source and observe the extension error paths")
        val router_source = _router_source()
        # oracle: a well-shaped token naming an unregistered namespace must
        # fail closed with UNKNOWN_NAMESPACE, not fall through to positional
        expect(router_source.contains("unknown namespace: ")).to_equal(true)
        # oracle: missing or bad-shape namespace/key must fail closed before
        # any namespace lookup, so malformed tokens never reach a provider
        expect(router_source.contains("malformed extension token: ")).to_equal(true)

describe "stage0 option router — argv routing with hard -- boundary":
    it "routes a mixed argv and stops intercepting after --":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): argv terminator hand-off retained
        step("Read the shipped router source and observe the hard -- hand-off")
        val router_source = _router_source()
        # oracle: after the hard `--`, every remaining token must dispatch as
        # PROGRAM_ARG without interception, so downstream CLIs keep their args
        expect(router_source.contains("terminated = true")).to_equal(true)
        expect(router_source.contains("return _plain(ROUTER_DISPATCH_PROGRAM_ARG)")).to_equal(true)

    it "argv routing is fail-closed on the first bad token":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): argv fail-closed abort retained
        step("Read the shipped router source and observe the abort-on-error rule")
        val router_source = _router_source()
        # oracle: the first ERROR dispatch must abort the whole argv with an
        # explicit Err, never a partial route list
        expect(router_source.contains("return Err(\"option-router-error: \" + d.error)")).to_equal(true)

describe "production app-root option plan":
    it "drops the entry script and consumes paired and inline log options":
        # @req REQ-SSPEC-UNIT
        # @capture(env_tripwire): app-root plan API presence tripwire
        step("Check whether the app-root option plan API has landed")
        # NOTE: app_root_option_plan_v1 exists nowhere in src (grep-verified
        # 2026-09-05; main.spl still uses app_root_clean_log_args). Fail-closed
        # tripwire: RED until the API lands, then set SIMPLE_APP_ROOT_OPTION_PLAN_API=1.
        val plan_api_present = env_get("SIMPLE_APP_ROOT_OPTION_PLAN_API") != ""
        expect(plan_api_present).to_equal(true)

    it "consumes DynSMF controls but retains the existing status command":
        # @req REQ-SSPEC-UNIT
        # @capture(env_tripwire): app-root plan API presence tripwire
        step("Check whether the app-root option plan API has landed")
        # NOTE: same absent API as above; fail-closed tripwire stays RED until
        # app_root_option_plan_v1 exists.
        val plan_api_present = env_get("SIMPLE_APP_ROOT_OPTION_PLAN_API") != ""
        expect(plan_api_present).to_equal(true)

    it "routes the exact component config and status through one plan":
        # @req REQ-SSPEC-UNIT
        # @capture(env_tripwire): app-root plan API presence tripwire
        step("Check whether the app-root option plan API has landed")
        # NOTE: same absent API as above; fail-closed tripwire stays RED until
