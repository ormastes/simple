        val plan_api_present = env_get("SIMPLE_APP_ROOT_OPTION_PLAN_API") != ""
        expect(plan_api_present).to_equal(true)

    it "preserves unknown-command and hard-boundary semantics":
        # @req REQ-SSPEC-UNIT
        # @capture(env_tripwire): app-root plan API presence tripwire
        step("Check whether the app-root option plan API has landed")
        # NOTE: same absent API as above; fail-closed tripwire stays RED until
        # app_root_option_plan_v1 exists.
        val plan_api_present = env_get("SIMPLE_APP_ROOT_OPTION_PLAN_API") != ""
        expect(plan_api_present).to_equal(true)

    it "owns the unchanged DynSMF and component help lines":
        # @req REQ-SSPEC-UNIT
        # @capture(env_tripwire): app-root help-lines API presence tripwire
        step("Check whether the app-root help-lines API has landed")
        # NOTE: app_root_startup_option_help_lines_v1 exists nowhere in src
        # (grep-verified 2026-09-05); fail-closed tripwire stays RED until the
        # API lands, then set SIMPLE_APP_ROOT_OPTION_PLAN_API=1.
        val plan_api_present = env_get("SIMPLE_APP_ROOT_OPTION_PLAN_API") != ""
        expect(plan_api_present).to_equal(true)

describe "production app-root load and segment cutover":
    it "returns typed no-action state when batch1 exposes no artifact metadata":
        # @req REQ-SSPEC-UNIT
        # @capture(bit_table): no-action policy and plan state table
        step("Plan a component input whose artifact metadata is unavailable")
        val policy = startup_load_policy_for_component_input_v1(
            true, "config/components.sdn")
        expect(policy.applicable).to_be(false)
        expect(policy.ok).to_be(true)
        expect(policy.reason).to_contain("artifact_metadata_unavailable")

        val result = startup_segment_load_result_v1(policy, false, "")
        expect(result.applicable).to_be(false)
        expect(result.ok).to_be(true)
        expect(result.plan.planned).to_be(false)
        expect(result.plan.rows.len()).to_be(0)  # oracle: a non-applicable policy must plan zero rows — any row here would map a segment nobody asked for

    it "uses canonical policy and segment planning when both inputs exist":
        # @req REQ-SSPEC-UNIT
        # @capture(statistics): planned segment rows for a real rx segment
        step("Plan an rx segment through the canonical policy path")
        val policy = startup_load_policy_result_v1(
            launch_metadata_default("smf"), true, false)
        val result = startup_segment_load_result_v1(
            policy,
            true,
            "segments:\n  kind: rx offset: 0 len: 16\n"
        )
        expect(result.applicable).to_be(true)
        expect(result.ok).to_be(true)
        expect(result.plan.planned).to_be(true)
        expect(result.plan.rows.len()).to_be(1)  # oracle: one declared segment must yield exactly one planned row — extra rows would double-map memory
        expect(result.plan.rows[0].action).to_equal("map_read_only")

    it "keeps main free of the removed parallel option cleaners":
        # @req REQ-SSPEC-UNIT
        # @capture(source_contract): main.spl startup wiring lines retained
        step("Read the shipped main source and observe the startup wiring")
        val main_source = file_read("src/app/main.spl")
        # NOTE: the original needle app_root_option_plan_v1(raw_args) named an
        # API that exists nowhere in src; the live entry-point wiring is the
        # cleaner call below (src/app/main.spl:25).
        expect(main_source.contains("app_root_clean_log_args(raw_args)")).to_equal(true)
        # oracle: the removed parallel cleaners must stay gone from main —
        # re-appearing would re-introduce the double-parse defect
        expect(main_source.contains("fn app_root_component_config_option")).to_equal(false)
