"""
Product dynload startup cutover specification.

Proves checked config admission is fail-closed, raw-APK compatibility remains
a separate deferred owner, checked libraries close in reverse order, and
observational counters do not invent latency or max-RSS admission.
"""
# @req: REQ-APP-STARTUP-001 REQ-APKS-01
# @cover src/app/startup/dynsmf_autoload.spl 80%
# @cover src/os/smf/dynsmf_lifecycle.spl 80%

use std.spec.{describe, it, expect, step}
use os.smf.dynsmf_session.{
    DynSmfManifestEntry,
    DynSmfLoadedLibrary,
    DynSmfSession,
    dynsmf_policy_default
}
use os.smf.dynsmf_lifecycle.{dynsmf_session_close}
use app.startup.dynsmf_autoload.{
    product_dynload_startup_from_values,
    product_dynload_startup_with_io,
    product_dynload_startup_metrics_line
}
use app.main.{app_root_startup_io_budget, app_root_startup_exit_code}

fn startup_manifest() -> [DynSmfManifestEntry]:
    [DynSmfManifestEntry(
        id: "lib_a",
        path: "build/dynsmf/product_startup_lib_a.smf",
        source_module: "test.product.lib_a",
        artifact_kind: "precompiled_smf",
        abi_version: "1",
        default_autoload: false,
        exports: ["run"])]

fn missing_config_exists(_path: text) -> bool: false
fn unreadable_config_exists(_path: text) -> bool: true
fn unexpected_config_read(_path: text) -> (bool, text):
    (true, "unexpected")
fn unreadable_config_read(_path: text) -> (bool, text): (false, "")
fn readable_empty_config(_path: text) -> (bool, text): (true, "")

describe "product dynload startup config cutover":
    it "fails a missing explicit config before checked artifact loading":
        step("Verify: real product IO boundary records zero reads for absence")
        val owner = product_dynload_startup_with_io(
            ["--dynsmf-status"], "spec-missing", startup_manifest(),
            "/missing/dynload.sdn", true, missing_config_exists,
            unexpected_config_read, "", "", "",
            false, 11)
        expect(owner.config_ok).to_equal(false)
        expect(owner.exit_code).to_equal(1)
        expect(owner.error).to_contain("missing_explicit_dynload_config")
        expect(owner.metrics.config_file_reads).to_equal(0)
        expect(owner.close()).to_equal(true)

    it "fails an unreadable explicit config after exactly one read attempt":
        step("Verify: real product IO boundary fails closed after one read")
        val owner = product_dynload_startup_with_io(
            ["--dynsmf-status"], "spec-unreadable", startup_manifest(),
            "/unreadable/dynload.sdn", true, unreadable_config_exists,
            unreadable_config_read, "", "", "",
            false, 13)
        expect(owner.config_ok).to_equal(false)
        expect(owner.exit_code).to_equal(1)
        expect(owner.error).to_contain("unreadable_explicit_dynload_config")
        expect(owner.metrics.config_file_reads).to_equal(1)
        expect(owner.close()).to_equal(true)

    it "fails malformed dynload CLI before performing config IO":
        step("Verify: invalid CLI is checked-config failure with zero reads")
        val owner = product_dynload_startup_with_io(
            ["--dynload="], "spec-malformed-cli", startup_manifest(),
            "/configured/dynload.sdn", true, unreadable_config_exists,
            unexpected_config_read, "", "", "",
            false, 0)
        expect(owner.config_ok).to_equal(false)
        expect(owner.exit_code).to_equal(1)
        expect(owner.metrics.config_file_reads).to_equal(0)
        expect(owner.close()).to_equal(true)

    it "keeps help and no-op dispatch at zero product startup IO":
        step("Verify: command decode gates the product startup owner")
        expect(app_root_startup_io_budget([])).to_equal(0)
        expect(app_root_startup_io_budget(["--help"])).to_equal(0)
        expect(app_root_startup_io_budget(["help"])).to_equal(0)
        expect(app_root_startup_io_budget(["--dynsmf-status"])).to_equal(1)

    it "emits no trace when disabled and exactly one trace when enabled":
        step("Verify: trace boundary has exact cardinality")
        val off = product_dynload_startup_with_io(
            [], "spec-trace-off", startup_manifest(), "", false,
            missing_config_exists, readable_empty_config, "", "", "",
            false, 0)
        val on = product_dynload_startup_with_io(
            [], "spec-trace-on", startup_manifest(), "", false,
            missing_config_exists, readable_empty_config, "", "", "",
            true, 0)
        expect(off.metrics.trace_lines_emitted).to_equal(0)
        expect(on.metrics.trace_lines_emitted).to_equal(1)
        expect(off.trace_line).to_equal("")
        expect(on.trace_line).to_equal(
            "dynsmf-trace: startup_session_init session=spec-trace-on")
        expect(off.close()).to_equal(true)
        expect(on.close()).to_equal(true)

    it "propagates startup exit unless close failure takes precedence":
        step("Verify: app-root main exit selection is exact")
        expect(app_root_startup_exit_code(0, true)).to_equal(0)
        expect(app_root_startup_exit_code(7, true)).to_equal(7)
        expect(app_root_startup_exit_code(0, false)).to_equal(1)
        expect(app_root_startup_exit_code(7, false)).to_equal(1)

    it "fails malformed config without touching deferred raw APK compatibility":
        step("Verify: malformed checked config has no raw APK interaction")
        val owner = product_dynload_startup_from_values(
            [], "", "", "spec-config-fail", startup_manifest(),
            "dynload:\n  lib_a: \"presence=maybe\"\n", "", 17, 1)
        expect(owner.config_ok).to_equal(false)
        expect(owner.exit_code).to_equal(1)
        expect(owner.metrics.raw_pack_file_reads).to_equal(-1)
        expect(owner.metrics.raw_apk_counter_state).to_equal(
            "not-owned-deferred")
        expect(owner.metrics.raw_apk_compat_path).to_equal(
            "app.cli.startup_aspect_packs")
        expect(owner.metrics.config_file_reads).to_equal(1)
        expect(owner.close()).to_equal(true)

    it "owns checked dynSMF lifecycle and closes it idempotently":
        step("Verify: checked startup has exactly one lifecycle owner")
        val owner = product_dynload_startup_from_values(
            [], "", "", "spec-close", startup_manifest(), "", "", 19, 0)
        expect(owner.config_ok).to_equal(true)
        expect(owner.exit_code).to_equal(0)
        expect(owner.closed).to_equal(false)
        expect(owner.close()).to_equal(true)
        expect(owner.closed).to_equal(true)
        expect(owner.close()).to_equal(true)

    it "fails valid config when checked artifact admission fails":
        step("Verify: checked load failure cannot return startup success")
        val owner = product_dynload_startup_from_values(
            [], "", "", "spec-artifact-fail", startup_manifest(),
            "dynload:\n  lib_a: \"presence=on,placement=dynamic,activation=startup\"\n",
            "", 23, 1)
        expect(owner.config_ok).to_equal(true)
        expect(owner.exit_code).to_equal(1)
        expect(owner.error).to_contain("dynload startup rejected")
        expect(owner.close()).to_equal(true)

    it "closes checked handles in reverse load order":
        step("Verify: one-pass close walks last-loaded first")
        val session = DynSmfSession(
            session_id: "spec-reverse-close",
            generation: 2,
            next_handle: 3,
            policy: dynsmf_policy_default(),
            loaded: [
                DynSmfLoadedLibrary(id: "first", handle: 101, generation: 1,
                    status: "loaded", symbol_registry: ""),
                DynSmfLoadedLibrary(id: "second", handle: 102, generation: 2,
                    status: "loaded", symbol_registry: "")
            ],
            evidence: [])
        val closed = dynsmf_session_close(session)
        expect(closed.evidence.len()).to_equal(2)
        expect(closed.evidence[0].library_id).to_equal("second")
        expect(closed.evidence[1].library_id).to_equal("first")
        expect(closed.evidence[0].status).to_equal("unloaded")
        expect(closed.evidence[1].status).to_equal("unloaded")
        expect(closed.loaded[0].status).to_equal("unloaded")
        expect(closed.loaded[1].status).to_equal("unloaded")
        expect(closed.generation).to_equal(4)

    it "reports latency targets while leaving RSS to outer-harness evidence":
        step("Verify: counters distinguish targets from measured evidence")
        val owner = product_dynload_startup_from_values(
            [], "", "", "spec-metrics", startup_manifest(), "", "", 29, 0)
        expect(owner.metrics.elapsed_us).to_equal(29)
        expect(owner.metrics.latency_target_us).to_equal(0)
        expect(owner.metrics.latency_target_configured).to_equal(false)
        expect(owner.metrics.latency_target_source).to_equal(
            "outer-harness-required")
        expect(owner.metrics.measured_max_rss_kib).to_equal(0)
        expect(owner.metrics.rss_target_configured).to_equal(false)
        expect(owner.metrics.rss_evidence_source).to_equal(
            "outer-harness-required")
        expect(owner.metrics.full_tree_scans).to_equal(0)
        expect(owner.metrics.child_processes).to_equal(0)
        val line = product_dynload_startup_metrics_line(owner.metrics)
        expect(line).to_contain("elapsed_us=29")
        expect(line).to_contain("rss_evidence_source=outer-harness-required")
        expect(line).to_contain("raw_apk_counter_state=not-owned-deferred")
        expect(owner.close()).to_equal(true)
