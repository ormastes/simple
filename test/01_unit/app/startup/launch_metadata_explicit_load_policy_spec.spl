# Purpose and audience: regression evidence for native HIR field typing.
# @req REQ-SSPEC-UNIT

use std.spec.step
use std.spec.{describe, it, expect}
use app.startup.launch_metadata.launch_metadata_default

describe "launch metadata explicit load policy field":
    it "retains a parsed text policy assignment":
        # @req REQ-SSPEC-UNIT
        step("retains a parsed text policy assignment")
        var metadata = launch_metadata_default("smf")
        val declared_policy: text = "normal"
        metadata.load_policy = declared_policy
        expect(metadata.load_policy).to_equal("normal")
