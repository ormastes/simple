# @req REQ-AF-006 REQ-AF-007 REQ-AF-008 NFR-AF-002 NFR-AF-006
# @cover src/app/startup/aspect_application_runtime.spl 80%

use std.spec.*
use std.sfm.aspect_pack.{AspectPackCompression, AspectPackPayload, encode_aspect_pack}
use std.sfm.manifest.{FeatureManifest, SfmSecurityLevel}
use std.common.crypto.sha256.{sha256_u8_hex}
use compiler.loader.loader.aspect_catalog.{AspectBindingSummary, AspectAdviceSummary, AspectCatalogEntry, AspectCatalog}
use compiler.loader.loader.aspect_pack_provider.{AspectPackProviderKey, AspectPackModuleKey, AspectPackProvider, AspectPackTrustPolicy}
use compiler.loader.loader.aspect_activation.{AspectActivationRequest, AspectPublishedActivation}
use compiler.loader.loader.module_loader.{moduleloader_with_defaults}
use compiler.loader.loader.facet_binding_registry.{
    FacetBindingAdmission, facet_binding_stage_validated,
    aspect_publish_generation
}
use compiler.common.structural_contracts.facet_artifact.{
    FACET_WITNESS_DESCRIPTOR_VERSION,
    FacetWitnessMethodEntry, FacetWitnessDescriptorV1,
    facet_witness_symbol, facet_witness_method_symbol
}
use app.startup.aspect_application_runtime.{
    AspectApplicationPhase,
    AspectApplicationOperation,
    AspectExecutionContext,
    AspectApplicationRuntime,
    prepared_advice_dispatch_context_invoke
}
use os.smf.dynsmf_session.{DynSmfSession, DynSmfPolicy, dynsmf_session_new}
use os.smf.smf_generation.{LifecycleManager}
use test.fixtures.aspect_facet.runtime_fixture.{facet_runtime_fixture_smf}

fn app_resolved_facet_descriptor(
    summary: AspectBindingSummary, owner_id: text
) -> FacetWitnessDescriptorV1:
    FacetWitnessDescriptorV1(
        descriptor_version: FACET_WITNESS_DESCRIPTOR_VERSION,
        facet_contract_abi_hash: summary.facet_contract_abi_hash,
        descriptor_symbol: summary.witness_symbol,
        owner_id: owner_id,
        method_entries: [FacetWitnessMethodEntry(
            method_name: "audit",
            method_symbol: summary.witness_symbol + "__audit",
            resolved_address: 4096)])

fn app_aspect_smf() -> [u8]:
    var out: [u8] = [83, 77, 70, 0, 1, 1, 1, 0]
    while out.len() < 20:
        out.push(0)
    out.push(128)
    while out.len() < 28:
        out.push(0)
    out.push(128)
    while out.len() < 128:
        out.push(0)
    out

fn app_aspect_pack() -> [u8]:
    encode_aspect_pack(
        FeatureManifest(
            name: "mission-pack",
            version: "1.0.0",
            security_level: SfmSecurityLevel.Trusted,
            layers: []
        ),
        [AspectPackPayload(
            module_id: "security.audit",
            aspect_id: "security.audit",
            compression: AspectPackCompression.None,
            uncompressed_size: 128,
            dictionary_id: 0,
            stored_bytes: app_aspect_smf()
        )]
    ).unwrap()

fn app_aspect_entry(policy: text) -> AspectCatalogEntry:
    val pack = app_aspect_pack()
    val module_digest = sha256_u8_hex(app_aspect_smf())
    AspectCatalogEntry(
        aspect_id: "security.audit",
        pack_id: "mission-pack",
        pack_path: "aspects/mission-pack.sfm",
        module_id: "security.audit",
        pack_digest: sha256_u8_hex(pack),
        module_digest: module_digest,
        core_public_abi_hash: module_digest,
        core_layout_abi_hash: module_digest,
        target: "x86_64-unknown-linux-gnu",
        variant_fingerprint: "mission-v1",
        runtime_abi: "simple-runtime-1",
        dependencies: [],
        activation_policy: policy,
        binding_summaries: [AspectBindingSummary(
            binding_id: "security.audit.binding",
            concrete_type_id: "security.AuditRecord",
            business_interface_id: "",
            facet_interface_id: "Auditable",
            facet_contract_abi_hash: "facet-audit-v1",
            witness_symbol: "security_audit_witness",
            capabilities: ["audit.read"]
        )],
        prepared_joinpoint_slots: [],
        advice_summaries: [],
        capabilities: ["audit.read"]
    )

fn app_aspect_catalog(policy: text) -> AspectCatalog:
    AspectCatalog.create(
        4,
        "x86_64-unknown-linux-gnu",
        "mission-v1",
        "simple-runtime-1",
        [app_aspect_entry(policy)]
    ).unwrap()

fn app_advice_catalog() -> AspectCatalog:
    var entry = app_aspect_entry("startup")
    entry.prepared_joinpoint_slots = ["security.audit.prepared"]
    entry.advice_summaries = [AspectAdviceSummary(
        advice_id: "security.audit.before",
        joinpoint_slot_id: "security.audit.prepared",
        form: "before",
        priority: 10,
        specificity: 4,
        witness_symbol: "security_audit_advice",
        capabilities: ["audit.read"])]
    AspectCatalog.create(
        4, "x86_64-unknown-linux-gnu", "mission-v1",
        "simple-runtime-1", [entry]).unwrap()

fn app_execution_context_pack() -> [u8]:
    val module_bytes = facet_runtime_fixture_smf()
    encode_aspect_pack(
        FeatureManifest(
            name: "execution-context-pack", version: "1.0.0",
            security_level: SfmSecurityLevel.Trusted, layers: []),
        [AspectPackPayload(
            module_id: "fixture.debug", aspect_id: "fixture.debug",
            compression: AspectPackCompression.None,
            uncompressed_size: module_bytes.len(), dictionary_id: 0,
            stored_bytes: module_bytes)]).unwrap()

fn app_execution_context_catalog() -> AspectCatalog:
    val module_bytes = facet_runtime_fixture_smf()
    val module_digest = sha256_u8_hex(module_bytes)
    AspectCatalog.create(
        9, "x86_64-unknown-linux-gnu", "context-v1", "simple-runtime-1",
        [AspectCatalogEntry(
            aspect_id: "fixture.debug", pack_id: "execution-context-pack",
            pack_path: "aspects/execution-context-pack.sfm",
            module_id: "fixture.debug",
            pack_digest: sha256_u8_hex(app_execution_context_pack()),
            module_digest: module_digest,
            core_public_abi_hash: module_digest,
            core_layout_abi_hash: module_digest,
            target: "x86_64-unknown-linux-gnu",
            variant_fingerprint: "context-v1",
            runtime_abi: "simple-runtime-1", dependencies: [],
            activation_policy: "lazy_facet",
            binding_summaries: [AspectBindingSummary(
                binding_id: "fixture.debug.binding",
                concrete_type_id: "fixture.Cache", business_interface_id: "",
                facet_interface_id: "Debuggable",
                facet_contract_abi_hash: "fixture-facet-abi-v1",
                witness_symbol: facet_witness_symbol("fixture_debug"),
                capabilities: ["facet.read"])],
            prepared_joinpoint_slots: ["fixture.context.prepared"],
            advice_summaries: [AspectAdviceSummary(
                advice_id: "fixture.debug.before",
                joinpoint_slot_id: "fixture.context.prepared", form: "before",
                priority: 10, specificity: 1,
                witness_symbol: facet_witness_method_symbol(
                    "fixture_debug", "summary"),
                capabilities: ["facet.read"])],
            capabilities: ["facet.read"]) ]).unwrap()

fn app_execution_context_key() -> AspectPackProviderKey:
    val module_digest = sha256_u8_hex(facet_runtime_fixture_smf())
    AspectPackProviderKey(
        pack_id: "execution-context-pack",
        pack_digest: sha256_u8_hex(app_execution_context_pack()),
        catalog_generation: 9,
        target: "x86_64-unknown-linux-gnu",
        variant_fingerprint: "context-v1",
        runtime_abi: "simple-runtime-1",
        core_public_abi_hash: module_digest,
        core_layout_abi_hash: module_digest)

fn app_execution_context_request(id: text) -> AspectActivationRequest:
    AspectActivationRequest(
        aspect_id: "fixture.debug", request_id: id,
        catalog_generation: 9)

fn app_aspect_key() -> AspectPackProviderKey:
    val digest = sha256_u8_hex(app_aspect_smf())
    AspectPackProviderKey(
        pack_id: "mission-pack",
        pack_digest: sha256_u8_hex(app_aspect_pack()),
        catalog_generation: 4,
        target: "x86_64-unknown-linux-gnu",
        variant_fingerprint: "mission-v1",
        runtime_abi: "simple-runtime-1",
        core_public_abi_hash: digest,
        core_layout_abi_hash: digest
    )

fn app_aspect_session() -> DynSmfSession:
    dynsmf_session_new(
        "application-aspect-test",
        DynSmfPolicy(disabled_all: false, disabled_ids: [], source: "test")
    )

fn app_aspect_mission_runtime(policy: text) -> Result<AspectApplicationRuntime, text>:
    var public_key: [u8] = []
    while public_key.len() < 32:
        public_key.push(7)
    AspectApplicationRuntime.create(
        app_aspect_catalog(policy),
        app_aspect_session(),
        LifecycleManager.new_manager(),
        AspectPackTrustPolicy.mission(public_key).unwrap(),
        2,
        2,
        2
    )

fn app_aspect_request(id: text) -> AspectActivationRequest:
    AspectActivationRequest(
        aspect_id: "security.audit",
        request_id: id,
        catalog_generation: 4
    )

fn app_aspect_phase_is_operational(phase: AspectApplicationPhase) -> bool:
    match phase:
        case AspectApplicationPhase.Operational: true
        case AspectApplicationPhase.Startup: false

describe "Application aspect runtime policy owner":
    it "rejects non-startup dynamic routes in the mission profile":
        val runtime = app_aspect_mission_runtime("lazy_facet")
        expect(runtime.unwrap_err()).to_contain("only static, startup, or excluded")

    it "requires every startup aspect before entering operational state":
        val runtime = app_aspect_mission_runtime("startup").unwrap()
        val transitioned = runtime.enter_operational()
        expect(transitioned.unwrap_err()).to_contain("requires active startup aspect")

    it "denies lazy IO attach unload and patch after the mission transition":
        val runtime = app_aspect_mission_runtime("excluded").unwrap()
        expect(runtime.pack_path_for("security.audit").unwrap()).to_equal("aspects/mission-pack.sfm")
        runtime.enter_operational().unwrap()
        expect(app_aspect_phase_is_operational(runtime.phase)).to_be(true)
        expect(runtime.authorize(AspectApplicationOperation.LazyIo).unwrap_err()).to_contain("denies lazy")
        expect(runtime.authorize(AspectApplicationOperation.DynamicAttach).unwrap_err()).to_contain("denies dynamic")
        expect(runtime.authorize(AspectApplicationOperation.Unload).unwrap_err()).to_contain("denies aspect unload")
        expect(runtime.authorize(AspectApplicationOperation.Patch).unwrap_err()).to_contain("denies runtime advice patching")

        val activation = runtime.activate_pack_bytes(
            app_aspect_key(), app_aspect_pack(), [],
            app_aspect_request("operational"), moduleloader_with_defaults())
        expect(activation.status).to_equal("failed")
        expect(activation.reason).to_contain("denies lazy")
        expect(runtime.provider_cache.index_count()).to_equal(0)

    it "retains mission trust and rejects unsigned bytes before cache admission":
        val runtime = app_aspect_mission_runtime("startup").unwrap()
        val activation = runtime.activate_pack_bytes(
            app_aspect_key(), app_aspect_pack(), [],
            app_aspect_request("unsigned"), moduleloader_with_defaults())
        expect(activation.status).to_equal("failed")
        expect(activation.reason).to_contain("mission profile rejects unsigned")
        expect(runtime.provider_cache.index_count()).to_equal(0)

    it "denies catalogued runtime advice patching in mission startup":
        var public_key: [u8] = []
        while public_key.len() < 32:
            public_key.push(7)
        val runtime = AspectApplicationRuntime.create(
            app_advice_catalog(), app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.mission(public_key).unwrap(), 2, 2, 2).unwrap()
        val activation = runtime.activate_pack_bytes(
            app_aspect_key(), app_aspect_pack(), [],
            app_aspect_request("mission-advice"), moduleloader_with_defaults())
        expect(activation.status).to_equal("failed")
        expect(activation.reason).to_contain("denies runtime advice patching")
        expect(runtime.provider_cache.index_count()).to_equal(0)

    it "exposes fail-closed prepared advice phase dispatch through the app owner":
        val runtime = AspectApplicationRuntime.create(
            app_advice_catalog(), app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(), 2, 2, 2).unwrap()
        val before = runtime.advice_dispatch_slot(
            moduleloader_with_defaults(), "security.audit.prepared", "before")
        expect(before.unwrap().len()).to_equal(0)
        expect(runtime.advice_binding_counters().dispatch_attempts).to_equal(1)

        val around = runtime.advice_dispatch_slot(
            moduleloader_with_defaults(), "security.audit.prepared", "around")
        expect(around.unwrap_err()).to_contain("exactly-once proceed path")
        expect(runtime.advice_binding_counters().around_rejections).to_equal(1)

    it "keeps two execution contexts isolated and releases exact dispatch tokens":
        val first: AspectExecutionContext = AspectApplicationRuntime.create(
            app_execution_context_catalog(), app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(), 2, 2, 2).unwrap()
        val second: AspectExecutionContext = AspectApplicationRuntime.create(
            app_execution_context_catalog(), app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(), 2, 2, 2).unwrap()
        val activation = first.activate_pack_bytes(
            app_execution_context_key(), app_execution_context_pack(), [],
            app_execution_context_request("first-context"),
            moduleloader_with_defaults())
        expect(activation.status).to_equal("published")
        expect(first.coordinator.published.keys().len()).to_equal(1)
        expect(second.coordinator.published.keys().len()).to_equal(0)

        val values = prepared_advice_dispatch_context_invoke(
            first, "fixture.context.prepared", "before").unwrap()
        expect(values).to_equal([73])
        expect(first.advice_binding_counters().dispatch_attempts).to_equal(1)
        expect(first.advice_binding_counters().dispatch_invocations).to_equal(1)
        expect(second.advice_binding_counters().dispatch_attempts).to_equal(0)
        expect(first.published_generation_pin_count("fixture.debug").unwrap()).to_equal(0)

        val witness = facet_witness_method_symbol("fixture_debug", "summary")
        first.loader.global_symbols[witness] = (
            "forged-owner", first.loader.global_symbols[witness][1])
        val failed = prepared_advice_dispatch_context_invoke(
            first, "fixture.context.prepared", "before")
        expect(failed.unwrap_err()).to_contain("no longer loader-owned")
        expect(first.published_generation_pin_count("fixture.debug").unwrap()).to_equal(0)
        expect(first.advice_binding_counters().dispatch_failures).to_equal(1)
        expect(second.advice_binding_counters().dispatch_failures).to_equal(0)

        val compatible_facade: AspectApplicationRuntime = first
        expect(compatible_facade.advice_binding_counters().dispatch_attempts).to_equal(2)

    it "rejects a provider whose core ABI identity differs from the catalog":
        val runtime = AspectApplicationRuntime.create(
            app_aspect_catalog("startup"),
            app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(),
            2,
            2,
            2
        ).unwrap()
        var wrong_key = app_aspect_key()
        wrong_key.core_public_abi_hash = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        val activation = runtime.activate_pack_bytes(
            wrong_key, app_aspect_pack(), [],
            app_aspect_request("wrong-core-abi"), moduleloader_with_defaults())
        expect(activation.status).to_equal("failed")
        expect(activation.reason).to_contain("exact application catalog route")
        expect(runtime.provider_cache.index_count()).to_equal(0)

    it "uses the canonical cache and loader activation path in ordinary mode":
        val runtime = AspectApplicationRuntime.create(
            app_aspect_catalog("startup"),
            app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(),
            2,
            2,
            2
        ).unwrap()
        val loader = moduleloader_with_defaults()
        val activation = runtime.activate_pack_bytes(
            app_aspect_key(), app_aspect_pack(), [],
            app_aspect_request("ordinary"), loader)

        expect(runtime.provider_cache.index_count()).to_equal(1)
        expect(activation.status).to_equal("failed")
        expect(activation.reason).to_contain("witness symbol is missing")
        expect(loader.modules.keys().len()).to_equal(0)
        expect(loader.provider.registered_module_count()).to_equal(0)

    it "adapts FacetRef leases to the canonical published generation owner":
        val runtime = AspectApplicationRuntime.create(
            app_aspect_catalog("startup"),
            app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(),
            2,
            2,
            2
        ).unwrap()
        val entry = app_aspect_entry("startup")
        runtime.coordinator.lifecycle = runtime.coordinator.lifecycle.register_candidate(
            "mission-pack:security.audit:security.audit:4", 4)
        runtime.coordinator.lifecycle = runtime.coordinator.lifecycle.promote_candidate()
        runtime.coordinator.published["security.audit"] = AspectPublishedActivation(
            activation_key: "mission-pack:security.audit:security.audit:4",
            aspect_id: "security.audit",
            generation: 4,
            owners: ["mission-pack:security.audit:4"],
            module_keys: [AspectPackModuleKey(
                provider: app_aspect_key(),
                module_id: "security.audit",
                module_digest: sha256_u8_hex(app_aspect_smf())
            )],
            bindings: entry.binding_summaries,
            advices: [],
            state: "active"
        )
        val candidate = facet_binding_stage_validated(
            "mission-pack:security.audit:security.audit:4", 4, "security.audit",
            [FacetBindingAdmission(
                summary: entry.binding_summaries[0],
                witness_owner_id: "mission-pack:security.audit:4",
                witness_descriptor: app_resolved_facet_descriptor(
                    entry.binding_summaries[0],
                    "mission-pack:security.audit:4"))]
        ).unwrap()
        runtime.coordinator.facet_bindings = aspect_publish_generation(
            runtime.coordinator.facet_bindings, candidate,
            "mission-pack:security.audit:security.audit:4", 4).unwrap()

        val acquired = runtime.acquire_published_facet(
            "security.AuditRecord", [], "Auditable").unwrap()
        val pair = acquired.unwrap()
        val binding = pair.0
        val lease = pair.1
        expect(binding.aspect_id).to_equal("security.audit")
        expect(lease.aspect_id).to_equal("security.audit")
        expect(lease.generation_id).to_equal(4)
        expect(lease.token_id).to_be_greater_than(0)
        expect(runtime.published_generation_pin_count("security.audit").unwrap()).to_equal(1)
        runtime.release_facet_generation_lease(lease).unwrap()
        expect(runtime.published_generation_pin_count("security.audit").unwrap()).to_equal(0)
        expect(runtime.release_facet_generation_lease(lease).unwrap_err()).to_contain(
            "lease")

        val acquired_method = runtime.acquire_published_facet_method(
            "security.AuditRecord", [], "Auditable", "audit").unwrap().unwrap()
        expect(acquired_method.0.resolved_address).to_equal(4096)
        expect(acquired_method.0.method_symbol).to_end_with("__audit")
        expect(acquired_method.1.generation_id).to_equal(4)
        runtime.release_facet_generation_lease(acquired_method.1).unwrap()

    it "quiesces drains releases cache pins and completes ordinary unload":
        val runtime = AspectApplicationRuntime.create(
            app_aspect_catalog("startup"),
            app_aspect_session(),
            LifecycleManager.new_manager(),
            AspectPackTrustPolicy.ordinary_unsigned(),
            2,
            2,
            2
        ).unwrap()
        val loader = moduleloader_with_defaults()
        val provider_key = app_aspect_key()
        val module_key = AspectPackModuleKey(
            provider: provider_key,
            module_id: "security.audit",
            module_digest: sha256_u8_hex(app_aspect_smf())
        )
        val provider = AspectPackProvider.from_bytes(provider_key, app_aspect_pack()).unwrap()
        runtime.provider_cache.get_module_bytes(
            provider, module_key, loader.lifecycle.smf_cache_mgr).unwrap()
        runtime.provider_cache.acquire_module(
            module_key, loader.lifecycle.smf_cache_mgr).unwrap()
        val activation_key = "mission-pack:security.audit:security.audit:4"
        runtime.coordinator.lifecycle = runtime.coordinator.lifecycle.register_candidate(
            activation_key, 4).promote_candidate()
        runtime.coordinator.published["security.audit"] = AspectPublishedActivation(
            activation_key: activation_key,
            aspect_id: "security.audit",
            generation: 4,
            owners: ["mission-pack:security.audit:4"],
            module_keys: [module_key],
            bindings: app_aspect_entry("startup").binding_summaries,
            advices: [],
            state: "active"
        )
        val candidate = facet_binding_stage_validated(
            activation_key, 4, "security.audit",
            [FacetBindingAdmission(
                summary: app_aspect_entry("startup").binding_summaries[0],
                witness_owner_id: "mission-pack:security.audit:4",
                witness_descriptor: app_resolved_facet_descriptor(
                    app_aspect_entry("startup").binding_summaries[0],
                    "mission-pack:security.audit:4"))]
        ).unwrap()
        runtime.coordinator.facet_bindings = aspect_publish_generation(
            runtime.coordinator.facet_bindings, candidate,
            activation_key, 4).unwrap()
        val lease = runtime.acquire_facet_generation_lease("security.audit").unwrap()

        expect(runtime.unload_published_aspect("security.audit", loader).unwrap()).to_equal("quiescing")
        expect(runtime.coordinator.facet_bindings.active_count()).to_equal(0)
        expect(runtime.coordinator.published["security.audit"].bindings.len()).to_equal(0)
        expect(runtime.coordinator.published["security.audit"].state).to_equal("quiescing")
        expect(runtime.acquire_published_facet(
            "security.AuditRecord", [], "Auditable").unwrap()).to_be_nil()
        expect(runtime.acquire_facet_generation_lease(
            "security.audit").unwrap_err()).to_contain("not published")
        runtime.release_facet_generation_lease(lease).unwrap()
        expect(runtime.unload_published_aspect("security.audit", loader).unwrap()).to_equal("unloaded")
        expect(runtime.coordinator.published.has("security.audit")).to_be(false)
        expect(runtime.provider_cache.has_module(module_key)).to_be(false)
        expect(runtime.provider_cache.has_provider(provider_key)).to_be(false)
