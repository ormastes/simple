use std.spec
use app.startup.dynsmf_autoload.{dynsmf_startup_options_from_values}

describe "dynSMF startup option serialization":
    it "keeps environment settings before ordered CLI overrides":
        step("Collect environment and both CLI syntaxes into one settings value")
        val options = dynsmf_startup_options_from_values(
            ["--dynload", "beta:on", "--dynload=gamma:off"],
            "", "alpha:auto")

        expect(options.ok).to_be(true)
        expect(options.settings_text).to_equal("alpha:auto;beta:on;gamma:off")

    it "does not add a leading delimiter without environment settings":
        step("Serialize CLI-only settings")
        val options = dynsmf_startup_options_from_values(
            ["--dynload=alpha:on", "--dynload=beta:off"], "", "")

        expect(options.settings_text).to_equal("alpha:on;beta:off")
