use std.io_runtime.{file_read}

# Source-level guard for app_launchers_no_admitted_runtime_aarch64_linux_2026_10_19.
# The source repair (c374fcca687) added the aarch64 release candidate path to
# all seven wrappers; this spec pins that repair so the candidate lists cannot
# silently drop the aarch64 host again. Admitted-runtime deployment and real
# seven-wrapper execution on an admitted ARM64 runtime remain pending (the
# Rust seed is rejected by simple_runtime_provenance_admits by design).

describe "launcher wrapper aarch64 candidate paths":
    it "lists aarch64-unknown-linux-gnu alongside x86_64 in all seven wrappers":
        for wrapper in ["bin/devhub", "bin/caret", "bin/itf", "bin/dash", "bin/portal", "bin/sj", "bin/simple-interp"]:
            val script = file_read(wrapper)
            expect(script).to_contain("aarch64-unknown-linux-gnu")
            expect(script).to_contain("x86_64-unknown-linux-gnu")

    it "keeps the aarch64 path inside the runtime candidate list, not as a comment-only mention":
        val interp = file_read("bin/simple-interp")
        for line in interp.split("\n"):
            if line.contains("aarch64-unknown-linux-gnu"):
                expect(line.contains("#")).to_be(false)
