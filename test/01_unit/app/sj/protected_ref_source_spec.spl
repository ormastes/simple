"""
Source-level parity checks for protected-ref enforcement in all shipped SJ/MCP
surfaces. Runtime behavior is covered by forbidden_verbs_spec; these assertions
ensure mirrored generated/runtime owners cannot silently retain bulk or main
push advice.
"""

use std.spec.*
use std.io.{file_read}

fn source(path: text) -> text:
    file_read(path)

describe "SJ protected-ref source parity":
    it "sync moves and pushes only its discovered work bookmark":
        val text = source("src/app/jj/sync.spl")
        expect(text).to_contain("current_work_bookmark")
        expect(text).to_contain("[\"bookmark\", \"set\", work_branch")
        expect(text).to_contain("[\"git\", \"push\", \"--bookmark\", work_branch]")
        expect(text).to_not_contain("[\"bookmark\", \"set\", \"main\"")
        expect(text).to_not_contain("[\"git\", \"push\", \"--bookmark\", \"main\"")

    it "both MCP runtime families require explicit work bookmarks":
        val files = [
            "src/lib/nogc_sync_mut/mcp/jj/tools_jj_git.spl",
            "src/lib/nogc_async_mut/mcp/jj/tools_jj_git.spl",
            "src/lib/nogc_sync_mut/mcp/jj/tools_git_sync.spl",
            "src/lib/nogc_async_mut/mcp/jj/tools_git_sync.spl"
        ]
        for path in files:
            val text = source(path)
            expect(text).to_contain("owned_work_bookmark(bookmark)")
            expect(text).to_contain("name.contains(\"..\")")
            expect(text).to_contain("explicit owned work/* ref")
            expect(text).to_not_contain("cmd = cmd + \" --all\"")

    it "both MCP prompt families teach work branches and reject protected direct push":
        val sync_prompt = source("src/lib/nogc_sync_mut/mcp/jj/prompts.spl")
        val async_prompt = source("src/lib/nogc_async_mut/mcp/jj/prompts.spl")
        for text in [sync_prompt, async_prompt]:
            expect(text).to_contain("jj git push --bookmark work/<kind>/<work-id>-<slug>")
            expect(text).to_contain("Never move or push main")
            expect(text).to_not_contain("jj git push --bookmark main")
