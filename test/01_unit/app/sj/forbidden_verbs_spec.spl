"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/sj/forbidden_verbs_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/forbidden_verbs_spec.md
# doc-path: doc/03_plan/sys_test/forbidden_verbs_spec.md
# doc-path: doc/04_architecture/forbidden_verbs_spec.md
# doc-path: doc/05_design/forbidden_verbs_spec_oracles.md
# @manual: primary

"""
# Forbidden Verbs Specification
#
# Tests the policy enforcement for dangerous git verbs that should
# be blocked or redirected to safer jj equivalents.
"""
use std.spec.step

use std.io_runtime

# --- Inline policy types and logic ---

struct PolicyResult:
    allowed: bool
    exit_code: i64
    message: text

fn policy_allow() -> PolicyResult:
    PolicyResult(allowed: true, exit_code: 0i64, message: "")

fn policy_forbid(message: text) -> PolicyResult:
    PolicyResult(allowed: false, exit_code: 1i64, message: message)

fn _has_arg(argv: [text], needle: text) -> bool:
    var i = 0i64
    while i < argv.len():
        if argv[i] == needle:
            return true
        i = i + 1i64
    false

fn check_forbidden(argv: [text]) -> PolicyResult:
    if argv.len() < 2i64:
        return policy_allow()
    if argv[0i64] != "git":
        return policy_allow()
    val verb = argv[1i64]
    if verb == "rebase" and _has_arg(argv, "-i"):
        return policy_forbid("ERROR[FORBIDDEN]: git rebase -i is not supported here. Use sj split, sj squash --into, or sj rebase --onto instead.")
    if verb == "push" and (_has_arg(argv, "--force") or _has_arg(argv, "-f")):
        return policy_forbid("ERROR[FORBIDDEN]: force-push is prohibited. To move a bookmark backward use: jj bookmark move <name> --to <rev> --allow-backwards then: sj git push origin <name>")
    if verb == "push" and argv.len() == 2i64 and not _has_arg(argv, "--bookmark") and not _has_arg(argv, "--via-worktree"):
        return policy_forbid("ERROR[FORBIDDEN]: bare 'sj git push' is ambiguous in a jj repo. The project push pattern is: jj bookmark set main -r @- && sj git push origin main")
    if verb == "checkout" and argv.len() == 2i64:
        return policy_forbid("ERROR[FORBIDDEN]: bare 'git checkout' with no arguments is not meaningful in a jj-managed repo. Use sj git checkout <rev> or sj git checkout -b <branch> [base]")
    if verb == "filter-branch":
        return policy_forbid("ERROR[FORBIDDEN]: git filter-branch rewrites history outside jj's operation log. Use sj raw git filter-branch only if you accept the risk.")
    if verb == "stash":
        return policy_forbid("ERROR[FORBIDDEN]: use 'jj new -m wip-<topic>' instead - jj's working-copy-as-commit makes stash unnecessary")
    policy_allow()

# ============================================================================
# Tests
# ============================================================================

describe "Forbidden Verbs - Interactive Rebase":
    # @manual scenario evidence
    it "forbids git rebase -i":
        # @req REQ-SSPEC-UNIT
        step("forbids git rebase -i")
        val result = check_forbidden(["git", "rebase", "-i"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("FORBIDDEN")
        expect(result.message).to_contain("rebase -i")

    it "allows git rebase without -i":
        # @req REQ-SSPEC-UNIT
        step("allows git rebase without -i")
        val result = check_forbidden(["git", "rebase", "main"])
        expect(result.allowed).to_equal(true)

describe "Forbidden Verbs - Force Push":
    it "forbids git push --force":
        # @req REQ-SSPEC-UNIT
        step("forbids git push --force")
        val result = check_forbidden(["git", "push", "--force"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("force-push")

    it "forbids git push -f":
        # @req REQ-SSPEC-UNIT
        step("forbids git push -f")
        val result = check_forbidden(["git", "push", "-f"])
        expect(result.allowed).to_equal(false)

    it "allows git push with an owned work bookmark":
        val result = check_forbidden(["git", "push", "--bookmark", "work/fix/gh-12-parser"])
        expect(result.allowed).to_equal(true)

describe "Forbidden Verbs - Bare Push":
    it "forbids bare git push":
        # @req REQ-SSPEC-UNIT
        step("forbids bare git push")
        val result = check_forbidden(["git", "push"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("ambiguous")

    it "forbids unscoped git push with --via-worktree":
        val result = check_forbidden(["git", "push", "--via-worktree"])
        expect(result.allowed).to_equal(true)

describe "Forbidden Verbs - Bare Checkout":
    it "forbids bare git checkout":
        # @req REQ-SSPEC-UNIT
        step("forbids bare git checkout")
        val result = check_forbidden(["git", "checkout"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("not meaningful")

    it "allows git checkout with rev":
        # @req REQ-SSPEC-UNIT
        step("allows git checkout with rev")
        val result = check_forbidden(["git", "checkout", "main"])
        expect(result.allowed).to_equal(true)

describe "Forbidden Verbs - Filter-Branch":
    it "forbids git filter-branch":
        # @req REQ-SSPEC-UNIT
        step("forbids git filter-branch")
        val result = check_forbidden(["git", "filter-branch"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("filter-branch")

describe "Forbidden Verbs - Stash":
    it "forbids git stash":
        # @req REQ-SSPEC-UNIT
        step("forbids git stash")
        val result = check_forbidden(["git", "stash"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("jj new")

describe "Forbidden Verbs - Passthrough":
    it "allows non-git commands":
        # @req REQ-SSPEC-UNIT
        step("allows non-git commands")
        val result = check_forbidden(["describe", "-m", "test"])
        expect(result.allowed).to_equal(true)

    it "allows empty argv":
        # @req REQ-SSPEC-UNIT
        step("allows empty argv")
        val result = check_forbidden([])
        expect(result.allowed).to_equal(true)

    it "allows single git with no verb":
        # @req REQ-SSPEC-UNIT
        step("allows single git with no verb")
        val result = check_forbidden(["git"])
        expect(result.allowed).to_equal(true)

# ---------------------------------------------------------------------------
# Coverage the shim never had: the PolicyResult contract itself.
# The local copy asserted only `.allowed` and `.message`; `exit_code` was
# never observed by any example, on either mirror.
# ---------------------------------------------------------------------------

describe "Forbidden Verbs - PolicyResult contract":
    it "an allowed result carries exit_code 0 and an empty message":
        # @req REQ-SSPEC-UNIT
        step("an allowed result carries exit_code 0 and an empty message")
        val result = check_forbidden(["git", "rebase", "main"])
        expect(result.allowed).to_equal(true)
        expect(result.exit_code).to_equal(0i64)
        expect(result.message).to_equal("")

    it "a forbidden result carries exit_code 1":
        # @req REQ-SSPEC-UNIT
        step("a forbidden result carries exit_code 1")
        val result = check_forbidden(["git", "stash"])
        expect(result.allowed).to_equal(false)
        expect(result.exit_code).to_equal(1i64)

    it "every forbidden message is prefixed ERROR[FORBIDDEN]":
        # @req REQ-SSPEC-UNIT
        step("every forbidden message is prefixed ERROR[FORBIDDEN]")
        expect(check_forbidden(["git", "rebase", "-i"]).message).to_start_with("ERROR[FORBIDDEN]:")
        expect(check_forbidden(["git", "push", "--force"]).message).to_start_with("ERROR[FORBIDDEN]:")
        expect(check_forbidden(["git", "push"]).message).to_start_with("ERROR[FORBIDDEN]:")
        expect(check_forbidden(["git", "checkout"]).message).to_start_with("ERROR[FORBIDDEN]:")
        expect(check_forbidden(["git", "filter-branch"]).message).to_start_with("ERROR[FORBIDDEN]:")
        expect(check_forbidden(["git", "stash"]).message).to_start_with("ERROR[FORBIDDEN]:")

describe "Forbidden Verbs - argument-scan edges":
    it "rebase -i is caught wherever -i appears in argv":
        # @req REQ-SSPEC-UNIT
        step("rebase -i is caught wherever -i appears in argv")
        val result = check_forbidden(["git", "rebase", "--onto", "main", "-i"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("rebase -i")

    it "force-push is caught behind other flags":
        # @req REQ-SSPEC-UNIT
        step("force-push is caught behind other flags")
        val result = check_forbidden(["git", "push", "origin", "main", "--force"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("force")

    it "a non-bare protected push is forbidden":
        val result = check_forbidden(["git", "push", "origin", "main"])
        expect(result.allowed).to_equal(false)

    it "allows one explicit owned work ref or work destination refspec":
        expect(check_forbidden(["git", "push", "origin", "work/fix/gh-12-parser"]).allowed).to_equal(true)
        expect(check_forbidden(["git", "push", "origin", "HEAD:refs/heads/work/fix/gh-12-parser"]).allowed).to_equal(true)

    it "rejects work-looking shell and ref traversal payloads":
        expect(check_forbidden(["git", "push", "origin", "work/fix/x;git-tag-v1"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "origin", "work/fix/../main"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "origin", "work//fix/x"]).allowed).to_equal(false)

describe "Protected refs - adversarial mutation spellings":
    it "forbids protected push refspecs, deletion, force-with-lease, and bulk modes":
        expect(check_forbidden(["git", "push", "origin", "HEAD:refs/heads/main"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "origin", ":refs/heads/release/1.2"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "origin", "+HEAD:refs/heads/candidate/v1.2.3/a001"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "origin", "refs/tags/v1.2.3"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "--delete", "origin", "main"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "--force-with-lease", "origin", "work/fix/gh-12-parser"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "--all", "origin"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "push", "--tags", "origin"]).allowed).to_equal(false)

    it "forbids direct protected bookmark, branch, tag, and update-ref mutation":
        expect(check_forbidden(["bookmark", "set", "main", "-r", "@-"]).allowed).to_equal(false)
        expect(check_forbidden(["bookmark", "delete", "release/1.2"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "branch", "-D", "candidate/v1.2.3/a001"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "tag", "-d", "v1.2.3"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "update-ref", "refs/heads/main", "HEAD"]).allowed).to_equal(false)

    it "forbids every raw mutation bypass while allowing raw observation":
        expect(check_forbidden(["raw", "git", "push", "origin", "main"]).allowed).to_equal(false)
        expect(check_forbidden(["raw", "git", "tag", "-d", "v1.2.3"]).allowed).to_equal(false)
        expect(check_forbidden(["raw", "git", "update-ref", "refs/heads/main", "HEAD"]).allowed).to_equal(false)
        expect(check_forbidden(["raw", "jj", "git", "push", "--bookmark", "main"]).allowed).to_equal(false)
        expect(check_forbidden(["raw", "jj", "bookmark", "set", "main", "-r", "@-"]).allowed).to_equal(false)
        expect(check_forbidden(["raw", "jj", "log", "-r", "main"]).allowed).to_equal(true)

    it "denies untyped ref mutation even outside protected namespaces":
        expect(check_forbidden(["git", "tag", "scratch-tag"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "branch", "scratch-branch"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "update-ref", "refs/heads/work/fix/x", "HEAD"]).allowed).to_equal(false)
        expect(check_forbidden(["git", "tag", "--list"]).allowed).to_equal(true)
        expect(check_forbidden(["git", "branch", "--show-current"]).allowed).to_equal(true)

    it "stash is forbidden regardless of trailing arguments":
        # @req REQ-SSPEC-UNIT
        step("stash is forbidden regardless of trailing arguments")
        val result = check_forbidden(["git", "stash", "pop"])
        expect(result.allowed).to_equal(false)
        expect(result.message).to_contain("jj new")
