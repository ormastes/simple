# @req REQ-SSPEC-UNIT
"""
# sj native argv normalization

The native executable name is never dispatched as a jj verb, while source-run
invocations still begin after the explicit sj entry module.
"""

use std.spec.step
use app.sj.main.{sj_args_from}

describe "sj argv normalization":
    it "drops the native executable argv zero":
        step("normalize native sj argv")
        expect(sj_args_from(["/opt/simple/bin/sj", "--help"])).to_equal(["--help"])

    it "drops the source runner prefix through the sj entry":
        step("normalize source-run sj argv")
        expect(sj_args_from(["simple", "run", "src/app/sj/main.spl", "status"])).to_equal(["status"])
