# Non-Optional Return Contract — nil-path reproduce spec
#
# Regression coverage for the src/app/** non-optional-return-contract sweep
# (2026-08-21): several functions used to declare a non-optional return type
# (e.g. `-> text:`, `-> SessionAdapter:`) while their body could legitimately
# evaluate to `nil` on a "not found" path. Under the strict seed that aborted
# at runtime with "nil is forbidden by the non-optional return contract"
# [E-SFFI-016]. These were widened to `T?` so the nil path is a normal,
# checkable optional value instead of a trap.
#
# Exercises representative fixed functions across independent files.

use std.spec.{describe, it, expect}
use app.doc_coverage.analysis.export_parser.{get_directory, get_parent_directory, find_module_init}
use app.test_daemon.session_adapter.{adapter_registry_new}
use app.llm_caret.messaging.adapter.agent.session_registry.{AgentSessionRegistry}

describe "app non-optional-return-contract nil paths":
    it "get_directory returns nil (not a trap) when there is no slash":
        val result = get_directory("no_slash_here")
        expect(result == nil).to_equal(true)

    it "get_parent_directory returns nil (not a trap) at the filesystem root":
        val result = get_parent_directory("/")
        expect(result == nil).to_equal(true)

    it "find_module_init returns nil (not a trap) for an empty path":
        val result = find_module_init("")
        expect(result == nil).to_equal(true)

    it "AdapterRegistry.find_by_kind returns nil (not a trap) for an unregistered kind":
        val registry = adapter_registry_new()
        val found = registry.find_by_kind(999999)
        expect(found == nil).to_equal(true)

    it "AgentSessionRegistry.session returns nil (not a trap) for an unknown session id":
        val registry = AgentSessionRegistry.new()
        val found = registry.session("no-such-session")
        expect(found == nil).to_equal(true)

    it "AgentSessionRegistry.event_at returns nil (not a trap) for an out-of-range index":
        val registry = AgentSessionRegistry.new()
        val found = registry.event_at(-1)
        expect(found == nil).to_equal(true)
