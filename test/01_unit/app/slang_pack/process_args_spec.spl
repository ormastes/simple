use app.slang_pack.args.{slang_pack_process_args}

describe "slang-pack process argument boundary":
    it "keeps native help as the first operand":
        expect(slang_pack_process_args(["C:/tools/slang-pack.exe", "--help"])).to_equal(["--help"])
    it "preserves native input and output paths":
        expect(slang_pack_process_args(["packer", "weights.safetensors", "out"])).to_equal(["weights.safetensors", "out"])
    it "accepts the canonical script dispatch argv contract":
        expect(slang_pack_process_args(["src/app/slang_pack/main.spl", "--help"])).to_equal(["--help"])
    it "accepts an empty argv":
        expect(slang_pack_process_args([])).to_equal([])
    it "accepts an entry with no operands":
        expect(slang_pack_process_args(["renamed-tool"])).to_equal([])
    it "never discards a literal spl input or later operand":
        expect(slang_pack_process_args(["packer", "weights.spl", "out.spl"])).to_equal(["weights.spl", "out.spl"])
