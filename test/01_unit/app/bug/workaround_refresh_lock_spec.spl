# Refresh lock is per build dir; stacked @workaround tags refresh cleanly.
# Bug: scv_compile_event_refresh_lock_serializes_builds_2026-11-02
# @req REQ-SSPEC-APP

use std.spec.{describe, it, expect, step}
use app.bug.workaround_index.{parse_workaround_source}
use app.bug.workaround_store.{refresh_workarounds_at_build, workaround_lock_path}
use std.nogc_async_mut.sosix.workaround_host.{workaround_host_mkdir, workaround_host_process,
    workaround_host_temp_dir, workaround_host_lock, workaround_host_unlock}

describe "workaround refresh with stacked tags":
    it "accepts consecutive @workaround markers above one block":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# @workaround bug=b_bug_2026_11_02 reason=two\nfn f() -> i64:\n    0\n"
        val result = parse_workaround_source("x.spl", src)
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap().len()).to_equal(2)

    it "still rejects a marker followed by a plain comment":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# plain\nfn f() -> i64:\n    0\n"
        expect(parse_workaround_source("x.spl", src).is_err()).to_equal(true)

    it "still rejects a stack that ends at end of file":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# @workaround bug=b_bug_2026_11_02 reason=two\n"
        expect(parse_workaround_source("x.spl", src).is_err()).to_equal(true)

describe "workaround refresh lock keyed by build dir":
    it "uses distinct lock files per build dir":
        expect(workaround_lock_path("r", "build/a") != workaround_lock_path("r", "build/b")).to_equal(true)
        expect(workaround_lock_path("r", "build/a")).to_equal(workaround_lock_path("r", "build/a"))
        expect(workaround_lock_path("r", "")).to_equal("r/.simple/workarounds.sdn.lock")

    it "does not block build B while build A holds its lock":
        expect(workaround_host_mkdir("build/test-artifacts")).to_equal(true)
        val root = workaround_host_temp_dir("build/test-artifacts", "workaround-lock-key-").unwrap()
        val (_, _, rc) = workaround_host_process("git", ["-C", root, "init", "-q"], 30000, 1048576)
        expect(rc).to_equal(0)
        expect(workaround_host_mkdir(root + "/.simple")).to_equal(true)
        val held = workaround_host_lock(workaround_lock_path(root, "build/a"), 1)
        expect(held >= 0).to_equal(true)
        val other = refresh_workarounds_at_build(root, "build/b", false, [])
        val released = workaround_host_unlock(held)
        expect(released).to_equal(true)
        step("build B got past the lock to the Git owner (unborn HEAD)")
        expect(other.unwrap_err() != "workaround writer lock unavailable").to_equal(true)
