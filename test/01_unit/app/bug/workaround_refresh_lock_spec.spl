# Stacked @workaround tags refresh cleanly.
# Bug: scv_compile_event_refresh_lock_serializes_builds_2026-11-02
# @req REQ-SSPEC-APP

use std.spec.{describe, it, expect, step}
use app.bug.workaround_index.{parse_workaround_source}

describe "workaround refresh with stacked tags":
    it "accepts consecutive @workaround markers above one block":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# @workaround bug=b_bug_2026_11_02 reason=two\nfn f() -> i64:\n    0\n"
        val result = parse_workaround_source("x.spl", src)
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap().len()).to_equal(2)

    it "still rejects a marker followed by a plain comment":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# plain\nfn f() -> i64:\n    0\n"
        expect(parse_workaround_source("x.spl", src).is_err()).to_equal(true)

    it "still rejects a stack that ends at end of file":
        val src = "# @workaround bug=a_bug_2026_11_02 reason=one\n# @workaround bug=b_bug_2026_11_02 reason=two\n"
        expect(parse_workaround_source("x.spl", src).is_err()).to_equal(true)

