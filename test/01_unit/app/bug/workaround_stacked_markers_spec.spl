# Executable specification: stacked @workaround markers above one declaration
# (doc/08_tracking/bug/workaround_refresh_rejects_stacked_markers_2026-11-04.md).
# @req REQ-SSPEC-APP
# @cover src/app/bug/workaround_index.spl

use std.spec.{describe, it, expect}
use app.bug.workaround_index.{parse_workaround_source}

describe "stacked @workaround markers above a single declaration":
    it "accepts two or more stacked # @workaround markers directly above Simple code":
        val spl_src = "# @workaround bug=first_bug_2026_11_04 reason=first hazard\n# @workaround bug=second_bug_2026_11_04 reason=second hazard\nfn guarded() -> i64:\n    1\n"
        val spl_res = parse_workaround_source("stacked.spl", spl_src)
        expect(spl_res.is_ok()).to_equal(true)
        val spl_links = spl_res.unwrap()
        expect(spl_links.len()).to_equal(2)
        expect(spl_links[0].bug_id).to_equal("first_bug_2026_11_04")
        expect(spl_links[1].bug_id).to_equal("second_bug_2026_11_04")

    it "accepts stacked // @workaround markers directly above C/Rust code":
        val c_src = "// @workaround bug=first_c_bug_2026_11_04\n// @workaround bug=second_c_bug_2026_11_04 reason=abi guard\nint guarded_c(void) { return 0; }\n"
        val c_res = parse_workaround_source("stacked.c", c_src)
        expect(c_res.is_ok()).to_equal(true)
        expect(c_res.unwrap().len()).to_equal(2)

    it "still rejects stacked @workaround markers followed by plain comments, blanks, or EOF":
        val bad_comment = "# @workaround bug=first_bug_2026_11_04\n# @workaround bug=second_bug_2026_11_04\n# plain comment\nfn f() -> i64:\n    0\n"
        expect(parse_workaround_source("bad.spl", bad_comment).is_err()).to_equal(true)
        val bad_blank = "# @workaround bug=first_bug_2026_11_04\n# @workaround bug=second_bug_2026_11_04\n\nfn f() -> i64:\n    0\n"
        expect(parse_workaround_source("blank.spl", bad_blank).is_err()).to_equal(true)
        val bad_eof = "# @workaround bug=first_bug_2026_11_04\n# @workaround bug=second_bug_2026_11_04\n"
        expect(parse_workaround_source("eof.spl", bad_eof).is_err()).to_equal(true)
