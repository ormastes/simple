# @timeout_secs 1500 (KDF-style long-spec directive: interpreted-mode suites are slow)
#
# Regression evidence for the seed timeout-directive defect (observed 2026-10-23):
# under the Rust seed the pure-Simple runner client's directive parse read ""
# (same cross-module stdlib io gap as seed_file_write_bytes), so the directive
# was invisible and the run was capped at the client's default budget. This
# spec only needs to exist with its directive header for the parse probe; its
# scenario is intentionally fast.

use std.spec.{describe, it, expect}
use std.io_runtime.{thread_sleep}

describe "seed timeout directive visibility":
    it "declares a raised bound and finishes quickly":
        thread_sleep(10)
        expect(1).to_equal(1)
