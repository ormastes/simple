# @tag:in-development
use std.spec.*
use std.common.traceability.model.*
use std.common.traceability.query.{query_trace_graph}
use app.slop.projection.{slop_aliases, slop_draw_edges, slop_scope_label}
use app.slop.session.{SlopSession}
use app.slop.source.{slop_source_slice, slop_source_path_valid}
use common.ui.widget.{UIEvent, WidgetNode}

fn viewer_subject() -> SnapshotSubject:
    SnapshotSubject(repository_id: "fixture", snapshot_id: "snapshot-a", kind: "committed",
        revision_id: "revision-a", tree_id: "tree-a", object_format: "sha1")

fn viewer_locator() -> TraceLocator:
    TraceLocator(entity_id: "SRC-shared", path: "src/shared.spl", locator_kind: "line",
        locator: "2", blob_id: "blob-a")

fn viewer_graph() -> TraceGraph:
    TraceGraph(subject: viewer_subject(), input_manifest_id: "inputs-a", nodes: [
        TraceNode(id: "F-a", kind: TraceNodeKind.Feature, title: "Parser"),
        TraceNode(id: "F-b", kind: TraceNodeKind.Feature, title: "Editor"),
        TraceNode(id: "SRC-shared", kind: TraceNodeKind.SourceFile, title: "Shared parser")],
        test_definitions: [], claims: [], edges: [
            TraceEdge(id: "edge-a", from_id: "F-a", relation: TraceRelation.Contains, to_id: "SRC-shared"),
            TraceEdge(id: "edge-b", from_id: "F-b", relation: TraceRelation.Contains, to_id: "SRC-shared")],
        edge_origins: [], origins: [], locators: [viewer_locator()], diagnostics: [],
        generation_id: "generation-a", complete: true)

fn viewer_page(graph: TraceGraph) -> TraceQueryResult:
    query_trace_graph(graph, TraceQuery(snapshot_id: "snapshot-a", selected_id: "",
        direction: "all", limit: 200, cursor: ""))

fn viewer_snapshot() -> SnapshotInput:
    SnapshotInput(subject: viewer_subject(), artifacts: [
        SnapshotArtifact(path: "src/shared.spl", blob_id: "blob-a", content: "old header\nold implementation\nold footer", visibility: "public")], complete: true)

describe "REQ-TRC-015 native Slop projections and session":
    it "selects the same canonical source through both feature aliases":
        var session = SlopSession.new(viewer_graph(), "test.aliases")
        var alias_widgets: [text] = []
        for alias in session.aliases:
            if alias.canonical_id == "SRC-shared" and alias.parent_id != "":
                alias_widgets.push(alias.widget_id)
        expect(alias_widgets.len()).to_equal(2)
        session.dispatch(UIEvent.Action("slop.select:" + alias_widgets[0]))
        expect(session.selected_id).to_equal("SRC-shared")
        session.dispatch(UIEvent.Action("slop.select:" + alias_widgets[1]))
        expect(session.selected_id).to_equal("SRC-shared")
        expect(session.focused_alias).to_equal(alias_widgets[1])
        expect(session.ui.focused_widget()).to_equal(alias_widgets[1])
        expect(WidgetNode(id: "test.aliases.identity").get_prop("content")).to_contain("SRC-shared")
        expect(session.ui.surface_count()).to_equal(1)

    it "moves keyboard focus without changing canonical selection until Enter":
        var session = SlopSession.new(viewer_graph(), "test.keyboard")
        session.dispatch(UIEvent.KeyPress("home"))
        val first = session.focused_alias
        expect(session.selected_id).to_equal("")
        expect(session.ui.focused_widget()).to_equal(first)
        session.dispatch(UIEvent.KeyPress("down"))
        expect(session.focused_alias == first).to_equal(false)
        expect(session.selected_id).to_equal("")
        session.dispatch(UIEvent.KeyPress("enter"))
        expect(session.selected_id).to_equal("SRC-shared")
        expect(session.ui.focused_widget()).to_equal(session.focused_alias)

    it "collapses a feature branch and removes its alias from visible keyboard order":
        var session = SlopSession.new(viewer_graph(), "test.collapse")
        session.dispatch(UIEvent.KeyPress("home"))
        val before = session.visible_alias_ids().len()
        session.dispatch(UIEvent.KeyPress("left"))
        expect(session.visible_alias_ids().len()).to_equal(before - 1)
        session.dispatch(UIEvent.KeyPress("right"))
        expect(session.visible_alias_ids().len()).to_equal(before)

    it "projects only actual edges and preserves relation labels":
        val edges = slop_draw_edges(viewer_page(viewer_graph()))
        expect(edges.len()).to_equal(2)
        expect(edges[0].source).to_equal("F-a")
        expect(edges[0].target).to_equal("SRC-shared")
        expect(edges[0].style[0].value).to_equal("contains")
        expect(edges[0].points[1].x).to_equal(800)

    it "keeps page completeness separate from graph completeness":
        var graph = viewer_graph()
        graph.complete = false
        val page = viewer_page(graph)
        expect(slop_scope_label(page, graph.complete)).to_contain("INCOMPLETE INPUT")
        val limited = query_trace_graph(viewer_graph(), TraceQuery(snapshot_id: "snapshot-a",
            selected_id: "", direction: "all", limit: 1, cursor: ""))
        expect(limited.nodes.len()).to_equal(1)
        expect(limited.total_count).to_equal(3)
        expect(slop_scope_label(limited, true)).to_contain("partial page")

    it "never labels graph links as passing executions":
        val session = SlopSession.new(viewer_graph(), "test.evidence")
        expect(session.evidence_status).to_contain("qualification unavailable")
        expect(WidgetNode(id: "test.evidence.evidence").get_prop("content")).to_contain("do not prove")

    it "rejects metadata-shaped action strings without changing selection":
        var session = SlopSession.new(viewer_graph(), "test.actions")
        val result = session.dispatch(UIEvent.Action("slop.select:../../arbitrary"))
        match result:
            case Err(message): expect(message).to_equal("unknown Slop action")
            case Ok(value): expect(value).to_equal("unexpected successful action")
        expect(session.selected_id).to_equal("")

describe "REQ-TRC-020 pinned source inspection":
    it "loads the selected entity into the live native source widget":
        var session = SlopSession.new(viewer_graph(), "test.load")
        for alias in session.aliases:
            if alias.canonical_id == "SRC-shared" and alias.parent_id == "":
                session.select_alias(alias.widget_id)
        session.load_source(viewer_snapshot(), 2, 2)
        expect(WidgetNode(id: "test.load.source.content").get_prop("content")).to_equal("old implementation")
        expect(WidgetNode(id: "test.load.source.identity").get_prop("content")).to_contain("blob-a snapshot snapshot-a")

    it "reads the requested range from frozen snapshot content":
        val result = slop_source_slice(viewer_snapshot(), "snapshot-a", viewer_locator(), 2, 2)
        match result:
            case Ok(slice):
                expect(slice.content).to_equal("old implementation")
                expect(slice.blob_id).to_equal("blob-a")
                expect(slice.start_line).to_equal(2)
                expect(slice.end_line).to_equal(2)
            case Err(message): expect(message).to_equal("unexpected source error")

    it "rejects another snapshot and a missing pinned blob":
        val wrong_snapshot = slop_source_slice(viewer_snapshot(), "snapshot-b", viewer_locator(), 1, 2)
        match wrong_snapshot:
            case Err(message): expect(message).to_equal("source snapshot mismatch")
            case Ok(slice): expect(slice.snapshot_id).to_equal("unexpected successful source")
        var locator = viewer_locator()
        locator.blob_id = "blob-b"
        match slop_source_slice(viewer_snapshot(), "snapshot-a", locator, 1, 2):
            case Err(message): expect(message).to_equal("source blob mismatch")
            case Ok(slice): expect(slice.blob_id).to_equal("unexpected successful blob")

    it "rejects traversal and oversized source windows":
        expect(slop_source_path_valid("../secret")).to_equal(false)
        expect(slop_source_path_valid("C:/secret")).to_equal(false)
        expect(slop_source_path_valid("src/../secret")).to_equal(false)
        match slop_source_slice(viewer_snapshot(), "snapshot-a", viewer_locator(), 1, 201):
            case Err(message): expect(message).to_contain("1 to 200")
            case Ok(slice): expect(slice.content).to_equal("unexpected oversized source")

    it "rejects stale source responses after changing selected entity":
        var session = SlopSession.new(viewer_graph(), "test.source")
        for alias in session.aliases:
            if alias.canonical_id == "F-a":
                session.select_alias(alias.widget_id)
        val source = SourceSlice(snapshot_id: "snapshot-a", blob_id: "blob-a", path: "src/shared.spl",
            start_line: 2, end_line: 2, content: "old implementation")
        match session.accept_source("SRC-shared", source):
            case Err(message): expect(message).to_equal("stale source response")
            case Ok(value): expect(value).to_equal("unexpected accepted source")
        expect(session.source).to_be_nil()
