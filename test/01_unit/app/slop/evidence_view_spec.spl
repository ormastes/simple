# @tag:in-development
use std.spec.*
use std.common.traceability.evidence_model.*
use std.common.traceability.model.{TraceTestKind}
use app.slop.evidence.{slop_evidence_text}

describe "REQ-TRC-013 evaluator-owned evidence presentation":
    it "keeps an acceptance verification separate from unit not-run and retains reasons":
        val qualification = TraceQualification(subject_id: "snapshot-a", run_id: "run-a", results: [
            TraceObligationResult(obligation_id: "acceptance", requirement_id: "REQ-1", criterion_id: "AC-1",
                test_kind: TraceTestKind.Acceptance, status: TraceQualificationStatus.Verified,
                selected_observation_ids: ["observation-a"], reasons: ["current run observation"]),
            TraceObligationResult(obligation_id: "unit", requirement_id: "REQ-1", criterion_id: "AC-1",
                test_kind: TraceTestKind.Unit, status: TraceQualificationStatus.NotRun,
                selected_observation_ids: [], reasons: ["unit definition linked, not executed"])],
            structural_covered: 2, structural_total: 2, execution_covered: 1, execution_total: 2,
            complete: false)
        val text = slop_evidence_text(qualification, "REQ-1")
        expect(text).to_contain("acceptance [acceptance]: verified")
        expect(text).to_contain("unit [unit]: not_run")
        expect(text).to_contain("unit definition linked, not executed")
        expect(text).to_contain("Observation: observation-a")
        expect(text).to_contain("obligations incomplete")
        expect(slop_evidence_text(qualification, "SRC-unrelated")).to_contain("No obligation result is mapped")
