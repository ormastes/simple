# @tag:in-development
use std.spec.*
use std.common.traceability.model.*
use app.slop.session.{SlopSession}
use app.slop.native_frame.{slop_native_composition}

describe "REQ-TRC-015 native graph edge attachment":
    it "attaches actual typed edges to the native widget DrawIR composition":
        val subject = SnapshotSubject(repository_id: "fixture", snapshot_id: "snapshot-a", kind: "committed",
            revision_id: "revision-a", tree_id: "tree-a", object_format: "sha1")
        val graph = TraceGraph(subject: subject, input_manifest_id: "inputs-a", nodes: [
            TraceNode(id: "F-a", kind: TraceNodeKind.Feature, title: "Parser"),
            TraceNode(id: "REQ-a", kind: TraceNodeKind.Requirement, title: "Recover")],
            test_definitions: [], claims: [], edges: [TraceEdge(id: "edge-a", from_id: "F-a",
                relation: TraceRelation.Specifies, to_id: "REQ-a")], edge_origins: [], origins: [],
            locators: [], diagnostics: [], generation_id: "generation-a", complete: true)
        val session = SlopSession.new(graph, "test.frame")
        val frame = slop_native_composition(session, 1200, 800)
        val edges = frame.batches[frame.batches.len() - 1]
        expect(edges.batch_id).to_equal("test.frame.edges")
        expect(edges.commands.len()).to_equal(2)
        expect(edges.commands[0].kind).to_equal("edge")
        expect(edges.commands[1].text_value).to_equal("specifies")
        if val edge = edges.commands[0].edge:
            expect(edge.source).to_equal("test.frame.graph.0")
            expect(edge.target).to_equal("test.frame.graph.1")
            expect(edge.points.len()).to_equal(4)
        else:
            expect(edges.commands[0].kind).to_equal("missing required edge payload")
