"""Authored runner admission regressions; no runtime execution observed."""
use std.spec.*
use app.test.engine_differential_contract.{differential_observation_error, differential_engine_error, differential_certification_exit}

describe "differential certification admission":
    it "rejects whitespace-only output as no answer":
        expect(differential_observation_error("interpret", 0, " \n", "", false)).to_equal("no-stdout")
    it "rejects nonzero exit even with expected output in diagnostic mode":
        expect(differential_observation_error("interpret", 9, "OK", "OK", false)).to_equal("exit=9")
    it "rejects nonzero exit in certification mode":
        expect(differential_observation_error("native", 3, "OK", "OK", true)).to_equal("exit=3")
    it "requires an independent expected marker":
        expect(differential_observation_error("native", 0, "OK", "", true)).to_equal("oracle-missing")
    it "rejects wrong or extra output rather than agreement on wrong output":
        expect(differential_observation_error("interpret", 0, "WRONG", "OK", true)).to_equal("oracle-mismatch")
        expect(differential_observation_error("native", 0, "OK\nEXTRA", "OK", true)).to_equal("oracle-mismatch")
        expect(differential_observation_error("native", 0, "O K", "OK", true)).to_equal("oracle-mismatch")
    it "allows only a single terminal newline convention":
        expect(differential_observation_error("native", 0, "OK\r\n", "OK\n", true)).to_equal("")
        expect(differential_observation_error("native", 0, "OK\n\n", "OK", true)).to_equal("oracle-mismatch")
    it "does not treat requested strict JIT flags as engine evidence":
        expect(differential_observation_error("jit", 0, "OK", "OK", true)).to_equal("engine-witness-unavailable:jit")
    it "rejects duplicate aliases and too few actual engines":
        expect(differential_engine_error(["interpret", "interpreter"])).to_equal("duplicate-engine:interpret")
        expect(differential_engine_error(["native"])).to_equal("at-least-two-engines-required")
        expect(differential_engine_error(["native", "bogus"])).to_equal("unknown-engine:bogus")
        expect(differential_engine_error(["interpret", "native"])).to_equal("")
    it "never certifies a partial or vacuous run":
        expect(differential_certification_exit(4, 1, 0)).to_equal(1)
        expect(differential_certification_exit(4, 0, 1)).to_equal(1)
        expect(differential_certification_exit(0, 0, 0)).to_equal(2)
        expect(differential_certification_exit(4, 0, 0)).to_equal(0)
