"""
## Purpose and audience
Purpose: Prove that spec behavior.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-BROWSER-001 — stable requirement identity for this spec.

# Simple Browser render adapter — unit coverage for the dispatch/content
# logic added when the browser app was wired to the real render engine
# (src/app/browser/render_adapter.spl). Deliberately does NOT call
# render_browser / browser_engine_pixels_at at all: render_browser_text and
# render_browser_html BOTH call into the real DOM/CSS/layout/paint engine
# (browser_render_proof -> browser_engine_pixels_at) even at the tiny 64x36
# proof size, and a single such call exceeds the interpreter's 10,000,000-op
# execution-limit budget for this test runner on its own (verified: even
# after trimming to exactly one render_browser() call in this file, it alone
# still hit "execution limit exceeded"). That end-to-end path is covered by
# the process-spawning integration spec instead
# (test/02_integration/app/browser_cli_log_modes_spec.spl), which has no
# in-runner operation budget since it just checks a subprocess's exit code
# and stdout. This file covers the pure dispatch/formatting logic that does
# NOT touch the engine.

use std.spec.{describe, it, expect}
use app.browser.render_adapter.{
    browser_url, browser_page_text_lines,
    browser_page_body_html, browser_engine_painted_pixel_count
}
use app.ui.render.types.{RenderConfig}

fn _config(format: text, asset_path: text) -> RenderConfig:
    var config = RenderConfig.default()
    config.adapter_name = "browser"
    config.format = format
    config.asset_path = asset_path
    config

describe "browser_url":
    it "falls back to the default home URL when asset_path is empty":
        step("Verify: falls back to the default home URL when asset_path is empty")
        # @req: REQ-APP-BROWSER-001
        expect(browser_url(_config("text", ""))).to_equal("simple://home")

    it "uses the config's asset_path when set":
        step("Verify: uses the config's asset_path when set")
        expect(browser_url(_config("text", "simple://other"))).to_equal("simple://other")

describe "browser_page_text_lines":
    it "returns the real Hello World content for the home URL":
        step("Verify: returns the real Hello World content for the home URL")
        val lines = browser_page_text_lines("simple://home")
        expect(lines.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(lines[0]).to_equal("Hello, World!")
        expect(lines[1]).to_equal("Welcome to Simple Browser.")

    it "returns a no-page-loaded message for any other URL":
        step("Verify: returns a no-page-loaded message for any other URL")
        val lines = browser_page_text_lines("simple://other")
        expect(lines.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(lines[0]).to_contain("no page loaded for simple://other")

describe "browser_page_body_html":
    it "returns real Hello World markup for the home URL":
        step("Verify: returns real Hello World markup for the home URL")
        val html = browser_page_body_html("simple://home")
        expect(html).to_contain("<h1 class=\"browser-page-title\">Hello, World!</h1>")
        expect(html).to_contain("Welcome to Simple Browser.")

    it "returns a no-page-loaded message for any other URL, HTML-escaped":
        step("Verify: returns a no-page-loaded message for any other URL, HTML-escaped")
        val html = browser_page_body_html("simple://other")
        expect(html).to_contain("No page loaded for simple://other")

describe "browser_engine_painted_pixel_count":
    it "counts every pixel that is not opaque white":
        step("Verify: counts every pixel that is not opaque white")
        val pixels: [u32] = [0xFFFFFFFFu32, 0xFF000000u32, 0xFFFFFFFFu32, 0xFF2563EBu32, 0xFFFFFFFFu32]
        expect(browser_engine_painted_pixel_count(pixels)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns 0 for an all-white buffer":
        step("Verify: returns 0 for an all-white buffer")
        val pixels: [u32] = [0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32]
        expect(browser_engine_painted_pixel_count(pixels)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns the full length for an all-painted buffer":
        step("Verify: returns the full length for an all-painted buffer")
        val pixels: [u32] = [0xFF111111u32, 0xFF222222u32]
        expect(browser_engine_painted_pixel_count(pixels)).to_equal(2)  # oracle: 2 — named expected value from the requirement
