# src/app/mcp/bugdb_resource.spl must load and enforce the close gate
# (it imports bug_close_gate from std.database.bug_close_gate).
# @req CU-015
# @cover src/app/mcp/bugdb_resource.spl

use std.spec.{describe, it, expect, step}
use app.mcp.bugdb_resource.{update_bug_from_json, get_all_bugs}
use std.database.bug.{create_bug_database, Bug, BugSeverity, BugStatus}

extern fn rt_getpid() -> i64

fn fixture_db(name: text) -> text:
    val path = "/tmp/app_bugdb_load_{name}_{rt_getpid()}.sdn"
    var db = create_bug_database(path)
    val bug = Bug(id: "b1", severity: BugSeverity.P2, status: BugStatus.Open, title: "t",
        description: ["d"], file: "src/a.spl", line: 1, reproducible_by: "r",
        fix_strategy: [], investigation_log: [], created_at: "2026-11-15",
        updated_at: "2026-11-15", valid: true)
    db.add_bug(bug)
    db.save()
    path

describe "app.mcp.bugdb_resource":
    it "loads and rejects a Closed transition without evidence":
        step("close without reproducer/prevention is refused through bug_close_gate")
        val path = fixture_db("a")
        expect(update_bug_from_json(path, "b1", "\{\"status\":\"Closed\"\}")).to_contain("close rejected")

    # Similar pattern: the same gate guards the Fixed transition and missing files.
    it "rejects Fixed with nonexistent evidence paths and still allows non-closing edits":
        step("nonexistent specs refused; title edit allowed")
        val path = fixture_db("b")
        val body = "\{\"status\":\"Fixed\",\"reproducer\":\"test/no_a_spec.spl\",\"prevention\":\"test/no_b_spec.spl\"\}"
        expect(update_bug_from_json(path, "b1", body)).to_contain("reproducer spec not found")
        expect(update_bug_from_json(path, "b1", "\{\"title\":\"new\"\}")).to_contain("success")
        expect(get_all_bugs(path)).to_contain("b1")
