"""
# MCP Context Tools Specification

**Requirements:** N/A

## Overview

Guards the repo-native replacement for the user-level "context-mode" plugin:
`simple_ctx_index` / `simple_ctx_search` / `simple_ctx_execute` /
`simple_ctx_execute_file` / `simple_ctx_batch_execute` /
`simple_ctx_fetch_and_index` / `simple_ctx_stats` / `simple_ctx_doctor` /
`simple_ctx_upgrade` in `app.mcp.main_lazy_ctx_tools`, and their registration
in the dispatcher.

Every store-touching scenario points `SIMPLE_CTX_DIR` at a scratch directory
so the repo's own `.simple/ctx/` is never written by a test run.

## Behavior

- Index then search returns a ranked hit carrying the chunk's source label.
- Batch execute runs commands, indexes their output, and answers queries in
  one call.
- Execute returns stdout only (stderr summarized to one line) and honors the
  wall timeout.
- Fetch refuses non-http URLs, caps the body, strips tags, and reports an
  unreachable host as a tool error rather than a crash — no network needed.
- Doctor reports the store dir, index row count, orphan chunks, schema
  version and hook-file presence as a pass/fail checklist.
- Upgrade rewrites the chunk store under the current schema, dropping any
  orphan (empty-body) rows and reporting before/after counts.
- All nine tools are routed by `dispatch_tool`.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.io_runtime.{env_set, env_get, dir_create, dir_remove_all, file_exists, file_write, time_now_unix_micros}
use app.mcp.main_lazy_ctx_tools.{ctx_escape_cell, ctx_unescape_cell, ctx_chunk_text, ctx_tokenize, ctx_parse_string_array, ctx_unescape_json, ctx_index_text, ctx_html_to_text, ctx_cap_bytes, ctx_fetch_allowed_url, ctx_stats_text, ctx_store_dir}
use app.mcp.main_lazy_ctx_tools.{handle_simple_ctx_index, handle_simple_ctx_search, handle_simple_ctx_execute, handle_simple_ctx_execute_file, handle_simple_ctx_batch_execute, handle_simple_ctx_fetch_and_index, handle_simple_ctx_stats, handle_simple_ctx_doctor, handle_simple_ctx_upgrade, ctx_doctor_text, ctx_upgrade_store, ctx_schema_version}
use app.mcp.main_dispatch.{dispatch_tool}

fn _fresh_store() -> text:
    var base = env_get("SIMPLE_TEST_TMP") ?? ""
    if base == "":
        base = "build/tmp"
    val dir = base + "/simple_ctx_spec_" + str(time_now_unix_micros())
    dir_remove_all(dir)
    dir_create(dir, true)
    env_set("SIMPLE_CTX_DIR", dir)
    dir

fn _idx(s: text, needle: text) -> i64:
    s.index_of(needle)

describe "ctx store cell escaping and chunking":
    it "round-trips quotes, commas, newlines and backslashes through one SDN cell":
        val raw = "a \"quoted\" line, with commas\nand a\ttab and back\\slash"
        val cell = ctx_escape_cell(raw)
        assert_false(cell.contains("\n"))
        assert_false(cell.contains("\""))
        assert_equal(ctx_unescape_cell(cell), raw)

    it "splits long text on line boundaries under the chunk budget":
        var lines: [text] = []
        var i = 0
        while i < 40:
            lines.push("line number " + str(i) + " padding padding padding")
            i = i + 1
        val chunks = ctx_chunk_text(lines.join("\n"), 200)
        assert_true(chunks.len() > 3)
        for c in chunks:
            assert_true(c.len() <= 200)

    it "tokenizes to lowercase word tokens":
        val toks = ctx_tokenize("Hello, World_2 foo-bar X")
        assert_equal(toks.len(), 4)
        assert_equal(toks[0], "hello")
        assert_equal(toks[1], "world_2")

    it "parses a JSON string array and a bare string":
        val arr = ctx_parse_string_array("[\"a b\", \"c\\\"d\", \"e\\nf\"]")
        assert_equal(arr.len(), 3)
        assert_equal(arr[1], "c\"d")
        assert_equal(arr[2], "e\nf")
        val one = ctx_parse_string_array("\"solo\"")
        assert_equal(one.len(), 1)
        assert_equal(ctx_unescape_json("x\\ty"), "x\ty")

describe "simple_ctx_index -> simple_ctx_search":
    it "returns a ranked hit carrying the source label, persisted on disk":
        val dir = _fresh_store()
        val body_a = "{\"content\":\"the parser reads tokens and builds an ast for the compiler\",\"source\":\"doc:parser\"}"
        val body_b = "{\"content\":\"the linker resolves symbols and writes the final binary image\",\"source\":\"doc:linker\"}"
        val r1 = handle_simple_ctx_index("1", body_a)
        assert_contains(r1, "Indexed 1 chunk")
        val r2 = handle_simple_ctx_index("2", body_b)
        assert_contains(r2, "doc:linker")
        assert_true(file_exists(dir + "/chunks.sdn"))
        val s = handle_simple_ctx_search("3", "{\"queries\":[\"linker symbols\"]}")
        assert_contains(s, "source=doc:linker")
        assert_contains(s, "score=")
        # The linker chunk must outrank the parser chunk (which has no query term).
        val pos_linker = _idx(s, "source=doc:linker")
        val pos_parser = _idx(s, "source=doc:parser")
        assert_true(pos_parser < 0 or pos_linker < pos_parser)

    it "survives a second store open (persistent across process boundaries)":
        val dir = _fresh_store()
        assert_equal(ctx_index_text("alpha bravo charlie", "s1"), 1)
        assert_equal(ctx_index_text("delta echo foxtrot", "s2"), 1)
        # A fresh handler call re-reads the SDN file from disk.
        val s = handle_simple_ctx_search("4", "{\"query\":\"foxtrot\",\"source\":\"s2\"}")
        assert_contains(s, "source=s2")
        assert_false(s.contains("source=s1"))
        val stats = ctx_stats_text()
        assert_contains(stats, "chunks: 2")
        assert_contains(stats, "sources: 2")
        assert_contains(stats, "bytes_saved:")
        assert_contains(handle_simple_ctx_stats("5", "{}"), "chunks: 2")

describe "simple_ctx_batch_execute":
    it "runs commands, indexes their output and answers queries in one call":
        _fresh_store()
        val body = "{\"commands\":[\"echo alpha beta gamma\",\"echo delta epsilon\"],\"queries\":[\"gamma\"],\"source\":\"batch:spec\"}"
        val r = handle_simple_ctx_batch_execute("6", body)
        assert_contains(r, "2 command(s) indexed under 'batch:spec'")
        assert_contains(r, "[0] exit 0")
        assert_contains(r, "[1] exit 0")
        assert_contains(r, "## query: gamma (1 hit(s))")
        assert_contains(r, "source=batch:spec#0")

describe "simple_ctx_execute / simple_ctx_execute_file":
    it "returns stdout only and summarizes stderr to one line":
        _fresh_store()
        val r = handle_simple_ctx_execute("7", "{\"language\":\"shell\",\"code\":\"echo visible-out; echo noisy-err 1>&2; echo noisy-err-2 1>&2\"}")
        assert_contains(r, "visible-out")
        assert_contains(r, "(exit: 0")
        assert_contains(r, "stderr: 2 line(s)")
        assert_false(r.contains("noisy-err-2"))

    it "honors timeout_ms":
        _fresh_store()
        val r = handle_simple_ctx_execute("8", "{\"language\":\"shell\",\"code\":\"sleep 20; echo never\",\"timeout_ms\":\"700\"}")
        assert_contains(r, "TIMEOUT")
        assert_false(r.contains("never\\n"))

    it "rejects an unknown language and a missing code parameter":
        val r = handle_simple_ctx_execute("9", "{\"language\":\"cobol\",\"code\":\"x\"}")
        assert_contains(r, "Unsupported language")
        val m = handle_simple_ctx_execute("10", "{\"language\":\"shell\"}")
        assert_contains(m, "Missing required parameter: code")

    it "exposes the file path to the code as $1 and $FILE":
        val dir = _fresh_store()
        val path = dir + "/sample.txt"
        file_write(path, "one\ntwo\nthree\n")
        val r = handle_simple_ctx_execute_file("11", "{\"language\":\"shell\",\"path\":\"" + path + "\",\"code\":\"wc -l < \\\"$1\\\"; test \\\"$FILE\\\" = \\\"$1\\\" && echo same\"}")
        assert_contains(r, "3")
        assert_contains(r, "same")
        val missing = handle_simple_ctx_execute_file("12", "{\"language\":\"shell\",\"path\":\"" + dir + "/nope\",\"code\":\"true\"}")
        assert_contains(missing, "no such file")

describe "simple_ctx_fetch_and_index":
    it "caps bytes and strips tags without network":
        val (capped, was_capped) = ctx_cap_bytes("0123456789", 4)
        assert_equal(capped, "0123")
        assert_true(was_capped)
        val (same, not_capped) = ctx_cap_bytes("abc", 10)
        assert_equal(same, "abc")
        assert_false(not_capped)
        val plain = ctx_html_to_text("<html><body><h1>Title</h1>\n\n\n<p>Body &amp; more</p><script>alert(1)</script></body></html>")
        assert_contains(plain, "Title")
        assert_contains(plain, "Body & more")
        assert_false(plain.contains("<p>"))
        assert_true(ctx_fetch_allowed_url("https://example.org/x"))
        assert_false(ctx_fetch_allowed_url("file:///etc/passwd"))

    it "refuses non-http URLs and reports an unreachable host as a tool error":
        _fresh_store()
        val bad = handle_simple_ctx_fetch_and_index("13", "{\"url\":\"file:///etc/passwd\",\"source\":\"x\"}")
        assert_contains(bad, "only http:// and https://")
        val down = handle_simple_ctx_fetch_and_index("14", "{\"url\":\"http://127.0.0.1:1/nothing\",\"source\":\"x\",\"max_bytes\":\"1024\"}")
        assert_not_equal(down, "")
        assert_contains(down, "simple_ctx_fetch_and_index")
        assert_false(down.contains("Fetched http://127.0.0.1:1/nothing"))

describe "simple_ctx_doctor":
    it "reports a pass/fail checklist covering dir, rows, orphans, schema and hooks":
        _fresh_store()
        ctx_index_text("alpha bravo charlie", "s1")
        val r = handle_simple_ctx_doctor("15", "{}")
        assert_contains(r, "[ok] store dir")
        assert_contains(r, "store dir is writable")
        assert_contains(r, "index row count: 1")
        assert_contains(r, "orphan chunks (empty body): 0")
        assert_contains(r, "hook file present: .claude/hooks/ctx_common.shs")
        assert_contains(ctx_doctor_text(), "index row count: 1")

    it "flags a store written before the schema stamp existed":
        val dir = _fresh_store()
        file_write(dir + "/chunks.sdn", "ctx_chunks | id, source, ts, bytes, text |\n    1, legacy, 1, 5, hello\n")
        assert_equal(ctx_schema_version(), 0)
        val r = handle_simple_ctx_doctor("16", "{}")
        assert_contains(r, "[FAIL] chunk store schema is current")

describe "simple_ctx_upgrade":
    it "re-stamps the schema and reports before/after counts, dropping orphans":
        val dir = _fresh_store()
        file_write(dir + "/chunks.sdn", "ctx_chunks | id, source, ts, bytes, text |\n    1, legacy, 1, 5, hello\n    2, legacy, 1, 0, \n")
        assert_equal(ctx_schema_version(), 0)
        val r = handle_simple_ctx_upgrade("17", "{}")
        assert_contains(r, "schema v0 -> v1")
        assert_contains(r, "chunks 2 -> 1")
        assert_contains(r, "1 orphan/empty chunk(s) dropped")
        assert_equal(ctx_schema_version(), 1)
        # Idempotent: a second run on an already-upgraded store changes nothing.
        val r2 = handle_simple_ctx_upgrade("18", "{}")
        assert_contains(r2, "schema v1 -> v1")
        assert_contains(r2, "chunks 1 -> 1")

describe "dispatcher registration":
    it "routes every simple_ctx_* tool instead of returning Unknown tool":
        _fresh_store()
        val names = ["simple_ctx_index", "simple_ctx_search", "simple_ctx_execute", "simple_ctx_execute_file", "simple_ctx_batch_execute", "simple_ctx_fetch_and_index", "simple_ctx_stats", "simple_ctx_doctor", "simple_ctx_upgrade"]
        for n in names:
            val r = dispatch_tool("20", n, "{}")
            assert_not_equal(r, "")
            assert_false(r.contains("Unknown tool"))
            assert_false(r.contains("Unknown in-process tool"))
        assert_contains(dispatch_tool("21", "simple_ctx_stats", "{}"), "chunks: 0")

describe "execute return cap (parity: context-mode 100 KB smart truncation)":
    it "truncates a >100 KB stdout to head+tail, indexes the full output and names the search source":
        _fresh_store()
        # 6000 lines x ~36 B ~= 214 KB; the 60/40 head+tail window keeps
        # roughly lines 0..1700 and 4860..5999, so a marker at 3000 is cut.
        val code = "i=0; while [ $i -lt 6000 ]; do if [ $i -eq 3000 ]; then echo MIDDLEMARKERZQ; else echo line-$i-padding-padding-padding-pad; fi; i=$((i+1)); done"
        val r = handle_simple_ctx_execute("30", "{\"language\":\"shell\",\"code\":\"" + code + "\",\"timeout_ms\":\"60000\"}")
        assert_contains(r, "line-0-")
        assert_contains(r, "line-5999-")
        assert_false(r.contains("MIDDLEMARKERZQ"))
        assert_contains(r, "truncated")
        assert_contains(r, "simple_ctx_search")
        assert_contains(r, "source: 'exec:")
        assert_true(r.len() < 110000)
        # The dropped middle is still reachable through the store.
        val s = handle_simple_ctx_search("31", "{\"queries\":[\"MIDDLEMARKERZQ\"]}")
        assert_contains(s, "MIDDLEMARKERZQ (1 hit(s))")
        assert_contains(s, "source=exec:")

    it "returns a <100 KB stdout untouched and indexes nothing":
        _fresh_store()
        val r = handle_simple_ctx_execute("32", "{\"language\":\"shell\",\"code\":\"seq 1 200\"}")
        assert_contains(r, "200")
        assert_false(r.contains("truncated"))
        assert_contains(handle_simple_ctx_stats("33", "{}"), "chunks: 0")

describe "search quality (parity: stopwords, code-token fallback)":
    it "ignores stopwords in the query but still answers a stopword-only query":
        _fresh_store()
        assert_equal(ctx_index_text("the cat sat on the mat", "doc:a"), 1)
        assert_equal(ctx_index_text("a dog in the park", "doc:b"), 1)
        val s = handle_simple_ctx_search("34", "{\"queries\":[\"the mat\"]}")
        assert_contains(s, "the mat (1 hit(s))")
        assert_contains(s, "source=doc:a")
        val only = handle_simple_ctx_search("35", "{\"queries\":[\"the\"]}")
        assert_contains(only, "the (2 hit(s))")

    it "falls back to substring matching for a partial code token with no BM25 hit":
        _fresh_store()
        assert_equal(ctx_index_text("val n = rt_string_len(s)\nreturn n", "code:len"), 1)
        assert_equal(ctx_index_text("unrelated words only", "code:other"), 1)
        val s = handle_simple_ctx_search("36", "{\"queries\":[\"string_len\"]}")
        assert_contains(s, "string_len (1 hit(s))")
        assert_contains(s, "source=code:len")
        assert_contains(s, "match=substring")
        assert_false(s.contains("source=code:other"))

    it "keeps BM25 as the primary ranking with the shorter document first":
        _fresh_store()
        var filler: [text] = []
        var i = 0
        while i < 400:
            filler.push("filler" + str(i))
            i = i + 1
        # A >1,200-char single line splits into several fixed-width chunks.
        assert_true(ctx_index_text("alpha " + filler.join(" "), "doc:long") >= 1)
        assert_equal(ctx_index_text("alpha beta", "doc:short"), 1)
        val s = handle_simple_ctx_search("37", "{\"queries\":[\"alpha\"]}")
        assert_contains(s, "alpha (2 hit(s))")
        assert_contains(s, "match=bm25")
        assert_true(_idx(s, "source=doc:short") < _idx(s, "source=doc:long"))
