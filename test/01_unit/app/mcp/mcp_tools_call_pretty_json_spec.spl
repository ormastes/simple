"""
# MCP tools/call — pretty-printed request JSON

**Requirements:** N/A

## Overview

Reproduce spec for defect A of `scratchpad/mcp_token_ab_REPORT.md` §2.3:
`simple_mcp_server` answered `-32602 Missing tool name` to every `tools/call`
whose JSON carried whitespace after `:` / `,` — the form every
pretty-printing client emits (`json.dumps(x)` in Python,
`JSON.stringify(x, null, 2)` in JS). The serve loop in `src/app/mcp/main.spl`
takes the tool name from `app_extract_str(params, "name")`
(`std.mcp_sdk.server.app`), which searched for the literal `"name":"`.

## Behavior

- `app_extract_str` accepts spaces, tabs and newlines around the colon.
- `app_extract_obj` (params / arguments) accepts the same forms.
- The name recovered from a pretty-printed request dispatches to the real
  tool instead of the `-32602 Missing tool name` error.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.mcp_sdk.server.app.{app_extract_str, app_extract_obj, app_extract_id}
use std.mcp_sdk.server.method_detect.{has_method}
use app.mcp.main_dispatch.{dispatch_tool}

fn _compact() -> text:
    "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"tools/call\",\"params\":{\"name\":\"simple_token_stats\",\"arguments\":{\"reset\":false}}}"

# json.dumps(x): one line, a space after every ':' and ','.
fn _dumps() -> text:
    "{\"jsonrpc\": \"2.0\", \"id\": 10, \"method\": \"tools/call\", \"params\": {\"name\": \"simple_token_stats\", \"arguments\": {\"reset\": false}}}"

# JSON.stringify(x, null, 2): multi-line, two-space indent.
fn _stringify() -> text:
    "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 10,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"simple_token_stats\",\n    \"arguments\": {\n      \"reset\": false\n    }\n  }\n}"

describe "tools/call request parsing":
    it "extracts the tool name from compact, json.dumps and JSON.stringify forms":
        for msg in [_compact(), _dumps(), _stringify()]:
            assert_true(has_method(msg, "tools/call"))
            assert_equal(app_extract_id(msg), "10")
            val params = app_extract_obj(msg, "params")
            assert_not_equal(params, "")
            assert_equal(app_extract_str(params, "name"), "simple_token_stats")
            assert_contains(app_extract_obj(params, "arguments"), "\"reset\"")

    it "tolerates tabs and CRLF around the colon and still stops at the closing quote":
        assert_equal(app_extract_str("{\"name\"\t:\t\"a b\"}", "name"), "a b")
        assert_equal(app_extract_str("{\"name\":\r\n  \"x\\\"y\"}", "name"), "x\\\"y")
        assert_equal(app_extract_str("{\"name\": 42}", "name"), "")
        assert_equal(app_extract_str("{\"other\": \"v\"}", "name"), "")

    it "dispatches a pretty-printed call to the real tool instead of -32602":
        val params = app_extract_obj(_stringify(), "params")
        val name = app_extract_str(params, "name")
        val r = dispatch_tool("10", name, app_extract_obj(params, "arguments"))
        assert_false(r.contains("Missing tool name"))
        assert_false(r.contains("-32602"))
        assert_contains(r, "token stats store")
