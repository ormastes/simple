use app.mcp.assistant.session_store_helpers.{
    ASSISTANT_STORE_ROOT, ASSISTANT_STORE_SESSIONS, ASSISTANT_STORE_TIMELINES,
    ASSISTANT_STORE_NOTIFICATIONS, ASSISTANT_STORE_DIGESTS,
    assistant_store_resolve_root, assistant_store_sessions_dir, assistant_store_timelines_dir
}

describe "assistant store public path constants":
    it "preserves the default root and derived path suffixes":
        expect(ASSISTANT_STORE_ROOT).to_equal(".build/llm_dashboard/assistant")
        expect(ASSISTANT_STORE_SESSIONS).to_equal(ASSISTANT_STORE_ROOT + "/sessions")
        expect(ASSISTANT_STORE_TIMELINES).to_equal(ASSISTANT_STORE_ROOT + "/timelines")
        expect(ASSISTANT_STORE_NOTIFICATIONS).to_equal(ASSISTANT_STORE_ROOT + "/notifications")
        expect(ASSISTANT_STORE_DIGESTS).to_equal(ASSISTANT_STORE_ROOT + "/digests")

    it "uses the defaults for an empty root and preserves an explicit root":
        expect(assistant_store_resolve_root("")).to_equal(ASSISTANT_STORE_ROOT)
        expect(assistant_store_sessions_dir("")).to_equal(ASSISTANT_STORE_SESSIONS)
        expect(assistant_store_timelines_dir("")).to_equal(ASSISTANT_STORE_TIMELINES)
        expect(assistant_store_resolve_root("custom-root")).to_equal("custom-root")
        expect(assistant_store_sessions_dir("custom-root")).to_equal("custom-root/sessions")
