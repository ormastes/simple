"""
# MCP Context Tools — real-scale batch execution

**Requirements:** N/A

## Overview

Reproduce spec for the two defects the 2026-08-27 token A/B lane found in
`simple_ctx_batch_execute` (`scratchpad/mcp_token_ab_REPORT.md` §2.2/§2.3):
the tool crashed the server with `cannot iterate over this type:
StrBytes(...)` on real command output (non-UTF-8 bytes from `git log` /
`grep`), and hung for ~18 minutes on a 30 KB log, while toy inputs worked.

Root cause: every hot path over captured output was a per-character
`for ch in s` loop (cell unescape, JSON unescape, tokenizer), the store was
parsed by the generic per-character SDN parser and re-read + rewritten on
every index call, and BM25 re-tokenized every chunk once per query. The
interpreter's for-in has no `StrBytes` arm, so the first non-UTF-8 byte
killed the process; when the module ran interpreted the per-char loops cost
~6.5 us/char, so multi-MB output took minutes per pass.

## Behavior

- A command whose output carries non-UTF-8 bytes is captured, indexed and
  searchable; the server does not die.
- Multi-MB output (hundreds of thousands of lines) is indexed and searched
  in seconds, and an exact whole-word query finds exactly its chunk.
- Each command's capture is bounded by `capture_bytes` (param) or
  `SIMPLE_CTX_CAPTURE_MAX_BYTES` (env; default 8 MiB), a truncated capture is
  marked in the batch line and counted in `simple_ctx_stats`.
- The linear row reader skips a torn trailing row and reads quoted cells.
- Escaped-backslash sequences round-trip through the segment unescaper.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.io_runtime.{env_set, env_get, dir_create, dir_remove_all, file_exists, file_write, file_read, time_now_unix_micros}
use app.mcp.main_lazy_ctx_tools.{handle_simple_ctx_batch_execute, handle_simple_ctx_search, ctx_stats_text, ctx_capture_max_bytes, ctx_index_text, ctx_unescape_cell, ctx_unescape_json, ctx_normalize, ctx_tokenize, ctx_bm25_search, CtxChunk}

fn _fresh_store() -> text:
    var base = env_get("SIMPLE_TEST_TMP") ?? ""
    if base == "":
        base = "build/tmp"
    val dir = base + "/simple_ctx_scale_spec_" + str(time_now_unix_micros())
    dir_remove_all(dir)
    dir_create(dir, true)
    env_set("SIMPLE_CTX_DIR", dir)
    env_set("SIMPLE_CTX_CAPTURE_MAX_BYTES", "")
    dir

fn _ms() -> i64:
    time_now_unix_micros() / 1000

describe "simple_ctx_batch_execute on real-scale output":
    it "captures, indexes and searches output that carries non-UTF-8 bytes":
        _fresh_store()
        # \377\376 is never valid UTF-8: the captured text is a StrBytes value.
        val body = "{\"commands\":[\"printf 'src/lib/x.spl:1: rt_alpha \\\\377\\\\376 tail\\\\n'\"],\"queries\":[\"rt_alpha\"],\"source\":\"batch:bytes\"}"
        val r = handle_simple_ctx_batch_execute("1", body)
        assert_contains(r, "[0] exit 0")
        assert_contains(r, "## query: rt_alpha (1 hit(s))")
        assert_contains(r, "source=batch:bytes#0")
        # The stored chunk is searchable again from a fresh load.
        val s = handle_simple_ctx_search("2", "{\"query\":\"rt_alpha\",\"source\":\"batch:bytes\"}")
        assert_contains(s, "source=batch:bytes#0")

    it "indexes multi-MB output in seconds and finds an exact whole-word hit":
        _fresh_store()
        # ~3.5 MB / 200k lines of filler plus one distinctive line at the end.
        # The token is assembled at runtime so the `$ cmd` header line indexed
        # with the output does not itself contain it.
        val cmd = "seq 1 200000 | sed 's/^/line number /'; printf 'the needle_%s token\\\\n' zebra"
        val body = "{\"commands\":[\"" + cmd + "\"],\"queries\":[\"needle_zebra\",\"line number 199999\"],\"source\":\"batch:big\",\"timeout_ms\":120000}"
        val t0 = _ms()
        val r = handle_simple_ctx_batch_execute("3", body)
        val wall = _ms() - t0
        assert_contains(r, "[0] exit 0")
        assert_contains(r, "## query: needle_zebra (1 hit(s))")
        assert_contains(r, "## query: line number 199999 (")
        assert_false(r.contains("capture truncated"))
        # Chunk count proves the whole output was indexed, not a head.
        val stats = ctx_stats_text()
        assert_contains(stats, "capture_truncations: 0")
        var chunks: i64 = 0
        for line in stats.split("\n"):
            if line.starts_with("chunks: "):
                chunks = line.substring(8).to_int() ?? 0
        assert_true(chunks > 2000)
        # Pre-fix this hung for minutes (or crashed); the budget is generous
        # for a loaded shared box but far below the failure mode.
        print("batch 3.5MB wall_ms=" + str(wall) + " chunks=" + str(chunks))
        assert_true(wall < 90000)

    it "bounds each command's capture and records the truncation":
        _fresh_store()
        val body = "{\"commands\":[\"yes abcdefgh | head -c 50000\"],\"queries\":[],\"source\":\"batch:cap\",\"capture_bytes\":4096}"
        val r = handle_simple_ctx_batch_execute("4", body)
        assert_contains(r, "[0] exit 0")
        assert_contains(r, "[capture truncated at 4096 bytes]")
        val stats = ctx_stats_text()
        assert_contains(stats, "capture_truncations: 1")
        # Env override and hard clamp.
        assert_equal(ctx_capture_max_bytes(), 8388608)
        env_set("SIMPLE_CTX_CAPTURE_MAX_BYTES", "1500")
        assert_equal(ctx_capture_max_bytes(), 1500)
        assert_contains(ctx_stats_text(), "capture_max_bytes: 1500")
        env_set("SIMPLE_CTX_CAPTURE_MAX_BYTES", "999999999999")
        assert_equal(ctx_capture_max_bytes(), 67108864)
        env_set("SIMPLE_CTX_CAPTURE_MAX_BYTES", "")

describe "linear store reader and unescaper":
    it "reads quoted cells and skips a torn trailing row":
        val dir = _fresh_store()
        file_write(dir + "/chunks.sdn", "ctx_chunks | id, source, ts, bytes, text |\n    1, \"src,with,commas\", 7, 11, \"hello, quoted world\"\n    2, plain, 8, 5, other words\n    3, torn")
        val s = handle_simple_ctx_search("5", "{\"query\":\"quoted\",\"source\":\"src,with\"}")
        assert_contains(s, "## query: quoted (1 hit(s))")
        assert_contains(s, "source=src,with,commas chunk=1 ts=7")
        assert_contains(ctx_stats_text(), "chunks: 2")
        # Ids keep counting past the highest stored row.
        assert_equal(ctx_index_text("more text here", "plain"), 1)
        assert_contains(handle_simple_ctx_search("6", "{\"query\":\"more\"}"), "chunk=3 ")

    it "unescapes escaped backslashes and escape codes without a per-char loop":
        assert_equal(ctx_unescape_cell("a\\\\n"), "a\\n")
        assert_equal(ctx_unescape_cell("a\\nb\\tc\\qd\\\\"), "a\nb\tc\"d\\")
        assert_equal(ctx_unescape_cell("no escapes"), "no escapes")
        assert_equal(ctx_unescape_json("x\\\"y\\\\z\\n"), "x\"y\\z\n")
        assert_equal(ctx_unescape_json("keep \\u00e9"), "keep \\u00e9")

    it "normalizes with whole-word framing so term counts are exact":
        assert_equal(ctx_tokenize("Hello, World_2 foo-bar X").len(), 4)
        val n = ctx_normalize("foo foo/foo.bar")
        assert_equal(n.split(" foo ").len() - 1, 3)
        val a = CtxChunk(id: 1, source: "s", ts: 0, bytes: 11, body: "foo foo bar")
        val b = CtxChunk(id: 2, source: "s", ts: 0, bytes: 11, body: "foo baz qux")
        val hits = ctx_bm25_search([b, a], "foo", "", 5)
        assert_equal(hits.len(), 2)
        assert_equal(hits[0].chunk.id, 1)
