# As a caret user driving the MCP host-WM text facade, I want the window
# position I send to survive into the snapshot, so find/act target the
# window where it actually is.
use std.spec.{describe, it, expect}
use app.mcp.main_lazy_play_tools.{handle_play_wm_text_snapshot}

describe "play_wm_text_snapshot host_wm position":
    it "keeps the requested x and y of a host window":
        val body = "{\"source\":\"host_wm\",\"window_id\":\"7\",\"title\":\"W\",\"x\":\"123\",\"y\":\"456\",\"width\":\"640\",\"height\":\"480\"}"
        val out = handle_play_wm_text_snapshot("1", body)
        expect(out).to_contain("123")
        expect(out).to_contain("456")
