"""
# Ponytail Audit — line counting

**Requirements:** N/A

## Overview

`ponytail_audit_source` reported `lines: 1` for every source: the counter
iterated characters with `for ch in source` / `ch == "\\n"`, which never
matches in this runtime (and would crash on a StrBytes value). The count is
now `source.split("\\n")` based, i.e. `wc -l` semantics: a trailing newline
does not count as an extra line.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.io_runtime.{env_get, dir_create, dir_remove_all, file_write, time_now_unix_micros}
use std.common.ponytail.audit.{ponytail_audit_source, ponytail_simplification_report_source}

fn _fixture(content: text) -> text:
    var base = env_get("SIMPLE_TEST_TMP") ?? ""
    if base == "":
        base = "build/tmp"
    val dir = base + "/ponytail_lines_spec_" + str(time_now_unix_micros())
    dir_remove_all(dir)
    dir_create(dir, true)
    val path = dir + "/fixture.spl"
    file_write(path, content)
    path

describe "ponytail line counting":
    it "counts lines wc -l style, not 1":
        # 5 lines with a trailing newline: wc -l says 5.
        val path = _fixture("a\nb\nc\nd\ne\n")
        val report = ponytail_audit_source(path, "a\nb\nc\nd\ne\n")
        assert_contains(report, "lines: 5")
        assert_contains(report, "status: ok")

    it "counts the last line without a trailing newline too":
        val path = _fixture("x\ny")
        val report = ponytail_simplification_report_source(path, "x\ny")
        assert_contains(report, "lines: 2")

    it "counts an empty source as 0":
        val path = _fixture("")
        val report = ponytail_audit_source(path, "")
        assert_contains(report, "lines: 0")
