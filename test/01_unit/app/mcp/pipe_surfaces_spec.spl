"""
# MCP Pipe Surfaces — search patterns + context CLI fallback

**Requirements:** N/A

## Overview

Two live-verification fixes for the `simple_pipe` / `simple_search`
surfaces:

1. Kind-filtered search patterns used GNU BRE alternation (`\|`), which
   strict BSD grep treats as a literal — `kind=import` style queries
   silently returned "No results found." The patterns now use ERE
   alternation via `grep -E`; the kind-less query path is unchanged.
2. The context pack is generated by a `simple context` subprocess. The
   preferred pure-Simple release binary cannot host that child at all (its
   core-C stub answers "--fork requires hosted interpreter support"), so the
   handler retries once with the Rust seed bootstrap binary, gated on that
   exact marker. The 15s wall bound on both passes keeps the surface bounded
   (20s ceiling including retry headroom).

## Behavior

- `kind=import` and `kind=fn` searches return real matches, never a silent
  "No results found.".
- The context surface returns a real pack (`status: ready`) within the 20s
  bound instead of "context pack unavailable".
"""

# @feature mcp_pipe_surfaces
# tag: unit

use std.spec.{describe, it, slow_it, expect, step}
use std.io_runtime.{file_exists, time_now_unix_micros}
use app.mcp.main_lazy_query_tools.{handle_simple_search, handle_simple_pipe}

describe "simple_search kind patterns":
    it "finds imports with ERE alternation on BSD and GNU grep alike":
        step("Run a kind=import search over a known fixture file")
        # ctx_batch_scale_spec.spl line 40 imports ctx_normalize:
        # `use.*ctx_normalize|import.*ctx_normalize` must match on macOS too.
        val r = handle_simple_search("1", "{\"query\":\"ctx_normalize\",\"kind\":\"import\",\"file\":\"test/01_unit/app/mcp/ctx_batch_scale_spec.spl\"}")
        expect(r).to_contain("use app.mcp.main_lazy_ctx_tools")
        expect(r.contains("No results found")).to_equal(false)

    it "finds functions with the kind=fn pattern":
        step("Run a kind=fn search over the ctx tools module")
        val r = handle_simple_search("2", "{\"query\":\"ctx_bm25_search\",\"kind\":\"fn\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\"}")
        expect(r).to_contain("fn ctx_bm25_search")
        expect(r.contains("No results found")).to_equal(false)

describe "simple_pipe context surface":
    slow_it "returns a real context pack through the working binary":
        step("Request the context surface through the pipe handler and measure the wall time")
        if not file_exists("bin/simple"):
            return
        val t0 = time_now_unix_micros()
        val r = handle_simple_pipe("3", "{\"surface\":\"context\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\",\"format\":\"text\"}")
        val elapsed_ms = (time_now_unix_micros() - t0) / 1000
        step("Verify the surface stays bounded and returns a real pack")
        expect(elapsed_ms <= 20000).to_equal(true)  # oracle: 15s per-pass bound plus seed retry headroom
        expect(r).to_contain("--- Context Pack ---")
        expect(r).to_contain("Simple context pack")
        expect(r).to_contain("status: ready")
        expect(r.contains("context pack unavailable")).to_equal(false)
