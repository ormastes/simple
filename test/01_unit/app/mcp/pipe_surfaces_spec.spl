"""
# MCP Pipe Surfaces — search patterns + context CLI fallback

**Requirements:** N/A

## Overview

Two live-verification fixes for the `simple_pipe` / `simple_search`
surfaces:

1. Kind-filtered search patterns used GNU BRE alternation (`\\|`), which BSD
   grep (macOS) treats as a literal — `kind=import` style queries silently
   returned "No results found." The patterns now use ERE alternation via
   `grep -E`; the kind-less query path is unchanged. The query text embedded
   in a kind-filtered pattern is escaped as an ERE literal first, so regex
   metacharacters in the query (`+ ? ( {` etc.) match themselves instead of
   acting as quantifiers/groups — see `ctx_kind_search_regex_escape_spec.spl`.
2. The context pack is generated by a `simple context` subprocess, run ONLY
   on the preferred pure-Simple release binary — there is no retry with the
   Rust seed bootstrap binary (or any other binary) on failure, per
   CLAUDE.md's no-seed-fallback rule. If the preferred binary cannot host the
   `context` child (e.g. its core-C stub answers "--fork requires hosted
   interpreter support"), the handler reports the failing binary path and
   the failure detail instead of silently swapping binaries. The 15s wall
   bound keeps the surface bounded.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.io_runtime.{env_get, env_set, file_exists, file_write, dir_create, dir_remove_all, time_now_unix_micros}
use app.mcp.main_lazy_query_tools.{handle_simple_search, handle_simple_pipe}

describe "simple_search kind patterns":
    it "finds imports with ERE alternation on BSD and GNU grep alike":
        # ctx_batch_scale_spec.spl line 40 imports ctx_normalize:
        # `use.*ctx_normalize|import.*ctx_normalize` must match on macOS too.
        val r = handle_simple_search("1", "{\"query\":\"ctx_normalize\",\"kind\":\"import\",\"file\":\"test/01_unit/app/mcp/ctx_batch_scale_spec.spl\"}")
        assert_contains(r, "40:use app.mcp.main_lazy_ctx_tools")
        assert_false(r.contains("No results found"))

    it "finds functions with the kind=fn pattern":
        val r = handle_simple_search("2", "{\"query\":\"ctx_bm25_search\",\"kind\":\"fn\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\"}")
        assert_contains(r, "fn ctx_bm25_search")

    it "treats regex metacharacters in a kind-filtered query as literal text":
        # Regression: kind-filtered patterns are built under `grep -E`
        # (ERE), so a query containing ERE metacharacters (`+ ? ( {` etc.)
        # used to be re-interpreted as quantifiers/groups instead of
        # matching those characters literally. Build a fixture function
        # whose name itself is a run of ERE metacharacters and confirm a
        # kind=fn search for it as a literal string still finds it and does
        # not error out on an invalid/garbled regex.
        var _base = env_get("SIMPLE_TEST_TMP") ?? ""
        if _base == "":
            _base = "build/tmp"
        val dir = _base + "/simple_search_regex_escape_" + str(time_now_unix_micros())
        dir_remove_all(dir)
        dir_create(dir, true)
        val fixture = dir + "/regex_meta_fixture.spl"
        file_write(fixture, "fn weird_name_marker(x: i64) -> i64:\n    x + 1\n")
        # A literal query containing ERE metacharacters that would otherwise
        # be parsed as an (invalid or wrongly-matching) regex: unbalanced
        # `(`, a `+`, a `?` and a `{` are all ERE-significant.
        val r = handle_simple_search("3a", "{\"query\":\"weird_name_marker(x\",\"kind\":\"fn\",\"file\":\"" + fixture + "\"}")
        assert_contains(r, "fn weird_name_marker(x")
        dir_remove_all(dir)

describe "simple_pipe context surface":
    it "returns a real context pack through the working binary":
        if not file_exists("bin/simple"):
            return
        val r = handle_simple_pipe("3", "{\"surface\":\"context\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\",\"format\":\"text\"}")
        assert_contains(r, "--- Context Pack ---")
        assert_false(r.contains("context pack unavailable"))
        assert_contains(r, "Simple context pack")
        assert_contains(r, "lines: 75")

    it "reports the specific failing binary and never falls back to a different one":
        # Regression: the handler used to retry with `bin/simple` (framed as
        # "the seed") when the preferred binary could not host the `context`
        # child. Per CLAUDE.md's no-seed-fallback rule that retry is gone —
        # on failure the handler must name the exact binary that failed and
        # the failure detail, and must NOT silently swap to a different
        # binary. `SIMPLE_BINARY` forces a binary that cannot possibly exist,
        # so any success here would prove a fallback ran.
        val prior = env_get("SIMPLE_BINARY") ?? ""
        env_set("SIMPLE_BINARY", "does-not-exist-nonexistent-simple-binary")
        val r = handle_simple_pipe("4", "{\"surface\":\"context\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\",\"format\":\"text\"}")
        env_set("SIMPLE_BINARY", prior)
        assert_contains(r, "context pack unavailable")
        assert_contains(r, "does-not-exist-nonexistent-simple-binary")
