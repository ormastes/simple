"""
# MCP Pipe Surfaces — search patterns + context CLI fallback

**Requirements:** N/A

## Overview

Two live-verification fixes for the `simple_pipe` / `simple_search`
surfaces:

1. Kind-filtered search patterns used GNU BRE alternation (`\\|`), which BSD
   grep (macOS) treats as a literal — `kind=import` style queries silently
   returned "No results found." The patterns now use ERE alternation via
   `grep -E`; the kind-less query path is unchanged.
2. The context pack is generated by a `simple context` subprocess. The
   preferred pure-Simple release binary cannot host that child at all (its
   core-C stub answers "--fork requires hosted interpreter support"), so the
   handler retries once with the Rust seed bootstrap binary, gated on that
   exact marker. The 15s wall bound on both passes keeps the surface bounded.
"""

# @feature mcp_ctx_tools
# tag: unit

use std.spec
use std.io_runtime.{env_get, file_exists}
use app.mcp.main_lazy_query_tools.{handle_simple_search, handle_simple_pipe}

describe "simple_search kind patterns":
    it "finds imports with ERE alternation on BSD and GNU grep alike":
        # ctx_batch_scale_spec.spl line 40 imports ctx_normalize:
        # `use.*ctx_normalize|import.*ctx_normalize` must match on macOS too.
        val r = handle_simple_search("1", "{\"query\":\"ctx_normalize\",\"kind\":\"import\",\"file\":\"test/01_unit/app/mcp/ctx_batch_scale_spec.spl\"}")
        assert_contains(r, "40:use app.mcp.main_lazy_ctx_tools")
        assert_false(r.contains("No results found"))

    it "finds functions with the kind=fn pattern":
        val r = handle_simple_search("2", "{\"query\":\"ctx_bm25_search\",\"kind\":\"fn\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\"}")
        assert_contains(r, "fn ctx_bm25_search")

describe "simple_pipe context surface":
    it "returns a real context pack through the working binary":
        if not file_exists("bin/simple"):
            return
        val r = handle_simple_pipe("3", "{\"surface\":\"context\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\",\"format\":\"text\"}")
        assert_contains(r, "--- Context Pack ---")
        assert_false(r.contains("context pack unavailable"))
        assert_contains(r, "Simple context pack")
        assert_contains(r, "lines: 75")
