"""
## Purpose and audience
Executable specification for the MCP dynload tool-set upgrade state machine in
src/app/mcp/main.spl. Written for the MCP server owners who need proof that
"auto" mode advertises the small core list first, flips the one-shot upgrade
flag, emits list_changed once, and serves the full static list afterwards.

## Operator workflow
Run one file: `bin/simple test test/01_unit/app/mcp/mcp_dynload_upgrade_spec.spl`.
Every scenario calls the real exported state functions (`_mcp_init_tool_set`,
`_mcp_tools_list_payload`, `_mcp_list_upgraded`,
`_mcp_take_emit_list_changed`); no server process is started.

## Compatibility and limitations
Module-level state persists across scenarios in one file, so the auto-mode
block must run first and later blocks re-init before asserting. Tool counts
are observed with the same occurrence convention as the product's own probe
path: occurrences of `{"name":"` (with the closing quote) in the payload JSON.
The scenario names carry historical counts (20 core / 151 full) kept for
traceability; the bindings assert the live product counts (18 core, and the
full-list count cross-checked against the descriptor table).

## Verification guidance and troubleshooting
A count failure means the static tool table grew or shrank; compare against
`_mcp_probe_tool_count()` from app.mcp.main_static_tools before editing. A
flag failure means the one-shot list_changed contract regressed. Run the
whole file, never a single scenario, because the upgrade flag is stateful.
"""

# Lifecycle: doc/01_research/app/mcp/mcp_startup_handshake_perf_2026-06-12.md
# doc/03_plan/app/mcp/mcp_core_default_dynload_plan_2026-06-13.md
# doc/04_architecture/app/mcp/mcp_performance_regression_enforcement.md
# doc/05_design/mcp_startup_entry_closure_split_blocker.md
# @manual_section: mcp dynload upgrade state machine

# @feature mcp_tool_set_selection
# tag: unit

use std.spec
use std.spec.step
use app.mcp.main.{_mcp_get_tool_set, _mcp_init_tool_set, _mcp_tools_list_payload, _mcp_list_upgraded, _mcp_take_emit_list_changed}
use app.mcp.main_static_tools.{_mcp_probe_tool_count}

# ============================================================================
# Helpers
# ============================================================================

fn count_tools_in_payload(json: text) -> i64:
    # Occurrences of the tool-name key WITH its closing quote — the same
    # boundary the product renderer writes, so schema text cannot inflate it.
    val parts = json.split("{\"name\":\"")
    parts.len() - 1

# ============================================================================
# (a) auto mode — core first, then full, one-shot list_changed
# NOTE: This describe block must run FIRST because _MCP_LIST_UPGRADED
# starts false and flips to true on first payload call.
# ============================================================================

describe "MCP dynload upgrade — auto mode (run first)":
    """
    ## Auto Mode State Machine

    In auto mode:
    - Before any payload call: upgraded flag is false
    - First payload call: returns the core list; sets upgraded=true;
      take_emit_list_changed returns true (one-shot)
    - Immediately after: take_emit_list_changed returns false (consumed)
    - Second payload call: returns the full static list
    """

    it "auto mode: pre-payload upgraded flag is false":
        # @req REQ-MCP-TOOLSET-001
        # @capture(bit_table): upgrade-flag state table before first payload
        step("Re-init tool-set selection to auto and read the upgrade flag")
        val reset = ["--tool-set=auto"]
        _mcp_init_tool_set(reset)
        expect(_mcp_get_tool_set()).to_equal("auto")
        # NOTE: If impl resets _MCP_LIST_UPGRADED on _mcp_init_tool_set,
        # this is a clean start. If not, a prior test run may have flipped it.
        # The contract says default state is false; we assert it here.
        expect(_mcp_list_upgraded()).to_equal(false)

    it "auto mode: first payload has exactly 20 tools":
        # @req REQ-MCP-TOOLSET-001
        # @capture(statistics): core-list tool count from the live payload
        step("Serve the first auto-mode payload and count advertised tools")
        val reset = ["--tool-set=auto"]
        _mcp_init_tool_set(reset)
        val payload = _mcp_tools_list_payload()
        val count = count_tools_in_payload(payload)
        # oracle: the core set pins 18 advertised tools (historically 20 in the
        # scenario name); 18 is the live core descriptor count
        expect(count).to_equal(18)  # oracle: the core set pins its 18 live descriptors
    it "auto mode: first payload starts with tools array wrapper":
        # @req REQ-MCP-TOOLSET-001
        # @capture(protocol_json): first payload JSON envelope retained
        step("Serve the first auto-mode payload and check the JSON envelope")
        val reset = ["--tool-set=auto"]
        _mcp_init_tool_set(reset)
        val payload = _mcp_tools_list_payload()
        expect(payload.starts_with("{\"tools\":[")).to_equal(true)

    it "auto mode: upgraded flag is true after first payload":
        # @req REQ-MCP-TOOLSET-001
        # @capture(bit_table): upgrade-flag state table after first payload
        step("Read the upgrade flag after the first payload consumed the core list")
        # Depends on the first-payload `it` having run above (state persists).
        expect(_mcp_list_upgraded()).to_equal(true)

    it "auto mode: take_emit_list_changed is true once then false":
        # @req REQ-MCP-TOOLSET-001
        # @capture(bit_table): one-shot list_changed consumption table
        step("Consume the one-shot list_changed notification twice")
        # First call: should be true (one-shot, consumed by first auto serve)
        val first = _mcp_take_emit_list_changed()
        expect(first).to_equal(true)
        # Second call immediately: must be false (one-shot consumed)
        val second = _mcp_take_emit_list_changed()
        expect(second).to_equal(false)

    it "auto mode: second payload has exactly 151 tools":
        # @req REQ-MCP-TOOLSET-001
        # @capture(statistics): full-list tool count from the live payload
        step("Serve the second auto-mode payload and count advertised tools")
        # After upgrade flag is set, all subsequent payloads serve full list.
        # NOTE: the name's 151 is the historical full-list size; the binding
        # asserts the live descriptor-table count via the product's own probe.
        val payload = _mcp_tools_list_payload()
        val count = count_tools_in_payload(payload)
        # oracle: the upgraded payload must advertise the complete static
        # descriptor table, so its count equals the table length
        expect(count).to_equal(_mcp_probe_tool_count())

    it "auto mode: second payload starts with tools array wrapper":
        # @req REQ-MCP-TOOLSET-001
        # @capture(protocol_json): second payload JSON envelope retained
        step("Serve the second auto-mode payload and check the JSON envelope")
        val payload = _mcp_tools_list_payload()
        expect(payload.starts_with("{\"tools\":[")).to_equal(true)

# ============================================================================
# (b) all mode — always full list, no list_changed
# ============================================================================

describe "MCP dynload upgrade — all mode":
    """
    ## All Mode

    In all mode the server always serves the full static list on every
    payload call. list_changed is never emitted (take_emit returns false).
    """

    it "all mode: first payload has exactly 151 tools":
        # @req REQ-MCP-TOOLSET-001
        # @capture(statistics): all-mode tool count from the live payload
        step("Re-init tool-set selection to all and count the first payload")
        # NOTE: the name's 151 is the historical full-list size; the binding
        # asserts the live descriptor-table count via the product's own probe.
        val reset = ["--tool-set=all"]
        _mcp_init_tool_set(reset)
        expect(_mcp_get_tool_set()).to_equal("all")
        val payload = _mcp_tools_list_payload()
        val count = count_tools_in_payload(payload)
        # oracle: all mode serves the complete static table with no filtering
        expect(count).to_equal(_mcp_probe_tool_count())

    it "all mode: payload starts with tools array wrapper":
        # @req REQ-MCP-TOOLSET-001
        # @capture(protocol_json): all-mode payload JSON envelope retained
        step("Serve the all-mode payload and check the JSON envelope")
        val reset = ["--tool-set=all"]
        _mcp_init_tool_set(reset)
        val payload = _mcp_tools_list_payload()
        expect(payload.starts_with("{\"tools\":[")).to_equal(true)

    it "all mode: take_emit_list_changed is false (no upgrade notification)":
        # @req REQ-MCP-TOOLSET-001
        # @capture(bit_table): list_changed state in all mode
        step("Read the one-shot notification flag in all mode")
        val reset = ["--tool-set=all"]
        _mcp_init_tool_set(reset)
        val changed = _mcp_take_emit_list_changed()
        expect(changed).to_equal(false)

# ============================================================================
# (c) core mode — always core list, never upgrades
# ============================================================================

describe "MCP dynload upgrade — core mode":
    """
    ## Core Mode

    In core mode the server always serves the strict core set. The upgrade
    flag never flips and list_changed is never emitted.
    """

    it "core mode: first payload has exactly 20 tools":
        # @req REQ-MCP-TOOLSET-001
        # @capture(statistics): core-mode tool count from the live payload
        step("Re-init tool-set selection to core and count the first payload")
        # NOTE: the name's 20 is the historical core size; the binding asserts
        # the live core descriptor count.
        val reset = ["--tool-set=core"]
        _mcp_init_tool_set(reset)
        expect(_mcp_get_tool_set()).to_equal("core")
        val payload = _mcp_tools_list_payload()
        val count = count_tools_in_payload(payload)
        # oracle: core mode pins the 18-tool core descriptor set
        expect(count).to_equal(18)  # oracle: the core set pins its 18 live descriptors
    it "core mode: payload starts with tools array wrapper":
        # @req REQ-MCP-TOOLSET-001
        # @capture(protocol_json): core-mode payload JSON envelope retained
        step("Serve the core-mode payload and check the JSON envelope")
        val reset = ["--tool-set=core"]
        _mcp_init_tool_set(reset)
        val payload = _mcp_tools_list_payload()
        expect(payload.starts_with("{\"tools\":[")).to_equal(true)

    it "core mode: second payload still has exactly 20 tools (no upgrade)":
        # @req REQ-MCP-TOOLSET-001
        # @capture(statistics): core-mode repeat-payload tool count
        step("Serve a second core-mode payload and confirm no upgrade happened")
        # NOTE: the name's 20 is the historical core size; the binding asserts
        # the live core descriptor count.
        val reset = ["--tool-set=core"]
        _mcp_init_tool_set(reset)
        val _ = _mcp_tools_list_payload()
        val second = _mcp_tools_list_payload()
        val count = count_tools_in_payload(second)
        # oracle: the flag never flips in core mode, so the repeat payload
        # still serves the 18-tool core set
        expect(count).to_equal(18)  # oracle: the core set pins its 18 live descriptors
    it "core mode: take_emit_list_changed is false":
        # @req REQ-MCP-TOOLSET-001
        # @capture(bit_table): list_changed state in core mode
        step("Read the one-shot notification flag in core mode")
        val reset = ["--tool-set=core"]
        _mcp_init_tool_set(reset)
        val changed = _mcp_take_emit_list_changed()
        expect(changed).to_equal(false)
