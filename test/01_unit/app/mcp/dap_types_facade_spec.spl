use std.spec.{describe, it, expect}
use app.mcp.dap_types.{
    DebugConnectionHints,
    DebugTransportKind,
    debug_backend_catalog,
    debug_bootstrap_plan,
    debug_target_descriptor
}

describe("MCP DAP type compatibility facade"):
    it("forwards the authoritative remote debug catalog"):
        val catalog = debug_backend_catalog()
        expect(catalog.len()).to_equal(6)
        expect(catalog[0].backend_id).to_equal("openocd_jtag")
        expect(catalog[5].transport.to_string()).to_equal("gdb_remote")

    it("preserves MCP target planning behavior"):
        val target = debug_target_descriptor(
            "t32", "", "arm64", "", "", "", ""
        )
        expect(target.transport.to_string()).to_equal("trace32_native")
        expect(target.vendor).to_equal("lauterbach")

        val hints = DebugConnectionHints.empty()
        val plan = debug_bootstrap_plan(target, hints, "firmware.elf")
        expect(plan.is_ok()).to_equal(true)
        expect(plan.unwrap().backend_id).to_equal("trace32_native")
