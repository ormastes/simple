# Run the actual authoritative generator; no copied emitter or predicate.
use std.spec.*
use std.io_runtime.{cwd, file_read, file_exists}
use app.compiler_schema.codec_gen.{CodecUniverse, emit_codec_file}

describe "Required HIR function codec generation":
    it "generates the checked in codec including refusal and guarded insertion":
        val root = cwd()
        val checked_path = root + "/src/compiler/20.hir/generated/hir_codec.spl"
        expect(file_exists(checked_path)).to_equal(true)
        val generated = emit_codec_file(CodecUniverse.load(root))
        expect(generated.len()).to_be_greater_than(0)
        expect(generated).to_contain("w.reject(\"missing_required_hir_module_function_entry\")")
        expect(generated).to_contain("r.reject_malformed(\"missing_required_hir_module_function_entry\")")
        expect(generated).to_contain("        if r.ok:\n            if val present_v6 = dv6:\n                f_functions[dk6] = present_v6\n")
        expect(generated).to_contain("hc_enc_enum_char(w, node, 1, 0, b_value)")
        expect(generated).to_contain("val f_value: char = if wire_nil_value: 0 as char else: hc_read_char(r, raw9)")
        expect(generated).to_equal(file_read(checked_path))
