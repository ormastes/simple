# @tag:phase3
use std.spec.*
use std.io_runtime.{cwd}
use app.compiler_schema.codec_gen.{CodecUniverse, emit_codec_file}

fn count_of(haystack: text, needle: text) -> i64:
    haystack.split(needle).len() - 1

# a174_enum_scalar_codec_wire_boundary_2026_10_16: an enum variant with a
# scalar (bool/text/char) payload must be rebuilt from a TYPED prototype built by
# the ordinary constructor, and nil slots restored from a schema-owned index list
# (never raw runtime ids). Native confirmation: test/04_smoke/enum_wire_boundary_native.spl

describe "HIR codec enum scalar wire boundary":
    it "REPRO: scalar enum payloads decode via typed prototype + schema-owned nil slots":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        expect(g).to_contain("        val wire_prototype = AsmLocation.RegSpec(f_f0)\n")
        expect(g).to_contain("hc_restore_enum_nil(r, wire_prototype, 1, wire_nil_slots)")
        expect(g).to_contain("wire_nil_slots.push(0)")

    it "REPRO: encoder names declared arity and field index for each scalar slot":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        expect(g).to_contain("hc_enc_enum_text(w, node, ")
        expect(g).to_contain("hc_enc_enum_bool(w, node, ")
