# @tag:phase3
use std.spec.*
use std.io_runtime.{cwd}
use app.compiler_schema.codec_gen.{CodecUniverse, emit_codec_file}

fn count_of(haystack: text, needle: text) -> i64:
    haystack.split(needle).len() - 1

# a174_struct_nil_comparison_dispatch_2026_10_16: struct/enum node presence
# must be tested with an Option bind + `.?`, never `== nil` on the node
# payload (unreliable under staged-native codegen).

describe "HIR codec struct presence dispatch":
    it "REPRO: node field is bound once into an optional local and tested with .?":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        expect(g).to_contain("val enc_node_v")
        expect(g).to_contain("? = ")
        expect(g).to_contain(".?:\n")
        expect(g).to_contain("(w, enc_node_v")

    it "REPRO: required HirModule.functions entry rejects instead of encoding nil":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        expect(g).to_contain("missing_required_hir_module_function_entry")
