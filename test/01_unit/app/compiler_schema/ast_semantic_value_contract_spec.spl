"""Generated parser semantic-value encoder contracts."""

use compiler.common.diagnostics.span.{Span}
use compiler.frontend.parser_types_expr.{Expr, ExprKind, Type, TypeKind}
use compiler.blocks.value.{BlockValue}
use compiler.frontend.generated.ast_semantic_value.{
    ast_semantic_hash_seed, ast_semantic_hash_finish, ast_semantic_encode_expr, ast_semantic_encode_type
}
use std.io_runtime.{read_file_text}
use app.compiler_schema.fold_gen.{load_ast_semantic_universe, emit_one_ast_semantic_encoder}
use app.compiler_schema.fold_gen.{prepare_fold_inputs, all_dialects, emit_fold_file, emit_ast_semantic_file, emit_fold_init}
use app.compiler_schema.visitor_gen.{DeclUniverse, emit_visit_file, emit_children_file, emit_hash_file, emit_init_file}
use std.io_runtime.{cwd}
use std.spec.step

fn stale_generated_files() -> [text]:
    """Regenerate every visitor/fold artifact in memory; list checked-in files that differ byte-for-byte."""
    val root = cwd()
    var stale: [text] = []
    val hir_dir = "src/compiler/20.hir/generated/"
    val u = DeclUniverse.load(root)
    val visitor_rows = [
        [hir_dir + "hir_visit.spl", emit_visit_file(u)],
        [hir_dir + "hir_children.spl", emit_children_file(u)],
        [hir_dir + "hir_hash.spl", emit_hash_file(u)],
        [hir_dir + "__init__.spl", emit_init_file()]
    ]
    for row in visitor_rows:
        if read_file_text(root + "/" + row[0]) != row[1]: stale.push(row[0])
    val inputs = prepare_fold_inputs(root)
    if inputs.len() == 0:
        stale.push("<fold inputs refused>")
        return stale
    val dialects = all_dialects()
    val semantic: DeclUniverse = inputs[dialects.len()]
    var index = 0
    for d in dialects:
        val dir = d.out_dir + "/"
        if read_file_text(root + "/" + dir + d.out_file) != emit_fold_file(inputs[index], d): stale.push(dir + d.out_file)
        if d.key != "hir":
            if read_file_text(root + "/" + dir + "ast_semantic_value.spl") != emit_ast_semantic_file(semantic): stale.push(dir + "ast_semantic_value.spl")
            if read_file_text(root + "/" + dir + "__init__.spl") != emit_fold_init(d): stale.push(dir + "__init__.spl")
        index = index + 1
    stale

fn semantic_digest(expr: Expr) -> text:
    val state = ast_semantic_hash_seed()
    ast_semantic_encode_expr(expr, state)
    ast_semantic_hash_finish(state)

fn no_span() -> Span:
    Span(0, 0, 0, 0, "", 0)

fn type_digest(value: Type) -> text:
    ast_semantic_hash_finish(ast_semantic_encode_type(value, ast_semantic_hash_seed()))

fn u8_array(size: Expr?) -> Type:
    val element = Type(kind: TypeKind.Named("u8", []), span: no_span())
    Type(kind: TypeKind.Array(element, size), span: no_span())

fn some_size(n: i64) -> Expr?:
    # Same construction as the flat-AST bridge (flat_field_sized_type).
    val size: Expr? = Some(Expr(kind: ExprKind.IntLit(n), span: no_span()))
    size

fn bare_size(n: i64) -> Expr?:
    val size: Expr? = Expr(kind: ExprKind.IntLit(n), span: no_span())
    size

describe "generated AST semantic fingerprint contracts":
    it "does not collapse integers separated by the former modulus":
        step("Verify exact-width scalar encoding avoids the former modulo collision")
        val zero = Expr(kind: ExprKind.IntLit(0), span: no_span())
        val former_collision = Expr(kind: ExprKind.IntLit(1000000007), span: no_span())
        expect(semantic_digest(zero) != semantic_digest(former_collision)).to_equal(true)

    it "frames multibyte strings over their exact UTF-8 bytes in linear time":
        step("Verify byte-domain traversal rather than character-index rescanning")
        val multibyte = Expr(kind: ExprKind.StringLit("café", nil), span: no_span())
        val ascii = Expr(kind: ExprKind.StringLit("cafe", nil), span: no_span())
        expect(semantic_digest(multibyte) != semantic_digest(ascii)).to_equal(true)
        val generated = read_file_text("src/compiler/10.frontend/generated/ast_semantic_value.spl")
        expect(generated.contains("value.byte_at(i) as i64")).to_equal(true)
        expect(generated.contains("value.char_at(i)")).to_equal(false)

    it "hoists UTF-8 byte length out of semantic hashing traversal":
        step("Verify each text hash computes byte length once before its hot loop")
        val generated = read_file_text("src/compiler/10.frontend/generated/ast_semantic_value.spl")
        expect(generated.contains("val byte_len = value.byte_len()\n    var result = _ast_semantic_mix_i64(state, byte_len)")).to_equal(true)
        expect(generated.contains("while i < byte_len:")).to_equal(true)
        expect(generated.contains("while i < value.len():")).to_equal(false)

    it "encodes custom-block raw payload semantics":
        step("Verify CustomBlock and BlockValue.Raw payload bytes affect the fingerprint")
        val left = Expr(kind: ExprKind.CustomBlock("dsl", BlockValue.Raw("alpha")), span: no_span())
        val right = Expr(kind: ExprKind.CustomBlock("dsl", BlockValue.Raw("beta")), span: no_span())
        expect(semantic_digest(left) != semantic_digest(right)).to_equal(true)

    it "generates an explicit policy arm for every BlockValue variant":
        step("Verify typed block values encode and type-erased values become uncacheable")
        val generated = read_file_text("src/compiler/10.frontend/generated/ast_semantic_value.spl")
        for arm in ["Expr", "LossBlock", "NogradBlock", "Raw", "Shell", "Sql",
                    "Regex", "Json", "Markdown", "Graph", "Custom", "Error"]:
            expect(generated.contains("case " + arm)).to_equal(true)
        # BlockValue.Expr/LossBlock/NogradBlock carry flat AST handles (i64), so
        # they are the type-erased payloads now (fb05765b78b), not `Any`.
        expect(generated.contains("_ast_semantic_mark_uncacheable(state, \"opaque AST handle\")")).to_equal(true)

    it "keeps the generated package re-export inside the freshness ownership set":
        step("Verify freshness compares both the semantic artifact and its package initializer")
        val gate = read_file_text("scripts/check/check-generated-visitors-fresh.shs")
        expect(gate.contains("src/compiler/10.frontend/generated/ast_semantic_value.spl")).to_equal(true)
        expect(gate.contains("src/compiler/10.frontend/generated/__init__.spl")).to_equal(true)

    it "keeps every checked-in visitor/fold artifact byte-identical to a fresh regeneration":
        step("Regenerate all 8 visitor/fold files in memory and compare with the checked-in files")
        expect(stale_generated_files()).to_equal([])

    it "keeps generated visitor/fold guards nil-free (Option-safe presence checks only)":
        step("The generators emit `case None` / `.?` instead of nil outside unsafe")
        val visitor_src = read_file_text("src/app/compiler_schema/visitor_gen.spl")
        val fold_src = read_file_text("src/app/compiler_schema/fold_gen.spl")
        expect(visitor_src.contains("case nil")).to_equal(false)
        expect(fold_src.contains("case nil")).to_equal(false)
        expect(visitor_src.contains("== nil")).to_equal(false)
        expect(fold_src.contains("== nil")).to_equal(false)
        expect(fold_src.contains("!= nil")).to_equal(false)

    it "encodes a literal-sized array type through an explicit presence projection":
        step("Verify the generator projects an optional node payload with `!` after its nil guard")
        val encoder = emit_one_ast_semantic_encoder(load_ast_semantic_universe("."), "Type")
        expect(encoder.contains(": Expr = b_Array_f1!")).to_equal(true)
        expect(encoder.contains("ast_semantic_encode_expr(b_Array_f1, state)")).to_equal(false)
        step("Verify the checked-in encoder was regenerated with the projection")
        val generated = read_file_text("src/compiler/10.frontend/generated/ast_semantic_value.spl")
        expect(generated.contains(": Expr = b_Array_f1!")).to_equal(true)
        expect(generated.contains("ast_semantic_encode_expr(b_Array_f1, state)")).to_equal(false)
        expect(generated.contains("ast_semantic_encode_expr(b_Return_f0, state)")).to_equal(false)

    it "gives `[u8; N]` one digest per N whether the size was built bare or with Some":
        step("Verify a Some-wrapped size (the bridge's shape) hashes like a bare one")
        expect(type_digest(u8_array(some_size(4096)))).to_equal(type_digest(u8_array(bare_size(4096))))
        expect(type_digest(u8_array(some_size(4096))) != type_digest(u8_array(some_size(4095)))).to_equal(true)
        expect(type_digest(u8_array(some_size(4096))) != type_digest(u8_array(nil))).to_equal(true)
