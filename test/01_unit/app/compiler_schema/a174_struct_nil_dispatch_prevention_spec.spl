use std.spec.*
use std.io_runtime.{cwd}
use app.compiler_schema.codec_gen.{CodecUniverse, emit_codec_file}

fn count_of(haystack: text, needle: text) -> i64:
    haystack.split(needle).len() - 1

# Prevention: no encoder branch may compare a bound node local with nil.
describe "HIR codec struct presence prevention":
    it "no enc_node_v local is ever compared against nil":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        expect(g.contains("enc_node_v") ).to_be(true)
        var bad = 0
        for line in g.split("\n"):
            if line.contains("enc_node_v") and (line.contains("== nil") or line.contains("!= nil")):
                bad = bad + 1
        expect(bad).to_equal(0)

    it "every enc_node_v bind is optional-typed":
        val g = emit_codec_file(CodecUniverse.load(cwd()))
        var untyped = 0
        for line in g.split("\n"):
            if line.contains("val enc_node_v") and not line.contains("? = "):
                untyped = untyped + 1
        expect(untyped).to_equal(0)
