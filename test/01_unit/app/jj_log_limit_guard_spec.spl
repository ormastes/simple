# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use app.jj.log (parse_log_limit_or_default)

describe "jj log limit guard":
    # @manual scenario evidence
    it "accepts numeric limits and falls back to default on malformed values":
        # @req REQ-SSPEC-APP
        step("accepts numeric limits and falls back to default on malformed values")
        expect(parse_log_limit_or_default("25", 100)).to_equal(25)
        expect(parse_log_limit_or_default("7", 100)).to_equal(7)
        expect(parse_log_limit_or_default("0", 100)).to_equal(0)
        expect(parse_log_limit_or_default("", 100)).to_equal(100)
        expect(parse_log_limit_or_default("abc", 100)).to_equal(100)
        expect(parse_log_limit_or_default("12x", 100)).to_equal(100)
        expect(parse_log_limit_or_default("-5", 100)).to_equal(100)
        expect(parse_log_limit_or_default("1e3", 100)).to_equal(100)
        expect(parse_log_limit_or_default(" 42 ", 100)).to_equal(42)
