use std.spec.*
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use app.io._CliCompile.native_build_snapshot_roots.{native_build_snapshot_drop_missing_default_roots_v1}
use app.compiler_entrypoint.source_authority.{compiler_source_authority_root_git_reason_v1}
use compiler.common.cache.phase_compatibility_path_io.{phase_compatibility_spelling_equivalent_v1}

val BASE = "build/test_tmp/scv_entry_admission"

describe "scv entry admission":
    it "drops a missing default root with a warning, keeps existing ones":
        dir_create_all(BASE + "/has/src/app")
        val kept = native_build_snapshot_drop_missing_default_roots_v1(
            BASE + "/has", ["src/app", "src/os", "src/plugins"])
        expect(kept).to_equal(["src/app"])

    it "reports a non-git root with a clear diagnostic":
        dir_create_all(BASE + "/nogit")
        val reason = compiler_source_authority_root_git_reason_v1(BASE + "/nogit")
        expect(reason.starts_with("source-inventory-root-not-git")).to_equal(true)

    it "accepts a root with a .git directory or file":
        dir_create_all(BASE + "/gitdir/.git")
        expect(compiler_source_authority_root_git_reason_v1(BASE + "/gitdir")).to_equal("")

    it "treats case-only drive/dir spelling as equivalent only when case-insensitive":
        expect(phase_compatibility_spelling_equivalent_v1("c:/Dev/wt", "C:/dev/wt", true)).to_equal(true)
        expect(phase_compatibility_spelling_equivalent_v1("c:/Dev/wt", "C:/dev/wt", false)).to_equal(false)
        expect(phase_compatibility_spelling_equivalent_v1("C:/a", "C:/b", true)).to_equal(false)
