use std.spec.*
use scv_auto_admit_fixture.{scv_auto_admit_roundtrip_io, scv_auto_admit_mutation_io}

describe "SCV auto-admit snapshot for entries outside the event families":
    it "auto cold-inits, adds and commits build/hw/hello.spl, then freezes it":
        val r = scv_auto_admit_roundtrip_io()
        print("RT=[" + r + "]")
        expect(r).to_equal("")

    it "fails closed when an admitted source changes before the freeze":
        val m = scv_auto_admit_mutation_io()
        print("MU=[" + m + "]")
        expect(m).to_equal("")
