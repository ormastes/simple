# Helper for refresh_lock_stress_test.shs. Env: LOCK_ROOT (cache root), LOCK_WAIT_S, LOCK_HOLD_MS.
# Uses the production lease so the spec exercises the real acquisition path.
use app.compiler_entrypoint.inventory_refresh_lease.{CompilerInventoryRefreshLeaseV1}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.time_ops.{sleep_ms}

fn main():
    val root = env_get("LOCK_ROOT") ?? ""
    val wait_s = (env_get("LOCK_WAIT_S") ?? "60").to_int()
    val hold_ms = (env_get("LOCK_HOLD_MS") ?? "100").to_int()
    val lease = CompilerInventoryRefreshLeaseV1(cache_root: root)
    if not lease.acquire_waiting(wait_s):
        print("LOCK-FAIL")
        return
    sleep_ms(hold_ms)
    lease.release()
    print("LOCK-OK")
main()
