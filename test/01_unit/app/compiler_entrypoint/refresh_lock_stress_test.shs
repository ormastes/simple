#!/bin/sh
# Stress for the SCV compile-event refresh lock (P0 concurrency).
#  A) N concurrent contenders on ONE refresh.lock must ALL acquire within budget
#     (waiting acquisition; formerly the loser failed closed).
#  B) Fail-closed only after the real timeout, with a diagnostic naming the lock path.
# Usage: SIMPLE=bin/simple.exe sh refresh_lock_stress_test.shs [N] [budget_s]
N=${1:-8}; BUDGET=${2:-120}
SIMPLE=${SIMPLE:-bin/simple.exe}
here=$(dirname "$0")
helper="$here/refresh_lock_stress/lock_holder.spl"
tmp=$(mktemp -d); mkdir -p "$tmp/compile-events"
start=$(date +%s)
i=0
while [ $i -lt $N ]; do
  LOCK_ROOT="$tmp" LOCK_WAIT_S=60 LOCK_HOLD_MS=100 "$SIMPLE" run "$helper" > "$tmp/out.$i" 2>&1 &
  i=$((i+1))
done
wait
el=$(( $(date +%s) - start ))
ok=$(cat "$tmp"/out.* | grep -c '^LOCK-OK')
echo "A: contenders=$N ok=$ok elapsed_s=$el budget_s=$BUDGET"
[ "$ok" -eq "$N" ] || { echo "FAIL - only $ok/$N acquired"; cat "$tmp/w.out" "$tmp/h.out" | grep -v warning | tail -5; rm -rf "$tmp"; exit 1; }
[ "$el" -le "$BUDGET" ] || { echo "FAIL - over budget"; cat "$tmp/w.out" "$tmp/h.out" | grep -v warning | tail -5; rm -rf "$tmp"; exit 1; }
# B: long holder, short-budget waiter -> must fail closed with a path diagnostic.
LOCK_ROOT="$tmp" LOCK_WAIT_S=60 LOCK_HOLD_MS=15000 "$SIMPLE" run "$helper" > "$tmp/h.out" 2>&1 &
hp=$!
sleep 6
LOCK_ROOT="$tmp" LOCK_WAIT_S=5 LOCK_HOLD_MS=1 "$SIMPLE" run "$helper" > "$tmp/w.out" 2>&1
wait $hp
grep -q '^LOCK-FAIL' "$tmp/w.out" || { echo "FAIL - waiter did not fail closed"; cat "$tmp/w.out" "$tmp/h.out" | grep -v warning | tail -5; rm -rf "$tmp"; exit 1; }
grep -q 'compile-event-refresh-lock-unavailable path=.*refresh.lock' "$tmp/w.out" || { echo "FAIL - no path diagnostic"; cat "$tmp/w.out" "$tmp/h.out" | grep -v warning | tail -5; rm -rf "$tmp"; exit 1; }
grep -q '^LOCK-OK' "$tmp/h.out" || { echo "FAIL - holder lost lock"; cat "$tmp/w.out" "$tmp/h.out" | grep -v warning | tail -5; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"
echo "PASS - $N/$N acquired in ${el}s; fail-closed diagnostic present"
