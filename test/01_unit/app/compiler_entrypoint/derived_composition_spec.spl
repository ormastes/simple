use std.spec.*
use app.compiler_entrypoint.derived_composition.{compiler_source_selector_relative_v1,
    compiler_cuda_composition_mode_v1, compiler_cuda_composition_identity_v1,
    compiler_cuda_composition_root_v1, compiler_source_authority_selectors_v1}
use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1,
    compiler_source_authority_clear_v1, compiler_source_authority_inventory_roots_v1}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{dir_create_all, file_write, file_read}
use std.nogc_async_mut.sosix.host_facade.{sosix_run}
use std.common.crypto.sha256.{sha256_text}

fn derived_manifest(enabled: text, placement: text) -> text:
    "compiler_backends:\n  cuda:\n    enabled: {enabled}\n    placement: {placement}\n"

fn derived_authority_fixture(mode: text) -> text:
    val root = path_absolute("build/tests/derived-composition-{mode}-{time_now_unix_micros()}")
    val canonical = "src/compositions/cuda_" + mode
    val leaf = "/plugins/backend_registry/selected_cuda_backend.spl"
    val template = "fn selected_cuda_backend_mode_v1() -> text: \"{mode}\"\n"
    val manifest = derived_manifest(if mode == "disabled": "false" else: "true",
        if mode == "dynamic": "dynamic" else: "static")
    val selector = "build/bootstrap/compositions/cuda-" + sha256_text(manifest) + "-" + sha256_text(template)
    for directory in ["src/compiler", "src/plugins/backend_registry",
            canonical + "/plugins/backend_registry", selector + "/plugins/backend_registry"]:
        if not dir_create_all(root + "/" + directory): return "mkdir"
    if not file_write(root + "/src/compiler/simple.sdn", manifest): return "manifest"
    if not file_write(root + "/src" + leaf, template): return "template"
    if not file_write(root + "/" + canonical + leaf, template): return "canonical"
    if not file_write(root + "/" + selector + leaf, template): return "generated"
    for args in [["init", "-q"], ["add", "src"],
            ["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture"]]:
        if sosix_run("git", ["-C", root] + args).exit_code != 0: return "git"
    if not compiler_source_authority_clear_v1(): return "clear"
    val relative = compiler_source_authority_selectors_v1(root, [selector])
    val absolute = compiler_source_authority_selectors_v1(root, [root + "/" + selector])
    if relative.is_err() or absolute.is_err(): return "selection"
    if relative.unwrap() != absolute.unwrap(): return "absolute-relative-mismatch"
    if compiler_source_authority_inventory_roots_v1(root, relative.unwrap()) != ["src"]:
        return "family"
    val authority = compiler_source_authority_acquire_v1(root, root + "/build/scv", [selector], true)
    if not authority.valid: return "acquire:" + authority.reason
    val frozen = authority.snapshot.snapshot_root
    if authority.snapshot.inventory_count != (if mode == "static": 3 else: 2): return "count"
    if file_read(frozen + "/" + canonical + leaf) != template: return "frozen-bytes"
    val mapped = compiler_cuda_composition_root_v1(root, frozen, selector, false)
    if mapped.is_err() or mapped.unwrap() != canonical: return "frozen-map"
    if not file_write(root + "/" + selector + leaf, "tampered"): return "tamper-write"
    val rejected = compiler_cuda_composition_root_v1(root, root, selector, true)
    if rejected.is_ok() or rejected.unwrap_err() != "derived-composition-content-mismatch":
        return "accepted-corrupt-generated"
    val retained = compiler_cuda_composition_root_v1(root, frozen, selector, false)
    if retained.is_err() or retained.unwrap() != canonical: return "live-drift-changed-frozen"
    if not file_write(root + "/" + selector + leaf, template): return "restore"
    if not file_write(root + "/" + selector + "/extra.spl", "fn extra(): 1\n"): return "extra-write"
    val extra = compiler_cuda_composition_root_v1(root, root, selector, true)
    if extra.is_ok() or extra.unwrap_err() != "derived-composition-membership-mismatch":
        return "accepted-extra-generated-member"
    ""

describe "derived bootstrap composition authority":
    it "normalizes owned absolute and relative selectors without erasing traversal":
        step("preserve selector identity and reject foreign roots before admission")
        expect(compiler_source_selector_relative_v1("/repo", "/repo/src/./app")).to_equal("src/app")
        expect(compiler_source_selector_relative_v1("/repo/", "./src/app")).to_equal("src/app")
        expect(compiler_source_selector_relative_v1("/repo", "/other/src/app")).to_equal("")
        expect(compiler_source_selector_relative_v1("/repo", "src/../app")).to_equal("")
        expect(compiler_source_authority_inventory_roots_v1("/repo", ["build/arbitrary"])).to_equal([])

    it "selects each manifest policy and rejects duplicate empty fields":
        step("match constructor scalar policy with exact occurrence counts")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("true", "static"))).to_equal("static")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("true", "dynamic"))).to_equal("dynamic")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("false", "static"))).to_equal("disabled")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("false", "dynamic"))).to_equal("disabled")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("maybe", "static"))).to_equal("")
        expect(compiler_cuda_composition_mode_v1(derived_manifest("true", "unknown"))).to_equal("")
        expect(compiler_cuda_composition_mode_v1("compiler_backends:\n  cuda:\n    enabled:\n    enabled: true\n    placement: static\n")).to_equal("")
        expect(compiler_cuda_composition_mode_v1("compiler_backends:  \n  cuda:  \n    enabled: true # allowed\n    placement: static # allowed\n")).to_equal("static")

    it "binds both manifest and source digests rather than a build path prefix":
        step("reject stale policy and changed source even under a plausible generated root")
        val manifest = derived_manifest("true", "static")
        val template = "static template"
        val selector = "build/bootstrap/compositions/cuda-" + sha256_text(manifest) + "-" + sha256_text(template)
        expect(compiler_cuda_composition_identity_v1(selector, manifest, template)).to_equal(true)
        expect(compiler_cuda_composition_identity_v1(selector, manifest + "# changed", template)).to_equal(false)
        expect(compiler_cuda_composition_identity_v1(selector, manifest, template + "changed")).to_equal(false)
        expect(compiler_cuda_composition_identity_v1("build/arbitrary", manifest, template)).to_equal(false)

    it "admits real canonical rows and retains frozen source after generated drift":
        step("exercise actual Git refresh, snapshot membership and inherited mapping for all modes")
        expect(derived_authority_fixture("static")).to_equal("")
        expect(derived_authority_fixture("dynamic")).to_equal("")
        expect(derived_authority_fixture("disabled")).to_equal("")
