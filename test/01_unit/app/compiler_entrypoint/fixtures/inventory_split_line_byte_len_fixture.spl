# Compiled-lane fixture for inventory_split_line_byte_len_spec.spl.
# Mirrors the `git ls-files -t` line walk in
# src/app/compiler_entrypoint/inventory_events.spl: every element of a
# split("\n") result is an erased receiver, and `.byte_len()` on it must be a
# plain i64 (11 for "H src/c.spl"), never a tagged word.
fn count_short_rows(listing: text) -> i64:
    var short = 0
    for line in listing.split("\n"):
        if line == "":
            continue
        if line.byte_len() <= 2 or line.substring(1, 2) != " ":
            short = short + 1
    short

fn main():
    val listing = "H src/c.spl\nH src/main.spl\n"
    var lens = ""
    for line in listing.split("\n"):
        if line == "":
            continue
        lens = lens + str(line.byte_len()) + ","
    print("lens=" + lens + " short=" + str(count_short_rows(listing)))
