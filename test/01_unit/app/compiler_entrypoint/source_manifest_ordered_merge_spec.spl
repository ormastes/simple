use std.spec.*
use app.compiler_entrypoint.source_manifest_membership.{
    compiler_source_manifest_membership_v1, compiler_source_manifest_ordered_v1}
use std.scv.compile_source_inventory_core.{CompileSourceInventoryEntryV1}

fn merge_entry(path: text, digest: text, size: i64) -> CompileSourceInventoryEntryV1:
    CompileSourceInventoryEntryV1(path, digest, digest, digest, digest, digest, size)

fn merge_inventory() -> [CompileSourceInventoryEntryV1]:
    var entries: [CompileSourceInventoryEntryV1] = []
    var index = 0
    while index < 1024:
        entries.push(merge_entry("src/p{10000 + index}.spl", "d", index))
        index = index + 1
    entries

fn merge_selection() -> [text]:
    var rows: [text] = []
    var index = 0
    while index < 32:
        val selected = index * 31
        rows.push("src/p{10000 + selected}.spl|sha256_d|{selected}")
        index = index + 1
    rows.push("src/p11023.spl|sha256_d|1023")
    rows

describe "ordered source manifest batch membership":
    it "merges sparse batches across the first and last inventory entries":
        val entries = merge_inventory()
        val rows = merge_selection()
        expect(compiler_source_manifest_ordered_v1(entries, rows)).to_equal(true)
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(true)
        expect(entries.len()).to_equal(1024)
        expect(entries[1023].source_identity).to_equal("src/p11023.spl")
        expect(rows.len()).to_equal(33)
        expect(rows[0]).to_equal("src/p10000.spl|sha256_d|0")

    it "rejects changed digest and size in an otherwise ordered batch":
        val entries = merge_inventory()
        var rows = merge_selection()
        rows[16] = "src/p10496.spl|sha256_changed|496"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)
        rows[16] = "src/p10496.spl|sha256_d|497"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)
        expect(entries[496].content_digest).to_equal("d")
        expect(entries[496].byte_count).to_equal(496)

    it "rejects missing identities before, between and after admitted entries":
        val entries = merge_inventory()
        var rows = merge_selection()
        rows[0] = "src/p09999.spl|sha256_d|0"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)
        rows[0] = "src/p10000.spl|sha256_d|0"
        rows[16] = "src/p10496a.spl|sha256_d|496"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)
        rows[16] = "src/p10496.spl|sha256_d|496"
        rows[32] = "src/p11024.spl|sha256_d|1024"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)

    it "accepts repeated selected rows but rejects conflicting repeated data":
        val entries = merge_inventory()
        var rows = merge_selection()
        rows[16] = rows[15]
        expect(compiler_source_manifest_ordered_v1(entries, rows)).to_equal(true)
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(true)
        rows[16] = "src/p10465.spl|sha256_changed|465"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)

    it "retains unordered caller selection and duplicate inventory semantics":
        var entries = merge_inventory()
        var rows = merge_selection()
        val first = rows[0]
        rows[0] = rows[32]
        rows[32] = first
        expect(compiler_source_manifest_ordered_v1(entries, rows)).to_equal(false)
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(true)
        entries.push(merge_entry("src/p10000.spl", "other", 0))
        rows[32] = "src/p10000.spl|sha256_other|0"
        expect(compiler_source_manifest_ordered_v1(entries, rows)).to_equal(false)
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(true)

    it "retains delimiter identities and malformed row rejection":
        var entries = merge_inventory()
        var rows = merge_selection()
        entries.push(merge_entry("src/a|b.spl", "pipe", 7))
        rows[0] = "src/a|b.spl|sha256_pipe|7"
        expect(compiler_source_manifest_ordered_v1(entries, rows)).to_equal(false)
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(true)
        rows[0] = "malformed"
        expect(compiler_source_manifest_membership_v1(entries, rows)).to_equal(false)
