"""
## Purpose and audience

Purpose: pin which build-tree selectors are treated as derived CUDA
compositions. An ordinary build-tree hello entry is plain source; only
generated `build/**/compositions/cuda-*` selectors route through composition
identity. Lookalike paths must not be promoted.

Audience: engineers changing the compiler entrypoint selector who need to know
which paths the derived-composition admission path accepts.

## Operator workflow

1. Run `SIMPLE_LIB=$PWD/src bin/simple test test/01_unit/app/compiler_entrypoint/cuda_composition_selector_spec.spl`.
2. Every scenario must pass.

## Compatibility and limitations

Pure string predicate. Identical on macOS, Linux, Windows, FreeBSD and
SimpleOS; no filesystem access.
"""

use std.spec.{describe, it, expect}
use app.compiler_entrypoint.derived_composition.{compiler_cuda_composition_selector_v1}

describe "Compiler CUDA composition selector":
    it "treats an ordinary build-tree hello entry as plain source":
        # @req REQ-HBR-002
        step("Classify the build-tree hello entry build/hw/hello.spl")
        expect(compiler_cuda_composition_selector_v1("build/hw/hello.spl")).to_equal(false)
        step("Classify the flat build-tree hello entry build/hello.spl")
        expect(compiler_cuda_composition_selector_v1("build/hello.spl")).to_equal(false)

    it "routes only generated CUDA compositions through composition identity":
        # @req REQ-HBR-002
        step("Positive control: a generated cuda-sm90 composition under build/")
        expect(compiler_cuda_composition_selector_v1("build/x/compositions/cuda-sm90/main.spl")).to_equal(true)

    it "does not mistake a lookalike outside build/ for a composition":
        # @req REQ-HBR-002
        step("Reject a cuda-named composition outside the build tree")
        expect(compiler_cuda_composition_selector_v1("src/compositions/cuda-x/a.spl")).to_equal(false)
        step("Reject a cudax directory that lacks the cuda- prefix")
        expect(compiler_cuda_composition_selector_v1("build/compositions/cudax/a.spl")).to_equal(false)
        step("Reject a path whose build prefix is only a suffix")
        expect(compiler_cuda_composition_selector_v1("xbuild/a/compositions/cuda-1/m.spl")).to_equal(false)
