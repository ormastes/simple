# Helper for lockless_refresh_stress_test.shs: one production inventory refresh
# on a shared checkout root + shared cache root. Env: ROOT, CACHE_ROOT, COLD.
use app.compiler_entrypoint.inventory_events.{compiler_inventory_refresh_v1}
use std.nogc_sync_mut.io.env_ops.{env_get}

fn main():
    val root = env_get("ROOT") ?? ""
    val cache_root = env_get("CACHE_ROOT") ?? ""
    val cold = (env_get("COLD") ?? "0") == "1"
    val result = compiler_inventory_refresh_v1(root, cache_root, ["src", "test"], cold)
    if result.valid:
        print("REFRESH-OK digest={result.inventory_digest} generation={result.inventory_generation}")
    else:
        print("REFRESH-FAIL reason={result.reason}")
main()
