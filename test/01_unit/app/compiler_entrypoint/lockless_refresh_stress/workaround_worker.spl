# Helper for lockless_refresh_stress_test.shs: one incremental workaround
# index refresh for PATHS (comma separated) on ROOT, or MODE=load to print
# the merged link count.
use app.bug.workaround_store.{refresh_workarounds_at, load_workarounds_at}
use std.nogc_sync_mut.io.env_ops.{env_get}

fn main():
    val root = env_get("ROOT") ?? ""
    if (env_get("MODE") ?? "refresh") == "load":
        match load_workarounds_at(root):
            case Ok(index): print("LOAD-OK links={index.links.len()} complete={index.complete}")
            case Err(reason): print("LOAD-FAIL reason={reason}")
        return
    val raw = env_get("PATHS") ?? ""
    val paths = if raw == "": [] else: raw.split(",")
    match refresh_workarounds_at(root, (env_get("FULLSCAN") ?? "0") == "1", paths):
        case Ok(index): print("WA-OK links={index.links.len()}")
        case Err(reason): print("WA-FAIL reason={reason}")
main()
