#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd -P)
source="$root/src/app/compiler_entrypoint/demand_entry_path.spl"
cli="$root/src/app/cli/_CliMain/main_and_help.spl"

test -f "$source"
grep -q 'package_command_resolve_v1(command, cwd, args)' "$source"
grep -q 'compiler_entrypoint_admit_v1(roots)' "$source"
grep -q 'read_only_file_view_open_v1' "$source"
grep -q 'DEMAND_ENTRY_HEAD_BYTES_V1' "$source"
grep -q 'scan_import_head_v1' "$source"
grep -q 'full_parse_sources.push(frozen)' "$source"
grep -q 'demand_entry_inside_package_v1' "$source"
grep -q 'package_section_reader_open_v1' "$source"
grep -q 'package_section_reader_read_v1' "$source"
grep -q 'selected_sections' "$source"
grep -q 'recursive-package-index-route-required' "$source"
! grep -Eq 'find_files_recursive|walk_directory|recursive.*scan' "$source"
grep -q 'demand_compile_entry_prepare_v1' "$cli"

printf '%s\n' 'DEMAND_ENTRY_PATH_STATIC_PASS'
