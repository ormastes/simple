# codex-system-test
# @req seven-plans-item-1-host-path-parity
# @platform: windows
# Windows-only explicit-file row. The platform tag excludes ordinary directory
# discovery in interpreter/native/SMF modes; it is not automatic OS selection.
use std.spec.{describe, it, expect, step}
use app.io.env_ops.{cwd}
use app.io.file_ops.{file_exists}
use app.compiler_entrypoint.admission.{CompilerEntrypointAdmissionV1, compiler_entrypoint_frozen_path_v1}

describe "Windows verbatim frozen source path mapping":
    it "maps an existing Windows verbatim path to the same snapshot identity":
        step("Prove the verbatim source names an existing Windows file")
        val root = cwd().replace("\\", "/")
        val admission = CompilerEntrypointAdmissionV1(true, "fixture", root, root + "/build/frozen-path-fixture", "fixture-revision", "fixture-index", 1)
        val source = "src/lib/scv/distributed_identity.spl"
        val verbatim = "\\\\?\\" + (admission.root + "/" + source).replace("/", "\\")
        expect(file_exists(verbatim)).to_be(true)
        step("Resolve that filesystem identity through the public admission owner")
        expect(compiler_entrypoint_frozen_path_v1(admission, verbatim)).to_equal(admission.snapshot_root + "/" + source)
