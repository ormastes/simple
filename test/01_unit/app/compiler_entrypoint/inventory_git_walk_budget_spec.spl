use std.spec.*
use app.io.time_ops.{time_now_unix_micros}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_git_lines_v1, compiler_inventory_git_bound_ms_v1}

# Perf budget for the cold-init git listing phase
# (windows_scv_inventory_cold_init_untracked_walk_slow_2026-09-13).
# Measured 2026-11-03: --cached 0.6 s, --others 3.5 s on the full checkout
# (was 5 s / 47 s on 2026-09-13). Budget has ~15x margin for a loaded box.
val LISTING_BUDGET_SECONDS = 60

describe "inventory git listing budget":
    it "bounds the git subprocess well below the old 300 s workaround":
        expect(compiler_inventory_git_bound_ms_v1() <= 120000).to_equal(true)

    it "lists tracked plus untracked sources within the wall budget":
        val t0 = time_now_unix_micros()
        val listed = compiler_inventory_git_lines_v1(".", ["-c", "core.quotePath=false",
            "ls-files", "-t", "--cached", "--others", "--exclude-standard", "--", "src"])
        val elapsed_s = (time_now_unix_micros() - t0) / 1000000
        expect(listed != nil).to_equal(true)
        expect(elapsed_s < LISTING_BUDGET_SECONDS).to_equal(true)
