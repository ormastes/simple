use std.spec.*
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.file_ops.{file_write}
use app.compiler_entrypoint.source_authority.{compiler_source_authority_uncovered_root_v1}

val SNAP = "build/test_tmp/inventory_root_coverage/snap"

fn make_snapshot():
    dir_create_all(SNAP + "/src/app")
    dir_create_all(SNAP + "/src/lib/nogc_async_mut/oauth")
    dir_create_all(SNAP + "/src/plugins_extra")
    file_write(SNAP + "/src/app/a.spl", "")

describe "inventory root coverage":
    it "accepts roots that all exist in the snapshot":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["src/app", "src/lib"], SNAP)).to_equal("")

    it "names a requested root missing from a truncated snapshot":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["src/app", "src/lib", "src/plugins"], SNAP)).to_equal("src/plugins")

    it "does not treat a name prefix as coverage":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["src/plugins"], SNAP)).to_equal("src/plugins")

    it "normalizes absolute, backslash and trailing-slash roots":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["/w/src/os"], SNAP)).to_equal("src/os")
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["src\\app\\", "src/lib/"], SNAP)).to_equal("")

    it "accepts a single-file selector":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["src/app/a.spl"], SNAP)).to_equal("")

    it "skips derived build/ selectors":
        make_snapshot()
        expect(compiler_source_authority_uncovered_root_v1(
            "/w", ["build/hw/x"], SNAP)).to_equal("")
