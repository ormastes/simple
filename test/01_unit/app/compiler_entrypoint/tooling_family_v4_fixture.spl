use app.compiler_entrypoint.source_authority.{compiler_source_authority_acquire_v1, compiler_source_authority_validate_v1}
use app.compiler_entrypoint.inventory_events.{compiler_inventory_cursor_decode_v1}
use std.scv.compile_source_inventory.{compile_source_inventory_plain_checkout_v1, compile_source_inventory_read_pointer_content_v1, compile_source_inventory_apply_and_publish_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.file_ops.{path_absolute}
use app.io.mod.{file_delete}
use app.io.time_ops.{time_now_unix_micros}
use std.io_runtime.{dir_create_all, file_write, file_read}
use std.nogc_async_mut.sosix.host_facade.{sosix_run}

fn tooling_v4_scopes() -> [text]:
    ["src/compositions/kernel_llvm_cranelift", "src/compositions/cuda_static", "src/compiler", "src/app", "src/lib", "src/os", "src/plugins", "examples/10_tooling"]

fn tooling_v4_git(root: text, args: [text]) -> bool:
    val result = sosix_run("git", ["-C", root] + args)
    result.exit_code == 0

fn tooling_v4_commit(root: text) -> bool:
    if not tooling_v4_git(root, ["add", "src", "test", "examples/10_tooling"]): return false
    tooling_v4_git(root, ["-c", "user.name=Tooling inventory fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture"])

fn tooling_v4_setup(root: text) -> text:
    for scope in tooling_v4_scopes():
        if not dir_create_all(root + "/" + scope): return "mkdir"
        if not file_write(root + "/" + scope + "/probe.spl", "fn probe() -> i64: 1\n"): return "write"
    if not dir_create_all(root + "/test"): return "test-mkdir"
    if not file_write(root + "/test/probe.spl", "fn probe() -> i64: 1\n"): return "test-write"
    if not dir_create_all(root + "/examples/10_tooling-other"): return "sibling-mkdir"
    if not file_write(root + "/examples/10_tooling-other/outside.spl", "fn outside() -> i64: 9\n"): return "sibling-write"
    if not tooling_v4_git(root, ["init", "-q"]): return "git-init"
    if not tooling_v4_commit(root): return "git-commit"
    ""

fn tooling_v4_roundtrip_io() -> text:
    val root = compile_source_inventory_plain_checkout_v1(path_absolute("build/tests/tooling-v4-roundtrip-{time_now_unix_micros()}"))
    val setup = tooling_v4_setup(root)
    if setup != "": return setup
    val cache = root + "/build/scv"
    val initial = compiler_source_authority_acquire_v1(root, cache, tooling_v4_scopes(), true)
    if not initial.valid: return "cold:" + initial.reason
    if initial.snapshot.inventory_count != 8: return "eight-selected-records"
    val pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    if pointer == "" or pointer.len() > 1024: return "published-pointer-bound"
    val separator = pointer.index_of("\n")
    if separator < 0: return "pointer-separator"
    val cursor = compiler_inventory_cursor_decode_v1(pointer.substring(separator + 1))
    if not cursor.valid or cursor.untracked_examples_tooling_digest != sha256_text(""): return "v4-digest-roundtrip"
    val old_example = initial.snapshot.snapshot_root + "/examples/10_tooling/probe.spl"
    val changed = "fn probe() -> i64: 2\n"
    if not file_write(root + "/examples/10_tooling/probe.spl", changed): return "example-edit"
    if not file_write(root + "/test/probe.spl", changed): return "test-edit"
    if not tooling_v4_commit(root): return "changed-commit"
    val source_only = compiler_source_authority_acquire_v1(root, cache, ["src/app"], false)
    if not source_only.valid: return "source-only:" + source_only.reason
    val mixed = compiler_source_authority_validate_v1(root, cache, initial.snapshot, source_only.source_inventory_digest, source_only.inventory_generation, false)
    if mixed.valid: return "mixed-generation-accepted"
    val wrong = compiler_source_authority_validate_v1(root, cache, source_only.snapshot, source_only.source_inventory_digest, source_only.inventory_generation + 1, false)
    if wrong.valid: return "wrong-generation-accepted"
    val example = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling"], false)
    if not example.valid: return "example-warm:" + example.reason
    if file_read(example.snapshot.snapshot_root + "/examples/10_tooling/probe.spl") != changed: return "committed-example-skipped"
    val tests = compiler_source_authority_acquire_v1(root, cache, ["test"], false)
    if not tests.valid: return "test-warm:" + tests.reason
    if file_read(tests.snapshot.snapshot_root + "/test/probe.spl") != changed: return "committed-test-skipped"
    if file_read(old_example) != "fn probe() -> i64: 1\n": return "immutable-snapshot-rewritten"
    val untracked = root + "/examples/10_tooling/untracked.spl"
    if not file_write(untracked, changed): return "untracked-write"
    val added = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling"], false)
    if not added.valid or added.snapshot.inventory_count != 2: return "untracked-add"
    val added_pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    val added_cursor = compiler_inventory_cursor_decode_v1(added_pointer.substring(added_pointer.index_of("\n") + 1))
    if added_cursor.untracked_examples_tooling_digest == cursor.untracked_examples_tooling_digest: return "untracked-digest-not-invalidated"
    if not file_delete(untracked): return "untracked-delete"
    val removed = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling"], false)
    if not removed.valid or removed.snapshot.inventory_count != 1: return "untracked-delete-not-reconciled"
    val preserved = compiler_source_authority_acquire_v1(root, cache, ["src/app"], false)
    if not preserved.valid or preserved.snapshot.inventory_count != 1: return "other-family-lost"
    val sibling = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling-other"], false)
    # Outside-family selectors are auto-added and committed (SCV auto-admit);
    # they never widen the event families.
    if not sibling.valid: return "outside-family-not-auto-admitted:" + sibling.reason
    if file_read(sibling.snapshot.snapshot_root + "/examples/10_tooling-other/outside.spl") != "fn outside() -> i64: 9\n": return "outside-family-not-frozen"
    val absent = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling-absent"], false)
    if absent.valid or absent.reason != "source-inventory-scope-unsupported": return "absent-selector-admitted"
    ""

fn tooling_v4_legacy_io() -> text:
    val root = compile_source_inventory_plain_checkout_v1(path_absolute("build/tests/tooling-v4-legacy-{time_now_unix_micros()}"))
    val setup = tooling_v4_setup(root)
    if setup != "": return setup
    val cache = root + "/build/scv"
    val initial = compiler_source_authority_acquire_v1(root, cache, tooling_v4_scopes(), true)
    if not initial.valid: return "cold:" + initial.reason
    val pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    val cursor = compiler_inventory_cursor_decode_v1(pointer.substring(pointer.index_of("\n") + 1))
    if not cursor.valid: return "initial-cursor"
    # Real publisher produces a legacy v3 cursor; no forged inventory or identity.
    val legacy = compile_source_inventory_apply_and_publish_v1(cache, [], cursor.git_head, cursor.filesystem_rows, cursor.filesystem_digest, sha256_text(pointer), false, cursor.untracked_src_digest, cursor.untracked_test_digest, cursor.untracked_membership_digest)
    if not legacy.valid: return "legacy-publish:" + legacy.reason
    val legacy_pointer = compile_source_inventory_read_pointer_content_v1(cache) ?? ""
    val legacy_cursor = compiler_inventory_cursor_decode_v1(legacy_pointer.substring(legacy_pointer.index_of("\n") + 1))
    if not legacy_cursor.valid or legacy_cursor.untracked_examples_tooling_digest != "": return "legacy-reader-contract"
    val refused = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling"], false)
    if refused.valid or not refused.reason.contains("examples-tooling-inventory-authority-missing"): return "legacy-tooling-not-refused"
    val migrated = compiler_source_authority_acquire_v1(root, cache, ["examples/10_tooling"], true)
    if not migrated.valid or migrated.snapshot.inventory_count != 1: return "cold-migration"
    ""

fn tooling_v4_pointer_bound_io() -> text:
    val root = compile_source_inventory_plain_checkout_v1(path_absolute("build/tests/tooling-v4-pointer-{time_now_unix_micros()}"))
    val cache = root + "/build/scv"
    if not dir_create_all(cache + "/source-inventory"): return "pointer-mkdir"
    val digest = sha256_text("")
    val cursor = ["simple-compile-event-cursor-v4", "git_head={digest}", "filesystem_rows=9223372036854775807", "filesystem_digest={digest}", "inventory_digest={digest}", "inventory_generation=9223372036854775807", "untracked_src_digest={digest}", "untracked_test_digest={digest}", "untracked_membership_digest={digest}", "untracked_examples_tooling_digest={digest}"].join("\n")
    val pointer = digest + "\n" + cursor
    # Reader-bound negative fixture only; never offered to source admission.
    if pointer.len() <= 768 or pointer.len() > 1024: return "pointer-fixture-size"
    if not compiler_inventory_cursor_decode_v1(cursor).valid: return "max-cursor-rejected"
    val path = cache + "/source-inventory/CURRENT"
    if not file_write(path, pointer): return "pointer-write"
    if (compile_source_inventory_read_pointer_content_v1(cache) ?? "") != pointer: return "v4-reader-bound"
    var too_large = pointer
    while too_large.len() <= 1024:
        too_large = too_large + "x"
    if not file_write(path, too_large): return "oversize-write"
    if compile_source_inventory_read_pointer_content_v1(cache) != nil: return "oversize-accepted"
    ""

export tooling_v4_roundtrip_io, tooling_v4_legacy_io, tooling_v4_pointer_bound_io
