a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-GEN-APP-001
doc/01_research/local/REQ-GEN-APP-001.md
doc/03_plan/sys_test/REQ-GEN-APP-001.md
doc/04_architecture/REQ-GEN-APP-001.md
doc/05_design/REQ-GEN-APP-001.md
"""
# @req: REQ-GEN-APP-001

# @tag: unit, app, crypto, x25519mlkem768, gpu, evidence, security
# @req REQ-003 REQ-010 REQ-013 NFR-009

use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use app.test.x25519mlkem768_gpu_final_row.{
    x25519_mlkem768_compose_gpu_final_matrix_row}
use app.test.x25519mlkem768_pinned_workload.{
    X25519MlKem768PinnedPublicOutputs,
    X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
    X25519_MLKEM768_PINNED_FIXTURE_ID,
    X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
    X25519_MLKEM768_PINNED_ORACLE_ID,
    X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768RunReceipt}
use lib.common.crypto.x25519_mlkem768.matrix_receipt.{
    X25519MlKem768MatrixRow, X25519MlKem768MatrixAdmissionPhase}
use lib.common.crypto.x25519_mlkem768.pinned_public_receipt.{
    X25519MlKem768PinnedSet, X25519MlKem768PinnedSetReceipt,
    X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
    X25519_MLKEM768_PINNED_MLKEM_CT_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
    X25519_MLKEM768_PINNED_SERVER_X25519_SHA256,
    X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
    X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256}

val _ARTIFACT = "b" * 64

fn _set_a() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.MlKem,
        first_output_label: "mlkem768-encapsulation-key", second_output_label: "mlkem768-ciphertext",
        first_output_bytes: 1184, second_output_bytes: 1088, shared_secret_bytes: 32,
        recovered_secret_bytes: 32, first_output_sha256: X25519_MLKEM768_PINNED_MLKEM_EK_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_MLKEM_CT_SHA256)

fn _set_b() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.X25519,
        first_output_label: "x25519-client-public", second_output_label: "x25519-server-public",
        first_output_bytes: 32, second_output_bytes: 32, shared_secret_bytes: 32,
        recovered_secret_bytes: 32, first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_X25519_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_X25519_SHA256)

fn _set_c() -> X25519MlKem768PinnedSetReceipt:
    X25519MlKem768PinnedSetReceipt(set_id: X25519MlKem768PinnedSet.Hybrid,
        first_output_label: "x25519mlkem768-client-share", second_output_label: "x25519mlkem768-server-share",
        first_output_bytes: 1216, second_output_bytes: 1120, shared_secret_bytes: 64,
        recovered_secret_bytes: 64, first_output_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        second_output_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256)

fn _contract_backend(backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768Backend:
    if backend == X25519MlKem768EvidenceBackend.Cuda:
        return X25519MlKem768Backend.Cuda
    X25519MlKem768Backend.Vulkan

fn _outputs(backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768PinnedPublicOutputs:
    X25519MlKem768PinnedPublicOutputs(
        schema: X25519_MLKEM768_PINNED_WORKLOAD_SCHEMA,
        fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID,
        workload_sha256: X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
        oracle_id: X25519_MLKEM768_PINNED_ORACLE_ID,
        set_a: _set_a(), set_b: _set_b(), set_c: _set_c(),
        client_share_bytes: 1216, server_share_bytes: 1120,
        shared_secret_bytes: 64,
        public_wire_bytes: X25519_MLKEM768_PINNED_PUBLIC_WIRE_BYTES,
        total_observed_bytes: 2400,
        client_share_sha256: X25519_MLKEM768_PINNED_CLIENT_SHARE_SHA256,
        server_share_sha256: X25519_MLKEM768_PINNED_SERVER_SHARE_SHA256,
        keygen_output_digest: "1" * 64,
        encapsulate_output_digest: "2" * 64,
        decapsulate_output_digest: "3" * 64,
        requested_backend: _contract_backend(backend),
        selected_backend: _contract_backend(backend),
        executor_identity: "gpu-final-row-test-device",
        artifact_digest: _ARTIFACT, execution_proof_digest: _ARTIFACT,
        fallback_used: false, candidate_oracle_match: true,
        accelerated_operation_count: 3, kernel_invocations: 3,
        simd_chunk_hits: 0, observed_rvv_vlen_bits: 0,
        compiled: true, submitted: true, fence_completed: true,
        device_readback: true)

fn _receipt(backend: X25519MlKem768EvidenceBackend) -> X25519MlKem768RunReceipt:
    val outputs = _outputs(backend)
    X25519MlKem768RunReceipt(schema: "x25519mlkem768-evidence-v1",
        status: X25519MlKem768EvidenceStatus.Pass,
        reason: "native-gpu-pinned-absolute-correctness-admitted",
        scope: X25519MlKem768EvidenceScope.FullOperation,
        requested_backend: backend, selected_backend: Some(backend),
        mode: X25519MlKem768EvidenceMode.Native, emulated: false,
        promotion_eligible: false,
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        fixture_id: X25519_MLKEM768_PINNED_FIXTURE_ID,
        fixture_manifest_sha256: "4" * 64, fixture_source_sha256: "5" * 64,
        pinned_workload_sha256: X25519_MLKEM768_PINNED_WORKLOAD_SHA256,
        runner_source_sha256: "6" * 64, batch_size: 1,
        client_share_bytes: 1216, server_share_bytes: 1120,
        shared_secret_bytes: 64,
        keygen_output_digest: sha256_text(outputs.keygen_output_digest),
        encapsulate_output_digest: sha256_text(outputs.encapsulate_output_digest),
        decapsulate_output_digest: sha256_text(outputs.decapsulate_output_digest),
        scalar_roundtrip_match: true, fallback_used: false,
        absolute_oracle_match: true, simd_chunk_hits: 0,
        observed_rvv_vlen_bits: 0, kernel_invocations: 3,
        compiled: true, submitted: true, fence_completed: true,
        device_readback: true, artifact_sha256: _ARTIFACT,
        device_identity: "gpu-final-row-test-device")

fn _expect_err(result: Result<X25519MlKem768MatrixRow, text>, expected: text):
    expect(result.is_err()).to_be(true)
    expect(result.unwrap_err()).to_equal(expected)

use std.spec.step

describe "X25519MLKEM768 GPU final-row adapter":
    it "composes exactly one CUDA and Vulkan executed row from pinned outputs":
        # @req: REQ-003
        step("Verify: composes exactly one CUDA and Vulkan executed row from pinned outputs")
        # @req: REQ-GEN-APP-001.
        # @req: REQ-GEN-APP-001
        val cuda = x25519_mlkem768_compose_gpu_final_matrix_row(
            _receipt(X25519MlKem768EvidenceBackend.Cuda),
            _outputs(X25519MlKem768EvidenceBackend.Cuda), _ARTIFACT, _ARTIFACT,
            "linux", "x86_64")
        expect(cuda.is_ok()).to_be(true)
        expect(cuda.unwrap().execution.promotion_eligible).to_be(true)
        val vulkan = x25519_mlkem768_compose_gpu_final_matrix_row(
            _receipt(X25519MlKem768EvidenceBackend.Vulkan),
            _outputs(X25519MlKem768EvidenceBackend.Vulkan), _ARTIFACT, _ARTIFACT,
            "linux", "x86_64")
        expect(vulkan.is_ok()).to_be(true)
        expect(vulkan.unwrap().admission_phase).to_equal(
            X25519MlKem768MatrixAdmissionPhase.Executed)

    it "rejects non-native raw receipts and Metal":
        # @req: REQ-010
        step("Verify: rejects non-native raw receipts and Metal")
        var emulated = _receipt(X25519MlKem768EvidenceBackend.Cuda)
        emulated.mode = X25519MlKem768EvidenceMode.QemuCorrectness
        emulated.emulated = true
        _expect_err(x25519_mlkem768_compose_gpu_final_matrix_row(
            emulated, _outputs(X25519MlKem768EvidenceBackend.Cuda),
            _ARTIFACT, _ARTIFACT, "linux", "x86_64"),
            "gpu-final-row-requires-native-full-operation")
        _expect_err(x25519_mlkem768_compose_gpu_final_matrix_row(
            _receipt(X25519MlKem768EvidenceBackend.Metal),
            _outputs(X25519MlKem768EvidenceBackend.Vulkan),
            _ARTIFACT, _ARTIFACT, "macos", "x86_64"),
            "gpu-final-row-backend-not-admitted")

    it "rejects missing A/B/C identity and tampered operation binding":
        # @req: REQ-013
        step("Verify: rejects missing A/B/C identity and tampered operation binding")
        var missing_set = _outputs(X25519MlKem768EvidenceBackend.Cuda)
        missing_set.set_c.set_id = X25519MlKem768PinnedSet.MlKem
        _expect_err(x25519_mlkem768_compose_gpu_final_matrix_row(
            _receipt(X25519MlKem768EvidenceBackend.Cuda), missing_set,
            _ARTIFACT, _ARTIFACT, "linux", "x86_64"),
            "gpu-final-row-public-set-identity-mismatch")
        var tampered = _receipt(X25519MlKem768EvidenceBackend.Vulkan)
        tampered.keygen_output_digest = "0" * 64
        _expect_err(x25519_mlkem768_compose_gpu_final_matrix_row(
            tampered, _outputs(X25519MlKem768EvidenceBackend.Vulkan),
            _ARTIFACT, _ARTIFACT, "linux", "x86_64"),
            "gpu-final-row-operation-output-mismatch")
