# @req: REQ-APP-SVIM-001

# @cover src/app/svim/_SvimCore/text_ops.spl 80%

use app.svim.core.*

use std.spec.step

describe "svim count numeric guard":
    it "falls back when a normal command count is too large":
        # @req: REQ-APP-SVIM-001
        step("Verify: falls back when a normal command count is too large")
        val cmd = svim_parse_normal_command("999999999999999999999999999999999999999999999999j")
        expect cmd.name to_equal "move-down"
        expect cmd.count to_equal 1

    it "falls back when an operator motion count is too large":
        # @req: REQ-APP-SVIM-001
        step("Verify: falls back when an operator motion count is too large")
        val cmd = svim_parse_normal_command("d999999999999999999999999999999999999999999999999w")
        expect cmd.name to_equal "delete-motion"
        expect cmd.count to_equal 1
        expect cmd.payload to_equal "word"
