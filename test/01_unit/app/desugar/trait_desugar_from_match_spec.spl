"""
# Trait Desugar `.from()` Match Lowering Specification

Covers OtherFix-15 (#159): verifies that `desugar_traits` lowers trait-group
`G__from(src)` capability acquisition using AOT-safe `match` expressions instead
of `if val`, and that `app.desugar.mod.desugar_source` runs `desugar_traits` in
the standard desugar pipeline without modifying `src/compiler/**`.
"""
use std.spec.*
use std.spec.step
use app.desugar.trait_desugar.{desugar_traits}
use app.desugar.mod.{desugar_source}

fn _two_member_group_fixture() -> text:
    var src = "trait Logger:" + "\n"
    src = src + "    fn log(msg: text) -> bool" + "\n"
    src = src + "\n"
    src = src + "trait Tracer:" + "\n"
    src = src + "    fn trace(span: text) -> bool" + "\n"
    src = src + "\n"
    src = src + "trait Session:" + "\n"
    src = src + "    fn logger() -> Option<Logger>" + "\n"
    src = src + "    fn tracer() -> Option<Tracer>" + "\n"
    src = src + "    fn obs() -> Option<Obs>" + "\n"
    src = src + "\n"
    src = src + "trait Obs with Logger, Tracer:" + "\n"
    src = src + "    pass_dn" + "\n"
    src

fn _three_member_group_fixture() -> text:
    var src = "trait CapA:" + "\n"
    src = src + "    fn a() -> bool" + "\n"
    src = src + "\n"
    src = src + "trait CapB:" + "\n"
    src = src + "    fn b() -> bool" + "\n"
    src = src + "\n"
    src = src + "trait CapC:" + "\n"
    src = src + "    fn c() -> bool" + "\n"
    src = src + "\n"
    src = src + "trait Host:" + "\n"
    src = src + "    fn cap_a() -> Option<CapA>" + "\n"
    src = src + "    fn cap_b() -> Option<CapB>" + "\n"
    src = src + "    fn cap_c() -> Option<CapC>" + "\n"
    src = src + "    fn all_caps() -> Option<AllCaps>" + "\n"
    src = src + "\n"
    src = src + "trait AllCaps with CapA, CapB, CapC:" + "\n"
    src = src + "    pass_dn" + "\n"
    src

describe "trait_desugar G__from match lowering":
    it "emits match instead of if val in generated G__from body":
        step("Desugar two-member trait group and assert match lowering with zero if val")
        val out = desugar_traits(_two_member_group_fixture())
        expect(out.contains("fn Obs__from(src: Session) -> Option<Obs>:")).to_equal(true)
        expect(out.contains("if val")).to_equal(false)
        expect(out.contains("match __o0:")).to_equal(true)
        expect(out.contains("match __o1:")).to_equal(true)
        expect(out.contains("Some(_):")).to_equal(true)
        expect(out.contains("return None")).to_equal(true)
        expect(out.contains("return src.obs_fn()")).to_equal(true)
        expect(out.contains("    None")).to_equal(true)

    it "scales match-based capability checks across three group members":
        step("Desugar three-member trait group and check all three match arms")
        val out = desugar_traits(_three_member_group_fixture())
        expect(out.contains("fn AllCaps__from(src: Host) -> Option<AllCaps>:")).to_equal(true)
        expect(out.contains("if val")).to_equal(false)
        expect(out.contains("match __o0:")).to_equal(true)
        expect(out.contains("match __o1:")).to_equal(true)
        expect(out.contains("match __o2:")).to_equal(true)
        expect(out.contains("return src.all_caps_fn()")).to_equal(true)

    it "is wired through app.desugar.mod.desugar_source":
        step("Verify desugar_source invokes desugar_traits and lowers Obs__from via match")
        val out = desugar_source(_two_member_group_fixture())
        expect(out.contains("struct Obs:")).to_equal(true)
        expect(out.contains("fn Obs__from(src: Session) -> Option<Obs>:")).to_equal(true)
        expect(out.contains("match __o0:")).to_equal(true)
        expect(out.contains("if val")).to_equal(false)
