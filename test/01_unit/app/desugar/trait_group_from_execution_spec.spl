# Trait-group `.from()` -- EXECUTION regression
#
# Every other assertion about `.from()` in this repo checks emitted TEXT.
# Text assertions let two real defects through:
#
#   1. The emitted body called `src.debug()` when the desugared accessor is a
#      fn-FIELD named `debug_fn`. The generated code did not compile at all
#      ("method `debug` not found on type `SessionCore`") -- invisible to any
#      `out.contains(...)` check.
#   2. The group was built by PAIRING two independently acquired member
#      values. Classes are VALUE types here, so the two halves were diverging
#      COPIES: driving execution through the debug half left the profile half
#      reading zero. Nothing in the type system objects.
#
# So this spec DESUGARS a fixture, WRITES the emitted code to disk, RUNS it in
# a child compiler, and asserts on the child's stdout -- specifically that a
# mutation made through one member's method is OBSERVED by the OTHER member's
# method. A spec that only checks Some/None is exactly what let (2) through.
#
# Bug: doc/08_tracking/bug/
#      capability_group_from_unsound_under_value_semantics_2026-08-09.md
# Design: doc/05_design/app/tools/
#         unified_debug_profile_capability_architecture_2026-08-09.md §3

use app.desugar.trait_desugar (desugar_traits)
use app.io.mod (file_write, file_delete, process_run)

fn fixture() -> text:
    """Two member traits, a session declaring an `Option<M>` accessor for each
    PLUS an `Option<Group>` accessor, and the group itself."""
    var src = "trait DebugTarget:" + "\n"
    src = src + "    me resume() -> bool" + "\n"
    src = src + "\n"
    src = src + "trait ProfileTarget:" + "\n"
    src = src + "    me profile_end() -> i64" + "\n"
    src = src + "\n"
    src = src + "trait SessionCore:" + "\n"
    src = src + "    fn debug() -> Option<DebugTarget>" + "\n"
    src = src + "    fn profile() -> Option<ProfileTarget>" + "\n"
    src = src + "    fn debug_profiler() -> Option<DebugProfiler>" + "\n"
    src = src + "\n"
    src = src + "trait DebugProfiler with DebugTarget, ProfileTarget:" + "\n"
    src = src + "    pass_dn" + "\n"
    src

fn driver() -> text:
    """A runnable `main` appended to the DESUGARED fixture.

    Identity substrate: three independent slots. `debug()` hands back a target
    bound to slot 0, `profile()` one bound to slot 1, and `debug_profiler()`
    ONE value whose two methods are both bound to slot 2.

    That is what discriminates the shapes. The sound single-accessor form reads
    and writes slot 2 through one value, so `OBSERVED=1`. The unsound paired
    form would bump slot 0 and read slot 1, printing `OBSERVED=0` -- the exact
    `expected 6, got 0` signature P2 measured."""
    var d = "\n\nvar S0 = 0\n"
    d = d + "var S1 = 0\n"
    d = d + "var S2 = 0\n\n"
    d = d + "fn bump(id: i64) -> bool:\n"
    d = d + "    if id == 0:\n"
    d = d + "        S0 = S0 + 1\n"
    d = d + "    elif id == 1:\n"
    d = d + "        S1 = S1 + 1\n"
    d = d + "    else:\n"
    d = d + "        S2 = S2 + 1\n"
    d = d + "    true\n\n"
    d = d + "fn read(id: i64) -> i64:\n"
    d = d + "    if id == 0:\n"
    d = d + "        return S0\n"
    d = d + "    if id == 1:\n"
    d = d + "        return S1\n"
    d = d + "    S2\n\n"
    d = d + "fn dbg() -> Option<DebugTarget>:\n"
    d = d + "    DebugTarget(resume_fn: fn() -> bool: bump(0))\n\n"
    d = d + "fn prof() -> Option<ProfileTarget>:\n"
    d = d + "    ProfileTarget(profile_end_fn: fn() -> i64: read(1))\n\n"
    d = d + "fn grp() -> Option<DebugProfiler>:\n"
    d = d + "    DebugProfiler(resume_fn: fn() -> bool: bump(2), profile_end_fn: fn() -> i64: read(2))\n\n"
    d = d + "fn no_dbg() -> Option<DebugTarget>:\n"
    d = d + "    nil\n\n"
    d = d + "fn main():\n"
    d = d + "    val s = SessionCore(debug_fn: dbg, profile_fn: prof, debug_profiler_fn: grp)\n"
    d = d + "    val r = DebugProfiler__from(s)\n"
    d = d + "    if val g = r:\n"
    d = d + "        g.resume_fn()\n"
    d = d + "        print \"OBSERVED=\" + g.profile_end_fn().to_text()\n"
    d = d + "    else:\n"
    d = d + "        print \"ACQUIRED=NONE\"\n"
    d = d + "    val s2 = SessionCore(debug_fn: no_dbg, profile_fn: prof, debug_profiler_fn: grp)\n"
    d = d + "    val r2 = DebugProfiler__from(s2)\n"
    d = d + "    if val g2 = r2:\n"
    d = d + "        print \"MISSING_MEMBER=SOME\"\n"
    d = d + "    else:\n"
    d = d + "        print \"MISSING_MEMBER=NONE\"\n"
    d

fn run_generated() -> text:
    """Desugar, write, and EXECUTE. Returns the child's combined output."""
    val path = "test/01_unit/app/desugar/.tmp_trait_group_from_generated.spl"
    file_write(path, desugar_traits(fixture()) + driver())
    val (out, err, _code) = process_run("bin/simple", ["run", path])
    file_delete(path)
    out + err

describe "generated trait-group .from() actually compiles and runs":

    context "the generated code is EXECUTED, not just text-matched":
        it "compiles -- no unresolved accessor on the desugared session struct":
            val o = run_generated()
            expect(o.contains("method `debug` not found")).to_equal(false)
            expect(o.contains("error: semantic")).to_equal(false)
            expect(o.contains("error: compile failed")).to_equal(false)

        it "acquires the group and reaches the driver's print":
            val o = run_generated()
            expect(o.contains("OBSERVED=")).to_equal(true)
            expect(o.contains("ACQUIRED=NONE")).to_equal(false)

    context "REGRESSION -- one member's mutation is seen by the other member":
        it "a resume() driven through the group is counted by profile_end()":
            # THE bug. Paired-copy acquisition prints OBSERVED=0 here and
            # passes every Some/None check ever written against it.
            val o = run_generated()
            expect(o.contains("OBSERVED=1")).to_equal(true)

        it "does not report a zero measurement after a real mutation":
            val o = run_generated()
            expect(o.contains("OBSERVED=0")).to_equal(false)

    context "all-or-nothing acquisition still holds at RUNTIME":
        it "yields None when a member capability is absent":
            val o = run_generated()
            expect(o.contains("MISSING_MEMBER=NONE")).to_equal(true)
            expect(o.contains("MISSING_MEMBER=SOME")).to_equal(false)
