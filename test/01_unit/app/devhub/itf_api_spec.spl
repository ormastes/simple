# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/app/devhub/cmd_api.spl 60%
#
# `itf api` (J2): pure-function coverage for the parts that don't need a
# live network call. cmd_api.spl now sends requests via
# std.nogc_sync_mut.io.http_sffi.rt_http_request (the real extern-backed
# transport — the prior std.nogc_sync_mut.http_client-based version only
# ever built a request tuple and never sent it, see cmd_api.spl's header
# comment), so the actual send isn't exercised here — only the pure
# URL-resolution and header-building helpers it calls first, plus the
# --jira/confluence REST base builders in auth.spl.

use std.spec.step

use app.devhub.cmd_api.{_resolve_api_url, _build_api_headers, _build_api_headers_many, _extract_flag_values}
use app.devhub.auth.{jira_api_base, confluence_api_base}
use app.devhub.config.{ItfConfig}



describe "_resolve_api_url":
    # @manual scenario evidence

    it "prefixes a relative path with the base":
        # @req REQ-SSPEC-APP
        step("prefixes a relative path with the base")
        expect(_resolve_api_url("/pages?limit=5", "https://x.atlassian.net/wiki/api/v2")).to_equal("https://x.atlassian.net/wiki/api/v2/pages?limit=5")

    it "leaves an absolute URL unchanged even when a base is available":
        # @req REQ-SSPEC-APP
        step("leaves an absolute URL unchanged even when a base is available")
        expect(_resolve_api_url("https://other.example.com/thing", "https://x.atlassian.net/wiki/api/v2")).to_equal("https://other.example.com/thing")

    it "leaves a relative path unchanged when no base is configured":
        # @req REQ-SSPEC-APP
        step("leaves a relative path unchanged when no base is configured")
        expect(_resolve_api_url("/pages", "")).to_equal("/pages")


describe "_build_api_headers":

    it "always includes Accept: application/json":
        # @req REQ-SSPEC-APP
        step("always includes Accept: application/json")
        val headers = _build_api_headers("", "", false)
        expect(headers.len()).to_equal(1)
        expect(headers[0]).to_equal("Accept: application/json")

    it "adds Authorization when auth is configured":
        # @req REQ-SSPEC-APP
        step("adds Authorization when auth is configured")
        val headers = _build_api_headers("Basic xyz", "", false)
        expect(headers.contains("Authorization: Basic xyz")).to_equal(true)

    it "adds Content-Type when a body is present":
        # @req REQ-SSPEC-APP
        step("adds Content-Type when a body is present")
        val headers = _build_api_headers("", "", true)
        expect(headers.contains("Content-Type: application/json")).to_equal(true)

    it "attaches --header verbatim — the fix for the previously-dead flag":
        # @req REQ-SSPEC-APP
        step("attaches --header verbatim — the fix for the previously-dead flag")
        val headers = _build_api_headers("", "X-Custom: value", false)
        expect(headers.contains("X-Custom: value")).to_equal(true)

    it "combines all four when everything is set":
        # @req REQ-SSPEC-APP
        step("combines all four when everything is set")
        val headers = _build_api_headers("Basic xyz", "X-Custom: value", true)
        expect(headers.len()).to_equal(4)

    it "retains ordered repeated headers selected by gateway policy":
        # @req REQ-SSPEC-APP
        step("Compose transport-owned and repeated target headers")
        val headers = _build_api_headers_many("Basic xyz", ["X-Scope: one", "X-Scope: two"], true)
        expect(headers.len()).to_equal(5)
        expect(headers[3]).to_equal("X-Scope: one")
        expect(headers[4]).to_equal("X-Scope: two")


describe "repeated api flag extraction":

    it "collects spaced and equals --header forms in CLI order":
        # @req REQ-SSPEC-APP
        step("Preserve each explicit header for case-insensitive policy merging")
        val values = _extract_flag_values(["--header", "X-A: one", "--verbose", "--header=X-A: two=continued"], "--header")
        expect(values.len()).to_equal(2)
        expect(values[0]).to_equal("X-A: one")
        expect(values[1]).to_equal("X-A: two=continued")


fn _config_with_jira_url(url: text) -> ItfConfig:
    ItfConfig(
        confluence_url: "", confluence_user: "", confluence_default_space: "",
        jira_url: url, jira_acli_path: "acli", jira_email: "",
        default_output: "text", color_mode: "auto",
        editor_override: "", pager_override: "", token_cmds: [],
        wiki_default_backend: "",
        tasks_default_backend: "",
        tasks_jira_done_status: "",
    )


fn _config_with_jira_gateway(url: text) -> ItfConfig:
    ItfConfig(
        confluence_url: "", confluence_user: "", confluence_default_space: "",
        jira_url: "https://origin.example", jira_gateway_url: url,
        jira_headers: ["X-Classification: restricted", "X-Scope: jira"],
        jira_acli_path: "acli", jira_email: "",
        default_output: "text", color_mode: "auto", editor_override: "", pager_override: "",
        token_cmds: [], wiki_default_backend: "", tasks_default_backend: "", tasks_jira_done_status: ""
    )


fn _config_with_confluence_url(url: text) -> ItfConfig:
    ItfConfig(
        confluence_url: url, confluence_user: "", confluence_default_space: "",
        jira_url: "", jira_acli_path: "acli", jira_email: "",
        default_output: "text", color_mode: "auto",
        editor_override: "", pager_override: "", token_cmds: [],
        wiki_default_backend: "",
        tasks_default_backend: "",
        tasks_jira_done_status: "",
    )


describe "jira_api_base / confluence_api_base (--jira REST base selection)":

    it "jira_api_base appends rest/api/3":
        # @req REQ-SSPEC-APP
        step("jira_api_base appends rest/api/3")
        expect(jira_api_base(_config_with_jira_url("https://x.atlassian.net"))).to_equal("https://x.atlassian.net/rest/api/3")

    it "jira_api_base handles a trailing slash":
        # @req REQ-SSPEC-APP
        step("jira_api_base handles a trailing slash")
        expect(jira_api_base(_config_with_jira_url("https://x.atlassian.net/"))).to_equal("https://x.atlassian.net/rest/api/3")

    it "jira_api_base is empty when jira.url isn't configured":
        # @req REQ-SSPEC-APP
        step("jira_api_base is empty when jira.url isn't configured")
        expect(jira_api_base(_config_with_jira_url(""))).to_equal("")

    it "jira_api_base uses the complete configured gateway prefix":
        step("Resolve relative Jira API requests through the selected gateway")
        expect(jira_api_base(_config_with_jira_gateway("https://gateway.example/jira/"))).to_equal("https://gateway.example/jira")

    it "confluence_api_base still appends api/v2 (default, unchanged by --jira)":
        # @req REQ-SSPEC-APP
        step("confluence_api_base still appends api/v2 (default, unchanged by --jira)")
        expect(confluence_api_base(_config_with_confluence_url("https://x.atlassian.net/wiki"))).to_equal("https://x.atlassian.net/wiki/api/v2")
