# devhub messenger — CLI verb unit tests (targets / doctor record builders).
#
# Feature: DevHub messenger read-only access (plan §11.1, §11.2)
# Category: DevHub, Messenger, CLI
# Status: Implemented
#
# The pure record builders behind `devhub messenger targets` and
# `devhub messenger doctor --target T`: structured target/action/status/
# warnings fields, §11.1 redaction (no paths, endpoints, or secret refs),
# honest adapter status for the unintegrated stub, and structured error
# records with §11.2 exit codes.
#
# Source: src/app/devhub/cmd_messenger.spl

use std.spec.{describe, it, expect}
use app.devhub.messenger.config.{parse_messenger_config, MessengerConfig}
use app.devhub.cmd_messenger.{
    messenger_targets_json, messenger_doctor_json, messenger_error_json
}


fn _full_fixture() -> text:
    """
messenger:
    schema_version: 1
    default_target: local_work

messenger.local_work:
    read_provider: sqlcipher4_database
    send_provider: none
    send_enabled: false
    cache_mode: none
    sync_policy: on_demand

messenger.local_work.db:
    path: /home/user/authorized-messenger/messages.db
    format: sqlcipher4
    access: read_only
    profile: sqlcipher4_4k_sha512
    key_kind: passphrase
    secret_ref: secret://messenger/local_work/db_key

messenger.local_work.schema:
    profile_id: work_room_v1
    room_table: room
    room_id: id
    room_name: title
    member_table: room_member
    member_room_id: room_id
    member_identity_id: member_id
    message_table: messages
    message_id: id
    message_room_id: room_id
    message_sender_id: sender_id
    message_body: body
    message_created_at: created_at
    message_sequence: seq
    timestamp_unit: ms
    sequence_kind: monotonic_within_room

messenger.team_chat:
    read_provider: api
    send_provider: api
    send_enabled: false
    cache_mode: none
    sync_policy: on_demand

messenger.team_chat.api:
    adapter: mattermost
    endpoint: https://chat.example.org
    credential_ref: secret://messenger/team_chat/api_token
"""


describe "devhub messenger targets verb":

    it "emits one structured record per target with the §11.2 fields":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_targets_json(parsed.config)
        expect(payload.contains("\"action\":\"targets\"")).to_be(true)
        expect(payload.contains("\"status\":\"ok\"")).to_be(true)
        expect(payload.contains("\"target\":\"local_work\"")).to_be(true)
        expect(payload.contains("\"target\":\"team_chat\"")).to_be(true)
        expect(payload.contains("\"read_provider\":\"sqlcipher4_database\"")).to_be(true)
        expect(payload.contains("\"read_only\":true")).to_be(true)
        expect(payload.contains("\"warnings\":[]")).to_be(true)

    it "redacts filesystem paths, endpoints, and secret refs (§11.1)":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_targets_json(parsed.config)
        expect(payload.contains("secret://")).to_be(false)
        expect(payload.contains("/home/user")).to_be(false)
        expect(payload.contains("chat.example.org")).to_be(false)
        expect(payload.contains("db_key")).to_be(false)

    it "marks read-only sources with the structural warning":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_targets_json(parsed.config)
        expect(payload.contains("read-only source: send and all source writes are structurally denied")).to_be(true)

    it "reports an empty registry as a valid result with a warning":
        val empty = MessengerConfig(schema_version: 1, default_target: "", max_targets: 32, targets: [], pipelines: [])
        val payload = messenger_targets_json(empty)
        expect(payload.contains("\"count\":0")).to_be(true)
        expect(payload.contains("no messenger targets declared")).to_be(true)


describe "devhub messenger doctor verb":

    it "reports the adapter truthfully as unintegrated with a warning":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_doctor_json(parsed.config.targets[0], "messenger.sdn default_target", [])
        expect(payload.contains("\"action\":\"doctor\"")).to_be(true)
        expect(payload.contains("\"status\":\"ok\"")).to_be(true)
        expect(payload.contains("\"resolved_from\":\"messenger.sdn default_target\"")).to_be(true)
        expect(payload.contains("\"adapter_status\":\"capability_unavailable\"")).to_be(true)
        expect(payload.contains("\"codec-not-integrated\"")).to_be(true)
        expect(payload.contains("read adapter not integrated")).to_be(true)

    it "proves read-only posture and includes a schema fingerprint":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_doctor_json(parsed.config.targets[0], "--target flag", [])
        expect(payload.contains("\"read_only\":true")).to_be(true)
        expect(payload.contains("\"schema_fingerprint\":\"")).to_be(true)
        expect(payload.contains("\"capabilities\":[\"list_rooms\",\"list_members\",\"history\",\"fetch_message\"]")).to_be(true)

    it "summarizes the nonsecret policy posture":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_doctor_json(parsed.config.targets[0], "", [])
        expect(payload.contains("\"expose_message_body_to_agents\":false")).to_be(true)
        expect(payload.contains("\"allow_remote_send\":false")).to_be(true)
        expect(payload.contains("\"send_enabled\":false")).to_be(true)
        expect(payload.contains("\"max_read_batch\":200")).to_be(true)

    it "carries caller IO findings as extra warnings without leaking paths":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_doctor_json(parsed.config.targets[0], "", ["declared source database is not present (authorized snapshot may be missing)"])
        expect(payload.contains("declared source database is not present")).to_be(true)
        expect(payload.contains("/home/user")).to_be(false)

    it "uses the stub for api targets too, naming the provider kind":
        val parsed = parse_messenger_config(_full_fixture())
        expect(parsed.ok).to_be(true)
        val payload = messenger_doctor_json(parsed.config.targets[1], "--target flag", [])
        expect(payload.contains("\"read_provider\":\"api\"")).to_be(true)
        expect(payload.contains("\"adapter_status\":\"unregistered\"")).to_be(true)
        expect(payload.contains("no adapter registered for read_provider 'api'")).to_be(true)


describe "devhub messenger structured error records":

    it "encodes the exit code and a machine status":
        val payload = messenger_error_json("doctor", 2, "no messenger target resolved")
        expect(payload.contains("\"status\":\"error\"")).to_be(true)
        expect(payload.contains("\"code\":2")).to_be(true)
        expect(payload.contains("no messenger target resolved")).to_be(true)

    it "escapes quotes and newlines in error messages":
        val payload = messenger_error_json("doctor", 2, "bad \"quoted\"\nvalue")
        expect(payload.contains("bad \\\"quoted\\\"\\nvalue")).to_be(true)
