"""Canonical product versions remain one checked manifest with declared projections."""
# @req: REQ-008
# @ac: AC-9
use std.spec.{describe, it, expect, step}
use app.devhub.version_manifest.{parse_version_manifest, version_projection_drift, version_undeclared_consumers, version_render_plan, version_explain}

fn version_fixture(line: text) -> text:
    "version:\n" +
    "  schema: simple-release-version/1\n" +
    "  product: simple\n" +
    "  semver: 1.4.2\n" +
    "  line: " + line + "\n" +
    "  channel: stable\n" +
    "compatibility:\n" +
    "  public_api_major: 1\n" +
    "  compiler_abi: 7\n" +
    "  bootstrap_protocol: 4\n" +
    "  package_format: 3\n" +
    "  scv_store_schema: 2\n" +
    "  scv_wire_protocol: 1\n" +
    "  devhub_provider_api: 1\n" +
    "  spipe_skill_api: 1\n" +
    "  release_manifest_schema: 1\n" +
    "  bootstrap_receipt_schema: 1\n" +
    "projections:\n" +
    "  - VERSION\n" +
    "  - src/app/simple.sdn\n"

describe "Canonical release version manifest":
    it "accepts matching release line and detects projection drift":
        step("Validate the canonical version and line")
        val manifest = parse_version_manifest(version_fixture("1.4"))
        expect(manifest.valid).to_be(true)
        step("Check every declared projection")
        expect(version_projection_drift(manifest, ["1.4.2", "1.4.1"])).to_equal(["src/app/simple.sdn"])
        expect(version_undeclared_consumers(manifest, ["VERSION", "src/runtime/version.h"])).to_equal(["src/runtime/version.h"])
        expect(version_render_plan(manifest)).to_equal(["VERSION=1.4.2", "src/app/simple.sdn=1.4.2"])
        expect(version_explain(manifest)).to_contain("release/1.4")

    it "requires every compatibility dimension":
        val missing = version_fixture("1.4").replace("  bootstrap_receipt_schema: 1\n", "")
        expect(parse_version_manifest(missing).valid).to_be(false)
        expect(parse_version_manifest(missing).error).to_contain("requires every")

    it "rejects duplicate unknown and misbound manifest authority":
        val fixture = version_fixture("1.4")
        expect(parse_version_manifest(fixture.replace("  product: simple\n", "  product: simple\n  product: other\n")).error).to_contain("duplicate")
        expect(parse_version_manifest(fixture.replace("  product: simple", "  product: other")).valid).to_be(false)
        expect(parse_version_manifest(fixture.replace("  compiler_abi: 7", "  unknown_abi: 7")).error).to_contain("unknown")
        expect(parse_version_manifest(fixture.replace("  public_api_major: 1", "  public_api_major: 2")).error).to_contain("public API major")
        expect(parse_version_manifest(fixture + "  - VERSION\n").valid).to_be(false)

    it "rejects a release line that disagrees with semantic version":
        expect(parse_version_manifest(version_fixture("1.5")).error).to_equal("release line does not match semantic version")

    it "rejects malformed prerelease identifiers":
        val malformed = version_fixture("1.4").replace("1.4.2", "1.4.2-rc..1")
        expect(parse_version_manifest(malformed).error).to_equal("product, semver, line, or channel is invalid")
        expect(parse_version_manifest(version_fixture("1.4").replace("1.4.2", "01.4.2")).valid).to_be(false)
        expect(parse_version_manifest(version_fixture("1.4").replace("1.4.2", "1.4.2-rc.01")).valid).to_be(false)

    it "accepts numbered beta and rejects legacy uppercase RC for new manifests":
        val beta = version_fixture("1.4").replace("1.4.2", "1.4.2-beta.3").replace("channel: stable", "channel: beta")
        expect(parse_version_manifest(beta).valid).to_be(true)
        val legacy = version_fixture("1.4").replace("1.4.2", "1.4.2-RC").replace("channel: stable", "channel: rc")
        expect(parse_version_manifest(legacy).valid).to_be(false)

    it "rejects a prerelease suffix whose channel declaration disagrees":
        val mismatch = version_fixture("1.4").replace("1.4.2", "1.4.2-beta.3")
        expect(parse_version_manifest(mismatch).valid).to_be(false)
