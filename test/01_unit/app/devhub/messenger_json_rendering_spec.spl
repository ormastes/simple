# @cover src/app/devhub/messenger/adapter/db_common.spl
use std.spec.*
use std.spec.step
use app.devhub.messenger.adapter.db_common.{_json_str}
use std.common.json.value.{json_value_parse_opt, json_value_as_text}

describe "Messenger JSON string rendering":
    it "should escape tabs and line controls as valid JSON":
        step("Render message text containing JSON control characters")
        val subject = "first\tsecond\nthird\rfourth"
        expect(_json_str(subject)).to_equal("\"first\\tsecond\\nthird\\rfourth\"")

    it "should retain Unicode and escape quotes and backslashes":
        step("Round trip message text through the actual JSON renderer and parser")
        val subject = "héllo 日本 \"quoted\" \\path"
        val parsed = json_value_parse_opt(_json_str(subject))
        match parsed:
            case Some(json_node): expect(json_value_as_text(json_node).unwrap()).to_equal(subject)
            case nil: fail("message renderer emitted invalid JSON")

    it "should render an empty message as a JSON string":
        step("Keep an empty message distinct from a missing JSON value")
        expect(_json_str("")).to_equal("\"\"")
