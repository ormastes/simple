# @req: REQ-APP-DEVHUB-001

# Specs for app.devhub.adapter_outlook.
#
# These tests cover the pure parsing + URL-building parts of the adapter
# without requiring a live Microsoft Graph endpoint. The HTTP send paths
# are covered by integration tests against a mock Graph server.

use app.devhub.adapter_outlook.{
    OutlookClient,
    OutlookFolder,
    OutlookMessage,
    outlook_client_from_token,
}


use std.spec.step

describe "outlook client construction":

    it "builds a client targeting the v1.0 Graph base URL":
        # @req: REQ-APP-DEVHUB-001
        step("Verify: builds a client targeting the v1.0 Graph base URL")
        val c = outlook_client_from_token("tok-1", "bugs@example.com")
        expect c.access_token == "tok-1"
        expect c.mailbox_upn == "bugs@example.com"
        expect c.base_url == "https://graph.microsoft.com/v1.0"

    it "uses the v1.0 Graph base, not the decommissioned v2.0 surface":
        # @req: REQ-APP-DEVHUB-001
        step("Verify: uses the v1.0 Graph base, not the decommissioned v2.0 surface")
        # outlook.office.com/api/v2.0 was fully retired in 2024; ensure we
        # never accidentally regress to it.
        val c = outlook_client_from_token("t", "u@e.com")
        expect c.base_url.starts_with("https://graph.microsoft.com/") == true
        expect c.base_url.contains("outlook.office.com") == false


describe "outlook data structures":

    it "constructs an empty message":
        # @req: REQ-APP-DEVHUB-001
        step("Verify: constructs an empty message")
        val m = OutlookMessage(
            id: "", subject: "", from_address: "", from_name: "",
            received: "", body_preview: "", has_attachments: false,
        )
        expect m.id == ""
        expect m.has_attachments == false

    it "constructs a folder with item counts":
        # @req: REQ-APP-DEVHUB-001
        step("Verify: constructs a folder with item counts")
        val f = OutlookFolder(
            id: "AAA", display_name: "Inbox", parent_folder_id: "ROOT",
            total_item_count: 42, unread_item_count: 7,
        )
        expect f.display_name == "Inbox"
        expect f.total_item_count == 42
        expect f.unread_item_count == 7
