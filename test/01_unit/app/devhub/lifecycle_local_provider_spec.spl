# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/app/tools/scv/scv_jj_git_unified_release_review_work_item_2026-08-25.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


"""The in-repo SCV store is a real LifecycleProvider, so the trait surface has an implementer."""
# @req: REQ-SSPEC-APP
# @ac: AC-15
use std.spec.step

use std.spec.{describe, it, expect, step}
use app.devhub.provider.lifecycle_local.{LocalScvProvider, local_scv_provider}
use app.devhub.provider.lifecycle_capability.{provider_review_operation}

describe "Local SCV lifecycle provider":
    # @manual scenario evidence
    it "identifies itself with the adapter name the research doc fixes":
        # @req REQ-SSPEC-APP
        step("identifies itself with the adapter name the research doc fixes")
        # Absolute oracle: doc/01_research/app/tools/scv/
        # scv_jj_git_unified_release_review_work_item_2026-08-25.md:662 names this
        # adapter `local_scv`; codec.spl fixes the envelope schema at scv-lifecycle/1.
        val provider = local_scv_provider()
        expect(provider.provider_id()).to_equal("local_scv")
        expect(provider.discover_capabilities().api_version).to_equal("scv-lifecycle/1")
        expect(provider.discover_capabilities().provider_id).to_equal("local_scv")

    it "reports capabilities the local store can actually back, and no others":
        # @req REQ-SSPEC-APP
        step("reports capabilities the local store can actually back, and no others")
        val capabilities = local_scv_provider().discover_capabilities()
        step("Backed by a real entity codec in src/lib/scv/lifecycle/entity_codec.spl")
        expect(capabilities.source).to_be(true)
        expect(capabilities.task).to_be(true)
        expect(capabilities.release).to_be(true)
        step("Not backed by any local entity codec or transport")
        expect(capabilities.knowledge).to_be(false)
        expect(capabilities.automation).to_be(false)
        expect(capabilities.review != nil).to_be(true)
        expect(capabilities.review.?.merge_queue).to_be(false)
        expect(capabilities.review.?.inline_threads).to_be(false)
        expect(capabilities.review.?.approve).to_be(true)

    it "feeds the existing capability gate so unsupported operations stay explicit":
        # @req REQ-SSPEC-APP
        step("feeds the existing capability gate so unsupported operations stay explicit")
        val capabilities = local_scv_provider().discover_capabilities()
        expect(provider_review_operation(capabilities, "approve", true).ok).to_be(true)
        val gap = provider_review_operation(capabilities, "enqueue", true)
        expect(gap.ok).to_be(false)
        expect(gap.code).to_equal("PROVIDER_SEMANTIC_GAP")
