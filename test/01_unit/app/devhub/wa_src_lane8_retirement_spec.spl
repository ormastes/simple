use std.spec
use app.devhub.gh_compat.{
    PR_CREATE_KNOWN,
    PR_LIST_KNOWN,
    PR_VIEW_KNOWN,
    PR_REVIEW_KNOWN,
    PR_MERGE_KNOWN,
    PR_COMMENT_KNOWN,
    gh_pr_to_bb_argv
}
use app.devhub.adapter_minio.{_minio_binary_payload_hash}
use std.common.crypto.sha256.{sha256_u8_fast_hex}
use app.io._CliCompile.compile_targets.{CliNativeBuildParsedOptionsV1, cli_native_build_parse_options_v1}
use std.gc_async_mut.gpu.browser_engine.html_named_character_references.{
    html_named_reference_names,
    html_named_reference_values
}
use common.web.public_suffix.{is_public_suffix}
use lib.common.search.generated.unicode_17_0_0.{
    unicode_table_samples_for_spec,
    unicode_is_alphabetic,
    unicode_canonical_combining_class
}
use std.nogc_sync_mut.io_runtime.{file_read}

describe "WA-S8 workaround retirement and status verification":

    it "Bug #1: retires gh_compat static array concat workaround and preserves PR_*_KNOWN tables":
        expect(PR_CREATE_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend",
            "--title", "--head", "--base", "--body", "--reviewer"
        ])
        expect(PR_LIST_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend",
            "--state", "--limit"
        ])
        expect(PR_VIEW_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend"
        ])
        expect(PR_REVIEW_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend",
            "--approve", "--unapprove"
        ])
        expect(PR_MERGE_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend",
            "--squash", "--rebase", "--merge", "--strategy", "--keep-source"
        ])
        expect(PR_COMMENT_KNOWN).to_equal([
            "--json", "--jq", "--no-pager", "--workspace", "--repo", "--backend",
            "--body", "--content", "--inline-path", "--inline-from", "--inline-to"
        ])

        val translated = gh_pr_to_bb_argv("create", ["--title", "Fix", "--head", "feat", "--base", "main"])
        expect(translated.0).to_equal(true)
        expect(translated.1).to_contain("--title")
        expect(translated.2).to_equal("")

        val gh_src = file_read("src/app/devhub/gh_compat.spl")
        expect(gh_src.contains("phase2_module_static_array_concat_initialization_2026_10_27")).to_equal(false)
        expect(gh_src.contains("@workaround")).to_equal(false)

    it "Bug #2: retires adapter_minio sha256 [u8]->[i64] copy workaround and matches SHA-256 goldens":
        val empty_bytes: [u8] = []
        val empty_golden = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        expect(_minio_binary_payload_hash(empty_bytes)).to_equal(empty_golden)
        expect(_minio_binary_payload_hash(empty_bytes)).to_equal(sha256_u8_fast_hex(empty_bytes))

        val high_bytes: [u8] = [0u8, 128u8, 255u8]
        val high_golden = "5240672d7b51756b829ad0ef8d9468b7a078afa2f410484fd3892dab47becb72"
        expect(_minio_binary_payload_hash(high_bytes)).to_equal(high_golden)
        expect(_minio_binary_payload_hash(high_bytes)).to_equal(sha256_u8_fast_hex(high_bytes))

        val mixed_bytes: [u8] = [0u8, 128u8, 255u8, 65u8, 10u8]
        val mixed_golden = "27041e6e01b219382c3f088ed30b721653d18a97734e7bad9ad05c97fcdff0fb"
        expect(_minio_binary_payload_hash(mixed_bytes)).to_equal(mixed_golden)
        expect(_minio_binary_payload_hash(mixed_bytes)).to_equal(sha256_u8_fast_hex(mixed_bytes))

        val cafe_utf8: [u8] = [99u8, 97u8, 102u8, 195u8, 169u8]
        val cafe_golden = "850f7dc43910ff890f8879c0ed26fe697c93a067ad93a7d50f466a7028a9bf4e"
        expect(_minio_binary_payload_hash(cafe_utf8)).to_equal(cafe_golden)
        expect(_minio_binary_payload_hash(cafe_utf8)).to_equal(sha256_u8_fast_hex(cafe_utf8))

        val seq70: [u8] = [
            0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8, 9u8,
            10u8, 11u8, 12u8, 13u8, 14u8, 15u8, 16u8, 17u8, 18u8, 19u8,
            20u8, 21u8, 22u8, 23u8, 24u8, 25u8, 26u8, 27u8, 28u8, 29u8,
            30u8, 31u8, 32u8, 33u8, 34u8, 35u8, 36u8, 37u8, 38u8, 39u8,
            40u8, 41u8, 42u8, 43u8, 44u8, 45u8, 46u8, 47u8, 48u8, 49u8,
            50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8, 58u8, 59u8,
            60u8, 61u8, 62u8, 63u8, 64u8, 65u8, 66u8, 67u8, 68u8, 69u8
        ]
        val seq70_golden = "5767d69a906d4860db9079eb7e90ab4a543e5cb032fce846554aef6ceb600e1d"
        expect(_minio_binary_payload_hash(seq70)).to_equal(seq70_golden)
        expect(_minio_binary_payload_hash(seq70)).to_equal(sha256_u8_fast_hex(seq70))

        val minio_src = file_read("src/app/devhub/adapter_minio.spl")
        expect(minio_src).to_contain("sha256_u8_fast_hex(body)")
        expect(minio_src.contains("phase2_u8_accelerated_sha256_ffi_carrier_2026_10_27")).to_equal(false)
        expect(minio_src.contains("@workaround")).to_equal(false)

    it "Bug #3: keeps compile_targets stage2-gated phase split with working option parser":
        val parsed: CliNativeBuildParsedOptionsV1 = cli_native_build_parse_options_v1([
            "src/app/cli/main.spl",
            "-o",
            "build/out_bin",
            "--verbose"
        ])
        expect(parsed.ok).to_equal(true)
        expect(parsed.status).to_equal(0)
        expect(parsed.entry_point).to_equal("src/app/cli/main.spl")
        expect(parsed.output).to_equal("build/out_bin")
        expect(parsed.verbose).to_equal(true)

        val ct_src = file_read("src/app/io/_CliCompile/compile_targets.spl")
        expect(ct_src).to_contain("@workaround bug=ssa_write_count_quadratic_scan_2026_10_25")

    it "Bug #4: keeps public_suffix_data and html_named_character_references text tables intact":
        val names = html_named_reference_names()
        val values = html_named_reference_values()
        expect(names.len()).to_be_greater_than(2000)
        expect(values.len()).to_equal(names.len())
        expect(is_public_suffix("com")).to_equal(true)
        expect(is_public_suffix("co.uk")).to_equal(true)
        expect(is_public_suffix("example.invalid_not_a_tld")).to_equal(false)

        val ps_src = file_read("src/lib/common/web/public_suffix_data.spl")
        val html_src = file_read("src/lib/gc_async_mut/gpu/browser_engine/html_named_character_references.spl")
        expect(ps_src).to_contain("@workaround")
        expect(html_src).to_contain("@workaround")

    it "Bug #5: keeps unicode_17_0_0 text-encoded tables intact and functional":
        val samples = unicode_table_samples_for_spec()
        expect(samples.len()).to_be_greater_than(0)
        expect(unicode_is_alphabetic(0x0041)).to_equal(true)
        expect(unicode_is_alphabetic(0x0030)).to_equal(false)
        expect(unicode_canonical_combining_class(0x0301)).to_equal(230)

        val uni_src = file_read("src/lib/common/search/generated/unicode_17_0_0.spl")
        expect(uni_src).to_contain("@workaround")
        expect(uni_src).to_contain("stage2_codegen_large_array_literal_2026-11-02")
