# @cover src/app/devhub/flags.spl
use std.spec.*
use std.spec.step
use app.devhub.flags.{_positional_args, _positional_args_with_booleans, _extract_flag, _remove_flags}

describe "DevHub positional flag boundaries":
    it "should retain positional values after valueless switches":
        step("Parse a MinIO bucket following boolean display flags")
        expect(_positional_args(["--bytes", "--no-pager", "bucket", "key"]).join("|")).to_equal("bucket|key")
        expect(_positional_args_with_booleans(["--json", "bucket", "key"], ["--json"]).join("|")).to_equal("bucket|key")

    it "should remove value flags in separated and equals forms":
        step("Extract a bucket while omitting a prefix option")
        expect(_positional_args(["--prefix", "logs/", "bucket"]).join("|")).to_equal("bucket")
        expect(_positional_args(["--prefix=logs/", "bucket"]).join("|")).to_equal("bucket")

    it "should preserve option-looking positional values after the terminator":
        step("End option parsing before a literal object key")
        expect(_positional_args(["--", "--literal", "-file"]).join("|")).to_equal("--literal|-file")
        expect(_extract_flag(["--", "--prefix=literal"], "--prefix", "default")).to_equal("default")
        expect(_remove_flags(["--", "--bytes", "bucket"], ["--bytes"]).join("|")).to_equal("--|--bytes|bucket")

    it "should not consume another option as a missing value":
        step("Read a malformed prefix option followed by a valueless switch")
        expect(_positional_args(["--prefix", "--bytes", "bucket"]).join("|")).to_equal("bucket")
        expect(_extract_flag(["--prefix", "--bytes"], "--prefix", "default")).to_equal("default")
        expect(_remove_flags(["--bytes", "bucket"], ["--bytes"]).join("|")).to_equal("bucket")
