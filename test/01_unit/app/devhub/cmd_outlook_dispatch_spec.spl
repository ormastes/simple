# @req REQ-SSPEC-UNIT
# devhub outlook command dispatch: help and error exit codes (unconfigured auth).

use std.spec.{describe, it, expect}
use std.spec.step
use app.devhub.cmd_outlook.{handle_outlook}

describe "handle_outlook dispatch":
    it "returns 0 for no arguments":
        step("dispatch empty args")
        expect(handle_outlook([])).to_equal(0)

    it "returns 0 for help spellings":
        step("dispatch help, --help, -h")
        expect(handle_outlook(["help"])).to_equal(0)
        expect(handle_outlook(["--help"])).to_equal(0)
        expect(handle_outlook(["-h"])).to_equal(0)

    it "returns 1 for an unknown subcommand":
        step("dispatch bogus")
        expect(handle_outlook(["bogus"])).to_equal(1)

    it "returns 1 for subcommands without operands":
        step("dispatch each subcommand with no operands")
        for sub in ["folders", "messages", "get", "move", "mark"]:
            expect(handle_outlook([sub])).to_equal(1)
