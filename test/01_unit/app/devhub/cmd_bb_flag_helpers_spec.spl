# @req REQ-SSPEC-UNIT
"""
# Devhub bb flag helpers

As a devhub user, the flag parsing
helpers behind the bb command must give predictable results.
"""

use std.spec.step
use std.spec.*
use app.devhub.cmd_bb.{_bb_parse_int, _bb_resolve_limit, _bb_resolve_workspace, _bb_resolve_repo}

describe "Devhub bb flag helpers":
    it "parses a plain integer and falls back to the default":
        step("parse int")
        expect(_bb_parse_int("45", 30)).to_equal(45)
        expect(_bb_parse_int("", 30)).to_equal(30)
        expect(_bb_parse_int("abc", 7)).to_equal(7)
        expect(_bb_parse_int("0", 30)).to_equal(0)

    it "rejects mixed or signed input instead of skipping non-digits":
        step("strict parse")
        expect(_bb_parse_int("1x2", 30)).to_equal(30)
        expect(_bb_parse_int("-5", 30)).to_equal(30)
        expect(_bb_parse_int("12 ", 30)).to_equal(30)

    it "reads the limit from --limit, -L or the =form with a default of 30":
        step("limit")
        expect(_bb_resolve_limit(["pr", "list", "--limit", "5"])).to_equal(5)
        expect(_bb_resolve_limit(["pr", "list", "-L", "12"])).to_equal(12)
        expect(_bb_resolve_limit(["--limit=8"])).to_equal(8)
        expect(_bb_resolve_limit(["pr", "list"])).to_equal(30)

    it "prefers --project over --workspace over --ws for the owner slot":
        step("workspace")
        expect(_bb_resolve_workspace(["--project", "PROJ", "--workspace", "w"])).to_equal("PROJ")
        expect(_bb_resolve_workspace(["--workspace", "w", "--ws", "x"])).to_equal("w")
        expect(_bb_resolve_workspace(["--ws", "short"])).to_equal("short")

    it "takes the repo slug from --repo":
        step("repo")
        expect(_bb_resolve_repo(["--repo", "my-repo"])).to_equal("my-repo")
        expect(_bb_resolve_repo(["--repo=other"])).to_equal("other")
