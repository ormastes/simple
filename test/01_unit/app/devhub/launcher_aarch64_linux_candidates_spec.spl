# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
"""
# App launchers probe the aarch64 Linux release runtime

Bug row: app_launchers_no_admitted_runtime_aarch64_linux_2026_10_19.

bin/devhub, bin/caret, bin/itf, bin/dash, bin/portal, bin/sj and
bin/simple-interp listed only x86_64 Linux (plus macOS/Windows) release
paths, so on an aarch64 Linux host they never looked at
`bin/release/aarch64-unknown-linux-gnu/simple` -- the path `bin/simple`
itself resolves to there -- and exited 127. The provenance gate in
bin/devhub (scripts/lib/simple-runtime-provenance.shs, which
refuses a Rust seed) is deliberate and is NOT changed by this fix.
"""

use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

val _AARCH64 = "release/aarch64-unknown-linux-gnu/simple"

describe "App launchers list the aarch64 Linux release runtime":
    it "lists it in every launcher that lists the x86_64 Linux runtime":
        # @req REQ-SSPEC-APP
        step("read each launcher and check its candidate list")
        for name in ["devhub", "caret", "itf", "dash", "portal", "sj", "simple-interp"]:
            val source = rt_file_read_text("bin/" + name) ?? ""
            expect(source).to_contain("release/x86_64-unknown-linux-gnu/simple")
            expect(source).to_contain(_AARCH64)

    it "keeps the seed-refusing provenance gate in devhub":
        # @req REQ-SSPEC-APP
        step("the admission boundary is unchanged")
        expect(rt_file_read_text("bin/devhub") ?? "").to_contain("simple_runtime_provenance_admits")
