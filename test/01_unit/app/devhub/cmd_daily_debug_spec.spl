"""
## Purpose and audience
Unit coverage of the devhub daily-debug pipeline for the devhub maintainers:
Jira-key and MinIO-URL extractors, the filename triage classifier, watermark
roundtrip persistence, and the `--dry-run` no-side-effect guarantee of
`app.devhub.cmd_daily_debug`.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/01_unit/app/devhub/cmd_daily_debug_spec.spl`
from the repo root after touching any extractor regex, triage rule, or the
daily-debug driver in `src/app/devhub/cmd_daily_debug.spl`.
## Compatibility and limitations
Extractor scenarios feed crafted message bodies; they do not fetch live Jira or
MinIO content. The dry-run scenarios assert the exit code only — write
suppression is guaranteed structurally by the single `if not dry_run` gate
around each `file_write_text` call, not re-proven here.
## Verification guidance and troubleshooting
An extractor failure means the whitespace-aware token rules regressed — the
multi-line scenarios were the exact defect shape of the original space-split
implementation, so start there. A watermark failure indicates render/parse
asymmetry; a dry-run failure means the driver attempted a real write.
"""
# Lifecycle: doc/01_research/app/tools/scv/scv_jj_git_devhub_spipe_unified_lifecycle_2026-08-25.md ;
# doc/03_plan/agent_tasks/scv_jj_git_devhub_spipe_unified_lifecycle.md ;
# doc/04_architecture/app/tools/scv_jj_git_devhub_spipe_unified_lifecycle.md ;
# doc/05_design/app/devhub/devhub_overview.md
# @manual_section: daily-debug-extractors

use std.spec
use app.devhub.cmd_daily_debug.{
    extract_jira_keys,
    extract_minio_urls,
    triage_kind,
    triage_all,
    parse_watermark,
    render_watermark,
    run_daily_debug,
}

describe "extract_jira_keys (issue #10 step 3)":

    it "extracts a single ABC-123 style key":
        # @req REQ-DEVHUB-DAILY-001
        # @capture(protocol_json): extracted key list for a prose body
        step("Extract keys from a prose body holding one uppercase key")
        val keys = extract_jira_keys("Please look at ABC-123 today.")
        expect(keys.len()).to_equal(1)  # oracle: the body names exactly one uppercase key
        expect(keys[0]).to_equal("ABC-123")

    it "extracts multiple keys from one body":
        # @req REQ-DEVHUB-DAILY-001
        # @capture(protocol_json): extracted key list for a multi-key body
        step("Extract keys from a body holding three differently-shaped keys")
        val body = "ABC-1, DEF12-9999 and the closed ABC-2."
        val keys = extract_jira_keys(body)
        expect(keys.len()).to_equal(3)  # oracle: the body contains exactly three uppercase KEY-NUM tokens
        expect(keys[0]).to_equal("ABC-1")
        expect(keys[1]).to_equal("DEF12-9999")
        expect(keys[2]).to_equal("ABC-2")

    it "ignores lowercase tokens":
        # @req REQ-DEVHUB-DAILY-002
        # @capture(protocol_json): extracted key list for a mixed-case body
        step("Extract keys from a body mixing a lowercase token with an uppercase key")
        val keys = extract_jira_keys("foo-12 is not a key but FOO-12 is.")
        expect(keys.len()).to_equal(1)  # oracle: only the uppercase FOO-12 qualifies as a key
        expect(keys[0]).to_equal("FOO-12")

describe "extract_minio_urls (issue #10 step 3)":
    # @manual_section: daily-debug-urls

    it "extracts a single https URL":
        # @req REQ-DEVHUB-DAILY-003
        # @capture(protocol_json): extracted URL list for a prose body
        step("Extract URLs from a prose body holding one https link")
        val urls = extract_minio_urls("Get https://minio.example.com/bug/abc-123/fw.bin please.")
        expect(urls.len()).to_equal(1)  # oracle: the body embeds exactly one URL
        expect(urls[0]).to_equal("https://minio.example.com/bug/abc-123/fw.bin")

    it "extracts multiple URLs":
        # @req REQ-DEVHUB-DAILY-003
        # @capture(protocol_json): extracted URL list for a two-link body
        step("Extract URLs from a body holding one http and one https link")
        val body = "http://a.com/x/y.elf and https://b.io/p/q.dmp"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(2)  # oracle: both embedded links must be found

    # Regression: the extractor split on " " only, so real (multi-line) message
    # bodies silently lost their artifacts. Every case below returned the wrong
    # answer before the whitespace-split fix; the single-line cases above stayed
    # green throughout, which is why the defect went unseen.
    it "extracts a URL that sits on its own line":
        # @req REQ-DEVHUB-DAILY-004
        # @capture(protocol_json): extracted URL for a line-own link
        step("Verify: extracts a URL that sits on its own line")
        val body = "Please check the dump:\nhttps://minio.example/bucket/dump/x.dmp\nThanks"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/dump/x.dmp")

    it "does not swallow the next line into a line-final URL":
        # @req REQ-DEVHUB-DAILY-004
        # @capture(protocol_json): extracted URL for a line-final link
        step("Verify: does not swallow the next line into a line-final URL")
        val body = "Dump: https://minio.example/bucket/dump/y.dmp\nRegards"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/dump/y.dmp")
        expect(triage_kind(urls[0])).to_equal("dump")

    it "extracts a tab-separated URL":
        # @req REQ-DEVHUB-DAILY-004
        # @capture(protocol_json): extracted URL for a tab-separated link
        step("Verify: extracts a tab-separated URL")
        val urls = extract_minio_urls("artifact:\thttps://minio.example/bucket/note/z.log")
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/note/z.log")

describe "triage_kind (issue #10 step 4)":
    # @manual_section: daily-debug-triage

    it "classifies firmware extensions":
        # @req REQ-DEVHUB-DAILY-005
        # @capture(bit_table): triage kinds for firmware extensions
        step("Classify the three firmware artifact extensions")
        expect(triage_kind("https://h/p/fw.bin")).to_equal("fw")
        expect(triage_kind("https://h/p/fw.elf")).to_equal("fw")
        expect(triage_kind("https://h/p/fw.HEX")).to_equal("fw")

    it "classifies dump extensions":
        # @req REQ-DEVHUB-DAILY-005
        # @capture(bit_table): triage kinds for dump extensions
        step("Classify the three dump artifact extensions")
        expect(triage_kind("https://h/p/c.dmp")).to_equal("dump")
        expect(triage_kind("https://h/p/c.core")).to_equal("dump")
        expect(triage_kind("https://h/p/c.crash")).to_equal("dump")

    it "classifies note extensions":
        # @req REQ-DEVHUB-DAILY-005
        # @capture(bit_table): triage kinds for note extensions
        step("Classify the three note artifact extensions")
        expect(triage_kind("https://h/p/n.log")).to_equal("note")
        expect(triage_kind("https://h/p/n.txt")).to_equal("note")
        expect(triage_kind("https://h/p/readme.md")).to_equal("note")

    it "returns unknown for unrecognised extensions":
        # @req REQ-DEVHUB-DAILY-006
        # @capture(bit_table): triage kinds for unrecognised extensions
        step("Classify artifacts whose extensions match no rule")
        expect(triage_kind("https://h/p/x.zip")).to_equal("unknown")
        expect(triage_kind("https://h/p/no-ext")).to_equal("unknown")

    it "triage_all preserves the order of inputs":
        # @req REQ-DEVHUB-DAILY-006
        # @capture(bit_table): ordered triage output for four artifacts
        step("Triage a mixed artifact list and check order preservation")
        val urls = [
            "https://h/p/a.bin",
            "https://h/p/b.dmp",
            "https://h/p/c.txt",
            "https://h/p/d.zip",
        ]
        val out = triage_all(urls)
        expect(out.len()).to_equal(4)  # oracle: one triage result per input artifact
        expect(out[0].kind).to_equal("fw")
        expect(out[1].kind).to_equal("dump")
        expect(out[2].kind).to_equal("note")
        expect(out[3].kind).to_equal("unknown")

describe "watermark roundtrip (issue #10 steps 1+6)":
    # @manual_section: daily-debug-watermark

    it "parses a freshly rendered watermark":
        # @req REQ-DEVHUB-DAILY-007
        # @capture(protocol_json): watermark roundtrip value
        step("Render a watermark timestamp and parse it back")
        val rendered = render_watermark("2026-04-26T12:00:00Z")
        val parsed = parse_watermark(rendered)
        expect(parsed).to_equal("2026-04-26T12:00:00Z")

    it "ignores comments and blank lines":
        # @req REQ-DEVHUB-DAILY-007
        # @capture(protocol_json): watermark parsed from a commented file
        step("Parse a watermark from a file with comments and blank lines")
        val body = "# header\n\nlast_run: \"2026-04-26T00:00:00Z\"\n"
        expect(parse_watermark(body)).to_equal("2026-04-26T00:00:00Z")

    it "returns empty when key absent":
        # @req REQ-DEVHUB-DAILY-008
        # @capture(protocol_json): watermark parse of a keyless file
        step("Parse a watermark file that holds no last_run key")
        expect(parse_watermark("# nothing useful here\n")).to_equal("")

describe "run_daily_debug --dry-run (issue #10 AC4)":
    # @manual_section: daily-debug-dry-run

    it "exits 0 with --dry-run and writes no files":
        # @req REQ-DEVHUB-DAILY-009
        # @capture(statistics): dry-run exit code with quiet flag
        step("Verify: run the driver with --dry-run --quiet and check the exit code")
        # In --dry-run mode the driver must not call file_write_text on
        # either the digest or the watermark. The outlook adapter is gated
        # by `outlook_available = false` so step 2 returns []. The test
        # verifies the exit code only; the absence of file writes is
        # guaranteed structurally by the single `if not dry_run` gate
        # around each `file_write_text` call.
        val rc = run_daily_debug(["--dry-run", "--quiet"])
        expect(rc).to_equal(0)  # oracle: a dry run with nothing to fetch must succeed silently

    it "exits 0 with --dry-run alone":
        # @req REQ-DEVHUB-DAILY-009
        # @capture(statistics): dry-run exit code with no flags
        step("Verify: run the driver with --dry-run alone and check the exit code")
        val rc = run_daily_debug(["--dry-run"])
        expect(rc).to_equal(0)  # oracle: a dry run with nothing to fetch must succeed silently
