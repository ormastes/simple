"""
## Purpose and audience
Purpose: Prove that extract_jira_keys (issue #10 step 3).
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-DEVHUB-001 — stable requirement identity for this spec.

# cmd_daily_debug_spec
"""Unit tests for `cmd_daily_debug.spl` — issue #10 Agent E.

Covers:
- Jira-key regex extractor
- MinIO URL regex extractor
- Triage classifier on a sample list of filenames
- Watermark roundtrip (parse + render)
- `--dry-run` produces zero side effects
"""

use std.spec
use app.devhub.cmd_daily_debug.{
    extract_jira_keys,
    extract_minio_urls,
    triage_kind,
    triage_all,
    parse_watermark,
    render_watermark,
    run_daily_debug,
}

describe "extract_jira_keys (issue #10 step 3)":

    it "extracts a single ABC-123 style key":
        step("Verify: extracts a single ABC-123 style key")
        # @req: REQ-APP-DEVHUB-001
        val keys = extract_jira_keys("Please look at ABC-123 today.")
        expect(keys.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(keys[0]).to_equal("ABC-123")

    it "extracts multiple keys from one body":
        step("Verify: extracts multiple keys from one body")
        val body = "ABC-1, DEF12-9999 and the closed ABC-2."
        val keys = extract_jira_keys(body)
        expect(keys.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(keys[0]).to_equal("ABC-1")
        expect(keys[1]).to_equal("DEF12-9999")
        expect(keys[2]).to_equal("ABC-2")

    it "ignores lowercase tokens":
        step("Verify: ignores lowercase tokens")
        val keys = extract_jira_keys("foo-12 is not a key but FOO-12 is.")
        expect(keys.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(keys[0]).to_equal("FOO-12")

describe "extract_minio_urls (issue #10 step 3)":

    it "extracts a single https URL":
        step("Verify: extracts a single https URL")
        val urls = extract_minio_urls("Get https://minio.example.com/bug/abc-123/fw.bin please.")
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example.com/bug/abc-123/fw.bin")

    it "extracts multiple URLs":
        step("Verify: extracts multiple URLs")
        val body = "http://a.com/x/y.elf and https://b.io/p/q.dmp"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    # Regression: the extractor split on " " only, so real (multi-line) message
    # bodies silently lost their artifacts. Every case below returned the wrong
    # answer before the whitespace-split fix; the single-line cases above stayed
    # green throughout, which is why the defect went unseen.
    it "extracts a URL that sits on its own line":
        step("Verify: extracts a URL that sits on its own line")
        val body = "Please check the dump:\nhttps://minio.example/bucket/dump/x.dmp\nThanks"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/dump/x.dmp")

    it "does not swallow the next line into a line-final URL":
        step("Verify: does not swallow the next line into a line-final URL")
        val body = "Dump: https://minio.example/bucket/dump/y.dmp\nRegards"
        val urls = extract_minio_urls(body)
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/dump/y.dmp")
        expect(triage_kind(urls[0])).to_equal("dump")

    it "extracts a tab-separated URL":
        step("Verify: extracts a tab-separated URL")
        val urls = extract_minio_urls("artifact:\thttps://minio.example/bucket/note/z.log")
        expect(urls.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(urls[0]).to_equal("https://minio.example/bucket/note/z.log")

describe "triage_kind (issue #10 step 4)":

    it "classifies firmware extensions":
        step("Verify: classifies firmware extensions")
        expect(triage_kind("https://h/p/fw.bin")).to_equal("fw")
        expect(triage_kind("https://h/p/fw.elf")).to_equal("fw")
        expect(triage_kind("https://h/p/fw.HEX")).to_equal("fw")

    it "classifies dump extensions":
        step("Verify: classifies dump extensions")
        expect(triage_kind("https://h/p/c.dmp")).to_equal("dump")
        expect(triage_kind("https://h/p/c.core")).to_equal("dump")
        expect(triage_kind("https://h/p/c.crash")).to_equal("dump")

    it "classifies note extensions":
        step("Verify: classifies note extensions")
        expect(triage_kind("https://h/p/n.log")).to_equal("note")
        expect(triage_kind("https://h/p/n.txt")).to_equal("note")
        expect(triage_kind("https://h/p/readme.md")).to_equal("note")

    it "returns unknown for unrecognised extensions":
        step("Verify: returns unknown for unrecognised extensions")
        expect(triage_kind("https://h/p/x.zip")).to_equal("unknown")
        expect(triage_kind("https://h/p/no-ext")).to_equal("unknown")

    it "triage_all preserves the order of inputs":
        step("Verify: triage_all preserves the order of inputs")
        val urls = [
            "https://h/p/a.bin",
            "https://h/p/b.dmp",
            "https://h/p/c.txt",
            "https://h/p/d.zip",
        ]
        val out = triage_all(urls)
        expect(out.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(out[0].kind).to_equal("fw")
        expect(out[1].kind).to_equal("dump")
        expect(out[2].kind).to_equal("note")
        expect(out[3].kind).to_equal("unknown")

describe "watermark roundtrip (issue #10 steps 1+6)":

    it "parses a freshly rendered watermark":
        step("Verify: parses a freshly rendered watermark")
        val rendered = render_watermark("2026-04-26T12:00:00Z")
        val parsed = parse_watermark(rendered)
        expect(parsed).to_equal("2026-04-26T12:00:00Z")

    it "ignores comments and blank lines":
        step("Verify: ignores comments and blank lines")
        val body = "# header\n\nlast_run: \"2026-04-26T00:00:00Z\"\n"
        expect(parse_watermark(body)).to_equal("2026-04-26T00:00:00Z")

    it "returns empty when key absent":
        step("Verify: returns empty when key absent")
        expect(parse_watermark("# nothing useful here\n")).to_equal("")

describe "run_daily_debug --dry-run (issue #10 AC4)":

    it "exits 0 with --dry-run and writes no files":
        step("Verify: exits 0 with --dry-run and writes no files")
        # In --dry-run mode the driver must not call file_write_text on
        # either the digest or the watermark. The outlook adapter is gated
        # by `outlook_available = false` so step 2 returns []. The test
        # verifies the exit code only; the absence of file writes is
        # guaranteed structurally by the single `if not dry_run` gate
        # around each `file_write_text` call.
        val rc = run_daily_debug(["--dry-run", "--quiet"])
        expect(rc).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "exits 0 with --dry-run alone":
        step("Verify: exits 0 with --dry-run alone")
        val rc = run_daily_debug(["--dry-run"])
        expect(rc).to_equal(0)  # oracle: 0 — named expected value from the requirement
