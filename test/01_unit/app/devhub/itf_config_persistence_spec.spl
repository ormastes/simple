use app.devhub.config.{load_config, load_config_for_target, save_config, save_confluence_target, save_auth_token}

extern fn rt_env_get(key: text) -> text?
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text?
extern fn rt_file_delete(path: text) -> bool

val PERSIST_HOME = "/tmp/simple_devhub_target_persistence"

describe "DevHub named target persistence":
    it "preserves default, sibling target headers, and sibling credentials":
        val dir = "{PERSIST_HOME}/.config/itf"
        val config_path = "{dir}/config.sdn"
        val auth_path = "{dir}/auth.sdn"
        val mkdir_ok = rt_dir_create_all(dir)
        val _clean_config = rt_file_delete(config_path)
        val _clean_auth = rt_file_delete(auth_path)
        val config_written = rt_file_write_text(config_path, "confluence:\n    default_target: alpha\n\nconfluence.alpha:\n    url: https://alpha.example/wiki\n    headers:\n        X-One: a\n        X-One: b\n\nconfluence.beta:\n    url: https://beta.example/wiki\n    headers:\n        X-Beta: keep\n")
        val auth_written = rt_file_write_text(auth_path, "confluence.alpha:\n    token: old-alpha\n\nconfluence.beta:\n    token: keep-beta\n\ncustom:\n    token: keep-custom\n")
        val original_home = rt_env_get("HOME") ?? ""
        val home_set = rt_env_set("HOME", PERSIST_HOME)
        val legacy_saved = save_config(load_config())
        val target_saved = save_confluence_target(load_config_for_target("alpha"))
        val auth_saved = save_auth_token("confluence.alpha", "new-alpha")
        val saved_config = rt_file_read_text(config_path) ?? ""
        val saved_auth = rt_file_read_text(auth_path) ?? ""
        val _restore_home = rt_env_set("HOME", original_home)
        expect(mkdir_ok).to_equal(true)
        expect(config_written).to_equal(true)
        expect(auth_written).to_equal(true)
        expect(home_set).to_equal(true)
        expect(legacy_saved).to_equal(true)
        expect(target_saved).to_equal(true)
        expect(auth_saved).to_equal(true)
        expect(saved_config).to_contain("default_target: alpha")
        expect(saved_config).to_contain("confluence.beta:")
        expect(saved_config).to_contain("X-Beta: keep")
        expect(saved_config).to_contain("X-One: a")
        expect(saved_config).to_contain("X-One: b")
        expect(saved_auth).to_contain("token: \"new-alpha\"")
        expect(saved_auth).to_contain("token: keep-beta")
        expect(saved_auth).to_contain("custom:")
