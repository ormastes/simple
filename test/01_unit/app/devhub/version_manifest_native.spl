# Standalone native regression for optional delimiter extraction.
use app.devhub.version_manifest.{parse_version_manifest, render_version_manifest}

class JoinHandle:
    value: i64

    fn join() -> i64?:
        self.value

fn version_fixture(line: text) -> text:
    "version:\n" +
    "  schema: simple-release-version/1\n" +
    "  product: simple\n" +
    "  semver: 1.4.2\n" +
    "  line: " + line + "\n" +
    "  channel: stable\n" +
    "compatibility:\n" +
    "  public_api_major: 1\n" +
    "  compiler_abi: 1\n" +
    "  bootstrap_protocol: 1\n" +
    "  package_format: 1\n" +
    "  scv_store_schema: 1\n" +
    "  scv_wire_protocol: 1\n" +
    "  devhub_provider_api: 1\n" +
    "  spipe_skill_api: 1\n" +
    "  release_manifest_schema: 1\n" +
    "  bootstrap_receipt_schema: 1\n" +
    "projections:\n" +
    "  - VERSION\n" +
    "  - src/app/simple.sdn\n"

fn main() -> i64:
    val valid = parse_version_manifest(version_fixture("1.4"))
    if not valid.valid:
        print "valid manifest rejected: {valid.error}"
        return 1
    val malformed = parse_version_manifest(version_fixture("1.4").replace("  schema:", "  schema"))
    if malformed.valid or malformed.error != "version manifest field requires key and value":
        print "missing delimiter accepted or wrong diagnostic: {malformed.error}"
        return 2
    val mismatch = parse_version_manifest(version_fixture("1.5"))
    if mismatch.valid or mismatch.error != "release line does not match semantic version":
        print "line mismatch accepted or wrong diagnostic: {mismatch.error}"
        return 3
    val expected_render = "version:\n" +
        "  schema: simple-release-version/1\n" +
        "  product: simple\n" +
        "  semver: 1.4.2\n" +
        "  line: 1.4\n" +
        "  channel: stable\n\n" +
        "compatibility:\n" +
        "  public_api_major: 1\n" +
        "  compiler_abi: 1\n" +
        "  bootstrap_protocol: 1\n" +
        "  package_format: 1\n" +
        "  scv_store_schema: 1\n" +
        "  scv_wire_protocol: 1\n" +
        "  devhub_provider_api: 1\n" +
        "  spipe_skill_api: 1\n" +
        "  release_manifest_schema: 1\n" +
        "  bootstrap_receipt_schema: 1\n\n" +
        "projections:\n" +
        "  - VERSION\n" +
        "  - src/app/simple.sdn\n"
    val rendered = render_version_manifest(valid)
    if rendered != expected_render:
        print "version rendering changed: {rendered}"
        return 4
    val joined_handle = JoinHandle(value: 7).join()
    if (joined_handle ?? -1) != 7:
        print "user method join changed"
        return 5
    print "version-manifest-native=PASS assertions=5"
    0
