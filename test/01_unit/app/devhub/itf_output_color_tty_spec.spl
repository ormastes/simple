use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn output_source() -> text:
    rt_file_read_text("src/app/devhub/output.spl") ?? ""

fn terminal_source() -> text:
    rt_file_read_text("src/lib/nogc_sync_mut/tui/terminal.spl") ?? ""

describe "ITF color terminal policy":
    it "uses stdout terminal state for automatic color selection":
        val output = output_source()

        expect(terminal_source()).to_contain("fn terminal_stdout_is_tty() -> bool:")
        expect(output).to_contain("terminal_stdout_is_tty")
        expect(output).to_contain("if not terminal_stdout_is_tty():")

    it "keeps NO_COLOR and explicit force policy ahead of automatic TTY selection":
        val output = output_source()
        val no_color_pos = output.index_of("if env_has(\"NO_COLOR\"):")
        val force_pos = output.index_of("if force == \"1\":")
        val tty_pos = output.index_of("if not terminal_stdout_is_tty():")

        expect(no_color_pos).to_be_greater_than(-1)
        expect(force_pos).to_be_greater_than(no_color_pos)
        expect(tty_pos).to_be_greater_than(force_pos)

    it "does not use stdin TTY state as the stdout color oracle":
        val output = output_source()

        expect(output.contains("terminal_stdin_is_tty")).to_be(false)
