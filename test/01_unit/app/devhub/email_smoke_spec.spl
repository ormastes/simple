# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Smoke spec — just proves cmd_email.spl compiles/loads and the basic
# no-args / unknown-command / no-account paths work. Full fake-binary
# coverage lives in email_cmd_spec.spl.

use std.spec.step

use app.devhub.cmd_email.{handle_email}



describe "cmd_email smoke":
    # @manual scenario evidence

    it "prints help and exits 0 with no args":
        # @req REQ-SSPEC-APP
        step("prints help and exits 0 with no args")
        expect(handle_email([])).to_equal(0)

    it "exits 1 for an unknown subcommand (before touching any config)":
        # @req REQ-SSPEC-APP
        step("exits 1 for an unknown subcommand (before touching any config)")
        expect(handle_email(["bogus"])).to_equal(1)
