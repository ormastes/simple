# @req REQ-CLI-003
# @cover src/app/devhub/adapter_outlook_curl.spl
# @cover src/lib/nogc_sync_mut/oauth2.spl
use std.spec.*
use std.spec.step
use app.devhub.adapter_outlook_curl.{_url_form_encode as outlook_form_encode}
use std.nogc_sync_mut.oauth2.{_url_form_encode as oauth_form_encode}

describe "OAuth form value encoding":
    it "should encode UTF-8 octets consistently in both production clients":
        step("Encode a value containing accented text, CJK, and an emoji")
        val input = "café日本🙂"
        val encoded = "caf%C3%A9%E6%97%A5%E6%9C%AC%F0%9F%99%82"
        expect(outlook_form_encode(input)).to_equal(encoded)
        expect(oauth_form_encode(input)).to_equal(encoded)

    it "should escape form separators, spaces, and literal percent signs":
        step("Encode a value that must remain one form field")
        val input = "a+b &c=d%"
        val encoded = "a%2Bb%20%26c%3Dd%25"
        expect(outlook_form_encode(input)).to_equal(encoded)
        expect(oauth_form_encode(input)).to_equal(encoded)

    it "should preserve empty values and unreserved ASCII":
        step("Encode empty and unreserved form values")
        expect(outlook_form_encode("")).to_equal("")
        expect(oauth_form_encode("")).to_equal("")
        expect(outlook_form_encode("Az09-_.~")).to_equal("Az09-_.~")
        expect(oauth_form_encode("Az09-_.~")).to_equal("Az09-_.~")
