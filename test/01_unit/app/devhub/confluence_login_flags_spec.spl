# @cover src/app/devhub/cmd_auth.spl
#
# `auth login --confluence|--jira` token-flag validation: a Data Center
# bearer PAT needs no --user; basic auth does. Pure function — no config I/O.

use app.devhub.cmd_auth.{_token_login_error}


describe "confluence login flags":

    it "bearer PAT with url and token needs no user":
        expect(_token_login_error("https://wiki.corp:8090/confluence", "", "pat", "bearer")).to_equal("")

    it "basic (default) auth requires a user":
        expect(_token_login_error("https://x.atlassian.net/wiki", "", "tok", "").contains("--user")).to_equal(true)
        expect(_token_login_error("https://x.atlassian.net/wiki", "me@x.com", "tok", "basic")).to_equal("")

    it "url and token are required":
        expect(_token_login_error("", "me@x.com", "tok", "basic").contains("--url")).to_equal(true)
        expect(_token_login_error("https://x.atlassian.net/wiki", "", "", "bearer").contains("--token")).to_equal(true)
