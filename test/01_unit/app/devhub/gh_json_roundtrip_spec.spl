# @cover src/app/devhub/gh_compat.spl
use std.spec.*
use std.spec.step
use app.devhub.gh_compat.{bb_pr_to_gh_json, json_escape}
use std.common.json.value.{JsonValue, json_value_object_from, json_value_serialize, json_value_parse_opt, json_value_field, json_value_as_text}

describe "DevHub backend JSON string roundtrip":
    it "should preserve quoted titles and Unicode text":
        step("Translate a real backend JSON string containing quotes and backslashes")
        val title = "quote\" slash\\ and café"
        val input = json_value_object_from([("id", JsonValue.Int(42)), ("title", JsonValue.Str(title))])
        val output = json_value_parse_opt(bb_pr_to_gh_json(json_value_serialize(input)))!
        expect(json_value_as_text(json_value_field(output, "title"))!).to_equal(title)
        expect(json_value_serialize(json_value_field(output, "number"))).to_equal("42")

    it "should preserve decoded newlines and tabs in descriptions":
        step("Translate control escapes through the production backend adapter")
        val body = "first\nsecond\ttab"
        val input = json_value_object_from([("description", JsonValue.Str(body))])
        val output = json_value_parse_opt(bb_pr_to_gh_json(json_value_serialize(input)))!
        expect(json_value_as_text(json_value_field(output, "body"))!).to_equal(body)

    it "should escape every JSON control character":
        step("Escape low control bytes using the canonical JSON encoder")
        expect(json_escape("\u{0001}\u{0008}\u{000c}")).to_equal("\\u0001\\b\\f")
