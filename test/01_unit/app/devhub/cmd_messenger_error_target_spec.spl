# cmd_messenger_error_target_spec
"""As a script consuming `devhub messenger <verb> --target X --json`, I want
the error record to name the target I asked for, so a failure is attributable
even when the messenger config itself is missing (machine-stable output
carries `target`, messenger_sdn_and_api.md §2)."""

use std.spec
use std.io_runtime.{env_get_opt}
use std.env.{env_set, env_unset}
use app.devhub.cmd_messenger.{messenger_read_record}

fn _restore(name: text, previous: text?) -> bool:
    if val value = previous:
        return env_set(name, value)
    env_unset(name)

fn rooms_with_missing_config(args: [text]) -> (i64, text):
    val home = env_get_opt("HOME")
    val profile = env_get_opt("USERPROFILE")
    val nowhere = "build/tmp/devhub_no_messenger_home_20261115"
    if not env_set("HOME", nowhere):
        return (-1, "")
    if not env_set("USERPROFILE", nowhere):
        return (-1, "")
    val record = messenger_read_record("rooms", args)
    val _h = _restore("HOME", home)
    val _p = _restore("USERPROFILE", profile)
    record

describe "devhub messenger rooms with no messenger.sdn":

    it "echoes the requested --target in the config error record":
        val record = rooms_with_missing_config(["rooms", "--target", "dense", "--json"])
        expect(record.0).to_equal(2)
        expect(record.1).to_contain("\"status\":\"error\"")
        expect(record.1).to_contain("messenger config not found")
        expect(record.1).to_contain("\"target\":\"dense\"")

    it "leaves target empty when no --target was requested":
        val record = rooms_with_missing_config(["rooms", "--json"])
        expect(record.0).to_equal(2)
        expect(record.1).to_contain("\"target\":\"\"")
