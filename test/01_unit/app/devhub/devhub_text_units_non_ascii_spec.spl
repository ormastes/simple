"""
## Purpose and audience
Purpose: As a devhub user whose Jira errors or MinIO buckets carry non-ASCII
text, I want trace ids and XML fields extracted exactly.
Audience: maintainers of the devhub Jira and MinIO adapters.
"""
use app.devhub.adapter_jira.{_parse_trace_id}
use app.devhub.adapter_minio.{_parse_list_buckets_xml}

describe "devhub adapters on non-ASCII input":
    it "extracts the trace id after a non-ASCII error prefix":
        expect(_parse_trace_id("échec, trace id: ab12cd34 retry")).to_equal("ab12cd34")

    it "reads bucket names after non-ASCII XML content":
        val xml = "<R><Owner>Zoë</Owner><Buckets><Bucket><Name>b1</Name><CreationDate>d1</CreationDate></Bucket><Bucket><Name>bé</Name><CreationDate>d2</CreationDate></Bucket></Buckets></R>"
        val buckets = _parse_list_buckets_xml(xml)
        expect(buckets.len()).to_equal(2)
        expect(buckets[0].name).to_equal("b1")
        expect(buckets[1].name).to_equal("bé")
        expect(buckets[1].creation_date).to_equal("d2")
