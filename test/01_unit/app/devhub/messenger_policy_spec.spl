# devhub messenger — read-only policy enforcement unit tests.
#
# Feature: DevHub messenger read-only access (plan §6.8, §12.2, §11.2)
# Category: DevHub, Messenger, Policy
# Status: Implemented
#
# Read-only matrix (database sources are read-only at the TYPE level),
# send-denied matrix (every §6.7 gate in order), agent body default-deny,
# and the SendConfirmReceipt binding.
#
# Source: src/app/devhub/messenger/policy.spl

use std.spec.{describe, it, expect}
use app.devhub.messenger.config.{parse_messenger_config, MessengerTarget}
use app.devhub.messenger.policy.{
    target_is_read_only, target_read_capabilities, check_read, check_send,
    check_agent_body_access, check_source_mutation, messenger_body_digest,
    SendConfirmReceipt, POLICY_OK, POLICY_READ_ONLY_SOURCE, POLICY_SEND_DISABLED,
    POLICY_SEND_NOT_ALLOWED, POLICY_CONFIRMATION_REQUIRED, POLICY_AGENT_BODY_DENIED,
    POLICY_SOURCE_MUTATION_DENIED, POLICY_ROOM_NOT_ALLOWLISTED
}


fn _db_target_sdn(name: text) -> text:
    """A valid read-only sqlcipher4 database source. Double-quoted so the
    {name} placeholders interpolate (triple-quoted strings are raw)."""
    "messenger:\n" +
    "    schema_version: 1\n" +
    "\n" +
    "messenger.{name}:\n" +
    "    read_provider: sqlcipher4_database\n" +
    "    send_provider: none\n" +
    "\n" +
    "messenger.{name}.db:\n" +
    "    path: /home/user/messages.db\n" +
    "    format: sqlcipher4\n" +
    "    access: read_only\n" +
    "    profile: sqlcipher4_4k_sha512\n" +
    "    key_kind: passphrase\n" +
    "    secret_ref: secret://messenger/{name}/db_key\n" +
    "\n" +
    "messenger.{name}.schema:\n" +
    "    profile_id: {name}_v1\n" +
    "    room_table: room\n" +
    "    room_id: id\n" +
    "    room_name: title\n" +
    "    member_table: room_member\n" +
    "    member_room_id: room_id\n" +
    "    member_identity_id: member_id\n" +
    "    message_table: messages\n" +
    "    message_id: id\n" +
    "    message_room_id: room_id\n" +
    "    message_sender_id: sender_id\n" +
    "    message_body: body\n" +
    "    message_created_at: created_at\n" +
    "    message_sequence: seq\n" +
    "    timestamp_unit: ms\n" +
    "    sequence_kind: monotonic_within_room\n"


fn _plain_api_target_sdn(name: text) -> text:
    """A valid api target with every send grant left at default-deny."""
    "messenger:\n" +
    "    schema_version: 1\n" +
    "\n" +
    "messenger.{name}:\n" +
    "    read_provider: api\n" +
    "    send_provider: api\n" +
    "\n" +
    "messenger.{name}.api:\n" +
    "    adapter: mattermost\n" +
    "    endpoint: https://chat.example.org\n" +
    "    credential_ref: secret://messenger/{name}/token\n"


fn _send_ready_api_target_sdn(name: text) -> text:
    """An api target with send_enabled + allow_remote_send + a room allowlist
    + agent body exposure — the only shape that can pass every send gate."""
    "messenger:\n" +
    "    schema_version: 1\n" +
    "\n" +
    "messenger.{name}:\n" +
    "    read_provider: api\n" +
    "    send_provider: api\n" +
    "    send_enabled: true\n" +
    "\n" +
    "messenger.{name}.api:\n" +
    "    adapter: mattermost\n" +
    "    endpoint: https://chat.example.org\n" +
    "    credential_ref: secret://messenger/{name}/token\n" +
    "\n" +
    "messenger.{name}.policy:\n" +
    "    visibility_model: provider_scoped\n" +
    "    allow_remote_send: true\n" +
    "    send_room_allowlist: room_a\n" +
    "    expose_message_body_to_agents: true\n"


fn _target(content: text) -> MessengerTarget:
    parse_messenger_config(content).config.targets[0]


describe "devhub messenger policy — read-only matrix (§6.8)":

    it "treats a sqlcipher4 database source as read-only at the type level":
        val parsed = parse_messenger_config(_db_target_sdn("vault"))
        expect(parsed.ok).to_be(true)
        val target = _target(_db_target_sdn("vault"))
        expect(target_is_read_only(target)).to_be(true)

    it "treats a sqlite3 database source as read-only too":
        val content = _db_target_sdn("plain").replace("    read_provider: sqlcipher4_database\n", "    read_provider: sqlite3_database\n").replace("    format: sqlcipher4\n", "    format: sqlite3\n").replace("    profile: sqlcipher4_4k_sha512\n", "")
        val parsed = parse_messenger_config(content)
        expect(parsed.ok).to_be(true)
        expect(target_is_read_only(parsed.config.targets[0])).to_be(true)

    it "does not treat an api source as read-only":
        val parsed = parse_messenger_config(_plain_api_target_sdn("chat"))
        expect(parsed.ok).to_be(true)
        expect(target_is_read_only(parsed.config.targets[0])).to_be(false)

    it "denies every send/write/rekey/DDL path on a database source with exit 3":
        val target = _target(_db_target_sdn("vault"))
        val send = check_send(target, "room_a", nil)
        expect(send.permitted).to_be(false)
        expect(send.code).to_equal(POLICY_READ_ONLY_SOURCE)
        expect(send.exit_code).to_equal(3)
        for op in ["rekey", "checkpoint", "vacuum", "attach", "ddl", "mark_read", "delete_history"]:
            val verdict = check_source_mutation(target, op)
            expect(verdict.permitted).to_be(false)
            expect(verdict.code).to_equal(POLICY_SOURCE_MUTATION_DENIED)
            expect(verdict.exit_code).to_equal(3)

    it "permits user reads on any valid target":
        val target = _target(_db_target_sdn("vault"))
        expect(check_read(target).permitted).to_be(true)

    it "never advertises send in the read capability set":
        val caps = target_read_capabilities(_target(_plain_api_target_sdn("chat")))
        expect(caps.contains("send")).to_be(false)
        expect(caps.contains("list_rooms")).to_be(true)
        expect(caps.contains("history")).to_be(true)


describe "devhub messenger policy — send gate order (§6.7)":

    it "gate 1: a database source cannot send even with a confirm receipt":
        val target = _target(_db_target_sdn("vault"))
        val receipt = SendConfirmReceipt.create("r1", "vault", "room_a", messenger_body_digest("hi"), "tester")
        val verdict = check_send(target, "room_a", receipt)
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_READ_ONLY_SOURCE)

    it "gate 2: send_provider none is refused":
        val content = """
messenger:
    schema_version: 1

messenger.s:
    read_provider: api
    send_provider: none
    send_enabled: true

messenger.s.api:
    adapter: mattermost
    endpoint: https://chat.example.org
    credential_ref: secret://messenger/s/token

messenger.s.policy:
    allow_remote_send: true
    send_room_allowlist: room_a
"""
        val target = _target(content)
        expect(target_is_read_only(target)).to_be(false)
        val verdict = check_send(target, "room_a", SendConfirmReceipt.create("r1", "s", "room_a", messenger_body_digest("hi"), "tester"))
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_SEND_DISABLED)

    it "gate 3: send_enabled false is refused":
        val target = _target(_plain_api_target_sdn("chat"))
        val verdict = check_send(target, "room_a", SendConfirmReceipt.create("r1", "chat", "room_a", messenger_body_digest("hi"), "tester"))
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_SEND_DISABLED)

    it "gate 4: allow_remote_send false is refused":
        val content = """
messenger:
    schema_version: 1

messenger.s:
    read_provider: api
    send_provider: api
    send_enabled: true

messenger.s.api:
    adapter: mattermost
    endpoint: https://chat.example.org
    credential_ref: secret://messenger/s/token

messenger.s.policy:
    send_room_allowlist: room_a
"""
        val target = _target(content)
        val verdict = check_send(target, "room_a", SendConfirmReceipt.create("r1", "s", "room_a", messenger_body_digest("hi"), "tester"))
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_SEND_NOT_ALLOWED)

    it "gate 5: an empty or 'none' send_room_allowlist denies every room":
        val target = _target(_plain_api_target_sdn("chat"))
        val verdict = check_send(target, "any_room", SendConfirmReceipt.create("r1", "chat", "any_room", messenger_body_digest("hi"), "tester"))
        # send_enabled is false here too, so the gate-3 reason wins; allowlist
        # denial is pinned with a send-enabled fixture below.
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_SEND_DISABLED)
        val enabled = _target(_send_ready_api_target_sdn("snd")).send_enabled
        expect(enabled).to_be(true)

    it "gate 5: a room outside the allowlist is refused":
        val target = _target(_send_ready_api_target_sdn("snd"))
        val verdict = check_send(target, "room_b", SendConfirmReceipt.create("r1", "snd", "room_b", messenger_body_digest("hi"), "tester"))
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_ROOM_NOT_ALLOWLISTED)

    it "gate 6: a matching policy without explicit confirmation is refused":
        val target = _target(_send_ready_api_target_sdn("snd"))
        val verdict = check_send(target, "room_a", nil)
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_CONFIRMATION_REQUIRED)
        expect(verdict.exit_code).to_equal(3)

    it "gate 6: a confirmation receipt for a different room is refused":
        val target = _target(_send_ready_api_target_sdn("snd"))
        val verdict = check_send(target, "room_a", SendConfirmReceipt.create("r1", "snd", "room_b", messenger_body_digest("hi"), "tester"))
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_CONFIRMATION_REQUIRED)

    it "passes every gate only for the fully-granted, confirmed shape":
        val target = _target(_send_ready_api_target_sdn("snd"))
        val parsed = parse_messenger_config(_send_ready_api_target_sdn("snd"))
        expect(parsed.ok).to_be(true)
        val receipt = SendConfirmReceipt.create("r1", "snd", "room_a", messenger_body_digest("hi"), "tester")
        val verdict = check_send(target, "room_a", receipt)
        expect(verdict.permitted).to_be(true)
        expect(verdict.code).to_equal(POLICY_OK)
        expect(verdict.exit_code).to_equal(0)


describe "devhub messenger policy — agent body access defaults deny (§12.2)":

    it "denies agents message bodies by default":
        val target = _target(_db_target_sdn("vault"))
        val verdict = check_agent_body_access(target)
        expect(verdict.permitted).to_be(false)
        expect(verdict.code).to_equal(POLICY_AGENT_BODY_DENIED)
        expect(verdict.exit_code).to_equal(3)

    it "permits agents only with the explicit per-target grant":
        val target = _target(_send_ready_api_target_sdn("snd"))
        expect(check_agent_body_access(target).permitted).to_be(true)

    it "denies api-side read receipts and presence unless explicitly allowed":
        val target = _target(_plain_api_target_sdn("chat"))
        expect(check_source_mutation(target, "mark_read").permitted).to_be(false)
        expect(check_source_mutation(target, "live_presence").permitted).to_be(false)
        expect(check_source_mutation(target, "mark_read").code).to_equal(POLICY_SOURCE_MUTATION_DENIED)


describe "devhub messenger policy — confirm receipt digest binding":

    it "digests are stable, distinct, and 8 lowercase hex digits":
        val a = messenger_body_digest("hello world")
        val b = messenger_body_digest("hello world")
        val c = messenger_body_digest("hello worle")
        expect(a).to_equal(b)
        expect(a == c).to_be(false)
        expect(a.len()).to_equal(8)
        expect(a).to_equal(a.lower())
