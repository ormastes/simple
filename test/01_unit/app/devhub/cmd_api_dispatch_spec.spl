# @req REQ-SSPEC-UNIT
"""
# Devhub api command dispatch

As a devhub user, `itf api` must answer help with success and reject malformed
invocations with a failing exit code before any network call is made.
"""

use std.spec.step
use std.spec.*
use app.devhub.cmd_api.{handle_api}

describe "Devhub api command dispatch":
    it "exits 0 for --help and -h":
        step("help")
        expect(handle_api(["--help"])).to_equal(0)
        expect(handle_api(["GET", "/x", "-h"])).to_equal(0)

    it "exits 1 when method or url is missing":
        step("missing args")
        expect(handle_api([])).to_equal(1)
        expect(handle_api(["GET"])).to_equal(1)

    it "rejects methods other than GET, POST, PUT and DELETE":
        step("method")
        expect(handle_api(["PATCH", "/pages"])).to_equal(1)
        expect(handle_api(["head", "/pages"])).to_equal(1)

    it "rejects conflicting Confluence host and profile selectors":
        step("selector")
        expect(handle_api(["GET", "/pages", "--host", "a.example", "--profile", "b"])).to_equal(1)
