# @cover src/app/devhub/cmd_git.spl
# devhub — gh facade dispatch refusals and number parsing (no network).
use std.spec.*
use std.spec.step
use app.devhub.cmd_git.{handle_git, _parse_i64, _parse_i64_or}

describe "devhub gh facade number parsing":
    it "should parse plain digits":
        expect(_parse_i64("42")).to_equal(42)

    it "should accept a leading hash as devhub tables print it":
        expect(_parse_i64("#12")).to_equal(12)

    it "should fall back when there are no digits":
        expect(_parse_i64_or("abc", 7)).to_equal(7)
        expect(_parse_i64("")).to_equal(0)

describe "devhub gh facade refusals":
    it "should refuse a noun the bitbucket backend does not support":
        expect(handle_git(["--backend", "bitbucket", "issue", "list"])).to_equal(1)

    it "should refuse a pr command with no verb on bitbucket":
        expect(handle_git(["--backend", "bitbucket", "pr"])).to_equal(1)

    it "should refuse a missing --body-file instead of opening an empty PR":
        expect(handle_git(["--backend", "bitbucket", "pr", "create", "--title", "T", "--head", "x", "--body-file", "/definitely/not/here-devhub2.md"])).to_equal(1)

    it "should refuse a gh flag bitbucket cannot honour":
        expect(handle_git(["--backend", "bitbucket", "pr", "create", "--title", "T", "--head", "x", "--draft"])).to_equal(1)
