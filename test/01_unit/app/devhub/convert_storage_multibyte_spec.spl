# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use app.devhub.convert_storage.{storage_to_markdown, markdown_to_storage}


# Multi-byte regression coverage for src/app/devhub/convert_storage.spl
# (Confluence storage XHTML <-> Markdown conversion — arbitrary wiki page
# content, the exact "HTML/user text" HIGH-risk domain from
# doc/08_tracking/bug/bracket_slice_byte_index_survey_2026-07-29.md).
#
# storage_to_markdown's main loop, _find_char/_extract_tag_name, and
# _replace_pairs (used by markdown_to_storage) all used single-index text
# access (`storage[i]`, `s[i]`, `trimmed[end]`) to walk tag/marker
# boundaries. On this engine, single-index text access is
# CHARACTER-indexed (confirmed: `"café"[3]` returns the whole "é", not a
# byte) while every `s[i:j]` SLICE in the same functions is byte-indexed --
# so the cursor walked in character-space but was fed into byte-indexed
# slices as if it were a byte offset.
#
# Concrete failure before the fix: `storage_to_markdown("<p>café text</p><h1>Title</h1>")`
# crashed outright — "semantic: string index out of bounds: index is 30
# but length is 30" — because the char-space cursor walked past the
# byte-space string's actual byte length once "é" (1 char, 2 bytes) put
# the two spaces out of sync.

describe "storage_to_markdown / markdown_to_storage multi-byte":
    # @manual scenario evidence
    it "café before a tag does not crash and converts identically to the ASCII case":
        # @req REQ-SSPEC-UNIT
        step("café before a tag does not crash and converts identically to the ASCII case")
        val with_multibyte = storage_to_markdown("<p>café text</p><h1>Title</h1>")
        val ascii_only = storage_to_markdown("<p>plain text</p><h1>Title</h1>")
        expect(with_multibyte).to_equal("café text\n\n# Title")
        expect(ascii_only).to_equal("plain text\n\n# Title")

    it "CJK content before a tag converts correctly":
        # @req REQ-SSPEC-UNIT
        step("CJK content before a tag converts correctly")
        val out = storage_to_markdown("<p>日本語</p><h2>見出し</h2>")
        expect(out).to_equal("日本語\n\n## 見出し")

    it "em-dash inside tag content does not desync subsequent tag boundaries":
        # @req REQ-SSPEC-UNIT
        step("em-dash inside tag content does not desync subsequent tag boundaries")
        val out = storage_to_markdown("<p>a—b</p><strong>bold</strong>")
        expect(out).to_equal("a—b\n\n**bold**")

    it "multiple multi-byte characters before a closing tag":
        # @req REQ-SSPEC-UNIT
        step("multiple multi-byte characters before a closing tag")
        val out = storage_to_markdown("<em>café日本語—end</em><p>done</p>")
        expect(out).to_equal("*café日本語—end*done")

    it "pure ASCII is unaffected (regression guard)":
        # @req REQ-SSPEC-UNIT
        step("pure ASCII is unaffected (regression guard)")
        val out = storage_to_markdown("<h1>Title</h1><p>Body <strong>bold</strong> text</p>")
        expect(out).to_equal("# Title\n\nBody **bold** text")

    it "markdown_to_storage: multi-byte content inside a paired marker (bold) is not corrupted":
        # @req REQ-SSPEC-UNIT
        step("markdown_to_storage: multi-byte content inside a paired marker (bold) is not corrupted")
        val out = markdown_to_storage("Body **bold café** text")
        expect(out).to_equal("<p>Body <strong>bold café</strong> text</p>")
