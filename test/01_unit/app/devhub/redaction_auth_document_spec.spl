# Focused regression for whole-document auth.sdn masking.
# @cover src/app/devhub/redaction.spl 20%

use std.spec.step
use app.devhub.redaction.redact_devhub_diagnostic


describe "DevHub auth document redaction":

    it "masks every secret in a complete auth SDN document":
        step("Continue past provider sections and accept either assignment separator")
        val auth = "confluence:\n    token: first-secret\njira:\n    password=second-secret"
        val safe = "confluence:\n    token: ***\njira:\n    password= ***"
        expect(redact_devhub_diagnostic(auth)).to_equal(safe)
