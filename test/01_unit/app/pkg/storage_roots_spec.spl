use std.spec.*
use std.common.storage_roots.*
use app.pkg.storage.{package_storage_path_for_roots, package_storage_root_for_roots}

fn fixture_roots() -> StorageRoots:
    StorageRoots(
        user_root: CanonicalPath(value: "/users/example/simple-storage"),
        worktree_root: CanonicalPath(value: "/workspace/.simple/storage"),
        user_source: RootSource.Explicit,
        worktree_source: RootSource.Explicit,
        policy_version: STORAGE_ROOT_POLICY_VERSION_V1,
        worktree_identity: Digest256(w0: 1u64, w1: 2u64, w2: 3u64, w3: 4u64),
    )

describe "package producer centralized storage":
    it "places reusable packages under the user storage root":
        val path = package_storage_path_for_roots(fixture_roots(), "dep-abc").unwrap()
        expect(path.value).to_equal("/users/example/simple-storage/packages/simple-pkg/git-v1/dep-abc")

    it "uses one stable package listing root":
        val path = package_storage_root_for_roots(fixture_roots()).unwrap()
        expect(path.value).to_equal("/users/example/simple-storage/packages/simple-pkg/git-v1")

    it "rejects traversal cache keys":
        expect(package_storage_path_for_roots(fixture_roots(), "../escape").is_err()).to_equal(true)
