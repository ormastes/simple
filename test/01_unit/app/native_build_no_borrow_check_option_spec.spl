# Regression spec for --no-borrow-check CLI option parsing and normalization.
# @cover src/app/io/_CliCompile/compile_targets.spl
# @cover src/compiler/00.common/driver_compile_options.spl

use std.spec.*
use app.io._CliCompile.compile_targets.{cli_native_build_parse_options_v1}
use compiler.common.driver_core_types.{driver_core_compile_options_default, compileoptions_normalize_mir_optimization}

describe "native-build --no-borrow-check option propagation":
    it "parses --no-borrow-check in cli_native_build_parse_options_v1":
        val default_parsed = cli_native_build_parse_options_v1(["native-build", "--entry", "src/app/cli/main.spl", "-o", "build/out"])
        expect(default_parsed.ok).to_equal(true)
        expect(default_parsed.no_borrow_check).to_equal(false)

        val skip_parsed = cli_native_build_parse_options_v1(["native-build", "--entry", "src/app/cli/main.spl", "--no-borrow-check", "-o", "build/out"])
        expect(skip_parsed.ok).to_equal(true)
        expect(skip_parsed.no_borrow_check).to_equal(true)

    it "preserves no_borrow_check across compileoptions_normalize_mir_optimization":
        var opts = driver_core_compile_options_default()
        opts.profile = "prod"
        opts.release = true
        opts.no_borrow_check = true
        val normalized = compileoptions_normalize_mir_optimization(opts)
        expect(normalized.no_borrow_check).to_equal(true)
        expect(normalized.release).to_equal(true)
