"""
## Purpose and audience
`spipe-docgen` classifies each source line of an SSpec before it can render a
scenario manual. This specification is for documentation-tooling maintainers:
it pins the keyword-line classifier that `generate_feature_doc` depends on, and
guards the defect where that classifier was imported but never defined, which
made manual generation fail for every spec.

## Operator workflow
bin/simple test test/01_unit/app/spipe_docgen/spec_kw_line_spec.spl

## Compatibility and limitations
Pure classification: no filesystem, process, or clock dependency.
"""
# doc-path: doc/08_tracking/bug/spipe_docgen_spec_kw_line_undefined_2026-09-05.md
# @req REQ-PAAP-001
# @manual_section: spipe-docgen scenario-line classification

use std.spec.{describe, it, expect, step}
use app.spipe_docgen.spipe_docgen.common.{spec_kw_line}
use app.spipe_docgen.spipe_docgen.parser.{scenario_at_is_unconditional_pending}

describe "spipe-docgen keyword-line classification":

    it "reports a quoted pending scenario as a pending keyword line":
        step("Classify the exact line shape generate_feature_doc counts as pending")
        # @capture: the computed classification booleans are the retained evidence for this oracle
        # Reproduces doc/08_tracking/bug/spipe_docgen_spec_kw_line_undefined_2026-09-05.md:
        # generator.spl:149 and :181 call this function, which existed nowhere,
        # so every generate_feature_doc run aborted with
        # "semantic: function `spec_kw_line` not found".
        expect(spec_kw_line("pending \"holds the parent root\":", "pending")).to_equal(true)
        expect(spec_kw_line("pending \"holds the parent root\"", "pending")).to_equal(true)

    it "refuses lines that only start with the keyword's letters":
        step("Classify adjacent line shapes that must not be counted as scenarios")
        # @capture: the computed classification booleans are the retained evidence for this oracle
        # Generalization: the classifier is a whole-leading-token test, so an
        # identifier that merely begins with the keyword, or a keyword line with
        # no quoted title, must not be miscounted as a scenario.
        expect(spec_kw_line("pending_label = 1", "pending")).to_equal(false)
        expect(spec_kw_line("pendingfoo \"x\"", "pending")).to_equal(false)
        expect(spec_kw_line("pending", "pending")).to_equal(false)
        expect(spec_kw_line("    pending \"x\"", "pending")).to_equal(false)
        expect(spec_kw_line("it \"x\"", "pending")).to_equal(false)

    it "refuses an empty keyword rather than matching every line":
        step("Classify with a degenerate keyword")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        # An empty keyword would otherwise match any line containing a quote and
        # silently reclassify a whole file.
        expect(spec_kw_line("it \"x\"", "")).to_equal(false)

    it "classifies other spec keywords with the same rule":
        step("Classify a non-pending keyword through the same entry point")
        # @capture: the computed classification booleans are the retained evidence for this oracle
        expect(spec_kw_line("slow_it \"x\":", "slow_it")).to_equal(true)
        expect(spec_kw_line("slow_it_extra \"x\":", "slow_it")).to_equal(false)

describe "spipe-docgen unconditional-pending classification":

    it "reports a scenario whose body is a bare placeholder as pending":
        step("Classify a scaffold scenario")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        # Reproduces the second half of
        # doc/08_tracking/bug/spipe_docgen_spec_kw_line_undefined_2026-09-05.md:
        # generator.spl:138/:143/:174 called this, and it existed nowhere, so
        # `sspec-maintain documentize` aborted with E1002 before writing a mirror.
        val lines = [
            "describe \"d\":",
            "    it \"scaffold\":",
            "        pass_todo",
            "    it \"real\":",
            "        expect(1).to_equal(1)"
        ]
        expect(scenario_at_is_unconditional_pending(lines, 1)).to_equal(true)

    it "reports a scenario with a real assertion as not pending":
        step("Classify a scenario that asserts something")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        val lines = [
            "describe \"d\":",
            "    it \"scaffold\":",
            "        pass_todo",
            "    it \"real\":",
            "        expect(1).to_equal(1)"
        ]
        expect(scenario_at_is_unconditional_pending(lines, 3)).to_equal(false)

    it "treats a nested placeholder as a conditional gate, not a scaffold":
        step("Classify a placeholder guarded by a runtime condition")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        # Generalization: an environment-gated skip inside an `if` is a real
        # oracle for the supported case. Counting it as pending would make the
        # manual's pending column overstate the scaffold count.
        val lines = [
            "describe \"d\":",
            "    it \"gated\":",
            "        if not backend_available():",
            "            skip(\"no backend on this host\")",
            "        expect(render()).to_equal(1)"
        ]
        expect(scenario_at_is_unconditional_pending(lines, 1)).to_equal(false)

    it "ignores comments and docstrings that merely name the placeholder":
        step("Classify a documented scenario that mentions the placeholder syntax")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        val lines = [
            "describe \"d\":",
            "    it \"documented\":",
            "        # pass_todo is what a scaffold would use here",
            "        expect(1).to_equal(1)"
        ]
        expect(scenario_at_is_unconditional_pending(lines, 1)).to_equal(false)

    it "refuses an index that is not a scenario line":
        step("Classify a non-scenario index")
        # @capture: the computed classification boolean is the retained evidence for this oracle
        val lines = ["describe \"d\":", "    it \"x\":", "        pass_todo"]
        expect(scenario_at_is_unconditional_pending(lines, 0)).to_equal(false)
        expect(scenario_at_is_unconditional_pending(lines, 99)).to_equal(false)
        expect(scenario_at_is_unconditional_pending(lines, -1)).to_equal(false)
