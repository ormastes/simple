use std.spec
use app.mcp_t32.session_state.{McpT32Session, McpT32HistoryItem, MCP_T32_SESSIONS, MCP_T32_CURRENT_SESSION, MCP_T32_CURRENT_CORE, MCP_T32_HISTORY, MCP_T32_AREA_READY, MCP_T32_AREA_NAME}

describe "MCP T32 exported session state":
    it "shares all six declared state values across the module boundary":
        step("Write and read exported state without any TRACE32 process or device call")
        val saved_0 = MCP_T32_SESSIONS
        val saved_1 = MCP_T32_CURRENT_SESSION
        val saved_2 = MCP_T32_CURRENT_CORE
        val saved_3 = MCP_T32_HISTORY
        val saved_4 = MCP_T32_AREA_READY
        val saved_5 = MCP_T32_AREA_NAME
        MCP_T32_SESSIONS = [McpT32Session(id: "spec", host: "unused", port: 0, intercom_name: "", architecture: "arm", connected: false, cores: [])]
        MCP_T32_CURRENT_SESSION = "spec-session"
        MCP_T32_CURRENT_CORE = "spec-core"
        MCP_T32_HISTORY = [McpT32HistoryItem(command: "spec-only", result: "record-only", session_id: "spec-session", core_id: "spec-core", request_id: "spec-request")]
        MCP_T32_AREA_READY = true
        MCP_T32_AREA_NAME = "spec-area"
        expect(MCP_T32_SESSIONS.len()).to_equal(1)
        expect(MCP_T32_CURRENT_SESSION).to_equal("spec-session")
        expect(MCP_T32_CURRENT_CORE).to_equal("spec-core")
        expect(MCP_T32_HISTORY.len()).to_equal(1)
        expect(MCP_T32_AREA_READY).to_equal(true)
        expect(MCP_T32_AREA_NAME).to_equal("spec-area")
        MCP_T32_SESSIONS = saved_0
        MCP_T32_CURRENT_SESSION = saved_1
        MCP_T32_CURRENT_CORE = saved_2
        MCP_T32_HISTORY = saved_3
        MCP_T32_AREA_READY = saved_4
        MCP_T32_AREA_NAME = saved_5
