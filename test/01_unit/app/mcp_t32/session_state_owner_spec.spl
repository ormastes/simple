use std.spec
use app.mcp_t32.session_state.{McpT32Core, McpT32Session, McpT32HistoryItem, MCP_T32_HISTORY, t32_session_core_count, t32_compact_history, t32_keep_recent_history}
use app.mcp_t32.session_tools.{t32_add_history_with_request}

fn owner_history(count: i64) -> [McpT32HistoryItem]:
    var items: [McpT32HistoryItem] = []
    var index = 0
    while index < count:
        items = items.push(McpT32HistoryItem(command: "cmd-" + str(index), result: "value-" + str(index), session_id: "session", core_id: "core", request_id: "request-" + str(index)))
        index = index + 1
    items

describe "T32 session state owner":
    it "counts concrete session cores without an erased optional-field loop":
        step("Read the real session core field through its typed owner")
        val empty = McpT32Session(id: "empty", host: "localhost", port: 20000, intercom_name: "", architecture: "arm", connected: false, cores: [])
        expect(t32_session_core_count(empty)).to_equal(0)
        val session = McpT32Session(id: "two", host: "localhost", port: 20000, intercom_name: "", architecture: "arm", connected: true, cores: [McpT32Core(core_id: "0", label: "first", instance_binding: "a"), McpT32Core(core_id: "1", label: "second", instance_binding: "b")])
        expect(t32_session_core_count(session)).to_equal(2)

    it "keeps history unchanged at the compaction threshold":
        step("Retain every record until history exceeds five hundred entries")
        val empty: [McpT32HistoryItem] = []
        expect(t32_compact_history(empty).len()).to_equal(0)
        val kept = t32_compact_history(owner_history(500))
        expect(kept.len()).to_equal(500)
        expect(kept[0].command).to_equal("cmd-0")
        expect(kept[499].request_id).to_equal("request-499")

    it "preserves the ordered suffix and request identity after compaction":
        step("Drop the same first two hundred fifty records as the original range")
        val kept = t32_compact_history(owner_history(501))
        expect(kept.len()).to_equal(251)
        expect(kept[0].command).to_equal("cmd-250")
        expect(kept[0].result).to_equal("value-250")
        expect(kept[0].session_id).to_equal("session")
        expect(kept[0].core_id).to_equal("core")
        expect(kept[250].request_id).to_equal("request-500")

    it "keeps every distinct history field on direct indexed reads":
        step("Read every field of an imported history item directly")
        val items = owner_history(2)
        expect(items[1].command).to_equal("cmd-1")
        expect(items[1].result).to_equal("value-1")
        expect(items[1].session_id).to_equal("session")
        expect(items[1].core_id).to_equal("core")
        expect(items[1].request_id).to_equal("request-1")

    it "keeps the newest suffix up to limit in t32_keep_recent_history":
        step("Slice the trailing recent window and handle zero or negative limits")
        val empty_recent = t32_keep_recent_history(owner_history(5), 0)
        expect(empty_recent.len()).to_equal(0)
        val neg_recent = t32_keep_recent_history(owner_history(5), -2)
        expect(neg_recent.len()).to_equal(0)
        val under_limit = t32_keep_recent_history(owner_history(3), 5)
        expect(under_limit.len()).to_equal(3)
        expect(under_limit[0].command).to_equal("cmd-0")
        val trimmed = t32_keep_recent_history(owner_history(70), 64)
        expect(trimmed.len()).to_equal(64)
        expect(trimmed[0].command).to_equal("cmd-6")
        expect(trimmed[63].request_id).to_equal("request-69")

    it "records and caps recent history fields through session_tools":
        step("Append more than 64 entries and verify slice capping plus direct field reads")
        val saved = MCP_T32_HISTORY
        MCP_T32_HISTORY = []
        var i = 0
        while i < 66:
            t32_add_history_with_request("c-" + str(i), "r-" + str(i), "s1", "core0", "req-" + str(i))
            i = i + 1
        expect(MCP_T32_HISTORY.len()).to_equal(64)
        expect(MCP_T32_HISTORY[0].command).to_equal("c-2")
        expect(MCP_T32_HISTORY[0].result).to_equal("r-2")
        expect(MCP_T32_HISTORY[63].session_id).to_equal("s1")
        expect(MCP_T32_HISTORY[63].core_id).to_equal("core0")
        expect(MCP_T32_HISTORY[63].request_id).to_equal("req-65")
        MCP_T32_HISTORY = saved
