# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Routed live defect (boot-fable run 16, release/1.0.0 pin c7431e08861,
# Stage 2 matrix row compiler_cli_build, class C of
# doc/08_tracking/bug/compiler_cli_build_run16_facade_brace_export_and_t32_relative_imports_2026-11-12.md):
#   src/app/mcp_t32/protocol.spl: unresolved name: t32_nl / t32_server_name /
#   t32_server_version / T32_USE_JSON_LINES / rt_file_read_text / print_raw
# protocol.spl used names that main.spl defined and never imported; the
# interpreter's shared globals hid it, native HIR resolves per module. The
# wire-framing newline, the server identity and the JSON-Lines mode flag are
# now owned by protocol.spl (main.spl imports them from there), and the two
# runtime externs are declared beside protocol.spl's other externs.

use std.spec.step

use app.mcp_t32.protocol.{t32_nl, t32_server_name, t32_server_version}

describe "mcp_t32 protocol owns its wire and identity names":
    """Pins the run-16 routed repro: every name protocol.spl uses resolves
    from protocol.spl itself."""

    it "exports the wire newline":
        step("exports the wire newline")
        expect(t32_nl()).to_equal("\n")

    it "exports the server identity used by the initialize response":
        step("exports the server identity")
        expect(t32_server_name()).to_equal("simple-mcp-t32")
        expect(t32_server_version()).to_equal("0.1.2")
