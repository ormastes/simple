        "roots/list",
        "logging/setLevel",
        "logging/setlevel",
        "ping",
        "notifications/cancelled",
        "notifications/roots/list_changed"
    ]

# JSON-RPC methods recognized by the cold dispatch loop
fn cold_methods() -> [text]:
    [
        "initialize",
        "tools/list",
        "tools/call",
        "resources/list",
        "resources/read",
        "shutdown",
        "ping",
        "notifications/cancelled",
        "notifications/roots/list_changed"
    ]

# ---------------------------------------------------------------------------
# Helper: check membership
# ---------------------------------------------------------------------------

fn list_contains(items: [text], target: text) -> bool:
    for item in items:
        if item == target:
            return true
    false

fn check(condition: bool):
    expect(condition).to_equal(true)

# ===========================================================================
# Tests
# ===========================================================================

# @manual_section: t32-dispatch-wiring
describe "T32 MCP dispatch wiring":

    # -----------------------------------------------------------------------
    context "tool name detection":
    # -----------------------------------------------------------------------

        it "detects t32_sessions_list":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the sessions_list call
            step("Build a tools/call message for t32_sessions_list and detect it")
            val msg = make_tools_call("t32_sessions_list")
            expect(detect_tool_name(msg)).to_equal("t32_sessions_list")

        it "detects t32_session_open":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the session_open call
            step("Build a tools/call message for t32_session_open and detect it")
            val msg = make_tools_call("t32_session_open")
            expect(detect_tool_name(msg)).to_equal("t32_session_open")

        it "detects t32_cmd_run":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the cmd_run call
            step("Build a tools/call message for t32_cmd_run and detect it")
            val msg = make_tools_call("t32_cmd_run")
            expect(detect_tool_name(msg)).to_equal("t32_cmd_run")

        it "detects t32_eval":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the eval call
            step("Build a tools/call message for t32_eval and detect it")
            val msg = make_tools_call("t32_eval")
            expect(detect_tool_name(msg)).to_equal("t32_eval")

        it "detects t32_cmm_run":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the cmm_run call
            step("Build a tools/call message for t32_cmm_run and detect it")
            val msg = make_tools_call("t32_cmm_run")
            expect(detect_tool_name(msg)).to_equal("t32_cmm_run")

        it "detects t32_window_capture":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the window_capture call
            step("Build a tools/call message for t32_window_capture and detect it")
            val msg = make_tools_call("t32_window_capture")
            expect(detect_tool_name(msg)).to_equal("t32_window_capture")

        it "detects t32_field_get with space-colon":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): spaced-JSON detection row for field_get
            step("Detect a tool name written with a space after the colon")
            # Build message with "name": "t32_field_get" (space before value)
            val msg = LB() + Q() + "method" + Q() + ": " + Q() + "tools/call" + Q() + ", " + Q() + "params" + Q() + ": " + LB() + Q() + "name" + Q() + ": " + Q() + "t32_field_get" + Q() + RB() + RB()
            expect(detect_tool_name(msg)).to_equal("t32_field_get")

        it "detects t32_dialog_click":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): detected tool name for the dialog_click call
            step("Build a tools/call message for t32_dialog_click and detect it")
            val msg = make_tools_call("t32_dialog_click")
            expect(detect_tool_name(msg)).to_equal("t32_dialog_click")

        it "detects t32_error_check":
            val msg = make_tools_call("t32_error_check")
            expect(detect_tool_name(msg)).to_equal("t32_error_check")

        it "returns empty for message without tool name":
            val msg = LB() + Q() + "method" + Q() + ":" + Q() + "initialize" + Q() + RB()
            expect(detect_tool_name(msg)).to_equal("")

    # -----------------------------------------------------------------------
    context "full dispatch covers all 36 tools":
    # -----------------------------------------------------------------------

        it "full tool set has exactly 36 entries":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            expect(full_tools().len()).to_equal(36)  # oracle: the full frontend dispatch table registers 36 tools, counted from source

        it "t32_session_open is in full tool set":
            check(list_contains(full_tools(), "t32_session_open"))

        it "t32_session_resume is in full tool set":
            check(list_contains(full_tools(), "t32_session_resume"))

        it "t32_cmd_run is in full tool set":
            check(list_contains(full_tools(), "t32_cmd_run"))

        it "t32_cmm_run is in full tool set":
            check(list_contains(full_tools(), "t32_cmm_run"))

        it "t32_eval is in full tool set":
            check(list_contains(full_tools(), "t32_eval"))

        it "t32_window_list is in full tool set":
            check(list_contains(full_tools(), "t32_window_list"))

        it "t32_window_capture is in full tool set":
            check(list_contains(full_tools(), "t32_window_capture"))

        it "t32_setup_headless is in full tool set":
            check(list_contains(full_tools(), "t32_setup_headless"))

        it "t32_status_snapshot is in full tool set":
            check(list_contains(full_tools(), "t32_status_snapshot"))

