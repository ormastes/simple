# JSON-RPC methods recognized by the full dispatch loop
fn full_methods() -> [text]:
    [
        "initialize",
        "initialized",
        "notifications/initialized",
        "shutdown",
        "tools/list",
        "tools/call",
        "resources/list",
        "resources/templates/list",
