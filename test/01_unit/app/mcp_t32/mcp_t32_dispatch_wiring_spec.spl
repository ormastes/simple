        it "t32_job_get is in full tool set":
            check(list_contains(full_tools(), "t32_job_get"))

        it "t32_job_cancel is in full tool set":
            check(list_contains(full_tools(), "t32_job_cancel"))

        it "every cold tool is also in full tool set":
            val cold = cold_tools()
            val full = full_tools()
            for tool in cold:
                check(list_contains(full, tool))

    # -----------------------------------------------------------------------
    context "full-only tools (were unreachable in cold default)":
    # -----------------------------------------------------------------------

        it "full-only set has 23 entries":
            expect(full_only_tools().len()).to_equal(23)  # oracle: 23 of the 36 tools were unreachable under the cold default, 36 minus 13 cold tools

        it "full-only tools are not in cold set":
            val cold = cold_tools()
            for tool in full_only_tools():
                check(not list_contains(cold, tool))

        it "full-only tools are all in full set":
            val full = full_tools()
            for tool in full_only_tools():
                check(list_contains(full, tool))

        it "t32_session_open was unreachable in cold":
            check(not list_contains(cold_tools(), "t32_session_open"))
            check(list_contains(full_tools(), "t32_session_open"))

        it "t32_cmd_run was unreachable in cold":
            check(not list_contains(cold_tools(), "t32_cmd_run"))
            check(list_contains(full_tools(), "t32_cmd_run"))

        it "t32_window_capture was unreachable in cold":
            check(not list_contains(cold_tools(), "t32_window_capture"))
            check(list_contains(full_tools(), "t32_window_capture"))

    # -----------------------------------------------------------------------
    context "cold frontend tool set (subset)":
    # -----------------------------------------------------------------------

        it "cold tool set has exactly 13 entries":
            expect(cold_tools().len()).to_equal(13)  # oracle: the cold frontend handles exactly the 13 low-cost tools its table lists

        it "cold handles t32_sessions_list":
            check(list_contains(cold_tools(), "t32_sessions_list"))

        it "cold handles t32_field_get":
            check(list_contains(cold_tools(), "t32_field_get"))

        it "cold handles t32_dialog_click":
            check(list_contains(cold_tools(), "t32_dialog_click"))

        it "cold handles t32_error_check":
            check(list_contains(cold_tools(), "t32_error_check"))

        it "cold does NOT handle t32_session_open":
            check(not list_contains(cold_tools(), "t32_session_open"))

        it "cold does NOT handle t32_cmd_run":
            check(not list_contains(cold_tools(), "t32_cmd_run"))

        it "cold does NOT handle t32_eval":
            check(not list_contains(cold_tools(), "t32_eval"))

        it "cold does NOT handle t32_window_capture":
            check(not list_contains(cold_tools(), "t32_window_capture"))

        it "cold does NOT handle t32_setup_headless":
            check(not list_contains(cold_tools(), "t32_setup_headless"))

    # -----------------------------------------------------------------------
    context "method routing (full dispatch loop)":
    # -----------------------------------------------------------------------

        it "initialize method recognized":
            check(list_contains(full_methods(), "initialize"))

        it "tools/list method recognized":
            check(list_contains(full_methods(), "tools/list"))

        it "tools/call method recognized":
            check(list_contains(full_methods(), "tools/call"))

        it "resources/list method recognized":
            check(list_contains(full_methods(), "resources/list"))

        it "resources/templates/list method recognized":
            check(list_contains(full_methods(), "resources/templates/list"))

