        it "prompts/list method recognized":
            check(list_contains(full_methods(), "prompts/list"))

        it "notifications/cancelled method recognized":
            check(list_contains(full_methods(), "notifications/cancelled"))

        it "logging/setLevel method recognized":
            check(list_contains(full_methods(), "logging/setLevel"))

    # -----------------------------------------------------------------------
    context "method routing (cold dispatch loop)":
    # -----------------------------------------------------------------------

        it "cold recognizes initialize":
            check(list_contains(cold_methods(), "initialize"))

        it "cold recognizes tools/call":
            check(list_contains(cold_methods(), "tools/call"))

        it "cold recognizes shutdown":
            check(list_contains(cold_methods(), "shutdown"))

        it "cold recognizes ping":
            check(list_contains(cold_methods(), "ping"))

        it "cold does NOT recognize prompts/list":
            check(not list_contains(cold_methods(), "prompts/list"))

        it "cold does NOT recognize resources/templates/list":
            check(not list_contains(cold_methods(), "resources/templates/list"))

        it "cold does NOT recognize logging/setLevel":
            check(not list_contains(cold_methods(), "logging/setLevel"))

    # -----------------------------------------------------------------------
    context "JSON-RPC message construction":
    # -----------------------------------------------------------------------

        it "make_tools_call produces valid JSON structure":
            val msg = make_tools_call("t32_cmd_run")
            check(msg.contains(Q() + "jsonrpc" + Q()))
            check(msg.contains(Q() + "2.0" + Q()))
            check(msg.contains(Q() + "tools/call" + Q()))
            check(msg.contains(Q() + "t32_cmd_run" + Q()))

        it "make_method_request produces valid JSON structure":
            val msg = make_method_request("initialize")
            check(msg.contains(Q() + "jsonrpc" + Q()))
            check(msg.contains(Q() + "initialize" + Q()))
            check(msg.contains(Q() + "id" + Q()))

        it "escape_json handles backslash":
            val escaped = escape_json("a\\b")
            check(escaped.contains("\\\\"))

        it "escape_json handles quotes":
            val escaped = escape_json("say " + Q() + "hello" + Q())
            check(escaped.contains("\\" + Q()))

    # -----------------------------------------------------------------------
    context "default frontend changed from cold to full (bug 6 fix)":
    # -----------------------------------------------------------------------

        it "default T32_MCP_FRONTEND should be full":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): wrapper default-frontend assignment line
            step("Read the wrapper and pin its default-frontend assignment")
            val wrapper = file_read("bin/t32_mcp_server")
            val default_line = "T32_MCP_FRONTEND=\"" + "$" + "{T32_MCP_FRONTEND:-full}\""
            val defaults_to_full = wrapper.contains(default_line)
            expect(defaults_to_full).to_equal(true)  # oracle: bug #6 fix — an unset T32_MCP_FRONTEND must resolve to full, not cold

        it "full mode routes to full entry point":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): wrapper full-mode source artifact wiring lines
            step("Read the wrapper and pin the full-mode entry routing")
            val wrapper = file_read("bin/t32_mcp_server")
            val routes_full_entry = wrapper.contains("SOURCE_ARTIFACT=\"" + "$" + "FULL_ENTRY\"")
            expect(routes_full_entry).to_equal(true)  # oracle: full mode must dispatch through the FULL_ENTRY artifact
            expect(wrapper.contains("FULL_ENTRY=\"")).to_equal(true)  # oracle: FULL_ENTRY is assigned before the routing line consumes it
            expect(wrapper.contains("/examples/10_tooling/trace32_tools/t32_mcp/main.spl\"")).to_equal(true)  # oracle: the full entry artifact is the examples-tree t32_mcp main

        it "cold mode routes to cold entry point":
            # @req REQ-APP-MCP-T32-DISPATCH-001
            # @capture(statistics): wrapper cold-mode entry wiring lines
            step("Read the wrapper and pin the cold-mode entry routing")
            val wrapper = file_read("bin/t32_mcp_server")
            expect(wrapper.contains("SOURCE_ARTIFACT=\"" + "$" + "COLD_ENTRY\"")).to_equal(true)  # oracle: cold mode is the initial source artifact before frontend selection
            expect(wrapper.contains("/examples/10_tooling/trace32_tools/t32_mcp/frontend_cold.spl\"")).to_equal(true)  # oracle: the cold entry artifact is the frontend_cold module

        it "full dispatch handles all tools cold cannot":
            # The key invariant: every full_only tool must be in full but not cold
            val full = full_tools()
            val cold = cold_tools()
            val only = full_only_tools()
            for tool in only:
                check(list_contains(full, tool))
                check(not list_contains(cold, tool))
            # And full_only + cold == full (no gaps)
            expect(only.len() + cold.len()).to_equal(full.len())
