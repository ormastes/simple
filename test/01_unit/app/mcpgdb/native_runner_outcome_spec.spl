use std.spec
use app.mcpgdb.runner_outcome_v1.{mcpgdb_runner_outcome_v1}
use app.mcpgdb.json_helpers.{make_tool_error, make_tool_result}

fn outcome_failure(value: Result<text, text>) -> bool:
    match value:
        Err(_): true
        Ok(_): false

fn outcome_text(value: Result<text, text>) -> text:
    match value:
        Ok(text): text
        Err(_): ""

describe "Native runner outcome propagation":
    it "retains child isError and treats literal error text as ordinary success":
        expect(outcome_failure(mcpgdb_runner_outcome_v1(make_tool_error("\"1\"", "backend failed")))).to_equal(true)
        expect(outcome_text(mcpgdb_runner_outcome_v1(make_tool_result("\"1\"", "error: literal successful text")))).to_equal("error: literal successful text")

    it "retains nested denied status and rejects malformed or mismatched envelopes":
        expect(outcome_failure(mcpgdb_runner_outcome_v1(make_tool_result("\"1\"", "{\"response\":{\"status\":\"denied\"}}")))).to_equal(true)
        expect(outcome_failure(mcpgdb_runner_outcome_v1(make_tool_result("\"wrong\"", "value")))).to_equal(true)
        expect(outcome_failure(mcpgdb_runner_outcome_v1("not JSON"))).to_equal(true)
        expect(outcome_failure(mcpgdb_runner_outcome_v1("{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"isError\":false,\"isError\":true,\"content\":[]}}"))).to_equal(true)
