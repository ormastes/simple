use std.spec.{describe, it, expect}
use std.common.debug.contracts_v1.{
    DebugPerturbationV1, DebugRootOperationV1, debug_policy_development_v1,
}
use std.common.debug.service_v1.{
    central_debug_service_v1_graph, central_debug_service_v1_receipts,
}
use app.mcpgdb.debug_service_bridge_v1.{
    mcpgdb_debug_bind_session_v1, mcpgdb_debug_binding_v1,
    mcpgdb_debug_authorize_v1, mcpgdb_debug_record_outcome_v1,
    mcpgdb_debug_unbind_session_v1, mcpgdb_debug_reset_bindings_v1,
    mcpgdb_debug_action_v1, mcpgdb_debug_action_for_rule_v1,
    mcpgdb_debug_authorize_operation_v1,
}

describe "mcpgdb DebugServiceV1 bridge":
    it "binds an existing resource without replacing its transport":
        mcpgdb_debug_reset_bindings_v1()
        val debug_id = mcpgdb_debug_bind_session_v1(
            "dbg_bridge_1", "gdb", "build-sha256:abc", debug_policy_development_v1(),
        )?
        val binding = mcpgdb_debug_binding_v1("dbg_bridge_1")?
        expect(binding.debug_session_id.value).to_equal(debug_id.value)
        expect(binding.resource_uri).to_equal("mcpgdb://session/dbg_bridge_1")
        val graph = central_debug_service_v1_graph(debug_id)?
        expect(graph.build_id).to_equal("build-sha256:abc")
        expect(graph.nodes.len()).to_equal(1)
        mcpgdb_debug_unbind_session_v1("dbg_bridge_1")?

    it "receipts cooperative commands and their outcomes":
        mcpgdb_debug_reset_bindings_v1()
        val debug_id = mcpgdb_debug_bind_session_v1(
            "dbg_bridge_2", "lldb", "build-sha256:def", debug_policy_development_v1(),
        )?
        val authorization = mcpgdb_debug_authorize_v1(
            "dbg_bridge_2", "command", DebugPerturbationV1.Cooperative,
        )?
        expect(authorization.allowed).to_equal(true)
        mcpgdb_debug_record_outcome_v1(
            "dbg_bridge_2", "command", DebugPerturbationV1.Cooperative,
            true, true, "",
        )?
        # Session open and target registration are receipts too; authorization
        # and outcome add the final two records.
        expect(central_debug_service_v1_receipts(debug_id).len()).to_equal(4)
        mcpgdb_debug_unbind_session_v1("dbg_bridge_2")?

    it "denies mutating raw commands under the shared development policy":
        mcpgdb_debug_reset_bindings_v1()
        mcpgdb_debug_bind_session_v1(
            "dbg_bridge_3", "gdb", "build-sha256:ghi", debug_policy_development_v1(),
        )?
        match mcpgdb_debug_authorize_v1(
            "dbg_bridge_3", "command", DebugPerturbationV1.Mutating,
        ):
            case Ok(_): expect(false).to_equal(true)
            case Err(reason): expect(reason).to_contain("mutation")
        mcpgdb_debug_unbind_session_v1("dbg_bridge_3")?

    it "classifies existing MCP debugger tools by semantic effect":
        val stack = mcpgdb_debug_action_v1("frame_list", false)
        expect(stack.managed).to_equal(true)
        expect(stack.operation).to_equal(DebugRootOperationV1.Inspect)
        expect(stack.perturbation).to_equal(DebugPerturbationV1.Passive)
        expect(stack.execution_changes_on_success).to_equal(false)
        val step = mcpgdb_debug_action_v1("debug_step_over", false)
        expect(step.operation).to_equal(DebugRootOperationV1.Control)
        expect(step.perturbation).to_equal(DebugPerturbationV1.Stopping)
        expect(step.execution_changes_on_success).to_equal(true)
        val memory_write = mcpgdb_debug_action_v1("memory_write", false)
        expect(memory_write.perturbation).to_equal(DebugPerturbationV1.Mutating)
        expect(memory_write.execution_changes_on_success).to_equal(true)
        val safe_raw = mcpgdb_debug_action_v1("debug_command_run", false)
        expect(safe_raw.perturbation).to_equal(DebugPerturbationV1.Cooperative)
        expect(safe_raw.execution_changes_on_success).to_equal(false)
        val dangerous_raw = mcpgdb_debug_action_v1("debug_command_run", true)
        expect(dangerous_raw.perturbation).to_equal(DebugPerturbationV1.Mutating)
        expect(dangerous_raw.execution_changes_on_success).to_equal(true)
        val continue_raw = mcpgdb_debug_action_for_rule_v1("debug_command_run", false, "execution_control")
        expect(continue_raw.perturbation).to_equal(DebugPerturbationV1.Stopping)
        expect(continue_raw.execution_changes_on_success).to_equal(true)

    it "authorizes passive inspection under the operation-aware API":
        mcpgdb_debug_reset_bindings_v1()
        mcpgdb_debug_bind_session_v1(
            "dbg_bridge_4", "gdb", "build-sha256:jkl", debug_policy_development_v1(),
        )?
        val receipt = mcpgdb_debug_authorize_operation_v1(
            "dbg_bridge_4", DebugRootOperationV1.Inspect,
            "frame_list", DebugPerturbationV1.Passive,
        )?
        expect(receipt.operation).to_equal(DebugRootOperationV1.Inspect)
        expect(receipt.perturbation).to_equal(DebugPerturbationV1.Passive)
        expect(receipt.execution_changed).to_equal(false)
        mcpgdb_debug_unbind_session_v1("dbg_bridge_4")?
