use std.spec.*
use app.io.env_ops.{env_get, env_set}
use app.io._CliCompile.native_build.{cli_native_build}

fn tldr_rejected_request_preserves_environment(arguments: [text]):
    val names = ["SIMPLE_OS_LOG_MODE", "SIMPLE_NATIVE_BUILD_EMIT_OBJECT",
        "SIMPLE_NATIVE_ARENA_DECLS", "SIMPLE_NATIVE_BUILD_THREADS",
        "SIMPLE_NATIVE_BUILD_CACHE_DIR", "SIMPLE_NATIVE_BUILD_ENTRY",
        "SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "SIMPLE_NATIVE_BUILD_TARGET"]
    var before: [text] = []
    for name in names: before.push(env_get(name) ?? "")
    val old_mode = env_get("SIMPLE_NATIVE_TLDR_ENTRY_ONLY") ?? ""
    val old_strict = env_get("SIMPLE_NO_STUB_FALLBACK") ?? ""
    env_set("SIMPLE_NATIVE_TLDR_ENTRY_ONLY", "1")
    env_set("SIMPLE_NO_STUB_FALLBACK", "1")
    val code = cli_native_build(arguments)
    env_set("SIMPLE_NATIVE_TLDR_ENTRY_ONLY", old_mode)
    env_set("SIMPLE_NO_STUB_FALLBACK", old_strict)
    expect(code).to_equal(1)
    for index in 0..names.len():
        expect(env_get(names[index]) ?? "").to_equal(before[index])

describe "strict TLDR request validation":
    it "rejects missing object mode before changing the caller environment":
        tldr_rejected_request_preserves_environment(["--backend=llvm", "--entry", "entry.spl", "--threads", "3"])

    it "rejects conflicting SMF and object modes before changing the caller environment":
        tldr_rejected_request_preserves_environment(["--backend=llvm", "--entry", "entry.spl", "--emit-object", "--emit-smf"])
