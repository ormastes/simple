# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "single-file test runner binary resolution":
    """
    Purpose: this manual pins the behavior named "single-file test runner binary resolution" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    # @manual scenario evidence
    it "does not execute its source entrypoint as the Simple binary":
        # @req REQ-SSPEC-APP
        step("does not execute its source entrypoint as the Simple binary")
        val source = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(source).to_contain("val configured = env_get(\"SIMPLE_BINARY\")")
        expect(source).to_contain("raw[0].ends_with(\"/simple\")")
        expect(source).to_contain("raw[0].ends_with(\"simple.exe\")")
        expect(source.contains("if raw.len() > 0 and rt_file_exists(raw[0]):")).to_equal(false)

    it "fails closed when an enabled coverage child omits its dump":
        # @req REQ-SSPEC-APP
        step("fails closed when an enabled coverage child omits its dump")
        val source = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(source).to_contain("if cov_sdn.trim() == \"\":")
        expect(source).to_contain(
            "error: coverage dump sentinels absent from child output")
        expect(source).to_contain("return 1")
