# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.spec
use std.io_runtime.{file_read}

use std.spec.step

describe "single-file test runner binary resolution":
    """
    Purpose: this manual pins the behavior named "single-file test runner binary resolution" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    # @manual scenario evidence
    it "does not execute its source entrypoint as the Simple binary":
        # @req REQ-SSPEC-APP
        step("does not execute its source entrypoint as the Simple binary")
        val source = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(source).to_contain("val current_raw = cli_current_exe_path()")
        expect(source).to_contain("val configured_raw = env_get(\"SIMPLE_BINARY\")")
        expect(source).to_contain("configured != current")
        expect(source.contains("return \"bin/simple\"")).to_equal(false)

    it "binds every spawned spec to the admitted candidate and fails closed otherwise":
        # @req REQ-SSPEC-APP
        step("binds every spawned spec to the admitted candidate and fails closed otherwise")
        val source = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(source).to_contain("if binary == \"\":")
        expect(source).to_contain("refusing to fall back to deployed bin/simple or a Rust seed")
        expect(source).to_contain("env_set(\"SIMPLE_BINARY\", binary)")
        expect(source).to_contain("process_run_bounded(binary, child_args")

    it "fails closed when an enabled coverage child omits its dump":
        # @req REQ-SSPEC-APP
        step("fails closed when an enabled coverage child omits its dump")
        val source = file_read("src/app/test_runner_new/test_runner_single.spl")

        expect(source).to_contain("if cov_sdn.trim() == \"\":")
        expect(source).to_contain(
            "error: required child coverage evidence is absent")
        expect(source).to_contain("return 1")
