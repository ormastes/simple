use std.spec.{describe, it, expect}
use app.spec_gen.main.{extract_quoted, extract_spec_doc}

describe "spec-gen quoted titles preserve complete raw literal bodies":
    it "retains escaped quotes and the suffix in bare and call-form descriptions":
        val quote = "\""
        val slash = "\\"
        val escaped_body = "bucket=" + slash + quote + slash + quote + ", key=" + slash + quote + slash + quote + " suffix"
        val bare = "it " + quote + escaped_body + quote + ":"
        val call = "test(" + quote + escaped_body + quote + "):"
        expect(extract_quoted(bare)).to_equal(escaped_body)
        expect(extract_quoted(call)).to_equal(escaped_body)
        val document = extract_spec_doc(bare + "\n" + call + "\n", "quoted_spec.spl")
        expect(document).to_equal("- " + escaped_body + "\n- " + escaped_body)

    it "distinguishes even and odd backslash runs without unescaping the body":
        val quote = "\""
        val slash = "\\"
        val even = "path " + slash + slash
        expect(extract_quoted("it " + quote + even + quote + ":")).to_equal(even)
        val odd = "path " + slash + slash + slash + quote + " remains"
        expect(extract_quoted("it " + quote + odd + quote + ":")).to_equal(odd)

    it "keeps UTF-8 text and refuses unterminated quoted titles":
        expect(extract_quoted("it \"café 😀 suffix\":")).to_equal("café 😀 suffix")
        expect(extract_quoted("it no quoted title:")).to_equal("")
        expect(extract_quoted("it \"missing close")).to_equal("")
        val dangling = "it \"missing close" + "\\"
        expect(extract_quoted(dangling)).to_equal("")
