"""
## Purpose and audience
Purpose: Prove that compiled checker per-file transient ownership.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-CHECK-001 — stable requirement identity for this spec.

use std.spec
use app.check.main.{check_one}

val VALID_CHECK_FIXTURE = "test/fixtures/app/check/check_transient_valid.spl"
val MALFORMED_CHECK_FIXTURE = "test/fixtures/app/check/check_transient_malformed.spl"
val SSPEC_CHECK_FIXTURE = "test/fixtures/app/check/check_transient_sspec.spl"

describe "compiled checker per-file transient ownership":
    it "returns success for a valid source":
        step("Verify: returns success for a valid source")
        # @req: REQ-APP-CHECK-001
        expect(check_one(VALID_CHECK_FIXTURE, false)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "returns failure for a parser error":
        step("Verify: returns failure for a parser error")
        # `check_one` returns the FAILURE COUNT, not a 0/1 flag: `main()` sums it
        # into `errors` (src/app/check/main.spl:305-307) and only collapses to
        # 0/1 at the process exit code. The malformed fixture yields 3 parser
        # errors, so the invariant is "non-zero", not "exactly 1".
        expect(check_one(MALFORMED_CHECK_FIXTURE, false) > 0).to_equal(true)

    it "returns failure for SSpec command-block guidance":
        step("Verify: returns failure for SSpec command-block guidance")
        expect(check_one(SSPEC_CHECK_FIXTURE, false)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "recovers from a malformed file before checking the next valid file":
        step("Verify: recovers from a malformed file before checking the next valid file")
        expect(check_one(MALFORMED_CHECK_FIXTURE, false) > 0).to_equal(true)
        expect(check_one(VALID_CHECK_FIXTURE, false)).to_equal(0)  # oracle: 0 — named expected value from the requirement
