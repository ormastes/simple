# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
#
# REPRODUCING spec for the 2026-09-01 interpret-mode `check` failure:
# src/app/check/targets.spl declared `var seen_targets: [text]` (an array) and
# then used DICT API on it — `seen_targets[target_identity] = true` (string
# index, bool value) and `seen_files.contains_key(...)`. The hybrid engine let
# that slide; pure interpret mode (SIMPLE_EXECUTION_MODE=interpret — exactly
# what the test runner exports, so every `check` spawned from a spec hit it)
# coerced the string index with as_int() and died:
#   error: semantic: type mismatch: cannot convert string to int
# (seed emitter: compiler/src/value_impl.rs:117). Fixed by using the array API
# (`push`/`contains`). Record:
# doc/08_tracking/bug/check_targets_dict_api_on_array_interpret_crash_2026-09-01.md
#
# Calling expand_check_targets with a DUPLICATE target drives execution through
# the exact seen_targets bookkeeping lines that crashed. The generalization
# half: the same call also walks the seen_files dedupe branch (the contains_key
# site), so both mixed-API sites are executed, not just the one that faulted.

use std.spec.step
use app.check.targets.{expand_check_targets}

describe "expand_check_targets target bookkeeping":
    # @manual scenario evidence
    it "dedupes a repeated file target without dict-API-on-array coercion":
        # @req REQ-SSPEC-UNIT
        step("expand a target list naming the same file twice")
        val (files, empty_dirs) = expand_check_targets([
            "src/app/check/targets.spl",
            "src/app/check/targets.spl"
        ])
        # Reaching here at all is the reproduction oracle: the pre-fix code
        # faulted inside this call under interpret mode.
        expect(files.len()).to_equal(1)
        expect(files[0]).to_equal("src/app/check/targets.spl")
        expect(empty_dirs.len()).to_equal(0)

    it "keeps distinct file targets and reports no empty directories":
        # @req REQ-SSPEC-UNIT
        step("expand two distinct file targets")
        val (files, empty_dirs) = expand_check_targets([
            "src/app/check/targets.spl",
            "src/app/check/main.spl"
        ])
        expect(files.len()).to_equal(2)
        expect(empty_dirs.len()).to_equal(0)
