"""
## Purpose and audience

# AOP advice execution (reproduce)

Reproduce spec for the product bug "AOP advice never executes". `on pc{...} use
<advice> <kind>` parsed into `Node::AopAdvice` and was then dropped by the
interpreter's no-op statement arm, so `before`, `after_success` and
`after_error` advice never ran and every observation flag stayed `false`.

Fails before the fix (all four scenarios report `false`/`0`), passes after.

## Operator workflow

Run `bin/simple test --no-session-daemon test/01_unit/app/aop/aop_advice_execution_spec.spl`
and confirm the Results line reports 0 failed.

## Compatibility and limitations

Covers the interpreter path only; native/JIT weaving is out of scope.

## Recovery and troubleshooting

If a scenario fails, re-run this single file and read the first failing Verify step.
"""
use std.spec.{step}
# REQ-FEATURE-USAGE-001

describe "AOP advice execution":
    context "before advice":
        it "runs before advice at the join point":
            var called = false

            fn advice():
                called = true

            fn target() -> i64:
                42

            on pc{ execution(* target(..)) } use advice before priority 10

            expect target() == 42
            expect called == true

        it "matches a wildcard pointcut across several functions":
            var count = 0

            fn counter():
                count = count + 1

            fn calc_add() -> i64:
                1

            fn calc_sub() -> i64:
                2

            on pc{ execution(* calc*(..)) } use counter before priority 10

            calc_add()
            calc_sub()
            expect count == 2

    context "after advice":
        it "runs after_success when the target succeeds":
            var executed = false

            fn after_advice():
                executed = true

            fn ok_target() -> i64:
                7

            on pc{ execution(* ok_target(..)) } use after_advice after_success priority 10

            expect ok_target() == 7
            expect executed == true

        it "runs after_error and not after_success when the target returns Err":
            var errored = false
            var succeeded = false

            fn on_error():
                errored = true

            fn on_success():
                succeeded = true

            fn failing() -> Result<i64, text>:
                Err("boom")

            on pc{ execution(* failing(..)) } use on_error after_error priority 10
            on pc{ execution(* failing(..)) } use on_success after_success priority 10

            val r = failing()
            expect r.err.?
            expect errored == true
            expect succeeded == false
