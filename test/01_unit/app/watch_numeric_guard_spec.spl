# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.watch.main.{parse_watch_ms_or_default}

describe "watch numeric guard":
    # @manual scenario evidence
    it "accepts numeric millisecond values and falls back to default on malformed values":
        # @req REQ-SSPEC-APP
        step("accepts numeric millisecond values and falls back to default on malformed values")
        expect(parse_watch_ms_or_default("250", 100)).to_equal(250)
        expect(parse_watch_ms_or_default("0", 100)).to_equal(0)
        expect(parse_watch_ms_or_default("", 100)).to_equal(100)
        expect(parse_watch_ms_or_default("abc", 100)).to_equal(100)
        expect(parse_watch_ms_or_default("10z", 100)).to_equal(100)
        expect(parse_watch_ms_or_default("-1", 100)).to_equal(100)
