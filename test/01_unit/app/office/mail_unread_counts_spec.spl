use std.spec
use app.office.mail.mail_app.{MailApp}

describe "Mail unread counts":
    """As a mail user, I see how many unread messages each folder holds."""

    it "counts every unread message in a folder, not just the first":
        val app = MailApp.new()
        val counts = app._build_unread_counts()
        expect(counts.get("Inbox") ?? -1).to_equal(2)

    it "leaves folders with no unread messages out of the counts":
        val app = MailApp.new()
        val counts = app._build_unread_counts()
        expect(counts.get("Sent") ?? -1).to_equal(-1)
