# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""LibreOffice Math — equation editor spec.

Verifies the Math component: a simple math expression renders to MathML
(identifiers→<mi>, numbers→<mn>, operators→<mo>), with structured superscript
and square-root helpers. The renderer is the display core of an equation editor.
"""

use std.spec.step

use std.spec
use std.spec.step
use app.office.math_editor.{math_to_mathml, math_superscript, math_sqrt}


describe "Math editor: flat expression to MathML":
    # @manual scenario evidence
    """A flat expression renders to a MathML <math><mrow> sequence."""

    it "wraps output in a MathML math/mrow root":
        # @req REQ-SSPEC-UNIT
        step("wraps output in a MathML math/mrow root")
        val ml = math_to_mathml("a + 1")
        expect(ml).to_start_with("<math ")
        expect(ml).to_contain("<mrow>")
        expect(ml).to_end_with("</math>")

    it "renders an identifier as <mi>":
        # @req REQ-SSPEC-UNIT
        step("renders an identifier as <mi>")
        val ml = math_to_mathml("a + 1")
        expect(ml).to_contain("<mi>a</mi>")

    it "renders a multi-digit number as <mn>":
        # @req REQ-SSPEC-UNIT
        step("renders a multi-digit number as <mn>")
        val ml = math_to_mathml("x + 12")
        expect(ml).to_contain("<mn>12</mn>")

    it "renders an operator as <mo>":
        # @req REQ-SSPEC-UNIT
        step("renders an operator as <mo>")
        val ml = math_to_mathml("a + b")
        expect(ml).to_contain("<mo>+</mo>")

describe "Math editor: structured forms":
    """Superscript and square root produce structured MathML."""

    it "renders a superscript with msup":
        # @req REQ-SSPEC-UNIT
        step("renders a superscript with msup")
        val ml = math_superscript("x", "2")
        expect(ml).to_start_with("<msup>")
        expect(ml).to_contain("<mi>x</mi>")
        expect(ml).to_contain("<mn>2</mn>")

    it "renders a square root with msqrt":
        # @req REQ-SSPEC-UNIT
        step("renders a square root with msqrt")
        val ml = math_sqrt("y")
        expect(ml).to_start_with("<msqrt>")
        expect(ml).to_contain("<mi>y</mi>")
