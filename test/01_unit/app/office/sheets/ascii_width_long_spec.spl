# @req REQ-SHEETS-ASCII-WIDTH-UTF8
# Long controls prevent UTF-8 prefix rescans and accumulated-output corruption.
use app.office.sheets.ascii_width.{asc_text, jis_text}

describe "Spreadsheet ASCII width long controls":
    it "ASC preserves long ASCII text":
        val input = "Az09 ".repeat(1024)
        expect(asc_text(input)).to_equal(input)
    it "JIS converts long ASCII text":
        val input = "Az09 ".repeat(1024)
        expect(jis_text(input)).to_equal("Ａｚ０９　".repeat(1024))
    it "ASC converts long multibyte text with NUL":
        val nul = 0.chr()
        val input = "Ａ日😀{nul}é".repeat(1024)
        val expected = "A日😀{nul}é".repeat(1024)
        expect(asc_text(input)).to_equal(expected)
        expect(asc_text(input).len()).to_equal(expected.len())
    it "JIS converts long multibyte text with NUL":
        val nul = 0.chr()
        val input = "A日😀{nul}é".repeat(1024)
        val expected = "Ａ日😀{nul}é".repeat(1024)
        expect(jis_text(input)).to_equal(expected)
        expect(jis_text(input).len()).to_equal(expected.len())
