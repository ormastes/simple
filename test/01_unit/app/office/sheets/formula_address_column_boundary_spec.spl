use std.spec
use app.office.sheets.formula.{evaluate_formula}
use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{CellValue}

describe "ADDRESS uses the owned column-name conversion":
    it "formats the last single-letter column as an absolute reference":
        val sheet = Sheet.new("address")
        val result = evaluate_formula("=ADDRESS(2,26)", sheet)
        match result:
            CellValue.TextVal(value): expect(value).to_equal("$Z$2")
            _: fail("ADDRESS must return text")

    it "formats the first double-letter column as a relative reference":
        val sheet = Sheet.new("address")
        val result = evaluate_formula("=ADDRESS(2,27,4)", sheet)
        match result:
            CellValue.TextVal(value): expect(value).to_equal("AA2")
            _: fail("ADDRESS must return text")

    it "preserves row-only anchoring across a later column carry":
        val sheet = Sheet.new("address")
        val result = evaluate_formula("=ADDRESS(9,53,2)", sheet)
        match result:
            CellValue.TextVal(value): expect(value).to_equal("BA$9")
            _: fail("ADDRESS must return text")
