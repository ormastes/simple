# @req REQ-SHEETS-ASCII-WIDTH-UTF8
# ASC/JIS change ASCII width while preserving every other Unicode codepoint.
use app.office.sheets.ascii_width.{asc_text, jis_text}

describe "Spreadsheet Unicode ASCII width conversion":
    it "ASC converts full-width Latin letters":
        expect(asc_text("ＡＢＣ")).to_equal("ABC")
    it "ASC converts full-width space":
        expect(asc_text("Ａ　Ｂ")).to_equal("A B")
    it "ASC converts full-width digits":
        expect(asc_text("１２３")).to_equal("123")
    it "ASC converts mixed full-width input":
        expect(asc_text("ＡＢＣ　１２３")).to_equal("ABC 123")
    it "JIS preserves Japanese characters":
        expect(jis_text("日本語")).to_equal("日本語")
    it "ASC preserves CJK and supplementary codepoints":
        expect(asc_text("Ａ日😀１")).to_equal("A日😀1")
    it "JIS preserves CJK and supplementary codepoints":
        expect(jis_text("A日😀1")).to_equal("Ａ日😀１")
    it "ASC preserves embedded NUL before Unicode":
        val nul = 0.chr()
        expect(asc_text("Ａ{nul}日")).to_equal("A{nul}日")
    it "JIS handles empty input":
        expect(jis_text("")).to_equal("")
    it "ASC handles empty input":
        expect(asc_text("")).to_equal("")
