# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



"""Calc statistical functions spec.

MEDIAN / VAR / STDEV / LARGE / SMALL over ranges, matching Excel semantics
(sample variance, 1-based k). Evaluated through the real recalc path.
"""

use std.spec.step

use std.spec
use std.spec.step
use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{cell_display_text}
use app.office.file_formats.{recalculate_formula_cells}


fn _stats_sheet() -> Sheet:
    var sh = Sheet.new("s")
    sh.set_value("A1", "4")
    sh.set_value("A2", "8")
    sh.set_value("A3", "6")
    sh.set_value("A4", "10")
    sh

describe "Calc statistics: MEDIAN/VAR/STDEV":
    # @manual scenario evidence
    it "computes the median of an even-sized range":
        # @req REQ-SSPEC-UNIT
        step("computes the median of an even-sized range")
        var sh = _stats_sheet()
        sh.set_value("B1", "=MEDIAN(A1:A4)")
        sh = recalculate_formula_cells(sh)
        expect(cell_display_text(sh.get_cell("B1"))).to_equal("7")

    it "computes sample variance (n-1) like Excel VAR":
        # @req REQ-SSPEC-UNIT
        step("computes sample variance (n-1) like Excel VAR")
        var sh = _stats_sheet()
        sh.set_value("B1", "=VAR(A1:A4)")
        sh = recalculate_formula_cells(sh)
        expect(cell_display_text(sh.get_cell("B1"))).to_start_with("6.66666")

    it "computes STDEV as sqrt of sample variance":
        # @req REQ-SSPEC-UNIT
        step("computes STDEV as sqrt of sample variance")
        var sh = _stats_sheet()
        sh.set_value("B1", "=STDEV(A1:A4)")
        sh = recalculate_formula_cells(sh)
        expect(cell_display_text(sh.get_cell("B1"))).to_start_with("2.58198")

describe "Calc statistics: LARGE/SMALL":
    it "returns the k-th largest and smallest":
        # @req REQ-SSPEC-UNIT
        step("returns the k-th largest and smallest")
        var sh = _stats_sheet()
        sh.set_value("B1", "=LARGE(A1:A4, 2)")
        sh.set_value("B2", "=SMALL(A1:A4, 1)")
        sh = recalculate_formula_cells(sh)
        expect(cell_display_text(sh.get_cell("B1"))).to_equal("8")
        expect(cell_display_text(sh.get_cell("B2"))).to_equal("4")

    it "fails closed on k out of range":
        # @req REQ-SSPEC-UNIT
        step("fails closed on k out of range")
        var sh = _stats_sheet()
        sh.set_value("B1", "=LARGE(A1:A4, 9)")
        sh = recalculate_formula_cells(sh)
        expect(cell_display_text(sh.get_cell("B1"))).to_contain("#ERR")
