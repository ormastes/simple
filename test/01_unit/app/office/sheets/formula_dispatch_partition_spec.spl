"""Keep every numeric formula dispatch bucket reachable after partitioning."""

use std.spec
use std.spec.step
use app.office.sheets.spreadsheet.{Sheet}
use app.office.sheets.cell.{cell_display_text}
use app.office.file_formats.{recalculate_formula_cells}

fn _eval(formula: text) -> text:
    var sheet = Sheet.new("dispatch")
    sheet.set_value("A1", formula)
    sheet = recalculate_formula_cells(sheet)
    cell_display_text(sheet.get_cell("A1"))

describe "Calc numeric dispatch partition":
    it "keeps one exact function from each of six buckets":
        step("All six name-length buckets retain their numeric result")
        expect(_eval("=COMBIN(5,2)")).to_equal("10")
        expect(_eval("=PRODUCT(2,3)")).to_equal("6")
        expect(_eval("=PI()")).to_start_with("3.14159")
        expect(_eval("=SUM(2,3)")).to_equal("5")
        expect(_eval("=FACT(5)")).to_equal("120")
        expect(_eval("=COUNT(2,3)")).to_equal("2")

    it "keeps the exact unknown-function error":
        step("An unrecognized function returns the original error")
        expect(_eval("=DOESNOTEXIST(1)")).to_equal("#ERR: Unknown function: DOESNOTEXIST")
