"""Regression coverage for bounded native formula dispatch.

The formula dispatcher used to be one 229 arm body. Native compilation of the
leaf exceeded Phase 2's 600 second limit and retained more than 3 GiB. These
examples exercise every alphabetic range after the source partition so a
compile time fix cannot silently drop a function family.
"""

use std.spec
use app.office.sheets.formula.{evaluate_formula_display_text}
use app.office.sheets.spreadsheet.{Sheet}

fn _formula_display(source: text) -> text:
    evaluate_formula_display_text(source, Sheet.new("dispatch"))

describe "formula dispatch partitions preserve behavior":
    it "dispatches A-B and C-D functions":
        expect(_formula_display("=ABS(-4)")).to_equal("4")
        expect(_formula_display("=COUNT(1,2,3)")).to_equal("3")

    it "dispatches E-F and G-L functions":
        expect(_formula_display("=EVEN(3)")).to_equal("4")
        expect(_formula_display("=GCD(12,18)")).to_equal("6")

    it "dispatches M-N and O-R functions":
        expect(_formula_display("=MAX(2,7,4)")).to_equal("7")
        expect(_formula_display("=PRODUCT(2,3,4)")).to_equal("24")

    it "dispatches S-T and U-Z functions":
        expect(_formula_display("=SUM(2,3,4)")).to_equal("9")
        expect(_formula_display("=WORKDAY(1,0)")).to_equal("1")

    it "preserves the unknown-function diagnostic":
        expect(_formula_display("=ZZZ_UNKNOWN(1)")).to_equal("#ERR")
