# Regression: EVEN and ODD round magnitudes away from zero before restoring sign.
# @req REQ-SSPEC-UNIT
use std.spec.step
use app.office.sheets.math_bridge.{excel_even, excel_odd}

describe "Math bridge parity rounding":
    it "EVEN rounds negative integers and fractions away from zero":
        step("EVEN rounds negative integers and fractions away from zero")
        assert_equal(excel_even(-3.0), -4.0)
        assert_equal(excel_even(-2.1), -4.0)
        assert_equal(excel_even(-1.1), -2.0)
        assert_equal(excel_even(-0.1), -2.0)
        assert_equal(excel_even(-2.0), -2.0)
        assert_equal(excel_even(0.0), 0.0)
        assert_equal(excel_even(2.1), 4.0)

    it "ODD rounds negative integers and fractions away from zero":
        step("ODD rounds negative integers and fractions away from zero")
        assert_equal(excel_odd(-2.0), -3.0)
        assert_equal(excel_odd(-3.1), -5.0)
        assert_equal(excel_odd(-1.1), -3.0)
        assert_equal(excel_odd(-0.1), -1.0)
        assert_equal(excel_odd(-3.0), -3.0)
        assert_equal(excel_odd(0.0), 1.0)
        assert_equal(excel_odd(3.1), 5.0)

    it "keeps negative i64 boundary rounding representable without integer underflow":
        step("keeps negative i64 boundary rounding representable without integer underflow")
        val minimum = -9223372036854775808.0
        val adjacent = -9223372036854774784.0
        assert_equal(excel_even(minimum), minimum)
        assert_equal(excel_even(adjacent), adjacent)
        # The next odd mathematical integer rounds to the same f64 at this scale.
        assert_equal(excel_odd(minimum), minimum)
        assert_equal(excel_odd(adjacent), adjacent)
