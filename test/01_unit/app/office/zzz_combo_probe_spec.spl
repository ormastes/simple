use std.spec.{describe, it, expect}
use app.office.word.word_app.{WordApp}
use app.office.sheets.sheets_app.{SheetsApp}

describe "combo probe":
    it "builds word and sheets ui together":
        val w = WordApp.new()
        val wui = w.build_ui()
        expect(wui.root_id).to_equal("word_root")
        val s = SheetsApp.new()
        val sui = s.build_ui()
        expect(sui.root_id).to_equal("root")
