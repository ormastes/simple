# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""Slide shapes + build-animation spec.

Verifies the vector shapes model in `app.office.slides.shapes`: SVG rendering
per shape kind (rect/ellipse/arrow/line/textbox), whole-slide SVG assembly in
insertion order, escaping of shape content, and the build-animation summary
which lists only animated shapes in slide order.
"""

use std.spec.step

use std.spec
use std.spec.step
use app.office.slides.shapes.{shape_new, shape_slide_new, shape_slide_add, shape_to_svg, shape_slide_to_svg, shape_anim_summary}


describe "shapes: SVG rendering":
    # @manual scenario evidence
    """Individual shape kinds render to their expected SVG element(s)."""

    it "renders a filled rect with its position and fill hex":
        # @req REQ-SSPEC-APP
        step("renders a filled rect with its position and fill hex")
        val rect = shape_new("rect", 10, 20, 100, 50, "", "#4472c4", "fade")
        val svg = shape_to_svg(rect)
        expect(svg).to_contain("<rect")
        expect(svg).to_contain("#4472c4")
        expect(svg).to_contain("x=\"10\"")
        expect(svg).to_contain("y=\"20\"")

    it "renders an ellipse with no fill as fill=none":
        # @req REQ-SSPEC-APP
        step("renders an ellipse with no fill as fill=none")
        val ellipse = shape_new("ellipse", 0, 0, 40, 20, "", "", "")
        val svg = shape_to_svg(ellipse)
        expect(svg).to_contain("<ellipse")
        expect(svg).to_contain("fill=\"none\"")

    it "renders an arrow as a line plus a triangle polygon head":
        # @req REQ-SSPEC-APP
        step("renders an arrow as a line plus a triangle polygon head")
        val arrow = shape_new("arrow", 0, 0, 100, 0, "", "#000000", "fly-in")
        val svg = shape_to_svg(arrow)
        expect(svg).to_contain("<line")
        expect(svg).to_contain("<polygon")

    it "renders a textbox as a rect plus text":
        # @req REQ-SSPEC-APP
        step("renders a textbox as a rect plus text")
        val tb = shape_new("textbox", 5, 5, 80, 30, "Hello", "#ffffff", "")
        val svg = shape_to_svg(tb)
        expect(svg).to_contain("<rect")
        expect(svg).to_contain("<text")
        expect(svg).to_contain(">Hello<")

    it "escapes shape content so a literal < renders as &lt;":
        # @req REQ-SSPEC-APP
        step("escapes shape content so a literal < renders as &lt;")
        val tb = shape_new("textbox", 0, 0, 10, 10, "<script>", "", "")
        val svg = shape_to_svg(tb)
        expect(svg).to_contain("&lt;script&gt;")
        expect(svg.contains("<script>")).to_equal(false)

describe "shapes: slide assembly and animation order":
    """A ShapeSlide assembles shapes into one SVG in insertion order, and
    reports the build-animation order separately (skipping un-animated
    shapes)."""

    it "wraps all shapes in one <svg> in insertion order":
        # @req REQ-SSPEC-APP
        step("wraps all shapes in one <svg> in insertion order")
        var slide = shape_slide_new("Diagram")
        slide = shape_slide_add(slide, shape_new("rect", 0, 0, 10, 10, "", "#4472c4", "fade"))
        slide = shape_slide_add(slide, shape_new("ellipse", 20, 20, 10, 10, "", "", ""))
        slide = shape_slide_add(slide, shape_new("arrow", 40, 40, 10, 0, "", "", "fly-in"))
        val svg = shape_slide_to_svg(slide, 960, 540)
        expect(svg).to_contain("<svg")
        expect(svg).to_contain("width=\"960\"")
        expect(svg).to_contain("height=\"540\"")
        val rect_pos = svg.find("<rect")
        val ellipse_pos = svg.find("<ellipse")
        val arrow_pos = svg.find("<line")
        expect(rect_pos < ellipse_pos).to_equal(true)
        expect(ellipse_pos < arrow_pos).to_equal(true)

    it "returns only animated shapes, skipping the ellipse, in build order":
        # @req REQ-SSPEC-APP
        step("returns only animated shapes, skipping the ellipse, in build order")
        var slide = shape_slide_new("Diagram")
        slide = shape_slide_add(slide, shape_new("rect", 0, 0, 10, 10, "", "#4472c4", "fade"))
        slide = shape_slide_add(slide, shape_new("ellipse", 20, 20, 10, 10, "", "", ""))
        slide = shape_slide_add(slide, shape_new("arrow", 40, 40, 10, 0, "", "", "fly-in"))
        val summary = shape_anim_summary(slide)
        expect(summary).to_equal(["rect:fade", "arrow:fly-in"])

    describe "deliberate-fail probe (fixed to green)":
        """A probe that intentionally asserted the wrong count first, to
        confirm the example is actually exercised, then corrected."""

        it "has exactly two animated shapes in the summary":
            # @req REQ-SSPEC-APP
            step("has exactly two animated shapes in the summary")
            var slide = shape_slide_new("Diagram")
            slide = shape_slide_add(slide, shape_new("rect", 0, 0, 10, 10, "", "#4472c4", "fade"))
            slide = shape_slide_add(slide, shape_new("ellipse", 20, 20, 10, 10, "", "", ""))
            slide = shape_slide_add(slide, shape_new("arrow", 40, 40, 10, 0, "", "", "fly-in"))
            val summary = shape_anim_summary(slide)
            expect(summary.len()).to_equal(2)
