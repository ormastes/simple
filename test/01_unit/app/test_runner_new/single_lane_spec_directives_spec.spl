"""Per-spec limits and classification survive dispatch into the MC/DC lane.

Exercise the real source directives and inherited environment without waiting
for a timeout or depending on an instrumentation-capable compiler.
"""
use std.spec.*
use app.test_runner_new.test_runner_single.{prepare_single_spec_options}
use std.test_runner.test_runner_args.{parse_test_args}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}

val DIRECTIVES = "test/fixtures/test_runner_single/feature/mcdc_directives_spec.spl"
val SLOW = "test/fixtures/test_runner_single/mcdc_slow_directive_spec.spl"
val KEYS = ["SIMPLE_TIMEOUT_SECONDS", "SIMPLE_EXECUTION_LIMIT", "SIMPLE_SYSTEM_TEST", "SIMPLE_DI_TEST"]
val SAVED = [env_get("SIMPLE_TIMEOUT_SECONDS") ?? "", env_get("SIMPLE_EXECUTION_LIMIT") ?? "",
    env_get("SIMPLE_SYSTEM_TEST") ?? "", env_get("SIMPLE_DI_TEST") ?? ""]

describe "single-lane prepared spec options":
    after_each:
        var index = 0
        for key in KEYS:
            env_set(key, SAVED[index])
            index = index + 1

    it "raises the MC/DC options and child limits from the source directives":
        env_set("SIMPLE_TIMEOUT_SECONDS", "")
        env_set("SIMPLE_EXECUTION_LIMIT", "")
        var options = parse_test_args(["--profile=strict", "--timeout=20", DIRECTIVES])
        options.path = DIRECTIVES
        val prepared = prepare_single_spec_options(options, 20)
        expect(prepared.timeout).to_equal(900)
        expect(prepared.path).to_equal(DIRECTIVES)
        expect(prepared.profile).to_equal(options.profile)
        expect(env_get("SIMPLE_TIMEOUT_SECONDS") ?? "").to_equal("900")
        expect(env_get("SIMPLE_EXECUTION_LIMIT") ?? "").to_equal("30000000")
        expect(env_get("SIMPLE_SYSTEM_TEST") ?? "").to_equal("1")
        expect(env_get("SIMPLE_DI_TEST") ?? "").to_equal("1")

    it "keeps larger explicit and inherited budgets":
        env_set("SIMPLE_TIMEOUT_SECONDS", "1800")
        env_set("SIMPLE_EXECUTION_LIMIT", "40000000")
        var options = parse_test_args([DIRECTIVES])
        options.path = DIRECTIVES
        val prepared = prepare_single_spec_options(options, 1200)
        expect(prepared.timeout).to_equal(1200)
        expect(env_get("SIMPLE_TIMEOUT_SECONDS") ?? "").to_equal("1800")
        expect(env_get("SIMPLE_EXECUTION_LIMIT") ?? "").to_equal("40000000")

    it "preserves an unlimited monitor while applying the slow-test floor":
        env_set("SIMPLE_TIMEOUT_SECONDS", "0")
        env_set("SIMPLE_SYSTEM_TEST", "1")
        env_set("SIMPLE_DI_TEST", "1")
        var options = parse_test_args([SLOW])
        options.path = SLOW
        val prepared = prepare_single_spec_options(options, 120)
        expect(prepared.timeout).to_equal(600)
        expect(env_get("SIMPLE_TIMEOUT_SECONDS") ?? "").to_equal("0")
        expect(env_get("SIMPLE_SYSTEM_TEST") ?? "").to_equal("0")
        expect(env_get("SIMPLE_DI_TEST") ?? "").to_equal("0")
