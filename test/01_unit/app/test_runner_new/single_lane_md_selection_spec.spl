"""Markdown lane selection must distinguish paths from option values."""

use std.spec.*
use app.test_runner_new.test_runner_single.{_single_is_md_run}

describe "single-file Markdown lane selection", :
    it "does not route a tag value to Markdown", :
        expect(_single_is_md_run(["case.spl", "--tag", "notes.md"])).to_equal(false)
        expect(_single_is_md_run(["--tag", "notes.md", "case.spl"])).to_equal(false)

    it "consumes other forwarded values and compiler paths", :
        expect(_single_is_md_run(["case.spl", "--qemu-socket", "socket.md"])).to_equal(false)
        expect(_single_is_md_run(["--compiler", "compiler.md", "case.spl"])).to_equal(false)
        expect(_single_is_md_run(["case.spl", "--tag=notes.md"])).to_equal(false)

    it "retains real Markdown positional paths", :
        expect(_single_is_md_run(["--tag", "notes.md", "actual.md"])).to_equal(true)
        expect(_single_is_md_run(["--list", "actual.md"])).to_equal(true)

    it "retains explicit sdoctest mode", :
        expect(_single_is_md_run(["--sdoctest", "docs"])).to_equal(true)
        expect(_single_is_md_run(["--tag", "--sdoctest", "case.spl"])).to_equal(false)
