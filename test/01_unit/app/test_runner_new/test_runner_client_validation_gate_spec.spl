"""Specialized runner routes must validate argv before parsing or running."""

use std.spec.{describe, it, expect}
use app.test_runner_new.test_runner_client.{run_scoped_spl_doctest}

describe "scoped SDoctest argument validation":
    it "rejects malformed thresholds before starting the SDoctest route":
        val status = run_scoped_spl_doctest([
            "--spl-doctest",
            "test/01_unit/app/test_runner_new/test_runner_args_signed_threshold_spec.spl",
            "--cpu-threshold=12x.5"
        ])

        expect(status).to_equal(2)
