"""`shell_safe_child_binary_path` must be reachable through every import path
the test runner uses.

test_runner_single.spl imports it via the `std.test_runner` facade
(src/lib/nogc_async_mut/test_runner/test_executor_parsing.spl) and
test_runner_main.spl imports it from std.nogc_sync_mut directly. When the
function was private and missing from the facade's export list, every test run
printed a [use-warning]. This spec pins both paths and the re-export line.
"""

use std.spec.*
use std.test_runner.test_executor_parsing.{shell_safe_child_binary_path}
use std.nogc_sync_mut.test_runner.test_executor_parsing.{shell_safe_child_binary_path as sync_shell_safe}
use std.io_runtime.{read_file_text}

describe "shell_safe_child_binary_path export":
    it "is callable through the std.test_runner facade":
        expect(shell_safe_child_binary_path("/usr/bin/simple")).to_equal("/usr/bin/simple")

    it "is callable from nogc_sync_mut directly":
        expect(sync_shell_safe("/usr/bin/simple")).to_equal("/usr/bin/simple")

    it "is listed in the nogc_async_mut facade export list":
        val src = read_file_text("src/lib/nogc_async_mut/test_runner/test_executor_parsing.spl")
        expect(src.contains("shell_safe_child_binary_path")).to_equal(true)
