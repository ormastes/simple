use std.spec
use app.test_runner_new.test_runner_worker_admission.{test_runner_admitted_worker_count}

describe "test runner worker admission":
    it "caps explicit worker requests by host max_threads":
        expect(test_runner_admitted_worker_count(80, 12, "4")).to_equal(4)
        expect(test_runner_admitted_worker_count(3, 12, "4")).to_equal(3)

    it "keeps the automatic ceiling and then applies the host cap":
        expect(test_runner_admitted_worker_count(0, 40, "6")).to_equal(6)
        expect(test_runner_admitted_worker_count(0, 40, "")).to_equal(8)

    it "ignores invalid or zero host caps":
        expect(test_runner_admitted_worker_count(12, 4, "0")).to_equal(12)
        expect(test_runner_admitted_worker_count(12, 4, "-2")).to_equal(12)
        expect(test_runner_admitted_worker_count(12, 4, "lots")).to_equal(12)
        expect(test_runner_admitted_worker_count(12, 4, "9223372036854775808")).to_equal(12)

    it "treats nonpositive worker requests as automatic selection":
        expect(test_runner_admitted_worker_count(0, 5, "3")).to_equal(3)
        expect(test_runner_admitted_worker_count(-1, 5, "3")).to_equal(3)
        expect(test_runner_admitted_worker_count(0, 0, "")).to_equal(1)
