"""Single-file lane: a matcher word after a PARENTHESIZED expect subject.

Audience: anyone editing `_single_rewrite_infix_expect_line` in
`src/app/test_runner_new/test_runner_single.spl`.

`expect(cpop[0]) to_equal(first[0])` was skipped by the rewrite (it returned
early for any line starting with `expect(`), so on the pure-Simple lane the
matcher word was left as an orphan statement and the expect was vacuous. The
seed parser was fixed for the same shape in 5a3a5ce413f (no_paren.rs folds a
matcher word after a paren subject); this pins the pure-Simple mirror.

Assertions are ALGORITHMIC (rewrite output as a function of the input line).
"""
use std.spec.*

use app.test_runner_new.test_runner_single.{_single_rewrite_infix_expect_line}

describe "single-file lane: paren-subject matcher word", :
    it "folds a paren-argument matcher word into a chained call":
        expect(_single_rewrite_infix_expect_line("        expect(cpop[0]) to_equal(first[0])")).to_equal("        expect(cpop[0]).to_equal(first[0])")

    it "folds a space-argument matcher word":
        expect(_single_rewrite_infix_expect_line("expect(x) to_equal 1")).to_equal("expect(x).to_equal(1)")

    it "folds a zero-argument matcher word":
        expect(_single_rewrite_infix_expect_line("expect(v) to_be_nil")).to_equal("expect(v).to_be_nil()")

    it "matches the matcher word exactly, not by prefix":
        expect(_single_rewrite_infix_expect_line("expect(n) to_be_greater_than(2)")).to_equal("expect(n).to_be_greater_than(2)")

    it "skips nested parens and string literals in the subject":
        expect(_single_rewrite_infix_expect_line("expect(f(\")\", g(1))) to_contain(\"a\")")).to_equal("expect(f(\")\", g(1))).to_contain(\"a\")")

    it "leaves already-chained, non-matcher and unbalanced lines untouched":
        expect(_single_rewrite_infix_expect_line("expect(a).to_equal(b)")).to_equal("expect(a).to_equal(b)")
        expect(_single_rewrite_infix_expect_line("expect(a) == b")).to_equal("expect(a) == b")
        expect(_single_rewrite_infix_expect_line("expect(a to_equal(b)")).to_equal("expect(a to_equal(b)")
        expect(_single_rewrite_infix_expect_line("expect(a) to_frobnicate(b)")).to_equal("expect(a) to_frobnicate(b)")

    it "still rewrites the no-paren subject form":
        expect(_single_rewrite_infix_expect_line("expect total to_equal 3")).to_equal("expect(total).to_equal(3)")
