# Lane-marker fixture for direct_lane_mode_backend_flags_spec.spl.
#
# The single-spec direct lane (test_runner_single.spl) pins
# SIMPLE_EXECUTION_MODE=interpret before spawning the spec child; a compiled
# lane (native/smf) would not. Printing both markers makes an interpreted
# stand-in for a requested-compiled run VISIBLE in the child transcript —
# the behavioral signal the host spec asserts on, instead of wall-clock.
use std.io_runtime.{env_get}

describe "direct lane execution-mode marker", :
    it "prints the execution mode it actually ran under", :
        val exec_mode = env_get("SIMPLE_EXECUTION_MODE") ?? "unset"
        val runtime_mode = env_get("SIMPLE_RUNTIME_MODE") ?? "unset"
        print "LANE-MARKER execution_mode=" + exec_mode + " runtime_mode=" + runtime_mode
        expect(exec_mode).to_not_equal("")
