use std.spec.*
use app.test_runner_new.client_arg_shape.{client_flag_consumes_value}

describe "single-spec client flag/value shape":
    it "treats value flags as consuming the next argument":
        expect(client_flag_consumes_value("--format")).to_equal(true)
        expect(client_flag_consumes_value("--tag")).to_equal(true)
        expect(client_flag_consumes_value("--timeout")).to_equal(true)
        expect(client_flag_consumes_value("--seed")).to_equal(true)
    it "does not consume for boolean flags or paths":
        expect(client_flag_consumes_value("--list")).to_equal(false)
        expect(client_flag_consumes_value("--format=doc")).to_equal(false)
        expect(client_flag_consumes_value("a_spec.spl")).to_equal(false)
