"""Tier flags filter discovered files by level (directory discovery path).

The single-file lane runs an explicitly named file regardless of tier flags;
filtering applies to discovered files via `matches_level`.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_runner_types.{TestLevel}
use std.test_runner.test_runner_files.{matches_level}

describe "matches_level":
    it "keeps a smoke file for TestLevel.Smoke":
        expect(matches_level("test/04_smoke/x_spec.spl", TestLevel.Smoke)).to_equal(true)
    it "drops a smoke file for TestLevel.Unit":
        expect(matches_level("test/04_smoke/x_spec.spl", TestLevel.Unit)).to_equal(false)
    it "drops a unit file for TestLevel.Smoke":
        expect(matches_level("test/01_unit/x_spec.spl", TestLevel.Smoke)).to_equal(false)
    it "keeps every file for TestLevel.All":
        expect(matches_level("test/04_smoke/x_spec.spl", TestLevel.All)).to_equal(true)
