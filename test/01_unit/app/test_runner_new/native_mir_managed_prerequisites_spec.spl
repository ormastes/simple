"""Pure early prerequisite contracts; no broker/kernel/compiler execution."""
use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.cli.native_mir_managed_process_owner_v1.{native_mir_managed_prerequisite_reason_v1}

describe "Managed selective migration prerequisites":
    it "rejects missing broker setup before any platform probe":
        expect(native_mir_managed_prerequisite_reason_v1("linux", "", "", 1024, 128, 1000)).to_contain("SIMPLE_MIR_GROUP_BROKER_PROGRAM")
        expect(native_mir_managed_prerequisite_reason_v1("linux", "/cached/broker", "", 1024, 128, 1000)).to_contain("SIMPLE_MIR_GROUP_BROKER_DIGEST")

    it "requires explicit platform broker estimate and finite worker lifetime":
        val pin = sha256_text("externally-qualified fixture identity")
        expect(native_mir_managed_prerequisite_reason_v1("windows", "/cached/broker", pin, 1024, 128, 1000)).to_contain("Linux")
        expect(native_mir_managed_prerequisite_reason_v1("linux", "/cached/broker", pin, 1024, 0, 1000)).to_contain("BROKER_KIB")
        expect(native_mir_managed_prerequisite_reason_v1("linux", "/cached/broker", pin, 1024, 128, 0)).to_contain("finite")

    it "accepts only bounded syntactic inputs without claiming image admission":
        val pin = sha256_text("externally-qualified fixture identity")
        expect(native_mir_managed_prerequisite_reason_v1("linux", "/cached/broker", pin, 1024, 128, 1000)).to_equal("")
        expect(native_mir_managed_prerequisite_reason_v1("linux", "/cached/broker", pin, 9223372036854775807, 128, 1000)).to_contain("bounded")
