# Regression coverage for file paths used as test-runner coverage aggregation keys.

use std.spec
use app.test_runner_new.test_runner_coverage.{reset_coverage_state, decision_key, accumulate_coverage_sdn, build_coverage_data_from_state, render_coverage_sdn}

describe "native app test-runner coverage key paths":
    it "keeps delimiter, percent, Unicode, and ordinary paths distinct":
        reset_coverage_state()
        expect(decision_key("src/a.spl", "10", "5", "1")).to_equal("src/a.spl|10|5|1")
        var sdn = "decision src/a|b.spl:10 1 true\ndecision src/a|b.spl:10 1 false\n"
        sdn = sdn + "decision src/a|c.spl:10 1 true\ndecision src/a|c.spl:10 1 false\n"
        sdn = sdn + "decision src/a%7Cb.spl:10 1 true\ndecision src/a%7Cb.spl:10 1 false\n"
        sdn = sdn + "decision src/a%25b.spl:10 1 true\ndecision src/a%25b.spl:10 1 false\n"
        sdn = sdn + "decision src/한글.spl:10 1 true\ndecision src/한글.spl:10 1 false\n"
        sdn = sdn + "decision src/a.spl:10 1 true\ndecision src/a.spl:10 1 false"
        sdn = sdn + "\ncondition src/a|b.spl:11 1 true\ncondition src/a|b.spl:11 1 false"
        sdn = sdn + "\ncondition src/a|c.spl:11 1 true\ncondition src/a|c.spl:11 1 false"
        sdn = sdn + "\ncondition src/a%7Cb.spl:11 1 true\ncondition src/a%7Cb.spl:11 1 false"
        sdn = sdn + "\ncondition src/a%25b.spl:11 1 true\ncondition src/a%25b.spl:11 1 false"
        sdn = sdn + "\ncondition src/한글.spl:11 1 true\ncondition src/한글.spl:11 1 false"
        sdn = sdn + "\ncondition src/a.spl:11 1 true\ncondition src/a.spl:11 1 false"
        accumulate_coverage_sdn(sdn)
        val data = build_coverage_data_from_state("")
        expect(data.total_decisions).to_equal(6)
        expect(data.total_decisions_covered).to_equal(6)
        expect(data.total_conditions).to_equal(6)
        expect(data.total_conditions_covered).to_equal(6)
        expect(data.files.len()).to_equal(6)
        val rendered = render_coverage_sdn()
        expect(rendered).to_contain("src/a|b.spl")
        expect(rendered).to_contain("src/a|c.spl")
        expect(rendered).to_contain("src/a%7Cb.spl")
        expect(rendered).to_contain("src/a%25b.spl")
        expect(rendered).to_contain("src/한글.spl")
        expect(rendered).to_contain("src/a.spl")
        expect(rendered).to_contain("conditions |decision_id, condition_id, file")
