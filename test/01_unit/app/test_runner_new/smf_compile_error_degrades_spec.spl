# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
"""
## Purpose and audience
A HARD SMF-compile failure must degrade a spec file to the interpreter, exactly
like the SOFT "N function(s) contain constructs that require the interpreter"
failure already did — and the degrade must be recorded on the file's
`SPEC FILE VERDICT:` line so it is visible to every sweep that parses those
lines.

Audience: owners of `src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl`
(`run_test_file_native`, `smf_compile_degrade_token`),
`src/app/test_runner_new/test_runner_main.spl` (`emit_spec_file_verdicts`) and
`src/app/test_daemon/light_protocol.spl` (`ran_verdict_line`).

## Why this spec exists (REPRODUCER)
Measured 2026-09-12 on seed sha256 `3d120a6f`: `bin/simple test <directory>`
runs every spec through an MC/DC standalone-SMF compile first. When that
compile failed SOFT the runner degraded the file to the interpreter and the
file passed; when it failed HARD — `Undefined("undefined identifier: X")` or
`HIR lowering: Unsupported feature` — it did not, and the file reported
`executed=1 passed=0 failed=1`, losing EVERY example in it. Three same-day bug
records share that shape:
`doc/08_tracking/bug/macro_contracts_module_unresolvable_in_compiled_spec_lane_2026-09-12.md`,
`doc/08_tracking/bug/gpu_lighting3d_spec_asserts_stale_light_buf_field_2026-09-12.md`,
and the devhub `print_raw` record.

## Compatibility and limitations — READ BEFORE "STRENGTHENING" THIS SPEC
This spec pins the two PURE halves of the contract: how a compile diagnostic is
classified into a `degraded=` token, and how that token reaches the verdict
line. It does NOT run the runner over a directory, and that is a measured
constraint, not an oversight. The behaviour only exists on the DIRECTORY lane —
the only lane that compiles a spec to SMF at all; a single-file run is the
interpreter and hides the defect entirely — so asserting it from inside a spec
means starting a second runner inside a directory-lane spec child. Measured
2026-09-12, twice: a nested `bin/simple test <dir>` dies with `innerrc=134`
(SIGABRT) having written zero bytes, and calling `run_test_file_native`
in-process instead makes its `bin/simple compile` grandchild panic inside
tracing-appender. Both were tried, and the fail-closed guard correctly reported
"nothing captured" rather than passing on an empty capture.

The end-to-end assertion therefore lives OUTSIDE the runner, where it is
reproducible, in `scripts/check/check-smf-compile-degrade.shs` — a fail-closed
gate over `test/fixtures/runner_degrade/` with the repo's
PASS/FAIL/`ERROR — nothing was checked` verdict convention and its own selftest.
Run that gate when you change the degrade branch; do not re-add a nested runner
here.

## Verification guidance and troubleshooting
The gate's `b_hard_compile_error_spec.spl` fixture calls `print_raw`, which the
interpreter provides and the self-hosted HIR lowering does not, so its SMF
compile fails hard and deterministically. If that builtin ever becomes
compilable the fixture stops reproducing and the gate turns RED — replace the
fixture's hard-error mechanism, do not delete the assertion.
"""
use std.spec.step

use std.spec.*

use std.test_runner.test_runner_execute.{smf_compile_degrade_token}

use app.test_daemon.light_protocol.{ran_verdict_line}

# A real diagnostic, byte for byte, from the run that reproduced the defect.
val HARD_DIAGNOSTIC: text = "error: compile failed (/tmp/spipe_wrapped_b_spec_native.spl): semantic: /tmp/spipe_wrapped_b_spec_native.spl: Undefined(\"undefined identifier: print_raw\")"
val SOFT_DIAGNOSTIC: text = "error: compile failed (/tmp/spipe_wrapped_a_spec_native.spl): semantic: /tmp/spipe_wrapped_a_spec_native.spl: cannot compile to standalone SMF: 52 function(s) contain constructs that require the interpreter:"
val HIR_DIAGNOSTIC: text = "error: compile failed (/tmp/spipe_wrapped_d_spec_native.spl): HIR lowering: Unsupported feature: TryOperator in a returned closure"

describe "hard SMF-compile failures degrade to the interpreter":
    # @manual scenario evidence
    describe "classifying the compile diagnostic", :
        it "tags a HARD compile failure as smf-compile-error and keeps its cause", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("classify the Undefined(...) diagnostic that used to lose the whole file")
            # The run-varying temp path is dropped and the CAUSE is kept: a
            # token that named only the kind would leave the next occurrence
            # undiagnosable, and one that kept the path would be different on
            # every run and mostly noise.
            expect(smf_compile_degrade_token(HARD_DIAGNOSTIC))
                .to_equal("smf-compile-error:Undefined(undefined_identifier:_print_raw)")

        it "tags an unsupported-HIR-feature failure as smf-compile-error too", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("the other hard failure class named in the bug records")
            val token = smf_compile_degrade_token(HIR_DIAGNOSTIC)
            expect(token.starts_with("smf-compile-error")).to_be_true()
            expect(token).to_contain("Unsupported_feature")

        it "keeps the SOFT interpreter-only failure distinguishable", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("the failure class the runner already degraded on must not be merged in")
            val token = smf_compile_degrade_token(SOFT_DIAGNOSTIC)
            expect(token.starts_with("smf-interpreter-only-constructs")).to_be_true()
            expect(token).to_not_contain("smf-compile-error")

        it "never emits whitespace inside the token", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("a verdict line is whitespace-separated key=value tokens")
            # One embedded space would turn the rest of the diagnostic into
            # bogus `key=value` tokens for every reader that splits the line.
            expect(smf_compile_degrade_token(HARD_DIAGNOSTIC)).to_not_contain(" ")
            expect(smf_compile_degrade_token(SOFT_DIAGNOSTIC)).to_not_contain(" ")
            expect(smf_compile_degrade_token(HIR_DIAGNOSTIC)).to_not_contain(" ")

    describe "recording the degrade on the verdict line", :
        it "leaves a non-degraded verdict line byte-identical", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("a file that ran the way the lane intended gains no new token")
            expect(ran_verdict_line("test/x_spec.spl", 2, 0)).to_not_contain("degraded=")

        it "appends the degrade token last, after dropped=", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("position is part of the contract: existing readers parse the prefix")
            expect(ran_verdict_line("test/x_spec.spl", 3, 0, 0, "smf-compile-error:boom"))
                .to_contain("passed=3 failed=0 in_development=0 dropped=0 degraded=smf-compile-error:boom")

        it "never launders a failed file into OK just because it degraded", :
            # @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
            step("the fail-closed rule: the interpreter run's real verdict wins")
            # A spec that cannot compile AND fails its assertions must stay red;
            # this is the whole reason the degrade is safe to widen.
            val line = ran_verdict_line("test/c_spec.spl", 0, 1, 0, "smf-compile-error:boom")
            expect(line).to_contain("outcome=ERROR")
            expect(line).to_contain("failed=1")
            expect(line).to_contain("degraded=smf-compile-error:boom")
