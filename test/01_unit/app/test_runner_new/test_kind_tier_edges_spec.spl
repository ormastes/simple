"""Tier-detection edge cases for the 4 test kinds (unit/integration/system/smoke).

Audience: anyone editing `std.test_runner.test_level_detect`.
Code map: 0 none, 1 unit, 2 integration, 3 system, 4 smoke (new).

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_level_detect.{test_level_of_path}

describe "nested paths":
    it "classifies deeply nested smoke specs":
        expect(test_level_of_path("test/04_smoke/a/b/c/d/x_spec.spl")).to_equal(4)
    it "classifies deeply nested unit specs":
        expect(test_level_of_path("test/01_unit/a/b/c/d/x_spec.spl")).to_equal(1)
    it "uses a tier segment found anywhere in an absolute path":
        expect(test_level_of_path("/tmp/work/test/04_smoke/x_spec.spl")).to_equal(4)
    it "lets unit win when a unit dir is nested under smoke":
        expect(test_level_of_path("test/04_smoke/unit/x_spec.spl")).to_equal(1)

describe "bare smoke alias":
    it "classifies test/smoke":
        expect(test_level_of_path("test/smoke/x_spec.spl")).to_equal(4)
    it "classifies a nested bare smoke dir":
        expect(test_level_of_path("test/smoke/net/x_spec.spl")).to_equal(4)
    it "ignores a one-digit order prefix":
        expect(test_level_of_path("test/4_smoke/x_spec.spl")).to_equal(0)
    it "ignores smoke as a file name only":
        expect(test_level_of_path("test/05_perf/smoke_spec.spl")).to_equal(0)
    it "ignores smoke as a substring of a segment":
        expect(test_level_of_path("test/smoketest/x_spec.spl")).to_equal(0)

describe "files outside test/":
    it "leaves src files unclassified":
        expect(test_level_of_path("src/app/x.spl")).to_equal(0)
    it "leaves the empty path unclassified":
        expect(test_level_of_path("")).to_equal(0)
    it "still classifies a tier directory outside test/ by segment":
        expect(test_level_of_path("scratch/04_smoke/x_spec.spl")).to_equal(4)

describe "Windows separators":
    it "classifies backslash smoke paths":
        expect(test_level_of_path("test\\04_smoke\\x_spec.spl")).to_equal(4)
    it "classifies backslash unit paths":
        expect(test_level_of_path("C:\\repo\\test\\01_unit\\a\\x_spec.spl")).to_equal(1)
    it "classifies mixed separators":
        expect(test_level_of_path("test/03_system\\app/x_spec.spl")).to_equal(3)
    it "classifies integration with a drive letter":
        expect(test_level_of_path("D:\\t\\02_integration\\x_spec.spl")).to_equal(2)
