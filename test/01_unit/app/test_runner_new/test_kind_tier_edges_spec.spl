"""Tier detection edge cases: nested, bare alias, outside test/, Windows paths.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_level_detect.{test_level_of_path}

describe "tier detection edges":
    it "classifies a deeply nested smoke spec":
        expect(test_level_of_path("test/04_smoke/a/b/c/x_spec.spl")).to_equal(4)
    it "classifies the bare test/smoke alias":
        expect(test_level_of_path("test/smoke/x_spec.spl")).to_equal(4)
    it "does not match smoke inside a longer name":
        expect(test_level_of_path("test/smoketest/x_spec.spl")).to_equal(0)
    it "leaves files outside test/ unclassified":
        expect(test_level_of_path("src/app/x.spl")).to_equal(0)
    it "classifies Windows smoke paths":
        expect(test_level_of_path("test\\04_smoke\\x_spec.spl")).to_equal(4)
    it "classifies Windows unit paths with a drive letter":
        expect(test_level_of_path("C:\\repo\\test\\01_unit\\x_spec.spl")).to_equal(1)
