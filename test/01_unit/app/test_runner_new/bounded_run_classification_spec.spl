# @cover src/app/test_daemon/light_protocol.spl 20%
"""
## Purpose and audience
Executable contract for how the single-file `simple test` client classifies a
bounded child run. Four exit codes (-1, 124, 143, 255) are KILL-SHAPED but
ambiguous: each is produced both by the outer bounded wait killing the child
and by an ordinary early failure. Only the measured elapsed time separates
them, so the classifier takes it as a required argument.

Written for whoever owns the test runner, because getting this wrong is
invisible: a child that died in 3ms was reported as
`reason=outer-bound-timeout budget_ms=930000`, asserting a 15-minute duration
that never elapsed and routing triage to the timeout owner instead of to the
real fault.

## Operator workflow
SIMPLE_EXECUTION_MODE=interpreter simple run test/01_unit/app/test_runner_new/bounded_run_classification_spec.spl

## Compatibility and limitations
Pure classification over integers — no process is spawned, no clock is read,
no filesystem touched. Deterministic on every platform and lane.

## Verification guidance and troubleshooting
A failure means the runner's timeout reporting has drifted. Check the 30s
grace window: the client grants the inner single-runner 30s on top of the
child budget, so the outer bound cannot legitimately fire before
`outer_timeout_ms - 30000`.
"""
# Lifecycle: doc/08_tracking/bug/test_runner_reports_early_child_death_as_outer_bound_timeout_2026-09-12.md
# @manual_section: bounded-run-classification

use std.spec.{describe, it, expect, step}
use app.test_daemon.light_protocol.{bounded_run_classification, early_death_verdict_line, timeout_verdict_line}


describe "Bounded run classification":
    it "calls a kill-shaped exit far inside the budget an early death":
        # @req REQ-RUNNER-CLASS-001
        # @capture(statistics): classification of each kill-shaped code at 3ms against a 930000ms bound
        step("Classify the measured incident: code -1 after 3ms against a 930000ms outer bound")
        expect(bounded_run_classification(-1, 3, 930000)).to_equal("early-death")  # oracle: 3ms is nowhere near the 900000ms floor
        expect(bounded_run_classification(255, 4000, 930000)).to_equal("early-death")  # oracle: the 4s reproduction, same verdict
        expect(bounded_run_classification(124, 0, 930000)).to_equal("early-death")
        expect(bounded_run_classification(143, 899999, 930000)).to_equal("early-death")  # oracle: 1ms below the floor is still early

    it "calls a kill-shaped exit at the budget a real timeout":
        # @req REQ-RUNNER-CLASS-002
        # @capture(statistics): classification at and above the grace floor
        step("Classify deaths at the 30s grace floor and beyond")
        expect(bounded_run_classification(-1, 900000, 930000)).to_equal("timeout")  # oracle: exactly the floor counts as a timeout
        expect(bounded_run_classification(124, 930000, 930000)).to_equal("timeout")
        expect(bounded_run_classification(143, 1000000, 930000)).to_equal("timeout")  # oracle: past the bound is certainly a timeout

    it "leaves every non-kill-shaped exit code alone":
        # @req REQ-RUNNER-CLASS-003
        # @capture(statistics): classification of ordinary spec exit codes
        step("Classify ordinary exit codes, which the child produced itself")
        expect(bounded_run_classification(0, 3, 930000)).to_equal("ran")  # oracle: a clean exit is the child's own outcome
        expect(bounded_run_classification(1, 3, 930000)).to_equal("ran")  # oracle: a failing spec is the child's own outcome
        expect(bounded_run_classification(1, 999999, 930000)).to_equal("ran")  # oracle: duration never reclassifies a non-kill code
        expect(bounded_run_classification(2, 3, 930000)).to_equal("ran")

    it "reports the measured duration rather than the budget in the verdict":
        # @req REQ-RUNNER-CLASS-004
        # @capture(protocol_json): the early-death verdict line emitted for the measured incident
        step("Render the early-death verdict line for the reproduced 3ms death")
        val line = early_death_verdict_line("spec.spl", -1, 3, 930000)
        expect(line).to_contain("reason=child-died-early")  # oracle: the reason names the real cause
        expect(line).to_contain("elapsed_ms=3")  # oracle: the MEASURED duration appears, not the budget
        expect(line).to_contain("exit_code=-1")  # oracle: the ambiguous code is preserved for triage
        expect(line).to_contain("timeout=0")  # oracle: an early death is NOT counted as a timeout
        expect(line).to_contain("inconclusive=1")  # oracle: infrastructure outcome, not a fabricated RED test result
        expect(line).to_contain("executed=0")  # oracle: nothing ran, so nothing may be claimed as executed

    it "keeps the real timeout verdict line unchanged":
        # @req REQ-RUNNER-CLASS-005
        # @capture(protocol_json): the unchanged outer-bound-timeout verdict line
        step("Render the genuine timeout verdict and confirm it still reads as a timeout")
        val line = timeout_verdict_line("spec.spl", "outer-bound-timeout", 930000)
        expect(line).to_contain("reason=outer-bound-timeout")  # oracle: a genuine timeout keeps its reason
        expect(line).to_contain("timeout=1")  # oracle: and is still counted as one
        expect(line).to_contain("budget_ms=930000")
