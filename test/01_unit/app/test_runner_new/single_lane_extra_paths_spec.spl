"""Extra spec paths must never be silently dropped by the single-file lane.

Audience: anyone editing `parse_child_run` in
`src/app/test_runner_new/test_runner_single.spl`.

Why this spec exists (REPRODUCER). Measured 2026-08-27 on origin/main
@ 287cb32cd09: `bin/simple test --no-session-daemon a_spec.spl b_spec.spl`
ran only `a_spec.spl`, printed only its verdict, and exited 0 — even when
`b_spec.spl` was a genuinely FAILING spec. The default (session-daemon) lane
runs both and exits 1. `parse_child_run` kept only the first positional
argument (`if not arg.starts_with("-") and path == "": path = arg`) and let
every later one fall through the loop with no branch, no warning, and no
effect on the exit code.

Record: doc/08_tracking/bug/test_runner_single_lane_drops_extra_paths_2026-08-27.md

Assertions are ALGORITHMIC (parse result as a function of argv), never
wall-clock, so they are stable on a contended host.

# @req REQ-TESTRUNNER-SINGLE-LANE-NO-DROPPED-PATHS
"""

use std.spec.*

use app.test_runner_new.test_runner_single.{parse_child_run}

val SPEC_A: text = "test/01_unit/lib/std/common/text_helpers_spec.spl"
val SPEC_B: text = "test/01_unit/lib/std/common/collection_helpers_spec.spl"

describe "single-file lane: extra positional paths", :
    describe "the exact reported defect", :
        it "refuses two spec paths instead of running only the first", :
            val run = parse_child_run([SPEC_A, SPEC_B])
            assert_false(run.valid)

        it "names the path it would otherwise have dropped", :
            val run = parse_child_run([SPEC_A, SPEC_B])
            assert_contains(run.error, SPEC_B)

        it "still reports the first path so the operator sees both halves", :
            val run = parse_child_run([SPEC_A, SPEC_B])
            assert_equal(run.path, SPEC_A)

    describe "the single-path contract it must not break", :
        it "accepts exactly one existing spec path", :
            val run = parse_child_run([SPEC_A])
            assert_true(run.valid)

        it "accepts one path alongside the flags real callers pass", :
            val run = parse_child_run([SPEC_A, "--timeout", "60", "--sequential"])
            assert_true(run.valid)
