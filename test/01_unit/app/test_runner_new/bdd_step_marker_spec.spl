"""
## Purpose and audience
`step(description)` is the manual-only scenario marker consumed by
spipe-docgen; at run time it is a pure no-op. This spec pins that contract
for test-runner and spipe-docgen maintainers: the interpreted BDD path used
to raise `semantic: function `step` not found` for every example calling
it, which failed 222 of the 377 app/os specs in the 2026-08-31 suite.
## Operator workflow
Run this file from the repo root with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/app/test_runner_new/bdd_step_marker_spec.spl`.
Each scenario renders a step fixture through the docgen generator and
asserts on the produced manual structure.
## Compatibility and limitations
Covers the docgen-rendered contract of the `step` marker and its
interpreted-BDD no-op behaviour; compiled-mode rendering and the docgen CLI
live in the spipe-docgen specs. Fixture sources are local strings, no
filesystem access.
## Verification guidance and troubleshooting
A red scenario here means the step marker no longer resolves, is no longer
a no-op, or the renderer dropped or mangled the label. Re-run the file and
compare the rendered fixture in the failing scenario against its pinned
expectation before touching the oracle.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: bdd-step-marker

use app.spipe_docgen.generator.{extract_test_structure, extract_scenario_list}

describe "spec step marker":
    it "renders a resolved step label as a no-op marker":
        # @req REQ-SSPEC-STEP-001
        # @capture(statistics): rendered manual structure for the step fixture
        step("Render a labeled step through the docgen generator")
        val source = "describe \"Step marker\":\n    it \"operator marks progress\":\n        step(\"Verify the marker resolves\")\n        expect(\"ok\").to_equal(\"ok\")\n"
        val structure = extract_test_structure(source)
        expect(structure).to_contain("- Verify the marker resolves")

    it "keeps an empty step description from breaking the manual flow":
        # @req REQ-SSPEC-STEP-001
        # @capture(statistics): rendered manual structure for the empty-label fixture
        step("Render an empty step description through the docgen generator")
        val source = "describe \"Empty step\":\n    it \"operator runs the flow\":\n        step(\"\")\n        expect(\"done\").to_equal(\"done\")\n"
        val structure = extract_test_structure(source)
        expect(structure).to_contain("- step")
        expect(structure.contains("invalid step metadata")).to_equal(false)

    it "counts three step calls inside one example as a single scenario":
        # @req REQ-SSPEC-STEP-001
        # @capture(statistics): scenario list for the multi-step fixture
        step("Count a multi-step scenario once in the scenario list")
        val source = "describe \"Counting\":\n    it \"operator walks three phases\":\n        step(\"first\")\n        step(\"second\")\n        step(\"third\")\n        expect(\"walked\").to_equal(\"walked\")\n"
        val scenarios = extract_scenario_list(source)
        expect(scenarios.len()).to_equal(1)  # oracle: step() is a marker, not an example boundary — three calls stay one scenario
