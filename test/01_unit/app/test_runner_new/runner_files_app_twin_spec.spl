use std.spec.*
use std.test_runner.test_runner_types.{TestLevel}
use app.test_runner_new.test_runner_files.{is_test_file, is_skip_marker_file, matches_level, shuffle_files, simple_hash}

# Coverage for the app twin src/app/test_runner_new/test_runner_files.spl.
# The twin is not imported by any production module; these examples pin the
# behaviour it would have if it were used. The two examples tagged KNOWN BUG
# are expected to FAIL: the twin's matches_level / is_test_file were never
# updated to the lib version (numbered test/01_unit tree, dotfile rejection).
# @req REQ-TESTRUNNER-DISCOVERY-COVERAGE

describe "app twin is_test_file":
    it "accepts a _spec.spl file":
        expect(is_test_file("test/01_unit/a_spec.spl")).to_equal(true)
    it "rejects a plain helper .spl file":
        expect(is_test_file("test/01_unit/helper.spl")).to_equal(false)
    it "rejects a .spl.skip marker":
        expect(is_test_file("test/01_unit/a_spec.spl.skip")).to_equal(false)
    it "KNOWN BUG: rejects a dotfile spec like the lib version":
        expect(is_test_file("test/01_unit/.a_spec.spl")).to_equal(false)

describe "app twin is_skip_marker_file":
    it "accepts a spec .spl.skip marker":
        expect(is_skip_marker_file("test/a_spec.spl.skip")).to_equal(true)
    it "rejects a normal spec":
        expect(is_skip_marker_file("test/a_spec.spl")).to_equal(false)

describe "app twin matches_level":
    it "All matches any path":
        expect(matches_level("src/x_spec.spl", TestLevel.All)).to_equal(true)
    it "Unit matches the bare unit directory":
        expect(matches_level("test/unit/x_spec.spl", TestLevel.Unit)).to_equal(true)
    it "Integration matches the bare integration directory":
        expect(matches_level("test/integration/x_spec.spl", TestLevel.Integration)).to_equal(true)
    it "System matches the bare system directory":
        expect(matches_level("test/system/x_spec.spl", TestLevel.System)).to_equal(true)
    it "Smoke matches the numbered smoke directory":
        expect(matches_level("test/04_smoke/x_spec.spl", TestLevel.Smoke)).to_equal(true)
    it "KNOWN BUG: Unit matches the numbered test/01_unit tree":
        expect(matches_level("test/01_unit/x_spec.spl", TestLevel.Unit)).to_equal(true)
    it "KNOWN BUG: Integration matches the numbered test/02_integration tree":
        expect(matches_level("test/02_integration/x_spec.spl", TestLevel.Integration)).to_equal(true)
    it "KNOWN BUG: System matches the numbered test/03_system tree":
        expect(matches_level("test/03_system/x_spec.spl", TestLevel.System)).to_equal(true)

describe "app twin shuffle_files":
    it "is deterministic for a fixed seed":
        val files = ["a_spec.spl", "b_spec.spl", "c_spec.spl"]
        expect(shuffle_files(files, 3)).to_equal(shuffle_files(files, 3))
    it "simple_hash is stable for the same input":
        expect(simple_hash("a_spec.spl", 1)).to_equal(simple_hash("a_spec.spl", 1))
