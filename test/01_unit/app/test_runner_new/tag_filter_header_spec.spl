use std.spec.*
use std.test_runner.test_runner_files.{content_has_tag}

describe "test runner --tag matching":
    it "matches the it-level tag: argument":
        expect(content_has_tag("it \"x\", tag: \"slow\":\n", "slow")).to_equal(true)
    it "matches the documented '# @tag' header directive":
        expect(content_has_tag("# @slow\ndescribe \"S\":\n", "slow")).to_equal(true)
    it "matches the in-development header form":
        expect(content_has_tag("# @tag:" + "in-development\n# Tracks: x\n", "in-development")).to_equal(true)
    it "matches the #[tag(...)] decorator":
        expect(content_has_tag("#[tag(\"slow\")]\n", "slow")).to_equal(true)
    it "does not match a different tag or a prefix":
        expect(content_has_tag("# @slower\n", "slow")).to_equal(false)
        expect(content_has_tag("describe \"slow\":\n", "slow")).to_equal(false)
