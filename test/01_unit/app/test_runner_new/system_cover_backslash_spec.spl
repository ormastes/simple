# Windows backslash paths must not skip the system-spec @cover admission check.
# Bug: windows_system_spec_cover_check_backslash_path_2026_11_03
use std.spec.*
use std.test_runner.test_runner_files.{validate_system_test_covers}

fn win(parts: [text]) -> text:
    val bs = "\\"
    parts.join(bs)

describe "validate_system_test_covers path separators":
    it "flags a forward-slash system spec without @cover":
        val missing = validate_system_test_covers(["test/system/no_such_cover_a_spec.spl"])
        expect(missing.len()).to_equal(1)

    it "flags a backslash system spec without @cover":
        val missing = validate_system_test_covers([win(["test", "system", "no_such_cover_b_spec.spl"])])
        expect(missing.len()).to_equal(1)

    it "flags a backslash 03_system spec without @cover":
        val missing = validate_system_test_covers([win(["test", "03_system", "no_such_cover_c_spec.spl"])])
        expect(missing.len()).to_equal(1)

    it "still skips backslash helpers and fixtures":
        val missing = validate_system_test_covers([win(["test", "system", "helpers", "h.spl"]), win(["test", "system", "fixtures", "f.spl"])])
        expect(missing.len()).to_equal(0)

    it "ignores non-system backslash paths":
        val missing = validate_system_test_covers([win(["test", "unit", "x_spec.spl"])])
        expect(missing.len()).to_equal(0)
