# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-LIB
# bug: doc/08_tracking/bug/spec_harness_module_global_mutation_via_function_invisible_2026-08-07.md
#
# Regression lock: a module-level `var` mutated by a called `fn` (rather than
# assigned inline in the `it` block) must read back correctly inside the
# `bin/simple test` spec harness. The original report found both a plain i64
# scalar and a Dict bracket-write invisible after a helper-function mutation,
# with the same source reading back correctly under plain `bin/simple run`.

use std.spec

var _g_scalar: i64 = 0
var _g_dict: Dict<text, i64> = {}

fn _bump_scalar():
    _g_scalar = _g_scalar + 1

fn _write_dict():
    _g_dict["hits"] = 7

describe "spec harness sees module-global mutation performed inside a called function":
    it "a plain i64 global mutated via a helper fn reads back correctly":
        _bump_scalar()
        expect(_g_scalar).to_equal(1)

    it "a Dict global mutated via a helper fn (bracket-assign) reads back correctly":
        _write_dict()
        expect(_g_dict["hits"]).to_equal(7)
