# Coverage admission preserves failed files while independent tests keep running.
use std.spec.*
use app.test_runner_new.cover_admission.{cover_admitted_files, cover_append_failures}
use std.test_runner.test_runner_types.{TestFileResult, TestRunResult, classify_test_run_result, test_run_outcome_exit_code}

fn empty_cover_run() -> TestRunResult:
    TestRunResult(files: [], total_passed: 0, total_failed: 0, total_skipped: 0,
        total_pending: 0, total_timed_out: 0, total_duration_ms: 0,
        total_setup_ms: 0, total_cached: 0)

describe "coverage admission failures":
    it "preserves discovery order and excludes only rejected files":
        val admitted = cover_admitted_files(["z.spl", "bad.spl", "a.spl"], ["bad.spl"])
        expect(admitted).to_equal(["z.spl", "a.spl"])

    it "reports an all rejected selection as named failures, not an empty run":
        val result = cover_append_failures(empty_cover_run(), ["bad.spl", "other.spl"])
        expect(result.files.len()).to_equal(2)
        expect(result.total_failed).to_equal(2)
        expect(result.total_passed).to_equal(0)
        expect(result.files[0].path).to_equal("bad.spl")
        expect(result.files[0].error).to_contain("test not executed")
        expect(result.files[0].cached).to_equal(false)
        expect(test_run_outcome_exit_code(classify_test_run_result(result, false))).to_equal(1)

    it "retains executed results and timings when adding admission failures":
        val row = TestFileResult(path: "good.spl", passed: 2, failed: 0, skipped: 0,
            pending: 0, duration_ms: 7, setup_ms: 3, error: "", timed_out: false, cached: false)
        val executed = TestRunResult(files: [row], total_passed: 2, total_failed: 0,
            total_skipped: 0, total_pending: 0, total_timed_out: 0,
            total_duration_ms: 7, total_setup_ms: 3, total_cached: 0)
        val result = cover_append_failures(executed, ["bad.spl"])
        expect(result.files.len()).to_equal(2)
        expect(result.files[0].passed).to_equal(2)
        expect(result.files[1].failed).to_equal(1)
        expect(result.total_passed).to_equal(2)
        expect(result.total_failed).to_equal(1)
        expect(result.total_duration_ms).to_equal(7)
        expect(result.total_setup_ms).to_equal(3)
        expect(test_run_outcome_exit_code(classify_test_run_result(result, false))).to_equal(1)

    it "keeps clean selections unchanged":
        val result = cover_append_failures(empty_cover_run(), [])
        expect(result.files.len()).to_equal(0)
        expect(result.total_failed).to_equal(0)
        expect(cover_admitted_files(["a.spl"], [])).to_equal(["a.spl"])
