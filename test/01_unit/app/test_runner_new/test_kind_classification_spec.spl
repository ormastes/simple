"""Test-kind classification: the runner must know all 4 kinds.

Audience: anyone editing `std.test_runner.test_level_detect` or the
`--unit/--integration/--system` flags of the runner.

The 4 kinds are the numbered tiers in test/FILE.md: unit, integration, system,
smoke. Today the classifier recognises three; `04_smoke` is documented in
test_level_detect.spl as "stays unclassified (0)", and `TestLevel` has no
Smoke variant. These specs define the target: smoke is level code 4 and
`--smoke` selects it.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_level_detect.{test_level_of_path, test_level_matches}
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{TestLevel}

describe "test kind classification by path":
    it "classifies the unit tier as 1":
        expect(test_level_of_path("test/01_unit/a/x_spec.spl")).to_equal(1)
    it "classifies the integration tier as 2":
        expect(test_level_of_path("test/02_integration/a/x_spec.spl")).to_equal(2)
    it "classifies the system tier as 3":
        expect(test_level_of_path("test/03_system/a/x_spec.spl")).to_equal(3)
    it "classifies the smoke tier as 4":
        expect(test_level_of_path("test/04_smoke/a/x_spec.spl")).to_equal(4)

describe "smoke classification edges":
    it "recognises the bare smoke segment like the other bare mirrors":
        expect(test_level_of_path("test/smoke/x_spec.spl")).to_equal(4)
    it "does not treat a substring as smoke":
        expect(test_level_of_path("test/01_unit/smokestack/x_spec.spl")).to_equal(1)
    it "matches smoke only for level code 4":
        expect(test_level_matches("test/04_smoke/x_spec.spl", 4)).to_equal(true)
        expect(test_level_matches("test/04_smoke/x_spec.spl", 1)).to_equal(false)
    it "keeps perf unclassified":
        expect(test_level_of_path("test/05_perf/x_spec.spl")).to_equal(0)

describe "level flags":
    it "maps --smoke to TestLevel.Smoke":
        val opts = parse_test_args(["--smoke"])
        expect(opts.level == TestLevel.Smoke).to_equal(true)
    it "still maps --system to TestLevel.System":
        val opts = parse_test_args(["--system"])
        expect(opts.level == TestLevel.System).to_equal(true)
