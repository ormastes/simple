# @req REQ-TESTRUNNER-SMF-COMPILE-DEGRADE
# The coverage abort ("ABORTED BEFORE EXECUTION ... Compiler diagnostic: X")
# and the SMF degrade token both name ONE line of the child compile output.
# The picker took the first line merely CONTAINING "error", so a seed
# `[jit-fallback] HIR lowering error: ...` advisory (the module just ran on the
# interpreter) or a lint `warning:` masked the line that actually stopped the
# build -- measured 2026-10-19 on `simple test <dir> --coverage`, where the real
# fatal was `SCV-E-ADMISSION: git-event-refresh-failed`, printed last.
use std.spec.*
use std.test_runner.test_runner_execute.{smf_compile_degrade_token}

val SCV_ADMISSION_OUTPUT: text = "\nWARNING: this Rust-built Simple binary is a bootstrap seed only; do not use it as the normal tool.\nBuild and use the pure-Simple bin/simple instead.\n[jit-fallback] HIR lowering error: Cannot infer field type: struct 'TextSpan' field 'end' (declared fields: value, start, len) [in src/app/cli/native_build_main.spl]: whole module dropped to the interpreter\nwarning: Avoid 'export use *' - exposes unnecessary interfaces\nworkarounds: incomplete coverage; run simple check-dbs --fullscan bugs\nSCV-E-ADMISSION: git-event-refresh-failed"
val SEMANTIC_AFTER_ADVISORY: text = "[jit-fallback] HIR lowering error: Cannot infer field type\nerror: semantic: invalid assignment: field assignment target is not a place"

describe "compile diagnostic line choice":
    it "names the SCV admission failure, not the jit-fallback advisory before it":
        val token = smf_compile_degrade_token(SCV_ADMISSION_OUTPUT)
        expect(token).to_contain("SCV-E-ADMISSION")
        expect(token).to_not_contain("jit-fallback")

    it "prefers an `error:` line over a bracket-tagged advisory that mentions error":
        val token = smf_compile_degrade_token(SEMANTIC_AFTER_ADVISORY)
        expect(token).to_contain("field_assignment_target")
        expect(token).to_not_contain("jit-fallback")
