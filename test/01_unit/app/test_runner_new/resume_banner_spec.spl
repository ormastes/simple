use std.spec.*
use std.test_runner.checkpoint.{TestCheckpoint, checkpoint_resume_banner, make_empty_checkpoint}

describe "--resume banner":
    it "says so when no checkpoint exists, instead of silently running everything":
        val banner = checkpoint_resume_banner(false, make_empty_checkpoint())
        expect(banner.contains("no checkpoint found")).to_be_true()
    it "reports the loaded progress, the shutdown reason and the skipped file count":
        val ckpt = TestCheckpoint(timestamp_ms: 1, completed_files: ["a_spec.spl"], total_passed: 3, total_failed: 1, total_skipped: 2, shutdown_reason: "memory")
        val banner = checkpoint_resume_banner(true, ckpt)
        expect(banner.contains("reason: memory")).to_be_true()
        expect(banner.contains("3 passed, 1 failed, 2 skipped")).to_be_true()
        expect(banner.contains("1 completed file(s)")).to_be_true()
