"""macOS inherits its existing per-UID limit while preserving other safe caps.

# @req REQ-TESTRUNNER-MACOS-PROCESS-CAPS
"""

use std.spec.*
use std.nogc_sync_mut.test_runner.resource_policy.{test_default_max_procs, test_max_procs_value_valid, safe_mode_caps}

describe "macOS test process policy":
    it "inherits the desktop UID process limit":
        expect(test_default_max_procs(true)).to_equal(0)
        expect(test_default_max_procs(false)).to_equal(4096)

    it "keeps memory CPU and descriptor caps when inheriting the process cap":
        val caps = safe_mode_caps(false, test_default_max_procs(true))
        expect(caps.0).to_equal(536870912)
        expect(caps.1).to_equal(30)
        expect(caps.2).to_equal(256)
        expect(caps.3).to_equal(0)

    it "honors an explicit process limit without replacing it with 64":
        expect(safe_mode_caps(false, 8192).3).to_equal(8192)
        expect(safe_mode_caps(true, 8192)).to_equal((0, 0, 0, 0))

    it "accepts only representable nonnegative integer process limits":
        for value in ["0", "64", "8192", "9223372036854775807"]:
            expect(test_max_procs_value_valid(value)).to_equal(true)
        for value in ["", "-1", "+1", "1.5", "abc", " 64", "9223372036854775808"]:
            expect(test_max_procs_value_valid(value)).to_equal(false)
