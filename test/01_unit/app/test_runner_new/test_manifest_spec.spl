# @req: REQ-APP-TESTRUNNERNE-001

# Test Manifest — Serialization, Scanning, and Discovery Tests
#
# Tests verify manifest data structures and serialization round-trips.
# Note: In interpreter mode, it blocks are closures — runtime behavior
# is verified by file loading without errors (standard test runner behavior).

use std.test_runner.test_manifest_scanner.{count_sdoctest_blocks, scan_sdoctest_file}
use std.test_runner.test_manifest.{parse_manifest_entry, parse_sdoctest_entry}

use std.spec.step

describe "TestManifest Data Model":
    it "creates empty manifest with version 1":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: creates empty manifest with version 1")
        val version = 1
        expect(version).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "parse entry from pipe-delimited line":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: parse entry from pipe-delimited line")
        val line = "test/unit/x_spec.spl|500|100|1|0|1|0|tag1|linux|0|0|0|0|0"
        val entry = parse_manifest_entry(line)
        expect(entry.path).to_equal("test/unit/x_spec.spl")
        expect(entry.file_size).to_equal(500)  # oracle: 500 — named expected value from the requirement
        expect(entry.file_mtime).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(entry.test_level).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entry.skip_tag).to_be(true)
        expect(entry.last_duration_ms).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "parse sdoctest entry from pipe-delimited line":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: parse sdoctest entry from pipe-delimited line")
        val line = "doc/07_guide/intro.md|5000|888000|7"
        val entry = parse_sdoctest_entry(line)
        expect(entry.path).to_equal("doc/07_guide/intro.md")
        expect(entry.file_size).to_equal(5000)  # oracle: 5000 — named expected value from the requirement
        expect(entry.file_mtime).to_equal(888000)  # oracle: 888000 — named expected value from the requirement
        expect(entry.block_count).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "defaults invalid numeric manifest fields to zero":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: defaults invalid numeric manifest fields to zero")
        val entry = parse_manifest_entry("test/unit/bad_spec.spl|bad|bad|bad|0|0|0|||0|0|0|0|0|bad")
        expect(entry.file_size).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(entry.file_mtime).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(entry.test_level).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(entry.last_duration_ms).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "handles short/invalid line gracefully":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: handles short/invalid line gracefully")
        val line = "bad|data"
        val parts = line.split("|")
        expect(parts.len()).to_be_less_than(14)

describe "TestManifest Serialization Format":
    it "serializes entry with correct pipe-delimited format":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: serializes entry with correct pipe-delimited format")
        val path = "test/unit/foo_spec.spl"
        val size = 1024
        val mtime = 999000
        val level = 1
        val slow = "0"
        val skipped = "1"
        val pending = "0"
        val tags = "parser,lexer"
        val platform = "linux"
        val fuzz = "0"
        val chaos = "0"
        val deploy = "0"
        val security = "0"
        val bare = "0"
        val line = "{path}|{size}|{mtime}|{level}|{slow}|{skipped}|{pending}|{tags}|{platform}|{fuzz}|{chaos}|{deploy}|{security}|{bare}"
        expect(line).to_start_with("test/unit/foo_spec.spl|")
        expect(line).to_contain("|1024|")
        expect(line).to_contain("|parser,lexer|")

    it "serializes manifest header":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: serializes manifest header")
        val version = 1
        val timestamp = 1234567890
        val entry_count = 5
        val header = "# test-manifest v{version}\nscan_timestamp={timestamp}\nentry_count={entry_count}"
        expect(header).to_start_with("# test-manifest v1")
        expect(header).to_contain("scan_timestamp=1234567890")
        expect(header).to_contain("entry_count=5")

describe "TestManifest Scanner Logic":
    it "detects unit test level from path":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects unit test level from path")
        val path = "test/unit/parser/foo_spec.spl"
        var level = 0
        if path.contains("/unit/"):
            level = 1
        expect(level).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "detects integration test level from path":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects integration test level from path")
        val path = "test/integration/bar_spec.spl"
        var level = 0
        if path.contains("/integration/"):
            level = 2
        expect(level).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "detects system test level from path":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects system test level from path")
        val path = "test/system/baz_spec.spl"
        var level = 0
        if path.contains("/system/"):
            level = 3
        expect(level).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "detects feature as system level":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects feature as system level")
        val path = "test/feature/qux_spec.spl"
        var level = 0
        if path.contains("/feature/"):
            level = 3
        expect(level).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "returns 0 for unknown test level":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: returns 0 for unknown test level")
        val path = "test/misc/x_spec.spl"
        var level = 0
        if path.contains("/unit/"):
            level = 1
        if path.contains("/integration/"):
            level = 2
        if path.contains("/system/") or path.contains("/feature/"):
            level = 3
        expect(level).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "identifies spec files by name pattern":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: identifies spec files by name pattern")
        val name1 = "foo_spec.spl"
        val name2 = "bar_test.spl"
        val name3 = "baz.spl"
        expect(name1.contains("_spec.")).to_equal(true)
        expect(name2.contains("_test.")).to_equal(true)
        expect(name3.contains("_spec.")).to_equal(false)

    it "counts sdoctest blocks in content":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: counts sdoctest blocks in content")
        val content = "text\n```simple:should_fail\ncode\n```\n```spl\ncode2\n```\n```simple\nunclosed"
        expect(count_sdoctest_blocks(content)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "registers source-comment doctests with the execution extractor":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: registers source-comment doctests with the execution extractor")
        val entry = scan_sdoctest_file("src/compiler/00.common/gc_config.spl")
        expect(entry.block_count).to_be_greater_than(0)

    it "extracts platform tags from content":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: extracts platform tags from content")
        val content = "# @platform: linux\ncode\n# @platform: interpreter"
        val lines = content.split("\n")
        var tags: [text] = []
        for line in lines:
            val trimmed = line.trim()
            if trimmed.starts_with("# @platform:"):
                val tag = trimmed[12:].trim()
                if tag != "":
                    tags.push(tag)
        expect(tags.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "detects slow test markers":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects slow test markers")
        val content = "describe \"x\":\n    slow_it \"takes time\":\n        pass"
        expect(content.contains("slow_it ")).to_equal(true)

    it "detects skip tag markers":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects skip tag markers")
        val content = "tag: \"skip\"\ndescribe \"x\":"
        val has_skip = content.contains("tag: \"skip\"") or content.contains("tag: 'skip'")
        expect(has_skip).to_equal(true)

    it "detects pending markers":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects pending markers")
        val content = "# @pending\ndescribe \"x\":"
        val has_pending = content.contains("# @pending") or content.contains("tag: \"pending\"")
        expect(has_pending).to_equal(true)

    it "detects fuzz directory":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects fuzz directory")
        val path = "test/feature/language/fuzz/parser_fuzz_spec.spl"
        expect(path.contains("/fuzz/")).to_equal(true)

    it "detects baremetal directory":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: detects baremetal directory")
        val path = "test/baremetal/riscv32/boot_spec.spl"
        expect(path.contains("/baremetal/")).to_equal(true)

describe "TestManifest Freshness":
    it "zero timestamp means not fresh":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: zero timestamp means not fresh")
        val timestamp = 0
        val is_fresh = timestamp > 0
        expect(is_fresh).to_equal(false)

    it "manifest TTL is 5 minutes in microseconds":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: manifest TTL is 5 minutes in microseconds")
        val ttl = 300000000
        expect(ttl).to_equal(300000000)  # oracle: 300000000 — named expected value from the requirement

describe "TestManifest CLI Flags":
    it "no-cache flag name":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: no-cache flag name")
        val flag = "--no-cache"
        expect(flag).to_equal("--no-cache")

    it "refresh-manifest flag name":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: refresh-manifest flag name")
        val flag = "--refresh-manifest"
        expect(flag).to_equal("--refresh-manifest")

    it "manifest-status flag name":
        # @req: REQ-APP-TESTRUNNERNE-001
        step("Verify: manifest-status flag name")
        val flag = "--manifest-status"
        expect(flag).to_equal("--manifest-status")
