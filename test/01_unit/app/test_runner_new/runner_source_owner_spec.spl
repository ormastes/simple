# Pin the defining modules used by the live test runner closure.
use std.io_runtime.{read_file_text}

describe "test runner source owners":
    it "imports daemon request and response tags from their defining types module":
        val client = read_file_text("src/app/test_daemon/client.spl")
        val types = read_file_text("src/app/test_daemon/types.spl")
        expect(client).to_contain("use app.test_daemon.types.{")
        expect(client.contains("use app.test_daemon.{")).to_equal(false)
        expect(types).to_contain("val TREQ_RUN_SINGLE: i64 = 1")
        expect(types).to_contain("val TRESP_COMPLETED: i64 = 2")

    it "resolves assurance profile names at their defining policy module":
        val config = read_file_text("src/lib/nogc_sync_mut/test_runner/test_runner_config.spl")
        val policy = read_file_text("src/compiler/00.common/assurance/policy_names.spl")
        expect(config).to_contain("use compiler.common.assurance.policy_names.{normalize_profile_name}")
        expect(config.contains("use std.test_runner.test_runner_args.{normalize_profile_name}")).to_equal(false)
        expect(policy).to_contain("pub fn normalize_profile_name(")

    it "imports the MC/DC evidence parser from the report gate":
        val report = read_file_text("src/lib/nogc_sync_mut/test_runner/test_runner_mcdc_report.spl")
        val gate = read_file_text("src/compiler/80.driver/driver_mcdc_report_gate.spl")
        expect(report).to_contain("driver_complete_mcdc_report, driver_parse_mcdc_runtime_evidence_v1")
        expect(gate).to_contain("pub fn driver_parse_mcdc_runtime_evidence_v1(")

    it "uses the existing file facades for dependency graph persistence and probes":
        val graph = read_file_text("src/app/test_dep_graph_shared.spl")
        expect(graph).to_contain("use std.io_runtime.{file_exists}")
        expect(graph).to_contain("use std.io_runtime.{file_write}")
        expect(graph).to_contain("file_write(self.graph_path, content)")
        expect(graph.split("file_exists(").len()).to_equal(4)
        expect(graph.contains("rt_file_exists(")).to_equal(false)
        expect(graph.contains("rt_file_write_text(")).to_equal(false)
