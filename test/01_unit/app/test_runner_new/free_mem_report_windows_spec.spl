"""Free-memory report works without /proc/meminfo (Windows host headroom).

# @req REQ-TESTRUNNER-WINDOWS-HEADROOM
"""

use std.spec.*
use std.nogc_sync_mut.test_runner.test_runner_config.{free_mem_report_line}

describe "free memory report line":
    it "uses MemAvailable when /proc/meminfo is readable":
        val meminfo = "MemTotal: 100 kB\nMemAvailable: 42 kB\n"
        expect(free_mem_report_line("X", meminfo, 0)).to_equal("[MEM] X: MemAvailable: 42 kB")

    it "falls back to host headroom bytes when /proc/meminfo is absent":
        expect(free_mem_report_line("START", "", 2147483648)).to_equal("[MEM] START: headroom 2048 MB")

    it "never reports an unreadable error when headroom is known":
        val line = free_mem_report_line("START", "", 1048576)
        expect(line.contains("could not read")).to_equal(false)

    it "reports unavailable (not an abort) when neither source works":
        expect(free_mem_report_line("START", "", 0)).to_equal("[MEM] START: (memory info unavailable)")
