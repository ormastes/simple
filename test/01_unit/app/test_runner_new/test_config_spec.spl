"""
## Purpose and audience
Purpose: Prove that TestConfig.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-RUNNER-NEW-001 — stable requirement identity for this spec.
# Test Configuration Loading Spec
#
# test_config lives in std.test_runner and resolves through the shared
# std.config core (std.common.config_core): schema defaults + workspace
# document + CI session override. The runner currently boots on compiled
# defaults (deterministic-startup gate in load_test_config_from_path), so
# CI-override behaviour is asserted on the resolution path directly.

use std.test_runner.test_config.{TestConfig, find_config_file, CONFIG_FILENAME}
use std.test_runner.test_config.{test_config_env_entries, test_config_resolve}
use app.io.env_ops.{env_set, env_get}
use std.spec.step


describe "TestConfig":
    context "default configuration":
        it "loads default values when config file not found":
            step("Verify: loads default values when config file not found")
            # @req: REQ-APP-TEST-RUNNER-NEW-001
            val config = TestConfig.defaults()
            expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement
            expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement
            expect(config.cpu_limit_seconds).to_equal(30)  # oracle: 30 — named expected value from the requirement

    context "test mode flags":
        it "defaults to running spec tests but not sdoctests":
            step("Verify: defaults to running spec tests but not sdoctests")
            val config = TestConfig.defaults()
            expect(config.run_spec_tests).to_equal(true)
            expect(config.run_sdoctests).to_equal(false)

        it "defaults to excluding slow tests":
            step("Verify: defaults to excluding slow tests")
            val config = TestConfig.defaults()
            expect(config.run_slow_tests == false).to_equal(true)

    context "CI mode (session layer)":
        it "detects CI mode from environment variable":
            step("Verify: detects CI mode from environment variable")
            val original_ci = env_get("CI") ?? ""
            env_set("CI", "true")
            val config = test_config_resolve(test_config_env_entries())
            expect(config.ci_mode).to_equal(true)
            env_set("CI", original_ci)

        it "includes slow tests when CI mode is active":
            step("Verify: includes slow tests when CI mode is active")
            val original_ci = env_get("CI") ?? ""
            env_set("CI", "true")
            val config = test_config_resolve(test_config_env_entries())
            expect(config.run_slow_tests).to_equal(true)
            env_set("CI", original_ci)

        it "disables fail_fast in CI mode":
            step("Verify: disables fail_fast in CI mode")
            val original_ci = env_get("CI") ?? ""
            env_set("CI", "true")
            val config = test_config_resolve(test_config_env_entries())
            expect(config.fail_fast == false).to_equal(true)
            env_set("CI", original_ci)

describe "TestConfig parsing":
    context "multi-level config search":
        it "finds config in current directory":
            step("Verify: finds config in current directory")
            val path = find_config_file()
            # Either found config/simple.test.sdn or returned empty string
            expect(path == "" or path.contains("simple.test.sdn")).to_equal(true)

        it "finds config in parent directory":
            step("Verify: finds config in parent directory")
            val path = find_config_file()
            # find_config_file searches current, parent, and grandparent
            expect(path == "" or path.ends_with(CONFIG_FILENAME)).to_equal(true)

        it "declares the canonical config filename":
            step("Verify: declares the canonical config filename")
            expect(CONFIG_FILENAME).to_equal("config/simple.test.sdn")
