"""
## Purpose and audience
Purpose: Pin directory-boundary matching for cached test discovery.
Audience: test runner maintainers.
## Operator workflow
Run with `simple test test/01_unit/app/test_runner_new/discovery_path_boundary_spec.spl`.
"""
use std.test_runner.test_runner_files.{path_is_within_directory}

describe "Cached test discovery directory boundaries":
    it "includes direct and nested specs under the requested directory":
        val root = "test/fixtures/test_runner_discovery/target"
        expect(path_is_within_directory("{root}/one_spec.spl", root)).to_equal(true)
        expect(path_is_within_directory("{root}/nested/two_spec.spl", root)).to_equal(true)

    it "normalizes a trailing separator and Windows separators":
        expect(path_is_within_directory("test\\fixtures\\test_runner_discovery\\target\\case_spec.spl", "test/fixtures/test_runner_discovery/target/")).to_equal(true)

    it "excludes a sibling directory that only shares the name prefix":
        val root = "test/fixtures/test_runner_discovery/target"
        expect(path_is_within_directory("{root}-shadow/leak_spec.spl", root)).to_equal(false)

    it "excludes a sibling file that only shares the name prefix":
        expect(path_is_within_directory("test/fixtures/test_runner_discovery/target-shadow_spec.spl", "test/fixtures/test_runner_discovery/target")).to_equal(false)
