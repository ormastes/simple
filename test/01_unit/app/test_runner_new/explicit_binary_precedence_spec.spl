"""An operator-named compiler binary must win over argv[0] in the test runner.

Audience: anyone editing `find_simple_binary` in
`src/lib/nogc_sync_mut/test_runner/test_executor_parsing.spl`.

Why this spec exists. Until 2026-10-10 `find_simple_binary` consulted argv[0]
BEFORE `SIMPLE_BINARY` / `SIMPLE_RUNTIME`, so a runner launched by one binary
ignored the binary the operator named. On Windows that combined with the
missing self-exe lookup to spawn children on the tracked `bin/simple.exe`,
which could not parse the stdlib at all.

Record: doc/08_tracking/bug/windows_tracked_seed_cannot_parse_release_stdlib_2026-10-10.md

`find_simple_binary` itself caches per process and reads the real argv, so the
precedence is pinned on the pure helpers it is built from.

# @req REQ-TESTRUNNER-EXPLICIT-BINARY-PRECEDENCE
"""

use std.spec.*

use std.test_runner.test_executor_parsing.{explicit_binary_before_argv0, argv0_simple_binary}

describe "explicit binary precedence", :
    it "prefers the operator-named binary over argv[0]", :
        expect(explicit_binary_before_argv0("C:/seed/simple.exe", "bin/simple.exe")).to_equal("C:/seed/simple.exe")

    it "falls back to argv[0] when nothing is named", :
        expect(explicit_binary_before_argv0("", "bin/simple.exe")).to_equal("bin/simple.exe")

    it "reports nothing when neither is available", :
        expect(explicit_binary_before_argv0("", "")).to_equal("")

describe "argv[0] as a binary candidate", :
    it "rejects a .spl source path", :
        expect(argv0_simple_binary("test/01_unit/app/test_runner_new/explicit_binary_precedence_spec.spl")).to_equal("")

    it "rejects a binary-shaped path that does not exist", :
        expect(argv0_simple_binary("no/such/dir/simple")).to_equal("")
