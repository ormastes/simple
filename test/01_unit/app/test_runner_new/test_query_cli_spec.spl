"""
## Purpose and audience
Requirement ids: the plan (sections 3.5 and 9.1) names TESTDB-001..010 without
defining each one; the per-id definitions are recorded in
test/01_unit/lib/common/traceability/test_query_spec.spl (001 exact query, 002
status variants, 003 provenance/missing identity, 004 pagination and rejected
queries, 005 read-only isolation, 006 failed query is an error not an empty
success, 007 retries stay separate, 008 non-executed never PASS, 009 CLI/MCP
parity, 010 requirement/bug-scoped queries: --bug, --requirement, --levels).

Executable contract for the read-only `simple test query` and `simple test
explain` subcommands. Argument parsing and rendering are pure functions over
domain types (limit, cursor, format, exit decision); the only I/O case opens a
scratch TestDB and proves the command never rewrites it.

Written for test-runner owners and for reviewers who must trust that a query
cannot change the evidence it reports on.

## Operator workflow
bin/simple test test/01_unit/app/test_runner_new/test_query_cli_spec.spl

## Verification guidance and troubleshooting
A failure in the read-only case means the query path saved, migrated or sealed
the database: check `open_test_db_read_only` in
src/app/test_runner_new/test_query_cli.spl.
"""
use std.spec.{describe, it, expect, step}
use std.database.test_extended.database.{TestDatabaseExtended}
use std.nogc_sync_mut.test_runner.test_db_compat.{RunnerTestDb}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_write, file_modified_time}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all, dir_list}
use std.common.traceability.case_events.{TraceCaseEvent, TraceCaseFacts, TestEventAtMicros, TestFailureSummary, TestHostTriple, TestBackendName}
use std.common.traceability.test_query.{
    TestLevel, TestCasePath, TestCaseName, TestCaseKey, TestRunId, TestQueryLimit, TestQueryCursor, TestQuery,
    TestQueryStatus, TestQualification, TestQueryRow, TestQueryPage, TestQueryTruncation,
    TestQueryCoverage, TestQueryError, TestQueryErrorKind, TestPlannedCaseIdentity,
    TestAttemptIdentity, TestAttemptOrdinal, TestEvidenceProvenance, TestPlannedCaseId
}
use app.traceability.test_query_scope_v1.{TestScopeBugDbPath}
use std.common.traceability.run_request.{TraceRunRequest}
use std.common.traceability.run_plan.{TracePlannedCase}
use app.test_runner_new.test_query_cli.{
    TestDbFilePath, TestQueryFormat, TestQueryCommand, TestQueryCliRequest, TestQueryExitDecision,
    parse_test_query_args, render_test_query_page, render_test_explain_page,
    render_test_query_outcome, test_query_exit_code, execute_test_query, execute_test_query_with_bug_db, TestQueryCliOutput,
    test_query_subcommand_args
}

val SCRATCH_DIR = "target/test-query-cli-spec"

fn _key() -> TestCaseKey:
    TestCaseKey(path: TestCasePath(value: "test/a_spec.spl"), name: TestCaseName(value: "adds"))

fn _row(status: TestQueryStatus, qualification: TestQualification, attempt: TestAttemptIdentity, planned: TestPlannedCaseIdentity) -> TestQueryRow:
    TestQueryRow(case_key: _key(), level: TestLevel.Other, run_id: TestRunId(value: "run_1"), planned_case: planned, attempt: attempt,
        status: status, qualification: qualification, provenance: TestEvidenceProvenance.UnverifiedFrameworkObservation)

fn _ordinal(n: i64) -> TestAttemptIdentity:
    TestAttemptIdentity.StreamOrder(ordinal: TestAttemptOrdinal(value: n))

fn _planned() -> TestPlannedCaseIdentity:
    TestPlannedCaseIdentity.Recorded(id: TestPlannedCaseId(value: "case_9"))

fn _page(rows: [TestQueryRow], truncation: TestQueryTruncation, coverage: TestQueryCoverage) -> TestQueryPage:
    TestQueryPage(rows: rows, truncation: truncation, coverage: coverage)

fn _request(args: [text]) -> TestQueryCliRequest:
    match parse_test_query_args(args):
        case Ok(request): request
        case Err(error): fail("fixture args rejected: {error.detail}")

fn _usage_error_of(args: [text]) -> text:
    match parse_test_query_args(args):
        case Ok(_): ""
        case Err(error): error.detail

describe "test query argument parsing":
    it "parses a case with run, limit, cursor and format":
        # @req TESTDB-001
        step("Parse a full query command line")
        val request = _request(["query", "test/a_spec.spl::adds", "--run", "run_7", "--limit", "5", "--cursor=10", "--format", "sdn"])
        step("Every typed field carries the supplied value")
        expect(request.query.case_key.path.value).to_equal("test/a_spec.spl")
        expect(request.query.case_key.name.value).to_equal("adds")
        expect(request.query.limit.value).to_equal(5)
        match request.query.run_id:
            case Some(run): expect(run.value).to_equal("run_7")
            case None: fail("run id was dropped")
        match request.query.cursor:
            case Some(cursor): expect(cursor.token).to_equal("10")
            case None: fail("cursor was dropped")
        match request.format:
            case TestQueryFormat.Sdn: pass
            case TestQueryFormat.Table: fail("format sdn parsed as table")

    it "defaults to table format, limit 50 and no run or cursor":
        # @req TESTDB-001
        step("Parse the minimal command line")
        val request = _request(["query", "test/a_spec.spl::adds"])
        expect(request.query.limit.value).to_equal(50)
        expect(request.query.run_id.?).to_equal(false)
        expect(request.query.cursor.?).to_equal(false)

    it "rejects a bad limit, a missing case separator and other malformed input":
        # @req TESTDB-004
        # @capture(statistics): usage error text for each malformed command line
        step("A non-numeric limit is a usage error naming the flag")
        expect(_usage_error_of(["query", "a::b", "--limit", "many"])).to_contain("--limit needs an integer")
        step("A missing :: separator is a usage error")
        expect(_usage_error_of(["query", "test/a_spec.spl"])).to_contain("missing '::'")
        step("An empty case name is rejected")
        expect(_usage_error_of(["query", "test/a_spec.spl::"])).to_contain("non-empty")
        step("An unknown format, unknown flag, missing value and missing case are rejected")
        expect(_usage_error_of(["query", "a::b", "--format", "xml"])).to_contain("table or sdn")
        expect(_usage_error_of(["query", "a::b", "--bogus", "1"])).to_contain("unknown flag")
        expect(_usage_error_of(["query", "a::b", "--run"])).to_contain("needs a value")
        expect(_usage_error_of(["query"])).to_contain("missing <path>::<case>")
        step("Explain takes no cursor")
        expect(_usage_error_of(["explain", "a::b", "--cursor", "3"])).to_contain("explain does not take --cursor")

    it "recognises only the query and explain subcommands":
        # @req TESTDB-001
        step("Plain test arguments are not claimed by the query facade")
        expect(test_query_subcommand_args(["query", "a::b"]).len() > 0).to_equal(true)
        expect(test_query_subcommand_args(["explain", "a::b"]).len() > 0).to_equal(true)
        expect(test_query_subcommand_args(["test/a_spec.spl"]).len() > 0).to_equal(false)
        expect(test_query_subcommand_args([]).len() > 0).to_equal(false)
        step("The dispatcher's leading `test` token is accepted, and a lone `test` or `test query` path-less call is not a subcommand run")
        expect(test_query_subcommand_args(["test", "query", "a::b"])).to_equal(["query", "a::b"])
        expect(test_query_subcommand_args(["test"]).len() > 0).to_equal(false)
        expect(test_query_subcommand_args(["test", "test/query_spec.spl"]).len() > 0).to_equal(false)

    it "parses --bug, --requirement and --levels into one scoped query":
        # @req TESTDB-010
        step("A bug scope carries its id, levels, run, limit and no exact case")
        val bug = _request(["query", "--bug", "b-1", "--levels", "unit,system", "--run", "run_1", "--limit", "7"])
        val scoped = bug.scoped.unwrap()
        expect(scoped.limit.value).to_equal(7)
        expect(scoped.levels.len()).to_equal(2)
        expect(bug.query.case_key.path.value).to_equal("scope:bug:b-1")
        step("A requirement scope uses the inline --flag=value form too")
        val requirement = _request(["explain", "--requirement=REQ-1"])
        expect(requirement.scoped.?).to_equal(true)
        expect(requirement.query.case_key.path.value).to_equal("scope:requirement:REQ-1")
        step("An exact case request is not scoped")
        expect(_request(["query", "a::b"]).scoped.?).to_equal(false)

    it "rejects contradictory or malformed scope flags":
        # @req TESTDB-010
        expect(_usage_error_of(["query", "a::b", "--bug", "b-1"])).to_contain("do not also give a <path>::<case>")
        expect(_usage_error_of(["query", "--bug", "b-1", "--requirement", "REQ-1"])).to_contain("mutually exclusive")
        expect(_usage_error_of(["query", "a::b", "--levels", "unit"])).to_contain("--levels needs --bug or --requirement")
        expect(_usage_error_of(["query", "--bug", "b-1", "--levels", "bogus"])).to_contain("unknown test level: bogus")
        expect(_usage_error_of(["query", "--bug="])).to_contain("--bug needs a non-empty bug id")
        expect(_usage_error_of(["query", "--limit", "5"])).to_contain("missing <path>::<case>")

describe "test query rendering":
    it "renders typed rows in table form with qualification":
        # @req TESTDB-002
        step("Render one failed and one passed attempt")
        val page = _page([
            _row(TestQueryStatus.Failed, TestQualification.NotPass, _ordinal(0), _planned()),
            _row(TestQueryStatus.Passed, TestQualification.Pass, _ordinal(1), _planned())],
            TestQueryTruncation.Complete, TestQueryCoverage.Full)
        val out = render_test_query_page(page, TestQueryFormat.Table)
        step("Each row states status and qualification; a complete page has no partial marker")
        expect(out).to_contain("run_1 | case_9 | 0 | failed | not_pass")
        expect(out).to_contain("run_1 | case_9 | 1 | passed | pass")
        expect(out).to_contain("rows: 2")
        expect(out.contains("partial")).to_equal(false)

    it "renders sdn form":
        # @req TESTDB-002
        step("Render one row as SDN")
        val page = _page([_row(TestQueryStatus.Passed, TestQualification.Pass, _ordinal(0), _planned())],
            TestQueryTruncation.Complete, TestQueryCoverage.Full)
        val out = render_test_query_page(page, TestQueryFormat.Sdn)
        expect(out).to_contain("test_query_rows |case, level, run, planned_case, attempt, status, qualification, provenance, started_at_micros, duration_micros, host, backend, failure|")
        expect(out).to_contain("    test/a_spec.spl::adds, other, run_1, case_9, 0, passed, pass")

    it "announces truncation with a partial marker and the next cursor":
        # @req TESTDB-004
        step("Render a truncated page")
        val page = _page([_row(TestQueryStatus.Passed, TestQualification.Pass, _ordinal(0), _planned())],
            TestQueryTruncation.Truncated(next: TestQueryCursor(token: "tq1:abc:1")), TestQueryCoverage.Full)
        val out = render_test_query_page(page, TestQueryFormat.Table)
        step("The cut is never silent")
        expect(out).to_contain("partial: truncated")
        expect(out).to_contain("next cursor: tq1:abc:1")

    it "marks unfinished or identity-less attempts as partial":
        # @req TESTDB-003 TESTDB-004
        step("Render a partial-coverage page with a missing attempt identity")
        val page = _page([_row(TestQueryStatus.Passed, TestQualification.Pass, TestAttemptIdentity.Missing, TestPlannedCaseIdentity.Missing)],
            TestQueryTruncation.Complete, TestQueryCoverage.Partial)
        val out = render_test_query_page(page, TestQueryFormat.Sdn)
        expect(out).to_contain("partial: some attempts")
        expect(out).to_contain("missing, passed")

describe "test explain":
    it "explains why a passed attempt qualifies and a skipped one does not":
        # @req TESTDB-002
        step("Explain a passed and a skipped attempt")
        val page = _page([
            _row(TestQueryStatus.Passed, TestQualification.Pass, _ordinal(0), _planned()),
            _row(TestQueryStatus.Skipped, TestQualification.NotPass, _ordinal(1), _planned())],
            TestQueryTruncation.Complete, TestQueryCoverage.Full)
        val out = render_test_explain_page(page)
        expect(out).to_contain("status=passed")
        expect(out).to_contain("qualifies as PASS")
        expect(out).to_contain("status=skipped")
        expect(out).to_contain("does not qualify: skipped means the case did not execute")
        expect(out).to_contain("identity: complete")

    it "never qualifies cached, blocked or unknown statuses":
        # @req TESTDB-002
        step("Explain cached, blocked and unrecognised attempts")
        val page = _page([
            _row(TestQueryStatus.Cached, TestQualification.NotPass, _ordinal(0), _planned()),
            _row(TestQueryStatus.Blocked, TestQualification.NotPass, _ordinal(1), _planned()),
            _row(TestQueryStatus.Unknown(raw: "weird"), TestQualification.NotPass, _ordinal(2), _planned())],
            TestQueryTruncation.Complete, TestQueryCoverage.Full)
        val out = render_test_explain_page(page)
        expect(out).to_contain("a cached result was reused")
        expect(out).to_contain("blocked means execution was prevented")
        expect(out).to_contain("unrecognised status 'weird' is never PASS")
        expect(out.contains("qualifies as PASS")).to_equal(false)

    it "says explicitly when identity fields are missing":
        # @req TESTDB-003
        step("Explain an attempt with neither planned case nor attempt identity")
        val page = _page([_row(TestQueryStatus.Passed, TestQualification.Pass, TestAttemptIdentity.Missing, TestPlannedCaseIdentity.Missing)],
            TestQueryTruncation.Complete, TestQueryCoverage.Partial)
        val out = render_test_explain_page(page)
        expect(out).to_contain("identity missing: planned case id missing")
        expect(out).to_contain("attempt identity missing")

describe "test query exit decisions":
    it "maps outcomes to the documented exit codes":
        # @req TESTDB-004
        step("Rows found is 0, no rows is 1, usage and unreadable store are 2")
        val request = _request(["query", "test/a_spec.spl::adds"])
        val found = render_test_query_outcome(request, Ok(_page([_row(TestQueryStatus.Passed, TestQualification.Pass, _ordinal(0), _planned())], TestQueryTruncation.Complete, TestQueryCoverage.Full)))
        expect(test_query_exit_code(found.decision).value).to_equal(0)
        val empty = render_test_query_outcome(request, Ok(_page([], TestQueryTruncation.Complete, TestQueryCoverage.Full)))
        expect(test_query_exit_code(empty.decision).value).to_equal(1)
        expect(empty.text).to_contain("no rows")
        val unreadable = render_test_query_outcome(request, Err(TestQueryError(kind: TestQueryErrorKind.StoreUnreadable, detail: "boom")))
        expect(test_query_exit_code(unreadable.decision).value).to_equal(2)
        expect(unreadable.text).to_contain("test database unreadable: boom")
        val unknown_run = render_test_query_outcome(request, Err(TestQueryError(kind: TestQueryErrorKind.UnknownRun, detail: "run not found: x")))
        expect(test_query_exit_code(unknown_run.decision).value).to_equal(2)

describe "test query against a real database file":
    it "leaves the database, its wal and its directory byte-for-byte unchanged":
        # @req TESTDB-001 TESTDB-005
        step("Save a scratch database with one run of the queried case")
        dir_remove_all(SCRATCH_DIR)
        dir_create_all(SCRATCH_DIR)
        val db_path = SCRATCH_DIR + "/test_db.sdn"
        var owner = RunnerTestDb(db: TestDatabaseExtended.create(db_path), current_run_id: "")
        val run_id = owner.start_run()
        match owner.db.record_trace_case_events(run_id, "test/a_spec.spl", [TraceCaseEvent("adds", "started", "not_finished"), TraceCaseEvent("adds", "finished", "passed")]):
            case Ok(_): pass
            case Err(reason): fail("fixture events rejected: {reason}")
        match owner.save():
            case Ok(_): pass
            case Err(reason): fail("fixture save failed: {reason}")
        val bytes_before = file_read(db_path)
        val mtime_before = file_modified_time(db_path)
        expect(bytes_before.len() > 0).to_equal(true)
        expect(mtime_before > 0).to_equal(true)
        val listing_before = dir_list(SCRATCH_DIR)
        val wal_before = file_exists(db_path + ".wal")
        step("Run query and explain through the real command path")
        val query_out = execute_test_query(_request(["query", "test/a_spec.spl::adds"]), TestDbFilePath(value: db_path))
        val explain_out = execute_test_query(_request(["explain", "test/a_spec.spl::adds"]), TestDbFilePath(value: db_path))
        expect(test_query_exit_code(query_out.decision).value).to_equal(0)
        expect(query_out.text).to_contain("passed | pass")
        expect(explain_out.text).to_contain("qualifies as PASS")
        step("Bytes, mtime, wal presence and directory listing are all unchanged")
        expect(file_read(db_path) == bytes_before).to_equal(true)
        expect(file_modified_time(db_path)).to_equal(mtime_before)
        expect(file_exists(db_path + ".wal")).to_equal(wal_before)
        expect(dir_list(SCRATCH_DIR).len()).to_equal(listing_before.len())
        dir_remove_all(SCRATCH_DIR)

    it "reports a missing or corrupt database as exit 2 and creates nothing":
        # @req TESTDB-004 TESTDB-006
        step("A missing database is a typed error and is not cold-started")
        dir_remove_all(SCRATCH_DIR)
        dir_create_all(SCRATCH_DIR)
        val missing = TestDbFilePath(value: SCRATCH_DIR + "/absent.sdn")
        val request = _request(["query", "test/a_spec.spl::adds"])
        val absent = execute_test_query(request, missing)
        expect(test_query_exit_code(absent.decision).value).to_equal(2)
        expect(absent.text).to_contain("no test database at")
        expect(file_exists(missing.value)).to_equal(false)
        step("An empty (corrupt) database file is exit 2 with typed text and stays untouched")
        val corrupt = TestDbFilePath(value: SCRATCH_DIR + "/corrupt.sdn")
        expect(file_write(corrupt.value, "")).to_equal(true)
        val broken = execute_test_query(request, corrupt)
        expect(test_query_exit_code(broken.decision).value).to_equal(2)
        expect(broken.text).to_contain("test database unreadable")
        expect(file_read(corrupt.value)).to_equal("")
        dir_remove_all(SCRATCH_DIR)

describe "test query cursor binding":
    it "pages with an opaque cursor and rejects plain integers, tampering and another query":
        # @req TESTDB-004
        step("Save a scratch database with three attempts of one case")
        dir_remove_all(SCRATCH_DIR)
        dir_create_all(SCRATCH_DIR)
        val db_path = SCRATCH_DIR + "/test_db.sdn"
        var owner = RunnerTestDb(db: TestDatabaseExtended.create(db_path), current_run_id: "")
        val run_id = owner.start_run()
        var events: [TraceCaseEvent] = []
        for i in 0..3:
            events.push(TraceCaseEvent("adds", "started", "not_finished"))
            events.push(TraceCaseEvent("adds", "finished", "passed"))
        match owner.db.record_trace_case_events(run_id, "test/a_spec.spl", events):
            case Ok(_): pass
            case Err(reason): fail("fixture events rejected: {reason}")
        match owner.save():
            case Ok(_): pass
            case Err(reason): fail("fixture save failed: {reason}")
        val path = TestDbFilePath(value: db_path)
        step("Page one announces an opaque next cursor")
        val first = execute_test_query(_request(["query", "test/a_spec.spl::adds", "--limit", "1"]), path)
        expect(test_query_exit_code(first.decision).value).to_equal(0)
        val marker = "next cursor: "
        val at = first.text.index_of(marker) ?? -1
        expect(at >= 0).to_equal(true)
        val rest = first.text.substring(at + marker.byte_len(), first.text.byte_len())
        val token = (rest.split(" "))[0].trim()
        expect(token.starts_with("tq1:")).to_equal(true)
        step("Feeding the token back returns the next page with exit 0")
        val second = execute_test_query(_request(["query", "test/a_spec.spl::adds", "--limit", "1", "--cursor", token]), path)
        expect(test_query_exit_code(second.decision).value).to_equal(0)
        step("A plain integer cursor is a usage-class error, exit 2")
        val plain = execute_test_query(_request(["query", "test/a_spec.spl::adds", "--limit", "1", "--cursor", "1"]), path)
        expect(test_query_exit_code(plain.decision).value).to_equal(2)
        expect(plain.text).to_contain("invalid query")
        step("A tampered token is exit 2")
        val tampered = execute_test_query(_request(["query", "test/a_spec.spl::adds", "--limit", "1", "--cursor", token + "9"]), path)
        expect(test_query_exit_code(tampered.decision).value).to_equal(2)
        step("A token from a different query (limit 2, other case) is exit 2")
        val other_limit = execute_test_query(_request(["query", "test/a_spec.spl::adds", "--limit", "2", "--cursor", token]), path)
        expect(test_query_exit_code(other_limit.decision).value).to_equal(2)
        val other_case = execute_test_query(_request(["query", "test/a_spec.spl::other", "--limit", "1", "--cursor", token]), path)
        expect(test_query_exit_code(other_case.decision).value).to_equal(2)
        dir_remove_all(SCRATCH_DIR)

fn _write_scope_fixture() -> TestDbFilePath:
    dir_remove_all(SCRATCH_DIR)
    dir_create_all(SCRATCH_DIR + "/test/01_unit")
    dir_create_all(SCRATCH_DIR + "/test/03_system")
    val unit_a = SCRATCH_DIR + "/test/01_unit/req_a_spec.spl"
    val system_b = SCRATCH_DIR + "/test/03_system/req_b_spec.spl"
    val unit_c = SCRATCH_DIR + "/test/01_unit/none_spec.spl"
    expect(file_write(unit_a, "# @req REQ-SC-1\nuse std.spec.*\n")).to_equal(true)
    expect(file_write(system_b, "# @req REQ-SC-1 REQ-SC-2\nuse std.spec.*\n")).to_equal(true)
    expect(file_write(unit_c, "use std.spec.*\n")).to_equal(true)
    expect(file_write(SCRATCH_DIR + "/bug_db.sdn", "bugs_active |id, severity, status, title, file, line, reproducible_by, created_at, updated_at, valid|\n    b-1, P1, open, \"scoped\", \"\", 0, \"" + unit_a + "\", \"2026-11-18\", \"2026-11-18\", true\n    b-2, P2, open, \"no reproducer\", \"\", 0, \"\", \"2026-11-18\", \"2026-11-18\", true\n    b-3, P2, open, \"none\", \"\", 0, \"NONE\", \"2026-11-18\", \"2026-11-18\", true\n    b-4, P2, open, \"two\", \"\", 0, \"test/a_spec.spl + test/b_spec.spl\", \"2026-11-18\", \"2026-11-18\", true\n    b-5, P2, open, \"cmd\", \"\", 0, \"bin/simple.exe test test/a_spec.spl\", \"2026-11-18\", \"2026-11-18\", true\n")).to_equal(true)
    val db_path = SCRATCH_DIR + "/test_db.sdn"
    var owner = RunnerTestDb(db: TestDatabaseExtended.create(db_path), current_run_id: "")
    val request = TraceRunRequest(subject_id: "subject", configuration_id: "config", expectation_id: "expect", binary_id: "binary", cases: [
        TracePlannedCase(case_id: "c1", test_path: unit_a, case_name: "adds", test_definition_id: "d1", lane_id: "lane"),
        TracePlannedCase(case_id: "c2", test_path: system_b, case_name: "subs", test_definition_id: "d2", lane_id: "lane"),
        TracePlannedCase(case_id: "c3", test_path: unit_c, case_name: "plain", test_definition_id: "d3", lane_id: "lane")])
    val plan = match owner.prepare_trace_request(request):
        case Ok(planned): planned
        case Err(reason): fail("fixture plan rejected: {reason}")
    for pair in [[unit_a, "adds", "passed"], [system_b, "subs", "failed"], [unit_c, "plain", "passed"]]:
        match owner.db.record_trace_case_events(plan.run_id, pair[0], [TraceCaseEvent(pair[1], "started", "not_finished"), TraceCaseEvent(pair[1], "finished", pair[2])]):
            case Ok(_): pass
            case Err(reason): fail("fixture events rejected: {reason}")
    match owner.save():
        case Ok(_): pass
        case Err(reason): fail("fixture save failed: {reason}")
    TestDbFilePath(value: db_path)

fn _scoped_output(args: [text], db: TestDbFilePath) -> TestQueryCliOutput:
    execute_test_query_with_bug_db(_request(args), db, TestScopeBugDbPath(value: SCRATCH_DIR + "/bug_db.sdn"))

describe "scoped test query against a real database file":
    it "resolves a bug to its reproducer's recorded attempts and nothing else":
        # @req TESTDB-010
        val db = _write_scope_fixture()
        val out = _scoped_output(["query", "--bug", "b-1"], db)
        expect(test_query_exit_code(out.decision).value).to_equal(0)
        expect(out.text).to_contain("req_a_spec.spl::adds | unit |")
        expect(out.text).to_contain("passed | pass")
        expect(out.text.contains("req_b_spec")).to_equal(false)
        expect(out.text.contains("none_spec")).to_equal(false)
        step("A bug with no reproducer path and an unknown bug are typed errors, not empty successes")
        val unlinked = _scoped_output(["query", "--bug", "b-2"], db)
        expect(test_query_exit_code(unlinked.decision).value).to_equal(2)
        expect(unlinked.text).to_contain("records no reproducible_by test path")
        expect(_scoped_output(["query", "--bug", "nope"], db).text).to_contain("unknown bug id: nope")
        step("Free-text reproducible_by values (NONE, a + b, a command line) are usage errors, not fake paths")
        for id in ["b-3", "b-4", "b-5"]:
            val bad = _scoped_output(["query", "--bug", id], db)
            expect(test_query_exit_code(bad.decision).value).to_equal(2)
            expect(bad.text).to_contain("bug " + id + " reproducible_by is not a single test spec path: ")
        step("A malformed requirement id is a usage error")
        val bad_req = _scoped_output(["query", "--requirement", "not a valid id"], db)
        expect(test_query_exit_code(bad_req.decision).value).to_equal(2)
        expect(bad_req.text).to_contain("requirement id is not a valid identifier")
        step("An empty --levels is rejected")
        expect(_usage_error_of(["query", "--bug", "b-1", "--levels", ""])).to_contain("--levels")
        dir_remove_all(SCRATCH_DIR)

    it "resolves a requirement through spec @req headers and narrows by level":
        # @req TESTDB-010
        val db = _write_scope_fixture()
        step("REQ-SC-1 is claimed by the unit and the system spec, not by the unannotated one")
        val both = _scoped_output(["query", "--requirement", "REQ-SC-1"], db)
        expect(both.text).to_contain("req_a_spec.spl::adds | unit |")
        expect(both.text).to_contain("req_b_spec.spl::subs | system |")
        expect(both.text).to_contain("failed | not_pass")
        expect(both.text.contains("none_spec")).to_equal(false)
        step("--levels system keeps only the system spec; unit keeps only the unit spec")
        val system = _scoped_output(["query", "--requirement", "REQ-SC-1", "--levels", "system"], db)
        expect(system.text).to_contain("req_b_spec.spl::subs")
        expect(system.text.contains("req_a_spec")).to_equal(false)
        val unit = _scoped_output(["query", "--requirement=req:REQ-SC-1", "--levels", "unit"], db)
        expect(unit.text).to_contain("req_a_spec.spl::adds")
        expect(unit.text.contains("req_b_spec")).to_equal(false)
        step("REQ-SC-2 is claimed only by the system spec")
        val only_b = _scoped_output(["query", "--requirement", "REQ-SC-2"], db)
        expect(only_b.text.contains("req_a_spec")).to_equal(false)
        step("A requirement no spec claims, or a level that excludes everything, is NoRows (exit 1)")
        expect(test_query_exit_code(_scoped_output(["query", "--requirement", "REQ-NONE"], db).decision).value).to_equal(1)
        expect(test_query_exit_code(_scoped_output(["query", "--requirement", "REQ-SC-2", "--levels", "unit"], db).decision).value).to_equal(1)
        dir_remove_all(SCRATCH_DIR)

    it "pages a scoped query with a cursor bound to its scope and levels":
        # @req TESTDB-004 TESTDB-010
        val db = _write_scope_fixture()
        val first = _scoped_output(["query", "--requirement", "REQ-SC-1", "--limit", "1"], db)
        expect(first.text).to_contain("partial: truncated")
        val marker = "next cursor: "
        val at = first.text.index_of(marker) ?? -1
        expect(at >= 0).to_equal(true)
        val cursor = first.text.substring(at + marker.byte_len(), first.text.byte_len()).trim()
        val second = _scoped_output(["query", "--requirement", "REQ-SC-1", "--limit", "1", "--cursor", cursor], db)
        expect(test_query_exit_code(second.decision).value).to_equal(0)
        expect(second.text).to_contain("req_b_spec.spl::subs")
        step("The same cursor under other levels or another requirement is rejected")
        expect(test_query_exit_code(_scoped_output(["query", "--requirement", "REQ-SC-1", "--levels", "unit,system", "--limit", "1", "--cursor", cursor], db).decision).value).to_equal(2)
        expect(test_query_exit_code(_scoped_output(["query", "--requirement", "REQ-SC-2", "--limit", "1", "--cursor", cursor], db).decision).value).to_equal(2)
        dir_remove_all(SCRATCH_DIR)

    it "reads the scoped data without changing the database":
        # @req TESTDB-005 TESTDB-010
        val db = _write_scope_fixture()
        val before = file_read(db.value)
        val mtime = file_modified_time(db.value)
        val listing = dir_list(SCRATCH_DIR).len()
        val out = _scoped_output(["explain", "--requirement", "REQ-SC-1"], db)
        expect(out.text).to_contain("qualifies as PASS")
        expect(file_read(db.value) == before).to_equal(true)
        expect(file_modified_time(db.value)).to_equal(mtime)
        expect(dir_list(SCRATCH_DIR).len()).to_equal(listing)
        dir_remove_all(SCRATCH_DIR)

fn _facts(at: i64, failure: text) -> TraceCaseFacts:
    var summary: TestFailureSummary? = None
    if failure != "":
        summary = Some(TestFailureSummary(value: failure))
    TraceCaseFacts(at: Some(TestEventAtMicros(value: at)), failure: summary,
        host: Some(TestHostTriple(value: "x86_64-windows")), backend: Some(TestBackendName(value: "interpreter")))

# unit_a carries facts; unit_c is a legacy path recorded without any.
fn _write_facts_fixture() -> RunnerTestDb:
    dir_remove_all(SCRATCH_DIR)
    dir_create_all(SCRATCH_DIR)
    var owner = RunnerTestDb(db: TestDatabaseExtended.create(SCRATCH_DIR + "/test_db.sdn"), current_run_id: "")
    val request = TraceRunRequest(subject_id: "subject", configuration_id: "config", expectation_id: "expect", binary_id: "binary", cases: [
        TracePlannedCase(case_id: "c1", test_path: "test/01_unit/f_a_spec.spl", case_name: "adds", test_definition_id: "d1", lane_id: "lane"),
        TracePlannedCase(case_id: "c3", test_path: "test/01_unit/f_c_spec.spl", case_name: "plain", test_definition_id: "d3", lane_id: "lane")])
    val plan = match owner.prepare_trace_request(request):
        case Ok(planned): planned
        case Err(reason): fail("fixture plan rejected: {reason}")
    val with_facts = [
        TraceCaseEvent(case_name: "adds", phase: "started", outcome: "not_finished", facts: Some(_facts(1000, ""))),
        TraceCaseEvent(case_name: "adds", phase: "finished", outcome: "failed", facts: Some(_facts(4500, "expected 2 got 3")))]
    match owner.db.record_trace_case_events(plan.run_id, "test/01_unit/f_a_spec.spl", with_facts):
        case Ok(_): pass
        case Err(reason): fail("fixture events rejected: {reason}")
    match owner.db.record_trace_case_events(plan.run_id, "test/01_unit/f_c_spec.spl", [TraceCaseEvent(case_name: "plain", phase: "started", outcome: "not_finished"), TraceCaseEvent(case_name: "plain", phase: "finished", outcome: "passed")]):
        case Ok(_): pass
        case Err(reason): fail("fixture events rejected: {reason}")
    match owner.save():
        case Ok(_): pass
        case Err(reason): fail("fixture save failed: {reason}")
    owner

describe "test query attempt facts against a real database file":
    it "persists facts beside the event table and shows them in table, sdn and explain output":
        # @req TESTDB-001 TESTDB-003
        val owner = _write_facts_fixture()
        val db = TestDbFilePath(value: SCRATCH_DIR + "/test_db.sdn")
        step("Query the facted case from the reloaded file")
        val table = execute_test_query_with_bug_db(_request(["query", "test/01_unit/f_a_spec.spl::adds"]), db, TestScopeBugDbPath(value: SCRATCH_DIR + "/none.sdn"))
        expect(table.text).to_contain("started_at_micros | duration_micros | host | backend | failure")
        expect(table.text).to_contain("| 1000 | 3500 | x86_64-windows | interpreter | expected 2 got 3")
        val sdn = execute_test_query_with_bug_db(_request(["query", "test/01_unit/f_a_spec.spl::adds", "--format", "sdn"]), db, TestScopeBugDbPath(value: SCRATCH_DIR + "/none.sdn"))
        expect(sdn.text).to_contain(", 1000, 3500, x86_64-windows, interpreter, expected 2 got 3")
        val explain = execute_test_query_with_bug_db(_request(["explain", "test/01_unit/f_a_spec.spl::adds"]), db, TestScopeBugDbPath(value: SCRATCH_DIR + "/none.sdn"))
        expect(explain.text).to_contain("facts: started_at_micros=1000 duration_micros=3500 host=x86_64-windows backend=interpreter failure=expected 2 got 3")
        step("A legacy case recorded without facts shows the absent marker, not zeros")
        val legacy = execute_test_query_with_bug_db(_request(["query", "test/01_unit/f_c_spec.spl::plain"]), db, TestScopeBugDbPath(value: SCRATCH_DIR + "/none.sdn"))
        expect(legacy.text).to_contain("| - | - | - | - | -")
        dir_remove_all(SCRATCH_DIR)

    it "reads a run's events grouped by path with one decode and the same result as the per-path read":
        # @req TESTDB-010
        val owner = _write_facts_fixture()
        val run_id = owner.db.list_runs("")[0].run_id
        val grouped = match owner.db.get_trace_case_events_by_path(run_id):
            case Ok(items): items
            case Err(reason): fail("grouped read failed: {reason}")
        expect(grouped.len()).to_equal(2)
        for path in ["test/01_unit/f_a_spec.spl", "test/01_unit/f_c_spec.spl"]:
            val single = match owner.db.get_trace_case_events(run_id, path):
                case Ok(items): items
                case Err(reason): fail("per-path read failed: {reason}")
            val together = grouped.get(path) ?? []
            expect(together.len()).to_equal(single.len())
            expect(together.len()).to_equal(2)
        step("A path with no events is absent from the grouped read")
        expect(grouped.contains_key("test/01_unit/none_spec.spl")).to_equal(false)
        dir_remove_all(SCRATCH_DIR)

describe "test query attempt facts integrity":
    it "rejects a duplicate fact row instead of overwriting the first":
        # @req TESTDB-006
        var owner = _write_facts_fixture()
        val run_id = owner.db.list_runs("")[0].run_id
        var table = match owner.db.db.get_table("trace_case_event_facts"):
            case Some(existing): existing
            case None: fail("facts table missing")
        table.add_row(table.rows[0])
        owner.db.db.set_table("trace_case_event_facts", table)
        expect(owner.db.get_trace_case_events_by_path(run_id).is_err()).to_equal(true)
        dir_remove_all(SCRATCH_DIR)
