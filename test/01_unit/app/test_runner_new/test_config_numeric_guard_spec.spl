use std.spec.{describe, it, expect, after_each}
use app.test_runner_new.test_config.{load_test_config_from_path}
use app.io.env_ops.{env_get, env_set}
use std.io_runtime.{file_write, file_delete, time_now_unix_micros}

val numeric_guard_original_ci = env_get("CI") ?? ""
val numeric_guard_config_path = "/tmp/simple_test_config_numeric_{time_now_unix_micros()}.sdn"

fn restore_numeric_guard_state():
    env_set("CI", numeric_guard_original_ci)
    file_delete(numeric_guard_config_path)

describe "TestConfig numeric guard":
    after_each:
        restore_numeric_guard_state()

    it "uses compiled defaults for malformed and below-minimum integers":
        env_set("CI", "")
        expect(file_write(numeric_guard_config_path,
            "test:\n  timeout: nope\n  cpu_limit_seconds: 0\n")).to_equal(true)
        val config = load_test_config_from_path(numeric_guard_config_path)
        expect(config.timeout_seconds).to_equal(60)
        expect(config.cpu_limit_seconds).to_equal(30)
