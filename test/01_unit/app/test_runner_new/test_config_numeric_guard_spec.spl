# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.common.config_core.schema.{ConfigFieldDescriptor}
use std.common.config_core.layers.{ConfigEntry, config_resolve_valid}

fn _int_desc() -> ConfigFieldDescriptor:
    ConfigFieldDescriptor(
        key: "max_depth", label: "Depth", description: "max tree depth",
        category: "runner", value_type: "i64", default_value: "5",
        enum_options: [], platform: "all",
        min_value: 1, max_value: 64, has_min: true, has_max: true
    )

describe "test config numeric guard":
    # @manual scenario evidence
    it "drops malformed numeric entries and keeps the valid lower-layer value":
        # @req REQ-SSPEC-APP
        step("drops malformed numeric entries and keeps the valid lower-layer value")
        val desc = _int_desc()
        val entries = [
            ConfigEntry(key: "max_depth", value: "abc", layer: "session"),
            ConfigEntry(key: "max_depth", value: "7", layer: "user")
        ]
        val r = config_resolve_valid(desc, entries)
        expect(r.value).to_equal("7")
        expect(r.layer).to_equal("user")

    it "falls back to the compiled default when every numeric entry is invalid":
        # @req REQ-SSPEC-APP
        step("falls back to the compiled default when every numeric entry is invalid")
        val desc = _int_desc()
        val entries = [ConfigEntry(key: "max_depth", value: "999", layer: "workspace")]
        val r = config_resolve_valid(desc, entries)
        expect(r.value).to_equal("5")
        expect(r.layer).to_equal("compiled_default")
