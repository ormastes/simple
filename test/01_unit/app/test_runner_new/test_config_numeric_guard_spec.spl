# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use std.common.config_core.schema.{ConfigFieldDescriptor}
use std.common.config_core.layers.{ConfigEntry, config_resolve_valid}

fn _int_desc() -> ConfigFieldDescriptor:
    ConfigFieldDescriptor(
        key: "max_depth", label: "Depth", description: "max tree depth",
        category: "runner", value_type: "i64", default_value: "5",
        enum_options: [], platform: "all",
        min_value: 1, max_value: 64, has_min: true, has_max: true
    )

use std.spec.step

describe "test config numeric guard":
    it "defaults malformed integer config values":
        val source = rt_file_read_text("src/app/test_runner_new/test_config.spl") ?? ""

        expect(source).to_contain("fn to_int_or(s: text, default: i64) -> i64")
        expect(source).to_contain("trimmed.to_int() ?? default")
        expect(source.contains("trimmed.to_int()\n")).to_equal(false)
