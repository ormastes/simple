"""Compiler selection: `--compiler=phase2` resolves to the phase2-built CLI.

Selecting phase2 without SIMPLE_PHASE2_FULL_CLI is an error, never a silent
fallback to the seed or the deployed binary.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.compiler_select.{resolve_test_compiler}

val SHA: text = "abababababababababababababababababababababababababababababababab"

describe "compiler selection":
    it "defaults to no explicit compiler":
        expect(parse_test_args([]).compiler).to_equal("")
    it "parses --compiler=phase2":
        expect(parse_test_args(["--compiler=phase2"]).compiler).to_equal("phase2")
    it "resolves phase2 to the phase2 CLI":
        expect(resolve_test_compiler("phase2", "/p2/simple", SHA, "/seed/simple").unwrap()).to_equal("/p2/simple")
    it "keeps the explicit binary when nothing is selected":
        expect(resolve_test_compiler("", "/p2/simple", SHA, "/seed/simple").unwrap()).to_equal("/seed/simple")
    it "errors when the phase2 CLI is missing":
        val r = resolve_test_compiler("phase2", "", SHA, "/seed/simple")
        expect(r.unwrap_err()).to_contain("SIMPLE_PHASE2_FULL_CLI")
    it "errors on an unknown compiler":
        expect(resolve_test_compiler("phase9", "/p2/simple", SHA, "").unwrap_err()).to_contain("phase9")
