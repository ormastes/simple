"""find_simple_binary must honour SIMPLE_BINARY set after its first call.

Bug: the memo was returned before SIMPLE_BINARY was consulted, and the runner
sets SIMPLE_BINARY to the phase2 CLI only after argument parsing, so doctest
children ran on the stale invoking binary.

# @req REQ-TESTRUNNER-PHASE2-4FORMATS
"""

use std.spec.*
use std.test_runner.test_executor_parsing.{find_simple_binary}
use std.nogc_sync_mut.io.env_ops.{env_set}

describe "find_simple_binary":
    it "prefers SIMPLE_BINARY set after an earlier call":
        find_simple_binary()
        env_set("SIMPLE_BINARY", "/bin/sh")
        expect(find_simple_binary()).to_equal("/bin/sh")
    it "follows a later change of SIMPLE_BINARY":
        env_set("SIMPLE_BINARY", "/bin/sh")
        find_simple_binary()
        env_set("SIMPLE_BINARY", "/bin/ls")
        expect(find_simple_binary()).to_equal("/bin/ls")
