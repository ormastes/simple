"""Structured BDD evidence must exclude nested child transcripts from outer counts."""

use std.spec.*
use std.io_runtime.{env_get, process_run_timeout}
use app.test_runner_new.test_runner_single.{single_example_counts}

fn run_single_fixture(path: text) -> (text, i32):
    val binary = env_get("SIMPLE_TEST_BINARY") ?? ""
    if binary == "":
        return ("ERROR: SIMPLE_TEST_BINARY is required for this pinned child probe", 127)
    val (stdout, stderr, code) = process_run_timeout(binary,
        ["test", path, "--mode=interpreter", "--sequential", "--no-session-daemon",
         "--no-db", "--no-cache", "--assert-ran", "--format=text"], 30000)
    (stdout + "\n" + stderr, code)

describe "single-file BDD count authority":
    it "uses the outer receipt instead of nested red/green transcript rows":
        # The captured nested result can be echoed inside an outer assertion
        # diagnostic. Its markers and summary describe a different process.
        val transcript = "✓ inner passed\n✗ inner failed\nResults: 2 total, 1 passed, 1 failed\n"
        val (passed, failed) = single_example_counts(transcript, 5, 1, 1)
        expect(passed).to_equal(5)
        expect(failed).to_equal(1)

    it "does not let nested glyphs fabricate examples over valid zero evidence":
        val transcript = "✓ inner passed\n✗ inner failed\n"
        val (passed, failed) = single_example_counts(transcript, 0, 0, 1)
        expect(passed).to_equal(0)
        expect(failed).to_equal(0)

    it "retains legacy real-example counting when no receipt exists":
        # This keeps the fail-closed orphan-it detection on legacy runtimes
        # that cannot produce the structured receipt.
        val transcript = "✓ described example\n✗ top-level orphan it\n"
        val (passed, failed) = single_example_counts(transcript, 0, 0, 0)
        expect(passed).to_equal(1)
        expect(failed).to_equal(1)

    it "counts the outer red result once when nested red output is printed":
        val (output, code) = run_single_fixture("test/fixtures/test_runner_single/nested_red_transcript_spec.spl")
        expect(code != 0).to_equal(true)
        expect(output).to_contain("Results: 6 total, 5 passed, 1 failed")
        expect(output).not_to_contain("Results: 7 total, 5 passed, 2 failed")

    it "retains the actual count for a lone orphan example":
        val (output, code) = run_single_fixture("test/fixtures/test_runner_single/lone_orphan_spec.spl")
        expect(code).to_equal(0)
        expect(output).to_contain("Results: 1 total, 1 passed, 0 failed")

    it "retains both described and orphan examples":
        val (output, code) = run_single_fixture("test/fixtures/test_runner_single/mixed_orphan_spec.spl")
        expect(code).to_equal(0)
        expect(output).to_contain("Results: 2 total, 2 passed, 0 failed")

    it "keeps post-pass process failure separate from authenticated BDD counts":
        val (output, code) = run_single_fixture("test/fixtures/test_runner_single/process_failure_after_pass_spec.spl")
        expect(code != 0).to_equal(true)
        expect(output).to_contain("Passed: 1")
        expect(output).to_contain("Failed: 0")
        expect(output).to_contain("child process failed after reporting structured BDD counts")

    it "fails closed when a spec has zero examples":
        val (output, code) = run_single_fixture("test/fixtures/test_runner_single/zero_examples_spec.spl")
        expect(code != 0).to_equal(true)
        val names_zero_examples = output.contains("no BDD examples executed") or
            output.contains("no examples executed") or
            output.contains("structured BDD evidence is unavailable")
        expect(names_zero_examples).to_equal(true)
        expect(output).not_to_contain("Results: 1 total, 1 passed, 0 failed")
