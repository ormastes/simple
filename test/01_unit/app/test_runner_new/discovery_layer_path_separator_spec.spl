"""
## Purpose and audience
Purpose: Pin that directory discovery classifies host-native (backslash) walked
paths into the fuzz/chaos/deploy/security/baremetal convention layers.
Audience: test runner maintainers.
## Operator workflow
Run with `simple test test/01_unit/app/test_runner_new/discovery_layer_path_separator_spec.spl`.
"""
use std.test_runner.test_runner_files.{discovery_walked_path}

describe "Directory discovery layer paths with Windows separators":
    it "exposes the fuzz layer segment of a backslash walked path":
        val f = discovery_walked_path("test\\03_system\\feature\\language\\fuzz\\numeric_robustness_fuzz_spec.spl")
        expect(f).to_equal("test/03_system/feature/language/fuzz/numeric_robustness_fuzz_spec.spl")
        expect(f.contains("/fuzz/")).to_equal(true)

    it "exposes the chaos, deploy and security layer segments":
        expect(discovery_walked_path("test\\03_system\\core\\resilience\\a_spec.spl").contains("/resilience/")).to_equal(true)
        expect(discovery_walked_path("test\\03_system\\tools\\deploy\\smoke_spec.spl").contains("/deploy/")).to_equal(true)
        expect(discovery_walked_path("test\\01_unit\\browser_engine\\security\\a_spec.spl").contains("/security/")).to_equal(true)

    it "exposes the baremetal, remote and legacy-mirror segments":
        expect(discovery_walked_path("test\\03_system\\baremetal\\riscv32\\a_spec.spl").contains("/baremetal/riscv32/")).to_equal(true)
        expect(discovery_walked_path("test\\03_system\\remote\\a_spec.spl").contains("/remote/")).to_equal(true)
        expect(discovery_walked_path("C:\\repo\\test\\unit\\a_spec.spl").contains("/test/unit/")).to_equal(true)

    it "normalizes a mixed-separator path and leaves a forward-slash path unchanged":
        expect(discovery_walked_path("test/03_system\\tools\\deploy/smoke_spec.spl")).to_equal("test/03_system/tools/deploy/smoke_spec.spl")
        expect(discovery_walked_path("test/03_system/tools/deploy/smoke_spec.spl")).to_equal("test/03_system/tools/deploy/smoke_spec.spl")

    it "does not invent a layer for a file that only shares the layer name":
        expect(discovery_walked_path("test\\01_unit\\app\\deploy_spec.spl").contains("/deploy/")).to_equal(false)
