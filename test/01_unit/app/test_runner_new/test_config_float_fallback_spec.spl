use std.spec.{describe, it, expect, after_each}
use app.test_runner_new.test_config.{load_test_config_from_path}
use app.io.env_ops.{env_get, env_set}
use std.io_runtime.{file_write, file_delete, time_now_unix_micros}

val float_fallback_original_ci = env_get("CI") ?? ""
val float_fallback_config_path = "/tmp/simple_test_config_float_{time_now_unix_micros()}.sdn"

fn restore_float_fallback_state():
    env_set("CI", float_fallback_original_ci)
    file_delete(float_fallback_config_path)

describe "TestConfig float fallback":
    after_each:
        restore_float_fallback_state()

    it "uses schema defaults for malformed float thresholds":
        env_set("CI", "")
        expect(file_write(float_fallback_config_path,
            "test:\n  cpu_threshold: nope\n  memory_threshold: .\n")).to_equal(true)
        val config = load_test_config_from_path(float_fallback_config_path)
        expect(config.cpu_threshold).to_equal(80.0)
        expect(config.memory_threshold).to_equal(80.0)
