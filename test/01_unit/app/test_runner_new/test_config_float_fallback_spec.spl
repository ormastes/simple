# test_config now lives in std.test_runner (routed through std.config core);
# malformed float thresholds are rejected by schema validation and fall back
# to the compiled defaults.
use std.test_runner.test_config.{test_config_entries, test_config_resolve}

describe "TestConfig float parsing":
    it "keeps malformed float thresholds from crashing config parsing":
        val entries = test_config_entries(content: "test:\n  cpu_throttle:\n    threshold: nope\n    memory_threshold: .\n", layer: "workspace")
        val parsed = test_config_resolve(entries)
        expect(parsed.cpu_threshold).to_equal(80.0)
        expect(parsed.memory_threshold).to_equal(80.0)
