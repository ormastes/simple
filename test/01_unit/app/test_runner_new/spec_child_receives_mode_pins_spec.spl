# Purpose and audience: test-runner maintainers. Exact reproducer for
# doc/08_tracking/bug/test_runner_spec_child_loses_mode_pins_2026-11-14.md:
# a `fn main` spec with NO docstring header, run through `simple test`, must
# see the runner's interpreter pins (before the fix the spec child got a
# scrubbed env, ran on the default JIT and emitted no SPEC FILE VERDICT).
# Runner-lane only: `simple run` of this file sets no pins by design.
# @req REQ-SSPEC-UNIT

use std.spec.*
use std.io_runtime.{env_get}

fn main() -> ():
    describe("spec child under the test runner", fn() -> ():
        it("inherits the interpreter execution-mode pin", fn() -> ():
            expect(env_get("SIMPLE_EXECUTION_MODE") ?? "").to_equal("interpret")
        )
        it("carries the scrub marker for its own grandchildren", fn() -> ():
            expect(env_get("SIMPLE_TEST_CHILD_ENV_SCRUB") ?? "").to_equal("1")
        )
    )
    return ()
