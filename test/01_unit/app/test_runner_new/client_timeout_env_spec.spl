# @req: REQ-APP-TESTRUNNERNE-001

"""Test-runner client timeout budget — where it comes from, and in what order.

Audience: anyone who exports SIMPLE_TIMEOUT_SECONDS before a `bin/simple test`
run and expects the budget to change, and anyone editing
`src/app/test_runner_new/timeout_budget.spl`.

Why this spec exists: SIMPLE_TIMEOUT_SECONDS was read by NOTHING on the client
path. `parse_client_run` hardcoded 120, and `run.timeout_secs` is what feeds
both the light-daemon request budget and the direct-child `--timeout` argument —
so every session exporting the variable silently got 120s, and healthy specs
that needed longer were recorded as `failed=1 reason=daemon-no-response
budget_ms=120000`. That is a false RED, the worst kind of wrong verdict: it
looks like a defect in the code under test.
Bug: doc/08_tracking/bug/simple_timeout_seconds_ignored_by_light_daemon_budget_2026-08-17.md

The similar-problem generalisation is the PRECEDENCE LADDER, not the single env
read: a budget has three possible sources (explicit flag, environment, built-in
default) and the class of defect is any source being silently dropped, or a less
specific source silently winning. Each rung the library owns is pinned below,
including the malformed-value rung — a budget that parses junk as 0 expires
instantly and reports every spec as a timeout, which is strictly worse than
ignoring the variable. The remaining rung (an explicit `--timeout` beating the
environment) lives in `parse_client_run`, which cannot be imported here: that
file is a standalone script with a bare `fn main` and importing it trips the
documented fn-main collision that flips green specs to FAIL. It is covered by
the command-line evidence recorded in the bug doc instead.

# @req REQ-TESTRUNNER-TIMEOUT-BUDGET
# @req: REQ-SSPEC-APP
"""

use std.spec.step

use std.spec.*

use app.test_runner_new.timeout_budget.{
    CLIENT_DEFAULT_TIMEOUT_SECS,
    TIMEOUT_UNLIMITED_SECS,
    client_default_timeout_secs,
    parse_env_timeout_secs,
    resolve_timeout_secs,
    timeout_value_is_well_formed
}

use std.io_runtime.{env_set}

describe "Where the test-runner client gets its default timeout budget":
    # @manual scenario evidence

    it "falls back to the built-in default when the environment says nothing":
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: falls back to the built-in default when the environment says nothing")
        """With no override exported, the client uses its documented
        900-second default (raised from 120, which was below the floor
        cost of running any spec at all)."""

        step("Clear SIMPLE_TIMEOUT_SECONDS and ask for the default budget")
        env_set("SIMPLE_TIMEOUT_SECONDS", "")
        expect(CLIENT_DEFAULT_TIMEOUT_SECS).to_equal(900)  # oracle: 900 — named expected value from the requirement
        expect(client_default_timeout_secs()).to_equal(900)  # oracle: 900 — named expected value from the requirement

    it "honours SIMPLE_TIMEOUT_SECONDS when it is set":
        # @req: REQ-APP-TESTRUNNERNE-001
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: honours SIMPLE_TIMEOUT_SECONDS when it is set")
        """This is the reproducing case. Before the fix this returned 120 — the
        exported value was read by nothing on this path — and any spec needing
        more than two minutes was reported as a daemon timeout rather than run
        to a verdict."""

        step("Export a budget far above the default and read it back")
        env_set("SIMPLE_TIMEOUT_SECONDS", "800")
        expect(client_default_timeout_secs()).to_equal(800)  # oracle: 800 — named expected value from the requirement

        step("Confirm a different value is not cached from the previous read")
        env_set("SIMPLE_TIMEOUT_SECONDS", "1800")
        expect(client_default_timeout_secs()).to_equal(1800)  # oracle: 1800 — named expected value from the requirement

    it "ignores a malformed value instead of expiring instantly":
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: ignores a malformed value instead of expiring instantly")
        """A budget parsed as 0 is worse than an ignored one: every spec would
        time out immediately and the whole suite would read RED for a reason
        having nothing to do with the code under test."""

        step("Try each shape of unusable value in turn")
        env_set("SIMPLE_TIMEOUT_SECONDS", "abc")
        expect(client_default_timeout_secs()).to_equal(900)  # oracle: 900 — named expected value from the requirement

        env_set("SIMPLE_TIMEOUT_SECONDS", "800s")
        expect(client_default_timeout_secs()).to_equal(900)  # oracle: 900 — named expected value from the requirement

        env_set("SIMPLE_TIMEOUT_SECONDS", "-5")
        expect(client_default_timeout_secs()).to_equal(900)  # oracle: 900 — named expected value from the requirement

        step("Leave the environment clean for any later example")
        env_set("SIMPLE_TIMEOUT_SECONDS", "")

describe "The environment-value parser, in isolation":

    it "accepts a run of decimal digits and rejects everything else":
        # @req: REQ-APP-TESTRUNNERNE-001
        # @req: REQ-SSPEC-APP
        step("Verify: accepts a run of decimal digits and rejects everything else")
        """Pinned separately from the ladder above so a parser regression names
        itself rather than surfacing as a mysterious 120 somewhere else."""

        step("Accept well-formed positive budgets")
        expect(parse_env_timeout_secs("800")).to_equal(800)  # oracle: 800 — named expected value from the requirement
        expect(parse_env_timeout_secs("1")).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parse_env_timeout_secs("1800")).to_equal(1800)  # oracle: 1800 — named expected value from the requirement

        step("Reject empty, non-numeric, suffixed, signed, and spaced values")
        expect(parse_env_timeout_secs("")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_env_timeout_secs("abc")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_env_timeout_secs("800s")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_env_timeout_secs("-5")).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(parse_env_timeout_secs(" 800")).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "Zero means unlimited, and the flag outranks the environment":

    it "reads SIMPLE_TIMEOUT_SECONDS=0 as unlimited, not as the 900s default":
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: SIMPLE_TIMEOUT_SECONDS=0 means unlimited")
        """`0` is the documented way to ask for no limit and is the incantation
        used across this repo. Until 2026-09-13 it parsed to 0, was
        indistinguishable from a malformed value, and silently became the 900s
        default — so the escape hatch requested exactly the budget it was
        trying to escape, and two GPU showcase specs never reached a verdict.
        Bug: web_showcase_slow_specs_relaunch_loop_at_900s_cap_2026-09-13."""

        step("Export the documented unlimited value and read the budget back")
        env_set("SIMPLE_TIMEOUT_SECONDS", "0")
        expect(client_default_timeout_secs()).to_equal(TIMEOUT_UNLIMITED_SECS)  # oracle: TIMEOUT_UNLIMITED_SECS — the unlimited budget named by the contract
        expect(client_default_timeout_secs() > CLIENT_DEFAULT_TIMEOUT_SECS).to_equal(true)  # oracle: true — unlimited must never resolve to the 900s default

        step("Leave the environment clean for any later example")
        env_set("SIMPLE_TIMEOUT_SECONDS", "")

    it "lets an explicit flag outrank the environment, at every rung":
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: flag > environment > built-in default")
        """The class of defect is a source being silently dropped, or a less
        specific source silently winning. All three rungs are pinned here in
        one pure function so a regression names itself."""

        step("An explicit flag wins over a set environment value")
        expect(resolve_timeout_secs("2700", "900")).to_equal(2700)  # oracle: 2700 — the explicit flag value
        expect(resolve_timeout_secs("3000", "")).to_equal(3000)  # oracle: 3000 — the explicit flag value

        step("`--timeout 0` is unlimited too")
        expect(resolve_timeout_secs("0", "900")).to_equal(TIMEOUT_UNLIMITED_SECS)  # oracle: TIMEOUT_UNLIMITED_SECS — zero means unlimited at the flag rung as well

        step("The environment is consulted only when no usable flag was given")
        expect(resolve_timeout_secs("", "1800")).to_equal(1800)  # oracle: 1800 — the environment value
        expect(resolve_timeout_secs("junk", "1800")).to_equal(1800)  # oracle: 1800 — a malformed flag is ignored, not read as a 0-second budget

        step("With nothing usable anywhere, the built-in default stands")
        expect(resolve_timeout_secs("", "")).to_equal(CLIENT_DEFAULT_TIMEOUT_SECS)  # oracle: CLIENT_DEFAULT_TIMEOUT_SECS — the built-in default
        expect(resolve_timeout_secs("-5", "800s")).to_equal(CLIENT_DEFAULT_TIMEOUT_SECS)  # oracle: CLIENT_DEFAULT_TIMEOUT_SECS — malformed at both rungs falls through

    it "separates a supplied value from an absent or malformed one":
        # @req: REQ-TESTRUNNER-TIMEOUT-BUDGET
        # @req: REQ-SSPEC-APP
        step("Verify: well-formedness is decided independently of the value")
        """This predicate is what makes `0` expressible at all: the old parser
        returned 0 for both `"0"` and `"abc"`, so the resolver could not tell
        "the caller asked for no limit" from "the caller wrote junk"."""

        step("Digits, including a bare zero, are well formed")
        expect(timeout_value_is_well_formed("0")).to_equal(true)  # oracle: true — a bare zero is a supplied value
        expect(timeout_value_is_well_formed("900")).to_equal(true)  # oracle: true — a plain budget

        step("Empty, signed, suffixed and non-numeric values are not")
        expect(timeout_value_is_well_formed("")).to_equal(false)  # oracle: false — absent
        expect(timeout_value_is_well_formed("-5")).to_equal(false)  # oracle: false — signed
        expect(timeout_value_is_well_formed("800s")).to_equal(false)  # oracle: false — suffixed
        expect(timeout_value_is_well_formed("abc")).to_equal(false)  # oracle: false — non-numeric
