"""Test formats and which runner path each takes.

The 4 formats: md (Markdown code-block sdoctest, `--sdoctest`), comment
(doctest in .spl doc comments, `--spl-doctest`), sspec (acceptance spec using
`step(...)`) and plain `*_spec.spl`. md and comment files are doctest
candidates; sspec and plain specs are spec files.

Defines (does not exist yet): `std.test_runner.test_format.test_format_of(path,
content) -> text` returning "md", "comment", "sspec" or "spec".

# @req REQ-TESTRUNNER-PHASE2-4FORMATS
"""

use std.spec.*
use std.test_runner.test_manifest_scanner.{is_spec_file, is_sdoctest_candidate}
use std.test_runner.sdoctest.discovery.{sdoctest_file_eligible}
use std.test_runner.test_format.{test_format_of}

describe "format routing":
    it "treats a markdown file as an sdoctest candidate":
        expect(is_sdoctest_candidate("doc/guide.md")).to_equal(true)
    it "treats a plain .spl source as an sdoctest candidate":
        expect(is_sdoctest_candidate("src/lib/x.spl")).to_equal(true)
    it "does not treat a _spec.spl as an sdoctest candidate":
        expect(is_sdoctest_candidate("test/01_unit/x_spec.spl")).to_equal(false)
    it "recognises _spec.spl as a spec file":
        expect(is_spec_file("test/01_unit/x_spec.spl")).to_equal(true)
    it "does not recognise markdown as a spec file":
        expect(is_spec_file("doc/guide.md")).to_equal(false)
    it "accepts markdown for sdoctest without the .spl switch":
        expect(sdoctest_file_eligible("doc/guide.md", false)).to_equal(true)
    it "needs the .spl switch for comment doctests":
        expect(sdoctest_file_eligible("src/lib/x.spl", false)).to_equal(false)
        expect(sdoctest_file_eligible("src/lib/x.spl", true)).to_equal(true)

describe "format detection":
    it "detects md":
        expect(test_format_of("doc/guide.md", "# Doc")).to_equal("md")
    it "detects comment":
        expect(test_format_of("src/lib/x.spl", "## ```simple\n## 1\n## ```\nfn f():\n    1")).to_equal("comment")
    it "detects sspec":
        expect(test_format_of("test/03_system/x_spec.spl", "it \"a\":\n    step(\"s\")")).to_equal("sspec")
    it "detects plain spec":
        expect(test_format_of("test/01_unit/x_spec.spl", "it \"a\":\n    expect(1).to_equal(1)")).to_equal("spec")
