use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.spec.evidence_result.{parse_test_result_evidence_v1}

describe "structured BDD result decoder":
    it "rejects malformed failure counts instead of authenticating a pass":
        step("Reproduce the exact failure")
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n2\nnot_number\n")).to_equal((0, 0, 0))

    it "preserves authoritative positive and negative execution counts":
        step("Exercise the repaired owner")
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n2\n1\n")).to_equal((2, 1, 1))
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n3\n0\n")).to_equal((3, 0, 1))
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n0\n1\n")).to_equal((0, 1, 1))
        # Zero evidence remains a valid zero tally, never fabricated execution.
        # Each consumer separately requires a positive total before passing.
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n0\n0\n")).to_equal((0, 0, 1))

    it "rejects trailing fields and incomplete or noncanonical wire data":
        step("Reject the adjacent regression")
        for evidence in ["", "simple-bdd-v1\n1\n0", "simple-bdd-v1\n1\n0\nextra\n", "simple-bdd-v1\n1\n0\n\n", "simple-bdd-v2\n1\n0\n", "simple-bdd-v1\n01\n0\n", "simple-bdd-v1\n1\n-1\n", "simple-bdd-v1\n1\n 0\n", "simple-bdd-v1\n+1\n0\n"]:
            expect(parse_test_result_evidence_v1(evidence)).to_equal((0, 0, 0))

    it "rejects count overflow and overflow of the executed total":
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n9223372036854775808\n0\n")).to_equal((0, 0, 0))
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n9223372036854775807\n1\n")).to_equal((0, 0, 0))
        expect(parse_test_result_evidence_v1("simple-bdd-v1\n9223372036854775807\n0\n")).to_equal((9223372036854775807, 0, 1))
