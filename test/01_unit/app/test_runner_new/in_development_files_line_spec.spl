# @req REQ-TESTRUNNER-INDEV-FILE-COUNT
"""
In-development files are outside the `Results:` example total, so the
summary reports them on a separate line (bug
test_runner_in_development_reporting_and_db_persist_2026-08-23, D2).
"""
use std.spec.*
use std.test_runner.test_runner_output.{in_development_files_line}
use std.test_runner.test_runner_types.{TestFileResult}

fn file_result(path: text, passed: i64, in_dev: i64) -> TestFileResult:
    TestFileResult(path: path, passed: passed, failed: 0, skipped: 0, pending: 0,
        duration_ms: 1, setup_ms: 0, error: "", timed_out: false, cached: false,
        in_development: in_dev)

describe "in_development_files_line":
    it "is empty when no file is in development":
        expect(in_development_files_line([file_result("a", 1, 0)])).to_equal("")

    it "counts neutralised files separately":
        val files = [file_result("a", 1, 0), file_result("b", 0, 1), file_result("c", 0, 2)]
        expect(in_development_files_line(files)).to_start_with("In development: 2 file(s)")
