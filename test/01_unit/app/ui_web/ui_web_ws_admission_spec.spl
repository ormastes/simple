use std.spec.*
use app.ui.web.ws_handler.{ui_web_ws_admit, ui_web_ws_handle_client_frame}
use app.ui.web.origin_guard.{OriginGuard}
use app.ui.web.session_token.{SessionToken}
use app.ui.web.ui_session.{ui_ws_session_open, ui_ws_session_advance}
use common.ui.access.{UiAccessNode, UiAccessSnapshot}

val SECRET: text = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val ORIGIN: text = "https://localhost"

fn guard() -> OriginGuard:
    OriginGuard.from_env_value(ORIGIN)

fn headers_with(bearer: text) -> text:
    "Origin: {ORIGIN}\nAuthorization: Bearer {bearer}\n"

fn admitted(path: text, headers: text) -> bool:
    match ui_web_ws_admit(path, headers, guard(), SECRET, 1000u64):
        Err(_): return false
        Ok(_): return true

fn issued(grant: text) -> SessionToken:
    SessionToken.issue(grant, ORIGIN, 3600000u64, SECRET)

fn snap(rev: i64, value: text) -> UiAccessSnapshot:
    UiAccessSnapshot(
        protocol_version: 1,
        snapshot_revision: rev,
        mode: "web",
        active_surface: "calc",
        surfaces: [],
        nodes: [UiAccessNode(
            canonical_id: "calc#a",
            surface_id: "calc",
            widget_id: "a",
            kind: "button",
            visible: true,
            focused: false,
            enabled: true,
            selected: false,
            text_value: value,
            props: [],
            child_ids: [],
            action_names: ["click"]
        )],
        recent_events: []
    )

describe "ui.web WebSocket admission mints per-connection session state":

    it "admits a valid origin + bearer and binds the session to both":
        val tok = issued("grant-a")
        val result = ui_web_ws_admit("/ui/ws", headers_with(tok.serialize()), guard(), SECRET, 1000u64)
        match result:
            Err(_):
                assert_true(false)
            Ok(session):
                expect(session.session_id).to_be(tok.token_id)
                expect(session.grant_id).to_be("grant-a")
                expect(session.origin).to_be(ORIGIN)
                expect(session.resume_token).to_be(tok.serialize())
                expect(session.revision).to_be(-1)

    it "gives two concurrent connections distinct session ids":
        val a = issued("grant-a")
        val b = issued("grant-a")
        expect(a.token_id != b.token_id).to_be(true)
        val ra = ui_web_ws_admit("/ui/ws", headers_with(a.serialize()), guard(), SECRET, 1000u64)
        val rb = ui_web_ws_admit("/ui/ws", headers_with(b.serialize()), guard(), SECRET, 1000u64)
        match ra:
            Err(_): assert_true(false)
            Ok(sa):
                match rb:
                    Err(_): assert_true(false)
                    Ok(sb):
                        expect(sa.session_id != sb.session_id).to_be(true)
                        expect(sa.resume_token != sb.resume_token).to_be(true)

    it "refuses a disallowed origin, a missing bearer, and a forged token":
        val tok = issued("grant-a")
        val bad_origin = "Origin: https://evil.test\nAuthorization: Bearer {tok.serialize()}\n"
        expect(admitted("/ui/ws", bad_origin)).to_be(false)
        expect(admitted("/ui/ws", "Origin: {ORIGIN}\n")).to_be(false)
        val forged = "{tok.serialize()}x"
        expect(admitted("/ui/ws", headers_with(forged))).to_be(false)

describe "ui.web client frame dispatch":

    it "routes a valid input frame to the caller without changing session state":
        val s = ui_ws_session_open("sid-1", "g", ORIGIN, "bearer-1")
        val out = ui_web_ws_handle_client_frame(s, "{\"v\":1,\"t\":\"input\",\"id\":\"calc#a\",\"action\":\"click\"}")
        expect(out.2).to_be(true)
        expect(out.1).to_be("")
        expect(out.0.revision).to_be(-1)

    it "answers a malformed frame with an error frame and no state change":
        val s = ui_ws_session_open("sid-1", "g", ORIGIN, "bearer-1")
        val out = ui_web_ws_handle_client_frame(s, "{\"v\":9,\"t\":\"input\",\"id\":\"a\",\"action\":\"click\"}")
        expect(out.2).to_be(false)
        expect(out.1.contains("\"code\":\"unsupported_protocol_version\"")).to_be(true)

    it "resumes on the session's own token and re-baselines to a full snapshot":
        val s0 = ui_ws_session_open("sid-1", "g", ORIGIN, "bearer-1")
        val advanced = ui_ws_session_advance(s0, snap(4, "1"))
        expect(advanced.0.revision).to_be(4)
        val out = ui_web_ws_handle_client_frame(advanced.0, "{\"v\":1,\"t\":\"resume\",\"resume_token\":\"bearer-1\"}")
        expect(out.2).to_be(false)
        expect(out.1.contains("\"t\":\"hello\"")).to_be(true)
        expect(out.0.revision).to_be(-1)
        val after = ui_ws_session_advance(out.0, snap(5, "2"))
        expect(after.1.contains("\"t\":\"snapshot\"")).to_be(true)

    it "rejects a resume presenting another session's token":
        val s = ui_ws_session_open("sid-1", "g", ORIGIN, "bearer-1")
        val out = ui_web_ws_handle_client_frame(s, "{\"v\":1,\"t\":\"resume\",\"resume_token\":\"bearer-2\"}")
        expect(out.1.contains("\"code\":\"invalid_resume_token\"")).to_be(true)
