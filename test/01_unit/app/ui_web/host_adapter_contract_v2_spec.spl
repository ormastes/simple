use std.spec.*
use app.ui.web.host_adapter_contract.{HOST_CONTRACT_VERSION, HostCapabilities, host_capabilities_default, host_capabilities_to_json, HostSessionHandshake, host_session_handshake_default, host_session_handshake_to_json}

describe "HostInterface v2 contract fields":

    it "declares contract version 2":
        expect(HOST_CONTRACT_VERSION).to_be(2)

    it "defaults to pointer+keyboard only capabilities":
        val caps = host_capabilities_default()
        expect(caps.pointer).to_be(true)
        expect(caps.keyboard).to_be(true)
        expect(caps.ime).to_be(false)
        expect(caps.clipboard).to_be(false)
        expect(caps.file_picker).to_be(false)

    it "default handshake carries empty auth and resume tokens":
        val hs = host_session_handshake_default()
        expect(hs.contract_version).to_be(2)
        expect(hs.auth_token).to_be("")
        expect(hs.resume_token).to_be("")
        expect(hs.capabilities.pointer).to_be(true)

    it "projects capabilities to stable JSON":
        val caps = HostCapabilities(pointer: true, keyboard: true, ime: true, clipboard: false, file_picker: false)
        expect(host_capabilities_to_json(caps)).to_be("{\"pointer\":true,\"keyboard\":true,\"ime\":true,\"clipboard\":false,\"file_picker\":false}")

    it "projects the handshake to JSON with escaped tokens":
        val hs = HostSessionHandshake(
            contract_version: 2,
            auth_token: "tok\"en",
            resume_token: "r1",
            capabilities: host_capabilities_default()
        )
        val json = host_session_handshake_to_json(hs)
        expect(json).to_contain("\"contract_version\":2")
        expect(json).to_contain("\"auth_token\":\"tok\\\"en\"")
        expect(json).to_contain("\"resume_token\":\"r1\"")
        expect(json).to_contain("\"capabilities\":{\"pointer\":true")
