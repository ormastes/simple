# @req REQ-2D-004
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use app.ui.renderdoc_diff.events.{rdoc_events_parse}
use app.ui.renderdoc_diff.align.{rdoc_diff, rdoc_diff_verdict}
use app.ui.renderdoc_diff.thumb.{rdoc_base64_decode, rdoc_thumb_mismatch_pct}

val FIXTURES: text = "test/fixtures/renderdoc_diff/"

fn _verdict(name: text) -> text:
    val a = rdoc_events_parse(file_read(FIXTURES + name + "_a.events.json"))
    val b = rdoc_events_parse(file_read(FIXTURES + name + "_b.events.json"))
    rdoc_diff_verdict(rdoc_diff(a, b))

fn _first_class(name: text) -> text:
    val a = rdoc_events_parse(file_read(FIXTURES + name + "_a.events.json"))
    val b = rdoc_events_parse(file_read(FIXTURES + name + "_b.events.json"))
    rdoc_diff(a, b).first_divergent_class

fn _first_id(name: text) -> i64:
    val a = rdoc_events_parse(file_read(FIXTURES + name + "_a.events.json"))
    val b = rdoc_events_parse(file_read(FIXTURES + name + "_b.events.json"))
    rdoc_diff(a, b).first_divergent

fn _single_draw(digest: text) -> text:
    "{\"schema\":\"renderdoc-events/v1\",\"capture\":\"synthetic.rdc\",\"events\":[" +
        "{\"eventId\":1,\"name\":\"draw\",\"type\":\"draw\",\"pipeline\":\"graphics\"," +
        "\"targets\":[{\"id\":1,\"width\":1,\"height\":1,\"format\":\"R8G8B8A8_UNORM\"}]," +
        "\"outputSha256\":\"" + digest + "\"}]}"

describe "RenderDoc capture diff":

    it "parses the v1 schema and buckets ordinals per event type":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-001
        # @req REQ-2D-004
        val a = rdoc_events_parse(file_read(FIXTURES + "identical_a.events.json"))

        expect(a.error).to_equal("")
        expect(a.schema).to_equal("renderdoc-events/v1")
        expect(a.events.len()).to_equal(4)
        expect(a.events[0].event_type).to_equal("clear")
        expect(a.events[0].ordinal).to_equal(0)
        expect(a.events[1].ordinal).to_equal(0)
        expect(a.events[2].ordinal).to_equal(1)
        expect(a.events[1].target_width).to_equal(1920)
        expect(a.events[2].vertex_count).to_equal(1024)

    it "rejects an unknown schema rather than reporting zero events":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-002
        # @req REQ-2D-004
        val bad = rdoc_events_parse("{\"schema\":\"renderdoc-events/v9\",\"events\":[]}")

        expect(bad.error).to_equal("unsupported schema renderdoc-events/v9")

    it "rejects absent or invented output evidence in direct event files":
        step("Validate captured graphics output evidence")
        # @req REQ-UI-RENDERDOC-DIFF-014
        # @req REQ-2D-004
        val empty = rdoc_events_parse(_single_draw(""))
        val unavailable = rdoc_events_parse(_single_draw("unavailable:readback"))
        val fake = rdoc_events_parse(_single_draw("sha_draw"))
        expect(empty.error).to_equal("missing or invalid outputSha256 at events[0]")
        expect(unavailable.error).to_equal("missing or invalid outputSha256 at events[0]")
        expect(fake.error).to_equal("missing or invalid outputSha256 at events[0]")
        expect(rdoc_diff_verdict(rdoc_diff(empty, empty))).to_start_with("RENDERDOC DIFF: ERROR")

    it "rejects event sets without graphics output evidence":
        step("Validate captured graphics output evidence")
        # @req REQ-UI-RENDERDOC-DIFF-015
        val marker = rdoc_events_parse("{\"schema\":\"renderdoc-events/v1\",\"events\":[" +
            "{\"eventId\":1,\"name\":\"marker\",\"type\":\"marker\",\"targets\":[]}]}")
        expect(marker.error).to_equal("no graphics output evidence")

    it "rejects a blocked export or a graphics row without a target":
        step("Validate every graphics event before alignment")
        # @req REQ-UI-RENDERDOC-DIFF-016
        val sha = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val valid = _single_draw(sha)
        val blocked = valid.replace("\"capture\":", "\"evidenceStatus\":\"blocked\",\"capture\":")
        val no_target = valid.replace(
            "\"targets\":[{\"id\":1,\"width\":1,\"height\":1,\"format\":\"R8G8B8A8_UNORM\"}]",
            "\"targets\":[]")
        expect(rdoc_events_parse(blocked).error).to_equal("incomplete exporter evidence blocked")
        expect(rdoc_events_parse(no_target).error).to_equal("missing or invalid outputSha256 at events[0]")

    it "compares equivalent hexadecimal digest case without a false difference":
        step("Normalize the diagnostic digest representation")
        # @req REQ-UI-RENDERDOC-DIFF-017
        # @req REQ-2D-004
        val lower = rdoc_events_parse(_single_draw(
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
        val upper = rdoc_events_parse(_single_draw(
            "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))
        expect(lower.error).to_equal("")
        expect(upper.error).to_equal("")
        expect(rdoc_diff(lower, upper).divergent).to_equal(0)

    it "aligns identical captures with no divergence":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-003
        expect(_verdict("identical")).to_equal("RENDERDOC DIFF: PASS — 4 event(s) aligned, 0 divergent")

    it "names the dropped event id when one side is missing a draw":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-004
        expect(_first_class("missing_draw")).to_equal("missing-draw")
        expect(_first_id("missing_draw")).to_equal(14)

    it "reports an unmatched extra draw on side b":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-005
        expect(_first_class("extra_draw")).to_equal("extra-draw")
        expect(_first_id("extra_draw")).to_equal(15)

    it "classifies two swapped draws as order, not as a size difference":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-006
        # The swapped pair also differs in render-target dimensions. Alignment keys on
        # those dimensions, so each draw finds its true counterpart at a different
        # ordinal and the class is `order`. A dims-blind alignment pairs them by
        # position and misreports `size-mismatch` - that is the sabotage this pins.
        expect(_first_class("order")).to_equal("order")
        expect(_first_id("order")).to_equal(12)

    it "classifies an equal-geometry draw with different pixels as output-mismatch":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-007
        expect(_first_class("output_mismatch")).to_equal("output-mismatch")
        expect(_first_id("output_mismatch")).to_equal(14)

    it "classifies a differing render-target size as size-mismatch":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-008
        expect(_first_class("size_mismatch")).to_equal("size-mismatch")
        expect(_first_id("size_mismatch")).to_equal(20)

    it "classifies a differing attachment format as format-mismatch":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-009
        expect(_first_class("format_mismatch")).to_equal("format-mismatch")
        expect(_first_id("format_mismatch")).to_equal(30)

    it "treats zero events on either side as ERROR, never as a pass":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-010
        expect(_verdict("empty")).to_equal(
            "RENDERDOC DIFF: ERROR — nothing was checked (one or both sides carry 0 events)")

    it "decodes thumbnail base64 to byte values and compares whole RGBA pixels":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-011
        # "AAECAwQFBgc=" is the bytes 0..7, i.e. exactly two RGBA8 pixels.
        val bytes = rdoc_base64_decode("AAECAwQFBgc=")

        expect(bytes.len()).to_equal(8)
        expect(bytes[0]).to_equal(0)
        expect(bytes[7]).to_equal(7)
        # One differing byte inside a pixel makes that WHOLE pixel differ: 1 of 2 = 50%,
        # which a base64-character comparison would not produce.
        expect(rdoc_thumb_mismatch_pct("AAECAwQFBgc=", "AAECAwQFBgg=")).to_equal(50)
        expect(rdoc_thumb_mismatch_pct("AAECAwQFBgc=", "AAECAwQFBgc=")).to_equal(0)
        expect(rdoc_thumb_mismatch_pct("", "AAECAwQFBgc=")).to_equal(-1)

    it "reports a thumbnail pixel mismatch percentage when thumbs are present":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-012
        val a = rdoc_events_parse(file_read(FIXTURES + "output_mismatch_a.events.json"))
        val b = rdoc_events_parse(file_read(FIXTURES + "output_mismatch_b.events.json"))
        val diff = rdoc_diff(a, b)

        expect(diff.thumbs_present).to_equal(true)
        expect(diff.divergences[0].thumb_mismatch_pct).to_equal(25)

    it "counts events per type on both sides":
        step("Classify a RenderDoc capture diff")
        # @req REQ-UI-RENDERDOC-DIFF-013
        val a = rdoc_events_parse(file_read(FIXTURES + "missing_draw_a.events.json"))
        val b = rdoc_events_parse(file_read(FIXTURES + "missing_draw_b.events.json"))
        val diff = rdoc_diff(a, b)

        expect(diff.type_counts[1].event_type).to_equal("draw")
        expect(diff.type_counts[1].count_a).to_equal(2)
        expect(diff.type_counts[1].count_b).to_equal(1)
