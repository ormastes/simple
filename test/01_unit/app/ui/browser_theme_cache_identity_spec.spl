# @cover src/app/ui.browser/backend.spl
# @tag: unit, ui, browser, theme, cache

use std.spec.*
use common.ui.builder.{button, panel, text_widget, build_tree_with_title}
use common.ui.state.{init_state}
use app.ui.browser.backend.{BrowserBackend, browser_theme_cache_identity, browser_theme_cache_key}
use nogc_sync_mut.ui.theme_package.{theme_package_render_snapshot}
use common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use common.ui.wm_chrome_theme.{
    apply_theme_render_snapshot_to_wm_chrome,
    reset_wm_chrome_theme,
    theme_render_snapshot_with_wm_colors,
    wm_chrome_theme_defaults
}

val CACHE_SOURCE_A: text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val CACHE_SOURCE_B: text = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val CACHE_MATERIAL_A: text = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
val CACHE_MATERIAL_B: text = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"

fn cache_identity_browser_state():
    val root = panel("browser_theme_cache_root", "Browser Theme Cache", [
        text_widget("browser_theme_cache_copy", "Theme identity"),
        button("browser_theme_cache_action", "Render", "render")
    ])
    val tree = build_tree_with_title(root, "Browser Theme Cache", "dark")
    init_state(tree)

describe "browser canonical theme cache identity":

    it "invalidates when the canonical id, source hash, or material hash changes":
        val baseline = browser_theme_cache_identity("dark", CACHE_SOURCE_A, CACHE_MATERIAL_A)
        val changed_id = browser_theme_cache_identity("light", CACHE_SOURCE_A, CACHE_MATERIAL_A)
        val changed_source = browser_theme_cache_identity("dark", CACHE_SOURCE_B, CACHE_MATERIAL_A)
        val changed_material = browser_theme_cache_identity("dark", CACHE_SOURCE_A, CACHE_MATERIAL_B)

        expect(changed_id == baseline).to_equal(false)
        expect(changed_source == baseline).to_equal(false)
        expect(changed_material == baseline).to_equal(false)
        expect(browser_theme_cache_key("static", "dark", CACHE_SOURCE_A, CACHE_MATERIAL_A)).to_contain(baseline)
        expect(browser_theme_cache_key("static", "dark", CACHE_SOURCE_B, CACHE_MATERIAL_A) == browser_theme_cache_key("static", "dark", CACHE_SOURCE_A, CACHE_MATERIAL_A)).to_equal(false)
        expect(browser_theme_cache_key("static", "dark", CACHE_SOURCE_A, CACHE_MATERIAL_B) == browser_theme_cache_key("static", "dark", CACHE_SOURCE_A, CACHE_MATERIAL_A)).to_equal(false)

    it "binds static frame, static shell, layout, and present caches to the same identity":
        val state = cache_identity_browser_state()
        val snapshot = theme_package_render_snapshot(state.tree.theme_name())
        val expected_identity = browser_theme_cache_identity(
            snapshot.id,
            snapshot.source_manifest_sha256,
            snapshot.material_sha256
        )
        val backend_result = BrowserBackend.create(64, 48, "software")
        match backend_result:
            Err(error):
                expect(error).to_equal("")
            Ok(backend):
                backend.render_frame(state.tree, state)
                expect(backend.static_frame_theme_identity).to_equal(expected_identity)
                expect(backend.static_shell_cache_key).to_contain(expected_identity)
                expect(backend.layout_cache_theme_identity).to_equal(expected_identity)
                expect(backend.last_render_theme_identity).to_equal(expected_identity)

                val pixels = backend.pixels_rgba_i64()
                expect(pixels.len()).to_equal(64 * 48)
                expect(backend.present_pixels_cache_theme_identity).to_equal(expected_identity)

    it "uses a matching active WM snapshot for every retained BrowserBackend identity":
        reset_wm_chrome_theme()
        val package_snapshot = aetheric_dark_theme_render_snapshot()
        val overridden = theme_render_snapshot_with_wm_colors(
            package_snapshot, wm_chrome_theme_defaults()
        )
        apply_theme_render_snapshot_to_wm_chrome(overridden)
        val root = panel("browser_active_theme_root", "Active Theme", [
            text_widget("browser_active_theme_copy", "Override identity")
        ])
        val state = init_state(build_tree_with_title(
            root, "Active Theme", "aetheric_dark"
        ))
        val backend_result = BrowserBackend.create(64, 48, "software")
        match backend_result:
            Err(error):
                expect(error).to_equal("")
            Ok(backend):
                backend.render_frame(state.tree, state)
                val expected_identity = browser_theme_cache_identity(
                    overridden.id,
                    overridden.source_manifest_sha256,
                    overridden.material_sha256
                )
                val package_identity = browser_theme_cache_identity(
                    package_snapshot.id,
                    package_snapshot.source_manifest_sha256,
                    package_snapshot.material_sha256
                )
                expect(overridden.material_sha256 == package_snapshot.material_sha256).to_be(false)
                expect(backend.static_frame_theme_identity).to_equal(expected_identity)
                expect(backend.static_shell_cache_key).to_contain(expected_identity)
                expect(backend.layout_cache_theme_identity).to_equal(expected_identity)
                expect(backend.last_render_theme_identity).to_equal(expected_identity)
                expect(backend.last_render_theme_identity == package_identity).to_be(false)
        reset_wm_chrome_theme()
