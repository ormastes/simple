use app.ui.web.login_grant_contract.{ui_web_login_grant_status,
    ui_web_static_script_security_headers, ui_web_with_login_grant}

fn login_grant_contract_cases_v1() -> text:
    val grant = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    val other = "1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    val upper = "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef"
    if ui_web_login_grant_status(grant, grant) != "ok": return "matching-grant"
    if ui_web_login_grant_status(other, grant) != "forbidden": return "different-grant"
    if ui_web_login_grant_status("short", grant) != "forbidden": return "short-provided"
    if ui_web_login_grant_status(grant, "short") != "forbidden": return "short-expected"
    if ui_web_login_grant_status(upper, upper) != "forbidden": return "uppercase-expected"
    val headers = "Cache-Control: no-store\r\nPragma: no-cache\r\nX-Content-Type-Options: nosniff\r\n"
    if ui_web_static_script_security_headers("application/javascript") != headers:
        return "javascript-security-headers"
    if ui_web_static_script_security_headers("text/html") != "": return "non-script-headers"
    val html = "<html><head>\n<title>unchanged</title></head><body>body</body></html>"
    val expected = "<html><head>\n  <meta name=\"simple-ui-login-grant\" content=\"{grant}\">\n<title>unchanged</title></head><body>body</body></html>"
    if ui_web_with_login_grant(html, grant) != expected: return "valid-meta-injection"
    if ui_web_with_login_grant(html, upper) != html: return "invalid-meta-grant"
    if ui_web_with_login_grant(html, "short") != html: return "short-meta-grant"
    val no_head = "<head><title>no newline marker</title></head>"
    if ui_web_with_login_grant(no_head, grant) != no_head: return "missing-exact-head-marker"
    ""

export login_grant_contract_cases_v1
