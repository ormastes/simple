# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP

# ui.web server decodes request bytes with strict UTF-8 (bytes_to_text_checked):
# invalid bytes are rejected, a split trailing sequence asks for more input.

use std.spec.step

use app.ui.web.server.{web_server_bytes_to_text}

describe "ui.web server strict UTF-8 decode":
    it "accepts valid UTF-8":
        val decoded = web_server_bytes_to_text([71u8, 69u8, 84u8, 32u8, 237u8, 149u8, 156u8])
        expect(decoded.unwrap()).to_equal("GET \u{D55C}")

    it "rejects invalid UTF-8":
        val decoded = web_server_bytes_to_text([71u8, 255u8, 84u8])
        expect(decoded.unwrap_err()).to_equal("request_not_utf8")

    it "reports a split trailing sequence as incomplete":
        val decoded = web_server_bytes_to_text([71u8, 237u8, 149u8])
        expect(decoded.unwrap_err()).to_equal("request_incomplete_utf8")
