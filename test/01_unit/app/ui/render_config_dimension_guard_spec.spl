# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.ui.render.config.{parse_env_dimension_or_default}

describe "render config dimension guard":
    # @manual scenario evidence
    it "accepts positive dimensions and falls back to default on malformed or non-positive values":
        # @req REQ-SSPEC-APP
        step("accepts positive dimensions and falls back to default on malformed or non-positive values")
        expect(parse_env_dimension_or_default("800", 640)).to_equal(800)
        expect(parse_env_dimension_or_default("1", 640)).to_equal(1)
        expect(parse_env_dimension_or_default("", 640)).to_equal(640)
        expect(parse_env_dimension_or_default("abc", 640)).to_equal(640)
        expect(parse_env_dimension_or_default("12x", 640)).to_equal(640)
        expect(parse_env_dimension_or_default("-5", 640)).to_equal(640)
        expect(parse_env_dimension_or_default("0", 640)).to_equal(640)
