# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use common.ui.builder.{button, build_tree}
use common.ui.widget.{UIEvent}
use common.ui.access.{UiAccessEvent, UiAccessNode, UiAccessSnapshot}
use nogc_sync_mut.ui.session.{UISession, UiAccessPersistence}


class AccessPersistenceProbe:
    snapshot_count: i64
    event_count: i64

impl UiAccessPersistence for AccessPersistenceProbe:
    me persist_snapshot(snapshot: UiAccessSnapshot) -> Result<(), text>:
        self.snapshot_count = self.snapshot_count + 1
        Ok(())

    me insert_event(event: UiAccessEvent) -> Result<(), text>:
        self.event_count = self.event_count + 1
        Ok(())

    fn list_events(surface_id: text, count: i64) -> Result<[UiAccessEvent], text>:
        Ok([])

    fn query_nodes(surface_id: text, kind: text, query: text, limit: i64) -> Result<[UiAccessNode], text>:
        Ok([])

describe "UISession access persistence port":
    # @manual scenario evidence
    it "seeds and updates an attached storage-independent persistence port":
        # @req REQ-SSPEC-APP
        step("seeds and updates an attached storage-independent persistence port")
        var probe = AccessPersistenceProbe(snapshot_count: 0, event_count: 0)
        var session = UISession.new(build_tree(button("save", "Save", "save")))
        session.attach_access_persistence(probe)
        expect(probe.snapshot_count).to_equal(1)

        session.dispatch(UIEvent.Action(name: "save"))
        expect(probe.event_count).to_equal(1)
        expect(probe.snapshot_count).to_equal(2)
        expect(session.access_persisted_events("main", 10)?.len()).to_equal(0)
        expect(session.access_search_nodes("main", "button", "save", 10)?.len()).to_equal(0)

    it "keeps persistence optional for the core session":
        # @req REQ-SSPEC-APP
        step("keeps persistence optional for the core session")
        val session = UISession.new(build_tree(button("save", "Save", "save")))
        expect(session.access_persisted_events("main", 10).err().unwrap()).to_equal("no access store attached")
