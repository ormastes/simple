# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "web async websocket numeric guards":
    # @manual scenario evidence
    it "guards resize dimension parsing":
        # @req REQ-SSPEC-APP
        step("guards resize dimension parsing")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = rt_file_read_text("src/app/ui.web/async_ws.spl") ?? ""

        expect(source).to_contain("fn parse_ws_resize_dim(value: text) -> i32")
        expect(source).to_contain("value.trim().to_int() ?? -1")
        expect(source).to_contain("val w = parse_ws_resize_dim(width_str)")
        expect(source).to_contain("val h = parse_ws_resize_dim(height_str)")
        expect(source).to_contain("if w < 0 or h < 0:")
        assert_false(source.contains("val w: i32 = width_str.to_int()"))
        assert_false(source.contains("val h: i32 = height_str.to_int()"))
