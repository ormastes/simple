# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "tui widget active index guard":
    # @manual scenario evidence
    it "guards malformed active index parsing":
        # @req REQ-SSPEC-APP
        step("guards malformed active index parsing")
        val source = rt_file_read_text("src/app/ui.render/_TuiWidgets/extended_widgets.spl") ?? ""

        expect(source).to_contain("fn tui_active_index_or_default(value: text, default_value: i64) -> i64")
        expect(source).to_contain("for ch in trimmed:")
        expect(source).to_contain("if ch < \"0\" or ch > \"9\":")
        expect(source).to_contain("return trimmed.to_int() ?? default_value")
        expect(source).to_contain("tui_active_index_or_default(active_str, 0)")
        expect(source.contains("active_idx = active_str.to_int()")).to_equal(false)
