# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: an extended widget's `active` index property must only ever be honoured
when it is composed solely of digits; anything else falls back to the widget's
default index instead of coercing or crashing.
Audience: TUI rendering engineers who maintain the extended widget layer.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use app.ui.render._TuiWidgets.extended_widgets.{tui_active_index_or_default}

describe "tui widget active index guard":
    # @manual scenario evidence
    it "accepts a purely numeric active index":
        # @req REQ-SSPEC-APP
        step("Verify: numeric active index is honoured")
        expect(tui_active_index_or_default("4", 0)).to_equal(4)  # oracle: exact parse
        expect(tui_active_index_or_default(" 2 ", 9)).to_equal(2)  # oracle: trimmed then parsed

    it "falls back to the default on a malformed active index":
        # @req REQ-SSPEC-APP
        step("Verify: malformed active index falls back to the default")
        expect(tui_active_index_or_default("", 1)).to_equal(1)  # oracle: empty uses default
        expect(tui_active_index_or_default("2x", 6)).to_equal(6)  # oracle: non-digit char uses default
        expect(tui_active_index_or_default("-3", 8)).to_equal(8)  # oracle: sign char is rejected, uses default
