# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Web port guard — executed against the real shared-wm port parser.

use std.spec.step

use app.ui.web.server.{parse_web_port_or_default}

describe "web port guard":
    it "guards malformed shared wm port parsing":
        val source = rt_file_read_text("src/app/ui.web/server.spl") ?? ""

        expect(source).to_contain("fn parse_web_port_or_default(value: text) -> i64")
        expect(source).to_contain("for ch in trimmed:")
        expect(source).to_contain("if ch < \"0\" or ch > \"9\":")
        expect(source).to_contain("val parsed = trimmed.to_int() ?? 8080")
        expect(source).to_contain("if parsed <= 0 or parsed > 65535:")
        expect(source).to_contain("val port = parse_web_port_or_default(port_str)")
        expect(source.contains("val port = port_str.to_int()")).to_equal(false)
