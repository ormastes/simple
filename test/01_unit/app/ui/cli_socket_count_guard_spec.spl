# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "ui cli socket count guard":
    # @manual scenario evidence
    it "guards malformed count values":
        # @req REQ-SSPEC-APP
        step("guards malformed count values")
        val source = rt_file_read_text("src/app/ui.cli/socket_server.spl") ?? ""

        expect(source).to_contain("fn parse_socket_count_or_default(value: text, default_value: i32) -> i32")
        expect(source).to_contain("val count = parse_socket_count_or_default(count_str, 10)")
        expect(source.contains("count_str.to_int()")).to_equal(false)
