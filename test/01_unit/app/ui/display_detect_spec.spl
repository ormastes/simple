# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @cover common.test_runner.display_detect
# @gui: headless


use std.spec.step

use common.test_runner.display_detect.{detect_display, has_any_display, can_show_gui,

    display_kind_name, DISPLAY_NONE, DISPLAY_X11, DISPLAY_WAYLAND, DISPLAY_MACOS, DISPLAY_XVFB}

describe "Display Detection":
    # @manual scenario evidence
    it "returns a DisplayInfo struct":
        # @req REQ-SSPEC-UNIT
        step("returns a DisplayInfo struct")
        val info = detect_display()
        # Just verify it returns without crashing
        val name = display_kind_name(info.kind)
        expect(name).to_equal("").to_equal(false)

    it "has_any_display returns a boolean":
        # @req REQ-SSPEC-UNIT
        step("has_any_display returns a boolean")
        val result = has_any_display()
        # On any system this should return true or false
        expect(result == true or result == false).to_equal(true)

    it "can_show_gui returns a boolean":
        # @req REQ-SSPEC-UNIT
        step("can_show_gui returns a boolean")
        val result = can_show_gui()
        expect(result == true or result == false).to_equal(true)

    describe "display_kind_name":
        it "names all display types":
            # @req REQ-SSPEC-UNIT
            step("names all display types")
            expect(display_kind_name(DISPLAY_NONE)).to_equal("none")
            expect(display_kind_name(DISPLAY_X11)).to_equal("X11")
            expect(display_kind_name(DISPLAY_WAYLAND)).to_equal("Wayland")
            expect(display_kind_name(DISPLAY_MACOS)).to_equal("macOS")
            expect(display_kind_name(DISPLAY_XVFB)).to_equal("Xvfb")

        it "handles unknown values":
            # @req REQ-SSPEC-UNIT
            step("handles unknown values")
            expect(display_kind_name(99)).to_equal("unknown")
