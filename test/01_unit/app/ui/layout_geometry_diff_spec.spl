# Spec for the Chrome-vs-Simple CSS layout geometry differ.
# Run: <seed> run test/01_unit/app/ui/layout_geometry_diff_spec.spl
use app.ui.chrome_showcase.layout_geometry_diff.{
    GeomBox, parse_chrome_geom, geometry_diff, classify_feature, selftest_report
}

var examples = 0
var failures = 0

fn check(name: text, ok: bool):
    examples = examples + 1
    if not ok:
        failures = failures + 1
        print("FAIL: " + name)
    else:
        print("ok: " + name)

fn main():
    val dump = "noise\n" +
        "GEOM|path:|body|0|0|900|600|display=block\n" +
        "GEOM|path:0|div|10|10|100|50|display=flex\n"
    val chrome = parse_chrome_geom(dump)
    check("parse_chrome_geom skips non-GEOM lines", chrome.len() == 2)
    check("parse_chrome_geom reads geometry", chrome[1].x == 10 and chrome[1].w == 100)
    check("parse_chrome_geom reads tag", chrome[1].tag == "div")

    val same = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 10, w: 100, h: 50, features: "")
    ]
    val r1 = geometry_diff(chrome, same, 1)
    check("identical trees compare clean", r1.compared == 2 and r1.mismatched == 0)

    val shifted = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 24, w: 100, h: 50, features: "")
    ]
    val r2 = geometry_diff(chrome, shifted, 1)
    check("a 14px y shift is one mismatch", r2.mismatched == 1)
    check("delta y is reported", r2.rows[0].dy == 14)
    check("mismatch is clustered by the chrome feature", r2.rows[0].feature == "flex")

    val missing = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: "")
    ]
    val r3 = geometry_diff(chrome, missing, 1)
    check("an element absent from Simple is not a silent pass",
          r3.missing_in_simple == 1 and r3.compared == 1)

    val extra = [
        GeomBox(key: "path:", tag: "body", x: 0, y: 0, w: 900, h: 600, features: ""),
        GeomBox(key: "path:0", tag: "div", x: 10, y: 10, w: 100, h: 50, features: ""),
        GeomBox(key: "path:1", tag: "div", x: 0, y: 0, w: 1, h: 1, features: "")
    ]
    val r4 = geometry_diff(chrome, extra, 1)
    check("an element Chrome does not have is counted", r4.missing_in_chrome == 1)

    check("grid outranks flex in classification",
          classify_feature("display=grid;float=none") == "grid")
    check("absolute position is clustered", classify_feature("display=block;position=absolute") == "position")
    check("float is clustered", classify_feature("display=block;position=static;float=left") == "float")
    check("plain block flow is the fallback bucket",
          classify_feature("display=block;position=static;float=none") == "block-flow")

    check("differ selftest passes", selftest_report().contains("SELFTEST PASS"))

    print(examples.to_string() + " examples, " + failures.to_string() + " failures")
