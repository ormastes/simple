# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Focused browser backend coverage for the shared widget matrix sample.

use std.spec.step

use std.spec.*

use nogc_sync_mut.ui.parse.sdn_tree.{parse_ui_to_tree}
use common.ui.state.{init_state}
use app.ui.browser.backend.{BrowserBackend}
use std.gc_async_mut.ui.web_render_pixel_backend.{web_render_resolved_engine2d_backend_name}


describe "GUI widget matrix browser backend":
    # @manual scenario evidence

    it "renders through the shared web API without a document shell":
        # @req REQ-SSPEC-APP
        step("renders through the shared web API without a document shell")
        val tree_result = parse_ui_to_tree("examples/06_io/ui/widget_matrix.ui.sdn")
        match tree_result:
            Err(e):
                expect(e).to_equal("")
            Ok(tree):
                val state = init_state(tree)
                val backend_result = BrowserBackend.create(64, 48, "software")
                match backend_result:
                    Err(e):
                        expect(e).to_equal("")
                    Ok(backend):
                        val html = backend.render_html(state)
                        expect(html.contains("widget-button")).to_equal(true)
                        expect(html.contains("widget-statusbar")).to_equal(true)
                        expect(html.contains("<html>")).to_equal(false)
                        expect(backend.web_render_target).to_equal("pure_simple")
                        expect(backend.viewport_width()).to_equal(64)
                        expect(backend.viewport_height()).to_equal(48)

    it "keeps canonical Engine2D backend selection visible through the browser adapter":
        # @req REQ-SSPEC-APP
        step("keeps canonical Engine2D backend selection visible through the browser adapter")
        # BrowserBackend must mirror Engine2D's real availability probe (canonical
        # GPU lane when hardware/drivers init, honest "software" fallback on CPU hosts)
        # rather than fabricating unbacked GPU provenance.
        val cuda_expected = web_render_resolved_engine2d_backend_name(64, 48, "cuda")
        val rocm_expected = web_render_resolved_engine2d_backend_name(64, 48, "rocm")
        val opencl_expected = web_render_resolved_engine2d_backend_name(64, 48, "opencl")
        val vulkan_expected = web_render_resolved_engine2d_backend_name(64, 48, "vulkan")
        expect(cuda_expected == "cuda" or cuda_expected == "software").to_equal(true)
        expect(rocm_expected == "rocm" or rocm_expected == "software").to_equal(true)
        expect(opencl_expected == "opencl" or opencl_expected == "software").to_equal(true)
        expect(vulkan_expected == "vulkan" or vulkan_expected == "software").to_equal(true)
        expect(BrowserBackend.create(64, 48, "cuda").unwrap().gpu_backend()).to_equal(cuda_expected)
        expect(BrowserBackend.create(64, 48, "hip").unwrap().gpu_backend()).to_equal(rocm_expected)
        expect(BrowserBackend.create(64, 48, "opencl").unwrap().gpu_backend()).to_equal(opencl_expected)
        expect(BrowserBackend.create(64, 48, "vulkan").unwrap().gpu_backend()).to_equal(vulkan_expected)
        expect(BrowserBackend.create(64, 48, "simd_cpu").unwrap().gpu_backend()).to_equal("cpu_simd")
