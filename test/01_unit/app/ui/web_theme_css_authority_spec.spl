# @req: REQ-APP-UI-001

use std.spec.*
use app.ui.web.html.{generate_css}
use nogc_sync_mut.ui.theme_package.{theme_package_fingerprint}
use app.io.mod.{file_read}

val HTML_SOURCE = "src/app/ui.web/html.spl"
val HTML_CSS_SOURCE = "src/app/ui.web/html_css.spl"
val BROWSER_BACKEND_SOURCE = "src/app/ui.browser/backend.spl"

use std.spec.step

describe "Simple Web theme CSS authority":

    it "resolves a compatibility alias to the content-addressed package CSS":
        # @req: REQ-APP-UI-001
        step("Verify: resolves a compatibility alias to the content-addressed package CSS")
        val fingerprint = theme_package_fingerprint("aetheric_dark")
        val css = generate_css("glass_obsidian_dark")
        expect(css).to_contain("Folder theme package")
        expect(css).to_contain("theme=aetheric_dark")
        expect(css).to_contain("fingerprint={fingerprint}")
        expect(css).to_contain("--ui-accent: #adc6ff")
        expect(css).to_contain("--app-background-image")

    it "preserves package-owned widget overrides":
        # @req: REQ-APP-UI-001
        step("Verify: preserves package-owned widget overrides")
        val css = generate_css("glass_obsidian_dark")
        expect(css).to_contain(".widget-panel.focused, .wm-window.focused")
        expect(css).to_contain("0 0 40px var(--glass-accent)")

    it "does not select the legacy glass CSS generator":
        # @req: REQ-APP-UI-001
        step("Verify: does not select the legacy glass CSS generator")
        val source = file_read(HTML_SOURCE) + file_read(HTML_CSS_SOURCE)
        expect(source.contains("generate_" + "glass_css")).to_equal(false)

    it "accepts installed CSS only when its package fingerprint matches":
        # @req: REQ-APP-UI-001
        step("Verify: accepts installed CSS only when its package fingerprint matches")
        val source = file_read(HTML_SOURCE) + file_read(HTML_CSS_SOURCE)
        expect(source).to_contain("active_theme_source_fingerprint")
        expect(source).to_contain("resolved_theme_fingerprint")
        expect(source).to_contain("installed_fingerprint == resolved_fingerprint")
        expect(source).to_contain("resolved_theme_css")
        expect(source.contains("load_theme_package(")).to_equal(false)

    it "projects the selected package snapshot without carrying its aggregate into the browser frame":
        # @req: REQ-APP-UI-001
        step("Verify: projects the selected package snapshot without carrying its aggregate into the browser frame")
        val source = file_read(BROWSER_BACKEND_SOURCE)
        expect(source).to_contain("theme_package_render_snapshot(state.tree.theme_name())")
        expect(source.contains("load_theme_package(")).to_equal(false)

    it "replaces only root attributes owned by the theme envelope":
        # @req: REQ-APP-UI-001
        step("Verify: replaces only root attributes owned by the theme envelope")
        val source = file_read("src/app/ui.web/wm.js")
        expect(source).to_contain("_applyThemeRootAttrs(rootAttrs)")
        expect(source).to_contain("root.removeAttribute(attrName)")
        expect(source).to_contain("Object.prototype.hasOwnProperty.call(entry, 'root_attrs')")
        expect(source).to_contain("if (hasRootAttrs) envelope.root_attrs = root_attrs")
        expect(source.contains("startsWith('data-wm-')")).to_equal(false)
