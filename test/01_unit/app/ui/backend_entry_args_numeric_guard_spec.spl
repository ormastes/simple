# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.ui.backend_entry_args.{parse_ui_port_or_default}

describe "ui backend entry args numeric guard":
    it "defaults malformed port values":
        val source = rt_file_read_text("src/app/ui/backend_entry_args.spl") ?? ""

        expect(source).to_contain("pub fn parse_ui_port_or_default(value: text, default: i32) -> i32")
        expect(source).to_contain("trimmed.to_int() ?? default")
        expect(source.contains("trimmed.to_int()\n")).to_equal(false)
