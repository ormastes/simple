"""
## Purpose and audience
Purpose: Prove that browser backend pixel hot paths.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-UI-001 — stable requirement identity for this spec.
use std.spec.*
use common.ui.builder.{panel, text_widget, build_tree_with_title}
use common.ui.state.{init_state}
use app.ui.browser.backend.{BrowserBackend}
use std.gc_async_mut.gpu.browser_engine.simple_web_engine2d_renderer.{
    simple_web_html_needs_selector_layout,
    simple_web_engine2d_render_html_pixels
}

describe "browser backend pixel hot paths":

    it "converts the default framebuffer to host pixels once and reuses the cache":
        step("Verify: converts the default framebuffer to host pixels once and reuses the cache")
        # @req: REQ-APP-UI-001
        val backend = BrowserBackend.create(4, 3, "software").unwrap()
        val first = backend.pixels_rgba_i64()
        expect(first.len()).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(first[0]).to_equal(0x2D2D2D)
        expect(backend.present_pixels_cache_stores).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(backend.present_pixels_cache_hits).to_equal(0)  # oracle: 0 — named expected value from the requirement

        val second = backend.pixels_rgba_i64()
        expect(second.len()).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(second[11]).to_equal(0x2D2D2D)
        expect(backend.present_pixels_cache_stores).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(backend.present_pixels_cache_hits).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "serializes the framebuffer as stable P3 ppm text":
        step("Verify: serializes the framebuffer as stable P3 ppm text")
        val backend = BrowserBackend.create(2, 1, "software").unwrap()
        val ppm = backend.snapshot_ppm_text()
        expect(ppm).to_start_with("P3\n2 1\n255\n")
        expect(ppm).to_contain("45 45 45")

    it "keeps native backend aliases available for preferred graphical lanes":
        step("Verify: keeps native backend aliases available for preferred graphical lanes")
        expect(BrowserBackend.create(8, 8, "metal").unwrap().gpu_backend()).to_equal("metal")
        expect(BrowserBackend.create(8, 8, "cuda").unwrap().gpu_backend()).to_equal("cuda")
        expect(BrowserBackend.create(8, 8, "hip").unwrap().gpu_backend()).to_equal("rocm")
        expect(BrowserBackend.create(8, 8, "vulkan").unwrap().gpu_backend()).to_equal("vulkan")

    it "collects wide render layout entries without dropping hit-test boxes":
        step("Verify: collects wide render layout entries without dropping hit-test boxes")
        val root = panel("wide_layout_root", "Wide Layout", [
            text_widget("wide_layout_0", "zero"),
            text_widget("wide_layout_1", "one"),
            text_widget("wide_layout_2", "two"),
            text_widget("wide_layout_3", "three"),
            text_widget("wide_layout_4", "four"),
            text_widget("wide_layout_5", "five"),
            text_widget("wide_layout_6", "six"),
            text_widget("wide_layout_7", "seven")
        ])
        val state = init_state(build_tree_with_title(root, "Wide Layout", "dark"))
        val backend = BrowserBackend.create(120, 96, "software").unwrap()

        backend.render_frame(state.tree, state)

        expect(backend.layout_cache.len()).to_be_greater_than(8)

    it "keeps a page on the fast path when its class and id selectors are resolvable":
        step("Verify: keeps a page on the fast path when its class and id selectors are resolvable")
        # Pre-fix, ANY `.` or `#` in <style> forced the slow layout path. This
        # selector names the first block's own first class, so the substring
        # heuristic resolves it directly.
        val resolvable = "<html><body><div id='hero' class='card'>" +
            "<style>.card { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_false(simple_web_html_needs_selector_layout(resolvable))

        val by_id = "<html><body><div id='hero' class='card'>" +
            "<style>#hero { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_false(simple_web_html_needs_selector_layout(by_id))

        val tag_qualified = "<html><body><div id='hero' class='card'>" +
            "<style>div.card { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_false(simple_web_html_needs_selector_layout(tag_qualified))

    it "routes to the real layout engine when several rules set a background":
        step("Verify: routes to the real layout engine when several rules set a background")
        # The heuristic paints a phantom SECOND block from the second
        # background-color in source order, so it cannot faithfully reproduce a
        # style block with more than one background-setting rule even when every
        # selector is individually resolvable.
        val two_rules = "<html><body><div id='hero' class='card'>" +
            "<style>#hero { background-color: #202020; } " +
            ".card { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_true(simple_web_html_needs_selector_layout(two_rules))

    it "routes to the real layout engine when a selector is not resolvable":
        step("Verify: routes to the real layout engine when a selector is not resolvable")
        val descendant = "<html><body><div id='hero' class='card'>" +
            "<style>body .card { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_true(simple_web_html_needs_selector_layout(descendant))

        val foreign_class = "<html><body><div id='hero' class='card'>" +
            "<style>.sidebar { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_true(simple_web_html_needs_selector_layout(foreign_class))

        val pseudo = "<html><body><div id='hero' class='card'>" +
            "<style>.card:hover { background-color: #303030; }</style>" +
            "</div></body></html>"
        assert_true(simple_web_html_needs_selector_layout(pseudo))

    it "renders a class styled page to a full pixel buffer":
        step("Verify: renders a class styled page to a full pixel buffer")
        val html = "<html><body style='background-color: #204060'>" +
            "<div id='hero' class='card'></div>" +
            "<style>.card { background-color: #a0b0c0; }</style>" +
            "</body></html>"
        val pixels = simple_web_engine2d_render_html_pixels(html, 8, 4, "software")
        expect(pixels.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(pixels[0]).to_equal(0xFF204060u32)

    it "never paints an overridden class or id colour":
        step("Verify: never paints an overridden class or id colour")
        # Three rules target the SAME element. The CSS-correct winner is
        # `#hero` (id specificity 1-0-0) — NOT the last `.card` rule, since
        # specificity outranks source order. Only that colour may reach the
        # framebuffer. The substring heuristic gets this wrong twice: it takes
        # the last `.card` rule as the block colour AND paints the second
        # background-color as a phantom sibling block. So if a future widening
        # of `_selector_token_is_resolvable` (or removal of the multi-background
        # guard) lets this page onto the fast path, this example goes red.
        val html = "<html><body style='background-color: #204060'>" +
            "<div id='hero' class='card'></div>" +
            "<style>.card { background-color: #ff0000; } " +
            "#hero { background-color: #00ff00; } " +
            ".card { background-color: #0000ff; }</style>" +
            "</body></html>"
        assert_true(simple_web_html_needs_selector_layout(html))

        val pixels = simple_web_engine2d_render_html_pixels(html, 48, 40, "software")
        expect(pixels.len()).to_equal(1920)  # oracle: 1920 — named expected value from the requirement
        var saw_winner = false
        var saw_overridden = false
        var i = 0
        while i < pixels.len():
            val p = pixels[i]
            if p == 0xFF00FF00u32:
                saw_winner = true
            if p == 0xFFFF0000u32 or p == 0xFF0000FFu32:
                saw_overridden = true
            i = i + 1
        assert_true(saw_winner)
        assert_false(saw_overridden)
