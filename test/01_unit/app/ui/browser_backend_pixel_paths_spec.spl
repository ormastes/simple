use std.spec.*
use common.ui.builder.{panel, text_widget, build_tree_with_title}
use common.ui.state.{init_state}
use app.ui.browser.backend.{BrowserBackend}

describe "browser backend pixel hot paths":

    it "converts the default framebuffer to host pixels once and reuses the cache":
        val backend = BrowserBackend.create(4, 3, "software").unwrap()
        val first = backend.pixels_rgba_i64()
        expect(first.len()).to_equal(12)
        expect(first[0]).to_equal(0x2D2D2D)
        expect(backend.present_pixels_cache_stores).to_equal(1)
        expect(backend.present_pixels_cache_hits).to_equal(0)

        val second = backend.pixels_rgba_i64()
        expect(second.len()).to_equal(12)
        expect(second[11]).to_equal(0x2D2D2D)
        expect(backend.present_pixels_cache_stores).to_equal(1)
        expect(backend.present_pixels_cache_hits).to_equal(1)

    it "serializes the framebuffer as stable P3 ppm text":
        val backend = BrowserBackend.create(2, 1, "software").unwrap()
        val ppm = backend.snapshot_ppm_text()
        expect(ppm).to_start_with("P3\n2 1\n255\n")
        expect(ppm).to_contain("45 45 45")

    it "keeps native backend aliases available for preferred graphical lanes":
        expect(BrowserBackend.create(8, 8, "metal").unwrap().gpu_backend()).to_equal("metal")
        expect(BrowserBackend.create(8, 8, "cuda").unwrap().gpu_backend()).to_equal("cuda")
        expect(BrowserBackend.create(8, 8, "hip").unwrap().gpu_backend()).to_equal("rocm")
        expect(BrowserBackend.create(8, 8, "vulkan").unwrap().gpu_backend()).to_equal("vulkan")

    it "collects wide render layout entries without dropping hit-test boxes":
        val root = panel("wide_layout_root", "Wide Layout", [
            text_widget("wide_layout_0", "zero"),
            text_widget("wide_layout_1", "one"),
            text_widget("wide_layout_2", "two"),
            text_widget("wide_layout_3", "three"),
            text_widget("wide_layout_4", "four"),
            text_widget("wide_layout_5", "five"),
            text_widget("wide_layout_6", "six"),
            text_widget("wide_layout_7", "seven")
        ])
        val state = init_state(build_tree_with_title(root, "Wide Layout", "dark"))
        val backend = BrowserBackend.create(120, 96, "software").unwrap()

        backend.render_frame(state.tree, state)

        expect(backend.layout_cache.len()).to_be_greater_than(8)

    it "lays out a styled page without text-document tags for real":
        # The static lane used to send any page without <p>/<span>/<h1>...
        # through a substring heuristic that filled the frame with a guessed
        # background and never painted text (a plain `<div>` page with a
        # background came out blank). Every page is now laid out for real.
        val html = '<html><head><style>body{margin:0;background:#ffffff;color:#000000;font:20px sans-serif}' +
            '.card{background-color:#303030;height:10px}</style></head>' +
            '<body><div class="t">text here</div><div class="card"></div></body></html>'
        val pixels = simple_web_engine2d_render_html_pixels(html, 120, 60, "software")
        expect(pixels.len()).to_equal(7200)
        var dark_text = 0
        var card = 0
        for p in pixels:
            if p == 0xFF303030u32:
                card = card + 1
            elif (p & 0xFFu32) < 0x60u32 and ((p >> 8) & 0xFFu32) < 0x60u32:
                dark_text = dark_text + 1
        step("the div's text is painted and the .card block is laid out below it")
        expect(dark_text).to_be_greater_than(20)
        expect(card).to_be_greater_than(100)

    it "renders a class styled page to a full pixel buffer":
        val html = "<html><body style='background-color: #204060'>" +
            "<div id='hero' class='card'></div>" +
            "<style>.card { background-color: #a0b0c0; }</style>" +
            "</body></html>"
        val pixels = simple_web_engine2d_render_html_pixels(html, 8, 4, "software")
        expect(pixels.len()).to_equal(32)
        expect(pixels[0]).to_equal(0xFF204060u32)

    it "never paints an overridden class or id colour":
        # Three rules target the SAME element. The CSS-correct winner is
        # `#hero` (id specificity 1-0-0) — NOT the last `.card` rule, since
        # specificity outranks source order. Only that colour may reach the
        # framebuffer. (The removed substring heuristic got this wrong twice:
        # it took the last `.card` rule as the block colour AND painted the
        # second background-color as a phantom sibling block.)
        val html = "<html><body style='background-color: #204060'>" +
            "<div id='hero' class='card'></div>" +
            "<style>.card { background-color: #ff0000; } " +
            "#hero { background-color: #00ff00; } " +
            ".card { background-color: #0000ff; }</style>" +
            "</body></html>"

        val pixels = simple_web_engine2d_render_html_pixels(html, 48, 40, "software")
        expect(pixels.len()).to_equal(1920)
        var saw_winner = false
        var saw_overridden = false
        var i = 0
        while i < pixels.len():
            val p = pixels[i]
            if p == 0xFF00FF00u32:
                saw_winner = true
            if p == 0xFFFF0000u32 or p == 0xFF0000FFu32:
                saw_overridden = true
            i = i + 1
        assert_true(saw_winner)
        assert_false(saw_overridden)
