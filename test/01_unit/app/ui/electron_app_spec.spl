"""
## Purpose and audience
Purpose: Prove that Electron Backend Creation.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-UI-001 — stable requirement identity for this spec.
# Feature: Electron Backend IPC and Rendering
# Category: UI Components
# Status: Implemented

use std.spec.*

use app.ui.electron.backend.{ElectronBackend}
use common.ui.widget.{UIEvent}


# ============================================================================
# Test Group 1: Electron Backend Creation
# ============================================================================

describe "Electron Backend Creation":

    it "creates successfully":
        step("Verify: creates successfully")
        # @req: REQ-APP-UI-001
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("electron")
                expect(backend.viewport_width()).to_equal(1280)  # oracle: 1280 — named expected value from the requirement
                expect(backend.viewport_height()).to_equal(720)  # oracle: 720 — named expected value from the requirement
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")

    it "reports backend name":
        step("Verify: reports backend name")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("electron")
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")


# ============================================================================
# Test Group 2: Lifecycle
# ============================================================================

describe "Electron Backend Lifecycle":

    it "initializes successfully":
        step("Verify: initializes successfully")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                val init_result = backend.init()
                match init_result:
                    Ok(initialized) =>
                        expect(initialized).to_equal(true)
                    Err(e) =>
                        expect("ElectronBackend.init failed: {e}").to_equal("")
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")

    it "shuts down cleanly":
        step("Verify: shuts down cleanly")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                val init_result = backend.init()
                match init_result:
                    Ok(initialized) =>
                        expect(initialized).to_equal(true)
                    Err(e) =>
                        expect("ElectronBackend.init failed: {e}").to_equal("")
                backend.shutdown()
                expect(backend.backend_name()).to_equal("electron")
                expect(backend.supports_touch()).to_equal(false)
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")


# ============================================================================
# Test Group 3: Capabilities
# ============================================================================

describe "Electron Backend Capabilities":

    it "supports mouse and color and images":
        step("Verify: supports mouse and color and images")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                expect(backend.supports_mouse()).to_equal(true)
                expect(backend.supports_color()).to_equal(true)
                expect(backend.supports_images()).to_equal(true)
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")

    it "does not support touch":
        step("Verify: does not support touch")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                expect(backend.supports_touch()).to_equal(false)
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")


# ============================================================================
# Test Group 4: Viewport
# ============================================================================

describe "Electron Backend Viewport":

    it "has default viewport 1280x720":
        step("Verify: has default viewport 1280x720")
        val result = ElectronBackend.new(3000)
        match result:
            Ok(backend) =>
                expect(backend.viewport_width()).to_equal(1280)  # oracle: 1280 — named expected value from the requirement
                expect(backend.viewport_height()).to_equal(720)  # oracle: 720 — named expected value from the requirement
            Err(e) =>
                expect("ElectronBackend.new failed: {e}").to_equal("")
