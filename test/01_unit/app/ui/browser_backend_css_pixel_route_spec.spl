# @cover src/app/ui.browser/backend.spl
# @tag: unit, ui, browser, css, draw_ir, aetheric

use std.spec.*
use common.ui.web_render_api.{WEB_RENDER_ENGINE2D_STATUS_RENDERED, WEB_RENDER_TARGET_PURE_SIMPLE, web_render_adapter_request, web_render_full_html}
use app.ui.browser.backend.{browser_backend_pure_simple_pixel_artifact}

describe "BrowserBackend default HTML/CSS pixel route":

    it "changes Draw IR material provenance and readback for CSS-only Aetheric input":
        val body = "<main class='aetheric-surface' data-wm-theme-fallback='solid-material' data-wm-theme-material-mode='engine2d-cpu-composited-material-v1' data-wm-theme-bg='#123456'>Aetheric</main>"
        val opaque_css = ".aetheric-surface{width:24px;height:16px;background:#123456;color:#ffffff}"
        val material_css = ".aetheric-surface{width:24px;height:16px;background:rgba(18,52,86,0.72);color:#ffffff;backdrop-filter:blur(12px) saturate(170%)}"
        val opaque_req = web_render_adapter_request(
            WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Aetheric",
            body, opaque_css, "", 24, 16
        )
        val material_req = web_render_adapter_request(
            WEB_RENDER_TARGET_PURE_SIMPLE, "surface", "Aetheric",
            body, material_css, "", 24, 16
        )

        val opaque = browser_backend_pure_simple_pixel_artifact(
            opaque_req, web_render_full_html(opaque_req), "software"
        )
        val material = browser_backend_pure_simple_pixel_artifact(
            material_req, web_render_full_html(material_req), "software"
        )

        expect(opaque.engine2d_status).to_equal(
            WEB_RENDER_ENGINE2D_STATUS_RENDERED
        )
        expect(material.engine2d_status).to_equal(
            WEB_RENDER_ENGINE2D_STATUS_RENDERED
        )
        expect(opaque.material_fallback.kind).to_equal("none")
        expect(material.material_fallback.kind).to_equal(
            "cpu-composited-material"
        )
        expect(material.material_fallback.material_sha256.len()).to_equal(64)
        expect(material.readback_checksum == opaque.readback_checksum).to_be(
            false
        )
        expect(material.pixels == opaque.pixels).to_be(false)
