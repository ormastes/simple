# @tag:unit, ui, web, bootstrap

use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "web HTML generator module split":
    it "keeps every parser input below 350 KiB":
        val facade = rt_file_read_text("src/app/ui.web/html.spl") ?? ""
        val css = rt_file_read_text("src/app/ui.web/html_css.spl") ?? ""
        val preview = rt_file_read_text("src/app/ui.web/html_modern_preview.spl") ?? ""

        expect(facade.len()).to_be_less_than(350 * 1024)
        expect(css.len()).to_be_less_than(350 * 1024)
        expect(preview.len()).to_be_less_than(350 * 1024)

    it "keeps the original API on the facade":
        val facade = rt_file_read_text("src/app/ui.web/html.spl") ?? ""

        expect(facade).to_contain("generate_css as css_generate_css")
        expect(facade).to_contain("generate_wm_modern_preview_html as preview_generate_html")
        expect(facade).to_contain("fn responsive_css(bp: Breakpoints) -> text:")
        expect(facade).to_contain("fn wm_modern_preview_browser_audit_command(")
