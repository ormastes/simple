# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: widget properties arrive as text; integer-typed properties must fall
back to their default when the text is not a clean integer instead of crashing
or silently coercing.
Audience: TUI rendering engineers who maintain the core widget layer.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use app.ui.render._TuiWidgets.core_widgets.{tui_int_or}

describe "tui widget numeric guards":
    # @manual scenario evidence
    it "parses clean integer property text":
        # @req REQ-SSPEC-APP
        step("Verify: clean integer text parses to its value")
        expect(tui_int_or("42", 0)).to_equal(42)  # oracle: exact parse
        expect(tui_int_or(" 7 ", -1)).to_equal(7)  # oracle: surrounding whitespace is trimmed

    it "falls back to the default on malformed integer property text":
        # @req REQ-SSPEC-APP
        step("Verify: malformed integer text falls back to the default")
        expect(tui_int_or("", 3)).to_equal(3)  # oracle: empty uses default
        expect(tui_int_or("12abc", 5)).to_equal(5)  # oracle: trailing garbage uses default
        expect(tui_int_or("active", 0)).to_equal(0)  # oracle: non-numeric label uses default
