# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Terminal size numeric guards — executed against the real parsing functions.

use std.spec.step

use app.ui.tui.screen.{get_terminal_size, parse_mode_con_value}

describe "terminal size numeric guards":
    # @manual scenario evidence
    it "guards environment and probe numeric parsing":
        # @req REQ-SSPEC-APP
        step("guards environment and probe numeric parsing")
        # oracle: well-formed mode-con output parses to its exact numbers
        expect(parse_mode_con_value("    Columns:      120\n    Lines:        30", "columns")).to_equal(120)
        expect(parse_mode_con_value("    Columns:      120\n    Lines:        30", "lines")).to_equal(30)
        # oracle: non-numeric and garbage input must clamp to 0, never a stale/guessed number
        expect(parse_mode_con_value("    Columns:      12x0", "columns")).to_equal(0)
        expect(parse_mode_con_value("    Columns:", "columns")).to_equal(0)
        expect(parse_mode_con_value("garbage without colon", "columns")).to_equal(0)
        # oracle: live terminal probe always returns sane positive dimensions
        val (w, h) = get_terminal_size()
        expect(w > 0).to_equal(true)
        expect(h > 0).to_equal(true)
