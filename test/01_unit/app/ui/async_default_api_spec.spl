# @cover src/app/ui.none/app.spl
# @cover src/app/ui/backend_factory.spl
# @cover src/lib/nogc_sync_mut/ui/session.spl
# @cover src/lib/common/ui/builder.spl

use app.ui.backend_factory.{create_backend, create_sync_backend}
use app.ui.none.app.{HeadlessApp}
use common.ui.builder.{build_tree, label}
use common.ui.state.{init_state}
use nogc_sync_mut.ui.session.{UISession}
use nogc_sync_mut.web_ui.app.{AppConfig}

describe "canonical UI backend and session API":
    it "create_backend returns a headless none backend":
        val result = create_backend("none", 3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("none")
            Err(e) =>
                expect(false).to_equal(true)

    it "AppConfig.default_config provides standard window defaults":
        val config = AppConfig.default_config()
        expect(config.width).to_equal(800)
        expect(config.height).to_equal(600)
        expect(config.target_fps).to_equal(60)

    it "UISession tracks initial tree state and HeadlessApp runs minimal layout":
        val tree = build_tree(label("greeting", "hello"))
        val state = init_state(tree)
        val session = UISession.new(state.tree)
        expect(session.current_state().tree.root.kind_name()).to_equal("text")
        val app_res = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match app_res:
            Ok(app) =>
                expect(app.current_state().tree.title).to_equal("Minimal")
            Err(e) =>
                expect(false).to_equal(true)

    it "keeps sync factory available for legacy callers":
        val result = create_sync_backend("none", 3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("none")
            Err(e) =>
                expect(false).to_equal(true)
