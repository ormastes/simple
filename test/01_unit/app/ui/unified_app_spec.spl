# @cover src/app/ui.none/app.spl
# @cover src/app/ui/backend_factory.spl
# @cover src/lib/nogc_sync_mut/web_ui/app.spl

use nogc_sync_mut.web_ui.app.{AppConfig}
use app.ui.backend_factory.{create_backend}
use app.ui.none.app.{HeadlessApp}

describe "AppConfig":
    it "creates default config":
        val config = AppConfig.default_config()
        expect(config.width).to_equal(800)
        expect(config.height).to_equal(600)
        expect(config.resizable).to_equal(true)
        expect(config.target_fps).to_equal(60)

    it "loads HeadlessApp for valid minimal layout":
        val app_result = HeadlessApp.new("examples/06_io/ui/minimal.ui.sdn")
        match app_result:
            Ok(app) =>
                expect(app.current_state().tree.title).to_equal("Minimal")
                expect(app.current_state().tree.theme).to_equal("glass_dark")
            Err(e) =>
                expect(false).to_equal(true)

describe "create_backend":
    it "creates none backend":
        val result = create_backend("none", 3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("none")
            Err(e) =>
                expect(false).to_equal(true)

    it "creates headless backend":
        val result = create_backend("headless", 3000)
        match result:
            Ok(backend) =>
                expect(backend.backend_name()).to_equal("none")
            Err(e) =>
                expect(false).to_equal(true)

    it "rejects unknown mode":
        val result = create_backend("nonexistent", 3000)
        match result:
            Ok(_) =>
                expect(false).to_equal(true)
            Err(e) =>
                expect(e).to_contain("Unknown backend mode")
