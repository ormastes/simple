use std.spec
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_inlay_hint_query_response, lsp_code_action_query_response}

describe "LSP heavy query completion status":
    it "keeps successful empty output as an empty inlay result":
        expect(lsp_inlay_hint_query_response("17", "", 0)).to_equal("{\"jsonrpc\":\"2.0\",\"id\":17,\"result\":[]}")

    it "keeps successful empty output as an empty action result":
        expect(lsp_code_action_query_response("18", "file:///sample.spl", "", 0)).to_contain("\"result\":[]")

    it "rejects failed inlay children even if they emit usable-looking data":
        val response = lsp_inlay_hint_query_response("19", "1:3:type:1", 7)
        expect(response).to_contain("\"error\":{\"code\":-32603")
        expect(response).to_contain("exit 7")
        expect(response.contains("\"result\"")).to_equal(false)

    it "rejects failed action children even if they emit a title":
        val response = lsp_code_action_query_response("20", "file:///sample.spl", "Apply fix\tquickfix", 2)
        expect(response).to_contain("\"error\":{\"code\":-32603")
        expect(response.contains("\"result\"")).to_equal(false)

    it "reports bounded child timeouts as errors for both operations":
        expect(lsp_inlay_hint_query_response("21", "", 124)).to_contain("LSP query timed out")
        expect(lsp_code_action_query_response("22", "file:///sample.spl", "", 124)).to_contain("LSP query timed out")

    it "preserves actual inlay and refactor results":
        val hint = lsp_inlay_hint_query_response("23", "2:3:i64:1", 0)
        expect(hint).to_contain("\"position\":{\"line\":1,\"character\":3}")
        expect(hint).to_contain("\"label\":\"i64\"")
        val action = lsp_code_action_query_response("24", "file:///sample.spl", "Extract function\trefactor", 0)
        expect(action).to_contain("Extract function")
        expect(action).to_contain("\"kind\":\"refactor\"")
