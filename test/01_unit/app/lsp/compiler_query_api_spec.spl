use std.spec
use std.nogc_sync_mut.io.file_ops.{file_write, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use app.simple_lsp_mcp.lsp_query_inproc.{lsp_query_inproc_dispatch_v1}

fn query_api_fixture_source_v1() -> text:
    """fn query_api_target_v1(value: i64) -> i64:
    value

fn query_api_caller_v1() -> i64:
    query_api_target_v1(7)
"""

describe "production LSP query API":
    it "answers definition, hover, and references for a parsed source symbol":
        step("Write a real Simple source file and query its declared function")
        val root = secure_temp_dir("/tmp", "simple-lsp-query-api-v1-").unwrap()
        val path = root + "/fixture.spl"
        val wrote = file_write(path, query_api_fixture_source_v1())
        expect(wrote).to_equal(true)
        val definition = lsp_query_inproc_dispatch_v1("definition", path, 1, 5)
        val hover = lsp_query_inproc_dispatch_v1("hover", path, 1, 5)
        val references = lsp_query_inproc_dispatch_v1("references", path, 5, 8)
        dir_remove_all(root)

        expect(definition.handled).to_equal(true)
        expect(definition.code).to_equal(0)
        expect(definition.text).to_contain(path + ":1: [fn] fn query_api_target_v1(value: i64) -> i64:")
        expect(hover.handled).to_equal(true)
        expect(hover.code).to_equal(0)
        expect(hover.text).to_contain("Symbol: query_api_target_v1")
        expect(hover.text).to_contain("Signature:")
        expect(references.handled).to_equal(true)
        expect(references.code).to_equal(0)
        expect(references.text).to_contain(path + ":1:")
        expect(references.text).to_contain(path + ":5:")

    it "resolves a selected shadow binding and excludes non-reference text":
        step("Use a real source file with a global function and a local shadow")
        val root = secure_temp_dir("/tmp", "simple-lsp-query-shadow-v1-").unwrap()
        val path = root + "/fixture.spl"
        val source = """fn query_shadow_v1(value: i64) -> i64:
    value

fn query_global_call_v1() -> i64:
    query_shadow_v1(1)

fn query_local_call_v1() -> i64:
    val query_shadow_v1 = 2
    return query_shadow_v1
# query_shadow_v1 is only a comment
val query_note_v1 = "query_shadow_v1"
"""
        val wrote = file_write(path, source)
        expect(wrote).to_equal(true)
        val definition = lsp_query_inproc_dispatch_v1("definition", path, 9, 17)
        val references = lsp_query_inproc_dispatch_v1("references", path, 9, 17)
        dir_remove_all(root)

        expect(definition.handled).to_equal(true)
        expect(definition.code).to_equal(0)
        expect(definition.text).to_contain(path + ":8:")
        expect(definition.text.contains(path + ":1:")).to_equal(false)
        expect(references.handled).to_equal(true)
        expect(references.code).to_equal(0)
        expect(references.text).to_contain(path + ":8:")
        expect(references.text).to_contain(path + ":9:")
        expect(references.text.contains(path + ":1:")).to_equal(false)
        expect(references.text.contains(path + ":5:")).to_equal(false)
        expect(references.text.contains(path + ":10:")).to_equal(false)
        expect(references.text.contains(path + ":11:")).to_equal(false)
