# LSP Semantic Tokens Handler Tests
# Feature: Language Server Protocol Semantic Token Recognition
# Category: LSP, Editor Integration
# Status: Complete
#
# Unit tests for LSP semantic tokens handler including token type
# recognition for keywords, identifiers, functions, types, and comments.

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
struct Position:
    line: i64
    character: i64

1. Run `bin/simple test test/01_unit/app/lsp/semantic_tokens_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/semantic_tokens.md
# doc-path: doc/03_plan/sys_test/semantic_tokens.md
# doc-path: doc/04_architecture/semantic_tokens.md
# doc-path: doc/05_design/semantic_tokens.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-APP-LSP-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-APP-LSP-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "boolean operators short-circuit to expected truth table":
        step("Verify: boolean operators short-circuit to expected truth table")
        # @req: REQ-APP-LSP-001
        expect(true and false).to_equal(false)
        expect(true or false).to_equal(true)
        expect(not true).to_equal(false)

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-APP-LSP-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-APP-LSP-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right

fn get_visibility_token_modifiers_legend() -> List<str>:
    [
        "declaration",
        "definition",
        "readonly",
        "static",
        "deprecated",
        "abstract",
        "async",
        "modification",
        "documentation",
        "simple.visibility.public",
        "simple.visibility.boundary",
        "simple.visibility.private"
    ]

fn visibility_modifier_for(kind: str) -> str:
    match kind:
        case "public":
            "simple.visibility.public"
        case "boundary":
            "simple.visibility.boundary"
        case "private":
            "simple.visibility.private"
        case _:
            "documentation"

describe "Semantic Tokens Handler":
    # Tests for semantic token recognition by token type.
    it "tokenizes keywords":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("keyword", 0, 0, 3))  # val
        handler.add_token(SemanticToken.new("keyword", 0, 8, 2))  # fn
        var tokens = handler.get_tokens()
        check(tokens.len() == 2)

    it "tokenizes identifiers":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("variable", 0, 4, 1))  # x
        handler.add_token(SemanticToken.new("function", 0, 8, 6))  # my_func
        var tokens = handler.get_tokens()
        check(tokens.len() == 2)

    it "tokenizes functions":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("function", 1, 0, 10))  # my_function
        var tokens = handler.get_tokens()
        check(tokens.len() == 1)

    it "tokenizes types":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("type", 0, 8, 3))  # i64
        handler.add_token(SemanticToken.new("type", 0, 16, 4))  # List
        var tokens = handler.get_tokens()
        check(tokens.len() == 2)

    it "tokenizes comments":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("comment", 0, 0, 15))  # # This is comment
        var tokens = handler.get_tokens()
        check(tokens.len() == 1)

    it "encodes delta positions":
        val handler = MockSemanticTokenHandler.new()
        handler.add_token(SemanticToken.new("keyword", 0, 0, 3))
        handler.add_token(SemanticToken.new("variable", 0, 4, 1))
        handler.add_token(SemanticToken.new("operator", 1, 2, 1))
        var tokens = handler.get_tokens()
        check(tokens.len() == 3)

    it "includes visibility modifiers in the legend":
        val legend = get_visibility_token_modifiers_legend()
        check(legend.len() >= 12)
        check(legend.contains("simple.visibility.public"))
        check(legend.contains("simple.visibility.boundary"))
        check(legend.contains("simple.visibility.private"))

    it "maps visibility kinds to semantic token modifiers":
        check(visibility_modifier_for("public") == "simple.visibility.public")
        check(visibility_modifier_for("boundary") == "simple.visibility.boundary")
        check(visibility_modifier_for("private") == "simple.visibility.private")
