use std.spec
use std.nogc_sync_mut.io.file_ops.{file_write, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.common.json.parser.{json_parse}
use std.common.json.object_ops.{json_object_get}
use std.common.json.types.{json_get_type, json_to_number, json_to_string}
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_handle_definition}

fn definition_request_body_v1(path: text, line: i64, column: i64) -> text:
    "{\"textDocument\":{\"uri\":\"file://{path}\"},\"position\":{\"line\":{line},\"character\":{column}}}"

fn definition_response_result_v1(reply: text, expected_id: f64) -> any:
    val response = json_parse(reply)
    expect(response != nil).to_equal(true)
    expect(json_to_string(json_object_get(response, "jsonrpc"))).to_equal("2.0")
    val id = json_object_get(response, "id")
    expect(json_get_type(id)).to_equal("number")
    expect(json_to_number(id)).to_equal(expected_id)
    expect(json_object_get(response, "error")).to_be_nil()
    json_object_get(response, "result")

describe "LSP definition handler":
    it "returns the actual declaration location for a selected function call":
        step("Write a real source file and decode the production definition response")
        val root = secure_temp_dir("/tmp", "simple-lsp-definition-v1-").unwrap()
        val path = root + "/fixture.spl"
        val source = """fn lsp_definition_target_v1(value: i64) -> i64:
    value

fn lsp_definition_caller_v1() -> i64:
    lsp_definition_target_v1(7)
"""
        val wrote = file_write(path, source)
        expect(wrote).to_equal(true)
        val reply = lsp_handle_definition("1", definition_request_body_v1(path, 4, 8))
        dir_remove_all(root)

        val result = definition_response_result_v1(reply, 1.0)
        expect(json_get_type(result)).to_equal("object")
        expect(json_to_string(json_object_get(result, "uri"))).to_equal("file://" + path)
        val range = json_object_get(result, "range")
        expect(json_get_type(range)).to_equal("object")
        val start = json_object_get(range, "start")
        val end = json_object_get(range, "end")
        expect(json_get_type(start)).to_equal("object")
        expect(json_get_type(end)).to_equal("object")
        expect(json_to_number(json_object_get(start, "line"))).to_equal(0.0)
        expect(json_to_number(json_object_get(start, "character"))).to_equal(3.0)
        expect(json_to_number(json_object_get(end, "line"))).to_equal(0.0)
        expect(json_to_number(json_object_get(end, "character"))).to_equal(3.0)
