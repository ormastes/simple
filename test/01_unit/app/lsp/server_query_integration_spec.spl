use std.spec
use std.nogc_sync_mut.io.file_ops.{file_write, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.common.json.parser.{json_parse}
use std.common.json.object_ops.{json_object_get}
use std.common.json.array_ops.{json_array_get, json_array_length}
use std.common.json.types.{json_get_type, json_to_number, json_to_string}
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_handle_definition, lsp_handle_references}

fn server_query_body_v1(path: text, line: i64, column: i64) -> text:
    "{\"textDocument\":{\"uri\":\"file://{path}\"},\"position\":{\"line\":{line},\"character\":{column}},\"context\":{\"includeDeclaration\":true}}"

fn server_query_response_result_v1(reply: text, expected_id: f64) -> any:
    val response = json_parse(reply)
    expect(response != nil).to_equal(true)
    expect(json_to_string(json_object_get(response, "jsonrpc"))).to_equal("2.0")
    val id = json_object_get(response, "id")
    expect(json_get_type(id)).to_equal("number")
    expect(json_to_number(id)).to_equal(expected_id)
    expect(json_object_get(response, "error")).to_be_nil()
    json_object_get(response, "result")

fn server_query_location_line_v1(location: any, path: text) -> any?:
    expect(json_get_type(location)).to_equal("object")
    expect(json_to_string(json_object_get(location, "uri"))).to_equal("file://" + path)
    val range = json_object_get(location, "range")
    expect(json_get_type(range)).to_equal("object")
    val start = json_object_get(range, "start")
    val end = json_object_get(range, "end")
    expect(json_get_type(start)).to_equal("object")
    expect(json_get_type(end)).to_equal("object")
    expect(json_get_type(json_object_get(start, "line"))).to_equal("number")
    expect(json_get_type(json_object_get(start, "character"))).to_equal("number")
    expect(json_get_type(json_object_get(end, "line"))).to_equal("number")
    expect(json_get_type(json_object_get(end, "character"))).to_equal("number")
    json_to_number(json_object_get(start, "line"))

describe "LSP server query integration":
    it "keeps definition and references attached to the selected local symbol":
        step("Decode actual LSP responses for a shadowed symbol, including declaration context")
        val root = secure_temp_dir("/tmp", "simple-lsp-server-query-v1-").unwrap()
        val path = root + "/fixture.spl"
        val source = """fn lsp_scope_target_v1(value: i64) -> i64:
    value

fn lsp_scope_global_use_v1() -> i64:
    lsp_scope_target_v1(1)

fn lsp_scope_local_use_v1() -> i64:
    val lsp_scope_target_v1 = 2
    return lsp_scope_target_v1
# lsp_scope_target_v1 in a comment
val lsp_scope_note_v1 = "lsp_scope_target_v1"
"""
        val wrote = file_write(path, source)
        expect(wrote).to_equal(true)
        val body = server_query_body_v1(path, 8, 17)
        val definition_reply = lsp_handle_definition("3", body)
        val references_reply = lsp_handle_references("4", body)
        dir_remove_all(root)

        val definition = server_query_response_result_v1(definition_reply, 3.0)
        expect(json_get_type(definition)).to_equal("object")
        expect(server_query_location_line_v1(definition, path)).to_equal(7.0)

        val references = server_query_response_result_v1(references_reply, 4.0)
        expect(json_get_type(references)).to_equal("array")
        expect(json_array_length(references)).to_equal(2)
        var declaration_seen = false
        var use_seen = false
        var i = 0
        while i < json_array_length(references):
            val line = server_query_location_line_v1(json_array_get(references, i), path)
            if line == 7.0:
                declaration_seen = true
            if line == 8.0:
                use_seen = true
            expect(line == 0.0 or line == 4.0 or line == 9.0 or line == 10.0).to_equal(false)
            i = i + 1
        expect(declaration_seen).to_equal(true)
        expect(use_seen).to_equal(true)
