# Native acceptance entry for the resident visibility provider using production
# document synchronization, handler, and app composition modules.
use std.nogc_sync_mut.io.file_ops.{file_write, file_read, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.nogc_sync_mut.lsp.lsp_document_sync.{lsp_document_sync_apply}
use std.nogc_sync_mut.lsp.lsp_handlers.{lsp_handle_document_symbol, lsp_handle_did_close}
use app.lsp.visibility_provider_v1.{lsp_install_visibility_provider_v1}

fn main() -> i64:
    val root = secure_temp_dir("/tmp", "simple-lsp-overlay-native-probe-").unwrap()
    val path = root + "/fixture.spl"
    val saved = "fn disk_only_probe_v1() -> i64: 1"
    val unsaved = "fn overlay_only_probe_v1() -> i64: 2"
    if not file_write(path, saved): return 1
    lsp_install_visibility_provider_v1()
    val uri = "file://" + path
    val opened = "{\"textDocument\":{\"uri\":\"{uri}\",\"languageId\":\"simple\",\"version\":1,\"text\":\"{saved}\"}}"
    val changed = "{\"textDocument\":{\"uri\":\"{uri}\",\"version\":2},\"contentChanges\":[{\"text\":\"{unsaved}\"}]}"
    if not lsp_document_sync_apply("textDocument/didOpen", opened): return 2
    if not lsp_document_sync_apply("textDocument/didChange", changed): return 3
    val reply = lsp_handle_document_symbol("1", "{\"textDocument\":{\"uri\":\"{uri}\"}}")
    val disk = file_read(path)
    lsp_handle_did_close("{\"textDocument\":{\"uri\":\"{uri}\"}}")
    val closed_reply = lsp_handle_document_symbol("2", "{\"textDocument\":{\"uri\":\"{uri}\"}}")
    dir_remove_all(root)
    if not reply.contains("overlay_only_probe_v1"): return 4
    if reply.contains("disk_only_probe_v1"): return 5
    if disk != saved: return 6
    if not closed_reply.contains("disk_only_probe_v1"): return 7
    if closed_reply.contains("overlay_only_probe_v1"): return 8
    print "LSP_OVERLAY_PROBE_PASS"
    # A zero-return stub cannot satisfy both the output and this sentinel.
    77
