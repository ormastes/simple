# LSP Completion Handler Tests
# Feature: Language Server Protocol Completion
# Category: LSP, Editor Integration
# Status: Complete
#
# Unit tests for LSP completion handler including CompletionItemKind
# enum values and CompletionItem builder pattern.

## Operator workflow
Run `bin/simple test test/unit/app/lsp/completion_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-APP-APP_TOOL-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/app_tool_behavior.md
# doc-path: doc/03_plan/sys_test/app_tool_behavior.md
# doc-path: doc/04_architecture/lib/app_tool.md
# doc-path: doc/05_design/lib/app_tool_oracles.md
# @manual: primary

use std.spec
use std.io.{env_get, process_run}
use std.spec.step

describe "App tool execution behavior":
    it "a tool invocation passes arguments through to the child":
        step("Verify: a tool invocation passes arguments through to the child")
        # @req: REQ-APP-APP_TOOL-001
        val (stdout, _stderr, _code) = process_run("/bin/echo", ["wave6-flag"])
        expect(stdout).to_contain("wave6-flag")  # oracle: the flag reaches the child process

    it "a failing command reports a nonzero exit status":
        step("Verify: a failing command reports a nonzero exit status")
        # @req: REQ-APP-APP_TOOL-001
        val (_out, _err, code) = process_run("/bin/false", [])
        expect((code != 0)).to_equal(true)  # oracle: failure surfaces as a nonzero status

fn completion_item_kind_number(kind: CompletionItemKind) -> i64:
    match kind:
        case CompletionItemKind.Text:
            1
        case CompletionItemKind.Method:
            2
        case CompletionItemKind.Function:
            3
        case CompletionItemKind.Variable:
            6
        case CompletionItemKind.Keyword:
            14
        case CompletionItemKind.Struct:
            22
        case CompletionItemKind.Snippet:
            25

class CompletionItem:
    label: text
    kind: CompletionItemKind
    detail: Option<text>
    documentation: Option<text>
    insert_text: Option<text>

impl CompletionItem:
    static fn new(label: text, kind: CompletionItemKind) -> CompletionItem:
        CompletionItem(label: label, kind: kind, detail: nil, documentation: nil, insert_text: nil)

    fn with_detail(detail: text) -> CompletionItem:
        CompletionItem(label: self.label, kind: self.kind, detail: Some(detail), documentation: self.documentation, insert_text: self.insert_text)

    fn with_documentation(documentation: text) -> CompletionItem:
        CompletionItem(label: self.label, kind: self.kind, detail: self.detail, documentation: Some(documentation), insert_text: self.insert_text)

    fn with_insert_text(insert_text: text) -> CompletionItem:
        CompletionItem(label: self.label, kind: self.kind, detail: self.detail, documentation: self.documentation, insert_text: Some(insert_text))



describe "CompletionItemKind":
    # Tests for LSP completion item kind enum values.
    it "has Text kind":
        expect completion_item_kind_number(CompletionItemKind.Text) == 1

    it "has Method kind":
        expect completion_item_kind_number(CompletionItemKind.Method) == 2

    it "has Function kind":
        expect completion_item_kind_number(CompletionItemKind.Function) == 3

    it "has Variable kind":
        expect completion_item_kind_number(CompletionItemKind.Variable) == 6

    it "has Keyword kind":
        expect completion_item_kind_number(CompletionItemKind.Keyword) == 14

    it "has Struct kind":
        expect completion_item_kind_number(CompletionItemKind.Struct) == 22

describe "CompletionItem":
    it "creates item with label and kind":
        val item = CompletionItem.new("test", CompletionItemKind.Variable)
        expect item.label == "test"
        expect item.kind == CompletionItemKind.Variable

    it "adds detail":
        val item = CompletionItem.new("fn", CompletionItemKind.Keyword)
            .with_detail("Function keyword")
        expect item.detail == Some("Function keyword")

    it "adds documentation":
        val item = CompletionItem.new("fn", CompletionItemKind.Keyword)
            .with_documentation("Define a function")
        expect item.documentation == Some("Define a function")

    it "adds insert text":
        val item = CompletionItem.new("fn", CompletionItemKind.Snippet)
            .with_insert_text("fn ${1:name}():\n    ${0}")
        expect item.insert_text != nil

    it "chains builder methods":
        val item = CompletionItem.new("struct", CompletionItemKind.Keyword)
            .with_detail("Define a struct")
            .with_documentation("Struct definitions create custom types")
        expect item.detail != nil
        expect item.documentation != nil
