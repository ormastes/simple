use std.spec.{describe, it, expect}
use app.optimize.collection_typed_plan_cli.{collection_typed_plan_options}
use app.optimize.main.{parse_optimize_args}

describe "typed collection explanation option admission":
    it "rejects conflicting original flags and explicitly empty policy":
        val duplicate = parse_optimize_args(["fixture.spl", "--explain-collection-plan",
            "--collection-policy=moderate", "--collection-policy=critical"])
        expect(duplicate.collection_option_error).to_contain("duplicate")
        val empty = parse_optimize_args(["fixture.spl", "--collection-policy="])
        expect(empty.collection_option_error).to_contain("requires a value")
        val budgets = parse_optimize_args(["fixture.spl", "--collection-memory-budget=0",
            "--collection-memory-budget=512"])
        expect(budgets.collection_option_error).to_contain("duplicate")

    it "preserves split planner values and leaves ordinary optimize mode inactive":
        val split = parse_optimize_args(["fixture.spl", "--collection-policy", "critical",
            "--collection-memory-budget", "512"])
        expect(split.collection_policy).to_equal("critical")
        expect(split.file_path).to_equal("fixture.spl")
        expect(split.collection_memory_budget).to_equal("512")
        expect(split.collection_option_error).to_equal("")
        expect(parse_optimize_args(["fixture.spl"]).do_typed_collection_plan).to_be(false)

    it "transports explicit policy budget target and optimization level":
        val admitted = collection_typed_plan_options("critical", "512", "x86_64-unknown-linux-gnu", "O2")
        expect(admitted.is_ok()).to_be(true)
        val options = admitted.unwrap()
        expect(options.collection_policy).to_equal("critical")
        expect(options.collection_memory_budget_bytes).to_equal(512)
        expect(options.native_target).to_equal("x86_64-unknown-linux-gnu")
        expect(options.opt_level ?? -1).to_equal(2)

    it "retains zero budget and O0 rather than enabling an unrequested optimization":
        val admitted = collection_typed_plan_options("moderate", "0", "x86_64-unknown-linux-gnu", "O0")
        expect(admitted.is_ok()).to_be(true)
        val options = admitted.unwrap()
        expect(options.collection_memory_budget_bytes).to_equal(0)
        expect(options.opt_level ?? -1).to_equal(0)
        expect(options.optimize).to_be(false)

    it "rejects unknown policy malformed budget absent target and unknown level":
        expect(collection_typed_plan_options("fast", "512", "x86_64-unknown-linux-gnu", "O2").is_err()).to_be(true)
        for budget in ["", "-1", "12bytes", "9223372036854775808"]:
            expect(collection_typed_plan_options("moderate", budget, "x86_64-unknown-linux-gnu", "O2").is_err()).to_be(true)
        expect(collection_typed_plan_options("moderate", "512", "", "O2").is_err()).to_be(true)
        expect(collection_typed_plan_options("moderate", "512", "x86_64-unknown-linux-gnu", "O4").is_err()).to_be(true)
