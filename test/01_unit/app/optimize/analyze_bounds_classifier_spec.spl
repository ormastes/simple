"""
Optimizer source classifier regression coverage.

Capability declarations must not be reported as runtime bounds checks, while
real indexed value access remains visible to the optimization report.
"""

use std.spec.*
use app.optimize.analyze.{_line_may_index_value}

describe "optimizer bounds-check source classifier":
    it "ignores lexical unsafe capability lists":
        expect(_line_may_index_value("unsafe(capabilities: [ffi]):")).to_equal(false)
        expect(_line_may_index_value("@unsafe(reason: \"raw call\", capabilities: [ffi])")).to_equal(false)

    it "retains actual indexed value access":
        expect(_line_may_index_value("val item = values[index]")).to_equal(true)
        expect(_line_may_index_value("if fields[field_name]:")).to_equal(true)
