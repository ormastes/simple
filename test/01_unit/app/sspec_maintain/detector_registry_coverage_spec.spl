"""
## Purpose and audience
Pins the sspec-maintain scorer's plugin architecture (T2, 2026-09-05): scoring
dimensions/weights live in `dimensions.spl` as a data table, and rule detection
lives as one function per rule_id in a registry (`sspec_source_detectors()` /
`sspec_manual_detectors()` in `analyzer.spl`, plus the repo-backed lifecycle
detector in `lifecycle.spl`). For the engineers who own
`src/app/sspec_maintain/rules.spl`, `dimensions.spl`, `analyzer.spl`,
`lifecycle.spl`, and `registry.spl`.
## Operator workflow
bin/simple test test/01_unit/app/sspec_maintain/detector_registry_coverage_spec.spl
## Compatibility and limitations
Runs only under a full pure-Simple CLI; on a bootstrap-only host measure with
`<bootstrap-simple> run src/app/sspec_maintain/main.spl scan <spec>` per
.claude/rules/testing.md.
## Verification guidance and troubleshooting
A missing rule_id in the registry means a rule can never fire; an extra
registry rule_id with no catalog definition means dead/undocumented detection
code. A weight sum other than 100 means the aggregate formula no longer
distributes across the whole 0-100 range.
"""
# research: doc/01_research/domain/sspec_documentization_maintenance.md
# plan: doc/03_plan/sspec_modernization_plan.md
# architecture: doc/04_architecture/sspec_documentization_maintenance.md
# design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.*
use std.spec.step
use app.sspec_maintain.rules.{sspec_rule_definitions}
use app.sspec_maintain.dimensions.{sspec_dimension_weights}
use app.sspec_maintain.registry.{sspec_detector_rule_ids}

fn _catalog_ids() -> [text]:
    var ids: [text] = []
    for rule in sspec_rule_definitions(): ids.push(rule.rule_id)
    ids

describe "SSpec scorer detector-registry coverage":
    """
    Purpose: this manual pins the plugin-architecture extension seam for the
    owning engineering team: a new detector must be registered, and a
    registered detector must be defined.
    Audience: engineers extending the sspec-maintain scorer with new rules.
    """
    it "registers exactly one detector per stable rule id, in both directions":
        # @req REQ-SSPEC-APP
        step("Compare the catalog rule id set against the registered detector rule id set")
        val catalog = _catalog_ids()
        val registered = sspec_detector_rule_ids()
        # oracle: every catalog rule must have a registered detector — a
        # catalog entry with no detector can never produce a finding.
        for rule_id in catalog:
            expect(registered.contains(rule_id)).to_equal(true)
        # oracle: every registered detector must have a catalog definition —
        # an unregistered rule_id would be dead/undocumented detection code.
        for rule_id in registered:
            expect(catalog.contains(rule_id)).to_equal(true)
        # oracle: both sides carry the SAME NUMBER of distinct ids; combined
        # with the two containment checks above this pins exact set equality
        # without depending on list ordering.
        expect(registered.len()).to_equal(catalog.len())

    it "keeps the scoring dimension weights summing to exactly 100":
        # @req REQ-SSPEC-APP
        step("Sum the data-driven dimension weight table")
        var total: i64 = 0
        for dim in sspec_dimension_weights(): total = total + dim.weight
        expect(total).to_equal(100)  # oracle: the weighted-average formula in score.spl divides by 100
