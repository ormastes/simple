# Probe + regression spec for the SUSPECTED-HIGH census entry
# doc/08_tracking/bug/binding_module_shadow_census_2026-08-18.md
#   src/app/sspec_maintain/report.spl:92 `for report in reports:`
#
# The census could not produce a RED because it needs the `report` module
# namespace (src/compiler_rust/lib/std/src/verification/__init__.spl:24
# `use report`) to be co-loaded with app.sspec_maintain.report. This spec
# exercises BOTH multi-report renderers, which are the only two functions
# whose loop binding is named `report`, so that any namespace-shadow of that
# binding shows up as wrong or missing per-report output.

use std.spec.*
use app.sspec_maintain.*

fn _weak_report(path: text) -> SspecDocumentizationReport:
    analyze_sspec_text(path, "describe \"weak\":\n    it \"is unresolved\":\n        pass_todo\n")

describe "sspec-maintain multi-report renderers":

    it "renders one JSON entry per report, each naming its own source path":
        val rendered = render_json_reports([_weak_report("a_spec.spl"), _weak_report("b_spec.spl")])
        expect(rendered).to_contain("a_spec.spl")
        expect(rendered).to_contain("b_spec.spl")
        expect(rendered).to_contain("sspec-maintain-scope/v1")

    it "renders one SARIF result set per report, each naming its own source path":
        val rendered = render_sarif_reports([_weak_report("c_spec.spl"), _weak_report("d_spec.spl")])
        expect(rendered).to_contain("c_spec.spl")
        expect(rendered).to_contain("d_spec.spl")
        expect(rendered).to_contain("sarif-2.1.0")

    it "single-report SARIF is consistent with the multi-report path":
        val one = render_sarif_report(_weak_report("e_spec.spl"))
        expect(one).to_contain("e_spec.spl")
        expect(one).to_contain("sarif-2.1.0")
