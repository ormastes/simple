"""
## Purpose and audience
Generalization twin of scorer_loopholes_spec.spl: the adjacent shapes that the
2026-09-05 loophole fixes must NOT break — a `var` loop flag that is reassigned
before its assertion, a `# @capture` annotation (the form docgen renders), a
`.evidence.sdn` sidecar name, and lifecycle paths followed by sentence
punctuation. Audience: whoever next tightens `source_facts.spl`.
## Operator workflow
bin/simple test test/01_unit/app/sspec_maintain/scorer_loopholes_adjacent_spec.spl
## Compatibility and limitations
Runs only under a full pure-Simple CLI; on a bootstrap-only host measure the
same fixture texts with scripts/check/sspec-score-seed-lane.shs.
## Verification guidance and troubleshooting
A finding appearing here means a legitimate spec shape started losing points;
compare against the measured 2026-09-05 baseline in the bug record.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/app/testing/in_development_tag.md
# @manual_section: scorer-loopholes

use std.spec.*
use app.sspec_maintain.analyzer.{analyze_sspec_text}
use app.sspec_maintain.source_facts.{extract_sspec_source_facts}
use app.sspec_maintain.model.{SspecDocumentizationReport}

fn rule_ids(report: SspecDocumentizationReport) -> [text]:
    var ids: [text] = []
    for finding in report.findings:
        if not ids.contains(finding.rule_id):
            ids.push(finding.rule_id)
    ids

describe "sspec scorer shapes that stay legitimate after the loophole fixes":

    it "keeps a var loop flag reassigned before the assertion out of ORA-002":
        # @req REQ-SSDOC-ORA-002-LOOPFLAG
        step("Score `var found = false` mutated in a loop, then `expect(found).to_equal(false)`")
        val source = "describe \"x\":\n    it \"reports whether any entry matched\":\n        # @req REQ-ADJ-001\n        step(\"Scan\")\n        # @capture: evidence_manifest(\"flag\")\n        var found = false\n        for entry in [\"a\"]:\n            if entry == \"zzz\":\n                found = true\n        expect(found).to_equal(false)\n"
        val report = analyze_sspec_text("adjacent_flag_spec.spl", source)
        step("Verify no oracle blocker fires")
        # @capture: evidence_manifest("loop_flag_not_tautology") -> scorer_loopholes_adjacent_spec.evidence.sdn
        expect(rule_ids(report).contains("SSDOC-ORA-002")).to_equal(false)
        expect(report.score.blocker_count).to_equal(0)  # oracle: the reassignment makes the binding text meaningless

    it "still counts a `# @capture` annotation and a `.evidence.sdn` sidecar name as captures":
        # @req REQ-SSDOC-EVD-001-ANNOTATION
        step("Extract facts from a body carrying `# @capture(exec): ...` and one naming `x.evidence.sdn`")
        val source = "describe \"x\":\n    it \"reports the outcome\":\n        # @req REQ-ADJ-002\n        step(\"Act\")\n        # @capture(exec): transcript\n        val observed = run_product()\n        expect(observed).to_equal(\"ready\")\n    it \"records the sidecar\":\n        # @req REQ-ADJ-003\n        step(\"Act\")\n        # retained in adjacent_capture_spec.evidence.sdn\n        expect(run_product()).to_equal(\"ready\")\n"
        val facts = extract_sspec_source_facts("adjacent_capture_spec.spl", source)
        step("Verify both scenarios have a capture")
        # @capture: evidence_manifest("annotation_captures") -> scorer_loopholes_adjacent_spec.evidence.sdn
        expect(facts.capture_count).to_equal(2)  # oracle: one @capture line plus one .evidence.sdn line
        expect(rule_ids(analyze_sspec_text("adjacent_capture_spec.spl", source)).contains("SSDOC-EVD-001")).to_equal(false)

    it "strips sentence punctuation from lifecycle paths and ignores bare directories":
        # @req REQ-SSDOC-MNT-009-PUNCTUATION
        step("Extract facts from prose that ends a sentence with a plan path and lists a bare directory")
        val source = "\"\"\"\n## Purpose and audience\nOracles for doc/03_plan/sspec_modernization_plan.md.\nSee doc/05_design/app/testing/in_development_tag.md, and doc/01_research/ generally.\n\"\"\"\n"
        val facts = extract_sspec_source_facts("adjacent_paths_spec.spl", source)
        step("Verify the tokens are clean file paths only")
        # @capture: evidence_manifest("lifecycle_tokens") -> scorer_loopholes_adjacent_spec.evidence.sdn
        expect(facts.lifecycle_paths).to_contain("doc/03_plan/sspec_modernization_plan.md")
        expect(facts.lifecycle_paths).to_contain("doc/05_design/app/testing/in_development_tag.md")
        expect(facts.lifecycle_paths.len()).to_equal(2)  # oracle: the bare doc/01_research/ token names no file
