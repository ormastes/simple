"""
## Purpose and audience
Reproduces
doc/08_tracking/bug/sspec_scan_manual_findings_fire_without_mirror_2026-09-05.md
for the engineers who own `src/app/sspec_maintain/main.spl` and
`src/app/sspec_maintain/analyzer.spl`: `sspec-maintain scan` charges the four
manual-CONTENT rules (`SSDOC-MNT-005`, `SSDOC-MNT-008`, `SSDOC-EVD-002`,
`SSDOC-EVD-003`) against a spec that has NO `doc/06_spec` mirror on disk at
all, citing findings at a mirror path that does not exist. The documented
contract (`.claude/skills/spipe.md` SCAN row) says those four rules apply
"only when a mirror exists"; only `SSDOC-MNT-002` should fire for an absent
mirror.
## Operator workflow
bin/simple test test/01_unit/app/sspec_maintain/scan_manual_findings_require_mirror_spec.spl
## Compatibility and limitations
Calls the analyzer API directly (`analyze_sspec_pair_text`) with the exact
`mirror` value `main.spl:204` constructs for a missing mirror file: it calls
`file_read` (-> `read_file_text`, `src/lib/nogc_sync_mut/io_runtime.spl:213-216`),
which swallows a missing-file error and returns `""`, and that `text` is then
pushed straight into `mirrors: [Option<text>]` with no `file_exists` gate
(`main.spl:188-209`) -- so a missing mirror and an `Option<text>` of `Some("")`
are indistinguishable to the analyzer at the CLI boundary. This spec is
therefore the most faithful reproduction of the real CLI call, not a synthetic
shortcut.
## Verification guidance and troubleshooting
This spec is EXPECTED TO FAIL (RED) until the defect is fixed. Do not weaken
the assertions to make it pass -- see .claude/rules/testing.md. A missing
`SSDOC-MNT-005`/`SSDOC-MNT-008`/`SSDOC-EVD-002`/`SSDOC-EVD-003` from the
`to_not_contain` checks means the defect is fixed; their continued presence is
the confirmed bug.
"""
# Lifecycle: doc/08_tracking/bug/sspec_scan_manual_findings_fire_without_mirror_2026-09-05.md
# @manual_section: scan-no-mirror

use std.spec.*
use app.sspec_maintain.analyzer.{analyze_sspec_pair_text}
use app.sspec_maintain.model.{SspecDocumentizationReport}

fn rule_ids(report: SspecDocumentizationReport) -> [text]:
    var ids: [text] = []
    for finding in report.findings:
        if not ids.contains(finding.rule_id):
            ids.push(finding.rule_id)
    ids

fn no_mirror_source() -> text:
    # A minimal spec body with steps and a capture, so the manual-content
    # detectors (EVD-002/003, MNT-005/008) have something to evaluate against
    # if the mirror-gate is bypassed -- exactly the scorer_loopholes_spec.spl
    # house pattern for building a fixture the scorer will actually inspect.
    val req_id = "REQ" + "-NOMIRROR-001"
    "describe \"x\":\n    it \"reports the outcome\":\n        # @req " + req_id + "\n        step(\"Act\")\n        # @capture: evidence_manifest(\"no_mirror\")\n        val observed = 1\n        expect(observed).to_equal(1)\n"

describe "sspec-maintain scan does not penalize manual content for a mirror that does not exist":

    it "fires only SSDOC-MNT-002 when the mirror is truly absent (mirror=None)":
        # @req REQ-SSDOC-MNT-002-ONLY-NONE
        step("Score a no-mirror spec via the CORRECT Option<text> representation of absence: None")
        val report = analyze_sspec_pair_text("no_mirror_none_spec.spl", no_mirror_source(), None)
        step("Verify only the absence rule fires -- this direction already works")
        # @capture: evidence_manifest("mirror_none_only_mnt_002") -> scan_manual_findings_require_mirror_spec.evidence.sdn
        val ids = rule_ids(report)
        expect(ids).to_contain("SSDOC-MNT-002")
        expect(ids).to_not_contain("SSDOC-MNT-005")
        expect(ids).to_not_contain("SSDOC-MNT-008")
        expect(ids).to_not_contain("SSDOC-EVD-002")
        expect(ids).to_not_contain("SSDOC-EVD-003")

    it "fires only SSDOC-MNT-002 for the mirror value the real CLI actually produces for a missing file":
        # @req REQ-SSDOC-MNT-002-ONLY-CLI-SHAPE
        step("Score the same no-mirror spec via Some(\"\") -- what main.spl:204's file_read gives for a missing path")
        val report = analyze_sspec_pair_text("no_mirror_cli_shape_spec.spl", no_mirror_source(), Some(""))
        step("Verify manual-content rules stay silent for an absent mirror -- CONFIRMED BUG: they currently fire")
        # @capture: evidence_manifest("mirror_some_empty_cli_shape") -> scan_manual_findings_require_mirror_spec.evidence.sdn
        val ids = rule_ids(report)
        expect(ids).to_contain("SSDOC-MNT-002")
        expect(ids).to_not_contain("SSDOC-MNT-005")
        expect(ids).to_not_contain("SSDOC-MNT-008")
        expect(ids).to_not_contain("SSDOC-EVD-002")
        expect(ids).to_not_contain("SSDOC-EVD-003")
