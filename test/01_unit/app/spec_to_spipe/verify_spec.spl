"""
## Purpose and audience
Purpose: Verify Spec-to-SPipe Phase 0 verification gates.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-APP-SPECTOSPIPE-001
doc/01_research/local/REQ-APP-SPECTOSPIPE-001.md
doc/03_plan/sys_test/REQ-APP-SPECTOSPIPE-001.md
doc/04_architecture/REQ-APP-SPECTOSPIPE-001.md
doc/05_design/REQ-APP-SPECTOSPIPE-001.md
"""
# @req: REQ-APP-SPECTOSPIPE-001

use std.spec.*
use app.spec_to_spipe.verify.*
use app.spec_to_spipe.model.*
use std.common.structural.identity.{artifact_id, hash128, snapshot_id}
use std.common.structural.parse.contracts.{SourceSnapshot, SourceSpan}

val SHA_B = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

fn snapshot() -> SourceSnapshot:
    val artifact = artifact_id(hash128(7, 8), 1)
    SourceSnapshot(id: snapshot_id(artifact, 1), parent_id: nil,
        bytes: [97], newline_starts: [0])

fn manifest(version: text = "1.0") -> SpecImportManifest:
    val source = spec_source_identity("fixture", version, "2026-08-03",
        "https://example.invalid/spec", "fixture-v1", "fixture", "1",
        "rules-1", "CC0-1.0", "redistributable", snapshot())
    SpecImportManifest(schema_name: SPEC_IMPORT_SCHEMA_NAME,
        schema_version: SPEC_IMPORT_SCHEMA_VERSION, source: source,
        strict_mode: false, approved_recovery_rule_ids: [], ledger: [],
        diagnostics: [], error_nodes: [], extensions: [])

fn ledger_span(start_byte: i64, end_byte: i64, disposition: SpecDisposition,
        reason: text = "") -> SpecLedgerEntry:
    SpecLedgerEntry(semantic_id: "span-{start_byte}", node_kind: "source",
        source_span: SourceSpan(byte_start: start_byte, byte_end: end_byte),
        disposition: disposition, adapter_rule_id: "FIXTURE-001", reason: reason,
        conformance_binding: "test:fixture", extensions: [])

fn error_node(rule_id: text, diagnostic_id: text = "diag-1",
        children: [SpecErrorNode] = []) -> SpecErrorNode:
    SpecErrorNode(node_kind: "malformed-table",
        source_span: SourceSpan(byte_start: 1, byte_end: 8),
        raw_source: "|broken", adapter_rule_id: rule_id,
        diagnostic_id: diagnostic_id, recovered: true, children: children,
        extensions: [])

describe "Spec-to-SPipe Phase 0 verification gates":
    describe "REQ-S2S-COV-001: exact source coverage":
        it "should accept adjacent spans that account for every source byte":
            # @req: REQ-S2S-COV-001
            step("Verify: should accept adjacent spans that account for every source byte")
            step("Verify a ledger containing parsed and justified ignored bytes")
            val result = verify_exact_coverage(10, [
                ledger_span(0, 6, SpecDisposition.Normative),
                ledger_span(6, 10, SpecDisposition.Ignored, "editorial navigation")])
            expect(result.accepted).to_equal(true)
            expect(result.rule_ids.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "should reject a dropped byte range":
            # @req: REQ-S2S-REC-001
            step("Verify: should reject a dropped byte range")
            step("Leave bytes 4 through 6 absent from the ledger")
            val result = verify_exact_coverage(10, [
                ledger_span(0, 4, SpecDisposition.Normative),
                ledger_span(6, 10, SpecDisposition.Normative)])
            expect(result.accepted).to_equal(false)
            expect(result.rule_ids).to_contain("SPEC-COV-004")

        it "should reject overlapping bytes and an unreasoned exclusion":
            # @req: REQ-S2S-ID-001
            step("Verify: should reject overlapping bytes and an unreasoned exclusion")
            step("Overlap two entries and omit the exclusion rationale")
            val result = verify_exact_coverage(10, [
                ledger_span(0, 7, SpecDisposition.Normative),
                ledger_span(6, 10, SpecDisposition.Unsupported)])
            expect(result.rule_ids).to_contain("SPEC-COV-003")
            expect(result.rule_ids).to_contain("SPEC-COV-006")

    describe "REQ-S2S-REC-001: explicit tolerant-parser recovery":
        it "should accept a source-preserving manifest-approved recovery":
            # @req: REQ-APP-SPECTOSPIPE-001
            step("Verify: should accept a source-preserving manifest-approved recovery")
            step("Verify a diagnostic-bearing ErrorNode recovery in compatibility mode")
            val child = SpecErrorNode(node_kind: "bad-cell",
                source_span: SourceSpan(byte_start: 2, byte_end: 4),
                raw_source: "br", adapter_rule_id: "MD-TABLE-001",
                diagnostic_id: "diag-child", recovered: true, children: [], extensions: [])
            val result = verify_no_silent_recovery([
                error_node("MD-TABLE-001", children: [child])], false, ["MD-TABLE-001"])
            expect(result.accepted).to_equal(true)

        it "should reject every recovery in strict mode":
            # @req: REQ-S2S-COV-001
            step("Verify: should reject every recovery in strict mode")
            step("Submit an otherwise valid recovery to strict mode")
            val result = verify_no_silent_recovery([
                error_node("MD-TABLE-001")], true, ["MD-TABLE-001"])
            expect(result.rule_ids).to_contain("SPEC-REC-006")

        it "should reject silent or unapproved recovery":
            # @req: REQ-S2S-REC-001
            step("Verify: should reject silent or unapproved recovery")
            step("Omit diagnostic evidence and manifest approval")
            val result = verify_no_silent_recovery([
                error_node("MD-UNKNOWN-999", diagnostic_id: "")], false, ["MD-TABLE-001"])
            expect(result.rule_ids).to_contain("SPEC-REC-004")
            expect(result.rule_ids).to_contain("SPEC-REC-007")

    describe "REQ-S2S-ID-001: reproducible manifest identity":
        it "should accept a fully pinned matching identity":
            # @req: REQ-S2S-ID-001
            step("Verify: should accept a fully pinned matching identity")
            step("Compare the manifest with the selected version and observed source hash")
            val value = manifest()
            val result = verify_manifest_identity(value, "1.0", value.source.source_sha256)
            expect(result.accepted).to_equal(true)

        it "should reject an unknown schema and stale source hash":
            # @req: REQ-APP-SPECTOSPIPE-001
            step("Verify: should reject an unknown schema and stale source hash")
            step("Verify the manifest against a newer schema and different observed bytes")
            var value = manifest()
            value.schema_version = 99
            val result = verify_manifest_identity(value, "1.0", SHA_B)
            expect(result.rule_ids).to_contain("SPEC-ID-001")
            expect(result.rule_ids).to_contain("SPEC-ID-006")

        it "should reject a floating or stale published version":
            # @req: REQ-S2S-COV-001
            step("Verify: should reject a floating or stale published version")
            step("Use a floating published version where a pinned version is required")
            val value = manifest(version: "latest")
            val result = verify_manifest_identity(value, "1.0", value.source.source_sha256)
            expect(result.rule_ids).to_contain("SPEC-ID-003")
            expect(result.rule_ids).to_contain("SPEC-ID-004")

        it "should reject malformed digest identity":
            # @req: REQ-S2S-REC-001
            step("Verify: should reject malformed digest identity")
            step("Use a digest that cannot identify immutable source bytes")
            var value = manifest()
            value.source.source_sha256 = "not-a-sha"
            val result = verify_manifest_identity(value, "1.0", "not-a-sha")
            expect(result.rule_ids).to_contain("SPEC-ID-005")
