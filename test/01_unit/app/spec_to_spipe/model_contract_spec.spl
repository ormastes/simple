# @req: REQ-APP-SPECTOSPIPE-001

use std.spec
use std.common.structural.identity.{artifact_id, hash128, snapshot_id}
use std.common.structural.parse.contracts.{SourceSnapshot, SourceSpan}
use app.spec_to_spipe.model.{
    SPEC_IMPORT_SCHEMA_NAME,
    SPEC_IMPORT_SCHEMA_VERSION,
    SpecDisposition,
    SpecExtensionField,
    SpecErrorNode,
    SpecImportDiagnostic,
    SpecImportManifest,
    SpecLedgerEntry,
    SpecSemanticIdentityInput,
    canonical_spec_import_manifest,
    choose_spec_semantic_identity,
    spec_source_identity,
    validate_spec_import_manifest,
    verify_spec_import_manifest
}

fn sample_snapshot() -> SourceSnapshot:
    val artifact = artifact_id(hash128(1, 2), 1)
    SourceSnapshot(
        id: snapshot_id(artifact, 1),
        parent_id: nil,
        bytes: [97, 98, 99],
        newline_starts: [0]
    )

fn sample_entry() -> SpecLedgerEntry:
    SpecLedgerEntry(
        semantic_id: "upstream:clause-1",
        node_kind: "clause",
        source_span: SourceSpan(byte_start: 0, byte_end: 3),
        disposition: SpecDisposition.Normative,
        adapter_rule_id: "MD-CLAUSE-001",
        reason: "normative source clause",
        conformance_binding: "test:REQ-S2S-004",
        extensions: []
    )

fn sample_manifest() -> SpecImportManifest:
    val source = spec_source_identity(
        "example-standard",
        "1.0",
        "2026-08-03",
        "https://example.invalid/spec",
        "release-1.0",
        "markdown",
        "1",
        "rules-1",
        "CC0-1.0",
        "redistributable",
        sample_snapshot()
    )
    SpecImportManifest(
        schema_name: SPEC_IMPORT_SCHEMA_NAME,
        schema_version: SPEC_IMPORT_SCHEMA_VERSION,
        source: source,
        strict_mode: false,
        approved_recovery_rule_ids: [],
        ledger: [sample_entry()],
        diagnostics: [],
        error_nodes: [],
        extensions: [SpecExtensionField(namespace: "org.example.adapter", key: "dialect", value: "example-v1")]
    )

fn manifest_valid(manifest: SpecImportManifest) -> bool:
    match validate_spec_import_manifest(manifest):
        case Ok(_): true
        case Err(_): false

fn manifest_error_code(manifest: SpecImportManifest) -> text:
    match validate_spec_import_manifest(manifest):
        case Ok(_): ""
        case Err(err): err.code

fn canonical_text(manifest: SpecImportManifest) -> text:
    match canonical_spec_import_manifest(manifest):
        case Ok(value): value
        case Err(_): ""

use std.spec.step

describe "Spec-to-SPipe Phase-0 manifest contract":
    it "pins immutable source bytes and accepts the supported schema":
        # @req: REQ-S2S-004
        step("Verify: pins immutable source bytes and accepts the supported schema")
        val manifest = sample_manifest()
        expect(manifest.source.source_sha256).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
        expect(manifest_valid(manifest)).to_equal(true)

    it "rejects unknown schema versions without coercion":
        # @req: REQ-APP-SPECTOSPIPE-001
        step("Verify: rejects unknown schema versions without coercion")
        var manifest = sample_manifest()
        manifest.schema_version = 99
        expect(manifest_error_code(manifest)).to_equal("unsupported-version")

    it "rejects stale source hashes":
        # @req: REQ-S2S-004
        step("Verify: rejects stale source hashes")
        var manifest = sample_manifest()
        manifest.source.source_sha256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        expect(manifest_error_code(manifest)).to_equal("stale-hash")

    it "preserves namespaced adapter extensions in deterministic serialization":
        # @req: REQ-APP-SPECTOSPIPE-001
        step("Verify: preserves namespaced adapter extensions in deterministic serialization")
        val manifest = sample_manifest()
        val first = canonical_text(manifest)
        val second = canonical_text(manifest)
        expect(first).to_equal(second)
        expect(first).to_contain("org.example.adapter")
        expect(first).to_contain("dialect")
        expect(first).to_contain("example-v1")

    it "rejects adapter data without a namespaced extension":
        # @req: REQ-S2S-004
        step("Verify: rejects adapter data without a namespaced extension")
        var manifest = sample_manifest()
        manifest.extensions = [SpecExtensionField(namespace: "markdown", key: "dialect", value: "x")]
        expect(manifest_error_code(manifest)).to_equal("invalid-extension-namespace")

    it "selects semantic identity by the frozen priority order":
        # @req: REQ-APP-SPECTOSPIPE-001
        step("Verify: selects semantic identity by the frozen priority order")
        val identity = choose_spec_semantic_identity(SpecSemanticIdentityInput(
            upstream_id: "clause-7",
            registry_id: "registry-2",
            structural_path: "section/7",
            adapter_semantic_key: "adapter-7",
            content_fingerprint: "body",
            neighborhood_fingerprint: "neighbors"
        ))
        expect(identity).to_equal("upstream:clause-7")

    it "accepts only manifest-approved tolerant recovery":
        # @req: REQ-S2S-004
        step("Verify: accepts only manifest-approved tolerant recovery")
        var manifest = sample_manifest()
        manifest.approved_recovery_rule_ids = ["MD-RECOVERY-001"]
        manifest.diagnostics = [SpecImportDiagnostic(
            diagnostic_id: "diag-1",
            severity: "warning",
            adapter_rule_id: "MD-RECOVERY-001",
            message: "recovered malformed table",
            source_span: SourceSpan(byte_start: 1, byte_end: 2),
            recovered: true,
            extensions: []
        )]
        expect(manifest_valid(manifest)).to_equal(true)
        manifest.approved_recovery_rule_ids = []
        expect(manifest_error_code(manifest)).to_equal("unapproved-recovery")

    it "rejects all parser recovery in strict mode":
        # @req: REQ-APP-SPECTOSPIPE-001
        step("Verify: rejects all parser recovery in strict mode")
        var manifest = sample_manifest()
        manifest.strict_mode = true
        manifest.approved_recovery_rule_ids = ["MD-RECOVERY-001"]
        manifest.diagnostics = [SpecImportDiagnostic(
            diagnostic_id: "diag-1",
            severity: "error",
            adapter_rule_id: "MD-RECOVERY-001",
            message: "malformed table",
            source_span: SourceSpan(byte_start: 1, byte_end: 2),
            recovered: true,
            extensions: []
        )]
        expect(manifest_error_code(manifest)).to_equal("strict-recovery")

    it "retains nested malformed nodes inside their parent source span":
        # @req: REQ-S2S-004
        step("Verify: retains nested malformed nodes inside their parent source span")
        var manifest = sample_manifest()
        manifest.approved_recovery_rule_ids = ["MD-TABLE-001"]
        val child = SpecErrorNode(node_kind: "table-cell",
            source_span: SourceSpan(byte_start: 1, byte_end: 2),
            raw_source: "b", adapter_rule_id: "MD-TABLE-001",
            diagnostic_id: "diag-child", recovered: true, children: [],
            extensions: [])
        manifest.error_nodes = [SpecErrorNode(node_kind: "table",
            source_span: SourceSpan(byte_start: 0, byte_end: 3),
            raw_source: "abc", adapter_rule_id: "MD-TABLE-001",
            diagnostic_id: "diag-parent", recovered: true, children: [child],
            extensions: [])]
        expect(manifest_valid(manifest)).to_equal(true)
        expect(canonical_text(manifest)).to_contain("diag-child")

    it "rejects a nested malformed node outside its parent span":
        # @req: REQ-APP-SPECTOSPIPE-001
        step("Verify: rejects a nested malformed node outside its parent span")
        var manifest = sample_manifest()
        manifest.approved_recovery_rule_ids = ["MD-TABLE-001"]
        val child = SpecErrorNode(node_kind: "table-cell",
            source_span: SourceSpan(byte_start: 2, byte_end: 3),
            raw_source: "c", adapter_rule_id: "MD-TABLE-001",
            diagnostic_id: "diag-child", recovered: true, children: [],
            extensions: [])
        manifest.error_nodes = [SpecErrorNode(node_kind: "table",
            source_span: SourceSpan(byte_start: 0, byte_end: 2),
            raw_source: "ab", adapter_rule_id: "MD-TABLE-001",
            diagnostic_id: "diag-parent", recovered: true, children: [child],
            extensions: [])]
        expect(manifest_error_code(manifest)).to_equal("invalid-span")

    it "reports exact byte coverage from non-overlapping ledger spans":
        # @req: REQ-S2S-004
        step("Verify: reports exact byte coverage from non-overlapping ledger spans")
        val report = verify_spec_import_manifest(sample_manifest())
        expect(report.exact_coverage).to_equal(true)
        expect(report.accounted_source_bytes).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(report.total_source_bytes).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(report.passed).to_equal(true)
