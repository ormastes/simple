"""
## Purpose and audience
Purpose: Prove that cli compile optimization surface.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-COMPILE-001 — stable requirement identity for this spec.

use std.spec
use app.io.cli_compile.{cli_compile, cli_native_build}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn run_cli(args: [text]) -> (text, text, i64):
    rt_process_run("bin/simple", args)

describe "cli compile optimization surface":
    it "compile accepts named opt-level forms without rejecting them before file validation":
        step("Verify: compile accepts named opt-level forms without rejecting them before file validation")
        # @req: REQ-APP-COMPILE-001
        val levels = ["none", "basic", "standard", "aggressive"]
        for level in levels:
            val result = cli_compile(["compile", "--backend=vhdl", "--opt-level=" + level, "missing_input.spl"])
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "compile accepts split named opt-level forms on the in-process path":
        step("Verify: compile accepts split named opt-level forms on the in-process path")
        val levels = ["none", "basic", "standard", "aggressive"]
        for level in levels:
            val result = cli_compile(["compile", "--backend=vhdl", "--opt-level", level, "missing_input.spl"])
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "compile delegated cli path rejects invalid named opt-levels before missing-file handling":
        step("Verify: compile delegated cli path rejects invalid named opt-levels before missing-file handling")
        val result = run_cli(["compile", "--opt-level=bogus", "missing_input.spl"])
        expect(result.2).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.1).to_contain("Unknown optimization level: bogus")

    it "native-build accepts the same named opt-level forms on llvm-lib path":
        step("Verify: native-build accepts the same named opt-level forms on llvm-lib path")
        val levels = ["none", "basic", "standard", "aggressive"]
        for level in levels:
            val result = cli_native_build(["native-build", "--backend=llvm-lib", "--opt-level=" + level, "--entry", "missing_input.spl"])
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "native-build llvm-lib path accepts split named opt-level forms":
        step("Verify: native-build llvm-lib path accepts split named opt-level forms")
        val levels = ["none", "basic", "standard", "aggressive"]
        for level in levels:
            val result = cli_native_build(["native-build", "--backend=llvm-lib", "--opt-level", level, "--entry", "missing_input.spl"])
            expect(result).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "native-build delegated cli path accepts the same named opt-level forms":
        step("Verify: native-build delegated cli path accepts the same named opt-level forms")
        val levels = ["none", "basic", "standard", "aggressive"]
        for level in levels:
            val result = run_cli(["native-build", "--opt-level=" + level, "--entry", "missing_input.spl"])
            expect(result.2 != 0).to_equal(true)
            expect(result.0.contains("invalid --opt-level")).to_equal(false)
            expect(result.1.contains("invalid --opt-level")).to_equal(false)

    it "native-build delegated cli path rejects invalid runtime-bundle values before build work":
        step("Verify: native-build delegated cli path rejects invalid runtime-bundle values before build work")
        val result = run_cli(["native-build", "--runtime-bundle=bogus", "--entry", "missing_input.spl"])
        expect(result.2 != 0).to_equal(true)
        expect(result.0.contains("missing_input.spl")).to_equal(false)
        expect(result.1.contains("missing_input.spl")).to_equal(false)

    it "native-build rejects removed runtime-bundle aliases before build work":
        step("Verify: native-build rejects removed runtime-bundle aliases before build work")
        val aliases = ["hosted", "rust-hosted", "rust_hosted", "hosted-runtime", "rust-runtime", "all"]
        for lane in aliases:
            val inline = run_cli(["native-build", "--runtime-bundle=" + lane, "--entry", "missing_input.spl"])
            val split = run_cli(["native-build", "--runtime-bundle", lane, "--entry", "missing_input.spl"])
            expect(inline.2).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(split.2).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(inline.1).to_contain("was removed; use simple-core or core-c-bootstrap")
            expect(split.1).to_contain("was removed; use simple-core or core-c-bootstrap")
            expect(inline.1.contains("missing_input.spl")).to_equal(false)
            expect(split.1.contains("missing_input.spl")).to_equal(false)

        val repeated = run_cli(["native-build", "--runtime-bundle=simple-core", "--runtime-bundle=all", "--entry", "missing_input.spl"])
        expect(repeated.2).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(repeated.1).to_contain("was removed; use simple-core or core-c-bootstrap")

    it "native-build help before a removed bundle remains informational":
        step("Verify: native-build help before a removed bundle remains informational")
        val result = run_cli(["native-build", "--help", "--runtime-bundle=all"])
        expect(result.2).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.0).to_contain("Simple Native Build")
        expect(result.1.contains("was removed")).to_equal(false)

    it "list-optimizations shares the same optimization inventory lines":
        step("Verify: list-optimizations shares the same optimization inventory lines")
        val compile_output = run_cli(["compile", "--list-optimizations"])
        val native_output = run_cli(["native-build", "--list-optimizations"])

        expect(compile_output.2).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(native_output.2).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compile_output.0).to_contain("Simple optimization guide")
        expect(native_output.0).to_contain("Simple optimization guide")
        expect(compile_output.0).to_contain("Native executable default profile: aggressive")
        expect(native_output.0).to_contain("Native executable default profile: aggressive")
        expect(compile_output.0).to_contain("Release MIR/self-hosted builds normalize to standard unless --opt-level overrides it.")
        expect(native_output.0.contains("Release MIR/self-hosted builds normalize to standard unless --opt-level overrides it.")).to_equal(false)

        val shared_lines = [
            "  - [syntax] async desugar (basic, inventory-only)",
            "  - [syntax] placeholder lambda rewrite (basic, inventory-only)",
            "  - [syntax] collection pattern desugar (basic, inventory-only)",
            "  - [native] release build mode (basic, native-default)",
            "  - [native] 4KB layout optimization (aggressive, native-default)"
        ]
        for line in shared_lines:
            expect(compile_output.0).to_contain(line)
            expect(native_output.0).to_contain(line)
