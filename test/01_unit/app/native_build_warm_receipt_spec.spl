"""Correctness contract for exact native-build final-artifact receipts."""

use std.io_runtime.{
    dir_create_all, dir_remove_all, file_delete, file_exists, file_read,
    file_write, getpid
}
use std.spec.*
use app.io.env_ops.{env_get, env_set}
use app.cli.native_build_warm_receipt.{
    NATIVE_BUILD_WARM_CANDIDATE_ENV, native_build_warm_candidate_publish,
    native_build_warm_artifact_restore,
    native_build_warm_output_complete, native_build_warm_receipt_finish,
    native_build_warm_receipt_prepare
}

describe "native-build exact final-artifact receipt":
    it "accepts only complete zero-miss frontend and HIR evidence":
        val complete = "[frontend-cache] hits=3 misses=0 parses=0\n" +
            "[hir-cache] hits=3 misses=0 stores=0 refused=0 io_failed=0 reason=- dir=/tmp/hir\n"
        expect(native_build_warm_output_complete(complete, 3)).to_equal(true)

        val parse_miss = "[frontend-cache] hits=2 misses=1 parses=1\n" +
            "[hir-cache] hits=3 misses=0 stores=0 refused=0 io_failed=0 reason=- dir=/tmp/hir\n"
        expect(native_build_warm_output_complete(parse_miss, 3)).to_equal(false)

        val hir_store = "[frontend-cache] hits=3 misses=0 parses=0\n" +
            "[hir-cache] hits=2 misses=1 stores=1 refused=0 io_failed=0 reason=- dir=/tmp/hir\n"
        expect(native_build_warm_output_complete(hir_store, 3)).to_equal(false)

        val refused = "[frontend-cache] hits=3 misses=0 parses=0\n" +
            "[hir-cache] hits=3 misses=0 stores=0 refused=1 io_failed=0 reason=codec dir=/tmp/hir\n"
        expect(native_build_warm_output_complete(refused, 3)).to_equal(false)

        expect(native_build_warm_output_complete(complete, 4)).to_equal(false)
        expect(native_build_warm_output_complete("[hir-cache] disabled reason=off\n", 1)).to_equal(false)

    it "restores an exact artifact and rejects changed source missing or corrupt cache state":
        val root = "build/test_tmp/native-warm-receipt-" + getpid().to_text()
        expect(dir_create_all(root)).to_equal(true)
        val source_path = root + "/main.spl"
        val binary_path = root + "/simple"
        val backend_plugin_path = root + "/backend-plugin.so"
        val output_path = root + "/out"
        expect(file_write(source_path, "fn main(): 0\n")).to_equal(true)
        expect(file_write(binary_path, "compiler-fixture\n")).to_equal(true)
        expect(file_write(backend_plugin_path, "provider-build-42\n")).to_equal(true)
        expect(file_write(output_path, "output-fixture\n")).to_equal(true)
        val object_path = root + "/cache/object.main.o"
        expect(dir_create_all(root + "/cache")).to_equal(true)
        expect(file_write(object_path, "object-fixture\n")).to_equal(true)
        expect(file_write(object_path + ".capsule-receipt",
            "native-capsule-result-v1\nfixture\n")).to_equal(true)
        val manifest = "version: 1\nentries: [\n" +
            "  { source: \"" + source_path + "\", fingerprint: { hash: \"fixture\", size: 18, modified_time: 0 }, dependencies: [], outputs: [\"" +
            object_path + "\"], deps_iface: \"\" }\n]\n"
        expect(file_write(root + "/cache/build_cache.sdn", manifest)).to_equal(true)
        val old_frontend = env_get("SIMPLE_FRONTEND_CACHE") ?? ""
        val old_hir = env_get("SIMPLE_HIR_CACHE") ?? ""
        val old_parse_shard = env_get("SIMPLE_PARSE_SHARD") ?? ""
        val old_hir_shard = env_get("SIMPLE_HIR_SHARD") ?? ""
        val old_candidate = env_get(NATIVE_BUILD_WARM_CANDIDATE_ENV) ?? ""
        val old_scv_root = env_get("SIMPLE_SCV_SNAPSHOT_ROOT") ?? ""
        val old_scv_revision = env_get("SIMPLE_SCV_REVISION_ID") ?? ""
        val old_scv_commit = env_get("SIMPLE_SCV_COMMIT_ID") ?? ""
        val old_scv_tree = env_get("SIMPLE_SCV_TREE_ID") ?? ""
        val old_scv_inventory = env_get("SIMPLE_SCV_INVENTORY_DIGEST") ?? ""
        val old_scv_drift = env_get("SIMPLE_SCV_SOURCE_DRIFTED") ?? ""
        env_set("SIMPLE_FRONTEND_CACHE", "1")
        env_set("SIMPLE_HIR_CACHE", "1")
        env_set("SIMPLE_PARSE_SHARD", "")
        env_set("SIMPLE_HIR_SHARD", "")
        val args = [
            "--entry-closure", "--source", root, "--entry", source_path,
            "--cache-dir", root + "/cache", "--backend-plugin",
            backend_plugin_path, "--output", output_path
        ]
        val cold = native_build_warm_receipt_prepare(args, binary_path)
        expect(cold.eligible).to_equal(true)
        expect(cold.hit).to_equal(false)
        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, cold.candidate_path)
        expect(native_build_warm_candidate_publish([source_path])).to_equal(true)
        val complete = "[frontend-cache] hits=1 misses=0 parses=0\n" +
            "[hir-cache] hits=1 misses=0 stores=0 refused=0 io_failed=0 reason=- dir=/tmp/hir\n"
        expect(native_build_warm_receipt_finish(
            cold, complete, true, true)).to_equal(true)

        val warm = native_build_warm_receipt_prepare(args, binary_path)
        expect(warm.hit).to_equal(true)
        expect(file_delete(output_path)).to_equal(true)
        expect(native_build_warm_artifact_restore(warm)).to_equal(true)
        expect(file_read(output_path)).to_equal("output-fixture\n")

        expect(file_write(source_path, "fn main(): 1\n")).to_equal(true)
        val changed_source = native_build_warm_receipt_prepare(args, binary_path)
        expect(changed_source.hit).to_equal(false)
        expect(file_write(source_path, "fn main(): 0\n")).to_equal(true)

        val exact_again = native_build_warm_receipt_prepare(args, binary_path)
        expect(exact_again.hit).to_equal(true)

        # Provider replacement at the same selected path is a cache miss even
        # when compiler, argv, source closure, and output path are unchanged.
        expect(file_write(backend_plugin_path, "provider-build-43\n")).to_equal(true)
        val changed_provider = native_build_warm_receipt_prepare(args, binary_path)
        expect(changed_provider.hit).to_equal(false)
        expect(file_write(backend_plugin_path, "provider-build-42\n")).to_equal(true)
        val exact_provider_again = native_build_warm_receipt_prepare(args, binary_path)
        expect(exact_provider_again.hit).to_equal(true)

        expect(file_delete(exact_again.artifact_path)).to_equal(true)
        val missing_artifact = native_build_warm_receipt_prepare(args, binary_path)
        expect(missing_artifact.hit).to_equal(false)

        # Re-promote, then prove content corruption also refuses reuse.
        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, missing_artifact.candidate_path)
        expect(native_build_warm_candidate_publish([source_path])).to_equal(true)
        expect(native_build_warm_receipt_finish(
            missing_artifact, complete, true, true)).to_equal(true)
        val promoted_again = native_build_warm_receipt_prepare(args, binary_path)
        expect(promoted_again.hit).to_equal(true)
        expect(file_write(promoted_again.artifact_path, "corrupt\n")).to_equal(true)
        val corrupt_artifact = native_build_warm_receipt_prepare(args, binary_path)
        expect(corrupt_artifact.hit).to_equal(false)

        env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, old_candidate)
        env_set("SIMPLE_FRONTEND_CACHE", old_frontend)
        env_set("SIMPLE_HIR_CACHE", old_hir)
        env_set("SIMPLE_PARSE_SHARD", old_parse_shard)
        env_set("SIMPLE_HIR_SHARD", old_hir_shard)
        env_set("SIMPLE_SCV_SNAPSHOT_ROOT", old_scv_root)
        env_set("SIMPLE_SCV_REVISION_ID", old_scv_revision)
        env_set("SIMPLE_SCV_COMMIT_ID", old_scv_commit)
        env_set("SIMPLE_SCV_TREE_ID", old_scv_tree)
        env_set("SIMPLE_SCV_INVENTORY_DIGEST", old_scv_inventory)
        env_set("SIMPLE_SCV_SOURCE_DRIFTED", old_scv_drift)
        val _cleaned = dir_remove_all(root)

    it "restores before worker startup and keeps the worker as fail-closed fallback":
        val source = file_read("src/app/cli/native_build_main.spl")
        val hit_branch = source.index_of("if warm_receipt.hit:")
        val restore_call = source.index_of(
            "native_build_warm_artifact_restore(warm_receipt)")
        val worker_call = source.index_of(
            "process_run_timeout_live(simple_bin, worker_args")
        expect(hit_branch > 0).to_equal(true)
        expect(restore_call > hit_branch).to_equal(true)
        expect(worker_call > hit_branch).to_equal(true)
        expect(worker_call > restore_call).to_equal(true)
        expect(source).to_contain(
            "exact final artifact restored; worker skipped")
        expect(source).to_contain(
            "if shard_count > 0:\n        run_parse_shards")
        expect(source).to_contain(
            "if hir_shard_count > 1:")
        expect(source).to_contain(
            "native_build_warm_receipt_finish(\n        warm_receipt, stdout, code == 0, output_ok)")
        expect(source).to_contain(
            "env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, \"\")")

    it "publishes candidates only to the real worker":
        val source = file_read("src/app/cli/native_build_main.spl")
        val parse_at = source.index_of("run_parse_shards(args, shard_count")
        val hir_at = source.index_of("run_hir_shards(args, hir_shard_count")
        val publish_at = source.index_of(
            "env_set(NATIVE_BUILD_WARM_CANDIDATE_ENV, warm_receipt.candidate_path)")
        val worker_at = source.index_of(
            "process_run_timeout_live(simple_bin, worker_args")
        expect(parse_at > 0).to_equal(true)
        expect(hir_at > parse_at).to_equal(true)
        expect(publish_at > hir_at).to_equal(true)
        expect(worker_at > publish_at).to_equal(true)

    it "invalidates corrupt stale or incomplete authority and retains no source bodies":
        val receipt = file_read("src/app/cli/native_build_warm_receipt.spl")
        expect(receipt).to_contain("_warm_digest_text(payload) != checksum")
        expect(receipt).to_contain("file_hash_sha256(path) != digest")
        expect(receipt).to_contain("if not promoted:\n        val _invalidated = file_delete(state.receipt_path)")
        expect(receipt).to_contain("worker_ok and output_ok")
        expect(receipt).to_contain("_warm_copy_verified_atomic")
        expect(receipt).to_contain("file_hash_sha256(artifact_path) != artifact_digest")
        expect(receipt).to_contain("var rows: [text] = []")
        expect(receipt.contains("file_read(source_path)")).to_equal(false)

    it "binds normalized command compiler source object runtime and link inputs":
        val receipt = file_read("src/app/cli/native_build_warm_receipt.spl")
        val closure = file_read("src/app/io/_CliCompile/native_build_closure.spl")
        expect(receipt).to_contain("_warm_canonical_args(args)")
        expect(receipt).to_contain("value.len().to_text()")
        expect(receipt).to_contain("not _warm_has_explicit_output(args)")
        expect(receipt).to_contain("not _warm_args_paths_supported(args)")
        expect(receipt).to_contain("if drive_form or path.starts_with")
        expect(receipt).to_contain('"binary=" + binary_digest')
        expect(receipt).to_contain('"cache_scope=" + (env_get("SIMPLE_CACHE_SCOPE")')
        expect(receipt).to_contain('"frontend_scope=" + (env_get("SIMPLE_FRONTEND_CACHE_SCOPE")')
        expect(receipt).to_contain('"frontend_dir=" + (env_get("SIMPLE_FRONTEND_CACHE_DIR")')
        expect(receipt).to_contain('"hir_dir=" + (env_get("SIMPLE_HIR_CACHE_DIR")')
        expect(receipt).to_contain('"linker=" + (env_get("SIMPLE_LINKER")')
        expect(receipt).to_contain('"sysroot=" + (env_get("SIMPLE_SYSROOT")')
        expect(receipt).to_contain("_warm_object_inputs(state.args, rows)")
        expect(receipt).to_contain("build_cache.sdn")
        expect(receipt).to_contain(".capsule-receipt")
        expect(receipt).to_contain("_warm_runtime_and_link_inputs(state.args)")
        expect(receipt).to_contain('_warm_arg_value(args, "--backend-plugin")')
        expect(receipt).to_contain('arg.starts_with("--backend-plugin=")')
        expect(receipt).to_contain('paths.push(backend_plugin)')
        expect(receipt).to_contain("simple-native-warm-receipt-v4")
        expect(receipt).to_contain('"scv=" + scv_binding')
        expect(receipt).to_contain(
            "for entry in _warm_sort_text(dir_list(runtime) ?? [])")
        expect(receipt.contains("var dirs: [text] = [root]")).to_equal(false)
        expect(receipt).to_contain("normalized = _warm_sort_text(normalized)")
        expect(receipt).to_contain("source_path + \"\\t\" + digest")
        expect(closure).to_contain("native_build_warm_candidate_publish(result)")
