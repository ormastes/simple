# @req REQ-CS-WINDOWS-PANE-001
# @cover src/app/llm_caret/pane_backend.spl 20%

use std.spec.*
use app.llm_caret.pane_backend.{windows_quote_arg, windows_command_line,
    WINDOWS_PANE_CAPACITY}

describe "cs Windows pane command construction":
    it "quotes executable paths and arguments without losing boundaries":
        val line = windows_command_line("C:\\Program Files\\Simple\\simple.exe",
            ["run", "model name", "plain"])
        expect(line).to_equal("\"C:\\Program Files\\Simple\\simple.exe\" run \"model name\" plain")

    it "quotes empty arguments and embedded quotes using CreateProcess rules":
        expect(windows_quote_arg("")).to_equal("\"\"")
        expect(windows_quote_arg("say \"hello\"")).to_equal("\"say \\\"hello\\\"\"")

    it "keeps the Windows pane registry explicitly bounded":
        expect(WINDOWS_PANE_CAPACITY).to_equal(16)
