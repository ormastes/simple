# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






# @req REQ-SSPEC-APP REQ-SSPEC-APP REQ-SSPEC-APP REQ-SSPEC-APP
"""Messaging configuration uses typed SDN and secret references."""

use std.spec.step

use std.spec.*
use app.llm_caret.messaging.config.{decode_messaging_config}

use std.spec.step

describe "LLM Caret messaging SDN configuration":
    # @manual scenario evidence
    it "decodes server, agent, room, and transport maps":
        # @req REQ-SSPEC-APP
        step("decodes server, agent, room, and transport maps")
        val config = decode_messaging_config("""
messaging:
  server:
    listen: "unix://.simple/run/messaging.sock"
    database: .simple/state/messaging.db
    external_http: false
  defaults:
    room_mode: mention
    update_policy: milestones
    previous_messages: 2
    mirror_policy: full
  agents:
    reviewer:
      provider: codex
      handler: subagent
      role: review
      session_policy: persistent_per_thread
  rooms:
    development:
      mode: room
      update_policy: milestones
  transports:
    primitive:
      enabled: true
      mirror_policy: full
    slack:
      enabled: true
      credential_ref: "secret://slack/development"
      mirror_policy: metadata_only
""")
        expect(config.issues.join(" | ")).to_equal("")
        expect(config.server.database).to_equal(".simple/state/messaging.db")
        expect(config.agents.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(config.agents[0].provider).to_equal("codex")
        expect(config.rooms[0].mode).to_equal("room")
        expect(config.transports.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "rejects raw transport tokens and unsafe listeners":
        # @req REQ-SSPEC-APP
        step("rejects raw transport tokens and unsafe listeners")
        val config = decode_messaging_config("""
messaging:
  server:
    listen: http://0.0.0.0:8080
    database: state.db
  transports:
    slack:
      enabled: true
      credential_ref: xoxb-raw-secret
""")
        expect(config.valid()).to_equal(false)
        expect(config.issues.join(" | ")).to_contain("listen must be a Unix socket or loopback HTTP")
        expect(config.issues.join(" | ")).to_contain("secret:// reference")
