# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






# @req REQ-SSPEC-APP REQ-SSPEC-APP REQ-SSPEC-APP REQ-SSPEC-APP
"""Gemini hooks inject bounded context and normalize lifecycle events."""

use std.spec.step

use std.spec.*
use app.llm_caret.messaging.domain.model.*
use app.llm_caret.messaging.adapter.agent.gemini_hooks.{GeminiHooksAdapter}

fn binding() -> AgentBinding:
    AgentBinding(binding_id: messaging_id("binding", "b1"), room_id: messaging_id("room", "r1"),
        agent_id: messaging_id("agent", "researcher"), handler: AgentHandler.Subagent,
        session_policy: "new_per_task", trigger_policy: "mention", update_policy: "milestones",
        context_policy: "bounded", permissions: [])

describe "Gemini AgentControl adapter":
    # @manual scenario evidence
    it "injects BeforeAgent context and records terminal lifecycle state":
        # @req REQ-SSPEC-APP
        step("injects BeforeAgent context and records terminal lifecycle state")
        var adapter = GeminiHooksAdapter.new()
        val session_id = adapter.attach_session(binding())
        expect(adapter.accept_hook(session_id, "BeforeAgent", "ctx-7")).to_equal("context_accepted:ctx-7")
        expect(adapter.registry.session(session_id).context_manifest_id).to_equal("ctx-7")
        expect(adapter.accept_hook(session_id, "AfterModel", "milestone")).to_equal("enqueued:running")
        expect(adapter.accept_hook(session_id, "AfterAgent", "artifact-1")).to_equal("enqueued:completed")

    it "fails closed for empty context and unknown lifecycle hooks":
        # @req REQ-SSPEC-APP
        step("fails closed for empty context and unknown lifecycle hooks")
        var adapter = GeminiHooksAdapter.new()
        val session_id = adapter.attach_session(binding())
        expect(adapter.accept_hook(session_id, "BeforeAgent", "")).to_equal("error:context_rejected")
        expect(adapter.accept_hook(session_id, "Unknown", "x")).to_equal("error:unknown_gemini_hook")
