# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

extern fn rt_file_read_text(path: text) -> text?

describe "Caret messaging launcher policy":
    # @manual scenario evidence
    it "allows only the thin messaging supervisor without a monolithic artifact":
        # @req REQ-SSPEC-APP
        step("allows only the thin messaging supervisor without a monolithic artifact")
        val source = rt_file_read_text("bin/caret") ?? ""
        expect(source).to_contain("messaging_supervisor=1")
        expect(source).to_contain("Interpreting this control plane therefore never")
        expect(source).to_contain("interprets the PureDatabase hot path")
        expect(source).to_contain("src/app/llm_caret/messaging/main.spl")

    it "keeps legacy Caret commands native-only by default":
        # @req REQ-SSPEC-APP
        step("keeps legacy Caret commands native-only by default")
        val source = rt_file_read_text("bin/caret") ?? ""
        expect(source).to_contain("SIMPLE_CARET_ALLOW_SOURCE_FALLBACK:-0")
        expect(source).to_contain("cached native Caret artifact not found")

    it "should pass an absolute repository root to standalone native launches":
        # @req REQ-SSPEC-APP
        step("Inspect the cached and source-fallback launcher boundaries")
        val wrapper = rt_file_read_text("bin/caret") ?? ""
        val main = rt_file_read_text("src/app/llm_caret/main.spl") ?? ""
        step("Check that Electron paths do not depend on the caller working directory")
        expect(wrapper).to_contain("SIMPLE_CARET_REPO_ROOT=\"${REPO_ROOT}\"")
        expect(wrapper).to_contain("export SIMPLE_CARET_REPO_ROOT")
        expect(main).to_contain("env_get(\"SIMPLE_CARET_REPO_ROOT\")")
        expect(main).to_contain("repo_root + \"/tools/electron-shell\"")

    it "should route the public metal GUI flag to the isolated companion":
        # @req REQ-SSPEC-APP
        step("Inspect the production wrapper's Metal selection boundary")
        val wrapper = rt_file_read_text("bin/caret") ?? ""
        expect(wrapper).to_contain("--metal-gui")
        expect(wrapper).to_contain("SIMPLE_CARET_METAL_NATIVE")
        expect(wrapper).to_contain("build/bootstrap/caret-package/caret_metal")
        expect(wrapper).to_contain("exec \"${metal_native}\" \"$@\"")

    it "keeps the minimal entrypoint separate from legacy Caret UI providers":
        # @req REQ-SSPEC-APP
        step("keeps the minimal entrypoint separate from legacy Caret UI providers")
        val source = rt_file_read_text("src/app/llm_caret/messaging/main.spl") ?? ""
        expect(source).to_contain("run_messaging_cli(get_cli_args())")
        assert_false(source.contains("chat_tui"))
        assert_false(source.contains("llm_caret.provider"))
