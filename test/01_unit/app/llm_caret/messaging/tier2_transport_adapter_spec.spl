# @req: REQ-APP-LLMCARET-MESSAGING-001

# @req REQ-LLM-MSG-003 REQ-LLM-MSG-008 REQ-LLM-MSG-015 REQ-LLM-MSG-017
"""Tier-two adapter cores expose native requests without overstating receipts."""

use std.spec.*
use app.llm_caret.messaging.domain.model.*
use app.llm_caret.messaging.adapter.chat.google_chat.{GoogleChatTransport}
use app.llm_caret.messaging.adapter.chat.discord.{DiscordChatTransport}
use app.llm_caret.messaging.adapter.chat.mattermost.{MattermostChatTransport}

fn tier2_message() -> RoomMessage:
    RoomMessage(message_id: messaging_id("message", "message-2"),
        workspace_id: messaging_id("workspace", "workspace-1"),
        room_id: messaging_id("room", "development"), room_seq: 5,
        thread_root_id: "spaces/AAA/threads/thread-1", reply_to_id: "message-1",
        sender_identity_id: messaging_id("identity", "agent-1"), sender_agent_id: "agent-1",
        origin: MessageOrigin.AgentAnswer, body: "tier two", mentions: [], command: "",
        audience: [], external_ref: "remote-message-1", correlation_id: "correlation-2",
        causation_id: "", hop_count: 0, created_at: 10, edited_at: 0)

use std.spec.step

describe "Google Chat, Discord, and Mattermost adapter contracts":
    it "builds a Google Chat threaded request and reports native read-state intent":
        # @req: REQ-LLM-MSG-003
        step("Verify: builds a Google Chat threaded request and reports native read-state intent")
        # @req: REQ-APP-LLMCARET-MESSAGING-001.
        # @req: REQ-APP-LLMCARET-MESSAGING-001
        # @req: REQ-LLM-MSG-017
        var chat = GoogleChatTransport.new("google-token")
        expect(chat.bind_space("binding-1", "development", "spaces/AAA")).to_equal("binding_attached")
        val request = chat.prepare_send("binding-1", tier2_message(), "stable-key-google")
        expect(request.url).to_equal("https://chat.googleapis.com/v1/spaces/AAA/messages")
        expect(request.body).to_contain("spaces/AAA/threads/thread-1")
        expect(chat.mark_read("binding-1", "remote-message-1")).to_start_with(
            "google_chat_native_read_state:")

    it "builds a Discord reply request while keeping human read truth local":
        # @req: REQ-LLM-MSG-008
        step("Verify: builds a Discord reply request while keeping human read truth local")
        var discord = DiscordChatTransport.new("discord-token")
        expect(discord.bind_channel("binding-2", "development", "1234")).to_equal("binding_attached")
        val request = discord.prepare_send("binding-2", tier2_message(), "stable-key-discord")
        expect(request.url).to_equal("https://discord.com/api/v10/channels/1234/messages")
        expect(request.body).to_contain("message_reference")
        expect(discord.mark_read("binding-2", "remote-message-1")).to_equal(
            "primitive_sidecar:mark_read:remote-message-1")

    it "builds a Mattermost root reply and supports native direct-channel intent":
        # @req: REQ-LLM-MSG-015
        step("Verify: builds a Mattermost root reply and supports native direct-channel intent")
        var mattermost = MattermostChatTransport.new("https://mattermost.example/", "mattermost-token")
        expect(mattermost.bind_channel("binding-3", "development", "channel-1")).to_equal("binding_attached")
        val request = mattermost.prepare_send("binding-3", tier2_message(), "stable-key-mattermost")
        expect(request.url).to_equal("https://mattermost.example/api/v4/posts")
        expect(request.body).to_contain("root_id")
        expect(mattermost.open_private("binding-3", ["human-1", "agent-1"])).to_equal(
            "mattermost_native_direct_channel:create")
