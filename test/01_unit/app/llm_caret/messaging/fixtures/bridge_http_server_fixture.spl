# Loopback delivery target for bridge_worker, built on the shared pure-Simple
# HTTP server (http_sffi -> http_server_core -> std http_server).
# Usage: bridge_http_server_fixture.spl PORT — prints `listening`, then blocks
# in http_server_start until killed by the driver.
use std.nogc_async_mut.io_runtime.{get_args}
use std.nogc_sync_mut.io.http_sffi.{http_server_new, http_server_route, http_server_start, HTTP_SERVER_ECHO_HANDLER}

fn main():
    val args = get_args()
    val port = args[args.len() - 1].to_int() ?? 0
    val server = http_server_new(port)
    val ok = server.is_valid and http_server_route(server, "POST", "/deliver", HTTP_SERVER_ECHO_HANDLER)
    if not ok:
        print "setup failed"
        return
    print "listening"
    http_server_start(server)

main()
