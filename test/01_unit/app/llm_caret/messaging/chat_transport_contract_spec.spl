use std.spec.*
use app.llm_caret.messaging.adapter.chat.bound_transport.{BoundChatTransport}
use app.llm_caret.messaging.domain.model.{RoomMessage, MessageOrigin, messaging_id}

fn contract_message() -> RoomMessage:
    RoomMessage(message_id: messaging_id("message", "contract-message"),
        workspace_id: messaging_id("workspace", "contract-workspace"),
        room_id: messaging_id("room", "contract-room"), room_seq: 1,
        thread_root_id: "", reply_to_id: "",
        sender_identity_id: messaging_id("identity", "contract-human"), sender_agent_id: "",
        origin: MessageOrigin.Human, body: "contract body", mentions: [], command: "",
        audience: [], external_ref: "", correlation_id: "contract-correlation",
        causation_id: "", hop_count: 0, created_at: 1, edited_at: 0)

describe "shared ChatTransportPort adapter contract":
    it "deduplicates outbound messages with one stable canonical mapping":
        for name in ["primitive", "matrix", "slack", "teams", "telegram", "google_chat",
                "discord", "mattermost", "generic_http", "line", "kakao"]:
            var adapter = BoundChatTransport.for_name(name)
            expect(adapter.attach_binding("binding-1").accepted).to_equal(true)
            val first = adapter.enqueue_send("binding-1", contract_message(), "stable-contract-key")
            val second = adapter.enqueue_send("binding-1", contract_message(), "stable-contract-key")
            expect(first.accepted).to_equal(true)
            expect(second.duplicate).to_equal(true)
            expect(second.external_message_id).to_equal(first.external_message_id)

    it "deduplicates transport echoes per binding and external event ID":
        var adapter = BoundChatTransport.for_name("slack")
        expect(adapter.attach_binding("binding-a").accepted).to_equal(true)
        expect(adapter.accept_inbound_event("binding-a", "event-1").duplicate).to_equal(false)
        expect(adapter.accept_inbound_event("binding-a", "event-1").duplicate).to_equal(true)
