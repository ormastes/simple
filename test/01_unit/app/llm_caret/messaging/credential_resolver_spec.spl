# @req: REQ-APP-LLMCARET-MESSAGING-001

# @req REQ-LLM-MSG-013 REQ-LLM-MSG-016 REQ-LLM-MSG-017
"""Credential references are deterministic and secret values remain redacted."""

use std.spec.*
use app.llm_caret.messaging.adapter.chat.credential_resolver.*

use std.spec.step

describe "LLM Caret transport credential references":
    it "maps a logical secret reference to a process capability name":
        # @req: REQ-LLM-MSG-013
        step("Verify: maps a logical secret reference to a process capability name")
        # @req: REQ-APP-LLMCARET-MESSAGING-001.
        # @req: REQ-APP-LLMCARET-MESSAGING-001
        expect(credential_environment_key("secret://slack/simple-development")).to_equal(
            "SIMPLE_SECRET_SLACK_SIMPLE_DEVELOPMENT")
        expect(credential_environment_key("secret://teams/tenant.prod")).to_equal(
            "SIMPLE_SECRET_TEAMS_TENANT_PROD")

    it "rejects raw tokens and traversal-like references":
        # @req: REQ-LLM-MSG-016
        step("Verify: rejects raw tokens and traversal-like references")
        expect(credential_environment_key("xoxb-raw-token")).to_equal("")
        expect(credential_environment_key("secret://../token")).to_equal("")
        expect(credential_environment_key("secret://bad\\token")).to_equal("")

    it "never renders a resolved value into status output":
        # @req: REQ-LLM-MSG-017
        step("Verify: never renders a resolved value into status output")
        val result = CredentialResolution(ok: true, value: "super-secret", error: "")
        expect(redact_credential_resolution(result)).to_equal("credential_resolved")
        expect(redact_credential_resolution(result).contains("super-secret")).to_equal(false)
