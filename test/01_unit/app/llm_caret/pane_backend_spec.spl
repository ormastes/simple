"""
## Purpose and audience
As a caret-suite operator I open the `cs` dashboard, see every pane my session
owns, switch the pane I want to talk to, and maximize the pane that is taking
my command so its output fills the terminal. This spec is for the engineers
who own `src/app/llm_caret/pane_backend.spl` and the tmux contract behind it.
The dashboard must be honest about the host it runs on: on a machine with tmux
it drives real panes, and on a machine without one (Windows, or a POSIX box
with no tmux installed) it says so and refuses rather than showing me panes
that do not exist.
## Operator workflow
bin/simple test test/01_unit/app/llm_caret/pane_backend_spec.spl
## Compatibility and limitations
The live tmux scenario needs a real tmux on PATH; on a host without one the
scenario pins the degraded-backend verdict instead of driving panes. The
disposable session name is `cs-pane-backend-spec` and must never be the
operator's own session.
## Verification guidance and troubleshooting
A parser failure means tmux output shape drifted; a command-builder failure
means the argv contract moved. Rerun
bin/simple test test/01_unit/app/llm_caret/pane_backend_spec.spl after any
pane_backend change; a leftover `cs-pane-backend-spec` session from a crashed
run can be killed with tmux before rerunning.
"""
# Lifecycle: doc/01_research/local/llm_caret_embedded_tmux.md ;
# doc/03_plan/agent_tasks/llm_caret_gui_backends.md ;
# doc/04_architecture/llm_caret_gui_backends.md ;
# doc/05_design/app/llm_caret_embedded_tmux.md
# @manual_section: cs-pane-backend

use std.spec.{step}

use app.llm_caret.pane_backend.{pane_send_literal_argv, pane_send_enter_argv, Pane, PANE_FORMAT, pane_parse_line,
    pane_parse_lines, pane_list_argv, pane_select_argv, pane_zoom_argv,
    pane_kill_argv, pane_backend_name, pane_available, pane_list, pane_select,
    pane_zoom, pane_spawn, pane_kill}

describe "cs pane backend reads tmux pane lines":

    it "types a chat message literally and submits it as a separate keystroke":
        """
        `send-keys -l` is what stops a message containing tmux key names —
        "Enter", "C-c" — from being interpreted as keys instead of typed. The
        submitting Enter is therefore its own call, which also means a failed
        literal write can be detected before anything is submitted.
        """
        # @req REQ-APP-LLM-CARET-PANE-001
        # @capture(protocol_binary): both send-keys argv transcripts
        step("Build the literal-write argv")
        expect(pane_send_literal_argv("%3", "say Enter please")).to_equal(
            ["send-keys", "-t", "%3", "-l", "say Enter please"])

        step("Build the submit argv")
        expect(pane_send_enter_argv("%3")).to_equal(["send-keys", "-t", "%3", "Enter"])

    it "turns a realistic list-panes line into a fully populated Pane":
        # @req REQ-APP-LLM-CARET-PANE-002
        # @capture(tui_grid): parsed Pane fields for the active unzoomed line
        step("parse one active, unzoomed pane line emitted by tmux")
        val panes = pane_parse_line("%3 48211 1 0 claude-worker")
        expect(panes.len()).to_equal(1)  # oracle: one well-formed line parses to exactly one Pane
        expect(panes[0].pane_id).to_equal("%3")
        expect(panes[0].pid).to_equal(48211)  # oracle: the second whitespace column is the host PID
        expect(panes[0].title).to_equal("claude-worker")
        assert_true(panes[0].active)
        assert_false(panes[0].zoomed)

    it "keeps a multi-word pane title intact":
        # @capture(tui_grid): parsed title retaining internal spaces
        step("titles carry spaces, so they are the trailing columns")
        val panes = pane_parse_line("%12 991 0 1 caret agent two")
        expect(panes.len()).to_equal(1)  # oracle: one well-formed line parses to exactly one Pane
        expect(panes[0].title).to_equal("caret agent two")
        assert_false(panes[0].active)
        assert_true(panes[0].zoomed)

    it "accepts a pane whose title tmux left empty":
        # @capture(tui_grid): parsed Pane for a title-less line
        step("an untitled pane is still a real pane")
        val panes = pane_parse_line("%0 7 1 0")
        expect(panes.len()).to_equal(1)  # oracle: a short line without a title still parses to one Pane
        expect(panes[0].title).to_equal("")
        expect(panes[0].pid).to_equal(7)  # oracle: the PID column decodes even when the title is absent

    it "yields no Pane at all for a malformed line":
        # @req REQ-APP-LLM-CARET-PANE-003
        # @capture(statistics): six malformed inputs, zero Panes produced
        step("fail closed: garbage must never become a Pane with garbage fields")
        expect(pane_parse_line("").len()).to_equal(0)  # oracle: an empty line is absence, not a Pane
        expect(pane_parse_line("garbage").len()).to_equal(0)  # oracle: a line without columns is absence, not a Pane
        expect(pane_parse_line("3 48211 1 0 title").len()).to_equal(0)  # oracle: a pane id must start with %, so this is absence
        expect(pane_parse_line("%3 notapid 1 0 title").len()).to_equal(0)  # oracle: a non-numeric PID column is absence, not a Pane
        expect(pane_parse_line("%3 48211 yes 0 title").len()).to_equal(0)  # oracle: a non-numeric active flag is absence, not a Pane
        expect(pane_parse_line("%3 48211 1 maybe title").len()).to_equal(0)  # oracle: a non-numeric zoom flag is absence, not a Pane

    it "drops only the bad line when a block mixes good and bad":
        # @capture(tui_grid): surviving panes around one corrupt line
        step("one corrupt line must not lose the healthy panes around it")
        val panes = pane_parse_lines("%1 100 1 0 alpha\nrubbish\n%2 200 0 1 beta\n")
        expect(panes.len()).to_equal(2)  # oracle: only the corrupt middle line is dropped from the block
        expect(panes[0].pane_id).to_equal("%1")
        expect(panes[1].pane_id).to_equal("%2")
        assert_true(panes[1].zoomed)

describe "cs pane backend builds the right tmux commands":
    it "asks tmux for the pane fields the parser expects":
        # @req REQ-APP-LLM-CARET-PANE-004
        # @capture(protocol_json): list-panes argv with session and format
        step("the list argv must carry the session and the documented format")
        val argv = pane_list_argv("caret")
        expect(argv[0]).to_equal("list-panes")
        expect(argv).to_contain("caret")
        expect(argv).to_contain(PANE_FORMAT)
        expect(PANE_FORMAT).to_contain("#{{pane_id}}")
        expect(PANE_FORMAT).to_contain("#{{pane_title}}")

    it "switches the active pane with select-pane on the pane id":
        # @capture(protocol_json): select-pane argv transcript
        step("pane ids are globally unique, so -t takes the id alone")
        val argv = pane_select_argv("%7")
        expect(argv.len()).to_equal(3)  # oracle: select-pane -t <id> is exactly three argv words
        expect(argv[0]).to_equal("select-pane")
        expect(argv[1]).to_equal("-t")
        expect(argv[2]).to_equal("%7")

    it "maximizes with resize-pane -Z so the zoom toggles":
        # @capture(protocol_json): resize-pane argv transcript
        step("-Z is tmux's toggle for pane zoom")
        val argv = pane_zoom_argv("%7")
        expect(argv[0]).to_equal("resize-pane")
        expect(argv).to_contain("-Z")
        expect(argv[argv.len() - 1]).to_equal("%7")

    it "kills a pane with kill-pane on the pane id":
        # @capture(protocol_json): kill-pane argv transcript
        step("teardown targets the same pane id")
        val argv = pane_kill_argv("%7")
        expect(argv[0]).to_equal("kill-pane")
        expect(argv[argv.len() - 1]).to_equal("%7")

describe "cs pane backend is honest about the host":
    it "names a backend that matches what the host can actually do":
        # @req REQ-APP-LLM-CARET-PANE-005
        # @capture(statistics): backend name versus availability probe
        step("the name is a probe result, never an assumption")
        val name = pane_backend_name()
        assert_true(name == "tmux" or name == "windows" or name == "none")
        if pane_available():
            expect(name).to_equal("tmux")
        else:
            assert_true(name == "windows" or name == "none")

    it "refuses pane operations that were given no target":
        # @capture(statistics): empty-target refusals across four operations
        step("an empty session or pane id is a caller bug, not a no-op success")
        assert_false(pane_select("caret", ""))
        assert_false(pane_zoom("", "%1"))
        assert_false(pane_kill("caret", ""))
        expect(pane_spawn("", "t", "sh", []).pane_id).to_equal("")

    it "returns no panes rather than fabricating them when tmux is absent":
        # @capture(statistics): degraded-backend verdict on this host
        step("a degraded backend reports nothing, never invented panes")
        if pane_available():
            step("this host has tmux, so pin the present-host honesty instead")
            expect(pane_backend_name()).to_equal("tmux")
            expect(pane_list("caret").len()).to_be_greater_than(-1)
        else:
            expect(pane_list("caret").len()).to_equal(0)  # oracle: an absent backend must report zero panes, never fabricated ones
            assert_false(pane_select("caret", "%1"))
            assert_false(pane_zoom("caret", "%1"))

describe "cs pane backend drives a live tmux session":
    it "spawns, lists, selects, maximizes and kills a real pane":
        # @req REQ-APP-LLM-CARET-PANE-006
        # @capture(tui_grid): live session pane lifecycle transcript
        step("end-to-end against a disposable session, never the operator's own")
        if not pane_available():
            step("no tmux on this host: pin the degraded verdict instead of driving panes")
            assert_true(pane_backend_name() == "none" or pane_backend_name() == "windows")
            expect(pane_list("cs-pane-backend-spec").len()).to_equal(0)  # oracle: without a backend the disposable session reports zero panes
        else:
            val session = "cs-pane-backend-spec"
            val first = pane_spawn(session, "spec-pane-one", "sh", ["-c", "sleep 30"])
            expect(first.pane_id).to_contain("%")
            expect(first.pid).to_be_greater_than(0)

            val second = pane_spawn(session, "spec-pane-two", "sh", ["-c", "sleep 30"])
            expect(second.pane_id).to_contain("%")
            expect(pane_list(session).len()).to_be_greater_than(1)

            assert_true(pane_select(session, second.pane_id))
            var selected = false
            for pane in pane_list(session):
                if pane.pane_id == second.pane_id and pane.active:
                    selected = true
            assert_true(selected)

            assert_true(pane_zoom(session, second.pane_id))
            var zoomed = false
            for pane in pane_list(session):
                if pane.pane_id == second.pane_id and pane.zoomed:
                    zoomed = true
            assert_true(zoomed)

            assert_true(pane_zoom(session, second.pane_id))
            var still_zoomed = false
            for pane in pane_list(session):
                if pane.pane_id == second.pane_id and pane.zoomed:
                    still_zoomed = true
            assert_false(still_zoomed)

            assert_true(pane_kill(session, second.pane_id))
            assert_true(pane_kill(session, first.pane_id))
            expect(pane_list(session).len()).to_equal(0)  # oracle: after both kills the disposable session owns zero panes
