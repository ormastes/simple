# AUTHORED_NOT_RUN. No synthetic completed native receipts are constructible.
use std.spec.{describe, it, expect, step}
use app.llm_caret.provider_cli_adapter_types_v1.ProviderCliProviderV1
use app.llm_caret.provider_cli_container_probe_v1.{provider_cli_contained_selection_v1,
    ProviderCliContainedProbeSnapshotV1, provider_cli_contained_probe_snapshot_copy_v1}
use std.common.contracts.container.execution_v2.ContainerHostScopeV2
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.contracts.container.execution_configuration_v1.{ContainerExecutionConfigurationObservationV1,
    ContainerExecutionMountObservationV1}

describe "Contained provider compatibility batch admission":
    it "refuses a versionless batch for each supported provider through the production receipt consumer":
        step("Require genuine completed version and help receipts instead of version DATA")
        for provider in [ProviderCliProviderV1.Codex, ProviderCliProviderV1.Claude,
                ProviderCliProviderV1.Gemini, ProviderCliProviderV1.Kimi]:
            val selected = provider_cli_contained_selection_v1(provider, [])
            expect(selected.is_err()).to_equal(true)
            expect(selected.unwrap_err()).to_equal("provider-probe-complete-index-set-required")

    it "isolates every exported diagnostic array using the receipt's production copy function":
        step("Copy diagnostic DATA without minting a native receipt or supported selection")
        var argv = ["/opt/provider", "--help"]
        var digests = ["registry/image@sha256:data"]
        var names = ["PATH"]
        var defaults = ["PATH"]
        var prefix = ["/opt/provider"]
        var mounts = [ContainerExecutionMountObservationV1(kind: "bind", source: "/source",
            destination: "/data", read_only: true)]
        val scope = ContainerHostScopeV2(physical_host_id: "data-host", service_scope_id: "data-service",
            boot_id: "data-boot", provider_generation: 1, native_machine_id: "data-machine",
            continuity_mode: "data-only", continuity_id: "data-continuity")
        val runtime = RuntimeIdentityV1(pod_uid: "data-pod", attempt: 1, provider_generation: 1,
            operation_id: "data-operation", engine: "data-engine", native_id: "data-native", node_boot_id: "data-boot")
        val configuration = ContainerExecutionConfigurationObservationV1(scope: scope, runtime: runtime,
            request_digest: "data", requested_image_ref: "data-image", requested_image_kind: "data-only",
            runtime_image_id: "data", image_config_id: "data", image_repo_digests: digests, primary_argv: argv,
            working_directory: "/workspace", configured_user: "1000", readonly_rootfs: true, mounts: mounts,
            environment_digest: "data", environment_names: names, image_default_environment_digest: "data",
            image_default_environment_names: defaults, configuration_digest: "data")
        val original = ProviderCliContainedProbeSnapshotV1(provider: ProviderCliProviderV1.Codex, probe_index: 1,
            configuration: configuration, program_prefix: prefix, program_binding_digest: "data",
            transcript_digest: "data", transcript_bytes: 4)
        val copied = provider_cli_contained_probe_snapshot_copy_v1(original)
        argv[0] = "/replaced"
        digests[0] = "replacement"
        names[0] = "SECRET"
        defaults[0] = "SECRET"
        prefix[0] = "/replaced"
        mounts[0] = ContainerExecutionMountObservationV1(kind: "bind", source: "/replacement",
            destination: "/opt", read_only: false)
        expect(copied.configuration.primary_argv).to_equal(["/opt/provider", "--help"])
        expect(copied.configuration.image_repo_digests).to_equal(["registry/image@sha256:data"])
        expect(copied.configuration.environment_names).to_equal(["PATH"])
        expect(copied.configuration.image_default_environment_names).to_equal(["PATH"])
        expect(copied.program_prefix).to_equal(["/opt/provider"])
        expect(copied.configuration.mounts[0].source).to_equal("/source")
        expect(copied.configuration.mounts[0].destination).to_equal("/data")
        expect(copied.configuration.mounts[0].read_only).to_equal(true)
