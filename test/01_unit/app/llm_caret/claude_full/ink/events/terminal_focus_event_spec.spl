use std.spec.*
use app.llm_caret.claude_full.ink.events.terminal_focus_event.{TerminalFocusEvent, terminalFocusEventNew, normalizeTerminalFocusEventType}

fn main() -> ():
    describe("ink TerminalFocusEvent", fn() -> ():
        it("normalizes unknown types to terminalfocus and keeps terminalblur", fn() -> ():
            expect(normalizeTerminalFocusEventType("terminalblur")).to_equal("terminalblur")
            expect(normalizeTerminalFocusEventType("blur")).to_equal("terminalfocus")
            expect(normalizeTerminalFocusEventType("terminalfocus")).to_equal("terminalfocus")
        )

        it("exposes focus and blur predicates that are mutually exclusive", fn() -> ():
            val f = TerminalFocusEvent.new("terminalfocus")
            val b = TerminalFocusEvent.new("terminalblur")
            expect(f.isFocus()).to_equal(true)
            expect(f.isBlur()).to_equal(false)
            expect(b.isBlur()).to_equal(true)
            expect(b.isFocus()).to_equal(false)
        )

        it("latches immediate-propagation stop", fn() -> ():
            var e = terminalFocusEventNew("terminalblur")
            expect(e.didStopImmediatePropagation()).to_equal(false)
            e.stopImmediatePropagation()
            expect(e.didStopImmediatePropagation()).to_equal(true)
        )
    )
