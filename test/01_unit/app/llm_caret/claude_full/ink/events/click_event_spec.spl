# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use app.llm_caret.claude_full.ink.events.click_event.{ClickEvent, clickEventNew}

fn main() -> ():
    describe("ink ClickEvent", fn() -> ():
        it("records absolute cell coordinates from the constructor", fn() -> ():
            # @req REQ-SSPEC-UNIT
            step("records absolute cell coordinates from the constructor")
            val e = ClickEvent.new(12, 4, false)
            expect(e.col).to_equal(12)
            expect(e.row).to_equal(4)
            expect(e.localCol).to_equal(0)
            expect(e.localRow).to_equal(0)
        )

        it("derives local coordinates relative to a box origin", fn() -> ():
            step("derives local coordinates relative to a box origin")
            var e = ClickEvent.new(12, 4, false)
            e.setLocalFromBox(10, 3)
            expect(e.localCol).to_equal(2)
            expect(e.localRow).to_equal(1)
        )

        it("allows local coordinates to be set directly", fn() -> ():
            step("allows local coordinates to be set directly")
            var e = ClickEvent.new(1, 1, false)
            e.setLocal(7, 9)
            expect(e.localCol).to_equal(7)
            expect(e.localRow).to_equal(9)
        )

        it("reports blank-cell clicks from the constructor flag", fn() -> ():
            step("reports blank-cell clicks from the constructor flag")
            expect(ClickEvent.new(0, 0, true).isBlankCellClick()).to_equal(true)
            expect(ClickEvent.new(0, 0, false).isBlankCellClick()).to_equal(false)
        )

        it("latches immediate-propagation stop only after it is requested", fn() -> ():
            step("latches immediate-propagation stop only after it is requested")
            var e = clickEventNew(3, 5, false)
            expect(e.didStopImmediatePropagation()).to_equal(false)
            e.stopImmediatePropagation()
            expect(e.didStopImmediatePropagation()).to_equal(true)
        )

        it("formats position as col,row", fn() -> ():
            step("formats position as col,row")
            expect(ClickEvent.new(12, 4, false).positionText()).to_equal("12,4")
        )
    )
    # ponytail: explicit unit return - trailing describe() leaks a value into
    # the process exit code, so a 0-failure spec exits 1. Bug: doc/08_tracking/bug/
    # spec_describe_in_main_leaks_exit_code_2026-08-30.md
    return ()
