# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec.*
use app.llm_caret.claude_full.ink.events.focus_event.{FocusEvent, focusEventNew, normalizeFocusEventType}

fn main() -> ():
    describe("ink FocusEvent", fn() -> ():
        it("keeps blur as blur and normalizes anything else to focus", fn() -> ():
        # @req REQ-SSPEC-UNIT
    # @req REQ-SSPEC-UNIT
            expect(normalizeFocusEventType("blur")).to_equal("blur")
            expect(normalizeFocusEventType("focus")).to_equal("focus")
            expect(normalizeFocusEventType("nonsense")).to_equal("focus")
        )

        it("round-trips the related target", fn() -> ():
            val e = FocusEvent.new("focus", "input-box")
            expect(e.relatedTarget).to_equal("input-box")
        )

        it("bubbles but is not cancelable", fn() -> ():
            val e = FocusEvent.new("focus", "")
            expect(e.bubbles).to_equal(true)
            expect(e.cancelable).to_equal(false)
        )

        it("ignores preventDefault because the event is not cancelable", fn() -> ():
            var e = FocusEvent.new("blur", "")
            e.preventDefault()
            expect(e.defaultPrevented).to_equal(false)
        )

        it("answers isFocus/isBlur consistently with the normalized type", fn() -> ():
            val f = focusEventNew("focus", "")
            val b = focusEventNew("blur", "")
            expect(f.isFocus()).to_equal(true)
            expect(f.isBlur()).to_equal(false)
            expect(b.isBlur()).to_equal(true)
            expect(b.isFocus()).to_equal(false)
        )

        it("latches immediate-propagation stop", fn() -> ():
            var e = FocusEvent.new("focus", "")
            expect(e.didStopImmediatePropagation()).to_equal(false)
            e.stopImmediatePropagation()
            expect(e.didStopImmediatePropagation()).to_equal(true)
        )
    )
