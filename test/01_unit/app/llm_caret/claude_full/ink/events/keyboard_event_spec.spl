# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: the ink KeyboardEvent port must reproduce the upstream key-name,
printability, and modifier semantics for parsed terminal sequences.
Audience: llm_caret engineers who maintain the Claude Code TUI event layer.
"""

# @manual_section: Key resolution and modifier semantics

use std.spec.step

use std.spec.{describe, it, expect}
use app.llm_caret.claude_full.ink.events.keyboard_event.{KeyboardEvent, ParsedKeyboardKey, parsedKeyboardKeyNew, keyFromParsed}

describe "ink KeyboardEvent":
    it "uses a printable single-character sequence as the key":
        # @req REQ-SSPEC-UNIT
        step("Verify: printable single-character sequence resolves to the key")
        val e = KeyboardEvent.new(parsedKeyboardKeyNew("a", "a"))
        expect(e.key).to_equal("a")
        expect(e.printableChar()).to_equal(true)

    it "prefers the parsed name for named keys":
        # @req REQ-SSPEC-UNIT
        step("Verify: named key sequence resolves to the parsed name")
        val e = KeyboardEvent.new(parsedKeyboardKeyNew("up", "[A"))
        expect(e.key).to_equal("up")
        expect(e.printableChar()).to_equal(false)

    it "uses the name when ctrl is held even for a printable sequence":
        # @req REQ-SSPEC-UNIT
        step("Verify: ctrl modifier keeps the parsed name")
        var p = parsedKeyboardKeyNew("c", "\u{3}")
        p.ctrl = true
        val e = KeyboardEvent.new(p)
        expect(e.key).to_equal("c")
        expect(e.ctrl).to_equal(true)

    it "does not treat DEL (127) as a printable key sequence":
        # @req REQ-SSPEC-UNIT
        step("Verify: DEL sequence resolves to backspace, not a printable")
        expect(keyFromParsed(parsedKeyboardKeyNew("backspace", "\u{7f}"))).to_equal("backspace")

    it "folds option into meta but keeps super separate":
        # @req REQ-SSPEC-UNIT
        step("Verify: option folds into meta while super stays distinct")
        var p = parsedKeyboardKeyNew("a", "a")
        p.option = true
        p.superKey = true
        val e = KeyboardEvent.new(p)
        expect(e.meta).to_equal(true)
        expect(e.superKey).to_equal(true)

    it "is a bubbling, cancelable keydown by construction":
        # @req REQ-SSPEC-UNIT
        step("Verify: constructed event carries keydown bubbling defaults")
        val e = KeyboardEvent.new(parsedKeyboardKeyNew("a", "a"))
        expect(e.type).to_equal("keydown")
        expect(e.bubbles).to_equal(true)
        expect(e.cancelable).to_equal(true)

    it "latches immediate-propagation stop":
        # @req REQ-SSPEC-UNIT
        step("Verify: stopImmediatePropagation latches")
        var e = KeyboardEvent.new(parsedKeyboardKeyNew("a", "a"))
        expect(e.didStopImmediatePropagation()).to_equal(false)
        e.stopImmediatePropagation()
        expect(e.didStopImmediatePropagation()).to_equal(true)
