# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use app.llm_caret.claude_full.ink.events.terminal_event.{TerminalEvent, terminalEventNew, terminalEventWithInit, normalizeEventPhase, terminalEventPhases}

fn main() -> ():
    describe("ink TerminalEvent", fn() -> ():
        it("defaults to bubbling and cancelable with an empty target and none phase", fn() -> ():
            # @req REQ-SSPEC-UNIT
            val e = TerminalEvent.new("keydown")
            expect(e.type).to_equal("keydown")
            expect(e.bubbles).to_equal(true)
            expect(e.cancelable).to_equal(true)
            expect(e.target).to_equal("")
            expect(e.eventPhase).to_equal("none")
        )

        it("honours an explicit init for bubbles and cancelable", fn() -> ():
            val e = terminalEventWithInit("click", false, false)
            expect(e.bubbles).to_equal(false)
            expect(e.cancelable).to_equal(false)
        )

        it("only marks defaultPrevented when the event is cancelable", fn() -> ():
            var cancelable = TerminalEvent.new("keydown")
            cancelable.preventDefault()
            expect(cancelable.defaultPrevented).to_equal(true)
            var fixed = terminalEventWithInit("keydown", true, false)
            fixed.preventDefault()
            expect(fixed.defaultPrevented).to_equal(false)
        )

        it("stopImmediatePropagation also stops ordinary propagation", fn() -> ():
            var e = terminalEventNew("keydown")
            expect(e.isPropagationStopped()).to_equal(false)
            e.stopImmediatePropagation()
            expect(e.isImmediatePropagationStopped()).to_equal(true)
            expect(e.isPropagationStopped()).to_equal(true)
        )

        it("stopPropagation does not imply immediate stop", fn() -> ():
            var e = terminalEventNew("keydown")
            e.stopPropagation()
            expect(e.isPropagationStopped()).to_equal(true)
            expect(e.isImmediatePropagationStopped()).to_equal(false)
        )

        it("tracks target, currentTarget and clears currentTarget", fn() -> ():
            var e = terminalEventNew("keydown")
            e.setTarget("root")
            e.setCurrentTarget("child")
            expect(e.target).to_equal("root")
            expect(e.currentTarget).to_equal("child")
            e.clearCurrentTarget()
            expect(e.currentTarget).to_equal("")
        )

        it("normalizes event phases and rejects unknown ones", fn() -> ():
            expect(normalizeEventPhase("capturing")).to_equal("capturing")
            expect(normalizeEventPhase("at_target")).to_equal("at_target")
            expect(normalizeEventPhase("bubbling")).to_equal("bubbling")
            expect(normalizeEventPhase("sideways")).to_equal("none")
            expect(terminalEventPhases().len()).to_equal(4)
        )

        it("answers exactly one phase predicate at a time", fn() -> ():
            var e = terminalEventNew("keydown")
            e.setEventPhase("bubbling")
            expect(e.phaseIsBubbling()).to_equal(true)
            expect(e.phaseIsCapturing()).to_equal(false)
            expect(e.phaseIsAtTarget()).to_equal(false)
        )

        it("records the prepared target", fn() -> ():
            var e = terminalEventNew("keydown")
            e.prepareForTarget("box-1")
            expect(e.preparedTarget).to_equal("box-1")
        )
    )
    # ponytail: explicit unit return - trailing describe() leaks a value into
    # the process exit code, so a 0-failure spec exits 1. Bug: doc/08_tracking/bug/
    # spec_describe_in_main_leaks_exit_code_2026-08-30.md
    return ()
