"""
# `cs` Entry Loop

**Requirements:** doc/02_requirements/feature/cs_caret_suite.md FR-1, FR-5
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

`cs` with no arguments opens the caret-suite dashboard and reads commands from
the input line pinned to the bottom of the frame. This spec drives that loop
through the `CaretIo` seam — a struct of plain functions — so the whole thing
runs with no terminal, no tmux and no live agent. That seam is the reason the
entry point is testable at all; a loop that reached the terminal directly could
only be tested by hand.

## Behavior

- The loop renders a frame before reading, so an operator sees the dashboard
  before being asked for input.
- `/quit` ends the session and reports `quit`; end-of-input ends it as `eof`.
  These are distinguished because one is an operator decision and the other is
  a closed pipe.
- A command's outcome is emitted, and the next frame reflects the re-polled
  state rather than the optimistic one.
- A non-tty reports a 0x0 terminal; the frame is clamped to a readable minimum
  instead of collapsing to zero rows.
- The session name comes from the first non-flag argument, defaulting to
  `caret`; a flag is never mistaken for a session name.
"""

# @feature cs_caret_suite
# tag: unit

use std.spec
use app.llm_caret.tui_io.{CaretIo, CaretTerminalResult, caret_terminal_ok}
use app.llm_caret.cs_main.{cs_run, cs_session_from_args, cs_effective_size, CS_DEFAULT_SESSION}
use std.nogc_sync_mut.tui.terminal.{TerminalSize}

# --- deterministic CaretIo -------------------------------------------------
# Scripted stdin plus a captured transcript. Module-level because the CaretIo
# fields are plain fn values with no place to carry state.
var SCRIPT: [text] = []
var SCRIPT_AT: i64 = 0
# EMITTED grows monotonically and is never re-bound: each example records a
# MARK index instead of clearing it.
#
# Why: an earlier formulation cleared EMITTED inside the per-example helper and
# then read it back empty, while the same run proved the frames really were
# produced. The mark-based form is reliable and is what this spec uses.
# The exact cause was NOT isolated -- a minimal probe that re-binds an array
# module var from a helper and pushes to it passes -- so treat this as a
# workaround whose trigger is still unknown, not as a diagnosed defect. Do not
# cite it as evidence for a language bug.
var EMITTED: [text] = []
var MARK: i64 = 0

fn _script_read_line() -> text?:
    if SCRIPT_AT >= SCRIPT.len():
        return nil
    val line = SCRIPT[SCRIPT_AT]
    SCRIPT_AT = SCRIPT_AT + 1
    line

fn _capture_emit(s: text):
    EMITTED.push(s)

fn _fixed_size() -> TerminalSize:
    TerminalSize(cols: 80, rows: 24)

fn _zero_size() -> TerminalSize:
    TerminalSize(cols: 0, rows: 0)

fn _not_tty() -> bool:
    false

fn _begin() -> CaretTerminalResult:
    caret_terminal_ok("begin")

fn _end() -> CaretTerminalResult:
    caret_terminal_ok("end")

fn _noop():
    pass

fn _draw(row: i64, col: i64, content: text):
    pass

fn _read_byte() -> i64:
    -1

fn _io(size_fn: fn() -> TerminalSize) -> CaretIo:
    CaretIo(
        is_tty: _not_tty,
        terminal_size: size_fn,
        begin_tui: _begin,
        end_tui: _end,
        clear_screen: _noop,
        draw_at: _draw,
        flush: _noop,
        read_byte: _read_byte,
        read_line: _script_read_line,
        emit: _capture_emit
    )

fn _arm(lines: [text]):
    SCRIPT = lines
    SCRIPT_AT = 0
    MARK = EMITTED.len()

fn _emitted_since_mark() -> i64:
    EMITTED.len() - MARK

fn _transcript() -> text:
    var out = ""
    var i = MARK
    while i < EMITTED.len():
        out = out + EMITTED[i] + "\n"
        i = i + 1
    out

describe "cs entry loop":

    it "shows the dashboard before asking the operator for anything":
        """
        A prompt with no frame above it would be unusable: the operator cannot
        choose an agent they cannot see.
        """
        step("Run the loop against input that closes immediately")
        _arm([])
        val result = cs_run(_io(_fixed_size), "cs-spec")

        step("A frame was emitted even though no command was ever entered")
        expect(_emitted_since_mark()).to_be_greater_than(0)
        expect(result.exit_reason).to_equal("eof")

    it "ends on /quit and reports it as an operator decision, not a closed pipe":
        step("Script a single /quit")
        _arm(["/quit"])
        val result = cs_run(_io(_fixed_size), "cs-spec")

        step("The loop stops and distinguishes quit from eof")
        expect(result.exit_reason).to_equal("quit")
        expect(result.ok).to_equal(true)

    it "emits the outcome of a command so the operator sees what happened":
        step("Launch an agent, then quit")
        _arm(["/launch caret:glm", "/quit"])
        val result = cs_run(_io(_fixed_size), "cs-spec")

        step("The transcript carries the launch outcome")
        expect(result.exit_reason).to_equal("quit")
        expect(_transcript()).to_contain("a1")

    it "surfaces the parser's own error for an unusable launch spec":
        """
        An unparseable spec must not launch anything, and the operator must be
        told why in the parser's words rather than a generic failure.
        """
        step("Attempt a CLI harness with a provider, which the grammar forbids")
        _arm(["/launch claude:glm", "/quit"])
        val result = cs_run(_io(_fixed_size), "cs-spec")

        step("The refusal names the rule that was broken")
        expect(_transcript()).to_contain("provider")

    it "keeps the frame readable when stdin is a pipe and the terminal is 0x0":
        step("A non-tty reports no dimensions")
        val (cols, rows) = cs_effective_size(0, 0)

        step("The frame is clamped to a usable minimum, not collapsed")
        expect(cols).to_be_greater_than(39)
        expect(rows).to_be_greater_than(9)

        step("A real terminal size is passed through untouched")
        val (c2, r2) = cs_effective_size(120, 40)
        expect(c2).to_equal(120)
        expect(r2).to_equal(40)

describe "cs session selection":

    it "defaults to the caret session when no argument is given":
        expect(cs_session_from_args([])).to_equal(CS_DEFAULT_SESSION)
        expect(CS_DEFAULT_SESSION).to_equal("caret")

    it "takes the first non-flag argument as the session name":
        expect(cs_session_from_args(["my-session"])).to_equal("my-session")

    it "never mistakes a flag for a session name":
        """
        Flags are reserved for later options. Treating `--verbose` as a tmux
        session would silently attach the operator to the wrong place.
        """
        expect(cs_session_from_args(["--verbose"])).to_equal(CS_DEFAULT_SESSION)
        expect(cs_session_from_args(["--verbose", "real"])).to_equal("real")
