# @tag: llm_caret, smux, agent_workspace
"""
## Purpose and audience

An operator whose LLM Caret workspace cannot start its smux owner wants the
error to say why, not just `smux owner did not start`. This specification
pins the cause for the most common native-binary mistake: running a native
caret without SIMPLE_BINARY, so no interpreter exists to run the owner.

## Operator workflow

Run `bin/simple test test/01_unit/app/llm_caret/smux_owner_start_error_spec.spl`.
The scenario only applies to the Windows smux backend; elsewhere it records
that the smux owner is not used.

## Compatibility and limitations

Calls the real `smux_owner_start` with a native caret executable name and
SIMPLE_BINARY cleared; SIMPLE_BINARY is restored afterwards.

## Verification guidance and troubleshooting

If the message lacks the cause, check the early exits of `smux_owner_start`
in `src/app/llm_caret/agent_workspace.spl`.
"""

use std.spec.{describe, it, expect, step}
use app.io.mod.{env_get, env_set, cwd}
use app.llm_caret.agent_workspace.{agent_workspace, workspace_backend, smux_owner_start}

describe "LLM Caret smux owner start errors":
    it "names a missing SIMPLE_BINARY as the reason a native caret cannot start the owner":
        step("Use a workspace on the smux backend")
        if workspace_backend() != "smux":
            expect(workspace_backend()).to_equal("tmux")
            return
        val ws = agent_workspace("caret-owner-err", cwd(), cwd() + "/build/test-artifacts/llm_caret/owner_err")
        val pinned = env_get("SIMPLE_BINARY")
        step("Start the owner as a native caret with SIMPLE_BINARY cleared")
        env_set("SIMPLE_BINARY", "")
        val err = smux_owner_start(ws, "C:/caret/llm_caret.exe")
        env_set("SIMPLE_BINARY", pinned)
        expect(err).to_equal("smux owner did not start: SIMPLE_BINARY not set (native llm_caret.exe needs a simple interpreter)")
