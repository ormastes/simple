# Purpose and audience: executable specification evidence for the owning engineering team.

"""
Caret TUI entry key dispatch (REQ-CARET-UI-004, CU-005): tui_entry routes keys
through the pure resolver with the configured leader.
"""

use std.spec.*
use app.llm_caret.workbench.leader_keys.{LeaderAction, new_leader_state}
use app.llm_caret.workbench.key_resolver.{KeyFocus, KeyRouteKind, key_event, leader_switch_target}
use app.llm_caret.workbench.tui_entry.{route_workbench_key, workbench_leader, key_route_status}

describe "Caret TUI entry key dispatch (CU-005)":
    it "uses ctrl+g as the default leader and routes a bound chord to an action":
        # @req REQ-CARET-UI-004
        step("Press the leader then 't' on the terminal surface")
        expect(workbench_leader()).to_equal("ctrl+g")
        val first = route_workbench_key(new_leader_state(), key_event("ctrl+g", [7]), KeyFocus.TerminalSurface)
        expect(first.route.kind).to_equal(KeyRouteKind.Consume)
        val second = route_workbench_key(first.state, key_event("t", [116]), KeyFocus.TerminalSurface)
        expect(second.route.kind).to_equal(KeyRouteKind.Action)
        expect(second.route.action).to_equal(LeaderAction.TraceView)
        expect(key_route_status(second.route)).to_equal("not available yet")

    it "forwards plain terminal keys and reports no status for them":
        # @req REQ-CARET-UI-004
        val r = route_workbench_key(new_leader_state(), key_event("x", [120]), KeyFocus.TerminalSurface)
        expect(r.route.kind).to_equal(KeyRouteKind.Forward)
        expect(key_route_status(r.route)).to_equal("")

    it "maps next/prev/pinned leader actions to agent numbers":
        # @req REQ-CARET-UI-004
        expect(leader_switch_target(LeaderAction.NextAgent, 0, -1, 3)).to_equal(1)
        expect(leader_switch_target(LeaderAction.NextAgent, 0, 2, 3)).to_equal(1)
        expect(leader_switch_target(LeaderAction.PrevAgent, 0, 0, 3)).to_equal(3)
        expect(leader_switch_target(LeaderAction.PrevAgent, 0, -1, 3)).to_equal(3)
        expect(leader_switch_target(LeaderAction.PinnedSlot, 2, 0, 3)).to_equal(2)
        expect(leader_switch_target(LeaderAction.PinnedSlot, 5, 0, 3)).to_equal(0)
        expect(leader_switch_target(LeaderAction.NextAgent, 0, -1, 0)).to_equal(0)
