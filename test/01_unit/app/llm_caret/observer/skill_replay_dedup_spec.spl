# Purpose and audience: a replayed hook event must count once for skill-use decay, for the caret team.
# @req CU-006

use std.spec.*
use app.llm_caret.observer.observer_log.{observer_reset, observer_record_skill, observer_skill_uses}

fn _payload(name: text) -> text:
    "{\"tool_name\":\"Skill\",\"tool_input\":{\"skill\":\"" + name + "\"}}"

describe "observer_record_skill dedup":
    it "counts a replayed event id once and distinct ids separately":
        observer_reset()
        observer_record_skill("claude", "builder", "PreToolUse", _payload("tdd"), "e1")
        observer_record_skill("claude", "builder", "PreToolUse", _payload("tdd"), "e1")
        expect(observer_skill_uses("builder", "tdd")).to_equal(1)
        observer_record_skill("claude", "builder", "PreToolUse", _payload("tdd"), "e2")
        expect(observer_skill_uses("builder", "tdd")).to_equal(2)
