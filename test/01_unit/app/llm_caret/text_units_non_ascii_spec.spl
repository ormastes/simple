"""
## Purpose and audience
Purpose: As a caret user typing or reading non-ASCII text, I want tool output
truncation, edit-occurrence counting, slash-command splitting and container
names to stay correct when the text has multi-byte UTF-8 characters.
Audience: maintainers of llm_caret text helpers.
"""
# @req: REQ-APP-LLM-CARET-001 — stable requirement identity for this spec.
use app.llm_caret.tools.{_truncate, _count_occurrences}
use app.llm_caret.chat_tui.{parse_slash_command}
use app.llm_caret.cs_container.{cs_container_name}

describe "llm_caret text units on non-ASCII input":
    it "truncates output whose byte size exceeds the byte budget":
        # 4 chars, 8 bytes; a 5-byte budget must truncate.
        val out = _truncate("éééé", 5)
        expect(out.contains("[output truncated: 8 bytes total]")).to_equal(true)

    it "counts every occurrence after multi-byte characters":
        expect(_count_occurrences("éé x x", "x")).to_equal(2)

    it "splits a slash command whose name has a non-ASCII character":
        val (cmd, arg) = parse_slash_command("/héllo world")
        expect(cmd).to_equal("héllo")
        expect(arg).to_equal("world")

    it "keeps trailing ASCII of an agent id after a non-ASCII character":
        expect(cs_container_name("s", "é1").ends_with("---1")).to_equal(true)
