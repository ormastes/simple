# @req REQ-003

use std.spec.*
use std.io_runtime.{file_read}

describe "cs and smux launchers":
    it "routes Windows launchers through the canonical Simple wrapper":
        val cs = file_read("bin/cs.cmd")
        val smux = file_read("bin/smux.cmd")

        expect(cs).to_contain("call \"%~dp0simple.cmd\" \"%~dp0..\\src\\app\\llm_caret\\cs_main.spl\" %*")
        expect(smux).to_contain("call \"%~dp0simple.cmd\" \"%~dp0..\\src\\app\\hosted_apps\\smux_client.spl\" %*")
        expect(cs).to_contain("exit /b %ERRORLEVEL%")
        expect(smux).to_contain("exit /b %ERRORLEVEL%")

    it "routes POSIX smux through the same source entry point":
        val smux = file_read("bin/smux")

        expect(smux).to_contain("exec \"$ROOT/bin/simple\" \"$ROOT/src/app/hosted_apps/smux_client.spl\" \"$@\"")
