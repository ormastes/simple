"""
CU-012 acceptance: `pass`, `not_run`, `stale`, `incomplete`, `missing`,
`waived` never flatten to green complete.

Only `pass` may be green, alone or in a rollup. The evidence model has no
dedicated `waived` status; a waived requirement is recorded as
`NotApplicable`, which the provider maps to INCOMPLETE (never green).
"""
# @req CU-012 REQ-CARET-TRC-001

use std.spec.*
use std.common.traceability.evidence_model.*
use app.traceability.ide_view_provider.*

fn cu012_green(b: EvidenceBadge) -> bool:
    badge_is_green(b) == EvidenceGreennessV1.Green

describe "CU-012 statuses never flatten to green":

    it "only pass is green among the six acceptance statuses":
        # @req CU-012
        expect(cu012_green(badge_for(TraceQualificationStatus.Verified))).to_equal(true)
        expect(cu012_green(badge_for(TraceQualificationStatus.NotRun))).to_equal(false)
        expect(cu012_green(badge_for(TraceQualificationStatus.Stale))).to_equal(false)
        expect(cu012_green(badge_for(TraceQualificationStatus.Incomplete))).to_equal(false)
        expect(cu012_green(EvidenceBadge.Missing)).to_equal(false)
        expect(cu012_green(badge_for(TraceQualificationStatus.NotApplicable))).to_equal(false)

    it "keeps each non-pass status distinct from PASS in its label":
        # @req CU-012
        val pass_label = badge_label(EvidenceBadge.Pass)
        expect(badge_label(EvidenceBadge.NotRun) == pass_label).to_equal(false)
        expect(badge_label(EvidenceBadge.Stale) == pass_label).to_equal(false)
        expect(badge_label(EvidenceBadge.Incomplete) == pass_label).to_equal(false)
        expect(badge_label(EvidenceBadge.Missing) == pass_label).to_equal(false)
        expect(badge_label(badge_for(TraceQualificationStatus.NotApplicable)) == pass_label).to_equal(false)

    it "a single non-pass child keeps the rollup off green":
        # @req CU-012
        val others = [EvidenceBadge.NotRun, EvidenceBadge.Stale, EvidenceBadge.Incomplete,
            EvidenceBadge.Missing, badge_for(TraceQualificationStatus.NotApplicable)]
        for b in others:
            val r = rollup([EvidenceBadge.Pass, b, EvidenceBadge.Pass])
            expect(cu012_green(r)).to_equal(false)
            expect(badge_label(r)).to_equal(badge_label(b))

    it "an all-pass rollup is green and an empty rollup is not":
        # @req CU-012
        expect(cu012_green(rollup([EvidenceBadge.Pass, EvidenceBadge.Pass]))).to_equal(true)
        expect(cu012_green(rollup([]))).to_equal(false)
