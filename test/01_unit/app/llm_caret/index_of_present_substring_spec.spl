"""
## Purpose and audience
Purpose: Probe that text.index_of finds a present substring and that char.to_i64
works across a module boundary (bug llm_caret_index_of_optioni64_tagbox_2026-07-07).
Audience: llm_caret maintainers deciding whether json_find / _digit_val workarounds can go.
"""
# @req: REQ-APP-LLM-CARET-001 — stable requirement identity for this spec.

use app.llm_caret.json_helpers.{json_find, json_parse_int}

describe "text.index_of present substring probe":
    it "finds a substring at index 3 (the historically nil case)":
        val s = "abcXYZ"
        expect(s.index_of("XYZ")).to_equal(3)

    it "finds a substring at index 0":
        expect("hello".index_of("he")).to_equal(0)

    it "finds a substring in the middle of a JSON-like string":
        val s = "{\"k\":\"v\"}"
        expect(s.index_of("\"v\"")).to_equal(5)

    it "agrees with json_find across the module boundary":
        expect(json_find("abcXYZ", "XYZ")).to_equal(3)

describe "digit parsing cross-module probe":
    it "json_parse_int parses digits cross-module":
        expect(json_parse_int("1234")).to_equal(1234)
