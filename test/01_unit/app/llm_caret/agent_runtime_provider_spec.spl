use app.llm_caret.agent_runtime.{is_known_agent_provider, agent_command_for_provider_with_gemini, launch_agent_plan_with_gemini, launch_agent_team_with_gemini}
use app.llm_caret.agent_plan.{AgentLaunchPlan, AgentLaunchRequest}

describe "LLM Caret agent runtime provider hardening":
    it "accepts the known provider set":
        assert_true(is_known_agent_provider("claude"))
        assert_true(is_known_agent_provider("claude_cli"))
        assert_true(is_known_agent_provider("codex"))
        assert_true(is_known_agent_provider("opencode_cli"))
        assert_true(is_known_agent_provider("gemini"))
        assert_true(is_known_agent_provider("gemini_cli"))
        assert_true(is_known_agent_provider("team"))
        assert_true(is_known_agent_provider(""))

    it "rejects unknown providers":
        assert_false(is_known_agent_provider("bogus"))
        assert_false(is_known_agent_provider("claude; rm -rf /"))

    it "maps providers to configured binary paths":
        expect(agent_command_for_provider_with_gemini("codex", "/c", "/x", "/g", "/o")).to_equal("/x")
        expect(agent_command_for_provider_with_gemini("gemini", "/c", "/x", "/g", "/o")).to_equal("/g")
        expect(agent_command_for_provider_with_gemini("opencode_cli", "/c", "/x", "/g", "/o")).to_equal("/o")
        expect(agent_command_for_provider_with_gemini("claude_cli", "/c", "/x", "/g", "/o")).to_equal("/c")

    it "refuses to launch an unknown provider instead of falling back to claude":
        val plan = AgentLaunchPlan(provider: "bogus", mode: "agent", prompt: "p", argv: ["-p", "p"], summary: "s")
        val proc = launch_agent_plan_with_gemini("agent-1", plan, "/bin/echo", "/bin/echo", "/bin/echo", "/bin/echo")
        expect(proc.status).to_equal("error")
        expect(proc.reason).to_equal("unknown_provider:bogus")
        expect(proc.pid).to_equal(-1)

    it "keeps team agent ids unique when agent_md_paths collide":
        val req = AgentLaunchRequest(provider: "bogus", agent_md_path: "agents/dup.md",
            skill_path: "", task_desc: "t", model: "", session_id: "", extra_args: [])
        val team = launch_agent_team_with_gemini("team-1", [req, req], "", "", "", "")
        expect(team.processes.len()).to_equal(2)
        expect(team.processes[0].agent_id).to_equal("agents/dup.md")
        expect(team.processes[1].agent_id).to_equal("agents/dup.md#1")
