# AUTHORED_NOT_RUN: requires the qualified self-hosted Simple runtime.
use std.spec
use app.llm_caret.provider_cli_adapter_v1.decode_provider_cli_provider_v1
use app.llm_caret.provider_cli_adapter_types_v1.ProviderCliVersionDataV1
use std.common.contracts.provider_cli.adapter_v1.{provider_cli_probe_argv_v1, decode_provider_cli_version_v1}

fn neutral_exports_legacy_version_v1(value: ProviderCliVersionDataV1) -> text:
    value.version

describe "Provider CLI neutral compatibility exports":
    it "passes the legacy provider type into the neutral fixed probe planner":
        val provider = decode_provider_cli_provider_v1("codex").unwrap()
        val argv = provider_cli_probe_argv_v1(provider, 0).unwrap()
        expect(argv).to_equal(["--version"])

    it "returns the original nominal version type through the legacy export":
        val provider = decode_provider_cli_provider_v1("codex").unwrap()
        val version = decode_provider_cli_version_v1(provider, "codex-cli 0.169.0\n").unwrap()
        expect(neutral_exports_legacy_version_v1(version)).to_equal("0.169.0")

    it "preserves version family rejection through the compatibility path":
        val provider = decode_provider_cli_provider_v1("codex").unwrap()
        val result = decode_provider_cli_version_v1(provider, "0.169.0 (Claude Code)")
        expect(result.unwrap_err()).to_equal("provider-cli-version-unsupported-or-family-mismatch")
