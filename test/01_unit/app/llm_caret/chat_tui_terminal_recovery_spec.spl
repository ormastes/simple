use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn terminal_source() -> text:
    rt_file_read_text("src/lib/nogc_sync_mut/tui/terminal.spl") ?? ""

fn input_source() -> text:
    rt_file_read_text("src/app/llm_caret/tui_input.spl") ?? ""

fn io_source() -> text:
    rt_file_read_text("src/app/llm_caret/tui_io.spl") ?? ""

describe "LLM Caret terminal recovery contract":
    it "uses the canonical terminal TTY facade instead of a local extern":
        expect(input_source()).to_contain("terminal_stdin_is_tty")
        expect(terminal_source()).to_contain("extern fn rt_terminal_is_tty() -> bool")

    it "installs panic and normal-exit raw-mode recovery through the terminal owner":
        val terminal = terminal_source()
        val io = io_source()

        expect(terminal).to_contain("extern fn rt_atexit_install() -> i64")
        expect(terminal).to_contain("fn terminal_install_recovery() -> bool:")
        expect(io).to_contain("terminal_install_recovery")

    it "routes SIGWINCH resize latches through the terminal owner":
        val terminal = terminal_source()
        val io = io_source()

        expect(terminal).to_contain("extern fn rt_signal_install(signal_num: i64) -> i64")
        expect(terminal).to_contain("extern fn rt_signal_check(signal_num: i64) -> i64")
        expect(terminal).to_contain("fn terminal_resize_pending() -> bool:")
        expect(io).to_contain("terminal_resize_pending")
