# @req REQ-CARET-UI-001
# @cover src/app/llm_caret/pane_backend.spl 5%

use std.spec.*
use app.llm_caret.pane_backend.{smux_owner_argv}

describe "smux owner launch argv":
    it "runs the owner through the current exe when it is the simple interpreter":
        # @req REQ-CARET-UI-001
        step("interpreted caret: own exe is simple.exe")
        val r = smux_owner_argv("C:/bin/simple.exe", "", "C:/r/smux_client.spl", "C:/s/a.owner")
        expect(r.is_ok()).to_equal(true)
        expect(r.unwrap()).to_equal(["C:/bin/simple.exe", "run", "C:/r/smux_client.spl", "--serve-owner-file", "C:/s/a.owner"])

    it "uses the configured interpreter, never itself, for a native caret binary":
        # @req REQ-CARET-UI-001
        step("native caret: own exe is llm_caret.exe")
        val r = smux_owner_argv("C:/bin/llm_caret.exe", "D:/tools/simple.exe", "C:/r/smux_client.spl", "C:/s/a.owner")
        expect(r.unwrap()).to_equal(["D:/tools/simple.exe", "run", "C:/r/smux_client.spl", "--serve-owner-file", "C:/s/a.owner"])

    it "keeps paths with spaces as single argv elements":
        # @req REQ-CARET-UI-001
        step("native caret with spaces in every path")
        val r = smux_owner_argv("C:\Program Files\Caret\llm_caret.exe", "C:\Program Files\Simple\simple.exe", "C:\My Repo\smux_client.spl", "C:\Doc Dir\a.owner")
        expect(r.unwrap()).to_equal(["C:\Program Files\Simple\simple.exe", "run", "C:\My Repo\smux_client.spl", "--serve-owner-file", "C:\Doc Dir\a.owner"])

    it "reports an explicit error when a native caret has no interpreter configured":
        # @req REQ-CARET-UI-001
        step("native caret, empty interpreter")
        val r = smux_owner_argv("/usr/bin/llm_caret", "", "/r/smux_client.spl", "/s/a.owner")
        expect(r.is_err()).to_equal(true)
        expect(r.unwrap_err().contains("interpreter")).to_equal(true)
