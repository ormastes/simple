# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
#
# Design §18.3 (item C8): a viewer that notices an agent went offline must
# never force-remove its worktree. `worktree_remove` (operator path) stays
# forced; `worktree_release` builds its argv without `--force`.

use std.spec
use std.spec.step
use app.llm_caret.agent_workspace.{worktree_remove_args_v1}

describe "agent worktree release argv":
    it "passes --force only on the explicit operator path":
        # @req REQ-SSPEC-UNIT
        step("forced (operator remove/detach)")
        val forced = worktree_remove_args_v1("/repo", "/repo/.agents/a1", true)
        expect(forced.join(" ")).to_equal("-C /repo worktree remove --force /repo/.agents/a1")
        step("release (viewer / offline agent)")
        val release = worktree_remove_args_v1("/repo", "/repo/.agents/a1", false)
        expect(release.contains("--force")).to_equal(false)
        expect(release.join(" ")).to_equal("-C /repo worktree remove /repo/.agents/a1")
