use std.spec
use app.llm_caret.workbench.remote_pane_view_v1.*
use app.orchestrator.controller_gateway_v1.controller_gateway_request_decode_v1
use app.orchestrator.validation.OrchestratorValidationReplyV1
use std.common.config_core.server_context_types_v1.{ResolvedServerV1, ServerRecordV1}
use std.common.contracts.container.primary_attach_v1.HostAgentPaneBindingV4
use std.common.contracts.orchestration.host_agent_pane_stream_v6.{HostAgentPaneTargetReceiptV6,
    HostAgentPaneStreamReceiptV6, host_agent_pane_target_receipt_encode_v6, host_agent_pane_stream_receipt_encode_v6}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.encode.sdn_encode_canonical
use std.common.sdn.value.SdnValue

fn pane_scope_v1() -> CaretRemotePaneScopeV1:
    val record = ServerRecordV1(name: "ci", transport: "ssh", host: "build.example.test", port: 2222,
        container_host: "", auth_ref: "secret://test/operator", tls_ref: "trust://test/ci", remote_executable: "/opt/simple/bin/simple")
    val server = ResolvedServerV1(record: record, consumer: "caret", context: "test", source: "context_consumer")
    CaretRemotePaneScopeV1(server: server, profile_path: "/private/ssh.sdn", controller_id: "controller-1", scope_digest: "a".repeat(64),
        operation_id: "run-1", invoke_digest: "b".repeat(64), binding_uid: "bound-1", attach_digest: "c".repeat(64))

fn pane_binding_v1() -> HostAgentPaneBindingV4:
    HostAgentPaneBindingV4(binding_uid: "bound-1", service_incarnation: "d".repeat(32), service_epoch: 7,
        session_id: "session-1", window_id: "window-1", pane_id: "pane-1")

fn pane_target_v1(scope: CaretRemotePaneScopeV1) -> text:
    host_agent_pane_target_receipt_encode_v6(HostAgentPaneTargetReceiptV6(operation_id: scope.operation_id,
        invoke_digest: scope.invoke_digest, service_incarnation: "d".repeat(32), service_epoch: 7,
        session_id: "session-1", window_id: "window-1", pane_id: "pane-1"))

fn pane_receipt_v1(view: CaretRemotePaneViewV1, provided: [i64], eof: bool = false) -> text:
    val pending = view.outstanding.unwrap().pane
    var fields: Dict<text, SdnValue> = {}
    if pending.read_id == 0:
        fields = {"version": SdnValue.Int(4), "kind": SdnValue.String("host-agent-pane-lease"),
            "operationId": SdnValue.String(view.scope.operation_id), "epoch": SdnValue.Int(0)}
    else:
        var chunks: [SdnValue] = []
        if provided.len() > 0:
            var bytes: [SdnValue] = []
            for item in provided: bytes.push(SdnValue.Int(item))
            chunks.push(SdnValue.Dict({"stream": SdnValue.String("stdout"), "bytes": SdnValue.Array(bytes)}))
        fields = {"version": SdnValue.Int(4), "kind": SdnValue.String("host-agent-pane-read"),
            "eof": SdnValue.Bool(eof), "chunks": SdnValue.Array(chunks)}
    val payload = sdn_encode_canonical(SdnValue.Dict(fields))
    host_agent_pane_stream_receipt_encode_v6(HostAgentPaneStreamReceiptV6(operation_id: view.scope.operation_id,
        binding_uid: pending.binding_uid, attach_digest: pending.attach_digest, epoch: 0, read_id: pending.read_id,
        payload: payload, payload_digest: sha256_text(payload)))

fn pane_claimed_v1() -> CaretRemotePaneViewV1:
    val scope = pane_scope_v1()
    val opened = caret_remote_pane_open_v1(scope, pane_binding_v1(), pane_target_v1(scope)).unwrap()
    val claiming = caret_remote_pane_begin_v1(opened).unwrap()
    pane_complete_v1(claiming, scope, claiming.outstanding.unwrap().source, 0, pane_receipt_v1(claiming, [])).unwrap()

fn pane_complete_v1(view: CaretRemotePaneViewV1, scope: CaretRemotePaneScopeV1, source: text,
        code: i64, output: text) -> Result<CaretRemotePaneViewV1, text>:
    caret_remote_pane_complete_v1(view, scope, source, OrchestratorValidationReplyV1(exit_code: code, output: output))

describe "Caret signed remote pane view":
    it "pins target continuity, native epoch, signed binding metadata, and selected carrier":
        val scope = pane_scope_v1()
        var binding = pane_binding_v1()
        binding.service_epoch = 8
        expect(caret_remote_pane_open_v1(scope, binding, pane_target_v1(scope)).unwrap_err()).to_equal("caret-remote-pane-binding-mismatch")
        val opened = pane_claimed_v1()
        expect(opened.target.service_epoch).to_equal(7)
        expect(opened.stream_epoch).to_equal(0)
        val reading = caret_remote_pane_begin_v1(opened).unwrap()
        var wrong = pane_scope_v1()
        wrong.scope_digest = "f".repeat(64)
        val source = reading.outstanding.unwrap().source
        expect(pane_complete_v1(reading, wrong, source, 0, pane_receipt_v1(reading, [65])).unwrap_err()).to_equal("caret-remote-pane-carrier-mismatch")
        var wrong_server = wrong.server
        var wrong_record = wrong_server.record
        wrong_record.port = 2223
        wrong_server.record = wrong_record
        wrong.server = wrong_server
        wrong.scope_digest = scope.scope_digest
        expect(pane_complete_v1(reading, wrong, source, 0, pane_receipt_v1(reading, [65])).is_err()).to_equal(true)
        expect(pane_complete_v1(reading, scope, source + " ", 0, pane_receipt_v1(reading, [65])).unwrap_err()).to_equal("caret-remote-pane-request-mismatch")

    it "retries lost reads with identical bytes, appends only once, and closes at EOF":
        val ready = pane_claimed_v1()
        val reading = caret_remote_pane_begin_v1(ready).unwrap()
        val first = reading.outstanding.unwrap()
        expect(first.pane.read_id).to_equal(1)
        expect(controller_gateway_request_decode_v1(first.source).unwrap().action).to_equal("agent-pane-read")
        val held = OrchestratorValidationReplyV1(exit_code: 2, output: "", transport_exit_unconfirmed: true)
        expect(caret_remote_pane_complete_v1(reading, ready.scope, first.source, held).unwrap_err()).to_equal("caret-remote-pane-carrier-cleanup-pending")
        expect(caret_remote_pane_retry_v1(reading).is_err()).to_equal(true)
        val lost = pane_complete_v1(reading, ready.scope, first.source, 2, "untrusted remote text").unwrap()
        expect(lost.phase).to_equal(CaretRemotePanePhaseV1.Unconfirmed)
        expect(lost.transcript.len()).to_equal(0)
        expect(caret_remote_pane_begin_v1(lost).is_err()).to_equal(true)
        val retry = caret_remote_pane_retry_v1(lost).unwrap()
        expect(retry.outstanding.unwrap().source).to_equal(first.source)
        val receipt = pane_receipt_v1(retry, [65, 27, 92, 255, 10])
        val read = pane_complete_v1(retry, ready.scope, first.source, 0, receipt).unwrap()
        expect(read.transcript).to_equal(["A\\x1b\\x5c\\xff\n"])
        val next = caret_remote_pane_begin_v1(read).unwrap()
        val duplicate = pane_complete_v1(next, ready.scope, first.source, 0, receipt).unwrap()
        expect(duplicate.transcript).to_equal(read.transcript)
        expect(duplicate.outstanding.unwrap().pane.read_id).to_equal(2)
        val eof = pane_complete_v1(duplicate, ready.scope, duplicate.outstanding.unwrap().source,
            0, pane_receipt_v1(duplicate, [], true)).unwrap()
        expect(eof.phase).to_equal(CaretRemotePanePhaseV1.Eof)
        expect(caret_remote_pane_begin_v1(eof).is_err()).to_equal(true)

    it "freezes on authenticated replay gaps or revocation":
        val ready = pane_claimed_v1()
        val reading = caret_remote_pane_begin_v1(ready).unwrap()
        val exact = reading.outstanding.unwrap().source
        for code in ["runtime-agent-pane-replay-gap", "runtime-agent-pane-revoked"]:
            val report: Dict<text, SdnValue> = {"version": SdnValue.Int(1), "kind": SdnValue.String("agent-pane-read"),
                "state": SdnValue.String("host-refused"), "operationId": SdnValue.String(ready.scope.operation_id),
                "record": SdnValue.String(""), "recordDigest": SdnValue.String(""), "detail": SdnValue.String(code)}
            val refusal = sdn_encode_canonical(SdnValue.Dict(report)) + "\n"
            val frozen = pane_complete_v1(reading, ready.scope, exact, 1, refusal).unwrap()
            expect(frozen.phase).to_equal(CaretRemotePanePhaseV1.Refused)
            expect(frozen.problem).to_equal(code)
            expect(frozen.outstanding.is_none()).to_equal(true)
            expect(caret_remote_pane_retry_v1(frozen).is_err()).to_equal(true)

    it "bounds retained output on complete accepted receipt boundaries":
        var state = pane_claimed_v1()
        for index in 0..33:
            val pending = caret_remote_pane_begin_v1(state).unwrap()
            val source = pending.outstanding.unwrap().source
            state = pane_complete_v1(pending, state.scope, source, 0, pane_receipt_v1(pending, [65 + index])).unwrap()
        expect(state.last_read_id).to_equal(33)
        expect(state.transcript.len()).to_equal(32)
        expect(state.transcript_bytes).to_equal(32)
        expect(state.transcript[0]).to_equal("B")
