# Pure argv coverage for launching a cs agent through the Simple container
# layer. No engine is executed; the real launch/kill smoke is recorded in the
# feature wiki (doc/00_llm_process/feature_expert/podman_container/skill.md).
use app.llm_caret.cs_container.{cs_container_request, cs_container_argv,
    cs_container_name, cs_container_owner, cs_container_spec_is_container}
use app.llm_caret.cs_dashboard.{cs_launch_argv_with_extras, cs_dashboard_new, cs_handle_command}

describe "cs container launch options":
    it "splits container options from the agent's own arguments":
        val request = cs_container_request(["--container", "busybox:1.36", "--workspace", "/work/a1",
            "--container-mount", "/lib/libgcc_s.so.1:/lib/libgcc_s.so.1", "--container-mount", "/data:/data:rw",
            "--container-network", "none", "--verbose"])
        expect(request.error).to_equal("")
        expect(request.image).to_equal("busybox:1.36")
        expect(request.network).to_equal("none")
        expect(request.workspace).to_equal("/work/a1")
        expect(request.rest).to_equal(["--workspace", "/work/a1", "--verbose"])
        expect(request.mounts.len()).to_equal(2)
        expect(request.mounts[0].read_only).to_equal(true)
        expect(request.mounts[1].read_only).to_equal(false)

    it "leaves a launch without --container untouched and defaults to host networking":
        val plain = cs_container_request(["--workspace=/work/a1", "--verbose"])
        expect(plain.image).to_equal("")
        expect(plain.error).to_equal("")
        expect(plain.workspace).to_equal("/work/a1")
        expect(plain.rest).to_equal(["--workspace=/work/a1", "--verbose"])
        expect(cs_container_request(["--container", "img"]).network).to_equal("host")

    it "rejects malformed container options instead of passing them to the agent":
        expect(cs_container_request(["--container"]).error).to_equal("--container needs a value")
        expect(cs_container_request(["--container", "--privileged"]).error).to_equal("--container needs an image")
        expect(cs_container_request(["--container", "img", "--container-network", "bridge"]).error)
            .to_equal("--container-network must be host, none or private")
        expect(cs_container_request(["--container", "img", "--container-mount", "relative:/x"]).error)
            .to_start_with("--container-mount paths must be absolute")
        expect(cs_container_request(["--container", "img", "--container-mount", "/a:/b:exec"]).error)
            .to_equal("--container-mount mode must be ro or rw, got exec")
        expect(cs_container_request(["--container-mount", "/a:/b"]).error)
            .to_equal("--container-mount/--container-network need --container <image>")

describe "cs container argv through the container layer":
    it "wraps the unchanged agent argv with tty, labels, same-path mounts and host network":
        val request = cs_container_request(["--container", "busybox:1.36", "--workspace", "/work/a1"])
        val agent = cs_launch_argv_with_extras("caret:slang/qwen", request.rest)
        expect(agent).to_equal(["simple", "run", "src/app/llm_caret/main.spl", "--provider", "slang",
            "--model", "qwen", "--workspace", "/work/a1"])
        var args: [text] = []
        var i = 1
        while i < agent.len():
            args = args + [agent[i]]
            i = i + 1
        val argv = cs_container_argv("main", "a1", "/opt/seed/simple", args, "/repo", "xterm", request).unwrap()
        expect(argv).to_equal(["podman", "run", "--rm", "--name", "cs-main-a1",
            "--label", "io.simpleorch.session.owner=cs-main", "--label", "io.simpleorch.session.name=cs-main-a1",
            "--interactive", "--tty", "--detach-keys=", "--network", "host", "--userns", "keep-id",
            "--volume", "/repo:/repo:ro", "--volume", "/work/a1:/work/a1:rw", "--volume", "/opt/seed/simple:/opt/seed/simple:ro",
            "--workdir", "/repo", "--env", "TERM=xterm", "--env", "HOME=/tmp", "busybox:1.36",
            "/opt/seed/simple", "run", "src/app/llm_caret/main.spl", "--provider", "slang", "--model", "qwen",
            "--workspace", "/work/a1"])

    it "does not mount a binary that already lives inside the repo or the workspace":
        val request = cs_container_request(["--container", "img"])
        val argv = cs_container_argv("main", "a2", "/repo/bin/simple", ["run", "x.spl"], "/repo", "", request).unwrap()
        expect(argv.join(" ")).to_contain("--volume /repo:/repo:ro --workdir /repo --env TERM=xterm-256color")
        expect(argv.join(" ").contains("/repo/bin/simple:/repo/bin/simple")).to_equal(false)

    it "mounts a workspace that is the repo root once, read-write":
        val request = cs_container_request(["--container", "img", "--workspace", "/repo"])
        val argv = cs_container_argv("main", "a3", "/repo/bin/simple", [], "/repo", "", request).unwrap()
        expect(argv.join(" ")).to_contain("--volume /repo:/repo:rw --workdir /repo")
        expect(argv.join(" ").contains("/repo:/repo:ro")).to_equal(false)

    it "offers /reap as the explicit recovery for a killed cs":
        val (_d, action) = cs_handle_command(cs_dashboard_new("main"), "/reap")
        expect(action).to_equal("container:reap-session")

    it "refuses relative paths and derives engine-safe names from any session":
        val request = cs_container_request(["--container", "img", "--workspace", "work/a1"])
        expect(cs_container_argv("main", "a1", "/bin/simple", [], "/repo", "", request).unwrap_err())
            .to_start_with("container launch needs an absolute --workspace")
        expect(cs_container_argv("main", "a1", "bin/simple", [], "/repo", "", cs_container_request(["--container", "img"])).unwrap_err())
            .to_start_with("container launch needs an absolute executable path")
        expect(cs_container_name("my session/1", "a1")).to_equal("cs-my-session-1-a1")
        expect(cs_container_owner("my session/1")).to_equal("cs-my-session-1")

    it "recognises a containerized agent from its roster spec, so /kill knows to reap":
        val d = cs_dashboard_new("main")
        val (launched, action) = cs_handle_command(d, "/launch caret:dummy --container busybox:1.36")
        expect(action).to_start_with("launch:a1 ")
        expect(cs_container_spec_is_container(launched.agents[0].spec)).to_equal(true)
        val (plain, _action) = cs_handle_command(d, "/launch caret:dummy --verbose")
        expect(cs_container_spec_is_container(plain.agents[0].spec)).to_equal(false)
