# MD-02 and MD-03: common sealer must reject incomplete or unauthorized composition.
use std.spec.{describe, it, expect}
use common.kernel_plugin.ids.KpfDigest256
use std.mdsocpp.*
use app.llm_caret.workbench.distributed_composition.*

fn control_policy() -> MdsocppSealPolicyV1:
    MdsocppSealPolicyV1(profile: MdsocppProfile.Userland, critical: true,
        granted_capability_bits: 31, memory_budget_bytes: 700,
        maximum_concurrent_calls: 4, generation: 1,
        composition_digest: KpfDigest256(w0: 1, w1: 2, w2: 3, w3: 4))

describe "distributed Caret closed composition":
    it "seals seven capsules using the existing common owner":
        val result = distributed_control_seal_v2(distributed_control_descriptors_v2(100, 1, 1, 4), control_policy())
        expect(result.status).to_equal(MdsocppSealStatus.Ok)
        expect(result.receipt.capsule_count).to_equal(7u32)
        expect(result.receipt.total_memory_bytes).to_equal(700u64)

    it "rejects removed host authority instead of binding an implicit provider":
        val all = distributed_control_descriptors_v2(100, 1, 1, 4)
        val result = distributed_control_seal_v2([all[1], all[2], all[3], all[4], all[5], all[6]], control_policy())
        expect(result.status).to_equal(MdsocppSealStatus.MissingFacet)

    it "rejects denied protected evidence capabilities":
        var policy = control_policy()
        policy.granted_capability_bits = 7
        val result = distributed_control_seal_v2(distributed_control_descriptors_v2(100, 1, 1, 4), policy)
        expect(result.status).to_equal(MdsocppSealStatus.CapabilityDenied)

    it "rejects aggregate memory beyond the declared reservation":
        var policy = control_policy()
        policy.memory_budget_bytes = 699
        val result = distributed_control_seal_v2(distributed_control_descriptors_v2(100, 1, 1, 4), policy)
        expect(result.status).to_equal(MdsocppSealStatus.MemoryBudgetExceeded)
