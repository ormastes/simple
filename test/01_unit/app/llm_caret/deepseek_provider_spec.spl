"""
## Purpose and audience
Purpose: Prove that `caret:deepseek` is a first-class provider — it is listed
and accepted, it carries DeepSeek's documented endpoint and model defaults,
those defaults can be overridden from config, and a request made without an
API key fails closed instead of silently returning empty text.
Audience: engineers wiring LLM caret providers.
"""
# @req: REQ-APP-LLM-CARET-001 — stable requirement identity for this spec.

# LLM Caret DeepSeek Provider Specification
# codex-system-test

use std.spec.*
use app.llm_caret.provider.{list_providers, is_valid_provider, dispatch_send}
use app.llm_caret.config.{
    reset_config, parse_config_text,
    config_deepseek_base_url, config_deepseek_model, config_deepseek_api_key
}

describe "deepseek provider registration":
    it "lists deepseek as a selectable provider":
        step("Ask the provider registry for every provider it can serve")
        val providers = list_providers()
        expect(providers).to_contain("deepseek")

    it "accepts deepseek as a valid provider name":
        step("Validate the provider name a caret:deepseek request would carry")
        assert_true(is_valid_provider("deepseek"))

describe "deepseek configuration defaults":
    it "defaults to the DeepSeek public endpoint":
        step("Reset configuration so no user config is in effect")
        reset_config()
        step("Read the DeepSeek base URL")
        expect(config_deepseek_base_url()).to_equal("https://api.deepseek.com")

    it "defaults to the deepseek-chat model":
        step("Reset configuration so no user config is in effect")
        reset_config()
        step("Read the DeepSeek model")
        expect(config_deepseek_model()).to_equal("deepseek-chat")

    it "has no API key until one is configured":
        step("Reset configuration and read the DeepSeek API key")
        reset_config()
        expect(config_deepseek_api_key()).to_equal("")

describe "deepseek configuration override":
    it "takes the base URL and model from a deepseek config section":
        step("Reset configuration to the shipped defaults")
        reset_config()
        step("Apply a config that points deepseek at a private gateway")
        parse_config_text(
            "deepseek:\n    base_url: https://gw.example.test/v1\n    model: deepseek-reasoner"
        )
        step("Verify both values changed")
        expect(config_deepseek_base_url()).to_equal("https://gw.example.test/v1")
        expect(config_deepseek_model()).to_equal("deepseek-reasoner")
        step("Restore the defaults for later examples")
        reset_config()
        expect(config_deepseek_model()).to_equal("deepseek-chat")

describe "deepseek dispatch without credentials":
    it "fails closed when no API key is supplied":
        step("Dispatch a deepseek request with an empty API key")
        val resp = dispatch_send(
            "deepseek", "hello", "deepseek-chat", "", "",
            "", "", "", 1, 16, "[]"
        )
        step("Verify the response is an error rather than empty content")
        assert_true(resp.is_error)
        expect(resp.provider).to_equal("deepseek")
        expect(resp.error).to_contain("deepseek")
