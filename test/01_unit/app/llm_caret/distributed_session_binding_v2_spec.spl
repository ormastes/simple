# DBC-017/020/021; AT-07–10/19. Metadata checks do not adopt a PID or a lease.
use std.spec.{describe, it, expect}
use app.llm_caret.workbench.session_contract.*

fn execution_binding() -> SessionExecutionBindingV2:
    SessionExecutionBindingV2(session: SessionId(value: "team/root.provider", generation: 3),
        host_id: "worker_1", host_boot_digest: "a".repeat(64), service_instance_digest: "b".repeat(64),
        request_id_high: 1, request_id_low: 2, ticket_high: 3, ticket_low: 4,
        pid: 123, process_started_ns: 999)

fn control_lease() -> SessionControlLeaseV2:
    SessionControlLeaseV2(binding: execution_binding(), kind: SessionControlLeaseKindV2.Input,
        holder_id: "user_1", client_id: "preview.main", nonce_digest: "c".repeat(64),
        revision: 5, expires_monotonic_ns: 2000)

fn input_lease_error(lease: SessionControlLeaseV2, revision: i64, now_ns: i64) -> text:
    session_control_lease_check_v2(lease, execution_binding(), SessionControlLeaseKindV2.Input,
        "user_1", "preview.main", "c".repeat(64), revision, now_ns)

describe "distributed session execution identity and distinct controls":
    it "accepts exact binding while preserving the existing opaque session ID":
        expect(session_execution_binding_validate_v2(execution_binding())).to_equal("")
        expect(session_execution_binding_match_v2(execution_binding(), execution_binding())).to_equal("")

    it "rejects a changed generation, boot or service under the same PID":
        var changed = execution_binding()
        changed.session = SessionId(value: "team/root.provider", generation: 4)
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_GENERATION_STALE")
        changed = execution_binding()
        changed.host_boot_digest = "d".repeat(64)
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_HOST_CHANGED")
        changed = execution_binding()
        changed.service_instance_digest = "d".repeat(64)
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_SERVICE_CHANGED")

    it "rejects reused process identity and missing ticket proof":
        var changed = execution_binding()
        changed.ticket_low = 5
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_PROCESS_CHANGED")
        changed = execution_binding()
        changed.process_started_ns = 1000
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_PROCESS_CHANGED")
        changed.ticket_low = 0
        expect(session_execution_binding_match_v2(execution_binding(), changed)).to_equal("SESSION_PROCESS_BINDING_INVALID")

    it "routes job cancellation to Build and gives each action a separate scope":
        expect(session_control_domain_v2(SessionControlActionV2.CancelJob)).to_equal("build")
        expect(session_control_domain_v2(SessionControlActionV2.CancelTurn)).to_equal("session")
        expect(session_control_scope_v2(SessionControlActionV2.DetachClient)).to_equal("session_detach")
        expect(session_control_scope_v2(SessionControlActionV2.CancelTurn)).to_equal("session_cancel_turn")
        expect(session_control_scope_v2(SessionControlActionV2.CancelJob)).to_equal("build_cancel")
        expect(session_control_scope_v2(SessionControlActionV2.TerminateSession)).to_equal("session_terminate")
        expect(session_control_scope_v2(SessionControlActionV2.DeleteHistory)).to_equal("session_history_delete")

    it "keeps input and geometry leases independent":
        expect(input_lease_error(control_lease(), 5, 1000)).to_equal("")
        expect(session_control_lease_check_v2(control_lease(), execution_binding(), SessionControlLeaseKindV2.Geometry,
            "user_1", "preview.main", "c".repeat(64), 5, 1000)).to_equal("SESSION_LEASE_KIND_DENIED")
        expect(session_control_lease_check_v2(control_lease(), execution_binding(), SessionControlLeaseKindV2.Input,
            "user_1", "another.client", "c".repeat(64), 5, 1000)).to_equal("SESSION_LEASE_HOLDER_DENIED")

    it "rejects stale revision, nonce and expired monotonic deadline":
        expect(input_lease_error(control_lease(), 6, 1000)).to_equal("SESSION_LEASE_STALE")
        var lease = control_lease()
        lease.nonce_digest = "d".repeat(64)
        expect(input_lease_error(lease, 5, 1000)).to_equal("SESSION_LEASE_STALE")
        expect(input_lease_error(control_lease(), 5, 2000)).to_equal("SESSION_LEASE_EXPIRED")

    it "detaches transport without cancelling a working turn or stopping a child":
        var view = new_session_view(SessionId(value: "session_1", generation: 3), "agent", "provider")
        view.lifecycle = ProcessLifecycle.Running
        view.turn = AgentTurn.Working
        view.transport = Transport.Ready
        val detached = session_detach_view_v2(view)
        expect(detached.transport).to_equal(Transport.Disconnected)
        expect(detached.lifecycle).to_equal(ProcessLifecycle.Running)
        expect(detached.turn).to_equal(AgentTurn.Working)
