"""Source contracts for command-scoped lint allocation and policy reuse."""
# @req: REQ-012

use std.spec.*
use std.fs.{read_file}

describe "lint command session reuse":
    it "constructs one linter outside the repository file loop":
        step("Prevent file-count multiplied lint registry construction")
        val source = read_file("src/app/io/cli_lint_commands.spl")
        expect(source).to_contain("var lint_session = Linter.new()")
        expect(source).to_contain("run_lint_file_with_linter(lint_session")
        expect(source).not.to_contain("run_lint_file(file_path, normalized_args)")

    it "keeps project policy reuse bounded to the command-owned linter":
        step("Reuse adjacent project policy without process-global stale state")
        val source = read_file(
            "src/compiler/90.tools/lint/_LintMain/entry_and_fixes.spl")
        expect(source).to_contain("linter.cached_sdn_path == sdn_path")
        expect(source).to_contain("linter.cached_sdn_config.unwrap().child()")
        expect(source).not.to_contain("var linter = Linter.new()\n\n    # Try to load config")
