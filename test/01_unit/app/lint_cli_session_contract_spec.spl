"""Source contracts for command-scoped lint allocation and policy reuse."""
# @req: REQ-012

use std.spec.*
use std.fs.{read_file}

describe "lint command session reuse":
    it "constructs one linter outside the repository file loop":
        step("Prevent file-count multiplied lint registry construction")
        val source = read_file("src/app/io/cli_lint_commands.spl")
        expect(source).to_contain("var lint_session = Linter.new()")
        expect(source).to_contain("run_lint_source_with_linter_policy(")
        expect(source).not.to_contain("run_lint_file(file_path, normalized_args)")

    it "parses command policy once outside the repository file loop":
        step("Prevent file-count multiplied scans of positional CLI arguments")
        val cli = read_file("src/app/io/cli_lint_commands.spl")
        val entry = read_file(
            "src/compiler/90.tools/lint/_LintMain/entry_and_fixes.spl")
        expect(cli).to_contain(
            "val lint_policy = LintCliPolicy.from_args(normalized_args)")
        expect(cli).to_contain(
            "lint_session, file_path, lint_policy, source")
        expect(entry).to_contain("policy.profile")
        expect(entry).not.to_contain("val deny_all = args.contains")
        expect(entry).not.to_contain("for arg in args:\n        if arg.starts_with(\"--profile=\")")

    it "shares one source payload with lint and optional SIMD analysis":
        step("Prevent a second source read for SIMD opportunity checks")
        val source = read_file("src/app/io/cli_lint_commands.spl")
        expect(source).to_contain("LintReadFileResult.ReadFileOk(loaded_source)")
        expect(source).to_contain("check_simd_opportunities(source, file_path)")
        expect(source).not.to_contain(
            "if run_simd:\n            val source = file_read(file_path)")

    it "keeps project policy reuse bounded to the command-owned linter":
        step("Reuse bounded project policy without process-global stale state")
        val source = read_file(
            "src/compiler/90.tools/lint/_LintMain/entry_and_fixes.spl")
        expect(source).to_contain("linter.parsed_sdn_index.contains_key(sdn_path)")
        expect(source).to_contain("linter.parsed_sdn_configs[config_index].child()")
        expect(source).to_contain("linter.parsed_sdn_count < 256")
        expect(source).not.to_contain("var linter = Linter.new()\n\n    # Try to load config")

    it "loads critical dynamic-acquire policy once per command-owned linter":
        step("Prevent one critical-mode file parse per linted source")
        val model = read_file(
            "src/compiler/90.tools/lint/_LintMain/config_and_model.spl")
        val checks = read_file(
            "src/compiler/90.tools/lint/_LintMain/lint_checks.spl")
        expect(model).to_contain("critical_dynamic_acquire_loaded: bool")
        expect(checks).to_contain("if not self.critical_dynamic_acquire_loaded:")
        expect(checks).to_contain("self.critical_dynamic_acquire_loaded = true")
        expect(checks).not.to_contain(
            "me check_dynamic_capability_acquire_spl(path: String, content: String):\n        val cfg = load_critical_mode_config")

    it "bounds and reuses project-manifest ancestor discovery":
        step("Prevent repeated ancestor filesystem probes per source")
        val model = read_file(
            "src/compiler/90.tools/lint/_LintMain/config_and_model.spl")
        val checks = read_file(
            "src/compiler/90.tools/lint/_LintMain/lint_checks.spl")
        expect(model).to_contain("manifest_dir_cache: Dict<String, String>")
        expect(model).to_contain("manifest_dir_cache_count < 4096")
        expect(model).to_contain("linter_find_project_sdn")
        expect(model).to_contain("manifest_dir_cache.contains_key(directory)")
        expect(checks).to_contain("resolve_prepared_lint_config_with_lines")

    it "shares immutable defaults for manifest-free source files":
        step("Prevent rebuilding every lint default for every manifest-free file")
        val model = read_file(
            "src/compiler/90.tools/lint/_LintMain/config_and_model.spl")
        val entry = read_file(
            "src/compiler/90.tools/lint/_LintMain/entry_and_fixes.spl")
        expect(model).to_contain("manifest_free_config: LintConfig")
        expect(entry).to_contain("linter.manifest_free_config.child()")
        expect(entry).not.to_contain(
            "if sdn_path == \"\":\n        linter.config = LintConfig.new()")
