use std.spec.{describe, it, expect}
use std.common.build_manager.contracts.{BuildInputV1, BuildResultV1, BuildRunV1, builder_validate_run_v1, builder_validate_result_v1, builder_task_identity_v1}
use std.common.build_manager.codec.{builder_encode_run_v1, builder_decode_run_v1}
use std.common.crypto.sha256.{sha256_text}
use test.fixtures.buildrunner.hello_native_run_v1.{HELLO_NATIVE_SOURCE_V1, hello_native_run_v1}

describe "BuildRunner Hello native task fixture":
    it "round trips a real compiler task with separate manager and compiler argv":
        val digest = sha256_text("identity")
        # Representative wire input only; native execution needs the complete
        # target-specific runtime inventory, not this synthetic identity.
        val runtime = BuildInputV1(path: "runtime/libsimple_runtime.a", digest: digest)
        val run = hello_native_run_v1("/compiler lane/simple", digest,
            "/runner lane/buildrunner", digest, "/work lane", [runtime], digest,
            "aarch64-apple-darwin", "llvm-lib", 8589934592)
        expect(builder_validate_run_v1(run)).to_equal("")
        val decoded = builder_decode_run_v1(builder_encode_run_v1(run)).unwrap()
        val task = decoded.tasks[0]
        expect(task.program).to_equal("/compiler lane/simple")
        expect(task.args[0]).to_equal("native-build")
        expect(task.args[1:3]).to_equal(["--mode", "one-binary"])
        expect(task.args.contains("--help")).to_equal(false)
        expect(task.args.contains("--manifest")).to_equal(false)
        expect(task.outputs).to_equal(["hello.exe"])
        expect(task.inputs[0].digest).to_equal(sha256_text(HELLO_NATIVE_SOURCE_V1))
        expect(task.inputs[1].path).to_equal(runtime.path)
        expect(decoded.hosts[0].worker_program).to_equal("/runner lane/buildrunner")
        expect(task.memory_policy).to_equal("enforce")
        expect(task.timeout_ms).to_equal(120000)

    it "invalidates the former implicit link-mode cache identity":
        val digest = sha256_text("identity")
        val runtime = BuildInputV1(path: "runtime/runtime.a", digest: digest)
        val run = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [runtime], digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        val old_key = sha256_text(digest + "|" + digest + "|aarch64-apple-darwin|llvm-lib|" +
            sha256_text(HELLO_NATIVE_SOURCE_V1) + "|runtime/runtime.a|" + digest)
        expect(run.tasks[0].cache_key == old_key).to_equal(false)

    it "rejects malformed hello task paths and retry overflow while retaining the source input":
        val digest = sha256_text("identity")
        val runtime = BuildInputV1(path: "runtime/libsimple_runtime.a", digest: digest)
        val valid = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [runtime], digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        expect(builder_validate_run_v1(valid)).to_equal("")

        var traversal = valid
        var traversal_task = traversal.tasks[0]
        traversal_task.outputs = ["../hello.exe"]
        traversal.tasks[0] = traversal_task
        expect(builder_validate_run_v1(traversal)).to_equal("invalid declared output")

        var no_output = valid
        var no_output_task = no_output.tasks[0]
        no_output_task.outputs = []
        no_output.tasks[0] = no_output_task
        expect(builder_validate_run_v1(no_output)).to_equal("task exceeds collection bounds or declares no outputs")

        var no_retry_budget = valid
        var retry_task = no_retry_budget.tasks[0]
        retry_task.attempt = 2
        no_retry_budget.tasks[0] = retry_task
        expect(builder_validate_run_v1(no_retry_budget)).to_equal("attempt exceeds run retry budget")

        # The manifest contract cannot infer compiler runtime requirements.
        # Confirm the fixture always declares its source even with no runtime.
        val source_only = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [], digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        expect(source_only.tasks[0].inputs.len()).to_equal(1)
        expect(source_only.tasks[0].inputs[0].path).to_equal("src/main.spl")

    it "admits only a matching success receipt and rejects stale hello output authority":
        val digest = sha256_text("identity")
        val runtime = BuildInputV1(path: "runtime/libsimple_runtime.a", digest: digest)
        val run = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [runtime], digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        val task = run.tasks[0]
        val valid = BuildRunV1(tasks: [task], hosts: run.hosts,
            keep_going: false, max_attempts: 1)
        expect(builder_validate_run_v1(valid)).to_equal("")

        var changed = task
        changed.attempt = 2
        val stale_identity = builder_task_identity_v1(task)
        val success_receipt = builder_validate_result_v1(task,
            BuildResultV1(task_id: task.id,
                attempt: 1, identity_digest: stale_identity, host_id: "local",
                status: "OK", exit_code: 0,
                outputs: [BuildInputV1(path: "hello.exe", digest: digest)],
                cache_hits: -1, cache_misses: -1, cache_stores: -1))
        expect(success_receipt).to_equal("")
        expect(builder_validate_result_v1(changed,
            BuildResultV1(task_id: task.id,
                attempt: 1, identity_digest: stale_identity, host_id: "local",
                status: "OK", exit_code: 0,
                outputs: [BuildInputV1(path: "hello.exe", digest: digest)],
                cache_hits: -1, cache_misses: -1, cache_stores: -1)))
            .to_equal("stale or mismatched result identity")

        expect(builder_validate_result_v1(task,
            BuildResultV1(task_id: task.id,
                attempt: task.attempt, identity_digest: builder_task_identity_v1(task),
                host_id: "local", status: "ERROR", exit_code: 1, outputs: [
                    BuildInputV1(path: "hello.exe", digest: digest)],
                cache_hits: -1, cache_misses: -1, cache_stores: -1)))
            .to_equal("failed result may not admit outputs or exit zero")

    it "changes cache and task identity when the admitted runtime changes":
        val digest = sha256_text("identity")
        val first = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [BuildInputV1(path: "runtime/runtime.a", digest: digest)],
            digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        val second = hello_native_run_v1("/compiler", digest, "/worker", digest,
            "/work", [BuildInputV1(path: "runtime/runtime.a", digest: sha256_text("changed"))],
            digest, "aarch64-apple-darwin", "llvm-lib", 8589934592)
        expect(first.tasks[0].cache_key == second.tasks[0].cache_key).to_equal(false)
        expect(builder_task_identity_v1(first.tasks[0]) == builder_task_identity_v1(second.tasks[0])).to_equal(false)
