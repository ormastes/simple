use std.spec
use common.ui.taskbar_model.{AppRef}
use app.ui.web.taskbar_runtime.{
    host_taskbar_runtime_clear_persisted_layout,
    host_taskbar_runtime_pin_app,
    host_taskbar_runtime_pinned_apps,
    host_taskbar_runtime_reset,
    host_taskbar_runtime_unpin_app,
}

fn contains_app(apps: [AppRef], app_id: text) -> bool:
    for app in apps:
        if app.app_id == app_id:
            return true
    false

describe "host taskbar app pin persistence":
    it "pins and unpins by stable app_id across runtime reset":
        host_taskbar_runtime_clear_persisted_layout()
        host_taskbar_runtime_reset()
        val app = AppRef(
            app_id: "org.simple.wm-demo",
            display_name: "WM Demo",
            icon: "demo"
        )
        expect(host_taskbar_runtime_pin_app(app).is_ok()).to_equal(true)
        expect(host_taskbar_runtime_pin_app(app).is_ok()).to_equal(true)
        host_taskbar_runtime_reset()
        expect(contains_app(
            host_taskbar_runtime_pinned_apps(), app.app_id
        )).to_equal(true)

        expect(host_taskbar_runtime_unpin_app(app.app_id).is_ok()).to_equal(true)
        host_taskbar_runtime_reset()
        expect(contains_app(
            host_taskbar_runtime_pinned_apps(), app.app_id
        )).to_equal(false)
        host_taskbar_runtime_clear_persisted_layout()
