doc/05_design/REQ-GEN-APP-001.md
"""
# @req: REQ-GEN-APP-001

# @tag: unit, app, riscv, hwir, qualification, receipt
# @manual_section Qualification receipt v2
# @req REQ-G2-004 REQ-G2-006 REQ-G2-009 REQ-G2-010 NFR-G2-001 NFR-G2-002 NFR-G2-006 NFR-G2-009 NFR-G2-010 NFR-G2-011

use std.spec.{describe, expect, it, step}
use app.test.riscv_gen2_qualification_receipt.{
    RISCV_GEN2_QUALIFICATION_SCHEMA,
    riscv_gen2_owned_file_manifest_matches,
    riscv_gen2_parse_qualification_manifest,
    riscv_gen2_render_qualification_receipt,
    riscv_gen2_qualification_product_manifest_matches}
use app.io.mod.{cwd, file_hash_sha256}
use std.common.crypto.sha256.{sha256_text}

val _HASH = "a" * 64

fn _owned_file_list_sha256() -> text:
    sha256_text(
        "src/compiler/50.mir/hwir/types.spl\n" +
        "src/compiler/70.backend/backend/hwir_to_vhdl.spl\n")

fn _row(index: i64, architecture: text) -> text:
    val prefix = "row_{index}_"
    val target = if architecture == "rv32": "rv32-zca-cjal-critical"
        else: "rv64-zca-addiw-critical"
    val profile = if architecture == "rv32":
        "riscv-gen2-rv32-zca-cjal-critical"
    else:
        "riscv-gen2-rv64-zca-addiw-critical"
    prefix + "architecture={architecture}\n" +
    prefix + "product_id=riscv-gen2-zca-trap-single-outstanding-v3\n" +
    prefix + "target={target}\n" + prefix + "profile={profile}\n" +
    prefix + "product_command_path=evidence/{architecture}.product.command\n" +
    prefix + "product_command_sha256={_HASH}\n" +
    prefix + "product_exit_code=0\n" +
    prefix + "manifest_path=evidence/{architecture}.manifest.json\n" +
    prefix + "manifest_sha256={_HASH}\n" +
    prefix + "vhdl_path=evidence/{architecture}.vhd\n" +
    prefix + "vhdl_sha256={_HASH}\n" +
    prefix + "testbench_path=evidence/{architecture}.tb.vhd\n" +
    prefix + "testbench_sha256={_HASH}\n" +
    prefix + "analyze_command_path=evidence/{architecture}.analyze.command\n" +
    prefix + "analyze_command_sha256={_HASH}\n" +
    prefix + "analyze_exit_code=0\n" +
    prefix + "analyze_log_path=evidence/{architecture}.analyze.log\n" +
    prefix + "analyze_log_sha256={_HASH}\n" +
    prefix + "elaborate_command_path=evidence/{architecture}.elaborate.command\n" +
    prefix + "elaborate_command_sha256={_HASH}\n" +
    prefix + "elaborate_exit_code=0\n" +
    prefix + "elaborate_log_path=evidence/{architecture}.elaborate.log\n" +
    prefix + "elaborate_log_sha256={_HASH}\n" +
    prefix + "run_command_path=evidence/{architecture}.run.command\n" +
    prefix + "run_command_sha256={_HASH}\n" +
    prefix + "run_exit_code=0\n" +
    prefix + "run_log_path=evidence/{architecture}.run.log\n" +
    prefix + "run_log_sha256={_HASH}\n" +
    prefix + "source_identity_sha256={_HASH}\n" +
    prefix + "config_identity_sha256={_HASH}\n" +
    prefix + "graph_identity_sha256={_HASH}\n"

fn _manifest() -> text:
    "schema={RISCV_GEN2_QUALIFICATION_SCHEMA}\n" +
    "status=passed\n" +
    "cli_path=build/stage4/simple\ncli_sha256={_HASH}\n" +
    "cli_provenance_path=build/stage4/simple.provenance.env\n" +
    "cli_provenance_sha256={_HASH}\nsource_revision={_HASH}\n" +
    "coverage_kind=branch\nbranch_coverage_threshold_basis_points=8000\n" +
    "branch_coverage_basis_points=8000\n" +
    "branch_coverage_command_path=evidence/branch_coverage.command\n" +
    "branch_coverage_command_sha256={_HASH}\n" +
    "branch_coverage_log_path=evidence/branch_coverage.log\n" +
    "branch_coverage_log_sha256={_HASH}\n" +
    "owned_file_list_sha256={_owned_file_list_sha256()}\n" +
    "owned_file_manifest_path=evidence/owned-files.list\n" +
    "owned_file_manifest_sha256={_HASH}\n" +
    "changed_file_count=2\n" +
    "changed_file_1=src/compiler/50.mir/hwir/types.spl\n" +
    "changed_file_2=src/compiler/70.backend/backend/hwir_to_vhdl.spl\n" +
    "exclusion_count=4\n" +
    "exclusion_1=generated VHDL artifacts\n" +
    "exclusion_2=generated VHDL testbench literals\n" +
    "exclusion_3=legacy V1 generators\n" +
    "exclusion_4=separate architectural retirement producer\n" +
    _row(1, "rv32") + _row(2, "rv64")

describe "RISC-V Gen2 qualification receipt contract":
    it "should accept the fixed RV32 and RV64 measured branch manifest":
        # @req: REQ-G2-004
        step("Verify: should accept the fixed RV32 and RV64 measured branch manifest")
        step("Parse the exact v2 two-row qualification manifest")
        val parsed = riscv_gen2_parse_qualification_manifest(_manifest())
        expect(parsed.is_ok()).to_be(true)
        val manifest = parsed.unwrap()
        expect(manifest.rows.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(manifest.rows[0].architecture).to_equal("rv32")
        expect(manifest.rows[1].architecture).to_equal("rv64")
        expect(manifest.rows[0].target).to_equal("rv32-zca-cjal-critical")
        expect(manifest.rows[1].profile).to_equal(
            "riscv-gen2-rv64-zca-addiw-critical")
        expect(manifest.branch_coverage_basis_points).to_equal(8000)  # oracle: 8000 — named expected value from the requirement
        expect(manifest.owned_file_list_sha256).to_equal(
            _owned_file_list_sha256())
        expect(manifest.owned_file_manifest_path).to_equal(
            "evidence/owned-files.list")
        expect(manifest.changed_files.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(manifest.exclusions.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "should reject missing rows, nonzero exits, and subcanonical branch coverage":
        # @req: REQ-G2-006
        step("Verify: should reject missing rows, nonzero exits, and subcanonical branch coverage")
        step("Reject incomplete rows, failed product commands, swapped targets, and low coverage")
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("row_2_architecture=rv64\n", "")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("row_1_product_exit_code=0",
                "row_1_product_exit_code=1")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("row_2_target=rv64-zca-addiw-critical",
                "row_2_target=rv32-zca-cjal-critical")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("branch_coverage_basis_points=8000",
                "branch_coverage_basis_points=7999")
        ).is_err()).to_be(true)

    it "should reject incomplete command, testbench, coverage, and list bindings":
        # @req: REQ-G2-009
        step("Verify: should reject incomplete command, testbench, coverage, and list bindings")
        step("Reject missing or duplicate command, testbench, coverage, and list bindings")
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("row_1_testbench_sha256={_HASH}\n", "")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("row_2_analyze_exit_code=0",
                "row_2_analyze_exit_code=1")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("branch_coverage_command_sha256={_HASH}",
                "branch_coverage_command_sha256=bad")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("changed_file_count=2", "changed_file_count=0")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace("exclusion_2=generated VHDL testbench literals",
                "exclusion_2=generated VHDL artifacts")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest() + "row_1_run_exit_code=0\n"
        ).is_err()).to_be(true)

    it "should reject missing, malformed, duplicate, or mismatched owned file list identity":
        # @req: REQ-G2-010
        step("Verify: should reject missing, malformed, duplicate, or mismatched owned file list identity")
        step("Bind the exact newline-terminated owned file list into one v2 digest")
        val owned_line = "owned_file_list_sha256={_owned_file_list_sha256()}\n"
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace(owned_line, "")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace(_owned_file_list_sha256(), "bad")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest() + owned_line
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace(_owned_file_list_sha256(), "b" * 64)
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace(
                "owned_file_manifest_path=evidence/owned-files.list\n", "")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest().replace(
                "owned_file_manifest_sha256={_HASH}",
                "owned_file_manifest_sha256=bad")
        ).is_err()).to_be(true)
        expect(riscv_gen2_parse_qualification_manifest(
            _manifest() +
                "owned_file_manifest_path=evidence/owned-files.list\n"
        ).is_err()).to_be(true)
    it "should bind canonical owned hash rows to ordered changed files and current source":
        # @req: REQ-GEN-APP-001
        step("Verify: should bind canonical owned hash rows to ordered changed files and current source")
        step("Require 64hex two-space path rows with current file hashes")
        val paths = [
            "src/app/test/riscv_gen2_qualification_receipt.spl",
            "test/01_unit/app/riscv_gen2_qualification_receipt_spec.spl"]
        val rows = file_hash_sha256(paths[0]) + "  " + paths[0] + "\n" +
            file_hash_sha256(paths[1]) + "  " + paths[1] + "\n"
        expect(riscv_gen2_owned_file_manifest_matches(rows, paths)).to_be(true)
        expect(riscv_gen2_owned_file_manifest_matches(
            rows.replace(file_hash_sha256(paths[0]), "b" * 64), paths
        )).to_be(false)
        expect(riscv_gen2_owned_file_manifest_matches(
            rows.replace("  " + paths[0], " " + paths[0]), paths
        )).to_be(false)
        expect(riscv_gen2_owned_file_manifest_matches(
            rows, [paths[1], paths[0]])).to_be(false)

    it "should render only bound command and retained evidence identities":
        # @req: REQ-G2-004
        step("Verify: should render only bound command and retained evidence identities")
        step("Render the nested receipt from validated v2 identities")
        val manifest = riscv_gen2_parse_qualification_manifest(_manifest()).unwrap()
        val rendered = riscv_gen2_render_qualification_receipt(
            manifest, "qualified-run-001", _HASH)
        expect(rendered).to_contain("\"schema\":\"" +
            RISCV_GEN2_QUALIFICATION_SCHEMA + "\"")
        expect(rendered).to_contain("\"threshold_basis_points\":8000")
        expect(rendered).to_contain("\"architecture\":\"rv32\"")
        expect(rendered).to_contain("\"architecture\":\"rv64\"")
        expect(rendered).to_contain(
            "\"product_id\":\"riscv-gen2-zca-trap-single-outstanding-v3\"")
        expect(rendered).to_contain(
            "\"retained_path\":\"rv32.manifest.json\"")
        expect(rendered).to_contain("\"product_exit_code\":0")
        expect(rendered).to_contain("\"retained_path\":\"rv32.tb.vhd\"")
        expect(rendered).to_contain("\"retained_path\":\"rv64.run.command\"")
        expect(rendered).to_contain("\"changed_files\":[")
        expect(rendered).to_contain(
            "\"owned_file_list_sha256\":\"{_owned_file_list_sha256()}\"")
        expect(rendered).to_contain(
            "\"retained_path\":\"owned-files.list\"")
        expect(rendered).to_contain("\"exclusions\":[")

    it "should reject duplicate or mismatched product-manifest authority":
        # @req: REQ-G2-006
        step("Verify: should reject duplicate or mismatched product-manifest authority")
        step("Bind the producer JSON structurally and reject duplicate authority keys")
        val row = riscv_gen2_parse_qualification_manifest(_manifest()).unwrap().rows[0]
        val product_manifest = "{" +
            "\"entry_entity\":\"riscv_gen2_zca_rv32_cjal_trap_single_outstanding_frontend\"," +
            "\"source_closure_sha256\":\"{_HASH}\"," +
            "\"vhdl\":{\"path\":\"{cwd()}/evidence/rv32.vhd\",\"sha256\":\"{_HASH}\"}," +
            "\"generation_route\":\"hwir-gen2-trap-stateful-product-v3\"," +
            "\"hwir\":{\"config_profile\":\"riscv-gen2-rv32-zca-cjal-critical\",\"graph_sha256\":\"{_HASH}\"}," +
            "\"assurance_policy\":{\"strictness\":\"critical\"}," +
            "\"target\":{\"name\":\"riscv32\",\"xlen\":32,\"profile\":\"riscv-gen2-rv32-zca-cjal-critical\"}}"
        expect(riscv_gen2_qualification_product_manifest_matches(
            product_manifest, row)).to_be(true)
        expect(riscv_gen2_qualification_product_manifest_matches(
            "{\"entry_entity\":\"shadow\"," + product_manifest[1:],
            row)).to_be(false)
        expect(riscv_gen2_qualification_product_manifest_matches(
            product_manifest.replace("\"graph_sha256\":\"{_HASH}\"",
                "\"graph_sha256\":\"" + ("b" * 64) + "\""), row)).to_be(false)
