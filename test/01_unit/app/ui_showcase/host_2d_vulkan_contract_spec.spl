# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





# @cover src/app/ui_showcase/hosts/host_2d_vulkan.spl 90%
"""
# Vulkan-only 2D showcase host contract

This is intentionally a source contract rather than a device test.  CI does
not always expose a Vulkan device, but the optional showcase entry must still
fail closed: it may not turn an unavailable GPU, a CPU fallback, a partial
DrawIR lowering, or an unproven font render into a successful capture.

**Requirements:** GPU DrawIR showcase capture provenance
"""

use std.spec.step

use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn vulkan_host_source() -> text:
    rt_file_read_text("src/app/ui_showcase/hosts/host_2d_vulkan.spl") ?? ""

fn vulkan_entry_source() -> text:
    rt_file_read_text("src/app/ui_showcase/hosts/main_2d_vulkan.spl") ?? ""

# @manual_section Vulkan 2D showcase host fail-closed contract
describe "Vulkan 2D showcase host fail-closed contract":
    # @manual scenario evidence

    it "opens only an explicitly selected Vulkan Engine2D backend":
        # @req REQ-SSPEC-APP
        step("opens only an explicitly selected Vulkan Engine2D backend")
        step("Read the Vulkan-only adapter source")
        val source = vulkan_host_source()

        assert_true(source.contains("Engine2D.create_with_backend_fast(w, h, \"vulkan\")"))
        assert_true(source.contains("if engine.backend_name() != \"vulkan\":"))
        assert_true(source.contains("engine.shutdown()"))

    it "requires GPU DrawIR and rejects CPU fallback, incomplete lowering, and weak readback provenance":
        # @req REQ-SSPEC-APP
        step("requires GPU DrawIR and rejects CPU fallback, incomplete lowering, and weak readback provenance")
        step("Inspect the complete fresh-device receipt predicate")
        val source = vulkan_host_source()

        assert_true(source.contains("composition.backend_target != DRAW_IR_BACKEND_GPU"))
        assert_true(source.contains("engine2d_draw_ir_adv_strict_vulkan_primitives_with_images"))
        assert_true(source.contains("result.selected_backend != \"gpu\""))
        assert_true(source.contains("result.fallback_required"))
        assert_true(source.contains("result.fallback_reason != \"\""))
        assert_true(source.contains("result.skipped_command_count != 0"))
        assert_true(source.contains("result.rendered_command_count <= 0"))
        assert_true(source.contains("result.readback_source != \"device_readback\""))
        assert_true(source.contains("result.backend_handle <= 0"))
        assert_true(source.contains("result.device_identity <= 0"))
        assert_true(source.contains("result.readback_checksum <= 0"))
        assert_true(source.contains("result.pixels.len() != expected_pixels"))
        assert_true(source.contains("fresh-device-drawir-receipt-rejected"))

    it "requires a shared Vulkan font receipt with exact checksum and atlas evidence":
        # @req REQ-SSPEC-APP
        step("requires a shared Vulkan font receipt with exact checksum and atlas evidence")
        step("Inspect the font-specific rejection predicate")
        val source = vulkan_host_source()

        assert_true(source.contains("result.font_execution_target != \"vulkan\""))
        assert_true(source.contains("result.font_identity == \"\""))
        assert_true(source.contains("result.font_batch_identity == \"\""))
        assert_true(source.contains("result.font_readback_source != \"device_readback\""))
        assert_true(source.contains("result.font_device_checksum != result.font_oracle_checksum"))
        assert_true(source.contains("result.font_readback_nonblank_pixels <= 0"))
        assert_true(source.contains("not result.font_parity"))
        assert_true(source.contains("not result.font_device_executed"))
        assert_true(source.contains("not result.font_promotion_ready"))
        assert_true(source.contains("result.font_atlas_upload_count <= 0"))
        assert_true(source.contains("result.font_atlas_upload_bytes <= 0"))
        assert_true(source.contains("_lower_hex_sha256_valid(result.font_atlas_payload_sha256)"))
        assert_true(source.contains("fresh-device-font-receipt-rejected"))
        assert_true(source.contains("font_device_checksum={result.font_device_checksum}"))
        assert_true(source.contains("font_oracle_checksum={result.font_oracle_checksum}"))
        assert_true(source.contains("font_atlas_sha256={result.font_atlas_payload_sha256}"))
        assert_true(source.contains("font_parity={result.font_parity}"))

    it "receipts exact Shapes, EDGE, and dialog anchors submitted to Vulkan":
        # @req REQ-SSPEC-APP
        step("Inspect native Vulkan showcase feature anchors")
        val source = vulkan_host_source()
        assert_true(source.contains("DRAW_IR_COMMAND_PATH"))
        assert_true(source.contains("DRAW_IR_COMMAND_EDGE"))
        assert_true(source.contains("path_commands={path_commands}"))
        assert_true(source.contains("edge_commands={edge_commands}"))
        assert_true(source.contains("dialog_titles={dialog_titles}"))

    it "uses the explicit no-submit no-readback path for unchanged frames":
        # @req REQ-SSPEC-PERF
        step("Inspect retained Vulkan showcase frame handling")
        val source = vulkan_host_source()
        assert_true(source.contains("engine2d_draw_ir_retained_idle(self.engine, false)"))
        assert_true(source.contains("retained-idle-before-fresh-device-frame"))
        assert_true(source.contains("outcome.readback.source != \"not_requested\""))
        assert_true(source.contains("fresh_frames={self.fresh_frames}"))
        assert_true(source.contains("retained_idle_frames={self.retained_idle_frames}"))
        assert_true(source.contains("idle_readback_bytes=0"))
        assert_true(source.contains("last_frame_mode: text"))
        assert_true(source.contains("self.last_frame_mode = \"fresh-device\""))
        assert_true(source.contains("self.last_frame_mode = \"retained-idle\""))
        assert_true(source.contains("capture_source=last-fresh-device-readback"))
        assert_true(source.contains("var content_dirty = true"))

    it "does not accept lossy V3 presentation or claim a capture before a device result":
        # @req REQ-SSPEC-APP
        step("does not accept lossy V3 presentation or claim a capture before a device result")
        step("Ensure composition presentation is the only successful render path")
        val source = vulkan_host_source()

        assert_true(source.contains("vulkan-host-requires-original-composition"))
        assert_true(source.contains("me present_scene(_scene: DrawIrV3Scene) -> bool:"))
        assert_true(source.contains("me present_composition(composition: DrawIrComposition) -> bool:"))
        assert_true(source.contains("self._accept_fresh_device_result(composition)"))
        assert_true(source.contains("self.last_pixels = result.pixels"))
        assert_true(source.contains("self.last_receipt ="))
        assert_true(source.contains("vulkan-resize-rejected"))
        assert_true(source.contains("self.engine = replacement"))

# @manual_section Vulkan 2D showcase entry fail-closed contract
describe "Vulkan 2D showcase entry fail-closed contract":

    it "reports unavailable Vulkan as blocked and keeps GPU DrawIR explicit":
        # @req REQ-SSPEC-APP
        step("reports unavailable Vulkan as blocked and keeps GPU DrawIR explicit")
        step("Read the explicit Vulkan entry source")
        val source = vulkan_entry_source()
        assert_true(source.contains("val (final_w, final_h) = host.size()"))
        assert_true(source.contains("raster_to_ppm_bytes(pixels, final_w, final_h)"))

        assert_true(source.contains("DRAW_IR_BACKEND_GPU"))
        assert_true(source.contains("Screen2dVulkanHost.open(w, h, script)"))
        assert_true(source.contains("showcase status=blocked renderer=vulkan reason=vulkan-device-unavailable"))
        assert_true(source.contains("showcase_run_with_backend("))
        assert_true(source.contains("DRAW_IR_BACKEND_GPU"))

    it "writes captures only from returned device pixels and emits the receipt":
        # @req REQ-SSPEC-APP
        step("writes captures only from returned device pixels and emits the receipt")
        step("Inspect capture data flow and failure handling")
        val source = vulkan_entry_source()

        assert_true(source.contains("report.frames != frames"))
        assert_true(source.contains("pixels.len() != final_w.to_i64() * final_h.to_i64()"))
        assert_true(source.contains("receipt == \"\""))
        assert_true(source.contains("reason = \"incomplete-device-frame-sequence\""))
        assert_true(source.contains("reason={reason}"))
        assert_true(source.contains("val pixels = host.pixels()"))
        assert_true(source.contains("file_write_bytes(capture, raster_to_ppm_bytes(pixels, final_w, final_h))"))
        assert_true(source.contains("reason=capture-write"))
        assert_true(source.contains("{receipt}"))
