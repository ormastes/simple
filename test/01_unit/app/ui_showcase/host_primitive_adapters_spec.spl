"""
## Purpose and audience
Purpose: Prove that 2d host public primitive adapter.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-UI-SHOWCASE-001 — stable requirement identity for this spec.
# @cover src/app/ui_showcase/hosts/host_2d.spl 85%
# @cover src/app/ui_showcase/hosts/host_gui.spl 85%
# @tag: unit, ui, host, primitive, headless
"""
Focused unit coverage for the two host adapters that can be exercised without
starting a browser, window manager, or GPU.  These tests intentionally stop at
the public adapter boundary: semantic reducer and live QEMU evidence belong to
their own specs.

The GUI event record currently has no modifier field.  The key tests therefore
pin its direction/code contract and do not invent Ctrl/Alt state.  Modifier
bit preservation is covered by the canonical HostInputEvent ingress specs.
"""

use std.spec.*
use common.ui.host_input_event.{
    HostInputEvent, HOST_BTN_LEFT, HOST_BTN_RIGHT, HOST_BTN_MIDDLE,
    HOST_BTN_NONE,
    host_key_down, host_key_up
}
use app.ui_showcase.hosts.host_2d.{Screen2dHost, screen_2d_parse_script}
use app.ui_showcase.hosts.host_gui.{gui_event_to_host, gui_button_to_host}
use nogc_sync_mut.ui.gui_renderer.{
    GuiEvent, GUI_EVT_KEYBOARD, GUI_EVT_MOUSE_BUTTON,
    GUI_EVT_MOUSE_MOVED, GUI_EVT_MOUSE_WHEEL, GUI_EVT_RESIZED,
    GUI_EVT_NONE, GUI_EVT_CLOSE
}

fn _gui(kind: i64, code: i64, button: i64, pressed: bool, x: f64, y: f64) -> GuiEvent:
    GuiEvent(
        native_id: 0, kind: kind, scancode: 0, keycode: code,
        btn: button, pressed: pressed, x: x, y: y
    )

fn _tag(ev: HostInputEvent) -> text:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel): "pointer"
        HostInputEvent.Key(code, ch, down, mods): "key"
        HostInputEvent.Resize(w, h): "resize"

fn _pointer(ev: HostInputEvent) -> (i32, i32, i64, bool, i32):
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            (x, y, button, pressed, wheel)
        _: (0, 0, HOST_BTN_NONE, false, 0)

fn _key(ev: HostInputEvent) -> (i64, text, bool, i64):
    match ev:
        HostInputEvent.Key(code, ch, down, mods): (code, ch, down, mods)
        _: (0, "", false, 0)

fn _resize(ev: HostInputEvent) -> (i32, i32):
    match ev:
        HostInputEvent.Resize(w, h): (w, h)
        _: (0, 0)

describe "2d host public primitive adapter":

    it "should expand click into an exact left down/up pair":
        # @req: REQ-APP-UI-SHOWCASE-001
        step("Parse one click at integral coordinates")
        val events = screen_2d_parse_script("click 17,23")
        expect(events.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val (x0, y0, b0, p0, w0) = _pointer(events[0])
        val (x1, y1, b1, p1, w1) = _pointer(events[1])
        expect(x0).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(y0).to_equal(23)  # oracle: 23 — named expected value from the requirement
        expect(b0).to_equal(HOST_BTN_LEFT)
        expect(p0).to_equal(true)
        expect(w0).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(x1).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(y1).to_equal(23)  # oracle: 23 — named expected value from the requirement
        expect(b1).to_equal(HOST_BTN_LEFT)
        expect(p1).to_be(false)
        expect(w1).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "should preserve a drag sequence and scroll direction":
        step("Parse down, move, up, and positive wheel steps")
        val events = screen_2d_parse_script("down 2,3;move 8,9;up 8,9;wheel 8,9,4")
        expect(events.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        val (dx, dy, db, dp, dw) = _pointer(events[0])
        val (mx, my, mb, mp, mw) = _pointer(events[1])
        val (ux, uy, ub, up, uw) = _pointer(events[2])
        val (wx, wy, wb, wp, ww) = _pointer(events[3])
        expect(dx).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(dy).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(db).to_equal(HOST_BTN_LEFT)
        expect(dp).to_equal(true)
        expect(mx).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(my).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(mb).to_equal(HOST_BTN_NONE)
        expect(mp).to_equal(true)
        expect(mw).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(ux).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(uy).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(ub).to_equal(HOST_BTN_LEFT)
        expect(up).to_be(false)
        expect(wx).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(wy).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(wb).to_equal(HOST_BTN_NONE)
        expect(wp).to_be(false)
        expect(ww).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "should emit a resize event and drain the finite queue":
        step("Parse resize and drain a host queue")
        val events = screen_2d_parse_script("resize 800,600")
        expect(events.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_tag(events[0])).to_equal("resize")
        val (rw, rh) = _resize(events[0])
        expect(rw).to_equal(800)  # oracle: 800 — named expected value from the requirement
        expect(rh).to_equal(600)  # oracle: 600 — named expected value from the requirement
        val host = Screen2dHost.open(32, 24, "resize 800,600")
        expect(host.poll_input() == nil).to_be(false)
        expect(host.poll_input() == nil).to_equal(true)

    it "should drop unknown or incomplete verbs without fabricating events":
        step("Parse unknown, empty, and incomplete wheel steps")
        val events = screen_2d_parse_script(";unknown 1,2;wheel 1,2; ;")
        expect(events.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "canonical modifier key constructors":

    it "should carry Ctrl and Alt on both key edges for host dispatch":
        step("Construct matching Ctrl+Alt down and up events")
        val mods = 2 + 4
        val (down_code, down_ch, down_pressed, down_mods) = _key(host_key_down(65, "A", mods))
        val (up_code, up_ch, up_pressed, up_mods) = _key(host_key_up(65, "A", mods))
        expect(down_code).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(down_ch).to_equal("A")
        expect(down_pressed).to_equal(true)
        expect(down_mods).to_equal(mods)
        expect(up_code).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(up_ch).to_equal("A")
        expect(up_pressed).to_be(false)
        expect(up_mods).to_equal(mods)
