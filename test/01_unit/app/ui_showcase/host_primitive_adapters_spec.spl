# @cover src/app/ui_showcase/hosts/host_2d.spl 85%
# @cover src/app/ui_showcase/hosts/host_gui.spl 85%
# @tag: unit, ui, host, primitive, headless
"""
Focused unit coverage for the two host adapters that can be exercised without
starting a browser, window manager, or GPU.  These tests intentionally stop at
the public adapter boundary: semantic reducer and live QEMU evidence belong to
their own specs.

The GUI event record currently has no modifier field.  The key tests therefore
pin its direction/code contract and do not invent Ctrl/Alt state.  Modifier
bit preservation is covered by the canonical HostInputEvent ingress specs.
"""

use std.spec.*
use common.ui.host_input_event.{
    HostInputEvent, HOST_BTN_LEFT, HOST_BTN_RIGHT, HOST_BTN_MIDDLE,
    HOST_BTN_NONE,
    host_key_down, host_key_up
}
use app.ui_showcase.hosts.host_2d.{Screen2dHost, screen_2d_parse_script}
use app.ui_showcase.hosts.host_gui.{gui_event_to_host, gui_button_to_host}
use nogc_sync_mut.ui.gui_renderer.{
    GuiEvent, GUI_EVT_KEYBOARD, GUI_EVT_MOUSE_BUTTON,
    GUI_EVT_MOUSE_MOVED, GUI_EVT_MOUSE_WHEEL, GUI_EVT_RESIZED,
    GUI_EVT_NONE, GUI_EVT_CLOSE
}

fn _gui(kind: i64, code: i64, button: i64, pressed: bool, x: f64, y: f64) -> GuiEvent:
    GuiEvent(
        native_id: 0, kind: kind, scancode: 0, keycode: code,
        btn: button, pressed: pressed, x: x, y: y
    )

fn _tag(ev: HostInputEvent) -> text:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel): "pointer"
        HostInputEvent.Key(code, ch, down, mods): "key"
        HostInputEvent.Resize(w, h): "resize"

fn _pointer(ev: HostInputEvent) -> (i32, i32, i64, bool, i32):
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            (x, y, button, pressed, wheel)
        _: (0, 0, HOST_BTN_NONE, false, 0)

fn _key(ev: HostInputEvent) -> (i64, text, bool, i64):
    match ev:
        HostInputEvent.Key(code, ch, down, mods): (code, ch, down, mods)
        _: (0, "", false, 0)

fn _resize(ev: HostInputEvent) -> (i32, i32):
    match ev:
        HostInputEvent.Resize(w, h): (w, h)
        _: (0, 0)

describe "2d host public primitive adapter":

    it "should expand click into an exact left down/up pair":
        step("Parse one click at integral coordinates")
        val events = screen_2d_parse_script("click 17,23")
        expect(events.len()).to_equal(2)
        val (x0, y0, b0, p0, w0) = _pointer(events[0])
        val (x1, y1, b1, p1, w1) = _pointer(events[1])
        expect((x0, y0, b0, p0, w0)).to_equal((17, 23, HOST_BTN_LEFT, true, 0))
        expect((x1, y1, b1, p1, w1)).to_equal((17, 23, HOST_BTN_LEFT, false, 0))

    it "should preserve a drag sequence and scroll direction":
        step("Parse down, move, up, and positive wheel steps")
        val events = screen_2d_parse_script("down 2,3;move 8,9;up 8,9;wheel 8,9,4")
        expect(events.len()).to_equal(4)
        val (dx, dy, db, dp, dw) = _pointer(events[0])
        val (mx, my, mb, mp, mw) = _pointer(events[1])
        val (ux, uy, ub, up, uw) = _pointer(events[2])
        val (wx, wy, wb, wp, ww) = _pointer(events[3])
        expect((dx, dy, db, dp)).to_equal((2, 3, HOST_BTN_LEFT, true))
        expect((mx, my, mb, mp, mw)).to_equal((8, 9, HOST_BTN_NONE, true, 0))
        expect((ux, uy, ub, up)).to_equal((8, 9, HOST_BTN_LEFT, false))
        expect((wx, wy, wb, wp, ww)).to_equal((8, 9, HOST_BTN_NONE, false, 4))

    it "should emit a resize event and drain the finite queue":
        step("Parse resize and drain a host queue")
        val events = screen_2d_parse_script("resize 800,600")
        expect(events.len()).to_equal(1)
        expect(_tag(events[0])).to_equal("resize")
        expect(_resize(events[0])).to_equal([800, 600])
        val host = Screen2dHost.open(32, 24, "resize 800,600")
        expect(host.poll_input() != nil).to_equal(true)
        expect(host.poll_input() == nil).to_equal(true)

    it "should drop unknown or incomplete verbs without fabricating events":
        step("Parse unknown, empty, and incomplete wheel steps")
        val events = screen_2d_parse_script(";unknown 1,2;wheel 1,2; ;")
        expect(events.len()).to_equal(0)

describe "gui host public primitive adapter":

    it "should map button edges and reject unknown button codes":
        step("Map left, right, middle, and an unknown code")
        expect(gui_button_to_host(0)).to_equal(HOST_BTN_LEFT)
        expect(gui_button_to_host(1)).to_equal(HOST_BTN_RIGHT)
        expect(gui_button_to_host(2)).to_equal(HOST_BTN_MIDDLE)
        expect(gui_button_to_host(99)).to_equal(HOST_BTN_NONE)

    it "should preserve pointer drag coordinates after truncation":
        step("Translate press, move, and release at fractional coordinates")
        val down = gui_event_to_host(_gui(GUI_EVT_MOUSE_BUTTON, 0, 0, true, 4.9, 5.8))!
        val move = gui_event_to_host(_gui(GUI_EVT_MOUSE_MOVED, 0, 0, false, 12.9, 15.8))!
        val up = gui_event_to_host(_gui(GUI_EVT_MOUSE_BUTTON, 0, 0, false, 12.9, 15.8))!
        expect(_pointer(down)).to_equal((4, 5, HOST_BTN_LEFT, true, 0))
        expect(_pointer(move)).to_equal((12, 15, HOST_BTN_NONE, true, 0))
        expect(_pointer(up)).to_equal((12, 15, HOST_BTN_LEFT, false, 0))

    it "should preserve key down and key up direction while not fabricating modifiers":
        step("Translate a keyboard press and release")
        val down = gui_event_to_host(_gui(GUI_EVT_KEYBOARD, 17, 0, true, 0.0, 0.0))!
        val up = gui_event_to_host(_gui(GUI_EVT_KEYBOARD, 17, 0, false, 0.0, 0.0))!
        expect(_key(down)).to_equal((17, "", true, 0))
        expect(_key(up)).to_equal((17, "", false, 0))

    it "should translate vertical wheel and resize while dropping lifecycle events":
        step("Translate wheel, resize, idle, and close")
        val wheel = gui_event_to_host(_gui(GUI_EVT_MOUSE_WHEEL, 0, 0, false, 2.0, -3.0))!
        val resize = gui_event_to_host(_gui(GUI_EVT_RESIZED, 0, 0, false, 640.0, 480.0))!
        val idle = gui_event_to_host(_gui(GUI_EVT_NONE, 0, 0, false, 0.0, 0.0))
        val close = gui_event_to_host(_gui(GUI_EVT_CLOSE, 0, 0, false, 0.0, 0.0))
        expect(_pointer(wheel)).to_equal((0, 0, HOST_BTN_NONE, false, -3))
        expect(_resize(resize)).to_equal((640, 480))
        expect(idle == nil).to_equal(true)
        expect(close == nil).to_equal(true)

describe "canonical modifier key constructors":

    it "should carry Ctrl and Alt on both key edges for host dispatch":
        step("Construct matching Ctrl+Alt down and up events")
        val mods = 2 + 4
        expect(_key(host_key_down(65, "A", mods))).to_equal((65, "A", true, mods))
        expect(_key(host_key_up(65, "A", mods))).to_equal((65, "A", false, mods))
