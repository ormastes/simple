# @cover src/app/ui_showcase/hosts/host_wm.spl 5%
# @tag: unit, ui, showcase, wm, perf
#
# T4 (render_perf_replan_parallel_teams_2026-08-07): the wm host must not
# write PPM bytes + seq + receipt on every warm frame. The file-bridge
# export is gated behind SIMPLE_WM_FRAME_EXPORT=1 (default OFF), counted by
# the host.ppm_file_writes field so a warm frame is provably zero file writes.

use std.spec
use std.io_runtime.{env_set, file_exists, file_size, file_read, remove_file_if_exists}
use common.ui.draw_ir_v3.{draw_ir_v3_empty_scene}
use app.ui_showcase.hosts.host_wm.{
    ScreenWmHost, WM_FRAME_EXPORT_ENV,
    wm_host_frame_export_enabled
}

val FRAME_PATH: text = "/tmp/host_wm_present_no_ppm_spec.frame.ppm"
val SEQ_PATH: text = "/tmp/host_wm_present_no_ppm_spec.frame.seq"
val EVENT_PATH: text = "/tmp/host_wm_present_no_ppm_spec.event"

fn _host() -> ScreenWmHost:
    ScreenWmHost(
        w: 8, h: 8,
        frame_path: FRAME_PATH, seq_path: SEQ_PATH, event_path: EVENT_PATH,
        frame_seq: 0, event_seq: 0, last_pixel_count: 0, last_checksum: 0,
        ppm_file_writes: 0
    )

fn _clean():
    remove_file_if_exists(FRAME_PATH)
    remove_file_if_exists(SEQ_PATH)

describe "wm host warm-path present (T4)":

    it "warm frame performs zero file writes when the export flag is off":
        env_set(WM_FRAME_EXPORT_ENV, "")
        expect(wm_host_frame_export_enabled()).to_equal(false)
        _clean()
        var host = _host()
        val w0 = host.ppm_file_writes
        expect(host.present_scene(draw_ir_v3_empty_scene(1u32, 1u32))).to_equal(true)
        expect(host.present_scene(draw_ir_v3_empty_scene(1u32, 2u32))).to_equal(true)
        expect(host.ppm_file_writes - w0).to_equal(0)
        expect(file_exists(FRAME_PATH)).to_equal(false)
        expect(file_exists(SEQ_PATH)).to_equal(false)
        # No fabricated transcript: seq must not advance without a frame file.
        expect(host.frame_seq).to_equal(0)

    it "export mode writes exactly one nonempty PPM frame plus seq and receipt":
        env_set(WM_FRAME_EXPORT_ENV, "1")
        expect(wm_host_frame_export_enabled()).to_equal(true)
        _clean()
        var host = _host()
        val w0 = host.ppm_file_writes
        expect(host.present_scene(draw_ir_v3_empty_scene(1u32, 3u32))).to_equal(true)
        # frame + seq + receipt = 3 counted writes for ONE presented frame.
        expect(host.ppm_file_writes - w0).to_equal(3)
        expect(host.frame_seq).to_equal(1)
        expect(host.last_pixel_count).to_equal(64)
        expect(file_exists(FRAME_PATH)).to_equal(true)
        # Non-empty P6 payload: header is at least "P6\n8 8\n255\n" + 192 bytes.
        expect(file_size(FRAME_PATH) > 64).to_equal(true)
        expect(file_read(SEQ_PATH)).to_equal("1")
        env_set(WM_FRAME_EXPORT_ENV, "")
