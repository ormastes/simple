use std.spec
use std.spec.step
use app.ui_showcase.hosts.scene_raster.{RasterSurface, raster_scene_into, raster_scene_with_receipt}
use common.ui.draw_ir_v3.{
    DrawIrV3Scene, draw_ir_v3_empty_scene, draw_ir_v3_command,
    draw_ir_v3_geometry_append, draw_ir_v3_geometry_next_id,
    draw_ir_v3_paint_append, draw_ir_v3_paint_next_id,
    draw_ir_v3_transform_append, draw_ir_v3_transform_next_id,
    draw_ir_v3_clip_append, draw_ir_v3_clip_next_id,
    DRAW_IR_V3_KIND_RECT, DRAW_IR_V3_KIND_GROUP, DRAW_IR_V3_KIND_IMAGE,
    DRAW_IR_V3_KIND_PORT, DRAW_IR_V3_FLAG_NONE, DRAW_IR_V3_NO_ID
}

"""
## Purpose and audience

v3 CPU scalar rasterizer: nested GROUP offsets/clips must compose
(parent + own), and unsupported kinds (IMAGE, PORT) must be counted in a
receipt instead of silently dropped. Audience: UI host maintainers.
Plan: doc/03_plan/ui/rendering/unified_rendering_qualification_plan_2026-11-13.md section 3.3 / P0.
"""

val BG: u32 = 0xFF000000u32
val RED: u32 = 0xFFFF0000u32
val GREEN: u32 = 0xFF00FF00u32

fn _px(s: RasterSurface, x: i32, y: i32) -> u32:
    s.pixels[y.to_i64() * s.width.to_i64() + x.to_i64()]

fn _add_group(scene: DrawIrV3Scene, id: u32, parent: u32, dx: i32, dy: i32, clip_w: i32, clip_h: i32) -> DrawIrV3Scene:
    var sc = scene
    val tid = draw_ir_v3_transform_next_id(sc.transforms)
    sc.transforms = draw_ir_v3_transform_append(sc.transforms, 1000, 0, 0, 1000, dx, dy)
    var cid = DRAW_IR_V3_NO_ID
    if clip_w > 0:
        cid = draw_ir_v3_clip_next_id(sc.clips)
        sc.clips = draw_ir_v3_clip_append(sc.clips, 0, 0, clip_w, clip_h, 0, DRAW_IR_V3_NO_ID)
    sc.commands.push(draw_ir_v3_command(
        DRAW_IR_V3_KIND_GROUP, DRAW_IR_V3_FLAG_NONE, id, 0u32, parent,
        DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID,
        DRAW_IR_V3_NO_ID, cid, tid, DRAW_IR_V3_NO_ID))
    sc

fn _add_rect(scene: DrawIrV3Scene, id: u32, parent: u32, x: i32, y: i32, w: i32, h: i32, color: u32) -> DrawIrV3Scene:
    var sc = scene
    val gid = draw_ir_v3_geometry_next_id(sc.geometry)
    sc.geometry = draw_ir_v3_geometry_append(sc.geometry, x, y, w, h, 0)
    val pid = draw_ir_v3_paint_next_id(sc.paint)
    sc.paint = draw_ir_v3_paint_append(sc.paint, color, 0u32, 0, 1000, 0u16)
    sc.commands.push(draw_ir_v3_command(
        DRAW_IR_V3_KIND_RECT, DRAW_IR_V3_FLAG_NONE, id, 0u32, parent,
        gid, pid, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID,
        DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID))
    sc

fn _add_bare(scene: DrawIrV3Scene, kind: u16, id: u32) -> DrawIrV3Scene:
    var sc = scene
    sc.commands.push(draw_ir_v3_command(
        kind, DRAW_IR_V3_FLAG_NONE, id, 0u32, DRAW_IR_V3_NO_ID,
        DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID,
        DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID, DRAW_IR_V3_NO_ID))
    sc

describe "scene_raster nested groups":
    it "composes parent and child group offsets":
        step("G1 at (10,10) contains G2 at (5,5) contains a 2x2 rect at local (0,0)")
        var sc = draw_ir_v3_empty_scene(1u32, 1u32)
        sc = _add_group(sc, 1u32, DRAW_IR_V3_NO_ID, 10, 10, 0, 0)
        sc = _add_group(sc, 2u32, 1u32, 5, 5, 0, 0)
        sc = _add_rect(sc, 3u32, 2u32, 0, 0, 2, 2, RED)
        val s = RasterSurface.new(40, 40, BG)
        val painted = raster_scene_into(s, sc)
        expect(painted).to_equal(1)
        expect(_px(s, 15, 15)).to_equal(RED)
        expect(_px(s, 16, 16)).to_equal(RED)
        expect(_px(s, 5, 5)).to_equal(BG)
        expect(_px(s, 10, 10)).to_equal(BG)

    it "returns to the parent offset after a nested group ends":
        step("A rect parented to G1 after G2 uses only G1's offset; a root rect is absolute")
        var sc = draw_ir_v3_empty_scene(1u32, 1u32)
        sc = _add_group(sc, 1u32, DRAW_IR_V3_NO_ID, 10, 10, 0, 0)
        sc = _add_group(sc, 2u32, 1u32, 5, 5, 0, 0)
        sc = _add_rect(sc, 3u32, 2u32, 0, 0, 1, 1, RED)
        sc = _add_rect(sc, 4u32, 1u32, 0, 0, 1, 1, GREEN)
        sc = _add_rect(sc, 5u32, DRAW_IR_V3_NO_ID, 0, 0, 1, 1, RED)
        val s = RasterSurface.new(40, 40, BG)
        raster_scene_into(s, sc)
        expect(_px(s, 15, 15)).to_equal(RED)
        expect(_px(s, 10, 10)).to_equal(GREEN)
        expect(_px(s, 0, 0)).to_equal(RED)

    it "intersects nested clips":
        step("G1 clip 20x20 at (10,10); G2 (+5,+5) clip 30x30; child rect 100x100")
        var sc = draw_ir_v3_empty_scene(1u32, 1u32)
        sc = _add_group(sc, 1u32, DRAW_IR_V3_NO_ID, 10, 10, 20, 20)
        sc = _add_group(sc, 2u32, 1u32, 5, 5, 30, 30)
        sc = _add_rect(sc, 3u32, 2u32, 0, 0, 100, 100, RED)
        val s = RasterSurface.new(60, 60, BG)
        raster_scene_into(s, sc)
        # G1 clip = [10,30); G2 clip = [15,45); intersection = [15,30)
        expect(_px(s, 15, 15)).to_equal(RED)
        expect(_px(s, 29, 29)).to_equal(RED)
        expect(_px(s, 30, 30)).to_equal(BG)
        expect(_px(s, 12, 12)).to_equal(BG)

describe "scene_raster receipt":
    it "counts IMAGE and PORT as unsupported instead of dropping them":
        step("One rect, one IMAGE, one PORT")
        var sc = draw_ir_v3_empty_scene(1u32, 1u32)
        sc = _add_rect(sc, 1u32, DRAW_IR_V3_NO_ID, 0, 0, 2, 2, RED)
        sc = _add_bare(sc, DRAW_IR_V3_KIND_IMAGE, 2u32)
        sc = _add_bare(sc, DRAW_IR_V3_KIND_PORT, 3u32)
        val s = RasterSurface.new(8, 8, BG)
        val r = raster_scene_with_receipt(s, sc)
        expect(r.painted).to_equal(1)
        expect(r.unsupported).to_equal(2)
        expect(r.skipped).to_equal(0)

    it "counts a RECT without geometry as skipped":
        step("RECT with NO_ID geometry")
        var sc = draw_ir_v3_empty_scene(1u32, 1u32)
        sc = _add_bare(sc, DRAW_IR_V3_KIND_RECT, 1u32)
        val s = RasterSurface.new(8, 8, BG)
        val r = raster_scene_with_receipt(s, sc)
        expect(r.painted).to_equal(0)
        expect(r.skipped).to_equal(1)
