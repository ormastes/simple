use std.spec.*
use app.compiler_entrypoint.inventory_scratch.{compiler_inventory_file_event_v1}

describe "compiler inventory checked source reads":
    it "fails closed on missing sources and releases its owned scratch scope":
        val missing = "test/fixtures/scv_inventory_memory/intentionally-missing.spl"
        expect(compiler_inventory_file_event_v1("create", missing, missing)).to_be_nil()
        # The following read must still acquire its own scope after failure.
        val fixture = "test/fixtures/compiled_tool_protocol/protocol café.spl"
        val event = compiler_inventory_file_event_v1("create", fixture, fixture)
        expect(event != nil).to_equal(true)
        expect(event!.byte_count).to_equal(297)
        expect(event!.content_digest).to_equal("717d9a8ddfbbda10f5660dcf2b5bef851976219f43ee59b03d8bb03f6d1a36be")

    it "retains a successfully read empty source as a real event":
        val fixture = "test/fixtures/scv_inventory_memory/empty.spl"
        val event = compiler_inventory_file_event_v1("create", fixture, fixture)
        expect(event != nil).to_equal(true)
        expect(event!.byte_count).to_equal(0)
        expect(event!.content_digest).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
