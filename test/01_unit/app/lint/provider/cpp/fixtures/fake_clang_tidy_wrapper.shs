#!/bin/sh
set -eu

database=""
translation_unit=""
configuration_sha=""
toolchain_sha=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --compile-database) database=$2; shift 2 ;;
        --translation-unit) translation_unit=$2; shift 2 ;;
        --configuration-sha256) configuration_sha=$2; shift 2 ;;
        --toolchain-sha256) toolchain_sha=$2; shift 2 ;;
        --configuration-id|--revision) shift 2 ;;
        *) exit 64 ;;
    esac
done

[ -n "$database" ] && [ -n "$translation_unit" ]
[ ${#configuration_sha} -eq 64 ] && [ ${#toolchain_sha} -eq 64 ]
printf '%s\n' "[{\"rule\":\"modernize-use-nullptr\",\"severity\":\"warning\",\"path\":\"$translation_unit\",\"start_byte\":10,\"end_byte\":14,\"message\":\"use nullptr\",\"fixes\":[{\"start_byte\":10,\"end_byte\":14,\"replacement\":\"nullptr\",\"machine_applicable\":true}]}]"
