use app.lint.provider.rust.authoritative_session.*
use app.lint.provider.rust.worker.{RustLintToolV1, RustLintWorkerConfigV1}
use common.lint_kernel.model.{LintVerdict}
use os.tooling.rust_analyzer_worker.json_ingest.{ingest_rust_json_lines}
use os.tooling.rust_analyzer_worker.model.{RustAnalysisResultV1, RustAnalysisState, RustToolchainIdentityV1}

fn identity() -> RustToolchainIdentityV1:
    RustToolchainIdentityV1(cargo_version: "cargo 1.90.0 (fixture)", rustc_version: "rustc 1.90.0 (fixture)", clippy_version: "clippy 0.1.90 (fixture)", rust_analyzer_version: "rust-analyzer 1.90", workspace_fingerprint: "workspace-v1", configuration_fingerprint: "target+features-v1")

fn config(features: text) -> RustLintWorkerConfigV1:
    RustLintWorkerConfigV1(workspace_root: "test/fixtures/app/lint/rust_worker/workspace", cargo_path: "test/fixtures/app/lint/rust_worker/bin/cargo", rustc_path: "test/fixtures/app/lint/rust_worker/bin/rustc", clippy_path: "test/fixtures/app/lint/rust_worker/bin/clippy-driver", target: "aarch64-unknown-linux-gnu", features: features, timeout_ms: 5000, maximum_output_bytes: 16384, maximum_diagnostics: 8, tool: RustLintToolV1.Clippy)

fn analyzer_result(state: RustAnalysisState, revision: u64) -> RustAnalysisResultV1:
    val json = "{\"reason\":\"compiler-message\",\"message\":{\"level\":\"warning\",\"code\":{\"code\":\"rust-analyzer::dead-code\"},\"message\":\"unused item\",\"spans\":[{\"file_name\":\"src/lib.rs\",\"byte_start\":0,\"byte_end\":4,\"line_start\":1,\"line_end\":1,\"column_start\":1,\"column_end\":5,\"suggested_replacement\":\"\",\"suggestion_applicability\":\"MachineApplicable\"}],\"children\":[]}}"
    val page = ingest_rust_json_lines(json, 8192, 8)
    RustAnalysisResultV1(state: state, identity: identity(), diagnostics: page.diagnostics, malformed_record_count: if state == RustAnalysisState.Partial: 1 else: 0, truncated: false, stderr_text: "revision=" + revision.to_string())

describe "authoritative Rust IDE and lint KPF session":
    it "owns supervised rust-analyzer lifecycle and publishes canonical diagnostics":
        var session = RustAuthoritativeToolingSessionV1.create(7, 4)
        expect(session.start(identity())).to_equal(true)
        val request = session.begin_revision(11)
        val publication = session.publish(request, analyzer_result(RustAnalysisState.Complete, 11))
        expect(publication.state).to_equal(RustToolingPublicationStateV1.Published)
        expect(publication.output.result.verdict).to_equal(LintVerdict.CompleteWithFindings)
        expect(publication.output.diagnostics[0].rule_name).to_equal("rust-analyzer::dead-code")
        expect(publication.output.diagnostics[0].fixes.len()).to_equal(1)
        session.drain()
        expect(session.supervisor.terminated).to_equal(true)
        session.close()
        expect(session.state).to_equal(RustToolingSessionStateV1.Closed)

    it "rejects stale and cancelled diagnostic publication":
        var session = RustAuthoritativeToolingSessionV1.create(9, 4)
        expect(session.start(identity())).to_equal(true)
        val old_request = session.begin_revision(20)
        val current_request = session.begin_revision(21)
        expect(session.publish(old_request, analyzer_result(RustAnalysisState.Complete, 20)).state).to_equal(RustToolingPublicationStateV1.Stale)
        session.cancel(current_request)
        expect(session.publish(current_request, analyzer_result(RustAnalysisState.Complete, 21)).state).to_equal(RustToolingPublicationStateV1.Cancelled)

    it "runs deterministic Cargo and Clippy processes with exact build identity":
        var session = RustAuthoritativeToolingSessionV1.create(12, 4)
        expect(session.start(identity())).to_equal(true)
        val request = session.begin_revision(30)
        val publication = session.run_lint(config("demo"), request)
        expect(publication.state).to_equal(RustToolingPublicationStateV1.Published)
        expect(publication.identity.cargo_version).to_contain("cargo 1.90")
        expect(publication.identity.rustc_version).to_contain("rustc 1.90")
        expect(publication.identity.clippy_version).to_contain("clippy 0.1")
        expect(publication.identity.rust_analyzer_version).to_equal("rust-analyzer 1.90")
        expect(publication.identity.configuration_fingerprint == "").to_equal(false)
        expect(publication.output.diagnostics[0].rule_name).to_equal("clippy::needless_return")

    it "reports malformed worker output explicitly incomplete":
        var session = RustAuthoritativeToolingSessionV1.create(13, 4)
        expect(session.start(identity())).to_equal(true)
        val publication = session.run_lint(config("malformed"), session.begin_revision(40))
        expect(publication.state).to_equal(RustToolingPublicationStateV1.Incomplete)
        expect(publication.output.result.verdict).to_equal(LintVerdict.Partial)

    it "rejects a mismatched exact Rust toolchain identity as incomplete":
        var session = RustAuthoritativeToolingSessionV1.create(14, 4)
        var expected = identity()
        expected.rustc_version = "rustc 1.91.0 (different)"
        expect(session.start(expected)).to_equal(true)
        val publication = session.run_lint(config("demo"), session.begin_revision(50))
        expect(publication.state).to_equal(RustToolingPublicationStateV1.Incomplete)
        expect(publication.output.result.verdict).to_equal(LintVerdict.Partial)
