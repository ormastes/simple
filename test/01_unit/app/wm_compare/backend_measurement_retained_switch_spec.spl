use std.spec.*
use std.common.ui.ui_frame_clock.{FixedStepClock}
use app.wm_compare.backend_measurement_software_export.{
    software_only_retained_switch_export_values
}

describe "software Web retained frame-switch measurement":
    it "separates exact DrawIR reuse from raster and presentation claims":
        val receipt = software_only_retained_switch_export_values(
            96, 64, 3, "gui-perf-cpu-base-solid", FixedStepClock.new(1))
        expect(receipt).to_contain(
            "gui_perf_retained_switch_mode=retained-exact-web-draw-ir")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_resolution=96x64")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_raster_count=1")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_reuse_count=3")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_damage_mode=none")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_readback_scope=none")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_present_scope=none")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_checksum_kind=draw-ir-composition-sha256")
        expect(receipt).to_contain(
            "gui_perf_retained_switch_status=completed")
