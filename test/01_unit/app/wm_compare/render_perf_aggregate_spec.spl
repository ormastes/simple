"""
## Purpose and audience
Unit contract for the A7 aggregate-receipt correlator's interim
`blocked-physical` verdict (doc/03_plan/agent_tasks/guides/gap_b_render_perf_a4_a7_receipts.md).
Plan-acceptance (test/03_system/plan_acceptance/render_perf_redesign_plan_spec.spl)
asserts A7 stays RED on this host until real A6 physical evidence is supplied;
this spec is where the `blocked-physical` shape and the A6 correlation
predicate itself are proven, so the acceptance spec does not have to carry
that contract.
## Operator workflow
bin/simple test test/01_unit/app/wm_compare/render_perf_aggregate_spec.spl
"""
# @cover src/app/wm_compare/render_perf_aggregate.spl

use std.spec.*
use std.nogc_sync_mut.io_runtime.{env_set}
use app.wm_compare_host.file_ops.{file_write, file_exists}
use app.wm_compare_host.dir_ops.{dir_create_all}
use app.wm_compare.render_perf_aggregate.{
    render_perf_aggregate_receipt_values, render_perf_aggregate_a6_correlated,
    render_perf_aggregate_physical_receipt_path
}

val SPEC_A6_DIR: text = "build/render_perf/test_render_perf_aggregate_spec"

fn _fake_vulkan_receipt(checksum_end: text) -> text:
    "producer_receipt_status=pass\n" +
        "producer_receipt_checksum_end=" + checksum_end + "\n"

describe "render_perf_aggregate — A7 aggregate-receipt correlator":

    it "publishes the blocked-physical shape only through the documented keys, never pass or failed, when both software receipts pass and A6 is absent":
        # @req REQ-RENDERPERF-A7
        step("Build the interim blocked-physical receipt directly from the values constructor")
        val receipt = render_perf_aggregate_receipt_values(
            "blocked-physical", "missing-or-uncorrelated-physical-receipt",
            7680, 4320, 10,
            "pass", 9000000, true,
            "pass", 9500000, true,
            false, false)
        step("Assert the interim verdict names the promotion contract's own fields")
        # @capture the receipt's own status/reason/budget fields are the
        # retained evidence for the interim verdict shape.
        expect(receipt).to_contain("aggregate_receipt_status=blocked-physical")
        expect(receipt).to_contain("aggregate_receipt_reason=missing-or-uncorrelated-physical-receipt")
        expect(receipt).to_contain("aggregate_receipt_a4_p95_within_budget=true")
        expect(receipt).to_contain("aggregate_receipt_a5_p95_within_budget=true")
        expect(receipt).to_contain("aggregate_receipt_fallback_used=false")
        expect(receipt).to_contain("aggregate_receipt_a6_correlated=false")
        expect(receipt).to_contain("aggregate_receipt_budget_ns=12500000")

    it "the values constructor also publishes pass and failed shapes distinctly from blocked-physical":
        step("Build the pass shape (all four gates true) and the failed shape (software evidence rejected)")
        val pass_receipt = render_perf_aggregate_receipt_values(
            "pass", "pass", 7680, 4320, 10,
            "pass", 9000000, true, "pass", 9500000, true, false, true)
        val failed_receipt = render_perf_aggregate_receipt_values(
            "failed", "a4-software-evidence-rejected", 7680, 4320, 10,
            "failed", 0, false, "pass", 9500000, true, false, false)
        step("Assert pass requires a6_correlated=true and failed never claims correlation")
        # @capture the three verdict shapes' status fields are mutually
        # exclusive and each carry their own reason.
        expect(pass_receipt).to_contain("aggregate_receipt_status=pass")
        expect(pass_receipt).to_contain("aggregate_receipt_a6_correlated=true")
        expect(failed_receipt).to_contain("aggregate_receipt_status=failed")
        expect(failed_receipt).to_contain("aggregate_receipt_reason=a4-software-evidence-rejected")

    it "A6 correlation is false when no physical receipt file exists at the configured directory":
        step("Point the correlator at an empty scratch directory with no physical_receipt.env")
        env_set("RENDER_PERF_A6_RECEIPT_DIR", SPEC_A6_DIR + "/absent")
        step("Assert correlation is false -- an absent artifact is absence of evidence, never a pass")
        # @capture render_perf_aggregate_a6_correlated's own boolean return is
        # the retained evidence -- a real file-existence check, not a stub.
        expect(render_perf_aggregate_a6_correlated(_fake_vulkan_receipt("424242"))).to_equal(false)

    it "A6 correlation is false when a physical receipt exists but its checksum does not match A5's":
        step("Write a physical receipt whose checksum does not correlate with the software A5 receipt")
        dir_create_all(SPEC_A6_DIR + "/mismatch")
        env_set("RENDER_PERF_A6_RECEIPT_DIR", SPEC_A6_DIR + "/mismatch")
        file_write(render_perf_aggregate_physical_receipt_path(),
            "physical_receipt_status=pass\nphysical_receipt_checksum_end=999999\n")
        step("Assert correlation is false -- a present but uncorrelated file is not correlation")
        # @capture a mismatched checksum yields false even though the file
        # exists, proving this is a real comparison, not a presence check.
        expect(render_perf_aggregate_a6_correlated(_fake_vulkan_receipt("424242"))).to_equal(false)

    it "A6 correlation is true only when the physical receipt passed and its checksum matches A5's":
        step("Write a physical receipt whose checksum correlates with the software A5 receipt")
        dir_create_all(SPEC_A6_DIR + "/match")
        env_set("RENDER_PERF_A6_RECEIPT_DIR", SPEC_A6_DIR + "/match")
        file_write(render_perf_aggregate_physical_receipt_path(),
            "physical_receipt_status=pass\nphysical_receipt_checksum_end=424242\n")
        step("Assert the physical receipt file was actually written before correlating")
        expect(file_exists(render_perf_aggregate_physical_receipt_path())).to_equal(true)
        step("Assert correlation is true -- a real matching, passing receipt is the only way to promote")
        # @capture a matching checksum with physical_receipt_status=pass is
        # the only positive case; this is the promotion condition A7 gates on.
        expect(render_perf_aggregate_a6_correlated(_fake_vulkan_receipt("424242"))).to_equal(true)

    it "A6 correlation is false when the physical receipt itself did not pass, even with a matching checksum":
        step("Write a physical receipt with a matching checksum but a non-pass status")
        dir_create_all(SPEC_A6_DIR + "/notpass")
        env_set("RENDER_PERF_A6_RECEIPT_DIR", SPEC_A6_DIR + "/notpass")
        file_write(render_perf_aggregate_physical_receipt_path(),
            "physical_receipt_status=blocked\nphysical_receipt_checksum_end=424242\n")
        step("Assert correlation is false -- a matching checksum from a failed physical run does not promote")
        # @capture a non-pass physical_receipt_status vetoes correlation even
        # under a coincidental checksum match.
        expect(render_perf_aggregate_a6_correlated(_fake_vulkan_receipt("424242"))).to_equal(false)
