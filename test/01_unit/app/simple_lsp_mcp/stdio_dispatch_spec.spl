use std.test.{describe, it, expect}
use std.io_runtime.{read_file}

describe "simple LSP MCP stdio dispatch":
    it "reads and detects each incoming message inside the transport owner":
        val helpers = read_file("src/app/simple_lsp_mcp/json_helpers.spl")
        val main_source = read_file("src/app/simple_lsp_mcp/main.spl")
        expect(helpers.contains("fn read_stdin_message() -> text:")).to_equal(true)
        expect(helpers.contains("val first_line = _read_line()")).to_equal(true)
        expect(helpers.contains("first_line.starts_with(\"Content-Length:\")")).to_equal(true)
        expect(helpers.contains("if ch.len() == 0:")).to_equal(true)
        expect(helpers.contains("if ch.starts_with(\"\\n\"):")).to_equal(true)
        expect(main_source.contains("val msg = read_stdin_message()")).to_equal(true)
        expect(main_source.contains("transport_mode_locked")).to_equal(false)
