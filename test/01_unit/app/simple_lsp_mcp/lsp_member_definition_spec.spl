# Purpose and audience: executable specification of LSP definition on plain class/struct members, self receivers and chained receivers, for the LSP/tooling team.
# @req REQ-LSP-MEMBER-001
"""
`lsp_definition` on `recv.member` jumps to the member declaration of the
receiver's type, driven through the real `handle_tool_call` path and printed as
`file:line: [kind] Owner.name`:
- a plain field (`e.power`) and a plain method (`e.stop()`),
- `self.power` inside a method (receiver = enclosing class),
- chained receivers `g.car.engine.start()` and `self.car.engine.stop()`
  (each hop resolved through the field's declared type),
- a `pub` field behind `alias Starter = engine` (modifier stripped from the type).

Run: `bin/simple test test/01_unit/app/simple_lsp_mcp/lsp_member_definition_spec.spl`
"""

use std.spec
use std.spec.step
use app.simple_lsp_mcp.tools.{handle_tool_call}
use app.simple_lsp_mcp.session_state.{lsp_reset_location}

val FIX = "test/fixtures/lsp_members/members.spl"

fn call(id: text, line1: i64, ch: i64) -> text:
    lsp_reset_location()
    handle_tool_call(id, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"tools/call\",\"params\":{\"name\":\"lsp_definition\",\"arguments\":{\"file\":\"" + FIX + "\",\"line\":" + str(line1 - 1) + ",\"character\":" + str(ch) + "}}}")

describe "lsp member definition":
    it "jumps from a plain field access to the field declaration":
        step("lsp_definition on e.power (members.spl line 26)")
        val r = call("1", 26, 13)
        expect(r).to_contain(FIX + ":7: [field] Engine.power")

    it "jumps from a plain method call to the method declaration":
        step("lsp_definition on e.stop() (members.spl line 27)")
        val r = call("2", 27, 7)
        expect(r).to_contain(FIX + ":10: [method] Engine.stop")

    it "resolves self.field inside a method to the enclosing class":
        step("lsp_definition on self.power (members.spl line 9)")
        val r = call("3", 9, 14)
        expect(r).to_contain(FIX + ":7: [field] Engine.power")

    it "resolves self.engine.stop through the field's declared type":
        step("lsp_definition on self.engine.stop (members.spl line 17)")
        val r = call("4", 17, 21)
        expect(r).to_contain(FIX + ":10: [method] Engine.stop")

    it "resolves a three-hop chain g.car.engine.start":
        step("lsp_definition on g.car.engine.start (members.spl line 29)")
        val r = call("5", 29, 18)
        expect(r).to_contain(FIX + ":8: [method] Engine.start")

    it "resolves self.car.engine.stop from inside Garage":
        step("lsp_definition on self.car.engine.stop (members.spl line 22)")
        val r = call("6", 22, 25)
        expect(r).to_contain(FIX + ":10: [method] Engine.stop")

    it "resolves a call through a pub field behind an alias":
        step("lsp_definition on c.start() (members.spl line 31)")
        val r = call("7", 31, 7)
        expect(r).to_contain(FIX + ":8: [method] Engine.start")
        expect(r).to_contain("alias Starter = engine")
