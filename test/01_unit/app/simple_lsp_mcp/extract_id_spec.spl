# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# Regression: extract_id must fully parse numeric ids, not prefix-match on "id":1.


use std.spec.step

use std.spec
use app.simple_lsp_mcp.json_helpers.{extract_id}

describe "Simple LSP MCP extract_id full numeric parse":
    it "preserves multi-digit numeric ids starting with 1":
        # @req REQ-SSPEC-UNIT
        step("preserves multi-digit numeric ids starting with 1")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}")).to_equal("1")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"tools/list\"}")).to_equal("10")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"tools/list\"}")).to_equal("11")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":100,\"method\":\"tools/list\"}")).to_equal("100")

    it "preserves other numeric ids exactly":
        # @req REQ-SSPEC-UNIT
        step("preserves other numeric ids exactly")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":2}")).to_equal("2")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":9}")).to_equal("9")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":20}")).to_equal("20")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":17}")).to_equal("17")

    it "handles whitespace, string ids, and notifications":
        # @req REQ-SSPEC-UNIT
        step("handles whitespace, string ids, and notifications")
        expect(extract_id("{\"jsonrpc\":\"2.0\", \"id\" : 10, \"method\":\"ping\"}")).to_equal("10")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":\"request-alpha\"}")).to_equal("\"request-alpha\"")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}")).to_equal("null")

    it "does not confuse an id with other keys containing id text":
        # @req REQ-SSPEC-UNIT
        step("does not confuse an id with other keys containing id text")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":10,\"params\":{\"grid\":1}}")).to_equal("10")
