# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use std.spec
use app.simple_lsp_mcp.json_helpers.{extract_field, extract_id, make_tool_result, make_tool_error, content_length_header, _slice_text, _json_chars, _json_chars_join, _find_json_value_start_chars}

describe "Simple LSP MCP native JSON extraction":
    # @manual scenario evidence
    it "extracts the tool name from a standard tools/call request":
        # @req REQ-SSPEC-UNIT
        step("extracts the tool name from a standard tools/call request")
        val request = "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"lsp_symbols\",\"arguments\":{\"file\":\"src/app/simple_lsp_mcp/main.spl\"}}}"
        expect(extract_field(request, "name")).to_equal("lsp_symbols")
        expect(extract_field(request, "file")).to_equal("src/app/simple_lsp_mcp/main.spl")

    it "preserves numeric and string request identifiers":
        # @req REQ-SSPEC-UNIT
        step("preserves numeric and string request identifiers")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":17}")).to_equal("17")
        expect(extract_id("{\"jsonrpc\":\"2.0\",\"id\":\"request-alpha\"}")).to_equal("\"request-alpha\"")

describe "Simple LSP MCP tool result escaping":
    """
    Regression for simple_lsp_mcp_wrapper_probe_expects_imported_symbol_2026-09-26:
    `make_tool_result` escaped its payload twice (`js(escape_json(content))`),
    so the JSON emitted by `lsp_symbols` reached the client with every quote
    preceded by three backslashes instead of one, and the wrapper probe's
    single-escaped name check could never match ANY symbol.
    """
    # @manual scenario evidence
    it "escapes a JSON payload exactly once in a tool result":
        # @req REQ-SSPEC-UNIT
        step("escapes a JSON payload exactly once in a tool result")
        val payload = "[{\"name\":\"SERVER_NAME\",\"kind\":13}]"
        val out = make_tool_result("\"3\"", payload)
        expect(out).to_contain("\"id\":\"3\"")
        expect(out).to_contain("\"text\":\"[{\\\"name\\\":\\\"SERVER_NAME\\\"")
        expect(out.contains("\\\\\\\"name\\\\\\\"")).to_equal(false)

    it "escapes a tool error message exactly once":
        # @req REQ-SSPEC-UNIT
        step("escapes a tool error message exactly once")
        val out = make_tool_error("\"4\"", "Missing required argument: \"file\"")
        expect(out).to_contain("\"text\":\"Missing required argument: \\\"file\\\"\"")
        expect(out.contains("\\\\\\\"file\\\\\\\"")).to_equal(false)

describe "Simple LSP MCP stdio framing":
    """
    Regression for the 2026-11-16 tools/list desync: Content-Length used the
    char count of a multibyte UTF-8 body, so the framing header under-counted
    and standard MCP clients received a truncated body (and then desynced on
    the remaining bytes).
    """
    # @manual scenario evidence
    it "frames Content-Length as the UTF-8 byte count, not the char count":
        # @req REQ-SSPEC-UNIT
        step("frames Content-Length as the UTF-8 byte count, not the char count")
        val body = "{\"jsonrpc\":\"2.0\",\"id\":7,\"result\":{\"text\":\"⋯ mid — dash\"}}"
        val h = content_length_header(body)
        expect(h).to_equal("Content-Length: " + str(body.byte_len()) + "\r\n\r\n")
        expect(h.contains("Content-Length: " + str(body.len()) + "\r")).to_equal(false)

    it "frames an ASCII body identically under byte and char counts":
        # @req REQ-SSPEC-UNIT
        step("frames an ASCII body identically under byte and char counts")
        val body = "{\"jsonrpc\":\"2.0\",\"id\":8,\"result\":{}}"
        expect(content_length_header(body)).to_equal("Content-Length: " + str(body.len()) + "\r\n\r\n")

describe "Simple LSP MCP single-pass JSON scanners":
    """
    lsp_mcp_hover_definition_hang_windows_2026-10-27 ("Left over"): the scanners
    indexed the request with `_char_at`, which walks the text from the start on
    every call, so each extraction was quadratic in the request size. They now
    index one char array per call. These cases pin that the results are the
    ones the char-walking scanners produced.
    """
    it "joins a char range exactly like the char-indexed slice":
        # @req REQ-SSPEC-UNIT
        step("joins a char range exactly like the char-indexed slice")
        val src = "a\u00e9\u2014b\"c"
        val chars = _json_chars(src)
        expect(chars.len()).to_equal(6)
        expect(_json_chars_join(chars, 0, 6)).to_equal(src)
        expect(_json_chars_join(chars, 1, 3)).to_equal(_slice_text(src, 1, 3))
        expect(_json_chars_join(chars, 4, 99)).to_equal(_slice_text(src, 4, 99))
        expect(_json_chars_join(chars, 3, 3)).to_equal("")

    it "finds the value start after optional whitespace and skips a key-shaped value":
        # @req REQ-SSPEC-UNIT
        step("finds the value start after optional whitespace and skips a key-shaped value")
        expect(_find_json_value_start_chars(_json_chars("{\"k\":1}"), "k")).to_equal(5)
        expect(_find_json_value_start_chars(_json_chars("{\"k\" : \n 1}"), "k")).to_equal(9)
        expect(_find_json_value_start_chars(_json_chars("{\"a\":\"k\",\"k\":2}"), "k")).to_equal(13)
        expect(_find_json_value_start_chars(_json_chars("{\"a\":1}"), "k")).to_equal(-1)
        expect(_find_json_value_start_chars(_json_chars("\"k"), "k")).to_equal(-1)

    it "extracts string, object, array and bare values after multibyte text":
        # @req REQ-SSPEC-UNIT
        step("extracts string, object, array and bare values after multibyte text")
        val json = "{\"t\":\"\u00e9 \\\"q\\\" }\",\"o\":{\"s\":\"}\",\"n\":{\"x\":1}},\"a\":[1,[2,\"]\"],3],\"b\":true,\"z\":7}"
        expect(extract_field(json, "t")).to_equal("\u00e9 \\\"q\\\" }")
        expect(extract_field(json, "o")).to_equal("{\"s\":\"}\",\"n\":{\"x\":1}}")
        expect(extract_field(json, "a")).to_equal("[1,[2,\"]\"],3]")
        expect(extract_field(json, "b")).to_equal("true")
        expect(extract_field(json, "z")).to_equal("7")
        expect(extract_field(json, "missing")).to_equal("")
        expect(extract_field("{\"u\":\"open", "u")).to_equal("")

    it "extracts ids and falls back to null":
        # @req REQ-SSPEC-UNIT
        step("extracts ids and falls back to null")
        expect(extract_id("{\"m\":\"\u00e9\",\"id\" : 42 }")).to_equal("42")
        expect(extract_id("{\"id\":\"a\\\"b\"}")).to_equal("\"a\\\"b\"")
        expect(extract_id("{\"method\":\"x\"}")).to_equal("null")
        expect(extract_id("{\"id\":\"open")).to_equal("null")
