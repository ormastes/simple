# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-LSP-BOUNDED-001
# bug: doc/08_tracking/bug/lsp_mcp_hover_definition_hang_windows_2026-10-27.md
"""
simple-lsp-mcp request bounding over the real `handle_tool_call` path:
- `lsp_definition` on an aliased/forwarded call site returns (a result or a
  bounded JSON error) instead of hanging the server,
- the next request (`lsp_visibility`) on the same server still succeeds.

Run: `bin/simple test test/01_unit/app/simple_lsp_mcp/lsp_definition_bounded_spec.spl`
"""

use std.spec
use std.spec.step
use app.simple_lsp_mcp.tools.{handle_tool_call}
use app.simple_lsp_mcp.session_state.{lsp_reset_location}
use app.simple_lsp_mcp.json_helpers.{clean_command_output}

val PROBE_ALIAS = "test/01_unit/language/accessor_forwarding/probe_alias.spl"
val PROBE_SETTER = "test/01_unit/language/accessor_forwarding/probe_setter.spl"
val PARSE_ERROR = "src/compiler/85.mdsoc/feature/parsing/app/parse_error.spl"

fn call(id: text, name: text, args: text) -> text:
    handle_tool_call(id, "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"method\":\"tools/call\",\"params\":{\"name\":\"" + name + "\",\"arguments\":" + args + "}}")

describe "lsp_definition is bounded":
    it "returns a result or a bounded error for the aliased call site":
        step("lsp_definition on probe_alias.spl line 29 char 30")
        lsp_reset_location()
        val r = call("1", "lsp_definition", "{\"file\":\"" + PROBE_ALIAS + "\",\"line\":29,\"character\":30}")
        expect(r).to_contain("\"id\":1")
        expect(r.len() > 0).to_equal(true)

    it "returns a result or a bounded error for the setter call site":
        step("lsp_definition on probe_setter.spl line 27 char 30")
        lsp_reset_location()
        val r = call("2", "lsp_definition", "{\"file\":\"" + PROBE_SETTER + "\",\"line\":27,\"character\":30}")
        expect(r).to_contain("\"id\":2")

    it "keeps serving lsp_visibility after a definition request":
        step("definition then visibility on the same server")
        lsp_reset_location()
        val d = call("3", "lsp_definition", "{\"file\":\"" + PROBE_ALIAS + "\",\"line\":29,\"character\":30}")
        expect(d).to_contain("\"id\":3")
        val v = call("4", "lsp_visibility", "{\"file\":\"" + PARSE_ERROR + "\",\"requester\":\"" + PROBE_ALIAS + ":30\"}")
        expect(v).to_contain("\"id\":4")
        expect(v).to_contain("ParseError")

describe "clean_command_output trims multibyte output":
    it "strips trailing newlines after an em dash without looping":
        step("given child output containing a multibyte em dash and trailing newlines")
        val out = clean_command_output("part of the tree \— was NOT searched\n\n")
        step("then only the trailing newlines are removed")
        expect(out).to_equal("part of the tree \— was NOT searched")
