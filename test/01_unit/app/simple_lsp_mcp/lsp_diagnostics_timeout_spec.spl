# Authored regression; execution requires a qualified self-hosted runtime.
# The native tracked-PID regression lives in lsp_process_lifecycle_test.cjs.
use std.spec
use app.simple_lsp_mcp.tools.{arg_int_field}

extern fn rt_file_read_text(path: text) -> text?

describe "simple_lsp_mcp diagnostics process ownership":
    it "uses bounded process-tree cleanup with the original diagnostics deadline":
        step("Reproduce the exact failure")
        val source = rt_file_read_text("src/app/simple_lsp_mcp/tools.spl") ?? ""
        expect(source).to_contain("process_run_bounded(find_simple_binary(), [\"check\", file], 10000, LSP_COMMAND_OUTPUT_CAPTURE_BYTES)")
        expect(source.contains("process_run_timeout")).to_equal(false)
        expect(source).to_contain("LSP_COMMAND_OUTPUT_CAPTURE_BYTES: i64 = 1024 * 1024")
        expect(source).to_contain("if enabled != \"1\":")
        expect(source).to_contain("diagnostics unavailable in source mode")

    it "keeps client position parsing on the safe digit parser":
        step("Reject the adjacent regression")
        expect(arg_int_field("{\"line\":41}", "line")).to_equal(41)
        expect(arg_int_field("{\"line\":0}", "line")).to_equal(0)
        expect(arg_int_field("{\"line\":-1}", "line")).to_equal(-1)
        expect(arg_int_field("{\"line\":\"garbage\"}", "line")).to_equal(-1)
        expect(arg_int_field("{}", "line")).to_equal(-1)
