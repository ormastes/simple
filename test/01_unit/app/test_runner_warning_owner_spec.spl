use std.nogc_sync_mut.io.file_ops.{file_read}
use compiler.core.closure_analysis.{closure_warnings_clear, closure_warnings_get, closure_warnings_has}
use compiler.core.call_graph.{call_graph_warnings_clear, call_graph_warnings_get, call_graph_warnings_has}

describe "test runner compiler warning owners":
    it "imports both warning-state owners for Stage4 helper lowering":
        val source = file_read("src/lib/nogc_sync_mut/test_runner/test_runner_helpers.spl")
        expect(source).to_contain("use compiler.core.closure_analysis.{closure_warnings_get, closure_warnings_has}")
        expect(source).to_contain("use compiler.core.call_graph.{call_graph_warnings_get, call_graph_warnings_has}")

    it "reads an empty closure-warning state through the canonical owner":
        closure_warnings_clear()
        expect(closure_warnings_has()).to_equal(false)
        expect(closure_warnings_get().len()).to_equal(0)

    it "prevents call-graph warning state from sharing the closure owner":
        call_graph_warnings_clear()
        expect(call_graph_warnings_has()).to_equal(false)
        expect(call_graph_warnings_get().len()).to_equal(0)
