# Purpose and audience: regression evidence for the doc-coverage command owners.
# @req REQ-SSPEC-UNIT
# Bug: `bin/simple doc-coverage src/app/devhub` ran >10 min and never printed a
# percentage. main() sliced raw args at a fixed index, so the root operand was
# swallowed and the whole repo (9,253 files) was scanned; an explicit directory
# that is not a repo root was also never scanned directly.

use std.spec.{describe, it, expect}
use std.spec.step
use app.cli.doc_coverage_command.{doc_coverage_command_args}
use app.doc_coverage.scanner.file_scanner.{discover_directory_files}
use app.doc_coverage.scanner.comment_extractor.{extract_docstring, extract_docstring_lines}

describe "doc-coverage root operand":
    it "keeps the root operand when the subcommand token is present":
        step("raw args carry the subcommand token")
        val args = doc_coverage_command_args(["bin/simple", "script.spl", "doc-coverage", "src/app/devhub"])
        expect(args).to_equal(["doc-coverage", "src/app/devhub"])

    it "keeps the root operand when launched as run script args":
        step("raw args are script path then operands")
        val args = doc_coverage_command_args(["script.spl", "src/app/devhub"])
        expect(args).to_equal(["doc-coverage", "src/app/devhub"])

describe "explicit directory scan":
    it "discovers sources directly under a non-repo-root directory":
        step("walk the doc_coverage scanner directory")
        val files = discover_directory_files("src/app/doc_coverage/scanner", [])
        expect(files.len() >= 3).to_equal(true)

describe "docstring extraction over pre-split lines":
    it "matches the source-based extractor":
        step("compare both entry points on one fixture")
        val src = "fn f():\n    \"\"\"hello\"\"\"\n    1\n"
        expect(extract_docstring_lines(src.split("\n"), 1)).to_equal(extract_docstring(src, 1))
