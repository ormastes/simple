"""
## Purpose and audience
Purpose: Prove that load_sdoctest_blocks.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-DOC-COVERAGE-001 — stable requirement identity for this spec.
# SDoctest coverage analysis tests.
#
# Reproducing spec for bug
# doc/08_tracking/bug/sdoctest_coverage_loader_never_implemented_2026-07-28.md:
# `load_sdoctest_blocks` and `compute_sdoctest_coverage` were exported by
# analysis/mod.spl and imported by cli/doc_coverage_command.spl and
# compiler_warnings.spl, but were never defined. Before the fix this file
# could not even resolve its imports.

use std.spec.{describe, it, expect}
use app.doc_coverage.analysis.sdoctest_coverage.{load_sdoctest_blocks, compute_sdoctest_coverage, extract_function_names_from_code}
use app.doc_coverage.types.doc_item.{DocItem}

describe "load_sdoctest_blocks":
    it "returns parallel provenance and code arrays":
        step("Verify: returns parallel provenance and code arrays")
        # @req: REQ-APP-DOC-COVERAGE-001
        val result = load_sdoctest_blocks()
        val names = result.0
        val codes = result.1
        expect(names.len()).to_equal(codes.len())

    it "finds at least one markdown code block in this repository":
        step("Verify: finds at least one markdown code block in this repository")
        val result = load_sdoctest_blocks()
        val found = result.1.len() > 0
        expect(found).to_equal(true)

describe "compute_sdoctest_coverage":
    it "counts an item whose name appears in a block as covered":
        step("Verify: counts an item whose name appears in a block as covered")
        val item = DocItem.create_function("validate_tag_format", "src/app/x.spl", 1, 0, "pub", "sig")
        val report = compute_sdoctest_coverage([item], ["fn validate_tag_format(tag: text) -> bool:"])
        expect(report.total_items).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(report.sdoctest_coverage).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(report.missing_sdoctest).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "counts an item absent from every block as missing":
        step("Verify: counts an item absent from every block as missing")
        val item = DocItem.create_function("never_documented_fn", "src/app/x.spl", 1, 0, "pub", "sig")
        val report = compute_sdoctest_coverage([item], ["fn something_else() -> bool:"])
        expect(report.sdoctest_coverage).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.missing_sdoctest).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "groups items by file":
        step("Verify: groups items by file")
        val a = DocItem.create_function("fn_a", "src/app/a.spl", 1, 0, "pub", "sig")
        val b = DocItem.create_function("fn_b", "src/app/a.spl", 2, 0, "pub", "sig")
        val c = DocItem.create_function("fn_c", "src/app/b.spl", 1, 0, "pub", "sig")
        val report = compute_sdoctest_coverage([a, b, c], [])
        expect(report.total_items).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(report.files.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "returns an empty report for no items":
        step("Verify: returns an empty report for no items")
        val report = compute_sdoctest_coverage([], [])
        expect(report.total_items).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(report.files.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
