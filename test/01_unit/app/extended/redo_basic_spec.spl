"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/extended/redo_basic_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.io.{env_get, process_run}
use std.spec.step

# doc-path: doc/01_research/local/redo_basic.md
# doc-path: doc/03_plan/sys_test/redo_basic.md
# doc-path: doc/04_architecture/redo_basic.md
# doc-path: doc/05_design/redo_basic.md

describe "APP Tool Extended Test":
    it "tool execution":
        check(true)
    it "args parsing":
        val args = ["--flag"]
        check(args.len() == 1)
    it "file handling":
        val file = "test.spl"
        check(file.ends_with(".spl"))
    it "config loading":
        val cfg = {"key": "val"}
        check(cfg["key"] == "val")
    it "error handling":
        var err = nil
        check(err == nil)
    it "success path":
        check("success" == "success")
    it "branch test":
        if true: check(true)
        else: check(false)
    it "loop test":
        var c = 0
        for i in 0..3: c = c + 1
        check(c == 3)
    it "edge empty":
        val arr = []
        check(arr.len() == 0)
    it "edge nil":
        val opt = nil
        check(not opt.?)
    it "integration":
        val in = "data"
        val out = in + "_proc"
        check(out == "data_proc")
    it "validation":
        check(1 == 1)
        check(2 > 1)
        check(0 < 1)
