# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.tree.main.{parse_tree_depth_or_default}

describe "tree depth numeric guard":
    # @manual scenario evidence
    it "accepts numeric depths and falls back to default on malformed values":
        # @req REQ-SSPEC-APP
        step("accepts numeric depths and falls back to default on malformed values")
        expect(parse_tree_depth_or_default("4", 2)).to_equal(4)
        expect(parse_tree_depth_or_default("0", 2)).to_equal(0)
        expect(parse_tree_depth_or_default("", 2)).to_equal(2)
        expect(parse_tree_depth_or_default("abc", 2)).to_equal(2)
        expect(parse_tree_depth_or_default("1x", 2)).to_equal(2)
        expect(parse_tree_depth_or_default("-3", 2)).to_equal(2)
