# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.tree.main.{parse_tree_depth_or_default}

describe "tree depth numeric guard":
    it "defaults malformed depth values":
        val source = rt_file_read_text("src/app/tree/main.spl") ?? ""

        expect(source).to_contain("fn parse_tree_depth_or_default(value: text, default_value: i64) -> i64")
        expect(source).to_contain("return trimmed.to_int() ?? default_value")
        expect(source.contains("return trimmed.to_int()\n")).to_equal(false)
