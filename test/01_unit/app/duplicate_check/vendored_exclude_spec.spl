# Vendored third-party code (CLAUDE.md "Owned-Code Scope") is skipped by default;
# --include-vendored restores scanning it.

use compiler.tools.duplicate_check.detector.{collect_files}
use compiler.tools.duplicate_check.main.{parse_args}
use std.io_runtime.{shell}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text, recursive: bool) -> bool

fn vendored_fixture(root: text):
    shell("rm -rf '{root}'")
    expect(rt_dir_create("{root}/vendor/lib", true)).to_equal(true)
    expect(rt_dir_create("{root}/own", true)).to_equal(true)
    val body = "int f(int x) \{\n    return x + 1;\n}\n"
    expect(rt_file_write_text("{root}/own/mine.c", body)).to_equal(true)
    expect(rt_file_write_text("{root}/vendor/lib/dep.c", body)).to_equal(true)
    expect(rt_file_write_text("{root}/miniaudio.h", body)).to_equal(true)
    expect(rt_file_write_text("{root}/stb_image.h", body)).to_equal(true)
    expect(rt_file_write_text("{root}/stb_truetype.h", body)).to_equal(true)

describe "duplicate_check vendored exclusion":
    it "skips vendor dirs and bundled third-party headers by default":
        val root = "/tmp/simple_dupcheck_vendored_fixture"
        vendored_fixture(root)
        val config = parse_args([root, "--include-c"])
        val files = collect_files(root, config)
        expect(files.len()).to_equal(1)
        expect(files[0]).to_contain("own/mine.c")

    it "scans vendored code with --include-vendored":
        val root = "/tmp/simple_dupcheck_vendored_fixture2"
        vendored_fixture(root)
        val config = parse_args([root, "--include-c", "--include-vendored"])
        expect(collect_files(root, config).len()).to_equal(5)

    it "still honours user --exclude together with --include-vendored":
        val root = "/tmp/simple_dupcheck_vendored_fixture3"
        vendored_fixture(root)
        val config = parse_args([root, "--include-c", "--include-vendored", "--exclude", "miniaudio.h"])
        expect(collect_files(root, config).len()).to_equal(4)

    it "anchors vendor/ to a whole path segment, so myvendor/ is still scanned":
        val root = "/tmp/simple_dupcheck_vendored_fixture4"
        shell("rm -rf '{root}'")
        expect(rt_dir_create("{root}/myvendor/lib", true)).to_equal(true)
        expect(rt_dir_create("{root}/vendor", true)).to_equal(true)
        val body = "int f(int x) \{\n    return x + 1;\n}\n"
        expect(rt_file_write_text("{root}/myvendor/lib/own.c", body)).to_equal(true)
        expect(rt_file_write_text("{root}/vendor/dep.c", body)).to_equal(true)
        val config = parse_args([root, "--include-c"])
        val files = collect_files(root, config)
        expect(files.len()).to_equal(1)
        expect(files[0]).to_contain("myvendor/lib/own.c")
