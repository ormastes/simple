"""
## Purpose and audience
Purpose: Prove that Phase 2: Parallel configuration.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-DUPLICATE-CHECK-001 — stable requirement identity for this spec.

# Phase 2 Integration Tests - Parallel processing and incremental analysis

use compiler.tools.duplicate_check.config.{DuplicationConfig, default_config, apply_analysis_mode, compute_config_hash}
use compiler.tools.duplicate_check.parallel.{ParallelConfig, default_parallel_config, single_threaded_config, detect_cpu_count}
use compiler.tools.duplicate_check.incremental.{IncrementalCache, load_incremental_cache, save_incremental_cache, needs_reprocessing, get_cached_blocks, update_cache_entry, compute_incremental_stats, format_incremental_stats}
use compiler.tools.duplicate_check.detector.{DuplicateBlock, find_duplicates, find_duplicates_with_options}
use compiler.tools.duplicate_check.cache.{new_token_cache_manager}
use app.io.mod.{file_read, file_write, shell}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_dir_create(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

fn cleanup_test_dir(path: text):
    shell("rm -rf '{path}'")

fn create_test_file_in(dir: text, path: text, content: text):
    rt_dir_create(dir)
    rt_file_write_text(path, content)

fn minimal_test_config() -> DuplicationConfig:
    var config = default_config()
    config.min_tokens = 8
    config.min_lines = 3
    config.use_incremental = false
    config.incremental_cache_path = ""
    config.exclude_patterns = []
    config.quiet = true
    config

val TEST_DIR = "/tmp/test_duplicate_phase2"

fn create_test_file(path: text, content: text):
    create_test_file_in(TEST_DIR, path, content)

fn duplicate_e2e_body(name: text) -> text:
    [
        "fn {name}(seed: i64) -> i64:",
        "    val base = seed + 42",
        "    val total = base * 2",
        "    val adjusted = total - seed",
        "    if adjusted > seed:",
        "        return adjusted",
        "    return seed"
    ].join("\n")

fn cleanup_test_files():
    cleanup_test_dir(TEST_DIR)

fn total_cached_block_count(cache: IncrementalCache) -> i64:
    var total = 0
    for key in cache.entries.keys():
        total = total + cache.entries[key].blocks.len()
    total

use std.spec.step

describe "Phase 2: Parallel configuration":
    it "creates default parallel config":
        step("Verify: creates default parallel config")
        # @req: REQ-APP-DUPLICATE-CHECK-001
        val config = default_parallel_config()

        expect(config.num_workers).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(config.batch_size).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(config.enabled).to_equal(true)

    it "creates single-threaded config":
        step("Verify: creates single-threaded config")
        val config = single_threaded_config()

        expect(config.num_workers).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(config.enabled).to_equal(false)

    it "detects CPU count":
        step("Verify: detects CPU count")
        val cpu_count = detect_cpu_count()

        expect(cpu_count).to_be_greater_than(0)

describe "Phase 2: Dependency boundary":
    it "keeps lexical duplicate-check off the MCP compatibility closure":
        step("Verify: keeps lexical duplicate-check off the MCP compatibility closure")
        val cli = file_read("src/compiler/90.tools/duplicate_check/main.spl")
        val semantic_formatter = file_read("src/compiler/90.tools/duplicate_check/semantic_formatter.spl")
        val ollama_client = file_read("src/compiler/90.tools/duplicate_check/ollama_client.spl")
        expect(cli).to_contain("use lazy compiler.tools.duplicate_check.semantic.{")
        expect(cli).to_contain("use lazy compiler.tools.duplicate_check.semantic_formatter.{")
        expect(semantic_formatter.contains("mcp.helpers")).to_equal(false)
        expect(ollama_client.contains("mcp.helpers")).to_equal(false)

describe "Phase 2: Incremental cache loading":
    it "creates empty cache when file missing":
        step("Verify: creates empty cache when file missing")
        val cache_path = "/tmp/test_duplicate_phase2/cache_empty.sdn"
        cleanup_test_files()

        var config = minimal_test_config()
        config.min_tokens = 30
        config.min_lines = 5
        config.use_incremental = true
        config.incremental_cache_path = cache_path

        val cache = load_incremental_cache(cache_path, config)

        expect(cache.entries.keys().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(cache.cache_path).to_equal(cache_path)

        cleanup_test_files()

    it "saves and loads incremental cache":
        step("Verify: saves and loads incremental cache")
        val cache_path = "/tmp/test_duplicate_phase2/cache_save.sdn"
        cleanup_test_files()

        var config = minimal_test_config()
        config.min_tokens = 30
        config.min_lines = 5
        config.use_incremental = true
        config.incremental_cache_path = cache_path

        var cache = load_incremental_cache(cache_path, config)

        # Add a test block
        val test_file = "/tmp/test_duplicate_phase2/a\\b|雪.spl"
        create_test_file(test_file, "fn test(): 42")
        val roundtrip_code = "\\n|雪\n\r\t\\p"

        val blocks = [DuplicateBlock(
            file: test_file,
            line_start: 1,
            line_end: 1,
            token_count: 5,
            hash_value: 12345,
            snippet_start_offset: 0,
            snippet_end_offset: 13,
            code: roundtrip_code
        )]

        cache = update_cache_entry(cache, test_file, blocks)
        save_incremental_cache(cache)

        # Reload cache
        val reloaded = load_incremental_cache(cache_path, config)

        expect(reloaded.entries.keys().len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(total_cached_block_count(reloaded)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(reloaded.entries.has(test_file)).to_equal(true)
        expect(reloaded.entries[test_file].blocks[0].code).to_equal(roundtrip_code)

        cleanup_test_files()

    it "rejects malformed cache records instead of partially loading":
        step("Verify: rejects malformed cache records instead of partially loading")
        val cache_path = "/tmp/test_duplicate_phase2/cache_malformed.sdn"
        cleanup_test_files()
        var config = minimal_test_config()
        config.use_incremental = true
        config.incremental_cache_path = cache_path
        val header = "# format: 2\n# config_hash: {compute_config_hash(config)}\n"
        val malformed_records = [
            "# config_hash: {compute_config_hash(config)}\n",
            "{header}file:2f746d702f78|hash|1|1\n  1|2|3|4|5|6|zz\n",
            "{header}file:2f746d702f78|hash|1|9223372036854775807\n",
            "{header}file:2f746d702f78|hash|1|1\n  1|2|0|4|5|6|636f6465\n",
            "{header}file:2f746d702f78|hash|not-an-int|0\n"
        ]
        for malformed in malformed_records:
            create_test_file(cache_path, malformed)
            expect(load_incremental_cache(cache_path, config).entries.keys().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        cleanup_test_files()

describe "Phase 2: Incremental cache invalidation":
    it "detects file changes":
        step("Verify: detects file changes")
        val cache_path = "/tmp/test_duplicate_phase2/cache_invalidate.sdn"
        cleanup_test_files()

        var config = minimal_test_config()
        config.min_tokens = 30
        config.min_lines = 5
        config.use_incremental = true
        config.incremental_cache_path = cache_path

        var cache = load_incremental_cache(cache_path, config)

        val test_file = "/tmp/test_duplicate_phase2/test_change.spl"
        create_test_file(test_file, "fn test1(): 1")

        val blocks = [DuplicateBlock(
            file: test_file,
            line_start: 1,
            line_end: 1,
            token_count: 5,
            hash_value: 111,
            snippet_start_offset: 0,
            snippet_end_offset: 13,
            code: "fn test1(): 1"
        )]

        cache = update_cache_entry(cache, test_file, blocks)
        save_incremental_cache(cache)

        # File should not need reprocessing (unchanged)
        var needs_update = needs_reprocessing(test_file, cache)
        expect(needs_update).to_equal(false)

        # Change file content
        file_write(test_file, "fn test2(): 2")

        # Now should need reprocessing
        needs_update = needs_reprocessing(test_file, cache)
        expect(needs_update).to_equal(true)

        cleanup_test_files()

describe "Phase 2: Incremental statistics":
    it "computes cache hit rate":
        step("Verify: computes cache hit rate")
        val stats = compute_incremental_stats(100, 70)

        expect(stats.total_files).to_equal(100)  # oracle: 100 — named expected value from the requirement
        expect(stats.cached_files).to_equal(70)  # oracle: 70 — named expected value from the requirement
        expect(stats.reprocessed_files).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(stats.cache_hit_rate).to_equal(70)  # oracle: 70 — named expected value from the requirement

    it "formats incremental stats":
        step("Verify: formats incremental stats")
        val stats = compute_incremental_stats(50, 40)
        val formatted = format_incremental_stats(stats)

        expect(formatted).to_contain("10 changed")
        expect(formatted).to_contain("40 cached")
        expect(formatted).to_contain("80% hit rate")

describe "Phase 2: End-to-end incremental detection":
    it "reuses unchanged files and invalidates changed and deleted files":
        step("Verify: reuses unchanged files and invalidates changed and deleted files")
        val cache_path = "/tmp/test_duplicate_phase2/cache_e2e.sdn"
        cleanup_test_files()

        val test_file1 = "/tmp/test_duplicate_phase2/e2e_test1.spl"
        val test_file2 = "/tmp/test_duplicate_phase2/e2e_test2.spl"
        create_test_file(test_file1, duplicate_e2e_body("shared"))
        create_test_file(test_file2, duplicate_e2e_body("shared"))

        var config = apply_analysis_mode(minimal_test_config(), "token")
        config.use_incremental = true
        config.incremental_cache_path = cache_path

        val cache_manager = new_token_cache_manager()
        val files = [test_file1, test_file2]
        val full_groups = find_duplicates(files, config, cache_manager)
        val groups1 = find_duplicates_with_options(files, config, cache_manager, false, true, cache_path)

        expect(groups1.len()).to_equal(full_groups.len())
        expect(groups1.len()).to_be_greater_than(0)

        var cache = load_incremental_cache(cache_path, config)
        expect(get_cached_blocks(test_file1, cache).len()).to_be_greater_than(0)
        expect(get_cached_blocks(test_file2, cache).len()).to_be_greater_than(0)
        val original_hash = cache.entries[test_file2].source_hash

        val groups2 = find_duplicates_with_options(files, config, cache_manager, false, true, cache_path)
        expect(groups2.len()).to_equal(groups1.len())

        create_test_file(test_file2, "fn unique():\n    7\n")
        val changed_groups = find_duplicates_with_options(files, config, cache_manager, false, true, cache_path)
        cache = load_incremental_cache(cache_path, config)
        expect(cache.entries[test_file2].source_hash == original_hash).to_equal(false)
        expect(changed_groups.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        expect(rt_file_delete(test_file2)).to_equal(true)
        val deleted_groups = find_duplicates_with_options([test_file1], config, cache_manager, false, true, cache_path)
        cache = load_incremental_cache(cache_path, config)
        expect(cache.entries.has(test_file2)).to_equal(false)
        expect(deleted_groups.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        cleanup_test_files()
