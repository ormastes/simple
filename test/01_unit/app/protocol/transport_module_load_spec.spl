# Transport modules must load without the stale compiler_rust core.string/core.json copies.
# @req REQ-PROTOCOL-TRANSPORT-LOAD-001
use std.spec
use std.spec.step
use std.nogc_async_mut.lsp.transport.{parse_message_type}
use std.gc_async_mut.lsp.transport as gc_lsp
use app.dap.transport as dap_transport
use app.dap.protocol.{Source}
use app.protocol.transport.{log_error_with_prefix}

describe "Protocol transport module load":
    it "classifies an LSP request after loading the nogc async transport":
        step("Load nogc_async_mut lsp transport and classify a request")
        val kind = parse_message_type({"id": 1, "method": "initialize"})
        expect(kind.unwrap()).to_equal("request")

    it "classifies an LSP notification after loading the gc async transport":
        step("Load gc_async_mut lsp transport and classify a notification")
        val kind = gc_lsp.parse_message_type({"method": "initialized"})
        expect(kind.unwrap()).to_equal("notification")

    it "reads the DAP message type after loading the DAP transport":
        step("Load app.dap.transport and read the type field")
        val kind = dap_transport.parse_message_type({"type": "request"})
        expect(kind.unwrap()).to_equal("request")

    it "constructs a DAP Source after loading the DAP protocol":
        step("Load app.dap.protocol and build a Source")
        val src = Source.new("/tmp/a.spl")
        expect(src.path.unwrap()).to_equal("/tmp/a.spl")

    it "rejects a DAP message without a type field":
        step("Classify a DAP message missing its type field")
        val kind = dap_transport.parse_message_type({"seq": 1})
        expect(kind.is_err()).to_equal(true)
