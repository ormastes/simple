use std.spec
use app.protocol.framing.{frame_strip_line_end, frame_parse_decimal, frame_line_is_jsonl_payload}
use app.protocol.mcp_request_envelope.{mcp_parse_request_envelope_v1}
use app.protocol.wire_stdout.{wire_stdout_write_checked}
use app.protocol.transport.{log_error_with_prefix}

# Pins the app.protocol API that src/app/mcp/main.spl and
# src/app/simple_lsp_mcp/json_helpers.spl import across directories. Without
# `export`, the seed's cross-directory private-fn check rejects both MCP
# entrypoints at startup ("private fn ... is not visible").
describe "app.protocol cross-directory exports":
    it "resolves every symbol the MCP servers import":
        step("Call each imported framing and envelope function")
        expect(frame_strip_line_end("a\r\n")).to_equal("a")
        expect(frame_parse_decimal("42")).to_equal(42)
        expect(frame_line_is_jsonl_payload("{}\n")).to_equal(true)
        val env = mcp_parse_request_envelope_v1("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}")
        expect(env.method).to_equal("initialize")
