"""
## Purpose and audience
Purpose: Prove `app.t32_lsp_mcp.*` resolves when git checks out the
`src/app/t32_lsp_mcp` symlink as a plain text file (core.symlinks=false,
the Windows default), so specs under this path execute real examples.
Audience: module-loader and Windows checkout maintainers.
"""
# @req: REQ-LOADER-APP-SYMLINK-ALIAS

use std.spec.*
use app.t32_lsp_mcp.json_helpers.{lsp_js, lsp_jo2, lsp_jp, lsp_extract_field}

describe "app.t32_lsp_mcp symlink alias":
    it "loads the symlink target module and builds escaped JSON":
        step("Import through app.t32_lsp_mcp and encode a quoted, multi-line value")
        val body = lsp_jo2(lsp_jp("name", lsp_js("t32")), lsp_jp("note", lsp_js("a\"b\nc")))
        expect(body).to_equal("{\"name\":\"t32\",\"note\":\"a\\\"b\\nc\"}")

    it "extracts a field from JSON built by the aliased module":
        step("Round-trip a field through the aliased helpers")
        val body = lsp_jo2(lsp_jp("method", lsp_js("initialize")), lsp_jp("id", "7"))
        expect(lsp_extract_field(body, "method")).to_equal("initialize")
