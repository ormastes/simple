# codex-impl
# Boundary coverage for the standalone T32 CLI contract.  These cases use the
# pure validation path and do not require TRACE32 hardware.

use std.spec.*
use app.t32_cli.mod.{t32_cli_main}

describe "T32 CLI cmm-validate contract":
    it "accepts the documented bridge modes with check as the default":
        val safe_fixture = "ENTRY &addr\nData.dump &addr"
        expect(t32_cli_main(["cmm-validate", safe_fixture])).to_equal(0)
        expect(t32_cli_main(["cmm-validate", safe_fixture, "--mode=check"])).to_equal(0)
        expect(t32_cli_main(["cmm-validate", safe_fixture, "--mode=report"])).to_equal(0)
        expect(t32_cli_main(["cmm-validate", safe_fixture, "--mode=suggest"])).to_equal(0)

    it "rejects an undocumented mode with a nonzero status":
        val safe_fixture = "ENTRY &addr\nData.dump &addr"
        expect(t32_cli_main(["cmm-validate", safe_fixture, "--mode=headless"])).to_equal(1)
