use std.spec.{describe, it, expect}
use app.t32_cli.mod.{t32_cli_main}

describe "TRACE32 public CLI entry export":
    it "handles help without opening a TRACE32 session":
        expect(t32_cli_main(["help"])).to_equal(0)

    it "returns an error for an unknown command and resets it on the next invocation":
        expect(t32_cli_main(["unknown-command-for-export-regression"])).to_equal(1)
        expect(t32_cli_main(["--help"])).to_equal(0)
