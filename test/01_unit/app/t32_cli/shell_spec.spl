"""
## Purpose and audience
Purpose: Prove that T32 Shell.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-T32-CLI-001 — stable requirement identity for this spec.
# Shell spec — tests interactive shell command parsing

fn parse_shell_cmd(line: text) -> [text]:
    var parts: [text] = []
    var buf: [text] = []
    var in_word = false
    for ch in line:
        if ch == " ":
            if in_word:
                parts.push(buf.join(""))
                buf = []
                in_word = false
        else:
            buf.push(ch)
            in_word = true
    if in_word:
        parts.push(buf.join(""))
    parts
use std.spec.step


describe "T32 Shell":
    it "parses simple command":
        step("Verify: parses simple command")
        # @req: REQ-APP-T32-CLI-001
        val parts = parse_shell_cmd("windows")
        expect(parts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parts[0]).to_equal("windows")

    it "parses command with argument":
        step("Verify: parses command with argument")
        val parts = parse_shell_cmd("show break_list")
        expect(parts.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(parts[0]).to_equal("show")
        expect(parts[1]).to_equal("break_list")

    it "parses set command":
        step("Verify: parses set command")
        val parts = parse_shell_cmd("set symbol main")
        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(parts[0]).to_equal("set")
        expect(parts[1]).to_equal("symbol")
        expect(parts[2]).to_equal("main")

    it "parses use command":
        step("Verify: parses use command")
        val parts = parse_shell_cmd("use amp0")
        expect(parts[0]).to_equal("use")
        expect(parts[1]).to_equal("amp0")

    it "parses core command":
        step("Verify: parses core command")
        val parts = parse_shell_cmd("core a53_2")
        expect(parts[0]).to_equal("core")
        expect(parts[1]).to_equal("a53_2")

    it "formats prompt":
        step("Verify: formats prompt")
        val session = "amp0"
        val core = "a53_2"
        val prompt = "{session}:{core}> "
        expect(prompt).to_equal("amp0:a53_2> ")
