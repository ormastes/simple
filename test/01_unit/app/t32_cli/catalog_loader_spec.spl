"""
## Purpose and audience
Purpose: Prove that T32 Catalog Loader.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-T32-CLI-001 — stable requirement identity for this spec.
# Catalog Loader spec — tests SDN format parsing

fn parse_sdn_block(content: text, keyword: text) -> [Dict<text, text>]:
    var entries: [Dict<text, text>] = []
    var current: Dict<text, text> = {}
    var in_entry = false
    val lines = content.split("\n")
    for line in lines:
        val trimmed = line.trim()
        if trimmed.len() == 0 or trimmed.starts_with("#"):
            continue
        if trimmed.starts_with(keyword + " "):
            if in_entry:
                entries.push(current)
            current = {}
            val key = trimmed.substring(keyword.len() + 1)
            current["_key"] = key.trim()
            in_entry = true
        else if in_entry:
            val colon_idx = trimmed.index_of(":")
            match colon_idx:
                Some(idx):
                    val prop = trimmed.substring(0, idx).trim()
                    val after = idx + 1
                    val value = trimmed.substring(after).trim()
                    current[prop] = value
                nil:
                    pass
    if in_entry:
        entries.push(current)
    entries
use std.spec.step


describe "T32 Catalog Loader":
    it "parses window catalog entry":
        step("Verify: parses window catalog entry")
        # @req: REQ-APP-T32-CLI-001
        val sdn = "window break_list\n  title: Breakpoint List\n  kind: built_in\n  capture_mode: print_parse"
        val entries = parse_sdn_block(sdn, "window")
        expect(entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[0]["_key"]).to_equal("break_list")
        expect(entries[0]["title"]).to_equal("Breakpoint List")
        expect(entries[0]["kind"]).to_equal("built_in")

    it "parses multiple entries":
        step("Verify: parses multiple entries")
        val sdn = "window a\n  title: Window A\n\nwindow b\n  title: Window B"
        val entries = parse_sdn_block(sdn, "window")
        expect(entries.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(entries[0]["_key"]).to_equal("a")
        expect(entries[1]["_key"]).to_equal("b")

    it "parses action catalog":
        step("Verify: parses action catalog")
        val sdn = "action set_break\n  label: Set Breakpoint\n  type: execute\n  command: Break.Set"
        val entries = parse_sdn_block(sdn, "action")
        expect(entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[0]["label"]).to_equal("Set Breakpoint")
        expect(entries[0]["type"]).to_equal("execute")

    it "parses field catalog":
        step("Verify: parses field catalog")
        val sdn = "field symbol\n  label: Symbol Name\n  type: string\n  scope: window"
        val entries = parse_sdn_block(sdn, "field")
        expect(entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[0]["label"]).to_equal("Symbol Name")
        expect(entries[0]["scope"]).to_equal("window")

    it "skips comment lines":
        step("Verify: skips comment lines")
        val sdn = "# This is a comment\nwindow test\n  title: Test Window"
        val entries = parse_sdn_block(sdn, "window")
        expect(entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "handles empty input":
        step("Verify: handles empty input")
        val entries = parse_sdn_block("", "window")
        expect(entries.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "parses entry with many properties":
        step("Verify: parses entry with many properties")
        val sdn = "window mem\n  title: Memory\n  kind: built_in\n  capture_mode: print_parse\n  open_command: Data.dump\n  capture_command: WinPrint.Data.dump"
        val entries = parse_sdn_block(sdn, "window")
        expect(entries[0]["open_command"]).to_equal("Data.dump")
        expect(entries[0]["capture_command"]).to_equal("WinPrint.Data.dump")
