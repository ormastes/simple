"""
## Purpose and audience
Purpose: Prove that T32 Window Model.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-T32-CLI-001 — stable requirement identity for this spec.
# Window Model spec — tests window listing and describe
use std.spec.step


describe "T32 Window Model":
    it "lists windows by key":
        step("Verify: lists windows by key")
        # @req: REQ-APP-T32-CLI-001
        var keys: [text] = ["break_list", "register_view", "var_local"]
        expect(keys.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(keys[0]).to_equal("break_list")

    it "finds window by key":
        step("Verify: finds window by key")
        var keys: [text] = ["break_list", "register_view", "var_local"]
        var found = ""
        for k in keys:
            if k == "register_view":
                found = k
        expect(found).to_equal("register_view")

    it "describes window actions":
        step("Verify: describes window actions")
        var actions: [text] = ["set_break", "clear_break", "go"]
        expect(actions.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(actions[0]).to_equal("set_break")

    it "describes window fields":
        step("Verify: describes window fields")
        var fields: [text] = ["symbol", "address"]
        expect(fields.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
