"""
## Purpose and audience
Purpose: Prove that T32 Text Parser.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-T32-CLI-001 — stable requirement identity for this spec.
# Text Parser spec — tests WinPrint output parsing

fn test_split_ws(input: text) -> [text]:
    var result: [text] = []
    var buf: [text] = []
    var in_word = false
    for ch in input:
        if ch == " " or ch == "\t":
            if in_word:
                result.push(buf.join(""))
                buf = []
                in_word = false
        else:
            buf.push(ch)
            in_word = true
    if in_word:
        result.push(buf.join(""))
    result
use std.spec.step


describe "T32 Text Parser":
    it "splits whitespace-separated text":
        step("Verify: splits whitespace-separated text")
        # @req: REQ-APP-T32-CLI-001
        val parts = test_split_ws("hello   world   test")
        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(parts[0]).to_equal("hello")
        expect(parts[1]).to_equal("world")

    it "handles tabs":
        step("Verify: handles tabs")
        val parts = test_split_ws("a\tb\tc")
        expect(parts.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "handles leading whitespace":
        step("Verify: handles leading whitespace")
        val parts = test_split_ws("   hello")
        expect(parts.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parts[0]).to_equal("hello")

    it "parses register name=value pairs":
        step("Verify: parses register name=value pairs")
        val token = "R0=0x00000042"
        val pair = token.split("=")
        expect(pair.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pair[0]).to_equal("R0")
        expect(pair[1]).to_equal("0x00000042")

    it "parses breakpoint line":
        step("Verify: parses breakpoint line")
        val line = "E: 0x08001234 main Program Exec"
        val parts = test_split_ws(line)
        expect(parts[0]).to_equal("E:")
        expect(parts[1]).to_equal("0x08001234")
        expect(parts[2]).to_equal("main")
        expect(parts[3]).to_equal("Program")

    it "parses variable line":
        step("Verify: parses variable line")
        val line = "counter  int  42"
        val parts = test_split_ws(line)
        expect(parts[0]).to_equal("counter")
        expect(parts[1]).to_equal("int")
        expect(parts[2]).to_equal("42")

    it "handles empty string":
        step("Verify: handles empty string")
        val parts = test_split_ws("")
        expect(parts.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "formats table row":
        step("Verify: formats table row")
        val row_data = ["count", "int", "42"]
        var row: [text] = []
        for item in row_data:
            row.push(item)
        expect(row.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        var joined = row[0]
        joined = joined + "  " + row[1]
        joined = joined + "  " + row[2]
        expect(joined).to_contain("count")
        expect(joined).to_contain("42")
