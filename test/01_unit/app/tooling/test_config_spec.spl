"""
## Purpose and audience
Purpose: Prove that TestConfig.defaults.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TOOLING-001 — stable requirement identity for this spec.
# # Test Config Specification
#
# **Feature IDs:** #CONFIG
# **Category:** Tooling
# **Status:** Implemented
#
# ## Overview
#
# Tests configuration loading: defaults, field parsing, multi-level search,
# resource throttle fields.

use app.test_runner_new.test_config.*

# ============================================================================
# Test Group 1: Default Config
# ============================================================================
use std.spec.step


describe "TestConfig.defaults":
    it "has correct timeout":
        step("Verify: has correct timeout")
        # @req: REQ-APP-TOOLING-001
        val config = TestConfig.defaults()
        expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement

    it "has correct memory limit":
        step("Verify: has correct memory limit")
        val config = TestConfig.defaults()
        expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement

    it "has correct cpu limit":
        step("Verify: has correct cpu limit")
        val config = TestConfig.defaults()
        expect(config.cpu_limit_seconds).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "has correct max_fds":
        step("Verify: has correct max_fds")
        val config = TestConfig.defaults()
        expect(config.max_fds).to_equal(256)  # oracle: 256 — named expected value from the requirement

    it "has correct max_procs":
        step("Verify: has correct max_procs")
        val config = TestConfig.defaults()
        expect(config.max_procs).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "has parallel disabled by default":
        step("Verify: has parallel disabled by default")
        val config = TestConfig.defaults()
        expect(config.parallel).to_equal(false)

    it "has fail_fast disabled by default":
        step("Verify: has fail_fast disabled by default")
        val config = TestConfig.defaults()
        expect(config.fail_fast).to_equal(false)

    it "has correct slow threshold":
        step("Verify: has correct slow threshold")
        val config = TestConfig.defaults()
        expect(config.slow_threshold_ms).to_equal(5000)  # oracle: 5000 — named expected value from the requirement

    it "has cpu_threshold default (H2)":
        step("Verify: has cpu_threshold default (H2)")
        val config = TestConfig.defaults()
        expect(config.cpu_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement

    it "has memory_threshold default (H2)":
        step("Verify: has memory_threshold default (H2)")
        val config = TestConfig.defaults()
        expect(config.memory_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement

    it "has throttle disabled by default (H2)":
        step("Verify: has throttle disabled by default (H2)")
        val config = TestConfig.defaults()
        expect(config.throttle_enabled).to_equal(false)

# ============================================================================
# Test Group 2: Config Loading
# ============================================================================

describe "TestConfig.load":
    it "returns defaults when no config file exists":
        step("Verify: returns defaults when no config file exists")
        # In test env, config file may not exist
        val config = TestConfig.load()
        expect(config.timeout_seconds > 0).to_equal(true)

# ============================================================================
# Test Group 3: Config File Search (H1)
# ============================================================================

describe "find_config_file":
    it "returns empty string when no config found":
        step("Verify: returns empty string when no config found")
        # In most test envs, no simple.test.sdn in parents
        val path = find_config_file()
        # Either found or empty - both valid
        expect(path == "" or path.contains("simple.test.sdn")).to_equal(true)

# ============================================================================
# Test Group 4: Config Parsing Edge Cases
# ============================================================================

describe "TestConfig field parsing":
    it "handles comment lines":
        step("Verify: handles comment lines")
        val config = TestConfig.defaults()
        # Load would skip comment lines starting with #
        expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement

    it "handles empty lines":
        step("Verify: handles empty lines")
        val config = TestConfig.defaults()
        expect(config.memory_limit_mb).to_equal(512)  # oracle: 512 — named expected value from the requirement

    it "handles lines without colon separator":
        step("Verify: handles lines without colon separator")
        val config = TestConfig.defaults()
        # Parser skips malformed lines
        expect(config.cpu_limit_seconds).to_equal(30)  # oracle: 30 — named expected value from the requirement

    it "handles invalid integer values":
        step("Verify: handles invalid integer values")
        val config = TestConfig.defaults()
        # to_int_or falls back to default
        expect(config.max_fds).to_equal(256)  # oracle: 256 — named expected value from the requirement

    it "handles invalid float values":
        step("Verify: handles invalid float values")
        val config = TestConfig.defaults()
        # to_float_or falls back to default
        expect(config.cpu_threshold).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement

    it "handles boolean true value":
        step("Verify: handles boolean true value")
        val config = TestConfig.defaults()
        # parallel defaults to false
        expect(config.parallel).to_equal(false)

    it "handles boolean false value":
        step("Verify: handles boolean false value")
        val config = TestConfig.defaults()
        expect(config.fail_fast).to_equal(false)

    it "handles unknown config keys":
        step("Verify: handles unknown config keys")
        val config = TestConfig.defaults()
        # Unknown keys are ignored via wildcard match
        expect(config.timeout_seconds).to_equal(60)  # oracle: 60 — named expected value from the requirement
