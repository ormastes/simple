"""
## Purpose and audience
Contract for the drafted spec-to-SSpec generated-region merge API, owned by
the tooling maintainers who port codex system tests into SSpec. When the API
lands, a merge must preserve manual scenarios verbatim, replace only the
previously generated region, and keep unsupported examples visibly pending
instead of fabricating a false green.
## Operator workflow
Run `simple run test/01_unit/app/tooling/spec_to_sspec_merge_spec.spl` after
touching `std.tooling.migrate_spec_to_spl` or any generated-region marker
handling in the spec porting pipeline.
## Compatibility and limitations
The drafted `merge_generated_spec` API exists in no src/ module today (grep
over src/ 2026-09-06: zero definitions; `std.tooling.migrate_spec_to_spl`
provides generate_spec_spl/extract_* only), so each scenario runs a
fail-closed tripwire against the owning module's shipped source and stays
RED until the API lands. The scenarios therefore assert a source contract,
not merge behavior.
## Verification guidance and troubleshooting
A green tripwire means `fn merge_generated_spec` now exists in the owning
module: extend each scenario with the real merge-behavior assertions
documented in each body. A red tripwire is the expected state until the API
is implemented; do not delete the scenarios or soften the assertions.
"""
# Lifecycle: doc/01_research/domain/llm_tooling_context_ponytail_mimic.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/pure_simple_tool_infra_hardening.md ;
# doc/05_design/pure_simple_tool_infra_hardening.md
# @manual_section: spec-to-SSpec generated-region merge

use std.nogc_sync_mut.io.file_ops.{file_read}
use std.spec.{step}

describe "spec-to-SSpec preservation":
    it "preserves manual tests when adding generated coverage":
        # @req REQ-TOOLING-MERGE-001
        # @capture(bit_table): presence verdict for the drafted merge API in the owning module
        # NOTE: fail-closed tripwire — `merge_generated_spec` is defined in no src/
        # module (grep 2026-09-06), so the original merge-behavior assertions
        # (manual text preserved alongside the generated region) cannot execute.
        # This scenario stays RED until the API lands.
        step("Check the drafted generated-region merge API exists in its owning std tooling module")
        val merge_api_module_source = file_read("src/compiler_rust/lib/std/src/tooling/migrate_spec_to_spl.spl")
        val merge_region_api_present = merge_api_module_source.contains("fn merge_generated_spec")
        expect(merge_region_api_present).to_equal(true)  # oracle: fail-closed — goes green only when fn merge_generated_spec actually lands

    it "updates only the previously generated region":
        # @req REQ-TOOLING-MERGE-002
        # @capture(bit_table): region-replacement contract availability in the owning module
        # NOTE: fail-closed tripwire — same drafted API as the preservation scenario;
        # the in-region replacement assertions are documented here for the landing
        # work: merged output must keep manual-before/manual-after text and drop
        # the previous generated region's content.
        step("Confirm the owning module still lacks the region-replacement merge API")
        val merge_module_source = file_read("src/compiler_rust/lib/std/src/tooling/migrate_spec_to_spl.spl")
        val region_merge_api_present = merge_module_source.contains("fn merge_generated_spec")
        expect(region_merge_api_present).to_equal(true)  # oracle: fail-closed — red until the API lands

    it "keeps unsupported examples visibly pending instead of false green":
        # @req REQ-TOOLING-MERGE-003
        # @capture(bit_table): visible-pending contract availability in the owning module
        # NOTE: fail-closed tripwire — the drafted API that would emit a visible
        # pending marker for example-less specifications does not exist yet; this
        # scenario must go green together with the other two.
        step("Confirm the owning module still lacks the visible-pending merge API")
        val pending_marker_module_source = file_read("src/compiler_rust/lib/std/src/tooling/migrate_spec_to_spl.spl")
        val visible_pending_api_present = pending_marker_module_source.contains("fn merge_generated_spec")
        expect(visible_pending_api_present).to_equal(true)  # oracle: fail-closed — red until the API lands
