# @req: REQ-APP-TOOLING-001

use std.spec.*
use std.test_runner.test_result_wrapper.{count_authored_examples}

use std.spec.step

describe "interpreter result wrapper authored-count guard":
    it "counts sibling examples and ignores documentation and comments":
        # @req: REQ-APP-TOOLING-001
        step("Verify: counts sibling examples and ignores documentation and comments")
        val source = "\"\"\"\nit \"documented only\":\n\"\"\"\n# it \"commented\":\ndescribe \"first\":\n    it \"one\":\n        expect(1).to_equal(1)\ndescribe \"second\":\n    it(\"two\"):\n        expect(2).to_equal(2)\n"  # oracle: 1 — named expected value from the requirement
        expect(count_authored_examples(source)).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "counts the supported example aliases":
        # @req: REQ-APP-TOOLING-001
        step("Verify: counts the supported example aliases")
        val source = "test \"a\":\n    pass_dn\nexample \"b\":\n    pass_dn\nspecify \"c\":\n    pass_dn\nslow_it \"d\":\n    pass_dn\nskip_it \"e\":\n    pass_dn\npending \"f\"\n"
        expect(count_authored_examples(source)).to_equal(6)  # oracle: 6 — named expected value from the requirement
