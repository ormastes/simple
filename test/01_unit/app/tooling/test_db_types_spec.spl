"""
## Purpose and audience
Purpose: Prove that status_to_str.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TOOLING-001 — stable requirement identity for this spec.
# # Test DB Types Specification
#
# **Feature IDs:** #DB-TYPES
# **Category:** Tooling
# **Status:** Implemented
#
# ## Overview
#
# Tests type helpers: status conversion, change type detection,
# flaky change detection, and RFC3339 timestamp functions.

use std.test_runner.test_db_types.*
use std.test_runner.test_db_compat.{micros_to_rfc3339}

# ============================================================================
# Test Group 1: Status Conversion
# ============================================================================
use std.spec.step


describe "status_to_str":
    it "converts Passed":
        step("Verify: converts Passed")
        # @req: REQ-APP-TOOLING-001
        expect(status_to_str(TestStatus.Passed)).to_equal("passed")

    it "converts Failed":
        step("Verify: converts Failed")
        expect(status_to_str(TestStatus.Failed)).to_equal("failed")

    it "converts Skipped":
        step("Verify: converts Skipped")
        expect(status_to_str(TestStatus.Skipped)).to_equal("skipped")

    it "converts Ignored":
        step("Verify: converts Ignored")
        expect(status_to_str(TestStatus.Ignored)).to_equal("ignored")

    it "converts QualifiedIgnore":
        step("Verify: converts QualifiedIgnore")
        expect(status_to_str(TestStatus.QualifiedIgnore)).to_equal("qualifiedignore")

describe "str_to_status":
    it "parses passed":
        step("Verify: parses passed")
        expect(status_to_str(str_to_status("passed"))).to_equal("passed")

    it "parses failed":
        step("Verify: parses failed")
        expect(status_to_str(str_to_status("failed"))).to_equal("failed")

    it "parses skipped":
        step("Verify: parses skipped")
        expect(status_to_str(str_to_status("skipped"))).to_equal("skipped")

    it "defaults to Skipped for unknown":
        step("Verify: defaults to Skipped for unknown")
        expect(status_to_str(str_to_status("invalid"))).to_equal("skipped")

# ============================================================================
# Test Group 2: Change Type Detection
# ============================================================================

describe "change_type_str":
    it "detects new test":
        step("Verify: detects new test")
        expect(change_type_str("", "", true)).to_equal("new_test")

    it "detects no change":
        step("Verify: detects no change")
        expect(change_type_str("passed", "passed", false)).to_equal("no_change")

    it "detects pass to fail":
        step("Verify: detects pass to fail")
        expect(change_type_str("passed", "failed", false)).to_equal("pass_to_fail")

    it "detects fail to pass":
        step("Verify: detects fail to pass")
        expect(change_type_str("failed", "passed", false)).to_equal("fail_to_pass")

    it "detects skip to pass":
        step("Verify: detects skip to pass")
        expect(change_type_str("skipped", "passed", false)).to_equal("skip_to_pass")

    it "detects skip to fail":
        step("Verify: detects skip to fail")
        expect(change_type_str("skipped", "failed", false)).to_equal("skip_to_fail")

    it "detects pass to skip":
        step("Verify: detects pass to skip")
        expect(change_type_str("passed", "skipped", false)).to_equal("pass_to_skip")

    it "detects fail to skip":
        step("Verify: detects fail to skip")
        expect(change_type_str("failed", "skipped", false)).to_equal("fail_to_skip")

# ============================================================================
# Test Group 3: Flaky Change Detection
# ============================================================================

describe "is_flaky_change":
    it "pass_to_fail is flaky":
        step("Verify: pass_to_fail is flaky")
        expect(is_flaky_change("pass_to_fail")).to_equal(true)

    it "fail_to_pass is flaky":
        step("Verify: fail_to_pass is flaky")
        expect(is_flaky_change("fail_to_pass")).to_equal(true)

    it "no_change is not flaky":
        step("Verify: no_change is not flaky")
        expect(is_flaky_change("no_change")).to_equal(false)

    it "new_test is not flaky":
        step("Verify: new_test is not flaky")
        expect(is_flaky_change("new_test")).to_equal(false)

    it "skip_to_pass is not flaky":
        step("Verify: skip_to_pass is not flaky")
        expect(is_flaky_change("skip_to_pass")).to_equal(false)

# ============================================================================
# Test Group 4: RFC3339 Timestamps
# ============================================================================

describe "micros_to_rfc3339":
    it "formats zero as 1970 epoch":
        step("Verify: formats zero as 1970 epoch")
        val ts = micros_to_rfc3339(0)
        expect(ts.starts_with("1970-")).to_equal(true)
        expect(ts.ends_with("Z")).to_equal(true)

    it "produces valid RFC3339 format":
        step("Verify: produces valid RFC3339 format")
        val ts = micros_to_rfc3339(1000000)
        # Should be YYYY-MM-DDTHH:MM:SSZ
        expect(ts.len()).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(ts[4:5]).to_equal("-")
        expect(ts[10:11]).to_equal("T")
        expect(ts[19:20]).to_equal("Z")

    it "formats a negative sub-second timestamp coherently":
        step("Verify: formats a negative sub-second timestamp coherently")
        expect(micros_to_rfc3339(-1)).to_equal("1969-12-31T23:59:59Z")

# Note: parse_rfc3339_to_micros not available in runtime - tests removed

# ============================================================================
# Test Group 5: Extended Types (B1-B4)
# ============================================================================

describe "CounterRecord extended fields":
    it "has last_10_runs field":
        step("Verify: has last_10_runs field")
        val c = CounterRecord(
            test_id: 0, total_runs: 5, passed: 3, failed: 2,
            flaky_count: 1, last_change: "fail_to_pass",
            last_10_runs: "pass,fail,pass,fail,pass", failure_rate_pct: 40.0
        )
        expect(c.last_10_runs).to_equal("pass,fail,pass,fail,pass")
        expect(c.failure_rate_pct).to_equal(40.0)  # oracle: 40.0 — named expected value from the requirement

describe "TimingSummary extended fields":
    it "has all statistical fields":
        step("Verify: has all statistical fields")
        val t = TimingSummary(
            test_id: 0, last_ms: 100.0, p50: 95.0, p90: 110.0,
            p95: 120.0, baseline_median: 90.0,
            p99: 130.0, min_time: 80.0, max_time: 140.0, iqr: 15.0,
            mean: 98.0, std_dev: 12.0, cv_pct: 12.2,
            baseline_mean: 95.0, baseline_std_dev: 10.0, baseline_cv_pct: 10.5,
            baseline_last_updated: "2026-01-01T00:00:00Z",
            baseline_run_count: 10, baseline_update_reason: "initial"
        )
        expect(t.p99).to_equal(130.0)  # oracle: 130.0 — named expected value from the requirement
        expect(t.min_time).to_equal(80.0)  # oracle: 80.0 — named expected value from the requirement
        expect(t.max_time).to_equal(140.0)  # oracle: 140.0 — named expected value from the requirement
        expect(t.iqr).to_equal(15.0)  # oracle: 15.0 — named expected value from the requirement
        expect(t.mean).to_equal(98.0)  # oracle: 98.0 — named expected value from the requirement
        expect(t.std_dev).to_equal(12.0)  # oracle: 12.0 — named expected value from the requirement
        expect(t.cv_pct).to_equal(12.2)  # oracle: 12.2 — named expected value from the requirement
        expect(t.baseline_mean).to_equal(95.0)  # oracle: 95.0 — named expected value from the requirement
        expect(t.baseline_run_count).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(t.baseline_update_reason).to_equal("initial")

describe "TimingConfig defaults":
    it "has sensible defaults":
        step("Verify: has sensible defaults")
        val config = TimingConfig.defaults()
        expect(config.max_runs_per_test).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(config.baseline_change_threshold).to_equal(0.10)  # oracle: 0.10 — named expected value from the requirement
        expect(config.outlier_iqr_multiplier).to_equal(1.5)  # oracle: 1.5 — named expected value from the requirement
