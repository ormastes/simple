"""
## Purpose and audience
Purpose: Prove that test runner failure precedence.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TOOLING-001 — stable requirement identity for this spec.
use std.spec.*
use std.test_runner.test_executor_parsing.{make_result_from_output}

extern fn rt_file_read_text(path: text) -> text?

describe "test runner failure precedence":
    it "keeps a nonzero child exit red after a green summary":
        step("Verify: keeps a nonzero child exit red after a green summary")
        # @req: REQ-APP-TOOLING-001
        val result = make_result_from_output(
            "green_then_crash_spec.spl",
            "1 example, 0 failures",
            "",
            7i32,
            1,
            30
        )

        expect(result.is_ok()).to_equal(false)
        expect(result.failed).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.error).to_contain("Process exited with code 7")

    it "keeps an ordinary green child green":
        step("Verify: keeps an ordinary green child green")
        val result = make_result_from_output(
            "green_spec.spl",
            "1 example, 0 failures",
            "",
            0i32,
            1,
            30
        )

        expect(result.is_ok()).to_equal(true)
        expect(result.failed).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps pending-only and mixed active summaries out of pass inflation":
        step("Verify: keeps pending-only and mixed active summaries out of pass inflation")
        val pending_only = make_result_from_output(
            "pending_only_spec.spl",
            "    it unavailable host ... pending\n" +
            "Test Summary:\n  Total:   1\n  Passed:  0\n" +
            "  Failed:  0\n  Pending: 1\n",
            "",
            0i32,
            1,
            30
        )
        expect(pending_only.passed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pending_only.failed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(pending_only.pending).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(pending_only.error).to_equal("")

        val mixed = make_result_from_output(
            "pending_and_active_spec.spl",
            "    it unavailable host ... pending\n" +
            "    it active path ... ok\n" +
            "Test Summary:\n  Total:   2\n  Passed:  1\n" +
            "  Failed:  0\n  Pending: 1\n",
            "",
            0i32,
            1,
            30
        )
        expect(mixed.passed).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(mixed.failed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(mixed.pending).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "routes daemon-owned nested tests directly":
        step("Verify: routes daemon-owned nested tests directly")
        val client = rt_file_read_text("src/app/test_runner_new/test_runner_client.spl") ?? ""
        val daemon = rt_file_read_text("src/app/test_daemon/light_daemon.spl") ?? ""

        expect(client).to_contain("env_get(\"SIMPLE_TEST_DAEMON_CHILD\") == \"1\"")
        expect(client).to_contain("return run_direct(run)")
        expect(daemon).to_contain("env_set(\"SIMPLE_TEST_DAEMON_CHILD\", \"1\")")
        expect(daemon).to_contain("env_set(\"SIMPLE_TEST_DAEMON_CHILD\", previous_child_marker)")
