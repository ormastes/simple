# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: the multi-language tooling driver's argument surface — flag defaults,
log-option routing, and argv normalization — must behave as the subcommands
(build/test/deploy/watch) rely on.
Audience: tooling engineers who maintain `simple tooling`.
"""

# @manual_section: Tooling argument handling

use std.spec.step

use std.spec.{describe, it, expect}
use app.tooling.main.{get_flag_or, get_flag_int, is_log_option, clean_log_args, normalize_args}

describe "Multi-Language Tooling":
    # @manual scenario evidence
    it "returns a flag value when present and the default when absent":
        # @req REQ-SSPEC-APP
        step("Verify: flag value is honoured, missing flag falls back")
        expect(get_flag_or(["--target", "wasm"], "--target", "native")).to_equal("wasm")  # oracle: explicit flag wins
        expect(get_flag_or([], "--target", "native")).to_equal("native")  # oracle: absent flag uses default

    it "parses integer flags with a numeric default":
        # @req REQ-SSPEC-APP
        step("Verify: integer flag parses and defaults")
        expect(get_flag_int(["--jobs", "8"], "--jobs", 4)).to_equal(8)  # oracle: exact parse
        expect(get_flag_int([], "--jobs", 4)).to_equal(4)  # oracle: absent flag defaults

    it "recognizes log-mode options and skips their values when cleaning":
        # @req REQ-SSPEC-APP
        step("Verify: log options are stripped together with their values")
        expect(is_log_option("--llm")).to_equal(true)  # oracle: known log option
        expect(is_log_option("--release")).to_equal(false)  # oracle: build flag is not a log option
        val cleaned = clean_log_args(["build", "--log-mode", "human", "--release"])
        expect(cleaned).to_equal(["build", "--release"])  # oracle: log flag and its value are removed, build flags kept

    it "normalizes argv down to the arguments after the tooling entry point":
        # @req REQ-SSPEC-APP
        step("Verify: argv is normalized to tooling-scoped arguments")
        expect(normalize_args(["simple", "tooling", "build", "--release"])).to_equal(["build", "--release"])  # oracle: subcommand form
        expect(normalize_args(["run", "src/app/tooling/main.spl", "test"])).to_equal(["test"])  # oracle: run-path form
