        val hybrid = ["fmt", "lint", "test", "spipe-docgen", "context",
                      "mcp", "verify", "dashboard"]
        val pure = ["coverage", "depgraph", "lsp", "dap"]
        expect hybrid.len() + pure.len() == 12

    it "EDGE: each hybrid command has a matching guard":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: each hybrid command has a matching guard")
        # Command -> guard mapping
        val commands = ["fmt", "lint", "context", "mcp", "verify", "dashboard"]
        val guards = ["SIMPLE_FMT_RUST", "SIMPLE_LINT_RUST", "SIMPLE_CONTEXT_RUST",
                      "SIMPLE_MCP_RUST", "SIMPLE_VERIFY_RUST", "SIMPLE_DASHBOARD_RUST"]
        expect commands.len() == guards.len()

# ============================================================================
# 8. Flag Detection Edge Cases (12 tests)
# ============================================================================

describe "flag detection edge cases":
    it "EDGE: flag at end of args":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: flag at end of args")
        val args = ["test", "file.spl", "--json"]
        val needs_rust = args.any(_1 == "--json")
        expect needs_rust == true

    it "EDGE: flag at beginning (right after command)":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: flag at beginning (right after command)")
        val args = ["test", "--json", "file.spl"]
        val needs_rust = args.any(_1 == "--json")
        expect needs_rust == true

    it "EDGE: flag in middle of args":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: flag in middle of args")
        val args = ["test", "a.spl", "--json", "b.spl"]
        val needs_rust = args.any(_1 == "--json")
        expect needs_rust == true

    it "EDGE: flag in middle of args does not swallow the trailing path":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: flag in middle of args does not swallow the trailing path")
        # Flag detection above only proves the flag was SEEN. It says nothing
        # about the positional paths on either side of it, so it passes
        # identically against a parser that drops b.spl. Drive the shipped
        # parser so a dropped path is actually observable.
        # See doc/08_tracking/bug/
        # test_runner_multi_path_drops_all_but_first_2026-08-01.md.
        val opts = parse_test_args(["a.spl", "--json", "b.spl"])
        expect opts.paths.len() == 2
        expect opts.paths[0] == "a.spl"
        expect opts.paths[1] == "b.spl"
        expect count_positional_args(["a.spl", "--json", "b.spl"]) == 2

    it "EDGE: two positional paths with no flag between them":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: two positional paths with no flag between them")
        val opts = parse_test_args(["a.spl", "b.spl"])
        expect opts.paths.len() == 2
        expect opts.paths[0] == "a.spl"
        expect opts.paths[1] == "b.spl"

    it "EDGE: reversed path order is preserved, not re-sorted or truncated":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: reversed path order is preserved, not re-sorted or truncated")
        val opts = parse_test_args(["b.spl", "a.spl"])
        expect opts.paths.len() == 2
        expect opts.paths[0] == "b.spl"
        expect opts.paths[1] == "a.spl"

    it "EDGE: two directory targets are both retained":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: two directory targets are both retained")
        val opts = parse_test_args(["test/unit/", "test/integration/"])
        expect opts.paths.len() == 2
        expect opts.paths[0] == "test/unit/"
        expect opts.paths[1] == "test/integration/"

    it "EDGE: single path parses to exactly one target":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: single path parses to exactly one target")
        # The single-path case must stay byte-identical in behaviour: the
        # multi-path fix must not add a phantom second target.
        val opts = parse_test_args(["a.spl"])
        expect opts.paths.len() == 1
        expect opts.paths[0] == "a.spl"
        expect opts.path == "a.spl"
        expect count_positional_args(["a.spl"]) == 1

    it "EDGE: value-taking flag does not count as a positional path":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: value-taking flag does not count as a positional path")
        # --timeout consumes its value, so only a.spl is positional. The
        # parser and the fail-closed counter must agree, otherwise the runner
        # aborts a legitimate run.
        val opts = parse_test_args(["--timeout", "30", "a.spl"])
        expect opts.paths.len() == 1
        expect opts.paths[0] == "a.spl"
        expect count_positional_args(["--timeout", "30", "a.spl"]) == 1

    it "EDGE: only flag, no files":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: only flag, no files")
        val args = ["lint", "--json"]
        val needs_rust = args.any(_1 == "--json" or _1 == "--fix")
        expect needs_rust == true

    it "EDGE: multiple non-rust flags":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: multiple non-rust flags")
        val args = ["test", "--verbose", "--list", "--show-tags"]
        val needs_rust = args.any(_1 == "--json" or _1 == "--watch" or _1 == "--parallel")
        expect needs_rust == false

    it "EDGE: args[1:] skips command name correctly":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: args[1:] skips command name correctly")
        val args = ["test", "--verbose", "file.spl"]
        val check_args = args[1:]
        expect check_args.len() == 2
        expect check_args[0] == "--verbose"
        # Command name itself should never be checked for flags
        expect check_args.contains("test") == false

    it "EDGE: single letter flag -p matches exactly":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: single letter flag -p matches exactly")
        val args = ["test", "-p"]
        val needs_rust = args.any(_1 == "-p")
        expect needs_rust == true

    it "EDGE: -p is not prefix of -pattern":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: -p is not prefix of -pattern")
        val args = ["test", "-pattern"]
        val needs_rust = args.any(_1 == "-p")
        expect needs_rust == false

    it "EDGE: --capture-screenshots exact match":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: --capture-screenshots exact match")
        val args = ["test", "--capture-screenshots"]
        val needs_rust = args.any(_1 == "--capture-screenshots")
        expect needs_rust == true

    it "EDGE: --cleanup-runs exact match":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: --cleanup-runs exact match")
        val args = ["test", "--cleanup-runs"]
        val needs_rust = args.any(_1 == "--cleanup-runs")
        expect needs_rust == true

    it "EDGE: combined rust-only and normal flags":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: combined rust-only and normal flags")
        val args = ["test", "--verbose", "--watch", "--list"]
        val needs_rust = args.any(_1 == "--watch")
        expect needs_rust == true

    it "EDGE: no args at all (just command)":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: no args at all (just command)")
        val args = ["test"]
        val check_args = args[1:]
        val needs_rust = check_args.any(_1 == "--json")
        expect needs_rust == false

# ============================================================================
# 9. Argument Slicing Edge Cases (8 tests)
# ============================================================================

describe "argument slicing edge cases":
    it "slice of single-element list is empty":
        # @req: REQ-APP-TOOLING-001
        step("Verify: slice of single-element list is empty")
        val args = ["cmd"]
        val rest = args[1:]
        expect rest.len() == 0

    it "slice preserves all elements":
        # @req: REQ-APP-TOOLING-001
        step("Verify: slice preserves all elements")
        val args = ["cmd", "a", "b", "c"]
        val rest = args[1:]
        expect rest.len() == 3
        expect rest[0] == "a"
        expect rest[1] == "b"
        expect rest[2] == "c"

    it "slice of two-element list gives one element":
        # @req: REQ-APP-TOOLING-001
        step("Verify: slice of two-element list gives one element")
        val args = ["cmd", "arg"]
        val rest = args[1:]
        expect rest.len() == 1
        expect rest[0] == "arg"

    it "EDGE: nested slicing":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: nested slicing")
        val args = ["cmd", "a", "b", "c", "d"]
        val rest = args[1:]
        val rest2 = rest[1:]
        expect rest2.len() == 3
        expect rest2[0] == "b"

    it "EDGE: slice with negative index":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: slice with negative index")
        val args = ["a", "b", "c", "d"]
        val last = args[-1]
        expect last == "d"

    it "EDGE: full slice is identity":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: full slice is identity")
        val args = ["a", "b", "c"]
        val full = args[0:]
        expect full.len() == 3

    it "EDGE: slice range":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: slice range")
        val args = ["cmd", "a", "b", "c", "d"]
        val mid = args[1:3]
        expect mid.len() == 2
        expect mid[0] == "a"
        expect mid[1] == "b"

    it "EDGE: step slice":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: step slice")
        val args = ["a", "b", "c", "d", "e", "f"]
        val evens = args[::2]
        expect evens.len() == 3
        expect evens[0] == "a"
        expect evens[1] == "c"
        expect evens[2] == "e"

# ============================================================================
# 10. Command-to-App Mapping (6 tests)
# ============================================================================

describe "command to app directory mapping":
    it "fmt maps to formatter (not fmt)":
        # @req: REQ-APP-TOOLING-001
        step("Verify: fmt maps to formatter (not fmt)")
        val cmd = "fmt"
        val app_dir = "formatter"
        expect cmd != app_dir

    it "spipe-docgen maps to spipe_docgen (hyphen to underscore)":
        # @req: REQ-APP-TOOLING-001
        step("Verify: spipe-docgen maps to spipe_docgen (hyphen to underscore)")
        val cmd = "spipe-docgen"
        val app_dir = "spipe_docgen"
        expect cmd.contains("-") == true
        expect app_dir.contains("-") == false

    it "test maps to test_runner_new (not test)":
        # @req: REQ-APP-TOOLING-001
        step("Verify: test maps to test_runner_new (not test)")
        val cmd = "test"
        val app_dir = "test_runner_new"
        expect cmd != app_dir

    it "direct name commands: lint, coverage, verify, dashboard, context, mcp, depgraph, lsp, dap":
        # @req: REQ-APP-TOOLING-001
        step("Verify: direct name commands: lint, coverage, verify, dashboard, context, mcp, depgraph, lsp, dap")
        val direct = ["lint", "coverage", "verify", "dashboard", "context",
                      "mcp", "depgraph", "lsp", "dap"]
        for cmd in direct:
            val path = "src/app/{cmd}/main.spl"
            expect path.contains(cmd) == true

    it "EDGE: command name is not always the directory name":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: command name is not always the directory name")
        # These commands have different directory names
        val mapped = [["fmt", "formatter"], ["test", "test_runner_new"], ["spipe-docgen", "spipe_docgen"]]
        for pair in mapped:
            expect pair[0] != pair[1]

    it "EDGE: all app directories are snake_case or single word":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: all app directories are snake_case or single word")
        val dirs = ["formatter", "lint", "coverage", "dashboard", "verify",
                    "context", "mcp", "spipe_docgen", "depgraph", "lsp", "dap",
                    "test_runner_new"]
        for dir in dirs:
            expect dir.contains("-") == false
            expect dir.contains(" ") == false

# ============================================================================
# 11. Dispatch Decision Logic (6 tests)
# ============================================================================

describe "dispatch decision logic":
    it "env guard takes highest priority":
        # @req: REQ-APP-TOOLING-001
        step("Verify: env guard takes highest priority")
        # Priority: env guard > rust-only flags > simple app > rust fallback
        val env_set = true
        val has_rust_flag = true
        val app_exists = true
        # When env is set, always use Rust regardless of other conditions
        val use_rust = env_set
        expect use_rust == true

    it "rust-only flags take second priority":
        # @req: REQ-APP-TOOLING-001
        step("Verify: rust-only flags take second priority")
        val env_set = false
        val has_rust_flag = true
        val app_exists = true
        val use_rust = env_set or has_rust_flag
        expect use_rust == true

    it "simple app used when no env guard and no rust flags":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simple app used when no env guard and no rust flags")
        val env_set = false
        val has_rust_flag = false
        val app_exists = true
        val use_simple = not env_set and not has_rust_flag and app_exists
        expect use_simple == true

    it "rust fallback used when app not found":
        # @req: REQ-APP-TOOLING-001
        step("Verify: rust fallback used when app not found")
        val env_set = false
        val has_rust_flag = false
        val app_exists = false
        val use_simple = not env_set and not has_rust_flag and app_exists
        expect use_simple == false

    it "EDGE: env guard overrides even with no rust flags":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: env guard overrides even with no rust flags")
        val env_set = true
        val has_rust_flag = false
        val use_rust = env_set
        expect use_rust == true

    it "EDGE: app not found with no fallback errors":
        # @req: REQ-APP-TOOLING-001
        step("Verify: EDGE: app not found with no fallback errors")
        val app_exists = false
        val has_rust_fallback = false
        val error = not app_exists and not has_rust_fallback
        expect error == true

# ============================================================================
# 12. Integration: Full Dispatch Simulation (6 tests)
# ============================================================================

describe "full dispatch simulation":
    it "simulate fmt dispatch: normal args -> Simple":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate fmt dispatch: normal args -> Simple")
        val args = ["fmt", "file.spl", "--check"]
        val env_set = false
        val needs_rust = args.any(_1 == "--json")
        val app_exists = true
        val dispatch = dispatch_decision(env_set, needs_rust, app_exists)
        expect dispatch == "simple"

    it "simulate fmt dispatch: --json -> Rust":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate fmt dispatch: --json -> Rust")
        val args = ["fmt", "--json", "file.spl"]
        val env_set = false
        val needs_rust = args.any(_1 == "--json")
        val dispatch = dispatch_decision(env_set, needs_rust, true)
        expect dispatch == "rust"

    it "simulate fmt dispatch: env guard -> Rust":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate fmt dispatch: env guard -> Rust")
        val args = ["fmt", "file.spl"]
        val env_set = true
        val needs_rust = args.any(_1 == "--json")
        val dispatch = dispatch_decision(env_set, needs_rust, true)
        expect dispatch == "rust"

    it "simulate coverage dispatch: no fallback, app exists -> Simple":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate coverage dispatch: no fallback, app exists -> Simple")
        val dispatch = if true: "simple" else: "error"
        expect dispatch == "simple"

    it "simulate coverage dispatch: no fallback, app missing -> error":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate coverage dispatch: no fallback, app missing -> error")
        val dispatch = if false: "simple" else: "error"
        expect dispatch == "error"

    it "simulate test dispatch: --watch -> Rust, normal -> Simple":
        # @req: REQ-APP-TOOLING-001
        step("Verify: simulate test dispatch: --watch -> Rust, normal -> Simple")
        val args_watch = ["test", "--watch"]
        val args_normal = ["test", "my_spec.spl"]
        val watch_rust = args_watch.any(_1 == "--watch" or _1 == "--parallel" or _1 == "--json")
        val normal_rust = args_normal.any(_1 == "--watch" or _1 == "--parallel" or _1 == "--json")
        expect watch_rust == true
        expect normal_rust == false

# ============================================================================
# Helper Functions
# ============================================================================

fn dispatch_decision(env_set: bool, needs_rust: bool, app_exists: bool) -> text:
    if env_set:
        return "rust"
    if needs_rust:
        return "rust"
    if app_exists:
        return "simple"
    return "rust"
