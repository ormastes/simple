# @req: REQ-APP-APP-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/app/branch_coverage_12_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec

# doc-path: doc/01_research/local/branch_coverage_12.md
# doc-path: doc/03_plan/sys_test/branch_coverage_12.md
# doc-path: doc/04_architecture/branch_coverage_12.md
# doc-path: doc/05_design/branch_coverage_12.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "elif first arm wins when its guard holds":
        step("Verify: elif first arm wins when its guard holds")
        # @req: REQ-APP-APP-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 5:
            r = 2
        else:
            r = 3
        expect(r).to_equal(2)  # oracle: first true elif

    it "elif second arm wins when first guard fails":
        step("Verify: elif second arm wins when first guard fails")
        # @req: REQ-APP-APP-001
        var r = 0
        if 7 > 10:
            r = 1
        elif 7 > 9:
            r = 2
        elif 7 > 5:
            r = 3
        expect(r).to_equal(3)  # oracle: later elif evaluated after earlier false

    it "while loop stops when guard turns false":
        step("Verify: while loop stops when guard turns false")
        # @req: REQ-APP-APP-001
        var i = 0
        while i < 4:
            i = i + 1
        expect(i).to_equal(4)  # oracle: guard boundary

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "continue skips the rest of the body":
        step("Verify: continue skips the rest of the body")
        # @req: REQ-APP-APP-001
        var c = 0
        for i in 0..5:
            if i == 2: continue
            c = c + 1
        expect(c).to_equal(4)  # oracle: one skipped iteration

    it "if-then arm executes on true condition":
        step("Verify: if-then arm executes on true condition")
        # @req: REQ-APP-APP-001
        var r = 0
        if 10 > 5:
            r = 1
        expect(r).to_equal(1)  # oracle: then arm taken

    it "nested conditionals evaluate inner guard independently":
        step("Verify: nested conditionals evaluate inner guard independently")
        # @req: REQ-APP-APP-001
        var r = 0
        if true:
            if false:
                r = 1
            else:
                r = 2
        expect(r).to_equal(2)  # oracle: outer true, inner false
