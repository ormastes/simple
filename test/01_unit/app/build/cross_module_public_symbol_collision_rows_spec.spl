# Regression pins for cross_module_public_symbol_collisions_2026-08-16.
# The compiler warned that `compile_native` and `dir_remove_all` each had
# co-compiled public definitions with differing signatures, so an ambiguous
# JIT call site could fall back to the wrong body.
use std.spec.step
use std.spec.{describe, it, expect}
use std.io.{file_read}

describe "cross-module public symbol collision rows":
    it "app.io.dir_ops.dir_remove_all matches the std bool signature":
        step("read the app-side definition")
        val src = file_read("src/app/io/dir_ops.spl")
        expect(src.contains("fn dir_remove_all(path: text) -> bool:")).to_equal(true)
        expect(src.contains("fn dir_remove_all(path: text) -> i32:")).to_equal(false)

    it "the app source-file native compiler no longer reuses the backend name":
        step("read the app-side definition")
        val src = file_read("src/app/compile/native.spl")
        expect(src.contains("fn compile_native_source(source_file: text")).to_equal(true)
        expect(src.contains("fn compile_native(")).to_equal(false)
