# @req REQ-BOOTSTRAP-REVIEWED-REPAIR
use std.spec.step
use app.build.targets.build_explain.{BootstrapReason, bootstrap_reason_name}
use app.build.targets.bootstrap_policy.{bootstrap_reason_from_name, bootstrap_authorization_receipt_v2}

describe "reviewed repair bootstrap reason":
    it "round trips the reason without claiming a landed change":
        step("round trip reviewed repair intent")
        val reason = bootstrap_reason_from_name("verify-reviewed-compiler-fix")
        expect(reason == BootstrapReason.VerifyReviewedCompilerFix).to_be(true)
        expect(bootstrap_reason_name(reason)).to_equal("verify-reviewed-compiler-fix")

    it "requires valid hashes and only admits Stage3":
        step("validate scope and hash prerequisites")
        val h = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val reason = BootstrapReason.VerifyReviewedCompilerFix
        expect(bootstrap_authorization_receipt_v2("//bootstrap:stage3", reason, h, h, h, h).len()).to_be_greater_than(0)
        expect(bootstrap_authorization_receipt_v2("//bootstrap:stage4", reason, h, h, h, h)).to_equal("")
        expect(bootstrap_authorization_receipt_v2("//bootstrap:stage2", reason, h, h, h, h)).to_equal("")
        expect(bootstrap_authorization_receipt_v2("//bootstrap:stage3", reason, "", h, h, h)).to_equal("")
