"""
## Purpose and audience
Purpose: Prove that an opt-in backend build group is selected only when its
provider descriptor is admitted (ABI version, host triple, capabilities), and
that the default host selection is unchanged.
Audience: compiler and tooling engineers who maintain backend build groups.
"""
# @req: REQ-APP-BUILD-001 — backend group provider admission (plan §6).

use app.build.targets.build_targets.{
    parse_targets_text, default_group_targets, BackendProviderDescriptor,
    admit_backend_provider, select_backend_group, BACKEND_PROVIDER_ABI_VERSION
}
use std.spec.step

val SRC = "group host:\n    default: true\n    members: compiler\n\ngroup backends_cuda:\n    default: false\n    members: //backend:cuda\n\ntarget compiler:\n    kind: binary\n    entry: src/main.spl\n\ntarget //backend:cuda:\n    kind: shared\n    entry: src/cuda.spl\n"

val HOST = "x86_64-unknown-linux-gnu"

fn _desc(abi: i64, triple: text, caps: [text]) -> BackendProviderDescriptor:
    BackendProviderDescriptor(group: "backends_cuda", abi_version: abi, host_triple: triple, capabilities: caps)

describe "backend provider admission":
    it "admits a matching descriptor and selects its group":
        step("Verify: matching ABI, triple and capabilities admit the provider")
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["object_emit", "optimization"])
        expect(admit_backend_provider(d, HOST, ["object_emit"])).to_equal("")
        val ts = parse_targets_text(SRC)
        val sel = select_backend_group(ts, "backends_cuda", d, HOST, ["object_emit"])
        expect(sel.len()).to_equal(1)  # oracle: 1 — the one cuda member
        expect(sel[0]).to_equal("//backend:cuda")

    it "refuses a wrong ABI version":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION + 1, HOST, ["object_emit"])
        expect(admit_backend_provider(d, HOST, ["object_emit"]).contains("backend-admission: abi-mismatch: backends_cuda")).to_equal(true)
        val sel = select_backend_group(parse_targets_text(SRC), "backends_cuda", d, HOST, ["object_emit"])
        expect(sel.len()).to_equal(0)  # oracle: 0 — refused, nothing selected

    it "refuses a wrong host triple":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, "aarch64-apple-darwin", ["object_emit"])
        expect(admit_backend_provider(d, HOST, ["object_emit"]).contains("backend-admission: triple-mismatch: backends_cuda")).to_equal(true)
        expect(select_backend_group(parse_targets_text(SRC), "backends_cuda", d, HOST, ["object_emit"]).len()).to_equal(0)

    it "refuses a missing declared capability":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["object_emit"])
        expect(admit_backend_provider(d, HOST, ["object_emit", "optimization"]).contains("backend-admission: missing-capability: backends_cuda: optimization")).to_equal(true)

    it "refuses a descriptor for a different group":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["object_emit"])
        expect(select_backend_group(parse_targets_text(SRC), "backends_vhdl", d, HOST, ["object_emit"]).len()).to_equal(0)

    it "leaves default host selection unchanged":
        val sel = default_group_targets(parse_targets_text(SRC))
        expect(sel.len()).to_equal(1)  # oracle: 1 — only the host compiler
        expect(sel[0]).to_equal("compiler")
