use app.build.signed_build_admission.{SIGNED_BUILD_RECEIPT_SCHEMA_V1,
    SIGNED_BUILD_RECEIPT_SCHEMA_V2, SignedBuildReceiptV1,
    SignedBuildReceiptV2, SignedBuildExpectationV1, SignedBuildExpectationV2,
    signed_build_receipt_digest_v2}
use app.build.signed_build_wire.{signed_build_receipt_wire_v2}
use app.build.signed_build_verifier.{SignedBuildSignatureResultV1,
    SignedBuildGateResultV1, SignedBuildGateResultV2,
    verify_signed_build_private_artifact_v2}
use app.io.mod.{cwd, dir_create_all, file_atomic_write, file_read,
    getpid, time_now_unix_micros}
use std.common.crypto.sha256.{sha256_text}

val PRIVATE_REV = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val PRIVATE_DIGEST = sha256_text("trusted-input")

fn _private_receipt_v2() -> SignedBuildReceiptV2:
    val build = SignedBuildReceiptV1(
        SIGNED_BUILD_RECEIPT_SCHEMA_V1, PRIVATE_REV, PRIVATE_REV,
        PRIVATE_REV, "stage2", "linux-x86_64", "x86_64-linux",
        PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST,
        PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST,
        sha256_text("abc"), 3, "artifact:stage2", "builder", "build/linux",
        "2026-09-25T10:00:00Z", "2026-09-25T12:00:00Z")
    SignedBuildReceiptV2(SIGNED_BUILD_RECEIPT_SCHEMA_V2,
        "simple-lang/simple", 42, build)

fn _private_expected_v2() -> SignedBuildExpectationV2:
    SignedBuildExpectationV2("simple-lang/simple", 42,
        SignedBuildExpectationV1(PRIVATE_REV, PRIVATE_REV, PRIVATE_REV,
            "stage2", "linux-x86_64", "x86_64-linux",
            PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST,
            PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST, PRIVATE_DIGEST,
            "builder", "build/linux", "2026-09-25T11:00:00Z",
            "2026-09-26T11:00:00Z"))

fn _private_signature_v2() -> SignedBuildSignatureResultV1:
    SignedBuildSignatureResultV1("VERIFIED",
        signed_build_receipt_digest_v2(_private_receipt_v2()),
        "builder", "build/linux", "AUTHORIZED", "CLEAR",
        PRIVATE_DIGEST, PRIVATE_DIGEST)

fn _private_gates_v2() -> SignedBuildGateResultV2:
    SignedBuildGateResultV2("simple-lang/simple", 42,
        SignedBuildGateResultV1("VERIFIED", PRIVATE_DIGEST,
            PRIVATE_REV, PRIVATE_REV, PRIVATE_REV,
            PRIVATE_DIGEST, PRIVATE_DIGEST))

describe "signed build private artifact handoff":
    it "returns the same verified private bytes to the consumer":
        val root = cwd() + "/build/test/signed-private-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val source = root + "/downloaded"
        expect(file_atomic_write(source, "abc")).to_be(true)
        val decision = verify_signed_build_private_artifact_v2(
            signed_build_receipt_wire_v2(_private_receipt_v2()),
            _private_expected_v2(), _private_signature_v2(),
            _private_gates_v2(), source, root, 1024)
        expect(decision.admission.decision).to_equal("REUSE")
        expect(file_atomic_write(source, "abd")).to_be(true)
        expect(file_read(decision.artifact_path)).to_equal("abc")

    it "returns full build and no consumer path for mismatched bytes":
        val root = cwd() + "/build/test/signed-private-reject-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val source = root + "/downloaded"
        expect(file_atomic_write(source, "abd")).to_be(true)
        val decision = verify_signed_build_private_artifact_v2(
            signed_build_receipt_wire_v2(_private_receipt_v2()),
            _private_expected_v2(), _private_signature_v2(),
            _private_gates_v2(), source, root, 1024)
        expect(decision.admission.decision).to_equal("FULL_BUILD")
        expect(decision.artifact_path).to_equal("")
