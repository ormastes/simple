use std.spec.{describe, it, expect}
use app.build.gate_receipt.{GATE_RECEIPT_SCHEMA_V1, GateObservation,
    GateReceipt, gate_receipt_digest_v1}
use app.build.gate_receipt_wire_v1.{encode_gate_receipt_wire_v1,
    parse_gate_receipt_wire_v1}
use std.nogc_sync_mut.composition.native_build_argv_v1.{
    native_build_argv_encode_v1, native_build_argv_decode_v1}

fn _receipt() -> GateReceipt:
    GateReceipt(GATE_RECEIPT_SCHEMA_V1,
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "cccccccccccccccccccccccccccccccccccccccc",
        "policy", "checker", "submodules", "protected-ci",
        ["compile", "platform", "deadline"], [
            GateObservation("compile", "FAIL", "failed-digest", "compiler failed = 1"),
            GateObservation("platform", "NOT_APPLICABLE", "platform-digest",
                "selected platform: unavailable\n정책 제한"),
            GateObservation("deadline", "INCOMPLETE", "", "timed out")])

fn _items() -> [text]:
    native_build_argv_decode_v1(encode_gate_receipt_wire_v1(_receipt())).arguments

describe "gate receipt wire V1":
    it "preserves exact fields, order, statuses, reasons and digest":
        val original = _receipt()
        val wire = encode_gate_receipt_wire_v1(original)
        expect(wire.len() > 0).to_equal(true)
        val parsed = parse_gate_receipt_wire_v1(wire)
        expect(parsed.is_some()).to_equal(true)
        if val restored = parsed:
            expect(restored.expected_mandatory_ids).to_equal(original.expected_mandatory_ids)
            expect(restored.observed[0].status).to_equal("FAIL")
            expect(restored.observed[0].reason).to_equal("compiler failed = 1")
            expect(restored.observed[1].status).to_equal("NOT_APPLICABLE")
            expect(restored.observed[1].reason)
                .to_equal("selected platform: unavailable\n정책 제한")
            expect(restored.observed[2].status).to_equal("INCOMPLETE")
            expect(gate_receipt_digest_v1(restored)).to_equal(
                gate_receipt_digest_v1(original))
            expect(encode_gate_receipt_wire_v1(restored)).to_equal(wire)

    it "rejects duplicate, unknown, reordered and noncanonical fields":
        var items = _items()
        items[2] = items[1]
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()
        items = _items()
        items[2] = "unknown=revision"
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()
        items = _items()
        val first = items[2]
        items[2] = items[3]
        items[3] = first
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()
        items = _items()
        items[9] = "mandatory_count=03"
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()
        items = _items()
        items.push("unknown=extra")
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()

    it "rejects truncated, trailing, malformed UTF-8 and impossible counts":
        val wire = encode_gate_receipt_wire_v1(_receipt())
        expect(parse_gate_receipt_wire_v1(wire[0..wire.len() - 1])).to_be_nil()
        var trailing = wire.copy()
        trailing.push(0u8)
        expect(parse_gate_receipt_wire_v1(trailing)).to_be_nil()
        var bad_utf8 = wire.copy()
        bad_utf8[17] = 255u8
        expect(parse_gate_receipt_wire_v1(bad_utf8)).to_be_nil()
        var bad_count = wire.copy()
        bad_count[8] = 255u8
        expect(parse_gate_receipt_wire_v1(bad_count)).to_be_nil()

    it "enforces row, scalar, NUL and frame bounds":
        var receipt = _receipt()
        receipt.issuer = "x".repeat(129)
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)
        receipt = _receipt()
        receipt.observed = [GateObservation("compile", "FAIL", "failed-digest",
            "x".repeat(1025))]
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)
        receipt = _receipt()
        receipt.observed = [GateObservation("compile", "FAIL", "failed-digest",
            "bad\0reason")]
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)
        receipt = _receipt()
        var many: [text] = []
        for index in 0..129:
            many.push("gate-" + index.to_text())
        receipt.expected_mandatory_ids = many
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)
        receipt = _receipt()
        var rows: [GateObservation] = []
        for index in 0..128:
            rows.push(GateObservation("gate-" + index.to_text(), "FAIL",
                "e".repeat(512), "r".repeat(1024)))
        receipt.observed = rows
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)

    it "rejects wrong schema and out-of-range decoded values":
        var receipt = _receipt()
        receipt.schema = "future"
        expect(encode_gate_receipt_wire_v1(receipt).len()).to_equal(0)
        var items = _items()
        items[8] = "issuer=" + "x".repeat(129)
        expect(parse_gate_receipt_wire_v1(
            native_build_argv_encode_v1(items))).to_be_nil()
