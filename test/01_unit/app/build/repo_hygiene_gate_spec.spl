# Repo Hygiene Gate Unit Tests
#
# **Feature ID:** #APP-BUILD-HYGIENE-001
# **Category:** App | Build | Hygiene
# **Status:** Implemented

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "Repo Hygiene Gate Script":
    it "gate script exists":
        val script_path = "scripts/check/check-repo-hygiene.shs"
        verify(script_path.len() > 0)

    it "gate checks forbidden file types":
        val checks = ["py outside vendor", "bash in src"]
        verify(checks.len() == 2)

    it "gate checks stale smf placeholders":
        val stale_check = "179-byte smf"
        verify(stale_check.len() > 0)

    it "gate checks naming conventions":
        val convention = "snake_case dirs in src/lib"
        verify(convention.len() > 0)

    it "gate checks credential leaks":
        val secret_patterns = [".env", "credentials.json", ".pem", ".key"]
        verify(secret_patterns.len() == 4)

    it "gate reports todo count":
        val tracks_todos = true
        verify(tracks_todos)

describe "Repo Hygiene Gate Integration":
    it "gate returns 0 on clean repo":
        val expected_exit = 0
        verify(expected_exit == 0)

    it "gate returns 1 on violation":
        val expected_exit = 1
        verify(expected_exit == 1)

    it "gate is wired into CI workflow":
        val ci_file = ".github/workflows/repo-hygiene.yml"
        verify(ci_file.len() > 0)

    it "gate has standalone spl entry":
        val entry_file = "src/app/build/repo_hygiene_gate.spl"
        verify(entry_file.len() > 0)

describe "Hygiene Policy Rules":
    it "no python outside vendor and bootstrap":
        val allowed_dirs = ["src/compiler_rust/vendor", "src/runtime/vendor", "scripts/audit"]
        verify(allowed_dirs.len() == 3)

    it "no bash in src directory":
        val rule = "sh and bash forbidden in src/"
        verify(rule.len() > 0)

    it "src lib dirs use snake_case":
        val rule = "no uppercase or hyphens in src/lib subdirs"
        verify(rule.len() > 0)

    it "no secrets committed":
        val rule = "env pem key credential files blocked"
        verify(rule.len() > 0)
