use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.build.gate_receipt.{GATE_RECEIPT_SCHEMA_V1,
    GateObservation, GateReceipt, gate_receipt_digest_v1}
use app.build.signed_build_admission.{SignedBuildExpectationV1,
    SignedBuildExpectationV2}
use app.build.signed_build_signature_provider.{
    SignedBuildSshProviderConfigV2}
use app.build.signed_build_controller.{
    verify_protected_signed_build_candidate_v2}

val BASE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val TREE = "cccccccccccccccccccccccccccccccccccccccc"
val POLICY = sha256_text("protected-policy")
val CHECKER = sha256_text("protected-checker")
val SUBMODULES = sha256_text("submodule-closure")
val EVIDENCE = sha256_text("independent-gate-run")
val MANIFEST = "must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|\n" +
    "    compile, bootstrap, true, receipt, \"build\", -, -, \"compiler\"\n"

fn _controller_receipt_v2(rows: [GateObservation]) -> GateReceipt:
    GateReceipt(GATE_RECEIPT_SCHEMA_V1, BASE, HEAD, TREE, POLICY,
        CHECKER, SUBMODULES, "protected-ci", ["compile"], rows)

fn _controller_expected_v2(receipt: GateReceipt) -> SignedBuildExpectationV2:
    SignedBuildExpectationV2("simple-lang/simple", 42,
        SignedBuildExpectationV1(BASE, HEAD, TREE, "", "", "",
            "", "", "", SUBMODULES, POLICY, CHECKER,
            gate_receipt_digest_v1(receipt), "", "", "", ""))

fn _controller_verify_v2(receipt: GateReceipt) -> text:
    val result = verify_protected_signed_build_candidate_v2(
        "invalid signed receipt", "invalid signature", receipt,
        _controller_expected_v2(receipt), MANIFEST,
        sha256_text(MANIFEST), "protected-ci",
        SignedBuildSshProviderConfigV2("", "", "", "", "", "", "", ""),
        "/missing/download", "/missing/private", 1024)
    expect(result.admission.decision).to_equal("FULL_BUILD")
    expect(result.snapshot_root).to_equal("")
    expect(result.artifact_path).to_equal("")
    result.admission.reason

describe "protected signed build controller handoff":
    it "requests full-build fallback before signature or artifact access when a mandatory gate is missing":
        val receipt = _controller_receipt_v2([])
        expect(_controller_verify_v2(receipt))
            .to_equal("gates: mandatory-gates-INCOMPLETE")

    it "requests full-build fallback when an observed mandatory gate failed":
        val receipt = _controller_receipt_v2([
            GateObservation("compile", "FAIL", EVIDENCE, "compile failed")])
        expect(_controller_verify_v2(receipt))
            .to_equal("gates: mandatory-gates-FAIL")

    it "requires a valid signed receipt after protected gates pass":
        val receipt = _controller_receipt_v2([
            GateObservation("compile", "PASS", EVIDENCE, "")])
        expect(_controller_verify_v2(receipt))
            .to_equal("signature: receipt-invalid")
