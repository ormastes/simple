use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use app.build.signed_build_admission.{
    SIGNED_BUILD_RECEIPT_SCHEMA_V1, SignedBuildReceiptV1,
    SignedBuildExpectationV1, signed_build_receipt_digest_v1,
    SIGNED_BUILD_RECEIPT_SCHEMA_V2, SignedBuildReceiptV2,
    SignedBuildExpectationV2, signed_build_receipt_digest_v2
}
use app.build.signed_build_wire.{signed_build_receipt_wire_v1, signed_build_receipt_wire_v2}
use app.build.signed_build_verifier.{
    SignedBuildSignatureResultV1, SignedBuildGateResultV1,
    verify_signed_build_bytes_v1, SignedBuildGateResultV2, verify_signed_build_bytes_v2,
    verify_signed_build_stream_v2
}
use app.build.signed_build_stream.{
    signed_build_artifact_stream_new_v2, signed_build_artifact_stream_update_v2
}

val REV = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val DIGEST = sha256_text("trusted-input")

fn _verifier_receipt() -> SignedBuildReceiptV1:
    SignedBuildReceiptV1(
        SIGNED_BUILD_RECEIPT_SCHEMA_V1, REV, REV, REV, "stage2",
        "linux-x86_64", "x86_64-linux", DIGEST, DIGEST, DIGEST,
        DIGEST, DIGEST, DIGEST, DIGEST, sha256_text("abc"), 3,
        "artifact:stage2", "builder", "build/linux",
        "2026-09-25T10:00:00Z", "2026-09-25T12:00:00Z"
    )

fn _verifier_expected() -> SignedBuildExpectationV1:
    SignedBuildExpectationV1(
        REV, REV, REV, "stage2", "linux-x86_64", "x86_64-linux",
        DIGEST, DIGEST, DIGEST, DIGEST, DIGEST, DIGEST, DIGEST,
        "builder", "build/linux", "2026-09-25T11:00:00Z",
        "2026-09-26T11:00:00Z"
    )

# Synthetic provider results exercise controller decisions, not live crypto.
fn _verifier_signature() -> SignedBuildSignatureResultV1:
    SignedBuildSignatureResultV1(
        "VERIFIED", signed_build_receipt_digest_v1(_verifier_receipt()),
        "builder", "build/linux", "AUTHORIZED", "CLEAR", DIGEST, DIGEST
    )

fn _verifier_gates() -> SignedBuildGateResultV1:
    SignedBuildGateResultV1("VERIFIED", DIGEST, REV, REV, REV, DIGEST, DIGEST)

fn _verifier_receipt_v2() -> SignedBuildReceiptV2:
    SignedBuildReceiptV2(SIGNED_BUILD_RECEIPT_SCHEMA_V2, "simple-lang/simple", 42,
        _verifier_receipt())

fn _verifier_signature_v2() -> SignedBuildSignatureResultV1:
    var signature = _verifier_signature()
    signature.payload_digest = signed_build_receipt_digest_v2(_verifier_receipt_v2())
    signature

describe "repository and PR bound controller V2":
    it "admits exact V2 bytes and rejects a legacy payload or signature":
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        val wire = signed_build_receipt_wire_v2(_verifier_receipt_v2())
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature_v2(), gates, [97u8, 98u8, 99u8], 1024
        ).decision).to_equal("REUSE")
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("signature-provider-rejected")
        expect(verify_signed_build_bytes_v2(signed_build_receipt_wire_v1(_verifier_receipt()),
            expected, _verifier_signature_v2(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("invalid-receipt-wire")

    it "rejects repository and PR replay even with identical build identities":
        val wire = signed_build_receipt_wire_v2(_verifier_receipt_v2())
        var expected = SignedBuildExpectationV2("other/repository", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature_v2(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("repository-pr-mismatch")
        expected = SignedBuildExpectationV2("simple-lang/simple", 43, _verifier_expected())
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature_v2(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("repository-pr-mismatch")

    it "rejects gate evidence from another PR and corrupted artifact bytes":
        val wire = signed_build_receipt_wire_v2(_verifier_receipt_v2())
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        var gates = SignedBuildGateResultV2("simple-lang/simple", 43, _verifier_gates())
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature_v2(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("gate-provider-rejected")
        gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        expect(verify_signed_build_bytes_v2(wire, expected,
            _verifier_signature_v2(), gates, [97u8, 98u8, 100u8], 1024
        ).reason).to_equal("artifact-unverified")

    it "requires FULL_BUILD for binaries above the in-memory artifact ceiling":
        var build = _verifier_receipt()
        build.artifact_length = 32505856
        val receipt = SignedBuildReceiptV2(SIGNED_BUILD_RECEIPT_SCHEMA_V2,
            "simple-lang/simple", 42, build)
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        var signature = _verifier_signature_v2()
        signature.payload_digest = signed_build_receipt_digest_v2(receipt)
        val result = verify_signed_build_bytes_v2(signed_build_receipt_wire_v2(receipt),
            expected, signature, gates, [], 16777216)
        expect(result.decision).to_equal("FULL_BUILD")
        expect(result.reason).to_equal("artifact-size-mismatch")

describe "streamed V2 signed build controller":
    it "accepts a policy above 16 MiB while hashing actual small chunks":
        var stream = signed_build_artifact_stream_new_v2(32505856).unwrap()
        signed_build_artifact_stream_update_v2(stream, [97u8]).unwrap()
        signed_build_artifact_stream_update_v2(stream, [98u8, 99u8]).unwrap()
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        val result = verify_signed_build_stream_v2(
            signed_build_receipt_wire_v2(_verifier_receipt_v2()), expected,
            _verifier_signature_v2(), gates, stream)
        expect(result.decision).to_equal("REUSE")
        expect(verify_signed_build_stream_v2(
            signed_build_receipt_wire_v2(_verifier_receipt_v2()), expected,
            _verifier_signature_v2(), gates, stream
        ).reason).to_equal("artifact-stream-finished")

    it "rejects a signed 31 MiB length when only three bytes arrived":
        var stream = signed_build_artifact_stream_new_v2(32505856).unwrap()
        signed_build_artifact_stream_update_v2(stream, [97u8, 98u8, 99u8]).unwrap()
        var build = _verifier_receipt()
        build.artifact_length = 32505856
        val receipt = SignedBuildReceiptV2(SIGNED_BUILD_RECEIPT_SCHEMA_V2,
            "simple-lang/simple", 42, build)
        var signature = _verifier_signature_v2()
        signature.payload_digest = signed_build_receipt_digest_v2(receipt)
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        val result = verify_signed_build_stream_v2(signed_build_receipt_wire_v2(receipt),
            expected, signature, gates, stream)
        expect(result.decision).to_equal("FULL_BUILD")
        expect(result.reason).to_equal("artifact-size-mismatch")

    it "rejects a valid byte stream with a signature for a different receipt":
        var stream = signed_build_artifact_stream_new_v2(32505856).unwrap()
        signed_build_artifact_stream_update_v2(stream, [97u8, 98u8, 99u8]).unwrap()
        var signature = _verifier_signature_v2()
        signature.payload_digest = sha256_text("another-signed-receipt")
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42, _verifier_expected())
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42, _verifier_gates())
        expect(verify_signed_build_stream_v2(
            signed_build_receipt_wire_v2(_verifier_receipt_v2()), expected,
            signature, gates, stream
        ).reason).to_equal("signature-provider-rejected")

describe "base-owned signed build decision controller":
    it "admits the exact bytes with bound trusted provider outcomes":
        val result = verify_signed_build_bytes_v1(
            signed_build_receipt_wire_v1(_verifier_receipt()),
            _verifier_expected(), _verifier_signature(), _verifier_gates(),
            [97u8, 98u8, 99u8], 1024)
        expect(result.decision).to_equal("REUSE")

    it "rejects corrupt bytes even when provider results pass":
        val result = verify_signed_build_bytes_v1(
            signed_build_receipt_wire_v1(_verifier_receipt()),
            _verifier_expected(), _verifier_signature(), _verifier_gates(),
            [97u8, 98u8, 100u8], 1024)
        expect(result.reason).to_equal("artifact-unverified")

    it "rejects unknown signature state and missing revocation evidence":
        var signature = _verifier_signature()
        signature.status = "UNKNOWN"
        val wire = signed_build_receipt_wire_v1(_verifier_receipt())
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            signature, _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("signature-provider-rejected")
        signature = _verifier_signature()
        signature.revocation_status = "UNAVAILABLE"
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            signature, _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).decision).to_equal("FULL_BUILD")

    it "rejects signature replay across payloads or protected policies":
        var signature = _verifier_signature()
        signature.payload_digest = sha256_text("another-receipt")
        val wire = signed_build_receipt_wire_v1(_verifier_receipt())
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            signature, _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("signature-provider-rejected")
        signature = _verifier_signature()
        signature.protected_policy_digest = sha256_text("another-policy")
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            signature, _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).decision).to_equal("FULL_BUILD")

    it "rejects gate results from another candidate":
        var gates = _verifier_gates()
        gates.candidate_tree = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        expect(verify_signed_build_bytes_v1(
            signed_build_receipt_wire_v1(_verifier_receipt()),
            _verifier_expected(), _verifier_signature(), gates,
            [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("gate-provider-rejected")

    it "rejects unverified gates and another authenticated signer":
        val wire = signed_build_receipt_wire_v1(_verifier_receipt())
        var gates = _verifier_gates()
        gates.status = "INCOMPLETE"
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            _verifier_signature(), gates, [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("gate-provider-rejected")
        var signature = _verifier_signature()
        signature.signer_id = "unapproved-builder"
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            signature, _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("signer-untrusted")

    it "rejects oversized artifacts and invalid configured limits":
        val wire = signed_build_receipt_wire_v1(_verifier_receipt())
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            _verifier_signature(), _verifier_gates(), [97u8, 98u8, 99u8], 2
        ).reason).to_equal("artifact-size-mismatch")
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            _verifier_signature(), _verifier_gates(), [97u8], 16777217
        ).reason).to_equal("invalid-artifact-limit")
        expect(verify_signed_build_bytes_v1(wire, _verifier_expected(),
            _verifier_signature(), _verifier_gates(), [97u8], 1024
        ).reason).to_equal("artifact-size-mismatch")

    it "rejects empty or noncanonical wire before admission":
        expect(verify_signed_build_bytes_v1("", _verifier_expected(),
            _verifier_signature(), _verifier_gates(), [], 1024
        ).reason).to_equal("invalid-receipt-wire")

    it "preserves candidate and expiry checks in the admission validator":
        var expected = _verifier_expected()
        expected.now_utc = "2026-09-25T12:00:00Z"
        expect(verify_signed_build_bytes_v1(
            signed_build_receipt_wire_v1(_verifier_receipt()), expected,
            _verifier_signature(), _verifier_gates(), [97u8, 98u8, 99u8], 1024
        ).reason).to_equal("receipt-expired")
