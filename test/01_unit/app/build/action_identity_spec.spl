# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.build.targets.action_identity.{
    NATIVE_ACTION_INPUT_PRODUCER_V1, NativeActionInputIdentityV1,
    native_action_input_receipt_text_v1, parse_native_action_input_receipt_v1,
    native_action_input_error_v1, load_current_native_action_input_v1,
    aggregate_action_identity_text_v1, aggregate_action_identity_digest_v1
}
use app.build.targets.artifact_receipt.{
    ImportedClosureInputV1, publish_dependency_manifest_layer_v1,
    publish_imported_closure_layer_v1, target_cache_namespace_v1,
    target_action_key_v1, digest_is_sha256, declared_path_valid
}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{file_write, file_hash_sha256, dir_create_all, getpid}
use app.io.process_ops.{process_run_bounded_direct}
use std.nogc_sync_mut.io.path_identity.{path_final_existing}
use app.build.targets.native_tool_path.{native_tool_path_valid_v1,
    native_tool_absolute_path_v1, native_tool_receipt_path_v1}


val ACTION_IDENTITY_ROOT = "/tmp/simple-action-identity-spec-{getpid()}"

fn _setup_identity() -> NativeActionInputIdentityV1:
    val cache_dir = ACTION_IDENTITY_ROOT + "/build/target_cache/app"
    dir_create_all(ACTION_IDENTITY_ROOT + "/src")
    dir_create_all(ACTION_IDENTITY_ROOT + "/build/tools")
    file_write(ACTION_IDENTITY_ROOT + "/src/main.spl", "fn main(): 0\n")
    file_write(ACTION_IDENTITY_ROOT + "/build/tools/simple", "#!/bin/sh\nexit 0\n")
    val tool_artifact = file_hash_sha256(ACTION_IDENTITY_ROOT + "/build/tools/simple")
    val tool_behavior = sha256_text("compiler-behavior-v1")
    val dependency_digest = publish_dependency_manifest_layer_v1(
        ACTION_IDENTITY_ROOT, cache_dir, "//app:main", []
    )
    val closure_digest = publish_imported_closure_layer_v1(
        ACTION_IDENTITY_ROOT, cache_dir, "//app:main", "src/main.spl",
        tool_behavior, dependency_digest, [
            ImportedClosureInputV1(
                "src/main.spl",
                file_hash_sha256(ACTION_IDENTITY_ROOT + "/src/main.spl")
            )
        ]
    )
    val producer_abi = sha256_text("producer-abi-v1")
    val target_identity = sha256_text("x86_64-unknown-linux-gnu")
    val namespace = target_cache_namespace_v1(
        producer_abi, target_identity, "release", "binary"
    )
    val key = target_action_key_v1(
        "//app:main", "native-build", "P1", "B3", namespace,
        dependency_digest, closure_digest, tool_behavior, "binary"
    )
    NativeActionInputIdentityV1(
        producer: NATIVE_ACTION_INPUT_PRODUCER_V1, target: "//app:main",
        action: "native-build", entry: "src/main.spl",
        tool_path: "build/tools/simple", tool_artifact_digest: tool_artifact,
        tool_behavior_digest: tool_behavior, producer_abi_digest: producer_abi,
        target_identity_digest: target_identity, profile: "release",
        dependency_manifest_digest: dependency_digest,
        imported_closure_digest: closure_digest,
        target_triple: "x86_64-unknown-linux-gnu", architecture: "x86_64",
        deployment_target: "none", sdk_identity: "none", backend: "llvm",
        optimization: "release-o2", object_format: "elf",
        linker_policy: "elf-hardened-v1", runtime_provider_receipt: "none",
        action_key: key, errors: []
    )

fn _external_tool_identity() -> NativeActionInputIdentityV1:
    var identity = _setup_identity()
    val external_dir = ACTION_IDENTITY_ROOT + "-external"
    expect(dir_create_all(external_dir)).to_be(true)
    val external_tool = external_dir + "/simple"
    expect(file_write(external_tool, "#!/bin/sh\nexit 0\n")).to_be(true)
    val (_, _, status) = process_run_bounded_direct("/bin/chmod", ["700", external_tool], 1000, 1024)
    expect(status).to_equal(0)
    match path_final_existing(external_tool):
        case Ok(resolved): identity.tool_path = resolved.path
        case Err(message): fail("external fixture identity unavailable: " + message)
    identity

fn _current_identity_error(identity: NativeActionInputIdentityV1) -> text:
    native_action_input_error_v1(
        ACTION_IDENTITY_ROOT, ACTION_IDENTITY_ROOT + "/build/target_cache/app",
        "//app:main", "P1", "B3", "src/main.spl", "binary",
        identity.tool_artifact_digest, identity)

describe "external native compiler identity":
    it "round trips an immutable external executable without weakening source paths":
        val identity = _external_tool_identity()
        expect(declared_path_valid(identity.tool_path)).to_be(false)
        expect(native_tool_receipt_path_v1(ACTION_IDENTITY_ROOT, identity.tool_path)).to_equal(identity.tool_path)
        val parsed = parse_native_action_input_receipt_v1(native_action_input_receipt_text_v1(identity))
        expect(parsed.errors.len()).to_equal(0)
        expect(_current_identity_error(parsed)).to_equal("")

    it "retains the existing repository-relative tool contract":
        val identity = _setup_identity()
        expect(native_tool_absolute_path_v1(ACTION_IDENTITY_ROOT, identity.tool_path)).to_equal(ACTION_IDENTITY_ROOT + "/build/tools/simple")
        expect(_current_identity_error(identity)).to_equal("")

    it "rejects malformed external spellings and unsupported relative paths":
        for path in ["/", "/tmp//simple", "/tmp/./simple", "/tmp/../simple", "/tmp/simple/", "/tmp/simple\n", "/tmp/simple\r", "/tmp/simple\0", "/tmp/a|b", "/tmp/a\\b", "../simple", "tools/simple"]:
            expect(native_tool_path_valid_v1(path)).to_be(false)

    it "rejects a missing external executable":
        var identity = _external_tool_identity()
        identity.tool_path = identity.tool_path + "/missing"
        expect(_current_identity_error(identity)).to_contain("current-tool-artifact-mismatch")

    it "rejects changed executable bytes with the original receipt":
        val identity = _external_tool_identity()
        expect(file_write(identity.tool_path, "#!/bin/sh\nexit 1\n")).to_be(true)
        expect(_current_identity_error(identity)).to_contain("current-tool-artifact-mismatch")

    it "rejects an external regular file without execute permission":
        val identity = _external_tool_identity()
        val (_, _, status) = process_run_bounded_direct("/bin/chmod", ["600", identity.tool_path], 1000, 1024)
        expect(status).to_equal(0)
        expect(_current_identity_error(identity)).to_contain("current-tool-artifact-mismatch")

    it "rejects a receipt that names a symlink instead of the canonical executable":
        var identity = _external_tool_identity()
        val alias = identity.tool_path + "-alias"
        val (_, _, status) = process_run_bounded_direct("/bin/ln", ["-sf", identity.tool_path, alias], 1000, 1024)
        expect(status).to_equal(0)
        identity.tool_path = alias
        expect(_current_identity_error(identity)).to_contain("current-tool-artifact-mismatch")

describe "independent current native action identity":
    # MBH-NFR-001: canonical current inputs produce deterministic identities.
    # @manual scenario evidence
    it "binds current tool manifest imported closure and expected action key":
        # @req REQ-SSPEC-APP
        step("binds current tool manifest imported closure and expected action key")
        val identity = _setup_identity()
        val body = native_action_input_receipt_text_v1(identity)
        val parsed = parse_native_action_input_receipt_v1(body)
        expect(parsed.errors.len()).to_equal(0)
        expect(native_action_input_error_v1(
            ACTION_IDENTITY_ROOT, ACTION_IDENTITY_ROOT + "/build/target_cache/app",
            "//app:main", "P1", "B3", "src/main.spl", "binary",
            identity.tool_artifact_digest, parsed
        )).to_equal("")

    it "rejects historical input evidence for a different current tool":
        # @req REQ-SSPEC-APP
        step("rejects historical input evidence for a different current tool")
        val identity = _setup_identity()
        expect(native_action_input_error_v1(
            ACTION_IDENTITY_ROOT, ACTION_IDENTITY_ROOT + "/build/target_cache/app",
            "//app:main", "P1", "B3", "src/main.spl", "binary",
            sha256_text("different-current-tool"), identity
        )).to_contain("current-tool-artifact-mismatch")

    it "loads only the compiler-authored canonical current receipt":
        # @req REQ-SSPEC-APP
        step("loads only the compiler-authored canonical current receipt")
        val identity = _setup_identity()
        val cache_dir = ACTION_IDENTITY_ROOT + "/build/target_cache/app"
        expect(dir_create_all(cache_dir + "/inputs")).to_be(true)
        expect(file_write(
            cache_dir + "/inputs/current.receipt",
            native_action_input_receipt_text_v1(identity)
        )).to_be(true)
        val loaded = load_current_native_action_input_v1(
            ACTION_IDENTITY_ROOT, cache_dir, "//app:main", "P1", "B3",
            "src/main.spl", "binary", identity.tool_artifact_digest
        )
        expect(loaded.errors.len()).to_equal(0)
        expect(loaded.action_key).to_equal(identity.action_key)

describe "aggregate action identity":
    it "length-frames variable action-key fields":
        step("Distinguish tuples that collide under delimiter concatenation")
        val dependency = sha256_text("dependency")
        val closure = sha256_text("closure")
        val tool = sha256_text("tool")
        val first = target_action_key_v1(
            "x|action=y", "z", "native", "llvm", "namespace",
            dependency, closure, tool, "binary"
        )
        val second = target_action_key_v1(
            "x", "y|action=z", "native", "llvm", "namespace",
            dependency, closure, tool, "binary"
        )
        expect(first == second).to_equal(false)

    it "binds product producer tool and dependency manifest canonically":
        # @req REQ-SSPEC-APP
        step("binds product producer tool and dependency manifest canonically")
        val tool = sha256_text("current-tool")
        val dependencies = sha256_text("dependency-manifest")
        val body = aggregate_action_identity_text_v1(
            "//product:p1", "P1", "B3", tool, dependencies
        )
        val digest = aggregate_action_identity_digest_v1(
            "//product:p1", "P1", "B3", tool, dependencies
        )
        expect(body).to_contain("target=//product:p1")
        expect(body).to_contain("dependency-manifest=" + dependencies)
        expect(digest_is_sha256(digest)).to_be(true)
        expect(aggregate_action_identity_digest_v1(
            "x\nproduct=y", "z", "llvm", tool, dependencies
        ) == aggregate_action_identity_digest_v1(
            "x", "y\nproduct=z", "llvm", tool, dependencies
        )).to_equal(false)
