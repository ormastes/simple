"""
## Purpose and audience
Purpose: Prove that spec behavior.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-BUILD-001 — stable requirement identity for this spec.

use app.build.targets.build_explain.{
    CompatibilityResult, BootstrapReason, DependencyIdentityV1,
    TargetDigestV1, TypedTargetEdgeV1, BuildExplainInputV1,
    compatibility_allows_reuse, decide_build_explain, format_build_explain
}

fn _input(digests: [TargetDigestV1], reason: BootstrapReason = BootstrapReason.None) -> BuildExplainInputV1:
    BuildExplainInputV1(
        "//product:app",
        ["//lib:base", "//provider:fmt", "//product:app", "//other:unused"],
        [
            TypedTargetEdgeV1("//provider:fmt", "//lib:base", DependencyIdentityV1.CompileInterface),
            TypedTargetEdgeV1("//product:app", "//provider:fmt", DependencyIdentityV1.Runtime)
        ],
        digests,
        reason,
        "simple-selfhosted:test",
        ["simple.cli.command/1"]
    )

fn _contains(values: [text], value: text) -> bool:
    var i = 0
    while i < values.len():
        if values[i] == value:
            return true
        i = i + 1
    false

use std.spec.step

describe "build explain typed-edge scheduler":
    it "stops propagation when the edge identity is unchanged":
        step("Verify: stops propagation when the edge identity is unchanged")
        # @req: REQ-APP-BUILD-001
        val input = _input([
            TargetDigestV1("//lib:base", DependencyIdentityV1.Implementation, "old", "new"),
            TargetDigestV1("//lib:base", DependencyIdentityV1.CompileInterface, "api", "api")
        ])
        val decision = decide_build_explain(input)
        expect(decision.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(decision.selected_rebuild_closure.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(decision.selected_rebuild_closure[0]).to_equal("//lib:base")
        expect(_contains(decision.selected_rebuild_closure, "//provider:fmt")).to_equal(false)

    it "propagates changed identities through direct consumers only":
        step("Verify: propagates changed identities through direct consumers only")
        val input = _input([
            TargetDigestV1("//lib:base", DependencyIdentityV1.CompileInterface, "v1", "v2"),
            TargetDigestV1("//provider:fmt", DependencyIdentityV1.Runtime, "r1", "r2")
        ])
        val decision = decide_build_explain(input)
        expect(decision.selected_rebuild_closure.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(decision.selected_rebuild_closure[0]).to_equal("//lib:base")
        expect(decision.selected_rebuild_closure[1]).to_equal("//product:app")
        expect(decision.selected_rebuild_closure[2]).to_equal("//provider:fmt")
        expect(decision.compatibility == CompatibilityResult.Incompatible).to_equal(true)
        expect(decision.changed_interface_groups[0]).to_equal("simple.cli.command/1")
        expect(decision.relevant_digest_deltas.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(decision.cache_reused_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(decision.cache_rebuilt_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(decision.cache_evidence_available).to_equal(false)

    it "treats missing edge digest evidence as unknown and rebuilds":
        step("Verify: treats missing edge digest evidence as unknown and rebuilds")
        val input = _input([
            TargetDigestV1("//lib:base", DependencyIdentityV1.Implementation, "old", "new")
        ])
        val decision = decide_build_explain(input)
        expect(_contains(decision.selected_rebuild_closure, "//provider:fmt")).to_equal(true)
        expect(_contains(decision.selected_rebuild_closure, "//product:app")).to_equal(true)
        expect(decision.compatibility == CompatibilityResult.Unknown).to_equal(true)
        expect(compatibility_allows_reuse(decision.compatibility)).to_equal(false)

    it "ignores dirty targets outside the requested dependency closure":
        step("Verify: ignores dirty targets outside the requested dependency closure")
        val input = _input([
            TargetDigestV1("//other:unused", DependencyIdentityV1.Implementation, "a", "b")
        ])
        val decision = decide_build_explain(input)
        expect(decision.selected_rebuild_closure.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(decision.compatibility == CompatibilityResult.Exact).to_equal(true)

describe "build explain bootstrap policy":
    it "does not permit a reason on an ordinary feature target":
        step("Verify: does not permit a reason on an ordinary feature target")
        val input = _input([], BootstrapReason.SeedMissing)
        val decision = decide_build_explain(input)
        expect(decision.errors[0]).to_equal("build-explain-error: bootstrap-reason-for-non-bootstrap-target")
        expect(decision.bootstrap_required).to_equal(false)

    it "requires a reason only on explicit bootstrap or release targets":
        step("Verify: requires a reason only on explicit bootstrap or release targets")
        val input = BuildExplainInputV1(
            "//release:convergence", ["//release:convergence"], [], [],
            BootstrapReason.None, "simple-selfhosted:test", []
        )
        val decision = decide_build_explain(input)
        expect(decision.bootstrap_required).to_equal(true)
        expect(decision.errors[0]).to_equal("build-explain-error: bootstrap-reason-required")

    it "accepts an explicit release reason and renders deterministic evidence":
        step("Verify: accepts an explicit release reason and renders deterministic evidence")
        val input = BuildExplainInputV1(
            "//release:ddc", ["//release:ddc"], [], [],
            BootstrapReason.DiverseDoubleCompilation, "simple-selfhosted:test", []
        )
        val decision = decide_build_explain(input)
        expect(decision.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(format_build_explain(decision)).to_contain("bootstrap=diverse-double-compilation")
        expect(format_build_explain(decision)).to_contain("bootstrap-required=true")
