use app.build.targets.build_explain.{BootstrapReason}
use app.build.targets.bootstrap_policy.{
    BOOTSTRAP_STAGE3_TARGET_V2, BOOTSTRAP_STAGE4_TARGET_V2,
    bootstrap_reason_from_name, bootstrap_reason_is_explicit,
    bootstrap_authorization_receipt_v2
}

describe "typed bootstrap authorization policy v2":
    val h = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

    it "rejects None and unknown reason names":
        expect(bootstrap_reason_is_explicit(BootstrapReason.None)).to_be(false)
        expect(bootstrap_reason_from_name("none") == BootstrapReason.None).to_be(true)
        expect(bootstrap_reason_from_name("provider-private-change") == BootstrapReason.None).to_be(true)

    it "emits one hash-bound Stage 4 authorization":
        val receipt = bootstrap_authorization_receipt_v2(
            BOOTSTRAP_STAGE4_TARGET_V2, BootstrapReason.SelfHostConvergenceCheck,
            h, h, h, h
        )
        expect(receipt).to_equal(
            "simple-bootstrap-authorization-v2|producer=simple-build-planner-v2|target=//bootstrap:stage4|reason=self-host-convergence-check|parent_sha256=" + h + "|runtime_sha256=" + h + "|source_closure_sha256=" + h + "|planner_sha256=" + h
        )

    it "keeps reasons stage scoped and targets exact":
        expect(bootstrap_authorization_receipt_v2(
            BOOTSTRAP_STAGE3_TARGET_V2, BootstrapReason.SeedMissing, h, h, h, h
        ).len()).to_be_greater_than(0)
        expect(bootstrap_authorization_receipt_v2(
            BOOTSTRAP_STAGE4_TARGET_V2, BootstrapReason.SeedMissing, h, h, h, h
        )).to_equal("")
        expect(bootstrap_authorization_receipt_v2(
            "//bootstrap:stage2", BootstrapReason.SeedMissing, h, h, h, h
        )).to_equal("")
        expect(bootstrap_authorization_receipt_v2(
            "//release:trust", BootstrapReason.ReleaseTrustVerification, h, h, h, h
        )).to_equal("")

    it "rejects missing malformed and uppercase hashes":
        expect(bootstrap_authorization_receipt_v2(
            BOOTSTRAP_STAGE4_TARGET_V2, BootstrapReason.SelfHostConvergenceCheck,
            "", h, h, h
        )).to_equal("")
        expect(bootstrap_authorization_receipt_v2(
            BOOTSTRAP_STAGE4_TARGET_V2, BootstrapReason.SelfHostConvergenceCheck,
            "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", h, h, h
        )).to_equal("")
