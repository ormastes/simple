use app.build.signed_build_artifact_snapshot.{
    snapshot_signed_build_artifact_v2}
use app.io.mod.{cwd, dir_create_all, file_write_bytes, file_read_bytes,
    getpid, time_now_unix_micros}
use std.common.crypto.sha256.{sha256_u8_hex}

describe "binary signed-build snapshot":
    it "preserves non-text artifact bytes for the consuming job":
        val root = cwd() + "/build/test/signed-build-binary-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val source = root + "/downloaded"
        val bytes: [u8] = [0u8, 255u8, 65u8, 10u8]
        expect(file_write_bytes(source, bytes)).to_be(true)
        val copied = snapshot_signed_build_artifact_v2(source, root, 1024)
        expect(copied.ready).to_be(true)
        expect(copied.length).to_equal(4)
        expect(copied.digest).to_equal(sha256_u8_hex(bytes))
        expect(file_read_bytes(copied.snapshot_path)).to_equal(bytes)
