use std.spec.{describe, it, expect}
use app.build.submodule_git_adapter.{
    submodule_remote_tree_has_nested_or_invalid_v1,
    parse_submodule_policy_v1}

val PIN = "19553c58b7c933fea5affa2273d3b624ecc66099"
val POLICY = "selected_submodule .spipe/spipe:\n" +
    "    pin: " + PIN + "\n" +
    "    url: https://github.com/ormastes/Spipe.git\n" +
    "    role: test-pipeline\n" +
    "    required: true\n" +
    "    provenance: parent-tree-gitlink-and-gitmodules\n" +
    "    canary: README.md\n" +
    "    branch: refs/heads/main\n" +
    "    reachability: unverified\n"

describe "fetched submodule tree closure":
    it "accepts a complete leaf-only tree listing":
        val listing = "100644 blob " + PIN + "\tREADME.md\n" +
            "100755 blob " + PIN + "\tscripts/check.shs\n" +
            "120000 blob " + PIN + "\tlink\n"
        expect(submodule_remote_tree_has_nested_or_invalid_v1(listing)).to_be(false)

    it "rejects selected transitive gitlinks and malformed output":
        val nested = "100644 blob " + PIN + "\tREADME.md\n" +
            "160000 commit " + PIN + "\tvendor/child\n"
        expect(submodule_remote_tree_has_nested_or_invalid_v1(nested)).to_be(true)
        expect(submodule_remote_tree_has_nested_or_invalid_v1("bad tree row\n")).to_be(true)
        expect(submodule_remote_tree_has_nested_or_invalid_v1("")).to_be(true)

describe "bounded selected policy parsing":
    it "accepts the declared reachability field":
        expect(parse_submodule_policy_v1(POLICY).len()).to_equal(1)

    it "rejects duplicate, unknown, and conflicting fields":
        expect(parse_submodule_policy_v1(POLICY +
            "    pin: " + PIN + "\n").len()).to_equal(0)
        expect(parse_submodule_policy_v1(POLICY +
            "    branch: refs/heads/other\n").len()).to_equal(0)
        expect(parse_submodule_policy_v1(POLICY +
            "    fetch_by_default: false\n").len()).to_equal(0)
        expect(parse_submodule_policy_v1(POLICY.replace(
            "provenance:", "provenance :")).len()).to_equal(0)
        expect(parse_submodule_policy_v1(POLICY.replace(
            "refs/heads/main", "refs/heads/../main")).len()).to_equal(0)
