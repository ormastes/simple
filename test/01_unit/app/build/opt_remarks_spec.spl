# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Tests for app.build.opt_remarks
# Covers parse_opt_remarks and opt_remark_config_disabled.

use std.spec.step

use app.build.opt_remarks.{

    OptRemarkConfig,
    opt_remark_config_disabled,
    parse_opt_remarks
}

describe "app.build.opt_remarks":
    # @manual scenario evidence

    describe "opt_remark_config_disabled":

        it "returns all-false config":
            # @req REQ-SSPEC-UNIT
            step("returns all-false config")
            val cfg = opt_remark_config_disabled()
            expect(cfg.cipher_enabled).to_equal(false)
            expect(cfg.simd_enabled).to_equal(false)

    describe "parse_opt_remarks":

        it "parses 'cipher' => cipher enabled":
            # @req REQ-SSPEC-UNIT
            step("parses 'cipher' => cipher enabled")
            val cfg = parse_opt_remarks("cipher")
            expect(cfg.cipher_enabled).to_equal(true)
            expect(cfg.simd_enabled).to_equal(false)

        it "parses 'simd' => simd enabled":
            # @req REQ-SSPEC-UNIT
            step("parses 'simd' => simd enabled")
            val cfg = parse_opt_remarks("simd")
            expect(cfg.cipher_enabled).to_equal(false)
            expect(cfg.simd_enabled).to_equal(true)

        it "parses 'cipher,simd' => both enabled":
            # @req REQ-SSPEC-UNIT
            step("parses 'cipher,simd' => both enabled")
            val cfg = parse_opt_remarks("cipher,simd")
            expect(cfg.cipher_enabled).to_equal(true)
            expect(cfg.simd_enabled).to_equal(true)

        it "parses empty string => all disabled":
            # @req REQ-SSPEC-UNIT
            step("parses empty string => all disabled")
            val cfg = parse_opt_remarks("")
            expect(cfg.cipher_enabled).to_equal(false)
            expect(cfg.simd_enabled).to_equal(false)

        it "is whitespace tolerant around categories":
            # @req REQ-SSPEC-UNIT
            step("is whitespace tolerant around categories")
            val cfg = parse_opt_remarks(" cipher , simd ")
            expect(cfg.cipher_enabled).to_equal(true)
            expect(cfg.simd_enabled).to_equal(true)

        it "ignores unrecognised categories":
            # @req REQ-SSPEC-UNIT
            step("ignores unrecognised categories")
            val cfg = parse_opt_remarks("cipher,future-category")
            expect(cfg.cipher_enabled).to_equal(true)
            expect(cfg.simd_enabled).to_equal(false)

        it "parses whitespace-only string as all disabled":
            # @req REQ-SSPEC-UNIT
            step("parses whitespace-only string as all disabled")
            val cfg = parse_opt_remarks("   ")
            expect(cfg.cipher_enabled).to_equal(false)
            expect(cfg.simd_enabled).to_equal(false)
