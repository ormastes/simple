"""
## Purpose and audience
Purpose: Prove that the build-side backend provider admission
(`admit_backend_provider`) and the compiler-side V1 backend plugin contract
(`compiler.common.backend_plugin`) share one source of truth: the same ABI
version is accepted/refused and the same capability vocabulary is used.
Audience: compiler and tooling engineers who maintain backend providers.
"""
# @req: REQ-APP-BUILD-001 — backend admission linked to 70.backend plugin ABI (plan §6).

use app.build.targets.build_targets.{
    BackendProviderDescriptor, admit_backend_provider,
    BACKEND_PROVIDER_ABI_VERSION, backend_provider_capability_names
}
use compiler.common.backend_plugin.model.{BACKEND_PLUGIN_ABI_VERSION_V1, BackendCapability}
use std.spec.step

val HOST = "x86_64-unknown-linux-gnu"

fn _desc(abi: i64, caps: [text]) -> BackendProviderDescriptor:
    BackendProviderDescriptor(group: "backends_c", abi_version: abi, host_triple: HOST, capabilities: caps)

describe "backend provider admission link to compiler V1 plugin ABI":
    it "uses the compiler-side V1 ABI version":
        step("Verify: build-side ABI constant equals the V1 plugin ABI")
        expect(BACKEND_PLUGIN_ABI_VERSION_V1).to_equal(1)
        expect(BACKEND_PROVIDER_ABI_VERSION).to_equal(1)

    it "accepts the V1 ABI and refuses the next one":
        expect(admit_backend_provider(_desc(BACKEND_PLUGIN_ABI_VERSION_V1, ["object_emit"]), HOST, ["object_emit"])).to_equal("")
        expect(admit_backend_provider(_desc(BACKEND_PLUGIN_ABI_VERSION_V1 + 1, ["object_emit"]), HOST, ["object_emit"]).contains("abi-mismatch")).to_equal(true)

    it "exposes exactly the compiler capability vocabulary":
        val names = backend_provider_capability_names()
        expect(names.len()).to_equal(6)
        expect(names.contains(BackendCapability.JitExecute.name())).to_equal(true)
        expect(names.contains(BackendCapability.ObjectEmit.name())).to_equal(true)
        expect(names.contains(BackendCapability.DebugInfo.name())).to_equal(true)
        expect(names.contains(BackendCapability.Optimization.name())).to_equal(true)
        expect(names.contains(BackendCapability.CrossTarget.name())).to_equal(true)
        expect(names.contains(BackendCapability.IncrementalCompilation.name())).to_equal(true)

    it "refuses a declared capability outside the vocabulary":
        val v = admit_backend_provider(_desc(BACKEND_PROVIDER_ABI_VERSION, ["object_emit", "gpu"]), HOST, ["object_emit"])
        expect(v == "SPL-PROVIDER-ABI-001: backend-admission: unknown-capability: backends_c: gpu").to_equal(true)

    it "refuses a required capability outside the vocabulary":
        val v = admit_backend_provider(_desc(BACKEND_PROVIDER_ABI_VERSION, ["object_emit"]), HOST, ["codegen"])
        expect(v == "SPL-PROVIDER-ABI-001: backend-admission: unknown-capability: backends_c: codegen").to_equal(true)
