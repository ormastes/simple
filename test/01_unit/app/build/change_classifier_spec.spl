"""
## Purpose and audience
Purpose: Prove that named target change classifier matrix.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-BUILD-001 — stable requirement identity for this spec.

use app.build.targets.build_explain.{CompatibilityResult, BootstrapReason}
use app.build.targets.change_classifier.{
    ChangeClassifierInputV1, ChangeClassV1, classify_change, format_change_decision
}
use app.build.targets.targets_cli.{format_target_change_explain}

fn input_v1() -> ChangeClassifierInputV1:
    ChangeClassifierInputV1(
        "//product:dev", [], [], false, false, false, false, false, false,
        CompatibilityResult.Exact, BootstrapReason.None,
        "//provider:fmt", "//core:simple", "//config:default_sci"
    )

use std.spec.step

describe "named target change classifier matrix":
    it "routes app alias configuration only to SCI work":
        step("Verify: routes app alias configuration only to SCI work")
        # @req: REQ-APP-BUILD-001
        var input = input_v1()
        input.changed_files = ["config/apps.sdn"]
        input.changed_config_sections = ["apps", "aliases"]
        val result = classify_change(input)
        expect(result.classes[0]).to_equal(ChangeClassV1.ConfigurationOnly)
        expect(result.affected_targets).to_equal(["//config:default_sci"])
        expect(result.core_binary_changed).to_equal(false)
        expect(result.bootstrap_required).to_equal(false)
        expect(result.planned_work.modules_parsed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.planned_work.links_performed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.planned_work.sci_sections_regenerated).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "routes a body-only delta to its provider without linking core":
        step("Verify: routes a body-only delta to its provider without linking core")
        var input = input_v1()
        input.implementation_changed = true
        val result = classify_change(input)
        expect(result.classes[0]).to_equal(ChangeClassV1.ProviderImplementation)
        expect(result.affected_targets).to_equal(["//provider:fmt"])
        expect(result.planned_work.providers_packaged).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(result.planned_work.links_performed).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.core_binary_changed).to_equal(false)

    it "routes a core ABI break to core with a typed bootstrap reason":
        step("Verify: routes a core ABI break to core with a typed bootstrap reason")
        var input = input_v1()
        input.core_abi_changed = true
        val result = classify_change(input)
        expect(result.classes[0]).to_equal(ChangeClassV1.CoreAbi)
        expect(result.affected_targets).to_equal(["//core:simple"])
        expect(result.core_binary_changed).to_equal(true)
        expect(result.bootstrap_required).to_equal(true)
        expect(result.bootstrap_reason).to_equal(BootstrapReason.BootstrapCoreInterfaceMajorChanged)

    it "never treats Unknown compiler compatibility as reuse":
        step("Verify: never treats Unknown compiler compatibility as reuse")
        var input = input_v1()
        input.admitted_compiler_compatibility = CompatibilityResult.Unknown
        val result = classify_change(input)
        expect(result.classes[0]).to_equal(ChangeClassV1.UnknownCompatibility)
        expect(result.affected_targets).to_equal(["//product:dev"])
        expect(result.planned_work.cache_hits).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.planned_work.cache_misses).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "classifies interface ABI semantic and tool deltas conservatively":
        step("Verify: classifies interface ABI semantic and tool deltas conservatively")
        var input = input_v1()
        input.compile_interface_changed = true
        input.abi_changed = true
        input.compile_semantic_changed = true
        input.tool_behavior_changed = true
        val result = classify_change(input)
        expect(result.classes).to_contain(ChangeClassV1.CompileInterface)
        expect(result.classes).to_contain(ChangeClassV1.AbiInterface)
        expect(result.classes).to_contain(ChangeClassV1.CompileSemantic)
        expect(result.classes).to_contain(ChangeClassV1.ToolBehavior)
        expect(result.affected_targets).to_equal(["//product:dev"])
        expect(result.bootstrap_required).to_equal(false)

    it "never selects a bootstrap action with reason None":
        step("Verify: never selects a bootstrap action with reason None")
        var input = input_v1()
        input.requested_target = "//bootstrap:selfhost"
        input.admitted_compiler_compatibility = CompatibilityResult.Unknown
        val result = classify_change(input)
        expect(result.bootstrap_required).to_equal(false)
        expect(result.bootstrap_reason).to_equal(BootstrapReason.None)
        expect(result.affected_targets.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(result.errors).to_contain("change-classifier-error: bootstrap-target-with-none")

    it "requires an explicit non-None trust reason for trust bootstrap":
        step("Verify: requires an explicit non-None trust reason for trust bootstrap")
        var input = input_v1()
        input.explicit_trust_reason = BootstrapReason.ReleaseTrustVerification
        val result = classify_change(input)
        expect(result.bootstrap_required).to_equal(true)
        expect(result.bootstrap_reason).to_equal(BootstrapReason.ReleaseTrustVerification)
        expect(result.errors.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "formats planned unknown counters without claiming execution":
        step("Verify: formats planned unknown counters without claiming execution")
        var input = input_v1()
        input.implementation_changed = true
        val rendered = format_target_change_explain(classify_change(input))
        expect(rendered).to_contain("evidence=planned")
        expect(rendered).to_contain("modules-parsed=-1")
        expect(rendered).to_contain("bootstrap-reason=none")
