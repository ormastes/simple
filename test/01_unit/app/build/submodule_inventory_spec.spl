use std.spec.{describe, it, expect}
use app.build.submodule_inventory.{
    SelectedGitlinkV1, SubmoduleDeclarationV1, SubmodulePolicyV1,
    PinReachabilityV1, SubmoduleExceptionV1, selected_submodule_inventory_v1
}

val SPIPE_PATH = ".spipe/spipe"
val SPIPE_PIN = "19553c58b7c933fea5affa2273d3b624ecc66099"
val SPIPE_URL = "https://github.com/ormastes/Spipe.git"
val CUDA_PATH = "examples/08_gpu/simple_cuda_example"
val CUDA_PIN = "e74405599b8ac4b5649258dc397af5b3ef4d508b"
val CUDA_URL = "https://github.com/ormastes/simple_cuda_example.git"
val BRANCH = "refs/heads/main"
val SPIPE_TIP = "64a6e216a0614c98b4a2c93378c995a12ed742b7"
val CUDA_TIP = "b58990d9e5642437a32631c5ef0c36cf8b4ca7b0"

fn _links() -> [SelectedGitlinkV1]:
    [SelectedGitlinkV1(SPIPE_PATH, SPIPE_PIN), SelectedGitlinkV1(CUDA_PATH, CUDA_PIN)]

fn _declarations() -> [SubmoduleDeclarationV1]:
    [
        SubmoduleDeclarationV1(SPIPE_PATH, SPIPE_URL),
        SubmoduleDeclarationV1(CUDA_PATH, CUDA_URL),
        SubmoduleDeclarationV1("examples/07_ml/svllm", "https://github.com/ormastes/svllm.git")
    ]

fn _policies() -> [SubmodulePolicyV1]:
    [
        SubmodulePolicyV1(SPIPE_PATH, SPIPE_PIN, SPIPE_URL, "test-pipeline",
            true, "ormastes/Spipe upstream", "spipe-manifest", BRANCH),
        SubmodulePolicyV1(CUDA_PATH, CUDA_PIN, CUDA_URL, "independent-example",
            false, "ormastes/simple_cuda_example upstream", "cuda-example-manifest",
            BRANCH)
    ]

fn _observations() -> [PinReachabilityV1]:
    [
        PinReachabilityV1(SPIPE_PATH, SPIPE_PIN, SPIPE_URL,
            "ormastes/Spipe upstream", "spipe-manifest", true, true, true,
            BRANCH, SPIPE_TIP, true),
        PinReachabilityV1(CUDA_PATH, CUDA_PIN, CUDA_URL,
            "ormastes/simple_cuda_example upstream", "cuda-example-manifest",
            true, true, true, BRANCH, CUDA_TIP, true)
    ]

describe "selected submodule inventory":
    it "uses only parent gitlinks and keeps independent examples out of default fetch":
        val result = selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), _observations(), [])
        expect(result.status).to_equal("STRUCTURAL_ONLY")
        expect(result.selected.len()).to_equal(2)
        expect(result.selected[0].pin).to_equal(SPIPE_PIN)
        expect(result.selected[0].fetch_by_default).to_equal(true)
        expect(result.selected[1].pin).to_equal(CUDA_PIN)
        expect(result.selected[1].fetch_by_default).to_equal(false)
        expect(result.selected[0].approved_branch).to_equal(BRANCH)

    it "rejects parent pin changes until policy and evidence match":
        var links = _links()
        links[1].pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        val result = selected_submodule_inventory_v1(
            links, _declarations(), _policies(), _observations(), [])
        expect(result.status).to_equal("REJECT")
        expect(result.reason).to_equal("policy-pin-mismatch")

    it "requires declaration URL and complete policy for each selected path":
        var declarations = _declarations()
        declarations[0].url = "https://github.com/other/Spipe.git"
        expect(selected_submodule_inventory_v1(
            _links(), declarations, _policies(), _observations(), []
        ).reason).to_equal("policy-url-mismatch")
        var policies = _policies()
        policies[0].canary = ""
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), policies, _observations(), []
        ).reason).to_equal("incomplete-policy")
        policies = _policies()
        policies[0].approved_branch = "refs/heads/main..other"
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), policies, _observations(), []
        ).reason).to_equal("incomplete-policy")

    it "rejects absent and mismatched clean remote reachability evidence":
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), [], []
        ).reason).to_equal("missing-or-duplicate-reachability")
        var observations = _observations()
        observations[0].clean_remote_fetch = false
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), observations, []
        ).reason).to_equal("pin-reachability-unverified")
        observations = _observations()
        observations[1].pin_reachable = false
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), observations, []
        ).reason).to_equal("pin-reachability-unverified")
        observations = _observations()
        observations[1].branch_ancestor_verified = false
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), observations, []
        ).reason).to_equal("pin-reachability-unverified")
        observations = _observations()
        observations[1].branch_ref = "refs/heads/other"
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), _policies(), observations, []
        ).reason).to_equal("pin-reachability-unverified")

    it "rejects stale scoped exceptions after the selected pin changes":
        val old_exception = [SubmoduleExceptionV1(
            CUDA_PATH, CUDA_PIN, "gpu-example-smoke", "temporarily skip optional smoke")]
        var links = _links()
        links[1].pin = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        var policies = _policies()
        policies[1].pin = links[1].pin
        var observations = _observations()
        observations[1].pin = links[1].pin
        expect(selected_submodule_inventory_v1(
            links, _declarations(), policies, observations, old_exception
        ).reason).to_equal("stale-or-unselected-exception")

    it "rejects policy for dormant declarations and duplicate selected gitlinks":
        var policies = _policies()
        policies.push(SubmodulePolicyV1("examples/07_ml/svllm",
            "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "https://github.com/ormastes/svllm.git", "independent-example", false,
            "ormastes/svllm upstream", "svllm-manifest", BRANCH))
        expect(selected_submodule_inventory_v1(
            _links(), _declarations(), policies, _observations(), []
        ).reason).to_equal("policy-for-unselected-path")
        var links = _links()
        links.push(SelectedGitlinkV1(CUDA_PATH, CUDA_PIN))
        expect(selected_submodule_inventory_v1(
            links, _declarations(), _policies(), _observations(), []
        ).reason).to_equal("duplicate-gitlink")
