"""
## Purpose and audience
Purpose: Prove that a successful backend provider admission produces a receipt
(plan §6), that the receipt round-trips through SDN, and that re-admission
against a stored receipt refuses with SPL-PROVIDER-ABI-001 on any mismatch
(artifact sha, ABI, host triple, capabilities).
Audience: compiler and tooling engineers who maintain backend build groups.
"""
# @req: REQ-APP-BUILD-001 — backend provider admission receipt (plan §6).

use app.build.targets.build_targets.{BackendProviderDescriptor, BACKEND_PROVIDER_ABI_VERSION}
use app.build.targets.provider_receipt.{
    ProviderAdmissionReceipt, issue_provider_receipt, provider_receipt_to_sdn,
    provider_receipt_from_sdn, verify_provider_receipt
}
use std.spec.step

val HOST = "x86_64-unknown-linux-gnu"
val ART = "provider-artifact-bytes-v1"

fn _desc(abi: i64, triple: text, caps: [text]) -> BackendProviderDescriptor:
    BackendProviderDescriptor(group: "backends_cuda", abi_version: abi, host_triple: triple, capabilities: caps)

fn _issued() -> ProviderAdmissionReceipt:
    val r = issue_provider_receipt(_desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["gpu", "codegen"]), HOST, ["codegen"], ART)
    r.unwrap()

describe "backend provider admission receipt":
    it "issues a receipt with real sha and records unavailable fields as absent":
        step("Verify: admission emits a receipt")
        val r = _issued()
        expect(r.group).to_equal("backends_cuda")
        expect(r.artifact_sha256.len()).to_equal(64)  # oracle: 64 hex chars of SHA-256
        expect(r.capabilities[0]).to_equal("codegen")  # oracle: sorted
        expect(r.absent_fields.contains("mir_abi_digest")).to_equal(true)

    it "refuses to issue a receipt for a non-admitted provider":
        val r = issue_provider_receipt(_desc(BACKEND_PROVIDER_ABI_VERSION + 1, HOST, ["codegen"]), HOST, ["codegen"], ART)
        expect(r.is_err()).to_equal(true)

    it "round-trips through SDN":
        val r = _issued()
        val back = provider_receipt_from_sdn(provider_receipt_to_sdn(r)).unwrap()
        expect(provider_receipt_to_sdn(back)).to_equal(provider_receipt_to_sdn(r))

    it "verifies a clean re-admission":
        val stored = provider_receipt_from_sdn(provider_receipt_to_sdn(_issued())).unwrap()
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen", "gpu"])
        expect(verify_provider_receipt(stored, d, HOST, ["codegen"], ART)).to_equal("")

    it "refuses a tampered artifact sha":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen", "gpu"])
        val v = verify_provider_receipt(_issued(), d, HOST, ["codegen"], ART + "x")
        expect(v.starts_with("SPL-PROVIDER-ABI-001: receipt-mismatch: artifact_sha256")).to_equal(true)

    it "refuses an ABI change":
        val r = _issued()
        val stored = ProviderAdmissionReceipt(group: r.group, abi_version: r.abi_version + 1, host_triple: r.host_triple,
            capabilities: r.capabilities, artifact_sha256: r.artifact_sha256, absent_fields: r.absent_fields)
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen", "gpu"])
        expect(verify_provider_receipt(stored, d, HOST, ["codegen"], ART).starts_with("SPL-PROVIDER-ABI-001: receipt-mismatch: abi_version")).to_equal(true)

    it "refuses a host triple change":
        val r = _issued()
        val stored = ProviderAdmissionReceipt(group: r.group, abi_version: r.abi_version, host_triple: "aarch64-apple-darwin",
            capabilities: r.capabilities, artifact_sha256: r.artifact_sha256, absent_fields: r.absent_fields)
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen", "gpu"])
        expect(verify_provider_receipt(stored, d, HOST, ["codegen"], ART).starts_with("SPL-PROVIDER-ABI-001: receipt-mismatch: host_triple")).to_equal(true)

    it "refuses a capability change":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen"])
        expect(verify_provider_receipt(_issued(), d, HOST, ["codegen"], ART).starts_with("SPL-PROVIDER-ABI-001: receipt-mismatch: capabilities")).to_equal(true)

    it "propagates an admission refusal during verify":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION + 1, HOST, ["codegen", "gpu"])
        expect(verify_provider_receipt(_issued(), d, HOST, ["codegen"], ART).starts_with("SPL-PROVIDER-ABI-001: backend-admission: abi-mismatch")).to_equal(true)

    it "dedupes capabilities so duplicates do not mismatch":
        val r = _issued()
        val stored = ProviderAdmissionReceipt(group: r.group, abi_version: r.abi_version, host_triple: r.host_triple,
            capabilities: ["codegen", "codegen", "gpu"], artifact_sha256: r.artifact_sha256, absent_fields: r.absent_fields)
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen", "gpu"])
        expect(verify_provider_receipt(stored, d, HOST, ["codegen"], ART)).to_equal("")
        val dup = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["gpu", "codegen", "gpu"])
        val issued = issue_provider_receipt(dup, HOST, ["codegen"], ART).unwrap()
        expect(issued.capabilities.len()).to_equal(2)

    it "propagates a missing-capability refusal during verify with SPL-PROVIDER-ABI-001":
        val d = _desc(BACKEND_PROVIDER_ABI_VERSION, HOST, ["codegen"])
        expect(verify_provider_receipt(_issued(), d, HOST, ["codegen", "gpu"], ART).starts_with("SPL-PROVIDER-ABI-001: backend-admission: missing-capability")).to_equal(true)
