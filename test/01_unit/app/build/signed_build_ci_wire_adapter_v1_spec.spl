use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.build.gate_receipt.{GATE_RECEIPT_SCHEMA_V1,
    GateObservation, GateReceipt, gate_receipt_digest_v1}
use app.build.gate_receipt_wire_v1.{encode_gate_receipt_wire_v1}
use app.build.signed_build_admission.{SignedBuildExpectationV1,
    SignedBuildExpectationV2}
use app.build.signed_build_ci_observation.{SignedBuildCiObservationV1,
    verify_observed_signed_build_ci_candidate_v1}
use app.build.signed_build_ci_wire_adapter_v1.{
    verify_observed_signed_build_ci_wire_candidate_v1}
use app.build.signed_build_signature_provider.{SignedBuildSshProviderConfigV2}

val WIRE_BASE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val WIRE_HEAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val WIRE_TREE = "cccccccccccccccccccccccccccccccccccccccc"
val WIRE_POLICY = sha256_text("protected-policy")
val WIRE_CHECKER = sha256_text("base-checker")
val WIRE_SUBMODULES = sha256_text("selected-gitlinks")
val WIRE_MANIFEST = "must_check_gates |id, tier, push_blocking, mode, command, ci_job, inputs, description|\n" +
    "    compile, bootstrap, true, receipt, \"build\", -, -, \"compiler\"\n"

fn _wire_gate() -> GateReceipt:
    GateReceipt(GATE_RECEIPT_SCHEMA_V1, WIRE_BASE, WIRE_HEAD, WIRE_TREE,
        WIRE_POLICY, WIRE_CHECKER, WIRE_SUBMODULES, "protected-ci",
        ["compile"],
        [GateObservation("compile", "PASS", sha256_text("gate-run"), "")])

fn _wire_expected(gate: GateReceipt) -> SignedBuildExpectationV2:
    SignedBuildExpectationV2("simple-lang/simple", 42,
        SignedBuildExpectationV1(WIRE_BASE, WIRE_HEAD, WIRE_TREE,
            "", "", "", "", "", "", WIRE_SUBMODULES,
            WIRE_POLICY, WIRE_CHECKER, gate_receipt_digest_v1(gate),
            "", "", "", ""))

fn _wire_observed(merge_tree: text) -> SignedBuildCiObservationV1:
    SignedBuildCiObservationV1("simple-lang/simple", 42,
        WIRE_BASE, WIRE_HEAD, merge_tree, WIRE_TREE, WIRE_POLICY,
        WIRE_CHECKER, WIRE_SUBMODULES, sha256_text(WIRE_MANIFEST))

fn _wire_ssh() -> SignedBuildSshProviderConfigV2:
    SignedBuildSshProviderConfigV2("", "", "", "", "", "", "", "")

describe "signed build CI gate wire adapter":
    it "falls back without exposing either artifact path for invalid wire":
        val gate = _wire_gate()
        val result = verify_observed_signed_build_ci_wire_candidate_v1(
            _wire_observed(WIRE_TREE), "invalid signed receipt",
            "invalid signature", [1u8], _wire_expected(gate),
            WIRE_MANIFEST, sha256_text(WIRE_MANIFEST), "protected-ci",
            _wire_ssh(), "/missing/download", "/missing/private", 1024)
        expect(result.admission.decision).to_equal("FULL_BUILD")
        expect(result.admission.reason)
            .to_equal("ci-observation: invalid-gate-receipt-wire")
        expect(result.snapshot_root).to_equal("")
        expect(result.artifact_path).to_equal("")

    it "delegates decoded data to the existing protected observation check":
        val gate = _wire_gate()
        val observed = _wire_observed(
            "dddddddddddddddddddddddddddddddddddddddd")
        val expected = _wire_expected(gate)
        val direct = verify_observed_signed_build_ci_candidate_v1(
            observed, "invalid signed receipt", "invalid signature", gate,
            expected, WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        val from_wire = verify_observed_signed_build_ci_wire_candidate_v1(
            observed, "invalid signed receipt", "invalid signature",
            encode_gate_receipt_wire_v1(gate), expected, WIRE_MANIFEST,
            sha256_text(WIRE_MANIFEST), "protected-ci", _wire_ssh(),
            "/missing/download", "/missing/private", 1024)
        expect(from_wire.admission.decision).to_equal(direct.admission.decision)
        expect(from_wire.admission.reason).to_equal(direct.admission.reason)
        expect(from_wire.admission.reason)
            .to_equal("ci-observation: integration-candidate-changed")
        expect(from_wire.snapshot_root).to_equal(direct.snapshot_root)
        expect(from_wire.artifact_path).to_equal(direct.artifact_path)

    it "delegates valid current gates through to signed receipt rejection":
        val gate = _wire_gate()
        val observed = _wire_observed(WIRE_TREE)
        val expected = _wire_expected(gate)
        val direct = verify_observed_signed_build_ci_candidate_v1(
            observed, "invalid signed receipt", "invalid signature", gate,
            expected, WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        val from_wire = verify_observed_signed_build_ci_wire_candidate_v1(
            observed, "invalid signed receipt", "invalid signature",
            encode_gate_receipt_wire_v1(gate), expected, WIRE_MANIFEST,
            sha256_text(WIRE_MANIFEST), "protected-ci", _wire_ssh(),
            "/missing/download", "/missing/private", 1024)
        expect(from_wire.admission.decision).to_equal("FULL_BUILD")
        expect(from_wire.admission.decision).to_equal(direct.admission.decision)
        expect(from_wire.admission.reason).to_equal(direct.admission.reason)
        expect(from_wire.admission.reason).to_equal("signature: receipt-invalid")
        expect(from_wire.snapshot_root).to_equal(direct.snapshot_root)
        expect(from_wire.artifact_path).to_equal(direct.artifact_path)
        expect(from_wire.snapshot_root).to_equal("")
        expect(from_wire.artifact_path).to_equal("")

    it "does not replace protected expectations with submitted gate identities":
        val gate = _wire_gate()
        val submitted = GateReceipt(GATE_RECEIPT_SCHEMA_V1, WIRE_BASE,
            WIRE_HEAD, WIRE_TREE, WIRE_POLICY,
            sha256_text("candidate-checker"), WIRE_SUBMODULES,
            "protected-ci", ["compile"],
            [GateObservation("compile", "PASS", sha256_text("gate-run"), "")])
        val result = verify_observed_signed_build_ci_wire_candidate_v1(
            _wire_observed(WIRE_TREE), "invalid signed receipt",
            "invalid signature", encode_gate_receipt_wire_v1(submitted),
            _wire_expected(gate), WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        expect(result.admission.decision).to_equal("FULL_BUILD")
        expect(result.admission.reason)
            .to_equal("ci-observation: current-gate-observation-changed")
        expect(result.snapshot_root).to_equal("")
        expect(result.artifact_path).to_equal("")

    it "keeps duplicate, missing and failed gate rows on the full build path":
        var gate = _wire_gate()
        gate.observed = [
            GateObservation("compile", "PASS", sha256_text("first"), ""),
            GateObservation("compile", "PASS", sha256_text("second"), "")]
        val duplicate = verify_observed_signed_build_ci_wire_candidate_v1(
            _wire_observed(WIRE_TREE), "invalid signed receipt",
            "invalid signature", encode_gate_receipt_wire_v1(gate),
            _wire_expected(gate), WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        expect(duplicate.admission.decision).to_equal("FULL_BUILD")
        expect(duplicate.admission.reason)
            .to_equal("gates: mandatory-gates-INCOMPLETE")
        expect(duplicate.artifact_path).to_equal("")

        gate.observed = []
        val missing = verify_observed_signed_build_ci_wire_candidate_v1(
            _wire_observed(WIRE_TREE), "invalid signed receipt",
            "invalid signature", encode_gate_receipt_wire_v1(gate),
            _wire_expected(gate), WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        expect(missing.admission.decision).to_equal("FULL_BUILD")
        expect(missing.admission.reason)
            .to_equal("gates: mandatory-gates-INCOMPLETE")
        expect(missing.artifact_path).to_equal("")

        gate.observed = [GateObservation("compile", "FAIL",
            sha256_text("failed-run"), "compiler failed")]
        val failed = verify_observed_signed_build_ci_wire_candidate_v1(
            _wire_observed(WIRE_TREE), "invalid signed receipt",
            "invalid signature", encode_gate_receipt_wire_v1(gate),
            _wire_expected(gate), WIRE_MANIFEST, sha256_text(WIRE_MANIFEST),
            "protected-ci", _wire_ssh(), "/missing/download",
            "/missing/private", 1024)
        expect(failed.admission.decision).to_equal("FULL_BUILD")
        expect(failed.admission.reason).to_equal("gates: mandatory-gates-FAIL")
        expect(failed.artifact_path).to_equal("")
