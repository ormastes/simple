use app.build.sources_cli.{build_sources_output, run_build_sources}

describe "build sources CLI":
    it "defaults the library dir to current directory":
        expect(build_sources_output([], ["./b.spl", "a.spl"])).to_equal("a.spl\nb.spl\n")

    it "takes the first positional as the library dir":
        expect(build_sources_output(["src/lib"], ["src/lib/x.spl"])).to_equal("x.spl\n")

    it "strips trailing slash from the dir":
        expect(build_sources_output(["src/lib/"], ["src/lib/x.spl"])).to_equal("x.spl\n")

    it "rejects unknown flags with exit 2":
        expect(run_build_sources(["--bogus"])).to_equal(2)

    it "rejects more than one positional with exit 2":
        expect(run_build_sources(["a", "b"])).to_equal(2)

    it "rejects a missing directory with exit 2":
        expect(run_build_sources(["no/such/dir_rb4_lucli"])).to_equal(2)

    it "keeps only .spl, relative, sorted":
        val walked = ["lib/z.spl", "lib/a/b.spl", "lib/notes.md", "lib/a.spl"]
        expect(build_sources_output(["lib"], walked)).to_equal("a.spl\na/b.spl\nz.spl\n")

    it "drops duplicates and paths outside the dir":
        expect(build_sources_output(["lib"], ["lib/a.spl", "lib/a.spl", "other/x.spl"])).to_equal("a.spl\n")

    it "formats empty inventory as empty text":
        expect(build_sources_output(["lib"], [])).to_equal("")
