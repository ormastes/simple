use app.build.sources_cli.{build_sources_output, build_sources_output_for_manifest, run_build_sources, build_sources_lock_text, build_sources_wants_write_lock}
use app.io.dir_ops.{dir_create_all}
use app.io.file_ops.{file_atomic_write}
use app.io.mod.{file_read}
use app.io.env_ops.{cwd}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}

describe "build sources CLI":
    it "defaults the library dir to current directory":
        expect(build_sources_output([], ["./b.spl", "a.spl"])).to_equal("a.spl\nb.spl\n")

    it "takes the first positional as the library dir":
        expect(build_sources_output(["src/lib"], ["src/lib/x.spl"])).to_equal("x.spl\n")

    it "strips trailing slash from the dir":
        expect(build_sources_output(["src/lib/"], ["src/lib/x.spl"])).to_equal("x.spl\n")

    it "rejects unknown flags with exit 2":
        expect(run_build_sources(["--bogus"])).to_equal(2)

    it "rejects more than one positional with exit 2":
        expect(run_build_sources(["a", "b"])).to_equal(2)

    it "rejects a missing directory with exit 2":
        expect(run_build_sources(["no/such/dir_rb4_lucli"])).to_equal(2)

    it "keeps only .spl, relative, sorted":
        val walked = ["lib/z.spl", "lib/a/b.spl", "lib/notes.md", "lib/a.spl"]
        expect(build_sources_output(["lib"], walked)).to_equal("a.spl\na/b.spl\nz.spl\n")

    it "drops duplicates and paths outside the dir":
        expect(build_sources_output(["lib"], ["lib/a.spl", "lib/a.spl", "other/x.spl"])).to_equal("a.spl\n")

    it "formats empty inventory as empty text":
        expect(build_sources_output(["lib"], [])).to_equal("")

    it "accepts --digest alongside the dir":
        expect(build_sources_output(["--digest", "lib"], ["lib/a.spl"])).to_equal("a.spl\n")

    it "uses manifest include/exclude globs":
        val manifest = "project:\n  name: u\n  version: 1.0.0\n  type: library\n  sources:\n    include: [\"a/**/*.spl\"]\n    exclude: [\"a/skip/**\"]\n"
        val walked = ["lib/a/x.spl", "lib/a/skip/y.spl", "lib/b/z.spl"]
        val r = build_sources_output_for_manifest("lib", manifest, walked)
        expect(r.unwrap()).to_equal("a/x.spl\n")

    it "falls back to every .spl when the manifest is absent":
        val r = build_sources_output_for_manifest("lib", "", ["lib/b.spl", "lib/a/c.spl"])
        expect(r.unwrap()).to_equal("a/c.spl\nb.spl\n")

    it "surfaces an invalid manifest as an error":
        val r = build_sources_output_for_manifest("lib", "project:\n  name: u\n", ["lib/a.spl"])
        expect(r.is_err()).to_equal(true)

    it "exits 2 on an invalid manifest":
        expect(run_build_sources(["test/01_unit/app/build/fixtures/bad_manifest_unit"])).to_equal(2)

describe "build sources --write-lock":
    it "renders the drift-gate lock header then one path per line":
        val hdr = "# source_inventory.lock: every .spl under this unit (source_inventory_scan_v1), one path per line.\n"
        expect(build_sources_lock_text(["a.spl", "b/c.spl"])).to_equal(hdr + "a.spl\nb/c.spl\n")

    it "renders an empty unit as the header only":
        val hdr = "# source_inventory.lock: every .spl under this unit (source_inventory_scan_v1), one path per line.\n"
        expect(build_sources_lock_text([])).to_equal(hdr)

    it "detects the --write-lock flag":
        expect(build_sources_wants_write_lock(["--write-lock", "lib"])).to_equal(true)
        expect(build_sources_wants_write_lock(["lib"])).to_equal(false)

    it "accepts --write-lock alongside the dir":
        expect(build_sources_output(["--write-lock", "lib"], ["lib/a.spl"])).to_equal("a.spl\n")

    it "still rejects a missing directory with --write-lock":
        expect(run_build_sources(["--write-lock", "no/such/dir_rb4_lucli"])).to_equal(2)

    it "writes a lock that lists every .spl, ignoring manifest globs":
        val d = cwd() + "/build/test_tmp/wlock_{getpid()}"
        dir_create_all(d + "/keep")
        dir_create_all(d + "/skip")
        file_atomic_write(d + "/keep/a.spl", "fn a() -> i64: 0\n")
        file_atomic_write(d + "/skip/b.spl", "fn b() -> i64: 0\n")
        file_atomic_write(d + "/simple.sdn", "project:\n  name: u\n  version: 1.0.0\n  type: library\n  sources:\n    include: [\"keep/**/*.spl\"]\n")
        expect(run_build_sources(["--write-lock", d])).to_equal(0)
        expect(file_read(d + "/source_inventory.lock") ?? "").to_equal(build_sources_lock_text(["keep/a.spl", "skip/b.spl"]))
