use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1,
    run_distributed_build_attempt_v1, commit_fetched_distributed_reply_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_admit_v1, scheduler_owner_close_v1}
use app.build.scheduler.planner.{SchedulerActionV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1,
    scheduler_current_fence_v1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.trusted_result_download.{BuildResultFetchV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.parent_request_spool.{persist_parent_build_intent_v1,
    persist_parent_build_request_v1,
    recover_completed_parent_build_request_v1}
use app.build.scheduler.parent_cleanup_pending.{
    recover_parent_cleanup_pending_v1}
use app.build.scheduler.dispatch_wire.{encode_build_result_v1}
use app.build.scheduler.worker_failure_proof.{
    encode_build_worker_failure_proof_v1}
use app.io.mod.{cwd, dir_create_all, file_atomic_write, file_hash_sha256,
    file_exists,
    getpid, time_now_unix_micros}
use compiler.common.build_contract.{BuildInputRef, BuildDependencyRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    ActionResultCandidate, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

describe "parent distributed attempt admission":
    it "does not journal capacity when declared source bytes fail preflight":
        val root = cwd() + "/build/test/dist-attempt-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val source = root + "/source"
        expect(dir_create_all(source + "/src")).to_be(true)
        expect(file_atomic_write(source + "/src/answer.c", "changed\n"))
            .to_be(true)
        val ssh = root + "/ssh"
        val sftp = root + "/sftp"
        val hosts = root + "/known_hosts"
        val key = root + "/identity"
        expect(file_atomic_write(ssh, "fake ssh\n")).to_be(true)
        expect(file_atomic_write(sftp, "fake sftp\n")).to_be(true)
        expect(file_atomic_write(hosts,
            "node-a ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeTestOnly\n"))
            .to_be(true)
        expect(file_atomic_write(key, "fake key\n")).to_be(true)
        val node = TrustedSshNodeV1("node-a", "127.0.0.1", "builder", 2222,
            ssh, file_hash_sha256(ssh), hosts, file_hash_sha256(hosts),
            key, file_hash_sha256(key))
        val config = DistributedBuildNodeV1(
            TrustedWorkerCommandV1(node, "/usr/local/bin/simple-build-worker", 30000),
            TrustedSftpConfigV1(node, sftp, file_hash_sha256(sftp),
                "/srv/simple-build-inbox"),
            source, root, root + "/retained")
        val snapshot = sha256_text("dist snapshot")
        val action = ActionSpec(1, "compile",
            SnapshotManifest(1, snapshot, sha256_text("source"),
                sha256_text("submodules")),
            ToolchainManifest(1, sha256_text("compiler"),
                sha256_text("behavior"), sha256_text("abi"),
                sha256_text("runtime"), sha256_text("sysroot"),
                "x86_64-unknown-linux-gnu"),
            InputManifest(1, snapshot,
                [BuildInputRef("src/answer.c", sha256_text("original\n"))],
                [], [], [], [], [], sha256_text("context"), true, false),
            ["cc", "-c"], "src", sha256_text("sandbox"),
            ["answer.o"], sha256_text("resources"))
        val digest = action_spec_digest_v1(action)
        val scheduled = SchedulerActionV1(digest, action, [], 0, 0,
            1, 4096, 8)
        val capacity = SchedulerCapacityV1(2, 8192, 0, 16)
        val owner = scheduler_owner_open_v1(root + "/journal")
        expect(owner.error).to_equal("")
        val outcome = run_distributed_build_attempt_v1(owner,
            [scheduled], digest, "try-1", 0, config, capacity, 0)
        expect(outcome.completed).to_be(false)
        expect(outcome.reconciliation_required).to_be(false)
        expect(outcome.reason).to_equal("snapshot-source-digest-mismatch")
        expect(owner.state.ledger.attempts.len()).to_equal(0)
        expect(file_atomic_write(source + "/src/answer.c", "original\n"))
            .to_be(true)
        expect(file_atomic_write(source + "/answer.o", "substituted output"))
            .to_be(true)
        var inputs = action.inputs
        val producer = sha256_text("accepted producer that did not run")
        inputs.declared_dependency_actions = [producer]
        inputs.dependency_outputs = [BuildDependencyRef(producer, "answer.o",
            sha256_text("substituted output"))]
        var dependent = action
        dependent.inputs = inputs
        val dependent_digest = action_spec_digest_v1(dependent)
        val dependent_scheduled = SchedulerActionV1(dependent_digest,
            dependent, [producer], 0, 0, 1, 4096, 8)
        val unaccepted = run_distributed_build_attempt_v1(owner,
            [dependent_scheduled], dependent_digest, "try-2", 0,
            config, capacity, 0)
        expect(unaccepted.completed).to_be(false)
        expect(unaccepted.reconciliation_required).to_be(false)
        expect(unaccepted.reason).to_equal("dependency: producer-not-accepted")
        expect(owner.state.ledger.attempts.len()).to_equal(0)
        var other_action = action
        other_action.argv = ["cc", "-c", "other"]
        val other_digest = action_spec_digest_v1(other_action)
        val other_scheduled = SchedulerActionV1(other_digest,
            other_action, [], 0, 0, 1, 4096, 8)
        val running = scheduler_owner_admit_v1(owner,
            [scheduled, other_scheduled], digest, "try-running", "node-a",
            capacity, 0)
        expect(running.dispatch).to_be(true)
        val busy = run_distributed_build_attempt_v1(owner,
            [scheduled, other_scheduled], other_digest, "try-other", 0,
            config, capacity, 0)
        expect(busy.completed).to_be(false)
        expect(busy.reconciliation_required).to_be(false)
        expect(busy.reason).to_equal("worker-busy")
        expect(owner.state.ledger.attempts.len()).to_equal(1)
        expect(file_exists(owner.root + "/requests/try-other.intent"))
            .to_be(false)
        expect(file_exists(owner.root + "/requests/try-other.wire"))
            .to_be(false)
        expect(scheduler_owner_close_v1(owner)).to_be(true)

    it "retains diagnostics before closing an unclassified failed attempt":
        val root = cwd() + "/build/test/dist-failed-commit-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val snapshot = sha256_text("failed commit snapshot")
        val action = ActionSpec(1, "compile",
            SnapshotManifest(1, snapshot, sha256_text("source"),
                sha256_text("submodules")),
            ToolchainManifest(1, sha256_text("compiler"),
                sha256_text("behavior"), sha256_text("abi"),
                sha256_text("runtime"), sha256_text("sysroot"),
                "x86_64-unknown-linux-gnu"),
            InputManifest(1, snapshot,
                [BuildInputRef("src/answer.c", sha256_text("source bytes"))],
                [], [], [], [], [], sha256_text("context"), true, false),
            ["cc", "-c"], "src", sha256_text("sandbox"),
            ["answer.o"], sha256_text("resources"))
        val digest = action_spec_digest_v1(action)
        val scheduled = SchedulerActionV1(digest, action, [], 0, 0,
            1, 4096, 8)
        val owner = scheduler_owner_open_v1(root + "/journal")
        expect(owner.error).to_equal("")
        expect(persist_parent_build_intent_v1(owner, digest, "try-1",
            "node-a").persisted).to_be(true)
        val admitted = scheduler_owner_admit_v1(owner, [scheduled], digest,
            "try-1", "node-a", SchedulerCapacityV1(2, 8192, 0, 16), 0)
        expect(admitted.dispatch).to_be(true)
        val request = BuildWorkerRequestV1(action,
            AttemptSpec(1, digest, "try-1", "node-a", 0, 0, 4096),
            admitted.fence, 1, 8)
        expect(persist_parent_build_request_v1(owner, request).persisted)
            .to_be(true)
        val failed = ActionResultCandidate(1, digest, "try-1", "node-a",
            "", sha256_text("compiler diagnostics"), false)
        val wire = encode_build_result_v1(failed, admitted.fence)
        expect(wire.starts_with("simple-build-result-candidate-v1\n"))
            .to_be(true)
        val unverified_bytes = BuildResultFetchV1(true, false, "", root,
            root + "/outputs", "", wire)
        val node_identity = TrustedSshNodeV1("node-a", "127.0.0.1",
            "builder", 2222, root + "/ssh", "", root + "/known_hosts",
            "", root + "/identity", "")
        val node = DistributedBuildNodeV1(
            TrustedWorkerCommandV1(node_identity,
                "/usr/local/bin/simple-build-worker", 30000),
            TrustedSftpConfigV1(node_identity, root + "/sftp", "",
                "/srv/simple-build-inbox"),
            root, root, root + "/retained")
        val before_fence = scheduler_current_fence_v1(
            owner.state.ledger, digest)
        val rejected = commit_fetched_distributed_reply_v1(owner, node,
            request, unverified_bytes)
        expect(rejected.completed).to_be(false)
        expect(rejected.reconciliation_required).to_be(true)
        expect(rejected.reason).to_equal("retain-failure: input-invalid")
        expect(owner.state.ledger.attempts[0].active).to_be(true)
        expect(scheduler_current_fence_v1(owner.state.ledger, digest))
            .to_equal(before_fence)
        expect(owner.state.ledger.failures.len()).to_equal(0)
        expect(owner.state.ledger.accepted.len()).to_equal(0)
        expect(file_exists(root + "/journal/cleanup/try-1.pending"))
            .to_be(false)
        expect(dir_create_all(root + "/outputs")).to_be(true)
        expect(dir_create_all(root + "/retained")).to_be(true)
        expect(file_atomic_write(root + "/outputs/manifest.wire", ""))
            .to_be(true)
        expect(file_atomic_write(root + "/outputs/diagnostics",
            "compiler diagnostics")).to_be(true)
        val fetched = BuildResultFetchV1(true, false, "", root, "", "", wire)
        val missing_proof = commit_fetched_distributed_reply_v1(owner,
            node, request, fetched)
        expect(missing_proof.completed).to_be(false)
        expect(missing_proof.reason).to_equal(
            "retain-failure: failure-proof-unavailable")
        expect(owner.state.ledger.attempts[0].active).to_be(true)
        expect(owner.state.ledger.failures.len()).to_equal(0)
        val proof = encode_build_worker_failure_proof_v1(
            sha256_text(encode_build_worker_request_v1(request)),
            sha256_text("permanent binding"), "try-1", admitted.fence,
            137, sha256_text(wire))
        expect(file_atomic_write(root + "/outputs/failure-proof.wire", proof))
            .to_be(true)
        val committed = commit_fetched_distributed_reply_v1(owner, node,
            request, fetched)
        expect(committed.completed).to_be(true)
        expect(committed.published).to_be(false)
        expect(committed.failure_recorded).to_be(true)
        expect(committed.reason).to_equal("action-failure-unclassified")
        expect(owner.state.ledger.attempts[0].active).to_be(false)
        expect(owner.state.ledger.failures.len()).to_equal(1)
        expect(owner.state.ledger.failures[0].classification)
            .to_equal("action-failure-unclassified")
        expect(owner.state.ledger.accepted.len()).to_equal(0)
        expect(file_exists(root + "/journal/cleanup/try-1.pending"))
            .to_be(true)
        expect(recover_completed_parent_build_request_v1(owner,
            "try-1").recovered).to_be(true)
        expect(recover_parent_cleanup_pending_v1(owner,
            "try-1").ready).to_be(true)
        val duplicate = commit_fetched_distributed_reply_v1(owner, node,
            request, fetched)
        expect(duplicate.completed).to_be(false)
        expect(duplicate.reconciliation_required).to_be(true)
        expect(owner.state.ledger.failures.len()).to_equal(1)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
