"""Pure preflight and cleanup retention checks; no child launch or tree proof."""
use std.spec.*
use app.build.scheduler.parallel_transport_handoff_stage_v1.{StagedParallelTransportHandoffV1}
use app.build.scheduler.parallel_transport_process_session_v1.{
    ParallelTransportProcessLimitsV1, ParallelTransportProcessStartFailureV1,
    parallel_transport_process_limits_valid_v1, start_parallel_transport_process_v1}

fn transport_session_limits() -> ParallelTransportProcessLimitsV1:
    ParallelTransportProcessLimitsV1(stream_limit_bytes: 4096, term_grace_ns: 1000000,
        cleanup_budget_ns: 1000000, required_live_tickets: 2)

describe "isolated parent transport process session":
    it "bounds stream allocation before aggregate capture multiplication":
        expect(parallel_transport_process_limits_valid_v1(transport_session_limits())).to_equal(true)
        var limits = transport_session_limits()
        limits.stream_limit_bytes = 1048577
        expect(parallel_transport_process_limits_valid_v1(limits)).to_equal(false)
        limits.stream_limit_bytes = 0
        expect(parallel_transport_process_limits_valid_v1(limits)).to_equal(false)

    it "requires cleanup budget and positive concurrent ticket admission":
        var limits = transport_session_limits()
        limits.cleanup_budget_ns = 0
        expect(parallel_transport_process_limits_valid_v1(limits)).to_equal(false)
        limits = transport_session_limits()
        limits.required_live_tickets = 0
        expect(parallel_transport_process_limits_valid_v1(limits)).to_equal(false)

    it "rejects an unstaged handoff without accessing a native launch":
        val staged = StagedParallelTransportHandoffV1(false, "not-staged", "", "", "")
        val result = start_parallel_transport_process_v1(staged, "/missing-child", [],
            "/missing-state", 100, transport_session_limits())
        expect(result.is_err()).to_equal(true)

    it "does not report cleanup when native launch authority was lost":
        val staged = StagedParallelTransportHandoffV1(true, "", "/state/private",
            "/state/private/handoff.wire", "digest")
        var failure = ParallelTransportProcessStartFailureV1(reason: "native-decode-failed",
            staged: staged, launch_uncertain: true, executable: None, cwd: None)
        expect(failure.cleanup().is_err()).to_equal(true)
        expect(failure.staged.root).to_equal("/state/private")
