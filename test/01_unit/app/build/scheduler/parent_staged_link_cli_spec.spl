use std.spec.*
use app.build.scheduler.parent_staged_link_cli.{
    parent_staged_link_cli_selected_v1,
    parse_parent_staged_link_cli_args_v1}

val STAGED_CLI_DIGEST =
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

describe "protected staged parent CLI arguments":
    it "requires exact plan and template pins before protected config paths":
        val args = ["/trusted/bin/simple_dist_build_parent",
            "--staged-plan-digest", STAGED_CLI_DIGEST,
            "--template", "/trusted/link.template",
            "--template-digest", STAGED_CLI_DIGEST,
            "--config", "/trusted/worker-one.conf",
            "--config", "/trusted/worker-two.conf"]
        expect(parent_staged_link_cli_selected_v1(args)).to_be(true)
        val parsed = parse_parent_staged_link_cli_args_v1(args)
        expect(parsed.valid).to_be(true)
        expect(parsed.expected_plan_digest).to_equal(STAGED_CLI_DIGEST)
        expect(parsed.template_path).to_equal("/trusted/link.template")
        expect(parsed.config_paths.len()).to_equal(2)

    it "rejects missing pins, relative paths and malformed digests":
        expect(parse_parent_staged_link_cli_args_v1(
            ["--staged-plan-digest", STAGED_CLI_DIGEST,
             "--template", "/trusted/link.template",
             "--config", "/trusted/worker.conf"]).valid).to_be(false)
        expect(parse_parent_staged_link_cli_args_v1(
            ["--staged-plan-digest", "AAAA",
             "--template", "/trusted/link.template",
             "--template-digest", STAGED_CLI_DIGEST,
             "--config", "/trusted/worker.conf"]).valid).to_be(false)
        expect(parse_parent_staged_link_cli_args_v1(
            ["--staged-plan-digest", STAGED_CLI_DIGEST,
             "--template", "relative.template",
             "--template-digest", STAGED_CLI_DIGEST,
             "--config", "/trusted/worker.conf"]).valid).to_be(false)
        expect(parse_parent_staged_link_cli_args_v1(
            ["--staged-plan-digest", STAGED_CLI_DIGEST,
             "--template", "/trusted/link.template",
             "--template-digest", STAGED_CLI_DIGEST,
             "--config", "/trusted/../worker.conf"]).valid).to_be(false)
