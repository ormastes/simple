use std.spec.*
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportFileV1, ParallelTransportHandoffV1,
    ParallelTransportObservationV1,
    PARALLEL_TRANSPORT_MAX_RESULT_FILES_V1,
    PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1,
    encode_parallel_transport_handoff_v1,
    parse_parallel_transport_handoff_v1,
    parallel_transport_handoff_digest_v1,
    parallel_transport_approved_node_digest_v1,
    encode_parallel_transport_observation_v1,
    parse_parallel_transport_observation_v1,
    check_parallel_transport_observation_binding_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1, parse_build_worker_request_v1}
use app.build.scheduler.dispatch_wire.{encode_build_result_v1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    ActionResultCandidate,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.cache.canonical_identity.{canonical_identity_sort_texts}
use std.nogc_sync_mut.composition.native_build_argv_v1.{
    native_build_argv_encode_v1, native_build_argv_decode_v1}

fn _wire_node_v1() -> DistributedBuildNodeV1:
    val ssh = TrustedSshNodeV1("worker-1", "build.example", "builder", 22,
        "/usr/bin/ssh", sha256_text("ssh"), "/etc/ssh/known_hosts",
        sha256_text("hosts"), "/etc/ssh/id_ed25519",
        sha256_text("key"))
    DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh, "/opt/simple/worker", 30000),
        TrustedSftpConfigV1(ssh, "/usr/bin/sftp", sha256_text("sftp"),
            "/srv/simple/inbox"), "/trusted/source", "/trusted/state",
        "/trusted/cas")

fn _wire_request_v1() -> text:
    val snapshot = sha256_text("transport-snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("abi"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text("source"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/clang", "-c"], "simple-build/outputs",
        sha256_text("sandbox"), ["main.o"], sha256_text("resources"))
    val attempt = AttemptSpec(1, action_spec_digest_v1(action),
        "dist-try-1", "worker-1", 0, 2, 4096)
    encode_build_worker_request_v1(BuildWorkerRequestV1(action, attempt,
        1, 2, 8))

fn _handoff_v1() -> ParallelTransportHandoffV1:
    val request = _wire_request_v1()
    val node = _wire_node_v1()
    ParallelTransportHandoffV1(true, "", sha256_text("nonce"), request,
        sha256_text(request), node,
        parallel_transport_approved_node_digest_v1(node),
        "/trusted/prepared",
        ParallelTransportFileV1("inputs.batch", 80,
            sha256_text("inputs-batch")),
        ParallelTransportFileV1("control.batch", 90,
            sha256_text("control-batch")),
        "/trusted/results", 100000, 2, 1000)

fn _observation_v1(handoff: ParallelTransportHandoffV1) ->
        ParallelTransportObservationV1:
    val request = parse_build_worker_request_v1(handoff.request_wire).unwrap()
    val candidate = ActionResultCandidate(1, request.attempt.action_digest,
        request.attempt.attempt_id, request.attempt.worker_id,
        sha256_text("output-manifest"), sha256_text("diagnostics"), true)
    ParallelTransportObservationV1(true, "",
        parallel_transport_handoff_digest_v1(handoff), handoff.nonce,
        handoff.request_digest, "FETCHED",
        encode_build_result_v1(candidate, request.fence),
        [ParallelTransportFileV1("outputs/main.o", 100,
            sha256_text("object"))])

describe "parallel transport envelope wire V1":
    it "round trips a canonical handoff and bound fetched observation":
        val handoff = _handoff_v1()
        val encoded = encode_parallel_transport_handoff_v1(handoff)
        expect(encoded.len() > 0).to_be(true)
        val parsed = parse_parallel_transport_handoff_v1(encoded)
        expect(parsed.valid).to_be(true)
        expect(parsed.request_wire).to_equal(handoff.request_wire)
        expect(parsed.approved_node.unwrap().sftp.remote_inbox_root).to_equal(
            "/srv/simple/inbox")
        expect(encode_parallel_transport_handoff_v1(parsed)).to_equal(encoded)
        val observation = _observation_v1(parsed)
        val observed_wire = encode_parallel_transport_observation_v1(observation)
        expect(observed_wire.len() > 0).to_be(true)
        val restored = parse_parallel_transport_observation_v1(observed_wire)
        expect(restored.valid).to_be(true)
        expect(check_parallel_transport_observation_binding_v1(parsed,
            restored)).to_be(true)

    it "rejects reordered, duplicated, extra and noncanonical handoff fields":
        val original = encode_parallel_transport_handoff_v1(_handoff_v1())
        var items = native_build_argv_decode_v1(original).arguments
        val first = items[1]
        items[1] = items[2]
        items[2] = first
        expect(parse_parallel_transport_handoff_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)
        items = native_build_argv_decode_v1(original).arguments
        items[2] = items[1]
        expect(parse_parallel_transport_handoff_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)
        items = native_build_argv_decode_v1(original).arguments
        items.push("extra=value")
        expect(parse_parallel_transport_handoff_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)
        items = native_build_argv_decode_v1(original).arguments
        items[6] = "deadline.tick=0100000"
        expect(parse_parallel_transport_handoff_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)

    it "rejects traversal, duplicate batch role and oversized frame":
        var handoff = _handoff_v1()
        handoff.prepared_root = "/trusted/../victim"
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        handoff.input_batch = ParallelTransportFileV1("../inputs.batch", 80,
            sha256_text("inputs-batch"))
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        handoff.control_batch = handoff.input_batch
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        handoff.result_root = handoff.prepared_root + "/results"
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        handoff.prepared_root = handoff.result_root + "/prepared"
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        handoff.approved_node_digest = sha256_text("wrong-node")
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        handoff = _handoff_v1()
        var invalid_node = handoff.approved_node.unwrap()
        var invalid_command = invalid_node.ssh
        var invalid_ssh = invalid_command.node
        invalid_ssh.port = 0
        invalid_command.node = invalid_ssh
        invalid_node.ssh = invalid_command
        var invalid_sftp = invalid_node.sftp
        invalid_sftp.node = invalid_ssh
        invalid_node.sftp = invalid_sftp
        handoff.approved_node = invalid_node
        handoff.approved_node_digest =
            parallel_transport_approved_node_digest_v1(invalid_node)
        expect(encode_parallel_transport_handoff_v1(handoff).len()).to_equal(0)
        expect(parse_parallel_transport_handoff_v1(
            "x".repeat(1048577).bytes()).valid).to_be(false)

    it "rejects contradictory outcomes and unsafe result manifests":
        val handoff = _handoff_v1()
        var observation = _observation_v1(handoff)
        observation.reason = "unexpected"
        expect(encode_parallel_transport_observation_v1(observation).len())
            .to_equal(0)
        observation = _observation_v1(handoff)
        observation.status = "INCOMPLETE"
        expect(encode_parallel_transport_observation_v1(observation).len())
            .to_equal(0)
        observation = ParallelTransportObservationV1(true, "deadline",
            parallel_transport_handoff_digest_v1(handoff), handoff.nonce,
            handoff.request_digest, "INCOMPLETE", "", [])
        expect(encode_parallel_transport_observation_v1(observation).len() > 0)
            .to_be(true)
        observation = _observation_v1(handoff)
        observation.result_files = [
            ParallelTransportFileV1("outputs/../escape", 10,
                sha256_text("escape"))]
        expect(encode_parallel_transport_observation_v1(observation).len())
            .to_equal(0)
        observation = _observation_v1(handoff)
        observation.result_files = [
            ParallelTransportFileV1("same", 10, sha256_text("one")),
            ParallelTransportFileV1("same", 10, sha256_text("two"))]
        expect(encode_parallel_transport_observation_v1(observation).len())
            .to_equal(0)

    it "rejects mismatched binding and output budget claims":
        val handoff = _handoff_v1()
        var observation = _observation_v1(handoff)
        observation.nonce = sha256_text("wrong-nonce")
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(false)
        observation = _observation_v1(handoff)
        observation.worker_result_wire = "not-a-worker-result"
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(false)
        observation = _observation_v1(handoff)
        val request = parse_build_worker_request_v1(handoff.request_wire).unwrap()
        observation.worker_result_wire = encode_build_result_v1(
            ActionResultCandidate(1, request.attempt.action_digest,
                "other-attempt", request.attempt.worker_id,
                sha256_text("output-manifest"), sha256_text("diagnostics"),
                true), request.fence)
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(false)
        observation = _observation_v1(handoff)
        observation.result_files = [ParallelTransportFileV1("large", 1001,
            sha256_text("large"))]
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(false)
        observation = _observation_v1(handoff)
        observation.result_files = [
            ParallelTransportFileV1("a", 1, sha256_text("a")),
            ParallelTransportFileV1("b", 1, sha256_text("b")),
            ParallelTransportFileV1("c", 1, sha256_text("c"))]
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(false)

    it "rejects reordered and extra observation fields":
        val original = encode_parallel_transport_observation_v1(
            _observation_v1(_handoff_v1()))
        var items = native_build_argv_decode_v1(original).arguments
        val first = items[1]
        items[1] = items[2]
        items[2] = first
        expect(parse_parallel_transport_observation_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)
        items = native_build_argv_decode_v1(original).arguments
        items.push("extra=value")
        expect(parse_parallel_transport_observation_v1(
            native_build_argv_encode_v1(items)).valid).to_be(false)

    it "permits the 131-file envelope bound for three metadata and 128 outputs":
        expect(PARALLEL_TRANSPORT_MAX_RESULT_FILES_V1).to_equal(131)
        var handoff = _handoff_v1()
        handoff.max_output_files = 131
        var names: [text] = []
        var index: i64 = 0
        while index < 131:
            names.push("outputs/file-" + index.to_text())
            index = index + 1
        var files: [ParallelTransportFileV1] = []
        for name in canonical_identity_sort_texts(names):
            files.push(ParallelTransportFileV1(name, 1, sha256_text(name)))
        var observation = _observation_v1(handoff)
        observation.result_files = files
        val wire = encode_parallel_transport_observation_v1(observation)
        expect(wire.len() > 0).to_be(true)
        expect(parse_parallel_transport_observation_v1(wire).valid).to_be(true)
        expect(check_parallel_transport_observation_binding_v1(handoff,
            observation)).to_be(true)

    it "permits the existing output aggregate plus bounded metadata":
        expect(PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1)
            .to_equal(1074860032)
        var handoff = _handoff_v1()
        handoff.max_output_bytes = PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1
        expect(encode_parallel_transport_handoff_v1(handoff).len() > 0)
            .to_be(true)
        expect(parse_parallel_transport_handoff_v1(
            encode_parallel_transport_handoff_v1(handoff)).valid).to_be(true)
        handoff.max_output_bytes =
            PARALLEL_TRANSPORT_MAX_RESULT_BYTES_V1 + 1
        expect(encode_parallel_transport_handoff_v1(handoff).len())
            .to_equal(0)
