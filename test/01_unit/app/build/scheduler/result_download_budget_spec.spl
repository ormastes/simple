use app.build.scheduler.trusted_result_download.{
    BuildResultTransferLimitsV1, plan_build_result_download_budget_v1,
    plan_build_result_download_budget_limited_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn _budget_request_v1() -> BuildWorkerRequestV1:
    val snapshot = sha256_text("budget snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("source"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/answer.c", sha256_text("source bytes"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["cc", "-c"], "src", sha256_text("sandbox"),
        ["answer.o"], sha256_text("resources"))
    val attempt = AttemptSpec(1, action_spec_digest_v1(action),
        "try-1", "node-a", 0, 0, 4096)
    BuildWorkerRequestV1(action, attempt, 7, 1, 8)

fn _budget_manifest_v1(request: BuildWorkerRequestV1, size: text) -> text:
    "simple-build-output-manifest-v1\n" +
    "action=" + request.attempt.action_digest + "\n" +
    "attempt=" + request.attempt.attempt_id + "\n" +
    "worker=" + request.attempt.worker_id + "\n" +
    "fence=" + request.fence.to_text() + "\n" +
    "diagnostics=" + sha256_text("") + "\n" +
    "count=1\nanswer.o|" + size + "|" + sha256_text("bytes") + "\n"

describe "result download size admission":
    it "accepts one exact bounded output before transfer":
        val request = _budget_request_v1()
        val manifest = _budget_manifest_v1(request, "512")
        val budget = plan_build_result_download_budget_v1(request,
            manifest, sha256_text(manifest))
        expect(budget.valid).to_be(true)
        expect(budget.output_sizes).to_equal([512])

    it "rejects oversized and noncanonical byte claims before transfer":
        val request = _budget_request_v1()
        val huge = _budget_manifest_v1(request, "1073741825")
        val leading_zero = _budget_manifest_v1(request, "0512")
        expect(plan_build_result_download_budget_v1(request,
            huge, sha256_text(huge)).reason).to_equal("output-size-invalid")
        expect(plan_build_result_download_budget_v1(request,
            leading_zero, sha256_text(leading_zero)).reason).to_equal(
                "output-size-invalid")

    it "charges metadata and declared output against the handoff total":
        val request = _budget_request_v1()
        val manifest = _budget_manifest_v1(request, "512")
        val enough = BuildResultTransferLimitsV1(612, 512, 4)
        val tight = BuildResultTransferLimitsV1(611, 512, 4)
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), 100, enough).valid).to_be(true)
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), 100, tight).reason).to_equal(
                "transfer-byte-limit")
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), 613, enough).reason).to_equal(
                "transfer-limit-invalid")

    it "accepts a reachable exact byte budget and rejects one byte less":
        val request = _budget_request_v1()
        val manifest = _budget_manifest_v1(request, "512")
        val result_wire = "result-wire"
        val diagnostics = "diagnostics"
        val metadata_bytes = manifest.bytes().len() +
            result_wire.bytes().len() + diagnostics.bytes().len()
        val exact = BuildResultTransferLimitsV1(metadata_bytes + 512,
            512, 4)
        val short = BuildResultTransferLimitsV1(metadata_bytes + 511,
            512, 4)
        expect(manifest.bytes().len() < exact.max_file_bytes).to_be(true)
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), metadata_bytes, exact).valid)
            .to_be(true)
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), metadata_bytes, short).reason)
            .to_equal("transfer-byte-limit")

    it "rejects file and count limits before output transfer":
        val request = _budget_request_v1()
        val manifest = _budget_manifest_v1(request, "512")
        val file_tight = BuildResultTransferLimitsV1(1024, 511, 4)
        val count_tight = BuildResultTransferLimitsV1(1024, 512, 3)
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), 100, file_tight).reason)
            .to_equal("transfer-byte-limit")
        expect(plan_build_result_download_budget_limited_v1(request,
            manifest, sha256_text(manifest), 100, count_tight).reason)
            .to_equal("transfer-limit-invalid")
