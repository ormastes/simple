use std.spec.*
use app.build.scheduler.docker_attach_fixture.{docker_attach_fixture_bytes_error_v1}
use app.build.scheduler.docker_attach_frames.{DockerAttachDecodedV1}
use app.build.scheduler.docker_attach_source.{DockerAttachCaptureV1}

fn fixture_id() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn fixture_capture(stdout_bytes: [u8], stderr_bytes: [u8], eof: bool, complete: bool) -> DockerAttachCaptureV1:
    DockerAttachCaptureV1(fixture_id(), DockerAttachDecodedV1(stdout_bytes, stderr_bytes, 2), eof, complete)

describe "Docker fixed fixture byte comparison without lifecycle qualification":
    it "compares exact binary streams against independent SHA256 constants":
        val capture = fixture_capture([0, 65, 255, 10], [128, 66, 0, 10], true, false)
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), capture)).to_equal("")
        expect(capture.output_complete).to_be(false)

    it "rejects equal-length corruption in either stream":
        val bad_out = fixture_capture([0, 65, 254, 10], [128, 66, 0, 10], true, false)
        val bad_err = fixture_capture([0, 65, 255, 10], [128, 66, 1, 10], true, false)
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), bad_out)).to_equal("fixture: stdout SHA256 mismatch")
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), bad_err)).to_equal("fixture: stderr SHA256 mismatch")

    it "rejects trailing bytes and missing EOF independently":
        val extra = fixture_capture([0, 65, 255, 10, 10], [128, 66, 0, 10], true, false)
        val open_stream = fixture_capture([0, 65, 255, 10], [128, 66, 0, 10], false, false)
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), extra)).to_equal("fixture: stdout byte count mismatch")
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), open_stream)).to_equal("fixture: transport EOF missing")

    it "rejects identity mismatch and unsupported output completeness":
        val capture = fixture_capture([0, 65, 255, 10], [128, 66, 0, 10], true, false)
        val claimed = fixture_capture([0, 65, 255, 10], [128, 66, 0, 10], true, true)
        val other_id = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        expect(docker_attach_fixture_bytes_error_v1(other_id, capture)).to_equal("fixture: capture container ID mismatch")
        expect(docker_attach_fixture_bytes_error_v1(fixture_id(), claimed)).to_equal("fixture: unsupported general output completeness claim")
