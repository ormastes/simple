use std.spec.*
use app.build.scheduler.parallel_transport_child_run_v1.{
    parallel_transport_deadline_open_v1}

describe "parallel transport child monotonic deadline V1":
    it "allows work before the deadline and rejects equality or expiry":
        expect(parallel_transport_deadline_open_v1(1200, 1199)).to_be(true)
        expect(parallel_transport_deadline_open_v1(1200, 1200)).to_be(false)
        expect(parallel_transport_deadline_open_v1(1200, 1201)).to_be(false)
        expect(parallel_transport_deadline_open_v1(1200, -1)).to_be(false)
        expect(parallel_transport_deadline_open_v1(
            1000000000000001, 0)).to_be(false)
