use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use app.build.scheduler.parent_artifact_export.{
    plan_parent_artifact_export_v1, export_accepted_build_object_v1,
    export_accepted_build_policy_row_v1, parent_export_executable_image_v1}
use app.build.scheduler.parent_artifact_export_policy.{
    ParentArtifactExportPolicyRowV1}
use app.build.scheduler.retained_binary_cas.{retained_binary_cas_put_v1}
use app.build.scheduler.ledger.{SchedulerLedgerV1, SchedulerAttemptV1,
    SchedulerFenceV1, SchedulerFailedAttemptV1, SchedulerCapacityV1}
use app.build.scheduler.planner.{SchedulerActionV1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_admit_v1, scheduler_owner_publish_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.broker.{FencedCandidateV1}
use app.build.scheduler.worker_output.{observe_build_outputs_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    file_write_bytes, file_read_regular_no_follow_bounded_bytes}
use compiler.driver.cache.binary_object_cas.{binary_object_cas_put,
    binary_object_cas_blob_path}
use compiler.driver.cache.cas_store.{cas_put}
use std.nogc_sync_mut.sffi.fs.{file_mode}
use std.io_runtime.{platform_name}
use compiler.common.build_contract.{AcceptedResult, BuildInputRef,
    SnapshotManifest, ToolchainManifest, InputManifest, ActionSpec,
    AttemptSpec, ActionResultCandidate, action_spec_digest_v1}

val ACTION = sha256_text("accepted action")
val OBJECT = sha256_text("accepted ELF object")
val DIAGNOSTIC = sha256_text("diagnostics")

fn _manifest() -> text:
    "simple-build-output-manifest-v1\n" +
        "action=" + ACTION + "\n" +
        "attempt=try-1\nworker=worker-a\nfence=1\n" +
        "diagnostics=" + DIAGNOSTIC + "\ncount=1\n" +
        "unit.o|21|" + OBJECT + "\n"

fn _accepted_ledger() -> SchedulerLedgerV1:
    SchedulerLedgerV1(
        [SchedulerAttemptV1(ACTION, "try-1", "worker-a", 1,
            1, 4096, 8, false)],
        [SchedulerFenceV1(ACTION, 1)],
        [AcceptedResult(1, ACTION, "try-1",
            sha256_text(_manifest()), sha256_text("broker receipt"))],
        [])

fn _real_action(output_name: text) -> SchedulerActionV1:
    val snapshot = sha256_text("export-snapshot")
    val spec = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("provider"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/unit.c", sha256_text("source"))],
            [], [], [], [], [], sha256_text("closure"), true, false),
        ["cc", "-c", "src/unit.c"], "src", sha256_text("sandbox"),
        [output_name], sha256_text("resource-policy"))
    SchedulerActionV1(action_spec_digest_v1(spec), spec, [], 0, 0, 1, 20, 1)

fn _elf_exec_header_v1() -> [u8]:
    var bytes: [u8] = []
    while bytes.len() < 120: bytes.push(0.to_u8())
    bytes[0] = 0x7F.to_u8()
    bytes[1] = 0x45.to_u8()
    bytes[2] = 0x4C.to_u8()
    bytes[3] = 0x46.to_u8()
    bytes[4] = 2.to_u8()
    bytes[5] = 1.to_u8()
    bytes[6] = 1.to_u8()
    bytes[16] = 2.to_u8()
    bytes[18] = 62.to_u8()
    bytes[20] = 1.to_u8()
    bytes[24] = 119.to_u8()
    bytes[52] = 64.to_u8()
    bytes[32] = 64.to_u8()
    bytes[54] = 56.to_u8()
    bytes[56] = 1.to_u8()
    bytes[64] = 1.to_u8()
    bytes[68] = 5.to_u8()
    bytes[96] = 120.to_u8()
    bytes[104] = 120.to_u8()
    bytes

fn _elf_pie_header_v1() -> [u8]:
    var bytes = _elf_exec_header_v1()
    while bytes.len() < 384: bytes.push(0.to_u8())
    bytes[16] = 3.to_u8()
    bytes[56] = 3.to_u8()
    bytes[96] = 128.to_u8()
    bytes[97] = 1.to_u8()
    bytes[104] = 128.to_u8()
    bytes[105] = 1.to_u8()
    # PT_INTERP at 120; PT_DYNAMIC at 176, both backed by PT_LOAD.
    bytes[120] = 3.to_u8()
    bytes[128] = 232.to_u8()
    val interpreter = "/lib64/ld-linux-x86-64.so.2".bytes()
    var i: i64 = 0
    while i < interpreter.len():
        bytes[232 + i] = interpreter[i]
        i = i + 1
    bytes[152] = (interpreter.len() + 1).to_u8()
    bytes[176] = 2.to_u8()
    bytes[184] = 16.to_u8()
    bytes[185] = 1.to_u8()
    bytes[192] = 16.to_u8()
    bytes[193] = 1.to_u8()
    bytes[208] = 32.to_u8()
    bytes[216] = 32.to_u8()
    bytes[272] = 0xFB.to_u8()
    bytes[273] = 0xFF.to_u8()
    bytes[274] = 0xFF.to_u8()
    bytes[275] = 0x6F.to_u8()
    bytes[283] = 8.to_u8()
    bytes

fn _macho_exec_header_v1() -> [u8]:
    var bytes: [u8] = []
    while bytes.len() < 104: bytes.push(0.to_u8())
    bytes[0] = 0xCF.to_u8()
    bytes[1] = 0xFA.to_u8()
    bytes[2] = 0xED.to_u8()
    bytes[3] = 0xFE.to_u8()
    bytes[4] = 7.to_u8()
    bytes[7] = 1.to_u8()
    bytes[12] = 2.to_u8()
    bytes[16] = 1.to_u8()
    bytes[20] = 72.to_u8()
    bytes[32] = 0x19.to_u8()
    bytes[36] = 72.to_u8()
    bytes[80] = 1.to_u8()
    bytes

describe "parent accepted artifact export selection":
    it "admits only target-bound dynamic PIE with executable entry and PIE flags":
        val target = "x86_64-unknown-linux-gnu"
        val valid = _elf_pie_header_v1()
        expect(parent_export_executable_image_v1(valid, target)).to_be(true)
        expect(parent_export_executable_image_v1(valid, "aarch64-unknown-linux-gnu")).to_be(false)
        expect(parent_export_executable_image_v1(valid, "unknown")).to_be(false)
        # One independently rebuilt mutation per malformed profile.
        for offset in [6, 18, 20, 24, 52, 54, 56, 68, 120, 176, 283]:
            var malformed = _elf_pie_header_v1()
            malformed[offset] = 0.to_u8()
            expect(parent_export_executable_image_v1(malformed, target)).to_be(false)
        for offset in [5, 9, 36, 40, 60, 100, 112, 185, 193, 208, 232, 288]:
            var malformed = _elf_pie_header_v1()
            malformed[offset] = 3.to_u8()
            expect(parent_export_executable_image_v1(malformed, target)).to_be(false)
        var library = _elf_pie_header_v1()
        library[272] = 14.to_u8()
        library[273] = 0.to_u8()
        library[274] = 0.to_u8()
        library[275] = 0.to_u8()
        expect(parent_export_executable_image_v1(library, target)).to_be(false)
        var duplicate = _elf_pie_header_v1()
        duplicate[120] = 2.to_u8()
        expect(parent_export_executable_image_v1(duplicate, target)).to_be(false)
        expect(parent_export_executable_image_v1(valid[0:303], target)).to_be(false)
        var arm = _elf_pie_header_v1()
        arm[18] = 183.to_u8()
        val arm_interpreter = "/lib/ld-linux-aarch64.so.1".bytes()
        var index: i64 = 0
        while index < arm_interpreter.len():
            arm[232 + index] = arm_interpreter[index]
            index = index + 1
        arm[232 + index] = 0.to_u8()
        arm[152] = (index + 1).to_u8()
        expect(parent_export_executable_image_v1(arm, "aarch64-unknown-linux-gnu")).to_be(true)
        var duplicate_flags = _elf_pie_header_v1()
        duplicate_flags[208] = 48.to_u8()
        duplicate_flags[216] = 48.to_u8()
        index = 0
        while index < 16:
            duplicate_flags[288 + index] = duplicate_flags[272 + index]
            index = index + 1
        expect(parent_export_executable_image_v1(duplicate_flags, target)).to_be(false)

    it "distinguishes executable images from relocatable or truncated bytes":
        var elf = _elf_exec_header_v1()
        expect(parent_export_executable_image_v1(elf, "x86_64-unknown-linux-gnu")).to_be(true)
        var overlap = _elf_exec_header_v1()
        while overlap.len() < 176: overlap.push(0.to_u8())
        overlap[56] = 2.to_u8()
        overlap[96] = 176.to_u8()
        overlap[104] = 176.to_u8()
        overlap[120] = 1.to_u8()
        overlap[124] = 4.to_u8()
        overlap[128] = 100.to_u8()
        overlap[136] = 100.to_u8()
        overlap[152] = 20.to_u8()
        overlap[160] = 20.to_u8()
        overlap[168] = 1.to_u8()
        expect(parent_export_executable_image_v1(overlap,
            "x86_64-unknown-linux-gnu")).to_be(false)
        elf[96] = 200.to_u8()
        expect(parent_export_executable_image_v1(elf, "x86_64-unknown-linux-gnu")).to_be(false)
        elf[96] = 120.to_u8()
        elf[16] = 1.to_u8()
        expect(parent_export_executable_image_v1(elf, "x86_64-unknown-linux-gnu")).to_be(false)
        elf[16] = 2.to_u8()
        expect(parent_export_executable_image_v1(elf[0:64], "x86_64-unknown-linux-gnu")).to_be(false)
        var macho = _macho_exec_header_v1()
        expect(parent_export_executable_image_v1(macho, "x86_64-apple-darwin")).to_be(true)
        macho[80] = 200.to_u8()
        expect(parent_export_executable_image_v1(macho, "x86_64-apple-darwin")).to_be(false)
        macho[80] = 1.to_u8()
        macho[12] = 1.to_u8()
        expect(parent_export_executable_image_v1(macho, "x86_64-apple-darwin")).to_be(false)

    it "selects only the exact accepted manifest row and byte size":
        val plan = plan_parent_artifact_export_v1(_accepted_ledger(),
            _manifest(), ACTION, "unit.o")
        expect(plan.valid).to_be(true)
        expect(plan.output_digest).to_equal(OBJECT)
        expect(plan.output_bytes).to_equal(21)
        expect(plan.accepted_attempt_id).to_equal("try-1")

    it "rejects an unaccepted or failed attempt before choosing output bytes":
        var ledger = _accepted_ledger()
        ledger.accepted = []
        expect(plan_parent_artifact_export_v1(ledger,
            _manifest(), ACTION, "unit.o").reason).to_equal("action-not-accepted")
        ledger.failures = [SchedulerFailedAttemptV1(ACTION, "try-1",
            "worker-a", 1, "action-failure-unclassified", "", DIAGNOSTIC)]
        expect(plan_parent_artifact_export_v1(ledger,
            _manifest(), ACTION, "unit.o").valid).to_be(false)

    it "rejects wrong names, traversal, altered manifests and missing attempts":
        expect(plan_parent_artifact_export_v1(_accepted_ledger(),
            _manifest(), ACTION, "other.o").reason).to_equal("output-not-declared")
        expect(plan_parent_artifact_export_v1(_accepted_ledger(),
            _manifest(), ACTION, "../unit.o").reason).to_equal("selection-invalid")
        val changed = _manifest().replace("unit.o|21|", "unit.o|22|")
        expect(plan_parent_artifact_export_v1(_accepted_ledger(),
            changed, ACTION, "unit.o").valid).to_be(false)
        var ledger = _accepted_ledger()
        ledger.attempts = []
        expect(plan_parent_artifact_export_v1(ledger,
            _manifest(), ACTION, "unit.o").reason)
            .to_equal("accepted-attempt-missing")

    it "exports accepted object bytes and refuses corrupt CAS without replacing old output":
        val base = cwd() + "/build/test/parent-export-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val owner_root = base + "/owner"
        val cas_root = base + "/cas"
        val destination_root = base + "/objects"
        val source_root = base + "/source"
        expect(dir_create_all(cas_root)).to_be(true)
        expect(dir_create_all(destination_root)).to_be(true)
        expect(dir_create_all(source_root)).to_be(true)
        val object = [0x7F.to_u8(), 0x45.to_u8(), 0x4C.to_u8(),
            0x46.to_u8(), 0x00.to_u8(), 0xFF.to_u8(), 0x81.to_u8()]
        val prior = [0x7F.to_u8(), 0x45.to_u8(), 0x4C.to_u8(),
            0x46.to_u8(), 0x11.to_u8()]
        expect(file_write_bytes(source_root + "/unit.o", object)).to_be(true)
        val object_digest = binary_object_cas_put(cas_root, object)
        expect(object_digest).to_equal(sha256_u8_hex(object))
        val action = _real_action("unit.o")
        val attempt = AttemptSpec(1, action.action_digest,
            "try-1", "worker-a", 0, 0, 4096)
        val observed = observe_build_outputs_v1(action.spec, attempt, 1,
            source_root, "")
        expect(observed.valid).to_be(true)
        expect(cas_put(cas_root, observed.manifest_wire))
            .to_equal(observed.manifest_digest)
        val owner = scheduler_owner_open_v1(owner_root)
        expect(owner.error).to_equal("")
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "worker-a",
            SchedulerCapacityV1(1, 8192, 0, 8), 0)
        expect(admitted.dispatch).to_be(true)
        val candidate = FencedCandidateV1(ActionResultCandidate(1,
            action.action_digest, "try-1", "worker-a",
            observed.manifest_digest, observed.diagnostic_digest, true), 1)
        expect(scheduler_owner_publish_v1(owner, candidate,
            observed.manifest_digest).acknowledged).to_be(true)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        val destination = destination_root + "/unit.o"
        expect(file_write_bytes(destination, prior)).to_be(true)
        val exported = export_accepted_build_object_v1(owner_root,
            cas_root, action.action_digest, "unit.o", destination_root,
            "unit.o")
        expect(exported.published).to_be(true)
        expect(exported.durable).to_be(true)
        val copied = file_read_regular_no_follow_bounded_bytes(destination, 128)
        expect(copied.is_ok()).to_be(true)
        expect(sha256_u8_hex(copied.unwrap())).to_equal(object_digest)
        expect(copied.unwrap()[4]).to_equal(0x00.to_u8())
        val program = destination_root + "/program"
        expect(file_write_bytes(program, prior)).to_be(true)
        val executable_row = ParentArtifactExportPolicyRowV1("program",
            action.action_digest, "unit.o", "executable", "program", 0o755, "x86_64-unknown-linux-gnu")
        val refused_object = export_accepted_build_policy_row_v1(owner_root,
            cas_root, destination_root, executable_row)
        expect(refused_object.published).to_be(false)
        expect(refused_object.reason).to_equal("executable-format-unsupported")
        val old_program = file_read_regular_no_follow_bounded_bytes(program, 128)
        expect(old_program.is_ok()).to_be(true)
        expect(sha256_u8_hex(old_program.unwrap())).to_equal(sha256_u8_hex(prior))
        expect(file_write_bytes(destination, prior)).to_be(true)
        val corrupt = binary_object_cas_blob_path(cas_root, object_digest)
        expect(file_write_bytes(corrupt, prior)).to_be(true)
        val refused = export_accepted_build_object_v1(owner_root,
            cas_root, action.action_digest, "unit.o", destination_root,
            "unit.o")
        expect(refused.published).to_be(false)
        val preserved = file_read_regular_no_follow_bounded_bytes(destination, 128)
        expect(preserved.is_ok()).to_be(true)
        expect(sha256_u8_hex(preserved.unwrap())).to_equal(sha256_u8_hex(prior))

    it "exports one accepted regular archive under protected Unix mode":
        val base = cwd() + "/build/test/parent-archive-export-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val owner_root = base + "/owner"
        val cas_root = base + "/cas"
        val destination_root = base + "/artifacts"
        val source_root = base + "/source"
        expect(dir_create_all(cas_root)).to_be(true)
        expect(dir_create_all(destination_root)).to_be(true)
        expect(dir_create_all(source_root)).to_be(true)
        val archive = ("!<arch>\n" +
            "unit.o/         " + "0           " + "0     " + "0     " +
            "100644  " + "4         " + "`\n" + "ABCD").bytes()
        expect(file_write_bytes(source_root + "/libunit.a", archive)).to_be(true)
        val digest = retained_binary_cas_put_v1(cas_root,
            "libunit.a", archive)
        expect(digest).to_equal(sha256_u8_hex(archive))
        val action = _real_action("libunit.a")
        val attempt = AttemptSpec(1, action.action_digest,
            "try-1", "worker-a", 0, 0, 4096)
        val observed = observe_build_outputs_v1(action.spec, attempt, 1,
            source_root, "")
        expect(observed.valid).to_be(true)
        expect(cas_put(cas_root, observed.manifest_wire))
            .to_equal(observed.manifest_digest)
        val owner = scheduler_owner_open_v1(owner_root)
        expect(owner.error).to_equal("")
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "worker-a",
            SchedulerCapacityV1(1, 8192, 0, 8), 0)
        expect(admitted.dispatch).to_be(true)
        val candidate = FencedCandidateV1(ActionResultCandidate(1,
            action.action_digest, "try-1", "worker-a",
            observed.manifest_digest, observed.diagnostic_digest, true), 1)
        expect(scheduler_owner_publish_v1(owner, candidate,
            observed.manifest_digest).acknowledged).to_be(true)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        val destination = destination_root + "/libunit.a"
        expect(file_write_bytes(destination, "previous".bytes())).to_be(true)
        val row = ParentArtifactExportPolicyRowV1("archive",
            action.action_digest, "libunit.a", "archive", "libunit.a",
            0o644, "")
        val exported = export_accepted_build_policy_row_v1(owner_root,
            cas_root, destination_root, row)
        if ["macos", "linux", "freebsd"].contains(platform_name()):
            expect(exported.published).to_be(true)
            expect(exported.durable).to_be(true)
            expect(file_mode(destination)).to_equal(0o644)
            val copied = file_read_regular_no_follow_bounded_bytes(
                destination, 1024)
            expect(copied.is_ok()).to_be(true)
            expect(sha256_u8_hex(copied.unwrap())).to_equal(digest)
        else:
            expect(exported.published).to_be(false)
            expect(exported.reason).to_equal("mode-provider-unsupported")
