# Parent-authoritative local scheduler state transitions.
use app.build.scheduler.planner.{SchedulerActionV1, plan_ready_actions_v1}
use app.build.scheduler.ledger.{SchedulerCapacityV1, SchedulerFenceV1,
    SchedulerLedgerV1, empty_scheduler_ledger_v1, admit_attempt_v1,
    revoke_attempt_v1, fail_attempt_v1}
use app.build.scheduler.broker.{FencedCandidateV1, accept_result_v1}
use compiler.common.build_contract.{ActionResultCandidate, BuildInputRef,
    BuildDependencyRef, SnapshotManifest, ToolchainManifest, InputManifest,
    ActionSpec, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.spec.step

fn _sched_action(name: text, deps: [text], priority: i64, queued: i64,
                 cpu: i64, memory: i64, fds: i64) -> SchedulerActionV1:
    var outputs: [BuildDependencyRef] = []
    var i: i64 = 0
    while i < deps.len():
        outputs.push(BuildDependencyRef(deps[i], "build/dep-" + i.to_text() + ".out",
            sha256_text("dependency-output-" + deps[i])))
        i = i + 1
    val snapshot = sha256_text("scheduler-snapshot")
    val spec = ActionSpec(
        version: 1, kind: "simple-compile",
        snapshot: SnapshotManifest(1, snapshot, sha256_text("source-tree"),
            sha256_text("submodule-closure")),
        toolchain: ToolchainManifest(1, sha256_text("tool-executable"),
            sha256_text("tool-behavior"), sha256_text("provider-abi"),
            sha256_text("runtime"), sha256_text("sysroot"), "aarch64-apple-darwin"),
        inputs: InputManifest(1, snapshot,
            [BuildInputRef("src/" + name + ".spl", sha256_text("source-" + name))],
            [], deps, outputs, [], [], sha256_text("resolution-context"), true, false),
        argv: ["simple", "build", name], working_directory: "src",
        sandbox_digest: sha256_text("sandbox"), output_paths: ["build/" + name + ".out"],
        resource_policy_digest: sha256_text("resource-policy"))
    SchedulerActionV1(action_spec_digest_v1(spec), spec, deps, priority, queued,
        cpu, memory, fds)

fn _sched_candidate(action: text, attempt: text, worker: text, output: text) -> ActionResultCandidate:
    ActionResultCandidate(1, action, attempt, worker, output, sha256_text("diagnostics"), true)

describe "bounded local DAG planning":
    it "classifies producer readiness and blocked consumer without treating active as accepted":
        step("Plan affected build and checks")
        val producer = _sched_action("producer", [], 1, 0, 1, 32, 2)
        val consumer = _sched_action("consumer", [producer.action_digest], 1, 0, 1, 32, 2)
        val first = plan_ready_actions_v1([consumer, producer], [], [], 0)
        expect(first.error).to_equal("")
        expect(first.ready).to_equal([producer.action_digest])
        expect(first.blocked[0].action_digest).to_equal(consumer.action_digest)
        expect(first.blocked[0].reason).to_equal("dependencies")
        val active = plan_ready_actions_v1([consumer, producer], [], [producer.action_digest], 0)
        expect(active.ready.len()).to_equal(0)
        expect(active.blocked[0].reason).to_equal("dependencies")
        expect(active.blocked[1].reason).to_equal("active")
        val done = plan_ready_actions_v1([consumer, producer], [producer.action_digest], [], 0)
        expect(done.ready).to_equal([consumer.action_digest])

    it "orders ready work by bounded aging then digest":
        val old = _sched_action("old", [], 0, 0, 1, 1, 1)
        val recent = _sched_action("recent", [], 5, 9, 1, 1, 1)
        val tie = _sched_action("a", [], 1, 4, 1, 1, 1)
        val plan = plan_ready_actions_v1([recent, old, tie], [], [], 10)
        expect(plan.error).to_equal("")
        expect(plan.ready).to_equal([old.action_digest, tie.action_digest, recent.action_digest])

    it "rejects unknown dependencies and unbound action identities before dispatch":
        val missing = sha256_text("missing-action")
        val unknown = plan_ready_actions_v1([_sched_action("a", [missing], 0, 0, 1, 1, 1)], [], [], 0)
        expect(unknown.error).to_equal("scheduler-error: dependency-unknown")
        var forged = _sched_action("forged", [], 0, 0, 1, 1, 1)
        forged.action_digest = sha256_text("unrelated-spec")
        val invalid = plan_ready_actions_v1([forged], [], [], 0)
        expect(invalid.error).to_equal("scheduler-error: action-identity-invalid")
        val producer = _sched_action("producer", [], 0, 0, 1, 1, 1)
        var consumer = _sched_action("consumer", [producer.action_digest], 0, 0, 1, 1, 1)
        consumer.dependencies = []
        val unbound_edges = plan_ready_actions_v1([producer, consumer], [], [], 0)
        expect(unbound_edges.error).to_equal("scheduler-error: dependency-identity-mismatch")

describe "bounded local attempt ledger":
    it "rejects direct consumer admission until its producer is accepted":
        val producer = _sched_action("producer", [], 0, 0, 1, 20, 1)
        val consumer = _sched_action("consumer", [producer.action_digest], 0, 0, 1, 20, 1)
        val graph = [consumer, producer]
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val bypass = admit_attempt_v1(empty_scheduler_ledger_v1(), graph,
            consumer.action_digest, "consumer-early", "worker", capacity, 0)
        expect(bypass.error).to_equal("scheduler-error: action-not-ready")
        expect(bypass.ledger.attempts.len()).to_equal(0)
        val admitted = admit_attempt_v1(bypass.ledger, graph,
            producer.action_digest, "producer-1", "worker", capacity, 0)
        expect(admitted.admitted).to_be(true)
        val digest = sha256_text("producer-output")
        val published = accept_result_v1(admitted.ledger,
            FencedCandidateV1(_sched_candidate(producer.action_digest,
                "producer-1", "worker", digest), admitted.fence), digest)
        expect(published.published).to_be(true)
        val consumer_admitted = admit_attempt_v1(published.ledger, graph,
            consumer.action_digest, "consumer-1", "worker", capacity, 0)
        expect(consumer_admitted.admitted).to_be(true)

    it "reserves CPU memory including reserve and file descriptors":
        step("Dispatch admitted actions")
        val capacity = SchedulerCapacityV1(2, 100, 20, 5)
        val a = _sched_action("a", [], 0, 0, 1, 60, 3)
        val b_heavy = _sched_action("b", [], 0, 0, 1, 21, 1)
        val b_fds = _sched_action("b", [], 0, 0, 1, 20, 3)
        val b_fit = _sched_action("b", [], 0, 0, 1, 20, 2)
        val c = _sched_action("c", [], 0, 0, 1, 1, 1)
        val graph = [a, b_fit, c]
        val first = admit_attempt_v1(empty_scheduler_ledger_v1(), graph,
            a.action_digest, "try-a", "local", capacity, 0)
        expect(first.admitted).to_be(true)
        expect(first.fence).to_equal(1)
        val memory_full = admit_attempt_v1(first.ledger, [a, b_heavy, c],
            b_heavy.action_digest, "try-b", "local", capacity, 0)
        expect(memory_full.error).to_equal("scheduler-error: capacity-exhausted")
        val fd_full = admit_attempt_v1(first.ledger, [a, b_fds, c],
            b_fds.action_digest, "try-b", "local", capacity, 0)
        expect(fd_full.error).to_equal("scheduler-error: capacity-exhausted")
        val fit = admit_attempt_v1(first.ledger, graph,
            b_fit.action_digest, "try-b", "local", capacity, 0)
        expect(fit.admitted).to_be(true)
        val cpu_full = admit_attempt_v1(fit.ledger, graph,
            c.action_digest, "try-c", "local", capacity, 0)
        expect(cpu_full.error).to_equal("scheduler-error: capacity-exhausted")

    it "rejects IDs and resource claims that cannot cross the dispatch and journal boundary":
        val capacity = SchedulerCapacityV1(1000001, 1000000000000002, 1, 1000001)
        val action = _sched_action("bounded", [], 0, 0, 1, 20, 1)
        val ledger = empty_scheduler_ledger_v1()
        val newline_id = admit_attempt_v1(ledger, [action], action.action_digest,
            "attempt\nsecond", "worker", capacity, 0)
        expect(newline_id.error).to_equal("scheduler-error: attempt-invalid")
        val comma_worker = admit_attempt_v1(ledger, [action], action.action_digest,
            "attempt", "worker,other", capacity, 0)
        expect(comma_worker.error).to_equal("scheduler-error: attempt-invalid")
        val long_id = admit_attempt_v1(ledger, [action], action.action_digest,
            sha256_text("id") + sha256_text("id") + "a", "worker", capacity, 0)
        expect(long_id.error).to_equal("scheduler-error: attempt-invalid")
        val oversized = _sched_action("oversized", [], 0, 0, 1000001, 20, 1)
        val large = admit_attempt_v1(ledger, [oversized], oversized.action_digest,
            "attempt", "worker", capacity, 0)
        expect(large.error).to_equal("scheduler-error: action-resource-bound")
        expect(large.ledger.attempts.len()).to_equal(0)

    it "reserves the final fence epoch to close an admitted attempt":
        val action = _sched_action("last-epoch", [], 0, 0, 1, 20, 1)
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val admissible = SchedulerLedgerV1([], [SchedulerFenceV1(
            action.action_digest, 999999998)], [], [])
        val started = admit_attempt_v1(admissible, [action],
            action.action_digest, "try-last", "worker", capacity, 0)
        expect(started.admitted).to_be(true)
        expect(started.fence).to_equal(999999999)
        val failed = fail_attempt_v1(started.ledger,
            ActionResultCandidate(1, action.action_digest, "try-last", "worker",
                "", sha256_text("last diagnostics"), false),
            started.fence, "compiler-failure")
        expect(failed.admitted).to_be(true)
        expect(failed.fence).to_equal(1000000000)
        val terminal = SchedulerLedgerV1([], [SchedulerFenceV1(
            action.action_digest, 999999999)], [], [])
        val refused = admit_attempt_v1(terminal, [action],
            action.action_digest, "try-overflow", "worker", capacity, 0)
        expect(refused.error).to_equal("scheduler-error: fence-bound")

    it "advances an action fence before retry and rejects a delayed result":
        step("Validate and publish results")
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val action = _sched_action("a", [], 0, 0, 1, 20, 1)
        val first = admit_attempt_v1(empty_scheduler_ledger_v1(), [action],
            action.action_digest, "try-1", "worker", capacity, 0)
        val revoked = revoke_attempt_v1(first.ledger, "try-1")
        expect(revoked.admitted).to_be(true)
        expect(revoked.fence).to_equal(2)
        val second = admit_attempt_v1(revoked.ledger, [action],
            action.action_digest, "try-2", "worker", capacity, 0)
        expect(second.fence).to_equal(3)
        val digest = sha256_text("output bytes")
        val stale = accept_result_v1(second.ledger,
            FencedCandidateV1(_sched_candidate(action.action_digest, "try-1", "worker", digest), first.fence), digest)
        expect(stale.error).to_equal("scheduler-error: stale-fence")
        expect(stale.ledger.accepted.len()).to_equal(0)
        val wrong_bytes = accept_result_v1(second.ledger,
            FencedCandidateV1(_sched_candidate(action.action_digest, "try-2", "worker", digest), second.fence),
            sha256_text("different bytes"))
        expect(wrong_bytes.error).to_equal("scheduler-error: candidate-invalid")
        val published = accept_result_v1(second.ledger,
            FencedCandidateV1(_sched_candidate(action.action_digest, "try-2", "worker", digest), second.fence), digest)
        expect(published.published).to_be(true)
        expect(published.ledger.accepted[0].accepted_attempt_id).to_equal("try-2")
        val duplicate = accept_result_v1(published.ledger,
            FencedCandidateV1(_sched_candidate(action.action_digest, "try-2", "worker", digest), second.fence), digest)
        expect(duplicate.error).to_equal("scheduler-error: already-accepted")

    it "publishes accepted mappings in action order regardless of arrival order":
        val capacity = SchedulerCapacityV1(2, 100, 10, 5)
        val action_b = _sched_action("b", [], 0, 0, 1, 20, 1)
        val action_a = _sched_action("a", [], 0, 0, 1, 20, 1)
        val graph = [action_b, action_a]
        val b = admit_attempt_v1(empty_scheduler_ledger_v1(), graph,
            action_b.action_digest, "b-1", "worker", capacity, 0)
        val a = admit_attempt_v1(b.ledger, graph,
            action_a.action_digest, "a-1", "worker", capacity, 0)
        val digest_b = sha256_text("b")
        val digest_a = sha256_text("a")
        val published_b = accept_result_v1(a.ledger,
            FencedCandidateV1(_sched_candidate(action_b.action_digest, "b-1", "worker", digest_b), b.fence), digest_b)
        val published_a = accept_result_v1(published_b.ledger,
            FencedCandidateV1(_sched_candidate(action_a.action_digest, "a-1", "worker", digest_a), a.fence), digest_a)
        expect(published_a.published).to_be(true)
        val expected_first = if action_a.action_digest < action_b.action_digest: action_a.action_digest else: action_b.action_digest
        val expected_second = if action_a.action_digest < action_b.action_digest: action_b.action_digest else: action_a.action_digest
        expect(published_a.ledger.accepted[0].action_digest).to_equal(expected_first)
        expect(published_a.ledger.accepted[1].action_digest).to_equal(expected_second)
