use std.spec.*
use app.build.scheduler.parent_remote_service.{completed_parent_remote_attempt_v1}
use app.build.scheduler.ledger.{SchedulerLedgerV1, SchedulerAttemptV1,
    SchedulerFenceV1, SchedulerFailedAttemptV1}
use compiler.common.build_contract.{AcceptedResult}
use std.common.crypto.sha256.{sha256_text}

describe "distributed build completed status":
    it "answers a published attempt from the parent ledger without SSH":
        val action = sha256_text("action")
        val accepted = AcceptedResult(1, action, "try-1",
            sha256_text("manifest"), sha256_text("receipt"))
        val ledger = SchedulerLedgerV1(
            [SchedulerAttemptV1(action, "try-1", "worker-1", 1,
                1, 4096, 8, false)],
            [SchedulerFenceV1(action, 1)], [accepted], [])
        val found = completed_parent_remote_attempt_v1(ledger,
            "try-1", "worker-1")
        expect(found != nil).to_be(true)
        if val result = found:
            expect(result.completed).to_be(true)
            expect(result.published).to_be(true)
            expect(result.accepted.broker_receipt_digest).to_equal(
                accepted.broker_receipt_digest)
        else:
            assert(false)
        expect(completed_parent_remote_attempt_v1(ledger,
            "try-1", "worker-2") == nil).to_be(true)

    it "reports an unclassified terminal failure without publishing outputs":
        val action = sha256_text("failed-action")
        val ledger = SchedulerLedgerV1(
            [SchedulerAttemptV1(action, "try-2", "worker-1", 3,
                1, 4096, 8, false)],
            [SchedulerFenceV1(action, 4)], [],
            [SchedulerFailedAttemptV1(action, "try-2", "worker-1", 3,
                "action-failure-unclassified", "",
                sha256_text("diagnostics"))])
        val found = completed_parent_remote_attempt_v1(ledger,
            "try-2", "worker-1")
        expect(found != nil).to_be(true)
        if val result = found:
            expect(result.completed).to_be(true)
            expect(result.published).to_be(false)
            expect(result.failure_recorded).to_be(true)
            expect(result.reason).to_equal("action-failure-unclassified")
        else:
            assert(false)
