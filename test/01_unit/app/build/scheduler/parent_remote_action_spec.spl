use std.spec.*
use app.build.scheduler.parent_remote_service.{run_parent_remote_action_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use compiler.common.build_contract.{NodeCapabilities}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{cwd, dir_remove_all, getpid, time_now_unix_micros}

describe "parent remote action entry":
    it "owns the graph journal and releases its lock on local rejection":
        val root = cwd() + "/build/test/parent-action-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val ssh = TrustedSshNodeV1("worker-1", "build.example", "builder", 22,
            "/usr/bin/ssh", sha256_text("ssh"), "/etc/known_hosts",
            sha256_text("hosts"), "/etc/key", sha256_text("key"))
        val node = DistributedBuildNodeV1(
            TrustedWorkerCommandV1(ssh,
                "/usr/local/bin/simple-build-worker", 30000),
            TrustedSftpConfigV1(ssh, "/usr/bin/sftp",
                sha256_text("sftp"), "/srv/simple-build-inbox"),
            "/src", "/state", "/cas")
        val result = run_parent_remote_action_v1([], sha256_text("absent"),
            "try-1", 0, root, node,
            NodeCapabilities(1, "worker-1", [], [], "trusted", 8192),
            "trusted", SchedulerCapacityV1(1, 8192, 0, 8), 0)
        expect(result.reason).to_equal("action-not-found")
        val reopened = scheduler_owner_open_v1(root)
        expect(reopened.error).to_equal("")
        expect(scheduler_owner_close_v1(reopened)).to_be(true)
        expect(dir_remove_all(root)).to_be(true)
