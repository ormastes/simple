use std.spec.*
use app.build.scheduler.parallel_transport_handoff_builder_v1.{
    build_parallel_transport_handoff_v1}
use app.build.scheduler.parallel_transport_handoff_stage_v1.{
    stage_parallel_transport_handoff_v1}
use app.build.scheduler.parallel_transport_wire_v1.{
    parse_parallel_transport_handoff_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1,
    DistributedBuildAttemptV1, PreparedDistributedBuildAttemptV1}
use app.build.scheduler.prepared_upload.{prepare_build_request_upload_v1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use app.build.scheduler.dispatch_wire.{encode_build_dispatch_v1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    AcceptedResult, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.io_runtime.{time_now_monotonic_ms}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_atomic_write, file_hash_sha256, file_rename,
    file_read_regular_no_follow_bounded_bytes, process_run_bounded}

fn _builder_root_v1() -> text:
    cwd() + "/build/test/handoff-builder-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

fn _builder_fixture_v1(root: text) -> PreparedDistributedBuildAttemptV1:
    val source = root + "/source"
    val state = root + "/state"
    val cas = root + "/cas"
    expect(dir_create_all(source + "/src")).to_be(true)
    expect(dir_create_all(state)).to_be(true)
    expect(dir_create_all(cas)).to_be(true)
    val content = "int main(void) { return 42; }\n"
    expect(file_atomic_write(source + "/src/main.c", content)).to_be(true)
    val snapshot = sha256_text("builder-snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("abi"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text(content))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/clang", "-c"], "simple-build/outputs",
        sha256_text("sandbox"), ["main.o"], sha256_text("resources"))
    val request = BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action), "dist-try-1",
            "worker-1", 0, 2, 4096), 1, 2, 8)
    expect(file_atomic_write(root + "/ssh", "fake-ssh\n")).to_be(true)
    expect(file_atomic_write(root + "/sftp", "fake-sftp\n")).to_be(true)
    expect(file_atomic_write(root + "/known_hosts",
        "worker-1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeTestOnly\n")).to_be(true)
    expect(file_atomic_write(root + "/identity", "fake-key\n")).to_be(true)
    val ssh = TrustedSshNodeV1("worker-1", "127.0.0.1", "builder", 2222,
        root + "/ssh", file_hash_sha256(root + "/ssh"),
        root + "/known_hosts", file_hash_sha256(root + "/known_hosts"),
        root + "/identity", file_hash_sha256(root + "/identity"))
    val sftp = TrustedSftpConfigV1(ssh, root + "/sftp",
        file_hash_sha256(root + "/sftp"), "/srv/simple-build-inbox")
    val node = DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh, "/opt/simple/worker", 30000),
        sftp, source, state, cas)
    val prepared = prepare_build_request_upload_v1(sftp, request,
        source, cas, state)
    expect(prepared.ready).to_be(true)
    PreparedDistributedBuildAttemptV1(true,
        DistributedBuildAttemptV1(false, false, false, false, "prepared",
            AcceptedResult(1, "", "", "", "")),
        prepared, request,
        encode_build_dispatch_v1(action, request.attempt, 1, 2, 8),
        prepared.plan.request_digest, node)

describe "parent parallel transport handoff builder V1":
    it "binds exact prepared batches and request to canonical wire and digest":
        val root = _builder_root_v1()
        val prepared = _builder_fixture_v1(root)
        val deadline = time_now_monotonic_ms() + 300000
        val built = build_parallel_transport_handoff_v1(prepared,
            prepared.approved_node.unwrap(), root + "/result", deadline,
            4, 1048576)
        expect(built.valid).to_be(true)
        expect(built.reason).to_equal("")
        expect(built.digest).to_equal(sha256_u8_hex(built.wire))
        val handoff = parse_parallel_transport_handoff_v1(built.wire)
        expect(handoff.valid).to_be(true)
        expect(handoff.request_digest).to_equal(prepared.request_digest)
        expect(handoff.deadline_tick).to_equal(deadline)
        expect(handoff.result_root).to_equal(root + "/result")
        expect(handoff.input_batch.unwrap().sha256).to_equal(
            sha256_text(prepared.prepared.unwrap().plan.input_plan.batch))
        expect(handoff.control_batch.unwrap().byte_count).to_equal(
            prepared.prepared.unwrap().control_batch.bytes().len())
        val state = prepared.approved_node.unwrap().local_state_dir
        val wrong_state = stage_parallel_transport_handoff_v1(built,
            root + "/wrong-state")
        expect(wrong_state.ready).to_be(false)
        expect(wrong_state.reason).to_equal("handoff-state-root-mismatch")
        val staged = stage_parallel_transport_handoff_v1(built, state)
        expect(staged.ready).to_be(true)
        expect(staged.digest).to_equal(built.digest)
        val read = file_read_regular_no_follow_bounded_bytes(
            staged.handoff_path, 1048576)
        expect(read.is_ok()).to_be(true)
        expect(read.unwrap()).to_equal(built.wire)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects expired deadlines overlapping roots invalid limits and node drift":
        val root = _builder_root_v1()
        val prepared = _builder_fixture_v1(root)
        val node = prepared.approved_node.unwrap()
        val deadline = time_now_monotonic_ms() + 300000
        val expired = build_parallel_transport_handoff_v1(prepared,
            node, root + "/result", 1, 4, 1048576)
        expect(expired.reason).to_equal("handoff-deadline-invalid")
        val overlap = build_parallel_transport_handoff_v1(prepared,
            node, prepared.prepared.unwrap().root + "/result", deadline,
            4, 1048576)
        expect(overlap.reason).to_equal("handoff-policy-invalid")
        val limited = build_parallel_transport_handoff_v1(prepared,
            node, root + "/result", deadline, 132, 1048576)
        expect(limited.reason).to_equal("handoff-policy-invalid")
        val too_few = build_parallel_transport_handoff_v1(prepared,
            node, root + "/result", deadline, 3, 1048576)
        expect(too_few.reason).to_equal("handoff-output-files-too-small")
        var other = node
        other.retained_cas_root = root + "/other-cas"
        val drift = build_parallel_transport_handoff_v1(prepared,
            other, root + "/result", deadline, 4, 1048576)
        expect(drift.reason).to_equal("approved-node-mismatch")
        expect(drift.wire.len()).to_equal(0)
        expect(drift.digest).to_equal("")
        val unstaged = stage_parallel_transport_handoff_v1(drift,
            node.local_state_dir)
        expect(unstaged.ready).to_be(false)
        expect(unstaged.root).to_equal("")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects changed batches and a symlinked batch without deleting preparation":
        val root = _builder_root_v1()
        val prepared = _builder_fixture_v1(root)
        val upload = prepared.prepared.unwrap()
        val deadline = time_now_monotonic_ms() + 300000
        expect(file_atomic_write(upload.input_batch_path,
            "x".repeat(upload.plan.input_plan.batch.bytes().len()))).to_be(true)
        val changed = build_parallel_transport_handoff_v1(prepared,
            prepared.approved_node.unwrap(), root + "/result", deadline,
            4, 1048576)
        expect(changed.reason).to_equal("prepared-batch-mismatch")
        expect(file_atomic_write(upload.input_batch_path,
            "x".repeat(65537))).to_be(true)
        val oversized = build_parallel_transport_handoff_v1(prepared,
            prepared.approved_node.unwrap(), root + "/result", deadline,
            4, 1048576)
        expect(oversized.reason).to_equal("prepared-batch-mismatch")
        expect(file_atomic_write(upload.input_batch_path,
            upload.plan.input_plan.batch)).to_be(true)
        expect(file_rename(upload.input_batch_path,
            upload.root + "/real.batch")).to_be(true)
        val (_, _, code) = process_run_bounded("/bin/ln",
            ["-s", "real.batch", upload.input_batch_path], 5000, 1024)
        expect(code).to_equal(0)
        val linked = build_parallel_transport_handoff_v1(prepared,
            prepared.approved_node.unwrap(), root + "/result", deadline,
            4, 1048576)
        expect(linked.reason).to_equal("prepared-batch-mismatch")
        expect(linked.valid).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects changed ready bytes and a noncanonical admitted dispatch":
        val root = _builder_root_v1()
        var prepared = _builder_fixture_v1(root)
        val node = prepared.approved_node.unwrap()
        val deadline = time_now_monotonic_ms() + 300000
        expect(file_atomic_write(prepared.prepared.unwrap().root +
            "/ready", "changed\n")).to_be(true)
        val changed = build_parallel_transport_handoff_v1(prepared, node,
            root + "/result", deadline, 4, 1048576)
        expect(changed.reason).to_equal("prepared-control-mismatch")
        prepared.dispatch_wire = prepared.dispatch_wire + "\n"
        val dispatch = build_parallel_transport_handoff_v1(prepared, node,
            root + "/result", deadline, 4, 1048576)
        expect(dispatch.reason).to_equal("prepared-request-mismatch")
        expect(dir_remove_all(root)).to_be(true)
