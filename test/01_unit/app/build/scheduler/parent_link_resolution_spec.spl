use std.spec.*
use app.build.scheduler.parent_link_template.{ParentLinkInputV1,
    ParentLinkTemplateV1, parent_link_template_problem_v1}
use app.build.scheduler.parent_link_resolution.{resolve_parent_link_v1,
    resolved_parent_link_request_v1}
use app.build.scheduler.worker_request.{encode_build_worker_request_v1}
use app.build.scheduler.ledger.{SchedulerAttemptV1, SchedulerLedgerV1,
    empty_scheduler_ledger_v1}
use app.build.scheduler.retained_binary_cas.{retained_binary_cas_put_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_write_bytes}
use compiler.driver.cache.cas_store.{cas_put, cas_blob_path}
use compiler.common.build_contract.{AcceptedResult, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec}
use std.common.crypto.sha256.{sha256_text}

val LINK_PRODUCER_A = sha256_text("cold-link-producer-a")
val LINK_PRODUCER_B = sha256_text("cold-link-producer-b")
val LINK_DIAGNOSTIC = sha256_text("cold-link-diagnostic")

fn _link_root_v1() -> text:
    cwd() + "/build/test/parent-link-" + getpid().to_text() + "-" +
        time_now_unix_micros().to_text()

fn _link_archive_v1(payload: text) -> [u8]:
    ("!<arch>\n" + "unit.o/         " + "0           " + "0     " +
        "0     " + "100644  " + "4         " + "`\n" + payload).bytes()

fn _link_manifest_v1(producer: text, attempt_id: text,
        worker: text, name: text, size: i64, digest: text) -> text:
    "simple-build-output-manifest-v1\n" +
        "action=" + producer + "\n" +
        "attempt=" + attempt_id + "\n" +
        "worker=" + worker + "\n" +
        "fence=1\n" +
        "diagnostics=" + LINK_DIAGNOSTIC + "\n" +
        "count=1\n" + name + "|" + size.to_text() + "|" + digest + "\n"

fn _link_ledger_v1(wire_a: text, wire_b: text) -> SchedulerLedgerV1:
    SchedulerLedgerV1(
        [SchedulerAttemptV1(LINK_PRODUCER_A, "try-a", "worker-a", 1,
            1, 4096, 8, false),
         SchedulerAttemptV1(LINK_PRODUCER_B, "try-b", "worker-b", 1,
            1, 4096, 8, false)],
        [],
        [AcceptedResult(1, LINK_PRODUCER_A, "try-a", sha256_text(wire_a),
            sha256_text("receipt-a")),
         AcceptedResult(1, LINK_PRODUCER_B, "try-b", sha256_text(wire_b),
            sha256_text("receipt-b"))], [])

fn _link_template_v1() -> ParentLinkTemplateV1:
    val snapshot = sha256_text("cold-link-snapshot")
    val action = ActionSpec(1, "link",
        SnapshotManifest(1, snapshot, snapshot, snapshot),
        ToolchainManifest(1, snapshot, snapshot, snapshot, snapshot,
            snapshot, "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot, [], [], [], [], [], [], snapshot,
            true, false),
        ["cc", "liba.a", "libb.a", "-o", "program"],
        "simple-build/outputs", snapshot, ["program"], snapshot)
    ParentLinkTemplateV1(action,
        [ParentLinkInputV1(LINK_PRODUCER_A, "liba.a", 1),
         ParentLinkInputV1(LINK_PRODUCER_B, "libb.a", 2)])

describe "cold link resolution from accepted retained outputs":
    it "waits for producers, then binds byte-verified objects in link order":
        val root = _link_root_v1()
        expect(dir_create_all(root)).to_be(true)
        val template = _link_template_v1()
        expect(parent_link_template_problem_v1(template)).to_equal("")
        expect(resolve_parent_link_v1(template,
            empty_scheduler_ledger_v1(), root).valid).to_be(false)

        val archive_a = _link_archive_v1("ABCD")
        val archive_b = _link_archive_v1("WXYZ")
        val digest_a = retained_binary_cas_put_v1(root, "liba.a", archive_a)
        val digest_b = retained_binary_cas_put_v1(root, "libb.a", archive_b)
        expect(digest_a != "").to_be(true)
        expect(digest_b != "").to_be(true)
        val wire_a = _link_manifest_v1(LINK_PRODUCER_A, "try-a",
            "worker-a", "liba.a", archive_a.len(), digest_a)
        val wire_b = _link_manifest_v1(LINK_PRODUCER_B, "try-b",
            "worker-b", "libb.a", archive_b.len(), digest_b)
        expect(cas_put(root, wire_a)).to_equal(sha256_text(wire_a))
        expect(cas_put(root, wire_b)).to_equal(sha256_text(wire_b))
        val ledger = _link_ledger_v1(wire_a, wire_b)
        val resolved = resolve_parent_link_v1(template, ledger, root)
        expect(resolved.valid).to_be(true)
        expect(resolved.action_digest != "").to_be(true)
        if val action = resolved.action:
            expect(action.argv[1]).to_equal("/simple-build/inputs/liba.a")
            expect(action.argv[2]).to_equal("/simple-build/inputs/libb.a")
            expect(action.inputs.dependency_outputs.len()).to_equal(2)
            expect(action.inputs.dependency_outputs[0].content_digest)
                .to_equal(digest_a)
            expect(action.inputs.dependency_outputs[1].content_digest)
                .to_equal(digest_b)
        else:
            assert(false)
        val repeated = resolve_parent_link_v1(template, ledger, root)
        expect(repeated.action_digest).to_equal(resolved.action_digest)
        val request = resolved_parent_link_request_v1(resolved,
            AttemptSpec(1, "", "link-try", "worker-link", 0, 1, 4096),
            1, 1, 8)
        expect(request.?).to_be(true)
        if val exact = request:
            expect(exact.attempt.action_digest)
                .to_equal(resolved.action_digest)
            expect(encode_build_worker_request_v1(exact) != "").to_be(true)
        else:
            assert(false)

        val changed_b = _link_archive_v1("ZYXW")
        val changed_digest_b = retained_binary_cas_put_v1(root,
            "libb.a", changed_b)
        expect(changed_digest_b != digest_b).to_be(true)
        val changed_wire_b = _link_manifest_v1(LINK_PRODUCER_B, "try-b",
            "worker-b", "libb.a", changed_b.len(), changed_digest_b)
        expect(cas_put(root, changed_wire_b))
            .to_equal(sha256_text(changed_wire_b))
        val changed = resolve_parent_link_v1(template,
            _link_ledger_v1(wire_a, changed_wire_b), root)
        expect(changed.valid).to_be(true)
        expect(changed.action_digest == resolved.action_digest).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects missing CAS bytes, changed manifests and ambiguous names":
        val root = _link_root_v1()
        expect(dir_create_all(root)).to_be(true)
        val template = _link_template_v1()
        val archive_a = _link_archive_v1("ABCD")
        val archive_b = _link_archive_v1("WXYZ")
        val digest_a = retained_binary_cas_put_v1(root, "liba.a", archive_a)
        val missing_digest_b = sha256_text("unavailable archive")
        val wire_a = _link_manifest_v1(LINK_PRODUCER_A, "try-a",
            "worker-a", "liba.a", archive_a.len(), digest_a)
        val missing_wire_b = _link_manifest_v1(LINK_PRODUCER_B, "try-b",
            "worker-b", "libb.a", archive_b.len(), missing_digest_b)
        expect(cas_put(root, wire_a)).to_equal(sha256_text(wire_a))
        expect(cas_put(root, missing_wire_b))
            .to_equal(sha256_text(missing_wire_b))
        expect(resolve_parent_link_v1(template,
            _link_ledger_v1(wire_a, missing_wire_b), root).valid)
            .to_be(false)
        val digest_b = retained_binary_cas_put_v1(root, "libb.a", archive_b)
        expect(digest_b != "").to_be(true)
        val wire_b = _link_manifest_v1(LINK_PRODUCER_B, "try-b",
            "worker-b", "libb.a", archive_b.len(), digest_b)
        expect(cas_put(root, wire_b)).to_equal(sha256_text(wire_b))
        val wrong_manifest_path = cas_blob_path(root, sha256_text(wire_a))
        expect(file_write_bytes(wrong_manifest_path, "changed".bytes()))
            .to_be(true)
        expect(resolve_parent_link_v1(template,
            _link_ledger_v1(wire_a, wire_b), root).valid).to_be(false)
        var ambiguous = template
        var ambiguous_action = ambiguous.base_action
        ambiguous_action.argv = ["cc", "liba.a", "liba.a", "-o", "program"]
        ambiguous.base_action = ambiguous_action
        ambiguous.ordered_inputs = [
            ParentLinkInputV1(LINK_PRODUCER_A, "liba.a", 1),
            ParentLinkInputV1(LINK_PRODUCER_B, "liba.a", 2)]
        expect(parent_link_template_problem_v1(ambiguous) != "")
            .to_be(true)
        expect(dir_remove_all(root)).to_be(true)
