use std.spec.*
use app.build.scheduler.worker_attempt_binding.{
    parse_worker_attempt_binding_v1}
use app.build.scheduler.worker_terminal_observation.{
    persist_worker_terminal_observation_v1,
    recover_worker_terminal_observation_v1}
use app.io.mod.{cwd, dir_create_all, file_atomic_write,
    getpid, time_now_unix_micros}
use std.common.crypto.sha256.{sha256_text}

fn _recovery_binding_v1(root: text, request: text, boot: text) -> text:
    "simple-worker-binding-v1\nrequest=" + request +
        "\nworker=node-a\nattempt=try-1\nfence=7\nboot=" + boot +
        "\ngeneration=3\nengine=podman\noperation=build-7\n" +
        "image=repo@sha256:" + sha256_text("image") +
        "\nstage=" + root + "/build-attempts/try-1-7-ABC123" +
        "\nnative=abc123\n"

describe "durable worker terminal observation":
    it "requires a complete binding for live recovery but permits completed replay":
        val root = cwd() + "/build/test/worker-recovery-binding-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val request = sha256_text("request")
        val image = "repo@sha256:" + sha256_text("image")
        val wire = _recovery_binding_v1(root, request, "boot-old")
        val live = parse_worker_attempt_binding_v1(wire, root, request,
            "node-a", "try-1", 7, "boot-old", 3, "podman", image, true)
        expect(live.valid).to_be(true)
        expect(live.native_id).to_equal("abc123")
        expect(parse_worker_attempt_binding_v1(wire, root, request,
            "node-a", "try-1", 7, "boot-new", 3, "podman", image,
            true).valid).to_be(false)
        expect(parse_worker_attempt_binding_v1(wire, root, request,
            "node-a", "try-1", 7, "boot-new", 3, "podman", image,
            false).valid).to_be(true)
        expect(parse_worker_attempt_binding_v1(wire.replace("native=abc123",
            "native=../other"), root, request, "node-a", "try-1", 7,
            "boot-old", 3, "podman", image, true).valid).to_be(false)

    it "recovers only the exact request, binding and known compiler exit":
        val root = cwd() + "/build/test/worker-terminal-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val request = sha256_text("request")
        val binding = sha256_text(_recovery_binding_v1(root, request, "boot-a"))
        val recorded = persist_worker_terminal_observation_v1(root,
            request, binding, "try-1", 7, 42)
        expect(recorded.recorded).to_be(true)
        val recovered = recover_worker_terminal_observation_v1(root,
            request, binding, "try-1", 7)
        expect(recovered.recorded).to_be(true)
        expect(recovered.exit_code).to_equal(42)
        expect(recover_worker_terminal_observation_v1(root,
            request, sha256_text("other binding"), "try-1", 7)
            .recorded).to_be(false)
        expect(persist_worker_terminal_observation_v1(root,
            request, binding, "try-1", 7, 0).recorded).to_be(false)
        expect(persist_worker_terminal_observation_v1(root,
            request, binding, "try-2", 7, -1).recorded).to_be(false)

    it "distinguishes missing observation from a corrupt one":
        val root = cwd() + "/build/test/worker-terminal-corrupt-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val request = sha256_text("request")
        val binding = sha256_text("binding")
        val missing = recover_worker_terminal_observation_v1(root,
            request, binding, "try-1", 7)
        expect(missing.reason).to_equal("terminal-observation-unavailable")
        expect(file_atomic_write(root + "/worker-attempt-try-1.terminal",
            "corrupt\n")).to_be(true)
        val corrupt = recover_worker_terminal_observation_v1(root,
            request, binding, "try-1", 7)
        expect(corrupt.recorded).to_be(false)
        expect(corrupt.reason).to_equal("terminal-observation-mismatch")
