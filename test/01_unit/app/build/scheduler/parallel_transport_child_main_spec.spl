use std.spec.*
use app.build.scheduler.parallel_transport_child_main.{
    parse_parallel_transport_child_args_v1}
use std.common.crypto.sha256.{sha256_text}

describe "parallel transport child CLI V1":
    it "accepts only an absolute handoff path and a canonical digest":
        val digest = sha256_text("parent-handoff")
        val parsed = parse_parallel_transport_child_args_v1([
            "--handoff", "/trusted/attempt/handoff.wire",
            "--digest", digest])
        expect(parsed.valid).to_be(true)
        expect(parsed.handoff_path).to_equal(
            "/trusted/attempt/handoff.wire")
        expect(parsed.handoff_digest).to_equal(digest)
        expect(parse_parallel_transport_child_args_v1([
            "--handoff", "../handoff.wire", "--digest", digest]).valid
        ).to_be(false)
        expect(parse_parallel_transport_child_args_v1([
            "--handoff", "/trusted/../handoff.wire", "--digest",
            digest]).valid).to_be(false)
        expect(parse_parallel_transport_child_args_v1([
            "--handoff", "/trusted/handoff.wire", "--digest",
            digest.upper()]).valid).to_be(false)
        expect(parse_parallel_transport_child_args_v1([
            "--handoff", "/trusted/handoff.wire", "--digest",
            digest, "extra"]).valid).to_be(false)
