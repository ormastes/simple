use app.build.scheduler.parent_request_spool.{
    parent_request_matches_active_attempt_v1,
    parent_request_matches_completed_attempt_v1}
use app.build.scheduler.parent_cleanup_pending.{
    parent_cleanup_candidate_committed_v1}
use app.build.scheduler.broker.{scheduler_accept_receipt_digest_v1}
use app.build.scheduler.ledger.{SchedulerAttemptV1, SchedulerLedgerV1,
    SchedulerFailedAttemptV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    AcceptedResult, ActionResultCandidate, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn _spool_request_v1() -> BuildWorkerRequestV1:
    val snapshot = sha256_text("spool snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("source"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/answer.c", sha256_text("source bytes"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["cc", "-c"], "src", sha256_text("sandbox"),
        ["answer.o"], sha256_text("resources"))
    val attempt = AttemptSpec(1, action_spec_digest_v1(action),
        "try-1", "node-a", 0, 0, 4096)
    BuildWorkerRequestV1(action, attempt, 7, 1, 8)

describe "durable parent request binding":
    it "matches every persisted dispatch fact for the active attempt":
        val request = _spool_request_v1()
        val active = SchedulerAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 7, 1, 4096, 8, true)
        expect(parent_request_matches_active_attempt_v1(request,
            active)).to_be(true)

    it "rejects a changed fence or an inactive attempt after restart":
        val request = _spool_request_v1()
        val stale = SchedulerAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 8, 1, 4096, 8, true)
        val closed = SchedulerAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 7, 1, 4096, 8, false)
        expect(parent_request_matches_active_attempt_v1(request,
            stale)).to_be(false)
        expect(parent_request_matches_active_attempt_v1(request,
            closed)).to_be(false)

    it "reloads a completed spool only for an exact durable outcome":
        val request = _spool_request_v1()
        val closed = SchedulerAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 7, 1, 4096, 8, false)
        val accepted = AcceptedResult(1, request.attempt.action_digest,
            "try-1", sha256_text("output"), sha256_text("receipt"))
        val successful = SchedulerLedgerV1([closed], [], [accepted], [])
        expect(parent_request_matches_completed_attempt_v1(request,
            successful)).to_be(true)
        val compiler_failure = SchedulerFailedAttemptV1(
            request.attempt.action_digest, "try-1", "node-a", 7,
            "compiler-failure", "", sha256_text("diagnostics"))
        val failed = SchedulerLedgerV1([closed], [], [], [compiler_failure])
        expect(parent_request_matches_completed_attempt_v1(request,
            failed)).to_be(true)
        val cancelled = SchedulerFailedAttemptV1(
            request.attempt.action_digest, "try-1", "node-a", 7,
            "cancelled", "", sha256_text("diagnostics"))
        expect(parent_request_matches_completed_attempt_v1(request,
            SchedulerLedgerV1([closed], [], [], [cancelled]))).to_be(false)
        expect(parent_request_matches_completed_attempt_v1(request,
            SchedulerLedgerV1([closed], [], [], []))).to_be(false)

    it "rejects cleanup of result A when the parent committed result B":
        val request = _spool_request_v1()
        val closed = SchedulerAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 7, 1, 4096, 8, false)
        val candidate_a = ActionResultCandidate(1, request.attempt.action_digest,
            "try-1", "node-a", sha256_text("output"),
            sha256_text("diagnostics A"), true)
        val candidate_b = ActionResultCandidate(1, request.attempt.action_digest,
            "try-1", "node-a", sha256_text("output"),
            sha256_text("diagnostics B"), true)
        val accepted_b = AcceptedResult(1, request.attempt.action_digest,
            "try-1", candidate_b.output_manifest_digest,
            scheduler_accept_receipt_digest_v1(candidate_b, 7))
        val success = SchedulerLedgerV1([closed], [], [accepted_b], [])
        expect(parent_cleanup_candidate_committed_v1(request,
            candidate_b, success)).to_be(true)
        expect(parent_cleanup_candidate_committed_v1(request,
            candidate_a, success)).to_be(false)
        val failed_b = SchedulerFailedAttemptV1(request.attempt.action_digest,
            "try-1", "node-a", 7, "compiler-failure", "",
            sha256_text("diagnostics B"))
        val failure = SchedulerLedgerV1([closed], [], [], [failed_b])
        val failure_a = ActionResultCandidate(1, request.attempt.action_digest,
            "try-1", "node-a", "", sha256_text("diagnostics A"), false)
        val failure_b = ActionResultCandidate(1, request.attempt.action_digest,
            "try-1", "node-a", "", sha256_text("diagnostics B"), false)
        expect(parent_cleanup_candidate_committed_v1(request,
            failure_b, failure)).to_be(true)
        expect(parent_cleanup_candidate_committed_v1(request,
            failure_a, failure)).to_be(false)
