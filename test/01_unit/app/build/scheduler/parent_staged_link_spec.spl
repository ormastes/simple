use std.spec.*
use app.build.scheduler.parent_staged_link.{ParentStagedLinkPlanV1,
    parent_staged_link_plan_digest_v1, prepare_parent_staged_link_v1}
use app.build.scheduler.parent_link_template.{ParentLinkInputV1,
    ParentLinkTemplateV1}
use app.build.scheduler.parent_link_template_wire.{
    load_pinned_parent_link_template_v1}
use app.build.scheduler.parent_staged_link_cli.{
    run_parent_staged_link_cli_v1}
use app.build.scheduler.parent_issued_plan_issuer.{
    issue_approved_parent_staged_plan_v1}
use app.build.scheduler.parent_issued_plan_store.{
    load_issued_parent_plan_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_exists, file_write_bytes}

val STAGED_DIGEST = sha256_text("staged-link-fixture")

fn _staged_config_v1() -> text:
    "simple-dist-build-parent-v2\n" +
    "graph=/trusted/graph.manifest\n" +
    "owner=/trusted/owner\n" +
    "source=/trusted/source\n" +
    "state=/trusted/state\n" +
    "cas=/trusted/cas\n" +
    "ssh-executable=/usr/bin/ssh\n" +
    "ssh-digest=" + STAGED_DIGEST + "\n" +
    "sftp-executable=/usr/bin/sftp\n" +
    "sftp-digest=" + STAGED_DIGEST + "\n" +
    "known-hosts=/trusted/known-hosts\n" +
    "known-hosts-digest=" + STAGED_DIGEST + "\n" +
    "identity=/trusted/identity\n" +
    "identity-digest=" + STAGED_DIGEST + "\n" +
    "worker-id=worker-1\n" +
    "host=build.example\n" +
    "user=builder\n" +
    "port=22\n" +
    "remote-executable=/usr/local/bin/simple-build-worker\n" +
    "inbox=/srv/simple-build-inbox\n" +
    "trust-domain=trusted\n" +
    "target-triple=x86_64-unknown-linux-gnu\n" +
    "provider-abi=" + STAGED_DIGEST + "\n" +
    "worker-memory=8192\n" +
    "scheduler-cpu=2\n" +
    "scheduler-memory=8192\n" +
    "scheduler-memory-reserve=512\n" +
    "scheduler-fd=8\n" +
    "timeout-ms=30000\n"

fn _staged_producer_v1() -> BuildWorkerRequestV1:
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, STAGED_DIGEST, STAGED_DIGEST, STAGED_DIGEST),
        ToolchainManifest(1, STAGED_DIGEST, STAGED_DIGEST, STAGED_DIGEST,
            STAGED_DIGEST, STAGED_DIGEST, "x86_64-unknown-linux-gnu"),
        InputManifest(1, STAGED_DIGEST,
            [BuildInputRef("a.c", sha256_text("int a;"))],
            [], [], [], [], [], STAGED_DIGEST, true, false),
        ["/usr/bin/clang", "-c", "/simple-build/inputs/a.c",
         "-o", "liba.o"],
        "simple-build/outputs", STAGED_DIGEST, ["liba.o"], STAGED_DIGEST)
    BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action),
            "template-producer", "worker-1", 0, 0, 4096), 1, 1, 8)

fn _staged_link_template_v1(producer_digest: text) -> ParentLinkTemplateV1:
    val action = ActionSpec(1, "link",
        SnapshotManifest(1, STAGED_DIGEST, STAGED_DIGEST, STAGED_DIGEST),
        ToolchainManifest(1, STAGED_DIGEST, STAGED_DIGEST, STAGED_DIGEST,
            STAGED_DIGEST, STAGED_DIGEST, "x86_64-unknown-linux-gnu"),
        InputManifest(1, STAGED_DIGEST, [], [], [], [], [], [],
            STAGED_DIGEST, true, false),
        ["/usr/bin/clang", "liba.o", "-o", "program"],
        "simple-build/outputs", STAGED_DIGEST, ["program"], STAGED_DIGEST)
    ParentLinkTemplateV1(action,
        [ParentLinkInputV1(producer_digest, "liba.o", 1)])

fn _staged_manifest_v1(request_wire: text) -> text:
    "simple-dist-build-graph-v1\nrequest=" +
        sha256_text(request_wire) + "|/trusted/producer.request\n"

fn _staged_plan_v1(producer_digest: text,
        manifest_wire: text) -> ParentStagedLinkPlanV1:
    var plan = ParentStagedLinkPlanV1(sha256_text(manifest_wire),
        sha256_text("canonical-link-template-fixture"),
        [_staged_config_v1()], _staged_link_template_v1(producer_digest),
        AttemptSpec(1, "", "template-link", "worker-1", 0, 0, 4096),
        1, 8, "")
    plan.expected_plan_digest = parent_staged_link_plan_digest_v1(plan)
    plan

describe "protected staged compile-to-link plan":
    it "pins producer bytes, template and worker policy before dispatch":
        val producer = _staged_producer_v1()
        val wire = encode_build_worker_request_v1(producer)
        expect(wire != "").to_be(true)
        val manifest = _staged_manifest_v1(wire)
        val plan = _staged_plan_v1(producer.attempt.action_digest, manifest)
        expect(plan.expected_plan_digest != "").to_be(true)
        val prepared = prepare_parent_staged_link_v1(plan,
            manifest, [wire])
        expect(prepared.valid).to_be(true)
        expect(prepared.graph.?).to_be(true)

        var template_drift = plan
        var changed_template = template_drift.template
        var changed_action = changed_template.base_action
        changed_action.argv = ["/usr/bin/clang", "liba.o", "-o",
            "different-program"]
        changed_template.base_action = changed_action
        template_drift.template = changed_template
        expect(prepare_parent_staged_link_v1(template_drift,
            manifest, [wire]).reason).to_equal("staged-plan-digest-mismatch")

        var template_wire_drift = plan
        template_wire_drift.template_wire_digest =
            sha256_text("changed-canonical-template-wire")
        expect(prepare_parent_staged_link_v1(template_wire_drift,
            manifest, [wire]).reason).to_equal("staged-plan-digest-mismatch")

        var policy_drift = plan
        policy_drift.worker_config_wires = [_staged_config_v1().replace(
            "provider-abi=" + STAGED_DIGEST,
            "provider-abi=" + sha256_text("other-abi"))]
        expect(prepare_parent_staged_link_v1(policy_drift,
            manifest, [wire]).reason).to_equal("staged-plan-digest-mismatch")
        expect(prepare_parent_staged_link_v1(plan,
            manifest, [wire + "x"]).reason)
            .to_equal("staged-producer-request-mismatch")

    it "rejects a link template whose producer is absent from the pinned graph":
        val producer = _staged_producer_v1()
        val wire = encode_build_worker_request_v1(producer)
        val manifest = _staged_manifest_v1(wire)
        val plan = _staged_plan_v1(sha256_text("different producer"),
            manifest)
        expect(prepare_parent_staged_link_v1(plan, manifest, [wire]).reason)
            .to_equal("staged-template-producer-missing")

    it "rejects a link template naming an undeclared producer output":
        val producer = _staged_producer_v1()
        val wire = encode_build_worker_request_v1(producer)
        val manifest = _staged_manifest_v1(wire)
        var plan = _staged_plan_v1(producer.attempt.action_digest,
            manifest)
        var template = plan.template
        var action = template.base_action
        action.argv = ["/usr/bin/clang", "missing.o", "-o", "program"]
        template.base_action = action
        template.ordered_inputs = [ParentLinkInputV1(
            producer.attempt.action_digest, "missing.o", 1)]
        plan.template = template
        plan.expected_plan_digest = parent_staged_link_plan_digest_v1(plan)
        expect(plan.expected_plan_digest != "").to_be(true)
        expect(prepare_parent_staged_link_v1(plan, manifest, [wire]).reason)
            .to_equal("staged-template-output-undeclared")

    it "loads only exact pinned template and base-request bytes":
        val root = cwd() + "/build/test/staged-template-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val producer = _staged_producer_v1()
        val base_action = _staged_link_template_v1(
            producer.attempt.action_digest).base_action
        val base = BuildWorkerRequestV1(base_action,
            AttemptSpec(1, action_spec_digest_v1(base_action),
                "template-link", "worker-1", 0, 0, 4096), 1, 1, 8)
        val base_wire = encode_build_worker_request_v1(base)
        expect(base_wire != "").to_be(true)
        val base_path = root + "/base.request"
        val template_path = root + "/link.template"
        val template_wire = "simple-parent-link-template-v1\n" +
            "base-request=" + sha256_text(base_wire) + "|" + base_path +
            "\ninput=" + producer.attempt.action_digest + "|liba.o|1\n"
        expect(file_write_bytes(base_path, base_wire.bytes())).to_be(true)
        expect(file_write_bytes(template_path, template_wire.bytes()))
            .to_be(true)
        val pinned = sha256_text(template_wire)
        val loaded = load_pinned_parent_link_template_v1(template_path, pinned)
        expect(loaded.valid).to_be(true)
        expect(loaded.template.?).to_be(true)
        expect(loaded.attempt.?).to_be(true)
        expect(loaded.template_wire_digest).to_equal(pinned)

        expect(file_write_bytes(template_path,
            (template_wire + "input=extra\n").bytes())).to_be(true)
        expect(load_pinned_parent_link_template_v1(template_path,
            pinned).valid).to_be(false)
        expect(file_write_bytes(template_path, template_wire.bytes()))
            .to_be(true)
        expect(file_write_bytes(base_path, "changed".bytes())).to_be(true)
        expect(load_pinned_parent_link_template_v1(template_path,
            pinned).valid).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects changed pinned CLI inputs before opening the parent owner":
        val root = cwd() + "/build/test/staged-cli-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root)).to_be(true)
        val producer = _staged_producer_v1()
        val producer_wire = encode_build_worker_request_v1(producer)
        val producer_path = root + "/producer.request"
        val manifest_path = root + "/graph.manifest"
        val manifest_wire = "simple-dist-build-graph-v1\nrequest=" +
            sha256_text(producer_wire) + "|" + producer_path + "\n"
        val base_action = _staged_link_template_v1(
            producer.attempt.action_digest).base_action
        val base = BuildWorkerRequestV1(base_action,
            AttemptSpec(1, action_spec_digest_v1(base_action),
                "template-link", "worker-1", 0, 0, 4096), 1, 1, 8)
        val base_wire = encode_build_worker_request_v1(base)
        val base_path = root + "/base.request"
        val template_path = root + "/link.template"
        val template_wire = "simple-parent-link-template-v1\n" +
            "base-request=" + sha256_text(base_wire) + "|" + base_path +
            "\ninput=" + producer.attempt.action_digest + "|liba.o|1\n"
        val config_path = root + "/worker.conf"
        val owner_path = root + "/owner"
        val config_wire = _staged_config_v1().replace(
            "graph=/trusted/graph.manifest", "graph=" + manifest_path)
            .replace("owner=/trusted/owner", "owner=" + owner_path)
        expect(file_write_bytes(producer_path, producer_wire.bytes()))
            .to_be(true)
        expect(file_write_bytes(manifest_path, manifest_wire.bytes()))
            .to_be(true)
        expect(file_write_bytes(base_path, base_wire.bytes())).to_be(true)
        expect(file_write_bytes(template_path, template_wire.bytes()))
            .to_be(true)
        expect(file_write_bytes(config_path, config_wire.bytes()))
            .to_be(true)
        val template_digest = sha256_text(template_wire)
        val loaded = load_pinned_parent_link_template_v1(
            template_path, template_digest)
        expect(loaded.valid).to_be(true)
        var plan = ParentStagedLinkPlanV1(sha256_text(manifest_wire),
            loaded.template_wire_digest, [config_wire],
            loaded.template.unwrap(), loaded.attempt.unwrap(),
            loaded.cpu_tokens, loaded.fd_tokens, "")
        val plan_digest = parent_staged_link_plan_digest_v1(plan)
        expect(plan_digest != "").to_be(true)
        plan.expected_plan_digest = plan_digest
        expect(prepare_parent_staged_link_v1(plan, manifest_wire,
            [producer_wire]).valid).to_be(true)
        val args = ["--staged-plan-digest", plan_digest,
            "--template", template_path,
            "--template-digest", template_digest,
            "--config", config_path]
        val admin_root = root + "/admin"
        expect(dir_create_all(admin_root + "/staged-plans"))
            .to_be(true)
        val unapproved = issue_approved_parent_staged_plan_v1(
            admin_root, sha256_text("different-approved-plan"),
            template_path, template_digest, [config_path])
        expect(unapproved.published).to_be(false)
        expect(unapproved.record_digest).to_equal("")
        val issued = issue_approved_parent_staged_plan_v1(admin_root,
            plan_digest, template_path, template_digest, [config_path])
        expect(issued.published).to_be(true)
        expect(issued.durable).to_be(true)
        expect(load_issued_parent_plan_v1(admin_root,
            issued.record_digest).valid).to_be(true)

        val changed_config = config_wire.replace(
            "host=build.example", "host=another-build.example")
        var changed_config_plan = plan
        changed_config_plan.worker_config_wires = [changed_config]
        changed_config_plan.expected_plan_digest =
            parent_staged_link_plan_digest_v1(changed_config_plan)
        expect(changed_config_plan.expected_plan_digest != "").to_be(true)
        expect(prepare_parent_staged_link_v1(changed_config_plan,
            manifest_wire, [producer_wire]).valid).to_be(true)
        expect(file_write_bytes(config_path, changed_config.bytes()))
            .to_be(true)
        expect(issue_approved_parent_staged_plan_v1(admin_root,
            plan_digest, template_path, template_digest,
            [config_path]).published).to_be(false)
        expect(run_parent_staged_link_cli_v1(args)).to_equal(1)
        expect(file_exists(owner_path)).to_be(false)

        expect(file_write_bytes(config_path, config_wire.bytes()))
            .to_be(true)
        val second_base_path = root + "/second-base.request"
        expect(file_write_bytes(second_base_path, base_wire.bytes()))
            .to_be(true)
        val changed_template_wire = template_wire.replace(
            base_path, second_base_path)
        expect(file_write_bytes(template_path,
            changed_template_wire.bytes())).to_be(true)
        val second_digest = sha256_text(changed_template_wire)
        val second_loaded = load_pinned_parent_link_template_v1(
            template_path, second_digest)
        expect(second_loaded.valid).to_be(true)
        var changed_template_plan = ParentStagedLinkPlanV1(
            sha256_text(manifest_wire), second_loaded.template_wire_digest,
            [config_wire], second_loaded.template.unwrap(),
            second_loaded.attempt.unwrap(), second_loaded.cpu_tokens,
            second_loaded.fd_tokens, "")
        changed_template_plan.expected_plan_digest =
            parent_staged_link_plan_digest_v1(changed_template_plan)
        expect(changed_template_plan.expected_plan_digest != "").to_be(true)
        expect(prepare_parent_staged_link_v1(changed_template_plan,
            manifest_wire, [producer_wire]).valid).to_be(true)
        expect(run_parent_staged_link_cli_v1(args)).to_equal(1)
        expect(file_exists(owner_path)).to_be(false)
        expect(dir_remove_all(root)).to_be(true)
