use std.spec.*
use std.common.crypto.sha256.{sha256_u8_hex}
use app.io.mod.{cwd, secure_temp_dir, dir_create_all, dir_remove_all,
    file_write, file_write_bytes, file_delete}
use app.build.scheduler.dist_exec_artifact_snapshot.{DistExecArtifactSnapshotV1}
use app.build.scheduler.dist_exec_result_store.{read_dist_exec_untrusted_result_v1}

fn _store_nonce_v1() -> text:
    "0123456789abcdef0123456789abcdef"

fn _store_leaf_v1() -> text:
    "result-" + _store_nonce_v1() + "-aZ019x"

fn _store_fixture_v1(state: text) -> DistExecArtifactSnapshotV1:
    expect(dir_create_all(state + "/build-attempts")).to_be(true)
    val root = secure_temp_dir(state + "/build-attempts", "pod-a-1").unwrap()
    expect(dir_create_all(root + "/inputs")).to_be(true)
    expect(dir_create_all(root + "/outputs/" + _store_leaf_v1())).to_be(true)
    # A deliberately constructed record demonstrates bookkeeping, not attestation.
    DistExecArtifactSnapshotV1(true, "", root, root + "/inputs/artifact",
        sha256_u8_hex([65]), 1, false, false, root + "/inputs", root + "/outputs")

fn _store_receipt_v1(bytes: [u8]) -> text:
    "simple-dist-exec-worker-result-v1\nnonce=" + _store_nonce_v1() +
        "\nartifact-sha256=" + sha256_u8_hex([65]) + "\nexit-code=0\nstdout-bytes=" +
        bytes.len().to_text() + "\nstdout-sha256=" + sha256_u8_hex(bytes) +
        "\nstderr-bytes=0\nv4-binding=" + sha256_u8_hex([]) + "\n"

fn _store_publish_v1(snapshot: DistExecArtifactSnapshotV1, bytes: [u8]):
    val result_root = snapshot.build_output_root + "/" + _store_leaf_v1()
    expect(file_write_bytes(result_root + "/stdout.bin", bytes)).to_be(true)
    expect(file_write(result_root + "/receipt", _store_receipt_v1(bytes))).to_be(true)
    expect(file_write(snapshot.build_output_root + "/committed",
        "/simple-build/outputs/" + _store_leaf_v1() + "\n")).to_be(true)

describe "untrusted committed result store":
    it "retains NUL and non-UTF8 stdout bytes with the exact selected receipt":
        val state = secure_temp_dir(cwd(), "result-store").unwrap()
        val snapshot = _store_fixture_v1(state)
        val bytes: [u8] = [0, 255, 128, 10, 65]
        _store_publish_v1(snapshot, bytes)
        val read = read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5)
        expect(read.is_ok()).to_be(true)
        val stored = read.unwrap()
        expect(stored.stdout).to_equal(bytes)
        expect(stored.result.leaf_name).to_equal(_store_leaf_v1())
        expect(stored.result.stdout_sha256).to_equal(sha256_u8_hex(bytes))
        _store_publish_v1(snapshot, [])
        val empty = read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 1).unwrap()
        expect(empty.stdout.len()).to_equal(0)
        expect(dir_remove_all(state)).to_be(true)

    it "rejects missing pointer wrong attempt nonce caps and unready bookkeeping":
        val state = secure_temp_dir(cwd(), "result-store-identity").unwrap()
        var snapshot = _store_fixture_v1(state)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        _store_publish_v1(snapshot, [65])
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 2,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-b", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            "ffffffffffffffffffffffffffffffff", 5).is_err()).to_be(true)
        for cap in [0, -1, 16777217]:
            expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
                _store_nonce_v1(), cap).is_err()).to_be(true)
        snapshot.ready = false
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        snapshot.ready = true
        snapshot.build_output_root = state + "/elsewhere"
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        expect(dir_remove_all(state)).to_be(true)

    it "rejects extra receipt fields changed bytes and oversized stdout":
        val state = secure_temp_dir(cwd(), "result-store-bytes").unwrap()
        val snapshot = _store_fixture_v1(state)
        val result_root = snapshot.build_output_root + "/" + _store_leaf_v1()
        _store_publish_v1(snapshot, [65])
        expect(file_write(result_root + "/receipt", _store_receipt_v1([65]) + "extra=1\n")).to_be(true)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        _store_publish_v1(snapshot, [65])
        expect(file_write_bytes(result_root + "/stdout.bin", [66])).to_be(true)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        _store_publish_v1(snapshot, [65, 66])
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 1).is_err()).to_be(true)
        expect(file_delete(result_root + "/receipt")).to_be(true)
        expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
            _store_nonce_v1(), 5).is_err()).to_be(true)
        expect(dir_remove_all(state)).to_be(true)

    it "rejects pointer traversal extra lines and a missing exact result leaf":
        val state = secure_temp_dir(cwd(), "result-store-pointer").unwrap()
        val snapshot = _store_fixture_v1(state)
        _store_publish_v1(snapshot, [65])
        for pointer in ["../receipt\n", "/simple-build/outputs/" + _store_leaf_v1() + "\nextra\n",
                "/simple-build/outputs/result-" + _store_nonce_v1() + "-zZ019x\n"]:
            expect(file_write(snapshot.build_output_root + "/committed", pointer)).to_be(true)
            expect(read_dist_exec_untrusted_result_v1(snapshot, state, "pod-a", 1,
                _store_nonce_v1(), 5).is_err()).to_be(true)
        expect(dir_remove_all(state)).to_be(true)
