use std.spec.*
use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.sffi.fs.{file_mode}
use app.io.mod.{cwd, secure_temp_dir, dir_remove_all, file_write_bytes,
    file_read_regular_no_follow_bounded_bytes, file_exists, dir_list, dir_create_all}
use app.build.scheduler.dist_exec_artifact_snapshot.{DistExecArtifactSnapshotV1,
    prepare_dist_exec_artifact_snapshot_v1,
    release_dist_exec_artifact_snapshot_v1}

describe "distributed execution artifact snapshot":
    it "pins binary bytes and retains an independent private stage until release":
        val root = secure_temp_dir(cwd(), "artifact-snapshot-spec").unwrap()
        val state = secure_temp_dir(root, "state").unwrap()
        val exports = secure_temp_dir(root, "exports").unwrap()
        val source = exports + "/artifact"
        val bytes: [u8] = [0, 255, 128, 10, 65]
        expect(file_write_bytes(source, bytes)).to_be(true)
        val snapshot = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, source, sha256_u8_hex(bytes), 5)
        expect(snapshot.ready).to_be(true)
        expect(snapshot.cleanup_pending).to_be(false)
        expect(snapshot.cleanup_removed).to_be(false)
        expect(snapshot.root).to_start_with(state + "/build-attempts/pod-a-1-")
        expect(snapshot.build_input_root).to_equal(snapshot.root + "/inputs")
        expect(snapshot.build_output_root).to_equal(snapshot.root + "/outputs")
        expect(snapshot.artifact_path).to_equal(snapshot.build_input_root + "/artifact")
        expect(dir_list(snapshot.build_output_root).len()).to_equal(0)
        expect(snapshot.artifact_bytes).to_equal(5)
        expect(snapshot.artifact_sha256).to_equal(sha256_u8_hex(bytes))
        expect(file_mode(snapshot.artifact_path)).to_equal(0o755)
        expect(file_write_bytes(source, [66])).to_be(true)
        val staged = file_read_regular_no_follow_bounded_bytes(snapshot.artifact_path, 5)
        expect(staged.is_ok()).to_be(true)
        expect(staged.unwrap()).to_equal(bytes)
        val refused = release_dist_exec_artifact_snapshot_v1(snapshot, state + "/other", "pod-a", 1)
        expect(refused.reason).to_equal("artifact-snapshot-release-invalid")
        expect(file_exists(snapshot.artifact_path)).to_be(true)
        expect(release_dist_exec_artifact_snapshot_v1(snapshot, state, "pod-b", 1).reason)
            .to_equal("artifact-snapshot-release-invalid")
        expect(release_dist_exec_artifact_snapshot_v1(snapshot, state, "pod-a", 2).reason)
            .to_equal("artifact-snapshot-release-invalid")
        val released = release_dist_exec_artifact_snapshot_v1(snapshot, state, "pod-a", 1)
        expect(released.cleanup_pending).to_be(false)
        expect(released.root).to_equal("")
        expect(file_exists(snapshot.artifact_path)).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

    it "retries parent synchronization after stage removal has already succeeded":
        val root = secure_temp_dir(cwd(), "artifact-snapshot-cleanup").unwrap()
        val state = secure_temp_dir(root, "state").unwrap()
        val exports = secure_temp_dir(root, "exports").unwrap()
        val source = exports + "/artifact"
        expect(file_write_bytes(source, [65])).to_be(true)
        val snapshot = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, source, sha256_u8_hex([65]), 1)
        expect(snapshot.ready).to_be(true)
        val false_absence = DistExecArtifactSnapshotV1(false,
            "artifact-snapshot-released-cleanup-sync-failed", snapshot.root,
            snapshot.artifact_path, "", 0, true, true,
            snapshot.build_input_root, snapshot.build_output_root)
        val refused = release_dist_exec_artifact_snapshot_v1(false_absence, state, "pod-a", 1)
        expect(refused.reason).to_equal("artifact-snapshot-released-cleanup-still-present")
        expect(refused.cleanup_removed).to_be(false)
        expect(file_exists(snapshot.artifact_path)).to_be(true)
        expect(dir_remove_all(snapshot.root)).to_be(true)
        # Model the retained ownership record after removal but failed fsync.
        # Retrying must synchronize the parent without removing an absent path.
        val pending = DistExecArtifactSnapshotV1(false,
            "artifact-snapshot-released-cleanup-sync-failed", snapshot.root,
            snapshot.artifact_path, "", 0, true, true,
            snapshot.build_input_root, snapshot.build_output_root)
        val released = release_dist_exec_artifact_snapshot_v1(pending, state, "pod-a", 1)
        expect(released.cleanup_pending).to_be(false)
        expect(released.cleanup_removed).to_be(false)
        expect(released.root).to_equal("")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects bad digest oversized empty missing and directory sources before staging":
        val root = secure_temp_dir(cwd(), "artifact-snapshot-reject").unwrap()
        val state = secure_temp_dir(root, "state").unwrap()
        val exports = secure_temp_dir(root, "exports").unwrap()
        val source = exports + "/artifact"
        val bytes: [u8] = [0, 255, 10]
        expect(file_write_bytes(source, bytes)).to_be(true)
        val digest = sha256_u8_hex(bytes)
        val mismatch = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, source, sha256_u8_hex([1]), 3)
        expect(mismatch.reason).to_equal("artifact-snapshot-source-mismatch")
        val oversized = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, source, digest, 2)
        expect(oversized.ready).to_be(false)
        expect(oversized.root).to_equal("")
        val unavailable = prepare_dist_exec_artifact_snapshot_v1(state + "/missing", "pod-a", 1, exports, source, digest, 3)
        expect(unavailable.reason).to_equal("artifact-snapshot-stage-unavailable")
        expect(unavailable.cleanup_pending).to_be(false)
        expect(dir_create_all(exports + "/directory")).to_be(true)
        expect(prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, exports + "/directory", digest, 3).reason)
            .to_equal("artifact-snapshot-source-unavailable")
        expect(prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, exports + "/absent", digest, 3).ready).to_be(false)
        expect(file_write_bytes(source, [])).to_be(true)
        expect(prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1, exports, source, sha256_u8_hex([]), 3).ready).to_be(false)
        expect(dir_list(state).len()).to_equal(0)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects unauthorized paths and overlapping roots before source access":
        val digest = sha256_u8_hex([65])
        # Absent paths distinguish authorization rejection from read failure.
        for source in ["/exports", "/exports-sibling/artifact", "/exports2/artifact", "/other/artifact"]:
            val denied = prepare_dist_exec_artifact_snapshot_v1("/state", "pod-a", 1,
                "/exports", source, digest, 1)
            expect(denied.reason).to_equal("artifact-snapshot-export-outside-root")
            expect(denied.root).to_equal("")
            expect(denied.cleanup_pending).to_be(false)
        for state in ["/exports", "/exports/state", "/exports/state/deeper"]:
            val denied = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1,
                "/exports", "/exports/artifact", digest, 1)
            expect(denied.reason).to_equal("artifact-snapshot-roots-overlap")
            expect(denied.root).to_equal("")
        val ancestor = prepare_dist_exec_artifact_snapshot_v1("/state", "pod-a", 1,
            "/state/exports", "/state/exports/artifact", digest, 1)
        expect(ancestor.reason).to_equal("artifact-snapshot-roots-overlap")
        expect(ancestor.root).to_equal("")

    it "accepts disjoint roots sharing a text prefix":
        val root = secure_temp_dir(cwd(), "artifact-snapshot-boundary").unwrap()
        val state = secure_temp_dir(root, "state").unwrap()
        val exports = state + "-exports"
        expect(dir_create_all(exports)).to_be(true)
        val source = exports + "/artifact"
        expect(file_write_bytes(source, [65])).to_be(true)
        val snapshot = prepare_dist_exec_artifact_snapshot_v1(state, "pod-a", 1,
            exports, source, sha256_u8_hex([65]), 1)
        expect(snapshot.ready).to_be(true)
        val released = release_dist_exec_artifact_snapshot_v1(snapshot, state, "pod-a", 1)
        expect(released.cleanup_pending).to_be(false)
        expect(dir_remove_all(root)).to_be(true)

    it "validates caller policy and paths before any filesystem work":
        val digest = sha256_u8_hex([65])
        for path in ["", "/", "relative", "/tmp/../x", "/tmp//x", "/tmp/x/", "/tmp/x\x00y", "/tmp/a b"]:
            val invalid_source = prepare_dist_exec_artifact_snapshot_v1("/absent", "pod-a", 1, "/exports", path, digest, 1)
            expect(invalid_source.reason).to_equal("artifact-snapshot-path-invalid")
            expect(invalid_source.root).to_equal("")
            expect(prepare_dist_exec_artifact_snapshot_v1("/absent", "pod-a", 1, path, "/exports/artifact", digest, 1).reason)
                .to_equal("artifact-snapshot-path-invalid")
            expect(prepare_dist_exec_artifact_snapshot_v1(path, "pod-a", 1, "/exports", "/exports/artifact", digest, 1).reason)
                .to_equal("artifact-snapshot-path-invalid")
        for cap in [0, -1, 67108865, 9223372036854775807]:
            expect(prepare_dist_exec_artifact_snapshot_v1("/absent", "pod-a", 1, "/exports", "/exports/artifact", digest, cap).reason)
                .to_equal("artifact-snapshot-limit-invalid")
        for invalid in ["", "abc", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"]:
            expect(prepare_dist_exec_artifact_snapshot_v1("/absent", "pod-a", 1, "/exports", "/exports/artifact", invalid, 1).reason)
                .to_equal("artifact-snapshot-digest-invalid")
        for pod in ["", ".", "..", "../pod", "pod/name", "pod\nname", "-pod"]:
            expect(prepare_dist_exec_artifact_snapshot_v1("/absent", pod, 1, "/exports", "/exports/artifact", digest, 1).reason)
                .to_equal("artifact-snapshot-attempt-invalid")
        for attempt in [0, -1]:
            expect(prepare_dist_exec_artifact_snapshot_v1("/absent", "pod-a", attempt, "/exports", "/exports/artifact", digest, 1).reason)
                .to_equal("artifact-snapshot-attempt-invalid")
