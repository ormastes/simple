use std.spec.*
use app.build.scheduler.parent_remote_service.{
    run_parent_remote_build_request_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec, NodeCapabilities,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{cwd, file_exists, dir_remove_all,
    getpid, time_now_unix_micros}

fn _service_request_v1() -> BuildWorkerRequestV1:
    val snapshot = sha256_text("service-snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("abi"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text("source"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/clang", "-c"], "simple-build/outputs",
        sha256_text("sandbox"), ["main.o"], sha256_text("resources"))
    BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action), "try-1",
            "worker-1", 0, 0, 4096), 7, 1, 8)

fn _service_node_v1() -> DistributedBuildNodeV1:
    val ssh = TrustedSshNodeV1("worker-1", "build.example", "builder", 22,
        "/usr/bin/ssh", sha256_text("ssh"), "/etc/known_hosts",
        sha256_text("hosts"), "/etc/key", sha256_text("key"))
    DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh, "/usr/local/bin/simple-build-worker", 30000),
        TrustedSftpConfigV1(ssh, "/usr/bin/sftp", sha256_text("sftp"),
            "/srv/simple-build-inbox"), "/src", "/state", "/cas")

fn _service_root_v1() -> text:
    cwd() + "/build/test/parent-remote-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

describe "parent remote build request service":
    it "rejects malformed data without creating owner state":
        val root = _service_root_v1()
        val result = run_parent_remote_build_request_v1("", root,
            _service_node_v1(), NodeCapabilities(1, "worker-1", [], [],
                "trusted", 8192), "trusted",
            SchedulerCapacityV1(1, 8192, 0, 8), 0)
        expect(result.reason).to_equal("request-invalid")
        expect(result.reconciliation_required).to_be(false)
        expect(file_exists(root)).to_be(false)

    it "rejects a stale request fence and releases the exclusive owner":
        val root = _service_root_v1()
        val result = run_parent_remote_build_request_v1(
            encode_build_worker_request_v1(_service_request_v1()), root,
            _service_node_v1(), NodeCapabilities(1, "worker-1", [], [],
                "trusted", 8192), "trusted",
            SchedulerCapacityV1(1, 8192, 0, 8), 0)
        expect(result.reason).to_equal("action: fence-mismatch")
        expect(result.reconciliation_required).to_be(false)
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        expect(owner.state.ledger.attempts.len()).to_equal(0)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        expect(dir_remove_all(root)).to_be(true)
