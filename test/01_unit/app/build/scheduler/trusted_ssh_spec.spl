use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1,
    trusted_ssh_node_valid_v1, probe_trusted_ssh_node_v1}
use app.io.mod.{dir_create_all, file_atomic_write, file_hash_sha256,
    time_now_unix_micros, getpid, cwd}
use std.common.crypto.sha256.{sha256_text}
use std.spec.step

fn _ssh_test_node_v1(root: text) -> TrustedSshNodeV1:
    val known_hosts = root + "/known_hosts"
    val identity = root + "/identity"
    val executable = root + "/ssh"
    expect(dir_create_all(root)).to_be(true)
    expect(file_atomic_write(known_hosts,
        "node-1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeTestOnly\n")).to_be(true)
    expect(file_atomic_write(identity, "test-only-identity\n")).to_be(true)
    expect(file_atomic_write(executable, "test-only-executable\n")).to_be(true)
    TrustedSshNodeV1("node-1", "127.0.0.1", "builder", 2222,
        executable, file_hash_sha256(executable),
        known_hosts, file_hash_sha256(known_hosts),
        identity, file_hash_sha256(identity))

describe "pinned trusted SSH node configuration":
    it "rejects malformed identities before attempting a process":
        val digest = sha256_text("placeholder")
        val bad = TrustedSshNodeV1("-node", "127.0.0.1", "builder", 2222,
            "/missing/ssh", digest, "/missing/hosts", digest,
            "/missing/key", digest)
        expect(trusted_ssh_node_valid_v1(bad)).to_be(false)
        expect(probe_trusted_ssh_node_v1(bad).reason).to_equal(
            "worker-id-invalid")

    it "binds a worker alias to immutable local file digests":
        step("Create a private test fixture with a worker alias")
        val root = cwd() + "/build/test/trusted-ssh-" + getpid().to_text() + "-" +
            time_now_unix_micros().to_text()
        val node = _ssh_test_node_v1(root)
        expect(trusted_ssh_node_valid_v1(node)).to_be(true)
        val wrong_host = TrustedSshNodeV1("node-2", node.host, node.user,
            node.port, node.ssh_executable, node.ssh_digest,
            node.known_hosts_path, node.known_hosts_digest,
            node.identity_path, node.identity_digest)
        expect(trusted_ssh_node_valid_v1(wrong_host)).to_be(false)
        expect(file_atomic_write(node.known_hosts_path,
            "node-1 ssh-ed25519 changed\n")).to_be(true)
        expect(trusted_ssh_node_valid_v1(node)).to_be(false)
