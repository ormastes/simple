use std.spec.*
use app.build.scheduler.parent_remote_service.{
    resume_parent_remote_attempt_v1,
    cancel_unstarted_parent_remote_attempt_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use std.common.crypto.sha256.{sha256_text}

fn _mismatched_reconcile_node_v1() -> DistributedBuildNodeV1:
    val ssh = TrustedSshNodeV1("worker-1", "build.example", "builder", 22,
        "/usr/bin/ssh", sha256_text("ssh"), "/etc/known_hosts",
        sha256_text("hosts"), "/etc/key", sha256_text("key"))
    var sftp = ssh
    sftp.worker_id = "worker-2"
    DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh,
            "/usr/local/bin/simple-build-worker", 30000),
        TrustedSftpConfigV1(sftp, "/usr/bin/sftp",
            sha256_text("sftp"), "/srv/simple-build-inbox"),
        "/src", "/state", "/cas")

describe "distributed reconciliation transport boundary":
    it "rejects a split SSH/SFTP worker before owner or remote contact":
        val node = _mismatched_reconcile_node_v1()
        val root = "/nonexistent/simple-reconcile-owner"
        val status = resume_parent_remote_attempt_v1(root, "try-1", node)
        expect(status.reason).to_equal("transport-node-mismatch")
        expect(status.reconciliation_required).to_be(false)
        val cancel = cancel_unstarted_parent_remote_attempt_v1(root,
            "try-1", node)
        expect(cancel.reason).to_equal("transport-node-mismatch")
        expect(cancel.reconciliation_required).to_be(false)
