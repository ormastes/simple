use app.build.scheduler.parent_request_spool.{
    persist_parent_build_request_v1, recover_parent_build_request_v1,
    parent_request_matches_active_attempt_v1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_admit_v1, scheduler_owner_revoke_v1,
    scheduler_owner_close_v1}
use app.build.scheduler.planner.{SchedulerActionV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1, parse_build_worker_request_v1}
use app.io.mod.{file_read, file_atomic_write, getpid, time_now_unix_micros}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn _disk_spool_action_v1() -> SchedulerActionV1:
    val snapshot = sha256_text("disk spool snapshot")
    val spec = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("source"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/answer.c", sha256_text("source bytes"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["cc", "-c"], "src", sha256_text("sandbox"),
        ["answer.o"], sha256_text("resources"))
    SchedulerActionV1(action_spec_digest_v1(spec), spec, [], 0, 0,
        1, 4096, 8)

describe "parent request spool on disk":
    it "persists one exact request before upload and preserves it across owner restart":
        val root = "build/test/request-spool-" + getpid().to_text() +
            "-" + time_now_unix_micros().to_text()
        val action = _disk_spool_action_v1()
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "node-a",
            SchedulerCapacityV1(2, 8192, 0, 16), 0)
        expect(admitted.dispatch).to_be(true)
        val request = BuildWorkerRequestV1(action.spec,
            AttemptSpec(1, action.action_digest, "try-1", "node-a",
                0, 0, 4096), admitted.fence, 1, 8)
        val persisted = persist_parent_build_request_v1(owner, request)
        expect(persisted.persisted).to_be(true)
        val path = root + "/requests/try-1.wire"
        val wire = encode_build_worker_request_v1(request)
        expect(file_read(path)).to_equal(wire)
        expect(persist_parent_build_request_v1(owner, request).reason)
            .to_equal("spool-collision")
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        val reopened = scheduler_owner_open_v1(root)
        expect(reopened.error).to_equal("")
        val parsed = parse_build_worker_request_v1(file_read(path))
        expect(parsed != nil).to_be(true)
        expect(parent_request_matches_active_attempt_v1(parsed.unwrap(),
            reopened.state.ledger.attempts[0])).to_be(true)
        expect(scheduler_owner_close_v1(reopened)).to_be(true)

    it "rejects a canonical request for attempt B placed at attempt A's path":
        val root = "build/test/request-spool-swapped-" + getpid().to_text() +
            "-" + time_now_unix_micros().to_text()
        val action = _disk_spool_action_v1()
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        val capacity = SchedulerCapacityV1(2, 8192, 0, 16)
        val first = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-a", "node-a", capacity, 0)
        expect(first.dispatch).to_be(true)
        val request_a = BuildWorkerRequestV1(action.spec,
            AttemptSpec(1, action.action_digest, "try-a", "node-a",
                0, 0, 4096), first.fence, 1, 8)
        expect(persist_parent_build_request_v1(owner, request_a).persisted)
            .to_be(true)
        expect(scheduler_owner_revoke_v1(owner, "try-a").acknowledged)
            .to_be(true)
        val second = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-b", "node-a", capacity, 0)
        expect(second.dispatch).to_be(true)
        val request_b = BuildWorkerRequestV1(action.spec,
            AttemptSpec(1, action.action_digest, "try-b", "node-a",
                1, 0, 4096), second.fence, 1, 8)
        expect(persist_parent_build_request_v1(owner, request_b).persisted)
            .to_be(true)
        expect(file_atomic_write(root + "/requests/try-a.wire",
            encode_build_worker_request_v1(request_b))).to_be(true)
        expect(recover_parent_build_request_v1(owner, "try-a").recovered)
            .to_be(false)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
