use std.spec.*
use app.build.scheduler.parallel_flat_result_inventory_v1.{
    check_parallel_flat_result_inventory_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_atomic_write, process_run_bounded}

fn _flat_fixture_root_v1() -> text:
    cwd() + "/build/test/flat-result-inventory-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

describe "parallel flat result inventory V1":
    it "accepts exactly the expected regular files":
        val root = _flat_fixture_root_v1()
        expect(dir_create_all(root)).to_be(true)
        expect(file_atomic_write(root + "/result.wire", "result\n"))
            .to_be(true)
        expect(file_atomic_write(root + "/diagnostics", ""))
            .to_be(true)
        val checked = check_parallel_flat_result_inventory_v1(root,
            ["diagnostics", "result.wire"])
        expect(checked.valid).to_be(true)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects an extra empty subdirectory":
        val root = _flat_fixture_root_v1() + "-extra"
        expect(dir_create_all(root + "/unexpected")).to_be(true)
        expect(file_atomic_write(root + "/result.wire", "result\n"))
            .to_be(true)
        val checked = check_parallel_flat_result_inventory_v1(root,
            ["result.wire"])
        expect(checked.valid).to_be(false)
        expect(checked.reason).to_equal("inventory-count-mismatch")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects a missing declared file":
        val root = _flat_fixture_root_v1() + "-missing"
        expect(dir_create_all(root)).to_be(true)
        val checked = check_parallel_flat_result_inventory_v1(root,
            ["result.wire"])
        expect(checked.valid).to_be(false)
        expect(checked.reason).to_equal("inventory-count-mismatch")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects an expected name that is a symlink":
        val root = _flat_fixture_root_v1() + "-symlink"
        expect(dir_create_all(root)).to_be(true)
        val (out, err, code) = process_run_bounded("/bin/ln",
            ["-s", "absent-target", root + "/result.wire"], 5000, 1024)
        expect(code).to_equal(0)
        expect(out).to_equal("")
        expect(err).to_equal("")
        val checked = check_parallel_flat_result_inventory_v1(root,
            ["result.wire"])
        expect(checked.valid).to_be(false)
        expect(checked.reason).to_equal("inventory-file-invalid")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects traversal, duplicate, and nested expected names":
        val root = _flat_fixture_root_v1() + "-invalid"
        expect(check_parallel_flat_result_inventory_v1(root,
            ["../escape"]).reason).to_equal("inventory-name-invalid")
        expect(check_parallel_flat_result_inventory_v1(root,
            ["nested/file"]).reason).to_equal("inventory-name-invalid")
        expect(check_parallel_flat_result_inventory_v1(root,
            ["result.wire", "result.wire"]).reason)
            .to_equal("inventory-name-invalid")
