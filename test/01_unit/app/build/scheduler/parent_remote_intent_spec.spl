use std.spec.*
use app.build.scheduler.parent_remote_service.{run_parent_remote_build_intent_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    NodeCapabilities, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn _remote_intent_request_v1() -> BuildWorkerRequestV1:
    val snapshot = sha256_text("remote-intent")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("abi"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text("source"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/clang", "-c"], "simple-build/outputs",
        sha256_text("sandbox"), ["main.o"], sha256_text("resources"))
    val attempt = AttemptSpec(1, action_spec_digest_v1(action),
        "try-intent", "worker-1", 0, 4, 4096)
    BuildWorkerRequestV1(action, attempt, 7, 2, 8)

fn _remote_intent_node_v1() -> DistributedBuildNodeV1:
    val ssh = TrustedSshNodeV1("worker-2", "build.example", "builder", 22,
        "/usr/bin/ssh", sha256_text("ssh"), "/etc/known_hosts",
        sha256_text("hosts"), "/etc/key", sha256_text("key"))
    DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh,
            "/usr/local/bin/simple-build-worker", 30000),
        TrustedSftpConfigV1(ssh, "/usr/bin/sftp",
            sha256_text("sftp"), "/srv/simple-build-inbox"),
        "/src", "/state", "/cas")

describe "parent remote intent pre-admission":
    it "rejects malformed and wrong-worker data before journal or SSH":
        val node = _remote_intent_node_v1()
        val caps = NodeCapabilities(1, "worker-2", [], [], "trusted", 8192)
        val capacity = SchedulerCapacityV1(1, 8192, 0, 8)
        val owner = "/nonexistent/simple-dist-intent-owner"
        val malformed = run_parent_remote_build_intent_v1("bad", owner,
            node, caps, "trusted", capacity, 0)
        expect(malformed.reason).to_equal("request-invalid")
        expect(malformed.reconciliation_required).to_be(false)
        val wire = encode_build_worker_request_v1(_remote_intent_request_v1())
        expect(wire == "").to_be(false)
        val wrong_worker = run_parent_remote_build_intent_v1(wire, owner,
            node, caps, "trusted", capacity, 0)
        expect(wrong_worker.reason).to_equal("action: worker-mismatch")
        expect(wrong_worker.reconciliation_required).to_be(false)
