use std.spec.*
use std.common.crypto.sha256.{sha256_u8_hex}
use app.build.scheduler.dist_exec_result.{parse_dist_exec_committed_pointer_v1,
    parse_dist_exec_worker_result_v1, validate_dist_exec_worker_result_v1}
use app.build.scheduler.dist_exec_worker.{dist_exec_worker_receipt_v1}
use std.nogc_async_mut.container.providers.linux.oci_exact_logs_v1.{OciExactLogBytesV1}

fn _result_nonce_v1() -> text:
    "0123456789abcdef0123456789abcdef"

fn _result_digest_v1() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _result_pointer_v1() -> text:
    "/simple-build/outputs/result-" + _result_nonce_v1() + "-aZ019x\n"

fn _result_receipt_v1(bytes: [u8]) -> text:
    "simple-dist-exec-worker-result-v1\nnonce=" + _result_nonce_v1() +
        "\nartifact-sha256=" + _result_digest_v1() + "\nexit-code=0\nstdout-bytes=" +
        bytes.len().to_text() + "\nstdout-sha256=" + sha256_u8_hex(bytes) +
        "\nstderr-bytes=0\nv4-binding=" + _result_digest_v1() + "\n"

fn _result_parse_v1(wire: text, bytes: [u8]) -> bool:
    parse_dist_exec_worker_result_v1(_result_pointer_v1(), wire, bytes,
        _result_nonce_v1(), _result_digest_v1(), 1024).is_ok()

describe "committed worker result wire validation":
    it "roundtrips the worker's actual receipt with binary stdout":
        val bytes: [u8] = [0, 255, 10, 65]
        val pin: [u8] = [170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,
            170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,170]
        val output = OciExactLogBytesV1(bytes, [], sha256_u8_hex(bytes),
            sha256_u8_hex([]), pin, pin)
        val produced = dist_exec_worker_receipt_v1(_result_nonce_v1(),
            _result_digest_v1(), output)
        expect(produced.is_ok()).to_be(true)
        val parsed = parse_dist_exec_worker_result_v1(_result_pointer_v1(),
            produced.unwrap(), bytes, _result_nonce_v1(), _result_digest_v1(), 4)
        expect(parsed.is_ok()).to_be(true)
        expect(parsed.unwrap().stdout_bytes).to_equal(4)

    it "retains a safe leaf and hashes binary stdout without decoding":
        val bytes: [u8] = [0, 255, 10, 65]
        val parsed = parse_dist_exec_worker_result_v1(_result_pointer_v1(),
            _result_receipt_v1(bytes), bytes, _result_nonce_v1(), _result_digest_v1(), 4)
        expect(parsed.is_ok()).to_be(true)
        val result = parsed.unwrap()
        expect(result.leaf_name).to_equal("result-" + _result_nonce_v1() + "-aZ019x")
        expect(result.stdout_bytes).to_equal(4)
        expect(result.stdout_sha256).to_equal(sha256_u8_hex(bytes))
        expect(validate_dist_exec_worker_result_v1(result, bytes, _result_nonce_v1(),
            _result_digest_v1(), 4).is_ok()).to_be(true)
        expect(_result_parse_v1(_result_receipt_v1([]), [])).to_be(true)

    it "rejects paths, traversal, extra lines, malformed nonce and suffix":
        val prefix = "/simple-build/outputs/result-" + _result_nonce_v1() + "-"
        for wire in ["/tmp/result\n", prefix + "../foo\n", prefix + "aZ019x/\n",
                prefix + "aZ019x\n\n", prefix + "aZ019x", prefix + "aZ019x\r\n",
                prefix + "aZ019_\n", prefix + "aZ019\n", prefix + "aZ019xx\n",
                prefix + "aZ01\x00x\n", prefix + "-aZ019x\n"]:
            expect(parse_dist_exec_committed_pointer_v1(wire, _result_nonce_v1()).is_err()).to_be(true)
        expect(parse_dist_exec_committed_pointer_v1(_result_pointer_v1(), "bad").is_err()).to_be(true)
        expect(parse_dist_exec_committed_pointer_v1(_result_pointer_v1(),
            "1123456789abcdef0123456789abcdef").is_err()).to_be(true)

    it "rejects unknown duplicate missing and reordered fields":
        val wire = _result_receipt_v1([65])
        for altered in [wire + "unknown=1\n", wire + "nonce=" + _result_nonce_v1() + "\n",
                wire.replace("exit-code=0\n", ""),
                wire.replace("exit-code=0", "nonce=0"),
                wire.replace("exit-code=0", "unknown=0"),
                wire.replace("exit-code=0\nstdout-bytes=1", "stdout-bytes=1\nexit-code=0"),
                wire.replace("result-v1", "result-v2"), wire + "\n",
                wire[0:wire.len() - 1], wire.replace("exit-code=0", "exit-code=0\r")]:
            expect(_result_parse_v1(altered, [65])).to_be(false)

    it "rejects noncanonical numbers failed exits and claimed stderr":
        val wire = _result_receipt_v1([65])
        for raw in ["01", "+1", " 1", "1 ", "-1", "1.0", "", "9223372036854775808"]:
            expect(_result_parse_v1(wire.replace("stdout-bytes=1", "stdout-bytes=" + raw), [65])).to_be(false)
        for raw in ["1", "-1", "00", "+0", " 0"]:
            expect(_result_parse_v1(wire.replace("exit-code=0", "exit-code=" + raw), [65])).to_be(false)
            expect(_result_parse_v1(wire.replace("stderr-bytes=0", "stderr-bytes=" + raw), [65])).to_be(false)

    it "rejects nonce digest count cap and binding inconsistencies":
        val wire = _result_receipt_v1([65])
        expect(_result_parse_v1(wire, [66])).to_be(false)
        expect(_result_parse_v1(wire, [65, 65])).to_be(false)
        expect(_result_parse_v1(wire.replace("nonce=" + _result_nonce_v1(), "nonce=bad"), [65])).to_be(false)
        expect(_result_parse_v1(wire.replace("artifact-sha256=" + _result_digest_v1(),
            "artifact-sha256=" + sha256_u8_hex([65])), [65])).to_be(false)
        for binding in ["", "abc", _result_digest_v1() + "a",
                "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
                "gaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]:
            expect(_result_parse_v1(wire.replace("v4-binding=" + _result_digest_v1(),
                "v4-binding=" + binding), [65])).to_be(false)
        for cap in [0, -1, 16777217]:
            expect(parse_dist_exec_worker_result_v1(_result_pointer_v1(), wire, [65],
                _result_nonce_v1(), _result_digest_v1(), cap).is_err()).to_be(true)
        expect(parse_dist_exec_worker_result_v1(_result_pointer_v1(), _result_receipt_v1([65, 66]),
            [65, 66], _result_nonce_v1(), _result_digest_v1(), 1).is_err()).to_be(true)
        expect(parse_dist_exec_worker_result_v1(_result_pointer_v1(), wire, [65],
            _result_nonce_v1(), "bad", 1024).is_err()).to_be(true)

    it "revalidates structured values against changed caller bytes and limits":
        val result = parse_dist_exec_worker_result_v1(_result_pointer_v1(),
            _result_receipt_v1([65, 66]), [65, 66], _result_nonce_v1(), _result_digest_v1(), 2).unwrap()
        expect(validate_dist_exec_worker_result_v1(result, [65, 67], _result_nonce_v1(),
            _result_digest_v1(), 2).is_err()).to_be(true)
        expect(validate_dist_exec_worker_result_v1(result, [65, 66], _result_nonce_v1(),
            _result_digest_v1(), 1).is_err()).to_be(true)
