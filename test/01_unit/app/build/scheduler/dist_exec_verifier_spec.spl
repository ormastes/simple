use std.spec.*
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use app.build.scheduler.dist_exec_verifier_main.{
    parse_dist_exec_verifier_config_v1, run_dist_exec_verifier_v1,
    dist_exec_verifier_args_valid_v1, dist_exec_verifier_path_valid_v1,
    dist_exec_verifier_export_allowed_v1, dist_exec_verifier_policy_binding_v1}
use app.build.scheduler.dist_exec_worker.{dist_exec_worker_args_valid_v1,
    dist_exec_worker_receipt_v1, dist_exec_worker_hex_v1}
use std.nogc_async_mut.container.providers.linux.oci_exact_logs_v1.{OciExactLogBytesV1}

fn _verifier_digest_v1() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _verifier_policy_v1() -> text:
    "simple-dist-exec-verifier-v1\nengine=podman\nengine-path=/usr/bin/podman\n" +
    "engine-sha256=" + _verifier_digest_v1() + "\nimage=registry/image@sha256:" +
    _verifier_digest_v1() + "\nstate-root=/var/lib/simple/verifier\n" +
    "export-root=/srv/simple/exports\ntimeout-ms=30000\ncpu-limit-millis=1000\n" +
    "memory-limit-bytes=134217728\npid-limit=64\nprovider-generation=1\n" +
    "stdout-limit-bytes=1048576\n" +
    "trusted-ancestors=administrator-owned-no-symlinks-no-untrusted-writers\n" +
    "worker-path=/usr/local/bin/simple_dist_exec_worker\nworker-sha256=" +
    _verifier_digest_v1() + "\n"

describe "distributed executable verifier admission":
    it "binds the administrator policy bytes and rejects an appended key":
        val wire = _verifier_policy_v1()
        val parsed = parse_dist_exec_verifier_config_v1(wire)
        expect(parsed.is_ok()).to_be(true)
        expect(parsed.unwrap().provider_generation).to_equal(1)
        expect(dist_exec_verifier_policy_binding_v1(wire, sha256_text(wire))).to_be(true)
        expect(dist_exec_verifier_policy_binding_v1(wire + "\n", sha256_text(wire))).to_be(false)
        expect(parse_dist_exec_verifier_config_v1(wire + "engine=docker\n").is_err()).to_be(true)

    it "rejects missing pin flags and never emits a receipt on rejection":
        val args = ["--artifact", "/srv/simple/exports/program",
            "--artifact-sha256", _verifier_digest_v1(),
            "--policy-sha256", _verifier_digest_v1()]
        expect(dist_exec_verifier_args_valid_v1(args)).to_be(true)
        expect(dist_exec_verifier_args_valid_v1(args[0:4])).to_be(false)
        expect(dist_exec_verifier_args_valid_v1(args + ["--extra"])).to_be(false)
        val rejected = run_dist_exec_verifier_v1([])
        expect(rejected.status).to_equal("BLOCKED")
        expect(rejected.receipt).to_equal("")
        expect(rejected.retained_stage).to_equal("")

    it "requires an export path component boundary and canonical paths":
        val config = parse_dist_exec_verifier_config_v1(_verifier_policy_v1()).unwrap()
        expect(dist_exec_verifier_export_allowed_v1(config, "/srv/simple/exports/program")).to_be(true)
        expect(dist_exec_verifier_export_allowed_v1(config, "/srv/simple/exports-evil/program")).to_be(false)
        expect(dist_exec_verifier_export_allowed_v1(config, "/srv/simple/exports/../program")).to_be(false)
        expect(dist_exec_verifier_path_valid_v1("/srv//program")).to_be(false)
        expect(dist_exec_verifier_path_valid_v1("/srv/program\x00")).to_be(false)

    it "rejects reordered policy keys and mutable image references":
        expect(parse_dist_exec_verifier_config_v1(_verifier_policy_v1().replace(
            "engine=podman", "engine-path=podman")).is_err()).to_be(true)
        expect(parse_dist_exec_verifier_config_v1(_verifier_policy_v1().replace(
            "registry/image@sha256:" + _verifier_digest_v1(), "registry/image:latest")).is_err()).to_be(true)
        expect(parse_dist_exec_verifier_config_v1(_verifier_policy_v1().replace(
            "pid-limit=64", "pid-limit=0")).is_err()).to_be(true)
        expect(parse_dist_exec_verifier_config_v1(_verifier_policy_v1().replace(
            "timeout-ms=30000", "timeout-ms=030000")).is_err()).to_be(true)

describe "isolated exact-byte worker protocol":
    it "requires bounded exact worker arguments":
        val nonce = "0123456789abcdef0123456789abcdef"
        expect(dist_exec_worker_args_valid_v1(["--artifact-sha256", _verifier_digest_v1(),
            "--nonce", nonce, "--wall-ms", "30000", "--stream-limit-bytes", "1024"])).to_be(true)
        expect(dist_exec_worker_args_valid_v1(["--artifact-sha256", _verifier_digest_v1(),
            "--nonce", nonce, "--wall-ms", "60001", "--stream-limit-bytes", "1024"])).to_be(false)

    it "binds binary stdout with NUL and invalid UTF8 without text conversion":
        val bytes: [u8] = [0, 255, 10, 65]
        val pin: [u8] = [170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,
            170,170,170,170,170,170,170,170,170,170,170,170,170,170,170,170]
        val output = OciExactLogBytesV1(bytes, [], sha256_u8_hex(bytes),
            sha256_u8_hex([]), pin, pin)
        val wire = dist_exec_worker_receipt_v1("0123456789abcdef0123456789abcdef",
            _verifier_digest_v1(), output)
        expect(wire.is_ok()).to_be(true)
        expect(wire.unwrap()).to_contain("stdout-bytes=4\nstdout-sha256=" + sha256_u8_hex(bytes))
        expect(dist_exec_worker_hex_v1(bytes)).to_equal("00ff0a41")
        val wrong = OciExactLogBytesV1(bytes, [], _verifier_digest_v1(),
            sha256_u8_hex([]), pin, pin)
        expect(dist_exec_worker_receipt_v1("0123456789abcdef0123456789abcdef",
            _verifier_digest_v1(), wrong).is_err()).to_be(true)
        val stderr = OciExactLogBytesV1(bytes, [10], sha256_u8_hex(bytes),
            sha256_u8_hex([10]), pin, pin)
        expect(dist_exec_worker_receipt_v1("0123456789abcdef0123456789abcdef",
            _verifier_digest_v1(), stderr).is_err()).to_be(true)
