use app.build.scheduler.worker_materialize.{stage_build_inputs_v1}
use app.io.mod.{cwd, dir_create_all, dir_remove_all, file_atomic_write,
    file_hash_sha256, is_dir, time_now_unix_micros, getpid}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_async_mut.container.providers.linux.oci_runtime_v1.{
    LinuxOciRequestV1, OCI_DEFAULT_ENGINE, build_create_command}
use std.spec.step

fn _worker_materialize_root_v1(label: text) -> text:
    cwd() + "/build/test/worker-materialize-" + label + "-" +
        getpid().to_text() + "-" + time_now_unix_micros().to_text()

fn _worker_materialize_action_v1(content: text) -> ActionSpec:
    val snapshot = sha256_text("worker-stage-snapshot")
    ActionSpec(1, "c-compile",
        SnapshotManifest(1, snapshot, sha256_text("source-tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("cc"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text(content))],
            [], [], [], [], [], sha256_text("resolution"), true, false),
        ["/usr/bin/cc", "-c", "/simple-build/inputs/src/main.c", "-o",
            "/simple-build/outputs/main.o"], "src", sha256_text("sandbox"),
        ["build/main.o"], sha256_text("resources"))

describe "attempt-private build input staging":
    it "copies verified bytes into an OCI mount with an empty output root":
        step("Stage only the declared source file")
        val root = _worker_materialize_root_v1("good")
        val source_root = root + "/source"
        val state_dir = root + "/state"
        val content = "int answer(void) { return 42; }\n"
        expect(dir_create_all(source_root + "/src")).to_be(true)
        expect(file_atomic_write(source_root + "/src/main.c", content)).to_be(true)
        val action = _worker_materialize_action_v1(content)
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        val staged = stage_build_inputs_v1(action, attempt, "pod-1", 1,
            source_root, state_dir)
        expect(staged.staged).to_be(true)
        expect(staged.reason).to_equal("")
        expect(file_hash_sha256(staged.input_root + "/src/main.c"))
            .to_equal(sha256_text(content))
        expect(is_dir(staged.output_root)).to_be(true)
        expect(staged.input_bytes).to_equal(content.len())
        var request = LinuxOciRequestV1(pod_uid: "pod-1", attempt: 1,
            operation_id: "create-1",
            image: "docker.io/library/busybox@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            bundle_path: "", command: action.argv, args: [],
            timeout_ms: 5000, cpu_limit_millis: 1000,
            memory_limit_bytes: 268435456, pid_limit: 64,
            network_policy: "none", filesystem_policy: "read-only")
        request.build_input_root = staged.input_root
        request.build_output_root = staged.output_root
        expect(build_create_command(OCI_DEFAULT_ENGINE, state_dir,
            request, "create-1", 1, "boot-1").0).to_equal("")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects changed source bytes before a mount is admitted":
        val root = _worker_materialize_root_v1("changed")
        val source_root = root + "/source"
        val state_dir = root + "/state"
        expect(dir_create_all(source_root + "/src")).to_be(true)
        expect(file_atomic_write(source_root + "/src/main.c", "changed\n"))
            .to_be(true)
        val action = _worker_materialize_action_v1("original\n")
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        val staged = stage_build_inputs_v1(action, attempt, "pod-1", 1,
            source_root, state_dir)
        expect(staged.staged).to_be(false)
        expect(staged.reason).to_equal("input-digest-mismatch")
        expect(dir_remove_all(root)).to_be(true)
