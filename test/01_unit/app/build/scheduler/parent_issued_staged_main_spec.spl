use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.build.scheduler.parent_issued_staged_main.{
    parse_parent_issued_staged_args_v1}

val ISSUED_MAIN_DIGEST = sha256_text("approved-record")

describe "restricted installed staged parent arguments":
    it "accepts only one content-addressed issued record selector":
        val parsed = parse_parent_issued_staged_args_v1([
            "/trusted/bin/simple_dist_build_issued_parent",
            "--issued-plan", ISSUED_MAIN_DIGEST])
        expect(parsed.valid).to_be(true)
        expect(parsed.record_digest).to_equal(ISSUED_MAIN_DIGEST)

    it "rejects raw staged, graph, extra and malformed arguments":
        expect(parse_parent_issued_staged_args_v1([
            "--staged-plan-digest", ISSUED_MAIN_DIGEST]).valid)
            .to_be(false)
        expect(parse_parent_issued_staged_args_v1([
            "--graph-digest", ISSUED_MAIN_DIGEST]).valid)
            .to_be(false)
        expect(parse_parent_issued_staged_args_v1([
            "--issued-plan", ISSUED_MAIN_DIGEST,
            "--config", "/trusted/worker.conf"]).valid)
            .to_be(false)
        expect(parse_parent_issued_staged_args_v1([
            "--issued-plan", "not-a-digest"]).valid).to_be(false)
