use std.spec.*
use app.build.scheduler.worker_capability.{BuildWorkerCapabilityV1,
    encode_build_worker_capability_v1, parse_build_worker_capability_v1,
    BUILD_WORKER_CAPABILITY_MAX_BYTES_V1}
use app.build.scheduler.worker_sandbox_identity.{build_worker_sandbox_digest_v1}
use compiler.common.build_contract.{ToolchainManifest}
use std.common.crypto.sha256.{sha256_text}

fn _cap_fixture_v1() -> BuildWorkerCapabilityV1:
    val digest = sha256_text("capability-fixture")
    val image = "example/compiler@sha256:" + digest
    BuildWorkerCapabilityV1("worker-1", "linux", "x86_64",
        "0f9ad7e0-1111-4222-8333-444444444444", 7, "linux-oci-v1",
        "podman", "rootless", image, "/usr/bin/clang",
        ToolchainManifest(1, digest, digest, digest, digest, digest,
            "x86_64-unknown-linux-gnu"),
        build_worker_sandbox_digest_v1(image, "podman", "/usr/bin/clang"),
        digest, 2, 1048576, digest)

describe "build worker capability V1 wire":
    it "roundtrips every claim in a canonical bounded record":
        val original = _cap_fixture_v1()
        val wire = encode_build_worker_capability_v1(original)
        expect(wire.starts_with("simple-build-worker-capability-v1\n")).to_be(true)
        expect(wire.len() < BUILD_WORKER_CAPABILITY_MAX_BYTES_V1).to_be(true)
        if val parsed = parse_build_worker_capability_v1(wire):
            expect(encode_build_worker_capability_v1(parsed)).to_equal(wire)
            expect(parsed.worker_id).to_equal(original.worker_id)
            expect(parsed.compiler_entry).to_equal(original.compiler_entry)
            expect(parsed.sandbox_digest).to_equal(original.sandbox_digest)
            expect(parsed.nonce).to_equal(original.nonce)
        else:
            assert(false)

    it "rejects malformed order, duplicate rows, casing and noncanonical integers":
        val wire = encode_build_worker_capability_v1(_cap_fixture_v1())
        expect(parse_build_worker_capability_v1(wire + "nonce=extra\n")).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "worker=worker-1", "worker-id=worker-1"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "provider-generation=7", "provider-generation=07"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "engine=podman", "engine=runc"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "privilege=rootless", "privilege=root"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire[0:wire.len() - 1])).to_be_nil()
        expect(parse_build_worker_capability_v1(wire + "\n")).to_be_nil()

    it "rejects spoofed sandbox, image, entrypoint and nonce":
        val cap = _cap_fixture_v1()
        val wire = encode_build_worker_capability_v1(cap)
        expect(parse_build_worker_capability_v1(wire.replace(
            "compiler-entry=/usr/bin/clang", "compiler-entry=/usr/bin/other"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "image=example/compiler", "image=other/compiler"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "nonce=" + cap.nonce, "nonce=" + cap.nonce.upper()))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire.replace(
            "cpu=2", "cpu=0"))).to_be_nil()
        expect(parse_build_worker_capability_v1(wire + "x" * 4096)).to_be_nil()
