use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_admit_v1, scheduler_owner_revoke_v1,
    scheduler_owner_publish_v1, scheduler_owner_close_v1,
    scheduler_owner_fail_v1}
use app.build.scheduler.planner.{SchedulerActionV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use app.build.scheduler.broker.{FencedCandidateV1}
use compiler.common.build_contract.{ActionResultCandidate, BuildInputRef,
    SnapshotManifest, ToolchainManifest, InputManifest, ActionSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{file_append, time_now_unix_micros, getpid}

fn _owner_test_root_v1(label: text) -> text:
    "build/test/scheduler-owner-" + label + "-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

fn _owner_test_action_v1() -> SchedulerActionV1:
    val snapshot = sha256_text("owner-snapshot")
    val spec = ActionSpec(
        version: 1, kind: "simple-compile",
        snapshot: SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        toolchain: ToolchainManifest(1, sha256_text("tool"),
            sha256_text("behavior"), sha256_text("provider"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "aarch64-apple-darwin"),
        inputs: InputManifest(1, snapshot,
            [BuildInputRef("src/owner.spl", sha256_text("owner"))],
            [], [], [], [], [], sha256_text("resolution"), true, false),
        argv: ["simple", "build", "owner"], working_directory: "src",
        sandbox_digest: sha256_text("sandbox"),
        output_paths: ["build/owner.out"],
        resource_policy_digest: sha256_text("resource-policy"))
    SchedulerActionV1(action_spec_digest_v1(spec), spec, [], 0, 0, 1, 20, 1)

describe "scheduler lifetime owner":
    it "journals a failed current attempt before allowing a retry":
        val root = _owner_test_root_v1("failed")
        val action = _owner_test_action_v1()
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "node-1", capacity, 0)
        expect(admitted.dispatch).to_be(true)
        val candidate = ActionResultCandidate(1, action.action_digest,
            "try-1", "node-1", "", sha256_text("failed diagnostics"), false)
        val stale = scheduler_owner_fail_v1(owner, candidate, 2,
            "infrastructure-crash")
        expect(stale.acknowledged).to_be(false)
        expect(owner.state.sequence).to_equal(1)
        val failed = scheduler_owner_fail_v1(owner, candidate, 1,
            "infrastructure-crash")
        expect(failed.acknowledged).to_be(true)
        expect(owner.state.sequence).to_equal(2)
        expect(owner.state.ledger.failures.len()).to_equal(1)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        val recovered = scheduler_owner_open_v1(root)
        expect(recovered.error).to_equal("")
        expect(recovered.state.ledger.failures[0].classification).to_equal(
            "infrastructure-crash")
        val retry = scheduler_owner_admit_v1(recovered, [action],
            action.action_digest, "try-2", "node-2", capacity, 0)
        expect(retry.dispatch).to_be(true)
        expect(retry.fence).to_equal(3)
        expect(scheduler_owner_close_v1(recovered)).to_be(true)

    it "holds one lock through durable admission, revocation, and recovery":
        val root = _owner_test_root_v1("fence")
        val action = _owner_test_action_v1()
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        expect(owner.lock_handle >= 0).to_be(true)
        val contender = scheduler_owner_open_v1(root)
        expect(contender.error).to_equal("scheduler-owner-error: lock-unavailable")
        val handle = owner.lock_handle
        val invalid = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try,invalid", "local", capacity, 0)
        expect(invalid.dispatch).to_be(false)
        expect(invalid.error).to_equal("scheduler-error: attempt-invalid")
        expect(owner.error).to_equal("")
        expect(owner.state.sequence).to_equal(0)
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "local", capacity, 0)
        expect(admitted.dispatch).to_be(true)
        expect(owner.state.sequence).to_equal(1)
        expect(owner.lock_handle).to_equal(handle)
        val revoked = scheduler_owner_revoke_v1(owner, "try-1")
        expect(revoked.acknowledged).to_be(true)
        expect(owner.state.sequence).to_equal(2)
        expect(owner.lock_handle).to_equal(handle)
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        expect(scheduler_owner_close_v1(owner)).to_be(false)
        val closed = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-2", "local", capacity, 0)
        expect(closed.dispatch).to_be(false)
        val recovered = scheduler_owner_open_v1(root)
        expect(recovered.error).to_equal("")
        expect(recovered.state.sequence).to_equal(2)
        expect(scheduler_owner_close_v1(recovered)).to_be(true)

    it "keeps business rejection recoverable and poisons a stale owner":
        val root = _owner_test_root_v1("stale")
        val action = _owner_test_action_v1()
        val capacity = SchedulerCapacityV1(1, 100, 10, 5)
        val owner = scheduler_owner_open_v1(root)
        expect(owner.error).to_equal("")
        val admitted = scheduler_owner_admit_v1(owner, [action],
            action.action_digest, "try-1", "local", capacity, 0)
        expect(admitted.dispatch).to_be(true)
        val output = sha256_text("stored output")
        val candidate = FencedCandidateV1(ActionResultCandidate(1,
            action.action_digest, "try-1", "local", output,
            sha256_text("diagnostics"), true), 1)
        val wrong = scheduler_owner_publish_v1(owner, candidate,
            sha256_text("wrong output"))
        expect(wrong.acknowledged).to_be(false)
        expect(owner.error).to_equal("")
        expect(owner.state.sequence).to_equal(1)
        expect(file_append(root + "/journal.v1", "J1|2|partial")).to_be(true)
        val stale = scheduler_owner_revoke_v1(owner, "try-1")
        expect(stale.acknowledged).to_be(false)
        expect(stale.error).to_equal("scheduler-journal-error: stale-or-corrupt")
        val blocked = scheduler_owner_publish_v1(owner, candidate, output)
        expect(blocked.acknowledged).to_be(false)
        expect(owner.error).to_equal("scheduler-journal-error: stale-or-corrupt")
        expect(scheduler_owner_close_v1(owner)).to_be(true)
        val replay = scheduler_owner_open_v1(root)
        expect(replay.error).to_equal("scheduler-journal-error: journal-torn")

    it "rejects invalid roots before opening a lock":
        val invalid = scheduler_owner_open_v1("")
        expect(invalid.lock_handle).to_equal(-1)
        expect(invalid.error).to_equal("scheduler-owner-error: root-invalid")
