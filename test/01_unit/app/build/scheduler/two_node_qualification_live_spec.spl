use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.build.scheduler.two_node_qualification_live.{
    two_node_proposed_attempt_v1}

describe "two-node native execution attribution":
    it "requires one exact proposed attempt for each action":
        val producer = sha256_text("producer")
        val consumer = sha256_text("consumer")
        val output = "parent-graph: PROPOSED attempt=dist-a action=" +
            producer + "\n" +
            "parent-graph: PROPOSED attempt=dist-b action=" +
            consumer + "\nparent-graph: COMPLETED accepted=2\n"
        expect(two_node_proposed_attempt_v1(output, producer))
            .to_equal("dist-a")
        expect(two_node_proposed_attempt_v1(output, consumer))
            .to_equal("dist-b")
        expect(two_node_proposed_attempt_v1(output,
            sha256_text("unrelated"))).to_equal("")

    it "rejects duplicate proposal claims for one action":
        val action = sha256_text("producer")
        val row = "parent-graph: PROPOSED attempt=dist-a action=" +
            action + "\n"
        expect(two_node_proposed_attempt_v1(row + row, action))
            .to_equal("")
