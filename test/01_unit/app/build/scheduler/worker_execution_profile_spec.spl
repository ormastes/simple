use std.spec.*
use app.build.scheduler.worker_execution_profile.{
    build_worker_execution_profile_problem_v1,
    build_worker_terminal_exit_problem_v1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec}
use std.common.crypto.sha256.{sha256_text}

fn _profile_action_v1() -> ActionSpec:
    val digest = sha256_text("profile")
    ActionSpec(1, "compile", SnapshotManifest(1, digest, digest, digest),
        ToolchainManifest(1, digest, digest, digest, digest, digest,
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, digest, [BuildInputRef("src/main.spl", digest)],
            [], [], [], [], [], digest, true, false),
        ["/usr/local/bin/simple", "build"], "simple-build/outputs",
        digest, ["main"], digest)

describe "shared build worker execution profile":
    it "accepts the exact supported command on parent and worker":
        expect(build_worker_execution_profile_problem_v1(
            _profile_action_v1(), "/usr/local/bin/simple")).to_equal("")

    it "rejects unsupported commands and output/control collisions":
        var action = _profile_action_v1()
        action.argv = []
        expect(build_worker_execution_profile_problem_v1(action,
            "/usr/local/bin/simple")).to_equal("execution-profile-unsupported")
        action = _profile_action_v1()
        action.argv = ["/usr/local/bin/other"]
        expect(build_worker_execution_profile_problem_v1(action,
            "/usr/local/bin/simple")).to_equal("execution-profile-unsupported")
        action = _profile_action_v1()
        action.output_paths = ["manifest.wire"]
        expect(build_worker_execution_profile_problem_v1(action,
            "/usr/local/bin/simple")).to_equal("output-name-unsupported")
        action.output_paths = ["failure-proof.wire"]
        expect(build_worker_execution_profile_problem_v1(action,
            "/usr/local/bin/simple")).to_equal("output-name-unsupported")
        action = _profile_action_v1()
        var inputs = action.inputs
        inputs.source_inputs = [BuildInputRef(".simple-control/request.wire",
            sha256_text("source"))]
        action.inputs = inputs
        expect(build_worker_execution_profile_problem_v1(action,
            "/usr/local/bin/simple")).to_equal("control-input-collision")

    it "accepts known terminal exits without classifying their cause":
        expect(build_worker_terminal_exit_problem_v1(0)).to_equal("")
        for code in [1, 125, 126, 127, 134, 137, 139, 143, 255]:
            expect(build_worker_terminal_exit_problem_v1(code))
                .to_equal("")
        expect(build_worker_terminal_exit_problem_v1(-1))
            .to_equal("terminal-exit-invalid")
        expect(build_worker_terminal_exit_problem_v1(256))
            .to_equal("terminal-exit-invalid")
