use app.build.scheduler.worker_output.{observe_build_outputs_v1,
    verify_build_outputs_v1}
use app.io.mod.{cwd, dir_create_all, dir_remove_all, file_write_bytes,
    file_copy, time_now_unix_micros, getpid}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.spec.step

fn _output_test_action_v1() -> ActionSpec:
    val snapshot = sha256_text("output-snapshot")
    ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("source"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text("int main() {}"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/cc", "-c"], "src", sha256_text("sandbox"),
        ["main.o"], sha256_text("resources"))

fn _output_test_root_v1() -> text:
    cwd() + "/build/test/worker-output-" + getpid().to_text() + "-" +
        time_now_unix_micros().to_text()

describe "parent-verified build output manifest":
    it "reconstructs a binary output claim from independently copied bytes":
        step("Create a non-UTF-8 worker object and copy it to the parent")
        val root = _output_test_root_v1()
        val worker = root + "/worker"
        val parent = root + "/parent"
        expect(dir_create_all(worker)).to_be(true)
        expect(dir_create_all(parent)).to_be(true)
        val object = [0x7F.to_u8(), 0x45.to_u8(), 0x4C.to_u8(),
            0x46.to_u8(), 0xFF.to_u8(), 0x80.to_u8()]
        expect(file_write_bytes(worker + "/main.o", object)).to_be(true)
        val action = _output_test_action_v1()
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        val worker_claim = observe_build_outputs_v1(action, attempt, 7,
            worker, "compiler ok\n")
        expect(worker_claim.valid).to_be(true)
        expect(worker_claim.output_bytes).to_equal(object.len())
        expect(file_copy(worker + "/main.o", parent + "/main.o"))
            .to_be(true)
        val verified = verify_build_outputs_v1(action, attempt, 7,
            parent, "compiler ok\n", worker_claim.manifest_wire,
            worker_claim.manifest_digest)
        expect(verified.valid).to_be(true)
        expect(verified.manifest_digest).to_equal(worker_claim.manifest_digest)
        expect(dir_remove_all(root)).to_be(true)

    it "rejects a corrupt transferred object and altered diagnostics":
        val root = _output_test_root_v1()
        val worker = root + "/worker"
        val parent = root + "/parent"
        expect(dir_create_all(worker)).to_be(true)
        expect(dir_create_all(parent)).to_be(true)
        expect(file_write_bytes(worker + "/main.o",
            [0x7F.to_u8(), 0x45.to_u8(), 0x4C.to_u8(), 0x46.to_u8(),
             0x01.to_u8()])).to_be(true)
        val action = _output_test_action_v1()
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        val claim = observe_build_outputs_v1(action, attempt, 7, worker, "ok")
        expect(claim.valid).to_be(true)
        expect(file_write_bytes(parent + "/main.o",
            [0x7F.to_u8(), 0x45.to_u8(), 0x4C.to_u8(), 0x46.to_u8(),
             0x02.to_u8()])).to_be(true)
        expect(verify_build_outputs_v1(action, attempt, 7, parent, "ok",
            claim.manifest_wire, claim.manifest_digest).reason)
            .to_equal("claim-mismatch")
        expect(file_copy(worker + "/main.o", parent + "/main.o"))
            .to_be(true)
        expect(verify_build_outputs_v1(action, attempt, 7, parent, "changed",
            claim.manifest_wire, claim.manifest_digest).reason)
            .to_equal("claim-mismatch")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects nested output paths until directory traversal is no-follow":
        var action = _output_test_action_v1()
        action.output_paths = ["build/main.o"]
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        expect(observe_build_outputs_v1(action, attempt, 7,
            "/private/attempt-output", "ok").reason)
            .to_equal("output-path-invalid")
