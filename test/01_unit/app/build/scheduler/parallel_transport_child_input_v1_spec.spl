use std.spec.*
use app.build.scheduler.parallel_transport_child_input_v1.{
    validate_parallel_transport_child_input_v1}
use app.build.scheduler.parallel_transport_wire_v1.{
    ParallelTransportFileV1, ParallelTransportHandoffV1,
    encode_parallel_transport_handoff_v1,
    parallel_transport_handoff_digest_v1,
    parallel_transport_approved_node_digest_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildNodeV1}
use app.build.scheduler.prepared_upload.{prepare_build_request_upload_v1}
use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1}
use app.build.scheduler.trusted_worker_invocation.{TrustedWorkerCommandV1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_atomic_write, file_hash_sha256, file_rename,
    process_run_bounded}

fn _child_root_v1() -> text:
    cwd() + "/build/test/parallel-child-input-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

fn _child_request_v1(content: text) -> BuildWorkerRequestV1:
    val snapshot = sha256_text("child-input-snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("compiler"),
            sha256_text("behavior"), sha256_text("abi"),
            sha256_text("runtime"), sha256_text("sysroot"),
            "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text(content))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["/usr/bin/clang", "-c"], "simple-build/outputs",
        sha256_text("sandbox"), ["main.o"], sha256_text("resources"))
    BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action),
            "dist-try-1", "worker-1", 0, 2, 4096), 1, 2, 8)

fn _child_fixture_v1(root: text) -> ParallelTransportHandoffV1:
    val source = root + "/source"
    val state = root + "/state"
    val cas = root + "/cas"
    dir_create_all(source + "/src")
    dir_create_all(state)
    dir_create_all(cas)
    val content = "int main(void) { return 42; }\n"
    file_atomic_write(source + "/src/main.c", content)
    val ssh_path = root + "/ssh"
    val sftp_path = root + "/sftp"
    val hosts_path = root + "/known_hosts"
    val key_path = root + "/identity"
    file_atomic_write(ssh_path, "fake-ssh\n")
    file_atomic_write(sftp_path, "fake-sftp\n")
    file_atomic_write(hosts_path,
        "worker-1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeTestOnly\n")
    file_atomic_write(key_path, "fake-key\n")
    val ssh = TrustedSshNodeV1("worker-1", "127.0.0.1", "builder", 2222,
        ssh_path, file_hash_sha256(ssh_path), hosts_path,
        file_hash_sha256(hosts_path), key_path, file_hash_sha256(key_path))
    val sftp = TrustedSftpConfigV1(ssh, sftp_path,
        file_hash_sha256(sftp_path), "/srv/simple-build-inbox")
    val node = DistributedBuildNodeV1(
        TrustedWorkerCommandV1(ssh, "/opt/simple/worker", 30000),
        sftp, source, state, cas)
    val prepared = prepare_build_request_upload_v1(sftp,
        _child_request_v1(content), source, cas, state)
    val plan = prepared.plan
    ParallelTransportHandoffV1(prepared.ready, prepared.reason,
        sha256_text("nonce"), plan.request_wire, plan.request_digest,
        node, parallel_transport_approved_node_digest_v1(node),
        prepared.root,
        ParallelTransportFileV1("inputs.batch",
            plan.input_plan.batch.bytes().len(),
            sha256_text(plan.input_plan.batch)),
        ParallelTransportFileV1("control.batch",
            prepared.control_batch.bytes().len(),
            sha256_text(prepared.control_batch)),
        root + "/result", 100000, 4, 1048576)

describe "parallel transport child handoff input V1":
    it "rejects a wrong independently supplied handoff digest before file reads":
        val result = validate_parallel_transport_child_input_v1([],
            sha256_text("wrong"))
        expect(result.valid).to_be(false)
        expect(result.reason).to_equal("handoff-size-invalid")
        val wrong = validate_parallel_transport_child_input_v1(
            "nonempty".bytes(), sha256_text("wrong"))
        expect(wrong.valid).to_be(false)
        expect(wrong.reason).to_equal("handoff-digest-mismatch")
        val oversized = validate_parallel_transport_child_input_v1(
            "x".repeat(1048577).bytes(), sha256_text("wrong"))
        expect(oversized.valid).to_be(false)
        expect(oversized.reason).to_equal("handoff-size-invalid")

    it "reconstructs the exact prepared upload without network or deletion":
        val root = _child_root_v1()
        expect(dir_create_all(root)).to_be(true)
        val handoff = _child_fixture_v1(root)
        expect(handoff.valid).to_be(true)
        val wire = encode_parallel_transport_handoff_v1(handoff)
        expect(wire.len() > 0).to_be(true)
        val result = validate_parallel_transport_child_input_v1(wire,
            parallel_transport_handoff_digest_v1(handoff))
        expect(result.valid).to_be(true)
        expect(result.request.unwrap().attempt.attempt_id).to_equal("dist-try-1")
        expect(result.prepared.unwrap().plan.request_digest).to_equal(
            handoff.request_digest)
        expect(result.prepared.unwrap().input_batch_path).to_equal(
            handoff.prepared_root + "/inputs.batch")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects a substituted batch and a symlinked input ancestor":
        val root = _child_root_v1()
        expect(dir_create_all(root)).to_be(true)
        val handoff = _child_fixture_v1(root)
        expect(handoff.valid).to_be(true)
        val wire = encode_parallel_transport_handoff_v1(handoff)
        val digest = parallel_transport_handoff_digest_v1(handoff)
        expect(file_atomic_write(handoff.prepared_root + "/inputs.batch",
            "substituted batch\n")).to_be(true)
        val changed = validate_parallel_transport_child_input_v1(wire, digest)
        expect(changed.valid).to_be(false)
        expect(changed.reason).to_equal("prepared-file-mismatch")
        expect(dir_remove_all(root)).to_be(true)

        val symlink_root = _child_root_v1() + "-symlink"
        expect(dir_create_all(symlink_root)).to_be(true)
        val linked_handoff = _child_fixture_v1(symlink_root)
        expect(linked_handoff.valid).to_be(true)
        val inputs = linked_handoff.prepared_root + "/inputs"
        expect(file_rename(inputs + "/src", inputs + "/real"))
            .to_be(true)
        val (_, _, link_code) = process_run_bounded("/bin/ln",
            ["-s", "real", inputs + "/src"], 5000, 1024)
        expect(link_code).to_equal(0)
        val linked = validate_parallel_transport_child_input_v1(
            encode_parallel_transport_handoff_v1(linked_handoff),
            parallel_transport_handoff_digest_v1(linked_handoff))
        expect(linked.valid).to_be(false)
        expect(linked.reason).to_equal("prepared-input-invalid")
        expect(dir_remove_all(symlink_root)).to_be(true)
