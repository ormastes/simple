use app.build.scheduler.trusted_ssh.{TrustedSshNodeV1}
use app.build.scheduler.trusted_sftp.{TrustedSftpConfigV1,
    plan_build_input_sftp_v1}
use app.io.mod.{cwd, dir_create_all, dir_remove_all, file_atomic_write,
    file_hash_sha256, time_now_unix_micros, getpid}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}

fn _sftp_test_root_v1() -> text:
    cwd() + "/build/test/trusted-sftp-" + getpid().to_text() + "-" +
        time_now_unix_micros().to_text()

fn _sftp_test_config_v1(root: text) -> TrustedSftpConfigV1:
    val ssh = root + "/ssh"
    val sftp = root + "/sftp"
    val hosts = root + "/known_hosts"
    val key = root + "/identity"
    file_atomic_write(ssh, "fake-ssh\n")
    file_atomic_write(sftp, "fake-sftp\n")
    file_atomic_write(hosts,
        "node-1 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFakeTestOnly\n")
    file_atomic_write(key, "fake-key\n")
    TrustedSftpConfigV1(
        TrustedSshNodeV1("node-1", "127.0.0.1", "builder", 2222,
            ssh, file_hash_sha256(ssh), hosts, file_hash_sha256(hosts),
            key, file_hash_sha256(key)),
        sftp, file_hash_sha256(sftp), "/srv/simple-build-inbox")

fn _sftp_test_action_v1(content: text) -> ActionSpec:
    val snapshot = sha256_text("sftp-snapshot")
    ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("source-tree"),
            sha256_text("submodules")),
        ToolchainManifest(1, sha256_text("cc"), sha256_text("behavior"),
            sha256_text("abi"), sha256_text("runtime"),
            sha256_text("sysroot"), "x86_64-unknown-linux-gnu"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/main.c", sha256_text(content)),
             BuildInputRef("src/helper.h", sha256_text("int helper(void);\n"))],
            [], [], [], [], [], sha256_text("context"), true, false),
        ["cc", "-c"], "src", sha256_text("sandbox"),
        ["main.o"], sha256_text("resources"))

describe "pinned SFTP declared-input plan":
    it "creates a fresh attempt inbox and transfers two verified files":
        val root = _sftp_test_root_v1()
        val source = root + "/source"
        expect(dir_create_all(source + "/src")).to_be(true)
        val content = "int main(void) { return 42; }\n"
        expect(file_atomic_write(source + "/src/main.c", content)).to_be(true)
        expect(file_atomic_write(source + "/src/helper.h",
            "int helper(void);\n")).to_be(true)
        val config = _sftp_test_config_v1(root)
        val action = _sftp_test_action_v1(content)
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        val plan = plan_build_input_sftp_v1(config, action, attempt, source)
        expect(plan.valid).to_be(true)
        expect(plan.files).to_equal(2)
        expect(plan.remote_attempt_root).to_equal(
            "/srv/simple-build-inbox/try-1")
        expect(plan.batch).to_contain("mkdir /srv/simple-build-inbox/try-1\n")
        expect(plan.batch).to_contain("mkdir /srv/simple-build-inbox/try-1/src\n")
        expect(plan.batch).to_contain("put " + source + "/src/main.c " +
            plan.remote_attempt_root + "/src/main.c\n")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects a changed input before opening a transfer":
        val root = _sftp_test_root_v1()
        val source = root + "/source"
        expect(dir_create_all(source + "/src")).to_be(true)
        expect(file_atomic_write(source + "/src/main.c", "changed\n"))
            .to_be(true)
        expect(file_atomic_write(source + "/src/helper.h",
            "int helper(void);\n")).to_be(true)
        val config = _sftp_test_config_v1(root)
        val action = _sftp_test_action_v1("original\n")
        val attempt = AttemptSpec(1, action_spec_digest_v1(action),
            "try-1", "node-1", 0, 0, 268435456)
        expect(plan_build_input_sftp_v1(config, action, attempt, source).reason)
            .to_equal("input-digest-mismatch")
        expect(dir_remove_all(root)).to_be(true)
