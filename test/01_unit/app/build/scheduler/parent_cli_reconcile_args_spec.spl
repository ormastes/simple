use std.spec.*
use app.build.scheduler.parent_cli.{parse_dist_build_cli_args_v1}
use std.common.crypto.sha256.{sha256_text}

describe "distributed build CLI reconciliation commands":
    it "accepts one bounded attempt ID for status and cancellation":
        val status = parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--status", "try-7"])
        expect(status.valid).to_be(true)
        expect(status.operation).to_equal("status")
        expect(status.attempt_id).to_equal("try-7")
        val cancel = parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--cancel", "try-7"])
        expect(cancel.valid).to_be(true)
        expect(cancel.operation).to_equal("cancel")
        expect(cancel.attempt_id).to_equal("try-7")

    it "rejects unsafe or ambiguous reconciliation targets":
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--cancel",
                "../try-7"]).valid).to_be(false)
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--status",
                "try-7", "extra"]).valid).to_be(false)
        expect(parse_dist_build_cli_args_v1(
            ["--config", "relative.conf", "--status", "try-7"]
            ).valid).to_be(false)

    it "parses one accepted-object export without accepting paths or executables":
        val action = sha256_text("export action")
        val parsed = parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export",
                action, "unit.o", "linked-unit.o"])
        expect(parsed.valid).to_be(true)
        expect(parsed.operation).to_equal("export")
        expect(parsed.action_digest).to_equal(action)
        expect(parsed.output_name).to_equal("unit.o")
        expect(parsed.destination_leaf).to_equal("linked-unit.o")
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export",
                action, "../unit.o", "unit.o"]).valid).to_be(false)
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export",
                action, "app.exe", "app.exe"]).valid).to_be(false)

    it "selects a protected export row by ID only":
        val parsed = parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export-policy",
                "program"])
        expect(parsed.valid).to_be(true)
        expect(parsed.operation).to_equal("export-policy")
        expect(parsed.policy_id).to_equal("program")
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export-policy",
                "../program"]).valid).to_be(false)
        expect(parse_dist_build_cli_args_v1(
            ["--config", "/etc/simple/parent.conf", "--export-policy",
                "program", "extra"]).valid).to_be(false)
