use std.spec.*
use app.build.scheduler.parent_graph_runner_main.{parse_parent_graph_runner_args_v1,
    load_pinned_parent_graph_manifest_v1}
use app.io.mod.{cwd, dir_create_all, dir_remove_all, file_write_bytes,
    getpid, time_now_unix_micros}
use std.common.crypto.sha256.{sha256_text}

val pinned_digest = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

describe "whole-graph native CLI arguments":
    it "accepts the installed native basename and protected config paths":
        val args = ["/trusted/bin/simple_dist_build_parent", "--graph-digest",
            pinned_digest, "--config",
            "/trusted/worker-one.conf", "--config",
            "/trusted/worker-two.conf"]
        val parsed = parse_parent_graph_runner_args_v1(args)
        expect(parsed.valid).to_be(true)
        expect(parsed.graph_manifest_digest).to_equal(pinned_digest)
        expect(parsed.config_paths.len()).to_equal(2)
        expect(parsed.config_paths[0]).to_equal("/trusted/worker-one.conf")
        expect(parsed.config_paths[1]).to_equal("/trusted/worker-two.conf")

    it "accepts Windows native basename but rejects unsafe config arguments":
        val native = ["C:\\simple\\simple_dist_build_parent.exe",
            "--graph-digest", pinned_digest,
            "--config", "/trusted/worker.conf"]
        expect(parse_parent_graph_runner_args_v1(native).valid).to_be(true)
        expect(parse_parent_graph_runner_args_v1(
            ["simple_dist_build_parent", "--graph-digest", pinned_digest,
             "--config", "relative.conf"]).valid).to_be(false)
        expect(parse_parent_graph_runner_args_v1(
            ["simple_dist_build_parent", "--graph-digest", pinned_digest,
             "--config"]).valid).to_be(false)
        expect(parse_parent_graph_runner_args_v1(
            ["simple_dist_build_parent", "--graph-digest", "AAAA",
             "--config", "/trusted/worker.conf"]).valid).to_be(false)
        expect(parse_parent_graph_runner_args_v1(
            ["simple_dist_build_parent", "--config",
             "/trusted/worker.conf"]).valid).to_be(false)

    it "rejects changed manifest bytes under the protected root digest":
        val root = cwd() + "/build/test/parent-graph-root-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        val path = root + "/graph.manifest"
        val original = "simple-dist-build-graph-v1\nrequest=" +
            sha256_text("request-one") + "|/trusted/request-one\n"
        val changed = "simple-dist-build-graph-v1\nrequest=" +
            sha256_text("request-two") + "|/trusted/request-two\n"
        expect(dir_create_all(root)).to_be(true)
        expect(file_write_bytes(path, original.bytes())).to_be(true)
        val pinned = sha256_text(original)
        expect(load_pinned_parent_graph_manifest_v1(path, pinned).?)
            .to_be(true)
        expect(file_write_bytes(path, changed.bytes())).to_be(true)
        expect(load_pinned_parent_graph_manifest_v1(path, pinned))
            .to_be_nil()
        expect(dir_remove_all(root)).to_be(true)
