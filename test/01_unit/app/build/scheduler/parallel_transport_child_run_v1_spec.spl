use std.spec.*
use app.build.scheduler.parallel_transport_child_run_v1.{
    run_parallel_transport_child_v1}
use std.common.crypto.sha256.{sha256_text}

describe "parallel transport child run V1":
    it "returns INCOMPLETE before network for an unbound handoff":
        val result = run_parallel_transport_child_v1([], sha256_text("wrong"))
        expect(result.fetched).to_be(false)
        expect(result.status).to_equal("INCOMPLETE")
        expect(result.reason).to_equal("handoff: handoff-digest-mismatch")
        expect(result.observation).to_be_nil()
