use std.spec.*
use app.build.scheduler.parent_cli.{dist_build_exit_code_v1,
    dist_build_export_exit_code_v1}
use app.build.scheduler.distributed_attempt.{DistributedBuildAttemptV1}
use app.build.scheduler.parent_artifact_export.{ParentArtifactExportV1}
use app.build.scheduler.parent_cleanup_service.{
    completed_build_with_pending_cleanup_v1}
use compiler.common.build_contract.{AcceptedResult}

fn _empty_accepted_v1() -> AcceptedResult:
    AcceptedResult(1, "", "", "", "")

describe "distributed build CLI exit status":
    it "succeeds only for durably published output":
        expect(dist_build_exit_code_v1(DistributedBuildAttemptV1(
            true, true, false, false, "", _empty_accepted_v1())))
            .to_equal(0)
        expect(dist_build_exit_code_v1(DistributedBuildAttemptV1(
            true, false, true, false, "compiler-failure",
            _empty_accepted_v1()))).to_equal(1)
        expect(dist_build_exit_code_v1(DistributedBuildAttemptV1(
            true, true, false, true, "owner-close-failed",
            _empty_accepted_v1()))).to_equal(1)
        expect(dist_build_exit_code_v1(DistributedBuildAttemptV1(
            false, false, false, true, "transport-uncertain",
            _empty_accepted_v1()))).to_equal(1)

    it "keeps a published result successful while worker cleanup retries":
        val published = DistributedBuildAttemptV1(true, true, false,
            false, "", _empty_accepted_v1())
        val pending = completed_build_with_pending_cleanup_v1(published,
            "worker-unavailable")
        expect(pending.published).to_be(true)
        expect(pending.reconciliation_required).to_be(false)
        expect(pending.reason).to_contain("cleanup-pending: worker-unavailable")
        expect(dist_build_exit_code_v1(pending)).to_equal(0)

    it "rejects uncertain export durability and a lost destination lock":
        val done = ParentArtifactExportV1(true, true, "", "digest", "/tmp/unit.o")
        expect(dist_build_export_exit_code_v1(done)).to_equal(0)
        val cleanup = ParentArtifactExportV1(true, true,
            "stage-cleanup-pending", "digest", "/tmp/unit.o")
        expect(dist_build_export_exit_code_v1(cleanup)).to_equal(0)
        val unsynced = ParentArtifactExportV1(true, false,
            "publication-durability-uncertain", "digest", "/tmp/unit.o")
        expect(dist_build_export_exit_code_v1(unsynced)).to_equal(1)
        val unlocked = ParentArtifactExportV1(true, true,
            "destination-lock-release-failed", "digest", "/tmp/unit.o")
        expect(dist_build_export_exit_code_v1(unlocked)).to_equal(1)
