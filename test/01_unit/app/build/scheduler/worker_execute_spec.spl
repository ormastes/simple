# Pure admission tests: these do not start OCI or claim live worker evidence.
use app.build.scheduler.worker_execute.{parse_local_build_worker_config_v1,
    local_build_worker_request_problem_v1, build_worker_sandbox_digest_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use std.spec.step

fn _execute_config_fixture_v1() -> text:
    val digest = sha256_text("local approved profile")
    val image = "example/compiler@sha256:" + digest
    val sandbox = build_worker_sandbox_digest_v1(image, "podman", "/usr/bin/clang")
    "simple-local-build-worker-v1\nworker=node-1\ninbox=/srv/build/inbox\n" +
        "state=/srv/build/state\nengine=podman\nimage=" + image +
        "\ncompiler-entry=/usr/bin/clang\ntool-executable=" + digest +
        "\ntool-behavior=" + digest + "\nprovider-abi=" + digest +
        "\nruntime=" + digest + "\nsysroot=" + digest +
        "\ntarget=x86_64-unknown-linux-gnu\nsandbox=" + sandbox +
        "\nresource-policy=" + digest + "\ncpu=2\nmemory=1048576\n" +
        "timeout-ms=30000\npids=64\nprovider-generation=1\n"

fn _execute_request_fixture_v1(output: text) -> BuildWorkerRequestV1:
    val digest = sha256_text("local approved profile")
    val sandbox = build_worker_sandbox_digest_v1(
        "example/compiler@sha256:" + digest, "podman", "/usr/bin/clang")
    val action = ActionSpec(1, "compile", SnapshotManifest(1, digest, digest, digest),
        ToolchainManifest(1, digest, digest, digest, digest, digest, "x86_64-unknown-linux-gnu"),
        InputManifest(1, digest, [BuildInputRef("answer.c", sha256_text("source"))],
            [], [], [], [], [], digest, true, false),
        ["/usr/bin/clang", "-c", "/simple-build/inputs/answer.c", "-o", output],
        "simple-build/outputs", sandbox, [output], digest)
    BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action), "attempt-1", "node-1", 0, 0, 1048576),
        1, 1, 8)

describe "one-shot worker local policy":
    it "accepts the exact independently installed profile without executing it":
        step("Match uploaded action against administrator toolchain image and worker policy")
        if val config = parse_local_build_worker_config_v1(_execute_config_fixture_v1()):
            expect(local_build_worker_request_problem_v1(config,
                _execute_request_fixture_v1("answer.o"))).to_equal("")
            expect(config.image.starts_with("example/compiler@sha256:")).to_be(true)
            expect(config.provider_generation).to_equal(1)
        else:
            expect(false).to_be(true)

    it "rejects worker and toolchain disagreement with local configuration":
        val wire = _execute_config_fixture_v1()
        if val config = parse_local_build_worker_config_v1(wire.replace("worker=node-1", "worker=node-2")):
            expect(local_build_worker_request_problem_v1(config,
                _execute_request_fixture_v1("answer.o"))).to_equal("worker-mismatch")
        else:
            expect(false).to_be(true)
        val changed = wire.replace("tool-executable=" + sha256_text("local approved profile"),
            "tool-executable=" + sha256_text("other compiler"))
        if val config = parse_local_build_worker_config_v1(changed):
            expect(local_build_worker_request_problem_v1(config,
                _execute_request_fixture_v1("answer.o"))).to_equal("toolchain-mismatch")
        else:
            expect(false).to_be(true)

    it "reserves result control filenames and enforces local resource limits":
        if val config = parse_local_build_worker_config_v1(_execute_config_fixture_v1()):
            for name in ["manifest.wire", "diagnostics", "result.wire"]:
                expect(local_build_worker_request_problem_v1(config,
                    _execute_request_fixture_v1(name))).to_equal("output-name-unsupported")
        else:
            expect(false).to_be(true)
        val small = _execute_config_fixture_v1().replace("memory=1048576", "memory=1")
        if val config = parse_local_build_worker_config_v1(small):
            expect(local_build_worker_request_problem_v1(config,
                _execute_request_fixture_v1("answer.o"))).to_equal("local-capacity-exceeded")
        else:
            expect(false).to_be(true)

    it "rejects ambiguous configuration and unpinned images before execution":
        val wire = _execute_config_fixture_v1()
        expect(parse_local_build_worker_config_v1(wire + "worker=node-2\n")).to_be_nil()
        expect(parse_local_build_worker_config_v1(wire.replace("cpu=2", "cpu=02"))).to_be_nil()
        expect(parse_local_build_worker_config_v1(wire.replace("state=/srv/build/state",
            "state=/srv/../build/state"))).to_be_nil()
        expect(parse_local_build_worker_config_v1(wire.replace("@sha256:", ":latest-"))).to_be_nil()
        expect(parse_local_build_worker_config_v1(wire.replace("engine=podman", "engine=runc"))).to_be_nil()
