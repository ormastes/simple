use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use app.build.scheduler.parent_issued_plan_wire.{
    encode_parent_issued_plan_wire_v1, parse_parent_issued_plan_wire_v1}
use app.build.scheduler.parent_issued_plan_store.{
    load_issued_parent_plan_v1, publish_issued_parent_plan_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_write_bytes}

val ISSUED_PLAN_DIGEST = sha256_text("protected-staged-plan")
val ISSUED_TEMPLATE_DIGEST = sha256_text("protected-link-template")

fn _issued_wire_v1() -> text:
    "simple-parent-staged-launch-v1\n" +
    "plan-digest=" + ISSUED_PLAN_DIGEST + "\n" +
    "template=" + ISSUED_TEMPLATE_DIGEST +
        "|/trusted/link.template\n" +
    "config-count=2\n" +
    "config=/trusted/worker-one.conf\n" +
    "config=/trusted/worker-two.conf\n"

describe "canonical administrator staged launch record":
    it "round trips exact ordered pins and paths":
        val wire = _issued_wire_v1()
        val parsed = parse_parent_issued_plan_wire_v1(wire)
        expect(parsed.valid).to_be(true)
        expect(parsed.plan_digest).to_equal(ISSUED_PLAN_DIGEST)
        expect(parsed.template_digest).to_equal(ISSUED_TEMPLATE_DIGEST)
        expect(parsed.template_path).to_equal("/trusted/link.template")
        expect(parsed.config_paths).to_equal([
            "/trusted/worker-one.conf", "/trusted/worker-two.conf"])
        expect(encode_parent_issued_plan_wire_v1(parsed.plan_digest,
            parsed.template_path, parsed.template_digest,
            parsed.config_paths)).to_equal(wire)

    it "rejects extra fields, duplicate paths and noncanonical counts":
        val wire = _issued_wire_v1()
        expect(parse_parent_issued_plan_wire_v1(
            wire + "override=/tmp/other\n").valid).to_be(false)
        expect(parse_parent_issued_plan_wire_v1(wire.replace(
            "config-count=2", "config-count=02")).valid).to_be(false)
        expect(parse_parent_issued_plan_wire_v1(wire.replace(
            "/trusted/worker-two.conf",
            "/trusted/worker-one.conf")).valid).to_be(false)
        expect(parse_parent_issued_plan_wire_v1(wire.replace(
            "/trusted/link.template", "../link.template")).valid)
            .to_be(false)
        expect(parse_parent_issued_plan_wire_v1(wire.replace(
            "plan-digest=" + ISSUED_PLAN_DIGEST,
            "plan-digest=short")).valid).to_be(false)

    it "publishes once and refuses a changed content-addressed record":
        val root = cwd() + "/build/test/issued-plan-" +
            getpid().to_text() + "-" + time_now_unix_micros().to_text()
        expect(dir_create_all(root + "/staged-plans")).to_be(true)
        val wire = _issued_wire_v1()
        val first = publish_issued_parent_plan_v1(root, wire)
        expect(first.published).to_be(true)
        expect(first.durable).to_be(true)
        expect(first.record_digest).to_equal(sha256_text(wire))
        val loaded = load_issued_parent_plan_v1(root, first.record_digest)
        expect(loaded.valid).to_be(true)
        expect(loaded.record.unwrap().plan_digest)
            .to_equal(ISSUED_PLAN_DIGEST)
        val again = publish_issued_parent_plan_v1(root, wire)
        expect(again.published).to_be(true)
        expect(again.durable).to_be(true)
        expect(again.reason).to_equal("issued-plan-already-present")

        val record_path = root + "/staged-plans/" +
            first.record_digest + ".wire"
        expect(file_write_bytes(record_path, (wire + "changed\n").bytes()))
            .to_be(true)
        expect(load_issued_parent_plan_v1(root,
            first.record_digest).valid).to_be(false)
        val corrupt = publish_issued_parent_plan_v1(root, wire)
        expect(corrupt.published).to_be(false)
        expect(corrupt.reason).to_equal("issued-plan-existing-invalid")
        expect(dir_remove_all(root)).to_be(true)
