use std.spec.*
use app.build.scheduler.docker_attach_frames.{decode_docker_attach_frames_v1}

describe "Docker non-TTY attach frame syntax":
    it "preserves binary bytes and per-stream order across interleaved frames":
        val bytes: [u8] = [1, 0, 0, 0, 0, 0, 0, 3, 0, 255, 128,
            2, 0, 0, 0, 0, 0, 0, 2, 254, 10,
            1, 0, 0, 0, 0, 0, 0, 1, 65]
        val parsed = decode_docker_attach_frames_v1(bytes, 6)
        expect(parsed.is_ok()).to_be(true)
        val decoded = parsed.unwrap()
        expect(decoded.stdout_bytes).to_equal([0, 255, 128, 65])
        expect(decoded.stderr_bytes).to_equal([254, 10])
        expect(decoded.frame_count).to_equal(3)
        expect(decode_docker_attach_frames_v1(bytes, 5).is_err()).to_be(true)

    it "accepts empty buffers as parser-only success and zero payload frames":
        val empty = decode_docker_attach_frames_v1([], 0).unwrap()
        expect(empty.stdout_bytes.len()).to_equal(0)
        expect(empty.stderr_bytes.len()).to_equal(0)
        expect(empty.frame_count).to_equal(0)
        val frames: [u8] = [1, 0, 0, 0, 0, 0, 0, 0,
            2, 0, 0, 0, 0, 0, 0, 0]
        val decoded = decode_docker_attach_frames_v1(frames, 0).unwrap()
        expect(decoded.stdout_bytes.len()).to_equal(0)
        expect(decoded.stderr_bytes.len()).to_equal(0)
        expect(decoded.frame_count).to_equal(2)
        expect(decode_docker_attach_frames_v1([], -1).is_err()).to_be(true)

    it "rejects every partial header and incomplete payload":
        val frame: [u8] = [1, 0, 0, 0, 0, 0, 0, 2, 65, 66]
        var prefix: [u8] = []
        var i: i64 = 0
        while i < frame.len() - 1:
            prefix.push(frame[i])
            expect(decode_docker_attach_frames_v1(prefix, 2).is_err()).to_be(true)
            i = i + 1

    it "rejects unsupported stream types and every reserved byte":
        for stream_type in [0, 3, 255]:
            val frame: [u8] = [stream_type as u8, 0, 0, 0, 0, 0, 0, 0]
            expect(decode_docker_attach_frames_v1(frame, 0).is_err()).to_be(true)
        for reserved_index in [1, 2, 3]:
            var frame: [u8] = [1, 0, 0, 0, 0, 0, 0, 0]
            frame[reserved_index] = 1
            expect(decode_docker_attach_frames_v1(frame, 0).is_err()).to_be(true)

    it "decodes multi-byte big-endian lengths and accepts the exact cap":
        var frame: [u8] = [2, 0, 0, 0, 0, 0, 1, 0]
        var i: i64 = 0
        while i < 256:
            frame.push(i as u8)
            i = i + 1
        val decoded = decode_docker_attach_frames_v1(frame, 256).unwrap()
        expect(decoded.stdout_bytes.len()).to_equal(0)
        expect(decoded.stderr_bytes.len()).to_equal(256)
        expect(decoded.stderr_bytes[0]).to_equal(0)
        expect(decoded.stderr_bytes[255]).to_equal(255)
        expect(decode_docker_attach_frames_v1(frame, 255).is_err()).to_be(true)

    it "keeps unsigned maximum lengths positive and rejects absent payloads":
        val huge: [u8] = [1, 0, 0, 0, 255, 255, 255, 255]
        expect(decode_docker_attach_frames_v1(huge, 1).unwrap_err()).to_equal(
            "docker attach: output cap exceeded")
        expect(decode_docker_attach_frames_v1(huge, 4294967295).unwrap_err()).to_equal(
            "docker attach: partial payload")

    it "rejects malformed trailing bytes after an otherwise valid frame":
        val partial: [u8] = [1, 0, 0, 0, 0, 0, 0, 1, 65, 2]
        expect(decode_docker_attach_frames_v1(partial, 1).is_err()).to_be(true)
        val invalid: [u8] = [1, 0, 0, 0, 0, 0, 0, 1, 65,
            3, 0, 0, 0, 0, 0, 0, 0]
        expect(decode_docker_attach_frames_v1(invalid, 1).is_err()).to_be(true)
        val unfinished: [u8] = [1, 0, 0, 0, 0, 0, 0, 1, 65,
            2, 0, 0, 0, 0, 0, 0, 1]
        expect(decode_docker_attach_frames_v1(unfinished, 2).is_err()).to_be(true)
