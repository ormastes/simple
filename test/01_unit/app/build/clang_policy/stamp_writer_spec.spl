use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_text}
use app.build.clang_policy.native_noop_gate.{ClangNativeNoopDecisionV1}
use app.build.clang_policy.stamp_writer.{write_clang_native_stamp_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    file_read_regular_no_follow_bounded}

fn _stamp_test_path_v1() -> text:
    val root = cwd() + "/build/test/clang-stamp-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()
    expect(dir_create_all(root)).to_be(true)
    root + "/policy.stamp"

describe "Clang native dependency stamp writer":
    it "writes a rebuild request and admits only the exact current no-op stamp":
        val path = _stamp_test_path_v1()
        val digest = sha256_text("effective-policy")
        val rebuild = write_clang_native_stamp_v1(
            ClangNativeNoopDecisionV1("REBUILD_REQUIRED", digest,
                "fresh-semantic-action-required"), path)
        expect(rebuild.ready).to_be(true)
        expect(rebuild.requires_native_action).to_be(true)
        val bytes = file_read_regular_no_follow_bounded(path, 128)
        expect(bytes.is_ok()).to_be(true)
        expect(bytes.unwrap()).to_equal(digest + "\n")
        val no_op = write_clang_native_stamp_v1(
            ClangNativeNoopDecisionV1("ADMIT_NOOP", digest,
                "exact-current-policy"), path)
        expect(no_op.ready).to_be(true)
        expect(no_op.requires_native_action).to_be(false)
        val stale = write_clang_native_stamp_v1(
            ClangNativeNoopDecisionV1("ADMIT_NOOP", sha256_text("other"),
                "exact-current-policy"), path)
        expect(stale.ready).to_be(false)
        expect(stale.reason).to_equal("native-stamp-mismatch")

    it "rejects malformed decisions and untrusted stamp paths before writing":
        val digest = sha256_text("effective-policy")
        val valid = ClangNativeNoopDecisionV1("REBUILD_REQUIRED", digest,
            "fresh-semantic-action-required")
        expect(write_clang_native_stamp_v1(valid, "relative/stamp").reason)
            .to_equal("stamp-path-invalid")
        expect(write_clang_native_stamp_v1(valid, "/tmp/../stamp").reason)
            .to_equal("stamp-path-invalid")
        expect(write_clang_native_stamp_v1(
            ClangNativeNoopDecisionV1("REJECT", digest, "blocked"),
            "/tmp/blocked-stamp").reason).to_equal("policy-decision-invalid")
