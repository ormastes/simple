use std.spec.*
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use app.build.clang_policy.native_noop_gate.{ClangNativeNoopDecisionV1}
use app.build.clang_policy.native_ninja_controller.{
    run_clang_ninja_policy_build_v1}
use app.build.clang_policy.native_ninja_graph.{observe_clang_ninja_graph_v1}
use app.io.mod.{cwd, getpid, time_now_unix_micros, dir_create_all,
    dir_remove_all, file_write_bytes, file_hash_sha256,
    file_is_regular_no_follow, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.sffi.io.{path_absolute}

fn _ninja_controller_root_v1() -> text:
    cwd() + "/build/test/clang-ninja-controller-" +
        getpid().to_text() + "-" + time_now_unix_micros().to_text()

fn _ninja_controller_map_v1() -> text:
    "simple-clang-native-object-map-v1\n" +
    "target=libcore\n" +
    "stamp=policy.stamp\n" +
    "accepted-output=libcore.a\n" +
    "object-count=2\n" +
    "object=CMakeFiles/libcore.dir/a.c.o\n" +
    "object=CMakeFiles/libcore.dir/b.c.o\n"

fn _installed_ninja_for_spec_v1() -> text:
    for path in ["/usr/bin/ninja", "/usr/local/bin/ninja",
                 "/opt/homebrew/bin/ninja"]:
        val resolved = unsafe(capabilities: [ffi]):
            path_absolute(path)
        if file_is_regular_no_follow(resolved): return resolved
    ""

describe "Clang Ninja policy build controller":
    it "runs an approved Ninja graph and captures rebuilt output bytes":
        val ninja_path = _installed_ninja_for_spec_v1()
        if ninja_path == "":
            skip("runs an approved Ninja graph and captures rebuilt output bytes",
                "Ninja is not installed at a supported test path")
        else:
            val root = _ninja_controller_root_v1()
            val objects = root + "/CMakeFiles/libcore.dir"
            expect(dir_create_all(objects)).to_be(true)
            expect(file_write_bytes(objects + "/a.c.o", "old-a".bytes()))
                .to_be(true)
            expect(file_write_bytes(objects + "/b.c.o", "old-b".bytes()))
                .to_be(true)
            expect(file_write_bytes(root + "/libcore.a", "old".bytes()))
                .to_be(true)
            val build_graph = "include CMakeFiles/rules.ninja\n" +
                "build CMakeFiles/libcore.dir/a.c.o: C_COMPILER__write_a\n" +
                "build CMakeFiles/libcore.dir/b.c.o: C_COMPILER__write_b\n" +
                "build libcore.a: C_STATIC_LIBRARY_LINKER__libcore CMakeFiles/libcore.dir/a.c.o CMakeFiles/libcore.dir/b.c.o || policy.stamp\n"
            val rules = "rule C_COMPILER__write_a\n" +
                "  command = /bin/sh -c 'printf object-a > $out'\n" +
                "rule C_COMPILER__write_b\n" +
                "  command = /bin/sh -c 'printf object-b > $out'\n" +
                "rule C_STATIC_LIBRARY_LINKER__libcore\n" +
                "  command = /bin/sh -c 'cat $in > $out'\n"
            expect(file_write_bytes(root + "/build.ninja",
                build_graph.bytes())).to_be(true)
            expect(file_write_bytes(root + "/CMakeFiles/rules.ninja",
                rules.bytes())).to_be(true)
            val graph = observe_clang_ninja_graph_v1(root)
            expect(graph.valid).to_be(true)
            val map = _ninja_controller_map_v1()
            val result = run_clang_ninja_policy_build_v1(
                ClangNativeNoopDecisionV1("REBUILD_REQUIRED",
                    sha256_text("new-policy"), "rebuild"),
                root, "libcore", map, sha256_text(map),
                graph.graph_digest, "", ninja_path,
                file_hash_sha256(ninja_path), 5000, 1024)
            expect(result.verdict).to_equal("BUILT")
            expect(result.output_digest)
                .to_equal(sha256_text("object-aobject-b"))
            expect(sha256_u8_hex(result.output_bytes))
                .to_equal(result.output_digest)
            expect(file_read_regular_no_follow_bounded(
                root + "/libcore.a", 64).unwrap())
                .to_equal("object-aobject-b")
            expect(dir_remove_all(root)).to_be(true)

    it "returns the exact locked no-op bytes and refuses changed output":
        val root = _ninja_controller_root_v1()
        val objects = root + "/CMakeFiles/libcore.dir"
        expect(dir_create_all(objects)).to_be(true)
        val policy = sha256_text("policy")
        expect(file_write_bytes(root + "/policy.stamp",
            (policy + "\n").bytes())).to_be(true)
        expect(file_write_bytes(objects + "/a.c.o", "object-a".bytes()))
            .to_be(true)
        expect(file_write_bytes(objects + "/b.c.o", "object-b".bytes()))
            .to_be(true)
        expect(file_write_bytes(root + "/libcore.a", "accepted".bytes()))
            .to_be(true)
        val original_graph = "include CMakeFiles/rules.ninja\n" +
            "build CMakeFiles/libcore.dir/a.c.o: C_COMPILER__libcore a.c\n" +
            "build CMakeFiles/libcore.dir/b.c.o: C_COMPILER__libcore b.c\n" +
            "build libcore.a: C_STATIC_LIBRARY_LINKER__libcore CMakeFiles/libcore.dir/a.c.o CMakeFiles/libcore.dir/b.c.o\n"
        expect(file_write_bytes(root + "/build.ninja",
            original_graph.bytes())).to_be(true)
        expect(file_write_bytes(root + "/CMakeFiles/rules.ninja",
            ("rule C_COMPILER__libcore\n  command = cc -c $in -o $out\n" +
            "rule C_STATIC_LIBRARY_LINKER__libcore\n  command = ar qc $out $in\n").bytes())).to_be(true)
        val graph = observe_clang_ninja_graph_v1(root)
        expect(graph.valid).to_be(true)
        val map = _ninja_controller_map_v1()
        # /usr/bin/env is intentionally not Ninja: this branch must make no
        # native process call once the protected output is current.
        val ninja_path = "/usr/bin/env"
        val first = run_clang_ninja_policy_build_v1(
            ClangNativeNoopDecisionV1("ADMIT_NOOP", policy, "current"),
            root, "libcore", map, sha256_text(map),
            graph.graph_digest,
            sha256_text("accepted"), ninja_path,
            file_hash_sha256(ninja_path), 5000, 1024)
        expect(first.verdict).to_equal("REUSED")
        expect(first.output_digest).to_equal(sha256_text("accepted"))
        expect(sha256_u8_hex(first.output_bytes))
            .to_equal(sha256_text("accepted"))
        expect(first.native_graph_digest).to_equal(graph.graph_digest)
        expect(file_write_bytes(root + "/build.ninja",
            (original_graph + "# changed graph\n").bytes())).to_be(true)
        val changed_graph = run_clang_ninja_policy_build_v1(
            ClangNativeNoopDecisionV1("ADMIT_NOOP", policy, "current"),
            root, "libcore", map, sha256_text(map),
            graph.graph_digest, sha256_text("accepted"), ninja_path,
            file_hash_sha256(ninja_path), 5000, 1024)
        expect(changed_graph.verdict).to_equal("REJECTED")
        expect(changed_graph.reason).to_equal(
            "native-barrier: native-graph-unapproved")
        expect(file_write_bytes(root + "/build.ninja",
            original_graph.bytes())).to_be(true)
        expect(file_write_bytes(root + "/libcore.a", "changed".bytes()))
            .to_be(true)
        expect(sha256_u8_hex(first.output_bytes))
            .to_equal(sha256_text("accepted"))
        val stale = run_clang_ninja_policy_build_v1(
            ClangNativeNoopDecisionV1("ADMIT_NOOP", policy, "current"),
            root, "libcore", map, sha256_text(map),
            graph.graph_digest,
            sha256_text("accepted"), ninja_path,
            file_hash_sha256(ninja_path), 5000, 1024)
        expect(stale.verdict).to_equal("REJECTED")
        expect(stale.reason).to_equal("native-barrier: accepted-output-changed")
        expect(dir_remove_all(root)).to_be(true)

    it "rejects a changed Ninja identity before changing the policy stamp":
        val root = _ninja_controller_root_v1()
        expect(dir_create_all(root)).to_be(true)
        val map = _ninja_controller_map_v1()
        val blocked = run_clang_ninja_policy_build_v1(
            ClangNativeNoopDecisionV1("REBUILD_REQUIRED",
                sha256_text("new-policy"), "rebuild"), root,
            "libcore", map, sha256_text(map), sha256_text("graph"), "",
            "/usr/bin/env", sha256_text("wrong-tool"), 5000, 1024)
        expect(blocked.verdict).to_equal("REJECTED")
        expect(blocked.reason).to_equal("ninja-or-limits-invalid")
        expect(dir_remove_all(root)).to_be(true)
