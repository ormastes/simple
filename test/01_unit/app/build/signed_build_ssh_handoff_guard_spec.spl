use app.build.signed_build_signature_provider.{
    SignedBuildSshProviderConfigV2,
    verify_signed_build_private_artifact_with_ssh_v2}
use app.build.signed_build_admission.{SignedBuildExpectationV1,
    SignedBuildExpectationV2}
use app.build.signed_build_verifier.{SignedBuildGateResultV1,
    SignedBuildGateResultV2}

describe "protected signed build handoff guard":
    it "returns full build and no artifact path before invalid evidence can be copied":
        val expected = SignedBuildExpectationV2("simple-lang/simple", 42,
            SignedBuildExpectationV1("", "", "", "", "", "",
                "", "", "", "", "", "", "", "", "", "", ""))
        val gates = SignedBuildGateResultV2("simple-lang/simple", 42,
            SignedBuildGateResultV1("", "", "", "", "", "", ""))
        val config = SignedBuildSshProviderConfigV2("", "", "", "",
            "", "", "", "")
        val decision = verify_signed_build_private_artifact_with_ssh_v2(
            "malformed receipt", "", expected, gates, config,
            "/missing/artifact", "/missing/private", 1024)
        expect(decision.admission.decision).to_equal("FULL_BUILD")
        expect(decision.admission.reason).to_equal("signature: receipt-invalid")
        expect(decision.artifact_path).to_equal("")
