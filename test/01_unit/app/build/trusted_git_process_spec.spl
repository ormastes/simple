use std.spec.{describe, it, expect}
use app.build.trusted_git_process.{run_isolated_build_git_v1}

describe "isolated Git process for build admission":
    it "runs Git without host global configuration":
        val (version, version_err, version_code) =
            run_isolated_build_git_v1(["--version"], 15000, 4096)
        expect(version_code).to_equal(0)
        expect(version).to_start_with("git version ")
        expect(version_err).to_equal("")
        val (config, config_err, config_code) =
            run_isolated_build_git_v1(["config", "--global", "--list"],
                15000, 4096)
        expect(config_code).to_equal(0)
        expect(config).to_equal("")
        expect(config_err).to_equal("")
