use std.spec.{describe, it, expect}
use app.build.distribution_acceptance_v1.{
    DistributionTargetRequirementV1, DistributionTargetEvidenceV1,
    check_distribution_acceptance_v1
}

val TREE = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val OTHER_TREE = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val DIGEST = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
val OTHER_DIGEST = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"

fn _requirement(target: text, artifact: text, required: bool) -> DistributionTargetRequirementV1:
    DistributionTargetRequirementV1(target, "x86_64-unknown-linux-gnu", artifact, TREE, required)

fn _evidence(target: text, artifact: text, status: text) -> DistributionTargetEvidenceV1:
    DistributionTargetEvidenceV1(target, "x86_64-unknown-linux-gnu", artifact, TREE,
        DIGEST, DIGEST, "native-stage2", status)

fn _reason(requests: [DistributionTargetRequirementV1],
        rows: [DistributionTargetEvidenceV1]) -> text:
    check_distribution_acceptance_v1(requests, rows).reason

describe "distribution acceptance V1 copied-observation contract":
    it "accepts a complete reordered native matrix on one candidate tree":
        val requests = [_requirement("//compiler:linux", "simple-linux", true),
            DistributionTargetRequirementV1("//compiler:windows", "x86_64-pc-windows-gnu",
                "simple-windows.exe", TREE, false)]
        val rows = [DistributionTargetEvidenceV1("//compiler:windows", "x86_64-pc-windows-gnu",
                "simple-windows.exe", TREE, DIGEST, DIGEST, "native-stage2", "not-required"),
            _evidence("//compiler:linux", "simple-linux", "passed")]
        val result = check_distribution_acceptance_v1(requests, rows)
        expect(result.accepted).to_be(true)
        expect(result.reason).to_equal("accepted")

    it "rejects empty missing and unexpected matrix rows":
        val requested = _requirement("linux", "simple-linux", true)
        val observed = _evidence("linux", "simple-linux", "passed")
        expect(_reason([], [])).to_equal("matrix-empty")
        expect(_reason([requested], [])).to_equal("matrix-empty")
        expect(_reason([requested, _requirement("windows", "simple-windows.exe", true)],
            [observed])).to_equal("matrix-incomplete")
        expect(_reason([requested], [_evidence("windows", "simple-linux", "passed")])).to_equal(
            "target-unrequested")

    it "bounds the target matrix before scanning it":
        var requests: [DistributionTargetRequirementV1] = []
        var rows: [DistributionTargetEvidenceV1] = []
        var index: i64 = 0
        while index < 65:
            val target = "target-" + index.to_text()
            val artifact = "simple-" + index.to_text()
            requests.push(_requirement(target, artifact, true))
            rows.push(_evidence(target, artifact, "passed"))
            index = index + 1
        expect(_reason(requests, rows)).to_equal("matrix-too-large")

    it "rejects duplicate targets and artifact names in both matrices":
        val a = _requirement("linux", "simple-linux", true)
        val b = _requirement("windows", "simple-windows.exe", true)
        val ea = _evidence("linux", "simple-linux", "passed")
        val eb = _evidence("windows", "simple-windows.exe", "passed")
        expect(_reason([a, a], [ea, eb])).to_equal("requirement-target-duplicate")
        expect(_reason([a, _requirement("windows", "simple-linux", true)],
            [ea, eb])).to_equal("requirement-artifact-duplicate")
        expect(_reason([a, b], [ea, ea])).to_equal("evidence-target-duplicate")
        expect(_reason([a, b], [ea, _evidence("windows", "simple-linux", "passed")])).to_equal(
            "evidence-artifact-duplicate")

    it "rejects mixed candidates and exact identity mismatches":
        val request = _requirement("linux", "simple-linux", true)
        val observed = _evidence("linux", "simple-linux", "passed")
        var second = _requirement("windows", "simple-windows.exe", true)
        second.candidate_tree = OTHER_TREE
        expect(_reason([request, second], [observed,
            _evidence("windows", "simple-windows.exe", "passed")])).to_equal("candidate-tree-mixed")
        var wrong = observed
        wrong.target_triple = "aarch64-unknown-linux-gnu"
        expect(_reason([request], [wrong])).to_equal("target-triple-mismatch")
        wrong = observed
        wrong.artifact_name = "seed-fallback"
        expect(_reason([request], [wrong])).to_equal("artifact-name-mismatch")
        wrong = observed
        wrong.candidate_tree = OTHER_TREE
        expect(_reason([request], [wrong])).to_equal("candidate-tree-mismatch")

    it "rejects copied artifact provenance mismatch and non-native products":
        val request = _requirement("linux", "simple-linux", true)
        var wrong = _evidence("linux", "simple-linux", "passed")
        wrong.provenance_artifact_sha256 = OTHER_DIGEST
        expect(_reason([request], [wrong])).to_equal("artifact-provenance-mismatch")
        wrong = _evidence("linux", "simple-linux", "passed")
        wrong.product_kind = "seed-fallback"
        expect(_reason([request], [wrong])).to_equal("product-kind-invalid")
        wrong.product_kind = "native-stage1"
        expect(_reason([request], [wrong])).to_equal("product-kind-invalid")

    it "requires passed execution and rejects failed skipped or unknown even when optional":
        val mandatory = _requirement("linux", "simple-linux", true)
        val optional = _requirement("linux", "simple-linux", false)
        expect(_reason([mandatory], [_evidence("linux", "simple-linux", "not-required")])).to_equal(
            "execution-required")
        for status in ["skipped", "failed", "unknown", ""]:
            expect(_reason([mandatory], [_evidence("linux", "simple-linux", status)])).to_equal(
                "execution-status-invalid")
            expect(_reason([optional], [_evidence("linux", "simple-linux", status)])).to_equal(
                "execution-status-invalid")

    it "rejects malformed bounded identifiers revisions and digests":
        val observed = _evidence("linux", "simple-linux", "passed")
        var request = _requirement("linux", "simple-linux", true)
        request.target_id = ""
        expect(_reason([request], [observed])).to_equal("requirement-invalid")
        request = _requirement("linux", "simple-linux", true)
        request.target_id = DIGEST + DIGEST + "a"
        expect(_reason([request], [observed])).to_equal("requirement-invalid")
        request = _requirement("linux", "simple-linux", true)
        request.artifact_name = "../seed"
        expect(_reason([request], [observed])).to_equal("requirement-invalid")
        request = _requirement("linux", "simple-linux", true)
        request.candidate_tree = "A" + TREE[1:]
        expect(_reason([request], [observed])).to_equal("requirement-invalid")
        var wrong = observed
        wrong.artifact_sha256 = "A" + DIGEST[1:]
        expect(_reason([_requirement("linux", "simple-linux", true)], [wrong])).to_equal(
            "evidence-invalid")
        wrong = observed
        wrong.provenance_artifact_sha256 = "short"
        expect(_reason([_requirement("linux", "simple-linux", true)], [wrong])).to_equal(
            "evidence-invalid")
        wrong = observed
        wrong.artifact_name = "simple/linux"
        expect(_reason([_requirement("linux", "simple-linux", true)], [wrong])).to_equal(
            "evidence-invalid")

    it "accepts a 64 digit candidate tree":
        var request = _requirement("linux", "simple-linux", true)
        var observed = _evidence("linux", "simple-linux", "passed")
        request.candidate_tree = DIGEST
        observed.candidate_tree = DIGEST
        expect(check_distribution_acceptance_v1([request], [observed]).accepted).to_be(true)
