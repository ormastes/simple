use std.spec.{describe, it, expect}
use std.common.crypto.sha256.{sha256_u8_hex}
use app.build.signed_build_stream.{
    signed_build_artifact_stream_new_v2,
    signed_build_artifact_stream_update_v2,
    signed_build_artifact_stream_finish_v2
}

fn _artifact_bytes(count: i64) -> [u8]:
    var bytes: [u8] = [0u8; count]
    var i = 0
    while i < count:
        bytes[i] = ((i * 17 + 3) & 255).to_u8()
        i = i + 1
    bytes

fn _slice_bytes(bytes: [u8], start: i64, count: i64) -> [u8]:
    var part: [u8] = [0u8; count]
    var i = 0
    while i < count:
        part[i] = bytes[start + i]
        i = i + 1
    part

describe "signed build artifact byte stream V2":
    it "hashes exact order across block and checkpoint boundaries":
        val bytes = _artifact_bytes(4173)
        val expected = sha256_u8_hex(bytes)
        var stream = signed_build_artifact_stream_new_v2(32505856).unwrap()
        signed_build_artifact_stream_update_v2(stream, _slice_bytes(bytes, 0, 1)).unwrap()
        signed_build_artifact_stream_update_v2(stream, _slice_bytes(bytes, 1, 62)).unwrap()
        signed_build_artifact_stream_update_v2(stream, _slice_bytes(bytes, 63, 4096)).unwrap()
        signed_build_artifact_stream_update_v2(stream, _slice_bytes(bytes, 4159, 14)).unwrap()
        val result = signed_build_artifact_stream_finish_v2(stream, 4173, expected)
        expect(result.decision).to_equal("VERIFIED")
        expect(result.digest).to_equal(expected)
        expect(result.length).to_equal(4173)
        expect(signed_build_artifact_stream_update_v2(stream, [1u8])).to_equal(
            Err("artifact-stream-finished"))
        expect(signed_build_artifact_stream_finish_v2(stream, 4173, expected).reason).to_equal(
            "artifact-stream-finished")

    it "rejects reordered bytes and a wrong expected digest":
        var stream = signed_build_artifact_stream_new_v2(1024).unwrap()
        signed_build_artifact_stream_update_v2(stream, [98u8, 97u8, 99u8]).unwrap()
        val result = signed_build_artifact_stream_finish_v2(stream, 3,
            sha256_u8_hex([97u8, 98u8, 99u8]))
        expect(result.decision).to_equal("FULL_BUILD")
        expect(result.reason).to_equal("artifact-digest-mismatch")
        expect(result.digest).to_equal(sha256_u8_hex([98u8, 97u8, 99u8]))

    it "rejects missing, zero, oversized and simulated 31 MiB expectations":
        expect(signed_build_artifact_stream_new_v2(0).unwrap_err()).to_equal(
            "invalid-artifact-limit")
        expect(signed_build_artifact_stream_new_v2(2305843009213693952).unwrap_err()).to_equal(
            "invalid-artifact-limit")
        var stream = signed_build_artifact_stream_new_v2(32505856).unwrap()
        signed_build_artifact_stream_update_v2(stream, [1u8, 2u8]).unwrap()
        expect(signed_build_artifact_stream_finish_v2(stream, 32505856,
            sha256_u8_hex([1u8, 2u8])).reason).to_equal("artifact-size-mismatch")
        var missing = signed_build_artifact_stream_new_v2(100).unwrap()
        expect(signed_build_artifact_stream_finish_v2(missing, 0, "").reason).to_equal(
            "invalid-artifact-expectation")

    it "rejects empty chunks, over-cap bytes and further updates after failure":
        var empty = signed_build_artifact_stream_new_v2(10).unwrap()
        expect(signed_build_artifact_stream_update_v2(empty, [])).to_equal(
            Err("empty-artifact-chunk"))
        expect(signed_build_artifact_stream_update_v2(empty, [1u8])).to_equal(
            Err("empty-artifact-chunk"))
        expect(signed_build_artifact_stream_finish_v2(empty, 1,
            sha256_u8_hex([1u8])).reason).to_equal("empty-artifact-chunk")
        var capped = signed_build_artifact_stream_new_v2(2).unwrap()
        signed_build_artifact_stream_update_v2(capped, [1u8, 2u8]).unwrap()
        expect(signed_build_artifact_stream_update_v2(capped, [3u8])).to_equal(
            Err("artifact-size-limit-exceeded"))
        expect(signed_build_artifact_stream_finish_v2(capped, 2,
            sha256_u8_hex([1u8, 2u8])).decision).to_equal("FULL_BUILD")
        var large_chunk = signed_build_artifact_stream_new_v2(131072).unwrap()
        expect(signed_build_artifact_stream_update_v2(large_chunk,
            _artifact_bytes(65537))).to_equal(Err("artifact-chunk-too-large"))
