"""
## Purpose and audience
Purpose: Prove `provider_entry` emits the `<artifact>.provider.sdn` sidecar that
`provider_gate` requires, so an opt-in backend build no longer fails closed with
`provider-missing`, and that the emitted descriptor is the admitted shape
(ABI v1, host triple, `object_emit`).
Audience: compiler and tooling engineers who maintain backend build groups.
"""
# @req: REQ-APP-BUILD-001 — provider_entry emits .provider.sdn (plan §6).

use app.build.targets.build_targets.{parse_targets_text, find_target, BACKEND_PROVIDER_ABI_VERSION}
use app.build.targets.provider_gate.{provider_gate, provider_sidecar_path, parse_provider_descriptor}
use app.build.targets.provider_entry.{render_provider_descriptor, emit_provider_sidecar}
use std.nogc_sync_mut.io_runtime.{file_write, file_read, file_exists, file_delete, dir_create_all}
use std.spec.step

val HOST = "x86_64-unknown-linux-gnu"
val ROOT = "build/tmp/provider_entry_spec"
val SRC = "group host:\n    default: true\n    members: compiler\n\ngroup backends_cuda:\n    default: false\n    members: //backend:cuda\n\ntarget compiler:\n    kind: binary\n    entry: src/main.spl\n\ntarget //backend:cuda:\n    kind: shared\n    entry: src/plugins/backend_cuda/cuda_backend.spl\n    output: build/backends/host/backend_cuda-v1.so\n"

fn _fresh(case_name: text) -> text:
    val dir = ROOT + "/" + case_name
    dir_create_all(dir)
    file_delete(dir + "/receipts/backends_cuda.sdn")
    file_delete(provider_sidecar_path(dir + "/backend.so"))
    file_write(dir + "/backend.so", "provider-bytes")
    dir

describe "provider_entry sidecar emission":
    it "renders a descriptor the gate parser accepts":
        val text_out = render_provider_descriptor("backends_cuda", HOST)
        val d = parse_provider_descriptor(text_out).unwrap()
        expect(d.group).to_equal("backends_cuda")
        expect(d.host_triple).to_equal(HOST)
        expect(d.abi_version).to_equal(BACKEND_PROVIDER_ABI_VERSION)
        expect(d.capabilities.contains("object_emit")).to_equal(true)

    it "writes the sidecar next to the artifact":
        val dir = _fresh("write")
        expect(file_exists(provider_sidecar_path(dir + "/backend.so"))).to_equal(false)
        val err = emit_provider_sidecar("backends_cuda", dir + "/backend.so", HOST)
        expect(err).to_equal("")
        expect(file_exists(provider_sidecar_path(dir + "/backend.so"))).to_equal(true)

    it "lets an opt-in backend pass the gate instead of failing closed":
        val dir = _fresh("gate")
        val ts = parse_targets_text(SRC)
        val t = ts.targets[find_target(ts, "//backend:cuda")]
        val before = provider_gate(ts, t, dir + "/backend.so", dir + "/backend.so", HOST, dir + "/receipts")
        expect(before).to_start_with("SPL-PROVIDER-ABI-001: provider-missing")
        val err = emit_provider_sidecar("backends_cuda", dir + "/backend.so", HOST)
        expect(err).to_equal("")
        val after = provider_gate(ts, t, dir + "/backend.so", dir + "/backend.so", HOST, dir + "/receipts")
        expect(after).to_equal("")

    it "refuses an empty group":
        val dir = _fresh("empty")
        val err = emit_provider_sidecar("", dir + "/backend.so", HOST)
        expect(err).to_start_with("SPL-PROVIDER-ABI-001: provider-entry")

describe "provider_entry never overwrites":
    it "refuses to replace an existing sidecar":
        val dir = _fresh("no_overwrite")
        val sc = provider_sidecar_path(dir + "/backend.so")
        file_write(sc, "provider-owned")
        expect(emit_provider_sidecar("backends_cuda", dir + "/backend.so", HOST)).to_start_with("SPL-PROVIDER-ABI-001: provider-entry")
        expect(file_read(sc)).to_equal("provider-owned")
