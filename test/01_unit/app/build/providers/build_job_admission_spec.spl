use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.common.build_contract.{BuildInputRef, SnapshotManifest,
    ToolchainManifest, InputManifest, ActionSpec, AttemptSpec,
    action_spec_digest_v1}
use app.build.scheduler.worker_request.{BuildWorkerRequestV1,
    encode_build_worker_request_v1}
use app.build.scheduler.worker_capability.{BuildWorkerCapabilityV1}
use app.build.scheduler.worker_sandbox_identity.{
    build_worker_sandbox_digest_v1}
use app.build.providers.build_job_admission.{admit_build_job_v1}
use app.build.providers.build_job_plan.{plan_build_job_v1}
use std.common.contracts.orchestration.resource_v1.{ObjectMetaV1,
    ResourcesV1, ContainerV1, PodSpecV1}
use std.common.contracts.orchestration.ci_v1.{JobV1}

fn _job_capability_v1() -> BuildWorkerCapabilityV1:
    val digest = sha256_text("provider-fixture")
    val image = "example/compiler@sha256:" + digest
    val tool = ToolchainManifest(1, digest, digest, digest,
        digest, digest, "x86_64-unknown-linux-gnu")
    BuildWorkerCapabilityV1("worker-1", "linux", "x86_64",
        "0f9ad7e0-1111-4222-8333-444444444444", 7, "linux-oci-v1",
        "podman", "rootless", image, "/usr/bin/clang", tool,
        build_worker_sandbox_digest_v1(image, "podman", "/usr/bin/clang"),
        digest, 2, 8192, digest)

fn _job_request_v1(cap: BuildWorkerCapabilityV1) -> BuildWorkerRequestV1:
    val snapshot = sha256_text("snapshot")
    val action = ActionSpec(1, "compile",
        SnapshotManifest(1, snapshot, sha256_text("tree"),
            sha256_text("submodules")), cap.toolchain,
        InputManifest(1, snapshot,
            [BuildInputRef("src/unit.c", sha256_text("source"))],
            [], [], [], [], [], sha256_text("closure"), true, false),
        ["/usr/bin/clang", "-c", "/simple-build/inputs/src/unit.c", "-o", "unit.o"],
        "simple-build/outputs", cap.sandbox_digest, ["unit.o"],
        cap.resource_policy_digest)
    BuildWorkerRequestV1(action,
        AttemptSpec(1, action_spec_digest_v1(action), "try-1",
            cap.worker_id, 0, 0, 4096), 1, 2, 8)

fn _job_v1(request: BuildWorkerRequestV1,
        cap: BuildWorkerCapabilityV1) -> JobV1:
    val resources = ResourcesV1(cpu_request_millis: 2000,
        cpu_limit_millis: 2000, memory_request_bytes: 4096,
        memory_limit_bytes: 4096)
    val container = ContainerV1(name: "compiler", image: cap.image,
        artifact_set_ref: "", command: request.action.argv, args: [],
        ports: [], resources: resources)
    JobV1(meta: ObjectMetaV1(name: "try-1", ns: "build", labels: {
        "simple-build-request-digest":
            sha256_text(encode_build_worker_request_v1(request))}),
        backoff_limit: 0,
        template: PodSpecV1(os_name: "linux",
            runtime_class: "native-container", network_profile: "endpoint-v1",
            containers: [container]))

describe "distributed build Job provider admission":
    it "constructs a fenced Linux Job from a macOS controller and rechecks admission":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        val plan = plan_build_job_v1(request, cap, "macos", "build")
        expect(plan.ready).to_be(true)
        expect(plan.job == nil).to_be(false)
        val job = plan.job.unwrap()
        expect(job.meta.ns).to_equal("build")
        expect(job.meta.labels["simple-build-request-digest"])
            .to_equal(sha256_text(encode_build_worker_request_v1(request)))
        expect(job.template.os_name).to_equal("linux")
        expect(job.backoff_limit).to_equal(0)
        expect(admit_build_job_v1(request, cap, job, "macos").ready)
            .to_be(true)

    it "rejects invalid Job namespaces and mismatched worker capabilities":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        expect(plan_build_job_v1(request, cap, "windows", "bad/name").reason)
            .to_equal("namespace-invalid")
        var changed = cap
        changed.worker_id = "worker-2"
        val plan = plan_build_job_v1(request, changed, "windows", "build")
        expect(plan.ready).to_be(false)
        expect(plan.reason).to_equal("attempt-or-retry-mismatch")
        expect(plan.job == nil).to_be(true)

    it "allows a macOS controller to select an actual remote Linux OCI worker":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        val admitted = admit_build_job_v1(request, cap,
            _job_v1(request, cap), "macos")
        expect(admitted.ready).to_be(true)
        expect(admitted.controller_os).to_equal("macos")
        expect(admitted.execution_os).to_equal("linux")
        expect(admitted.provider_id).to_equal("linux-oci-v1")

    it "allows BSD controllers to select a qualified remote Linux worker":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        for controller_os in ["freebsd", "openbsd", "netbsd"]:
            val plan = plan_build_job_v1(request, cap, controller_os, "build")
            expect(plan.ready).to_be(true)
            expect(plan.job == nil).to_be(false)
            expect(plan.job.unwrap().template.os_name).to_equal("linux")
        expect(admit_build_job_v1(request, cap,
            _job_v1(request, cap), "unknown").reason)
            .to_equal("identity-invalid")

    it "refuses a native-container claim for a different execution OS":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        var job = _job_v1(request, cap)
        var pod = job.template
        pod.os_name = "macos"
        job.template = pod
        expect(admit_build_job_v1(request, cap, job, "macos").reason)
            .to_equal("execution-os-mismatch")
        job = _job_v1(request, cap)
        pod = job.template
        pod.runtime_class = "native-process"
        job.template = pod
        expect(admit_build_job_v1(request, cap, job, "macos").reason)
            .to_equal("runtime-class-unsupported")

    it "keeps the image, command, resources and retry owner exact":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        var job = _job_v1(request, cap)
        var pod = job.template
        var container = pod.containers[0]
        container.image = "other/compiler@sha256:" +
            sha256_text("other")
        pod.containers = [container]
        job.template = pod
        expect(admit_build_job_v1(request, cap, job, "linux").reason)
            .to_equal("container-identity-mismatch")
        job = _job_v1(request, cap)
        pod = job.template
        container = pod.containers[0]
        var resources = container.resources
        resources.cpu_limit_millis = 1000
        container.resources = resources
        pod.containers = [container]
        job.template = pod
        expect(admit_build_job_v1(request, cap, job, "linux").reason)
            .to_equal("resource-mismatch")
        job = _job_v1(request, cap)
        job.backoff_limit = 1
        expect(admit_build_job_v1(request, cap, job, "linux").reason)
            .to_equal("attempt-or-retry-mismatch")

    it "binds the exact fenced request and source snapshot to Job metadata":
        val cap = _job_capability_v1()
        val request = _job_request_v1(cap)
        val job = _job_v1(request, cap)
        var changed = request
        changed.fence = 3
        expect(admit_build_job_v1(changed, cap, job, "linux").reason)
            .to_equal("request-digest-mismatch")
        changed = request
        var action = changed.action
        var inputs = action.inputs
        var source = inputs.source_inputs[0]
        source.content_digest = sha256_text("other-source")
        inputs.source_inputs = [source]
        action.inputs = inputs
        changed.action = action
        var attempt = changed.attempt
        attempt.action_digest = action_spec_digest_v1(action)
        changed.attempt = attempt
        expect(admit_build_job_v1(changed, cap, job, "linux").reason)
            .to_equal("request-digest-mismatch")
