use std.spec.*
use app.io._CliCompile.native_build_closure.{_nb_scv_snapshot_build_path_v1}

describe "native-build generated source snapshot paths":
    it "keeps ordinary admitted build-tree sources out of CUDA composition validation":
        expect(_nb_scv_snapshot_build_path_v1(
            "/owner", "/frozen", "build/os/generated", "build/os/generated"
        )).to_equal("/frozen/build/os/generated")
        expect(_nb_scv_snapshot_build_path_v1(
            "/owner", "/frozen", "build/hw/hello.spl", "build/hw/hello.spl"
        )).to_equal("/frozen/build/hw/hello.spl")
