use std.spec.*
use app.io._CliCompile.native_build_snapshot_roots.{native_build_snapshot_source_roots_v1}
use app.io.time_ops.{time_now_unix_micros}
use test.fixtures.scv_positional_snapshot.snapshot_case.{positional_snapshot_case}

describe "positional native-build admitted source roots":
    it "uses named workspace roots and preserves explicit roots exactly":
        expect(native_build_snapshot_source_roots_v1("src/app/mcp/main.spl", [])).to_equal(
            ["src/app", "src/lib", "src/compiler"])
        val explicit = ["test/fixtures/native_build_closure/src/lib"]
        expect(native_build_snapshot_source_roots_v1("entry.spl", explicit)).to_equal(explicit)
        # Invalid explicit input stays explicit; the CLI/snapshot owner rejects
        # it instead of silently widening to the positional defaults.
        expect(native_build_snapshot_source_roots_v1("src/app/main.spl", [""])).to_equal([""])

    it "includes an entry's sibling directory without accepting scope escape":
        expect(native_build_snapshot_source_roots_v1("test/fixture/main.spl", [])).to_equal(
            ["src/app", "src/lib", "src/compiler", "test/fixture"])
        for unsafe_entry in ["", "../main.spl", "/outside/main.spl", "D:/outside/main.spl", "src/../main.spl", "src/./main.spl", "src//main.spl", "src\\main.spl", "src/app/"]:
            expect(native_build_snapshot_source_roots_v1(unsafe_entry, [])).to_equal([])

    it "requires explicit finite source roots for a repository-root entry":
        expect(native_build_snapshot_source_roots_v1("main.spl", [])).to_equal([])
        expect(native_build_snapshot_source_roots_v1("main.spl", ["src/lib"])).to_equal(["src/lib"])

    it "freezes actual sibling and library bytes and refuses missing admitted bytes":
        val root = "build/tests/positional-snapshot-{time_now_unix_micros()}"
        expect(positional_snapshot_case(root)).to_equal("")
