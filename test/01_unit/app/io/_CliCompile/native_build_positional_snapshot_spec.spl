use std.spec.*
use app.io._CliCompile.native_build_snapshot_roots.{native_build_snapshot_source_roots_v1,
    native_build_selected_snapshot_source_roots_v1}
use std.io_runtime.{dir_create_all}
use app.io.file_ops.{path_absolute}
use app.io.time_ops.{time_now_unix_micros}
use test.fixtures.scv_positional_snapshot.snapshot_case.{positional_snapshot_case}

describe "positional native-build admitted source roots":
    it "uses named workspace roots and preserves explicit roots exactly":
        expect(native_build_snapshot_source_roots_v1("src/app/mcp/main.spl", [])).to_equal(
            ["src/app", "src/lib", "src/compiler", "src/os", "src/plugins"])
        val explicit = ["test/fixtures/native_build_closure/src/lib"]
        expect(native_build_snapshot_source_roots_v1("entry.spl", explicit)).to_equal(explicit)
        # Invalid explicit input stays explicit; the CLI/snapshot owner rejects
        # it instead of silently widening to the positional defaults.
        expect(native_build_snapshot_source_roots_v1("src/app/main.spl", [""])).to_equal([""])

    it "includes an entry's sibling directory without accepting scope escape":
        expect(native_build_snapshot_source_roots_v1("test/fixture/main.spl", [])).to_equal(
            ["src/app", "src/lib", "src/compiler", "src/os", "src/plugins", "test/fixture"])
        for unsafe_entry in ["", "../main.spl", "/outside/main.spl", "D:/outside/main.spl", "src/../main.spl", "src/./main.spl", "src//main.spl", "src\\main.spl", "src/app/"]:
            expect(native_build_snapshot_source_roots_v1(unsafe_entry, [])).to_equal([])

    it "requires explicit finite source roots for a repository-root entry":
        expect(native_build_snapshot_source_roots_v1("main.spl", [])).to_equal([])
        expect(native_build_snapshot_source_roots_v1("main.spl", ["src/lib"])).to_equal(["src/lib"])

    it "freezes actual sibling and library bytes and refuses missing admitted bytes":
        val root = "build/tests/positional-snapshot-{time_now_unix_micros()}"
        expect(positional_snapshot_case(root)).to_equal("")

fn stage3_plugin_root_fixture(with_plugins: bool) -> text:
    val root = path_absolute("build/tests/stage3-plugin-root-{with_plugins}-{time_now_unix_micros()}")
    for directory in ["src/app/cli", "src/lib", "src/compiler"]:
        if not dir_create_all(root + "/" + directory): return ""
    if with_plugins and not dir_create_all(root + "/src/plugins/backend_vhdl"): return ""
    root

describe "selected snapshot roots of a Stage 3 explicit-root build":
    # Stage 3 passes exactly five --source roots (the exact capsule has five
    # root slots, ae59f16b1dd) and reaches src/plugins only through the entry
    # closure: src/app imports plugins.*. An SCV snapshot of those five roots
    # cannot resolve those imports, so the HIR pool's closure request never
    # admitted (bug stage3_two_pass_hir_pool_scv_roots_omit_plugins_2026-11-13).
    val stage3 = ["src/compositions/kernel_llvm_cranelift", "src/compositions/cuda_static",
        "src/compiler", "src/app", "src/lib"]

    it "admits src/plugins beside an explicit src/app root":
        val root = stage3_plugin_root_fixture(true)
        expect(root != "").to_equal(true)
        val roots = native_build_selected_snapshot_source_roots_v1(root, "src/app/cli/bootstrap_main.spl", stage3)
        expect(roots).to_equal(stage3 + ["src/plugins", "src/app/cli/bootstrap_main.spl"])

    it "keeps an explicit src/plugins root once":
        val root = stage3_plugin_root_fixture(true)
        val explicit = ["src/app", "src/plugins", "src/lib"]
        expect(native_build_selected_snapshot_source_roots_v1(root, "src/app/cli/main.spl", explicit)).to_equal(
            explicit + ["src/app/cli/main.spl"])

    it "adds nothing when the checkout has no src/plugins":
        val root = stage3_plugin_root_fixture(false)
        expect(native_build_selected_snapshot_source_roots_v1(root, "src/app/cli/bootstrap_main.spl", stage3)).to_equal(
            stage3 + ["src/app/cli/bootstrap_main.spl"])

    it "adds nothing to explicit roots without src/app":
        val root = stage3_plugin_root_fixture(true)
        expect(native_build_selected_snapshot_source_roots_v1(root, "src/lib/x.spl", ["src/lib"])).to_equal(
            ["src/lib", "src/lib/x.spl"])
