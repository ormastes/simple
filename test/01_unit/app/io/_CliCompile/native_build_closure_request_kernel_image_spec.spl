use std.spec.*
use app.io._CliCompile.native_build_closure_request_admit.{native_build_kernel_image_hash_path_v1}

# A HIR pool worker is launched from a sealed memfd pin (OwnedExecutablePin,
# runtime_process_owned.c: memfd + fexecve). Its /proc/self/exe names
# "/memfd:... (deleted)", so cli_kernel_executable_path() resolves to "" and
# the child-side closure admission refused every worker with "compiler
# executable could not be hashed" (run-21 Stage 2, 2026-11-13). The running
# image is still readable through /proc/self/exe itself.
describe "closure request admission hashes the running compiler image":
    it "hashes the resolved executable path when the image has one":
        expect(native_build_kernel_image_hash_path_v1("/opt/simple/bin/simple", "linux", true)).to_equal(
            "/opt/simple/bin/simple")

    it "hashes /proc/self/exe for a pinned (memfd) launch with no path":
        expect(native_build_kernel_image_hash_path_v1("", "linux", true)).to_equal("/proc/self/exe")
        expect(native_build_kernel_image_hash_path_v1("", "freebsd", true)).to_equal("/proc/self/exe")

    it "names nothing when neither a path nor /proc/self/exe is available":
        expect(native_build_kernel_image_hash_path_v1("", "freebsd", false)).to_equal("")
        expect(native_build_kernel_image_hash_path_v1("", "windows", true)).to_equal("")
