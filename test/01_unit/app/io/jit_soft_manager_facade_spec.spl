"""Canonical Simple-facing names for the soft JIT execution manager."""

use std.spec.*
use app.io.jit_sffi.{
    soft_jit_set_backend,
    soft_jit_get_backend,
    soft_exec_manager_create,
    soft_exec_manager_cleanup,
    soft_exec_manager_compile_source,
    soft_exec_manager_compile,
    soft_exec_manager_compile_mir,
    soft_exec_manager_compile_file,
    soft_exec_manager_execute,
    soft_exec_manager_execute_string,
    soft_exec_manager_execute_void,
    soft_exec_manager_has_function,
    soft_exec_manager_list_functions,
    soft_exec_manager_backend_name,
    soft_exec_manager_is_valid,
    soft_exec_manager_set_opt_level,
    soft_exec_manager_get_opt_level,
    soft_exec_manager_get_last_error,
    soft_exec_manager_clear_error,
}

describe "soft JIT manager canonical facade":
    it "uses canonical backend control names":
        expect(soft_jit_set_backend("auto")).to_be(true)
        expect(soft_jit_get_backend()).to_equal("native")

    it "compiles through the canonical file-write facade and manages state":
        val handle = soft_exec_manager_create("auto")
        expect(handle).to_be_greater_than(0)
        expect(soft_exec_manager_compile_source(handle, "fn add(x: i64, y: i64) -> i64: x + y")).to_equal("")
        expect(soft_exec_manager_compile(handle, "fn sub(x: i64, y: i64) -> i64: x - y")).to_equal("")
        expect(soft_exec_manager_compile_mir(handle, "fn mul(x: i64, y: i64) -> i64: x * y")).to_equal("")
        expect(soft_exec_manager_has_function(handle, "mul")).to_be(true)
        expect(soft_exec_manager_list_functions(handle)).to_contain("mul")
        expect(soft_exec_manager_backend_name(handle)).to_equal("native")
        expect(soft_exec_manager_is_valid(handle)).to_be(true)
        expect(soft_exec_manager_set_opt_level(handle, 3)).to_be(true)
        expect(soft_exec_manager_get_opt_level(handle)).to_equal(2)
        expect(soft_exec_manager_get_last_error(handle)).to_equal("")
        expect(soft_exec_manager_clear_error(handle)).to_equal(0)
        expect(soft_exec_manager_compile_file(handle, "test/01_unit/app/io/jit_soft_manager_facade_spec.spl")).to_equal("")
        expect(soft_exec_manager_cleanup(handle)).to_equal(0)
        expect(soft_exec_manager_is_valid(handle)).to_be(false)

    it "fails closed through canonical execution names for a missing handle":
        val missing_handle = -987654321
        expect(soft_exec_manager_execute(missing_handle, "missing", [])).to_equal(-1)
        expect(soft_exec_manager_execute_string(missing_handle, "missing", [])).to_equal("")
        expect(soft_exec_manager_execute_void(missing_handle, "missing")).to_be(false)
