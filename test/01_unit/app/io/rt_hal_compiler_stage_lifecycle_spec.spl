# The compiler-owned privileged seam lives under `src/compiler/50.mir`.
# A generic app/io test must never import or call its package-private cold
# installer: that would bypass the exact owner rule MIR lowering enforces.

use std.spec
use std.nogc_sync_mut.io.env_ops.{host_os}
use compiler.mir.rt_hal_stage_test_seam.{rt_hal_compiler_stage_lifecycle_harness}

describe "RT/HAL compiler staged lifecycle":
    it "seals effect-capable Plan A and rejects distinct same-rank Plan B":
        if host_os() != "linux":
            pass_do_nothing("RTHAL-SKIP-NONLINUX: pinned Linux host required")
            return
        expect(rt_hal_compiler_stage_lifecycle_harness()).to_equal("")
