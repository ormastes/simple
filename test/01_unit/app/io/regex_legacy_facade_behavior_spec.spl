use std.spec.{describe, it, expect}
use app.io.regex_ffi.{regex_new, regex_destroy, regex_is_match, regex_find, regex_replace_all, is_valid_ipv4}

describe "legacy regex facade delegates to the canonical handle owner":
    it "compiles once and preserves matching and replacement through the legacy path":
        val regex = unsafe(capabilities: [ffi]): regex_new("[0-9]+")
        expect(regex.is_valid).to_be(true)
        expect(regex.pattern).to_equal("[0-9]+")
        expect(unsafe(capabilities: [ffi]): regex_is_match(regex, "x42y")).to_be(true)
        expect(unsafe(capabilities: [ffi]): regex_is_match(regex, "letters")).to_be(false)
        expect(unsafe(capabilities: [ffi]): regex_find(regex, "x42y")).to_equal("42")
        expect(unsafe(capabilities: [ffi]): regex_replace_all(regex, "x42y7", "#")).to_equal("x#y#")
        unsafe(capabilities: [ffi]): regex_destroy(regex)

    it "retains the invalid-pattern contract and refuses an invalid handle":
        val invalid = unsafe(capabilities: [ffi]): regex_new("(")
        expect(invalid.is_valid).to_be(false)
        expect(unsafe(capabilities: [ffi]): regex_is_match(invalid, "anything")).to_be(false)
        expect(unsafe(capabilities: [ffi]): regex_find(invalid, "anything")).to_equal("")
        unsafe(capabilities: [ffi]): regex_destroy(invalid)

    it "exports validators from the same canonical facade":
        expect(unsafe(capabilities: [ffi]): is_valid_ipv4("192.0.2.7")).to_be(true)
        expect(unsafe(capabilities: [ffi]): is_valid_ipv4("not-an-ip")).to_be(false)
