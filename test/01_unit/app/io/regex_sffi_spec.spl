"""
## Purpose and audience
Purpose: Regression coverage for the REQ-APP-IO-001 regex safe-SFFI surface.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Pins the safe surface of app.io.regex_sffi (regex_new .. is_valid_ipv4) and
the legacy app.io.regex_ffi path. Every call here is made WITHOUT unsafe
blocks: the safe-SFFI migration is exactly what makes that possible.
# @manual: primary
REQ-APP-IO-001
doc/08_tracking/bug/req_app_io_001_regex_sffi_migration_missing_2026-09-18.md
"""
# @req: REQ-APP-IO-001

use std.spec.{describe, it, expect, fail}
use app.io.regex_sffi.{
    Regex,
    regex_new, regex_new_checked, regex_destroy,
    regex_is_match, regex_is_match_checked, regex_find, regex_find_all,
    regex_captures, regex_captures_len,
    regex_replace, regex_replace_all, regex_split,
    regex_is_match_quick, regex_is_match_quick_checked, regex_find_quick,
    regex_replace_quick, regex_replace_all_quick, regex_split_quick,
    regex_test, regex_match, regex_extract,
    regex_email, regex_url, regex_ipv4, regex_phone_us, regex_hex_color,
    is_valid_email, is_valid_url, is_valid_ipv4,
}
use app.io.regex_ffi.{regex_new as legacy_regex_new, regex_is_match as legacy_regex_is_match, is_valid_ipv4 as legacy_is_valid_ipv4}

describe "regex safe SFFI surface":
    describe "pattern compilation":
        it "compiles a valid pattern and preserves it on the handle":
            val re: Regex = regex_new(r"\d+")
            expect(re.is_valid).to_be(true)
            expect(re.pattern).to_equal(r"\d+")
            regex_destroy(re)

        it "manufactures an invalid handle for a bad pattern without crashing":
            val re = regex_new(r"[invalid")
            expect(re.is_valid).to_be(false)
            regex_destroy(re)

        it "checked compile returns the regex for a valid pattern":
            match regex_new_checked(r"\d+"):
                case Ok(re):
                    expect(re.is_valid).to_be(true)
                    regex_destroy(re)
                case Err(msg):
                    fail("checked compile rejected a valid pattern: {msg}")

        it "checked compile reports the provider rejection for a bad pattern":
            expect(regex_new_checked(r"[invalid").is_err()).to_equal(true)

    describe "matching":
        it "matches digits in text and reports no match":
            val re = regex_new(r"\d+")
            expect(regex_is_match(re, "test 123")).to_be(true)
            expect(regex_is_match(re, "no digits here")).to_be(false)
            regex_destroy(re)

        it "checked match separates match, no-match, and invalid handle":
            val re = regex_new(r"\d+")
            match regex_is_match_checked(re, "test 123"):
                case Ok(m): expect(m).to_be(true)
                case Err(msg): fail("checked match failed on valid handle: {msg}")
            match regex_is_match_checked(re, "no digits here"):
                case Ok(m): expect(m).to_be(false)
                case Err(msg): fail("checked match failed on valid handle: {msg}")
            regex_destroy(re)
            val invalid = regex_new(r"[invalid")
            expect(regex_is_match_checked(invalid, "anything").is_err()).to_equal(true)
            regex_destroy(invalid)

    describe "find and find_all":
        it "finds the first match and empty string when absent":
            val re = regex_new(r"\d+")
            expect(regex_find(re, "abc 123 def 456")).to_equal("123")
            expect(regex_find(re, "no digits")).to_equal("")
            regex_destroy(re)

        it "finds all matches in order":
            val re = regex_new(r"\d+")
            val matches = regex_find_all(re, "12 abc 34 def 56")
            expect(matches.len()).to_equal(3)
            expect(matches[0]).to_equal("12")
            expect(matches[1]).to_equal("34")
            expect(matches[2]).to_equal("56")
            regex_destroy(re)

    describe "capture groups":
        it "captures groups from the first match with the full match at index 0":
            val re = regex_new(r"(\d+)-(\d+)")
            val groups = regex_captures(re, "test 12-34 end")
            expect(groups.len()).to_equal(3)
            expect(groups[0]).to_equal("12-34")
            expect(groups[1]).to_equal("12")
            expect(groups[2]).to_equal("34")
            expect(regex_captures_len(re, "test 12-34 end")).to_equal(groups.len())
            regex_destroy(re)

        it "returns empty captures and zero count when there is no match":
            val re = regex_new(r"(\d+)-(\d+)")
            expect(regex_captures(re, "no match here").len()).to_equal(0)
            expect(regex_captures_len(re, "no match here")).to_equal(0)
            regex_destroy(re)

    describe "replace operations":
        it "replaces the first match only":
            val re = regex_new(r"\d+")
            expect(regex_replace(re, "abc 123 def 456", "NUM")).to_equal("abc NUM def 456")
            regex_destroy(re)

        it "replaces all matches":
            val re = regex_new(r"\d+")
            expect(regex_replace_all(re, "abc 123 def 456", "NUM")).to_equal("abc NUM def NUM")
            regex_destroy(re)

        it "pass text through unchanged when there is no match":
            val re = regex_new(r"\d+")
            expect(regex_replace(re, "no digits", "NUM")).to_equal("no digits")
            regex_destroy(re)

    describe "split operations":
        it "splits on whitespace runs":
            val re = regex_new(r"\s+")
            val parts = regex_split(re, "hello  world   test")
            expect(parts.len()).to_equal(3)
            expect(parts[0]).to_equal("hello")
            expect(parts[1]).to_equal("world")
            expect(parts[2]).to_equal("test")
            regex_destroy(re)

        it "splits on digit runs":
            val re = regex_new(r"\d+")
            val parts = regex_split(re, "abc123def456ghi")
            expect(parts.len()).to_equal(3)
            expect(parts[0]).to_equal("abc")
            expect(parts[1]).to_equal("def")
            expect(parts[2]).to_equal("ghi")
            regex_destroy(re)

    describe "quick functions without compilation":
        it "quick match works for match and no-match":
            expect(regex_is_match_quick(r"\d+", "test 123")).to_be(true)
            expect(regex_is_match_quick(r"\d+", "no digits")).to_be(false)

        it "checked quick match separates match from no-match":
            match regex_is_match_quick_checked(r"\d+", "test 123"):
                case Ok(m): expect(m).to_be(true)
                case Err(msg): fail("checked quick match failed: {msg}")
            match regex_is_match_quick_checked(r"\d+", "no digits"):
                case Ok(m): expect(m).to_be(false)
                case Err(msg): fail("checked quick match failed: {msg}")

        it "quick find, replace, and split work":
            expect(regex_find_quick(r"\d+", "abc 123 def")).to_equal("123")
            expect(regex_replace_quick(r"\d+", "abc 123 def", "NUM")).to_equal("abc NUM def")
            expect(regex_replace_all_quick(r"\d+", "abc 123 def 456", "NUM")).to_equal("abc NUM def NUM")
            val parts = regex_split_quick(r"\s+", "hello world test")
            expect(parts.len()).to_equal(3)
            expect(parts[0]).to_equal("hello")

        it "handles an invalid pattern gracefully in quick match":
            expect(regex_is_match_quick(r"[invalid", "test")).to_be(false)

    describe "helper aliases":
        it "regex_test and regex_match alias the quick operations":
            expect(regex_test(r"\d+", "test 123")).to_be(true)
            expect(regex_match(r"\d+", "abc 123 def")).to_equal("123")

        it "regex_extract wraps the first quick find result":
            # Owner semantics (pinned): regex_extract is a single-element
            # array around regex_find_quick, not a find_all variant.
            val matches = regex_extract(r"\d+", "a1b22c333")
            expect(matches.len()).to_equal(1)
            expect(matches[0]).to_equal("1")

    describe "common pattern compilers":
        it "email, url, ipv4, phone, and hex color patterns compile and match":
            expect(regex_is_match(regex_email(), "user@example.com")).to_be(true)
            expect(regex_is_match(regex_url(), "https://example.com/x")).to_be(true)
            expect(regex_is_match(regex_ipv4(), "192.168.1.1")).to_be(true)
            expect(regex_is_match(regex_phone_us(), "123-456-7890")).to_be(true)
            expect(regex_is_match(regex_hex_color(), "#FF5733")).to_be(true)

    describe "validation helpers":
        it "validates email addresses":
            expect(is_valid_email("test@example.com")).to_be(true)
            expect(is_valid_email("user.name+tag@domain.co.uk")).to_be(true)
            expect(is_valid_email("not-an-email")).to_be(false)
            expect(is_valid_email("missing@domain")).to_be(false)

        it "validates URLs":
            expect(is_valid_url("https://example.com")).to_be(true)
            expect(is_valid_url("http://test.org/path")).to_be(true)
            expect(is_valid_url("not a url")).to_be(false)
            expect(is_valid_url("ftp://wrong-protocol")).to_be(false)

        it "validates IPv4 addresses with the pinned regex-level semantics":
            expect(is_valid_ipv4("192.168.1.1")).to_be(true)
            expect(is_valid_ipv4("10.0.0.1")).to_be(true)
            expect(is_valid_ipv4("256.1.1.1")).to_be(true)
            expect(is_valid_ipv4("not.an.ip")).to_be(false)

    describe "complex patterns":
        it "matches word boundaries":
            val re = regex_new(r"\btest\b")
            expect(regex_is_match(re, "test case")).to_be(true)
            expect(regex_is_match(re, "testing")).to_be(false)
            regex_destroy(re)

        it "matches optional groups and alternation":
            val dashed = regex_new(r"\d{3}-?\d{4}")
            expect(regex_is_match(dashed, "123-4567")).to_be(true)
            expect(regex_is_match(dashed, "1234567")).to_be(true)
            regex_destroy(dashed)
            val animals = regex_new(r"cat|dog")
            expect(regex_is_match(animals, "I have a cat")).to_be(true)
            expect(regex_is_match(animals, "I have a dog")).to_be(true)
            expect(regex_is_match(animals, "I have a bird")).to_be(false)
            regex_destroy(animals)

describe "legacy regex_ffi path stays safe":
    it "serves the same surface without unsafe blocks":
        val re = legacy_regex_new("[0-9]+")
        expect(re.is_valid).to_be(true)
        expect(legacy_regex_is_match(re, "x42y")).to_be(true)
        expect(legacy_regex_is_match(re, "letters")).to_be(false)
        expect(legacy_is_valid_ipv4("192.0.2.7")).to_be(true)
        expect(legacy_is_valid_ipv4("not-an-ip")).to_be(false)
