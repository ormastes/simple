use std.spec
use app.io.editor_temp_file.{editor_temp_create, editor_temp_read, editor_temp_cleanup}
use app.io.mod.{file_create_exclusive, file_exists}

describe "editor temp file lifecycle":
    it "creates distinct exclusive files, reads content, and cleans both":
        val first = editor_temp_create("spec", "txt", "first")
        val second = editor_temp_create("spec", "txt", "second")
        expect(first.ok).to_equal(true)
        expect(second.ok).to_equal(true)
        val a = first.unwrap()
        val b = second.unwrap()
        expect(a.path == b.path).to_equal(false)
        expect(file_create_exclusive(a.path, "replace")).to_equal(false)
        expect(editor_temp_read(a).unwrap()).to_equal("first")
        expect(editor_temp_read(b).unwrap()).to_equal("second")
        expect(editor_temp_cleanup(a)).to_equal(true)
        expect(editor_temp_cleanup(b)).to_equal(true)
        expect(file_exists(a.path)).to_equal(false)
        expect(file_exists(b.path)).to_equal(false)

    it "rejects path-bearing labels before touching the filesystem":
        expect(editor_temp_create("../escape", "txt", "x").ok).to_equal(false)
        expect(editor_temp_create("spec", "../txt", "x").ok).to_equal(false)
