extern fn rt_file_read_text(path: text) -> text?

describe "jit sffi numeric guard":
    it "guards integer execution output parsing":
        val source = rt_file_read_text("src/app/io/jit_sffi.spl") ?? ""

        expect(source).to_contain("out.to_int() ?? -1")
        expect(source.contains("out.to_int()\n")).to_equal(false)

    it "uses canonical runtime ABI names":
        val jit_source = rt_file_read_text("src/app/io/jit_sffi.spl") ?? ""
        val io_source = rt_file_read_text("src/app/io/mod.spl") ?? ""
        val cuda_source = rt_file_read_text("src/lib/nogc_sync_mut/io/cuda_sffi.spl") ?? ""

        expect(jit_source).to_contain("extern fn rt_file_write_text(path: text, content: text) -> bool")
        expect(jit_source).to_contain("rt_file_write_text(fpath, content)")
        expect(jit_source.contains("rt_file_write(")).to_equal(false)
        expect(io_source).to_contain("extern fn rt_volatile_read_u64(addr: i64) -> i64")
        expect(io_source.contains("rt_read_volatile_i64")).to_equal(false)
        expect(io_source).to_contain("extern fn rt_volatile_write_u64(addr: i64, value: i64)")
        expect(io_source.contains("rt_write_volatile_i64")).to_equal(false)
        expect(cuda_source).to_contain("extern fn rt_cuda_mem_alloc(size: i64) -> i64")
        expect(cuda_source).to_contain("extern fn rt_cuda_mem_free(ptr: i64) -> i64")
        expect(cuda_source).to_contain("rt_cuda_mem_free(mem.ptr) == 0")
        expect(cuda_source.contains("rt_cuda_malloc")).to_equal(false)
        expect(cuda_source.contains("rt_cuda_free")).to_equal(false)

        val closure_source = (rt_file_read_text("src/app/io/jit_ffi.spl") ?? "") +
            (rt_file_read_text("src/app/io/feature_registry.spl") ?? "") +
            (rt_file_read_text("src/os/ml/model.spl") ?? "") +
            (rt_file_read_text("src/os/ml/gpu_tensor.spl") ?? "") +
            (rt_file_read_text("src/lib/nogc_async_mut/engine/physics/backend_gpu/gpu_solver.spl") ?? "") +
            (rt_file_read_text("src/lib/nogc_sync_mut/fuzz.spl") ?? "")
        expect(closure_source.contains("extern fn rt_file_write(")).to_equal(false)
        expect(closure_source.contains("rt_cuda_malloc")).to_equal(false)
        expect(closure_source.contains("rt_cuda_free")).to_equal(false)
