# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# bug: native_build_tool_closures_hir_mir_gaps_2026-08-31 (defect 1, lint closure)

# @cover src/app/io/cli_lint_commands.spl
"""
# Lint closure imports must name public symbols

The native lint-closure build failed in HIR lowering with
`unresolved name: read_file at src/app/io/cli_lint_commands.spl:18:8` — the
import site. A plain `fn` is file-private by default, so importing it from
another module only works under the permissive interpreter. The renamed
readers `fmt_read_file` and `lint_read_file` are imported by
`cli_lint_commands.spl` (and by sibling `_LintMain` files) and must be `pub`.
"""

use std.spec.step

describe "lint closure: imported file readers are public":
    extern fn rt_file_read_text(path: text) -> text?

    fn source_of(path: text) -> text:
        rt_file_read_text(path) ?? ""

    it "fmt_read_file is declared pub in the formatter":
        val s = source_of("src/compiler/90.tools/formatter/main.spl")
        expect(s.contains("fn fmt_read_file(")).to_equal(true)
        expect(s.contains("pub fn fmt_read_file(")).to_equal(true)

    it "lint_read_file is declared pub in the lint model":
        val s = source_of("src/compiler/90.tools/lint/_LintMain/config_and_model.spl")
        expect(s.contains("fn lint_read_file(")).to_equal(true)
        expect(s.contains("pub fn lint_read_file(")).to_equal(true)

    it "cli_lint_commands still imports both readers":
        val s = source_of("src/app/io/cli_lint_commands.spl")
        expect(s.contains("fmt_read_file")).to_equal(true)
        expect(s.contains("lint_read_file")).to_equal(true)
