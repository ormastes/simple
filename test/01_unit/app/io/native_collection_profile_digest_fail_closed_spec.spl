# Collection-profile digest admission fails closed on an unhashable (nil) file.
# @req REQ-SSPEC-UNIT
use std.spec.step
use std.spec.{describe, it, expect}
use app.io._CliCompile.native_collection_profile.{native_collection_digest_matches}
use std.io_runtime.{file_hash_sha256}

describe "collection profile digest comparison fails closed":
    it "rejects a nil observed digest (unhashed entry) against any expected digest":
        step("nil observed")
        val observed: text? = nil
        expect(native_collection_digest_matches(observed, "abc")).to_equal(false)
        expect(native_collection_digest_matches(observed, "")).to_equal(false)

    it "rejects an empty expected digest even when observed is present":
        step("empty expected")
        val observed: text? = ""
        expect(native_collection_digest_matches(observed, "")).to_equal(false)

    it "accepts only equal present digests":
        step("equal and differing")
        val observed: text? = "abc"
        expect(native_collection_digest_matches(observed, "abc")).to_equal(true)
        expect(native_collection_digest_matches(observed, "abd")).to_equal(false)

    it "file_hash_sha256 of a missing path is nil and never admitted":
        step("missing path")
        val h = file_hash_sha256("/definitely/not/a/real/path/sha")
        expect(h == nil).to_equal(true)
        expect(native_collection_digest_matches(h, "")).to_equal(false)
        expect(native_collection_digest_matches(h, "abc")).to_equal(false)
