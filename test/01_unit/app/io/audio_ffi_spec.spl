# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "audio FFI compatibility facade":
    # @manual scenario evidence
    it "keeps the app SFFI path as a safe facade over the no-GC owner":
        # @req REQ-SSPEC-APP
        step("keeps the app SFFI path as a safe facade over the no-GC owner")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = file_read("src/app/io/audio_sffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source).to_contain("std.nogc_sync_mut.io.audio_sffi.{{")
        expect(source.contains("rt_audio_")).to_equal(false)

    it "contains no duplicate foreign declarations":
        # @req REQ-SSPEC-APP
        step("contains no duplicate foreign declarations")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "exports the canonical safe audio surface explicitly":
        # @req REQ-SSPEC-APP
        step("exports the canonical safe audio surface explicitly")
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source).to_contain("export use app.io.audio_sffi.{{")
        expect(source.contains("audio_init")).to_equal(true)
        expect(source.contains("audio_capture_stop")).to_equal(true)
        expect(source.contains("audio_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req REQ-SSPEC-APP
        step("does not re-export raw runtime symbols")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source.contains("rt_audio_")).to_equal(false)
