# @req: REQ-APP-IO-001

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "audio FFI compatibility facade":
    it "keeps the app SFFI path as a safe facade over the no-GC owner":
        # @req: REQ-APP-IO-001
        step("Verify: keeps the app SFFI path as a safe facade over the no-GC owner")
        val source = file_read("src/app/io/audio_sffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source).to_contain("std.nogc_sync_mut.io.audio_sffi.{{")
        expect(source.contains("rt_audio_")).to_equal(false)

    it "contains no duplicate foreign declarations":
        # @req: REQ-APP-IO-001
        step("Verify: contains no duplicate foreign declarations")
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "exports the canonical safe audio surface explicitly":
        # @req: REQ-APP-IO-001
        step("Verify: exports the canonical safe audio surface explicitly")
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source).to_contain("export use app.io.audio_sffi.{{")
        expect(source.contains("audio_init")).to_equal(true)
        expect(source.contains("audio_capture_stop")).to_equal(true)
        expect(source.contains("audio_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req: REQ-APP-IO-001
        step("Verify: does not re-export raw runtime symbols")
        val source = file_read("src/app/io/audio_ffi.spl")
        expect(source.contains("rt_audio_")).to_equal(false)
