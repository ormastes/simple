# #2981 workaround grammar: the optional payload is bound before testing it.
use std.spec.*

# @workaround bug=native_enum_nil_payload_pattern_2026_10_11 reason=restore text provenance after Result optional binding
fn stdout_chunk_text(value: text) -> text:
    value

fn append_available(result: Result<text?, text>, output: text) -> text:
    match result:
        Ok(maybe_chunk):
            if val available_chunk = maybe_chunk:
                val chunk = stdout_chunk_text(available_chunk)
                return output + chunk
            return output
        Err(problem): return "error:" + problem

describe "Result optional payload binding workaround":
    it "distinguishes data, empty data, and no available data":
        val data: Result<text?, text> = Ok(Some("b"))
        val empty: Result<text?, text> = Ok(Some(""))
        val waiting: Result<text?, text> = Ok(nil)
        expect(append_available(data, "a")).to_equal("ab")
        expect(append_available(empty, "a")).to_equal("a")
        expect(append_available(waiting, "a")).to_equal("a")

    it "retains the error branch":
        val failed: Result<text?, text> = Err("read failed")
        expect(append_available(failed, "a")).to_equal("error:read failed")
