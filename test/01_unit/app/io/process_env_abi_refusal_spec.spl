use std.spec.{describe, it, expect, step}
use app.io.process_env_ops.{process_spawn_async_env, process_is_alive}

describe "hosted process environment ABI refusal":
    it "refuses a requested environment before creating a child":
        step("request an environment override through the legacy app facade")
        val environment: {text: text} = {"SIMPLE_SOSIX_ENV_SENTINEL": "expected"}
        val pid = process_spawn_async_env("sh", ["-c", "exit 0"], environment)
        expect(pid).to_equal(-95)
        expect(process_is_alive(pid)).to_equal(false)
