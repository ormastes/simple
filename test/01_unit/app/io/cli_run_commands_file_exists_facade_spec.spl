"""
## Purpose and audience
Purpose: Keep CLI run-command file probes behind the existing file-operations facade.
Audience: compiler and CLI maintainers changing binary or test-file discovery.
## Operator workflow
Run this spec with the test runner; a failure identifies direct runtime access or
a facade contract change.
## Compatibility and limitations
This source contract pins the one-call boolean facade used by every supported
host; provider behavior remains covered by the runtime file-I/O tests.
# @manual: primary
REQ-APP-CLI-001
doc/01_research/local/REQ-APP-CLI-001.md
doc/03_plan/sys_test/REQ-APP-CLI-001.md
doc/04_architecture/REQ-APP-CLI-001.md
doc/05_design/REQ-APP-CLI-001.md
"""
# @req: REQ-APP-CLI-001

use std.io_runtime.{read_file_text}
use std.spec.step

describe "CLI run-command file-existence facade":
    it "keeps the eleven migrated probes with the existing facade probe":
        # @req: REQ-APP-CLI-001
        step("Verify: eleven migrated and one existing CLI probe use the facade")
        val source = read_file_text("src/app/io/_CliCommands/run_commands.spl")

        expect(source).to_contain("use std.nogc_sync_mut.io.file_ops.{file_exists, file_delete}")
        expect(source.contains("extern fn rt_file_exists")).to_equal(false)
        expect(source.contains("rt_file_exists(")).to_equal(false)
        expect(source.split("file_exists(").len()).to_equal(13)

    it "pins the facade to one unchanged runtime predicate call":
        # @req: REQ-APP-CLI-001
        step("Verify: file-existence facade preserves the raw boolean contract")
        val source = read_file_text("src/lib/nogc_sync_mut/io/file_ops.spl")

        expect(source).to_contain("fn file_exists(path: text) -> bool:\n    rt_file_exists(path)\n\nfn file_is_regular_no_follow")
