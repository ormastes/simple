# @req: REQ-APP-IO-001

"""
# CLI Run Output Owner Contract

Raw stdout and stderr stay behind the CLI I/O owner module in Stage4.
"""

extern fn rt_file_read_text(path: text) -> text?

use std.spec.step

describe "CLI run output ownership":
    it "routes raw child stdout through the cli_ops owner":
        # @req: REQ-APP-IO-001
        step("Verify: routes raw child stdout through the cli_ops owner")
        val source = rt_file_read_text("src/app/io/_CliCommands/run_commands.spl") ?? ""
        expect(source).to_contain("_cli_print_raw(result.0)")
        expect(source.contains("            print_raw(result.0)")).to_equal(false)
        expect(source).to_contain("_cli_eprint(result.1.trim())")

    it "owns adjacent stdout and stderr adapters in cli_ops":
        # @req: REQ-APP-IO-001
        step("Verify: owns adjacent stdout and stderr adapters in cli_ops")
        val source = rt_file_read_text("src/app/io/cli_ops.spl") ?? ""
        expect(source).to_contain("extern fn print_raw(value: text) -> i64")
        expect(source).to_contain("fn _cli_print_raw(msg: text):")
        expect(source).to_contain("fn _cli_eprint(msg: text):")
