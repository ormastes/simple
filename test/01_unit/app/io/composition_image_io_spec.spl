use std.spec.{describe, it, expect}
use app.io.composition_image_io.{read_composition_image_file_v1}
use app.io.mod.{file_delete, file_write_bytes}

val COMPOSITION_IMAGE_IO_FIXTURE = "/tmp/simple-composition-image-io-spec.sci"

describe "narrow composition image I/O owner":
    it "distinguishes a missing image from exact immutable bytes":
        file_delete(COMPOSITION_IMAGE_IO_FIXTURE)
        expect(read_composition_image_file_v1(COMPOSITION_IMAGE_IO_FIXTURE).ok).to_be(false)
        expect(file_write_bytes(COMPOSITION_IMAGE_IO_FIXTURE, [1u8, 2u8, 255u8])).to_be(true)
        val loaded = read_composition_image_file_v1(COMPOSITION_IMAGE_IO_FIXTURE)
        expect(loaded.ok).to_be(true)
        expect(loaded.bytes).to_equal([1u8, 2u8, 255u8])
        file_delete(COMPOSITION_IMAGE_IO_FIXTURE)
