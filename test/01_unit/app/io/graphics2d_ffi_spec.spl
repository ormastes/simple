# @req: REQ-APP-IO-001

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "graphics2d FFI compatibility facade":
    it "contains no duplicate foreign declarations":
        # @req: REQ-APP-IO-001
        step("Verify: contains no duplicate foreign declarations")
        val source = file_read("src/app/io/graphics2d_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "exports the canonical safe graphics surface explicitly":
        # @req: REQ-APP-IO-001
        step("Verify: exports the canonical safe graphics surface explicitly")
        val source = file_read("src/app/io/graphics2d_ffi.spl")
        expect(source).to_contain("export use app.io.graphics2d_sffi.{{")
        expect(source.contains("graphics_path_builder_new")).to_equal(true)
        expect(source.contains("graphics_path_transform")).to_equal(true)
        expect(source.contains("graphics2d_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req: REQ-APP-IO-001
        step("Verify: does not re-export raw runtime symbols")
        val source = file_read("src/app/io/graphics2d_ffi.spl")
        expect(source.contains("rt_lyon_")).to_equal(false)
