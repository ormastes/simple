# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "window FFI compatibility facade":
    # @manual scenario evidence
    it "contains no duplicate foreign declarations":
        # @req REQ-SSPEC-APP
        step("contains no duplicate foreign declarations")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "delegates to the canonical SFFI owner with explicit exports":
        # @req REQ-SSPEC-APP
        step("delegates to the canonical SFFI owner with explicit exports")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source).to_contain("export use app.io.window_sffi.{{")
        expect(source.contains("window_create_event_loop")).to_equal(true)
        expect(source.contains("window_clipboard_set")).to_equal(true)
        expect(source.contains("window_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req REQ-SSPEC-APP
        step("does not re-export raw runtime symbols")
        val source = file_read("src/app/io/window_ffi.spl")
        expect(source.contains("rt_sdl2_")).to_equal(false)
        expect(source.contains("rt_winit_")).to_equal(false)
