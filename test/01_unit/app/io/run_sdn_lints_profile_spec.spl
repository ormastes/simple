# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @cover src/app/io/_CliCommands/handler_commands.spl
# WP-4: `bin/simple run`'s simple.sdn profile tier reads the CANONICAL
# `lints:` / `  profile: <tier>` form.
#
# Before WP-4 this scanner looked for the TOML-ish `[lints]` / `profile = "x"`
# shape, which no manifest in the tree ever carried, so it always returned ""
# and project-level profile pinning for `run` did not work at all (aerospace
# hardening plan premise 4).
#
# Both fixtures are asserted. A with-key-only assertion would be fail-open: a
# scanner that matches nothing also returns "" for the without-key case, so the
# two results must be shown to DIFFER.
#
# Deliberately does NOT drive any frontend parsing in this session -- see
# doc/08_tracking/bug/interp_lint_main_then_frontend_dict_to_int_2026-07-28.md.

use std.spec.step

use app.io.cli_commands.{run_read_sdn_lints_profile}


describe "run's simple.sdn lints.profile tier (WP-4)":
    # @manual scenario evidence
    it "resolves lints.profile to critical when the key is present":
        # @req REQ-SSPEC-UNIT
        step("resolves lints.profile to critical when the key is present")
        expect(run_read_sdn_lints_profile("test/fixtures/project_sdn_profile/with_profile/simple.sdn")).to_equal("critical")

    it "resolves to \"\" when the manifest has no lints section":
        # @req REQ-SSPEC-UNIT
        step("resolves to \")
        expect(run_read_sdn_lints_profile("test/fixtures/project_sdn_profile/without_profile/simple.sdn")).to_equal("")

    it "no longer accepts the removed TOML-ish [lints] shape":
        # @req REQ-SSPEC-UNIT
        step("no longer accepts the removed TOML-ish [lints] shape")
        expect(run_read_sdn_lints_profile("test/fixtures/project_sdn_profile/legacy_toml/simple.sdn")).to_equal("")

    it "returns \"\" for a manifest that does not exist":
        # @req REQ-SSPEC-UNIT
        step("returns \")
        expect(run_read_sdn_lints_profile("test/fixtures/project_sdn_profile/no_such_dir/simple.sdn")).to_equal("")
