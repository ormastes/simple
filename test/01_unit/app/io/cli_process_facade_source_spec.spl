"""
## Purpose and audience
Pins the source-level contract that every CLI process call routes through the
app-owned exact-semantics facades in `src/app/io/process_ops.spl` — never
directly through `std.io_runtime` or a raw `rt_*` extern — for the engineers
who own `src/app/io/`. This is a source-contract spec: the shipped source
text is the artifact under test, and every assertion is mediated through a
genuinely named contract local so the pinned property reads as a contract,
not a grep.
## Operator workflow
bin/simple test test/01_unit/app/io/cli_process_facade_source_spec.spl
## Compatibility and limitations
Executes no processes; a rename of a facade function must update the pins
here in the same change that renames it. Body-slicing pins depend on the
exact function ordering inside `process_ops.spl`.
## Verification guidance and troubleshooting
A failure names the drifted facade contract; rerun
bin/simple test test/01_unit/app/io/cli_process_facade_source_spec.spl after
the wiring change lands and update the oracle counts only together with the
source that justifies them.
"""
# Lifecycle: doc/01_research/local/sffi_v2_hardening.md ;
# doc/03_plan/agent_tasks/sosix_posix_io_compatibility_audit_2026-08-11.md ;
# doc/04_architecture/native_module_cache_invalidation.md ;
# doc/05_design/lazy_system_path_variables.md
# @manual_section: cli-process-facades

use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read}

fn source_between(source: text, start_marker: text, end_marker: text) -> text:
    val start = source.index_of(start_marker) ?? -1
    val finish = source.index_of(end_marker) ?? -1
    if start < 0 or finish <= start:
        return ""
    source.substring(start, finish)

describe "CLI process calls use app-owned exact-semantics facades":
    it "keeps cli_ops command lookup on the direct process contract":
        # @req REQ-APP-IO-FACADE-001
        # @capture(statistics): cli_ops facade import and call-site census
        step("Read the shipped cli_ops source and census its process facades")
        val source = file_read("src/app/io/cli_ops.spl")
        val imports_direct_contract = source.contains(
            "use app.io.process_ops.{process_run_direct, process_run_inherit}")
        expect(imports_direct_contract).to_equal(true)  # oracle: the facade import line is the wiring contract this spec pins
        val direct_call_sites = source.split("process_run_direct(").len() - 1
        expect(direct_call_sites).to_equal(5)  # oracle: cli_ops reaches process_run_direct at exactly five call sites
        val inherits_parent_streams = source.contains(
            "process_run_direct(resolved_cmd, args)")
        expect(inherits_parent_streams).to_equal(true)  # oracle: command lookup passes the resolved command and args unchanged
        val bans_io_runtime_import = source.contains("use std.io_runtime.{process_run}")
        expect(bans_io_runtime_import).to_equal(false)  # oracle: the io_runtime process import must stay out of cli_ops
        val bans_runtime_externs = source.contains("rt_process_run")
        expect(bans_runtime_externs).to_equal(false)  # oracle: no raw rt_process_run extern call may bypass the facade

    it "routes arbitrary-PID status through the distinct existence facade":
        # @req REQ-APP-IO-FACADE-002
        # @capture(statistics): handler_commands existence-facade census
        step("Read the command handler source and census its existence facade")
        val source = file_read(
            "src/app/io/_CliCommands/handler_commands.spl")
        val imports_existence_facade = source.contains(
            "use app.io.process_ops.{process_exists, process_kill_unchecked}")
        expect(imports_existence_facade).to_equal(true)  # oracle: the existence facade import is the wiring contract for arbitrary PIDs
        val existence_call_sites = source.split("process_exists(pid)").len() - 1
        expect(existence_call_sites).to_equal(2)  # oracle: the handler probes liveness at exactly two call sites
        val bans_extern_declaration = source.contains("extern fn rt_process_exists")
        expect(bans_extern_declaration).to_equal(false)  # oracle: no local extern declaration may shadow the facade
        val bans_direct_runtime_call = source.contains("rt_process_exists(pid)")
        expect(bans_direct_runtime_call).to_equal(false)  # oracle: no raw rt_process_exists call may bypass the facade

    it "keeps the facade contracts distinct and non-recursive":
        # @req REQ-APP-IO-FACADE-003
        # @capture(statistics): process_ops body slices per facade contract
        step("Slice both facade bodies out of process_ops and census each")
        val source = file_read("src/app/io/process_ops.spl")
        val direct_body = source_between(
            source,
            "fn process_run_direct(cmd: text, args: [text])",
            "fn process_run_bounded(cmd: text, args: [text")
        val exists_body = source_between(
            source,
            "fn process_exists(pid: i64)",
            "fn process_kill(pid: i64)")

        val direct_signature_present = direct_body.contains(
            "fn process_run_direct(cmd: text, args: [text]) -> (text, text, i64):")
        expect(direct_signature_present).to_equal(true)  # oracle: the direct facade owns the exact three-stream signature
        val raw_call_count = direct_body.split("_process_run_raw(cmd, args)").len() - 1
        expect(raw_call_count).to_equal(1)  # oracle: the direct facade reaches the raw runner exactly once
        val bans_slot_plumbing = direct_body.contains("proc_slot_")
        expect(bans_slot_plumbing).to_equal(false)  # oracle: the direct facade must not touch bounded-slot plumbing
        val direct_recursion_count = direct_body.split("process_run_direct(").len() - 1
        expect(direct_recursion_count).to_equal(1)  # oracle: the only occurrence is the signature, so the facade is non-recursive

        val exists_signature_present = exists_body.contains("fn process_exists(pid: i64) -> bool:")
        expect(exists_signature_present).to_equal(true)  # oracle: the existence facade owns the boolean signature
        val guards_nonpositive_pid = exists_body.contains("if pid <= 0:")
        expect(guards_nonpositive_pid).to_equal(true)  # oracle: non-positive PIDs are rejected before any probe
        val exists_raw_call_count = exists_body.split("_process_exists_raw(pid)").len() - 1
        expect(exists_raw_call_count).to_equal(1)  # oracle: the existence facade reaches the raw prober exactly once
        val exists_recursion_count = exists_body.split("process_exists(pid").len() - 1
        expect(exists_recursion_count).to_equal(1)  # oracle: the only occurrence is the signature, so the facade is non-recursive
        val extern_declaration_count = source.split("extern fn rt_process_exists(").len() - 1
        expect(extern_declaration_count).to_equal(1)  # oracle: the raw extern is declared exactly once, inside process_ops
