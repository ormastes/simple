# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use std.spec.*
use std.io_runtime.{file_read}

use std.spec.step

describe "Rapier2D FFI compatibility facade":
    # @manual scenario evidence
    it "contains no duplicate foreign declarations":
        # @req REQ-SSPEC-APP
        step("contains no duplicate foreign declarations")
        val source = file_read("src/app/io/rapier2d_ffi.spl")
        expect(source.contains("extern fn ")).to_equal(false)
        expect(source.contains("@extern(")).to_equal(false)

    it "exports the canonical safe physics surface explicitly":
        # @req REQ-SSPEC-APP
        step("exports the canonical safe physics surface explicitly")
        val source = file_read("src/app/io/rapier2d_ffi.spl")
        expect(source).to_contain("export use app.io.rapier2d_sffi.{{")
        expect(source.contains("physics_create_world")).to_equal(true)
        expect(source.contains("physics_joint_set_motor")).to_equal(true)
        expect(source.contains("rapier2d_sffi.*")).to_equal(false)

    it "does not re-export raw runtime symbols":
        # @req REQ-SSPEC-APP
        step("does not re-export raw runtime symbols")
        val source = file_read("src/app/io/rapier2d_ffi.spl")
        expect(source.contains("rt_rapier2d_")).to_equal(false)
