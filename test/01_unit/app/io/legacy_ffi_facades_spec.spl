"""
## Purpose and audience
Purpose: Verify legacy FFI compatibility facades.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
Troubleshooting: a red scenario here means the pinned contract changed —
check verification guidance in the linked design docs before editing oracles.
# @manual: primary
REQ-APP-IO-001
doc/01_research/local/REQ-APP-IO-001.md
doc/03_plan/sys_test/REQ-APP-IO-001.md
doc/04_architecture/REQ-APP-IO-001.md
doc/05_design/REQ-APP-IO-001.md
"""
# @req: REQ-APP-IO-001

use std.spec.*
use std.io_runtime.{file_read}

fn assert_safe_facade(path: text, owner: text, first_api: text, last_api: text):
    val source = file_read(path)
    expect(source.contains("extern fn ")).to_equal(false)
    expect(source.contains("@extern(")).to_equal(false)
    expect(source).to_contain(owner)
    expect(source.contains(first_api)).to_equal(true)
    expect(source.contains(last_api)).to_equal(true)
    expect(source.contains("_sffi.*")).to_equal(false)
    expect(source.contains("rt_")).to_equal(false)

use std.spec.step

describe "legacy FFI compatibility facades":
    it "routes compression through its canonical safe SFFI surface":
        # @req: REQ-APP-IO-001
        step("Verify: routes compression through its canonical safe SFFI surface")
        assert_safe_facade(
            "src/app/io/compress_ffi.spl",
            "export use app.io.compress_sffi.{{",
            "gzip_compress",
            "decompress_file"
        )

    it "routes FTP through its canonical safe SFFI surface":
        # @req: REQ-APP-IO-001
        step("Verify: routes FTP through its canonical safe SFFI surface")
        assert_safe_facade(
            "src/app/io/ftp_ffi.spl",
            "export use app.io.ftp_sffi.{{",
            "ftp_connect",
            "ftp_is_connected"
        )

    it "routes regex through its canonical safe SFFI surface":
        # @req: REQ-APP-IO-001
        step("Verify: routes regex through its canonical safe SFFI surface")
        assert_safe_facade(
            "src/app/io/regex_ffi.spl",
            "export use app.io.regex_sffi.{{",
            "regex_new",
            "is_valid_ipv4"
        )
