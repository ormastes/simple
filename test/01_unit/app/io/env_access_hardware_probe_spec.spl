# @cover src/app/io/env_access_host.spl 80%
use std.spec
use std.common.env_access.model.*
use app.io.env_access_host.*

fn probe_available() -> bool:
    return true

fn execute_board_identity(arguments: [text], timeout_ms: i64,
                          max_stdout_bytes: i64,
                          max_stderr_bytes: i64) -> EnvAccessRawResult:
    val _ = arguments
    val _ = timeout_ms
    val _ = max_stdout_bytes
    val _ = max_stderr_bytes
    return EnvAccessRawResult(
        status: EnvAccessStatus.Executed,
        exit_code: 0,
        stdout: "schema=board-identity-v1\nboard=fixture",
        stderr: "",
        discarded_bytes: 0,
        elapsed_ms: 1,
        reason: "",
        prerequisite: "",
        owner: "",
        artifact_paths: [],
        resume_command: ""
    )

fn board_probe_identity() -> EnvHardwareProbeIdentity:
    return EnvHardwareProbeIdentity(
        probe_id: "unit-board-identity",
        schema_id: "board-identity-v1",
        max_arguments: 1,
        max_timeout_ms: 100,
        max_stdout_bytes: 128,
        max_stderr_bytes: 64
    )

describe "typed hosted hardware probe registry":
    it "dispatches an admitted bounded adapter without a command string":
        val identity = board_probe_identity()
        val adapter = HostHardwareProbeAdapter(
            identity: identity,
            platform_available_fn: probe_available,
            execute_fn: execute_board_identity
        )
        expect(register_host_hardware_probe(adapter).unwrap()).to_equal(true)
        val instruction = EnvAccessInstruction(
            kind: EnvAccessKind.HardwareProbe,
            resource: identity.probe_id,
            arguments: ["board0"],
            timeout_ms: 100,
            max_stdout_bytes: 128,
            max_stderr_bytes: 64
        )
        val plan = EnvAccessPlan(
            plan_id: "hardware-probe-unit",
            canonical_repo_root: "/workspace/repo",
            instructions: [instruction],
            max_total_bytes: 192,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: [identity]
        )
        val receipts = execute_host_env_access_plan(plan).unwrap()
        expect(receipts.len()).to_equal(1)
        expect(receipts[0].status).to_equal(EnvAccessStatus.Executed)
        expect(receipts[0].stdout_hash.starts_with("sha256:")).to_equal(true)

    it "rejects a probe that is not admitted by the plan schema":
        val instruction = EnvAccessInstruction(
            kind: EnvAccessKind.HardwareProbe,
            resource: "unregistered-probe",
            arguments: [],
            timeout_ms: 100,
            max_stdout_bytes: 64,
            max_stderr_bytes: 64
        )
        val plan = EnvAccessPlan(
            plan_id: "hardware-probe-rejected",
            canonical_repo_root: "/workspace/repo",
            instructions: [instruction],
            max_total_bytes: 128,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: []
        )
        expect(env_access_plan_error(plan)).to_equal("ENV-E-PROBE-NOT-ALLOWED")

    it "returns actionable Unsupported evidence when an admitted adapter is absent":
        val identity = EnvHardwareProbeIdentity(
            probe_id: "unit-absent-probe",
            schema_id: "absent-probe-v1",
            max_arguments: 0,
            max_timeout_ms: 100,
            max_stdout_bytes: 64,
            max_stderr_bytes: 64
        )
        val instruction = EnvAccessInstruction(
            kind: EnvAccessKind.HardwareProbe,
            resource: identity.probe_id,
            arguments: [],
            timeout_ms: 100,
            max_stdout_bytes: 64,
            max_stderr_bytes: 64
        )
        val plan = EnvAccessPlan(
            plan_id: "hardware-probe-absent",
            canonical_repo_root: "/workspace/repo",
            instructions: [instruction],
            max_total_bytes: 128,
            max_processes: 0,
            allowed_tools: [],
            allowed_hardware_probes: [identity]
        )
        val receipt = execute_host_env_access_plan(plan).unwrap()[0]
        expect(receipt.status).to_equal(EnvAccessStatus.Unsupported)
        expect(receipt.reason).to_contain("no typed hardware probe adapter")
        expect(receipt.prerequisite).to_contain("register or enable")
