# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

use app.io.cli_ops.{
    context_generate, context_stats, settlement_main,
    fault_set_stack_overflow_detection, fault_set_max_recursion_depth,
    fault_set_timeout, fault_set_execution_limit,
    get_args, cli_get_args
}
use std.io_runtime.{file_write}

describe "Cli Ops Ext":
    # @manual scenario evidence
    it "reports missing context generation output for absent files":
        # @req REQ-SSPEC-APP
        step("reports missing context generation output for absent files")
        val result = context_generate("path", "target", "format")
        expect(result).to_equal("")

    it "reports missing context stats output for absent files":
        # @req REQ-SSPEC-APP
        step("reports missing context stats output for absent files")
        val result = context_stats("path", "target")
        expect(result).to_equal("")

    it "returns success for settlement main placeholder implementation":
        # @req REQ-SSPEC-APP
        step("returns success for settlement main placeholder implementation")
        val result = settlement_main()
        expect(result).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps fault configuration hooks callable without changing context stats":
        # @req REQ-SSPEC-APP
        step("keeps fault configuration hooks callable without changing context stats")
        fault_set_stack_overflow_detection(true)
        fault_set_stack_overflow_detection(false)
        fault_set_max_recursion_depth(100)
        fault_set_timeout(30)
        fault_set_execution_limit(1000)

        expect(context_stats("path", "target")).to_equal("")

    it "returns argument lists from both public argument accessors":
        # @req REQ-SSPEC-APP
        step("returns argument lists from both public argument accessors")
        val args = get_args()
        val cli_args = cli_get_args()

        expect(args.len()).to_be_greater_than(-1)
        expect(cli_args.len()).to_be_greater_than(-1)

    it "generates a ready context for a real file on disk":
        # @req REQ-SSPEC-APP
        step("context_generate and context_stats on an existing file")
        # (Replaces the old source-text re-export guard: the behavioral
        # contract is that these light helpers answer without pulling the
        # compiler dispatch surface. The structural no-re-export guard now
        # lives with the module's own lint/architecture checks.)
        file_write("/tmp/cli_ops_handler_probe.spl", "fn probe_answer(): 42\n")
        val generated = context_generate("/tmp/cli_ops_handler_probe.spl", "t", "fmt")
        # oracle: an existing file reports status ready, not missing
        expect(generated).to_contain("status: ready")
        expect(generated).to_contain("source: `/tmp/cli_ops_handler_probe.spl`")
        val stats = context_stats("/tmp/cli_ops_handler_probe.spl", "t")
        expect(stats).to_contain("status: ready")

    it "reads process environment through cli_env_get":
        # @req REQ-SSPEC-APP
        step("cli_env_get returns a non-empty PATH from the environment")
        # oracle: PATH is always set in the test environment
        expect(cli_env_get("PATH").len()).to_be_greater_than(0)
