"""One canonical volatile provider with a narrow native-required app facade."""

use std.spec.*
use app.io.volatile_required.{
    volatile_read_u64_required,
    volatile_write_u64_required,
    memory_barrier_required,
}

extern fn rt_file_read_text(path: text) -> text?

describe "volatile provider consolidation":
    it "removes the duplicate app provider":
        val duplicate = rt_file_read_text("src/app/io/volatile_ops.spl") ?? ""
        expect(duplicate).to_equal("")

    it "keeps all runtime dispatch fallbacks in the canonical provider":
        val source = rt_file_read_text("src/lib/nogc_sync_mut/io/volatile_ops.spl") ?? ""
        expect(source).to_contain("fn rt_volatile_read_u8__fallback")
        expect(source).to_contain("fn rt_volatile_read_u16__fallback")
        expect(source).to_contain("fn rt_volatile_read_u32__fallback")
        expect(source).to_contain("fn rt_volatile_read_u64__fallback")
        expect(source).to_contain("fn rt_volatile_write_u8__fallback")
        expect(source).to_contain("fn rt_volatile_write_u16__fallback")
        expect(source).to_contain("fn rt_volatile_write_u32__fallback")
        expect(source).to_contain("fn rt_volatile_write_u64__fallback")
        expect(source).to_contain("fn rt_memory_barrier__fallback")
        expect(source).to_contain("fn rt_load_barrier__fallback")
        expect(source).to_contain("fn rt_store_barrier__fallback")

    it "routes native-required consumers through the narrow canonical facade":
        val facade = rt_file_read_text("src/app/io/volatile_required.spl") ?? ""
        val gpu = rt_file_read_text("src/app/simpleos_gpu_host/daemon_runner.spl") ?? ""
        val audio = rt_file_read_text("src/app/simpleos_audio_host/daemon_runner.spl") ?? ""
        expect(facade).to_contain("use std.nogc_sync_mut.io.volatile_ops")
        expect(facade.contains("extern fn")).to_be(false)
        expect(facade.contains("__fallback")).to_be(false)
        expect(gpu).to_contain("use app.io.volatile_required")
        expect(audio).to_contain("use app.io.volatile_required")
        expect(gpu.contains("use app.io.volatile_ops")).to_be(false)
        expect(audio.contains("use app.io.volatile_ops")).to_be(false)
