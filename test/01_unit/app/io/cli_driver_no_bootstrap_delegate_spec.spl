use std.spec.{describe, it, expect}
use std.io_runtime.{env_get, env_set}
use app.io.cli_ops.{_cli_driver_binary}

describe "CLI bootstrap delegation policy":

    it "keeps an admitted self-hosted process in-process on exact opt-in":
        val key = "SIMPLE_NO_BOOTSTRAP_DELEGATE"
        val driver_key = "SIMPLE_BOOTSTRAP_DRIVER"
        val sentinel = "/tmp/simple-bootstrap-driver-sentinel"
        val previous = env_get(key)
        val previous_driver = env_get(driver_key)
        expect(env_set(driver_key, sentinel)).to_equal(true)
        expect(env_set(key, "0")).to_equal(true)
        val ordinary = _cli_driver_binary()
        expect(env_set(key, "1")).to_equal(true)
        val suppressed = _cli_driver_binary()
        val restored = env_set(key, previous)
        val driver_restored = env_set(driver_key, previous_driver)

        expect(restored).to_equal(true)
        expect(driver_restored).to_equal(true)
        expect(ordinary).to_equal(sentinel)
        expect(suppressed).to_equal("")
