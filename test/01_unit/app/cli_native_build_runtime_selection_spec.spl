# @req REQ-RENDER-CLI-002
"""Behavioral coverage for fail-closed native-build worker selection."""

use app.cli.bootstrap_identity.{native_build_runtime_is_rust_seed, native_build_select_worker_runtime, native_build_worker_preflight_code}
use std.spec.*

describe "native-build worker runtime selection":
    # @req REQ-RENDER-CLI-002
    it "rejects canonical Rust seed paths instead of selecting them":
        expect(native_build_runtime_is_rust_seed("src/compiler_rust/target/bootstrap/simple")).to_equal(true)
        expect(native_build_runtime_is_rust_seed("/workspace/src/compiler_rust/target/bootstrap/simple")).to_equal(true)
        expect(native_build_runtime_is_rust_seed("C:\\repo\\src\\compiler_rust\\target\\bootstrap\\simple.exe")).to_equal(true)
        val selected = native_build_select_worker_runtime(
            "src/compiler_rust/target/bootstrap/simple", true,
            "", false,
            "", false,
        )
        expect(selected).to_equal("")
        expect(native_build_worker_preflight_code(selected)).to_equal(1)

    # @req REQ-RENDER-CLI-002
    it "preserves priority among allowed pure-Simple candidates":
        val selected = native_build_select_worker_runtime(
            "/opt/simple/stage3", true,
            "/opt/simple/deployed", true,
            "/opt/simple/invoking", true,
        )
        expect(selected).to_equal("/opt/simple/stage3")
        expect(native_build_worker_preflight_code("/opt/simple/stage3")).to_equal(0)

    # @req REQ-RENDER-CLI-002
    it "fails closed when no runtime candidate exists":
        val selected = native_build_select_worker_runtime(
            "bin/simple", false,
            "", false,
            "", false,
        )
        expect(selected).to_equal("")
        expect(native_build_worker_preflight_code(selected)).to_equal(1)
