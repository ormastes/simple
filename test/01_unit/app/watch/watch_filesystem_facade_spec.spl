"""
Exercise the watch filesystem call sites through their imported facades.
These paths previously failed native HIR lowering with unresolved rt_* names.
"""

use std.spec.*
use app.watch.deps.{extract_imports}
use app.watch.watcher.{collect_snapshot}

describe "watch filesystem facade calls":
    it "extracts imports from an existing source file":
        val imports = extract_imports("src/app/watch/watcher.spl")
        expect(imports).to_contain("std.io_runtime.")

    it "returns no imports for a missing source file":
        val imports = extract_imports("src/app/watch/__watch_io_missing_fixture__.spl")
        expect(imports.len()).to_equal(0)

    it "collects source paths and modification times from an existing directory":
        val snapshot = collect_snapshot("src/app/watch", ".spl")
        var saw_watcher = false
        var saw_deps = false
        for (path, modified_time) in snapshot.entries:
            expect(path.ends_with(".spl")).to_equal(true)
            if path.ends_with("/watcher.spl"):
                saw_watcher = true
                expect(modified_time).to_be_greater_than(0)
            if path.ends_with("/deps.spl"):
                saw_deps = true
                expect(modified_time).to_be_greater_than(0)
        expect(saw_watcher).to_equal(true)
        expect(saw_deps).to_equal(true)

    it "returns an empty snapshot for a missing directory":
        val snapshot = collect_snapshot("src/app/watch/__watch_io_missing_directory__", ".spl")
        expect(snapshot.entries.len()).to_equal(0)
