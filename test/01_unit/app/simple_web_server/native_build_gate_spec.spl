use app.io.mod.{file_read}

describe "Simple web server production native-build gate":
    it "rejects bootstrap-seed compiler authority":
        val script = file_read("scripts/check/build-simple-web-server-native.shs")
        expect(script).to_contain("scripts/lib/simple-compiler-select.shs")
        expect(script).to_contain("simple_compiler_usable \"$SIMPLE_BIN\"")
        expect(script).to_contain("authority probe rejected")
        expect(script.contains("pure-Simple self-hosted compiler")).to_equal(true)

    it "fails closed instead of accepting unresolved compatibility stubs":
        val gate = file_read("scripts/check/build-simple-web-server-native.shs")
        expect(gate).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(gate).to_contain("env -u SIMPLE_BOOTSTRAP -u SIMPLE_RUNTIME_PATH")
        expect(gate).to_contain("stub functions for unresolved symbols")
        expect(gate).to_contain("FAIL: production build fabricated unresolved-symbol stubs")
        expect(gate).to_contain("nm -u \"$OUTPUT\"")

    it "rejects both toolchain globals and retired chr spellings":
        val gate = file_read("scripts/check/build-simple-web-server-native.shs")
        expect(gate).to_contain("__cpu_indicator_init")
        expect(gate).to_contain("__cpu_model")
        expect(gate).to_contain("text_dot_from_char_code")
        expect(gate).to_contain("lib__nogc_async_mut__io__SyncTcpListener")
        expect(gate).to_contain("lib__nogc_async_mut__io__SyncTcpStream")

    it "uses the exact hosted-server source universe and entry closure":
        val gate = file_read("scripts/check/build-simple-web-server-native.shs")
        val lowering = file_read("src/compiler/50.mir/_MirLoweringExpr/method_calls_literals.spl")
        val hosted = file_read("src/runtime/runtime_native.c")
        expect(gate.contains("--source \"$ROOT_DIR/src/compiler\"")).to_be(false)
        expect(gate).to_contain("--source \"$ROOT_DIR/src/app\"")
        expect(gate).to_contain("--source \"$ROOT_DIR/src/lib\"")
        expect(gate).to_contain("--entry-closure")
        expect(gate).to_contain("src/app/simple_web_server/main.spl")
        expect(lowering).to_contain("MirConstValue.Str(\"rt_char_from_code\")")
        expect(lowering.contains("MirConstValue.Str(\"text_dot_from_char_code\")")).to_be(false)
        expect(hosted).to_contain("int64_t rt_char_from_code(int64_t code)")
