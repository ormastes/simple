# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Serial MCP — Unit Specifications
# Feature: SSH over serial + raw serial port MCP tools
# Category: MCP, Serial
# Status: Implemented
# @tag: unit, serial, mcp
#
# SAFETY: serial_open / ssh_serial_connect touch real /dev/ttyUSB* devices.
# A USB disconnect (e.g. ESP32 replug) causes SIGSEGV in simple-main,
# which cascaded into systemd exit.target teardown killing the entire
# tmux session on 2026-05-30.  Hardware-touching tests require SIMPLE_HW_TEST=1.
# Set SIMPLE_HW_TEST=1 only when a SIGSEGV guard is in place.
# (see bug serial_usb_sigsegv_cascade)
#
# GATE DISPOSITION (revised 2026-09-06 — Phase 4 of
# doc/03_plan/infra/audit/serial_sigsegv_and_test_hardening.md, "Re-enable
# BLOCKED serial_mcp_spec tests after guard lands"). The four `BLOCKED:`
# examples asserted only that their own env gate was closed, which asserts
# nothing about the code under test. The guard they waited on has landed:
# `serial_close` is now idempotent in BOTH implementations
# (src/lib/nogc_sync_mut/io/serial_sffi.spl — the live one, imported by
# src/app/serial_mcp/tools.spl — and src/app/io/serial_ffi.spl), so the
# double-free that turned a USB replug into a SIGSEGV cascade can no longer be
# reached by re-closing a stale copy of a SerialPort.
#
# What is asserted below is the DEVICE-FREE half of AC-1..AC-4, exercised
# through the real modules, with no env gate and no `if hardware_available`
# branch:
#   * AC-4  serial_open on an absent device path -> is_valid=false, and a
#           second serial_close on the same port is refused (the guard itself).
#   * AC-1/AC-2  ssh_serial_connect / ssh_serial_connect_native are pure
#           parameter bundles (src/lib/nogc_sync_mut/io/ssh_serial.spl:40,:91 —
#           they touch no descriptor at all), so their validity contract is
#           fully checkable here.
#   * AC-3  ssh_serial_exec on an invalid session returns exit_code -1 /
#           "Invalid session" WITHOUT spawning ssh or opening the device
#           (ssh_serial.spl:67).
# STILL NOT COVERED, deliberately and without a fake stand-in: the half that
# needs a real /dev/ttyUSB* or a pty loopback — a successful open, a real
# read/write round trip, and a real ssh exec. Those need a hardware or pty
# fixture (pty externs are unusable under the seed interpreter, see
# doc/08_tracking/bug/pty_externs_unusable_under_seed_interpreter_2026-09-05.md).
# Do NOT "restore" the old shells by expecting "blocked:"/"ready" — that asserts
# nothing.

use app.serial_mcp.tools.{get_arg, get_arg_int}
use std.mcp_sdk.server.app.{mcp_server_init, mcp_server_tool, mcp_server_handle, mcp_server_reset}
use app.serial_mcp.protocol.{make_tool_serial_open, make_tool_ssh_serial_exec}
use std.nogc_sync_mut.io.serial_sffi.{serial_open, serial_close, serial_is_closed}
use std.nogc_sync_mut.io.ssh_serial.{
    ssh_serial_connect, ssh_serial_connect_native, ssh_serial_exec
}

# A path under /dev that cannot exist: open() fails with ENOENT, so no device
# node is ever touched and no USB transport is involved.
val ABSENT_DEVICE = "/dev/simple-serial-absent-fixture"


describe "SerialPort":
    # @manual scenario evidence
    describe "serial_open":
        it "AC-4: reports an absent device as invalid and refuses the second close":
            # @req REQ-SSPEC-APP
            step("Open a device path that cannot exist")
            val port = serial_open(ABSENT_DEVICE, 115200)
            val expected_open_valid = false
            expect(port.is_valid).to_equal(expected_open_valid)

            step("Close the invalid port, then close it a second time")
            # First close is already a refusal (the handle was never valid);
            # the second must behave identically instead of re-entering
            # termios on a descriptor this module never owned. Both closes
            # returning false is exactly the double-free guard.
            val first_close = serial_close(port)
            val second_close = serial_close(port)
            val expected_close_refused = false
            expect(first_close).to_equal(expected_close_refused)
            expect(second_close).to_equal(expected_close_refused)

            step("Assert the port reports itself closed")
            val expected_closed = true
            expect(serial_is_closed(port)).to_equal(expected_closed)

describe "SshSerialSession":
    describe "ssh_serial_connect":
        it "AC-1: builds a valid socat session only when device and user are both given":
            # @req REQ-SSPEC-APP
            step("Connect with both device and user supplied")
            val session = ssh_serial_connect(ABSENT_DEVICE, 115200, "root")
            val expected_valid = true
            expect(session.is_valid).to_equal(expected_valid)
            expect(session.device).to_equal(ABSENT_DEVICE)
            val expected_baud = 115200
            expect(session.baud).to_equal(expected_baud)

            step("Connect with the user omitted")
            val no_user = ssh_serial_connect(ABSENT_DEVICE, 115200, "")
            val expected_invalid = false
            expect(no_user.is_valid).to_equal(expected_invalid)

            step("Connect with the device omitted")
            val no_device = ssh_serial_connect("", 115200, "root")
            expect(no_device.is_valid).to_equal(expected_invalid)

    describe "ssh_serial_connect_native":
        it "AC-2: the native path applies the same validity contract as the socat path":
            # @req REQ-SSPEC-APP
            step("Connect natively with both device and user supplied")
            val session = ssh_serial_connect_native(ABSENT_DEVICE, 9600, "root")
            val expected_valid = true
            expect(session.is_valid).to_equal(expected_valid)
            val expected_baud = 9600
            expect(session.baud).to_equal(expected_baud)

            step("Connect natively with the user omitted")
            val no_user = ssh_serial_connect_native(ABSENT_DEVICE, 9600, "")
            val expected_invalid = false
            expect(no_user.is_valid).to_equal(expected_invalid)

            step("Connect natively with the device omitted")
            val no_device = ssh_serial_connect_native("", 9600, "root")
            expect(no_device.is_valid).to_equal(expected_invalid)

describe "SshSerialExecResult":
    describe "ssh_serial_exec":
        it "AC-3: refuses an invalid session without spawning ssh or opening the device":
            # @req REQ-SSPEC-APP
            step("Build an invalid session (no user) and run a command through it")
            val session = ssh_serial_connect(ABSENT_DEVICE, 115200, "")
            val expected_invalid = false
            expect(session.is_valid).to_equal(expected_invalid)

            val result = ssh_serial_exec(session, "uname -a")
            step("Assert the refusal is reported as a result, not a transport error")
            # exit_code -1 is the module's own refusal sentinel; a spawned ssh
            # would have produced 255 (ssh's connect failure) and a non-empty
            # stdout/stderr from the child, so this pair also proves no child
            # was launched and no device path was opened.
            val expected_exit_code = -1
            expect(result.exit_code).to_equal(expected_exit_code)
            expect(result.stderr).to_equal("Invalid session")
            expect(result.stdout).to_equal("")

describe "MCP Tool Dispatch":
    describe "tools/call name routing":
        # The app-local `detect_tool_name` helper this block used to call was
        # removed when serial-mcp migrated to the McpServer facade (Wave C3, see
        # src/app/serial_mcp/main.spl). The facade's mcp_server_handle now does the
        # params.name lookup, so these examples exercise that real dispatch path
        # instead of an import that resolves to nothing.
        it "AC-5: routes a tools/call body to the named tool":
            # @req REQ-SSPEC-APP
            step("AC-5: routes a tools/call body to the named tool")
            mcp_server_reset()
            mcp_server_init("serial-mcp-spec", "0.0.0")
            mcp_server_tool("ssh_serial_exec", "probe", fn() -> text: "{}", fn(a: text) -> text: "picked ssh_serial_exec")
            mcp_server_tool("serial_open", "probe", fn() -> text: "{}", fn(a: text) -> text: "picked serial_open")
            val body = "{\"method\":\"tools/call\",\"params\":{\"name\":\"ssh_serial_exec\",\"arguments\":{}}}"
            expect(mcp_server_handle(body) ?? "").to_contain("picked ssh_serial_exec")

        it "AC-5: routes serial_open from body":
            # @req REQ-SSPEC-APP
            step("AC-5: routes serial_open from body")
            mcp_server_reset()
            mcp_server_init("serial-mcp-spec", "0.0.0")
            mcp_server_tool("ssh_serial_exec", "probe", fn() -> text: "{}", fn(a: text) -> text: "picked ssh_serial_exec")
            mcp_server_tool("serial_open", "probe", fn() -> text: "{}", fn(a: text) -> text: "picked serial_open")
            val body = "{\"method\":\"tools/call\",\"params\":{\"name\":\"serial_open\",\"arguments\":{}}}"
            val out = mcp_server_handle(body) ?? ""
            expect(out).to_contain("picked serial_open")
            expect(out.contains("picked ssh_serial_exec")).to_equal(false)

    describe "get_arg":
        it "AC-5: extracts string argument from simple body":
            # Was `expect(found or not found).to_equal(true)` — a tautology that
            # held for every possible return value, including the wrong ones.
            val result = get_arg("{\"params\":{\"name\":\"t\",\"arguments\":{\"key\":\"val\"}}}", "key")
            expect(result).to_equal("val")

        it "AC-5: returns empty text when the argument is absent":
            val result = get_arg("{\"params\":{\"name\":\"t\",\"arguments\":{}}}", "key")
            expect(result).to_equal("")

    describe "get_arg_int":
        it "AC-5: returns default when argument missing":
            # @req REQ-SSPEC-APP
            step("AC-5: returns default when argument missing")
            val body = "{\"params\":{\"name\":\"t\",\"arguments\":{}}}"
            expect(get_arg_int(body, "baud", 9600)).to_equal(9600)

describe "MCP Protocol":
    describe "make_tool_serial_open schema":
        it "AC-5: schema contains tool name":
            # @req REQ-SSPEC-APP
            step("AC-5: schema contains tool name")
            val schema = make_tool_serial_open()
            expect(schema.contains("serial_open")).to_equal(true)

        it "AC-5: schema contains device property":
            # @req REQ-SSPEC-APP
            step("AC-5: schema contains device property")
            val schema = make_tool_serial_open()
            expect(schema.contains("device")).to_equal(true)

        it "AC-5: schema contains baud property":
            # @req REQ-SSPEC-APP
            step("AC-5: schema contains baud property")
            val schema = make_tool_serial_open()
            expect(schema.contains("baud")).to_equal(true)

    describe "make_tool_ssh_serial_exec schema":
        it "AC-5: schema contains cmd property":
            # @req REQ-SSPEC-APP
            step("AC-5: schema contains cmd property")
            val schema = make_tool_ssh_serial_exec()
            expect(schema.contains("cmd")).to_equal(true)
