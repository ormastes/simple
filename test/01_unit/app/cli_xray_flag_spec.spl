"""XRay structural PR1: `simple compile --xray` reaches only routes that can carry sleds."""
use std.spec.*
use app.io._CliCompile.compile_opt_and_driver.{cli_compile, cli_xray_route_supported}

describe "compile --xray route admission":
    it "admits native-code backends that reach the pure-Simple driver":
        expect(cli_xray_route_supported("", "", false, "")).to_equal(true)
        expect(cli_xray_route_supported("auto", "", false, "")).to_equal(true)
        expect(cli_xray_route_supported("llvm", "", false, "")).to_equal(true)
        expect(cli_xray_route_supported("native", "", false, "")).to_equal(true)
        expect(cli_xray_route_supported("llvm", "aarch64-unknown-linux-gnu", false, "")).to_equal(true)

    it "lets Cranelift through so the driver reports UnsupportedTarget":
        expect(cli_xray_route_supported("cranelift", "", false, "")).to_equal(true)

    it "rejects routes that bypass the pure-Simple driver or emit non-native code":
        expect(cli_xray_route_supported("vhdl", "", false, "")).to_equal(false)
        expect(cli_xray_route_supported("cuda", "", false, "")).to_equal(false)
        expect(cli_xray_route_supported("wasm", "", false, "")).to_equal(false)
        expect(cli_xray_route_supported("vulkan", "", false, "")).to_equal(false)
        expect(cli_xray_route_supported("c", "", true, "")).to_equal(false)
        expect(cli_xray_route_supported("llvm", "baremetal-x86", false, "")).to_equal(false)
        expect(cli_xray_route_supported("llvm", "x86_64-simpleos", false, "")).to_equal(false)
        expect(cli_xray_route_supported("llvm", "", false, "dynamic")).to_equal(false)

    it "fails the compile command before compiling when the route is unsupported":
        val status = cli_compile(["test/01_unit/app/cli_xray_flag_spec.spl", "--xray", "--backend=vhdl"])
        expect(status).to_equal(1)
