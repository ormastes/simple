#!/bin/sh
# Native acceptance contract: pass the freshly built arch-check artifact.
set -u

bin=${1:-}
if [ -z "$bin" ] || [ ! -x "$bin" ]; then
    echo "usage: $0 <native-arch-check-binary>" >&2
    exit 2
fi

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

start_ns=$(date +%s%N)
timeout 1 "$bin" --help >"$tmp_dir/help.out" 2>"$tmp_dir/help.err"
rc=$?
end_ns=$(date +%s%N)
elapsed_ms=$(((end_ns - start_ns) / 1000000))

if [ "$rc" -ne 0 ] || [ "$elapsed_ms" -ge 1000 ]; then
    echo "FAIL arch-check --help rc=$rc elapsed_ms=$elapsed_ms" >&2
    exit 1
fi
grep -q '^Usage: simple check-arch' "$tmp_dir/help.out" || {
    echo "FAIL arch-check --help missing usage" >&2
    exit 1
}
echo "PASS arch-check --help elapsed_ms=$elapsed_ms"
