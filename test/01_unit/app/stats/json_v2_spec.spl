#!/usr/bin/env simple

use std.spipe
use app.stats.json_v2 (stats_json_v2)
use app.stats.test_status.{TestStatusCounts}
use app.stats.types.{StatsCountRowV2, StatsProjectRowV2, StatsTestSurfaceV2, StatsQualityEvidenceV2, StatsInventoryV2}

describe "stats JSON v2":
    it "renders stable project, test, and unavailable evidence fields":
        val inventory = StatsInventoryV2(
            projects: [StatsProjectRowV2(name: "compiler", total_files: 2, total_sloc: 20, source_files: 1, source_sloc: 12, test_files: 1, test_sloc: 8)],
            focus_areas: [],
            languages: [StatsCountRowV2(name: "Simple", files: 2, sloc: 20)],
            test_surfaces: [StatsTestSurfaceV2(name: "Unit SSpec", files: 1, runnable_sloc: 8)],
            markdown_files: 3,
            quality: [StatsQualityEvidenceV2(metric: "coverage", status: "unavailable", source: "coverage.sdn", measured_at: "", summary: "artifact not found")]
        )
        val json = stats_json_v2(inventory, TestStatusCounts(total: 10, passed: 5, failed: 2, skipped: 1, pending: 0, in_development: 2, in_development_unexpected: 0, in_development_broken: 0, unclassified: 0))
        expect(json).to_start_with("{\"schema\":\"simple.stats.v2\"")
        expect(json).to_contain("\"source_sloc\":12")
        expect(json).to_contain("\"runnable_sloc\":8")
        # In-development is a first-class field of the v2 projection, not a
        # derived afterthought, and the remainder is surfaced not swallowed.
        expect(json).to_contain("\"in_development\":2")
        expect(json).to_contain("\"unclassified\":0")
        # All three states are emitted UNCONDITIONALLY, including at zero,
        # and BROKEN has its own field so a spec that could not LOAD can
        # never be absorbed into the in-development count.
        expect(json).to_contain("\"in_development_unexpected\":0")
        expect(json).to_contain("\"in_development_broken\":0")
        expect(json).to_contain("\"status\":\"unavailable\"")
