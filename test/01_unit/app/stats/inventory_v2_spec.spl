"""
## Purpose and audience
Purpose: Prove that stats inventory v2.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-STATS-001 — stable requirement identity for this spec.
#!/usr/bin/env simple

use std.spipe
use app.stats.inventory_v2.{StatsFileFactV2, stats_path_is_excluded, stats_is_tldr_markdown, stats_language_for_path, stats_project_for_path, stats_test_tier, stats_has_focus, aggregate_stats_inventory_v2}
use std.spec.step


describe "stats inventory v2":
    it "classifies paths with stable ownership and language rules":
        step("Verify: classifies paths with stable ownership and language rules")
        # @req: REQ-APP-STATS-001
        expect(stats_project_for_path("src/compiler/parser/main.spl")).to_equal("compiler")
        expect(stats_project_for_path("test/03_system/app/simpleos/boot_spec.spl")).to_equal("OS")
        expect(stats_language_for_path("src/runtime/entry.c")).to_equal("C/C++/headers/assembly")
        expect(stats_language_for_path("scripts/check/all.shs")).to_equal("Scripts")
        expect(stats_test_tier("test/02_integration/app/stats_spec.spl")).to_equal("Integration SSpec")

    it "excludes third-party paths and generated TLDR companions":
        step("Verify: excludes third-party paths and generated TLDR companions")
        expect(stats_path_is_excluded("src/compiler_rust/vendor/parser/lib.rs")).to_equal(true)
        expect(stats_path_is_excluded("src/runtime/stb_image.h")).to_equal(true)
        expect(stats_is_tldr_markdown("doc/09_report/project_statistics_tldr.md")).to_equal(true)
        expect(stats_path_is_excluded("src/runtime/native.c")).to_equal(false)

    it "recognises overlapping firmware and RISC-V focus areas":
        step("Verify: recognises overlapping firmware and RISC-V focus areas")
        val path = "src/os/firmware/riscv64/boot.spl"
        expect(stats_has_focus(path, "firmware")).to_equal(true)
        expect(stats_has_focus(path, "RISC-V")).to_equal(true)

    it "recognises product application and tooling focus areas":
        step("Verify: recognises product application and tooling focus areas")
        expect(stats_has_focus("src/lib/nogc_sync_mut/database/server/server.spl", "DB server")).to_equal(true)
        expect(stats_has_focus("src/app/simple_web_server/main.spl", "Web server")).to_equal(true)
        expect(stats_has_focus("src/lib/gc_async_mut/gpu/browser_engine/browser_renderer.spl", "Web Browser")).to_equal(true)
        expect(stats_has_focus("src/app/ui.render/main.spl", "UI/rendering")).to_equal(true)
        expect(stats_has_focus("src/app/office/mod.spl", "Office")).to_equal(true)
        expect(stats_has_focus("examples/12_business/simple_erp/src/lanes/crm.spl", "CRM")).to_equal(true)
        expect(stats_has_focus("src/app/llm_caret/main.spl", "Agent Caret")).to_equal(true)
        expect(stats_has_focus("src/app/llm_caret/components/agents/list.spl", "Agents Manager")).to_equal(true)
        expect(stats_has_focus("src/app/spipe_docgen/main.spl", "SPipe")).to_equal(true)

    it "aggregates project language and test rows without double-counting TLDR files":
        step("Verify: aggregates project language and test rows without double-counting TLDR files")
        val facts = [
            StatsFileFactV2(path: "src/compiler/parser.spl", sloc: 10, markdown_test_sloc: 0, comment_test_sloc: 2),
            StatsFileFactV2(path: "src/os/firmware/riscv64/boot.spl", sloc: 20, markdown_test_sloc: 0, comment_test_sloc: 0),
            StatsFileFactV2(path: "test/01_unit/compiler/parser_spec.spl", sloc: 7, markdown_test_sloc: 0, comment_test_sloc: 0),
            StatsFileFactV2(path: "test/03_system/app/simpleos/boot_spec.spl", sloc: 9, markdown_test_sloc: 0, comment_test_sloc: 0),
            StatsFileFactV2(path: "doc/guide.md", sloc: 12, markdown_test_sloc: 3, comment_test_sloc: 0),
            StatsFileFactV2(path: "doc/guide_tldr.md", sloc: 4, markdown_test_sloc: 1, comment_test_sloc: 0),
            StatsFileFactV2(path: "src/runtime/vendor/foreign.c", sloc: 100, markdown_test_sloc: 0, comment_test_sloc: 0)
        ]
        val inventory = aggregate_stats_inventory_v2(facts)
        expect(inventory.projects[0].source_sloc).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(inventory.projects[3].total_sloc).to_equal(29)  # oracle: 29 — named expected value from the requirement
        expect(inventory.focus_areas[0].total_sloc).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(inventory.focus_areas[1].total_sloc).to_equal(20)  # oracle: 20 — named expected value from the requirement
        expect(inventory.languages[0].sloc).to_equal(46)  # oracle: 46 — named expected value from the requirement
        expect(inventory.languages[4].files).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(inventory.test_surfaces[0].runnable_sloc).to_equal(21)  # oracle: 21 — named expected value from the requirement
        expect(inventory.test_surfaces[1].runnable_sloc).to_equal(16)  # oracle: 16 — named expected value from the requirement
        expect(inventory.test_surfaces[2].runnable_sloc).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(inventory.test_surfaces[4].runnable_sloc).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(inventory.test_surfaces[6].runnable_sloc).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(inventory.test_surfaces[7].runnable_sloc).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(inventory.markdown_files).to_equal(1)  # oracle: 1 — named expected value from the requirement
