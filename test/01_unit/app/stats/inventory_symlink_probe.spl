# Harness supplies a real temporary filesystem fixture containing:
# kept.spl, real/nested.spl, file-link.spl -> kept.spl,
# directory-link -> real, dangling.spl -> absent, real/cycle -> .. .
use app.io.mod.{env_get, dir_is_real_no_follow, file_is_regular_no_follow}
use app.stats.inventory_scan_v2.{stats_scan_tree}

fn main() -> i64:
    val root = env_get("SIMPLE_STATS_SYMLINK_FIXTURE")
    if root == "": return 1
    if not dir_is_real_no_follow(root + "/real"): return 2
    if not file_is_regular_no_follow(root + "/kept.spl"): return 3
    if dir_is_real_no_follow(root + "/directory-link"): return 4
    if dir_is_real_no_follow(root + "/real/cycle"): return 5
    if file_is_regular_no_follow(root + "/file-link.spl"): return 6
    if file_is_regular_no_follow(root + "/dangling.spl"): return 7
    if file_is_regular_no_follow(root + "/missing.spl"): return 8
    val facts = stats_scan_tree(root)
    if facts.len() != 2: return 9
    var kept = false
    var nested = false
    for fact in facts:
        if fact.path == root + "/kept.spl" and fact.sloc == 1: kept = true
        if fact.path == root + "/real/nested.spl" and fact.sloc == 1: nested = true
    if not kept or not nested: return 10
    if stats_scan_tree(root + "/directory-link").len() != 0: return 11
    if stats_scan_tree(root + "/missing-directory").len() != 0: return 12
    print "inventory symlink probe PASS: two real files; file, directory, dangling and cyclic links excluded"
    0
