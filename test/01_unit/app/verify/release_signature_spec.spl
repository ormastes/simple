use std.spec
use compiler.common.assurance.formal_status.{FormalStatus}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.verified_release_gate.{ReleaseEvidenceOutcomeV1,
    VerifiedReleaseEvidenceV1, SignedVerifiedReleaseBundleV1,
    ApprovedReleaseSignerV1,
    release_evidence_hash_v1, validate_signed_verified_release_bundle_v1}
use app.verify.release_signature.{verify_release_bundle_ed25519_v1,
    fv2_release_signature_message_v1}
use lib.common.crypto.ed25519.{pure_ed25519_keypair_from_seed,
    pure_ed25519_sign}

fn release_signature_evidence() -> VerifiedReleaseEvidenceV1:
    VerifiedReleaseEvidenceV1("verified", FormalStatus.ArtifactVerified,
        [FormalStatus.ArtifactVerified], sha256_text("artifact"),
        sha256_text("artifact"), [sha256_text("proof")],
        [sha256_text("compiler")], sha256_text("trust"), "",
        sha256_text("replay"), sha256_text("mutation"), sha256_text("non-vacuity"),
        [ReleaseEvidenceOutcomeV1.ProvedWithCertificate], 0, 0, 0, 0,
        sha256_text("delivery-gates"))

fn release_seed() -> [u8]:
    [0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8,
        8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8,
        16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8,
        24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8]

fn public_key_hash(public_key: [u8]) -> text:
    var parts: [text] = []
    for value in public_key: parts.push(value.to_i64().to_string())
    sha256_text(public_key.len().to_string() + ":[" + parts.join(",") + "]")

describe "FV2 pure-Simple signed release evidence":
    it "verifies an exact Ed25519 signature before bundle admission":
        val evidence = release_signature_evidence()
        val payload = release_evidence_hash_v1(evidence)
        val keys = pure_ed25519_keypair_from_seed(release_seed())
        val signer = ApprovedReleaseSignerV1("release-key",
            public_key_hash(keys.1))
        val signature = pure_ed25519_sign(release_seed(), keys.1,
            fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v1",
                payload, signer.signer_id, signer.public_key_hash))
        val receipt = verify_release_bundle_ed25519_v1(evidence,
            signer, keys.1, signature)
        expect(receipt.receipt.verified).to_equal(true)
        val bundle = SignedVerifiedReleaseBundleV1(evidence, payload,
            "release-key", receipt)
        val decision = validate_signed_verified_release_bundle_v1(bundle,
            [signer])
        expect(decision.admitted).to_equal(true)

    it "rejects a changed signature before release reduction":
        val evidence = release_signature_evidence()
        val payload = release_evidence_hash_v1(evidence)
        val keys = pure_ed25519_keypair_from_seed(release_seed())
        val signer = ApprovedReleaseSignerV1("release-key",
            public_key_hash(keys.1))
        var signature = pure_ed25519_sign(release_seed(), keys.1,
            fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v1",
                payload, signer.signer_id, signer.public_key_hash))
        signature[0] = signature[0] ^ 1u8
        val receipt = verify_release_bundle_ed25519_v1(evidence,
            signer, keys.1, signature)
        expect(receipt.receipt.verified).to_equal(false)
        expect(receipt.receipt.diagnostic()).to_contain(
            "signature verification failed")

    it "rejects a valid signature under a key not bound to signer policy":
        val evidence = release_signature_evidence()
        val payload = release_evidence_hash_v1(evidence)
        val keys = pure_ed25519_keypair_from_seed(release_seed())
        val wrong_policy = ApprovedReleaseSignerV1("release-key",
            "different-public-key")
        val signature = pure_ed25519_sign(release_seed(), keys.1,
            fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v1",
                payload, wrong_policy.signer_id, public_key_hash(keys.1)))
        val receipt = verify_release_bundle_ed25519_v1(evidence,
            wrong_policy, keys.1, signature)
        expect(receipt.receipt.verified).to_equal(false)

    it "rejects relabelling a valid signature to a different signer identity":
        val evidence = release_signature_evidence()
        val payload = release_evidence_hash_v1(evidence)
        val keys = pure_ed25519_keypair_from_seed(release_seed())
        val signer = ApprovedReleaseSignerV1("release-key", public_key_hash(keys.1))
        val signature = pure_ed25519_sign(release_seed(), keys.1,
            fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v1",
                payload, signer.signer_id, signer.public_key_hash))
        val relabelled = ApprovedReleaseSignerV1("release-key-alias",
            signer.public_key_hash)
        val receipt = verify_release_bundle_ed25519_v1(evidence,
            relabelled, keys.1, signature)
        expect(receipt.receipt.verified).to_equal(false)
