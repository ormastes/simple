# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.policy_schema.{AssuranceStrictnessV2,
    AssuranceGrade, AssuranceConvention, ResolvedAssurancePolicyV2,
    assurance_policy_authority_hash_v3}
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.verified_release_gate.{ApprovedReleaseSignerV1,
    ReleaseEvidenceOutcomeV1, VerifiedReleaseEvidenceV1,
    VerifiedReleaseEvidenceV2, evaluate_verified_release_v2}
use app.verify.release_bundle_loader.{ApprovedReleaseSignerPolicyV2,
    ApprovedReleaseSignerPolicyV3,
    LoadedReleaseBundleV2, parse_release_signers_sdn_v3,
    admit_loaded_release_bundle_v2, admit_loaded_release_bundle_v3,
    release_signer_policy_authority_diagnostic_v3}
use app.verify.release_signer_policy.{repository_release_signer_policy_path_v3,

    release_signer_policy_fixed_path_diagnostic_v3,
    release_signer_policy_root_authority_diagnostic_v3,
    release_signer_policy_legacy_v1_execution_diagnostic,
    release_signer_allow_list_hash_v3}

fn loader_evidence() -> VerifiedReleaseEvidenceV1:
    VerifiedReleaseEvidenceV1("verified", FormalStatus.ArtifactVerified,
        [FormalStatus.ArtifactVerified], sha256_text("artifact"),
        sha256_text("artifact"), [sha256_text("proof")],
        [sha256_text("compiler")], sha256_text("trust"), "",
        sha256_text("replay"), sha256_text("mutation"), sha256_text("non-vacuity"),
        [ReleaseEvidenceOutcomeV1.ProvedWithCertificate], 0, 0, 0, 0,
        formal_delivery_manifest_hash_v1(loader_delivery_gates()))

fn loader_delivery_gates() -> [FormalDeliveryGateEvidenceV1]:
    val gates = [FormalDeliveryGateV1.VerificationTruthfulness,
        FormalDeliveryGateV1.ExactCoreSemantics,
        FormalDeliveryGateV1.VirCompilerRelation,
        FormalDeliveryGateV1.AopMacroClosure,
        FormalDeliveryGateV1.SimpleOsVerticalSlice,
        FormalDeliveryGateV1.GeneratedRv32iEndToEnd,
        FormalDeliveryGateV1.Rv64PrivilegeMmuLinux,
        FormalDeliveryGateV1.VerifiedRelease]
    var result: [FormalDeliveryGateEvidenceV1] = []
    for gate in gates:
        val semantic_hash = sha256_text("semantic-" + gate.name())
        val content = loader_receipt_content(gate, semantic_hash)
        val receipt_hash = sha256_text(content)
        val evidence_hash = sha256_text("FormalDeliveryGateEvidence-v2|gate=" +
            gate.name() + "|semantic=" + semantic_hash + "|receipts=1:[64:" +
            receipt_hash + "]")
        result.push(FormalDeliveryGateEvidenceV1(gate,
            FormalDeliveryGateStatusV1.Passed,
            [receipt_hash], evidence_hash, ""))
    result

fn loader_receipt_content(gate: FormalDeliveryGateV1, semantic_hash: text) -> text:
    val payload = "loader-fixture"
    "FormalDeliveryReceipt-v2\n" +
        "gate=" + gate.name() + "\n" +
        "semantic_evidence_hash=" + semantic_hash + "\n" +
        "payload_sha256=" + sha256_text(payload) + "\n\n" + payload

fn loader_receipts() -> [FormalDeliveryReceiptFileV1]:
    var result: [FormalDeliveryReceiptFileV1] = []
    for gate in loader_delivery_gates():
        val content = loader_receipt_content(gate.gate,
            sha256_text("semantic-" + gate.gate.name()))
        result.push(FormalDeliveryReceiptFileV1(sha256_text(content), content))
    result

fn loader_seed() -> [u8]:
    [0u8, 1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8,
        8u8, 9u8, 10u8, 11u8, 12u8, 13u8, 14u8, 15u8,
        16u8, 17u8, 18u8, 19u8, 20u8, 21u8, 22u8, 23u8,
        24u8, 25u8, 26u8, 27u8, 28u8, 29u8, 30u8, 31u8]

fn loader_bytes_sdn(values: [u8]) -> text:
    var parts: [text] = []
    for value in values: parts.push(value.to_i64().to_string())
    "[" + parts.join(",") + "]"

fn loader_key_hash(values: [u8]) -> text:
    var parts: [text] = []
    for value in values: parts.push(value.to_i64().to_string())
    sha256_text(values.len().to_string() + ":[" + parts.join(",") + "]")

fn loader_evidence_sdn() -> text:
    "{assurance_profile: verified, artifact_status: artifact_verified, " +
        "reachable_symbol_statuses: [artifact_verified], artifact_hash: " +
        sha256_text("artifact") + ", evidence_artifact_hash: " +
        sha256_text("artifact") + ", proof_receipt_hashes: [" +
        sha256_text("proof") + "], compiler_certificate_hashes: [" +
        sha256_text("compiler") + "], trust_manifest_hash: " +
        sha256_text("trust") + ", " +
        "bounded_tcb_manifest_hash: \"\", independent_replay_hash: " +
        sha256_text("replay") + ", " +
        "mutation_receipt_hash: " + sha256_text("mutation") +
        ", non_vacuity_receipt_hash: " + sha256_text("non-vacuity") + ", " +
        "tool_outcomes: [proved_with_certificate], unsupported_construct_count: 0, " +
        "stale_evidence_count: 0, warning_control_count: 0, environment_error_count: 0, " +
        "delivery_gate_manifest_hash: " +
        formal_delivery_manifest_hash_v1(loader_delivery_gates()) + "}"

fn loader_gates_sdn() -> text:
    var rows: [text] = []
    for gate in loader_delivery_gates():
        rows.push("{gate: " + gate.gate.name() + ", status: passed, receipt_hashes: " +
            "[" + gate.receipt_hashes[0] + "], evidence_hash: " +
            gate.evidence_hash +
            ", diagnostic: \"\"}")
    "[" + rows.join(",") + "]"

fn loader_bundle_sdn(extra: text = "") -> (text, text):
    val evidence = loader_evidence()
    val payload = release_evidence_hash_v1(evidence)
    val keys = pure_ed25519_keypair_from_seed(loader_seed())
    val signature = pure_ed25519_sign(loader_seed(), keys.1,
        fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v1",
            payload, "release-key", loader_key_hash(keys.1)))
    val bundle = "{schema: simple.formal.release-bundle.v1, payload_hash: " +
        payload + ", signer_id: release-key, public_key: " +
        loader_bytes_sdn(keys.1) + ", signature: " +
        loader_bytes_sdn(signature) + ", evidence: " + loader_evidence_sdn() +
        ", delivery_gates: " + loader_gates_sdn() + extra + "}"
    val policy = "{schema: simple.formal.release-signers.v1, signers: " +
        "[{signer_id: release-key, public_key_hash: " +
        loader_key_hash(keys.1) + "}]}"
    (bundle, policy)

fn loader_policy_v2() -> ResolvedAssurancePolicyV2:
    ResolvedAssurancePolicyV2(AssuranceStrictnessV2.Verified,
        "nogc_async_mut", AssuranceGrade.NoGrade,
        AssuranceConvention.NoConvention)

fn loader_policy_v2_sdn() -> text:
    "{strictness: verified, runtime_family: nogc_async_mut, " +
        "assurance_grade: none, convention: none}"

fn loader_bundle_sdn_v2(extra: text = "") -> (text, text):
    val evidence = VerifiedReleaseEvidenceV2(loader_policy_v2(), loader_evidence())
    val payload = evaluate_verified_release_v2(evidence).evidence_hash
    val keys = pure_ed25519_keypair_from_seed(loader_seed())
    val signature = pure_ed25519_sign(loader_seed(), keys.1,
        fv2_release_signature_message_v1("FV2-RELEASE-SIGNATURE-v2",
            payload, "release-key", loader_key_hash(keys.1)))
    val bundle = "{schema: simple.formal.release-bundle.v2, payload_hash: " +
        payload + ", signer_id: release-key, public_key: " +
        loader_bytes_sdn(keys.1) + ", signature: " +
        loader_bytes_sdn(signature) + ", policy: " + loader_policy_v2_sdn() +
        ", evidence: " + loader_evidence_sdn() + ", delivery_gates: " +
        loader_gates_sdn() + extra + "}"
    val signers = "{schema: simple.formal.release-signers.v2, policy_hash: " +
        loader_policy_v2().policy_hash() + ", signers: " +
        "[{signer_id: release-key, public_key_hash: " +
        loader_key_hash(keys.1) + "}]}"
    (bundle, signers)

describe "FV2 strict signed release bundle loader":
    it "requires deployed artifact bytes to match both signed identities":
        val evidence = loader_evidence()
        expect(validate_release_artifact_identity_v1(evidence,
            evidence.artifact_hash)).to_equal("")
        expect(validate_release_artifact_identity_v1(evidence,
            sha256_text("changed-artifact"))).to_contain("ARTIFACT-IDENTITY")
        var split = evidence
        split.evidence_artifact_hash = sha256_text("other-evidence-artifact")
        expect(validate_release_artifact_identity_v1(split,
            evidence.artifact_hash)).to_contain("ARTIFACT-IDENTITY")
        expect(validate_release_artifact_identity_v1(evidence,
            "weak-hash")).to_contain("ARTIFACT-HASH")

describe "release bundle loader signer-policy authority":
    # @manual scenario evidence
    it "rejects caller-selected signer-policy paths":
        # @req REQ-SSPEC-APP
        step("rejects caller-selected signer-policy paths")
        expect(release_signer_policy_fixed_path_diagnostic_v3(
            "/tmp/caller-policy.sdn", true, true)).to_contain(
            "FV2-E-RELEASE-POLICY-FIXED-PATH-V3")

    it "rejects a missing fixed signer-policy file":
        # @req REQ-SSPEC-APP
        step("rejects a missing fixed signer-policy file")
        expect(release_signer_policy_fixed_path_diagnostic_v3(
            repository_release_signer_policy_path_v3(), false,
            false)).to_contain("FV2-E-RELEASE-POLICY-MISSING-V3")

    it "rejects a nonregular or symlink fixed signer-policy file":
        # @req REQ-SSPEC-APP
        step("rejects a nonregular or symlink fixed signer-policy file")
        expect(release_signer_policy_fixed_path_diagnostic_v3(
            repository_release_signer_policy_path_v3(), true,
            false)).to_contain("non-regular or a symlink")

    it "fails closed without a trusted executable or install root":
        # @req REQ-SSPEC-APP
        step("fails closed without a trusted executable or install root")
        expect(release_signer_policy_root_authority_diagnostic_v3()).to_contain(
            "FV2-E-RELEASE-POLICY-ROOT-AUTHORITY-V3")

    it "disables legacy V1 admission at the production execution boundary":
        # @req REQ-SSPEC-APP
        step("disables legacy V1 admission at the production execution boundary")
        expect(release_signer_policy_legacy_v1_execution_diagnostic()).to_contain(
            "FV2-E-RELEASE-POLICY-LEGACY-V1-ROOT-EXECUTION-AUTHORITY")

    it "parses compatibility and cryptographic authority identities":
        # @req REQ-SSPEC-APP
        step("parses compatibility and cryptographic authority identities")
        val policy = release_policy()
        match parse_release_signers_sdn_v3(signer_policy_source(policy)):
            case Err(message): fail("V3 signer policy rejected: " + message)
            case Ok(parsed):
                expect(parsed.policy_hash_v2).to_equal(policy.policy_hash())
                expect(parsed.policy_authority_sha256).to_equal(
                    assurance_policy_authority_hash_v3(policy))
                expect(parsed.signer_allow_list_sha256).to_equal(
                    release_signer_allow_list_hash_v3(parsed.signers))
                expect(parsed.signers.len()).to_equal(1)

    it "makes signer allow-list identity stable under row reordering":
        # @req REQ-SSPEC-APP
        step("makes signer allow-list identity stable under row reordering")
        val first = ApprovedReleaseSignerV1("alpha", sha256_text("alpha-key"))
        val second = ApprovedReleaseSignerV1("beta", sha256_text("beta-key"))
        expect(release_signer_allow_list_hash_v3([first, second])).to_equal(
            release_signer_allow_list_hash_v3([second, first]))

    it "changes signer allow-list identity for membership or key mutation":
        # @req REQ-SSPEC-APP
        step("changes signer allow-list identity for membership or key mutation")
        val first = ApprovedReleaseSignerV1("alpha", sha256_text("alpha-key"))
        val second = ApprovedReleaseSignerV1("beta", sha256_text("beta-key"))
        val baseline = release_signer_allow_list_hash_v3([first, second])
        expect(baseline == release_signer_allow_list_hash_v3([first])).to_be(false)
        expect(baseline == release_signer_allow_list_hash_v3([first,
            ApprovedReleaseSignerV1("beta", sha256_text("mutated-key"))])).to_be(false)

    it "rejects a parsed V3 policy after signer membership mutation":
        # @req REQ-SSPEC-APP
        step("rejects a parsed V3 policy after signer membership mutation")
        val policy = release_policy()
        val claimed = release_signer_allow_list_hash_v3([
            ApprovedReleaseSignerV1("alpha", sha256_text("alpha-key"))])
        val source = "{schema: simple.formal.release-signers.v3, " +
            "policy_hash_v2: \"" + policy.policy_hash() + "\", " +
            "policy_authority_sha256: \"" +
            assurance_policy_authority_hash_v3(policy) + "\", " +
            "signer_allow_list_sha256: \"" + claimed + "\", " +
            "signers: [{signer_id: alpha, public_key_hash: \"" +
            sha256_text("alpha-key") + "\"}, {signer_id: beta, " +
            "public_key_hash: \"" + sha256_text("beta-key") + "\"}]}"
        match parse_release_signers_sdn_v3(source):
            case Err(message): expect(message).to_contain(
                "identity and public key identity must both be unique")

    it "rejects duplicate signer identities while parsing V3":
        # @req REQ-SSPEC-APP
        step("rejects duplicate signer identities while parsing V3")
        val policy = release_policy()
        val source = "{schema: simple.formal.release-signers.v3, " +
            "policy_hash_v2: \"" + policy.policy_hash() + "\", " +
            "policy_authority_sha256: \"" +
            assurance_policy_authority_hash_v3(policy) + "\", " +
            "signer_allow_list_sha256: \"" + sha256_text("duplicate-set") +
            "\", signers: [{signer_id: duplicate, public_key_hash: \"" +
            sha256_text("first-key") + "\"}, {signer_id: duplicate, " +
            "public_key_hash: \"" + sha256_text("second-key") + "\"}]}"
        match parse_release_signers_sdn_v3(source):
            case Err(message): expect(message).to_contain(
                "identity and public key identity must both be unique")

    it "rejects legacy APOLV2 signer policy as stale for V2 release":
        # @req REQ-SSPEC-APP
        step("rejects legacy APOLV2 signer policy as stale for V2 release")
        val policy = release_policy()
        val legacy = "{schema: simple.formal.release-signers.v2, " +
            "policy_hash: \"" + policy.policy_hash() + "\", " +
            "signers: [{signer_id: release-key, public_key_hash: \"" +
            sha256_text("release-public-key") + "\"}]}"
        match parse_release_signers_sdn_v3(legacy):
            case Err(message): expect(message).to_contain(
                "FV2-E-RELEASE-POLICY-STALE-V2")
            case Ok(_): fail("legacy signer policy unexpectedly accepted")

    it "rejects a constructed signer policy with the wrong authority":
        # @req REQ-SSPEC-APP
        step("rejects a constructed signer policy with the wrong authority")
        val policy = release_policy()
        val forged = ApprovedReleaseSignerPolicyV3(policy.policy_hash(),
            sha256_text("different-policy-authority"),
            release_signer_allow_list_hash_v3([ApprovedReleaseSignerV1(
                "release-key", sha256_text("release-public-key"))]),
            [ApprovedReleaseSignerV1("release-key",
                sha256_text("release-public-key"))])
        expect(release_signer_policy_authority_diagnostic_v3(policy,
            forged)).to_contain("FV2-E-RELEASE-BUNDLE-POLICY-AUTHORITY-V3")

    it "rejects constructed V3 signer-set identity mutation":
        # @req REQ-SSPEC-APP
        step("rejects constructed V3 signer-set identity mutation")
        val policy = release_policy()
        val signer = ApprovedReleaseSignerV1("release-key",
            sha256_text("release-public-key"))
        val forged = ApprovedReleaseSignerPolicyV3(policy.policy_hash(),
            assurance_policy_authority_hash_v3(policy),
            sha256_text("different-signer-set"), [signer])
        expect(release_signer_policy_authority_diagnostic_v3(policy,
            forged)).to_contain("FV2-E-RELEASE-BUNDLE-SIGNER-ALLOW-LIST-V3")

    it "does not admit a constructed V3 signer policy with matching hashes":
        # @req REQ-SSPEC-APP
        step("does not admit a constructed V3 signer policy with matching hashes")
        val policy = release_policy()
        val constructed = ApprovedReleaseSignerPolicyV3(policy.policy_hash(),
            assurance_policy_authority_hash_v3(policy),
            release_signer_allow_list_hash_v3([ApprovedReleaseSignerV1(
                "release-key", sha256_text("release-public-key"))]),
            [ApprovedReleaseSignerV1("release-key",
                sha256_text("release-public-key"))])
        val decision = admit_loaded_release_bundle_v3(
            loaded_release(policy), constructed)
        expect(decision.admitted).to_be(false)
        expect(decision.diagnostic).to_contain(
            "FV2-E-RELEASE-SIGNER-POLICY-EXECUTION-AUTHORITY-V3")

    it "does not admit a constructed legacy V2 signer policy":
        # @req REQ-SSPEC-APP
        step("does not admit a constructed legacy V2 signer policy")
        val policy = release_policy()
        val constructed = ApprovedReleaseSignerPolicyV2(policy.policy_hash(),
            [ApprovedReleaseSignerV1("release-key",
                sha256_text("release-public-key"))])
        val decision = admit_loaded_release_bundle_v2(
            loaded_release(policy), constructed)
        expect(decision.admitted).to_be(false)
        expect(decision.diagnostic).to_contain(
            "FV2-E-RELEASE-POLICY-STALE-V2")
