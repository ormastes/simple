use std.spec
use compiler.backend.backend.riscv_scalar_rvfi_formal.{
    generate_rv32_add_formal_artifacts}
use app.verify.riscv_add_formal_bundle.{rv32_bundle_name_is_safe}

describe "FV2 RV32 ADD formal bundle generator":
    it "accepts canonical module identities and rejects path/shell text":
        expect(rv32_bundle_name_is_safe("fv2_rv32_add")).to_be(true)
        expect(rv32_bundle_name_is_safe("../rv32")).to_be(false)
        expect(rv32_bundle_name_is_safe("rv32;touch_bad")).to_be(false)

    it "binds the generated manifest to every semantic identity":
        val artifacts = generate_rv32_add_formal_artifacts(
            "fv2_rv32_add", 0x002081B3).ok().unwrap()
        expect(artifacts.manifest).to_contain(
            "hw_ir_sha256=" + artifacts.hwir_hash)
        expect(artifacts.manifest).to_contain(
            "rtl_sha256=" + artifacts.rtl_hash)
        expect(artifacts.manifest).to_contain(
            "rvfi_contract_sha256=" + artifacts.rvfi_contract_hash)
        expect(artifacts.manifest).to_contain(
            "assumption_manifest_sha256=" + artifacts.assumption_manifest_hash)
