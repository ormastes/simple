use std.spec
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v9_rvfi_formal.{generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts}
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use app.verify.riscv_scalar_runtime_pipeline_v9_formal_bundle.{riscv_v9_formal_bundle_name_is_safe, riscv_v9_formal_bundle_profile_is_exact}

describe "V9 RVFI formal bundle generator":
    it "accepts only shell-safe module identities and exact V9 product profiles":
        expect(riscv_v9_formal_bundle_name_is_safe("v9_formal32")).to_be(true)
        expect(riscv_v9_formal_bundle_name_is_safe("../v9")).to_be(false)
        expect(riscv_v9_formal_bundle_profile_is_exact("rv32im_zicsr_zifencei")).to_be(true)
        expect(riscv_v9_formal_bundle_profile_is_exact("rv32im")).to_be(false)
        expect(riscv_v9_formal_bundle_profile_is_exact("rv64imac_zicsr_zifencei")).to_be(false)

    it "binds the nine-field pending manifest and all six generated inputs":
        val artifacts = generate_riscv_scalar_runtime_pipeline_v9_rvfi_formal_artifacts("v9_formal32", CoreConfig.rv32im_zicsr_zifencei(), LsuConfig.rv32_product_default()).ok().unwrap()
        expect(artifacts.manifest).to_contain("schema=simple-riscv-v9-rvfi-formal-manifest-v1")
        expect(artifacts.manifest).to_contain("proved_property_ids=v9.rvfi.non-control-pc-plus-four,v9.rvfi.retirement-order,v9.rvfi.non-interrupt-retirement,v9.runtime.fault-fail-closed")
        expect(artifacts.manifest).to_contain("product_profile=rv32im_zicsr_zifencei")
        expect(artifacts.manifest.contains("\nscope=")).to_be(false)
        expect(artifacts.manifest.contains("\nprofile=")).to_be(false)
        expect(artifacts.manifest).to_contain("xlen=32")
        expect(artifacts.manifest).to_contain("expected_results=prove:proved,cover:covered,mutant:counterexample")
        expect(artifacts.manifest).to_contain("hwir_sha256=")
        expect(artifacts.manifest).to_contain("rtl_sha256=")
        expect(artifacts.manifest).to_contain("rvfi_contract_sha256=")
        expect(artifacts.manifest).to_contain("assumption_manifest_sha256=")
        expect(artifacts.prove_sby).to_contain("mode prove")
        expect(artifacts.cover_sby).to_contain("mode cover")
