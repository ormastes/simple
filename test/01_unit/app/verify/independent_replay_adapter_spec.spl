use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.verify.independent_replay_adapter.{adapter_token_is_safe, adapter_sha256_is_valid, adapter_config}

describe "FV2 independent replay adapter":
    it "accepts canonical module and artifact identities only":
        expect(adapter_token_is_safe("Simple.Verified_Module")).to_equal(true)
        expect(adapter_token_is_safe("sha256-deadbeef")).to_equal(true)
        expect(adapter_token_is_safe("Simple;touch.bad")).to_equal(false)
        expect(adapter_token_is_safe("../Simple")).to_equal(false)

    it "requires an exact lowercase SHA-256 artifact identity":
        expect(adapter_sha256_is_valid(
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")).to_equal(true)
        expect(adapter_sha256_is_valid("sha256-deadbeef")).to_equal(false)
        expect(adapter_sha256_is_valid(
            "0123456789ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef")).to_equal(false)
        expect(adapter_sha256_is_valid(
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcde")).to_equal(false)

    it "uses the closed nanoda axiom policy":
        val config = adapter_config("build/verification/module.ndjson")
        expect(config).to_contain("\"unpermitted_axiom_hard_error\": false")
        expect(config).to_contain("\"propext\"")
        expect(config).to_contain("\"Classical.choice\"")
        expect(config).to_contain("\"Quot.sound\"")
        expect(config.contains("sorryAx")).to_equal(false)
        expect(config.contains("Lean.trustCompiler")).to_equal(false)
        expect(config).to_contain("\"nat_extension\": false")
        expect(config).to_contain("\"string_extension\": false")

    it "requires an exact artifact path in addition to its SHA-256 identity":
        val source = file_read("src/app/verify/independent_replay_adapter.spl")
        expect(source).to_contain("ARTIFACT_PATH")
        expect(source).to_contain("file_hash_sha256(artifact_path) != artifact_hash")
        expect(source).to_contain("expected_artifact_path")
