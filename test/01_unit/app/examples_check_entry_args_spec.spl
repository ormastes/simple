use std.spec.{describe, it, expect}
use app.cli.examples_check_entry.{normalize_args}
use app.examples_check.main.{parse_args}

describe "examples-check argument preservation":
    it "keeps a lone target named examples-check after CLI dispatch":
        val args = normalize_args(["examples-check"])
        expect(args.len()).to_equal(1)
        expect(args[0]).to_equal("examples-check")
        expect(parse_args(args).root).to_equal("examples-check")
