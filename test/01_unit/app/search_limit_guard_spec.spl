# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





use std.spec.step

use app.search.main.{parse_limit_or_default}

describe "search limit guard":
    # @manual scenario evidence
    it "accepts positive numeric limits and falls back to 20 on malformed values":
        # @req REQ-SSPEC-APP
        step("accepts positive numeric limits and falls back to 20 on malformed values")
        expect(parse_limit_or_default("25")).to_equal(25)
        expect(parse_limit_or_default("1")).to_equal(1)
        expect(parse_limit_or_default("")).to_equal(20)
        expect(parse_limit_or_default("abc")).to_equal(20)
        expect(parse_limit_or_default("12x")).to_equal(20)
        expect(parse_limit_or_default("-5")).to_equal(20)
        expect(parse_limit_or_default("0")).to_equal(20)
        expect(parse_limit_or_default("1e3")).to_equal(20)
