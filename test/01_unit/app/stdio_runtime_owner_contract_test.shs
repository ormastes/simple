#!/bin/sh
set -eu

repl=${1:-}
kernel=${2:-}
if [ ! -x "$repl" ] || [ ! -x "$kernel" ]; then
    echo "usage: $0 <repl-binary> <kernel-binary>" >&2
    exit 2
fi

for artifact in "$repl" "$kernel"; do
    if nm -u "$artifact" | grep -Eq '(^|[[:space:]])(input|stdout_write)$'; then
        echo "FAIL: stale unowned stdio ABI in $artifact" >&2
        exit 1
    fi
    nm "$artifact" | grep -Eq '[[:space:]]T[[:space:]]rt_stdin_read_line_text$'
    nm "$artifact" | grep -Eq '[[:space:]]T[[:space:]]rt_stdout_write$'
done

printf ':quit\n' | timeout 2 "$repl" >/dev/null
timeout 2 "$kernel" </dev/null >/dev/null
echo "PASS: canonical runtime stdio ABI and behavior"
