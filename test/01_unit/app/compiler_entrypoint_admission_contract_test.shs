#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
adapter="$root/src/app/compiler_entrypoint/admission.spl"
events="$root/src/app/compiler_entrypoint/inventory_events.spl"
cli="$root/src/app/cli/_CliMain/main_and_help.spl"
mcp="$root/src/app/mcp/main.spl"
lsp="$root/src/app/simple_lsp_mcp/main.spl"
lsp_tools="$root/src/app/simple_lsp_mcp/tools.spl"
check="$root/src/app/cli/check.spl"
run="$root/src/app/io/_CliCommands/handler_commands.spl"
query="$root/src/app/cli/query_rich_common.spl"

grep -q 'package-index-scv-binding-mismatch' "$adapter"
grep -q 'SIMPLE_SCV_REVISION_ID' "$adapter"
grep -q 'SIMPLE_PACKAGE_INDEX_DIGEST' "$adapter"
grep -q 'compiler_inventory_refresh_v1' "$adapter"
grep -q 'SIMPLE_SCV_INVENTORY_GENERATION' "$adapter"
grep -q 'compile-event-journal-missing' "$events"
grep -q 'SIMPLE_SCV_INVENTORY_COLD_INIT' "$adapter"
grep -q 'compile_source_inventory_apply_git_changes_v1' "$events"
grep -q 'compile_source_inventory_apply_filesystem_events_v1' "$events"
grep -q 'git.*--no-optional-locks' "$events"
grep -q 'inventory_generation=' "$events"
! grep -Eq 'git (add|commit|checkout|reset|update-index)|jj ' "$events"
grep -q 'str_eq(args\[0\], "native-build")' "$cli"
grep -q 'str_eq(args\[0\], "check")' "$cli"
grep -q 'str_eq(args\[0\], "build")' "$cli"
grep -q 'str_eq(args\[0\], "run")' "$cli"
grep -q 'compiler_entrypoint_admit_v1' "$mcp"
grep -q 'compiler_entrypoint_admit_v1' "$lsp"
grep -q 'compiler_entrypoint_frozen_env_path_v1(arg)' "$check"
grep -q 'cli_run_file(frozen_program' "$run"
grep -q '\["check", frozen_file\]' "$lsp_tools"
grep -q 'file_mmap_read_text(frozen_path)' "$query"
! grep -Eq 'git (add|commit|checkout|reset)|jj |dir_walk|recursive' "$adapter"

printf '%s\n' 'compiler entrypoint immutable admission contract: PASS'
