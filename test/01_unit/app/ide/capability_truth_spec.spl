"""
## Purpose and audience
Purpose: Prove that capability truth: live state against the real extension kernel.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-IDE-001 — stable requirement identity for this spec.

# Capability truth spec (IDE extension kernel campaign, lane L7).
#
# Proves `app.ide.capabilities` computes `state` against the REAL extension
# kernel rather than declaring it: a capability backed by a builtin manifest
# (markdown) reaches "activatable" through the real lazy-activation path, a
# fabricated capability id that no builtin backs stays at "declared", and the
# plugin registry's SDN-backed decoder (`app.plugin.registry`) reproduces the
# same PluginEntry shape the old hand-rolled parser produced.
#
# "bound" requires a real CommandRegistry handler contributed by the
# extension itself -- this spec used to self-register a probe handler and
# then check that the probe's own write succeeded, which made "bound"
# unfalsifiable (see
# doc/08_tracking/bug/builtin_extensions_activate_eagerly_2026-07-30.md
# "CRITICAL"). `_ide_capability_with_live_state` no longer writes anything;
# it only reads `host.command_handler_registered(command_id)`. Exactly two
# builtins register a real handler on the host `ide_capabilities_live()`
# builds today -- markdown (five handlers) and sheets (one,
# `sheets.function.double`, added 2026-07-31 over the extension's
# already-existing DOUBLE evaluator) -- so those two reach "bound" and every
# other capability's honest ceiling is "activatable" or below.

use std.spec.{describe, it, expect}
use app.ide.capabilities.{ide_capability_new, ide_capabilities_live, ide_capability_live_state}
use app.ide.feature_report.{ide_capability_truth_report}
use std.editor.extensions.host.{extension_host_with_builtin_handlers}
use app.plugin.registry.{parse_plugin_manifest_text, plugin_manifest_to_text, plugin_entry_new, plugin_entry_new_with_classes}

describe "capability truth: live state against the real extension kernel":

    it "the markdown capability reaches 'bound' through a real contributed handler":
        step("Verify: the markdown capability reaches 'bound' through a real contributed handler")
        # @req: REQ-APP-IDE-001
        # markdown ships five actual CommandRegistry handlers
        # (md_toggle_bold_handler and friends, registered in
        # extension_host_with_builtin_handlers). feature_check must name the
        # command that genuinely has the handler -- NOT md.preview, which is
        # merely first in the manifest and has no handler at all. Asserting
        # the specific id is what distinguishes "we found a real handler"
        # from "we probed index 0 and got lucky".
        var markdown_state = ""
        var markdown_check = ""
        for cap in ide_capabilities_live():
            if cap.id == "markdown":
                markdown_state = cap.state
                markdown_check = cap.feature_check
        expect(markdown_state).to_equal("bound")
        expect(markdown_check).to_equal("markdown.toggle_bold")

    it "a fabricated capability id with no builtin backing stays 'declared'":
        step("Verify: a fabricated capability id with no builtin backing stays 'declared'")
        val fake = ide_capability_new(
            "totally-made-up-capability",
            "Not Real",
            "nonexistent-kind",
            "std.nowhere.nothing",
            ["zzz-no-such-tag", "another-fake-tag"],
            ""
        )
        val live = ide_capability_live_state(fake)
        expect(live.state).to_equal("declared")
        expect(live.feature_check).to_equal("totally.made.up.capability.smoke")

    it "every live capability has a non-empty probed feature_check id":
        step("Verify: every live capability has a non-empty probed feature_check id")
        var all_non_empty = true
        for cap in ide_capabilities_live():
            if cap.feature_check == "":
                all_non_empty = false
        expect(all_non_empty).to_equal(true)

    it "sheets reaches 'bound' too, and exactly two capabilities do":
        step("Verify: sheets reaches 'bound' too, and exactly two capabilities do")
        # sheets-function-registry-demo matches the "sheets" capability's
        # xlsx/csv compat tags and declares its own command id as an
        # activation event, so sheets clears "indexed" and "activatable".
        # It now also clears "bound": `sheets.function.double` got a real
        # dispatch handler (sheets_function_double_handler) on 2026-07-31,
        # binding the DOUBLE evaluator the extension already published into
        # the sheet function registry. The next `it` proves that handler
        # actually computes, so this is a genuine promotion, not a stub.
        #
        # Counting the whole bound set (not just checking sheets) is the
        # regression guard against the self-probe bug reappearing: its
        # signature was EVERY capability reporting bound at once. This count
        # is deliberately EXACT -- raise it when a capability honestly gains
        # a handler, never relax it to `>=` and never delete it. A count of
        # exactly 2 fails both if the self-probe returns and if the census
        # loses sight of the editor's real host.
        var sheets_state = ""
        var sheets_check = ""
        var bound_count = 0
        for cap in ide_capabilities_live():
            if cap.id == "sheets":
                sheets_state = cap.state
                sheets_check = cap.feature_check
            if cap.state == "bound":
                bound_count = bound_count + 1
        expect(sheets_state).to_equal("bound")
        expect(sheets_check).to_equal("sheets.function.double")
        expect(bound_count).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "the sheets handler that earned 'bound' really computes DOUBLE(n)":
        step("Verify: the sheets handler that earned 'bound' really computes DOUBLE(n)")
        # The honesty check for the promotion above: dispatch the command on
        # the same host the census inspects and require the real answer. A
        # do-nothing handler would still flip the census to "bound" -- it
        # could not return 42 here.
        val host = extension_host_with_builtin_handlers()
        var doubled = ""
        match host.dispatch_command("sheets.function.double", "21"):
            case Ok(value):
                doubled = value
            case Err(reason):
                doubled = "ERR: " + reason
        expect(doubled).to_equal("42")

    it "the feature_report capability-truth render shows the honest ceiling, never a self-probed 'bound'":
        step("Verify: the feature_report capability-truth render shows the honest ceiling, never a self-probed 'bound'")
        # The old self-probe left its own title string ("capability truth
        # probe: ...") in the registry it then read back. Its absence is the
        # direct evidence that nothing here writes the handler it measures --
        # a sharper guard than counting bound states, which a future real
        # handler is allowed to change.
        val report = ide_capability_truth_report().join("\n")
        expect(report).to_contain("capability-truth:")
        expect(report).to_contain("markdown: state=bound check=markdown.toggle_bold")
        expect(report).to_contain("sheets: state=bound check=sheets.function.double")
        expect(report).to_not_contain("capability truth probe")

    # Lane F5 (remaining builtin manifests): draw-sdd, designer, base, math,
    # mail, planner, agent-dashboard, and db-admin each now have a builtin
    # manifest (src/lib/editor/extensions/builtin/*_ext.spl, registered in
    # builtin/index.spl) whose contributes_languages matches one of the
    # capability's own compatible_with tags -- so each moves off "declared"
    # (forward change from the pre-F5 baseline, where all eight had no
    # builtin backing them at all).
    it "every F5-backed capability (draw-sdd/designer/base/math/mail/planner/agent-dashboard/db-admin) reaches at least 'indexed'":
        step("Verify: every F5-backed capability (draw-sdd/designer/base/math/mail/planner/agent-dashboard/db-admin) reaches at least 'indexed'")
        val backed_ids = ["draw-sdd", "designer", "base", "math", "mail", "planner", "agent-dashboard", "db-admin"]
        val below_indexed = ["declared"]
        var failures: [text] = []
        for cap in ide_capabilities_live():
            for wanted in backed_ids:
                if cap.id == wanted:
                    var is_below = false
                    for lo in below_indexed:
                        if cap.state == lo:
                            is_below = true
                    if is_below:
                        failures.push(cap.id + "=" + cap.state)
        expect(failures.join(",")).to_equal("")

    it "the F5-backed capabilities all report a non-empty feature_check command id":
        step("Verify: the F5-backed capabilities all report a non-empty feature_check command id")
        val backed_ids = ["draw-sdd", "designer", "base", "math", "mail", "planner", "agent-dashboard", "db-admin"]
        var failures: [text] = []
        for cap in ide_capabilities_live():
            for wanted in backed_ids:
                if cap.id == wanted and cap.feature_check == "":
                    failures.push(cap.id)
        expect(failures.join(",")).to_equal("")

describe "plugin registry: SDN-backed decoder matches the documented on-disk shape":

    it "decodes name/library/version/functions the same way the old parser did":
        step("Verify: decodes name/library/version/functions the same way the old parser did")
        val entries = parse_plugin_manifest_text(
            "plugins:\n" +
            "    -\n" +
            "        name: regex\n" +
            "        library: /tmp/libsimple_regex_ffi.so\n" +
            "        version: \"0.1.0\"\n" +
            "        functions: [rt_regex_new, rt_regex_destroy]\n"
        )
        expect(entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[0].name).to_equal("regex")
        expect(entries[0].library).to_equal("/tmp/libsimple_regex_ffi.so")
        expect(entries[0].version).to_equal("0.1.0")
        expect(entries[0].functions.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(entries[0].functions[0]).to_equal("rt_regex_new")
        expect(entries[0].functions[1]).to_equal("rt_regex_destroy")

    it "decodes nested classes/methods the same way the old parser did (golden fixture)":
        step("Verify: decodes nested classes/methods the same way the old parser did (golden fixture)")
        val entries = parse_plugin_manifest_text(
            "plugins:\n" +
            "    -\n" +
            "        name: regex\n" +
            "        library: /tmp/libsimple_regex_ffi.so\n" +
            "        version: \"0.1.0\"\n" +
            "        functions: [rt_regex_new, rt_regex_destroy]\n" +
            "    -\n" +
            "        name: shapes\n" +
            "        library: /tmp/libsimple_shapes_ffi.so\n" +
            "        version: \"0.3.0\"\n" +
            "        functions: [rt_shape_area]\n" +
            "        classes:\n" +
            "            Circle:\n" +
            "                constructor: rt_circle_new\n" +
            "                destructor: rt_circle_free\n" +
            "                methods:\n" +
            "                    area:\n" +
            "                        symbol: rt_circle_area\n" +
            "                        params: [radius]\n" +
            "                        return: f64\n"
        )
        expect(entries.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(entries[1].name).to_equal("shapes")
        expect(entries[1].classes.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[1].classes[0].name).to_equal("Circle")
        expect(entries[1].classes[0].constructor_symbol).to_equal("rt_circle_new")
        expect(entries[1].classes[0].destructor_symbol).to_equal("rt_circle_free")
        expect(entries[1].classes[0].methods.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[1].classes[0].methods[0].name).to_equal("area")
        expect(entries[1].classes[0].methods[0].symbol).to_equal("rt_circle_area")
        expect(entries[1].classes[0].methods[0].params.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(entries[1].classes[0].methods[0].params[0]).to_equal("radius")
        expect(entries[1].classes[0].methods[0].return_type).to_equal("f64")

    it "round-trips a constructed manifest through render + the SDN decoder unchanged":
        step("Verify: round-trips a constructed manifest through render + the SDN decoder unchanged")
        val original = [
            plugin_entry_new("http", "/tmp/libsimple_http_ffi.so", "0.2.0", ["rt_http_get", "rt_http_post"]),
            plugin_entry_new_with_classes("widgets", "/tmp/libsimple_widgets.so", "1.0.0", [], [])
        ]
        val rendered = plugin_manifest_to_text(original)
        val parsed = parse_plugin_manifest_text(rendered)
        expect(parsed.len()).to_equal(original.len())
        expect(parsed[0].name).to_equal(original[0].name)
        expect(parsed[0].library).to_equal(original[0].library)
        expect(parsed[0].version).to_equal(original[0].version)
        expect(parsed[0].functions.len()).to_equal(original[0].functions.len())
        expect(parsed[1].name).to_equal(original[1].name)
