# Purpose and audience: the IDE shell path publishes the real focused pane into caret context keys, for the caret team.
# @req CU-006

use std.spec.*
use std.editor.core.session.{EditSession}
use app.editor.editor_controller.{EditorController}
use app.editor.profile_plan.{profile_sync_context, shell_key_focus}
use app.llm_caret.workbench.key_resolver.{KeyFocus}
use app.llm_caret.workbench.session_source.{live_focus, clear_live_sessions}

fn _ctrl() -> EditorController:
    var session = EditSession.new()
    session.open_empty()
    EditorController.new(session)

describe "shell focus publish":
    it "derives focus from the controller and publishes it before syncing keys":
        clear_live_sessions()
        val ctrl = _ctrl()
        ctrl.focus_panel = "terminal"
        expect(shell_key_focus(ctrl)).to_equal(KeyFocus.TerminalSurface)
        profile_sync_context(ctrl, "caret")
        expect(ctrl.extension_host.context_keys).to_equal(["caret.focus.terminal"])
        expect(live_focus()).to_equal(KeyFocus.TerminalSurface)
        ctrl.focus_panel = "editor"
        profile_sync_context(ctrl, "caret")
        expect(ctrl.extension_host.context_keys).to_equal(["caret.focus.native"])
