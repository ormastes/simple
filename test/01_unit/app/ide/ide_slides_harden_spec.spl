# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# IDE slides_compat hardening spec.
#
# Verifies that an empty presentation does not crash any slides_compat probe.

use std.spec.step

use std.spec
use std.spec.step
use app.ide.slides_compat.{ide_slide_compat_probe, ide_slide_compat_probe_empty}


describe "slides_compat: empty presentation does not crash":
    # @manual scenario evidence

    it "empty presentation probe returns non-negative slide count":
        # @req REQ-SSPEC-UNIT
        step("empty presentation probe returns non-negative slide count")
        val probe = ide_slide_compat_probe_empty()
        expect(probe.slide_count >= 0).to_equal(true)

    it "empty presentation outline_line_count is non-negative":
        # @req REQ-SSPEC-UNIT
        step("empty presentation outline_line_count is non-negative")
        val probe = ide_slide_compat_probe_empty()
        expect(probe.outline_line_count >= 0).to_equal(true)

    it "empty presentation design_count is non-negative":
        # @req REQ-SSPEC-UNIT
        step("empty presentation design_count is non-negative")
        val probe = ide_slide_compat_probe_empty()
        expect(probe.design_count >= 0).to_equal(true)

    it "sample presentation has at least one slide":
        # @req REQ-SSPEC-UNIT
        step("sample presentation has at least one slide")
        val probe = ide_slide_compat_probe()
        expect(probe.slide_count > 0).to_equal(true)

    it "sample presentation thumbnail is non-empty":
        # @req REQ-SSPEC-UNIT
        step("sample presentation thumbnail is non-empty")
        val probe = ide_slide_compat_probe()
        expect(probe.thumbnail.len() > 0).to_equal(true)
