# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# @cover src/app/ide/markdown_render.spl 20%
# @cover src/app/ide/feature_report.spl 20%
#
# Regression for doc/08_tracking/bug/ide_markdown_summary_width_rewound_by_merge_2026-11-22.md:
# merge e274cd33719 restored the long `preview=/heading=/html_heading=` keys,
# which pushed the `check: markdown:` row to 127 columns and dropped `prev=`.

use std.spec.*
use app.ide.markdown_render.{ide_markdown_render_summary}
use app.ide.feature_report.{ide_feature_check_report}

fn _widest(lines: [text]) -> i64:
    var widest = 0
    for line in lines:
        if line.len() > widest:
            widest = line.len()
    widest

describe "IDE feature-check rows fit a 120-column terminal":
    """
    A developer runs `simple ide --feature-check --tui` in a 120-column
    terminal and every report row stays readable without wrapping.
    """

    it "keeps the markdown summary abbreviated with the prev= key":
        # @req REQ-SSPEC-APP
        step("Render the markdown capability summary")
        val summary = ide_markdown_render_summary()
        expect(summary).to_contain(" prev=")
        expect(summary).to_contain(" head=")
        expect(summary).to_contain(" html_head=")
        step("The summary plus the report's `  check: ` prefix fits 120 columns")
        expect(summary.len() + 9).to_be_less_than(121)

    it "keeps every TUI and GUI feature-check row within 120 columns":
        # @req REQ-SSPEC-APP
        step("Render both feature-check reports and measure the widest row")
        expect(_widest(ide_feature_check_report("tui"))).to_be_less_than(121)
        expect(_widest(ide_feature_check_report("gui"))).to_be_less_than(121)
