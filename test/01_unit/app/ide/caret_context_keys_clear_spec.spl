# Purpose and audience: leaving the caret profile must clear caret.* context keys, for the caret team.
# @req CU-006

use std.spec.*
use std.editor.core.session.{EditSession}
use app.editor.editor_controller.{EditorController}
use app.editor.profile_plan.{profile_sync_context_with}
use app.llm_caret.workbench.key_resolver.{KeyFocus}

fn _ctrl() -> EditorController:
    var session = EditSession.new()
    session.open_empty()
    EditorController.new(session)

describe "profile switch away from caret":
    it "clears caret.* keys but keeps others":
        val ctrl = _ctrl()
        profile_sync_context_with(ctrl, "caret", KeyFocus.TerminalSurface, "claude")
        expect(ctrl.extension_host.context_keys).to_equal(["caret.focus.terminal", "caret.session.claude"])
        ctrl.extension_host.set_context_keys(ctrl.extension_host.context_keys + ["x"])
        profile_sync_context_with(ctrl, "editor", KeyFocus.NativeView, "")
        expect(ctrl.extension_host.context_keys).to_equal(["x"])
