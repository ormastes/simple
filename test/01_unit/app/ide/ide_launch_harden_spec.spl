# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# IDE launch sanity hardening spec.
#
# Verifies that empty argv and unknown options are handled gracefully.

use std.spec.step

use std.spec
use std.spec.step
use app.ide.launch_sanity.{ide_launch_sanity, ide_launch_empty_argv_safe, ide_launch_unknown_only}


describe "launch_sanity: empty argv and unknown option handling":
    # @manual scenario evidence

    it "empty argv parse does not crash":
        # @req REQ-SSPEC-UNIT
        step("empty argv parse does not crash")
        expect(ide_launch_empty_argv_safe()).to_equal(true)

    it "unknown-only flag populates unknown_option not mode":
        # @req REQ-SSPEC-UNIT
        step("unknown-only flag populates unknown_option not mode")
        expect(ide_launch_unknown_only()).to_equal(true)

    it "launch sanity tui mode is non-empty":
        # @req REQ-SSPEC-UNIT
        step("launch sanity tui mode is non-empty")
        val sanity = ide_launch_sanity()
        expect(sanity.tui_mode.len() > 0).to_equal(true)

    it "launch sanity bad mode populates unknown_option":
        # @req REQ-SSPEC-UNIT
        step("launch sanity bad mode populates unknown_option")
        val sanity = ide_launch_sanity()
        expect(sanity.unknown_option.len() > 0).to_equal(true)

    it "launch sanity file_count is non-negative":
        # @req REQ-SSPEC-UNIT
        step("launch sanity file_count is non-negative")
        val sanity = ide_launch_sanity()
        expect(sanity.file_count >= 0).to_equal(true)
