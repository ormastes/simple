# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/app/llm_caret/caret_suite_ide_workbench_smux_migration_2026-09-05.md



# IDE --profile launch-routing spec (CARET-H002 / A1).
#
# Verifies the shared launch parser understands --profile, and that the
# profile actually narrows which builtin extensions the GUI shell activates
# (editor keeps the original unconditional activation; caret narrows it so
# starting a Caret session does not also stand up every IDE application's
# language/extension surface). This does not open a real GUI window — it
# constructs the shell state and inspects extension-activation state, the
# same seam gui_shell_run/gui_shell_run_sdl route through before entering
# their event loop.

use std.spec.step

use std.spec
use std.spec.step
use std.editor.core.launch.{editor_launch_parse}
use std.editor.core.session.{EditSession}
use std.editor.backend.gui_backend.{gui_backend_default_config}
use std.editor.common.platform.{platform_default_config, EditorPlatform}
use app.editor.editor_controller.{EditorController}
use app.editor.gui_shell.{gui_shell_new, gui_shell_apply_profile}


describe "ide profile launch: --profile parsing and extension narrowing":
    # @manual scenario evidence

    it "parses --profile <name> without disturbing mode or files":
        # @req REQ-SSPEC-UNIT
        step("parses --profile <name> without disturbing mode or files")
        val launch = editor_launch_parse(["--gui", "--profile", "caret", "notes.md"])
        expect(launch.mode).to_equal("gui")
        expect(launch.profile).to_equal("caret")
        expect(launch.files.len()).to_equal(1)

    it "parses --profile=<name> form":
        # @req REQ-SSPEC-UNIT
        step("parses --profile=<name> form")
        val launch = editor_launch_parse(["--tui", "--profile=editor", "a.spl"])
        expect(launch.profile).to_equal("editor")

    it "defaults profile to editor when unset":
        # @req REQ-SSPEC-UNIT
        step("defaults profile to editor when unset")
        val launch = editor_launch_parse(["--tui"])
        expect(launch.profile).to_equal("editor")

    it "editor profile activates simple-language and markdown-language":
        # @req REQ-SSPEC-UNIT
        step("editor profile activates simple-language and markdown-language")
        var session = EditSession.new()
        session.open_empty()
        val state = gui_shell_new(session)
        gui_shell_apply_profile(state, "editor")
        expect(state.ctrl.extension_host.is_active("simple-language")).to_equal(true)
        expect(state.ctrl.extension_host.is_active("markdown-language")).to_equal(true)

    it "caret profile activates simple-language but NOT markdown-language":
        # @req REQ-SSPEC-UNIT
        step("caret profile activates simple-language but NOT markdown-language")
        var session = EditSession.new()
        session.open_empty()
        val state = gui_shell_new(session)
        gui_shell_apply_profile(state, "caret")
        expect(state.ctrl.extension_host.is_active("simple-language")).to_equal(true)
        expect(state.ctrl.extension_host.is_active("markdown-language")).to_equal(false)
