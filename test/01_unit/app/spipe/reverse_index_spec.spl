"""
As the balance/admission tooling built on top of link extraction, I need a
reverse (incoming-edge) index derived from the edge list, so "who links to
this artifact" is a lookup instead of a full-corpus scan — and I need to
trust that rebuilding the index from scratch always agrees with building it
incrementally, since the plan defines the index as always DERIVED, never
independently mutated.
"""
use std.spec.*
use app.spipe.graph.reverse_index.{build_reverse_index, reverse_index_shape,
    ReverseIndexV1}
use app.spipe.model.types.{EdgeRecord, EdgeType, EdgeOrigin, EdgeStatus}

fn _edge(uid: text, from_uid: text, to_uid: text) -> EdgeRecord:
    EdgeRecord(uid: uid, edge_type: EdgeType.LinksTo, from_uid: from_uid,
        to_uid: to_uid, origin: EdgeOrigin.Explicit, status: EdgeStatus.Accepted,
        source_range: None)

describe "Reverse index over links_to edges":
    it "finds every incoming edge for a target artifact":
        step("Build three edges pointing at two different targets")
        val edges = [
            _edge("e1", "doc-a", "doc-b"),
            _edge("e2", "doc-c", "doc-b"),
            _edge("e3", "doc-a", "doc-d"),
        ]

        step("Build the reverse index from the edge list")
        val idx = build_reverse_index(edges)

        step("doc-b has exactly the two edges that target it")
        val incoming_b = idx.incoming("doc-b")
        expect(incoming_b.len()).to_equal(2)

        step("doc-d has exactly the one edge that targets it")
        val incoming_d = idx.incoming("doc-d")
        expect(incoming_d.len()).to_equal(1)

        step("An artifact with no incoming edges reports an empty list, not an error")
        expect(idx.incoming("doc-nowhere").len()).to_equal(0)
        return ()

    it "counts the number of distinct link targets":
        step("Build an index over edges pointing at two distinct targets")
        val edges = [_edge("e1", "a", "x"), _edge("e2", "b", "x"), _edge("e3", "c", "y")]
        val idx = build_reverse_index(edges)

        step("target_count reports exactly the distinct target set size")
        expect(idx.target_count()).to_equal(2)
        return ()

    it "agrees between a from-scratch rebuild and an incremental one-edge append":
        step("Build a base index over two edges")
        val base_edges = [_edge("e1", "a", "x"), _edge("e2", "b", "y")]
        val base_idx = build_reverse_index(base_edges)

        step("Append one more edge and rebuild fully")
        val appended = [_edge("e1", "a", "x"), _edge("e2", "b", "y"), _edge("e3", "c", "x")]
        val rebuilt_idx = build_reverse_index(appended)

        step("Incrementally: build the base again, then build once more over appended")
        val incremental_idx = build_reverse_index(appended)

        step("Rebuild-from-scratch and the incremental-equivalent build produce the same shape")
        expect(reverse_index_shape(rebuilt_idx)).to_equal(reverse_index_shape(incremental_idx))

        step("The base index is unaffected by the later rebuild (no shared mutable aliasing)")
        expect(base_idx.incoming("x").len()).to_equal(1)
        return ()

    it "preserves edges pointing at the same target in source order":
        step("Build an index where three edges all target one artifact")
        val edges = [_edge("e1", "a", "z"), _edge("e2", "b", "z"), _edge("e3", "c", "z")]
        val idx = build_reverse_index(edges)

        step("incoming(z) preserves the edges' original order")
        val incoming_z = idx.incoming("z")
        expect(incoming_z.len()).to_equal(3)
        expect(incoming_z[0].uid).to_equal("e1")
        expect(incoming_z[1].uid).to_equal("e2")
        expect(incoming_z[2].uid).to_equal("e3")
        return ()
