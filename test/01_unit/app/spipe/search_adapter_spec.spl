use std.spec
use app.spipe.search.adapter.{AdapterStateV1, ProviderHandshakeV1, required_handshake_v1, validate_handshake_v1}
use app.spipe.search.in_process_adapter.{InProcessSearchProviderAdapter}
use lib.common.search.provider.{
    SearchProvider, SearchCapabilities, SearchStatsV1, CancelResultV1,
    ShutdownResultV1,
}
use lib.common.search.snapshot.{
    SearchSnapshot, IndexApplyRequestV1, IndexCandidateV1, IndexPublishRequestV1,
    IndexPublishResultV1,
}
use lib.common.search.query.{SearchQuery}
use lib.common.search.top_k.{SearchPageV1}
use lib.common.search.document.{SearchHit}
use lib.common.search.explain.{SearchExplanation}
use lib.common.search.types.{Score}

# A mock `SearchProvider` standing in for the P2 index engine. Only `search`
# is exercised by this adapter; every other method is an intentionally inert
# stub since the adapter never calls them.
class MockSearchProvider:
    var next_hits: [SearchHit]
    var next_logical_root: text
    var fail: bool

impl SearchProvider for MockSearchProvider:
    fn capabilities() -> SearchCapabilities:
        SearchCapabilities.bm25_v1()

    fn index_open(mode: text, logical_root: text?, scope_digest: text) -> Result<SearchSnapshot, text>:
        Err("not_implemented")

    fn index_apply(request: IndexApplyRequestV1, scope_digest: text) -> Result<IndexCandidateV1, text>:
        Err("not_implemented")

    fn index_publish(request: IndexPublishRequestV1, scope_digest: text) -> Result<IndexPublishResultV1, text>:
        Err("not_implemented")

    fn search(snapshot_id: text, scope_digest: text, query: SearchQuery) -> Result<SearchPageV1, text>:
        if self.fail:
            Err("mock_provider_failure")
        else:
            Ok(SearchPageV1.of(self.next_logical_root, self.next_hits, nil, true))

    fn explain_document(snapshot_id: text, scope_digest: text, document_id: text, query: SearchQuery) -> Result<SearchExplanation, text>:
        Err("not_implemented")

    fn stats(logical_root: text, scope_digest: text) -> Result<SearchStatsV1, text>:
        Err("not_implemented")

    fn cancel(target_request_id: text) -> Result<CancelResultV1, text>:
        Err("not_implemented")

    fn shutdown(reason: text) -> Result<ShutdownResultV1, text>:
        Err("not_implemented")

fn valid_query() -> SearchQuery:
    SearchQuery.of("hello", [], 10, "", false)

describe "P5 SearchProviderAdapter — handshake, boundary, state machine":
    it "starts in the New state before any handshake":
        step("A freshly constructed adapter has not yet initialized")
        val provider = MockSearchProvider(next_hits: [], next_logical_root: "root-1", fail: false)
        val adapter = InProcessSearchProviderAdapter.new(provider)
        expect(adapter.state().name()).to_equal("new")

    it "moves to Healthy on a handshake that matches every required contract id":
        step("Offer the exact required handshake")
        val provider = MockSearchProvider(next_hits: [], next_logical_root: "root-1", fail: false)
        var adapter = InProcessSearchProviderAdapter.new(provider)
        val result = adapter.handshake(required_handshake_v1())
        match result:
            Ok(ok): expect(ok).to_equal(true)
            Err(_): expect(true).to_equal(false)
        expect(adapter.state().name()).to_equal("healthy")

    it "fails closed when the provider offers a mismatched score contract id":
        step("Injected bug: provider disagrees on the score contract")
        val required = required_handshake_v1()
        val offered = ProviderHandshakeV1.of(required.analyzer_contract_id, "bm25-fixed-v2-rogue", required.explanation_contract_id, required.logical_index_contract_id, required.provider_version)
        val result = validate_handshake_v1(offered, required)
        match result:
            Err(e): expect(e.code).to_equal("handshake_contract_mismatch")
            Ok(_): expect(true).to_equal(false)

    it "fails closed and goes Unavailable when the provider offers a mismatched analyzer contract id":
        step("Injected bug: provider disagrees on the analyzer contract")
        val provider = MockSearchProvider(next_hits: [], next_logical_root: "root-1", fail: false)
        var adapter = InProcessSearchProviderAdapter.new(provider)
        val required = required_handshake_v1()
        val rogue = ProviderHandshakeV1.of("spipe-unicode-lex-v2-rogue", required.score_contract_id, required.explanation_contract_id, required.logical_index_contract_id, required.provider_version)
        val result = adapter.handshake(rogue)
        match result:
            Err(e): expect(e.code).to_equal("handshake_contract_mismatch")
            Ok(_): expect(true).to_equal(false)
        expect(adapter.state().name()).to_equal("unavailable")

    it "rejects a search before the handshake has completed":
        step("An adapter in the New state must reject search")
        val provider = MockSearchProvider(next_hits: [], next_logical_root: "root-1", fail: false)
        var adapter = InProcessSearchProviderAdapter.new(provider)
        val result = adapter.search("snap-1", "sha256:" + "0".repeat(64), valid_query())
        match result:
            Err(e): expect(e.code).to_equal("adapter_not_healthy")
            Ok(_): expect(true).to_equal(false)

    it "returns a validated page once healthy":
        step("Healthy adapter forwards a well-formed page through")
        val good_hits = [SearchHit.of("doc-a", Score.from_milli(9000), 1)]
        val provider = MockSearchProvider(next_hits: good_hits, next_logical_root: "root-1", fail: false)
        var adapter = InProcessSearchProviderAdapter.new(provider)
        adapter.handshake(required_handshake_v1())?
        val ok_result = adapter.search("snap-1", "sha256:" + "0".repeat(64), valid_query())
        match ok_result:
            Ok(page): expect(page.hits.len()).to_equal(1)
            Err(_): expect(true).to_equal(false)

    it "quarantines the adapter on a poisoned response (duplicate rank)":
        step("A healthy adapter receiving a poisoned page rejects it and quarantines")
        val poisoned_hits = [
            SearchHit.of("doc-a", Score.from_milli(9000), 1),
            SearchHit.of("doc-b", Score.from_milli(5000), 1),
        ]
        val provider = MockSearchProvider(next_hits: poisoned_hits, next_logical_root: "root-1", fail: false)
        var adapter = InProcessSearchProviderAdapter.new(provider)
        adapter.handshake(required_handshake_v1())?
        val bad_result = adapter.search("snap-1", "sha256:" + "0".repeat(64), valid_query())
        match bad_result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)
        expect(adapter.state().name()).to_equal("quarantined")
