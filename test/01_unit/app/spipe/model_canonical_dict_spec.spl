"""
## Purpose and audience
Documents the sorted-key dict canonicalization in `app.spipe.model.canonical`
for engineers maintaining spipe_knowledge_compiler's cross-platform
determinism contract. S1-C originally shipped a SECOND "canonical bytes"
encoder inside balance/score.spl, because CanonicalValue had no object shape.
Two independent definitions of canonical bytes is how cross-platform
determinism diverges silently. CDict closed that gap and score.spl now
delegates here, so these are the tests that keep the one encoder honest.
## Operator workflow
bin/simple test test/01_unit/app/spipe/model_canonical_dict_spec.spl
## Compatibility and limitations
Runs under the pure-Simple interpreter test runner; no filesystem, network,
or platform-specific dependency.
## Verification guidance and troubleshooting
A failure here means CDict's key-sort order, byte encoding, or escaping
changed. Diff the expected JSON literal against a fresh `canonical_json(v)`
call before accepting a new literal into the assertion.
"""
# Lifecycle: doc/01_research/infra/spipe/spipe_knowledge_compiler.md ;
# doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md ;
# doc/04_architecture/infra/spipe/spipe_knowledge_compiler.md ;
# doc/05_design/infra/spipe/spipe_knowledge_compiler.md
# @manual_section: canonical-dict

use std.spec.{describe, it, expect}
use app.spipe.model.canonical.{CanonicalValue, canonical_json, canonical_bytes, cfield}

describe("spipe canonical dict"):
    it("emits object fields in sorted key order, not construction order"):
        # @req REQ-SPKC-039
        step("Build a CDict from fields inserted zulu, alpha, mike")
        val v = CanonicalValue.CDict([
            cfield("zulu", CanonicalValue.CInt(1)),
            cfield("alpha", CanonicalValue.CInt(2)),
            cfield("mike", CanonicalValue.CInt(3)),
        ])
        step("Render canonical JSON and check the field order")
        # @capture(protocol_json): canonical_json(v) rendered object text
        expect(canonical_json(v)).to_equal("{\"alpha\":2,\"mike\":3,\"zulu\":1}")

    it("is independent of construction order"):
        step("Build two dicts with the same two fields in opposite insertion order")
        val a = CanonicalValue.CDict([
            cfield("b", CanonicalValue.CText("2")),
            cfield("a", CanonicalValue.CText("1")),
        ])
        val b = CanonicalValue.CDict([
            cfield("a", CanonicalValue.CText("1")),
            cfield("b", CanonicalValue.CText("2")),
        ])
        step("Confirm both render byte-identical canonical JSON")
        # @capture(protocol_json): canonical_json(a) vs canonical_json(b)
        expect(canonical_json(a)).to_equal(canonical_json(b))

    it("sorts keys by BYTE order, so non-ASCII keys are stable"):
        # The keys differ only beyond ASCII; a char-oriented comparison can
        # order these differently than a byte-oriented one, which would make
        # output host-dependent.
        step("Build a CDict keyed by an ASCII key and a non-ASCII key")
        val v = CanonicalValue.CDict([
            cfield("é", CanonicalValue.CInt(2)),
            cfield("z", CanonicalValue.CInt(1)),
        ])
        step("Render canonical JSON and check byte-order placement")
        # "z" is 0x7A; "é" is 0xC3 0xA9 -- so "z" sorts first by bytes.
        # @capture(protocol_json): canonical_json(v) byte-ordered key sequence
        expect(canonical_json(v)).to_equal("{\"z\":1,\"é\":2}")

    it("round-trips non-ASCII values without corruption"):
        step("Build a CDict whose value mixes CJK text and an arrow glyph")
        val v = CanonicalValue.CDict([
            cfield("k", CanonicalValue.CText("日本語 — arrows → ok")),
        ])
        step("Render canonical JSON and confirm the bytes survive intact")
        # @capture(protocol_json): canonical_json(v) multibyte payload
        expect(canonical_json(v)).to_equal("{\"k\":\"日本語 — arrows → ok\"}")

    it("nests dicts and lists"):
        step("Build a CDict containing a CList that itself contains a nested CDict")
        val v = CanonicalValue.CDict([
            cfield("list", CanonicalValue.CList([
                CanonicalValue.CInt(1),
                CanonicalValue.CDict([cfield("x", CanonicalValue.CText("y"))]),
            ])),
            cfield("flat", CanonicalValue.CInt(0)),
        ])
        step("Render canonical JSON and check the nested structure prints correctly")
        # @capture(protocol_json): canonical_json(v) nested list/dict structure
        expect(canonical_json(v)).to_equal("{\"flat\":0,\"list\":[1,{\"x\":\"y\"}]}")

    it("escapes quotes in keys as well as values"):
        step("Build a CDict whose key and value both contain a double quote")
        val v = CanonicalValue.CDict([
            cfield("a\"b", CanonicalValue.CText("c\"d")),
        ])
        step("Render canonical JSON and check both quotes are escaped")
        # @capture(protocol_json): canonical_json(v) escaped quote text
        expect(canonical_json(v)).to_equal("{\"a\\\"b\":\"c\\\"d\"}")

    it("produces byte output matching its text output"):
        step("Build a single-field CDict and render it both as text and as bytes")
        val v = CanonicalValue.CDict([cfield("a", CanonicalValue.CInt(1))])
        step("Confirm canonical_bytes matches canonical_json's own byte encoding")
        # @capture(bit_table): canonical_bytes(v) vs canonical_json(v).bytes()
        expect(canonical_bytes(v)).to_equal(canonical_json(v).bytes())

    it("is stable across repeated emission"):
        step("Build a CDict mixing an int field and a non-ASCII text field")
        val v = CanonicalValue.CDict([
            cfield("n", CanonicalValue.CInt(7)),
            cfield("s", CanonicalValue.CText("é")),
        ])
        step("Render canonical JSON twice and confirm the two renders match")
        # @capture(protocol_json): two successive canonical_json(v) renders
        expect(canonical_json(v)).to_equal(canonical_json(v))

    return ()
