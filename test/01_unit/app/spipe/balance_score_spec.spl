"""
## Purpose and audience
Purpose: Prove the S1-C balance score engine (advisory) computes a
deterministic, int-tenths document-balance score from Cohesion, Trace path
alignment, Shape, and Axis coverage — the four components the refined plan
keeps for slice 1, renormalized 43/21/21/15.
Audience: compiler and tooling engineers maintaining `src/app/spipe/balance/`.

## Lifecycle
- Research: doc/01_research/infra/spipe/
- Plan: doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md (S1-C)
- Architecture: doc/04_architecture/infra/spipe/
- Design: doc/05_design/infra/spipe/ (if available)
"""

# @req: doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md §S1-C
# @manual_section: Component scoring and determinism

use std.spec.*
use std.spec.step
use app.spipe.balance.score_types.ScopeInput
use app.spipe.balance.score.{score_report, canonical_bytes, tenths_half_up, sorted_children, scope_text_less}

fn mk_scope(scope: text, eligible_weight: Int, cut_weight: Int, trace_total: Int, trace_aligned: Int,
        depth: Int, direct_docs: Int, child_dirs: Int, tiny_sibling_dirs: Int,
        axis_total: Int, axis_present: Int, children: [ScopeInput]) -> ScopeInput:
    ScopeInput(
        scope: scope,
        eligible_weight: eligible_weight,
        cut_weight: cut_weight,
        trace_total: trace_total,
        trace_aligned: trace_aligned,
        depth: depth,
        direct_docs: direct_docs,
        child_dirs: child_dirs,
        tiny_sibling_dirs: tiny_sibling_dirs,
        axis_total: axis_total,
        axis_present: axis_present,
        children: children
    )

fn good_scope(scope: text) -> ScopeInput:
    # Zero cut, fully aligned trace, comfortably inside every shape target
    # band, full axis coverage — every component should read raw=1000.
    mk_scope(scope, 100, 0, 10, 10, 2, 10, 4, 0, 4, 4, [])

fn bad_scope(scope: text) -> ScopeInput:
    # Half the eligible weight cut, half the trace links misaligned, every
    # shape metric well past its "strong candidate" threshold, half the axis
    # checks missing.
    mk_scope(scope, 100, 50, 10, 5, 6, 60, 30, 3, 4, 2, [])

fn find_deduction(report_deductions: [text], code: text) -> bool:
    var found = false
    for c in report_deductions:
        if c == code: found = true
    found

describe "S1-C balance score engine":

    describe "component scoring on a clean tree":

        it "scores every kept component at its full weight with no deductions":
            # @req REQ-SSPEC-BALANCE
            # @capture(statistics): component scores and total balance score
            step("Score a scope whose inputs sit inside every target band")
            val report = score_report(good_scope(""))

            step("Verify: score_tenths reaches the maximum (43+21+21+15) x 10 = 1000")
            expect(report.score_tenths).to_equal(1000)  # oracle: (43+21+21+15)*10 = 1000

            step("Verify: no deductions are emitted for a clean scope")
            expect(report.deductions.len()).to_equal(0)  # oracle: clean scope = zero deductions

            step("Verify: each component's raw score is a perfect 1000 per-mille")
            expect(report.components[0].raw_permille).to_equal(1000)  # oracle: perfect score
            expect(report.components[1].raw_permille).to_equal(1000)  # oracle: perfect score
            expect(report.components[2].raw_permille).to_equal(1000)  # oracle: perfect score
            expect(report.components[3].raw_permille).to_equal(1000)  # oracle: perfect score

        it "sums each scope's own deductions back to its component points (arithmetic identity)":
            # @capture(statistics): component deductions and arithmetic relationships
            step("Score a degraded scope")
            val report = score_report(bad_scope("doc/04_architecture/compiler"))

            step("Verify: cohesion component points_tenths equals weight*10 minus its deduction's points_tenths")
            val cohesion = report.components[0]
            val cohesion_ded = report.deductions[0]
            expect(cohesion.weight * 10 - cohesion_ded.points_tenths).to_equal(cohesion.points_tenths)

            step("Verify: score_tenths equals the sum of the four components' points_tenths")
            val summed = report.components[0].points_tenths + report.components[1].points_tenths +
                report.components[2].points_tenths + report.components[3].points_tenths
            expect(report.score_tenths).to_equal(summed)

        it "emits the reserved SPK51x diagnostic codes for a degraded scope":
            # @capture(protocol_json): diagnostic code identifiers
            step("Score a degraded scope with a shortfall on every component")
            val report = score_report(bad_scope("doc/04_architecture/compiler"))
            var codes: [text] = []
            for d in report.deductions:
                codes = codes + [d.code]

            step("Verify: cohesion/trace/shape/axis deductions use SPK511..SPK514")
            expect(find_deduction(codes, "SPK511")).to_be(true)
            expect(find_deduction(codes, "SPK512")).to_be(true)
            expect(find_deduction(codes, "SPK513")).to_be(true)
            expect(find_deduction(codes, "SPK514")).to_be(true)

        it "scores a well-organized tree strictly higher than a badly organized one":
            # @capture(statistics): comparative component scores
            step("Score both a good and a bad fixture at the same scope shape")
            val good = score_report(good_scope("doc"))
            val bad = score_report(bad_scope("doc"))

            step("Verify: good beats bad on total score")
            expect(good.score_tenths).to_be_greater_than(bad.score_tenths)

            step("Verify: good beats bad on every individual kept component")
            expect(good.components[0].points_tenths).to_be_greater_than(bad.components[0].points_tenths)
            expect(good.components[1].points_tenths).to_be_greater_than(bad.components[1].points_tenths)
            expect(good.components[2].points_tenths).to_be_greater_than(bad.components[2].points_tenths)
            expect(good.components[3].points_tenths).to_be_greater_than(bad.components[3].points_tenths)

    describe "recursive scopes":

        it "scores nested scopes depth-first, sorted by path":
            # @capture(statistics): nested child scores in path order
            step("Build a root scope with three children in a non-sorted input order")
            val root = mk_scope("", 100, 0, 10, 10, 1, 5, 2, 0, 2, 2, [
                good_scope("z_scope"),
                good_scope("a_scope"),
                good_scope("m_scope")
            ])
            val report = score_report(root)

            step("Verify: children come back path-sorted regardless of input order")
            expect(report.scopes.len()).to_equal(3)  # oracle: three inputs, three outputs
            expect(report.scopes[0].scope).to_equal("a_scope")  # oracle: lexical order
            expect(report.scopes[1].scope).to_equal("m_scope")
            expect(report.scopes[2].scope).to_equal("z_scope")

        it "breaks ties between genuinely identical scopes stably on path":
            # @capture(statistics): tie-break ordering by path
            step("Two children with byte-identical inputs, differing only by scope path")
            val root = mk_scope("", 100, 0, 10, 10, 1, 5, 2, 0, 2, 2, [
                bad_scope("beta"),
                bad_scope("alpha")
            ])
            val report = score_report(root)

            step("Verify: tie-break lands on the lexically smaller path first")
            expect(report.scopes[0].scope).to_equal("alpha")  # oracle: lexical tie-break
            expect(report.scopes[1].scope).to_equal("beta")   # oracle: lexical tie-break

            step("Verify: both tied children still produced identical scores")
            expect(report.scopes[0].score_tenths).to_equal(report.scopes[1].score_tenths)

        it "sorts children via the same byte-lexical comparator used for tie-breaks":
            # @capture(statistics): lexical comparison results
            step("Verify: scope_text_less is a real byte-lexical order, not identity")
            expect(scope_text_less("a", "b")).to_be(true)
            expect(scope_text_less("b", "a")).to_be(false)
            expect(scope_text_less("a", "a")).to_be(false)
            expect(scope_text_less("a", "ab")).to_be(true)

        it "keeps sorted_children a stable, pure reordering (no elements lost or duplicated)":
            # @capture(statistics): sorted children array ordering and cardinality
            step("Sort three children in random input order")
            val children = [good_scope("c"), good_scope("a"), good_scope("b")]
            val sorted = sorted_children(children)
            step("Verify: all three children are present and in sorted order")
            expect(sorted.len()).to_equal(3)  # oracle: three inputs, three outputs
            expect(sorted[0].scope).to_equal("a")
            expect(sorted[1].scope).to_equal("b")
            expect(sorted[2].scope).to_equal("c")

    describe "determinism":

        it "produces byte-identical canonical bytes across repeated computation":
            # @capture(bit_table): canonical byte sequence encoding and determinism
            step("Score the same non-trivial tree twice from independent inputs")
            val root_once = mk_scope("", 100, 20, 10, 7, 3, 20, 10, 1, 4, 3, [
                bad_scope("nested_b"),
                good_scope("nested_a")
            ])
            val root_twice = mk_scope("", 100, 20, 10, 7, 3, 20, 10, 1, 4, 3, [
                bad_scope("nested_b"),
                good_scope("nested_a")
            ])
            val first = canonical_bytes(score_report(root_once))
            val second = canonical_bytes(score_report(root_twice))

            step("Verify: the two canonical serializations are byte-identical")
            expect(first).to_equal(second)

            step("Verify: canonical bytes are non-trivial evidence, not an empty placeholder")
            expect(first.len()).to_be_greater_than(20)  # oracle: nonempty binary encoding

    describe "rounding arithmetic (weight * raw_permille / 100, half-up)":

        it "rounds .5 tenths up rather than truncating":
            # @capture(bit_table): rounding result and fixed-point arithmetic
            step("43 weight at 850 per-mille: 43*850/100 = 365.5 -> rounds to 366")
            expect(tenths_half_up(43, 850)).to_equal(366)  # oracle: 43*850/100 = 365.5, rounds half-up

        it "matches plain integer division when there is no fractional remainder":
            # @capture(bit_table): exact integer rounding result
            step("21 weight at 1000 per-mille: 21*1000/100 = 210 exactly")
            expect(tenths_half_up(21, 1000)).to_equal(210)  # oracle: 21*1000/100 = 210 exactly

