"""
As the SPipe fusion tier consuming §3.5.1's complete-pool v2 contract, I need
the graph source to recheck authorization per node against the live identity
registry, bind every contributing edge to the receipt that authorized it, and
hand back a single-use cursor so a caller can page through a large candidate
pool without re-running the traversal or ever double-serving/skipping a node.
"""
use std.spec.*
use app.spipe.fusion.graph_source.{build_graph_ranking_v2, resume_graph_page_v2,
    GraphSourceErrorV1}
use app.spipe.model.types.{EdgeRecord, EdgeType, EdgeOrigin, EdgeStatus}
use app.spipe.identity.registry.{IdentityRegistryV1, IdentityRecordV1}

fn _accepted(uid: text, from_uid: text, to_uid: text) -> EdgeRecord:
    EdgeRecord(uid: uid, edge_type: EdgeType.LinksTo, from_uid: from_uid,
        to_uid: to_uid, origin: EdgeOrigin.Explicit, status: EdgeStatus.Accepted,
        source_range: None)

fn _rec(uid: text, authorized: bool) -> IdentityRecordV1:
    IdentityRecordV1(uid: uid, key: uid, aliases: [], authorized: authorized)

fn _registry(records: [IdentityRecordV1]) -> IdentityRegistryV1:
    IdentityRegistryV1(generation: 1, records: records)

fn _ids(candidates) -> [text]:
    var out: [text] = []
    var i = 0
    while i < candidates.len():
        out.push(candidates[i].document_id)
        i = i + 1
    out

describe "Graph fusion source v2: authorization, receipt evidence, cursor paging":

    it "excludes an unauthorized node from results and from the count":
        step("root -> blocked -> tail; 'blocked' is not authorized")
        val edges = [_accepted("e1", "root", "blocked"), _accepted("e2", "blocked", "tail")]
        val registry = _registry([_rec("root", true), _rec("blocked", false), _rec("tail", true)])
        val receipts: {text: text} = {"e1": "rcpt-1", "e2": "rcpt-2"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Neither 'blocked' nor 'tail' (only reachable through it) appear")
        expect(_ids(result.ranking.candidates)).to_equal([])
        expect(result.ranking.candidates.len()).to_equal(0)

    it "still authorizes and returns a node reachable without crossing the unauthorized one":
        step("root -> ok directly, and root -> blocked -> tail (blocked unauthorized)")
        val edges = [_accepted("e1", "root", "ok"), _accepted("e2", "root", "blocked"),
            _accepted("e3", "blocked", "tail")]
        val registry = _registry([_rec("root", true), _rec("ok", true),
            _rec("blocked", false), _rec("tail", true)])
        val receipts: {text: text} = {"e1": "rcpt-1", "e2": "rcpt-2", "e3": "rcpt-3"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        expect(_ids(result.ranking.candidates)).to_equal(["ok"])

    it "denies a node with no matching registry record (fail closed) without going snapshot_unavailable":
        step("'root' is registered; 'stranger' has no record at all")
        val edges = [_accepted("e1", "root", "stranger")]
        val registry = _registry([_rec("root", true)])
        val receipts: {text: text} = {"e1": "rcpt-1"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        expect(_ids(result.ranking.candidates)).to_equal([])

    it "collapses to SnapshotUnavailable when the registry cannot support any recheck":
        val edges = [_accepted("e1", "root", "b")]
        val empty_registry = _registry([])
        val receipts: {text: text} = {"e1": "rcpt-1"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            empty_registry, receipts, 1000)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_equal(GraphSourceErrorV1.SnapshotUnavailable)

    it "binds each contributing edge to its authorizing receipt as a pair, not two parallel arrays":
        step("Two edges sharing ONE receipt, one edge with its own receipt")
        val edges = [_accepted("e1", "root", "a"), _accepted("e2", "a", "b"), _accepted("e3", "root", "c")]
        val registry = _registry([_rec("root", true), _rec("a", true), _rec("b", true), _rec("c", true)])
        val receipts: {text: text} = {"e1": "shared-rcpt", "e2": "shared-rcpt", "e3": "own-rcpt"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("All three edges contributed and each pair names its own authorizing receipt")
        expect(result.accepted_edge_evidence.len()).to_equal(3)
        var found_shared = 0
        var i = 0
        while i < result.accepted_edge_evidence.len():
            if result.accepted_edge_evidence[i].authority_receipt_uid == "shared-rcpt":
                found_shared = found_shared + 1
            i = i + 1
        expect(found_shared).to_equal(2)

    it "drops an edge with no receipt entry, even if both endpoints are authorized":
        val edges = [_accepted("e1", "root", "a")]
        val registry = _registry([_rec("root", true), _rec("a", true)])
        val no_receipts: {text: text} = {}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, no_receipts, 1000).unwrap()

        expect(_ids(result.ranking.candidates)).to_equal([])
        expect(result.accepted_edge_evidence.len()).to_equal(0)

    it "resumes a cursor exactly where it left off, with no duplicates and no gaps":
        step("Five siblings of root, one hop away, paged two at a time")
        val edges = [_accepted("e1", "root", "s1"), _accepted("e2", "root", "s2"),
            _accepted("e3", "root", "s3"), _accepted("e4", "root", "s4"), _accepted("e5", "root", "s5")]
        val registry = _registry([_rec("root", true), _rec("s1", true), _rec("s2", true),
            _rec("s3", true), _rec("s4", true), _rec("s5", true)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r", "e4": "r", "e5": "r"}
        val first = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 2).unwrap()

        step("Page 1 has exactly 2 candidates and a live cursor")
        expect(first.ranking.candidates.len()).to_equal(2)
        expect(first.cursor.is_some()).to_equal(true)

        val cursor1 = first.cursor.unwrap()
        val page2 = resume_graph_page_v2(cursor1, 2).unwrap()
        expect(page2.candidates.len()).to_equal(2)
        expect(page2.cursor.is_some()).to_equal(true)

        val cursor2 = page2.cursor.unwrap()
        val page3 = resume_graph_page_v2(cursor2, 2).unwrap()
        expect(page3.candidates.len()).to_equal(1)
        expect(page3.cursor.is_some()).to_equal(false)

        step("Concatenated pages cover every candidate exactly once (no dup, no gap)")
        var all_seen: [text] = []
        var i = 0
        while i < first.ranking.candidates.len():
            all_seen.push(first.ranking.candidates[i].document_id)
            i = i + 1
        var j = 0
        while j < page2.candidates.len():
            all_seen.push(page2.candidates[j].document_id)
            j = j + 1
        var k = 0
        while k < page3.candidates.len():
            all_seen.push(page3.candidates[k].document_id)
            k = k + 1
        expect(all_seen.len()).to_equal(5)
        expect(all_seen).to_equal(["s1", "s2", "s3", "s4", "s5"])

    it "rejects resuming an already-consumed cursor (single-use)":
        val edges = [_accepted("e1", "root", "s1"), _accepted("e2", "root", "s2"), _accepted("e3", "root", "s3")]
        val registry = _registry([_rec("root", true), _rec("s1", true), _rec("s2", true), _rec("s3", true)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r"}
        val first = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1).unwrap()
        val cursor = first.cursor.unwrap()

        step("First resume succeeds")
        val page2 = resume_graph_page_v2(cursor, 1)
        expect(page2.is_err()).to_equal(false)

        step("Resuming the SAME cursor handle again fails closed")
        val page2_again = resume_graph_page_v2(cursor, 1)
        expect(page2_again.is_err()).to_equal(true)
        expect(page2_again.unwrap_err()).to_equal(GraphSourceErrorV1.CursorAlreadyConsumed)

    it "reports no cursor and complete=true when everything fits in one page":
        val edges = [_accepted("e1", "root", "a")]
        val registry = _registry([_rec("root", true), _rec("a", true)])
        val receipts: {text: text} = {"e1": "r"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()
        expect(result.cursor.is_some()).to_equal(false)
        expect(result.ranking.complete).to_equal(true)

    it "keeps determinism: unauthorized-node filtering does not disturb (distance asc, uid asc) order":
        step("root has two authorized one-hop siblings and one unauthorized one")
        val edges = [_accepted("e1", "root", "z-ok"), _accepted("e2", "root", "a-ok"),
            _accepted("e3", "root", "m-blocked")]
        val registry = _registry([_rec("root", true), _rec("z-ok", true), _rec("a-ok", true),
            _rec("m-blocked", false)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()
        expect(_ids(result.ranking.candidates)).to_equal(["a-ok", "z-ok"])
