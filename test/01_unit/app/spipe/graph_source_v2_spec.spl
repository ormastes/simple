"""Graph fusion source v2: authorization, receipt evidence, cursor paging

## Purpose and audience

As the SPipe fusion tier consuming §3.5.1's complete-pool v2 contract, the graph
source rechecks authorization per node against the live identity registry, binds
every contributing edge to its authorizing receipt, and hands back a single-use
cursor for paging. Audience: SPipe fusion tier developers and code reviewers.

## Authorization and node filtering

Recheck authorization against registry; block unauthorized nodes and their descendants.

## Receipt binding

Bind each edge-candidate pair to its authorizing receipt record (not parallel arrays).

## Cursor paging

Single-use cursor semantics; resume exactly where it left off with no duplicates or gaps.

## Determinism

Unauthorized-node filtering preserves sort order (distance asc, uid asc).

## Verification guidance and troubleshooting

Each scenario verifies one contract element; cross-check across the full range.
"""
# Lifecycle: doc/03_plan/infra/spipe/spipe_knowledge_compiler_refined_plan.md ;
# doc/04_architecture/infra/spipe/spipe_knowledge_compiler.md ;
# doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md ;
# doc/01_research/domain/sspec_documentization_maintenance.md
# @manual_section: spipe-graph-source
use std.spec.*
use app.spipe.fusion.graph_source.{build_graph_ranking_v2, resume_graph_page_v2,
    GraphSourceErrorV1}
use app.spipe.model.types.{EdgeRecord, EdgeType, EdgeOrigin, EdgeStatus}
use app.spipe.identity.registry.{IdentityRegistryV1, IdentityRecordV1}

fn _accepted(uid: text, from_uid: text, to_uid: text) -> EdgeRecord:
    EdgeRecord(uid: uid, edge_type: EdgeType.LinksTo, from_uid: from_uid,
        to_uid: to_uid, origin: EdgeOrigin.Explicit, status: EdgeStatus.Accepted,
        source_range: None)

fn _rec(uid: text, authorized: bool) -> IdentityRecordV1:
    IdentityRecordV1(uid: uid, key: uid, aliases: [], authorized: authorized)

fn _registry(records: [IdentityRecordV1]) -> IdentityRegistryV1:
    IdentityRegistryV1(generation: 1, records: records)

fn _ids(candidates) -> [text]:
    var out: [text] = []
    var i = 0
    while i < candidates.len():
        out.push(candidates[i].document_id)
        i = i + 1
    out

describe "Graph fusion source v2: authorization, receipt evidence, cursor paging":

    it "excludes an unauthorized node from results and from the count":
        # @req REQ-GRAPH-001
        # @capture: text_evidence("unauthorized_excluded")
        step("root -> blocked -> tail; 'blocked' is not authorized")
        val edges = [_accepted("e1", "root", "blocked"), _accepted("e2", "blocked", "tail")]
        val registry = _registry([_rec("root", true), _rec("blocked", false), _rec("tail", true)])
        val receipts: {text: text} = {"e1": "rcpt-1", "e2": "rcpt-2"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: neither 'blocked' nor 'tail' (only reachable through it) appear in results")
        expect(_ids(result.ranking.candidates)).to_equal([])  # oracle: ranking.candidates must be empty when traversal blocks on unauthorized node
        expect(result.ranking.candidates.len()).to_equal(0)  # oracle: candidates.len() must be zero (double-check against partial traversal)

    it "still authorizes and returns a node reachable without crossing the unauthorized one":
        # @req REQ-GRAPH-002
        # @capture: text_evidence("alternate_path_authorized")
        step("root -> ok directly, and root -> blocked -> tail (blocked unauthorized)")
        val edges = [_accepted("e1", "root", "ok"), _accepted("e2", "root", "blocked"),
            _accepted("e3", "blocked", "tail")]
        val registry = _registry([_rec("root", true), _rec("ok", true),
            _rec("blocked", false), _rec("tail", true)])
        val receipts: {text: text} = {"e1": "rcpt-1", "e2": "rcpt-2", "e3": "rcpt-3"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: only 'ok' appears (reachable without crossing unauthorized node)")
        expect(_ids(result.ranking.candidates)).to_equal(["ok"])  # oracle: single authorized candidate via direct edge appears in results

    it "denies a node with no matching registry record (fail closed) without going snapshot_unavailable":
        # @req REQ-GRAPH-003
        # @capture: text_evidence("unregistered_denied")
        step("'root' is registered; 'stranger' has no record at all")
        val edges = [_accepted("e1", "root", "stranger")]
        val registry = _registry([_rec("root", true)])
        val receipts: {text: text} = {"e1": "rcpt-1"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: stranger is denied (fail-closed, not snapshot unavailable)")
        expect(_ids(result.ranking.candidates)).to_equal([])  # oracle: unregistered node must not appear in ranking candidates

    it "collapses to SnapshotUnavailable when the registry cannot support any recheck":
        # @req REQ-GRAPH-004
        # @capture: text_evidence("snapshot_unavailable_collapse")
        step("Build graph with edges but empty (no records) registry")
        val edges = [_accepted("e1", "root", "b")]
        val empty_registry = _registry([])
        val receipts: {text: text} = {"e1": "rcpt-1"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            empty_registry, receipts, 1000)

        step("Verify: result is an error, not a success with empty candidates")
        expect(result.is_err()).to_equal(true)  # oracle: when registry cannot support recheck, must fail (not return Ok with empty list)
        expect(result.unwrap_err()).to_equal(GraphSourceErrorV1.SnapshotUnavailable)  # oracle: error code must be SnapshotUnavailable (fail-closed response)

    it "binds each contributing edge to its authorizing receipt as a pair, not two parallel arrays":
        # @req REQ-GRAPH-005
        # @capture: text_evidence("edge_receipt_binding_pair")
        step("Two edges sharing ONE receipt, one edge with its own receipt")
        val edges = [_accepted("e1", "root", "a"), _accepted("e2", "a", "b"), _accepted("e3", "root", "c")]
        val registry = _registry([_rec("root", true), _rec("a", true), _rec("b", true), _rec("c", true)])
        val receipts: {text: text} = {"e1": "shared-rcpt", "e2": "shared-rcpt", "e3": "own-rcpt"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: all three edges contributed with correct receipt bindings")
        expect(result.accepted_edge_evidence.len()).to_equal(3)  # oracle: exactly 3 edge-receipt pairs must exist (not separate parallel arrays)
        var found_shared = 0
        var i = 0
        while i < result.accepted_edge_evidence.len():
            if result.accepted_edge_evidence[i].authority_receipt_uid == "shared-rcpt":
                found_shared = found_shared + 1
            i = i + 1
        expect(found_shared).to_equal(2)  # oracle: shared-rcpt must appear exactly twice (e1 and e2 share one receipt)

    it "drops an edge with no receipt entry, even if both endpoints are authorized":
        # @req REQ-GRAPH-006
        # @capture: text_evidence("missing_receipt_dropped")
        step("Build graph with authorized endpoints but no receipt entry")
        val edges = [_accepted("e1", "root", "a")]
        val registry = _registry([_rec("root", true), _rec("a", true)])
        val no_receipts: {text: text} = {}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, no_receipts, 1000).unwrap()

        step("Verify: edge is dropped (fail-closed) despite authorized endpoints")
        expect(_ids(result.ranking.candidates)).to_equal([])  # oracle: candidate must not appear without receipt authorization
        expect(result.accepted_edge_evidence.len()).to_equal(0)  # oracle: accepted_edge_evidence must be empty (no evidence = no authorization)

    it "resumes a cursor exactly where it left off, with no duplicates and no gaps":
        # @req REQ-GRAPH-007
        # @capture: text_evidence("cursor_resume_no_dup_gap")
        step("Five siblings of root, one hop away, paged two at a time")
        val edges = [_accepted("e1", "root", "s1"), _accepted("e2", "root", "s2"),
            _accepted("e3", "root", "s3"), _accepted("e4", "root", "s4"), _accepted("e5", "root", "s5")]
        val registry = _registry([_rec("root", true), _rec("s1", true), _rec("s2", true),
            _rec("s3", true), _rec("s4", true), _rec("s5", true)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r", "e4": "r", "e5": "r"}
        val first = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 2).unwrap()

        step("Page 1 has exactly 2 candidates and a live cursor")
        expect(first.ranking.candidates.len()).to_equal(2)  # oracle: first page must contain exactly 2 candidates (page size 2)
        expect(first.cursor.is_some()).to_equal(true)  # oracle: first page must have a cursor for next page

        val cursor1 = first.cursor.unwrap()
        val page2 = resume_graph_page_v2(cursor1, 2).unwrap()
        expect(page2.candidates.len()).to_equal(2)  # oracle: second page must contain exactly 2 candidates (page size 2)
        expect(page2.cursor.is_some()).to_equal(true)  # oracle: second page must have a cursor for next page

        val cursor2 = page2.cursor.unwrap()
        val page3 = resume_graph_page_v2(cursor2, 2).unwrap()
        expect(page3.candidates.len()).to_equal(1)  # oracle: third page must contain exactly 1 candidate (5 total - 2 - 2 = 1)
        expect(page3.cursor.is_some()).to_equal(false)  # oracle: third page must have no cursor (all results exhausted)

        step("Concatenated pages cover every candidate exactly once (no dup, no gap)")
        var all_seen: [text] = []
        var i = 0
        while i < first.ranking.candidates.len():
            all_seen.push(first.ranking.candidates[i].document_id)
            i = i + 1
        var j = 0
        while j < page2.candidates.len():
            all_seen.push(page2.candidates[j].document_id)
            j = j + 1
        var k = 0
        while k < page3.candidates.len():
            all_seen.push(page3.candidates[k].document_id)
            k = k + 1
        expect(all_seen.len()).to_equal(5)  # oracle: all 5 siblings must appear across all pages (no dups, no gaps)
        expect(all_seen).to_equal(["s1", "s2", "s3", "s4", "s5"])  # oracle: results must be in deterministic order (uid asc)

    it "rejects resuming an already-consumed cursor (single-use)":
        # @req REQ-GRAPH-008
        # @capture: text_evidence("cursor_single_use_enforced")
        step("Build graph with three siblings; page size 1")
        val edges = [_accepted("e1", "root", "s1"), _accepted("e2", "root", "s2"), _accepted("e3", "root", "s3")]
        val registry = _registry([_rec("root", true), _rec("s1", true), _rec("s2", true), _rec("s3", true)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r"}
        val first = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1).unwrap()
        val cursor = first.cursor.unwrap()

        step("First resume succeeds")
        val page2 = resume_graph_page_v2(cursor, 1)
        expect(page2.is_err()).to_equal(false)  # oracle: first page consumption succeeds (no error)

        step("Verify: resuming the SAME cursor handle again fails closed (single-use enforcement)")
        val page2_again = resume_graph_page_v2(cursor, 1)
        expect(page2_again.is_err()).to_equal(true)  # oracle: second use of consumed cursor must fail (not return another page)
        expect(page2_again.unwrap_err()).to_equal(GraphSourceErrorV1.CursorAlreadyConsumed)  # oracle: error code must be CursorAlreadyConsumed (single-use contract)

    it "reports no cursor and complete=true when everything fits in one page":
        # @req REQ-GRAPH-009
        # @capture: text_evidence("single_page_completion")
        step("Build graph with single result fitting in default page size")
        val edges = [_accepted("e1", "root", "a")]
        val registry = _registry([_rec("root", true), _rec("a", true)])
        val receipts: {text: text} = {"e1": "r"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: no cursor and complete=true when single page")
        expect(result.cursor.is_some()).to_equal(false)  # oracle: cursor must be None when all results fit in one page
        expect(result.ranking.complete).to_equal(true)  # oracle: complete flag must be true (all results returned)

    it "keeps determinism: unauthorized-node filtering does not disturb (distance asc, uid asc) order":
        # @req REQ-GRAPH-010
        # @capture: text_evidence("deterministic_ordering_filtering")
        step("root has two authorized one-hop siblings and one unauthorized one")
        val edges = [_accepted("e1", "root", "z-ok"), _accepted("e2", "root", "a-ok"),
            _accepted("e3", "root", "m-blocked")]
        val registry = _registry([_rec("root", true), _rec("z-ok", true), _rec("a-ok", true),
            _rec("m-blocked", false)])
        val receipts: {text: text} = {"e1": "r", "e2": "r", "e3": "r"}
        val result = build_graph_ranking_v2(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0",
            registry, receipts, 1000).unwrap()

        step("Verify: results are in deterministic (uid asc) order despite filtering")
        expect(_ids(result.ranking.candidates)).to_equal(["a-ok", "z-ok"])  # oracle: authorized candidates must appear in (distance, uid) sort order (a-ok before z-ok)
