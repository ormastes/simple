"""
## Purpose and audience
As the SPipe fusion tier that needs a `graph` source to feed `rrf-fixed-v1`
alongside `lexical`, engineers who own `app.spipe.fusion.graph_source` need a
bounded, deterministic BFS ranking over the ACCEPTED typed artifact graph —
never candidate/rejected edges, never a dict-iteration-order-dependent
traversal, and never a fused/boosted score, since that authority belongs to
SPipe's fusion tier, not to a source.
## Operator workflow
bin/simple test test/01_unit/app/spipe/graph_source_spec.spl
## Compatibility and limitations
Pure unit-level: builds an in-memory edge list and calls `build_graph_ranking`
directly, no provider I/O and no live index.
## Verification guidance and troubleshooting
A failure means either the BFS crossed a non-Accepted edge, ignored the
`max_depth`/`source_k` bounds, or produced input-order-dependent output —
check `_ids(ranking)` and the per-candidate `source_rank` values first.
"""
# Lifecycle: doc/01_research/infra/spipe/spipe_knowledge_compiler.md ;
# doc/03_plan/infra/spipe/spipe_search_providers_impl_plan.md ;
# doc/04_architecture/infra/spipe/spipe_knowledge_compiler.md ;
# doc/05_design/infra/spipe/spipe_knowledge_compiler_search_providers.md
# @manual_section: graph-fusion-source

use std.spec.*
use app.spipe.fusion.graph_source.{build_graph_ranking, GraphSourceErrorV1,
    GRAPH_SOURCE_CONTRACT}
use app.spipe.model.types.{EdgeRecord, EdgeType, EdgeOrigin, EdgeStatus}
use lib.common.search.fusion_types.{FusionSourceV1}

fn _edge(uid: text, from_uid: text, to_uid: text, status: EdgeStatus) -> EdgeRecord:
    EdgeRecord(uid: uid, edge_type: EdgeType.LinksTo, from_uid: from_uid,
        to_uid: to_uid, origin: EdgeOrigin.Explicit, status: status,
        source_range: None)

fn _accepted(uid: text, from_uid: text, to_uid: text) -> EdgeRecord:
    _edge(uid, from_uid, to_uid, EdgeStatus.Accepted)

fn _ids(ranking) -> [text]:
    var out: [text] = []
    var i = 0
    while i < ranking.candidates.len():
        out.push(ranking.candidates[i].document_id)
        i = i + 1
    out

describe "Graph fusion source: BFS ranking over the accepted edge graph":
    it "returns a source-local Graph ranking, never fused ranks or boosts":
        # @req REQ-SPIPE-GRAPH-001
        # @capture(protocol_json): the Graph ranking's source tag, contract id, and per-node ranks
        step("Build a two-hop accepted chain root -> b -> c")
        val edges = [_accepted("e1", "root", "b"), _accepted("e2", "b", "c")]
        val ranking = build_graph_ranking(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()

        step("The ranking carries the Graph source tag and its own contract id")
        expect(ranking.source).to_equal(FusionSourceV1.Graph)
        expect(ranking.source_contract).to_equal(GRAPH_SOURCE_CONTRACT)

        step("b (distance 1) ranks ahead of c (distance 2); root itself is not a candidate")
        expect(_ids(ranking)).to_equal(["b", "c"])
        expect(ranking.candidates[0].source_rank).to_equal(1)  # oracle: b is one hop from root, the closest possible rank
        expect(ranking.candidates[1].source_rank).to_equal(2)  # oracle: c is two hops from root, ranked after b

    it "traverses both directions: an incoming edge into the root also contributes":
        # @req REQ-SPIPE-GRAPH-002
        # @capture(protocol_json): the discovered candidate list for a reverse-only edge
        step("a -> root is a reverse (incoming) edge from the root's perspective")
        val edges = [_accepted("e1", "a", "root")]
        val ranking = build_graph_ranking(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()
        expect(_ids(ranking)).to_equal(["a"])

    it "does not let an unaccepted edge contribute a path":
        # @req REQ-SPIPE-GRAPH-003
        # @capture(protocol_json): the surviving candidate list once Candidate/Rejected edges are excluded
        step("root -> candidate-node is Candidate status, not Accepted; root -> rejected-node is Rejected")
        val edges = [
            _edge("e1", "root", "candidate-node", EdgeStatus.Candidate),
            _edge("e2", "root", "rejected-node", EdgeStatus.Rejected),
            _accepted("e3", "root", "accepted-node"),
        ]
        val ranking = build_graph_ranking(edges, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()

        step("Only the accepted neighbor is discovered")
        expect(_ids(ranking)).to_equal(["accepted-node"])

    it "is bounded by max_depth: a node past the depth limit is never discovered":
        # @req REQ-SPIPE-GRAPH-004
        # @capture(protocol_json): the candidate list truncated by max_depth
        step("A four-hop accepted chain, but max_depth is 2")
        val edges = [
            _accepted("e1", "root", "n1"),
            _accepted("e2", "n1", "n2"),
            _accepted("e3", "n2", "n3"),
        ]
        val ranking = build_graph_ranking(edges, ["root"], 2, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()

        step("n1 (distance 1) and n2 (distance 2) are discovered; n3 (distance 3) is not")
        expect(_ids(ranking)).to_equal(["n1", "n2"])

    it "truncates to source_k after exhaustive bounded traversal, keeping the closest nodes":
        # @req REQ-SPIPE-GRAPH-005
        # @capture(protocol_json): the truncated candidate list and the completeness flag
        step("Three siblings of the root, one hop away")
        val edges = [
            _accepted("e1", "root", "s-c"),
            _accepted("e2", "root", "s-a"),
            _accepted("e3", "root", "s-b"),
        ]
        val ranking = build_graph_ranking(edges, ["root"], 3, 2, "snap-1", "sha256:0", "sha256:0").unwrap()

        step("Same-distance ties break by ascending document ID, then source_k=2 truncates to the first two")
        expect(_ids(ranking)).to_equal(["s-a", "s-b"])
        expect(ranking.complete).to_equal(false)  # oracle: a third sibling exists past source_k=2, so the ranking is not complete

    it "produces a byte-identical ranking for the same graph and roots regardless of input edge order (determinism)":
        # @req REQ-SPIPE-GRAPH-006
        # @capture(protocol_json): both orderings' candidate lists and ranks, proven identical
        step("Same edges, two different input orders")
        val edges_order_1 = [
            _accepted("e1", "root", "z"),
            _accepted("e2", "root", "a"),
            _accepted("e3", "a", "m"),
        ]
        val edges_order_2 = [
            _accepted("e3", "a", "m"),
            _accepted("e2", "root", "a"),
            _accepted("e1", "root", "z"),
        ]
        val r1 = build_graph_ranking(edges_order_1, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()
        val r2 = build_graph_ranking(edges_order_2, ["root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()

        step("Candidate order, ranks, and distances are byte-identical")
        expect(_ids(r1)).to_equal(_ids(r2))
        expect(_ids(r1)).to_equal(["a", "z", "m"])
        expect(r1.candidates[0].source_rank).to_equal(r2.candidates[0].source_rank)
        expect(r1.candidates[2].source_rank).to_equal(r2.candidates[2].source_rank)

    it "rejects max_depth outside [1, 3]":
        # @req REQ-SPIPE-GRAPH-007
        # @capture(protocol_json): the typed InvalidMaxDepth error
        step("Request a BFS ranking with max_depth=4, one past the allowed [1, 3] range")
        val edges = [_accepted("e1", "root", "b")]
        val result = build_graph_ranking(edges, ["root"], 4, 1000, "snap-1", "sha256:0", "sha256:0")
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_equal(GraphSourceErrorV1.InvalidMaxDepth)

    it "rejects an empty root set":
        # @req REQ-SPIPE-GRAPH-008
        # @capture(protocol_json): the typed NoRoots error
        step("Request a BFS ranking with no root artifacts supplied")
        val edges = [_accepted("e1", "root", "b")]
        val result = build_graph_ranking(edges, [], 3, 1000, "snap-1", "sha256:0", "sha256:0")
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_equal(GraphSourceErrorV1.NoRoots)

    it "deduplicates repeated roots without affecting the resulting ranking":
        # @req REQ-SPIPE-GRAPH-009
        # @capture(protocol_json): the ranking produced from a duplicated root list
        step("Pass the same root artifact twice in the roots list")
        val edges = [_accepted("e1", "root", "b")]
        val ranking = build_graph_ranking(edges, ["root", "root"], 3, 1000, "snap-1", "sha256:0", "sha256:0").unwrap()
        expect(_ids(ranking)).to_equal(["b"])
