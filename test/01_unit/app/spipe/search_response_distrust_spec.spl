use std.spec
use app.spipe.search.response_validation.{validate_search_page, validate_rank_sequence, validate_score_monotonic, validate_unique_document_ids}
use lib.common.search.document.{SearchHit}
use lib.common.search.top_k.{SearchPageV1}
use lib.common.search.types.{Score}

fn good_hits() -> [SearchHit]:
    [
        SearchHit.of("doc-a", Score.from_milli(9000), 1),
        SearchHit.of("doc-b", Score.from_milli(5000), 2),
        SearchHit.of("doc-c", Score.from_milli(1000), 3),
    ]

describe "P5 response distrust — a provider is untrusted after handshake":
    it "accepts a well-formed page: unique IDs, contiguous ranks, monotonic scores":
        step("A correctly ordered page passes every independent check")
        val page = SearchPageV1.of("root-1", good_hits(), nil, true)
        val result = validate_search_page(page, "root-1")
        match result:
            Ok(ok): expect(ok).to_equal(true)
            Err(_): expect(true).to_equal(false)

    it "rejects a page whose logical_root does not match the resolved snapshot":
        step("A forged/stale logical root must never be trusted")
        val page = SearchPageV1.of("root-forged", good_hits(), nil, true)
        val result = validate_search_page(page, "root-1")
        match result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)

    it "rejects ranks that skip a value (not contiguous)":
        step("Injected bug: rank sequence 1,3 instead of 1,2")
        val broken = [
            SearchHit.of("doc-a", Score.from_milli(9000), 1),
            SearchHit.of("doc-b", Score.from_milli(5000), 3),
        ]
        val result = validate_rank_sequence(broken)
        match result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)

    it "rejects a duplicated rank":
        step("Injected bug: rank 1 repeated instead of 1,2")
        val broken = [
            SearchHit.of("doc-a", Score.from_milli(9000), 1),
            SearchHit.of("doc-b", Score.from_milli(5000), 1),
        ]
        val result = validate_rank_sequence(broken)
        match result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)

    it "rejects a score that increases at a later (worse) rank":
        step("Injected bug: rank 2 outscores rank 1")
        val broken = [
            SearchHit.of("doc-a", Score.from_milli(1000), 1),
            SearchHit.of("doc-b", Score.from_milli(9000), 2),
        ]
        val result = validate_score_monotonic(broken)
        match result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)

    it "rejects a duplicated document ID across two ranks":
        step("Injected bug: same document claimed at rank 1 and rank 2")
        val broken = [
            SearchHit.of("doc-a", Score.from_milli(9000), 1),
            SearchHit.of("doc-a", Score.from_milli(5000), 2),
        ]
        val result = validate_unique_document_ids(broken)
        match result:
            Err(e): expect(e.code).to_equal("poisoned_response")
            Ok(_): expect(true).to_equal(false)
