use std.spec.{planned}
use std.test_runner.test_runner_types.{TestFileResult}
use std.test_runner.test_runner_output.{test_file_group, test_group_summaries_json}

# Coverage for the dashboard-facing JSON additions
# (src/lib/nogc_sync_mut/test_runner/test_runner_output.spl): feature
# grouping with done percentage, consumed by the simply capability
# registry (doc/07_guide/infra/simply_showcase_repo.md).

fn mk(path: text, passed: i64, failed: i64, skipped: i64, pending: i64) -> TestFileResult:
    TestFileResult(
        path: path, passed: passed, failed: failed, skipped: skipped,
        pending: pending, duration_ms: 0, setup_ms: 0, error: "",
        timed_out: false, cached: false)

describe "test_file_group":
    it "uses the segment after test/ as the group":
        expect(test_file_group("test/01_unit/compiler/x_spec.spl")).to_equal("01_unit")

    it "falls back to the first segment without a test/ prefix":
        expect(test_file_group("custom/lane/x_spec.spl")).to_equal("custom")

    it "returns other for a bare filename":
        expect(test_file_group("x_spec.spl")).to_equal("other")

describe "test_group_summaries_json":
    it "aggregates files into groups with done_pct":
        val rows = [
            mk("test/01_unit/a_spec.spl", 3, 1, 0, 0),
            mk("test/01_unit/b_spec.spl", 2, 0, 1, 2),
            mk("test/02_integration/c_spec.spl", 5, 0, 0, 0)
        ]
        val json = test_group_summaries_json(rows)
        # 01_unit: passed=5 failed=1 pending=2 -> 5*100/8 = 62
        expect(json).to_contain("\"name\":\"01_unit\",\"passed\":5,\"failed\":1,\"skipped\":1,\"pending\":2,\"done_pct\":62")
        expect(json).to_contain("\"name\":\"02_integration\",\"passed\":5,\"failed\":0,\"skipped\":0,\"pending\":0,\"done_pct\":100")

    it "reports done_pct 0 when a group has only skipped entries":
        val json = test_group_summaries_json([mk("test/03_system/only_skips_spec.spl", 0, 0, 4, 0)])
        expect(json).to_contain("\"done_pct\":0")

    it "returns an empty array for no files":
        expect(test_group_summaries_json([])).to_equal("[]")

describe "planned marker":
    it "declares future work without failing":
        planned("planned marker demo", "future-impl sspec reporting for dashboards")
