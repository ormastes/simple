"""Regression coverage for the native Windows bootstrap launcher."""

use std.spec.*

describe "Windows bootstrap Bash selection":
    it "discovers Git before a generic Bash":
        val wrapper = read_file("scripts/bootstrap/bootstrap-windows.cmd")
        expect(wrapper).to_contain("where git.exe")
        expect(wrapper).to_contain("bash_from_git")

    it "rejects Windows' WSL launcher":
        val wrapper = read_file("scripts/bootstrap/bootstrap-windows.cmd")
        expect(wrapper).to_contain("System32")

    it "executes the selected Bash explicitly":
        val wrapper = read_file("scripts/bootstrap/bootstrap-windows.cmd")
        expect(wrapper).to_contain("%BOOTSTRAP_BASH%")
