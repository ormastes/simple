use std.spec.{describe, it, expect}
use app.bootstrap_adhoc.args.{bootstrap_adhoc_parse_args}

describe "bootstrap ad-hoc arguments":
    it "parses repeatable changed paths and capsule evidence":
        val config = bootstrap_adhoc_parse_args([
            "check",
            "--compiler", "build/stage3/simple",
            "--positive", "test/positive.spl",
            "--negative", "test/negative.spl",
            "--negative-expect", "expected expression",
            "--changed", "src/compiler/10.frontend/core/parser.spl",
            "--changed", "src/compiler/20.hir/lowering.spl",
            "--lane", "hir",
            "--jobs", "4"
        ])
        expect(config.valid).to_equal(true)
        expect(config.action).to_equal("check")
        expect(config.changed_paths.len()).to_equal(2)
        expect(config.lane).to_equal("hir")
        expect(config.jobs).to_equal("4")

    it "rejects unknown arguments and unsafe job shapes":
        val unknown = bootstrap_adhoc_parse_args(["plan", "--mystery"])
        expect(unknown.valid).to_equal(false)
        expect(unknown.error).to_contain("unknown argument")
        val jobs = bootstrap_adhoc_parse_args(["plan", "--jobs", "3"])
        expect(jobs.valid).to_equal(false)
        expect(jobs.error).to_contain("jobs must be one of")
