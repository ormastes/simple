use std.spec.*
use std.io_runtime.{read_file_text}
use std.test_runner.doctest_runner.{extract_doctests}

describe "whole release test gate":
    it "builds and qualifies the candidate before promote-only publication":
        val candidate = read_file_text(".github/workflows/candidate.yml") ?? ""
        val promotion = read_file_text(".github/workflows/release.yml") ?? ""
        val publish = read_file_text(".github/workflows/publish.yml") ?? ""
        val bootstrap = read_file_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val prepare = read_file_text("src/app/release/prepare.spl") ?? ""
        val runner = read_file_text("src/lib/nogc_sync_mut/test_runner/test_runner_args.spl") ?? ""
        val sdoctest_runner = read_file_text("src/lib/nogc_sync_mut/test_runner/sdoctest/runner.spl") ?? ""
        val app_runner = read_file_text("src/app/test_runner_new/test_runner_main.spl") ?? ""

        expect(candidate).to_contain("--full-bootstrap --release --strategy=full")
        expect(candidate).to_contain("version-check --root=. --version=\"$VERSION\" --channel=\"$channel\" --json")
        expect(candidate).to_contain("--observed-target=x86_64-unknown-linux-gnu --json")
        expect(candidate).to_contain("Download exact protected-integration convergence receipt")
        expect(candidate).to_contain(".github/workflows/pr-admission.yml")
        expect(candidate).to_contain("diff -u build/main-to-release.actual build/main-to-release.receipt")
        expect(candidate).to_contain("diff -u build/release-to-main.actual build/release-to-main.receipt")
        expect(candidate).to_contain("convergence-admission --json")
        expect(candidate).to_contain("--evidence-receipt-sha256=\"$(jq -r '.evidence_receipt_sha256' \"$receipt\")\"")
        expect(candidate).to_contain("--forward-port-receipts=")
        expect(candidate.contains("convergence-discover")).to_be(false)
        expect(candidate).to_contain("required_support_passed:true")
        expect(candidate).to_contain("support-receipt.json")
        expect(candidate).to_contain("support_matrix:$support_matrix")
        expect(candidate).to_contain(".status == \"unsupported\"")
        expect(candidate).to_contain("admitted:true,rebuild_allowed:false,fallback_used:false")
        expect(candidate).to_contain("Enforce create-once candidate artifact identity")
        expect(candidate).to_contain("steps.candidate_bundle.outputs.artifact-id")
        expect(candidate).to_contain("steps.candidate_bundle.outputs.artifact-digest")
        expect(promotion).to_contain("Download candidate by immutable id without rebuilding")
        expect(promotion).to_contain("artifact-ids:")
        expect(promotion).to_contain("inputs.candidate_artifact_id")
        expect(promotion).to_contain("candidate artifact digest mismatch")
        expect(promotion).to_contain("simple-release-promotion/1")
        expect(promotion).to_contain("Promotion-Receipt-SHA256:")
        expect(promotion).to_contain("test \"$(jq -r '.rebuild_allowed' candidate/release-admission.json)\" = false")
        expect(promotion.contains("bootstrap-from-scratch")).to_be(false)
        expect(promotion.contains("continue-on-error")).to_be(false)
        expect(candidate).to_contain("npm pack \"$staging\" --pack-destination candidate --json")
        expect(candidate).to_contain("simple-lang-mcp-server-")
        expect(candidate).to_contain("simple-lang-lsp-mcp-server-")
        expect(publish).to_contain("npm publish \"$ASSET\"")
        expect(publish).to_contain("Admission-SHA256: //p")
        expect(publish).to_contain("qualification_receipt_sha256")
        expect(publish).to_contain("artifact_manifest_sha256")
        expect(publish).to_contain("promotion-receipt.json")
        expect(publish).to_contain("published candidate artifact identity changed")
        expect(publish).to_contain("registry version exists with different bytes")
        expect(publish).to_contain("*-beta.*) dist_tag=beta")
        expect(publish.contains("npm pack --dry-run")).to_be(false)
        expect(publish).to_contain("actions/checkout@11d5960a326750d5838078e36cf38b85af677262")
        expect(publish).to_contain("ref: $")
        expect(publish).to_contain("github.event.release.tag_name")
        expect(publish).to_contain("persist-credentials: false")
        expect(bootstrap).to_contain("run_logged stage6-whole-tests")
        expect(bootstrap).to_contain("test test --whole --mode=interpreter")
        expect(prepare).to_contain("legacy preparation is disabled")
        expect(runner).to_contain("elif arg == \"--whole\":")
        expect(runner).to_contain("sdoctest = true")
        expect(runner).to_contain("spl_doctest = true")
        expect(sdoctest_runner).to_contain("val cli_path = if options.path_explicit: options.path else: \"\"")
        expect(sdoctest_runner).to_contain("discover_sdoctest_files(config, cli_path)")
        expect(app_runner).to_contain("use std.test_runner.test_runner_modes")
        expect(app_runner).to_contain("run_spl_doctest_mode")
        val sdoc_override = app_runner.index_of("if options.sdoctest:")
        val md_override = app_runner.index_of("if options.path.ends_with(\".md\"):")
        val spl_override = app_runner.index_of("if options.spl_doctest:")
        val disabled_guard = app_runner.index_of("if not run_spec and not run_sdoc and not run_spl_doc:")
        expect(sdoc_override).to_be_greater_than(-1)
        expect(md_override).to_be_greater_than(-1)
        expect(spl_override).to_be_greater_than(-1)
        expect(disabled_guard).to_be_greater_than(sdoc_override)
        expect(disabled_guard).to_be_greater_than(md_override)
        expect(disabled_guard).to_be_greater_than(spl_override)
        expect(app_runner).to_contain("if run_spl_doc:")
        expect(app_runner).to_contain("if run_sdoc:")

    it "discovers code-comment sdoctests":
        val blocks = extract_doctests("src/compiler/00.common/gc_config.spl")

        expect(blocks.len()).to_be_greater_than(0)
        expect(blocks[0].code).to_contain("expect(")
