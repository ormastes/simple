"""# Release Archive Layout

Checks release promotion reuses the exact admitted candidate artifacts and has
no archive fallback or rebuild path.
"""

use std.spec.*
use std.io_runtime.{read_file_text}

describe "release candidate artifact layout":
    # @req REQ-004 REQ-014
    it "should bind the product artifact to the admitted checksum manifest":
        step("Verify candidate artifacts are assembled once")
        val candidate = read_file_text(".github/workflows/candidate.yml") ?? ""

        expect(candidate).to_contain("cp \"$binary\" candidate/simple-x86_64-unknown-linux-gnu")
        expect(candidate).to_contain("simple-lang-mcp-server-")
        expect(candidate).to_contain("simple-lang-lsp-mcp-server-")
        expect(candidate).to_contain("npm pack \"$staging\" --pack-destination candidate --json")
        expect(candidate).to_contain("--out=candidate/simple.spdx.json")
        expect(candidate).to_contain("actions/attest-build-provenance@8beda2b7ed98355c0e97c0a63bec38ae472e66c4")
        expect(candidate).to_contain("qualification_receipt_sha256")
        expect(candidate).to_contain("--observed-target=x86_64-unknown-linux-gnu --json")
        expect(candidate).to_contain("candidate_identity=$(jq -er '.candidate_identity'")
        expect(candidate).to_contain("build_graph_sha256")
        expect(candidate).to_contain("creator_identity")
        expect(candidate).to_contain("evidence_manifest_sha256")
        expect(candidate.contains("required_support:[{target:")).to_be(false)
        expect(candidate).to_contain("fallback_used:false")
        expect(candidate).to_contain("test \"$RUN_ATTEMPT\" = 1")
        expect(candidate).to_contain("id: candidate_bundle")
        expect(candidate).to_contain("artifact-id: $ARTIFACT_ID")
        expect(candidate).to_contain("artifact-digest: $ARTIFACT_DIGEST")

    # @req REQ-004 REQ-014
    it "should promote the downloaded candidate without rebuilding or clobbering":
        step("Verify promotion consumes exact admitted assets")
        val workflow = read_file_text(".github/workflows/release.yml") ?? ""

        expect(workflow).to_contain("Re-download exact candidate by immutable id")
        expect(workflow).to_contain("artifact-ids:")
        expect(workflow).to_contain("inputs.candidate_artifact_id")
        expect(workflow).to_contain("actions/artifacts/")
        expect(workflow).to_contain(".workflow_run.head_sha")
        expect(workflow).to_contain("candidate artifact digest mismatch at promotion boundary")
        expect(workflow).to_contain("sha256sum --check --strict artifacts.sha256")
        expect(workflow).to_contain("gh attestation verify \"$subject\"")
        expect(workflow).to_contain("immutable-releases")
        expect(workflow).to_contain("RELEASE_ADMIN_TOKEN")
        expect(workflow).to_contain("git push origin \"refs/tags/$TAG:refs/tags/$TAG\"")
        expect(workflow).to_contain("assets=(candidate/artifacts.sha256)")
        expect(workflow).to_contain("release-admission.json qualification.json promotion-receipt.json")
        expect(workflow).to_contain("Candidate-Artifact-ID:")
        expect(workflow).to_contain("Candidate-Artifact-Digest:")
        expect(workflow).to_contain("Promotion-Receipt-SHA256:")
        expect(workflow).to_contain("draft contains unadmitted asset")
        expect(workflow).to_contain("cmp --silent \"$asset\"")
        expect(workflow).to_contain("gh release verify-asset")
        expect(workflow).to_contain("git rev-parse \"refs/tags/$TAG^")
        expect(workflow.contains("--clobber")).to_be(false)
        expect(workflow.contains("find candidate")).to_be(false)
        expect(workflow.contains("bootstrap-from-scratch")).to_be(false)

    # @req REQ-004 REQ-014
    it "should publish exact admitted npm tarballs with channel-safe retry semantics":
        step("Verify npm publication promotes without rebuilding")
        val workflow = read_file_text(".github/workflows/publish.yml") ?? ""

        expect(workflow).to_contain("gh release verify-asset")
        expect(workflow).to_contain(".verification.verified")
        expect(workflow).to_contain("Admission-SHA256: //p")
        expect(workflow).to_contain("qualification_receipt_sha256")
        expect(workflow).to_contain("artifact_manifest_sha256")
        expect(workflow).to_contain("promotion-receipt.json")
        expect(workflow).to_contain("published candidate artifact identity changed")
        expect(workflow).to_contain("npm publish \"$ASSET\"")
        expect(workflow).to_contain("cmp --silent \"$ASSET\"")
        expect(workflow).to_contain("*-alpha.*) dist_tag=alpha")
        expect(workflow).to_contain("*-beta.*) dist_tag=beta")
        expect(workflow).to_contain("*-rc.*) dist_tag=rc")
        expect(workflow).to_contain("dist_tag=latest")
        expect(workflow.contains("npm pack --dry-run")).to_be(false)
