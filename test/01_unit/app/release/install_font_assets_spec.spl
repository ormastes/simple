"""# Release Font Assets

Checks installer and packaging source contracts require the registry-pinned
immutable font bundle, root license, and notices in canonical installed/package layouts.
"""

use std.spec.*
use std.io_runtime.{dir_create, dir_remove, file_exists, file_read, file_write, getpid, is_dir}
use std.process.{run}
use std.common.encoding.font_registry.{validate_selected_font_bundle_root}
use std.nogc_sync_mut.package.dist.{DistributionBuilder, DistConfig}
use lib.gc_async_mut.package.installer.staging as gc_staging
use lib.gc_async_mut.package.installer.types as gc_types
use lib.nogc_async_mut.package.installer.staging as nogc_async_staging
use lib.nogc_async_mut.package.installer.types as nogc_async_types
use lib.nogc_sync_mut.package.installer.staging as nogc_sync_staging
use lib.nogc_sync_mut.package.installer.types as nogc_sync_types

describe "release installer font assets":
    # @req REQ-004 REQ-014
    it "should install only the preflighted immutable font bundle through one share root":
        step("Load the pinned multilingual font manifest")
        val source = file_read("src/app/release/install.spl")
        val font_copy = source.slice(source.index_of("fn copy_font_tree"), source.index_of("fn copy_pinned_file"))

        expect(source).to_contain("copy_font_tree(src: script_dir + \"/assets/fonts\"")
        expect(source.index_of("copy_font_tree(src: script_dir + \"/assets/fonts\"")).to_be_less_than(source.index_of("# Install runtime binary"))
        expect(source).to_contain("prefix + \"/share/simple/assets/fonts\"")
        expect(source).to_contain("export SIMPLE_ASSET_ROOT=\\\"$SHARE_DIR\\\"")
        expect(font_copy).to_contain("selected_font_bundle_asset_pins()")
        expect(font_copy).to_contain("pins.len() != 57 or files.len() != pins.len()")
        expect(font_copy).to_contain("pin.path == \"assets/fonts/\" + rel")
        expect(font_copy).to_contain("if not pinned: return false")
        expect(font_copy).to_contain("if not rt_file_exists(source_path): return false")
        expect(font_copy).to_contain("validate_selected_font_bundle_bytes(pin.path, rt_file_read_bytes(source_path))")
        expect(font_copy).to_contain("rt_file_copy(source_path, dst_file)")
        expect(font_copy).to_contain("validate_selected_font_bundle_bytes(pin.path, rt_file_read_bytes(dst_file))")
        expect(font_copy.index_of("rt_file_read_bytes(source_path)")).to_be_less_than(font_copy.index_of("rt_dir_create(get_parent(dst_file)"))
        expect(font_copy.contains("rt_file_copy(f, dst_file)")).to_be(false)
        expect(source).to_contain("copy_pinned_file(script_dir + \"/LICENSE\", prefix + \"/share/simple/LICENSE\", \"LICENSE\")")
        expect(source).to_contain("copy_pinned_file(script_dir + \"/THIRD_PARTY_NOTICES.md\", prefix + \"/share/simple/THIRD_PARTY_NOTICES.md\", \"THIRD_PARTY_NOTICES.md\")")
        expect(source).to_contain("bundled font installation incomplete")
        expect(source).to_contain("return 1")
        expect(source).to_contain("if not rt_file_copy(runtime_src, runtime_dst)")
        expect(source).to_contain("if not rt_file_write_text(wrapper_path, wrapper)")
        expect(source).to_contain("if wrapper_chmod.2 != 0")
        expect(source).to_contain("THIRD_PARTY_NOTICES.md")
        expect(source).to_contain("/share/simple/LICENSE")

    # @req REQ-004 REQ-014
    it "should stage fonts and root notices in every host release package":
        step("Load the pinned multilingual font manifest")
        val workflow = file_read(".github/workflows/release.yml")
        val nsis = file_read("config/packaging/windows/simple.nsi")

        expect(workflow).to_contain("cp -r assets \"${PKG_DIR}/\"")
        expect(workflow).to_contain("cp -r assets \"$PKG_ROOT/\"")
        expect(workflow).to_contain("cp -r assets/fonts staging-deb/usr/local/share/simple/assets/")
        expect(workflow).to_contain("cp LICENSE THIRD_PARTY_NOTICES.md staging-deb/usr/local/share/simple/")
        expect(workflow).to_contain("cp -r assets/fonts staging-win/assets/")
        expect(workflow).to_contain("cp LICENSE THIRD_PARTY_NOTICES.md staging-win/")
        expect(workflow).to_contain("sha256sum --check scripts/os/simpleos_font_bundle_companion.sha256")
        expect(workflow).to_contain("find assets/fonts -type l -print -quit")
        expect(workflow.contains("cp LICENSE \"${PKG_DIR}/\" 2>/dev/null || true")).to_be(false)
        expect(workflow.contains("cp THIRD_PARTY_NOTICES.md \"${PKG_DIR}/\" 2>/dev/null || true")).to_be(false)
        expect(workflow).to_contain("BIN_NAME=\"simple-runtime\"")
        expect(workflow).to_contain("export SIMPLE_ASSET_ROOT=\"$SCRIPT_DIR/..\"")
        expect(workflow).to_contain("set \"SIMPLE_ASSET_ROOT=%~dp0..\"")
        expect(workflow).to_contain("$LINUX_PKG_ROOT/bin/simple-runtime")
        expect(workflow.contains("if [ -f bin/simple-runtime ]; then")).to_be(false)
        expect(workflow).to_contain("export SIMPLE_ASSET_ROOT=/usr/local/share/simple")
        expect(nsis).to_contain("File /r \"${SOURCE_DIR}\\assets\\fonts\\*.*\"")
        expect(nsis).to_contain("File \"${SOURCE_DIR}\\THIRD_PARTY_NOTICES.md\"")
        expect(nsis).to_contain("\"SIMPLE_ASSET_ROOT\" \"$INSTDIR\"")

        val dist = file_read("src/lib/nogc_sync_mut/package/dist.spl")
        expect(dist).to_contain("for pin in selected_font_bundle_asset_pins():")
        expect(dist).to_contain("\"rm\", [\"-rf\", \"--\", pkg_dir]")
        expect(dist).to_contain("if not self.prepare_package_dir(pkg_dir):")
        expect(dist).to_contain("\"cp\", [source, destination]")
        expect(dist.contains("[\"-r\", \"assets\", \"\{pkg_dir\}/\"]")).to_be(false)
        expect(dist.contains("\"rm\", [\"-rf\", \"\{pkg_dir\}/assets\"]")).to_be(false)
        expect(dist).to_contain("[\"LICENSE\", \"THIRD_PARTY_NOTICES.md\", \"\{pkg_dir\}/\"]")
        expect(dist).to_contain("if not self.copy_assets_and_legal(pkg_dir): return false")
        expect(dist).to_contain("if not validate_selected_font_bundle_root(pkg_dir)")
        expect(dist).to_contain("if not self.copy_sources(pkg_dir):")
        expect(dist).to_contain("if not self.create_wrapper(pkg_dir, platform):")
        expect(dist).to_contain("if not self.create_archive(platform_name, pkg_dir, platform):")
        expect(dist).to_contain("else: \"simple-runtime\"")
        expect(dist).to_contain("set SIMPLE_ASSET_ROOT=%SCRIPT_DIR%..")
        expect(dist).to_contain("export SIMPLE_ASSET_ROOT=\\\"$SCRIPT_DIR/..\\\"")
        expect(dist.index_of("self.copy_sources(pkg_dir)")).to_be_less_than(dist.index_of("self.create_archive(platform_name, pkg_dir, platform)"))
        expect(dist).to_contain("zip -0 -r -q --symlinks")
        expect(dist).to_contain("\"tar\", [\"-czf\", archive, \"-C\", self.config.output_dir, pkg_name]")

        for path in [
            "src/lib/nogc_sync_mut/package/build.spl",
            "src/lib/nogc_async_mut/package/build.spl",
            "src/lib/gc_async_mut/package/build.spl"
        ]:
            val build = file_read(path)
            expect(build).to_contain("val assets_result = process_run(\"cp\", [\"-r\", \"assets\", tmp_dir])")
            expect(build).to_contain("file_copy(\"THIRD_PARTY_NOTICES.md\", tmp_dir + \"/THIRD_PARTY_NOTICES.md\")")
            expect(build).to_contain("if platform.starts_with(\"windows\"): \"simple.exe\" else: \"simple\"")
            expect(build).to_contain("bin/release/\{platform\}/\{runtime_name\}")
            expect(build).to_contain("val is_windows = platform.starts_with(\"windows\")")
            expect(build).to_contain("if is_windows: \"/bin/simple.exe\" else: \"/bin/simple-runtime\"")
            expect(build).to_contain("tmp_dir + \"/bin/simple.bat\"")
            expect(build).to_contain("set \\\"SIMPLE_ASSET_ROOT=%~dp0..\\\"")
            expect(build).to_contain("export SIMPLE_ASSET_ROOT=\\\"$SCRIPT_DIR/..\\\"")

        for path in [
            "src/lib/nogc_sync_mut/package/installer/staging.spl",
            "src/lib/nogc_async_mut/package/installer/staging.spl",
            "src/lib/gc_async_mut/package/installer/staging.spl"
        ]:
            val staging = file_read(path)
            expect(staging).to_contain("\{staging\}/usr/local/share/simple/assets/fonts/")
            expect(staging).to_contain("\{staging\}/usr/local/share/simple/THIRD_PARTY_NOTICES.md")
            expect(staging).to_contain("\{staging\}/usr/local/share/doc/simple-lang/THIRD_PARTY_NOTICES.md")
            expect(staging).to_contain("\{staging\}/assets/fonts/")
            expect(staging).to_contain("\{staging\}/THIRD_PARTY_NOTICES.md")
            expect(staging).to_contain("\{staging\}/doc/THIRD_PARTY_NOTICES.md")
            expect(staging).to_contain("export SIMPLE_ASSET_ROOT=/usr/local/share/simple")
            expect(staging).to_contain("for pin in selected_font_bundle_asset_pins():")
            expect(staging).to_contain("file_copy(pin.path, destination)")
            expect(staging.contains("process_run(\"cp\", [\"-r\", \"assets/fonts/.\"")).to_be(false)
            expect(staging).to_contain("validate_selected_font_bundle_root(")
            expect(staging).to_contain("Staged font assets or notices failed immutable validation")
            expect(staging).to_contain("if not prepare_staging_dir(config, platform):")
            expect(staging).to_contain("process_run(\"rm\", [\"-rf\", \"--\", staging])")
            expect(staging).to_contain("prepare_staging_dir(config, platform)")
            expect(staging).to_contain("if not file_copy(binary_src")

    # @req REQ-004 REQ-005
    # @req NFR-001 NFR-003
    it "should execute production package copy validation and reject corrupt or blocked layouts":
        step("Verify immutable font assets and notices in release layouts")
        val work = "/tmp/simple_font_distribution_byte_identity_spec_" + getpid().to_text()
        if is_dir(work):
            expect(dir_remove(work, recursive: true)).to_be(true)
        expect(dir_create(work, recursive: true)).to_be(true)
        val package_root = work + "/simple-font-test-linux-x86_64"
        val builder = DistributionBuilder.new(DistConfig(
            version: "font-test",
            output_dir: work,
            strip_binaries: false,
            exclude_patterns: [],
        ))
        val external = work + "/external"
        expect(dir_create(external, recursive: true)).to_be(true)
        expect(file_write(external + "/sentinel", "keep")).to_be(true)
        val package_link = run("ln", ["-s", external, package_root])
        expect(package_link.exit_code).to_equal(0)
        expect(builder.prepare_package_dir(package_root)).to_be(true)
        expect(file_exists(external + "/sentinel")).to_be(true)
        expect(builder.copy_assets_and_legal(package_root)).to_be(true)
        expect(validate_selected_font_bundle_root(package_root)).to_be(true)

        step("Verify immutable font assets and notices in release layouts")
        val extra_asset = package_root + "/assets/fonts/UNMANAGED.txt"
        val extra_link = package_root + "/assets/fonts/UNMANAGED-LINK"
        expect(file_write(extra_asset, "unmanaged")).to_be(true)
        val link_result = run("ln", ["-s", "UNMANAGED.txt", extra_link])
        expect(link_result.exit_code).to_equal(0)
        expect(validate_selected_font_bundle_root(package_root)).to_be(false)
        expect(builder.copy_assets_and_legal(package_root)).to_be(false)
        expect(file_exists(extra_asset)).to_be(true)
        expect(file_exists(extra_link)).to_be(true)
        expect(builder.copy_assets_and_legal(".")).to_be(false)
        expect(file_exists("assets/fonts")).to_be(true)
        expect(builder.prepare_package_dir(package_root)).to_be(true)
        expect(builder.copy_assets_and_legal(package_root)).to_be(true)

        step("Verify immutable font assets and notices in release layouts")
        val pin_rel = "assets/fonts/google-fonts/ofl/notosanssc/METADATA.pb"
        val pin_path = package_root + "/" + pin_rel
        val external_pin = work + "/external-pin"
        val pin_copy = run("cp", [pin_path, external_pin])
        val pin_remove = run("rm", [pin_path])
        val pin_link = run("ln", ["-s", external_pin, pin_path])
        expect(pin_copy.exit_code).to_equal(0)
        expect(pin_remove.exit_code).to_equal(0)
        expect(pin_link.exit_code).to_equal(0)
        expect(validate_selected_font_bundle_root(package_root)).to_be(false)
        expect(builder.prepare_package_dir(package_root)).to_be(true)
        expect(builder.copy_assets_and_legal(package_root)).to_be(true)
        val external_license = work + "/external-license"
        val legal_copy = run("cp", [package_root + "/LICENSE", external_license])
        val legal_remove = run("rm", [package_root + "/LICENSE"])
        val legal_link = run("ln", [
            "-s", external_license, package_root + "/LICENSE"])
        expect(legal_copy.exit_code).to_equal(0)
        expect(legal_remove.exit_code).to_equal(0)
        expect(legal_link.exit_code).to_equal(0)
        expect(validate_selected_font_bundle_root(package_root)).to_be(false)
        expect(builder.prepare_package_dir(package_root)).to_be(true)
        expect(builder.copy_assets_and_legal(package_root)).to_be(true)

        step("Verify immutable font assets and notices in release layouts")
        expect(file_write(package_root + "/LICENSE", "corrupt")).to_be(true)
        expect(validate_selected_font_bundle_root(package_root)).to_be(false)
        expect(builder.copy_assets_and_legal(package_root)).to_be(true)
        expect(validate_selected_font_bundle_root(package_root)).to_be(true)

        step("Verify immutable font assets and notices in release layouts")
        val blocked_builder = DistributionBuilder.new(DistConfig(
            version: "blocked",
            output_dir: work,
            strip_binaries: false,
            exclude_patterns: [],
        ))
        val blocked_package = work + "/simple-blocked-linux-x86_64"
        expect(file_write(blocked_package, "not a directory")).to_be(true)
        expect(blocked_builder.copy_assets_and_legal(blocked_package)).to_be(false)
        expect(dir_remove(work, recursive: true)).to_be(true)

    # @req REQ-004 REQ-014
    # @req NFR-001
    it "should fail closed in every installer tier before retaining stale assets or missing binaries":
        val work = "/tmp/simple_font_installer_tier_failure_spec_" + getpid().to_text()
        if is_dir(work):
            expect(dir_remove(work, recursive: true)).to_be(true)
        expect(dir_create(work, recursive: true)).to_be(true)

        val gc_config = gc_types.InstallerConfig(
            version: "test", package_name: "simple", description: "test",
            maintainer: "test", homepage: "test", license: "MIT",
            source_dir: work + "/gc-source", output_dir: work + "/gc-output",
            architecture: "amd64")
        val async_config = nogc_async_types.InstallerConfig(
            version: "test", package_name: "simple", description: "test",
            maintainer: "test", homepage: "test", license: "MIT",
            source_dir: work + "/async-source", output_dir: work + "/async-output",
            architecture: "amd64")
        val sync_config = nogc_sync_types.InstallerConfig(
            version: "test", package_name: "simple", description: "test",
            maintainer: "test", homepage: "test", license: "MIT",
            source_dir: work + "/sync-source", output_dir: work + "/sync-output",
            architecture: "amd64")

        step("Verify immutable font assets and notices in release layouts")
        for stale_root in [
            work + "/gc-output/staging-windows/assets/fonts",
            work + "/async-output/staging-windows/assets/fonts",
            work + "/sync-output/staging-windows/assets/fonts",
        ]:
            expect(dir_create(stale_root, recursive: true)).to_be(true)
            expect(file_write(stale_root + "/EXTRA", "extra")).to_be(true)
        expect(gc_staging.prepare_staging_dir(
            gc_config, gc_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(nogc_async_staging.prepare_staging_dir(
            async_config, nogc_async_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(nogc_sync_staging.prepare_staging_dir(
            sync_config, nogc_sync_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(file_exists(work + "/gc-output/staging-windows/assets/fonts/EXTRA")).to_be(false)
        expect(file_exists(work + "/async-output/staging-windows/assets/fonts/EXTRA")).to_be(false)
        expect(file_exists(work + "/sync-output/staging-windows/assets/fonts/EXTRA")).to_be(false)

        step("Verify immutable font assets and notices in release layouts")
        for external_root in [
            work + "/gc-external",
            work + "/async-external",
            work + "/sync-external",
        ]:
            expect(dir_create(external_root, recursive: true)).to_be(true)
            expect(file_write(external_root + "/sentinel", "keep")).to_be(true)
        val gc_link = run("ln", ["-s", work + "/gc-external",
            work + "/gc-output/staging-windows"])
        val async_link = run("ln", ["-s", work + "/async-external",
            work + "/async-output/staging-windows"])
        val sync_link = run("ln", ["-s", work + "/sync-external",
            work + "/sync-output/staging-windows"])
        expect(gc_link.exit_code).to_equal(0)
        expect(async_link.exit_code).to_equal(0)
        expect(sync_link.exit_code).to_equal(0)
        expect(gc_staging.prepare_staging_dir(
            gc_config, gc_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(nogc_async_staging.prepare_staging_dir(
            async_config, nogc_async_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(nogc_sync_staging.prepare_staging_dir(
            sync_config, nogc_sync_types.InstallerPlatform.WindowsExe)).to_be(true)
        expect(file_exists(work + "/gc-external/sentinel")).to_be(true)
        expect(file_exists(work + "/async-external/sentinel")).to_be(true)
        expect(file_exists(work + "/sync-external/sentinel")).to_be(true)

        step("Verify immutable font assets and notices in release layouts")
        val unsafe_gc = gc_types.InstallerConfig(
            version: "test", package_name: "simple", description: "test",
            maintainer: "test", homepage: "test", license: "MIT",
            source_dir: work, output_dir: "/", architecture: "amd64")
        expect(gc_staging.prepare_staging_dir(
            unsafe_gc, gc_types.InstallerPlatform.WindowsExe)).to_be(false)
        for source in [
            work + "/gc-source/windows-x86_64/simple.exe",
            work + "/async-source/windows-x86_64/simple.exe",
            work + "/sync-source/windows-x86_64/simple.exe",
        ]:
            expect(dir_create(source, recursive: true)).to_be(true)
        val gc_result = gc_staging.create_staging_dir(
            gc_config, gc_types.InstallerPlatform.WindowsExe)
        val async_result = nogc_async_staging.create_staging_dir(
            async_config, nogc_async_types.InstallerPlatform.WindowsExe)
        val sync_result = nogc_sync_staging.create_staging_dir(
            sync_config, nogc_sync_types.InstallerPlatform.WindowsExe)
        expect(gc_result.is_err()).to_be(true)
        expect(async_result.is_err()).to_be(true)
        expect(sync_result.is_err()).to_be(true)
        expect(dir_remove(work, recursive: true)).to_be(true)
