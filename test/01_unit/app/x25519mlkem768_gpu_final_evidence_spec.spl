# @req: REQ-GEN-APP-001

# @tag: unit, app, crypto, x25519mlkem768, gpu, evidence, security
# @req REQ-010 REQ-013 NFR-009

use std.spec.{describe, it, expect}
use app.test.x25519mlkem768_gpu_final_evidence.{
    x25519_mlkem768_gpu_final_evidence_backend_reason}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend}

use std.spec.step

describe "X25519MLKEM768 typed GPU final evidence selection":
    it "admits only CUDA and Vulkan into the same-run typed observation path":
        # @req: REQ-010
        step("Verify: admits only CUDA and Vulkan into the same-run typed observation path")
        # @req: REQ-GEN-APP-001.
        # @req: REQ-GEN-APP-001
        expect(x25519_mlkem768_gpu_final_evidence_backend_reason(
            X25519MlKem768EvidenceBackend.Cuda)).to_equal("")
        expect(x25519_mlkem768_gpu_final_evidence_backend_reason(
            X25519MlKem768EvidenceBackend.Vulkan)).to_equal("")

    it "rejects Metal and substituted non-GPU backends before dispatch":
        # @req: REQ-013
        step("Verify: rejects Metal and substituted non-GPU backends before dispatch")
        expect(x25519_mlkem768_gpu_final_evidence_backend_reason(
            X25519MlKem768EvidenceBackend.Metal)).to_equal(
            "gpu-final-evidence-backend-not-admitted")
        expect(x25519_mlkem768_gpu_final_evidence_backend_reason(
            X25519MlKem768EvidenceBackend.Avx2)).to_equal(
            "gpu-final-evidence-backend-not-admitted")
