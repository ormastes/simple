# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.test_runner.runner_lifecycle.{spawn_tracked_process, wait_tracked_process, poll_tracked_process, cleanup_all_children}
use std.test_runner.process_tracker.{tracker_clear, tracker_get_pids}
use std.nogc_sync_mut.io.process_governor.{proc_slot_active}
use std.io.{process_is_running}
use std.nogc_sync_mut.io.env_ops.{host_os}


describe "tracked test child wait":
    # @manual scenario evidence
    after_each:
        cleanup_all_children()

    it "kills and untracks a timed-out child":
        # @req REQ-SSPEC-APP
        step("kills and untracks a timed-out child")
        if host_os() == "windows":
            return
        tracker_clear()
        val pid = spawn_tracked_process("/bin/sh", ["-c", "sleep 5"])
        expect(pid).to_be_greater_than(0)
        expect(wait_tracked_process(pid, 10)).to_equal(-1)
        expect(process_is_running(pid)).to_equal(false)
        expect(tracker_get_pids().len()).to_equal(0)

    it "retains the observed exit code when polling completes":
        # @req REQ-SSPEC-APP
        step("retains the observed exit code when polling completes")
        if host_os() == "windows":
            return
        tracker_clear()
        val pid = spawn_tracked_process("/bin/sh", ["-c", "exit 7"])
        var exit_code: i64 = -2
        var attempts = 0
        while exit_code == -2 and attempts < 100:
            exit_code = poll_tracked_process(pid)
            attempts = attempts + 1
        expect(exit_code).to_equal(7)
        expect(tracker_get_pids().len()).to_equal(0)

    it "releases the process slot when a polled child dies from a signal":
        # @req REQ-SSPEC-APP
        # A signal-killed child polls as -(128+signo). The slot must be released,
        # or a few crashed specs exhaust every slot and wedge the parallel pool.
        step("releases the process slot when a polled child dies from a signal")
        if host_os() == "windows":
            return
        tracker_clear()
        val baseline = proc_slot_active()
        val pid = spawn_tracked_process("/bin/sh", ["-c", "kill -9 $$"])
        expect(pid).to_be_greater_than(0)
        var exit_code: i64 = -2
        var attempts = 0
        while exit_code == -2 and attempts < 1000:
            exit_code = poll_tracked_process(pid)
            attempts = attempts + 1
        expect(exit_code).to_equal(-137)
        expect(tracker_get_pids().len()).to_equal(0)
        expect(proc_slot_active()).to_equal(baseline)
