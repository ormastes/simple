# @req REQ-SSPEC-APP
# Follow-up to expect_outside_it_false_green_spec (#3854 assert_*, #3882
# `expect(..).to_*`): a BARE `expect <subject>` statement (no matcher) outside
# any `it` only marked a PROVISIONAL failure that is judged at example end, so
# a top-level `expect 1 == 2` exited 0. With no example to judge it, a falsy
# bare expect must be fatal. Truthy bare expects and falsy subjects consumed by
# a matcher stay green. bug_db: bdd_assert_outside_it_silent_false_green_2026_10_19.
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn simple_exe() -> text:
    val bin = env_get("SIMPLE_TEST_BINARY")
    if bin != "" and bin != nil: bin else: "bin/simple"

fn run_script(fixture: text) -> (text, i64):
    val (stdout, stderr, code) = process_run(simple_exe(), ["run", fixture])
    (stdout + stderr, code)

describe "bare expect statement outside an it block":
    it "exits non-zero on a false top-level `expect a == b`":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_bare_eq_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).to_contain("expected 1 to equal 2")
        expect(out).not.to_contain("unreachable-after-bare-expect")

    it "exits non-zero on a false top-level `expect <bool>`":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_bare_bool_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).not.to_contain("unreachable-after-bare-expect")

    it "exits non-zero on a false top-level `expect a < b`":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_bare_lt_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).not.to_contain("unreachable-after-bare-expect")

    it "keeps truthy bare expects and matcher-consumed falsy subjects at exit 0":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_bare_top_level_green.spl")
        expect(code).to_equal(0)
        expect(out).to_contain("reached-after-bare-expects")

describe "pure-Simple std.spec bare expect outside a case":
    it "exits non-zero on spec.expect(false) with no matcher":
        val (out, code) = run_script("test/fixtures/spec_outside_it/spec_expect_bare_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).not.to_contain("unreachable-after-bare-expect")
