use std.nogc_sync_mut.sosix.test_process.{sosix_test_owned_capture, sosix_test_has_owned_completion, sosix_test_spawn_plan}

describe "SOSIX test process plan":
    it "distinguishes ordinary process IDs from owned completion tokens":
        expect(sosix_test_has_owned_completion(-1)).to_equal(false)
        expect(sosix_test_has_owned_completion(4611686018427387903)).to_equal(false)
        expect(sosix_test_has_owned_completion(4611686018427387904)).to_equal(true)

    it "preserves child arguments and capture paths containing spaces and shell characters":
        val binary = "C:\\Program Files\\Simple\\simple.exe"
        val args = ["hello world", "literal&value", "한글"]
        val (owned, program, plan_args) = sosix_test_spawn_plan(binary, args, "out file", "err file")
        expect(owned).to_equal(sosix_test_owned_capture())
        if owned:
            expect(program).to_equal(binary)
            expect(plan_args).to_equal(args)
        else:
            expect(program).to_equal("/bin/sh")
            expect(plan_args[3]).to_equal("out file")
            expect(plan_args[4]).to_equal("err file")
            expect(plan_args[5]).to_equal(binary)
            expect(plan_args[6]).to_equal("hello world")
            expect(plan_args[7]).to_equal("literal&value")
            expect(plan_args[8]).to_equal("한글")
