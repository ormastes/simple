use std.spec.{describe, it, expect}
use app.test.aggregate_task_verify_options.{aggregate_task_verify_options_v1}

fn native_verifier_args() -> [text]:
    ["C:/Program Files/Simple/aggregate_task_verify.exe", "--stage=P2", "--backend=llvm",
        "--identity-manifest=C:/tasks/identity", "--identity-manifest-sha256=identity-pin",
        "--inventory-manifest=C:/tasks/product", "--inventory-manifest-sha256=product-pin",
        "--report-root=C:/tasks/report", "--db-root=C:/tasks/database", "--threads=80"]

describe "aggregate verifier native argument boundary":
    it "skips only the executable in the real sys_get_args shape":
        val options = aggregate_task_verify_options_v1(native_verifier_args()).unwrap()
        expect(options.len()).to_equal(9)
        expect(options["stage"]).to_equal("P2")
        expect(options["threads"]).to_equal("80")

    it "rejects a positional argument after the executable":
        var args = native_verifier_args()
        args.push("unexpected")
        expect(aggregate_task_verify_options_v1(args).unwrap_err()).to_equal("unexpected positional argument")

    it "rejects duplicate options rather than replacing a bound stage":
        var args = native_verifier_args()
        args.push("--stage=properP4-fromP3")
        expect(aggregate_task_verify_options_v1(args).is_err()).to_equal(true)

    it "rejects empty native argv and missing required options":
        expect(aggregate_task_verify_options_v1([]).is_err()).to_equal(true)
        expect(aggregate_task_verify_options_v1(["verifier.exe", "--stage=P2"]).is_err()).to_equal(true)
