# @req REQ-SSPEC-APP
# Regression for doc/08_tracking/bug/test_runner_import_parse_error_2026-11-25.md:
# a spec whose imported module fails to parse must FAIL with a diagnostic that
# names the module file and line. The loader already propagates real parse
# errors; this pins that behaviour. The PR #11363 case was a parser divergence
use std.spec.*
use std.io_runtime.{process_run, env_get}


fn simple_exe() -> text:
    val bin = env_get("SIMPLE_TEST_BINARY")
    if bin != "" and bin != nil: bin else: "bin/simple"

describe "spec importing an unparseable module":
    it "fails the spec file and names the module file and line":
        val fixture = "test/fixtures/test_runner/parse_fail/imports_broken_fixture.spl"
        val (stdout, stderr, code) = process_run(simple_exe(), ["test", fixture, "--no-db", "--no-cache"])
        val out = stdout + stderr
        expect(code).not.to_equal(0)
        expect(out).to_contain("outcome=ERROR")
        expect(out).to_contain("broken_mod.spl")
        expect(out).to_contain("line 5")
        expect(out).not.to_contain("1 passed, 0 failed")
