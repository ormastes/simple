"""
## Purpose and audience
Purpose: Prove that parse_mode_str.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-RUNNER-001 — stable requirement identity for this spec.
# Test Runner Argument Parsing Specification
#
# Drives the SHIPPED parser in `test_runner_args.spl` through its public seam:
# - parse_mode_str:            text -> TestExecutionMode
# - parse_test_args:           [text] -> TestOptions
# - test_args_validation_error: [text] -> text ("" when the args are valid)
#
# This file previously carried a ~190-line LOCAL REIMPLEMENTATION of
# parse_mode_str/parse_test_args and asserted against the copy, so all 71
# examples stayed green through any change to the real parser. The copy had
# already drifted from the shipped parser in six ways (default format, the
# seed_set field name, the multi-path behaviour, the mode field's type, the
# --screenshot-* flag family, and the composite mode strings). Those drifts are
# now pinned to the real behaviour below.

use std.test_runner.test_runner_args.{parse_test_args, parse_mode_str, test_args_validation_error}
use std.test_runner.test_runner_types.{TestExecutionMode, TestLevel}
use std.spec.step


describe "parse_mode_str":
    it "parses native mode":
        step("Verify: parses native mode")
        # @req: REQ-APP-TEST-RUNNER-001
        expect(parse_mode_str("native")).to_equal(TestExecutionMode.Native)

    it "parses binary as native mode":
        step("Verify: parses binary as native mode")
        expect(parse_mode_str("binary")).to_equal(TestExecutionMode.Native)

    it "parses smf mode":
        step("Verify: parses smf mode")
        expect(parse_mode_str("smf")).to_equal(TestExecutionMode.Smf)

    it "parses loader as smf mode":
        step("Verify: parses loader as smf mode")
        expect(parse_mode_str("loader")).to_equal(TestExecutionMode.Smf)

    it "parses compile mode":
        step("Verify: parses compile mode")
        expect(parse_mode_str("compile")).to_equal(TestExecutionMode.Compile)

    it "parses jit as a composite mode":
        step("Verify: parses jit as a composite mode")
        expect(parse_mode_str("jit")).to_equal(TestExecutionMode.Composite("jit"))

    it "normalizes a bare baremetal spec under interpreter":
        step("Verify: normalizes a bare baremetal spec under interpreter")
        expect(parse_mode_str("baremetal(riscv32)")).to_equal(TestExecutionMode.Composite("interpreter(baremetal(riscv32))"))

    it "keeps an explicit base runtime prefix on a composite spec":
        step("Verify: keeps an explicit base runtime prefix on a composite spec")
        expect(parse_mode_str("native(baremetal(riscv32))")).to_equal(TestExecutionMode.Composite("native(baremetal(riscv32))"))

    it "defaults to Interpreter for unknown string":
        step("Verify: defaults to Interpreter for unknown string")
        expect(parse_mode_str("unknown")).to_equal(TestExecutionMode.Interpreter)

    it "defaults to Interpreter for empty string":
        step("Verify: defaults to Interpreter for empty string")
        expect(parse_mode_str("")).to_equal(TestExecutionMode.Interpreter)

    it "defaults to Interpreter for interpreter string":
        step("Verify: defaults to Interpreter for interpreter string")
        expect(parse_mode_str("interpreter")).to_equal(TestExecutionMode.Interpreter)

    it "is case-sensitive (NATIVE does not match)":
        step("Verify: is case-sensitive (NATIVE does not match)")
        expect(parse_mode_str("NATIVE")).to_equal(TestExecutionMode.Interpreter)

    it "is case-sensitive (Smf does not match)":
        step("Verify: is case-sensitive (Smf does not match)")
        expect(parse_mode_str("Smf")).to_equal(TestExecutionMode.Interpreter)

describe "parse_test_args":
    describe "default values":
        it "uses test/ as default path":
            step("Verify: uses test/ as default path")
            expect(parse_test_args([]).path).to_equal("test/")

        it "does not mark the default path as explicit":
            step("Verify: does not mark the default path as explicit")
            expect(parse_test_args([]).path_explicit).to_equal(false)

        it "defaults level to All":
            step("Verify: defaults level to All")
            expect(parse_test_args([]).level).to_equal(TestLevel.All)

        it "defaults tag to empty":
            step("Verify: defaults tag to empty")
            expect(parse_test_args([]).tag).to_equal("")

        it "defaults fail_fast to false":
            step("Verify: defaults fail_fast to false")
            expect(parse_test_args([]).fail_fast).to_equal(false)

        it "defaults mode to Interpreter":
            step("Verify: defaults mode to Interpreter")
            expect(parse_test_args([]).mode).to_equal(TestExecutionMode.Interpreter)

        it "defaults timeout to 120":
            step("Verify: defaults timeout to 120")
            expect(parse_test_args([]).timeout).to_equal(120)  # oracle: 120 — named expected value from the requirement

        it "defaults format to text":
            step("Verify: defaults format to text")
            # The retired local copy claimed "default" here; the shipped parser
            # has always produced "text".
            expect(parse_test_args([]).format).to_equal("text")

        it "defaults profile to unresolved":
            step("Verify: defaults profile to unresolved")
            expect(parse_test_args([]).profile).to_equal("")

        it "defaults list to false":
            step("Verify: defaults list to false")
            expect(parse_test_args([]).list).to_equal(false)

        it "defaults verbose to false":
            step("Verify: defaults verbose to false")
            expect(parse_test_args([]).verbose).to_equal(false)

        it "defaults coverage to false":
            step("Verify: defaults coverage to false")
            expect(parse_test_args([]).coverage).to_equal(false)

        it "defaults no_db to false":
            step("Verify: defaults no_db to false")
            expect(parse_test_args([]).no_db).to_equal(false)

        it "defaults seed to 0 and unset":
            step("Verify: defaults seed to 0 and unset")
            val opts = parse_test_args([])
            expect(opts.seed).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(opts.seed_set).to_equal(false)

    describe "path argument":
        it "accepts positional path argument":
            step("Verify: accepts positional path argument")
            val opts = parse_test_args(["test/unit/"])
            expect(opts.path).to_equal("test/unit/")
            expect(opts.path_explicit).to_equal(true)

        it "accepts file path as argument":
            step("Verify: accepts file path as argument")
            expect(parse_test_args(["test/my_spec.spl"]).path).to_equal("test/my_spec.spl")

        it "records a single positional as exactly one target":
            step("Verify: records a single positional as exactly one target")
            # True-positive guard on an absence: the multi-path fix must not
            # invent a phantom second target for a single path.
            val opts = parse_test_args(["test/my_spec.spl"])
            expect(opts.paths.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(opts.paths[0]).to_equal("test/my_spec.spl")

        it "retains a second positional argument instead of dropping it":
            step("Verify: retains a second positional argument instead of dropping it")
            # The retired local copy asserted the opposite ("ignores second
            # positional argument"), enshrining the multi-path drop defect.
            val opts = parse_test_args(["first/path", "second/path"])
            expect(opts.path).to_equal("first/path")
            expect(opts.paths.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(opts.paths[0]).to_equal("first/path")
            expect(opts.paths[1]).to_equal("second/path")

        it "retains positionals separated by a flag":
            step("Verify: retains positionals separated by a flag")
            val opts = parse_test_args(["first/path", "--verbose", "second/path"])
            expect(opts.paths.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(opts.paths[1]).to_equal("second/path")

        it "does not treat a --timeout value as a positional":
            step("Verify: does not treat a --timeout value as a positional")
            val opts = parse_test_args(["--timeout", "300", "only/path"])
            expect(opts.timeout).to_equal(300)  # oracle: 300 — named expected value from the requirement
            expect(opts.paths.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(opts.paths[0]).to_equal("only/path")

    describe "level flags":
        it "parses --unit flag":
            step("Verify: parses --unit flag")
            expect(parse_test_args(["--unit"]).level).to_equal(TestLevel.Unit)

        it "parses --integration flag":
            step("Verify: parses --integration flag")
            expect(parse_test_args(["--integration"]).level).to_equal(TestLevel.Integration)

        it "parses --system flag":
            step("Verify: parses --system flag")
            expect(parse_test_args(["--system"]).level).to_equal(TestLevel.System)

    describe "boolean flags":
        it "parses --fail-fast":
            step("Verify: parses --fail-fast")
            expect(parse_test_args(["--fail-fast"]).fail_fast).to_equal(true)

        it "parses --list":
            step("Verify: parses --list")
            expect(parse_test_args(["--list"]).list).to_equal(true)

        it "parses --list-ignored sets both list and list_ignored":
            step("Verify: parses --list-ignored sets both list and list_ignored")
            val opts = parse_test_args(["--list-ignored"])
            expect(opts.list).to_equal(true)
            expect(opts.list_ignored).to_equal(true)

        it "parses --only-slow":
            step("Verify: parses --only-slow")
            expect(parse_test_args(["--only-slow"]).only_slow).to_equal(true)

        it "parses --only-skipped":
            step("Verify: parses --only-skipped")
            expect(parse_test_args(["--only-skipped"]).only_skipped).to_equal(true)

        it "parses --show-tags":
            step("Verify: parses --show-tags")
            expect(parse_test_args(["--show-tags"]).show_tags).to_equal(true)

        it "parses --gc-log":
            step("Verify: parses --gc-log")
            expect(parse_test_args(["--gc-log"]).gc_log).to_equal(true)

        it "parses --gc=off":
            step("Verify: parses --gc=off")
            expect(parse_test_args(["--gc=off"]).gc_off).to_equal(true)

        it "parses --gc=OFF":
            step("Verify: parses --gc=OFF")
            expect(parse_test_args(["--gc=OFF"]).gc_off).to_equal(true)

        it "parses --safe-mode":
            step("Verify: parses --safe-mode")
            expect(parse_test_args(["--safe-mode"]).safe_mode).to_equal(true)

        it "parses --safe as alias for safe-mode":
            step("Verify: parses --safe as alias for safe-mode")
            expect(parse_test_args(["--safe"]).safe_mode).to_equal(true)

        it "parses --force-rebuild":
            step("Verify: parses --force-rebuild")
            expect(parse_test_args(["--force-rebuild"]).force_rebuild).to_equal(true)

        it "parses --keep-artifacts":
            step("Verify: parses --keep-artifacts")
            expect(parse_test_args(["--keep-artifacts"]).keep_artifacts).to_equal(true)

        it "parses --all":
            step("Verify: parses --all")
            expect(parse_test_args(["--all"]).run_all).to_equal(true)

        it "parses --no-limits":
            step("Verify: parses --no-limits")
            expect(parse_test_args(["--no-limits"]).no_limits).to_equal(true)

        it "parses --no-db":
            step("Verify: parses --no-db")
            expect(parse_test_args(["--no-db"]).no_db).to_equal(true)

        it "parses --verbose":
            step("Verify: parses --verbose")
            expect(parse_test_args(["--verbose"]).verbose).to_equal(true)

        it "parses -v as alias for verbose":
            step("Verify: parses -v as alias for verbose")
            expect(parse_test_args(["-v"]).verbose).to_equal(true)

        it "parses --quick sets no_db":
            step("Verify: parses --quick sets no_db")
            expect(parse_test_args(["--quick"]).no_db).to_equal(true)

        it "parses -q as alias for quick":
            step("Verify: parses -q as alias for quick")
            expect(parse_test_args(["-q"]).no_db).to_equal(true)

        it "parses --coverage":
            step("Verify: parses --coverage")
            expect(parse_test_args(["--coverage"]).coverage).to_equal(true)

    describe "sdoctest flags":
        it "parses --sdoctest":
            step("Verify: parses --sdoctest")
            expect(parse_test_args(["--sdoctest"]).sdoctest).to_equal(true)

        it "parses --sdoctest-force":
            step("Verify: parses --sdoctest-force")
            expect(parse_test_args(["--sdoctest-force"]).sdoctest_force).to_equal(true)

        it "parses --sdoctest-env= with equals syntax":
            step("Verify: parses --sdoctest-env= with equals syntax")
            expect(parse_test_args(["--sdoctest-env=production"]).sdoctest_env).to_equal("production")

        it "parses --sdoctest-env with next arg":
            step("Verify: parses --sdoctest-env with next arg")
            expect(parse_test_args(["--sdoctest-env", "staging"]).sdoctest_env).to_equal("staging")

    describe "skip features flags":
        it "parses --list-skip-features sets list, only_skipped, and list_skip_features":
            step("Verify: parses --list-skip-features sets list, only_skipped, and list_skip_features")
            val opts = parse_test_args(["--list-skip-features"])
            expect(opts.list_skip_features).to_equal(true)
            expect(opts.only_skipped).to_equal(true)
            expect(opts.list).to_equal(true)

        it "parses --skip-features as alias":
            step("Verify: parses --skip-features as alias")
            val opts = parse_test_args(["--skip-features"])
            expect(opts.list_skip_features).to_equal(true)
            expect(opts.only_skipped).to_equal(true)
            expect(opts.list).to_equal(true)

    describe "planned/pending flags":
        it "parses --planned-only":
            step("Verify: parses --planned-only")
            expect(parse_test_args(["--planned-only"]).planned_only).to_equal(true)

        it "parses --pending as alias for planned-only":
            step("Verify: parses --pending as alias for planned-only")
            expect(parse_test_args(["--pending"]).planned_only).to_equal(true)

    describe "value arguments":
        it "parses --tag with next arg":
            step("Verify: parses --tag with next arg")
            expect(parse_test_args(["--tag", "integration"]).tag).to_equal("integration")

        it "parses --doc format":
            step("Verify: parses --doc format")
            expect(parse_test_args(["--doc"]).format).to_equal("doc")

        it "parses --format doc":
            step("Verify: parses --format doc")
            expect(parse_test_args(["--format", "doc"]).format).to_equal("doc")

        it "parses --format json":
            step("Verify: parses --format json")
            expect(parse_test_args(["--format", "json"]).format).to_equal("json")

        it "parses --mode with next arg":
            step("Verify: parses --mode with next arg")
            expect(parse_test_args(["--mode", "native"]).mode).to_equal(TestExecutionMode.Native)

        it "parses --mode= with equals syntax":
            step("Verify: parses --mode= with equals syntax")
            expect(parse_test_args(["--mode=smf"]).mode).to_equal(TestExecutionMode.Smf)

        it "parses --profile= with equals syntax":
            step("Verify: parses --profile= with equals syntax")
            expect(parse_test_args(["--profile=strict"]).profile).to_equal("strict")

        it "parses --timeout with next arg":
            step("Verify: parses --timeout with next arg")
            expect(parse_test_args(["--timeout", "300"]).timeout).to_equal(300)

        it "parses --seed with next arg":
            step("Verify: parses --seed with next arg")
            val opts = parse_test_args(["--seed", "42"])
            expect(opts.seed).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(opts.seed_set).to_equal(true)

    describe "combined arguments":
        it "parses path with flags":
            step("Verify: parses path with flags")
            val opts = parse_test_args(["test/unit/", "--fail-fast", "--verbose"])
            expect(opts.path).to_equal("test/unit/")
            expect(opts.fail_fast).to_equal(true)
            expect(opts.verbose).to_equal(true)

        it "parses flags before path":
            step("Verify: parses flags before path")
            val opts = parse_test_args(["--fail-fast", "test/my_spec.spl"])
            expect(opts.path).to_equal("test/my_spec.spl")
            expect(opts.fail_fast).to_equal(true)

        it "parses multiple flags together":
            step("Verify: parses multiple flags together")
            val opts = parse_test_args(["--unit", "--fail-fast", "--gc-log", "--verbose", "--coverage"])
            expect(opts.level).to_equal(TestLevel.Unit)
            expect(opts.fail_fast).to_equal(true)
            expect(opts.gc_log).to_equal(true)
            expect(opts.verbose).to_equal(true)
            expect(opts.coverage).to_equal(true)

        it "parses sdoctest with env and force":
            step("Verify: parses sdoctest with env and force")
            val opts = parse_test_args(["--sdoctest", "--sdoctest-env=test", "--sdoctest-force"])
            expect(opts.sdoctest).to_equal(true)
            expect(opts.sdoctest_env).to_equal("test")
            expect(opts.sdoctest_force).to_equal(true)

describe "test_args_validation_error":
    it "accepts a valid flag":
        step("Verify: accepts a valid flag")
        expect(test_args_validation_error(["--unit"])).to_equal("")

    it "accepts an empty argument list":
        step("Verify: accepts an empty argument list")
        expect(test_args_validation_error([])).to_equal("")

    it "reports a value option with no value":
        step("Verify: reports a value option with no value")
        expect(test_args_validation_error(["--timeout"])).to_equal("missing value for --timeout")

    it "reports --seed with no value":
        step("Verify: reports --seed with no value")
        expect(test_args_validation_error(["--seed"])).to_equal("missing value for --seed")

    it "reports an empty equals value":
        step("Verify: reports an empty equals value")
        expect(test_args_validation_error(["--mode="])).to_equal("missing value for --mode")

    it "reports an invalid --format value":
        step("Verify: reports an invalid --format value")
        expect(test_args_validation_error(["--format", "bogus"])).to_equal("invalid value for --format: bogus")

    it "reports an unknown option":
        step("Verify: reports an unknown option")
        expect(test_args_validation_error(["--totally-bogus"])).to_equal("unknown option: --totally-bogus")

    it "names the valid profiles when --profile is invalid":
        step("Verify: names the valid profiles when --profile is invalid")
        val err = test_args_validation_error(["--profile", "nonsense"])
        expect(err.starts_with("invalid value for --profile: nonsense")).to_equal(true)
        expect(err.contains("moderate")).to_equal(true)
        expect(err.contains("critical")).to_equal(true)

    describe "the --screenshot-* family is not implemented by this parser":
        # The retired local copy carried six examples asserting that
        # --capture-screenshots / --screenshots / --refresh-screenshots /
        # --refresh-gui-image / --screenshot-output set capture_screenshots,
        # refresh_gui_images and screenshot_output. None of those flags or
        # fields exist in the shipped parser or in TestOptions. These examples
        # pin what the parser actually does so the gap stays visible, and are
        # paired with a positive control so "rejected" cannot be confused with
        # "the validator went silent".
        it "rejects --screenshots as an unknown option":
            step("Verify: rejects --screenshots as an unknown option")
            expect(test_args_validation_error(["--screenshots"])).to_equal("unknown option: --screenshots")

        it "rejects --capture-screenshots as an unknown option":
            step("Verify: rejects --capture-screenshots as an unknown option")
            expect(test_args_validation_error(["--capture-screenshots"])).to_equal("unknown option: --capture-screenshots")

        it "rejects --screenshot-output as an unknown option":
            step("Verify: rejects --screenshot-output as an unknown option")
            expect(test_args_validation_error(["--screenshot-output", "doc/06_spec/image"])).to_equal("unknown option: --screenshot-output")

        it "rejects --refresh-screenshots as an unknown option":
            step("Verify: rejects --refresh-screenshots as an unknown option")
            expect(test_args_validation_error(["--refresh-screenshots"])).to_equal("unknown option: --refresh-screenshots")

        it "rejects --refresh-gui-image as an unknown option":
            step("Verify: rejects --refresh-gui-image as an unknown option")
            expect(test_args_validation_error(["--refresh-gui-image"])).to_equal("unknown option: --refresh-gui-image")

        it "still accepts a real flag (positive control for the rejections above)":
            step("Verify: still accepts a real flag (positive control for the rejections above)")
            expect(test_args_validation_error(["--verbose"])).to_equal("")
