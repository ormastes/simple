# @cover src/lib/nogc_sync_mut/test_runner/native_compile_contract.spl
# @cover src/lib/nogc_sync_mut/test_runner/test_runner_execute.spl
# @tag: unit, test_runner, native
# These are pure contract checks; they do not launch a compiler or runner.

use std.spec.{describe, it, expect}
use std.test_runner.native_compile_contract.{native_test_request_error, native_test_compile_threads,
    native_test_compile_args, native_test_compile_args_with_threads, native_test_invocation_receipt}
use std.test_runner.test_runner_execute.{native_test_request_error as legacy_request_error,
    native_test_compile_threads as legacy_compile_threads,
    native_test_compile_args as legacy_compile_args,
    native_test_compile_args_with_threads as legacy_compile_args_with_threads,
    native_test_invocation_receipt as legacy_invocation_receipt}

describe "lightweight native compile contract compatibility":
    it "keeps both native backends and the empty legacy request behavior":
        expect(native_test_request_error("", false)).to_equal("")
        for backend in ["llvm", "cranelift"]:
            expect(native_test_request_error(backend, false)).to_equal("")
            expect(legacy_request_error(backend, false)).to_equal(native_test_request_error(backend, false))
        expect(native_test_request_error("other", false)).to_contain("Unsupported native backend")
        expect(native_test_request_error("cranelift", true)).to_contain("refusing LLVM fallback")
        expect(native_test_request_error("llvm", false, true)).to_contain("cannot be combined")

    it "preserves compiler thread defaults and rejects malformed or overflowing requests":
        expect(native_test_compile_threads("")).to_equal((1, ""))
        expect(native_test_compile_threads("002")).to_equal((2, ""))
        expect(legacy_compile_threads("002")).to_equal(native_test_compile_threads("002"))
        for invalid in ["0", "-1", "1x", "9223372036854775808"]:
            val parsed = native_test_compile_threads(invalid)
            expect(parsed.0).to_equal(0)
            expect(parsed.1).to_contain("positive decimal integer")

    it "keeps staged source authority and backend identity in the actual compile argv":
        val source = "test/native-generated-owned/entry.spl"
        val artifact = "/private output/snippet.exe"
        for backend in ["llvm", "cranelift"]:
            val args = native_test_compile_args_with_threads(source, artifact, backend, 2)
            expect(args).to_equal(["native-build", "--backend", backend,
                "--refresh-source-authority", "--entry-closure", "--entry", source,
                "--runtime-bundle", "core-c-bootstrap", "--threads", "2",
                "--cache-dir", artifact + ".cache", "--output", artifact])
            expect(legacy_compile_args_with_threads(source, artifact, backend, 2)).to_equal(args)
            expect(legacy_compile_args(source, artifact, backend)).to_equal(
                native_test_compile_args(source, artifact, backend))

    it "keeps invocation provenance and escaping identical through the legacy export":
        val args = ["native-build", "--entry", "file with spaces.spl"]
        val receipt = native_test_invocation_receipt("llvm", "producer", "owner\nfile.spl",
            "/private/artifact.exe", "/pinned/compiler", args)
        expect(receipt).to_contain("native-aot-invocation|")
        expect(receipt).to_contain("\"backend\":\"llvm\"")
        expect(receipt).to_contain("\"producer_sha256\":\"producer\"")
        expect(receipt).to_contain("owner\\nfile.spl")
        expect(legacy_invocation_receipt("llvm", "producer", "owner\nfile.spl",
            "/private/artifact.exe", "/pinned/compiler", args)).to_equal(receipt)
