# @req REQ-SSPEC-APP
# A `///` comment doctest run via `simple test <file>.spl --spl-doctest` is a
# composite script with no `it` block. The seed dispatches assert_* as BDD
# builtins (Priority 3, before user functions) that only set BDD_EXPECT_FAILED
# — a flag read solely at `it` end — so a WRONG assert_equal exited 0 and the
# runner reported "1 passed" (false green, 2026-10-19). A failed assertion with
# no harness to record it must be fatal, like the `assert` keyword.
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn run_spl_doctest(fixture: text) -> (text, i64):
    val bin = env_get("SIMPLE_TEST_BINARY")
    val exe = if bin != "" and bin != nil: bin else: "bin/simple"
    val (stdout, stderr, code) = process_run(exe, ["test", fixture, "--spl-doctest", "--no-db", "--no-cache"])
    (stdout + stderr, code)

describe "spl doctest assert_* outside an it block":
    it "fails the block when the doctest's assert_equal is wrong":
        val (out, code) = run_spl_doctest("test/fixtures/doctest/assert_red.spl")
        expect(code).not.to_equal(0)
        expect(out).to_contain("0 passed, 1 failed")
        expect(out).not.to_contain("1 passed, 0 failed")

    it "passes the block when the doctest's assert_equal is correct":
        val (out, code) = run_spl_doctest("test/fixtures/doctest/assert_green.spl")
        expect(code).to_equal(0)
        expect(out).to_contain("1 passed, 0 failed")
