# Regression for the actual --whole positional-root discovery failure.
# Exercise the shipped parser and the shared Markdown/source scope selector.
use std.test_runner.test_runner_args.{parse_test_args}
use std.test_runner.test_runner_types.{doctest_discovery_scope_path, production_spl_doctest_roots}

describe "whole CLI provenance and doctest scope":
    it "defaults to configured documentation roots without marking whole":
        val options = parse_test_args([])
        expect(options.whole).to_equal(false)
        expect(doctest_discovery_scope_path(options)).to_equal("")
        val roots = production_spl_doctest_roots()
        expect(roots.len()).to_equal(3)
        expect(roots[0]).to_equal("src/lib/")
        expect(roots[1]).to_equal("src/compiler/")
        expect(roots[2]).to_equal("src/app/")

    it "keeps the positional spec root while whole selects repository doctests":
        val options = parse_test_args(["test", "--whole", "--list"])
        expect(options.whole).to_equal(true)
        expect(options.path).to_equal("test")
        expect(options.path_explicit).to_equal(true)
        expect(options.run_all).to_equal(true)
        expect(options.sdoctest).to_equal(true)
        expect(options.spl_doctest).to_equal(true)
        expect(options.list).to_equal(true)
        expect(doctest_discovery_scope_path(options)).to_equal("")

    it "preserves whole scope when the flag precedes an explicit spec file":
        val options = parse_test_args(["--whole", "test/one_spec.spl"])
        expect(options.whole).to_equal(true)
        expect(options.path).to_equal("test/one_spec.spl")
        expect(doctest_discovery_scope_path(options)).to_equal("")

    it "does not promote all into whole or discard a scoped documentation path":
        val options = parse_test_args(["doc/guide", "--all", "--sdoctest"])
        expect(options.whole).to_equal(false)
        expect(options.run_all).to_equal(true)
        expect(doctest_discovery_scope_path(options)).to_equal("doc/guide")

    it "preserves an explicit source-comment target without whole":
        val options = parse_test_args(["src/lib/example.spl", "--spl-doctest"])
        expect(options.whole).to_equal(false)
        expect(options.spl_doctest).to_equal(true)
        expect(doctest_discovery_scope_path(options)).to_equal("src/lib/example.spl")

    it "retains whole provenance when a later all flag is also present":
        val options = parse_test_args(["--whole", "--all", "doc/guide.md"])
        expect(options.whole).to_equal(true)
        expect(options.path).to_equal("doc/guide.md")
        expect(doctest_discovery_scope_path(options)).to_equal("")
