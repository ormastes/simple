use std.test_runner.test_runner_args.{parse_test_args, test_args_validation_error}
use std.test_runner.test_runner_types.{TestLevel}
use std.nogc_sync_mut.test_runner.resource_policy.{test_max_procs_value_valid}

describe "typed combined flags and process limit boundaries":
    it "keeps the enum level when multiple flags are combined":
        val opts = parse_test_args(["--unit", "--fail-fast", "--gc-log", "--verbose", "--coverage"])
        expect(opts["level"]).to_equal(TestLevel.Unit)
        expect(opts["fail_fast"]).to_equal(true)
        expect(opts["gc_log"]).to_equal(true)
        expect(opts["verbose"]).to_equal(true)
        expect(opts["coverage"]).to_equal(true)
    it "rejects missing negative fractional and overflowing process limits":
        expect(test_args_validation_error(["--max-procs"])).to_contain("missing value")
        for value in ["", "-1", "1.5", "word", "9223372036854775808"]:
            expect(test_args_validation_error(["--max-procs=" + value])).to_contain("invalid value")
        expect(test_args_validation_error(["--max-procs", "-1"])).to_contain("invalid value")
    it "accepts the largest signed process limit":
        expect(test_max_procs_value_valid("9223372036854775807")).to_equal(true)
    it "rejects larger and much longer decimal values":
        expect(test_max_procs_value_valid("9223372036854775808")).to_equal(false)
        expect(test_max_procs_value_valid("18446744073709551615")).to_equal(false)
        expect(test_max_procs_value_valid("100000000000000000000000000000")).to_equal(false)
    it "accepts zero and leading zeros without changing the significant bound":
        expect(test_max_procs_value_valid("0")).to_equal(true)
        expect(test_max_procs_value_valid("000000000000000000000000000000")).to_equal(true)
        expect(test_max_procs_value_valid("0009223372036854775807")).to_equal(true)
        expect(test_max_procs_value_valid("0009223372036854775808")).to_equal(false)
