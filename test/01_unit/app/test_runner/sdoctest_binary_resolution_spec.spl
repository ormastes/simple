# @req REQ-SSPEC-APP
# `simple test <doc>.md` must spawn the binary running the runner, not a
# cwd-relative "bin/simple" (absent in a fresh worktree) when no override is set.
use std.spec.*
use std.io_runtime.{process_run, env_get, host_os}
use std.nogc_sync_mut.fs.host_path.{host_path_native}


# All arguments here are fixed fixture paths and flags. Keep the recursion
# override in the child process; never alter the test runner's environment.
fn run_fresh_test(exe: text, args: [text]) -> (text, text, i64):
    if host_os() == "windows":
        # Percent expansion occurs even inside cmd quotes. Refuse ambiguous
        # paths instead of executing a different command; delayed expansion is off.
        if exe.contains("%") or exe.contains("\"") or exe.contains("\n") or exe.contains("\r"):
            return ("", "unsupported executable path for cmd.exe", 2)
        val native_exe = host_path_native(exe)
        var command = "setlocal DisableDelayedExpansion && set \"SIMPLE_TEST_DEPTH=0\" && set \"SIMPLE_BINARY=\" && \"" + native_exe + "\""
        for arg in args:
            command = command + " \"" + arg + "\""
        return process_run("cmd.exe", ["/c", command])
    var child = ["SIMPLE_TEST_DEPTH=0", "SIMPLE_BINARY=", exe]
    for arg in args:
        child.push(arg)
    process_run("env", child)

describe "sdoctest binary resolution":
    it "runs a markdown fence with no SIMPLE_BINARY override":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        val (stdout, stderr, code) = run_fresh_test(exe, ["test", "test/fixtures/doctest/green.md", "--no-db", "--no-cache"])
        expect(stdout + stderr).to_contain("1 passed")
        expect((stdout + stderr).contains("Running SPL Doctests")).to_equal(false)
        expect(code).to_equal(0)

    it "runs a named spec without unrelated configured doctest lanes":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        val (stdout, stderr, code) = run_fresh_test(exe, ["test", "scripts/check/fixtures/test_runner_calibration_green_spec.spl", "--verbose", "--no-db", "--no-cache"])
        val output = stdout + stderr
        expect(output.contains("Running SPL Doctests")).to_equal(false)
        expect(output.contains("SDoctest")).to_equal(false)
        expect(stderr).to_contain("test lanes: target=scripts/check/fixtures/test_runner_calibration_green_spec.spl spec=true markdown=false source=false")
        expect(output).to_contain("1 passed")
        expect(code).to_equal(0)

    it "honors an explicit source doctest request for a named spec":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        val (stdout, stderr, code) = run_fresh_test(exe, ["test", "scripts/check/fixtures/test_runner_calibration_green_spec.spl", "--spl-doctest", "--no-db", "--no-cache"])
        expect(stdout + stderr).to_contain("Running SPL Doctests")
        expect(code).to_equal(1)

    it "honors an explicit markdown doctest request for a named spec":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        val (stdout, stderr, code) = run_fresh_test(exe, ["test", "scripts/check/fixtures/test_runner_calibration_green_spec.spl", "--sdoctest", "--no-db", "--no-cache"])
        expect(stdout + stderr).to_contain("SDoctest Results")
        expect(code).to_equal(1)

    it "runs a named source comment without the configured markdown lane":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        val (stdout, stderr, code) = run_fresh_test(exe, ["test", "test/fixtures/doctest/green.spl", "--spl-doctest", "--no-db", "--no-cache"])
        val output = stdout + stderr
        expect(output).to_contain("SPL Doctest: 1 passed")
        expect(output.contains("SDoctest")).to_equal(false)
        expect(code).to_equal(0)
