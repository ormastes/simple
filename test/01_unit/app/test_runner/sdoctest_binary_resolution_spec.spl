# @req REQ-SSPEC-APP
# `simple test <doc>.md` must spawn the binary running the runner, not a
# cwd-relative "bin/simple" (absent in a fresh worktree) when no override is set.
use std.spec.*
use std.io_runtime.{process_run, env_get, env_set}

describe "sdoctest binary resolution":
    it "runs a markdown fence with no SIMPLE_BINARY override":
        val bin = env_get("SIMPLE_TEST_BINARY")
        val exe = if bin != "" and bin != nil: bin else: "bin/simple"
        env_set("SIMPLE_BINARY", "")
        val (stdout, stderr, code) = process_run(exe, ["test", "test/fixtures/doctest/green.md", "--no-db", "--no-cache"])
        expect(stdout + stderr).to_contain("1 passed")
        expect(code).to_equal(0)
