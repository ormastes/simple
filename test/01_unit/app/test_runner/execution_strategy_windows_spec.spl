use std.test_runner.execution_strategy.{categorize_test_file, strategy_from_mode}
use std.nogc_sync_mut.io.env_ops.{env_get, env_set}

describe "Windows test execution strategy":
    it "recognizes numbered test directories with Windows separators":
        expect(categorize_test_file("test\\01_unit\\compiler\\hello_spec.spl")).to_equal("unit")
        expect(categorize_test_file("test\\02_integration\\hello_spec.spl")).to_equal("integration")
        expect(categorize_test_file("test\\03_system\\hello_spec.spl")).to_equal("system")
        expect(categorize_test_file("test\\01_unit\\qemu\\hello_spec.spl")).to_equal("qemu")
        expect(categorize_test_file("test\\01_unit\\kernel\\hello_spec.spl")).to_equal("baremetal")
        expect(categorize_test_file("test\\02_integration\\database\\hello_spec.spl")).to_equal("database")

    it "uses the category fallback for an unknown mode":
        val previous = env_get("SIMPLE_TEST_EXECUTION_MODE") ?? ""
        env_set("SIMPLE_TEST_EXECUTION_MODE", "unknown")
        val strategy = strategy_from_mode("unknown", "test\\01_unit\\hello_spec.spl")
        env_set("SIMPLE_TEST_EXECUTION_MODE", previous)
        expect(strategy.mode).to_equal("native")
        expect(strategy.timeout_sec).to_equal(60)
