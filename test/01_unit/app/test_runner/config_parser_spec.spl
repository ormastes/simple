"""
## Purpose and audience
Purpose: Prove that Test Configuration Parsing.
Audience: compiler and tooling engineers who maintain this spec.
"""

# @req: REQ-APP-TEST-RUNNER-001 — stable requirement identity for this spec.
# Test Runner Configuration Parser Tests
# Feature: Test Runner Config Parsing
# Category: Testing, CLI
# Status: Complete
#
# Unit tests for test runner configuration parsing and validation.
#
# This file previously declared a local `TestConfig` struct and a local
# `TestExecutionMode` enum and asserted against literals it had just written
# (`val path = "test/"` then `expect path == "test/"`), so every example was
# true by construction and could not observe the shipped parser at all. It now
# drives `test_runner_args.spl` through its public seam.

use std.test_runner.test_runner_args.{parse_test_args, parse_mode_str, test_args_validation_error}
use std.test_runner.test_runner_types.{TestExecutionMode, TestLevel}
use std.spec.step


describe "Test Configuration Parsing":
    # Configuration produced by the shipped parser from an empty command line.

    it "parses default configuration":
        step("Verify: parses default configuration")
        # @req: REQ-APP-TEST-RUNNER-001
        val config = parse_test_args([])
        expect(config.timeout).to_equal(120)  # oracle: 120 — named expected value from the requirement
        expect(config.fail_fast).to_equal(false)
        expect(config.path).to_equal("test/")
        expect(config.level).to_equal(TestLevel.All)

    it "carries an explicit timeout through to the config":
        step("Verify: carries an explicit timeout through to the config")
        expect(parse_test_args(["--timeout", "60"]).timeout).to_equal(60)

    it "does not reject a non-numeric timeout value":
        step("Verify: does not reject a non-numeric timeout value")
        # Pinning a real gap, not endorsing it: the validator only checks that
        # a value-taking option HAS a value, never that it is numeric. Paired
        # with the positive control below so "no error" cannot be confused with
        # the validator having gone silent.
        expect(test_args_validation_error(["--timeout", "abc"])).to_equal("")

    it "still reports a missing timeout value (positive control)":
        step("Verify: still reports a missing timeout value (positive control)")
        expect(test_args_validation_error(["--timeout"])).to_equal("missing value for --timeout")

    it "does not clamp a negative timeout":
        step("Verify: does not clamp a negative timeout")
        # Same gap, value side: -1 is accepted and stored verbatim.
        expect(parse_test_args(["--timeout", "-1"]).timeout).to_equal(-1)

    it "handles tag filters":
        step("Verify: handles tag filters")
        expect(parse_test_args(["--tag", "unit"]).tag).to_equal("unit")

    it "leaves the tag empty when --tag has no value":
        step("Verify: leaves the tag empty when --tag has no value")
        expect(parse_test_args(["--tag"]).tag).to_equal("")

describe "Execution Mode Selection":
    # Mode selection goes through parse_mode_str, then lands in TestOptions.mode.

    it "defaults to interpreter mode":
        step("Verify: defaults to interpreter mode")
        expect(parse_test_args([]).mode).to_equal(TestExecutionMode.Interpreter)

    it "supports SMF mode":
        step("Verify: supports SMF mode")
        expect(parse_test_args(["--mode", "smf"]).mode).to_equal(TestExecutionMode.Smf)

    it "supports native mode":
        step("Verify: supports native mode")
        expect(parse_test_args(["--mode", "native"]).mode).to_equal(TestExecutionMode.Native)

    it "falls back to interpreter for an unrecognised mode name":
        step("Verify: falls back to interpreter for an unrecognised mode name")
        expect(parse_mode_str("no-such-mode")).to_equal(TestExecutionMode.Interpreter)

    it "reports a missing --mode value":
        step("Verify: reports a missing --mode value")
        expect(test_args_validation_error(["--mode="])).to_equal("missing value for --mode")

describe "Path Validation":
    # Positional targets land in TestOptions.path / TestOptions.paths.

    it "accepts valid test directory":
        step("Verify: accepts valid test directory")
        val config = parse_test_args(["test/"])
        expect(config.path).to_equal("test/")
        expect(config.path_explicit).to_equal(true)

    it "accepts specific test file":
        step("Verify: accepts specific test file")
        val config = parse_test_args(["test/01_unit/app/test_runner/config_parser_spec.spl"])
        expect(config.path).to_equal("test/01_unit/app/test_runner/config_parser_spec.spl")
        expect(config.paths.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "handles relative paths":
        step("Verify: handles relative paths")
        expect(parse_test_args(["./test/01_unit/"]).path).to_equal("./test/01_unit/")

    it "keeps flags out of the positional target list":
        step("Verify: keeps flags out of the positional target list")
        val config = parse_test_args(["--verbose", "test/01_unit/", "--fail-fast"])
        expect(config.paths.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(config.paths[0]).to_equal("test/01_unit/")
