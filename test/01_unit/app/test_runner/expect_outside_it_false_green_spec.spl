# @req REQ-SSPEC-APP
# Same class as spl_doctest_assert_false_green_spec: a failed `expect(..).to_*`
# matcher with no enclosing `it` only set BDD_EXPECT_FAILED (read solely at
# `it` end), so a top-level `expect(2).to_equal(5)` exited 0. The pure-Simple
# std.spec fail_assertion likewise pushed to current_test_errors with no
# consumer outside aggregate mode. A failure with no harness to record it must
# be fatal. bug_db: bdd_assert_outside_it_silent_false_green_2026_10_19.
use std.spec.*
use std.io_runtime.{process_run, env_get}

fn simple_exe() -> text:
    val bin = env_get("SIMPLE_TEST_BINARY")
    if bin != "" and bin != nil: bin else: "bin/simple"

fn run_script(fixture: text) -> (text, i64):
    val (stdout, stderr, code) = process_run(simple_exe(), ["run", fixture])
    (stdout + stderr, code)

describe "expect matcher outside an it block":
    it "exits non-zero on a failed top-level matcher":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).to_contain("expected 2 to equal 5")
        expect(out).not.to_contain("unreachable-after-failed-expect")

    it "keeps passing top-level matchers (incl. .not) at exit 0":
        val (out, code) = run_script("test/fixtures/spec_outside_it/expect_top_level_green.spl")
        expect(code).to_equal(0)
        expect(out).to_contain("reached-after-passing-expect")

    it "fails a comment doctest whose expect matcher is wrong":
        val (stdout, stderr, code) = process_run(simple_exe(), ["test", "test/fixtures/doctest/expect_red.spl", "--spl-doctest", "--no-db", "--no-cache"])
        val out = stdout + stderr
        expect(code).not.to_equal(0)
        expect(out).to_contain("0 passed, 1 failed")

describe "pure-Simple std.spec fail_assertion outside a case":
    it "exits non-zero instead of parking the failure":
        val (out, code) = run_script("test/fixtures/spec_outside_it/fail_assertion_top_level_red.spl")
        expect(code).not.to_equal(0)
        expect(out).to_contain("deliberate failure outside a case")
        expect(out).not.to_contain("unreachable-after-fail-assertion")
