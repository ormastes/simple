extern fn rt_file_read_text(path: text) -> text

describe("test cache file stat facade"):
    it("exports file_stat from the canonical app I/O facade"):
        val facade = rt_file_read_text("src/app/io/mod.spl") ?? ""
        expect(facade.contains("file_atomic_write, file_stat")).to_equal(true)

    it("does not consume raw file stat runtime symbols"):
        val cache = rt_file_read_text("src/app/test_cache_shared.spl") ?? ""
        expect(cache.contains("use app.io.mod.{rt_file_read_text, rt_file_write_text, file_stat}")).to_equal(true)
        expect(cache.contains("rt_file_stat(")).to_equal(false)
