use std.test_runner.doc_generator.{ensure_generated_doc_dir, write_generated_doc}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all, is_dir}
use std.nogc_sync_mut.io.file_ops.{file_read}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}

describe "test runner documentation IO owners":
    it "keeps Stage4 document writes on concrete file and directory owners":
        val source = file_read("src/lib/nogc_sync_mut/test_runner/doc_generator.spl")
        expect(source).to_contain("use std.nogc_sync_mut.io.file_ops.{file_atomic_write}")
        expect(source).to_contain("use std.nogc_sync_mut.io.dir_ops.{dir_create_all}")
        expect(source.contains("use std.io.{file_atomic_write}")).to_equal(false)
        expect(source.contains("use std.io.{dir_create_all}")).to_equal(false)

    it "creates a nested report directory and atomically writes its document":
        val root = "/tmp/simple-doc-generator-owner-{getpid()}"
        val nested = root + "/nested"
        val path = nested + "/report.md"
        dir_remove_all(root)
        expect(ensure_generated_doc_dir(nested)).to_equal(true)
        expect(is_dir(nested)).to_equal(true)
        expect(write_generated_doc(path, "first")).to_equal(true)
        expect(file_read(path)).to_equal("first")
        dir_remove_all(root)

    it "prevents an atomic replacement from retaining stale content":
        val root = "/tmp/simple-doc-generator-replace-{getpid()}"
        val path = root + "/report.md"
        dir_remove_all(root)
        ensure_generated_doc_dir(root)
        expect(write_generated_doc(path, "old content")).to_equal(true)
        expect(write_generated_doc(path, "new")).to_equal(true)
        expect(file_read(path)).to_equal("new")
        dir_remove_all(root)
