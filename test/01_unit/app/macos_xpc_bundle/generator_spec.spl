# Pure generation/validation specs. These do not execute or attest a sandbox.
use std.spec.{describe, it, expect}
use app.macos_xpc_bundle.generator.{MacXpcBundleRequest,
    validate_macos_xpc_bundle, macos_xpc_bundle_info,
    macos_xpc_bundle_entitlements, macos_xpc_signing_commands,
    macos_xpc_mach_headers_executable}

fn bundle_request() -> MacXpcBundleRequest:
    MacXpcBundleRequest(host_executable: "/tmp/input host", service_executable: "/tmp/input worker",
        host_identifier: "org.simple.NativeHost", service_identifier: "org.simple.NativeWorker",
        signing_identity: "0123456789abcdef0123456789abcdef01234567")

describe "Native Mac XPC bundle generator":
    it "checks Mach filetype fields rather than an executable-looking pathname":
        val executable = "MH_MAGIC_64 ARM64 E USR00 EXECUTE 16 824 NOUNDEFS DYLDLINK TWOLEVEL PIE\n"
        val library = "MH_MAGIC_64 ARM64 E USR00 DYLIB 16 824 NOUNDEFS DYLDLINK TWOLEVEL\n"
        expect(macos_xpc_mach_headers_executable("/tmp/EXECUTE:\n{library}")).to_equal(false)
        expect(macos_xpc_mach_headers_executable("/tmp/DYLIB:\n{executable}")).to_equal(true)
        expect(macos_xpc_mach_headers_executable("/tmp/EXECUTE:\n")).to_equal(false)
        expect(macos_xpc_mach_headers_executable("{executable}{library}")).to_equal(false)
        expect(macos_xpc_mach_headers_executable("{executable}{executable}")).to_equal(true)
        expect(macos_xpc_mach_headers_executable("MH_MAGIC_64 ARM64 E\n")).to_equal(false)

    it "writes native app and embedded XPC executable metadata":
        val request = bundle_request()
        val host = macos_xpc_bundle_info(request, false).unwrap()
        val service = macos_xpc_bundle_info(request, true).unwrap()
        expect(host).to_contain("<key>CFBundleExecutable</key><string>SimpleHost</string>")
        expect(host).to_contain("<key>CFBundlePackageType</key><string>APPL</string>")
        expect(service).to_contain("<key>CFBundleExecutable</key><string>SimpleWorker</string>")
        expect(service).to_contain("<key>CFBundlePackageType</key><string>XPC!</string>")
        expect(service).to_contain("<key>CFBundleIdentifier</key><string>org.simple.NativeWorker</string>")
        expect(service).to_contain("<key>ServiceType</key><string>Application</string>")
        expect(service).to_contain("<key>RunLoopType</key><string>dispatch_main</string>")

    it "enables only the independent service sandbox":
        val service = macos_xpc_bundle_entitlements(true)
        val host = macos_xpc_bundle_entitlements(false)
        expect(service).to_contain("<key>com.apple.security.app-sandbox</key><true/>")
        expect(service.contains("com.apple.security.inherit")).to_equal(false)
        expect(service.contains("network")).to_equal(false)
        expect(service.contains("temporary-exception")).to_equal(false)
        expect(host.contains("com.apple.security.app-sandbox")).to_equal(false)

    it "signs the nested service first and verifies it before sealing the app":
        val commands = macos_xpc_signing_commands(bundle_request(), "/private/tmp/private stage").unwrap()
        val service = "/private/tmp/private stage/SimpleHost.app/Contents/XPCServices/SimpleWorker.xpc"
        val app = "/private/tmp/private stage/SimpleHost.app"
        expect(commands.len()).to_equal(4)
        expect(commands[0].program).to_equal("/usr/bin/codesign")
        expect(commands[0].arguments[7]).to_equal(service)
        expect(commands[0].arguments.contains("--deep")).to_equal(false)
        expect(commands[1].arguments).to_equal(["--verify", "--strict", service])
        expect(commands[2].arguments[7]).to_equal(app)
        expect(commands[2].arguments.contains("--deep")).to_equal(false)
        expect(commands[3].arguments).to_equal(["--verify", "--deep", "--strict", app])

    it "supports explicit local ad-hoc signing with strict verification":
        var request = bundle_request()
        request.signing_identity = "-"
        val commands = macos_xpc_signing_commands(request, "/private/tmp/stage").unwrap()
        expect(commands[0].arguments[2]).to_equal("-")
        expect(commands[2].arguments[2]).to_equal("-")
        expect(commands[1].arguments[0]).to_equal("--verify")
        expect(commands[3].arguments[2]).to_equal("--strict")

    it "rejects unsigned, ambiguous and malformed signing identities":
        for identity in ["", "Developer ID Application", "0123456789abcdef0123456789abcdef0123456g"]:
            var request = bundle_request()
            request.signing_identity = identity
            expect(validate_macos_xpc_bundle(request).is_err()).to_equal(true)
            expect(macos_xpc_signing_commands(request, "/private/tmp/stage").is_err()).to_equal(true)

    it "rejects XML injection, traversal, empty components and colliding identifiers":
        for identifier in ["org.simple</string>", "org/simple", "../host", "org..host", ".org.host", "org.host.", "org host", "single"]:
            var request = bundle_request()
            request.service_identifier = identifier
            expect(macos_xpc_bundle_info(request, true).is_err()).to_equal(true)
        var request = bundle_request()
        request.service_identifier = request.host_identifier
        expect(validate_macos_xpc_bundle(request).is_err()).to_equal(true)

    it "rejects relative paths, option-shaped paths and control characters before I/O":
        for path in ["host", "--help", "", "/tmp/", "/tmp/bad\npath"]:
            var request = bundle_request()
            request.host_executable = path
            expect(validate_macos_xpc_bundle(request).is_err()).to_equal(true)
        expect(validate_macos_xpc_bundle(bundle_request()).is_ok()).to_equal(true)
        expect(macos_xpc_signing_commands(bundle_request(), "relative/stage").is_err()).to_equal(true)
