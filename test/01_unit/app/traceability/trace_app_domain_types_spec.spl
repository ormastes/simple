"""Domain types on the traceability app's public API (no bare primitives).

Purpose: pin the typed replacements for the former bare `bool`/`i64` public
signatures of the traceability CLI app: the query format enum and its strict
parser, the snapshot-completeness enum, the diagnostic-limit and exit-code
wrappers, and the validated-options result. Behaviour (text, SDN, exit codes)
must stay identical to the primitive signatures they replace.
Audience: traceability maintainers and CI owners.
"""
use std.spec.*
use std.spec.step
use app.traceability.query_options_v1.{TraceQueryFormatV1, trace_query_format_parse_v1,
    trace_query_format_name_v1, trace_query_sdn_requested_v1, trace_query_options_parse_v1}
use app.traceability.cli_options_v1.{TraceCliOptionsV1, trace_cli_options_validate_v1}
use app.traceability.structural_report_v1.{TraceSnapshotCompletenessV1,
    trace_qualification_infrastructure_v1}
use app.traceability.core.{TraceDiagnosticLimitV1}
use app.traceability.query_main.{TraceExitCodeV1, trace_query_error_exit_v1, trace_query_completion_exit_v1, run_trace_query_v1}
use std.common.traceability.model.{TraceGraph, SnapshotSubject}
use std.common.traceability.profile_v1.{TraceProfile}

describe "Traceability app domain types":
    it "parses the closed query format set and names it back":
        # @req REQ-TRC-021
        step("Parse each accepted spelling")
        val table = trace_query_format_parse_v1("table").unwrap()
        val sdn = trace_query_format_parse_v1("sdn").unwrap()
        expect(trace_query_format_name_v1(table)).to_equal("table")
        expect(trace_query_format_name_v1(sdn)).to_equal("sdn")

    it "rejects unknown, empty and wrongly cased query formats":
        # @req REQ-TRC-021
        step("Adverse spellings are errors, never a default")
        expect(trace_query_format_parse_v1("xml").is_err()).to_be(true)
        expect(trace_query_format_parse_v1("").is_err()).to_be(true)
        expect(trace_query_format_parse_v1("SDN").is_err()).to_be(true)
        step("The option parser keeps its exact message for a bad format")
        val parsed = trace_query_options_parse_v1(["list", "features", "--format=xml"])
        expect(parsed.is_err()).to_be(true)
        expect(parsed.unwrap_err()).to_equal("TRACE-QUERY-INVALID: native formats are table and sdn")

    it "reports the requested format as an enum":
        # @req REQ-TRC-021
        step("SDN is detected in both option forms; anything else is table")
        val sdn = trace_query_sdn_requested_v1(["list", "features", "--format", "sdn"])
        val table = trace_query_sdn_requested_v1(["list", "features", "--format"])
        expect(trace_query_format_name_v1(sdn)).to_equal("sdn")
        expect(trace_query_format_name_v1(table)).to_equal("table")

    it "returns validated options and still rejects bad scope or progress":
        # @req REQ-TRC-007
        step("A default option set validates and is handed back")
        val ok = trace_cli_options_validate_v1(TraceCliOptionsV1())
        expect(ok.is_ok()).to_be(true)
        expect(ok.unwrap().scope).to_equal("all")
        step("Adverse: unsupported scope and progress stay errors")
        expect(trace_cli_options_validate_v1(TraceCliOptionsV1(scope: "bogus")).is_err()).to_be(true)
        expect(trace_cli_options_validate_v1(TraceCliOptionsV1(progress: "loud")).is_err()).to_be(true)

    it "encodes snapshot completeness and exit codes through domain types":
        # @req REQ-TRC-007
        step("Incomplete snapshot yields snapshot.complete=false and exit_code 2")
        val partial = trace_qualification_infrastructure_v1("worktree-attempt:unavailable",
            TraceSnapshotCompletenessV1.Incomplete, TraceCliOptionsV1(), "TRC-CAPTURE-ROOT", "", "unavailable")
        expect(partial.snapshot.complete).to_be(false)
        expect(partial.evaluation.exit_code).to_equal(2)
        val complete = trace_qualification_infrastructure_v1("snap", TraceSnapshotCompletenessV1.Complete,
            TraceCliOptionsV1(), "TRC-EVALUATION-BUDGET", "", "budget")
        expect(complete.snapshot.complete).to_be(true)
        step("Not-found errors exit 1, every other query error exits 2")
        expect(trace_query_error_exit_v1("TRACE-QUERY-NOT-FOUND: x").value).to_equal(1)
        expect(trace_query_error_exit_v1("TRACE-QUERY-INVALID: x").value).to_equal(2)
        expect(TraceDiagnosticLimitV1(value: 100000).value).to_equal(100000)

    it "exits 2 for a malformed query and 0 for help":
        # @req REQ-TRC-021
        step("Adverse: too few arguments is exit 2")
        expect(run_trace_query_v1(["list"]).value).to_equal(2)
        step("Help is exit 0")
        expect(run_trace_query_v1(["--help"]).value).to_equal(0)
        expect(TraceExitCodeV1(value: 1).value).to_equal(1)

    it "exits 2 for an incomplete graph, 1 for not found, 0 for a complete graph":
        # @req REQ-TRC-007
        val subject = SnapshotSubject(repository_id: "repo:test", snapshot_id: "snapshot:one",
            kind: "git_commit", revision_id: "commit:one", tree_id: "tree:one", object_format: "sha256")
        val complete = TraceGraph(subject: subject, input_manifest_id: "inputs:one", generation_id: "generation:one",
            complete: true, nodes: [], test_definitions: [], claims: [], edges: [], edge_origins: [],
            origins: [], locators: [], diagnostics: [])
        var incomplete = complete
        incomplete.complete = false
        step("Adverse: an incomplete graph exits 2, never 1 (plan section 6)")
        expect(trace_query_completion_exit_v1(incomplete, TraceProfile.Worktree).value).to_equal(2)
        step("A complete graph exits 0")
        expect(trace_query_completion_exit_v1(complete, TraceProfile.Worktree).value).to_equal(0)
        step("Adverse: a missing item still exits 1, distinct from incomplete")
        expect(trace_query_error_exit_v1("TRACE-QUERY-NOT-FOUND: x").value).to_equal(1)

    it "exits 2 for a non-worktree profile on a complete graph and parses --profile on the legacy path":
        # @req REQ-TRC-007
        val subject = SnapshotSubject(repository_id: "repo:test", snapshot_id: "snapshot:one",
            kind: "git_commit", revision_id: "commit:one", tree_id: "tree:one", object_format: "sha256")
        val complete = TraceGraph(subject: subject, input_manifest_id: "inputs:one", generation_id: "generation:one",
            complete: true, nodes: [], test_definitions: [], claims: [], edges: [], edge_origins: [],
            origins: [], locators: [], diagnostics: [])
        step("A worktree profile on a complete graph exits 0")
        expect(trace_query_completion_exit_v1(complete, TraceProfile.Worktree).value).to_equal(0)
        step("Adverse: a release profile never reports a preview graph as admitted, so it exits 2")
        expect(trace_query_completion_exit_v1(complete, TraceProfile.Release).value).to_equal(2)
        step("The legacy parser defaults to worktree and accepts both option spellings")
        expect(trace_query_options_parse_v1(["missing"]).unwrap().profile).to_equal(TraceProfile.Worktree)
        expect(trace_query_options_parse_v1(["missing", "--profile=release"]).unwrap().profile).to_equal(TraceProfile.Release)
        expect(trace_query_options_parse_v1(["missing", "--profile", "ci"]).unwrap().profile).to_equal(TraceProfile.Ci)
        step("Adverse: an unknown profile value and a repeated --profile are rejected")
        expect(trace_query_options_parse_v1(["missing", "--profile=bogus"]).is_err()).to_be(true)
        expect(trace_query_options_parse_v1(["missing", "--profile=ci", "--profile=push"]).is_err()).to_be(true)
