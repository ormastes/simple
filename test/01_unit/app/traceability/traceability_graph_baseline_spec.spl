"""Typed graph cases retained from the actual missing-family RED baseline.
Requirements: doc/02_requirements/feature/traceability_sdn_slop.md
Design: doc/05_design/infra/traceability_graph_codec_v1.md
"""
use std.spec.*
use std.spec.step
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.strict_types_v1.{sdn_strict_limits_v1}
use std.common.traceability.graph_types_v1.{trace_graph_codec_limits_v1}
use std.common.traceability.graph_v1.{trace_graph_decode_v1}

fn baseline_graph_source() -> text:
    "schema: {name: simple.trace.graph, version: 1}\n" +
    "snapshot: {id: \"snapshot:unit\", kind: worktree, complete: true}\n" +
    "manifest: {input_set_id: \"input:unit\", extractor_version: extract/v1, rules_version: rules/v1, policy_id: \"policy:v1\", complete: true}\n" +
    "inputs |path, sha256, bytes, role|\n" +
    "    src/example.spl, aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, 0, source\n" +
    "nodes |id, kind, title|\n" +
    "    \"source:example\", source_file, \"λ, sample\"\n" +
    "test_definitions |entity_id, test_kind, identity_scope, definition_id, parameter_digest_available, parameter_digest|\n" +
    "edges |id, from_id, relation, to_id|\n" +
    "edge_origins |edge_id, origin_kind, origin_id, declaration_path_available, declaration_path, span_available, line, column, extractor_version|\n" +
    "locators |entity_id, path_available, path, locator_kind, locator|\n" +
    "    \"source:example\", true, src/example.spl, file, \"\"\n"

fn baseline_graph_result(source: text) -> text:
    var syntax_valid = false
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(_): syntax_valid = true
        case Err(_): pass
    expect(syntax_valid).to_equal(true)
    match trace_graph_decode_v1(source, trace_graph_codec_limits_v1()):
        case Ok(_): "accepted"
        case Err(issue):
            print "Graph codec issue: {issue.code}"
            issue.code

describe "Missing graph family must become a real typed codec":
    it "accepts a normalized multi-table graph with Unicode and empty locator":
        # @req: REQ-TRC-001, REQ-TRC-016
        # @ac: AC-TRC-001
        step("Decode a complete structured graph rather than a summary")
        expect(baseline_graph_result(baseline_graph_source())).to_equal("accepted")

    it "reports duplicate graph identity rather than unsupported family":
        # @req: REQ-TRC-001, REQ-TRC-006
        # @ac: AC-TRC-002
        val source = baseline_graph_source().replace("test_definitions |", "    \"source:example\", source_file, duplicate\ntest_definitions |")
        expect(baseline_graph_result(source)).to_equal("duplicate_identifier")

    it "reports invalid node kind rather than unsupported family":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        expect(baseline_graph_result(baseline_graph_source().replace("source_file", "invented_kind"))).to_equal("invalid_enum")
