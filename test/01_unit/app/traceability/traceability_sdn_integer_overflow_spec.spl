"""
# Reject overflowing traceability integer values

Purpose: prevent corrupted ordinal, revision and run-count scalars from being
accepted by the shared SDN parser. These component cases cover part of AC001;
full typed-family and document-consumption qualification remains separate.
"""

use std.spec.*
use std.spec.step
use std.common.sdn.parser.{parse_with_issues}

fn expect_trace_integer_overflow(source: text):
    var rejected = false
    match parse_with_issues(source):
        case Ok(_): rejected = false
        case Err(reason):
            rejected = true
            expect(reason).to_contain("integer_overflow")
    expect(rejected).to_equal(true)

describe "Traceability SDN integer overflow rejection":
    it "rejects one above the signed maximum":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Read a counter beyond the signed 64-bit maximum")
        expect_trace_integer_overflow("9223372036854775808")

    it "rejects one below the signed minimum":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Read an ordinal below the signed 64-bit minimum")
        expect_trace_integer_overflow("-9223372036854775809")

    it "rejects arbitrarily long integer spellings":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Reject oversized numeric scalars without wrapping or saturation")
        expect_trace_integer_overflow("9999999999999999999999999999999999999999")
        expect_trace_integer_overflow("-9999999999999999999999999999999999999999")

    it "retains both valid signed boundaries":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Accept exact limits through the checked scalar conversion")
        for source in ["-9223372036854775808", "9223372036854775807"]:
            var accepted = false
            match parse_with_issues(source):
                case Ok((value, issues)):
                    match value:
                        case Int(number):
                            accepted = true
                            expect(number.to_text()).to_equal(source)
                        case _: ()
                    expect(issues.len()).to_equal(0)
                case Err(_): ()
            expect(accepted).to_equal(true)
