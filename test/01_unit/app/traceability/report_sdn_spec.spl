# @tag:in-development
# @req REQ-TRC-001 REQ-TRC-013
use std.spec
use std.common.sdn.value.{SdnValue}
use std.common.sdn.parser.{parse_with_spans_and_issues}
use app.traceability.core.{TraceabilityWarning, traceability_report_to_sdn}

fn report_fields(source: text) -> Dict<text, SdnValue>:
    match parse_with_spans_and_issues(source):
        case Err(reason):
            fail(reason)
            {}
        case Ok(parsed):
            expect(parsed.2.len()).to_equal(0)
            match parsed.0:
                case SdnValue.Dict(fields): fields
                case _:
                    fail("report must be a genuine SDN dictionary")
                    {}

describe "SDN trace preview reports":
    it "does not turn an empty warning set into verified admission":
        val fields = report_fields(traceability_report_to_sdn([]))
        expect(fields["schema"]).to_equal(SdnValue.String("simple.trace.legacy-preview/v1"))
        expect(fields["qualification"]).to_equal(SdnValue.String("unverified"))
        expect(fields["admission_eligible"]).to_equal(SdnValue.Bool(false))
        expect(fields["warnings"]).to_equal(SdnValue.Array([]))

    it "round trips warning text and path through the native codec":
        val path = "目录/quoted \"name\", file.spl"
        val message = "first line\nsecond line, \"quoted\""
        val warning = TraceabilityWarning(code: "TRC-EXAMPLE", path: path, line: 17, message: message)
        val fields = report_fields(traceability_report_to_sdn([warning]))
        match fields["warnings"]:
            case SdnValue.Array(rows):
                expect(rows.len()).to_equal(1)
                match rows[0]:
                    case SdnValue.Dict(row):
                        expect(row["path"]).to_equal(SdnValue.String(path))
                        expect(row["message"]).to_equal(SdnValue.String(message))
                        expect(row["line"]).to_equal(SdnValue.Int(17))
                    case _: fail("warning must be a typed SDN record")
            case _: fail("warnings must be an SDN array")
