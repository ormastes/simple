"""
# Reject malformed quoted traceability values

Purpose: prevent a truncated source locator or extra document text from being
accepted as a clean SDN string. These are component contracts for AC001.
"""

use std.spec.*
use std.spec.step
use std.common.sdn.parser.{parse_with_issues}

fn expect_trace_quote_error(source: text, diagnostic: text):
    var rejected = false
    match parse_with_issues(source):
        case Ok(_): rejected = false
        case Err(reason):
            rejected = true
            expect(reason).to_contain(diagnostic)
    expect(rejected).to_equal(true)

describe "Traceability SDN quoted scalar rejection":
    it "rejects a missing unescaped closing quote":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Reject truncated and escaped-only closing delimiters")
        expect_trace_quote_error("\"unfinished", "unterminated")
        expect_trace_quote_error("\"escaped closing\\\"", "unterminated")

    it "rejects content after the quoted scalar":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Require complete consumption of a quoted scalar")
        expect_trace_quote_error("\"closed\" trailing", "trailing")
        expect_trace_quote_error("\"closed\" \"second\"", "trailing")

    it "preserves escaped delimiters backslashes Unicode and empty text":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Decode a valid quoted locator containing escaped delimiters")
        var accepted = false
        match parse_with_issues("\"한글 \\\"trace\\\" \\\\end\""):
            case Ok((value, issues)):
                match value:
                    case String(decoded):
                        accepted = true
                        expect(decoded).to_equal("한글 \"trace\" \\end")
                    case _: ()
                expect(issues.len()).to_equal(0)
            case Err(_): ()
        expect(accepted).to_equal(true)
        var empty_accepted = false
        match parse_with_issues("\"\""):
            case Ok((value, issues)):
                match value:
                    case String(decoded):
                        empty_accepted = true
                        expect(decoded).to_equal("")
                    case _: ()
                expect(issues.len()).to_equal(0)
            case Err(_): ()
        expect(empty_accepted).to_equal(true)
