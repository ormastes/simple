# @tag:in-development
# @req REQ-TRC-003 REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# Pure consistency fixtures. These authored inventories do not authenticate
# parser output, execute candidate code, or prove persisted execution selection.
use std.spec.*
use app.traceability.extract.sspec_inventory.{TraceSspecCase, TraceSspecInventory}
use app.traceability.extract.sspec_run_request.{TraceSspecPlanningContext, TraceSspecSource,
    TraceSspecPlanningInput, plan_sspec_inventories, build_sspec_trace_request_single_owner}
use std.common.traceability.run_request_codec.{encode_trace_run_request}
use std.common.crypto.sha256.{sha256_u8_hex}

fn planner_context() -> TraceSspecPlanningContext:
    TraceSspecPlanningContext(subject_id: "subject:fixture", configuration_id: "config:fixture",
        expectation_id: "expectation:fixture", binary_id: "binary:fixture", lane_id: "lane:fixture")

fn planner_fixture(path: text, body: text, kind: text) -> TraceSspecPlanningInput:
    val prefix = "use std.spec.*\ndescribe \"suite\":\n    "
    var keyword = "it"
    if kind == "slow": keyword = "slow_it"
    elif kind == "test": keyword = "test"
    elif kind == "example": keyword = "example"
    val source_text = prefix + keyword + " \"日本\":\n        " + body + "\n"
    var bytes: [u8] = []
    for byte in source_text.bytes(): bytes.push(byte)
    val digest = "sha256:" + sha256_u8_hex(bytes)
    val item = TraceSspecCase(test_path: path, case_name: "suite > 日本", leaf_name: "日本", kind: kind,
        suite_path: ["suite"], context_path: [], start_byte: prefix.len(), end_byte: source_text.len(), line: 3, column: 5)
    TraceSspecPlanningInput(
        source: TraceSspecSource(subject_id: "subject:fixture", test_path: path, source: source_text, source_sha256: digest),
        inventory: TraceSspecInventory(test_path: path, source_sha256: digest,
            extractor_version: "simple.sspec.literal-ast/v1", evidence_validity: "unverified", cases: [item]))

fn planner_reject(context: TraceSspecPlanningContext, inputs: [TraceSspecPlanningInput], reason_fragment: text):
    match plan_sspec_inventories(context, inputs):
        case Ok(_): fail("inconsistent or unsupported inventory produced a request")
        case Err(reason): expect(reason).to_contain(reason_fragment)

describe "Immutable SSpec inventory to unverified run request":
    it "preserves exact identities, selectors, kind and source metadata deterministically":
        val context = planner_context()
        val input = planner_fixture("test/日本_spec.spl", "assert(false)", "slow")
        match plan_sspec_inventories(context, [input]):
            case Err(reason): fail(reason)
            case Ok(first):
                expect(first.evidence_validity).to_equal("unverified")
                expect(first.request.subject_id).to_equal(context.subject_id)
                expect(first.request.configuration_id).to_equal(context.configuration_id)
                expect(first.request.expectation_id).to_equal(context.expectation_id)
                expect(first.request.binary_id).to_equal(context.binary_id)
                expect(first.request.cases[0].lane_id).to_equal(context.lane_id)
                expect(first.request.cases[0].case_name).to_equal("suite > 日本")
                expect(first.definitions[0].definition.kind).to_equal("slow")
                expect(first.definitions[0].source_sha256).to_equal(input.source.source_sha256)
                expect(first.definitions[0].definition.start_byte).to_equal(input.inventory.cases[0].start_byte)
                expect(first.definitions[0].case_id).to_equal(first.request.cases[0].case_id)
                expect(first.definitions[0].test_definition_id).to_equal(first.request.cases[0].test_definition_id)
                match plan_sspec_inventories(context, [input]):
                    case Err(reason): fail(reason)
                    case Ok(second):
                        expect(second.inventory_digest).to_equal(first.inventory_digest)
                        expect(encode_trace_run_request(second.request).unwrap()).to_equal(encode_trace_run_request(first.request).unwrap())

    it "changes definition identity when exact source bytes change with unchanged selectors":
        val first = plan_sspec_inventories(planner_context(), [planner_fixture("test/a_spec.spl", "assert(false)", "normal")]).unwrap()
        val changed = plan_sspec_inventories(planner_context(), [planner_fixture("test/a_spec.spl", "assert(true)", "normal")]).unwrap()
        expect(first.request.cases[0].case_name).to_equal(changed.request.cases[0].case_name)
        expect(first.request.cases[0].test_definition_id == changed.request.cases[0].test_definition_id).to_equal(false)
        expect(first.request.cases[0].case_id == changed.request.cases[0].case_id).to_equal(false)

    it "binds every frozen execution identity while retaining the source definition identity":
        val input = planner_fixture("test/a_spec.spl", "pass", "normal")
        val context = planner_context()
        val baseline = plan_sspec_inventories(context, [input]).unwrap()
        for field in ["subject", "configuration", "expectation", "binary", "lane"]:
            var changed = context
            var changed_input = input
            if field == "subject":
                changed.subject_id = "subject:other"
                var source = input.source
                source.subject_id = changed.subject_id
                changed_input.source = source
            elif field == "configuration": changed.configuration_id = "config:other"
            elif field == "expectation": changed.expectation_id = "expectation:other"
            elif field == "binary": changed.binary_id = "binary:other"
            else: changed.lane_id = "lane:other"
            val result = plan_sspec_inventories(changed, [changed_input]).unwrap()
            expect(result.request.cases[0].case_id == baseline.request.cases[0].case_id).to_equal(false)
            expect(result.request.cases[0].test_definition_id).to_equal(baseline.request.cases[0].test_definition_id)

    it "retains supplied file order and binds order in the envelope digest":
        val a = planner_fixture("test/a_spec.spl", "pass", "test")
        val b = planner_fixture("test/b_spec.spl", "pass", "example")
        val forward = plan_sspec_inventories(planner_context(), [a, b]).unwrap()
        val reversed = plan_sspec_inventories(planner_context(), [b, a]).unwrap()
        expect(forward.request.cases[0].test_path).to_equal("test/a_spec.spl")
        expect(reversed.request.cases[0].test_path).to_equal("test/b_spec.spl")
        expect(forward.request.cases[0].case_id).to_equal(reversed.request.cases[1].case_id)
        expect(forward.inventory_digest == reversed.inventory_digest).to_equal(false)
        expect(forward.definitions[0].definition.kind).to_equal("test")
        expect(forward.definitions[1].definition.kind).to_equal("example")

    it "rejects missing identity, duplicate source paths and a mismatched source subject":
        val input = planner_fixture("test/a_spec.spl", "pass", "normal")
        var context = planner_context()
        context.binary_id = ""
        planner_reject(context, [input], "identity")
        planner_reject(planner_context(), [input, input], "duplicate source path")
        context = planner_context()
        context.subject_id = "subject:other"
        planner_reject(context, [input], "source subject")
        planner_reject(planner_context(), [], "1 through 256")

    it "rejects source byte tampering, inconsistent inventory and forged validity":
        val input = planner_fixture("test/a_spec.spl", "pass", "normal")
        var changed = input
        var source = input.source
        source.source = source.source + "# changed\n"
        changed.source = source
        planner_reject(planner_context(), [changed], "exact source bytes")
        for fault in ["digest", "validity", "version"]:
            changed = input
            var inventory = input.inventory
            if fault == "digest": inventory.source_sha256 = "sha256:" + "0".repeat(64)
            elif fault == "validity": inventory.evidence_validity = "verified"
            else: inventory.extractor_version = "unknown/v2"
            changed.inventory = inventory
            planner_reject(planner_context(), [changed], "SSPEC-PLAN")

    it "rejects unsupported kinds, wrong selectors and spans inside UTF-8 code points":
        val input = planner_fixture("test/a_spec.spl", "pass", "normal")
        for fault in ["kind", "selector", "span", "overlap"]:
            var changed = input
            var inventory = input.inventory
            var item = inventory.cases[0]
            if fault == "kind": item.kind = "parameterized"
            elif fault == "selector": item.case_name = "invented selector"
            elif fault == "span": item.start_byte += 5
            inventory.cases = [item]
            if fault == "overlap": inventory.cases = [item, item]
            changed.inventory = inventory
            planner_reject(planner_context(), [changed], "SSPEC-PLAN")

    it "rejects aggregate source budgets before hashing mismatched source bytes":
        var inputs: [TraceSspecPlanningInput] = []
        for i in 0..5:
            var input = planner_fixture("test/file_{i}_spec.spl", "pass", "normal")
            var source = input.source
            source.source = "x".repeat(1048576)
            input.source = source
            inputs.push(input)
        planner_reject(planner_context(), inputs, "aggregate 4 MiB")

    it "parses two immutable source files without executing bodies and invalidates an edited definition":
        # Native frontend integration fixture: use only source records here;
        # builder must derive fresh inventories through the production parser.
        val a = planner_fixture("test/native_a_spec.spl", "assert(false)", "normal")
        val b = planner_fixture("test/native_b_spec.spl", "assert(false)", "example")
        match build_sspec_trace_request_single_owner(planner_context(), [a.source, b.source]):
            case Err(reason): fail("native source planning failed: {reason}")
            case Ok(first):
                expect(first.request.cases.len()).to_equal(2)
                expect(first.request.cases[0].test_path).to_equal(a.source.test_path)
                expect(first.request.cases[1].test_path).to_equal(b.source.test_path)
                expect(first.request.cases[0].case_name).to_equal("suite > 日本")
                expect(first.definitions[1].definition.kind).to_equal("example")
                val changed = planner_fixture("test/native_a_spec.spl", "assert(false) # exact source edit", "normal")
                match build_sspec_trace_request_single_owner(planner_context(), [changed.source, b.source]):
                    case Err(reason): fail("edited native source planning failed: {reason}")
                    case Ok(second):
                        expect(first.request.cases[0].test_definition_id == second.request.cases[0].test_definition_id).to_equal(false)
                        expect(first.request.cases[0].case_id == second.request.cases[0].case_id).to_equal(false)
                        expect(first.request.cases[1].case_id).to_equal(second.request.cases[1].case_id)
                        expect(first.inventory_digest == second.inventory_digest).to_equal(false)
