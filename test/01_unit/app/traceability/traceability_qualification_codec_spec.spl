"""Typed trace qualification format: schema validation is separate from trust.

The retained initial TDD baseline called the actual strict syntax parser.
These tests now call the implemented typed adapter; decoded claims have no
evidence authority.
"""

use std.spec.*
use std.spec.step
use std.common.traceability.qualification_v1.{trace_qualification_decode_v1}
use std.common.traceability.encode_v1.{trace_qualification_encode_v1, trace_document_decode_v1, trace_document_encode_v1}
use std.common.traceability.types_v1.*
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1}

fn qualification_fixture_v1() -> text:
    val lines = ["schema:", "    name: simple.trace.qualification", "    version: 1",
        "snapshot:", "    id: \"worktree:sha256:abc\"", "    kind: worktree", "    complete: true",
        "selection:", "    paths: [\"src/한 글.spl\"]", "    full_repository: false",
        "evaluation:", "    scope: all", "    profile: worktree", "    kind: structural",
        "    complete: true", "    exit_code: 0", "    qualification: incomplete", "diagnostics: []"]
    lines.join("\n") + "\n"

fn qualification_error_fixture_v1() -> text:
    val source = qualification_fixture_v1().replace("    exit_code: 0", "    exit_code: 1")
    val diagnostic = ["diagnostics:", "    - code: TRC001", "      severity: error",
        "      entity: \"feature:traceability\"", "      path: \"src/한 글.spl\"",
        "      path_available: true", "      span_available: true", "      line: 12", "      column: 3",
        "      message: \"Missing requirement link\"", "      snapshot_id: \"worktree:sha256:abc\"",
        "      rule_version: traceability/1", "      origin: declaration", "      repair: \"Declare requirement\""]
    source.replace("diagnostics: []", diagnostic.join("\n"))

fn expect_qualification_rejected(source: text, code: text, path: text):
    var rejected = false
    match trace_qualification_decode_v1(source, trace_qualification_codec_limits_v1()):
        case Ok(_): ()
        case Err(issue):
            rejected = true
            expect(issue.code).to_equal(code)
            expect(issue.path).to_equal(path)
            expect(issue.location_available).to_equal(false)
    expect(rejected).to_equal(true)

fn qualification_decoded_fixture_v1() -> TraceQualificationV1:
    val decoded = trace_qualification_decode_v1(qualification_fixture_v1(), trace_qualification_codec_limits_v1())
    var accepted = false
    var document = TraceQualificationV1(
        snapshot: TraceSnapshotV1(id: "", kind: "", complete: false),
        selection: TraceSelectionV1(paths: [], full_repository: false),
        evaluation: TraceEvaluationV1(scope: "", profile: "", kind: "", complete: false, exit_code: 2, qualification: "incomplete"), diagnostics: [])
    match decoded:
        case Ok(value):
            accepted = true
            document = value
        case Err(_): ()
    expect(accepted).to_equal(true)
    document

describe "Typed trace qualification format":
    it "rejects unsupported family and schema major":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Read an explicit supported schema instead of guessing the payload")
        expect_qualification_rejected(qualification_fixture_v1().replace("simple.trace.qualification", "simple.trace.receipt"), "unsupported_family", "schema.name")
        expect_qualification_rejected(qualification_fixture_v1().replace("version: 1", "version: 9"), "schema_version", "schema.version")

    it "rejects absent required and unknown semantic fields":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Account for every authored field without discarding extensions")
        expect_qualification_rejected(qualification_fixture_v1().replace("diagnostics: []\n", ""), "missing_field", "diagnostics")
        expect_qualification_rejected(qualification_fixture_v1() + "experimental: true\n", "unknown_field", "experimental")
        expect_qualification_rejected(qualification_fixture_v1().replace("    version: 1\n", "    version: 1\n    experimental: true\n"), "unknown_field", "schema.experimental")

    it "rejects scalar type coercion":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Preserve schema types instead of coercing counters or identities")
        expect_qualification_rejected(qualification_fixture_v1().replace("    version: 1", "    version: \"1\""), "wrong_type", "schema.version")
        expect_qualification_rejected(qualification_fixture_v1().replace("    id: \"worktree:sha256:abc\"", "    id: 7"), "wrong_type", "snapshot.id")
        expect_qualification_rejected(qualification_fixture_v1().replace("full_repository: false", "full_repository: null"), "wrong_type", "selection.full_repository")

    it "rejects invalid array members without keeping a partial result":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Require every selector and diagnostic to satisfy its element schema")
        expect_qualification_rejected(qualification_fixture_v1().replace("paths: [\"src/한 글.spl\"]", "paths: [17]"), "wrong_type", "selection.paths.0")
        expect_qualification_rejected(qualification_fixture_v1().replace("diagnostics: []", "diagnostics: [null]"), "wrong_type", "diagnostics.0")

    it "rejects unknown enum values":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Use named status dimensions with closed vocabularies")
        expect_qualification_rejected(qualification_fixture_v1().replace("kind: worktree", "kind: imaginary"), "invalid_enum", "snapshot.kind")
        expect_qualification_rejected(qualification_fixture_v1().replace("qualification: incomplete", "qualification: clean"), "invalid_enum", "evaluation.qualification")
        expect_qualification_rejected(qualification_fixture_v1().replace("scope: all", "scope: imaginary"), "invalid_enum", "evaluation.scope")

    it "rejects incomplete evaluation advertised as exit zero":
        # @req: REQ-TRC-001, REQ-TRC-013
        # @ac: AC-TRC-002
        step("Prevent incomplete evaluation from becoming a clean terminal result")
        val source = qualification_fixture_v1().replace("    complete: true\n    exit_code: 0", "    complete: false\n    exit_code: 0")
        expect_qualification_rejected(source, "inconsistent_result", "evaluation.exit_code")

    it "rejects diagnostic reference to a different snapshot":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Bind diagnostics to the document's declared subject")
        val source = qualification_error_fixture_v1().replace("      snapshot_id: \"worktree:sha256:abc\"", "      snapshot_id: \"worktree:sha256:other\"")
        expect_qualification_rejected(source, "missing_reference", "diagnostics.0.snapshot_id")

    it "rejects contradictory diagnostic availability":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Keep unavailable source positions distinct from fabricated coordinates")
        expect_qualification_rejected(qualification_error_fixture_v1().replace("span_available: true", "span_available: false"), "invalid_location", "diagnostics.0.line")
        expect_qualification_rejected(qualification_error_fixture_v1().replace("path_available: true", "path_available: false"), "invalid_location", "diagnostics.0.path")

    it "rejects noncanonical snapshot identity":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Validate identity grammar while preserving actual path text")
        expect_qualification_rejected(qualification_fixture_v1().replace("worktree:sha256:abc", "bad identity"), "invalid_identifier", "snapshot.id")

    it "rejects contradictory verdicts and diagnostic shapes":
        # @req: REQ-TRC-001, REQ-TRC-013
        # @ac: AC-TRC-002
        step("Keep completion exit and qualification fields mutually consistent")
        expect_qualification_rejected(qualification_fixture_v1().replace("qualification: incomplete", "qualification: unsatisfied"), "inconsistent_result", "evaluation.qualification")
        expect_qualification_rejected(qualification_fixture_v1().replace("    exit_code: 0", "    exit_code: 1"), "inconsistent_result", "diagnostics")
        expect_qualification_rejected(qualification_error_fixture_v1().replace("    exit_code: 1", "    exit_code: 0"), "inconsistent_result", "diagnostics")

    it "round trips a structural summary without inventing execution qualification":
        # @req: REQ-TRC-001, REQ-TRC-013
        # @ac: AC-TRC-001
        step("Validate the typed snapshot selection and structural result")
        val document = qualification_decoded_fixture_v1()
        expect(document.snapshot.id).to_equal("worktree:sha256:abc")
        expect(document.snapshot.complete).to_equal(true)
        expect(document.selection.paths.len()).to_equal(1)
        expect(document.selection.paths[0]).to_equal("src/한 글.spl")
        expect(document.selection.full_repository).to_equal(false)
        expect(document.evaluation.complete).to_equal(true)
        expect(document.evaluation.exit_code).to_equal(0)
        expect(document.evaluation.qualification).to_equal("incomplete")
        expect(document.diagnostics.len()).to_equal(0)
        var encoded = ""
        var encoded_ok = false
        match trace_qualification_encode_v1(document, trace_qualification_codec_limits_v1()):
            case Ok(output):
                encoded_ok = true
                encoded = output
                expect(output.ends_with("\n")).to_equal(true)
                expect(output.ends_with("\n\n")).to_equal(false)
            case Err(_): ()
        expect(encoded_ok).to_equal(true)
        var decoded_ok = false
        match trace_qualification_decode_v1(encoded, trace_qualification_codec_limits_v1()):
            case Ok(value):
                decoded_ok = true
                expect(value.selection.paths[0]).to_equal(document.selection.paths[0])
                expect(value.evaluation.qualification).to_equal("incomplete")
            case Err(_): ()
        expect(decoded_ok).to_equal(true)

    it "preserves a captured snapshot when evaluation is interrupted":
        # @req: REQ-TRC-001, REQ-TRC-013
        # @ac: AC-TRC-001
        step("Separate completed input capture from incomplete evaluation")
        for code in [2, 130]:
            val source = qualification_fixture_v1().replace("    complete: true\n    exit_code: 0", "    complete: false\n    exit_code: " + code.to_text())
            var accepted = false
            match trace_qualification_decode_v1(source, trace_qualification_codec_limits_v1()):
                case Ok(document):
                    accepted = true
                    expect(document.snapshot.complete).to_equal(true)
                    expect(document.evaluation.complete).to_equal(false)
                    expect(document.evaluation.exit_code).to_equal(code)
                    expect(document.evaluation.qualification).to_equal("incomplete")
                case Err(_): ()
            expect(accepted).to_equal(true)

    it "preserves exact diagnostic provenance path and availability":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-001
        step("Retain attributable diagnostics without synthesizing source locations")
        var accepted = false
        match trace_qualification_decode_v1(qualification_error_fixture_v1(), trace_qualification_codec_limits_v1()):
            case Ok(document):
                accepted = true
                expect(document.diagnostics.len()).to_equal(1)
                val item = document.diagnostics[0]
                expect(item.code).to_equal("TRC001")
                expect(item.entity).to_equal("feature:traceability")
                expect(item.path).to_equal("src/한 글.spl")
                expect(item.line).to_equal(12)
                expect(item.column).to_equal(3)
                expect(item.path_available).to_equal(true)
                expect(item.span_available).to_equal(true)
                expect(item.snapshot_id).to_equal(document.snapshot.id)
                expect(item.origin).to_equal("declaration")
            case Err(_): ()
        expect(accepted).to_equal(true)

    it "rejects invalid typed encoding and enforces output budgets":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Validate caller-constructed typed values before serializing a verdict")
        var document = qualification_decoded_fixture_v1()
        document.evaluation.scope = "imaginary"
        var rejected = false
        match trace_qualification_encode_v1(document, trace_qualification_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("invalid_enum")
        expect(rejected).to_equal(true)
        val valid = qualification_decoded_fixture_v1()
        var bounded = false
        match trace_qualification_encode_v1(valid, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_output_bytes: 1)):
            case Ok(_): ()
            case Err(issue):
                bounded = true
                expect(issue.code).to_equal("output_limit")
        expect(bounded).to_equal(true)

    it "dispatches only implemented document families":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject an unsupported family instead of constructing an empty summary")
        var accepted = false
        match trace_document_decode_v1(qualification_fixture_v1(), trace_document_codec_limits_v1()):
            case Ok(document):
                match document:
                    case Qualification(value):
                        accepted = true
                        expect(value.snapshot.kind).to_equal("worktree")
            case Err(_): ()
        expect(accepted).to_equal(true)
        val source = "schema:\n    name: simple.trace.receipt\n    version: 1\nnodes: []\n"
        var rejected = false
        match trace_document_decode_v1(source, trace_document_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("unsupported_family")
        expect(rejected).to_equal(true)

    it "preserves typed qualification refusals through generic document encoding":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject the same invalid scope through dedicated and generic public APIs")
        var invalid = qualification_decoded_fixture_v1()
        invalid.evaluation.scope = "imaginary"
        var direct_rejected = false
        var direct_code = ""
        var direct_path = ""
        match trace_qualification_encode_v1(invalid, trace_qualification_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                direct_rejected = true
                direct_code = issue.code
                direct_path = issue.path
        expect(direct_rejected).to_equal(true)
        expect(direct_code).to_equal("invalid_enum")
        expect(direct_path).to_equal("evaluation.scope")
        var generic_rejected = false
        match trace_document_encode_v1(TraceDocumentV1.Qualification(invalid), trace_document_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                generic_rejected = true
                expect(issue.code).to_equal(direct_code)
                expect(issue.path).to_equal(direct_path)
                expect(issue.location_available).to_equal(false)
        expect(generic_rejected).to_equal(true)
