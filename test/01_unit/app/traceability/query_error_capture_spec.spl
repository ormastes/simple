"""
# Trace query error reports snapshot capture explicitly

Every caller of `trace_query_error_v1` passes the capture state, so native
(cross-module) builds never need to evaluate a non-constant default argument,
and a NOT-FOUND error on a captured graph reports the snapshot as available.
"""
use std.spec
use app.traceability.query_render_v1.{trace_query_error_v1, TraceQueryCaptureV1}

describe "trace_query_error_v1 capture state":
    it "reports a captured snapshot as available":
        step("Render an SDN error for a captured snapshot")
        val out = trace_query_error_v1("TRACE-QUERY-NOT-FOUND: no requirement R1", "snap-1", "sdn", TraceQueryCaptureV1.Captured)
        expect(out).to_contain("snapshot_available: true")
        expect(out).to_contain("TRACE-QUERY-NOT-FOUND")

    it "reports an uncaptured snapshot as unavailable":
        step("Render an SDN error before any snapshot is captured")
        val out = trace_query_error_v1("boom", "unresolved", "sdn", TraceQueryCaptureV1.Uncaptured)
        expect(out).to_contain("snapshot_available: false")
        expect(out).to_contain("TRACE-QUERY-INFRASTRUCTURE")
