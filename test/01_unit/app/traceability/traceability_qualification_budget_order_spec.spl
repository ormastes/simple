"""Typed qualification encoding/ordering and additional boundary regressions."""

use std.spec.*
use std.spec.step
use std.common.traceability.types_v1.*
use std.common.traceability.qualification_v1.{trace_qualification_decode_v1}
use std.common.traceability.encode_v1.{trace_qualification_encode_v1}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1}

fn qualification_order_fixture_v1() -> TraceQualificationV1:
    TraceQualificationV1(snapshot: TraceSnapshotV1(id: "worktree:abc", kind: "worktree", complete: true),
        selection: TraceSelectionV1(paths: [], full_repository: false),
        evaluation: TraceEvaluationV1(scope: "all", profile: "worktree", kind: "structural", complete: true, exit_code: 0, qualification: "incomplete"), diagnostics: [])

fn qualification_order_diagnostic_v1(message: text) -> TraceDiagnosticV1:
    TraceDiagnosticV1(code: "TRC001", severity: "warning", entity: "feature:traceability", path: "src/한 글.spl",
        path_available: true, span_available: false, line: 0, column: 0, message: message,
        snapshot_id: "worktree:abc", rule_version: "traceability/1", origin: "declaration", repair: "Declare requirement")

fn qualification_order_encoded_v1(document: TraceQualificationV1) -> text:
    var accepted = false
    var output = ""
    match trace_qualification_encode_v1(document, trace_qualification_codec_limits_v1()):
        case Ok(value):
            accepted = true
            output = value
        case Err(_): ()
    expect(accepted).to_equal(true)
    output

fn expect_order_decode_error_v1(source: text, code: text, path: text):
    var rejected = false
    match trace_qualification_decode_v1(source, trace_qualification_codec_limits_v1()):
        case Ok(_): ()
        case Err(issue):
            rejected = true
            expect(issue.code).to_equal(code)
            expect(issue.path).to_equal(path)
    expect(rejected).to_equal(true)

describe "Qualification bounded output and diagnostic order":
    it "does not encode more bytes than its same-limit decoder accepts":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Bound encoded bytes by both output and strict input budgets")
        val document = qualification_order_fixture_v1()
        var rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_source_bytes: 1))):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("output_limit")
        expect(rejected).to_equal(true)

    it "chooses a deterministic unknown field independent of authored order":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Diagnose the same invalid schema even when dictionary order changes")
        val wire = qualification_order_encoded_v1(qualification_order_fixture_v1())
        val suffix = wire.substring(1, wire.len())
        expect_order_decode_error_v1(r"{z_extra: true, a_extra: true, " + suffix, "unknown_field", "a_extra")
        expect_order_decode_error_v1(r"{a_extra: true, z_extra: true, " + suffix, "unknown_field", "a_extra")

    it "sorts diagnostics deterministically and preserves repeated codes and records":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-001
        step("Keep provenance-bearing repeated diagnostics while ordering machine output")
        val first = qualification_order_diagnostic_v1("Alpha")
        val second = qualification_order_diagnostic_v1("Zulu")
        var left = qualification_order_fixture_v1()
        left.diagnostics = [second, first, first]
        var right = qualification_order_fixture_v1()
        right.diagnostics = [first, second, first]
        val output = qualification_order_encoded_v1(left)
        expect(output).to_equal(qualification_order_encoded_v1(right))
        var accepted = false
        match trace_qualification_decode_v1(output, trace_qualification_codec_limits_v1()):
            case Ok(document):
                accepted = true
                expect(document.diagnostics.len()).to_equal(3)
                expect(document.diagnostics[0].message).to_equal("Alpha")
                expect(document.diagnostics[1].message).to_equal("Alpha")
                expect(document.diagnostics[2].message).to_equal("Zulu")
                expect(document.diagnostics[0].code).to_equal(document.diagnostics[2].code)
            case Err(_): ()
        expect(accepted).to_equal(true)

    it "rejects invalid members between valid selectors and wrong nested boundary types":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Prevent partial list acceptance and reject every nested schema boundary")
        val wire = qualification_order_encoded_v1(qualification_order_fixture_v1())
        expect_order_decode_error_v1(wire.replace("paths: []", "paths: [src/a, 7, src/b]"), "wrong_type", "selection.paths.1")
        expect_order_decode_error_v1(wire.replace("kind: structural", "kind: 7"), "wrong_type", "evaluation.kind")
        expect_order_decode_error_v1(wire.replace("full_repository: false", "full_repository: 1"), "wrong_type", "selection.full_repository")
        expect_order_decode_error_v1(wire.replace("kind: worktree", "kind: true"), "wrong_type", "snapshot.kind")

    it "enforces typed selector diagnostic and text budgets in both directions":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject oversized typed values before constructing output collections")
        var document = qualification_order_fixture_v1()
        document.selection.paths = ["src/a"]
        var rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_selectors: 0)):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("selector_limit")
        expect(rejected).to_equal(true)
        document.diagnostics = [qualification_order_diagnostic_v1("Warning")]
        var diagnostic_rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_diagnostics: 0)):
            case Ok(_): ()
            case Err(issue):
                diagnostic_rejected = true
                expect(issue.code).to_equal("diagnostic_limit")
        expect(diagnostic_rejected).to_equal(true)
        val wire = qualification_order_encoded_v1(qualification_order_fixture_v1())
        var text_rejected = false
        match trace_qualification_decode_v1(wire, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_text_bytes: 0)):
            case Ok(_): ()
            case Err(issue):
                text_rejected = true
                expect(issue.code).to_equal("text_limit")
        expect(text_rejected).to_equal(true)

    it "marks budget origins unavailable and preserves located syntax errors":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Avoid fabricating source coordinates for configuration failures")
        var budget_rejected = false
        match trace_qualification_decode_v1("source", TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_source_bytes: 1))):
            case Ok(_): ()
            case Err(issue):
                budget_rejected = true
                expect(issue.code).to_equal("source_limit")
                expect(issue.location_available).to_equal(false)
                expect(issue.line).to_equal(0)
                expect(issue.column).to_equal(0)
        expect(budget_rejected).to_equal(true)
        var syntax_rejected = false
        match trace_qualification_decode_v1("\"unfinished", trace_qualification_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                syntax_rejected = true
                expect(issue.code).to_equal("unterminated_quote")
                expect(issue.location_available).to_equal(true)
                expect(issue.offset).to_equal(11)
                expect(issue.line).to_equal(1)
                expect(issue.column).to_equal(12)
        expect(syntax_rejected).to_equal(true)

    it "accepts the exact canonical cap and rejects one byte less including LF":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Round trip successful encoding with the identical effective byte budget")
        val document = qualification_order_fixture_v1()
        val wire = qualification_order_encoded_v1(document)
        val limits = TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_source_bytes: wire.len()), max_output_bytes: wire.len())
        var encoded = false
        match trace_qualification_encode_v1(document, limits):
            case Ok(output):
                encoded = true
                expect(output).to_equal(wire)
            case Err(_): ()
        expect(encoded).to_equal(true)
        var decoded = false
        match trace_qualification_decode_v1(wire, limits):
            case Ok(value):
                decoded = true
                expect(value.snapshot.id).to_equal(document.snapshot.id)
            case Err(_): ()
        expect(decoded).to_equal(true)
        var rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_source_bytes: wire.len() - 1))):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("output_limit")
        expect(rejected).to_equal(true)

    it "checks minimum output before materializing oversized diagnostic text":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Bound dynamic text before escaping and sorting machine output")
        var text = "large"
        for index in 0..16: text = text + text
        var document = qualification_order_fixture_v1()
        document.diagnostics = [qualification_order_diagnostic_v1(text)]
        var rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_output_bytes: 1024)):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("output_limit")
        expect(rejected).to_equal(true)

    it "enforces exact semantic node and depth limits while leaving read and write budgets distinct":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Use the shared SDN resource contract for the closed summary schema")
        val document = qualification_order_fixture_v1()
        var accepted = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_nodes: 37, max_depth: 3))):
            case Ok(_): accepted = true
            case Err(_): ()
        expect(accepted).to_equal(true)
        var rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_nodes: 36))):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("node_limit")
        expect(rejected).to_equal(true)
        var depth_rejected = false
        match trace_qualification_encode_v1(document, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(max_depth: 2))):
            case Ok(_): ()
            case Err(issue):
                depth_rejected = true
                expect(issue.code).to_equal("depth_limit")
        expect(depth_rejected).to_equal(true)
        val wire = qualification_order_encoded_v1(document)
        var decoded = false
        match trace_qualification_decode_v1(wire, TraceQualificationCodecLimitsV1(sdn: SdnStrictLimitsV1(), max_output_bytes: 0)):
            case Ok(_): decoded = true
            case Err(_): ()
        expect(decoded).to_equal(true)

    it "rejects invalid middle diagnostics and unavailable-path contradictions":
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Preserve list cardinality and both directions of availability")
        var document = qualification_order_fixture_v1()
        document.diagnostics = [qualification_order_diagnostic_v1("Alpha"), qualification_order_diagnostic_v1("Zulu")]
        val wire = qualification_order_encoded_v1(document)
        val corrupted = wire.replace("}, " + r"{code:", "}, null, " + r"{code:")
        expect_order_decode_error_v1(corrupted, "wrong_type", "diagnostics.1")
        var invalid = qualification_order_diagnostic_v1("Warning")
        invalid.path = ""
        document.diagnostics = [invalid]
        var rejected = false
        match trace_qualification_encode_v1(document, trace_qualification_codec_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("invalid_location")
                expect(issue.path).to_equal("diagnostics.0.path")
        expect(rejected).to_equal(true)

    it "preserves consistent claimed evidence statuses without constructing trusted evidence":
        # @req: REQ-TRC-001, REQ-TRC-013
        # @ac: AC-TRC-001
        step("Read wire claims as data while evidence authority stays with its owner")
        var document = qualification_order_fixture_v1()
        document.evaluation.kind = "evidence"
        document.evaluation.qualification = "satisfied"
        val wire = qualification_order_encoded_v1(document)
        var decoded = false
        match trace_qualification_decode_v1(wire, trace_qualification_codec_limits_v1()):
            case Ok(value):
                decoded = true
                expect(value.evaluation.kind).to_equal("evidence")
                expect(value.evaluation.qualification).to_equal("satisfied")
            case Err(_): ()
        expect(decoded).to_equal(true)
