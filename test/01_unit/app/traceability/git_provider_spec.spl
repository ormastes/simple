# @tag:in-development
# Unit checks for trust-boundary rejection before Git process creation.
import std.spec
use std.spec.step
use app.traceability.snapshot.git_provider.{GitSnapshotRequest, snapshot_git_inputs}
use std.common.crypto.sha1.{sha1_u8_hex}

describe "Git snapshot provider request validation":
    it "hashes Git object framing with the shared SHA-1 byte implementation":
        step("Hash the canonical Git blob header and body")
        val framed: [u8] = [98, 108, 111, 98, 32, 51, 0, 97, 98, 99]
        expect(sha1_u8_hex(framed)).to_equal("f2ba8f84ab5c1bce84a7b441cb1959cfc7093b7f")

    it "rejects traversal paths before launching Git":
        step("Request a path that escapes the repository root")
        val result = snapshot_git_inputs(GitSnapshotRequest(
            repository: ".", selector: "HEAD", paths: ["../outside"],
            max_entries: 100, max_blob_bytes: 4096, max_total_bytes: 16384))
        expect(result.is_err()).to_equal(true)

    it "rejects duplicate selected paths before launching Git":
        step("Request the same immutable input path twice")
        val result = snapshot_git_inputs(GitSnapshotRequest(
            repository: ".", selector: "HEAD", paths: ["src/app/main.spl", "src/app/main.spl"],
            max_entries: 100, max_blob_bytes: 4096, max_total_bytes: 16384))
        expect(result.is_err()).to_equal(true)
