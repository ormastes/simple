# @tag:in-development
# @req REQ-TRC-017
# @ac AC-TRC-028
# Partition/update parity targets the independent aggregate extractor and resolver.
use std.spec.*
use std.common.traceability.model.*
use std.common.traceability.incremental.*
use std.common.traceability.resolve.{resolve_trace_graph}
use app.traceability.extract.snapshot_facts.{extract_snapshot_trace_facts, extract_snapshot_trace_facts_cold}
use app.traceability.extract.snapshot_partitions.*

fn partition_subject(snapshot_id: text) -> SnapshotSubject:
    SnapshotSubject(repository_id: "repo:partition", snapshot_id: snapshot_id, kind: "git_tree",
        revision_id: "rev:" + snapshot_id, tree_id: "tree:" + snapshot_id, object_format: "sha256")

fn partition_snapshot(snapshot_id: text, with_test: bool) -> SnapshotInput:
    var artifacts = [SnapshotArtifact(path: "src/app/a.spl", blob_id: "blob:source", content: "fn a(): 1", visibility: "selected_content")]
    if with_test: artifacts.push(SnapshotArtifact(path: "test/01_unit/app/a_spec.spl", blob_id: "blob:test", content: "# test", visibility: "selected_content"))
    SnapshotInput(subject: partition_subject(snapshot_id), artifacts: artifacts, complete: true)

fn partition_policy() -> TracePolicy:
    TracePolicy(id: "policy:partition", conventions: [TraceConventionRule(id: "app-unit", source_root: "src/app/",
        target_root: "test/01_unit/app/", source_suffix: ".spl", target_suffix: "_spec.spl",
        relation: TraceRelation.Targets, version: "1")], authorities: [], max_nodes: 100, max_claims: 100)

fn partition_policy_binding() -> text:
    trace_snapshot_policy_binding(partition_policy())

fn partition_set(snapshot: SnapshotInput, declarations: [text]) -> Result<TraceSnapshotPartitionSet, text>:
    build_trace_snapshot_partition_set(snapshot, declarations, "extractor:v1", "schema:v1",
        partition_policy(), partition_policy_binding(), "config:v1", "manifest:" + snapshot.subject.snapshot_id,
        "generation:" + snapshot.subject.snapshot_id)

fn partition_cold_graph(snapshot: SnapshotInput, declarations: [text]) -> TraceGraph:
    resolve_trace_graph(extract_snapshot_trace_facts_cold(snapshot, partition_policy(), declarations,
        "manifest:" + snapshot.subject.snapshot_id, "generation:" + snapshot.subject.snapshot_id), partition_policy())

fn partition_facts_equal(actual: TraceFacts, expected: TraceFacts):
    expect(actual.subject).to_equal(expected.subject)
    expect(actual.input_manifest_id).to_equal(expected.input_manifest_id)
    expect(actual.nodes).to_equal(expected.nodes)
    expect(actual.test_definitions).to_equal(expected.test_definitions)
    expect(actual.claims).to_equal(expected.claims)
    expect(actual.origins).to_equal(expected.origins)
    expect(actual.locators).to_equal(expected.locators)
    expect(actual.diagnostics).to_equal(expected.diagnostics)
    expect(actual.generation_id).to_equal(expected.generation_id)
    expect(actual.complete).to_equal(expected.complete)

fn partition_graph_equal(actual: TraceGraph, expected: TraceGraph):
    expect(actual.subject).to_equal(expected.subject)
    expect(actual.input_manifest_id).to_equal(expected.input_manifest_id)
    expect(actual.generation_id).to_equal(expected.generation_id)
    expect(actual.nodes).to_equal(expected.nodes)
    expect(actual.test_definitions).to_equal(expected.test_definitions)
    expect(actual.claims).to_equal(expected.claims)
    expect(actual.edges).to_equal(expected.edges)
    expect(actual.edge_origins).to_equal(expected.edge_origins)
    expect(actual.origins).to_equal(expected.origins)
    expect(actual.locators).to_equal(expected.locators)
    expect(actual.diagnostics).to_equal(expected.diagnostics)
    expect(actual.complete).to_equal(expected.complete)

fn declaration_with_missing_requirement(requirement_id: text) -> text:
    '{schema: {name: simple.trace.declarations, version: 1}, nodes: [{id: "feature:owner", kind: feature, title: Owner}], test_definitions: [], claims: [{id: "claim:owner", from_id: "feature:owner", relation: specifies, to_id: "' + requirement_id + '", origin_id: "origin:owner", operation: add, rule_id: "decl-v1", scope_id: ""}], origins: [{id: "origin:owner", kind: explicit, locator: "line:1"}], locators: [{entity_id: "feature:owner", path: "doc/a.trace.sdn", locator_kind: file, locator: ""}]}'

fn declaration_with_existing_requirement(requirement_id: text) -> text:
    '{schema: {name: simple.trace.declarations, version: 1}, nodes: [{id: "feature:owner", kind: feature, title: Owner}, {id: "' + requirement_id + '", kind: requirement, title: Existing}], test_definitions: [], claims: [{id: "claim:owner", from_id: "feature:owner", relation: specifies, to_id: "' + requirement_id + '", origin_id: "origin:owner", operation: add, rule_id: "decl-v1", scope_id: ""}], origins: [{id: "origin:owner", kind: explicit, locator: "line:1"}], locators: [{entity_id: "feature:owner", path: "doc/a.trace.sdn", locator_kind: file, locator: ""}, {entity_id: "' + requirement_id + '", path: "doc/a.trace.sdn", locator_kind: file, locator: ""}]}'

fn declaration_with_requirement(requirement_id: text, owner_path: text) -> text:
    '{schema: {name: simple.trace.declarations, version: 1}, nodes: [{id: "' + requirement_id + '", kind: requirement, title: New requirement}], test_definitions: [], claims: [], origins: [], locators: [{entity_id: "' + requirement_id + '", path: "' + owner_path + '", locator_kind: file, locator: ""}]}'

fn declaration_with_duplicate_target_membership() -> text:
    '{schema: {name: simple.trace.declarations, version: 1}, nodes: [{id: "suite:one", kind: test_suite, title: Suite one}, {id: "suite:two", kind: test_suite, title: Suite two}], test_definitions: [], claims: [], origins: [], locators: [{entity_id: "suite:one", path: "test/01_unit/app/a_spec.spl", locator_kind: file, locator: ""}, {entity_id: "suite:two", path: "test/01_unit/app/a_spec.spl", locator_kind: file, locator: ""}]}'

describe "Retained owner-local snapshot fact partitions (in-development)":
    it "reuses unchanged input partitions and matches complete typed cold graph output":
        val old = partition_snapshot("snap:old", false)
        val candidate = partition_snapshot("snap:new", false)
        match partition_set(old, []):
            case Err(reason): fail(reason)
            case Ok(base):
                val base_fingerprint = base.facts_fingerprint
                partition_facts_equal(base.facts, extract_snapshot_trace_facts_cold(old, partition_policy(), [],
                    "manifest:snap:old", "generation:snap:old"))
                partition_facts_equal(extract_snapshot_trace_facts(old, partition_policy(), [],
                    "manifest:snap:old", "generation:snap:old"), base.facts)
                match update_trace_snapshot_partitions(base, candidate, [], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.reused_paths).to_equal(["src/app/a.spl"])
                        expect(base.partitions[0].facts.subject.snapshot_id).to_equal("snap:old")
                        expect(base.partitions[0].artifact.blob_id).to_equal("blob:source")
                        expect(base.facts_fingerprint).to_equal(base_fingerprint)
                        partition_facts_equal(base.facts, extract_snapshot_trace_facts_cold(old, partition_policy(), [],
                            "manifest:snap:old", "generation:snap:old"))
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, []))

    it "invalidates the unchanged source owner when a convention target joins membership":
        val old = partition_snapshot("snap:old", false)
        val candidate = partition_snapshot("snap:new", true)
        match partition_set(old, []):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, [], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("src/app/a.spl")).to_equal(true)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, []))

    it "invalidates a source when a new declaration changes target-path entity membership":
        val old = partition_snapshot("snap:old", true)
        val membership = SnapshotArtifact(path: "doc/suites.trace.sdn", blob_id: "blob:suites",
            content: declaration_with_duplicate_target_membership(), visibility: "selected_content")
        val candidate = SnapshotInput(subject: partition_subject("snap:new"), artifacts: old.artifacts + [membership], complete: true)
        match partition_set(old, []):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, ["doc/suites.trace.sdn"],
                    "extractor:v1", "schema:v1", partition_policy(), partition_policy_binding(),
                    "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("src/app/a.spl")).to_equal(true)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, ["doc/suites.trace.sdn"]))

    it "invalidates a retained negative identity owner when the missing ID appears":
        val missing = "requirement:new"
        val owner = SnapshotArtifact(path: "doc/a.trace.sdn", blob_id: "blob:owner",
            content: declaration_with_missing_requirement(missing), visibility: "selected_content")
        val old = SnapshotInput(subject: partition_subject("snap:old"), artifacts: [owner], complete: true)
        val newcomer = SnapshotArtifact(path: "doc/b.trace.sdn", blob_id: "blob:new",
            content: declaration_with_requirement(missing, "doc/b.trace.sdn"), visibility: "selected_content")
        val candidate = SnapshotInput(subject: partition_subject("snap:new"), artifacts: [owner, newcomer], complete: true)
        match partition_set(old, ["doc/a.trace.sdn"]):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, ["doc/a.trace.sdn", "doc/b.trace.sdn"],
                    "extractor:v1", "schema:v1", partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new",
                    "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("doc/a.trace.sdn")).to_equal(true)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, ["doc/a.trace.sdn", "doc/b.trace.sdn"]))

    it "invalidates a retained unique-identity owner when a duplicate identity appears":
        val identity = "requirement:duplicate"
        val owner = SnapshotArtifact(path: "doc/a.trace.sdn", blob_id: "blob:owner",
            content: declaration_with_existing_requirement(identity), visibility: "selected_content")
        val old = SnapshotInput(subject: partition_subject("snap:old"), artifacts: [owner], complete: true)
        val second = SnapshotArtifact(path: "doc/b.trace.sdn", blob_id: "blob:b",
            content: declaration_with_requirement(identity, "doc/b.trace.sdn"), visibility: "selected_content")
        val candidate = SnapshotInput(subject: partition_subject("snap:new"), artifacts: [owner, second], complete: true)
        match partition_set(old, ["doc/a.trace.sdn"]):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, ["doc/a.trace.sdn", "doc/b.trace.sdn"],
                    "extractor:v1", "schema:v1", partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new",
                    "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("doc/a.trace.sdn")).to_equal(true)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, ["doc/a.trace.sdn", "doc/b.trace.sdn"]))

    it "reextracts a changed owner and matches cold facts after replacement":
        val old = partition_snapshot("snap:old", false)
        var candidate = partition_snapshot("snap:new", false)
        var changed = candidate.artifacts[0]
        changed.blob_id = "blob:changed"
        changed.content = "fn a(): 2"
        candidate.artifacts = [changed]
        match partition_set(old, []):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, [], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.reused_paths.len()).to_equal(0)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, []))

    it "retains malformed owner diagnostics and refuses dependency-complete reuse":
        val broken = SnapshotArtifact(path: "doc/broken.trace.sdn", blob_id: "blob:broken",
            content: "{schema: [malformed]", visibility: "selected_content")
        val snapshot = SnapshotInput(subject: partition_subject("snap:broken"), artifacts: [broken], complete: true)
        match partition_set(snapshot, ["doc/broken.trace.sdn"]):
            case Err(reason): fail(reason)
            case Ok(base):
                expect(base.facts.complete).to_equal(false)
                expect(base.dependency_inventory_complete).to_equal(false)
                match update_trace_snapshot_partitions(base, snapshot, ["doc/broken.trace.sdn"], "extractor:v1",
                    "schema:v1", partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:broken",
                    "generation:snap:broken", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.facts.complete).to_equal(false)
                        expect(updated.invalidation.full_rebuild).to_equal(true)

    it "forces a full rebuild when retained dependency rows fail their fingerprint":
        val snapshot = partition_snapshot("snap:deps", false)
        match partition_set(snapshot, []):
            case Err(reason): fail(reason)
            case Ok(base):
                var mutated_base = base
                mutated_base.dependencies = []
                match update_trace_snapshot_partitions(mutated_base, snapshot, [], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:deps",
                    "generation:snap:deps", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.full_rebuild).to_equal(true)
                        expect(updated.partition_set.dependency_inventory_complete).to_equal(false)

    it "binds policy contents and refuses a caller-supplied mismatched binding":
        val source = partition_snapshot("snap:policy", false)
        match build_trace_snapshot_partition_set(source, [], "extractor:v1", "schema:v1", partition_policy(),
            "sha256:wrong-policy-bytes", "config:v1", "manifest:snap:policy", "generation:snap:policy"):
            case Ok(_): fail("mismatched policy binding accepted")
            case Err(reason): expect(reason).to_contain("does not match exact policy contents")
        var changed_policy = partition_policy()
        var rule = changed_policy.conventions[0]
        rule.version = "2"
        changed_policy.conventions = [rule]
        expect(trace_snapshot_policy_binding(changed_policy) == partition_policy_binding()).to_equal(false)
        var duplicate_policy = partition_policy()
        duplicate_policy.conventions = duplicate_policy.conventions + [duplicate_policy.conventions[0]]
        expect(trace_snapshot_policy_binding(duplicate_policy) == partition_policy_binding()).to_equal(false)

    it "reextracts every owner when policy contents change under a stable policy ID":
        val old = partition_snapshot("snap:old", false)
        val candidate = partition_snapshot("snap:new", false)
        match partition_set(old, []):
            case Err(reason): fail(reason)
            case Ok(base):
                var changed_policy = partition_policy()
                var rule = changed_policy.conventions[0]
                rule.version = "2"
                changed_policy.conventions = [rule]
                match update_trace_snapshot_partitions(base, candidate, [], "extractor:v1", "schema:v1",
                    changed_policy, trace_snapshot_policy_binding(changed_policy), "config:v1", "manifest:snap:new",
                    "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.reused_paths.len()).to_equal(0)
                        expect(updated.invalidation.full_rebuild).to_equal(true)
                        partition_graph_equal(updated.graph, resolve_trace_graph(extract_snapshot_trace_facts_cold(candidate,
                            changed_policy, [], "manifest:snap:new", "generation:snap:new"), changed_policy))

fn declaration_with_claim_to(target_id: text) -> text:
    '{schema: {name: simple.trace.declarations, version: 1}, nodes: [{id: "feature:owner", kind: feature, title: Owner}], test_definitions: [], claims: [{id: "claim:owner", from_id: "feature:owner", relation: specifies, to_id: "' + target_id + '", origin_id: "origin:owner", operation: add, rule_id: "decl-v1", scope_id: ""}], origins: [{id: "origin:owner", kind: explicit, locator: "line:1"}], locators: [{entity_id: "feature:owner", path: "doc/a.trace.sdn", locator_kind: file, locator: ""}]}'

fn tight_policy() -> TracePolicy:
    var policy = partition_policy()
    policy.max_nodes = 2
    policy

fn oracle_snapshot(snapshot_id: text) -> SnapshotInput:
    val broken = SnapshotArtifact(path: "doc/broken.trace.sdn", blob_id: "blob:broken", content: "{schema: [malformed]", visibility: "selected_content")
    val good = SnapshotArtifact(path: "doc/b.trace.sdn", blob_id: "blob:b", content: declaration_with_requirement("requirement:x", "doc/b.trace.sdn"), visibility: "selected_content")
    val base = partition_snapshot(snapshot_id, true)
    SnapshotInput(subject: partition_subject(snapshot_id), artifacts: [broken, good, base.artifacts[0], base.artifacts[1]], complete: true)

describe "Partition review blockers (in-development)":
    it "invalidates an identity consumer when only the identity's declared locator moves":
        val owner = SnapshotArtifact(path: "doc/a.trace.sdn", blob_id: "blob:owner", content: declaration_with_claim_to("requirement:x"), visibility: "selected_content")
        val before = SnapshotArtifact(path: "doc/b.trace.sdn", blob_id: "blob:b1", content: declaration_with_requirement("requirement:x", "doc/b.trace.sdn"), visibility: "selected_content")
        val after = SnapshotArtifact(path: "doc/b.trace.sdn", blob_id: "blob:b2", content: declaration_with_requirement("requirement:x", "src/app/a.spl"), visibility: "selected_content")
        val source = partition_snapshot("snap:old", false).artifacts[0]
        val old = SnapshotInput(subject: partition_subject("snap:old"), artifacts: [owner, before, source], complete: true)
        val candidate = SnapshotInput(subject: partition_subject("snap:new"), artifacts: [owner, after, source], complete: true)
        val decls = ["doc/a.trace.sdn", "doc/b.trace.sdn"]
        match partition_set(old, decls):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, decls, "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("doc/a.trace.sdn")).to_equal(true)
                        partition_graph_equal(updated.graph, partition_cold_graph(candidate, decls))

    it "invalidates a consumer of a fallback artifact identity when that artifact is deleted":
        val fallback = "artifact:746573742f30315f756e69742f6170702f615f737065632e73706c"
        val owner = SnapshotArtifact(path: "doc/a.trace.sdn", blob_id: "blob:owner", content: declaration_with_claim_to(fallback), visibility: "selected_content")
        val old = SnapshotInput(subject: partition_subject("snap:old"), artifacts: partition_snapshot("snap:old", true).artifacts + [owner], complete: true)
        val candidate = SnapshotInput(subject: partition_subject("snap:new"), artifacts: partition_snapshot("snap:new", false).artifacts + [owner], complete: true)
        match partition_set(old, ["doc/a.trace.sdn"]):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, candidate, ["doc/a.trace.sdn"], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.affected_paths.contains("doc/a.trace.sdn")).to_equal(true)

    it "reports an incomplete full rebuild when the dependency inventory cannot be classified":
        val broken = SnapshotArtifact(path: "doc/broken.trace.sdn", blob_id: "blob:broken", content: "{schema: [malformed]", visibility: "selected_content")
        val snapshot = SnapshotInput(subject: partition_subject("snap:broken"), artifacts: [broken], complete: true)
        match partition_set(snapshot, ["doc/broken.trace.sdn"]):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, snapshot, ["doc/broken.trace.sdn"], "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:broken", "generation:snap:broken", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.invalidation.full_rebuild).to_equal(true)
                        expect(updated.invalidation.complete).to_equal(false)

    it "rebinds and fully rebuilds when a policy differs only by a duplicated rule":
        var dup = partition_policy()
        dup.conventions = dup.conventions + [dup.conventions[0]]
        expect(trace_snapshot_policy_binding(dup) == partition_policy_binding()).to_equal(false)
        match partition_set(partition_snapshot("snap:old", false), []):
            case Err(reason): fail(reason)
            case Ok(base):
                match update_trace_snapshot_partitions(base, partition_snapshot("snap:new", false), [], "extractor:v1", "schema:v1",
                    dup, partition_policy_binding(), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Ok(_): fail("stale caller binding accepted for a different policy")
                    case Err(reason): expect(reason).to_contain("does not match exact policy contents")
                match update_trace_snapshot_partitions(base, partition_snapshot("snap:new", false), [], "extractor:v1", "schema:v1",
                    dup, trace_snapshot_policy_binding(dup), "config:v1", "manifest:snap:new", "generation:snap:new", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        expect(updated.reused_paths.len()).to_equal(0)
                        expect(updated.invalidation.full_rebuild).to_equal(true)

    it "matches full cold TraceFacts on error branches (malformed and missing declarations)":
        val snapshot = oracle_snapshot("snap:err")
        val decls = ["doc/broken.trace.sdn", "doc/b.trace.sdn", "doc/absent.trace.sdn"]
        val cold = extract_snapshot_trace_facts_cold(snapshot, partition_policy(), decls, "manifest:snap:err", "generation:snap:err")
        partition_facts_equal(extract_snapshot_trace_facts(snapshot, partition_policy(), decls, "manifest:snap:err", "generation:snap:err"), cold)
        match partition_set(snapshot, decls):
            case Err(reason): fail(reason)
            case Ok(base):
                partition_facts_equal(base.facts, cold)
                val next = oracle_snapshot("snap:err2")
                match update_trace_snapshot_partitions(base, next, decls, "extractor:v1", "schema:v1",
                    partition_policy(), partition_policy_binding(), "config:v1", "manifest:snap:err2", "generation:snap:err2", [], [], [], 100):
                    case Err(reason): fail(reason)
                    case Ok(updated):
                        partition_facts_equal(updated.facts, extract_snapshot_trace_facts_cold(next,
                            partition_policy(), decls, "manifest:snap:err2", "generation:snap:err2"))

    it "matches full cold TraceFacts when the node budget is exhausted":
        val snapshot = oracle_snapshot("snap:budget")
        val decls = ["doc/broken.trace.sdn", "doc/b.trace.sdn"]
        val cold = extract_snapshot_trace_facts_cold(snapshot, tight_policy(), decls, "manifest:snap:budget", "generation:snap:budget")
        expect(cold.complete).to_equal(false)
        match build_trace_snapshot_partition_set(snapshot, decls, "extractor:v1", "schema:v1", tight_policy(),
            trace_snapshot_policy_binding(tight_policy()), "config:v1", "manifest:snap:budget", "generation:snap:budget"):
            case Err(reason): fail(reason)
            case Ok(base): partition_facts_equal(base.facts, cold)
