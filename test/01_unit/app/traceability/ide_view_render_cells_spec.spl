"""Trace view rows are padded/truncated by terminal CELLS, not code points."""
# @req REQ-CARET-TRC-001 REQ-CARET-UI-003
use std.spec.*
use std.common.layout.text_metrics.{text_cell_width}
use app.traceability.ide_view_provider.*
use app.traceability.ide_view_render.*

# id column 28 + space + title column 32 + space + "LINKED" (6)
val ROW_CELLS = 68

describe "trace view cell-aware fit":
    it "a 20-character CJK id (40 cells) is cut to the 28-cell id column":
        step("render a row whose id is 20 wide characters")
        val line = render_row("要要要要要要要要要要要要要要要要要要要要", "t", EvidenceBadge.Linked)
        expect(text_cell_width(line)).to_equal(ROW_CELLS)

    it "ASCII and CJK ids and titles give rows of identical cell width":
        step("compare cell widths")
        expect(text_cell_width(render_row("abc", "t", EvidenceBadge.Linked))).to_equal(ROW_CELLS)
        expect(text_cell_width(render_row("要要要", "要要", EvidenceBadge.Linked))).to_equal(ROW_CELLS)

    it "a wide char that would straddle the column edge becomes a space":
        step("27 ASCII cells then one wide char into a 28-cell column")
        val line = render_row("aaaaaaaaaaaaaaaaaaaaaaaaaaa要", "t", EvidenceBadge.Linked)
        expect(line.contains("要")).to_equal(false)
        expect(text_cell_width(line)).to_equal(ROW_CELLS)
