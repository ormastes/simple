"""
# Reject incomplete or ambiguous traceability documents

Purpose: establish strict document-consumption contracts before typed trace
families decode their fields. These component cases contribute to AC001/AC002;
they do not qualify the production CLI or the complete trace graph.
"""

use std.spec.*
use std.spec.step
use std.common.sdn.strict_v1.{sdn_parse_strict_v1, sdn_parse_strict_bytes_v1}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}

fn expect_strict_document_rejected(source: text):
    var rejected = false
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(_): rejected = false
        case Err(_): rejected = true
    expect(rejected).to_equal(true)

fn expect_strict_limit_rejected(source: text, limits: SdnStrictLimitsV1, code: text):
    var rejected = false
    match sdn_parse_strict_v1(source, limits):
        case Ok(_): rejected = false
        case Err(issue):
            rejected = true
            expect(issue.code).to_equal(code)
    expect(rejected).to_equal(true)

fn expect_strict_document_accepted(source: text, limits: SdnStrictLimitsV1):
    var accepted = false
    match sdn_parse_strict_v1(source, limits):
        case Ok(document):
            accepted = true
            expect(document.consumed_bytes).to_equal(source.len())
        case Err(_): ()
    expect(accepted).to_equal(true)

describe "Strict traceability SDN document boundary":
    it "rejects overflowing array elements instead of preserving their spelling":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Reject a malformed numeric member inside a collection")
        expect_strict_document_rejected("[9223372036854775808]")

    it "rejects overflowing dictionary fields":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Reject a counter that cannot be represented by the schema")
        expect_strict_document_rejected(r"{ordinal: -9223372036854775809}")

    it "rejects malformed quoted table cells":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Reject a truncated locator instead of recovering it as text")
        expect_strict_document_rejected("|id, locator|\ncase1, \"unfinished")

    it "rejects duplicate table columns":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Require one meaning for each named cell")
        expect_strict_document_rejected("|id, id|\na, b")

    it "rejects rows whose width differs from the header":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject both missing and surplus cells")
        expect_strict_document_rejected("|id, locator|\na")
        expect_strict_document_rejected("|id, locator|\na, b, c")

    it "rejects malformed optional named sections":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Require every authored section to be consumed")
        expect_strict_document_rejected(r"schema: {name: trace}" + "\noptional |id, locator\n    a, b")

    it "rejects dangling content after an otherwise valid block":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject unexpected trailing document content")
        expect_strict_document_rejected(r"schema: {name: trace}" + "\ndangling content")

    it "rejects multiline duplicate mapping keys":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject conflicting declarations before last-wins recovery")
        expect_strict_document_rejected(r"{" + "\n id: one,\n id: two\n" + r"}")

    it "rejects duplicate decoded fields table names and namespace collisions":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Validate decoded identity before committing a field or table")
        expect_strict_document_rejected(r"{id: one, " + "\"id\": two" + r"}")
        expect_strict_document_rejected("cases |id|\n    a\ncases |id|\n    b")
        expect_strict_document_rejected("cases: []\ncases |id|\n    a")
        expect_strict_document_rejected("|id, \"id\"|\na, b")

    it "rejects omitted members mismatched delimiters and multiple roots":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Require every nested member and exactly one root")
        expect_strict_document_rejected("[1,]")
        expect_strict_document_rejected(r"{id: }")
        expect_strict_document_rejected("[1}")
        expect_strict_document_rejected("1\n2")
        expect_strict_document_rejected("|id|\na\nschema: trace")

    it "consumes Unicode blocks sequences named tables comments and CRLF":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Read a complete multi-section document without losing authored rows")
        val source = "# leading\r\nschema:\r\n    name: 한글\r\nitems:\r\n    - id: first\r\n      ordinal: -7\r\n    - id: second\r\n      ordinal: 8\r\ncases |id, locator|\r\n    a, \"α,#one\"\r\n\r\n    # middle\r\n    b, \"β\"\r\nlinks |source, target|\r\n    a, b\r\n# tail\r\n"
        var accepted = false
        var cases_found = false
        var items_found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                accepted = true
                expect(document.consumed_bytes).to_equal(source.len())
                expect(document.rows).to_equal(3)
                expect(document.cells).to_equal(6)
                match document.value:
                    case Dict(fields):
                        expect(fields.len()).to_equal(4)
                        match fields["cases"]:
                            case Table(headers, rows):
                                cases_found = true
                                expect(headers.len()).to_equal(2)
                                expect(headers[0]).to_equal("id")
                                expect(rows.len()).to_equal(2)
                                var locator_found = false
                                match rows[0][1]:
                                    case String(value):
                                        locator_found = true
                                        expect(value).to_equal("α,#one")
                                    case _: ()
                                expect(locator_found).to_equal(true)
                            case _: ()
                        match fields["items"]:
                            case Array(items):
                                items_found = true
                                expect(items.len()).to_equal(2)
                            case _: ()
                    case _: ()
            case Err(_): ()
        expect(accepted).to_equal(true)
        expect(cases_found).to_equal(true)
        expect(items_found).to_equal(true)

    it "retains unknown escapes raw multiline text null and empty collections":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Preserve the shared scalar grammar and explicit empty values")
        val source = "[\"\\q\", \"line\nnext\", null, [], " + r"{}" + "] # tail\n"
        var accepted = false
        var values_found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                accepted = true
                expect(document.consumed_bytes).to_equal(source.len())
                match document.value:
                    case Array(items):
                        expect(items.len()).to_equal(5)
                        var first_found = false
                        match items[0]:
                            case String(value):
                                first_found = true
                                expect(value).to_equal("\\q")
                            case _: ()
                        expect(first_found).to_equal(true)
                        match items[1]:
                            case String(value):
                                values_found = true
                                expect(value).to_equal("line\nnext")
                            case _: ()
                    case _: ()
            case Err(_): ()
        expect(accepted).to_equal(true)
        expect(values_found).to_equal(true)

    it "enforces exact source node and depth boundaries":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Charge bounded resources before creating another semantic node")
        expect_strict_document_accepted("[1]", SdnStrictLimitsV1(max_source_bytes: 3, max_depth: 2, max_nodes: 2))
        expect_strict_limit_rejected("[1]", SdnStrictLimitsV1(max_source_bytes: 2), "source_limit")
        expect_strict_limit_rejected("[1]", SdnStrictLimitsV1(max_depth: 1), "depth_limit")
        expect_strict_limit_rejected("[1]", SdnStrictLimitsV1(max_nodes: 1), "node_limit")
        expect_strict_limit_rejected("1", SdnStrictLimitsV1(max_depth: 65), "invalid_limits")
        expect_strict_limit_rejected("1", SdnStrictLimitsV1(max_nodes: -1), "invalid_limits")

    it "charges table resources across all named sections":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Apply cumulative budgets rather than resetting them for each table")
        val source = "first |id|\n    a\nsecond |id|\n    b\n"
        expect_strict_document_accepted(source, SdnStrictLimitsV1(max_rows: 2, max_cells: 2, max_columns: 1))
        expect_strict_limit_rejected(source, SdnStrictLimitsV1(max_rows: 1), "row_limit")
        expect_strict_limit_rejected(source, SdnStrictLimitsV1(max_cells: 1), "cell_limit")
        expect_strict_limit_rejected("|id, path|\na, b", SdnStrictLimitsV1(max_columns: 1), "column_limit")
        expect_strict_document_accepted("empty |id|\n", SdnStrictLimitsV1(max_rows: 0, max_cells: 0))

    it "rejects malformed UTF8 without replacement and reports original byte locations":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Validate bytes before parsing and preserve source locations")
        var rejected = false
        match sdn_parse_strict_bytes_v1([0xC0u8, 0xAFu8], sdn_strict_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("invalid_utf8")
        expect(rejected).to_equal(true)
        var located = false
        match sdn_parse_strict_v1("name: 한글\nname: duplicate", sdn_strict_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                located = true
                expect(issue.code).to_equal("duplicate_key")
                expect(issue.line).to_equal(2)
                expect(issue.column).to_equal(6)
                expect(issue.offset).to_equal(18)
        expect(located).to_equal(true)

    it "rejects inconsistent indentation while retaining scalar negative integers":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Distinguish sequence markers and validate block ownership")
        expect_strict_document_accepted("-7\n", sdn_strict_limits_v1())
        expect_strict_document_rejected("schema:\n\tname: trace")
        expect_strict_document_rejected("schema:\n    name: trace\n  version: 1")
        expect_strict_document_rejected("name: trace\rversion: 1")
