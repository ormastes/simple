# @tag:in-development
# @req REQ-TRC-012 REQ-TRC-013 REQ-TRC-018
# These fixtures parse source through the production frontend; candidate code
# is never imported or executed.
use std.spec.*
use app.traceability.extract.sspec_inventory.{extract_sspec_inventory_single_owner}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}

fn _sspec_source(lines: [text]) -> text:
    lines.join("\n")

fn _expect_inventory_rejected(source: text):
    match extract_sspec_inventory_single_owner("test/fixture_spec.spl", source):
        case Ok(_): fail("unsupported or malformed SSpec inventory was accepted")
        case Err(reason): expect(reason.len()).to_be_greater_than(0)

describe "Production-parser SSpec inventory extraction":
    it "extracts nested literal selectors and ignores comments and string contents":
        val source = _sspec_source([
            "use std.spec.*",
            "# it \"comment decoy\":",
            "describe \"outer\":",
            "    context \"inner\":",
            "        # slow_it \"nested comment decoy\":",
            "        it \"says \\\"hello\\\" 日本\":",
            "            val note = \"it \\\"string decoy\\\":\"",
            "            # test \"body comment decoy\":",
            "        slow_it \"slow case\":",
            "            pass"])
        match extract_sspec_inventory_single_owner("test/fixture_spec.spl", source):
            case Err(reason): fail("literal SSpec source did not extract: {reason}")
            case Ok(inventory):
                expect(inventory.test_path).to_equal("test/fixture_spec.spl")
                expect(inventory.evidence_validity).to_equal("unverified")
                var source_bytes: [u8] = []
                for byte in source.bytes(): source_bytes.push(byte)
                expect(inventory.source_sha256).to_equal("sha256:" + sha256_u8_hex(source_bytes))
                expect(inventory.cases.len()).to_equal(2)
                expect(inventory.cases[0].case_name).to_equal("outer > inner > says \"hello\" 日本")
                expect(inventory.cases[0].leaf_name).to_equal("says \"hello\" 日本")
                expect(inventory.cases[0].kind).to_equal("normal")
                expect(inventory.cases[0].suite_path).to_equal(["outer"])
                expect(inventory.cases[0].context_path).to_equal(["inner"])
                expect(inventory.cases[1].case_name).to_equal("outer > inner > slow case")
                expect(inventory.cases[1].kind).to_equal("slow")
                expect(inventory.cases[0].start_byte).to_be_less_than(inventory.cases[0].end_byte)
                expect(inventory.cases[0].line).to_be_greater_than(0)
                expect(inventory.cases[0].column).to_be_greater_than(0)
                val second = inventory.cases[1]
                match validated_utf8_bytes_to_text_linear(source_bytes[second.start_byte:second.end_byte]):
                    case Err(reason): fail("second declaration byte span is invalid UTF-8: {reason}")
                    case Ok(fragment): expect(fragment.starts_with("slow_it \"slow case\"")).to_equal(true)

    it "binds byte spans to source content and hashes the full source":
        val first = _sspec_source([
            "use std.spec.*",
            "describe \"suite\":",
            "    it \"identity\":",
            "        val body = \"first\""])
        val changed = _sspec_source([
            "use std.spec.*",
            "describe \"suite\":",
            "    it \"identity\":",
            "        val body = \"changed\""])
        match extract_sspec_inventory_single_owner("test/identity_spec.spl", first):
            case Err(reason): fail("first source did not extract: {reason}")
            case Ok(first_inventory):
                val item = first_inventory.cases[0]
                expect(first[item.start_byte:item.end_byte].starts_with("it \"identity\"")).to_equal(true)
                match extract_sspec_inventory_single_owner("test/identity_spec.spl", changed):
                    case Err(reason): fail("changed source did not extract: {reason}")
                    case Ok(changed_inventory):
                        expect(first_inventory.source_sha256 == changed_inventory.source_sha256).to_equal(false)
                        expect(changed_inventory.cases[0].start_byte).to_equal(item.start_byte)
                        expect(changed_inventory.cases[0].case_name).to_equal(item.case_name)

    it "retains full nested paths and uses only the current suite and context in selectors":
        val source = _sspec_source([
            "use std.spec.*",
            "describe \"outer suite\":",
            "    describe \"inner suite\":",
            "        context \"outer context\":",
            "            context \"inner context\":",
            "                test \"test kind\":",
            "                    assert(false)",
            "                example \"example kind\":",
            "                    assert(false)"])
        match extract_sspec_inventory_single_owner("test/nested_spec.spl", source):
            case Err(reason): fail("nested literal SSpec source did not extract: {reason}")
            case Ok(inventory):
                expect(inventory.cases.len()).to_equal(2)
                expect(inventory.cases[0].case_name).to_equal("inner suite > inner context > test kind")
                expect(inventory.cases[0].suite_path).to_equal(["outer suite", "inner suite"])
                expect(inventory.cases[0].context_path).to_equal(["outer context", "inner context"])
                expect(inventory.cases[0].kind).to_equal("test")
                expect(inventory.cases[1].case_name).to_equal("inner suite > inner context > example kind")
                expect(inventory.cases[1].kind).to_equal("example")

    it "resets frontend arenas between independent inventory snapshots":
        val first_source = _sspec_source([
            "use std.spec.*",
            "describe \"first suite\":",
            "    it \"first case\":",
            "        assert(false)"])
        val second_source = _sspec_source([
            "use std.spec.*",
            "describe \"second suite\":",
            "    example \"second case\":",
            "        assert(false)"])
        match extract_sspec_inventory_single_owner("test/first_spec.spl", first_source):
            case Err(reason): fail("first inventory failed: {reason}")
            case Ok(first):
                expect(first.cases.len()).to_equal(1)
                expect(first.cases[0].case_name).to_equal("first suite > first case")
                match extract_sspec_inventory_single_owner("test/second_spec.spl", second_source):
                    case Err(reason): fail("second inventory failed: {reason}")
                    case Ok(second):
                        expect(second.cases.len()).to_equal(1)
                        expect(second.cases[0].case_name).to_equal("second suite > second case")
                        expect(second.cases[0].test_path).to_equal("test/second_spec.spl")
                        expect(second.cases[0].kind).to_equal("example")
                        expect(first.cases[0].case_name).to_equal("first suite > first case")
                        expect(first.cases[0].test_path).to_equal("test/first_spec.spl")

    it "rejects duplicate exact runtime selectors":
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "describe \"suite\":",
            "    it \"duplicate\":",
            "        pass",
            "    it \"duplicate\":",
            "        pass"]))

    it "rejects dynamic and interpolated case names":
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "val case_name = \"computed\"",
            "it case_name:",
            "    pass"]))
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "val variant = \"one\"",
            "it \"case {variant}\":",
            "    pass"]))

    it "rejects conditional, loop-generated, aliased and parameterized cases":
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "if true:",
            "    it \"conditional\":",
            "        pass"]))
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "for case_name in [\"one\", \"two\"]:",
            "    it case_name:",
            "        pass"]))
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "val register_case = it",
            "register_case \"aliased\":",
            "    pass"]))
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "parameterized_cases([\"one\", \"two\"]):",
            "    it \"generated\":",
            "        pass"]))

    it "rejects malformed source with an explicit extraction error":
        _expect_inventory_rejected(_sspec_source([
            "use std.spec.*",
            "describe \"suite\":",
            "    it \"unterminated:",
            "        pass"]))
