"""Retained generic-family RED cases now exercise implemented dispatch/declarations."""
use std.spec.*
use std.spec.step
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.strict_types_v1.{sdn_strict_limits_v1}
use std.common.traceability.types_v1.{trace_document_codec_limits_v1}
use std.common.traceability.encode_v1.{trace_document_decode_v1}

fn document_graph_fixture_v1() -> text:
    "schema: {name: simple.trace.graph, version: 1}\nsnapshot: {id: \"snapshot:one\", kind: worktree, complete: true}\n" +
    "manifest: {input_set_id: \"input:one\", extractor_version: extract/v1, rules_version: rules/v1, policy_id: \"policy:one\", complete: true}\n" +
    "inputs |path, sha256, bytes, role|\nnodes |id, kind, title|\n" +
    "test_definitions |entity_id, test_kind, identity_scope, definition_id, parameter_digest_available, parameter_digest|\n" +
    "edges |id, from_id, relation, to_id|\n" +
    "edge_origins |edge_id, origin_kind, origin_id, declaration_path_available, declaration_path, span_available, line, column, extractor_version|\n" +
    "locators |entity_id, path_available, path, locator_kind, locator|\n"

fn document_declarations_fixture_v1() -> text:
    "schema: {name: simple.trace.declarations, version: 1}\nid: \"declarations:one\"\nnamespace: project/simple\n" +
    "claims |id, from_id, relation, to_id, origin_id|\n" +
    "    \"claim:one\", \"req:R\", implemented_by, \"source:S\", \"origin:one\"\n" +
    "aliases |id, from_id, to_id, origin_id|\n" +
    "exceptions |id, scope_kind, subject_id, rule_id, reason, owner, review_state, expires_available, expires_at, origin_id|\n" +
    "origins |id, origin_kind, path, span_available, line, column, extractor_version|\n" +
    "    \"origin:one\", explicit, doc/intent.sdn, false, 0, 0, extract/v1\n"

fn document_baseline_code_v1(source: text) -> text:
    var syntax = false
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(_): syntax = true
        case Err(issue): print "Baseline syntax issue: {issue.code}"
    expect(syntax).to_equal(true)
    match trace_document_decode_v1(source, trace_document_codec_limits_v1()):
        case Ok(_): "accepted"
        case Err(issue):
            print "Actual document issue: {issue.code}"
            issue.code

describe "Missing generic graph and declarations adapters":
    it "dispatches graph rather than treating it as an unsupported summary":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Select the explicit graph family through the real document facade")
        expect(document_baseline_code_v1(document_graph_fixture_v1())).to_equal("accepted")
    it "dispatches authored intent with a real claim and origin":
        # @req: REQ-TRC-001, REQ-TRC-005
        # @ac: AC-TRC-001
        expect(document_baseline_code_v1(document_declarations_fixture_v1())).to_equal("accepted")
    it "rejects duplicate claim identity rather than unsupported family":
        # @req: REQ-TRC-001, REQ-TRC-006
        # @ac: AC-TRC-002
        val source = document_declarations_fixture_v1().replace("aliases |", "    \"claim:one\", \"req:R\", implemented_by, \"source:other\", \"origin:one\"\naliases |")
        expect(document_baseline_code_v1(source)).to_equal("duplicate_identifier")
    it "rejects an unresolved origin without discarding the authored claim":
        # @req: REQ-TRC-001, REQ-TRC-005
        # @ac: AC-TRC-002
        val source = document_declarations_fixture_v1().replace("\"source:S\", \"origin:one\"", "\"source:S\", \"origin:missing\"")
        expect(document_baseline_code_v1(source)).to_equal("missing_reference")
