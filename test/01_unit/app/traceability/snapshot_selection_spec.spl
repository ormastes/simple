# @tag:in-development
# @req REQ-TRC-008 REQ-TRC-009
use std.spec.*
use app.traceability.snapshot_preview.{parse_trace_snapshot_selection}

describe "Exact snapshot selection":
    it "keeps a Git revision named index distinct from staged content":
        match parse_trace_snapshot_selection("git:index"):
            case Err(reason): fail(reason)
            case Ok(selected):
                expect(selected.kind).to_equal("git_commit")
                expect(selected.selector).to_equal("index")
        match parse_trace_snapshot_selection("index"):
            case Err(reason): fail(reason)
            case Ok(selected):
                expect(selected.kind).to_equal("git_index")
                expect(selected.selector).to_equal("index")

    it "rejects empty explicit selectors instead of falling back to the worktree":
        for value in ["", "git:", "worktree"]:
            match parse_trace_snapshot_selection(value):
                case Ok(_): fail("unsupported selector accepted: " + value)
                case Err(reason): expect(reason).to_contain("snapshot selection")
