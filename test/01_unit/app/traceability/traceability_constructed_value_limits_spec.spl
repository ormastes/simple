"""Source-less SDN budgets precede key materialization and diagnostics."""
use std.spec.*
use std.spec.step
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_types_v1.{sdn_strict_limits_v1}
use std.common.sdn.value_limits_v1.{sdn_validate_value_limits_v1}

fn raw_limit_code_v1(value: SdnValue, nodes: i64, bytes: i64) -> text:
    var limits = sdn_strict_limits_v1()
    limits.max_nodes = nodes
    limits.max_source_bytes = bytes
    match sdn_validate_value_limits_v1(value, limits):
        case Ok(_): "accepted"
        case Err(issue):
            expect(issue.offset).to_equal(0)
            expect(issue.line).to_equal(0)
            issue.code

describe "Constructed SDN value resource boundary":
    it "counts matched dictionaries before materializing keys":
        # @req: REQ-TRC-001, REQ-TRC-010
        step("Observe exact dictionary node cardinality including empty values")
        var fields: Dict<text, SdnValue> = {}
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 1, 32)).to_equal("accepted")
        fields["a"] = SdnValue.Int(1)
        fields["b"] = SdnValue.Int(2)
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 5, 32)).to_equal("accepted")
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 4, 32)).to_equal("node_limit")
        for index in 0..256: fields[index.to_text()] = SdnValue.Int(index)
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 1, 32)).to_equal("node_limit")

    it "bounds constructed dictionary key bytes before schema diagnostics":
        # @req: REQ-TRC-001, REQ-TRC-010
        var fields: Dict<text, SdnValue> = {}
        fields["abcdefghijklmnopqrstuvwxyz0123456789"] = SdnValue.Int(1)
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 3, 32)).to_equal("text_limit")

    it "bounds constructed table header bytes before column comparison":
        # @req: REQ-TRC-001, REQ-TRC-010
        val value = SdnValue.Table(["abcdefghijklmnopqrstuvwxyz0123456789"], [])
        expect(raw_limit_code_v1(value, 2, 32)).to_equal("text_limit")

    it "charges cumulative strings and keys against the source-less text cap":
        # @req: REQ-TRC-001, REQ-TRC-010
        var fields: Dict<text, SdnValue> = {}
        fields["a"] = SdnValue.String("0123456789")
        fields["b"] = SdnValue.String("0123456789")
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 5, 22)).to_equal("accepted")
        expect(raw_limit_code_v1(SdnValue.Dict(fields), 5, 21)).to_equal("text_limit")

    it "rejects invalid strict limits without inspecting caller values":
        # @req: REQ-TRC-001, REQ-TRC-010
        expect(raw_limit_code_v1(SdnValue.Null, -1, 32)).to_equal("invalid_limits")
