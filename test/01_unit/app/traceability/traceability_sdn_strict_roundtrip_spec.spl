"""Review-derived compatibility contracts for the strict shared SDN owner."""

use std.spec.*
use std.spec.step
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.strict_v1.{sdn_parse_strict_bytes_v1}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}

fn expect_strict_text_roundtrip(value: text):
    val encoded = sdn_encode_canonical(SdnValue.String(value))
    var decoded_text = false
    match sdn_parse_strict_v1(encoded, sdn_strict_limits_v1()):
        case Ok(document):
            expect(document.consumed_bytes).to_equal(encoded.len())
            match document.value:
                case String(decoded):
                    decoded_text = true
                    expect(decoded).to_equal(value)
                case _: ()
        case Err(_): ()
    expect(decoded_text).to_equal(true)

fn expect_strict_roundtrip_error(source: text):
    var rejected = false
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(_): ()
        case Err(_): rejected = true
    expect(rejected).to_equal(true)

fn expect_strict_exact_int(value: SdnValue, expected: i64):
    var found = false
    match value:
        case Int(number):
            found = true
            expect(number).to_equal(expected)
        case _: ()
    expect(found).to_equal(true)

describe "Strict SDN shared encoder compatibility":
    it "retains nil as ordinary text":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Decode the same reserved scalar vocabulary as the shared encoder")
        expect_strict_text_roundtrip("nil")
        expect_strict_text_roundtrip("~")

    it "quotes scientific numeric spellings when the value is text":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Preserve the text variant across canonical serialization")
        expect_strict_text_roundtrip("1e3")
        expect_strict_text_roundtrip("-2E4")
        expect_strict_text_roundtrip("+2.0")

    it "retains comments and delimiters inside decoded quoted field names":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Recognize the mapping separator only outside the quoted field")
        val source = "\"case#one\": value\n\"case|two\": other\n"
        var accepted = false
        var fields_found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                accepted = true
                match document.value:
                    case Dict(fields):
                        fields_found = true
                        expect(fields.len()).to_equal(2)
                        expect(fields.contains_key("case#one")).to_equal(true)
                        expect(fields.contains_key("case|two")).to_equal(true)
                    case _: ()
            case Err(_): ()
        expect(accepted).to_equal(true)
        expect(fields_found).to_equal(true)

    it "requires separators between inline members and quotes structural text":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Reject missing commas without absorbing the next declaration")
        expect_strict_roundtrip_error(r"{a: one b: two}")
        expect_strict_roundtrip_error(r"{a: one b=two}")
        expect_strict_roundtrip_error("[1: 2]")
        expect_strict_roundtrip_error("[1 2]")
        expect_strict_roundtrip_error(r"{a: 1 b}")
        expect_strict_text_roundtrip("one b: two")
        expect_strict_text_roundtrip("one b=two")
        var accepted = false
        match sdn_parse_strict_v1("[\"1 2\"]", sdn_strict_limits_v1()):
            case Ok(_): accepted = true
            case Err(_): ()
        expect(accepted).to_equal(true)

    it "accepts finite scientific floats and rejects nonfinite conversion":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Keep numeric and text variants distinct after shared classification")
        var float_found = false
        match sdn_parse_strict_v1("1e3", sdn_strict_limits_v1()):
            case Ok(document):
                match document.value:
                    case Float(value):
                        float_found = true
                        expect(value).to_equal(1000.0)
                    case _: ()
            case Err(_): ()
        expect(float_found).to_equal(true)
        expect_strict_roundtrip_error("1e9999")

    it "owns multiline collection cells without swallowing another row or section":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Balance nested delimiters before completing a logical table row")
        val source = "first |id, values|\n    a, [1,\n        2]\n    b, " + r"{x: 3}" + "\nsecond |id|\n    c\n"
        var accepted = false
        var array_found = false
        var dictionary_found = false
        var second_found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                accepted = true
                expect(document.rows).to_equal(3)
                expect(document.cells).to_equal(5)
                expect(document.consumed_bytes).to_equal(source.len())
                match document.value:
                    case Dict(fields):
                        expect(fields.len()).to_equal(2)
                        match fields["first"]:
                            case Table(headers, rows):
                                expect(rows.len()).to_equal(2)
                                expect(headers.len()).to_equal(2)
                                match rows[0][1]:
                                    case Array(items):
                                        array_found = true
                                        expect(items.len()).to_equal(2)
                                        expect_strict_exact_int(items[0], 1)
                                        expect_strict_exact_int(items[1], 2)
                                    case _: ()
                                match rows[1][1]:
                                    case Dict(values):
                                        dictionary_found = true
                                        expect(values.len()).to_equal(1)
                                        expect_strict_exact_int(values["x"], 3)
                                    case _: ()
                            case _: ()
                        match fields["second"]:
                            case Table(headers, rows):
                                second_found = true
                                expect(headers.len()).to_equal(1)
                                expect(rows.len()).to_equal(1)
                            case _: ()
                    case _: ()
            case Err(_): ()
        expect(accepted).to_equal(true)
        expect(array_found).to_equal(true)
        expect(dictionary_found).to_equal(true)
        expect(second_found).to_equal(true)
        expect_strict_roundtrip_error("first |id, values|\n    a, [1 2]\n")
        expect_strict_roundtrip_error("first |id, values|\n    a, [1, 2\nsecond |id|\n    c\n")

    it "preserves raw multiline and escaped quoted keys":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Keep quoted source content distinct from physical document layout")
        val source = "\"key\nnext\": value\n\"key\\\"#tail\": other\n"
        var found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                match document.value:
                    case Dict(fields):
                        found = true
                        expect(fields.contains_key("key\nnext")).to_equal(true)
                        expect(fields.contains_key("key\"#tail")).to_equal(true)
                    case _: ()
            case Err(_): ()
        expect(found).to_equal(true)

    it "charges decoded keys and headers at exact node boundaries":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Include semantic names in the global allocation budget")
        var mapping_found = false
        match sdn_parse_strict_v1(r"{id: 1}", SdnStrictLimitsV1(max_nodes: 3)):
            case Ok(document):
                mapping_found = true
                expect(document.nodes).to_equal(3)
            case Err(_): ()
        expect(mapping_found).to_equal(true)
        var rejected = false
        match sdn_parse_strict_v1(r"{id: 1}", SdnStrictLimitsV1(max_nodes: 2)):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("node_limit")
        expect(rejected).to_equal(true)
        var table_found = false
        match sdn_parse_strict_v1("empty |id|\n", SdnStrictLimitsV1(max_nodes: 4)):
            case Ok(document):
                table_found = true
                expect(document.nodes).to_equal(4)
            case Err(_): ()
        expect(table_found).to_equal(true)
        var header_rejected = false
        match sdn_parse_strict_v1("empty |id|\n", SdnStrictLimitsV1(max_nodes: 3)):
            case Ok(_): ()
            case Err(issue):
                header_rejected = true
                expect(issue.code).to_equal("node_limit")
        expect(header_rejected).to_equal(true)

    it "locates malformed UTF8 after a valid prefix without invented origin coordinates":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Return the shared validator's exact first-invalid byte location")
        var rejected = false
        match sdn_parse_strict_bytes_v1([110u8, 58u8, 49u8, 10u8, 0xE2u8, 0x28u8, 0xA1u8], sdn_strict_limits_v1()):
            case Ok(_): ()
            case Err(issue):
                rejected = true
                expect(issue.code).to_equal("invalid_utf8")
                expect(issue.offset).to_equal(5)
                expect(issue.line).to_equal(2)
                expect(issue.column).to_equal(2)
        expect(rejected).to_equal(true)

    it "preserves exact sequence mappings and null versus empty variants":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Observe actual child payloads instead of only collection length")
        val source = "items:\n    - id: first\n      ordinal: -7\n    - id: second\n      ordinal: 8\nempty: [null, [], " + r"{}" + "]\n"
        var root_found = false
        var items_found = false
        var empty_found = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(document):
                match document.value:
                    case Dict(fields):
                        root_found = true
                        match fields["items"]:
                            case Array(items):
                                items_found = true
                                expect(items.len()).to_equal(2)
                                for index in [0, 1]:
                                    var item_found = false
                                    match items[index]:
                                        case Dict(item):
                                            item_found = true
                                            expect(item.len()).to_equal(2)
                                            expect_strict_exact_int(item["ordinal"], if index == 0: -7 else: 8)
                                            var id_found = false
                                            match item["id"]:
                                                case String(name):
                                                    id_found = true
                                                    expect(name).to_equal(if index == 0: "first" else: "second")
                                                case _: ()
                                            expect(id_found).to_equal(true)
                                        case _: ()
                                    expect(item_found).to_equal(true)
                            case _: ()
                        match fields["empty"]:
                            case Array(items):
                                expect(items.len()).to_equal(3)
                                var null_found = false
                                match items[0]:
                                    case Null: null_found = true
                                    case _: ()
                                expect(null_found).to_equal(true)
                                var array_found = false
                                match items[1]:
                                    case Array(values):
                                        array_found = true
                                        expect(values.len()).to_equal(0)
                                    case _: ()
                                expect(array_found).to_equal(true)
                                match items[2]:
                                    case Dict(values):
                                        empty_found = true
                                        expect(values.len()).to_equal(0)
                                    case _: ()
                            case _: ()
                    case _: ()
            case Err(_): ()
        expect(root_found).to_equal(true)
        expect(items_found).to_equal(true)
        expect(empty_found).to_equal(true)
