# @tag:in-development
# @req REQ-TRC-007 REQ-TRC-008 REQ-TRC-014 REQ-TRC-017
# These pure fixtures exercise production graph composition, not Git or CLI admission.
use std.spec.*
use std.common.traceability.model.*
use app.traceability.extract.snapshot_pipeline.{TraceSnapshotScope, build_snapshot_trace_graph}

fn pipeline_snapshot(tree: text, reverse: bool) -> SnapshotInput:
    val source = SnapshotArtifact(path: "src/app/parser.spl", blob_id: "blob:source", content: "fn parse(): 1", visibility: "selected_content")
    val spec = SnapshotArtifact(path: "test/01_unit/app/parser_spec.spl", blob_id: "blob:test", content: "# fixture spec", visibility: "selected_content")
    val artifacts = if reverse: [spec, source] else: [source, spec]
    SnapshotInput(subject: SnapshotSubject(repository_id: "repo:fixture", snapshot_id: "snapshot:" + tree,
        kind: "git_tree", revision_id: "revision:" + tree, tree_id: tree, object_format: "sha256"), artifacts: artifacts, complete: true)

fn pipeline_policy() -> TracePolicy:
    TracePolicy(id: "policy:fixture", authorities: [], max_nodes: 100, max_claims: 100,
        conventions: [TraceConventionRule(id: "app-unit-v1", source_root: "src/app/", target_root: "test/01_unit/app/",
            source_suffix: ".spl", target_suffix: "_spec.spl", relation: TraceRelation.Targets, version: "1")])

fn pipeline_scope() -> TraceSnapshotScope:
    TraceSnapshotScope(selected_roots: ["src/app", "test/01_unit/app"], authority_id: "", closure_kind: "selected_scope")

describe "Scope-bound immutable graph composition":
    it "derives the real conventional edge without authoring duplicate link rows":
        # @ac AC-TRC-003
        step("Build the graph from frozen source and conventional test inputs")
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], pipeline_scope()):
            case Err(reason): fail(reason)
            case Ok(result):
                expect(result.graph.complete).to_equal(true)
                expect(result.graph.edges.len()).to_equal(1)
                expect(result.graph.edges[0].relation).to_equal(TraceRelation.Targets)
                expect(result.scope.selected_roots).to_equal(["src/app", "test/01_unit/app"])
                expect(result.admission_eligible).to_equal(false)

    it "keeps structural identity stable across inventory order and candidate-only changes":
        # @ac AC-TRC-030
        step("Compare equal structural inputs under different exact candidate subjects")
        val first = build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], pipeline_scope())
        val second = build_snapshot_trace_graph(pipeline_snapshot("tree:b", true), pipeline_policy(), [], pipeline_scope())
        match first:
            case Err(reason): fail(reason)
            case Ok(a):
                match second:
                    case Err(reason): fail(reason)
                    case Ok(b):
                        expect(a.graph.input_manifest_id).to_equal(b.graph.input_manifest_id)
                        expect(a.graph.generation_id == b.graph.generation_id).to_equal(false)

    it "invalidates the manifest when policy contents change under the same policy ID":
        step("Change the mapping version without changing its displayed policy identity")
        var changed = pipeline_policy()
        var rule = changed.conventions[0]
        rule.version = "2"
        changed.conventions = [rule]
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], pipeline_scope()):
            case Err(reason): fail(reason)
            case Ok(a):
                match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), changed, [], pipeline_scope()):
                    case Err(reason): fail(reason)
                    case Ok(b): expect(a.graph.input_manifest_id == b.graph.input_manifest_id).to_equal(false)

    it "rejects a caller's unsupported claim of repository closure":
        var scope = pipeline_scope()
        scope.closure_kind = "policy_closure"
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], scope):
            case Ok(_): fail("candidate scope label granted unsupported closure")
            case Err(reason): expect(reason).to_contain("explicit selected scope")

    it "changes input identity when actual content changes under a reused blob label":
        var changed = pipeline_snapshot("tree:a", false)
        var source = changed.artifacts[0]
        source.content = "fn parse(): 2"
        changed.artifacts = [source, changed.artifacts[1]]
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], pipeline_scope()):
            case Err(reason): fail(reason)
            case Ok(a):
                match build_snapshot_trace_graph(changed, pipeline_policy(), [], pipeline_scope()):
                    case Err(reason): fail(reason)
                    case Ok(b): expect(a.graph.input_manifest_id == b.graph.input_manifest_id).to_equal(false)

    it "rejects a selected root that is absent from the captured inventory":
        var scope = pipeline_scope()
        scope.selected_roots = ["src/app", "test/01_unit/app", "doc/missing"]
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], scope):
            case Ok(_): fail("empty selected root was treated as captured")
            case Err(reason): expect(reason).to_contain("no captured artifacts")

    it "rejects out-of-scope inputs and absent declaration registration":
        var scope = pipeline_scope()
        scope.selected_roots = ["src/app"]
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), [], scope):
            case Ok(_): fail("out-of-scope test input accepted")
            case Err(reason): expect(reason).to_contain("out-of-scope")
        match build_snapshot_trace_graph(pipeline_snapshot("tree:a", false), pipeline_policy(), ["doc/missing.sdn"], pipeline_scope()):
            case Ok(_): fail("missing declaration registration accepted")
            case Err(reason): expect(reason).to_contain("declaration registration")
