"""Correct Result payload transport in binary-framed capture fixtures.
Requirements: doc/02_requirements/feature/traceability_sdn_slop.md
Design: doc/05_design/app/traceability_cli_sdn_v1.md
"""
use std.spec.*
use std.spec.step
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use app.traceability.capture_v1.{trace_capture_enumeration_v1}

fn fixture_nul() -> text:
    var accepted = false
    var nul = ""
    match validated_utf8_bytes_to_text_linear([0u8]):
        case Ok(value):
            accepted = true
            nul = value
        case Err(_): pass
    expect(accepted).to_equal(true)
    expect(nul.len()).to_equal(1)
    expect(nul.bytes()).to_equal([0u8])
    nul

describe "Validate bytes before accepting native capture fixtures":
    it "extracts exactly one NUL from the Result payload":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Decode the explicit successful payload instead of coalescing Result")
        val nul = fixture_nul()
        expect(nul.len()).to_equal(1)
        expect(nul.bytes()).to_equal([0u8])

    it "preserves Unicode newline and marker-like names with real NUL framing":
        # @req: REQ-TRC-009, REQ-TRC-010
        # @ac: AC-TRC-011, AC-TRC-015
        step("Construct one complete record from a checked binary fixture")
        val name = "test/λ\n[output truncated: legitimate filename]"
        val wire = "./" + name + fixture_nul()
        var accepted = false
        match trace_capture_enumeration_v1(wire, "", 0, 1000, 1):
            case Ok(paths): accepted = paths.len() == 1 and paths[0] == name
            case Err(_): pass
        expect(accepted).to_equal(true)

    it "keeps adjacent records separate and rejects empty or incomplete records":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Use NUL byte offsets for multiple names with multibyte characters")
        val nul = fixture_nul()
        val first = "test/λ"
        val second = "test/文 name"
        var accepted = false
        match trace_capture_enumeration_v1("./" + first + nul + "./" + second + nul, "", 0, 1000, 2):
            case Ok(paths): accepted = paths.len() == 2 and paths[0] == first and paths[1] == second
            case Err(_): pass
        expect(accepted).to_equal(true)
        var rejected = false
        match trace_capture_enumeration_v1("./" + first + nul + nul, "", 0, 1000, 2):
            case Err(_): rejected = true
            case Ok(_): pass
        expect(rejected).to_equal(true)
        rejected = false
        match trace_capture_enumeration_v1("./" + first + nul + "./" + second, "", 0, 1000, 2):
            case Err(_): rejected = true
            case Ok(_): pass
        expect(rejected).to_equal(true)
