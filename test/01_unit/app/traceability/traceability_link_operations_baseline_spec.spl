"""Strict-valid major2 fixtures expose the missing targeted operation layer."""
use std.spec.*
use std.spec.step
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.strict_types_v1.{sdn_strict_limits_v1}
use std.common.traceability.document_types_v1.{trace_document_codec_limits_v1}
use std.common.traceability.encode_v1.{trace_document_decode_v1}

fn operations_baseline_source_v2() -> text:
    "schema: {name: simple.trace.declarations, version: 2}\nid: \"declarations:one\"\nnamespace: project/simple\n" +
    "claims |id, from_id, relation, to_id, origin_id|\n" +
    "aliases |id, from_id, to_id, origin_id|\n" +
    "exceptions |id, scope_kind, subject_id, rule_id, reason, owner, review_state, expires_available, expires_at, origin_id|\n" +
    "origins |id, origin_kind, path, span_available, line, column, extractor_version|\n" +
    "    \"origin:one\", explicit, doc/intent.sdn, false, 0, 0, extract/v1\n" +
    "explicit_links |id, owner, from_id, relation, to_id, operation, replaces_rule, reason, origin_id, exception_id|\n" +
    "    \"operation:one\", \"owner:one\", \"test:one\", targets, \"source:S\", add, \"\", \"Shared suite intentionally targets this source\", \"origin:one\", \"\"\n" +
    "replacement_scopes |operation_id, from_id, relation, to_id|\n"

fn operations_baseline_code_v2(source: text) -> text:
    var syntax = false
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(_): syntax = true
        case Err(issue): print "Baseline syntax issue: {issue.code}"
    expect(syntax).to_equal(true)
    match trace_document_decode_v1(source, trace_document_codec_limits_v1()):
        case Ok(_): "accepted"
        case Err(issue):
            print "Actual operation issue: {issue.code}"
            issue.code

describe "Missing targeted link operation contract":
    it "accepts an explicit add with actual endpoints and origin":
        # @req: REQ-TRC-001, REQ-TRC-005
        # @ac: AC-TRC-001
        step("Dispatch explicit declarations major2 rather than reinterpret major1")
        expect(operations_baseline_code_v2(operations_baseline_source_v2())).to_equal("accepted")

    it "rejects duplicate operation identity precisely":
        # @req: REQ-TRC-001, REQ-TRC-006
        # @ac: AC-TRC-002
        val duplicate = "    \"operation:one\", \"owner:one\", \"test:two\", targets, \"source:other\", add, \"\", reason, \"origin:one\", \"\"\n"
        val source = operations_baseline_source_v2().replace("replacement_scopes |", duplicate + "replacement_scopes |")
        expect(operations_baseline_code_v2(source)).to_equal("duplicate_identifier")

    it "rejects replacement without its exact original endpoint scope":
        # @req: REQ-TRC-001, REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-002
        val exception = "    \"exception:one\", entity, \"source:old\", app-unit-v1, reason, \"owner:one\", proposed, false, \"\", \"origin:one\"\n"
        val source = operations_baseline_source_v2().replace("origins |", exception + "origins |").replace("add, \"\",", "replace, app-unit-v1,").replace("\"origin:one\", \"\"\nreplacement_scopes", "\"origin:one\", \"exception:one\"\nreplacement_scopes")
        expect(operations_baseline_code_v2(source)).to_equal("missing_reference")
