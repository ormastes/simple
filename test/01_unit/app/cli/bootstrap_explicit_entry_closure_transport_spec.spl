extern fn rt_file_read_text(path: text) -> text?

describe "bootstrap explicit-entry closure transport":
    it "seeds the entry and leaves closure discovery to the driver":
        val source = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
        expect(source).to_contain("val entry_path = native_build_single_spl_positional(args)")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY\", entry_path)")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")")
        expect(source).to_contain("val old_entry = native_build_env_saved_v1(\"SIMPLE_NATIVE_BUILD_ENTRY\")")
        expect(source).to_contain("native_build_env_restore_v1(\"SIMPLE_NATIVE_BUILD_ENTRY\", old_entry)")

        val driver = rt_file_read_text("src/compiler/80.driver/driver_source_pipeline_loading.spl") ?? ""
        expect(driver).to_contain("native_entry_input != \"\" and not native_entry_closure_pre")
        expect(driver).to_contain("var closure_source_roots = driver_inputs")
        expect(driver).to_contain("driver_resolve_closure_import_v1")
