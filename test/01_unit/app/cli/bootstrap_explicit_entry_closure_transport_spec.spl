extern fn rt_file_read_text(path: text) -> text

describe "bootstrap explicit-entry closure transport":
    it "seeds the entry and leaves closure discovery to the driver":
        val source = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
        expect(source).to_contain("val entry = native_build_entry_from_args(args, 0)")
        expect(source).to_contain("if old_entry == nil:")
        expect(source).to_contain("if old_entry_closure == nil:")
        expect(source).to_contain("if entry != \"\" and has_entry_closure == 1:")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY\", entry)")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY\", old_entry)")

        val driver = rt_file_read_text("src/compiler/80.driver/driver_source_pipeline_loading.spl") ?? ""
        expect(driver).to_contain("if native_entry_input != \"\" and not native_entry_closure_pre:")
        expect(driver).to_contain("driver_inputs = [native_entry_input]")
        expect(driver).to_contain("val closure_source_roots = driver_inputs")
        expect(driver).to_contain("for closure_source_root in closure_source_roots:")
        expect(driver).to_contain("_driver_resolve_entry_import(closure_mp, closure_source_root)")
