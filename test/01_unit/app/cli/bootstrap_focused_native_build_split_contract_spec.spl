use std.spec
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "focused native-build split contract":
    it "keeps dispatch in the facade and pure argument helpers isolated":
        val facade = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        val args = file_read("src/app/cli/bootstrap_focused_native_build_args.spl")
        expect(facade).to_contain("bootstrap_focused_native_build_args")
        expect(facade).to_contain("aot_native_project_with_backend_fixed(")
        expect(facade).to_contain("if sources.len() > 5:")
        expect(args).to_contain("pub fn focused_native_build_arg_value")
        expect(args.contains("aot_native_project_with_backend_fixed")).to_equal(false)
