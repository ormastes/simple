"""
## Purpose and audience
Purpose: Prove that Top-level SimpleOS CLI wrapper.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-CLI-001 — stable requirement identity for this spec.

use std.spec
use app.cli.main.{handle_os_inline}
use app.io.env_ops.{env_get, env_set}

describe "Top-level SimpleOS CLI wrapper":
    it "dispatches os targets successfully":
        step("Verify: dispatches os targets successfully")
        # @req: REQ-APP-CLI-001
        expect(handle_os_inline(["targets"])).to_equal(0)

    it "accepts os help aliases":
        step("Verify: accepts os help aliases")
        expect(handle_os_inline(["help"])).to_equal(0)
        expect(handle_os_inline(["--help"])).to_equal(0)

    it "rejects unknown os subcommands with a non-zero exit code":
        step("Verify: rejects unknown os subcommands with a non-zero exit code")
        expect(handle_os_inline(["unknown-subcommand"])).to_equal(1)

    it "keeps the last valid --log occurrence across mixed forms":
        step("Verify: keeps the last valid --log occurrence across mixed forms")
        val prior = env_get("SIMPLE_OS_LOG_MODE")
        val before = if prior == nil: "" else: prior
        expect(handle_os_inline(["build", "--log=off", "--log", "on", "--arch=bogus"])).to_equal(1)
        expect(env_get("SIMPLE_OS_LOG_MODE") ?? "").to_equal(before)

    it "rejects bare --arch followed by another option":
        step("Verify: rejects bare --arch followed by another option")
        expect(handle_os_inline(["build", "--arch", "--log=off"])).to_equal(1)

    it "rejects bare --target followed by another option":
        step("Verify: rejects bare --target followed by another option")
        expect(handle_os_inline(["build", "--target", "--log=off"])).to_equal(1)

    it "rejects bare --scenario followed by another option":
        step("Verify: rejects bare --scenario followed by another option")
        expect(handle_os_inline(["build", "--scenario", "--arch=x86_64"])).to_equal(1)
