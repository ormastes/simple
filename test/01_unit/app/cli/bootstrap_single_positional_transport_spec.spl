extern fn rt_file_read_text(path: text) -> text

describe "bootstrap single-file native build transport":
    it "seeds scalar entry slots before import closure discovery":
        val source = rt_file_read_text("src/app/cli/bootstrap_positional_native_build.spl") ?? ""
        val args_source = rt_file_read_text("src/app/cli/bootstrap_focused_native_build_args.spl") ?? ""
        val compile_source = rt_file_read_text("src/app/cli/bootstrap_focused_compile.spl") ?? ""
        expect(source).to_contain("options.input_files = [entry_path]")
        expect(source).to_contain("options.bootstrap_input_count = 1")
        expect(source).to_contain("options.bootstrap_input_0 = entry_path")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY\", entry_path)")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")")
        expect(source).to_contain("options.opt_level = 3")
        expect(args_source).to_contain("focused_native_build_single_spl_positional_index(args)")
        expect(args_source).to_contain("var entry_index: i64 = -1")
        expect(compile_source).to_contain("pub fn run_bootstrap_compile_dispatch(args: [text]) -> i64:")
        expect(compile_source).to_contain("options.output_format = driver_output_format_smf()")
        expect(compile_source).to_contain("fn bootstrap_compile_option_takes_value(arg: text) -> bool:")
        expect(source).to_contain("file_size(output)")
        expect(source.contains("app.io._CliCompile.compile_options")).to_equal(false)
