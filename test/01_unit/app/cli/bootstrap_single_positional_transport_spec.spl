extern fn rt_file_read_text(path: text) -> text

describe "bootstrap single-file native build transport":
    it "seeds scalar entry slots before import closure discovery":
        val source = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
        expect(source).to_contain("options.input_files = [entry_path]")
        expect(source).to_contain("options.bootstrap_input_count = 1")
        expect(source).to_contain("options.bootstrap_input_0 = entry_path")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY\", entry_path)")
        expect(source).to_contain("env_set(\"SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE\", \"0\")")
        expect(source).to_contain("options.opt_level = 3")
        expect(source).to_contain("focused_native_build_low_memory_value(args)")
        expect(source).to_contain("options.low_memory = focused_native_build_low_memory_value(args) == \"1\"")
        expect(source).to_contain("fn run_compile_bootstrap(args: [text]) -> i64:")
        expect(source).to_contain("options.output_format = driver_output_format_smf()")
        expect(source).to_contain("fn bootstrap_compile_option_takes_value(arg: text) -> bool:")
        expect(source).to_contain("file_size(output)")
        expect(source.contains("app.io._CliCompile.compile_options")).to_equal(false)

    it "forwards low-memory into canonical Stage 3":
        val source = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val stage3_start = source.find("bootstrap_stage3_run_transcribed") ?? -1
        val stage3_end = source.find("stage3_status=$?", stage3_start) ?? -1
        expect(stage3_start).to_be_greater_than(-1)
        expect(stage3_end).to_be_greater_than(stage3_start)
        expect(source[stage3_start:stage3_end]).to_contain("--low-memory")
        val hash_start = source.find("stage3_build_args_sha256=$(") ?? -1
        val hash_end = source.find("bootstrap_stage3_directory_snapshot", hash_start) ?? -1
        expect(hash_start).to_be_greater_than(-1)
        expect(hash_end).to_be_greater_than(hash_start)
        expect(source[hash_start:hash_end]).to_contain("--low-memory")
        val hash_mode = source.find("--mode", hash_start) ?? -1
        val hash_low_memory = source.find("--low-memory", hash_start) ?? -1
        expect(hash_low_memory).to_be_greater_than(hash_mode)
        expect(hash_low_memory).to_be_less_than(hash_end)
