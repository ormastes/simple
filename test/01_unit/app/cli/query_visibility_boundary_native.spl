# Standalone native control for the restored boundary classifier.
# Uses the same visibility JSON adapter imported by existing visibility specs.
# No BDD initialization, full-CLI child, private export change or runtime stub.
use std.cli.cli_util.{get_cli_args}
use app.io.file_ops.{file_exists, file_write, path_absolute}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use app.cli._QueryVisibility.query_commands.{visibility_json}

fn query_boundary_native_controls_v1(root: text) -> text:
    if file_exists(root): return "fixture-already-exists"
    if not dir_create_all(root + "/boundary"): return "boundary-directory"
    if not dir_create_all(root + "/open"): return "open-directory"
    if not dir_create_all(root + "/sibling"): return "sibling-directory"
    if not dir_create_all(root + "/bypass"): return "bypass-directory"
    val owner = root + "/boundary/owner.spl"
    val sibling = root + "/sibling/requester.spl"
    val open_owner = root + "/open/owner.spl"
    val bypass_owner = root + "/bypass/owner.spl"
    val declaration = "pub fn boundary_probe() -> i64: 41\n"
    if not file_write(root + "/boundary/__init__.spl", "# Ordinary boundary\n"):
        return "boundary-manifest-write"
    if not file_write(root + "/sibling/__init__.spl", "# Separate sibling boundary\n"):
        return "sibling-manifest-write"
    if not file_write(root + "/bypass/__init__.spl", "#[bypass]\n"):
        return "bypass-manifest-write"
    if not file_write(owner, declaration): return "boundary-owner-write"
    if not file_write(open_owner, declaration): return "open-owner-write"
    if not file_write(bypass_owner, declaration): return "bypass-owner-write"
    if not file_write(sibling, "fn requester() -> i64: 0\n"):
        return "sibling-requester-write"
    val boundary = visibility_json("boundary_probe", owner, owner)
    if not boundary.contains("\"boundaryKind\":\"boundary\""):
        return "boundary-kind"
    if not boundary.contains("\"reachable\":true"): return "owner-unreachable"
    val open_scope = visibility_json("boundary_probe", open_owner, sibling)
    if not open_scope.contains("\"boundaryKind\":\"open\""):
        return "open-kind"
    if not open_scope.contains("\"reachable\":true"): return "open-public-unreachable"
    val sibling_scope = visibility_json("boundary_probe", owner, sibling)
    if not sibling_scope.contains("\"boundaryKind\":\"boundary\""):
        return "sibling-changed-owner-kind"
    if not sibling_scope.contains("\"reachable\":false"):
        return "unexported-boundary-leaked-to-sibling"
    val bypass = visibility_json("boundary_probe", bypass_owner, sibling)
    if not bypass.contains("\"boundaryKind\":\"bypass\""):
        return "bypass-kind"
    if not bypass.contains("\"reachable\":true"): return "bypass-public-unreachable"
    ""

fn main() -> i64:
    val args = get_cli_args()
    if args.len() != 1:
        print "FAIL expected one fresh E-owned fixture directory"
        return 2
    val root = path_absolute(args[0]).replace("\\", "/")
    val failure = query_boundary_native_controls_v1(root)
    if failure != "":
        print "FAIL query-boundary: {failure}"
        return 1
    print "PASS query-boundary: boundary open sibling bypass"
    0
