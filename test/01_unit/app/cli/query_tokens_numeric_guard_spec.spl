# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: `simple query tokens` line-range flags arrive as raw CLI text; a
malformed coordinate must fall back to its documented default (start=1, end=0)
rather than coercing or crashing.
Audience: CLI and tooling engineers who maintain the query surface.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use app.cli.query_tokens.{query_tokens_nonnegative_int_or_default}

describe "query tokens numeric guard":
    # @manual scenario evidence
    it "defaults malformed token range coordinates":
        # @req REQ-SSPEC-APP
        step("Verify: malformed range coordinate falls back to its default")
        expect(query_tokens_nonnegative_int_or_default("", 1)).to_equal(1)  # oracle: empty start line defaults to 1
        expect(query_tokens_nonnegative_int_or_default("3x", 0)).to_equal(0)  # oracle: garbage end line defaults to 0
        expect(query_tokens_nonnegative_int_or_default("-5", 1)).to_equal(1)  # oracle: negative is non-digit, defaults

    it "honours clean numeric coordinates":
        # @req REQ-SSPEC-APP
        step("Verify: clean numeric coordinate parses exactly")
        expect(query_tokens_nonnegative_int_or_default("12", 1)).to_equal(12)  # oracle: exact parse
        expect(query_tokens_nonnegative_int_or_default(" 4 ", 0)).to_equal(4)  # oracle: trimmed parse
