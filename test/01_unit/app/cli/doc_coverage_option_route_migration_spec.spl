# @cover src/app/cli/doc_coverage_command.spl 0%
"""
# doc-coverage option-route migration — behaviour parity (reproducing)

**Category:** App / CLI
**Status:** Acceptance (reproducing)

Phase C adoption batch 1 (2026-08-18): the six doc-coverage options moved
from hardcoded literals into option-route records. This spec pins the exact
pre-migration parse behaviour: same spellings, same `--name=value` forms,
same defaults, same positional-root and unknown-flag handling.
"""

use std.spec.{describe, it, expect, step}
use app.cli.doc_coverage_command.{doc_coverage_parse_options}

describe "doc-coverage route-driven parse keeps pre-migration behaviour":

    it "keeps all defaults when no options are given":
        val o = doc_coverage_parse_options(["doc-coverage"], "/base")
        expect(o.check_public_api).to_be(false)
        expect(o.sdoctest_report).to_be(false)
        expect(o.show_missing).to_be(false)
        expect(o.tag_file == "").to_be(true)
        expect(o.format == "terminal").to_be(true)
        expect(o.tag_filter == "").to_be(true)
        expect(o.root == "/base").to_be(true)

    it "accepts the three flag spellings exactly as before":
        val o = doc_coverage_parse_options(["doc-coverage", "--check-public-api", "--sdoctest-report", "--missing"], "/base")
        expect(o.check_public_api).to_be(true)
        expect(o.sdoctest_report).to_be(true)
        expect(o.show_missing).to_be(true)

    it "accepts the three value options in --name=value form with same extraction":
        val o = doc_coverage_parse_options(["doc-coverage", "--tag-file=out.md", "--format=json", "--tag=math"], "/base")
        expect(o.tag_file == "out.md").to_be(true)
        expect(o.format == "json").to_be(true)
        expect(o.tag_filter == "math").to_be(true)

    it "does not confuse --tag= with --tag-file= (literal-chain ordering parity)":
        val o = doc_coverage_parse_options(["doc-coverage", "--tag-file=f.md"], "/base")
        expect(o.tag_file == "f.md").to_be(true)
        expect(o.tag_filter == "").to_be(true)

    it "ignores parse start index 0 and treats positional as root, last one wins":
        step("args[0] is the subcommand name and is never parsed as an option")
        val o = doc_coverage_parse_options(["--missing", "src", "other"], "/base")
        expect(o.show_missing).to_be(false)
        expect(o.root == "other").to_be(true)

    it "silently ignores an unknown dash token, as the literal chain did":
        val o = doc_coverage_parse_options(["doc-coverage", "--nonsense", "--format=csv"], "/base")
        expect(o.format == "csv").to_be(true)
        expect(o.root == "/base").to_be(true)

    it "requires the = form for value options: bare --format does not consume the next token":
        val o = doc_coverage_parse_options(["doc-coverage", "--format", "json"], "/base")
        expect(o.format == "terminal").to_be(true)
        step("the bare token starts with '-' so it is ignored; 'json' becomes root")
        expect(o.root == "json").to_be(true)
