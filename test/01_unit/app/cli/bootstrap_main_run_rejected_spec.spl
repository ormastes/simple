"""
## Purpose and audience
Purpose: Pin the bootstrap CLI contract that `run` is NOT a bootstrap command.
The Stage 2 sanity gate (scripts/bootstrap/bootstrap-from-scratch.sh) uses
`run <file>` as a negative control and requires rc 1 with
`unknown command 'run'`; a working `run` dispatch fails every Phase 2 bootstrap.
Audience: CLI and bootstrap maintainers.
"""

# @req: REQ-APP-CLI-BOOTSTRAP-RUN-001

use std.spec.*

extern fn rt_file_read_text(path: text) -> text?

describe "Bootstrap CLI rejects run (Stage 2 sanity negative control)":

    it "has no general run dispatch in bootstrap_main":
        val src = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
        expect(src.len()).to_be_greater_than(0)
        expect(src.contains("if first == \"run\":")).to_equal(false)
        expect(src.contains("run_bootstrap_script")).to_equal(false)

    it "keeps the marked-worker run guard and the canonical unknown-command path":
        val src = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
        expect(src).to_contain("if first == \"run\" and native_worker_marker == \"1\"")
        expect(src).to_contain("print \"error: unknown command '")

    it "matches the sanity gate expectation":
        val gate = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        expect(gate).to_contain("*\"unknown command 'run'\"*) unsupported_match_status=0")
