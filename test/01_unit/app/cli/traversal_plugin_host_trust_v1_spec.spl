use std.spec.{describe, it, expect}
use app.cli.traversal_plugin_host_trust_v1.{
    traversal_plugin_host_trust_root_parse_user_config_v1}

val RFC8032_TEST_PUBLIC_KEY =
    "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"

describe "Traversal plugin host trust root V1":
    it "reads only the explicit host user config key as canonical lowercase hex":
        val config = "traversal_plugins:\n  trust_root_ed25519: \"{RFC8032_TEST_PUBLIC_KEY}\"\n"
        val resolved = traversal_plugin_host_trust_root_parse_user_config_v1(config)
        expect(resolved.is_ok()).to_equal(true)
        expect(resolved.unwrap().public_key.len()).to_equal(32)
        expect(resolved.unwrap().public_key_fingerprint.starts_with("sha256:")).to_equal(true)
        expect(resolved.unwrap().source_digest.starts_with("sha256:")).to_equal(true)

    it "refuses absent, noncanonical, malformed, and oversized host key records":
        expect(traversal_plugin_host_trust_root_parse_user_config_v1(
            "environment_variants:\n  parser_prefer: scalar\n").is_err()).to_equal(true)
        expect(traversal_plugin_host_trust_root_parse_user_config_v1(
            "traversal_plugins:\n  trust_root_ed25519: \"D75A980182B10AB7D54BFED3C964073A0EE172F3DAA62325AF021A68F707511A\"\n").is_err()).to_equal(true)
        expect(traversal_plugin_host_trust_root_parse_user_config_v1(
            "traversal_plugins:\n  trust_root_ed25519: short\n").is_err()).to_equal(true)
        expect(traversal_plugin_host_trust_root_parse_user_config_v1("x" * 65537).is_err()).to_equal(true)
