use std.spec
use std.io_runtime.{file_read}
use app.cli.cli_helpers.{
    cli_generated_help_text_v1,
    cli_generated_completion_candidates_v1,
}
use app.cli.help_surface_inventory.{
    cli_surface_snapshot_v1, cli_surface_generated_payload_hash_v1,
}
use app.cli.help_surface_generated_data.{
    CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1,
}
use app.cli.help_surface_codegen.{
    cli_surface_codegen_extract_log_flags_v1,
    cli_surface_codegen_extract_internal_flags_v1,
}
use app.cli.dispatch.{cli_dispatch_tail_args_v1}
use app.io._CliCommands.run_commands.{cli_run_provider_entry_v1}
use app.cli.command_registry.{
    cli_registry_direct_script_target_v1,
    cli_registry_provider_route_valid_v1,
    cli_registry_app_path_v1,
}

describe "production CLI generated help, completion, and provider routing parity":
    it "serves admitted core help and retains extension help":
        expect(cli_surface_generated_payload_hash_v1()).to_equal(
            CLI_SURFACE_GENERATED_PAYLOAD_SHA256_V1)
        val extension_help = "extension namespaces:\n  --xsample-<key>[=<value>]  provider: sample\n"
        val help = cli_generated_help_text_v1(extension_help)
        expect(help).to_contain("simple provider")
        expect(help).to_contain("Simple Language v1.0.0-RC")
        expect(help).to_contain("Usage:")
        expect(help).to_contain("Examples:")
        expect(help).to_contain(extension_help)
        expect(help.contains("generated CLI surface is stale")).to_equal(false)

    it "renders structured registry records once in production":
        val source = file_read("src/app/cli/cli_helpers.spl")
        val report_source = file_read("src/app/cli/help_surface_report.spl")
        val generated_source = file_read(
            "src/app/cli/help_surface_generated_data.spl")
        expect(source).to_contain("fn print_cli_help():\n    print_cli_help_with_extensions_v1(\"\")")
        expect(source.contains("print_cli_help_descriptive_extension_v1()"))
            .to_equal(false)
        expect(report_source).to_contain("cli_registry_render_help_v1")
        expect(generated_source).to_contain("registry projections")
        expect(generated_source.contains("simple compile <src>"))
            .to_equal(false)
        expect(source).to_contain("fn cli_help_legacy_migration_oracle_v1")

    it "derives exact completion flags from their accepted-option owners":
        val dispatch_source = file_read("src/app/cli/_CliMain/main_and_help.spl")
        val args_source = file_read("src/app/cli/_CliMain/args_and_os_commands.spl")
        val snapshot = cli_surface_snapshot_v1()
        expect(snapshot.log_flags).to_equal(
            cli_surface_codegen_extract_log_flags_v1(dispatch_source))
        expect(snapshot.internal_flags).to_equal(
            cli_surface_codegen_extract_internal_flags_v1(args_source))
        val gc = cli_generated_completion_candidates_v1("--gc", ["--xsample-"])
        expect(gc).to_equal(["--gc-log", "--gc-off"])
        expect(gc.contains("--gc")).to_equal(false)

    it "keeps structured option rows in the established visible order":
        val help = cli_generated_help_text_v1("")
        expect(help.index_of("-h, --help")).to_be_less_than(
            help.index_of("--notui"))
        expect(help.index_of("--notui")).to_be_less_than(
            help.index_of("--gc-log"))
        expect(help.index_of("--gc-off")).to_be_less_than(
            help.index_of("--low-memory"))
        expect(help.index_of("--mem-infra=a,b,c[,auto] [--mem-infra-strict]")).to_be_less_than(
            help.index_of("SIMPLE_EXECUTION_MODE env var"))

    it "keeps provider and extension completions on the production adapter":
        expect(cli_generated_completion_candidates_v1(
            "provider", ["--xsample-"])).to_equal(["provider"])
        expect(cli_generated_completion_candidates_v1(
            "--x", ["--xsample-"])).to_equal(["--xsample-"])
        val query_source = file_read("src/app/cli/query.spl")
        expect(query_source).to_contain("if subcmd == \"cli-completions\"")
        expect(query_source).to_contain(
            "cli_generated_completion_candidates_v1(")

    it "normalizes explicit and table provider argv to the same tail":
        val full = cli_dispatch_tail_args_v1(
            "provider", ["provider", "run", "fmt-leaf", "alpha.spl"])
        val tail = cli_dispatch_tail_args_v1(
            "provider", ["run", "fmt-leaf", "alpha.spl"])
        expect(full).to_equal(["run", "fmt-leaf", "alpha.spl"])
        expect(tail).to_equal(full)

    it "preserves provider fallback exit statuses instead of collapsing to zero":
        expect(cli_run_provider_entry_v1(["metadata"])).to_equal(0)
        expect(cli_run_provider_entry_v1(["bad-subcommand"])).to_equal(2)
        expect(cli_run_provider_entry_v1(["query", "native"])).to_equal(3)

    it "keeps the registry-owned provider route tail-preserving":
        val root_source = file_read("src/app/cli/_CliMain/main_and_help.spl")
        val table_source = file_read("src/app/cli/dispatch/table.spl")
        expect(cli_registry_direct_script_target_v1("provider")).to_equal(
            "src/app/provider_cli/main.spl")
        expect(cli_registry_provider_route_valid_v1()).to_equal(true)
        expect(cli_registry_app_path_v1("provider")).to_equal(
            "src/app/provider_cli/main.spl")
        expect(root_source).to_contain("cli_registry_direct_script_target_v1")
        expect(table_source).to_contain("cli_registry_command_names_v1()")
