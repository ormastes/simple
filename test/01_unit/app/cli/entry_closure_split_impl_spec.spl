use std.spec.*
use std.io_runtime.{file_read_nullable}

# Bug: stage2_split_impl_modules_missing_from_entry_closure_2026-08-22.
# Native entry-closure discovery follows import edges only, so a split impl
# provider (type in A, `impl` in B) survives only if A imports B explicitly.
# This spec pins those edges in the compiler sources and in the fixture;
# removing an edge (reverting the fix) makes it fail. The walker-level check
# is entry_closure_split_impl_walk_spec.spl.

fn _source_has(path: text, needle: text) -> bool:
    val content = file_read_nullable(path)
    if content.is_none():
        return false
    content.unwrap().contains(needle)

describe "split impl provider import edges":
    it "keeps HirLowering.union_narrow_arms provider imported by match_desugaring":
        expect(_source_has(
            "src/compiler/20.hir/hir_lowering/_Expressions/match_desugaring.spl",
            "\nuse compiler.hir.hir_lowering._Expressions.union_narrow_arms.*")).to_equal(true)

    it "keeps MethodResolver lookup helpers imported by resolve":
        expect(_source_has(
            "src/compiler/35.semantics/resolve.spl",
            "\nuse compiler.semantics.resolve_lookup_helpers.*")).to_equal(true)

    it "fixture type owner imports its impl provider; the no-edge twin does not":
        val fx = "test/fixtures/entry_closure_split_impl"
        expect(_source_has(fx + "/type_owner.spl",
            "\nuse entry_closure_split_impl.impl_provider.*")).to_equal(true)
        expect(_source_has(fx + "/type_owner_no_edge.spl", "impl_provider")).to_equal(false)
