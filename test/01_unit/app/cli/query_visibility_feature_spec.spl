# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-APP-LSP-VISIBILITY-FEATURE
# design: doc/05_design/app/mcp/mdsoc_visibility_requester_design.md ; guide: doc/07_guide/app/mcp/mcp_visibility.md
"""
MDSOC visibility classification on REAL tree fixtures:
- layer axis  (`__init__.spl` boundary, `simpleVisibility`)
- feature axis (`arch { dimension = "feature" }` capsule, `featureVisibility`)
- requester location parsing (`path[:line]`) and the no-requester rule
  (only boundary-crossing symbols are reachable — never "self").

Run: `bin/simple test test/01_unit/app/cli/query_visibility_feature_spec.spl`
"""

use std.spec
use std.spec.step
use app.cli._QueryVisibility.feature_visibility.*
use app.cli._QueryVisibility.query_commands.{visibility_json, visibility_reachable, visibility_display, exported_by, declared_visibility, requester_file_part, requester_line_part, boundary_module}

val LEXING_PORTS = "src/compiler/85.mdsoc/feature/lexing/app/ports.spl"
val PARSING_PORTS = "src/compiler/85.mdsoc/feature/parsing/app/ports.spl"
val PARSE_ERROR = "src/compiler/85.mdsoc/feature/parsing/app/parse_error.spl"
val DRIVER = "src/compiler/80.driver/driver.spl"
val LIB_PATH = "src/lib/nogc_sync_mut/path.spl"

describe "MDSOC feature capsule identity":
    it "resolves the feature capsule root and id from a port file":
        step("feature_dir_of / feature_id_of on feature/lexing/app/ports.spl")
        expect(feature_dir_of(LEXING_PORTS)).to_equal("src/compiler/85.mdsoc/feature/lexing")
        expect(feature_id_of(LEXING_PORTS)).to_equal("compiler.85.mdsoc.feature.lexing")

    it "reports no feature for layer-only modules":
        step("driver.spl and lib path.spl live in layers, not feature capsules")
        expect(feature_dir_of(DRIVER)).to_equal("")
        expect(feature_id_of(LIB_PATH)).to_equal("")

    it "reads the exports.expose list of the capsule manifest":
        step("expose = [\"./app/ports\"] resolves relative to the capsule root")
        expect(feature_expose_paths("src/compiler/85.mdsoc/feature/lexing")).to_equal(["src/compiler/85.mdsoc/feature/lexing/app/ports"])
        expect(feature_file_exposed("src/compiler/85.mdsoc/feature/lexing", LEXING_PORTS)).to_equal(true)
        expect(feature_file_exposed("src/compiler/85.mdsoc/feature/lexing", "src/compiler/85.mdsoc/feature/lexing/app/lexer_input_port.spl")).to_equal(false)

describe "MDSOC feature-public classification":
    it "treats names re-exported by an exposed port file as feature-public":
        step("ports.spl declares nothing; its use {..} lines are the port surface")
        expect(feature_reexports_in_file(LEXING_PORTS)).to_equal(["LexerInputPort", "LexerOutputPort"])
        # lexing/app/__init__.spl also names it in an export line — that reason wins.
        expect(feature_export_reason("LexerOutputPort", LEXING_PORTS, "private")).to_contain("named in an export line")
        # a port re-export that no manifest names falls back to the exposed-port reason
        expect(feature_export_reason("LexerInputPort", "src/compiler/85.mdsoc/feature/lexing/app/ports.spl", "private")).to_contain("export")

    it "treats names in a capsule __init__.spl export line as feature-public":
        step("parsing/app/__init__.spl: `export ParseError, ParserInputPort, ParserOutputPort`")
        expect(feature_manifest_exports("src/compiler/85.mdsoc/feature/parsing", PARSE_ERROR)).to_contain("ParseError")
        expect(feature_export_reason("ParseError", PARSE_ERROR, "private")).to_contain("named in an export line")

    it "keeps an unexported, unexposed symbol feature-private":
        step("a name that appears in no export line and no exposed port")
        expect(feature_export_reason("not_a_real_symbol_xyz", PARSE_ERROR, "private")).to_equal("")
        expect(feature_export_reason("anything", DRIVER, "public")).to_equal("")

    it "makes feature-private symbols reachable only from inside the same capsule":
        step("feature_reachable(owner, requester, exported=false)")
        expect(feature_reachable(PARSE_ERROR, PARSING_PORTS, false)).to_equal(true)
        expect(feature_reachable(PARSE_ERROR, DRIVER, false)).to_equal(false)
        expect(feature_reachable(PARSE_ERROR, "", false)).to_equal(false)
        expect(feature_reachable(PARSE_ERROR, DRIVER, true)).to_equal(true)

    it "emits featureVisibility only for owners inside a feature capsule":
        step("visibility_json sibling field")
        val in_feature = visibility_json("ParseError", PARSE_ERROR, DRIVER)
        expect(in_feature).to_contain("\"featureVisibility\":{\"feature\":\"compiler.85.mdsoc.feature.parsing\",\"exported\":true,\"reachable\":true")
        expect(in_feature).to_contain("\"boundaryKind\":\"boundary\"")
        val in_layer = visibility_json("basename", LIB_PATH, DRIVER)
        expect(in_layer.contains("featureVisibility")).to_equal(false)
        expect(in_layer).to_contain("\"boundaryModule\":\"lib.nogc_sync_mut\"")

describe "MDSOC layer-public classification from a requester":
    it "recognises bare `export A, B` manifest lines as layer exports":
        step("lib/nogc_sync_mut/__init__.spl: `export basename, dirname, extension, stem`")
        expect(exported_by("basename", LIB_PATH)).to_equal("src/lib/nogc_sync_mut/__init__.spl")
        expect(visibility_display("basename", LIB_PATH)).to_equal("public")
        expect(visibility_reachable("basename", LIB_PATH, DRIVER)).to_equal(true)

    it "keeps private symbols unreachable across the boundary and with no requester":
        step("driver.spl `process_sdn` is private")
        expect(declared_visibility("process_sdn", DRIVER)).to_equal("private")
        expect(visibility_reachable("process_sdn", DRIVER, LIB_PATH)).to_equal(false)
        expect(visibility_reachable("process_sdn", DRIVER, "")).to_equal(false)
        expect(visibility_reachable("process_sdn", DRIVER, DRIVER)).to_equal(true)
        expect(boundary_module(DRIVER)).to_equal("compiler.80.driver")

describe "requester location parsing":
    it "splits path[:line] and echoes the line":
        step("requester_file_part / requester_line_part")
        expect(requester_file_part("src/compiler/80.driver/driver.spl:100")).to_equal("src/compiler/80.driver/driver.spl")
        expect(requester_line_part("src/compiler/80.driver/driver.spl:100")).to_equal(100)
        expect(requester_file_part("src/compiler/80.driver/driver.spl")).to_equal("src/compiler/80.driver/driver.spl")
        expect(requester_line_part("src/compiler/80.driver/driver.spl")).to_equal(0)
        expect(requester_file_part("")).to_equal("")
