# @cover src/app/cli/check_entry.spl 5%
# @manual_section: check worker install-root resolution
"""
## Purpose and audience
As a Simple developer running `simple check` from any directory, the check
worker binary and its source entry must be found relative to the install that
dispatched me, not relative to my shell's working directory.
## Operator workflow
bin/simple test test/01_unit/app/cli/check_entry_install_root_spec.spl
## Compatibility and limitations
Pure path predicate test: no process is spawned.
"""
# doc-path: doc/08_tracking/bug/check_worker_missing_outside_repo_root_2026-09-28.md

use std.spec.{step}
use std.spec.*
use app.cli.check_entry.{check_install_root, check_rooted_path}

describe "check worker install-root resolution":

    it "derives the checkout root from a release binary path":
        # @req REQ-CHECK-WORKER-ROOT-001
        step("A release binary lives at <root>/bin/release/<triple>/simple")
        val exe = "/home/u/simple/bin/release/aarch64-unknown-linux-gnu/simple"
        expect(check_install_root(exe)).to_equal("/home/u/simple")

    it "returns empty for a binary outside a release tree":
        # @req REQ-CHECK-WORKER-ROOT-002
        step("An unrelated executable gives no root; callers keep cwd-relative paths")
        expect(check_install_root("/usr/local/bin/simple")).to_equal("")
        expect(check_install_root("")).to_equal("")

    it "roots relative worker paths under the install root":
        # @req REQ-CHECK-WORKER-ROOT-003
        step("Relative paths are prefixed; an empty root leaves them unchanged")
        expect(check_rooted_path("/home/u/simple", "src/app/check/main.spl")).to_equal("/home/u/simple/src/app/check/main.spl")
        expect(check_rooted_path("", "bin/simple")).to_equal("bin/simple")
