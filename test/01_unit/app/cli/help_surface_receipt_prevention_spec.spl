use std.spec
use app.cli.help_surface_inventory.{
    cli_surface_snapshot_v1,
    cli_surface_generated_sources_current_v1,
    cli_surface_exact_help_dispatch_parity_v1,
}

# Prevention for cli_surface_registry_dispatch_table_drift_2026-09-05:
# any edit to the four bound CLI sources stales the identity receipt and
# fail-closes completion/help to []. This fails with the regenerate command.
describe "CLI surface identity receipt prevention":
    it "receipt matches live sources (regen: simple run src/app/cli/help_surface_codegen.spl --write)":
        expect(cli_surface_generated_sources_current_v1()).to_equal(true)

    it "dispatch/help/table parity holds on the live tree":
        expect(cli_surface_exact_help_dispatch_parity_v1(cli_surface_snapshot_v1())).to_equal(true)
