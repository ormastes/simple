# The bootstrap CLI's positional route (`native-build <file>.spl`) must hand
# --runtime-bundle / --runtime-path to the link step. It used to drop both:
# with an ambient SIMPLE_RUNTIME_PATH the link fell back to the "ordinary"
# runtime set plus the seed aggregate archive, and a hello-world link failed
# with 20 undefined LLVM* symbols on Windows-MSVC (2026-10-11).
use app.cli.bootstrap_focused_native_build_args.{focused_native_build_runtime_bundle, focused_native_build_runtime_path, focused_native_build_target}
use compiler.backend.llvm_native_link_hosted_support.{native_all_allowed_for_runtime_bundle}
use compiler.backend.runtime_compiler.{runtime_object_profile_v1}

extern fn rt_file_read_text(path: text) -> text

fn positional_route_source() -> text:
    val source = rt_file_read_text("src/app/cli/bootstrap_main.spl") ?? ""
    val start = source.find("val entry_path = native_build_single_spl_positional(args)") ?? -1
    val end = source.find("fn bootstrap_compile_option_takes_value") ?? -1
    if start < 0 or end <= start:
        return ""
    source.substring(start, end)

describe "bootstrap positional native-build runtime authority":
    it "reads --runtime-bundle in both spellings":
        expect(focused_native_build_runtime_bundle(["simple", "native-build", "--runtime-bundle", "core-c-bootstrap", "a.spl"])).to_equal("core-c-bootstrap")
        expect(focused_native_build_runtime_bundle(["simple", "native-build", "--runtime-bundle=simple-core", "a.spl"])).to_equal("simple-core")

    it "reports no bundle when the flag is absent or has no value":
        expect(focused_native_build_runtime_bundle(["simple", "native-build", "a.spl"])).to_equal("")
        expect(focused_native_build_runtime_bundle(["simple", "native-build", "a.spl", "--runtime-bundle"])).to_equal("")

    it "reads --runtime-path":
        expect(focused_native_build_runtime_path(["simple", "native-build", "--runtime-path", "rt/dir", "a.spl"])).to_equal("rt/dir")

    it "a bound core-c bundle keeps the seed aggregate archive off the link line":
        expect(native_all_allowed_for_runtime_bundle("core-c-bootstrap")).to_equal(false)
        expect(runtime_object_profile_v1("core-c-bootstrap", false)).to_equal("core-c-bootstrap")

    it "an unbound bundle is what admits the seed aggregate archive":
        expect(native_all_allowed_for_runtime_bundle("")).to_equal(true)
        expect(runtime_object_profile_v1("", false)).to_equal("ordinary")

    it "binds both before the driver runs and restores them after":
        val route = positional_route_source()
        expect(route.len() > 0).to_equal(true)
        val bind_bundle = route.find("env_set(\"SIMPLE_NATIVE_RUNTIME_BUNDLE\", positional_runtime_bundle)") ?? -1
        val bind_path = route.find("env_set(\"SIMPLE_RUNTIME_PATH\", positional_runtime_path)") ?? -1
        val run = route.find("compiler_driver_run_compile(driver)") ?? -1
        val restore_bundle = route.find("env_set(\"SIMPLE_NATIVE_RUNTIME_BUNDLE\", old_runtime_bundle)") ?? -1
        val restore_path = route.find("env_set(\"SIMPLE_RUNTIME_PATH\", old_runtime_path)") ?? -1
        expect(bind_bundle > 0).to_equal(true)
        expect(bind_path > 0).to_equal(true)
        expect(bind_bundle < run).to_equal(true)
        expect(bind_path < run).to_equal(true)
        expect(restore_bundle > run).to_equal(true)
        expect(restore_path > run).to_equal(true)

describe "bootstrap positional native-build --target":
    it "reads --target in both spellings":
        expect(focused_native_build_target(["simple", "native-build", "a.spl", "--target", "x86_64-unknown-none"])).to_equal("x86_64-unknown-none")
        expect(focused_native_build_target(["simple", "native-build", "--target=x86_64-unknown-simpleos", "a.spl"])).to_equal("x86_64-unknown-simpleos")
        expect(focused_native_build_target(["simple", "native-build", "a.spl"])).to_equal("")

    it "binds --target into CompileOptions before the driver is created":
        val route = positional_route_source()
        val bind = route.find("options.native_target = focused_native_build_target(args)") ?? -1
        val create = route.find("compiler_driver_create(options)") ?? -1
        expect(bind > 0).to_equal(true)
        expect(bind < create).to_equal(true)
