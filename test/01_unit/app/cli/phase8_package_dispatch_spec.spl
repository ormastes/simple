# @req KPM-REQ-014 KPM-REQ-009
use std.spec.*
use app.cli.command_registry.{cli_registry_direct_script_target_v1}
use app.cli.dispatch.table.{get_command_table}
use std.io.{file_read}

fn runtime_app_path(name: text) -> text:
    for entry in get_command_table():
        if entry.name == name:
            return entry.app_path
    ""

describe "Phase 8 package command dispatch":
    it "routes update through both canonical and runtime command tables":
        expect(cli_registry_direct_script_target_v1("update")).to_equal(
            "src/app/update/main.spl")
        expect(runtime_app_path("update")).to_equal("src/app/update/main.spl")

    it "routes lock through both canonical and runtime command tables":
        expect(cli_registry_direct_script_target_v1("lock")).to_equal(
            "src/app/lock/main.spl")
        expect(runtime_app_path("lock")).to_equal("src/app/lock/main.spl")

    it "passes only command-tail arguments from the production root CLI":
        val root_cli = file_read("src/app/cli/_CliMain/main_and_help.spl")
        expect(root_cli).to_contain(
            "cli_run_file(\"src/app/update/main.spl\", _cli_args_from(filtered_args, 1)")
        expect(root_cli).to_contain(
            "cli_run_file(\"src/app/lock/main.spl\", _cli_args_from(filtered_args, 1)")
