"""Restricted producer policy consumes values from existing argument owners."""
use std.spec.{describe, it, expect, step}
use app.cli.bootstrap_llvm_backend_request.{bootstrap_llvm_backend_request_error_v1}

describe "LLVM bootstrap producer request boundary":
    it "accepts LLVM and the existing automatic default":
        step("Select LLVM without restricting which source implementations compile")
        expect(bootstrap_llvm_backend_request_error_v1("llvm", "")).to_equal("")
        expect(bootstrap_llvm_backend_request_error_v1("auto", "")).to_equal("")
        expect(bootstrap_llvm_backend_request_error_v1("", "")).to_equal("")

    it "rejects every unavailable requested code generator":
        step("Refuse unavailable output backends before entering compilation")
        for backend in ["cranelift", "vhdl", "c", "wasm", "cuda", "opencl"]:
            expect(bootstrap_llvm_backend_request_error_v1(
                backend, "")).to_contain("PLUG-E-NOTFOUND")
            expect(bootstrap_llvm_backend_request_error_v1(
                backend, "")).to_contain(backend)

    it "rejects plugin overrides even when LLVM itself is requested":
        step("Refuse plugin loading unavailable in the restricted producer")
        expect(bootstrap_llvm_backend_request_error_v1(
            "llvm", "custom.smf")).to_contain("PLUG-E-UNSUPPORTED")
        expect(bootstrap_llvm_backend_request_error_v1(
            "auto", "custom.smf")).to_contain("custom.smf")
