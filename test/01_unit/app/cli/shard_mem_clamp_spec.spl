use std.spec
use app.cli.shard_mem_clamp.{shard_mem_available_kb, shard_mem_available_kb_from_field, shard_threads_cap_for, shard_threads_tree_cap_for, shard_worker_budget_kb, shard_host_threads_cap, shard_host_worker_budget_kb, shard_host_budget_floor_kb}

# Mechanism pin for the MemAvailable-derived shard concurrency clamp.
# Pre-fix the clamp did not exist: the thread count came from host_cpus/2 alone,
# so 16 workers x ~2.5-3.3 GB asked for ~40 GB and the worker group was
# OOM-reaped mid-HIR (run17, rc=255 after 12,643 s / 3 attempts).
# doc/08_tracking/bug/shard_threads_no_memavailable_clamp_2026-08-23.md
#
# NOTE ON WHAT THIS SPEC CANNOT DO. The first landing of this clamp
# (ff095d31591) shipped with this spec GREEN while every native-build aborted
# with rc=134 -- because the crash was in file_read on the *call path*, and a
# unit spec exercises the clamp FUNCTION only. The end-to-end bar therefore
# lives in scripts/check/check-native-build-not-crashing.shs, which runs a real
# native-build. Do not treat this file as sufficient evidence on its own.
# doc/09_report/build_parallelism_memory_audit_2026-08-23.md
describe "shard memory clamp":

    it "reads real host memory headroom on Windows and Linux":
        val kb = shard_mem_available_kb()
        expect(kb > 0).to_be_true()

    it "returns unknown for missing junk negative or overflowing memory fields":
        expect(shard_mem_available_kb_from_field("")).to_equal(0)
        expect(shard_mem_available_kb_from_field("not-a-number")).to_equal(0)
        expect(shard_mem_available_kb_from_field("-1")).to_equal(0)
        expect(shard_mem_available_kb_from_field("9223372036854775808")).to_equal(0)
        expect(shard_mem_available_kb_from_field("9223372036854775807")).to_equal(9223372036854775807)
        expect(shard_mem_available_kb_from_field("  16000000  ")).to_equal(16000000)

    it "clamps 16 requested workers down when memory is short":
        # 16 GB available, 3 GB HIR worker: 0.6 * 16 / 3 = 3 workers.
        expect(shard_threads_cap_for(16, 3000000, 16000000)).to_equal(3)
        # The exact shape of the run17 OOM: 16 requested on a box with 16 GB.
        expect(shard_threads_cap_for(16, 3000000, 16000000) < 16).to_be_true()

    it "never raises the requested count":
        expect(shard_threads_cap_for(8, 1650000, 125000000)).to_equal(8)
        expect(shard_threads_cap_for(2, 1650000, 125000000)).to_equal(2)

    it "uses the sequential path when memory or the worker estimate is unknown":
        expect(shard_threads_cap_for(16, 3000000, 1000)).to_equal(1)
        expect(shard_threads_cap_for(16, 3000000, 0)).to_equal(1)
        expect(shard_threads_cap_for(16, 3000000, -1)).to_equal(1)
        expect(shard_threads_cap_for(16, 0, 16000000)).to_equal(1)

    it "reserves space for the parent when a large host has a small tree cap":
        expect(shard_threads_tree_cap_for(40, 1650000, 68000000, 5859375, true)).to_equal(2)
        expect(shard_threads_tree_cap_for(40, 3000000, 68000000, 5859375, true)).to_equal(1)
        expect(shard_threads_tree_cap_for(40, 1650000, 2000000, 5859375, true)).to_equal(1)

    it "bounds an undeclared tree budget by measured host headroom, never unlimited":
        # No enclosing cap declared: 0.6 * 68 GB / 1.65 GB = 24, not 40, not 1.
        # Enforcing owners declare their cap through the RSS watchdog
        # (scripts/bootstrap/tests/watchdog-shard-budget-export-test.shs).
        expect(shard_threads_tree_cap_for(40, 1650000, 68000000, 0, true)).to_equal(24)
        expect(shard_threads_tree_cap_for(40, 1650000, 68000000, -1, true)).to_equal(24)
        # A low-memory host still drops to the sequential path.
        expect(shard_threads_tree_cap_for(40, 1650000, 2000000, 0, true)).to_equal(1)
        # Unknown host memory is still sequential, with or without a tree cap.
        expect(shard_threads_tree_cap_for(40, 1650000, 0, 5859375, true)).to_equal(1)
        expect(shard_threads_tree_cap_for(40, 1650000, 0, 0, true)).to_equal(1)

    it "honours host max_threads and lets worker_mem_mib only raise a budget":
        expect(shard_host_threads_cap(40, "8")).to_equal(8)
        expect(shard_host_threads_cap(4, "8")).to_equal(4)
        expect(shard_host_threads_cap(40, "")).to_equal(40)
        expect(shard_host_threads_cap(40, "0")).to_equal(40)
        expect(shard_host_worker_budget_kb("1000")).to_equal(1024000)
        expect(shard_host_worker_budget_kb("")).to_equal(0)
        expect(shard_host_worker_budget_kb("9223372036854775807")).to_equal(0)
        # 1000 MiB must not replace the 3 GB HIR default; 4000 MiB may raise it.
        expect(shard_host_budget_floor_kb(1024000, 3000000)).to_equal(3000000)
        expect(shard_host_budget_floor_kb(4096000, 3000000)).to_equal(4096000)
        expect(shard_host_budget_floor_kb(0, 3000000)).to_equal(3000000)

    it "keeps a known tree cap when the host estimate is explicitly disabled":
        expect(shard_threads_tree_cap_for(40, 1650000, 0, 5859375, false)).to_equal(2)
        expect(shard_threads_tree_cap_for(40, 1650000, 0, 0, false)).to_equal(40)

    it "does not overflow a positive i64 memory bound or raise a serial request":
        expect(shard_threads_cap_for(40, 1650000, 9223372036854775807)).to_equal(40)
        expect(shard_threads_tree_cap_for(1, 1650000, 0, 0, true)).to_equal(1)
        expect(shard_threads_tree_cap_for(0, 1650000, 0, 0, true)).to_equal(0)

    it "clamps HIR shards harder than parse shards at the same memory":
        # HIR children still spawn the full worker closure; parse children run
        # the slim entry. Same MemAvailable, different budget, different cap.
        val avail = 24000000
        val parse_cap = shard_threads_cap_for(16, 1650000, avail)
        val hir_cap = shard_threads_cap_for(16, 3000000, avail)
        expect(hir_cap < parse_cap).to_be_true()

    it "takes the per-phase budget default when no env override is set":
        expect(shard_worker_budget_kb("SIMPLE_SHARD_BUDGET_UNSET_XYZ", 1650000)).to_equal(1650000)
