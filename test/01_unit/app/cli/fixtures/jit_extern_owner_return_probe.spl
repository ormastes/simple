# Probe for jit_frontend_extern_owner_return_spec.spl: co-compiles the
# frontend (`rt_tuple_get<T> -> T?`) with enum_wire (`rt_tuple_get -> i64`).
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.common.config.{Logger}
use compiler.frontend.parser_types_expr.{Type, parser_type_kind_named_name}
use std.nogc_sync_mut.sffi.enum_wire.{enum_wire_multi_payload_len}

fn main():
    val parsed = parse_full_frontend("fn f(x: i64) -> i64:\n    x\n", "a.spl", "probe", Logger(level: 0))
    for name in parsed.functions.keys():
        for p in parsed.functions[name].params:
            val t: Type = p.type_
            val nm: text = parser_type_kind_named_name(t.kind)
            if nm == "":
                print "PROBE empty"
            else:
                print "PROBE nm={nm}"
