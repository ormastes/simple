use std.spec.{describe, it, expect}
use app.cli.bootstrap_focused_native_build.{
    focused_native_build_error,
    focused_native_build_sources,
    focused_native_build_target,
    focused_native_build_linker_script,
    focused_native_build_runtime_path,
    focused_native_build_cache_dir,
    focused_native_build_effective_sources,
    focused_native_build_effective_cache_dir,
    focused_native_build_profile_cache_dir_v1,
    focused_native_build_profile_receipt_namespace_v1,
    focused_native_build_receipt_dir_from_env_v1,
    focused_native_build_receipt_path_v1,
    focused_native_build_target_profile_v1,
    focused_native_build_backend,
    focused_native_build_backend_plugin,
    focused_native_build_strip,
    focused_native_build_exact_capsule_entry_allowed,
}

describe "focused bootstrap native-build plan":
    it "accepts six ordered source roots and rejects seven":
        val five = [
            "simple", "native-build",
            "--source", "src/compiler",
            "--source=src/app",
            "--source", "src/lib",
            "--source=src/os",
            "--source", "examples/10_tooling",
            "--entry", "src/app/os/main.spl",
            "--output", "build/focused-simple",
        ]
        val sources = focused_native_build_sources(five)

        expect(sources.len()).to_equal(5)
        expect(sources[0]).to_equal("src/compiler")
        expect(sources[4]).to_equal("examples/10_tooling")
        expect(focused_native_build_error(five)).to_equal("")
        expect(focused_native_build_effective_sources(five, false).len()).to_equal(5)
        expect(focused_native_build_effective_sources(five, true).len()).to_equal(0)

        val six = five + ["--source", "examples/09_embedded/simple_os"]
        expect(focused_native_build_error(six)).to_equal("")
        val six_sources = focused_native_build_sources(six)
        expect(six_sources.len()).to_equal(6)
        expect(six_sources[0]).to_equal("src/compiler")
        expect(six_sources[5]).to_equal("examples/09_embedded/simple_os")
        val seven = six + ["--source=seventh-root"]
        expect(focused_native_build_error(seven)).to_contain("at most six --source roots")

    it "preserves explicit target and linker-script ownership":
        val args = [
            "simple", "native-build",
            "--entry", "src/os/kernel/arch/aarch64/boot.spl",
            "-o", "build/os/kernel.elf",
            "--target=aarch64-unknown-none",
            "--linker-script", "src/os/kernel/arch/aarch64/linker.ld",
            "--runtime-path", "src/compiler_rust/target/bootstrap",
            "--cache-dir", "build/focused-cache",
        ]

        expect(focused_native_build_target(args)).to_equal("aarch64-unknown-none")
        expect(focused_native_build_linker_script(args)).to_equal("src/os/kernel/arch/aarch64/linker.ld")
        expect(focused_native_build_runtime_path(args)).to_equal("src/compiler_rust/target/bootstrap")
        expect(focused_native_build_cache_dir(args)).to_equal("build/focused-cache")
        expect(focused_native_build_effective_cache_dir(args, "build/previous-cache")).to_equal("build/focused-cache")
        expect(focused_native_build_effective_cache_dir([], "build/previous-cache")).to_equal("build/previous-cache")

    it "rejects unsupported build modes before compiler entry":
        val args = [
            "simple", "native-build",
            "--mode", "definitely-invalid-mode",
            "--entry", "src/app/os/main.spl",
            "--output", "build/focused-simple",
        ]

        expect(focused_native_build_error(args)).to_equal(
            "Error: invalid --mode 'definitely-invalid-mode' (expected dynload or one-binary)"
        )

    it "preserves llvm as the implicit bootstrap backend":
        expect(focused_native_build_backend([])).to_equal("llvm")
        expect(focused_native_build_backend(["--backend", "cranelift"])).to_equal("cranelift")

    it "restricts source dropping and forced strip to authorized exact capsules":
        expect(focused_native_build_exact_capsule_entry_allowed("src/app/cli/main.spl")).to_equal(true)
        expect(focused_native_build_exact_capsule_entry_allowed("src/app/os/main.spl")).to_equal(true)
        expect(focused_native_build_exact_capsule_entry_allowed("src/os/kernel/main.spl")).to_equal(false)
        expect(focused_native_build_strip([], true)).to_equal(true)
        expect(focused_native_build_strip([], false)).to_equal(false)
        expect(focused_native_build_strip(["--strip"], false)).to_equal(true)

    it "decouples phase4 dev and prod profiles while keeping phase3 dev-only":
        val p4_default = focused_native_build_target_profile_v1(["--managed-build-phase=phase4"], false).unwrap()
        expect(p4_default.release).to_equal(true)
        expect(p4_default.profile).to_equal("prod")
        expect(p4_default.managed_build_phase).to_equal("phase4")

        val p4_prod = focused_native_build_target_profile_v1(["--managed-build-phase=phase4", "--profile=prod", "--release"]).unwrap()
        expect(p4_prod.release).to_equal(true)
        expect(p4_prod.profile).to_equal("prod")
        expect(p4_prod.managed_build_phase).to_equal("phase4")

        val p4_dev = focused_native_build_target_profile_v1(["--managed-build-phase=phase4", "--profile=dev"]).unwrap()
        expect(p4_dev.release).to_equal(false)
        expect(p4_dev.profile).to_equal("dev")
        expect(p4_dev.managed_build_phase).to_equal("phase4")

        val p3_dev = focused_native_build_target_profile_v1(["--managed-build-phase=phase3"]).unwrap()
        expect(p3_dev.release).to_equal(false)
        expect(p3_dev.profile).to_equal("dev")
        expect(p3_dev.managed_build_phase).to_equal("phase3")

        val p3_prod = focused_native_build_target_profile_v1(["--managed-build-phase=phase3", "--profile=prod"])
        expect(p3_prod.is_err()).to_equal(true)
        expect(p3_prod.unwrap_err()).to_start_with("TARGET-PROFILE-E-CONFLICT")

        val p3_release = focused_native_build_target_profile_v1(["--managed-build-phase=phase3", "--release"])
        expect(p3_release.is_err()).to_equal(true)
        expect(p3_release.unwrap_err()).to_start_with("TARGET-PROFILE-E-CONFLICT")

        val p4_dev_release = focused_native_build_target_profile_v1(["--managed-build-phase=phase4", "--profile=dev", "--release"])
        expect(p4_dev_release.is_err()).to_equal(true)
        expect(p4_dev_release.unwrap_err()).to_start_with("TARGET-PROFILE-E-CONFLICT")

    it "isolates phase4 dev and phase4 prod cache and receipt namespaces":
        val p4_prod = focused_native_build_target_profile_v1(["--managed-build-phase=phase4", "--profile=prod"]).unwrap()
        val p4_dev = focused_native_build_target_profile_v1(["--managed-build-phase=phase4", "--profile=dev"]).unwrap()
        val p3_dev = focused_native_build_target_profile_v1(["--managed-build-phase=phase3"]).unwrap()

        val prod_cache = focused_native_build_profile_cache_dir_v1([], "", p4_prod)
        val dev_cache = focused_native_build_profile_cache_dir_v1([], "", p4_dev)
        val p3_cache = focused_native_build_profile_cache_dir_v1([], "", p3_dev)
        expect(prod_cache).to_equal("build/native_cache/phase4-prod")
        expect(dev_cache).to_equal("build/native_cache/phase4-dev")
        expect(p3_cache).to_equal("build/native_cache/phase3-dev")
        expect(prod_cache == dev_cache).to_equal(false)

        val inherited_prod = focused_native_build_profile_cache_dir_v1([], "build/shared-cache", p4_prod)
        val inherited_dev = focused_native_build_profile_cache_dir_v1([], "build/shared-cache", p4_dev)
        expect(inherited_prod).to_equal("build/shared-cache/phase4-prod")
        expect(inherited_dev).to_equal("build/shared-cache/phase4-dev")
        expect(inherited_prod == inherited_dev).to_equal(false)

        val prod_receipt = focused_native_build_profile_receipt_namespace_v1(p4_prod)
        val dev_receipt = focused_native_build_profile_receipt_namespace_v1(p4_dev)
        expect(prod_receipt).to_equal("build/native_receipts/phase4-prod")
        expect(dev_receipt).to_equal("build/native_receipts/phase4-dev")
        expect(prod_receipt == dev_receipt).to_equal(false)

        val shared_prod_receipt = focused_native_build_profile_receipt_namespace_v1(p4_prod, "build/shared-cache")
        val shared_dev_receipt = focused_native_build_profile_receipt_namespace_v1(p4_dev, "build/shared-cache")
        expect(shared_prod_receipt).to_equal("build/shared-cache/receipts/phase4-prod")
        expect(shared_dev_receipt).to_equal("build/shared-cache/receipts/phase4-dev")
        expect(shared_prod_receipt == shared_dev_receipt).to_equal(false)

        expect(focused_native_build_receipt_dir_from_env_v1(
            "build/custom-receipts/phase4-dev", p4_prod, "build/shared-cache")).to_equal(
            "build/custom-receipts/phase4-dev")
        expect(focused_native_build_receipt_dir_from_env_v1(
            "", p4_dev, "build/shared-cache")).to_equal(
            "build/shared-cache/receipts/phase4-dev")
        expect(focused_native_build_receipt_path_v1(
            "build/out/simple", "build/custom-receipts/phase4-dev", p4_dev)).to_equal(
            "build/custom-receipts/phase4-dev/simple.focused-receipt.sdn")
        expect(focused_native_build_receipt_path_v1(
            "build/out/simple", "", p4_prod)).to_equal(
            "build/native_receipts/phase4-prod/simple.focused-receipt.sdn")

    it "validates --backend-plugin options fail-closed and extracts provider paths":
        """Accept split and inline --backend-plugin flags on focused native-build while rejecting missing or whitespace-only values."""
        val split_args = [
            "simple", "native-build",
            "--entry", "src/app/cli/main.spl",
            "--backend", "c",
            "--backend-plugin", "build/plugins/backend_c.dll",
            "--output", "build/focused-simple"
        ]
        val inline_args = [
            "simple", "native-build",
            "--entry", "src/app/cli/main.spl",
            "--backend=c",
            "--backend-plugin=build/plugins/backend_c.so",
            "--output", "build/focused-simple"
        ]
        expect(focused_native_build_error(split_args)).to_equal("")
        expect(focused_native_build_backend_plugin(split_args)).to_equal("build/plugins/backend_c.dll")
        expect(focused_native_build_error(inline_args)).to_equal("")
        expect(focused_native_build_backend_plugin(inline_args)).to_equal("build/plugins/backend_c.so")

        expect(focused_native_build_error([
            "simple", "native-build", "--entry", "a.spl", "--output", "b", "--backend-plugin"
        ])).to_contain("--backend-plugin requires a non-empty path")
        expect(focused_native_build_error([
            "simple", "native-build", "--entry", "a.spl", "--output", "b", "--backend-plugin", "--strip"
        ])).to_contain("--backend-plugin requires a non-empty path")
        expect(focused_native_build_error([
            "simple", "native-build", "--entry", "a.spl", "--output", "b", "--backend-plugin="
        ])).to_contain("--backend-plugin requires a non-empty path")
        expect(focused_native_build_error([
            "simple", "native-build", "--entry", "a.spl", "--output", "b", "--backend-plugin=   "
        ])).to_contain("--backend-plugin requires a non-empty path")
