use std.spec
use app.cli.native_build_mir_selective_admission.{
    native_mir_selective_admission_v1, native_mir_selective_disk_bytes_v1,
    native_mir_selective_requested_workers_v1}

describe "selective MIR phase admission":
    it "uses the explicit jobs override and refuses missing or invalid counts":
        expect(native_mir_selective_requested_workers_v1(["--jobs", "15"], "2")).to_equal(15)
        expect(native_mir_selective_requested_workers_v1(["--threads=2"], "15")).to_equal(2)
        expect(native_mir_selective_requested_workers_v1(["-j"], "15")).to_equal(0)
        expect(native_mir_selective_requested_workers_v1(["--jobs=invalid"], "15")).to_equal(0)
        expect(native_mir_selective_requested_workers_v1([], "")).to_equal(1)

    it "admits fifteen workers only when parent and every worker fit":
        val admitted = native_mir_selective_admission_v1(20, 64, 64, 200,
            4, 4, 60, 100, 20, 120)
        expect(admitted.workers).to_equal(15)

    it "keeps the narrower request and enclosing tree cap":
        expect(native_mir_selective_admission_v1(2, 64, 64, 200,
            4, 4, 60, 100, 20, 120).workers).to_equal(2)
        expect(native_mir_selective_admission_v1(15, 100, 20, 200,
            4, 4, 16, 100, 20, 120).workers).to_equal(4)

    it "does not revive an admission with no worker slot":
        val refused = native_mir_selective_admission_v1(15, 20, 20, 200,
            17, 4, 3, 100, 20, 120)
        expect(refused.workers).to_equal(0)
        expect(refused.reason).to_contain("no MIR worker")

    it "checks the exporter separately before starting the pool":
        val refused = native_mir_selective_admission_v1(15, 20, 20, 200,
            4, 4, 17, 100, 20, 120)
        expect(refused.workers).to_equal(0)
        expect(refused.reason).to_contain("exporter")

    it "refuses unknown memory and a missing enforced process-tree cap":
        expect(native_mir_selective_admission_v1(15, 20, 0, 200,
            4, 4, 16, 100, 20, 120).workers).to_equal(0)
        expect(native_mir_selective_admission_v1(15, 20, 20, 0,
            4, 4, 16, 100, 20, 120).workers).to_equal(0)

    it "keeps disk reserve and arithmetic valid at maximal budgets":
        expect(native_mir_selective_admission_v1(15, 20, 20, 200,
            4, 4, 16, 101, 20, 120).workers).to_equal(0)
        expect(native_mir_selective_admission_v1(15, 9223372036854775807,
            9223372036854775807, 9223372036854775807, 1, 1, 1,
            9223372036854775807, 1, 9223372036854775807).workers).to_equal(0)

    it "refuses invalid df values and interprets KiB exactly":
        expect(native_mir_selective_disk_bytes_v1("Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/test 200 50 150 25% /tmp\n")).to_equal(153600)
        expect(native_mir_selective_disk_bytes_v1("unavailable")).to_equal(0)
        expect(native_mir_selective_disk_bytes_v1("header\n/dev/test 200 50 -1 25% /tmp\n")).to_equal(0)
