# @req REQ-SSPEC-CLI
"""
# spl-coverage dispatch row (coverage_tooling_does_not_instrument_spl_2026-08-07)

The self-hosted command table must resolve `spl-coverage`, which was wired only
in the Rust seed driver.
"""

# @tag: unit, cli, dispatch

use std.spec
use app.cli.dispatch.table.{get_command_table, get_all_commands}

describe "dispatch table spl-coverage row":
    it "lists spl-coverage":
        expect(get_all_commands().contains("spl-coverage")).to_equal(true)

    it "routes spl-coverage to the spl_coverage app":
        var path = ""
        for e in get_command_table():
            if e.name == "spl-coverage":
                path = e.app_path
        expect(path).to_equal("src/app/spl_coverage/main.spl")
