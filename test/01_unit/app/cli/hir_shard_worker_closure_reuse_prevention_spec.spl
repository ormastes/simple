"""Source contract spec guarding coordinator prepublish and worker closure enforcement (#4450)."""

use std.spec
use std.io_runtime.{file_read}

describe "CompFix-9a worker and shard closure reuse contract":
    it "ensures coordinator prepublishes closure before focused shards and worker entry enforces it":
        val main_src = file_read("src/app/cli/native_build_main.spl")
        val worker_src = file_read("src/app/cli/native_build_worker_entry.spl")
        expect(main_src).to_contain("native_build_closure_ensure_published_for_shards_v1")
        expect(main_src).to_contain("native_build_shard_worker_closure_reused_v1")
        expect(main_src.contains("# TODO #437")).to_equal(false)
        expect(worker_src).to_contain("SIMPLE_PARSE_CLOSURE_CONSUMER")
        expect(worker_src).to_contain("SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST")
        expect(worker_src).to_contain("worker:closure:reused")
