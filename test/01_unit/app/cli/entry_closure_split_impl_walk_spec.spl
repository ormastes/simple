use std.spec.*
use app.io._CliCompile.native_build_closure.{_native_build_entry_closure}

# Bug: stage2_split_impl_modules_missing_from_entry_closure_2026-08-22.
# Walker-level check. Slow: loads the full native-build driver, so the
# interpreter needs a runtime that has the tip's externs (a stale bin/simple.exe
# times out here). Edge-presence checks live in entry_closure_split_impl_spec.spl.

fn _closure_has(paths: [text], suffix: text) -> bool:
    for p in paths:
        if p.replace("\\", "/").ends_with(suffix):
            return true
    false

describe "entry closure walker retains split impl providers":
    it "includes the impl provider when the type owner imports it":
        val fx = "test/fixtures/entry_closure_split_impl"
        val paths = _native_build_entry_closure(fx + "/entry_with_edge.spl", ["test/fixtures"])
        expect(_closure_has(paths, "/type_owner.spl")).to_equal(true)
        expect(_closure_has(paths, "/impl_provider.spl")).to_equal(true)

    it "omits the impl provider when no module imports it (reverted-fix shape)":
        val fx = "test/fixtures/entry_closure_split_impl"
        val paths = _native_build_entry_closure(fx + "/entry_without_edge.spl", ["test/fixtures"])
        expect(_closure_has(paths, "/type_owner_no_edge.spl")).to_equal(true)
        expect(_closure_has(paths, "/impl_provider.spl")).to_equal(false)
