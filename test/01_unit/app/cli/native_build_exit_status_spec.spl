use std.spec.{describe, it, expect}
use app.cli.native_build_exit_status.{native_build_windows_status_label, native_build_posix_signal, native_build_signal_name, native_build_exit_cause_field_v1}

describe "native worker status diagnostics":
    it "recognizes the observed Windows access violation without a POSIX signal":
        expect(native_build_windows_status_label(-1073741819)).to_equal("0xC0000005 (access violation)")
        expect(native_build_posix_signal(-1073741819)).to_equal(0)

    it "retains distinct Windows failure causes":
        expect(native_build_windows_status_label(-1073741795)).to_contain("illegal instruction")
        expect(native_build_windows_status_label(-1073741676)).to_contain("divide by zero")
        expect(native_build_windows_status_label(-1073741571)).to_contain("stack overflow")
        expect(native_build_windows_status_label(-1073740940)).to_contain("heap corruption")
        expect(native_build_windows_status_label(-1073740791)).to_contain("fail-fast")
        expect(native_build_windows_status_label(-1073741510)).to_contain("control-C exit")

    it "preserves encoded POSIX crash and termination signals":
        expect(native_build_posix_signal(-139)).to_equal(11)
        expect(native_build_posix_signal(-134)).to_equal(6)
        expect(native_build_posix_signal(-137)).to_equal(9)
        expect(native_build_posix_signal(-143)).to_equal(15)
        expect(native_build_windows_status_label(-139)).to_equal("")

    it "does not invent signals for sentinels or unknown native statuses":
        for code in [0, 1, 139, -1, -2, -128, -256, -1073741800]:
            expect(native_build_posix_signal(code)).to_equal(0)
            expect(native_build_windows_status_label(code)).to_equal("")

    it "keeps the portable encoded signal boundaries":
        expect(native_build_posix_signal(-129)).to_equal(1)
        expect(native_build_posix_signal(-255)).to_equal(127)

    # Phase 3 census: `[mir-shard] owner=1/2@0 status=CRASH exit=-134` was the
    # only crash evidence; -134 had to be decoded by hand.
    it "names the portable POSIX signals":
        expect(native_build_signal_name(6)).to_equal("SIGABRT")
        expect(native_build_signal_name(11)).to_equal("SIGSEGV")
        expect(native_build_signal_name(9)).to_equal("SIGKILL")
        expect(native_build_signal_name(4)).to_equal("SIGILL")
        expect(native_build_signal_name(8)).to_equal("SIGFPE")
        expect(native_build_signal_name(15)).to_equal("SIGTERM")
        # 7 and 10 differ between Linux and the BSDs: number only.
        expect(native_build_signal_name(7)).to_equal("signal 7")
        expect(native_build_signal_name(10)).to_equal("signal 10")

    it "adds a crash-cause field to a worker exit row, and nothing for an ordinary exit":
        expect(native_build_exit_cause_field_v1(-134)).to_equal(" signal=SIGABRT(6)")
        expect(native_build_exit_cause_field_v1(-139)).to_equal(" signal=SIGSEGV(11)")
        expect(native_build_exit_cause_field_v1(-1073741819)).to_equal(" ntstatus=0xC0000005 (access violation)")
        for code in [0, 1, 2, -1, -2]:
            expect(native_build_exit_cause_field_v1(code)).to_equal("")
