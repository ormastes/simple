# @cover src/app/cli/native_build_main.spl
# Purpose: --cache-dir frontend/HIR-ledger root follows SIMPLE_CACHE_SCOPE
# (stage4 lane wrote SIMPLE_CACHE_SCOPE=s4mir caches under <cache>/default/).
use std.spec
use app.cli.native_build_main.{native_build_frontend_cache_dir_for_v1, native_build_path_parent_v1}

describe "native-build --cache-dir scope propagation":
    it "places the frontend root under the configured lane":
        expect(native_build_frontend_cache_dir_for_v1(["--cache-dir", "C:/c"], "s4mir")).to_equal("C:/c/s4mir/frontend")
        expect(native_build_frontend_cache_dir_for_v1(["--cache-dir=C:/c"], "s4mir")).to_equal("C:/c/s4mir/frontend")

    it "keeps the default lane when no scope is configured":
        expect(native_build_frontend_cache_dir_for_v1(["--cache-dir", "C:/c"], "")).to_equal("C:/c/default/frontend")

    it "returns empty without --cache-dir":
        expect(native_build_frontend_cache_dir_for_v1(["--entry", "x.spl"], "s4mir")).to_equal("")

describe "ledger peak record location":
    it "is the queue directory's parent":
        expect(native_build_path_parent_v1("C:/c/s4mir/frontend/queue-1-0")).to_equal("C:/c/s4mir/frontend")
        expect(native_build_path_parent_v1("queue-1-0")).to_equal(".")
