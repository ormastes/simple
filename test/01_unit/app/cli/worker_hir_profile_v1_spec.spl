# NOT_RUN: policy regressions; these do not qualify a native launch provider.
use std.spec.{describe, it, expect}
use app.cli.worker_hir_profile_v1.{worker_hir_argument_error_v1, worker_hir_stage3_capsule_environment_keys_v1,
    worker_hir_tool_build_environment_keys_v1, worker_hir_base_environment_keys_v1, worker_hir_environment_value_error_v1,
    worker_hir_unsupported_environment_keys_v1,
    worker_hir_environment_key_admitted_v1, worker_hir_child_validate_v1}
use app.cli.worker_hir_owner_v1.{worker_hir_cleanup_deadline_v1,
    worker_hir_remaining_budget_v1, worker_hir_environment_sort_v1}
use std.common.process.observation_v4.{ProcessObservationEnvironmentV4}

describe "worker HIR profile admission":
    it "admits explicit HIR consumer arguments":
        expect(worker_hir_argument_error_v1(["--entry-closure", "--entry", "src/main.spl",
            "--source", "src", "--output", "build/result", "--backend=llvm"])).to_equal("")

    it "admits the canonical positional entry form used by phase C tool builds":
        # bootstrap-fable-10 (2026-11-12): `native-build <entry>.spl --backend=cranelift
        # --low-memory --cache-dir D --timeout 7200 --threads 2 -o OUT` was refused as
        # `unsupported HIR worker option: <entry>` and every matrix tool build failed.
        expect(worker_hir_argument_error_v1(["src/app/cli/_CliMain/main_and_help.spl",
            "--backend=cranelift", "--low-memory", "--cache-dir", "/tmp/c", "--timeout", "7200",
            "--threads", "2", "-o", "/tmp/out"])).to_equal("")
        expect(worker_hir_argument_error_v1(["a.spl", "b.spl"])).to_contain("unsupported")

    it "admits the native-build output modes Stage 4 direct builds pass":
        # build-phase4-direct-product.shs passes `--mode dynload` with
        # `--threads N`; once shard threads >= 2 the profile refused it as
        # `unsupported HIR worker option: --mode` (early Phase 3 lane, 2026-11-12).
        for mode in ["dynload", "one-binary"]:
            expect(worker_hir_argument_error_v1(["--entry-closure", "--entry", "src/main.spl",
                "--mode", mode, "--threads", "2"])).to_equal("")
            expect(worker_hir_argument_error_v1(["--entry-closure", "--mode=" + mode])).to_equal("")

    it "rejects every other native-build mode spelling":
        for args in [["--entry-closure", "--mode", "jit"], ["--entry-closure", "--mode=jit"],
                ["--entry-closure", "--mode"], ["--entry-closure", "--mode="],
                ["--entry-closure", "--mode", "--threads"], ["--entry-closure", "--build-mode", "dynload"]]:
            expect(worker_hir_argument_error_v1(args) == "").to_equal(false)

    it "rejects directory fallback without a frozen closure":
        expect(worker_hir_argument_error_v1(["--entry", "src/main.spl"])).to_contain("frozen")

    it "rejects mixed MIR parse and file-unit routes":
        for mode in ["--mir-shard=0/1", "--parse-shard=0/1", "--file-worker-unit", "--mode=jit"]:
            expect(worker_hir_argument_error_v1(["--entry-closure", mode]) == "").to_equal(false)

    it "rejects plugin and unrecognized future options":
        for mode in ["--plugin=anything", "--frontend-offload=worker", "--future-route"]:
            expect(worker_hir_argument_error_v1(["--entry-closure", mode]) == "").to_equal(false)

    it "does not admit incomplete value options":
        expect(worker_hir_argument_error_v1(["--entry-closure", "--source"])).to_contain("missing")
        expect(worker_hir_argument_error_v1(["--entry-closure", "--source="])).to_contain("empty")

    it "admits canonical source authority and rejects loader injection":
        expect(worker_hir_environment_key_admitted_v1("SIMPLE_SCV_INVENTORY_DIGEST")).to_equal(true)
        for name in ["DYLD_INSERT_LIBRARIES", "LD_PRELOAD", "LD_LIBRARY_PATH",
                "SIMPLE_NATIVE_GROUP_MANIFEST", "SIMPLE_FILE_WORKER_UNIT", "SIMPLE_PLUGIN", "FUTURE_ROUTE"]:
            expect(worker_hir_environment_key_admitted_v1(name)).to_equal(false)

    it "admits the exact Stage 3 capsule launch environment":
        # Pinned from bootstrap-from-scratch.sh's Stage 3 block, the
        # transcribed runner and process-tree-rss-watchdog.pl (2026-11-12).
        val stage3 = ["RUST_LOG", "LIBRARY_PATH", "LLVM_DISABLE_ABI_BREAKING_CHECKS_ENFORCING",
            "MALLOC_ARENA_MAX", "MALLOC_TRIM_THRESHOLD_", "MSYS2_ENV_CONV_EXCL",
            "SIMPLE_BOOTSTRAP", "SIMPLE_BOOTSTRAP_STAGE3", "SIMPLE_BOOTSTRAP_WHOLE_PROGRAM",
            "SIMPLE_BOOTSTRAP_LINK_COMPAT_SHA256", "SIMPLE_BOOTSTRAP_COMPILER_RSS_CEILING_KIB",
            "SIMPLE_BOOTSTRAP_RSS_CAP_MODE", "SIMPLE_BOOTSTRAP_SESSION_ID", "SIMPLE_BOOTSTRAP_SESSION_EXEC",
            "SIMPLE_BOOTSTRAP_PROCESS_OBSERVER", "SIMPLE_BOOTSTRAP_PROCESS_OBSERVER_SHA256",
            "SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB", "SIMPLE_FILE_WORKERS",
            "SIMPLE_ABI_POLICY", "SIMPLE_ABI_ADMISSION_RECEIPT", "SIMPLE_PLUGIN_MANIFEST_POLICY",
            "SIMPLE_KERNEL_K1_POLICY", "SIMPLE_COVERAGE_CUTOVER_STATE", "SIMPLE_K1_COMPOSITION_SHA256_BEFORE",
            "SIMPLE_NO_DEPRECATED_WARNINGS", "SIMPLE_STAGE3_STREAMING_SURFACES",
            "SIMPLE_NATIVE_STAGED_CODEGEN_BATCH", "SIMPLE_NATIVE_GO_TO_END", "SIMPLE_KEEP_SOURCE_CONTENTS",
            "SIMPLE_MIR_TAG_PROBE", "SIMPLE_FRONTEND_CACHE", "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_READ",
            "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT", "SIMPLE_PACKAGE_INDEX_COLD_INIT",
            "SIMPLE_SAFETY_PROFILE", "SIMPLE_ASSURANCE_WARNING_PHASE", "SIMPLE_COMPILER_PHASE_PROFILE",
            "SIMPLE_EVIDENCE_RUN_ID", "SIMPLE_NATIVE_BUILD_TARGET", "SIMPLE_NATIVE_BUILD_THREADS",
            "SIMPLE_RUNTIME_PATH", "SIMPLE_NATIVE_RUNTIME_BUNDLE",
            "SIMPLE_WINDOWS_ABI", "CC", "INCLUDE", "LIB", "LIBPATH", "OS"]
        expect(worker_hir_stage3_capsule_environment_keys_v1()).to_equal(stage3)
        for name in stage3:
            expect(worker_hir_environment_key_admitted_v1(name)).to_equal(true)

    it "admits the exact Phase 4 direct and phase C tool-build environment":
        val tools = ["SIMPLE_FILE_WORKERS", "SIMPLE_MIR_SHARD_COUNT", "SIMPLE_PARSE_SHARD_WORKER_KB",
            "SIMPLE_PARSE_SHARD_MAX", "SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB",
            "SIMPLE_NATIVE_BUILD_RUST", "SIMPLE_BOOTSTRAP_STAGE3", "SIMPLE_BOOTSTRAP_STAGE4",
            "SIMPLE_NATIVE_BUILD_TARGET", "SIMPLE_NATIVE_BUILD_THREADS", "SIMPLE_NATIVE_RUNTIME_BUNDLE",
            "SIMPLE_RUNTIME_PATH", "SIMPLE_PROJECT_ROOT", "SIMPLE_CACHE_PROJECT", "SIMPLE_CACHE",
            "XDG_CACHE_HOME", "SIMPLE_PROCESS_TREE_RSS_SCOPE_GROUP", "SIMPLE_PROCESS_TREE_RSS_DECLARED_JOBS",
            "SIMPLE_BOOTSTRAP_PROCESS_TREE_RSS_CAP_KIB", "SIMPLE_BOOTSTRAP_RSS_CAP_MODE",
            "SIMPLE_PROCESS_TREE_RSS_RECEIPT", "SIMPLE_TOOLCHAINS_ROOT", "SIMPLE_HOST_CONFIG",
            "SIMPLE_BOOTSTRAP_SESSION_ID", "SIMPLE_BOOTSTRAP_SESSION_EXEC",
            "SIMPLE_BOOTSTRAP_PROCESS_OBSERVER", "SIMPLE_BOOTSTRAP_PROCESS_OBSERVER_SHA256",
            "SYSTEMROOT", "WINDIR", "COMSPEC", "PATHEXT"]
        expect(worker_hir_tool_build_environment_keys_v1()).to_equal(tools)
        for name in tools:
            expect(worker_hir_environment_key_admitted_v1(name)).to_equal(true)

    it "admits the bootstrap internal routing marker, live only while set":
        # Set to "1" by run_bootstrap_stage3_process_route for every threads>1
        # bootstrap native-build; restored exactly (absent) afterwards.
        expect(worker_hir_environment_key_admitted_v1("SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING")).to_equal(true)

    it "pins the exact base environment allowlist":
        # Membership alone let a widened list pass review (#8610 post-merge review).
        val pinned = [
            "HOME", "USER", "LOGNAME", "SHELL", "PATH", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL",
            "LC_CTYPE", "TZ", "TERM", "CI", "PWD", "OLDPWD", "SHLVL", "_", "SIMPLE_BIN",
            "SIMPLE_BINARY", "SIMPLE_LIB", "SIMPLE_EXECUTION_MODE",
            "SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING", "SIMPLE_NATIVE_BUILD_WORKER",
            "SIMPLE_HIR_WORKER_PROFILE_V1", "SIMPLE_BUILD_PROGRESS_EVENTS",
            "SIMPLE_COMPILE_FAIL_FAST", "SIMPLE_FRONTEND_CACHE_DIR", "SIMPLE_FRONTEND_CACHE_SCOPE",
            "SIMPLE_HIR_CACHE", "SIMPLE_HIR_CACHE_DIR", "SIMPLE_CACHE_SCOPE",
            "SIMPLE_USER_STORAGE_ROOT", "SIMPLE_GLOBAL_DATASET_MAX_BYTES", "SIMPLE_HIR_SHARD_QUEUE",
            "SIMPLE_HIR_SHARD_OWNER", "SIMPLE_HIR_SHARD_CLAIM_LIMIT", "SIMPLE_PARSE_CLOSURE_REQUEST",
            "SIMPLE_PARSE_CLOSURE_REQUEST_DIGEST", "SIMPLE_PARSE_CLOSURE_CONSUMER",
            "SIMPLE_PARSE_CLOSURE_SELECTED_COUNT", "SIMPLE_SCV_COMMIT_ID",
            "SIMPLE_SCV_INVENTORY_DIGEST", "SIMPLE_SCV_INVENTORY_GENERATION",
            "SIMPLE_SCV_REVISION_ID", "SIMPLE_SCV_SNAPSHOT_ROOT", "SIMPLE_SCV_SOURCE_DRIFTED",
            "SIMPLE_SCV_SOURCE_INVENTORY_DIGEST", "SIMPLE_SCV_TREE_ID",
            "SIMPLE_COMPILER_PHASE_PROFILE_FILE", "SIMPLE_MEM_SNAPSHOT_FILE",
            "SIMPLE_NATIVE_BUILD_CACHE_DIR", "SIMPLE_RT_OBJ_CACHE_DIR", "SIMPLE_NO_STUB_FALLBACK",
            "SIMPLE_NATIVE_ARENA_DECLS", "SIMPLE_HIR_SHARDING", "SIMPLE_PARSE_SHARDING",
            "SIMPLE_SHARD_SMALL_CLOSURE_MAX", "SIMPLE_HIR_SHARD_WORKER_KB",
            "SIMPLE_MANAGED_NATIVE_TOOLS", "SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_PATH",
            "SIMPLE_MANAGED_NATIVE_TOOL_AUTHORITY_SHA256",
            "SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_PATH",
            "SIMPLE_MANAGED_PHASE4_SOURCE_AUTHORITY_SHA256", "SIMPLE_MANAGED_PHASE4_SOURCE_ROOT",
            "SIMPLE_MANAGED_RUNTIME_AUTHORITY_PATH", "SIMPLE_MANAGED_RUNTIME_SNAPSHOT_PATH",
            "SIMPLE_MANAGED_RUNTIME_SNAPSHOT_SHA256"
        ]
        expect(worker_hir_base_environment_keys_v1()).to_equal(pinned)

    it "refuses route-selecting keys with any other value":
        expect(worker_hir_environment_value_error_v1("SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING", "1")).to_equal("")
        for bad in ["", "0", "true", "2"]:
            expect(worker_hir_environment_value_error_v1("SIMPLE_BOOTSTRAP_INTERNAL_NATIVE_BUILD_ROUTING", bad) == "").to_equal(false)
        expect(worker_hir_environment_value_error_v1("SIMPLE_FILE_WORKERS", "0")).to_equal("")
        for bad in ["", "1", "auto"]:
            expect(worker_hir_environment_value_error_v1("SIMPLE_FILE_WORKERS", bad) == "").to_equal(false)
        expect(worker_hir_environment_value_error_v1("SIMPLE_EXECUTION_MODE", "")).to_equal("")
        expect(worker_hir_environment_value_error_v1("SIMPLE_EXECUTION_MODE", "native")).to_equal("")
        expect(worker_hir_environment_value_error_v1("SIMPLE_EXECUTION_MODE", "interpret") == "").to_equal(false)
        expect(worker_hir_environment_value_error_v1("HOME", "")).to_equal("")

    it "names every unsupported key in one refusal":
        val captured = [("HOME", "/h"), ("SIMPLE_NATIVE_BUILD_ENTRY", "x.spl"), ("PATH", "/bin"),
            ("LS_COLORS", ""), ("SIMPLE_NATIVE_BUILD_ENTRY", "y.spl")]
        val keys = worker_hir_unsupported_environment_keys_v1(captured)
        expect(keys.len()).to_equal(2)
        expect(keys[0]).to_equal("SIMPLE_NATIVE_BUILD_ENTRY")
        expect(keys[1]).to_equal("LS_COLORS")
        expect(worker_hir_unsupported_environment_keys_v1([("HOME", "/h")]).len()).to_equal(0)

    it "still rejects ambient and loader-injection keys":
        for name in ["SSH_CLIENT", "LS_COLORS", "GH_TOKEN", "CLAUDECODE", "LD_PRELOAD",
                "LD_LIBRARY_PATH", "DYLD_INSERT_LIBRARIES", "SIMPLE_FILE_WORKER_UNIT", "SIMPLE_PLUGIN"]:
            expect(worker_hir_environment_key_admitted_v1(name)).to_equal(false)

    it "rejects invalid shard ordinals before source admission":
        for shard in ["--hir-shard=-1/1", "--hir-shard=1/1", "--hir-shard=0/129", "--hir-shard=bad"]:
            expect(worker_hir_child_validate_v1(["--entry", "src/main.spl", shard]).is_err()).to_equal(true)

    it "rejects duplicate shard selectors before source admission":
        expect(worker_hir_child_validate_v1(["--entry", "src/main.spl",
            "--hir-shard=0/1", "--hir-shard=0/1"]).is_err()).to_equal(true)

    it "does not renew retirement budget after refused acknowledgements":
        val first = worker_hir_cleanup_deadline_v1(0, 100)
        expect(first).to_equal(5100)
        expect(worker_hir_cleanup_deadline_v1(first, 4000)).to_equal(first)
        expect(worker_hir_cleanup_deadline_v1(first, 6000)).to_equal(first)

    it "rejects unavailable or overflowing clock observations":
        expect(worker_hir_cleanup_deadline_v1(0, 0)).to_equal(-1)
        expect(worker_hir_cleanup_deadline_v1(0, -1)).to_equal(-1)
        expect(worker_hir_cleanup_deadline_v1(0, 9223372036854775807)).to_equal(-1)
        expect(worker_hir_remaining_budget_v1(100, 0)).to_equal(-1)
        expect(worker_hir_remaining_budget_v1(100, 100)).to_equal(-1)
        expect(worker_hir_remaining_budget_v1(200, 100)).to_equal(100)

    it "canonicalizes the exact copied environment before V4 encoding":
        val captured = [ProcessObservationEnvironmentV4(key: "SIMPLE_HIR_SHARD_OWNER", value: "0/1@0"),
            ProcessObservationEnvironmentV4(key: "HOME", value: "/fixture"),
            ProcessObservationEnvironmentV4(key: "PATH", value: "/bin")]
        val ordered = worker_hir_environment_sort_v1(captured)
        expect(ordered[0].key).to_equal("HOME")
        expect(ordered[1].key).to_equal("PATH")
        expect(ordered[2].key).to_equal("SIMPLE_HIR_SHARD_OWNER")
        expect(ordered[2].value).to_equal("0/1@0")
        expect(captured[0].key).to_equal("SIMPLE_HIR_SHARD_OWNER")
