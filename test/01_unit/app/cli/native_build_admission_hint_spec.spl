use std.spec.*
use app.io.file_ops.{path_absolute}
use std.scv.compile_source_inventory.{compile_source_inventory_plain_checkout_v1}
use app.cli.native_build_main.{native_build_admission_hint_v1}

fn real_root() -> text:
    compile_source_inventory_plain_checkout_v1(path_absolute("."))

describe "native-build admission refusal hints":
    it "names the git work tree requirement and the fix":
        val hint = native_build_admission_hint_v1(["--entry", "test/a_spec.spl"], "/r", false)
        expect(hint.contains("root /r is not a git work tree")).to_equal(true)
        expect(hint.contains("run from inside a git checkout")).to_equal(true)

    it "names the entry location requirement and the fix":
        val hint = native_build_admission_hint_v1(["--entry", "tools/x.spl"], real_root(), true)
        expect(hint.contains("entry tools/x.spl is not under test/")).to_equal(true)
        expect(hint.contains("stage3 admission requires")).to_equal(true)

    it "names the --source separation requirement and the fix":
        val hint = native_build_admission_hint_v1(
            ["--entry", "test/a_spec.spl", "--source", "src/app,src/lib"], real_root(), true)
        expect(hint.contains("--source value 'src/app,src/lib' contains ','")).to_equal(true)
        expect(hint.contains("pass one --source per path")).to_equal(true)
        val spaced = native_build_admission_hint_v1(
            ["--entry=test/a_spec.spl", "--source=src/app src/lib"], real_root(), true)
        expect(spaced.contains("contains ' '")).to_equal(true)

    it "is silent for an admissible request":
        expect(native_build_admission_hint_v1(
            ["--entry", "test/a_spec.spl", "--source", "src/app", "--source", "src/lib"], real_root(), true)).to_equal("")
