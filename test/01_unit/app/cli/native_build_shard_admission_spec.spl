use std.spec
use std.io_runtime.{file_read}
use app.cli.native_build_shard_admission.{native_build_shard_worker_limit,
    native_build_hir_shard_policy_v1}

describe "native-build shard RSS admission":

    it "keeps HIR disabled when parse warming is disabled without explicit opt-in":
        expect(native_build_hir_shard_policy_v1("0", "")).to_equal(0)
        expect(native_build_hir_shard_policy_v1("0", "auto")).to_equal(0)

    it "honors explicit HIR disable independently of parse policy":
        expect(native_build_hir_shard_policy_v1("", "0")).to_equal(0)
        expect(native_build_hir_shard_policy_v1("1", "0")).to_equal(0)
        expect(native_build_hir_shard_policy_v1("0", "0")).to_equal(0)

    it "requires explicit HIR-only source admission for the parser workaround":
        expect(native_build_hir_shard_policy_v1("0", "1")).to_equal(2)

    it "preserves ordinary HIR routing and the requested twenty-worker ceiling":
        expect(native_build_hir_shard_policy_v1("", "")).to_equal(1)
        expect(native_build_hir_shard_policy_v1("1", "1")).to_equal(1)
        expect(native_build_shard_worker_limit(20, 0, 2560, 0)).to_equal(20)
        expect(native_build_shard_worker_limit(20, 102400, 2560, 0)).to_equal(20)

    it "defaults a 5 GiB budget to two measured 2.5 GiB workers":
        expect(native_build_shard_worker_limit(8, 5120, 2560, 0)).to_equal(2)

    it "admits one worker when the budget is smaller than one estimate":
        expect(native_build_shard_worker_limit(8, 1024, 2560, 0)).to_equal(1)

    it "preserves explicitly budgeted parallelism without exceeding request":
        expect(native_build_shard_worker_limit(8, 20480, 2560, 0)).to_equal(8)
        expect(native_build_shard_worker_limit(4, 20480, 2560, 0)).to_equal(4)

    it "supports an explicit uncapped budget and independent hard maximum":
        expect(native_build_shard_worker_limit(8, 0, 2560, 0)).to_equal(8)
        expect(native_build_shard_worker_limit(8, 0, 2560, 3)).to_equal(3)

    it "falls back safely for a malformed non-positive estimate":
        expect(native_build_shard_worker_limit(8, 5120, 0, 0)).to_equal(2)

    it "does not turn a negative budget into accidental unlimited admission":
        expect(native_build_shard_worker_limit(8, -1, 2560, 0)).to_equal(2)

    it "clamps both deterministic shard phases through one memory budget":
        val src = file_read("src/app/cli/native_build_main.spl")
        expect(src).to_contain("val shard_count = native_build_parse_shard_count(args)")
        expect(src).to_contain("val hir_shard_count = native_build_hir_shard_count(args)")
        expect(src).to_contain("native_build_shard_threads(args, shard_worker_budget_kb(\"SIMPLE_PARSE_SHARD_WORKER_KB\", 1650000))")
        expect(src).to_contain("native_build_shard_threads(args, shard_worker_budget_kb(\"SIMPLE_HIR_SHARD_WORKER_KB\", 3000000))")
        expect(src).to_contain("shard_threads_mem_cap(threads, budget_kb)")
