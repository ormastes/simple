use std.io_runtime.file_read
use std.spec.step
use app.cli.check_tier.{TierKeywords, build_tier_keyword_index,
    tier_keyword_required_level, tier_word_parts}

describe "check-tier owner-local accumulation":
    it "does not rebuild growing arrays while scanning project input":
        step("Verify: repository-sized tier groups use owner-local push")
        val source = file_read("src/app/cli/check_tier.spl")
        expect(source).to_contain("seed.push(key)")
        expect(source).to_contain("core.push(key)")
        expect(source).to_contain("full.push(key)")
        expect(source).to_contain("violations.push(op)")
        expect(source).to_contain("result.push(ModuleTier(")
        expect(source).to_contain("seed_files.push(trimmed)")
        expect(source).to_contain("core_files.push(trimmed)")
        expect(source).to_contain("full_file_count = full_file_count + 1")
        expect(source).not.to_contain("seed_files = seed_files + [trimmed]")
        expect(source).not.to_contain("core_files = core_files + [trimmed]")
        expect(source).not.to_contain("var full_files: [text]")

    it "builds operator tables directly instead of copying each prefix":
        step("Verify: per-line operator metadata uses direct array literals")
        val source = file_read("src/app/cli/check_tier.spl")
        expect(source).not.to_contain("ops = ops + [OpPattern(")
        expect(source).to_contain(
            "check_line_operators_with_patterns(\n            code_only, tier, core_ops, full_ops)")
        expect(source).to_contain(
            "OpPattern(pattern: \"??\", tier: \"core\", name: \"null_coalesce\")")
        expect(source).to_contain(
            "OpPattern(pattern: \">>>\", tier: \"full\", name: \"gpu_launch_end\")")

    it "assembles stripped source from spans instead of character prefixes":
        step("Verify: string/comment masking performs one byte scan and join")
        val source = file_read("src/app/cli/check_tier.spl")
        val start = source.index_of("fn strip_strings_and_comments(")
        val finish = source.index_of("fn check_one_file(", start)
        val body = source.slice(start, finish)
        expect(body).to_contain("val byte = line.byte_at(i)")
        expect(body).to_contain("parts.push(\" \".repeat(i - string_start))")
        expect(body).to_contain("return parts.join(\"\")")
        expect(body).not.to_contain("result = result +")

    it "extracts keyword spans without repeated whole-line replacement":
        step("Verify: punctuation normalization is one byte scan")
        val source = file_read("src/app/cli/check_tier.spl")
        val start = source.index_of("fn check_one_file_indexed(")
        val finish = source.index_of("fn check_one_file(", start)
        val body = source.slice(start, finish)
        expect(source).to_contain("fn tier_word_parts(code: text) -> [text]:")
        expect(source).to_contain("tier_word_delimiter(code.byte_at(i))")
        expect(body).to_contain("val parts = tier_word_parts(code_only)")
        expect(body).not.to_contain("cleaned = cleaned.replace(")
        expect(body).not.to_contain("cleaned.split(\" \")")
        expect(body).not.to_contain("kw_is_any(")
        expect(body).not.to_contain("kw_is_allowed(")
        expect(body).to_contain("val active_tier_level = tier_level(tier)")
        expect(body).not.to_contain("required_level > tier_level(tier)")

    it "preserves the exact legacy delimiter and non-delimiter behavior":
        step("Verify: word spans retain order duplicates tabs and UTF-8")
        expect(tier_word_parts("foo(fn,bar)")).to_equal(["foo", "fn", "bar"])
        expect(tier_word_parts(" !\"$%&()*+,-./:;<=>?@[]^`{|}~ ").len()).to_equal(0)
        expect(tier_word_parts("foo\tfn")).to_equal(["foo\tfn"])
        expect(tier_word_parts("éclair 東京")).to_equal(["éclair", "東京"])
        expect(tier_word_parts("a'b\\c#d")).to_equal(["a'b\\c#d"])
        expect(tier_word_parts("fn,fn")).to_equal(["fn", "fn"])

    it "indexes the earliest required tier once per request":
        step("Verify: duplicate keywords preserve seed then core precedence")
        val index = build_tier_keyword_index(TierKeywords(
            seed: ["shared", "seed_only"],
            core: ["shared", "core_only", "core_only"],
            full: ["shared", "core_only", "full_only"]))
        expect(tier_keyword_required_level("shared", index)).to_equal(0)
        expect(tier_keyword_required_level("seed_only", index)).to_equal(0)
        expect(tier_keyword_required_level("core_only", index)).to_equal(1)
        expect(tier_keyword_required_level("full_only", index)).to_equal(2)
        expect(tier_keyword_required_level("unknown", index)).to_equal(-1)

        val source = file_read("src/app/cli/check_tier.spl")
        expect(source).to_contain("val keyword_index = build_tier_keyword_index(kw)")
        expect(source).to_contain(
            "check_one_file_indexed(f, \"seed\", keyword_index)")
        expect(source).to_contain(
            "check_one_file_indexed(f, \"core\", keyword_index)")
