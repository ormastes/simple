use app.cli.query_lint_scan.{deprecated_new_column, deprecated_new_columns}
use app.cli.query_check.{_collect_lint_diagnostics_json}
use std.spec.step

describe "DEPR002 lexical detection":
    it "reports the exact original column for indented code":
        step("Preserve source coordinates after lexical masking")
        expect(deprecated_new_column("    val p = Point.new(1, 2)")).to_equal(18)

    it "ignores constructor text in a string literal":
        step("Do not interpret string payload as source syntax")
        expect(deprecated_new_column("    val note = \"Point.new(1, 2)\"")).to_equal(0)

    it "ignores constructor text in a comment":
        step("Do not interpret comment payload as source syntax")
        expect(deprecated_new_column("    # migrate Point.new(1, 2)")).to_equal(0)

    it "finds code before a trailing comment containing another match":
        step("Report the first real syntax occurrence")
        expect(deprecated_new_column("    val p = Point.new() # Other.new()")).to_equal(18)

    it "ignores interior docstring lines and resumes after the close":
        step("Track triple-quoted state across physical lines")
        val lines = ["val doc = \"\"\"", "Fake.new()", "\"\"\"", "    val p = Point.new()"]
        expect(deprecated_new_columns(lines)).to_equal([0, 0, 0, 18])

    it "resumes scanning after a closed string containing comment syntax":
        step("Preserve the original column after masked string payload")
        val line = "val note = \"Fake.new(#)\" ; val p = Point.new()"
        expect(deprecated_new_column(line)).to_equal(41)

    it "resumes after a same-line triple-quoted string":
        step("Handle open and close delimiters without leaking state")
        val lines = ["val doc = \"\"\"Fake.new()\"\"\"; val p = Point.new()"]
        expect(deprecated_new_columns(lines)).to_equal([42])

    it "collects one exact-span diagnostic from mixed lexical input":
        step("Keep JSON diagnostics aligned with lexical candidates")
        val source = "# Fake.new()\nval note = \"Fake.new()\"\n    val p = Point.new()"
        val result = _collect_lint_diagnostics_json("sample.spl", source)
        expect(result.0).to_equal(1)
        expect(result.1).to_equal("{\"severity\":2,\"code\":\"DEPR002\",\"message\":\"'.new()' constructor is deprecated\",\"line\":3,\"col\":18,\"end_line\":3,\"end_col\":23,\"tags\":[2],\"source\":\"simple-lint\"}")

    it "collects DEPR001 through the workspace JSON owner":
        step("Keep workspace diagnostics aligned with canonical lint facts")
        val source = "fn f():\n    Vec__new()\n"
        val result = _collect_lint_diagnostics_json("sample.spl", source)
        expect(result.0).to_equal(1)
        expect(result.1).to_equal("{\"severity\":2,\"code\":\"DEPR001\",\"message\":\"'Vec__new()' uses deprecated Type__method() syntax\",\"line\":2,\"col\":5,\"end_line\":2,\"end_col\":13,\"tags\":[2],\"source\":\"simple-lint\"}")
