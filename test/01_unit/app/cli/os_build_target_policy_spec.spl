# Production target-selection regression; no build/QEMU process is launched.
# AUTHORED_UNRUN: no admitted Simple runner.
# Bug: app_modules_referenced_by_specs_exist_nowhere_2026-08-04
use std.spec.step
use std.spipe.*
use os.cli.{os_build_target_for_arch}
use os.kernel.arch.arch_context.{Architecture}

describe "OS build CLI selects kernel smoke targets":
    it "should build the ARM64 kernel without staged filesystem payloads":
        # @req REQ-CLI-OS-BUILD-001
        step("Select the production ARM64 build target")
        val target = os_build_target_for_arch(Architecture.Arm64)
        step("Check the kernel smoke contract")
        expect(target.entry).to_equal("src/os/kernel/arch/arm64/boot.spl")
        expect(target.output).to_equal("build/os/simpleos_aarch64.elf")
        expect(target.qemu_extra.len()).to_equal(0)

    it "should build the RISC-V64 kernel without hosted acceptance payloads":
        # @req REQ-CLI-OS-BUILD-001
        step("Select the production RISC-V64 build target")
        val target = os_build_target_for_arch(Architecture.Riscv64)
        step("Check the kernel smoke contract")
        expect(target.entry).to_equal("src/os/kernel/arch/riscv64/boot.spl")
        expect(target.output).to_equal("build/os/simpleos_riscv64.elf")
        expect(target.qemu_extra.len()).to_equal(0)
