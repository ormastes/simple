"""
# BLOCKED ON DEPLOY — requires compiler >= a606976737f

This spec is NOT committed. `bin/simple` (Rust seed at
bin/release/x86_64-unknown-linux-gnu/simple, built 2026-08-18T01:08:42Z)
predates commit a606976737f "fix(hir): bare-assignment locals minted as
function locals, not lenient globals" (committed 2026-08-18T01:24:06Z), so
every case below currently FAILS with:
    [CODEGEN BODY] Function 'main' body compilation failed: GlobalLoad:
    unresolved identifier '<name>' (not a global, function, const-data name,
    or import)
under SIMPLE_EXECUTION_MODE=jit — verified by manual run before writing this
file. Do not weaken the assertions to make it pass early; re-run under a
rebuilt binary that includes a606976737f and commit as-is once green.

Regression guard for doc/08_tracking/bug/jit_cannot_compile_print_int_2026-08-18.md.

@manual_section cli/run_exit_codes
"""

use std.spec.*
use std.io_runtime.{shell, file_write}

val PROBE_DIR = "build/probe_jit_bare_assign"
val PROBE = "{PROBE_DIR}/probe.spl"

fn run_probe(body: text) -> (text, i64):
    shell("mkdir -p {PROBE_DIR}")
    file_write(PROBE, body)
    val r = shell("env SIMPLE_TIMEOUT_SECONDS=0 SIMPLE_EXECUTION_MODE=jit SIMPLE_JIT_STRICT=1 timeout 60 bin/simple run {PROBE} 2>&1")
    (r.stdout + r.stderr, r.exit_code)

describe "bare-assignment locals mint as function-scoped mutable locals, not globals":
    it "reproduce: bare-assign an int then print it":
        # @req REQ-CLI-EXIT-005
        val (out, rc) = run_probe("fn main():\n    n = 5\n    print(n)\n")
        assert_equal(rc, 0)
        assert_contains(out, "5")

    it "similar: bare-assign then mutate before use":
        val (out, rc) = run_probe("fn main():\n    n = 5\n    n = n + 1\n    print(n)\n")
        assert_equal(rc, 0)
        assert_contains(out, "6")

    it "similar: bare-assign inside an if branch":
        val (out, rc) = run_probe("fn main():\n    if true:\n        n = 5\n        print(n)\n")
        assert_equal(rc, 0)
        assert_contains(out, "5")

    it "similar: bare-assign inside a while loop":
        val (out, rc) = run_probe("fn main():\n    i = 0\n    while i < 3:\n        i = i + 1\n    print(i)\n")
        assert_equal(rc, 0)
        assert_contains(out, "3")

    it "similar: bare-assign of a text value":
        val (out, rc) = run_probe("fn main():\n    s = \"hi\"\n    print(s)\n")
        assert_equal(rc, 0)
        assert_contains(out, "hi")

    it "similar: bare-assign of an array value":
        val (out, rc) = run_probe("fn main():\n    a = [1, 2, 3]\n    print(a.len())\n")
        assert_equal(rc, 0)
        assert_contains(out, "3")
