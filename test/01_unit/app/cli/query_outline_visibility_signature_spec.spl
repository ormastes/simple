use std.spec.*
use app.cli.query_outline.{OutlineOptions, OutlineSymbol, parse_outline_source}

fn outline_visibility_source(source: text) -> [OutlineSymbol]:
    parse_outline_source(source, OutlineOptions(parent_for_types: true,
        include_import_symbols: false, include_fields: false,
        extract_binding_types: true))

describe "query outline public function metadata":
    it "retains public function name signature return type documentation and range":
        val symbols = outline_visibility_source("# Returns the fixture value.\npub fn visibility_probe() -> i64:\n    return 42\n")
        expect(symbols.len()).to_equal(1)
        val symbol = symbols[0]
        expect(symbol.name).to_equal("visibility_probe")
        expect(symbol.kind).to_equal("fn")
        expect(symbol.signature).to_equal("pub fn visibility_probe() -> i64:")
        expect(symbol.return_type).to_equal("i64")
        expect(symbol.doc_comment).to_equal("Returns the fixture value.")
        expect(symbol.line).to_equal(2)
        expect(symbol.token_start).to_equal(7)
        expect(symbol.token_end).to_equal(23)

    it "uses existing visibility normalization for scoped public functions":
        val symbols = outline_visibility_source("pub(package) fn package_probe() -> text:\n    return \"ok\"\n")
        expect(symbols.len()).to_equal(1)
        expect(symbols[0].name).to_equal("package_probe")
        expect(symbols[0].signature).to_equal("pub(package) fn package_probe() -> text:")
        expect(symbols[0].return_type).to_equal("text")

    it "preserves ordinary function names and excludes prefix lookalikes":
        val symbols = outline_visibility_source("fn ordinary_probe() -> i64:\n    return 7\npubfn_not_a_declaration = 3\n")
        expect(symbols.len()).to_equal(1)
        expect(symbols[0].name).to_equal("ordinary_probe")
        expect(symbols[0].signature).to_equal("fn ordinary_probe() -> i64:")
        expect(symbols[0].return_type).to_equal("i64")

