use std.spec.*
use app.cli.native_build_main.{native_build_authority_source_roots_v1}
use app.io.file_ops.{path_absolute}
use std.scv.compile_source_inventory.{compile_source_inventory_plain_checkout_v1}

describe "native-build parent source authority selection":
    it "matches the worker default roots for named and positional entries":
        val root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
        val entry = "src/compiler/bootstrap_admission/hello_world.spl"
        val expected = ["src/app", "src/lib", "src/compiler", entry]
        expect(native_build_authority_source_roots_v1(["--entry", entry], root)).to_equal(expected)
        expect(native_build_authority_source_roots_v1(["--entry=" + entry], root)).to_equal(expected)
        expect(native_build_authority_source_roots_v1(["--backend", "llvm", "-o", "build/hello", entry], root)).to_equal(expected)

    it "preserves finite explicit roots and never treats policy values as entries":
        val root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
        val entry = "src/compiler/bootstrap_admission/hello_world.spl"
        val args = ["--collection-profile", "build/profile.sdn", "--collection-workload", "hello",
            "--collection-target", "windows", "--source=src/compiler", entry]
        expect(native_build_authority_source_roots_v1(args, root)).to_equal(["src/compiler", entry])
        expect(native_build_authority_source_roots_v1(["--source", "src/compiler", "--entry", entry], root)).to_equal(["src/compiler", entry])

    it "rejects unbounded root entries and incomplete source selection":
        val root = compile_source_inventory_plain_checkout_v1(path_absolute("."))
        expect(native_build_authority_source_roots_v1(["main.spl"], root)).to_equal([])
        expect(native_build_authority_source_roots_v1(["--entry"], root)).to_equal([])
        expect(native_build_authority_source_roots_v1(["--source", "src/compiler"], root)).to_equal([])
        expect(native_build_authority_source_roots_v1(["--entry", "../outside.spl"], root)).to_equal([])
