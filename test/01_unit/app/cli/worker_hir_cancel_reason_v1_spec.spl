# Regression: a HIR owner retired by its own wall deadline (or by a pool
# cancellation request) must record WHY. Phase-2 stage2-compiler-tests
# compiler_cli_build (2026-11-20) ended every worker with
# "status=BLOCKED exit=-1" and a ledger BLOCKED of
# "HIR worker retirement began: " -- empty reason -- because tick() set
# cancelled on now >= deadline_ms without naming the deadline.
use std.spec.{describe, it, expect}
use app.cli.worker_hir_owner_v1.{worker_hir_cancel_reason_v1}

describe "worker_hir_cancel_reason_v1":
    it "names an expired wall deadline when no reason is recorded":
        val reason = worker_hir_cancel_reason_v1("", false, 2000, 1000, 1800000)
        expect(reason).to_contain("deadline expired")
        expect(reason).to_contain("1800 s")

    it "names a pool cancellation request when no reason is recorded":
        val reason = worker_hir_cancel_reason_v1("", true, 500, 1000, 1800000)
        expect(reason).to_contain("cancellation requested")

    it "keeps an already recorded reason":
        val reason = worker_hir_cancel_reason_v1("pin close refused", false, 2000, 1000, 1800000)
        expect(reason).to_equal("pin close refused")

    it "records nothing while the worker is neither cancelled nor past deadline":
        expect(worker_hir_cancel_reason_v1("", false, 500, 1000, 1800000)).to_equal("")
