use std.spec
use std.io_runtime.{file_read}

describe "focused native-build environment owner":
    it "avoids the aggregate io_runtime parser wall":
        val focused = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        val api = file_read("src/compiler/80.driver/bootstrap_api.spl")
        val open = "{"
        val close = "}"

        expect(focused).to_contain("use std.nogc_sync_mut.io.env_ops." + open + "env_get, env_set" + close)
        # The bootstrap API no longer reads process environment at all; only
        # the CLI leaf that interprets flags owns these environment accesses.
        expect(api.contains("env_get")).to_equal(false)
        expect(api.contains("use std.io_runtime")).to_equal(false)
