use std.spec
use std.io_runtime.{file_read}

describe "focused native-build environment owner":
    it "avoids the aggregate io_runtime parser wall":
        val focused = file_read("src/app/cli/bootstrap_focused_native_build.spl")
        # The driver-side env reads were isolated into bootstrap_api_low_memory
        # (9b3b2b0afc1); the aggregate-io_runtime ban still pins that owner.
        val api = file_read("src/compiler/80.driver/bootstrap_api_low_memory.spl")
        val open = "{"
        val close = "}"

        expect(focused).to_contain("use std.nogc_sync_mut.io.env_ops." + open + "env_get, env_set" + close)
        expect(api).to_contain("use std.nogc_sync_mut.io.env_ops." + open + "env_get" + close)
