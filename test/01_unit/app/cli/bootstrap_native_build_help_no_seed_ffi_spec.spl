# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: the `native-build --help` / bare `native-build` entry points must be
answered in-process by the real bootstrap dispatch function, never forwarded to
the seed FFI stub that segfaults (exit 139) in the pure-Simple capsule.
Audience: compiler and tooling engineers who maintain the bootstrap CLI.
"""

use std.spec.step

use std.spec.{describe, it, expect}

# Reproduce-first regression cover for:
#   doc/08_tracking/bug/bootstrap_native_build_help_segfaults_pure_simple_2026-08-18.md
#
# Observed on the deployed pure-Simple capsule bootstrap/stage3/simple:
#   $ bootstrap/stage3/simple native-build --help   -> Segmentation fault (139)
#   $ bootstrap/stage3/simple native-build          -> Segmentation fault (139)
# because both shapes fell through to `run_rt_native_build`, whose only body is
# the Rust seed extern `rt_native_build` -- a backfilled STUB in the pure-Simple
# capsule, so the call jumps into nothing.
#
# Oracle: call the REAL dispatch function, `run_native_build_bootstrap`, with the
# exact argv shapes from the incident and assert on its return codes. The fix
# routes `--help`/`-h` to an in-process usage printer (return 0) and a bare
# `native-build` to the missing-source error (return 1) -- neither touches the
# seed extern. A regression that re-routes them into run_rt_native_build makes
# this process either crash or return the stub's sentinel, failing the spec.

use app.cli.bootstrap_main.{run_native_build_bootstrap}

describe "bootstrap native-build help":
    # @manual scenario evidence
    it "answers --help in-process with exit code 0":
        # @req REQ-SSPEC-APP
        step("Verify: run_native_build_bootstrap answers --help in-process")
        val rc = run_native_build_bootstrap(["simple", "native-build", "--help"])
        expect(rc).to_equal(0)  # oracle: usage must be answered locally, exit 0

    it "answers -h identically with exit code 0":
        # @req REQ-SSPEC-APP
        step("Verify: run_native_build_bootstrap answers -h in-process")
        val rc = run_native_build_bootstrap(["simple", "native-build", "-h"])
        expect(rc).to_equal(0)  # oracle: -h is the same in-process route

    it "rejects a bare native-build with no source instead of crashing":
        # @req REQ-SSPEC-APP
        step("Verify: run_native_build_bootstrap rejects a bare native-build")
        val rc = run_native_build_bootstrap(["simple", "native-build"])
        expect(rc).to_equal(1)  # oracle: missing-source error path returns 1, not a crash

    it "rejects a removed runtime bundle by name with exit code 1":
        # @req REQ-SSPEC-APP
        step("Verify: run_native_build_bootstrap rejects a removed runtime bundle")
        val rc = run_native_build_bootstrap(["simple", "native-build", "x.spl", "--runtime-bundle", "hosted"])
        expect(rc).to_equal(1)  # oracle: removed-bundle guard fires before any build lane
