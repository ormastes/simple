# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.cli._CliMain.args_and_os_commands.{parse_cli_nonnegative_or_default}

describe "main cli numeric guard":
    # @manual scenario evidence
    it "guards malformed global numeric flags":
        # @req REQ-SSPEC-APP
        step("feed well-formed numeric flag values through the guard")
        expect(parse_cli_nonnegative_or_default("42", 7)).to_equal(42)
        expect(parse_cli_nonnegative_or_default("0", 7)).to_equal(0)
        # oracle: default 7 is the documented fallback for every rejected form
        step("feed malformed numeric flag values and confirm the default is used")
        expect(parse_cli_nonnegative_or_default("-3", 7)).to_equal(7)
        expect(parse_cli_nonnegative_or_default("abc", 7)).to_equal(7)
        expect(parse_cli_nonnegative_or_default("12x4", 7)).to_equal(7)
        expect(parse_cli_nonnegative_or_default("", 7)).to_equal(7)
        expect(parse_cli_nonnegative_or_default("  ", 7)).to_equal(7)
        expect(parse_cli_nonnegative_or_default("3.5", 7)).to_equal(7)
