# @tag: unit, cli, bootstrap
# Regression contract for the compiled fixed-worker route.
use std.spec.{describe, it, expect, step}
use app.cli.bootstrap_internal_worker_routing.{
    bootstrap_internal_worker_run_v1, bootstrap_internal_worker_is_parse_v1,
    bootstrap_internal_worker_args_v1}

describe "fixed compiler worker payload routing":
    it "requires the inherited worker marker":
        step("Keep ordinary source runs on the ordinary CLI route")
        val args = ["simple", "run", "src/app/cli/native_build_worker.spl", "--threads", "1"]
        expect(bootstrap_internal_worker_run_v1(args, "")).to_equal(false)
        expect(bootstrap_internal_worker_args_v1(args, "")).to_equal([])

    it "does not promote another script to a compiler worker":
        step("Reject a marked run whose entrypoint is outside the fixed allowlist")
        val args = ["simple", "run", "user/main.spl", "--threads", "1"]
        expect(bootstrap_internal_worker_run_v1(args, "1")).to_equal(false)
        expect(bootstrap_internal_worker_args_v1(args, "1")).to_equal([])

    it "keeps native worker flags and handoff bytes unchanged":
        step("Pass worker-specific flags before generic CLI filtering can consume them")
        val payload = ["--backend", "llvm", "--progress", "none", "--internal-environment-variant-policy-v1=opaque"]
        val args = ["simple", "run", "src/app/cli/native_build_worker.spl"] + payload
        expect(bootstrap_internal_worker_run_v1(args, "1")).to_equal(true)
        expect(bootstrap_internal_worker_is_parse_v1(args, "1")).to_equal(false)
        expect(bootstrap_internal_worker_args_v1(args, "1")).to_equal(payload)

    it "keeps parse shard payloads on their own route":
        step("Preserve shard ownership flags and source roots in order")
        val payload = ["--parse-shard=0/1", "--source", "src", "--entry", "src/app/cli/bootstrap_main.spl"]
        val args = ["simple", "run", "C:/project/src/app/cli/parse_shard_main.spl"] + payload
        expect(bootstrap_internal_worker_is_parse_v1(args, "1")).to_equal(true)
        expect(bootstrap_internal_worker_args_v1(args, "1")).to_equal(payload)

    it "distinguishes admitted empty payload from an unknown request":
        step("Let the policy validator reject missing handoff instead of inventing one")
        val args = ["simple", "run", "src/app/cli/native_build_worker.spl"]
        expect(bootstrap_internal_worker_run_v1(args, "1")).to_equal(true)
        expect(bootstrap_internal_worker_args_v1(args, "1")).to_equal([])

    it "rejects incomplete process argument vectors":
        step("Avoid indexing a missing command or entrypoint")
        expect(bootstrap_internal_worker_run_v1([], "1")).to_equal(false)
        expect(bootstrap_internal_worker_run_v1(["simple", "run"], "1")).to_equal(false)
        expect(bootstrap_internal_worker_args_v1(["simple", "run"], "1")).to_equal([])

    it "does not intercept another command using a worker filename":
        step("Require the coordinator's run verb in addition to marker and fixed entrypoint")
        val args = ["simple", "test", "src/app/cli/native_build_worker.spl", "--backend", "llvm"]
        expect(bootstrap_internal_worker_run_v1(args, "1")).to_equal(false)
        expect(bootstrap_internal_worker_args_v1(args, "1")).to_equal([])
