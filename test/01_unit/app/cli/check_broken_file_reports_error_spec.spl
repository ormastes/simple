# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
#
# CONTRACT spec for `simple check` on a file with a deliberate error: the error
# must be REPORTED — not crashed on, and not silently passed. A checker that
# exits 0 on broken input is the silent-green class this repo keeps hitting.
#
# Error class deliberately used here: a PARSE error. `simple check` is
# parse-only by design (src/app/check/main.spl check_one() calls parse_module()
# plus a concurrency-API lint and nothing semantic — see the cost model in
# doc/08_tracking/bug/check_costs_two_seconds_per_function_decl_2026-08-10.md),
# so a parse error is the deepest error class the checker currently OWNS.
# A semantic type error (`val x: i64 = "not a number"`) and an undefined
# variable both exit 0 with "All checks passed" today — that silent green is
# filed, with measurements, as
# doc/08_tracking/bug/check_silently_passes_type_errors_parse_only_2026-09-01.md
# and this spec must be widened to a type-error fixture when that lands.
# Asserting the type error IS reported today would ship a permanently red spec;
# asserting it is NOT reported would enshrine the silent green. Neither is ok.

use std.spec.step

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_file_write_text(path: text, contents: text) -> i64
extern fn rt_file_exists(path: text) -> bool
extern fn rt_mkdir_p(path: text) -> bool

fn checker_binary() -> text:
    if rt_file_exists("bin/simple.exe"):
        return "bin/simple.exe"
    return "bin/simple"

describe "simple check on a file with a deliberate error":
    # @manual scenario evidence
    it "reports the error and exits nonzero — neither crash nor silent pass":
        # @req REQ-SSPEC-APP
        step("run `simple check` on a file with unbalanced parens")
        val work = "build/sspec_check_contract"
        val _m = rt_mkdir_p(work)
        val entry = work + "/broken_parse.spl"
        val _w = rt_file_write_text(entry, "fn main(:\n    print(\"x\"\nmain(\n")
        val (out, err, code) = rt_process_run_timeout(checker_binary(), ["check", entry], 300000)
        val combined = "{out}{err}"
        # Not silently passed: nonzero exit AND no green verdict line.
        expect(code != 0).to_equal(true)
        expect(combined.contains("All checks passed")).to_equal(false)
        # Not crashed: the failure is a REPORTED diagnostic that names the
        # error class, not a bare nonzero exit or a fault.
        expect(combined.contains("parser_error") or combined.contains("Parse error") or combined.contains("expected")).to_equal(true)
        # The diagnostic attributes the failure to the fixture, not to the
        # checker's own stdlib (the 2026-09-01 stale-seed incident signature).
        expect(combined.contains("broken_parse.spl")).to_equal(true)
        expect(combined.contains("unknown decorator")).to_equal(false)
