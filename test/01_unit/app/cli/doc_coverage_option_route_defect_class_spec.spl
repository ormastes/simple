# @cover src/app/cli/doc_coverage_command.spl 0%
"""
# doc-coverage option routes drive generated help/completions (defect class)

**Category:** App / CLI
**Status:** Acceptance (defect class, positive control)

Defect class: hand-written help drifting from real options. Positive control:
the six MIGRATED doc-coverage options appear in the generated help index and
shell completions derived from the route records, while a still-unmigrated
option from another command (`--human`, check presentation) does NOT —
proving the route table is the actual source, not a parallel copy.
"""

use std.spec.{describe, it, expect, step}
use app.cli.doc_coverage_command.{doc_coverage_help_routes, doc_coverage_option_rows}
use std.nogc_sync_mut.composition.cli_help_gen.{
    cli_help_index_render_v1, cli_completion_render_v1,
}

describe "generated help and completions come from the migrated routes":

    it "help index lists every migrated option with route-derived usage forms":
        val help = cli_help_index_render_v1(doc_coverage_help_routes())
        expect(help.contains("--check-public-api")).to_be(true)
        expect(help.contains("--sdoctest-report")).to_be(true)
        expect(help.contains("--missing")).to_be(true)
        expect(help.contains("--tag-file=<value>")).to_be(true)
        expect(help.contains("--format=<value>")).to_be(true)
        expect(help.contains("--tag=<value>")).to_be(true)
        expect(help.contains("Output format: text|json|csv|md|terminal")).to_be(true)

    it "completions list exactly the six migrated spellings for prefix --":
        val words = cli_completion_render_v1(doc_coverage_help_routes(), "--")
        expect(words.contains("--check-public-api\n")).to_be(true)
        expect(words.contains("--sdoctest-report\n")).to_be(true)
        expect(words.contains("--missing\n")).to_be(true)
        expect(words.contains("--tag-file\n")).to_be(true)
        expect(words.contains("--format\n")).to_be(true)
        expect(words.contains("--tag\n")).to_be(true)

    it "NEGATIVE control: an unmigrated option is absent from help and completions":
        step("--human is still a hardcoded literal in check_options.spl, not a route")
        val help = cli_help_index_render_v1(doc_coverage_help_routes())
        val words = cli_completion_render_v1(doc_coverage_help_routes(), "--")
        expect(help.contains("--human")).to_be(false)
        expect(words.contains("--human\n")).to_be(false)
        step("reserved core spellings are also absent — excluded from migration scope")
        expect(help.contains("--help")).to_be(false)
        expect(help.contains("--version")).to_be(false)

    it "the single-source row list carries exactly the six migrated options":
        step("class-record table internals are not readable under the test")
        step("runner (class-field erasure bug), so assert on the struct rows")
        step("that both the parser and the generator consume")
        expect(doc_coverage_option_rows().len() == 6).to_be(true)
        expect(doc_coverage_help_routes().len() == 6).to_be(true)
