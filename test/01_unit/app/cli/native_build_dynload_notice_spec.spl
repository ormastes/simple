# @req REQ-AOP-DYNLOAD-VISIBLE-DOWNGRADE
"""
`--mode dynload` must never succeed silently while producing no aspect pack
(bug aspect_dynload_producer_absent_and_mode_silent_downgrade_2026-08-23, Defect B).
"""
use std.spec.*
use app.io._CliCompile.compile_targets.{cli_native_build_dynload_pack_notice}

describe "dynload downgrade notice":
    it "names the downgrade when dynload emitted no pack":
        val n = cli_native_build_dynload_pack_notice("dynload", false, 0)
        expect(n).to_contain("W-NATIVE-BUILD-DYNLOAD-ASPECT-PACK-NOT-PRODUCED")

    it "is silent for one-binary":
        expect(cli_native_build_dynload_pack_notice("one-binary", false, 0)).to_equal("")

    it "is silent when a pack was produced":
        expect(cli_native_build_dynload_pack_notice("dynload", false, 2)).to_equal("")

    it "is silent for non-launchable outputs":
        expect(cli_native_build_dynload_pack_notice("dynload", true, 0)).to_equal("")
