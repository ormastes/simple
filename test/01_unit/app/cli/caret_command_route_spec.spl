extern fn rt_file_read_text(path: text) -> text?

describe "root caret command routing":
    it "delegates the caret command to the LLM Caret application":
        val main_source = rt_file_read_text("src/app/cli/_CliMain/main_and_help.spl") ?? ""
        val runner_source = rt_file_read_text("src/app/io/_CliCommands/run_commands.spl") ?? ""
        val table_source = rt_file_read_text("src/app/cli/dispatch/table.spl") ?? ""
        expect(main_source).to_contain("return cli_run_caret(filtered_args)")
        expect(runner_source).to_contain("fn cli_run_caret(args: [text]) -> i64:")
        expect(runner_source).to_contain("cli_run_file(\"src/app/llm_caret/messaging/main.spl\", run_args, false, false)")
        expect(runner_source).to_contain("cli_run_file(\"src/app/llm_caret/main.spl\", run_args, false, false)")
        expect(table_source).to_contain("name: \"caret\"")

    it "keeps messaging as the first LLM Caret application route":
        val source = rt_file_read_text("src/app/llm_caret/main.spl") ?? ""
        expect(source).to_contain("raw_args[0] == \"messaging\"")
        expect(source).to_contain("return run_messaging_cli(raw_args)")
