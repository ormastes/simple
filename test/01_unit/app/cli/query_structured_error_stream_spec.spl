"""Prove structured diagnostic metadata is parsed once without split arrays."""

use app.cli.query_diagnostics.{_split_structured_error}
use app.cli.query_rich_common.{query_split_structured_error}
use std.io_runtime.file_read
use std.spec.step

describe "query structured error streaming":
    it "preserves ordered related items last help and ignored segments":
        step("Scan bounded metadata segments without retaining a split suffix")
        val value = "10:4: core||| RELATED:1:2:first ||||||RELATED:3:4:second café|||UNKNOWN:x|||HELP:old||| HELP:final "
        val parsed = query_split_structured_error(value)
        expect(parsed.0).to_equal("10:4: core")
        expect(parsed.1).to_equal(["1:2:first", "3:4:second café"])
        expect(parsed.2).to_equal("final")
        val plain = query_split_structured_error("opaque error")
        expect(plain.0).to_equal("opaque error")
        expect(plain.1.len()).to_equal(0)
        expect(plain.2).to_equal("")
        val empty = query_split_structured_error("core|||RELATED:|||HELP:")
        expect(empty.0).to_equal("core")
        expect(empty.1).to_equal([""])
        expect(empty.2).to_equal("")
        val compatibility = _split_structured_error(value)
        expect(compatibility.0).to_equal(parsed.0)
        expect(compatibility.1).to_equal(parsed.1)
        expect(compatibility.2).to_equal(parsed.2)

    it "keeps one canonical cursor parser and bounded compatibility routing":
        step("Reject suffix copies segment arrays and duplicate implementations")
        val common = file_read("src/app/cli/query_rich_common.spl")
        val start = common.index_of("fn query_split_structured_error(")
        val finish = common.index_of("fn _extract_decl_name(", start)
        expect(start).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(start)
        val parser = common.slice(start, finish)
        expect(parser).to_contain("while segment_start <= err.len():")
        expect(parser).to_contain("next_separator = _find_in_line_from(")
        expect(parser.split("_find_in_line_from(err, separator,").len()).to_equal(3)
        expect(parser).to_contain("segment_start = next_separator + separator.len()")
        expect(parser).to_contain("related.push(segment.substring(8))")
        expect(parser).not.to_contain(".split(")
        expect(parser).not.to_contain("val rest =")
        expect(parser).not.to_contain("val segments =")
        expect(parser).not.to_contain("related = related.push")

        val diagnostics = file_read("src/app/cli/query_diagnostics.spl")
        val wrapper_start = diagnostics.index_of("fn _split_structured_error(")
        val wrapper_end = diagnostics.index_of("fn _extract_error_code(", wrapper_start)
        expect(wrapper_start).to_be_greater_than(-1)
        expect(wrapper_end).to_be_greater_than(wrapper_start)
        val wrapper = diagnostics.slice(wrapper_start, wrapper_end)
        expect(wrapper).to_contain("query_split_structured_error(err)")
        expect(wrapper).not.to_contain(".split(")
        expect(wrapper).not.to_contain("_find_in_line_from")
        expect(wrapper).not.to_contain("substring(")
        expect(wrapper).not.to_contain("while ")

        val check = file_read("src/app/cli/query_check.spl")
        expect(check).to_contain("val structured = query_split_structured_error(err)")
        expect(check).not.to_contain("fn _split_structured_error(")
        expect(check).not.to_contain("fn query_split_structured_error(")
