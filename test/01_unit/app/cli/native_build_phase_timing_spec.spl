use std.spec.{describe, it, expect}
use app.cli.native_build_phase_timing.{
    native_build_phase_elapsed_ns_v1, native_build_phase_begin_v1,
    native_build_phase_finish_v1
}

describe "native-build phase timing evidence":
    it "preserves sub-millisecond resolution":
        expect(native_build_phase_elapsed_ns_v1(1000000, 1000123)).to_equal(123)

    it "accepts a zero elapsed sample":
        expect(native_build_phase_elapsed_ns_v1(0, 0)).to_equal(0)

    it "rejects a failed initial clock even with a valid final sample":
        expect(native_build_phase_elapsed_ns_v1(-1, 100)).to_equal(-1)

    it "rejects a failed final clock":
        expect(native_build_phase_elapsed_ns_v1(100, -1)).to_equal(-1)

    it "rejects a backwards clock without inventing zero cost":
        expect(native_build_phase_elapsed_ns_v1(100, 99)).to_equal(-1)

    it "supports the largest valid elapsed value without overflow":
        expect(native_build_phase_elapsed_ns_v1(0, 9223372036854775807)).to_equal(9223372036854775807)

    it "leaves disabled profiling inactive":
        expect(native_build_phase_begin_v1(false, "disabled")).to_equal(-1)
        native_build_phase_finish_v1(false, "disabled", -1)
