# NOT_RUN: actual coordinator policy function, not native retirement evidence.
use std.spec.*
use std.io_runtime.{file_read}
use app.io.env_ops.{env_set, env_unset}
use std.nogc_sync_mut.io_runtime.{env_get_nullable}
use app.cli.native_build_env_restore_v1.{native_build_env_saved_v1, native_build_env_restore_v1}
use app.cli.native_build_main.{native_build_capsule_abort_v1, native_build_hir_only_scv_error_v1,
    native_build_shard_aggregate_fail_reason_v1}
use app.cli.native_build_hir_warmup_outcome.{native_build_hir_warmup_outcome_v1, native_build_capsule_user_args_v1,
    native_build_hir_refusal_runs_serial_v1, native_build_hir_refusal_blocks_v1,
    native_build_hir_warmup_go_to_end_outcome_v1,
    native_build_hir_warmup_admits_mir_v1, native_build_stage3_capsule_shard_entry_selected_v1,
    native_build_stage3_capsule_mir_route_v1, native_build_mir_outcome_after_hir_failures_v1, native_build_capsule_mir_outcome_v1}

describe "Focused HIR warmup retirement admission":
    it "continues successful warming only after all owners stop":
        expect(native_build_hir_warmup_outcome_v1(0, true)).to_equal("ready")

    it "permits failed warming fallback after all owners stop":
        expect(native_build_hir_warmup_outcome_v1(1, true)).to_equal("fallback")

    it "refuses an apparent success while a worker may remain live":
        expect(native_build_hir_warmup_outcome_v1(0, false)).to_equal("fail")

    it "refuses a timed out worker before starting fallback":
        expect(native_build_hir_warmup_outcome_v1(-2, false)).to_equal("fail")

describe "Stage 3 capsule HIR worker arguments":
    # bootstrap_main.spl hands the capsule `native-build <args>`; the HIR
    # profile admits only the user args after the subcommand (2026-11-12).
    it "drops the leading native-build subcommand":
        val args = native_build_capsule_user_args_v1(["native-build", "--entry", "src/app/cli/bootstrap_main.spl",
            "--mode", "dynload"])
        expect(args.len()).to_equal(4)
        expect(args[0]).to_equal("--entry")
        expect(args[3]).to_equal("dynload")

    it "keeps user args that carry no subcommand":
        val args = native_build_capsule_user_args_v1(["--entry", "x.spl"])
        expect(args.len()).to_equal(2)
        expect(args[0]).to_equal("--entry")
        expect(native_build_capsule_user_args_v1([]).len()).to_equal(0)

describe "Tool-build coordinator HIR pool refusal":
    # bootstrap-fable-17 (2026-11-12): an auto/default HIR pool refused before
    # any worker started falls back to serial HIR in process, whereas an explicit
    # SIMPLE_HIR_SHARDING=1 request must fail closed with hir_run.blocked_reason.
    it "lowers HIR serially when an auto/default pool was refused before any spawn":
        expect(native_build_hir_refusal_runs_serial_v1(1, true)).to_equal(true)
        expect(native_build_hir_refusal_runs_serial_v1(1, true, "")).to_equal(true)
        expect(native_build_hir_refusal_runs_serial_v1(1, true, "auto")).to_equal(true)
        expect(native_build_hir_refusal_blocks_v1(1, true, "")).to_equal(false)
        expect(native_build_hir_refusal_blocks_v1(1, true, "auto")).to_equal(false)

    it "fails closed when SIMPLE_HIR_SHARDING=1 is refused before any spawn":
        expect(native_build_hir_refusal_runs_serial_v1(1, true, "1")).to_equal(false)
        expect(native_build_hir_refusal_blocks_v1(1, true, "1")).to_equal(true)

    it "keeps a started pool's failure fatal":
        # Owners spawned and crashed (e.g. the executable pin refusal).
        expect(native_build_hir_refusal_runs_serial_v1(1, false)).to_equal(false)
        expect(native_build_hir_refusal_runs_serial_v1(1, false, "1")).to_equal(false)
        expect(native_build_hir_refusal_blocks_v1(1, false, "1")).to_equal(false)

    it "does not degrade a successful warm-up":
        expect(native_build_hir_refusal_runs_serial_v1(0, false)).to_equal(false)
        expect(native_build_hir_refusal_runs_serial_v1(0, true)).to_equal(false)
        expect(native_build_hir_refusal_runs_serial_v1(0, true, "1")).to_equal(false)
        expect(native_build_hir_refusal_blocks_v1(0, true, "1")).to_equal(false)

    it "wires explicit SIMPLE_HIR_SHARDING=1 fail-closed refusal into native_build_main.spl":
        val source = file_read("src/app/cli/native_build_main.spl")
        expect(source).to_contain("native_build_hir_refusal_runs_serial_v1(hir_result, hir_run.refused_before_spawn, hir_sharding)")
        expect(source).to_contain("native_build_hir_refusal_blocks_v1(hir_result, hir_run.refused_before_spawn, hir_sharding)")
        expect(source).to_contain("native_build_hir_refusal_blocks_v1(hir_run.code, hir_run.refused_before_spawn, hir_sharding)")
        expect(source).to_contain("env_get(\"SIMPLE_HIR_SHARDING\") ?? \"\") != 0: native_build_hir_shard_count(args) else: 0")
        expect(source).to_contain("native_build_hir_only_scv_error_v1(")
        expect(source).to_contain("hir_run.blocked_reason")
        expect(source).to_contain("SIMPLE_HIR_SHARDING=1 forbids serial HIR fallback")

    it "restores optional saved env slots and records reason on capsule abort":
        val orig_mem = native_build_env_saved_v1("SIMPLE_MEM_SNAPSHOT_FILE")
        val orig_phase = native_build_env_saved_v1("SIMPLE_COMPILER_PHASE_PROFILE_FILE")
        val orig_prog = native_build_env_saved_v1("SIMPLE_BUILD_PROGRESS_EVENTS")
        env_set("SIMPLE_MEM_SNAPSHOT_FILE", "")
        env_set("SIMPLE_COMPILER_PHASE_PROFILE_FILE", "")
        env_set("SIMPLE_BUILD_PROGRESS_EVENTS", "")
        val rc = native_build_capsule_abort_v1(
            "error: capsule HIR aborted",
            "capsule blocked reason",
            None,
            Some("/tmp/kept-phase.sdn"),
            None)
        val got_mem = env_get_nullable("SIMPLE_MEM_SNAPSHOT_FILE")
        val got_phase = env_get_nullable("SIMPLE_COMPILER_PHASE_PROFILE_FILE")
        val got_prog = env_get_nullable("SIMPLE_BUILD_PROGRESS_EVENTS")
        native_build_env_restore_v1("SIMPLE_MEM_SNAPSHOT_FILE", orig_mem)
        native_build_env_restore_v1("SIMPLE_COMPILER_PHASE_PROFILE_FILE", orig_phase)
        native_build_env_restore_v1("SIMPLE_BUILD_PROGRESS_EVENTS", orig_prog)
        expect(rc).to_equal("fail")
        expect(native_build_shard_aggregate_fail_reason_v1()).to_equal("capsule blocked reason")
        expect(got_mem.is_none()).to_equal(true)
        expect(got_phase ?? "").to_equal("/tmp/kept-phase.sdn")
        expect(got_prog.is_none()).to_equal(true)

    it "enforces canonical SCV authority only on policy 2 (SIMPLE_PARSE_SHARDING=0, SIMPLE_HIR_SHARDING=1)":
        expect(native_build_hir_only_scv_error_v1("", "1")).to_equal("")
        expect(native_build_hir_only_scv_error_v1("0", "")).to_equal("")
        val orig_root = native_build_env_saved_v1("SIMPLE_SCV_SNAPSHOT_ROOT")
        env_unset("SIMPLE_SCV_SNAPSHOT_ROOT")
        val err = native_build_hir_only_scv_error_v1("0", "1")
        native_build_env_restore_v1("SIMPLE_SCV_SNAPSHOT_ROOT", orig_root)
        expect(err).to_start_with("SCV-E-HIR-ADMISSION:")

describe "Stage 3 go-to-end HIR warm-up with module failures":
    # Directive 2026-11-13: HIR runs to the end, then MIR lowers every module
    # whose HIR succeeded. A pool that started and retired every owner has
    # warmed the HIR cache for each module that lowered; MIR shard workers redo
    # HIR for the failed ones, drop them and their importers, and record them
    # as failed rows, so the link stays blocked.
    it "admits MIR shards past HIR module failures under go-to-end":
        val outcome = native_build_hir_warmup_go_to_end_outcome_v1("fallback", false, 3, true)
        expect(outcome).to_equal("ready-with-failures")
        expect(native_build_hir_warmup_admits_mir_v1(outcome)).to_equal(true)

    it "keeps the in-process fallback without go-to-end":
        val outcome = native_build_hir_warmup_go_to_end_outcome_v1("fallback", false, 3, false)
        expect(outcome).to_equal("fallback")
        expect(native_build_hir_warmup_admits_mir_v1(outcome)).to_equal(false)

    it "keeps a pool refused before any spawn on the in-process fallback":
        # Nothing was warmed: every MIR worker would lower the whole closure's HIR.
        val outcome = native_build_hir_warmup_go_to_end_outcome_v1("fallback", true, 0, true)
        expect(outcome).to_equal("fallback")
        expect(native_build_hir_warmup_admits_mir_v1(outcome)).to_equal(false)

    it "keeps the in-process fallback when the pool failed without a module failure":
        # An owner OOM-killed before claiming, a timeout or a BLOCKED ledger
        # names no failed module: the in-process build may still succeed.
        expect(native_build_hir_warmup_go_to_end_outcome_v1("fallback", false, 0, true)).to_equal("fallback")
        # An unreadable failure count (-1) is not a module failure either.
        expect(native_build_hir_warmup_go_to_end_outcome_v1("fallback", false, -1, true)).to_equal("fallback")

    it "never relaxes an unconfirmed retirement or changes a clean warm-up":
        expect(native_build_hir_warmup_go_to_end_outcome_v1("fail", false, 3, true)).to_equal("fail")
        expect(native_build_hir_warmup_admits_mir_v1("fail")).to_equal(false)
        expect(native_build_hir_warmup_go_to_end_outcome_v1("ready", false, 0, true)).to_equal("ready")
        expect(native_build_hir_warmup_admits_mir_v1("ready")).to_equal(true)

describe "Stage 3 capsule MIR route":
    it "keeps the per-file pool when it is selected":
        expect(native_build_stage3_capsule_mir_route_v1(true, false, "", false)).to_equal("per-file")
        expect(native_build_stage3_capsule_mir_route_v1(true, true, "", true)).to_equal("per-file")
        expect(native_build_stage3_capsule_mir_route_v1(true, true, "1", true)).to_equal("per-file")

    it "runs HIR and MIR shard pools on the two-pass route under go-to-end":
        expect(native_build_stage3_capsule_mir_route_v1(false, true, "", false)).to_equal("two-pass")

    it "honors explicit MIR sharding with one coordinator thread":
        expect(native_build_stage3_capsule_mir_route_v1(false, false, "", true)).to_equal("two-pass")

    it "keeps the two-pass route HIR warm-up only without go-to-end":
        expect(native_build_stage3_capsule_mir_route_v1(false, false, "", false)).to_equal("hir-warmup")

    it "skips optional shard warm-up for the whole-program route":
        expect(native_build_stage3_capsule_mir_route_v1(false, true, "1", false)).to_equal("whole-program")
        expect(native_build_stage3_capsule_mir_route_v1(false, false, "1", true)).to_equal("whole-program")

describe "Stage 3 capsule shard entry selection":
    it "keeps the bootstrap capsule prepass by default":
        expect(native_build_stage3_capsule_shard_entry_selected_v1(
            "src/app/cli/bootstrap_main.spl", "dynload", false)).to_equal(true)

    it "admits full tool entries only with explicit MIR sharding":
        expect(native_build_stage3_capsule_shard_entry_selected_v1(
            "src/app/cli/_CliMain/main_and_help.spl", "dynload", false)).to_equal(false)
        expect(native_build_stage3_capsule_shard_entry_selected_v1(
            "src/app/cli/_CliMain/main_and_help.spl", "dynload", true)).to_equal(true)
        expect(native_build_stage3_capsule_shard_entry_selected_v1(
            "src/app/test_runner_new/main.spl", "dynload", true)).to_equal(true)

    it "does not change the one-binary route":
        expect(native_build_stage3_capsule_shard_entry_selected_v1(
            "src/app/cli/bootstrap_main.spl", "one-binary", true)).to_equal(false)

describe "Stage 3 go-to-end MIR verdict after HIR failures":
    it "never links when the HIR pool recorded module failures":
        # A HIR-failed module that never reached the MIR ledger must not let
        # an all-PASS ledger link a binary with missing modules.
        expect(native_build_mir_outcome_after_hir_failures_v1("link", true)).to_equal("fail")
        expect(native_build_mir_outcome_after_hir_failures_v1("fail", true)).to_equal("fail")
        expect(native_build_mir_outcome_after_hir_failures_v1("fallback", true)).to_equal("fail")

    it "keeps every verdict of a clean HIR pool":
        expect(native_build_mir_outcome_after_hir_failures_v1("link", false)).to_equal("link")
        expect(native_build_mir_outcome_after_hir_failures_v1("fallback", false)).to_equal("fallback")


describe "Focused capsule MIR worker termination":
    it "requires explicit fallback after zero-claim SIGKILL or timeout":
        for cause in ["owner=0 status=CRASH exit=-137 signal=SIGKILL(9)", "owner=0 status=TIMEOUT exit=-2"]:
            expect(native_build_capsule_mir_outcome_v1("fallback", cause, false)).to_equal("fail")
            expect(native_build_capsule_mir_outcome_v1("fallback", cause, true)).to_equal("fallback")

    it "preserves ordinary lane fallback, successful links and prior hard failures":
        expect(native_build_capsule_mir_outcome_v1("fallback", "", false)).to_equal("fallback")
        expect(native_build_capsule_mir_outcome_v1("link", "", false)).to_equal("link")
        expect(native_build_capsule_mir_outcome_v1("fail", "owner=0 status=TIMEOUT", true)).to_equal("fail")
