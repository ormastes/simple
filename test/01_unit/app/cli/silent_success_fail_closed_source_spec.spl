# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md






use std.spec.step

extern fn rt_file_read_text(path: text) -> text
use std.spec.{describe, it, expect}

# Source-level family guard for the "silent success" CLI defect class:
#   doc/08_tracking/bug/self_hosted_cli_native_build_silent_no_artifact_2026-08-14.md
#   doc/08_tracking/bug/windows_build_subcommand_silent_noop_stale_binary_2026-08-05.md
#   doc/08_tracking/bug/bootstrap_stage4_get_args_infinite_recursion_coredump_2026-06-21.md
#
# Why a SOURCE spec and not an execution spec: every one of those rows is
# currently blocked on deploying a source-matched self-hosted binary. `bin/simple`
# on this host is the Rust seed, so no runnable probe can exercise the deployed
# path. The fail-closed checks these rows depend on DO exist in current source;
# what has repeatedly been lost is the checks themselves, silently, during
# truncated-tree recoveries and stale-snapshot clobbers. This spec pins them so a
# revert is caught without a bootstrap.

fn src(path: text) -> text:
    rt_file_read_text(path) ?? ""

use std.spec.step

describe "CLI silent-success fail-closed invariants":
    """
    Purpose: this manual pins the behavior named "CLI silent-success fail-closed invariants" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    # @manual scenario evidence
    it "rejects a native-build worker that exits 0 without an output binary":
        # @req REQ-SSPEC-APP
        step("rejects a native-build worker that exits 0 without an output binary")
        val source = src("src/app/cli/native_build_main.spl")
        expect(source.len()).to_be_greater_than(0)
        expect(source).to_contain("if code == 0 and output_path != \"\" and not file_exists(output_path):")
        expect(source).to_contain("error: native-build worker exited 0 but produced no output binary")

    it "rejects a compiler driver Success that wrote no artifact":
        # @req REQ-SSPEC-APP
        step("rejects a compiler driver Success that wrote no artifact")
        val source = src("src/app/io/_CliCompile/compile_targets.spl")
        expect(source.len()).to_be_greater_than(0)
        # The staged sibling is what makes the check meaningful: without it a
        # STALE requested output would satisfy the success test. The staging
        # name's ".simple-native-build-" marker lives in
        # build_intermediate_policy.spl; the compile lane must consume the
        # staged name, not write the requested output directly.
        expect(source).to_contain("val staged_output = out_parent + \"/\" + native_build_intermediate_name(")
        expect(source).to_contain("error: native-build reported success but produced no fresh output binary")
        val policy = src("src/app/io/_CliCompile/build_intermediate_policy.spl")
        expect(policy).to_contain(".simple-native-build-")

    it "reads argv through the runtime extern, never through a same-named import":
        # @req REQ-SSPEC-APP
        step("reads argv through the runtime extern, never through a same-named import")
        # `fn get_args()` importing `get_args` from std.io_runtime bound the call
        # to itself and recursed until the stack died (Stage 4 SIGSEGV on every
        # invocation, including `print(1)`). The wrapper must call the extern.
        val source = src("src/app/io/cli_ops.spl")
        expect(source.len()).to_be_greater_than(0)
        expect(source).to_contain("extern fn rt_cli_get_args() -> [text]")
        expect(source).to_contain("extern fn rt_exit(code: i64)")
        expect(source).to_contain("rt_cli_get_args()")
        # Re-importing either name here reintroduces the self-binding recursion.
        # Other io_runtime names (env_get, getpid, file facades) are imported
        # deliberately and are safe; only the two wrapper-colliding names —
        # imported by any module-path spelling, alone, combined, or via `*` —
        # must stay out.
        assert_false(source.contains("io_runtime.{get_args"))
        assert_false(source.contains("io_runtime.{exit"))
        assert_false(source.contains("io_runtime.*"))
