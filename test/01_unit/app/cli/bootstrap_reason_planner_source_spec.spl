# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.cli.bootstrap_reason_planner.{planner_reason_allowed, planner_sha256_allowed, planner_arg_value}

describe "bootstrap reason planner typed policy":
    # @manual scenario evidence
    it "admits each enumerated stage3 reason and rejects unlisted ones":
        # @req REQ-SSPEC-APP
        step("stage3 reasons are gated by an enumerated allow-list")
        expect(planner_reason_allowed("//bootstrap:stage3", "seed-missing")).to_equal(true)
        expect(planner_reason_allowed("//bootstrap:stage3", "bootstrap-runtime-abi-major-changed")).to_equal(true)
        expect(planner_reason_allowed("//bootstrap:stage3", "because-i-want-to")).to_equal(false)
        expect(planner_reason_allowed("//bootstrap:stage3", "")).to_equal(false)

    it "admits stage4 reasons only for the stage4 target":
        # @req REQ-SSPEC-APP
        step("stage4 reason/target pairing is enforced")
        expect(planner_reason_allowed("//bootstrap:stage4", "self-host-convergence-check")).to_equal(true)
        expect(planner_reason_allowed("//bootstrap:stage4", "diverse-double-compilation")).to_equal(true)
        # a stage4 reason is not valid for stage3 and vice versa
        expect(planner_reason_allowed("//bootstrap:stage3", "self-host-convergence-check")).to_equal(false)
        expect(planner_reason_allowed("//bootstrap:stage4", "seed-missing")).to_equal(false)
        # unknown target admits nothing
        expect(planner_reason_allowed("//bootstrap:stage9", "seed-missing")).to_equal(false)

    it "accepts only 64-char lowercase hex as a sha256":
        # @req REQ-SSPEC-APP
        step("sha256 gate validates shape, not provenance")
        expect(planner_sha256_allowed("a".repeat(64))).to_equal(true)
        expect(planner_sha256_allowed("0123456789abcdef".repeat(4))).to_equal(true)
        expect(planner_sha256_allowed("A".repeat(64))).to_equal(false)
        expect(planner_sha256_allowed("g".repeat(64))).to_equal(false)
        expect(planner_sha256_allowed("a".repeat(63))).to_equal(false)
        expect(planner_sha256_allowed("")).to_equal(false)

    it "extracts the value of a --prefix argument and defaults to empty":
        # @req REQ-SSPEC-APP
        step("argument extraction returns the suffix after the prefix")
        val args = ["--target", "//bootstrap:stage3", "--reason", "seed-missing"]
        expect(planner_arg_value(args, "--reason=")).to_equal("")
        expect(planner_arg_value(["--reason=seed-corrupt"], "--reason=")).to_equal("seed-corrupt")
        expect(planner_arg_value(args, "--missing=")).to_equal("")
