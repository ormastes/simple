use std.spec.*
use app.cli.query_visibility.{strip_visibility_prefix}

describe "public declaration visibility normalizer API":
    it "exposes the canonical normalizer to sibling tooling modules":
        expect(strip_visibility_prefix("pub fn probe() -> i64:")).to_equal("fn probe() -> i64:")
        expect(strip_visibility_prefix("pri fn probe() -> i64:")).to_equal("fn probe() -> i64:")

    it "keeps scoped visibility forms on the same public owner":
        expect(strip_visibility_prefix("pub(package) fn probe():")).to_equal("fn probe():")
        expect(strip_visibility_prefix("pub(peer) fn probe():")).to_equal("fn probe():")
        expect(strip_visibility_prefix("pub(up) fn probe():")).to_equal("fn probe():")
        expect(strip_visibility_prefix("pub(friend) fn probe():")).to_equal("fn probe():")

    it "preserves ordinary declarations and nonmodifier prefix lookalikes":
        expect(strip_visibility_prefix("fn probe():")).to_equal("fn probe():")
        expect(strip_visibility_prefix("pubfn_probe = 1")).to_equal("pubfn_probe = 1")
