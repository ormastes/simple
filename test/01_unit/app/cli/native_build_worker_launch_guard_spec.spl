# Regression coverage for the silent no-artifact path where native-build enters
# the worker runner with a guessed or missing compiler binary.

use std.spec.{describe, it, expect}
use app.cli.native_build_main.{native_build_worker_binary_valid}

describe "native-build worker launch guard":

    it "accepts a present worker binary":
        expect(native_build_worker_binary_valid("bin/simple.exe", true)).to_equal(true)

    it "rejects a missing worker binary even when a fallback path was guessed":
        expect(native_build_worker_binary_valid("bin/simple", false)).to_equal(false)

    it "rejects an empty worker path":
        expect(native_build_worker_binary_valid("", false)).to_equal(false)
