use std.spec.{describe, it, expect}

# Bug array_eq_lowered_as_identity_compare_2026-10-25: Stage-2 native codegen
# lowered `[T] == / != [T]` as a raw word compare (equal lists compared unequal),
# which made the Stage 3 compiler reject every parse-sharded self-build with
# "parse-shard closure selector mapping mismatch". Build natively with the
# compiler under test to reproduce; the interpreter is structural already.

fn _mk_roots(n: i64) -> Result<[text], text>:
    var out: [text] = []
    for i in 0..n:
        out = out.push("src/r{i}")
    Ok(out)

describe "array equality is structural":
    it "treats equal [text] lists built separately as equal":
        val a = _mk_roots(3).unwrap()
        val b = _mk_roots(3).unwrap()
        expect(a == b).to_equal(true)
        expect(a != b).to_equal(false)
    it "treats equal [i64] and [u8] lists as equal":
        val ia: [i64] = [1, 2]
        val ib: [i64] = [1, 2]
        val ua: [u8] = [1, 2, 3]
        val ub: [u8] = [1, 2, 3]
        expect(ia != ib).to_equal(false)
        expect(ua == ub).to_equal(true)
    it "still reports different lists as unequal":
        val a = _mk_roots(3).unwrap()
        val c = _mk_roots(2).unwrap()
        expect(a != c).to_equal(true)
