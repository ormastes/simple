# Purpose: prevent the heavy LSP query child from importing the compiler driver
# or the full CLI dispatch graph (each ~60 s of load under the seed).
# Bug: lsp_heavy_query_child_exceeds_timeout_2026_11_07
use std.spec.*
use std.io_runtime.{file_read}

fn _src(path: text) -> text:
    file_read(path)

fn _has_use(src: text, module: text) -> bool:
    for line in src.split("\n"):
        val t = line.trim()
        if (t.starts_with("use ") or t.starts_with("use lazy ")) and t.contains(module):
            return true
    false

describe "heavy query child import budget":
    it "query.spl does not import cli_helpers (dispatch graph)":
        expect(_has_use(_src("src/app/cli/query.spl"), "app.cli.cli_helpers")).to_equal(false)
    it "query_navigation.spl does not import the compiler driver":
        val s = _src("src/app/cli/query_navigation.spl")
        expect(_has_use(s, "compiler.driver")).to_equal(false)
