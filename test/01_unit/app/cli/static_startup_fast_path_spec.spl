"""
Exact help and version requests must bypass backend registry construction while
requests carrying global options and Phase-7 activation retain the full startup
path.
"""

use app.cli.main.{
    CLI_STATIC_FAST_PATH_NONE,
    CLI_STATIC_FAST_PATH_HELP,
    CLI_STATIC_FAST_PATH_VERSION,
    cli_static_fast_path_kind,
}
use std.spec.step

describe "CLI static startup fast path":
    it "selects exact help and version requests":
        step("classify exact static requests before backend registry construction")
        expect(cli_static_fast_path_kind(["--help"], false)).to_equal(CLI_STATIC_FAST_PATH_HELP)
        expect(cli_static_fast_path_kind(["-h"], false)).to_equal(CLI_STATIC_FAST_PATH_HELP)
        expect(cli_static_fast_path_kind(["--version"], false)).to_equal(CLI_STATIC_FAST_PATH_VERSION)
        expect(cli_static_fast_path_kind(["-v"], false)).to_equal(CLI_STATIC_FAST_PATH_VERSION)

    it "keeps option-bearing requests on the full parser path":
        step("preserve JSON progress and other global-option semantics")
        expect(cli_static_fast_path_kind(["--json", "--version"], false)).to_equal(CLI_STATIC_FAST_PATH_NONE)
        expect(cli_static_fast_path_kind(["--help", "--verbose"], false)).to_equal(CLI_STATIC_FAST_PATH_NONE)
        expect(cli_static_fast_path_kind(["compile", "main.spl"], false)).to_equal(CLI_STATIC_FAST_PATH_NONE)

    it "keeps required Phase-7 child activation on the full startup path":
        step("do not bypass the explicitly required instrumentation activation")
        expect(cli_static_fast_path_kind(["--version"], true)).to_equal(CLI_STATIC_FAST_PATH_NONE)
        expect(cli_static_fast_path_kind(["--help"], true)).to_equal(CLI_STATIC_FAST_PATH_NONE)
