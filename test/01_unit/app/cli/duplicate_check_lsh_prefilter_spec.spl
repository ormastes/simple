"""
## Purpose and audience
Purpose: Prove the opt-in LSH/MinHash candidate pre-pass for duplicate-check.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-CLI-001 — stable requirement identity for this spec.

# Unit coverage for the additive, opt-in LSH candidate pre-pass that wires
# std.common.search.{fingerprint,candidate_bucket} into duplicate-check.
# Guards two things: (1) the pre-pass really selects near-duplicate documents
# and really excludes disjoint ones, and (2) the flag is OFF by default so the
# pinned CLI report format / exit codes are unaffected.

use compiler.tools.duplicate_check.config.{default_config}
use compiler.tools.duplicate_check.lsh_prefilter.{lsh_candidate_pairs_for_streams, sorted_tokens, LshIndexPairV1}

fn doc_a() -> [text]:
    ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa"]

fn doc_a_copy() -> [text]:
    ["kappa", "iota", "theta", "eta", "zeta", "epsilon", "delta", "gamma", "beta", "alpha"]

fn doc_near() -> [text]:
    ["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "lambda"]

fn doc_disjoint() -> [text]:
    ["red", "orange", "yellow", "green", "blue", "indigo", "violet", "cyan", "magenta", "brown"]

fn has_pair(pairs: [LshIndexPairV1], left: i64, right: i64) -> bool:
    for p in pairs:
        if p.left == left and p.right == right:
            return true
    false

fn score_of(pairs: [LshIndexPairV1], left: i64, right: i64) -> i64:
    for p in pairs:
        if p.left == left and p.right == right:
            return p.score
    -1

use std.spec.step

describe "duplicate-check LSH candidate pre-pass":
    it "keeps token streams deterministic before signing":
        step("Verify: keeps token streams deterministic before signing")
        # @req: REQ-APP-CLI-001
        val sorted = sorted_tokens(doc_a_copy())
        expect(sorted.len()).to_equal(10)  # oracle: 10 — the fixture has 10 tokens
        expect(sorted[0]).to_equal("alpha")  # oracle: alpha — lexically first
        expect(sorted[9]).to_equal("zeta")  # oracle: zeta — lexically last

    it "selects identical documents as a maximum-score candidate pair":
        step("Verify: selects identical documents as a maximum-score candidate pair")
        # @req: REQ-APP-CLI-001
        val pairs = lsh_candidate_pairs_for_streams([doc_a(), doc_a_copy()])
        expect(has_pair(pairs, 0, 1)).to_equal(true)  # oracle: true — identical docs must bucket
        # MinHash jaccard estimate is fixed-point scaled by SIMILARITY_SCALE.
        expect(score_of(pairs, 0, 1)).to_equal(1000000)  # oracle: 1000000 — identical signatures

    it "selects a near-duplicate pair and excludes the disjoint document":
        step("Verify: selects a near-duplicate pair and excludes the disjoint document")
        # @req: REQ-APP-CLI-001
        val pairs = lsh_candidate_pairs_for_streams([doc_a(), doc_near(), doc_disjoint()])
        expect(has_pair(pairs, 0, 1)).to_equal(true)  # oracle: true — 9/10 shared tokens
        # A vocabulary-disjoint document must never share an LSH band with
        # either near-duplicate; if banding or hashing degenerates it will.
        expect(has_pair(pairs, 0, 2)).to_equal(false)  # oracle: false — disjoint vocabulary
        expect(has_pair(pairs, 1, 2)).to_equal(false)  # oracle: false — disjoint vocabulary

    it "emits nothing for a single document":
        step("Verify: emits nothing for a single document")
        # @req: REQ-APP-CLI-001
        expect(lsh_candidate_pairs_for_streams([doc_a()]).len()).to_equal(0)  # oracle: 0 — no pairs possible

    it "leaves the pre-pass disabled in the default configuration":
        step("Verify: leaves the pre-pass disabled in the default configuration")
        # @req: REQ-APP-CLI-001
        # This is the compatibility guard: default duplicate-check behaviour,
        # report format and exit codes must be exactly what they were before
        # the pre-pass existed, so the flag must default to false.
        val cfg = default_config()
        expect(cfg.use_lsh_prefilter).to_equal(false)  # oracle: false — opt-in only
