# The lightweight wrapper must route manifest builds to the real worker.

use app.cli.native_build_main.{
    native_build_manifest_requested, native_build_has_entry,
    native_build_is_value_consuming_flag
}

describe "native-build manifest wrapper gate":
    it "recognizes both manifest flag forms":
        expect(native_build_manifest_requested([
            "--input-manifest", "build/cache/manifests/a.manifest"])).to_equal(true)
        expect(native_build_manifest_requested([
            "--input-manifest=build/cache/manifests/a.manifest"])).to_equal(true)
        expect(native_build_manifest_requested(["--entry", "src/main.spl"])).to_equal(false)

    it "does not mistake the manifest path for a positional entry":
        expect(native_build_is_value_consuming_flag("--input-manifest")).to_equal(true)
        expect(native_build_has_entry([
            "--input-manifest", "build/cache/manifests/a.manifest"])).to_equal(false)
        expect(native_build_has_entry([
            "--input-manifest", "build/cache/manifests/a.manifest",
            "--entry", "src/main.spl"])).to_equal(true)
