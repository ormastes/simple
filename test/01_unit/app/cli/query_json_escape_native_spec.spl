"""Keep the query JSON escape spans correct for byte indexed native builds."""

use app.cli.query_rich_common.{query_json_escape}
use std.spec.step

describe "query JSON escape native spans":
    it "preserves Unicode and escapes only the historical five characters":
        step("Check unchanged text, adjacent escapes, and UTF-8 spans around escapes")
        val plain = "café 日本語"
        expect(query_json_escape(plain)).to_equal(plain)
        expect(query_json_escape("a\\\"\n\r\tb")).to_equal("a\\\\\\\"\\n\\r\\tb")
        expect(query_json_escape("é\n日本語\"fin")).to_equal("é\\n日本語\\\"fin")
