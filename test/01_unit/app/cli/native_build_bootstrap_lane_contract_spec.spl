# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



## Source contract for the two bootstrap/native-build CLI entrypoints.
##
## These two files are the parent wrappers for every `native-build` invocation
## in the bootstrap lanes. Their real end-to-end behaviour can only be observed
## by running a full bootstrap, so the invariants that are cheap to break and
## expensive to notice are pinned here as SOURCE contracts instead.
##
## Each assertion below corresponds to a claim in a `doc/08_tracking/bug/`
## record; a change that silently reintroduces the old shape turns this spec
## red instead of surfacing 20 minutes into a bootstrap.

use std.spec.step

use std.spec
use std.spec.step
use std.io_runtime.{file_read}
use app.cli.native_build_main.{native_build_collect_diagnostics}


fn seed_wrapper_marker(src: text) -> text:
    ## Markers that would indicate the entry generates a Rust-seed wrapper or a
    ## ret-0 stub as a "successful" artifact (bug
    ## bootstrap_stage3_selfhost_seed_wrapper_fallback_2026-06-17).
    # A documentation reference to the Rust argument parser is harmless. Pin
    # executable wrapper primitives, not directory-name mentions in comments.
    if src.contains("execv"):
        return "execv"
    if src.contains("SIMPLE_BOOTSTRAP_SEED"):
        return "SIMPLE_BOOTSTRAP_SEED"
    if src.contains("ret i64 0"):
        return "ret i64 0"
    "ok"

describe "native-build / bootstrap CLI entry source contract":
    """
    Purpose: this manual pins the behavior named "native-build / bootstrap CLI entry source contract" for the owning engineering team.
    Audience: engineers verifying regressions in this area; steps below are executable evidence.
    """
    # @manual scenario evidence

    it "never injects an execution mode into the worker argv":
        # @req REQ-SSPEC-UNIT
        step("never injects an execution mode into the worker argv")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## baremetal_entry_closure_class_instantiation_fault_2026-07-06 recorded
        ## that run_native_build_worker appended `--mode=interpreter` to the
        ## worker argv, which the worker's own parser then rejected. The mode is
        ## now carried by the SIMPLE_EXECUTION_MODE environment variable only.
        val src = file_read("src/app/cli/native_build_main.spl")
        assert_false(src.contains("--mode=interpreter"))
        expect(src).to_contain("env_set(\"SIMPLE_EXECUTION_MODE\", \"interpret\")")

    it "keeps the rerun-diagnostics hint reachable from a failing worker":
        # @req REQ-SSPEC-UNIT
        step("keeps the rerun-diagnostics hint reachable from a failing worker")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## bootstrap_logging_diagnostics_2026-07-07: a nil `.id` failure must
        ## tell the operator which env vars re-run it with phase/function names.
        val src = file_read("src/app/cli/native_build_main.spl")
        expect(src).to_contain("SIMPLE_BOOTSTRAP_DIAG=1 SIMPLE_COMPILER_TRACE=1")
        expect(src).to_contain("undefined field 'id'")
        expect(src).to_contain("native_build_print_failure_hints(stdout, stderr)")

    it "preserves diagnostics across stderr truncation":
        # @req REQ-SSPEC-UNIT
        step("preserves diagnostics across stderr truncation")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## A head+tail truncation drops the middle, so a `grep -c` over the
        ## relayed stderr can report 0 for a diagnostic that actually fired.
        ## Every diagnostic line from the FULL stream must be re-emitted.
        val src = file_read("src/app/cli/native_build_main.spl")
        expect(src).to_contain("fn native_build_collect_diagnostics(output: text) -> [text]:")
        expect(src).to_contain("BEGIN PRESERVED DIAGNOSTICS")
        expect(src).to_contain("NATIVE-BUILD STDERR TRUNCATED")

    it "collects sparse diagnostics in exact stream order":
        val diagnostics = native_build_collect_diagnostics(
            "noise\nerror: first\n\nwarning: second\nnoise\npanic tail\n")
        expect(diagnostics.len()).to_equal(3)
        expect(diagnostics[0]).to_equal("error: first")
        expect(diagnostics[1]).to_equal("warning: second")
        expect(diagnostics[2]).to_equal("panic tail")
        expect(native_build_collect_diagnostics("noise\n\nmore noise\n").len()).to_equal(0)
        expect(native_build_collect_diagnostics("").len()).to_equal(0)
        val crlf = native_build_collect_diagnostics("  warning: crlf\r\n")
        expect(crlf.len()).to_equal(1)
        expect(crlf[0]).to_equal("  warning: crlf\r")
        val eof = native_build_collect_diagnostics("noise\nerror: eof")
        expect(eof.len()).to_equal(1)
        expect(eof[0]).to_equal("error: eof")

    it "keeps the core-dump line that names a crashed worker":
        ## `timeout: the monitored command dumped core` is the ONLY evidence that
        ## a worker died by SIGSEGV rather than being killed or exiting -1. It
        ## was not a recognised diagnostic on 2026-09-05, so the middle-dropping
        ## truncation discarded it and three investigations chased an OOM, a
        ## rogue killer and a double reap instead. See
        ## doc/08_tracking/bug/stage3_worker_reaped_silently_in_hir_typecheck_2026-09-05.md
        val crash = native_build_collect_diagnostics(
            "noise\ntimeout: the monitored command dumped core\nnoise\n")
        expect(crash.len()).to_equal(1)
        expect(crash[0]).to_equal("timeout: the monitored command dumped core")
        expect(native_build_collect_diagnostics("sh: line 1: 42 (core dumped)\n").len())
            .to_equal(1)

    it "streams diagnostic lines without retaining a full split array":
        val src = file_read("src/app/cli/native_build_main.spl")
        expect(src).to_contain("output.index_of(\"\\n\", line_start)")
        expect(src).to_contain(
            "if native_build_range_is_diagnostic(output, line_start, line_end):")
        expect(src).to_contain("output.substring(line_start, line_end)")
        val match_pos = src.index_of(
            "if native_build_range_is_diagnostic(output, line_start, line_end):")
        val substring_pos = src.index_of(
            "output.substring(line_start, line_end)", match_pos)
        expect(substring_pos).to_be_greater_than(match_pos)
        # `not_to_contain` is not a matcher this spec runtime has (only `to_contain`
        # plus the i64-only `not_()`), so this line ERRORED on every run since it
        # was written -- which is how the streaming implementation it guards came
        # to be clobbered by a merge without anyone noticing. Assert the boolean.
        expect(src.contains("for line in output.split(\"\\n\")")).to_be_false()

    it "treats a zero exit with no output binary as a hard failure":
        # @req REQ-SSPEC-UNIT
        step("treats a zero exit with no output binary as a hard failure")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## The silent-wrong-result shape for this lane: worker chain dies in a
        ## way that still exits 0 and the caller proceeds with a stale binary.
        val src = file_read("src/app/cli/native_build_main.spl")
        expect(src).to_contain("exited 0 but produced no output binary")

    it "never reports in-process native-build success without a real artifact":
        # @req REQ-SSPEC-UNIT
        step("never reports in-process native-build success without a real artifact")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## bootstrap_main's compile() could fall through with no mode matched,
        ## return Success, emit nothing, and exit 0. Both in-process lanes must
        ## assert the artifact exists AND is not a stub.
        val src = file_read("src/app/cli/bootstrap_main.spl")
        expect(src).to_contain("error: in-process native-build reported success without creating")
        expect(src).to_contain("error: in-process native-build produced a stub artifact")
        expect(src).to_contain("error: in-process SMF compile reported success without creating")
        expect(src).to_contain("error: in-process SMF compile produced a stub artifact")

    it "keeps the cli_mode_text override on both in-process compile lanes":
        # @req REQ-SSPEC-UNIT
        step("keeps the cli_mode_text override on both in-process compile lanes")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        ## The enum `options.mode` does not survive struct transport into a
        ## COMPILED stage2 driver; cli_mode_text is what makes the lane work.
        val src = file_read("src/app/cli/bootstrap_main.spl")
        expect(src).to_contain("options.cli_mode_text = \"aot\"")

    it "keeps bootstrap_main free of seed-wrapper artifact generation":
        # @req REQ-SSPEC-UNIT
        step("keeps bootstrap_main free of seed-wrapper artifact generation")
        # evidence(oracle-complete: exact assertion on the real module output; no retained artifact needed)
        val src = file_read("src/app/cli/bootstrap_main.spl")
        expect(seed_wrapper_marker(src)).to_equal("ok")
