# Purpose and audience: regression evidence for the Phase 2 LSP build and
# query JSON serializer owners.
# @req REQ-SSPEC-UNIT

use std.spec
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}
use app.cli.query_rich_common.{query_json_escape}

describe "Phase 2 compatible query JSON escaping":
    it "retains ordinary and Unicode text without allocation-producing enumeration":
        step("escape-free input preserves its exact contents")
        expect(query_json_escape("alpha βeta 한글")).to_equal("alpha βeta 한글")

    it "escapes every historical query JSON control character":
        step("backslash, quote, newline, carriage return, and tab are escaped")
        expect(query_json_escape("a\\b\"c\nd\re\tf")).to_equal("a\\\\b\\\"c\\nd\\re\\tf")

    it "preserves spans surrounding multiple escapes":
        step("byte offsets keep multibyte text before a later escape intact")
        expect(query_json_escape("left\nβeta\tright")).to_equal("left\\nβeta\\tright")

    it "keeps the Phase 2 bootstrap leaf free of unsupported Array.enumerate":
        step("the admitted Stage 2 compiler can lower the LSP source")
        val source = file_read("src/app/cli/query_rich_common.spl")
        expect(source.contains(".chars().enumerate()")).to_equal(false)
