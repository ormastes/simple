extern fn rt_file_read_text(path: text) -> text

describe("cache runtime facade ownership"):
    it("keeps daemon lock process checks on the process facade"):
        val source = rt_file_read_text("src/lib/nogc_sync_mut/daemon_sdk/lock.spl") ?? ""
        expect(source.contains("use std.nogc_sync_mut.io.process_ops.{process_is_running}")).to_equal(true)
        expect(source.contains("rt_process_exists")).to_equal(false)

    it("keeps shared cache I/O on app file facades"):
        val source = rt_file_read_text("src/app/test_cache_shared.spl") ?? ""
        expect(source.contains("use app.io.mod.{file_read_text, file_write, file_stat}")).to_equal(true)
        expect(source.contains("rt_file_read_text")).to_equal(false)
        expect(source.contains("rt_file_write_text")).to_equal(false)
