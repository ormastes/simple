# Static contract: section 10 is fully emitted, SHA-admitted once, and routed
# through a cached immutable view rather than per-token header reparsing.

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.composition.{parse_composition_source_v1, composition_cli_extension_routes_v1, encode_composition_image_with_cli_option_route_v1, decode_composition_image_v1}
use std.nogc_sync_mut.composition.sci_generator.{sci_generate_route_section_v1}
use app.simple_core.router.{SIMPLE_CORE_ROUTE_PROVIDER, simple_core_route_v1}

val SHA = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
val ABI = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
val SOURCE = "schema: simple.composition/1\nprofile: test\ninterface_groups:\n  - id: cli.command\n    major: 1\n    minor: 0\n    abi_digest: " + ABI + "\nproviders:\n  - id: cli.format\n    artifact: build/providers/format.smf\n    kind: smf\n    artifact_digest: " + SHA + "\n    interface_groups: [cli.command]\n    required_capability_bits: 0\nbindings:\n  - service: cli.format\n    interface_group: cli.command\n    provider: cli.format\ncli_extensions:\n  - namespace: format\n    provider: cli.format\n    availability: optional\n    missing_policy: warn_skip\n"

fn _config():
    val image = parse_composition_source_v1(SOURCE).unwrap()
    val routes = composition_cli_extension_routes_v1(SOURCE).unwrap()
    val section = sci_generate_route_section_v1(routes, 1).bytes
    decode_composition_image_v1(encode_composition_image_with_cli_option_route_v1(image, section).unwrap())

describe "SCI section-10 immutable router contract":
    it "admits one decoded view and reuses its handle across extension tokens":
        val config = _config()
        expect(config.ok).to_equal(true)
        expect(config.image.cli_option_route_view.integrity_verified).to_equal(true)
        expect(config.image.cli_option_route_view.handle.route_count).to_equal(1)
        val route = simple_core_route_v1(["fmt", "--xformat-mode=check", "--xformat-mode=apply", "--", "--xforeign-data"], config, "1.0.0")
        expect(route.kind).to_equal(SIMPLE_CORE_ROUTE_PROVIDER)
        expect(route.activation.provider_id).to_equal("cli.format")
        expect(route.activation.extension_missing_policy).to_equal(2)
        expect(route.activation.args).to_equal(["fmt", "--xformat-mode=check", "--xformat-mode=apply", "--", "--xforeign-data"])
