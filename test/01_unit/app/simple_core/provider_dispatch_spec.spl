use std.spec.{describe, it, expect}
use app.cli_composition.{CliActivationRequestV1}
use app.simple_core.provider_dispatch.{
    SIMPLE_CORE_PROVIDER_DISPATCH_INVALID,
    SIMPLE_CORE_PROVIDER_DISPATCH_ADMISSION_FAILED,
    simple_core_dispatch_provider_v1
}

fn activation_v1(ok: bool, path: text) -> CliActivationRequestV1:
    CliActivationRequestV1(
        ok: ok,
        diagnostic_code: "",
        diagnostic_subject: "",
        requested_command: "fmt",
        canonical_command: "fmt",
        summary: "format",
        args: ["file.spl"],
        binding_service_id: "cli.fmt",
        interface_group_id: "cli.command",
        interface_major: 1,
        interface_minor: 0,
        interface_abi_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        provider_id: "fmt",
        provider_artifact_path: path,
        provider_artifact_kind: "smf",
        provider_artifact_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        requested_capability_bits: 0,
    )

describe "simple-core owned provider dispatch":
    it "rejects invalid activation before loader side effects":
        val receipt = simple_core_dispatch_provider_v1(activation_v1(false, "build/providers/fmt.smf"), 1, 0)
        expect(receipt.status).to_equal(SIMPLE_CORE_PROVIDER_DISPATCH_INVALID)
        expect(receipt.pin_released).to_equal(false)
        expect(receipt.session_closed).to_equal(false)

    it "fails closed when the locked provider artifact is absent":
        val receipt = simple_core_dispatch_provider_v1(
            activation_v1(true, "build/providers/definitely-absent-provider.smf"), 1, 0,
        )
        expect(receipt.status).to_equal(SIMPLE_CORE_PROVIDER_DISPATCH_ADMISSION_FAILED)
        expect(receipt.diagnostic).to_contain("artifact-missing")
        expect(receipt.pin_released).to_equal(false)
