use std.spec.{describe, it, expect}
use app.simple_core.main.{
    SIMPLE_CORE_DEFAULT_COMPOSITION_V1, simple_core_invocation_v1
}

describe "minimal simple-core executable arguments":
    it "keeps the fixed default composition and provider command arguments":
        val invocation = simple_core_invocation_v1(["fmt", "file.spl"])
        expect(invocation.ok).to_be(true)
        expect(invocation.composition_path).to_equal(SIMPLE_CORE_DEFAULT_COMPOSITION_V1)
        expect(invocation.args).to_equal(["fmt", "file.spl"])

    it "removes one explicit composition path before command routing":
        val invocation = simple_core_invocation_v1([
            "--composition", "build/fixtures/dev.sci", "provider", "inspect", "fmt"
        ])
        expect(invocation.ok).to_be(true)
        expect(invocation.composition_path).to_equal("build/fixtures/dev.sci")
        expect(invocation.args).to_equal(["provider", "inspect", "fmt"])

    it "rejects missing empty or duplicate composition options":
        expect(simple_core_invocation_v1(["--composition"]).ok).to_be(false)
        expect(simple_core_invocation_v1(["--composition="]).ok).to_be(false)
        expect(simple_core_invocation_v1([
            "--composition=a.sci", "--composition=b.sci", "doctor"
        ]).ok).to_be(false)
