"""
## Purpose and audience
Purpose: Prove that JsonlWatcher.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-LLM-DASHBOARD-001 — stable requirement identity for this spec.

use app.llm_dashboard.data.jsonl_watcher.{JsonlWatcher}
use std.io_runtime.{dir_create, dir_remove, file_write, file_append_text, env_get, getpid}

fn _tmp_root(name: text) -> text:
    val base = env_get("TMPDIR") ?? "/tmp"
    return "{base}/simple_llm_dashboard_{name}_{getpid()}"

fn _prepare_tree(root: text, project: text):
    dir_remove(root, true)
    dir_create(root, true)
    dir_create("{root}/{project}", true)

fn _tool_use_line(path: text, timestamp: i64) -> text:
    return "{\"type\":\"tool_use\",\"name\":\"Read\",\"input\":{\"file_path\":\"{path}\"},\"timestamp\":{timestamp}}"

use std.spec.step

describe "JsonlWatcher":
    it "tails newly discovered transcripts from EOF instead of replaying backlog":
        step("Verify: tails newly discovered transcripts from EOF instead of replaying backlog")
        # @req: REQ-APP-LLM-DASHBOARD-001
        val root = _tmp_root("tail")
        val project = "proj_a"
        val transcript = "{root}/{project}/session.jsonl"
        _prepare_tree(root, project)

        val existing = _tool_use_line("src/old_1.spl", 1) + "\n" + _tool_use_line("src/old_2.spl", 2) + "\n"
        file_write(transcript, existing)

        var watcher = JsonlWatcher.with_dir(root)
        val initial = watcher.poll()
        expect(initial.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(watcher.watched_count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        file_append_text(transcript, _tool_use_line("src/new_append.spl", 3) + "\n")
        val appended = watcher.poll()
        expect(appended.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        dir_remove(root, true)

    it "resets offset after transcript truncation so replacement content is read":
        step("Verify: resets offset after transcript truncation so replacement content is read")
        val root = _tmp_root("truncate")
        val project = "proj_b"
        val transcript = "{root}/{project}/session.jsonl"
        _prepare_tree(root, project)

        file_write(transcript, _tool_use_line("src/original.spl", 1) + "\n")
        var watcher = JsonlWatcher.with_dir(root)
        expect(watcher.poll().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        file_append_text(transcript, _tool_use_line("src/appended.spl", 2) + "\n")
        expect(watcher.poll().len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        file_write(transcript, _tool_use_line("x.spl", 3) + "\n")
        val rotated = watcher.poll()
        expect(rotated.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement

        dir_remove(root, true)

    it "ignores stray files in the watch root while scanning project directories":
        step("Verify: ignores stray files in the watch root while scanning project directories")
        val root = _tmp_root("root_file")
        dir_remove(root, true)
        dir_create(root, true)
        file_write("{root}/README.txt", "not a transcript root\n")

        var watcher = JsonlWatcher.with_dir(root)
        val events = watcher.poll()
        expect(events.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(watcher.watched_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        dir_remove(root, true)

    it "holds partial lines until the JSONL record is newline terminated":
        step("Verify: holds partial lines until the JSONL record is newline terminated")
        val root = _tmp_root("partial")
        val project = "proj_c"
        val transcript = "{root}/{project}/session.jsonl"
        _prepare_tree(root, project)

        file_write(transcript, "")
        var watcher = JsonlWatcher.with_dir(root)
        expect(watcher.poll().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        file_append_text(transcript, "{\"type\":\"tool_use\"")
        expect(watcher.poll().len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

        file_append_text(transcript, ",\"name\":\"Read\"}\n")
        val completed = watcher.poll()
        expect(completed.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(completed[0]).to_contain("\"tool_use\"")
        expect(completed[0]).to_contain("\"Read\"")

        dir_remove(root, true)
