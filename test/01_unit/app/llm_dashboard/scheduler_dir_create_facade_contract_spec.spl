use app.io.mod.{file_read_text}

describe "LLM dashboard scheduler directory-create facade contract":
    it "routes both recursive creates through the exact loaded facade":
        val source = file_read_text("src/app/llm_dashboard/scheduler/scheduler.spl")

        expect(source).to_contain("use app.io.mod.{process_spawn_async, process_is_running, dir_create}")
        expect(source.split("dir_create(RESULTS_DIR, true)").len() - 1).to_equal(1)
        expect(source.split("dir_create(SCHED_DIR, true)").len() - 1).to_equal(1)
        expect(source).to_not_contain("rt_dir_create")

    it "retains the non-equivalent nullable text-read boundary":
        val source = file_read_text("src/app/llm_dashboard/scheduler/scheduler.spl")

        # The loaded file_read_text facade maps a provider failure to empty
        # text. The scheduler's direct declaration has a distinct non-null
        # contract, so this focused migration must not silently combine them.
        expect(source).to_contain("extern fn rt_file_read_text(path: text) -> text")
        expect(source).to_contain("val content = rt_file_read_text(path)")
