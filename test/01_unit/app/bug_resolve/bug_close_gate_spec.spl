# Executable specification: CU-015 backend bug-close gate. A bug may not move
# to Closed without an existing reproducer spec AND an existing prevention
# (generalization) spec; the CLI backend enforces it, not a UI button.
# @req CU-015
# @cover src/app/bug_resolve/close_gate.spl

use std.spec.{describe, it, expect, step}
use app.bug_resolve.close_gate.{bug_close_gate}

describe "bug close gate":
    it "accepts two distinct existing spec paths":
        # @req CU-015
        step("both reproducer and prevention exist")
        expect(bug_close_gate("test/01_unit/a_spec.spl", "test/01_unit/b_spec.spl", true, true)).to_equal("")

    it "rejects a missing reproducer naming the evidence":
        # @req CU-015
        step("empty reproducer")
        val msg = bug_close_gate("", "test/01_unit/b_spec.spl", false, true)
        expect(msg).to_contain("reproducer")
        expect(msg).to_contain("--reproducer=")

    it "rejects a missing prevention spec":
        # @req CU-015
        step("empty prevention")
        val msg = bug_close_gate("test/01_unit/a_spec.spl", "", true, false)
        expect(msg).to_contain("prevention")
        expect(msg).to_contain("--prevention=")

    it "rejects paths that do not exist":
        # @req CU-015
        step("nonexistent files")
        expect(bug_close_gate("test/a_spec.spl", "test/b_spec.spl", false, true)).to_contain("reproducer spec not found")
        expect(bug_close_gate("test/a_spec.spl", "test/b_spec.spl", true, false)).to_contain("prevention spec not found")

    it "rejects non-spec, unsafe, or identical evidence":
        # @req CU-015
        step("shape checks")
        expect(bug_close_gate("notes.md", "test/b_spec.spl", true, true)).to_contain("_spec.spl")
        expect(bug_close_gate("../x_spec.spl", "test/b_spec.spl", true, true)).to_contain("repository-relative")
        expect(bug_close_gate("/abs/x_spec.spl", "test/b_spec.spl", true, true)).to_contain("repository-relative")
        expect(bug_close_gate("test/a_spec.spl", "test/a_spec.spl", true, true)).to_contain("distinct")
