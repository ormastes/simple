# @req REQ-LEAK-RESULT-STATUS-001
use std.spec
use compiler.tools.leak_check.types.{StaticViolation, GrowthEvent, empty_leak_check_result,
    default_leak_check_config}
use compiler.tools.leak_check.static_runner.{run_static_check}
use compiler.tools.leak_check.light_main.{finalize_light_result}
use std.io_runtime.{file_exists}

describe "leak-check result schema and failed runner status":
    it "returns independent declared result fields from the canonical factory":
        val first = empty_leak_check_result()
        val second = empty_leak_check_result()
        expect(first.target).to_equal("")
        expect(first.verdict).to_equal("")
        expect(first.static_violations.len()).to_equal(0)
        first.static_violations.push(StaticViolation(function_name: "f", category: "no_alloc_violation",
            detail: "allocates", source_line: 17))
        expect(first.static_violations.len()).to_equal(1)
        expect(first.static_violations[0].source_line).to_equal(17)
        expect(second.static_violations.len()).to_equal(0)

    it "keeps a real missing static file failure through finalization":
        var cfg = default_leak_check_config()
        cfg.source_file = "test/fixtures/leak_check/__missing_static_target_20261016__.spl"
        expect(file_exists(cfg.source_file)).to_equal(false)
        val runner = run_static_check(cfg)
        expect(runner.exit_code).to_equal(1)
        expect(runner.static_violations.len()).to_equal(0)
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.target).to_equal(cfg.source_file)
        expect(finalized.verdict).to_equal("fail")
        expect(finalized.exit_code).to_equal(1)

    it "preserves a nonstandard failing runner exit without observation rows":
        var cfg = default_leak_check_config()
        cfg.source_file = "growth-target.spl"
        val runner = empty_leak_check_result()
        runner.mode = "growth"
        runner.exit_code = 125
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.exit_code).to_equal(125)
        expect(finalized.target).to_equal("growth-target.spl")
        expect(finalized.verdict).to_equal("fail")

    it "still classifies a successfully checked static result as passing":
        val cfg = default_leak_check_config()
        val runner = empty_leak_check_result()
        runner.mode = "static"
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.exit_code).to_equal(0)
        expect(finalized.verdict).to_equal("pass")
        expect(finalized.evidence_level).to_equal("strong")

    it "classifies actual static violation records as a failure":
        val cfg = default_leak_check_config()
        val runner = empty_leak_check_result()
        runner.mode = "static"
        runner.static_violations = [StaticViolation(function_name: "f",
            category: "no_alloc_violation", detail: "allocates", source_line: 23)]
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.exit_code).to_equal(1)
        expect(finalized.verdict).to_equal("fail")
        expect(finalized.evidence_level).to_equal("strong")

    it "keeps growth warning classification and an existing target":
        var cfg = default_leak_check_config()
        cfg.source_file = "fallback-target.spl"
        val runner = empty_leak_check_result()
        runner.mode = "growth"
        runner.target = "observed-target.spl"
        runner.growth_events = [GrowthEvent(kind: "threshold_warn", baseline_rss_kb: 10,
            observed_rss_kb: 12, delta_kb: 2, detail: "warning")]
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.exit_code).to_equal(0)
        expect(finalized.verdict).to_equal("warn")
        expect(finalized.target).to_equal("observed-target.spl")

    it "keeps growth failure precedence over warning observations":
        val cfg = default_leak_check_config()
        val runner = empty_leak_check_result()
        runner.mode = "growth"
        runner.growth_events = [
            GrowthEvent(kind: "threshold_warn", baseline_rss_kb: 10,
                observed_rss_kb: 12, delta_kb: 2, detail: "warning"),
            GrowthEvent(kind: "rss_budget", baseline_rss_kb: 10,
                observed_rss_kb: 20, delta_kb: 10, detail: "failure")]
        val finalized = finalize_light_result(cfg, runner)
        expect(finalized.exit_code).to_equal(1)
        expect(finalized.verdict).to_equal("fail")
        expect(finalized.evidence_level).to_equal("heuristic")
