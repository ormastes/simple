# @req REQ-SSPEC-UNIT
"""
# StaticViolation is declared in compiler.tools.leak_check.types

The manual stage3 per-module object sweep failed all six
src/compiler/90.tools/leak_check/*.spl consumer modules with
`unresolved type: StaticViolation`: the name was declared nowhere in the
tree while the app.leak_check.types facade already re-exported it, so the
break surfaced as a fabricated-position error. The declaration lives next
to GrowthEvent in compiler.tools.leak_check.types; its field set is exactly
the two construction sites in static_runner.spl (alloc_import summary and
no_alloc_violation report). These probes pin the declaration, its export,
and the construction shape.
"""

# @tag: unit, leak_check, types

use std.spec
use std.io_runtime.{file_read}
use compiler.tools.leak_check.types.{StaticViolation}

describe "StaticViolation declaration":
    it "constructs with the static runner's field set":
        val violation = StaticViolation(
            function_name: "compute",
            category: "no_alloc_violation",
            detail: "function inferred to allocate",
            source_line: 42
        )
        expect(violation.function_name).to_equal("compute")
        expect(violation.category).to_equal("no_alloc_violation")
        expect(violation.detail).to_equal("function inferred to allocate")
        expect(violation.source_line).to_equal(42)

    it "is declared and exported next to GrowthEvent in the owning module":
        val source = file_read("src/compiler/90.tools/leak_check/types.spl")
        expect(source).to_contain("class StaticViolation:")
        expect(source).to_contain("export StaticViolation")
        expect(source).to_contain("function_name: text")
        expect(source).to_contain("source_line: i64")

    it "is re-exported by the app facade unchanged":
        val source = file_read("src/app/leak_check/types.spl")
        expect(source).to_contain("StaticViolation")
