"""
## Purpose and audience
Purpose: Prove that parse_leak_check_args.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-APP-LEAK-CHECK-001 — stable requirement identity for this spec.

# Config spec for leak_check/config.spl
#
# Tests parse_leak_check_args with various flag combinations.

use app.leak_check.config.{parse_leak_check_args}

use std.spec.step

describe "parse_leak_check_args":
    it "parses source file as positional argument":
        step("Verify: parses source file as positional argument")
        # @req: REQ-APP-LEAK-CHECK-001
        fn run():
            val cfg = parse_leak_check_args(["test.spl"])
            expect(cfg.source_file).to_equal("test.spl")
        run()

    it "parses --verbose flag":
        step("Verify: parses --verbose flag")
        fn run():
            val cfg = parse_leak_check_args(["--verbose", "test.spl"])
            expect(cfg.verbose).to_equal(true)
            expect(cfg.source_file).to_equal("test.spl")
        run()

    it "parses --mode=external":
        step("Verify: parses --mode=external")
        fn run():
            val cfg = parse_leak_check_args(["--mode=external", "test.spl"])
            expect(cfg.source_file).to_equal("test.spl")
        run()

    it "parses --timeout=20":
        step("Verify: parses --timeout=20")
        fn run():
            val cfg = parse_leak_check_args(["--timeout=20", "test.spl"])
            expect(cfg.timeout_seconds).to_equal(20)  # oracle: 20 — named expected value from the requirement
            expect(cfg.source_file).to_equal("test.spl")
        run()

    it "uses default timeout of 10":
        step("Verify: uses default timeout of 10")
        fn run():
            val cfg = parse_leak_check_args(["test.spl"])
            expect(cfg.timeout_seconds).to_equal(10)  # oracle: 10 — named expected value from the requirement
        run()

    it "parses --help and returns empty source":
        step("Verify: parses --help and returns empty source")
        fn run():
            val cfg = parse_leak_check_args(["--help"])
            expect(cfg.source_file).to_equal("")
        run()

    it "parses multiple flags together":
        step("Verify: parses multiple flags together")
        fn run():
            val cfg = parse_leak_check_args(["--verbose", "--timeout=15", "--gc-window=5", "my_file.spl"])
            expect(cfg.verbose).to_equal(true)
            expect(cfg.timeout_seconds).to_equal(15)  # oracle: 15 — named expected value from the requirement
            expect(cfg.gc_leak_window).to_equal(5)  # oracle: 5 — named expected value from the requirement
            expect(cfg.source_file).to_equal("my_file.spl")
        run()
