# Native regression for the monolithic IDE GUI drag return type.
use std.editor.core.session.{EditSession}
use app.editor.gui_shell.{DragState, GuiShellState, gui_shell_new, gui_handle_mouse_down}
use app.editor.editor_controller.{EditorController}

fn main() -> i64:
    val state: GuiShellState = gui_shell_new(EditSession.new())
    val ctrl: EditorController = state.ctrl
    ctrl.session.dock_layout.show_right("problems")
    val idle = DragState(active: false, source_panel_id: "", source_zone: -1, mouse_x: 0, mouse_y: 0, drop_target_zone: -1)
    val right_tab_x = state.config.initial_width - ctrl.session.dock_layout.right_width_value() + 20
    val drag = gui_handle_mouse_down(state, idle, right_tab_x, 25)
    if not drag.active:
        return 1
    if drag.source_panel_id != "problems":
        return 2
    print "gui-shell-drag-native=PASS assertions=2"
    0
