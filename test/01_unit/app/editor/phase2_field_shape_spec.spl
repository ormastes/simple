# Purpose and audience: regression evidence for Phase 2 editor source compatibility.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}
use std.editor.view.dock_zone.{DockPosition, dock_zone_tab_contains}

extern fn rt_file_read_text(path: text) -> text?

describe "Phase 2 editor field shapes":
    it "uses typed dock accessors in the legacy GUI shell":
        step("Keep legacy GUI shell field access aligned with DockLayout")
        val source = rt_file_read_text("src/app/editor/gui_shell.spl") ?? ""
        val split_source = rt_file_read_text("src/app/editor/gui_shell_render.spl") ?? ""
        expect(source).to_contain("dock_zone_tab_contains(position, size, w, h, tab_h, x, y)")
        expect(split_source).to_contain("dock_zone_tab_contains(position, size, w, h, tab_h, x, y)")
        expect(source.contains("dock_layout.left_width *")).to_be(false)
        expect(source.contains("dock_layout.bottom_height *")).to_be(false)
        expect(split_source.contains("left_width_value() * w / 100")).to_be(false)
        expect(split_source.contains("bottom.size * h / 100")).to_be(false)

    it "uses DockZone pixel extents for tab hit testing":
        step("Exercise left, right, and bottom tab boundaries in pixels")
        expect(dock_zone_tab_contains(DockPosition.Left, 250, 1200, 800, 28, 249, 27)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Left, 250, 1200, 800, 28, 250, 27)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Right, 300, 1200, 800, 28, 900, 0)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Right, 300, 1200, 800, 28, 899, 0)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Bottom, 200, 1200, 800, 28, 0, 600)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Bottom, 200, 1200, 800, 28, 1199, 627)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Bottom, 200, 1200, 800, 28, 0, 628)).to_be(false)

    it "clips oversized zones and rejects invalid geometry":
        step("Keep hit rectangles inside the viewport")
        expect(dock_zone_tab_contains(DockPosition.Right, 2000, 1200, 800, 28, 0, 0)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Bottom, 2000, 1200, 800, 28, 0, 0)).to_be(true)
        expect(dock_zone_tab_contains(DockPosition.Left, 0, 1200, 800, 28, 0, 0)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Left, 250, 0, 800, 28, 0, 0)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Left, 250, 1200, 0, 28, 0, 0)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Left, 250, 1200, 800, 0, 0, 0)).to_be(false)
        expect(dock_zone_tab_contains(DockPosition.Top, 250, 1200, 800, 28, 0, 0)).to_be(false)

    it "binds optional markdown state before field access":
        step("Keep markdown preview fields on a narrowed MarkdownState receiver")
        val source = rt_file_read_text("src/app/editor/md_dispatch.spl") ?? ""
        expect(source).to_contain("if val md_state = doc.md_state:")
        expect(source).to_contain("md_state.preview_visible")
        expect(source).to_contain("md_state.preview")
        expect(source.contains("doc.md_state.preview_visible")).to_be(false)
