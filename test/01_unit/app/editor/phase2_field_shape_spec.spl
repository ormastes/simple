# Purpose and audience: behavioral regression evidence for Phase 2 editor lowering.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect, step}
use std.editor.view.dock_zone.{DockLayout, DockZone, DockPosition, dock_layout_tab_contains}
use std.editor.view.markdown_state.{MarkdownState, markdown_preview_if_visible}

fn phase2_layout() -> DockLayout:
    DockLayout(
        left: DockZone(id: 1, position: DockPosition.Left, size: 20, visible: true),
        right: DockZone(id: 2, position: DockPosition.Right, size: 25, visible: true),
        bottom: DockZone(id: 3, position: DockPosition.Bottom, size: 30, visible: true),
        active_right: "", right_visible: true)

describe "Phase 2 editor field behavior":
    it "computes left, right, and bottom tab hit zones from typed dock fields":
        step("Exercise all three DockLayout field/accessor branches")
        val layout = phase2_layout()
        expect(dock_layout_tab_contains(layout, 10, 10, 20, 30, 1000, 800, 28, 199, 27)).to_be(true)
        expect(dock_layout_tab_contains(layout, 10, 10, 20, 30, 1000, 800, 28, 200, 27)).to_be(false)
        expect(dock_layout_tab_contains(layout, 20, 10, 20, 30, 1000, 800, 28, 750, 0)).to_be(true)
        expect(dock_layout_tab_contains(layout, 30, 10, 20, 30, 1000, 800, 28, 500, 560)).to_be(true)
        expect(dock_layout_tab_contains(layout, 30, 10, 20, 30, 1000, 800, 28, 500, 588)).to_be(false)

    it "narrows absent, hidden, and visible optional markdown state":
        step("Return a MarkdownState only when preview rendering is enabled")
        expect(markdown_preview_if_visible(nil).is_none()).to_be(true)
        val hidden = MarkdownState.new()
        expect(markdown_preview_if_visible(Some(hidden)).is_none()).to_be(true)
        val visible = hidden.toggle_preview()
        val narrowed = markdown_preview_if_visible(Some(visible))
        expect(narrowed.is_some()).to_be(true)
        expect(narrowed.unwrap().preview_visible).to_be(true)
