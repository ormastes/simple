# Regression coverage for editor types used by the Phase2 CLI closure.
use std.spec
use std.editor.services.md_lsp_config.{md_lsp_config, md_lsp_is_markdown_file}
use std.editor.services.simple_lsp_config.{simple_lsp_config, simple_lsp_is_simple_file}
use std.editor.view.lsp_popup.{lsp_signature_popup_show}
use app.editor.gui_shell.{gui_render_lsp_signature_popup_html}
use std.editor.core.document.{EditorDocument}
use app.editor.md_dispatch.{md_update_preview}

describe "Phase2 editor imported type contracts":
    it "preserves both language server configurations":
        val markdown = md_lsp_config("/workspace")
        val simple = simple_lsp_config("/workspace")
        expect(markdown.language_id).to_equal("markdown")
        expect(simple.language_id).to_equal("simple")
        expect(markdown.root_path).to_equal("/workspace")
        expect(simple.root_path).to_equal("/workspace")
        expect(md_lsp_is_markdown_file("notes.md")).to_equal(true)
        expect(simple_lsp_is_simple_file("notes.md")).to_equal(false)

    it "renders the text of the active signature parameter":
        val popup = lsp_signature_popup_show(2, 3, "sum(left, right)", "Adds", "right")
        val html = gui_render_lsp_signature_popup_html(popup)
        expect(html).to_contain("data-active-parameter=\"right\"")
        expect(html).to_contain("signature-active-parameter\">right</span>")

    it "leaves a document without markdown state unchanged":
        val doc = EditorDocument.empty()
        md_update_preview(doc, doc.buffer)
        expect(doc.md_state).to_be_nil()
        expect(doc.content).to_equal("")
