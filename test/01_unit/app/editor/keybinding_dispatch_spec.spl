# A contributed keybinding reaching dispatch.
#
# ExtensionHost._register_contributions parses manifest.contributes_keybindings
# and binds each into keybinding_manager (keybinding_resolve proves this in
# test/01_unit/lib/editor/keybinding_contribution_spec.spl), but until now no
# application code ever called keybinding_resolve: pressing a key an extension
# bound did nothing.
#
# ctrl_dispatch_normal_key (src/app/editor/editor_ctrl_core.spl) now checks
# ExtensionHost.contributed_keybinding_command(key, "normal") -- a lookup
# scoped to keybinding_registry (extension contributions only), never the
# built-in vim/IDE defaults that live in keybinding_manager.config -- so it
# can never shadow "j"/"h"/"K"/etc. When a contributed key resolves to a
# command with a registered handler, that handler runs via dispatch_command.
# When it resolves but has no handler (only markdown ships handlers today),
# status_msg reports that instead of crashing or silently doing nothing, and
# the key is treated as consumed rather than falling through to vim keys.

use std.spec
use std.editor.core.session.{EditSession}
use std.editor.extensions.host.*
use std.editor.extensions.manifest.*
use std.editor.view.split_tree.*
use app.editor.editor_controller.{EditorController}

fn kb_dispatch_ping_handler(payload: text) -> Result<text, text>:
    Ok("pinged")

fn kb_dispatch_demo_manifest() -> ExtensionManifest:
    var m = extension_manifest_basic(
        "kb-dispatch-demo", "1.0.0", "",
        ["onCommand:kb.dispatch.ping"],
        [ExtensionCommand(id: "kb.dispatch.ping", title: "KB Dispatch Ping", category: "Demo")],
        []
    )
    m.contributes_keybindings = [
        ExtensionKeybinding(command: "kb.dispatch.ping", key: "Ctrl+Shift+K", when: "")
    ]
    m

fn kb_dispatch_silent_manifest() -> ExtensionManifest:
    var m = extension_manifest_basic(
        "kb-dispatch-silent", "1.0.0", "",
        ["onCommand:kb.dispatch.silent"],
        [ExtensionCommand(id: "kb.dispatch.silent", title: "KB Dispatch Silent", category: "Demo")],
        []
    )
    m.contributes_keybindings = [
        ExtensionKeybinding(command: "kb.dispatch.silent", key: "Ctrl+Shift+L", when: "")
    ]
    m

describe "a contributed keybinding reaches dispatch":

    it "invokes the registered handler when a contributed key resolves to a command that has one":
        var session = EditSession.new()
        var ctrl: EditorController = EditorController.new(session)
        ctrl.extension_host.register_manifest(kb_dispatch_demo_manifest(), "<test>")
        expect(ctrl.extension_host.activate("kb-dispatch-demo")).to_equal(true)
        ctrl.extension_host.register_command_handler(
            "kb-dispatch-demo", "kb.dispatch.ping", "KB Dispatch Ping", kb_dispatch_ping_handler
        )
        val rects: [SplitRect] = []

        val action = ctrl.handle_key("Ctrl+Shift+K", rects)
        expect(action.status_msg).to_equal("pinged")

    it "reports a resolved-but-unhandled contributed command instead of crashing or falling through":
        var session = EditSession.new()
        var ctrl: EditorController = EditorController.new(session)
        ctrl.extension_host.register_manifest(kb_dispatch_silent_manifest(), "<test>")
        expect(ctrl.extension_host.activate("kb-dispatch-silent")).to_equal(true)
        val rects: [SplitRect] = []

        val action = ctrl.handle_key("Ctrl+Shift+L", rects)
        expect(action.status_msg).to_equal("no handler registered for command 'kb.dispatch.silent'")
        expect(action.quit).to_equal(false)

    it "leaves a key the extension did not bind unaffected":
        var session = EditSession.new()
        var ctrl: EditorController = EditorController.new(session)
        ctrl.extension_host.register_manifest(kb_dispatch_demo_manifest(), "<test>")
        expect(ctrl.extension_host.activate("kb-dispatch-demo")).to_equal(true)
        val rects: [SplitRect] = []

        # No buffer is open, and "Ctrl+Shift+Z" is not the key this extension
        # bound ("Ctrl+Shift+K"), nor any vim default. ctrl_handle_normal_key's
        # documented fallthrough (see editor_hardening_spec.spl) already
        # returns an empty message for any key it does not recognize -- that
        # unrelated, pre-existing contract is the proof the new contributed-
        # keybinding check did not intercept this key: if it had, status_msg
        # would be either the dispatched payload or a "no handler" message,
        # never "".
        val action = ctrl.handle_key("Ctrl+Shift+Z", rects)
        expect(action.status_msg).to_equal("")
