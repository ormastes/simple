# @req: REQ-APP-EDITOR-001

# @cover src/lib/editor/extensions/builtin/md_language.spl 40%
# @req REQ-IDE-EXT-KERNEL-L1
"""
# markdown.toggle_bold — Handler Unit Coverage

**Feature IDs:** IDE-EXT-KERNEL L1
**Category:** Unit
**Status:** In Progress

Unit coverage for the typed `markdown.toggle_bold` command handler: the
line-level toggle (`md_toggle_bold_line`) over selections, words at the
cursor, and already-bold segments, plus the payload codec used by
`ExtensionHost.dispatch_command`.
"""

use std.spec
use std.editor.extensions.builtin.md_language.*

use std.spec.step

describe "md_toggle_bold_line":

    it "wraps an explicit selection in **":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: wraps an explicit selection in **")
        expect(md_toggle_bold_line("hello world", 0, 6, 11)).to_equal("hello **world**")

    it "unwraps when the selection is surrounded by **":
        # @req: REQ-APP-EDITOR-001
        step("Verify: unwraps when the selection is surrounded by **")
        expect(md_toggle_bold_line("hello **world**", 0, 8, 13)).to_equal("hello world")

    it "unwraps when the selection includes the ** markers":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: unwraps when the selection includes the ** markers")
        expect(md_toggle_bold_line("hello **world**", 0, 6, 15)).to_equal("hello world")

    it "wraps the word at the cursor when there is no selection":
        # @req: REQ-APP-EDITOR-001
        step("Verify: wraps the word at the cursor when there is no selection")
        expect(md_toggle_bold_line("hello world", 8, -1, -1)).to_equal("hello **world**")

    it "unwraps the word at the cursor when already bold":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: unwraps the word at the cursor when already bold")
        expect(md_toggle_bold_line("hello **world**", 10, -1, -1)).to_equal("hello world")

    it "uses the word just before the cursor at end of line":
        # @req: REQ-APP-EDITOR-001
        step("Verify: uses the word just before the cursor at end of line")
        expect(md_toggle_bold_line("hello", 5, -1, -1)).to_equal("**hello**")

    it "inserts empty bold markers when the cursor is not on a word":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: inserts empty bold markers when the cursor is not on a word")
        expect(md_toggle_bold_line("a  b", 2, -1, -1)).to_equal("a **** b")

    it "clamps an out-of-range selection to the line":
        # @req: REQ-APP-EDITOR-001
        step("Verify: clamps an out-of-range selection to the line")
        expect(md_toggle_bold_line("word", 0, 0, 99)).to_equal("**word**")

describe "md_toggle_bold_handler payload codec":

    it "decodes col|sel_start|sel_end|line and returns the toggled line":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: decodes col|sel_start|sel_end|line and returns the toggled line")
        match md_toggle_bold_handler("0|6|11|hello world"):
            case Ok(value):
                expect(value).to_equal("hello **world**")
            case Err(_):
                expect("handler").to_equal("should have succeeded")

    it "keeps pipe characters inside the line text":
        # @req: REQ-APP-EDITOR-001
        step("Verify: keeps pipe characters inside the line text")
        match md_toggle_bold_handler("0|2|6|a |b|c| d"):
            case Ok(value):
                expect(value).to_equal("a **|b|c**| d")
            case Err(_):
                expect("handler").to_equal("should have succeeded")

    it "rejects a payload without a header":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: rejects a payload without a header")
        match md_toggle_bold_handler("no separators here"):
            case Ok(_):
                expect("handler").to_equal("should have failed")
            case Err(message):
                expect(message.contains("payload")).to_equal(true)

describe "markdown diagnostics provider handler":

    it "encodes diagnostics as line|col|severity|message rows":
        # @req: REQ-APP-EDITOR-001
        step("Verify: encodes diagnostics as line|col|severity|message rows")
        match md_language_diagnose_handler("#Bad\n"):
            case Ok(encoded):
                expect(encoded.contains("Heading requires a space after '#'")).to_equal(true)
            case Err(_):
                expect("handler").to_equal("should have succeeded")

    it "returns empty text for clean markdown":
        # @req: REQ-IDE-EXT-KERNEL-L1
        step("Verify: returns empty text for clean markdown")
        match md_language_diagnose_handler("# Fine heading\n\nbody\n"):
            case Ok(encoded):
                expect(encoded).to_equal("")
            case Err(_):
                expect("handler").to_equal("should have succeeded")
