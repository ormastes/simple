use std.spec.{describe, it, expect}
use std.editor.view.layout.{EditorGroup}
use std.editor.buffer.buffer.{EditorBuffer}
use app.editor.tui_shell_panels.{_layout_find_group_index_local}
use app.editor.tui_shell.{tui_render_line_with_semantic_tokens_at_theme}
use app.editor.tui_line_render.{tui_render_editor_line_at_theme}

describe "TUI split module owner imports":
    it "looks up real group identities rather than treating identity as an index":
        val groups = [
            EditorGroup(id: 17, tabs: [], active_tab_index: 0),
            EditorGroup(id: 42, tabs: [], active_tab_index: 0)
        ]
        expect(_layout_find_group_index_local(groups, 42)).to_equal(1)
        expect(_layout_find_group_index_local(groups, 17)).to_equal(0)

    it "preserves missing and empty group lookup results":
        val groups = [EditorGroup(id: 17, tabs: [], active_tab_index: 0)]
        expect(_layout_find_group_index_local(groups, 1)).to_equal(-1)
        expect(_layout_find_group_index_local([], 17)).to_equal(-1)

    it "renders a real buffer without semantic tokens unchanged":
        val buffer = EditorBuffer.from_text(1, "plain text")
        expect(tui_render_line_with_semantic_tokens_at_theme(
            buffer, 0, "plain text", 0, "light")).to_equal("plain text")

    it "preserves semantic token styling through the shell module":
        var buffer = EditorBuffer.from_text(2, "abc")
        buffer.add_semantic_token(0, 0, 3, 1)
        expect(tui_render_line_with_semantic_tokens_at_theme(
            buffer, 0, "abc", 0, "light")).to_equal("\x1b[34mabc\x1b[0m")

    it "highlights the real Markdown table cell without changing surrounding text":
        var buffer = EditorBuffer.from_text(3, "| a | b |")
        buffer.cursor_col = 2
        expect(tui_render_editor_line_at_theme(
            buffer, 0, "| a | b |", 0, "dark", "notes.md"
        )).to_equal("| \x1b[7ma\x1b[0m | b |")

    it "preserves viewport offsets and the non-Markdown rendering route":
        var buffer = EditorBuffer.from_text(4, "| a | b |")
        buffer.cursor_col = 6
        expect(tui_render_editor_line_at_theme(
            buffer, 0, "b |", 6, "dark", "notes.md"
        )).to_equal("\x1b[7mb\x1b[0m |")
        expect(tui_render_editor_line_at_theme(
            buffer, 0, "b |", 6, "dark", "notes.txt"
        )).to_equal("b |")
