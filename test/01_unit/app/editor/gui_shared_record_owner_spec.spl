use std.spec.{describe, it, expect}
use std.editor.common.gui_types.{GuiFrame, GuiEvent}
use app.editor.gui_shell.{GuiFrame as ShellGuiFrame, GuiEvent as ShellGuiEvent}
use std.editor.backend.gui_sdl_bridge.{gui_sdl_frame_draw_ir}

fn gui_owner_frame_identity(frame: GuiFrame) -> GuiFrame:
    frame

fn gui_owner_event_identity(event: GuiEvent) -> GuiEvent:
    event

describe "editor GUI shared record owners":
    it "retains the shell frame API as the shared nominal record":
        val frame = gui_owner_frame_identity(ShellGuiFrame(
            tab_bar_html: "tabs", file_tree_html: "tree",
            editor_html: "editor", status_html: "status"
        ))
        expect(frame.tab_bar_html).to_equal("tabs")
        expect(frame.file_tree_html).to_equal("tree")
        expect(frame.editor_html).to_equal("editor")
        expect(frame.status_html).to_equal("status")

    it "preserves empty and text-input event payloads through the shell alias":
        val empty = gui_owner_event_identity(ShellGuiEvent(kind: "", data: ""))
        val typed = gui_owner_event_identity(ShellGuiEvent(kind: "text", data: "한글"))
        expect(empty.kind).to_equal("")
        expect(empty.data).to_equal("")
        expect(typed.kind).to_equal("text")
        expect(typed.data).to_equal("한글")

    it "passes a shell frame into the SDL DrawIR builder without opening a window":
        val frame = ShellGuiFrame(
            tab_bar_html: "tab", file_tree_html: "tree",
            editor_html: "body", status_html: "ready"
        )
        val composition = gui_sdl_frame_draw_ir(frame, 640, 480)
        expect(composition.batches.len()).to_equal(1)
        val commands = composition.batches[0].commands
        expect(commands.len()).to_equal(7)
        expect(commands[0].width).to_equal(640)
        expect(commands[0].height).to_equal(480)
        expect(commands[2].y).to_equal(460)
        expect(commands[3].text_value).to_equal("tab")
        expect(commands[4].text_value).to_equal("tree")
        expect(commands[5].text_value).to_equal("body")
        expect(commands[6].text_value).to_equal("ready")
