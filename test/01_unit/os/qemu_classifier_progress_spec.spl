use std.spec.*
use os.qemu_systest_contract.{classify_serial, classify_serial_with_nonce}

describe "QEMU classifier finite marker traversal":
    it "returns after a present marker instead of shadowing its counter":
        expect(classify_serial("TEST PASSED\n", ["TEST PASSED"])).to_equal("pass")
    it "rejects the missing second marker after advancing":
        expect(classify_serial("first\n", ["first", "second"])).to_equal("boot-fail:second")
    it "advances across repeated markers":
        expect(classify_serial("ok\n", ["ok", "ok", "ok"])).to_equal("pass")
    it "terminates for an empty marker list":
        expect(classify_serial("", [])).to_equal("pass")
    it "retains nonce admission before traversing markers":
        expect(classify_serial_with_nonce("SIMPLEOS_QEMU_NONCE=n\nok\n", ["ok"], "n")).to_equal("pass")
        expect(classify_serial_with_nonce("ok\n", ["ok"], "n")).to_equal("boot-fail:nonce-unsupported")
