# Unit spec for simplebox applet cores
"""
## Purpose and audience
Purpose: returns count bytes from offset
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-SimpApplCore-001

use std.spec
use os.tools.simplebox.simplebox_applets_core.{applet_dd, applet_timeout_parse, applet_chown_parse, ChownReq}

use std.spec.step
describe "simplebox extra applets":
    describe "applet_dd":
        it "returns count bytes from offset":
            step("Verify: returns count bytes from offset")
            # @req: REQ-OS-SimpApplCore-001
            # Build test array: [1, 2, 3, 4, 5]
            var src: [u8] = []
            src.push(1)
            src.push(2)
            src.push(3)
            src.push(4)
            src.push(5)
            val result = applet_dd(src, 1, 2)
            expect(result.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(result[0]).to_equal(2)  # oracle: value fixed by the spec contract
            expect(result[1]).to_equal(3)  # oracle: value fixed by the spec contract

        it "clamps to end of array":
            step("Verify: clamps to end of array")
            # @req: REQ-OS-SimpApplCore-001
            var src: [u8] = []
            src.push(1)
            src.push(2)
            src.push(3)
            src.push(4)
            src.push(5)
            val result = applet_dd(src, 2, 10)  # count extends past end
            expect(result.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(result[0]).to_equal(3)  # oracle: value fixed by the spec contract
            expect(result[1]).to_equal(4)  # oracle: value fixed by the spec contract
            expect(result[2]).to_equal(5)  # oracle: value fixed by the spec contract

        it "returns empty when skip >= length":
            step("Verify: returns empty when skip >= length")
            # @req: REQ-OS-SimpApplCore-001
            var src: [u8] = []
            src.push(1)
            src.push(2)
            src.push(3)
            val result = applet_dd(src, 10, 5)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "handles zero count":
            step("Verify: handles zero count")
            # @req: REQ-OS-SimpApplCore-001
            var src: [u8] = []
            src.push(1)
            src.push(2)
            src.push(3)
            val result = applet_dd(src, 0, 0)
            expect(result.len()).to_equal(0)  # oracle: value fixed by the spec contract

    describe "applet_timeout_parse":
        it "parses plain digits as seconds":
            step("Verify: parses plain digits as seconds")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("5")).to_equal(5)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("123")).to_equal(123)  # oracle: value fixed by the spec contract

        it "parses seconds suffix":
            step("Verify: parses seconds suffix")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("5s")).to_equal(5)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("30s")).to_equal(30)  # oracle: value fixed by the spec contract

        it "parses minutes suffix":
            step("Verify: parses minutes suffix")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("2m")).to_equal(120)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("1m")).to_equal(60)  # oracle: value fixed by the spec contract

        it "parses hours suffix":
            step("Verify: parses hours suffix")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("1h")).to_equal(3600)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("2h")).to_equal(7200)  # oracle: value fixed by the spec contract

        it "returns -1 on invalid spec":
            step("Verify: returns -1 on invalid spec")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("")).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("5x")).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("abc")).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(applet_timeout_parse("5s5")).to_equal(-1)  # oracle: value fixed by the spec contract

        it "returns -1 when starting with non-digit":
            step("Verify: returns -1 when starting with non-digit")
            # @req: REQ-OS-SimpApplCore-001
            expect(applet_timeout_parse("s5")).to_equal(-1)  # oracle: value fixed by the spec contract

    describe "applet_chown_parse":
        it "parses uid:gid format":
            step("Verify: parses uid:gid format")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse("1000:1000")
            expect(req.uid).to_equal(1000)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(1000)  # oracle: value fixed by the spec contract
            expect(req.has_uid).to_equal(true)
            expect(req.has_gid).to_equal(true)

        it "parses uid only":
            step("Verify: parses uid only")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse("1000")
            expect(req.uid).to_equal(1000)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.has_uid).to_equal(true)
            expect(req.has_gid).to_equal(false)

        it "parses :gid only":
            step("Verify: parses :gid only")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse(":1000")
            expect(req.uid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(1000)  # oracle: value fixed by the spec contract
            expect(req.has_uid).to_equal(false)
            expect(req.has_gid).to_equal(true)

        it "parses empty spec":
            step("Verify: parses empty spec")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse("")
            expect(req.uid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.has_uid).to_equal(false)
            expect(req.has_gid).to_equal(false)

        it "parses multiple digits":
            step("Verify: parses multiple digits")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse("1234:5678")
            expect(req.uid).to_equal(1234)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(5678)  # oracle: value fixed by the spec contract

        it "parses just colon":
            step("Verify: parses just colon")
            # @req: REQ-OS-SimpApplCore-001
            val req = applet_chown_parse(":")
            expect(req.uid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.gid).to_equal(-1)  # oracle: value fixed by the spec contract
            expect(req.has_uid).to_equal(false)
            expect(req.has_gid).to_equal(false)
