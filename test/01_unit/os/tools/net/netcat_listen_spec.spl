# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/tools/net/netcat_tool.spl 40%
"""
# Netcat Listen Mode Specification

**Feature IDs:** #B5
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Compile-check that run_netcat correctly parses -l PORT into listen mode,
and that connect mode requires HOST and PORT.
"""
use std.spec.step

use std.spec.step

use std.spipe.*
use os.tools.net.netcat_tool.{run_netcat}


describe "run_netcat argument parsing":
    # @manual scenario evidence

    it "returns error when no args provided":
        # @req REQ-SSPEC-OS
        step("returns error when no args provided")
        val result = run_netcat([])
        expect(result).to_equal(1)

    it "accepts -l flag as first argument for listen mode":
        # @req REQ-SSPEC-OS
        step("accepts -l flag as first argument for listen mode")
        # We can only verify parse path without a real network;
        # passing -l with no port should return error code 1
        val result = run_netcat(["-l"])
        expect(result).to_equal(1)

    it "connect mode without port returns error":
        # @req REQ-SSPEC-OS
        step("connect mode without port returns error")
        val result = run_netcat(["somehost"])
        expect(result).to_equal(1)
