use std.spec
use std.spec.step
use os.tools.simplebox.simplebox_artifact_contract.{
    simplebox_artifact_contract_v1, simplebox_canonical_aliases_v1,
    simplebox_path_requires_loader_authority_v1, simplebox_resolve_canonical_path_v1,
    SIMPLEBOX_ARTIFACT_SCHEMA_V1, SIMPLEBOX_CANONICAL_PATH_V1
}
use os.services.launcher.primary_tool_artifact_gate.{
    primary_tool_path_requires_loader_authority_v1
}
use os.tools.simplebox.simplebox_dispatch.{simplebox_applet_names}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/tools/simplebox_artifact_contract_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/simplebox_artifact_contract_spec.md
# doc-path: doc/03_plan/sys_test/simplebox_artifact_contract_spec.md
# doc-path: doc/04_architecture/simplebox_artifact_contract_spec.md
# doc-path: doc/05_design/simplebox_artifact_contract_spec_oracles.md
# @manual: primary


describe "filesystem-launched simplebox admission contract":
    it "binds source entry applets and bounded file IO":
        step("Verify: binds source entry applets and bounded file IO")
        # @req: REQ-SSPEC-LOCAL-001
        val contract = simplebox_artifact_contract_v1()
        expect(contract.schema_version).to_equal(SIMPLEBOX_ARTIFACT_SCHEMA_V1)
        expect(contract.canonical_path).to_equal(SIMPLEBOX_CANONICAL_PATH_V1)
        expect(contract.entry_source_owner).to_equal("os.tools.simplebox.simplebox_main")
        expect(contract.entry_symbol).to_equal("main")
        expect(contract.applets).to_contain("cat")
        expect(contract.applets).to_contain("head")
        expect(contract.applets).to_contain("wc")
        expect(contract.max_files).to_equal(128)
        expect(contract.max_file_bytes).to_equal(67108864)
        expect(contract.read_chunk_bytes).to_equal(65536)
        expect(contract.requires_target_artifact).to_equal(true)
        expect(contract.requires_loader_authority_token).to_equal(true)

    it "uses the canonical dispatcher registry without artifact drift":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: uses the canonical dispatcher registry without artifact drift")
        val contract = simplebox_artifact_contract_v1()
        val registry = simplebox_applet_names()
        expect(contract.applets).to_equal(registry)

    it "requires loader authority for canonical and applet filesystem paths":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: requires loader authority for canonical and applet filesystem paths")
        expect(simplebox_path_requires_loader_authority_v1("/bin/simplebox")).to_equal(true)
        expect(simplebox_path_requires_loader_authority_v1("/bin/./cat")).to_equal(true)
        expect(simplebox_path_requires_loader_authority_v1("/bin/head")).to_equal(true)
        expect(simplebox_path_requires_loader_authority_v1("/bin/wc")).to_equal(true)
        expect(primary_tool_path_requires_loader_authority_v1("/bin/seq")).to_equal(true)
        expect(simplebox_canonical_aliases_v1()).to_equal(
            [
                "/bin/echo", "/bin/true", "/bin/false", "/bin/pwd",
                "/bin/seq", "/bin/cat", "/bin/head", "/bin/wc",
            ])

    it "does not capture relative or unrelated executable paths":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: does not capture relative or unrelated executable paths")
        expect(simplebox_path_requires_loader_authority_v1("cat")).to_equal(false)
        expect(simplebox_path_requires_loader_authority_v1("/usr/bin/clang")).to_equal(false)

    it "resolves bounded applet aliases to the one canonical filesystem artifact":
        expect(simplebox_resolve_canonical_path_v1("/bin/cat")).to_equal("/bin/simplebox")
        expect(simplebox_resolve_canonical_path_v1("/bin/./true")).to_equal("/bin/simplebox")
        expect(simplebox_resolve_canonical_path_v1("/usr/bin/clang")).to_equal("/usr/bin/clang")
