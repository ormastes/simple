"""simplebox entry point — proves it genuinely consumes the pure-Simple libc.

AC (simpleos-alpine-harden-musl-busybox): the simplebox userland binary must
actually call the pure-Simple libc, so packing it into the image wires the libc
in for real. seq's count is parsed by libc_strtoul; the whitespace-skip and
stop-at-non-digit cases below only pass if the libc parser (not open code) runs.
Dispatch routing (MDSOC+ router) is regression-guarded.

## Purpose and audience
Purpose: parses a plain decimal count
Audience: compiler and tooling engineers who maintain this spec

"""

# @req: REQ-OS-SimpMain-001

use std.spec
use os.tools.simplebox.simplebox_main.{simplebox_seq_count, simplebox_seq_plan, simplebox_run, SIMPLEBOX_SEQ_MAX_OUTPUT_BYTES, SIMPLEBOX_SEQ_MAX_COUNT, SIMPLEBOX_SEQ_MAX_PARSE_BYTES}

use std.spec.step
describe "simplebox entry (pure-Simple libc consumer)":
    context "seq output is preflighted against a fixed memory/time budget":
        it "preserves admitted output accounting":
            val plan = simplebox_seq_plan(["3"])
            expect(plan.accepted).to_equal(true)
            expect(plan.count).to_equal(3)
            expect(plan.output_bytes).to_equal(6)
            expect(plan.inspected_values).to_equal(3)

        it "rejects oversized output after bounded work":
            val plan = simplebox_seq_plan(["999999999999"])
            expect(plan.accepted).to_equal(false)
            expect(plan.output_bytes).to_equal(0)
            expect(plan.inspected_values).to_equal(0)
            expect(plan.inspected_input_bytes).to_be_less_than(6)

        it "rejects decimal strings that would wrap libc_strtoul":
            val positive_wrap = simplebox_seq_plan(["18446744073709551616"])
            expect(positive_wrap.accepted).to_equal(false)
            expect(positive_wrap.count).to_be_greater_than(SIMPLEBOX_SEQ_MAX_COUNT)
            expect(simplebox_run(["simplebox", "seq", "18446744073709551616"])).to_equal(1)
            val signed_wrap = simplebox_seq_plan(["9223372036854775808"])
            expect(signed_wrap.accepted).to_equal(false)
            val bounded_zeros = simplebox_seq_plan(["0".repeat(SIMPLEBOX_SEQ_MAX_PARSE_BYTES + 1)])
            expect(bounded_zeros.accepted).to_equal(false)

        it "preserves negative and stop-at-nondigit compatibility":
            val negative = simplebox_seq_plan(["-1"])
            expect(negative.accepted).to_equal(true)
            expect(negative.count).to_equal(-1)
            expect(negative.output_bytes).to_equal(0)
            expect(simplebox_run(["simplebox", "seq", "-1"])).to_equal(0)
            val suffix = simplebox_seq_plan(["3abc"])
            expect(suffix.accepted).to_equal(true)
            expect(suffix.count).to_equal(3)
            expect(suffix.output_bytes).to_equal(6)

        it "accepts the largest count under the cap and rejects the next":
            val exact = simplebox_seq_plan(["12773"])
            expect(exact.accepted).to_equal(true)
            expect(exact.count).to_equal(SIMPLEBOX_SEQ_MAX_COUNT)
            expect(exact.output_bytes).to_equal(65532)
            val over = simplebox_seq_plan(["12774"])
            expect(over.accepted).to_equal(false)

    context "seq count is parsed via the pure-Simple libc (libc_strtoul)":
        it "parses a plain decimal count":
            step("Verify: parses a plain decimal count")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_seq_count(["5"])).to_equal(5)  # oracle: value fixed by the spec contract
        it "skips leading whitespace (libc_strtoul behavior)":
            step("Verify: skips leading whitespace (libc_strtoul behavior)")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_seq_count(["  42"])).to_equal(42)  # oracle: value fixed by the spec contract
        it "stops at the first non-digit (libc_strtoul behavior)":
            step("Verify: stops at the first non-digit (libc_strtoul behavior)")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_seq_count(["3abc"])).to_equal(3)  # oracle: value fixed by the spec contract
        it "empty args yields 0":
            step("Verify: empty args yields 0")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_seq_count([])).to_equal(0)  # oracle: value fixed by the spec contract

    context "dispatch routing preserved (MDSOC+ stateless router)":
        it "true applet returns 0":
            step("Verify: true applet returns 0")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_run(["simplebox", "true"])).to_equal(0)  # oracle: value fixed by the spec contract
        it "false applet returns 1":
            step("Verify: false applet returns 1")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_run(["simplebox", "false"])).to_equal(1)  # oracle: value fixed by the spec contract
        it "unknown applet returns 127":
            step("Verify: unknown applet returns 127")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_run(["simplebox", "nope"])).to_equal(127)  # oracle: value fixed by the spec contract
        it "seq applet runs and returns 0":
            step("Verify: seq applet runs and returns 0")
            # @req: REQ-OS-SimpMain-001
            expect(simplebox_run(["simplebox", "seq", "3"])).to_equal(0)  # oracle: value fixed by the spec contract
