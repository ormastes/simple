# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT

use std.spec.{describe, it, expect}
use os.tools.pkg.pkg_builder.{readdir, _collect_files}
use os.tools.pkg.pkg_format.{ExtendedManifest, PackageType, PkgArch, InstallHooks}
use os.tools.pkg.pkg_manifest.{PackageManifest, PackageVersion}

fn empty_manifest() -> ExtendedManifest:
    ExtendedManifest(
        base: PackageManifest(name: "", version: PackageVersion(major: 0, minor: 0, patch: 0),
            description: "", dependencies: [], files: [], checksum: ""),
        pkg_type: PackageType.App,
        arch: PkgArch.Any,
        hooks: InstallHooks(pre_install: "", post_install: "", pre_remove: "", post_remove: ""),
        license: "", maintainer: "", homepage: "", installed_size: 0,
        provides: [], conflicts: [], replaces: [])

describe "package directory discovery":
    it "readdir returns Err for an unreadable directory":
        # @req REQ-SSPEC-UNIT
        val result = readdir("/nonexistent/simple-pkg-builder")
        expect(result.is_err()).to_equal(true)

    it "auto-discovery propagates the listing failure":
        # @req REQ-SSPEC-UNIT
        val result = _collect_files("/nonexistent/simple-pkg-builder", empty_manifest())
        expect(result.is_err()).to_equal(true)
