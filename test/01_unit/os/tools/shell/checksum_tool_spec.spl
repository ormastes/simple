use std.spec.*
use os.tools.shell.checksum.checksum_tool.{simpleos_checksum_digest_bytes}
use std.nogc_sync_mut.binary_io.{string_to_bytes}

describe "SimpleOS checksum tool cryptographic digests":
    it "matches the SHA-256 empty-message and abc known-answer vectors":
        val empty = simpleos_checksum_digest_bytes([], "sha256")
        expect(empty.is_ok()).to_be(true)
        expect(empty.unwrap()).to_equal(
            "e3b0c44298fc1c149afbf4c8996fb924" +
            "27ae41e4649b934ca495991b7852b855"
        )

        val abc = simpleos_checksum_digest_bytes(string_to_bytes("abc"), "sha256")
        expect(abc.is_ok()).to_be(true)
        expect(abc.unwrap()).to_equal(
            "ba7816bf8f01cfea414140de5dae2223" +
            "b00361a396177a9cb410ff61f20015ad"
        )

    it "matches the RFC 1321 MD5 abc vector":
        val digest = simpleos_checksum_digest_bytes(string_to_bytes("abc"), "md5")
        expect(digest.is_ok()).to_be(true)
        expect(digest.unwrap()).to_equal("900150983cd24fb0d6963f7d28e17f72")

    it "rejects unknown algorithms without producing a digest":
        val result = simpleos_checksum_digest_bytes([], "sha512")
        expect(result.is_err()).to_be(true)
        expect(result.unwrap_err()).to_equal("unsupported checksum algorithm: sha512")
