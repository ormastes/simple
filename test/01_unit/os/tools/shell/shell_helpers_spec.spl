use os.tools.shell.shell_helpers.{resolve_path, split_lines}

describe "shell tool helper behavior":
    it "normalizes relative absolute dot and parent components":
        expect(resolve_path("/work/tree", "file.txt")).to_equal("/work/tree/file.txt")
        expect(resolve_path("/work/tree", "../file.txt")).to_equal("/work/file.txt")
        expect(resolve_path("/work/tree", "./a//b/../c")).to_equal("/work/tree/a/c")
        expect(resolve_path("/work/tree", "/../../etc/config")).to_equal("/etc/config")

    it "preserves empty and trailing line segments":
        expect(split_lines("")).to_equal([""])
        expect(split_lines("a\n")).to_equal(["a", ""])
        expect(split_lines("a\n\nb")).to_equal(["a", "", "b"])
