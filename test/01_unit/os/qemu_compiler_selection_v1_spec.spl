"""Explicit compiler identity is authoritative at the OS build boundary.

These policy/refusal checks do not admit a compiler. The live CLI route spec
separately requires canonical provenance and an actual self-hosted candidate.
"""
use std.spec.{describe, it, expect, step}
use app.io.env_ops.{cwd}
use os.qemu_compiler_admission_v1.{
    qemu_compiler_explicit_candidate_v1, qemu_compiler_select_v1
}

describe "QEMU compiler selection preserves explicit identity":
    it "uses SIMPLE_BINARY before its SIMPLE_BIN alias":
        # @req: REQ-001 REQ-016
        step("Pin an explicit compiler while a different alias exists")
        expect(qemu_compiler_explicit_candidate_v1("/admitted/full/simple", "/other/simple")).to_equal("/admitted/full/simple")
        expect(qemu_compiler_explicit_candidate_v1("", "/admitted/full/simple")).to_equal("/admitted/full/simple")
        expect(qemu_compiler_explicit_candidate_v1("", "")).to_equal("")

    it "refuses a missing explicit compiler without probing a release or seed fallback":
        # @req: REQ-001 REQ-016
        step("Select an absent explicit compiler with an independently supplied alias")
        expect(qemu_compiler_select_v1("", "", "/missing/qemu-compiler-admission-root")).to_equal("")
        expect(qemu_compiler_select_v1(
            "/missing/qemu-explicit-compiler", "/other/compiler",
            cwd())).to_equal("")
