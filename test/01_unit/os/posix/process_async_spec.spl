# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/posix/process_async.spl 80%
"""
# Async Process Specification

Native SimpleOS process control is async-first. POSIX process wrappers block
over this request facade.
"""

use std.spec.step

use std.spec
use std.spec.step
use os.posix.errno.{EINVAL, EIO}
use os.posix.process_async.{

    PROCESS_MAX_REQUESTS,
    process_async_init,
    process_async_spawn,
    process_async_execve,
    process_async_signal,
    process_async_is_complete,
    process_async_result,
    process_async_free_request,
    process_wait_request
}

describe "process_async request lifecycle":
    # @manual scenario evidence
    it "completes invalid spawn paths without entering the syscall backend":
        # @req REQ-SSPEC-UNIT
        step("completes invalid spawn paths without entering the syscall backend")
        process_async_init()
        val req = process_async_spawn("", [], 2)

        expect(req).to_be_less_than(PROCESS_MAX_REQUESTS)
        expect(process_async_is_complete(req)).to_equal(true)
        expect(process_async_result(req)).to_equal(0 - EINVAL as i64)

        process_async_free_request(req)

    it "completes invalid exec paths without entering the syscall backend":
        # @req REQ-SSPEC-UNIT
        step("completes invalid exec paths without entering the syscall backend")
        process_async_init()
        val req = process_async_execve("", [], [])

        expect(req).to_be_less_than(PROCESS_MAX_REQUESTS)
        expect(process_async_is_complete(req)).to_equal(true)
        expect(process_async_result(req)).to_equal(0 - EINVAL as i64)

        process_async_free_request(req)

    it "completes invalid signal requests without entering the syscall backend":
        # @req REQ-SSPEC-UNIT
        step("completes invalid signal requests without entering the syscall backend")
        process_async_init()
        val req = process_async_signal(42u64, -1)

        expect(req).to_be_less_than(PROCESS_MAX_REQUESTS)
        expect(process_async_is_complete(req)).to_equal(true)
        expect(process_async_result(req)).to_equal(0 - EINVAL as i64)

        process_async_free_request(req)

    it "reports EIO for invalid request handles":
        # @req REQ-SSPEC-UNIT
        step("reports EIO for invalid request handles")
        expect(process_async_is_complete(PROCESS_MAX_REQUESTS)).to_equal(true)
        expect(process_async_result(PROCESS_MAX_REQUESTS)).to_equal(0 - EIO as i64)
        expect(process_wait_request(PROCESS_MAX_REQUESTS)).to_equal(0 - EIO as i64)
