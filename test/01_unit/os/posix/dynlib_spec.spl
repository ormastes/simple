# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/posix/dynlib.spl 80%
"""
# DynLibKind OOP Interface Specification

Verifies the unified DynLibKind enum dispatch layer over ELF, SMF, and PE
dynamic library formats, including validity checks, format naming, path
extraction, and error handling for Invalid variants.
"""

use std.spec.step

use std.spec
use std.spec.step
use os.posix.dynlib.{

    DynLibKind,
    ElfLibState,
    SmfLibState,
    PeLibState,
    dynlib_is_valid,
    dynlib_path,
    dynlib_format_name,
    dynlib_symbol,
    dynlib_symbol_is_process_callable,
    dynlib_close
}

describe "DynLibKind host formats":
    it "recognizes versioned ELF names":
        expect(dynlib_format_for_path("libc.so.7")).to_equal("elf")

    it "recognizes Mach-O dylibs":
        expect(dynlib_format_for_path("libSystem.dylib")).to_equal("macho")

    it "recognizes PE DLLs":
        expect(dynlib_format_for_path("kernel32.dll")).to_equal("pe")

    it "rejects the zero failure sentinel before constructing a valid variant":
        expect(dynlib_handle_is_valid(0)).to_equal(false)
        expect(dynlib_handle_is_valid(-1)).to_equal(false)
        expect(dynlib_handle_is_valid(1)).to_equal(true)

describe "DynLibKind.Elf":
    it "reports valid":
        # @req REQ-SSPEC-UNIT
        step("reports valid")
        val lib = DynLibKind.Elf(state: ElfLibState(
            handle: 1,
            base: 0,
            path: "/lib/libtest.so"
        ))
        expect(dynlib_is_valid(lib)).to_equal(true)

    it "returns correct format name":
        # @req REQ-SSPEC-UNIT
        step("returns correct format name")
        val lib = DynLibKind.Elf(state: ElfLibState(
            handle: 1,
            base: 0,
            path: "/lib/libtest.so"
        ))
        expect(dynlib_format_name(lib)).to_equal("ELF")

    it "returns correct path":
        # @req REQ-SSPEC-UNIT
        step("returns correct path")
        val lib = DynLibKind.Elf(state: ElfLibState(
            handle: 1,
            base: 0,
            path: "/lib/libtest.so"
        ))
        expect(dynlib_path(lib)).to_equal("/lib/libtest.so")

describe "DynLibKind.Smf":
    it "reports valid":
        # @req REQ-SSPEC-UNIT
        step("reports valid")
        val lib = DynLibKind.Smf(state: SmfLibState(
            handle: 2,
            path: "/lib/plugin.smf",
            stub_entry: 0
        ))
        expect(dynlib_is_valid(lib)).to_equal(true)

    it "returns correct format name":
        # @req REQ-SSPEC-UNIT
        step("returns correct format name")
        val lib = DynLibKind.Smf(state: SmfLibState(
            handle: 2,
            path: "/lib/plugin.smf",
            stub_entry: 0
        ))
        expect(dynlib_format_name(lib)).to_equal("SMF")

    it "returns correct path":
        # @req REQ-SSPEC-UNIT
        step("returns correct path")
        val lib = DynLibKind.Smf(state: SmfLibState(
            handle: 2,
            path: "/lib/plugin.smf",
            stub_entry: 0
        ))
        expect(dynlib_path(lib)).to_equal("/lib/plugin.smf")

describe "DynLibKind.Pe":
    it "reports valid":
        # @req REQ-SSPEC-UNIT
        step("reports valid")
        val lib = DynLibKind.Pe(state: PeLibState(
            handle: 3,
            path: "kernel32.dll",
            base: 0,
            image_size: 0
        ))
        expect(dynlib_is_valid(lib)).to_equal(true)

    it "returns correct format name":
        # @req REQ-SSPEC-UNIT
        step("returns correct format name")
        val lib = DynLibKind.Pe(state: PeLibState(
            handle: 3,
            path: "kernel32.dll",
            base: 0,
            image_size: 0
        ))
        expect(dynlib_format_name(lib)).to_equal("PE")

    it "returns correct path":
        # @req REQ-SSPEC-UNIT
        step("returns correct path")
        val lib = DynLibKind.Pe(state: PeLibState(
            handle: 3,
            path: "kernel32.dll",
            base: 0,
            image_size: 0
        ))
        expect(dynlib_path(lib)).to_equal("kernel32.dll")

describe "DynLibKind.Invalid":
    it "reports not valid":
        # @req REQ-SSPEC-UNIT
        step("reports not valid")
        val lib = DynLibKind.Invalid
        expect(dynlib_is_valid(lib)).to_equal(false)

    it "returns empty path":
        # @req REQ-SSPEC-UNIT
        step("returns empty path")
        val lib = DynLibKind.Invalid
        expect(dynlib_path(lib)).to_equal("")

    it "returns Invalid format name":
        # @req REQ-SSPEC-UNIT
        step("returns Invalid format name")
        val lib = DynLibKind.Invalid
        expect(dynlib_format_name(lib)).to_equal("Invalid")

    it "dynlib_symbol returns negative for Invalid":
        # @req REQ-SSPEC-UNIT
        step("dynlib_symbol returns negative for Invalid")
        val lib = DynLibKind.Invalid
        val result = dynlib_symbol(lib, "anything")
        expect(result < 0).to_equal(true)

    it "dynlib_symbol_is_process_callable returns false for Invalid":
        # @req REQ-SSPEC-UNIT
        step("dynlib_symbol_is_process_callable returns false for Invalid")
        val lib = DynLibKind.Invalid
        expect(dynlib_symbol_is_process_callable(lib, "anything")).to_equal(false)

    it "dynlib_close returns negative for Invalid":
        # @req REQ-SSPEC-UNIT
        step("dynlib_close returns negative for Invalid")
        val lib = DynLibKind.Invalid
        val result = dynlib_close(lib)
        expect(result < 0).to_equal(true)
