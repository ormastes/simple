use std.spec.{describe, it, expect}
use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_QUERY_V1_SIZE,
    SimpleProviderQueryV1
}
use os.posix.dynlib_sffi.{call_provider_query_v1}

fn valid_request() -> SimpleProviderQueryV1:
    SimpleProviderQueryV1(
        descriptor_size: SIMPLE_PROVIDER_QUERY_V1_SIZE,
        interface_id: 5999723006133093425,
        minimum_major: 1,
        minimum_minor: 0,
        host_abi: 1,
        target_offset: 0,
        target_length: 0,
        requested_capability_bits: 0
    )

describe "exact provider query call boundary":
    it "rejects a malformed request before allocating or invoking":
        var request = valid_request()
        request.descriptor_size = 0
        val result = call_provider_query_v1(4096, request)
        expect(result.ok).to_equal(false)
        expect(result.diagnostic).to_equal("request-descriptor-size-invalid")

    it "rejects a null function pointer before allocating or invoking":
        val result = call_provider_query_v1(0, valid_request())
        expect(result.ok).to_equal(false)
        expect(result.diagnostic).to_equal("provider-query-pointer-invalid")
