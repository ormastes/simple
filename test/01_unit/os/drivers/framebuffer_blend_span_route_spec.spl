use std.spec.{describe, it, expect}

extern fn rt_fs_read_text(path: text) -> text?

describe "bare framebuffer blend-span routing":
    it "uses one validated direct-LFB call and fails open on unsupported arches":
        val surface = rt_fs_read_text(
            "src/lib/gc_async_mut/gpu/engine2d/framebuffer_surface.spl") ?? ""
        val driver = rt_fs_read_text(
            "src/os/drivers/framebuffer/fb_driver.spl") ?? ""
        val x86 = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c") ?? ""
        val arm = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c") ?? ""
        val riscv = rt_fs_read_text(
            "src/os/kernel/arch/riscv64/boot/freestanding_runtime.c") ?? ""
        expect(surface).to_contain("framebuffer_blend_span_argb")
        expect(driver).to_contain("rt_gui_blend_span4(")
        expect(driver).to_contain("self.host_buffer = rt_engine2d_simd_blend_span_u32(")
        expect(driver).to_contain("self.back_buffer = rt_engine2d_simd_blend_span_u32(")
        expect(x86).to_contain("RuntimeValue rt_gui_blend_span4(")
        expect(x86).to_contain("src_offset > (int64_t)src->len")
        expect(x86).to_contain("count > (int64_t)src->len - src_offset")
        expect(x86).to_contain("dst[i] = gui_blend_argb(source, dst[i])")
        expect(arm).to_contain("RuntimeValue rt_gui_blend_span4(")
        expect(riscv).to_contain("spl_u64 rt_gui_blend_span4(")
        expect(riscv).to_contain("return 0ULL")
