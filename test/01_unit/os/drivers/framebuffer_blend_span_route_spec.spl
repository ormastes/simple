use std.spec.{describe, it, expect}

extern fn rt_fs_read_text(path: text) -> text?

describe "bare framebuffer blend-span routing":
    it "uses one validated direct-LFB call and fails open on unsupported arches":
        val surface = rt_fs_read_text(
            "src/lib/gc_async_mut/gpu/engine2d/framebuffer_surface.spl") ?? ""
        val driver = rt_fs_read_text(
            "src/os/drivers/framebuffer/fb_driver.spl") ?? ""
        val x86 = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c") ?? ""
        val arm = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c") ?? ""
        val x86_optional = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_optional_backends.c") ?? ""
        val x86_contract = rt_fs_read_text(
            "examples/09_embedded/simple_os/arch/x86_64/boot/direct_lfb_blend_span.h") ?? ""
        val riscv = rt_fs_read_text(
            "src/os/kernel/arch/riscv64/boot/freestanding_runtime.c") ?? ""
        expect(surface).to_contain("framebuffer_blend_span_argb")
        expect(driver).to_contain("rt_gui_blend_span8(")
        expect(driver).to_contain("self.front_addr, self.width, self.height, self.pitch, xy, src,")
        expect(driver).to_contain("self.host_buffer = rt_engine2d_simd_blend_span_u32(")
        expect(driver).to_contain("self.back_buffer = rt_engine2d_simd_blend_span_u32(")
        expect(x86).to_contain("#define SIMPLEOS_DEFINE_RT_GUI_BLEND_SPAN8 1")
        expect(x86_contract).to_contain("RuntimeValue rt_gui_blend_span8(RuntimeValue framebuffer_addr,")
        expect(x86_contract).to_contain("(uint64_t)framebuffer_addr != registered_addr")
        expect(x86_contract).to_contain("(uint64_t)n > a->len - (uint64_t)off")
        expect(x86_contract).to_contain("(uint64_t)n > (uint64_t)registered_width - x")
        expect(x86_contract).to_contain("if (alpha == 0u) continue")
        expect(x86_contract).to_contain("if (alpha == 255u)")
        expect(x86_optional.contains("int64_t rt_gui_blend_span8(")).to_equal(false)
        expect(arm).to_contain("RuntimeValue rt_gui_blend_span8(")
        expect(riscv).to_contain("spl_u64 rt_gui_blend_span8(")
        expect(riscv).to_contain("return 0ULL")
