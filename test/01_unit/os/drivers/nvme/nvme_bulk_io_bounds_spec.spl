use std.spec.{describe, it, expect}
use os.drivers.nvme._NvmeDriver.bulk_io.{
    nvme_4k_lba_range_reason,
    nvme_4k_batch_byte_len,
    nvme_4k_dma_slot_addr
}

describe "NVMe 4K bulk I/O bounds":
    it "checks LBA ranges without overflowing the end address":
        expect(nvme_4k_lba_range_reason(8u64, 8u32, 16u64)).to_equal("ready")
        expect(nvme_4k_lba_range_reason(18446744073709551615u64, 1u32, 18446744073709551615u64)).to_equal("NVMe: 4K operation beyond namespace capacity")

    it "rejects overflowing batch byte lengths":
        val maximum_count = 18446744073709551615u64 / 4096u64
        expect(nvme_4k_batch_byte_len(maximum_count).unwrap()).to_equal(maximum_count * 4096u64)
        expect(nvme_4k_batch_byte_len(maximum_count + 1u64).unwrap_err()).to_equal("NVMe: 4K batch byte length overflow")

    it "rejects DMA slot address wraparound":
        expect(nvme_4k_dma_slot_addr(0x1000u64, 2u64).unwrap()).to_equal(0x3000u64)
        expect(nvme_4k_dma_slot_addr(18446744073709551615u64, 1u64).unwrap_err()).to_equal("NVMe: 4K batch DMA address overflow")
