# @req: REQ-OS-DRIVERS-001

use std.spec.{describe, it, expect}
use os.drivers.nvme.nvme_controller_contract.{
    NvmeControllerRegs,
    nvme_cap_doorbell_stride_bytes,
    nvme_cap_dstrd,
    nvme_cap_mq_entries,
    nvme_cap_timeout_ms,
    nvme_controller_enable_cc,
    nvme_controller_facts,
    nvme_controller_refusal_reason,
    nvme_lba_size_from_flbas_and_lbaf0,
    nvme_namespace_facts,
    nvme_namespace_refusal_reason
}

use std.spec.step

describe "NVMe controller contract":
    it "decodes q35 CAP fields without relying on the C bridge":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: decodes q35 CAP fields without relying on the C bridge")
        val q35_cap = 0x4018200f0107ffu64
        expect(nvme_cap_dstrd(q35_cap)).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(nvme_cap_mq_entries(q35_cap)).to_equal(2048)  # oracle: 2048 — named expected value from the requirement
        expect(nvme_cap_doorbell_stride_bytes(q35_cap)).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(nvme_cap_timeout_ms(q35_cap)).to_equal(60000)  # oracle: 60000 — named expected value from the requirement

        val regs = NvmeControllerRegs(
            cap: q35_cap,
            vs: 0x00010300u32,
            cc: 0u32,
            csts: 0u32
        )
        val facts = nvme_controller_facts(regs, 64u32)
        expect(facts.valid).to_equal(true)
        expect(facts.supports_required_queue).to_equal(true)
        expect(facts.supports_nvm_command_set).to_equal(true)
        expect(facts.fatal).to_equal(false)
        expect(nvme_controller_refusal_reason(facts)).to_equal("ready")

    it "builds the required controller enable value for NVM with 64B SQ and 16B CQ":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: builds the required controller enable value for NVM with 64B SQ and 16B CQ")
        val cc = nvme_controller_enable_cc()
        expect((cc & 1u32) != 0u32).to_equal(true)
        expect(((cc >> 16) & 0x0Fu32)).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(((cc >> 20) & 0x0Fu32)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "rejects fatal or undersized controllers instead of reporting fallback success":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects fatal or undersized controllers instead of reporting fallback success")
        val fatal = nvme_controller_facts(
            NvmeControllerRegs(cap: 0x4018200f0107ffu64, vs: 0x00010300u32, cc: 0u32, csts: 2u32),
            64u32
        )
        expect(fatal.valid).to_equal(false)
        expect(nvme_controller_refusal_reason(fatal)).to_equal("nvme-controller-fatal")

        val too_small = nvme_controller_facts(
            NvmeControllerRegs(cap: 0x0000000000000001u64, vs: 0x00010300u32, cc: 0u32, csts: 0u32),
            64u32
        )
        expect(too_small.valid).to_equal(false)
        expect(nvme_controller_refusal_reason(too_small)).to_equal("nvme-missing-nvm-command-set")

    it "derives namespace LBA size and refuses unsupported formats":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: derives namespace LBA size and refuses unsupported formats")
        val lbaf0_512 = 9u32 << 16
        expect(nvme_lba_size_from_flbas_and_lbaf0(0u8, lbaf0_512)).to_equal(512)  # oracle: 512 — named expected value from the requirement
        val ns = nvme_namespace_facts(1u32, 8192u64, 0u8, lbaf0_512)
        expect(ns.usable).to_equal(true)
        expect(ns.formatted_lba_size).to_equal(512)  # oracle: 512 — named expected value from the requirement

        val missing = nvme_namespace_facts(1u32, 0u64, 0u8, lbaf0_512)
        expect(missing.usable).to_equal(false)
        expect(nvme_namespace_refusal_reason(missing)).to_equal("nvme-namespace-empty")
        expect(nvme_namespace_refusal_reason(ns)).to_equal("ready")
        expect(nvme_lba_size_from_flbas_and_lbaf0(1u8, lbaf0_512)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects namespace identify data that would otherwise fall back to fake 512 byte sectors":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects namespace identify data that would otherwise fall back to fake 512 byte sectors")
        val bad_lbads = 8u32 << 16
        val bad = nvme_namespace_facts(1u32, 8192u64, 0u8, bad_lbads)
        expect(bad.usable).to_equal(false)
        expect(nvme_namespace_refusal_reason(bad)).to_equal("nvme-namespace-invalid-lba-size")
