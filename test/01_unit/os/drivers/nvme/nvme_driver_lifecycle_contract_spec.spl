use std.spec.{describe, it, expect}
use os.drivers.nvme.nvme_driver.{
    nvme_next_device_generation,
    nvme_reset_serialization_blocker,
    nvme_reset_serialized_with_io
}

describe "NVMe driver lifecycle contract":
    it "advances the process generation without wrapping":
        expect(nvme_next_device_generation(0u64).unwrap()).to_equal(1u64)
        expect(nvme_next_device_generation(41u64).unwrap()).to_equal(42u64)

    it "rejects exhausted generation state":
        val exhausted = nvme_next_device_generation(18446744073709551615u64)
        expect(exhausted.is_err()).to_be(true)
        expect(exhausted.unwrap_err()).to_equal("NVMe: device generation exhausted")

    it "keeps durable promotion closed without a real SimpleOS exclusion provider":
        expect(nvme_reset_serialized_with_io()).to_be(false)
        expect(nvme_reset_serialization_blocker()).to_equal("missing-simpleos-atomic-compare-exchange-or-scheduler-exclusion")
