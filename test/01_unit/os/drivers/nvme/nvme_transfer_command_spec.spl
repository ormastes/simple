# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use os.drivers.nvme.nvme_transfer_types.{NvmeNamespaceId, NvmeLba, NvmeSectorCount, NvmeNamespaceSectors}
use os.drivers.nvme.nvme_transfer_command.{

    NVME_TRANSFER_OPCODE_READ,
    NVME_TRANSFER_OPCODE_WRITE,
    nvme_io_lba_range_reason,
    nvme_io_status_code,
    nvme_read_io_command,
    nvme_read_io_command_for_namespace,
    nvme_write_io_command,
    nvme_write_io_command_for_namespace,
    nvme_flush_io_command,
    nvme_flush_io_command_for_namespace
}

describe "NVMe transfer command":
    # @manual scenario evidence
    it "builds read and write commands without syscall or C bridge state":
        # @req REQ-SSPEC-UNIT
        step("builds read and write commands without syscall or C bridge state")
        val read = nvme_read_io_command(NvmeLba(value: 0x100000002u64), NvmeSectorCount(value: 8u32), 0x200000u64, NvmeNamespaceSectors(value: 0x100000100u64)).unwrap()
        expect(read.opcode).to_equal(NVME_TRANSFER_OPCODE_READ)
        expect(read.nsid.value).to_equal(1u32)
        expect(read.prp1).to_equal(0x200000u64)
        expect(read.cdw10).to_equal(2u32)
        expect(read.cdw11).to_equal(1u32)
        expect(read.cdw12).to_equal(7u32)

        val write = nvme_write_io_command(NvmeLba(value: 4u64), NvmeSectorCount(value: 1u32), 0x300000u64, NvmeNamespaceSectors(value: 16u64)).unwrap()
        expect(write.opcode).to_equal(NVME_TRANSFER_OPCODE_WRITE)
        expect(write.cdw12).to_equal(0u32)

    it "builds namespace-aware read and write commands for assigned namespaces":
        # @req REQ-SSPEC-UNIT
        step("builds namespace-aware read and write commands for assigned namespaces")
        val read = nvme_read_io_command_for_namespace(NvmeNamespaceId(value: 7u32), NvmeLba(value: 4u64), NvmeSectorCount(value: 2u32), 0x200000u64, NvmeNamespaceSectors(value: 16u64)).unwrap()
        expect(read.opcode).to_equal(NVME_TRANSFER_OPCODE_READ)
        expect(read.nsid.value).to_equal(7u32)
        expect(read.cdw12).to_equal(1u32)

        val write = nvme_write_io_command_for_namespace(NvmeNamespaceId(value: 9u32), NvmeLba(value: 8u64), NvmeSectorCount(value: 1u32), 0x300000u64, NvmeNamespaceSectors(value: 16u64)).unwrap()
        expect(write.opcode).to_equal(NVME_TRANSFER_OPCODE_WRITE)
        expect(write.nsid.value).to_equal(9u32)
        expect(write.cdw12).to_equal(0u32)

    it "rejects unsafe ranges before command submission":
        # @req REQ-SSPEC-UNIT
        step("rejects unsafe ranges before command submission")
        expect(nvme_read_io_command_for_namespace(NvmeNamespaceId(value: 0u32), NvmeLba(value: 0u64), NvmeSectorCount(value: 1u32), 0x200000u64, NvmeNamespaceSectors(value: 16u64)).unwrap_err()).to_equal("nvme-io-namespace-zero")
        expect(nvme_io_lba_range_reason(NvmeLba(value: 0u64), NvmeSectorCount(value: 0u32), NvmeNamespaceSectors(value: 16u64))).to_equal("nvme-io-zero-sector-count")
        expect(nvme_io_lba_range_reason(NvmeLba(value: 0u64), NvmeSectorCount(value: 65537u32), NvmeNamespaceSectors(value: 70000u64))).to_equal("nvme-io-sector-count-too-large")
        expect(nvme_io_lba_range_reason(NvmeLba(value: 15u64), NvmeSectorCount(value: 2u32), NvmeNamespaceSectors(value: 16u64))).to_equal("nvme-io-beyond-namespace-capacity")
        expect(nvme_read_io_command(NvmeLba(value: 0u64), NvmeSectorCount(value: 1u32), 0u64, NvmeNamespaceSectors(value: 16u64)).unwrap_err()).to_equal("nvme-io-dma-buffer-zero")

    it "shares flush command and completion status decoding":
        # @req REQ-SSPEC-UNIT
        step("shares flush command and completion status decoding")
        val flush = nvme_flush_io_command()
        expect(flush.opcode).to_equal(0u8)
        expect(flush.nsid.value).to_equal(1u32)
        val ns_flush = nvme_flush_io_command_for_namespace(NvmeNamespaceId(value: 7u32)).unwrap()
        expect(ns_flush.opcode).to_equal(0u8)
        expect(ns_flush.nsid.value).to_equal(7u32)
        expect(nvme_flush_io_command_for_namespace(NvmeNamespaceId(value: 0u32)).unwrap_err()).to_equal("nvme-io-namespace-zero")
        expect(nvme_io_status_code(0u32)).to_equal(0u32)
        expect(nvme_io_status_code(4u32 << 17)).to_equal(4u32)
