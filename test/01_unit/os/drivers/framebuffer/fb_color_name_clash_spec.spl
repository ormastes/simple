use std.spec.{describe, it, expect}
use os.drivers.framebuffer.fb_driver.{FbColor}
use common.color.types.{Color}

extern fn rt_fs_read_text(path: text) -> text?

fn _src(path: text) -> text:
    rt_fs_read_text(path) ?? ""

describe "framebuffer Color short-name clash":
    it "declares the framebuffer type as FbColor, not Color":
        val driver = _src("src/os/drivers/framebuffer/fb_driver.spl")
        expect(driver).to_contain("struct FbColor:")
        var bare = false
        for line in driver.split("\n"):
            if line.starts_with("struct Color:"):
                bare = true
        expect(bare).to_equal(false)

    it "no importer still uses the bare or aliased Color":
        val files = [
            "src/os/compositor/decorations.spl",
            "src/os/compositor/fb_backend.spl",
            "src/os/compositor/compositor.spl",
            "src/os/services/display/display_service.spl",
            "src/os/services/wm/wm_host_2d_simpleos.spl",
            "src/app/wm_compare_host/fb_driver.spl",
            "src/app/wm_compare/backend_parity.spl"]
        for f in files:
            val s = _src(f)
            expect(s.contains("fb_driver.{Color")).to_equal(false)
            expect(s.contains("Color as FbColor")).to_equal(false)
            expect(s.contains(", Color}")).to_equal(false)

    it "FbColor.rgb builds the expected channels alongside common Color":
        val c = FbColor.rgb(17, 31, 47)
        expect(c.r).to_equal(17)
        expect(c.g).to_equal(31)
        expect(c.b).to_equal(47)
        expect(c.a).to_equal(255)
