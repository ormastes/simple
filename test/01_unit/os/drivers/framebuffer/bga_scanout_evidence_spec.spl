"""
## Purpose and audience
Freezes the BGA scanout-evidence contract of
src/os/drivers/framebuffer/bga_init.spl for the SimpleOS display-driver
owners: the scanout evidence a bootloader hands the kernel (address, width,
height, stride, pixel format, generation) must stay complete, hardware
truthful, and versioned, and the QEMU data-port path must keep its aligned
word protocol without the legacy 0x01CF status port. Source-contract
scenarios read the shipped driver text and mediate each text assertion
through a genuinely-named contract local; behavioural scenarios drive the
real scanout_evidence_* API.
## Operator workflow
src/compiler_rust/target/bootstrap/simple run test/01_unit/os/drivers/framebuffer/bga_scanout_evidence_spec.spl
## Compatibility and limitations
The PCI MMIO scenario is RED on the current tree because the driver text
drifted from the frozen BAR fragments; that RED is the oracle, not a defect
of this spec. Requires a full pure-Simple CLI with file_read access to src/.
## Verification guidance and troubleshooting
A failure in the API scenarios means the evidence record or its validation
changed shape; a failure in a source-contract scenario means the driver lost
a frozen hardware protocol fragment and the kernel scanout handoff is at risk.
"""
# Lifecycle: doc/01_research/os/driver/framebuffer_smf_completion_2026-04-16.md ;
# doc/03_plan/sys_test/gpu_renderer_processing_backends.md ;
# doc/04_architecture/gpu_renderer_processing_backends_metal.md ;
# doc/05_design/gpu_renderer_processing_backends_metal.md
# @manual_section: bga-scanout-evidence

use std.spec
use std.spec.step
use os.drivers.framebuffer.bga_init.{ScanoutEvidence, scanout_evidence_from_framebuffer, scanout_evidence_is_valid, scanout_pixel_format, scanout_stride_pixels}
use app.io.mod.{file_read}
use os.kernel.boot.ports.{FramebufferInfo}
use os.kernel.types.memory_types.{PhysAddr}


describe "BGA scanout evidence":
    it "uses QEMU's aligned word data port and retains hardware readback":
        # @req REQ-BGA-SCANOUT-WORD-PORT-001
        step("Read the shipped BGA driver text and pin the word-data-port protocol")
        val bga_driver_text = file_read("src/os/drivers/framebuffer/bga_init.spl")
        # @capture: evidence_manifest("bga_word_port_contract") -> bga_scanout_evidence_spec.evidence.sdn
        val keeps_aligned_word_data_port = bga_driver_text.contains("port_outw(0x01D0, value)")
        expect(keeps_aligned_word_data_port).to_be(true)
        val keeps_word_readback = bga_driver_text.contains("port_inw(0x01D0)")
        expect(keeps_word_readback).to_be(true)
        expect(bga_driver_text).to_contain("val active_width = bga_read(0x01)")
        expect(bga_driver_text).to_contain("val active_height = bga_read(0x02)")
        val rejects_legacy_0x01cf_status_port = bga_driver_text.contains("port_inw(0x01CF)")
        expect(rejects_legacy_0x01cf_status_port).to_be(false)

    it "prefers the discovered PCI MMIO register BAR for stdvga":
        # @req REQ-BGA-SCANOUT-PCI-BAR-002
        step("Pin the PCI BAR discovery and MMIO register read fragments in the driver text")
        val bga_driver_text = file_read("src/os/drivers/framebuffer/bga_init.spl")
        # @capture: evidence_manifest("bga_pci_mmio_bar_contract") -> bga_scanout_evidence_spec.evidence.sdn
        val keeps_pci_bar_probe = bga_driver_text.contains("pci_config_read32(0, dev, 0, 0x18)")
        expect(keeps_pci_bar_probe).to_be(true)
        val keeps_mmio_indexed_read = bga_driver_text.contains("mmio_bar + 0x0500 + index.to_u64() * 2")
        expect(keeps_mmio_indexed_read).to_be(true)
        expect(bga_driver_text).to_contain("bga_mmio_read(mmio_bar, 0x01)")
        val keeps_framebuffer_bar_handoff = bga_driver_text.contains("addr: PhysAddr(addr: pci_device.framebuffer_bar)")
        expect(keeps_framebuffer_bar_handoff).to_be(true)
        val keeps_u32_mmio_cast = bga_driver_text.contains("bga_mmio_read(mmio_bar, 0x01) as u32")
        expect(keeps_u32_mmio_cast).to_be(true)

    it "preserves initialized framebuffer metadata and generation":
        # @req REQ-BGA-SCANOUT-METADATA-003
        step("Build a 1280x720 QEMU framebuffer info and convert it to scanout evidence")
        val fb = FramebufferInfo(
            addr: PhysAddr(addr: 0xFD000000),
            width: 1280,
            height: 720,
            pitch: 5120,
            bpp: 32
        )
        val evidence = scanout_evidence_from_framebuffer(fb, 7)

        # @capture: evidence_manifest("bga_metadata_roundtrip") -> bga_scanout_evidence_spec.evidence.sdn
        expect(evidence.address).to_equal(0xFD000000)  # oracle: the QEMU stdvga framebuffer bar used across the OS lanes
        expect(evidence.width).to_equal(1280)  # oracle: 720p width as constructed above
        expect(evidence.height).to_equal(720)  # oracle: 720p height as constructed above
        expect(evidence.stride).to_equal(5120)  # oracle: pitch bytes for 1280 argb8888 pixels
        expect(evidence.pixel_format).to_equal("argb8888")  # oracle: 32 bpp maps to argb8888
        expect(evidence.generation).to_equal(7)  # oracle: generation passed through unchanged

    it "maps supported BGA depths to explicit pixel formats":
        # @req REQ-BGA-SCANOUT-PIXEL-FORMAT-004
        step("Resolve the pixel format for each BGA-supported depth")
        # @capture: evidence_manifest("bga_depth_format_table") -> bga_scanout_evidence_spec.evidence.sdn
        expect(scanout_pixel_format(32)).to_equal("argb8888")  # oracle: 32 bpp is 8-8-8-8 argb
        expect(scanout_pixel_format(24)).to_equal("rgb888")  # oracle: 24 bpp is 8-8-8 rgb without alpha
        expect(scanout_pixel_format(16)).to_equal("rgb565")  # oracle: 16 bpp is 5-6-5 rgb
        expect(scanout_pixel_format(8)).to_equal("unknown")  # oracle: 8 bpp has no explicit format mapping

    it "derives pixel pitch from padded byte stride":
        # @req REQ-BGA-SCANOUT-STRIDE-005
        step("Derive stride pixels from a padded 16-byte stride on a 3-pixel row")
        val evidence = ScanoutEvidence(address: 4096, width: 3, height: 2, stride: 16, pixel_format: "argb8888", generation: 1)
        # @capture: evidence_manifest("bga_stride_pixels") -> bga_scanout_evidence_spec.evidence.sdn
        expect(scanout_stride_pixels(evidence)).to_equal(4)  # oracle: 16 bytes / 4 bytes-per-pixel argb8888
        expect(scanout_evidence_is_valid(evidence)).to_be(true)

    it "rejects incomplete, undersized, and unsupported metadata":
        # @req REQ-BGA-SCANOUT-VALIDATION-006
        step("Offer four corrupted evidence records to the validator and require rejection")
        val missing_address = ScanoutEvidence(address: 0, width: 3, height: 2, stride: 16, pixel_format: "argb8888", generation: 1)
        val undersized = ScanoutEvidence(address: 4096, width: 5, height: 2, stride: 16, pixel_format: "argb8888", generation: 1)
        val unsupported = ScanoutEvidence(address: 4096, width: 3, height: 2, stride: 12, pixel_format: "rgb888", generation: 1)
        val stale = ScanoutEvidence(address: 4096, width: 3, height: 2, stride: 12, pixel_format: "argb8888", generation: 0)

        # @capture: evidence_manifest("bga_validation_rejections") -> bga_scanout_evidence_spec.evidence.sdn
        expect(scanout_evidence_is_valid(missing_address)).to_be(false)
        expect(scanout_evidence_is_valid(undersized)).to_be(false)
        expect(scanout_evidence_is_valid(unsupported)).to_be(false)
        expect(scanout_evidence_is_valid(stale)).to_be(false)
