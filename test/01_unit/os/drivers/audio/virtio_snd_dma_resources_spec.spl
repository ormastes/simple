use spec
use os.drivers.virtio.virtio_snd_dma_resources.{
    VirtioSndDmaResources,
    VIRTIO_SND_PCM_OFFSET,
    virtio_snd_dma_resources_valid,
    virtio_snd_dma_queue,
    virtio_snd_dma_cpu_address,
    virtio_snd_dma_device_address
}

describe "VirtIO sound DMA resource layout":
    it "keeps CPU and device ring addresses distinct":
        val resources = VirtioSndDmaResources(handle: 3, cpu_base: 0x10000u64, device_base: 0x90000u64)
        val queue = virtio_snd_dma_queue(resources, 2u32)
        expect(virtio_snd_dma_resources_valid(resources)).to_be(true)
        expect(queue.desc_cpu).to_equal(0x10400u64)
        expect(queue.desc).to_equal(0x90400u64)
        expect(queue.avail_cpu).to_equal(0x10480u64)
        expect(queue.used).to_equal(0x904C0u64)

    it "bounds queue indices and buffer offsets":
        val resources = VirtioSndDmaResources(handle: 3, cpu_base: 0x10000u64, device_base: 0x90000u64)
        expect(virtio_snd_dma_queue(resources, 4u32).size).to_equal(0u16)
        expect(virtio_snd_dma_cpu_address(resources, VIRTIO_SND_PCM_OFFSET)).to_equal(0x11000u64)
        expect(virtio_snd_dma_device_address(resources, VIRTIO_SND_PCM_OFFSET)).to_equal(0x91000u64)
        expect(virtio_snd_dma_cpu_address(resources, -1)).to_equal(0u64)

    it "rejects unaligned or absent allocations":
        val absent = VirtioSndDmaResources(handle: -1, cpu_base: 0u64, device_base: 0u64)
        val unaligned = VirtioSndDmaResources(handle: 1, cpu_base: 0x10001u64, device_base: 0x90000u64)
        expect(virtio_snd_dma_resources_valid(absent)).to_be(false)
        expect(virtio_snd_dma_resources_valid(unaligned)).to_be(false)
