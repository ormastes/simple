# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @req REQ-SSPEC-OS REQ-SSPEC-OS
use std.spec.step

use std.spec.*
use std.common.audio.pcm_i16.{pcm_i16_pack_4}

describe "HDA application PCM packing":
    # @manual scenario evidence
    it "packs four signed 16-bit samples into one scalar DMA store":
        # @req REQ-SSPEC-OS
        step("packs four signed 16-bit samples into one scalar DMA store")
        expect(pcm_i16_pack_4(32767, -32768, 1, -1)).to_equal(-281468534226945)
        expect(pcm_i16_pack_4(0, 0, 0, 0)).to_equal(0)

    it "clamps samples before packing":
        # @req REQ-SSPEC-OS
        step("clamps samples before packing")
        expect(pcm_i16_pack_4(40000, -40000, 0, 0)).to_equal(2147516415)
