use os.kernel.boot.mmio.{
    mmio_reset_for_test,
    mmio_write16,
    mmio_write32,
    mmio_read32,
}
use os.drivers.audio.hda_controller.{
    HdaController,
    hda_output_stream_id_at,
}

val BAR0: i64 = 0x1000
val CORB_DMA: i64 = 0x200000
val RIRB_DMA: i64 = 0x201000

fn main() -> i64:
    mmio_reset_for_test()
    mmio_write16((BAR0 + 0x0E) as u64, 1u16)
    mmio_write32(RIRB_DMA as u64, 0x10EC0892u32)
    var controller = HdaController.create(
        BAR0, 11, CORB_DMA, RIRB_DMA
    )
    controller.initialize()
    if not controller.initialized:
        return 1

    mmio_write16((BAR0 + 0x00) as u64, 0x0200u16)
    val stream_id = hda_output_stream_id_at(BAR0)
    if stream_id != 2:
        return 2
    controller.configure_stream(stream_id, 0x300000, 0x0011u16)
    if (mmio_read32((BAR0 + 0x20) as u64) & (1u32 << 2)) == 0u32:
        return 3

    controller.start_stream(stream_id)
    controller.start_stream(stream_id)
    val stream_ctl = mmio_read32((BAR0 + 0xC0) as u64)
    if (controller.stream_count != 1 or
        (stream_ctl & 0x02u32) == 0u32 or
        (stream_ctl & 0x00F00000u32) != 0x00100000u32):
        return 4

    mmio_write32((BAR0 + 0x24) as u64, 1u32 << 2)
    controller.handle_irq()
    if (controller.irq_count != 1 or
        controller.timer.elapsed_periods != 1):
        return 5

    controller.stop_stream(stream_id)
    if (controller.stream_count != 0 or
        (mmio_read32((BAR0 + 0xC0) as u64) & 0x02u32) != 0u32 or
        (mmio_read32((BAR0 + 0x20) as u64) & (1u32 << 2)) != 0u32):
        return 6

    # Real hardware clears RIRBWP reset and writes the first response to slot 1.
    mmio_reset_for_test()
    var hardware_wp = HdaController.create(
        BAR0, 11, CORB_DMA, RIRB_DMA
    )
    hardware_wp.reset_controller()
    hardware_wp.setup_corb()
    hardware_wp.setup_rirb()
    mmio_write16((BAR0 + 0x0E) as u64, 1u16)
    mmio_write32((RIRB_DMA + 8) as u64, 0x10EC0892u32)
    mmio_write16((BAR0 + 0x58) as u64, 1u16)
    hardware_wp.probe_codec()
    if (hardware_wp.codec_vendor_id != 0x10EC or
        hardware_wp.codec_device_id != 0x0892):
        return 7
    0
