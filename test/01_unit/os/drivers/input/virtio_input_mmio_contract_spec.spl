# @req: REQ-OS-DRIVERS-001

use spec
use os.drivers.virtio.virtio_input_mmio.{
    VIRTIO_INPUT_DEVICE_CONTROLLER,
    virtio_input_mmio_layout_valid,
    virtio_input_event_length_valid,
    virtio_input_device_kind_from_caps,
    virtio_input_device_kind_from_ids,
    VirtioInputMmioDevice
}
use os.kernel.boot.mmio.{mmio_reset_for_test, mmio_read16, mmio_read32, mmio_write8, mmio_write16, mmio_write32}

fn configure_keyboard_transport(base: u64, modern_feature: bool, queue_max: u32):
    mmio_write32(base + 0x000u64, 0x74726976u32)
    mmio_write32(base + 0x004u64, 2u32)
    mmio_write32(base + 0x008u64, 18u32)
    mmio_write32(base + 0x010u64, if modern_feature: 1u32 else: 0u32)
    mmio_write32(base + 0x034u64, queue_max)
    mmio_write32(base + 0x044u64, 0u32)
    mmio_write8(base + 0x102u64, 4u8)
    mmio_write8(base + 0x108u64 + 3u64, 64u8)

use std.spec.step

describe "pure Simple VirtIO input MMIO contracts":
    it "validates aligned CPU and device DMA views":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: validates aligned CPU and device DMA views")
        expect(virtio_input_mmio_layout_valid(0x10000u64, 0x90000u64)).to_be(true)
        expect(virtio_input_mmio_layout_valid(0x10001u64, 0x90000u64)).to_be(false)
        expect(virtio_input_mmio_layout_valid(0u64, 0x90000u64)).to_be(false)

    it "requires exact eight-byte evdev records":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: requires exact eight-byte evdev records")
        expect(virtio_input_event_length_valid(8u32)).to_be(true)
        expect(virtio_input_event_length_valid(0u32)).to_be(false)
        expect(virtio_input_event_length_valid(16u32)).to_be(false)

    it "classifies keyboard pointer and controller capabilities":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: classifies keyboard pointer and controller capabilities")
        expect(virtio_input_device_kind_from_caps(true, false, false, false, false, false, false)).to_equal(1u32)
        expect(virtio_input_device_kind_from_caps(false, true, true, true, false, false, false)).to_equal(2u32)
        expect(virtio_input_device_kind_from_caps(false, false, false, true, true, true, false)).to_equal(2u32)
        expect(virtio_input_device_kind_from_caps(false, false, false, false, true, true, false)).to_equal(2u32)
        expect(virtio_input_device_kind_from_caps(false, false, false, false, true, true, true)).to_equal(VIRTIO_INPUT_DEVICE_CONTROLLER)
        expect(virtio_input_device_kind_from_caps(false, false, false, false, false, false, false)).to_equal(0u32)
        expect(virtio_input_device_kind_from_ids(0x0627u32, 1u32)).to_equal(1u32)
        expect(virtio_input_device_kind_from_ids(0x0627u32, 2u32)).to_equal(2u32)
        expect(virtio_input_device_kind_from_ids(0x0627u32, 3u32)).to_equal(2u32)
        expect(virtio_input_device_kind_from_ids(0x1234u32, 2u32)).to_equal(0u32)

    it "negotiates a modern keyboard queue and resets on teardown":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: negotiates a modern keyboard queue and resets on teardown")
        mmio_reset_for_test()
        val base = 0x0A000000u64
        configure_keyboard_transport(base, true, 8u32)
        var device = VirtioInputMmioDevice.start(base)
        expect(device.ready).to_be(true)
        expect(device.kind).to_equal(1u32)
        expect(mmio_read32(base + 0x044u64)).to_equal(1u32)
        expect(mmio_read32(base + 0x070u64)).to_equal(15u32)
        device.shutdown()
        expect(device.ready).to_be(false)
        expect(mmio_read32(base + 0x070u64)).to_equal(0u32)

    it "fails closed and releases DMA when the modern feature is absent":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: fails closed and releases DMA when the modern feature is absent")
        mmio_reset_for_test()
        val base = 0x0A001000u64
        configure_keyboard_transport(base, false, 8u32)
        val device = VirtioInputMmioDevice.start(base)
        expect(device.ready).to_be(false)
        expect(device.dma.handle).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(mmio_read32(base + 0x070u64)).to_equal(0u32)

    it "rejects an undersized event queue and resets the device":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects an undersized event queue and resets the device")
        mmio_reset_for_test()
        val base = 0x0A002000u64
        configure_keyboard_transport(base, true, 4u32)
        val device = VirtioInputMmioDevice.start(base)
        expect(device.ready).to_be(false)
        expect(device.dma.handle).to_equal(-1)  # oracle: -1 — named expected value from the requirement
        expect(mmio_read32(base + 0x070u64)).to_equal(0u32)

    it "polls and recycles an eight-byte keyboard event":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: polls and recycles an eight-byte keyboard event")
        mmio_reset_for_test()
        val base = 0x0A003000u64
        configure_keyboard_transport(base, true, 8u32)
        var device = VirtioInputMmioDevice.start(base)
        val cpu = device.dma.cpu
        expect(device.receipt_available()).to_be(false)
        mmio_write16(cpu + 194u64, 1u16)
        mmio_write32(cpu + 196u64, 0u32)
        mmio_write32(cpu + 200u64, 8u32)
        mmio_write16(cpu + 512u64, 1u16)
        mmio_write16(cpu + 514u64, 30u16)
        mmio_write32(cpu + 516u64, 1u32)
        mmio_write32(base + 0x060u64, 1u32)

        expect(device.receipt_available()).to_be(true)
        val receipt = device.poll_receipt()
        expect(device.receipt_available()).to_be(false)
        expect(receipt.available).to_be(true)
        expect(receipt.event.type_).to_equal(1u16)
        expect(receipt.event.code).to_equal(30u16)
        expect(receipt.event.value).to_equal(1u32)
        expect(receipt.event.irq_status).to_equal(1u32)
        expect(mmio_read16(cpu + 130u64)).to_equal(9u16)
        expect(mmio_read32(base + 0x064u64)).to_equal(1u32)
        device.shutdown()

    it "shuts down on a malformed used-ring record":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: shuts down on a malformed used-ring record")
        mmio_reset_for_test()
        val base = 0x0A004000u64
        configure_keyboard_transport(base, true, 8u32)
        var device = VirtioInputMmioDevice.start(base)
        val cpu = device.dma.cpu
        mmio_write16(cpu + 194u64, 1u16)
        mmio_write32(cpu + 196u64, 0u32)
        mmio_write32(cpu + 200u64, 7u32)
        expect(device.poll_receipt().available).to_be(false)
        expect(device.ready).to_be(false)
        expect(device.dma.handle).to_equal(-1)  # oracle: -1 — named expected value from the requirement
