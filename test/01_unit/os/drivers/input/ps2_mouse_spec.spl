# @req: REQ-OS-DRIVERS-001

"""
# PS/2 Mouse Driver Specification

**Feature IDs:** #OS-PS2-MOUSE
**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** In Progress

## Overview

Tests PS/2 mouse state construction, driver creation, packet parsing
with sign extension and bounds clamping, button edge detection, and
cursor bitmap dimensions.
"""

use std.spec
use os.drivers.input.ps2_mouse.{
    MouseState, MouseEvent, Ps2Mouse, decode_wheel_z,
    MOUSE_ID_PLAIN, MOUSE_ID_WHEEL, MOUSE_ID_WHEEL_5BTN
}
use os.compositor.cursor.{
    CursorState, default_cursor_state,
    get_cursor_bitmap, get_cursor_mask,
    CURSOR_WIDTH, CURSOR_HEIGHT
}

# ============================================================================
# Reference decoder — a verbatim transcription of the ORIGINAL (pre-split)
# Ps2Mouse.poll() packet loop, kept here as an independent oracle so the
# isr_ingest()/decode_pending() split can be proven to be behaviour-preserving
# rather than merely self-consistent. Do not "simplify" it to call the driver:
# its whole value is that it is a second, independent implementation.
# ============================================================================

struct RefMouse:
    x: i64
    y: i64
    left: bool
    right: bool
    middle: bool
    b0: i64
    b1: i64
    idx: i64
    emitted: bool

fn reference_new_state() -> RefMouse:
    RefMouse(x: 400, y: 300, left: false, right: false, middle: false,
             b0: 0, b1: 0, idx: 0, emitted: false)

fn reference_feed(prev: RefMouse, byte_val: i64) -> RefMouse:
    """Feed one raw byte to the original 3-byte packet algorithm."""
    var s = RefMouse(x: prev.x, y: prev.y, left: prev.left, right: prev.right,
                     middle: prev.middle, b0: prev.b0, b1: prev.b1,
                     idx: prev.idx, emitted: false)

    if s.idx == 0:
        if (byte_val & 0x08) == 0:
            s.idx = 0
            return s
        s.b0 = byte_val
        s.idx = 1
        return s

    if s.idx == 1:
        s.b1 = byte_val
        s.idx = 2
        return s

    # idx == 2: packet complete
    s.idx = 0
    val flags = s.b0
    val raw_x = s.b1
    val raw_y = byte_val

    s.left = (flags & 0x01) != 0
    s.right = (flags & 0x02) != 0
    s.middle = (flags & 0x04) != 0

    val x_overflow = (flags & 0x40) != 0
    val y_overflow = (flags & 0x80) != 0
    if x_overflow or y_overflow:
        s.emitted = true
        return s

    var dx: i64 = raw_x
    if (flags & 0x10) != 0:
        dx = dx - 256
    var dy: i64 = raw_y
    if (flags & 0x20) != 0:
        dy = dy - 256
    dy = 0 - dy

    var new_x = s.x + dx
    var new_y = s.y + dy
    if new_x < 0:
        new_x = 0
    if new_x >= 800:
        new_x = 799
    if new_y < 0:
        new_y = 0
    if new_y >= 600:
        new_y = 599
    s.x = new_x
    s.y = new_y
    s.emitted = true
    s

# ============================================================================
# Test Group 1: MouseState Construction
# ============================================================================

describe "PS/2 Mouse":
    describe "MouseState":
        it "constructs with default values":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: constructs with default values")
            val state = MouseState(
                x: 400, y: 300,
                left_button: false, right_button: false, middle_button: false,
                dx: 0, dy: 0,
                screen_width: 800, screen_height: 600
            )
            expect(state.x).to_equal(400)  # oracle: 400 — named expected value from the requirement
            expect(state.y).to_equal(300)  # oracle: 300 — named expected value from the requirement
            expect(state.screen_width).to_equal(800)  # oracle: 800 — named expected value from the requirement
            expect(state.screen_height).to_equal(600)  # oracle: 600 — named expected value from the requirement
            expect(state.left_button).to_equal(false)
            expect(state.right_button).to_equal(false)
            expect(state.middle_button).to_equal(false)

    # ========================================================================
    # Test Group 2: MouseEvent Construction
    # ========================================================================

    describe "MouseEvent":
        it "constructs with edge-triggered fields":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: constructs with edge-triggered fields")
            val event = MouseEvent(
                x: 100, y: 200,
                dx: 5, dy: -3,
                left_pressed: true, right_pressed: false, middle_pressed: false,
                left_just_pressed: true, right_just_pressed: false,
                left_just_released: false
            )
            expect(event.x).to_equal(100)  # oracle: 100 — named expected value from the requirement
            expect(event.y).to_equal(200)  # oracle: 200 — named expected value from the requirement
            expect(event.dx).to_equal(5)  # oracle: 5 — named expected value from the requirement
            expect(event.dy).to_equal(-3)  # oracle: -3 — named expected value from the requirement
            expect(event.left_pressed).to_equal(true)
            expect(event.left_just_pressed).to_equal(true)
            expect(event.left_just_released).to_equal(false)
            # `wheel` is omitted above on purpose: its `= 0` default is what
            # keeps the winit / virtio / USB-HID producers (which this
            # workstream may not edit) constructing MouseEvent unchanged.
            expect(event.wheel).to_equal(0)  # oracle: 0 — named expected value from the requirement

    # ========================================================================
    # Test Group 3: Ps2Mouse Creation
    # ========================================================================

    describe "Ps2Mouse.create":
        it "starts at screen center":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts at screen center")
            val mouse = Ps2Mouse.create(800, 600)
            val state = mouse.get_state()
            expect(state.x).to_equal(400)  # oracle: 400 — named expected value from the requirement
            expect(state.y).to_equal(300)  # oracle: 300 — named expected value from the requirement

        it "starts not initialized":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts not initialized")
            val mouse = Ps2Mouse.create(800, 600)
            expect(mouse.is_initialized()).to_equal(false)

        it "starts with no buttons pressed":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with no buttons pressed")
            val mouse = Ps2Mouse.create(800, 600)
            val state = mouse.get_state()
            expect(state.left_button).to_equal(false)
            expect(state.right_button).to_equal(false)
            expect(state.middle_button).to_equal(false)

        it "starts with zero deltas":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts with zero deltas")
            val mouse = Ps2Mouse.create(800, 600)
            val state = mouse.get_state()
            expect(state.dx).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(state.dy).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "stores screen dimensions":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: stores screen dimensions")
            val mouse = Ps2Mouse.create(1024, 768)
            val state = mouse.get_state()
            expect(state.screen_width).to_equal(1024)  # oracle: 1024 — named expected value from the requirement
            expect(state.screen_height).to_equal(768)  # oracle: 768 — named expected value from the requirement

    # ========================================================================
    # Test Group 4: Packet Parsing (via _process_packet internal state)
    # ========================================================================

    describe "packet parsing":
        it "poll returns nil when not initialized":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: poll returns nil when not initialized")
            var mouse = Ps2Mouse.create(800, 600)
            val event = mouse.poll()
            expect(event == nil).to_equal(true)

    # ========================================================================
    # Test Group 4a: IntelliMouse enable sequence (C3)
    # ========================================================================

    describe "IntelliMouse enable sequence":
        it "starts as a plain 3-byte mouse":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts as a plain 3-byte mouse")
            val mouse = Ps2Mouse.create(800, 600)
            expect(mouse.has_wheel).to_equal(false)
            expect(mouse.dev_id).to_equal(MOUSE_ID_PLAIN)
            expect(mouse.packet_length()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "device ID 0x00 after the knock leaves 3-byte packets":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: device ID 0x00 after the knock leaves 3-byte packets")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_PLAIN)
            expect(mouse.has_wheel).to_equal(false)
            expect(mouse.packet_length()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        it "device ID 0x03 enables the wheel and 4-byte packets":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: device ID 0x03 enables the wheel and 4-byte packets")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            expect(mouse.has_wheel).to_equal(true)
            expect(mouse.packet_length()).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "device ID 0x04 (5-button) also enables 4-byte packets":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: device ID 0x04 (5-button) also enables 4-byte packets")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL_5BTN)
            expect(mouse.has_wheel).to_equal(true)
            expect(mouse.packet_length()).to_equal(4)  # oracle: 4 — named expected value from the requirement

        it "an unknown device ID does not enable the wheel":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: an unknown device ID does not enable the wheel")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(0x02)
            expect(mouse.has_wheel).to_equal(false)
            expect(mouse.packet_length()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    # ========================================================================
    # Test Group 4b: Wheel Z decoding and sign (C3)
    #
    # Sign convention under test: PS/2 positive Z = scrolled DOWN, and
    # NOTHING negates it — MouseEvent.wheel and HostInputEvent.wheel both use
    # positive = down. A future "fix" that flips this sign must fail here.
    # ========================================================================

    describe "wheel Z decoding":
        it "decodes 0x01 as +1 (scrolled down) on device 0x03":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes 0x01 as +1 (scrolled down) on device 0x03")
            expect(decode_wheel_z(0x01, MOUSE_ID_WHEEL)).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "decodes 0xFF as -1 (scrolled up) on device 0x03":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes 0xFF as -1 (scrolled up) on device 0x03")
            expect(decode_wheel_z(0xFF, MOUSE_ID_WHEEL)).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "decodes 0x00 as no detent":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes 0x00 as no detent")
            expect(decode_wheel_z(0x00, MOUSE_ID_WHEEL)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "decodes the full signed i8 range on device 0x03":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes the full signed i8 range on device 0x03")
            expect(decode_wheel_z(0x7F, MOUSE_ID_WHEEL)).to_equal(127)  # oracle: 127 — named expected value from the requirement
            expect(decode_wheel_z(0x80, MOUSE_ID_WHEEL)).to_equal(-128)  # oracle: -128 — named expected value from the requirement

        it "decodes the low nibble as signed on device 0x04":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes the low nibble as signed on device 0x04")
            expect(decode_wheel_z(0x0F, MOUSE_ID_WHEEL_5BTN)).to_equal(-1)  # oracle: -1 — named expected value from the requirement
            expect(decode_wheel_z(0x01, MOUSE_ID_WHEEL_5BTN)).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(decode_wheel_z(0x08, MOUSE_ID_WHEEL_5BTN)).to_equal(-8)  # oracle: -8 — named expected value from the requirement
            expect(decode_wheel_z(0x07, MOUSE_ID_WHEEL_5BTN)).to_equal(7)  # oracle: 7 — named expected value from the requirement

        it "ignores buttons 4/5 in bits 4-5 on device 0x04":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: ignores buttons 4/5 in bits 4-5 on device 0x04")
            # 0x31 = buttons 4+5 set, low nibble 1 -> wheel +1 only
            expect(decode_wheel_z(0x31, MOUSE_ID_WHEEL_5BTN)).to_equal(1)  # oracle: 1 — named expected value from the requirement

    # ========================================================================
    # Test Group 4c: 3-byte vs 4-byte packet decode (C2 + C3)
    #
    # Packets are pushed through feed_raw_byte(), which is the exact store
    # half of isr_ingest(), then drained with decode_pending(). No ports.
    # ========================================================================

    describe "3-byte packet decode (no wheel)":
        it "decodes movement and reports wheel 0":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decodes movement and reports wheel 0")
            var mouse = Ps2Mouse.create(800, 600)
            # flags 0x08 (bit3 always 1, no buttons, no signs), dx=5, dy=3
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(5)
            mouse.feed_raw_byte(3)
            if val ev = mouse.decode_pending():
                expect(ev.dx).to_equal(5)  # oracle: 5 — named expected value from the requirement
                # PS/2 Y is inverted relative to screen Y
                expect(ev.dy).to_equal(-3)  # oracle: -3 — named expected value from the requirement
                expect(ev.x).to_equal(405)  # oracle: 405 — named expected value from the requirement
                expect(ev.y).to_equal(297)  # oracle: 297 — named expected value from the requirement
                expect(ev.wheel).to_equal(0)  # oracle: 0 — named expected value from the requirement
                expect(ev.left_pressed).to_equal(false)
            else:
                fail_test("expected a MouseEvent from a complete 3-byte packet")

        it "consumes exactly 3 bytes and leaves the 4th in the ring":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: consumes exactly 3 bytes and leaves the 4th in the ring")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0x08)   # start of the NEXT packet
            val first = mouse.decode_pending()
            expect(first != nil).to_equal(true)
            # decode_pending returns the INSTANT a packet completes, leaving
            # the rest of the ring for the next call — the same one-event-per-
            # call contract the pre-split poll() had.
            expect(mouse.raw_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(mouse.packet_index).to_equal(0)  # oracle: 0 — named expected value from the requirement
            # Next call picks the leftover byte up as byte0
            expect(mouse.decode_pending() == nil).to_equal(true)
            expect(mouse.packet_index).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(mouse.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "resyncs by discarding a byte0 without bit 3 set":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: resyncs by discarding a byte0 without bit 3 set")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.feed_raw_byte(0x00)   # invalid byte0 — discarded
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(7)
            mouse.feed_raw_byte(0)
            if val ev = mouse.decode_pending():
                expect(ev.dx).to_equal(7)  # oracle: 7 — named expected value from the requirement
            else:
                fail_test("expected the decoder to resync and emit an event")

        it "reports edge-triggered left press then release":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: reports edge-triggered left press then release")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.feed_raw_byte(0x09)   # bit3 + left button
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            if val down = mouse.decode_pending():
                expect(down.left_pressed).to_equal(true)
                expect(down.left_just_pressed).to_equal(true)
                expect(down.left_just_released).to_equal(false)
            else:
                fail_test("expected a press event")
            mouse.feed_raw_byte(0x08)   # bit3, button cleared
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            if val up = mouse.decode_pending():
                expect(up.left_pressed).to_equal(false)
                expect(up.left_just_released).to_equal(true)
            else:
                fail_test("expected a release event")

    describe "4-byte packet decode (wheel mouse)":
        it "requires 4 bytes before emitting an event":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: requires 4 bytes before emitting an event")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            expect(mouse.decode_pending() == nil).to_equal(true)
            mouse.feed_raw_byte(0xFF)
            expect(mouse.decode_pending() != nil).to_equal(true)

        it "byte3 0xFF yields wheel -1 (scrolled up)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: byte3 0xFF yields wheel -1 (scrolled up)")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0xFF)
            if val ev = mouse.decode_pending():
                expect(ev.wheel).to_equal(-1)  # oracle: -1 — named expected value from the requirement
            else:
                fail_test("expected a MouseEvent from a complete 4-byte packet")

        it "byte3 0x01 yields wheel +1 (scrolled down)":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: byte3 0x01 yields wheel +1 (scrolled down)")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0x01)
            if val ev = mouse.decode_pending():
                expect(ev.wheel).to_equal(1)  # oracle: 1 — named expected value from the requirement
            else:
                fail_test("expected a MouseEvent from a complete 4-byte packet")

        it "device 0x04 nibble 0x0F yields wheel -1":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: device 0x04 nibble 0x0F yields wheel -1")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL_5BTN)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0x0F)
            if val ev = mouse.decode_pending():
                expect(ev.wheel).to_equal(-1)  # oracle: -1 — named expected value from the requirement
            else:
                fail_test("expected a MouseEvent from a complete 4-byte packet")

        it "carries movement and wheel in the same packet":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: carries movement and wheel in the same packet")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(4)
            mouse.feed_raw_byte(2)
            mouse.feed_raw_byte(0x01)
            if val ev = mouse.decode_pending():
                expect(ev.dx).to_equal(4)  # oracle: 4 — named expected value from the requirement
                expect(ev.dy).to_equal(-2)  # oracle: -2 — named expected value from the requirement
                expect(ev.wheel).to_equal(1)  # oracle: 1 — named expected value from the requirement
            else:
                fail_test("expected a MouseEvent from a complete 4-byte packet")

        it "clears the wheel on a following detent-free packet":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: clears the wheel on a following detent-free packet")
            var mouse = Ps2Mouse.create(800, 600)
            mouse.apply_device_id(MOUSE_ID_WHEEL)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0x01)
            expect(mouse.decode_pending() != nil).to_equal(true)
            mouse.feed_raw_byte(0x08)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0)
            mouse.feed_raw_byte(0x00)
            if val ev = mouse.decode_pending():
                expect(ev.wheel).to_equal(0)  # oracle: 0 — named expected value from the requirement
            else:
                fail_test("expected a second MouseEvent")

    # ========================================================================
    # Test Group 4d: ISR ring buffer (C2)
    # ========================================================================

    describe "raw byte ring":
        it "starts empty with nothing dropped":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: starts empty with nothing dropped")
            val mouse = Ps2Mouse.create(800, 600)
            expect(mouse.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mouse.raw_dropped).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "decode_pending returns nil on an empty ring":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: decode_pending returns nil on an empty ring")
            var mouse = Ps2Mouse.create(800, 600)
            expect(mouse.decode_pending() == nil).to_equal(true)

        it "drops bytes past capacity instead of growing":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: drops bytes past capacity instead of growing")
            var mouse = Ps2Mouse.create(800, 600)
            var i: i64 = 0
            while i < 64:
                expect(mouse.feed_raw_byte(0x08)).to_equal(true)
                i = i + 1
            expect(mouse.raw_count).to_equal(64)  # oracle: 64 — named expected value from the requirement
            # 65th byte is dropped, not stored
            expect(mouse.feed_raw_byte(0x08)).to_equal(false)
            expect(mouse.raw_count).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(mouse.raw_dropped).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "wraps the ring around capacity without loss":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: wraps the ring around capacity without loss")
            var mouse = Ps2Mouse.create(800, 600)
            # Fill, drain, refill — exercises head/tail modulo wraparound
            var round: i64 = 0
            while round < 30:
                mouse.feed_raw_byte(0x08)
                mouse.feed_raw_byte(1)
                mouse.feed_raw_byte(0)
                expect(mouse.decode_pending() != nil).to_equal(true)
                round = round + 1
            expect(mouse.raw_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mouse.raw_dropped).to_equal(0)  # oracle: 0 — named expected value from the requirement
            # 30 packets of dx=+1 from x=400, clamped nowhere
            expect(mouse.get_state().x).to_equal(430)  # oracle: 430 — named expected value from the requirement

    # ========================================================================
    # Test Group 4e: NO-REGRESSION PROOF — isr_ingest+decode_pending vs the
    # pre-split poll() algorithm.
    #
    # `reference_feed` above is a verbatim transcription of the ORIGINAL
    # ps2_mouse.spl poll() packet loop (3-byte only, bit-3 resync, overflow
    # discard, sign extension, Y inversion, clamping). The split decoder must
    # agree with it byte-for-byte on a recorded input sequence.
    # ========================================================================

    describe "no-regression vs the pre-split poll algorithm":
        it "agrees with the reference decoder on a recorded byte sequence":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: agrees with the reference decoder on a recorded byte sequence")
            # Recorded stream: move right/up, left press + move, release,
            # an overflow packet, and a desync byte.
            val recorded = [
                0x08, 5, 3,
                0x09, 250, 0,      # left down, dx = -6 (no sign bit -> +250)
                0x18, 250, 0,      # left down + X sign -> dx = -6
                0x08, 0, 0,        # release
                0x48, 9, 9,        # X overflow -> movement discarded
                0x00,              # desync byte -> discarded
                0x08, 1, 1
            ]

            var mouse = Ps2Mouse.create(800, 600)
            var ref_state = reference_new_state()

            var xs: List<i64> = []
            var ys: List<i64> = []
            var ref_xs: List<i64> = []
            var ref_ys: List<i64> = []
            var flags_seen: List<bool> = []
            var ref_flags: List<bool> = []

            for b in recorded:
                mouse.feed_raw_byte(b)
                if val ev = mouse.decode_pending():
                    xs.push(ev.x)
                    ys.push(ev.y)
                    flags_seen.push(ev.left_pressed)
                ref_state = reference_feed(ref_state, b)
                if ref_state.emitted:
                    ref_xs.push(ref_state.x)
                    ref_ys.push(ref_state.y)
                    ref_flags.push(ref_state.left)

            expect(xs.len()).to_equal(ref_xs.len())
            expect(xs.len()).to_be_greater_than(0)
            var i: i64 = 0
            while i < xs.len():
                expect(xs[i]).to_equal(ref_xs[i])
                expect(ys[i]).to_equal(ref_ys[i])
                expect(flags_seen[i]).to_equal(ref_flags[i])
                i = i + 1

    # ========================================================================
    # Test Group 5: CursorState Construction
    # ========================================================================

    describe "CursorState":
        it "constructs with position and hotspot":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: constructs with position and hotspot")
            val cursor = CursorState(
                x: 100, y: 200,
                visible: true,
                hotspot_x: 1, hotspot_y: 1
            )
            expect(cursor.x).to_equal(100)  # oracle: 100 — named expected value from the requirement
            expect(cursor.y).to_equal(200)  # oracle: 200 — named expected value from the requirement
            expect(cursor.visible).to_equal(true)
            expect(cursor.hotspot_x).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(cursor.hotspot_y).to_equal(1)  # oracle: 1 — named expected value from the requirement

        it "default_cursor_state starts at origin":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: default_cursor_state starts at origin")
            val cursor = default_cursor_state()
            expect(cursor.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(cursor.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(cursor.visible).to_equal(true)

    # ========================================================================
    # Test Group 6: Cursor Bitmap Dimensions
    # ========================================================================

    describe "cursor bitmap":
        it "has 19 rows in bitmap":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: has 19 rows in bitmap")
            val bitmap = get_cursor_bitmap()
            expect(bitmap.len()).to_equal(19)  # oracle: 19 — named expected value from the requirement

        it "has 19 rows in mask":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: has 19 rows in mask")
            val mask = get_cursor_mask()
            expect(mask.len()).to_equal(19)  # oracle: 19 — named expected value from the requirement

        it "CURSOR_WIDTH is 12":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: CURSOR_WIDTH is 12")
            expect(CURSOR_WIDTH).to_equal(12)  # oracle: 12 — named expected value from the requirement

        it "CURSOR_HEIGHT is 19":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: CURSOR_HEIGHT is 19")
            expect(CURSOR_HEIGHT).to_equal(19)  # oracle: 19 — named expected value from the requirement

        it "first bitmap row has only top-left pixel":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: first bitmap row has only top-left pixel")
            val bitmap = get_cursor_bitmap()
            # MSB = bit 11, so top-left pixel = 0b100000000000 = 2048
            expect(bitmap[0]).to_equal(2048)  # oracle: 2048 — named expected value from the requirement

        it "mask is wider than bitmap on first row":
            # @req: REQ-OS-DRIVERS-001
            step("Verify: mask is wider than bitmap on first row")
            val bitmap = get_cursor_bitmap()
            val mask = get_cursor_mask()
            # Mask row 0: 0b110000000000 = 3072, bitmap row 0: 2048
            val mask_wider = mask[0] > bitmap[0]
            expect(mask_wider).to_equal(true)
