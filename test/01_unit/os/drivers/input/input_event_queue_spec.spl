# @req: REQ-OS-DRIVERS-001

use std.spec
use os.drivers.input.input_event.{InputEventQueue, INPUT_QUEUE_CAP}
use common.ui.host_input_event.{
    HostInputEvent,
    HOST_BTN_LEFT,
    HOST_BTN_NONE,
    host_pointer_down,
    host_pointer_move,
    host_key_down,
}

fn pointer_x(ev: HostInputEvent) -> i64:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            x as i64
        _:
            -1

fn pointer_button(ev: HostInputEvent) -> i64:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            button
        _:
            -1

describe "InputEventQueue is an actual bounded FIFO":
    it "starts empty":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: starts empty")
        var q = InputEventQueue.create()
        expect(q.is_empty()).to_equal(true)
        expect(q.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(q.pop() == nil).to_equal(true)
        expect(q.capacity()).to_equal(INPUT_QUEUE_CAP)

    it "preserves FIFO order across mixed variants":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: preserves FIFO order across mixed variants")
        var q = InputEventQueue.create()
        expect(q.push(host_pointer_down(1, 2, HOST_BTN_LEFT))).to_equal(true)
        expect(q.push(host_key_down(65, "a", 0))).to_equal(true)
        expect(q.push(host_pointer_move(3, 4))).to_equal(true)
        expect(q.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement

        val first = q.pop()
        expect(first != nil).to_equal(true)
        if val e0 = first:
            expect(pointer_x(e0)).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(pointer_button(e0)).to_equal(HOST_BTN_LEFT)

        val second = q.pop()
        expect(second != nil).to_equal(true)
        if val e1 = second:
            match e1:
                HostInputEvent.Key(code, ch, down, mods):
                    expect(ch).to_equal("a")
                    expect(down).to_equal(true)
                _:
                    expect("not a key").to_equal("key")

        val third = q.pop()
        expect(third != nil).to_equal(true)
        if val e2 = third:
            expect(pointer_x(e2)).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(pointer_button(e2)).to_equal(HOST_BTN_NONE)

        expect(q.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(q.pop() == nil).to_equal(true)

    it "wraps around the ring without losing or reordering events":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: wraps around the ring without losing or reordering events")
        var q = InputEventQueue.create()
        # Push/pop 3 * CAP events one at a time: head and tail each wrap the
        # ring three times, and every value must come back in order.
        var i = 0
        var mismatches = 0
        while i < INPUT_QUEUE_CAP * 3:
            q.push(host_pointer_move(i as i32, 0))
            val got = q.pop()
            if val ev = got:
                if pointer_x(ev) != i:
                    mismatches = mismatches + 1
            else:
                mismatches = mismatches + 1
            i = i + 1
        expect(mismatches).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(q.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(q.dropped_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "reports len() correctly after N pushes and M pops":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: reports len() correctly after N pushes and M pops")
        var q = InputEventQueue.create()
        var i = 0
        while i < 100:
            q.push(host_pointer_move(i as i32, 0))
            i = i + 1
        expect(q.len()).to_equal(100)  # oracle: 100 — named expected value from the requirement
        var m = 0
        while m < 40:
            q.pop()
            m = m + 1
        expect(q.len()).to_equal(60)  # oracle: 60 — named expected value from the requirement
        # The oldest survivor is #40, proving pops came off the head.
        val next = q.pop()
        if val ev = next:
            expect(pointer_x(ev)).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "drops overflow instead of corrupting head":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: drops overflow instead of corrupting head")
        var q = InputEventQueue.create()
        var i = 0
        while i < INPUT_QUEUE_CAP:
            expect(q.push(host_pointer_move(i as i32, 0))).to_equal(true)
            i = i + 1
        expect(q.len()).to_equal(INPUT_QUEUE_CAP)
        # Five more must be refused, not overwrite the queued history.
        var over = 0
        while over < 5:
            expect(q.push(host_pointer_move(9999, 0))).to_equal(false)
            over = over + 1
        expect(q.dropped_count()).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(q.len()).to_equal(INPUT_QUEUE_CAP)
        # Head is intact: the oldest event is still #0, not a dropped 9999.
        val oldest = q.pop()
        if val ev = oldest:
            expect(pointer_x(ev)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "drains everything oldest-first and clears":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: drains everything oldest-first and clears")
        var q = InputEventQueue.create()
        q.push(host_pointer_move(5, 0))
        q.push(host_pointer_move(6, 0))
        val all = q.drain()
        expect(all.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(pointer_x(all[0])).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(pointer_x(all[1])).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(q.is_empty()).to_equal(true)

        q.push(host_pointer_move(7, 0))
        q.clear()
        expect(q.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(q.pop() == nil).to_equal(true)

    it "summarises itself for probe panes":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: summarises itself for probe panes")
        var q = InputEventQueue.create()
        q.push(host_pointer_move(1, 1))
        expect(q.stats()).to_contain("n=1")
        expect(q.stats()).to_contain("dropped=0")
