# @req: REQ-OS-DRIVERS-001

# Event-path allocation claim — routed through F0's milestone gate.
#
# Plan: doc/03_plan/ui/perf/render_perf_redesign_plan_2026-08-06.md section 0
# (decisive milestone: `allocations = 0` on a warm frame) and section 7
# ("make the whole path allocation-free").
#
# THE POINT OF THIS FILE
# ----------------------
# The event path now has an allocation-free drain (`drain_into`, replacing the
# list-building `drain()`). That is a STRUCTURAL argument. It is not a
# measurement, and this repo has repeatedly shipped false greens by letting a
# structural argument be reported as a measured zero. So this spec asserts two
# separate things and refuses to conflate them:
#
#  * What IS measurable today: the batch's backing array length is invariant
#    across refills. If a refill ever grew the batch, `backing_len()` moves.
#    Catches: a "fix" that quietly re-appends into a fresh list, or an
#    `append` that grows past capacity instead of counting an overflow.
#
#  * What is NOT measurable today: the actual number of heap allocations the
#    event path performs on a warm frame. No runtime allocation counter is
#    reachable from Simple. So the receipt leaves PERF_CTR_ALLOCATIONS
#    UNWRITTEN and this spec asserts F0's `perf_milestone_gate` answers
#    `blocked:unmeasured:allocations` -- NOT "pass".
#    Catches: any future change that writes a hand-asserted 0 into the
#    allocations counter to make the gate green. That would turn F0's
#    fail-closed gate into a rubber stamp, which is the exact failure mode
#    F0 exists to stop.
#
# F0's module (common.perf.render_perf_receipt_v2) is CALLED here, never
# edited, and no parallel allocation-claim mechanism is introduced.

use common.perf.render_perf_receipt_v2.{RenderPerfReceiptV2, render_perf_receipt_new, perf_ctr_set, perf_ctr_measured, perf_milestone_gate, PERF_CTR_ALLOCATIONS, PERF_CTR_SCENE_COPY_BYTES, PERF_CTR_FULL_READBACK_BYTES, PERF_CTR_UNCHANGED_RASTER_PIXELS, PERF_CTR_FORWARD_PHYSICAL_HOPS, ENGINE_INTERPRETER}
use common.ui.host_input_event.{host_pointer_move, host_key_down}
use os.drivers.input.input_event.{InputEventQueue}
use os.drivers.input.input_batch.{InputBatch}

use std.spec.step

describe "event path allocation claim":

    it "refilling the batch never grows its backing array":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: refilling the batch never grows its backing array")
        val q = InputEventQueue.create()
        val b = InputBatch.create()
        val before = b.backing_len()
        expect(before).to_equal(256)  # oracle: 256 — named expected value from the requirement
        var frame = 0
        while frame < 8:
            var i = 0
            while i < 32:
                q.push(host_pointer_move(i as i32, frame as i32))
                i = i + 1
            q.push(host_key_down(65, "a", 0))
            q.drain_into(b)
            expect(b.len()).to_equal(33)  # oracle: 33 — named expected value from the requirement
            frame = frame + 1
        expect(b.backing_len()).to_equal(before)

    it "the coalescing drain also never grows the backing array":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: the coalescing drain also never grows the backing array")
        val q = InputEventQueue.create()
        val b = InputBatch.create()
        val before = b.backing_len()
        var frame = 0
        while frame < 8:
            var i = 0
            while i < 32:
                q.push(host_pointer_move(i as i32, frame as i32))
                i = i + 1
            q.drain_into_coalesced(b)
            expect(b.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
            frame = frame + 1
        expect(b.backing_len()).to_equal(before)

    it "an over-capacity fill counts overflow instead of growing":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: an over-capacity fill counts overflow instead of growing")
        val q = InputEventQueue.create()
        val b = InputBatch.create()
        val before = b.backing_len()
        var i = 0
        while i < 300:
            q.push(host_key_down(65, "a", 0))
            i = i + 1
        # The ring itself refuses past INPUT_QUEUE_CAP, so the batch fills
        # exactly to capacity and the ring records the surplus as drops.
        q.drain_into(b)
        expect(b.len()).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(b.backing_len()).to_equal(before)
        expect(q.dropped_count()).to_equal(44)  # oracle: 44 — named expected value from the requirement

    it "the allocations counter is left UNMEASURED, not asserted zero":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: the allocations counter is left UNMEASURED, not asserted zero")
        val r = render_perf_receipt_new(ENGINE_INTERPRETER, "deadbeef")
        expect(r != nil).to_equal(true)
        if val rec = r:
            expect(perf_ctr_measured(rec, PERF_CTR_ALLOCATIONS)).to_equal(false)

    it "F0's milestone gate reports blocked:unmeasured for allocations":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: F0's milestone gate reports blocked:unmeasured for allocations")
        val r = render_perf_receipt_new(ENGINE_INTERPRETER, "deadbeef")
        if val rec = r:
            # Every OTHER milestone counter is measured zero, so the only
            # thing left for the gate to complain about is allocations.
            var g = perf_ctr_set(rec, PERF_CTR_SCENE_COPY_BYTES, 0)
            g = perf_ctr_set(g, PERF_CTR_FULL_READBACK_BYTES, 0)
            g = perf_ctr_set(g, PERF_CTR_UNCHANGED_RASTER_PIXELS, 0)
            g = perf_ctr_set(g, PERF_CTR_FORWARD_PHYSICAL_HOPS, 0)
            expect(perf_milestone_gate(g, ENGINE_INTERPRETER)).to_equal("blocked:unmeasured:allocations")

    it "the gate would only pass if a real allocation probe wrote the counter":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: the gate would only pass if a real allocation probe wrote the counter")
        val r = render_perf_receipt_new(ENGINE_INTERPRETER, "deadbeef")
        if val rec = r:
            var g = perf_ctr_set(rec, PERF_CTR_SCENE_COPY_BYTES, 0)
            g = perf_ctr_set(g, PERF_CTR_FULL_READBACK_BYTES, 0)
            g = perf_ctr_set(g, PERF_CTR_UNCHANGED_RASTER_PIXELS, 0)
            g = perf_ctr_set(g, PERF_CTR_FORWARD_PHYSICAL_HOPS, 0)
            g = perf_ctr_set(g, PERF_CTR_ALLOCATIONS, 0)
            expect(perf_milestone_gate(g, ENGINE_INTERPRETER)).to_equal("pass")
            # ...and a nonzero probe result is a fail, not a blocked.
            val bad = perf_ctr_set(g, PERF_CTR_ALLOCATIONS, 7)
            expect(perf_milestone_gate(bad, ENGINE_INTERPRETER)).to_equal("fail:nonzero:allocations=7")
