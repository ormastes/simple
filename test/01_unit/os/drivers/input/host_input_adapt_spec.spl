# @req: REQ-OS-DRIVERS-001

use std.spec
use os.drivers.input.host_input_adapt.{
    mods_pack,
    mods_has_shift,
    mods_has_ctrl,
    mods_has_alt,
    ps2_key_code,
    host_key_event_from_ps2,
    host_pointer_event_from_ps2,
}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.drivers.input.ps2_mouse.{MouseEvent}
use common.ui.host_input_event.{
    HostInputEvent,
    HOST_BTN_NONE,
    HOST_BTN_LEFT,
    HOST_BTN_RIGHT,
    HOST_BTN_MIDDLE,
    HOST_MOD_SHIFT,
    HOST_MOD_CTRL,
    HOST_MOD_ALT,
}

fn motion_event(x: i64, y: i64) -> MouseEvent:
    MouseEvent(
        x: x, y: y, dx: 0, dy: 0,
        left_pressed: false, right_pressed: false, middle_pressed: false,
        left_just_pressed: false, right_just_pressed: false,
        left_just_released: false, wheel: 0
    )

fn btn(ev: HostInputEvent) -> i64:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            button
        _:
            -1

fn is_pressed(ev: HostInputEvent) -> bool:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            pressed
        _:
            false

fn wheel_of(ev: HostInputEvent) -> i64:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            wheel as i64
        _:
            -999

fn xy(ev: HostInputEvent) -> text:
    match ev:
        HostInputEvent.Pointer(x, y, button, pressed, wheel):
            x.to_text() + "," + y.to_text()
        _:
            "?"

describe "PS/2 mouse -> HostInputEvent collapse":
    it "maps left_just_pressed to a LEFT press":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps left_just_pressed to a LEFT press")
        var m = motion_event(10, 20)
        m.left_pressed = true
        m.left_just_pressed = true
        val ev = host_pointer_event_from_ps2(m)
        expect(btn(ev)).to_equal(HOST_BTN_LEFT)
        expect(is_pressed(ev)).to_equal(true)
        expect(xy(ev)).to_equal("10,20")

    it "maps left_just_released to a LEFT release":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps left_just_released to a LEFT release")
        var m = motion_event(11, 21)
        m.left_just_released = true
        val ev = host_pointer_event_from_ps2(m)
        expect(btn(ev)).to_equal(HOST_BTN_LEFT)
        expect(is_pressed(ev)).to_equal(false)

    it "maps right_just_pressed to a RIGHT press":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps right_just_pressed to a RIGHT press")
        var m = motion_event(12, 22)
        m.right_pressed = true
        m.right_just_pressed = true
        val ev = host_pointer_event_from_ps2(m)
        expect(btn(ev)).to_equal(HOST_BTN_RIGHT)
        expect(is_pressed(ev)).to_equal(true)

    it "maps a held middle button to a MIDDLE motion-shaped event":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps a held middle button to a MIDDLE motion-shaped event")
        var m = motion_event(13, 23)
        m.middle_pressed = true
        val ev = host_pointer_event_from_ps2(m)
        expect(btn(ev)).to_equal(HOST_BTN_MIDDLE)
        expect(is_pressed(ev)).to_equal(true)

    it "maps pure motion to button NONE with pressed true":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps pure motion to button NONE with pressed true")
        # `button: NONE, pressed: true` is the canonical move encoding -- that
        # pair, not `pressed: false`, is how the reducer tells move from press.
        val ev = host_pointer_event_from_ps2(motion_event(14, 24))
        expect(btn(ev)).to_equal(HOST_BTN_NONE)
        expect(is_pressed(ev)).to_equal(true)
        expect(wheel_of(ev)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "carries the wheel through without negating it":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: carries the wheel through without negating it")
        # PS/2 positive Z and HostInputEvent positive wheel BOTH mean
        # "content scrolls down". Any negation here scrolls backwards.
        var down = motion_event(1, 1)
        down.wheel = 1
        expect(wheel_of(host_pointer_event_from_ps2(down))).to_equal(1)  # oracle: 1 — named expected value from the requirement
        var up = motion_event(1, 1)
        up.wheel = -1
        expect(wheel_of(host_pointer_event_from_ps2(up))).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    it "prefers the press edge over a concurrently held middle button":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: prefers the press edge over a concurrently held middle button")
        var m = motion_event(2, 3)
        m.left_just_pressed = true
        m.middle_pressed = true
        expect(btn(host_pointer_event_from_ps2(m))).to_equal(HOST_BTN_LEFT)

describe "PS/2 keyboard -> HostInputEvent collapse":
    it "maps a press with a printable character":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps a press with a printable character")
        val ev = host_key_event_from_ps2(
            KeyEvent.Press(Key.A), "a", false, false, false
        )
        match ev:
            HostInputEvent.Key(code, ch, down, mods):
                expect(ch).to_equal("a")
                expect(down).to_equal(true)
                expect(mods).to_equal(0)  # oracle: 0 — named expected value from the requirement
            _:
                expect("not-key").to_equal("key")

    it "maps a release to down=false":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps a release to down=false")
        val ev = host_key_event_from_ps2(
            KeyEvent.Release(Key.A), "", false, false, false
        )
        match ev:
            HostInputEvent.Key(code, ch, down, mods):
                expect(down).to_equal(false)
            _:
                expect("not-key").to_equal("key")

    it "packs held modifiers into mods":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: packs held modifiers into mods")
        val ev = host_key_event_from_ps2(
            KeyEvent.Press(Key.C), "c", true, true, true
        )
        match ev:
            HostInputEvent.Key(code, ch, down, mods):
                expect(mods_has_shift(mods)).to_equal(true)
                expect(mods_has_ctrl(mods)).to_equal(true)
                expect(mods_has_alt(mods)).to_equal(true)
            _:
                expect("not-key").to_equal("key")

    it "fills Key.code from the canonical code space, not a local table":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: fills Key.code from the canonical code space, not a local table")
        # `ps2_key_code` delegates to ps2_keyboard.key_to_canon
        # (common.ui.key_code, Windows VK / W3C keyCode). Letters must get a
        # real code -- an earlier local table here returned 0 for every letter,
        # digit and function key, which is the failure this pins.
        expect(ps2_key_code(Key.Backspace)).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(ps2_key_code(Key.Enter)).to_equal(13)  # oracle: 13 — named expected value from the requirement
        expect(ps2_key_code(Key.Escape)).to_equal(27)  # oracle: 27 — named expected value from the requirement
        expect(ps2_key_code(Key.Left)).to_equal(37)  # oracle: 37 — named expected value from the requirement
        expect(ps2_key_code(Key.Down)).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(ps2_key_code(Key.Delete)).to_equal(46)  # oracle: 46 — named expected value from the requirement
        expect(ps2_key_code(Key.A)).to_equal(65)  # oracle: 65 — named expected value from the requirement
        expect(ps2_key_code(Key.Unknown)).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "mods_pack bit layout":
    it "round-trips each flag independently":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: round-trips each flag independently")
        expect(mods_pack(shift: true, ctrl: false, alt: false, meta: false)).to_equal(HOST_MOD_SHIFT)
        expect(mods_pack(shift: false, ctrl: true, alt: false, meta: false)).to_equal(HOST_MOD_CTRL)
        expect(mods_pack(shift: false, ctrl: false, alt: true, meta: false)).to_equal(HOST_MOD_ALT)
        expect(mods_pack(shift: false, ctrl: false, alt: false, meta: false)).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ORs combinations":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: ORs combinations")
        val m = mods_pack(shift: true, ctrl: true, alt: false, meta: false)
        expect(mods_has_shift(m)).to_equal(true)
        expect(mods_has_ctrl(m)).to_equal(true)
        expect(mods_has_alt(m)).to_equal(false)
