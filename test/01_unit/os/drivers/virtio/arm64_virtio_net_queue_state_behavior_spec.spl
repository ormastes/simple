# Purpose and audience: executable host proof of the ARM64 VirtIO TX queue lifecycle.
# @req REQ-SSPEC-UNIT

use std.spec

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)


describe "ARM64 VirtIO-MMIO TX queue lifecycle":
    it "publishes by avail position and reclaims delayed completions":
        val output = "/tmp/arm64_virtio_net_queue_state_test"
        val (compile_out, compile_err, compile_code) = rt_process_run("cc", [
            "-std=c11", "-Wall", "-Wextra", "-Werror", "-O2", "-fuse-ld=bfd",
            "test/fixtures/os/arm64_virtio_net_queue_state_test.c",
            "-o", output,
        ])
        expect(compile_code).to_equal(0)
        expect(compile_out).to_equal("")
        expect(compile_err).to_equal("")
        val (_run_out, run_err, run_code) = rt_process_run(output, [])
        expect(run_code).to_equal(0)
        expect(run_err).to_equal("")
