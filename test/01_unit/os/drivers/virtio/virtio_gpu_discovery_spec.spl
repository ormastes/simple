# @req: REQ-OS-DRIVERS-001

"""Bounded VirtIO-GPU DEVICE_CFG/shared-memory discovery contracts."""

use std.spec.*
use os.drivers.virtio.virtio_gpu_discovery.{
    VirtioGpuDiscoveryState, VirtioGpuPciCapability, VirtioGpuDiscoveryProvider,
    VirtioGpuDeviceConfigSample,
    virtio_gpu_feature_conjunction_ready, virtio_gpu_validate_pci_capability,
    virtio_gpu_device_config_address, virtio_gpu_map_shared_memory,
    virtio_gpu_admit_device_config, virtio_gpu_build_discovery_receipt
}
use os.drivers.virtio.virtio_gpu_capset.{GpuCapset}
use os.drivers.virtio.virtio_gpu_regs.{
    VIRTIO_PCI_CAP_DEVICE_CFG, VIRTIO_PCI_CAP_SHARED_MEMORY_CFG,
    VIRTIO_GPU_SHM_ID_HOST_VISIBLE
}
use os.drivers.virtio.virtio_gpu_types.{
    VIRTIO_GPU_F_VIRGL, VIRTIO_GPU_F_RESOURCE_BLOB,
    VIRTIO_GPU_F_CONTEXT_INIT, VIRTIO_GPU_CAPSET_VENUS
}

fn bar_bases() -> List<u64>:
    [0x10000000, 0, 0, 0, 0x20000000, 0]

fn bar_sizes() -> List<u64>:
    [0x10000, 0, 0, 0, 0x10000, 0]

fn device_cap(source: u8 = 0x50) -> VirtioGpuPciCapability:
    VirtioGpuPciCapability(
        cfg_type: VIRTIO_PCI_CAP_DEVICE_CFG,
        bar: 0,
        cap_id: 0,
        cap_len: 16,
        offset: 0x100,
        length: 16,
        source_offset: source
    )

fn host_visible_cap(source: u8 = 0x60) -> VirtioGpuPciCapability:
    VirtioGpuPciCapability(
        cfg_type: VIRTIO_PCI_CAP_SHARED_MEMORY_CFG,
        bar: 4,
        cap_id: VIRTIO_GPU_SHM_ID_HOST_VISIBLE,
        cap_len: 24,
        offset: 0x1000,
        length: 0x2000,
        source_offset: source
    )

fn stable_sample(num_capsets: u32 = 1) -> VirtioGpuDeviceConfigSample:
    VirtioGpuDeviceConfigSample(
        events_read: 0,
        num_scanouts: 1,
        num_capsets: num_capsets,
        generation_before: 7,
        generation_after: 7
    )

fn venus_capset(size: u32 = 2048) -> GpuCapset:
    GpuCapset(id: VIRTIO_GPU_CAPSET_VENUS, max_version: 1, max_size: size)

fn required_features() -> u32:
    VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_RESOURCE_BLOB | VIRTIO_GPU_F_CONTEXT_INIT

use std.spec.step

describe "VirtIO-GPU capability admission":
    it "accepts a contained DEVICE_CFG capability":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: accepts a contained DEVICE_CFG capability")
        expect(virtio_gpu_validate_pci_capability(device_cap(), bar_sizes()).is_ok()).to_equal(true)
        expect(virtio_gpu_device_config_address(device_cap(), bar_bases(), bar_sizes()).unwrap()).to_equal(0x10000100)

    it "maps host-visible shared memory with provenance":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: maps host-visible shared memory with provenance")
        val region = virtio_gpu_map_shared_memory(host_visible_cap(), bar_bases(), bar_sizes()).unwrap()
        expect(region.shmid).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(region.bar).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(region.phys_base).to_equal(0x20001000)
        expect(region.byte_len).to_equal(0x2000)
        expect(region.containment_proven).to_equal(true)

    it "rejects short, reserved-BAR and zero-length capabilities":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects short, reserved-BAR and zero-length capabilities")
        var short = device_cap()
        short.cap_len = 15
        expect(virtio_gpu_validate_pci_capability(short, bar_sizes()).unwrap_err()).to_equal("cap-too-short")
        var reserved = device_cap()
        reserved.bar = 6
        expect(virtio_gpu_validate_pci_capability(reserved, bar_sizes()).unwrap_err()).to_equal("reserved-bar")
        var zero = device_cap()
        zero.length = 0
        expect(virtio_gpu_validate_pci_capability(zero, bar_sizes()).unwrap_err()).to_equal("zero-length-capability")

    it "rejects a capability outside its BAR":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects a capability outside its BAR")
        var outside = host_visible_cap()
        outside.offset = 0xF000
        outside.length = 0x2000
        expect(virtio_gpu_validate_pci_capability(outside, bar_sizes()).unwrap_err()).to_equal("bar-containment-unproven")

describe "VirtIO-GPU stable device config":
    it "accepts the second sample after one generation retry":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: accepts the second sample after one generation retry")
        var stale = stable_sample()
        stale.generation_after = 8
        val config = virtio_gpu_admit_device_config([stale, stable_sample()]).unwrap()
        expect(config.num_capsets).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(config.attempts).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "rejects three unstable generations":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects three unstable generations")
        var stale = stable_sample()
        stale.generation_after = 8
        expect(virtio_gpu_admit_device_config([stale, stale, stale]).unwrap_err()).to_equal("config-generation-unstable")

    it "rejects a host count above 64":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects a host count above 64")
        expect(virtio_gpu_admit_device_config([stable_sample(65)]).unwrap_err()).to_equal("capset-count-over-limit")

describe "VirtIO-GPU typed discovery receipt":
    it "caches a receipt for one device lifetime and invalidates it on reset":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: caches a receipt for one device lifetime and invalidates it on reset")
        var provider = VirtioGpuDiscoveryProvider.create(bar_bases(), bar_sizes())
        expect(provider.cached_receipt() == nil).to_equal(true)
        val receipt = provider.discover(
            [device_cap(), host_visible_cap()], [stable_sample()],
            required_features(), [venus_capset()]
        )
        expect(receipt.state).to_equal(VirtioGpuDiscoveryState.VenusDiscovered)
        expect(provider.cached_receipt() == nil).to_equal(false)
        provider.reset()
        expect(provider.cached_receipt() == nil).to_equal(true)

    it "records a complete candidate but never claims execution or readback":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: records a complete candidate but never claims execution or readback")
        val receipt = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [venus_capset()]
        )
        expect(receipt.state).to_equal(VirtioGpuDiscoveryState.VenusDiscovered)
        expect(receipt.reason).to_equal("venus-candidate-unclassified")
        expect(receipt.device_config!.mapped_address).to_equal(0x10000100)
        expect(receipt.complete).to_equal(true)
        expect(receipt.vulkan_executed).to_equal(false)
        expect(receipt.device_readback).to_equal(false)
        expect(receipt.fallback_used).to_equal(false)

    it "keeps transport ready when the feature conjunction is incomplete":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: keeps transport ready when the feature conjunction is incomplete")
        val receipt = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample()], VIRTIO_GPU_F_VIRGL, [venus_capset()]
        )
        expect(virtio_gpu_feature_conjunction_ready(VIRTIO_GPU_F_VIRGL)).to_equal(false)
        expect(receipt.state).to_equal(VirtioGpuDiscoveryState.TransportReady)
        expect(receipt.reason).to_equal("venus-features-incomplete")

    it "rejects duplicate capability offsets as a loop":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects duplicate capability offsets as a loop")
        val receipt = virtio_gpu_build_discovery_receipt(
            [device_cap(0x50), host_visible_cap(0x50)], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [venus_capset()]
        )
        expect(receipt.state).to_equal(VirtioGpuDiscoveryState.Rejected)
        expect(receipt.reason).to_equal("pci-cap-loop")

    it "rejects more than 48 capability records":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects more than 48 capability records")
        var caps: List<VirtioGpuPciCapability> = []
        var i: u8 = 0
        while i < 49:
            caps.push(device_cap(0x40 + i))
            i = i + 1
        val receipt = virtio_gpu_build_discovery_receipt(caps, bar_bases(), bar_sizes(), [stable_sample()], required_features(), [venus_capset()])
        expect(receipt.reason).to_equal("pci-cap-limit")

    it "rejects duplicate DEVICE_CFG and host-visible regions":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects duplicate DEVICE_CFG and host-visible regions")
        val duplicate_device = virtio_gpu_build_discovery_receipt(
            [device_cap(), device_cap(0x54)], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [venus_capset()]
        )
        expect(duplicate_device.reason).to_equal("device-config-duplicate")
        val duplicate_host = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap(), host_visible_cap(0x70)],
            bar_bases(), bar_sizes(), [stable_sample()], required_features(), [venus_capset()]
        )
        expect(duplicate_host.reason).to_equal("host-visible-region-duplicate")

    it "reports missing DEVICE_CFG and missing host-visible memory distinctly":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: reports missing DEVICE_CFG and missing host-visible memory distinctly")
        val no_config = virtio_gpu_build_discovery_receipt(
            [host_visible_cap()], bar_bases(), bar_sizes(), [stable_sample()], required_features(), [venus_capset()]
        )
        expect(no_config.state).to_equal(VirtioGpuDiscoveryState.Unavailable)
        expect(no_config.reason).to_equal("device-config-missing")
        val no_host = virtio_gpu_build_discovery_receipt(
            [device_cap()], bar_bases(), bar_sizes(), [stable_sample()], required_features(), [venus_capset()]
        )
        expect(no_host.state).to_equal(VirtioGpuDiscoveryState.Partial)
        expect(no_host.reason).to_equal("host-visible-region-missing")

    it "distinguishes partial and overrun capset responses":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: distinguishes partial and overrun capset responses")
        val partial = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample(2)], required_features(), [venus_capset()]
        )
        expect(partial.reason).to_equal("capset-query-partial")
        val overrun = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample(0)], required_features(), [venus_capset()]
        )
        expect(overrun.reason).to_equal("capset-response-overrun")

    it "does not infer Venus from a complete non-Venus capset table":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: does not infer Venus from a complete non-Venus capset table")
        val virgl = GpuCapset(id: 2, max_version: 1, max_size: 1024)
        val receipt = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [virgl]
        )
        expect(receipt.state).to_equal(VirtioGpuDiscoveryState.TransportReady)
        expect(receipt.reason).to_equal("venus-candidate-missing")

    it "rejects empty, oversized and duplicate Venus candidates":
        # @req: REQ-OS-DRIVERS-001
        step("Verify: rejects empty, oversized and duplicate Venus candidates")
        val empty = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [venus_capset(0)]
        )
        expect(empty.reason).to_equal("venus-candidate-empty")
        val oversized = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample()], required_features(), [venus_capset(4073)]
        )
        expect(oversized.reason).to_equal("capset-payload-over-limit")
        val duplicate = virtio_gpu_build_discovery_receipt(
            [device_cap(), host_visible_cap()], bar_bases(), bar_sizes(),
            [stable_sample(2)], required_features(), [venus_capset(), venus_capset(1024)]
        )
        expect(duplicate.reason).to_equal("venus-candidate-duplicate")
