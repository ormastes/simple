"""
# VirtIO-GPU Feature Negotiation and Capset Encoding Specification

**Feature IDs:** #OS-VIRTIO-GPU-VENUS
**Category:** Infrastructure
**Difficulty:** 3/5

## Overview

Covers the WS-E1 pure layer of the virtio-gpu driver: the device-feature
negotiation mask (which bits get ACKed for which host offer) and the
little-endian wire encoding/decoding of the GET_CAPSET_INFO / GET_CAPSET
request pair and the RESP_OK_CAPSET_INFO response.

These are pure functions over integers and byte lists, so they are testable
with no device, no DMA and no QEMU — which matters because this host cannot
instantiate a 3D-capable virtio-gpu at all (see
`doc/08_tracking/bug/simpleos_vulkan_board_gap_venus_is_qemu_only.md`).

The single most important case here is the **2D regression guard**: a host that
offers none of the wanted bits must yield an acked mask of exactly 0, which is
byte-identical to the pre-E1 behavior of writing a hardcoded 0.
"""

use std.spec.*
use os.drivers.virtio.virtio_gpu_capset.{
    GpuCapset,
    gpu_negotiate_features, gpu_features_have_3d, gpu_features_have_blob,
    gpu_features_have_ctx_init, gpu_features_venus_capable,
    gpu_capset_count_valid, gpu_capset_payload_size_valid,
    gpu_le32_read, gpu_le32_write, gpu_zero_buffer,
    gpu_encode_get_capset_info, gpu_encode_get_capset,
    gpu_response_type, gpu_decode_capset_info, gpu_find_venus
}
use os.drivers.virtio.virtio_gpu_types.{
    VIRTIO_GPU_F_VIRGL, VIRTIO_GPU_F_EDID, VIRTIO_GPU_F_RESOURCE_UUID,
    VIRTIO_GPU_F_RESOURCE_BLOB, VIRTIO_GPU_F_CONTEXT_INIT,
    VIRTIO_GPU_CMD_GET_CAPSET_INFO, VIRTIO_GPU_CMD_GET_CAPSET,
    VIRTIO_GPU_RESP_OK_CAPSET_INFO, VIRTIO_GPU_RESP_OK_NODATA,
    VIRTIO_GPU_CAPSET_VIRGL, VIRTIO_GPU_CAPSET_VIRGL2, VIRTIO_GPU_CAPSET_VENUS,
    GET_CAPSET_INFO_SIZE, GET_CAPSET_SIZE, RESP_CAPSET_INFO_SIZE
}

# ============================================================================
# Test Group 1: feature negotiation mask
# ============================================================================

describe "gpu_negotiate_features":
    it "acks nothing when the host offers nothing (2D regression guard)":
        expect(gpu_negotiate_features(0)).to_equal(0)

    it "acks exactly virgl|blob|context_init when the host offers everything":
        # 0xFFFFFFFF offers every bit; we must still ack only our three.
        expect(gpu_negotiate_features(0xFFFFFFFF)).to_equal(0x19)

    it "acks only VIRGL when only VIRGL is offered":
        expect(gpu_negotiate_features(VIRTIO_GPU_F_VIRGL)).to_equal(VIRTIO_GPU_F_VIRGL)

    it "never acks EDID or RESOURCE_UUID even when offered":
        val offered = VIRTIO_GPU_F_EDID | VIRTIO_GPU_F_RESOURCE_UUID
        expect(gpu_negotiate_features(offered)).to_equal(0)

    it "drops unwanted bits but keeps wanted ones from a mixed offer":
        val offered = VIRTIO_GPU_F_EDID | VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_RESOURCE_BLOB
        expect(gpu_negotiate_features(offered)).to_equal(VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_RESOURCE_BLOB)

    it "never acks a bit the host did not offer":
        # blob+ctx_init offered, virgl NOT offered -> virgl must not appear
        val offered = VIRTIO_GPU_F_RESOURCE_BLOB | VIRTIO_GPU_F_CONTEXT_INIT
        val acked = gpu_negotiate_features(offered)
        expect(gpu_features_have_3d(acked)).to_equal(false)
        expect(gpu_features_have_blob(acked)).to_equal(true)

describe "feature predicates":
    it "reports all three false for an empty ack":
        expect(gpu_features_have_3d(0)).to_equal(false)
        expect(gpu_features_have_blob(0)).to_equal(false)
        expect(gpu_features_have_ctx_init(0)).to_equal(false)

    it "reports each predicate independently":
        expect(gpu_features_have_3d(VIRTIO_GPU_F_VIRGL)).to_equal(true)
        expect(gpu_features_have_blob(VIRTIO_GPU_F_VIRGL)).to_equal(false)
        expect(gpu_features_have_ctx_init(VIRTIO_GPU_F_CONTEXT_INIT)).to_equal(true)

describe "gpu_features_venus_capable":
    it "requires all three of virgl, blob and context_init":
        expect(gpu_features_venus_capable(0x19)).to_equal(true)

    it "is false when context_init is missing":
        expect(gpu_features_venus_capable(VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_RESOURCE_BLOB)).to_equal(false)

    it "is false when blob is missing":
        expect(gpu_features_venus_capable(VIRTIO_GPU_F_VIRGL | VIRTIO_GPU_F_CONTEXT_INIT)).to_equal(false)

    it "is false for a 2D-only device":
        expect(gpu_features_venus_capable(0)).to_equal(false)

describe "bounded capset admission":
    it "admits at most 64 capset descriptors":
        expect(gpu_capset_count_valid(0)).to_equal(true)
        expect(gpu_capset_count_valid(64)).to_equal(true)
        expect(gpu_capset_count_valid(65)).to_equal(false)

    it "admits payloads from 1 through 4072 bytes":
        expect(gpu_capset_payload_size_valid(0)).to_equal(false)
        expect(gpu_capset_payload_size_valid(1)).to_equal(true)
        expect(gpu_capset_payload_size_valid(4072)).to_equal(true)
        expect(gpu_capset_payload_size_valid(4073)).to_equal(false)

# ============================================================================
# Test Group 2: little-endian byte helpers
# ============================================================================

describe "gpu_le32 helpers":
    it "round-trips a u32 through write then read":
        var buf = gpu_zero_buffer(8)
        buf = gpu_le32_write(buf, 4, 0xDEADBEEF)
        expect(gpu_le32_read(buf, 4)).to_equal(0xDEADBEEF)

    it "writes little-endian byte order":
        var buf = gpu_zero_buffer(4)
        buf = gpu_le32_write(buf, 0, 0x11223344)
        expect(buf[0]).to_equal(0x44)
        expect(buf[1]).to_equal(0x33)
        expect(buf[2]).to_equal(0x22)
        expect(buf[3]).to_equal(0x11)

    it "leaves neighboring bytes untouched":
        var buf = gpu_zero_buffer(12)
        buf = gpu_le32_write(buf, 4, 0xFFFFFFFF)
        expect(gpu_le32_read(buf, 0)).to_equal(0)
        expect(gpu_le32_read(buf, 8)).to_equal(0)

    it "reads 0 past the end of a short buffer instead of faulting":
        val buf = gpu_zero_buffer(2)
        expect(gpu_le32_read(buf, 0)).to_equal(0)

    it "allocates a zero buffer of the requested length":
        expect(gpu_zero_buffer(40).len()).to_equal(40)

# ============================================================================
# Test Group 3: request encoding
# ============================================================================

describe "gpu_encode_get_capset_info":
    it "is 32 bytes long":
        expect(gpu_encode_get_capset_info(0).len()).to_equal(32)

    it "puts GET_CAPSET_INFO (0x0108) in the ctrl-hdr type field":
        expect(gpu_le32_read(gpu_encode_get_capset_info(0), 0)).to_equal(0x0108)

    it "places capset_index at offset 24":
        expect(gpu_le32_read(gpu_encode_get_capset_info(3), 24)).to_equal(3)

    it "zeroes the ctrl-hdr flags/fence/ctx fields":
        val buf = gpu_encode_get_capset_info(1)
        expect(gpu_le32_read(buf, 4)).to_equal(0)
        expect(gpu_le32_read(buf, 8)).to_equal(0)
        expect(gpu_le32_read(buf, 16)).to_equal(0)

    it "zeroes the trailing padding at offset 28":
        expect(gpu_le32_read(gpu_encode_get_capset_info(2), 28)).to_equal(0)

describe "gpu_encode_get_capset":
    it "is 32 bytes long":
        expect(gpu_encode_get_capset(VIRTIO_GPU_CAPSET_VENUS, 0).len()).to_equal(32)

    it "puts GET_CAPSET (0x0109) in the ctrl-hdr type field":
        expect(gpu_le32_read(gpu_encode_get_capset(4, 0), 0)).to_equal(0x0109)

    it "places capset_id at 24 and capset_version at 28":
        val buf = gpu_encode_get_capset(4, 7)
        expect(gpu_le32_read(buf, 24)).to_equal(4)
        expect(gpu_le32_read(buf, 28)).to_equal(7)

    it "encodes the virgl2 capset id distinctly from venus":
        expect(gpu_le32_read(gpu_encode_get_capset(VIRTIO_GPU_CAPSET_VIRGL2, 1), 24)).to_equal(2)
        expect(gpu_le32_read(gpu_encode_get_capset(VIRTIO_GPU_CAPSET_VENUS, 1), 24)).to_equal(4)

# ============================================================================
# Test Group 4: response decoding
# ============================================================================

describe "gpu_decode_capset_info":
    it "decodes id, max_version and max_size from a well-formed response":
        var buf = gpu_zero_buffer(RESP_CAPSET_INFO_SIZE)
        buf = gpu_le32_write(buf, 0, VIRTIO_GPU_RESP_OK_CAPSET_INFO)
        buf = gpu_le32_write(buf, 24, 4)
        buf = gpu_le32_write(buf, 28, 1)
        buf = gpu_le32_write(buf, 32, 2048)
        val r = gpu_decode_capset_info(buf)
        expect(r.is_ok()).to_equal(true)
        val cap = r.unwrap()
        expect(cap.id).to_equal(4)
        expect(cap.max_version).to_equal(1)
        expect(cap.max_size).to_equal(2048)

    it "rejects a buffer shorter than 40 bytes":
        var buf = gpu_zero_buffer(24)
        buf = gpu_le32_write(buf, 0, VIRTIO_GPU_RESP_OK_CAPSET_INFO)
        expect(gpu_decode_capset_info(buf).is_err()).to_equal(true)

    it "rejects RESP_OK_NODATA — a parsed command is not a returned capset":
        var buf = gpu_zero_buffer(RESP_CAPSET_INFO_SIZE)
        buf = gpu_le32_write(buf, 0, VIRTIO_GPU_RESP_OK_NODATA)
        expect(gpu_decode_capset_info(buf).is_err()).to_equal(true)

    it "rejects an error response":
        var buf = gpu_zero_buffer(RESP_CAPSET_INFO_SIZE)
        buf = gpu_le32_write(buf, 0, 0x1200)
        expect(gpu_decode_capset_info(buf).is_err()).to_equal(true)

    it "reads the response type from the first LE u32":
        var buf = gpu_zero_buffer(RESP_CAPSET_INFO_SIZE)
        buf = gpu_le32_write(buf, 0, VIRTIO_GPU_RESP_OK_CAPSET_INFO)
        expect(gpu_response_type(buf)).to_equal(0x1102)

# ============================================================================
# Test Group 5: venus lookup over a discovered table
# ============================================================================

describe "gpu_find_venus":
    it "finds the venus capset among several":
        val caps = [
            GpuCapset(id: VIRTIO_GPU_CAPSET_VIRGL, max_version: 1, max_size: 512),
            GpuCapset(id: VIRTIO_GPU_CAPSET_VIRGL2, max_version: 2, max_size: 1024),
            GpuCapset(id: VIRTIO_GPU_CAPSET_VENUS, max_version: 1, max_size: 2048)
        ]
        val found = gpu_find_venus(caps)
        expect(found == nil).to_equal(false)
        expect(found!.id).to_equal(4)
        expect(found!.max_size).to_equal(2048)

    it "returns nil when no venus capset is present (virgl-only device)":
        val caps = [
            GpuCapset(id: VIRTIO_GPU_CAPSET_VIRGL, max_version: 1, max_size: 512),
            GpuCapset(id: VIRTIO_GPU_CAPSET_VIRGL2, max_version: 2, max_size: 1024)
        ]
        expect(gpu_find_venus(caps) == nil).to_equal(true)

    it "returns nil for an empty capset table":
        val caps: List<GpuCapset> = []
        expect(gpu_find_venus(caps) == nil).to_equal(true)

describe "GpuCapset predicates":
    it "identifies a venus capset by id 4":
        expect(GpuCapset(id: 4, max_version: 1, max_size: 8).is_venus()).to_equal(true)
        expect(GpuCapset(id: 2, max_version: 1, max_size: 8).is_venus()).to_equal(false)

    it "flags an advertised-but-unservable capset (max_size 0)":
        expect(GpuCapset(id: 4, max_version: 1, max_size: 0).is_empty()).to_equal(true)
        expect(GpuCapset(id: 4, max_version: 1, max_size: 2048).is_empty()).to_equal(false)
