"""The RV64 VirtIO-net driver must negotiate the modern feature word safely."""

use std.spec.{describe, it, expect}

describe "VirtIO-net modern feature negotiation":
    it "requires and acknowledges VIRTIO_F_VERSION_1 in feature word one":
        val source = file_read("src/os/drivers/virtio/_VirtioNet/driver_operations.spl")
        val constants = file_read("src/os/drivers/virtio/_VirtioNet/driver_struct.spl")
        expect(constants).to_contain("val VIRTIO_F_VERSION_1: u64 = 1u64 << 32u64")
        expect(constants).to_contain("val VIRTIO_F_VERSION_1_WORD1: u32 = 1u32")
        expect(source).to_contain("val host_features_word1 = self.read_host_features_word(1u32)")
        expect(source).to_contain("if (host_features_word1 & VIRTIO_F_VERSION_1_WORD1) == 0u32")
        expect(source).to_contain("self.write_guest_features_word(1u32, VIRTIO_F_VERSION_1_WORD1)")
        expect(source).to_contain("VIRTIO_F_VERSION_1 unavailable on modern virtio-net")

    it "does not accept unsupported low-word offloads and fails closed on rejection":
        val source = file_read("src/os/drivers/virtio/_VirtioNet/driver_operations.spl")
        expect(source).to_contain("host_features_word0 & (VIRTIO_NET_F_MAC | VIRTIO_NET_F_STATUS)")
        expect(source).to_contain("virtio-net MAC feature unavailable")
        expect(source).to_contain("if (current_status & VIRTIO_STATUS_FEATURES_OK) == 0")
        expect(source).to_contain("self.write_status(VIRTIO_STATUS_FAILED)")
        expect(source).to_contain("self.modern_device_virt + MODERN_VIRTIO_NET_STATUS_OFFSET")
