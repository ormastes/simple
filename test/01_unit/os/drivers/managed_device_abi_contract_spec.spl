use std.spec.{describe, it, expect}
use std.fs.{read_file}

describe "managed storage/network driver device ABI":
    it "maps VirtIO-net BAR0 by exact granted BDF and index":
        val source = read_file("src/os/drivers/virtio/_VirtioNet/driver_operations.spl")
        expect(source).to_contain("syscall(83, self.device_bdf, 0u64, 0u64, 0u64, 0u64)")
        expect(source).to_not_contain("syscall(83, grant.bar0_phys, grant.bar0_size")

    it "maps NVMe BAR0 by exact granted BDF and refuses ambient DMA fallback when managed":
        val source = read_file("src/os/drivers/nvme/_NvmeDriver/driver_operations.spl")
        expect(source).to_contain("syscall(SYS_MAP_BAR, self.device_bdf, 0u64, 0u64, 0u64, 0u64)")
        expect(source).to_contain("syscall(SYS_ALLOC_DMA, size, result_ptr, self.device_bdf, 0, 0)")
        expect(source).to_contain("if self.device_bdf != 0u64:")
        expect(source).to_contain("return Result.Err(\"managed DMA allocation failed\")")
        expect(source).to_not_contain("syscall(SYS_MAP_BAR, grant.bar0_phys, grant.bar0_size")
