# Purpose and audience: executable regression specification for QEMU runner formal verification delegation without external QEMU execution.
# @req REQ-SSPEC-UNIT
# @tag:unit
# @tag:os
# @tag:riscv

use std.spec.{describe, it, expect}
use os.qemu_runner.{verify_qemu_formal_output}
use os._QemuRunner.os_build_run.{verify_qemu_formal_output as obr_verify_qemu_formal_output}
use os.kernel.hal.arch_context.{Architecture}

describe "OS QEMU runner formal proof contract delegation":
    it "verifies RV64 user-mode proof markers via os.qemu_runner and os_build_run":
        val transcript = "[KERNEL] trap vector installed\n" +
            "[KERNEL] trap runtime installed\n" +
            "[KERNEL] spawned user task id=1\n" +
            "[KERNEL] entering U-mode\n" +
            "P\n" +
            "[BOOT] RISC-V 64 boot complete\n"
        val res1 = verify_qemu_formal_output(Architecture.Riscv64, transcript)
        expect(res1.is_ok()).to_equal(true)
        expect(res1.unwrap()).to_equal("[rv64-qemu] verified 6 proof markers")

        val res2 = obr_verify_qemu_formal_output(Architecture.Riscv64, transcript)
        expect(res2.is_ok()).to_equal(true)
        expect(res2.unwrap()).to_equal("[rv64-qemu] verified 6 proof markers")

    it "rejects incomplete RV64 transcripts and names the missing marker":
        val incomplete = "[KERNEL] trap vector installed\n[KERNEL] trap runtime installed\n"
        val err_res = verify_qemu_formal_output(Architecture.Riscv64, incomplete)
        expect(err_res.is_err()).to_equal(true)
        expect(err_res.unwrap_err()).to_equal("[rv64-qemu] missing proof marker: spawned user task")

    it "returns non-failing summary for architectures without a QEMU formal contract":
        val x64 = verify_qemu_formal_output(Architecture.X86_64, "")
        expect(x64.is_ok()).to_equal(true)
        expect(x64.unwrap()).to_equal("no formal qemu contract for x86_64")

        val rv32 = verify_qemu_formal_output(Architecture.Riscv32, "")
        expect(rv32.is_ok()).to_equal(true)
        expect(rv32.unwrap()).to_equal("no formal qemu contract for riscv32")
