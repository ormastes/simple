"""
Focused source regression for the ARM64/RV64 generated-theme installation gap.

This check is intentionally lightweight: it proves each production entry owns
exactly one generated-theme install and that installation precedes VFS theme
override work and Engine2D creation. Live QEMU boot evidence is deferred to the
architecture-specific SimpleOS admission lanes.
"""

use std.io_runtime.{file_read}
use std.spec.*


fn occurrence_count(source: text, needle: text) -> i64:
    var count = 0
    var remainder = source
    while remainder.contains(needle):
        val position = remainder.index_of(needle)
        count = count + 1
        remainder = remainder.slice(position + needle.len(), remainder.len())
    count


describe "SimpleOS cross-architecture generated theme installation":

    it "installs the generated theme once before ARM64 override and engine creation":
        val source = file_read("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        val call = "install_generated_simpleos_wm_theme()"
        val install = source.index_of(call)
        val override = source.index_of("apply_simpleos_css_theme_override(theme_css)")
        val engine = source.index_of("var engine = create_fb_engine_sized(")

        expect(occurrence_count(source, call)).to_equal(1)
        expect(install).to_be_greater_than(0)
        expect(override).to_be_greater_than(install)
        expect(engine).to_be_greater_than(override)

    it "installs the generated theme once before RV64 VFS and engine creation":
        val source = file_read("examples/09_embedded/simple_os/arch/riscv64/gui_entry_desktop.spl")
        val call = "install_generated_simpleos_wm_theme()"
        val install = source.index_of(call)
        val mount = source.index_of("vfs_boot_init_riscv64_virtio_fat32()")
        val engine = source.index_of("var engine = create_fb_engine_sized(")

        expect(occurrence_count(source, call)).to_equal(1)
        expect(install).to_be_greater_than(0)
        expect(mount).to_be_greater_than(install)
        expect(engine).to_be_greater_than(mount)
