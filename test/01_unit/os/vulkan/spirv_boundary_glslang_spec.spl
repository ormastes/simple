# @cover src/os/drivers/gpu/board_vulkan/boundary_spirv_provider.spl 80%
# @req REQ-BOARD-VULKAN-001
"""
# SPIR-V Boundary — Candidate Builder vs. glslangValidator

**Category:** OS / GPU driver / counterpart conformance
**Status:** In Progress
**Plan:** doc/03_plan/os/vulkan/board_vulkan_parallel_soc_lanes_2026-08-10.md
**Boundary:** `vulkan.shader.spirv_binary@1`

## Purpose and Audience

The board Vulkan plan names `vulkan.shader.spirv_binary@1` as the first
counterpart boundary every SoC lane must clear, host-only, before any GPU is
involved. This spec answers the question that boundary exists to ask: does
`compiler.backend.vulkan.spirv_builder.SpirvBuilder` — the only Simple source
that emits SPIR-V — produce a module byte-for-byte equivalent (after honest
canonicalization, see `spirv_canonicalize_spec.spl`) to what an independent,
Khronos-authored reference compiler (`glslangValidator`) produces for the
same shader.

## Scope and Preconditions

Host-only, no GPU. The everyday scenarios below need nothing but the
committed fixture (no installed toolchain). The single scenario tagged
"regeneration check" additionally needs `/usr/bin/glslangValidator`,
`/usr/bin/spirv-as`, and `/usr/bin/spirv-val`/`spirv-dis`; when any is
missing that ONE scenario reports its source `unavailable` (never a pass) —
the fixture-backed scenarios are unaffected.

## Primary Workflow

Build the minimal compute shader through `SpirvBuilder`'s own public API and
canonicalize its `build()` text directly (no `spirv-as`/`spirv-dis` round
trip needed — `build()` already emits the same `%id = OpXxx ...` shape
`spirv-dis --no-header` produces; only its `; comment` header lines need
stripping, which the canonicalizer already does — dimension 4,
`assembly_comments`). Compare against the committed counterpart fixture
`test/fixtures/board_vulkan/spirv_boundary/glslang_minimal_compute.spvdis`,
captured from a real `glslangValidator` run — full provenance, exact
commands, toolchain version, and SHA-256 hashes in
`glslang_minimal_compute.provenance.md` next to it.

## Timing note (why this file was split, and why one scenario stays live)

An earlier version of this spec ran the full
`glslangValidator -> spirv-val -> spirv-dis` round trip, TWICE (once per
side), inside every scenario. That measurably could not fit even a 900s
`--no-session-daemon --timeout 900` budget on this host under concurrent
agent load (load average observed 60-90). See
doc/08_tracking/bug/spirv_boundary_glslang_exec_exceeds_900s_daemon_budget_2026-08-11.md.
The fixture removes the subprocess from the everyday path entirely; exactly
one scenario, `spirv_boundary_regenerates_fixture_from_real_glslang`, keeps
the live exec path so the fixture cannot silently drift from what glslang
actually emits without a failing test naming the drift.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Candidate | `SpirvBuilder`, driven directly (no GLSL front end exists in Simple) |
| Counterpart | Committed fixture from `/usr/bin/glslangValidator`, `process_bridge`, group `khronos-glslang` |
| Canonicalization | Named dimensions only: assembly comments, debug-opcode allowlist, id renumbering |
| Sabotage | Flipping the candidate's Z workgroup size literal from 1 to 2 |

## Related Specifications

- [Canonicalizer pure scenarios](spirv_canonicalize_spec.spl) — the transform this comparison relies on
- [Board Vulkan counterpart plans](board_vulkan_counterpart_plan_spec.spl) — the plan/profile layer this boundary belongs to

## Evidence and Provenance

The artifact hash registered for `glslang` in `spirv_glslang_manifest` is the
SHA-256 of the actual `/usr/bin/glslangValidator` binary on THIS host, not a
fabricated value — it may legitimately differ from the version recorded in
the fixture's provenance file if the host toolchain has since been upgraded;
that divergence is exactly what the regeneration-check scenario would catch.

## Recovery and Troubleshooting

A red on "agrees with the glslang fixture on the minimal module" means the
candidate builder emitted something outside the allowed canonicalization
dimensions — a real SPIR-V encoder divergence. Fix the builder, never widen a
canonicalization dimension to hide the diff.

## Compatibility and Limitations

`SpirvBuilder` has no GLSL/HLSL front end, so this spec drives it directly at
the instruction level, deliberately mirroring glslang's unconditional
`gl_WorkGroupSize` builtin-composite encoding rather than relying on the
canonicalizer to erase it.
"""

use std.spec.*
use os.drivers.gpu.board_vulkan.boundary_spirv_provider.{
    GLSLANG_PATH,
    spirv_boundary_compare,
    spirv_boundary_compare_fixture,
    spirv_candidate_disassembly,
    spirv_counterpart_disassembly,
    spirv_glslang_artifact_hash,
    spirv_glslang_component,
    spirv_glslang_manifest,
    spirv_glslang_registry
}
use std.common.spec.evidence.counterpart.model.{OracleAuthority, plan_source, provider_manifest_rejections}
use std.nogc_sync_mut.spec.evidence.counterpart.provider_registry.{
    provider_registry_is_clean,
    provider_registry_select
}
use std.nogc_sync_mut.io_runtime.{file_exists}

describe("spirv boundary provider descriptor"):
    it("names glslang as a process_bridge provider in its own independence group"):
        step("read the glslang provider manifest")
        val manifest = spirv_glslang_manifest()
        assert_equal(manifest.provider_id, "glslang")
        assert_equal(manifest.independence_group, "khronos-glslang")
        assert_not_equal(manifest.independence_group, "mesa")

    it("hashes the real installed glslangValidator binary, never a placeholder"):
        step("read the artifact hash and confirm the pinned executable exists")
        assert_true(file_exists(GLSLANG_PATH))
        val hash = spirv_glslang_artifact_hash()
        assert_true(hash.len() > 0)
        assert_not_equal(hash, "pending")

    it("passes the frozen manifest contract with no rejections"):
        step("run the manifest through the frozen rejection gate")
        assert_equal(provider_manifest_rejections(spirv_glslang_manifest()).len(), 0)

    it("registers cleanly into a provider registry"):
        step("register the glslang descriptor")
        assert_true(provider_registry_is_clean(spirv_glslang_registry()))

    it("resolves a plan source against the registered component"):
        step("select the spirv_binary_glslang component for a plan source naming it")
        val source = plan_source(
            "counterpart", "glslang", "spirv_binary_glslang",
            OracleAuthority.independent_reference, true)
        val selection = provider_registry_select(
            spirv_glslang_registry(), source, spirv_glslang_component().counterpart_boundary_id)
        assert_true(selection.resolved)
        assert_equal(selection.adapter_path, GLSLANG_PATH)

describe("spirv boundary comparison — candidate builder vs committed glslang fixture (no subprocess)"):
    it("agrees with the glslang fixture on the minimal module's canonical form"):
        step("compare canonicalized candidate text against the committed fixture")
        val (agree, _detail) = spirv_boundary_compare_fixture(false, false, false)
        assert_true(agree)

    it("goes RED when the candidate's workgroup size literal is sabotaged"):
        step("flip the candidate's Z workgroup size from 1 to 2 and compare again")
        val (agree, detail) = spirv_boundary_compare_fixture(true, false, false)
        assert_false(agree)
        assert_contains(detail, "LocalSize")

    it("returns to GREEN once the sabotage is reverted"):
        step("compare the unmodified candidate again to prove the sabotage was the only cause")
        val (agree, _detail) = spirv_boundary_compare_fixture(false, false, false)
        assert_true(agree)

    it("closes the hole: a candidate with no OpLabel disagrees with the fixture"):
        step("drop emit_label() and confirm the canonical text no longer matches")
        val (agree, detail) = spirv_boundary_compare_fixture(false, true, false)
        assert_false(agree)
        assert_contains(detail, "OpLabel")

    it("closes the hole: a candidate missing OpExtInstImport disagrees with the fixture"):
        step("drop the ExtInstImport line and confirm the canonical text no longer matches")
        val (agree, detail) = spirv_boundary_compare_fixture(false, false, true)
        assert_false(agree)
        assert_contains(detail, "OpExtInstImport")

describe("spirv boundary comparison — regeneration check (slow, exec-backed, skips cleanly if tools are absent)"):
    it("spirv_boundary_regenerates_fixture_from_real_glslang"):
        step("re-run the real toolchain end to end and compare live output to the committed fixture")
        val (cand_ok, cand_disasm, cand_detail) = spirv_candidate_disassembly(false, false, false)
        val (cp_ok, cp_disasm, cp_detail) = spirv_counterpart_disassembly()
        if not cand_ok:
            assert_contains(cand_detail, "unavailable")
        elif not cp_ok:
            assert_contains(cp_detail, "unavailable")
        else:
            val (agree, detail) = spirv_boundary_compare(false, false, false)
            assert_true(agree)
            assert_contains(cand_disasm, "OpFunctionEnd")
            assert_contains(cp_disasm, "OpFunctionEnd")
