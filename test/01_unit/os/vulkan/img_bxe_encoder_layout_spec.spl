# Board Vulkan — IMG BXE-4-32 submission-envelope encoder: layout spec.
#
# Purpose: prove the encoder in `encoder_img_bxe.spl` produces a
# self-consistent submission envelope — field offsets follow the declared
# dword layout, the packet's size field equals the actual encoded payload,
# and malformed input (bad job type, negative handle/length) is rejected.
# Every oracle here is derived from the FORMAT declaration
# (IMG_BXE_HEADER_DWORDS / IMG_BXE_SYNC_OP_DWORDS / IMG_BXE_DWORD_BYTES and
# the offset functions), never from re-reading the encoder's own output as
# its own proof.
#
# Scope: `img_bxe_job_field_offset`, `img_bxe_sync_op_offset`,
# `img_bxe_job_payload_size`, `img_bxe_job_is_valid`, `img_bxe_encode_job`.
#
# Key Concepts: PowerVR's submission model is firmware-mediated (kernel
# ioctl envelope around an opaque firmware control-stream), so only the
# ENVELOPE is encoded here — see the architectural note at the top of
# encoder_img_bxe.spl for why the firmware-side stream bytes are never
# fabricated.
#
# @req board_vulkan_parallel_soc_lanes_2026-08-10#lane-B2-submit-stage

use std.spec.{describe, it, step, assert_true, assert_false, assert_equal}
use os.drivers.gpu.board_vulkan.encoder_img_bxe.{
    ImgBxeSyncOp, ImgBxeJobDesc, img_bxe_sync_op, img_bxe_job_desc,
    img_bxe_job_field_offset, img_bxe_sync_op_offset, img_bxe_job_payload_size,
    img_bxe_job_is_valid, img_bxe_encode_job,
    IMG_BXE_HEADER_DWORDS, IMG_BXE_SYNC_OP_DWORDS, IMG_BXE_DWORD_BYTES
}

describe("img_bxe submission envelope encoder"):

    it("header field offsets follow the declared dword stride"):
        step("offset of field index 0 is byte 0")
        assert_equal(img_bxe_job_field_offset(0), 0)

        step("offset of field index 4 (stream_len) is 16 bytes in")
        assert_equal(img_bxe_job_field_offset(4), 16)

        step("offsets increase by exactly one dword per index")
        assert_equal(img_bxe_job_field_offset(2) - img_bxe_job_field_offset(1), IMG_BXE_DWORD_BYTES)

    it("sync-op region starts immediately after the header and is 3-dword strided"):
        step("first sync op sits right after the 5-dword header")
        assert_equal(img_bxe_sync_op_offset(IMG_BXE_HEADER_DWORDS, 0), IMG_BXE_HEADER_DWORDS * IMG_BXE_DWORD_BYTES)

        step("second sync op is offset by exactly one sync-op stride")
        val first = img_bxe_sync_op_offset(IMG_BXE_HEADER_DWORDS, 0)
        val second = img_bxe_sync_op_offset(IMG_BXE_HEADER_DWORDS, 1)
        assert_equal(second - first, IMG_BXE_SYNC_OP_DWORDS * IMG_BXE_DWORD_BYTES)

    it("payload size field equals the true encoded byte length, for zero and multiple sync ops"):
        step("zero sync ops: size is exactly the header size")
        val job_a = img_bxe_job_desc("geometry", 1, 2, 64, [])
        assert_equal(img_bxe_job_payload_size(job_a), IMG_BXE_HEADER_DWORDS * IMG_BXE_DWORD_BYTES)

        step("two sync ops: size is header plus two full sync-op strides")
        val ops = [img_bxe_sync_op(9, 0, 1), img_bxe_sync_op(10, 1, 2)]
        val job_b = img_bxe_job_desc("fragment", 1, 2, 128, ops)
        val expected = (IMG_BXE_HEADER_DWORDS + 2 * IMG_BXE_SYNC_OP_DWORDS) * IMG_BXE_DWORD_BYTES
        assert_equal(img_bxe_job_payload_size(job_b), expected)

        step("encoded packet's dword length matches payload_size / dword_bytes exactly")
        val ops_c = [img_bxe_sync_op(9, 0, 1)]
        val job_c = img_bxe_job_desc("compute", 3, 4, 256, ops_c)
        val packet = img_bxe_encode_job(job_c)
        assert_equal(packet.length, img_bxe_job_payload_size(job_c) / IMG_BXE_DWORD_BYTES)

    it("rejects malformed jobs that no real submission could carry"):
        step("unknown job type is rejected")
        val job_bad_type = img_bxe_job_desc("rasterize-everything", 1, 2, 10, [])
        assert_false(img_bxe_job_is_valid(job_bad_type))

        step("negative stream length is rejected")
        val job_bad_len = img_bxe_job_desc("geometry", 1, 2, -1, [])
        assert_false(img_bxe_job_is_valid(job_bad_len))

        step("negative context handle is rejected")
        val job_bad_ctx = img_bxe_job_desc("geometry", -1, 2, 10, [])
        assert_false(img_bxe_job_is_valid(job_bad_ctx))

        step("negative sync-op handle is rejected")
        val job_bad_sync = img_bxe_job_desc("geometry", 1, 2, 10, [img_bxe_sync_op(-5, 0, 0)])
        assert_false(img_bxe_job_is_valid(job_bad_sync))

        step("a well-formed job is accepted")
        val job_ok = img_bxe_job_desc("transfer", 1, 2, 10, [img_bxe_sync_op(5, 0, 1)])
        assert_true(img_bxe_job_is_valid(job_ok))

    it("carries stream length faithfully without fabricating firmware-stream content"):
        step("the opaque blob field states the length but never claims decoded content")
        val job = img_bxe_job_desc("geometry", 1, 2, 512, [])
        val packet = img_bxe_encode_job(job)
        var found = false
        for field in packet.payload:
            if field.name == "opaque_firmware_blob":
                found = field.value == "<512-byte-firmware-ccb-not-decoded>"
        assert_true(found)

    it("packet size field tracks the real header field count (sabotage target: see encoder_img_bxe.spl edit during verification)"):
        step("five header fields are pushed by img_bxe_encode_job: job_type, context_handle, hwrt_data_set_handle, stream_len, opaque_firmware_blob")
        val job = img_bxe_job_desc("geometry", 1, 2, 0, [])
        val packet = img_bxe_encode_job(job)
        assert_equal(packet.payload.len(), 5)

        step("IMG_BXE_HEADER_DWORDS matches that same count of five")
        assert_equal(IMG_BXE_HEADER_DWORDS, 5)
