use std.spec.*
use os.drivers.gpu.board_vulkan.corpus_cases.{CorpusCase, board_vulkan_corpus}
use os.drivers.gpu.board_vulkan.corpus_runner.{CaseVerdict, run_case, case_verdict_is_ok}
use os.drivers.gpu.board_vulkan.corpus_ledger.{SkipEntry, LedgerReport, build_ledger}

# Board Vulkan conformance corpus — CTS integration, first slice (lane L7,
# Wave 4 "V7 CTS integration" of the parallel conformance plan).
#
# Purpose: every sibling lane in this campaign compares ONE hand-built input
# at ONE boundary, which answers "does this one case agree" — not "is the
# driver conformant". This spec supplies a small, honest, authored case
# corpus at the vulkan.shader.spirv_binary@1 boundary, plus the accounting
# ledger that stops a conformance claim from resting on a corpus that
# silently stopped running.
#
# Scope: full Khronos VK-GL-CTS / dEQP is NOT installed on this host (checked
# directly — only glslangValidator, spirv-val, spirv-dis, vulkaninfo, and
# Mesa ICDs are present). This is a corpus HARNESS with 7 authored/reused
# cases, not a CTS conformance run. It is deliberately not described as CTS
# conformance anywhere in this spec.
#
# Key Concepts: LogicalArtifact-boundary corpus cases (corpus_cases.spl);
# a pure no-silent-truncation ledger (corpus_ledger.spl) that fails a run
# when declared != executed + skipped-with-reason, when any skip reason is
# empty, or when zero cases executed; and case verdicts that mark a
# deliberately corrupt binary as "non_correspond" up front rather than
# forcing it through the same pass/fail comparison as valid cases.
# @req REQ-VULKAN-CORPUS-LEDGER

fn scratch_dir() -> text:
    "/tmp/claude-1000/-home-ormastes-dev-pub-simple/20df0c6d-5c97-42d2-9a95-8b863e46582e/scratchpad"

fn run_full_corpus() -> ([text], [CaseVerdict]):
    val cases = board_vulkan_corpus()
    var executed_ids: [text] = []
    var verdicts: [CaseVerdict] = []
    for entry in cases:
        val v = run_case(entry, scratch_dir())
        executed_ids = executed_ids + [entry.case_id]
        verdicts = verdicts + [v]
    (executed_ids, verdicts)

describe "board Vulkan conformance corpus (spirv_binary boundary)":

    it "declares a non-empty corpus with a deliberately hostile mix":
        step("load the declared case list")
        val cases = board_vulkan_corpus()
        assert_true(cases.len() >= 7)

        step("confirm at least one case is marked non_correspond up front")
        var non_correspond_count = 0
        for entry in cases:
            if entry.expected_relation == "non_correspond":
                non_correspond_count = non_correspond_count + 1
        assert_true(non_correspond_count >= 1)

        step("confirm at least one case is flagged hostile")
        var hostile_count = 0
        for entry in cases:
            if entry.hostile:
                hostile_count = hostile_count + 1
        assert_true(hostile_count >= 1)

    it "executes every declared case and produces a verdict for each":
        step("run the full corpus through the executor")
        val (executed_ids, verdicts) = run_full_corpus()
        val cases = board_vulkan_corpus()
        assert_equal(executed_ids.len(), cases.len())
        assert_equal(verdicts.len(), cases.len())

        step("confirm the deliberately corrupt case is confirmed non-corresponding, not forced to pass")
        var corrupt_verdict = ""
        for v in verdicts:
            if v.case_id == "spirv_binary.deliberately_corrupt":
                corrupt_verdict = v.verdict
        assert_equal(corrupt_verdict, "non_correspond_confirmed")

        step("confirm every case produced an accepted verdict shape")
        for v in verdicts:
            assert_true(case_verdict_is_ok(v))

    it "passes the ledger when declared, executed, and skipped are fully accounted for":
        step("build a ledger from a complete accounting")
        val cases = board_vulkan_corpus()
        var declared_ids: [text] = []
        for entry in cases:
            declared_ids = declared_ids + [entry.case_id]
        val (executed_ids, verdicts) = run_full_corpus()
        var verdict_ids: [text] = []
        for v in verdicts:
            verdict_ids = verdict_ids + [v.case_id]

        val report = build_ledger(declared_ids, executed_ids, [], verdict_ids)
        assert_true(report.ok)
        assert_equal(report.declared, cases.len())
        assert_equal(report.executed, cases.len())
        assert_equal(report.skipped, 0)
        assert_equal(report.no_verdict, 0)

    it "SABOTAGE (a): fails the ledger when a declared case is dropped from execution":
        step("declare 3 cases but only execute 2, dropping the third silently")
        val declared_ids = ["case_a", "case_b", "case_c"]
        val executed_ids = ["case_a", "case_b"]
        val verdict_ids = ["case_a", "case_b"]
        val report = build_ledger(declared_ids, executed_ids, [], verdict_ids)
        assert_false(report.ok)
        assert_true(report.failure_reason.contains("case_c"))

    it "SABOTAGE (b): fails the ledger when a skip carries an empty reason":
        step("skip a declared case with a blank reason string")
        val declared_ids = ["case_a", "case_b"]
        val executed_ids = ["case_a"]
        val skips = [SkipEntry(case_id: "case_b", reason: "")]
        val report = build_ledger(declared_ids, executed_ids, skips, ["case_a"])
        assert_false(report.ok)
        assert_true(report.failure_reason.contains("empty skip reason"))

    it "SABOTAGE (c): fails the ledger when the corpus executes zero cases":
        step("declare cases, skip every one of them, executing none")
        val declared_ids = ["case_a", "case_b"]
        val skips = [
            SkipEntry(case_id: "case_a", reason: "tool unavailable on this host"),
            SkipEntry(case_id: "case_b", reason: "tool unavailable on this host")
        ]
        val report = build_ledger(declared_ids, [], skips, [])
        assert_false(report.ok)
        assert_true(report.failure_reason.contains("zero executed"))

    it "restores to a clean pass after each sabotage proof, proving the ledger is not stuck red":
        step("re-run the full, correctly-accounted ledger one more time")
        val cases = board_vulkan_corpus()
        var declared_ids: [text] = []
        for entry in cases:
            declared_ids = declared_ids + [entry.case_id]
        val (executed_ids, verdicts) = run_full_corpus()
        var verdict_ids: [text] = []
        for v in verdicts:
            verdict_ids = verdict_ids + [v.case_id]
        val report = build_ledger(declared_ids, executed_ids, [], verdict_ids)
        assert_true(report.ok)
# @cover src/os/drivers/gpu/board_vulkan/corpus_cases.spl
# @cover src/os/drivers/gpu/board_vulkan/corpus_runner.spl
# @cover src/os/drivers/gpu/board_vulkan/corpus_ledger.spl
