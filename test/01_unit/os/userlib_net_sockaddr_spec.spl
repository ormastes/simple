use std.spec.{describe, it, expect}
use os.userlib.net.{IpAddr, SockAddr, _pack_sockaddr, _sockaddr_bytes}

describe "ARM64 user network sockaddr ABI":
    it "encodes native AF_INET, network-order port, and canonical IPv4 octets":
        val addr = SockAddr(ip: IpAddr(octets: [10u8, 0u8, 2u8, 15u8]), port: 8080u16)
        val encoded = _sockaddr_bytes(addr)
        expect(encoded.len()).to_equal(16)
        expect(encoded[0]).to_equal(2u8)
        expect(encoded[1]).to_equal(0u8)
        expect(encoded[2]).to_equal(31u8)
        expect(encoded[3]).to_equal(144u8)
        expect(encoded[4]).to_equal(10u8)
        expect(encoded[5]).to_equal(0u8)
        expect(encoded[6]).to_equal(2u8)
        expect(encoded[7]).to_equal(15u8)

    it "preserves the shared low-octet-first IPv4 representation":
        val addr = SockAddr(ip: IpAddr(octets: [10u8, 0u8, 2u8, 15u8]), port: 80u16)
        expect(_pack_sockaddr(addr)).to_equal(0x0F02000Au64)
