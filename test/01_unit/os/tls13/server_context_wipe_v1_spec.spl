use std.spec
use os.tls13.server_types.{
    Tls13ServerContext, tls13_server_context_wipe_v1
}

fn _secret(byte: u8, count: i64) -> [u8]:
    var out: [u8] = []
    var index: i64 = 0
    while index < count:
        out.push(byte)
        index = index + 1
    out

describe "TLS13 accepted server context retirement":
    it "zeroes traffic keys IVs and retained handshake context with a receipt":
        val context = Tls13ServerContext(
            cipher_suite: 0x1301u16, named_group: 29u16,
            server_random: _secret(1u8, 32),
            server_keyshare_pub: _secret(2u8, 32),
            client_app_key: _secret(3u8, 16),
            client_app_iv: _secret(4u8, 12),
            server_app_key: _secret(5u8, 16),
            server_app_iv: _secret(6u8, 12),
            client_seq: 0u64, server_seq: 0u64,
            selected_alpn: _secret(7u8, 8))
        val receipt = tls13_server_context_wipe_v1(context)
        expect(receipt.verified()).to_equal(true)
        expect(receipt.attempted_bytes).to_equal(128u64)
        expect(context.server_random).to_equal(_secret(0u8, 32))
        expect(context.server_keyshare_pub).to_equal(_secret(0u8, 32))
        expect(context.client_app_key).to_equal(_secret(0u8, 16))
        expect(context.client_app_iv).to_equal(_secret(0u8, 12))
        expect(context.server_app_key).to_equal(_secret(0u8, 16))
        expect(context.server_app_iv).to_equal(_secret(0u8, 12))
        expect(context.selected_alpn).to_equal(_secret(0u8, 8))
