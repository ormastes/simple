# @req: REQ-005

# X25519MLKEM768 HelloRetryRequest policy and CH2 construction.
# @cover src/os/tls13/handshake13_hrr.spl 95%

use std.spipe.*
use os.tls13.handshake13.{
    GROUP_X25519_MLKEM768, HrrFlowResult,
    build_client_hello2_bytes_with_x25519_mlkem768,
    parse_handshake_header,
    process_hrr_after_serverhello_with_x25519_mlkem768
}
use os.tls13.server_handshake.{process_client_hello}

fn _hrr_octets(count: i64, offset: i64) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < count:
        out.push(((offset + i) & 0xFF).to_u8())
        i = i + 1
    out

fn _hrr_append(dst: [u8], src: [u8]) -> [u8]:
    var i: u64 = 0u64
    while i < src.len():
        dst.push(src[i])
        i = i + 1u64
    dst

fn _hybrid_hrr_body() -> [u8]:
    var out: [u8] = [0x03u8, 0x03u8]
    out = _hrr_append(out, [
        0xCFu8, 0x21u8, 0xADu8, 0x74u8, 0xE5u8, 0x9Au8, 0x61u8, 0x11u8,
        0xBEu8, 0x1Du8, 0x8Cu8, 0x02u8, 0x1Eu8, 0x65u8, 0xB8u8, 0x91u8,
        0xC2u8, 0xA2u8, 0x11u8, 0x16u8, 0x7Au8, 0xBBu8, 0x8Cu8, 0x5Eu8,
        0x07u8, 0x9Eu8, 0x09u8, 0xE2u8, 0xC8u8, 0xA8u8, 0x33u8, 0x9Cu8
    ])
    out = _hrr_append(out, [
        0x00u8,                         # legacy_session_id length
        0x13u8, 0x01u8,                # TLS_AES_128_GCM_SHA256
        0x00u8,                         # legacy compression
        0x00u8, 0x0Cu8,                # extensions length
        0x00u8, 0x2Bu8, 0x00u8, 0x02u8, 0x03u8, 0x04u8,
        0x00u8, 0x33u8, 0x00u8, 0x02u8, 0x11u8, 0xECu8
    ])
    out

fn _hybrid_hrr_handshake(body: [u8]) -> [u8]:
    var out: [u8] = [
        0x02u8,
        ((body.len() >> 16) & 0xFF).to_u8(),
        ((body.len() >> 8) & 0xFF).to_u8(),
        (body.len() & 0xFF).to_u8()
    ]
    _hrr_append(out, body)

use std.spec.step

describe "TLS 1.3 X25519MLKEM768 HelloRetryRequest":
    it "should REQ-005 constructs CH2 from an exact fresh hybrid share":
        # @req: REQ-005
        step("Create fresh X25519MLKEM768 state for ClientHello2")
        val fresh_share = _hrr_octets(1216, 41)
        val ch2 = match build_client_hello2_bytes_with_x25519_mlkem768(
                _hrr_octets(32, 7), fresh_share, "example.test", []):
            case Ok(value): value
            case Err(reason): fail(reason)
        step("Parse the emitted hybrid key share through the server parser")
        val parsed = process_client_hello(parse_handshake_header(ch2).body)
        expect(parsed.key_share_groups.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(parsed.key_share_groups[0] == GROUP_X25519_MLKEM768).to_be(true)
        expect(parsed.x25519_mlkem768_key_share.len()).to_equal(1216)  # oracle: 1216 — named expected value from the requirement
        expect(parsed.x25519_mlkem768_key_share[0]).to_equal(fresh_share[0])
        expect(parsed.x25519_mlkem768_key_share[1215]).to_equal(
            fresh_share[1215])

    it "should REQ-004 rejects malformed hybrid CH2 material before encoding":
        # @req: REQ-005
        step("Reject a ClientHello2 hybrid share with the wrong length")
        match build_client_hello2_bytes_with_x25519_mlkem768(
                _hrr_octets(32, 7), _hrr_octets(1215, 41),
                "example.test", []):
            case Ok(_): fail("malformed hybrid CH2 share was encoded")
            case Err(reason): expect(reason).to_contain("1216")

    it "should REQ-005 rejects HRR selecting the hybrid share already sent in CH1":
        # @req: REQ-005
        step("Receive an HRR that repeats the CH1 hybrid key-share group")
        val body = _hybrid_hrr_body()
        val result = process_hrr_after_serverhello_with_x25519_mlkem768(
            _hybrid_hrr_handshake(body), body,
            _hrr_octets(32, 7), _hrr_octets(32, 17),
            _hrr_octets(32, 29), _hrr_octets(32, 33), [], [],
            "example.test", false, true, false, true, true)
        match result:
            case HrrFlowResult.Ok(_):
                fail("same-group X25519MLKEM768 HRR was accepted")
            case HrrFlowResult.Reject(reason):
                expect(reason).to_contain("equals CH1 key_share group")

    it "should REQ-004 rejects a hybrid HRR when CH1 did not support the group":
        # @req: REQ-005
        step("Reject an HRR group that ClientHello1 did not advertise")
        val body = _hybrid_hrr_body()
        val result = process_hrr_after_serverhello_with_x25519_mlkem768(
            _hybrid_hrr_handshake(body), body,
            _hrr_octets(32, 7), _hrr_octets(32, 17),
            _hrr_octets(32, 29), _hrr_octets(32, 33), [],
            _hrr_octets(1216, 73), "example.test",
            false, true, false, false, false)
        match result:
            case HrrFlowResult.Ok(_): fail("unoffered hybrid HRR was accepted")
            case HrrFlowResult.Reject(reason):
                expect(reason).to_contain("not in client supported_groups")

    it "should REQ-005 accepts one hybrid HRR only with fresh 1216-byte state":
        # @req: REQ-005
        step("Accept one hybrid retry with a fresh exact-length key share")
        val body = _hybrid_hrr_body()
        val fresh_share = _hrr_octets(1216, 73)
        val result = process_hrr_after_serverhello_with_x25519_mlkem768(
            _hybrid_hrr_handshake(body), body,
            _hrr_octets(32, 7), _hrr_octets(32, 17),
            _hrr_octets(32, 29), _hrr_octets(32, 33), [], fresh_share,
            "example.test", false, true, false, true, false)
        match result:
            case HrrFlowResult.Reject(reason): fail(reason)
            case HrrFlowResult.Ok(value):
                expect(value.selected_group == GROUP_X25519_MLKEM768).to_be(true)
                val expected_seed_len = 36u64 + _hybrid_hrr_handshake(body).len()
                expect(value.transcript_seed.len()).to_equal(expected_seed_len)
                val parsed = process_client_hello(
                    parse_handshake_header(value.client_hello2_bytes).body)
                expect(parsed.x25519_mlkem768_key_share.len()).to_equal(1216)  # oracle: 1216 — named expected value from the requirement
