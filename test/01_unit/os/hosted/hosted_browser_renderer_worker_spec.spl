val SCRIPT_ANIMATION_HTML = "<!DOCTYPE html><html><head><style>#stage { width:32px; height:24px; background-color:#ef4444; }</style></head><body><script type='text/simple'>title \"SimpleReady\"\nbody_html '<div id=\"stage\"></div>'</script><script>requestAnimationFrame(function(frameTime){ document.body.innerHTML = '<div style=\"width:32px;height:24px;background-color:#2563eb\"></div>'; });</script></body></html>"
val CSS_ANIMATION_HTML = "<style>@keyframes pulse { from { background-color:#ef4444; } to { background-color:#2563eb; } } #stage { width:32px; height:24px; animation:pulse 1000ms linear forwards; }</style><div id='stage'></div>"

fn _worker_dom_route(
    worker: HostedBrowserRendererWorkerSession, author_id: text
) -> DomNodeRoute:
    val index = worker.browser.current_dom_identity_index().unwrap()
    index.route_for_author_id(author_id).unwrap()

fn _worker_focused_author_id(
    worker: HostedBrowserRendererWorkerSession
) -> text:
    val index = worker.browser.current_dom_identity_index().unwrap()
    val route = match be_dom_focused_route(worker.browser.dom_root(), index):
        Some(value): value
        nil: return ""
    index.author_id_for_route(route) ?? ""

fn _worker_selection_author_id(
    worker: HostedBrowserRendererWorkerSession
) -> text:
    val route = match worker.browser.text_selection_route:
        Some(value): value
        nil: return ""
    val index = worker.browser.current_dom_identity_index().unwrap()
    index.author_id_for_route(route) ?? ""

fn _render(html: text, time_ms: i64):
    hosted_browser_renderer_handle_init(
        BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 1, payload: html
        ),
        64,
        48,
        time_ms,
        2
    )

fn _worker_png_hex(pixel: u32) -> text:
    var out = ""
    for byte in encode_argb_to_png([pixel], 1, 1):
        val piece = byte.to_i64().to_hex()
        out = out + if piece.len() == 1: "0{piece}" else: piece
    out

fn _worker_command_index(
    commands: [DrawIrCommand], component_id: text
) -> i32:
    var i = 0
    while i < commands.len():
        if commands[i].component_id == component_id:
            return i
        i = i + 1
    -1

fn _ok_renderer_result(generation: i64) -> HostedBrowserRendererResult:
    HostedBrowserRendererResult(
        ok: true,
        reason: "ok",
        next_animation_ms: -1,
        producer_generation: generation,
        composition_revision: 0,
        composition: draw_ir_composition("", "", "auto", []),
        image_resources: [],
        cpu_composited_count: 0,
        cpu_composited_sha256: "",
        solid_material_count: 0,
        solid_material_sha256: "",
        diagnostics: ""
    )

describe "hosted browser renderer worker":

    it "orders accepted theme before canonical themed HTML":
        val snapshot = aetheric_dark_theme_render_snapshot()
        val wire = theme_package_install_wire_v1_encode(
            snapshot.id, snapshot.id, "active-wm-theme", snapshot
        ).unwrap()
        val themed_html = (
            simple_web_content_full_html_with_install_wire(
                wire, 1, "Worker", "<main>glass</main>", 64, 48
            )
        )
        var before_theme = (
            HostedBrowserRendererWorkerSession.create_for_theme_protocol(
                64, 48
            )
        )
        val raw_first = before_theme.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<main>raw</main>"
        ))
        expect(raw_first.ok).to_be(false)
        expect(raw_first.reason).to_equal("expected-theme-init")
        expect(raw_first.wire).to_equal("")

        var themed = (
            HostedBrowserRendererWorkerSession.create_for_theme_protocol(
                64, 48
            )
        )
        val theme_ready = themed.handle(BrowserRendererMessage(
            kind: "theme_init", generation: 7, request_id: 2,
            payload: hosted_theme_init_encode(1, wire).unwrap()
        ))
        expect(theme_ready.ok).to_be(true)
        expect(theme_ready.initialized).to_be(false)
        val ready_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), theme_ready.wire
        ).message
        expect(ready_message.kind).to_equal("theme_ready")
        expect(hosted_theme_ready_payload_matches(
            1, wire, ready_message.payload
        )).to_be(true)
        expect(hosted_theme_ready_payload_matches(
            2, wire, ready_message.payload
        )).to_be(false)
        expect(hosted_theme_ready_payload_matches(
            1,
            wire,
            ready_message.payload.replace(
                snapshot.id, "wrong-theme"
            )
        )).to_be(false)
        val raw_after_theme = themed.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 3,
            payload: "<main>raw replay</main>"
        ))
        expect(raw_after_theme.ok).to_be(false)
        expect(raw_after_theme.reason).to_equal(
            "unthemed-init-rejected"
        )
        expect(raw_after_theme.wire).to_equal("")

        var accepted = (
            HostedBrowserRendererWorkerSession.create_for_theme_protocol(
                64, 48
            )
        )
        expect(accepted.handle(BrowserRendererMessage(
            kind: "theme_init", generation: 7, request_id: 2,
            payload: hosted_theme_init_encode(1, wire).unwrap()
        )).ok).to_be(true)
        val frame = accepted.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 3,
            payload: themed_html
        ))
        expect(frame.ok).to_be(true)

    it "restarts a themed generation before replaying saved navigation":
        val snapshot = aetheric_dark_theme_render_snapshot()
        val wire = theme_package_install_wire_v1_encode(
            snapshot.id, snapshot.id, "active-wm-theme", snapshot
        ).unwrap()
        val restart_html = (
            simple_web_content_full_html_with_install_wire(
                wire, 4, "", "", 64, 48
            )
        )
        expect(restart_html).to_contain(
            "data-wm-theme=\"{snapshot.id}\""
        )

        val target_url = "https://account.victim.test/private"
        var registry = HostedBrowserRendererRegistry.create_with_theme(
            "/definitely/missing/simple-browser-renderer",
            "https://home.test/",
            4,
            wire
        )
        expect(registry.ensure(
            91, "", 64, 48, 1000, 1000
        )).to_equal("failed")
        var entry = registry.entries[0]
        entry.renderer = HostedBrowserRendererProcess.create_with_theme(
            8, 64, 48, 4, wire
        )
        entry.renderer.state = "await-theme-init"
        entry.renderer.navigation_permit = HostedBrowserNavigationPermit(
            active: true,
            url: target_url,
            method: "GET",
            headers: "",
            body: "",
            content_type: "",
            redirect_count: 0
        )
        entry.renderer.site_lock = "https://victim.test"
        entry.renderer.site_swap_pending = true
        entry.renderer.site_swap_site = "https://victim.test"
        entry.renderer_closed = false
        entry.failure_reason = ""
        entry.failure_published = false
        entry.startup_html = restart_html
        registry.entries[0] = entry
        expect(entry.renderer.generation).to_equal(8)
        expect(entry.renderer.requires_theme_handshake).to_be(true)
        expect(entry.renderer.theme_revision).to_equal(4)
        expect(entry.renderer.theme_wire_text).to_equal(wire)

        var worker = (
            HostedBrowserRendererWorkerSession.create_for_theme_protocol(
                64, 48
            )
        )
        expect(registry._accept_polled_result(
            0, _ok_renderer_result(8), "", "", 1000, 1000
        )).to_equal("none")
        entry = registry.entries[0]
        val theme_init_wire = entry.renderer.pending_wire
        entry.renderer._complete_pending_wire_write()
        val theme_init_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(8), theme_init_wire
        ).message
        val ready = worker.handle(theme_init_message)
        expect(ready.ok).to_be(true)
        expect(ready.initialized).to_be(false)
        val ready_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(8),
            ready.wire
        ).message
        expect(hosted_theme_ready_payload_matches(
            entry.renderer.theme_revision,
            entry.renderer.theme_wire_text,
            ready_message.payload
        )).to_be(true)
        val ready_result = entry.renderer._accept_theme_ready_message(
            ready_message
        )
        registry.entries[0] = entry
        expect(registry._accept_polled_result(
            0, ready_result, "", "", 1001, 1001
        )).to_equal("none")

        entry = registry.entries[0]
        val init_wire = entry.renderer.pending_wire
        entry.renderer._complete_pending_wire_write()
        val init_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(8), init_wire
        ).message
        val bootstrap = worker.handle(init_message)
        expect(bootstrap.ok).to_be(true)
        expect(bootstrap.initialized).to_be(true)
        val bootstrap_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(8), bootstrap.wire
        ).message
        val bootstrap_frame = (
            browser_renderer_frame_decode_with_retained_images(
                bootstrap_message, 64, 48, []
            )
        )
        val bootstrap_result = entry.renderer._accept_decoded_frame(
            bootstrap_frame, 8
        )
        registry.entries[0] = entry
        expect(registry._accept_polled_result(
            0, bootstrap_result, "", "", 1002, 1002
        )).to_equal("none")
        entry = registry.entries[0]
        expect(entry.pending_frame.checksum).to_equal(0u64)
        expect(entry.pending_frame.pixels.len()).to_equal(0)
        expect(entry.ready).to_be(false)
        val resumed = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(8),
            entry.renderer.pending_wire
        )
        expect(resumed.status).to_equal("message")
        val navigation = browser_renderer_navigation_decode(
            resumed.message
        )
        expect(navigation.ok).to_be(true)
        expect(navigation.action).to_equal("open")
        expect(navigation.url).to_equal(target_url)
        expect(entry.renderer.site_swap_pending).to_be(false)

    it "reserves theme envelope bytes below the codec maximum":
        expect(HOSTED_THEME_INIT_MAX_WIRE_BYTES).to_be_less_than(
            THEME_PACKAGE_INSTALL_WIRE_V1_MAX_UTF8_BYTES
        )
        val snapshot = aetheric_dark_theme_render_snapshot()
        val wire = theme_package_install_wire_v1_encode(
            snapshot.id, snapshot.id, "active-wm-theme", snapshot
        ).unwrap()
        expect(hosted_theme_init_encode(1, wire).?).to_be(true)

    it "reuses an unchanged semantic frame without rerunning render stages":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        val initial_result = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<main id='stable'>unchanged</main>"
        ))
        expect(initial_result.ok).to_be(true)
        val initial_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), initial_result.wire
            ).message,
            64,
            48
        )
        expect(initial_frame.ok).to_be(true)
        expect(initial_frame.damage_receipt.mode).to_equal(DAMAGE_PLAN_FULL)
        val before_composition_revision = (
            worker.render_session.counters.composition_revision
        )
        expect(initial_frame.composition_revision).to_equal(
            before_composition_revision
        )
        val reused_result = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        ))
        expect(reused_result.ok).to_be(true)
        val reused_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), reused_result.wire
            ).message,
            64,
            48
        )
        expect(reused_frame.ok).to_be(true)
        expect(reused_frame.damage_receipt.mode).to_equal(DAMAGE_PLAN_NONE)
        val after = worker.render_session.counters

        expect(after.serialize_count).to_equal(1)
        expect(after.parse_count).to_equal(1)
        expect(after.css_count).to_equal(1)
        expect(after.style_count).to_equal(1)
        expect(after.layout_count).to_equal(1)
        expect(after.paint_count).to_equal(1)
        expect(after.reuse_count).to_equal(1)
        expect(after.composition_revision).to_equal(
            before_composition_revision
        )
        expect(reused_frame.composition_revision).to_equal(
            before_composition_revision
        )
        expect(worker.render_session.checksum_revision).to_equal(-1)
        expect(worker.render_session.checksum_cache).to_equal("")
        val requested_checksum = worker.render_session.composition_checksum()
        expect(requested_checksum.len()).to_equal(64)
        expect(worker.render_session.checksum_revision).to_equal(
            after.composition_revision
        )
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 4, payload: "32"
        )).ok).to_be(true)
        expect(worker.render_session.checksum_revision).to_equal(
            after.composition_revision
        )
        expect(worker.render_session.checksum_cache).to_equal(
            requested_checksum
        )
        expect(
            worker.render_session.composition_checksum()
        ).to_equal(requested_checksum)
        expect(after.retained_node_count).to_be_greater_than(0)
        expect(after.retained_style_count).to_be_greater_than(0)
        expect(after.retained_box_count).to_be_greater_than(0)
        expect(after.retained_command_count).to_be_greater_than(0)
        worker.close()
        expect(worker.render_session.counters.retained_node_count).to_equal(0)
        expect(worker.render_session.counters.retained_style_count).to_equal(0)
        expect(worker.render_session.counters.retained_box_count).to_equal(0)
        expect(worker.render_session.counters.retained_command_count).to_equal(0)

    it "selectively invalidates image viewport animation scroll and caret paint":
        var image_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        image_worker.browser.register_resource(
            "https://assets.test/pixel.png",
            _worker_png_hex(0xFF123456u32)
        )
        expect(image_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<img src='https://assets.test/pixel.png'>"
        )).ok).to_be(true)
        val image_uri = image_worker.browser.image_resources[0].image_uri
        val image_checksum = (
            image_worker.render_session.composition_checksum()
        )
        image_worker.browser.image_resources = [
            simpleos_host_gpu_image_resource(
                image_uri, 1, 1, [0xFFABCDEFu32]
            )
        ]
        image_worker.browser._advance_resource_revision()
        expect(image_worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        )).ok).to_be(true)
        val image_after = image_worker.render_session.counters
        expect(image_after.parse_count).to_equal(1)
        expect(image_after.css_count).to_equal(1)
        expect(image_after.style_count).to_equal(1)
        expect(image_after.layout_count).to_equal(1)
        expect(image_after.paint_count).to_equal(2)
        expect(image_after.composition_revision).to_equal(2)
        expect(image_worker.render_session.checksum_revision).to_equal(-1)
        expect(image_worker.render_session.checksum_cache).to_equal("")
        expect(
            image_worker.render_session.composition_checksum()
        ).to_equal(image_checksum)

        var viewport_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(viewport_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>@media(min-width:80px){main{width:80px}}main{width:32px;height:8px}</style><main></main>"
        )).ok).to_be(true)
        val resize = browser_renderer_resize_encode(7, 3, 96, 48)
        expect(viewport_worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), resize.wire
        ).message).ok).to_be(true)
        val viewport_after = viewport_worker.render_session.counters
        expect(viewport_after.parse_count).to_equal(1)
        expect(viewport_after.css_count).to_equal(2)
        expect(viewport_after.style_count).to_equal(2)
        expect(viewport_after.layout_count).to_equal(2)
        expect(viewport_after.paint_count).to_equal(2)
        expect(viewport_after.composition_revision).to_equal(2)

        step("Reuse parsed layout work across unchanged animation frames")
        step("Render HTML and CSS through canonical Draw IR")
        var animation_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(animation_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>@keyframes unusedLayout{from{width:1px}to{width:2px}}@keyframes pulse{from{background-color:#ef4444}to{background-color:#2563eb}}#stage{width:32px;height:24px;animation:pulse 1000ms linear forwards}</style><div id='stage'></div>"
        )).ok).to_be(true)
        val animation_checksum = (
            animation_worker.render_session.composition_checksum()
        )
        val animation_render = animation_worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "500"
        ))
        expect(animation_render.ok).to_be(true)
        val animation_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), animation_render.wire
            ).message, 64, 48
        )
        expect(animation_frame.ok).to_be(true)
        expect(animation_frame.damage_receipt.mode).to_equal(DAMAGE_PLAN_LOCAL)
        expect(animation_frame.damage_receipt.rects.len()).to_be_greater_than(0)
        val animation_after = animation_worker.render_session.counters
        expect(animation_after.parse_count).to_equal(1)
        expect(animation_after.css_count).to_equal(1)
        expect(animation_after.style_count).to_equal(2)
        expect(animation_after.layout_count).to_equal(1)
        expect(animation_after.paint_count).to_equal(2)
        expect(
            animation_worker.render_session.composition_checksum() ==
            animation_checksum
        ).to_be(false)
        val animation_result = (
            animation_worker.render_session.current_result.unwrap()
        )
        val animation_commands = animation_result.composition.batches[0].commands
        val animation_stage = _worker_command_index(
            animation_commands, "stage"
        )
        expect(animation_stage).to_be_greater_than(-1)
        expect(animation_commands[animation_stage].color).to_equal(
            0xFF8A5397u32
        )
        val animation_raster = Engine2dCompositorBackend.create_named(
            64, 48, "software"
        )
        val animation_pixels = animation_raster.render_draw_ir_composition(
            animation_result.composition, []
        )
        animation_raster.shutdown()
        var animation_midpoint_pixels: i64 = 0
        for pixel in animation_pixels.pixels:
            if pixel == 0xFF8A5397u32:
                animation_midpoint_pixels = animation_midpoint_pixels + 1
        expect(animation_midpoint_pixels).to_equal(32 * 24)
        expect(animation_pixels.skipped_command_count).to_equal(0)

        var shadowed_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(shadowed_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>@keyframes grow{from{width:8px}to{width:32px}}@keyframes grow{}#shadowed{width:24px;height:16px;background-color:#2563eb;animation:grow 1000ms linear forwards}</style><div id='shadowed'></div>"
        )).ok).to_be(true)
        val shadowed_initial = (
            shadowed_worker.render_session.current_result.unwrap()
        )
        val shadowed_initial_commands = (
            shadowed_initial.composition.batches[0].commands
        )
        val shadowed_initial_stage = _worker_command_index(
            shadowed_initial_commands, "shadowed"
        )
        expect(shadowed_initial_stage).to_be_greater_than(-1)
        expect(shadowed_initial_commands[shadowed_initial_stage].width).to_equal(
            24
        )
        expect(shadowed_initial.animation_property_work_count).to_equal(0)
        val shadowed_checksum = (
            shadowed_worker.render_session.composition_checksum()
        )
        expect(shadowed_worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "500"
        )).ok).to_be(true)
        val shadowed_after = shadowed_worker.render_session.counters
        expect(shadowed_after.parse_count).to_equal(1)
        expect(shadowed_after.css_count).to_equal(1)
        expect(shadowed_after.style_count).to_equal(2)
        expect(shadowed_after.layout_count).to_equal(1)
        expect(shadowed_after.paint_count).to_equal(2)
        expect(shadowed_after.composition_revision).to_equal(2)
        val shadowed_result = (
            shadowed_worker.render_session.current_result.unwrap()
        )
        val shadowed_commands = shadowed_result.composition.batches[0].commands
        val shadowed_stage = _worker_command_index(
            shadowed_commands, "shadowed"
        )
        expect(shadowed_stage).to_be_greater_than(-1)
        expect(shadowed_commands[shadowed_stage].width).to_equal(24)
        expect(shadowed_result.animation_property_work_count).to_equal(0)
        expect(
            shadowed_worker.render_session.composition_checksum()
        ).to_equal(shadowed_checksum)

        var scroll_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(scroll_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<main style='height:160px'>scroll</main>"
        )).ok).to_be(true)
        val scroll = browser_renderer_scroll_encode(7, 3, 1, 16000)
        val scroll_checksum = (
            scroll_worker.render_session.composition_checksum()
        )
        expect(scroll_worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), scroll.wire
        ).message).ok).to_be(true)
        val scroll_after = scroll_worker.render_session.counters
        expect(scroll_after.parse_count).to_equal(1)
        expect(scroll_after.css_count).to_equal(1)
        expect(scroll_after.style_count).to_equal(1)
        expect(scroll_after.layout_count).to_equal(1)
        expect(scroll_after.paint_count).to_equal(2)
        expect(scroll_after.composition_revision).to_equal(2)
        expect(
            scroll_worker.render_session.composition_checksum() ==
            scroll_checksum
        ).to_be(false)

        var caret_worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(caret_worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<input id='field' data-focused value='caret'>"
        )).ok).to_be(true)
        val caret_checksum = (
            caret_worker.render_session.composition_checksum()
        )
        expect(caret_worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "600"
        )).ok).to_be(true)
        val caret_after = caret_worker.render_session.counters
        expect(caret_after.parse_count).to_equal(1)
        expect(caret_after.css_count).to_equal(1)
        expect(caret_after.style_count).to_equal(1)
        expect(caret_after.layout_count).to_equal(1)
        expect(caret_after.paint_count).to_equal(2)
        expect(caret_after.composition_revision).to_equal(2)
        expect(
            caret_worker.render_session.composition_checksum() ==
            caret_checksum
        ).to_be(false)

    it "replaces document stages without growing retained state":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<main id='first'>first</main>"
        )).ok).to_be(true)
        val first_checksum = worker.render_session.composition_checksum()
        val first_commands = (
            worker.render_session.counters.retained_command_count
        )
        expect(worker.browser.eval_script(
            "document.body.innerHTML = '<main id=\"second\">second</main>'"
        ).is_ok()).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        )).ok).to_be(true)
        worker.browser.current_style_html = (
            "<style>main { color:#2563eb; }</style>"
        )
        worker.browser._advance_style_revision()
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 4, payload: "32"
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "simple-renderer://replacement",
            "<main id='third'>third</main>"
        ).is_ok()).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 5, payload: "48"
        )).ok).to_be(true)
        val after = worker.render_session.counters
        expect(after.serialize_count).to_equal(4)
        expect(after.parse_count).to_equal(4)
        expect(after.css_count).to_equal(4)
        expect(after.style_count).to_equal(4)
        expect(after.layout_count).to_equal(4)
        expect(after.paint_count).to_equal(4)
        expect(after.composition_revision).to_equal(4)
        expect(
            worker.render_session.composition_checksum() == first_checksum
        ).to_be(false)
        expect(
            after.retained_command_count
        ).to_be_less_than(first_commands + 2)

    it "invalidates every semantic stage for a title-only mutation":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<title>before</title><main>same pixels</main>"
        )).ok).to_be(true)
        val before_checksum = worker.render_session.composition_checksum()
        expect(worker.browser.eval_script(
            "document.title = 'after'"
        ).is_ok()).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        )).ok).to_be(true)
        val after = worker.render_session.counters
        expect(after.serialize_count).to_equal(2)
        expect(after.parse_count).to_equal(2)
        expect(after.css_count).to_equal(2)
        expect(after.style_count).to_equal(2)
        expect(after.layout_count).to_equal(2)
        expect(after.paint_count).to_equal(2)
        expect(after.composition_revision).to_equal(2)
        expect(
            worker.render_session.composition_checksum()
        ).to_equal(before_checksum)

    it "closes the real browser document resource and runtime owners":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        worker.browser.register_resource(
            "https://assets.test/pixel.png",
            _worker_png_hex(0xFF123456u32)
        )
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<img src='https://assets.test/pixel.png'>"
        )).ok).to_be(true)
        expect(worker.browser.eval_script(
            "setTimeout(function(){ document.title = 'late'; }, 1000)"
        ).is_ok()).to_be(true)
        expect(worker.browser.begin_network_navigation(
            "https://next.test/", "GET", "", "", ""
        ).is_ok()).to_be(true)
        expect(worker.browser.image_resources.len()).to_equal(1)
        expect(
            worker.browser.admitted_image_sources.len()
        ).to_equal(1)
        expect(worker.browser.has_pending_requests()).to_be(true)
        expect(worker.browser.runtime_state != nil).to_be(true)
        expect(
            worker.browser.next_script_timer_due_ms()
        ).to_be_greater_than(-1)

        worker.close()
        expect(worker.browser.image_resources.len()).to_equal(0)
        expect(worker.browser.admitted_image_sources.len()).to_equal(0)
        expect(worker.browser.has_pending_requests()).to_be(false)
        expect(worker.browser.inflight_requests.len()).to_equal(0)
        expect(worker.browser.active_load).to_be_nil()
        expect(worker.browser.runtime_state).to_be_nil()
        expect(worker.browser.next_script_timer_due_ms()).to_equal(-1)
        expect(worker.browser.resource_overrides.len()).to_equal(0)
        expect(worker.browser.current_body_html).to_equal("")
        expect(worker.browser.current_style_html).to_equal("")
        expect(worker.browser.source_html).to_equal("")
        expect(worker.browser.history.len()).to_equal(0)

    it "releases retained image pixels when the renderer process closes":
        var process = HostedBrowserRendererProcess.create(19, 64, 48)
        process.retained_image_resources = [
            simpleos_host_gpu_image_resource(
                "https://example.test/frame.png",
                4,
                4,
                [0xff010203u32; 16]
            )
        ]
        expect(process.close()).to_be(true)
        expect(process.retained_image_resources.len()).to_equal(0)

    it "restores bounded bookmarks into a fresh external renderer":
        val saved_url = "https://restart.test/saved"
        val snapshot = BrowserBookmarkSnapshot.create([
            Pair(first: saved_url, second: "Saved bookmark")
        ])
        var process = HostedBrowserRendererProcess.create(19, 64, 48)
        process.state = "active"
        expect(process.begin_bookmark_snapshot(
            snapshot, 2000
        ).is_ok()).to_be(true)
        val process_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(19), process.pending_wire
        )
        expect(browser_renderer_bookmark_snapshot_decode(
            process_message.message
        ).ok).to_be(true)

        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>fresh renderer</p>"
        )).ok).to_be(true)
        val encoded = browser_renderer_bookmark_snapshot_encode(
            7, 3, [saved_url], ["Saved bookmark"]
        )
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        )
        expect(worker.handle(decoded.message).ok).to_be(true)
        val bookmarks = ui_access_find_nodes(
            worker.browser.ui_access_snapshot(),
            "browser:session", "link", "Saved bookmark", 1
        )
        expect(bookmarks.len()).to_equal(1)
        expect(bookmarks[0].canonical_id).to_equal(
            "browser:session#bookmark_{worker.browser.ui_access_revision}_0"
        )
        worker.browser.register_resource(
            saved_url, "<p>restored bookmark</p>"
        )
        expect(worker.browser.ui_access_act(WinTextActionRequest(
            target_id: bookmarks[0].canonical_id,
            action: "click", text_value: "", x: 0, y: 0
        )).ok).to_be(true)
        expect(worker.browser.current_url).to_equal(saved_url)

        expect(worker.handle(BrowserRendererMessage(
            kind: "bookmark-snapshot", generation: 7, request_id: 4,
            payload: "SBB1\t1\n%%%\t%%%"
        )).ok).to_be(false)
        var too_many_urls: [text] = []
        var too_many_titles: [text] = []
        var index = 0
        while index < 257:
            too_many_urls.push("https://restart.test/{index}")
            too_many_titles.push("bookmark")
            index = index + 1
        expect(browser_renderer_bookmark_snapshot_encode(
            7, 4, too_many_urls, too_many_titles
        ).ok).to_be(false)
        val host = (
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        expect(host).to_contain("profile.load_bookmarks()")
        expect(host).to_contain(
            "browser_renderer.begin_bookmark_snapshot("
        )

    it "releases the previous hit graph before repaint allocation":
        val source = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_worker.spl"
        ) ?? ""
        val release_at = source.find("self.last_hit_index = nil")
        val repaint_at = source.find("val frame = _worker_frame(")
        expect(release_at).to_be_greater_than(-1)
        expect(repaint_at).to_be_greater_than(release_at)

