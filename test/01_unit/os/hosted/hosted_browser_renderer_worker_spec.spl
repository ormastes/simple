    it "drains a coalesced Stop already buffered behind a command":
        val init = browser_renderer_message_encode(
            "init", 7, 2, "<p>pending navigation</p>"
        )
        val stop = browser_renderer_navigation_encode(
            7, 3, "stop", "", "", "", "", ""
        )
        val first = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), init.wire + stop.wire
        )
        expect(first.status).to_equal("message")
        expect(first.decoder.buffer_len).to_be_greater_than(0)
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(first.message).ok).to_be(true)

        val second = browser_renderer_decoder_feed(first.decoder, "")
        expect(second.status).to_equal("message")
        expect(browser_renderer_navigation_decode(
            second.message
        ).action).to_equal("stop")
        expect(worker.handle(second.message).ok).to_be(true)
        expect(second.decoder.buffer_len).to_equal(0)

        val source = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_worker.spl"
        ) ?? ""
        expect(source).to_contain("if decoder.buffer_len > 0:")
        expect(source).to_contain(
            "browser_renderer_decoder_feed(decoder, \"\")"
        )

    it "renders HTML CSS Simple Script JavaScript and CSS animation into bounded DrawIR":
        val script_first = _render(SCRIPT_ANIMATION_HTML, 0)
        val script_animated = _render(SCRIPT_ANIMATION_HTML, 16)
        val css_first = _render(CSS_ANIMATION_HTML, 0)
        val css_middle = _render(CSS_ANIMATION_HTML, 500)
        val css_last = _render(CSS_ANIMATION_HTML, 1000)

        expect(script_first.ok).to_be(true)
        expect(script_animated.ok).to_be(true)
        expect(css_first.ok).to_be(true)
        expect(css_middle.ok).to_be(true)
        expect(css_last.ok).to_be(true)
        expect(script_first.wire == script_animated.wire).to_be(false)
        expect(css_first.wire == css_middle.wire).to_be(false)
        expect(css_middle.wire == css_last.wire).to_be(false)

        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), script_animated.wire
        )
        expect(decoded.status).to_equal("message")
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.ok).to_be(true)
        expect(frame.composition.batches[0].commands.len()).to_be_greater_than(0)
        expect(frame.next_animation_ms).to_equal(-1)

        val script_initial_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), script_first.wire
        )
        expect(browser_renderer_frame_decode(
            script_initial_message.message, 64, 48
        ).next_animation_ms).to_equal(16)
        val css_initial_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), css_first.wire
        )
        expect(browser_renderer_frame_decode(
            css_initial_message.message, 64, 48
        ).next_animation_ms).to_equal(16)
        val css_last_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), css_last.wire
        )
        expect(browser_renderer_frame_decode(
            css_last_message.message, 64, 48
        ).next_animation_ms).to_equal(-1)

    it "sleeps until a delayed CSS animation can start":
        val initialized = _render(
            "<style>@keyframes pulse{from{background-color:#ef4444}to{background-color:#2563eb}}#stage{width:32px;height:24px;animation-name:pulse;animation-duration:1000ms;animation-delay:3600000ms;animation-timing-function:linear}</style><div id='stage'></div>",
            0
        )
        expect(initialized.ok).to_be(true)
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), initialized.wire
        )
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.next_animation_ms).to_equal(3600000)

