# @cover src/os/hosted/hosted_browser_renderer_worker.spl 80%

use std.spec.*
use std.common.web.browser_renderer_protocol.{
    BrowserRendererMessage,
    browser_renderer_decoder_feed, browser_renderer_decoder_new,
    browser_renderer_frame_decode
}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession,
    hosted_browser_renderer_handle_init,
    hosted_browser_renderer_handle_request
}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.gc_async_mut.web.browser_session_runtime.*

val SCRIPT_ANIMATION_HTML = "<!DOCTYPE html><html><head><style>#stage { width:32px; height:24px; background-color:#ef4444; }</style></head><body><script type='text/simple'>title \"SimpleReady\"\nbody_html '<div id=\"stage\"></div>'</script><script>requestAnimationFrame(function(frameTime){ document.body.innerHTML = '<div style=\"width:32px;height:24px;background-color:#2563eb\"></div>'; });</script></body></html>"
val CSS_ANIMATION_HTML = "<style>@keyframes pulse { from { background-color:#ef4444; } to { background-color:#2563eb; } } #stage { width:32px; height:24px; animation:pulse 1000ms linear forwards; }</style><div id='stage'></div>"

fn _render(html: text, time_ms: i64):
    hosted_browser_renderer_handle_init(
        BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 1, payload: html
        ),
        64,
        48,
        time_ms,
        2
    )

describe "hosted browser renderer worker":
    it "renders HTML CSS Simple Script JavaScript and CSS animation into bounded DrawIR":
        val script_first = _render(SCRIPT_ANIMATION_HTML, 0)
        val script_animated = _render(SCRIPT_ANIMATION_HTML, 16)
        val css_first = _render(CSS_ANIMATION_HTML, 0)
        val css_middle = _render(CSS_ANIMATION_HTML, 500)
        val css_last = _render(CSS_ANIMATION_HTML, 1000)

        expect(script_first.ok).to_be(true)
        expect(script_animated.ok).to_be(true)
        expect(css_first.ok).to_be(true)
        expect(css_middle.ok).to_be(true)
        expect(css_last.ok).to_be(true)
        expect(script_first.wire == script_animated.wire).to_be(false)
        expect(css_first.wire == css_middle.wire).to_be(false)
        expect(css_middle.wire == css_last.wire).to_be(false)

        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), script_animated.wire
        )
        expect(decoded.status).to_equal("message")
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.ok).to_be(true)
        expect(frame.composition.batches[0].commands.len()).to_be_greater_than(0)

    it "rejects non-init input":
        val rejected = hosted_browser_renderer_handle_init(
            BrowserRendererMessage(
                kind: "state", generation: 7, request_id: 1, payload: ""
            ),
            64,
            48,
            0,
            2
        )
        expect(rejected.ok).to_be(false)
        expect(rejected.reason).to_equal("expected-init")

    it "retains one browser session across animation frames":
        var session = BrowserSession.new()
        val first = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "init",
                generation: 7,
                request_id: 2,
                payload: SCRIPT_ANIMATION_HTML
            ),
            64,
            48,
            false,
            0,
            2
        )
        val animated = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 3,
                payload: "16"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )

        expect(first.ok).to_be(true)
        expect(animated.ok).to_be(true)
        expect(first.wire == animated.wire).to_be(false)
        expect(animated.animation_time_ms).to_equal(16)

    it "keeps DOM focus and trusted chrome state across bounded actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init",
            generation: 7,
            request_id: 2,
            payload: "<input id='name' value='' onkeydown='set-attr:data-down=yes' onkeyup='set-attr:data-up=yes'>"
        ))
        expect(initialized.ok).to_be(true)

        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t5\t5\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t5\t5\t0"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t3\t87\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 6,
            payload: "T1\t4\t1\nw"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 7,
            payload: "K1\t5\t87\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_body_html).to_contain("value=\"w\"")
        expect(worker.browser.current_body_html).to_contain("data-down=\"yes\"")
        expect(worker.browser.current_body_html).to_contain("data-up=\"yes\"")

        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 8,
            payload: "C1\t6\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 9,
            payload: "C1\t7\t0\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 10,
            payload: "T1\t8\t20\nhttps://example.test"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("https://example.test")

    it "rejects skipped ids and backward animation time":
        var session = BrowserSession.new()
        val first = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "init",
                generation: 7,
                request_id: 2,
                payload: CSS_ANIMATION_HTML
            ),
            64,
            48,
            false,
            0,
            2
        )
        val skipped = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 4,
                payload: "500"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )
        val advanced = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 3,
                payload: "500"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )
        val backward = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 4,
                payload: "16"
            ),
            64,
            48,
            advanced.initialized,
            advanced.animation_time_ms,
            4
        )

        expect(skipped.ok).to_be(false)
        expect(skipped.reason).to_equal("unexpected-request-id")
        expect(advanced.ok).to_be(true)
        expect(backward.ok).to_be(false)
        expect(backward.reason).to_equal("invalid-animation-time")
