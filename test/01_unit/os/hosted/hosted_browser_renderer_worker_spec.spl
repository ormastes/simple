        expect(_worker_command_index(
            initialized_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)
        val chrome = worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        ))
        val chrome_frame = browser_renderer_frame_decode(
