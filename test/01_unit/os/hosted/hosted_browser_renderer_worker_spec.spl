    it "rejects hidden worker markers outside the exact spawn shape":
        expect(hosted_browser_renderer_worker_main([
            "hosted-entry", "extra", BROWSER_RENDERER_WORKER_ARG,
            "7", "64", "48"
        ])).to_equal(64)
