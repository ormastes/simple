            browser_renderer_decoder_new(7), advanced.wire
        )
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.next_animation_ms).to_equal(516)

    it "caps warning diagnostics before encoding animation frames":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>bounded diagnostics</p>"
        )).ok).to_be(true)
        expect(worker.last_hit_index != nil).to_be(true)
        var index = 0
        while index < 256:
            worker.browser._append_warning(
                "warning-{index}-abcdefghijklmnopqrstuvwxyz0123456789"
            )
            index = index + 1
        val advanced = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        ))
        expect(worker.last_hit_index != nil).to_be(true)
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), advanced.wire
        )
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.ok).to_be(true)
        expect(frame.diagnostics.len()).to_equal(4096)
        expect(frame.diagnostics).to_start_with("warning-0-")

    it "resizes the existing session and emits matching frame bounds":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<div style='width:100%;height:100%'></div>"
        ))
        expect(initialized.ok).to_be(true)
        val encoded = browser_renderer_resize_encode(7, 3, 96, 64)
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        )
        val resized = worker.handle(decoded.message)
        expect(resized.ok).to_be(true)
        val frame_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), resized.wire
        )
        expect(browser_renderer_frame_decode(
            frame_message.message, 96, 64
        ).ok).to_be(true)
        expect(worker.width).to_equal(96)
        expect(worker.height).to_equal(64)

    it "scrolls pixels and hit testing together within document bounds":
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#top{height:20px;background:#ef4444}#space{height:80px}#below{display:block;width:40px;height:20px;background:#2563eb}</style><div id='top'></div><div id='space'></div><button id='below'>Below</button>"
        ))
        val initial_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), initialized.wire
            ).message,
            80, 50
        )
        expect(initial_frame.ok).to_be(true)
        expect(_worker_command_index(
            initial_frame.composition.batches[0].commands, "below"
        )).to_equal(-1)

        val half_a = browser_renderer_scroll_encode(7, 3, 1, 500)
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), half_a.wire
        ).message).ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(500)
        val half_b = browser_renderer_scroll_encode(7, 4, 2, 500)
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), half_b.wire
        ).message).ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(1000)
        val encoded = browser_renderer_scroll_encode(7, 5, 3, 69000)
        val scrolled = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        ).message)
        val scrolled_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), scrolled.wire
            ).message,
            80, 50
        )
        expect(scrolled_frame.ok).to_be(true)
        expect(_worker_command_index(
            scrolled_frame.composition.batches[0].commands, "below"
        )).to_be_greater_than(-1)
        expect(worker.scroll_milli_y).to_equal(70000)
        expect(simple_web_layout_hit_test_index(
            worker.last_hit_index.unwrap(), 5, 35
        )).to_equal("id:below")

    it "resets scroll when cached history changes the document":
        val tall = "<style>body{{margin:0}}main{height:240px}</style><input id='field' value='abc' data-focused data-input-dirty onblur=\"history.pushState(null, '', '/blurred')\"><main></main>"
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: tall
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://b.test/", tall
        ).is_ok()).to_be(true)

        worker.scroll_milli_y = 12000
        worker.pressed_target_id = "held-target"
        worker.pressed_pointer_default_prevented = true
        worker.pressed_chrome_control = "address"
        worker.chrome_focus = "address"
        worker.address_replace_on_text = true
        worker.input_view_target_key = "id:field"
        worker.input_view_start_byte = 2
        worker.caret_blink_epoch_ms = 42
        worker.browser.text_selection_route = Some(
            _worker_dom_route(worker, "field")
        )
        worker.browser.text_selection_anchor_byte = 1
        worker.browser.text_selection_focus_byte = 2
        val mismatched = browser_renderer_navigation_encode(
            7, 3, "back", "https://wrong.test/", "GET", "", "", ""
        )
        val rejected = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), mismatched.wire
        ).message)
        expect(rejected.ok).to_be(false)
        expect(rejected.reason).to_equal("navigation-target-mismatch")
        expect(worker.scroll_milli_y).to_equal(12000)
        expect(worker.browser.current_url).to_equal("https://b.test/")
        expect(worker.browser.current_index).to_equal(1)
        expect(worker.browser.history_back_url()).to_equal(
            "simple-renderer://document"
        )
        expect(worker.browser.history_forward_url()).to_equal("")
        expect(worker.pressed_target_id).to_equal("held-target")
        expect(worker.pressed_pointer_default_prevented).to_be(true)
        expect(worker.pressed_chrome_control).to_equal("address")
        expect(worker.chrome_focus).to_equal("address")
        expect(worker.address_replace_on_text).to_be(true)
        expect(worker.input_view_target_key).to_equal("id:field")
        expect(worker.input_view_start_byte).to_equal(2)
        expect(worker.caret_blink_epoch_ms).to_equal(42)
        expect(_worker_focused_author_id(worker)).to_equal("field")
        expect(_worker_selection_author_id(worker)).to_equal("field")
        expect(worker.browser.text_selection_anchor_byte).to_equal(1)
        expect(worker.browser.text_selection_focus_byte).to_equal(2)
        expect(worker.expected_request_id).to_equal(3)

        val back = browser_renderer_navigation_encode(
            7, 3, "back", "simple-renderer://document", "GET", "", "", ""
        )
        val back_result = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), back.wire
        ).message)
        expect(back_result.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(back_result.resolved_scroll_y).to_equal(0)
        val back_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), back_result.wire
            ).message,
            80, 50
        )
        expect(back_frame.history_state_present).to_be(true)
        expect(back_frame.history_current_url).to_equal(
            "simple-renderer://document"
        )
        expect(back_frame.history_forward_url).to_equal("https://b.test/")

        worker.scroll_milli_y = 9000
        val mismatched_forward = browser_renderer_navigation_encode(
            7, 4, "forward", "https://wrong.test/", "GET", "", "", ""
        )
        val rejected_forward = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), mismatched_forward.wire
        ).message)
        expect(rejected_forward.ok).to_be(false)
        expect(rejected_forward.reason).to_equal("navigation-target-mismatch")
        expect(worker.browser.current_url).to_equal(
            "simple-renderer://document"
        )
        expect(worker.browser.history_forward_url()).to_equal("https://b.test/")
        expect(worker.scroll_milli_y).to_equal(9000)
        expect(worker.expected_request_id).to_equal(4)

        val forward = browser_renderer_navigation_encode(
            7, 4, "forward", "https://b.test/", "GET", "", "", ""
        )
        val forward_result = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), forward.wire
        ).message)
        expect(forward_result.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(forward_result.resolved_scroll_y).to_equal(0)
        val forward_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), forward_result.wire
            ).message,
            80, 50
        )
        expect(forward_frame.history_current_url).to_equal("https://b.test/")
        expect(forward_frame.history_back_url).to_equal("")

        worker.chrome_focus = "address"
        val mismatched_reload = browser_renderer_navigation_encode(
            7, 5, "reload", "https://wrong.test/", "GET", "", "", ""
        )
        val rejected_reload = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), mismatched_reload.wire
        ).message)
        expect(rejected_reload.ok).to_be(false)
        expect(rejected_reload.reason).to_equal("navigation-target-mismatch")
        expect(worker.browser.current_url).to_equal("https://b.test/")
        expect(worker.browser.is_loading).to_be(false)
        expect(worker.chrome_focus).to_equal("address")
        expect(worker.expected_request_id).to_equal(5)

        val reload = browser_renderer_navigation_encode(
            7, 5, "reload", "https://b.test/", "GET", "", "", ""
        )
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), reload.wire
        ).message).ok).to_be(true)
        expect(worker.browser.is_loading).to_be(true)
        expect(_worker_focused_author_id(worker)).to_equal("")
        expect(worker.browser.current_body_html.contains(
            "data-input-dirty"
        )).to_be(false)
        expect(worker.browser.current_url).to_equal("https://b.test/")

        val stop = browser_renderer_navigation_encode(
            7, 6, "stop", "", "", "", "", ""
        )
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), stop.wire
        ).message).ok).to_be(true)
        expect(worker.browser.is_loading).to_be(false)
        expect(worker.browser.current_url).to_equal("https://b.test/")
        expect(worker.browser.current_body_html.contains(
            "data-input-dirty"
        )).to_be(false)

    it "clips hidden descendants from scrolling painting and hit testing":
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#clip{position:relative;width:10px;height:20px;overflow:hidden}button{position:absolute;width:20px;height:10px}#hidden{left:20px;top:0}#deep{left:0;top:100px}</style><div id='clip'><button id='hidden'>Hidden</button><button id='deep'>Deep</button></div>"
        )).ok).to_be(true)
        expect(simple_web_layout_hit_test_index(
            worker.last_hit_index.unwrap(), 25, 5
        ) == "id:hidden").to_be(false)
        val encoded = browser_renderer_scroll_encode(7, 3, 1, 100000)
        val scrolled = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        ).message)
        val frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), scrolled.wire
            ).message,
            80, 50
        )
        expect(frame.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(_worker_command_index(
            frame.composition.batches[0].commands, "hidden"
        )).to_equal(-1)
        expect(_worker_command_index(
            frame.composition.batches[0].commands, "deep"
        )).to_equal(-1)

    it "starts navigated CSS animation on the document clock":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>old</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "5000"
        )).ok).to_be(true)
        worker.scroll_milli_y = 12000
        val navigation = browser_renderer_navigation_encode(
            7, 4, "open", "https://example.test/", "GET", "", "", ""
        )
        val navigation_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), navigation.wire
        )
        val requested = worker.handle(navigation_message.message)
        val fetch_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), requested.wire
        )
        val fetch = browser_renderer_fetch_request_decode(
            fetch_message.message
        )
        expect(fetch.credentials).to_equal("include")
        val response = browser_renderer_network_response_encode(
            7, 5, fetch.request_id, fetch.kind, fetch.url,
            200, "Content-Type: text/html", CSS_ANIMATION_HTML, ""
        )
        val response_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), response.wire
        )
        val committed = worker.handle(response_message.message)
        val frame_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), committed.wire
        )
        val frame = browser_renderer_frame_decode(
            frame_message.message, 64, 48
        )
        expect(frame.ok).to_be(true)
        expect(worker.browser.animation_start_time_ms).to_equal(5000)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(frame.next_animation_ms).to_equal(5016)

    it "emits ordered hosted script cookie writes outside cookie-free fetch headers":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://safe.test/", "<p>safe</p>"
        ).is_ok()).to_be(true)
        val _ = worker.browser.eval_script(
            "document.cookie = 'first=one; Path=/'; " +
            "document.cookie = 'second=two; Path=/'; " +
            "fetch('/data', { credentials: 'include' })"
        )

        val emitted = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "A1\t0"
        ))
        expect(emitted.ok).to_be(true)
        val message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), emitted.wire
        )
        expect(message.message.kind).to_equal("fetch_request")
        val fetch = browser_renderer_fetch_request_decode(message.message)
        expect(fetch.ok).to_be(true)
        expect(fetch.credentials).to_equal("include")
        expect(fetch.headers.contains("Cookie:")).to_be(false)
        expect(fetch.script_cookie_writes.len()).to_equal(2)
        expect(fetch.script_cookie_writes[0]).to_equal("first=one; Path=/")
        expect(fetch.script_cookie_writes[1]).to_equal("second=two; Path=/")
        expect(
            worker.browser.take_pending_script_cookie_writes().len()
        ).to_equal(0)

    it "brokers a clicked form submission as a validated document navigation":
        val html = (
            "<style>html,body{{margin:0}}button{width:40px;height:20px}</style>" +
            "<form action='/go' method='post'>" +
            "<button id='go' type='submit'>Go</button></form>"
        )
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: html
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://source.test/page", html
        ).is_ok()).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "0"
        )).ok).to_be(true)
        expect(simple_web_layout_hit_test_index(
            worker.last_hit_index.unwrap(), 5, 5
        )).to_equal("id:go")
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t1\t5\t5\t1"
        )).ok).to_be(true)
        val clicked = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 5,
            payload: "P1\t2\t5\t5\t0"
        ))
        val message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), clicked.wire
        )
        val navigation = browser_renderer_fetch_request_decode(
            message.message
        )
        expect(navigation.kind).to_equal("document")
        expect(navigation.url).to_equal("https://source.test/go")
        expect(navigation.method).to_equal("POST")
        expect(navigation.credentials).to_equal("include")

        var broker = HostedBrowserRendererProcess.create(7, 80, 40)
        broker.document_url = "https://source.test/page"
        broker.document_origin = "https://source.test"
        expect(broker.authorize_renderer_navigation(navigation)).to_be(true)
        val policy = hosted_browser_renderer_request_policy(
            broker.document_origin,
            broker.navigation_permit,
            navigation,
            navigation.url
        )
        expect(policy.ok).to_be(true)
        expect(policy.consumes_navigation).to_be(true)

    it "activates a focused submit input on Space release":
        val html = (
            "<form action='/space' method='post'>" +
            "<input id='go' type='submit' data-focused value='Go'></form>"
        )
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: html
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://source.test/page", html
        ).is_ok()).to_be(true)
        expect(_worker_focused_author_id(worker)).to_equal("go")

        val down = worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 3,
            payload: "K1\t1\t32\t1"
        ))
        val down_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), down.wire
        )
        expect(down_message.message.kind).to_equal("frame")

        val up = worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 4,
            payload: "K1\t2\t32\t0"
        ))
        val up_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), up.wire
        )
        val navigation = browser_renderer_fetch_request_decode(
            up_message.message
        )
        expect(navigation.kind).to_equal("document")
        expect(navigation.url).to_equal("https://source.test/space")
        expect(navigation.method).to_equal("POST")

    it "preserves canonical keyboard payload through the K2 worker path":
        val html = (
            "<button id='stay' data-focused>Stay</button>" +
            "<button id='next'>Next</button>" +
            "<script>var stay=document.getElementById('stay');" +
            "stay.addEventListener('keydown',function(event){" +
            "document.title=event.key+'|'+event.code+'|'+event.shiftKey+'|'+" +
            "event.altKey+'|'+event.ctrlKey+'|'+event.metaKey+'|'+event.repeat;" +
            "if(event.key==='Tab'&&event.shiftKey){event.preventDefault();}});" +
            "stay.addEventListener('keyup',function(event){" +
            "document.title=event.type+'|'+event.key+'|'+event.code;});</script>"
        )
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: html
        )).ok).to_be(true)

        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 3,
            payload: "K2\t1\t65\t1\t1"
        )).ok).to_be(true)
        expect(worker.browser.current_title).to_equal(
            "A|KeyA|true|false|false|false|false"
        )
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 4,
            payload: "K2\t2\t37\t1\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_title).to_equal(
            "ArrowLeft|ArrowLeft|false|false|false|false|false"
        )
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K2\t3\t37\t0\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_title).to_equal(
            "keyup|ArrowLeft|ArrowLeft"
        )
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K2\t4\t9\t1\t1"
        )).ok).to_be(true)
        expect(_worker_focused_author_id(worker)).to_equal("stay")

    it "fails closed when a script exceeds the cookie write batch":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://safe.test/", "<p>safe</p>"
        ).is_ok()).to_be(true)
        var i: i64 = 0
        while i < 33:
            val _ = worker.browser.eval_script(
                "document.cookie = 'queued{i}=yes; Path=/'"
            )
            i = i + 1
        val result = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "A1\t0"
        ))
        expect(result.ok).to_be(false)
        expect(result.reason).to_equal("renderer-script-cookie-write-limit")

    it "keeps DOM focus and trusted chrome state across bounded actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init",
            generation: 7,
            request_id: 2,
            payload: "<input id='name' value='' onkeydown='set-attr:data-down=yes' onkeyup='set-attr:data-up=yes'>"
        ))
        expect(initialized.ok).to_be(true)
        expect(worker.last_hit_index != nil).to_be(true)

        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t5\t5\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t5\t5\t0"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t3\t87\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 6,
            payload: "T1\t4\t1\nw"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 7,
            payload: "K1\t5\t87\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_body_html).to_contain("value=\"w\"")
        expect(worker.browser.current_body_html).to_contain("data-down=\"yes\"")
        expect(worker.browser.current_body_html).to_contain("data-up=\"yes\"")

        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 8,
            payload: "C1\t6\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 9,
            payload: "C1\t7\t0\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 10,
            payload: "T1\t8\t20\nhttps://example.test"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("https://example.test")

        val submitted = worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 11,
            payload: "K1\t9\t13\t1"
        ))
        expect(submitted.ok).to_be(false)
        expect(submitted.reason).to_equal("navigation-command-required")

        worker.browser.apply_set_cookie_header(
            "sid=broker-owned; Secure; Path=/",
            "https://example.test/"
        )
        val navigation_wire = browser_renderer_navigation_encode(
            7, 11, "open", "https://example.test", "GET", "", "", ""
        )
        val navigation_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), navigation_wire.wire
        )
        val requested = worker.handle(navigation_message.message)
        expect(requested.ok).to_be(true)
        val fetch_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), requested.wire
        )
        expect(fetch_message.message.kind).to_equal("fetch_request")
        val fetch = browser_renderer_fetch_request_decode(
            fetch_message.message
        )
        expect(fetch.ok).to_be(true)
        expect(fetch.reply_to_request_id).to_equal(11)
        expect(fetch.kind).to_equal("document")
        expect(fetch.credentials).to_equal("include")
        expect(fetch.headers.contains("Cookie:")).to_be(false)
        expect(fetch.url.starts_with("https://example.test")).to_be(true)

        val response_wire = browser_renderer_network_response_encode(
            7, 12, fetch.request_id, fetch.kind, fetch.url,
            200, "Content-Type: text/html",
            "<style>body{{color:#2563eb}}</style><button id='loaded'>Loaded</button>",
            ""
        )
        val response_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), response_wire.wire
        )
        val committed = worker.handle(response_message.message)
        expect(committed.ok).to_be(true)
        expect(worker.browser.current_body_html).to_contain("Loaded")

    it "keeps clicked native controls focused for keyboard activation":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        step("Open a native checkbox in the isolated browser worker")
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}input{display:block;width:20px;height:18px}</style><input id='text' value='abc' data-focused><input id='toggle' type='checkbox'>"
        )).ok).to_be(true)
        expect(_worker_selection_author_id(worker)).to_equal("text")
        expect(worker.input_view_target_key).not.to_equal("")
        worker.input_view_start_byte = 2
        worker.caret_blink_epoch_ms = 17

        step("Click the checkbox and retain its DOM focus")
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t5\t25\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t5\t25\t0"
        )).ok).to_be(true)
        expect(_worker_focused_author_id(worker)).to_equal("toggle")
        expect(worker.browser.text_selection_route).to_be_nil()
        expect(worker.input_view_target_key).to_equal("")
        expect(worker.input_view_start_byte).to_equal(0)
        expect(worker.caret_blink_epoch_ms).to_equal(0)
        expect(worker.browser.current_body_html).to_contain(
            "checked=\"checked\""
        )

        step("Activate the focused checkbox with Space")
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t3\t32\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t4\t32\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_body_html.contains(
            "checked=\"checked\""
        )).to_be(false)

    it "edits the focused address draft by UTF-8 scalar through worker actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)

        val korean = browser_renderer_text_encode(7, 5, 3, "한")
        val korean_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), korean.wire
        )
        expect(worker.handle(korean_message.message).ok).to_be(true)
        val accented = browser_renderer_text_encode(7, 6, 4, "é")
        val accented_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), accented.wire
        )
        expect(worker.handle(accented_message.message).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("한é")

        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 7,
            payload: "K1\t5\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("한")
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 8,
            payload: "K1\t6\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("")

    it "accepts 2048 UTF-8 address bytes and atomically rejects 2049":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)

        val exact = "é".repeat(1024)
        val exact_wire = browser_renderer_text_encode(7, 5, 3, exact)
        expect(exact_wire.ok).to_be(true)
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), exact_wire.wire
        ).message).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal(exact)

        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 6,
            payload: "C1\t4\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 7,
            payload: "C1\t5\t0\t7\naddress"
        )).ok).to_be(true)
        val oversized_wire = browser_renderer_text_encode(
            7, 8, 6, exact + "x"
        )
        expect(oversized_wire.ok).to_be(true)
        val rejected = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), oversized_wire.wire
        ).message)

        expect(rejected.ok).to_be(false)
        expect(rejected.reason).to_equal("address-too-long")
        expect(worker.browser.address_draft).to_equal(exact)
        expect(worker.chrome_focus).to_equal("address")
        expect(worker.address_replace_on_text).to_be(true)

    it "restores the committed address or about blank on Escape":
        var committed = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(committed.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(committed.browser.open_html(
            "https://committed.test/page", "<p>committed</p>"
        ).is_ok()).to_be(true)
        expect(committed.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(committed.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)
        val draft_wire = browser_renderer_text_encode(
            7, 5, 3, "https://draft.test/"
        )
        expect(committed.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), draft_wire.wire
        ).message).ok).to_be(true)
        val committed_escape = committed.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t4\t27\t1"
        ))
