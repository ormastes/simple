# @cover src/os/hosted/hosted_browser_renderer_worker.spl 80%

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand}
use std.common.web.browser_renderer_protocol.{
    BROWSER_RENDERER_WORKER_ARG,
    BrowserRendererMessage,
    browser_renderer_decoder_feed, browser_renderer_decoder_new,
    browser_renderer_fetch_request_decode,
    browser_renderer_frame_decode,
    browser_renderer_navigation_encode,
    browser_renderer_network_response_encode,
    browser_renderer_resize_encode,
    browser_renderer_scroll_encode,
    browser_renderer_text_encode
}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession,
    hosted_browser_renderer_handle_init,
    hosted_browser_renderer_handle_request,
    hosted_browser_renderer_worker_main
}

extern fn rt_file_read_text(path: text) -> text
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{be_dom_focused_id}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_hit_test_index
}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.gc_async_mut.web.browser_session_runtime.*

extern fn rt_bytes_to_text(bytes: [u8]) -> text

val SCRIPT_ANIMATION_HTML = "<!DOCTYPE html><html><head><style>#stage { width:32px; height:24px; background-color:#ef4444; }</style></head><body><script type='text/simple'>title \"SimpleReady\"\nbody_html '<div id=\"stage\"></div>'</script><script>requestAnimationFrame(function(frameTime){ document.body.innerHTML = '<div style=\"width:32px;height:24px;background-color:#2563eb\"></div>'; });</script></body></html>"
val CSS_ANIMATION_HTML = "<style>@keyframes pulse { from { background-color:#ef4444; } to { background-color:#2563eb; } } #stage { width:32px; height:24px; animation:pulse 1000ms linear forwards; }</style><div id='stage'></div>"

fn _render(html: text, time_ms: i64):
    hosted_browser_renderer_handle_init(
        BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 1, payload: html
        ),
        64,
        48,
        time_ms,
        2
    )

fn _worker_command_index(
    commands: [DrawIrCommand], component_id: text
) -> i32:
    var i = 0
    while i < commands.len():
        if commands[i].component_id == component_id:
            return i
        i = i + 1
    -1

describe "hosted browser renderer worker":

    it "releases the previous hit graph before repaint allocation":
        val source = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_worker.spl"
        ) ?? ""
        val release_at = source.find("self.last_hit_index = nil")
        val repaint_at = source.find("val frame = _worker_frame(")
        expect(release_at).to_be_greater_than(-1)
        expect(repaint_at).to_be_greater_than(release_at)
    it "rejects hidden worker markers outside the exact spawn shape":
        expect(hosted_browser_renderer_worker_main([
            "hosted-entry", "extra", BROWSER_RENDERER_WORKER_ARG,
            "7", "64", "48"
        ])).to_equal(64)
        expect(hosted_browser_renderer_worker_main([
            "hosted-entry", BROWSER_RENDERER_WORKER_ARG,
            "7", "64", "48", "tail"
        ])).to_equal(64)

    it "renders HTML CSS Simple Script JavaScript and CSS animation into bounded DrawIR":
        val script_first = _render(SCRIPT_ANIMATION_HTML, 0)
        val script_animated = _render(SCRIPT_ANIMATION_HTML, 16)
        val css_first = _render(CSS_ANIMATION_HTML, 0)
        val css_middle = _render(CSS_ANIMATION_HTML, 500)
        val css_last = _render(CSS_ANIMATION_HTML, 1000)

        expect(script_first.ok).to_be(true)
        expect(script_animated.ok).to_be(true)
        expect(css_first.ok).to_be(true)
        expect(css_middle.ok).to_be(true)
        expect(css_last.ok).to_be(true)
        expect(script_first.wire == script_animated.wire).to_be(false)
        expect(css_first.wire == css_middle.wire).to_be(false)
        expect(css_middle.wire == css_last.wire).to_be(false)

        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), script_animated.wire
        )
        expect(decoded.status).to_equal("message")
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.ok).to_be(true)
        expect(frame.composition.batches[0].commands.len()).to_be_greater_than(0)
        expect(frame.next_animation_ms).to_equal(-1)

        val script_initial_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), script_first.wire
        )
        expect(browser_renderer_frame_decode(
            script_initial_message.message, 64, 48
        ).next_animation_ms).to_equal(16)
        val css_initial_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), css_first.wire
        )
        expect(browser_renderer_frame_decode(
            css_initial_message.message, 64, 48
        ).next_animation_ms).to_equal(16)
        val css_last_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), css_last.wire
        )
        expect(browser_renderer_frame_decode(
            css_last_message.message, 64, 48
        ).next_animation_ms).to_equal(-1)

    it "rejects non-init input":
        val rejected = hosted_browser_renderer_handle_init(
            BrowserRendererMessage(
                kind: "state", generation: 7, request_id: 1, payload: ""
            ),
            64,
            48,
            0,
            2
        )
        expect(rejected.ok).to_be(false)
        expect(rejected.reason).to_equal("expected-init")

    it "retains one browser session across animation frames":
        var session = BrowserSession.new()
        val first = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "init",
                generation: 7,
                request_id: 2,
                payload: SCRIPT_ANIMATION_HTML
            ),
            64,
            48,
            false,
            0,
            2
        )
        val animated = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 3,
                payload: "16"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )

        expect(first.ok).to_be(true)
        expect(animated.ok).to_be(true)
        expect(first.wire == animated.wire).to_be(false)
        expect(animated.animation_time_ms).to_equal(16)

    it "caps warning diagnostics before encoding animation frames":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>bounded diagnostics</p>"
        )).ok).to_be(true)
        expect(worker.last_hit_index != nil).to_be(true)
        var index = 0
        while index < 256:
            worker.browser._append_warning(
                "warning-{index}-abcdefghijklmnopqrstuvwxyz0123456789"
            )
            index = index + 1
        val advanced = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3, payload: "16"
        ))
        expect(worker.last_hit_index != nil).to_be(true)
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), advanced.wire
        )
        val frame = browser_renderer_frame_decode(decoded.message, 64, 48)
        expect(frame.ok).to_be(true)
        expect(frame.diagnostics.len()).to_equal(4096)
        expect(frame.diagnostics).to_start_with("warning-0-")

    it "resizes the existing session and emits matching frame bounds":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<div style='width:100%;height:100%'></div>"
        ))
        expect(initialized.ok).to_be(true)
        val encoded = browser_renderer_resize_encode(7, 3, 96, 64)
        val decoded = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        )
        val resized = worker.handle(decoded.message)
        expect(resized.ok).to_be(true)
        val frame_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), resized.wire
        )
        expect(browser_renderer_frame_decode(
            frame_message.message, 96, 64
        ).ok).to_be(true)
        expect(worker.width).to_equal(96)
        expect(worker.height).to_equal(64)

    it "scrolls pixels and hit testing together within document bounds":
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#top{height:20px;background:#ef4444}#space{height:80px}#below{display:block;width:40px;height:20px;background:#2563eb}</style><div id='top'></div><div id='space'></div><button id='below'>Below</button>"
        ))
        val initial_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), initialized.wire
            ).message,
            80, 50
        )
        expect(initial_frame.ok).to_be(true)
        expect(_worker_command_index(
            initial_frame.composition.batches[0].commands, "below"
        )).to_equal(-1)

        val half_a = browser_renderer_scroll_encode(7, 3, 1, 500)
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), half_a.wire
        ).message).ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(500)
        val half_b = browser_renderer_scroll_encode(7, 4, 2, 500)
        expect(worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), half_b.wire
        ).message).ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(1000)
        val encoded = browser_renderer_scroll_encode(7, 5, 3, 69000)
        val scrolled = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        ).message)
        val scrolled_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), scrolled.wire
            ).message,
            80, 50
        )
        expect(scrolled_frame.ok).to_be(true)
        expect(_worker_command_index(
            scrolled_frame.composition.batches[0].commands, "below"
        )).to_be_greater_than(-1)
        expect(worker.scroll_milli_y).to_equal(70000)
        expect(simple_web_layout_hit_test_index(
            worker.last_hit_index.unwrap(), 5, 35
        )).to_equal("id:below")

    it "resets scroll when cached history changes the document":
        val tall = "<style>body{margin:0}main{height:240px}</style><main></main>"
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: tall
        )).ok).to_be(true)
        expect(worker.browser.open_html(
            "https://b.test/", tall
        ).is_ok()).to_be(true)

        worker.scroll_milli_y = 12000
        val mismatched = browser_renderer_navigation_encode(
            7, 3, "back", "https://wrong.test/", "GET", "", "", ""
        )
        val rejected = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), mismatched.wire
        ).message)
        expect(rejected.ok).to_be(false)
        expect(rejected.reason).to_equal("navigation-target-mismatch")
        expect(worker.scroll_milli_y).to_equal(12000)
        expect(worker.browser.go_forward().is_ok()).to_be(true)

        val back = browser_renderer_navigation_encode(
            7, 3, "back", "simple-renderer://document", "GET", "", "", ""
        )
        val back_result = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), back.wire
        ).message)
        expect(back_result.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(back_result.resolved_scroll_y).to_equal(0)
        val back_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), back_result.wire
            ).message,
            80, 50
        )
        expect(back_frame.history_state_present).to_be(true)
        expect(back_frame.history_current_url).to_equal(
            "simple-renderer://document"
        )
        expect(back_frame.history_forward_url).to_equal("https://b.test/")

        worker.scroll_milli_y = 9000
        val forward = browser_renderer_navigation_encode(
            7, 4, "forward", "https://b.test/", "GET", "", "", ""
        )
        val forward_result = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), forward.wire
        ).message)
        expect(forward_result.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(forward_result.resolved_scroll_y).to_equal(0)
        val forward_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), forward_result.wire
            ).message,
            80, 50
        )
        expect(forward_frame.history_current_url).to_equal("https://b.test/")
        expect(forward_frame.history_back_url).to_equal("")

    it "clips hidden descendants from scrolling painting and hit testing":
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#clip{position:relative;width:10px;height:20px;overflow:hidden}button{position:absolute;width:20px;height:10px}#hidden{left:20px;top:0}#deep{left:0;top:100px}</style><div id='clip'><button id='hidden'>Hidden</button><button id='deep'>Deep</button></div>"
        )).ok).to_be(true)
        expect(simple_web_layout_hit_test_index(
            worker.last_hit_index.unwrap(), 25, 5
        ) == "id:hidden").to_be(false)
        val encoded = browser_renderer_scroll_encode(7, 3, 1, 100000)
        val scrolled = worker.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), encoded.wire
        ).message)
        val frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), scrolled.wire
            ).message,
            80, 50
        )
        expect(frame.ok).to_be(true)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(_worker_command_index(
            frame.composition.batches[0].commands, "hidden"
        )).to_equal(-1)
        expect(_worker_command_index(
            frame.composition.batches[0].commands, "deep"
        )).to_equal(-1)

    it "starts navigated CSS animation on the document clock":
        var worker = HostedBrowserRendererWorkerSession.create(64, 48)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<p>old</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "5000"
        )).ok).to_be(true)
        worker.scroll_milli_y = 12000
        val navigation = browser_renderer_navigation_encode(
            7, 4, "open", "https://example.test/", "GET", "", "", ""
        )
        val navigation_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), navigation.wire
        )
        val requested = worker.handle(navigation_message.message)
        val fetch_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), requested.wire
        )
        val fetch = browser_renderer_fetch_request_decode(
            fetch_message.message
        )
        val response = browser_renderer_network_response_encode(
            7, 5, fetch.request_id, fetch.kind, fetch.url,
            200, "Content-Type: text/html", CSS_ANIMATION_HTML, ""
        )
        val response_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), response.wire
        )
        val committed = worker.handle(response_message.message)
        val frame_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), committed.wire
        )
        val frame = browser_renderer_frame_decode(
            frame_message.message, 64, 48
        )
        expect(frame.ok).to_be(true)
        expect(worker.browser.animation_start_time_ms).to_equal(5000)
        expect(worker.scroll_milli_y).to_equal(0)
        expect(frame.next_animation_ms).to_equal(5016)

    it "keeps DOM focus and trusted chrome state across bounded actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init",
            generation: 7,
            request_id: 2,
            payload: "<input id='name' value='' onkeydown='set-attr:data-down=yes' onkeyup='set-attr:data-up=yes'>"
        ))
        expect(initialized.ok).to_be(true)
        expect(worker.last_hit_index != nil).to_be(true)

        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t5\t5\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t5\t5\t0"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t3\t87\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 6,
            payload: "T1\t4\t1\nw"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 7,
            payload: "K1\t5\t87\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_body_html).to_contain("value=\"w\"")
        expect(worker.browser.current_body_html).to_contain("data-down=\"yes\"")
        expect(worker.browser.current_body_html).to_contain("data-up=\"yes\"")

        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 8,
            payload: "C1\t6\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 9,
            payload: "C1\t7\t0\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 10,
            payload: "T1\t8\t20\nhttps://example.test"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("https://example.test")

        val submitted = worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 11,
            payload: "K1\t9\t13\t1"
        ))
        expect(submitted.ok).to_be(false)
        expect(submitted.reason).to_equal("navigation-command-required")

        val navigation_wire = browser_renderer_navigation_encode(
            7, 11, "open", "https://example.test", "GET", "", "", ""
        )
        val navigation_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), navigation_wire.wire
        )
        val requested = worker.handle(navigation_message.message)
        expect(requested.ok).to_be(true)
        val fetch_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), requested.wire
        )
        expect(fetch_message.message.kind).to_equal("fetch_request")
        val fetch = browser_renderer_fetch_request_decode(
            fetch_message.message
        )
        expect(fetch.ok).to_be(true)
        expect(fetch.reply_to_request_id).to_equal(11)
        expect(fetch.kind).to_equal("document")
        expect(fetch.url.starts_with("https://example.test")).to_be(true)

        val response_wire = browser_renderer_network_response_encode(
            7, 12, fetch.request_id, fetch.kind, fetch.url,
            200, "Content-Type: text/html",
            "<style>body{color:#2563eb}</style><button id='loaded'>Loaded</button>",
            ""
        )
        val response_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), response_wire.wire
        )
        val committed = worker.handle(response_message.message)
        expect(committed.ok).to_be(true)
        expect(worker.browser.current_body_html).to_contain("Loaded")

    it "keeps clicked native controls focused for keyboard activation":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        step("Open a native checkbox in the isolated browser worker")
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}input{display:block;width:20px;height:18px}</style><input id='text' value='abc' data-focused><input id='toggle' type='checkbox'>"
        )).ok).to_be(true)
        expect(worker.browser.text_selection_target_id).to_equal("text")
        expect(worker.input_view_target_key).not.to_equal("")
        worker.input_view_start_byte = 2
        worker.caret_blink_epoch_ms = 17

        step("Click the checkbox and retain its DOM focus")
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t5\t25\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t5\t25\t0"
        )).ok).to_be(true)
        expect(be_dom_focused_id(worker.browser.dom_root())).to_equal("toggle")
        expect(worker.browser.text_selection_target_id).to_equal("")
        expect(worker.input_view_target_key).to_equal("")
        expect(worker.input_view_start_byte).to_equal(0)
        expect(worker.caret_blink_epoch_ms).to_equal(0)
        expect(worker.browser.current_body_html).to_contain(
            "checked=\"checked\""
        )

        step("Activate the focused checkbox with Space")
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t3\t32\t1"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t4\t32\t0"
        )).ok).to_be(true)
        expect(worker.browser.current_body_html.contains(
            "checked=\"checked\""
        )).to_be(false)

    it "edits the focused address draft by UTF-8 scalar through worker actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)

        val korean = browser_renderer_text_encode(7, 5, 3, "한")
        val korean_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), korean.wire
        )
        expect(worker.handle(korean_message.message).ok).to_be(true)
        val accented = browser_renderer_text_encode(7, 6, 4, "é")
        val accented_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), accented.wire
        )
        expect(worker.handle(accented_message.message).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("한é")

        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 7,
            payload: "K1\t5\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("한")
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 8,
            payload: "K1\t6\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal("")

    it "fails closed on malformed UTF-8 address drafts through Backspace actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)
        val invalid_continuation = rt_bytes_to_text([0xE2u8, 0x28u8, 0xA1u8])
        expect(invalid_continuation.len()).to_equal(3)
        expect(invalid_continuation.byte_at(0)).to_equal(0xE2.to_u8())
        expect(invalid_continuation.byte_at(1)).to_equal(0x28.to_u8())
        expect(invalid_continuation.byte_at(2)).to_equal(0xA1.to_u8())
        worker.browser.address_draft = invalid_continuation
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t1\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal(invalid_continuation)

        val truncated = rt_bytes_to_text([0xE2u8, 0x82u8])
        expect(truncated.len()).to_equal(2)
        worker.browser.address_draft = truncated
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t2\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal(truncated)

    it "maps pointer x through UTF-8 source boundaries before insertion":
        var worker = HostedBrowserRendererWorkerSession.create(120, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:100px;height:20px}</style><input id='q' value='aéz'>"
        )).ok).to_be(true)
        val hit = worker.last_hit_index.unwrap().input_text_hits[0]
        val x = hit.boundary_x_px[2]
        val y = hit.y + 1
        val down = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{x}\t{y}\t1"
        ))
        val up = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t{x}\t{y}\t0"
        ))
        val typed = worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 5,
            payload: "T1\t3\t1\nX"
        ))
        expect(down.ok).to_be(true)
        expect(up.ok).to_be(true)
        expect(typed.ok).to_be(true)
        expect(down.wire).not.to_equal("")
        expect(up.wire).not.to_equal("")
        expect(typed.wire).not.to_equal("")
        expect(worker.browser.current_body_html).to_contain(
            "value=\"aéXz\""
        )

    it "uses initial centered and right-aligned paint baselines for click x":
        var centered = HostedBrowserRendererWorkerSession.create(140, 40)
        val centered_init = centered.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:120px;height:20px;text-align:center}</style><input id='q' value='abc'>"
        ))
        val centered_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), centered_init.wire
            ).message,
            140, 40
        )
        val centered_commands = (
            centered_frame.composition.batches[0].commands
        )
        val centered_text_x = centered_commands[_worker_command_index(
            centered_commands, "q_value"
        )].x
        val centered_hit = centered.last_hit_index.unwrap().input_text_hits[0]
        expect(centered_hit.boundary_x_px[0]).to_equal(centered_text_x)
        expect(centered.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{centered_hit.boundary_x_px[1]}\t{centered_hit.y + 1}\t1"
        )).ok).to_be(true)
        expect(centered.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 4,
            payload: "T1\t2\t1\nX"
        )).ok).to_be(true)
        expect(centered.browser.current_body_html).to_contain(
            "value=\"aXbc\""
        )

        var right = HostedBrowserRendererWorkerSession.create(140, 40)
        val right_init = right.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:120px;height:20px;text-align:right}</style><input id='q' value='abc'>"
        ))
        val right_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), right_init.wire
            ).message,
            140, 40
        )
        val right_commands = right_frame.composition.batches[0].commands
        val right_text_x = right_commands[_worker_command_index(
            right_commands, "q_value"
        )].x
        val right_hit = right.last_hit_index.unwrap().input_text_hits[0]
        expect(right_hit.boundary_x_px[0]).to_equal(right_text_x)
        expect(right.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{right_hit.boundary_x_px[1]}\t{right_hit.y + 1}\t1"
        )).ok).to_be(true)
        expect(right.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 4,
            payload: "T1\t2\t1\nX"
        )).ok).to_be(true)
        expect(right.browser.current_body_html).to_contain(
            "value=\"aXbc\""
        )

    it "schedules 500ms caret edges and cancels after blank blur":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:40px;height:18px}</style><input id='q' value='a' data-focused>"
        ))
        val initialized_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), initialized.wire
        )
        val initialized_frame = browser_renderer_frame_decode(
            initialized_message.message, 80, 40
        )
        expect(initialized_frame.next_animation_ms).to_equal(500)
        expect(_worker_command_index(
            initialized_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)

        val advanced = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "500"
        ))
        val advanced_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), advanced.wire
        )
        val advanced_frame = browser_renderer_frame_decode(
            advanced_message.message, 80, 40
        )
        expect(advanced_frame.next_animation_ms).to_equal(1000)
        expect(_worker_command_index(
            advanced_frame.composition.batches[0].commands,
            "q_caret"
        )).to_equal(-1)

        val visible_again = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 4,
            payload: "1000"
        ))
        val visible_again_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), visible_again.wire
            ).message,
            80, 40
        )
        expect(_worker_command_index(
            visible_again_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)

        val blurred = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 5,
            payload: "P1\t1\t79\t39\t1"
        ))
        val blurred_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), blurred.wire
        )
        val blurred_frame = browser_renderer_frame_decode(
            blurred_message.message, 80, 40
        )
        expect(blurred_frame.next_animation_ms).to_equal(-1)
        expect(_worker_command_index(
            blurred_frame.composition.batches[0].commands,
            "q_caret"
        )).to_equal(-1)
        expect(worker.browser.text_selection_target_id).to_equal("")

    it "preserves focused selection view and blink when pointer default is prevented":
        var worker = HostedBrowserRendererWorkerSession.create(60, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:24px;height:18px}</style><input id='q' value='abcdefghij' data-focused onpointerdown='prevent-default' onmousedown='prevent-default'>"
        )).ok).to_be(true)
        val retained_view = worker.input_view_start_byte
        val retained_anchor = worker.browser.text_selection_anchor_byte
        val retained_focus = worker.browser.text_selection_focus_byte
        val retained_epoch = worker.caret_blink_epoch_ms
        val hit = worker.last_hit_index.unwrap().input_text_hits[0]
        val kept = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{hit.boundary_x_px[hit.boundary_x_px.len() - 1]}\t{hit.y + 1}\t1"
        ))
        expect(kept.ok).to_be(true)
        expect(be_dom_focused_id(
            worker.browser.dom_root()
        )).to_equal("q")
        expect(worker.browser.text_selection_target_id).to_equal("q")
        expect(worker.browser.text_selection_anchor_byte).to_equal(
            retained_anchor
        )
        expect(worker.browser.text_selection_focus_byte).to_equal(
            retained_focus
        )
        expect(worker.input_view_start_byte).to_equal(retained_view)
        expect(worker.caret_blink_epoch_ms).to_equal(retained_epoch)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t{hit.boundary_x_px[hit.boundary_x_px.len() - 1]}\t{hit.y + 1}\t0"
        )).ok).to_be(true)
        expect(worker.browser.text_selection_anchor_byte).to_equal(
            retained_anchor
        )
        expect(worker.browser.text_selection_focus_byte).to_equal(
            retained_focus
        )
        expect(worker.input_view_start_byte).to_equal(retained_view)
        expect(worker.caret_blink_epoch_ms).to_equal(retained_epoch)

    it "clears page caret state and scheduling when chrome takes focus":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}#q{width:40px;height:18px}</style><input id='q' value='abc' data-focused>"
        ))
        val initialized_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), initialized.wire
            ).message,
            80, 40
        )
        expect(_worker_command_index(
            initialized_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)
        val chrome = worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        ))
        val chrome_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), chrome.wire
            ).message,
            80, 40
        )
        expect(_worker_command_index(
            chrome_frame.composition.batches[0].commands,
            "q_caret"
        )).to_equal(-1)
        expect(chrome_frame.next_animation_ms).to_equal(-1)
        expect(be_dom_focused_id(worker.browser.dom_root())).to_equal("")
        expect(worker.browser.text_selection_target_id).to_equal("")
        expect(worker.input_view_target_key).to_equal("")
        expect(worker.input_view_start_byte).to_equal(0)
        expect(worker.caret_blink_epoch_ms).to_equal(0)

    it "retains focused view across frames and resets it for a new target":
        var worker = HostedBrowserRendererWorkerSession.create(80, 50)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{margin:0}input{display:block;width:24px;height:18px}</style><input id='first' value='abcdefghij' data-focused><input id='second' value='xy'>"
        )).ok).to_be(true)
        val first_view = worker.input_view_start_byte
        expect(first_view).to_be_greater_than(0)
        expect(worker.input_view_target_key).to_equal("id:first")
        expect(worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "100"
        )).ok).to_be(true)
        expect(worker.input_view_start_byte).to_equal(first_view)
        val second_hit = worker.last_hit_index.unwrap().input_text_hits[1]
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t1\t{second_hit.boundary_x_px[0]}\t{second_hit.y + 1}\t1"
        )).ok).to_be(true)
        expect(worker.input_view_target_key).to_equal("id:second")
        expect(worker.input_view_start_byte).to_equal(0)

    it "rejects skipped ids and backward animation time":
        var session = BrowserSession.new()
        val first = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "init",
                generation: 7,
                request_id: 2,
                payload: CSS_ANIMATION_HTML
            ),
            64,
            48,
            false,
            0,
            2
        )
        val skipped = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 4,
                payload: "500"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )
        val advanced = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 3,
                payload: "500"
            ),
            64,
            48,
            first.initialized,
            first.animation_time_ms,
            3
        )
        val backward = hosted_browser_renderer_handle_request(
            session,
            BrowserRendererMessage(
                kind: "advance",
                generation: 7,
                request_id: 4,
                payload: "16"
            ),
            64,
            48,
            advanced.initialized,
            advanced.animation_time_ms,
            4
        )

        expect(skipped.ok).to_be(false)
        expect(skipped.reason).to_equal("unexpected-request-id")
        expect(advanced.ok).to_be(true)
        expect(backward.ok).to_be(false)
        expect(backward.reason).to_equal("invalid-animation-time")
