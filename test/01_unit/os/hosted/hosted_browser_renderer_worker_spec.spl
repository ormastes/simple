            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(blank.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(blank.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)
        val blank_draft_wire = browser_renderer_text_encode(
            7, 5, 3, "https://draft.test/"
        )
        expect(blank.handle(browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), blank_draft_wire.wire
        ).message).ok).to_be(true)
        val blank_escape = blank.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t4\t27\t1"
        ))
        expect(blank_escape.ok).to_be(true)
        expect(blank.browser.address_draft).to_equal("about:blank")
        expect(blank.chrome_focus).to_equal("")
        expect(blank.address_replace_on_text).to_be(false)

    it "fails closed on malformed UTF-8 address drafts through Backspace actions":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2, payload: "<p>ready</p>"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 3,
            payload: "C1\t1\t1\t7\naddress"
        )).ok).to_be(true)
        expect(worker.handle(BrowserRendererMessage(
            kind: "chrome", generation: 7, request_id: 4,
            payload: "C1\t2\t0\t7\naddress"
        )).ok).to_be(true)
        val invalid_continuation = rt_bytes_to_text([0xE2u8, 0x28u8, 0xA1u8])
        expect(invalid_continuation.len()).to_equal(3)
        expect(invalid_continuation.byte_at(0)).to_equal(0xE2.to_u8())
        expect(invalid_continuation.byte_at(1)).to_equal(0x28.to_u8())
        expect(invalid_continuation.byte_at(2)).to_equal(0xA1.to_u8())
        worker.browser.address_draft = invalid_continuation
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 5,
            payload: "K1\t1\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal(invalid_continuation)

        val truncated = rt_bytes_to_text([0xE2u8, 0x82u8])
        expect(truncated.len()).to_equal(2)
        worker.browser.address_draft = truncated
        expect(worker.handle(BrowserRendererMessage(
            kind: "key", generation: 7, request_id: 6,
            payload: "K1\t2\t8\t1"
        )).ok).to_be(true)
        expect(worker.browser.address_draft).to_equal(truncated)

    it "maps pointer x through UTF-8 source boundaries before insertion":
        var worker = HostedBrowserRendererWorkerSession.create(120, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:100px;height:20px}</style><input id='q' value='aéz'>"
        )).ok).to_be(true)
        val hit = worker.last_hit_index.unwrap().input_text_hits[0]
        val x = hit.boundary_x_px[2]
        val y = hit.y + 1
        val down = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{x}\t{y}\t1"
        ))
        val up = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t{x}\t{y}\t0"
        ))
        val typed = worker.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 5,
            payload: "T1\t3\t1\nX"
        ))
        expect(down.ok).to_be(true)
        expect(up.ok).to_be(true)
        expect(typed.ok).to_be(true)
        expect(down.wire).not.to_equal("")
        expect(up.wire).not.to_equal("")
        expect(typed.wire).not.to_equal("")
        expect(worker.browser.current_body_html).to_contain(
            "value=\"aéXz\""
        )

    it "uses initial centered and right-aligned paint baselines for click x":
        var centered = HostedBrowserRendererWorkerSession.create(140, 40)
        val centered_init = centered.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:120px;height:20px;text-align:center}</style><input id='q' value='abc'>"
        ))
        val centered_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), centered_init.wire
            ).message,
            140, 40
        )
        val centered_commands = (
            centered_frame.composition.batches[0].commands
        )
        val centered_text_x = centered_commands[_worker_command_index(
            centered_commands, "q_value"
        )].x
        val centered_hit = centered.last_hit_index.unwrap().input_text_hits[0]
        expect(centered_hit.boundary_x_px[0]).to_equal(centered_text_x)
        expect(centered.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{centered_hit.boundary_x_px[1]}\t{centered_hit.y + 1}\t1"
        )).ok).to_be(true)
        expect(centered.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 4,
            payload: "T1\t2\t1\nX"
        )).ok).to_be(true)
        expect(centered.browser.current_body_html).to_contain(
            "value=\"aXbc\""
        )

        var right = HostedBrowserRendererWorkerSession.create(140, 40)
        val right_init = right.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:120px;height:20px;text-align:right}</style><input id='q' value='abc'>"
        ))
        val right_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), right_init.wire
            ).message,
            140, 40
        )
        val right_commands = right_frame.composition.batches[0].commands
        val right_text_x = right_commands[_worker_command_index(
            right_commands, "q_value"
        )].x
        val right_hit = right.last_hit_index.unwrap().input_text_hits[0]
        expect(right_hit.boundary_x_px[0]).to_equal(right_text_x)
        expect(right.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{right_hit.boundary_x_px[1]}\t{right_hit.y + 1}\t1"
        )).ok).to_be(true)
        expect(right.handle(BrowserRendererMessage(
            kind: "text", generation: 7, request_id: 4,
            payload: "T1\t2\t1\nX"
        )).ok).to_be(true)
        expect(right.browser.current_body_html).to_contain(
            "value=\"aXbc\""
        )

    it "schedules 500ms caret edges and cancels after blank blur":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:40px;height:18px}</style><input id='q' value='a' data-focused>"
        ))
        val initialized_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), initialized.wire
        )
        val initialized_frame = browser_renderer_frame_decode(
            initialized_message.message, 80, 40
        )
        expect(initialized_frame.next_animation_ms).to_equal(500)
        expect(_worker_command_index(
            initialized_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)

        val advanced = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 3,
            payload: "500"
        ))
        val advanced_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), advanced.wire
        )
        val advanced_frame = browser_renderer_frame_decode(
            advanced_message.message, 80, 40
        )
        expect(advanced_frame.next_animation_ms).to_equal(1000)
        expect(_worker_command_index(
            advanced_frame.composition.batches[0].commands,
            "q_caret"
        )).to_equal(-1)

        val visible_again = worker.handle(BrowserRendererMessage(
            kind: "advance", generation: 7, request_id: 4,
            payload: "1000"
        ))
        val visible_again_frame = browser_renderer_frame_decode(
            browser_renderer_decoder_feed(
                browser_renderer_decoder_new(7), visible_again.wire
            ).message,
            80, 40
        )
        expect(_worker_command_index(
            visible_again_frame.composition.batches[0].commands,
            "q_caret"
        )).to_be_greater_than(-1)

        val blurred = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 5,
            payload: "P1\t1\t79\t39\t1"
        ))
        val blurred_message = browser_renderer_decoder_feed(
            browser_renderer_decoder_new(7), blurred.wire
        )
        val blurred_frame = browser_renderer_frame_decode(
            blurred_message.message, 80, 40
        )
        expect(blurred_frame.next_animation_ms).to_equal(-1)
        expect(_worker_command_index(
            blurred_frame.composition.batches[0].commands,
            "q_caret"
        )).to_equal(-1)
        expect(worker.browser.text_selection_route).to_be_nil()

    it "preserves focused selection view and blink when pointer default is prevented":
        var worker = HostedBrowserRendererWorkerSession.create(60, 40)
        expect(worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:24px;height:18px}</style><input id='q' value='abcdefghij' data-focused onpointerdown='prevent-default' onmousedown='prevent-default'>"
        )).ok).to_be(true)
        val retained_view = worker.input_view_start_byte
        val retained_anchor = worker.browser.text_selection_anchor_byte
        val retained_focus = worker.browser.text_selection_focus_byte
        val retained_epoch = worker.caret_blink_epoch_ms
        val hit = worker.last_hit_index.unwrap().input_text_hits[0]
        val kept = worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 3,
            payload: "P1\t1\t{hit.boundary_x_px[hit.boundary_x_px.len() - 1]}\t{hit.y + 1}\t1"
        ))
        expect(kept.ok).to_be(true)
        expect(_worker_focused_author_id(worker)).to_equal("q")
        expect(_worker_selection_author_id(worker)).to_equal("q")
        expect(worker.browser.text_selection_anchor_byte).to_equal(
            retained_anchor
        )
        expect(worker.browser.text_selection_focus_byte).to_equal(
            retained_focus
        )
        expect(worker.input_view_start_byte).to_equal(retained_view)
        expect(worker.caret_blink_epoch_ms).to_equal(retained_epoch)
        expect(worker.handle(BrowserRendererMessage(
            kind: "pointer", generation: 7, request_id: 4,
            payload: "P1\t2\t{hit.boundary_x_px[hit.boundary_x_px.len() - 1]}\t{hit.y + 1}\t0"
        )).ok).to_be(true)
        expect(worker.browser.text_selection_anchor_byte).to_equal(
            retained_anchor
        )
        expect(worker.browser.text_selection_focus_byte).to_equal(
            retained_focus
        )
        expect(worker.input_view_start_byte).to_equal(retained_view)
        expect(worker.caret_blink_epoch_ms).to_equal(retained_epoch)

    it "clears page caret state and scheduling when chrome takes focus":
        var worker = HostedBrowserRendererWorkerSession.create(80, 40)
        val initialized = worker.handle(BrowserRendererMessage(
            kind: "init", generation: 7, request_id: 2,
            payload: "<style>html,body{{margin:0}}#q{width:40px;height:18px}</style><input id='q' value='abc' data-focused>"
        ))
        val initialized_frame = browser_renderer_frame_decode(
