use std.spec.*
use os.hosted.hosted_browser_renderer_process.{
    HostedBrowserRendererProcess
}

describe "hosted browser frame wire receipt":
    it "starts empty and is scoped to the producer generation":
        val renderer = HostedBrowserRendererProcess.create(7, 7680, 4320)
        val receipt = renderer.frame_wire_receipt()
        expect(receipt.producer_generation).to_equal(7)
        expect(receipt.full_frame_count).to_equal(0)
        expect(receipt.reused_frame_count).to_equal(0)
        expect(receipt.full_payload_bytes).to_equal(0)
        expect(receipt.reused_payload_bytes).to_equal(0)
        expect(receipt.last_frame_reused).to_equal(false)
        expect(receipt.last_payload_bytes).to_equal(0)
