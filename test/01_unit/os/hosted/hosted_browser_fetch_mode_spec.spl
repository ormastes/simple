"""
## Purpose and audience
Purpose: Pin the Fetch mode each BrowserSession request kind is sent with
(shared by the hosted web-content session and the app browser pump).
Cross-origin `<img>` loads are no-cors, as in every browser; they used to be
same-origin, so github.com's CDN images (images.ctfassets.net) all failed
with a masked "Same-origin request denied".
Audience: maintainers of the browser network policy.
## Operator workflow
Run with the test runner; pure policy functions.
## Compatibility and limitations
Bug record: doc/08_tracking/bug/browser_real_site_rendering_gaps_2026-10-04.md
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001

use std.spec.*
use std.spec.step
use os.hosted.hosted_browser_renderer_policy.{hosted_browser_fetch_mode}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{RequestMode}

val PAGE: text = "https://github.com"

describe "BrowserSession request kind to Fetch mode":
    it "loads cross-origin and same-origin images as no-cors":
        expect(hosted_browser_fetch_mode("image", "https://images.ctfassets.net/a.webp", PAGE) == RequestMode.NoCors).to_equal(true)
        expect(hosted_browser_fetch_mode("image", "https://github.com/logo.png", PAGE) == RequestMode.NoCors).to_equal(true)

    it "keeps the other kinds unchanged":
        expect(hosted_browser_fetch_mode("document", "https://github.com/", PAGE) == RequestMode.Navigate).to_equal(true)
        expect(hosted_browser_fetch_mode("style", "https://cdn.test/a.css", PAGE) == RequestMode.NoCors).to_equal(true)
        expect(hosted_browser_fetch_mode("script", "https://cdn.test/a.js", PAGE) == RequestMode.NoCors).to_equal(true)
        step("script fetch() across origins is CORS; same-origin fetch and wasm stay same-origin")
        expect(hosted_browser_fetch_mode("fetch", "https://api.test/x", PAGE) == RequestMode.Cors).to_equal(true)
        expect(hosted_browser_fetch_mode("fetch", "https://github.com/x", PAGE) == RequestMode.SameOrigin).to_equal(true)
        expect(hosted_browser_fetch_mode("wasm", "https://cdn.test/m.wasm", PAGE) == RequestMode.SameOrigin).to_equal(true)
