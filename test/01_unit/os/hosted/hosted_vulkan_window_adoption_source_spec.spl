use std.spec.{describe, it, expect}

extern fn rt_fs_read_text(path: text) -> text?

describe "hosted WM Vulkan same-window adoption":
    it "adopts the existing Xlib window and skips softbuffer/readback presentation":
        val hosted = rt_fs_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        val compositor = rt_fs_read_text(
            "src/os/compositor/host_compositor_core.spl") ?? ""
        val runtime = rt_fs_read_text(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_swapchain.rs") ?? ""
        val winit = rt_fs_read_text("src/runtime/spl_winit/src/lib.rs") ?? ""
        expect(hosted).to_contain("SIMPLE_GUI_BACKEND")
        expect(hosted).to_contain("requested == \"vulkan-window\"")
        expect(hosted).to_contain("rt_winit_window_surface_kind(win)")
        expect(hosted).to_contain("create_vulkan_external_window_present(")
        expect(hosted).to_contain("not raster.window_present_enabled() and")
        expect(hosted).to_contain("raster.represent_retained_window()")
        expect(compositor).to_contain(
            "render_draw_ir_composition_resources_window_revision(")
        expect(compositor).to_contain("path=vulkan-window-swapchain")
        expect(runtime).to_contain("rt_vulkan_init_external_window_present")
        expect(runtime).to_contain("Surface::new_xlib")
        expect(winit).to_contain("RawDisplayHandle::Xlib")
        expect(winit).to_contain("RawWindowHandle::Xlib")

    it "keeps unsupported platform descriptors fail-closed":
        val winit = rt_fs_read_text("src/runtime/spl_winit/src/lib.rs") ?? ""
        val runtime = rt_fs_read_text(
            "src/compiler_rust/runtime/src/vulkan_graphics_runtime_swapchain.rs") ?? ""
        expect(winit).to_contain("_ => 0")
        expect(runtime).to_contain("if kind != 1")
        expect(runtime).to_contain("external window presentation must initialize before Vulkan resources")
