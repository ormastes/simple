# @cover src/os/hosted/hosted_browser_renderer_registry.spl 2%

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

describe "hosted browser consumes retained frame-switch receipts":
    it "checks the scalar receipt before pixel rendering and publishes no duplicate frame":
        val source = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_registry.spl")
        val start = source.find("    me _store_frame(")
        val finish = source.find("    me ensure(", start)
        expect(start).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(start)
        val body = source.slice(start, finish)
        val receipt = body.find(
            "hosted_browser_frame_switch_decide(")
        val pixel_render = body.find(
            "raster.render_draw_ir_composition_resources_revision(")
        val hit = body.find("if retained.reused:", receipt)
        val reuse_counter = body.find(
            "entry.frame_switch_reuse_count =", hit)
        val no_frame = body.find(
            "return retained.publication_status", hit)
        expect(receipt).to_be_greater_than(-1)
        expect(pixel_render).to_be_greater_than(receipt)
        expect(hit).to_be_greater_than(receipt)
        expect(reuse_counter).to_be_greater_than(hit)
        expect(no_frame).to_be_greater_than(reuse_counter)
        expect(no_frame).to_be_less_than(pixel_render)
