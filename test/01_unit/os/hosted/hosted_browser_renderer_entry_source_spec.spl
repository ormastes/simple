        val animation_end = post_text.find("        if evidence.enabled:")
        expect(animation_start).to_be_greater_than(-1)
        expect(text_end + animation_start).to_be_greater_than(renderer_owner)
        expect(animation_end).to_be_greater_than(animation_start)
        val animation_body = post_text.slice(animation_start, animation_end)
        val active_animation = animation_body.find(
            "browser_renderer.next_animation_ms >= 0"
        )
        val advance_call = animation_body.find(
            "browser_renderer.begin_advance("
        )
        val advance_failure = animation_body.find(
