        expect(active_animation).to_be_greater_than(-1)
        expect(advance_call).to_be_greater_than(active_animation)
        expect(advance_failure).to_be_greater_than(advance_call)

    # @req REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-009
    it "routes each secondary browser window through its own sandbox renderer":
        step("Inspect per-window sandbox renderer isolation")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val mouse = entry.slice(
            entry.find("elif kind == EVT_MOUSE_BUTTON:"),
            entry.find("elif kind == EVT_MOUSE_WHEEL:")
        )
        val secondary = mouse.find(
            "target.window_id != browser_profile_window_id"
        )
        val routed = mouse.find(
            "browser_renderers.dispatch_chrome_pointer("
        )
        val primary = mouse.find(
            "browser_pressed_control = target.control"
        )
        expect(secondary).to_be_greater_than(-1)
        expect(routed).to_be_greater_than(secondary)
        expect(primary).to_be_greater_than(routed)
        expect(mouse).to_contain(
            "comp.requires_external_web_frame(target.window_id)"
        )
        expect(mouse).to_contain("browser_renderers.dispatch_pointer(")
        expect(mouse).to_contain("browser_renderers.cancel_pointer_state(")

        val wheel = entry.slice(
            entry.find("elif kind == EVT_MOUSE_WHEEL:"),
            entry.find("elif kind == EVT_KEY:")
        )
        expect(wheel).to_contain("comp.content_target(")
        expect(wheel).to_contain(
            "val browser_scroll_y_milli = 0 - bounded_wheel_y_milli"
        )
        expect(wheel).to_contain("browser_renderer.queue_scroll(")
        expect(wheel).to_contain("browser_renderers.dispatch_scroll(")
        expect(wheel).to_contain("if not browser_wheel:")
        expect(wheel).to_contain("comp.handle_mouse_wheel(")

        val keyboard = entry.slice(
            entry.find("elif kind == EVT_KEY:"),
            entry.find("elif kind == EVT_TEXT:")
        )
        val text = entry.slice(
            entry.find("elif kind == EVT_TEXT:"),
            entry.find("val browser_animation_time_ms")
        )
        expect(keyboard).to_contain(
            "comp.requires_external_web_frame(focused)"
        )
        expect(keyboard).to_contain(
            "browser_renderers.dispatch_key_with_shift("
        )
        expect(text).to_contain(
            "comp.requires_external_web_frame(focused)"
        )
        expect(text).to_contain("browser_renderers.dispatch_text(")
        expect(entry).to_contain("browser_renderers.advance_window(")
        expect(entry).to_contain("browser_renderers.take_frame(")
        expect(entry).to_contain("browser_renderers.remove_window(")
        expect(entry).to_contain("browser_renderers.reconcile(")
        expect(entry).to_contain("val secondary_renderers_closed =")
        val render_start = entry.find(
            "                if comp.requires_external_web_frame(web_window.id):"
        )
        val render_end = entry.find(
            "                elif not web_window.minimized:", render_start
        )
        expect(render_start).to_be_greater_than(-1)
        expect(render_end).to_be_greater_than(render_start)
        val render_route = entry.slice(render_start, render_end)
        expect(render_route).to_contain(
            "browser_renderers.ensure(\n                                web_window.id"
        )
        expect(render_route).to_contain(
            "browser_renderers.advance_window(\n                            web_window.id"
        )
        expect(render_route).to_contain(
            "browser_renderers.take_frame(\n                                web_window.id"
        )
        expect(render_route).to_contain(
            "comp.set_external_web_frame_owned(\n                                web_window.id"
        )
        expect(render_route.contains("web_sessions.")).to_be(false)

        val browser_pointer_start = mouse.find(
            "if comp.requires_external_web_frame(target.window_id):"
        )
        val browser_pointer_end = mouse.find(
            "                        else:", browser_pointer_start
        )
        expect(browser_pointer_start).to_be_greater_than(-1)
        expect(browser_pointer_end).to_be_greater_than(browser_pointer_start)
        val browser_pointer = mouse.slice(
            browser_pointer_start, browser_pointer_end
        )
        expect(browser_pointer).to_contain(
            "browser_renderers.dispatch_pointer(\n" +
            "                                semantic_event_id, target.window_id"
        )
        expect(browser_pointer.contains("web_sessions.")).to_be(false)

        val browser_key_start = keyboard.find(
            "if comp.requires_external_web_frame(focused):"
        )
        val browser_key_end = keyboard.find(
            "                    else:", browser_key_start
        )
        expect(browser_key_start).to_be_greater_than(-1)
        expect(browser_key_end).to_be_greater_than(browser_key_start)
        val browser_key_route = keyboard.slice(
            browser_key_start, browser_key_end
        )
        expect(browser_key_route).to_contain(
            "browser_renderers.dispatch_key_with_shift(\n" +
            "                            semantic_event_id, focused"
        )
        expect(browser_key_route.contains("web_sessions.")).to_be(false)

        val registry = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_renderer_registry.spl"
            ) ?? ""
        )
        val registry_key_start = registry.find(
            "me dispatch_key_with_shift("
        )
        val registry_key_end = registry.find(
            "me dispatch_text(", registry_key_start
        )
        val registry_key = registry.slice(
            registry_key_start, registry_key_end
        )
        val registry_navigate = registry_key.find(
            "val result = entry.renderer.begin_navigate("
        )
        val registry_clear = registry_key.find(
            "entry.address_editing = false"
        )
        val registry_error = registry_key.find(
            "Err(reason):", registry_navigate
        )
        val registry_success = registry_key.find(
            "Ok(_):", registry_error
        )
        expect(registry_navigate).to_be_greater_than(-1)
        expect(registry_error).to_be_greater_than(registry_navigate)
        expect(registry_success).to_be_greater_than(registry_error)
        expect(registry_clear).to_be_greater_than(registry_success)

        val registry_pointer_start = registry.find(
            "me dispatch_chrome_pointer("
        )
        val registry_pointer_end = registry.find(
            "me dispatch_key_with_shift(", registry_pointer_start
        )
        val registry_pointer = registry.slice(
            registry_pointer_start, registry_pointer_end
        )
        val non_address = registry_pointer.find(
            "else:\n                entry.address_editing = false"
        )
        val saved = registry_pointer.find(
            "self.entries[index] = entry", non_address
        )
        expect(non_address).to_be_greater_than(-1)
        expect(saved).to_be_greater_than(non_address)

        val browser_text_start = text.find(
            "if comp.requires_external_web_frame(focused):"
        )
        val browser_text_end = text.find(
            "                        else:", browser_text_start
        )
        expect(browser_text_start).to_be_greater_than(-1)
        expect(browser_text_end).to_be_greater_than(browser_text_start)
        val browser_text_route = text.slice(
            browser_text_start, browser_text_end
        )
        expect(browser_text_route).to_contain(
            "browser_renderers.dispatch_text(\n" +
            "                                semantic_event_id, focused"
        )
        expect(browser_text_route.contains("web_sessions.")).to_be(false)

    it "fails closed and reaps hidden or destroyed browser renderers":
        step("Inspect renderer reap and fail-closed paths")
        val compositor = rt_file_read_text(
            "src/os/compositor/host_compositor_core.spl"
        ) ?? ""
        val registry = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_registry.spl"
        ) ?? ""
        expect(compositor).to_contain("elif win.app_id == \"browser\":")
        expect(compositor).to_contain(
            "content_frames.push(_host_empty_external_web_frame())"
        )
        expect(registry).to_contain("entry.renderer.poll()")
        val poll_pos = registry.find("entry.renderer.poll()")
        val hidden_pos = registry.find("if not visible:")
        expect(poll_pos).to_be_greater_than(-1)
        expect(hidden_pos).to_be_greater_than(poll_pos)
        expect(registry).to_contain("me reconcile(live_window_ids: [i64])")
        expect(registry).to_contain("entry.renderer.close()")
        expect(registry).to_contain("entry.raster.shutdown()")
        expect(registry).to_contain("close_retry_at_micros: i64")
        val advance_start = registry.find("me advance_window(")
        val advance_end = registry.find("me take_frame(", advance_start)
        expect(advance_start).to_be_greater_than(-1)
        expect(advance_end).to_be_greater_than(advance_start)
        val advance = registry.slice(advance_start, advance_end)
        expect(advance).to_contain("if entry.close_pending:")
        val retry_text = (
            "entry.close_retry_at_micros = now_micros + 1000000"
        )
        val first_retry = advance.find(retry_text)
        val retry_due = advance.find(
            "now_micros >= entry.close_retry_at_micros"
        )
        val failed_retry = advance.find(retry_text, first_retry + 1)
        expect(first_retry).to_be_greater_than(-1)
        expect(retry_due).to_be_greater_than(first_retry)
        expect(failed_retry).to_be_greater_than(retry_due)
        expect(advance).to_contain("if entry.renderer.close():")
        expect(advance).to_contain("entry.renderer_closed = true")
        expect(advance).to_contain("entry.close_pending = false")
        expect(advance).to_contain(
            "self.pointer_cancel_receipt_count + 1"
        )
        expect(registry).to_contain("pressed_window_id: i64")
        expect(registry).to_contain("pressed_event_id: i64")
        expect(registry).to_contain("pending_cancel_window_id: i64")
        expect(registry).to_contain(
            "pointer_cancel_receipt_count: i64"
        )
        val clear_start = registry.find("me _clear_pressed_controls(")
        val clear_end = registry.find("me dispatch_pointer(", clear_start)
        expect(clear_start).to_be_greater_than(-1)
        expect(clear_end).to_be_greater_than(clear_start)
        val clear = registry.slice(clear_start, clear_end)
        expect(clear).to_contain(
            "if self.pending_cancel_window_id > 0:\n" +
            "            return"
        )
        expect(clear).to_contain(
            "val armed_window_id = self.pressed_window_id"
        )
        expect(clear).to_contain(
            "val armed_event_id = self.pressed_event_id"
        )
        expect(clear).to_contain(
            "self.pending_cancel_window_id = armed_window_id"
        )
        expect(clear).to_contain(
            "self.pending_cancel_event_id = armed_event_id"
        )
        expect(clear).to_contain(
            "armed_event_id, -1, -1, false, 2000"
        )
        expect(clear).to_contain(
            "self.pointer_cancel_receipt_count + 1"
        )
        expect(clear.contains("while i < self.entries.len()")).to_be(false)
        val pointer_start = registry.find("me dispatch_pointer(")
        val pointer_end = registry.find(
            "me dispatch_scroll(", pointer_start
        )
        val pointer = registry.slice(pointer_start, pointer_end)
        expect(pointer).to_contain("self._clear_pressed_controls()")
        val chrome_start = registry.find("me dispatch_chrome_pointer(")
        val chrome_end = registry.find(
            "me dispatch_key_with_shift(", chrome_start
        )
        val chrome = registry.slice(chrome_start, chrome_end)
        expect(chrome).to_contain("self._clear_pressed_controls()")
        val cancel_start = registry.find("me cancel_pointer_state(")
        val cancel_end = registry.find("me remove_window(", cancel_start)
        expect(cancel_start).to_be_greater_than(-1)
        expect(cancel_end).to_be_greater_than(cancel_start)
        val cancel = registry.slice(cancel_start, cancel_end)
        expect(cancel).to_contain("self._clear_pressed_controls()")
        expect(registry).to_contain(
            "self.pending_cancel_window_id == window_id"
        )
        expect(registry).to_contain("\"pointer-cancel-pending\"")
        val swap_start = registry.find("me _begin_site_swap(")
        val swap_end = registry.find("me _store_frame(", swap_start)
        expect(swap_start).to_be_greater_than(-1)
        expect(swap_end).to_be_greater_than(swap_start)
        val swap = registry.slice(swap_start, swap_end)
        val clear_active = swap.find(
            "if self.pressed_window_id == entry.window_id:"
        )
        val clear_pending = swap.find(
            "if self.pending_cancel_window_id == entry.window_id:"
        )
        val close_old = swap.find("if not entry.renderer.close():")
        val replace_old = swap.find("entry.renderer = replacement")
        expect(clear_active).to_be_greater_than(-1)
        expect(clear_pending).to_be_greater_than(clear_active)
        expect(close_old).to_be_greater_than(clear_pending)
        expect(replace_old).to_be_greater_than(close_old)
        expect(swap.contains("begin_pointer(")).to_be(false)
        expect(registry.contains(
            "raster: Engine2dCompositorBackend?"
        )).to_be(false)

    it "keeps transient close failures recoverable":
        step("Check close retry clears only close-failed markers on success")
        val registry = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_registry.spl"
        ) ?? ""
        val drop_start = registry.find(
            "fn _drop_renderer_close_failure(reason: text) -> text:"
        )
        expect(drop_start).to_be_greater_than(-1)
        val drop_end = registry.find("fn _active_or_default_wm_theme_id()", drop_start)
        expect(drop_end).to_be_greater_than(drop_start)
        val drop_body = registry.slice(drop_start, drop_end)
        expect(drop_body).to_contain("renderer-close-failed")
        expect(drop_body).to_contain("reason.replace(\";\" + marker + \";\", \";\")")
        val teardown = registry.find("me _teardown(index: i32, reason: text) -> bool:")
        val begin_site_swap = registry.find("me _begin_site_swap(", teardown)
        expect(teardown).to_be_greater_than(-1)
        expect(begin_site_swap).to_be_greater_than(teardown)
        val teardown_body = registry.slice(teardown, begin_site_swap)
        val close_success = teardown_body.find("if entry.renderer.close():")
        val clear_close_failure = (
            teardown_body.find("_drop_renderer_close_failure", close_success)
        )
        expect(close_success).to_be_greater_than(-1)
        expect(clear_close_failure).to_be_greater_than(close_success)
        val advance_start = registry.find("me advance_window(")
        val advance_end = registry.find("me take_frame(", advance_start)
        val advance = registry.slice(advance_start, advance_end)
        val advance_success = advance.find(
            "if entry.renderer.close():", advance.find("if entry.close_pending:")
        )
        val advance_clear = advance.find(
            "_drop_renderer_close_failure(", advance_success
        )
        expect(advance_success).to_be_greater_than(-1)
        expect(advance_clear).to_be_greater_than(advance_success)

    # @req REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-017
    it "persists learned HSTS before processing the completed frame":
        step("Inspect HSTS persistence ordering")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val poll_pos = entry.find(
            "val browser_poll = browser_renderer.poll()"
        )
        val result_pos = entry.find(
            "if val Some(browser_result) = browser_poll:"
        )
        expect(poll_pos).to_be_greater_than(-1)
        expect(result_pos).to_be_greater_than(poll_pos)
        val poll_body = entry.slice(poll_pos, result_pos)
        val dirty_pos = poll_body.find(
            "browser_renderer.hsts_dirty and browser_profile != nil"
        )
        val gate_pos = poll_body.find(
            "now_micros >= browser_hsts_save_retry_at_micros"
        )
        val save_pos = poll_body.find("_save_hosted_browser_hsts(")
        val restore_pos = poll_body.find(
            "browser_renderer = saved_renderer.unwrap()"
        )
        val retry_pos = poll_body.find(
            "browser_hsts_save_retry_at_micros = ("
        )
        val retry_delay = poll_body.find("now_micros + 1000000")
        expect(dirty_pos).to_be_greater_than(-1)
        expect(gate_pos).to_be_greater_than(dirty_pos)
        expect(save_pos).to_be_greater_than(gate_pos)
        expect(restore_pos).to_be_greater_than(save_pos)
        expect(retry_pos).to_be_greater_than(restore_pos)
        expect(retry_delay).to_be_greater_than(retry_pos)

        val helper_start = entry.find("fn _save_hosted_browser_hsts(")
        val helper_end = entry.find("fn _close_hosted_browser_resources(")
        expect(helper_start).to_be_greater_than(-1)
        expect(helper_end).to_be_greater_than(helper_start)
        val helper = entry.slice(helper_start, helper_end)
        val profile_save = helper.find("profile.save_hsts(")
        val ok_pos = helper.find("Ok(_):")
        val clear_dirty = helper.find("renderer.hsts_dirty = false")
        val updated_renderer = helper.find("Some(renderer)")
        val error_pos = helper.find("Err(error):")
        expect(profile_save).to_be_greater_than(-1)
        expect(ok_pos).to_be_greater_than(profile_save)
        expect(clear_dirty).to_be_greater_than(ok_pos)
        expect(updated_renderer).to_be_greater_than(clear_dirty)
        expect(error_pos).to_be_greater_than(updated_renderer)

        val close_body = entry.slice(helper_end, entry.find(
            "fn _run_hosted_wm("
        ))
        val close_save = close_body.find("_save_hosted_browser_hsts(")
        val profile_guard = close_body.find("if profile_in != nil:")
        val close_profile = close_body.find("profile.close()")
        expect(close_save).to_be_greater_than(-1)
        expect(profile_guard).to_be_greater_than(close_save)
        expect(close_profile).to_be_greater_than(profile_guard)
        expect(close_body).to_contain("renderer: renderer_close.renderer")
        expect(close_body).to_contain("raster: renderer_close.raster")

    # @req REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018
    it "reconciles titlebar keyboard and evidence browser closes":
        step("Inspect browser close reconciliation")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val mouse = entry.slice(
            entry.find("elif kind == EVT_MOUSE_BUTTON:"),
            entry.find("elif kind == EVT_MOUSE_WHEEL:")
        )
        expect(mouse).to_contain(
            "host_compositor_close_release_target("
        )
        val mouse_save = mouse.find("_save_hosted_browser_hsts(")
        val mouse_registry_save = mouse.find(
            "web_sessions.close_window("
        )
        val mouse_dispatch = mouse.find(
            "comp.handle_mouse_button(button, pressed)"
        )
        val mouse_cleanup = mouse.find(
            "_close_hosted_browser_renderer_resources("
        )
        expect(mouse_save).to_be_greater_than(-1)
        expect(mouse_registry_save).to_be_greater_than(mouse_save)
        expect(mouse_dispatch).to_be_greater_than(mouse_registry_save)
        expect(mouse_cleanup).to_be_greater_than(mouse_dispatch)
        expect(mouse).to_contain("if not allow_wm_close:")
        expect(mouse).to_contain("comp.armed_chrome_target = \"\"")
        expect(mouse).to_contain(
            "browser_renderer = saved_renderer.unwrap()"
        )
        expect(mouse).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(mouse).to_contain(
            "browser_raster = browser_closed.raster"
        )
        expect(mouse.contains("browser_profile = nil")).to_be(false)
        expect(mouse).to_contain(
            "comp.release_external_web_frame("
        )

        val keyboard = entry.slice(
            entry.find("elif kind == EVT_KEY:"),
            entry.find("elif kind == EVT_TEXT:")
        )
        expect(keyboard).to_contain("elif keycode == KEY_W:")
        val keyboard_save = keyboard.find(
            "_save_hosted_browser_hsts("
        )
        val keyboard_cleanup = keyboard.find(
            "_close_hosted_browser_renderer_resources("
        )
        val keyboard_destroy = keyboard.find(
            "comp.destroy_window(focused)"
        )
        expect(keyboard_save).to_be_greater_than(-1)
        expect(keyboard_cleanup).to_be_greater_than(keyboard_save)
        expect(keyboard_destroy).to_be_greater_than(keyboard_cleanup)
        expect(keyboard.contains("browser_profile = nil")).to_be(false)
        expect(keyboard).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(keyboard).to_contain(
            "comp.release_external_web_frame(focused)"
        )

        val evidence = entry.slice(
            entry.find("elif command.action == \"close\":"),
            entry.find("elif command.action == \"pointer\":")
        )
        expect(evidence).to_contain(
            "if focused == browser_profile_window_id:"
        )
        val evidence_save = evidence.find(
            "_save_hosted_browser_hsts("
        )
        val evidence_cleanup = evidence.find(
            "_close_hosted_browser_renderer_resources("
        )
        val evidence_destroy = evidence.find(
            "comp.destroy_window(focused)"
        )
        expect(evidence_save).to_be_greater_than(-1)
        expect(evidence_cleanup).to_be_greater_than(evidence_save)
        expect(evidence_destroy).to_be_greater_than(evidence_cleanup)
        expect(evidence).to_contain("\"rejected\"")
        expect(evidence.contains("browser_profile = nil")).to_be(false)
        expect(evidence).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(evidence).to_contain(
            "comp.release_external_web_frame(focused)"
        )
        expect(evidence).to_contain("web_sessions.close_window(")

        val evidence_left = entry.slice(
            entry.find("elif command.action == \"left\":"),
            entry.find("elif command.action == \"snapshot\":")
        )
        val left_save = evidence_left.find(
            "_save_hosted_browser_hsts("
        )
        val left_dispatch = evidence_left.find(
            "comp.handle_mouse_button(0, command.down)"
        )
        val left_cleanup = evidence_left.find(
            "_close_hosted_browser_renderer_resources("
        )
        expect(left_save).to_be_greater_than(-1)
        expect(left_dispatch).to_be_greater_than(left_save)
        expect(left_cleanup).to_be_greater_than(left_dispatch)
        expect(evidence_left).to_contain(
            "host_compositor_close_release_target("
        )
        expect(evidence_left).to_contain(
            "if not allow_evidence_close:"
        )
        expect(evidence_left).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(evidence_left).to_contain(
            "comp.release_external_web_frame("
        )
        expect(evidence_left).to_contain("\"rejected\"")
        expect(entry.contains("browser_profile = nil")).to_be(false)
        expect(entry).to_contain(
            "var browser_renderer_close_pending = false"
        )
        val retry_gate = entry.find(
            "if (browser_renderer_close_pending and"
        )
        val retry_due = entry.find(
            "now_micros >= browser_renderer_close_retry_at_micros",
            retry_gate
        )
        val retry_close = entry.find(
            "if browser_renderer.close():", retry_due
        )
        val retry_clear = entry.find(
            "browser_renderer_close_pending = false", retry_close
        )
        val retry_delay = entry.find(
            "now_micros + 1000000", retry_clear
        )
        expect(retry_gate).to_be_greater_than(-1)
        expect(retry_due).to_be_greater_than(retry_gate)
        expect(retry_close).to_be_greater_than(retry_due)
        expect(retry_clear).to_be_greater_than(retry_close)
        expect(retry_delay).to_be_greater_than(retry_clear)
        val shutdown = entry.slice(
            entry.find("val profile_closed = web_sessions.close("),
            entry.find(
                "    print \"SimpleOS shared hosted WM closed\""
            )
        )
        expect(shutdown).to_contain(
            "browser_resource_close_failed"
        )
        expect(shutdown).to_contain(
            "browser_close.ok"
        )
