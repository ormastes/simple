        val text_start = run_body.find("elif kind == EVT_TEXT:")
        val text_end = run_body.find("            rt_winit_event_free(ev)")
        expect(text_start).to_be_greater_than(-1)
        expect(text_start).to_be_greater_than(renderer_owner)
        expect(text_end).to_be_greater_than(text_start)
        val text_body = run_body.slice(text_start, text_end)
        val browser_text_start = text_body.find(
            "if focused == browser_profile_window_id:"
        )
        val browser_text_end = text_body.find("                    elif focused > 0:")
        expect(browser_text_start).to_be_greater_than(-1)
        expect(browser_text_end).to_be_greater_than(browser_text_start)
        val browser_text = text_body.slice(
            browser_text_start, browser_text_end
        )
        val address_text_start = browser_text.find(
            "if browser_address_editing:"
        )
        val non_address_text_start = browser_text.find(
            "                        else:\n" +
            "                            match browser_renderer.begin_text_input("
        )
        val text_targets_start = browser_text.find(
            "input_receipt = host_wm_input_record_semantic("
        )
        expect(address_text_start).to_be_greater_than(-1)
        expect(non_address_text_start).to_be_greater_than(address_text_start)
        expect(text_targets_start).to_be_greater_than(non_address_text_start)
        val address_text = browser_text.slice(
