use std.spec.*

extern fn rt_file_read_text(path: text) -> text

describe "hosted browser renderer entry isolation":
    it "dispatches the hidden worker before host UI initialization":
        val entry = rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        val main_start = entry.find("fn main() -> i64:")
        val args_pos = entry.find("val args = sys_get_args() ?? []")
        val worker_pos = entry.find("return hosted_browser_renderer_worker_main(args)")
        val print_pos = entry.find("print \"SimpleOS shared hosted WM")
        val theme_pos = entry.find("install_default_host_wm_theme()")
        val winit_pos = entry.find("rt_winit_event_loop_new()")
        expect(main_start).to_be_greater_than(-1)
        expect(args_pos).to_be_greater_than(main_start)
        expect(worker_pos).to_be_greater_than(args_pos)
        expect(print_pos).to_be_greater_than(worker_pos)
        expect(theme_pos).to_be_greater_than(worker_pos)
        expect(winit_pos).to_be_greater_than(worker_pos)

    it "keeps one ready-gated renderer with bounded writes and validated frames":
        val broker = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_process.spl"
        ) ?? ""
        val policy = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_policy.spl"
        ) ?? ""
        expect(broker).to_contain("browser_renderer_spawn_sandboxed")
        expect(broker).to_contain("decoded.message.kind != \"ready\"")
        expect(broker).to_contain("process_write_stdin_some")
        expect(broker).to_contain("browser_renderer_frame_decode")
        expect(broker).to_contain("\"sandbox-unavailable\"")
        expect(broker).to_contain("pub class HostedBrowserRendererProcess")
        expect(broker).to_contain("next_request_id: 2")
        expect(broker).to_contain("browser_renderer_fetch_request_decode")
        expect(broker).to_contain(
            "rt_browser_http_job_start_public_limited"
        )
        expect(broker).to_contain(
            "self.next_request_id = self.next_request_id + 1"
        )
        expect(broker).to_contain(
            "hosted_browser_renderer_request_policy"
        )
        expect(broker).to_contain(
            "navigation_permit: HostedBrowserNavigationPermit"
        )
        expect(broker).to_contain("browser_renderer_navigation_encode")
        expect(broker).to_contain("expected_reply_to_request_id")
        expect(broker).to_contain("\"stale-renderer-frame\"")
        expect(broker).to_contain("pending_document_commit_url")
        expect(broker).to_contain("provisional_document_origin")
        expect(broker).to_contain("me begin_navigate(")
        expect(broker).to_contain("me begin_stop(")
        expect(broker).to_contain("me poll()")
        expect(broker).to_contain("rt_browser_http_job_cancel(handle)")
        expect(broker).to_contain("rt_time_now_monotonic_ms()")
        expect(broker.contains("rt_time_now_unix_micros")).to_be(false)
        val poll_start = broker.find("me poll()")
        val flush_start = broker.find("me _flush_pending_wire_once()")
        val wait_start = broker.find("me _await_frame(")
        val poll_body = broker.slice(poll_start, wait_start)
        val pump_body = broker.slice(flush_start, wait_start)
        expect(poll_body.contains("rt_sleep_ms")).to_be(false)
        expect(poll_body.contains("_write_before")).to_be(false)
        expect(pump_body).to_contain("process_write_stdin_some")
        val cancel_start = broker.find("me _cancel_network_job()")
        val replace_start = broker.find("me _replace_pending_navigation()")
        val cancel_body = broker.slice(cancel_start, replace_start)
        val clear_pos = cancel_body.find("self.network_job_handle = 0")
        val cancel_pos = cancel_body.find(
            "rt_browser_http_job_cancel(handle)"
        )
        val free_pos = cancel_body.find("rt_browser_http_job_free(handle)")
        expect(clear_pos).to_be_greater_than(-1)
        expect(cancel_pos).to_be_greater_than(clear_pos)
        expect(free_pos).to_be_greater_than(cancel_pos)
        expect(policy).to_contain(
            "\"unauthorized-document-request\""
        )
        expect(broker.contains("fn _renderer_fetch_mode")).to_be(false)

    it "routes the production browser through the external worker frame gate":
        val entry = rt_file_read_text(
            "src/os/hosted/hosted_entry.spl"
        ) ?? ""
        expect(entry).to_contain(
            "comp.require_external_web_frame(browser_profile_window_id)"
        )
        expect(entry).to_contain(
            "browser_renderer.start(executable, 2000)"
        )
        expect(entry).to_contain(
            "browser_renderer.render("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_advance("
        )
        expect(entry).to_contain(
            "browser_renderer.next_animation_ms >= 0"
        )
        expect(entry).to_contain(
            "simple_web_external_content_frame("
        )
        expect(entry).to_contain(
            "comp.set_external_web_frame("
        )
        expect(entry).to_contain(
            "web_window.id != browser_profile_window_id"
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_back("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_forward("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_stop("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_home("
        )
        expect(entry).to_contain(
            "val now_micros = rt_time_now_micros()"
        )
        expect(entry).to_contain(
            "val wall_clock_ms = rt_time_now_unix_micros() / 1000"
        )
        expect(entry).to_contain(
            "normalize_network_navigation_url("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_pointer("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_key("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_text_input("
        )
        expect(entry).to_contain(
            "profile.save_bookmarks("
        )
