use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn executable_source_lines(source: text) -> text:
    var out = ""
    for line in source.split("\n"):
        if not line.trim().starts_with("#"):
            out = out + line + "\n"
    out

describe "hosted browser renderer entry isolation":
    it "gates the production registry on exact theme readiness":
        # @req: REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-009 REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018
        step("Inspect the hosted theme-before-init production route")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val registry = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_renderer_registry.spl"
            ) ?? ""
        )
        val process = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_renderer_process.spl"
            ) ?? ""
        )
        val create_pos = entry.find(
            "HostedBrowserRendererRegistry.create_with_theme("
        )
        val accept_start = registry.find("me _accept_polled_result(")
        val accept_end = registry.find(
            "me advance_window(", accept_start
        )
        val accept = registry.slice(accept_start, accept_end)
        val theme_pos = accept.find(
            "entry.renderer.begin_theme_init(2000)"
        )
        val init_pos = accept.find(
            "entry.renderer.begin_init("
        )
        val resume_pos = accept.find(
            "if entry.renderer.site_swap_pending:", init_pos
        )
        val frame_pos = accept.find(
            "self._store_frame(", resume_pos
        )
        expect(create_pos).to_be_greater_than(-1)
        expect(registry).to_contain(
            "simple_web_content_full_html_with_install_wire("
        )
        expect(registry).to_contain(
            "HostedBrowserRendererProcess.create_with_theme("
        )
        expect(theme_pos).to_be_greater_than(-1)
        expect(init_pos).to_be_greater_than(theme_pos)
        expect(resume_pos).to_be_greater_than(init_pos)
        expect(frame_pos).to_be_greater_than(resume_pos)
        expect(process).to_contain("\"await-theme-ready\"")
        expect(process).to_contain("\"theme-ready-mismatch\"")
        expect(registry).to_contain(
            "\"theme-parent-projection-mismatch\""
        )
        val swap_start = registry.find("me _begin_site_swap(")
        val swap_end = registry.find("me _store_frame(", swap_start)
        val swap = registry.slice(swap_start, swap_end)
        expect(swap).to_contain(
            "HostedBrowserRendererProcess.create_with_theme("
        )
        expect(swap).to_contain(
            "simple_web_content_full_html_with_install_wire("
        )
        expect(swap).to_contain(
            "entry.startup_html = restart_html"
        )

    it "keeps secondary hosted navigation public and response-bounded":
        step("Inspect the secondary navigation source limits")
        val source = rt_file_read_text(
            "src/os/hosted/hosted_web_content_session.spl"
        ) ?? ""
        expect(source).to_contain(
            "rt_browser_http_job_start_public_limited"
        )
        expect(source).to_contain("5000, 589824")
        expect(source.contains("rt_browser_http_job_start(")).to_be(false)

    it "dispatches the hidden worker before host UI initialization":
        step("Inspect the worker startup ordering")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val main_start = entry.find("fn main() -> i64:")
        val args_pos = entry.find("val args = sys_get_args() ?? []")
        val worker_pos = entry.find("return hosted_browser_renderer_worker_main(args)")
        val print_pos = entry.find("print \"SimpleOS shared hosted WM")
        val theme_pos = entry.find("install_default_host_wm_theme()")
        val winit_pos = entry.find("rt_winit_event_loop_new()")
        expect(main_start).to_be_greater_than(-1)
        expect(args_pos).to_be_greater_than(main_start)
        expect(worker_pos).to_be_greater_than(args_pos)
        expect(entry).to_contain(
            "(args.len() == 5 or args.len() == 6)"
        )
        expect(entry).to_contain(
            "args[1] == BROWSER_RENDERER_WORKER_ARG"
        )
        expect(entry.contains(
            "args.contains(BROWSER_RENDERER_WORKER_ARG)"
        )).to_be(false)
        expect(print_pos).to_be_greater_than(worker_pos)
        expect(theme_pos).to_be_greater_than(worker_pos)
        expect(winit_pos).to_be_greater_than(worker_pos)

    it "keeps one ready-gated renderer with bounded writes and validated frames":
        step("Inspect renderer readiness and frame bounds")
        val broker = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_process.spl"
        ) ?? ""
        val policy = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_policy.spl"
        ) ?? ""
        expect(broker).to_contain("browser_renderer_spawn_sandboxed")
        expect(broker).to_contain("decoded.message.kind != \"ready\"")
        expect(broker).to_contain("process_write_stdin_some")
        expect(broker).to_contain("browser_renderer_frame_decode")
        expect(broker).to_contain("\"sandbox-unavailable\"")
        expect(broker).to_contain("pub class HostedBrowserRendererProcess")
        expect(broker).to_contain("next_request_id: 2")
        expect(broker).to_contain("browser_renderer_fetch_request_decode")
        expect(broker).to_contain(
            "rt_browser_http_job_start_public_limited"
        )
        expect(broker).to_contain(
            "self.next_request_id = self.next_request_id + 1"
        )
        expect(broker).to_contain(
            "hosted_browser_renderer_request_policy"
        )
        expect(broker).to_contain(
            "navigation_permit: HostedBrowserNavigationPermit"
        )
        expect(broker).to_contain("browser_renderer_navigation_encode")
        expect(broker).to_contain("expected_reply_to_request_id")
        expect(broker).to_contain("\"stale-renderer-frame\"")
        expect(broker).to_contain("pending_document_commit_url")
        expect(broker).to_contain("provisional_document_origin")
        expect(broker).to_contain("me begin_navigate(")
        expect(broker).to_contain("me begin_stop(")
        expect(broker).to_contain("me poll()")
        expect(broker).to_contain("rt_browser_http_job_cancel(handle)")
        expect(broker).to_contain("rt_time_now_monotonic_ms()")
        expect(broker.contains("rt_time_now_unix_micros")).to_be(false)
        val poll_start = broker.find("me poll()")
        val flush_start = broker.find("me _flush_pending_wire_once()")
        val flush_end = broker.find("me _poll_network_job()", flush_start)
        val wait_start = broker.find("me _await_frame(")
        expect(flush_start).to_be_greater_than(-1)
        expect(flush_end).to_be_greater_than(flush_start)
        val poll_body = broker.slice(poll_start, wait_start)
        val pump_body = broker.slice(flush_start, flush_end)
        expect(poll_body.contains("rt_sleep_ms")).to_be(false)
        expect(poll_body.contains("_write_before")).to_be(false)
        expect(pump_body).to_contain("process_write_stdin_some")
        val begin_start_body = broker.slice(
            broker.find("me begin_start("),
            broker.find("me start(")
        )
        expect(begin_start_body).to_contain(
            "browser_renderer_spawn_sandboxed"
        )
        expect(begin_start_body).to_contain(
            "self.pending_operation = \"start\""
        )
        expect(begin_start_body.contains("rt_sleep_ms")).to_be(false)
        expect(poll_body).to_contain("self.state == \"starting\"")
        expect(poll_body).to_contain("decoded.message.kind != \"ready\"")
        expect(poll_body).to_contain("self.fail(\"renderer-crashed\")")
        expect(broker).to_contain("me begin_init(")
        val write_failed = pump_body.find("if written < 0:")
        val write_empty = pump_body.find("if written == 0:")
        val pipe_dead = pump_body.find(
            "if not process_is_piped_alive(self.pid):", write_empty
        )
        val pipe_dead_return = pump_body.find(
            "return \"renderer-crashed\"", pipe_dead
        )
        expect(write_failed).to_be_greater_than(-1)
        expect(write_empty).to_be_greater_than(write_failed)
        expect(pump_body.slice(write_failed, write_empty).contains(
            "self.pid = 0"
        )).to_be(false)
        expect(pipe_dead).to_be_greater_than(write_empty)
        expect(pipe_dead_return).to_be_greater_than(pipe_dead)
        expect(pump_body.slice(pipe_dead, pipe_dead_return)).to_contain(
            "self.pid = 0"
        )
        val dead_start = poll_body.find(
            "if chunk == \"\" and not process_is_piped_alive(self.pid):"
        )
        val dead_end = poll_body.find(
            "return Some(self.fail(\"renderer-crashed\"))", dead_start
        )
        expect(dead_start).to_be_greater_than(-1)
        expect(dead_end).to_be_greater_than(dead_start)
        expect(poll_body.slice(dead_start, dead_end)).to_contain(
            "self.pid = 0"
        )
        val cancel_start = broker.find("me _cancel_network_job()")
        val replace_start = broker.find("me _replace_pending_navigation()")
        val cancel_body = broker.slice(cancel_start, replace_start)
        val clear_pos = cancel_body.find("self.network_job_handle = 0")
        val cancel_pos = cancel_body.find(
            "rt_browser_http_job_cancel(handle)"
        )
        val free_pos = cancel_body.find("rt_browser_http_job_free(handle)")
        expect(clear_pos).to_be_greater_than(-1)
        expect(cancel_pos).to_be_greater_than(clear_pos)
        expect(free_pos).to_be_greater_than(cancel_pos)
        val close_start = broker.find("me close() -> bool:")
        val close_end = broker.find(
            "me fail(reason: text)"
        )
        expect(close_start).to_be_greater_than(-1)
        expect(close_end).to_be_greater_than(close_start)
        val close_body = broker.slice(close_start, close_end)
        val native_close = close_body.find(
            "process_close_piped(self.pid)"
        )
        val failed_close = close_body.find("return false")
        val clear_pid = close_body.find("self.pid = 0")
        expect(native_close).to_be_greater_than(-1)
        expect(failed_close).to_be_greater_than(native_close)
        expect(clear_pid).to_be_greater_than(failed_close)
        expect(broker).to_contain(
            "\"renderer-close-failed\""
        )
        expect(close_body).to_contain(
            "self.decoder = browser_renderer_decoder_new(self.generation)"
        )
        expect(close_body).to_contain("self.history_urls = []")
        expect(close_body.contains("self.hsts =")).to_be(false)
        expect(close_body.contains("self.hsts_dirty =")).to_be(false)
        expect(broker.contains(
            "hosted_browser_renderer_render_once"
        )).to_be(false)
        expect(policy).to_contain(
            "\"unauthorized-document-request\""
        )
        expect(broker.contains("fn _renderer_fetch_mode")).to_be(false)

    it "builds bounded diagnostics without joining retained warnings":
        step("Inspect bounded renderer diagnostics")
        val worker = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_worker.spl"
        ) ?? ""
        val start = worker.find("fn _worker_diagnostics(")
        val finish = worker.find("fn _worker_frame(")
        expect(start).to_be_greater_than(-1)
        expect(finish).to_be_greater_than(start)
        val body = worker.slice(start, finish)
        expect(body.contains("session.warnings.join")).to_be(false)
        expect(body.contains("diagnostics = diagnostics +")).to_be(false)
        expect(body).to_contain("StringBuilder.new()")
        expect(body).to_contain("for warning in session.warnings:")
        expect(body).to_contain("BROWSER_RENDERER_MAX_DIAGNOSTIC_BYTES")
        expect(body).to_contain("warning.slice(0, remaining)")

    it "routes the production browser through the external worker frame gate":
        step("Inspect external worker frame routing")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        expect(entry).to_contain(
            "comp.require_external_web_frame("
        )
        expect(entry).to_contain("browser_frame_registered")
        expect(entry).to_contain(
            "browser_renderer.start(executable, 2000)"
        )
        expect(entry).to_contain(
            "browser_renderer.render("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_advance("
        )
        expect(entry).to_contain(
            "browser_renderer.next_animation_ms >= 0"
        )
        expect(entry).to_contain(
            "simple_web_external_content_frame("
        )
        expect(entry).to_contain(
            "comp.set_external_web_frame("
        )
        expect(entry).to_contain(
            "web_window.id != browser_profile_window_id"
        )
        expect(entry).to_contain(
            "var web_sessions = HostedWebContentRegistry.create()"
        )
        expect(entry.contains(
            "HostedWebContentRegistry.create_with_default_bookmark_store()"
        )).to_be(false)
        expect(entry).to_contain(
            "web_window.app_id == \"browser\""
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_back("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_forward("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_stop("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_home("
        )
        expect(entry).to_contain(
            "val now_micros = rt_time_now_micros()"
        )
        expect(entry).to_contain(
            "val wall_clock_ms = rt_time_now_unix_micros() / 1000"
        )
        expect(entry).to_contain(
            "if browser_profile_window_id <= 0 or not browser_renderer_ready:"
        )
        expect(entry).to_contain("var browser_raster_active = true")
        expect(entry).to_contain("browser_raster_active = false")
        expect(entry).to_contain(
            "fn _close_hosted_browser_resources("
        )
        expect(entry).to_contain(
            "val browser_close = _close_hosted_browser_resources("
        )
        expect(entry).to_contain(
            "normalize_network_navigation_url("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_pointer("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_key_with_shift("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_text_input("
        )
        expect(entry).to_contain(
            "profile.toggle_bookmark("
        )
        expect(entry).to_contain("profile.load_bookmarks()")
        expect(entry).to_contain(
            "browser_renderer.begin_bookmark_snapshot("
        )
        val favorite_pos = entry.find(
            "elif target.control == \"favorite\":"
        )
        val busy_gate_pos = entry.find(
            "browser_renderer.command_deadline_ms > 0 or",
            favorite_pos
        )
        val toggle_pos = entry.find(
            "profile.toggle_bookmark(", favorite_pos
        )
        expect(busy_gate_pos).to_be_greater_than(favorite_pos)
        expect(toggle_pos).to_be_greater_than(busy_gate_pos)
        expect(entry.contains(
            "fn _browser_bookmark_snapshot_set("
        )).to_be(false)
        expect(entry.contains(
            "fn _add_browser_bookmark("
        )).to_be(false)

    it "converges parent-owned bookmarks across idle and busy renderers":
        step("Inspect bookmark convergence across renderer states")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val registry = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_renderer_registry.spl"
            ) ?? ""
        )
        expect(entry).to_contain(
            "var browser_bookmark_revision: i64 = 0"
        )
        expect(entry).to_contain(
            "browser_bookmark_applied_revision <"
        )
        expect(entry).to_contain(
            "browser_renderer.network_job_handle <= 0"
        )
        expect(entry.split(
            "browser_renderers.set_bookmark_snapshot("
        ).len()).to_equal(4)
        expect(registry).to_contain(
            "bookmark_snapshot: BrowserBookmarkSnapshot"
        )
        expect(registry).to_contain("bookmark_revision: i64")
        expect(registry).to_contain(
            "me set_bookmark_snapshot(snapshot: BrowserBookmarkSnapshot):"
        )
        val pending = registry.find(
            "entry.bookmark_revision < self.bookmark_revision"
        )
        val begin = registry.find(
            "entry.renderer.begin_bookmark_snapshot(", pending
        )
        val applied = registry.find(
            "entry.bookmark_revision = self.bookmark_revision", begin
        )
        val hidden = registry.find("if not visible:", applied)
        expect(pending).to_be_greater_than(-1)
        expect(begin).to_be_greater_than(pending)
        expect(applied).to_be_greater_than(begin)
        expect(hidden).to_be_greater_than(applied)

    it "keeps startup HTML out of the address draft and Escape fallback":
        step("Inspect startup address draft and Escape behavior")
        val registry = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_renderer_registry.spl"
            ) ?? ""
        )
        expect(registry).to_contain(
            "address_draft: \"about:blank\""
        )
        expect(registry).to_contain(
            "entry.address_draft = if entry.renderer.document_url != \"\":"
        )
        expect(registry).to_contain(
            "else:\n                    \"about:blank\""
        )
        val committed = registry.find(
            "if not entry.address_editing and entry.renderer.document_url != \"\":"
        )
        val release = registry.find(
            "entry.startup_html = \"\"", committed
        )
        val init = registry.find("entry.renderer.begin_init(")
        val init_payload = registry.find(
            "entry.startup_html, 2000", init
        )
        expect(committed).to_be_greater_than(-1)
        expect(release).to_be_greater_than(committed)
        expect(init).to_be_greater_than(release)
        expect(init_payload).to_be_greater_than(init)

    it "keeps primary startup HTML as payload but exposes about blank":
        step("Inspect primary startup payload and public address")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val run_start = entry.find("fn _run_hosted_wm(")
        val draft = entry.find(
            "var browser_address_draft = \"about:blank\"", run_start
        )
        val init = entry.find(
            "\"init\", browser_initial_html, 2000", draft
        )
        val escape = entry.find(
            "elif pressed_key and keycode == KEY_ESCAPE:", init
        )
        val fallback = entry.find(
            "else:\n                                \"about:blank\"", escape
        )
        expect(run_start).to_be_greater_than(-1)
        expect(draft).to_be_greater_than(run_start)
        expect(init).to_be_greater_than(draft)
        expect(escape).to_be_greater_than(init)
        expect(fallback).to_be_greater_than(escape)

    it "keeps title commands and page input on their production owner routes":
        step("Inspect title and page-input owner routing")
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val run_start = entry.find("fn _run_hosted_wm(")
        val run_end = entry.find(
            "    print \"SimpleOS shared hosted WM closed\""
        )
        expect(run_start).to_be_greater_than(-1)
        expect(run_end).to_be_greater_than(run_start)
        val run_body = entry.slice(run_start, run_end)
        val renderer_owner = run_body.find(
            "var browser_renderer = HostedBrowserRendererProcess.create("
        )
        expect(renderer_owner).to_be_greater_than(-1)

        val poll_start = run_body.find(
            "if val Some(browser_result) = browser_renderer.poll():"
        )
        val poll_end = run_body.find("        var web_window_index = 0")
        expect(poll_start).to_be_greater_than(-1)
        expect(poll_start).to_be_greater_than(renderer_owner)
        expect(poll_end).to_be_greater_than(poll_start)
        val poll_body = run_body.slice(poll_start, poll_end)
        val poll_frame = poll_body.find("comp.set_external_web_frame(")
        val poll_title = poll_body.find(
            "host_compositor_update_window_title("
        )
        val poll_cancel = poll_body.find(
            "browser_renderer.flush_pointer_cancel("
        )
        expect(poll_frame).to_be_greater_than(-1)
        expect(poll_title).to_be_greater_than(poll_frame)
        expect(poll_cancel).to_be_greater_than(poll_title)

        val pointer_start = run_body.find("elif kind == EVT_MOUSE_BUTTON:")
        val pointer_end = run_body.find("elif kind == EVT_MOUSE_WHEEL:")
        expect(pointer_start).to_be_greater_than(-1)
        expect(pointer_start).to_be_greater_than(renderer_owner)
        expect(pointer_end).to_be_greater_than(pointer_start)
        val pointer_body = run_body.slice(pointer_start, pointer_end)
        val primary_cancel = pointer_body.find(
            "browser_renderer.cancel_pointer("
        )
        val primary_arm = pointer_body.find(
            "browser_pressed_control = target.control", primary_cancel
        )
        expect(primary_cancel).to_be_greater_than(-1)
        expect(primary_arm).to_be_greater_than(primary_cancel)
        val page_pointer_start = pointer_body.find(
            "if target.window_id == browser_profile_window_id:"
        )
        val page_pointer_end = pointer_body.find(
            "                    else:\n" +
            "                        if comp.requires_external_web_frame(target.window_id):"
        )
        expect(page_pointer_start).to_be_greater_than(-1)
        expect(page_pointer_end).to_be_greater_than(page_pointer_start)
        val page_pointer = pointer_body.slice(
            page_pointer_start, page_pointer_end
        )
        val pointer_call = page_pointer.find(
            "browser_renderer.begin_pointer("
        )
        val pointer_target = page_pointer.find("\"browser:page\"")
        expect(pointer_call).to_be_greater_than(-1)
        expect(pointer_target).to_be_greater_than(pointer_call)
        expect(page_pointer.contains(
            "web_sessions.dispatch_pointer("
        )).to_be(false)
        expect(page_pointer.contains(
            "host_compositor_update_window_content("
        )).to_be(false)

        val key_start = run_body.find("elif kind == EVT_KEY:")
        val key_end = run_body.find("elif kind == EVT_TEXT:")
        expect(key_start).to_be_greater_than(-1)
        expect(key_start).to_be_greater_than(renderer_owner)
        expect(key_end).to_be_greater_than(key_start)
        val key_body = run_body.slice(key_start, key_end)
        val browser_key_start = key_body.find(
            "if focused == browser_profile_window_id:"
        )
        val browser_key_end = key_body.find("                elif focused > 0:")
        expect(browser_key_start).to_be_greater_than(-1)
        expect(browser_key_end).to_be_greater_than(browser_key_start)
        val browser_key = key_body.slice(browser_key_start, browser_key_end)
        val semantic_target_start = browser_key.find(
            "val semantic_target_id = if browser_address_editing:"
        )
        val address_key_start = browser_key.find(
            "                    if browser_address_editing:",
            semantic_target_start + 1
        )
        val non_address_key_start = browser_key.find(
            "elif keycode != KEY_ESCAPE:"
        )
        val key_targets_start = browser_key.find(
            "input_receipt = host_wm_input_record_semantic("
        )
        expect(semantic_target_start).to_be_greater_than(-1)
