use std.spec.*

extern fn rt_file_read_text(path: text) -> text

fn executable_source_lines(source: text) -> text:
    var out = ""
    for line in source.split("\n"):
        if not line.trim().starts_with("#"):
            out = out + line + "\n"
    out

describe "hosted browser renderer entry isolation":
    it "keeps secondary hosted navigation public and response-bounded":
        val source = rt_file_read_text(
            "src/os/hosted/hosted_web_content_session.spl"
        ) ?? ""
        expect(source).to_contain(
            "rt_browser_http_job_start_public_limited"
        )
        expect(source).to_contain("5000, 589824")
        expect(source.contains("rt_browser_http_job_start(")).to_be(false)

    it "dispatches the hidden worker before host UI initialization":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val main_start = entry.find("fn main() -> i64:")
        val args_pos = entry.find("val args = sys_get_args() ?? []")
        val worker_pos = entry.find("return hosted_browser_renderer_worker_main(args)")
        val print_pos = entry.find("print \"SimpleOS shared hosted WM")
        val theme_pos = entry.find("install_default_host_wm_theme()")
        val winit_pos = entry.find("rt_winit_event_loop_new()")
        expect(main_start).to_be_greater_than(-1)
        expect(args_pos).to_be_greater_than(main_start)
        expect(worker_pos).to_be_greater_than(args_pos)
        expect(entry).to_contain(
            "args.len() == 5 and args[1] == BROWSER_RENDERER_WORKER_ARG"
        )
        expect(entry.contains(
            "args.contains(BROWSER_RENDERER_WORKER_ARG)"
        )).to_be(false)
        expect(print_pos).to_be_greater_than(worker_pos)
        expect(theme_pos).to_be_greater_than(worker_pos)
        expect(winit_pos).to_be_greater_than(worker_pos)

    it "keeps one ready-gated renderer with bounded writes and validated frames":
        val broker = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_process.spl"
        ) ?? ""
        val policy = rt_file_read_text(
            "src/os/hosted/hosted_browser_renderer_policy.spl"
        ) ?? ""
        expect(broker).to_contain("browser_renderer_spawn_sandboxed")
        expect(broker).to_contain("decoded.message.kind != \"ready\"")
        expect(broker).to_contain("process_write_stdin_some")
        expect(broker).to_contain("browser_renderer_frame_decode")
        expect(broker).to_contain("\"sandbox-unavailable\"")
        expect(broker).to_contain("pub class HostedBrowserRendererProcess")
        expect(broker).to_contain("next_request_id: 2")
        expect(broker).to_contain("browser_renderer_fetch_request_decode")
        expect(broker).to_contain(
            "rt_browser_http_job_start_public_limited"
        )
        expect(broker).to_contain(
            "self.next_request_id = self.next_request_id + 1"
        )
        expect(broker).to_contain(
            "hosted_browser_renderer_request_policy"
        )
        expect(broker).to_contain(
            "navigation_permit: HostedBrowserNavigationPermit"
        )
        expect(broker).to_contain("browser_renderer_navigation_encode")
        expect(broker).to_contain("expected_reply_to_request_id")
        expect(broker).to_contain("\"stale-renderer-frame\"")
        expect(broker).to_contain("pending_document_commit_url")
        expect(broker).to_contain("provisional_document_origin")
        expect(broker).to_contain("me begin_navigate(")
        expect(broker).to_contain("me begin_stop(")
        expect(broker).to_contain("me poll()")
        expect(broker).to_contain("rt_browser_http_job_cancel(handle)")
        expect(broker).to_contain("rt_time_now_monotonic_ms()")
        expect(broker.contains("rt_time_now_unix_micros")).to_be(false)
        val poll_start = broker.find("me poll()")
        val flush_start = broker.find("me _flush_pending_wire_once()")
        val wait_start = broker.find("me _await_frame(")
        val poll_body = broker.slice(poll_start, wait_start)
        val pump_body = broker.slice(flush_start, wait_start)
        expect(poll_body.contains("rt_sleep_ms")).to_be(false)
        expect(poll_body.contains("_write_before")).to_be(false)
        expect(pump_body).to_contain("process_write_stdin_some")
        val start_body = broker.slice(
            broker.find("me start("),
            broker.find("me _finalize_network(")
        )
        expect(start_body).to_contain("self.pid = 0")
        expect(start_body).to_contain(
            "self.fail(\"renderer-crashed\")"
        )
        expect(pump_body).to_contain("self.pid = 0")
        expect(pump_body).to_contain("\"renderer-crashed\"")
        expect(poll_body).to_contain("self.pid = 0")
        expect(poll_body).to_contain(
            "self.fail(\"renderer-crashed\")"
        )
        val cancel_start = broker.find("me _cancel_network_job()")
        val replace_start = broker.find("me _replace_pending_navigation()")
        val cancel_body = broker.slice(cancel_start, replace_start)
        val clear_pos = cancel_body.find("self.network_job_handle = 0")
        val cancel_pos = cancel_body.find(
            "rt_browser_http_job_cancel(handle)"
        )
        val free_pos = cancel_body.find("rt_browser_http_job_free(handle)")
        expect(clear_pos).to_be_greater_than(-1)
        expect(cancel_pos).to_be_greater_than(clear_pos)
        expect(free_pos).to_be_greater_than(cancel_pos)
        val close_start = broker.find("me close() -> bool:")
        val close_end = broker.find(
            "me fail(reason: text)"
        )
        expect(close_start).to_be_greater_than(-1)
        expect(close_end).to_be_greater_than(close_start)
        val close_body = broker.slice(close_start, close_end)
        val native_close = close_body.find(
            "process_close_piped(self.pid)"
        )
        val failed_close = close_body.find("return false")
        val clear_pid = close_body.find("self.pid = 0")
        expect(native_close).to_be_greater_than(-1)
        expect(failed_close).to_be_greater_than(native_close)
        expect(clear_pid).to_be_greater_than(failed_close)
        expect(broker).to_contain(
            "\"renderer-close-failed\""
        )
        expect(broker.contains(
            "hosted_browser_renderer_render_once"
        )).to_be(false)
        expect(policy).to_contain(
            "\"unauthorized-document-request\""
        )
        expect(broker.contains("fn _renderer_fetch_mode")).to_be(false)

    it "routes the production browser through the external worker frame gate":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        expect(entry).to_contain(
            "comp.require_external_web_frame("
        )
        expect(entry).to_contain("browser_frame_registered")
        expect(entry).to_contain(
            "browser_renderer.start(executable, 2000)"
        )
        expect(entry).to_contain(
            "browser_renderer.render("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_advance("
        )
        expect(entry).to_contain(
            "browser_renderer.next_animation_ms >= 0"
        )
        expect(entry).to_contain(
            "simple_web_external_content_frame("
        )
        expect(entry).to_contain(
            "comp.set_external_web_frame("
        )
        expect(entry).to_contain(
            "web_window.id != browser_profile_window_id"
        )
        expect(entry).to_contain(
            "HostedWebContentRegistry.create_with_default_bookmark_store()"
        )
        expect(entry).to_contain(
            "web_window.app_id == \"browser\""
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_back("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_forward("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_stop("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_go_home("
        )
        expect(entry).to_contain(
            "val now_micros = rt_time_now_micros()"
        )
        expect(entry).to_contain(
            "val wall_clock_ms = rt_time_now_unix_micros() / 1000"
        )
        expect(entry).to_contain(
            "if browser_profile_window_id <= 0 or not browser_renderer_ready:"
        )
        expect(entry).to_contain("var browser_raster_active = true")
        expect(entry).to_contain("browser_raster_active = false")
        expect(entry).to_contain(
            "fn _close_hosted_browser_resources("
        )
        expect(entry).to_contain(
            "val browser_close = _close_hosted_browser_resources("
        )
        expect(entry).to_contain(
            "normalize_network_navigation_url("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_pointer("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_key_with_shift("
        )
        expect(entry).to_contain(
            "browser_renderer.begin_text_input("
        )
        expect(entry).to_contain(
            "profile.toggle_bookmark("
        )
        expect(entry).to_contain(
            "fn _browser_bookmark_snapshot_set("
        )
        expect(entry.contains(
            "fn _add_browser_bookmark("
        )).to_be(false)
        val save_pos = entry.find("profile.toggle_bookmark(")
        val commit_pos = entry.find("browser_bookmarks = updated")
        expect(commit_pos).to_be_greater_than(save_pos)

    it "keeps title commands and page input on their production owner routes":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val run_start = entry.find("fn _run_hosted_wm(")
        val run_end = entry.find(
            "    print \"SimpleOS shared hosted WM closed\""
        )
        expect(run_start).to_be_greater_than(-1)
        expect(run_end).to_be_greater_than(run_start)
        val run_body = entry.slice(run_start, run_end)
        val renderer_owner = run_body.find(
            "var browser_renderer = HostedBrowserRendererProcess.create("
        )
        expect(renderer_owner).to_be_greater_than(-1)

        val poll_start = run_body.find(
            "if val Some(browser_result) = browser_renderer.poll():"
        )
        val poll_end = run_body.find("        var web_window_index = 0")
        expect(poll_start).to_be_greater_than(-1)
        expect(poll_start).to_be_greater_than(renderer_owner)
        expect(poll_end).to_be_greater_than(poll_start)
        val poll_body = run_body.slice(poll_start, poll_end)
        val poll_frame = poll_body.find("comp.set_external_web_frame(")
        val poll_title = poll_body.find(
            "host_compositor_update_window_title("
        )
        expect(poll_frame).to_be_greater_than(-1)
        expect(poll_title).to_be_greater_than(poll_frame)

        val pointer_start = run_body.find("elif kind == EVT_MOUSE_BUTTON:")
        val pointer_end = run_body.find("elif kind == EVT_MOUSE_WHEEL:")
        expect(pointer_start).to_be_greater_than(-1)
        expect(pointer_start).to_be_greater_than(renderer_owner)
        expect(pointer_end).to_be_greater_than(pointer_start)
        val pointer_body = run_body.slice(pointer_start, pointer_end)
        val page_pointer_start = pointer_body.find(
            "if target.window_id == browser_profile_window_id:"
        )
        val page_pointer_end = pointer_body.find(
            "                    else:\n" +
            "                        val dispatch = web_sessions.dispatch_pointer("
        )
        expect(page_pointer_start).to_be_greater_than(-1)
        expect(page_pointer_end).to_be_greater_than(page_pointer_start)
        val page_pointer = pointer_body.slice(
            page_pointer_start, page_pointer_end
        )
        val pointer_call = page_pointer.find(
            "browser_renderer.begin_pointer("
        )
        val pointer_target = page_pointer.find("\"browser:page\"")
        expect(pointer_call).to_be_greater_than(-1)
        expect(pointer_target).to_be_greater_than(pointer_call)
        expect(page_pointer.contains(
            "web_sessions.dispatch_pointer("
        )).to_be(false)
        expect(page_pointer.contains(
            "host_compositor_update_window_content("
        )).to_be(false)

        val key_start = run_body.find("elif kind == EVT_KEY:")
        val key_end = run_body.find("elif kind == EVT_TEXT:")
        expect(key_start).to_be_greater_than(-1)
        expect(key_start).to_be_greater_than(renderer_owner)
        expect(key_end).to_be_greater_than(key_start)
        val key_body = run_body.slice(key_start, key_end)
        val browser_key_start = key_body.find(
            "if focused == browser_profile_window_id:"
        )
        val browser_key_end = key_body.find("                elif focused > 0:")
        expect(browser_key_start).to_be_greater_than(-1)
        expect(browser_key_end).to_be_greater_than(browser_key_start)
        val browser_key = key_body.slice(browser_key_start, browser_key_end)
        val address_key_start = browser_key.find(
            "if browser_address_editing:"
        )
        val non_address_key_start = browser_key.find(
            "elif keycode != KEY_ESCAPE:"
        )
        val key_targets_start = browser_key.find(
            "input_receipt = host_wm_input_record_semantic("
        )
        expect(address_key_start).to_be_greater_than(-1)
        expect(non_address_key_start).to_be_greater_than(address_key_start)
        expect(key_targets_start).to_be_greater_than(non_address_key_start)
        val address_key = browser_key.slice(
            address_key_start, non_address_key_start
        )
        val non_address_key = browser_key.slice(
            non_address_key_start, key_targets_start
        )
        val key_targets = browser_key.slice(
            key_targets_start, browser_key.len()
        )
        val navigate_call = address_key.find(
            "browser_renderer.begin_navigate("
        )
        val title_update = address_key.find(
            "host_compositor_update_window_title("
        )
        val page_key_call = non_address_key.find(
            "browser_renderer.begin_key_with_shift("
        )
        val address_target = key_targets.find("\"browser:parent#address\"")
        val page_key_target = key_targets.find("\"browser:page\"")
        expect(navigate_call).to_be_greater_than(-1)
        expect(title_update).to_be_greater_than(navigate_call)
        expect(address_key.contains(
            "browser_renderer.begin_key_with_shift("
        )).to_be(false)
        expect(page_key_call).to_be_greater_than(-1)
        expect(non_address_key.contains(
            "browser_renderer.begin_navigate("
        )).to_be(false)
        expect(non_address_key.contains(
            "host_compositor_update_window_title("
        )).to_be(false)
        expect(address_target).to_be_greater_than(-1)
        expect(page_key_target).to_be_greater_than(address_target)
        expect(browser_key.contains(
            "web_sessions.dispatch_key_with_shift("
        )).to_be(false)

        val text_start = run_body.find("elif kind == EVT_TEXT:")
        val text_end = run_body.find("            rt_winit_event_free(ev)")
        expect(text_start).to_be_greater_than(-1)
        expect(text_start).to_be_greater_than(renderer_owner)
        expect(text_end).to_be_greater_than(text_start)
        val text_body = run_body.slice(text_start, text_end)
        val browser_text_start = text_body.find(
            "if focused == browser_profile_window_id:"
        )
        val browser_text_end = text_body.find("                    elif focused > 0:")
        expect(browser_text_start).to_be_greater_than(-1)
        expect(browser_text_end).to_be_greater_than(browser_text_start)
        val browser_text = text_body.slice(
            browser_text_start, browser_text_end
        )
        val address_text_start = browser_text.find(
            "if browser_address_editing:"
        )
        val non_address_text_start = browser_text.find(
            "                        else:\n" +
            "                            match browser_renderer.begin_text_input("
        )
        val text_targets_start = browser_text.find(
            "input_receipt = host_wm_input_record_semantic("
        )
        expect(address_text_start).to_be_greater_than(-1)
        expect(non_address_text_start).to_be_greater_than(address_text_start)
        expect(text_targets_start).to_be_greater_than(non_address_text_start)
        val address_text = browser_text.slice(
            address_text_start, non_address_text_start
        )
        val non_address_text = browser_text.slice(
            non_address_text_start, text_targets_start
        )
        val text_targets = browser_text.slice(
            text_targets_start, browser_text.len()
        )
        val text_title_update = address_text.find(
            "host_compositor_update_window_title("
        )
        val page_text_call = non_address_text.find(
            "browser_renderer.begin_text_input("
        )
        val text_address_target = text_targets.find(
            "\"browser:parent#address\""
        )
        val text_page_target = text_targets.find("\"browser:page\"")
        expect(text_title_update).to_be_greater_than(-1)
        expect(address_text.contains(
            "browser_renderer.begin_text_input("
        )).to_be(false)
        expect(page_text_call).to_be_greater_than(-1)
        expect(non_address_text.contains(
            "host_compositor_update_window_title("
        )).to_be(false)
        expect(text_address_target).to_be_greater_than(-1)
        expect(text_page_target).to_be_greater_than(text_address_target)
        expect(browser_text.contains(
            "web_sessions.dispatch_text("
        )).to_be(false)
        expect(browser_text.contains(
            "host_compositor_update_window_content("
        )).to_be(false)

        val post_text = run_body.slice(text_end, run_body.len())
        val animation_start = post_text.find(
            "if (browser_renderer_ready and\n" +
            "            browser_renderer.command_deadline_ms <= 0"
        )
        val animation_end = post_text.find("        if evidence.enabled:")
        expect(animation_start).to_be_greater_than(-1)
        expect(text_end + animation_start).to_be_greater_than(renderer_owner)
        expect(animation_end).to_be_greater_than(animation_start)
        val animation_body = post_text.slice(animation_start, animation_end)
        val active_animation = animation_body.find(
            "browser_renderer.next_animation_ms >= 0"
        )
        val advance_call = animation_body.find(
            "browser_renderer.begin_advance("
        )
        val advance_failure = animation_body.find(
            "browser_renderer_ready = false"
        )
        expect(active_animation).to_be_greater_than(-1)
        expect(advance_call).to_be_greater_than(active_animation)
        expect(advance_failure).to_be_greater_than(advance_call)

    # @req REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-009
    it "routes each secondary browser toolbar to its own hosted session":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val mouse = entry.slice(
            entry.find("elif kind == EVT_MOUSE_BUTTON:"),
            entry.find("elif kind == EVT_MOUSE_WHEEL:")
        )
        val secondary = mouse.find(
            "target.window_id != browser_profile_window_id"
        )
        val routed = mouse.find(
            "web_sessions.dispatch_chrome_pointer("
        )
        val primary = mouse.find(
            "browser_pressed_control = target.control"
        )
        expect(secondary).to_be_greater_than(-1)
        expect(routed).to_be_greater_than(secondary)
        expect(primary).to_be_greater_than(routed)
        expect(mouse).to_contain(
            "web_sessions.body_html(target.window_id)"
        )
        expect(mouse).to_contain(
            "web_sessions.address_text(target.window_id)"
        )

        val keyboard = entry.slice(
            entry.find("elif kind == EVT_KEY:"),
            entry.find("elif kind == EVT_TEXT:")
        )
        val text = entry.slice(
            entry.find("elif kind == EVT_TEXT:"),
            entry.find("val browser_animation_time_ms")
        )
        expect(keyboard).to_contain(
            "web_sessions.address_text(focused)"
        )
        expect(text).to_contain(
            "web_sessions.address_text(focused)"
        )

    # @req REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-017
    it "persists learned HSTS before processing the completed frame":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val poll_pos = entry.find(
            "val browser_poll = browser_renderer.poll()"
        )
        val result_pos = entry.find(
            "if val Some(browser_result) = browser_poll:"
        )
        expect(poll_pos).to_be_greater_than(-1)
        expect(result_pos).to_be_greater_than(poll_pos)
        val poll_body = entry.slice(poll_pos, result_pos)
        val dirty_pos = poll_body.find(
            "browser_renderer.hsts_dirty and browser_profile != nil"
        )
        val gate_pos = poll_body.find(
            "now_micros >= browser_hsts_save_retry_at_micros"
        )
        val save_pos = poll_body.find("_save_hosted_browser_hsts(")
        val restore_pos = poll_body.find(
            "browser_renderer = saved_renderer.unwrap()"
        )
        val retry_pos = poll_body.find(
            "browser_hsts_save_retry_at_micros = ("
        )
        val retry_delay = poll_body.find("now_micros + 1000000")
        expect(dirty_pos).to_be_greater_than(-1)
        expect(gate_pos).to_be_greater_than(dirty_pos)
        expect(save_pos).to_be_greater_than(gate_pos)
        expect(restore_pos).to_be_greater_than(save_pos)
        expect(retry_pos).to_be_greater_than(restore_pos)
        expect(retry_delay).to_be_greater_than(retry_pos)

        val helper_start = entry.find("fn _save_hosted_browser_hsts(")
        val helper_end = entry.find("fn _close_hosted_browser_resources(")
        expect(helper_start).to_be_greater_than(-1)
        expect(helper_end).to_be_greater_than(helper_start)
        val helper = entry.slice(helper_start, helper_end)
        val profile_save = helper.find("profile.save_hsts(")
        val ok_pos = helper.find("Ok(_):")
        val clear_dirty = helper.find("renderer.hsts_dirty = false")
        val updated_renderer = helper.find("Some(renderer)")
        val error_pos = helper.find("Err(error):")
        expect(profile_save).to_be_greater_than(-1)
        expect(ok_pos).to_be_greater_than(profile_save)
        expect(clear_dirty).to_be_greater_than(ok_pos)
        expect(updated_renderer).to_be_greater_than(clear_dirty)
        expect(error_pos).to_be_greater_than(updated_renderer)

        val close_body = entry.slice(helper_end, entry.find(
            "fn _run_hosted_wm("
        ))
        val close_save = close_body.find("_save_hosted_browser_hsts(")
        val profile_guard = close_body.find("if profile_in != nil:")
        val close_profile = close_body.find("profile.close()")
        expect(close_save).to_be_greater_than(-1)
        expect(profile_guard).to_be_greater_than(close_save)
        expect(close_profile).to_be_greater_than(profile_guard)
        expect(close_body).to_contain("renderer: renderer")
        expect(close_body).to_contain("raster: browser_raster")

    # @req REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018
    it "reconciles titlebar keyboard and evidence browser closes":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val mouse = entry.slice(
            entry.find("elif kind == EVT_MOUSE_BUTTON:"),
            entry.find("elif kind == EVT_MOUSE_WHEEL:")
        )
        expect(mouse).to_contain(
            "host_compositor_close_release_target("
        )
        val mouse_save = mouse.find("_save_hosted_browser_hsts(")
        val mouse_registry_save = mouse.find(
            "web_sessions.close_window("
        )
        val mouse_dispatch = mouse.find(
            "comp.handle_mouse_button(button, pressed)"
        )
        val mouse_cleanup = mouse.find(
            "_close_hosted_browser_resources("
        )
        expect(mouse_save).to_be_greater_than(-1)
        expect(mouse_registry_save).to_be_greater_than(mouse_save)
        expect(mouse_dispatch).to_be_greater_than(mouse_registry_save)
        expect(mouse_cleanup).to_be_greater_than(mouse_dispatch)
        expect(mouse).to_contain("if not allow_wm_close:")
        expect(mouse).to_contain("comp.armed_chrome_target = \"\"")
        expect(mouse).to_contain(
            "browser_renderer = saved_renderer.unwrap()"
        )
        expect(mouse).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(mouse).to_contain(
            "browser_raster = browser_closed.raster"
        )
        expect(mouse).to_contain("browser_profile = nil")
        expect(mouse).to_contain(
            "comp.release_external_web_frame("
        )

        val keyboard = entry.slice(
            entry.find("elif kind == EVT_KEY:"),
            entry.find("elif kind == EVT_TEXT:")
        )
        expect(keyboard).to_contain("elif keycode == KEY_W:")
        val keyboard_save = keyboard.find(
            "_save_hosted_browser_hsts("
        )
        val keyboard_cleanup = keyboard.find(
            "_close_hosted_browser_resources("
        )
        val keyboard_destroy = keyboard.find(
            "comp.destroy_window(focused)"
        )
        expect(keyboard_save).to_be_greater_than(-1)
        expect(keyboard_cleanup).to_be_greater_than(keyboard_save)
        expect(keyboard_destroy).to_be_greater_than(keyboard_cleanup)
        expect(keyboard).to_contain("browser_profile = nil")
        expect(keyboard).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(keyboard).to_contain(
            "comp.release_external_web_frame(focused)"
        )

        val evidence = entry.slice(
            entry.find("elif command.action == \"close\":"),
            entry.find("elif command.action == \"pointer\":")
        )
        expect(evidence).to_contain(
            "if focused == browser_profile_window_id:"
        )
        val evidence_save = evidence.find(
            "_save_hosted_browser_hsts("
        )
        val evidence_cleanup = evidence.find(
            "_close_hosted_browser_resources("
        )
        val evidence_destroy = evidence.find(
            "comp.destroy_window(focused)"
        )
        expect(evidence_save).to_be_greater_than(-1)
        expect(evidence_cleanup).to_be_greater_than(evidence_save)
        expect(evidence_destroy).to_be_greater_than(evidence_cleanup)
        expect(evidence).to_contain("\"rejected\"")
        expect(evidence).to_contain("browser_profile = nil")
        expect(evidence).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(evidence).to_contain(
            "comp.release_external_web_frame(focused)"
        )
        expect(evidence).to_contain("web_sessions.close_window(")

        val evidence_left = entry.slice(
            entry.find("elif command.action == \"left\":"),
            entry.find("elif command.action == \"snapshot\":")
        )
        val left_save = evidence_left.find(
            "_save_hosted_browser_hsts("
        )
        val left_dispatch = evidence_left.find(
            "comp.handle_mouse_button(0, command.down)"
        )
        val left_cleanup = evidence_left.find(
            "_close_hosted_browser_resources("
        )
        expect(left_save).to_be_greater_than(-1)
        expect(left_dispatch).to_be_greater_than(left_save)
        expect(left_cleanup).to_be_greater_than(left_dispatch)
        expect(evidence_left).to_contain(
            "host_compositor_close_release_target("
        )
        expect(evidence_left).to_contain(
            "if not allow_evidence_close:"
        )
        expect(evidence_left).to_contain(
            "browser_renderer = browser_closed.renderer"
        )
        expect(evidence_left).to_contain(
            "comp.release_external_web_frame("
        )
        expect(evidence_left).to_contain("\"rejected\"")
        val shutdown = entry.slice(
            entry.find("val profile_closed = web_sessions.close("),
            entry.find(
                "    print \"SimpleOS shared hosted WM closed\""
            )
        )
        expect(shutdown).to_contain(
            "browser_resource_close_failed"
        )
        expect(shutdown).to_contain(
            "browser_close.ok"
        )

    it "keeps native render evidence self-contained and fail closed":
        val entry = executable_source_lines(
            rt_file_read_text("src/os/hosted/hosted_entry.spl") ?? ""
        )
        val evidence = executable_source_lines(
            rt_file_read_text(
                "src/os/hosted/hosted_browser_render_evidence.spl"
            ) ?? ""
        )
        val worker_pos = entry.find(
            "return hosted_browser_renderer_worker_main(args)"
        )
        val evidence_pos = entry.find("--browser-render-evidence")
        val window_pos = entry.find("rt_winit_event_loop_new()")
        expect(evidence_pos).to_be_greater_than(worker_pos)
        expect(window_pos).to_be_greater_than(evidence_pos)
        expect(evidence).to_contain("#css-stage")
        expect(evidence).to_contain("#js-stage")
        expect(evidence).to_contain("#timer-stage")
        expect(evidence).to_contain("setTimeout(function()")
        expect(evidence).to_contain("requestAnimationFrame(function()")
        expect(evidence).to_contain("CSS animation pixels missing")
        expect(evidence).to_contain("requestAnimationFrame pixels missing")
        expect(evidence).to_contain("JavaScript timer pixels missing")
        expect(evidence).to_contain("animation raster requested fallback")
        expect(evidence).to_contain("renderer cleanup failed")
