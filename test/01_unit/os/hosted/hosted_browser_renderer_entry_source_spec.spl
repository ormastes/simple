        expect(title_update).to_be_greater_than(navigate_call)
        expect(address_key.contains(
            "browser_renderer.begin_key_with_shift("
        )).to_be(false)
        expect(page_key_call).to_be_greater_than(-1)
        expect(non_address_key.contains(
