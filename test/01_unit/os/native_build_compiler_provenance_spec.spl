use std.spec.*
use std.io_runtime.{read_file_text}

describe "SimpleOS cross-build compiler provenance":
    it "defaults architecture wrappers to the pure-Simple compiler":
        val aarch64 = read_file_text("scripts/os/simpleos-native-build-aarch64.shs") ?? ""
        val riscv64 = read_file_text("scripts/os/simpleos-native-build-riscv64.shs") ?? ""
        val core_archive = read_file_text("scripts/os/simpleos-core-archive.shs") ?? ""

        # Both wrappers replaced the bare `SIMPLE_BUILD_COMPILER:-bin/release/simple`
        # default with a seed-rejecting, capability-probing selection. The old
        # needle now survives ONLY inside the comment recording its removal
        # (simpleos-native-build-aarch64.shs:30, -riscv64.shs:28), so anchoring on
        # it asserted nothing. Anchor on the executable selection instead.
        expect(aarch64).to_contain(". \"$REPO_ROOT/scripts/lib/simple-compiler-select.shs\"")
        expect(aarch64).to_contain("simple_compiler_select --root \"$REPO_ROOT\" --builder-target \"$TARGET\"")
        expect(riscv64).to_contain("bin/release/*/simple")
        expect(riscv64).to_contain("if is_bootstrap_seed \"$candidate\"; then")
        expect(riscv64).to_contain("if ! compiler_can_build_target \"$candidate\"; then")
        expect(aarch64.contains("SIMPLE_BUILD_COMPILER:-src/compiler_rust")).to_be(false)
        expect(riscv64.contains("SIMPLE_BUILD_COMPILER:-src/compiler_rust")).to_be(false)
        expect(core_archive).to_contain("SIMPLE_BINARY:-bin/release/simple")
        expect(core_archive.contains("SIMPLE_BINARY:-src/compiler_rust")).to_be(false)

    it "fails closed for stale, partial, or wrong-architecture artifacts":
        val riscv64 = read_file_text("scripts/os/simpleos-native-build-riscv64.shs") ?? ""
        val core_archive = read_file_text("scripts/os/simpleos-core-archive.shs") ?? ""
        val freebsd_bootstrap = read_file_text("scripts/check/check-freebsd-bootstrap-qemu.shs") ?? ""

        expect(core_archive).to_contain("rm -rf \"$PART_DIR/objects\"")
        expect(core_archive).to_contain("rm -f \"$part_archive\" \"$part_log\"")
        expect(core_archive).to_contain("[ \"$FAILED\" -ne 0 ] || [ \"$BUILT\" -eq 0 ]")
        expect(riscv64).to_contain("expected a static RISC-V ELF")
        expect(riscv64).to_contain("ELF 64-bit")
        expect(riscv64).to_contain("Class:[[:space:]]+ELF64")
        expect(riscv64).to_contain("readelf -h \"$OUTPUT\"")
        expect(freebsd_bootstrap).to_contain("check-core-runtime-smoke.shs")
        expect(freebsd_bootstrap).to_contain("STAGE_BIN")
        expect(freebsd_bootstrap).to_contain("FreeBSD stage3 core runtime smoke failed")

    it "runs the strict default-LLVM language matrix on FreeBSD":
        val freebsd_bootstrap = read_file_text("scripts/check/check-freebsd-bootstrap-qemu.shs") ?? ""
        val matrix = read_file_text("scripts/check/native-smoke-matrix.shs") ?? ""

        expect(freebsd_bootstrap).to_contain("NATIVE_SMOKE_BACKEND=llvm")
        expect(freebsd_bootstrap).to_contain("Expected FreeBSD guest, got:")
        expect(freebsd_bootstrap).to_contain("sh scripts/check/native-smoke-matrix.shs")
        expect(freebsd_bootstrap).to_contain("grep -qx 'native_smoke_matrix=true'")
        expect(freebsd_bootstrap).to_not_contain("total=15 pass=15")
        expect(matrix).to_contain("[ \"$TOTAL\" -eq 0 ] || [ \"$FAIL_N\" -gt 0 ] || [ \"$XPASS_N\" -gt 0 ] || [ \"$FALLBACK_TOTAL\" -gt 0 ]")
        expect(matrix).to_contain("require_nonempty_target_object")
        expect(matrix).to_contain("require_runtime_exit")
        expect(matrix).to_contain("platform_case")

    it "fails closed on cross-architecture object and runtime evidence":
        val assertions = read_file_text("scripts/check/native-target-assertions.shs") ?? ""
        val llvm = read_file_text("scripts/check/check-llvm-simd-row-native-arch.shs") ?? ""
        val cranelift = read_file_text("scripts/check/check-cranelift-aot-aggregate-cross.shs") ?? ""

        expect(assertions).to_contain("require_nonempty_target_object")
        expect(assertions).to_contain("require_target_machine() (")
        expect(assertions).to_contain("require_coff_machine() (")
        expect(assertions).to_contain("OptionalHeaderSize:[[:space:]]+0")
        expect(assertions).to_contain("IMAGE_FILE_EXECUTABLE_IMAGE")
        expect(assertions).to_contain("require_runtime_exit() (")
        expect(llvm).to_contain(". scripts/check/native-target-assertions.shs")
        expect(llvm).to_contain("SIMPLE_NO_STUB_FALLBACK=1")
        expect(llvm).to_contain("aarch64-pc-windows-msvc")
        expect(llvm).to_contain("COFF-ARM64")
        expect(llvm).to_contain("IMAGE_FILE_MACHINE_ARM64 (0xAA64)")
        expect(llvm).to_contain("rt_char_from_code")
        expect(cranelift).to_contain(". scripts/check/native-target-assertions.shs")
        expect(cranelift).to_contain("env -u SIMPLE_BOOTSTRAP SIMPLE_NO_STUB_FALLBACK=1 \"$SIMPLE_BIN\" native-build")

    it "guards the Stage 4 platform-matrix bootstrap proof surface":
        val bootstrap = read_file_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val portability = read_file_text("scripts/check/check-bootstrap-portability.shs") ?? ""
        val freebsd = read_file_text("scripts/check/check-freebsd-bootstrap-qemu.shs") ?? ""
        val simpleos_arm64 = read_file_text("scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs") ?? ""
        val stage4_plan = read_file_text("doc/03_plan/infra/agent_sessions/stage4_spdev.md") ?? ""
        val platform_matrix = read_file_text("doc/03_plan/sys_test/native_platform_arch_matrix.md") ?? ""
        val agent_tasks = read_file_text("doc/03_plan/agent_tasks/stage4_spdev.md") ?? ""

        expect(bootstrap).to_contain("SIMPLE_BOOTSTRAP_STAGE4=1")
        expect(bootstrap).to_contain("SIMPLE_STAGE4_STREAMING_SURFACES=1")
        expect(bootstrap).to_contain("stage4-redeploy-gate")
        expect(bootstrap).to_contain("check-bootstrap-essential-tools-smoke.shs")
        expect(bootstrap).to_contain("simpleos-x86_64")
        expect(portability).to_contain("check-stage4-hosted-dynload-provider-archive.shs")
        expect(portability).to_contain("validate_stage4_hosted_dynload_provider_archive.spl")
        expect(portability).to_contain("sh scripts/check/check-freebsd-bootstrap-qemu.shs --full")
        expect(portability).to_contain("build-simpleos-arm64-desktop-engine2d-attested.shs")
        expect(portability).to_contain("sh scripts/bootstrap/bootstrap-windows.sh --msvc")
        expect(freebsd).to_contain("FREEBSD_VERSION=\"14.4\"")
        expect(freebsd).to_contain("check-core-runtime-smoke.shs")
        expect(simpleos_arm64).to_contain("simpleos_arm64_desktop_engine2d.build-manifest.env")
        expect(simpleos_arm64).to_contain("arm64_desktop_engine2d_attested_build_status=pass")
        expect(simpleos_arm64).to_contain("SIMPLE_OS_BUILD_BACKEND=llvm")
        expect(stage4_plan).to_contain("ST4-PLAT-FREEBSD")
        expect(stage4_plan).to_contain("ST4-PLAT-SIMPLEOS-A64")
        expect(stage4_plan).to_contain("ST4-PLAT-A64-LINUX")
        expect(stage4_plan).to_contain("ST4-PLAT-MAC")
        expect(stage4_plan).to_contain("ST4-PLAT-WIN")
        expect(stage4_plan).to_contain("sh scripts/bootstrap/bootstrap-from-scratch.sh --backend=llvm --mode=dynload --full-bootstrap --full-cli --jobs=2")
        expect(stage4_plan).to_contain("bash scripts/bootstrap/bootstrap-windows.sh --msvc --backend=llvm --mode=dynload --full-bootstrap --no-mcp --jobs=2")
        expect(stage4_plan).to_contain("sh scripts/bootstrap/bootstrap-from-scratch.sh --target=simpleos-x86_64 --output=build/bootstrap --jobs=2")
        expect(stage4_plan).to_contain("sh scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs")
        expect(platform_matrix).to_contain("REQ-PLAT-001")
        expect(platform_matrix).to_contain("REQ-PLAT-005")
        expect(agent_tasks).to_contain("incremental-unlimited")
        expect(stage4_plan).to_contain("parallel lane split")
        expect(agent_tasks).to_contain("ST4-R7")
        expect(agent_tasks).to_contain("ST4-R8")
        expect(agent_tasks).to_contain("Current-host follow-ons")
