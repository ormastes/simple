"""SimpleOS server worker admission must not confuse scheduler tasks with threads."""

use std.spec.*
use os.server_thread_capability.{
    simpleos_server_thread_capability,
    simpleos_server_background_worker_admitted,
    simpleos_server_worker_count,
    simpleos_server_thread_receipt_text
}

describe "SimpleOS server thread capability":
    it "keeps the server inline while closure spawn and join are unavailable":
        val capability = simpleos_server_thread_capability()
        expect(capability.scheduler_task_records).to_equal(true)
        expect(capability.closure_handoff).to_equal(false)
        expect(capability.worker_stack_ownership).to_equal(false)
        expect(capability.join_completion).to_equal(false)
        expect(simpleos_server_background_worker_admitted(capability)).to_equal(false)
        expect(simpleos_server_worker_count(8, capability)).to_equal(1)
        expect(capability.fallback).to_equal("caller-thread-inline")

    it "emits a falsifiable capability receipt":
        val receipt = simpleos_server_thread_receipt_text(
            simpleos_server_thread_capability())
        expect(receipt).to_contain("thread_profile=simpleos-single-worker-v1")
        expect(receipt).to_contain("scheduler_task_records=true")
        expect(receipt).to_contain("closure_handoff=false")
        expect(receipt).to_contain("worker_stack_ownership=false")
        expect(receipt).to_contain("join_completion=false")
        expect(receipt).to_contain("background_worker=false")
        expect(receipt).to_contain("fallback=caller-thread-inline")
        expect(receipt).to_contain("thread_reason=missing-userspace-closure-spawn-join-abi")
