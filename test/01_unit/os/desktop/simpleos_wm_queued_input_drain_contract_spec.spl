use std.io.{file_read}
use std.spec.{describe, it, expect}

val SHELL = "src/os/desktop/shell.spl"
val COMPOSITOR = "src/os/compositor/compositor.spl"

describe "SimpleOS WM queued input drain contract":
    it "drains queued receipts without requiring another hardware byte":
        val shell = file_read(SHELL)
        val compositor = file_read(COMPOSITOR)
        expect(compositor.contains("use os.kernel.boot.cpu")).to_be(false)
        expect(compositor).to_contain("me handle_input_baremetal_ps2(port_read: fn(u16) -> u8):")
        expect(compositor).to_contain("me _handle_input_ps2(port_read: fn(u16) -> u8):")
        expect(compositor).to_contain("var status = port_read(0x64)")
        expect(compositor.contains("self._handle_input_ps2()")).to_be(false)
        expect(shell).to_contain(
            "self.compositor.pending_wm_pointer_valid")
        expect(shell).to_contain(
            "self.compositor.pending_fullscreen_sequence > 0")
        expect(shell).to_contain(
            "self.compositor.pending_fullscreen_release_sequence > 0")
        expect(shell).to_contain(
            "if not ps2_byte_ready and not queued_input_active:\n" +
            "                continue")
        expect(shell).to_contain(
            "if ps2_byte_ready:\n" +
            "                input_compositor.handle_input_baremetal_ps2(port_read)")
        expect(shell).to_contain(
            "me run_baremetal(executor: Engine2dWmFrameExecutor, port_read: fn(u16) -> u8):")
        expect(shell).to_contain(
            "if not input_active:\n" +
            "                # A partial PS/2 packet may not have produced a receipt yet,\n" +
            "                # but its decoder state must survive until the next byte.\n" +
            "                self.compositor = input_compositor\n" +
            "                continue")
        expect(shell.contains(
            "if ((ps2_status as i32) & 1) == 0:\n" +
            "                continue")).to_equal(false)
