# @req: REQ-OS-DESKTOP-001

use std.spec
use os.hosted.hosted_wm_evidence.{
    host_wm_evidence_config,
    host_wm_evidence_parse_command,
    host_wm_evidence_ppm,
    host_wm_input_receipt,
    host_wm_input_receipt_json,
    host_wm_input_record_key,
    host_wm_input_record_presented,
    host_wm_input_record_semantic,
    host_wm_input_record_pointer_button,
    host_wm_input_record_pointer_move
}

describe "hosted WM production evidence protocol":
    it "is disabled by default and rejects partial hook configuration":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: is disabled by default and rejects partial hook configuration")
        val disabled = host_wm_evidence_config("", "", "")
        expect(disabled.enabled).to_equal(false)
        expect(disabled.valid).to_equal(true)
        val partial = host_wm_evidence_config("scene.json", "", "commands")
        expect(partial.enabled).to_equal(true)
        expect(partial.valid).to_equal(false)

    it "accepts nonce-tagged production input commands and rejects malformed input":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: accepts nonce-tagged production input commands and rejects malformed input")
        val f11 = host_wm_evidence_parse_command("17 f11\n")
        expect(f11.valid).to_equal(true)
        expect(f11.nonce).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(f11.action).to_equal("f11")
        val pointer = host_wm_evidence_parse_command("18 pointer 42 77")
        expect(pointer.valid).to_equal(true)
        expect(pointer.x).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(pointer.y).to_equal(77)  # oracle: 77 — named expected value from the requirement
        expect(host_wm_evidence_parse_command("0 f11").valid).to_equal(false)
        expect(host_wm_evidence_parse_command("19 unknown").valid).to_equal(false)

    it "encodes exact presented ARGB pixels as binary PPM RGB bytes":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: encodes exact presented ARGB pixels as binary PPM RGB bytes")
        val ppm = host_wm_evidence_ppm(2, 1, [0xFFFF0000u32, 0xFF00FF00u32])
        expect(ppm.len()).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(ppm[11]).to_equal(0xFFu8)
        expect(ppm[12]).to_equal(0u8)
        expect(ppm[13]).to_equal(0u8)
        expect(ppm[14]).to_equal(0u8)
        expect(ppm[15]).to_equal(0xFFu8)
        expect(ppm[16]).to_equal(0u8)

    it "rejects capture dimensions that do not exactly match readback":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: rejects capture dimensions that do not exactly match readback")
        expect(host_wm_evidence_ppm(2, 2, [0u32]).len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "retains distinct keyboard down and up receipts":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: retains distinct keyboard down and up receipts")
        val initial = host_wm_input_receipt()
        val pressed = host_wm_input_record_key(initial, 30, 65, true)
        val released = host_wm_input_record_key(pressed, 30, 65, false)
        expect(released.key_down_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(released.key_up_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(released.last_event_kind).to_equal("key-up")
        expect(released.last_scancode).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(released.last_keycode).to_equal(65)  # oracle: 65 — named expected value from the requirement

    it "retains distinct pointer move, button-down, and button-up receipts":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: retains distinct pointer move, button-down, and button-up receipts")
        val initial = host_wm_input_receipt()
        val moved = host_wm_input_record_pointer_move(initial, 42, 77)
        val pressed = host_wm_input_record_pointer_button(moved, 0, true)
        val released = host_wm_input_record_pointer_button(pressed, 0, false)
        expect(released.pointer_move_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(released.pointer_button_down_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(released.pointer_button_up_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(released.last_event_kind).to_equal("pointer-button-up")
        expect(released.last_pointer_x).to_equal(42)  # oracle: 42 — named expected value from the requirement
        expect(released.last_pointer_y).to_equal(77)  # oracle: 77 — named expected value from the requirement
        expect(released.last_pointer_button).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val receipt_json = host_wm_input_receipt_json(released)
        expect(receipt_json).to_contain("\"pointer_move_count\":1")
        expect(receipt_json).to_contain("\"pointer_button_down_count\":1")
        expect(receipt_json).to_contain("\"pointer_button_up_count\":1")

    it "retains screen-to-semantic correlation without replacing raw input counts":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: retains screen-to-semantic correlation without replacing raw input counts")
        val initial = host_wm_input_receipt()
        val receipt = host_wm_input_record_semantic(
            initial, 17, 3, "host-proof", 1, 1, "", 123456
        )
        expect(receipt.event_origin).to_equal("screen")
        expect(receipt.event_id).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(receipt.wm_target_id).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(receipt.semantic_target_id).to_equal("host-proof")
        expect(receipt.callback_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(receipt.mutation_revision).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(receipt.input_received_us).to_equal(123456)  # oracle: 123456 — named expected value from the requirement
        val receipt_json = host_wm_input_receipt_json(receipt)
        expect(receipt_json).to_contain("\"event_origin\":\"screen\"")
        expect(receipt_json).to_contain("\"semantic_target_id\":\"host-proof\"")
        expect(receipt_json).to_contain("\"input_received_us\":123456")

    it "closes the latest semantic event on a monotonic host presentation":
        # @req: REQ-OS-DESKTOP-001
        step("Verify: closes the latest semantic event on a monotonic host presentation")
        val first = host_wm_input_record_semantic(
            host_wm_input_receipt(), 17, 3, "host-proof", 1, 9, "", 100
        )
        val rejected_before_present = host_wm_input_record_semantic(
            first, 18, 3, "", 0, 10, "", 120
        )
        expect(rejected_before_present.event_id).to_equal(17)  # oracle: 17 — named expected value from the requirement
        val first_presented = host_wm_input_record_presented(
            rejected_before_present, 140, 2, 0
        )
        expect(first_presented.event_id).to_equal(17)  # oracle: 17 — named expected value from the requirement
        expect(first_presented.input_to_present_us).to_equal(40)  # oracle: 40 — named expected value from the requirement
        val latest = host_wm_input_record_semantic(
            first_presented, 18, 3, "host-proof", 1, 10, "", 150
        )
        expect(latest.event_id).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(latest.mutation_revision).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(latest.present_completed_us).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(latest.present_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val presented = host_wm_input_record_presented(latest, 190, 3, 1)
        expect(presented.event_id).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(presented.input_received_us).to_equal(150)  # oracle: 150 — named expected value from the requirement
        expect(presented.present_completed_us).to_equal(190)  # oracle: 190 — named expected value from the requirement
        expect(presented.input_to_present_us).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(presented.present_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(presented.skipped_frame_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val stale_semantic = host_wm_input_record_semantic(
            presented, 17, 3, "stale", 1, 8, "", 160
        )
        expect(stale_semantic.event_id).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(stale_semantic.semantic_target_id).to_equal("host-proof")
        val duplicate = host_wm_input_record_semantic(
            presented, 18, 3, "duplicate", 1, 11, "", 195
        )
        expect(duplicate.semantic_target_id).to_equal("host-proof")
        expect(duplicate.present_completed_us).to_equal(190)  # oracle: 190 — named expected value from the requirement
        val rejected_newer = host_wm_input_record_semantic(
            presented, 19, 3, "unhandled", 1, 11, "unhandled", 195
        )
        expect(rejected_newer.event_id).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(rejected_newer.semantic_target_id).to_equal("host-proof")
        expect(rejected_newer.present_completed_us).to_equal(190)  # oracle: 190 — named expected value from the requirement
        expect(rejected_newer.input_to_present_us).to_equal(40)  # oracle: 40 — named expected value from the requirement
        val stale = host_wm_input_record_presented(presented, 189, 4, 1)
        expect(stale.present_completed_us).to_equal(190)  # oracle: 190 — named expected value from the requirement
        expect(stale.present_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val stale_skip = host_wm_input_record_presented(presented, 191, 4, 0)
        expect(stale_skip.skipped_frame_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val stale_present_count = host_wm_input_record_presented(
            presented, 191, 2, 1
        )
        expect(stale_present_count.present_completed_us).to_equal(190)  # oracle: 190 — named expected value from the requirement
        expect(stale_present_count.input_to_present_us).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(stale_present_count.present_count).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(stale_present_count.skipped_frame_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val receipt_json = host_wm_input_receipt_json(presented)
        expect(receipt_json).to_contain("\"present_completed_us\":190")
        expect(receipt_json).to_contain("\"input_to_present_us\":40")
        expect(receipt_json).to_contain("\"present_count\":3")
        expect(receipt_json).to_contain("\"skipped_frame_count\":1")
