"""
## Purpose and audience

Protects the ARM64 SimpleOS desktop font-readiness report from treating
optional catalog-face failures as failure of the selected default face.

## Operator workflow

Run `bin/simple test test/01_unit/os/desktop/arm64_font_readiness_contract_spec.spl`.

## Compatibility and limitations

This is a focused source-wiring regression. Guest font loading remains covered
by the ARM64 live desktop evidence lanes.
"""

use std.spec.{describe, it, expect}
use app.io.mod.{file_read_text}

val ENTRY = "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"

describe "SimpleOS ARM64 desktop font readiness":
    it "reports default-face readiness and retains catalog diagnostics from one registration sweep":
        step("Read the ARM64 desktop entry and verify one sweep plus default-face and per-face receipts")
        val source = file_read_text(ENTRY)
        expect(source).to_contain("simpleos_desktop_default_font_registered")
        expect(source).to_contain("val font_catalog_complete = simpleos_desktop_register_selected_fonts_from_vfs()")
        expect(source.count("simpleos_desktop_register_selected_fonts_from_vfs()")).to_equal(1)
        expect(source).to_contain("val font_loaded = simpleos_desktop_default_font_registered()")
        expect(source).to_contain("catalog_complete=")
        expect(source).to_contain("registered=")
        expect(source).to_contain("unregistered=")
        expect(source.contains("val font_loaded = simpleos_desktop_register_selected_fonts_from_vfs()")).to_be(false)
