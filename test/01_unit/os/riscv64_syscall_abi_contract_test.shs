#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/build/os"
: >"$tmp/build/os/fat32-riscv64.img"

(
    cd "$tmp"
    riscv64-unknown-elf-gcc -c -march=rv64gc -mabi=lp64d -mcmodel=medany \
        -ffreestanding -nostdlib \
        -DSIMPLE_BOOT_MINIMAL=1 -DSIMPLE_RUNTIME_NO_ENTRY=1 \
        -DSIMPLE_RUNTIME_NO_WEAK_HEAP=1 \
        "$root/src/os/kernel/arch/riscv64/boot/freestanding_runtime.c" \
        -o runtime.o
    riscv64-unknown-elf-gcc -c -march=rv64gc -mabi=lp64d -mcmodel=medany \
        -ffreestanding -nostdlib -ffunction-sections -fdata-sections \
        "$root/examples/09_embedded/simple_os/arch/riscv64/boot/full_gui_runtime.c" \
        -o gui-runtime.o
)

riscv64-unknown-elf-nm -g --defined-only "$tmp/runtime.o" >"$tmp/symbols"
awk '$3 == "rt_riscv64_syscall" { print $2, $3 }' \
    "$tmp/symbols" >"$tmp/symbol"
printf '%s\n' 'T rt_riscv64_syscall' >"$tmp/expected-symbol"
diff -u "$tmp/expected-symbol" "$tmp/symbol"
grep -Eq ' T rt_string_data$' "$tmp/symbols"
grep -Eq ' T rt_string_len$' "$tmp/symbols"
! grep -Eq ' [TW] _start$' "$tmp/symbols"

riscv64-unknown-elf-nm -g --defined-only "$tmp/gui-runtime.o" >"$tmp/gui-symbols"
grep -Eq ' T rt_riscv64_syscall$' "$tmp/gui-symbols"
grep -Eq ' T rt_string_data$' "$tmp/gui-symbols"
grep -Eq ' T rt_string_len$' "$tmp/gui-symbols"
for symbol in \
    rt_array_repeat rt_byte_array_new rt_bytes_to_text rt_contains \
    rt_eprintln_str rt_for_iterable rt_pool_safepoint rt_raw_u64_to_string \
    rt_slice rt_string_bytes rt_string_join rt_text_count_codepoints_cached \
    rt_text_to_bytes rt_typed_bytes_u8_push rt_typed_words_u32_push \
    rt_value_as_float rt_value_float
do
    grep -Eq " T ${symbol}$" "$tmp/gui-symbols"
done
for symbol in \
    rt_tls_client_close rt_tls_client_connect rt_tls_client_read rt_tls_client_write
do
    ! grep -Eq " [TW] ${symbol}$" "$tmp/gui-symbols"
done

cat >"$tmp/float-roundtrip.c" <<EOF
typedef long long spl_i64;
typedef unsigned long long spl_u64;
typedef unsigned int spl_u32;
#define RT_VALUE_TAG_MASK 0x7ULL
#define RT_VALUE_TAG_HEAP 0x1ULL
#define RT_VALUE_HEAP_FLOAT 0x464C5431U
#include "$root/src/os/kernel/arch/riscv64/boot/freestanding_float_value.h"

static unsigned char heap[64];
static unsigned long long heap_offset;

static void *test_alloc(spl_i64 size) {
    void *result = heap + heap_offset;
    heap_offset += (unsigned long long)size;
    return heap_offset <= sizeof(heap) ? result : (void *)0;
}

int main(void) {
    union { double value; unsigned long long bits; } before, after;
    before.value = 0.1;
    after.value = rt_float_unbox_value(rt_float_box_value(before.value, test_alloc));
    return before.bits == after.bits ? 0 : 1;
}
EOF
cc "$tmp/float-roundtrip.c" -o "$tmp/float-roundtrip"
"$tmp/float-roundtrip"

cat >"$tmp/expected-instructions" <<'EOF'
c.mv	a7,a0
c.mv	a0,a1
c.mv	a1,a2
c.mv	a2,a3
c.mv	a3,a4
c.mv	a4,a5
c.mv	a5,a6
ecall
c.jr	ra
EOF

check_syscall_instructions() {
    object=$1
    output=$2
    riscv64-unknown-elf-objdump -d -M no-aliases "$object" |
        awk '
            /<rt_riscv64_syscall>:/ { body = 1; next }
            body && /<[A-Za-z0-9_]+>:/ { exit }
            body && /^[[:space:]]*[0-9a-f]+:/ {
                if (NF >= 4) {
                    print $3 "\t" $4
                } else {
                    print $3
                }
            }
        ' >"$output"
    diff -u "$tmp/expected-instructions" "$output"
}

check_syscall_instructions "$tmp/runtime.o" "$tmp/runtime-instructions"
check_syscall_instructions "$tmp/gui-runtime.o" "$tmp/gui-runtime-instructions"

grep -Fq "extern fn rt_riscv64_syscall(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "rt_riscv64_syscall(id, arg0, arg1, arg2, arg3, arg4, arg5)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "fn syscall6(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "_syscall6(id, arg0, arg1, arg2, arg3, arg4, 0)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "syscall6(13, path_ptr, path_len, argv_ptr, envp_ptr, argv_table, envp_table)" \
    "$root/src/os/userlib/process.spl"
! grep -Fq "arg5: u64 = 0" "$root/src/os/userlib/syscall_raw.spl"
! sed -n '/@cfg(riscv64)/,/@cfg(riscv32)/p' \
    "$root/src/os/userlib/syscall_raw.spl" | grep -Fq "asm volatile"

echo "PASS: RV64 syscall ABI contract"
