#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/build/os"
: >"$tmp/build/os/fat32-riscv64.img"

(
    cd "$tmp"
    riscv64-unknown-elf-gcc -c -march=rv64gc -mabi=lp64d -mcmodel=medany \
        -ffreestanding -nostdlib \
        -DSIMPLE_BOOT_MINIMAL=1 -DSIMPLE_RUNTIME_NO_ENTRY=1 \
        -DSIMPLE_RUNTIME_NO_WEAK_HEAP=1 \
        "$root/src/os/kernel/arch/riscv64/boot/freestanding_runtime.c" \
        -o runtime.o
    riscv64-unknown-elf-gcc -c -march=rv64gc -mabi=lp64d -mcmodel=medany \
        -ffreestanding -nostdlib -ffunction-sections -fdata-sections \
        "$root/examples/09_embedded/simple_os/arch/riscv64/boot/full_gui_runtime.c" \
        -o gui-runtime.o
)

riscv64-unknown-elf-nm -g --defined-only "$tmp/runtime.o" >"$tmp/symbols"
awk '$3 == "rt_riscv64_syscall" { print $2, $3 }' \
    "$tmp/symbols" >"$tmp/symbol"
printf '%s\n' 'T rt_riscv64_syscall' >"$tmp/expected-symbol"
diff -u "$tmp/expected-symbol" "$tmp/symbol"
grep -Eq ' T rt_string_data$' "$tmp/symbols"
grep -Eq ' T rt_string_len$' "$tmp/symbols"
! grep -Eq ' [TW] _start$' "$tmp/symbols"

riscv64-unknown-elf-nm -g --defined-only "$tmp/gui-runtime.o" >"$tmp/gui-symbols"
grep -Eq ' T rt_riscv64_syscall$' "$tmp/gui-symbols"
grep -Eq ' T rt_string_data$' "$tmp/gui-symbols"
grep -Eq ' T rt_string_len$' "$tmp/gui-symbols"
for symbol in \
    rt_array_copy rt_array_repeat rt_byte_array_new rt_bytes_to_text \
    rt_contains rt_copy_user_byte rt_dict_get rt_dict_keys rt_dict_new \
    rt_dict_remove rt_dict_set rt_env_get rt_eprintln_str \
    rt_file_append_text rt_for_iterable rt_memory_barrier \
    rt_pool_safepoint rt_raw_u64_to_string rt_stderr_write \
    rt_riscv64_virtio_blk_fat32_capacity_sectors \
    rt_riscv64_virtio_blk_fat32_init \
    rt_riscv64_virtio_blk_fat32_read_sector_bytes rt_slice \
    rt_string_bytes rt_string_char_at rt_string_join rt_string_new_literal \
    rt_string_replace rt_text_count_codepoints_cached rt_text_to_bytes \
    rt_text_validate_utf8 rt_time_now_monotonic_ms rt_typed_bytes_u8_push \
    rt_typed_words_u32_push \
    rt_volatile_read_u16 rt_volatile_read_u32 rt_volatile_read_u64 \
    rt_volatile_read_u8 rt_volatile_write_u16 rt_volatile_write_u32 \
    rt_volatile_write_u64 rt_volatile_write_u8 rt_value_as_float \
    rt_value_float unsafe_addr_of
do
    grep -Eq " T ${symbol}$" "$tmp/gui-symbols"
done
! grep -Eq ' [TW] rt_port_inb$' "$tmp/gui-symbols"
for symbol in \
    rt_tls_client_close rt_tls_client_connect rt_tls_client_read rt_tls_client_write
do
    ! grep -Eq " [TW] ${symbol}$" "$tmp/gui-symbols"
done

cat >"$tmp/float-roundtrip.c" <<EOF
typedef long long spl_i64;
typedef unsigned long long spl_u64;
typedef unsigned int spl_u32;
#define RT_VALUE_TAG_MASK 0x7ULL
#define RT_VALUE_TAG_HEAP 0x1ULL
#define RT_VALUE_HEAP_FLOAT 0x464C5431U
#include "$root/src/os/kernel/arch/riscv64/boot/freestanding_float_value.h"

static unsigned char heap[64];
static unsigned long long heap_offset;

static void *test_alloc(spl_i64 size) {
    void *result = heap + heap_offset;
    heap_offset += (unsigned long long)size;
    return heap_offset <= sizeof(heap) ? result : (void *)0;
}

int main(void) {
    union { double value; unsigned long long bits; } before, after;
    before.value = 0.1;
    after.value = rt_float_unbox_value(rt_float_box_value(before.value, test_alloc));
    return before.bits == after.bits ? 0 : 1;
}
EOF
cc "$tmp/float-roundtrip.c" -o "$tmp/float-roundtrip"
"$tmp/float-roundtrip"

cat >"$tmp/runtime-value-selfcheck.c" <<'EOF'
#include <stdint.h>
#include <sys/mman.h>

typedef int64_t Value;

extern Value rt_array_copy(Value);
extern Value rt_array_get(Value, Value);
extern Value rt_array_len(Value);
extern Value rt_array_new(Value);
extern Value rt_array_push(Value, Value);
extern Value rt_dict_get(Value, Value);
extern Value rt_dict_keys(Value);
extern Value rt_dict_new(Value);
extern Value rt_dict_remove(Value, Value);
extern Value rt_dict_set(Value, Value, Value);
extern Value rt_string_char_at(Value, Value);
extern Value rt_string_data(Value);
extern Value rt_string_len(Value);
extern Value rt_string_new_literal(Value, Value);
extern Value rt_string_replace(Value, Value, Value);
extern Value rt_text_validate_utf8(Value);

static int same_text(Value value, const char *expected, int64_t len) {
    const char *data = (const char *)(uintptr_t)rt_string_data(value);
    if (rt_string_len(value) != len || !data) return 0;
    for (int64_t i = 0; i < len; i++) {
        if (data[i] != expected[i]) return 0;
    }
    return 1;
}

int main(void) {
    void *heap = mmap((void *)0x87000000ULL, 0x01000000ULL,
        PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED,
        -1, 0);
    if (heap == MAP_FAILED) return 1;

    Value hello = rt_string_new_literal((Value)(uintptr_t)"hello", 5);
    Value one = rt_string_char_at(hello, 1);
    Value old = rt_string_new_literal((Value)(uintptr_t)"ll", 2);
    Value replacement = rt_string_new_literal((Value)(uintptr_t)"y", 1);
    Value replaced = rt_string_replace(hello, old, replacement);
    if (!same_text(one, "e", 1) || !same_text(replaced, "heyo", 4)) return 2;
    if (rt_text_validate_utf8(hello) != 1) return 3;

    Value array = rt_array_new(2);
    if (!rt_array_push(array, 8) || !rt_array_push(array, 16)) return 4;
    Value copy = rt_array_copy(array);
    if (!rt_array_push(array, 24) || rt_array_len(copy) != 2) return 5;
    if (rt_array_get(copy, 0) != 8 || rt_array_get(copy, 8) != 16) return 6;

    Value dict = rt_dict_new(0);
    if (!rt_dict_set(dict, hello, 40) || rt_dict_get(dict, hello) != 40) return 7;
    if (rt_array_len(rt_dict_keys(dict)) != 1) return 8;
    if (!rt_dict_remove(dict, hello) || rt_dict_get(dict, hello) != 3) return 9;
    return 0;
}
EOF

(
    cd "$tmp"
    cc -std=gnu11 -ffunction-sections -fdata-sections \
        -DSIMPLE_RUNTIME_NO_ENTRY=1 -DSIMPLE_RUNTIME_NO_WEAK_HEAP=1 \
        "$root/src/os/kernel/arch/riscv64/boot/freestanding_runtime.c" \
        runtime-value-selfcheck.c -Wl,--gc-sections -o runtime-value-selfcheck
    ./runtime-value-selfcheck
)

cat >"$tmp/expected-instructions" <<'EOF'
c.mv	a7,a0
c.mv	a0,a1
c.mv	a1,a2
c.mv	a2,a3
c.mv	a3,a4
c.mv	a4,a5
c.mv	a5,a6
ecall
c.jr	ra
EOF

check_syscall_instructions() {
    object=$1
    output=$2
    riscv64-unknown-elf-objdump -d -M no-aliases "$object" |
        awk '
            /<rt_riscv64_syscall>:/ { body = 1; next }
            body && /<[A-Za-z0-9_]+>:/ { exit }
            body && /^[[:space:]]*[0-9a-f]+:/ {
                if (NF >= 4) {
                    print $3 "\t" $4
                } else {
                    print $3
                }
            }
        ' >"$output"
    diff -u "$tmp/expected-instructions" "$output"
}

check_syscall_instructions "$tmp/runtime.o" "$tmp/runtime-instructions"
check_syscall_instructions "$tmp/gui-runtime.o" "$tmp/gui-runtime-instructions"

grep -Fq "extern fn rt_riscv64_syscall(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "rt_riscv64_syscall(id, arg0, arg1, arg2, arg3, arg4, arg5)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "fn syscall6(id: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "_syscall6(id, arg0, arg1, arg2, arg3, arg4, 0)" \
    "$root/src/os/userlib/syscall_raw.spl"
grep -Fq "syscall6(13, path_ptr, path_len, argv_ptr, envp_ptr, argv_table, envp_table)" \
    "$root/src/os/userlib/process.spl"
! grep -Fq "arg5: u64 = 0" "$root/src/os/userlib/syscall_raw.spl"
! sed -n '/@cfg(riscv64)/,/@cfg(riscv32)/p' \
    "$root/src/os/userlib/syscall_raw.spl" | grep -Fq "asm volatile"

echo "PASS: RV64 syscall ABI contract"
