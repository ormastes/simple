extern fn rt_file_read_text(path: text) -> text

describe "SimpleOS target-side filesystem listing contract":
    it "walks shared RISC-V FAT dirents rather than printing a fixed catalog":
        val source = rt_file_read_text("examples/09_embedded/simple_os/arch/common/riscv_common.h") ?? ""
        expect(source).to_contain("RuntimeValue rt_riscv_fs_ls_sys_apps(void)")
        expect(source).to_contain("fat32_find_entry_cluster(&fat, sys, \"APPS       \", 1, 0)")
        expect(source).to_contain("const unsigned char *e = data + off")
        expect(source).to_contain("fat32_serial_name83(e)")
        expect(source).to_contain("cluster = fat32_next_cluster(&fat, cluster)")
        expect(source).to_contain("FS_LS_END status=pass")

    it "walks ARM32 FAT dirents rather than printing a fixed catalog":
        val source = rt_file_read_text("examples/09_embedded/simple_os/arch/arm32/boot/baremetal_stubs.c") ?? ""
        expect(source).to_contain("RuntimeValue rt_arm32_fs_ls_sys_apps(void)")
        expect(source).to_contain("arm32_fat32_find_entry(&fat, sys, \"APPS       \", 1, 0)")
        expect(source).to_contain("const uint8_t *e = data + off")
        expect(source).to_contain("arm32_fat32_serial_name83(e)")
        expect(source).to_contain("cluster = arm32_fat32_next_cluster(&fat, cluster)")
        expect(source).to_contain("FS_LS_END status=pass")

    it "makes listing evidence mandatory for the three live descriptors":
        val source = rt_file_read_text("src/os/qemu_systest_contract.spl") ?? ""
        expect(source).to_contain("pub fn riscv64_markers()")
        expect(source).to_contain("pub fn riscv32_markers()")
        expect(source).to_contain("pub fn arm32_markers()")
        expect(source).to_contain("FS_LS_BEGIN path=/SYS/APPS")
        expect(source).to_contain("FS_PROGRAM_END rc=37 reaped=true")

    it "walks x86_64 FAT dirents through the canonical NVMe owner":
        val source = rt_file_read_text("examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c") ?? ""
        expect(source).to_contain("int64_t rt_x86_64_fs_ls_sys_apps(void)")
        expect(source).to_contain("_fat32_find_path(\"/SYS/APPS\"")
        expect(source).to_contain("const uint8_t *entry = dir_buf + i * 32U")
        expect(source).to_contain("_fat32_serial_name83(entry)")
        expect(source).to_contain("cluster = _fat32_next_cluster(cluster)")
        expect(source).to_contain("FS_LS_END status=pass")

    it "makes listing evidence mandatory for x86_64":
        val source = rt_file_read_text("src/os/qemu_systest_contract.spl") ?? ""
        expect(source).to_contain("pub fn x86_64_markers()")
        expect(source).to_contain("FS_LS_BEGIN path=/SYS/APPS")
        expect(source).to_contain("FS_PROGRAM_BEGIN path=/FSEXEC.ELF arch=x86_64")
        expect(source).to_contain("SIMPLEOS_FS_EXEC_OK arch=x86_64 nonce=")
        expect(source).to_contain("FS_PROGRAM_END rc=37 reaped=true")
