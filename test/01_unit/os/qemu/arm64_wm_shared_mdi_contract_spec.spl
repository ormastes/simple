# @cover src/os/compositor/shared_mdi_setup.spl 80%
# @cover examples/09_embedded/simple_os/arch/arm64/wm_shared_mdi_contract.spl 80%

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}
use os.compositor.shared_mdi_setup.{shared_mdi_arm64_evidence}

describe "ARM64 QEMU WM shared MDI contract":

    it "reports the canonical shared MDI model and QEMU framebuffer backend":
        val evidence = shared_mdi_arm64_evidence(320, 240)
        expect(evidence.surface_count).to_equal(5)
        expect(evidence.first_title).to_equal("Terminal")
        expect(evidence.focused_title).to_equal("Calculator")
        expect(evidence.simple_web_surface_count).to_equal(5)
        expect(evidence.renderer_path).to_equal("shared_mdi_framebuffer_scene")
        expect(evidence.backend_kind).to_equal("qemu-aarch64-hvf-framebuffer-cpu-simd")
        expect(evidence.readback_status).to_equal("qmp-screendump-required")

    it "keeps examples/09_embedded arm64 wm_shared_mdi_contract in parity with shared_mdi_setup":
        val contract_src = file_read("examples/09_embedded/simple_os/arch/arm64/wm_shared_mdi_contract.spl")
        expect(contract_src).to_contain("use os.compositor.shared_mdi_setup.\{shared_mdi_surfaces}")
        expect(contract_src).to_contain("qemu-aarch64-hvf-framebuffer-cpu-simd")
        expect(contract_src).to_contain("qmp-screendump-required")
        expect(contract_src).to_contain("shared_mdi_framebuffer_scene")
        expect(contract_src).to_contain("first_title: \"Terminal\"")
        expect(contract_src).to_contain("focused_title: \"Calculator\"")
