#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
runtime="$root/examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c"
entry="$root/examples/09_embedded/simple_os/arch/x86_32/initrd_fs_exec_probe_entry.spl"
descriptor="$root/src/os/qemu_systest_contract.spl"
image="${X86_32_FAT_IMAGE:-$root/build/os/fat32-x86_32.img}"
grep -q 'rt_x86_32_fs_ls_sys_apps' "$entry"
grep -q 'FS_LS_BEGIN path=/SYS/APPS' "$runtime"
grep -q 'FS_LS_ENTRY name=' "$runtime"
grep -q 'FS_LS_END status=pass' "$runtime"
grep -q 'entries == 0U' "$runtime"
grep -q 'budget < 128U' "$runtime"
grep -q 'cluster >= 2U && cluster < 0x0ffffff8U) return 0;' "$runtime"
grep -A8 'pub fn x86_32_markers' "$descriptor" | grep -q 'FS_LS_END status=pass'
perl - "$image" <<'PERL'
use strict; use warnings;
my $p=shift; open my $f,'<:raw',$p or die $!; local $/; my $d=<$f>;
sub u16 { unpack('v',substr($d,$_[0],2)) } sub u32 { unpack('V',substr($d,$_[0],4)) }
my $bps=u16(11); my $spc=ord(substr($d,13,1)); my $r=u16(14); my $nf=ord(substr($d,16,1)); my $fs=u32(36); my $root=u32(44);
die "bad FAT geometry\n" unless $bps==512 && $spc>0 && $spc<=128 && $root>=2;
my $fat=$r*$bps; my $data=($r+$nf*$fs)*$bps; my $cs=$bps*$spc;
sub nextc { u32($fat+$_[0]*4)&0x0fffffff }
sub entries { my($c)=@_; my @e; my $budget=128; while($c>=2&&$c<0x0ffffff8&&$budget--){ my $b=substr($d,$data+($c-2)*$cs,$cs); for(my $o=0;$o+32<=length$b;$o+=32){my $x=substr($b,$o,32); return @e if ord(substr($x,0,1))==0; push @e,$x unless ord(substr($x,0,1))==0xe5||ord(substr($x,11,1))==0x0f;} $c=nextc($c) } return @e }
sub dir { my($c,$n)=@_; for(entries($c)){next unless substr($_,0,11) eq $n && (ord(substr($_,11,1))&0x10); return (u16_from($_,20)<<16)|u16_from($_,26)} die "missing $n\n" }
sub u16_from { unpack('v',substr($_[0],$_[1],2)) }
my $sys=dir($root,'SYS        '); my $apps=dir($sys,'APPS       '); my @e=grep { ord(substr($_,0,1))!=0x2e && !(ord(substr($_,11,1))&0x08) } entries($apps);
die "empty APPS listing\n" unless @e; print "PASS x86_32 FAT listing root=$root sys=$sys apps=$apps entries=".scalar(@e)."\n";
PERL
