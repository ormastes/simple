# Guard architecture-neutral consumers against bypassing the public HAL.

use std.spec
use std.io_runtime.{file_read}

val AUDIO_PATH: text = "src/os/services/audio/audio_service.spl"
val LOADER_PATH: text = "src/os/kernel/loader/x86_64_fs_exec_ring3.spl"
val INPUT_PATH: text = "src/os/compositor/arm64_virtio_input_backend.spl"
val HAL_PATH: text = "src/os/kernel/arch/hal.spl"

fn has_direct_family_import(source: text) -> bool:
    for family in ["x86_64", "x86_32", "arm64", "arm32", "riscv64", "riscv32"]:
        if source.contains("use os.kernel.arch." + family + "."):
            return true
    false

describe "architecture consumers use public HAL boundaries":
    """Concrete architecture leaves may be referenced only behind arch/hal.spl
    or arch_adapt/; these consumers bind exclusively to public hal_* calls."""

    it "routes x86 audio interrupt and console operations through hal functions":
        val source = file_read(AUDIO_PATH)
        expect_not(has_direct_family_import(source))
        assert_true(source.contains("hal_console_writeln"))
        assert_true(source.contains("hal_interrupt_acknowledge"))
        assert_true(source.contains("hal_interrupt_clear_handler"))

    it "routes x86 user entry through the HAL context handoff":
        val source = file_read(LOADER_PATH)
        expect_not(has_direct_family_import(source))
        assert_true(source.contains("hal_context_enter_user_task(ctx, space.phys_root)"))

    it "routes ARM64 VirtIO input polling through the HAL producer surface":
        val source = file_read(INPUT_PATH)
        expect_not(has_direct_family_import(source))
        assert_true(source.contains("hal_virtio_input_poll"))
        assert_true(source.contains("hal_virtio_input_ready"))

    it "keeps raw input and user-entry hooks behind hal adapters":
        val source = file_read(HAL_PATH)
        assert_true(source.contains("fn hal_context_enter_user_task"))
        assert_true(source.contains("fn hal_virtio_input_poll"))
        expect_not(source.contains("extern fn rt_"))
