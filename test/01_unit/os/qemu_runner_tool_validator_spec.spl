"""QEMU desktop UEFI disk image tool-app validator command contract."""

use std.spec.{describe, it, expect, step}
use os.qemu_runner.{desktop_uefi_disk_image_tool_app_validation_command}

fn expect_tool_app_validation_reference(cmd: text, app_name: text, app_path: text):
    val img_path = "build/os/fat32-x86_64.img"
    expect(cmd).to_contain("::/SYS/APPS/{app_name}")
    expect(cmd).to_contain("::/SYS/APPS/{app_name}.smf")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name} 2>/dev/null | strings | grep -q '{app_path}'")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name}.smf 2>/dev/null | strings | grep -q '{app_path}'")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name}.smf 2>/dev/null | grep -a -q 'SMF'")

describe "QEMU UEFI disk image tool-app validator":
    it "requires FAT mdir and mtype verification for all staged desktop tool apps":
        step("Validate generated FAT32 inspection commands for each migrated app and SMF binary")
        val img_path = "build/os/fat32-x86_64.img"
        val cmd = desktop_uefi_disk_image_tool_app_validation_command(img_path)
        expect_tool_app_validation_reference(cmd, "simple_browser", "/sys/apps/simple_browser")
        expect_tool_app_validation_reference(cmd, "smux", "/sys/apps/smux")
        expect_tool_app_validation_reference(cmd, "simple_compiler", "/sys/apps/simple_compiler")
        expect_tool_app_validation_reference(cmd, "simple_interpreter", "/sys/apps/simple_interpreter")
        expect_tool_app_validation_reference(cmd, "simple_loader", "/sys/apps/simple_loader")
        expect_tool_app_validation_reference(cmd, "llvm", "/sys/apps/llvm")
        expect_tool_app_validation_reference(cmd, "clang", "/sys/apps/clang")
        expect_tool_app_validation_reference(cmd, "rust", "/sys/apps/rust")

    it "requires toolchain manifest, hello proof, and CLI catalog entries inside FAT32":
        step("Check standalone toolchain proofs and SIMPLECLI.CAT enforcement in validator command")
        val img_path = "build/os/fat32-x86_64.img"
        val cmd = desktop_uefi_disk_image_tool_app_validation_command(img_path)
        expect(cmd).to_contain("mdir -i \"{img_path}\" ::/SYS/APPS/SIMPLECLI.CAT")
        expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/SIMPLECLI.CAT 2>/dev/null | grep -q '^info|src/app/info/main.spl|smoke|staged$'")
        expect(cmd).to_contain("mdir -i \"{img_path}\" ::/SYS/LLVMVER.TXT")
        expect(cmd).to_contain("mdir -i \"{img_path}\" ::/SYS/CLANGVER.TXT")
        expect(cmd).to_contain("mdir -i \"{img_path}\" ::/SYS/RUSTVER.TXT")
        expect(cmd).to_contain("mtype -i \"{img_path}\" ::/usr/share/simpleos/toolchain/llvm/hello.ll 2>/dev/null | grep -q 'source_filename'")
        expect(cmd).to_contain("mtype -i \"{img_path}\" ::/usr/share/simpleos/toolchain/clang/hello.c 2>/dev/null | grep -q 'hello from simpleos clang'")
        expect(cmd).to_contain("mtype -i \"{img_path}\" ::/usr/share/simpleos/toolchain/rust/hello.rs 2>/dev/null | grep -q 'fn main'")
