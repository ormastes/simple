"""CLI inspection must describe the mode an operator requested."""
use std.spec.{describe, it, expect, step}
use os.cli.{simpleos_run_inspection_error_v1}

describe "Sealed CLI inspection mode consistency":
    it "refuses debug GUI inspection for the default and every represented named route":
        # @req: REQ-014 REQ-016
        """I receive an explicit refusal when the requested GUI mode has no
        sealed projection, instead of inspecting a different command."""
        step("Combine each sealed route with an unrepresented GUI inspection mode")
        for route in ["--arch=x86_64", "--scenario=x86_64-q35-pure-nvme-perf", "--scenario=x86_32-initrd-fat32-smf", "--scenario=riscv64-virtio-fat32-smf", "--scenario=riscv32-virtio-fat32-smf"]:
            for inspection in ["--show-plan", "--print-command"]:
                expect(simpleos_run_inspection_error_v1([route, inspection, "--debug-gui"])).to_equal(
                    "Error: --debug-gui inspection is unavailable: its command shape has no sealed projection")

    it "preserves mutually exclusive inspection and ordinary execution modes":
        # @req: REQ-014 REQ-016
        step("Keep the established ambiguity diagnostic and represented modes")
        expect(simpleos_run_inspection_error_v1(["--show-plan", "--print-command"])).to_equal(
            "Error: --show-plan and --print-command are mutually exclusive")
        expect(simpleos_run_inspection_error_v1(["--show-plan"])).to_equal("")
        expect(simpleos_run_inspection_error_v1(["--print-command"])).to_equal("")
        expect(simpleos_run_inspection_error_v1(["--debug-gui"])).to_equal("")
        expect(simpleos_run_inspection_error_v1([])).to_equal("")
