"""
# @req REQ-SSPEC-OS
# @cover src/os/kernel/loader/artifact_manifest.spl
# @cover src/os/services/launcher/launcher_catalog_projection.spl
# @cover src/os/services/launcher/launcher_registry.spl
#
# Host unit specification for BF-9 Bug #12:
#   sci_launcher_policy_projection_owner_api_missing_2026-08-14
#
# Verifies manifest_project_scoped_capabilities_v1 boundary containment,
# fail-closed unconfigured launch ceilings, atomic SCI catalog projection/
# rollback, and launcher_bind_process_app_id_v1 process identity binding.
"""

use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.composition.{parse_composition_source_v1, encode_composition_image_v1, decode_composition_image_v1}
use os.kernel.types.capability_types.{CAP_RIGHT_READ, CAP_RIGHT_WRITE}
use os.kernel.loader.artifact_manifest.{
    manifest_for_kind,
    manifest_kind_smf,
    manifest_parse_scoped_capability_v1,
    manifest_project_scoped_capabilities_v1
}
use os.services.launcher.launcher.{launcher_init}
use os.services.launcher.launcher_composition.{launcher_load_composition_bytes_v1, composition_app_ids_v1}
use os.services.launcher.launcher_catalog_projection.{
    launcher_composition_projection_active_v1,
    launcher_composition_app_slot_v1,
    launcher_composition_app_id_for_name_v1
}
use os.services.launcher.launcher_app_launch_wire.{encode_launcher_app_launch_v1}
use os.services.launcher.launcher_app_launch_consumer.{
    SCI_APP_LAUNCH_OK,
    SCI_APP_LAUNCH_SCOPED_CAPABILITY_REQUIRED,
    launcher_validate_app_launch_arena_v1
}
use os.services.launcher.launcher_registry.{
    app_count,
    _app_index_by_name,
    launcher_record_process,
    launcher_bind_process_app_id_v1,
    launcher_process_app_id_v1,
    launcher_configure_scoped_capability_ceiling_v1,
    launcher_app_scoped_capabilities_v1,
    launcher_app_capability_mask_v1
}

fn _compile_sci(source: text):
    match parse_composition_source_v1(source):
        case Err(_): decode_composition_image_v1([]).image
        case Ok(parsed): decode_composition_image_v1(encode_composition_image_v1(parsed)).image

describe "SimpleOS SCI launcher typed policy projection and atomic catalog":
    it "projects scoped capabilities within manifest/scope ceilings and rejects escapes":
        step("verify manifest_project_scoped_capabilities_v1 allows prefix subsets and rejects sibling escapes")
        val smf = manifest_for_kind(manifest_kind_smf())
        val ceil_read = manifest_parse_scoped_capability_v1("FileRead(/srv/notes)")
        expect(ceil_read.ok).to_equal(true)
        val ok_proj = manifest_project_scoped_capabilities_v1(
            smf, ["FileRead(/srv/notes/daily)"], [ceil_read.capability]
        )
        expect(ok_proj.ok).to_equal(true)
        expect(ok_proj.projected.len()).to_equal(1u64)
        expect(ok_proj.projected_mask).to_equal(CAP_RIGHT_READ)

        val escape_proj = manifest_project_scoped_capabilities_v1(
            smf, ["FileRead(/srv/notes_other)"], [ceil_read.capability]
        )
        expect(escape_proj.ok).to_equal(false)
        expect(escape_proj.reason).to_equal("capability_exceeds_scope_ceiling")

    it "fails closed for unconfigured app ceilings and prevents rollback state drift":
        step("load valid catalog, reject over-privileged reload, and assert atomic preservation")
        launcher_init()
        val unconfigured = _compile_sci("schema: simple.composition/1\napps:\n  - id: unconf-app\n    name: Unconf\n    artifact: /sys/apps/unconf.smf\n    capabilities: [FileRead(/home)]\n")
        val unconf_res = launcher_load_composition_bytes_v1(unconfigured.bytes)
        expect(unconf_res.ok).to_equal(false)
        expect(unconf_res.code).to_equal("SCI_LAUNCHER_MANIFEST_CAPABILITY_PROJECTION_REQUIRED")

        expect(launcher_configure_scoped_capability_ceiling_v1("bf9-notes", ["FileRead(/home)", "FileWrite(/home)"])).to_equal(true)
        val valid = _compile_sci("schema: simple.composition/1\napps:\n  - id: bf9-notes\n    name: BF9 Notes\n    artifact: /sys/apps/bf9_notes.smf\n    capabilities: [FileRead(/home/user)]\n")
        val load_ok = launcher_load_composition_bytes_v1(valid.bytes)
        expect(load_ok.ok).to_equal(true)
        expect(launcher_composition_projection_active_v1()).to_equal(true)
        expect(launcher_app_scoped_capabilities_v1("bf9-notes")).to_contain("FileRead(/home/user)")
        expect(launcher_app_capability_mask_v1("bf9-notes")).to_equal(CAP_RIGHT_READ)
        expect(launcher_composition_app_id_for_name_v1("BF9 Notes")).to_equal("bf9-notes")

        val snap_count = app_count
        val escalated = _compile_sci("schema: simple.composition/1\napps:\n  - id: bf9-notes\n    name: BF9 Escalated\n    artifact: /sys/apps/bf9_notes.smf\n    capabilities: [FileWrite(/etc)]\n")
        val esc_res = launcher_load_composition_bytes_v1(escalated.bytes)
        expect(esc_res.ok).to_equal(false)
        expect(esc_res.code).to_equal("SCI_LAUNCHER_CAPABILITY_EXCEEDS_CEILING")
        expect(app_count).to_equal(snap_count)
        expect(_app_index_by_name("BF9 Notes") >= 0).to_equal(true)

    it "binds PIDs atomically across catalog replacement and validates launch arena masks":
        step("bind process to app_id, swap catalog display name, and gate launch arena words")
        launcher_init()
        expect(launcher_configure_scoped_capability_ceiling_v1("bf9-edit", ["FileRead(/home)"])).to_equal(true)
        val v1 = _compile_sci("schema: simple.composition/1\napps:\n  - id: bf9-edit\n    name: Editor V1\n    artifact: /sys/apps/edit1.smf\n    capabilities: [FileRead(/home)]\n")
        expect(launcher_load_composition_bytes_v1(v1.bytes).ok).to_equal(true)
        val slot = launcher_composition_app_slot_v1("bf9-edit")
        expect(launcher_record_process(6201u64, slot, "running", 0, 0u64, true)).to_equal(true)
        expect(launcher_bind_process_app_id_v1(6201u64, "bf9-edit")).to_equal(true)
        expect(launcher_process_app_id_v1(6201u64)).to_equal("bf9-edit")

        val ok_wire = encode_launcher_app_launch_v1("bf9-edit", "/sys/apps/edit1.smf", "launch", [], [CAP_RIGHT_READ.to_u64()])
        val ok_plan = launcher_validate_app_launch_arena_v1(ok_wire.bytes)
        expect(ok_plan.ok).to_equal(true)
        expect(ok_plan.status).to_equal(SCI_APP_LAUNCH_OK)

        val bad_wire = encode_launcher_app_launch_v1("bf9-edit", "/sys/apps/edit1.smf", "launch", [], [(CAP_RIGHT_READ | CAP_RIGHT_WRITE).to_u64()])
        val bad_plan = launcher_validate_app_launch_arena_v1(bad_wire.bytes)
        expect(bad_plan.ok).to_equal(false)
        expect(bad_plan.status).to_equal(SCI_APP_LAUNCH_SCOPED_CAPABILITY_REQUIRED)
