"""
# @req REQ-SSPEC-OS
# @cover src/os/kernel/loader/x86_64_fs_exec_spawn.spl
# @cover src/os/kernel/abi/syscall_shim_process.spl
# @cover src/os/kernel/abi/syscall_shim_file.spl
#
# Host unit specification for BF-9 Bug #4:
#   fs_exec_ring3_fork_unreachable_spawnwait_2026-08-06
#
# Verifies fail-closed unauthenticated path spawn (-13 EACCES, not -38 ENOSYS),
# live spl_handle_spawn_binary state threading, and state-threaded fork +
# waitpid(WNOHANG) child parent visibility through Scheduler and C-ABI shims.
"""

use std.spec.{describe, it, expect}
use std.spec.step
use os.kernel.loader.x86_64_fs_exec_spawn.{x86_64_fs_exec_spawn}
use os.kernel.abi.syscall_shim.{g_shim_scheduler, shim_init}
use os.kernel.abi.syscall_shim_process.{spl_handle_spawn_binary}
use os.kernel.abi.syscall_shim_file.{spl_handle_waitpid}
use os.kernel.ipc.syscall_process.{_handle_fork_state, _handle_waitpid_state}
use os.kernel.types.syscall_types.{SyscallArgs}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.log.klog.{KernelLog}
use os.kernel.types.task_types.{TaskId}
use os.kernel.loader.executable_source.{_set_synthetic_vfs_file_for_test, _clear_synthetic_vfs_for_test}
use os.posix.fd_table.{fd_table_init}

extern fn rt_string_data(s: text) -> i64

fn _push_u16_le(buf: [u8], value: i64) -> [u8]:
    var out = buf
    out.push((value & 0xFF).to_u8())
    out.push(((value >> 8) & 0xFF).to_u8())
    out

fn _push_u32_le(buf: [u8], value: i64) -> [u8]:
    var out = buf
    out.push((value & 0xFF).to_u8())
    out.push(((value >> 8) & 0xFF).to_u8())
    out.push(((value >> 16) & 0xFF).to_u8())
    out.push(((value >> 24) & 0xFF).to_u8())
    out

fn _push_u64_le(buf: [u8], value: i64) -> [u8]:
    var out = buf
    out = _push_u32_le(out, value & 0xFFFFFFFF)
    out = _push_u32_le(out, (value >> 32) & 0xFFFFFFFF)
    out

fn _make_x86_64_exec() -> [u8]:
    var bytes: [u8] = []
    bytes.push(0x7Fu8)
    bytes.push(0x45u8)
    bytes.push(0x4Cu8)
    bytes.push(0x46u8)
    bytes.push(2u8)
    bytes.push(1u8)
    bytes.push(1u8)
    while bytes.len() < 16:
        bytes.push(0u8)
    bytes = _push_u16_le(bytes, 2)
    bytes = _push_u16_le(bytes, 62)
    bytes = _push_u32_le(bytes, 1)
    bytes = _push_u64_le(bytes, 0x400000)
    bytes = _push_u64_le(bytes, 64)
    bytes = _push_u64_le(bytes, 0)
    bytes = _push_u32_le(bytes, 0)
    bytes = _push_u16_le(bytes, 64)
    bytes = _push_u16_le(bytes, 56)
    bytes = _push_u16_le(bytes, 1)
    bytes = _push_u16_le(bytes, 0)
    bytes = _push_u16_le(bytes, 0)
    bytes = _push_u16_le(bytes, 0)
    bytes = _push_u32_le(bytes, 1)
    bytes = _push_u32_le(bytes, 5)
    bytes = _push_u64_le(bytes, 0x1000)
    bytes = _push_u64_le(bytes, 0x400000)
    bytes = _push_u64_le(bytes, 0x400000)
    bytes = _push_u64_le(bytes, 4)
    bytes = _push_u64_le(bytes, 4)
    bytes = _push_u64_le(bytes, 0x1000)
    while bytes.len() < 0x1004:
        bytes.push(0x90u8)
    bytes

fn _zero_args(id: u64, arg0: u64, arg1: u64, arg2: u64) -> SyscallArgs:
    SyscallArgs(id: id, arg0: arg0, arg1: arg1, arg2: arg2, arg3: 0u64, arg4: 0u64, arg5: 0u64)

describe "SimpleOS ring-3 fork/waitpid and authenticated spawn contract":
    it "fails closed with EACCES (-13) on unauthenticated x86_64 path spawn":
        step("verify path-only x86_64_fs_exec_spawn rejects without ENOSYS (-38)")
        val rc = x86_64_fs_exec_spawn("/bin/unauth_probe", ["probe"], [])
        expect(rc).to_equal(-13)

    it "threads spawned task, forked child, and WNOHANG waitpid across Scheduler state":
        step("spawn parent via spl_handle_spawn_binary, schedule it, fork child, and poll WNOHANG")
        fd_table_init()
        val path = "/sys/apps/bf9_fork_probe"
        _clear_synthetic_vfs_for_test()
        _set_synthetic_vfs_file_for_test(path, _make_x86_64_exec())
        shim_init(Scheduler.new(), IpcManager.new(), KernelLog.new(16))

        val parent_pid = spl_handle_spawn_binary(
            rt_string_data(path) as u64, path.len() as u64, 2, 0, 0, 0
        )
        expect(parent_pid > 0).to_equal(true)
        var sched = g_shim_scheduler
        val _ctx = sched.schedule()
        expect(sched.get_current().id).to_equal(parent_pid as u64)

        val fork_state = _handle_fork_state(_zero_args(57u64, 0u64, 0u64, 0u64), sched)
        val child_pid = fork_state.result.value
        expect(child_pid > 0).to_equal(true)
        sched = fork_state.scheduler

        val child_tcb = sched.get_task(TaskId(id: child_pid as u64))
        expect(child_tcb).to_not_equal(nil)
        expect(child_tcb.unwrap().parent.unwrap().id).to_equal(parent_pid as u64)

        val wait_state = _handle_waitpid_state(
            _zero_args(61u64, child_pid as u64, 0u64, 1u64), sched
        )
        # Running child with WNOHANG yields 0 (not -10 ECHILD and not -38 ENOSYS)
        expect(wait_state.result.value).to_equal(0)

        # Unrelated child id cleanly returns ECHILD (-10) via C-ABI shim
        expect(spl_handle_waitpid(99999u64, 0u64, 1u64, 0u64, 0u64, 0u64)).to_equal(-10)
        _clear_synthetic_vfs_for_test()
