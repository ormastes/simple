# Structural dependency/operand regression. This does not execute instructions
# or admit a target's CMO capabilities; native object evidence is separate.
use std.spec.*
use std.io_runtime.{read_file_text}

describe "RV32 cache maintenance target provider":
    it "routes the actual HAL to the RV32 instruction owner without address widening":
        val source = read_file_text("src/os/kernel/arch/riscv32/hal_cache.spl")
        expect(source.contains("use os.kernel.arch.riscv32.cmo.")).to_equal(true)
        expect(source.contains("use std.nogc_async_mut_noalloc.baremetal.riscv.")).to_equal(false)
        expect(source.contains("cur as u64")).to_equal(false)
        for operation in ["cbo_flush", "cbo_clean", "cbo_inval"]:
            expect(source.contains(operation + "(cur)")).to_equal(true)

    it "keeps all address-bearing leaves XLEN32 and independent of the RV64 foreign ABI":
        val source = read_file_text("src/os/kernel/arch/riscv32/cmo.spl")
        expect(source.contains("extern fn")).to_equal(false)
        expect(source.contains("addr: u64")).to_equal(false)
        for operation in ["cbo_clean", "cbo_inval", "cbo_flush", "cbo_zero", "prefetch_r", "prefetch_w", "prefetch_i"]:
            expect(source.contains("fn " + operation + "(addr: u32)")).to_equal(true)
