"""Focused behavior for inspect-only QEMU CLI rendering."""
# codex-system-test
# @req: REQ-SIMPLEOS-QEMU-CLI-PLAN-001

use std.spec.{describe, it, expect, step}
use os.qemu_cli_plan_v1.{
    qemu_cli_executable_policy_matches_v1, qemu_cli_shell_display_v1
}

describe "REQ-SIMPLEOS-QEMU-CLI-PLAN-001: command inspection is shell-safe and inert [importance=high; importance_weight=2]":
    it "quotes every sealed argv atom without executing it":
        step("Render an executable and arguments containing spaces and shell metacharacters")
        val rendered = qemu_cli_shell_display_v1(
            "/opt/QEMU Tools/qemu-system-x86_64",
            ["-kernel", "build/os/guest's kernel.elf", "$(touch /tmp/must-not-run)"])

        step("Require single-atom quoting and the standard safe embedded-quote form")
        expect(rendered).to_equal(
            "'/opt/QEMU Tools/qemu-system-x86_64' '-kernel' " +
            "'build/os/guest'\"'\"'s kernel.elf' '$(touch /tmp/must-not-run)'")

    it "preserves argument order and empty arguments in the display only":
        step("Render ordered values including an empty atom")
        expect(qemu_cli_shell_display_v1("qemu-system-aarch64", ["-bios", "", "-S"])).to_equal(
            "'qemu-system-aarch64' '-bios' '' '-S'")

    it "rejects settings that resolve a different executable than the normal runner":
        step("Compare normalized executable identities without probing or launching")
        expect(qemu_cli_executable_policy_matches_v1(
            "/usr/bin/qemu-system-aarch64", "/usr/bin/qemu-system-aarch64")).to_equal(true)
        expect(qemu_cli_executable_policy_matches_v1(
            "C:\\QEMU\\qemu-system-aarch64.exe", "C:/QEMU/qemu-system-aarch64.exe")).to_equal(true)
        expect(qemu_cli_executable_policy_matches_v1(
            "/usr/bin/qemu-system-aarch64", "/opt/custom/qemu-system-aarch64")).to_equal(false)
