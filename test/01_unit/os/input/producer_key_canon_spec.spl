# @req: REQ-OS-INPUT-001

# @cover src/os/drivers/input/ps2_keyboard.spl 40%
# @tag: unit, os, input, key_code, cross_producer

# Cross-producer key-code equality, through the REAL producers.
#
# `test/01_unit/lib/common/ui/key_code_spec.spl` proves the four `*_to_canon`
# tables in `common.ui.key_code` are self-consistent. That is necessary and NOT
# sufficient: it never calls anything that runs on a live host. This spec closes
# that gap by driving the four functions the drivers and compositor backends
# actually execute --
#
#   * ps2_keyboard.scancode_to_key              (PS/2 scancode set 1)
#   * virtio_input_ops.evdev_key_to_key         (Linux evdev KEY_*)
#   * hosted_input_sdl2.sdl2_keysym_to_key      (SDL2 SDLK_* keysyms)
#   * hosted_input_backend._winit_keycode_to_key (winit virtual keycodes)
#
# -- through the one seam `ps2_keyboard.key_to_canon`, and comparing the result
# against an ABSOLUTE expected integer.
#
# WHY ABSOLUTE, NEVER MUTUAL: `_quad` renders all four answers into one string
# and compares it to `_all(expected)`. A producer that fails to recognise its
# raw code renders "0" (CANON_UNKNOWN) and fails the row, so four producers
# agreeing on "I don't know" cannot pass; and because `expected` is a literal
# VK integer, four producers being wrong the SAME way cannot pass either.
#
# This spec already earned its keep: it caught `_winit_keycode_to_key` having no
# arm for CapsLock or any OEM punctuation, so `,` `-` `/` `` ` `` were real keys
# on three hosts and no key at all on the fourth.

use std.spec
use os.drivers.input.ps2_keyboard.{
    Key, KeyEvent, Ps2Keyboard, key_to_canon, scancode_to_key
}
use common.ui.key_code.{canon_key_name}
use common.ui.host_input_event.{host_key_name}
use os.drivers.virtio.virtio_input_ops.{evdev_key_to_key}
use os.compositor.hosted_input_sdl2.{sdl2_keysym_to_key}
use os.compositor.hosted_input_backend.{_winit_keycode_to_key}

# The SDL2 and winit producers return `Key?`; nil means "unrecognised", which
# must render as CANON_UNKNOWN (0) so it fails a row rather than being skipped.
fn _canon_opt(k: Key?) -> i64:
    if val kk = k:
        return key_to_canon(kk)
    0

# Run one physical key through all four producers. PS/2 extended keys are passed
# as the combined `0xE000 | byte` value (Left = 0xE04B) -- a single byte cannot
# express them.
fn _quad(ps2: i64, evdev: i64, sdl: i64, winit: i64) -> text:
    key_to_canon(scancode_to_key(ps2)).to_text() + "," +
        key_to_canon(evdev_key_to_key(evdev.to_u16())).to_text() + "," +
        _canon_opt(sdl2_keysym_to_key(sdl)).to_text() + "," +
        _canon_opt(_winit_keycode_to_key(winit)).to_text()

fn _all(code: i64) -> text:
    code.to_text() + "," + code.to_text() + "," + code.to_text() + "," + code.to_text()

describe "every input producer maps a physical key to the same canonical code":

    it "agrees on letters":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on letters")
        expect(_quad(0x1E, 30, 97, 65)).to_equal(_all(65))    # A
        expect(_quad(0x32, 50, 109, 77)).to_equal(_all(77))   # M
        expect(_quad(0x10, 16, 113, 81)).to_equal(_all(81))   # Q
        expect(_quad(0x2C, 44, 122, 90)).to_equal(_all(90))   # Z

    it "agrees on digits":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on digits")
        expect(_quad(0x0B, 11, 48, 48)).to_equal(_all(48))    # 0
        expect(_quad(0x02, 2, 49, 49)).to_equal(_all(49))     # 1
        expect(_quad(0x06, 6, 53, 53)).to_equal(_all(53))     # 5
        expect(_quad(0x0A, 10, 57, 57)).to_equal(_all(57))    # 9

    it "agrees on Enter, Escape, Space, Backspace and Tab":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on Enter, Escape, Space, Backspace and Tab")
        expect(_quad(0x1C, 28, 13, 13)).to_equal(_all(13))
        expect(_quad(0x01, 1, 27, 27)).to_equal(_all(27))
        expect(_quad(0x39, 57, 32, 32)).to_equal(_all(32))
        expect(_quad(0x0E, 14, 8, 8)).to_equal(_all(8))
        expect(_quad(0x0F, 15, 9, 9)).to_equal(_all(9))

    it "agrees on the arrows, which are the highest-risk row":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on the arrows, which are the highest-risk row")
        # SDLK numbers the arrows RIGHT=..903 < LEFT=904 < DOWN=905 < UP=906,
        # i.e. out of VK order (LEFT=37 < UP=38 < RIGHT=39 < DOWN=40), and the
        # PS/2 arrows are E0-prefixed. A transposition here is silent in every
        # other test in the repo.
        expect(_quad(0xE04B, 105, 1073741904, 37)).to_equal(_all(37))  # Left
        expect(_quad(0xE048, 103, 1073741906, 38)).to_equal(_all(38))  # Up
        expect(_quad(0xE04D, 106, 1073741903, 39)).to_equal(_all(39))  # Right
        expect(_quad(0xE050, 108, 1073741905, 40)).to_equal(_all(40))  # Down

    it "agrees on the navigation cluster":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on the navigation cluster")
        expect(_quad(0xE047, 102, 1073741898, 36)).to_equal(_all(36))  # Home
        expect(_quad(0xE04F, 107, 1073741901, 35)).to_equal(_all(35))  # End
        expect(_quad(0xE049, 104, 1073741899, 33)).to_equal(_all(33))  # PageUp
        expect(_quad(0xE051, 109, 1073741902, 34)).to_equal(_all(34))  # PageDown
        expect(_quad(0xE052, 110, 1073741897, 45)).to_equal(_all(45))  # Insert
        expect(_quad(0xE053, 111, 127, 46)).to_equal(_all(46))         # Delete

    it "agrees on the modifiers, collapsing left and right to one code":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on the modifiers, collapsing left and right to one code")
        expect(_quad(0x2A, 42, 1073742049, 16)).to_equal(_all(16))     # Shift
        expect(_quad(0x1D, 29, 1073742048, 17)).to_equal(_all(17))     # Ctrl
        expect(_quad(0x38, 56, 1073742050, 18)).to_equal(_all(18))     # Alt
        expect(_quad(0x3A, 58, 1073741881, 20)).to_equal(_all(20))     # CapsLock

    it "collapses the RIGHT-hand modifiers onto the same canonical code":
        # @req: REQ-OS-INPUT-001
        step("Verify: collapses the RIGHT-hand modifiers onto the same canonical code")
        # Side is `HostInputEvent.mods` business, never `code`. Right Ctrl and
        # right Alt are E0-prefixed on PS/2 and separate keysyms on SDL2.
        expect(_quad(0x36, 54, 1073742053, 16)).to_equal(_all(16))     # RShift
        expect(_quad(0xE01D, 97, 1073742052, 17)).to_equal(_all(17))   # RCtrl
        expect(_quad(0xE038, 100, 1073742054, 18)).to_equal(_all(18))  # RAlt

    it "agrees on the function keys":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on the function keys")
        expect(_quad(0x3B, 59, 1073741882, 112)).to_equal(_all(112))   # F1
        expect(_quad(0x3F, 63, 1073741886, 116)).to_equal(_all(116))   # F5
        expect(_quad(0x57, 87, 1073741892, 122)).to_equal(_all(122))   # F11
        expect(_quad(0x58, 88, 1073741893, 123)).to_equal(_all(123))   # F12

    it "agrees on OEM punctuation":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees on OEM punctuation")
        expect(_quad(0x0C, 12, 45, 189)).to_equal(_all(189))   # -
        expect(_quad(0x0D, 13, 61, 187)).to_equal(_all(187))   # =
        expect(_quad(0x33, 51, 44, 188)).to_equal(_all(188))   # ,
        expect(_quad(0x34, 52, 46, 190)).to_equal(_all(190))   # .
        expect(_quad(0x35, 53, 47, 191)).to_equal(_all(191))   # /
        expect(_quad(0x29, 41, 96, 192)).to_equal(_all(192))   # `
        expect(_quad(0x27, 39, 59, 186)).to_equal(_all(186))   # ;
        expect(_quad(0x28, 40, 39, 222)).to_equal(_all(222))   # '
        expect(_quad(0x1A, 26, 91, 219)).to_equal(_all(219))   # [
        expect(_quad(0x1B, 27, 93, 221)).to_equal(_all(221))   # ]
        expect(_quad(0x2B, 43, 92, 220)).to_equal(_all(220))   # \

    it "reports an unmapped raw code as CANON_UNKNOWN, not as a guess":
        # @req: REQ-OS-INPUT-001
        step("Verify: reports an unmapped raw code as CANON_UNKNOWN, not as a guess")
        # Anti-vacuity: proves a producer CAN return 0, so the rows above are
        # not passing because every producer answers 0 for everything.
        expect(key_to_canon(scancode_to_key(0x7E))).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(key_to_canon(evdev_key_to_key(240.to_u16()))).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_canon_opt(sdl2_keysym_to_key(999999))).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_canon_opt(_winit_keycode_to_key(999999))).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "PS/2 decodes the extended (E0-prefixed) block end to end":

    it "decodes an E0-prefixed arrow press through the raw ring":
        # @req: REQ-OS-INPUT-001
        step("Verify: decodes an E0-prefixed arrow press through the raw ring")
        # 0xE0 arrives as its OWN byte. Without the `pending_e0` latch in
        # decode_pending every E0xx arm in scancode_to_key is unreachable and
        # the arrows decode to Key.Unknown -- which is what they did.
        val kbd = Ps2Keyboard.new()
        kbd.feed_raw_byte(0xE0)
        kbd.feed_raw_byte(0x4B)
        val ev = kbd.decode_pending()
        expect(ev).to_equal(KeyEvent.Press(key: Key.Left))

    it "keeps the E0 prefix across the break-code mask on release":
        # @req: REQ-OS-INPUT-001
        step("Verify: keeps the E0 prefix across the break-code mask on release")
        # `0xE0CB & 0x7F` is 0x4B, which unprefixed is keypad-4 (unmapped), NOT
        # Left. Masking the BYTE and re-adding the 0xE000 prefix is what keeps
        # the release of Left arrow from vanishing into Key.Unknown.
        val kbd = Ps2Keyboard.new()
        kbd.feed_raw_byte(0xE0)
        kbd.feed_raw_byte(0xCB)
        val ev = kbd.decode_pending()
        expect(ev).to_equal(KeyEvent.Release(key: Key.Left))

    it "does not let the E0 latch leak into the next unprefixed key":
        # @req: REQ-OS-INPUT-001
        step("Verify: does not let the E0 latch leak into the next unprefixed key")
        val kbd = Ps2Keyboard.new()
        kbd.feed_raw_byte(0xE0)
        kbd.feed_raw_byte(0x4B)
        kbd.decode_pending()
        # 0x1E unprefixed is A; 0xE01E is unmapped. A leaked latch would
        # therefore turn the next A press into Key.Unknown.
        kbd.feed_raw_byte(0x1E)
        expect(kbd.decode_pending()).to_equal(KeyEvent.Press(key: Key.A))

describe "host_key_name is an alias of canon_key_name, not a second table":

    it "returns the canonical name for every code the old local table handled":
        # @req: REQ-OS-INPUT-001
        step("Verify: returns the canonical name for every code the old local table handled")
        expect(host_key_name(8)).to_equal("backspace")
        expect(host_key_name(9)).to_equal("tab")
        expect(host_key_name(13)).to_equal("enter")
        expect(host_key_name(27)).to_equal("escape")
        expect(host_key_name(32)).to_equal("space")
        expect(host_key_name(35)).to_equal("end")
        expect(host_key_name(36)).to_equal("home")
        expect(host_key_name(37)).to_equal("left")
        expect(host_key_name(38)).to_equal("up")
        expect(host_key_name(39)).to_equal("right")
        expect(host_key_name(40)).to_equal("down")
        expect(host_key_name(46)).to_equal("delete")

    it "agrees with canon_key_name on every code, including the widened ones":
        # @req: REQ-OS-INPUT-001
        step("Verify: agrees with canon_key_name on every code, including the widened ones")
        expect(host_key_name(16)).to_equal(canon_key_name(16))
        expect(host_key_name(20)).to_equal(canon_key_name(20))
        expect(host_key_name(116)).to_equal(canon_key_name(116))
        expect(host_key_name(65)).to_equal(canon_key_name(65))
        expect(host_key_name(999)).to_equal(canon_key_name(999))

    it "keeps 10 (LF) mapping to enter even though it is not a VK code":
        # @req: REQ-OS-INPUT-001
        step("Verify: keeps 10 (LF) mapping to enter even though it is not a VK code")
        # Legacy producers emit 10 for Enter. canon_key_name correctly does not
        # know it (10 is not a Windows VK); the ingress alias keeps the
        # pre-check so those producers do not silently regress to "".
        expect(host_key_name(10)).to_equal("enter")
        expect(canon_key_name(10)).to_equal("")
