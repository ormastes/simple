#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
source_file="$repo_root/src/os/port/qemu_lane_wiring_v1.spl"

if [ ! -f "$source_file" ]; then
    echo "qemu lane wiring source is missing: $source_file" >&2
    exit 1
fi

grep_status=0
grep -Eq '(^|[[:space:]])(val|var|for)[[:space:]]+namespace([[:space:]=]|$)' "$source_file" || grep_status=$?
if [ "$grep_status" -eq 0 ]; then
    echo "reserved identifier 'namespace' is used as a local binding in $source_file" >&2
    exit 1
fi
if [ "$grep_status" -ne 1 ]; then
    echo "failed to inspect qemu lane wiring source: $source_file" >&2
    exit "$grep_status"
fi

echo "qemu lane wiring reserved-identifier check: PASS"
