"""
dynSMF facet-reference count invariant.

The count is session-owned scalar state so hot facet admission does not
materialize every issued-token key merely to enforce its safety bound.
"""

use std.spec.step
use os.smf.dynsmf_session.{
    DynSmfSession, dynsmf_policy_default, dynsmf_session_new,
    dynsmf_session_issued_facet_ref_count
}

describe "dynSMF facet reference count":
    it "starts at zero for a new session":
        # @req NFR-DYNSMF-FACET-COUNT-001
        step("create an empty dynSMF session")
        val session = dynsmf_session_new("count-empty", dynsmf_policy_default())
        expect(dynsmf_session_issued_facet_ref_count(session)).to_equal(0)

    it "reports the scalar owner without enumerating token keys":
        # @req NFR-DYNSMF-FACET-COUNT-002
        step("construct retained session state with an explicit admitted count")
        val session = DynSmfSession(
            session_id: "count-observed", generation: 1, next_handle: 100,
            policy: dynsmf_policy_default(), loaded: [], evidence: [],
            _next_facet_token: 4, _issued_facet_refs: {},
            _issued_facet_tokens_by_library: {},
            _issued_facet_ref_count: 3, _trusted_facet_bindings: {},
            _trusted_facet_keys_by_library: {})
        expect(dynsmf_session_issued_facet_ref_count(session)).to_equal(3)
