"""
## Purpose and audience
Purpose: admits native or SMF evidence only after all checks and callable proof
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-ProvLoad-001

use os.smf.provider_loader.{
    PROVIDER_ADMISSION_OK,
    PROVIDER_ADMISSION_PATH_DENIED,
    PROVIDER_ADMISSION_DIGEST_MISMATCH,
    PROVIDER_ADMISSION_CAPABILITY_DENIED,
    PROVIDER_ADMISSION_HOST_ABI_UNSUPPORTED,
    PROVIDER_ADMISSION_INTERFACE_UNSUPPORTED,
    PROVIDER_ADMISSION_LOAD_FAILED,
    PROVIDER_ADMISSION_QUERY_SYMBOL_MISSING,
    PROVIDER_ADMISSION_NOT_PROCESS_CALLABLE,
    ProviderAdmissionRequestV1,
    ProviderCallableEvidenceV1,
    provider_artifact_digest_v1,
    PROVIDER_SESSION_NOT_OPEN,
    PROVIDER_SESSION_PIN_UNKNOWN,
    ProviderLoaderSessionV1,
    provider_admit_evidence_v1,
    provider_session_query_v1,
    provider_session_release_v1,
    provider_session_close_v1
}
use os.posix.dynlib.{DynLibKind}
use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_QUERY_V1_SIZE,
    SimpleProviderQueryV1
}
use os.smf.provider_activation.{
    PROVIDER_ACTIVATION_NOT_ADMITTED,
    PROVIDER_ACTIVATION_QUERY_BRIDGE_UNAVAILABLE,
    PROVIDER_ACTIVATION_BLOCKER,
    provider_activate_admitted_v1
}

fn request_v1() -> ProviderAdmissionRequestV1:
    ProviderAdmissionRequestV1(
        artifact_path: "build/providers/fmt_tool.smf",
        artifact_kind: "smf",
        expected_artifact_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        granted_capability_bits: 6,
        required_capability_bits: 4,
        host_abi: 2,
        minimum_host_abi: 1,
        maximum_host_abi: 3,
        requested_interface_major: 1,
        requested_interface_minor: 0,
        provided_interface_major: 1,
        provided_interface_minor: 1
    )

fn evidence_v1() -> ProviderCallableEvidenceV1:
    ProviderCallableEvidenceV1(
        artifact_exists: true,
        artifact_digest: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        loader_valid: true,
        query_symbol_address: 4096,
        query_symbol_process_callable: true
    )

use std.spec.step
describe "SimpleProviderQueryV1 loader admission":
    it "admits native or SMF evidence only after all checks and callable proof":
        step("Verify: admits native or SMF evidence only after all checks and callable proof")
        # @req: REQ-OS-ProvLoad-001
        val admitted = provider_admit_evidence_v1(request_v1(), evidence_v1())
        expect(admitted.status).to_equal(PROVIDER_ADMISSION_OK)
        expect(admitted.query_symbol_address).to_equal(4096)  # oracle: value fixed by the spec contract
        expect(admitted.process_callable).to_equal(true)

    it "fails closed for registry-only SMF symbol evidence":
        step("Verify: fails closed for registry-only SMF symbol evidence")
        # @req: REQ-OS-ProvLoad-001
        var evidence = evidence_v1()
        evidence.query_symbol_process_callable = false
        val denied = provider_admit_evidence_v1(request_v1(), evidence)
        expect(denied.status).to_equal(PROVIDER_ADMISSION_NOT_PROCESS_CALLABLE)
        expect(denied.query_symbol_address).to_equal(0)  # oracle: value fixed by the spec contract
        expect(denied.process_callable).to_equal(false)

    it "checks path artifact identity and capability ceiling before loading":
        step("Verify: checks path artifact identity and capability ceiling before loading")
        # @req: REQ-OS-ProvLoad-001
        var unsafe_request = request_v1()
        unsafe_request.artifact_path = "../fmt_tool.smf"
        expect(provider_admit_evidence_v1(unsafe_request, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_PATH_DENIED)
        var wrong_digest = evidence_v1()
        wrong_digest.artifact_digest = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        expect(provider_admit_evidence_v1(request_v1(), wrong_digest).status).to_equal(PROVIDER_ADMISSION_DIGEST_MISMATCH)
        var denied_caps = request_v1()
        denied_caps.granted_capability_bits = 2
        expect(provider_admit_evidence_v1(denied_caps, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_CAPABILITY_DENIED)

    it "shares the SCI provider artifact root policy":
        step("Verify: shares the SCI provider artifact root policy")
        # @req: REQ-OS-ProvLoad-001
        var system = request_v1()
        system.artifact_path = "/sys/providers/fmt_tool.smf"
        expect(provider_admit_evidence_v1(system, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_OK)
        var installed = request_v1()
        installed.artifact_path = "/usr/lib/simple/providers/fmt_tool.smf"
        expect(provider_admit_evidence_v1(installed, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_OK)
        var escaped = request_v1()
        escaped.artifact_path = "/tmp/fmt_tool.smf"
        expect(provider_admit_evidence_v1(escaped, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_PATH_DENIED)

    it "rejects incompatible host and provider interface versions":
        step("Verify: rejects incompatible host and provider interface versions")
        # @req: REQ-OS-ProvLoad-001
        var host = request_v1()
        host.host_abi = 4
        expect(provider_admit_evidence_v1(host, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_HOST_ABI_UNSUPPORTED)
        var interface_request = request_v1()
        interface_request.requested_interface_minor = 2
        expect(provider_admit_evidence_v1(interface_request, evidence_v1()).status).to_equal(PROVIDER_ADMISSION_INTERFACE_UNSUPPORTED)

    it "distinguishes loader symbol and executable-address failures":
        step("Verify: distinguishes loader symbol and executable-address failures")
        # @req: REQ-OS-ProvLoad-001
        var unloaded = evidence_v1()
        unloaded.loader_valid = false
        expect(provider_admit_evidence_v1(request_v1(), unloaded).status).to_equal(PROVIDER_ADMISSION_LOAD_FAILED)
        var missing = evidence_v1()
        missing.query_symbol_address = 0
        expect(provider_admit_evidence_v1(request_v1(), missing).status).to_equal(PROVIDER_ADMISSION_QUERY_SYMBOL_MISSING)

    it "uses deterministic nonzero artifact identity":
        step("Verify: uses deterministic nonzero artifact identity")
        # @req: REQ-OS-ProvLoad-001
        val bytes: [u8] = [83, 77, 70, 0, 1]
        expect(provider_artifact_digest_v1(bytes)).to_equal(provider_artifact_digest_v1(bytes))
        expect(provider_artifact_digest_v1(bytes).len()).to_equal(64)  # oracle: value fixed by the spec contract

    it "does not mistake callable admission evidence for query activation":
        step("Verify: does not mistake callable admission evidence for query activation")
        # @req: REQ-OS-ProvLoad-001
        val admission = provider_admit_evidence_v1(request_v1(), evidence_v1())
        expect(admission.status).to_equal(PROVIDER_ADMISSION_OK)
        val activation = provider_activate_admitted_v1(admission)
        expect(activation.status).to_equal(PROVIDER_ACTIVATION_QUERY_BRIDGE_UNAVAILABLE)
        expect(activation.activated).to_equal(false)
        expect(activation.reason).to_equal(PROVIDER_ACTIVATION_BLOCKER)
        expect(activation.blocker_owner.len()).to_be_greater_than(0)

    it "rejects activation before admission without claiming a runtime blocker":
        step("Verify: rejects activation before admission without claiming a runtime blocker")
        # @req: REQ-OS-ProvLoad-001
        var evidence = evidence_v1()
        evidence.query_symbol_process_callable = false
        val admission = provider_admit_evidence_v1(request_v1(), evidence)
        val activation = provider_activate_admitted_v1(admission)
        expect(activation.status).to_equal(PROVIDER_ACTIVATION_NOT_ADMITTED)
        expect(activation.activated).to_equal(false)
        expect(activation.blocker_owner).to_equal("")

    it "rejects query release and close for a session that never owned a library":
        step("Verify: rejects query release and close for a session that never owned a library")
        # @req: REQ-OS-ProvLoad-001
        val admission = provider_admit_evidence_v1(request_v1(), evidence_v1())
        val session = ProviderLoaderSessionV1(
            library: DynLibKind.Invalid,
            admission: admission,
            open: false,
            next_pin_id: 1,
            live_pins: [],
            cli_invoke_symbol_address: 0,
            cli_invoke_process_callable: false
        )
        val query = provider_session_query_v1(session, SimpleProviderQueryV1(
            descriptor_size: SIMPLE_PROVIDER_QUERY_V1_SIZE,
            interface_id: 5999723006133093425,
            minimum_major: 1,
            minimum_minor: 0,
            host_abi: 1,
            target_offset: 0,
            target_length: 0,
            requested_capability_bits: 0
        ))
        expect(query.status).to_equal(PROVIDER_SESSION_NOT_OPEN)
        expect(provider_session_release_v1(session, 1)).to_equal(PROVIDER_SESSION_PIN_UNKNOWN)
        expect(provider_session_close_v1(session)).to_equal(PROVIDER_SESSION_NOT_OPEN)
