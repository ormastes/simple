# @req REQ-DYNSMF-HOST-TARGET
"""
# SMF host target identity

The admitted-SMF loader accepts only an image whose platform byte is 0 (any)
or the host's, and whose arch byte is the host's. The host platform id must
follow the real host OS on every host (it was `freebsd` on Windows because the
seed ignores `@cfg(<os>)` on globals).
"""
use std.spec.*
use std.io_runtime.{host_os}
use os.smf.host_target.{smf_host_platform_id, smf_host_arch_id, smf_target_is_host_compatible}

fn expected_platform_id(os: text) -> u8:
    if os == "linux": return 1
    if os == "windows": return 2
    if os == "macos": return 3
    if os == "freebsd": return 4
    255

describe "SMF host target identity":
    it "reports the platform id of the running host OS":
        step("Compare the compile-time platform id with the runtime host OS")
        expect(smf_host_platform_id()).to_equal(expected_platform_id(host_os()))

    it "admits the host target and the any-platform wildcard, rejects a foreign platform":
        step("Host pair, wildcard platform 0, then a platform that is not the host's")
        val platform = smf_host_platform_id()
        val arch = smf_host_arch_id()
        expect(smf_target_is_host_compatible(platform, arch)).to_equal(true)
        expect(smf_target_is_host_compatible(0, arch)).to_equal(true)
        val foreign: u8 = if platform == 1: 2 else: 1
        expect(smf_target_is_host_compatible(foreign, arch)).to_equal(false)
