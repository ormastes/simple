# Bug smf_header_wire_layout_diverges_rust_vs_simple_2026-08-10: the dynlib
# preflight must accept the v1.3 96-byte trailer (the writers' default), the
# Rust seed's 1.1-stamped form of it, and the legacy packed 128-byte trailer.
use std.spec.{describe, it, expect}
use os.smf.smf_dynlib.{smf_artifact_has_export}
use os.smf.host_target.{smf_host_arch_id}
use compiler.backend.linker.smf_header.{SMF_HEADER_SIZE, SMF_PACKED_HEADER_SIZE, smf_header_from_bytes}
use compiler.backend.linker.smf_writer.{SmfWriter, SmfWriterSymbol, SmfWriterSymbolBinding, SmfWriterSymbolType}

fn v13_artifact(export_name: text) -> [u8]:
    var writer = SmfWriter.create()
    val code: [i64] = [195]
    writer.add_code_section("code", code)
    writer.add_symbol(SmfWriterSymbol(
        name: export_name,
        binding: SmfWriterSymbolBinding.Global,
        sym_type: SmfWriterSymbolType.Function,
        section_index: 0,
        value: 0,
        size: code.len(),
        layout_phase: 0,
        is_event_loop_anchor: false,
        layout_pinned: false
    ))
    val built = writer.write()
    if built.is_err():
        return []
    var out: [u8] = []
    for word in built.unwrap():
        out.push(word as u8)
    # platform 0 = any, arch = this host, so host-compat admission passes anywhere
    val hs = out.len() - SMF_HEADER_SIZE
    out[hs + 6] = 0
    out[hs + 7] = smf_host_arch_id()
    out

fn body_of(image: [u8]) -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < image.len() - SMF_HEADER_SIZE:
        out.push(image[i])
        i = i + 1
    out

# The Rust seed stamps 1.1 on the same 96-byte layout.
fn to_seed_stamp(image: [u8]) -> [u8]:
    var out = image
    out[out.len() - SMF_HEADER_SIZE + 5] = 1
    out

# Legacy packed 128-byte trailer (v1.1) built from the same header fields.
fn to_packed_trailer(image: [u8]) -> [u8]:
    var header = smf_header_from_bytes(image).unwrap()
    header.version_minor = 1
    val packed = header.to_packed_bytes()
    var out = body_of(image)
    var i = 0
    while i < SMF_PACKED_HEADER_SIZE:
        out.push(packed[i])
        i = i + 1
    out

describe "smf_dynlib preflight header layouts":
    it "accepts the v1.3 96-byte default trailer":
        val img = v13_artifact("seed_probe_v1")
        expect(img.len() > SMF_HEADER_SIZE).to_equal(true)
        expect(smf_artifact_has_export(img, "seed_probe_v1")).to_equal(true)

    it "accepts the legacy packed 128-byte trailer":
        expect(smf_artifact_has_export(to_packed_trailer(v13_artifact("seed_probe_v1")), "seed_probe_v1")).to_equal(true)

    it "accepts the Rust seed 96-byte repr(C) trailer":
        val seed = to_seed_stamp(v13_artifact("seed_probe_v1"))
        expect(seed.len() > 96).to_equal(true)
        expect(smf_artifact_has_export(seed, "seed_probe_v1")).to_equal(true)

    it "still rejects an unknown export on the seed layout":
        val seed = to_seed_stamp(v13_artifact("seed_probe_v1"))
        expect(smf_artifact_has_export(seed, "other_v1")).to_equal(false)
