use std.spec
use std.spec.step
use os.smf.kernel_plugin.real_worker_codec.kpf_real_worker_max_line_bytes_v1
use os.smf.kernel_plugin.real_worker_process.*

describe "real KPF worker authority":
    it "rejects relative executables and ambient filesystem or network authority":
        step("fail before process spawn when placement authority is not isolated")
        val relative = KpfRealWorkerProcessV1.spawn("fake-worker", [], 64, 16, 0)
        assert_equal(relative.process_handle, -1)
        val filesystem = KpfRealWorkerProcessV1.spawn("/missing/fake-worker", [], 64, 16,
            KPF_REAL_WORKER_FILESYSTEM_CAPABILITY_V1)
        assert_equal(filesystem.process_handle, -1)
        val network = KpfRealWorkerProcessV1.spawn("/missing/fake-worker", [], 64, 16,
            KPF_REAL_WORKER_NETWORK_CAPABILITY_V1)
        assert_equal(network.process_handle, -1)
        assert_false(relative.alive)
        assert_true(relative.isolated)
        assert_equal(relative.maximum_pending_bytes,
            kpf_real_worker_max_line_bytes_v1(64) * 2)
