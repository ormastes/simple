#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../../../.." && pwd)
fixture="$root/test/01_unit/os/smf/kernel_plugin"
build_dir=${TMPDIR:-/tmp}/simple-kpf-shared-memory-$$
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
mkdir -p "$build_dir"

cc -std=c11 -Wall -Wextra -Werror -O2 \
  "$fixture/shared_memory_native_test.c" \
  -o "$build_dir/shared-memory-native-test"
"$build_dir/shared-memory-native-test"

