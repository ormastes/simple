#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../../../../.." && pwd)
fixture="$root/test/01_unit/os/smf/kernel_plugin"
build_dir=${TMPDIR:-/tmp}/simple-kpf-real-worker-$$
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
mkdir -p "$build_dir"

cc -std=c11 -Wall -Wextra -Werror -O2 \
  "$fixture/fake_real_worker.c" -o "$build_dir/fake-real-worker"
cc -std=c11 -Wall -Wextra -Werror -O2 \
  "$fixture/real_worker_native_test.c" -o "$build_dir/real-worker-native-test"
"$build_dir/real-worker-native-test" "$build_dir/fake-real-worker"
