use std.spec.*
use os.smf.provider_loader.{
    provider_artifact_path_allowed_v1,
    provider_artifact_path_allowed_for_exe_v1
}

val EXE_DIR = "D:/dev/simple/bin"

describe "exe-relative provider root admits only <exe_dir>/providers/<file>":
    it "admits one native file directly under the executable's providers dir":
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/providers/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(true)
        expect(provider_artifact_path_allowed_for_exe_v1(
            "/opt/simple/bin/providers/simple_vector_provider_levelled.so", "native", "/opt/simple/bin")).to_equal(true)

    it "keeps every other directory path-denied":
        expect(provider_artifact_path_allowed_for_exe_v1(
            "D:/dev/other/providers/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/providers/nested/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/providers/../providers/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "x/providers/simple_vector_provider_levelled.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            "D:\dev\simple\bin\providers\p.dll", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/providers/notes.txt", "native", EXE_DIR)).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            EXE_DIR + "/providers/p.dll", "smf", EXE_DIR)).to_equal(false)

    it "grants nothing extra without a resolved exe dir and keeps the fixed roots":
        expect(provider_artifact_path_allowed_for_exe_v1(
            "/providers/p.so", "native", "")).to_equal(false)
        expect(provider_artifact_path_allowed_for_exe_v1(
            "build/providers/p.so", "native", "")).to_equal(true)
        expect(provider_artifact_path_allowed_v1(
            EXE_DIR + "/providers/p.dll", "native")).to_equal(false)
