use os._QemuRunner.os_build_run.{simpleos_candidate_version_is_selfhosted}
extern fn rt_file_read_text(path: text) -> text

describe "SimpleOS compiler admission":
    it "rejects Rust bootstrap seed banners on either output stream":
        step("A seed reports its bootstrap identity through --version")
        expect(simpleos_candidate_version_is_selfhosted(
            "WARNING: this Rust-built Simple binary is a bootstrap seed only; do not use it as the normal tool.\nSimple Language v1.0.0-beta\n", "", 0
        )).to_equal(false)
        expect(simpleos_candidate_version_is_selfhosted(
            "Simple Language v1.0.0-beta\n", "WARNING: bootstrap seed only", 0
        )).to_equal(false)

    it "admits a runnable self-hosted version and rejects failed probes":
        step("A candidate must produce a successful nonempty version without the seed banner")
        expect(simpleos_candidate_version_is_selfhosted("Simple Language v1.0.0-beta\n", "", 0)).to_equal(true)
        expect(simpleos_candidate_version_is_selfhosted("", "", 0)).to_equal(false)
        expect(simpleos_candidate_version_is_selfhosted("Simple Language v1.0.0-beta\n", "", 1)).to_equal(false)

    it "forces a seed identity banner even inside bootstrap builds":
        step("The version probe overrides both seed warning suppression variables")
        val source = rt_file_read_text("src/os/_QemuRunner/os_build_run.spl")
        expect(source).to_contain("\"SIMPLE_BOOTSTRAP=0\", \"SIMPLE_RUST_SEED_WARNING=1\", candidate, \"--version\"")
