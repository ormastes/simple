# @cover src/os/realtime/jtag/openocd_probe.spl 20%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-DHR-03
# plan: doc/03_plan/app/debug/dhr_debug_spy_replay_recovery_plan_2026-11-17.md

# DHR P0: the OpenOCD TCL reply parsers used to return [] and 0 for every
# input, so memory/register reads silently reported zeros.

use std.spec.*
use os.realtime.jtag.openocd_probe.{parse_mdw_response, parse_reg_response}

describe "OpenOCD reply parsing":
    it "mdw words decode to little-endian bytes truncated to len":
        val bytes = parse_mdw_response("0x20000000: 12345678 deadbeef \n", 6)
        expect(bytes.len()).to_equal(6)
        expect(bytes[0] as i64).to_equal(120)
        expect(bytes[3] as i64).to_equal(18)
        expect(bytes[4] as i64).to_equal(239)
        expect(bytes[5] as i64).to_equal(190)

    it "mdw stops at a malformed word instead of inventing zeros":
        val bytes = parse_mdw_response("0x20000000: 12345678 error", 8)
        expect(bytes.len()).to_equal(4)

    it "reg reply yields the register value":
        expect(parse_reg_response("pc (/32): 0x08000124") as i64).to_equal(134218020)

    it "unparseable reg reply yields 0":
        expect(parse_reg_response("invalid command") as i64).to_equal(0)
