# @cover src/os/realtime/jtag/t32_probe.spl 40%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-DHR-03
# plan: doc/03_plan/app/debug/dhr_debug_spy_replay_recovery_plan_2026-11-17.md

# DHR P0: Trace32Probe imported t32_break/t32_go (which do not exist) and a
# std.os.* path, so the module never compiled; its memory/register calls used
# stale SFFI signatures and reported success unconditionally. With no TRACE32
# provider loaded every SFFI call returns Err, so every operation must now
# report failure instead of fake success.

use std.spec.*
use os.realtime.jtag.t32_probe.{Trace32Probe}

fn _probe() -> Trace32Probe:
    var p = Trace32Probe.new("localhost", 20000, "arm")
    p.connected = true
    p.watchdog.connected = true
    p

describe "Trace32Probe without a provider":
    it "write_region reports failure":
        var p = _probe()
        expect(p.write_region(4096u64, [1u8, 2u8])).to_equal(false)

    it "read_region returns no bytes":
        var p = _probe()
        expect(p.read_region(4096u64, 8).len()).to_equal(0)

    it "write_register reports failure":
        var p = _probe()
        expect(p.write_register("R0", 7u64)).to_equal(false)

    it "halt reports failure":
        var p = _probe()
        expect(p.halt()).to_equal(false)

    it "is_halted is false when state cannot be read":
        var p = _probe()
        expect(p.is_halted()).to_equal(false)
