use std.io_runtime.{file_read}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

describe "SimpleOS dlmalloc ownership safety":
    it "uses checked request rounding, tracked regions, and validated frees":
        val source = file_read("src/os/libc/simpleos_dlmalloc.c")
        expect(source).to_contain("_checked_add")
        expect(source).to_contain("_checked_round_up")
        expect(source).to_contain("if (region_count >= MAX_REGIONS) return NULL;")
        expect(source).to_contain("_validated_block(hdr, &region)")
        expect(source).to_contain("current->prev_size != expected_prev_size")
        expect(source).to_contain("_next_in_region(prev, region) == hdr")
        expect(source).to_contain("_free_node_links_valid")
        expect(source).to_contain("static int _free_list_insert(free_node *node)")
        expect(source).to_contain("if (next) next->prev_size = bsize;")
        expect(source).to_contain("hdr->size = bsize;")
        expect(source).to_contain("_free_list_insert(best);")
        expect(source).to_contain("_allocator_lock()")
        expect(source).to_contain("if (raw_ptr < HEADER_SIZE) return;")
        expect(source).to_contain("!BLOCK_INUSE(hdr)")
        expect(source).to_contain("if (size > (size_t)INT64_MAX) return NULL;")
        expect(source).to_contain("if (nmemb != 0 && size > (size_t)-1 / nmemb)")

    it "compiles and executes hostile allocation, split, and free boundary checks":
        val command = "out=/tmp/simpleos-dlmalloc-safety-test.$$; trap 'rm -f \"$out\"' EXIT; cc -std=gnu11 -O0 -Wall -Wextra -Werror -I. test/01_unit/os/libc/simpleos_dlmalloc_safety_test.c -o \"$out\" && \"$out\""
        val (_stdout, _stderr, exit_code) = rt_process_run_timeout("/bin/sh", ["-c", command], 15000)
        expect(exit_code).to_equal(0)
