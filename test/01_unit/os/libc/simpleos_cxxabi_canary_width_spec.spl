# Native-word arithmetic contract for the C bootstrap shim's Simple twin.
# @cover src/os/libc/simpleos_cxxabi.spl
use std.spec.*
use os.libc.simpleos_cxxabi.{simpleos_cxxabi_mix_stack_seed}

describe "SimpleOS fallback stack canary word width":
    it "mixes 32-bit seeds without shifts wider than the native word":
        expect(simpleos_cxxabi_mix_stack_seed(0, 32).unwrap()).to_equal(2473412407u64)
        expect(simpleos_cxxabi_mix_stack_seed(1, 32).unwrap()).to_equal(425297820u64)
        expect(simpleos_cxxabi_mix_stack_seed(0xffffffff, 32).unwrap()).to_equal(3137892178u64)

    it "truncates high address bits at the ELF32 ABI boundary":
        expect(simpleos_cxxabi_mix_stack_seed(0xffffffffffffffff, 32).unwrap()).to_equal(
            simpleos_cxxabi_mix_stack_seed(0xffffffff, 32).unwrap())

    it "preserves the historical 64-bit mixer":
        expect(simpleos_cxxabi_mix_stack_seed(0, 64).unwrap()).to_equal(5964046029835508850u64)
        expect(simpleos_cxxabi_mix_stack_seed(1, 64).unwrap()).to_equal(5964046026242345417u64)
        expect(simpleos_cxxabi_mix_stack_seed(0xffffffffffffffff, 64).unwrap()).to_equal(9935746320671159298u64)

    it "never returns zero when the mixed fallback addresses cancel":
        expect(simpleos_cxxabi_mix_stack_seed(0x9E3779B9, 32).unwrap()).to_equal(0xA5A55A5Au64)
        expect(simpleos_cxxabi_mix_stack_seed(0x9E3779B9, 64).unwrap()).to_equal(0xA5A55A5Au64)

    it "rejects unsupported word widths rather than guessing an ABI":
        expect(simpleos_cxxabi_mix_stack_seed(1, 16).is_err()).to_equal(true)
        expect(simpleos_cxxabi_mix_stack_seed(1, 128).is_err()).to_equal(true)
