"""
## Purpose and audience
Executable specification for the Pure-Simple SimpleOS libc string
copy/concat functions (strcpy, strncpy, strcat, strncat, strdup, strndup,
strnlen, strlcpy, strlcat), value-returning over exact-length u8 buffers.
Audience: libc and musl-compatibility engineers.
## Operator workflow
Run this spec from the repo root with the Simple runner; every scenario
calls the production functions from os.libc.simpleos_string_copy against
ASCII fixtures and checks lengths, byte contents, and reported totals.
## Compatibility and limitations
Covers the value-returning buffer API only; no NUL-terminated pointer
ABI, no locale, no wide-char behavior. Negative length arguments are
contractually clamped to zero, and those clamps are pinned as scenarios.
## Verification guidance and troubleshooting
A red scenario means a function's length, padding, truncation, or total
report changed. Compare the failing expect against the function in
src/os/libc/simpleos_string_copy.spl before editing the oracle.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: libc-string-copy
# @req REQ-SSPEC-OS



use std.spec.step

use std.spec
use os.libc.simpleos_string_copy.{
    libc_strcpy, libc_strncpy, libc_strcat, libc_strncat,
    libc_strdup, libc_strndup, libc_strnlen,
    libc_strlcpy, libc_strlcat, LcResult
}

# @req REQ-simpleos-libc-musl-core
# tag: unit
#
# Pure-Simple string copy/concat functions, value-returning over exact-length [u8] buffers.

describe "SimpleOS libc — string copy/concat functions":

    describe "strcpy":
        it "copies a non-empty string":
            # @req REQ-SSPEC-OS REQ-simpleos-libc-musl-core
            # @capture(statistics): copies-a-non-empty-string
            step("copies a non-empty string")
            val src = "hello".bytes()
            val dst = libc_strcpy(src)
            expect(dst.len()).to_equal(5)  # oracle: hello is five bytes
            expect(dst[0]).to_equal(104)  # oracle: 104 is ASCII h, the first source byte
            expect(dst[4]).to_equal(111)  # oracle: 111 is ASCII o, the last source byte
        it "copies an empty string":
            # @req REQ-SSPEC-OS
            # @capture(statistics): copies-an-empty-string
            step("copies an empty string")
            val dst = libc_strcpy("".bytes())
            expect(dst.len()).to_equal(0)  # oracle: an empty source copies to a zero-length buffer

    describe "strncpy":
        it "copies when n is larger than source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): copies-when-n-is-larger-than-source-length
            step("copies when n is larger than source length")
            val src = "hi".bytes()
            val dst = libc_strncpy(src, 5)
            expect(dst.len()).to_equal(5)  # oracle: n=5 allocates the five-byte destination
            expect(dst[0]).to_equal(104)  # oracle: 104 is ASCII h from hi
            expect(dst[1]).to_equal(105)  # oracle: 105 is ASCII i from hi
            expect(dst[2]).to_equal(0)  # oracle: 0 pads the remainder after the two source bytes
            expect(dst[4]).to_equal(0)  # oracle: the final pad byte at index 4 must also be NUL
        it "truncates when n is smaller than source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): truncates-when-n-is-smaller-than-source-length
            step("truncates when n is smaller than source length")
            val src = "hello".bytes()
            val dst = libc_strncpy(src, 3)
            expect(dst.len()).to_equal(3)  # oracle: n=3 truncates hello to three bytes
            expect(dst[0]).to_equal(104)  # oracle: 104 is ASCII h, first retained byte
            expect(dst[2]).to_equal(108)  # oracle: 108 is ASCII l, last retained byte
        it "returns empty array when n is 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-empty-array-when-n-is-0
            step("returns empty array when n is 0")
            val dst = libc_strncpy("hello".bytes(), 0)
            expect(dst.len()).to_equal(0)  # oracle: n=0 yields an empty buffer by contract
        it "clamps negative n to 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): clamps-negative-n-to-0
            step("clamps negative n to 0")
            val dst = libc_strncpy("hello".bytes(), -5)
            expect(dst.len()).to_equal(0)  # oracle: a negative n clamps to zero copied bytes

    describe "strcat":
        it "concatenates two non-empty strings":
            # @req REQ-SSPEC-OS
            # @capture(statistics): concatenates-two-non-empty-strings
            step("concatenates two non-empty strings")
            val a = "hello".bytes()
            val b = "world".bytes()
            val result = libc_strcat(a, b)
            expect(result.len()).to_equal(10)  # oracle: hello plus world concatenates to ten bytes
            expect(result[0]).to_equal(104)  # oracle: 104 is ASCII h, first byte of the result
            expect(result[5]).to_equal(119)  # oracle: 119 is ASCII w, first byte of the appended part
            expect(result[9]).to_equal(100)  # oracle: 100 is ASCII d, final byte of the result
        it "concatenates when first is empty":
            # @req REQ-SSPEC-OS
            # @capture(statistics): concatenates-when-first-is-empty
            step("concatenates when first is empty")
            val a = "".bytes()
            val b = "hi".bytes()
            val result = libc_strcat(a, b)
            expect(result.len()).to_equal(2)  # oracle: appending hi to empty yields two bytes
            expect(result[0]).to_equal(104)  # oracle: 104 is ASCII h, now at index 0
        it "concatenates when second is empty":
            # @req REQ-SSPEC-OS
            # @capture(statistics): concatenates-when-second-is-empty
            step("concatenates when second is empty")
            val a = "hi".bytes()
            val b = "".bytes()
            val result = libc_strcat(a, b)
            expect(result.len()).to_equal(2)  # oracle: prepended empty source keeps length two
            expect(result[0]).to_equal(104)  # oracle: 104 is ASCII h, the unchanged head byte

    describe "strncat":
        it "concatenates when n is larger than b length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): concatenates-when-n-is-larger-than-b-length
            step("concatenates when n is larger than b length")
            val a = "ab".bytes()
            val b = "cd".bytes()
            val result = libc_strncat(a, b, 10)
            expect(result.len()).to_equal(4)  # oracle: ab plus cd under n=10 joins to four bytes
            expect(result[0]).to_equal(97)  # oracle: 97 is ASCII a, first byte
            expect(result[3]).to_equal(100)  # oracle: 100 is ASCII d, last appended byte
        it "truncates b when n is smaller than b length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): truncates-b-when-n-is-smaller-than-b-length
            step("truncates b when n is smaller than b length")
            val a = "ab".bytes()
            val b = "cdef".bytes()
            val result = libc_strncat(a, b, 2)
            expect(result.len()).to_equal(4)  # oracle: n=2 truncates cdef but dst plus copy length stays four
            expect(result[0]).to_equal(97)  # oracle: 97 is ASCII a, head of dst
            expect(result[3]).to_equal(100)  # oracle: 100 is ASCII d, last byte within the n=2 copy budget
        it "returns a when n is 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-a-when-n-is-0
            step("returns a when n is 0")
            val a = "ab".bytes()
            val b = "cd".bytes()
            val result = libc_strncat(a, b, 0)
            expect(result.len()).to_equal(2)  # oracle: n=0 appends nothing, so dst ab stays two bytes
            expect(result[0]).to_equal(97)  # oracle: 97 is ASCII a, the untouched head
        it "clamps negative n to 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): clamps-negative-n-to-0
            step("clamps negative n to 0")
            val a = "ab".bytes()
            val b = "cd".bytes()
            val result = libc_strncat(a, b, -5)
            expect(result.len()).to_equal(2)  # oracle: a negative n clamps to no appended bytes

    describe "strdup":
        it "duplicates a non-empty string":
            # @req REQ-SSPEC-OS
            # @capture(statistics): duplicates-a-non-empty-string
            step("duplicates a non-empty string")
            val src = "test".bytes()
            val dup = libc_strdup(src)
            expect(dup.len()).to_equal(4)  # oracle: test duplicates to four bytes
            expect(dup[0]).to_equal(116)  # oracle: 116 is ASCII t, first byte
            expect(dup[3]).to_equal(116)  # oracle: 116 is ASCII t, last byte
        it "duplicates an empty string":
            # @req REQ-SSPEC-OS
            # @capture(statistics): duplicates-an-empty-string
            step("duplicates an empty string")
            val dup = libc_strdup("".bytes())
            expect(dup.len()).to_equal(0)  # oracle: duplicating an empty source yields an empty buffer

    describe "strndup":
        it "duplicates when n is larger than source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): duplicates-when-n-is-larger-than-source-length
            step("duplicates when n is larger than source length")
            val src = "hi".bytes()
            val dup = libc_strndup(src, 10)
            expect(dup.len()).to_equal(2)  # oracle: hi with n=10 keeps its two bytes
            expect(dup[0]).to_equal(104)  # oracle: 104 is ASCII h
        it "truncates when n is smaller than source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): truncates-when-n-is-smaller-than-source-length
            step("truncates when n is smaller than source length")
            val src = "hello".bytes()
            val dup = libc_strndup(src, 3)
            expect(dup.len()).to_equal(3)  # oracle: n=3 truncates hello to three bytes
            expect(dup[0]).to_equal(104)  # oracle: 104 is ASCII h, first retained
            expect(dup[2]).to_equal(108)  # oracle: 108 is ASCII l, last retained
        it "returns empty array when n is 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-empty-array-when-n-is-0
            step("returns empty array when n is 0")
            val dup = libc_strndup("hello".bytes(), 0)
            expect(dup.len()).to_equal(0)  # oracle: n=0 duplicates nothing
        it "clamps negative n to 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): clamps-negative-n-to-0
            step("clamps negative n to 0")
            val dup = libc_strndup("hello".bytes(), -5)
            expect(dup.len()).to_equal(0)  # oracle: a negative n clamps to an empty duplicate

    describe "strnlen":
        it "returns full length when maxlen is larger":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-full-length-when-maxlen-is-larger
            step("returns full length when maxlen is larger")
            val s = "hello".bytes()
            expect(libc_strnlen(s, 10)).to_equal(5)  # oracle: maxlen 10 exceeds len 5, so the true length 5 returns
        it "returns maxlen when smaller than length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-maxlen-when-smaller-than-length
            step("returns maxlen when smaller than length")
            val s = "hello".bytes()
            expect(libc_strnlen(s, 3)).to_equal(3)  # oracle: maxlen 3 caps the reported length at 3
        it "returns 0 for empty string":
            # @req REQ-SSPEC-OS
            # @capture(statistics): returns-0-for-empty-string
            step("returns 0 for empty string")
            expect(libc_strnlen("".bytes(), 10)).to_equal(0)  # oracle: an empty string has length 0 under any maxlen
        it "clamps negative maxlen to 0":
            # @req REQ-SSPEC-OS
            # @capture(statistics): clamps-negative-maxlen-to-0
            step("clamps negative maxlen to 0")
            val s = "hello".bytes()
            expect(libc_strnlen(s, -5)).to_equal(0)  # oracle: a negative maxlen clamps to a 0 report

    describe "strlcpy":
        it "copies fully when buffer is large enough":
            # @req REQ-SSPEC-OS
            # @capture(statistics): copies-fully-when-buffer-is-large-enough
            step("copies fully when buffer is large enough")
            val r = libc_strlcpy("hello".bytes(), 10)
            expect(r.bytes.len()).to_equal(5)  # oracle: dstsize 10 fits all five bytes of hello
            expect(r.bytes[0]).to_equal(104)  # oracle: 104 is ASCII h, first copied byte
            expect(r.total).to_equal(5)  # oracle: total reports the untruncated source length 5
        it "truncates to dstsize-1 and reports full source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): truncates-to-dstsize-1-and-reports-full-source-length
            step("truncates to dstsize-1 and reports full source length")
            val r = libc_strlcpy("hello".bytes(), 3)
            expect(r.bytes.len()).to_equal(2)  # oracle: dstsize 3 copies only dstsize-1, two bytes
            expect(r.bytes[0]).to_equal(104)  # oracle: 104 is ASCII h, first kept byte
            expect(r.bytes[1]).to_equal(101)  # oracle: 101 is ASCII e, second kept byte
            expect(r.total).to_equal(5)  # oracle: total still reports the full source length 5
        it "copies nothing for dstsize 0 but still reports source length":
            # @req REQ-SSPEC-OS
            # @capture(statistics): copies-nothing-for-dstsize-0-but-still-reports-source-length
            step("copies nothing for dstsize 0 but still reports source length")
            val r = libc_strlcpy("hi".bytes(), 0)
            expect(r.bytes.len()).to_equal(0)  # oracle: dstsize 0 copies no bytes
            expect(r.total).to_equal(2)  # oracle: total still reports the two source bytes
        it "copies nothing for dstsize 1 (NUL slot only)":
            # @req REQ-SSPEC-OS
            # @capture(statistics): copies-nothing-for-dstsize-1-nul-slot-only
            step("copies nothing for dstsize 1 (NUL slot only)")
            val r = libc_strlcpy("hi".bytes(), 1)
            expect(r.bytes.len()).to_equal(0)  # oracle: dstsize 1 reserves the only slot for NUL
            expect(r.total).to_equal(2)  # oracle: total still reports the two source bytes

    describe "strlcat":
        it "appends when room remains":
            # @req REQ-SSPEC-OS
            # @capture(statistics): appends-when-room-remains
            step("appends when room remains")
            val r = libc_strlcat("ab".bytes(), "cd".bytes(), 10)
            expect(r.bytes.len()).to_equal(4)  # oracle: ab plus cd under room 10 appends to four bytes
            expect(r.bytes[2]).to_equal(99)  # oracle: 99 is ASCII c, first appended byte
            expect(r.bytes[3]).to_equal(100)  # oracle: 100 is ASCII d, final appended byte
            expect(r.total).to_equal(4)  # oracle: total equals the joined length 4
        it "truncates appended src to remaining space":
            # @req REQ-SSPEC-OS
            # @capture(statistics): truncates-appended-src-to-remaining-space
            step("truncates appended src to remaining space")
            val r = libc_strlcat("abc".bytes(), "defg".bytes(), 5)
            expect(r.bytes.len()).to_equal(4)  # oracle: room 5 appends only two of defg
            expect(r.bytes[3]).to_equal(100)  # oracle: 100 is ASCII d, the last byte that fit
            expect(r.total).to_equal(7)  # oracle: total reports what would have been 7
        it "leaves dst unchanged when buffer already full":
            # @req REQ-SSPEC-OS
            # @capture(statistics): leaves-dst-unchanged-when-buffer-already-full
            step("leaves dst unchanged when buffer already full")
            val r = libc_strlcat("abcde".bytes(), "x".bytes(), 5)
            expect(r.bytes.len()).to_equal(5)  # oracle: a full buffer keeps its five bytes
            expect(r.total).to_equal(6)  # oracle: total reports len dst plus len src, six
