# Structural regression coverage for the candidate-only ML-KEM SIMD runtime.
# @req NFR-010


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/crypto/x25519mlkem768_simd_dispatch_structure_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/x25519mlkem768_simd_dispatch_structure_spec.md
# doc-path: doc/03_plan/sys_test/x25519mlkem768_simd_dispatch_structure_spec.md
# doc-path: doc/04_architecture/x25519mlkem768_simd_dispatch_structure_spec.md
# doc-path: doc/05_design/x25519mlkem768_simd_dispatch_structure_spec_oracles.md
# @manual: primary

use std.spipe.*
use std.spec.step
use std.sffi.io.{file_read_text}

describe "X25519MLKEM768 SIMD dispatch structure":
    it "should dispatch once per butterfly group and preserve scalar tails (NFR-010)":
        # @req: REQ-SSPEC-LOCAL-001
        step("Inspect AVX2 NEON and RVV group loops and receipt accounting")
        val source = file_read_text("src/runtime/runtime_simd_dispatch.c")
        expect(source).to_contain("const int end = start + len;")
        expect(source).to_contain("if (backend == 1) {\n                while (j + 8 <= end)")
        expect(source).to_contain("if (backend == 2) {\n                while (j + 4 <= end)")
        expect(source).to_contain("if (backend == 3 && j < end)")
        expect(source).to_contain("(size_t)(end - j)")
        expect(source).to_contain("hits += executed_chunks;")
        expect(source).to_contain("while (j < end) {")
        expect(source).to_contain("if (j >= end) continue;")
        expect(source.contains("int remaining = start + len - j;")).to_equal(false)
        expect(source.contains("int width = 0;")).to_equal(false)
