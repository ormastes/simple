    0xe5u8, 0x76u8, 0xd2u8, 0x65u8, 0x86u8, 0xceu8, 0xc6u8, 0x4bu8,
    0x61u8, 0x16u8
]

val EXPECTED_TAG_2_8_2: [u8] = [
    0x1au8, 0xe1u8, 0x0bu8, 0x59u8, 0x4fu8, 0x09u8, 0xe2u8, 0x6au8,
    0x7eu8, 0x90u8, 0x2eu8, 0xcbu8, 0xd0u8, 0x60u8, 0x06u8, 0x91u8
]

fn _shape_bytes(data: [u8], size: i64) -> [u8]:
    var result: [u8] = []
    var i = 0
    while i < size:
        if i < data.len():
            result.push(data[i])
        else:
            result.push(0xffu8)
        i = i + 1
    result

fn _expect_shape_error(key: [u8], nonce: [u8], tag: [u8], expected: text):
    match chacha20_poly1305_decrypt(key, nonce, EXPECTED_CT_2_8_2, AAD_2_8_2, tag):
        case Chacha20Poly1305Result.Err(message):
            expect(message).to_equal(expected)
        case Chacha20Poly1305Result.Ok(data):
            expect("unexpected plaintext").to_equal(expected)

describe "ChaCha20-Poly1305 exact input lengths":
    it "decrypts the unchanged RFC vector with exact input lengths":
        step("Decrypt the independent RFC vector with a 32-byte key and 12-byte nonce")
        match chacha20_poly1305_decrypt(KEY_2_8_2, NONCE_2_8_2, EXPECTED_CT_2_8_2, AAD_2_8_2, EXPECTED_TAG_2_8_2):
            case Chacha20Poly1305Result.Ok(data):
                expect(data).to_equal(PT_2_8_2)
            case Chacha20Poly1305Result.Err(message):
                expect(message).to_equal("expected RFC plaintext")

    it "rejects a 0-byte key before returning plaintext":
        step("Reject the 0-byte key with all other RFC inputs unchanged")
        _expect_shape_error(_shape_bytes(KEY_2_8_2, 0), NONCE_2_8_2, EXPECTED_TAG_2_8_2, "invalid key length")

    it "rejects a 31-byte key before returning plaintext":
        step("Reject the 31-byte key with all other RFC inputs unchanged")
        _expect_shape_error(_shape_bytes(KEY_2_8_2, 31), NONCE_2_8_2, EXPECTED_TAG_2_8_2, "invalid key length")

    it "rejects a 33-byte key before returning plaintext":
        step("Reject the 33-byte key with all other RFC inputs unchanged")
        _expect_shape_error(_shape_bytes(KEY_2_8_2, 33), NONCE_2_8_2, EXPECTED_TAG_2_8_2, "invalid key length")

    it "rejects a 0-byte nonce before returning plaintext":
        step("Reject the 0-byte nonce with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 0), EXPECTED_TAG_2_8_2, "invalid nonce length")

    it "rejects a 11-byte nonce before returning plaintext":
        step("Reject the 11-byte nonce with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 11), EXPECTED_TAG_2_8_2, "invalid nonce length")

    it "rejects a 13-byte nonce before returning plaintext":
        step("Reject the 13-byte nonce with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 13), EXPECTED_TAG_2_8_2, "invalid nonce length")

    it "rejects a 0-byte tag before returning plaintext":
        step("Reject the 0-byte tag with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, NONCE_2_8_2, _shape_bytes(EXPECTED_TAG_2_8_2, 0), "invalid tag length")

    it "rejects a 15-byte tag before returning plaintext":
        step("Reject the 15-byte tag with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, NONCE_2_8_2, _shape_bytes(EXPECTED_TAG_2_8_2, 15), "invalid tag length")

    it "rejects a 17-byte tag before returning plaintext":
        step("Reject the 17-byte tag with all other RFC inputs unchanged")
        _expect_shape_error(KEY_2_8_2, NONCE_2_8_2, _shape_bytes(EXPECTED_TAG_2_8_2, 17), "invalid tag length")

fn _expect_checked_shape_error(key: [u8], nonce: [u8], expected: text):
    match chacha20_poly1305_encrypt_checked(key, nonce, PT_2_8_2, AAD_2_8_2):
        case Chacha20Poly1305Result.Err(message):
            expect(message).to_equal(expected)
        case Chacha20Poly1305Result.Ok(data):
            expect("unexpected ciphertext").to_equal(expected)

describe "Checked ChaCha20-Poly1305 encryption":
    it "returns the independent RFC ciphertext and tag for exact shapes":
        step("Encrypt the RFC 8439 section 2.8.2 plaintext through the checked API")
        match chacha20_poly1305_encrypt_checked(KEY_2_8_2, NONCE_2_8_2, PT_2_8_2, AAD_2_8_2):
            case Chacha20Poly1305Result.Ok(data):
                expect(data).to_equal(EXPECTED_CT_2_8_2 + EXPECTED_TAG_2_8_2)
            case Chacha20Poly1305Result.Err(message):
                expect(message).to_equal("expected RFC ciphertext and tag")

    it "checked encryption rejects a 0-byte key":
        step("Reject malformed key before key derivation")
        _expect_checked_shape_error(_shape_bytes(KEY_2_8_2, 0), NONCE_2_8_2, "invalid key length")

    it "checked encryption rejects a 31-byte key":
        step("Reject malformed key before key derivation")
        _expect_checked_shape_error(_shape_bytes(KEY_2_8_2, 31), NONCE_2_8_2, "invalid key length")

    it "checked encryption rejects a 33-byte key":
        step("Reject malformed key before key derivation")
        _expect_checked_shape_error(_shape_bytes(KEY_2_8_2, 33), NONCE_2_8_2, "invalid key length")

    it "checked encryption rejects a 0-byte nonce":
        step("Reject malformed nonce before key derivation")
        _expect_checked_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 0), "invalid nonce length")

    it "checked encryption rejects a 11-byte nonce":
        step("Reject malformed nonce before key derivation")
        _expect_checked_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 11), "invalid nonce length")

    it "checked encryption rejects a 13-byte nonce":
        step("Reject malformed nonce before key derivation")
        _expect_checked_shape_error(KEY_2_8_2, _shape_bytes(NONCE_2_8_2, 13), "invalid nonce length")
