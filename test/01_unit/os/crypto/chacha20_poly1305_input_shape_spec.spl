use std.spec.step
use std.spipe.*
use os.crypto.chacha20_poly1305.{chacha20_poly1305_decrypt, chacha20_poly1305_encrypt_checked, Chacha20Poly1305Result}

# Exact RFC 8439 section 2.8.2 bytes copied from the in-tree RFC specification.
# Contract: RFC 8439 section 2.8 takes a 256-bit key and 96-bit nonce.
# https://www.rfc-editor.org/rfc/rfc8439#section-2.8
# Rejecting other lengths implements this API contract; RFC does not prescribe
# this library's error text. Tag lengths retain the existing rejection contract.
# No ciphertext or tag is produced by the implementation under test.
# Execution status: UNRUN; requires an approved runtime that executes assertions.
val KEY_2_8_2: [u8] = [
    0x80u8, 0x81u8, 0x82u8, 0x83u8, 0x84u8, 0x85u8, 0x86u8, 0x87u8,
    0x88u8, 0x89u8, 0x8au8, 0x8bu8, 0x8cu8, 0x8du8, 0x8eu8, 0x8fu8,
    0x90u8, 0x91u8, 0x92u8, 0x93u8, 0x94u8, 0x95u8, 0x96u8, 0x97u8,
    0x98u8, 0x99u8, 0x9au8, 0x9bu8, 0x9cu8, 0x9du8, 0x9eu8, 0x9fu8
]

val NONCE_2_8_2: [u8] = [
    0x07u8, 0x00u8, 0x00u8, 0x00u8, 0x40u8, 0x41u8, 0x42u8, 0x43u8,
    0x44u8, 0x45u8, 0x46u8, 0x47u8
]

