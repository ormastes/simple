"""
## Purpose and audience
Known-answer verification of the pure-Simple FFDHE implementation in
`src/os/crypto/ffdhe.spl` against RFC 7919: small-prime DH semantics with
hand-computed values, byte-exact SHA-256 fingerprints of the ffdhe2048/3072/4096
named-group primes from RFC 7919 Appendix A, public-key serialization
round-trips, and the multiplicative-range contract on public keys. Audience:
maintainers of the os.crypto stack and the ssh key-exchange lanes that consume
the ffdhe groups.
## Operator workflow
Run this file alone with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/os/crypto/ffdhe_kat_spec.spl`
## Compatibility and limitations
Interpreter mode only. The 2048-bit Alice/Bob round-trip itself is O(minutes)
in the interpreter and is deferred to the native rt_modexp lane, so every DH
semantic here is exercised on the p=23, g=2 group where exponents stay
single-digit; prime integrity for the real 2048/3072/4096 groups is asserted
byte-exactly through SHA-256 fingerprints, which needs no modexp.
## Verification guidance and troubleshooting
A fingerprint mismatch means a named-group prime constant drifted from RFC 7919
and every handshake using that group is compromised — treat it as blocking. A
small-group failure means the modexp or shared-secret core is broken; compare
against the hand-computed values in the scenario oracles before touching the
fingerprint scenarios.
"""
# Lifecycle: doc/01_research/lib/crypto/security_crypto_protocol_catalog_2026-06-15.md ;
# doc/03_plan/lib/crypto/rsa_modexp_montgomery_barrett.md ;
# doc/04_architecture/lib/ssh_algorithm_catalog.md ;
# doc/05_design/os/ssh/simpleos_ssh_ring3_exec_plan.md
# @manual_section: ffdhe_small_prime_dh

use std.spipe.*
use os.crypto.ffdhe.{
    ffdhe2048_p, ffdhe3072_p, ffdhe4096_p, ffdhe_g,
    ffdhe_keygen, ffdhe_dh,
    ffdhe_pub_to_bytes, ffdhe_bytes_to_pub,
    ffdhe_prime_bytes
}
use os.crypto.sha256.{sha256}


# =============================================================================
# Helpers — module-level to avoid it-block var-mutation footgun.
# =============================================================================

fn _bytes_to_hex(bytes: [u8]) -> text:
    val hex_chars = "0123456789abcdef"
    var result: text = ""
    var i: u64 = 0
    while i < bytes.len():
        val b = bytes[i].to_i64()
        result = result + hex_chars.char_at(b / 16) + hex_chars.char_at(b % 16)
        i = i + 1
    result

# Small test prime p=23 and generator g=2 (all DH arithmetic mod 23).
# Alice private=4 => pub = 2^4 mod 23 = 16
# Bob   private=7 => pub = 2^7 mod 23 = 13
# shared = 13^4 mod 23 = 16^7 mod 23 = 18
fn _small_p() -> list:
    ffdhe_bytes_to_pub([23])

fn _small_g() -> list:
    ffdhe_bytes_to_pub([2])

fn _alice_scalar() -> [u8]:
    [4]

fn _bob_scalar() -> [u8]:
    [7]

describe "FFDHE RFC 7919 — §1 small-prime DH sanity (p=23, g=2)":

    it "Alice pub = g^4 mod 23 = 16":
        # @req REQ-FFDHE-KAT-001
        # @capture(statistics): Alice small-group public key retained as evidence
        step("Derive Alice's public key from private scalar 4 mod 23")
        val p = _small_p()
        val g = _small_g()
        val kp = ffdhe_keygen(p, g, _alice_scalar())
        val pub_bytes = ffdhe_pub_to_bytes(kp[1], 1)
        expect(pub_bytes[0].to_i64()).to_equal(16)  # oracle: 2^4 mod 23 = 16, hand-computed RFC-style KAT

    it "Bob pub = g^7 mod 23 = 13":
        # @req REQ-FFDHE-KAT-001
        # @capture(statistics): Bob small-group public key retained as evidence
        step("Derive Bob's public key from private scalar 7 mod 23")
        val p = _small_p()
        val g = _small_g()
        val kp = ffdhe_keygen(p, g, _bob_scalar())
        val pub_bytes = ffdhe_pub_to_bytes(kp[1], 1)
        expect(pub_bytes[0].to_i64()).to_equal(13)  # oracle: 2^7 mod 23 = 13, hand-computed RFC-style KAT

    it "Alice and Bob derive the same shared secret (18)":
        # @req REQ-FFDHE-KAT-001
        # @capture(statistics): both derived shared secrets retained as evidence
        step("Exchange public keys and derive the shared secret on both sides")
        val p = _small_p()
        val g = _small_g()
        val alice_kp = ffdhe_keygen(p, g, _alice_scalar())
        val bob_kp   = ffdhe_keygen(p, g, _bob_scalar())
        val shared_alice = ffdhe_dh(alice_kp[0], bob_kp[1], p)
        val shared_bob   = ffdhe_dh(bob_kp[0], alice_kp[1], p)
        val sa_bytes = ffdhe_pub_to_bytes(shared_alice, 1)
        val sb_bytes = ffdhe_pub_to_bytes(shared_bob, 1)
        expect(sa_bytes[0].to_i64()).to_equal(18)  # oracle: 13^4 mod 23 = 18 on Alice's side
        expect(sb_bytes[0].to_i64()).to_equal(18)  # oracle: 16^7 mod 23 = 18 on Bob's side — both must agree
        expect(sa_bytes[0]).to_equal(sb_bytes[0])  # oracle: byte equality is the actual DH agreement contract

    it "round-trip byte serialization of small pub key":
        # @req REQ-FFDHE-KAT-003
        # @capture(statistics): serialized and recovered public keys retained as evidence
        step("Serialize Alice's public key to bytes and parse it back")
        val p = _small_p()
        val g = _small_g()
        val kp = ffdhe_keygen(p, g, _alice_scalar())
        val pub_bytes = ffdhe_pub_to_bytes(kp[1], 1)
        val recovered = ffdhe_bytes_to_pub(pub_bytes)
        val recovered_bytes = ffdhe_pub_to_bytes(recovered, 1)
        expect(recovered_bytes[0]).to_equal(pub_bytes[0])  # oracle: parse-then-serialize must reproduce the exact bytes

describe "FFDHE RFC 7919 — §2 ffdhe2048 prime integrity":
    it "ffdhe2048_p() encodes to exactly 256 bytes":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): encoded prime length retained as evidence
        step("Encode the ffdhe2048 prime to its canonical byte width")
        val p = ffdhe2048_p()
        val pb = ffdhe_prime_bytes(p, 256)
        expect(pb.len().to_i64()).to_equal(256)  # oracle: a 2048-bit group encodes to exactly 256 bytes

    it "ffdhe2048 SHA-256 fingerprint matches RFC 7919 Appendix A.1":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): computed prime fingerprint retained as evidence
        step("Hash the encoded ffdhe2048 prime and compare to the RFC constant")
        val p = ffdhe2048_p()
        val pb = ffdhe_prime_bytes(p, 256)
        val fp = _bytes_to_hex(sha256(pb))
        expect(fp).to_equal(
            "d417dfe49b439655f30febdda2200fec593724fd78029662be911a1bcfd701da"
        )  # oracle: SHA-256 of the RFC 7919 A.1 prime bytes, byte-exact

    it "ffdhe2048 first byte is 0xFF":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): leading prime byte retained as evidence
        step("Check the leading byte of the encoded ffdhe2048 prime")
        val p = ffdhe2048_p()
        val pb = ffdhe_prime_bytes(p, 256)
        expect(pb[0].to_i64()).to_equal(255)  # oracle: RFC 7919 primes are padded to the top bit with 0xFF

    it "ffdhe2048 last byte is 0xFF":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): trailing prime byte retained as evidence
        step("Check the trailing byte of the encoded ffdhe2048 prime")
        val p = ffdhe2048_p()
        val pb = ffdhe_prime_bytes(p, 256)
        expect(pb[255].to_i64()).to_equal(255)  # oracle: the RFC constant ends in 0xFF (safe-prime encoding)

# @manual_section: ffdhe_named_group_integrity
describe "FFDHE RFC 7919 — §3 ffdhe3072 prime integrity":

    it "ffdhe3072_p() encodes to exactly 384 bytes":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): encoded 3072-bit prime length retained as evidence
        step("Encode the ffdhe3072 prime to its canonical byte width")
        val p = ffdhe3072_p()
        val pb = ffdhe_prime_bytes(p, 384)
        expect(pb.len().to_i64()).to_equal(384)  # oracle: a 3072-bit group encodes to exactly 384 bytes

    it "ffdhe3072 SHA-256 fingerprint matches RFC 7919 Appendix A.2":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): computed 3072-bit prime fingerprint retained as evidence
        step("Hash the encoded ffdhe3072 prime and compare to the RFC constant")
        val p = ffdhe3072_p()
        val pb = ffdhe_prime_bytes(p, 384)
        val fp = _bytes_to_hex(sha256(pb))
        expect(fp).to_equal(
            "0eaf67db3a839156d5013494a5318a772b5697d270d721f37f092efc69ea5a17"
        )  # oracle: SHA-256 of the RFC 7919 A.2 prime bytes, byte-exact

describe "FFDHE RFC 7919 — §4 ffdhe4096 prime integrity":

    it "ffdhe4096_p() encodes to exactly 512 bytes":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): encoded 4096-bit prime length retained as evidence
        step("Encode the ffdhe4096 prime to its canonical byte width")
        val p = ffdhe4096_p()
        val pb = ffdhe_prime_bytes(p, 512)
        expect(pb.len().to_i64()).to_equal(512)  # oracle: a 4096-bit group encodes to exactly 512 bytes

    it "ffdhe4096 SHA-256 fingerprint matches RFC 7919 Appendix A.3":
        # @req REQ-FFDHE-KAT-002
        # @capture(statistics): computed 4096-bit prime fingerprint retained as evidence
        step("Hash the encoded ffdhe4096 prime and compare to the RFC constant")
        val p = ffdhe4096_p()
        val pb = ffdhe_prime_bytes(p, 512)
        val fp = _bytes_to_hex(sha256(pb))
        expect(fp).to_equal(
            "4648414224ac881b3d0dc59b466f96d06a558278776807797ecf1f66ff397b3e"
        )  # oracle: SHA-256 of the RFC 7919 A.3 prime bytes, byte-exact

describe "FFDHE RFC 7919 — §5 key exchange contracts":

    it "Alice and Bob derive the same shared secret after a public-key byte round-trip":
        # @req REQ-FFDHE-KAT-003
        # @capture(statistics): round-tripped exchange secrets retained as evidence
        step("Serialize Bob's public key, hand the bytes to Alice, and derive both sides")
        val p = _small_p()
        val g = _small_g()
        val alice_kp = ffdhe_keygen(p, g, _alice_scalar())
        val bob_kp   = ffdhe_keygen(p, g, _bob_scalar())
        val bob_pub_bytes = ffdhe_pub_to_bytes(bob_kp[1], 1)
        val recovered_bob_pub = ffdhe_bytes_to_pub(bob_pub_bytes)
        val shared_direct = ffdhe_dh(alice_kp[0], bob_kp[1], p)
        val shared_via_bytes = ffdhe_dh(alice_kp[0], recovered_bob_pub, p)
        val direct_bytes = ffdhe_pub_to_bytes(shared_direct, 1)
        val via_bytes = ffdhe_pub_to_bytes(shared_via_bytes, 1)
        expect(direct_bytes[0].to_i64()).to_equal(18)  # oracle: the direct exchange yields the known 13^4 mod 23 secret
        expect(via_bytes[0]).to_equal(direct_bytes[0])  # oracle: a serialized public key must derive the identical secret

    it "public keys land in the multiplicative range (1 < pub < p-1)":
        # @req REQ-FFDHE-KAT-003
        # @capture(statistics): public-key range verdicts retained as evidence
        step("Derive both parties' public keys and check the DH range contract")
        val p = _small_p()
        val g = _small_g()
        val alice_kp = ffdhe_keygen(p, g, _alice_scalar())
        val bob_kp   = ffdhe_keygen(p, g, _bob_scalar())
        val alice_pub = ffdhe_pub_to_bytes(alice_kp[1], 1)
        val bob_pub = ffdhe_pub_to_bytes(bob_kp[1], 1)
        expect(alice_pub[0].to_i64()).to_be_greater_than(1)  # oracle: a public key of 0 or 1 leaks the private scalar's class
        expect(alice_pub[0].to_i64()).to_be_less_than(22)  # oracle: p-1 = 22 is the degenerate fixed point g^(p-1)/2 and is excluded
        expect(bob_pub[0].to_i64()).to_be_greater_than(1)  # oracle: the range contract binds every party's public key
        expect(bob_pub[0].to_i64()).to_be_less_than(22)  # oracle: both parties must stay inside 1 < pub < p-1
