use std.spec.*
use os._QemuRunner.scenario_catalog.*
use os._QemuRunner.scenario_disks.*
use os._QemuRunner.scenario_exec.*
use os._QemuRunner.os_build_run.*

describe "Phase4 desktop source export repair":
    it "registers the dedicated desktop target":
        expect(scenario_exists("arm64-desktop-engine2d")).to_equal(true)
        val target = scenario_target(scenario_arm64_desktop_engine2d())
        expect(_is_arm64_desktop_engine2d_target(target)).to_equal(true)
        expect(target.output).to_equal("build/os/simpleos_arm64_desktop_engine2d.elf")

    it "rejects generic success without desktop evidence":
        val scenario = scenario_arm64_desktop_engine2d()
        expect(qemu_scenario_serial_accepts_completion(scenario, "off", "TEST PASSED")).to_equal(false)

    it "accepts the actual desktop source marker contract":
        val scenario = scenario_arm64_desktop_engine2d()
        val markers = arm64_desktop_engine2d_required_marker_fragments()
        expect(markers.len()).to_equal(4)
        expect(qemu_scenario_serial_accepts_completion(scenario, "off", markers.join("\n"))).to_equal(true)
        expect(qemu_scenario_serial_accepts_completion(scenario, "off", markers[0] + "\nTEST PASSED")).to_equal(false)

    it "preserves the separate legacy ramfb target":
        val target = scenario_target(scenario_arm64_wm_ramfb())
        expect(_is_arm64_desktop_engine2d_target(target)).to_equal(false)
        expect(target.output).to_equal("build/os/simpleos_arm64_wm.elf")
