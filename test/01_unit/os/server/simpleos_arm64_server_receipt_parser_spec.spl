use std.spec.*
use test.system.simpleos_arm64_servers_qemu_helpers.{
    parse_simpleos_server_execution_receipt_v1
}

fn valid_arm_server_receipt() -> text:
    val hash = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    val document_hash = "772260f72b55b342bf50c825f6793df48ff4cc292c4dd966394b390f10393594"
    "schema=SimpleOsServerExecutionReceiptV1\n" +
    "mode=qemu-arm64-cpu\n" +
    "source_revision=deadbeef\n" +
    "source_manifest_sha256={hash}\n" +
    "source_manifest_file_count=42\n" +
    "source_manifest_roots=src/compiler|src/lib|src/os\n" +
    "target_identity=qemu-system-aarch64:virt:cortex-a72:tcg\n" +
    "executable_sha256={hash}\n" +
    "compiler_sha256={hash}\n" +
    "compiler_admission_schema=simpleos-arm64-current-source-compiler-admission-v1\n" +
    "compiler_admission_receipt_sha256={hash}\n" +
    "kernel_sha256={hash}\n" +
    "image_sha256={hash}\n" +
    "image_staged_sha256={hash}\n" +
    "image_after_commit_sha256={hash}\n" +
    "command_sha256={hash}\n" +
    "utc_time=2026-08-14T00:00:00Z\n" +
    "exit_status=0\n" +
    "http_file_verified=true\n" +
    "http_expected_sha256={document_hash}\n" +
    "http_observed_sha256={document_hash}\n" +
    "db_commit_response_sha256={hash}\n" +
    "db_reboot_response_sha256={hash}\n" +
    "crash_replay_manifest_sha256={hash}\n" +
    "db_commit_verified=true\n" +
    "db_boot1_read_verified=true\n" +
    "db_boot2_read_verified=true\n" +
    "db_reboot_verified=true\n" +
    "crash_replay_matrix_verified=true\n" +
    "crash_replay_seam_count=13\n" +
    "boot1_serial_sha256={hash}\n" +
    "boot2_serial_sha256={hash}\n" +
    "fresh_qemu_processes=2\n" +
    "shutdown_verified=true\n" +
    "gpu_selected=false\n" +
    "gpu_submit_completed=false\n" +
    "device_readback_verified=false\n" +
    "image_contains_credential=true\n" +
    "credential_bytes_retained=false\n" +
    "credential_image_sensitive=true\n" +
    "credential_image_ephemeral=true\n" +
    "credential_image_destroyed_after_run=true\n" +
    "target_credential_zeroization=verified\n" +
    "target_credential_zeroization_method=volatile-u8-exact-byte-readback-v1\n" +
    "target_credential_zeroization_boot1_sha256={hash}\n" +
    "target_credential_zeroization_boot2_sha256={hash}\n" +
    "command=scripts/check/check-simpleos-arm64-servers-qemu.shs qemu-arm64-cpu\n"

describe "SimpleOsServerExecutionReceiptV1 parser":
    it "should accept complete byte and reboot evidence":
        val parsed = parse_simpleos_server_execution_receipt_v1(valid_arm_server_receipt())
        expect(parsed.is_ok()).to_equal(true)
        expect(parsed.unwrap().http_file_verified).to_equal(true)
        expect(parsed.unwrap().db_reboot_verified).to_equal(true)
        expect(parsed.unwrap().target_credential_zeroization_verified).to_equal(true)

    it "should reject a substituted HTTP body hash":
        val forged = valid_arm_server_receipt().replace(
            "http_observed_sha256=772260f72b55b342bf50c825f6793df48ff4cc292c4dd966394b390f10393594",
            "http_observed_sha256=1123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
        expect(parse_simpleos_server_execution_receipt_v1(forged).is_err()).to_equal(true)

    it "should reject missing fresh-process shutdown evidence":
        val forged = valid_arm_server_receipt().replace(
            "fresh_qemu_processes=2", "fresh_qemu_processes=1")
        expect(parse_simpleos_server_execution_receipt_v1(forged).is_err()).to_equal(true)

    it "should reject duplicate receipt fields":
        val forged = valid_arm_server_receipt() + "mode=qemu-arm64-cpu\n"
        expect(parse_simpleos_server_execution_receipt_v1(forged).is_err()).to_equal(true)

    it "should reject an unverified target credential wipe":
        val forged = valid_arm_server_receipt().replace(
            "target_credential_zeroization=verified",
            "target_credential_zeroization=unverified")
        expect(parse_simpleos_server_execution_receipt_v1(forged).is_err()).to_equal(true)
