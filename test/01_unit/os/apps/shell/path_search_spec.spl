"""
## Purpose and audience
Pins the SimpleOS shell PATH discovery contract: how `shell_path_plan`,
`shell_path_candidates`, and `shell_path_resolve_snapshot` turn a PATH string
into ordered, filtered candidates, and how the launcher entry points apply the
same malicious-component filtering. Audience: maintainers of the sosix shell,
the SimpleOS launcher, and the vfs-backed executable loader.
## Operator workflow
Run this file alone with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/os/apps/shell/path_search_spec.spl`
## Compatibility and limitations
The scenarios resolve through the vfs/launcher import chain; on hosts where
that chain fails to load (currently a struct-literal diagnostic raised inside
`src/lib/nogc_async_mut/fs_driver/fat32_stub.spl`), every scenario reports the
load failure before any assertion runs — that is a product-side blocker, not a
spec-side one. The metadata-lookup scenario inspects shipped source text as a
source contract because no runtime API exposes the loader boundary.
## Verification guidance and troubleshooting
A candidate-ordering failure means PATH parsing drifted; a filtering failure
means dot-relative or traversal components leak into resolution and must be
treated as a security regression. Compare the failing expect against
`src/os/apps/shell/path_search.spl` and the launcher resolution helpers in
`src/os/services/launcher/`.
"""
# Lifecycle: doc/01_research/domain/sosix_parallel_qemu_refactor.md ;
# doc/03_plan/agent_tasks/lazy_system_path_variables.md ;
# doc/04_architecture/lazy_system_path_variables.md ;
# doc/05_design/lazy_system_path_variables.md
# @manual_section: shell_path_discovery

use std.spec.{describe, it, expect, step}
use os.apps.shell.path_search.{
    shell_path_plan, shell_path_candidates, shell_path_resolve_snapshot
}
use os.services.launcher.launcher.{
    launcher_command_resolution_candidates, launcher_command_resolution_candidates_with_dirs
}

extern fn rt_file_read_text(path: text) -> text?

describe "SimpleOS shell PATH discovery":
    it "discovers the SimpleBox image in /bin first":
        # @req REQ-SHELL-PATH-001
        # @capture(statistics): resolved /bin catalog path retained as evidence
        step("Build one retained PATH plan and resolve the /bin catalog entry")
        val plan = shell_path_plan("/bin:/usr/bin")
        val resolved = shell_path_resolve_snapshot(
            plan, "simplebox", ["/usr/bin/standalone", "/bin/simplebox"])
        expect(resolved.unwrap()).to_equal("/bin/simplebox")  # oracle: the catalog puts the image in /bin ahead of /usr/bin

    it "discovers a standalone primary tool in /usr/bin":
        # @req REQ-SHELL-PATH-001
        # @capture(statistics): resolved /usr/bin tool path retained as evidence
        step("Resolve the standalone artifact without adding ambient authority")
        val plan = shell_path_plan("/bin:/usr/bin")
        val resolved = shell_path_resolve_snapshot(plan, "standalone", ["/usr/bin/standalone"])
        expect(resolved.unwrap()).to_equal("/usr/bin/standalone")  # oracle: a tool with no /bin catalog entry resolves in /usr/bin

    it "returns nil when no PATH candidate exists":
        # @req REQ-SHELL-PATH-001
        # @capture(statistics): missing-command resolution verdict retained as evidence
        step("Keep a missing command missing")
        val plan = shell_path_plan("/bin:/usr/bin")
        expect(shell_path_resolve_snapshot(plan, "missing", [])).to_be_nil()  # oracle: an unresolvable command stays unresolvable instead of guessing

    it "never treats empty relative or traversal entries as the cwd":
        # @req REQ-SHELL-PATH-002
        # @capture(statistics): filtered candidate list retained as evidence
        step("Reject implicit-current-directory and malformed PATH components")
        val plan = shell_path_plan(":.:relative:/bad//dir:/bin:/tmp/../escape::/usr/bin/")
        val candidates = shell_path_candidates(plan, "simplebox")
        expect(candidates.len()).to_equal(2)  # oracle: only the two well-formed directories survive filtering
        expect(candidates[0]).to_equal("/bin/simplebox")  # oracle: PATH order decides candidate order
        expect(candidates[1]).to_equal("/usr/bin/simplebox")  # oracle: the trailing slash directory normalizes to /usr/bin
        expect(shell_path_candidates(plan, "./simplebox").len()).to_equal(0)  # oracle: an explicit relative command never resolves through PATH
        expect(shell_path_candidates(shell_path_plan(""), "simplebox").len()).to_equal(0)  # oracle: an empty PATH yields no candidates

    it "enforces the same malicious PATH filtering at both launcher entry points":
        # @req REQ-SHELL-PATH-002
        # @capture(statistics): raw and retained launcher candidate lists retained as evidence
        step("Reject dot relative and traversal directories before candidate construction")
        val raw = launcher_command_resolution_candidates(
            "simplebox", "/work", ".:relative:/tmp/../escape:/bin")
        val retained = launcher_command_resolution_candidates_with_dirs(
            "simplebox", "/work", [".", "relative", "/tmp/../escape", "/bin"])
        expect(raw.len()).to_equal(3)  # oracle: one catalog form plus the app dir plus the single clean PATH dir
        expect(retained.len()).to_equal(3)  # oracle: the with-dirs entry point filters identically
        expect(raw[0]).to_equal("/sys/apps/simplebox.smf")  # oracle: packaged app form is tried first
        expect(raw[1]).to_equal("/sys/apps/simplebox")  # oracle: unpacked app form follows the packaged one
        expect(raw[2]).to_equal("/bin/simplebox")  # oracle: the clean PATH dir is the only PATH-derived candidate
        expect(retained[2]).to_equal("/bin/simplebox")  # oracle: both entry points agree on the surviving PATH candidate
        expect(raw.contains("./simplebox")).to_equal(false)  # oracle: dot-relative dirs must not become candidates
        expect(raw.contains("relative/simplebox")).to_equal(false)  # oracle: relative dirs must not become candidates
        expect(raw.contains("/tmp/../escape/simplebox")).to_equal(false)  # oracle: traversal dirs must not become candidates
        expect(retained.contains("./simplebox")).to_equal(false)  # oracle: the with-dirs entry point rejects dot-relative dirs too
        expect(retained.contains("relative/simplebox")).to_equal(false)  # oracle: the with-dirs entry point rejects relative dirs too
        expect(retained.contains("/tmp/../escape/simplebox")).to_equal(false)  # oracle: the with-dirs entry point rejects traversal dirs too

        step("Resolve an explicit relative command against the working directory only")
        val direct = launcher_command_resolution_candidates(
            "./tool", "/work", ".:relative:/tmp/../escape:/bin")
        expect(direct.len()).to_equal(1)  # oracle: an explicit relative command bypasses PATH entirely
        expect(direct[0]).to_equal("/work/./tool")  # oracle: the only candidate is the command as given under the workdir

    it "uses metadata lookup and leaves executable reads to the authenticated loader":
        # @req REQ-SHELL-PATH-003
        # @capture(statistics): loader-boundary source contract verdicts retained as evidence
        step("Pin the no-full-file-read source contract")
        val shipped_path_search_source = rt_file_read_text("src/os/apps/shell/path_search.spl") ?? ""
        val keeps_vfs_exists_probe = shipped_path_search_source.contains("g_vfs_file_exists(candidate)")
        val keeps_loader_owned_reads = shipped_path_search_source.contains("fs_exec_read_executable_bytes")
        val keeps_full_file_reads_out = shipped_path_search_source.contains("g_vfs_read_file")
        expect(keeps_vfs_exists_probe).to_equal(true)  # oracle: resolution probes existence only through the vfs metadata call
        expect(keeps_loader_owned_reads).to_equal(false)  # oracle: path search must not read executable bytes itself
        expect(keeps_full_file_reads_out).to_equal(false)  # oracle: path search must not pull whole files through the vfs

    it "rebuilds immutable PATH plans and keeps launcher lookup forms in parity":
        # @req REQ-SHELL-PATH-001
        # @capture(statistics): plan rebuild and parity candidate pairs retained as evidence
        step("Build a replacement plan and compare raw and retained candidate ordering")
        val before = shell_path_candidates(shell_path_plan("/bin"), "tool")
        val after = shell_path_candidates(shell_path_plan("/usr/bin:/bin"), "tool")
        expect(before[0]).to_equal("/bin/tool")  # oracle: a one-directory plan yields that directory's candidate
        expect(after[0]).to_equal("/usr/bin/tool")  # oracle: a new plan reorders candidates by its own PATH order
        expect(after[1]).to_equal("/bin/tool")  # oracle: the second PATH directory follows the first
        val raw = launcher_command_resolution_candidates("tool", "/", "/usr/bin:/bin")
        val retained = launcher_command_resolution_candidates_with_dirs("tool", "/", ["/usr/bin", "/bin"])
        expect(raw[2]).to_equal(retained[2])  # oracle: clean PATH dirs produce identical candidates at both entry points
        expect(raw[3]).to_equal(retained[3])  # oracle: candidate ordering is identical at both entry points
