use std.spec
use os.apps.shell.pty_provider as pty

describe "SimpleOS PTY provider":
    it "runs expr through an attached ShellApp and closes on exit":
        val h = pty.open(24, 80)
        expect(h >= 0).to_equal(true)
        expect(pty.spawn_v1(h, "/sys/apps/shell").is_ok()).to_equal(true)
        expect(pty.is_running(h)).to_equal(true)
        val _banner = pty.read(h, 0)
        expect(pty.write(h, "expr 40 + 2\n")).to_equal(true)
        expect(pty.read(h, 0).contains("42")).to_equal(true)
        expect(pty.write(h, "exit\n")).to_equal(true)
        expect(pty.is_running(h)).to_equal(false)
        expect(pty.write(h, "echo x\n")).to_equal(false)
        expect(pty.close(h)).to_equal(true)

    it "refuses native spawn of anything else":
        val h = pty.open(24, 80)
        expect(pty.spawn_v1(h, "/bin/sh").is_err()).to_equal(true)
        expect(pty.spawn(h, "cmd.exe")).to_equal(-1)
        expect(pty.close(h)).to_equal(true)
