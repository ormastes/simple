use os.apps.shell.shell_tools.{_toolchain_manifest_paths}
extern fn rt_file_read_text(path: text) -> text

describe "shell toolchain manifest paths":
    it "maps clang commands to clang metadata instead of llvm metadata":
        val clang = _toolchain_manifest_paths("clang")
        expect(clang.version_path).to_equal("/SYS/CLANGVER.TXT")
        expect(clang.manifest_path).to_equal("/SYS/CLANGMAN.TXT")
        expect(clang.canonical_path).to_equal("/usr/bin/clang")

        val clang231 = _toolchain_manifest_paths("clang-23.1")
        expect(clang231.version_path).to_equal("/SYS/CLANGVER.TXT")
        expect(clang231.manifest_path).to_equal("/SYS/CLANGMAN.TXT")
        expect(clang231.canonical_path).to_equal("/usr/bin/clang-23.1")

describe "shell date command production boundary":
    it "fails explicitly instead of returning a fake epoch":
        val source = rt_file_read_text("src/os/apps/shell/_ShellTools/system_tools.spl")

        expect(source.index_of("1970-01-01")).to_equal(-1)
        expect(source.index_of("no RTC available")).to_equal(-1)
        expect(source).to_contain("date: realtime clock unavailable")
        expect(source).to_contain("fn tool_date(terminal: Terminal) -> i32:\n    \"\"\"Show current date/time.\"\"\"\n    _write_error(terminal, \"date: realtime clock unavailable\")\n    return 1")
