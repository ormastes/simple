# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/os/apps/coreutils/chmod_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""
use std.spec.*
use os.apps.coreutils.chmod.{main_chmod, parse_octal}

describe "parse_octal":
    """Octal mode parser."""

    it "parses '0755' as 493":
        """Classic owner-all / group-rx / other-rx."""
        expect parse_octal("0755").to_equal(493i64)

    it "parses '644' as 420":
        """Leading zero is optional."""
        expect parse_octal("644").to_equal(420i64)

    it "rejects non-octal digits":
        """'8' and '9' are not octal."""
        expect parse_octal("788").to_equal(-1i64)

    it "rejects alphabetic input":
        """Letters are never valid in a mode."""
        expect parse_octal("abc").to_equal(-1i64)

    it "rejects the empty string":
        """No input, no mode."""
        expect parse_octal("").to_equal(-1i64)

describe "main_chmod argument parsing":
    """Entry-point argument handling."""

    it "too-few args returns 1":
        """Mode-only or zero-arg calls must fail usage."""
        val rc = main_chmod(["0755"])
        expect rc.to_equal(1i32)

    it "invalid mode returns 1":
        """Bad octal text exits with usage failure."""
        val rc = main_chmod(["xyz", "/tmp/f"])
        expect rc.to_equal(1i32)

    it "valid mode + path returns i32":
        """Happy path returns a numeric status from vfs_chmod."""
        val rc = main_chmod(["0755", "/tmp/f"])
        val is_int: bool = rc == 0i32 or rc != 0i32
        expect is_int.to_equal(true)
