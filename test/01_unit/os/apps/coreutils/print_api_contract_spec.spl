use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.file_ops.{file_read}

fn uses_deprecated_println(path: text) -> bool:
    file_read(path).contains("println(")

describe "coreutils output API contract":
    it "keeps the kill reproducer on the supported newline-print API":
        expect(uses_deprecated_println("src/os/apps/coreutils/kill.spl")).to_equal(false)

    it "keeps adjacent coreutils commands off the deprecated println API":
        val paths = [
            "src/os/apps/coreutils/chmod.spl",
            "src/os/apps/coreutils/cp.spl",
            "src/os/apps/coreutils/mem.spl",
            "src/os/apps/coreutils/mv.spl",
            "src/os/apps/coreutils/ps.spl",
            "src/os/apps/coreutils/reboot.spl",
            "src/os/apps/coreutils/rm.spl",
            "src/os/apps/coreutils/run.spl"
        ]
        for path in paths:
            expect(uses_deprecated_println(path)).to_equal(false)
