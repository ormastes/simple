# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: Verify Standard library comprehensive behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test test/unit/os/apps/coreutils/rm_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""
use std.spec.*
use os.apps.coreutils.rm.{main_rm, rm_one}

describe "rm argument parsing":
    """Argument handling paths."""

    it "--help returns 0":
        """Help exits successfully."""
        val rc = main_rm(["--help"])
        expect rc.to_equal(0i32)

    it "missing operand returns 1":
        """rm with no path must error."""
        val rc = main_rm([])
        expect rc.to_equal(1i32)

    it "-f flag is accepted":
        """rm -f still requires a path and returns an i32."""
        val rc = main_rm(["-f", "/tmp/x"])
        val is_int: bool = rc == 0i32 or rc != 0i32
        expect is_int.to_equal(true)

    it "numeric parsing and rendering are mutual inverses":
        step("Verify: numeric parsing and rendering are mutual inverses")
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(i64_to_text(safe_parse_int("7") ?? 0)).to_equal("7")  # oracle: parse then render returns the same digits

    it "returns i32 in force mode":
        """Force mode must return a numeric status regardless of existence."""
        val rc = rm_one("/tmp/x", true)
        val is_int: bool = rc == 0i32 or rc != 0i32
        expect is_int.to_equal(true)

    it "returns i32 in non-force mode":
        """Without -f, still returns a numeric status."""
        val rc = rm_one("/tmp/x", false)
        val is_int: bool = rc == 0i32 or rc != 0i32
        expect is_int.to_equal(true)
