"""
## Purpose and audience
Purpose: Prove that known_hosts store.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-APPS-001 — stable requirement identity for this spec.

"""
# Pure-Simple SSH Client — Host Key Pinning and In-Process Key Exchange

**Feature IDs:** N/A
**Category:** Infrastructure
**Difficulty:** 4/5
**Status:** Implemented

## Overview

The security core of the client. An SSH client that does not pin the server
host key hands the whole session to a man in the middle, so every case here
asserts a CLOSED failure, not a warning.

The "server" in this file is not a mock: the KEX_ECDH_REPLY is produced by the
REAL sshd builders (`ssh_build_kexinit`, `ssh_build_kex_ecdh_reply`), the
shared secret and exchange hash come from the REAL sshd key-exchange core
(`ssh_kex_compute_shared`, `ssh_kex_compute_exchange_hash`), and the host-key
signature is a REAL ed25519 signature from `os.crypto.ed25519`. Client and
server are therefore driven against each other in-process, byte for byte,
without a socket.

Covers:
  1. known_hosts parsing, base64 round-trip, malformed-store rejection.
  2. Unknown host key -> REFUSED. Changed host key -> REFUSED as a mismatch.
  3. Exact match -> accepted.
  4. Signature over the exchange hash verifies with the right host key and
     FAILS with the wrong one.
  5. Full in-process client<->server key exchange producing session keys, and
     the same exchange refused when the host key is not pinned.

tag: unit, ssh, ssh_client, security, crypto
"""

use std.spipe.*
use os.apps.ssh_client.ssh_known_hosts.{
    SshKnownHostsDb, SshKnownHostEntry,
    ssh_known_hosts_parse, ssh_known_hosts_verify, ssh_known_hosts_status,
    ssh_known_hosts_line, ssh_base64_encode_bytes, ssh_base64_decode_bytes,
    SSH_HOSTKEY_OK, SSH_HOSTKEY_UNKNOWN, SSH_HOSTKEY_MISMATCH
}
use os.apps.ssh_client.ssh_client_kex.{
    ssh_client_build_kex_ecdh_init, ssh_client_parse_kex_ecdh_reply,
    ssh_client_ed25519_host_key, ssh_client_ed25519_signature,
    ssh_client_verify_host_signature, ssh_client_complete_kex
}
use os.apps.ssh_client.ssh_client_kexinit.{ssh_client_build_kexinit}
use os.apps.ssh_client.ssh_client_version.{ssh_client_version_bytes}
use os.apps.sshd.ssh_transport.{ssh_build_kexinit}
use os.apps.sshd.ssh_kex.{ssh_build_kex_ecdh_reply, ssh_parse_kex_ecdh_init}
use os.apps.sshd.ssh_kex_core.{
    ssh_kex_public_from_private, ssh_kex_compute_shared, ssh_kex_compute_exchange_hash
}
use os.apps.sshd.ssh_kex_primitives.{ssh_build_ed25519_host_key_blob}
use os.apps.sshd.ssh_packet.{ssh_put_text, ssh_put_string, ssh_ascii_text_to_bytes}
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_sign}

# ============================================================================
# Deterministic fixtures — no randomness, so the whole handshake is reproducible
# ============================================================================

fn seed32(base: u8) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < 32:
        out.push(base + i.to_u8())
        i = i + 1
    out

fn cookie16() -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < 16:
        out.push(0x11)
        i = i + 1
    out

fn bstr(s: text) -> [u8]:
    var src = ssh_ascii_text_to_bytes(s)
    var out: [u8] = []
    var i: u64 = 0
    while i < src.len():
        out.push(src[i])
        i = i + 1
    out

fn host_key_blob(seed_base: u8) -> [u8]:
    """Real ssh-ed25519 host key blob for a deterministic seed."""
    val pair = ed25519_keypair_from_seed(seed32(seed_base))
    ssh_build_ed25519_host_key_blob(pair.1)

fn host_private(seed_base: u8) -> [u8]:
    val pair = ed25519_keypair_from_seed(seed32(seed_base))
    pair.0

fn host_public(seed_base: u8) -> [u8]:
    val pair = ed25519_keypair_from_seed(seed32(seed_base))
    pair.1

fn server_version_bytes() -> [u8]:
    bstr("SSH-2.0-SimpleOS_1.0")

fn signature_blob(raw_signature: [u8]) -> [u8]:
    var buf: [u8] = []
    buf = ssh_put_text(buf, "ssh-ed25519")
    buf = ssh_put_string(buf, raw_signature)
    buf

fn known_hosts_for(host: text, seed_base: u8) -> SshKnownHostsDb:
    val content = ssh_known_hosts_line(host, "ssh-ed25519", host_key_blob(seed_base))
    ssh_known_hosts_parse(content).unwrap()

fn empty_known_hosts() -> SshKnownHostsDb:
    ssh_known_hosts_parse("").unwrap()

# ============================================================================
# In-process server: every byte produced by the REAL sshd implementation.
# ============================================================================

fn server_kex_reply(host_seed: u8, server_private: [u8], client_kexinit: [u8], client_public: [u8]) -> [u8]:
    """Play the sshd side of curve25519 KEX and return the wire reply payload."""
    val blob = host_key_blob(host_seed)
    val server_public = ssh_kex_public_from_private(server_private)
    val shared = ssh_kex_compute_shared(server_private, client_public)
    val exchange_hash = ssh_kex_compute_exchange_hash(
        ssh_client_version_bytes(),
        server_version_bytes(),
        client_kexinit,
        ssh_build_kexinit(),
        blob,
        client_public,
        server_public,
        shared
    )
    val raw_signature = ed25519_sign(host_private(host_seed), host_public(host_seed), exchange_hash)
    ssh_build_kex_ecdh_reply(blob, server_public, signature_blob(raw_signature))

fn server_exchange_hash(host_seed: u8, server_private: [u8], client_kexinit: [u8], client_public: [u8]) -> [u8]:
    val server_public = ssh_kex_public_from_private(server_private)
    val shared = ssh_kex_compute_shared(server_private, client_public)
    ssh_kex_compute_exchange_hash(
        ssh_client_version_bytes(),
        server_version_bytes(),
        client_kexinit,
        ssh_build_kexinit(),
        host_key_blob(host_seed),
        client_public,
        server_public,
        shared
    )

# ============================================================================

use std.spec.step

describe "known_hosts store":

    it "round-trips a host key blob through base64":
        step("Verify: round-trips a host key blob through base64")
        # @req: REQ-OS-APPS-001
        val blob = host_key_blob(1)
        val encoded = ssh_base64_encode_bytes(blob)
        val decoded = ssh_base64_decode_bytes(encoded)
        expect(decoded.is_ok()).to_equal(true)
        expect(decoded.unwrap()).to_equal(blob)
        expect(blob.len()).to_equal(51)  # oracle: 51 — named expected value from the requirement

    it "parses a store line and ignores comments and blank lines":
        step("Verify: parses a store line and ignores comments and blank lines")
        val content = "# comment\n\n" + ssh_known_hosts_line("simpleos", "ssh-ed25519", host_key_blob(1))
        val parsed = ssh_known_hosts_parse(content)
        expect(parsed.is_ok()).to_equal(true)
        val db = parsed.unwrap()
        expect(db.entries.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(db.entries[0].host).to_equal("simpleos")
        expect(db.entries[0].algorithm).to_equal("ssh-ed25519")

    it "expands a comma-separated host alias list into one entry per host":
        step("Verify: expands a comma-separated host alias list into one entry per host")
        val encoded = ssh_base64_encode_bytes(host_key_blob(1))
        val parsed = ssh_known_hosts_parse("simpleos,10.0.2.15 ssh-ed25519 " + encoded)
        expect(parsed.is_ok()).to_equal(true)
        expect(parsed.unwrap().entries.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "rejects a malformed store instead of silently returning an empty one":
        step("Verify: rejects a malformed store instead of silently returning an empty one")
        val short_line = ssh_known_hosts_parse("simpleos ssh-ed25519")
        expect(short_line.is_ok()).to_equal(false)
        expect(short_line.unwrap_err()).to_contain("malformed line")
        val bad_base64 = ssh_known_hosts_parse("simpleos ssh-ed25519 not*valid*base64")
        expect(bad_base64.is_ok()).to_equal(false)
        expect(bad_base64.unwrap_err()).to_contain("base64")

describe "server host key verification":

    it "accepts a host key that matches the pinned entry exactly":
        step("Verify: accepts a host key that matches the pinned entry exactly")
        val db = known_hosts_for("simpleos", 1)
        val verdict = ssh_known_hosts_verify(db, "simpleos", "ssh-ed25519", host_key_blob(1))
        expect(verdict.is_ok()).to_equal(true)
        expect(verdict.unwrap()).to_equal(true)
        expect(ssh_known_hosts_status(db, "simpleos", "ssh-ed25519", host_key_blob(1))).to_equal(SSH_HOSTKEY_OK)

    it "REFUSES an unknown host key":
        step("Verify: REFUSES an unknown host key")
        val db = empty_known_hosts()
        val verdict = ssh_known_hosts_verify(db, "simpleos", "ssh-ed25519", host_key_blob(1))
        expect(verdict.is_ok()).to_equal(false)
        expect(verdict.unwrap_err()).to_contain("unknown host key")
        expect(verdict.unwrap_err()).to_contain("refusing to connect")
        expect(ssh_known_hosts_status(db, "simpleos", "ssh-ed25519", host_key_blob(1))).to_equal(SSH_HOSTKEY_UNKNOWN)

    it "REFUSES a host key that changed for a known host":
        step("Verify: REFUSES a host key that changed for a known host")
        val db = known_hosts_for("simpleos", 1)
        val verdict = ssh_known_hosts_verify(db, "simpleos", "ssh-ed25519", host_key_blob(200))
        expect(verdict.is_ok()).to_equal(false)
        expect(verdict.unwrap_err()).to_contain("HOST KEY MISMATCH")
        expect(verdict.unwrap_err()).to_contain("man-in-the-middle")
        expect(ssh_known_hosts_status(db, "simpleos", "ssh-ed25519", host_key_blob(200))).to_equal(SSH_HOSTKEY_MISMATCH)

    it "REFUSES a key pinned for a different host name":
        step("Verify: REFUSES a key pinned for a different host name")
        val db = known_hosts_for("other-host", 1)
        val verdict = ssh_known_hosts_verify(db, "simpleos", "ssh-ed25519", host_key_blob(1))
        expect(verdict.is_ok()).to_equal(false)
        expect(verdict.unwrap_err()).to_contain("unknown host key")

    it "REFUSES an empty host key blob":
        step("Verify: REFUSES an empty host key blob")
        val db = known_hosts_for("simpleos", 1)
        val verdict = ssh_known_hosts_verify(db, "simpleos", "ssh-ed25519", [])
        expect(verdict.is_ok()).to_equal(false)
        expect(verdict.unwrap_err()).to_contain("empty key blob")

