# @cover src/os/apps/dbd/dbd_protocol.spl 100%
"""
# DBD boot credential ownership

The boot owner streams bounded source bytes into SHA-256, admits a verifier
only after compiler-resistant source and hash-workspace wipe readback, and
revokes the old verifier before reload.
"""

use std.spec
use std.common.crypto.secure_memory.{secure_zero_u8_slots}
use os.apps.dbd.dbd_protocol.{
    DbdAuthSession, DbdBootCredentialOwnerV1, DbdBootCredentialStateV1
}

fn _credential(value: u8, count: i64) -> [u8]:
    var out: [u8] = []
    var index = 0
    while index < count:
        out.push(value)
        index = index + 1
    out

fn _stream_and_wipe(owner: DbdBootCredentialOwnerV1, source: [u8]) -> bool:
    owner.admit_source(source)

describe "DBD boot credential owner":
    it "admits the streamed digest only after exact source and workspace wipe":
        var source = _credential(0x5au8, 32)
        var owner = DbdBootCredentialOwnerV1.new("operator")
        expect(_stream_and_wipe(owner, source)).to_be(true)
        expect(owner.state).to_equal(DbdBootCredentialStateV1.Admitted)
        expect(owner.hash_workspace_zeroized).to_be(true)
        expect(owner.provider.configured).to_be(true)
        expect(source).to_equal([0u8; 32])
        var session = DbdAuthSession.new(1)
        expect(session.authenticate(
            owner.provider, "operator", _credential(0x5au8, 32))).to_be(true)

    it "cannot authorize one source by wiping an unrelated equal-length buffer":
        var source = _credential(0x41u8, 32)
        var owner = DbdBootCredentialOwnerV1.new("operator")
        var unrelated = _credential(0x42u8, 32)
        val unrelated_report = secure_zero_u8_slots(unrelated)
        expect(unrelated_report.verified()).to_be(true)
        expect(owner.provider.configured).to_be(false)
        expect(source).to_equal(_credential(0x41u8, 32))
        expect(owner.admit_source(source)).to_be(true)
        expect(source).to_equal([0u8; 32])

    it "quarantines bounded overflow without retaining raw bytes":
        var owner = DbdBootCredentialOwnerV1.new("operator")
        var source = _credential(0x33u8, 129)
        expect(owner.admit_source(source)).to_be(false)
        expect(source).to_equal([0u8; 129])
        expect(owner.state).to_equal(DbdBootCredentialStateV1.Quarantined)
        expect(owner.provider.configured).to_be(false)
        expect(owner.hash_workspace_zeroized).to_be(true)

    it "revokes the old verifier before loading a replacement":
        var first = _credential(0x11u8, 32)
        var owner = DbdBootCredentialOwnerV1.new("operator")
        expect(_stream_and_wipe(owner, first)).to_be(true)
        expect(owner.begin_reload("operator-2")).to_be(true)
        expect(owner.provider.configured).to_be(false)
        var second = _credential(0x22u8, 32)
        expect(_stream_and_wipe(owner, second)).to_be(true)
        var old_session = DbdAuthSession.new(2)
        expect(old_session.authenticate(
            owner.provider, "operator", _credential(0x11u8, 32))).to_be(false)
        var new_session = DbdAuthSession.new(3)
        expect(new_session.authenticate(
            owner.provider, "operator-2", _credential(0x22u8, 32))).to_be(true)
        owner.revoke()
        expect(owner.state).to_equal(DbdBootCredentialStateV1.Revoked)
        expect(owner.provider.configured).to_be(false)

    it "wipes rejected sources and revokes authority in every non-loading state":
        var admitted = DbdBootCredentialOwnerV1.new("operator")
        var first = _credential(0x31u8, 32)
        expect(admitted.admit_source(first)).to_be(true)
        var after_admit = _credential(0x32u8, 32)
        expect(admitted.admit_source(after_admit)).to_be(false)
        expect(after_admit).to_equal([0u8; 32])
        expect(admitted.provider.configured).to_be(false)
        expect(admitted.state).to_equal(DbdBootCredentialStateV1.Quarantined)

        var revoked = DbdBootCredentialOwnerV1.new("operator")
        var second = _credential(0x41u8, 32)
        expect(revoked.admit_source(second)).to_be(true)
        revoked.revoke()
        var after_revoke = _credential(0x42u8, 32)
        expect(revoked.admit_source(after_revoke)).to_be(false)
        expect(after_revoke).to_equal([0u8; 32])
        expect(revoked.provider.configured).to_be(false)

        var quarantined = DbdBootCredentialOwnerV1.new("operator")
        var oversized = _credential(0x51u8, 129)
        expect(quarantined.admit_source(oversized)).to_be(false)
        var after_quarantine = _credential(0x52u8, 32)
        expect(quarantined.admit_source(after_quarantine)).to_be(false)
        expect(after_quarantine).to_equal([0u8; 32])
        expect(quarantined.provider.configured).to_be(false)
