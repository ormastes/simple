# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/os/apps/dbd/dbd_dbfs_adapter.spl 90%
"""
# dbd DBFS adapter — mounted driver evidence without false durability

Proves that hosted DBFS cannot impersonate a durable device owner. Device
flush/crash/reopen behavior is covered by dbfs_durable_commit_spec; this unit
lane covers DBD admission, bounds, and quarantine transitions.
"""

use std.spec.step

use std.spec
use std.spec.step
use os.apps.dbd.dbd_dbfs_adapter.{
    DbdDbfsAdapter, DbdDbfsAdapterState, dbd_dbfs_adapter_from_driver,
    dbd_dbfs_adapter_from_filesystem_vfs, DBD_DBFS_MAX_RECOVERY_BYTES,
    DBD_DBFS_JOURNAL_PATH_V1
}
use std.db.dbfs_driver.dbfs_driver.{DbFsDriver}
use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.mem_block_device.{MemBlockDevice}
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.ramfs.{RamFsDriver}
use std.fs_driver.types.{Path, OpenFlags}

var _dbd_test_next_id: i64 = 1
var _dbd_test_ids: [i64] = []
var _dbd_test_flushes: [i64] = []
var _dbd_test_fail_flush: [bool] = []
var _dbd_test_fail_reads_after: [i64] = []

fn _dbd_test_idx(id: i64) -> i32:
    var i: i32 = 0
    while i < _dbd_test_ids.len() as i32:
        if _dbd_test_ids[i] == id: return i
        i = i + 1
    -1

struct DbdDurableTestDevice:
    id: i64
    inner: MemBlockDevice

impl DbdDurableTestDevice:
    static fn new() -> DbdDurableTestDevice:
        val id = _dbd_test_next_id
        _dbd_test_next_id = _dbd_test_next_id + 1
        _dbd_test_ids.push(id)
        _dbd_test_flushes.push(0)
        _dbd_test_fail_flush.push(false)
        _dbd_test_fail_reads_after.push(-1)
        DbdDurableTestDevice(id: id, inner: MemBlockDevice.new(64u64, 512u32))

    fn fail_flush():
        _dbd_test_fail_flush[_dbd_test_idx(self.id)] = true

    fn fail_reads_after_flushes(count: i64):
        _dbd_test_fail_reads_after[_dbd_test_idx(self.id)] = count

impl BlockDevice for DbdDurableTestDevice:
    fn read_sector(lba: u64) -> Result<[u8], text>:
        val idx = _dbd_test_idx(self.id)
        if idx < 0: return Err("test device missing")
        if _dbd_test_fail_reads_after[idx] >= 0 and
                _dbd_test_flushes[idx] >= _dbd_test_fail_reads_after[idx]:
            return Err("injected post-flush read failure")
        self.inner.read_sector(lba)

    me fn write_sector(lba: u64, data: [u8]) -> Result<bool, text>:
        self.inner.write_sector(lba, data)

    fn sector_size() -> u32: 512u32

    me fn flush() -> Result<bool, text>:
        val idx = _dbd_test_idx(self.id)
        if idx < 0 or _dbd_test_fail_flush[idx]:
            return Err("injected flush failure")
        _dbd_test_flushes[idx] = _dbd_test_flushes[idx] + 1
        Ok(true)


fn _mounted_adapter(): DbdDbfsAdapter:
    val driver = DbFsDriver.new_hosted()
    dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))

describe "dbd DBFS adapter durable admission":
    # @manual scenario evidence
    it "recognizes hosted DBFS but keeps readiness blocked on device authority":
        # @req REQ-SSPEC-UNIT
        step("recognizes hosted DBFS but keeps readiness blocked on device authority")
        val adapter = _mounted_adapter()
        expect(adapter.state).to_equal(DbdDbfsAdapterState.MountedSyncUnsupported)
        expect(adapter.ready()).to_be(false)
        expect(adapter.blocker()).to_equal("dbfs-not-device-backed")
        assert_true(adapter.driver_instance_id > 0)

    it "rejects commit before creating or mutating the journal":
        # @req REQ-SSPEC-UNIT
        step("rejects commit before creating or mutating the journal")
        val driver = DbFsDriver.new_hosted()
        var adapter = dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))
        val committed = adapter.commit_and_sync("/DBD.LOG", [1u8, 2u8, 3u8])
        expect(committed.is_err()).to_be(true)
        expect(committed.unwrap_err()).to_equal("dbfs-not-device-backed")
        expect(driver.stat_path(Path(raw: "/DBD.LOG")).is_err()).to_be(true)

    it "rejects a mounted driver that is not DBFS":
        # @req REQ-SSPEC-UNIT
        step("rejects a mounted driver that is not DBFS")
        val adapter = dbd_dbfs_adapter_from_driver(
            DriverInstance.RamFs(RamFsDriver.new()))
        expect(adapter.state).to_equal(DbdDbfsAdapterState.Detached)
        expect(adapter.ready()).to_be(false)
        expect(adapter.blocker()).to_equal("mounted-root-is-not-dbfs")

    it "blocks the disconnected filesystem syscall path without a false receipt":
        val adapter = dbd_dbfs_adapter_from_filesystem_vfs()
        expect(adapter.ready()).to_be(false)
        expect(adapter.blocker()).to_equal(
            "filesystem-vfs-dbfs-operation-authority-unavailable")

describe "dbd device-backed verified commit":
    it "issues a generation-bound receipt only after device flush and readback":
        val dev = DbdDurableTestDevice.new()
        val driver = DbFsDriver.open_on_device(dev, 0, 64).unwrap()
        var adapter = dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))
        val committed = adapter.commit_and_sync(
            DBD_DBFS_JOURNAL_PATH_V1, [1u8, 2u8, 3u8, 4u8])
        expect(committed.is_ok()).to_be(true)
        val receipt = committed.unwrap()
        expect(receipt.driver_instance_id).to_equal(driver.inst_id)
        expect(receipt.commit_generation).to_equal(1i64)
        expect(receipt.byte_count).to_equal(4i64)
        expect(adapter.open_handles).to_equal(0i64)
        expect(adapter.ready()).to_be(true)

    it "quarantines an exact post-flush read failure as uncertain":
        val dev = DbdDurableTestDevice.new()
        dev.fail_reads_after_flushes(2)
        val driver = DbFsDriver.open_on_device(dev, 0, 64).unwrap()
        var adapter = dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))
        val committed = adapter.commit_and_sync(
            DBD_DBFS_JOURNAL_PATH_V1, [9u8, 8u8, 7u8])
        expect(committed.is_err()).to_be(true)
        expect(adapter.state).to_equal(DbdDbfsAdapterState.Quarantined)
        expect(adapter.commit_outcome_uncertain()).to_be(true)
        expect(adapter.open_handles).to_equal(0i64)
        expect(adapter.reset_for_restart()).to_be(true)
        expect(adapter.ready()).to_be(false)

    it "rejects a flush failure before acknowledging publication":
        val dev = DbdDurableTestDevice.new()
        dev.fail_flush()
        val driver = DbFsDriver.open_on_device(dev, 0, 64).unwrap()
        var adapter = dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))
        val committed = adapter.commit_and_sync(
            DBD_DBFS_JOURNAL_PATH_V1, [4u8, 5u8])
        expect(committed.is_err()).to_be(true)
        expect(adapter.ready()).to_be(false)
        expect(adapter.commit_outcome_uncertain()).to_be(false)

    it "retains verification-handle authority after an unproved close":
        var adapter = DbdDbfsAdapter(
            state: DbdDbfsAdapterState.Quarantined,
            driver: nil,
            driver_instance_id: 41,
            generation: 3,
            open_handles: 1,
            last_error: "dbfs-commit-postflush-verify-close-failed",
            filesystem_vfs: false,
            filesystem_vfs_transactional_replace: false,
            filesystem_vfs_generation: 0u64)
        expect(adapter.commit_outcome_uncertain()).to_be(true)
        expect(adapter.close()).to_be(false)
        expect(adapter.reset_for_restart()).to_be(false)
        expect(adapter.open_handles).to_equal(1i64)

describe "dbd DBFS adapter bounded recovery read":
    it "reads exact existing journal bytes through the typed driver":
        # @req REQ-SSPEC-UNIT
        step("reads exact existing journal bytes through the typed driver")
        val driver = DbFsDriver.new_hosted()
        val opened = driver.open_path(
            Path(raw: "/DBD.LOG"), OpenFlags.read_write().with_create())
        expect(opened.is_ok()).to_be(true)
        val handle = opened.unwrap()
        expect(driver.write_bytes_handle(handle, [7u8, 8u8, 9u8]).is_ok()).to_be(true)
        expect(driver.close_handle(handle).is_ok()).to_be(true)
        var adapter = dbd_dbfs_adapter_from_driver(DriverInstance.DbFs(driver))
        val read = adapter.read_existing_bounded("/DBD.LOG", 64)
        expect(read.is_ok()).to_be(true)
        expect(read.unwrap()).to_equal([7u8, 8u8, 9u8])
        expect(adapter.open_handles).to_equal(0i64)

    it "rejects missing files and invalid or oversized read bounds":
        # @req REQ-SSPEC-UNIT
        step("rejects missing files and invalid or oversized read bounds")
        var adapter = _mounted_adapter()
        expect(adapter.read_existing_bounded("/DBD.LOG", 64).is_err()).to_be(true)
        expect(adapter.read_existing_bounded("/other", 64).is_err()).to_be(true)
        expect(adapter.read_existing_bounded(
            "/DBD.LOG", DBD_DBFS_MAX_RECOVERY_BYTES + 1
        ).is_err()).to_be(true)

describe "dbd DBFS adapter quarantine and restart":
    it "restart releases the driver but preserves quarantine evidence":
        # @req REQ-SSPEC-UNIT
        step("restart releases the driver but preserves quarantine evidence")
        var adapter = _mounted_adapter()
        expect(adapter.quarantine("dbfs-recovery-corrupt-journal")).to_be(true)
        expect(adapter.state).to_equal(DbdDbfsAdapterState.Quarantined)
        expect(adapter.read_existing_bounded("/DBD.LOG", 64).is_err()).to_be(true)
        expect(adapter.commit_and_sync("/DBD.LOG", [1u8]).is_err()).to_be(true)
        val previous_generation = adapter.generation
        expect(adapter.reset_for_restart()).to_be(true)
        expect(adapter.state).to_equal(DbdDbfsAdapterState.Quarantined)
        expect(adapter.blocker()).to_equal("dbfs-recovery-corrupt-journal")
        expect(adapter.driver.is_none()).to_be(true)
        expect(adapter.generation).to_equal(previous_generation + 1)
        expect(adapter.ready()).to_be(false)
