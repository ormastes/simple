"""

# doc-path: doc/01_research/local/ssh_ct_auth_compare_spec.md
# doc-path: doc/03_plan/sys_test/ssh_ct_auth_compare_spec.md
# doc-path: doc/04_architecture/ssh_ct_auth_compare_spec.md
# doc-path: doc/05_design/ssh_ct_auth_compare_spec_oracles.md
# @manual: primary

# Plan A3: constant-time auth comparison helpers in the SimpleOS sshd.
# Verifies _ct_bytes_equal return values for equal, unequal, and
# length-mismatched inputs. Credentials are configured through the provider.
# (timing constancy is a property of the code shape, not observable here).

use std.spec.{describe, it, expect}
use os.apps.sshd.ssh_session_auth.{_ct_bytes_equal}

describe "A3 constant-time byte comparison":
    # @manual scenario evidence
    it "returns true for equal byte arrays":
        # @req REQ-SSPEC-UNIT
        step("returns true for equal byte arrays")
        expect(_ct_bytes_equal([1u8, 2u8, 3u8, 4u8], [1u8, 2u8, 3u8, 4u8])).to_equal(true)

    it "returns false when a single byte differs":
        # @req REQ-SSPEC-UNIT
        step("returns false when a single byte differs")
        expect(_ct_bytes_equal([1u8, 2u8, 3u8, 4u8], [1u8, 2u8, 9u8, 4u8])).to_equal(false)

    it "returns false when the first byte differs":
        # @req REQ-SSPEC-UNIT
        step("returns false when the first byte differs")
        expect(_ct_bytes_equal([9u8, 2u8, 3u8], [1u8, 2u8, 3u8])).to_equal(false)

    it "returns false on a length mismatch (shorter)":
        # @req REQ-SSPEC-UNIT
        step("returns false on a length mismatch (shorter)")
        expect(_ct_bytes_equal([1u8, 2u8], [1u8, 2u8, 3u8])).to_equal(false)

    it "returns false on a length mismatch (longer)":
        # @req REQ-SSPEC-UNIT
        step("returns false on a length mismatch (longer)")
        expect(_ct_bytes_equal([1u8, 2u8, 3u8, 4u8], [1u8, 2u8, 3u8])).to_equal(false)

    it "returns true for two empty arrays":
        # @req REQ-SSPEC-UNIT
        step("returns true for two empty arrays")
        expect(_ct_bytes_equal([], [])).to_equal(true)
