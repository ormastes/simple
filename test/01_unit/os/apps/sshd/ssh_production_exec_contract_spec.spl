extern fn rt_file_read_text(path: text) -> text
use os.apps.sshd.ssh_exec_status_contract.{sshd_unsupported_architecture_exec_result_v1}

describe "SSHD production filesystem execution contract":
    it "removes canned Simple output and the RV64 combined command shortcut":
        val session = rt_file_read_text("src/os/apps/sshd/ssh_session.spl")
        val channel = rt_file_read_text("src/os/apps/sshd/ssh_session_channel.spl")
        val daemon = rt_file_read_text("src/os/apps/sshd/sshd.spl")
        val host = rt_file_read_text("src/os/ssh_qemu_contract.spl")
        expect(session.contains("_exec_success_output_for_command")).to_be(false)
        expect(channel.contains("_ssh_exec_simple_session_bytes")).to_be(false)
        expect(channel.contains("simple.smf --version; simple --check")).to_be(false)
        expect(host.contains("simple.smf --version; simple --check")).to_be(false)
        expect(daemon).to_contain("riscv64_fs_exec_spawn_capture(resolved, argv")
        expect(daemon).to_contain("riscv64_fs_exec_failed_capture(127)")
        expect(daemon).to_contain("x86_64_fs_exec_spawn(resolved, argv")
        expect(daemon).to_contain("var argv: [text] = []\n    var i: u64 = 1")
        expect(daemon).to_contain("var argv: [text] = [resolved]\n    var i: u64 = 1")
        expect(daemon.contains("rv64_process_stdout_last_result")).to_be(false)
        expect(session).to_contain("pending_ring3_exec_stdout")
        expect(session).to_contain("exec_tx: [SshExecTxV1]")
        expect(session).to_contain("val SSH_EXIT_REMOTE_WINDOW_EXHAUSTED: u32 = 125u32")
        expect(channel).to_contain("me _queue_exec_response(")
        expect(channel).to_contain("me _drain_exec_response(local_id: u32) -> bool:")
        expect(channel).to_contain("self._drain_exec_response(adjusted_recipient)")
        expect(channel).to_contain("channel.remote_max_packet")
        expect(channel).to_contain("if limit > DEFAULT_MAX_PACKET.to_u64():")
        expect(channel.contains("if output.len() > 0 and self.channels.consume_remote_window")).to_be(false)
        expect(channel).to_contain("self._finish_exec_request(local_id, remote_id, exit_code, stdout)")
        expect(channel).to_contain("if self._exec_tx_index(local_id) >= 0:")
        expect(channel).to_contain("self.do_interactive()")
        expect(channel).to_contain("pump_rounds < 16u32")
        expect(channel).to_contain("self._drop_exec_response(local_id)")
        expect(channel).to_contain("remote_id, SSH_EXIT_REMOTE_WINDOW_EXHAUSTED")
        expect(channel).to_contain("if self.state != SshSessionState.Closed:")
        expect(daemon).to_contain("while session.pending_ring3_exec and deferred_launches < 16u32:")
        expect(channel.contains("deferred exec output window timeout")).to_be(false)
        expect(channel.contains("deferred exec stdout blocked by remote window")).to_be(false)
        expect(daemon).to_contain("[sshd] accept resumed")
        expect(host).to_contain("run_ssh_probe(\"rv64\", cmd_parts, timeout_ms)")
        expect(host).to_contain("root@127.0.0.1 \"simple --version\"")
        expect(host).to_contain("root@127.0.0.1 \"simple.smf --version\"")
        expect(host).to_contain("openssh-bad-auth-start")
        expect(host).to_contain("accept-resumed-probe-start")
        expect(host).to_contain("accept_resumed_count")

    it "fails closed when a target has no filesystem exec launcher":
        val daemon = rt_file_read_text("src/os/apps/sshd/sshd.spl")
        val (output, status, truncated) = sshd_unsupported_architecture_exec_result_v1()
        expect(output.len()).to_equal(0)
        expect(status).to_equal(126)
        expect(truncated).to_be(false)
        expect(daemon).to_contain("@cfg(x86)\nfn _sshd_run_pending_exec_result(_command: text) -> ([u8], i64, bool):\n    sshd_unsupported_architecture_exec_result_v1()")
        expect(daemon).to_contain("@cfg(arm64)\nfn _sshd_run_pending_exec_result(_command: text) -> ([u8], i64, bool):\n    sshd_unsupported_architecture_exec_result_v1()")
        expect(daemon).to_contain("@cfg(arm32)\nfn _sshd_run_pending_exec_result(_command: text) -> ([u8], i64, bool):\n    sshd_unsupported_architecture_exec_result_v1()")
        expect(daemon).to_contain("@cfg(riscv32)\nfn _sshd_run_pending_exec_result(_command: text) -> ([u8], i64, bool):\n    sshd_unsupported_architecture_exec_result_v1()")
        expect(daemon).to_contain("riscv64_fs_exec_spawn_capture(resolved, argv")
        expect(daemon).to_contain("x86_64_fs_exec_spawn_heap(resolved, argv")
