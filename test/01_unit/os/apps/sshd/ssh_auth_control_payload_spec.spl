"""Direct framing coverage for response-free SSH transport control packets."""

# @cover src/os/apps/sshd/ssh_session_helpers.spl 20%
use std.spipe.*
use os.apps.sshd.ssh_session_helpers.{ssh_control_payload_valid_v1}
use os.apps.sshd.ssh_transport.{SSH_MSG_IGNORE, SSH_MSG_UNIMPLEMENTED, SSH_MSG_DEBUG, SSH_MSG_EXT_INFO}

describe "pre-auth SSH transport control framing":
    it "accepts exact response-free control payloads":
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_IGNORE, 0u8, 0u8, 0u8, 0u8], SSH_MSG_IGNORE)).to_be(true)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_UNIMPLEMENTED, 0u8, 0u8, 0u8, 7u8],
            SSH_MSG_UNIMPLEMENTED)).to_be(true)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_DEBUG, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
            SSH_MSG_DEBUG)).to_be(true)

    it "rejects truncated and trailing advisory fields":
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_DEBUG, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
            SSH_MSG_IGNORE)).to_be(false)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_IGNORE, 0u8, 0u8, 0u8, 1u8], SSH_MSG_IGNORE)).to_be(false)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_IGNORE, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8],
            SSH_MSG_IGNORE)).to_be(false)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_UNIMPLEMENTED, 0u8, 0u8, 0u8, 7u8, 0u8],
            SSH_MSG_UNIMPLEMENTED)).to_be(false)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_DEBUG, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
            SSH_MSG_DEBUG)).to_be(false)

    it "rejects peer EXT_INFO without ext-info-c authority":
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_EXT_INFO, 0u8, 0u8, 0u8, 1u8,
             0u8, 0u8, 0u8, 1u8, 0x78u8,
             0u8, 0u8, 0u8, 1u8, 0x79u8],
            SSH_MSG_EXT_INFO)).to_be(false)
        expect(ssh_control_payload_valid_v1(
            [SSH_MSG_EXT_INFO, 0u8, 0u8, 0u8, 0u8],
            SSH_MSG_EXT_INFO)).to_be(false)
