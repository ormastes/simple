"""
## Purpose and audience
Purpose: Prove that bounded SFTP v3 protocol core.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-APPS-001 — stable requirement identity for this spec.

# @cover src/os/apps/sshd/ssh_sftp_v3.spl 80%
use std.spipe.*
use os.apps.sshd.ssh_sftp_v3.{SftpSessionV3}
use os.apps.sshd.ssh_session.{ssh_channel_request_is_sftp}
use os.apps.sshd.ssh_packet.{ssh_put_u32, ssh_put_string, ssh_put_text, ssh_get_u32}
extern fn rt_file_read_text(path: text) -> text

fn _frame(body: [u8]) -> [u8]:
    var out: [u8] = []
    out = ssh_put_u32(out, body.len().to_u32())
    for byte in body: out.push(byte)
    out

fn _request(kind: u8, id: u32) -> [u8]:
    var body: [u8] = [kind]
    ssh_put_u32(body, id)

fn _open_request(id: u32, path: text, pflags: u32) -> [u8]:
    var body = _request(3u8, id)
    body = ssh_put_text(body, path)
    body = ssh_put_u32(body, pflags)
    body = ssh_put_u32(body, 0u32)
    _frame(body)

fn _write_request(id: u32, handle: [u8], offset: u64, data: [u8]) -> [u8]:
    var body = _request(6u8, id)
    body = ssh_put_string(body, handle)
    body = ssh_put_u32(body, (offset >> 32).to_u32())
    body = ssh_put_u32(body, offset.to_u32())
    body = ssh_put_string(body, data)
    _frame(body)

fn _read_request(id: u32, handle: [u8], offset: u64, length: u32) -> [u8]:
    var body = _request(5u8, id)
    body = ssh_put_string(body, handle)
    body = ssh_put_u32(body, (offset >> 32).to_u32())
    body = ssh_put_u32(body, offset.to_u32())
    body = ssh_put_u32(body, length)
    _frame(body)

fn _close_request(id: u32, handle: [u8]) -> [u8]:
    var body = _request(4u8, id)
    body = ssh_put_string(body, handle)
    _frame(body)

fn _stat_request(id: u32, path: text) -> [u8]:
    var body = _request(17u8, id)
    body = ssh_put_text(body, path)
    _frame(body)

fn _sftp_subsystem_request(name: [u8]) -> [u8]:
    var payload: [u8] = [98, 0, 0, 0, 0, 0, 0, 0, 9]
    val subsystem: [u8] = [0x73, 0x75, 0x62, 0x73, 0x79, 0x73, 0x74, 0x65, 0x6D]
    for byte in subsystem:
        payload.push(byte)
    payload.push(1)
    payload.push(0)
    payload.push(0)
    payload.push(0)
    payload.push(name.len().to_u8())
    for byte in name:
        payload.push(byte)
    payload

use std.spec.step

describe "bounded SFTP v3 protocol core":
    it "negotiates version 3":
        step("Verify: negotiates version 3")
        # @req: REQ-OS-APPS-001
        var session = SftpSessionV3.new()
        val response = session.handle_packet([0, 0, 0, 5, 1, 0, 0, 0, 3])
        expect(response[4]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(response[8]).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "rejects requests before initialization":
        step("Verify: rejects requests before initialization")
        var session = SftpSessionV3.new()
        val response = session.handle_packet([0, 0, 0, 5, 17, 0, 0, 0, 1])
        expect(response[4]).to_equal(101)  # oracle: 101 — named expected value from the requirement

    it "rejects traversal without filesystem access":
        step("Verify: rejects traversal without filesystem access")
        var session = SftpSessionV3.new()
        session.handle_packet([0, 0, 0, 5, 1, 0, 0, 0, 3])
        # STAT id=7, string length 8, ../etc/passwd
        val response = session.handle_packet([0, 0, 0, 11, 17, 0, 0, 0, 7, 0, 0, 0, 2, 46, 46])
        expect(response[4]).to_equal(101)  # oracle: 101 — named expected value from the requirement
        expect(response[8]).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "bounds malformed and oversized packets":
        step("Verify: bounds malformed and oversized packets")
        var session = SftpSessionV3.new()
        val partial = session.handle_packet([])
        expect(partial.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val response = session.handle_packet([0, 0, 0, 0])
        expect(response[4]).to_equal(101)  # oracle: 101 — named expected value from the requirement

    it "retains a split length header":
        step("Verify: retains a split length header")
        var session = SftpSessionV3.new()
        val first = session.handle_packet([0, 0])
        expect(first.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val second = session.handle_packet([0, 5, 1, 0, 0, 0, 3])
        expect(second[4]).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "accepts a complete frame fragmented one byte at a time":
        step("Verify: accepts a complete frame fragmented one byte at a time")
        var session = SftpSessionV3.new()
        var response: [u8] = []
        val frame: [u8] = [0, 0, 0, 5, 1, 0, 0, 0, 3]
        for byte in frame:
            response = session.handle_packet([byte])
        expect(response[4]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(response[8]).to_equal(3)  # oracle: 3 — named expected value from the requirement
        val work = session.accumulator_work()
        expect(work.admitted_ingress_bytes).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(work.copied_bytes).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(work.header_scan_bytes).to_equal(24)  # oracle: 24 — named expected value from the requirement
        expect(work.complete_frames).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(work.peak_retained_bytes).to_equal(9)  # oracle: 9 — named expected value from the requirement
        expect(work.saturated).to_be(false)

    it "retains a coalesced second frame":
        step("Verify: retains a coalesced second frame")
        var session = SftpSessionV3.new()
        val frames: [u8] = [0, 0, 0, 5, 1, 0, 0, 0, 3, 0, 0, 0, 5, 1, 0, 0, 0, 3]
        val first = session.handle_packet(frames)
        expect(first[4]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val second = session.handle_packet([])
        expect(second[4]).to_equal(2)  # oracle: 2 — named expected value from the requirement
        val work = session.accumulator_work()
        expect(work.admitted_ingress_bytes).to_equal(18)  # oracle: 18 — named expected value from the requirement
        expect(work.copied_bytes).to_equal(36)  # oracle: 36 — named expected value from the requirement
        expect(work.header_scan_bytes).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(work.complete_frames).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "live SSH SFTP subsystem routing":
    it "recognizes only the exact SFTP subsystem request":
        step("Verify: recognizes only the exact SFTP subsystem request")
        expect(ssh_channel_request_is_sftp(_sftp_subsystem_request([0x73, 0x66, 0x74, 0x70]))).to_be(true)
        expect(ssh_channel_request_is_sftp(_sftp_subsystem_request([0x73, 0x63, 0x70]))).to_be(false)

    it "rejects trailing bytes after the subsystem name":
        step("Verify: rejects trailing bytes after the subsystem name")
        var request = _sftp_subsystem_request([0x73, 0x66, 0x74, 0x70])
        request.push(0)
        expect(ssh_channel_request_is_sftp(request)).to_be(false)
