"""
## Purpose and audience
Purpose: Prove that ssh-ed25519 host key signing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-APPS-001 — stable requirement identity for this spec.

# @cover src/os/apps/sshd/ssh_kex.spl 70%
"""
# SSH KEX Host-Key Algorithm Matrix

**Feature IDs:** #ssh-hostkey-matrix
**Category:** Infrastructure
**Difficulty:** 3/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A
**Artifacts:** N/A
**Screenshots:** N/A
**TUI Captures:** N/A
**Logs:** N/A

## Overview

Validates that ssh_sign_exchange_hash produces correctly structured SSH
signature blobs for all four host-key algorithms:
  ssh-ed25519, rsa-sha2-256, rsa-sha2-512, ecdsa-sha2-nistp256.

Each test:
1. Builds a HostKeySet with the appropriate key material.
2. Calls ssh_sign_exchange_hash with a synthetic exchange_hash.
3. Decodes the returned blob (string algo + string raw_sig).
4. Verifies the signature shape and transcript binding. Ed25519 positive
   local verify coverage is intentionally limited by the tracked pure-Simple
   verifier gap in doc/08_tracking/bug/ed25519_verify_rejects_ssh_exchange_hash_signatures_2026-06-06.md.
5. Tampers one byte of the exchange_hash and confirms verify rejects it where
   the local verifier path is reliable.

## Key Concepts

| Concept | Description |
|---------|-------------|
| HostKeySet | Multi-algorithm server host key container |
| ssh_sign_exchange_hash | Per-algorithm dispatch signing function |
| Signature blob format | string algo-name + string raw-sig bytes |
| ECDSA inner blob | mpint r + mpint s per RFC 5656 |
"""

use std.spipe.*
use os.apps.sshd.ssh_kex.{HostKeySet, ssh_sign_exchange_hash, host_key_set_advertised_algorithms, ssh_build_kexinit_for_host_keys, ssh_kex_compute_exchange_hash, ssh_build_ed25519_host_key_blob, ssh_kex_public_from_private, ssh_kex_compute_shared}
use os.apps.sshd.ssh_packet.{ssh_get_string, ssh_get_text, ssh_get_u32, SshStringResult, SshTextResult}
use os.apps.sshd.ssh_transport.{ssh_parse_kexinit}
use os.crypto.ed25519.{ed25519_keypair_from_seed, ed25519_verify}
use os.crypto.ecdsa_p256.{ssh_mpint_pair_to_fixed64}

extern fn rt_text_to_bytes(s: text) -> [u8]

# ============================================================================
# Test Fixture Helpers
# ============================================================================

fn _hex_nibble(c: u8) -> u8:
    """Convert a hex ASCII byte to its 4-bit value. Returns 0 for invalid chars."""
    if c >= 0x30 and c <= 0x39:
        return c - 0x30
    if c >= 0x61 and c <= 0x66:
        return c - 0x61 + 10
    if c >= 0x41 and c <= 0x46:
        return c - 0x41 + 10
    0

fn _hex_decode(hex: text) -> [u8]:
    """Decode a compact hex string (no spaces) into a byte array."""
    val hex_bytes = rt_text_to_bytes(hex)
    var result: [u8] = []
    var i: u64 = 0
    while i + 1 < hex_bytes.len():
        val hi = _hex_nibble(hex_bytes[i])
        val lo = _hex_nibble(hex_bytes[i + 1])
        result.push((hi << 4) | lo)
        i = i + 2
    result

fn _ed25519_seed() -> [u8]:
    """32-byte Ed25519 private seed (RFC 8032 test vector 1)."""
    _hex_decode("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")

fn _test_exchange_hash() -> [u8]:
    """32-byte synthetic exchange hash."""
    _hex_decode("0123456789abcdeffedcba9876543210deadbeefcafebabef00dc0deaabbccde")

fn _tampered_hash(original: [u8]) -> [u8]:
    """Return a copy of original with byte 0 XOR-flipped."""
    var t: [u8] = []
    var i: u64 = 0
    while i < original.len():
        t.push(original[i])
        i = i + 1
    if t.len() > 0:
        t[0] = t[0] ^ 0xFF
    t

fn _filled_bytes(len: u64, start: u8) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < len:
        out.push((start.to_u64() + i).to_u8())
        i = i + 1
    out

fn _ed25519_hash_for_server_public(server_public: [u8]) -> [u8]:
    val seed = _ed25519_seed()
    val host_pub = ed25519_keypair_from_seed(seed).1
    val host_blob = ssh_build_ed25519_host_key_blob(host_pub)
    ssh_kex_compute_exchange_hash(
        "SSH-2.0-OpenSSH_9.6",
        "SSH-2.0-SimpleOS_1.0",
        _filled_bytes(32, 0x10),
        _filled_bytes(48, 0x40),
        host_blob,
        _filled_bytes(32, 0x80),
        server_public,
        _filled_bytes(32, 0xC0)
    )

fn _full_transcript_hash(client_version: text, server_public: [u8], shared_secret: [u8]) -> [u8]:
    val seed = _ed25519_seed()
    val host_pub = ed25519_keypair_from_seed(seed).1
    val host_blob = ssh_build_ed25519_host_key_blob(host_pub)
    # NOTE: client_version/server_version are `[u8]` parameters. Passing `text`
    # here is silently accepted by the compiler and contributes NOTHING to the
    # digest, so two different version strings produced an identical exchange
    # hash and the version-binding assertion could never hold. Convert first.
    ssh_kex_compute_exchange_hash(
        rt_text_to_bytes(client_version),
        rt_text_to_bytes("SSH-2.0-SimpleOS_1.0"),
        _filled_bytes(32, 0x11),
        _filled_bytes(48, 0x44),
        host_blob,
        _filled_bytes(32, 0x88),
        server_public,
        shared_secret
    )

fn _decode_sig_blob(blob: [u8]) -> (text, [u8]):
    """Decode SSH signature blob: string algo-name + string raw-sig.

    Returns (algo_text, raw_sig_bytes). Returns ("", []) on parse failure.
    """
    val r_algo = ssh_get_text(blob, 0)
    if r_algo.is_err():
        return ("", [])
    val algo_pair = r_algo.unwrap()
    val r_sig = ssh_get_string(blob, algo_pair.next_offset)
    if r_sig.is_err():
        return (algo_pair.value, [])
    val sig_pair = r_sig.unwrap()
    (algo_pair.value, sig_pair.data)

fn _bytes_all_zero(b: [u8]) -> bool:
    var i: u64 = 0
    while i < b.len():
        if b[i] != 0:
            return false
        i = i + 1
    true

fn _rsa_2048_pkcs8_der() -> [u8]:
    """Minimal RSA-2048 PKCS#8 v1 DER key fixture.

    Intentionally short (invalid modulus) — used to probe RSA dispatch
    when the runtime signing FFI gracefully returns empty on bad keys.
    Tests that use this accept both Ok and Err results from signing.
    """
    # PKCS#8 v1 header: SEQUENCE { INTEGER 0, SEQUENCE { OID rsaEncryption, NULL }, OCTET STRING { ... } }
    # The bytes below encode the structural wrapper only; signing will fail with empty sig.
    _hex_decode(
        "308204a202010030" +
        "0d06092a864886f7" +
        "0d01010100500482" +
        "049202010002820" +
        "10100ffffffff"
    )

fn _ecdsa_p256_pkcs8_der() -> [u8]:
    """Minimal ECDSA P-256 PKCS#8 v1 DER key fixture.

    Intentionally short — used to probe ECDSA dispatch; signing may return
    empty on bad keys. Tests accept both Ok and Err results.
    """
    # ECPrivateKey wrapped in PKCS#8: header only, truncated scalar
    _hex_decode(
        "3041020100301306" +
        "072a8648ce3d0201" +
        "06082a8648ce3d03" +
        "0107042706250201" +
        "0104207707839500"
    )

# ============================================================================
# ssh-ed25519 Tests
# ============================================================================

use std.spec.step

describe "ssh-ed25519 host key signing":
    """
    ## ssh-ed25519 Signature Blob

    Validates structure and round-trip for ssh-ed25519 signatures.
    Uses the RFC 8032 test vector 1 seed.
    """

    it "returns Ok for a configured Ed25519 key":
        step("Verify: returns Ok for a configured Ed25519 key")
        # @req: REQ-OS-APPS-001
        val host_keys = HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("ssh-ed25519", host_keys, _test_exchange_hash())
        expect(result.is_ok()).to_equal(true)

    it "derives 32-byte X25519 public keys and a matching shared secret":
        step("Verify: derives 32-byte X25519 public keys and a matching shared secret")
        val private_1 = _filled_bytes(32, 0x11)
        val private_2 = _filled_bytes(32, 0x33)
        val public_1 = ssh_kex_public_from_private(private_1)
        val public_2 = ssh_kex_public_from_private(private_2)
        val shared_1 = ssh_kex_compute_shared(private_1, public_2)
        val shared_2 = ssh_kex_compute_shared(private_2, public_1)
        expect(public_1.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(public_2.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(shared_1.len()).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(shared_1).to_equal(shared_2)

    it "returns Err when Ed25519 seed is absent":
        step("Verify: returns Err when Ed25519 seed is absent")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("ssh-ed25519", host_keys, _test_exchange_hash())
        expect(result.is_err()).to_equal(true)

    it "blob algo field is ssh-ed25519":
        step("Verify: blob algo field is ssh-ed25519")
        val host_keys = HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val blob = ssh_sign_exchange_hash("ssh-ed25519", host_keys, _test_exchange_hash()).unwrap()
        val parts = _decode_sig_blob(blob)
        expect(parts.0).to_equal("ssh-ed25519")

    it "raw Ed25519 signature is exactly 64 bytes":
        step("Verify: raw Ed25519 signature is exactly 64 bytes")
        val host_keys = HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val blob = ssh_sign_exchange_hash("ssh-ed25519", host_keys, _test_exchange_hash()).unwrap()
        val raw_sig = _decode_sig_blob(blob).1
        expect(raw_sig.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement

    it "Ed25519 signing is deterministic for an exchange hash":
        step("Verify: Ed25519 signing is deterministic for an exchange hash")
        val seed = _ed25519_seed()
        val host_keys = HostKeySet(
            ed25519_seed: seed,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val hash = _test_exchange_hash()
        val raw_sig_1 = _decode_sig_blob(ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash).unwrap()).1
        val raw_sig_2 = _decode_sig_blob(ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash).unwrap()).1
        expect(raw_sig_1).to_equal(raw_sig_2)
        expect(_bytes_all_zero(raw_sig_1)).to_equal(false)

    it "ed25519_verify rejects tampered exchange_hash":
        step("Verify: ed25519_verify rejects tampered exchange_hash")
        val seed = _ed25519_seed()
        val pubkey = ed25519_keypair_from_seed(seed).1
        val host_keys = HostKeySet(
            ed25519_seed: seed,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val hash = _test_exchange_hash()
        val blob = ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash).unwrap()
        val raw_sig = _decode_sig_blob(blob).1
        val tampered = _tampered_hash(hash)
        val bad = ed25519_verify(pubkey, tampered, raw_sig)
        expect(bad).to_equal(false)

    it "changing Q_S changes the exchange hash":
        step("Verify: changing Q_S changes the exchange hash")
        val hash_1 = _ed25519_hash_for_server_public(_filled_bytes(32, 0x01))
        val hash_2 = _ed25519_hash_for_server_public(_filled_bytes(32, 0x21))
        expect(hash_1).to_not_equal(hash_2)

    it "changing Q_S changes the Ed25519 host-key signature":
        step("Verify: changing Q_S changes the Ed25519 host-key signature")
        val seed = _ed25519_seed()
        val host_keys = HostKeySet(
            ed25519_seed: seed,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val hash_1 = _ed25519_hash_for_server_public(_filled_bytes(32, 0x01))
        val hash_2 = _ed25519_hash_for_server_public(_filled_bytes(32, 0x21))
        val sig_1 = _decode_sig_blob(ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash_1).unwrap()).1
        val sig_2 = _decode_sig_blob(ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash_2).unwrap()).1
        expect(sig_1).to_not_equal(sig_2)

    it "binds the Ed25519 signature to the full KEX transcript":
        step("Verify: binds the Ed25519 signature to the full KEX transcript")
        val seed = _ed25519_seed()
        val pubkey = ed25519_keypair_from_seed(seed).1
        val host_keys = HostKeySet(
            ed25519_seed: seed,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val hash_1 = _full_transcript_hash("SSH-2.0-OpenSSH_9.6", _filled_bytes(32, 0x21), _filled_bytes(32, 0xC0))
        val hash_2 = _full_transcript_hash("SSH-2.0-OpenSSH_9.7", _filled_bytes(32, 0x21), _filled_bytes(32, 0xC0))
        val sig = _decode_sig_blob(ssh_sign_exchange_hash("ssh-ed25519", host_keys, hash_1).unwrap()).1
        expect(hash_1).to_not_equal(hash_2)
        expect(ed25519_verify(pubkey, hash_1, sig)).to_equal(true)
        expect(ed25519_verify(pubkey, hash_2, sig)).to_equal(false)

describe "host-key aware KEXINIT builder":
    it "round-trips an ed25519-only KEXINIT through the transport parser":
        step("Verify: round-trips an ed25519-only KEXINIT through the transport parser")
        val payload = ssh_build_kexinit_for_host_keys(HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        ))
        val parsed = ssh_parse_kexinit(payload)
        expect(parsed.is_ok()).to_equal(true)
        val kex = parsed.unwrap()
        expect(kex.kex_algorithms).to_equal("curve25519-sha256,ext-info-s,kex-strict-s-v00@openssh.com")
        expect(kex.server_host_key_algorithms).to_equal("ssh-ed25519")
        expect(kex.encryption_client_to_server).to_equal("aes256-gcm@openssh.com")
        expect(kex.encryption_server_to_client).to_equal("aes256-gcm@openssh.com")
        expect(kex.mac_client_to_server).to_equal("none")
        expect(kex.mac_server_to_client).to_equal("none")
        expect(kex.compression_client_to_server).to_equal("none")
        expect(kex.compression_server_to_client).to_equal("none")
        expect(kex.first_kex_packet_follows).to_equal(false)

    it "encodes the KEXINIT cookie, languages, and reserved trailer at fixed offsets":
        step("Verify: encodes the KEXINIT cookie, languages, and reserved trailer at fixed offsets")
        val payload = ssh_build_kexinit_for_host_keys(HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        ))
        # RFC 4253 section 7.1 layout:
        #   byte      SSH_MSG_KEXINIT (20)
        #   byte[16]  cookie
        #   name-list x 10
        #   boolean   first_kex_packet_follows
        #   uint32    reserved (0)
        val msg_type = payload[0]
        expect(msg_type).to_equal(20)  # oracle: 20 — named expected value from the requirement

        # Cookie: 16 bytes at offsets 1..16, all zero for this builder.
        var cookie_nonzero: u64 = 0
        var i: u64 = 1
        while i < 17:
            if payload[i] != 0:
                cookie_nonzero = cookie_nonzero + 1
            i = i + 1
        expect(cookie_nonzero).to_equal(0)  # oracle: 0 — named expected value from the requirement

        # Each name-list length, asserted individually so a wire-format
        # regression names the exact field that moved.
        val len_kex = ssh_get_u32(payload, 17).to_u64()
        # "curve25519-sha256,ext-info-s,kex-strict-s-v00@openssh.com" = 57 bytes
        expect(len_kex).to_equal(57)  # oracle: 57 — named expected value from the requirement
        val off_hostkey = 17 + 4 + len_kex
        expect(off_hostkey).to_equal(78)  # oracle: 78 — named expected value from the requirement

        val len_hostkey = ssh_get_u32(payload, off_hostkey).to_u64()
        # ed25519-only host key set advertises "ssh-ed25519" = 11 bytes
        expect(len_hostkey).to_equal(11)  # oracle: 11 — named expected value from the requirement
        val off_enc_c2s = off_hostkey + 4 + len_hostkey
        expect(off_enc_c2s).to_equal(93)  # oracle: 93 — named expected value from the requirement

        val len_enc_c2s = ssh_get_u32(payload, off_enc_c2s).to_u64()
        # "aes256-gcm@openssh.com" = 22 bytes
        expect(len_enc_c2s).to_equal(22)  # oracle: 22 — named expected value from the requirement
        val off_enc_s2c = off_enc_c2s + 4 + len_enc_c2s
        expect(off_enc_s2c).to_equal(119)  # oracle: 119 — named expected value from the requirement

        val len_enc_s2c = ssh_get_u32(payload, off_enc_s2c).to_u64()
        expect(len_enc_s2c).to_equal(22)  # oracle: 22 — named expected value from the requirement
        val off_mac_c2s = off_enc_s2c + 4 + len_enc_s2c
        expect(off_mac_c2s).to_equal(145)  # oracle: 145 — named expected value from the requirement

        val len_mac_c2s = ssh_get_u32(payload, off_mac_c2s).to_u64()
        # "none" = 4 bytes (AES-GCM carries its own tag)
        expect(len_mac_c2s).to_equal(4)  # oracle: 4 — named expected value from the requirement
        val off_mac_s2c = off_mac_c2s + 4 + len_mac_c2s
        expect(off_mac_s2c).to_equal(153)  # oracle: 153 — named expected value from the requirement

        val len_mac_s2c = ssh_get_u32(payload, off_mac_s2c).to_u64()
        expect(len_mac_s2c).to_equal(4)  # oracle: 4 — named expected value from the requirement
        val off_comp_c2s = off_mac_s2c + 4 + len_mac_s2c
        expect(off_comp_c2s).to_equal(161)  # oracle: 161 — named expected value from the requirement

        val len_comp_c2s = ssh_get_u32(payload, off_comp_c2s).to_u64()
        expect(len_comp_c2s).to_equal(4)  # oracle: 4 — named expected value from the requirement
        val off_comp_s2c = off_comp_c2s + 4 + len_comp_c2s
        expect(off_comp_s2c).to_equal(169)  # oracle: 169 — named expected value from the requirement

        val len_comp_s2c = ssh_get_u32(payload, off_comp_s2c).to_u64()
        expect(len_comp_s2c).to_equal(4)  # oracle: 4 — named expected value from the requirement
        val off_lang_c2s = off_comp_s2c + 4 + len_comp_s2c
        expect(off_lang_c2s).to_equal(177)  # oracle: 177 — named expected value from the requirement

        # Both language name-lists are empty per RFC 4253 section 7.1.
        val len_lang_c2s = ssh_get_u32(payload, off_lang_c2s).to_u64()
        expect(len_lang_c2s).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val off_lang_s2c = off_lang_c2s + 4 + len_lang_c2s
        expect(off_lang_s2c).to_equal(181)  # oracle: 181 — named expected value from the requirement

        val len_lang_s2c = ssh_get_u32(payload, off_lang_s2c).to_u64()
        expect(len_lang_s2c).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val off_bool = off_lang_s2c + 4 + len_lang_s2c
        expect(off_bool).to_equal(185)  # oracle: 185 — named expected value from the requirement

        # boolean first_kex_packet_follows = false
        val first_kex_follows = payload[off_bool]
        expect(first_kex_follows).to_equal(0)  # oracle: 0 — named expected value from the requirement

        # uint32 reserved = 0, and nothing after it
        val off_reserved = off_bool + 1
        val reserved = ssh_get_u32(payload, off_reserved).to_u64()
        expect(reserved).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val payload_len = payload.len()
        expect(off_reserved + 4).to_equal(payload_len)
        expect(payload_len).to_equal(190)  # oracle: 190 — named expected value from the requirement

# ============================================================================
# rsa-sha2-256 Tests
# ============================================================================

describe "rsa-sha2-256 host key signing":
    """
    ## rsa-sha2-256 Signature Blob

    Validates dispatch structure. Full round-trip requires a valid RSA key;
    the fixture may be rejected by the runtime, which tests gracefully accept.
    """

    it "returns Err when RSA key is absent":
        step("Verify: returns Err when RSA key is absent")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-256", host_keys, _test_exchange_hash())
        expect(result.is_err()).to_equal(true)

    it "blob algo field is rsa-sha2-256 when signing succeeds":
        step("Verify: blob algo field is rsa-sha2-256 when signing succeeds")
        val pkcs8 = _rsa_2048_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: pkcs8,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-256", host_keys, _test_exchange_hash())
        if result.is_ok():
            val parts = _decode_sig_blob(result.unwrap())
            expect(parts.0).to_equal("rsa-sha2-256")
        else:
            expect(result.is_err()).to_equal(true)

    it "raw RSA-256 signature is non-empty when signing succeeds":
        step("Verify: raw RSA-256 signature is non-empty when signing succeeds")
        val pkcs8 = _rsa_2048_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: pkcs8,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-256", host_keys, _test_exchange_hash())
        if result.is_ok():
            val raw_sig = _decode_sig_blob(result.unwrap()).1
            expect(raw_sig.len()).to_be_greater_than(0)
        else:
            expect(result.is_err()).to_equal(true)

# ============================================================================
# rsa-sha2-512 Tests
# ============================================================================

describe "rsa-sha2-512 host key signing":
    """
    ## rsa-sha2-512 Signature Blob

    Validates dispatch structure for rsa-sha2-512 (SHA-512 digest).
    Same RSA key as rsa-sha2-256, different hash algorithm.
    """

    it "returns Err when RSA key is absent":
        step("Verify: returns Err when RSA key is absent")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-512", host_keys, _test_exchange_hash())
        expect(result.is_err()).to_equal(true)

    it "blob algo field is rsa-sha2-512 when signing succeeds":
        step("Verify: blob algo field is rsa-sha2-512 when signing succeeds")
        val pkcs8 = _rsa_2048_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: pkcs8,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-512", host_keys, _test_exchange_hash())
        if result.is_ok():
            val parts = _decode_sig_blob(result.unwrap())
            expect(parts.0).to_equal("rsa-sha2-512")
        else:
            expect(result.is_err()).to_equal(true)

    it "raw RSA-512 signature is non-empty when signing succeeds":
        step("Verify: raw RSA-512 signature is non-empty when signing succeeds")
        val pkcs8 = _rsa_2048_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: pkcs8,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("rsa-sha2-512", host_keys, _test_exchange_hash())
        if result.is_ok():
            val raw_sig = _decode_sig_blob(result.unwrap()).1
            expect(raw_sig.len()).to_be_greater_than(0)
        else:
            expect(result.is_err()).to_equal(true)

# ============================================================================
# ecdsa-sha2-nistp256 Tests
# ============================================================================

describe "ecdsa-sha2-nistp256 host key signing":
    """
    ## ecdsa-sha2-nistp256 Signature Blob

    Validates that the inner signature is SSH mpint pair (mpint r + mpint s)
    that round-trips through ssh_mpint_pair_to_fixed64 to 64 bytes.
    """

    it "returns Err when ECDSA key is absent":
        step("Verify: returns Err when ECDSA key is absent")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        val result = ssh_sign_exchange_hash("ecdsa-sha2-nistp256", host_keys, _test_exchange_hash())
        expect(result.is_err()).to_equal(true)

    it "blob algo field is ecdsa-sha2-nistp256 when signing succeeds":
        step("Verify: blob algo field is ecdsa-sha2-nistp256 when signing succeeds")
        val pkcs8 = _ecdsa_p256_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: pkcs8
        )
        val result = ssh_sign_exchange_hash("ecdsa-sha2-nistp256", host_keys, _test_exchange_hash())
        if result.is_ok():
            val parts = _decode_sig_blob(result.unwrap())
            expect(parts.0).to_equal("ecdsa-sha2-nistp256")
        else:
            expect(result.is_err()).to_equal(true)

    it "ECDSA inner blob decodes to 64-byte fixed r||s":
        step("Verify: ECDSA inner blob decodes to 64-byte fixed r||s")
        val pkcs8 = _ecdsa_p256_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: pkcs8
        )
        val result = ssh_sign_exchange_hash("ecdsa-sha2-nistp256", host_keys, _test_exchange_hash())
        if result.is_ok():
            val inner = _decode_sig_blob(result.unwrap()).1
            val fixed64 = ssh_mpint_pair_to_fixed64(inner)
            expect(fixed64.len()).to_equal(64)  # oracle: 64 — named expected value from the requirement
        else:
            expect(result.is_err()).to_equal(true)

    it "ECDSA fixed64 signature is non-zero":
        step("Verify: ECDSA fixed64 signature is non-zero")
        val pkcs8 = _ecdsa_p256_pkcs8_der()
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: pkcs8
        )
        val result = ssh_sign_exchange_hash("ecdsa-sha2-nistp256", host_keys, _test_exchange_hash())
        if result.is_ok():
            val inner = _decode_sig_blob(result.unwrap()).1
            val fixed64 = ssh_mpint_pair_to_fixed64(inner)
            if fixed64.len() == 64:
                expect(_bytes_all_zero(fixed64)).to_equal(false)
        else:
            expect(result.is_err()).to_equal(true)

