# ============================================================================
# host_key_set_advertised_algorithms Tests
# ============================================================================

describe "host_key_set_advertised_algorithms":
    """
    ## HostKeySet Algorithm Advertisement

    Verifies comma-separated algorithm list matches present keys.
    """

    it "Ed25519-only set advertises ssh-ed25519":
        step("Verify: Ed25519-only set advertises ssh-ed25519")
        val host_keys = HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        expect(host_key_set_advertised_algorithms(host_keys)).to_equal("ssh-ed25519")

    it "RSA-only set advertises rsa-sha2-256 and rsa-sha2-512":
        step("Verify: RSA-only set advertises rsa-sha2-256 and rsa-sha2-512")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: _rsa_2048_pkcs8_der(),
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        expect(host_key_set_advertised_algorithms(host_keys)).to_equal("rsa-sha2-256,rsa-sha2-512")

    it "ECDSA-only set advertises ecdsa-sha2-nistp256":
        step("Verify: ECDSA-only set advertises ecdsa-sha2-nistp256")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: _ecdsa_p256_pkcs8_der()
        )
        expect(host_key_set_advertised_algorithms(host_keys)).to_equal("ecdsa-sha2-nistp256")

    it "full set advertises all four algorithms in priority order":
        step("Verify: full set advertises all four algorithms in priority order")
        val host_keys = HostKeySet(
            ed25519_seed: _ed25519_seed(),
            rsa_pkcs8: _rsa_2048_pkcs8_der(),
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: _ecdsa_p256_pkcs8_der()
        )
        val expected = "ssh-ed25519,rsa-sha2-256,rsa-sha2-512,ecdsa-sha2-nistp256"
        expect(host_key_set_advertised_algorithms(host_keys)).to_equal(expected)

    it "empty set advertises nothing (fail closed, never a default algorithm)":
        step("Verify: empty set advertises nothing (fail closed, never a default algorithm)")
        val host_keys = HostKeySet(
            ed25519_seed: nil,
            rsa_pkcs8: nil,
            rsa_public_blob: nil,
            ecdsa_p256_pkcs8: nil
        )
        expect(host_key_set_advertised_algorithms(host_keys)).to_equal("")
