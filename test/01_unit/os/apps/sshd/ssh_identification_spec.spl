# @cover src/os/apps/sshd/ssh_identification.spl 85%
use std.spipe.*
use os.apps.sshd.ssh_identification.{ssh_identification_bytes_valid_ssh2}

describe "SSH identification validation":

    it "accepts a bounded printable SSH-2.0 identifier":
        expect(ssh_identification_bytes_valid_ssh2([
            0x53u8, 0x53u8, 0x48u8, 0x2Du8, 0x32u8, 0x2Eu8, 0x30u8, 0x2Du8,
            0x4Fu8, 0x70u8, 0x65u8, 0x6Eu8, 0x53u8, 0x53u8, 0x48u8
        ])).to_be(true)

    it "rejects a control byte after a valid SSH-2.0 prefix":
        expect(ssh_identification_bytes_valid_ssh2([
            0x53u8, 0x53u8, 0x48u8, 0x2Du8, 0x32u8, 0x2Eu8, 0x30u8, 0x2Du8,
            0x4Fu8, 0x70u8, 0x65u8, 0x6Eu8, 0x53u8, 0x53u8, 0x48u8, 0x0Au8
        ])).to_be(false)

    it "rejects a prefix-only identifier without a software version":
        expect(ssh_identification_bytes_valid_ssh2([
            0x53u8, 0x53u8, 0x48u8, 0x2Du8, 0x32u8, 0x2Eu8, 0x30u8, 0x2Du8
        ])).to_be(false)
