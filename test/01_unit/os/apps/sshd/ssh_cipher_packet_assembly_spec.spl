"""Correctness coverage for linear SSH AES-GCM packet assembly."""

# @req: REQ-OS-APPS-001
# @cover src/os/apps/sshd/ssh_cipher_live.spl 75%

use std.spipe.*
use std.spec.step
use os.apps.sshd.ssh_cipher_live.{
    ssh_encrypt_packet_aes128_gcm, ssh_decrypt_packet_aes128_gcm
}

fn _packet_assembly_key() -> [u8]:
    [0x00u8, 0x01u8, 0x02u8, 0x03u8, 0x04u8, 0x05u8, 0x06u8, 0x07u8,
     0x08u8, 0x09u8, 0x0au8, 0x0bu8, 0x0cu8, 0x0du8, 0x0eu8, 0x0fu8]

fn _packet_assembly_iv() -> [u8]:
    [0x10u8, 0x11u8, 0x12u8, 0x13u8, 0x14u8, 0x15u8,
     0x16u8, 0x17u8, 0x18u8, 0x19u8, 0x1au8, 0x1bu8]

fn _packet_assembly_payload() -> [u8]:
    var payload: [u8] = []
    var i: u64 = 0u64
    while i < 4096u64:
        payload.push((i & 0xffu64).to_u8())
        i = i + 1u64
    payload

describe "SSH AES-GCM packet assembly":
    it "preserves a multi-page payload through AES-128-GCM framing":
        step("Frame and decrypt a payload large enough to expose per-byte copy regressions")
        val payload = _packet_assembly_payload()
        val packet = ssh_encrypt_packet_aes128_gcm(
            payload, 7u32, _packet_assembly_key(), _packet_assembly_iv())

        # payload=4096, padding=15: packet_length=4112 (0x00001010).
        # Wire size is four clear length bytes + encrypted body + 16-byte tag.
        expect(packet.len()).to_equal(4132u64)
        expect(packet[0]).to_equal(0x00u8)
        expect(packet[1]).to_equal(0x00u8)
        expect(packet[2]).to_equal(0x10u8)
        expect(packet[3]).to_equal(0x10u8)
        val decoded = ssh_decrypt_packet_aes128_gcm(
            packet, 7u32, _packet_assembly_key(), _packet_assembly_iv())
        expect(decoded.is_ok()).to_be(true)
        val actual = decoded.unwrap()
        expect(actual.len()).to_equal(payload.len())
        var i: u64 = 0u64
        while i < payload.len():
            expect(actual[i]).to_equal(payload[i])
            i = i + 1u64
