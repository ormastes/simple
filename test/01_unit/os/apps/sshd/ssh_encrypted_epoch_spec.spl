# @cover src/os/apps/sshd/ssh_session.spl
use std.spipe.*
use os.apps.sshd.ssh_session.{ssh_encrypted_epoch_allows_packet}

describe "SSHD encrypted epoch sequence limits":
    it "reserves the terminal sequence number so an encrypted epoch cannot wrap":
        expect(ssh_encrypted_epoch_allows_packet(0u32)).to_equal(true)
        expect(ssh_encrypted_epoch_allows_packet(0xFFFFFFFEu32)).to_equal(true)
        expect(ssh_encrypted_epoch_allows_packet(0xFFFFFFFFu32)).to_equal(false)
