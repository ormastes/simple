"""
## Purpose and audience
Purpose: Specify SFTP response ownership across RFC 4254 peer half-close.
Audience: maintainers of the filesystem-launched Pure Simple SSH server.
"""
# @req: REQ-OS-APPS-001
# @cover src/os/apps/sshd/ssh_session_channel.spl
use std.spipe.*
use std.spec.step
use os.apps.sshd.ssh_channel.{ChannelTable, ChannelType, DEFAULT_MAX_PACKET}
use os.apps.sshd.ssh_session_channel.{ssh_sftp_peer_eof_disposition_v1}
use os.apps.sshd.ssh_sftp_v3.{SftpSessionV3}

describe "SFTP peer EOF ownership":
    it "retires input while retaining an unsent response suffix":
        step("Classify peer EOF with a partially drained bounded response")
        val disposition = ssh_sftp_peer_eof_disposition_v1(
            true, 7u32, 7u32, 4096u64, 1536u64)
        expect(disposition.matched_owner).to_be(true)
        expect(disposition.cursor_valid).to_be(true)
        expect(disposition.retained_output_bytes).to_equal(2560u64)

    it "keeps outbound channel credit live after peer EOF":
        step("Half-close receive ownership without closing server output")
        var channels = ChannelTable.new()
        val local_id = channels.open(
            ChannelType.Session, 41u32, 8192u32, DEFAULT_MAX_PACKET)
        expect(channels.mark_peer_eof(local_id)).to_be(true)
        expect(channels.consume_remote_window(local_id, 1024u32)).to_be(true)
        expect(channels.channels[0].remote_window).to_equal(7168u32)

    it "does not retire a multiplexed sibling and rejects a corrupt cursor":
        step("Keep EOF scoped to its exact channel and validate retained state")
        val sibling = ssh_sftp_peer_eof_disposition_v1(
            true, 7u32, 8u32, 4096u64, 1024u64)
        expect(sibling.matched_owner).to_be(false)
        expect(sibling.cursor_valid).to_be(true)
        val corrupt = ssh_sftp_peer_eof_disposition_v1(
            true, 7u32, 7u32, 1024u64, 1025u64)
        expect(corrupt.matched_owner).to_be(true)
        expect(corrupt.cursor_valid).to_be(false)

    it "drains complete pre-EOF frames before discarding an incomplete tail":
        step("Seal an ordered parser containing one complete and one partial frame")
        var sftp = SftpSessionV3.new()
        val frames: [u8] = [
            0, 0, 0, 5, 1, 0, 0, 0, 3,
            0, 0, 0, 5, 1, 0, 0, 0, 3,
            0, 0
        ]
        val first = sftp.handle_packet(frames)
        expect(first[4]).to_equal(2u8)
        sftp.seal_input()
        expect(sftp.input_is_sealed()).to_be(true)
        val second = sftp.handle_packet([])
        expect(second[4]).to_equal(101u8)
        expect(sftp.retained_input_bytes()).to_equal(2u64)
        expect(sftp.finalize_sealed_input()).to_be(true)
        expect(sftp.input_is_sealed()).to_be(false)
        expect(sftp.retained_input_bytes()).to_equal(0u64)

    it "rejects new ingress after EOF sealing":
        step("Keep post-EOF bytes outside the ordered SFTP parser")
        var sftp = SftpSessionV3.new()
        sftp.seal_input()
        val rejected = sftp.handle_packet([0u8])
        expect(rejected[4]).to_equal(101u8)
        expect(sftp.retained_input_bytes()).to_equal(0u64)
