# @cover src/os/apps/sshd/ssh_auth.spl 40%
# Password authentication: constant-time compare behavior on the secret path.
use std.spipe.*
use os.apps.sshd.ssh_auth.{SshUserDb}

fn configured_demo_users() -> SshUserDb:
    # Test-only fixture; production SSHD has no built-in accounts.
    var db = SshUserDb.new()
    db.add_user_identity("root")
    db.add_user_identity("user")
    db

describe "ssh_auth password authentication fail-closed":
    it "rejects even a fixture password until verifier zeroization is proven":
        val db = configured_demo_users()
        expect(db.authenticate_password("root", "simpleos")).to_be(false)

    it "rejects a wrong password of equal length":
        val db = configured_demo_users()
        # "simpleos" is 8 chars; "simpleoz" differs only in the last byte
        expect(db.authenticate_password("root", "simpleoz")).to_be(false)

    it "rejects a wrong password of different length":
        val db = configured_demo_users()
        expect(db.authenticate_password("root", "simple")).to_be(false)

    it "rejects an empty password":
        val db = configured_demo_users()
        expect(db.authenticate_password("root", "")).to_be(false)

    it "rejects an unknown user even with a valid password of another user":
        val db = configured_demo_users()
        expect(db.authenticate_password("nobody", "simpleos")).to_be(false)

    it "rejects fixture users without verifier records":
        val db = configured_demo_users()
        expect(db.authenticate_password("user", "password")).to_be(false)
        expect(db.authenticate_password("user", "simpleos")).to_be(false)
