"""
## Purpose and audience
Purpose: Prove deferred SSH execution cannot replay across launch, response, or close.
Audience: SSH daemon and filesystem-exec maintainers.
"""
# @req: REQ-OS-APPS-001
# @cover src/os/apps/sshd/ssh_deferred_exec_owner.spl 80%
use std.spipe.*
use std.spec.step
use os.apps.sshd.ssh_deferred_exec_owner.{
    SSH_DEFERRED_EXEC_COMMAND_MAX_V1,
    SSH_DEFERRED_EXEC_STDOUT_MAX_V1,
    SshDeferredExecOwnerV1,
    SshDeferredExecHandleV1,
    SshDeferredExecStateV1
}

describe "SSH deferred execution owner":
    it "removes the command atomically when the exact launch is claimed":
        step("Admit and claim one bounded command")
        var owner = SshDeferredExecOwnerV1.create()
        val handle = owner.admit(3u32, 8u32, true, "/bin/simple --version").unwrap()
        val claim = owner.claim().unwrap()
        expect(claim.command).to_equal("/bin/simple --version")
        expect(claim.handle.generation).to_equal(handle.generation)
        expect(claim.handle.nonce).to_equal(handle.nonce)
        expect(claim.handle.request_ordinal).to_equal(handle.request_ordinal)
        expect(claim.handle.local_id).to_equal(3u32)
        expect(claim.handle.remote_id).to_equal(8u32)
        expect(owner.lifecycle_state()).to_equal(SshDeferredExecStateV1.LaunchClaimed)
        expect(owner.claim()).to_be_nil()

    it "publishes once and makes response consumption non-retryable":
        step("Publish an exact result, begin its response, and reject replay")
        var owner = SshDeferredExecOwnerV1.create()
        val handle = owner.admit(4u32, 9u32, false, "true").unwrap()
        _ = owner.claim().unwrap()
        expect(owner.publish_result(handle, [65u8], 0u32, false, true)).to_be(true)
        expect(owner.publish_result(handle, [66u8], 1u32, false, false)).to_be(false)
        val response = owner.begin_response(handle).unwrap()
        expect(response.stdout).to_equal([65u8])
        expect(owner.begin_response(handle)).to_be_nil()
        expect(owner.finish_response(handle)).to_be(true)
        expect(owner.finish_response(handle)).to_be(false)
        expect(owner.claim()).to_be_nil()

    it "rejects stale scalar handles and oversized payloads":
        step("Use a foreign identity and both payload bounds")
        var owner = SshDeferredExecOwnerV1.create()
        var too_long = "x"
        while too_long.len() <= SSH_DEFERRED_EXEC_COMMAND_MAX_V1:
            too_long = "{too_long}x"
        expect(owner.admit(1u32, 1u32, false, too_long)).to_be_nil()
        val handle = owner.admit(1u32, 2u32, false, "echo ok").unwrap()
        _ = owner.claim().unwrap()
        val foreign_remote = SshDeferredExecHandleV1(
            generation: handle.generation,
            nonce: handle.nonce,
            request_ordinal: handle.request_ordinal,
            local_id: handle.local_id,
            remote_id: handle.remote_id + 1u32)
        val foreign_local = SshDeferredExecHandleV1(
            generation: handle.generation,
            nonce: handle.nonce,
            request_ordinal: handle.request_ordinal,
            local_id: handle.local_id + 1u32,
            remote_id: handle.remote_id)
        val foreign_generation = SshDeferredExecHandleV1(
            generation: handle.generation + 1u64,
            nonce: handle.nonce,
            request_ordinal: handle.request_ordinal,
            local_id: handle.local_id,
            remote_id: handle.remote_id)
        val foreign_nonce = SshDeferredExecHandleV1(
            generation: handle.generation,
            nonce: handle.nonce + 1u64,
            request_ordinal: handle.request_ordinal,
            local_id: handle.local_id,
            remote_id: handle.remote_id)
        val foreign_ordinal = SshDeferredExecHandleV1(
            generation: handle.generation,
            nonce: handle.nonce,
            request_ordinal: handle.request_ordinal + 1u64,
            local_id: handle.local_id,
            remote_id: handle.remote_id)
        expect(owner.publish_result(foreign_remote, [], 0u32, false, true)).to_be(false)
        expect(owner.publish_result(foreign_local, [], 0u32, false, true)).to_be(false)
        expect(owner.publish_result(foreign_generation, [], 0u32, false, true)).to_be(false)
        expect(owner.publish_result(foreign_nonce, [], 0u32, false, true)).to_be(false)
        expect(owner.publish_result(foreign_ordinal, [], 0u32, false, true)).to_be(false)
        var oversized: [u8] = []
        var i = 0u64
        while i <= SSH_DEFERRED_EXEC_STDOUT_MAX_V1:
            oversized.push(0u8)
            i = i + 1u64
        expect(owner.publish_result(handle, oversized, 0u32, false, true)).to_be(false)

    it "terminal close drops launch-pending and launch-claimed payloads":
        step("Close before and after claim without enabling another launch")
        var pending = SshDeferredExecOwnerV1.create()
        _ = pending.admit(5u32, 10u32, true, "clang a.c").unwrap()
        pending.close()
        expect(pending.claim()).to_be_nil()
        expect(pending.lifecycle_state()).to_equal(SshDeferredExecStateV1.Terminal)
        expect(pending.admit(5u32, 10u32, true, "clang a.c")).to_be_nil()
        var claimed = SshDeferredExecOwnerV1.create()
        val claimed_handle = claimed.admit(6u32, 11u32, true, "clang b.c").unwrap()
        _ = claimed.claim().unwrap()
        claimed.close()
        expect(claimed.publish_result(claimed_handle, [], 0u32, false, true)).to_be(false)
        expect(claimed.begin_response(claimed_handle)).to_be_nil()

    it "terminal close drops response-pending and response-consuming payloads":
        step("Close before and after begin-response and reject every continuation")
        var pending = SshDeferredExecOwnerV1.create()
        val pending_handle = pending.admit(7u32, 12u32, true, "clang c.c").unwrap()
        _ = pending.claim().unwrap()
        expect(pending.publish_result(
            pending_handle, [65u8], 0u32, false, true)).to_be(true)
        pending.close()
        expect(pending.begin_response(pending_handle)).to_be_nil()
        expect(pending.finish_response(pending_handle)).to_be(false)
        var consuming = SshDeferredExecOwnerV1.create()
        val consuming_handle = consuming.admit(8u32, 13u32, true, "clang d.c").unwrap()
        _ = consuming.claim().unwrap()
        expect(consuming.publish_result(
            consuming_handle, [66u8], 0u32, false, true)).to_be(true)
        _ = consuming.begin_response(consuming_handle).unwrap()
        consuming.close()
        expect(consuming.finish_response(consuming_handle)).to_be(false)
        expect(consuming.admit(8u32, 13u32, true, "clang d.c")).to_be_nil()
