# RFC 8731 section 3 fail-closed SSH X25519 boundary.
# Runtime status: UNRUN; no admitted self-hosted runtime available.
# RFC 7748 section 6.1 published vectors, not computed expected values.
use std.spipe.*
use os.apps.sshd.ssh_kex_primitives.{ssh_x25519_shared_secret_valid}
use os.apps.sshd.ssh_kex_core.{ssh_kex_compute_shared}

val ALICE_PRIV: [u8] = [
    0x77u8, 0x07u8, 0x6du8, 0x0au8, 0x73u8, 0x18u8, 0xa5u8, 0x7du8,
    0x3cu8, 0x16u8, 0xc1u8, 0x72u8, 0x51u8, 0xb2u8, 0x66u8, 0x45u8,
    0xdfu8, 0x4cu8, 0x2fu8, 0x87u8, 0xebu8, 0xc0u8, 0x99u8, 0x2au8,
    0xb1u8, 0x77u8, 0xfbu8, 0xa5u8, 0x1du8, 0xb9u8, 0x2cu8, 0x2au8
]

val ALICE_PUB: [u8] = [
    0x85u8, 0x20u8, 0xf0u8, 0x09u8, 0x89u8, 0x30u8, 0xa7u8, 0x54u8,
    0x74u8, 0x8bu8, 0x7du8, 0xdcu8, 0xb4u8, 0x3eu8, 0xf7u8, 0x5au8,
    0x0du8, 0xbfu8, 0x3au8, 0x0du8, 0x26u8, 0x38u8, 0x1au8, 0xf4u8,
    0xebu8, 0xa4u8, 0xa9u8, 0x8eu8, 0xaau8, 0x9bu8, 0x4eu8, 0x6au8
]

val BOB_PRIV: [u8] = [
    0x5du8, 0xabu8, 0x08u8, 0x7eu8, 0x62u8, 0x4au8, 0x8au8, 0x4bu8,
    0x79u8, 0xe1u8, 0x7fu8, 0x8bu8, 0x83u8, 0x80u8, 0x0eu8, 0xe6u8,
    0x6fu8, 0x3bu8, 0xb1u8, 0x29u8, 0x26u8, 0x18u8, 0xb6u8, 0xfdu8,
    0x1cu8, 0x2fu8, 0x8bu8, 0x27u8, 0xffu8, 0x88u8, 0xe0u8, 0xebu8
]

val BOB_PUB: [u8] = [
    0xdeu8, 0x9eu8, 0xdbu8, 0x7du8, 0x7bu8, 0x7du8, 0xc1u8, 0xb4u8,
    0xd3u8, 0x5bu8, 0x61u8, 0xc2u8, 0xecu8, 0xe4u8, 0x35u8, 0x37u8,
    0x3fu8, 0x83u8, 0x43u8, 0xc8u8, 0x5bu8, 0x78u8, 0x67u8, 0x4du8,
    0xadu8, 0xfcu8, 0x7eu8, 0x14u8, 0x6fu8, 0x88u8, 0x2bu8, 0x4fu8
]

val SHARED_SECRET: [u8] = [
    0x4au8, 0x5du8, 0x9du8, 0x5bu8, 0xa4u8, 0xceu8, 0x2du8, 0xe1u8,
    0x72u8, 0x8eu8, 0x3bu8, 0xf4u8, 0x80u8, 0x35u8, 0x0fu8, 0x25u8,
    0xe0u8, 0x7eu8, 0x21u8, 0xc9u8, 0x47u8, 0xd1u8, 0x9eu8, 0x33u8,
    0x76u8, 0xf0u8, 0x9bu8, 0x3cu8, 0x1eu8, 0x16u8, 0x17u8, 0x42u8
]

fn _zero_bytes(count: i64) -> [u8]:
    var result: [u8] = []
    var index: i64 = 0
    while index < count:
        result.push(0u8)
        index = index + 1
    result

describe "SSH X25519 shared-secret admission":
    it "rejects an all-zero 32-byte result":
        expect(ssh_x25519_shared_secret_valid(_zero_bytes(32))).to_equal(false)

    it "rejects empty, short and long results even when nonzero":
        expect(ssh_x25519_shared_secret_valid([])).to_equal(false)
        var short = _zero_bytes(31)
        short[0] = 1u8
        var long = _zero_bytes(33)
        long[32] = 1u8
        expect(ssh_x25519_shared_secret_valid(short)).to_equal(false)
        expect(ssh_x25519_shared_secret_valid(long)).to_equal(false)

    it "accepts a nonzero byte at every position including high-bit values":
        val values: [u8] = [1u8, 0x7fu8, 0x80u8, 0xffu8]
        var position: i64 = 0
        while position < 32:
            var value_index: i64 = 0
            while value_index < values.len():
                var secret = _zero_bytes(32)
                secret[position] = values[value_index]
                expect(ssh_x25519_shared_secret_valid(secret)).to_equal(true)
                value_index = value_index + 1
            position = position + 1

    it "rejects malformed private and peer key lengths before scalar multiplication":
        val lengths: [i64] = [0, 31, 33]
        for length in lengths:
            expect(ssh_kex_compute_shared(_zero_bytes(length), BOB_PUB)).to_equal([])
            expect(ssh_kex_compute_shared(ALICE_PRIV, _zero_bytes(length))).to_equal([])

    it "rejects low-order peers zero and one through the real pure provider":
        val low_values: [u8] = [0u8, 1u8]
        for low in low_values:
            var peer = _zero_bytes(32)
            peer[0] = low
            expect(ssh_kex_compute_shared(ALICE_PRIV, peer)).to_equal([])
            # RFC 7748 masks the high input bit; rejection must be unchanged.
            peer[31] = 0x80u8
            expect(ssh_kex_compute_shared(ALICE_PRIV, peer)).to_equal([])

    it "preserves both RFC 7748 published exchange directions byte-for-byte":
        expect(ssh_kex_compute_shared(ALICE_PRIV, BOB_PUB)).to_equal(SHARED_SECRET)
        expect(ssh_kex_compute_shared(BOB_PRIV, ALICE_PUB)).to_equal(SHARED_SECRET)

    it "preserves the published secret when the peer high bit is set":
        var peer = BOB_PUB
        peer[31] = peer[31] | 0x80u8
        expect(ssh_kex_compute_shared(ALICE_PRIV, peer)).to_equal(SHARED_SECRET)
