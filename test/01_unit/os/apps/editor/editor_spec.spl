use std.spec
use std.spec.step
use os.apps.editor.editor.{EditorMode, TextEditor, mode_name}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Executable specification for the TextEditor application model: mode enum,
construction defaults, insert/delete/newline editing, mode transitions,
and cursor bounds. Audience: os.apps.editor owners and reviewers confirming
editor behavior still holds before a change lands.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/apps/editor/editor_spec.spl`.
2. Every scenario must pass; a failure is a regression in editor behavior.

## Compatibility and limitations

Known defect (2026-09-05): os.apps.editor.editor does not provide
EditorMode or mode_name, so every scenario bound to them fails at load
("variable EditorMode not found"); the spec is kept RED until the module
ships that API. Platform-specific behavior is out of scope.

## Verification guidance and troubleshooting

Re-run the single file to reproduce; a failing scenario names the editor
operation and the expected value. Scenarios failing on `variable not
found` trace to the missing module API above, not to the assertions
themselves.
"""
# Lifecycle:
# doc/01_research/domain/sspec_documentization_maintenance.md
# doc/03_plan/sspec_modernization_plan.md
# doc/04_architecture/sspec_documentization_maintenance.md
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: editor-model
# @manual: primary


# ============================================================================
# EditorMode Enum
# ============================================================================

describe "EditorMode":
    # @manual scenario evidence
    """
    # Text Editor Unit Tests
    Tests for TextEditor: construction, insert_char, delete_char, newline,
    mode transitions (Normal/Insert/Command), and cursor bounds.

    This describe block covers the EditorMode enum variants and the
    mode_name() formatter used in the status line.
    """
    it "has Normal variant":
        # NOTE (legitimately RED, 2026-09-05): os.apps.editor.editor does not
        # provide EditorMode/mode_name — every scenario here fails at load.
        # @req REQ-SSPEC-LOCAL-001
        # @capture(bit_table): distinctness of the Normal mode from Insert and Command
        step("Distinguish the Normal mode from the Insert and Command modes")
        expect(EditorMode.Normal == EditorMode.Insert).to_equal(false)  # oracle: distinct enum variants must never compare equal
        expect(EditorMode.Normal == EditorMode.Command).to_equal(false)  # oracle: distinct enum variants must never compare equal

    it "has Insert variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(bit_table): distinctness of the Insert mode from Normal and Command
        step("Distinguish the Insert mode from the Normal and Command modes")
        expect(EditorMode.Insert == EditorMode.Normal).to_equal(false)  # oracle: distinct enum variants must never compare equal
        expect(EditorMode.Insert == EditorMode.Command).to_equal(false)  # oracle: distinct enum variants must never compare equal

    it "has Command variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(bit_table): distinctness of the Command mode from Normal and Insert
        step("Distinguish the Command mode from the Normal and Insert modes")
        expect(EditorMode.Command == EditorMode.Normal).to_equal(false)  # oracle: distinct enum variants must never compare equal
        expect(EditorMode.Command == EditorMode.Insert).to_equal(false)  # oracle: distinct enum variants must never compare equal

    it "mode_name returns NORMAL":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): status-line label for the Normal mode
        step("Ask the product formatter for the Normal mode label")
        val name = mode_name(EditorMode.Normal)
        expect(name).to_equal("NORMAL")  # oracle: the status line renders Normal mode uppercase

    it "mode_name returns INSERT":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): status-line label for the Insert mode
        step("Ask the product formatter for the Insert mode label")
        val name = mode_name(EditorMode.Insert)
        expect(name).to_equal("INSERT")  # oracle: the status line renders Insert mode uppercase

    it "mode_name returns COMMAND":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): status-line label for the Command mode
        step("Ask the product formatter for the Command mode label")
        val name = mode_name(EditorMode.Command)
        expect(name).to_equal("COMMAND")  # oracle: the status line renders Command mode uppercase

# ============================================================================
# TextEditor Construction
# ============================================================================

describe "TextEditor":
    context "when newly created":
        it "starts with one empty line":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): line count and content of a fresh editor buffer
            step("Create a fresh editor and read its buffer")
            val ed = TextEditor.new()
            expect(ed.lines.len()).to_equal(1)  # oracle: a new document holds exactly one line
            expect(ed.lines[0]).to_equal("")  # oracle: the initial line is empty

        it "starts with cursor at row 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): cursor row of a fresh editor
            step("Create a fresh editor and read the cursor row")
            val ed = TextEditor.new()
            expect(ed.cursor_row).to_equal(0)  # oracle: a new document places the cursor on the first row

        it "starts with cursor at col 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): cursor column of a fresh editor
            step("Create a fresh editor and read the cursor column")
            val ed = TextEditor.new()
            expect(ed.cursor_col).to_equal(0)  # oracle: a new document places the cursor on the first column

        it "starts with scroll_row at 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): scroll offset of a fresh editor
            step("Create a fresh editor and read the scroll offset")
            val ed = TextEditor.new()
            expect(ed.scroll_row).to_equal(0)  # oracle: a new document is scrolled to the top

        it "starts with no file_path":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): file path of an unsaved fresh editor
            step("Create a fresh editor and read its file path")
            val ed = TextEditor.new()
            expect(ed.file_path).to_be_nil  # oracle: an unsaved new document has no backing file

        it "starts not modified":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): modified flag of a fresh editor
            step("Create a fresh editor and read the modified flag")
            val ed = TextEditor.new()
            expect(ed.modified).to_equal(false)  # oracle: a pristine document carries no unsaved change

        it "starts in Normal mode":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): initial editor mode
            step("Create a fresh editor and read its mode")
            val ed = TextEditor.new()
            expect(ed.mode).to_equal(EditorMode.Normal)  # oracle: the product default mode is Normal, read from the constructed editor

        it "starts with empty command_buffer":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): command buffer of a fresh editor
            step("Create a fresh editor and read the command buffer")
            val ed = TextEditor.new()
            expect(ed.command_buffer).to_equal("")  # oracle: no command has been typed yet

        it "starts with empty yank_buffer":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): yank buffer length of a fresh editor
            step("Create a fresh editor and read the yank buffer")
            val ed = TextEditor.new()
            expect(ed.yank_buffer.len()).to_equal(0)  # oracle: nothing has been yanked yet

        it "starts with Ready status message":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): status-line message of a fresh editor
            step("Create a fresh editor and read the status message")
            val ed = TextEditor.new()
            expect(ed.status_message).to_equal("Ready")  # oracle: the product greets with the Ready status

        it "has default visible_rows of 20":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default viewport height
            step("Create a fresh editor and read the viewport height")
            val ed = TextEditor.new()
            expect(ed.visible_rows).to_equal(20)  # oracle: the product default viewport shows 20 rows

        it "has default visible_cols of 80":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default viewport width
            step("Create a fresh editor and read the viewport width")
            val ed = TextEditor.new()
            expect(ed.visible_cols).to_equal(80)  # oracle: the product default viewport shows 80 columns

        it "has nil vfs by default":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): vfs handle of a fresh editor
            step("Create a fresh editor and read its vfs handle")
            val ed = TextEditor.new()
            expect(ed.vfs).to_be_nil  # oracle: a fresh editor is not mounted to any filesystem yet

# ============================================================================
# Insert Character
# ============================================================================

describe "TextEditor insert_char":
    it "adds character at cursor position":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): buffer content after one inserted character
        step("Type one character in insert mode and read the buffer")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        expect(ed.lines[0]).to_contain("A")  # oracle: the typed character must land in the buffer

    it "advances cursor after insert":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after one inserted character
        step("Type one character and read the cursor column")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        expect(ed.cursor_col).to_equal(1)  # oracle: the cursor moves one column past the inserted character

    it "inserts multiple characters sequentially":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column and buffer prefix after two inserted characters
        step("Type two characters in order and read cursor and buffer")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("H")
        ed.insert_char("i")
        expect(ed.cursor_col).to_equal(2)  # oracle: two typed characters advance the cursor two columns
        expect(ed.lines[0]).to_start_with("Hi")  # oracle: the buffer keeps the typed order

    it "marks document as modified":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): modified flag after one inserted character
        step("Type one character and read the modified flag")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        expect(ed.modified).to_equal(true)  # oracle: any insertion marks the document dirty

    it "inserts at middle of existing text":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): buffer content after a mid-word insertion
        step("Insert a character between two existing ones")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("C")
        ed.cursor_col = 1
        ed.insert_char("B")
        expect(ed.lines[0]).to_equal("ABC")  # oracle: inserting between A and C must splice B in the middle

# ============================================================================
# Delete Character
# ============================================================================

describe "TextEditor delete_char":
    it "removes character at cursor":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): buffer content after deleting at the cursor
        step("Delete the character under the cursor")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.cursor_col = 0
        ed.delete_char()
        expect(ed.lines[0]).to_start_with("B")  # oracle: deleting at column 0 must drop the A and keep the B

    it "marks document as modified":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): modified flag after a deletion
        step("Delete a character and read the modified flag")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.cursor_col = 0
        ed.delete_char()
        expect(ed.modified).to_equal(true)  # oracle: any deletion marks the document dirty

describe "TextEditor delete_char_before":
    it "deletes character before cursor (backspace)":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after a backspace
        step("Backspace after typing two characters")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.delete_char_before()
        expect(ed.cursor_col).to_equal(1)  # oracle: backspace removes the character behind the cursor and steps back one column

    it "does nothing when cursor at column 0 row 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor position after backspace at the origin
        step("Backspace at the document origin")
        var ed = TextEditor.new()
        ed.delete_char_before()
        expect(ed.cursor_col).to_equal(0)  # oracle: backspace at the origin must not move the cursor
        expect(ed.cursor_row).to_equal(0)  # oracle: backspace at the origin must not change the row

    it "joins with previous line when at column 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): row and line count after a line-joining backspace
        step("Backspace at column 0 of the second line")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.newline()
        ed.insert_char("B")
        ed.cursor_col = 0
        ed.delete_char_before()
        expect(ed.cursor_row).to_equal(0)  # oracle: joining pulls the cursor up to the previous line
        expect(ed.lines.len()).to_equal(1)  # oracle: joining the lines leaves a single line

# ============================================================================
# Newline
# ============================================================================

describe "TextEditor newline":
    it "splits line at cursor":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): line count and both fragments after a split
        step("Split a two-character line in the middle")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.cursor_col = 1
        ed.newline()
        expect(ed.lines.len()).to_equal(2)  # oracle: a mid-line split produces two lines
        expect(ed.lines[0]).to_equal("A")  # oracle: the left fragment keeps the text before the cursor
        expect(ed.lines[1]).to_start_with("B")  # oracle: the right fragment keeps the text after the cursor

    it "moves cursor to next row":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor row after a newline
        step("Press newline and read the cursor row")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.newline()
        expect(ed.cursor_row).to_equal(1)  # oracle: newline moves the cursor to the new line below

    it "resets cursor col to 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after a newline
        step("Press newline mid-line and read the cursor column")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("X")
        ed.insert_char("Y")
        ed.newline()
        expect(ed.cursor_col).to_equal(0)  # oracle: the new line starts at column 0

    it "marks document as modified":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): modified flag after a newline
        step("Press newline and read the modified flag")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.newline()
        expect(ed.modified).to_equal(true)  # oracle: splitting a line marks the document dirty

    it "creates empty line when at end of text":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): line count and trailing line content after newline at end
        step("Press newline at the end of the text")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("Z")
        ed.newline()
        expect(ed.lines.len()).to_equal(2)  # oracle: newline at end still adds a second line
        expect(ed.lines[1]).to_equal("")  # oracle: the added trailing line is empty

# ============================================================================
# Mode Transitions
# ============================================================================

describe "TextEditor mode transitions":
    context "Normal to Insert":
        it "switches to Insert on 'i' key":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): mode after pressing i in Normal mode
            step("Press i in Normal mode and read the mode")
            var ed = TextEditor.new()
            ed.handle_normal_key("i")
            expect(ed.mode).to_equal(EditorMode.Insert)  # oracle: i is the product's enter-insert key

        it "sets INSERT status message":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): status message after entering insert mode
            step("Press i and read the status message")
            var ed = TextEditor.new()
            ed.handle_normal_key("i")
            expect(ed.status_message).to_equal("-- INSERT --")  # oracle: the product advertises insert mode on the status line

        it "switches to Insert on 'a' key (append)":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): mode after pressing a in Normal mode
            step("Press a in Normal mode and read the mode")
            var ed = TextEditor.new()
            ed.handle_normal_key("a")
            expect(ed.mode).to_equal(EditorMode.Insert)  # oracle: a (append) is also an enter-insert key

        it "switches to Insert on 'o' key (open below)":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): mode after pressing o in Normal mode
            step("Press o in Normal mode and read the mode")
            var ed = TextEditor.new()
            ed.handle_normal_key("o")
            expect(ed.mode).to_equal(EditorMode.Insert)  # oracle: o (open below) is also an enter-insert key

    context "Insert to Normal":
        it "switches to Normal on escape":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): mode after pressing escape in Insert mode
            step("Press escape in Insert mode and read the mode")
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("escape")
            expect(ed.mode).to_equal(EditorMode.Normal)  # oracle: escape returns the editor to Normal mode

        it "clears status message on escape":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): status message after escape in Insert mode
            step("Press escape with a status message showing")
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.status_message = "-- INSERT --"
            ed.handle_insert_key("escape")
            expect(ed.status_message).to_equal("")  # oracle: leaving insert mode clears the mode banner

    context "Insert mode key handling":
        it "inserts character on regular key":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): buffer content after a regular insert-mode key
            step("Type a regular key in Insert mode and read the buffer")
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("A")
            expect(ed.lines[0]).to_contain("A")  # oracle: a regular key in insert mode must land in the buffer

        it "handles enter key":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): line count after the insert-mode enter key
            step("Press enter in Insert mode and count the lines")
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.handle_insert_key("enter")
            expect(ed.lines.len()).to_equal(2)  # oracle: enter in insert mode splits into a second line

        it "handles backspace key":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): cursor column after the insert-mode backspace key
            step("Type one character then press backspace in Insert mode")
            var ed = TextEditor.new()
            ed.mode = EditorMode.Insert
            ed.insert_char("X")
            ed.handle_insert_key("backspace")
            expect(ed.cursor_col).to_equal(0)  # oracle: backspace removes the typed character and returns to column 0

# ============================================================================
# Cursor Bounds Checking
# ============================================================================

describe "TextEditor cursor bounds":
    it "h does not go below col 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after h at the left edge
        step("Press h at the left edge of the line")
        var ed = TextEditor.new()
        ed.cursor_col = 0
        ed.handle_normal_key("h")
        expect(ed.cursor_col).to_equal(0)  # oracle: the left edge clamps the h motion at column 0

    it "k does not go below row 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor row after k at the top edge
        step("Press k at the top of the document")
        var ed = TextEditor.new()
        ed.cursor_row = 0
        ed.handle_normal_key("k")
        expect(ed.cursor_row).to_equal(0)  # oracle: the top edge clamps the k motion at row 0

    it "j does not go past last line":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor row after j on a single-line document
        step("Press j on a single-line document")
        var ed = TextEditor.new()
        # Only 1 line, so j should not advance
        ed.handle_normal_key("j")
        expect(ed.cursor_row).to_equal(0)  # oracle: the bottom edge clamps the j motion at the last line

    it "0 moves to start of line":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after the 0 line-start motion
        step("Type three characters then press 0 in Normal mode")
        var ed = TextEditor.new()
        ed.mode = EditorMode.Insert
        ed.insert_char("A")
        ed.insert_char("B")
        ed.insert_char("C")
        ed.mode = EditorMode.Normal
        ed.handle_normal_key("0")
        expect(ed.cursor_col).to_equal(0)  # oracle: the 0 motion jumps to the start of the line
