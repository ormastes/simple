use std.spec

use os.apps.browser_demo.browser_demo.{BrowserDemoApp, render_demo_to_pixels, demo_node_count, count_visible_pixels}

describe "Browser Demo rendering":
    it "precomputes browser render stats for the desktop app tree":
        val app = BrowserDemoApp.new()
        expect(app.render_done).to_equal(true)
        expect(app.node_count).to_be_greater_than(0)
        expect(app.pixel_count).to_be_greater_than(0)

    it "renders non-background pixels through the browser engine":
        val pixels = render_demo_to_pixels(320, 240)
        var visible: i32 = 0
        for pixel in pixels:
            if pixel != 0xFFF0F0F0:
                visible = visible + 1
        expect(visible).to_be_greater_than(0)

    # Guards the tree-wipe restore (bug tree_wipe_module_damage_census_2026-08-04):
    # the demo DOM shape and the pixel counter must stay intact.
    it "builds the full 14-node demo DOM (root, header, 3 flex boxes, paragraph, footer)":
        expect(demo_node_count()).to_equal(14)

    it "counts only pixels that differ from the background":
        expect(count_visible_pixels([0xFFF0F0F0, 0xFF000000, 0xFFF0F0F0, 0xFF112233], 0xFFF0F0F0)).to_equal(2)
