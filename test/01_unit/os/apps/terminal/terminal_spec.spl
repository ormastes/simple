use std.spec
use std.spec.step
use os.apps.terminal.terminal.{TerminalChar, TerminalLine, Terminal, AnsiState, default_char, new_line}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Executable specification for the terminal emulator model: screen-cell and
line construction, Terminal defaults, write_char/newline/scroll_up/clear
behavior, the ANSI escape state machine, and write_string integration.
Audience: os.apps.terminal owners and reviewers confirming terminal
behavior still holds before a change lands.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/apps/terminal/terminal_spec.spl`.
2. Every scenario must pass; a failure is a regression in terminal behavior.

## Compatibility and limitations

Known defect (2026-09-05): os.apps.terminal.terminal exports Terminal but
does not provide TerminalChar, TerminalLine, AnsiState, default_char,
new_line, or line_to_text, so every scenario bound to them fails; the
spec is kept RED until the module ships that API. Platform-specific
behavior is out of scope.

## Verification guidance and troubleshooting

Re-run the single file to reproduce; a failing scenario names the terminal
operation and the expected value. Scenarios failing on a missing
TerminalChar/TerminalLine/AnsiState symbol trace to the missing module
API above, not to the assertions themselves.
"""
# Lifecycle:
# doc/01_research/domain/sspec_documentization_maintenance.md
# doc/03_plan/sspec_modernization_plan.md
# doc/04_architecture/sspec_documentization_maintenance.md
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: terminal-model
# @manual: primary


# ============================================================================
# TerminalChar Construction
# ============================================================================

describe "TerminalChar":
    # @manual scenario evidence
    """
    # Terminal Emulator Unit Tests
    Tests for TerminalChar, TerminalLine, and Terminal class:
    construction, write_char, newline, scroll_up, clear, ANSI parsing.

    This describe block exercises the TerminalChar value type that
    holds a single screen cell (char + fg/bg color + bold flag).
    """
    it "constructs with default values":
        """TerminalChar(ch, fg, bg, bold) round-trips its fields unchanged."""
        # NOTE (legitimately RED, 2026-09-05): os.apps.terminal.terminal does not
        # provide TerminalChar/TerminalLine/AnsiState — scenarios bound to them
        # fail at runtime. Unblock: export those types from the module.
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): field round-trip of a blank white-on-black cell
        step("Construct a blank cell with the classic color scheme")
        val ch = TerminalChar(ch: " ", fg: 7, bg: 0, bold: false)
        expect(ch.ch).to_equal(" ")  # oracle: constructor stores the blank glyph verbatim
        expect(ch.fg).to_equal(7)  # oracle: constructor stores foreground 7 verbatim
        expect(ch.bg).to_equal(0)  # oracle: constructor stores background 0 verbatim
        expect(ch.bold).to_equal(false)  # oracle: the cell starts unwritten and therefore not bold

    it "constructs with custom color":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): field round-trip of a bold colored cell
        step("Construct a bold red-on-blue cell")
        val ch = TerminalChar(ch: "A", fg: 1, bg: 4, bold: true)
        expect(ch.ch).to_equal("A")  # oracle: constructor stores the glyph verbatim
        expect(ch.fg).to_equal(1)  # oracle: constructor stores foreground 1 verbatim
        expect(ch.bg).to_equal(4)  # oracle: constructor stores background 4 verbatim
        expect(ch.bold).to_equal(true)  # oracle: constructor stores the bold flag verbatim

    it "default_char returns space with white-on-black":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): fields of the product's default screen cell
        step("Ask the product for its default screen cell")
        val ch = default_char()
        expect(ch.ch).to_equal(" ")  # oracle: the default cell is a blank
        expect(ch.fg).to_equal(7)  # oracle: the default foreground is white (7)
        expect(ch.bg).to_equal(0)  # oracle: the default background is black (0)
        expect(ch.bold).to_equal(false)  # oracle: the default cell is not bold

# ============================================================================
# TerminalLine Construction
# ============================================================================

describe "TerminalLine":
    it "new_line creates line with correct width":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cell count of a factory-built 80-column line
        step("Build an 80-column line with the product factory")
        val line = new_line(80)
        expect(line.chars.len()).to_equal(80)  # oracle: the factory allocates exactly one cell per requested column

    it "new_line fills with blank chars":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): first and last cell glyphs of a factory-built line
        step("Build a 10-column line and inspect both ends")
        val line = new_line(10)
        expect(line.chars[0].ch).to_equal(" ")  # oracle: the first cell of a new line is blank
        expect(line.chars[9].ch).to_equal(" ")  # oracle: the last cell of a new line is blank

    it "line_to_text renders plain text":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): rendered prefix of a line holding "Hi"
        step("Render a line whose first two cells hold Hi")
        var line = new_line(5)
        line.chars[0] = TerminalChar(ch: "H", fg: 7, bg: 0, bold: false)
        line.chars[1] = TerminalChar(ch: "i", fg: 7, bg: 0, bold: false)
        val text_out = line_to_text(line)
        expect(text_out).to_start_with("Hi")  # oracle: the renderer must emit the stored glyphs in order

# ============================================================================
# Terminal Construction
# ============================================================================

describe "Terminal":
    context "when newly created":
        it "has correct cols":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): column count of an 80x25 terminal
            step("Create an 80x25 terminal and read its width")
            val term = Terminal.new(80, 25)
            expect(term.cols).to_equal(80)  # oracle: constructor stores the requested width verbatim

        it "has correct rows":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): row count of an 80x25 terminal
            step("Create an 80x25 terminal and read its height")
            val term = Terminal.new(80, 25)
            expect(term.rows).to_equal(25)  # oracle: constructor stores the requested height verbatim

        it "starts with cursor at row 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): cursor row of a fresh terminal
            step("Create a terminal and read the cursor row")
            val term = Terminal.new(80, 25)
            expect(term.cursor_row).to_equal(0)  # oracle: a fresh terminal places the cursor on the first row

        it "starts with cursor at col 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): cursor column of a fresh terminal
            step("Create a terminal and read the cursor column")
            val term = Terminal.new(80, 25)
            expect(term.cursor_col).to_equal(0)  # oracle: a fresh terminal places the cursor on the first column

        it "has correct number of lines":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): line-buffer length of an 80x25 terminal
            step("Create an 80x25 terminal and count its line buffer")
            val term = Terminal.new(80, 25)
            expect(term.lines.len()).to_equal(25)  # oracle: the buffer holds exactly one line per requested row

        it "starts with default fg color (white)":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default foreground color of a fresh terminal
            step("Create a terminal and read the foreground color")
            val term = Terminal.new(80, 25)
            expect(term.fg_color).to_equal(7)  # oracle: the product default foreground is white (7)

        it "starts with default bg color (black)":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default background color of a fresh terminal
            step("Create a terminal and read the background color")
            val term = Terminal.new(80, 25)
            expect(term.bg_color).to_equal(0)  # oracle: the product default background is black (0)

        it "starts not bold":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): bold flag of a fresh terminal
            step("Create a terminal and read the bold flag")
            val term = Terminal.new(80, 25)
            expect(term.bold).to_equal(false)  # oracle: a fresh terminal writes no bold text

        it "starts with empty input buffer":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): input buffer of a fresh terminal
            step("Create a terminal and read the input buffer")
            val term = Terminal.new(80, 25)
            expect(term.input_buffer).to_equal("")  # oracle: no keys have been fed yet

        it "starts with empty output buffer":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): output buffer of a fresh terminal
            step("Create a terminal and read the output buffer")
            val term = Terminal.new(80, 25)
            expect(term.output_buffer).to_equal("")  # oracle: nothing has been echoed yet

        it "starts with ANSI state Normal":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): ANSI state of a fresh terminal
            step("Create a terminal and read the ANSI state")
            val term = Terminal.new(80, 25)
            expect(term.ansi_state).to_equal(AnsiState.Normal)  # oracle: the escape parser starts in the Normal state

        it "starts with max_scrollback of 1000":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): scrollback cap of a fresh terminal
            step("Create a terminal and read the scrollback cap")
            val term = Terminal.new(80, 25)
            expect(term.max_scrollback).to_equal(1000)  # oracle: the product caps scrollback at 1000 lines

    context "with small dimensions":
        it "creates 1x1 terminal":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): width, height, and buffer length of a 1x1 terminal
            step("Create a 1x1 terminal and read its dimensions")
            val term = Terminal.new(1, 1)
            expect(term.cols).to_equal(1)  # oracle: a 1-column terminal reports width 1
            expect(term.rows).to_equal(1)  # oracle: a 1-row terminal reports height 1
            expect(term.lines.len()).to_equal(1)  # oracle: a 1-row terminal buffers exactly one line

# ============================================================================
# Terminal write_char
# ============================================================================

describe "Terminal write_char":
    it "places character at cursor position":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): origin cell glyph after one write_char
        step("Write A at the origin and read the cell")
        var term = Terminal.new(80, 25)
        term.write_char("A")
        val ch = term.lines[0].chars[0]
        expect(ch.ch).to_equal("A")  # oracle: the written glyph must land at the cursor cell

    it "advances cursor column after write":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after one write_char
        step("Write A and read the cursor column")
        var term = Terminal.new(80, 25)
        term.write_char("A")
        expect(term.cursor_col).to_equal(1)  # oracle: the cursor moves one column past the written glyph

    it "writes multiple characters sequentially":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column and cell glyphs after two writes
        step("Write Hi in order and read cursor and cells")
        var term = Terminal.new(80, 25)
        term.write_char("H")
        term.write_char("i")
        expect(term.cursor_col).to_equal(2)  # oracle: two written glyphs advance the cursor two columns
        expect(term.lines[0].chars[0].ch).to_equal("H")  # oracle: the first glyph stays in the first cell
        expect(term.lines[0].chars[1].ch).to_equal("i")  # oracle: the second glyph lands in the second cell

    it "wraps at end of line":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor row after filling a 3-column line
        step("Fill a 3-column line and read the cursor row")
        var term = Terminal.new(3, 2)
        term.write_char("A")
        term.write_char("B")
        term.write_char("C")
        # After writing 3 chars in a 3-col terminal, cursor should wrap
        expect(term.cursor_row).to_be_greater_than(0)  # oracle: writing past the last column must wrap to the next row

    it "handles newline character":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor position after a newline glyph
        step("Write A then a newline and read the cursor")
        var term = Terminal.new(80, 25)
        term.write_char("A")
        term.write_char("\n")
        expect(term.cursor_row).to_equal(1)  # oracle: a newline glyph moves the cursor to the next row
        expect(term.cursor_col).to_equal(0)  # oracle: and resets the cursor to column 0

# ============================================================================
# Terminal newline and scroll
# ============================================================================

describe "Terminal newline":
    it "moves cursor to next row":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor position after newline()
        step("Call newline and read the cursor")
        var term = Terminal.new(80, 25)
        term.newline()
        expect(term.cursor_row).to_equal(1)  # oracle: newline moves the cursor to the next row
        expect(term.cursor_col).to_equal(0)  # oracle: and resets the cursor to column 0

    it "resets cursor_col to 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column after newline mid-line
        step("Write XY then newline and read the cursor column")
        var term = Terminal.new(80, 25)
        term.write_char("X")
        term.write_char("Y")
        term.newline()
        expect(term.cursor_col).to_equal(0)  # oracle: the new line starts at column 0

    it "scrolls when at last row":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor row after newline on the bottom row
        step("Call newline while the cursor sits on the bottom row")
        var term = Terminal.new(80, 3)
        term.cursor_row = 2
        term.newline()
        # After newline at last row, cursor stays at last row
        expect(term.cursor_row).to_equal(2)  # oracle: newline on the bottom row scrolls instead of leaving the screen

describe "Terminal scroll_up":
    it "shifts buffer up by one line":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): top two cell glyphs after one scroll
        step("Mark the three rows A/B/C and scroll once")
        var term = Terminal.new(10, 3)
        term.lines[0].chars[0] = TerminalChar(ch: "A", fg: 7, bg: 0, bold: false)
        term.lines[1].chars[0] = TerminalChar(ch: "B", fg: 7, bg: 0, bold: false)
        term.lines[2].chars[0] = TerminalChar(ch: "C", fg: 7, bg: 0, bold: false)
        term.scroll_up()
        # Line 0 should now be what was line 1
        expect(term.lines[0].chars[0].ch).to_equal("B")  # oracle: the scroll pulls the second row into the top slot
        expect(term.lines[1].chars[0].ch).to_equal("C")  # oracle: and the third row into the second slot

    it "adds blank line at bottom after scroll":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): bottom cell glyph after one scroll
        step("Mark the bottom row X and scroll once")
        var term = Terminal.new(10, 3)
        term.lines[2].chars[0] = TerminalChar(ch: "X", fg: 7, bg: 0, bold: false)
        term.scroll_up()
        # Last line should be blank
        expect(term.lines[2].chars[0].ch).to_equal(" ")  # oracle: scrolling in a new line must blank the bottom row

    it "preserves line count after scroll":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): line-buffer length after one scroll
        step("Scroll a 5-row terminal and count the line buffer")
        var term = Terminal.new(10, 5)
        term.scroll_up()
        expect(term.lines.len()).to_equal(5)  # oracle: scrolling must not change the buffer's row count

# ============================================================================
# Terminal clear
# ============================================================================

describe "Terminal clear":
    it "resets all lines to blank":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): leading cell glyphs after clear
        step("Write AB then clear and read the first two cells")
        var term = Terminal.new(10, 3)
        term.write_char("A")
        term.write_char("B")
        term.clear()
        expect(term.lines[0].chars[0].ch).to_equal(" ")  # oracle: clear must blank the first cell
        expect(term.lines[0].chars[1].ch).to_equal(" ")  # oracle: and the second cell

    it "resets cursor to origin":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor position after clear
        step("Move the cursor to (10, 20) then clear")
        var term = Terminal.new(80, 25)
        term.cursor_row = 10
        term.cursor_col = 20
        term.clear()
        expect(term.cursor_row).to_equal(0)  # oracle: clear parks the cursor on the first row
        expect(term.cursor_col).to_equal(0)  # oracle: and the first column

    it "preserves number of lines":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): line-buffer length after clear
        step("Clear an 80x25 terminal and count the line buffer")
        var term = Terminal.new(80, 25)
        term.clear()
        expect(term.lines.len()).to_equal(25)  # oracle: clear must not shrink the buffer

# ============================================================================
# ANSI Escape State Machine
# ============================================================================

describe "Terminal ANSI parsing":
    it "starts in Normal state":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): ANSI state of a fresh terminal
        step("Create a terminal and read the ANSI state")
        val term = Terminal.new(80, 25)
        expect(term.ansi_state).to_equal(AnsiState.Normal)  # oracle: the escape parser starts in the Normal state

    it "AnsiState enum has Normal variant":
        # NOTE (legitimately RED, 2026-09-05): os.apps.terminal.terminal does not
        # provide AnsiState — scenarios bound to it fail at runtime.
        # Unblock: export AnsiState from the module.
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of the Normal state from Escape
        step("Distinguish the Normal ANSI state from the Escape state")
        val normal_state = AnsiState.Normal
        expect(normal_state == AnsiState.Escape).to_equal(false)  # oracle: distinct parser states must never compare equal

    it "AnsiState enum has Escape variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of the Escape state from Bracket
        step("Distinguish the Escape ANSI state from the Bracket state")
        val escape_state = AnsiState.Escape
        expect(escape_state == AnsiState.Bracket).to_equal(false)  # oracle: distinct parser states must never compare equal

    it "AnsiState enum has Bracket variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of the Bracket state from Param
        step("Distinguish the Bracket ANSI state from the Param state")
        val bracket_state = AnsiState.Bracket
        expect(bracket_state == AnsiState.Param).to_equal(false)  # oracle: distinct parser states must never compare equal

    it "AnsiState enum has Param variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of the Param state from Normal
        step("Distinguish the Param ANSI state from the Normal state")
        val param_state = AnsiState.Param
        expect(param_state == AnsiState.Normal).to_equal(false)  # oracle: distinct parser states must never compare equal

# ============================================================================
# Terminal write_string (integration)
# ============================================================================

describe "Terminal write_string":
    it "writes multiple characters":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): cursor column and cell glyphs after one write_string
        step("Write Hello with one call and read cursor and cells")
        var term = Terminal.new(80, 25)
        term.write_string("Hello")
        expect(term.cursor_col).to_equal(5)  # oracle: a five-character write advances the cursor five columns
        expect(term.lines[0].chars[0].ch).to_equal("H")  # oracle: the first glyph lands in the first cell
        expect(term.lines[0].chars[4].ch).to_equal("o")  # oracle: the last glyph lands in the fifth cell

    it "handles embedded newlines":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): both rows' leading glyphs after AB\nCD
        step("Write AB, a newline, and CD in one call")
        var term = Terminal.new(80, 25)
        term.write_string("AB\nCD")
        expect(term.lines[0].chars[0].ch).to_equal("A")  # oracle: the embedded newline splits the first row at AB
        expect(term.lines[0].chars[1].ch).to_equal("B")  # oracle: B stays as the second cell of the first row
        expect(term.lines[1].chars[0].ch).to_equal("C")  # oracle: C opens the second row
        expect(term.lines[1].chars[1].ch).to_equal("D")  # oracle: D follows it on the second row
