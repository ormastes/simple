# Execution NOT_RUN. Pure codec assertions only; no native session or effects,
# authority issuance, implicit attempts, retries, or server dispatch acceptance.
use std.spec.{describe, it, expect, step}
use os.apps.smux.runtime_primary_control_request_v4.*
use os.apps.smux.runtime_control_request_v1.*
use std.common.contracts.mux.session_runtime_control_v1.SessionRuntimeControlKindV1
use std.common.sdn.value.SdnValue
use std.common.sdn.encode.sdn_encode_canonical
use std.common.contracts.orchestration.resource_v1.{parse_resource_document, as_dict}
use std.common.base_encoding.base64.base64url_encode
use std.common.crypto.sha256.sha256_text

fn primary_control_fixture_v4() -> SmuxPrimaryControlRequestV4:
    SmuxPrimaryControlRequestV4(control: SmuxRuntimeControlRequestV1(action: "input", binding_uid: "primary-a",
        control_kind: SessionRuntimeControlKindV1.Input, client_id: "", attachment_token: "",
        expected_revision: 1, nonce: "b".repeat(64), payload: "hello", columns: 0, rows: 0),
        attempt_sequence: 1, offset: 0, maximum: 4096)

fn primary_control_fields_v4(bytes: text) -> Dict<text, SdnValue>:
    val parsed = parse_resource_document(bytes).unwrap()
    as_dict(parsed.0, "", parsed.1).unwrap()

fn primary_control_wire_v4(bytes: text, key: text, value: SdnValue) -> text:
    var fields = primary_control_fields_v4(bytes)
    fields[key] = value
    sdn_encode_canonical(SdnValue.Dict(fields))

describe "smux primary control V4 immutable request":
    it "round trips explicit input attempts and byte offsets without clamping the requested prefix":
        step("round trips explicit input attempts and byte offsets without clamping the requested prefix")
        for attempt in [1, 1152921504606846975]:
            var request = primary_control_fixture_v4()
            request.attempt_sequence = attempt
            request.control.payload = "é"
            request.offset = 1
            val bytes = smux_primary_control_request_encode_v4(request).unwrap()
            val decoded = smux_primary_control_request_decode_v4(bytes).unwrap()
            expect(decoded).to_equal(request)
            expect(decoded.attempt_sequence).to_equal(attempt)
            expect(decoded.offset).to_equal(1)
            expect(decoded.maximum).to_equal(4096)
            expect(decoded.control.payload.bytes().len()).to_equal(2)
            expect(smux_primary_control_request_encode_v4(decoded).unwrap()).to_equal(bytes)

    it "rejects invalid attempt offset and prefix bounds on encode and decode":
        step("rejects invalid attempt offset and prefix bounds on encode and decode")
        val original = primary_control_fixture_v4()
        val bytes = smux_primary_control_request_encode_v4(original).unwrap()
        for field in ["attemptSequence", "offset", "maxBytes"]:
            val invalid = if field == "attemptSequence": [-1, 0, 1152921504606846976] elif field == "offset": [-1, 5, 6] else: [-1, 0, 4097]
            for value in invalid:
                var changed = original
                if field == "attemptSequence": changed.attempt_sequence = value
                if field == "offset": changed.offset = value
                if field == "maxBytes": changed.maximum = value
                expect(smux_primary_control_request_validate_v4(changed).is_err()).to_equal(true)
                expect(smux_primary_control_request_encode_v4(changed).is_err()).to_equal(true)
                expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, field, SdnValue.Int(value))).is_err()).to_equal(true)
        var boundary = original
        boundary.offset = 4
        boundary.maximum = 1
        expect(smux_primary_control_request_decode_v4(smux_primary_control_request_encode_v4(boundary).unwrap()).unwrap()).to_equal(boundary)

    it "retains V1 noninput validation with zero offsets and explicit resize attempts":
        step("retains V1 noninput validation with zero offsets and explicit resize attempts")
        for action in ["resolve", "issue", "inspect", "revoke", "resize"]:
            var request = primary_control_fixture_v4()
            request.control.action = action
            request.control.payload = ""
            request.control.nonce = ""
            request.control.expected_revision = 0
            request.attempt_sequence = 0
            request.offset = 0
            request.maximum = 0
            if action == "resolve" or action == "issue":
                request.control.client_id = "client-a"
                request.control.attachment_token = "a".repeat(32) + ":1"
            if action == "issue": request.control.expected_target_digest = "c".repeat(64)
            if action == "resize":
                request.control.control_kind = SessionRuntimeControlKindV1.Geometry
                request.control.expected_revision = 1
                request.control.nonce = "b".repeat(64)
                request.control.columns = 80
                request.control.rows = 24
            val bytes = smux_primary_control_request_encode_v4(request).unwrap()
            expect(smux_primary_control_request_decode_v4(bytes).unwrap()).to_equal(request)
            for field in ["attemptSequence", "offset", "maxBytes"]:
                if action == "resize" and field == "attemptSequence":
                    for attempt in [1, 1152921504606846975]:
                        var attempted = request
                        attempted.attempt_sequence = attempt
                        expect(smux_primary_control_request_decode_v4(smux_primary_control_request_encode_v4(attempted).unwrap()).unwrap()).to_equal(attempted)
                    for invalid in [-1, 1152921504606846976]:
                        expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, field, SdnValue.Int(invalid))).is_err()).to_equal(true)
                else:
                    expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, field, SdnValue.Int(1))).is_err()).to_equal(true)

    it "delegates nested V1 validity and canonicality without accepting a V1 request as V4":
        step("delegates nested V1 validity and canonicality without accepting a V1 request as V4")
        val request = primary_control_fixture_v4()
        val bytes = smux_primary_control_request_encode_v4(request).unwrap()
        val nested = smux_runtime_control_request_encode_v1(request.control).unwrap()
        expect(smux_primary_control_request_decode_v4(nested).is_err()).to_equal(true)
        expect(smux_runtime_control_request_decode_v1(bytes).is_err()).to_equal(true)
        val bad_nonce = primary_control_wire_v4(nested, "nonce", SdnValue.String("short"))
        for invalid in [bad_nonce, nested + "\n", "{}", nested.slice(0, nested.len() - 1) + ", version: 1}"]:
            expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, "controlRequest", SdnValue.String(invalid))).is_err()).to_equal(true)
        var changed = request
        changed.control.control_kind = SessionRuntimeControlKindV1.Geometry
        expect(smux_primary_control_request_validate_v4(changed).is_err()).to_equal(true)
        changed = request
        changed.control.payload = ""
        expect(smux_primary_control_request_encode_v4(changed).is_err()).to_equal(true)

    it "requires exact typed canonical V4 fields and rejects authority additions":
        step("requires exact typed canonical V4 fields and rejects authority additions")
        val bytes = smux_primary_control_request_encode_v4(primary_control_fixture_v4()).unwrap()
        val original = primary_control_fields_v4(bytes)
        expect(original.len()).to_equal(6)
        expect(original["version"]).to_equal(SdnValue.Int(4))
        expect(original["kind"]).to_equal(SdnValue.String("smux-primary-control-request"))
        for missing in ["version", "kind", "controlRequest", "attemptSequence", "offset", "maxBytes"]:
            var retained: Dict<text, SdnValue> = {}
            for key in original.keys():
                if key != missing: retained[key] = original[key]
            expect(smux_primary_control_request_decode_v4(sdn_encode_canonical(SdnValue.Dict(retained))).is_err()).to_equal(true)
        for key in ["version", "attemptSequence", "offset", "maxBytes"]:
            expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, key, SdnValue.String("1"))).is_err()).to_equal(true)
        for key in ["kind", "controlRequest"]:
            expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, key, SdnValue.Int(4))).is_err()).to_equal(true)
        for key in ["grant", "root", "principal", "retry"]:
            expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, key, SdnValue.String("caller"))).is_err()).to_equal(true)
        expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, "version", SdnValue.Int(1))).is_err()).to_equal(true)
        expect(smux_primary_control_request_decode_v4(primary_control_wire_v4(bytes, "kind", SdnValue.String("smux-runtime-control-request"))).is_err()).to_equal(true)
        for invalid in [" " + bytes, bytes + "\n", bytes.slice(0, bytes.len() - 1) + ", version: 4}", "[]"]:
            expect(smux_primary_control_request_decode_v4(invalid).is_err()).to_equal(true)

    it "binds the full attempt and byte prefix in the digest and canonical token":
        step("binds the full attempt and byte prefix in the digest and canonical token")
        val request = primary_control_fixture_v4()
        val bytes = smux_primary_control_request_encode_v4(request).unwrap()
        val digest = smux_primary_control_request_digest_v4(request).unwrap()
        expect(digest).to_equal(sha256_text(bytes))
        expect(digest == smux_runtime_control_request_digest_v1(request.control).unwrap()).to_equal(false)
        val token = smux_primary_control_request_token_v4(request).unwrap()
        expect(token).to_equal(base64url_encode(bytes))
        expect(smux_primary_control_request_from_token_v4(token).unwrap()).to_equal(request)
        for field in ["attempt", "offset", "maximum"]:
            var changed = request
            if field == "attempt": changed.attempt_sequence = 2
            if field == "offset": changed.offset = 1
            if field == "maximum": changed.maximum = 1
            expect(smux_primary_control_request_digest_v4(changed).unwrap() == digest).to_equal(false)
        for invalid in ["", token + "=", " " + token, token + "\n", "%%%"]:
            expect(smux_primary_control_request_from_token_v4(invalid).is_err()).to_equal(true)
        expect(smux_primary_control_request_from_token_v4(base64url_encode(bytes + "\n")).is_err()).to_equal(true)

    it "enforces raw byte and token bounds with space for the authenticated server frame":
        step("enforces raw byte and token bounds with space for the authenticated server frame")
        expect(smux_primary_control_request_decode_v4("{".repeat(2800)).unwrap_err()).to_equal("primary-control-request-syntax")
        for oversized in ["x".repeat(2801), "é".repeat(1401)]:
            expect(smux_primary_control_request_decode_v4(oversized).unwrap_err()).to_equal("primary-control-request-size")
        expect(smux_primary_control_request_from_token_v4("a".repeat(3735)).unwrap_err()).to_equal("primary-control-request-token-size")
        var request = primary_control_fixture_v4()
        request.control.payload = "\"".repeat(700)
        expect(smux_runtime_control_request_encode_v1(request.control).is_ok()).to_equal(true)
        expect(smux_primary_control_request_encode_v4(request).unwrap_err()).to_equal("primary-control-request-size")
        request = primary_control_fixture_v4()
        request.control.payload = "x".repeat(1024)
        val token = smux_primary_control_request_token_v4(request).unwrap()
        expect(token.bytes().len()).to_be_less_than(3735)
        val frame = "s".repeat(128) + " runtime-primary-control-v4 " + token
        expect(frame.bytes().len()).to_be_less_than(4097)
