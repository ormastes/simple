# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
#
# NOTE: this spec exercises os.apps.smux.mux_model, which imports the sibling-owned
# pure VT emulator at std.common.term.emulator. The terminal-free half of the same
# model is covered independently by mux_rects_spec.spl.

use std.spec
use std.common.term.emulator.{term_render_text}
use os.apps.smux.mux_model.{
    MuxPane,
    MuxWindow,
    MuxSession,
    mux_new,
    mux_add_pane,
    mux_select_pane,
    mux_zoom_pane,
    mux_kill_pane,
    mux_feed_pane,
    mux_resize,
    mux_pane_rects,
    mux_render,
    mux_find_pane
}

fn spec_pane_exists(s: MuxSession, pane_id: text) -> bool:
    val found = mux_find_pane(s, pane_id)
    if found.?:
        return true
    return false

fn spec_rect_field(row: text, idx: i64) -> text:
    val parts = row.split(" ")
    if idx < parts.len():
        return parts[idx]
    return ""

describe "in-process multiplexer session model":
    """As an operator running the caret suite on Windows, where there is no tmux,
    I need `cs` to own its own session, window and pane model so that I can add,
    focus, zoom and close panes and see them all in one composited frame."""

    it "assigns every added pane a distinct id and focuses the newest one":
        # @req REQ-SSPEC-OS
        step("Open a session and add two panes")
        val s0 = mux_new("cs", 80, 24)
        val a = mux_add_pane(s0, "editor", 11, 101)
        val b = mux_add_pane(a.0, "shell", 12, 102)
        val s = b.0

        step("The two pane ids differ and both resolve")
        expect(a.1 != b.1).to_equal(true)
        expect(spec_pane_exists(s, a.1)).to_equal(true)
        expect(spec_pane_exists(s, b.1)).to_equal(true)

        step("The active pane index points at the pane just added")
        expect(s.windows[0].active_pane).to_equal(1)
        expect(mux_find_pane(s, b.1)!.active).to_equal(true)
        expect(mux_find_pane(s, a.1)!.active).to_equal(false)

    it "moves focus to the selected pane":
        # @req REQ-SSPEC-OS
        step("Two panes, then select the first")
        val a = mux_add_pane(mux_new("cs", 80, 24), "editor", 11, 101)
        val b = mux_add_pane(a.0, "shell", 12, 102)
        val sel = mux_select_pane(b.0, a.1)

        step("Selection succeeds and the focus follows it")
        expect(sel.1).to_equal(true)
        expect(sel.0.windows[0].active_pane).to_equal(0)
        expect(mux_find_pane(sel.0, a.1)!.active).to_equal(true)
        expect(mux_find_pane(sel.0, b.1)!.active).to_equal(false)

    it "refuses to select a pane that does not exist":
        # @req REQ-SSPEC-OS
        step("Select an unknown id")
        val a = mux_add_pane(mux_new("cs", 80, 24), "editor", 11, 101)
        val sel = mux_select_pane(a.0, "no-such-pane")
        expect(sel.1).to_equal(false)
        expect(sel.0.windows[0].active_pane).to_equal(0)

    it "shows only the zoomed pane, covering the whole window":
        # @req REQ-SSPEC-OS
        step("Three panes tile the window")
        val a = mux_add_pane(mux_new("cs", 80, 24), "one", 11, 101)
        val b = mux_add_pane(a.0, "two", 12, 102)
        val c = mux_add_pane(b.0, "three", 13, 103)
        expect(mux_pane_rects(c.0).len()).to_equal(3)

        step("Zooming the middle pane leaves exactly one rect covering 80x24")
        val z = mux_zoom_pane(c.0, b.1)
        expect(z.1).to_equal(true)
        val rects = mux_pane_rects(z.0)
        expect(rects.len()).to_equal(1)
        expect(rects[0]).to_equal(b.1 + " 0 0 80 24")

        step("Zoom is a toggle: unzooming restores all three rects")
        val u = mux_zoom_pane(z.0, b.1)
        expect(mux_pane_rects(u.0).len()).to_equal(3)

    it "leaves a valid active pane after killing the focused pane":
        # @req REQ-SSPEC-OS
        step("Three panes with focus on the last")
        val a = mux_add_pane(mux_new("cs", 80, 24), "one", 11, 101)
        val b = mux_add_pane(a.0, "two", 12, 102)
        val c = mux_add_pane(b.0, "three", 13, 103)
        expect(c.0.windows[0].active_pane).to_equal(2)

        step("Killing the focused pane keeps the index inside the shrunken list")
        val k = mux_kill_pane(c.0, c.1)
        expect(k.1).to_equal(true)
        val w = k.0.windows[0]
        expect(w.panes.len()).to_equal(2)
        expect(w.active_pane >= 0).to_equal(true)
        expect(w.active_pane < w.panes.len()).to_equal(true)
        expect(spec_pane_exists(k.0, c.1)).to_equal(false)

    it "reports no active pane once the last pane is killed":
        # @req REQ-SSPEC-OS
        step("Kill the only pane")
        val a = mux_add_pane(mux_new("cs", 80, 24), "one", 11, 101)
        val k = mux_kill_pane(a.0, a.1)
        expect(k.1).to_equal(true)
        expect(k.0.windows[0].panes.len()).to_equal(0)
        expect(k.0.windows[0].active_pane).to_equal(-1)

    it "delivers fed bytes only to the addressed pane":
        # @req REQ-SSPEC-OS
        step("Two panes, feed text to the first only")
        val a = mux_add_pane(mux_new("cs", 80, 24), "one", 11, 101)
        val b = mux_add_pane(a.0, "two", 12, 102)
        val fed = mux_feed_pane(b.0, a.1, "HELLOMUX")

        step("The addressed pane's screen carries the text")
        val target = term_render_text(mux_find_pane(fed, a.1)!.screen)
        expect(target.contains("HELLOMUX")).to_equal(true)

        step("The other pane's screen is untouched")
        val other = term_render_text(mux_find_pane(fed, b.1)!.screen)
        expect(other.contains("HELLOMUX")).to_equal(false)

    it "re-lays-out and resizes every pane screen on a window resize":
        # @req REQ-SSPEC-OS
        step("Two panes in an 80x24 window")
        val a = mux_add_pane(mux_new("cs", 80, 24), "one", 11, 101)
        val b = mux_add_pane(a.0, "two", 12, 102)

        step("Resize the window to 120x40")
        val r = mux_resize(b.0, 120, 40)
        expect(r.cols).to_equal(120)
        expect(r.rows).to_equal(40)

        step("The rects tile the new width")
        val rects = mux_pane_rects(r)
        expect(rects.len()).to_equal(2)
        val last_col = spec_rect_field(rects[1], 1).to_i64()
        val last_w = spec_rect_field(rects[1], 3).to_i64()
        expect(last_col + last_w).to_equal(120)

        step("Each pane's own screen was resized to its band, not left stale")
        val pa = mux_find_pane(r, a.1)!
        val pb = mux_find_pane(r, b.1)!
        expect(pa.screen.rows).to_equal(40)
        expect(pb.screen.rows).to_equal(40)
        expect(pa.screen.cols + pb.screen.cols).to_equal(120)

    it "composites content from more than one pane when nothing is zoomed":
        # @req REQ-SSPEC-OS
        step("Two panes each carrying distinct content")
        val a = mux_add_pane(mux_new("cs", 40, 6), "one", 11, 101)
        val b = mux_add_pane(a.0, "two", 12, 102)
        val f1 = mux_feed_pane(b.0, a.1, "AAAAA")
        val f2 = mux_feed_pane(f1, b.1, "BBBBB")

        step("The frame shows both panes' content and marks the active one")
        val frame = mux_render(f2)
        expect(frame.contains("AAAAA")).to_equal(true)
        expect(frame.contains("BBBBB")).to_equal(true)
        expect(frame.contains("*two")).to_equal(true)

        step("Zooming collapses the frame to the zoomed pane alone")
        val z = mux_zoom_pane(f2, b.1)
        val zframe = mux_render(z.0)
        expect(zframe.contains("BBBBB")).to_equal(true)
        expect(zframe.contains("AAAAA")).to_equal(false)
