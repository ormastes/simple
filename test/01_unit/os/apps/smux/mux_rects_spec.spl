# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS

use std.spec
use os.apps.smux.mux_rects.{
    MuxRect,
    mux_rect_to_text,
    mux_full_rect,
    mux_even_columns
}

describe "mux pane geometry":
    """As an operator running the caret suite on a host with no tmux, I need the
    multiplexer to divide my terminal among panes so that every pane gets a real,
    non-overlapping slice of the window and nothing falls off the edge."""

    it "tiles the window exactly across three panes with no gap or overlap":
        # @req REQ-SSPEC-OS
        step("Divide an 80x24 window among three panes")
        val rects = mux_even_columns(["a", "b", "c"], 80, 24)
        expect(rects.len()).to_equal(3)

        step("Each band starts where the previous one ended")
        expect(rects[0].col).to_equal(0)
        expect(rects[1].col).to_equal(rects[0].col + rects[0].cols)
        expect(rects[2].col).to_equal(rects[1].col + rects[1].cols)

        step("The bands together cover the full width and full height")
        expect(rects[2].col + rects[2].cols).to_equal(80)
        expect(rects[0].rows).to_equal(24)
        expect(rects[2].rows).to_equal(24)

    it "gives the sole pane the whole window":
        # @req REQ-SSPEC-OS
        step("One pane in a 100x30 window")
        val rects = mux_even_columns(["only"], 100, 30)
        expect(rects.len()).to_equal(1)
        expect(rects[0].cols).to_equal(100)
        expect(rects[0].rows).to_equal(30)

    it "returns no rects when there are no panes":
        # @req REQ-SSPEC-OS
        step("An empty window has nothing to lay out")
        val empty: [text] = []
        expect(mux_even_columns(empty, 80, 24).len()).to_equal(0)

    it "refuses panes that outnumber available columns instead of overflowing":
        # @req REQ-SSPEC-OS
        step("Four panes cannot fit inside a 3-column window")
        val rects = mux_even_columns(["a", "b", "c", "d"], 3, 5)
        expect(rects.len()).to_equal(0)

    it "reports a rect in the pane_id col row cols rows wire form":
        # @req REQ-SSPEC-OS
        step("Serialise a full-window rect")
        expect(mux_rect_to_text(mux_full_rect("z", 80, 24))).to_equal("z 0 0 80 24")
