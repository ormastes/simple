# Pure state regressions only. Synthetic refs never enter a native operation.
# AUTHORED / NOT_RUN: these checks do not prove a live provider stream.
use std.spec.{describe, it, expect, step}
use std.sosix.process.PipedProcessRefV1
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.contract.{MuxSession, MuxWindow, MuxPane}
use os.apps.smux.input_queue.pane_input_new
use os.apps.smux.mux_rects.MuxRect
use os.apps.smux.service_revision.service_configuration_equal
use os.apps.smux.pane_io_service.{pane_literal_admit_v1, pane_send_state,
    pane_paste_state, pane_command_state}
use os.apps.smux.pane_configured_launch_service.pane_configured_launch_admit
use os.apps.smux.window_layout_service.{layout_resize_capable, resize_layout_children}
use os.apps.smux.split_checkpoint.{split_checkpoint_capture, split_checkpoint_restore}

fn terminal_ref_state() -> ServiceState:
    val rect = MuxRect(pane_id: "p", col: 0, row: 0, cols: 80, rows: 24)
    var state = ServiceState.empty()
    state = state.add_session(MuxSession.create("s", "terminal"))
    state = state.add_window(MuxWindow.create("w", "s", "terminal").with_geometry([rect], 80, 24))
    val pane = PaneRecord.create(MuxPane.create("p", "w", "s")).resize(80, 24)
    return state.add_pane(pane.with_terminal_ref(PipedProcessRefV1(pid: 71, generation: 1)))

describe "smux canonical terminal ref state":
    it "preserves canonical identity and read outcome through pane clones":
        step("Copy focus input geometry and terminal response state without losing cleanup authority")
        var pane = terminal_ref_state().get_pane(0)
        pane.terminal_eof = true
        pane.terminal_read_error = "retained read failure"
        for copy in [pane.with_focus(true), pane.with_input(pane_input_new()),
                pane.resize(81, 25), pane.without_replies()]:
            expect(copy.same_terminal_ref(pane.terminal_ref)).to_equal(true)
            expect(copy.terminal_pipe).to_equal(true)
            expect(copy.terminal_eof).to_equal(true)
            expect(copy.terminal_read_error).to_equal("retained read failure")

    it "distinguishes reused pids by canonical generation and incarnation":
        step("Advance child incarnation for a changed registry generation even when the PID is unchanged")
        val pane = terminal_ref_state().get_pane(0)
        val same = pane.with_terminal_ref(PipedProcessRefV1(pid: 71, generation: 1))
        val replaced = pane.with_terminal_ref(PipedProcessRefV1(pid: 71, generation: 2))
        expect(same.child_incarnation).to_equal(pane.child_incarnation)
        expect(replaced.child_pid).to_equal(pane.child_pid)
        expect(replaced.child_incarnation).to_equal(pane.child_incarnation + 1)
        expect(replaced.same_terminal_ref(pane.terminal_ref)).to_equal(false)
        val closed = replaced.with_pty(-1, -1)
        expect(closed.terminal_ref == nil).to_equal(true)
        expect(closed.child_pid).to_equal(-1)
        expect(closed.terminal_pipe).to_equal(true)

    it "publishes canonical reference changes in configuration identity":
        step("Compare registry generations independently of a diagnostic PID or stale incarnation counter")
        val state = terminal_ref_state()
        var changed = state.get_pane(0)
        changed.terminal_ref = PipedProcessRefV1(pid: 71, generation: 2)
        expect(service_configuration_equal(state, state.replace_pane(0, changed))).to_equal(false)
        expect(service_configuration_equal(state, state.replace_pane(0, changed.with_input(pane_input_new())))).to_equal(false)

    it "rejects output-only transport input before queue or native effects":
        step("Reject literal text command and paste while preserving the same owner and queue")
        val state = terminal_ref_state()
        expect(pane_literal_admit_v1(state, false, "s", "w", "p", true).unwrap_err()).to_equal("terminal transport is read-only")
        for update in [pane_send_state(state, false, "s", "w", "p", "text"),
                pane_command_state(state, false, "s", "w", "p", "command"),
                pane_paste_state(state, false, "s", "w", "p", "paste")]:
            expect(update.result.unwrap_err()).to_equal("terminal transport is read-only")
            expect(update.commit).to_equal(false)
            expect(update.state.get_pane(0).input.bytes.len()).to_equal(0)
            expect(update.state.get_pane(0).same_terminal_ref(state.get_pane(0).terminal_ref)).to_equal(true)
        expect(layout_resize_capable(state, [0], true)).to_equal(false)
        val changed_geometry = [MuxRect(pane_id: "p", col: 0, row: 0, cols: 81, rows: 25)]
        val resized = resize_layout_children(state, [0], changed_geometry)
        expect(resized.is_err()).to_equal(true)
        expect(resized.unwrap_err()).to_equal("terminal transport geometry unsupported")
        expect(resized.state.get_pane(0).pane.cols).to_equal(80)
        expect(resized.state.get_pane(0).pane.rows).to_equal(24)
        expect(pane_configured_launch_admit(state, false, "s", "w", "p").is_err()).to_equal(true)

    it "refuses split rollback across a canonical generation change":
        step("Check retained stream identity before any geometry compensation")
        val before = terminal_ref_state()
        val rects = [MuxRect(pane_id: "p", col: 0, row: 0, cols: 39, rows: 24),
            MuxRect(pane_id: "q", col: 40, row: 0, cols: 40, rows: 24)]
        var after = before.replace_window(0, before.get_window(0).with_geometry(rects, 80, 24))
        after = after.replace_pane(0, after.get_pane(0).resize(39, 24))
        after = after.add_pane(PaneRecord.create(MuxPane.create("q", "w", "s")).resize(40, 24))
        val checkpoint = split_checkpoint_capture(before, after, "s", "w", "q")
        var changed = after.get_pane(0)
        changed.terminal_ref = PipedProcessRefV1(pid: 71, generation: 2)
        val result = split_checkpoint_restore(after.replace_pane(0, changed), checkpoint)
        expect(result.is_err()).to_equal(true)
        expect(result.unwrap_err()).to_contain("canonical child changed")
