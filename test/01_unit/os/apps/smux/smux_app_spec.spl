# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec
use os.apps.smux.api.{
    smux_reset_for_test,
    smux_list_sessions,
    smux_list_windows,
    smux_list_panes,
    smux_capture
}
use os.apps.smux.smux_app.{
    smux_help_text,
    smux_run_cmd
}
use os.apps.smux.smux_remote.{

    SMUX_APP_ID,
    smux_ready_marker,
    smux_remote_launch_once
}

describe "smux app":
    # @manual scenario evidence
    it "creates a session from the cli entry":
        # @req REQ-SSPEC-OS
        step("creates a session from the cli entry")
        smux_reset_for_test()
        expect(smux_run_cmd(["new", "dev"])).to_equal(0)
        val sessions = smux_list_sessions()
        expect(sessions.len()).to_equal(1)
        expect(sessions[0].name).to_equal("dev")

    it "sends and captures through the active pane commands":
        # @req REQ-SSPEC-OS
        step("sends and captures through the active pane commands")
        smux_reset_for_test()
        expect(smux_run_cmd(["new", "io"])).to_equal(0)
        expect(smux_run_cmd(["send", "io", "echo", "hi"])).to_equal(0)
        expect(smux_run_cmd(["capture", "io"])).to_equal(0)
        val session = smux_list_sessions()[0]
        val window = smux_list_windows(session.id)[0]
        val pane = smux_list_panes(session.id, window.id)[0]
        expect(pane.id != "").to_equal(true)

    it "routes the full command to the named session only":
        # @req REQ-SSPEC-OS
        step("Create two sessions and address the second by name")
        smux_reset_for_test()
        expect(smux_run_cmd(["new", "first"])).to_equal(0)
        expect(smux_run_cmd(["new", "second"])).to_equal(0)
        expect(smux_run_cmd(["send", "second", "echo", "hello", "world"])).to_equal(0)

        step("Capture both panes and require isolation plus complete argv joining")
        val sessions = smux_list_sessions()
        val first_window = smux_list_windows(sessions[0].id)[0]
        val second_window = smux_list_windows(sessions[1].id)[0]
        val first_pane = smux_list_panes(sessions[0].id, first_window.id)[0]
        val second_pane = smux_list_panes(sessions[1].id, second_window.id)[0]
        val first_capture = smux_capture(sessions[0].id, first_window.id,
            first_pane.id, 100)
        val second_capture = smux_capture(sessions[1].id, second_window.id,
            second_pane.id, 100)
        expect(first_capture.content).to_equal("")
        expect(second_capture.content).to_contain("echo hello world")

    it "fails when a command names an unknown session":
        # @req REQ-SSPEC-OS
        step("Reject every pane command before touching another session")
        smux_reset_for_test()
        expect(smux_run_cmd(["new", "known"])).to_equal(0)
        expect(smux_run_cmd(["send", "missing", "echo", "unsafe"])).to_equal(1)
        expect(smux_run_cmd(["capture", "missing"])).to_equal(1)
        expect(smux_run_cmd(["split", "missing"])).to_equal(1)

    it "reports deferred features and exposes a filesystem app identity":
        # @req REQ-SSPEC-OS
        step("reports deferred features and exposes a filesystem app identity")
        smux_reset_for_test()
        expect(smux_run_cmd(["deferred", "copy-mode"])).to_equal(0)
        expect(smux_help_text()).to_contain("smux deferred <feature>")
        expect(smux_ready_marker(42)).to_contain(SMUX_APP_ID)
        expect(smux_remote_launch_once(42)).to_equal(true)
