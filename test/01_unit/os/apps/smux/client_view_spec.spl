"""
Pure terminal client wire and viewport contracts. No terminal/process execution
or interactive UI acceptance follows. Docgen/execution remain TEST_BLOCKED.
# @manual: primary
"""
use std.spec.{describe, it, expect, step}
use os.apps.smux.client_view.{client_input_hex, client_reply_ids,
    client_frame_body, client_next_id, client_copy_frame, client_clip_line}

describe "smux terminal client view helpers":
    it "should encode raw controls spaces and Unicode without implicit newline":
        # @req REQ-SMUX-INTERACTIVE-002
        step("Encode the exact terminal payload for the line protocol")
        expect(client_input_hex("\x03\r\x1b[A é")).to_equal("030d1b5b4120c3a9")
        expect(client_input_hex("")).to_equal("")

    it "should extract ordered ids from an actual protocol resource list":
        # @req REQ-SMUX-INTERACTIVE-003
        step("Read window identities without selecting service global focus")
        val ids = client_reply_ids("smux: windows[work]:\nid2 editor\nid9 shell\n", "smux: windows[")
        expect(ids.is_ok()).to_equal(true)
        expect(ids.unwrap()).to_equal(["id2", "id9"])
        expect(client_next_id(ids.unwrap(), "id2")).to_equal("id9")
        expect(client_next_id(ids.unwrap(), "id9")).to_equal("id2")

    it "should refuse errors malformed ids and duplicate resource identities":
        # @req REQ-SMUX-INTERACTIVE-003
        step("Refuse reply substitution instead of treating it as an empty view")
        expect(client_reply_ids("smux: unknown session work", "smux: windows[").is_err()).to_equal(true)
        expect(client_reply_ids("smux: windows[work]:\nid2x bad\n", "smux: windows[").is_err()).to_equal(true)
        expect(client_reply_ids("smux: windows[work]:\nid2 a\nid2 b\n", "smux: windows[").is_err()).to_equal(true)

    it "should handle empty and replaced client local view lists":
        # @req REQ-SMUX-INTERACTIVE-003
        step("Recover local selection only from the current explicit resource list")
        expect(client_next_id([], "id1")).to_equal("")
        expect(client_next_id(["id5"], "id1")).to_equal("id5")
        expect(client_reply_ids("smux: panes[work]:\n", "smux: panes[").unwrap().len()).to_equal(0)

    it "should preserve the entire styled terminal frame after its header":
        # @req REQ-SMUX-INTERACTIVE-004
        step("Separate validated dimensions from the server-generated VT frame")
        val body = "\x1b[H\x1b[31mred\x1b[0m\nnext"
        expect(client_frame_body("SMUX-FRAME/1 80 24\n" + body).unwrap()).to_equal(body)

    it "should refuse missing oversized and malformed frame headers":
        # @req REQ-SMUX-INTERACTIVE-004
        step("Reject a protocol error or impossible canvas before rendering")
        expect(client_frame_body("smux: frame failed").is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 0 24\nbody").is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 513 24\nbody").is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 512 256\nbody").is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 80 24 extra\nbody").is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 100 30\nbody", 80, 24).is_err()).to_equal(true)
        expect(client_frame_body("SMUX-FRAME/1 80 24\nbody", 100, 30).unwrap()).to_equal("body")

    it "should scroll a local history viewport without rewriting history":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Render the current two-line viewport and move one line back")
        val history = ["old", "middle", "new"]
        expect(client_copy_frame(history, 0, 2)).to_end_with("middle\r\nnew")
        expect(client_copy_frame(history, 1, 2)).to_end_with("old\r\nmiddle")
        expect(history).to_equal(["old", "middle", "new"])

    it "should clamp the history start and render an empty viewport safely":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Request more rows or older rows than the captured history contains")
        expect(client_copy_frame(["only"], 0, 24)).to_end_with("only")
        expect(client_copy_frame(["only"], 2000, 24)).to_equal("\x1b[?25l\x1b[H\x1b[2J")
        expect(client_copy_frame([], 0, 24)).to_equal("\x1b[?25l\x1b[H\x1b[2J")

    it "should clip old wider rows by cells and refuse terminal control replay":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Resize a Unicode history viewport and clip an orphan wide glyph")
        expect(client_clip_line("a界b", 3)).to_equal("a界")
        expect(client_clip_line("a界b", 2)).to_equal("a")
        expect(client_clip_line("e\u{301}x", 1)).to_equal("e\u{301}")
        expect(client_clip_line("a\x1bb\x07c", 10)).to_equal("abc")

    it "should visibly mark the selected history line range":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Mark a line and move down across two visible history rows")
        expect(client_copy_frame(["old", "middle", "new"], 0, 2, 80, 1)).to_end_with("\x1b[7mmiddle\x1b[0m\r\n\x1b[7mnew\x1b[0m")
