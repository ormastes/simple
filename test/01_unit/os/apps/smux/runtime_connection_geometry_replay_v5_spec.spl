# AUTHORED SOURCE-ONLY NOT_RUN. Actual pure production replay-helper calls.
# Public request/lease metadata only: no opaque owner, issuer or native receipt.
use std.spec.*
use os.apps.smux.runtime_connection_geometry_replay_v5.smux_connection_geometry_replay_v5
use test.fixtures.orchestration.simple_container_windows_adapter_fixture_v2.{
    windows_adapter_scope_fixture_v2, windows_adapter_request_fixture_v2}
use std.common.contracts.container.primary_geometry_v1.ContainerPrimaryGeometryRequestV1
use std.common.contracts.container.runtime_v1.RuntimeIdentityV1
use std.common.contracts.container.execution_v2.container_scope_fence_id_v2
use std.common.contracts.mux.session_runtime_control_v1.{SessionRuntimeControlTargetV1,
    SessionRuntimeControlLeaseV1, SessionRuntimeControlKindV1}
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_async_mut.container.providers.windows.docker_engine_codec_v3.windows_engine_container_resize_v3
use std.nogc_async_mut.container.providers.windows.docker_engine_exchange_v3.windows_docker_engine_exchange_serialize_v3

fn geometry_replay_digest_v5(target: SessionRuntimeControlTargetV1, rows: i64, columns: i64) -> text:
    val request = windows_engine_container_resize_v3("1.48", target.runtime.native_id, rows, columns, true).unwrap()
    sha256_u8_hex(windows_docker_engine_exchange_serialize_v3(request).unwrap())

fn geometry_replay_request_fixture_v5(revision: i64 = 3, sequence: i64 = 5) -> ContainerPrimaryGeometryRequestV1:
    val scope = windows_adapter_scope_fixture_v2()
    val workload = windows_adapter_request_fixture_v2().plan
    val runtime = RuntimeIdentityV1(pod_uid: workload.workload_uid, attempt: workload.attempt,
        operation_id: workload.operation_id, provider_generation: scope.provider_generation,
        engine: "docker", native_id: "4".repeat(64), node_boot_id: container_scope_fence_id_v2(scope).unwrap())
    val target = SessionRuntimeControlTargetV1(scope: scope, runtime: runtime,
        workload_request_digest: workload.request_digest, binding_uid: "binding-a",
        binding_digest: "e".repeat(64), service_incarnation: "f".repeat(32), session_id: "session-a",
        window_id: "window-a", pane_id: "pane-a", service_epoch: 1, child_incarnation: 1,
        client_id: "client-a", attachment_generation: 1, execution_kind: "primary",
        native_exec_id: "", exec_request_digest: "")
    val nonce = "geometry-revision-" + revision.to_text()
    val lease = SessionRuntimeControlLeaseV1(target: target, kind: SessionRuntimeControlKindV1.Geometry,
        principal_id: "fixture-owner", nonce_digest: sha256_text(nonce), revision: revision,
        issued_monotonic_ms: 100, expires_monotonic_ms: 1000)
    ContainerPrimaryGeometryRequestV1(lease: lease, target: target, principal: "fixture-owner", nonce: nonce,
        attempt_sequence: sequence, rows: 24, columns: 80,
        request_digest: geometry_replay_digest_v5(target, 24, 80))

describe "Geometry replay classification across lease renewal":
    it "starts fresh revision four at sequence one after known revision three sequence five":
        step("Classify a renewed lease as a new metadata candidate rather than continuing the old lease counter")
        val prior = geometry_replay_request_fixture_v5(3, 5)
        var renewed = geometry_replay_request_fixture_v5(4, 1)
        renewed.lease.issued_monotonic_ms = 200
        renewed.lease.expires_monotonic_ms = 1200
        expect(smux_connection_geometry_replay_v5(Some(prior), renewed, false).unwrap()).to_equal(false)

    it "returns exact same-lease same-attempt replay even while the caller reports unresolved state":
        step("Permit cached observation without authorizing another begin for an in-flight or Unknown request")
        val prior = geometry_replay_request_fixture_v5()
        expect(smux_connection_geometry_replay_v5(Some(prior), prior, false).unwrap()).to_equal(true)
        expect(smux_connection_geometry_replay_v5(Some(prior), prior, true).unwrap()).to_equal(true)

    it "refuses changed geometry payload under the same lease and attempt":
        step("Recompute a valid changed wire digest while retaining the original attempt number")
        val prior = geometry_replay_request_fixture_v5()
        var changed = prior
        changed.columns = 81
        changed.request_digest = geometry_replay_digest_v5(changed.target, changed.rows, changed.columns)
        expect(smux_connection_geometry_replay_v5(Some(prior), changed, false).unwrap_err()).to_equal("runtime-geometry-attempt-changed")
        expect(smux_connection_geometry_replay_v5(Some(prior), changed, true).unwrap_err()).to_equal("runtime-geometry-attempt-changed")

    it "admits exactly the next same-lease sequence only after known completion":
        step("Require contiguous sequencing and block a new begin while prior outcome is unresolved")
        val prior = geometry_replay_request_fixture_v5()
        var next = prior
        next.attempt_sequence = 6
        expect(smux_connection_geometry_replay_v5(Some(prior), next, false).unwrap()).to_equal(false)
        expect(smux_connection_geometry_replay_v5(Some(prior), next, true).unwrap_err()).to_equal("runtime-geometry-prior-unresolved")
        next.attempt_sequence = 7
        expect(smux_connection_geometry_replay_v5(Some(prior), next, false).unwrap_err()).to_equal("runtime-geometry-attempt-not-next")
        next.attempt_sequence = 4
        expect(smux_connection_geometry_replay_v5(Some(prior), next, false).unwrap_err()).to_equal("runtime-geometry-attempt-not-next")

    it "rejects old-counter continuation on a new revision and blocks renewal while unresolved":
        step("A fresh revision must restart at one and cannot bypass Unknown or in-flight prior ownership")
        val prior = geometry_replay_request_fixture_v5(3, 5)
        var renewed = geometry_replay_request_fixture_v5(4, 6)
        expect(smux_connection_geometry_replay_v5(Some(prior), renewed, false).unwrap_err()).to_equal("runtime-geometry-new-lease-first-attempt")
        renewed.attempt_sequence = 1
        expect(smux_connection_geometry_replay_v5(Some(prior), renewed, true).unwrap_err()).to_equal("runtime-geometry-prior-unresolved")

    it "refuses nonce full-target and deadline mutation at the same or a lower revision":
        step("Do not relabel an existing revision or use an older revision to authorize a different lease tuple")
        val prior = geometry_replay_request_fixture_v5(3, 5)
        for revision in [3, 2]:
            for field in ["nonce", "target", "expiry", "issued"]:
                var changed = prior
                changed.lease.revision = revision
                changed.attempt_sequence = if revision == 3: 5 else: 1
                if field == "nonce":
                    changed.nonce = "changed-raw-nonce"
                    changed.lease.nonce_digest = sha256_text(changed.nonce)
                elif field == "target":
                    changed.target.client_id = "client-b"
                    changed.target.attachment_generation = 2
                    changed.lease.target = changed.target
                elif field == "expiry": changed.lease.expires_monotonic_ms = 1001
                else: changed.lease.issued_monotonic_ms = 101
                val reason = if revision == 3: "runtime-geometry-lease-changed-at-revision" else: "runtime-geometry-lease-revision-stale"
                expect(smux_connection_geometry_replay_v5(Some(prior), changed, false).unwrap_err()).to_equal(reason)

    it "allows attachment rotation under a higher revision with unchanged stable binding":
        step("Refresh client attachment metadata while retaining the adopted runtime and pane identity")
        val prior = geometry_replay_request_fixture_v5(3, 5)
        var renewed = geometry_replay_request_fixture_v5(4, 1)
        renewed.target.client_id = "client-b"
        renewed.target.attachment_generation = 2
        renewed.lease.target = renewed.target
        expect(smux_connection_geometry_replay_v5(Some(prior), renewed, false).unwrap()).to_equal(false)
        expect(smux_connection_geometry_replay_v5(Some(prior), renewed, true).unwrap_err()).to_equal("runtime-geometry-prior-unresolved")

    it "refuses changed pane runtime and adoption metadata even under a higher revision":
        step("Keep every stable binding field while allowing only the explicit client attachment exclusions")
        val prior = geometry_replay_request_fixture_v5(3, 5)
        for field in ["pane", "runtime", "pod", "bindingUid", "bindingDigest", "service", "session", "window", "epoch", "child"]:
            var changed = geometry_replay_request_fixture_v5(4, 1)
            if field == "pane": changed.target.pane_id = "pane-b"
            elif field == "runtime": changed.target.runtime.native_id = "8".repeat(64)
            elif field == "pod": changed.target.runtime.pod_uid = "pod-b"
            elif field == "bindingUid": changed.target.binding_uid = "binding-b"
            elif field == "bindingDigest": changed.target.binding_digest = "8".repeat(64)
            elif field == "service": changed.target.service_incarnation = "0".repeat(32)
            elif field == "session": changed.target.session_id = "session-b"
            elif field == "window": changed.target.window_id = "window-b"
            elif field == "epoch": changed.target.service_epoch = 2
            else: changed.target.child_incarnation = 2
            changed.lease.target = changed.target
            changed.request_digest = geometry_replay_digest_v5(changed.target, changed.rows, changed.columns)
            expect(smux_connection_geometry_replay_v5(Some(prior), changed, false).unwrap_err()).to_equal("control-target-changed")

    it "requires first sequence one without history and preserves positive request bounds":
        step("Reject unexplained initial history and bounded integer violations without constructing native state")
        val first = geometry_replay_request_fixture_v5(3, 1)
        expect(smux_connection_geometry_replay_v5(nil, first, false).unwrap()).to_equal(false)
        expect(smux_connection_geometry_replay_v5(nil, first, true).unwrap_err()).to_equal("runtime-geometry-prior-unresolved")
        var not_first = first
        not_first.attempt_sequence = 2
        expect(smux_connection_geometry_replay_v5(nil, not_first, false).unwrap_err()).to_equal("runtime-geometry-first-attempt")
        for field in ["sequence", "revision"]:
            for invalid in [0, -1, 1152921504606846976]:
                var changed = first
                if field == "sequence": changed.attempt_sequence = invalid
                else: changed.lease.revision = invalid
                expect(smux_connection_geometry_replay_v5(nil, changed, false).unwrap_err()).to_equal("runtime-geometry-attempt-bound")
        var maximum = first
        maximum.lease.revision = 1152921504606846975
        expect(smux_connection_geometry_replay_v5(nil, maximum, false).unwrap()).to_equal(false)
