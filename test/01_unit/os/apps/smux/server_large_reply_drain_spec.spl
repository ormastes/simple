# @cover src/os/apps/smux/server.spl 10%
"""
# smux owner: a large reply is delivered whole

## Overview

The owner wrote one 4 KiB chunk of a reply per serve-loop turn. Every turn
also polls every pane PTY through the VT screen, so while a pane printed a
few hundred KB each turn took tens of milliseconds and a 400 KB
`history-joined` reply (100 turns) hit the 2 s client deadline half-sent.
The client decoded "incomplete smux response", `_smux_req` returned nil, and
`capture_pane` reported an EMPTY transcript for a pane that was full
(bug: smux pane drops `simple.exe` console stdout, 2026-11-12 — the CLI's
own diagnostics were the few hundred KB).

Fixture: a real owner and one pane that prints 2000 lines of 200 columns
(~400 KB). The capture must carry the first and the last line.
"""
use std.spec.*
use app.io.mod.{process_run, dir_create_all, dir_remove_all, file_write, file_read, cwd}
use app.llm_caret.agent_workspace.{agent_workspace, workspace_backend, workspace_available, session_kill, agent_attach,
    wait_for_pane_text, capture_pane, workspace_server_address, workspace_server_token_path}
use os.apps.smux.server.{smux_server_request_within}

fn _fixture_repo(root: text) -> text:
    val repo = root + "/repo"
    dir_create_all(repo)
    process_run("git", ["-C", repo, "init", "-q"])
    process_run("git", ["-C", repo, "config", "user.email", "caret@test"])
    process_run("git", ["-C", repo, "config", "user.name", "caret"])
    file_write(repo + "/README.md", "fixture\n")
    process_run("git", ["-C", repo, "add", "README.md"])
    process_run("git", ["-C", repo, "commit", "-q", "-m", "init"])
    repo

describe "smux owner reply delivery":
    it "delivers a 400 KB pane history whole while the pane is still being polled":
        # @req REQ-SMUX-OWNER-REPLY-WHOLE
        # @capture(statistics): reply length vs pane transcript on a real owner
        if workspace_backend() != "smux":
            pending("smux only: the owner process exists on Windows")
            return
        if not workspace_available():
            pending("BLOCKED: smux pane shell `sh` not on PATH")
            return
        val root = cwd().replace("\\", "/") + "/build/test-artifacts/smux/large_reply"
        dir_remove_all(root)
        val repo = _fixture_repo(root)
        val ws = agent_workspace("smux-bigreply", repo, root + "/trees")
        session_kill(ws)

        step("A pane prints 2000 lines of 200 columns, then idles")
        val gen = "awk 'BEGIN{for(i=0;i<2000;i++){s=\"\";for(j=0;j<200;j++)s=s \"x\";print i, s}}'"
        expect(agent_attach(ws, "a", "echo BEGIN; " + gen + "; echo END_BIG; exec sleep 300").status).to_equal("ok")

        step("The capture carries the last line, so the whole transcript came back")
        # The owner ingests the 400 KB through its VT screen first (tens of
        # seconds in the interpreter), so poll rather than snapshot once.
        val seen = wait_for_pane_text(ws, "smux-bigreply:a", "END_BIG", 300000)
        if not seen:
            print("[evidence] capture length: " + capture_pane(ws, "smux-bigreply:a").len().to_text())
        expect(seen).to_be(true)
        # The history holds 2000 lines, so the first lines scroll out; the
        # middle and the last line must both be in one reply.
        val text = capture_pane(ws, "smux-bigreply:a")
        expect(text.contains("\n1000 xxxx")).to_be(true)
        expect(text.contains("\n1999 xxxx")).to_be(true)
        expect(text.len()).to_be_greater_than(400000)

        step("The raw owner reply is a complete length-framed message")
        val addr = workspace_server_address(ws) ?? ""
        val token = file_read(workspace_server_token_path(ws) ?? "").trim().split(" ")[2]
        val r = smux_server_request_within(addr, token, "history-joined smux-bigreply 2000", 120000)
        if r.is_err():
            print("[evidence] direct reply error: " + r.unwrap_err())
        expect(r.is_ok()).to_be(true)
        expect(r.unwrap().len()).to_be_greater_than(400000)

        session_kill(ws)
        dir_remove_all(root)
