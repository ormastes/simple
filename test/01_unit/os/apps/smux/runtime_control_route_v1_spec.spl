# AUTHORED_UNRUN. Pure wire checks and actual denial guards, no native success.
use std.spec.{describe, it, expect, step}
use os.apps.smux.runtime_control_request_v1.*
use os.apps.smux.runtime_control_reply_v1.{smux_runtime_control_reply_v1, smux_runtime_control_reply_ok_v1}
use std.common.contracts.mux.session_runtime_control_v1.SessionRuntimeControlKindV1
use os.apps.smux.server.smux_server_dispatch
use app.hosted_apps.smux_client.smux_client_request_reply_ok
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.contract.{MuxSession, MuxWindow, MuxPane}
use os.apps.smux.pane_io_service.pane_send_state
use os.apps.smux.window_layout_service.layout_resize_capable
use os.apps.smux.client_attachment_service.{client_lease_snapshot, client_attach_leased, client_resize_leased}
use os.apps.smux.client_leases.{smux_leases_new, smux_lease_admit}
use std.sosix.process.PipedProcessRefV1

fn control_request_v1() -> SmuxRuntimeControlRequestV1:
    SmuxRuntimeControlRequestV1(action: "issue", binding_uid: "binding-a", control_kind: SessionRuntimeControlKindV1.Input,
        client_id: "client-a", attachment_token: "a".repeat(32) + ":1", expected_revision: 0,
        nonce: "", payload: "", columns: 0, rows: 0, expected_target_digest: "c".repeat(64))

describe "authenticated runtime control adapter prevention":
    it "round trips canonical requests and refuses caller authority fields":
        step("Reject caller supplied principal roots argv and lease metadata")
        val request = control_request_v1()
        val bytes = smux_runtime_control_request_encode_v1(request).unwrap()
        val token = smux_runtime_control_request_token_v1(request).unwrap()
        expect(smux_runtime_control_request_from_token_v1(token).unwrap().binding_uid).to_equal("binding-a")
        for extra in ["principalId: admin\n", "root: /tmp\n", "argv: []\n", "lease: {}\n"]:
            expect(smux_runtime_control_request_decode_v1(bytes + extra).is_err()).to_equal(true)
        for altered in [token + "=", " " + token, token + "\n", "a".repeat(2732)]:
            expect(smux_runtime_control_request_from_token_v1(altered).is_err()).to_equal(true)

    it "keeps input and geometry envelopes distinct and bounded":
        step("Reject cross-kind payloads overflow revisions and unsupported geometry")
        var request = control_request_v1()
        request.action = "input"
        request.expected_target_digest = ""
        request.client_id = ""
        request.attachment_token = ""
        request.expected_revision = 1
        request.nonce = "b".repeat(64)
        request.payload = "hello"
        expect(smux_runtime_control_request_encode_v1(request).is_ok()).to_equal(true)
        request.control_kind = SessionRuntimeControlKindV1.Geometry
        expect(smux_runtime_control_request_encode_v1(request).is_err()).to_equal(true)
        request.action = "resize"
        request.payload = ""
        request.columns = 513
        request.rows = 24
        expect(smux_runtime_control_request_encode_v1(request).is_err()).to_equal(true)
        request = control_request_v1()
        request.expected_revision = 9223372036854775807
        expect(smux_runtime_control_request_encode_v1(request).is_err()).to_equal(true)

    it "authenticates before decoding and cannot issue through an unconfigured server":
        step("Refuse forged authentication before any control request parsing")
        expect(smux_server_dispatch("wrong runtime-control-v1 malformed", "secret")).to_equal("smux: unauthorized")
        val token = smux_runtime_control_request_token_v1(control_request_v1()).unwrap()
        expect(smux_server_dispatch("secret runtime-control-v1 " + token, "secret")).to_equal("smux: runtime control policy unavailable")

    it "never treats a provider refusal as a successful input effect":
        step("Correlate refusal replies without promoting metadata to an effect")
        var request = control_request_v1()
        request.action = "input"
        request.expected_target_digest = ""
        request.client_id = ""
        request.attachment_token = ""
        request.nonce = "b".repeat(64)
        request.expected_revision = 1
        request.payload = "hello"
        expect(smux_runtime_control_reply_v1(request, "c".repeat(32), "unsupported", "container-runtime-control-port-unavailable", 1, nil, "").is_err()).to_equal(true)
        val reply = smux_runtime_control_reply_v1(request, "c".repeat(32), "rejected", "runtime-control-not-issued", 0, nil, "").unwrap()
        expect(smux_runtime_control_reply_ok_v1(request, reply)).to_equal(false)
        val command = "runtime-control-v1 " + smux_runtime_control_request_token_v1(request).unwrap()
        expect(smux_client_request_reply_ok(command, reply)).to_equal(false)
        expect(smux_client_request_reply_ok(command, reply.replace("false", "true"))).to_equal(false)

    it "preserves legacy effect guards even when a caller has attachment metadata":
        step("Keep bound terminal input and resize guards before native effects")
        var state = ServiceState.empty()
        state = state.add_session(MuxSession.create("s", "test"))
        state = state.add_window(MuxWindow.create("w", "s", "test"))
        var pane = PaneRecord.create(MuxPane.create("p", "w", "s"))
        # Deliberately invalid native metadata tests rejection BEFORE any IO.
        # This is not an adopted owner or a positive stream fixture.
        pane.terminal_ref = Some(PipedProcessRefV1(pid: 1, generation: 1))
        state = state.add_pane(pane)
        val denied = pane_send_state(state, false, "s", "w", "p", "unsafe")
        expect(denied.commit).to_equal(false)
        expect(denied.result.unwrap_err()).to_equal("terminal transport is read-only")
        expect(layout_resize_capable(state, [0], true)).to_equal(false)
        val leases = smux_lease_admit(smux_leases_new("a".repeat(32)).unwrap(), "s", "client-a", 100).unwrap()
        expect(client_lease_snapshot(state, leases.state, false, "s", "client-a", leases.lease.token, 101).is_err()).to_equal(true)
        val attached = client_attach_leased(state, smux_leases_new("b".repeat(32)).unwrap(), false,
            "s", "client-a", 80, 24, 100).unwrap()
        val resized = client_resize_leased(attached.state, attached.leases, false,
            "s", "client-a", attached.token, 81, 25, 101).unwrap()
        expect(resized.state.get_client(0).cols).to_equal(81)
        expect(resized.state.get_client(0).rows).to_equal(25)
        expect(resized.state.get_pane(0).pane.cols).to_equal(pane.pane.cols)
        expect(resized.state.get_pane(0).pane.rows).to_equal(pane.pane.rows)
        expect(layout_resize_capable(resized.state, [0], true)).to_equal(false)
