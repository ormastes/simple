"""
Pure interactive history reply byte budget. Production helper only; no network,
clipboard, native history capture or live terminal result is claimed.
# @manual: primary
Execution and docgen pending TEST_BLOCKED.
"""
use std.spec.{describe, it, expect, step}
use os.apps.smux.client_history_reply.{client_history_reply}
use std.common.text_bytes.{text_to_bytes, bytes_to_text}

describe "smux interactive history reply budget":
    it "should retain newest complete rows from dense two thousand row ASCII history":
        # @req REQ-SMUX-INTERACTIVE-005
        var rows: [text] = []
        var body = ""
        var col = 0
        while col < 75:
            body = body + "x"
            col = col + 1
        var index = 0
        while index < 2000:
            var number = index.to_text()
            while number.len() < 4:
                number = "0" + number
            rows.push(number + ":" + body)
            index = index + 1
        val prefix = "smux: client-history[work]:\n"
        step("Bound dense history without exceeding the 65536 byte wire body")
        val reply = client_history_reply(prefix, rows.join("\n"))
        expect(reply.is_ok()).to_equal(true)
        val shown = reply.unwrap()
        expect(text_to_bytes(shown).len()).to_be_less_than(65537)
        expect(shown).to_start_with(prefix)
        expect(shown).to_end_with(rows[1999])
        expect(shown.contains("\n0000:")).to_equal(false)
        expect(rows[0].len()).to_equal(80)
        expect(rows[1999].len()).to_equal(80)
        val retained = shown[prefix.len():].split("\n")
        expect(retained.len()).to_be_less_than(2000)
        val first = 2000 - retained.len()
        var row = 0
        while row < retained.len():
            expect(retained[row]).to_equal(rows[first + row])
            row = row + 1

    it "should count wide Unicode bytes from rows of different historical widths":
        # @req REQ-SMUX-INTERACTIVE-005
        var rows: [text] = []
        var row = 0
        while row < 2000:
            var line = row.to_text() + ":"
            var col = 0
            val width = if row < 1000: 80 else: 120
            while col < width:
                line = line + "界😀"
                col = col + 1
            rows.push(line)
            row = row + 1
        val prefix = "smux: client-history[界]:\n"
        step("Trim whole Unicode rows using encoded bytes rather than scalar or cell counts")
        val reply = client_history_reply(prefix, rows.join("\n"))
        expect(reply.is_ok()).to_equal(true)
        val shown = reply.unwrap()
        expect(text_to_bytes(shown).len()).to_be_less_than(65537)
        expect(shown).to_end_with(rows[1999])
        val retained = shown[prefix.len():].split("\n")
        val first = 2000 - retained.len()
        expect(first).to_be_greater_than(0)
        row = 0
        while row < retained.len():
            expect(retained[row]).to_equal(rows[first + row])
            expect(bytes_to_text(text_to_bytes(retained[row]))).to_equal(retained[row])
            row = row + 1

    it "should preserve all complete text including combining marks when it fits":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Keep a fitting cell text snapshot exactly")
        val prefix = "history:\n"
        val content = "old\n界e\u{301}😀\nnew"
        expect(client_history_reply(prefix, content).unwrap()).to_equal(prefix + content)

    it "should include header and newline bytes in the exact budget":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Accept an exact fit and discard only an older complete row")
        expect(client_history_reply("H\n", "old\n界", 5).unwrap()).to_equal("H\n界")
        expect(client_history_reply("H\n", "界", 5).unwrap()).to_equal("H\n界")
        expect(client_history_reply("H\n", "a\nb", 5).unwrap()).to_equal("H\na\nb")

    it "should refuse an oversized newest line rather than slice UTF-8":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Return a typed refusal when the newest complete line cannot fit")
        val reply = client_history_reply("H\n", "old\n界😀", 8)
        expect(reply.is_err()).to_equal(true)
        expect(reply.unwrap_err()).to_equal("newest client history line exceeds reply limit")
        expect(client_history_reply("H\n", "old\n界😀\n", 8).unwrap_err()).to_equal("newest client history line exceeds reply limit")

    it "should return an empty history header only when the prefix fits":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Validate an empty content response and invalid header budgets")
        expect(client_history_reply("H\n", "", 2).unwrap()).to_equal("H\n")
        expect(client_history_reply("", "", 0).unwrap()).to_equal("")
        expect(client_history_reply("H\n", "", 1).unwrap_err()).to_equal("client history prefix exceeds reply limit")
        expect(client_history_reply("", "", -1).is_err()).to_equal(true)

    it "should retain a trailing newline without adding unbudgeted separator bytes":
        # @req REQ-SMUX-INTERACTIVE-005
        step("Preserve a fitting terminal blank row and exact delimiters")
        expect(client_history_reply("H\n", "a\n", 4).unwrap()).to_equal("H\na\n")
        expect(client_history_reply("H\n", "old\na\n", 4).unwrap()).to_equal("H\na\n")

    it "should inspect no more than the newest two thousand candidate lines":
        # @req REQ-SMUX-INTERACTIVE-005
        var rows: [text] = []
        var row = 0
        while row < 2001:
            rows.push(row.to_text())
            row = row + 1
        step("Keep the caller's finite newest-row window even for oversized source inventories")
        val reply = client_history_reply("H\n", rows.join("\n")).unwrap()
        val retained = reply[2:].split("\n")
        expect(retained.len()).to_equal(2000)
        expect(retained[0]).to_equal("1")
        expect(retained[1999]).to_equal("2000")
