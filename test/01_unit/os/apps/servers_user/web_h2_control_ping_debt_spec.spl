use std.spec.*
use os.apps.servers_user.web_h2_control_owner_v1.{
    WebH2ControlOwnerV1, WebH2ControlSendKindV1
}
use std.http.h2.h2_frame.{
    H2Frame, H2SettingsFrame, H2PingFrame, H2_FLAG_ACK
}
use std.http.h2.h2_writer.{h2_write_frame}
use std.http.h2.h2_preface.{h2_connection_preface_bytes}

fn _ready_control_owner() -> WebH2ControlOwnerV1:
    var owner = WebH2ControlOwnerV1.create()
    val settings = h2_write_frame(H2Frame.Settings(H2SettingsFrame(
        flags: 0, settings: [])))
    val _ = owner.feed_authenticated_plaintext(
        h2_connection_preface_bytes() + settings, true)
    owner

fn _ping(flags: i64, opaque: [u8]) -> [u8]:
    h2_write_frame(H2Frame.Ping(H2PingFrame(
        flags: flags, opaque_data: opaque)))

describe "H2 control PING ACK debt":
    it "distinguishes ACK from request and makes no-debt preparation unavailable":
        var owner = _ready_control_owner()
        val ack = owner.prepare_settings_ack()
        expect(owner.commit_control(ack.token)).to_be(true)
        val _ = owner.feed_authenticated_plaintext(
            _ping(H2_FLAG_ACK, [1u8, 2u8, 3u8, 4u8, 5u8, 6u8, 7u8, 8u8]), true)
        expect(owner.ping_ack_debt_count()).to_equal(0i64)
        expect(owner.prepare_ping_ack().kind).to_equal(
            WebH2ControlSendKindV1.None)

    it "replays identical owner-held bytes after abort and commits once":
        var owner = _ready_control_owner()
        val settings_ack = owner.prepare_settings_ack()
        expect(owner.commit_control(settings_ack.token)).to_be(true)
        val opaque = [9u8, 8u8, 7u8, 6u8, 5u8, 4u8, 3u8, 2u8]
        val _ = owner.feed_authenticated_plaintext(_ping(0, opaque), true)
        expect(owner.ping_ack_debt_count()).to_equal(1i64)
        val first = owner.prepare_ping_ack()
        expect(owner.abort_control(first.token)).to_be(true)
        expect(owner.ping_ack_debt_count()).to_equal(1i64)
        val replay = owner.prepare_ping_ack()
        expect(replay.wire_bytes).to_equal(first.wire_bytes)
        expect(owner.commit_control(replay.token)).to_be(true)
        expect(owner.ping_ack_debt_count()).to_equal(0i64)
        expect(owner.commit_control(replay.token)).to_be(false)
        expect(owner.prepare_ping_ack().kind).to_equal(
            WebH2ControlSendKindV1.None)
