# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# @cover src/os/apps/servers_user/main.spl 80%
"""
# Filesystem-launched DBD provisioning and DBFS/VFS admission

The combined server payload is only a transport adapter. It must provision the
canonical DBD owner from owned boot files, destroy all source buffers, and
admit persistence only from a DBFS VFS capability that proves durable sync and
transactional namespace replacement.
"""

use std.spec.step

use std.spec
use std.io_runtime.{file_read}

describe "filesystem DBD boot secret ownership":
    # @manual scenario evidence
    it "calls the canonical provision_service and wipes every source buffer":
        # @req REQ-SSPEC-OS
        step("calls the canonical provision_service and wipes every source buffer")
        val source = file_read("src/os/apps/servers_user/main.spl")
        expect(source).to_contain("server.provision_service_from_boot_owner(")
        expect(source).to_contain("DbdBootCredentialOwnerV1.new")
        expect(source).to_contain("boot_owner.admit_source(credential)")
        expect(source).to_contain("DbdServer.new_filesystem_launched_v1()")
        expect(source).to_contain("read_file_bytes_direct_owned(DB_CREDENTIAL_PATH")
        expect(source).to_contain("read_file_bytes_direct_owned(DB_CERTIFICATE_PATH")
        expect(source).to_contain("read_file_bytes_direct_owned(DB_PRIVATE_KEY_PATH")
        expect(source).to_contain("secure_zero_u8_slots(credential)")
        expect(source).to_contain("secure_zero_u8_slots(cert)")
        expect(source).to_contain("secure_zero_u8_slots(key)")
        expect(source.contains("server.provision_service(\n")).to_equal(false)
        expect(source.contains("DbServerCapsule")).to_equal(false)
        expect(source.contains("--credential=")).to_equal(false)

describe "filesystem DBD DBFS VFS capability":
    it "accepts no caller readiness booleans and pins the mount-owner generation":
        # @req REQ-SSPEC-OS
        step("accepts no caller readiness booleans and pins the mount-owner generation")
        val adapter = file_read("src/os/apps/dbd/dbd_dbfs_adapter.spl")
        val server = file_read("src/os/apps/dbd/dbd.spl")
        val launch = file_read("src/os/apps/servers_user/main.spl")
        expect(adapter).to_contain("pub fn dbd_dbfs_adapter_from_filesystem_vfs()")
        expect(adapter).to_contain("dbfs_vfs_mount_capability_snapshot_current_v1")
        expect(adapter.contains("dbfs_root: bool")).to_equal(false)
        expect(adapter.contains("durable_sync: bool")).to_equal(false)
        expect(server).to_contain("pub me attach_filesystem_dbfs_vfs() -> bool:")
        expect(launch).to_contain("db_server.attach_filesystem_dbfs_vfs()")

    it "blocks the disconnected filesystem descriptor authority":
        # @req REQ-SSPEC-OS
        step("admits the complete least-authority capability without a driver copy")
        val adapter = file_read("src/os/apps/dbd/dbd_dbfs_adapter.spl")
        expect(adapter).to_contain(
            "filesystem-vfs-dbfs-operation-authority-unavailable")

    it "publishes readiness only from an actually mounted durable DBFS driver":
        # @req REQ-SSPEC-OS
        step("publishes readiness only from an actually mounted durable DBFS driver")
        val mount = file_read("src/os/services/vfs/vfs_init.spl")
        val owner = file_read("src/os/services/vfs/dbfs_mount_capability.spl")
        expect(mount).to_contain("case DbFs(dbfs):")
        expect(mount).to_contain("dbfs.durability_serialization_ready()")
        expect(mount).to_contain("dbfs_vfs_mount_capability_clear_v1()")
        expect(owner).to_contain("DbfsMountedRecoveryCompleteDurableTransactionalReplace")

    it "shares one contract type while keeping wire encode and decode separated":
        # @req REQ-SSPEC-OS
        step("shares one contract type while keeping wire encode and decode separated")
        val contract = file_read("src/lib/common/contracts/os/dbfs_vfs_mount_capability_v1.spl")
        val owner = file_read("src/os/services/vfs/dbfs_mount_capability.spl")
        val userlib = file_read("src/os/userlib/fs.spl")
        expect(contract).to_contain("pub enum DbfsVfsMountCapabilityV1")
        expect(owner).to_contain("pub use std.common.contracts.os.dbfs_vfs_mount_capability_v1")
        expect(owner).to_contain("dbfs_vfs_mount_capability_code_v1()")
        expect(userlib).to_contain("pub use std.common.contracts.os.dbfs_vfs_mount_capability_v1")
        expect(userlib).to_contain("match syscall(79, 0, 0, 0, 0, 0)")

describe "filesystem DBD authenticated durable transaction path":
    it "routes TLS AUTH and persistent write/read through the canonical owner":
        # @req REQ-SSPEC-OS
        step("routes TLS AUTH and persistent write/read through the canonical owner")
        val source = file_read("src/os/apps/servers_user/main.spl")
        val dbd = file_read("src/os/apps/dbd/dbd.spl")
        expect(source).to_contain("db_server.replay_log()")
        expect(source).to_contain("db_server.bind_listener")
        expect(source).to_contain("db_server.accept_and_handle_once()")
        expect(dbd).to_contain("self.dbfs_adapter.commit_and_sync(")
        expect(dbd).to_contain("return self.engine.dispatch(args)")
        expect(dbd).to_contain("self.engine.replay_journal(self.log_text)")

    it "binds only the configured address and port through portable sockaddr framing":
        val source = file_read("src/os/apps/servers_user/main.spl")
        val dbd = file_read("src/os/apps/dbd/dbd.spl")
        val net = file_read("src/os/userlib/net.spl")
        val portable = file_read("src/os/kernel/ipc/syscall_net_portable_v1.spl")
        val shim = file_read("src/os/kernel/abi/syscall_shim_net.spl")
        val raw = file_read("src/os/userlib/syscall_raw.spl")
        expect(source).to_contain("db_server.bind_listener()")
        expect(dbd).to_contain("pub me bind_listener() -> i64:")
        expect(dbd).to_contain("SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1")
        expect(dbd).to_contain("port: SIMPLEOS_SERVER_DATABASE_PORT_V1")
        expect(dbd).to_contain("val bound_socket = bind(listener, SockAddr(")
        expect(dbd.contains("extern fn rt_net_bind(")).to_equal(false)
        expect(net).to_contain("rt_simpleos_socket_bind_bytes(sock.fd as u64, encoded)")
        expect(net).to_contain("Encode a bounded POSIX sockaddr_in for syscalls 71 and 73")
        expect(portable).to_contain("CapabilityKind.NetBindIpv4(")
        expect(portable).to_contain("address: addr.addr, port: addr.port")
        expect(shim).to_contain("portable_net_capability_allowed_v1(")
        expect(shim).to_contain("g_shim_scheduler, g_shim_ipc")
        expect(shim).to_contain("portable_net_bind_args_checked_v1(")
        expect(portable).to_contain("portable_net_dispatch_bind_checked_v1(")
        expect(raw).to_contain("@cfg(x86_64)")
        expect(raw).to_contain("@cfg(arm64)")
        expect(raw).to_contain("@cfg(riscv64)")

    it "uses generation staging verified readback and whole-owner close":
        # @req REQ-SSPEC-OS
        step("uses exclusive staging namespace sync and whole-owner close")
        val source = file_read("src/os/apps/servers_user/main.spl")
        val dbd = file_read("src/os/apps/dbd/dbd.spl")
        val adapter = file_read("src/os/apps/dbd/dbd_dbfs_adapter.spl")
        expect(adapter).to_contain("self.generation.to_text()")
        expect(adapter).to_contain("DbdDbfsCommitReceiptV1")
        expect(adapter).to_contain("dbfs-commit-postflush-verify-failed")
        expect(adapter).to_contain("verify_read.unwrap() != bytes")
        expect(dbd).to_contain("pub me close_service() -> bool:")
        expect(dbd).to_contain("self.provisioning.close()")
        expect(source).to_contain("db_server.close_service()")
