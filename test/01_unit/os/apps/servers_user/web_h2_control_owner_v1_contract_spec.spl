use std.spec.*
use std.fs.{read_file}

describe "authenticated bounded H2 frame/control foundation":
    it "requires exact preface then non-ACK SETTINGS and rejects request frames":
        val source = read_file("src/os/apps/servers_user/web_h2_control_owner_v1.spl")
        expect(source).to_contain("AwaitingClientPreface")
        expect(source).to_contain("H2_CONNECTION_PREFACE_LEN")
        expect(source).to_contain("AwaitingClientSettings")
        expect(source).to_contain("first-client-frame-must-be-non-ack-settings")
        expect(source).to_contain("request_owner.admit_frame")
        expect(source).to_contain("request_events")
        expect(source).to_not_contain("DispatchRequest")
        expect(source).to_not_contain("queue_data")

    it "owns transactional SETTINGS and ACK records without a transport":
        val source = read_file("src/os/apps/servers_user/web_h2_control_owner_v1.spl")
        expect(source).to_contain("prepare_server_settings")
        expect(source).to_contain("prepare_settings_ack")
        expect(source).to_contain("prepare_ping_ack")
        expect(source).to_contain("ping_ack_debts")
        expect(source).to_contain("(ping.flags & H2_FLAG_ACK) == 0")
        expect(source).to_contain("ping-ack-debt-overflow")
        expect(source).to_contain("self.ping_ack_debts[0]")
        expect(source).to_contain("self.ping_ack_debts.slice(")
        expect(source).to_not_contain("prepare_ping_ack(opaque_data")
        expect(source).to_contain("commit_control")
        expect(source).to_contain("abort_control")
        expect(source).to_not_contain("TcpStream")
        expect(source).to_not_contain("ready_alpn_protocols")
        expect(source).to_not_contain("prepare_response")

    it "keeps retained ALPN metadata separate from traffic secrets":
        val source = read_file("src/os/apps/servers_user/web_tls_stream_owner.spl")
        expect(source).to_contain("negotiated_alpn_bytes")
        expect(source).to_contain("pub fn negotiated_alpn()")
        expect(source).to_not_contain("client_app_key:")
        expect(source).to_not_contain("server_app_key:")
