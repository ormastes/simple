use std.spec.*
use std.fs.{read_file}

describe "bounded receive-only H2 request owner contract":
    it "assembles one exact HEADERS and CONTINUATION sequence under a hard cap":
        val source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        expect(source).to_contain("continuation_stream_id")
        expect(source).to_contain("continuation-stream-mismatch")
        expect(source).to_contain("expected-exact-continuation")
        expect(source).to_contain("unexpected-continuation")
        expect(source).to_contain("WEB_H2_MAX_HEADER_BLOCK_V1")
        expect(source).to_contain("header-block-cap")

    it "bounds every HPACK-retained dimension including Huffman output":
        val source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        expect(source).to_contain("WEB_H2_MAX_DYNAMIC_TABLE_V1")
        expect(source).to_contain("WEB_H2_MAX_HEADER_LIST_V1")
        expect(source).to_contain("WEB_H2_MAX_HEADER_FIELDS_V1")
        expect(source).to_contain("WEB_H2_MAX_HEADER_STRING_V1")
        expect(source).to_contain("self.evict_to_limit()")
        expect(source).to_contain("late-dynamic-table-size-update")
        expect(source).to_contain("too-many-dynamic-table-size-updates")
        expect(source).to_contain("hpack_huffman_decode_bounded")

    it "admits only monotonically increasing odd client streams":
        val source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        expect(source).to_contain("headers.stream_id % 2 == 0")
        expect(source).to_contain("headers.stream_id <= self.last_client_stream_id")
        expect(source).to_contain("WEB_H2_MAX_ACTIVE_STREAMS_V1")
        expect(source).to_contain("data-on-inactive-stream")
        expect(source).to_contain("reset-on-inactive-stream")

    it "validates request pseudo-headers before issuing request events":
        val source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        expect(source).to_contain("pseudo-header-after-regular-header")
        expect(source).to_contain("duplicate-method-pseudo-header")
        expect(source).to_contain("invalid-request-pseudo-header")
        expect(source).to_contain("connection-specific-header")
        expect(source).to_contain("conflicting-content-length")
        expect(source).to_contain("receive-flow-control-exhausted")
        expect(source).to_contain("data-event-cap")
        expect(source).to_contain("content-length-mismatch")
        expect(source).to_contain("WebH2RequestEventKindV1.Headers")
        expect(source).to_contain("WebH2RequestEventKindV1.EndStream")

    it "does not claim response, transport, ALPN, socket, or websocket ownership":
        val source = read_file("src/os/apps/servers_user/web_h2_request_owner_v1.spl")
        expect(source).to_not_contain("prepare_response")
        expect(source).to_not_contain("ResponseHeaders")
        expect(source).to_not_contain("TcpStream")
        expect(source).to_not_contain("ready_alpn_protocols")
        expect(source).to_not_contain("WebSocket")
