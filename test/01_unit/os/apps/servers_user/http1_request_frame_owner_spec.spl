use std.spec.{describe, it, expect}
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use std.nogc_sync_mut.binary_io.{bytes_to_string}
use std.nogc_sync_mut.http_server.server.{
    SecureServerPolicy, request_parse_error_status
}
use std.nogc_sync_mut.http_server.types.{HttpStatus}
use os.apps.servers_user.http1_request_frame_owner.{
    frame_http1_fragments_owned_for_test,
    http1_no_progress_terminal_index_for_test
}
use os.apps.servers_user.main.{http_frame_rejection_wire}

extern fn rt_file_read_text(path: text) -> text

fn _one_byte_fragments(wire: text) -> [[u8]]:
    val bytes = text_to_bytes_pure(wire)
    var fragments: [[u8]] = []
    for byte in bytes:
        fragments.push([byte])
    fragments

fn _frame(wire: text):
    frame_http1_fragments_owned_for_test(
        _one_byte_fragments(wire), SecureServerPolicy.production())

fn _small_body_policy(max_body: i32) -> SecureServerPolicy:
    var policy = SecureServerPolicy.production()
    policy.max_body = max_body
    policy

describe "SimpleOS filesystem HTTP/1 incremental framing owner":
    it "accepts request headers and bodies fragmented at every byte boundary":
        val wire = "POST /health HTTP/1.1\r\nHost: simpleos\r\nContent-Length: 5\r\n\r\nhello"
        val result = _frame(wire)
        expect(result.complete).to_equal(true)
        expect(result.request).to_equal(wire)
        expect(result.scanned_bytes).to_equal(text_to_bytes_pure(wire).len() as i64)

    it "transfers coalesced WebSocket frame bytes without changing ordinary HTTP framing":
        val header = "GET /ws HTTP/1.1\r\nHost: simpleos\r\n" +
            "Upgrade: websocket\r\nConnection: Upgrade\r\n" +
            "Sec-WebSocket-Version: 13\r\n" +
            "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n"
        val tail: [u8] = [0x89u8, 0x80u8, 1u8, 2u8, 3u8, 4u8]
        var coalesced = text_to_bytes_pure(header)
        coalesced.extend(tail)
        val result = frame_http1_fragments_owned_for_test(
            [coalesced], SecureServerPolicy.production())
        expect(result.complete).to_equal(true)
        expect(result.websocket_upgrade_candidate).to_equal(true)
        expect(result.request).to_equal(header)
        expect(result.upgrade_tail).to_equal(tail)

    it "pins the production body cap and accepts an exact configured boundary without a rescan":
        expect(SecureServerPolicy.production().max_body).to_equal(10485760)
        val fixture_body_length: i32 = 64
        val header = text_to_bytes_pure(
            "POST /health HTTP/1.1\r\nHost: simpleos\r\nContent-Length: 64\r\n\r\n")
        val body: [u8] = [97u8; fixture_body_length]
        val result = frame_http1_fragments_owned_for_test(
            [header, body], _small_body_policy(fixture_body_length))
        expect(result.complete).to_equal(true)
        expect(result.scanned_bytes).to_equal(
            header.len() as i64 + fixture_body_length as i64)
        expect(result.request.len()).to_equal(
            header.len() as i64 + fixture_body_length as i64)
        expect(result.request).to_start_with("POST /health HTTP/1.1\r\n")
        expect(result.request).to_end_with("a")

    it "rejects ambiguous lengths transfer coding and trailing body bytes":
        expect(_frame("POST / HTTP/1.1\r\nContent-Length: 1\r\nContent-Length: 1\r\n\r\nx").error).to_contain("Duplicate Content-Length")
        expect(_frame("POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\nContent-Length: 1\r\n\r\nx").complete).to_equal(false)
        expect(_frame("POST / HTTP/1.1\r\nContent-Length: nope\r\n\r\n").error).to_contain("Invalid Content-Length")
        expect(_frame("POST / HTTP/1.1\r\nContent-Length: 1\r\n\r\nxy").error).to_contain("Bytes follow")

    it "rejects Expect immediately instead of waiting for a declared body":
        val result = _frame(
            "POST /health HTTP/1.1\r\nHost: simpleos\r\n" +
            "Content-Length: 5\r\neXpEcT: 100-continue\r\n")
        expect(result.complete).to_equal(false)
        expect(result.error).to_start_with("417 Expectation Failed")
        expect(request_parse_error_status(result.error)).to_equal(
            HttpStatus.ExpectationFailed)
        expect(result.scanned_bytes).to_equal(text_to_bytes_pure(
            "POST /health HTTP/1.1\r\nHost: simpleos\r\n" +
            "Content-Length: 5\r\neXpEcT: 100-continue\r\n").len() as i64)

        expect(_frame(
            "GET / HTTP/1.1\r\nHost: simpleos\r\nExpect: unsupported\r\n").error
        ).to_start_with("417 Expectation Failed")
        expect(_frame(
            "GET / HTTP/1.0\r\nExpect: 100-continue\r\n\r\n").complete
        ).to_equal(true)

        val wire = bytes_to_string(http_frame_rejection_wire(result.error, 4096u64))
        expect(wire).to_start_with("HTTP/1.1 417 Expectation Failed\r\n")
        expect(wire).to_contain("Connection: close\r\n")
        expect(wire).to_contain("Content-Length: 26\r\n")
        expect(wire).to_contain("Content-Security-Policy:")
        expect(wire).to_contain("X-Content-Type-Options: nosniff\r\n")
        expect(http_frame_rejection_wire(result.error, 1u64).len()).to_equal(0u64)

    it "requires exactly one non-empty Host field for HTTP/1.1 only":
        expect(_frame("GET / HTTP/1.1\r\n\r\n").error).to_contain(
            "requires one non-empty Host")
        expect(_frame("GET / HTTP/1.1\r\nHost:   \r\n\r\n").error).to_contain(
            "requires one non-empty Host")
        expect(_frame("GET / HTTP/1.1\r\nhOsT: simpleos\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.0\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\n\r\n").error).to_contain(
            "duplicate security header")

    it "accepts bounded deployment Host authorities":
        expect(_frame("GET / HTTP/1.1\r\nHost: simpleos.local\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: api-1.simpleos:8080\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: [2001:db8::1]:443\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: [::]\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: [::1]\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: [1:2:3:4:5:6:7:8]\r\n\r\n").complete).to_equal(true)
        expect(_frame("GET / HTTP/1.1\r\nHost: [::ffff:192.0.2.1]\r\n\r\n").complete).to_equal(true)

    it "rejects ambiguous or unsafe Host authorities before routing":
        expect(_frame("GET / HTTP/1.1\r\nHost: user@simpleos\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: simpleos/path\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: -edge.simpleos\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: simpleos:99999\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.0\r\nHost: 2001:db8::1\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [::::]\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [1:2:3:4:5:6:7:8:9]\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [12345::1]\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [1:::2]\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [1::2::3]\r\n\r\n").error).to_contain("Invalid Host authority")
        expect(_frame("GET / HTTP/1.1\r\nHost: [1::999.999.999.999]\r\n\r\n").error).to_contain("Invalid Host authority")

    it "rejects line boundary and field-name smuggling shapes":
        expect(_frame("\r\nHost: x\r\n\r\n").error).to_contain("Empty request line")
        expect(_frame("GET / HTTP/1.1\nHost: x\r\n\r\n").error).to_contain("Bare LF")
        expect(_frame("GET / HTTP/1.1\rX: y\r\n\r\n").error).to_contain("Embedded CR")
        expect(_frame("GET / HTTP/1.1\r\nBad Name: x\r\n\r\n").error).to_contain("Invalid header field name")
        expect(_frame("GET / HTTP/1.1\r\nHost : x\r\n\r\n").error).to_contain("Invalid header field name")
        val control = frame_http1_fragments_owned_for_test([
            text_to_bytes_pure("GET / HTTP/1.1\r\nX-Test: a"),
            [1u8],
            text_to_bytes_pure("b\r\n\r\n")
        ], SecureServerPolicy.production())
        expect(control.error).to_contain("Control byte")

    it "accepts only RFC token bytes in the HTTP method":
        expect(_frame("M-SEARCH / HTTP/1.1\r\nHost: simpleos\r\n\r\n").complete
        ).to_equal(true)
        expect(_frame(" / HTTP/1.1\r\nHost: simpleos\r\n\r\n").error
        ).to_contain("Invalid HTTP method token")
        expect(_frame("GE(T / HTTP/1.1\r\nHost: simpleos\r\n\r\n").error
        ).to_contain("Invalid HTTP method token")
        val control_method = frame_http1_fragments_owned_for_test([
            [71u8, 69u8, 1u8, 84u8] +
                text_to_bytes_pure(" / HTTP/1.1\r\nHost: simpleos\r\n\r\n")
        ], SecureServerPolicy.production())
        expect(control_method.error).to_contain("Invalid HTTP method token")

    it "admits field-content bytes and rejects forbidden controls before parsing":
        val tab_value = _frame(
            "GET / HTTP/1.1\r\nHost: simpleos\r\nX-Mode:\tfast\r\n\r\n")
        expect(tab_value.complete).to_equal(true)
        val obs_text = frame_http1_fragments_owned_for_test([
            text_to_bytes_pure("GET / HTTP/1.1\r\nHost: simpleos\r\nX-Byte: ") +
                [0x80u8, 0xFFu8] + text_to_bytes_pure("\r\n\r\n")
        ], SecureServerPolicy.production())
        expect(obs_text.complete).to_equal(true)
        val nul_value = frame_http1_fragments_owned_for_test([
            text_to_bytes_pure("GET / HTTP/1.1\r\nHost: simpleos\r\nX-Byte: a") +
                [0u8] + text_to_bytes_pure("b\r\n\r\n")
        ], SecureServerPolicy.production())
        expect(nul_value.error).to_contain("Invalid header field value")
        val delete_value = frame_http1_fragments_owned_for_test([
            text_to_bytes_pure("GET / HTTP/1.1\r\nHost: simpleos\r\nX-Byte: a") +
                [0x7Fu8] + text_to_bytes_pure("b\r\n\r\n")
        ], SecureServerPolicy.production())
        expect(delete_value.error).to_contain("Invalid header field value")

    it "enforces fragmented line count body and version boundaries":
        expect(_frame("POST / HTTP/1.1\r\nContent-Length: 10485761\r\n\r\n").error).to_contain("413")
        expect(_frame("POST / HTTP/1.1\r\nContent-Length: 2\r\n\r\nx").error).to_contain("Incomplete")
        expect(_frame("GET / HTTP/2\r\n\r\n").error).to_contain("Unsupported HTTP version")
        expect(_frame("GET / HTTP/1.1\r\n folded: value\r\n\r\n").error).to_contain("folded")

        var too_many: [[u8]] = [text_to_bytes_pure("GET / HTTP/1.1\r\n")]
        var header_index = 0
        while header_index < 101:
            too_many.push(text_to_bytes_pure("X-{header_index}: value\r\n"))
            header_index = header_index + 1
        too_many.push(text_to_bytes_pure("\r\n"))
        val count_result = frame_http1_fragments_owned_for_test(
            too_many, SecureServerPolicy.production())
        expect(count_result.error).to_contain("Too many headers")

        val oversized_request_line: [u8] = [65u8; 8193]
        val line_result = frame_http1_fragments_owned_for_test(
            [oversized_request_line], SecureServerPolicy.production())
        expect(line_result.error).to_contain("line exceeds policy")

        val oversized_header_line: [u8] = [65u8; 8193]
        val header_result = frame_http1_fragments_owned_for_test([
            text_to_bytes_pure("GET / HTTP/1.1\r\n"), oversized_header_line
        ], SecureServerPolicy.production())
        expect(header_result.error).to_contain("line exceeds policy")

    it "counts only consecutive no-progress receives and resets after progress":
        expect(http1_no_progress_terminal_index_for_test(
            [false, false, true, false, false, false], 3)).to_equal(5)
        expect(http1_no_progress_terminal_index_for_test(
            [false, false, true, false, false], 3)).to_equal(-1)
        expect(http1_no_progress_terminal_index_for_test(
            [true, true, true], 3)).to_equal(-1)

    it "keeps resume state private and the handler connection-close lifecycle intact":
        val owner_source = rt_file_read_text(
            "src/os/apps/servers_user/http1_request_frame_owner.spl") ?? ""
        val handler_source = rt_file_read_text(
            "src/os/apps/servers_user/main.spl") ?? ""
        expect(owner_source.contains("class Http1RequestFrameOwner:")).to_equal(true)
        expect(owner_source.contains("pub class Http1RequestFrameOwner")).to_equal(false)
        expect(owner_source.contains("export Http1RequestFrameOwner")).to_equal(false)
        expect(owner_source.contains("resume_offset")).to_equal(false)
        expect(owner_source.contains("retained.slice(0")).to_equal(false)
        expect(owner_source).to_contain("self.retained.extend(fragment)")
        expect(owner_source).to_contain("maximum_retained: i64")
        expect(handler_source).to_contain("recv_http1_request_owned(client, policy)")
        expect(handler_source).to_contain("close_fd(client.fd)")
