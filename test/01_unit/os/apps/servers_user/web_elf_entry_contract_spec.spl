use std.spec
use std.io_runtime.{file_read}

describe "dedicated WEB ELF TLS ownership boundary":
    it "consumes WEB admission before exact authority reads and bind":
        val source = file_read("src/os/apps/web_user/main.spl")
        val admission = source.index_of("web_startup_admission_consume_v1()")
        val asset = source.index_of("SIMPLEOS_WEB_STATIC_FILE_V1,")
        val certificate = source.index_of("SIMPLEOS_WEB_TLS_CERTIFICATE_V1")
        val key = source.index_of("SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1")
        val bind = source.index_of("_web_bind_exact_v1(", asset)
        expect(admission).to_be_greater_than(-1)
        expect(admission).to_be_less_than(asset)
        expect(asset).to_be_less_than(bind)
        expect(certificate).to_be_greater_than(-1)
        expect(key).to_be_greater_than(-1)
        expect(source).to_contain("projected.bind_ipv4_address, projected.port")

    it "uses Pure TLS13 and transfers context once without protocol overclaim":
        val entry = file_read("src/os/apps/web_user/main.spl")
        val transport = file_read(
            "src/os/apps/web_user/web_tls_transport_v1.spl")
        val provisioning = file_read(
            "src/os/apps/web_user/web_tls_provisioning_v1.spl")
        expect(transport).to_contain("tls13_accept(client.fd.to_i64(), config)")
        expect(transport.split("WebTlsStreamOwnerV1.from_context(context)").len()).to_equal(2)
        expect(provisioning).to_contain(
            "alpn_protocols: [h2, h1], ready_alpn_protocols: [h2, h1]")
        expect(provisioning).to_contain("require_alpn: true")
        expect(provisioning.index_of("\"h3\"")).to_equal(-1)
        expect(entry.index_of("rt_tls_server_")).to_equal(-1)
        expect(entry.index_of("plaintext_development_capability")).to_equal(-1)
        expect(entry.index_of("ready=ok")).to_equal(-1)

    it "routes only authenticated bytes and quarantines before descriptor close":
        val source = file_read("src/os/apps/web_user/main.spl")
        expect(source).to_contain("if tls_stream.is_http2():")
        expect(source).to_contain("elif tls_stream.is_http1():")
        expect(source).to_contain("web_tls_http1_handle_v1(")
        expect(source).to_contain("tls_stream.transport_eof()")
        expect(source).to_contain("_web_close_fd_v1(client.fd)")
        expect(source).to_contain("provisioning.quarantine()")

    it "keeps the listener and provisioning alive across accepted peers":
        val source = file_read("src/os/apps/web_user/main.spl")
        val serve_fn = source.index_of("fn _web_serve_listener_v1(")
        val accept_loop = source.index_of("while true:", serve_fn)
        val accepted_peer = source.index_of("case Ok(client):", accept_loop)
        val terminal_error = source.index_of("case Err(_): return 4", accept_loop)
        val listener_close = source.index_of(
            "_web_close_fd_v1(owned_listener.fd)")
        val provisioning_close = source.index_of("provisioning.close()")
        expect(serve_fn).to_be_greater_than(-1)
        expect(accept_loop).to_be_greater_than(serve_fn)
        expect(accepted_peer).to_be_greater_than(accept_loop)
        expect(terminal_error).to_be_greater_than(accept_loop)
        expect(listener_close).to_be_greater_than(accepted_peer)
        expect(provisioning_close).to_be_greater_than(listener_close)

    it "uses bounded TLS reads and transactional record sends for H1 and WS":
        val source = file_read(
            "src/os/apps/web_user/web_tls_http1_v1.spl")
        expect(source).to_contain("WEB_TLS_HTTP_MAX_RECORD_READS_V1")
        expect(source).to_contain("WEB_TLS_WS_MAX_RECORD_READS_V1")
        expect(source).to_contain("stream.ingest(wire)")
        expect(source).to_contain("authenticated_frames_dispatchable")
        expect(source).to_contain("stream.prepare_next()")
        expect(source).to_contain("stream.commit_send(prepared.token)")
        expect(source).to_contain("stream.abort_send(prepared.token")
        expect(source).to_contain("validate_rfc6455_server_handshake")
        expect(source).to_contain("Rfc6455ServerConnectionOwner.create()")
        expect(source.index_of("socket_send(socket")).to_equal(-1)

    it "flushes append results before terminal checks and sends budget close":
        val source = file_read(
            "src/os/apps/web_user/web_tls_http1_v1.spl")
        val initial_append = source.index_of(
            "val events = protocol.append_tail(initial)")
        val initial_send = source.index_of(
            "_web_tls_send_ws_events_v1(socket, stream, events)", initial_append)
        val terminal_loop = source.index_of(
            "while reads < WEB_TLS_WS_MAX_RECORD_READS_V1", initial_append)
        expect(initial_append).to_be_less_than(initial_send)
        expect(initial_send).to_be_less_than(terminal_loop)
        val frame_append = source.index_of(
            "val appended = protocol.append_tail(frame)")
        val frame_send = source.index_of(
            "_web_tls_send_ws_events_v1(", frame_append)
        expect(frame_append).to_be_less_than(frame_send)
        expect(source).to_contain("protocol.close_for_policy()")
        expect(source).to_contain("Going Away (1001) before TLS close")

    it "reserves HTTP head bytes inside the TLS plaintext response bound":
        val entry = file_read("src/os/apps/web_user/main.spl")
        val source = file_read(
            "src/os/apps/web_user/web_tls_http1_v1.spl")
        expect(source).to_contain(
            "WEB_TLS_HTTP_HEAD_ALLOWANCE_V1: i64 = 1024")
        expect(source).to_contain(
            "WEB_TLS_HTTP_MAX_STATIC_ASSET_V1: u64 = 64512u64")
        expect(source).to_contain(
            "wire.len().to_i64() > WEB_TLS_HTTP_HEAD_ALLOWANCE_V1 +")
        expect(entry).to_contain(
            "WEB_TLS_HTTP_MAX_STATIC_ASSET_V1 + 1u64")
        expect(entry).to_contain(
            "static_asset.len() > WEB_TLS_HTTP_MAX_STATIC_ASSET_V1")

    it "answers H1 and WS peer close with one transactional reciprocal close":
        val source = file_read(
            "src/os/apps/web_user/web_tls_http1_v1.spl")
        expect(source.split("if ingress.reciprocal_close_required:").len()).to_equal(3)
        expect(source.split(
            "return _web_tls_send_reciprocal_close_v1(socket, stream)").len()).to_equal(3)
        val helper = source.split(
            "fn _web_tls_send_reciprocal_close_v1")[1].split(
                "fn _web_tls_send_ws_events_v1")[0]
        expect(helper.index_of("request_local_close()")).to_equal(-1)
        expect(helper.split("stream.prepare_next()").len()).to_equal(2)
        expect(helper.split("stream.commit_send(prepared.token)").len()).to_equal(2)
        expect(helper).to_contain("stream.abort_send(prepared.token")
        val first_peer = source.index_of("if ingress.reciprocal_close_required:")
        val first_zero = source.index_of(
            "ingress.ingress.zeroize_plaintext_frames()", first_peer)
        val first_send = source.index_of(
            "return _web_tls_send_reciprocal_close_v1", first_peer)
        val first_dispatch = source.index_of(
            "if not ingress.authenticated_frames_dispatchable:", first_peer)
        expect(first_peer).to_be_less_than(first_zero)
        expect(first_zero).to_be_less_than(first_send)
        expect(first_send).to_be_less_than(first_dispatch)

    it "retires the handshake context once before either handoff branch":
        val source = file_read(
            "src/os/apps/web_user/web_tls_transport_v1.spl")
        val copy = source.index_of(
            "val stream_result = WebTlsStreamOwnerV1.from_context(context)")
        val wipe = source.index_of(
            "val wipe = tls13_server_context_wipe_v1(context)")
        val branch = source.index_of("match stream_result:")
        expect(copy).to_be_greater_than(-1)
        expect(copy).to_be_less_than(wipe)
        expect(wipe).to_be_less_than(branch)
        expect(source.split(
            "tls13_server_context_wipe_v1(context)").len()).to_equal(2)
        expect(source).to_contain("tls-context-zeroization-failed")
        expect(source).to_contain("quarantined.transport_eof()")
