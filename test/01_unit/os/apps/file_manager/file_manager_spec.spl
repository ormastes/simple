describe "FileEntry":
    it "constructs with name and size":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): name and size round-trip of a file entry
        step("Construct a 1024-byte readme entry and read it back")
        val entry = FileEntry(
            name: "readme.txt",
            kind: FsNodeKind.File,
            size: 1024,
            modified_ns: 0,
            permissions: 0o644
        )
        expect(entry.name).to_equal("readme.txt")  # oracle: constructor stores the name verbatim
        expect(entry.size).to_equal(1024)  # oracle: constructor stores the requested 1024-byte size verbatim

    it "constructs directory entry":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): name and kind of a directory entry
        step("Construct a src directory entry and read it back")
        val entry = FileEntry(
            name: "src",
            kind: FsNodeKind.Directory,
            size: 4096,
            modified_ns: 0,
            permissions: 0o755
        )
        expect(entry.name).to_equal("src")  # oracle: constructor stores the directory name verbatim
        expect(entry.kind).to_equal(FsNodeKind.Directory)  # oracle: constructor stores the requested Directory kind

