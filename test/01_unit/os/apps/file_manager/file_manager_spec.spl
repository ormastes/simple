describe "FileManager show_hidden toggle":
    it "toggle_hidden flips from false to true":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): show-hidden flag after one toggle from the default
        step("Toggle hidden files on from the default state")
        var fm = FileManager.new("/")
        fm.toggle_hidden()
        expect(fm.show_hidden).to_equal(true)  # oracle: one toggle from the default reveals hidden files

    it "toggle_hidden flips from true to false":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): show-hidden flag after one toggle from revealed
        step("Toggle hidden files off from the revealed state")
        var fm = FileManager.new("/")
        fm.show_hidden = true
        fm.toggle_hidden()
        expect(fm.show_hidden).to_equal(false)  # oracle: one toggle from revealed suppresses hidden files again

