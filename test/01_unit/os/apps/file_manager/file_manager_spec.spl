# ============================================================================
# Mock Filesystem
# ============================================================================

class FileManagerOpenStatFs:
    """Mock filesystem with configurable stat results for open_selected tests."""
    stat_kind: FsNodeKind
    last_stat_path: text

impl FileManagerOpenStatFs:
    static fn new(stat_kind: FsNodeKind) -> FileManagerOpenStatFs:
        FileManagerOpenStatFs(stat_kind: stat_kind, last_stat_path: "")

impl Filesystem for FileManagerOpenStatFs:
    fn fs_name() -> text: "file-manager-open-stat"

    me mount(device: text, options: text) -> Result<bool, text>:
        Result.Ok(true)

    me unmount() -> Result<bool, text>:
        Result.Ok(true)

    me open(path: text, flags: FileFlags) -> Result<u64, text>:
        Result.Ok(0)

    me read(handle: u64, size: u64) -> Result<[u8], text>:
        Result.Ok([])

    me write(handle: u64, data: [u8]) -> Result<u64, text>:
        Result.Ok(0)

    me close(handle: u64) -> Result<bool, text>:
        Result.Ok(true)

    me seek(handle: u64, offset: i64, whence: SeekWhence) -> Result<u64, text>:
        Result.Ok(0)

    fn stat(path: text) -> Result<FsNode, text>:
        self.last_stat_path = path
        Result.Ok(FsNode(
            id: 1,
            kind: self.stat_kind,
            size: 0,
            permissions: 0o755,
            owner: 0,
            group: 0,
            created_ns: 0,
            modified_ns: 0
        ))

    fn chmod(path: text, mode: u16) -> Result<bool, text>:
        Result.Ok(true)

    me mkdir(path: text) -> Result<bool, text>:
        Result.Ok(true)

    me rmdir(path: text) -> Result<bool, text>:
        Result.Ok(true)

    fn readdir(path: text) -> Result<[DirEntry], text>:
        Result.Ok([])

    me unlink(path: text) -> Result<bool, text>:
        Result.Ok(true)

    me rename(old_path: text, new_path: text) -> Result<bool, text>:
        Result.Ok(true)

    me symlink(target: text, link_path: text) -> Result<bool, text>:
        Result.Ok(true)

