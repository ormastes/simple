describe "FileManager":
    context "when newly created":
        it "starts at given path":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): starting path of a fresh file manager
            step("Create a manager rooted at /home and read its path")
            val fm = FileManager.new("/home")
            expect(fm.current_path).to_equal("/home")  # oracle: constructor stores the requested start path verbatim

        it "starts with empty entries":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): entry count of a fresh file manager
            step("Create a manager and count its listed entries")
            val fm = FileManager.new("/")
            expect(fm.entries.len()).to_equal(0)  # oracle: a fresh manager lists nothing until it reads a directory

        it "starts with selected_index at 0":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): selection index of a fresh file manager
            step("Create a manager and read the selection index")
            val fm = FileManager.new("/")
            expect(fm.selected_index).to_equal(0)  # oracle: a fresh manager selects the first row

        it "starts with show_hidden false":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): show-hidden flag of a fresh file manager
            step("Create a manager and read the show-hidden flag")
            val fm = FileManager.new("/")
            expect(fm.show_hidden).to_equal(false)  # oracle: hidden files start suppressed

        it "starts with sort_by Name":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default sort column of a fresh file manager
            step("Create a manager and read the sort column")
            val fm = FileManager.new("/")
            expect(fm.sort_by).to_equal(SortField.Name)  # oracle: the product default sort column is Name

        it "starts with sort_dir Ascending":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): default sort direction of a fresh file manager
            step("Create a manager and read the sort direction")
            val fm = FileManager.new("/")
            expect(fm.sort_dir).to_equal(SortDirection.Ascending)  # oracle: the product default direction is Ascending

        it "starts with dir_tree_paths containing root":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): directory-tree breadcrumb of a fresh manager
            step("Create a manager and read its directory-tree breadcrumb")
            val fm = FileManager.new("/")
            expect(fm.dir_tree_paths.len()).to_equal(1)  # oracle: the tree holds only the starting directory
            expect(fm.dir_tree_paths[0]).to_equal("/")  # oracle: that single breadcrumb is the root

        it "starts with empty clipboard_path":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): clipboard path of a fresh file manager
            step("Create a manager and read the clipboard path")
            val fm = FileManager.new("/")
            expect(fm.clipboard_path).to_equal("")  # oracle: nothing has been cut or copied yet

        it "starts with empty clipboard_op":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): clipboard operation of a fresh file manager
            step("Create a manager and read the clipboard operation")
            val fm = FileManager.new("/")
            expect(fm.clipboard_op).to_equal("")  # oracle: no clipboard operation is pending

        it "starts with nil vfs":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): vfs handle of a fresh file manager
            step("Create a manager and read its vfs handle")
            val fm = FileManager.new("/")
            expect(fm.vfs).to_be_nil  # oracle: a fresh manager is not mounted to any filesystem yet

    context "with different paths":
        it "respects /home/user path":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): starting path of a nested manager
            step("Create a manager rooted at /home/user and read its path")
            val fm = FileManager.new("/home/user")
            expect(fm.current_path).to_equal("/home/user")  # oracle: constructor stores the nested start path verbatim

        it "respects root path":
            # @req REQ-SSPEC-LOCAL-001
            # @capture(statistics): starting path of a root manager
            step("Create a manager rooted at / and read its path")
            val fm = FileManager.new("/")
            expect(fm.current_path).to_equal("/")  # oracle: constructor stores the root start path verbatim

# ============================================================================
# Sorting
# ============================================================================

describe "FileManager sorting":
    it "_compare_entries sorts by name ascending":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): comparator verdict for alpha vs beta by name, ascending
        step("Compare alpha against beta by name in ascending order")
        val a = FileEntry(name: "alpha", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "beta", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Ascending)
        expect(result).to_be_less_than(0)  # oracle: ascending name order puts alpha before beta

    it "_compare_entries sorts by name descending":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): comparator verdict for alpha vs beta by name, descending
        step("Compare alpha against beta by name in descending order")
        val a = FileEntry(name: "alpha", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "beta", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Descending)
        expect(result).to_be_greater_than(0)  # oracle: descending name order puts beta before alpha

    it "_compare_entries sorts by size":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): comparator verdict for a 100-byte vs a 9999-byte entry
        step("Compare a small entry against a big one by size")
        val a = FileEntry(name: "small", kind: FsNodeKind.File, size: 100, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "big", kind: FsNodeKind.File, size: 9999, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Size, SortDirection.Ascending)
        expect(result).to_be_less_than(0)  # oracle: ascending size order puts the 100-byte entry first

    it "_compare_entries sorts by date":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): comparator verdict for an old vs a new entry by modification time
        step("Compare an older entry against a newer one by date")
        val a = FileEntry(name: "old", kind: FsNodeKind.File, size: 0, modified_ns: 100, permissions: 0)
        val b = FileEntry(name: "new", kind: FsNodeKind.File, size: 0, modified_ns: 9999, permissions: 0)
        val result = _compare_entries(a, b, SortField.Date, SortDirection.Ascending)
        expect(result).to_be_less_than(0)  # oracle: ascending date order puts the older entry first

    it "_sort_file_entries sorts list by name":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): full ordering of three entries after an ascending name sort
        step("Sort three misordered entries by name ascending")
        val entries = [
            FileEntry(name: "c.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "a.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b.txt", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        val sorted = _sort_file_entries(entries, SortField.Name, SortDirection.Ascending)
        expect(sorted[0].name).to_equal("a.txt")  # oracle: ascending name order ranks a.txt first
        expect(sorted[1].name).to_equal("b.txt")  # oracle: ascending name order ranks b.txt second
        expect(sorted[2].name).to_equal("c.txt")  # oracle: ascending name order ranks c.txt last

    it "_compare_entries returns 0 for equal names":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): comparator verdict for two identically named entries
        step("Compare two entries that share the same name")
        val a = FileEntry(name: "same", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val b = FileEntry(name: "same", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        val result = _compare_entries(a, b, SortField.Name, SortDirection.Ascending)
        expect(result).to_equal(0)  # oracle: identically named entries must compare equal

# ============================================================================
# Navigation
# ============================================================================

describe "FileManager navigation":
    it "navigate_to changes current_path":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): current path after navigate_to
        step("Navigate to /home and read the current path")
        var fm = FileManager.new("/")
        fm.navigate_to("/home")
        expect(fm.current_path).to_equal("/home")  # oracle: navigate_to must move the manager to the requested directory

    it "navigate_to resets selected_index":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): selection index after navigate_to
        step("Select row 5 then navigate to a new directory")
        var fm = FileManager.new("/")
        fm.selected_index = 5
        fm.navigate_to("/home")
        expect(fm.selected_index).to_equal(0)  # oracle: entering a new directory restarts the selection at the first row

    it "navigate_up goes to parent directory":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): current path after navigate_up from a nested directory
        step("Navigate up from /home/user")
        var fm = FileManager.new("/home/user")
        fm.navigate_up()
        expect(fm.current_path).to_equal("/home")  # oracle: navigate_up lands on the parent directory

    it "navigate_up from root stays at root":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): current path after navigate_up at the filesystem root
        step("Navigate up while already at the root directory")
        var fm = FileManager.new("/")
        fm.navigate_up()
        expect(fm.current_path).to_equal("/")  # oracle: navigating up from the root must stay at the root

    it "open_selected resolves parent entries in-place":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): current path after opening a .. entry
        step("Open the parent-directory entry in the listing")
        var fm = FileManager.new("/home/user")
        fm.entries = [
            FileEntry(name: "..", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.open_selected()
        expect(fm.current_path).to_equal("/home")  # oracle: opening .. must move to the parent without launching anything

    it "open_selected navigates when stat resolves a non-directory entry to a directory":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): current path and stat target after opening a stat-resolved directory
        step("Open a symlink entry whose stat resolves to a directory")
        var vfs = VfsManager.new()
        val fs = FileManagerOpenStatFs.new(FsNodeKind.Directory)
        val mounted = vfs.mount(path: "/", fs_type: "mock", device: "", read_only: false, fs: fs)
        expect(mounted.is_ok()).to_equal(true)  # oracle: the mock mount must succeed for the scenario to be valid
        var fm = FileManager.with_vfs("/home", vfs)
        fm.entries = [
            FileEntry(name: "docs", kind: FsNodeKind.Symlink, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.open_selected()
        expect(fm.current_path).to_equal("/home/docs")  # oracle: a symlink stat-resolving to a directory is entered in place
        expect(fs.last_stat_path).to_equal("/home/docs")  # oracle: the product must have stat-ed exactly the resolved path

# ============================================================================
# Selection
# ============================================================================

describe "FileManager selection":
    it "select_next increments selected_index":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): selection index after one select_next
        step("Move the selection down one row in a two-row listing")
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.select_next()
        expect(fm.selected_index).to_equal(1)  # oracle: one downward move lands on row 1

    it "select_next does not exceed entries length":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): selection index after select_next at the last row
        step("Move the selection down at the bottom of a one-row listing")
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.selected_index = 0
        fm.select_next()
        expect(fm.selected_index).to_equal(0)  # oracle: the bottom edge clamps the selection at the last row

    it "select_prev decrements selected_index":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): selection index after one select_prev
        step("Move the selection up one row from row 1")
        var fm = FileManager.new("/")
        fm.entries = [
            FileEntry(name: "a", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0),
            FileEntry(name: "b", kind: FsNodeKind.File, size: 0, modified_ns: 0, permissions: 0)
        ]
        fm.selected_index = 1
        fm.select_prev()
        expect(fm.selected_index).to_equal(0)  # oracle: one upward move lands on row 0

    it "select_prev does not go below 0":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): selection index after select_prev at the top row
        step("Move the selection up at the top of the listing")
        var fm = FileManager.new("/")
        fm.selected_index = 0
        fm.select_prev()
        expect(fm.selected_index).to_equal(0)  # oracle: the top edge clamps the selection at row 0

