describe "SortField":
    # @manual scenario evidence
    """
    # File Manager Unit Tests
    Tests for FileManager: construction, sorting, navigation, and
    show_hidden toggle.

    This describe block exercises the SortField enum used by the file
    manager column-sort selector, routed through the product set_sort.
    """
    it "has Name variant":
        """SortField.Name is the constructor default sort field."""
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): default sort field of a fresh file manager
        step("Read the sort field a fresh file manager starts with")
        val fm = FileManager.new("/")
        expect(fm.sort_by).to_equal(SortField.Name)  # oracle: the product default sort column is Name

    it "has Size variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): sort field after selecting Size
        step("Select the Size sort column and read it back")
        val fm = FileManager.new("/")
        fm.set_sort(SortField.Size)
        expect(fm.sort_by).to_equal(SortField.Size)  # oracle: set_sort must store the selected Size column

    it "has Date variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of the Date column from Name
        step("Distinguish the Date sort column from the Name column")
        expect(SortField.Date == SortField.Name).to_equal(false)  # oracle: distinct sort columns must never compare equal

describe "SortDirection":
    it "has Ascending variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): default sort direction of a fresh file manager
        step("Read the sort direction a fresh file manager starts with")
        val fm = FileManager.new("/")
        expect(fm.sort_dir).to_equal(SortDirection.Ascending)  # oracle: the product default direction is Ascending

    it "has Descending variant":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): distinctness of Descending from Ascending
        step("Distinguish the Descending direction from Ascending")
        expect(SortDirection.Descending == SortDirection.Ascending).to_equal(false)  # oracle: distinct directions must never compare equal

# ============================================================================
# FileEntry Construction
