describe "FileManager format helpers":
    it "format_size returns bytes for small sizes":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): formatted label for a 512-byte file
        step("Format a 512-byte size")
        val result = format_size(512)
        expect(result).to_contain("B")  # oracle: sub-kilobyte sizes are labelled in plain bytes

    it "format_size returns KB for kilobyte sizes":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): formatted label for a 2048-byte file
        step("Format a 2048-byte size")
        val result = format_size(2048)
        expect(result).to_contain("KB")  # oracle: two-kilobyte sizes are labelled in KB

    it "format_size returns MB for megabyte sizes":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): formatted label for a 2 MiB file
        step("Format a 2097152-byte size")
        val result = format_size(2097152)
        expect(result).to_contain("MB")  # oracle: two-megabyte sizes are labelled in MB

    it "format_kind returns File for file":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): formatted kind label for a regular file
        step("Format the kind of a regular file")
        val result = format_kind(FsNodeKind.File)
        expect(result).to_equal("File")  # oracle: regular files are labelled File

    it "format_kind returns Dir for directory":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): formatted kind label for a directory
        step("Format the kind of a directory")
        val result = format_kind(FsNodeKind.Directory)
        expect(result).to_equal("Dir")  # oracle: directories are labelled Dir

    it "kind_icon returns folder for directory":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): icon label for a directory
        step("Read the icon the product draws for a directory")
        val result = kind_icon(FsNodeKind.Directory)
        expect(result).to_equal("folder")  # oracle: directories render the folder icon

describe "FileManager open path helpers":
    it "_resolve_open_path keeps current directory for dot entries":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): resolved path for a . entry
        step("Resolve a dot entry from /home/user")
        expect(_resolve_open_path("/home/user", ".")).to_equal("/home/user")  # oracle: opening . stays in the current directory

    it "_resolve_open_path resolves parent for dot-dot entries":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): resolved path for a .. entry
        step("Resolve a dot-dot entry from /home/user")
        expect(_resolve_open_path("/home/user", "..")).to_equal("/home")  # oracle: opening .. resolves to the parent directory

    it "_should_navigate_in_place prefers stat-resolved directories":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): in-place verdict for a symlink stat-resolving to a directory
        step("Ask whether a stat-resolved directory opens in place")
        var vfs = VfsManager.new()
        val fs = FileManagerOpenStatFs.new(FsNodeKind.Directory)
        val mounted = vfs.mount(path: "/", fs_type: "mock", device: "", read_only: false, fs: fs)
        expect(mounted.is_ok()).to_equal(true)  # oracle: the mock mount must succeed for the scenario to be valid
        expect(_should_navigate_in_place("docs", FsNodeKind.Symlink, "/home/docs", vfs)).to_equal(true)  # oracle: a stat-resolved directory is navigated in place

    it "_should_navigate_in_place leaves regular files to the launcher":
        # @req REQ-SSPEC-LOCAL-001
        # @capture(statistics): in-place verdict for a regular file with no vfs
        step("Ask whether a regular file opens in place")
        expect(_should_navigate_in_place("notes.txt", FsNodeKind.File, "/home/notes.txt", nil)).to_equal(false)  # oracle: regular files are handed to the launcher, not opened in place
