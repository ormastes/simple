# @cover src/os/sosix/fs/service_buffer_registry_v1.spl 80%
"""Authenticated SOSIX FS v1 service buffer registry specification."""

use std.spec.*
use os.sosix.core.capability_ref.SosixBufferRef
use os.sosix.fs.registered_buffer_client_v1.*
use os.sosix.fs.service_adapter_v1.*
use os.sosix.fs.service_buffer_registry_v1.*
use os.sosix.fs.operation_adapter.SOSIX_FS_READ_AT

fn _empty_registry() -> SosixFsServiceRegistryV1:
    SosixFsServiceRegistryV1(capabilities: [], buffers: [])

fn _facts(owner: u64) -> SosixFsBufferControlFactsV1:
    SosixFsBufferControlFactsV1(
        source_authenticated: true, source_process_id: owner,
        received_service_endpoint: 700, expected_service_endpoint: 700)

fn _plan(registration_id: u64, generation: u32) -> SosixFsServiceDispatchPlanV1:
    SosixFsServiceDispatchPlanV1(
        ready: true, api_id: SOSIX_FS_READ_AT, source_process_id: 42,
        reply_endpoint: 900, operation_slot: 1, operation_generation: 1,
        request_token: 1, deadline_ns: 0, file_object_id: 1,
        buffer_registration_id: registration_id, buffer_slot: 4,
        buffer_generation: generation, resource_offset: 0,
        buffer_offset: 0, length: 2)

describe "SOSIX FS v1 service buffer registration":
    it "copies owned bytes and returns a fully bound authenticated receipt":
        var source = [1u8, 2u8, 3u8]
        val registered = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_READ_V1 + SOSIX_FS_SERVICE_BUFFER_WRITE_V1,
            source)
        source[0] = 99
        expect(registered.accepted).to_be(true)
        expect(registered.receipt.authenticated).to_be(true)
        expect(registered.receipt.owner_process_id).to_equal(42)
        expect(registered.receipt.service_endpoint).to_equal(700)
        expect(registered.receipt.buffer.slot).to_equal(4)
        expect(registered.receipt.buffer.generation).to_equal(9)
        expect(registered.receipt.service_registration_id).to_equal(1)
        expect(registered.receipt.byte_length).to_equal(3)
        expect(registered.receipt.access).to_equal(3)
        expect(registered.receipt.memory_mode).to_equal(SOSIX_FS_CLIENT_MEMORY_OWNED_COPY_V1)
        expect(registered.registry.buffers[0].bytes[0]).to_equal(1)

    it "rejects unauthenticated creation and forged receipt refresh":
        var unauthenticated = _facts(42)
        unauthenticated.source_authenticated = false
        val rejected = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), unauthenticated,
            SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_READ_V1, [1u8])
        expect(rejected.accepted).to_be(false)
        expect(rejected.reason).to_equal("unauthenticated-buffer-registration")

        val registered = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_READ_V1, [1u8])
        var forged = registered.receipt
        forged.service_registration_id = 99
        val refresh = sosix_fs_service_refresh_owned_buffer_v1(
            registered.registry, _facts(42), forged, [2u8])
        expect(refresh.accepted).to_be(false)
        expect(refresh.reason).to_equal("buffer-receipt-mismatch")
        expect(refresh.registry.buffers[0].bytes[0]).to_equal(1)

    it "refreshes the service-owned copy only through matching transport facts":
        val registered = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_READ_V1, [1u8, 2u8])
        val refreshed = sosix_fs_service_refresh_owned_buffer_v1(
            registered.registry, _facts(42), registered.receipt, [8u8, 9u8])
        expect(refreshed.accepted).to_be(true)
        expect(refreshed.registry.buffers[0].bytes[0]).to_equal(8)
        expect(refreshed.registry.buffers[0].bytes[1]).to_equal(9)

        val foreign = sosix_fs_service_refresh_owned_buffer_v1(
            refreshed.registry, _facts(41), refreshed.receipt, [3u8, 4u8])
        expect(foreign.accepted).to_be(false)
        expect(foreign.reason).to_equal("buffer-receipt-mismatch")

    it "retires storage, advances generation, and rejects stale reuse":
        val registered = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_WRITE_V1, [1u8])
        val retired = sosix_fs_service_retire_buffer_v1(
            registered.registry, _facts(42), registered.receipt)
        expect(retired.accepted).to_be(true)
        expect(retired.registry.buffers[0].active).to_be(false)
        expect(retired.registry.buffers[0].bytes.len()).to_equal(0)
        expect(retired.registry.buffers[0].ref_.generation).to_equal(10)

        val stale = sosix_fs_service_register_owned_buffer_v1(
            retired.registry, _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_WRITE_V1, [2u8])
        expect(stale.accepted).to_be(false)
        expect(stale.reason).to_equal("stale-buffer-generation")
        val reused = sosix_fs_service_register_owned_buffer_v1(
            retired.registry, _facts(42), SosixBufferRef(slot: 4, generation: 10),
            SOSIX_FS_SERVICE_BUFFER_WRITE_V1, [2u8])
        expect(reused.accepted).to_be(true)
        expect(reused.receipt.service_registration_id).to_equal(2)

    it "looks up authoritative bytes and rejects stale read writeback":
        val registered = sosix_fs_service_register_owned_buffer_v1(
            _empty_registry(), _facts(42), SosixBufferRef(slot: 4, generation: 9),
            SOSIX_FS_SERVICE_BUFFER_WRITE_V1, [1u8, 2u8])
        val plan = _plan(registered.receipt.service_registration_id, 9)
        val lookup = sosix_fs_service_lookup_dispatch_buffer_v1(registered.registry, plan)
        expect(lookup.accepted).to_be(true)
        expect(lookup.bytes[0]).to_equal(1)

        val committed = sosix_fs_service_commit_dispatch_buffer_v1(
            registered.registry, plan, [7u8, 8u8])
        expect(committed.accepted).to_be(true)
        expect(committed.registry.buffers[0].bytes[0]).to_equal(7)

        val retired = sosix_fs_service_retire_buffer_v1(
            committed.registry, _facts(42), committed.receipt)
        val stale = sosix_fs_service_commit_dispatch_buffer_v1(
            retired.registry, plan, [9u8, 9u8])
        expect(stale.accepted).to_be(false)
        expect(stale.reason).to_equal("stale-dispatch-buffer")
