# @cover src/os/sosix/host/host_input_producer_adapter.spl 90%
"""
## Purpose and audience
Purpose: translates normalized pointer key and text callbacks in order
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-HostInpuProdAdap-001

use std.spec
use common.ui.host_input_event.{
    HostInputEvent,
    host_pointer_move, host_pointer_down, host_pointer_wheel,
    host_key_down, host_resize, HOST_BTN_LEFT, HOST_MOD_CTRL
}
use os.sosix.core.capability_ref.{SosixCapabilityRef}
use os.sosix.host.input_stream_state.{
    SOSIX_INPUT_POINTER_MOVE, SOSIX_INPUT_POINTER_BUTTON,
    SOSIX_INPUT_KEY, SOSIX_INPUT_WHEEL, SOSIX_INPUT_RESIZE,
    SosixInputStreamState, sosix_input_stream_state_create,
    sosix_input_stream_try_take
}
use os.sosix.host.host_input_producer_adapter.{
    sosix_host_input_publish
}

fn fresh(capacity: u32) -> SosixInputStreamState:
    sosix_input_stream_state_create(
        SosixCapabilityRef(slot: 11, generation: 3), capacity
    ).state

use std.spec.step
describe "SOSIX hosted input producer adapter":
    it "translates normalized pointer key and text callbacks in order":
        step("Verify: translates normalized pointer key and text callbacks in order")
        # @req: REQ-OS-HostInpuProdAdap-001
        val moved = sosix_host_input_publish(fresh(4), host_pointer_move(7, 9), 100)
        val clicked = sosix_host_input_publish(moved.state, host_pointer_down(7, 9, HOST_BTN_LEFT), 101)
        val keyed = sosix_host_input_publish(clicked.state, host_key_down(65, "a", HOST_MOD_CTRL), 102)
        val one = sosix_input_stream_try_take(keyed.state)
        val two = sosix_input_stream_try_take(one.state)
        val three = sosix_input_stream_try_take(two.state)
        expect(one.event.kind).to_equal(SOSIX_INPUT_POINTER_MOVE)
        expect(one.event.data0).to_equal(7)  # oracle: value fixed by the spec contract
        expect(one.event.data1).to_equal(9)  # oracle: value fixed by the spec contract
        expect(two.event.kind).to_equal(SOSIX_INPUT_POINTER_BUTTON)
        expect(two.event.data0).to_equal(HOST_BTN_LEFT)
        expect(two.event.data1).to_equal(1)  # oracle: value fixed by the spec contract
        expect(three.event.kind).to_equal(SOSIX_INPUT_KEY)
        expect(three.event.data0).to_equal(65)  # oracle: value fixed by the spec contract
        expect(three.event.data1).to_equal(HOST_MOD_CTRL * 2 + 1)
        match three.event.host_event:
            HostInputEvent.Key(code, ch, down, mods):
                expect(code).to_equal(65)  # oracle: value fixed by the spec contract
                expect(ch).to_equal("a")
                expect(down).to_equal(true)
                expect(mods).to_equal(HOST_MOD_CTRL)
            _: expect(false).to_equal(true)

    it "delegates timestamp rejection and bounded motion coalescing":
        step("Verify: delegates timestamp rejection and bounded motion coalescing")
        # @req: REQ-OS-HostInpuProdAdap-001
        val first = sosix_host_input_publish(fresh(1), host_pointer_move(1, 2), 20)
        val newest = sosix_host_input_publish(first.state, host_pointer_move(3, 4), 21)
        expect(newest.reason).to_equal("motion-coalesced")
        expect(newest.state.next_sequence).to_equal(3)  # oracle: value fixed by the spec contract
        val taken = sosix_input_stream_try_take(newest.state)
        expect(taken.event.data0).to_equal(3)  # oracle: value fixed by the spec contract
        expect(sosix_host_input_publish(newest.state, host_key_down(66, "b", 0), 19).reason).to_equal("input-time-regressed")

    it "preserves sequence when backpressured or unsupported":
        step("Verify: preserves sequence when backpressured or unsupported")
        # @req: REQ-OS-HostInpuProdAdap-001
        val full = sosix_host_input_publish(fresh(1), host_key_down(65, "a", 0), 10)
        val blocked = sosix_host_input_publish(full.state, host_key_down(66, "b", 0), 11)
        expect(blocked.reason).to_equal("input-backpressure")
        expect(blocked.state.next_sequence).to_equal(2)  # oracle: value fixed by the spec contract
        val wheel = sosix_host_input_publish(blocked.state, host_pointer_wheel(1, 2, 1), 12)
        expect(wheel.reason).to_equal("input-backpressure")
        expect(wheel.state.next_sequence).to_equal(2)  # oracle: value fixed by the spec contract

    it "retains wheel resize and key text without lossy re-encoding":
        step("Verify: retains wheel resize and key text without lossy re-encoding")
        # @req: REQ-OS-HostInpuProdAdap-001
        val wheel = sosix_host_input_publish(fresh(3), host_pointer_wheel(1, 2, 3), 10)
        val resized = sosix_host_input_publish(wheel.state, host_resize(80, 25), 11)
        val keyed = sosix_host_input_publish(resized.state, host_key_down(65, "é", 0), 12)
        val one = sosix_input_stream_try_take(keyed.state)
        val two = sosix_input_stream_try_take(one.state)
        val three = sosix_input_stream_try_take(two.state)
        expect(one.event.kind).to_equal(SOSIX_INPUT_WHEEL)
        expect(two.event.kind).to_equal(SOSIX_INPUT_RESIZE)
        match three.event.host_event:
            HostInputEvent.Key(code, ch, down, mods):
                expect(code).to_equal(65)  # oracle: value fixed by the spec contract
                expect(ch).to_equal("é")
                expect(down).to_equal(true)
                expect(mods).to_equal(0)  # oracle: value fixed by the spec contract
            _: expect(false).to_equal(true)
