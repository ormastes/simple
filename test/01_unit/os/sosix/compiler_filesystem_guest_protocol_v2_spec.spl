use std.spec.*
use os.sosix.compiler_filesystem_guest_protocol_v2.*

describe "SimpleOS compiler-filesystem guest protocol v2":
    it "formats exact nonce and image records":
        expect(simpleos_cfs_begin_v2("x86_64", "nonce-7")).to_equal(
            "SIMPLEOS_COMPILER_FS_BEGIN arch=x86_64 nonce=nonce-7 protocol=2")
        expect(simpleos_cfs_fwcfg_v2("nonce-7")).to_equal(
            "SIMPLEOS_COMPILER_FS_FWCFG name=opt/simpleos.cfs.nonce nonce=nonce-7 status=pass")
        expect(simpleos_cfs_qemu_image_v2("/images/cfs.raw", "image-sha", "file=/images/cfs.raw,if=none,id=cfsexecns1,format=raw")).to_equal(
            "SIMPLEOS_COMPILER_FS_QEMU_IMAGE path=/images/cfs.raw sha256=image-sha drive_arg=file=/images/cfs.raw,if=none,id=cfsexecns1,format=raw")

    it "formats exact filesystem role and version records":
        expect(simpleos_cfs_role_v2("/usr/bin/simple", "simple-sha", "exec_alias", "/usr/bin/simple")).to_equal(
            "SIMPLEOS_COMPILER_FS_ROLE path=/usr/bin/simple sha256=simple-sha kind=exec_alias canonical=/usr/bin/simple")
        expect(simpleos_cfs_version_v2("simple-sha", "version-sha", "53696d706c652076320a", "manifest-sha", "nonce-7", 0)).to_equal(
            "SIMPLEOS_COMPILER_FS_VERSION path=/usr/bin/simple status=pass simple_sha256=simple-sha version_output_sha256=version-sha stdout_hex=53696d706c652076320a manifest_sha256=manifest-sha nonce=nonce-7 exit=0")

    it "formats exact compile execution and pass records from supplied evidence":
        expect(simpleos_cfs_compile_v2("source-sha", "artifact-sha", "nonce-7", "observed")).to_equal(
            "SIMPLEOS_COMPILER_FS_COMPILE compiler=/usr/bin/simple source=/HELLO.SPL artifact=/TMP/HELLO source_sha256=source-sha artifact_sha256=artifact-sha nonce=nonce-7 status=observed")
        expect(simpleos_cfs_exec_v2("artifact-sha", "nonce-7", 17, "48690a", "stdout-sha")).to_equal(
            "SIMPLEOS_COMPILER_FS_EXEC path=/TMP/HELLO artifact_sha256=artifact-sha nonce=nonce-7 exit=17 stdout_hex=48690a stdout_sha256=stdout-sha status=pass")
        expect(simpleos_cfs_pass_v2("x86_64", "nonce-7", "simple-sha", "artifact-sha")).to_equal(
            "SIMPLEOS_COMPILER_FS_PASS arch=x86_64 nonce=nonce-7 simple_sha256=simple-sha artifact_sha256=artifact-sha status=pass")
