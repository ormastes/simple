# @cover src/os/sosix/fs/service_dispatch_transaction_v1.spl 80%
"""Atomic SOSIX FS v1 service dispatch transaction specification."""

use std.spec.*
use os.sosix.core.capability_ref.SosixBufferRef
use os.sosix.fs.operation_adapter.{SOSIX_FS_READ_AT, SOSIX_FS_WRITE_AT}
use os.sosix.fs.ipc_codec_v1.sosix_fs_ipc_decode_completion_v1
use os.sosix.fs.service_adapter_v1.*
use os.sosix.fs.service_dispatch_transaction_v1.*
use os.sosix.fs.service_vfs_backend_v1.SosixPositionedVfsBackendV1

class TransactionBackend:
    bytes: [u8]
    fail_read: bool
    oversize_read: bool

impl TransactionBackend:
    static fn new() -> TransactionBackend:
        TransactionBackend(
            bytes: [10, 20, 30, 40, 50], fail_read: false,
            oversize_read: false)

impl SosixPositionedVfsBackendV1 for TransactionBackend:
    fn positioned_io_available() -> bool: true
    fn read_at(file_object_id: u64, offset: u64, length: u64) -> Result<[u8], text>:
        if self.fail_read:
            return Err("backend-read-failed")
        if self.oversize_read:
            return Ok([1, 2, 3])
        var out: [u8] = []
        var index = 0u64
        while index < length and offset + index < self.bytes.len().to_u64():
            out.push(self.bytes[(offset + index).to_i32()])
            index = index + 1
        Ok(out)
    fn write_at(file_object_id: u64, offset: u64, data: [u8]) -> Result<u64, text>:
        var index = 0u64
        while index < data.len().to_u64():
            self.bytes[(offset + index).to_i32()] = data[index.to_i32()]
            index = index + 1
        Ok(data.len().to_u64())

fn _prepared(api_id: u32, generation: u32, length: u64) -> SosixFsServicePrepareResultV1:
    SosixFsServicePrepareResultV1(
        accepted: true, reason: "dispatch-ready", status: 0,
        plan: SosixFsServiceDispatchPlanV1(
            ready: true, api_id: api_id, source_process_id: 42,
            reply_endpoint: 900, operation_slot: 11, operation_generation: 12,
            request_token: 99, deadline_ns: 0, file_object_id: 1200,
            buffer_registration_id: 1300, buffer_slot: 4,
            buffer_generation: generation, resource_offset: 1,
            buffer_offset: 1, length: length))

fn _registry(generation: u32) -> SosixFsServiceRegistryV1:
    SosixFsServiceRegistryV1(
        capabilities: [],
        buffers: [SosixFsBufferEntryV1(
            active: true, ref_: SosixBufferRef(slot: 4, generation: generation),
            owner_process_id: 42, registration_id: 1300, byte_length: 5,
            access: SOSIX_FS_SERVICE_BUFFER_READ_V1 + SOSIX_FS_SERVICE_BUFFER_WRITE_V1,
            service_endpoint: 700, memory_mode: 1,
            bytes: [9, 8, 7, 6, 5])])

describe "SOSIX FS v1 atomic service dispatch transaction":
    it "commits a successful read and encodes its plan correlation":
        val result = sosix_fs_service_dispatch_transaction_v1(
            _prepared(SOSIX_FS_READ_AT, 9, 2), _registry(9),
            TransactionBackend.new())
        expect(result.accepted).to_be(true)
        expect(result.transferred).to_equal(2)
        expect(result.registry.buffers[0].bytes).to_equal([9, 20, 30, 6, 5])
        val decoded = sosix_fs_ipc_decode_completion_v1(
            result.completion, SOSIX_FS_READ_AT, 11, 12, 99)
        expect(decoded.accepted).to_be(true)
        expect(decoded.completion.transferred).to_equal(2)

    it "writes only authoritative registry bytes and preserves the registry":
        val backend = TransactionBackend.new()
        val original = _registry(9)
        val result = sosix_fs_service_dispatch_transaction_v1(
            _prepared(SOSIX_FS_WRITE_AT, 9, 2), original, backend)
        expect(result.accepted).to_be(true)
        expect(backend.bytes).to_equal([10, 8, 7, 40, 50])
        expect(result.registry.buffers[0].bytes).to_equal([9, 8, 7, 6, 5])

    it "encodes zero-byte EOF without claiming partial progress":
        var prepared = _prepared(SOSIX_FS_READ_AT, 9, 2)
        prepared.plan.resource_offset = 99
        val result = sosix_fs_service_dispatch_transaction_v1(
            prepared, _registry(9), TransactionBackend.new())
        expect(result.accepted).to_be(true)
        expect(result.transferred).to_equal(0)
        expect(result.registry.buffers[0].bytes).to_equal([9, 8, 7, 6, 5])
        val decoded = sosix_fs_ipc_decode_completion_v1(
            result.completion, SOSIX_FS_READ_AT, 11, 12, 99)
        expect(decoded.accepted).to_be(true)
        expect(decoded.completion.flags).to_equal(0)

    it "rejects stale generation before dispatch and preserves bytes":
        val backend = TransactionBackend.new()
        val result = sosix_fs_service_dispatch_transaction_v1(
            _prepared(SOSIX_FS_READ_AT, 8, 2), _registry(9), backend)
        expect(result.accepted).to_be(false)
        expect(result.reason).to_equal("stale-dispatch-buffer")
        expect(result.registry.buffers[0].bytes).to_equal([9, 8, 7, 6, 5])
        expect(backend.bytes).to_equal([10, 20, 30, 40, 50])

    it "never commits failed or oversized backend reads":
        val failed_backend = TransactionBackend.new()
        failed_backend.fail_read = true
        val failed = sosix_fs_service_dispatch_transaction_v1(
            _prepared(SOSIX_FS_READ_AT, 9, 2), _registry(9), failed_backend)
        expect(failed.accepted).to_be(false)
        expect(failed.registry.buffers[0].bytes).to_equal([9, 8, 7, 6, 5])

        val oversized_backend = TransactionBackend.new()
        oversized_backend.oversize_read = true
        val oversized = sosix_fs_service_dispatch_transaction_v1(
            _prepared(SOSIX_FS_READ_AT, 9, 2), _registry(9), oversized_backend)
        expect(oversized.accepted).to_be(false)
        expect(oversized.reason).to_equal("backend-read-exceeds-request")
        expect(oversized.registry.buffers[0].bytes).to_equal([9, 8, 7, 6, 5])

    it "does not encode correlation for an unaccepted caller plan":
        var prepared = _prepared(SOSIX_FS_READ_AT, 9, 2)
        prepared.accepted = false
        val result = sosix_fs_service_dispatch_transaction_v1(
            prepared, _registry(9), TransactionBackend.new())
        expect(result.accepted).to_be(false)
        expect(result.completion.len()).to_equal(0)
