use std.spec.*
use os.sosix.qemu_fs_toolchain_evidence_v1.*

describe "SOSIX filesystem toolchain evidence protocol":
    it "formats one architecture-neutral nonce-bound transaction":
        val source = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
        val executable = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
        expect(sosix_fs_toolchain_begin_v1("linux", "riscv64", "run-7")).to_equal(
            "SOSIX_FS_TOOLCHAIN_BEGIN schema=1 host=linux arch=riscv64 nonce=run-7")
        expect(sosix_fs_source_read_v1("interpreter", "/tmp/hello.spl", source)).to_contain(
            "role=interpreter path=/tmp/hello.spl sha256=" + source)
        expect(sosix_fs_compiler_output_v1("/tmp/hello", source, executable)).to_contain(
            "source_sha256=" + source + " sha256=" + executable)
        expect(sosix_fs_exec_read_v1("/tmp/hello", executable)).to_equal(
            "SOSIX_FS_EXEC_READ role=loader path=/tmp/hello sha256=" + executable)
        expect(sosix_fs_toolchain_end_v1("linux", "riscv64", "run-7", source, executable)).to_contain(
            "nonce=run-7 source_sha256=" + source + " executable_sha256=" + executable + " status=pass")
