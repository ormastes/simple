# @cover src/os/sosix/qemu_evidence/trusted_importer.spl 85%
use std.spec
use std.common.base_encoding.base64.{base64_encode}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.nogc_sync_mut.ffi.io.{dir_create_all, dir_remove_all, file_write_text}
use os.sosix.qemu_evidence.{sosix_qemu_collector_root_is_release_admissible}

val _QEMU_V2_FIXTURE_ROOT: text = "/tmp/simple-sosix-qemu-v2-importer-spec"
val _QEMU_V2_SOURCE_IDENTITY: text = "git:0123456789abcdef0123456789abcdef01234567:tree:89abcdef0123456789abcdef0123456789abcdef:clean"

struct _QemuV2FixtureArtifacts:
    hashes: [text]

fn _qemu_v2_artifact_names() -> [text]:
    ["host-admission.env", "qemu.argv", "qemu.version", "transcript.log",
        "kernel.elf", "guest.img", "program.elf", "required-markers.txt"]

fn _qemu_v2_artifact_content(index: i64, host: text, guest: text) -> text:
    if index == 0: return "host-admission:{host}:{guest}\n"
    if index == 1: return "qemu-system-fixture -machine fixture -bios none\n"
    if index == 2: return "QEMU emulator version fixture\n"
    if index == 3: return "guest-entry\nrun-{host}-{guest}-20260816\nTEST PASSED\n"
    if index == 4: return "kernel:{host}:{guest}\n"
    if index == 5: return "image:{host}:{guest}\n"
    if index == 6: return "program:{host}:{guest}\n"
    "guest-entry\nTEST PASSED\n"

fn _qemu_v2_write_artifacts(root: text, host: text, guest: text) -> _QemuV2FixtureArtifacts:
    val artifact_root = root + "/rows/" + host + "/" + guest + "/artifacts"
    expect(dir_create_all(artifact_root)).to_be(true)
    var hashes: [text] = []
    val names = _qemu_v2_artifact_names()
    var index: i64 = 0
    while index < names.len():
        val content = _qemu_v2_artifact_content(index, host, guest)
        expect(file_write_text(artifact_root + "/" + names[index], content)).to_be(true)
        hashes.push(sha256_u8_hex(content.to_bytes()))
        index = index + 1
    _QemuV2FixtureArtifacts(hashes: hashes)

fn _qemu_v2_evidence(host: text, guest: text, artifacts: _QemuV2FixtureArtifacts) -> text:
    val h = artifacts.hashes
    var evidence =
        "schema_version=2\n" +
        "host={host}\n" +
        "guest={guest}\n" +
        "status=pass\n" +
        "reason=\n" +
        "owner=fixture-owner\n" +
        "reviewer=fixture-reviewer\n" +
        "resume_command=\n" +
        "source_identity={_QEMU_V2_SOURCE_IDENTITY}\n" +
        "compiler_identity=source-simple:fixture\n" +
        "kernel_identity=sha256:{h[4]}\n" +
        "image_identity=sha256:{h[5]}\n" +
        "qemu_identity=sha256:{"a" * 64}:version:qemu-fixture\n" +
        "qemu_argv=qemu-system-fixture -machine fixture -bios none\n" +
        "accelerator_identity=tcg\n" +
        "firmware_identity=firmware:none\n" +
        "firmware_mode=direct-kernel\n" +
        "run_nonce=run-{host}-{guest}-20260816\n" +
        "firmware_path=none\n" +
        "firmware_version=version:none\n" +
        "firmware_sha256=none\n" +
        "firmware_stage_markers=guest-entry\n" +
        "transcript_identity=sha256:{h[3]}\n" +
        "program_identity=sha256:{h[6]}\n" +
        "compiler_in_filesystem=false\n" +
        "compiler_version_evidence_path=\n" +
        "compiler_hello_evidence_path=\n" +
        "artifact_count=8\n"
    val names = _qemu_v2_artifact_names()
    var index: i64 = 0
    while index < names.len():
        val artifact_index = index + 1
        evidence = evidence + "artifact_{artifact_index}_path={names[index]}\n" +
            "artifact_{artifact_index}_sha256={h[index]}\n"
        index = index + 1
    evidence

fn _qemu_v2_admission(evidence_sha: text, artifacts: _QemuV2FixtureArtifacts) -> text:
    val h = artifacts.hashes
    "manifest_version=2\n" +
    "status=pass\n" +
    "evidence_sha256={evidence_sha}\n" +
    "artifact_count=8\n" +
    "source_identity={_QEMU_V2_SOURCE_IDENTITY}\n" +
    "transcript_identity=sha256:{h[3]}\n" +
    "program_identity=sha256:{h[6]}\n" +
    "firmware_identity=firmware:none\n" +
    "firmware_mode=direct-kernel\n" +
    "firmware_path=none\n" +
    "firmware_version=version:none\n" +
    "firmware_sha256=none\n" +
    "firmware_stage_markers=guest-entry\n"

fn _qemu_v2_manifest_row(
    row_number: i64,
    host: text,
    guest: text,
    artifacts: _QemuV2FixtureArtifacts,
    evidence_sha: text,
    admission_sha: text,
    malformed_owner_b64: bool
) -> text:
    val prefix = "sosix_qemu_matrix_row_{row_number}"
    val h = artifacts.hashes
    val owner_b64 = if malformed_owner_b64: "@@" else: base64_encode("fixture-owner")
    "{prefix}_host={host}\n" +
    "{prefix}_guest={guest}\n" +
    "{prefix}_status=pass\n" +
    "{prefix}_reason_b64=\n" +
    "{prefix}_evidence_path_b64={base64_encode("rows/" + host + "/" + guest + "/evidence.env")}\n" +
    "{prefix}_admission_record_path_b64={base64_encode("rows/" + host + "/" + guest + "/admission.env")}\n" +
    "{prefix}_admission_record_sha256={admission_sha}\n" +
    "{prefix}_resume_command_b64=\n" +
    "{prefix}_owner_b64={owner_b64}\n" +
    "{prefix}_reviewer_b64={base64_encode("fixture-reviewer")}\n" +
    "{prefix}_compiler_in_filesystem=false\n" +
    "{prefix}_compiler_version_evidence_path_b64=\n" +
    "{prefix}_compiler_hello_evidence_path_b64=\n" +
    "{prefix}_source_identity_b64={base64_encode(_QEMU_V2_SOURCE_IDENTITY)}\n" +
    "{prefix}_compiler_identity_b64={base64_encode("source-simple:fixture")}\n" +
    "{prefix}_kernel_identity_b64={base64_encode("sha256:" + h[4])}\n" +
    "{prefix}_image_identity_b64={base64_encode("sha256:" + h[5])}\n" +
    "{prefix}_qemu_identity_b64={base64_encode("sha256:" + "a" * 64 + ":version:qemu-fixture")}\n" +
    "{prefix}_qemu_argv_b64={base64_encode("qemu-system-fixture -machine fixture -bios none")}\n" +
    "{prefix}_accelerator_identity_b64={base64_encode("tcg")}\n" +
    "{prefix}_firmware_identity_b64={base64_encode("firmware:none")}\n" +
    "{prefix}_firmware_mode_b64={base64_encode("direct-kernel")}\n" +
    "{prefix}_firmware_path_b64={base64_encode("none")}\n" +
    "{prefix}_firmware_version_b64={base64_encode("version:none")}\n" +
    "{prefix}_firmware_sha256_b64={base64_encode("none")}\n" +
    "{prefix}_firmware_stage_markers_b64={base64_encode("guest-entry")}\n" +
    "{prefix}_run_nonce_b64={base64_encode("run-" + host + "-" + guest + "-20260816")}\n" +
    "{prefix}_transcript_identity_b64={base64_encode("sha256:" + h[3])}\n" +
    "{prefix}_program_identity_b64={base64_encode("sha256:" + h[6])}\n" +
    "{prefix}_evidence_sha256={evidence_sha}\n" +
    "{prefix}_artifact_count=8\n"

fn _qemu_v2_setup_full_matrix(
    root: text, malformed_last_row: bool, swap_first_two_rows: bool = false
) -> text:
    _ = dir_remove_all(root)
    expect(dir_create_all(root)).to_be(true)
    var manifest = "sosix_qemu_matrix_manifest_version=2\n" +
        "sosix_qemu_matrix_row_count=24\n"
    var row_number: i64 = 0
    for host in ["freebsd", "linux", "macos", "windows"]:
        val guests = if swap_first_two_rows and host == "freebsd":
            ["arm64", "arm32", "riscv32", "riscv64", "x86_32", "x86_64"]
        else:
            ["arm32", "arm64", "riscv32", "riscv64", "x86_32", "x86_64"]
        for guest in guests:
            row_number = row_number + 1
            val row_root = root + "/rows/" + host + "/" + guest
            val artifacts = _qemu_v2_write_artifacts(root, host, guest)
            val evidence = _qemu_v2_evidence(host, guest, artifacts)
            val evidence_sha = sha256_u8_hex(evidence.to_bytes())
            val admission = _qemu_v2_admission(evidence_sha, artifacts)
            val admission_sha = sha256_u8_hex(admission.to_bytes())
            expect(file_write_text(row_root + "/evidence.env", evidence)).to_be(true)
            expect(file_write_text(row_root + "/admission.env", admission)).to_be(true)
            manifest = manifest + _qemu_v2_manifest_row(
                row_number, host, guest, artifacts, evidence_sha, admission_sha,
                malformed_last_row and row_number == 24)
    manifest = manifest +
        "sosix_qemu_matrix_promotion_status=pass\n" +
        "sosix_qemu_matrix_nonpass_row_count=0\n"
    val bundle_id = sha256_u8_hex(manifest.to_bytes()).substring(0, 16)
    manifest = manifest + "sosix_qemu_matrix_bundle_id={bundle_id}\n"
    expect(file_write_text(root + "/matrix.env", manifest)).to_be(true)
    root

describe "SOSIX QEMU v2 trusted importer":
    it "accepts a complete byte-bound 24-cell direct-kernel collector root":
        val root = _qemu_v2_setup_full_matrix(_QEMU_V2_FIXTURE_ROOT, false)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(true)

    it "rejects exact admission-record byte mutation after manifest publication":
        val root = _qemu_v2_setup_full_matrix(_QEMU_V2_FIXTURE_ROOT, false)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(true)
        val mutated = _qemu_v2_admission(
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
            _qemu_v2_write_artifacts(root, "linux", "x86_32"))
        expect(file_write_text(root + "/rows/linux/x86_32/admission.env", mutated)).to_be(true)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(false)

    it "rejects a malformed final row after twenty-three valid rows":
        val root = _qemu_v2_setup_full_matrix(_QEMU_V2_FIXTURE_ROOT, true)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(false)

    it "rejects a complete but noncanonical collector row permutation":
        val root = _qemu_v2_setup_full_matrix(
            _QEMU_V2_FIXTURE_ROOT, false, swap_first_two_rows: true)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(false)

    it "rejects a retained artifact changed after evidence publication":
        val root = _qemu_v2_setup_full_matrix(_QEMU_V2_FIXTURE_ROOT, false)
        val artifact = root + "/rows/freebsd/riscv64/artifacts/program.elf"
        expect(file_write_text(artifact, "late artifact mutation\n")).to_be(true)
        expect(sosix_qemu_collector_root_is_release_admissible(root)).to_be(false)
