# Source wiring evidence; physical guest execution remains a separate gate.
use std.spec.{describe, it, expect, step}
extern fn rt_file_read_text(path: text) -> text?

describe "SOSIX spawn argv production wiring":
    it "dispatches supplied arguments through the scoped userspace owner":
        val source = rt_file_read_text("src/os/sosix/process.spl") ?? ""
        val spawn = source.slice(source.index_of("fn sosix_process_spawn("), source.index_of("fn sosix_process_waitpid("))
        expect(spawn).to_contain("user_spawn(path, args, priority)")
        expect(spawn.contains("_ignored_args")).to_equal(false)

    it "retains priority separately from the owned argv pointer":
        val source = rt_file_read_text("src/os/userlib/spawn.spl") ?? ""
        expect(source).to_contain("priority as u64, allocation as u64, SYSCALL13_SPAWN_ARGV_ABI_V1")
        expect(source).to_contain("execve_plan_v1(path, argv, [])")
        expect(source).to_contain("raw_free(allocation, size)")
        expect(source.contains(".ptr()")).to_equal(false)

    it "copies tagged char pointer vectors before constructing the child image":
        val source = rt_file_read_text("src/os/kernel/ipc/syscall_process.spl") ?? ""
        expect(source).to_contain("if args.arg4 == SYSCALL13_SPAWN_ARGV_ABI_V1:")
        expect(source).to_contain("vmm_copyin_string_vector(\n            args.arg3,")
        expect(source).to_contain("build_user_process_image(path, bytes_result.unwrap(), arch, sp_argv, sp_envp)")
        expect(source).to_contain("fn dispatch_spawn_binary_syscall_state(")

    it "routes installed x86 and RV64 dispatch through the argument aware owner":
        val x86 = rt_file_read_text("src/os/kernel/arch/x86_64/interrupt.spl") ?? ""
        val rv64 = rt_file_read_text("src/os/kernel/arch/riscv64/syscall.spl") ?? ""
        expect(x86).to_contain("val spawn_state = dispatch_spawn_binary_syscall_state(")
        expect(rv64).to_contain("val spawned = dispatch_spawn_binary_syscall_state(")

    it "preserves the child's mapped address space after argv spawn [source-contract]":
        # @req REQ-SOSIX-SPAWN-ARGV-001
        step("Inspect the argument-aware syscall owner after child construction")
        val source = rt_file_read_text("src/os/kernel/ipc/syscall_process.spl") ?? ""
        val spawn = source.slice(source.index_of("fn _handle_spawn_binary_state("), source.index_of("fn _handle_spawn_binary("))
        expect(spawn).to_contain("sched.create_user_task_pid(image_result.unwrap(), priority, caps)")
        step("Reject replacement of the scheduler-owned physical page-table root")
        expect(spawn.contains("vmm_new_process_space(0, 0)")).to_equal(false)
        expect(spawn.contains("register_task_vmspace(")).to_equal(false)

    it "reports only a PID returned by the child owner [source-contract]":
        # @req REQ-SOSIX-SPAWN-ARGV-001
        step("Inspect success publication when identity reservation fails or another CPU advances it")
        val source = rt_file_read_text("src/os/kernel/ipc/syscall_process.spl") ?? ""
        val spawn = source.slice(source.index_of("fn _handle_spawn_binary_state("), source.index_of("fn _handle_spawn_binary("))
        expect(spawn.contains("g_scheduler_next_task_id")).to_equal(false)
        expect(spawn).to_contain("val pid = sched.create_user_task_pid(image_result.unwrap(), priority, caps)")
        expect(spawn).to_contain("if pid == 0:")

    it "reserves one paired task identity for an argv child [source-contract]":
        # @req REQ-SOSIX-SPAWN-ARGV-001
        step("Inspect the image creation owner reached by argument-aware spawn")
        val source = rt_file_read_text("src/os/kernel/scheduler/scheduler_exec.spl") ?? ""
        val create = source.slice(source.index_of("pub fn sched_create_user_task_pid_impl("), source.index_of("pub fn sched_create_user_task_from_bytes_pid_impl("))
        step("Require one identity reservation and retain that identity's generation")
        expect(create.count("scheduler_next_task_lifecycle_identity_take_v1()")).to_equal(1)
        expect(create).to_contain("val user_next_id = identity.task_id")
        expect(create).to_contain("lifecycle_generation: identity.lifecycle_generation")
