# Purpose: validate descriptor-authoritative identity and extent policy.
# @codex-impl
# @req REQ-SIMPLEOS-DESCRIPTOR-STAT-V1

use std.spec.*
use std.spec.step
use std.common.contracts.sosix.descriptor_stat_v1.*

fn sample_stat(size: u64, kind: DescriptorNodeKindV1) -> DescriptorFileStatV1:
    DescriptorFileStatV1(
        identity: DescriptorFileIdentityV1(
            filesystem_id: 7u64, object_id_low: 11u64, object_id_high: 0u64),
        size: size, allocated_bytes: size, mode: 0o644u64,
        link_count: 1u64, modified_time_ns: 21u64,
        change_time_ns: 22u64, kind: kind)

describe "descriptor stat V1 contract":
    it "accepts a bounded regular-file observation":
        step("Validate identity, kind, link state, and extent together")
        val checked = descriptor_file_stat_validate_v1(
            sample_stat(4096u64, DescriptorNodeKindV1.Regular),
            true, 8192u64)
        expect(checked.accepted).to_be(true)
        expect(checked.reason).to_equal("accepted")

    it "rejects absent identity, wrong kind, and oversize extent":
        step("Fail closed before a loader can map the descriptor")
        var missing = sample_stat(4u64, DescriptorNodeKindV1.Regular)
        missing.identity.object_id_low = 0u64
        expect(descriptor_file_stat_validate_v1(
            missing, true, 8u64).reason).to_equal("identity-unavailable")

        expect(descriptor_file_stat_validate_v1(
            sample_stat(4u64, DescriptorNodeKindV1.Directory),
            true, 8u64).reason).to_equal("not-regular-file")
        expect(descriptor_file_stat_validate_v1(
            sample_stat(9u64, DescriptorNodeKindV1.Regular),
            true, 8u64).reason).to_equal("extent-exceeds-limit")

    it "compares stable descriptor identities independently of extent":
        step("Permit later size checks without re-resolving a pathname")
        val first = sample_stat(4u64, DescriptorNodeKindV1.Regular)
        val later = sample_stat(8u64, DescriptorNodeKindV1.Regular)
        expect(descriptor_file_identity_equal_v1(
            first.identity, later.identity)).to_be(true)
        var replacement = later
        replacement.identity.object_id_low = 12u64
        expect(descriptor_file_identity_equal_v1(
            first.identity, replacement.identity)).to_be(false)
