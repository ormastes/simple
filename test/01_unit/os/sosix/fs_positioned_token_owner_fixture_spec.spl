# @cover src/os/sosix/fs/positioned_dispatch_owner_v1.spl 80%
"""Reduced two-transaction fixture for the sole positioned token owner."""

use std.spec.*
use os.sosix.core.capability_ref.{SosixCapabilityRef, SosixBufferRef}
use os.sosix.fs.positioned_dispatch_owner_v1.*
use os.sosix.fs.positioned_syscall_v1.*
use os.sosix.fs.registry_lifecycle_v1.SosixFsRegistryOwnerV1
use os.sosix.fs.service_adapter_v1.*
use os.sosix.fs.service_vfs_backend_v1.SosixPositionedVfsBackendV1

class TokenFixtureBackend:
    byte: u8

impl SosixPositionedVfsBackendV1 for TokenFixtureBackend:
    fn positioned_io_available() -> bool: true
    fn read_at(file_object_id: u64, offset: u64, length: u64) -> Result<[u8], text>:
        Ok([self.byte])
    fn write_at(file_object_id: u64, offset: u64, data: [u8]) -> Result<u64, text>:
        Ok(data.len().to_u64())

fn _fixture_owner() -> SosixFsPositionedDispatchOwnerV1:
    SosixFsPositionedDispatchOwnerV1(
        registry_owner: SosixFsRegistryOwnerV1(
            service_endpoint: 80, service_generation: 3,
            registry: SosixFsServiceRegistryV1(
                capabilities: [SosixFsCapabilityEntryV1(
                    active: true, ref_: SosixCapabilityRef(slot: 2, generation: 1),
                    owner_process_id: 42, file_object_id: 41,
                    rights: SOSIX_FS_SERVICE_RIGHT_READ_V1)],
                buffers: [SosixFsBufferEntryV1(
                    active: true, ref_: SosixBufferRef(slot: 4, generation: 9),
                    owner_process_id: 42, registration_id: 73, byte_length: 1,
                    access: SOSIX_FS_SERVICE_BUFFER_WRITE_V1,
                    service_endpoint: 80, memory_mode: 1, bytes: [0])])),
        operation_slot: 6, operation_generation: 7, next_request_token: 11)

fn _read_args() -> os.kernel.types.syscall_types.SyscallArgs:
    sosix_fs_positioned_syscall_args_v1(
        SOSIX_FS_PREAD_REGISTERED_V1, 41, 73,
        0x0000000900000004, 0, 0, 1)

describe "SOSIX positioned token owner reduced fixture":
    it "advances exactly once per accepted transaction and preserves rejection identity":
        val first = sosix_fs_dispatch_positioned_with_owner_v1(
            _read_args(), true, 42, _fixture_owner(), TokenFixtureBackend(byte: 9))
        val rejected = sosix_fs_dispatch_positioned_with_owner_v1(
            _read_args(), false, 42, first.owner, TokenFixtureBackend(byte: 8))
        val second = sosix_fs_dispatch_positioned_with_owner_v1(
            _read_args(), true, 42, rejected.owner, TokenFixtureBackend(byte: 7))

        expect(first.accepted).to_be(true)
        expect(first.owner.next_request_token).to_equal(12)
        expect(rejected.accepted).to_be(false)
        expect(rejected.owner.next_request_token).to_equal(12)
        expect(second.accepted).to_be(true)
        expect(second.owner.next_request_token).to_equal(13)
        expect(second.owner.registry_owner.registry.buffers[0].bytes).to_equal([7])
