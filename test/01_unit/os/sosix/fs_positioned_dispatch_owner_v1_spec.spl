# @cover src/os/sosix/fs/positioned_dispatch_owner_v1.spl 80%
"""Focused executable contract for value-threaded positioned dispatch ownership."""

use std.spec.*
use os.kernel.types.syscall_types.SyscallArgs
use os.sosix.core.capability_ref.{SosixCapabilityRef, SosixBufferRef}
use os.sosix.fs.positioned_dispatch_owner_v1.*
use os.sosix.fs.positioned_syscall_v1.*
use os.sosix.fs.registry_lifecycle_v1.SosixFsRegistryOwnerV1
use os.sosix.fs.service_adapter_v1.*
use os.sosix.fs.service_vfs_backend_v1.SosixPositionedVfsBackendV1

class OwnerBackend:
    bytes: [u8]

impl SosixPositionedVfsBackendV1 for OwnerBackend:
    fn positioned_io_available() -> bool: true
    fn read_at(file_object_id: u64, offset: u64, length: u64) -> Result<[u8], text>:
        Ok([self.bytes[offset.to_i32()]])
    me fn write_at(file_object_id: u64, offset: u64, data: [u8]) -> Result<u64, text>:
        self.bytes[offset.to_i32()] = data[0]
        Ok(1)

fn _owner() -> SosixFsPositionedDispatchOwnerV1:
    SosixFsPositionedDispatchOwnerV1(
        registry_owner: SosixFsRegistryOwnerV1(
            service_endpoint: 80, service_generation: 3,
            registry: SosixFsServiceRegistryV1(
                capabilities: [SosixFsCapabilityEntryV1(
                    active: true, ref_: SosixCapabilityRef(slot: 2, generation: 1),
                    owner_process_id: 42, file_object_id: 41,
                    rights: SOSIX_FS_SERVICE_RIGHT_READ_V1)],
                buffers: [SosixFsBufferEntryV1(
                    active: true, ref_: SosixBufferRef(slot: 4, generation: 9),
                    owner_process_id: 42, registration_id: 73, byte_length: 2,
                    access: SOSIX_FS_SERVICE_BUFFER_WRITE_V1,
                    service_endpoint: 80, memory_mode: 1, bytes: [0, 0])])),
        operation_slot: 6, operation_generation: 7, next_request_token: 11)

describe "SOSIX positioned dispatcher owner seam v1":
    it "threads registry mutation and request identity through an injected owner":
        val state = sosix_fs_dispatch_positioned_with_owner_v1(
            sosix_fs_positioned_syscall_args_v1(
                SOSIX_FS_PREAD_REGISTERED_V1, 41, 73,
                0x0000000900000004, 1, 0, 1),
            true, 42, _owner(), OwnerBackend(bytes: [10, 20]))

        expect(state.accepted).to_be(true)
        expect(state.result.value).to_equal(1)
        expect(state.owner.registry_owner.registry.buffers[0].bytes).to_equal([20, 0])
        expect(state.owner.next_request_token).to_equal(12)

    it "fails closed without consuming identity when caller authentication fails":
        val state = sosix_fs_dispatch_positioned_with_owner_v1(
            sosix_fs_positioned_syscall_args_v1(
                SOSIX_FS_PREAD_REGISTERED_V1, 41, 73,
                0x0000000900000004, 0, 0, 1),
            false, 42, _owner(), OwnerBackend(bytes: [10]))

        expect(state.accepted).to_be(false)
        expect(state.result.value).to_equal(-13)
        expect(state.owner.next_request_token).to_equal(11)

    it "fails closed when the injected lifecycle owner is not ready":
        var owner = _owner()
        owner.registry_owner.service_generation = 0
        val state = sosix_fs_dispatch_positioned_with_owner_v1(
            SyscallArgs(id: 134, arg0: 41, arg1: 73, arg2: 0,
                arg3: 0, arg4: 0, arg5: 1),
            true, 42, owner, OwnerBackend(bytes: [10]))

        expect(state.accepted).to_be(false)
        expect(state.reason).to_equal("positioned-dispatch-owner-not-ready")
        expect(state.result.value).to_equal(-95)
