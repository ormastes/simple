# @cover src/os/sosix/containment_v1.spl 90%
use std.spec.{describe, it, expect}
use std.common.contracts.sosix.containment_v1.{SosixContainRequestV1, SosixContainLimitsV1, SosixContainBytesV1, SosixContainCountV1, SosixContainCpuRateV1, SosixContainMillisV1, SosixContainFlagV1}
use os.sosix.containment_v1.{simpleos_contain_map_request_v1, simpleos_contain_support_v1}

val DIGEST = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn _request(memory: i64, processes: i64, cpu: i64, network: text, pids: bool, root: text) -> SosixContainRequestV1:
    SosixContainRequestV1(program: "/user/app.smf", program_digest: DIGEST, args: ["app"], environment: ["A=1"],
        directory: "/user", stdout_path: "", stderr_path: "",
        limits: SosixContainLimitsV1(memory: SosixContainBytesV1(memory), processes: SosixContainCountV1(processes),
            cpu_rate: SosixContainCpuRateV1(cpu), wall: SosixContainMillisV1(0)),
        identity: "inherit", scope: "", network: network, readonly_dirs: [], writable_dirs: [],
        private_pids: SosixContainFlagV1(pids), root_dir: root)

describe "SimpleOS containment body v1":
    it "maps memory and pids onto ResourceDomain":
        val mapped = simpleos_contain_map_request_v1(_request(1048576, 8, 0, "host", false, ""))
        expect(mapped.accepted.value).to_be(true)
        expect(mapped.domain.mem.value).to_equal(1048576)
        expect(mapped.domain.pids.value).to_equal(8)

    it "maps no limit to zero":
        val mapped = simpleos_contain_map_request_v1(_request(0, 0, 0, "host", false, ""))
        expect(mapped.accepted.value).to_be(true)
        expect(mapped.domain.mem.value).to_equal(0)

    it "refuses each unmapped axis with its gap":
        expect(simpleos_contain_map_request_v1(_request(0, 0, 500, "host", false, "")).reason).to_equal("containment-cpu-rate-unsupported")
        expect(simpleos_contain_map_request_v1(_request(0, 0, 0, "none", false, "")).reason).to_equal("containment-network-isolation-unsupported")
        expect(simpleos_contain_map_request_v1(_request(0, 0, 0, "host", true, "")).reason).to_equal("containment-pid-isolation-unsupported")
        expect(simpleos_contain_map_request_v1(_request(0, 0, 0, "host", false, "/r")).reason).to_equal("containment-root-remap-unsupported")

    it "refuses write confinement":
        var request = _request(0, 0, 0, "host", false, "")
        request.identity = "restricted"
        request.scope = "box"
        expect(simpleos_contain_map_request_v1(request).reason).to_equal("containment-write-confinement-unsupported")

    it "refuses an invalid request":
        expect(simpleos_contain_map_request_v1(_request(-1, 0, 0, "host", false, "")).reason).to_equal("containment-request-invalid")

    it "reports every axis false":
        val support = simpleos_contain_support_v1()
        expect(support.memory_hard_limit.value).to_be(false)
        expect(support.process_limit.value).to_be(false)
        expect(support.cpu_rate_limit.value).to_be(false)
        expect(support.kill_all_descendants.value).to_be(false)
        expect(support.write_confinement.value).to_be(false)
        expect(support.read_confinement.value).to_be(false)
        expect(support.network_isolation.value).to_be(false)
        expect(support.pid_isolation.value).to_be(false)
        expect(support.root_remap.value).to_be(false)
        expect(support.unprivileged.value).to_be(false)

    it "refuses a wall deadline":
        var request = _request(0, 0, 0, "host", false, "")
        request.limits.wall = SosixContainMillisV1(1000)
        expect(simpleos_contain_map_request_v1(request).reason).to_equal("containment-deadline-unsupported")
