# @cover src/os/sosix/qemu_evidence/matrix_contract.spl 90%
use std.spec
use os.sosix.qemu_evidence.matrix_contract.{sosix_qemu_bundle_admission_from_collector_record}

# The collector-record parser is closed over manifest_version=1; a version-2
# record (the shape an earlier draft of this spec exercised through the never
# landed `sosix_qemu_v2_structural_admission_parse`) must be refused, never
# partially admitted.
fn _v2_admission_record() -> text:
    "manifest_version=2\n" +
    "status=pass\n" +
    "evidence_sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n" +
    "artifact_count=8\n" +
    "firmware_mode=direct-kernel\n"

describe "SOSIX QEMU collector record version contract":
    it "refuses a manifest_version=2 record without granting trust":
        val parsed = sosix_qemu_bundle_admission_from_collector_record(_v2_admission_record())
        expect(parsed.structurally_valid).to_be(false)
        expect(parsed.receipt.artifact_count).to_equal(0)

    it "refuses an empty record":
        expect(sosix_qemu_bundle_admission_from_collector_record("").structurally_valid).to_be(false)
