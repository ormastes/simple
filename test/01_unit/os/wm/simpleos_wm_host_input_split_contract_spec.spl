use std.spec.{describe, it, expect, to_equal, to_contain}
use std.spec.step
use std.fs.file.{file_read_text}

describe "SimpleOS WM host architecture-neutral input split":
    it "keeps x86 port I/O outside the shared surface and present owner":
        step("Inspect the shared host and explicit adapter boundaries")
        val host = file_read_text("src/os/services/wm/wm_host_2d_simpleos.spl")
        val adapter = file_read_text("src/os/services/wm/simpleos_wm_input_adapter.spl")
        val x86 = file_read_text("src/os/services/wm/simpleos_wm_input_x86_ps2.spl")
        expect(host.contains("x86_port_inb")).to_equal(false)
        expect(host.contains("x86_port_outb")).to_equal(false)
        expect(host).to_contain("input: SimpleOsWmInputAdapter")
        expect(host).to_contain("self.input.poll()")
        expect(adapter.contains("x86_port_inb")).to_equal(false)
        expect(adapter).to_contain("wm_host_no_event(\"input-unavailable\")")
        expect(x86).to_contain("x86_port_inb")
        expect(x86).to_contain("simpleos_wm_input_adapter(\"x86-ps2\", _poll)")

    it "requires the x86 evidence entry to select PS/2 explicitly":
        step("Inspect the x86 assembly edge")
        val entry = file_read_text("examples/09_embedded/simple_os/arch/x86_64/wm_host_seam_entry.spl")
        expect(entry).to_contain("wm_host_2d_simpleos_x86_ps2(fb)")
