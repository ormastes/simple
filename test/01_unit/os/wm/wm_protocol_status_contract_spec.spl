use std.spec
use common.window_protocol.window_protocol.{WM_STATUS_OK, WM_STATUS_ERROR, WM_STATUS_NO_SPACE}

describe "WM response status contract":
    it "keeps the stable wire status values":
        expect(WM_STATUS_OK.value).to_equal(0)
        expect(WM_STATUS_ERROR.value).to_equal(-1)
        expect(WM_STATUS_NO_SPACE.value).to_equal(-2)
