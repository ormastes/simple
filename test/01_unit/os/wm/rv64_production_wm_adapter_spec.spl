# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use os.compositor.rv64_wm_present_receipt.{rv64_wm_engine2d_present_receipt}
use os.services.wm.rv64_production_wm_adapter.{
    Rv64WmProcessLiveness,
    Rv64ProductionWmAdapter,
    rv64_wm_task_state_alive
}


fn live_process(process_id: u64) -> Rv64WmProcessLiveness:
    Rv64WmProcessLiveness(process_id: process_id, queried: true, alive: true, reason: "live")

describe "RV64 production WM ownership adapter":
    # @manual scenario evidence
    it "correlates a live process to its first Engine2D present":
        # @req REQ-SSPEC-OS
        step("correlates a live process to its first Engine2D present")
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_process(live_process(41u64))
        val receipt = rv64_wm_engine2d_present_receipt(41u64, 41u64, 7, 7)
        adapter.observe_first_present(receipt)
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(true)
        expect(verdict.failed).to_equal(false)
        expect(verdict.process_id).to_equal(41u64)
        expect(verdict.first_present_revision).to_equal(7)
        expect(verdict.reason).to_equal("wm-process-owned-frame-ready")

    it "fails when presentation arrives before process liveness":
        # @req REQ-SSPEC-OS
        step("fails when presentation arrives before process liveness")
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_first_present(rv64_wm_engine2d_present_receipt(41u64, 41u64, 7, 7))
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(false)
        expect(verdict.failed).to_equal(true)
        expect(verdict.reason).to_equal("present-before-process-live")

    it "fails an owner mismatch before readiness":
        # @req REQ-SSPEC-OS
        step("fails an owner mismatch before readiness")
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_process(live_process(41u64))
        adapter.observe_first_present(rv64_wm_engine2d_present_receipt(41u64, 99u64, 7, 7))
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(false)
        expect(verdict.failed).to_equal(true)
        expect(verdict.reason).to_equal("window-owner-mismatch")

    it "fails an Engine2D revision mismatch before readiness":
        # @req REQ-SSPEC-OS
        step("fails an Engine2D revision mismatch before readiness")
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_process(live_process(41u64))
        adapter.observe_first_present(rv64_wm_engine2d_present_receipt(41u64, 41u64, 7, 6))
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(false)
        expect(verdict.failed).to_equal(true)
        expect(verdict.reason).to_equal("present-revision-mismatch")

    it "fails a duplicate first-present receipt":
        # @req REQ-SSPEC-OS
        step("fails a duplicate first-present receipt")
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_process(live_process(41u64))
        val receipt = rv64_wm_engine2d_present_receipt(41u64, 41u64, 7, 7)
        adapter.observe_first_present(receipt)
        adapter.observe_first_present(receipt)
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(false)
        expect(verdict.failed).to_equal(true)
        expect(verdict.reason).to_equal("duplicate-present-receipt")

    it "continues observing owner liveness after first presentation":
        var adapter = Rv64ProductionWmAdapter.create(41u64)
        adapter.observe_process(live_process(41u64))
        adapter.observe_first_present(rv64_wm_engine2d_present_receipt(41u64, 41u64, 7, 7))
        adapter.observe_process(Rv64WmProcessLiveness(
            process_id: 41u64, queried: true, alive: false, reason: "process-preparing-exit"
        ))
        val verdict = adapter.verdict()
        expect(verdict.ready).to_equal(false)
        expect(verdict.failed).to_equal(true)
        expect(verdict.reason).to_equal("process-preparing-exit")

    it "rejects zombie and PreparingExit task states as live owners":
        expect(rv64_wm_task_state_alive(0u8)).to_equal(true)
        expect(rv64_wm_task_state_alive(1u8)).to_equal(true)
        expect(rv64_wm_task_state_alive(2u8)).to_equal(true)
        expect(rv64_wm_task_state_alive(3u8)).to_equal(false)
        expect(rv64_wm_task_state_alive(4u8)).to_equal(false)
        expect(rv64_wm_task_state_alive(255u8)).to_equal(false)
