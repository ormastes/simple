use std.spec
use app.io.mod.{file_read}

describe "ARM64 production WM producer contract":
    it "launches an admitted filesystem app and requires a nonzero process owner":
        val producer = file_read("src/os/services/wm/arm64_production_wm_producer.spl")
        expect(producer).to_contain("launcher_launch_path_with_args(binary_path, args)")
        expect(producer).to_contain("if launched_pid <= 0:")
        expect(producer).to_contain("owned_scene.process_surface_count <= 0")
        expect(producer).to_contain("snapshot.owned_scene.process_id != self.process_id")

    it "pumps one publication action before snapshotting the PID-owned scene":
        val entry = file_read("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        val launch = entry.index_of("Arm64ProductionWmProducer.launch(")
        val pump = entry.index_of("wm_producer.pump_one_published_action(shell)")
        val snapshot = entry.index_of("wm_producer.snapshot_published_scene(shell)")
        expect(launch).to_be_greater_than(0)
        expect(pump).to_be_greater_than(launch)
        expect(snapshot).to_be_greater_than(pump)
        expect(entry).to_contain("published_snapshot.owned_scene.process_surface_count <= 0")
        expect(entry).to_contain("boot_monotonic_deadline_us(")
        expect(entry).to_contain("yield_()")
        expect(entry.contains("ARM64_WM_PUBLICATION_PUMP_LIMIT")).to_equal(false)

    it "revalidates process and surface ownership during every desktop turn":
        val entry = file_read("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        val loop_start = entry.index_of("while running:")
        val loop_body = entry.substring(loop_start, entry.len())
        expect(loop_body).to_contain("wm_producer.pump_one_published_action(shell)")
        expect(loop_body).to_contain("wm_producer.snapshot_published_scene(shell)")
        expect(loop_body).to_contain("live_verdict.failed")
        expect(loop_body).to_contain("live_snapshot.owned_scene.process_surface_count <= 0")

    it "renders publication-only revision changes from a fresh owned snapshot":
        val entry = file_read("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(entry).to_contain("last_published_scene_revision")
        expect(entry).to_contain("last_published_taskbar_revision")
        expect(entry).to_contain("publication_progress_count")
        expect(entry).to_contain("var changed = publication_changed")
        expect(entry).to_contain("val frame_snapshot = wm_producer.snapshot_published_scene(shell)")
        expect(entry).to_contain("frame_snapshot.owned_scene.scene")
        expect(entry).to_contain("[wm-publication-frame]")

    it "uses the shared adapter that rejects preparing-exit owners":
        val adapter = file_read("src/os/services/wm/rv64_production_wm_adapter.spl")
        expect(adapter).to_contain("TASK_STATE_CODE_PREPARING_EXIT_V1")
        expect(adapter).to_contain("process-preparing-exit")
        expect(adapter.contains("if self.failed or self.ready:")).to_equal(false)

    it "does not synthesize pid-zero desktop windows as readiness evidence":
        val entry = file_read("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(entry.contains("compositor_materialize_process_surface_scalar(")).to_equal(false)
        expect(entry).to_contain("wm_producer.process_id == 0u64")
        expect(entry).to_contain("wm_result.ready")
