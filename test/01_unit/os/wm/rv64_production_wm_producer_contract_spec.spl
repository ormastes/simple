use std.spec
use app.io.mod.{file_read}

describe "RV64 production WM snapshot and pump contract":
    it "pumps no more than one real WM action":
        val shell = file_read("src/os/desktop/shell.spl")
        val start = shell.index_of("pub me rv64_wm_pump_one_action()")
        val finish = shell.index_of("pub me rv64_wm_render_inputs_for_snapshot(")
        val body = shell.substring(start, finish)
        expect(start).to_be_greater_than(0)
        expect(finish).to_be_greater_than(start)
        expect(body).to_contain("val action = self.wm.poll_once()")
        expect(body).to_contain("self.apply_wm_action(next_action)")
        expect(body.contains("while true")).to_equal(false)

    it "binds content and taskbar inputs to an unchanged snapshot revision":
        val shell = file_read("src/os/desktop/shell.spl")
        val start = shell.index_of("pub me rv64_wm_render_inputs_for_snapshot(")
        val body = shell.substring(start, shell.len())
        val before = body.index_of("val before = rv64_process_owned_scene(")
        val content = body.index_of("self.runtime_content_frames(snapshot.scene_revision)")
        val after = body.index_of("val after = rv64_process_owned_scene(")
        expect(before).to_be_greater_than(0)
        expect(content).to_be_greater_than(before)
        expect(after).to_be_greater_than(content)
        expect(body).to_contain("before.scene_revision != snapshot.scene_revision")
        expect(body).to_contain("after.scene_revision != snapshot.scene_revision")

    it "presents the stored scene and inputs without rebuilding a revision":
        val producer = file_read("src/os/services/wm/rv64_production_wm_producer.spl")
        val snapshot_start = producer.index_of("pub me snapshot_published_scene(")
        val present_start = producer.index_of("pub me present_snapshot(")
        val present_body = producer.substring(present_start, producer.len())
        expect(snapshot_start).to_be_greater_than(0)
        expect(present_start).to_be_greater_than(snapshot_start)
        expect(present_body).to_contain("snapshot.owned_scene.scene")
        expect(present_body).to_contain("snapshot.render_inputs.content_frames")
        expect(present_body).to_contain("snapshot.owned_scene.scene_revision")
        expect(present_body.contains("rv64_process_owned_scene(")).to_equal(false)
