use std.spec
use app.io.mod.{file_read}
use common.ui.taskbar_model.{TaskbarModel}
use common.ui.window_scene.{SharedWmScene, shared_wm_background_color}
use os.compositor.engine2d_wm_frame_executor.{Engine2dWmFrameExecutor}
use os.compositor.rv64_process_owned_scene.{Rv64ProcessOwnedScene}
use os.desktop.shell.{Rv64WmShellRenderInputs}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use os.services.wm.rv64_production_wm_adapter.{Rv64ProductionWmAdapter}
use os.services.wm.rv64_production_wm_producer.{
    Rv64ProductionWmProducer,
    Rv64ProductionWmSnapshot
}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}

fn _unused_executor() -> Engine2dWmFrameExecutor:
    Engine2dWmFrameExecutor.create(
        Engine2D.create_with_backend(8, 8, "cpu"),
        FramebufferDriver.empty(),
        8,
        8,
        false
    )

describe "RV64 production WM snapshot and pump contract":
    it "pumps no more than one real WM action":
        val shell = file_read("src/os/desktop/shell.spl")
        val start = shell.index_of("pub me rv64_wm_pump_one_action()")
        val finish = shell.index_of("pub me rv64_wm_render_inputs_for_snapshot(")
        val body = shell.substring(start, finish)
        expect(start).to_be_greater_than(0)
        expect(finish).to_be_greater_than(start)
        expect(body).to_contain("val action = self.wm.poll_once()")
        expect(body).to_contain("self.apply_wm_action(next_action)")
        expect(body.contains("while true")).to_equal(false)

    it "binds content and taskbar inputs to an unchanged snapshot revision":
        val shell = file_read("src/os/desktop/shell.spl")
        val start = shell.index_of("pub me rv64_wm_render_inputs_for_snapshot(")
        val body = shell.substring(start, shell.len())
        val before = body.index_of("val before = rv64_process_owned_scene(")
        val content = body.index_of("self.runtime_content_frames_for_process(")
        val after = body.index_of("val after = rv64_process_owned_scene(")
        expect(before).to_be_greater_than(0)
        expect(content).to_be_greater_than(before)
        expect(after).to_be_greater_than(content)
        expect(body).to_contain("snapshot.scene_revision, snapshot.process_id")
        expect(body).to_contain("before.scene_revision != snapshot.scene_revision")
        expect(body).to_contain("after.scene_revision != snapshot.scene_revision")

    it "presents the stored scene and inputs without rebuilding a revision":
        val producer = file_read("src/os/services/wm/rv64_production_wm_producer.spl")
        val snapshot_start = producer.index_of("pub me snapshot_published_scene(")
        val present_start = producer.index_of("pub me present_snapshot(")
        val present_body = producer.substring(present_start, producer.len())
        expect(snapshot_start).to_be_greater_than(0)
        expect(present_start).to_be_greater_than(snapshot_start)
        expect(present_body).to_contain("snapshot.owned_scene.scene")
        expect(present_body).to_contain("snapshot.render_inputs.content_frames")
        expect(present_body).to_contain("snapshot.owned_scene.scene_revision")
        expect(present_body.contains("rv64_process_owned_scene(")).to_equal(false)

    it "rejects a ready-looking snapshot with no process-owned surface before presentation":
        val process_id = 41u64
        val scene = SharedWmScene(
            width: 8,
            height: 8,
            backend: "test",
            windows: [],
            background: shared_wm_background_color(0xff000000u32)
        )
        val owned_scene = Rv64ProcessOwnedScene(
            scene: scene,
            scene_revision: 17,
            process_id: process_id,
            process_surface_count: 0
        )
        val render_inputs = Rv64WmShellRenderInputs(
            consistent: true,
            reason: "snapshot-consistent",
            taskbar: TaskbarModel(pinned: [], running: [], tray: []),
            content_frames: [],
            taskbar_revision: 1,
            clock_label: "00:00"
        )
        val snapshot = Rv64ProductionWmSnapshot(
            ready_to_present: true,
            reason: "ready-to-present",
            owned_scene: owned_scene,
            render_inputs: render_inputs
        )
        var adapter = Rv64ProductionWmAdapter.create(process_id)
        adapter.process_live = true
        var producer = Rv64ProductionWmProducer(
            process_id: process_id,
            adapter: adapter
        )

        val verdict = producer.present_snapshot(_unused_executor(), snapshot)

        expect(verdict.failed).to_equal(true)
        expect(verdict.ready).to_equal(false)
        expect(verdict.first_present_revision).to_equal(0)
        expect(verdict.reason).to_equal("snapshot-process-mismatch")
