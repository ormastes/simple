# @cover src/os/services/vfs/vfs_dispatch.spl 80%
"""Mounted-driver whole-file reads preserve exact binary payloads."""

use std.spec.*
use std.fs_driver.instance.{DriverInstance}
use std.fs_driver.ramfs.{RamFsDriver}
use std.fs_driver.types.{MountOptions, OpenFlags, Path}
use os.services.vfs.vfs_dispatch.{g_vfs_dispatch_read_file_bytes}

fn _ramfs_payload_driver(payload: [u8]) -> DriverInstance:
    var ramfs = RamFsDriver.new()
    ramfs.mount(MountOptions.default()).unwrap()
    val path = Path(raw: "/payload.bin")
    val handle = ramfs.open(path, OpenFlags.create_write()).unwrap()
    expect(ramfs.write(handle, 0, payload).unwrap()).to_equal(payload.len() as i64)
    ramfs.close(handle).unwrap()
    DriverInstance.RamFs(ramfs)

describe "VFS dispatch whole-file bounds":
    it "returns every binary byte from an exact mounted-driver read":
        step("Create a mounted in-memory file containing binary edge bytes")
        val driver = _ramfs_payload_driver([0u8, 1u8, 127u8, 128u8, 255u8])

        step("Read the file through the production whole-file dispatcher")
        val result = g_vfs_dispatch_read_file_bytes(
            driver, Path(raw: "/payload.bin"))

        expect(result).to_equal([0u8, 1u8, 127u8, 128u8, 255u8])

