use os.kernel.types.capability_types.{CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_QUEUE_SUBMIT, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID}
use os.kernel.types.device_mem_types.{DeviceGrant, new_device_grant, device_grant_token_base, device_grant_bar_token, device_grant_irq_token, device_grant_dma_token, device_grant_iommu_token, device_grant_iommu_domain_id, device_grant_resource_set_label}


fn _tokenized_boot_grant() -> os.kernel.types.device_mem_types.DeviceGrant:
    _tokenized_grant_for_owner(0u64)

fn _tokenized_grant_for_owner(owner_task: u64) -> os.kernel.types.device_mem_types.DeviceGrant:
    var grant = new_device_grant()
    grant.pci_bus = 0u8
    grant.pci_dev = 2u8
    grant.pci_func = 0u8
    val base = device_grant_token_base(grant.pci_bus, grant.pci_dev, grant.pci_func, owner_task)
    grant.bar0_cap = device_grant_bar_token(base)
    grant.irq_cap = device_grant_irq_token(base)
    grant.dma_cap = device_grant_dma_token(base)
    grant.iommu_cap = device_grant_iommu_token(base)
    grant.iommu_domain_id = device_grant_iommu_domain_id(grant.pci_bus, grant.pci_dev, grant.pci_func)
    grant

fn _user_evidence(grant: DeviceGrant):
    nvme_transfer_evidence(
        "simple-driver",
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        true,
        "user-space-driver",
        device_grant_resource_set_label(grant),
        "non-secure-resource-namespace",
        true,
        true
    )

fn _user_lease_for_boot_nsid(nsid: u32):
    val ns = NvmeNamespaceIdentity(
        controller_id: 0,
        nsid: nsid,
        lba_size: 512,
        lba_count: 65536,
        eui64: 0,
        nguid_lo: 0,
        nguid_hi: 0,
        uuid_lo: 0,
        uuid_hi: 0
    )
    val queue = NvmeQueueAssignment(
        queue_id: SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID,
        role: NvmeQueueRole.Data,
        controller_id: 0,
        nsid: nsid,
        owner_task: 42,
        max_depth: 64,
        rights: CAP_RIGHT_READ + CAP_RIGHT_WRITE + CAP_RIGHT_QUEUE_SUBMIT
    )
    nvme_filesystem_lease(ns, 0u64, 1024u64, NvmeNamespaceMode.UserAssigned, queue, "simple-driver", "resource-grant-set:tok=301", true, true)

fn _valid_shared_dma_4k() -> SharedDmaBuffer:
    SharedDmaBuffer(
        cpu_virt_addr: 0x1000u64,
        host_phys_addr: 0x2000u64,
        device_addr: 0x2000u64,
        byte_len: 4096u64,
        cache_policy: DmaCachePolicy.Coherent,
        owner: DmaOwner(task_id: 42u64, bdf_bus: 0u8, bdf_device: 4u8, bdf_function: 0u8),
        allocation_id: 9u64
    )

describe "VFS boot NVMe lease contract":
    it "builds a filesystem-ready system FAT32 lease for pure Simple boot":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): builds a filesystem-ready system FAT32 lease for pure Simple boot verdict row retained for review
        step("builds a filesystem-ready system FAT32 lease for pure Simple boot")
        val lease = vfs_boot_nvme_system_fat32_lease(512u32, 65536u64, _tokenized_boot_grant())
        expect(lease.provider).to_equal("simple-driver")
        expect(lease.shared_block_interface).to_equal(true)
        expect(lease.namespace_identity.nsid).to_equal(1u32)
        expect(lease.lba_count).to_equal(65536u64)
        expect(lease.grant_kind.to_start_with("resource-grant-set:tok=")).to_equal(true)
        expect(nvme_filesystem_lease_reason(lease, NvmeFilesystemConsumer.Fat32)).to_equal("ready")

    it "keeps invalid namespace geometry rejected before FAT32 can mount":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): keeps invalid namespace geometry rejected before FAT32 can mount verdict row retained for review
        step("keeps invalid namespace geometry rejected before FAT32 can mount")
        val lease = vfs_boot_nvme_system_fat32_lease(0u32, 65536u64, _tokenized_boot_grant())
        expect(nvme_filesystem_lease_reason(lease, NvmeFilesystemConsumer.Fat32)).to_equal("nvme-fs-namespace-invalid-lba-size")

    it "builds production boot FAT32 leases only from ready transfer evidence":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): builds production boot FAT32 leases only from ready transfer evidence verdict row retained for review
        step("builds production boot FAT32 leases only from ready transfer evidence")
        val ready = nvme_transfer_evidence(
            "simple-driver",
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            true,
            "system-driver",
            "kernel-owned-resource",
            "system-kernel-namespace",
            true,
            true
        )
        val missing_write = nvme_transfer_evidence(
            "simple-driver",
            true,
            true,
            true,
            true,
            true,
            true,
            false,
            true,
            true,
            "system-driver",
            "kernel-owned-resource",
            "system-kernel-namespace",
            true,
            true
        )

        val lease = vfs_boot_nvme_system_fat32_lease_from_transfer_evidence(512u32, 65536u64, ready).unwrap()
        val rejected = vfs_boot_nvme_system_fat32_lease_from_transfer_evidence(512u32, 65536u64, missing_write)
        expect(lease.provider).to_equal("simple-driver")
        expect(nvme_filesystem_lease_reason(lease, NvmeFilesystemConsumer.Fat32)).to_equal("ready")
        expect(rejected.unwrap_err()).to_equal("nvme-fs-transfer-not-ready:missing-nvme-sector-write")

    it "uses hardware transfer evidence before mounting the pure Simple boot FAT32 lease":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): uses hardware transfer evidence before mounting the pure Simple boot FAT32 lease verdict row retained for review
        step("uses hardware transfer evidence before mounting the pure Simple boot FAT32 lease")
        # @req REQ-SSPEC-OS
        step("uses hardware transfer evidence before mounting the pure Simple boot FAT32 lease")
        val source = (read_file("src/os/services/vfs/vfs_boot_init.spl") + read_file("src/os/services/vfs/vfs_boot_core.spl") + read_file("src/os/services/vfs/vfs_boot_state.spl") + read_file("src/os/services/vfs/vfs_ambient_context.spl") + read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl") + read_file("src/os/services/vfs/nvme_filesystem_direct_io.spl") + read_file("src/os/services/vfs/nvme_q35_lease_perf.spl") + read_file("src/os/services/vfs/direct_fat32_boot_reader.spl"))
        val pins_val_transfer_evidence_result_g_nvme_tran = source.contains("val transfer_evidence_result = g_nvme.transfer_evidence_from_reversible_probe(")
        expect(pins_val_transfer_evidence_result_g_nvme_tran).to_equal(true)
        val pins_system_driver = source.contains("\"system-driver\"")
        expect(pins_system_driver).to_equal(true)
        val pins_kernel_owned_resource = source.contains("\"kernel-owned-resource\"")
        expect(pins_kernel_owned_resource).to_equal(true)
        val pins_system_kernel_namespace = source.contains("\"system-kernel-namespace\"")
        expect(pins_system_kernel_namespace).to_equal(true)
        val pins_vfs_boot_nvme_system_fat32_lease_from_tr = source.contains("vfs_boot_nvme_system_fat32_lease_from_transfer_evidence(")
        expect(pins_vfs_boot_nvme_system_fat32_lease_from_tr).to_equal(true)
        val pins_g_vfs_nvme_active_leases_lease = source.contains("g_vfs_nvme_active_leases = [lease]")
        expect(pins_g_vfs_nvme_active_leases_lease).to_equal(true)
        val pins_g_vfs_nvme_direct_adapter_leases_lease = source.contains("g_vfs_nvme_direct_adapter_leases = [lease]")
        expect(pins_g_vfs_nvme_direct_adapter_leases_lease).to_equal(true)
        val pins_pure_simple_nvme_evidence_lease_policy_d = source.contains("pure-Simple NVMe evidence lease policy degraded")
        expect(pins_pure_simple_nvme_evidence_lease_policy_d).to_equal(true)
        val pins_nvmeblockadapter_for_identified_namespac = source.contains("NvmeBlockAdapter.for_identified_namespace_unchecked(")
        expect(pins_nvmeblockadapter_for_identified_namespac).to_equal(true)

    it "records boot NVMe leases and rejects later user assignment of the same namespace":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): records boot NVMe leases and rejects later user assignment of the same namespace verdict row retained for review
        step("records boot NVMe leases and rejects later user assignment of the same namespace")
        vfs_boot_nvme_reset_active_leases_for_test()
        val system_lease = vfs_boot_nvme_system_fat32_lease(512u32, 65536u64, _tokenized_boot_grant())
        val conflicting_user = _user_lease_for_boot_nsid(1u32)
        val other_user = _user_lease_for_boot_nsid(12u32)

        expect(vfs_boot_nvme_record_active_lease_for_test(system_lease)).to_equal("ready")
        expect(vfs_boot_nvme_active_lease_count_for_test()).to_equal(1u64)
        expect(vfs_boot_nvme_active_lease_acceptance_reason(conflicting_user)).to_equal("nvme-fs-namespace-mode-conflict:system:user-assigned")
        expect(vfs_boot_nvme_active_lease_acceptance_reason(other_user)).to_equal("ready")
        vfs_boot_nvme_reset_active_leases_for_test()

    it "assigns user namespaces through the active VFS lease registry":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): assigns user namespaces through the active VFS lease registry verdict row retained for review
        step("assigns user namespaces through the active VFS lease registry")
        vfs_boot_nvme_reset_active_leases_for_test()
        val boot_lease = vfs_boot_nvme_system_fat32_lease(512u32, 65536u64, _tokenized_boot_grant())
        val grant = _tokenized_grant_for_owner(42u64)
        val evidence = _user_evidence(grant)

        expect(vfs_boot_nvme_record_active_lease_for_test(boot_lease)).to_equal("ready")
        val conflict = vfs_boot_nvme_assign_user_namespace_lease(evidence, grant, 0u32, 1u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, 42u64, 64u16, NvmeFilesystemConsumer.Nvfs)
        val assigned = vfs_boot_nvme_assign_user_namespace_lease(evidence, grant, 0u32, 12u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, 42u64, 64u16, NvmeFilesystemConsumer.Dbfs)

        expect(conflict.unwrap_err()).to_equal("nvme-fs-namespace-mode-conflict:system:user-assigned")
        expect(assigned.is_ok()).to_equal(true)
        expect(vfs_boot_nvme_active_lease_count_for_test()).to_equal(2u64)
        vfs_boot_nvme_reset_active_leases_for_test()

    it "creates user namespace driver instances only after active-lease admission":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): creates user namespace driver instances only after active-lease admission verdict row retained for review
        step("creates user namespace driver instances only after active-lease admission")
        vfs_boot_nvme_reset_active_leases_for_test()
        val boot_lease = vfs_boot_nvme_system_fat32_lease(512u32, 65536u64, _tokenized_boot_grant())
        val grant = _tokenized_grant_for_owner(42u64)
        val evidence = _user_evidence(grant)

        expect(vfs_boot_nvme_record_active_lease_for_test(boot_lease)).to_equal("ready")
        val conflict = vfs_boot_nvme_assign_user_namespace_driver_instance("user-fat", MemBlockDevice.new(1024u64, 512u32), evidence, grant, 0u32, 1u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, 42u64, 64u16, NvmeFilesystemConsumer.Fat32)
        expect(conflict.unwrap_err()).to_equal("nvme-fs-namespace-mode-conflict:system:user-assigned")
        expect(vfs_boot_nvme_active_lease_count_for_test()).to_equal(1u64)

        val mounted = vfs_boot_nvme_assign_user_namespace_driver_instance("user-fat", MemBlockDevice.new(1024u64, 512u32), evidence, grant, 0u32, 13u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, 42u64, 64u16, NvmeFilesystemConsumer.Fat32)
        expect(mounted.is_ok()).to_equal(true)
        expect(vfs_boot_nvme_active_lease_count_for_test()).to_equal(2u64)
        vfs_boot_nvme_reset_active_leases_for_test()

    it "keeps generic user namespace driver instances off the NVMe DirectIo adapter registry":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): keeps generic user namespace driver instances off the NVMe DirectIo adapter registry verdict row retained for review
        step("keeps generic user namespace driver instances off the NVMe DirectIo adapter registry")
        # @req REQ-SSPEC-OS
        step("keeps generic user namespace driver instances off the NVMe DirectIo adapter registry")
        val source = (read_file("src/os/services/vfs/vfs_boot_init.spl") + read_file("src/os/services/vfs/vfs_boot_core.spl") + read_file("src/os/services/vfs/vfs_boot_state.spl") + read_file("src/os/services/vfs/vfs_ambient_context.spl") + read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl") + read_file("src/os/services/vfs/nvme_filesystem_direct_io.spl") + read_file("src/os/services/vfs/nvme_q35_lease_perf.spl") + read_file("src/os/services/vfs/direct_fat32_boot_reader.spl"))
        val generic_pos = source.index_of("fn vfs_boot_nvme_assign_user_namespace_driver_instance(")
        val hardware_pos = source.index_of("fn vfs_boot_nvme_assign_user_namespace_hardware_driver_instance(")
        val generic_body = source.substring(generic_pos, hardware_pos)

        expect(generic_body.contains("vfs_nvme_buffered_driver_instance_for_lease(name, dev, lease, consumer)")).to_equal(true)
        expect(generic_body.contains("vfs_nvme_driver_instance_for_lease(name, dev, lease, consumer)")).to_equal(false)
        expect(generic_body.contains("g_vfs_nvme_direct_adapters = g_vfs_nvme_direct_adapters.push")).to_equal(false)

    it "rejects a second user driver instance for the same namespace with a different grant":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): rejects a second user driver instance for the same namespace with a different grant verdict row retained for review
        step("rejects a second user driver instance for the same namespace with a different grant")
        vfs_boot_nvme_reset_active_leases_for_test()
        val grant = _tokenized_grant_for_owner(42u64)
        val other_grant = _tokenized_grant_for_owner(43u64)
        val evidence = _user_evidence(grant)
        val other_evidence = _user_evidence(other_grant)

        val mounted = vfs_boot_nvme_assign_user_namespace_driver_instance("user-nvfs", MemBlockDevice.new(1024u64, 512u32), evidence, grant, 0u32, 21u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, 42u64, 64u16, NvmeFilesystemConsumer.Nvfs)
        val conflict = vfs_boot_nvme_assign_user_namespace_driver_instance("user-dbfs", MemBlockDevice.new(1024u64, 512u32), other_evidence, other_grant, 0u32, 21u32, 512u32, 65536u64, 0u64, 1024u64, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID + 1u16, 43u64, 64u16, NvmeFilesystemConsumer.Dbfs)

        expect(mounted.is_ok()).to_equal(true)
        expect(conflict.unwrap_err()).to_equal("nvme-fs-user-namespace-grant-conflict")
        expect(vfs_boot_nvme_active_lease_count_for_test()).to_equal(1u64)
        vfs_boot_nvme_reset_active_leases_for_test()

    it "routes production user namespace mounts through the pure Simple NVMe block adapter":
        # @req REQ-SSPEC-OS
        # @capture(bit_table): routes production user namespace mounts through the pure Simple NVMe block adapter verdict row retained for review
        step("routes production user namespace mounts through the pure Simple NVMe block adapter")
        # @req REQ-SSPEC-OS
        step("routes production user namespace mounts through the pure Simple NVMe block adapter")
        val source = (read_file("src/os/services/vfs/vfs_boot_init.spl") + read_file("src/os/services/vfs/vfs_boot_core.spl") + read_file("src/os/services/vfs/vfs_boot_state.spl") + read_file("src/os/services/vfs/vfs_ambient_context.spl") + read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl") + read_file("src/os/services/vfs/nvme_filesystem_direct_io.spl") + read_file("src/os/services/vfs/nvme_q35_lease_perf.spl") + read_file("src/os/services/vfs/direct_fat32_boot_reader.spl"))
        val lease_check_pos = source.index_of("val lease_result = nvme_user_assigned_filesystem_lease_from_grant_checked(")
        val identify_pos = source.index_of("val identify = g_nvme.identify_namespace_id(lease.namespace_identity.nsid)")
        val queue_pos = source.index_of("val queue_ready = g_nvme.ensure_user_data_queue_for_assignment(")
        val adapter_pos = source.index_of("val adapter_result = NvmeBlockAdapter.for_filesystem_lease(g_nvme, lease, consumer)")
        val pins_fn_vfs_boot_nvme_assign_user_namespace_h = source.contains("fn vfs_boot_nvme_assign_user_namespace_hardware_driver_instance(")
        expect(pins_fn_vfs_boot_nvme_assign_user_namespace_h).to_equal(true)
        val pins_fn_vfs_boot_nvme_assign_discovered_user = source.contains("fn vfs_boot_nvme_assign_discovered_user_namespace_hardware_driver_instance(")
        expect(pins_fn_vfs_boot_nvme_assign_discovered_user).to_equal(true)
        val pins_fn_vfs_boot_nvme_system_namespace_nsid_f = source.contains("fn vfs_boot_nvme_system_namespace_nsid_for_user_assignment() -> u32:")
        expect(pins_fn_vfs_boot_nvme_system_namespace_nsid_f).to_equal(true)
        val pins_if_lease_mode_nvmenamespacemode_system = source.contains("if lease.mode == NvmeNamespaceMode.System:")
        expect(pins_if_lease_mode_nvmenamespacemode_system).to_equal(true)
        val pins_val_system_nsid_vfs_boot_nvme_system_nam = source.contains("val system_nsid = vfs_boot_nvme_system_namespace_nsid_for_user_assignment()")
        expect(pins_val_system_nsid_vfs_boot_nvme_system_nam).to_equal(true)
