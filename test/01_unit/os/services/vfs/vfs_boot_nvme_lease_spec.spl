        expect(pins_nvme_user_assign_probe_release_failed).to_equal(true)
        val pins_val_driver_ready_vfs_boot_nvme_shared_dr = source.contains("val driver_ready = vfs_boot_nvme_shared_driver_ready_for_user_assignment()")
        expect(pins_val_driver_ready_vfs_boot_nvme_shared_dr).to_equal(true)
        val pins_return_err_driver_ready = source.contains("return Err(driver_ready)")
        expect(pins_return_err_driver_ready).to_equal(true)
