"""
# ARM filesystem-exec root routing contract

The ARM64 QEMU acceptance image stages `FSEXEC.ELF` at the FAT32 root.
Retained guest traces showed that request incorrectly entering the
`/SYS/APPS/` lookup path. This static freestanding contract keeps exact root
files ahead of prefix routing and requires all root scans to use BPB geometry.
"""

use std.spec
use app.io.mod.{file_read}

val ARM_FS_EXEC_VFS = "src/os/services/vfs/arm_fs_exec_vfs.spl"
val ARM64_BAREMETAL_RUNTIME = "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"

describe "ARM filesystem-exec root routing":
    it "routes exact root-staged files before SYS/APPS prefix matching":
        val source = file_read(ARM_FS_EXEC_VFS)
        val root_route = source.index_of(
            "if route >= 1 and route <= 4:")
        val apps_route = source.index_of("if route == 10:")
        expect(root_route > 0).to_be(true)
        expect(apps_route > root_route).to_be(true)

    it "maps the exact root nonce filename and rejects an app alias":
        val aliases = file_read("src/os/services/vfs/arm_fs_exec_alias.spl")
        expect(aliases).to_contain(
            "case \"/QEMUNONC.TXT\":\n            \"/QEMUNONC.TXT\"")
        expect(aliases).to_contain(
            "case \"/QEMUNONC.TXT\":\n            \"QEMUNONC.TXT\"")
        expect(aliases.index_of("/SYS/APPS/QEMUNONC")).to_equal(-1)

    it "keeps hello-world on the canonical SYS/APPS media route":
        val source = file_read(ARM_FS_EXEC_VFS)
        val aliases = file_read("src/os/services/vfs/arm_fs_exec_alias.spl")
        expect(aliases).to_contain(
            "case \"/sys/apps/hello_world.smf\":\n            \"/SYS/APPS/HELLOSMF.SMF\"")
        expect(source).to_contain(
            "executable FAT32 read probe failed path=/SYS/APPS/HELLOSMF.SMF")
        expect(source).to_contain(
            "if route == 10:")
        expect(source.index_of("if mapped == \"/HELLOSMF.SMF\":" )).to_equal(-1)

    it "scans exact root files through the BPB-derived root cluster":
        val source = file_read(ARM_FS_EXEC_VFS)
        expect(source).to_contain(
            "return _arm_fat32_read_short_name_from_dir(dev, _arm_root_cluster(), short_name)")
        expect(source).to_contain("if g_arm_root_cluster >= 2:")

    it "retains the explicit FAT 8.3 FSEXEC short-name contract":
        val aliases = file_read("src/os/services/vfs/arm_fs_exec_alias.spl")
        val dirents = file_read("src/os/services/vfs/arm_fs_exec_dirent.spl")
        expect(aliases).to_contain("case \"/FSEXEC.ELF\":")
        expect(aliases).to_contain("\"FSEXEC.ELF\"")
        expect(dirents).to_contain("case \"FSEXEC.ELF\":")
        expect(dirents).to_contain("# ARM64 acceptance payload staged at the FAT root as \"FSEXEC  ELF\".")

    it "defines the two runtime symbols fabricated in the retained ELF":
        val runtime = file_read(ARM64_BAREMETAL_RUNTIME)
        expect(runtime).to_contain("RuntimeValue rt_array_copy(RuntimeValue arr)")
        expect(runtime).to_contain("RuntimeValue rt_enum_id(RuntimeValue value)")
