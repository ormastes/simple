# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



# Regression coverage for the perf-timing helpers shared between
# q35_pure_nvme_perf_boot.spl and vfs_boot_init.spl. Both files used to carry
# byte-identical copies of `_elapsed_us`/`_iops`; vfs_boot_init.spl now
# imports the q35_pure_nvme_perf_boot.spl originals instead of redefining
# them. This spec asserts the real behavior of the shared functions (not
# just their existence) and that the duplicate definitions are gone.

use std.spec.step

use std.spec.{describe, it, expect}

extern fn rt_time_now_unix_micros() -> i64
use os.services.vfs.q35_pure_nvme_perf_boot.{_elapsed_us, _iops}

describe "q35 perf timing helpers shared across vfs boot files":
    # @manual scenario evidence
    it "computes elapsed microseconds from start/end timestamps":
        # @req REQ-SSPEC-OS
        step("computes elapsed microseconds from start/end timestamps")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        expect(_elapsed_us(1000i64, 1500i64)).to_equal(500u64)
        expect(_elapsed_us(0i64, 1000000i64)).to_equal(1000000u64)

    it "clamps elapsed microseconds to 1 when end does not advance past start":
        # @req REQ-SSPEC-OS
        step("clamps elapsed microseconds to 1 when end does not advance past start")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        expect(_elapsed_us(1000i64, 1000i64)).to_equal(1u64)
        expect(_elapsed_us(1000i64, 500i64)).to_equal(1u64)

    it "computes IOPS from an op count and elapsed microseconds":
        # @req REQ-SSPEC-OS
        step("computes IOPS from an op count and elapsed microseconds")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        expect(_iops(1000u64, 1000000u64)).to_equal(1000u64)
        expect(_iops(4000u64, 500000u64)).to_equal(8000u64)

    it "clamps IOPS to 1 for a zero elapsed window or a zero-valued result":
        # @req REQ-SSPEC-OS
        step("clamps IOPS to 1 for a zero elapsed window or a zero-valued result")
        # evidence(protocol_json): asserted result fields below are the complete typed oracle
        expect(_iops(1000u64, 0u64)).to_equal(1u64)
        expect(_iops(1u64, 1000000000u64)).to_equal(1u64)

    it "measures a real wall-clock window with the shared helpers":
        # @req REQ-SSPEC-OS
        step("run the helpers over live timestamps bracketing actual work")
        # evidence(protocol_json): elapsed/iops values asserted below are the complete typed oracle
        val start = rt_time_now_unix_micros()
        var i = 0
        while i < 100000:
            i = i + 1
        val end = rt_time_now_unix_micros()
        val elapsed = _elapsed_us(start, end)
        expect(elapsed > 0u64).to_equal(true)  # oracle: a real busy loop must take nonzero time per the shared clock helper
        expect(_iops(100000u64, elapsed) > 0u64).to_equal(true)  # oracle: derived IOPS from a measured window must be positive
