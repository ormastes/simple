"""The root VFS payload carries a concrete Filesystem implementation."""

use std.spec.{describe, it, expect}
use os.services.vfs.vfs_service_main.{BrokeredFat32Filesystem}
use os.services.vfs.vfs_block_adapters.{NvmeBlockAdapter}
use os.drivers.nvme.nvme_driver.{NvmeDriver}

describe "brokered VFS payload contract":
    it "constructs a concrete filesystem adapter without a boot singleton":
        val adapter = NvmeBlockAdapter.new(NvmeDriver.new())
        val fs = BrokeredFat32Filesystem.new(adapter)
        expect(fs.fs_name()).to_equal("fat32-brokered")

    it "provides non-following metadata and rejects FAT32 links":
        val adapter = NvmeBlockAdapter.new(NvmeDriver.new())
        val fs = BrokeredFat32Filesystem.new(adapter)
        expect(fs.stat_no_follow("/missing").unwrap_err()).to_equal("filesystem not mounted")
        expect(fs.readlink("/missing").unwrap_err()).to_equal("FAT32 readlink unsupported")
