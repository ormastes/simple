use std.spec.{describe, it, expect}

describe "VFS service owned IPC transport":
    it "creates its named endpoint and receives copied records":
        val source = file_read("src/os/services/vfs/vfs_service.spl")
        expect(source).to_contain("ipc_create_named_port(\"vfs\")")
        expect(source).to_contain("ipc_recv_owned_v1_into(self.port_id, self.receive_buffer)")
        expect(source).to_contain("self.dispatch_catalogue_owned_record(self.receive_buffer.ptr() as u64, received.unwrap())")
        expect(source).to_contain("if payload_len.to_u64() > record_len - IPC_OWNED_V1_HEADER_BYTES:")
        expect(source.contains("SYS_IPC_RECV")).to_equal(false)

    it "selects checked replies only for requests that minted a permit":
        val source = file_read("src/os/services/vfs/vfs_service.spl")
        expect(source).to_contain("if flags != 0u32 and flags != (IpcFlags.Async as u32):")
        expect(source).to_contain("self.reply_owned = flags == (IpcFlags.Async as u32)")
        expect(source).to_contain("if self.reply_owned:")
        expect(source).to_contain("ipc_reply_owned_v1(dst_port, 0u32, data, self.port_id)")
        expect(source).to_contain("syscall(SYS_IPC_SEND, dst_port, src_port, data_ptr, data_len, IPC_COPIED_SERVICE_TAG)")
        expect(source).to_contain("while self.running:")
        expect(source).to_contain("syscall(SYS_YIELD")

    it "rejects legacy requests in the PID1 catalogue service":
        val source = file_read("src/os/services/vfs/vfs_service.spl")
        val entry = file_read("src/os/services/vfs/vfs_service_main.spl")
        expect(source).to_contain("me start_catalogue_owned() -> bool:")
        expect(source).to_contain("self.accept_legacy_requests = false")
        expect(source).to_contain("if flags == 0u32 and not self.accept_legacy_requests:")
        expect(entry).to_contain("service.start_catalogue_owned()")
