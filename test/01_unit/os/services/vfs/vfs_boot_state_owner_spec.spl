use std.spec.*
use std.fs.*

describe "VFS boot state owner":
    it "keeps canonical class-global mutation in the declaring module":
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val core = read_file("src/os/services/vfs/vfs_boot_core.spl")
        val ambient = read_file("src/os/services/vfs/vfs_ambient_context.spl")
        val runtime = read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl")
        val init = read_file("src/os/services/vfs/vfs_init.spl")
        val writes = read_file("src/os/services/vfs/vfs_write_ops.spl")
        val positioned = read_file("src/os/services/vfs/vfs_positioned_ops.spl")
        expect(owner).to_contain("var g_vfs: VfsManager")
        expect(owner).to_contain("g_vfs = manager")
        expect(owner).to_contain("g_mount_table = MountTable.new()")
        expect(owner).to_contain("use std.fs_driver.mount_table.{MountTable, MountId}")
        expect(owner.contains("g_mount_table.mount(")).to_equal(false)
        expect(owner).to_contain("val canonical_mount = vfs_state_mount(")
        expect(core.contains("g_vfs =")).to_equal(false)
        expect(ambient.contains("g_vfs =")).to_equal(false)
        expect(runtime.contains("use os.services.vfs.vfs_boot_state")).to_equal(false)
        expect(init.contains("g_root_nvfs_hosted = Some(")).to_equal(false)
        expect(init.contains("g_vfs_initialized = true")).to_equal(false)
        expect(init).to_contain("vfs_state_mark_rootfs_ready()")
        expect(writes.contains("g_root_nvfs_hosted = Some(")).to_equal(false)
        expect(init.contains("g_mount_table.mount(")).to_equal(false)
        expect(writes.contains("g_mount_table.mount(")).to_equal(false)
        expect(writes.contains("g_mount_table.unmount(")).to_equal(false)
        expect(positioned.contains("g_mount_table.")).to_equal(false)
        expect(owner).to_contain("var table = g_mount_table")
        expect(owner).to_contain("g_mount_table = table")
        expect(owner).to_contain("g_vfs_initialized = false")
        expect(owner).to_contain("g_vfs_boot_storage_provider = \"not-mounted\"")
        expect(owner).to_contain("g_vfs_boot_storage_pure_simple = false")
