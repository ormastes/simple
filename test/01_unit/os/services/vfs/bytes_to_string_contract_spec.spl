# Freestanding-safe byte-to-text conversion used by VfsManager.read_text.

use std.nogc_sync_mut.binary_io.{bytes_to_string}

fn ascii_bytes(value: text) -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < value.len():
        out.push(value[i].ord())
        i = i + 1
    out

describe "VFS byte-to-text conversion":
    it "preserves a staged DBFS token":
        expect(bytes_to_string(ascii_bytes("dbfsrt-token:t040400870296"))).to_equal(
            "dbfsrt-token:t040400870296")

    it "preserves the DBFS round-trip nonce":
        expect(bytes_to_string(ascii_bytes("dbfsrt-nonce:20261105040400870296"))).to_equal(
            "dbfsrt-nonce:20261105040400870296")

    it "preserves an empty input":
        expect(bytes_to_string([])).to_equal("")
