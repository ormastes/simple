use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}

describe "VFS boot font-chain allocation contract":
    it "uses a packed byte output and the proven typed-byte append ABI":
        val source = (read_file("src/os/services/vfs/vfs_boot_init.spl") + read_file("src/os/services/vfs/vfs_boot_core.spl") + read_file("src/os/services/vfs/vfs_boot_state.spl") + read_file("src/os/services/vfs/vfs_ambient_context.spl") + read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl") + read_file("src/os/services/vfs/nvme_filesystem_direct_io.spl") + read_file("src/os/services/vfs/nvme_q35_lease_perf.spl") + read_file("src/os/services/vfs/direct_fat32_boot_reader.spl"))
        val start = source.index_of("fn _vfs_boot_read_file_chain_raw")
        val finish = source.index_of("fn _vfs_boot_dirent_name11_raw")
        val body = source.substring(start, finish)

        expect(body.contains("var out: [u8] = rt_byte_array_new(size as i64)")).to_equal(true)
        expect(body.contains("rt_array_new_with_cap(size as i64)")).to_equal(false)
        expect(body.contains("rt_typed_bytes_u8_push(out, byte_value)")).to_equal(true)
        expect(body.contains("out.push(")).to_equal(false)
        expect(body.contains("rt_bytes_from_raw(")).to_equal(false)

    it "keeps per-cluster success logging out of the hot FAT read loop":
        val source = (read_file("src/os/services/vfs/vfs_boot_init.spl") + read_file("src/os/services/vfs/vfs_boot_core.spl") + read_file("src/os/services/vfs/vfs_boot_state.spl") + read_file("src/os/services/vfs/vfs_ambient_context.spl") + read_file("src/os/services/vfs/nvme_boot_runtime_owner.spl") + read_file("src/os/services/vfs/nvme_filesystem_direct_io.spl") + read_file("src/os/services/vfs/nvme_q35_lease_perf.spl") + read_file("src/os/services/vfs/direct_fat32_boot_reader.spl"))
        val start = source.index_of("fn _vfs_boot_read_cluster_to_scratch")
        val finish = source.index_of("fn _vfs_boot_read_file_chain_raw")
        val body = source.substring(start, finish)

        expect(body.contains("scalar scratch read begin")).to_equal(false)
        expect(body.contains("scalar scratch read ok")).to_equal(false)
        expect(body.contains("scalar scratch read failed cluster=")).to_equal(true)
