"""
RV64 VFS bridge provider contract.

The RV64 kernel's live root path is the VirtIO-backed FAT32 driver.  It must
not retain unresolved simpleos_fat32_* C bridge imports merely because hosted
VFS compatibility helpers are also compiled into an entry closure.
"""

use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}

describe "RV64 VFS FAT32 provider closure":
    it "selects mounted VirtIO FAT32 and rejects the unbacked C bridge":
        val bridge = read_file("src/os/services/vfs/c_nvme_block_adapter.spl")
        val vfs = read_file("src/os/services/vfs/vfs_init.spl")
        val rv64_adapter = read_file("src/os/services/vfs/riscv64_virtio_blk_adapter.spl")

        expect(bridge.contains("pub fn c_fat32_bridge_backed() -> bool: false")).to_equal(true)
        expect(bridge.contains("extern fn simpleos_fat32")).to_equal(false)
        expect(bridge.contains("target-independent\n# denial functions")).to_equal(true)
        expect(vfs.contains("c_fat32_bridge_backed()")).to_equal(true)
        expect(vfs.contains("Riscv64VirtioBlkAdapter")).to_equal(false)
        expect(rv64_adapter.contains("rt_riscv64_virtio_blk_fat32_read_sector_bytes")).to_equal(true)

    it "uses the canonical syscall wrapper for NVMe device operations":
        val ops = read_file("src/os/drivers/nvme/_NvmeDriver/driver_operations.spl")
        expect(ops.contains("use os.userlib.syscall_raw.{syscall}")).to_equal(true)
        expect(ops.contains("extern fn syscall(")).to_equal(false)
