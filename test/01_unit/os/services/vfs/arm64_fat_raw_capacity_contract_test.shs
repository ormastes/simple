#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
vfs="$root/src/os/services/vfs/arm_fs_exec_vfs.spl"
runtime="$root/examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
image="${ARM64_FAT_IMAGE:-$root/build/os/fat32-arm64.img}"

grep -q 'rt_arm_array_new_fat_cluster()' "$vfs"
! grep -q 'rt_arm_array_new_fat_cluster(spc)' "$vfs"
! grep -q 'rt_arm_array_new_with_cap_raw(spc \* 512)' "$vfs"
grep -q 'rt_arm_array_new_with_cap_raw(size)' "$vfs"
grep -q 'uint64_t cap = (uint64_t)raw_cap_val;' "$runtime"
! grep -A4 'rt_arm_array_new_with_cap_raw' "$runtime" | grep -q simpleos_raw_or_encoded_int
grep -A3 'rt_arm_array_new_fat_cluster(void)' "$runtime" | grep -q '128ULL \* 512ULL'
! grep -A3 'rt_arm_array_new_fat_cluster(void)' "$runtime" | grep -q raw_spc_val
grep -q 'rt_arm_array_append_sector(out, sec)' "$vfs"
! grep -q 'rt_arm_array_append_bytes(out, sec, 512)' "$vfs"
grep -q 'rt_arm_array_append_to_capacity(out, data)' "$vfs"
! grep -q 'rt_arm_array_append_bytes(out, data, remaining)' "$vfs"
grep -A4 'rt_arm_array_append_sector' "$runtime" | grep -q '(RuntimeValue)512ULL'
grep -A8 'rt_arm_array_append_to_capacity' "$runtime" | grep -q 'dst->cap - dst->len'
grep -q 'extern fn rt_arm_array_len_i32_raw(arr: \[u8\]) -> i32' "$vfs"
[ "$(grep -c 'val data_len = rt_arm_array_len_i32_raw(data)' "$vfs")" -eq 6 ]
! grep -q 'rt_arm_array_len_u32(data)\.to_i32()' "$vfs"
grep -A8 'int32_t rt_arm_array_len_i32_raw' "$runtime" | grep -q '(int32_t)len'
grep -q 'extern fn arm_fs_exec_trace_raw(id: u64)' "$vfs"
grep -q 'RuntimeValue arm_fs_exec_trace_raw(RuntimeValue id_val)' "$runtime"

# Executable ABI regression: a raw 1024-byte cluster must remain 1024 when it
# becomes the signed directory-loop bound. The former tagged-int heuristic
# divided it to 128; a dirent in the second sector was therefore unreachable.
tmp=$(mktemp -d "${TMPDIR:-/tmp}/arm64-fat-len-abi.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
cc -std=c99 -Wall -Wextra -Werror \
    "$root/test/01_unit/os/services/vfs/arm64_fat_len_abi_fixture.c" -o "$tmp/len_abi"
"$tmp/len_abi"

perl - "$image" <<'PERL'
use strict;
use warnings;
my ($path) = @ARGV;
open my $fh, '<:raw', $path or die "open $path: $!\n";
read($fh, my $bpb, 512) == 512 or die "short BPB\n";
my $bps = unpack('v', substr($bpb, 11, 2));
my $spc = ord(substr($bpb, 13, 1));
my $reserved = unpack('v', substr($bpb, 14, 2));
my $fats = ord(substr($bpb, 16, 1));
my $fat_size = unpack('V', substr($bpb, 36, 4));
my $root = unpack('V', substr($bpb, 44, 4));
die "fixture must exercise multi-sector clusters\n" unless $bps == 512 && $spc > 1;
my $data_lba = $reserved + $fats * $fat_size;
sub cluster_bytes {
    my ($cluster) = @_;
    seek($fh, ($data_lba + ($cluster - 2) * $spc) * $bps, 0) or die "seek: $!\n";
    read($fh, my $buf, $spc * $bps) == $spc * $bps or die "short cluster\n";
    return $buf;
}
sub find_entry {
    my ($cluster, $name, $want_dir) = @_;
    my $buf = cluster_bytes($cluster);
    for (my $off = 0; $off + 32 <= length($buf); $off += 32) {
        my $first = ord(substr($buf, $off, 1));
        last if $first == 0;
        next if $first == 0xe5;
        my $attr = ord(substr($buf, $off + 11, 1));
        next if $attr == 0x0f || (($attr & 0x10) != 0) != $want_dir;
        next unless substr($buf, $off, 11) eq $name;
        return (unpack('v', substr($buf, $off + 20, 2)) << 16) |
               unpack('v', substr($buf, $off + 26, 2));
    }
    die "missing FAT dirent $name in cluster $cluster\n";
}
my $sys = find_entry($root, 'SYS        ', 1);
my $apps = find_entry($sys, 'APPS       ', 1);
my $hello = find_entry($apps, 'HELLOSMFSMF', 0);
die "invalid HELLOSMF cluster\n" unless $hello >= 2;
print "PASS arm64 FAT raw-capacity descent root=$root sys=$sys apps=$apps hello=$hello spc=$spc\n";
PERL
echo "PASS arm64 FAT raw length ABI regression"
