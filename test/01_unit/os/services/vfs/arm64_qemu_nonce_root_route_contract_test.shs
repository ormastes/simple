#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
vfs="$root/src/os/services/vfs/arm_fs_exec_vfs.spl"
aliases="$root/src/os/services/vfs/arm_fs_exec_alias.spl"
dirent="$root/src/os/services/vfs/arm_fs_exec_dirent.spl"
image="${ARM64_FAT_IMAGE:-$root/build/os/fat32-arm64.img}"

root_line=$(grep -n 'if route >= 1 and route <= 4:' "$vfs" | cut -d: -f1)
apps_line=$(grep -n 'if route == 10:' "$vfs" | cut -d: -f1)
[ -n "$root_line" ] && [ -n "$apps_line" ] && [ "$root_line" -lt "$apps_line" ]
grep -A1 'case "/QEMUNONC.TXT":' "$aliases" | grep -q '"QEMUNONC.TXT"'
! grep -q '/SYS/APPS/QEMUNONC' "$aliases"
! grep -q 'case "/UNKNOWN.ROOT"' "$aliases"
grep -A7 'case "QEMUNONC.TXT":' "$dirent" | grep -q '0x51.to_u8(), 0x45.to_u8(), 0x4D.to_u8(), 0x55.to_u8(), 0x4E.to_u8()'
grep -A7 'case "QEMUNONC.TXT":' "$dirent" | grep -q '0x4F.to_u8(), 0x4E.to_u8(), 0x43.to_u8(), 0x54.to_u8(), 0x58.to_u8()'
grep -A7 'case "FSEXEC.ELF":' "$dirent" | grep -q '0x46.to_u8(), 0x53.to_u8(), 0x45.to_u8(), 0x58.to_u8(), 0x45.to_u8()'
grep -A7 'case "FSEXEC.ELF":' "$dirent" | grep -q '0x43.to_u8(), 0x20.to_u8(), 0x20.to_u8(), 0x45.to_u8(), 0x4C.to_u8()'
! grep -A7 'case "FSEXEC.ELF":' "$dirent" | grep -q '0x00.to_u8()'
grep -A5 'if route >= 1 and route <= 4:' "$vfs" \
    | grep -q '_arm_fat32_read_short_name_from_dir(dev, _arm_root_cluster(), short_name)'
route_body=$(sed -n '/fn _arm_fat32_read_path_from_dev/,/^$/p' "$vfs")
! printf '%s\n' "$route_body" | grep -Eq 'mapped ==|_text_has_prefix|short_name !='

perl - "$image" <<'PERL'
use strict;
use warnings;
my ($path) = @ARGV;
open my $fh, '<:raw', $path or die "open $path: $!\n";
read($fh, my $bpb, 512) == 512 or die "short BPB\n";
my $bps = unpack('v', substr($bpb, 11, 2));
my $spc = ord(substr($bpb, 13, 1));
my $reserved = unpack('v', substr($bpb, 14, 2));
my $fats = ord(substr($bpb, 16, 1));
my $fat_size = unpack('V', substr($bpb, 36, 4));
my $root_cluster = unpack('V', substr($bpb, 44, 4));
die "invalid FAT32 geometry\n" unless $bps == 512 && $spc >= 1 && $root_cluster >= 2;
my $data_lba = $reserved + $fats * $fat_size;
seek($fh, ($data_lba + ($root_cluster - 2) * $spc) * $bps, 0) or die "seek root: $!\n";
read($fh, my $dir, $spc * $bps) == $spc * $bps or die "short root cluster\n";
sub entries {
    my ($dir) = @_;
    my %found;
    for (my $off = 0; $off + 32 <= length($dir); $off += 32) {
        my $first = ord(substr($dir, $off, 1));
        last if $first == 0;
        next if $first == 0xe5 || ord(substr($dir, $off + 11, 1)) == 0x0f;
        my $name = substr($dir, $off, 11);
        my $cluster = (unpack('v', substr($dir, $off + 20, 2)) << 16) |
                      unpack('v', substr($dir, $off + 26, 2));
        $found{$name} = [$off, ord(substr($dir, $off + 11, 1)),
                         unpack('V', substr($dir, $off + 28, 4)), $cluster];
    }
    return %found;
}
sub cluster_bytes {
    my ($cluster) = @_;
    seek($fh, ($data_lba + ($cluster - 2) * $spc) * $bps, 0) or die "seek cluster: $!\n";
    read($fh, my $bytes, $spc * $bps) == $spc * $bps or die "short cluster\n";
    return $bytes;
}
my %found = entries($dir);
for my $name ('QEMUNONCTXT', 'SYS        ') {
    die "missing root dirent $name\n" unless exists $found{$name};
}
die "nonce dirent is not a regular 118-byte file\n"
    unless $found{'QEMUNONCTXT'}->[1] == 0x20 && $found{'QEMUNONCTXT'}->[2] == 118;
die "SYS dirent is not a directory\n" unless $found{'SYS        '}->[1] == 0x10;
my %sys = entries(cluster_bytes($found{'SYS        '}->[3]));
die "missing real SYS/APPS route\n" unless exists $sys{'APPS       '} && $sys{'APPS       '}->[1] == 0x10;
my %apps = entries(cluster_bytes($sys{'APPS       '}->[3]));
die "missing real SYS/APPS/HELLOSMF route\n" unless exists $apps{'HELLOSMFSMF'} && $apps{'HELLOSMFSMF'}->[1] == 0x20;
print "PASS arm64 root nonce dirent bytes offset=$found{'QEMUNONCTXT'}->[0] size=118 root=$root_cluster spc=$spc sys=$found{'SYS        '}->[3] apps=$sys{'APPS       '}->[3] hello=$apps{'HELLOSMFSMF'}->[3]\n";
PERL

echo "PASS arm64 root nonce route precedes SYS/APPS and remains fail-closed"
