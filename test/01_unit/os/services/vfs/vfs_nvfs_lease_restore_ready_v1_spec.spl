use std.spec.*
use std.fs.*

# Pins `vfs_state_mount_table_lease_restore_ready_v1`, the NVFS root's readiness
# publication point (item 4 of
# doc/08_tracking/bug/nvfs_stack_phantom_functions_called_never_defined_2026-09-01.md).
#
# The defect class this guards is NOT an ordinary logic bug. The function was
# CALLED from vfs_nvfs_root_transaction.spl and DEFINED NOWHERE; under
# SIMPLE_ALLOW_FREESTANDING_STUBS the linker fabricated a weak body returning 0,
# so a successful NVFS mount silently published no readiness at all. A behaviour
# test cannot see that — the call "succeeds". So the first assertion here is the
# blunt one that would have caught it: the definition exists in the module that
# owns the state.
#
# These are source-text assertions because the lease API and the globals it
# writes are `pub(package)` / module-private and are deliberately not reachable
# from a unit test — the same convention vfs_boot_state_owner_spec.spl uses.

describe "NVFS mount-table lease restore with readiness":

    it "defines the function that publishes NVFS root readiness":
        # Item 4 was a PHANTOM: called at vfs_nvfs_root_transaction.spl:175,
        # defined nowhere. The caller must keep calling it AND the owner module
        # must keep defining it -- either half alone is the bug.
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val txn = read_file("src/os/services/vfs/vfs_nvfs_root_transaction.spl")
        expect(owner).to_contain(
            "pub(package) fn vfs_state_mount_table_lease_restore_ready_v1(")
        expect(txn).to_contain("vfs_state_mount_table_lease_restore_ready_v1(lease)")

    it "publishes readiness and the production storage identity":
        # vfs_is_ready() gates every g_vfs_* hub request, and
        # vfs_boot_storage_acceptance_reason() hard-rejects any provider string
        # other than "simple-driver" -- so a root published without these three
        # writes is mounted but unreachable.
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val body = _restore_ready_body(owner)
        expect(body).to_contain("g_vfs_initialized = true")
        expect(body).to_contain("g_vfs_boot_storage_provider = \"simple-driver\"")
        expect(body).to_contain("g_vfs_boot_storage_pure_simple = true")

    it "publishes readiness only after the leased table is restored":
        # THE load-bearing ordering property. vfs_nvfs_root_mount_stage_v1
        # refuses to stage when vfs_is_ready() is already true, i.e. it reads
        # that flag as "the canonical root is claimed". Setting readiness before
        # the table value is back would expose a window in which the VFS claims
        # a root over a table that is still leased out and unreachable.
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val body = _restore_ready_body(owner)
        val restore_at = body.index_of("g_mount_table = Some(lease.table)")
        val ready_at = body.index_of("g_vfs_initialized = true")
        expect(restore_at >= 0).to_equal(true)
        expect(ready_at >= 0).to_equal(true)
        expect(restore_at < ready_at).to_equal(true)

    it "rejects a stale or double restore without publishing readiness":
        # A rejected restore must quarantine the owner and return false BEFORE
        # any readiness write, so a failed publication can never leave the VFS
        # marked ready over an indeterminate table.
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val body = _restore_ready_body(owner)
        expect(body).to_contain("lease.nonce != g_mount_table_active_lease_nonce_v1")
        expect(body).to_contain("lease.epoch != g_mount_table_owner_epoch_v1")
        expect(body).to_contain("g_mount_table_quarantined_v1 = true")
        val guard_at = body.index_of("g_mount_table_quarantined_v1 = true")
        val ready_at = body.index_of("g_vfs_initialized = true")
        expect(guard_at < ready_at).to_equal(true)

    it "validates exactly what the plain restore validates":
        # The readiness variant must not be a weaker sibling: any check the
        # plain restore makes and this one drops is a way to publish readiness
        # over a lease the plain path would have refused.
        val owner = read_file("src/os/services/vfs/vfs_boot_state.spl")
        val body = _restore_ready_body(owner)
        expect(body).to_contain("if not _vfs_state_mount_table_raw_lock_v1(): return false")
        expect(body).to_contain("not g_mount_table_lease_active_v1 or g_mount_table.?")
        expect(body).to_contain("lease.epoch == 0u64")
        expect(body).to_contain("lease.nonce == 0u64")
        expect(body).to_contain("g_mount_table_lease_active_v1 = false")
        expect(body).to_contain("g_mount_table_active_lease_nonce_v1 = 0u64")

fn _restore_ready_body(owner: text) -> text:
    """Slice out just the restore_ready_v1 definition, so assertions cannot be
    satisfied by identical text belonging to the plain restore sibling."""
    val start = owner.index_of(
        "pub(package) fn vfs_state_mount_table_lease_restore_ready_v1(")
    if start < 0:
        return ""
    val rest = owner.slice(start, owner.len())
    val end = rest.index_of("\n# Narrow owner port")
    if end < 0:
        return rest
    rest.slice(0, end)
