"""Static lifecycle specification for the canonical NVFS session authority."""

use os.services.vfs.nvfs_mount_session_owner_v1.{
    NvfsMountSessionV1, NvfsMountSessionErrorV1,
    nvfs_mount_session_open_v1, nvfs_mount_session_validate_v1,
    nvfs_mount_session_close_v1, nvfs_mount_session_live_count_v1,
    NVFS_MOUNT_SESSION_CAPACITY_V1
}
use os.drivers.nvme.nvme_storage_model.{
    NvmeNamespaceIdentity, NvmeQueueAssignment, NvmeQueueRole,
    NvmeNamespaceMode, NvmeSharedFilesystemInterface,
    nvme_filesystem_lease, nvme_shared_filesystem_interface
}
use os.kernel.types.capability_types.{
    CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_QUEUE_SUBMIT,
    SIMPLEOS_NVME_SYSTEM_QUEUE_ID, SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID
}

fn _shared_interface(nsid: u32) -> NvmeSharedFilesystemInterface:
    val namespace = NvmeNamespaceIdentity(
        controller_id: 1u32, nsid: nsid, lba_size: 512u32,
        lba_count: 16384u64, eui64: nsid.to_u64(),
        nguid_lo: 0u64, nguid_hi: 0u64,
        uuid_lo: 0u64, uuid_hi: 0u64)
    val queue = NvmeQueueAssignment(
        owner_task: 0u64,
        rights: CAP_RIGHT_READ + CAP_RIGHT_WRITE + CAP_RIGHT_QUEUE_SUBMIT,
        controller_id: 1u32, nsid: nsid,
        queue_id: SIMPLEOS_NVME_SYSTEM_QUEUE_ID, max_depth: 64u16,
        role: NvmeQueueRole.System)
    val lease = nvme_filesystem_lease(
        namespace, 64u64, 8192u64, NvmeNamespaceMode.System, queue,
        "simple-driver", "none", true, true)
    nvme_shared_filesystem_interface(lease).unwrap()

fn _user_shared_interface(nsid: u32, role: NvmeQueueRole) -> NvmeSharedFilesystemInterface:
    val namespace = NvmeNamespaceIdentity(
        controller_id: 2u32, nsid: nsid, lba_size: 512u32,
        lba_count: 16384u64, eui64: nsid.to_u64(),
        nguid_lo: 0u64, nguid_hi: 0u64,
        uuid_lo: 0u64, uuid_hi: 0u64)
    val queue = NvmeQueueAssignment(
        owner_task: 91u64,
        rights: CAP_RIGHT_READ + CAP_RIGHT_WRITE + CAP_RIGHT_QUEUE_SUBMIT,
        controller_id: 2u32, nsid: nsid,
        queue_id: SIMPLEOS_NVME_FIRST_DATA_QUEUE_ID, max_depth: 64u16,
        role: role)
    val lease = nvme_filesystem_lease(
        namespace, 64u64, 8192u64, NvmeNamespaceMode.UserAssigned, queue,
        "simple-driver", "resource-grant-set:tok=nvfs-session", true, true)
    nvme_shared_filesystem_interface(lease).unwrap()

describe "NVFS shared-interface mount session lifecycle":
    it "binds a session to the canonical FAT32 NVFS DBFS interface":
        val interface = _shared_interface(31u32)
        val opened = nvfs_mount_session_open_v1(interface)
        expect(opened.is_ok()).to_equal(true)
        val session = opened.unwrap()
        expect(session.mount_id()).to_be_greater_than(0u64)
        expect(session.mount_generation()).to_be_greater_than(0u64)
        expect(nvfs_mount_session_validate_v1(session, interface).is_ok()).to_equal(true)
        expect(nvfs_mount_session_close_v1(session).is_ok()).to_equal(true)

    it "rejects a copied stale session after close and slot reuse":
        val interface = _shared_interface(32u32)
        val old = nvfs_mount_session_open_v1(interface).unwrap()
        expect(nvfs_mount_session_close_v1(old).is_ok()).to_equal(true)
        val replacement = nvfs_mount_session_open_v1(interface).unwrap()
        expect(replacement.mount_generation()).to_be_greater_than(old.mount_generation())
        val stale = nvfs_mount_session_validate_v1(old, interface)
        expect(stale.unwrap_err()).to_equal(NvfsMountSessionErrorV1.StaleSession)
        expect(nvfs_mount_session_validate_v1(replacement, interface).is_ok()).to_equal(true)
        expect(nvfs_mount_session_close_v1(replacement).is_ok()).to_equal(true)

    it "rejects exact lease substitution and an invalid probe":
        val interface = _shared_interface(33u32)
        val session = nvfs_mount_session_open_v1(interface).unwrap()
        val mismatch = nvfs_mount_session_validate_v1(session, _shared_interface(34u32))
        expect(mismatch.unwrap_err()).to_equal(NvfsMountSessionErrorV1.BindingMismatch)
        val invalid = nvfs_mount_session_validate_v1(NvfsMountSessionV1.invalid_probe(), interface)
        expect(invalid.unwrap_err()).to_equal(NvfsMountSessionErrorV1.InvalidSession)
        expect(nvfs_mount_session_close_v1(session).is_ok()).to_equal(true)

    it "rejects a forged readiness projection despite a valid lease":
        val canonical = _shared_interface(35u32)
        val forged = NvmeSharedFilesystemInterface(
            lease: canonical.lease, provider: canonical.provider,
            mode: canonical.mode, queue_id: canonical.queue_id,
            fat32_ready: true, nvfs_ready: true, dbfs_ready: false)
        val rejected = nvfs_mount_session_open_v1(forged)
        expect(rejected.unwrap_err()).to_equal(NvfsMountSessionErrorV1.InvalidInterface)

    it "binds the queue role even when both user projections are admissible":
        val data_interface = _user_shared_interface(37u32, NvmeQueueRole.Data)
        val system_role_interface = _user_shared_interface(37u32, NvmeQueueRole.System)
        val session = nvfs_mount_session_open_v1(data_interface).unwrap()
        val substituted = nvfs_mount_session_validate_v1(session, system_role_interface)
        expect(substituted.unwrap_err()).to_equal(NvfsMountSessionErrorV1.BindingMismatch)
        expect(nvfs_mount_session_close_v1(session).is_ok()).to_equal(true)

    it "fails closed at capacity and releases every admitted session":
        val interface = _shared_interface(36u32)
        var sessions: [NvfsMountSessionV1] = []
        var i: i32 = 0
        while i < NVFS_MOUNT_SESSION_CAPACITY_V1:
            sessions.push(nvfs_mount_session_open_v1(interface).unwrap())
            i = i + 1
        val overflow = nvfs_mount_session_open_v1(interface)
        expect(overflow.unwrap_err()).to_equal(NvfsMountSessionErrorV1.CapacityExhausted)
        for session in sessions:
            expect(nvfs_mount_session_close_v1(session).is_ok()).to_equal(true)
        expect(nvfs_mount_session_live_count_v1()).to_equal(0)
