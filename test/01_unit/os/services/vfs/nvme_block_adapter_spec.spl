"""
## Purpose and audience
Regression coverage for the filesystem-facing pure Simple NVMe block adapter:
lease-window LBA translation, namespace identification, DirectIo 4K
shared-DMA bridging, and the absence of C-bridge externs in the pure adapter.
These tests avoid real hardware and prove that adapter-visible helpers
preserve the same bounded namespace window used by FAT32, NVFS, and DBFS.
Audience: SimpleOS VFS and NVMe driver maintainers.

## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run
test/01_unit/os/services/vfs/nvme_block_adapter_spec.spl` from the repo root;
lease scenarios drive real adapter helpers, source-contract scenarios pin the
shipped `src/os/services/vfs/vfs_block_adapters.spl` tokens.

## Compatibility and limitations
No NVMe controller or QEMU device is touched: the adapter is constructed
through its identified-namespace test constructors, and driver I/O methods are
only asserted as source contracts. Scenarios that rely on device interrupts
or real DMA buffers are out of scope here.

## Verification guidance and troubleshooting
A red lease scenario prints the translated LBA or the FsError the adapter
returned; a red source-contract scenario names the token that disappeared
from `vfs_block_adapters.spl` — grep that token in the cited file before
concluding the adapter regressed versus the spec being stale.
"""
# Lifecycle: doc/01_research/domain/rv32_nvme_host_axi_mmio.md ;
# doc/03_plan/agent_tasks/rv32_nvme_host_axi_mmio.md ;
# doc/04_architecture/cosmos_nvme_pcie_adapter_policy.md ;
# doc/05_design/rv32_nvme_host_axi_mmio.md
# @manual_section: nvme-filesystem-lease-adapter

use std.spec.{describe, it, expect}
use std.io_runtime.{read_file}
use std.fs_driver.error.{FsError}
use os.services.vfs.vfs_block_adapters.{NvmeBlockAdapter}
use os.drivers.nvme.nvme_driver.{NvmeDriver}
use os.drivers.nvme.nvme_storage_model.{NvmeQueueRole, NvmeNamespaceMode, NvmeFilesystemConsumer, NvmeNamespaceIdentity, NvmeQueueAssignment, nvme_filesystem_lease}
use os.kernel.types.capability_types.{CAP_RIGHT_READ, CAP_RIGHT_WRITE, CAP_RIGHT_QUEUE_SUBMIT, SIMPLEOS_NVME_SYSTEM_QUEUE_ID}


describe "NVMe VFS block adapter lease helpers":
    it "translates filesystem-relative LBAs through the shared lease window":
        # @req REQ-OS-VFS-NVME-001
        # @capture(bit_table): lease window base/size and translated LBA results retained for review
        step("Build a system-mode filesystem lease and translate boundary LBAs through it")
        val ns = NvmeNamespaceIdentity(
            controller_id: 0,
            nsid: 7,
            lba_size: 4096,
            lba_count: 8192,
            eui64: 0,
            nguid_lo: 0,
            nguid_hi: 0,
            uuid_lo: 0,
            uuid_hi: 0
        )
        val queue = NvmeQueueAssignment(
            queue_id: SIMPLEOS_NVME_SYSTEM_QUEUE_ID,
            role: NvmeQueueRole.System,
            controller_id: 0,
            nsid: 7,
            owner_task: 0,
            max_depth: 128,
            rights: CAP_RIGHT_READ + CAP_RIGHT_WRITE + CAP_RIGHT_QUEUE_SUBMIT
        )
        val lease = nvme_filesystem_lease(ns, 1024u64, 512u64, NvmeNamespaceMode.System, queue, "simple-driver", "none", true, true)
        expect(NvmeBlockAdapter.lease_sector_count_for_test(lease)).to_equal(512u64)
        expect(NvmeBlockAdapter.translate_lease_lba_for_test(lease, 0u64).unwrap()).to_equal(1024u64)
        expect(NvmeBlockAdapter.translate_lease_lba_for_test(lease, 511u64).unwrap()).to_equal(1535u64)
        expect(NvmeBlockAdapter.translate_lease_lba_for_test(lease, 512u64).unwrap_err()).to_equal("nvme-fs-lease-lba-out-of-range")

    it "rejects hardware adapters for namespaces not identified by the driver":
        # @req REQ-OS-VFS-NVME-002
        # @capture(bit_table): unidentified-namespace rejection verdict retained for review
        step("Build a lease on an unidentified namespace and request a filesystem adapter")
        val ns = NvmeNamespaceIdentity(
            controller_id: 0,
            nsid: 7,
            lba_size: 4096,
            lba_count: 8192,
            eui64: 0,
            nguid_lo: 0,
            nguid_hi: 0,
            uuid_lo: 0,
            uuid_hi: 0
        )
        val queue = NvmeQueueAssignment(
            queue_id: SIMPLEOS_NVME_SYSTEM_QUEUE_ID,
            role: NvmeQueueRole.System,
            controller_id: 0,
            nsid: 7,
            owner_task: 0,
            max_depth: 128,
            rights: CAP_RIGHT_READ + CAP_RIGHT_WRITE + CAP_RIGHT_QUEUE_SUBMIT
        )
        val lease = nvme_filesystem_lease(ns, 0u64, 512u64, NvmeNamespaceMode.System, queue, "simple-driver", "none", true, true)
        val adapter = NvmeBlockAdapter.for_filesystem_lease(NvmeDriver.new(), lease, NvmeFilesystemConsumer.Fat32)
        expect(adapter.unwrap_err()).to_equal("NvmeBlockAdapter: namespace not identified by driver")

    it "enforces the lease window used by filesystem-facing BlockDevice sector IO":
        # @req REQ-OS-VFS-NVME-003
        # @capture(bit_table): identified-namespace sector window and boundary LBA translations retained for review
        step("Construct an identified-namespace adapter and translate boundary sector LBAs")
        val adapter = NvmeBlockAdapter.for_identified_namespace_unchecked(
            NvmeDriver.new(),
            7u32,
            SIMPLEOS_NVME_SYSTEM_QUEUE_ID,
            128u64,
            4u64,
            512u32,
            "fat32"
        )

        expect(adapter.sector_count()).to_equal(4u64)
        expect(adapter.filesystem_consumer()).to_equal("fat32")
        expect(adapter.sector_io_absolute_lba_for_test(0u64).unwrap()).to_equal(128u64)
        expect(adapter.sector_io_absolute_lba_for_test(3u64).unwrap()).to_equal(131u64)
        expect(adapter.sector_io_absolute_lba_for_test(4u64).unwrap_err()).to_equal("NvmeBlockAdapter: lba beyond filesystem lease")

    it "rejects single and batched 4K DirectIo that would cross the filesystem lease":
        # @req REQ-OS-VFS-NVME-004
        # @capture(bit_table): in-lease and lease-crossing 4K DirectIo verdicts retained for review
        step("Submit in-lease and lease-crossing 4K offsets through the DirectIo adapter")
        val adapter = NvmeBlockAdapter.for_identified_namespace_unchecked(
            NvmeDriver.new(),
            7u32,
            SIMPLEOS_NVME_SYSTEM_QUEUE_ID,
            128u64,
            8u64,
            512u32,
            "fat32"
        )

        expect(adapter.direct_4k_relative_lba_for_test(0i64).unwrap()).to_equal(0u64)
        expect(adapter.direct_4k_relative_lba_for_test(512i64).unwrap_err()).to_equal(FsError.InvalidArg)
        expect(adapter.direct_4k_relative_lba_for_test(4096i64).unwrap_err()).to_equal(FsError.InvalidArg)

    it "routes lease-backed I/O through namespace-aware driver methods":
        # @req REQ-OS-VFS-NVME-005
        # @capture(bit_table): namespace/queue-aware sector IO contract tokens retained for review
        step("Inspect the adapter source for the namespace-aware sector IO contract")
        val source = read_file("src/os/services/vfs/vfs_block_adapters.spl")
        val sector_io_records_lease_namespace = source.contains("lease_nsid: lease.namespace_identity.nsid")
        val sector_io_records_lease_queue = source.contains("lease_queue_id: lease.queue.queue_id")
        val identified_count_matches_lease = source.contains("identified_sector_count.unwrap() != lease.namespace_identity.lba_count")
        val identified_size_matches_lease = source.contains("identified_sector_size.unwrap() != lease.namespace_identity.lba_size")
        val boundary_helper_is_exposed_for_tests = source.contains("fn sector_io_absolute_lba_for_test(lba: u64) -> Result<u64, text>:")
        val reads_target_the_leased_namespace_queue = source.contains("self.nvme.read_sectors_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val writes_target_the_leased_namespace_queue = source.contains("self.nvme.write_sectors_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val flush_helper_is_exposed = source.contains("me flush_lease_queue() -> Result<bool, text>:")
        val flush_targets_the_leased_namespace_queue = source.contains("self.nvme.flush_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id)")
        expect(sector_io_records_lease_namespace).to_equal(true)
        expect(sector_io_records_lease_queue).to_equal(true)
        expect(identified_count_matches_lease).to_equal(true)
        expect(identified_size_matches_lease).to_equal(true)
        expect(boundary_helper_is_exposed_for_tests).to_equal(true)
        expect(reads_target_the_leased_namespace_queue).to_equal(true)
        expect(writes_target_the_leased_namespace_queue).to_equal(true)
        expect(flush_helper_is_exposed).to_equal(true)
        expect(flush_targets_the_leased_namespace_queue).to_equal(true)

    it "exposes a 4K shared-DMA fast path for production random I/O":
        # @req REQ-OS-VFS-NVME-006
        # @capture(bit_table): 4K shared-DMA read/write and batch contract tokens retained for review
        step("Inspect the adapter source for the 4K shared-DMA fast-path contract")
        val source = read_file("src/os/services/vfs/vfs_block_adapters.spl")
        val exposes_single_read_shared_dma = source.contains("me read_4k_shared_dma(relative_lba: u64, buf: SharedDmaBuffer)")
        val exposes_single_write_shared_dma = source.contains("me write_4k_shared_dma(relative_lba: u64, buf: SharedDmaBuffer)")
        val single_read_rides_burst_in_namespace_queue = source.contains("self.nvme.read_4k_shared_dma_burst_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val single_write_rides_burst_in_namespace_queue = source.contains("self.nvme.write_4k_shared_dma_burst_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val exposes_batch_read_shared_dma = source.contains("me read_4k_shared_dma_batch(relative_lbas: [u64], buf: SharedDmaBuffer)")
        val exposes_batch_write_shared_dma = source.contains("me write_4k_shared_dma_batch(relative_lbas: [u64], buf: SharedDmaBuffer)")
        val batch_read_rides_burst_in_namespace_queue = source.contains("self.nvme.read_4k_shared_dma_batch_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val batch_write_rides_burst_in_namespace_queue = source.contains("self.nvme.write_4k_shared_dma_batch_in_namespace_on_queue(self.lease_nsid, self.lease_queue_id")
        val no_unbacked_identified_namespace_submit_remains = source.contains("submit_direct_4k_shared_dma_batch_for_identified_namespace")
        expect(exposes_single_read_shared_dma).to_equal(true)
        expect(exposes_single_write_shared_dma).to_equal(true)
        expect(single_read_rides_burst_in_namespace_queue).to_equal(true)
        expect(single_write_rides_burst_in_namespace_queue).to_equal(true)
        expect(exposes_batch_read_shared_dma).to_equal(true)
        expect(exposes_batch_write_shared_dma).to_equal(true)
        expect(batch_read_rides_burst_in_namespace_queue).to_equal(true)
        expect(batch_write_rides_burst_in_namespace_queue).to_equal(true)
        expect(no_unbacked_identified_namespace_submit_remains).to_equal(false)

    it "bridges the common DirectIo request model to the NVMe 4K shared-DMA path":
        # @req REQ-OS-VFS-NVME-007
        # @capture(bit_table): DirectIo single-request bridge contract tokens retained for review
        # NOTE: legitimately RED — the pinned import token drifted: the source
        # now imports `use std.fs_driver.direct_io.{DirectIoRequest,
        # DirectIoBatchRequest, DirectIoResult, ...}` (batch symbols were
        # added), so the narrower pinned substring no longer matches.
        # src/os/services/vfs/vfs_block_adapters.spl:19.
        step("Inspect the adapter source for the single-request DirectIo bridge contract")
        val source = read_file("src/os/services/vfs/vfs_block_adapters.spl")
        val imports_the_common_direct_io_model = source.contains("use std.fs_driver.direct_io.{DirectIoRequest, DirectIoResult")
        val exposes_the_4k_extension_entry = source.contains("fn direct_4k_extension() -> DirectIoExt")
        val backend_is_tagged_as_nvme_lease_shared_dma = source.contains("backend_tag: \"simpleos-nvme-lease-shared-dma-4k\"")
        val bridge_never_bounces_through_host_memory = source.contains("bounce_allowed: false")
        val submit_takes_the_common_request_type = source.contains("me submit_direct_4k_shared_dma(req: DirectIoRequest) -> Result<DirectIoResult, FsError>")
        val submit_validates_the_shared_buffer = source.contains("val valid = ext.validate_shared_buffer(req.file_offset, req.buffer)")
        val file_offset_maps_to_a_lease_relative_lba = source.contains("val relative_lba = self.direct_4k_relative_lba(req.file_offset)")
        val read_bridge_targets_shared_dma = source.contains("self.read_4k_shared_dma(relative_lba.unwrap(), req.buffer)")
        val write_bridge_targets_shared_dma = source.contains("self.write_4k_shared_dma(relative_lba.unwrap(), req.buffer)")
        val plain_submit_reports_no_buffered_copy = source.contains("buffered_copy_bytes: 0u64")
        val plain_submit_reports_no_dma_copy = source.contains("direct_dma_copy_bytes: 0u64")
        val plain_submit_is_not_durable = source.contains("durable: false")
        val write_through_variant_is_exposed = source.contains("me submit_direct_4k_shared_dma_write_through(req: DirectIoRequest) -> Result<DirectIoResult, FsError>")
        val write_through_flushes_the_lease_queue = source.contains("val flush = self.flush_lease_queue()")
        val write_through_reports_flushed_status = source.contains("status: \"submitted-flushed\"")
        val write_through_is_durable = source.contains("durable: true")
        expect(imports_the_common_direct_io_model).to_equal(true)
        expect(exposes_the_4k_extension_entry).to_equal(true)
        expect(backend_is_tagged_as_nvme_lease_shared_dma).to_equal(true)
        expect(bridge_never_bounces_through_host_memory).to_equal(true)
        expect(submit_takes_the_common_request_type).to_equal(true)
        expect(submit_validates_the_shared_buffer).to_equal(true)
        expect(file_offset_maps_to_a_lease_relative_lba).to_equal(true)
        expect(read_bridge_targets_shared_dma).to_equal(true)
        expect(write_bridge_targets_shared_dma).to_equal(true)
        expect(plain_submit_reports_no_buffered_copy).to_equal(true)
        expect(plain_submit_reports_no_dma_copy).to_equal(true)
        expect(plain_submit_is_not_durable).to_equal(true)
        expect(write_through_variant_is_exposed).to_equal(true)
        expect(write_through_flushes_the_lease_queue).to_equal(true)
        expect(write_through_reports_flushed_status).to_equal(true)
        expect(write_through_is_durable).to_equal(true)

    it "bridges batched DirectIo requests to the lease queue for filesystem random I/O":
        # @req REQ-OS-VFS-NVME-008
        # @capture(bit_table): DirectIo batch bridge contract tokens retained for review
        step("Inspect the adapter source for the batched DirectIo bridge contract")
        val source = read_file("src/os/services/vfs/vfs_block_adapters.spl")
        val imports_the_batch_request_model = source.contains("DirectIoBatchRequest")
        val exposes_the_batch_extension_entry = source.contains("fn direct_4k_batch_extension() -> DirectIoExt")
        val batch_backend_is_tagged = source.contains("backend_tag: \"simpleos-nvme-lease-shared-dma-4k-batch\"")
        val batch_submit_takes_the_common_type = source.contains("me submit_direct_4k_shared_dma_batch(req: DirectIoBatchRequest) -> Result<DirectIoResult, FsError>")
        val batch_submit_validates_at_4k_granularity = source.contains("direct_io_validate_batch(ext, req, 4096u64)")
        val each_batch_offset_maps_to_lease_relative_lba = source.contains("val relative_lba = self.direct_4k_relative_lba(offset)")
        val batch_result_carries_expected_bytes = source.contains("bytes: expected_bytes.unwrap()")
        val batch_read_bridge_targets_shared_dma = source.contains("self.read_4k_shared_dma_batch(relative_lbas, req.buffer)")
        val batch_write_bridge_targets_shared_dma = source.contains("self.write_4k_shared_dma_batch(relative_lbas, req.buffer)")
        val batch_write_through_variant_is_exposed = source.contains("me submit_direct_4k_shared_dma_batch_write_through(req: DirectIoBatchRequest) -> Result<DirectIoResult, FsError>")
        expect(imports_the_batch_request_model).to_equal(true)
        expect(exposes_the_batch_extension_entry).to_equal(true)
        expect(batch_backend_is_tagged).to_equal(true)
        expect(batch_submit_takes_the_common_type).to_equal(true)
        expect(batch_submit_validates_at_4k_granularity).to_equal(true)
        expect(each_batch_offset_maps_to_lease_relative_lba).to_equal(true)
        expect(batch_result_carries_expected_bytes).to_equal(true)
        expect(batch_read_bridge_targets_shared_dma).to_equal(true)
        expect(batch_write_bridge_targets_shared_dma).to_equal(true)
        expect(batch_write_through_variant_is_exposed).to_equal(true)

    it "keeps the production pure adapter free of C bridge externs":
        # @req REQ-OS-VFS-NVME-009
        # @capture(bit_table): pure-adapter extern-freedom and C-bridge presence verdicts retained for review
        # NOTE: legitimately RED — the scenario pins
        # `extern fn simpleos_nvme_init() -> i64` in
        # src/os/services/vfs/c_nvme_block_adapter.spl, but that file currently
        # declares only simpleos_fat32_read_path* externs (:38-40) and no
        # simpleos_nvme_* extern at all.
        step("Compare the pure adapter and the C bridge for extern ownership")
        val pure_source = read_file("src/os/services/vfs/vfs_block_adapters.spl")
        val c_source = read_file("src/os/services/vfs/c_nvme_block_adapter.spl")

        val pure_adapter_has_no_c_init_extern = pure_source.contains("simpleos_nvme_init")
        val pure_adapter_has_no_c_read_extern = pure_source.contains("simpleos_nvme_read_sector")
        val pure_adapter_has_no_c_fat32_extern = pure_source.contains("simpleos_fat32_read_path")
        val pure_adapter_has_no_c_class = pure_source.contains("class CNvmeBlockAdapter")
        val c_bridge_owns_the_adapter_class = c_source.contains("class CNvmeBlockAdapter")
        val c_bridge_owns_the_nvme_init_extern = c_source.contains("extern fn simpleos_nvme_init() -> i64")
        expect(pure_adapter_has_no_c_init_extern).to_equal(false)
        expect(pure_adapter_has_no_c_read_extern).to_equal(false)
        expect(pure_adapter_has_no_c_fat32_extern).to_equal(false)
        expect(pure_adapter_has_no_c_class).to_equal(false)
        expect(c_bridge_owns_the_adapter_class).to_equal(true)
        expect(c_bridge_owns_the_nvme_init_extern).to_equal(true)
