# WmService Ownership Metadata Tests
#
# Verifies that ownership records preserve process/app identity metadata
# and expose shell-friendly query helpers.

"""
## Purpose and audience
Purpose: stores explicit process and app identity
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-WmServMeta-001

use std.spec
use os.services.wm.wm_service.{WmService}
use std.common.window_protocol.geometry.{WindowId}
use os.services.desktop_app_ownership_contract.{
    desktop_app_ownership_valid,
    desktop_app_ownership_marker,
}
use os.services.launcher.launcher.{
    launcher_init,
    launcher_register,
    launcher_record_process,
    launcher_get_process_app_id_for_pid,
    launcher_get_process_window_count,
    launcher_note_window_opened,
    launcher_process_is_process_backed,
}

extern fn unsafe_addr_of(ref: any) -> u64

fn push_u32(buf: [u8], value: u32):
    buf.push((value & 0xFF).to_u8())
    buf.push(((value >> 8) & 0xFF).to_u8())
    buf.push(((value >> 16) & 0xFF).to_u8())
    buf.push(((value >> 24) & 0xFF).to_u8())

fn push_i32(buf: [u8], value: i32):
    push_u32(buf, value.to_u32())

fn push_u64(buf: [u8], value: u64):
    buf.push((value & 0xFF).to_u8())
    buf.push(((value >> 8) & 0xFF).to_u8())
    buf.push(((value >> 16) & 0xFF).to_u8())
    buf.push(((value >> 24) & 0xFF).to_u8())
    buf.push(((value >> 32) & 0xFF).to_u8())
    buf.push(((value >> 40) & 0xFF).to_u8())
    buf.push(((value >> 48) & 0xFF).to_u8())
    buf.push(((value >> 56) & 0xFF).to_u8())

use std.spec.step
describe "WmService ownership metadata":
    it "stores explicit process and app identity":
        step("Verify: stores explicit process and app identity")
        # @req: REQ-OS-WmServMeta-001
        val wm = WmService.new()
        wm.register_window_owner_with_identity(WindowId(value: 7), 44, 1234, "app.browser")
        expect(wm.window_owner_process_id(7)).to_equal(1234)  # oracle: value fixed by the spec contract
        expect(wm.window_owner_app_id(7)).to_equal("app.browser")
        expect(wm.window_count_for_process(1234)).to_equal(1)  # oracle: value fixed by the spec contract
        expect(wm.window_ids_for_process(1234).len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "defaults process identity to the owning port":
        step("Verify: defaults process identity to the owning port")
        # @req: REQ-OS-WmServMeta-001
        val wm = WmService.new()
        wm.register_window_owner(WindowId(value: 9), 55)
        expect(wm.window_owner_process_id(9)).to_equal(55)  # oracle: value fixed by the spec contract
        expect(wm.window_ids_for_owner_port(55).len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "uses src_port (not the payload) as process identity, keeping payload app_id as a label":
        step("Verify: uses src_port (not the payload) as process identity, keeping payload app_id as a label")
        # @req: REQ-OS-WmServMeta-001
        # SECURITY (hardening item 3): process_id ownership identity is
        # authoritative from the kernel-verified src_port; a payload-supplied
        # process_id (here 1234, a spoof attempt) must never override it.
        # app_id remains a display label sourced from the payload.
        val wm = WmService.new()
        var payload: [u8] = []
        push_u32(payload, 7)
        for ch in "Browser":
            payload.push(ch.to_u8())
        push_i32(payload, 10)
        push_i32(payload, 20)
        push_i32(payload, 640)
        push_i32(payload, 480)
        push_u64(payload, 1234)
        push_u32(payload, 12)
        for ch in "/sys/browser":
            payload.push(ch.to_u8())
        val action = wm.parse_create_window(77, unsafe_addr_of(payload), payload.len().to_u32())
        expect(action.process_id).to_equal(77)  # oracle: value fixed by the spec contract
        expect(action.app_id).to_equal("/sys/browser")

    it "uses authenticated sender PID instead of reply port or spoofed payload PID":
        step("Verify: uses authenticated sender PID instead of reply port or spoofed payload PID")
        # @req: REQ-OS-WmServMeta-001
        val wm = WmService.new()
        var payload: [u8] = []
        push_u32(payload, 7)
        for ch in "Browser":
            payload.push(ch.to_u8())
        push_i32(payload, 10)
        push_i32(payload, 20)
        push_i32(payload, 640)
        push_i32(payload, 480)
        push_u64(payload, 9999)
        val action = wm.parse_create_window_authenticated(
            77, 1234, unsafe_addr_of(payload), payload.len().to_u32()
        )
        expect(action.process_id).to_equal(1234)  # oracle: value fixed by the spec contract
        expect(action.owner_port).to_equal(77)  # oracle: value fixed by the spec contract

    it "rejects create when the kernel cannot authenticate a sender PID":
        step("Verify: rejects create when the kernel cannot authenticate a sender PID")
        # @req: REQ-OS-WmServMeta-001
        val wm = WmService.new()
        var payload: [u8] = []
        push_u32(payload, 1)
        payload.push(65)
        push_i32(payload, 0)
        push_i32(payload, 0)
        push_i32(payload, 10)
        push_i32(payload, 10)
        push_u64(payload, 2222)
        val action = wm.parse_create_window_authenticated(
            77, 0, unsafe_addr_of(payload), payload.len().to_u32()
        )
        expect(action.kind).to_equal("none")

    it "falls back to launcher-owned app identity when app_id is omitted, still keyed by src_port":
        step("Verify: falls back to launcher-owned app identity when app_id is omitted, still keyed by src_port")
        # @req: REQ-OS-WmServMeta-001
        launcher_init()
        launcher_register("Browser Demo", "/sys/apps/browser_demo", "B", 0x42, 0)
        val recorded = launcher_record_process(77, 0, "running", 0, 0, true)
        expect(recorded).to_be(true)

        val wm = WmService.new()
        var payload: [u8] = []
        push_u32(payload, 7)
        for ch in "Browser":
            payload.push(ch.to_u8())
        push_i32(payload, 10)
        push_i32(payload, 20)
        push_i32(payload, 640)
        push_i32(payload, 480)
        push_u64(payload, 4321)

        val action = wm.parse_create_window(77, unsafe_addr_of(payload), payload.len().to_u32())
        expect(action.process_id).to_equal(77)  # oracle: value fixed by the spec contract
        expect(action.app_id).to_equal("/sys/apps/browser_demo")

    it "reuses launcher and WM ownership contract for RISC-V SMF GUI apps":
        step("Verify: reuses launcher and WM ownership contract for RISC-V SMF GUI apps")
        # @req: REQ-OS-WmServMeta-001
        launcher_init()
        launcher_register("Browser Demo", "/sys/apps/browser_demo.smf", "B", 0x42, 1)
        val pid: u64 = 1002
        val recorded = launcher_record_process(pid, 3, "running", 0, 0, true)
        expect(recorded).to_be(true)

        val wm = WmService.new()
        wm.register_window_owner_with_identity(WindowId(value: 1), 0, pid, "/sys/apps/browser_demo.smf")
        launcher_note_window_opened(pid)

        expect(launcher_process_is_process_backed(pid)).to_equal(true)
        expect(launcher_get_process_app_id_for_pid(pid)).to_equal("/sys/apps/browser_demo.smf")
        expect(launcher_get_process_window_count(0)).to_equal(1)  # oracle: value fixed by the spec contract
        expect(wm.window_owner_process_id(1)).to_equal(pid)
        expect(wm.window_owner_app_id(1)).to_equal("/sys/apps/browser_demo.smf")

        expect(desktop_app_ownership_valid(pid, "/sys/apps/browser_demo.smf", 1, 1, pid, "/sys/apps/browser_demo.smf")).to_equal(true)
        expect(desktop_app_ownership_marker(pid, "/sys/apps/browser_demo.smf", 1, 1)).to_equal("[desktop-e2e] process-backed:ok app=/sys/apps/browser_demo.smf pid=1002")
