# @cover src/os/services/wm/wm_world.spl 60%
"""
# WmWorld Multi-Window Identity Specification

**Category:** Infrastructure
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Regression cover for bug
`selfhost_two_hop_field_method_mutation_lost_2026-07-27`. `WmService` reaches
its ECS component stores through `self.world.<store>` — two struct-field hops
across the imported `WorldBase`/`ComponentStore` types — and those mutating
calls were silently dropped, collapsing every window onto one entity.

The existing `wm_service_*` specs cannot cover this: they drive the service
through raw IPC payloads and are red at HEAD for an unrelated typing defect
(`undefined field 'value': cannot access field on value of type 'i64'`). This
spec exercises the same component stores directly through `WmWorld`, with three
windows so per-window state isolation is observable.
"""

use std.spec
use os.services.wm.wm_world.{WmWorld}

describe "WmWorld multi-window entity identity":
    """Three windows in one world must stay three distinct entities."""

    it "three spawned windows get distinct entity ids 256, 257, 258":
        """WmWorld pre-sizes its allocator with WorldBase.with_capacity(WM_MAX_WINDOWS)
        (256), so the first three fresh ids are 256, 257 and 258 — distinct, which
        is the whole point of the regression."""
        var world = WmWorld.new()
        world.spawn_window(101, 7001, 900, "calc")
        world.spawn_window(102, 7002, 901, "clock")
        world.spawn_window(103, 7001, 902, "hello")
        val e0 = world.find_entity_for_window(101)
        val e1 = world.find_entity_for_window(102)
        val e2 = world.find_entity_for_window(103)
        expect(e0.id).to_equal(256)
        expect(e1.id).to_equal(257)
        expect(e2.id).to_equal(258)
        assert_false(e0.is_null())
        assert_false(e1.is_null())
        assert_false(e2.is_null())

    it "per-window owner port, process and app id stay isolated":
        var world = WmWorld.new()
        world.spawn_window(101, 7001, 900, "calc")
        world.spawn_window(102, 7002, 901, "clock")
        world.spawn_window(103, 7001, 902, "hello")
        expect(world.find_owner_port(101)).to_equal(7001)
        expect(world.find_owner_port(102)).to_equal(7002)
        expect(world.find_owner_port(103)).to_equal(7001)
        expect(world.process_id_for_window(101)).to_equal(900)
        expect(world.process_id_for_window(102)).to_equal(901)
        expect(world.process_id_for_window(103)).to_equal(902)
        expect(world.app_id_for_window(101)).to_equal("calc")
        expect(world.app_id_for_window(102)).to_equal("clock")
        expect(world.app_id_for_window(103)).to_equal("hello")

    it "counts group windows by port, process and app without cross-talk":
        var world = WmWorld.new()
        world.spawn_window(101, 7001, 900, "calc")
        world.spawn_window(102, 7002, 901, "clock")
        world.spawn_window(103, 7001, 902, "hello")
        expect(world.count_for_port(7001)).to_equal(2)
        expect(world.count_for_port(7002)).to_equal(1)
        expect(world.count_for_port(7003)).to_equal(0)
        expect(world.count_for_process(900)).to_equal(1)
        expect(world.count_for_app("calc")).to_equal(1)
        expect(world.count_for_app("nosuchapp")).to_equal(0)

    it "despawning the middle window leaves the two siblings intact":
        var world = WmWorld.new()
        world.spawn_window(101, 7001, 900, "calc")
        world.spawn_window(102, 7002, 901, "clock")
        world.spawn_window(103, 7001, 902, "hello")
        expect(world.despawn_window(102)).to_equal(true)
        expect(world.despawn_window(102)).to_equal(false)
        assert_true(world.find_entity_for_window(102).is_null())
        expect(world.find_owner_port(101)).to_equal(7001)
        expect(world.find_owner_port(103)).to_equal(7001)
        expect(world.app_id_for_window(101)).to_equal("calc")
        expect(world.app_id_for_window(103)).to_equal("hello")
        expect(world.count_for_port(7001)).to_equal(2)
        expect(world.count_for_port(7002)).to_equal(0)

    it "set_identity rewrites only the targeted window":
        var world = WmWorld.new()
        world.spawn_window(101, 7001, 900, "calc")
        world.spawn_window(102, 7002, 901, "clock")
        world.spawn_window(103, 7001, 902, "hello")
        world.set_identity(102, 999, "renamed")
        expect(world.process_id_for_window(102)).to_equal(999)
        expect(world.app_id_for_window(102)).to_equal("renamed")
        expect(world.process_id_for_window(101)).to_equal(900)
        expect(world.app_id_for_window(101)).to_equal("calc")
        expect(world.process_id_for_window(103)).to_equal(902)
        expect(world.app_id_for_window(103)).to_equal("hello")
