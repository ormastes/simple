"""Netstack descriptors stay bound to the endpoint that created them."""

use std.spec.{describe, it, expect}
use os.services.netstack.ipv4.{Ipv4Address}
use os.services.netstack.socket.{SocketTable, SocketProtocol, SockAddr}

describe "netstack socket endpoint ownership":
    it "denies a different endpoint's descriptor":
        var sockets = SocketTable.new()
        val fd = sockets.create_for_owner(SocketProtocol.Tcp, 101u64)
        expect(sockets.owned_by(fd, 101u64)).to_equal(true)
        expect(sockets.owned_by(fd, 202u64)).to_equal(false)
        expect(sockets.owned_by(fd, 0u64)).to_equal(false)

    it "fails closed for unowned descriptors and foreign mutations":
        var sockets = SocketTable.new()
        val unowned = sockets.create(SocketProtocol.Tcp)
        val owned = sockets.create_for_owner(SocketProtocol.Tcp, 101u64)
        val addr = SockAddr(ip: Ipv4Address.from_u32(0x0A00020Fu32), port: 8080u16)

        expect(sockets.bind_for_owner(unowned, 101u64, addr).is_err()).to_equal(true)
        expect(sockets.bind_for_owner(owned, 202u64, addr).is_err()).to_equal(true)
        expect(sockets.bind_for_owner(owned, 101u64, addr).is_ok()).to_equal(true)
        expect(sockets.close_for_owner(owned, 202u64).is_err()).to_equal(true)

    it "keeps an accepted descriptor with its listener owner":
        var sockets = SocketTable.new()
        val listener = sockets.create_for_owner(SocketProtocol.Tcp, 101u64)
        val addr = SockAddr(ip: Ipv4Address.from_u32(0x0A00020Fu32), port: 8080u16)

        expect(sockets.bind_for_owner(listener, 101u64, addr).is_ok()).to_equal(true)
        expect(sockets.listen_for_owner(listener, 101u64, 1u32).is_ok()).to_equal(true)
        sockets.queue_accepted(listener, 11u64)
        val accepted = sockets.accept_for_owner(listener, 101u64).unwrap()
        expect(sockets.owned_by(accepted, 101u64)).to_equal(true)
        expect(sockets.owned_by(accepted, 202u64)).to_equal(false)
