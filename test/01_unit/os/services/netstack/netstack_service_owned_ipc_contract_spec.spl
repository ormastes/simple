use std.spec.{describe, it, expect}

describe "netstack service owned IPC transport":
    it "creates only its named endpoint and receives copied records":
        val loop_source = file_read("src/os/services/netstack/_NetstackService/frame_processing.spl")
        val handler_source = file_read("src/os/services/netstack/_NetstackService/ipc_handlers.spl")
        expect(loop_source).to_contain("ipc_create_named_port(\"net\")")
        expect(loop_source).to_contain("syscall(SYS_YIELD")
        expect(handler_source).to_contain("ipc_recv_owned_v1_into(self.port_id, self.receive_buffer)")
        expect(handler_source).to_contain("self._dispatch_ipc(self.receive_buffer.ptr() as u64)")

    it "uses authenticated copied replies instead of legacy raw sends":
        val helper_source = file_read("src/os/services/netstack/_NetstackService/proto_helpers.spl")
        expect(helper_source).to_contain("ipc_reply_owned_v1(dst_port, 0u32, data, src_port)")
