use os.services.launcher.primary_tool_artifact_gate.{
    primary_tool_path_requires_loader_authority_v1,
    LAUNCHER_PRIMARY_TOOL_BLOCKED
}
use os.services.launcher.launcher_registry.{launcher_launch_path_with_args}

describe "primary filesystem tool launcher boundary":
    it "recognizes exactly the selected canonical tool paths":
        expect(primary_tool_path_requires_loader_authority_v1(
            "/usr/bin/sha256sum")).to_be(true)
        expect(primary_tool_path_requires_loader_authority_v1(
            "/usr/bin/md5sum")).to_be(true)
        expect(primary_tool_path_requires_loader_authority_v1(
            "/usr/bin/grep")).to_be(true)
        expect(primary_tool_path_requires_loader_authority_v1(
            "/usr/bin/ps")).to_be(true)
        expect(primary_tool_path_requires_loader_authority_v1(
            "/usr/bin/sed")).to_be(false)
        expect(primary_tool_path_requires_loader_authority_v1("grep")).to_be(false)

    it "rejects every selected path before generic process spawn":
        expect(launcher_launch_path_with_args(
            "/usr/bin/sha256sum", ["--version"])).to_equal(
                -(LAUNCHER_PRIMARY_TOOL_BLOCKED as i64))
        expect(launcher_launch_path_with_args(
            "/usr/bin/md5sum", ["--help"])).to_equal(
                -(LAUNCHER_PRIMARY_TOOL_BLOCKED as i64))
        expect(launcher_launch_path_with_args(
            "/usr/bin/grep", ["needle", "/tmp/input"])).to_equal(
                -(LAUNCHER_PRIMARY_TOOL_BLOCKED as i64))
        expect(launcher_launch_path_with_args(
            "/usr/bin/ps", [])).to_equal(
                -(LAUNCHER_PRIMARY_TOOL_BLOCKED as i64))
