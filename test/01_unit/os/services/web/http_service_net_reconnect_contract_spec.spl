"""HTTP must reconnect through the named capability after net service death."""

use std.spec.{describe, it, expect}
use std.fs.{read_text}
use os.services.web.http_service_main.{NativeHttpService}

describe "native HTTP service net reconnection":
    it "drops every provider-owned descriptor before reconnecting":
        var service = NativeHttpService.new()
        service.net_port_id = 41u64
        service.listener_fd = 7i32
        service.client_fd = 8i32
        service.note_net_peer_loss()
        expect(service.net_port_id).to_equal(0u64)
        expect(service.listener_fd).to_equal(-1i32)
        expect(service.client_fd).to_equal(-1i32)

    it "uses the granted named endpoint and a bounded missing-reply deadline":
        val source = read_text("src/os/services/web/http_service_main.spl")
        expect(source).to_contain("HTTP_NET_REPLY_DEADLINE_YIELDS")
        expect(source).to_contain("ipc_connect_named_port(\"net\")")
        expect(source).to_contain("self.note_net_peer_loss()")
        expect(source).to_contain("self._request_socket()")
        expect(source).to_contain("_http_u64(bytes, 0u64) != self.net_port_id")
