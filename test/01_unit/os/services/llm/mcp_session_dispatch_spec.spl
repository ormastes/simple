"""
OsMcpServer session dispatch capability specification.

The legacy `dispatch` entry point is intentionally compatibility-only.  These
tests exercise `dispatch_for_session`, which takes a real sealed LlmSession and
therefore has no ambient-authority fallback.
"""

use std.spec.{describe, it, expect}
use common.ui.widget.{WidgetNode}
use common.ui.builder.{build_tree}
use nogc_sync_mut.ui.session.{UISession}
use os.services.vfs.vfs.{VfsManager}
use os.services.llm.cli_gui_bridge.{CliGuiBridge}
use os.services.llm.mcp_os_server.{OsMcpServer}
use os.kernel.types.capability_types.{CapabilityToken, CapabilityKind, CapabilitySet}
use os.kernel.ipc.llm_session.{LlmSession}
use os.services.llm.mcp_tool_gate.{SVC_UI}

fn _token(kind: CapabilityKind, token_id: u64) -> CapabilityToken:
    CapabilityToken(
        kind: kind,
        generation: 1u64,
        owner: 88u64,
        token_id: token_id,
        parent_token_id: 0u64,
        depth: 1
    )

fn _session(caps: [CapabilityToken]) -> LlmSession:
    LlmSession(
        role: "test",
        session_id: 88u64,
        image_hash: "blake3:mcp-session-dispatch",
        caps: CapabilitySet(caps: caps, is_pledged: true),
        sealed: true,
        rejected: 0,
        grant_labels: []
    )

fn _server() -> OsMcpServer:
    val tree = build_tree(WidgetNode.new("root", "panel"))
    val bridge = CliGuiBridge.new(UISession.new(tree))
    OsMcpServer.new(VfsManager.new(), bridge)

describe "OsMcpServer session-bearing dispatch":
    it "keeps legacy dispatch compatible without inventing a session":
        val result = _server().dispatch("system_info", "")
        expect(result).to_contain("simpleos")

    it "fails closed when a sealed session lacks the mapped capability":
        val result = _server().dispatch_for_session(_session([]), "system_info", "")
        expect(result).to_equal("error: unknown or unauthorized tool")

    it "allows system info only for a session holding SystemTime":
        val session = _session([_token(CapabilityKind.SystemTime, 1u64)])
        val result = _server().dispatch_for_session(session, "system_info", "")
        expect(result).to_contain("simpleos")

    it "checks file capability against the requested path rather than root discovery":
        val session = _session([_token(CapabilityKind.FileRead(path_prefix: "/workspace"), 2u64)])
        val outside = _server().dispatch_for_session(session, "file_read", "{\"path\":\"/etc/shadow\"}")
        expect(outside).to_equal("error: unknown or unauthorized tool")

    it "rejects traversal aliases before the VFS can normalize them":
        val session = _session([_token(CapabilityKind.FileRead(path_prefix: "/workspace"), 3u64)])
        val traversal = _server().dispatch_for_session(session, "file_read", "{\"path\":\"/workspace/../etc/shadow\"}")
        expect(traversal).to_equal("error: unknown or unauthorized tool")

    it "permits an in-scope file invocation to reach the underlying handler":
        val session = _session([_token(CapabilityKind.FileRead(path_prefix: "/workspace"), 4u64)])
        val result = _server().dispatch_for_session(session, "file_read", "{\"path\":\"/workspace/missing\"}")
        expect(result == "error: unknown or unauthorized tool").to_be(false)

    it "routes UI calls only through the UI service endpoint capability":
        val session = _session([_token(CapabilityKind.IpcConnect(port_name: SVC_UI), 5u64)])
        val result = _server().dispatch_for_session(session, "ui_access_snapshot", "")
        expect(result).to_contain("protocol_version")
