extern fn rt_file_read_text(path: text) -> text

describe("QEMU runner platform lane imports"):
    it("imports every platform lane helper used by scenario execution"):
        val runner = rt_file_read_text("src/os/_QemuRunner/scenario_exec.spl") ?? ""
        expect(runner.contains("simpleos_platform_qemu_lane_or_smoke,")).to_equal(true)
        expect(runner.contains("simpleos_platform_has_qemu_lane,")).to_equal(true)

    it("keeps both helpers exported by the platform facade"):
        val facade = rt_file_read_text("src/os/port/simpleos_multiplatform_build.spl") ?? ""
        expect(facade.contains("simpleos_platform_qemu_lane_or_smoke, simpleos_platform_has_qemu_lane,")).to_equal(true)
