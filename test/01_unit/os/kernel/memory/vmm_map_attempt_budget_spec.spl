use std.spec.{describe, it, expect}
use os.kernel.boot.mmio.{mmio_reset_for_test, mmio_disable_test_mode}
use os.kernel.memory.vmm_core.{vmm_map_attempt_allowed, vmm_set_map_failure_after_for_test, vmm_clear_map_failure_for_test}

describe "VMM deterministic map failure budget":
    it "permits the configured number then rejects later attempts":
        mmio_reset_for_test()
        vmm_set_map_failure_after_for_test(2)
        val first = vmm_map_attempt_allowed()
        val second = vmm_map_attempt_allowed()
        val third = vmm_map_attempt_allowed()
        vmm_clear_map_failure_for_test()
        mmio_disable_test_mode()
        expect(first).to_equal(true)
        expect(second).to_equal(true)
        expect(third).to_equal(false)

    it "rejects a zero budget and permits attempts after clearing":
        mmio_reset_for_test()
        vmm_set_map_failure_after_for_test(0)
        val blocked = vmm_map_attempt_allowed()
        vmm_clear_map_failure_for_test()
        val restored = vmm_map_attempt_allowed()
        mmio_disable_test_mode()
        expect(blocked).to_equal(false)
        expect(restored).to_equal(true)

    it "does not enforce a stale test budget outside MMIO test mode":
        mmio_reset_for_test()
        vmm_set_map_failure_after_for_test(0)
        mmio_disable_test_mode()
        val allowed = vmm_map_attempt_allowed()
        vmm_clear_map_failure_for_test()
        expect(allowed).to_equal(true)
