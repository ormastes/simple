# Unit evidence for the production copy-in decoder after user bytes are copied.
# These fixtures do not exercise MMIO, address translation or a live guest.
use std.spec.{describe, it, expect}
use os.kernel.memory.vmm_copy.{_vmm_copy_cstr_utf8}
use std.common.string_core.{text_to_utf8_bytes}

describe "VMM execve copied UTF-8 text":
    it "preserves non-ASCII bytes and counts the consumed NUL":
        val result = _vmm_copy_cstr_utf8([195u8, 169u8, 240u8, 159u8, 152u8, 128u8])
        expect(result.status.ok).to_equal(true)
        expect(result.status.bytes_read).to_equal(7u64)
        expect(text_to_utf8_bytes(result.value)).to_equal([195u8, 169u8, 240u8, 159u8, 152u8, 128u8])

    it "preserves an empty argument without inventing a byte":
        val result = _vmm_copy_cstr_utf8([])
        expect(result.status.ok).to_equal(true)
        expect(result.status.bytes_read).to_equal(1u64)
        expect(result.value).to_equal("")

    it "rejects malformed copied bytes with EINVAL and no replacement text":
        val result = _vmm_copy_cstr_utf8([237u8, 160u8, 128u8])
        expect(result.status.ok).to_equal(false)
        expect(result.status.errno).to_equal(22)
        expect(result.status.bytes_read).to_equal(4u64)
        expect(result.value).to_equal("")
