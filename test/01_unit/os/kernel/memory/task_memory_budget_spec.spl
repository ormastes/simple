"""Mapped-page task budget accounting is bounded and releasable."""

use std.spec.{describe, it, expect}
use os.kernel.memory.task_memory_budget.{
    task_memory_budget_pages, task_memory_budget_reserve,
    task_memory_budget_release, task_memory_budget_clear
}
use os.kernel.types.task_types.{TaskId}

describe "task mapped-page budget":
    it "enforces an exact limit and restores capacity after release or exit":
        val owner = TaskId(id: 992u64)
        task_memory_budget_clear(owner)
        expect(task_memory_budget_reserve(owner, 3u64, 2u64)).to_equal(true)
        expect(task_memory_budget_pages(owner)).to_equal(2u64)
        expect(task_memory_budget_reserve(owner, 3u64, 2u64)).to_equal(false)
        expect(task_memory_budget_reserve(owner, 3u64, 1u64)).to_equal(true)
        expect(task_memory_budget_pages(owner)).to_equal(3u64)
        expect(task_memory_budget_release(owner, 1u64)).to_equal(true)
        expect(task_memory_budget_pages(owner)).to_equal(2u64)
        task_memory_budget_clear(owner)
        expect(task_memory_budget_pages(owner)).to_equal(0u64)
        expect(task_memory_budget_reserve(owner, 3u64, 3u64)).to_equal(true)
