# @cover src/os/kernel/memory/vmm.spl 1%
extern fn rt_file_read_text(path: text) -> text

# Regression for vmm_static_visibility_cranelift_ice_2026-10-25: private =
# same file only, so a vmm.spl static that vmm_vma / vmm_copy /
# vmm_address_space (or any other file) imports must be declared `pub`.
# Cranelift AOT rejects importing a non-public static ("imported non-public
# module static ... requires visibility-preserving accessor support").
# Source-shape spec: it reads the file, it does not native-build it.
describe "vmm static visibility":
    it "declares every cross-file imported vmm val as pub":
        val vmm = rt_file_read_text("src/os/kernel/memory/vmm.spl") ?? ""
        val vals = ["PAGE_SIZE", "ENTRIES_PER_TABLE", "PTE_PRESENT", "PTE_WRITABLE", "PTE_USER",
            "PTE_WRITE_THROUGH", "PTE_CACHE_DISABLE", "PTE_HUGE_PAGE", "PTE_NO_EXECUTE", "PTE_ADDR_MASK",
            "VMM_U64_MAX", "VMM_MAX_VMAS", "VMM_VMA_ANON", "VMM_VMA_FILE", "VMM_VMA_SHARED",
            "VMM_VMA_EXEC", "VMM_VMA_COW", "VMM_KERNEL_SPACE_START"]
        for name in vals:
            expect(vmm.contains("\npub val {name}:")).to_equal(true)
            expect(vmm.contains("\nval {name}:")).to_equal(false)

    it "declares the imported vmm globals as pub var":
        val vmm = rt_file_read_text("src/os/kernel/memory/vmm.spl") ?? ""
        for name in ["g_vmm", "g_next_as_id"]:
            expect(vmm.contains("\npub var {name}:")).to_equal(true)
            expect(vmm.contains("\nvar {name}:")).to_equal(false)
