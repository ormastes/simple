use std.spec.{describe, it, expect}

describe "MapBar authority boundary":
    it "binds syscall 83 to the exact BDF and BAR capability":
        val source = file_read("src/os/kernel/ipc/syscall.spl")
        expect(source).to_contain("val bar_bdf = args.arg0")
        expect(source).to_contain("val bar_index = args.arg1")
        expect(source).to_contain("CapabilityKind.DeviceBarMap(")
        expect(source).to_contain("bdf_bus: pci_bdf_bus(bar_bdf)")
        expect(source).to_contain("bar_index: bar_index.to_u8()")

    it "resolves the BAR in the kernel and rejects raw physical input":
        val source = file_read("src/os/kernel/ipc/syscall_device.spl")
        expect(source).to_contain("fn _pci_memory_bar_phys")
        expect(source).to_contain("val bar_phys = _pci_memory_bar_phys(bus, dev, func, index)")
        expect(source).to_contain("if low == 0u32 or (low & 1u32) != 0u32")
        expect(source).to_contain("while rollback < offset:")
        expect(source).to_equal(source.replace("val bar_phys = args.arg0 as u64", ""))

    it "resolves assigned 64-bit BARs directly without a branch-local binding":
        val source = file_read("src/os/kernel/ipc/syscall_device.spl")
        expect(source).to_contain("val low_phys = low.to_u64() & 0xFFFFFFF0u64")
        expect(source).to_contain("return (pci_read_bar(bus, dev, func, 1u8).to_u64() << 32u64) | low_phys")
        expect(source.contains("val bar_high_word")).to_equal(false)

    it "requires a DeviceGrant-shaped user API rather than physical ranges":
        val source = file_read("src/os/userlib/device.spl")
        expect(source).to_contain("fn map_bar(grant: DeviceGrant, bar_index: u8)")
        expect(source).to_contain("pci_bdf_pack(grant.pci_bus, grant.pci_dev, grant.pci_func)")
        expect(source).to_equal(source.replace("fn map_bar(phys_addr: u64, size: u64)", ""))

    it "treats a materialized DeviceGrant as a one-shot task/BDF lease":
        val source = file_read("src/os/kernel/ipc/syscall_device.spl")
        expect(source).to_contain("fn _device_grant_claim_once(owner: TaskId, bdf: u64) -> bool")
        expect(source).to_contain("pub fn device_grant_revoke_task(owner: TaskId) -> u64")
        expect(source).to_contain("return SyscallResult(value: -16)")

    it "resolves a broker-assigned device from exactly one CSpace grant":
        val kernel_source = file_read("src/os/kernel/ipc/syscall.spl")
        val user_source = file_read("src/os/userlib/device.spl")
        expect(kernel_source).to_contain("val DEVICE_GRANT_ASSIGNED: u64 = 0xFFFFFFFFFFFFFFFEu64")
        expect(kernel_source).to_contain("capability_set_assigned_device_grant_bdf")
        expect(user_source).to_contain("fn request_assigned_device_grant() -> Result<DeviceGrant, text>")
