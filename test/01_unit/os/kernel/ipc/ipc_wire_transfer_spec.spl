"""
# Ring-3 IPC Message Transfer Specification

**Feature IDs:** #simpleos-ipc-ring3-transfer
**Category:** SimpleOS / IPC / ABI
**Status:** Implemented

## Overview

A ring-3 client and the SimpleOS compositor only talk if three things hold:
a send actually carries its payload bytes onto the destination port queue, a
receive hands those bytes back in the 32-byte envelope both sides agree on,
and a port can be found by the name the client asked for. Before this spec
none of the three held — send discarded the payload, recv returned a bare 0
and wrote nothing to the caller, and every port was registered under the
literal name "port".

This spec pins the wire layout, the send/recv round trip, the named-port
lookup, and the fail-closed behaviour on an oversized payload or a bad ring-3
pointer.

## Requirements

**Requirements:** N/A

## Syntax

```sh
bin/simple test test/01_unit/os/kernel/ipc/ipc_wire_transfer_spec.spl
```
"""

use std.spec.{describe, it, expect, step, assert_true, assert_false, assert_equal}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.ipc_types.{IpcMessage}
use os.kernel.types.syscall_types.{SyscallArgs}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.ipc.ipc_wire.{
    ipc_wire_encode, ipc_wire_read_u32, ipc_wire_read_u64,
    ipc_wire_payload_method, ipc_user_range_check,
    IPC_WIRE_HEADER_SIZE, IPC_WIRE_PAYLOAD_MAX, IPC_WIRE_CAPACITY, IPC_WIRE_V1_FLAG
}
use os.kernel.ipc.syscall_ipc.{
    _handle_ipc_recv_state, _handle_ipc_send_state,
    ipc_decode_send_args, ipc_decode_recv_args,
    ipc_check_user_read, ipc_check_user_write
}
use os.kernel.scheduler.scheduler.{Scheduler}

# A page-aligned address inside the user half of the canonical address space.
val USER_OK_PTR: u64 = 1048576u64          # 0x100000
# First address of the kernel half — must never be accepted from ring-3.
val KERNEL_PTR: u64 = 140737488355328u64   # 0x0000_8000_0000_0000

fn _payload_with_method(method: u32, extra: i64) -> [u8]:
    """Build a compositor-style payload: method word first, then filler."""
    var bytes: [u8] = []
    var i: i64 = 0
    while i < 4:
        val shift = (i * 8).to_u64()
        bytes.push(((method.to_u64() >> shift) & 255u64).to_u8())
        i = i + 1
    i = 0
    while i < extra:
        bytes.push((65 + (i % 26)).to_u8())
        i = i + 1
    bytes

fn _header(src_port: u64, dst_port: u64, method: u32) -> IpcMessage:
    IpcMessage(
        src_port: src_port,
        dst_port: dst_port,
        method: method,
        flags: IPC_WIRE_V1_FLAG,
        payload_len: 0u32,
        cap_count: 0u32
    )

describe "IPC wire envelope":
    """The 32-byte header every side of the compositor protocol reads."""
    it "lays the header out exactly as the ring-3 client reads it":
        step("Encode an envelope with a 6-byte payload")
        val payload = _payload_with_method(3u32, 2)
        val wire = ipc_wire_encode(11u64, 22u64, 3u32, IPC_WIRE_V1_FLAG, payload)

        step("Header fields sit at +0/+8/+16/+20/+24/+28 little-endian")
        assert_equal(wire.len(), IPC_WIRE_HEADER_SIZE + 6)
        assert_equal(ipc_wire_read_u64(wire, 0), 11u64)
        assert_equal(ipc_wire_read_u64(wire, 8), 22u64)
        assert_equal(ipc_wire_read_u32(wire, 16), 3u32)
        assert_equal(ipc_wire_read_u32(wire, 20), IPC_WIRE_V1_FLAG)
        assert_equal(ipc_wire_read_u32(wire, 24), 6u32)
        assert_equal(ipc_wire_read_u32(wire, 28), 0u32)

        step("Payload starts at +32")
        assert_equal(ipc_wire_read_u32(wire, IPC_WIRE_HEADER_SIZE), 3u32)

    it "never emits a payload_len larger than the one payload page":
        step("Encode an over-long payload")
        val payload = _payload_with_method(1u32, IPC_WIRE_PAYLOAD_MAX + 64)
        val wire = ipc_wire_encode(1u64, 2u64, 1u32, 0u32, payload)

        step("Both the byte count and the advertised length stop at the cap")
        assert_equal(wire.len(), IPC_WIRE_CAPACITY)
        assert_equal(ipc_wire_read_u32(wire, 24), IPC_WIRE_PAYLOAD_MAX.to_u32())

    it "lifts the compositor method out of the first payload word":
        val payload = _payload_with_method(7u32, 4)
        assert_equal(ipc_wire_payload_method(payload), 7u32)

        step("A payload shorter than one word carries no method")
        var short_payload: [u8] = []
        short_payload.push(9u8)
        assert_equal(ipc_wire_payload_method(short_payload), 0u32)

describe "IPC user-pointer policy":
    """Which ring-3 buffer ranges the kernel will touch, and which it refuses."""
    it "accepts a plain user-half buffer":
        assert_equal(ipc_user_range_check(USER_OK_PTR, 4128u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0)

    it "rejects a null or low-page pointer with EFAULT":
        assert_equal(ipc_user_range_check(0u64, 64u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 14)
        assert_equal(ipc_user_range_check(8u64, 64u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 14)

    it "rejects a kernel-half pointer with EFAULT":
        assert_equal(ipc_user_range_check(KERNEL_PTR, 64u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 14)

    it "rejects a range that runs off the end of the user half":
        val near_top = KERNEL_PTR - 16u64
        assert_equal(ipc_user_range_check(near_top, 64u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 14)

    it "rejects an arithmetic wraparound with EFAULT":
        # 2^64 - 256, written as wrapping arithmetic: a literal that large is
        # rejected by the linter's parser (see
        # doc/08_tracking/bug/u64_literal_above_i64_max_parse_2026-08-05.md).
        val huge: u64 = 0u64 - 256u64
        assert_equal(ipc_user_range_check(huge, 1024u64, 1u64, 65536u64), 0 - 14)

    it "rejects a length outside the accepted band with EINVAL":
        assert_equal(ipc_user_range_check(USER_OK_PTR, 99999u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 22)
        assert_equal(ipc_user_range_check(USER_OK_PTR, 0u64, 1u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 22)

    it "rejects a zero-length receive destination so no message is consumed":
        assert_equal(ipc_check_user_write(1u64, USER_OK_PTR, 0u64, IPC_WIRE_CAPACITY.to_u64()), 0 - 22)

    it "admits a well-formed source and destination range":
        assert_equal(ipc_check_user_read(1u64, USER_OK_PTR, 64u64, IPC_WIRE_PAYLOAD_MAX.to_u64()), 0)
        assert_equal(ipc_check_user_write(1u64, USER_OK_PTR, 4128u64, IPC_WIRE_CAPACITY.to_u64()), 0)

describe "IPC syscall argument decoding":
    """Which register carries what, for both the canonical and legacy forms."""
    it "reads the canonical send form (dst, src, ptr, len)":
        val decoded = ipc_decode_send_args(5u64, 9u64, USER_OK_PTR, 24u64, 0u64)
        assert_equal(decoded.dst_port, 5u64)
        assert_equal(decoded.src_port, 9u64)
        assert_equal(decoded.payload_ptr, USER_OK_PTR)
        assert_equal(decoded.payload_len, 24u64)

    it "reads the legacy send form when a4 carries the length":
        val decoded = ipc_decode_send_args(5u64, 3u64, 0u64, USER_OK_PTR, 24u64)
        assert_equal(decoded.dst_port, 5u64)
        assert_equal(decoded.method, 3u32)
        assert_equal(decoded.payload_ptr, USER_OK_PTR)
        assert_equal(decoded.payload_len, 24u64)

    it "reads the canonical recv form (timeout, flags, buf, cap)":
        val decoded = ipc_decode_recv_args(5u64, 4294967295u64, 0u64, USER_OK_PTR, 4128u64)
        assert_equal(decoded.port_id, 5u64)
        assert_equal(decoded.timeout_ms, 4294967295)
        assert_equal(decoded.buf_ptr, USER_OK_PTR)
        assert_equal(decoded.buf_cap, 4128u64)

    it "does not mistake a blocking timeout for a destination buffer":
        step("wm_service-style poll: (port, timeout 0, poll flag 1, 0, 0)")
        val poll = ipc_decode_recv_args(5u64, 0u64, 1u64, 0u64, 0u64)
        assert_equal(poll.buf_ptr, 0u64)
        assert_equal(poll.poll_flags, 1u64)

        step("Blocking with no buffer: 0xFFFFFFFF must stay a timeout")
        val blocking = ipc_decode_recv_args(5u64, 4294967295u64, 0u64, 0u64, 0u64)
        assert_equal(blocking.buf_ptr, 0u64)
        assert_equal(blocking.timeout_ms, 4294967295)

    it "reads the legacy recv form (buf, cap) when nothing else fits":
        val decoded = ipc_decode_recv_args(5u64, USER_OK_PTR, 4096u64, 0u64, 0u64)
        assert_equal(decoded.buf_ptr, USER_OK_PTR)
        assert_equal(decoded.buf_cap, 4096u64)
        assert_equal(decoded.timeout_ms, 0)

describe "IPC manager payload transfer":
    """A sent payload reaches the destination queue and comes back intact."""
    it "stores the payload bytes on the destination queue":
        step("Create a compositor port and send a 12-byte payload to it")
        var mgr = IpcManager.new()
        val compositor = TaskId(id: 1)
        val port = mgr.create_named_port(compositor, "compositor")
        val payload = _payload_with_method(3u32, 8)
        val rc = mgr.send_with_payload(_header(77u64, port.id, 3u32), payload)

        step("The send is accepted and the bytes are accounted to the queue")
        assert_equal(rc, 0)
        assert_equal(mgr.queued_message_count(port.id), 1)
        assert_equal(mgr.queued_owned_payload_bytes(port.id), 12u64)

    it "returns those bytes as a wire envelope on receive":
        var mgr = IpcManager.new()
        val compositor = TaskId(id: 1)
        val port = mgr.create_named_port(compositor, "compositor")
        val payload = _payload_with_method(3u32, 8)
        val send_rc = mgr.send_with_payload(_header(77u64, port.id, 3u32), payload)
        assert_equal(send_rc, 0)

        step("Receive returns a 32-byte header plus the 12 payload bytes")
        val wire = mgr.recv_wire(port.id)
        assert_equal(wire.len(), IPC_WIRE_HEADER_SIZE + 12)
        assert_equal(ipc_wire_read_u64(wire, 0), 77u64)
        assert_equal(ipc_wire_read_u64(wire, 8), port.id)
        assert_equal(ipc_wire_read_u32(wire, 16), 3u32)
        assert_equal(ipc_wire_read_u32(wire, 24), 12u32)

        step("The v1 flag is stamped so a versioned client accepts it")
        val flags = ipc_wire_read_u32(wire, 20)
        assert_equal(flags & IPC_WIRE_V1_FLAG, IPC_WIRE_V1_FLAG)

        step("The payload survives byte-for-byte")
        assert_equal(ipc_wire_read_u32(wire, IPC_WIRE_HEADER_SIZE), 3u32)
        assert_equal(wire[IPC_WIRE_HEADER_SIZE + 4], 65u8)

        step("The message is consumed exactly once")
        assert_equal(mgr.queued_message_count(port.id), 0)
        assert_equal(mgr.recv_wire(port.id).len(), 0)

    it "rejects a payload larger than one page without queueing it":
        var mgr = IpcManager.new()
        val owner = TaskId(id: 1)
        val port = mgr.create_named_port(owner, "compositor")
        val oversized = _payload_with_method(3u32, IPC_WIRE_PAYLOAD_MAX)
        val rc = mgr.send_with_payload(_header(77u64, port.id, 3u32), oversized)

        assert_equal(rc, 0 - 4)
        assert_equal(mgr.queued_message_count(port.id), 0)

    it "reports an unknown destination port instead of dropping the payload":
        var mgr = IpcManager.new()
        val rc = mgr.send_with_payload(_header(77u64, 4242u64, 3u32), _payload_with_method(3u32, 4))
        assert_equal(rc, -1)

describe "IPC named ports":
    """Service discovery by the name the client actually asked for."""
    it "round-trips create by name and connect by name":
        step("The compositor registers its well-known name")
        var mgr = IpcManager.new()
        val compositor = TaskId(id: 1)
        val port = mgr.create_named_port(compositor, "compositor")
        expect(port.id).to_be_greater_than(0)

        step("A client resolves the same name to the same port")
        val resolved = mgr.connect("compositor")
        val found = resolved != nil
        assert_true(found)
        if resolved != nil:
            val target = resolved
            assert_equal(target.id, port.id)

        step("The registered name is readable back off the port")
        assert_equal(mgr.port_name(port.id), "compositor")

    it "does not resolve a name nobody registered":
        var mgr = IpcManager.new()
        val client = TaskId(id: 2)
        val _anon = mgr.create_named_port(client, "browser")
        assert_equal(mgr.connect("compositor"), nil)

    it "never resolves an anonymous port through an empty name":
        var mgr = IpcManager.new()
        val client = TaskId(id: 2)
        val anon = mgr.create_named_port(client, "")
        expect(anon.id).to_be_greater_than(0)
        assert_equal(mgr.connect(""), nil)

    it "refuses to shadow a live service name":
        var mgr = IpcManager.new()
        val first = mgr.create_named_port(TaskId(id: 1), "compositor")
        expect(first.id).to_be_greater_than(0)
        val second = mgr.create_named_port(TaskId(id: 2), "compositor")
        assert_equal(second.id, 0u64)

describe "IPC recv syscall":
    """Receive fills the caller's buffer, or fails without losing a message."""
    it "returns EAGAIN on an empty port when the caller asked not to block":
        step("Non-blocking recv with a valid destination buffer")
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val receiver = scheduler.get_current()
        val port = ipc.create_named_port(receiver, "empty_port")

        val state = _handle_ipc_recv_state(
            SyscallArgs(
                id: 21,
                arg0: port.id,
                arg1: 0,
                arg2: 0,
                arg3: USER_OK_PTR,
                arg4: 4128,
                arg5: 0
            ),
            scheduler,
            ipc
        )
        assert_equal(state.result.value, (0 - 11).to_i64())

    it "rejects a kernel-half destination pointer without consuming a message":
        step("Queue a message, then receive into a kernel address")
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val receiver = scheduler.get_current()
        val port = ipc.create_named_port(receiver, "guarded_port")
        val queued = ipc.send_with_payload(_header(77u64, port.id, 3u32), _payload_with_method(3u32, 4))
        assert_equal(queued, 0)

        val state = _handle_ipc_recv_state(
            SyscallArgs(
                id: 21,
                arg0: port.id,
                arg1: 0,
                arg2: 0,
                arg3: KERNEL_PTR,
                arg4: 4128,
                arg5: 0
            ),
            scheduler,
            ipc
        )

        step("EFAULT, and the message is still on the queue")
        assert_equal(state.result.value, (0 - 14).to_i64())
        assert_equal(state.ipc.queued_message_count(port.id), 1)

    it "rejects a destination buffer too small to hold one header":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val receiver = scheduler.get_current()
        val port = ipc.create_named_port(receiver, "tiny_buf_port")
        val queued = ipc.send_with_payload(_header(77u64, port.id, 3u32), _payload_with_method(3u32, 4))
        assert_equal(queued, 0)

        val state = _handle_ipc_recv_state(
            SyscallArgs(
                id: 21,
                arg0: port.id,
                arg1: 0,
                arg2: 0,
                arg3: USER_OK_PTR,
                arg4: 16,
                arg5: 0
            ),
            scheduler,
            ipc
        )
        assert_equal(state.result.value, (0 - 22).to_i64())
        assert_equal(state.ipc.queued_message_count(port.id), 1)

describe "IPC send syscall":
    """Send validates the ring-3 payload pointer before it copies anything."""
    it "rejects a kernel-half payload pointer with EFAULT":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val owner = scheduler.get_current()
        val port = ipc.create_named_port(owner, "compositor")

        val state = _handle_ipc_send_state(
            SyscallArgs(
                id: 20,
                arg0: port.id,
                arg1: 0,
                arg2: KERNEL_PTR,
                arg3: 32,
                arg4: 0,
                arg5: 0
            ),
            scheduler,
            ipc
        )
        assert_equal(state.result.value, (0 - 14).to_i64())
        assert_equal(state.ipc.queued_message_count(port.id), 0)

    it "rejects a payload longer than one page with EINVAL":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val owner = scheduler.get_current()
        val port = ipc.create_named_port(owner, "compositor")

        val state = _handle_ipc_send_state(
            SyscallArgs(
                id: 20,
                arg0: port.id,
                arg1: 0,
                arg2: USER_OK_PTR,
                arg3: 65536,
                arg4: 0,
                arg5: 0
            ),
            scheduler,
            ipc
        )
        assert_equal(state.result.value, (0 - 22).to_i64())
        assert_equal(state.ipc.queued_message_count(port.id), 0)

    it "queues an empty-payload message without touching user memory":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val owner = scheduler.get_current()
        val port = ipc.create_named_port(owner, "compositor")

        val state = _handle_ipc_send_state(
            SyscallArgs(
                id: 20,
                arg0: port.id,
                arg1: 42,
                arg2: 0,
                arg3: 0,
                arg4: 0,
                arg5: 0
            ),
            scheduler,
            ipc
        )
        assert_equal(state.result.value, 0)
        assert_equal(state.ipc.queued_message_count(port.id), 1)

        step("The envelope still names the source port the caller supplied")
        val wire = state.ipc.recv_wire(port.id)
        assert_equal(ipc_wire_read_u64(wire, 0), 42u64)
        assert_equal(ipc_wire_read_u32(wire, 24), 0u32)
