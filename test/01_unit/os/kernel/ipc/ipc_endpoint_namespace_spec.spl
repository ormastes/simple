use std.spec.{describe, it, expect}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.ipc_types.{IpcPort, IpcMessage, IpcFlags, OwnedIpcReceiveStatus}

"""Endpoint discovery is a concrete kernel namespace, not a wildcard."""

describe "IPC endpoint namespace":
    it "binds a port ID to its exact discovery name and owner":
        var ipc = IpcManager.new()
        val owner = TaskId(id: 17)
        val port = ipc.create_port(owner, "net")
        expect(port.id).to_be_greater_than(0)
        expect(ipc.port_name(port.id)).to_equal("net")
        expect(ipc.port_owned_by(port.id, owner)).to_equal(true)
        expect(ipc.port_owned_by(port.id, TaskId(id: 18))).to_equal(false)

    it "rejects duplicate names so a second task cannot shadow a service":
        var ipc = IpcManager.new()
        val first = ipc.create_port(TaskId(id: 1), "vfs")
        val duplicate = ipc.create_port(TaskId(id: 2), "vfs")
        expect(first.id).to_be_greater_than(0)
        expect(duplicate.id).to_equal(0)
        expect(ipc.port_name(first.id)).to_equal("vfs")

    it "does not resolve unknown endpoint IDs":
        val ipc = IpcManager.new()
        expect(ipc.port_name(999)).to_equal(nil)

    it "mints a one-shot reverse-pair right for an accepted owned request":
        var ipc = IpcManager.new()
        val client = TaskId(id: 31)
        val service = TaskId(id: 32)
        val client_port = ipc.create_port(client, "client")
        val service_port = ipc.create_port(service, "vfs")
        val request = IpcMessage(
            src_port: client_port.id, dst_port: service_port.id, method: 7u32,
            flags: IpcFlags.Async as u32, payload_len: 1u32, cap_count: 0u32
        )
        expect(ipc.send_owned(client, client_port.id, request, [1u8])).to_equal(0)
        val delivered = ipc.recv_owned(service, IpcPort(id: service_port.id, owner: service.id))
        expect(delivered.status).to_equal(OwnedIpcReceiveStatus.Delivered)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.reply_permit_allows(client, service_port.id, client_port.id)).to_equal(false)
        expect(ipc.consume_reply_permit(service, client_port.id, service_port.id)).to_equal(false)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.consume_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(false)

    it "revokes outstanding reply rights when an endpoint owner exits":
        var ipc = IpcManager.new()
        val client = TaskId(id: 41)
        val service = TaskId(id: 42)
        val client_port = ipc.create_port(client, "client-2")
        val service_port = ipc.create_port(service, "net")
        expect(ipc.grant_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        ipc.destroy_task_ports(client)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(false)

    it "consumes one right per accepted request for the same reverse pair":
        var ipc = IpcManager.new()
        val client = TaskId(id: 51)
        val service = TaskId(id: 52)
        val client_port = ipc.create_port(client, "reply-count-client")
        val service_port = ipc.create_port(service, "reply-count-service")
        expect(ipc.grant_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.grant_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.consume_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.consume_reply_permit(service, service_port.id, client_port.id)).to_equal(true)
        expect(ipc.reply_permit_allows(service, service_port.id, client_port.id)).to_equal(false)

    it "accepts one copied reply and rejects replay without changing the queue":
        var ipc = IpcManager.new()
        val client = TaskId(id: 61)
        val service = TaskId(id: 62)
        val client_port = ipc.create_port(client, "reply-once-client")
        val service_port = ipc.create_port(service, "reply-once-service")
        val request = IpcMessage(
            src_port: client_port.id, dst_port: service_port.id, method: 7u32,
            flags: IpcFlags.Async as u32, payload_len: 0u32, cap_count: 0u32
        )
        val reply = IpcMessage(
            src_port: service_port.id, dst_port: client_port.id, method: 7u32,
            flags: IpcFlags.Reply as u32, payload_len: 0u32, cap_count: 0u32
        )
        expect(ipc.send_owned(client, client_port.id, request, [])).to_equal(0)
        expect(ipc.send_owned(service, service_port.id, reply, [])).to_equal(0)
        expect(ipc.send_owned(service, service_port.id, reply, [])).to_equal(-8)
        expect(ipc.queued_message_count(client_port.id)).to_equal(1)
