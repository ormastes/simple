# @req: REQ-OS-KERNEL-001

"""
# IPC Manager Specification

**Feature IDs:** #OS-006
**Category:** Runtime
**Difficulty:** 4/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Tests for the kernel IPC manager. Validates port lifecycle (create, connect),
message passing (send, recv), and capability delegation (grant, check, revoke)
through the IPC subsystem.
"""

use std.spec.{describe, it, expect}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.ipc_types.{IpcPort, IpcMessage, IpcFlags, OwnedIpcReceiveStatus}
use os.kernel.types.capability_types.{CapabilityToken, CapabilityKind, CapabilitySet}
use os.kernel.ipc.ipc.{IpcManager}

fn _owned_header(source_port: u64, destination_port: u64, method: u32, payload_len: u32) -> IpcMessage:
    IpcMessage(
        src_port: source_port,
        dst_port: destination_port,
        method: method,
        flags: 1u32,
        payload_len: payload_len,
        cap_count: 0u32
    )


# ============================================================================
# Test Group 1: IPC Manager Construction
# ============================================================================

use std.spec.step

describe "IpcManager":
    describe "construction":
        it "creates with empty port table":
            # @req: REQ-OS-KERNEL-001
            step("Verify: creates with empty port table")
            val mgr = IpcManager.new()
            # Connecting to a non-existent port returns nil
            val port = mgr.connect("nonexistent")
            expect(port).to_equal(nil)

    describe "create_port":
        it "returns a port with non-zero id":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns a port with non-zero id")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "test_port")
            expect(port.id).to_be_greater_than(0)

        it "assigns sequential port ids":
            # @req: REQ-OS-KERNEL-001
            step("Verify: assigns sequential port ids")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val p1 = mgr.create_port(owner, "port_a")
            val p2 = mgr.create_port(owner, "port_b")
            expect(p2.id).to_equal(p1.id + 1)

        it "stores the owner task id":
            # @req: REQ-OS-KERNEL-001
            step("Verify: stores the owner task id")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 42)
            val port = mgr.create_port(owner, "my_port")
            expect(port.owner).to_equal(42)  # oracle: 42 — named expected value from the requirement

        it "creates multiple ports for different tasks":
            # @req: REQ-OS-KERNEL-001
            step("Verify: creates multiple ports for different tasks")
            var mgr = IpcManager.new()
            val owner1 = TaskId(id: 1)
            val owner2 = TaskId(id: 2)
            val p1 = mgr.create_port(owner1, "vfs")
            val p2 = mgr.create_port(owner2, "compositor")
            expect(p1.id).to_be_greater_than(0)
            expect(p2.id).to_be_greater_than(0)
            val different = p1.id != p2.id
            expect(different).to_equal(true)

    describe "connect":
        it "finds existing port by name":
            # @req: REQ-OS-KERNEL-001
            step("Verify: finds existing port by name")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val created = mgr.create_port(owner, "vfs_service")
            val found = mgr.connect("vfs_service")
            val found_ok = found != nil
            expect(found_ok).to_equal(true)

        it "returns nil for non-existent port":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns nil for non-existent port")
            var mgr = IpcManager.new()
            val result = mgr.connect("does_not_exist")
            expect(result).to_equal(nil)

        it "returns correct port id on connect":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns correct port id on connect")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 5)
            val created = mgr.create_port(owner, "audio")
            val found = mgr.connect("audio")
            if found != nil:
                val port = found
                expect(port.id).to_equal(created.id)

        it "distinguishes ports by name":
            # @req: REQ-OS-KERNEL-001
            step("Verify: distinguishes ports by name")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val p1 = mgr.create_port(owner, "service_a")
            val p2 = mgr.create_port(owner, "service_b")
            val found_a = mgr.connect("service_a")
            val found_b = mgr.connect("service_b")
            if found_a != nil:
                val port = found_a
                expect(port.id).to_equal(p1.id)
            if found_b != nil:
                val port = found_b
                expect(port.id).to_equal(p2.id)


# ============================================================================
# Test Group 2: Message Passing
# ============================================================================

describe "IpcManager message passing":
    describe "send":
        it "returns 0 on successful send":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns 0 on successful send")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "inbox")
            val msg = IpcMessage(
                src_port: 0,
                dst_port: port.id,
                method: 1,
                flags: 0,
                payload_len: 0,
                cap_count: 0
            )
            val result = mgr.send(msg)
            expect(result).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "returns -1 for non-existent destination":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns -1 for non-existent destination")
            var mgr = IpcManager.new()
            val msg = IpcMessage(
                src_port: 0,
                dst_port: 9999,
                method: 1,
                flags: 0,
                payload_len: 0,
                cap_count: 0
            )
            val result = mgr.send(msg)
            expect(result).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        it "preserves a waiting receiver for the syscall unblock handoff":
            # @req: REQ-OS-KERNEL-001
            step("Verify: preserves a waiting receiver for the syscall unblock handoff")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val waiter = TaskId(id: 99)
            val port = mgr.create_port(owner, "waiter_handoff")
            mgr.add_waiter(port, waiter)
            val msg = IpcMessage(
                src_port: 0,
                dst_port: port.id,
                method: 7,
                flags: 0,
                payload_len: 0,
                cap_count: 0
            )

            val result = mgr.send(msg)
            val first = mgr.get_first_waiter(port.id)

            expect(result).to_equal(0)  # oracle: 0 — named expected value from the requirement
            val has_waiter = first != nil
            expect(has_waiter).to_equal(true)
            if first != nil:
                val task = first
                expect(task.id).to_equal(waiter.id)
            expect(mgr.get_first_waiter(port.id)).to_equal(nil)

    describe "recv":
        it "returns nil for empty port (non-blocking)":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns nil for empty port (non-blocking)")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "empty_port")
            val msg = mgr.recv(port, 0)
            expect(msg).to_equal(nil)

        it "returns sent message":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns sent message")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "recv_test")

            # Send a message
            val outgoing = IpcMessage(
                src_port: 100,
                dst_port: port.id,
                method: 42,
                flags: 0,
                payload_len: 128,
                cap_count: 0
            )
            mgr.send(outgoing)

            # Receive it
            val received = mgr.recv(port, 0)
            val got_msg = received != nil
            expect(got_msg).to_equal(true)
            if received != nil:
                val msg = received
                expect(msg.method).to_equal(42)  # oracle: 42 — named expected value from the requirement
                expect(msg.src_port).to_equal(100)  # oracle: 100 — named expected value from the requirement
                expect(msg.payload_len).to_equal(128)  # oracle: 128 — named expected value from the requirement

        it "delivers messages in FIFO order":
            # @req: REQ-OS-KERNEL-001
            step("Verify: delivers messages in FIFO order")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "fifo_test")

            # Send two messages with different methods
            val msg1 = IpcMessage(
                src_port: 1, dst_port: port.id,
                method: 10, flags: 0, payload_len: 0, cap_count: 0
            )
            val msg2 = IpcMessage(
                src_port: 2, dst_port: port.id,
                method: 20, flags: 0, payload_len: 0, cap_count: 0
            )
            mgr.send(msg1)
            mgr.send(msg2)

            # First recv should get method=10
            val first = mgr.recv(port, 0)
            if first != nil:
                val m = first
                expect(m.method).to_equal(10)  # oracle: 10 — named expected value from the requirement

            # Second recv should get method=20
            val second = mgr.recv(port, 0)
            if second != nil:
                val m = second
                expect(m.method).to_equal(20)  # oracle: 20 — named expected value from the requirement

        it "returns nil after all messages consumed":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns nil after all messages consumed")
            var mgr = IpcManager.new()
            val owner = TaskId(id: 1)
            val port = mgr.create_port(owner, "exhaust_test")

            val msg = IpcMessage(
                src_port: 1, dst_port: port.id,
                method: 1, flags: 0, payload_len: 0, cap_count: 0
            )
            mgr.send(msg)
            mgr.recv(port, 0)  # Consume the message
            val empty = mgr.recv(port, 0)
            expect(empty).to_equal(nil)

    describe "owner-checked copied payload delivery":
        it "copies caller bytes before send returns and preserves metadata parity":
            # @req: REQ-OS-KERNEL-001
            step("Verify: copies caller bytes before send returns and preserves metadata parity")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 10)
            val receiver = TaskId(id: 20)
            val source = mgr.create_port(sender, "owned_copy_source")
            val destination = mgr.create_port(receiver, "owned_copy_destination")
            var payload: [u8] = [11u8, 22u8, 33u8]
            val header = IpcMessage(
                src_port: source.id,
                dst_port: destination.id,
                method: 42u32,
                flags: 1u32,
                payload_len: 3u32,
                cap_count: 0u32
            )

            expect(mgr.send_owned(sender, source.id, header, payload)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            payload[0] = 99u8
            expect(mgr.queued_message_count(destination.id)).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(3u64)

            val received = mgr.recv_owned(receiver, destination)
            expect(received.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            expect(received.header != nil).to_equal(true)
            if received.header != nil:
                val received_header = received.header
                expect(received_header.src_port).to_equal(source.id)
                expect(received_header.dst_port).to_equal(destination.id)
                expect(received_header.method).to_equal(42u32)
                expect(received_header.flags).to_equal(1u32)
                expect(received_header.payload_len).to_equal(3u32)
                expect(received_header.cap_count).to_equal(0u32)
            expect(received.payload.len()).to_equal(3)  # oracle: 3 — named expected value from the requirement
            expect(received.payload[0]).to_equal(11u8)
            expect(received.payload[1]).to_equal(22u8)
            expect(received.payload[2]).to_equal(33u8)
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)

        it "accepts an empty copied payload":
            # @req: REQ-OS-KERNEL-001
            step("Verify: accepts an empty copied payload")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 11)
            val receiver = TaskId(id: 21)
            val source = mgr.create_port(sender, "owned_empty_source")
            val destination = mgr.create_port(receiver, "owned_empty_destination")
            val header = _owned_header(source.id, destination.id, 9u32, 0u32)

            expect(mgr.send_owned(sender, source.id, header, [])).to_equal(0)  # oracle: 0 — named expected value from the requirement
            val received = mgr.recv_owned(receiver, destination)
            expect(received.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            expect(received.payload.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            if received.header != nil:
                val received_header = received.header
                expect(received_header.payload_len).to_equal(0u32)
            else:
                expect(false).to_equal(true)

        it "rejects inconsistent claimed source ownership without claiming authentication":
            # @req: REQ-OS-KERNEL-001
            step("Verify: rejects inconsistent claimed source ownership without claiming authentication")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 12)
            val attacker = TaskId(id: 13)
            val receiver = TaskId(id: 22)
            val source = mgr.create_port(sender, "owned_auth_source")
            val second_source = mgr.create_port(sender, "owned_auth_second_source")
            val destination = mgr.create_port(receiver, "owned_auth_destination")
            val valid_header = _owned_header(source.id, destination.id, 10u32, 1u32)
            val mismatched_header = _owned_header(second_source.id, destination.id, 11u32, 1u32)
            val absent_header = _owned_header(999999u64, destination.id, 12u32, 1u32)

            expect(mgr.send_owned(attacker, source.id, valid_header, [1u8])).to_equal(-3)  # oracle: -3 — named expected value from the requirement
            expect(mgr.send_owned(sender, source.id, mismatched_header, [1u8])).to_equal(-3)  # oracle: -3 — named expected value from the requirement
            expect(mgr.send_owned(sender, 999999u64, absent_header, [1u8])).to_equal(-3)  # oracle: -3 — named expected value from the requirement
            expect(mgr.send_owned(sender, 0u64, valid_header, [1u8])).to_equal(-3)  # oracle: -3 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement

        it "returns exact unauthorized, delivered, empty, and missing statuses":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns exact unauthorized, delivered, empty, and missing statuses")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 14)
            val receiver = TaskId(id: 24)
            val attacker = TaskId(id: 25)
            val source = mgr.create_port(sender, "owned_receiver_source")
            val destination = mgr.create_port(receiver, "owned_receiver_destination")
            val header = _owned_header(source.id, destination.id, 13u32, 2u32)
            expect(mgr.send_owned(sender, source.id, header, [7u8, 8u8])).to_equal(0)  # oracle: 0 — named expected value from the requirement

            val forged = IpcPort(id: destination.id, owner: attacker.id)
            val unauthorized = mgr.recv_owned(attacker, forged)
            expect(unauthorized.status).to_equal(OwnedIpcReceiveStatus.Unauthorized)
            expect(unauthorized.header).to_equal(nil)
            expect(unauthorized.payload.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(1)  # oracle: 1 — named expected value from the requirement

            val delivered = mgr.recv_owned(receiver, forged)
            expect(delivered.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            expect(delivered.payload[0]).to_equal(7u8)
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement

            val empty = mgr.recv_owned(receiver, destination)
            expect(empty.status).to_equal(OwnedIpcReceiveStatus.Empty)
            expect(empty.header).to_equal(nil)
            val missing = mgr.recv_owned(receiver, IpcPort(id: 999999u64, owner: receiver.id))
            expect(missing.status).to_equal(OwnedIpcReceiveStatus.MissingPort)
            expect(missing.header).to_equal(nil)

        it "rejects oversized and header-mismatched payloads without queueing":
            # @req: REQ-OS-KERNEL-001
            step("Verify: rejects oversized and header-mismatched payloads without queueing")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 15)
            val receiver = TaskId(id: 26)
            val source = mgr.create_port(sender, "owned_bounds_source")
            val destination = mgr.create_port(receiver, "owned_bounds_destination")
            val oversized: [u8] = [5u8; 4097]
            val oversized_header = _owned_header(source.id, destination.id, 14u32, 4097u32)
            val mismatched_header = _owned_header(source.id, destination.id, 15u32, 2u32)

            expect(mgr.send_owned(sender, source.id, oversized_header, oversized)).to_equal(-4)  # oracle: -4 — named expected value from the requirement
            expect(mgr.send_owned(sender, source.id, mismatched_header, [1u8])).to_equal(-5)  # oracle: -5 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)

        it "rejects capability count and transfer flags until token ownership lands":
            # @req: REQ-OS-KERNEL-001
            step("Verify: rejects capability count and transfer flags until token ownership lands")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 151)
            val receiver = TaskId(id: 261)
            val source = mgr.create_port(sender, "owned_cap_source")
            val destination = mgr.create_port(receiver, "owned_cap_destination")
            val counted = IpcMessage(
                src_port: source.id,
                dst_port: destination.id,
                method: 16u32,
                flags: 0u32,
                payload_len: 1u32,
                cap_count: 1u32
            )
            val transfer_flagged = IpcMessage(
                src_port: source.id,
                dst_port: destination.id,
                method: 17u32,
                flags: IpcFlags.CapTransfer as u32,
                payload_len: 1u32,
                cap_count: 0u32
            )

            expect(mgr.send_owned(sender, source.id, counted, [1u8])).to_equal(-7)  # oracle: -7 — named expected value from the requirement
            expect(mgr.send_owned(sender, source.id, transfer_flagged, [1u8])).to_equal(-7)  # oracle: -7 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)

        it "enforces queue slot capacity independently from payload bytes":
            # @req: REQ-OS-KERNEL-001
            step("Verify: enforces queue slot capacity independently from payload bytes")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 16)
            val receiver = TaskId(id: 27)
            val source = mgr.create_port(sender, "owned_full_source")
            val destination = mgr.create_port(receiver, "owned_full_destination")
            var i = 0
            while i < 64:
                val header = _owned_header(source.id, destination.id, i.to_u32(), 0u32)
                expect(mgr.send_owned(sender, source.id, header, [])).to_equal(0)  # oracle: 0 — named expected value from the requirement
                i = i + 1
            val overflow_header = _owned_header(source.id, destination.id, 65u32, 0u32)
            expect(mgr.send_owned(sender, source.id, overflow_header, [])).to_equal(-2)  # oracle: -2 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(64)  # oracle: 64 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)

        it "enforces the per-port owned payload byte budget before slot capacity":
            # @req: REQ-OS-KERNEL-001
            step("Verify: enforces the per-port owned payload byte budget before slot capacity")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 17)
            val receiver = TaskId(id: 28)
            val source = mgr.create_port(sender, "owned_budget_source")
            val destination = mgr.create_port(receiver, "owned_budget_destination")
            val chunk: [u8] = [6u8; 4096]
            var i = 0
            while i < 16:
                val header = _owned_header(source.id, destination.id, i.to_u32(), 4096u32)
                expect(mgr.send_owned(sender, source.id, header, chunk)).to_equal(0)  # oracle: 0 — named expected value from the requirement
                i = i + 1
            val overflow_header = _owned_header(source.id, destination.id, 17u32, 1u32)
            expect(mgr.send_owned(sender, source.id, overflow_header, [6u8])).to_equal(-6)  # oracle: -6 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(16)  # oracle: 16 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(65536u64)

        it "delivers copied payloads in FIFO order":
            # @req: REQ-OS-KERNEL-001
            step("Verify: delivers copied payloads in FIFO order")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 18)
            val receiver = TaskId(id: 29)
            val source = mgr.create_port(sender, "owned_fifo_source")
            val destination = mgr.create_port(receiver, "owned_fifo_destination")
            val first_header = _owned_header(source.id, destination.id, 31u32, 1u32)
            val second_header = _owned_header(source.id, destination.id, 32u32, 2u32)
            expect(mgr.send_owned(sender, source.id, first_header, [1u8])).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.send_owned(sender, source.id, second_header, [2u8, 3u8])).to_equal(0)  # oracle: 0 — named expected value from the requirement

            val first = mgr.recv_owned(receiver, destination)
            expect(first.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            if first.header != nil:
                val first_header_received = first.header
                expect(first_header_received.method).to_equal(31u32)
            expect(first.payload[0]).to_equal(1u8)
            val second = mgr.recv_owned(receiver, destination)
            expect(second.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            if second.header != nil:
                val second_header_received = second.header
                expect(second_header_received.method).to_equal(32u32)
            expect(second.payload[0]).to_equal(2u8)
            expect(second.payload[1]).to_equal(3u8)
            val empty = mgr.recv_owned(receiver, destination)
            expect(empty.status).to_equal(OwnedIpcReceiveStatus.Empty)

        it "releases queue accounting on pop and destination destruction":
            # @req: REQ-OS-KERNEL-001
            step("Verify: releases queue accounting on pop and destination destruction")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 19)
            val receiver = TaskId(id: 30)
            val source = mgr.create_port(sender, "owned_drain_source")
            val destination = mgr.create_port(receiver, "owned_drain_destination")
            val header = _owned_header(source.id, destination.id, 40u32, 4u32)
            expect(mgr.send_owned(sender, source.id, header, [1u8, 2u8, 3u8, 4u8])).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(4u64)
            val popped = mgr.recv_owned(receiver, destination)
            expect(popped.status).to_equal(OwnedIpcReceiveStatus.Delivered)
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)

            expect(mgr.send_owned(sender, source.id, header, [5u8, 6u8, 7u8, 8u8])).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_message_count(destination.id)).to_equal(1)  # oracle: 1 — named expected value from the requirement
            mgr.destroy_task_ports(receiver)
            expect(mgr.queued_message_count(destination.id)).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(mgr.queued_owned_payload_bytes(destination.id)).to_equal(0u64)
            expect(mgr.connect("owned_drain_destination")).to_equal(nil)

        it "marks legacy delivery metadata-only and never invents payload bytes":
            # @req: REQ-OS-KERNEL-001
            step("Verify: marks legacy delivery metadata-only and never invents payload bytes")
            var mgr = IpcManager.new()
            val sender = TaskId(id: 31)
            val receiver = TaskId(id: 32)
            val source = mgr.create_port(sender, "legacy_negative_source")
            val destination = mgr.create_port(receiver, "legacy_negative_destination")
            val header = _owned_header(source.id, destination.id, 50u32, 9u32)
            expect(mgr.send(header)).to_equal(0)  # oracle: 0 — named expected value from the requirement

            val received = mgr.recv_owned(receiver, destination)
            expect(received.status).to_equal(OwnedIpcReceiveStatus.MetadataOnly)
            expect(received.payload.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
            if received.header != nil:
                val received_header = received.header
                expect(received_header.payload_len).to_equal(9u32)
            else:
                expect(false).to_equal(true)


# ============================================================================
# Test Group 3: Capability Delegation via IPC
# ============================================================================

describe "IpcManager capability delegation":
    describe "cap_check":
        it "returns false for task without capabilities":
            # @req: REQ-OS-KERNEL-001
            step("Verify: returns false for task without capabilities")
            var mgr = IpcManager.new()
            val task = TaskId(id: 1)
            val result = mgr.cap_check(task, CapabilityKind.ProcessSpawn)
            expect(result).to_equal(false)

    describe "cap_grant and cap_check":
        it "grants capability from one task to another":
            # @req: REQ-OS-KERNEL-001
            step("Verify: grants capability from one task to another")
            var mgr = IpcManager.new()
            val from_task = TaskId(id: 1)
            val to_task = TaskId(id: 2)

            # Initialize source task with a capability
            val token = CapabilityToken(
                kind: CapabilityKind.ProcessSpawn,
                generation: 1,
                owner: from_task.id
            )
            val caps = CapabilitySet(caps: [token], is_pledged: false)
            mgr.cap_manager.init_task(from_task, caps)
            mgr.cap_manager.init_task(to_task, CapabilitySet.full())

            # Grant from source to target
            val ok = mgr.cap_grant(from_task, to_task, token)
            expect(ok).to_equal(true)

            # Target should now have the capability
            val has_cap = mgr.cap_check(to_task, CapabilityKind.ProcessSpawn)
            expect(has_cap).to_equal(true)

    describe "cap_revoke":
        it "revokes a granted capability":
            # @req: REQ-OS-KERNEL-001
            step("Verify: revokes a granted capability")
            var mgr = IpcManager.new()
            val task1 = TaskId(id: 1)
            val task2 = TaskId(id: 2)

            val token = CapabilityToken(
                kind: CapabilityKind.SystemReboot,
                generation: 1,
                owner: task1.id
            )
            val caps = CapabilitySet(caps: [token], is_pledged: false)
            mgr.cap_manager.init_task(task1, caps)
            mgr.cap_manager.init_task(task2, CapabilitySet.full())

            # Grant then revoke
            mgr.cap_grant(task1, task2, token)
            val revoked = mgr.cap_revoke(token)
            expect(revoked).to_equal(true)
