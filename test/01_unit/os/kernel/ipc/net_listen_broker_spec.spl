"""Exact NetListen authority at the owned-record net broker boundary."""

use std.spec.{describe, it, expect}
use os.kernel.ipc.syscall_ipc.{owned_net_listen_broker_allows}
use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken, CapabilityKind}

fn _listen_caps(port: u16) -> CapabilitySet:
    CapabilitySet(caps: [CapabilityToken(
        kind: CapabilityKind.NetListen(port: port), generation: 1u64,
        owner: 41u64, token_id: 501u64, parent_token_id: 0u64, depth: 1
    )], is_pledged: true)

fn _bind_payload(port: u16) -> [u8]:
    [3u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
     (port & 0xFFu16).to_u8(), ((port >> 8u16) & 0xFFu16).to_u8()]

describe "owned net listen broker":
    it "allows only the exact NetListen port at NET_BIND":
        expect(owned_net_listen_broker_allows(_listen_caps(80u16), "net", 2u32, _bind_payload(80u16))).to_equal(true)
        expect(owned_net_listen_broker_allows(_listen_caps(80u16), "net", 2u32, _bind_payload(8080u16))).to_equal(false)

    it "rechecks exact authority at NET_LISTEN and rejects truncated wire input":
        expect(owned_net_listen_broker_allows(_listen_caps(80u16), "net", 3u32, _bind_payload(80u16))).to_equal(true)
        expect(owned_net_listen_broker_allows(_listen_caps(80u16), "net", 3u32, _bind_payload(8080u16))).to_equal(false)
        expect(owned_net_listen_broker_allows(_listen_caps(80u16), "net", 3u32, [3u8, 0u8])).to_equal(false)

    it "does not turn a non-net endpoint into a network authority gate":
        expect(owned_net_listen_broker_allows(CapabilitySet.empty(), "vfs", 2u32, _bind_payload(80u16))).to_equal(true)
