# @req REQ-001 REQ-003 REQ-010 NFR-001 NFR-002 NFR-003
# @cover src/os/kernel/types/capability_types.spl 80%
# @tag: unit, simpleos, kernel, capability, pci, bar

use std.spec.*
use os.kernel.types.capability_types.{CapabilityKind,
    capability_kind_allows}

describe "exact PCI device BAR capability authority":
    it "accepts only the identical BDF and BAR tuple":
        val held = CapabilityKind.DeviceBarMap(bdf_bus: 0u8,
            bdf_device: 4u8, bdf_func: 1u8, bar_index: 4u8)
        expect(capability_kind_allows(held, held)).to_be(true)
        expect(capability_kind_allows(held,
            CapabilityKind.DeviceBarMap(bdf_bus: 1u8, bdf_device: 4u8,
                bdf_func: 1u8, bar_index: 4u8))).to_be(false)
        expect(capability_kind_allows(held,
            CapabilityKind.DeviceBarMap(bdf_bus: 0u8, bdf_device: 5u8,
                bdf_func: 1u8, bar_index: 4u8))).to_be(false)
        expect(capability_kind_allows(held,
            CapabilityKind.DeviceBarMap(bdf_bus: 0u8, bdf_device: 4u8,
                bdf_func: 2u8, bar_index: 4u8))).to_be(false)
        expect(capability_kind_allows(held,
            CapabilityKind.DeviceBarMap(bdf_bus: 0u8, bdf_device: 4u8,
                bdf_func: 1u8, bar_index: 2u8))).to_be(false)
