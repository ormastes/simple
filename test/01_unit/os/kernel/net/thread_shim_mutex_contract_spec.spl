# Static ABI contract coverage for spl_mutex_*.
#
# Hosted test runs exercise the same public ABI through the hosted provider;
# architecture-specific instruction and SMP evidence remains a QEMU system
# acceptance responsibility.

extern fn spl_mutex_create() -> i64
extern fn spl_mutex_lock(handle: i64) -> bool
extern fn spl_mutex_try_lock(handle: i64) -> bool
extern fn spl_mutex_unlock(handle: i64) -> bool
extern fn spl_mutex_destroy(handle: i64)

describe "SimpleOS mutex ABI contract":
    it "rejects invalid handles":
        expect(spl_mutex_try_lock(0)).to_equal(false)
        expect(spl_mutex_unlock(0)).to_equal(false)

    it "makes copied scalar handles contend on one owner":
        val original = spl_mutex_create()
        val copied = original
        expect(original > 0).to_equal(true)
        expect(spl_mutex_try_lock(original)).to_equal(true)
        expect(spl_mutex_try_lock(copied)).to_equal(false)
        expect(spl_mutex_unlock(copied)).to_equal(true)
        expect(spl_mutex_unlock(original)).to_equal(false)
        spl_mutex_destroy(original)

    it "makes destruction terminal":
        val handle = spl_mutex_create()
        expect(handle > 0).to_equal(true)
        spl_mutex_destroy(handle)
        expect(spl_mutex_try_lock(handle)).to_equal(false)
        expect(spl_mutex_unlock(handle)).to_equal(false)
