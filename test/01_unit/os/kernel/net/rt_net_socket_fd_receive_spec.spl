# @cover src/os/kernel/net/rt_net_socket_facade.spl 5%

# The filesystem-launched DBD listener must read only through its accepted
# descriptor's runtime owner. This source contract guards against a regression
# to the process-global boot TCP receive ring.

use std.spec
use std.io_runtime.{file_read}

describe "runtime socket receive descriptor ownership":
    it "routes resolved socket receives through the fd-bound primitive":
        val facade = file_read("src/os/kernel/net/rt_net_socket_facade.spl")
        val receive = facade.split(
            "@export(\"C\", name: \"rt_net_recv_bytes\")")[1].split(
            "@export(\"C\", name: \"rt_net_recv_version_text\")")[0]
        expect(receive).to_contain(
            "rt_boot_tcp_read_bytes_for_fd(current.os_fd.to_i64(), max_len)")
        expect(receive).to_contain("if sock_fd == 200:")
        expect(receive.split("rt_boot_tcp_read_bytes(max_len)").len()).to_equal(2)

    it "passes the accepted DBD descriptor into the receive facade":
        val dbd = file_read("src/os/apps/dbd/dbd.spl")
        expect(dbd).to_contain(
            "rt_net_recv_bytes(client_fd, DBD_RECV_BOUND_BYTES)")
