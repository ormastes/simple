use std.spec
use os.kernel.scheduler.server_data_launch_grant_registry.{
    ServerDataLaunchGrantLifecycleRevokeStatusV1,
    server_data_launch_grant_revoke_task_lifecycle_status_v1
}

describe "server-data launch grant lifecycle revoke status":
    it "rejects a zero task or lifecycle identity explicitly":
        expect(server_data_launch_grant_revoke_task_lifecycle_status_v1(0u64, 1u64) ==
            ServerDataLaunchGrantLifecycleRevokeStatusV1.InvalidIdentity).to_equal(true)
        expect(server_data_launch_grant_revoke_task_lifecycle_status_v1(5u64, 0u64) ==
            ServerDataLaunchGrantLifecycleRevokeStatusV1.InvalidIdentity).to_equal(true)

    it "reports an absent row as AlreadyAbsent, distinct from Applied":
        val status = server_data_launch_grant_revoke_task_lifecycle_status_v1(424242u64, 9u64)
        expect(status == ServerDataLaunchGrantLifecycleRevokeStatusV1.AlreadyAbsent).to_equal(true)
        expect(status == ServerDataLaunchGrantLifecycleRevokeStatusV1.Applied).to_equal(false)
