# @req: REQ-OS-KERNEL-001

"""
# SimpleOS Green Task Lifecycle Specification

Tests the scheduler-facing logical green-task lifecycle used by future
SimpleOS carrier workers.
"""

use std.spec.*
use os.kernel.scheduler.green_task.{
    green_task_new,
    green_task_is_runnable,
    green_task_is_parked,
    green_task_is_done,
    green_task_park,
    green_task_unpark,
    green_task_complete
}

use std.spec.step

describe "SimpleOS green task lifecycle contract":
    describe "spawn":
        it "creates a runnable task on the least-loaded allowed CPU":
            # @req: REQ-OS-KERNEL-001
            step("Verify: creates a runnable task on the least-loaded allowed CPU")
            val task = green_task_new(7, 4, 0, 3, 1, 2, 4)

            expect(task.task_id).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(task.home_cpu).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(task.assigned_cpu).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(task.state).to_equal("runnable")
            expect(green_task_is_runnable(task)).to_equal(true)

        it "preserves affinity placement from the worker contract":
            # @req: REQ-OS-KERNEL-001
            step("Verify: preserves affinity placement from the worker contract")
            val only_cpu2 = 1 << 2
            val task = green_task_new(8, 4, only_cpu2, 0, 0, 9, 0)

            expect(task.home_cpu).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(task.assigned_cpu).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(task.affinity_mask).to_equal(only_cpu2)

    describe "park":
        it "parks a task without changing home or assigned CPU":
            # @req: REQ-OS-KERNEL-001
            step("Verify: parks a task without changing home or assigned CPU")
            val task = green_task_new(9, 4, 0, 0, 1, 2, 3)
            val parked = green_task_park(task, "channel_recv")

            expect(green_task_is_parked(parked)).to_equal(true)
            expect(parked.state).to_equal("parked")
            expect(parked.park_reason).to_equal("channel_recv")
            expect(parked.home_cpu).to_equal(task.home_cpu)
            expect(parked.assigned_cpu).to_equal(task.assigned_cpu)

    describe "unpark":
        it "wakes a parked task onto the waker CPU when load is close":
            # @req: REQ-OS-KERNEL-001
            step("Verify: wakes a parked task onto the waker CPU when load is close")
            val task = green_task_new(10, 4, 0, 0, 1, 2, 3)
            val parked = green_task_park(task, "timer")
            val wake = green_task_unpark(parked, 2, 2, 3, 1)

            expect(wake.should_enqueue).to_equal(true)
            expect(wake.task.state).to_equal("runnable")
            expect(wake.task.assigned_cpu).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(wake.placement.reason).to_equal("wake_affine_waker_cpu")
            expect(wake.task.park_reason).to_equal("")

        it "does not enqueue an already runnable task":
            # @req: REQ-OS-KERNEL-001
            step("Verify: does not enqueue an already runnable task")
            val task = green_task_new(11, 4, 0, 0, 1, 2, 3)
            val wake = green_task_unpark(task, 2, 0, 0, 1)

            expect(wake.should_enqueue).to_equal(false)
            expect(wake.task.state).to_equal("runnable")
            expect(wake.placement.reason).to_equal("not_parked")

    describe "complete":
        it "marks a task done and keeps the last carrier CPU":
            # @req: REQ-OS-KERNEL-001
            step("Verify: marks a task done and keeps the last carrier CPU")
            val task = green_task_new(12, 4, 0, 3, 1, 2, 4)
            val done = green_task_complete(task, 99)

            expect(green_task_is_done(done)).to_equal(true)
            expect(done.state).to_equal("done")
            expect(done.result).to_equal(99)  # oracle: 99 — named expected value from the requirement
            expect(done.assigned_cpu).to_equal(task.assigned_cpu)

        it "first-write-wins: completing an already-done task is a no-op":
            # @req: REQ-OS-KERNEL-001
            step("Verify: first-write-wins: completing an already-done task is a no-op")
            val task = green_task_new(13, 4, 0, 0, 1, 2, 3)
            val first = green_task_complete(task, 42)
            val second = green_task_complete(first, 999)

            expect(green_task_is_done(second)).to_equal(true)
            expect(second.result).to_equal(42)  # oracle: 42 — named expected value from the requirement
            expect(second.state).to_equal("done")

        it "second complete with different value is rejected; first result preserved":
            # @req: REQ-OS-KERNEL-001
            step("Verify: second complete with different value is rejected; first result preserved")
            val task = green_task_new(14, 4, 0, 0, 1, 2, 3)
            val first = green_task_complete(task, 7)
            val second = green_task_complete(first, -1)

            expect(second.result).to_equal(7)  # oracle: 7 — named expected value from the requirement
            expect(second.task_id).to_equal(first.task_id)
            expect(second.assigned_cpu).to_equal(first.assigned_cpu)
