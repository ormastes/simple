use std.spec.{describe, it, expect}

describe("WEB launch evidence registry separation"):
    it("is a distinct sealed WEB-only one-shot owner"):
        val source = file_read("src/os/kernel/scheduler/web_launch_evidence_registry_v1.spl")
        expect(source).to_contain("SIMPLEOS_WEB_EXECUTABLE_V1")
        expect(source).to_contain("WebLaunchEndpointProjectionV1")
        expect(source).to_contain("web_launch_evidence_consume_once_v1")
        expect(source).to_contain("WebLaunchEvidenceStateV1.Consumed")
        expect(source.contains("server_data_launch_grant_registry")).to_equal(false)
        expect(source).to_contain("SIMPLEOS_WEB_HTTP_PORT_V1")

    it("derives endpoint and policy from the sealed image plus owner-bound pouch"):
        val source = file_read("src/os/kernel/scheduler/web_launch_evidence_registry_v1.spl")
        expect(source).to_contain("WebLaunchPublicationV1")
        expect(source).to_contain("simpleos_web_configured_bind_ipv4_v1()")
        expect(source).to_contain("web_launch_caps_exact_for_owner_v1")
        expect(source).to_contain("policy_fingerprint")
        expect(source.contains("pouch_digest")).to_equal(false)

    it("has rollback and generation-bound reap retirement at scheduler boundaries"):
        val adoption = file_read("src/os/kernel/scheduler/scheduler_executable_adoption.spl")
        val reaper = file_read("src/os/kernel/scheduler/scheduler_task_mgmt.spl")
        expect(adoption).to_contain("web_launch_evidence_revoke_v1(web_receipt.unwrap())")
        expect(adoption).to_contain("before TCB publication")
        expect(reaper).to_contain("web_launch_evidence_retire_reaped_v1")
        expect(reaper).to_contain("task.lifecycle_generation, task.exec_generation")

    it("revokes WEB publication before the server-data rejection destroys its address space"):
        val adoption = file_read("src/os/kernel/scheduler/scheduler_executable_adoption.spl")
        val server_rejection = adoption.index_of(
            "if server_data_install.status != ServerDataLaunchGrantInstallStatusV1.NotApplicable")
        val revoke = adoption.index_of(
            "if web_receipt != nil and not web_launch_evidence_revoke_v1(web_receipt.unwrap()):")
        val destroy = adoption.index_of("destroy_user_address_space(space)", revoke)
        expect(server_rejection).to_be_greater_than(0)
        expect(revoke).to_be_greater_than(server_rejection)
        expect(destroy).to_be_greater_than(revoke)
        expect(adoption).to_contain("a serialization\n            # failure leaves the registry quarantined")
