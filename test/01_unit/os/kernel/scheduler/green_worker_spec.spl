# @req: REQ-OS-KERNEL-001

"""
# SimpleOS Green Worker Scheduler Specification

Tests the scheduler-facing placement rules for future SimpleOS green-task
carrier workers.
"""

use std.spec.*
use os.kernel.scheduler.green_worker.{
    green_worker_cpu_allowed,
    green_worker_pick_spawn_cpu,
    green_worker_choose_wake_cpu,
    green_worker_should_steal,
    green_worker_rebalance_decision
}

use std.spec.step

describe "SimpleOS green worker scheduler contract":
    describe "CPU affinity":
        it "allows every CPU when affinity mask is zero":
            # @req: REQ-OS-KERNEL-001
            step("Verify: allows every CPU when affinity mask is zero")
            expect(green_worker_cpu_allowed(0, 0)).to_equal(true)
            expect(green_worker_cpu_allowed(0, 3)).to_equal(true)
            expect(green_worker_cpu_allowed(0, -1)).to_equal(false)

        it "restricts workers to CPUs present in the affinity mask":
            # @req: REQ-OS-KERNEL-001
            step("Verify: restricts workers to CPUs present in the affinity mask")
            val cpu1_and_cpu3 = (1 << 1) | (1 << 3)

            expect(green_worker_cpu_allowed(cpu1_and_cpu3, 0)).to_equal(false)
            expect(green_worker_cpu_allowed(cpu1_and_cpu3, 1)).to_equal(true)
            expect(green_worker_cpu_allowed(cpu1_and_cpu3, 3)).to_equal(true)

    describe "spawn placement":
        it "chooses the least-loaded allowed CPU":
            # @req: REQ-OS-KERNEL-001
            step("Verify: chooses the least-loaded allowed CPU")
            val placement = green_worker_pick_spawn_cpu(4, 0, 3, 1, 2, 4)

            expect(placement.cpu).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(placement.reason).to_equal("least_loaded_allowed_cpu")

        it "honors affinity before load when placing a worker":
            # @req: REQ-OS-KERNEL-001
            step("Verify: honors affinity before load when placing a worker")
            val only_cpu2 = 1 << 2
            val placement = green_worker_pick_spawn_cpu(4, only_cpu2, 0, 0, 9, 0)

            expect(placement.cpu).to_equal(2)  # oracle: 2 — named expected value from the requirement

    describe "wake placement":
        it "uses the waker CPU when affinity allows it and load is close":
            # @req: REQ-OS-KERNEL-001
            step("Verify: uses the waker CPU when affinity allows it and load is close")
            val placement = green_worker_choose_wake_cpu(0, 1, 0, 2, 3, 1)

            expect(placement.cpu).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(placement.reason).to_equal("wake_affine_waker_cpu")

        it "falls back to home CPU when the waker CPU is overloaded":
            # @req: REQ-OS-KERNEL-001
            step("Verify: falls back to home CPU when the waker CPU is overloaded")
            val placement = green_worker_choose_wake_cpu(0, 1, 0, 1, 5, 1)

            expect(placement.cpu).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(placement.reason).to_equal("home_cpu")

        it "uses the first allowed CPU when home and waker CPUs are disallowed":
            # @req: REQ-OS-KERNEL-001
            step("Verify: uses the first allowed CPU when home and waker CPUs are disallowed")
            val only_cpu2 = 1 << 2
            val placement = green_worker_choose_wake_cpu(0, 1, only_cpu2, 0, 0, 1)

            expect(placement.cpu).to_equal(2)  # oracle: 2 — named expected value from the requirement
            expect(placement.reason).to_equal("first_allowed_cpu")

    describe "stealing and rebalancing":
        it "steals only when remote load crosses the threshold":
            # @req: REQ-OS-KERNEL-001
            step("Verify: steals only when remote load crosses the threshold")
            expect(green_worker_should_steal(1, 4, 2)).to_equal(true)
            expect(green_worker_should_steal(2, 3, 2)).to_equal(false)

        it "moves one worker from busiest CPU to idlest CPU":
            # @req: REQ-OS-KERNEL-001
            step("Verify: moves one worker from busiest CPU to idlest CPU")
            val decision = green_worker_rebalance_decision(4, 0, 4, 1, 2, 2)

            expect(decision.should_move).to_equal(true)
            expect(decision.from_cpu).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(decision.to_cpu).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(decision.moved_workers).to_equal(1)  # oracle: 1 — named expected value from the requirement
            expect(decision.reason).to_equal("busiest_to_idlest")

        it "does not rebalance below threshold":
            # @req: REQ-OS-KERNEL-001
            step("Verify: does not rebalance below threshold")
            val decision = green_worker_rebalance_decision(4, 2, 3, 2, 2, 2)

            expect(decision.should_move).to_equal(false)
            expect(decision.moved_workers).to_equal(0)  # oracle: 0 — named expected value from the requirement
            expect(decision.reason).to_equal("below_threshold")
