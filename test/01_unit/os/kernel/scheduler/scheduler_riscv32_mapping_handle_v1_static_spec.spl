use std.test.*
use std.fs.{file_read}

describe "RV32 generation-bound TCB mapping handle static contract":
    it "keeps mapper and registry authority outside the ABI TCB":
        val types = file_read("src/os/kernel/scheduler/scheduler_types.spl")
        val contract = file_read("src/os/kernel/types/riscv32_mapping_handle_v1.spl")
        val mapper = file_read("src/os/kernel/loader/riscv32_sv32_mapping_owner_v1.spl")
        expect(types).to_contain("riscv32_mapping_handle: SchedulerRiscv32MappingHandleV1")
        expect(types).not.to_contain("Riscv32Sv32RootLeaseV1")
        expect(types).not.to_contain("Riscv32Sv32MappingReceiptV1")
        expect(contract).to_contain("handle_generation: u64")
        expect(contract).not.to_contain("os.kernel.loader")
        expect(contract).not.to_contain("os.kernel.arch.riscv32")
        expect(mapper).to_contain("transaction: ExecutableRiscv32MappingTransactionV1")
        expect(mapper).to_contain("generation: u64")
        expect(mapper).to_contain("transaction: ExecutableRiscv32MappingTransactionV1")
        expect(mapper).not.to_contain("riscv32_sv32_mapping_handle_bind_v1")
        expect(types).to_contain("TASK_CONTROL_BLOCK_ABI_REVISION_V1: u32 = 4u32")

    it "initializes every canonical TCB constructor without copying authority":
        val bootstrap = file_read("src/os/kernel/scheduler/scheduler_arm_bootstrap.spl")
        val tasks = file_read("src/os/kernel/scheduler/scheduler_task_mgmt.spl")
        val exec = file_read("src/os/kernel/scheduler/scheduler_exec.spl")
        val adoption = file_read("src/os/kernel/scheduler/scheduler_executable_adoption.spl")
        val absent = "riscv32_mapping_handle: scheduler_riscv32_mapping_handle_absent_v1()"
        expect(bootstrap.count(absent)).to_equal(1)
        expect(tasks.count(absent)).to_equal(1)
        expect(exec.count(absent)).to_equal(4)
        expect(adoption.count(absent)).to_equal(1)
        expect(exec).to_contain("Fork cannot alias either architecture owner's destruction authority")
        expect(exec).to_contain("scheduler_riscv32_mapping_handle_present_v1(old_task.riscv32_mapping_handle)")

    it "does not activate, expose a root, or claim scheduler readiness":
        val mapper = file_read("src/os/kernel/loader/riscv32_sv32_mapping_owner_v1.spl")
        val contract = file_read("src/os/kernel/types/riscv32_mapping_handle_v1.spl")
        expect(contract).not.to_contain("root")
        expect(contract).not.to_contain("receipt")
        expect(mapper).not.to_contain("riscv32_sv32_mapping_handle_activate_v1")
        expect(mapper).not.to_contain("riscv32_sv32_mapping_handle_ready_v1")
