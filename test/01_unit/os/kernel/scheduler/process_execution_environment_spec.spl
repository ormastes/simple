use std.spec.*
use std.common.contracts.execution.simpleos_executable_admission_v1.{ExecutableImageHandleV1}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.executable_launch_arguments_v1.{executable_launch_arguments_v1_validate}
use os.kernel.loader.simpleos_tool_execution_probe_v1.{
    SimpleOsToolProbeRequestV1, simpleos_tool_probe_evidence_error_v1
}
use os.kernel.scheduler.process_execution_observation.{
    SchedulerExecutionObservationHandleV1, SchedulerExecutionEvidenceV1,
    scheduler_execution_observe_adoption_handle_with_launch_v1,
    scheduler_execution_observe_adoption_handle_v1,
    scheduler_execution_observe_exit_handle_v1,
    scheduler_execution_observe_reap_handle_v1,
    scheduler_execution_deliver_reaped_handle_v1,
    scheduler_execution_evidence_consume_once_v1,
    scheduler_execution_evidence_consume_once_v2
}

fn environment_image() -> ExecutableImageHandleV1:
    ExecutableImageHandleV1(
        schema_version: 1, open_handle_id: 11u64, mount_id: 2u64,
        filesystem_name: "ramfs", canonical_source_path: "/bin/simple_lint",
        mount_generation: 3u64, file_id: 11u64, file_generation: 4u64,
        size_bytes: 4096u64, role: "main-image",
        target: ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos"),
        verified_load_ranges: [],
        image_hash: "1111111111111111111111111111111111111111111111111111111111111111",
        admission_id: "environment-observation-fixture", trust_epoch: 5u64,
        read_count: 0u64, read_bytes: 0u64, consumed: false)

fn environment_terminal(handle: SchedulerExecutionObservationHandleV1, compatibility: bool = false) -> SchedulerExecutionEvidenceV1:
    expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
    expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
    val token = scheduler_execution_deliver_reaped_handle_v1(handle).unwrap()
    val evidence = if compatibility:
        scheduler_execution_evidence_consume_once_v1(token).unwrap()
    else:
        scheduler_execution_evidence_consume_once_v2(token).unwrap()
    expect(scheduler_execution_evidence_consume_once_v2(token).is_none()).to_equal(true)
    expect(scheduler_execution_evidence_consume_once_v1(token).is_none()).to_equal(true)
    evidence

describe "scheduler-owned execution environment evidence":
    it "retains ordered duplicate entries from the actual validated adoption":
        val launch = executable_launch_arguments_v1_validate(
            "/bin/simple_lint", ["/bin/simple_lint", "fixture.spl"],
            ["LANG=C", "SIMPLE_BINARY=/bin/simple", "LANG=POSIX"]).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            97001u64, 1u64, environment_image(), launch, true).unwrap()
        val evidence = environment_terminal(handle)
        expect(evidence.envp).to_equal(["LANG=C", "SIMPLE_BINARY=/bin/simple", "LANG=POSIX"])
        expect(evidence.argv).to_equal(["/bin/simple_lint", "fixture.spl"])

    it "owns an independent environment copy after adoption":
        var launch = executable_launch_arguments_v1_validate(
            "/bin/simple_lint", ["/bin/simple_lint"], ["SIMPLE_BINARY=/bin/simple"]).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            97002u64, 1u64, environment_image(), launch, true).unwrap()
        launch.envp[0] = "SIMPLE_BINARY=/bin/other"
        launch.envp.push("UNISSUED=1")
        expect(environment_terminal(handle, true).envp).to_equal(["SIMPLE_BINARY=/bin/simple"])

    it "keeps the compatibility adoption environment empty":
        val handle = scheduler_execution_observe_adoption_handle_v1(
            97003u64, 1u64, environment_image()).unwrap()
        val evidence = environment_terminal(handle, true)
        expect(evidence.envp).to_equal([])
        expect(evidence.command_observed).to_equal(false)

    it "rejects environment evidence not issued by the empty-environment probe":
        val launch = executable_launch_arguments_v1_validate(
            "/bin/simple_lint", ["/bin/simple_lint", "fixture.spl"], ["SIMPLE_BINARY=/bin/simple"]).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            97004u64, 1u64, environment_image(), launch, true).unwrap()
        val request = SimpleOsToolProbeRequestV1(
            path: "/bin/simple_lint", argv: ["/bin/simple_lint", "fixture.spl"],
            image_sha256: environment_image().image_hash, target_arch: "x86_64",
            expected_stdout: [], expected_stderr: [], expected_exit: 0,
            max_stdout: 1024, max_stderr: 1024)
        expect(simpleos_tool_probe_evidence_error_v1(request, environment_terminal(handle))).to_equal(
            "executed-environment-mismatch")

    it "preserves the existing empty-environment probe route":
        val launch = executable_launch_arguments_v1_validate(
            "/bin/simple_lint", ["/bin/simple_lint", "fixture.spl"], []).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            97005u64, 1u64, environment_image(), launch, true).unwrap()
        val request = SimpleOsToolProbeRequestV1(
            path: "/bin/simple_lint", argv: ["/bin/simple_lint", "fixture.spl"],
            image_sha256: environment_image().image_hash, target_arch: "x86_64",
            expected_stdout: [], expected_stderr: [], expected_exit: 0,
            max_stdout: 1024, max_stderr: 1024)
        expect(simpleos_tool_probe_evidence_error_v1(request, environment_terminal(handle))).to_equal("")
