"""
# PerCpuScheduler.preempt_check — realtime-vs-realtime priority comparison

Pins a bug in `PerCpuScheduler.preempt_check` (src/os/kernel/scheduler/sched_class_queue.spl):
when the running task is itself "realtime" and the realtime queue is
non-empty, the function is supposed to decide preemption by comparing the
*priority* of the waiting head task against `running_prio`. Instead it calls
`self.rt_queue.peek()` — which returns the head task's **pid**, not its
priority — and compares that pid directly to `running_prio`. The function's
own inline comment concedes the value is unavailable and says the intent is
"conservative false", but the code does not return false; it returns a
comparison against pid, which is wrong.

This produces a materially wrong preemption decision whenever a waiting
task's pid happens to number-compare backwards from its actual priority
relative to the running priority.
"""

use std.spec.{describe, it, expect}
use os.kernel.scheduler.sched_class_queue.{PerCpuScheduler}

describe "PerCpuScheduler.preempt_check realtime priority comparison":
    it "does not signal preemption for a low-priority waiting realtime task with a large pid":
        var sched = PerCpuScheduler.create(0)
        # Waiting realtime task: large pid (200), but LOW priority (1).
        sched.enqueue_task(200, 1, "realtime")
        # Currently running realtime task has a much higher priority (50).
        # A correct implementation must not signal preemption here, since
        # the only waiting realtime task has strictly lower priority.
        val should_preempt = sched.preempt_check("realtime", 50)
        expect(should_preempt).to_equal(false)
