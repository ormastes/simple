"""Static and pure contract coverage for scheduler pre-exit preparation."""

use std.spec.*
use os.kernel.scheduler.scheduler_pre_exit_preparation_v1.*

extern fn rt_file_read_text(path: text) -> text

describe "scheduler pre-exit preparation v1":
    it "requires every ordered provider receipt for terminal evidence":
        expect(scheduler_pre_exit_provider_completion_evidence_v1(
            true, true, true)).to_be(true)
        expect(scheduler_pre_exit_provider_completion_evidence_v1(
            false, true, true)).to_be(false)
        expect(scheduler_pre_exit_provider_completion_evidence_v1(
            true, false, true)).to_be(false)
        expect(scheduler_pre_exit_provider_completion_evidence_v1(
            true, true, false)).to_be(false)
        expect(scheduler_pre_exit_state_authorizes_terminal_v1(
            SchedulerPreExitPreparationStateV1.Completed)).to_be(false)
        expect(scheduler_pre_exit_state_authorizes_terminal_v1(
            SchedulerPreExitPreparationStateV1.Consumed)).to_be(true)

    it "advances cancellation retry identity exactly and never wraps":
        expect(scheduler_pre_exit_attempt_advance_valid_v1(
            1u64, 2u64)).to_be(true)
        expect(scheduler_pre_exit_attempt_advance_valid_v1(
            1u64, 3u64)).to_be(false)
        expect(scheduler_pre_exit_attempt_advance_valid_v1(
            0u64, 1u64)).to_be(false)
        expect(scheduler_pre_exit_attempt_advance_valid_v1(
            0xffffffffffffffffu64, 0u64)).to_be(false)

    it "orders persistence before namespace and grant mutation":
        val source = rt_file_read_text(
            "src/os/kernel/scheduler/scheduler_pre_exit_preparation_v1.spl") ?? ""
        val persistence = source.index_of(
            "dbd_cleanup_provider_commit_result_v1(")
        val binding = source.index_of("server_data_cleanup_bind_v1(")
        val server_commit = source.index_of("server_data_cleanup_commit_v1(")
        expect(persistence).to_be_greater_than(0)
        expect(persistence).to_be_less_than(binding)
        expect(binding).to_be_less_than(server_commit)
        expect(source).to_contain("receipt.attempt_ordinal == slot.attempt_ordinal")

    it "retains consumed evidence pending scheduler publication and reap":
        val source = rt_file_read_text(
            "src/os/kernel/scheduler/scheduler_pre_exit_preparation_v1.spl") ?? ""
        expect(source).to_contain(
            "SchedulerPreExitPreparationStateV1.Consumed")
        expect(source.index_of(
            "scheduler_pre_exit_release_consumed_v1")).to_equal(-1)
        expect(source).to_contain("server_consumed")
        expect(source).to_contain("dbd_consumed")

    it "does not publish Zombie from the preparation owner":
        val source = rt_file_read_text(
            "src/os/kernel/scheduler/scheduler_pre_exit_preparation_v1.spl") ?? ""
        expect(source.index_of("task.state = TaskState.Zombie")).to_equal(-1)
        expect(source.index_of(
            "sched_exit_task_by_id_with_code_impl(")).to_equal(-1)
