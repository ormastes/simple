use std.spec.{describe, it, expect}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.task_types.{TaskPriority}
use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken, CapabilityKind}

fn _token(id: u64, owner: u64, depth: i64) -> CapabilityToken:
    CapabilityToken(
        kind: CapabilityKind.FileRead(path_prefix: "/workspace"), generation: 4u64,
        owner: owner, token_id: id, parent_token_id: 0u64, depth: depth
    )

describe "scheduler live CSpace delegation":
    it "mints an attenuated lineage child into the target task":
        var scheduler = Scheduler.new()
        val source = scheduler.create_task(0x1000, TaskPriority.Normal,
            CapabilitySet(caps: [_token(50u64, 0u64, 2i64)], is_pledged: true))
        val target = scheduler.create_task(0x2000, TaskPriority.Normal, CapabilitySet.empty())
        val child_id = scheduler.delegate_cspace_token(source, target, 50u64)
        expect(child_id).to_be_greater_than(50i64)
        val received = scheduler.get_task(target)
        if received != nil:
            expect(received.capabilities.caps.len()).to_equal(1)
            expect(received.capabilities.caps[0].parent_token_id).to_equal(50u64)
            expect(received.capabilities.caps[0].depth).to_equal(1i64)
            expect(received.capabilities.caps[0].owner).to_equal(target.id)

    it "rejects foreign and exhausted source tokens without mutation":
        var scheduler = Scheduler.new()
        val source = scheduler.create_task(0x1000, TaskPriority.Normal,
            CapabilitySet(caps: [_token(50u64, 0u64, 0i64)], is_pledged: true))
        val target = scheduler.create_task(0x2000, TaskPriority.Normal, CapabilitySet.empty())
        expect(scheduler.delegate_cspace_token(source, target, 50u64)).to_equal(-1i64)
        expect(scheduler.delegate_cspace_token(source, target, 99u64)).to_equal(-1i64)
        val received = scheduler.get_task(target)
        if received != nil:
            expect(received.capabilities.caps.len()).to_equal(0)
