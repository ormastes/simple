use std.spec.*
use std.common.contracts.execution.simpleos_executable_admission_v1.{ExecutableImageHandleV1}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.executable_launch_arguments_v1.{
    executable_launch_arguments_v1_validate
}
use std.concurrent.thread.{thread_spawn}
use os.kernel.arch.riscv64.process_stdout_capture.{
    rv64_process_stdout_begin, rv64_process_stdout_bind_child,
    rv64_process_stdout_write_byte, rv64_process_stdout_seal_and_flush,
    rv64_process_stdout_finish, rv64_process_stdout_last_scheduler_commit_count_v1
}
use os.kernel.scheduler.process_execution_observation.{
    scheduler_execution_observe_adoption_v1, scheduler_execution_observe_exit_v1,
    scheduler_execution_observe_reap_v1, scheduler_execution_take_reaped_token_v1,
    scheduler_execution_evidence_consume_once_v1,
    scheduler_execution_evidence_consume_once_v2,
    scheduler_execution_compare_and_deliver_reaped_v2,
    scheduler_execution_discard_terminal_v2,
    SchedulerExecutionDeliveryStatusV2,
    scheduler_execution_observe_adoption_handle_v1,
    scheduler_execution_observe_adoption_handle_with_launch_v1,
    scheduler_execution_observe_stdout_byte_for_handle_v1,
    scheduler_execution_observe_stdout_batch_for_handle_v1,
    scheduler_execution_observe_stderr_byte_for_handle_v1,
    scheduler_execution_observe_exit_handle_v1,
    scheduler_execution_observe_reap_handle_v1,
    scheduler_execution_deliver_reaped_handle_v1
}

fn _handle() -> ExecutableImageHandleV1:
    ExecutableImageHandleV1(
        schema_version: 1, open_handle_id: 11u64, mount_id: 2u64,
        mount_generation: 3u64, file_id: 11u64, file_generation: 4u64,
        size_bytes: 4096u64, role: "main-image",
        target: ManifestTarget(os: "simpleos", arch: "riscv64", abi: "lp64d"),
        verified_load_ranges: [],
        image_hash: "1111111111111111111111111111111111111111111111111111111111111111",
        admission_id: "observation-capacity", trust_epoch: 5u64,
        read_count: 0u64, read_bytes: 0u64, consumed: false)

fn _race_delivery_410() -> i64:
    val result = scheduler_execution_compare_and_deliver_reaped_v2(
        410u64, "/tool", ["tool", "parallel"])
    if result.status == SchedulerExecutionDeliveryStatusV2.Delivered: return 1
    if result.status == SchedulerExecutionDeliveryStatusV2.Replay: return 2
    0

describe "scheduler execution observation capacity":
    it "retains the scheduler-owned exact executable path and argv once":
        val launch = executable_launch_arguments_v1_validate(
            "/SYS/APPS/SIMPLEBOX.ELF", ["simplebox", "echo", "hello world"], []).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            400u64, 7u64, _handle(), launch)
        expect(handle.is_some()).to_equal(true)
        expect(scheduler_execution_observe_exit_handle_v1(handle.unwrap(), 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(handle.unwrap())).to_equal(true)
        val delivered = scheduler_execution_compare_and_deliver_reaped_v2(
            400u64, "/SYS/APPS/SIMPLEBOX.ELF",
            ["simplebox", "echo", "hello world"])
        expect(delivered.status).to_equal(SchedulerExecutionDeliveryStatusV2.Delivered)
        val token = delivered.token.unwrap()
        val evidence = scheduler_execution_evidence_consume_once_v2(token).unwrap()
        expect(evidence.command_observed).to_equal(true)
        expect(evidence.executable_path).to_equal("/SYS/APPS/SIMPLEBOX.ELF")
        expect(evidence.argv).to_equal(["simplebox", "echo", "hello world"])
        expect(scheduler_execution_evidence_consume_once_v2(token).is_some()).to_equal(false)

    it "rejects malformed or unbounded launch evidence before reserving a slot":
        val invalid = scheduler_execution_compare_and_deliver_reaped_v2(
            408u64, "", ["tool"])
        expect(invalid.status).to_equal(
            SchedulerExecutionDeliveryStatusV2.InvalidExpectedCommand)

    it "tombstones a terminal command mismatch and rejects legacy rows in V2":
        val launch = executable_launch_arguments_v1_validate(
            "/tool", ["tool", "good"], []).unwrap()
        val exact = scheduler_execution_observe_adoption_handle_with_launch_v1(
            408u64, 7u64, _handle(), launch).unwrap()
        expect(scheduler_execution_observe_exit_handle_v1(exact, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(exact)).to_equal(true)
        val mismatch = scheduler_execution_compare_and_deliver_reaped_v2(
            408u64, "/tool", ["tool", "bad"])
        expect(mismatch.status).to_equal(
            SchedulerExecutionDeliveryStatusV2.CommandMismatch)
        expect(scheduler_execution_take_reaped_token_v1(408u64).is_some()).to_equal(false)

        val legacy = scheduler_execution_observe_adoption_handle_v1(
            409u64, 7u64, _handle()).unwrap()
        expect(scheduler_execution_observe_exit_handle_v1(legacy, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(legacy)).to_equal(true)
        val legacy_token = scheduler_execution_deliver_reaped_handle_v1(legacy).unwrap()
        expect(scheduler_execution_evidence_consume_once_v2(legacy_token).is_some()).to_equal(false)
        val legacy_evidence = scheduler_execution_evidence_consume_once_v1(legacy_token).unwrap()
        expect(legacy_evidence.command_observed).to_equal(false)
        expect(legacy_evidence.executable_path).to_equal("")
        expect(legacy_evidence.argv.len()).to_equal(0)

    it "normalizes empty argv and rejects replay and stale generation in V2":
        val launch = executable_launch_arguments_v1_validate("/empty", [], []).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            411u64, 7u64, _handle(), launch).unwrap()
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
        val delivered = scheduler_execution_compare_and_deliver_reaped_v2(
            411u64, "/empty", [])
        expect(delivered.status).to_equal(SchedulerExecutionDeliveryStatusV2.Delivered)
        val replay = scheduler_execution_compare_and_deliver_reaped_v2(
            411u64, "/empty", [])
        expect(replay.status).to_equal(SchedulerExecutionDeliveryStatusV2.Replay)
        val old_token = delivered.token.unwrap()
        val evidence = scheduler_execution_evidence_consume_once_v2(old_token).unwrap()
        expect(evidence.argv).to_equal(["/empty"])
        val replacement = scheduler_execution_observe_adoption_handle_with_launch_v1(
            412u64, 7u64, _handle(), launch).unwrap()
        expect(scheduler_execution_evidence_consume_once_v2(old_token).is_some()).to_equal(false)
        expect(scheduler_execution_discard_terminal_v2(412u64)).to_equal(false)
        expect(scheduler_execution_observe_exit_handle_v1(replacement, -10)).to_equal(true)
        expect(scheduler_execution_discard_terminal_v2(412u64)).to_equal(true)
        expect(scheduler_execution_take_reaped_token_v1(412u64).is_some()).to_equal(false)

    it "serializes concurrent token delivery to one winner":
        val launch = executable_launch_arguments_v1_validate(
            "/tool", ["tool", "parallel"], []).unwrap()
        val handle = scheduler_execution_observe_adoption_handle_with_launch_v1(
            410u64, 7u64, _handle(), launch).unwrap()
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
        val first = thread_spawn(\: _race_delivery_410())
        val second = thread_spawn(\: _race_delivery_410())
        val a = first.join()
        val b = second.join()
        expect(a + b).to_equal(3)
        val token = scheduler_execution_take_reaped_token_v1(410u64)
        expect(token.is_some()).to_equal(false)
        expect(scheduler_execution_discard_terminal_v2(410u64)).to_equal(true)

    it "rejects duplicate live children and isolates interleaved handle operations":
        val first = scheduler_execution_observe_adoption_handle_v1(401u64, 7u64, _handle()).unwrap()
        val second = scheduler_execution_observe_adoption_handle_v1(402u64, 7u64, _handle()).unwrap()
        expect(scheduler_execution_observe_adoption_handle_v1(401u64, 7u64, _handle()).is_some()).to_equal(false)
        expect(scheduler_execution_observe_stdout_byte_for_handle_v1(first, 0x41u8)).to_equal(true)
        expect(scheduler_execution_observe_stderr_byte_for_handle_v1(second, 0x42u8)).to_equal(true)
        expect(scheduler_execution_observe_exit_handle_v1(second, 2)).to_equal(true)
        expect(scheduler_execution_observe_stdout_byte_for_handle_v1(second, 0x58u8)).to_equal(false)
        expect(scheduler_execution_observe_exit_handle_v1(first, 1)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(first)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(second)).to_equal(true)
        val first_token = scheduler_execution_deliver_reaped_handle_v1(first).unwrap()
        val second_token = scheduler_execution_deliver_reaped_handle_v1(second).unwrap()
        val first_evidence = scheduler_execution_evidence_consume_once_v1(first_token).unwrap()
        val second_evidence = scheduler_execution_evidence_consume_once_v1(second_token).unwrap()
        expect(first_evidence.stdout_bytes).to_equal([0x41u8])
        expect(first_evidence.stderr_bytes.len()).to_equal(0)
        expect(second_evidence.stdout_bytes.len()).to_equal(0)
        expect(second_evidence.stderr_bytes).to_equal([0x42u8])

    it "requires delivery and rejects stale and replayed owner-issued coordinates":
        val handle = scheduler_execution_observe_adoption_handle_v1(403u64, 7u64, _handle()).unwrap()
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        val undelivered = scheduler_execution_observe_reap_v1(403u64).unwrap()
        expect(scheduler_execution_evidence_consume_once_v1(undelivered).is_some()).to_equal(false)
        val delivered = scheduler_execution_deliver_reaped_handle_v1(handle).unwrap()
        expect(scheduler_execution_deliver_reaped_handle_v1(handle).is_some()).to_equal(false)
        expect(scheduler_execution_evidence_consume_once_v1(delivered).is_some()).to_equal(true)
        expect(scheduler_execution_evidence_consume_once_v1(delivered).is_some()).to_equal(false)
        expect(scheduler_execution_observe_stdout_byte_for_handle_v1(handle, 0x58u8)).to_equal(false)
        val replacement = scheduler_execution_observe_adoption_handle_v1(405u64, 7u64, _handle()).unwrap()
        expect(scheduler_execution_evidence_consume_once_v1(delivered).is_some()).to_equal(false)
        expect(scheduler_execution_observe_stdout_byte_for_handle_v1(handle, 0x58u8)).to_equal(false)
        expect(scheduler_execution_observe_exit_handle_v1(replacement, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(replacement)).to_equal(true)
        val replacement_token = scheduler_execution_deliver_reaped_handle_v1(replacement).unwrap()
        expect(scheduler_execution_evidence_consume_once_v1(replacement_token).is_some()).to_equal(true)

    it "bounds stdout and stderr independently and reports each truncation":
        val handle = scheduler_execution_observe_adoption_handle_v1(404u64, 7u64, _handle()).unwrap()
        var i = 0
        while i < 65535:
            expect(scheduler_execution_observe_stdout_byte_for_handle_v1(handle, 0x41u8)).to_equal(true)
            expect(scheduler_execution_observe_stderr_byte_for_handle_v1(handle, 0x42u8)).to_equal(true)
            i = i + 1
        expect(scheduler_execution_observe_stdout_batch_for_handle_v1(
            handle, [0x44u8], 2)).to_equal(-1)
        expect(scheduler_execution_observe_stdout_batch_for_handle_v1(
            handle, [0x43u8, 0x58u8, 0x59u8], 3)).to_equal(1)
        expect(scheduler_execution_observe_stderr_byte_for_handle_v1(handle, 0x42u8)).to_equal(true)
        expect(scheduler_execution_observe_stderr_byte_for_handle_v1(handle, 0x59u8)).to_equal(false)
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        expect(scheduler_execution_observe_stdout_batch_for_handle_v1(
            handle, [0x60u8, 0x61u8], 2)).to_equal(-1)
        expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
        val evidence = scheduler_execution_evidence_consume_once_v1(
            scheduler_execution_deliver_reaped_handle_v1(handle).unwrap()).unwrap()
        expect(evidence.stdout_bytes.len()).to_equal(65536)
        expect(evidence.stdout_bytes[65535]).to_equal(0x43u8)
        expect(evidence.stderr_bytes.len()).to_equal(65536)
        expect(evidence.stdout_truncated).to_equal(true)
        expect(evidence.stderr_truncated).to_equal(true)
        expect(scheduler_execution_observe_stdout_batch_for_handle_v1(
            handle, [0x62u8], 1)).to_equal(-1)

    it "forwards RV64 bytes beyond its local 4096-byte display prefix":
        val handle = scheduler_execution_observe_adoption_handle_v1(406u64, 7u64, _handle()).unwrap()
        val session = rv64_process_stdout_begin().unwrap()
        expect(rv64_process_stdout_bind_child(session, 406u64, true)).to_equal(true)
        var i = 0
        while i < 4097:
            _ = rv64_process_stdout_write_byte(406u64, 0x41u8)
            i = i + 1
        val local = rv64_process_stdout_finish(session, 0).unwrap()
        expect(local.bytes.len()).to_equal(4096)
        expect(local.truncated).to_equal(true)
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
        val evidence = scheduler_execution_evidence_consume_once_v1(
            scheduler_execution_deliver_reaped_handle_v1(handle).unwrap()).unwrap()
        expect(evidence.stdout_bytes.len()).to_equal(4097)
        expect(evidence.stdout_truncated).to_equal(false)
        # 4097 bytes use sixteen full 256-byte commits plus one tail commit,
        # rather than 4097 scheduler lock cycles.
        expect(rv64_process_stdout_last_scheduler_commit_count_v1()).to_equal(17u64)

    it "commits an ordered tail before exit and bounds scheduler lock cycles":
        val handle = scheduler_execution_observe_adoption_handle_v1(407u64, 7u64, _handle()).unwrap()
        val session = rv64_process_stdout_begin().unwrap()
        expect(rv64_process_stdout_bind_child(session, 407u64, true)).to_equal(true)
        var i = 0
        while i < 513:
            expect(rv64_process_stdout_write_byte(407u64, (i % 251).to_u8())).to_equal(true)
            i = i + 1
        expect(rv64_process_stdout_seal_and_flush(session)).to_equal(true)
        expect(rv64_process_stdout_write_byte(407u64, 0xFFu8)).to_equal(false)
        expect(scheduler_execution_observe_exit_handle_v1(handle, 0)).to_equal(true)
        expect(rv64_process_stdout_finish(session, 0).is_some()).to_equal(true)
        expect(rv64_process_stdout_last_scheduler_commit_count_v1()).to_equal(3u64)
        expect(scheduler_execution_observe_reap_handle_v1(handle)).to_equal(true)
        val evidence = scheduler_execution_evidence_consume_once_v1(
            scheduler_execution_deliver_reaped_handle_v1(handle).unwrap()).unwrap()
        expect(evidence.stdout_bytes.len()).to_equal(513)
        var j = 0
        while j < evidence.stdout_bytes.len():
            expect(evidence.stdout_bytes[j]).to_equal((j % 251).to_u8())
            j = j + 1

    it "reuses generation-safe slots for more than 256 sequential executions":
        var i = 1u64
        while i <= 300u64:
            expect(scheduler_execution_observe_adoption_v1(i, 0u64, _handle())).to_equal(true)
            scheduler_execution_observe_exit_v1(i, 0)
            expect(scheduler_execution_observe_reap_v1(i).is_some()).to_equal(true)
            val token = scheduler_execution_take_reaped_token_v1(i).unwrap()
            expect(scheduler_execution_evidence_consume_once_v1(token).is_some()).to_equal(true)
            expect(scheduler_execution_evidence_consume_once_v1(token).is_some()).to_equal(false)
            i = i + 1u64

    it "rejects the 257th concurrent reservation without an orphan token":
        var i = 1000u64
        while i < 1256u64:
            expect(scheduler_execution_observe_adoption_v1(i, 0u64, _handle())).to_equal(true)
            i = i + 1u64
        expect(scheduler_execution_observe_adoption_v1(1256u64, 0u64, _handle())).to_equal(false)
        scheduler_execution_observe_exit_v1(1256u64, 0)
        expect(scheduler_execution_observe_reap_v1(1256u64).is_some()).to_equal(false)
        expect(scheduler_execution_take_reaped_token_v1(1256u64).is_some()).to_equal(false)
