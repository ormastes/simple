use std.spec.{describe, it, expect}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.task_types.{TaskPriority, TaskId}
use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken, CapabilityKind}

fn _token(token_id: u64, parent_token_id: u64) -> CapabilityToken:
    CapabilityToken(
        kind: CapabilityKind.ProcessSpawn, generation: 1u64, owner: 0u64,
        token_id: token_id, parent_token_id: parent_token_id, depth: 1i64
    )

describe "scheduler live CSpace revocation":
    it "removes a provenance root and descendants across task CSpaces":
        var scheduler = Scheduler.new()
        val parent = scheduler.create_task(0x1000, TaskPriority.Normal,
            CapabilitySet(caps: [_token(100u64, 0u64)], is_pledged: true))
        val child = scheduler.create_task(0x2000, TaskPriority.Normal,
            CapabilitySet(caps: [_token(101u64, 100u64)], is_pledged: true))
        expect(scheduler.revoke_cspace_lineage(100u64)).to_equal(2i64)
        val parent_task = scheduler.get_task(parent)
        val child_task = scheduler.get_task(child)
        if parent_task != nil and child_task != nil:
            expect(parent_task.capabilities.caps.len()).to_equal(0)
            expect(child_task.capabilities.caps.len()).to_equal(0)
            expect(parent_task.security.cspace_id).to_be_greater_than(parent.id.id)

    it "rejects the non-token sentinel without changing any CSpace":
        var scheduler = Scheduler.new()
        val task = scheduler.create_task(0x1000, TaskPriority.Normal,
            CapabilitySet(caps: [_token(100u64, 0u64)], is_pledged: true))
        expect(scheduler.revoke_cspace_lineage(0u64)).to_equal(0i64)
        val live = scheduler.get_task(task)
        if live != nil:
            expect(live.capabilities.caps.len()).to_equal(1)
