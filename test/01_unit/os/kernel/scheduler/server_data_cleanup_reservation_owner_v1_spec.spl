"""Contract coverage for the unwired two-owner server cleanup reservation."""

use std.spec.*
use os.kernel.scheduler.server_data_cleanup_reservation_owner_v1.*
use os.kernel.scheduler.server_data_namespace_owner.*
use os.kernel.scheduler.server_data_launch_grant_registry.*

extern fn rt_file_read_text(path: text) -> text

describe "server data cleanup reservation owner v1":
    it "requires terminal evidence from both canonical owners":
        expect(server_data_cleanup_terminal_v1(true, true)).to_be(true)
        expect(server_data_cleanup_terminal_v1(true, false)).to_be(false)
        expect(server_data_cleanup_terminal_v1(false, true)).to_be(false)
        expect(server_data_cleanup_retryable_v1(true, false)).to_be(true)

    it "fences duplicate dispatch and retains partial retry states":
        val bound = server_data_cleanup_state_transition_v1(
            ServerDataCleanupReservationStateV1.Preparing,
            ServerDataCleanupReservationEventV1.PublishBound).unwrap()
        val dispatch = server_data_cleanup_state_transition_v1(
            bound, ServerDataCleanupReservationEventV1.BeginDispatch).unwrap()
        expect(server_data_cleanup_state_transition_v1(
            dispatch,
            ServerDataCleanupReservationEventV1.BeginDispatch).is_some()).to_be(false)
        val partial = server_data_cleanup_state_transition_v1(
            dispatch,
            ServerDataCleanupReservationEventV1.RetainPartial).unwrap()
        expect(server_data_cleanup_state_transition_v1(
            partial,
            ServerDataCleanupReservationEventV1.BeginDispatch)).to_equal(
                Some(ServerDataCleanupReservationStateV1.Dispatching))

    it "keeps indeterminate work non-dispatchable and consumes terminal capacity":
        val indeterminate = server_data_cleanup_state_transition_v1(
            ServerDataCleanupReservationStateV1.Dispatching,
            ServerDataCleanupReservationEventV1.MarkIndeterminate).unwrap()
        expect(server_data_cleanup_state_transition_v1(
            indeterminate,
            ServerDataCleanupReservationEventV1.BeginDispatch).is_some()).to_be(false)
        val completed = server_data_cleanup_state_transition_v1(
            ServerDataCleanupReservationStateV1.Dispatching,
            ServerDataCleanupReservationEventV1.RecordComplete).unwrap()
        expect(server_data_cleanup_state_transition_v1(
            completed,
            ServerDataCleanupReservationEventV1.ConsumeTerminal)).to_equal(
                Some(ServerDataCleanupReservationStateV1.Free))
        expect(server_data_cleanup_slot_reusable_v1(
            ServerDataCleanupReservationStateV1.Free, 7u64)).to_be(true)
        expect(server_data_cleanup_slot_reusable_v1(
            ServerDataCleanupReservationStateV1.Free,
            0xffffffffffffffffu64)).to_be(false)

    it "rejects stale generation and nonce after slot reuse":
        expect(server_data_cleanup_handle_matches_v1(
            ServerDataCleanupReservationStateV1.Bound,
            8u64, 90u64, 8u64, 90u64)).to_be(true)
        expect(server_data_cleanup_handle_matches_v1(
            ServerDataCleanupReservationStateV1.Bound,
            9u64, 91u64, 8u64, 90u64)).to_be(false)
        expect(server_data_cleanup_handle_matches_v1(
            ServerDataCleanupReservationStateV1.Free,
            8u64, 90u64, 8u64, 90u64)).to_be(false)

    it "makes cleanup binding non-operational and rollback explicit":
        expect(server_data_namespace_lease_transition_v1(
            ServerDataNamespaceLeaseStateV1.Active,
            ServerDataNamespaceLeaseEventV1.BindCleanup)).to_equal(
                Some(ServerDataNamespaceLeaseStateV1.CleanupBound))
        expect(server_data_namespace_binding_allowed_v1(
            ServerDataNamespaceLeaseStateV1.CleanupBound,
            41u64, 9u64, 41u64, 9u64,
            7u32, 7u32, 3u64, 3u64, 17, 17, 23u64, 23u64)).to_be(false)
        expect(server_data_namespace_lease_transition_v1(
            ServerDataNamespaceLeaseStateV1.CleanupBound,
            ServerDataNamespaceLeaseEventV1.RollbackCleanup)).to_equal(
                Some(ServerDataNamespaceLeaseStateV1.Active))

    it "binds and rolls back the matching redeemed launch grant only":
        expect(server_data_launch_grant_protocol_transition_v1(
            ServerDataLaunchGrantProtocolStateV1.Redeemed,
            ServerDataLaunchGrantProtocolEventV1.BindCleanup)).to_equal(
                Some(ServerDataLaunchGrantProtocolStateV1.CleanupBound))
        expect(server_data_launch_grant_protocol_transition_v1(
            ServerDataLaunchGrantProtocolStateV1.CleanupBound,
            ServerDataLaunchGrantProtocolEventV1.RollbackCleanup)).to_equal(
                Some(ServerDataLaunchGrantProtocolStateV1.Redeemed))
        expect(server_data_launch_grant_protocol_transition_v1(
            ServerDataLaunchGrantProtocolStateV1.Installed,
            ServerDataLaunchGrantProtocolEventV1.BindCleanup).is_some()).to_be(false)

    it "pre-admits before provider reservation and retains partial retry identity":
        val source = rt_file_read_text(
            "src/os/kernel/scheduler/server_data_cleanup_reservation_owner_v1.spl") ?? ""
        val admission = source.index_of(
            "ServerDataCleanupReservationStateV1.Preparing")
        val namespace = source.index_of(
            "val namespace = server_data_namespace_reserve_cleanup_v1(")
        val grant = source.index_of(
            "val grant = server_data_launch_grant_reserve_cleanup_v1(")
        expect(admission).to_be_less_than(namespace)
        expect(namespace).to_be_less_than(grant)
        expect(source).to_contain("RetainedPartial")
        expect(source).to_contain("transaction_generation")
        expect(source).to_contain("attempt_ordinal")
        expect(source).to_contain("NamespaceCommitted")
        expect(source).to_contain("ServerDataCleanupReservationStateV1.Indeterminate")
        expect(source).to_contain("server_data_cleanup_consume_terminal_v1")
        expect(source).to_contain("cleanup attempt already dispatching")
        expect(source).to_contain("namespace-reserve-failed-rolled-back")
        expect(source).to_contain("grant-reserve-failed-namespace-retained")
