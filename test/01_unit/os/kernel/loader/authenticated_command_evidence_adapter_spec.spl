use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

fn _source(path: text) -> text:
    rt_file_read_text(path) ?? ""

describe "authenticated command evidence architecture adapters":
    it "threads multi-argument launch data into x86_64 evidence delivery":
        val source = _source("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        expect(source.contains("x86_64_fs_exec_spawn_authenticated_with_launch_v1")).to_equal(true)
        expect(source.contains("caller, path, argv, envp, recipe")).to_equal(true)
        expect(source.contains("child.id, path, argv")).to_equal(true)
        expect(source.contains("scheduler_execution_discard_terminal_v2(child.id)")).to_equal(true)

    it "threads multi-argument launch data into ARM64 evidence delivery":
        val source = _source("src/os/kernel/loader/arm64_fs_exec_spawn.spl")
        expect(source.contains("arm64_fs_exec_spawn_authenticated_with_launch_v1")).to_equal(true)
        expect(source.contains("caller, path, argv, envp, recipe")).to_equal(true)
        expect(source.contains("child.id, path, argv")).to_equal(true)
        expect(source.contains("scheduler_execution_discard_terminal_v2(child.id)")).to_equal(true)

    it "uses the same exact RV64 argv and V2 consumer without legacy delivery":
        val source = _source("src/os/kernel/loader/riscv64_fs_exec_spawn.spl")
        expect(source.contains("caller, path, argv, envp, recipe")).to_equal(true)
        expect(source.contains("child.id, path, argv")).to_equal(true)
        expect(source.contains("scheduler_execution_evidence_consume_once_v2")).to_equal(true)
        expect(source.contains("scheduler_execution_discard_terminal_v2(child_id)")).to_equal(true)
