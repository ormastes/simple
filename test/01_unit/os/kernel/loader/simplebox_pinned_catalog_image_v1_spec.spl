use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestResourceLimits, ManifestTarget, SimpleArtifactManifest
}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes
}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SimpleboxSignedCatalogExternalCandidateV1,
    simplebox_signed_catalog_record_encode_v1
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1
}
use os.kernel.loader.simplebox_pinned_catalog_image_v1.{
    simplebox_pinned_catalog_image_shape_valid_v1
}
use os.tools.simplebox.simplebox_artifact_contract.{
    SIMPLEBOX_CANONICAL_PATH_V1, simplebox_canonical_aliases_v1
}

fn pinned_image_fixture(payload: [u8]) -> [u8]:
    val digest = sha256_u8_hex(payload)
    val signature = "ed25519:image-key:" + "33" * 64
    val manifest = SimpleArtifactManifest(
        format_version: 1, artifact_kind: "native-executable",
        target: ManifestTarget(
            os: "simpleos", arch: "x86_64", abi: "simpleos"),
        entrypoint: SIMPLEBOX_CANONICAL_PATH_V1,
        required_abi_features: [], required_services: [],
        required_capabilities: 0u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 16,
            max_threads: 1, cpu_budget_us: 0),
        namespace_template: "simplebox", native_libraries: [],
        smf_libraries: [], interpreter: "", argument_schema: [],
        startup_preloads: [], content_hashes: [digest],
        signature: signature, debug_identity: "simplebox")
    val sam1 = encode_simple_artifact_manifest_v1_signing_bytes(manifest, digest)
    simplebox_signed_catalog_record_encode_v1(
        SimpleboxSignedCatalogExternalCandidateV1(
            sam1_identity_sha256: sha256_u8_hex(sam1.bytes),
            record: InstalledArtifactBootRecordV1(
                canonical_path: SIMPLEBOX_CANONICAL_PATH_V1,
                aliases: simplebox_canonical_aliases_v1(),
                content_sha256: digest, detached_signature: signature,
                expected_trust_root_sha256: "44" * 32,
                manifest: manifest))).unwrap()

fn pinned_roots_fixture() -> [ExecutableManifestTrustedSignerV1]:
    [ExecutableManifestTrustedSignerV1(
        key_id: "image-key", public_key: [7u8] * 32)]

describe "boot-owned pinned Simplebox catalog image":
    it "derives its manifest from canonical on-image SAM1 bytes":
        val payload = [1u8, 2u8, 3u8, 4u8]
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            payload, pinned_image_fixture(payload), pinned_roots_fixture())).to_be(true)

    it "rejects a payload substitution before boot ingestion":
        val payload = [1u8, 2u8, 3u8, 4u8]
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            [9u8], pinned_image_fixture(payload), pinned_roots_fixture())).to_be(false)

    it "rejects trailing SCR1 bytes and duplicate boot signer identities":
        val payload = [1u8, 2u8, 3u8, 4u8]
        var scr1 = pinned_image_fixture(payload)
        scr1.push(0u8)
        val duplicate = pinned_roots_fixture() + pinned_roots_fixture()
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            payload, scr1, pinned_roots_fixture())).to_be(false)
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            payload, pinned_image_fixture(payload), duplicate)).to_be(false)

    it "rejects truncated SCR1 and an oversized declared path before copying it":
        val payload = [1u8, 2u8, 3u8, 4u8]
        var truncated = pinned_image_fixture(payload)
        truncated.pop()
        var oversized = pinned_image_fixture(payload)
        # SCR1 envelope is eight bytes; its first u32 is canonical-path length.
        oversized[8] = 1u8
        oversized[9] = 16u8
        oversized[10] = 0u8
        oversized[11] = 0u8
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            payload, truncated, pinned_roots_fixture())).to_be(false)
        expect(simplebox_pinned_catalog_image_shape_valid_v1(
            payload, oversized, pinned_roots_fixture())).to_be(false)
