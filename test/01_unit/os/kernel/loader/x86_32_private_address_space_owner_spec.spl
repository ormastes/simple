# x86_32 filesystem-exec private address-space ownership gate.

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

val PAGING = "src/os/kernel/arch/x86_32/paging.spl"
val ADAPTER = "src/os/kernel/memory/user_address_space.spl"

describe "x86_32 private PT_LOAD mapping owner":
    it "maps through the selected child page directory":
        val source = rt_file_read_text(PAGING)
        expect(source).to_contain("fn x86_32_vmm_map_page_in(pd_phys: u32")
        expect(source).to_contain("_ensure_table_entry(pd_phys, _pd_index(vaddr))")
        expect(source).to_contain("pd_phys == g_vmm.pd_phys")

    it "reclaims only the user three-gigabyte region":
        val source = rt_file_read_text(PAGING)
        expect(source).to_contain("fn x86_32_vmm_destroy_address_space(pd_phys: u32)")
        expect(source).to_contain("while pd_index < 768")
        expect(source).to_contain("pmm_free_page(PageFrame(pfn: (_pte_phys_addr(pt_entry) / PAGE_SIZE) as u64))")

    it "routes x86 loader operations away from the x86_64 PML4 owner":
        val source = rt_file_read_text(ADAPTER)
        val x86_start = source.index_of("@cfg(x86)\nfn create_user_address_space()") ?? -1
        expect(x86_start >= 0).to_be(true)
        val x86 = source.substring(x86_start, source.len())
        expect(x86).to_contain("os.kernel.arch.x86_32.paging")
        expect(x86).to_contain("x86_32_vmm_map_page_in(space.phys_root as u32")
        expect(x86).to_contain("x86_32_vmm_destroy_address_space(space.phys_root as u32)")
        expect(x86.contains("vmm_map_page_in(space, virt, phys, flags)")).to_be(false)

    it "sabotage oracle detects implicit-root restoration":
        val source = rt_file_read_text(ADAPTER)
        val sabotaged = source.replace(
            "x86_32_vmm_map_page_in(space.phys_root as u32, virt, phys, flags)",
            "vmm_map_page_in(space, virt, phys, flags)"
        )
        expect(sabotaged).to_contain("vmm_map_page_in(space, virt, phys, flags)")
        expect(sabotaged.contains("x86_32_vmm_map_page_in(space.phys_root as u32, virt, phys, flags)")).to_be(false)
