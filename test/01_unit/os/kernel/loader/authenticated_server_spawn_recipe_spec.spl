"""Least-authority child policy for the authenticated combined server."""

use std.spec.*
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_AUTH_MEDIA_SERVER, spawn_recipe_grants
}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_EXECUTABLE_V1, SIMPLEOS_SERVER_STATIC_FILE_V1,
    SIMPLEOS_SERVER_DB_KEY_V1, SIMPLEOS_SERVER_HTTP_PORT_V1,
    SIMPLEOS_SERVER_DATABASE_PORT_V1, server_launch_grants_v1
}
use os.kernel.types.capability_types.{CapabilityKind}

fn _server_recipe_has_v1(kind: CapabilityKind) -> bool:
    for grant in spawn_recipe_grants(SPAWN_RECIPE_AUTH_MEDIA_SERVER):
        if grant.requested == kind: return true
    false

describe "authenticated server spawn recipe":
    it "matches the service policy and excludes parent-only spawn authority":
        val grants = spawn_recipe_grants(SPAWN_RECIPE_AUTH_MEDIA_SERVER)
        expect(grants).to_equal(server_launch_grants_v1(
            SIMPLEOS_SERVER_EXECUTABLE_V1))
        expect(_server_recipe_has_v1(CapabilityKind.FileExec(
            path_prefix: SIMPLEOS_SERVER_EXECUTABLE_V1))).to_be(true)
        expect(_server_recipe_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_STATIC_FILE_V1))).to_be(true)
        expect(_server_recipe_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_KEY_V1))).to_be(true)
        expect(_server_recipe_has_v1(CapabilityKind.NetListen(
            port: SIMPLEOS_SERVER_HTTP_PORT_V1))).to_be(true)
        expect(_server_recipe_has_v1(CapabilityKind.NetListen(
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1))).to_be(true)
        expect(_server_recipe_has_v1(CapabilityKind.ProcessSpawn)).to_be(false)
