use std.spec.{describe, it, expect}
use os.kernel.loader.fs_exec_launch_caps_v1.{fs_exec_launch_caps_with_launch_v1}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_EXECUTABLE_V1, SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1
}
use os.kernel.types.capability_types.{CapabilityKind}

describe("WEB scalar recipe reaches every filesystem-exec architecture route"):
    it("keeps x86_64 ARM64 and RV64 behind the shared privileged-pouch owner"):
        val x86 = file_read("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        val arm64 = file_read("src/os/kernel/loader/arm64_fs_exec_spawn.spl")
        val rv64 = file_read("src/os/kernel/loader/riscv64_fs_exec_spawn.spl")
        val common = file_read("src/os/kernel/loader/fs_exec_spawn.spl")
        expect(x86).to_contain("fs_exec_adopt_authenticated_with_launch_v1(")
        expect(arm64).to_contain("fs_exec_adopt_authenticated_with_launch_v1(")
        expect(rv64).to_contain("fs_exec_adopt_authenticated_with_launch_v1(")
        expect(common).to_contain("SPAWN_RECIPE_WEB")
        expect(common).to_contain("fs_exec_launch_caps_with_launch_v1(")

    it("mints WEB's exact configured address and 8080, without database grants"):
        val caps = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1], [], 0u64)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1,
            port: 8080u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: 0u32, port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.CRT"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.PK8"))).to_equal(false)

    it("documents portable bind as exact address plus exact listener authority"):
        val portable = file_read("src/os/kernel/ipc/syscall_net_portable_v1.spl")
        expect(portable).to_contain("CapabilityKind.NetBindIpv4(")
        expect(portable).to_contain("address: addr.addr, port: addr.port")
        expect(portable).to_contain("CapabilityKind.NetListen(port: addr.port)")
