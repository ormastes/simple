use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestResourceLimits, ManifestTarget, SimpleArtifactManifest
}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes
}
use std.common.structural.execution.simple_artifact_receipt_v2_codec.{
    SimpleArtifactReceiptSubjectV2,
    simple_artifact_receipt_scr2_decode_v2,
    simple_artifact_receipt_scr2_encode_v2
}
use os.installer.signed_artifact_receipt_producer_v2.{
    SignedArtifactReceiptProducedV2, signed_artifact_receipt_produce_v2
}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SimpleboxSignedCatalogExternalCandidateV1,
    simplebox_signed_catalog_record_encode_v1
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1
}
use os.kernel.loader.signed_artifact_receipt_verifier_v2.{
    SignedArtifactReceiptGuestExpectationV2,
    SignedArtifactReceiptTrustPolicyV2,
    signed_artifact_receipt_decode_controlled_v2,
    signed_artifact_receipt_guest_check_v2
}

fn receipt_target_v2() -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")

fn receipt_subject_v2() -> SimpleArtifactReceiptSubjectV2:
    SimpleArtifactReceiptSubjectV2(
        artifact_sha256: sha256_u8_hex([1u8, 2u8, 3u8]),
        artifact_byte_count: 3, role: "simple-compiler",
        authority_identity: "simpleos-release-2026",
        signature_algorithm: "", signer_key_id: "",
        signer_public_key_sha256: "",
        target: receipt_target_v2(), canonical_path: "/usr/bin/simple",
        aliases: ["/bin/simple", "/sys/apps/simple.smf"],
        entrypoint: "/usr/bin/simple")

fn receipt_produced_v2() -> SignedArtifactReceiptProducedV2:
    signed_artifact_receipt_produce_v2(
        receipt_subject_v2(), "release-key", [7u8] * 32).unwrap()

fn receipt_expectation_v2(
    subject: SimpleArtifactReceiptSubjectV2,
) -> SignedArtifactReceiptGuestExpectationV2:
    SignedArtifactReceiptGuestExpectationV2(
        artifact_sha256: subject.artifact_sha256,
        artifact_byte_count: subject.artifact_byte_count,
        role: subject.role, authority_identity: subject.authority_identity,
        target: subject.target, canonical_path: subject.canonical_path,
        aliases: subject.aliases, entrypoint: subject.entrypoint)

fn receipt_signed_subject_v2() -> SimpleArtifactReceiptSubjectV2:
    simple_artifact_receipt_scr2_decode_v2(
        receipt_produced_v2().bytes).unwrap().subject

fn receipt_check_v2(bytes: [u8], expected: SimpleArtifactReceiptSubjectV2) -> bool:
    val produced = receipt_produced_v2()
    signed_artifact_receipt_guest_check_v2(
        bytes,
        [SignedArtifactReceiptTrustPolicyV2(
            signer: ExecutableManifestTrustedSignerV1(
                key_id: "release-key", public_key: produced.public_key),
            allowed_authority_identities: ["simpleos-release-2026"],
            allowed_roles: ["simple-compiler"],
            allowed_targets: [receipt_target_v2()])],
        receipt_expectation_v2(expected)).ok

fn receipt_without_resigning_v2(
    changed: SimpleArtifactReceiptSubjectV2,
) -> [u8]:
    val original = simple_artifact_receipt_scr2_decode_v2(
        receipt_produced_v2().bytes).unwrap()
    simple_artifact_receipt_scr2_encode_v2(
        changed, original.detached_signature,
        original.expected_trust_root_sha256).unwrap()

fn canonical_legacy_scr1_v2() -> [u8]:
    val digest = sha256_u8_hex([4u8, 5u8, 6u8])
    val signature = "ed25519:legacy-key:" + "31" * 64
    val manifest = SimpleArtifactManifest(
        format_version: 1, artifact_kind: "native-executable",
        target: receipt_target_v2(), entrypoint: "/usr/bin/legacy",
        required_abi_features: [], required_services: [],
        required_capabilities: 0u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1024, max_open_handles: 4,
            max_threads: 1, cpu_budget_us: 0),
        namespace_template: "legacy", native_libraries: [], smf_libraries: [],
        interpreter: "", argument_schema: [], startup_preloads: [],
        content_hashes: [digest], signature: signature, debug_identity: "")
    val sam1 = encode_simple_artifact_manifest_v1_signing_bytes(manifest, digest)
    simplebox_signed_catalog_record_encode_v1(
        SimpleboxSignedCatalogExternalCandidateV1(
            sam1_identity_sha256: sha256_u8_hex(sam1.bytes),
            record: InstalledArtifactBootRecordV1(
                canonical_path: "/usr/bin/legacy", aliases: [],
                content_sha256: digest, detached_signature: signature,
                expected_trust_root_sha256: "42" * 32,
                manifest: manifest))).unwrap()

describe "canonical SAM2/SCR2 signed artifact receipt":
    it "authenticates every guest-launch binding without granting authority":
        val produced = receipt_produced_v2()
        expect(receipt_check_v2(
            produced.bytes, receipt_signed_subject_v2())).to_be(true)
        expect(signed_artifact_receipt_decode_controlled_v2(
            produced.bytes, false).?).to_be(true)

    it "rejects an artifact byte-count change under the retained signature":
        var changed = receipt_signed_subject_v2()
        changed.artifact_byte_count = 4
        expect(receipt_check_v2(
            receipt_without_resigning_v2(changed), changed)).to_be(false)

    it "rejects a role change under the retained signature":
        var changed = receipt_signed_subject_v2()
        changed.role = "simple-loader"
        expect(receipt_check_v2(
            receipt_without_resigning_v2(changed), changed)).to_be(false)

    it "rejects an authority identity change under the retained signature":
        var changed = receipt_signed_subject_v2()
        changed.authority_identity = "untrusted-builder"
        expect(receipt_check_v2(
            receipt_without_resigning_v2(changed), changed)).to_be(false)

    it "rejects a target triple change under the retained signature":
        var changed = receipt_signed_subject_v2()
        changed.target = ManifestTarget(
            os: "simpleos", arch: "x86_64", abi: "simpleos")
        expect(receipt_check_v2(
            receipt_without_resigning_v2(changed), changed)).to_be(false)

    it "rejects an artifact digest change under the retained signature":
        var changed = receipt_signed_subject_v2()
        changed.artifact_sha256 = sha256_u8_hex([9u8, 8u8, 7u8])
        expect(receipt_check_v2(
            receipt_without_resigning_v2(changed), changed)).to_be(false)

    it "rejects path, alias order, and entrypoint changes under the signature":
        var path_changed = receipt_signed_subject_v2()
        path_changed.canonical_path = "/usr/bin/simple-other"
        expect(receipt_check_v2(
            receipt_without_resigning_v2(path_changed), path_changed)).to_be(false)
        var aliases_changed = receipt_signed_subject_v2()
        aliases_changed.aliases = ["/sys/apps/simple.smf", "/bin/simple"]
        expect(receipt_check_v2(
            receipt_without_resigning_v2(aliases_changed), aliases_changed)).to_be(false)
        var entrypoint_changed = receipt_signed_subject_v2()
        entrypoint_changed.entrypoint = "/bin/simple"
        expect(receipt_check_v2(
            receipt_without_resigning_v2(entrypoint_changed),
            entrypoint_changed)).to_be(false)

    it "allows canonical SCR1 only for inventory and never for guest launch":
        val legacy = canonical_legacy_scr1_v2()
        expect(signed_artifact_receipt_decode_controlled_v2(
            legacy, true).?).to_be(true)
        expect(receipt_check_v2(legacy, receipt_signed_subject_v2())).to_be(false)

    it "rejects a valid signature when signer policy denies its authority":
        var unauthorized = receipt_subject_v2()
        unauthorized.authority_identity = "other-release-authority"
        val produced = signed_artifact_receipt_produce_v2(
            unauthorized, "release-key", [7u8] * 32).unwrap()
        val signed = simple_artifact_receipt_scr2_decode_v2(
            produced.bytes).unwrap().subject
        expect(receipt_check_v2(produced.bytes, signed)).to_be(false)

    it "rejects valid signatures when signer policy denies role or target":
        var wrong_role = receipt_subject_v2()
        wrong_role.role = "simple-loader"
        val role_receipt = signed_artifact_receipt_produce_v2(
            wrong_role, "release-key", [7u8] * 32).unwrap()
        val signed_role = simple_artifact_receipt_scr2_decode_v2(
            role_receipt.bytes).unwrap().subject
        expect(receipt_check_v2(role_receipt.bytes, signed_role)).to_be(false)
        var wrong_target = receipt_subject_v2()
        wrong_target.target = ManifestTarget(
            os: "simpleos", arch: "x86_64", abi: "simpleos")
        val target_receipt = signed_artifact_receipt_produce_v2(
            wrong_target, "release-key", [7u8] * 32).unwrap()
        val signed_target = simple_artifact_receipt_scr2_decode_v2(
            target_receipt.bytes).unwrap().subject
        expect(receipt_check_v2(
            target_receipt.bytes, signed_target)).to_be(false)

    it "binds key identity and trust-root digest":
        val produced = receipt_produced_v2()
        val decoded = simple_artifact_receipt_scr2_decode_v2(
            produced.bytes).unwrap()
        val parts = decoded.detached_signature.split(":")
        val relabeled = simple_artifact_receipt_scr2_encode_v2(
            decoded.subject, "ed25519:other-key:" + parts[2],
            decoded.expected_trust_root_sha256).unwrap()
        expect(receipt_check_v2(relabeled, decoded.subject)).to_be(false)
        val wrong_root = simple_artifact_receipt_scr2_encode_v2(
            decoded.subject, decoded.detached_signature, "55" * 32).unwrap()
        expect(receipt_check_v2(wrong_root, decoded.subject)).to_be(false)
        var key_changed = decoded.subject
        key_changed.signer_key_id = "other-key"
        expect(receipt_check_v2(
            receipt_without_resigning_v2(key_changed), key_changed)).to_be(false)
        var public_key_changed = decoded.subject
        public_key_changed.signer_public_key_sha256 = "66" * 32
        expect(receipt_check_v2(
            receipt_without_resigning_v2(public_key_changed),
            public_key_changed)).to_be(false)
        var algorithm_changed = decoded.subject
        algorithm_changed.signature_algorithm = "ed448"
        expect(simple_artifact_receipt_scr2_encode_v2(
            algorithm_changed, decoded.detached_signature,
            decoded.expected_trust_root_sha256).?).to_be(false)

    it "rejects backslash ambiguity in every executable path field":
        var canonical_changed = receipt_signed_subject_v2()
        canonical_changed.canonical_path = "/usr\\bin/simple"
        expect(simple_artifact_receipt_scr2_encode_v2(
            canonical_changed, "ed25519:key:" + "00" * 64,
            "11" * 32).?).to_be(false)
        var alias_changed = receipt_signed_subject_v2()
        alias_changed.aliases = ["/bin\\simple"]
        expect(simple_artifact_receipt_scr2_encode_v2(
            alias_changed, "ed25519:key:" + "00" * 64,
            "11" * 32).?).to_be(false)
        var entrypoint_changed = receipt_signed_subject_v2()
        entrypoint_changed.entrypoint = "/usr\\bin/simple"
        expect(simple_artifact_receipt_scr2_encode_v2(
            entrypoint_changed, "ed25519:key:" + "00" * 64,
            "11" * 32).?).to_be(false)

    it "rejects trailing bytes and never treats malformed SCR1 as SCR2":
        var trailing = receipt_produced_v2().bytes
        trailing.push(0u8)
        expect(simple_artifact_receipt_scr2_decode_v2(trailing).?).to_be(false)
        expect(signed_artifact_receipt_decode_controlled_v2(
            [83u8, 67u8, 82u8, 49u8, 1u8, 0u8, 0u8, 0u8], true).?).to_be(false)
