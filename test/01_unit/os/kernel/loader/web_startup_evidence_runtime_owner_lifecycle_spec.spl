use std.spec.{describe, it, expect}

describe("WEB startup evidence runtime-owner lifecycle"):
    it("gates the common ABI 132 owner before scheduler registry mutation"):
        val handler = file_read("src/os/kernel/ipc/syscall_web_startup_evidence.spl")
        val owner = file_read("src/os/kernel/ipc/web_startup_runtime_owner_v1.spl")
        val shim = file_read("src/os/kernel/abi/syscall_shim.spl")
        expect(handler).to_contain("web_startup_runtime_owner_available_v1")
        expect(handler).to_contain("SyscallResult(value: -38)")
        expect(owner).to_contain("web_startup_runtime_owner_enable_v1")
        expect(owner).to_contain("web_startup_runtime_owner_disable_v1")
        expect(shim).to_contain("shim_web_startup_runtime_owner_enable_v1")
        expect(shim).to_contain("web_startup_runtime_owner_disable_v1()")

    it("opens ABI 132 only for an authenticated WEB child, then closes it"):
        val x86 = file_read("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        val arm64 = file_read("src/os/kernel/loader/arm64_fs_exec_spawn.spl")
        val rv64 = file_read("src/os/kernel/loader/riscv64_fs_exec_spawn.spl")
        for source in [x86, arm64, rv64]:
            expect(source).to_contain("recipe == SPAWN_RECIPE_WEB")
            expect(source).to_contain("shim_web_startup_runtime_owner_enable_v1()")
            expect(source).to_contain("shim_web_startup_runtime_owner_disable_v1()")
            expect(source).to_contain("dispatch_fs_exec_user_handoff")

    it("keeps ABI 116 and WEB ABI 132 as separate consumption paths"):
        val server = file_read("src/os/kernel/ipc/syscall_server_startup_evidence.spl")
        val web = file_read("src/os/kernel/ipc/syscall_web_startup_evidence.spl")
        expect(server).to_contain("consume_current_server_startup_evidence_v1")
        expect(web).to_contain("consume_current_web_startup_evidence_v1")
