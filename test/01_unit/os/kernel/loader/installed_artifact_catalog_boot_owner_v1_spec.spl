use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootPolicyV1, InstalledArtifactBootRecordV1,
    installed_artifact_boot_policy_shape_valid_v1
}

fn boot_manifest(path: text, arch: text) -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1, artifact_kind: "elf",
        target: ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos"),
        entrypoint: path, required_abi_features: [], required_services: [],
        required_capabilities: 0u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 8,
            max_threads: 1, cpu_budget_us: 1000000),
        namespace_template: "boot", native_libraries: [], smf_libraries: [],
        interpreter: "", argument_schema: [], startup_preloads: [],
        content_hashes: ["1" * 64],
        signature: "ed25519:boot-key:" + "2" * 128,
        debug_identity: "")

fn boot_policy(paths: [text], arch: text) -> InstalledArtifactBootPolicyV1:
    InstalledArtifactBootPolicyV1(
        platform_target: ManifestTarget(
            os: "simpleos", arch: arch, abi: "simpleos"),
        required_canonical_paths: paths,
        trust_roots: [ExecutableManifestTrustedSignerV1(
            key_id: "boot-key", public_key: [0u8] * 32)])

fn boot_record(path: text, arch: text) -> InstalledArtifactBootRecordV1:
    val manifest = boot_manifest(path, arch)
    InstalledArtifactBootRecordV1(
        canonical_path: path, aliases: [], content_sha256: "1" * 64,
        detached_signature: manifest.signature,
        expected_trust_root_sha256: "3" * 64, manifest: manifest)

describe "installed artifact boot policy shape":
    it "requires the exact complete target bundle":
        val policy = boot_policy(["/SERVERS.ELF", "/usr/bin/simple"], "aarch64")
        expect(installed_artifact_boot_policy_shape_valid_v1(policy, [
            boot_record("/SERVERS.ELF", "aarch64"),
            boot_record("/usr/bin/simple", "aarch64")
        ])).to_be(true)
        expect(installed_artifact_boot_policy_shape_valid_v1(
            policy, [boot_record("/SERVERS.ELF", "aarch64")])).to_be(false)

    it "accepts one bounded nonempty alias set":
        val policy = boot_policy(["/bin/simplebox"], "arm")
        var record = boot_record("/bin/simplebox", "arm")
        record.aliases = ["/bin/echo", "/bin/cat"]
        expect(installed_artifact_boot_policy_shape_valid_v1(
            policy, [record])).to_be(true)

    it "rejects cross-target records and canonical alias collisions":
        val policy = boot_policy(["/SERVERS.ELF"], "riscv64")
        expect(installed_artifact_boot_policy_shape_valid_v1(
            policy, [boot_record("/SERVERS.ELF", "x86_64")])).to_be(false)
        var record = boot_record("/SERVERS.ELF", "riscv64")
        record.aliases = ["/SERVERS.ELF"]
        expect(installed_artifact_boot_policy_shape_valid_v1(
            policy, [record])).to_be(false)

    it "rejects aliases shared across records before catalog mutation":
        val policy = boot_policy(["/bin/a", "/bin/b"], "x86_64")
        var first = boot_record("/bin/a", "x86_64")
        var second = boot_record("/bin/b", "x86_64")
        first.aliases = ["/bin/shared"]
        second.aliases = ["/bin/shared"]
        expect(installed_artifact_boot_policy_shape_valid_v1(
            policy, [first, second])).to_be(false)

    it "rejects a shape-valid bundle over the global alias text budget":
        var paths: [text] = []
        var records: [InstalledArtifactBootRecordV1] = []
        var record_index: i64 = 0
        while record_index < 9:
            val path = "/bin/tool{record_index}"
            paths.push(path)
            var record = boot_record(path, "x86_64")
            var alias_index: i64 = 0
            while alias_index < 15:
                record.aliases.push(
                    "/alias/{record_index}/{alias_index}/" + "x" * 3970)
                alias_index = alias_index + 1
            records.push(record)
            record_index = record_index + 1
        expect(installed_artifact_boot_policy_shape_valid_v1(
            boot_policy(paths, "x86_64"), records)).to_be(false)

    it "rejects unsupported targets and duplicate required paths":
        expect(installed_artifact_boot_policy_shape_valid_v1(
            boot_policy(["/bin/tool"], "mips64"),
            [boot_record("/bin/tool", "mips64")])).to_be(false)
        expect(installed_artifact_boot_policy_shape_valid_v1(
            boot_policy(["/bin/tool", "/bin/tool"], "x86"),
            [boot_record("/bin/tool", "x86"),
             boot_record("/bin/other", "x86")])).to_be(false)
