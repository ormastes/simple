"""Focused policy and exact-layout contracts for Clang catalog media boot."""

use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{pure_ed25519_keypair_from_seed}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.crypto.types.{bytes_to_hex}
use std.fs_driver.mount_table.{MountTable}
use os.kernel.loader.clang_catalog_media_boot_v1.*

fn _seed_v1() -> [u8]: [7u8; 32]

fn _hex_v1(bytes: [u8]) -> text:
    var values: [i64] = []
    for byte in bytes: values.push(byte as i64)
    bytes_to_hex(values)

fn _policy_v1() -> ClangCatalogMediaBootPolicyV1:
    val key = pure_ed25519_keypair_from_seed(_seed_v1()).1
    ClangCatalogMediaBootPolicyV1(
        target: ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos"),
        pinned_key_id: "clang-release-root",
        pinned_public_key_hex: _hex_v1(key),
        pinned_public_key_sha256: sha256_u8_hex(key))

describe "Clang signed catalog media boot v1":
    it "uses the exact ordered target and SCR1 path groups":
        expect(clang_catalog_media_payload_paths_v1().len()).to_equal(9)
        expect(clang_catalog_media_payload_paths_v1()[0]).to_equal("/usr/bin/clang")
        expect(clang_catalog_media_payload_paths_v1()[8]).to_equal("/usr/lib/libm.a")
        expect(clang_catalog_media_scr1_paths_v1().len()).to_equal(9)
        expect(clang_catalog_media_scr1_paths_v1()[0]).to_equal("/boot/catalog/clang.scr1")
        expect(clang_catalog_media_scr1_paths_v1()[8]).to_equal("/boot/catalog/libm.a.scr1")

    it "requires exactly nine path pairs and rejects aggregate overflow":
        expect(clang_catalog_media_payload_paths_v1().len()).to_equal(
            clang_catalog_media_scr1_paths_v1().len())
        expect(clang_catalog_media_aggregate_next_v1(
            536870910, 1, 1).unwrap()).to_equal(536870912)
        expect(clang_catalog_media_aggregate_next_v1(
            536870910, 1, 2).?).to_equal(false)
        expect(clang_catalog_media_aggregate_next_v1(
            0, 0, 1).?).to_equal(false)

    it "rejects an invalid compiled pin before attempting descriptor I/O":
        var table = MountTable.new()
        val good = _policy_v1()
        val bad = ClangCatalogMediaBootPolicyV1(
            target: good.target, pinned_key_id: good.pinned_key_id,
            pinned_public_key_hex: good.pinned_public_key_hex,
            pinned_public_key_sha256: "0" * 64)
        val result = clang_catalog_media_boot_prepare_v1(table, bad)
        expect(result.ok).to_equal(false)
        expect(result.error).to_equal(ClangCatalogMediaBootErrorV1.PolicyRejected)
        expect(result.accepted_records).to_equal(0)
