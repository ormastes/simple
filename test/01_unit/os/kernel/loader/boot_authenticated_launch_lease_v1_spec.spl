use std.spec.{describe, it, expect, step}
use os.kernel.loader.boot_authenticated_launch_lease_v1.{
    BootAuthenticatedLaunchCoordinatesV1,
    boot_authenticated_launch_coordinates_new_v1,
    boot_authenticated_launch_lease_issue_current_v1,
    boot_authenticated_launch_lease_consume_once_v1
}
use os.kernel.loader.boot_service_context_v1.{boot_service_context_publish_v1}
use os.kernel.loader.spawn_recipes.{
    SPAWN_RECIPE_AUTH_MEDIA_SERVER, spawn_recipe_seed_parent_caps
}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.ipc.ipc.{IpcManager}
use os.kernel.types.task_types.{TaskId, UserProcessImage, UserLoadSegment}

fn lease_digest(ch: text) -> text:
    ch * 64

fn valid_coordinates() -> BootAuthenticatedLaunchCoordinatesV1:
    boot_authenticated_launch_coordinates_new_v1(
        "/SERVERS.ELF", lease_digest("a"), lease_digest("b"),
        lease_digest("c"), lease_digest("d"), 1u64, 2u64, 3u64, 4u64,
        SPAWN_RECIPE_AUTH_MEDIA_SERVER).unwrap()

fn replacement_image() -> UserProcessImage:
    UserProcessImage(
        binary_path: "/SERVERS.ELF", entry: 0x500000,
        stack_top: 0x5000000000, stack_size: 65536,
        argv: ["/SERVERS.ELF"], envp: [],
        segments: [UserLoadSegment(
            virt_addr: 0x500000, mem_size: 4, file_size: 4,
            flags: 5, align: 0x1000,
            data: [0x13.to_u8(), 0, 0, 0])],
        segment_count: 1, file_bytes: [0x13.to_u8(), 0, 0, 0],
        initial_sp: 0x4fffffff80,
        initial_stack_bytes: [0x01.to_u8(), 0x02, 0x03, 0x04])

describe "boot authenticated launch coordinates":
    it "requires every signed open binding before lease issue":
        expect(boot_authenticated_launch_coordinates_new_v1(
            "/SERVERS.ELF", lease_digest("a"), lease_digest("b"),
            lease_digest("c"), lease_digest("d"), 1u64, 2u64, 3u64, 4u64,
            SPAWN_RECIPE_AUTH_MEDIA_SERVER).?).to_be(true)
        expect(boot_authenticated_launch_coordinates_new_v1(
            "/SERVERS.ELF", lease_digest("a"), lease_digest("b"),
            lease_digest("c"), lease_digest("d"), 0u64, 2u64, 3u64, 4u64,
            SPAWN_RECIPE_AUTH_MEDIA_SERVER).?).to_be(false)
        expect(boot_authenticated_launch_coordinates_new_v1(
            "", lease_digest("a"), lease_digest("b"), lease_digest("c"),
            lease_digest("d"), 1u64, 2u64, 3u64, 4u64,
            SPAWN_RECIPE_AUTH_MEDIA_SERVER).?).to_be(false)

describe "boot authenticated launch lease":
    it "issues from a finite current boot task and consumes exactly once":
        step("publish a finite boot service pouch into scheduler and IPC owners")
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val task = boot_service_context_publish_v1(
            scheduler, ipc,
            spawn_recipe_seed_parent_caps(SPAWN_RECIPE_AUTH_MEDIA_SERVER, 1u64))
        expect(task.?).to_be(true)
        if task.?:
            step("issue and consume the exact signed-coordinate lease")
            val coordinates = valid_coordinates()
            val lease = boot_authenticated_launch_lease_issue_current_v1(
                scheduler, coordinates)
            expect(lease.?).to_be(true)
            if lease.?:
                val first = boot_authenticated_launch_lease_consume_once_v1(
                    scheduler, lease.unwrap(), coordinates)
                expect(first.?).to_be(true)
                if first.?:
                    expect(first.unwrap().caller).to_equal(task.unwrap().id as i64)
                    expect(first.unwrap().caller_caps.is_pledged).to_be(true)
                    expect(first.unwrap().caller_caps.caps.len()).to_be_greater_than(0)
                    for cap in first.unwrap().caller_caps.caps:
                        expect(cap.owner).to_equal(task.unwrap().id)
                step("reject replay of the consumed lease")
                expect(boot_authenticated_launch_lease_consume_once_v1(
                    scheduler, lease.unwrap(), coordinates).?).to_be(false)

    it "burns a lease when its current task exits before consume":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val task = boot_service_context_publish_v1(
            scheduler, ipc,
            spawn_recipe_seed_parent_caps(SPAWN_RECIPE_AUTH_MEDIA_SERVER, 1u64))
        expect(task.?).to_be(true)
        if task.?:
            val coordinates = valid_coordinates()
            val lease = boot_authenticated_launch_lease_issue_current_v1(
                scheduler, coordinates)
            expect(lease.?).to_be(true)
            if lease.?:
                scheduler.exit_task_by_id(TaskId(id: task.unwrap().id), 0)
                expect(boot_authenticated_launch_lease_consume_once_v1(
                    scheduler, lease.unwrap(), coordinates).?).to_be(false)
                expect(boot_authenticated_launch_lease_consume_once_v1(
                    scheduler, lease.unwrap(), coordinates).?).to_be(false)

    it "burns a lease when the current task reexecs before consume":
        var scheduler = Scheduler.new()
        var ipc = IpcManager.new()
        val task = boot_service_context_publish_v1(
            scheduler, ipc,
            spawn_recipe_seed_parent_caps(SPAWN_RECIPE_AUTH_MEDIA_SERVER, 1u64))
        expect(task.?).to_be(true)
        if task.?:
            val coordinates = valid_coordinates()
            val lease = boot_authenticated_launch_lease_issue_current_v1(
                scheduler, coordinates)
            expect(lease.?).to_be(true)
            if lease.?:
                expect(scheduler.exec_image(
                    TaskId(id: task.unwrap().id), replacement_image())).to_equal(0)
                expect(boot_authenticated_launch_lease_consume_once_v1(
                    scheduler, lease.unwrap(), coordinates).?).to_be(false)
