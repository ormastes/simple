use std.spec.{describe, it, expect}
use os.kernel.loader.dbd_launch_grants_v1.{
    SIMPLEOS_DBD_EXECUTABLE_V1, SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1,
    SIMPLEOS_DBD_LAUNCH_POUCH_BUDGET_V1,
    dbd_launch_grant_plan_v1, dbd_launch_grant_plan_valid_v1
}
use os.kernel.loader.server_launch_grants.{
    SIMPLEOS_SERVER_STATIC_FILE_V1, SIMPLEOS_SERVER_HTTP_PORT_V1,
    SIMPLEOS_SERVER_DB_KEY_V1, SIMPLEOS_SERVER_DB_CERTIFICATE_V1,
    SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1, SIMPLEOS_SERVER_DATABASE_PORT_V1,
    ServerProtectedDataRoleV1, server_protected_data_role_v1,
    server_protected_data_role_allows_dbfs_v1
}
use os.kernel.types.capability_types.{CapabilityKind}
use std.common.contracts.os.server_data_namespace_v1.{
    SERVER_DATA_DATABASE_ROOT_PATH_V1
}

fn _dbd_has_v1(kind: CapabilityKind) -> bool:
    for grant in dbd_launch_grant_plan_v1(SIMPLEOS_DBD_EXECUTABLE_V1).grants:
        if grant.requested == kind: return true
    false

describe("dedicated DBD launch grants"):
    it("grants only DBD executable secrets database subtree and listener"):
        val plan = dbd_launch_grant_plan_v1(SIMPLEOS_DBD_EXECUTABLE_V1)
        expect(dbd_launch_grant_plan_valid_v1(plan)).to_equal(true)
        expect(plan.grants.len()).to_equal(SIMPLEOS_DBD_LAUNCH_POUCH_BUDGET_V1)
        expect(_dbd_has_v1(CapabilityKind.FileExec(
            path_prefix: SIMPLEOS_DBD_EXECUTABLE_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_KEY_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_CERTIFICATE_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_DB_PRIVATE_KEY_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileWrite(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileCreate(
            path_prefix: SERVER_DATA_DATABASE_ROOT_PATH_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: "/srv/data"))).to_equal(false)
        expect(_dbd_has_v1(CapabilityKind.FileWrite(
            path_prefix: "/"))).to_equal(false)
        expect(_dbd_has_v1(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1,
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1))).to_equal(true)
        expect(_dbd_has_v1(CapabilityKind.NetBindIpv4(
            address: 0u32,
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1))).to_equal(false)
        expect(_dbd_has_v1(CapabilityKind.NetListen(
            port: SIMPLEOS_SERVER_DATABASE_PORT_V1))).to_equal(true)

    it("never receives web public-file or HTTP listener authority"):
        expect(_dbd_has_v1(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_SERVER_STATIC_FILE_V1))).to_equal(false)
        expect(_dbd_has_v1(CapabilityKind.NetListen(
            port: SIMPLEOS_SERVER_HTTP_PORT_V1))).to_equal(false)
        expect(_dbd_has_v1(CapabilityKind.NetConnect(port: 0u16))).to_equal(false)

    it("keeps protected startup roles closed to legacy and dedicated DBD"):
        expect(server_protected_data_role_v1("/WEB.ELF")).to_equal(
            ServerProtectedDataRoleV1.None)
        expect(server_protected_data_role_allows_dbfs_v1(
            server_protected_data_role_v1("/WEB.ELF"))).to_equal(false)
        expect(server_protected_data_role_v1(SIMPLEOS_DBD_EXECUTABLE_V1)).to_equal(
            ServerProtectedDataRoleV1.DedicatedDbd)
        expect(dbd_launch_grant_plan_v1("/SERVERS.ELF").grants.len()).to_equal(0)
