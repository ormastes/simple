"""
## Purpose and audience
Regression for the duplicate `_path_bytes_to_text` in executable_source.spl,
which made the riscv64 kernel native-build fail with an ambiguous call
(compiler_cross_module_private_symbol_collision). Importing the module proves
it compiles; the source scan pins one definition.
"""
# @req: REQ-TEST-EXEC_SOURCE_SINGLE_DEF-001
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}
use os.kernel.loader.executable_source.{_set_synthetic_initramfs_for_test, _clear_synthetic_initramfs_for_test, _initramfs_read_file}

describe "executable_source module":
    it "compiles and serves a synthetic initramfs file":
        _set_synthetic_initramfs_for_test("/bin/x", [7u8, 9u8])
        val r = _initramfs_read_file("/bin/x")
        expect(r.is_ok()).to_equal(true)
        expect(r.unwrap().len()).to_equal(2)
        _clear_synthetic_initramfs_for_test()

    it "defines _path_bytes_to_text exactly once":
        val src = file_read_text("src/os/kernel/loader/executable_source.spl")
        expect(src.split("fn _path_bytes_to_text(").len()).to_equal(2)
