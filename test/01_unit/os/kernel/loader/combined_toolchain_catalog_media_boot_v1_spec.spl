"""Focused one-shot ownership contracts for combined toolchain catalog boot."""

use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest}
use std.common.crypto.ed25519.{
    pure_ed25519_keypair_from_seed, pure_ed25519_sign}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes}
use std.crypto.types.{bytes_to_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1}
use os.kernel.loader.installed_artifact_catalog_v1.{
    InstalledArtifactCatalogLifecycleV1, installed_artifact_catalog_status_v1}
use os.kernel.loader.installed_artifact_boot_composition_v1.{
    installed_artifact_boot_composition_validate_v1}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    clang_sysroot_catalog_bundle_v1, clang_sysroot_catalog_required_paths_v1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    primary_linux_tool_catalog_plan_v1,
    primary_linux_tool_catalog_required_paths_v1}
use os.tools.simplebox.simplebox_artifact_contract.{
    SIMPLEBOX_CANONICAL_PATH_V1, simplebox_canonical_aliases_v1}
use os.kernel.loader.combined_toolchain_catalog_media_boot_v1.*

fn _hex_v1(bytes: [u8]) -> text:
    var values: [i64] = []
    for byte in bytes: values.push(byte as i64)
    bytes_to_hex(values)

fn _target_v1() -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")

fn _root_v1() -> ExecutableManifestTrustedSignerV1:
    ExecutableManifestTrustedSignerV1(
        key_id: "combined-catalog-root",
        public_key: pure_ed25519_keypair_from_seed([53u8; 32]).1)

fn _manifest_v1(path: text, digest: text, signature: text) -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1, artifact_kind: "native-executable",
        target: _target_v1(), entrypoint: path,
        required_abi_features: [], required_services: [],
        required_capabilities: 0u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 8,
            max_threads: 1, cpu_budget_us: 0),
        namespace_template: "combined-catalog", native_libraries: [],
        smf_libraries: [], interpreter: "", argument_schema: [],
        startup_preloads: [], content_hashes: [digest], signature: signature,
        debug_identity: path)

fn _record_v1(path: text) -> InstalledArtifactBootRecordV1:
    val digest = sha256_u8_hex(path.bytes())
    val placeholder = "ed25519:combined-catalog-root:" + "0" * 128
    val body = encode_simple_artifact_manifest_v1_signing_bytes(
        _manifest_v1(path, digest, placeholder), digest).bytes
    val public_key = _root_v1().public_key
    val signature = "ed25519:combined-catalog-root:" + _hex_v1(
        pure_ed25519_sign([53u8; 32], public_key, body))
    val aliases = if path == SIMPLEBOX_CANONICAL_PATH_V1:
        simplebox_canonical_aliases_v1()
    else:
        []
    InstalledArtifactBootRecordV1(
        canonical_path: path, aliases: aliases, content_sha256: digest,
        detached_signature: signature,
        expected_trust_root_sha256: sha256_u8_hex(public_key),
        manifest: _manifest_v1(path, digest, signature))

fn _records_v1(paths: [text]) -> [InstalledArtifactBootRecordV1]:
    var records: [InstalledArtifactBootRecordV1] = []
    for path in paths: records.push(_record_v1(path))
    records

fn _prepared_v1() -> CombinedToolchainCatalogMediaBootPreparedV1:
    val clang = clang_sysroot_catalog_bundle_v1(
        _target_v1(), [_root_v1()],
        _records_v1(clang_sysroot_catalog_required_paths_v1()))
    val primary = primary_linux_tool_catalog_plan_v1(
        _target_v1(), [_root_v1()],
        _records_v1(primary_linux_tool_catalog_required_paths_v1()))
    CombinedToolchainCatalogMediaBootPreparedV1(
        mode: CombinedToolchainCatalogMediaModeV1.Combined,
        release_id: "toolchain-release-1",
        clang_release_id: "toolchain-release-1",
        primary_release_id: "toolchain-release-1",
        clang: Some(clang), primary: Some(primary), legacy_simplebox: nil)

describe "Combined toolchain catalog media boot v1":
    it "rejects release identity drift before catalog population":
        step("Mutate one authenticated child release identity")
        var prepared = _prepared_v1()
        prepared.primary_release_id = "other-release"
        expect(combined_toolchain_catalog_media_boot_populate_v1(
            prepared)).to_equal(false)
        expect(installed_artifact_catalog_status_v1().unwrap().lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)

    it "rejects an invalid primary plan without partial population":
        step("Invalidate the primary plan after preparation")
        var prepared = _prepared_v1()
        var primary = prepared.primary.unwrap()
        primary.ok = false
        prepared.primary = Some(primary)
        expect(combined_toolchain_catalog_media_boot_populate_v1(
            prepared)).to_equal(false)
        val status = installed_artifact_catalog_status_v1().unwrap()
        expect(status.lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)
        expect(status.artifact_count).to_equal(0)

    it "gives the primary plan sole ownership of the Simplebox row":
        step("Validate the combined plans with no legacy Simplebox input")
        val prepared = _prepared_v1()
        val clang = prepared.clang.unwrap()
        val primary = prepared.primary.unwrap()
        var simplebox_rows: i64 = 0
        for record in clang.records:
            if record.canonical_path == SIMPLEBOX_CANONICAL_PATH_V1:
                simplebox_rows = simplebox_rows + 1
        for record in primary.records:
            if record.canonical_path == SIMPLEBOX_CANONICAL_PATH_V1:
                simplebox_rows = simplebox_rows + 1
        val validated = installed_artifact_boot_composition_validate_v1(
            nil, Some(clang), Some(primary))
        expect(simplebox_rows).to_equal(1)
        expect(validated.ok).to_equal(true)
        expect(validated.accepted_records).to_equal(14)
        expect(installed_artifact_catalog_status_v1().unwrap().lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)

    it "populates and seals exactly fourteen authenticated records":
        step("Consume the coherent combined release once")
        expect(combined_toolchain_catalog_media_boot_populate_v1(
            _prepared_v1())).to_equal(true)
        val status = installed_artifact_catalog_status_v1().unwrap()
        expect(status.lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Sealed)
        expect(status.artifact_count).to_equal(14)
