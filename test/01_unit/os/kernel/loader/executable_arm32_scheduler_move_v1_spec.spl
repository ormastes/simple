use std.spec.*
use os.kernel.arch.arm32.user_entry_state_v1.{arm32_user_entry_state_v1}

describe "ARM32 scheduler mapping move prerequisites":
    it "accepts aligned 32-bit entry state":
        step("Bind root, entry, SP, token, and exact task lifecycle")
        val state = arm32_user_entry_state_v1(
            0x4000u64, 0x10000u64, 0x80FFFFF8u64,
            41u64, 7u64, 11u64, 13u64)
        expect(state != nil).to_be_true()
        expect(state.unwrap().task_id).to_equal(41u64)
        expect(state.unwrap().lifecycle_generation).to_equal(7u64)

    it "rejects malformed root entry stack and lifecycle":
        step("Fail before TTBR0 or scheduler ownership changes")
        expect(arm32_user_entry_state_v1(
            0x5000u64, 0x10000u64, 0x80FFFFF8u64,
            41u64, 7u64, 11u64, 13u64)).to_be_nil()
        expect(arm32_user_entry_state_v1(
            0x4000u64, 0x10002u64, 0x80FFFFF8u64,
            41u64, 7u64, 11u64, 13u64)).to_be_nil()
        expect(arm32_user_entry_state_v1(
            0x4000u64, 0x10000u64, 0x80FFFFFCu64,
            41u64, 7u64, 11u64, 13u64)).to_be_nil()
        expect(arm32_user_entry_state_v1(
            0x4000u64, 0x10000u64, 0x80FFFFF8u64,
            0u64, 7u64, 11u64, 13u64)).to_be_nil()

    it "keeps global readiness false until lifecycle wiring exists":
        step("Require SVC exit and exact scheduler reap")
        val source = file_read(
            "src/os/kernel/scheduler/scheduler_arm32_mapping_move_v1.spl")
        expect(source).to_contain("globally_ready: false")
        expect(source).to_contain("scheduler_arm32_mapping_reap_v1")
