# RV32 filesystem-exec Sv32 ownership source gate.
#
# This intentionally checks the production routing seam.  The live U-mode
# trap owner is still unavailable, but PT_LOAD construction must never fall
# back to the x86 PML4 implementation while that work is pending.

use std.spec.{describe, it, expect}

extern fn rt_file_read_text(path: text) -> text

val PAGING = "src/os/kernel/arch/riscv32/paging.spl"
val ADAPTER = "src/os/kernel/memory/user_address_space.spl"

describe "RV32 explicit-root Sv32 address-space owner":
    it "maps PT_LOAD pages through the caller-selected root":
        val source = rt_file_read_text(PAGING)
        expect(source).to_contain("fn riscv32_vmm_map_page_in(root_phys: u64")
        expect(source).to_contain("_ensure_table_entry(root_phys, vpn1)")
        expect(source).to_contain("root_phys == 0 or root_phys == 1")

    it "destroys only task-owned user-half tables and leaf frames":
        val source = rt_file_read_text(PAGING)
        expect(source).to_contain("fn riscv32_vmm_destroy_address_space(root_phys: u64)")
        expect(source).to_contain("root_phys == g_vmm.root_phys")
        expect(source).to_contain("while vpn1 < 512")
        expect(source).to_contain("pmm_free_page(PageFrame(pfn: _pte_phys_addr(leaf_entry) / PAGE_SIZE))")

    it "routes the RV32 loader adapter to Sv32 rather than x86 PML4":
        val source = rt_file_read_text(ADAPTER)
        val rv32_start = source.index_of("@cfg(riscv32)\nfn create_user_address_space()") ?? -1
        val x64_start = source.index_of("@cfg(x86_64)") ?? -1
        expect(rv32_start >= 0).to_be(true)
        expect(x64_start > rv32_start).to_be(true)
        val rv32 = source.substring(rv32_start, x64_start)
        expect(rv32).to_contain("os.kernel.arch.riscv32.paging")
        expect(rv32).to_contain("riscv32_vmm_map_page_in")
        expect(rv32).to_contain("riscv32_vmm_destroy_address_space")
        expect(rv32.contains("vmm_map_page_in(space, virt, phys, flags)")).to_be(false)
        expect(rv32.contains("vmm_destroy_user_address_space(space)")).to_be(false)

    it "sabotage oracle detects implicit-root regression":
        val source = rt_file_read_text(ADAPTER)
        val sabotaged = source.replace(
            "riscv32_vmm_map_page_in(space.phys_root, virt, phys, flags)",
            "vmm_map_page_in(space, virt, phys, flags)"
        )
        expect(sabotaged).to_contain("vmm_map_page_in(space, virt, phys, flags)")
        expect(sabotaged.contains("riscv32_vmm_map_page_in(space.phys_root, virt, phys, flags)")).to_be(false)
