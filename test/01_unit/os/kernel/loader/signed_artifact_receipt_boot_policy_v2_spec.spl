use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.ed25519.{pure_ed25519_keypair_from_seed, pure_ed25519_sign}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_receipt_boot_policy_v2_codec.{
    SimpleArtifactReceiptBootPolicySubjectV2,
    simple_artifact_receipt_boot_policy_signing_encode_v2,
    simple_artifact_receipt_boot_policy_envelope_encode_v2,
    simple_artifact_receipt_boot_policy_envelope_decode_v2
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.signed_artifact_receipt_boot_policy_v2.{
    signed_artifact_receipt_boot_policy_authenticate_x86_64_v2,
    signed_artifact_receipt_boot_policy_authenticate_arm64_v2,
    signed_artifact_receipt_boot_policy_authenticate_riscv64_v2}

fn boot_policy_targets_v2() -> [ManifestTarget]:
    [ManifestTarget(os: "simpleos", arch: "x86_64", abi: "simpleos"),
     ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
     ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")]

fn boot_policy_subject_v2() -> SimpleArtifactReceiptBootPolicySubjectV2:
    val delegated = pure_ed25519_keypair_from_seed([19u8] * 32).1
    SimpleArtifactReceiptBootPolicySubjectV2(
        policy_identity: "simpleos-scr2-launch-v2",
        delegated_signer_key_id: "simpleos-release-scr2",
        delegated_public_key: delegated,
        delegated_public_key_sha256: sha256_u8_hex(delegated),
        allowed_authority_identities: [
            "simpleos-release", "simpleos-toolchain-release"],
        allowed_roles: ["simple-interpreter", "simple-compiler", "simple-loader"],
        allowed_targets: boot_policy_targets_v2())

fn boot_policy_envelope_v2() -> ([u8], ExecutableManifestTrustedSignerV1):
    val seed = [23u8] * 32
    val public_key = pure_ed25519_keypair_from_seed(seed).1
    val subject = boot_policy_subject_v2()
    val signing = simple_artifact_receipt_boot_policy_signing_encode_v2(
        subject).unwrap()
    val signature = pure_ed25519_sign(seed, public_key, signing)
    val root = ExecutableManifestTrustedSignerV1(
        key_id: "simpleos-boot-media-root", public_key: public_key)
    (simple_artifact_receipt_boot_policy_envelope_encode_v2(
        subject, root.key_id, signature, sha256_u8_hex(public_key)).unwrap(), root)

describe "SCR2 boot-media trust policy v2":
    it "authenticates an independent boot root before projecting SCR2 trust":
        val fixture = boot_policy_envelope_v2()
        val admitted = signed_artifact_receipt_boot_policy_authenticate_x86_64_v2(
            fixture.0, fixture.1)
        expect(admitted.ok).to_be(true)
        expect(admitted.bound_policy.?).to_be(true)
        expect(admitted.bound_policy.unwrap().trust_policy.allowed_targets.len()).to_equal(1)
        expect(admitted.bound_policy.unwrap().exact_local_target.arch).to_equal("x86_64")

    it "architecture entrypoints derive and expose only their local target":
        val fixture = boot_policy_envelope_v2()
        val x86 = signed_artifact_receipt_boot_policy_authenticate_x86_64_v2(
            fixture.0, fixture.1)
        val arm = signed_artifact_receipt_boot_policy_authenticate_arm64_v2(
            fixture.0, fixture.1)
        val riscv = signed_artifact_receipt_boot_policy_authenticate_riscv64_v2(
            fixture.0, fixture.1)
        expect(x86.bound_policy.unwrap().exact_local_target.arch).to_equal("x86_64")
        expect(arm.bound_policy.unwrap().exact_local_target.arch).to_equal("aarch64")
        expect(riscv.bound_policy.unwrap().exact_local_target.arch).to_equal("riscv64")
        expect(x86.bound_policy.unwrap().trust_policy.allowed_targets[0].arch).to_equal("x86_64")
        expect(arm.bound_policy.unwrap().trust_policy.allowed_targets[0].arch).to_equal("aarch64")
        expect(riscv.bound_policy.unwrap().trust_policy.allowed_targets[0].arch).to_equal("riscv64")
        expect(x86.bound_policy.unwrap().trust_policy.allowed_targets[0].arch ==
            "aarch64").to_be(false)
        expect(arm.bound_policy.unwrap().trust_policy.allowed_targets[0].arch ==
            "riscv64").to_be(false)
        expect(riscv.bound_policy.unwrap().trust_policy.allowed_targets[0].arch ==
            "x86_64").to_be(false)

    it "rejects tampering and a root asserted only by the media":
        val fixture = boot_policy_envelope_v2()
        var tampered = fixture.0
        tampered[16] = tampered[16] ^ 1u8
        expect(signed_artifact_receipt_boot_policy_authenticate_x86_64_v2(
            tampered, fixture.1).ok).to_be(false)
        val attacker_key = pure_ed25519_keypair_from_seed([29u8] * 32).1
        expect(signed_artifact_receipt_boot_policy_authenticate_x86_64_v2(
            fixture.0, ExecutableManifestTrustedSignerV1(
                key_id: fixture.1.key_id, public_key: attacker_key)).ok).to_be(false)

    it "rejects duplicate grants and wildcard overbreadth":
        var duplicate = boot_policy_subject_v2()
        duplicate.allowed_authority_identities = ["simpleos-release", "simpleos-release"]
        expect(simple_artifact_receipt_boot_policy_signing_encode_v2(duplicate).?).to_be(false)
        var wildcard = boot_policy_subject_v2()
        wildcard.allowed_roles = ["*"]
        expect(simple_artifact_receipt_boot_policy_signing_encode_v2(wildcard).?).to_be(false)

    it "requires the exact ordered x86_64 ARM64 and RISC-V 64 target set":
        var missing = boot_policy_subject_v2()
        missing.allowed_targets = [boot_policy_targets_v2()[0]]
        expect(simple_artifact_receipt_boot_policy_signing_encode_v2(missing).?).to_be(false)
        var duplicated_target = boot_policy_subject_v2()
        duplicated_target.allowed_targets = [
            boot_policy_targets_v2()[0], boot_policy_targets_v2()[0],
            boot_policy_targets_v2()[2]]
        expect(simple_artifact_receipt_boot_policy_signing_encode_v2(
            duplicated_target).?).to_be(false)
        var overbroad = boot_policy_subject_v2()
        overbroad.allowed_targets = boot_policy_targets_v2()
        overbroad.allowed_targets.push(ManifestTarget(
            os: "linux", arch: "x86_64", abi: "gnu"))
        expect(simple_artifact_receipt_boot_policy_signing_encode_v2(overbroad).?).to_be(false)

    it "rejects trailing and noncanonical envelope bytes":
        val fixture = boot_policy_envelope_v2()
        var trailing = fixture.0
        trailing.push(0u8)
        expect(simple_artifact_receipt_boot_policy_envelope_decode_v2(trailing).?).to_be(false)
