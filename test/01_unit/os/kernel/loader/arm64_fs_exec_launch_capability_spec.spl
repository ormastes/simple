# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use os.kernel.loader.arm64_fs_exec_spawn.{arm64_fs_exec_launch_caps_with_launch_v1}
use os.kernel.ipc.capability.{CapabilityManager}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilityKind}


describe "ARM64 filesystem payload launch capabilities":
    # @manual scenario evidence
    it "allows only the prepared network and file operations":
        # @req REQ-SSPEC-OS
        step("allows only the prepared network and file operations")
        var mgr = CapabilityManager.new()
        val task = TaskId(id: 41u64)
        val caps = arm64_fs_exec_launch_caps_with_launch_v1(
            "/usr/bin/simple", ["/usr/bin/simple", "/hello.spl", "--check"], [], task.id)
        mgr.init_task(task, caps)

        expect(mgr.check(task, CapabilityKind.NetConnect(port: 0))).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetListen(port: 0))).to_equal(false)
        expect(mgr.check_file_access(task, "/usr/bin/simple", "rx")).to_equal(true)
        expect(mgr.check_file_access(task, "/hello.spl", "r")).to_equal(true)

    it "denies undeclared paths, writes, raw network, and process spawning":
        # @req REQ-SSPEC-OS
        step("denies undeclared paths, writes, raw network, and process spawning")
        var mgr = CapabilityManager.new()
        val task = TaskId(id: 42u64)
        val caps = arm64_fs_exec_launch_caps_with_launch_v1(
            "/usr/bin/simple", ["/usr/bin/simple", "/hello.spl", "--check"], [], task.id)
        mgr.init_task(task, caps)

        expect(mgr.check_file_access(task, "/etc/passwd", "r")).to_equal(false)
        expect(mgr.check_file_access(task, "/hello.spl.bak", "r")).to_equal(false)
        expect(mgr.check_file_access(task, "/hello.spl", "w")).to_equal(false)
        expect(mgr.check(task, CapabilityKind.NetRaw)).to_equal(false)
        expect(mgr.check(task, CapabilityKind.ProcessSpawn)).to_equal(false)

    it "keeps the launch pouch pledged and non-ambient":
        # @req REQ-SSPEC-OS
        step("keeps the launch pouch pledged and non-ambient")
        val caps = arm64_fs_exec_launch_caps_with_launch_v1(
            "/FSEXEC.ELF", ["/FSEXEC.ELF"], [], 43u64)
        expect(caps.is_pledged).to_equal(true)
        expect(caps.caps.len()).to_equal(4)

    it "grants the server exact listener endpoints and protected inputs":
        var mgr = CapabilityManager.new()
        val task = TaskId(id: 44u64)
        mgr.init_task(task, arm64_fs_exec_launch_caps_with_launch_v1(
            "/SERVERS.ELF", ["/SERVERS.ELF"], [], task.id))

        expect(mgr.check_file_access(task, "/SYS/SERVER.HTM", "r")).to_equal(true)
        expect(mgr.check_file_access(task, "/SYS/SRVDB.KEY", "r")).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetBindIpv4(
            address: 0u32, port: 8080u16))).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetListen(port: 8080u16))).to_equal(true)
        expect(mgr.check(task, CapabilityKind.NetListen(port: 0u16))).to_equal(false)
        expect(mgr.check_file_access(task, "/SERVER.SDN", "rwc")).to_equal(false)
        expect(mgr.check_file_access(task, "/SYS/OTHER.HTM", "r")).to_equal(false)
        expect(mgr.check_file_access(task, "/SERVER.SDN.backup", "r")).to_equal(false)
        expect(mgr.check_file_access(task, "/", "rwc")).to_equal(false)

    it "does not mint server authority for an altered launch environment":
        var mgr = CapabilityManager.new()
        val task = TaskId(id: 45u64)
        mgr.init_task(task, arm64_fs_exec_launch_caps_with_launch_v1(
            "/SERVERS.ELF", ["/SERVERS.ELF"], ["PATH=/bin"], task.id))
        expect(mgr.check(task, CapabilityKind.NetListen(port: 8080u16))).to_equal(false)
        expect(mgr.check(task, CapabilityKind.NetBindIpv4(
            address: 0u32, port: 8080u16))).to_equal(false)
        expect(mgr.check_file_access(task, "/SYS/SRVDB.KEY", "r")).to_equal(false)
