use std.test.*
use std.fs.{file_read}

describe "authenticated filesystem remote submission static contract":
    it "admits the retained resolver binding without reopening it":
        val source = file_read(
            "src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(source).to_contain(
            "authenticated_fs_exec_prepare_installed_open_binding_v1(")
        expect(source).to_contain("val binding = resolved.binding")
        expect(source).to_contain(
            "binding.canonical_source_path != canonical_path")
        expect(source).to_contain(
            "table.validate_execute_open_binding_trust(binding, required_trust)")
        expect(source).to_contain(
            "executable_online_reattest_open_binding_v1(")

    it "resolves remote commands under fixed untrusted loader policy":
        val source = file_read(
            "src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(source).to_contain("authenticated_fs_exec_remote_submit_v1(")
        expect(source).to_contain(
            "command, [\"/bin\"], ExecuteTrust.Untrusted")
        expect(source).to_contain(
            "var launch_argv: [text] = [resolved.canonical_path]")
        expect(source).to_contain(
            "lease.table, authorities, caller, resolved, recipe)")
        expect(source).to_contain("ExecuteTrust.Untrusted)")
        expect(source).to_contain("val authorities = authority_result.unwrap()")
        expect(source).to_contain("val recipe = SPAWN_RECIPE_SSH_REMOTE_COMMAND")
        expect(source).to_contain(
            "val resolve_errno = -(errno_of(resolved_result.unwrap_err()) as i64)")

    it "pins caller capability and keeps one canonical VFS lease through submit":
        val source = file_read(
            "src/os/kernel/loader/authenticated_fs_exec_submission_service_v1.spl")
        expect(source).to_contain(
            "scheduler_capability_snapshot_consume_once_v1(")
        expect(source).to_contain(
            "scheduler_pinned_capability_snapshot_caps_v1(")
        expect(source).to_contain(
            "exec_cap_check_caps(caller_caps, resolved.canonical_path)")
        expect(source).to_contain(
            "scheduler, lease.table, submission, caller_caps,")
        expect(source).to_contain(
            "vfs_state_mount_table_lease_restore_v1(lease)")
        expect(source).not_to_contain("stdout: text")

    it "uses a direct-execution recipe without ProcessSpawn authority":
        val recipes = file_read("src/os/kernel/loader/spawn_recipes.spl")
        expect(recipes).to_contain(
            "if recipe == SPAWN_RECIPE_SSH_REMOTE_COMMAND:")
        expect(recipes).to_contain("label: \"ssh-remote.exec\"")
        expect(recipes).to_contain("label: \"ssh-remote.image.read\"")
        val after_remote_label = recipes.split("label: \"ssh-remote.exec\"")
        expect(after_remote_label.len()).to_be_greater_than(1)
        val remote_branch = after_remote_label[1].split("return grants")[0]
        expect(remote_branch).not_to_contain("ProcessSpawn")
        expect(recipes).to_contain(
            "# Direct architecture adoption needs no ambient process-creation grant.\n" +
            "        return grants\n" +
            "    val exec_prefix = spawn_recipe_exec_prefix(recipe)")
