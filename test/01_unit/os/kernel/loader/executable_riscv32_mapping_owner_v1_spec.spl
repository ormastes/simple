use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.contracts.execution.simpleos_executable_admission_v1.{
    ExecutableImageHandleV1, ExecutableLoadRangeV1
}
use os.kernel.loader.executable_riscv32_mapping_owner_v1.{
    executable_riscv32_process_image_ready_v1,
    executable_riscv32_initial_stack_word_size_v1,
    executable_riscv32_authenticated_mapping_evidence_v1
}

fn _rv32_handle(arch: text, address: u64, writable: bool) -> ExecutableImageHandleV1:
    ExecutableImageHandleV1(
        schema_version: 1, open_handle_id: 31u64, mount_id: 2u64,
        filesystem_name: "fat32", canonical_source_path: "/bin/hello-rv32",
        mount_generation: 3u64, file_id: 9u64, file_generation: 4u64,
        size_bytes: 4096u64, role: "main-image",
        target: ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos"),
        verified_load_ranges: [ExecutableLoadRangeV1(
            file_offset: 0u64, file_size: 64u64,
            virtual_address: address, memory_size: 4096u64,
            writable: writable, executable: true)],
        image_hash: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        admission_id: "rv32-admission-1", trust_epoch: 1u64,
        read_count: 0u64, read_bytes: 0u64, consumed: false)

describe "authenticated RV32 mapping readiness owner":
    it "publishes the stack ABI and complete process-image readiness":
        step("Inspect immutable RV32 process-image capability")
        expect(executable_riscv32_process_image_ready_v1()).to_be_true()
        expect(executable_riscv32_initial_stack_word_size_v1()).to_equal(4u64)

    it "accepts exact bounded authenticated RV32 executable evidence":
        step("Bind the canonical target, entry, and executable load range")
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0x10000u64, false), 0x10000u64)).to_be_true()

    it "rejects target substitution write-execute and RV32 overflow":
        step("Fail before page mapping or scheduler publication")
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv64", 0x10000u64, false), 0x10000u64)).to_be_false()
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0x10000u64, true), 0x10000u64)).to_be_false()
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0xC0000000u64, false),
            0xC0000000u64)).to_be_false()

    it "admits the final user page and rejects the copied kernel half":
        step("Check exact inclusive/exclusive RV32 address boundaries")
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0x7FFFF000u64, false),
            0x7FFFF000u64)).to_be_true()
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0x80000000u64, false),
            0x80000000u64)).to_be_false()
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            _rv32_handle("riscv32", 0u64, false), 0u64)).to_be_false()

    it "rejects page-incongruent and shared-page authenticated ranges":
        step("Preserve page mapper isolation before authority can be enabled")
        var incongruent = _rv32_handle("riscv32", 0x10001u64, false)
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            incongruent, 0x10001u64)).to_be_false()
        var shared = _rv32_handle("riscv32", 0x10000u64, false)
        shared.verified_load_ranges[0].memory_size = 64u64
        shared.verified_load_ranges.push(ExecutableLoadRangeV1(
            file_offset: 256u64, file_size: 32u64,
            virtual_address: 0x10100u64, memory_size: 64u64,
            writable: false, executable: false))
        expect(executable_riscv32_authenticated_mapping_evidence_v1(
            shared, 0x10000u64)).to_be_false()
