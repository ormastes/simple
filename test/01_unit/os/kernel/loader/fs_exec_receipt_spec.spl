use std.spec
use os.kernel.loader.fs_exec_receipt.{
    fs_exec_receipt_failed, fs_exec_receipt_exited,
    fs_exec_receipt_exited_registered
}

describe "filesystem execution receipt":
    describe "REQ-001: preserve process identity and exit status":
        it "records completed execution without inventing scheduler ownership":
            val receipt = fs_exec_receipt_exited("/SYS/APPS/WEBSRV.SMF", 41, 0)
            expect(receipt.path).to_equal("/SYS/APPS/WEBSRV.SMF")
            expect(receipt.pid).to_equal(41)
            expect(receipt.exit_code).to_equal(0)
            expect(receipt.started).to_be(true)
            expect(receipt.exited).to_be(true)
            expect(receipt.process_registered).to_be(false)

        it "marks process identity only through the registered constructor":
            val receipt = fs_exec_receipt_exited_registered(
                "/SYS/APPS/WEBSRV.SMF", 41, 0)
            expect(receipt.process_registered).to_be(true)
            expect(receipt.pid).to_equal(41)

        it "keeps a launch failure distinct from an exited process":
            val receipt = fs_exec_receipt_failed("/SYS/APPS/DBSRV.SMF", -2)
            expect(receipt.pid).to_equal(-2)
            expect(receipt.exit_code).to_equal(-2)
            expect(receipt.started).to_be(false)
            expect(receipt.exited).to_be(false)
            expect(receipt.process_registered).to_be(false)

        it "does not require a fabricated PID for a synchronous handoff":
            val receipt = fs_exec_receipt_exited("/SYS/APPS/STREAM.ELF", 0, 7)
            expect(receipt.pid).to_equal(0)
            expect(receipt.exit_code).to_equal(7)
            expect(receipt.started).to_be(true)
            expect(receipt.exited).to_be(true)
            expect(receipt.process_registered).to_be(false)
