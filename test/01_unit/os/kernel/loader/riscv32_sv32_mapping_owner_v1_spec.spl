use std.spec.*
use os.kernel.loader.riscv32_sv32_mapping_owner_v1.{
    riscv32_sv32_mapping_max_live_v1,
    riscv32_sv32_mapping_max_pages_v1
}
use os.kernel.arch.riscv32.sv32_user_root_owner_v1.{
    riscv32_sv32_user_root_max_live_v1,
    riscv32_sv32_user_mapping_request_valid_v1
}
use os.kernel.types.memory_types.{VmFlags}
use os.kernel.loader.executable_riscv32_mapping_owner_v1.{
    executable_riscv32_process_image_ready_v1
}

describe "RV32 Sv32 authenticated mapping ownership":
    it "keeps both serialized owners and retained leaf provenance bounded":
        expect(riscv32_sv32_mapping_max_live_v1()).to_equal(4)
        expect(riscv32_sv32_user_root_max_live_v1()).to_equal(4)
        expect(riscv32_sv32_mapping_max_pages_v1()).to_equal(65536u64)

    it "claims process-image readiness after retained scheduler adoption":
        expect(executable_riscv32_process_image_ready_v1()).to_equal(true)

    it "admits aligned lower-half PMM pages with W xor X":
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0x1000u64, 0x80000000u64, VmFlags.user_rw())).to_equal(true)
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0x2000u64, 0x80001000u64, VmFlags.user_rx())).to_equal(true)

    it "rejects W+X, high physical truncation, replacement-null, and kernel half":
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0x1000u64, 0x80000000u64,
            VmFlags(bits: 1u32 | 2u32 | 4u32))).to_equal(false)
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0x1000u64, 0x400000000u64, VmFlags.user_rx())).to_equal(false)
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0u64, 0x80000000u64, VmFlags.user_rx())).to_equal(false)
        expect(riscv32_sv32_user_mapping_request_valid_v1(
            0x80000000u64, 0x80000000u64, VmFlags.user_rx())).to_equal(false)

# Static ownership review scenarios (hardware-backed execution is deliberately
# not claimed by this unit contract):
#
# 1. Root identities come only from `riscv32_sv32_user_root_create_v1`; callers
#    cannot construct a root from an arbitrary PFN.
# 2. Mapping admits only aligned lower-half user pages and rejects W+X. Each
#    data frame is returned by PMM and retained as `PageFrame` provenance.
# 3. Copy failure exact-unmaps every reachable leaf before freeing that frame.
#    An unmap failure retains the leaf in the bounded quarantine slot.
# 4. Registry release is completed only with an architecture-produced exact
#    root-unreachable receipt. Root/table frames are freed only afterward.
# 5. Stale generation/nonce receipts cannot destroy or authorize a mapping.
# 6. A successful build remains MappedBlocked and execution_authorized=false
#    until the scheduler owns the separate registry adoption transition.
