use std.spec.{describe, it, expect}
use os.kernel.loader.x86_64_server_admission.{
    X86_64_SERVER_WEB_PATH, X86_64_SERVER_DB_PATH, X86_64_SERVER_PROFILE,
    X86_64ServerAdmissionInput,
    x86_64_server_web_profile, x86_64_server_db_profile,
    x86_64_server_admit, x86_64_server_admission_valid
}
use os.kernel.loader.artifact_manifest.{manifest_sha256_hex}

fn _push_u16(bytes: [u8], value: i64) -> [u8]:
    bytes.push((value & 0xff).to_u8())
    bytes.push(((value >> 8) & 0xff).to_u8())
    bytes

fn _push_u32(bytes: [u8], value: i64) -> [u8]:
    var out = bytes
    out = _push_u16(out, value)
    out = _push_u16(out, value >> 16)
    out

fn _push_u64(bytes: [u8], value: i64) -> [u8]:
    var out = bytes
    out = _push_u32(out, value)
    out = _push_u32(out, value >> 32)
    out

fn _minimal_x86_64_elf(marker: u8) -> [u8]:
    var out: [u8] = [0x7f, 0x45, 0x4c, 0x46, 2, 1, 1, 0]
    while out.len() < 16: out.push(0)
    out = _push_u16(out, 2)
    out = _push_u16(out, 62)
    out = _push_u32(out, 1)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 64)
    out = _push_u64(out, 0)
    out = _push_u32(out, 0)
    out = _push_u16(out, 64)
    out = _push_u16(out, 56)
    out = _push_u16(out, 1)
    out = _push_u16(out, 0)
    out = _push_u16(out, 0)
    out = _push_u16(out, 0)
    out = _push_u32(out, 1)
    out = _push_u32(out, 5)
    out = _push_u64(out, 0x1000)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 0x400000)
    out = _push_u64(out, 1)
    out = _push_u64(out, 1)
    out = _push_u64(out, 0x1000)
    while out.len() < 0x1001: out.push(0)
    out[0x1000] = marker
    out

fn _input(web: [u8], db: [u8], launch_id: text) -> X86_64ServerAdmissionInput:
    X86_64ServerAdmissionInput(
        web_path: X86_64_SERVER_WEB_PATH,
        db_path: X86_64_SERVER_DB_PATH,
        web_bytes: web,
        db_bytes: db,
        web_version: "1.0.0",
        db_version: "1.0.0",
        web_sha256: manifest_sha256_hex(web),
        db_sha256: manifest_sha256_hex(db),
        image_id: "unit-fat32-image",
        image_sha256: "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        launch_id: launch_id,
        runtime_profile: X86_64_SERVER_PROFILE,
        web_profile: x86_64_server_web_profile(launch_id),
        db_profile: x86_64_server_db_profile(launch_id)
    )

describe "x86_64 SimpleOS server admission" :
    it "accepts two distinct canonical static ELF64 server artifacts":
        val result = x86_64_server_admit(_input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7"))
        expect(result.accepted).to_equal(true)
        expect(result.reason).to_equal("ok")
        expect(x86_64_server_admission_valid(_input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7"))).to_equal(true)

    it "rejects wrong paths, empty or identical bytes, and unsanitized launch ids":
        var wrong = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        wrong.web_path = "/tmp/WEBSRV.SMF"
        expect(x86_64_server_admit(wrong).accepted).to_equal(false)
        expect(x86_64_server_admit(_input([], _minimal_x86_64_elf(0xc3), "boot-4-launch-7")).accepted).to_equal(false)
        expect(x86_64_server_admit(_input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0x90), "boot-4-launch-7")).accepted).to_equal(false)
        expect(x86_64_server_admit(_input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "bad id")).accepted).to_equal(false)

    it "requires exact single-worker web and database profiles":
        var input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.web_profile = "--simpleos --workers 2"
        expect(x86_64_server_admit(input).accepted).to_equal(false)
        input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.db_profile = "--serve --simpleos --workers 2"
        expect(x86_64_server_admit(input).accepted).to_equal(false)

    it "binds actual bytes, pinned versions, runtime profile, and disk image":
        var input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.web_sha256 = input.db_sha256
        expect(x86_64_server_admit(input).reason).to_equal("web-content-hash-mismatch")
        input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.web_version = "latest"
        expect(x86_64_server_admit(input).reason).to_equal("unpinned-server-version")
        input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.runtime_profile = "hosted-linux"
        expect(x86_64_server_admit(input).reason).to_equal("runtime-profile-mismatch")
        input = _input(_minimal_x86_64_elf(0x90), _minimal_x86_64_elf(0xc3), "boot-4-launch-7")
        input.image_sha256 = "unpinned"
        expect(x86_64_server_admit(input).reason).to_equal("unpinned-filesystem-image")

    it "rejects malformed ELF identity and out-of-bounds program headers":
        var bad = _minimal_x86_64_elf(0x90)
        bad[5] = 2
        expect(x86_64_server_admit(_input(bad, _minimal_x86_64_elf(0xc3), "boot-4-launch-7")).accepted).to_equal(false)
        bad = _minimal_x86_64_elf(0x90)
        bad[32] = 0xff
        bad[33] = 0xff
        expect(x86_64_server_admit(_input(bad, _minimal_x86_64_elf(0xc3), "boot-4-launch-7")).accepted).to_equal(false)

    it "requires the entry point inside a nonempty executable load segment":
        var bad = _minimal_x86_64_elf(0x90)
        # Program-header flags at ELF header + 4: remove PF_X.
        bad[68] = 4
        expect(x86_64_server_admit(_input(bad, _minimal_x86_64_elf(0xc3), "boot-4-launch-7")).accepted).to_equal(false)
        bad = _minimal_x86_64_elf(0x90)
        # e_entry outside the sole PT_LOAD virtual range.
        bad[24] = 0
        bad[25] = 0
        bad[26] = 0x50
        expect(x86_64_server_admit(_input(bad, _minimal_x86_64_elf(0xc3), "boot-4-launch-7")).accepted).to_equal(false)
