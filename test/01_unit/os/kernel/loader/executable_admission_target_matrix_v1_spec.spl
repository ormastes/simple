use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.executable_admission_pipeline.{
    executable_loader_architecture_for_target_v1
}

fn _target(arch: text, abi: text = "simpleos") -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: arch, abi: abi)

describe "authenticated filesystem admission target matrix v1":
    it "projects every canonical SimpleOS userland architecture into the ELF owner":
        step("Map all six exact filesystem artifact architecture identities")
        expect(executable_loader_architecture_for_target_v1(_target("x86_64")).unwrap()).to_equal(Architecture.X86_64)
        expect(executable_loader_architecture_for_target_v1(_target("x86")).unwrap()).to_equal(Architecture.X86)
        expect(executable_loader_architecture_for_target_v1(_target("aarch64")).unwrap()).to_equal(Architecture.Arm64)
        expect(executable_loader_architecture_for_target_v1(_target("arm")).unwrap()).to_equal(Architecture.Arm32)
        expect(executable_loader_architecture_for_target_v1(_target("riscv64")).unwrap()).to_equal(Architecture.Riscv64)
        expect(executable_loader_architecture_for_target_v1(_target("riscv32")).unwrap()).to_equal(Architecture.Riscv32)

    it "rejects aliases wildcard components and foreign operating systems":
        step("Reject non-canonical target identities before ELF layout parsing")
        expect(executable_loader_architecture_for_target_v1(_target("x86_32"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("arm32"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("riscv64gc"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("any"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("x86_64", "any"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("x86_64", "sysv"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("", "simpleos"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(_target("x86_64", ""))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(ManifestTarget(
            os: "", arch: "x86_64", abi: "simpleos"))).to_be_nil()
        expect(executable_loader_architecture_for_target_v1(ManifestTarget(
            os: "linux", arch: "x86_64", abi: "sysv"))).to_be_nil()
