use std.spec.{describe, it, expect}
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestResourceLimits, ManifestTarget, SimpleArtifactManifest
}
use os.kernel.loader.installed_artifact_catalog_v1.{
    SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_PER_RECORD_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_GLOBAL_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_MAX_KEY_COUNT_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1,
    SIMPLEOS_INSTALLED_ARTIFACT_TARGET_LIMIT_V1,
    InstalledArtifactBootstrapSessionV1,
    InstalledArtifactCatalogLifecycleV1, InstalledArtifactCatalogProtocolEventV1,
    installed_artifact_record_input_valid_v1,
    installed_artifact_catalog_protocol_transition_v1,
    installed_artifact_catalog_bootstrap_begin_v1,
    installed_artifact_catalog_bootstrap_add_v1,
    installed_artifact_catalog_bootstrap_seal_v1,
    installed_artifact_catalog_lookup_v1,
    installed_artifact_catalog_lookup_target_v1,
    installed_artifact_catalog_authenticated_alias_plan_v1
}

fn catalog_digest() -> text:
    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn catalog_trust_root_digest() -> text:
    "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn catalog_manifest(
    path: text = "/bin/simple", arch: text = "x86_64"
) -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1,
        artifact_kind: "elf",
        target: ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos"),
        entrypoint: path,
        required_abi_features: [],
        required_services: ["filesystem"],
        required_capabilities: 1u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 8,
            max_threads: 2, cpu_budget_us: 100000),
        namespace_template: "default",
        native_libraries: [],
        smf_libraries: [],
        interpreter: "",
        argument_schema: [],
        startup_preloads: [],
        content_hashes: [catalog_digest()],
        signature: "signed-fixture",
        debug_identity: "simple-fixture")

fn catalog_input_valid(
    path: text = "/bin/simple", aliases: [text] = ["/usr/bin/simple"],
    digest: text = catalog_digest(), signature: text = "signed-fixture",
    manifest: SimpleArtifactManifest = catalog_manifest()
) -> bool:
    installed_artifact_record_input_valid_v1(
        path, aliases, digest, "ed25519", "boot-root-1", signature, manifest)

describe "installed artifact catalog bounded input":
    it "accepts exact signed target and digest metadata":
        expect(catalog_input_valid()).to_be(true)

    it "rejects a non-canonical path and duplicate aliases":
        expect(catalog_input_valid(path: "bin/simple")).to_be(false)
        expect(catalog_input_valid(
            aliases: ["/usr/bin/simple", "/usr/bin/simple"])).to_be(false)

    it "rejects alias capacity overflow":
        expect(SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1).to_equal(64)
        expect(SIMPLEOS_INSTALLED_ARTIFACT_MAX_KEY_COUNT_V1).to_equal(6630)
        expect(SIMPLEOS_INSTALLED_ARTIFACT_KEY_TABLE_CAPACITY_V1)
            .to_be_greater_than(SIMPLEOS_INSTALLED_ARTIFACT_MAX_KEY_COUNT_V1)
        expect(SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_PER_RECORD_V1)
            .to_be_less_than(262144)
        expect(SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_TEXT_LIMIT_GLOBAL_V1)
            .to_be_less_than(25165824)
        var aliases: [text] = []
        var i: i64 = 0
        while i < SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1:
            aliases.push("/alias/{i}")
            i = i + 1
        expect(catalog_input_valid(aliases: aliases)).to_be(true)
        aliases.push("/alias/overflow")
        expect(catalog_input_valid(aliases: aliases)).to_be(false)

    it "rejects alias text over the per-record byte budget":
        var aliases: [text] = []
        var i: i64 = 0
        while i < 17:
            aliases.push("/alias/{i}/" + "x" * 4080)
            i = i + 1
        expect(aliases.len()).to_be_less_than(
            SIMPLEOS_INSTALLED_ARTIFACT_ALIAS_LIMIT_V1)
        expect(catalog_input_valid(aliases: aliases)).to_be(false)

    it "rejects target path digest and signature disagreement":
        var wrong_target = catalog_manifest()
        wrong_target.target.arch = "any"
        expect(catalog_input_valid(manifest: wrong_target)).to_be(false)

        expect(catalog_input_valid(
            digest: "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))
            .to_be(false)
        expect(catalog_input_valid(signature: "other")).to_be(false)

        val other_path_manifest = catalog_manifest("/bin/other")
        expect(catalog_input_valid(manifest: other_path_manifest)).to_be(false)

        var unsupported = catalog_manifest()
        unsupported.target.arch = "mips64"
        expect(catalog_input_valid(manifest: unsupported)).to_be(false)

    it "rejects unsigned records and uppercase digests":
        expect(catalog_input_valid(signature: "")).to_be(false)
        expect(catalog_input_valid(
            digest: "ABCDEF0123456789abcdef0123456789abcdef0123456789abcdef0123456789"))
            .to_be(false)

    it "models one-way sealing and fail-stop committed-unknown serialization":
        expect(installed_artifact_catalog_protocol_transition_v1(
            InstalledArtifactCatalogLifecycleV1.Uninitialized,
            InstalledArtifactCatalogProtocolEventV1.BeginBootstrap).unwrap())
            .to_equal(InstalledArtifactCatalogLifecycleV1.Populating)
        expect(installed_artifact_catalog_protocol_transition_v1(
            InstalledArtifactCatalogLifecycleV1.Populating,
            InstalledArtifactCatalogProtocolEventV1.Seal).unwrap())
            .to_equal(InstalledArtifactCatalogLifecycleV1.Sealed)
        expect(installed_artifact_catalog_protocol_transition_v1(
            InstalledArtifactCatalogLifecycleV1.Sealed,
            InstalledArtifactCatalogProtocolEventV1.AddRecord).?).to_be(false)
        expect(installed_artifact_catalog_protocol_transition_v1(
            InstalledArtifactCatalogLifecycleV1.Populating,
            InstalledArtifactCatalogProtocolEventV1.CommittedUnknownUnlock).unwrap())
            .to_equal(InstalledArtifactCatalogLifecycleV1.Quarantined)
        expect(installed_artifact_catalog_protocol_transition_v1(
            InstalledArtifactCatalogLifecycleV1.Quarantined,
            InstalledArtifactCatalogProtocolEventV1.BeginBootstrap).?).to_be(false)

    it "keys paths by all six bounded targets and keeps snapshots isolated":
        val session = installed_artifact_catalog_bootstrap_begin_v1()
        expect(session.?).to_be(true)
        val active = session.unwrap()
        val forged = InstalledArtifactBootstrapSessionV1(
            generation: active.generation, nonce: active.nonce + 1u64)
        expect(installed_artifact_catalog_bootstrap_add_v1(
            forged, "/bin/forged", [], catalog_digest(), "ed25519",
            "boot-root-1", "signed-fixture", catalog_trust_root_digest(),
            catalog_manifest("/bin/forged")))
            .to_be(false)

        var caller_aliases = ["/usr/bin/simple", "/diagnostic/x86-simple"]
        var caller_manifest = catalog_manifest("/bin/simple", "x86_64")
        expect(installed_artifact_catalog_bootstrap_add_v1(
            active, "/bin/simple", caller_aliases, catalog_digest(), "ed25519",
            "boot-root-1", "signed-fixture", catalog_trust_root_digest(),
            caller_manifest))
            .to_be(true)
        caller_aliases.push("/alias/late-mutation")
        caller_manifest.required_services.push("late-service")
        caller_manifest.content_hashes.push(
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")

        val architectures = ["x86_64", "x86", "aarch64", "arm", "riscv64", "riscv32"]
        expect(architectures.len()).to_equal(SIMPLEOS_INSTALLED_ARTIFACT_TARGET_LIMIT_V1)
        var arch_index: i64 = 1
        while arch_index < architectures.len():
            expect(installed_artifact_catalog_bootstrap_add_v1(
                active, "/bin/simple", ["/usr/bin/simple"], catalog_digest(),
                "ed25519", "boot-root-1", "signed-fixture",
                catalog_trust_root_digest(),
                catalog_manifest("/bin/simple", architectures[arch_index])))
                .to_be(true)
            arch_index = arch_index + 1

        arch_index = 0
        while arch_index < architectures.len():
            var i: i64 = 1
            while i < SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1:
                val path = "/bin/tool{i}"
                expect(installed_artifact_catalog_bootstrap_add_v1(
                    active, path, [], catalog_digest(), "ed25519", "boot-root-1",
                    "signed-fixture", catalog_trust_root_digest(),
                    catalog_manifest(path, architectures[arch_index])))
                    .to_be(true)
                i = i + 1
            expect(installed_artifact_catalog_bootstrap_add_v1(
                active, "/bin/overflow", [], catalog_digest(), "ed25519",
                "boot-root-1", "signed-fixture",
                catalog_trust_root_digest(),
                catalog_manifest("/bin/overflow", architectures[arch_index])))
                .to_be(false)
            arch_index = arch_index + 1
        expect(SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_V1).to_equal(
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1 * architectures.len())
        expect(installed_artifact_catalog_bootstrap_add_v1(
            active, "/bin/over-total", [], catalog_digest(), "ed25519",
            "boot-root-1", "signed-fixture", catalog_trust_root_digest(),
            catalog_manifest("/bin/over-total")))
            .to_be(false)
        expect(installed_artifact_catalog_bootstrap_seal_v1(active)).to_be(true)
        expect(installed_artifact_catalog_bootstrap_add_v1(
            active, "/bin/stale", [], catalog_digest(), "ed25519",
            "boot-root-1", "signed-fixture", catalog_trust_root_digest(),
            catalog_manifest("/bin/stale")))
            .to_be(false)

        # Target-free compatibility lookup rejects a cross-target collision.
        expect(installed_artifact_catalog_lookup_v1("/bin/simple").?).to_be(false)
        expect(installed_artifact_catalog_lookup_v1("/usr/bin/simple").?).to_be(false)
        val first = installed_artifact_catalog_lookup_v1("/diagnostic/x86-simple")
        expect(first.?).to_be(true)
        expect(first.unwrap().aliases.len()).to_equal(2)
        expect(first.unwrap().expected_trust_root_sha256).to_equal(
            catalog_trust_root_digest())
        var changed = first.unwrap()
        changed.aliases.push("/alias/output-mutation")
        changed.manifest.content_hashes.push(
            "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
        val second = installed_artifact_catalog_lookup_v1("/diagnostic/x86-simple")
        expect(second.?).to_be(true)
        expect(second.unwrap().aliases.len()).to_equal(2)
        expect(second.unwrap().manifest.required_services.len()).to_equal(1)
        expect(second.unwrap().manifest.content_hashes.len()).to_equal(1)

        val exact_target = ManifestTarget(
            os: "simpleos", arch: "x86_64", abi: "simpleos")
        val exact = installed_artifact_catalog_lookup_target_v1(
            "/usr/bin/simple", exact_target)
        expect(exact.?).to_be(true)
        expect(exact.unwrap().canonical_path).to_equal("/bin/simple")
        val alias_plan = installed_artifact_catalog_authenticated_alias_plan_v1(
            "/usr/bin/simple", exact_target,
            ["/usr/bin/simple", "/diagnostic/x86-simple"])
        expect(alias_plan.ok).to_be(true)
        expect(alias_plan.nodes.len()).to_equal(2)
        expect(alias_plan.nodes[0].source.canonical_path).to_equal("/bin/simple")
        expect(alias_plan.nodes[1].source.content_sha256).to_equal(catalog_digest())
        expect(installed_artifact_catalog_authenticated_alias_plan_v1(
            "/usr/bin/simple", exact_target,
            ["/usr/bin/simple", "/usr/bin/simple"]).ok).to_be(false)
        expect(installed_artifact_catalog_authenticated_alias_plan_v1(
            "/usr/bin/simple", exact_target, ["/bin/not-catalogued"]).ok)
            .to_be(false)
        expect(installed_artifact_catalog_authenticated_alias_plan_v1(
            "/usr/bin/simple", exact_target, ["/bin/simple"]).ok).to_be(false)

        for architecture in architectures:
            val target_record = installed_artifact_catalog_lookup_target_v1(
                "/bin/simple", ManifestTarget(
                    os: "simpleos", arch: architecture, abi: "simpleos"))
            expect(target_record.?).to_be(true)
            expect(target_record.unwrap().target.arch).to_equal(architecture)

        val wrong_arch = installed_artifact_catalog_lookup_target_v1(
            "/bin/simple", ManifestTarget(
                os: "simpleos", arch: "mips64", abi: "simpleos"))
        expect(wrong_arch.?).to_be(false)
        val wrong_os = installed_artifact_catalog_lookup_target_v1(
            "/bin/simple", ManifestTarget(
                os: "linux", arch: "x86_64", abi: "simpleos"))
        expect(wrong_os.?).to_be(false)
        val wrong_abi = installed_artifact_catalog_lookup_target_v1(
            "/bin/simple", ManifestTarget(
                os: "simpleos", arch: "x86_64", abi: "sysv"))
        expect(wrong_abi.?).to_be(false)
        val invalid_target = installed_artifact_catalog_lookup_target_v1(
            "/bin/simple", ManifestTarget(
                os: "simpleos", arch: "any", abi: "simpleos"))
        expect(invalid_target.?).to_be(false)
        # Mismatches do not quarantine a sound sealed catalog.
        val after_mismatch = installed_artifact_catalog_lookup_target_v1(
            "/bin/simple", exact_target)
        expect(after_mismatch.?).to_be(true)
        expect(after_mismatch.unwrap().canonical_path).to_equal("/bin/simple")
