use std.spec.{describe, it, expect, step}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_EXECUTABLE_V1, SIMPLEOS_WEB_STATIC_FILE_V1,
    SIMPLEOS_WEB_TLS_CERTIFICATE_V1, SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1,
    SIMPLEOS_WEB_HTTP_PORT_V1, SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1,
    WebLaunchGrantPlanV1, simpleos_web_loopback_address_v1,
    web_launch_grant_plan_v1, web_launch_grant_plan_valid_v1,
    web_launch_caps_exact_v1
}
use os.kernel.types.capability_types.{
    CapabilityKind, CapabilitySet, CapabilityToken,
    capability_set_bind_owner
}

fn _web_caps_v1(address: u32, owner: u64) -> CapabilitySet:
    val plan = web_launch_grant_plan_v1(SIMPLEOS_WEB_EXECUTABLE_V1, address)
    var tokens: [CapabilityToken] = []
    var token_id: u64 = 1u64
    for grant in plan.grants:
        tokens.push(CapabilityToken(
            kind: grant.requested, generation: token_id, owner: owner,
            token_id: token_id, parent_token_id: 0u64, depth: 0))
        token_id = token_id + 1u64
    CapabilitySet(caps: tokens, is_pledged: true)

describe("dedicated WEB launch grants"):

    it("declares the exact seven-capability WEB pouch"):
        val address = simpleos_web_loopback_address_v1()
        val plan = web_launch_grant_plan_v1(SIMPLEOS_WEB_EXECUTABLE_V1, address)
        expect(web_launch_grant_plan_valid_v1(plan)).to_equal(true)
        expect(plan.grants.len()).to_equal(SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1)
        val caps = _web_caps_v1(address, 71u64)
        expect(web_launch_caps_exact_v1(caps, address)).to_equal(true)
        expect(caps.has(CapabilityKind.FileExec(
            path_prefix: SIMPLEOS_WEB_EXECUTABLE_V1))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_WEB_STATIC_FILE_V1))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_WEB_TLS_CERTIFICATE_V1))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: SIMPLEOS_WEB_TLS_PRIVATE_KEY_V1))).to_equal(true)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: address, port: SIMPLEOS_WEB_HTTP_PORT_V1))).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(
            port: SIMPLEOS_WEB_HTTP_PORT_V1))).to_equal(true)

    it("stays isolated from SERVERS and ambient database/network powers"):
        val address = simpleos_web_loopback_address_v1()
        val caps = _web_caps_v1(address, 72u64)
        step("the dedicated image cannot execute or read the legacy image")
        expect(caps.has(CapabilityKind.FileExec(
            path_prefix: "/SERVERS.ELF"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SERVERS.ELF"))).to_equal(false)
        step("database, mount, connect, spawn, raw, and wildcard powers are absent")
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.CRT"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.PK8"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/dbfs/"))).to_equal(false)
        expect(caps.has(CapabilityKind.Mount(
            path_prefix: "/", rights: 1u32))).to_equal(false)
        expect(caps.has(CapabilityKind.IpcConnect(
            port_name: "dbfs"))).to_equal(false)
        expect(caps.has(CapabilityKind.NetConnect(port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetConnect(port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: 0u32, port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.ProcessSpawn)).to_equal(false)
        expect(caps.has(CapabilityKind.NetRaw)).to_equal(false)

    it("fails closed for wildcard or non-WEB identity and duplicate grants"):
        expect(web_launch_grant_plan_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, 0u32).grants.len()).to_equal(0)
        expect(web_launch_grant_plan_v1(
            "/SERVERS.ELF", simpleos_web_loopback_address_v1()
        ).grants.len()).to_equal(0)
        val valid = web_launch_grant_plan_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, simpleos_web_loopback_address_v1())
        var duplicated = valid.grants
        duplicated[6] = duplicated[5]
        expect(web_launch_grant_plan_valid_v1(WebLaunchGrantPlanV1(
            executable_identity: valid.executable_identity,
            bind_ipv4_address: valid.bind_ipv4_address,
            grants: duplicated))).to_equal(false)

    it("preserves exact authority across scheduler owner rebind"):
        val address = simpleos_web_loopback_address_v1()
        val minted = _web_caps_v1(address, 73u64)
        val rebound = capability_set_bind_owner(minted, 9002u64)
        expect(web_launch_caps_exact_v1(rebound, address)).to_equal(true)
        expect(rebound.caps.len()).to_equal(minted.caps.len())
        expect(rebound.caps[0].owner).to_equal(9002u64)
        expect(rebound.caps[0].generation).to_equal(minted.caps[0].generation)
