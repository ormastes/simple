use std.spec.{describe, it, expect}
use os.kernel.loader.fs_exec_launch_caps_v1.{fs_exec_launch_caps_with_launch_v1}
use os.kernel.loader.dbd_launch_grants_v1.{
    SIMPLEOS_DBD_EXECUTABLE_V1, SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1
}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_EXECUTABLE_V1, SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1
}
use os.kernel.types.capability_types.{CapabilityKind}

describe("shared filesystem-exec launch capability pouch"):
    it("gives canonical DBD 5433 but never HTTP or wildcard listen authority"):
        val caps = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1], [], 91u64)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_DBD_CONFIGURED_BIND_IPV4_V1,
            port: 5433u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: 0u32, port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(path_prefix: "/SYS/SRVDB.KEY"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(path_prefix: "/srv/data/db"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileWrite(path_prefix: "/srv/data/db"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileCreate(path_prefix: "/srv/data/db/DBD.LOG.NEW.1"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileWrite(path_prefix: "/srv/data"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileWrite(path_prefix: "/srv/data/database"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileCreate(path_prefix: "/srv/data/database/DBD.LOG"))).to_equal(false)

    it("keeps altered DBD metadata on generic non-listening authority"):
        val caps = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1],
            ["PATH=/bin"], 92u64)
        expect(caps.has(CapabilityKind.FileRead(path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetConnect(port: 0u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)

    it("gives canonical WEB only its configured exact HTTPS-ready listener pouch"):
        val caps = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1], [], 93u64)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1,
            port: 8080u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/HTTPS.CRT"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/HTTPS.PK8"))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.CRT"))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.PK8"))).to_equal(false)

    it("keeps altered WEB metadata on generic non-listening authority"):
        val caps = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1],
            ["PATH=/bin"], 94u64)
        expect(caps.has(CapabilityKind.NetBindIpv4(
            address: SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1,
            port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
