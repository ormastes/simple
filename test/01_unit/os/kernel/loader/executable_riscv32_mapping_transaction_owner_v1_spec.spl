use std.spec.{describe, it, expect, fail}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.contracts.execution.simpleos_executable_admission_v1.{
    ExecutableImageHandleV1, ExecutableLoadRangeV1
}
use os.kernel.loader.executable_authority_registry.{
    ExecutableAuthorityErrorV1, ExecutableAuthorityStateV1,
    executable_authority_loader_owner_initialize,
    executable_authority_issue_verified, executable_authority_snapshot,
    executable_authority_abort_joint_reservation_v1,
    executable_authority_commit_joint_reservation_v1,
    executable_authority_commit_riscv32_user_entry_reservation_v1,
    executable_authority_begin_riscv32_mapping_transaction_v1,
    executable_authority_bind_riscv32_mapping_root_v1,
    executable_authority_mark_riscv32_mapping_installed_v1,
    executable_authority_begin_riscv32_mapping_release_v1,
    executable_authority_mapping_release_indeterminate_v1,
    executable_authority_abort_unmaterialized_riscv32_mapping_v1
}
use os.kernel.loader.executable_load_plan_v1.{executable_load_consumer_new_v1}

fn _mapping_transaction_handle() -> ExecutableImageHandleV1:
    ExecutableImageHandleV1(
        schema_version: 1, open_handle_id: 91u64, mount_id: 3u64,
        filesystem_name: "fat32", canonical_source_path: "/bin/rv32-map",
        mount_generation: 5u64, file_id: 7u64, file_generation: 11u64,
        size_bytes: 4096u64, role: "main-image",
        target: ManifestTarget(os: "simpleos", arch: "riscv32", abi: "simpleos"),
        verified_load_ranges: [ExecutableLoadRangeV1(
            file_offset: 0u64, file_size: 64u64,
            virtual_address: 0x10000u64, memory_size: 4096u64,
            writable: false, executable: true)],
        image_hash: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        admission_id: "rv32-mapping-transaction-1", trust_epoch: 1u64,
        read_count: 0u64, read_bytes: 0u64, consumed: false)

describe "RV32 loader and mapping transaction owner":
    it "blocks generic abort and commit while a mapping pin is live":
        val owner = executable_authority_loader_owner_initialize(
            8, 0x525633324D415054u64).unwrap()
        val token = executable_authority_issue_verified(
            owner, _mapping_transaction_handle(), true, 0x10000u64).unwrap()
        val consumer = executable_load_consumer_new_v1(
            "simpleos", "riscv32", "simpleos")
        val tx = executable_authority_begin_riscv32_mapping_transaction_v1(
            owner, token, consumer, 0x10000u64, 0x7FFFF000u64,
            0u32, "/bin/rv32-map").unwrap()
        expect(executable_authority_abort_joint_reservation_v1(
            owner, tx._entry._joint_lease).unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.MappingPinActive)
        expect(executable_authority_commit_joint_reservation_v1(
            owner, token, tx._entry._joint_lease, consumer,
            0x10000u64, "/bin/rv32-map").is_err()).to_be_true()
        expect(executable_authority_abort_unmaterialized_riscv32_mapping_v1(
            owner, tx).is_ok()).to_be_true()
        expect(executable_authority_snapshot(owner, token).unwrap().state).to_equal(
            ExecutableAuthorityStateV1.Armed)

    it "retains an exact retry coordinate after indeterminate release":
        val owner = executable_authority_loader_owner_initialize(
            8, 0x525633324D415054u64).unwrap()
        val token = executable_authority_issue_verified(
            owner, _mapping_transaction_handle(), true, 0x10000u64).unwrap()
        val consumer = executable_load_consumer_new_v1(
            "simpleos", "riscv32", "simpleos")
        val tx = executable_authority_begin_riscv32_mapping_transaction_v1(
            owner, token, consumer, 0x10000u64, 0x7FFFF000u64,
            0u32, "/bin/rv32-map").unwrap()
        expect(executable_authority_bind_riscv32_mapping_root_v1(
            owner, tx._pin, 41u64, 2u64).is_ok()).to_be_true()
        val first = executable_authority_begin_riscv32_mapping_release_v1(
            owner, tx._pin).unwrap()
        val reissued = executable_authority_begin_riscv32_mapping_release_v1(
            owner, tx._pin).unwrap()
        expect(reissued._release_attempt).to_equal(first._release_attempt)
        expect(reissued._root_id).to_equal(first._root_id)
        expect(reissued._root_generation).to_equal(first._root_generation)
        expect(executable_authority_mapping_release_indeterminate_v1(
            owner, reissued).is_ok()).to_be_true()
        expect(executable_authority_abort_joint_reservation_v1(
            owner, tx._entry._joint_lease).unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.MappingPinActive)
        val retry = executable_authority_begin_riscv32_mapping_release_v1(
            owner, tx._pin).unwrap()
        expect(retry._release_attempt).to_equal(first._release_attempt + 1u64)
        expect(retry._root_id).to_equal(first._root_id)
        expect(retry._root_generation).to_equal(first._root_generation)
        expect(executable_authority_mapping_release_indeterminate_v1(
            owner, first).is_err()).to_be_true()
        expect(executable_authority_mapping_release_indeterminate_v1(
            owner, retry).is_ok()).to_be_true()
        expect(executable_authority_abort_joint_reservation_v1(
            owner, tx._entry._joint_lease).unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.MappingPinActive)

    it "keeps an installed exact root pinned until an adoption owner exists":
        val owner = executable_authority_loader_owner_initialize(
            8, 0x525633324D415054u64).unwrap()
        val token = executable_authority_issue_verified(
            owner, _mapping_transaction_handle(), true, 0x10000u64).unwrap()
        val consumer = executable_load_consumer_new_v1(
            "simpleos", "riscv32", "simpleos")
        val tx = executable_authority_begin_riscv32_mapping_transaction_v1(
            owner, token, consumer, 0x10000u64, 0x7FFFF000u64,
            0u32, "/bin/rv32-map").unwrap()
        expect(executable_authority_bind_riscv32_mapping_root_v1(
            owner, tx._pin, 51u64, 3u64).is_ok()).to_be_true()
        expect(executable_authority_mark_riscv32_mapping_installed_v1(
            owner, tx._pin, 51u64, 4u64).is_err()).to_be_true()
        expect(executable_authority_mark_riscv32_mapping_installed_v1(
            owner, tx._pin, 51u64, 3u64).is_ok()).to_be_true()
        expect(executable_authority_commit_joint_reservation_v1(
            owner, token, tx._entry._joint_lease, consumer,
            0x10000u64, "/bin/rv32-map").unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.InvalidUserEntryLease)
        expect(executable_authority_commit_riscv32_user_entry_reservation_v1(
            owner, token, tx._entry, consumer,
            0x10000u64, "/bin/rv32-map").unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.MappingPinActive)
        expect(executable_authority_abort_joint_reservation_v1(
            owner, tx._entry._joint_lease).unwrap_err()).to_equal(
                ExecutableAuthorityErrorV1.MappingPinActive)
