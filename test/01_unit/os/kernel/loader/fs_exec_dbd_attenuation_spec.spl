use std.spec.{describe, it, expect}
use os.kernel.loader.fs_exec_launch_caps_v1.{
    fs_exec_launch_caps_with_launch_v1, fs_exec_launch_caps_attenuated_by_v1
}
use os.kernel.loader.dbd_launch_grants_v1.{SIMPLEOS_DBD_EXECUTABLE_V1}
use os.kernel.types.capability_types.{CapabilityKind, CapabilitySet, CapabilityToken}

fn _caps(kinds: [CapabilityKind]) -> CapabilitySet:
    var tokens: [CapabilityToken] = []
    var id: u64 = 1u64
    for kind in kinds:
        tokens.push(CapabilityToken(kind: kind, generation: id, owner: 7u64,
            token_id: id, parent_token_id: 0u64, depth: 0))
        id = id + 1u64
    CapabilitySet(caps: tokens, is_pledged: true)

describe("canonical DBD child-pouch attenuation"):
    it("denies a FileExec-only parent before publication"):
        val required = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1], [], 0u64)
        val parent = _caps([CapabilityKind.FileExec(path_prefix: SIMPLEOS_DBD_EXECUTABLE_V1)])
        expect(fs_exec_launch_caps_attenuated_by_v1(required, parent)).to_equal(false)

    it("accepts the fully authorized exact 5433-only pouch"):
        val required = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1], [], 0u64)
        expect(fs_exec_launch_caps_attenuated_by_v1(required, required)).to_equal(true)
        expect(required.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(true)
        expect(required.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(false)
        expect(required.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)

    it("keeps altered tuples out of the privileged child route"):
        val altered = fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1], ["PATH=/bin"], 0u64)
        expect(altered.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(false)
        expect(altered.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)
