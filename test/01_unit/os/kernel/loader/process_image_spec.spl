# @req: REQ-OS-KERNEL-001

use std.spec
use os.kernel.loader.process_image.{build_user_process_image}
use os.kernel.loader.process_image.{X86_64_USER_STACK_TOP, X86_32_USER_STACK_TOP}
use os.kernel.loader.executable_source.{
    resolve_executable_bytes, _set_synthetic_vfs_file_for_test,
    _clear_synthetic_initramfs_for_test, _clear_synthetic_vfs_for_test,
}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.executable_launch_arguments_v1.{
    executable_launch_arguments_v1_validate
}

fn push_u16_le(buf: [u8], value: i64) -> [u8]:
    var out: [u8] = buf
    out.push((value & 0xFF).to_u8())
    out.push(((value >> 8) & 0xFF).to_u8())
    out

fn push_u32_le(buf: [u8], value: i64) -> [u8]:
    var out: [u8] = buf
    out.push((value & 0xFF).to_u8())
    out.push(((value >> 8) & 0xFF).to_u8())
    out.push(((value >> 16) & 0xFF).to_u8())
    out.push(((value >> 24) & 0xFF).to_u8())
    out

fn push_u64_le(buf: [u8], value: i64) -> [u8]:
    var out: [u8] = buf
    out = push_u32_le(out, value & 0xFFFFFFFF)
    out = push_u32_le(out, (value >> 32) & 0xFFFFFFFF)
    out

fn make_x86_64_exec() -> [u8]:
    var bytes: [u8] = []
    bytes.push(0x7F.to_u8())
    bytes.push(0x45.to_u8())
    bytes.push(0x4C.to_u8())
    bytes.push(0x46.to_u8())
    bytes.push(2.to_u8())
    bytes.push(1.to_u8())
    bytes.push(1.to_u8())
    bytes.push(0.to_u8())
    bytes.push(0.to_u8())
    while bytes.len() < 16:
        bytes.push(0.to_u8())
    bytes = push_u16_le(bytes, 2)
    bytes = push_u16_le(bytes, 62)
    bytes = push_u32_le(bytes, 1)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 64)
    bytes = push_u64_le(bytes, 0)
    bytes = push_u32_le(bytes, 0)
    bytes = push_u16_le(bytes, 64)
    bytes = push_u16_le(bytes, 56)
    bytes = push_u16_le(bytes, 1)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u32_le(bytes, 1)
    bytes = push_u32_le(bytes, 5)
    bytes = push_u64_le(bytes, 0x80)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 4)
    bytes = push_u64_le(bytes, 4)
    bytes = push_u64_le(bytes, 0x1000)
    while bytes.len() < 0x80:
        bytes.push(0.to_u8())
    bytes.push(0xC3.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    bytes

fn make_multi_pt_load_x86_64_exec() -> [u8]:
    var bytes: [u8] = []
    bytes.push(0x7F.to_u8())
    bytes.push(0x45.to_u8())
    bytes.push(0x4C.to_u8())
    bytes.push(0x46.to_u8())
    bytes.push(2.to_u8())
    bytes.push(1.to_u8())
    bytes.push(1.to_u8())
    bytes.push(0.to_u8())
    bytes.push(0.to_u8())
    while bytes.len() < 16:
        bytes.push(0.to_u8())
    bytes = push_u16_le(bytes, 2)
    bytes = push_u16_le(bytes, 62)
    bytes = push_u32_le(bytes, 1)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 64)
    bytes = push_u64_le(bytes, 0)
    bytes = push_u32_le(bytes, 0)
    bytes = push_u16_le(bytes, 64)
    bytes = push_u16_le(bytes, 56)
    bytes = push_u16_le(bytes, 2)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)

    # PT_LOAD #1: file-backed text segment.
    bytes = push_u32_le(bytes, 1)
    bytes = push_u32_le(bytes, 5)
    bytes = push_u64_le(bytes, 0xC0)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 0x400000)
    bytes = push_u64_le(bytes, 4)
    bytes = push_u64_le(bytes, 4)
    bytes = push_u64_le(bytes, 0x1000)

    # PT_LOAD #2: BSS-only data segment.
    bytes = push_u32_le(bytes, 1)
    bytes = push_u32_le(bytes, 6)
    bytes = push_u64_le(bytes, 0xD0)
    bytes = push_u64_le(bytes, 0x401000)
    bytes = push_u64_le(bytes, 0x401000)
    bytes = push_u64_le(bytes, 0)
    bytes = push_u64_le(bytes, 0x1000)
    bytes = push_u64_le(bytes, 0x1000)

    while bytes.len() < 0xC0:
        bytes.push(0.to_u8())
    bytes.push(0xC3.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    while bytes.len() < 0xD0:
        bytes.push(0.to_u8())
    bytes

fn make_smf_wrapped_x86_64_exec() -> [u8]:
    var b = make_x86_64_exec()
    val stub_len = b.len()
    b.push(83.to_u8())
    b.push(77.to_u8())
    b.push(70.to_u8())
    b.push(0.to_u8())
    var i = 4
    while i < 44:
        b.push(0.to_u8())
        i = i + 1
    b = push_u64_le(b, 0x400000)
    b = push_u32_le(b, stub_len)
    b = push_u32_le(b, stub_len)
    while b.len() < stub_len + 128:
        b.push(0.to_u8())
    b

fn make_x86_32_exec() -> [u8]:
    var bytes: [u8] = []
    bytes.push(0x7F.to_u8())
    bytes.push(0x45.to_u8())
    bytes.push(0x4C.to_u8())
    bytes.push(0x46.to_u8())
    bytes.push(1.to_u8())
    bytes.push(1.to_u8())
    bytes.push(1.to_u8())
    bytes.push(0.to_u8())
    bytes.push(0.to_u8())
    while bytes.len() < 16:
        bytes.push(0.to_u8())
    bytes = push_u16_le(bytes, 2)
    bytes = push_u16_le(bytes, 3)
    bytes = push_u32_le(bytes, 1)
    bytes = push_u32_le(bytes, 0x8048000)
    bytes = push_u32_le(bytes, 52)
    bytes = push_u32_le(bytes, 0)
    bytes = push_u32_le(bytes, 0)
    bytes = push_u16_le(bytes, 52)
    bytes = push_u16_le(bytes, 32)
    bytes = push_u16_le(bytes, 1)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u16_le(bytes, 0)
    bytes = push_u32_le(bytes, 1)
    bytes = push_u32_le(bytes, 0x60)
    bytes = push_u32_le(bytes, 0x8048000)
    bytes = push_u32_le(bytes, 0x8048000)
    bytes = push_u32_le(bytes, 4)
    bytes = push_u32_le(bytes, 4)
    bytes = push_u32_le(bytes, 5)
    bytes = push_u32_le(bytes, 0x1000)
    while bytes.len() < 0x60:
        bytes.push(0.to_u8())
    bytes.push(0xC3.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    bytes.push(0x90.to_u8())
    bytes

fn make_riscv32_exec() -> [u8]:
    var bytes = make_x86_32_exec()
    bytes[18] = 243.to_u8()
    bytes[19] = 0.to_u8()
    bytes

fn make_arm32_exec() -> [u8]:
    var bytes = make_x86_32_exec()
    bytes[18] = 40.to_u8()
    bytes[19] = 0.to_u8()
    bytes

describe "process image builder":
    it "builds an x86_64 user image from executable bytes":
        # @req: REQ-OS-KERNEL-001
        step("Verify: builds an x86_64 user image from executable bytes")
        val bytes = make_x86_64_exec()
        val image = build_user_process_image("/usr/bin/x86_exec_probe", bytes, Architecture.X86_64, [], [])
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()
        expect(built.entry).to_equal(0x400000)
        expect(built.stack_top).to_equal(X86_64_USER_STACK_TOP)
        expect(built.stack_size).to_equal(0x800000)
        expect(built.segment_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(built.argv.len()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(built.argv[0]).to_equal("/usr/bin/x86_exec_probe")
        expect(built.envp.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "rejects an x86_32 image at the ELF64-only stack boundary":
        # @req: REQ-OS-KERNEL-001
        step("Verify: builds an x86_32 user image from executable bytes")
        val bytes = make_x86_32_exec()
        val image = build_user_process_image("/usr/bin/x86_32_exec_probe", bytes, Architecture.X86, [], [])
        expect(image.is_err()).to_equal(true)
        expect(image.unwrap_err()).to_contain("ELF64 initial stack builder")

    it "rejects ARM32 and RISC-V32 images without constructing a partial stack":
        val arm = build_user_process_image(
            "/usr/bin/arm32_exec_probe", make_arm32_exec(), Architecture.Arm32, [], [])
        expect(arm.is_err()).to_equal(true)
        expect(arm.unwrap_err()).to_contain("ELF64 initial stack builder")
        val riscv = build_user_process_image(
            "/usr/bin/rv32_exec_probe", make_riscv32_exec(), Architecture.Riscv32, [], [])
        expect(riscv.is_err()).to_equal(true)
        expect(riscv.unwrap_err()).to_contain("ELF64 initial stack builder")

    it "returns an error for malformed ELF64 stack strings without panicking":
        val image = build_user_process_image(
            "/usr/bin/x86_exec_probe", make_x86_64_exec(), Architecture.X86_64,
            ["/usr/bin/x86_exec_probe"], ["BAD=embedded\0tail"])
        expect(image.is_err()).to_equal(true)
        expect(image.unwrap_err()).to_contain("initial stack construction failed")

    it "builds an x86_64 user image from an SMF-wrapped executable stub":
        # @req: REQ-OS-KERNEL-001
        step("Verify: builds an x86_64 user image from an SMF-wrapped executable stub")
        val bytes = make_smf_wrapped_x86_64_exec()
        val image = build_user_process_image("/usr/bin/smf_x86_exec_probe", bytes, Architecture.X86_64, [], [])
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()
        expect(built.entry).to_equal(0x400000)
        expect(built.stack_top).to_equal(X86_64_USER_STACK_TOP)
        expect(built.stack_size).to_equal(0x800000)
        expect(built.segment_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(built.file_bytes[0]).to_equal(0x7F.to_u8())

    it "builds an x86_64 user image from multi-PT_LOAD app bytes and owns the copies":
        # @req: REQ-OS-KERNEL-001
        step("Verify: builds an x86_64 user image from multi-PT_LOAD app bytes and owns the copies")
        var bytes = make_multi_pt_load_x86_64_exec()
        val image = build_user_process_image("/sys/apps/browser_demo", bytes, Architecture.X86_64, [], [])
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()

        expect(built.entry).to_equal(0x400000)
        expect(built.stack_top).to_equal(X86_64_USER_STACK_TOP)
        expect(built.stack_size).to_equal(0x800000)
        expect(built.segments.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(built.segment_count).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(built.segments[0].data.len()).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(built.segments[0].data[0]).to_equal(0xC3.to_u8())
        expect(built.segments[1].file_size).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(built.segments[1].mem_size).to_equal(0x1000)
        expect(built.segments[1].data.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(built.file_bytes[0]).to_equal(0x7F.to_u8())
        expect(built.file_bytes[0xC0]).to_equal(0xC3.to_u8())

        bytes[0] = 0x00.to_u8()
        bytes[0xC0] = 0x00.to_u8()

        expect(built.file_bytes[0]).to_equal(0x7F.to_u8())
        expect(built.segments[0].data[0]).to_equal(0xC3.to_u8())

    it "preserves explicit argv and envp in the built image":
        # @req: REQ-OS-KERNEL-001
        step("Verify: preserves explicit argv and envp in the built image")
        val bytes = make_x86_64_exec()
        val launch = executable_launch_arguments_v1_validate(
            "/usr/bin/x86_exec_probe",
            ["clang", "--version"],
            ["PWD=/work", "TERM=simple"]).unwrap()
        val image = build_user_process_image(
            launch.path, bytes, Architecture.X86_64, launch.argv, launch.envp)
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()
        expect(built.argv.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(built.argv[0]).to_equal("clang")
        expect(built.argv[1]).to_equal("--version")
        expect(built.envp.len()).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(built.envp[0]).to_equal("PWD=/work")
        expect(built.envp[1]).to_equal("TERM=simple")
        expect(built.initial_stack_bytes.len()).to_be_greater_than(0)

    it "canonicalizes simplebox byte lookup without rewriting requested argv zero":
        val requested = "/bin/cat"
        val canonical_bytes = make_x86_64_exec()
        _clear_synthetic_initramfs_for_test()
        _clear_synthetic_vfs_for_test()
        _set_synthetic_vfs_file_for_test("/bin/simplebox", canonical_bytes)
        val resolved = resolve_executable_bytes(requested, Architecture.X86_64)
        expect(resolved.is_ok()).to_equal(true)

        val launch = executable_launch_arguments_v1_validate(
            requested, [requested, "/tmp/input"], []).unwrap()
        val image = build_user_process_image(
            launch.path, resolved.unwrap(), Architecture.X86_64,
            launch.argv, launch.envp)
        expect(image.is_ok()).to_equal(true)
        val built = image.unwrap()
        expect(built.binary_path).to_equal(requested)
        expect(built.argv[0]).to_equal(requested)
        expect(built.argv[1]).to_equal("/tmp/input")
        _clear_synthetic_vfs_for_test()
