use std.spec.{describe, it, expect}
use os.kernel.loader.web_launch_grants.{
    SIMPLEOS_WEB_EXECUTABLE_V1, SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1,
    SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1, simpleos_web_loopback_address_v1
}
use os.kernel.loader.web_spawn_recipe_v1.{
    WebSpawnRecipeV1, web_spawn_launch_shape_valid_v1, web_spawn_recipe_v1,
    web_spawn_recipe_valid_v1
}
use os.kernel.types.capability_types.{CapabilityKind}

fn _has_kind(recipe: WebSpawnRecipeV1, kind: CapabilityKind) -> bool:
    for grant in recipe.spawn_spec.grants:
        if grant.requested == kind:
            return true
    false

describe("dedicated WEB filesystem spawn recipe"):

    it("binds path argv environment address and exact seven-entry pouch"):
        val address = simpleos_web_loopback_address_v1()
        val recipe = web_spawn_recipe_v1(
            "web-image-hash", SIMPLEOS_WEB_EXECUTABLE_V1,
            [SIMPLEOS_WEB_EXECUTABLE_V1], [], address)
        expect(web_spawn_recipe_valid_v1(recipe)).to_equal(true)
        expect(recipe.argv.len()).to_equal(1)
        expect(recipe.spawn_spec.grants.len()).to_equal(
            SIMPLEOS_WEB_LAUNCH_POUCH_BUDGET_V1)

    it("rejects alias argv ambient environment nonconfigured bind and empty digest"):
        val address = simpleos_web_loopback_address_v1()
        expect(web_spawn_launch_shape_valid_v1(
            "/SERVERS.ELF", [SIMPLEOS_WEB_EXECUTABLE_V1], [], address
        )).to_equal(false)
        expect(web_spawn_launch_shape_valid_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, ["web"], [], address
        )).to_equal(false)
        expect(web_spawn_launch_shape_valid_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1],
            ["PATH=/bin"], address
        )).to_equal(false)
        expect(web_spawn_launch_shape_valid_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1], [], 0u32
        )).to_equal(false)
        expect(web_spawn_launch_shape_valid_v1(
            SIMPLEOS_WEB_EXECUTABLE_V1, [SIMPLEOS_WEB_EXECUTABLE_V1], [],
            SIMPLEOS_WEB_CONFIGURED_BIND_IPV4_V1 + 1u32
        )).to_equal(false)
        expect(web_spawn_recipe_valid_v1(web_spawn_recipe_v1(
            "", SIMPLEOS_WEB_EXECUTABLE_V1,
            [SIMPLEOS_WEB_EXECUTABLE_V1], [], address))).to_equal(false)

    it("contains no server database spawn connect raw or mount authority"):
        val address = simpleos_web_loopback_address_v1()
        val recipe = web_spawn_recipe_v1(
            "web-image-hash", SIMPLEOS_WEB_EXECUTABLE_V1,
            [SIMPLEOS_WEB_EXECUTABLE_V1], [], address)
        expect(_has_kind(recipe, CapabilityKind.ProcessSpawn)).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.NetRaw)).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.NetConnect(port: 8080u16))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.NetConnect(port: 5433u16))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.IpcConnect(
            port_name: "dbfs"))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.Mount(
            path_prefix: "/", rights: 1u32))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.CRT"))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.PK8"))).to_equal(false)
        expect(_has_kind(recipe, CapabilityKind.FileRead(
            path_prefix: "/dbfs/"))).to_equal(false)

    it("detects post-construction recipe authority mutation"):
        val address = simpleos_web_loopback_address_v1()
        var recipe = web_spawn_recipe_v1(
            "web-image-hash", SIMPLEOS_WEB_EXECUTABLE_V1,
            [SIMPLEOS_WEB_EXECUTABLE_V1], [], address)
        recipe.spawn_spec.grants[6] = recipe.spawn_spec.grants[5]
        expect(web_spawn_recipe_valid_v1(recipe)).to_equal(false)
