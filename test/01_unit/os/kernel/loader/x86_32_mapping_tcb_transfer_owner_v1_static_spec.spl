use std.test.*
use std.fs.{file_read}

val MAPPER = "src/os/kernel/loader/x86_32_authenticated_mapping_owner_v1.spl"
val RESERVATIONS = "src/os/kernel/scheduler/x86_32_mapping_adoption_reservation_v1.spl"
val ADOPTION = "src/os/kernel/scheduler/scheduler_x86_32_executable_adoption_v1.spl"

describe "x86-32 mapper-to-TCB transfer static contract":
    it "authenticates the complete scheduler-retained admission handle first":
        val mapper = file_read(MAPPER)
        val reservations = file_read(RESERVATIONS)
        val transfer = mapper.split(
            "pub(package) fn x86_32_authenticated_mapping_transfer_to_tcb_v1")[1]
        expect(transfer.index_of("scheduler_x86_32_adoption_binding_matches_v1(")).to_be_less_than(
            transfer.index_of("mutex_raw_lock(_x86_32_mapping_mutex_v1)"))
        expect(reservations).to_contain("slot.admission_handle")
        expect(reservations).to_contain("left.open_handle_id != right.open_handle_id")
        expect(reservations).to_contain("left.verified_load_ranges.len() != right.verified_load_ranges.len()")
        expect(reservations).to_contain("_x86_32_load_range_equal_v1")

    it "cancels exact abandoned reservations and burns their identities":
        val body = file_read(RESERVATIONS)
        expect(body).to_contain("scheduler_next_task_lifecycle_identity_take_v1()")
        expect(body).to_contain("ticket.generation == slot.generation")
        expect(body).to_contain("ticket.nonce == slot.nonce")
        expect(body).to_contain("scheduler_x86_32_adoption_cancel_v1")
        expect(body).to_contain("SchedulerX8632AdoptionReservationStateV1.Cancelled")
        expect(body).to_contain("identity above is deliberately burned")
        expect(body).not.to_contain("g_scheduler_next_task_id")

    it "quarantines indeterminate unlocks without post-unlock slot mutation":
        val body = file_read(RESERVATIONS)
        val mapper = file_read(MAPPER)
        expect(body).to_contain("_x86_32_adoption_poisoned_v1 = true")
        expect(body).to_contain("whole capsule is now quarantined")
        expect(body).to_contain("_x86_32_adoption_indeterminate_v1(Some(ticket))")
        expect(mapper).to_contain("fn _x86_32_mapping_unlock_v1() -> bool")
        expect(mapper).to_contain("_x86_32_mapping_poisoned_v1 = true")
        expect(mapper.count("mutex_raw_unlock(_x86_32_mapping_mutex_v1)")).to_equal(1)

    it "models committed rejected and indeterminate transfer outcomes":
        val mapper = file_read(MAPPER)
        val dispositions = mapper.split(
            "pub enum X8632MappingTcbTransferDispositionV1:")[1].split(
            "pub struct X8632MappingTransferQuarantineCoordinateV1:")[0]
        expect(dispositions).to_contain("Committed")
        expect(dispositions).to_contain("Rejected")
        expect(dispositions).to_contain("Indeterminate")
        expect(mapper).to_contain("identity: committed.identity")
        expect(mapper).to_contain("quarantine: Some(coordinate)")
        expect(mapper).not.to_contain("activate_cr3")
        expect(mapper).not.to_contain("Scheduler.tasks")

    it "returns a present handle only after scheduler and mapping commit":
        val mapper = file_read(MAPPER)
        val transfer = mapper.split(
            "pub(package) fn x86_32_authenticated_mapping_transfer_to_tcb_v1")[1]
        expect(transfer.index_of("scheduler_x86_32_adoption_commit_v1(")).to_be_less_than(
            transfer.index_of("slot.state = X8632AuthenticatedMappingStateV1.TransferCommitted"))
        val committed = transfer.split(
            "slot.state = X8632AuthenticatedMappingStateV1.TransferCommitted")[1]
        expect(committed.index_of(
            "_x86_32_mapping_slots_v1[receipt.slot_index] = slot")).to_be_less_than(
            committed.index_of("val handle = SchedulerX8632MappingHandleV1"))
        val returned = committed.split(
            "val handle = SchedulerX8632MappingHandleV1")[1]
        expect(returned.index_of("if not _x86_32_mapping_unlock_v1():")).to_be_less_than(
            returned.index_of("X8632MappingTcbTransferResultV1("))
        expect(mapper).to_contain("handle: scheduler_x86_32_mapping_handle_absent_v1()")

    it "binds loader authority and mapping transfer to one lifecycle":
        val body = file_read(ADOPTION)
        val adoption = body.split(
            "pub(package) fn scheduler_x86_32_adopt_authenticated_mapping_v1")[1]
        expect(adoption).to_contain(
            "executable_loader_commit_joint_reservation_v1(")
        expect(adoption).to_contain("executable_loader_retrieve_once(")
        expect(adoption).to_contain(
            "server_data_launch_grant_install_before_publication_v1(")
        expect(adoption).to_contain(
            "x86_32_authenticated_mapping_transfer_to_tcb_v1(")
        expect(adoption).to_contain(
            "committed_identity.lifecycle_generation != identity.lifecycle_generation")
        expect(adoption.index_of(
            "executable_loader_commit_joint_reservation_v1(")).to_be_less_than(
            adoption.index_of("executable_loader_retrieve_once("))
        expect(adoption.index_of(
            "server_data_launch_grant_install_before_publication_v1(")).to_be_less_than(
            adoption.index_of("x86_32_authenticated_mapping_transfer_to_tcb_v1("))
        expect(adoption.index_of(
            "committed_identity.lifecycle_generation != identity.lifecycle_generation")).to_be_less_than(
            adoption.index_of("owner.tasks[task_slot] = task"))

    it "rolls back pre-publication grant state on every transfer rejection":
        val body = file_read(ADOPTION)
        val transfer_failure = body.split(
            "if transferred.disposition != X8632MappingTcbTransferDispositionV1.Committed")[1].split(
            "val committed_identity = transferred.identity.unwrap()")[0]
        expect(transfer_failure).to_contain(
            "scheduler_execution_cancel_adoption_handle_v1(observation_handle)")
        expect(transfer_failure).to_contain(
            "server_data_launch_grant_rollback_before_publication_v1(grant_handle)")
        expect(transfer_failure).to_contain(
            "server_data_launch_grant_quarantine_before_publication_v1(grant_handle)")
        expect(transfer_failure).to_contain(
            "transferred.disposition == X8632MappingTcbTransferDispositionV1.Rejected")
        expect(transfer_failure).to_contain("return _x86_32_adoption_failed_v1")
