use std.spec.{describe, it, expect}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    primary_linux_tool_catalog_required_paths_v1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_DOMAIN_V1,
    PrimaryToolReleaseDescriptorRowV1, PrimaryToolReleaseDescriptorV1}
use os.kernel.loader.primary_tool_release_descriptor_codec_v1.*

fn descriptor_v1() -> PrimaryToolReleaseDescriptorV1:
    val paths = primary_linux_tool_catalog_required_paths_v1()
    var rows: [PrimaryToolReleaseDescriptorRowV1] = []
    var index: i64 = 0
    while index < paths.len():
        rows.push(PrimaryToolReleaseDescriptorRowV1(
            canonical_path: paths[index], payload_sha256: "a" * 64,
            scr1_sha256: "b" * 64))
        index = index + 1
    PrimaryToolReleaseDescriptorV1(
        domain: PRIMARY_TOOL_RELEASE_DESCRIPTOR_DOMAIN_V1,
        target: ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
        release_id: "release-2026-08-25", signer_key_id: "release-root",
        rows: rows, signature: [7u8] * 64)

fn copy_bytes_v1(bytes: [u8]) -> [u8]:
    var copied: [u8] = []
    for byte in bytes: copied.push(byte)
    copied

fn row_count_offset_v1(bytes: [u8]) -> i64:
    var offset: i64 = 8
    var field: i64 = 0
    while field < 6:
        val length = (bytes[offset] & 0xff) |
            ((bytes[offset + 1] & 0xff) << 8) |
            ((bytes[offset + 2] & 0xff) << 16) |
            ((bytes[offset + 3] & 0xff) << 24)
        offset = offset + 4 + length
        field = field + 1
    offset

fn first_payload_hash_offset_v1(bytes: [u8]) -> i64:
    val count_offset = row_count_offset_v1(bytes)
    val path_offset = count_offset + 4
    val path_length = (bytes[path_offset] & 0xff) |
        ((bytes[path_offset + 1] & 0xff) << 8) |
        ((bytes[path_offset + 2] & 0xff) << 16) |
        ((bytes[path_offset + 3] & 0xff) << 24)
    path_offset + 4 + path_length

describe "Primary tool release descriptor codec v1":
    it "canonically round trips the exact five-row descriptor":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        expect(encoded.ok).to_equal(true)
        val decoded = decode_primary_tool_release_descriptor_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.target.arch).to_equal("aarch64")
        expect(decoded.value.rows.len()).to_equal(5)
        expect(decoded.value.rows[0].canonical_path).to_equal(
            descriptor_v1().rows[0].canonical_path)
        expect(decoded.value.rows[4].payload_sha256).to_equal("a" * 64)
        expect(decoded.value.rows[4].scr1_sha256).to_equal("b" * 64)
        expect(decoded.value.signature.len()).to_equal(64)
        expect(decoded.value.signature[63]).to_equal(7)
        val reencoded = encode_primary_tool_release_descriptor_v1(decoded.value)
        expect(reencoded.bytes).to_equal(encoded.bytes)

    it "writes the exact PTRD v1 reserved-zero envelope":
        val bytes = encode_primary_tool_release_descriptor_v1(
            descriptor_v1()).bytes
        expect(bytes[0]).to_equal(80)
        expect(bytes[1]).to_equal(84)
        expect(bytes[2]).to_equal(82)
        expect(bytes[3]).to_equal(68)
        expect(bytes[4]).to_equal(1)
        expect(bytes[5]).to_equal(0)
        expect(bytes[6]).to_equal(0)
        expect(bytes[7]).to_equal(0)

    it "proves the raw 32-byte hash and 64-byte signature layout":
        val descriptor = descriptor_v1()
        val bytes = encode_primary_tool_release_descriptor_v1(descriptor).bytes
        val payload_offset = first_payload_hash_offset_v1(bytes)
        var index: i64 = 0
        while index < 32:
            expect(bytes[payload_offset + index]).to_equal(0xaa)
            expect(bytes[payload_offset + 32 + index]).to_equal(0xbb)
            index = index + 1
        index = 0
        while index < 64:
            expect(bytes[bytes.len() - 64 + index]).to_equal(7)
            index = index + 1
        var expected_length: i64 = 8 + 4
        expected_length = expected_length + 4 + descriptor.domain.len()
        expected_length = expected_length + 4 + descriptor.target.os.len()
        expected_length = expected_length + 4 + descriptor.target.arch.len()
        expected_length = expected_length + 4 + descriptor.target.abi.len()
        expected_length = expected_length + 4 + descriptor.release_id.len()
        expected_length = expected_length + 4 + descriptor.signer_key_id.len()
        for row in descriptor.rows:
            expected_length = expected_length + 4 + row.canonical_path.len() + 32 + 32
        expected_length = expected_length + 64
        expect(bytes.len()).to_equal(expected_length)

    it "rejects wrong magic version and either nonzero reserved byte":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        changed[0] = 81
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[4] = 2
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[6] = 1
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[7] = 1
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)

    it "rejects zero oversized truncated and nonprintable text fields":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        changed[8] = 0
        changed[9] = 0
        changed[10] = 0
        changed[11] = 0
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[8] = 65
        changed[9] = 0
        changed[10] = 0
        changed[11] = 0
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[8] = 255
        changed[9] = 255
        changed[10] = 255
        changed[11] = 127
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[12] = 0x1f
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)

    it "rejects trailing bytes truncation and an oversized envelope":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        var trailing = copy_bytes_v1(encoded.bytes)
        trailing.push(0)
        expect(decode_primary_tool_release_descriptor_v1(trailing).ok).to_equal(false)
        var truncated = copy_bytes_v1(encoded.bytes)
        truncated.pop()
        expect(decode_primary_tool_release_descriptor_v1(truncated).ok).to_equal(false)
        val oversized = [0u8] * (
            PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1 + 1)
        expect(decode_primary_tool_release_descriptor_v1(oversized).ok).to_equal(false)

    it "rejects the wrong exact row count":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        changed[row_count_offset_v1(changed)] = 4
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)

    it "rejects wrong row order and zero digest during canonical decode":
        val original = descriptor_v1()
        var rows = original.rows
        val first = rows[0]
        rows[0] = rows[1]
        rows[1] = first
        val reordered = PrimaryToolReleaseDescriptorV1(
            domain: original.domain, target: original.target,
            release_id: original.release_id,
            signer_key_id: original.signer_key_id, rows: rows,
            signature: original.signature)
        expect(encode_primary_tool_release_descriptor_v1(reordered).ok).to_equal(false)
        rows = descriptor_v1().rows
        val row = rows[2]
        rows[2] = PrimaryToolReleaseDescriptorRowV1(
            canonical_path: row.canonical_path, payload_sha256: "0" * 64,
            scr1_sha256: row.scr1_sha256)
        val zero_digest = PrimaryToolReleaseDescriptorV1(
            domain: original.domain, target: original.target,
            release_id: original.release_id,
            signer_key_id: original.signer_key_id, rows: rows,
            signature: original.signature)
        expect(encode_primary_tool_release_descriptor_v1(zero_digest).ok).to_equal(false)

    it "rejects a raw zero hash region independently of object validation":
        val encoded = encode_primary_tool_release_descriptor_v1(descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        val payload_offset = first_payload_hash_offset_v1(changed)
        var index: i64 = 0
        while index < 32:
            changed[payload_offset + index] = 0
            index = index + 1
        expect(decode_primary_tool_release_descriptor_v1(changed).ok).to_equal(false)
