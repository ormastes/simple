use std.spec.*
use std.fs.{file_read}

val OWNER_PATH = "src/os/kernel/loader/x86_32_authenticated_mapping_owner_v1.spl"

describe "x86-32 authenticated mapping owner static contract":
    it "revalidates authenticated ELF evidence before root creation":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("executable_x86_32_mapping_readiness_v1(handle, authenticated_source)")
        expect(body).to_contain("if not readiness.ready")
        expect(body.index_of("executable_x86_32_mapping_readiness_v1")).to_be_less_than(
            body.index_of("x86_32_user_root_create_v1()"))

    it "maps exact PT_LOAD pages and verifies copied and zero-filled bytes":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("for segment in handle.verified_load_ranges")
        expect(body).to_contain("_x86_32_page_start_v1(segment.virtual_address)")
        expect(body).to_contain("mmio_write8(destination, value)")
        expect(body).to_contain("mmio_read8(destination) != value")
        expect(body).to_contain("mmio_write8(destination, 0u8)")
        expect(body).to_contain("mmio_read8(destination) != 0u8")

    it "reserves capacity for the stack and bounds provenance lookup cost":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("x86_32_authenticated_mapping_max_image_pages_v1() -> u64: 255u64")
        expect(body).to_contain("readiness.planned_pages > x86_32_authenticated_mapping_max_image_pages_v1()")

    it "owns a four-byte initial stack and reports non-PAE permission limits":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("stack_word_bytes: 4u64")
        expect(body).to_contain("word * 4u64")
        expect(body).to_contain("hardware_execute_disable: false")
        expect(body).to_contain("hardware_wx_enforced: false")

    it "retains exact leaves for rollback and quarantine":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("leaves.push(X8632AuthenticatedLeafV1")
        expect(body).to_contain("x86_32_user_unmap_exact_v1(updated.root, leaf.virt, leaf.phys)")
        expect(body).to_contain("ReleaseRetryable")
        expect(body).to_contain("Quarantined")

    it "does not claim scheduler or execution readiness":
        val body = file_read(OWNER_PATH)
        expect(body).to_contain("scheduler_adoption_permitted: false")
        expect(body).to_contain("execution_authorized: false")
        expect(body).to_contain("x86_32_authenticated_mapping_scheduler_ready_v1() -> bool")
        expect(body).to_contain("false")

    it "requires exact PDE and PTE publication readback":
        val root = file_read("src/os/kernel/arch/x86_32/user_page_root_owner_v1.spl")
        expect(root).to_contain("_x86_32_read_entry_v1(slot.root_phys, pd_index) == pd_entry")
        expect(root).to_contain("_x86_32_read_entry_v1(table, pt_index) == pte")
        expect(root).to_contain("X8632LeafDispositionV1.RegisteredQuarantined")
