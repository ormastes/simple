use std.spec.{describe, it, expect}
use os.kernel.loader.arm64_fs_exec_spawn.{arm64_fs_exec_launch_caps_with_launch_v1}
use os.kernel.loader.dbd_launch_grants_v1.{SIMPLEOS_DBD_EXECUTABLE_V1}
use os.kernel.types.capability_types.{CapabilityKind}

describe("ARM64 dedicated DBD launch pouch"):
    it("mints only the DBD recipe pouch for its canonical launch tuple"):
        val caps = arm64_fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1], [], 101u64)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(true)
        expect(caps.has(CapabilityKind.NetSocketCreate)).to_equal(true)
        expect(caps.has(CapabilityKind.NetListen(port: 5433u16))).to_equal(true)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SERVER.HTM"))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 8080u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetConnect(port: 0u16))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)

    it("does not mint the DBD pouch for altered metadata"):
        val caps = arm64_fs_exec_launch_caps_with_launch_v1(
            SIMPLEOS_DBD_EXECUTABLE_V1, [SIMPLEOS_DBD_EXECUTABLE_V1],
            ["PATH=/bin"], 102u64)
        expect(caps.has(CapabilityKind.FileRead(
            path_prefix: "/SYS/SRVDB.KEY"))).to_equal(false)
        expect(caps.has(CapabilityKind.NetListen(port: 0u16))).to_equal(false)
