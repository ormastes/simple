use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.arch.arch_context.{Architecture}
use os.kernel.loader.executable_target_dispatch_v1.{
    executable_target_dispatch_policy_v1,
    executable_target_dispatch_matches_architecture_v1,
    executable_target_dispatch_consumer_matches_v1,
    executable_target_process_image_ready_v1
}

fn _target(arch: text) -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos")

describe "SimpleOS executable target dispatch v1":
    it "binds all six signed target spellings to exact kernel architectures":
        step("Resolve the authenticated six-target mapping policy")
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("x86_64"), Architecture.X86_64)).to_be_true()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("x86"), Architecture.X86)).to_be_true()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("aarch64"), Architecture.Arm64)).to_be_true()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("arm"), Architecture.Arm32)).to_be_true()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("riscv64"), Architecture.Riscv64)).to_be_true()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("riscv32"), Architecture.Riscv32)).to_be_true()

    it "keeps x86 and ARM32 blocked while admitting the complete RV32 path":
        step("Expose exact process-image readiness without treating routing as authority")
        expect(executable_target_dispatch_policy_v1(
            _target("x86")).unwrap().process_image_builder_ready).to_be_false()
        expect(executable_target_dispatch_policy_v1(
            _target("arm")).unwrap().process_image_builder_ready).to_be_false()
        expect(executable_target_dispatch_policy_v1(
            _target("riscv32")).unwrap().process_image_builder_ready).to_be_true()
        expect(executable_target_dispatch_policy_v1(
            _target("x86_64")).unwrap().process_image_builder_ready).to_be_true()
        expect(executable_target_process_image_ready_v1(
            _target("x86"))).to_be_false()
        expect(executable_target_dispatch_consumer_matches_v1(
            "simpleos", "x86", "simpleos", Architecture.X86)).to_be_false()
        expect(executable_target_dispatch_consumer_matches_v1(
            "simpleos", "arm", "simpleos", Architecture.Arm32)).to_be_false()
        expect(executable_target_dispatch_consumer_matches_v1(
            "simpleos", "riscv32", "simpleos", Architecture.Riscv32)).to_be_true()

    it "rejects aliases foreign ABI and architecture substitution":
        step("Fail closed before loader reservation or scheduler publication")
        expect(executable_target_dispatch_policy_v1(_target("arm32"))).to_be_nil()
        expect(executable_target_dispatch_policy_v1(ManifestTarget(
            os: "linux", arch: "x86_64", abi: "sysv"))).to_be_nil()
        expect(executable_target_dispatch_matches_architecture_v1(
            _target("x86_64"), Architecture.Arm64)).to_be_false()
        expect(executable_target_dispatch_consumer_matches_v1(
            "simpleos", "riscv32", "simpleos", Architecture.Riscv64)).to_be_false()
