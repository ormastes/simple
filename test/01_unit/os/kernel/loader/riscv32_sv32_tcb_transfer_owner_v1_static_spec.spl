use std.test.*
use std.fs.{file_read}

describe "RV32 mapper-to-TCB ownership transfer static contract":
    it "returns only an opaque locator after exact pin and entry validation":
        val mapper = file_read("src/os/kernel/loader/riscv32_sv32_mapping_owner_v1.spl")
        val registry = file_read("src/os/kernel/loader/executable_authority_registry.spl")
        val handle = file_read("src/os/kernel/types/riscv32_mapping_handle_v1.spl")
        expect(mapper).to_contain("riscv32_sv32_mapping_transfer_to_tcb_v1")
        expect(mapper).to_contain("slot.root.root_id, slot.root.generation")
        expect(mapper).to_contain("slot.entry_point != entry_point")
        expect(mapper).to_contain("slot.initial_stack_pointer != initial_stack_pointer")
        expect(registry).to_contain("executable_authority_validate_riscv32_mapping_adoption_v1")
        expect(registry).to_contain("ExecutableRiscv32MappingPinStateV1.Installed")
        expect(handle).not.to_contain("root")
        expect(handle).not.to_contain("entry_point")
        expect(handle).not.to_contain("stack")

    it "consumes the canonical receipt and retains indeterminate coordinates":
        val mapper = file_read("src/os/kernel/loader/riscv32_sv32_mapping_owner_v1.spl")
        expect(mapper).to_contain("Riscv32Sv32TcbTransferDispositionV1")
        expect(mapper).to_contain("TransferCommitted")
        expect(mapper).to_contain("TransferIndeterminate")
        expect(mapper).to_contain("task_lifecycle_generation")
        expect(mapper).to_contain("slot.task_id = task_id")
        expect(mapper).to_contain("slot.task_lifecycle_generation = task_lifecycle_generation")
        expect(mapper).to_contain("quarantine: Some(coordinate)")
        expect(mapper).to_contain("handle: scheduler_riscv32_mapping_handle_absent_v1()")
        expect(mapper).to_contain("_rv32_mapping_poisoned_v1 = true")
        expect(mapper).to_contain("return _rv32_transfer_indeterminate_v1(nil)")
        expect(mapper).not.to_contain("_rv32_transfer_coordinate_from_receipt_v1")
        expect(mapper).to_contain("slot.state = Riscv32Sv32MappingStateV1.TransferCommitted")
        expect(mapper).to_contain("slot.state = Riscv32Sv32MappingStateV1.TransferIndeterminate")
        expect(mapper).to_contain("receipt.state == slot.state")
        expect(mapper).not.to_contain("activate_satp")
        expect(mapper).not.to_contain("Scheduler.tasks")
