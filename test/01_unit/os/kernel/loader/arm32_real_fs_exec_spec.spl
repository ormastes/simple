# @cover src/os/kernel/loader/arm32_real_exec_payload.spl 80%
use std.spec.*
use os.kernel.loader.arm32_real_exec_payload.*

describe "ARM32 real filesystem execution payload":
    it "simulates nonce-bound target stdout and exit 37":
        val nonce = "arm32-real-exec-0001"
        val elf = arm32_real_exec_elf(nonce)
        val simulated = arm32_simulate_real_exec_elf(elf)
        expect(simulated.valid).to_equal(true)
        expect(simulated.stdout).to_equal(arm32_real_exec_stdout(nonce))
        expect(simulated.exit_code).to_equal(37)

    it "emits an ARM EABI ELF32 executable with SVC instructions":
        val elf = arm32_real_exec_elf("arm32-real-exec-0002")
        expect(elf[4]).to_equal(1)
        expect(elf[18]).to_equal(40)
        expect(elf[19]).to_equal(0)
        expect(elf[0x108]).to_equal(0)
        expect(elf[0x10b]).to_equal(0xef)

    it "rejects a mutated mounted SVC instruction":
        val nonce = "arm32-real-exec-0003"
        var elf = arm32_real_exec_elf(nonce)
        elf[0x10b] = 0
        val admission = arm32_admit_mounted_real_exec(elf, nonce)
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.reason).to_equal("arm32-real-exec-mounted-bytes-mismatch")

    it "admits exact payload bytes but blocks missing user SVC return":
        val nonce = "arm32-real-exec-0004"
        val admission = arm32_admit_mounted_real_exec(arm32_real_exec_elf(nonce), nonce)
        expect(admission.payload_accepted).to_equal(true)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-95)
        expect(admission.reason).to_equal("arm32-user-cpsr-svc-return-not-installed")

    it "rejects a nonce outside the bounded printable contract":
        val admission = arm32_admit_mounted_real_exec([], "short")
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-22)
        expect(admission.reason).to_equal("arm32-real-exec-invalid-nonce")

    it "rejects exact valid bytes authenticated for another nonce":
        val mounted = arm32_real_exec_elf("arm32-real-exec-owner-a")
        val admission = arm32_admit_mounted_real_exec(mounted, "arm32-real-exec-owner-b")
        expect(admission.payload_accepted).to_equal(false)
        expect(admission.live_executable).to_equal(false)
        expect(admission.status).to_equal(-13)
        expect(admission.reason).to_equal("arm32-real-exec-mounted-bytes-mismatch")
