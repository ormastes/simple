use std.spec.{describe, it, expect}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    clang_sysroot_catalog_required_paths_v1}
use os.kernel.loader.clang_catalog_release_descriptor_v1.{
    CLANG_CATALOG_RELEASE_DESCRIPTOR_DOMAIN_V1,
    ClangCatalogReleaseDescriptorRowV1, ClangCatalogReleaseDescriptorV1}
use os.kernel.loader.clang_catalog_release_descriptor_codec_v1.{
    CLANG_CATALOG_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
    encode_clang_catalog_release_descriptor_v1,
    decode_clang_catalog_release_descriptor_v1}

fn codec_descriptor_v1() -> ClangCatalogReleaseDescriptorV1:
    val paths = clang_sysroot_catalog_required_paths_v1()
    var rows: [ClangCatalogReleaseDescriptorRowV1] = []
    var index: i64 = 0
    while index < paths.len():
        rows.push(ClangCatalogReleaseDescriptorRowV1(
            canonical_path: paths[index], payload_sha256: "a" * 64,
            scr1_sha256: "b" * 64))
        index = index + 1
    ClangCatalogReleaseDescriptorV1(
        domain: CLANG_CATALOG_RELEASE_DESCRIPTOR_DOMAIN_V1,
        target: ManifestTarget(os: "simpleos", arch: "aarch64", abi: "simpleos"),
        release_id: "release-2026-08-25", signer_key_id: "release-root",
        rows: rows, signature: [7] * 64)

fn copy_bytes_v1(bytes: [u8]) -> [u8]:
    var copied: [u8] = []
    var index: i64 = 0
    while index < bytes.len():
        copied.push(bytes[index])
        index = index + 1
    copied

describe "Clang catalog release descriptor codec v1":
    it "round trips the exact nine-row descriptor without verifying trust":
        val encoded = encode_clang_catalog_release_descriptor_v1(
            codec_descriptor_v1())
        expect(encoded.ok).to_equal(true)
        val decoded = decode_clang_catalog_release_descriptor_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(decoded.value.target.arch).to_equal("aarch64")
        expect(decoded.value.rows.len()).to_equal(9)
        expect(decoded.value.signature.len()).to_equal(64)
        expect(decoded.value.rows[0].canonical_path).to_equal(
            codec_descriptor_v1().rows[0].canonical_path)
        expect(decoded.value.rows[8].payload_sha256).to_equal("a" * 64)
        expect(decoded.value.rows[8].scr1_sha256).to_equal("b" * 64)
        expect(decoded.value.signature[0]).to_equal(7)
        expect(decoded.value.signature[63]).to_equal(7)

    it "writes the exact CCRD v1 reserved-zero envelope":
        val encoded = encode_clang_catalog_release_descriptor_v1(
            codec_descriptor_v1())
        expect(encoded.bytes[0]).to_equal(67)
        expect(encoded.bytes[1]).to_equal(67)
        expect(encoded.bytes[2]).to_equal(82)
        expect(encoded.bytes[3]).to_equal(68)
        expect(encoded.bytes[4]).to_equal(1)
        expect(encoded.bytes[5]).to_equal(0)
        expect(encoded.bytes[6]).to_equal(0)
        expect(encoded.bytes[7]).to_equal(0)

    it "rejects a nonzero reserved envelope field":
        val encoded = encode_clang_catalog_release_descriptor_v1(
            codec_descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        changed[6] = 1
        expect(decode_clang_catalog_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[7] = 1
        expect(decode_clang_catalog_release_descriptor_v1(changed).ok).to_equal(false)
        changed = copy_bytes_v1(encoded.bytes)
        changed[4] = 2
        expect(decode_clang_catalog_release_descriptor_v1(changed).ok).to_equal(false)

    it "rejects truncation trailing bytes and non ASCII text":
        val encoded = encode_clang_catalog_release_descriptor_v1(
            codec_descriptor_v1())
        var truncated = copy_bytes_v1(encoded.bytes)
        truncated.pop()
        expect(decode_clang_catalog_release_descriptor_v1(truncated).ok).to_equal(false)
        var trailing = copy_bytes_v1(encoded.bytes)
        trailing.push(0)
        expect(decode_clang_catalog_release_descriptor_v1(trailing).ok).to_equal(false)
        var non_ascii = copy_bytes_v1(encoded.bytes)
        non_ascii[12] = 0x80
        expect(decode_clang_catalog_release_descriptor_v1(non_ascii).ok).to_equal(false)

    it "rejects an oversized envelope before decoding fields":
        val oversized = [0] * (
            CLANG_CATALOG_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1 + 1)
        expect(decode_clang_catalog_release_descriptor_v1(oversized).ok).to_equal(false)

    it "rejects the wrong exact row count":
        val encoded = encode_clang_catalog_release_descriptor_v1(
            codec_descriptor_v1())
        var changed = copy_bytes_v1(encoded.bytes)
        # Six length-prefixed identity fields begin after the eight-byte envelope.
        var offset: i64 = 8
        var field: i64 = 0
        while field < 6:
            val length = (changed[offset] & 0xff) |
                ((changed[offset + 1] & 0xff) << 8) |
                ((changed[offset + 2] & 0xff) << 16) |
                ((changed[offset + 3] & 0xff) << 24)
            offset = offset + 4 + length
            field = field + 1
        changed[offset] = 8
        expect(decode_clang_catalog_release_descriptor_v1(changed).ok).to_equal(false)
