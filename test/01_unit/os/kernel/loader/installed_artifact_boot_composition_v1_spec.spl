"""Focused pure merge and one-shot seal contracts for boot composition v1."""

use std.spec.*
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest}
use std.common.crypto.ed25519.{
    pure_ed25519_keypair_from_seed, pure_ed25519_sign}
use std.common.crypto.sha256.{sha256_u8_hex}
use std.common.structural.execution.simple_artifact_manifest_v1_codec.{
    encode_simple_artifact_manifest_v1_signing_bytes}
use std.crypto.types.{bytes_to_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1}
use os.kernel.loader.installed_artifact_catalog_v1.{
    SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1,
    InstalledArtifactCatalogLifecycleV1, installed_artifact_catalog_status_v1}
use os.kernel.loader.simplebox_primary_tool_catalog_bundle_v1.{
    simplebox_primary_tool_catalog_bundle_plan_v1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    primary_linux_tool_catalog_plan_v1,
    primary_linux_tool_catalog_required_paths_v1}
use os.kernel.loader.clang_sysroot_catalog_bundle_v1.{
    clang_sysroot_catalog_bundle_v1, clang_sysroot_catalog_required_paths_v1}
use os.installer.simplebox_signed_catalog_provisioner_v1.{
    SimpleboxSignedCatalogProvisionErrorV1,
    SimpleboxSafeArtifactBindingReceiptV1,
    SimpleboxSignedCatalogProvisionResultV1}
use os.tools.simplebox.simplebox_artifact_contract.{
    SIMPLEBOX_CANONICAL_PATH_V1, simplebox_canonical_aliases_v1}
use os.kernel.loader.installed_artifact_boot_composition_v1.*

fn hex_v1(bytes: [u8]) -> text:
    var values: [i64] = []
    for byte in bytes: values.push(byte as i64)
    bytes_to_hex(values)

fn target_v1(arch: text = "riscv64") -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos")

fn root_v1(seed_byte: u8 = 41u8) -> ExecutableManifestTrustedSignerV1:
    ExecutableManifestTrustedSignerV1(
        key_id: "composition-root",
        public_key: pure_ed25519_keypair_from_seed([seed_byte; 32]).1)

fn manifest_v1(
    path: text, digest: text, signature: text,
    target: ManifestTarget = target_v1()
) -> SimpleArtifactManifest:
    SimpleArtifactManifest(
        format_version: 1, artifact_kind: "native-executable",
        target: target, entrypoint: path,
        required_abi_features: [], required_services: [],
        required_capabilities: 0u32,
        resource_limits: ManifestResourceLimits(
            max_memory_bytes: 1048576, max_open_handles: 8,
            max_threads: 1, cpu_budget_us: 0),
        namespace_template: "composition", native_libraries: [],
        smf_libraries: [], interpreter: "", argument_schema: [],
        startup_preloads: [], content_hashes: [digest], signature: signature,
        debug_identity: path)

fn record_v1(
    path: text, aliases: [text] = [], salt: text = "",
    target: ManifestTarget = target_v1()
) -> InstalledArtifactBootRecordV1:
    val digest = sha256_u8_hex((path + salt).bytes())
    val placeholder = "ed25519:composition-root:" + "0" * 128
    val body = encode_simple_artifact_manifest_v1_signing_bytes(
        manifest_v1(path, digest, placeholder, target), digest).bytes
    val public_key = root_v1().public_key
    val signature = "ed25519:composition-root:" + hex_v1(
        pure_ed25519_sign([41u8; 32], public_key, body))
    InstalledArtifactBootRecordV1(
        canonical_path: path, aliases: aliases, content_sha256: digest,
        detached_signature: signature,
        expected_trust_root_sha256: sha256_u8_hex(public_key),
        manifest: manifest_v1(path, digest, signature, target))

fn records_v1(paths: [text]) -> [InstalledArtifactBootRecordV1]:
    var records: [InstalledArtifactBootRecordV1] = []
    for path in paths:
        val aliases = if path == SIMPLEBOX_CANONICAL_PATH_V1:
            simplebox_canonical_aliases_v1()
        else:
            []
        records.push(record_v1(path, aliases))
    records

fn legacy_v1() -> SimpleboxSignedCatalogProvisionResultV1:
    val plan = simplebox_primary_tool_catalog_bundle_plan_v1(
        target_v1(), [root_v1()],
        [record_v1(SIMPLEBOX_CANONICAL_PATH_V1,
            simplebox_canonical_aliases_v1())])
    SimpleboxSignedCatalogProvisionResultV1(
        ok: true, error: SimpleboxSignedCatalogProvisionErrorV1.None,
        receipt: SimpleboxSafeArtifactBindingReceiptV1(
            artifact_relative_path: "simplebox", artifact_sha256: "1" * 64,
            artifact_byte_count: 1, signed_record_relative_path: "simplebox.scr1",
            signed_record_sha256: "2" * 64, sam1_identity_sha256: "3" * 64),
        plan: plan)

describe "Installed artifact boot composition v1":
    it "preserves the two-argument composition contract":
        val clang = clang_sysroot_catalog_bundle_v1(
            target_v1(), [root_v1()],
            records_v1(clang_sysroot_catalog_required_paths_v1()))
        val result = installed_artifact_boot_composition_validate_v1(
            Some(legacy_v1()), Some(clang))
        expect(result.ok).to_equal(true)
        expect(result.accepted_records).to_equal(10)

    it "accepts a primary-only staged plan without mutating the catalog":
        val primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1()],
            records_v1(primary_linux_tool_catalog_required_paths_v1()))
        val result = installed_artifact_boot_composition_validate_v1(
            nil, nil, Some(primary))
        expect(result.ok).to_equal(true)
        expect(result.accepted_records).to_equal(5)
        expect(installed_artifact_catalog_status_v1().unwrap().lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)

    it "deduplicates only the exact three-way simplebox overlap":
        val clang = clang_sysroot_catalog_bundle_v1(
            target_v1(), [root_v1()],
            records_v1(clang_sysroot_catalog_required_paths_v1()))
        val primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1()],
            records_v1(primary_linux_tool_catalog_required_paths_v1()))
        val result = installed_artifact_boot_composition_validate_v1(
            Some(legacy_v1()), Some(clang), Some(primary))
        expect(result.ok).to_equal(true)
        expect(result.accepted_records).to_equal(14)

    it "diagnoses a non-identical simplebox overlap before mutation":
        var primary_records = records_v1(
            primary_linux_tool_catalog_required_paths_v1())
        primary_records[0] = record_v1(
            SIMPLEBOX_CANONICAL_PATH_V1, simplebox_canonical_aliases_v1(),
            "different-payload")
        val primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1()], primary_records)
        val result = installed_artifact_boot_composition_validate_v1(
            Some(legacy_v1()), nil, Some(primary))
        expect(result.error).to_equal(
            InstalledArtifactBootCompositionErrorV1.DuplicateRecordConflict)
        expect(installed_artifact_catalog_status_v1().unwrap().lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)

    it "compares every overlapping record field structurally":
        val base = record_v1(
            SIMPLEBOX_CANONICAL_PATH_V1, simplebox_canonical_aliases_v1())
        var changed = base
        changed.aliases = ["/bin/not-simplebox"]
        expect(installed_artifact_boot_records_identical_v1(base, changed)).to_equal(false)
        changed = base
        changed.content_sha256 = "f" * 64
        expect(installed_artifact_boot_records_identical_v1(base, changed)).to_equal(false)
        changed = base
        changed.detached_signature = "ed25519:composition-root:" + "f" * 128
        expect(installed_artifact_boot_records_identical_v1(base, changed)).to_equal(false)
        changed = base
        changed.expected_trust_root_sha256 = "e" * 64
        expect(installed_artifact_boot_records_identical_v1(base, changed)).to_equal(false)
        changed = base
        changed.manifest.debug_identity = "different"
        expect(installed_artifact_boot_records_identical_v1(base, changed)).to_equal(false)

    it "reports target and ordered-root mismatches before mutation":
        var foreign_records: [InstalledArtifactBootRecordV1] = []
        for path in primary_linux_tool_catalog_required_paths_v1():
            val aliases = if path == SIMPLEBOX_CANONICAL_PATH_V1:
                simplebox_canonical_aliases_v1()
            else:
                []
            foreign_records.push(record_v1(
                path, aliases, "", target_v1("aarch64")))
        val wrong_target = primary_linux_tool_catalog_plan_v1(
            target_v1("aarch64"), [root_v1()],
            foreign_records)
        expect(installed_artifact_boot_composition_validate_v1(
            Some(legacy_v1()), nil, Some(wrong_target)).error).to_equal(
                InstalledArtifactBootCompositionErrorV1.TargetMismatch)
        val primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1(42u8)],
            records_v1(primary_linux_tool_catalog_required_paths_v1()))
        expect(installed_artifact_boot_composition_validate_v1(
            Some(legacy_v1()), nil, Some(primary)).error).to_equal(
                InstalledArtifactBootCompositionErrorV1.TrustRootsMismatch)
        expect(installed_artifact_catalog_status_v1().unwrap().lifecycle).to_equal(
            InstalledArtifactCatalogLifecycleV1.Uninitialized)

    it "reports rejected primary input with its dedicated diagnostic":
        var primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1()],
            records_v1(primary_linux_tool_catalog_required_paths_v1()))
        primary.ok = false
        val result = installed_artifact_boot_composition_validate_v1(
            nil, nil, Some(primary))
        expect(result.ok).to_equal(false)
        expect(result.error).to_equal(
            InstalledArtifactBootCompositionErrorV1.PrimaryRejected)
        expect(result.accepted_records).to_equal(0)

    it "diagnoses duplicate canonical and alias keys":
        val first = record_v1("/usr/bin/one")
        val duplicate = record_v1("/usr/bin/one", [], "other")
        expect(installed_artifact_boot_composition_records_conflict_v1(
            [first, duplicate])).to_equal(true)
        val aliased = record_v1("/usr/bin/two", ["/usr/bin/one"])
        expect(installed_artifact_boot_composition_records_conflict_v1(
            [first, aliased])).to_equal(true)

    it "diagnoses duplicate aliases within one record":
        val duplicated_alias = record_v1(
            "/usr/bin/one", ["/bin/shared", "/bin/shared"])
        expect(installed_artifact_boot_composition_records_conflict_v1(
            [duplicated_alias])).to_equal(true)

    it "diagnoses alias collisions across records":
        val first = record_v1("/usr/bin/one", ["/bin/shared"])
        val second = record_v1("/usr/bin/two", ["/bin/shared"])
        expect(installed_artifact_boot_composition_records_conflict_v1(
            [first, second])).to_equal(true)

    it "uses the authoritative same-target record bound":
        expect(installed_artifact_boot_composition_count_within_bound_v1(
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1,
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1)).to_equal(true)
        expect(installed_artifact_boot_composition_count_within_bound_v1(
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1 + 1,
            SIMPLEOS_INSTALLED_ARTIFACT_LIMIT_PER_TARGET_V1)).to_equal(false)

    it "populates and seals exactly once after all preflight checks pass":
        val primary = primary_linux_tool_catalog_plan_v1(
            target_v1(), [root_v1()],
            records_v1(primary_linux_tool_catalog_required_paths_v1()))
        val result = installed_artifact_boot_compose_and_populate_v1(
            nil, nil, Some(primary))
        expect(result.ok).to_equal(true)
        expect(result.accepted_records).to_equal(5)
        val status = installed_artifact_catalog_status_v1().unwrap()
        expect(status.lifecycle).to_equal(InstalledArtifactCatalogLifecycleV1.Sealed)
        expect(status.artifact_count).to_equal(5)
