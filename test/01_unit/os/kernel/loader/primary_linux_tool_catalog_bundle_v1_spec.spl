use std.spec
use std.common.contracts.execution.simpleos_executable_v1.{
    ManifestTarget, ManifestResourceLimits, SimpleArtifactManifest
}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1
}
use os.kernel.loader.installed_artifact_catalog_boot_owner_v1.{
    InstalledArtifactBootRecordV1
}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1, PRIMARY_LINUX_TOOL_COMMAND_COUNT_V1,
    PrimaryLinuxToolCatalogPlanErrorV1,
    primary_linux_tool_launch_matrix_v1,
    primary_linux_tool_catalog_plan_v1,
    primary_linux_tool_catalog_plan_valid_v1
}
use os.tools.simplebox.simplebox_artifact_contract.{
    simplebox_canonical_aliases_v1
}

fn target(arch: text) -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: arch, abi: "simpleos")

fn roots() -> [ExecutableManifestTrustedSignerV1]:
    [ExecutableManifestTrustedSignerV1(
        key_id: "primary-tools-key", public_key: [4u8] * 32)]

fn record(path: text, aliases: [text], arch: text) -> InstalledArtifactBootRecordV1:
    val signature = "ed25519:primary-tools-key:" + "2" * 128
    InstalledArtifactBootRecordV1(
        canonical_path: path, aliases: aliases, content_sha256: "1" * 64,
        detached_signature: signature, expected_trust_root_sha256: "3" * 64,
        manifest: SimpleArtifactManifest(
            format_version: 1, artifact_kind: "elf", target: target(arch),
            entrypoint: path, required_abi_features: [], required_services: [],
            required_capabilities: 0u32,
            resource_limits: ManifestResourceLimits(
                max_memory_bytes: 0, max_open_handles: 0,
                max_threads: 0, cpu_budget_us: 0),
            namespace_template: "", native_libraries: [], smf_libraries: [],
            interpreter: "", argument_schema: [], startup_preloads: [],
            content_hashes: ["1" * 64], signature: signature,
            debug_identity: ""))

fn records(arch: text) -> [InstalledArtifactBootRecordV1]:
    [
        record("/usr/bin/ps", [], arch),
        record("/bin/simplebox", simplebox_canonical_aliases_v1(), arch),
        record("/usr/bin/grep", [], arch),
        record("/usr/bin/md5sum", [], arch),
        record("/usr/bin/sha256sum", [], arch),
    ]

describe "primary Linux-tool catalog bundle v1":
    it "binds the twelve routed primary commands to five payloads in stable order":
        val rows = primary_linux_tool_launch_matrix_v1(target("x86_64"))
        expect(rows.len()).to_equal(PRIMARY_LINUX_TOOL_COMMAND_COUNT_V1)
        expect(PRIMARY_LINUX_TOOL_PAYLOAD_COUNT_V1).to_equal(5)
        expect([for row in rows: row.command]).to_equal([
            "echo", "true", "false", "pwd", "seq", "cat", "head", "wc",
            "sha256sum", "md5sum", "grep", "ps",
        ])
        expect(rows[0].canonical_payload_path).to_equal("/bin/simplebox")
        expect(rows[0].authenticated_catalog_alias).to_be(true)
        expect(rows[7].command_path).to_equal("/bin/wc")
        expect(rows[7].authenticated_catalog_alias).to_be(true)
        expect(rows[8].command).to_equal("sha256sum")
        expect(rows[8].authenticated_catalog_alias).to_be(false)
        expect(rows[11].command).to_equal("ps")
        expect(rows[11].canonical_payload_path).to_equal("/usr/bin/ps")

    it "binds filesystem applets and standalone tools to least authority":
        val rows = primary_linux_tool_launch_matrix_v1(target("x86_64"))
        expect(rows[0].required_capabilities).to_equal(
            ["file-exec:/bin/simplebox"])
        expect(rows[5].command).to_equal("cat")
        expect(rows[5].required_capabilities).to_equal([
            "file-exec:/bin/simplebox", "file-read:argument-paths",
        ])
        expect(rows[11].required_capabilities).to_equal([
            "file-exec:/usr/bin/ps", "process-snapshot:read",
        ])

    it "reports only canonical 64-bit targets mapping-ready":
        expect(primary_linux_tool_launch_matrix_v1(
            target("aarch64"))[0].mapping_ready).to_be(true)
        expect(primary_linux_tool_launch_matrix_v1(
            target("riscv64"))[7].mapping_ready).to_be(true)
        expect(primary_linux_tool_launch_matrix_v1(
            target("x86"))[0].mapping_ready).to_be(false)
        expect(primary_linux_tool_launch_matrix_v1(
            target("arm"))[0].mapping_ready).to_be(false)
        expect(primary_linux_tool_launch_matrix_v1(
            target("riscv32"))[0].mapping_ready).to_be(false)

    it "normalizes complete signed candidates to canonical payload order":
        val plan = primary_linux_tool_catalog_plan_v1(
            target("x86_64"), roots(), records("x86_64"))
        expect(plan.ok).to_be(true)
        expect(plan.records.len()).to_equal(5)
        expect(plan.records[0].canonical_path).to_equal("/bin/simplebox")
        expect(plan.records[4].canonical_path).to_equal("/usr/bin/ps")
        expect(primary_linux_tool_catalog_plan_valid_v1(plan)).to_be(true)

    it "rejects fabricated alias payloads and cross-target records":
        var bad_aliases = records("aarch64")
        bad_aliases[2].aliases = ["/bin/search"]
        val alias_plan = primary_linux_tool_catalog_plan_v1(
            target("aarch64"), roots(), bad_aliases)
        expect(alias_plan.error).to_equal(
            PrimaryLinuxToolCatalogPlanErrorV1.AliasIdentityMismatch)

        var wrong_target = records("riscv64")
        wrong_target[4] = record("/usr/bin/sha256sum", [], "x86_64")
        val target_plan = primary_linux_tool_catalog_plan_v1(
            target("riscv64"), roots(), wrong_target)
        expect(target_plan.error).to_equal(
            PrimaryLinuxToolCatalogPlanErrorV1.SignedRecordShapeInvalid)

    it "rejects post-plan identity mutation before population":
        var plan = primary_linux_tool_catalog_plan_v1(
            target("x86_64"), roots(), records("x86_64"))
        plan.records[0].aliases = ["/bin/echo"]
        expect(primary_linux_tool_catalog_plan_valid_v1(plan)).to_be(false)
