use std.spec.{describe, it, expect}

describe("x86_64 and RV64 startup-evidence runtime lifecycle"):
    it("binds the shared effective pouch before handoff and resets afterward"):
        val x86 = file_read("src/os/kernel/loader/x86_64_fs_exec_spawn.spl")
        val rv = file_read("src/os/kernel/loader/riscv64_fs_exec_spawn.spl")
        for source in [x86, rv]:
            expect(source).to_contain("launch_ipc.cap_manager.init_task(child, prepared.effective_caps)")
            expect(source).to_contain("shim_server_startup_runtime_owner_enable_v1()")
            expect(source).to_contain("shim_server_startup_runtime_owner_disable_v1()")
            expect(source).to_contain("Scheduler.new_bootstrap()")
        val common = file_read("src/os/kernel/loader/fs_exec_spawn.spl")
        expect(common).to_contain("effective_caps: capability_set_bind_owner(caps, adopted.pid)")
        expect(common).to_contain("capability_set_bind_owner(caps, adopted.pid)")
