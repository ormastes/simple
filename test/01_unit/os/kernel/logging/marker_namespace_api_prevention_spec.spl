"""
# Kernel Log Markers Namespace & Parse Prevention Spec

Prevention coverage for `markers_module_unparseable_and_spec_drift_2026-07-28`:
ensures `os.kernel.log.markers` remains parseable/importable, exports
`NAMESPACE_BOOT` and all `MarkerNamespace` variants, formats exact wire
prefixes via `namespace_prefix` / `marker_string`, and returns `Result` values
from `validate` without runtime class errors.
"""

use std.spec.*
use os.kernel.log.markers.{
    MarkerNamespace,
    NAMESPACE_BOOT,
    namespace_prefix,
    marker_string,
    find_spec,
    validate
}

describe "os.kernel.log.markers namespace API and wire prefixes":
    """Verifies NAMESPACE_BOOT identity and all six canonical namespace prefixes."""

    it "maps NAMESPACE_BOOT and all MarkerNamespace variants to expected wire prefixes":
        expect(NAMESPACE_BOOT).to_equal(MarkerNamespace.Boot)
        expect(namespace_prefix(NAMESPACE_BOOT)).to_equal("[BOOT]")
        expect(namespace_prefix(MarkerNamespace.DesktopE2E)).to_equal("[desktop-e2e]")
        expect(namespace_prefix(MarkerNamespace.Vfs)).to_equal("[vfs]")
        expect(namespace_prefix(MarkerNamespace.Pack)).to_equal("[pack]")
        expect(namespace_prefix(MarkerNamespace.NativeVerify)).to_equal("[native-verify]")
        expect(namespace_prefix(MarkerNamespace.Launcher)).to_equal("[launcher]")

    it "formats marker strings and resolves registered specs via find_spec":
        val boot_entry = marker_string(NAMESPACE_BOOT, "entry")
        expect(boot_entry).to_equal("[BOOT] entry")
        expect(find_spec(boot_entry).?).to_equal(true)
        expect(find_spec("[BOOT] entry extra_kv=1").?).to_equal(true)
        expect(find_spec("[unknown] missing").?).to_equal(false)

describe "os.kernel.log.markers Result-based validate contract":
    """Verifies validate returns Ok/Err cleanly without nil/Result drift."""

    it "accepts valid boot markers and rejects unregistered or level-prefixed lines":
        expect(validate("[BOOT] entry").is_ok()).to_equal(true)
        expect(validate("INFO [BOOT] entry").is_err()).to_equal(true)
        expect(validate("[vfs] nonexistent_event").is_err()).to_equal(true)
