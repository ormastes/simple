# Marker attrs_schema Validation Spec (reproducing)
#
# markers.validate() documents itself as "check a raw marker against registry +
# attrs_schema", but its body only calls find_spec() and returns Ok(()). Every
# registry entry that declares required kv attribute keys is therefore
# unenforced: a marker line missing all of its declared attributes validates as
# Ok. That is a silent wrong result — the harness believes it saw a complete,
# well-formed marker.
#
# Bug: doc/08_tracking/bug/markers_module_unparseable_and_spec_drift_2026-07-28.md
#
# @platform: hosted
# @tag: os,log,markers,unit

use os.kernel.log.markers.{validate}

describe "markers.validate enforces declared attrs_schema":
    """`[vfs] mounted` declares attrs_schema ["device", "volume"]. A raw line
    carrying neither key is not a valid marker and must be rejected."""

    it "rejects '[vfs] mounted' with no attributes at all":
        val result = validate("[vfs] mounted")
        expect(result.is_ok()).to_equal(false)

    it "rejects '[vfs] mounted' carrying only one of two declared keys":
        val result = validate("[vfs] mounted device=vda")
        expect(result.is_ok()).to_equal(false)

    it "accepts '[vfs] mounted' with both declared keys present":
        val result = validate("[vfs] mounted device=vda volume=ESP")
        expect(result.is_ok()).to_equal(true)

    it "still accepts a marker whose attrs_schema is empty":
        val result = validate("[BOOT] entry")
        expect(result.is_ok()).to_equal(true)
