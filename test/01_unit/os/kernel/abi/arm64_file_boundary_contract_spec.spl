# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}
use os.kernel.ipc.syscall_file.{cwd_set, path_resolve}
use os.kernel.fd_table.{

    fd_table_init, fd_activate_task, fd_set, fd_close, fd_is_valid,
    FD_TYPE_FAT32, O_RDONLY
}

fn _path_bytes(path: text) -> [u8]:
    var bytes: [u8] = []
    var i: u64 = 0
    while i < path.len():
        bytes.push(path.byte_at(i))
        i = i + 1
    bytes

fn _path_text(bytes: [u8]) -> text:
    var path = ""
    var i: u64 = 0
    while i < bytes.len():
        path = path + bytes[i].chr()
        i = i + 1
    path

describe "ARM64 file syscall boundary":
    # @manual scenario evidence
    it "canonicalizes traversal against the caller cwd before authorization":
        # @req REQ-SSPEC-OS
        step("canonicalizes traversal against the caller cwd before authorization")
        expect(cwd_set(901u64, _path_bytes("/SERVER.SDN"))).to_equal(true)
        val escaped = path_resolve(901u64, _path_bytes("../UNGRANTED"))
        expect(_path_text(escaped)).to_equal("/UNGRANTED")

        val syscall = file_read("src/os/kernel/ipc/syscall_file.spl")
        val open_body = syscall.split("fn _handle_file_open")[1].split("fn _handle_file_read")[0]
        expect(open_body).to_contain("path_resolve(current.id, raw)")
        expect(open_body).to_contain("check_file_access(")
        expect(open_body.split("_fs_copy_user_bytes").len()).to_equal(2)

        val shim = file_read("src/os/kernel/abi/syscall_shim_file.spl")
        expect(shim.contains("user_copyin_bytes")).to_equal(false)
        expect(shim).to_contain("case 30: true")

    it "authorizes exact-path open and rename after one kernel copy":
        val dispatch = file_read("src/os/kernel/ipc/syscall.spl")
        val open_case = dispatch.split("case 30:")[1].split("case 31:")[0]
        val rename_case = dispatch.split("case 44:")[1].split("case 45:")[0]
        expect(open_case.contains("FileRead(path_prefix: \"\")")).to_equal(false)
        expect(rename_case.contains("FileWrite(path_prefix: \"\")")).to_equal(false)

        val handlers = file_read("src/os/kernel/ipc/syscall_file.spl")
        val open_body = handlers.split("fn _handle_file_open")[1].split(
            "fn _handle_file_read")[0]
        expect(open_body.split("_fs_copy_user_bytes").len()).to_equal(2)
        expect(open_body).to_contain(
            "sched.current_managed_file_capability_decide_v1(\n            resolved_path, _open_permissions(flags))")
        expect(open_body).to_contain(
            "elif not ipc_mgr.cap_manager.check_file_access(")

        val rename_body = handlers.split("fn _handle_file_rename")[1].split(
            "fn _handle_file_rmdir")[0]
        expect(rename_body.split("_fs_copy_user_bytes").len()).to_equal(3)
        expect(rename_body).to_contain(
            "sched.current_managed_file_capability_decide_v1(\n            old_resolved, \"w\")")
        expect(rename_body).to_contain(
            "sched.current_managed_file_capability_decide_v1(\n            new_resolved, \"wc\")")
        expect(rename_body).to_contain(
            "elif (not ipc_mgr.cap_manager.check_file_access(")

    it "selects the caller fd context before a cross-task close":
        # @req REQ-SSPEC-OS
        step("selects the caller fd context before a cross-task close")
        fd_table_init()
        fd_activate_task(902u64)
        expect(fd_set(3, FD_TYPE_FAT32, O_RDONLY, 20u64)).to_equal(0)
        fd_activate_task(903u64)
        expect(fd_set(3, FD_TYPE_FAT32, O_RDONLY, 21u64)).to_equal(0)

        fd_activate_task(902u64)
        expect(fd_close(3)).to_equal(0)
        fd_activate_task(903u64)
        expect(fd_is_valid(3)).to_equal(true)

        val syscall = file_read("src/os/kernel/ipc/syscall_file.spl")
        val close_body = syscall.split("fn _handle_file_close")[1].split("fn _handle_file_sync")[0]
        expect(close_body).to_contain("fd_activate_task(current.id)")
        expect(close_body).to_contain("posix_close(fd)")

    it "uses only the architecture-selected copy facade for file bytes":
        # @req REQ-SSPEC-OS
        step("uses only the architecture-selected copy facade for file bytes")
        val syscall = file_read("src/os/kernel/ipc/syscall_file.spl")
        expect(syscall).to_contain("user_copyin_bytes(ptr_addr, len)")
        expect(syscall).to_contain("user_copyout_bytes(ptr_addr, bytes)")
        expect(syscall).to_contain("copied.status.bytes_read != len")
        expect(syscall.contains("rt_copy_user_byte")).to_equal(false)
        expect(syscall.contains("mmio_write8")).to_equal(false)
        expect(syscall.contains("vmm_verify_user_write")).to_equal(false)
