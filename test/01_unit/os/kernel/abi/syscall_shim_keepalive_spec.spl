"""
## Purpose and audience
Regression: syscall_shim.spl re-declared spl_handle_debug_write as a local
`extern fn`, shadowing the definition imported from syscall_shim_process. The
keepalive's `spl_handle_debug_write as u64` then lowered to an undeclared
global (LLVM) / NULL function value (Cranelift) and the riscv64 kernel failed
to build. Every keepalive handler must come from the module import, like
spl_handle_exit.
"""
# @req: REQ-TEST-SYSCALL_SHIM_KEEPALIVE-001
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

describe "syscall_shim keepalive":
    it "does not shadow imported handlers with a local extern":
        val src = file_read_text("src/os/kernel/abi/syscall_shim.spl")
        expect(src.contains("extern fn spl_handle_debug_write")).to_equal(false)
        expect(src.contains("use os.kernel.abi.syscall_shim_process")).to_equal(true)
