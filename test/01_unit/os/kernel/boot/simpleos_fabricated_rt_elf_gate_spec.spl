# @req: REQ-OS-KERNEL-001

"""
# The fabricated-`rt_*` gate must fail CLOSED on symbols nobody baselined

**Category:** Runtime / SimpleOS freestanding link
**Gate:** `scripts/check/check-simpleos-fabricated-rt-elf.shs`
**Accounting:** `config/simpleos_fabricated_rt_elf_accounting.sdn`
**Bug:** doc/08_tracking/bug/fabricated_stub_guard_fails_open_on_unbaselined_symbols_2026-08-09.md

## What went wrong

`rt_index_of` reached the shipped x86_64 WM kernel as a WEAK stub whose entire
body is `xor %eax,%eax; ret`. `index_of` answered 0 instead of 11, every caller
reads 0 as "not found", and all 45 `:root` CSS custom properties disappeared in
the guest. Fixed at 1f1c00aa578 by defining it in
`examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c`.

The fabricated-stub check compared against
`config/simpleos_fabricated_rt_baseline.sdn`. `rt_index_of` was not in that
file, so nothing fired. A gate that only inspects symbols already known to be
suspicious cannot catch a NEW fabrication — which is the only kind that matters.

## The shape that fails closed

Enumerate from the ARTIFACT, not from the suspect list: read every `rt_*`
symbol out of the linked kernel ELF with `nm`, classify each BY BODY (a
constant return is fabricated whether its linkage is `W` or `T`), and require
every constant-return body to carry a written justification. A symbol nobody
has written about is, by construction, unaccounted — so a new fabrication fails
without anyone having predicted it.

These `it` blocks assert the gate's own fail-closed properties against real
fixture ELFs it compiles on the spot, so a regression in the classifier or the
accounting parser turns them red rather than silently reporting a clean pass.
"""

use std.spec.{describe, it, expect}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)
extern fn rt_file_read_text(path: text) -> text

val GATE = "scripts/check/check-simpleos-fabricated-rt-elf.shs"
val ACCOUNTING = "config/simpleos_fabricated_rt_elf_accounting.sdn"

fn _shell(script: text) -> (text, text, i32):
    rt_process_run_timeout("/bin/sh", ["-c", script], 120000)

fn _last_line(out: text) -> text:
    var last = ""
    for raw in out.split("\n"):
        val line = raw.trim()
        if line != "":
            last = line
    last

use std.spec.step

describe "SimpleOS fabricated-rt ELF gate":
    it "passes its own fixture selftest, both sabotage directions included":
        # @req: REQ-OS-KERNEL-001
        step("Verify: passes its own fixture selftest, both sabotage directions included")
        # The selftest builds a two-symbol ELF (one real loop, one weak
        # `return 0;`) and drives five fixtures: accounted -> PASS (and
        # NON-VACUOUSLY so, it must report that it saw the stub), unaccounted ->
        # FAIL, justification-less row -> FAIL, empty symbol set -> not PASS,
        # missing ELF -> not PASS.
        val (out, _err, code) = _shell("sh " + GATE + " --selftest")
        expect(code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_last_line(out)).to_start_with("PASS — ")

    it "FAILS when a strong definition is removed and the symbol goes fabricated":
        # @req: REQ-OS-KERNEL-001
        step("Verify: FAILS when a strong definition is removed and the symbol goes fabricated")
        # Direction 1 of the sabotage: link a real body, then link the same
        # program with that body replaced by a weak `return 0;`. The gate must
        # change verdict.
        val d = "/tmp/simpleos_fab_elf_gate_spec_sabotage"
        val setup = "rm -rf " + d + " && mkdir -p " + d + " && " +
            "printf 'long rt_probe_thing(long a);\\nlong rt_probe_thing(long a) { long s = 0; for (long i = 0; i < a; i++) s += i; return s; }\\n' > " + d + "/real.c && " +
            "printf '__attribute__((weak)) long rt_probe_thing(void);\\n__attribute__((weak)) long rt_probe_thing(void) { return 0; }\\n' > " + d + "/fab.c && " +
            "printf 'long rt_probe_thing();\\nint main(void){return (int)rt_probe_thing();}\\n' > " + d + "/main.c && " +
            "cc -O1 -o " + d + "/good.elf " + d + "/main.c " + d + "/real.c && " +
            "cc -O1 -o " + d + "/bad.elf " + d + "/main.c " + d + "/fab.c && " +
            ": > " + d + "/empty.sdn"
        val (_so, _se, sc) = _shell(setup)
        expect(sc).to_equal(0)  # oracle: 0 — named expected value from the requirement

        # Strong real body, empty accounting -> nothing to account for -> PASS.
        val (good_out, _ge, good_code) = _shell("sh " + GATE + " --accounting " + d + "/empty.sdn --prefix rt_probe " + d + "/good.elf")
        expect(good_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(_last_line(good_out)).to_start_with("PASS — ")

        # Same program, definition removed so the weak 0-stub binds -> FAIL.
        val (bad_out, _be, bad_code) = _shell("sh " + GATE + " --accounting " + d + "/empty.sdn --prefix rt_probe " + d + "/bad.elf")
        expect(bad_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_last_line(bad_out)).to_start_with("FAIL — ")
        expect(bad_out).to_contain("rt_probe_thing")

    it "never reports PASS over an empty or unresolvable symbol set":
        # @req: REQ-OS-KERNEL-001
        step("Verify: never reports PASS over an empty or unresolvable symbol set")
        # The repo has a documented family of gates that reported success over
        # zero items. This one must ERROR instead.
        val (out, _err, code) = _shell("sh " + GATE + " /nonexistent/kernel.elf")
        expect(code).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(_last_line(out)).to_start_with("ERROR — nothing was checked")

    it "states how many symbols a passing run actually checked":
        # @req: REQ-OS-KERNEL-001
        step("Verify: states how many symbols a passing run actually checked")
        val (out, _err, _code) = _shell("sh " + GATE + " --selftest")
        val verdict = _last_line(out)
        expect(verdict).to_contain("symbol(s) checked")
        expect(verdict.contains("PASS — 0 ")).to_be(false)

    it "keeps rt_index_of OUT of the accounting file":
        # @req: REQ-OS-KERNEL-001
        step("Verify: keeps rt_index_of OUT of the accounting file")
        # The symbol that caused the incident is a text/collection primitive.
        # Nil is never the right answer for it, so it must never be accounted
        # for; a kernel still carrying a constant-return rt_index_of predates
        # the 1f1c00aa578 fix and has to fail this gate.
        val acct = rt_file_read_text(ACCOUNTING)
        var accounted = false
        for raw in acct.split("\n"):
            val line = raw.trim()
            if line == "" or line.starts_with("#"):
                continue
            if line.contains(" rt_index_of "):
                accounted = true
        expect(accounted).to_be(false)

    it "requires a written justification on every accounting row":
        # @req: REQ-OS-KERNEL-001
        step("Verify: requires a written justification on every accounting row")
        val acct = rt_file_read_text(ACCOUNTING)
        var rows = 0
        var unjustified = 0
        for raw in acct.split("\n"):
            val line = raw.trim()
            if line == "" or line.starts_with("#"):
                continue
            rows = rows + 1
            var toks = 0
            for tok in line.split(" "):
                if tok != "":
                    toks = toks + 1
            if toks < 3:
                unjustified = unjustified + 1
        # A vacuous pass over an empty file is itself a defect.
        expect(rows > 0).to_be(true)
        expect(unjustified).to_equal(0)  # oracle: 0 — named expected value from the requirement
