use std.spec
use os.kernel.boot.dtb_parser.{dtb_device_info_empty, dtb_device_info_record_cpu}

describe "DTB CPU metadata selection":
    it "excludes disabled CPUs from the enabled hart count":
        val empty = dtb_device_info_empty()
        val result = dtb_device_info_record_cpu(empty, false, "rv64gc_zicbom", 128u32)
        expect(result.hart_count).to_equal(0u32)
        expect(result.first_enabled_riscv_isa).to_equal("")
        expect(result.cbom_block_size).to_equal(0u32)

    it "takes ISA and CBOM metadata from the first enabled CPU":
        val empty = dtb_device_info_empty()
        val after_disabled = dtb_device_info_record_cpu(empty, false, "rv64gc", 64u32)
        val first_enabled = dtb_device_info_record_cpu(after_disabled, true, "rv64gc_zicbom", 128u32)
        val second_enabled = dtb_device_info_record_cpu(first_enabled, true, "rv64gc", 64u32)
        expect(second_enabled.hart_count).to_equal(2u32)
        expect(second_enabled.first_enabled_riscv_isa).to_equal("rv64gc_zicbom")
        expect(second_enabled.cbom_block_size).to_equal(128u32)
