"""
## Purpose and audience
Regression: boot_fs_mount.spl used NVFS_BOOT_ARENA_BASE_LBA_V1 without importing
it, so the riscv64 kernel native-build (LLVM) failed with "global load
referenced undeclared symbol". Importing the module proves it resolves.
"""
# @req: REQ-TEST-BOOT_FS_MOUNT_ARENA_IMPORT-001
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}
use os.kernel.boot.nvfs_root_mount_transaction.{NVFS_BOOT_ARENA_BASE_LBA_V1}

describe "boot_fs_mount NVFS arena constant":
    it "imports NVFS_BOOT_ARENA_BASE_LBA_V1 from its owner":
        val src = file_read_text("src/os/kernel/boot/boot_fs_mount.spl")
        expect(src.contains("use os.kernel.boot.nvfs_root_mount_transaction.")).to_equal(true)
        expect(NVFS_BOOT_ARENA_BASE_LBA_V1 > 0).to_equal(true)
