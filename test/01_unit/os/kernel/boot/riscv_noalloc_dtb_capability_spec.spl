"""
## Purpose and audience
Pins the boot-owned RV64 DTB capability census (os.kernel.boot.riscv_noalloc_dtb_capability):
hart enumeration from the firmware device tree, the zicbom/cache-block
capability intersection, fail-closed header/structure validation, and the
bounded noalloc storage contract. Written for kernel-boot owners and the
riscv bring-up lane; scenarios speak in terms of encoded FDT blobs installed
at known MMIO windows.
## Operator workflow
Run this file with the seed runner from the repo root:
`./src/compiler_rust/target/bootstrap/simple run test/01_unit/os/kernel/boot/riscv_noalloc_dtb_capability_spec.spl`
and read the SPEC FILE VERDICT line; each scenario encodes a synthetic DTB,
installs it via mmio_write8, and runs the product census.
## Compatibility and limitations
The census module is noalloc and extern-free by contract, so scenarios also
pin the shipped source for bounded storage and prohibited-surface absence.
Interpretor-only MMIO test hooks (mmio_reset_for_test) are used; no real
firmware device tree is read.
## Verification guidance and troubleshooting
A failure names the capability property that diverged (hart id, zicbom token,
stride, validity). Re-run a single scenario by reading its encoded blob
layout at the top of this file; header offsets follow the FDT v17 layout
(magic D00DFEED, 40-byte header, version 17).
"""
# Lifecycle: doc/01_research/local/riscv32_riscv64_fpga_simpleos_production.md ;
# doc/03_plan/os/riscv/riscv_rtl_simpleos_boot.md ;
# doc/04_architecture/riscv32_riscv64_fpga_simpleos_production.md ;
# doc/05_design/os/scheduler_riscv32_mapping_handle_v1.md
# @manual_section: rv64-boot-dtb-capability

use std.testing.{describe, it, expect}
use std.io_runtime.{read_file_text}
use os.kernel.arch.riscv64.hal_smp.{hal_smp_ipi_window, hal_smp_hsm_target}
use os.kernel.boot.mmio.{mmio_reset_for_test, mmio_write8}
use os.kernel.boot.riscv_noalloc_dtb_capability.{
    riscv_noalloc_dtb_capability_init,
    riscv_noalloc_dtb_capability_valid,
    riscv_noalloc_dtb_hart_count,
    riscv_noalloc_dtb_hart_id,
    riscv_noalloc_dtb_has_zicbom,
    riscv_noalloc_dtb_cache_stride
}

fn _be32(out: [u8], value: u32) -> [u8]:
    var result = out
    result.push(((value >> 24u32) & 255u32) as u8)
    result.push(((value >> 16u32) & 255u32) as u8)
    result.push(((value >> 8u32) & 255u32) as u8)
    result.push((value & 255u32) as u8)
    result

fn _peek32(bytes: [u8], offset: i64) -> u32:
    ((bytes[offset] as u32) << 24u32) | ((bytes[offset + 1] as u32) << 16u32) |
        ((bytes[offset + 2] as u32) << 8u32) | bytes[offset + 3] as u32

fn _poke32(bytes: [u8], offset: i64, value: u32) -> [u8]:
    var result = bytes
    result[offset] = ((value >> 24u32) & 255u32) as u8
    result[offset + 1] = ((value >> 16u32) & 255u32) as u8
    result[offset + 2] = ((value >> 8u32) & 255u32) as u8
    result[offset + 3] = (value & 255u32) as u8
    result

fn _bytes(out: [u8], value: text) -> [u8]:
    var result = out
    var i: i64 = 0
    while i < value.len():
        result.push(value.byte_at(i) as u8)
        i = i + 1
    result

fn _find_text(bytes: [u8], value: text) -> i64:
    var start: i64 = 0
    while start + value.len() <= bytes.len():
        var matched = true
        var i: i64 = 0
        while i < value.len():
            if bytes[start + i] != value.byte_at(i) as u8: matched = false
            i = i + 1
        if matched: return start
        start = start + 1
    -1

fn _find_prop(bytes: [u8], length: u32, name_offset: u32) -> i64:
    var offset: i64 = 0
    while offset + 12 <= bytes.len():
        if _peek32(bytes, offset) == 3u32 and _peek32(bytes, offset + 4) == length and _peek32(bytes, offset + 8) == name_offset: return offset
        offset = offset + 1
    -1

fn _pad4(out: [u8]) -> [u8]:
    var result = out
    while result.len() % 4 != 0: result.push(0u8)
    result

fn _begin(out: [u8], name: text) -> [u8]:
    var result = _be32(out, 1u32)
    result = _bytes(result, name)
    result.push(0u8)
    _pad4(result)

fn _prop32(out: [u8], name_offset: u32, value: u32) -> [u8]:
    var result = _be32(out, 3u32)
    result = _be32(result, 4u32)
    result = _be32(result, name_offset)
    _be32(result, value)

fn _prop_text(out: [u8], name_offset: u32, value: text) -> [u8]:
    var result = _be32(out, 3u32)
    result = _be32(result, (value.len() + 1) as u32)
    result = _be32(result, name_offset)
    result = _bytes(result, value)
    result.push(0u8)
    _pad4(result)

fn _cpu(out: [u8], hart: u32, enabled: bool, isa: text, stride: u32) -> [u8]:
    var result = _begin(out, "cpu")
    result = _prop32(result, 0u32, hart)
    if enabled: result = _prop_text(result, 4u32, "okay")
    else: result = _prop_text(result, 4u32, "disabled")
    result = _prop_text(result, 11u32, isa)
    result = _prop32(result, 21u32, stride)
    _be32(result, 2u32)

fn _encoded_dtb(hart0: u32, hart1: u32, second_enabled: bool, isa0: text, isa1: text, stride0: u32, stride1: u32) -> [u8]:
    var structure: [u8] = []
    structure = _begin(structure, "")
    structure = _begin(structure, "cpus")
    structure = _prop32(structure, 43u32, 1u32)
    structure = _prop32(structure, 58u32, 0u32)
    structure = _cpu(structure, hart0, true, isa0, stride0)
    structure = _cpu(structure, hart1, second_enabled, isa1, stride1)
    structure = _be32(structure, 2u32)
    structure = _be32(structure, 2u32)
    structure = _be32(structure, 9u32)
    var strings: [u8] = []
    strings = _bytes(strings, "reg")
    strings.push(0u8)
    strings = _bytes(strings, "status")
    strings.push(0u8)
    strings = _bytes(strings, "riscv,isa")
    strings.push(0u8)
    strings = _bytes(strings, "riscv,cbom-block-size")
    strings.push(0u8)
    strings = _bytes(strings, "#address-cells")
    strings.push(0u8)
    strings = _bytes(strings, "#size-cells")
    strings.push(0u8)
    val struct_offset = 56u32
    val strings_offset = struct_offset + structure.len() as u32
    val total = strings_offset + strings.len() as u32
    var blob: [u8] = []
    blob = _be32(blob, 0xD00DFEEDu32)
    blob = _be32(blob, total)
    blob = _be32(blob, struct_offset)
    blob = _be32(blob, strings_offset)
    blob = _be32(blob, 40u32)
    blob = _be32(blob, 17u32)
    blob = _be32(blob, 16u32)
    blob = _be32(blob, hart0)
    blob = _be32(blob, strings.len() as u32)
    blob = _be32(blob, structure.len() as u32)
    # Empty memory-reservation map: one zero address/size pair.
    blob = _be32(blob, 0u32)
    blob = _be32(blob, 0u32)
    blob = _be32(blob, 0u32)
    blob = _be32(blob, 0u32)
    for byte in structure: blob.push(byte)
    for byte in strings: blob.push(byte)
    blob

fn _encoded_many_dtb(count: u32) -> [u8]:
    var structure: [u8] = []
    structure = _begin(structure, "")
    structure = _begin(structure, "cpus")
    structure = _prop32(structure, 43u32, 1u32)
    structure = _prop32(structure, 58u32, 0u32)
    var hart: u32 = 0u32
    while hart < count:
        structure = _cpu(structure, hart, true, "rv64gc_zicbom", 64u32)
        hart = hart + 1u32
    structure = _be32(structure, 2u32)
    structure = _be32(structure, 2u32)
    structure = _be32(structure, 9u32)
    var strings: [u8] = []
    strings = _bytes(strings, "reg")
    strings.push(0u8)
    strings = _bytes(strings, "status")
    strings.push(0u8)
    strings = _bytes(strings, "riscv,isa")
    strings.push(0u8)
    strings = _bytes(strings, "riscv,cbom-block-size")
    strings.push(0u8)
    strings = _bytes(strings, "#address-cells")
    strings.push(0u8)
    strings = _bytes(strings, "#size-cells")
    strings.push(0u8)
    val strings_offset = 56u32 + structure.len() as u32
    var blob: [u8] = []
    blob = _be32(blob, 0xD00DFEEDu32)
    blob = _be32(blob, strings_offset + strings.len() as u32)
    blob = _be32(blob, 56u32)
    blob = _be32(blob, strings_offset)
    blob = _be32(blob, 40u32)
    blob = _be32(blob, 17u32)
    blob = _be32(blob, 16u32)
    blob = _be32(blob, 0u32)
    blob = _be32(blob, strings.len() as u32)
    blob = _be32(blob, structure.len() as u32)
    var reserve: u32 = 0u32
    while reserve < 4u32:
        blob = _be32(blob, 0u32)
        reserve = reserve + 1u32
    for byte in structure: blob.push(byte)
    for byte in strings: blob.push(byte)
    blob

fn _install(blob: [u8], base: u64):
    mmio_reset_for_test()
    var i: i64 = 0
    while i < blob.len():
        mmio_write8(base + i as u64, blob[i])
        i = i + 1

describe "boot-owned RV64 DTB capability":
    it "decodes enabled unique harts and makes the observed boot hart logical zero":
        # @req REQ-BOOT-DTB-001
        # @capture(protocol_binary): the encoded two-hart FDT blob plus the decoded hart census it yields
        step("Encode a two-hart DTB with both CPUs enabled and install it at the first MMIO window")
        val blob = _encoded_dtb(7u32, 3u32, true, "rv64imafdc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x10000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x10000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(true)
        expect(riscv_noalloc_dtb_hart_count()).to_equal(2u32)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(3u64)
        expect(riscv_noalloc_dtb_hart_id(1u32)).to_equal(7u64)
        expect(riscv_noalloc_dtb_has_zicbom()).to_equal(true)
        expect(riscv_noalloc_dtb_cache_stride()).to_equal(64u32)

    it "excludes disabled CPUs from the capability intersection":
        # @req REQ-BOOT-DTB-002
        # @capture(bit_table): per-CPU enabled/disabled rows the census retained after the intersection
        step("Encode one enabled and one disabled CPU and run the census again")
        val blob = _encoded_dtb(3u32, 7u32, false, "rv64gc_zicbom", "rv64gc", 128u32, 0u32)
        _install(blob, 0x20000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x20000u64)
        expect(riscv_noalloc_dtb_hart_count()).to_equal(1u32)
        expect(riscv_noalloc_dtb_has_zicbom()).to_equal(true)
        expect(riscv_noalloc_dtb_cache_stride()).to_equal(128u32)

    it "requires the exact zicbom token on every enabled CPU":
        # @req REQ-BOOT-DTB-003
        # @capture(protocol_binary): the ISA strings that differ by one token across the two CPUs
        step("Encode an ISA string with a corrupted zicbom suffix on hart zero")
        val blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbomx", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x30000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x30000u64)
        expect(riscv_noalloc_dtb_has_zicbom()).to_equal(false)
        expect(riscv_noalloc_dtb_cache_stride()).to_equal(64u32)

    it "fails closed for duplicate enabled hart IDs":
        # @req REQ-BOOT-DTB-004
        # @capture(bit_table): the duplicate-hart collision row the census rejected
        step("Encode two enabled CPUs that carry the same physical hart id")
        val blob = _encoded_dtb(3u32, 3u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x40000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x40000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_hart_count()).to_equal(1u32)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(3u64)

    it "fails closed when enabled CPUs exceed fixed census capacity":
        # @req REQ-BOOT-DTB-005
        # @capture(statistics): hart count against the fixed 32-slot census capacity
        step("Encode thirty-three enabled CPUs, one past the fixed capacity")
        val blob = _encoded_many_dtb(33u32)
        _install(blob, 0x48000u64)
        riscv_noalloc_dtb_capability_init(0u64, 0x48000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_hart_count()).to_equal(1u32)

    it "fails closed for inconsistent power-of-two block sizes":
        # @req REQ-BOOT-DTB-006
        # @capture(statistics): the two disagreeing cbom block sizes read from the blob
        step("Encode matching ISA strings whose cbom block sizes disagree as 64 versus 128")
        val blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 128u32)
        _install(blob, 0x50000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x50000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_has_zicbom()).to_equal(false)

    it "fails closed for a consistent non-power-of-two block size":
        # @req REQ-BOOT-DTB-007
        # @capture(statistics): the 96-byte stride that is consistent but not a power of two
        step("Encode a pair of CPUs agreeing on a non-power-of-two cbom stride")
        val blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 96u32, 96u32)
        _install(blob, 0x58000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x58000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_cache_stride()).to_equal(64u32)

    it "fails closed when firmware omits the observed boot hart":
        # @req REQ-BOOT-DTB-008
        # @capture(bit_table): the boot-hart membership row that stayed empty during the census
        step("Pass a boot hart id that no encoded CPU node claims")
        val blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x5c000u64)
        riscv_noalloc_dtb_capability_init(19u64, 0x5c000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(19u64)

    it "uses the observed boot hart fallback for malformed headers":
        # @req REQ-BOOT-DTB-009
        # @capture(protocol_binary): the corrupted magic byte and the fallback hart id kept for handoff
        step("Zero the FDT magic byte and demand the boot hart fallback still be recorded")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        blob[0] = 0u8
        _install(blob, 0x60000u64)
        riscv_noalloc_dtb_capability_init(19u64, 0x60000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(19u64)
        expect(riscv_noalloc_dtb_cache_stride()).to_equal(64u32)

    it "rejects incompatible header versions":
        # @req REQ-BOOT-DTB-010
        # @capture(protocol_binary): the header version field overwritten to an unsupported value
        step("Overwrite the FDT version field to 16 and re-run the census")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        blob = _poke32(blob, 20, 16u32)
        _install(blob, 0x64000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x64000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects overlapping structure and strings ranges":
        # @req REQ-BOOT-DTB-011
        # @capture(protocol_binary): the header offsets whose ranges collide after the poke
        step("Point the strings offset at the structure offset so the ranges overlap")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        blob = _poke32(blob, 12, _peek32(blob, 8))
        _install(blob, 0x65000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x65000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects a structure block without a valid END token":
        # @req REQ-BOOT-DTB-012
        # @capture(protocol_binary): the structure tail where the END token was replaced by zero
        step("Replace the final structure token with FDT_NOP so no END closes the block")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val strings_offset = _peek32(blob, 12) as i64
        blob = _poke32(blob, strings_offset - 4, 0u32)
        _install(blob, 0x66000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x66000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects a depth-zero property after the root closes":
        # @req REQ-BOOT-DTB-013
        # @capture(protocol_binary): the trailing property token placed after the root END
        step("Append a property token after the root END and expect rejection")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val strings_offset = _peek32(blob, 12) as i64
        blob = _poke32(blob, strings_offset - 4, 3u32)
        _install(blob, 0x66400u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x66400u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "requires both cpus cell-width properties":
        # @req REQ-BOOT-DTB-014
        # @capture(bit_table): the address-cells/size-cells presence rows after the poke
        step("Repoint the size-cells property name at the address-cells slot")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val size_prop = _find_prop(blob, 4u32, 58u32)
        blob = _poke32(blob, size_prop + 8, 21u32)
        _install(blob, 0x66600u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x66600u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects duplicate relevant CPU properties":
        # @req REQ-BOOT-DTB-015
        # @capture(protocol_binary): the duplicated reg property that fails the uniqueness rule
        step("Repoint the cbom property name at the reg slot to duplicate it")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val cbom_prop = _find_prop(blob, 4u32, 21u32)
        blob = _poke32(blob, cbom_prop + 8, 0u32)
        _install(blob, 0x66700u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x66700u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects an unsupported CPU address-cell width":
        # @req REQ-BOOT-DTB-016
        # @capture(statistics): the address-cells width of three that exceeds the supported two
        step("Widen the cpus address-cells value to an unsupported width of three")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        blob = _poke32(blob, 88, 3u32)
        _install(blob, 0x66800u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x66800u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects malformed status string length and termination":
        # @req REQ-BOOT-DTB-017
        # @capture(protocol_binary): the status property whose length byte exceeds its storage
        step("Corrupt the status property length so it overruns its NUL terminator")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val status = _find_text(blob, "okay")
        blob[status + 4] = 1u8
        _install(blob, 0x67000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x67000u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects an ISA property without its terminating NUL":
        # @req REQ-BOOT-DTB-018
        # @capture(protocol_binary): the ISA property bytes after the terminator was removed
        step("Strip the ISA property's terminating NUL and expect rejection")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val isa = _find_text(blob, "rv64gc_zicbom")
        blob[isa + 14] = 1u8
        _install(blob, 0x67800u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x67800u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "does not admit CPU nodes outside the root cpus child":
        # @req REQ-BOOT-DTB-019
        # @capture(bit_table): the parent-chain row showing the CPU node detached from cpus
        step("Corrupt the cpus node name so the CPU nodes lose their parent")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        val cpus = _find_text(blob, "cpus")
        blob[cpus] = 120u8
        _install(blob, 0x67c00u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x67c00u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "rejects physical-address overflow before reading a header":
        # @req REQ-BOOT-DTB-020
        # @capture(statistics): the base-plus-size sum that overflows the physical address width
        step("Install a blob whose window runs past the top of the physical address space")
        mmio_reset_for_test()
        riscv_noalloc_dtb_capability_init(23u64, 0xfffffffffffffff0u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(23u64)

    it "scans reservation entries until a zero address and size terminator":
        # @req REQ-BOOT-DTB-021
        # @capture(protocol_binary): the non-empty memory-reservation map the scanner walked
        step("Raise the reservation-map count to one entry and walk the scanner")
        var blob = _encoded_dtb(3u32, 7u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        blob = _poke32(blob, 44, 1u32)
        _install(blob, 0x67400u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x67400u64)
        expect(riscv_noalloc_dtb_capability_valid()).to_equal(false)

    it "preserves sparse hart IDs above one SBI mask window":
        # @req REQ-BOOT-DTB-022
        # @capture(statistics): the sparse hart id and the IPI window base it maps to
        step("Encode hart 130 as the boot hart and query the SBI IPI window it lands in")
        val blob = _encoded_dtb(130u32, 3u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x68000u64)
        riscv_noalloc_dtb_capability_init(130u64, 0x68000u64)
        expect(riscv_noalloc_dtb_hart_id(0u32)).to_equal(130u64)
        val window = hal_smp_ipi_window(riscv_noalloc_dtb_hart_id(0u32))
        expect(window.1).to_equal(128u64)
        expect(window.0).to_equal(4u64)

    it "passes the sparse physical hart ID to the HSM target decision":
        # @req REQ-BOOT-DTB-023
        # @capture(bit_table): the HSM start row for the sparse hart with its physical id
        step("Encode hart 130 as a secondary and ask the HSM helper for its start target")
        val blob = _encoded_dtb(3u32, 130u32, true, "rv64gc_zicbom", "rv64gc_zicbom", 64u32, 64u32)
        _install(blob, 0x6c000u64)
        riscv_noalloc_dtb_capability_init(3u64, 0x6c000u64)
        val target = hal_smp_hsm_target(1u32)
        expect(target.0).to_equal(true)
        expect(target.1).to_equal(130u64)

    it "keeps both handoff paths ordered before readiness publication":
        # @req REQ-BOOT-DTB-024
        # @capture(bit_table): the ordered contract rows for init, ram-base pin, and readiness flag
        step("Read the shipped handoff source and bind each ordering contract to a named check")
        val handoff_source = read_file_text("src/os/kernel/boot/riscv_noalloc_handoff.spl")
        val init_consumes_the_pinned_boot_addr = handoff_source.contains("g_riscv_boot_dtb_addr = dtb_addr\n    riscv_noalloc_dtb_capability_init(hart_id, dtb_addr)")
        val init_lands_before_the_ram_base_pin = handoff_source.contains("riscv_noalloc_dtb_capability_init(hart_id, dtb_addr)\n    g_riscv_ram_base")
        val readiness_flag_publishes_last = handoff_source.contains("g_riscv_noalloc_handoff_ready = true")
        expect(init_consumes_the_pinned_boot_addr).to_equal(true)
        expect(init_lands_before_the_ram_base_pin).to_equal(true)
        expect(readiness_flag_publishes_last).to_equal(true)

    it "statically pins bounded storage and prohibited-surface absence":
        # @req REQ-BOOT-DTB-025
        # @capture(bit_table): the storage-bound and prohibited-surface contract rows for the module
        step("Read the shipped census source and bind each noalloc storage contract to a named check")
        val capability_source = read_file_text("src/os/kernel/boot/riscv_noalloc_dtb_capability.spl")
        val pins_bounded_hart_census = capability_source.contains("[u64; 32]")
        val pins_maximum_blob_span = capability_source.contains("_FDT_MAX_SIZE: u64 = 0x00200000u64")
        val pins_maximum_structure_depth = capability_source.contains("_FDT_MAX_DEPTH: u32 = 32u32")
        val admits_no_extern_declarations = capability_source.contains("extern fn") == false
        val admits_no_extern_runtime_calls = capability_source.contains("extern fn rt_") == false
        val admits_no_option_values = capability_source.contains("Option<") == false
        val admits_no_result_values = capability_source.contains("Result<") == false
        val admits_no_unbounded_hart_globals = capability_source.contains("var _g_rv64_dtb_harts: [u64]") == false
        expect(pins_bounded_hart_census).to_equal(true)
        expect(pins_maximum_blob_span).to_equal(true)
        expect(pins_maximum_structure_depth).to_equal(true)
        expect(admits_no_extern_declarations).to_equal(true)
        expect(admits_no_extern_runtime_calls).to_equal(true)
        expect(admits_no_option_values).to_equal(true)
        expect(admits_no_result_values).to_equal(true)
        expect(admits_no_unbounded_hart_globals).to_equal(true)
