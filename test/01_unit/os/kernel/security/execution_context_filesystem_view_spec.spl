use std.spec.{describe, it, expect}
use os.kernel.security.execution_context.{
    KernelCallContext, PrincipalId, JobId, CspaceId, IsolationDomainId,
    ResourceDomainId, AuditContextId, kernel_call_context_translate_filesystem_path
}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilitySet}

fn _context(root: text, denied: bool, bound: bool) -> KernelCallContext:
    KernelCallContext(
        task_id: TaskId(id: 7u64), principal_id: PrincipalId(id: 7u64),
        job_id: JobId(id: 7u64), cspace_id: CspaceId(id: 1u64),
        isolation_domain_id: IsolationDomainId(id: 7u64),
        resource_domain_id: ResourceDomainId(id: 7u64),
        audit_context_id: AuditContextId(id: 7u64), capabilities: CapabilitySet.empty(),
        filesystem_root: root, filesystem_denied: denied, filesystem_view_bound: bound
    )

describe "kernel caller filesystem view":
    it "maps logical paths beneath the concrete bound root":
        val translated = kernel_call_context_translate_filesystem_path(_context("/workspace", false, true), "/src/main.spl")
        expect(translated.is_ok()).to_equal(true)
        expect(translated.unwrap()).to_equal("/workspace/src/main.spl")

    it "denies an unbound or explicitly deny-all view":
        expect(kernel_call_context_translate_filesystem_path(_context("/workspace", false, false), "/src").is_err()).to_equal(true)
        expect(kernel_call_context_translate_filesystem_path(_context("", true, true), "/src").is_err()).to_equal(true)
