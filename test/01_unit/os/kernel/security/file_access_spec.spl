"""
Filesystem capability enforcement from KernelCallContext.

This suite is deliberately independent of syscall memory and FAT32 mounting:
it proves the fail-closed policy which direct ABI and trap-dispatch file paths
share, including the side-effectful O_CREAT rule.
"""

use std.spec.{describe, it, expect}
use os.kernel.security.execution_context.{KernelCallContext, PrincipalId, JobId, CspaceId, IsolationDomainId, ResourceDomainId, AuditContextId}
use os.kernel.security.file_access.{file_read_access_allows, file_write_access_allows, file_create_access_allows, file_open_access_allows, file_legacy_descriptor_route_allows}
use os.kernel.types.task_types.{TaskId}
use os.kernel.types.capability_types.{CapabilitySet, CapabilityToken, CapabilityKind}
use os.kernel.fd_table.{O_CREAT, O_WRONLY}

fn _file_context(task_id: u64, caps: CapabilitySet) -> KernelCallContext:
    KernelCallContext(
        task_id: TaskId(id: task_id),
        principal_id: PrincipalId(id: task_id),
        job_id: JobId(id: task_id),
        cspace_id: CspaceId(id: 1u64),
        isolation_domain_id: IsolationDomainId(id: 7u64),
        resource_domain_id: ResourceDomainId(id: 0u64),
        audit_context_id: AuditContextId(id: task_id),
        capabilities: caps, filesystem_root: "/", filesystem_denied: false,
        filesystem_view_bound: true
    )

fn _token(kind: CapabilityKind) -> CapabilityToken:
    CapabilityToken(kind: kind, generation: 1u64, owner: 42u64, token_id: 1u64, parent_token_id: 0u64, depth: 1i64)

fn _caps(tokens: [CapabilityToken]) -> CapabilitySet:
    CapabilitySet(caps: tokens, is_pledged: true)

describe "file_access: exact-path caller authority":
    it "rejects an empty CSpace for every userspace path operation":
        val context = _file_context(42u64, CapabilitySet.empty())
        expect(file_read_access_allows(context, "/workspace/readme.txt")).to_equal(false)
        expect(file_write_access_allows(context, "/workspace/readme.txt")).to_equal(false)
        expect(file_create_access_allows(context, "/workspace/new.txt")).to_equal(false)

    it "allows only the granted subtree and does not widen to siblings":
        val context = _file_context(42u64, _caps([_token(CapabilityKind.FileRead(path_prefix: "/workspace"))]))
        expect(file_read_access_allows(context, "/workspace/src/main.spl")).to_equal(true)
        expect(file_read_access_allows(context, "/workspaces/other.spl")).to_equal(false)
        expect(file_read_access_allows(context, "/etc/passwd")).to_equal(false)

    it "rejects a token owned by another task and non-kernel ambient full authority":
        val foreign = _file_context(42u64, _caps([_token(CapabilityKind.FileRead(path_prefix: "/workspace"))]))
        expect(file_read_access_allows(foreign, "/workspace/src/main.spl")).to_equal(true)

        val wrong_owner = _file_context(7u64, _caps([_token(CapabilityKind.FileRead(path_prefix: "/workspace"))]))
        expect(file_read_access_allows(wrong_owner, "/workspace/src/main.spl")).to_equal(false)
        expect(file_read_access_allows(_file_context(7u64, CapabilitySet.full()), "/workspace/src/main.spl")).to_equal(false)

    it "requires FileWrite for a write-mode open and FileCreate for O_CREAT":
        val write_only = _file_context(42u64, _caps([_token(CapabilityKind.FileWrite(path_prefix: "/workspace"))]))
        expect(file_open_access_allows(write_only, "/workspace/out.txt", O_WRONLY)).to_equal(true)
        expect(file_open_access_allows(write_only, "/workspace/out.txt", O_WRONLY | O_CREAT)).to_equal(false)

        val create_and_write = _file_context(42u64, _caps([
            _token(CapabilityKind.FileWrite(path_prefix: "/workspace")),
            _token(CapabilityKind.FileCreate(path_prefix: "/workspace"))
        ]))
        expect(file_open_access_allows(create_and_write, "/workspace/out.txt", O_WRONLY | O_CREAT)).to_equal(true)

    it "does not allow a managed filesystem view to bypass descriptor metadata":
        expect(file_legacy_descriptor_route_allows(_file_context(42u64, CapabilitySet.empty())).to_equal(false)

    it "keeps the kernel-origin bootstrap exception explicit":
        val context = _file_context(0u64, CapabilitySet.empty())
        expect(file_read_access_allows(context, "/system/init.smf")).to_equal(true)
