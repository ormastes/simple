"""Focused phase-B descriptor transaction contract coverage.

The package-private mutation surface is intentionally exercised later through
the kernel facade adapter. These checks freeze public bounds and transaction
kind identity without inventing a backend binding.
"""

use std.spec.*
use os.kernel.fs.fd_table_descriptor_owner_v1.*

describe "kernel fd descriptor owner phase-B contract":
    it "keeps descriptor, context, and transaction storage bounded":
        expect(FD_DESCRIPTOR_LIMIT_V1).to_equal(256)
        expect(FD_CONTEXT_LIMIT_V1).to_equal(256)
        expect(FD_TRANSACTION_LIMIT_V1).to_equal(64)

    it "distinguishes dup, dup2, fork, and close transaction kinds":
        expect(FdDescriptorTransactionKindV1.Dup ==
            FdDescriptorTransactionKindV1.Dup2).to_be(false)
        expect(FdDescriptorTransactionKindV1.Dup2 ==
            FdDescriptorTransactionKindV1.Fork).to_be(false)
        expect(FdDescriptorTransactionKindV1.Fork ==
            FdDescriptorTransactionKindV1.Close).to_be(false)

    it "binds descriptor contexts to a nonzero lifecycle generation":
        expect(fd_task_lifecycle_key_valid_v1(FdTaskLifecycleKeyV1(
            task_id: 0u64, lifecycle_generation: 1u64))).to_be(true)
        expect(fd_task_lifecycle_key_valid_v1(FdTaskLifecycleKeyV1(
            task_id: 41u64, lifecycle_generation: 7u64))).to_be(true)
        expect(fd_task_lifecycle_key_valid_v1(FdTaskLifecycleKeyV1(
            task_id: 41u64, lifecycle_generation: 0u64))).to_be(false)

    it "blocks replacement while a descriptor is a transaction source":
        expect(fd_descriptor_replacement_allowed_v1(0u32)).to_be(true)
        expect(fd_descriptor_replacement_allowed_v1(1u32)).to_be(false)
        expect(fd_descriptor_replacement_allowed_v1(0xffffffffu32)).to_be(false)

    it "permits only one exclusive close reservation":
        expect(fd_descriptor_close_reservation_allowed_v1(0u32)).to_be(true)
        expect(fd_descriptor_close_reservation_allowed_v1(1u32)).to_be(false)
        expect(fd_descriptor_close_reservation_allowed_v1(0xffffffffu32)).to_be(false)

    it "rejects a fork snapshot after any descriptor-table mutation":
        expect(fd_descriptor_snapshot_current_v1(7u32, 7u32)).to_be(true)
        expect(fd_descriptor_snapshot_current_v1(7u32, 8u32)).to_be(false)
        expect(fd_descriptor_snapshot_current_v1(0u32, 0u32)).to_be(false)
