"""
# FAT32 descriptor aliases and canonical file objects

**Feature:** kernel FAT32 driver (IF-07), fd read/write wiring lane, 2026-08-06

Closes the wall `doc/08_tracking/bug/path_based_fs_syscalls_fake_success_2026-08-06.md`
originally flagged: a fd allocated by `_handle_file_open` used to be typed
`FD_TYPE_FILE`, the SAME type byte `os.kernel.fd_io`'s `posix_read`/
`posix_write` route to `sosix_sync_read`/`sosix_sync_write` — a wholly
separate subsystem with no FAT32 backend, so read()/write() on a
FAT32-opened fd silently never touched the mounted filesystem. This module
(`os.kernel.fs.fat32_fd_table`) is what `os.kernel.ipc.syscall_file`'s
`_handle_file_open`/`_handle_file_read`/`_handle_file_write`/
`_handle_file_close` now delegate to.

The current owner separates per-task descriptor aliases from monotonic,
generation-safe `Fat32FileObject` identities. Dup/fork aliases share cursor and
metadata, last-alias close retires the object, and a reused fd cannot revive a
stale positioned capability. Sequential writes lower through the true
explicit-offset primitive at the shared cursor; positioned operations preserve
that cursor while committing returned allocation and file-size metadata.

Focused cases cover task scoping, alias lifetime, stale object rejection,
sequential overwrite, positioned cursor preservation, and metadata extension.
The qualified system gate reruns this spec only with a receipt-bound
pure-Simple Stage-4 runtime.
"""

use std.spec.{describe, it, expect, step, assert_true, assert_false}
use os.kernel.fs.fat32.{
    Fat32Filesystem, FileHandle,
    fat32_mount_publish, fat32_mount_clear
}
use os.kernel.fs.fat32_fd_table.{
    fat32_fd_register, fat32_fd_alias, fat32_fd_is_registered,
    fat32_fd_object_id, fat32_fd_clear, fat32_fd_clear_task,
    fat32_fd_read_into, fat32_fd_write_from,
    fat32_fd_read_object_at_into, fat32_fd_write_object_at_from,
    fat32_fd_clear_for_test
}

# ============================================================================
# In-memory mock block device — same geometry as
# fat32_mount_and_dir_ops_spec.spl / fat32_write_path_spec.spl:
# fat_start=32, data_start=64, bps=512, spc=1, cluster_size=512,
# data_clusters=32, root_cluster=2. LBA32=FAT (cluster 2 EOC, cluster 15 EOC
# decoy), LBA64=root dir (one FILE.O decoy, cluster 15, size 11).
# ============================================================================

struct FdtMockSector:
    lba: u64
    data: [u8]

class FdtMockDev:
    sectors: [FdtMockSector]

impl FdtMockDev:
    static fn new() -> FdtMockDev:
        FdtMockDev(sectors: [])

    me fn with_sector(lba: u64, data: [u8]) -> FdtMockDev:
        self.sectors.push(FdtMockSector(lba: lba, data: data))
        self

    me read_sector(lba: u64) -> Result<[u8], text>:
        var i = 0
        while i < self.sectors.len():
            if self.sectors[i].lba == lba:
                return Ok(self.sectors[i].data)
            i = i + 1
        Ok(_fdt_poison_sector())

    me write_sector(lba: u64, data: [u8]) -> Result<(), text>:
        var i = 0
        while i < self.sectors.len():
            if self.sectors[i].lba == lba:
                self.sectors[i] = FdtMockSector(lba: lba, data: data)
                return Ok(())
            i = i + 1
        self.sectors.push(FdtMockSector(lba: lba, data: data))
        Ok(())

fn _fdt_zero_sector() -> [u8]:
    var b: [u8] = []
    var i = 0
    while i < 512:
        b.push(0u8)
        i = i + 1
    b

fn _fdt_poison_sector() -> [u8]:
    var b: [u8] = []
    var i = 0
    while i < 512:
        b.push(0xAAu8)
        i = i + 1
    b

fn _fdt_poke32(buf: [u8], offset: i32, value: u32) -> [u8]:
    buf[offset]     = (value & 0xFFu32).to_u8()
    buf[offset + 1] = ((value >> 8u32)  & 0xFFu32).to_u8()
    buf[offset + 2] = ((value >> 16u32) & 0xFFu32).to_u8()
    buf[offset + 3] = ((value >> 24u32) & 0xFFu32).to_u8()
    buf

fn _fdt_put_entry(sec: [u8], off: i32, base: text, ext: text, attr: u8, cluster: u32, size: u32) -> [u8]:
    var s = sec
    var i = 0
    while i < 8:
        if i < base.len():
            s[off + i] = base.char_code_at(i).to_u8()
        else:
            s[off + i] = 0x20u8
        i = i + 1
    var j = 0
    while j < 3:
        if j < ext.len():
            s[off + 8 + j] = ext.char_code_at(j).to_u8()
        else:
            s[off + 8 + j] = 0x20u8
        j = j + 1
    s[off + 11] = attr
    val hi = (cluster >> 16u32) & 0xFFFFu32
    val lo = cluster & 0xFFFFu32
    s[off + 20] = (hi & 0xFFu32).to_u8()
    s[off + 21] = ((hi >> 8u32) & 0xFFu32).to_u8()
    s[off + 26] = (lo & 0xFFu32).to_u8()
    s[off + 27] = ((lo >> 8u32) & 0xFFu32).to_u8()
    s = _fdt_poke32(s, off + 28, size)
    s

fn _fdt_fat_sector() -> [u8]:
    var f = _fdt_zero_sector()
    f = _fdt_poke32(f, 0,  0x0FFFFFF8u32)
    f = _fdt_poke32(f, 4,  0x0FFFFFFFu32)
    f = _fdt_poke32(f, 8,  0x0FFFFFFFu32)      # cluster 2 = root dir, EOC
    f = _fdt_poke32(f, 60, 0x0FFFFFFFu32)      # cluster 15 = /FILE.O decoy, EOC
    f

fn _fdt_root_dir() -> [u8]:
    var s = _fdt_zero_sector()
    s = _fdt_put_entry(s, 0, "FILE", "O", 0x20u8, 15u32, 11u32)
    s

fn _fdt_file_data() -> [u8]:
    var s = _fdt_zero_sector()
    var i = 0
    while i < 11:
        s[i] = (i + 1).to_u8()
        i = i + 1
    s

fn _fdt_make_dev() -> FdtMockDev:
    var dev = FdtMockDev.new()
    dev = dev.with_sector(32u64, _fdt_fat_sector())
    dev = dev.with_sector(64u64, _fdt_root_dir())
    dev = dev.with_sector(77u64, _fdt_file_data())
    dev

fn _fdt_fs_from(dev: FdtMockDev) -> Fat32Filesystem:
    val r = dev.read_sector(64u64)
    Fat32Filesystem.make_for_dirent_test(32u32, 64u32, 512u32, 1u32, 32u32, r.unwrap())

fn _fdt_bytes(s: text) -> [u8]:
    var out: [u8] = []
    var i: u64 = 0
    while i < s.len():
        out.push(s.byte_at(i))
        i = i + 1
    out

fn _fdt_handle(cluster: u32, offset: u64, size: u64) -> FileHandle:
    FileHandle(
        fd: 0u64, start_cluster: cluster, current_cluster: cluster,
        offset: offset, file_size: size, is_open: true,
        dirent_sector: 64u64, dirent_offset: 0
    )

# ============================================================================
# Scenarios
# ============================================================================

describe "fat32_fd_table: write returns real disk-backed byte counts":

    it "a fresh create_at + register + write returns the payload's exact byte count":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)

        val h0 = fs.create_at(dev, "/GREET.TXT").unwrap()
        fat32_fd_register(1, 3, h0)
        val payload = _fdt_bytes("hello fat32!")
        val w = fat32_fd_write_from(1, 3, payload)
        assert_true(w.is_ok())
        expect(w.unwrap()).to_equal(payload.len() as u64)
        fat32_mount_clear()

    # NOTE: a "second write on the same fd, in a SEPARATE fat32_fd_write_from
    # call, appends correctly" example was attempted and dropped — it hits
    # the cross-call accessor wall described in this file's header (the
    # second call's freshly-fetched `fat32_mount_dev()` does not see the
    # first call's FAT-table cluster allocation, so the chain re-walk inside
    # Fat32Filesystem.write fails). Not committed as a red spec; see the
    # dated bug-doc section for the reproduction instead.

describe "fat32_fd_table: (task_id, fd) table mechanics":

    it "EBADF on an fd nothing ever registered":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)
        val w = fat32_fd_write_from(99, 42, _fdt_bytes("x"))
        assert_true(w.is_err())
        expect(w.unwrap_err()).to_equal(-9)
        fat32_mount_clear()

    it "clear-on-close means a reused fd number cannot observe a stale registration":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)

        val h0 = fs.create_at(dev, "/OLD.BIN").unwrap()
        fat32_fd_register(1, 13, h0)
        assert_true(fat32_fd_is_registered(1, 13))
        fat32_fd_clear(1, 13)
        assert_false(fat32_fd_is_registered(1, 13))

        val w = fat32_fd_write_from(1, 13, _fdt_bytes("x"))
        assert_true(w.is_err())
        expect(w.unwrap_err()).to_equal(-9)
        fat32_mount_clear()

    it "keys by (task_id, fd) — two tasks with the SAME fd number write independently, no crash or collision":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)

        val fd: i32 = 9
        val ha = fs.create_at(dev, "/A.TXT").unwrap()
        fat32_fd_register(1, fd, ha)
        val hb = fs.create_at(dev, "/B.TXT").unwrap()
        fat32_fd_register(2, fd, hb)

        step("task 1's write on fd 9 succeeds with task 1's payload length")
        val wa = fat32_fd_write_from(1, fd, _fdt_bytes("AAAA"))
        assert_true(wa.is_ok())
        expect(wa.unwrap()).to_equal(4u64)

        step("task 2's write on the SAME fd number succeeds independently with task 2's payload length")
        val wb = fat32_fd_write_from(2, fd, _fdt_bytes("BBBBBB"))
        assert_true(wb.is_ok())
        expect(wb.unwrap()).to_equal(6u64)

        step("task 1's entry is still registered and unaffected by task 2's write")
        assert_true(fat32_fd_is_registered(1, fd))
        assert_true(fat32_fd_is_registered(2, fd))
        fat32_mount_clear()

describe "fat32_fd_table: canonical generation-safe file objects":

    it "registration assigns monotonic nonzero identities and fd reuse never revives the retired identity":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        fat32_fd_register(7u64, 3, _fdt_handle(15u32, 0u64, 11u64))
        val first_id = fat32_fd_object_id(7u64, 3)
        assert_true(first_id > 0u64)

        fat32_fd_clear(7u64, 3)
        expect(fat32_fd_object_id(7u64, 3)).to_equal(0u64)
        val stale = fat32_fd_read_object_at_into(first_id, 0u64, [])
        assert_true(stale.is_err())
        expect(stale.unwrap_err()).to_equal(-9)

        fat32_fd_register(7u64, 3, _fdt_handle(16u32, 0u64, 4u64))
        val replacement_id = fat32_fd_object_id(7u64, 3)
        assert_true(replacement_id > first_id)

    it "dup-style aliases share one identity and clearing one alias keeps the object live":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        fat32_fd_register(8u64, 4, _fdt_handle(15u32, 2u64, 11u64))
        val object_id = fat32_fd_object_id(8u64, 4)
        val alias_r = fat32_fd_alias(8u64, 4, 8u64, 9)
        assert_true(alias_r.is_ok())
        expect(alias_r.unwrap()).to_equal(object_id)
        expect(fat32_fd_object_id(8u64, 9)).to_equal(object_id)

        fat32_fd_clear(8u64, 4)
        expect(fat32_fd_object_id(8u64, 4)).to_equal(0u64)
        expect(fat32_fd_object_id(8u64, 9)).to_equal(object_id)
        val live_but_unmounted = fat32_fd_read_object_at_into(object_id, 0u64, [])
        assert_true(live_but_unmounted.is_err())
        expect(live_but_unmounted.unwrap_err()).to_equal(-38)

        fat32_fd_clear(8u64, 9)
        val retired = fat32_fd_read_object_at_into(object_id, 0u64, [])
        assert_true(retired.is_err())
        expect(retired.unwrap_err()).to_equal(-9)

    it "task teardown retires only that task's aliases and preserves a cross-task alias":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        fat32_fd_register(10u64, 5, _fdt_handle(15u32, 0u64, 11u64))
        val object_id = fat32_fd_object_id(10u64, 5)
        val alias_r = fat32_fd_alias(10u64, 5, 11u64, 5)
        assert_true(alias_r.is_ok())

        fat32_fd_clear_task(10u64)
        expect(fat32_fd_object_id(10u64, 5)).to_equal(0u64)
        expect(fat32_fd_object_id(11u64, 5)).to_equal(object_id)

        fat32_fd_clear_task(11u64)
        val retired = fat32_fd_read_object_at_into(object_id, 0u64, [])
        assert_true(retired.is_err())
        expect(retired.unwrap_err()).to_equal(-9)

describe "fat32_fd_table: positioned operations preserve the shared cursor":

    it "positioned read leaves the next sequential read at the alias-shared cursor":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)
        fat32_fd_register(20u64, 6, _fdt_handle(15u32, 2u64, 11u64))
        val object_id = fat32_fd_object_id(20u64, 6)
        val alias_r = fat32_fd_alias(20u64, 6, 20u64, 7)
        assert_true(alias_r.is_ok())

        var positioned = [0u8]
        val positioned_r = fat32_fd_read_object_at_into(object_id, 5u64, positioned)
        assert_true(positioned_r.is_ok())
        expect(positioned_r.unwrap()).to_equal(1u64)
        expect(positioned[0]).to_equal(6u8)

        var sequential = [0u8]
        val sequential_r = fat32_fd_read_into(20u64, 7, sequential)
        assert_true(sequential_r.is_ok())
        expect(sequential_r.unwrap()).to_equal(1u64)
        expect(sequential[0]).to_equal(3u8)
        fat32_mount_clear()

    it "positioned write commits extended metadata but does not advance the cursor":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)
        val handle = fs.create_at(dev, "/POS.BIN").unwrap()
        fat32_fd_register(21u64, 8, handle)
        val object_id = fat32_fd_object_id(21u64, 8)

        val positioned_r = fat32_fd_write_object_at_from(
            object_id, 0u64, _fdt_bytes("abc"))
        assert_true(positioned_r.is_ok())
        expect(positioned_r.unwrap()).to_equal(3u64)

        # Metadata now says file_size=3 while the preserved cursor is still 0.
        # A sequential write must therefore overwrite from zero and advance
        # the canonical cursor to four.
        val sequential_r = fat32_fd_write_from(
            21u64, 8, _fdt_bytes("next"))
        assert_true(sequential_r.is_ok())
        expect(sequential_r.unwrap()).to_equal(4u64)
        var next_byte = [0u8]
        val cursor_read = fat32_fd_read_into(21u64, 8, next_byte)
        assert_true(cursor_read.is_ok())
        expect(cursor_read.unwrap()).to_equal(0u64)
        fat32_mount_clear()

describe "fat32_fd_table: sequential writes use the canonical cursor":

    it "appends when the cursor is already at end of file":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)
        val h0 = fs.create_at(dev, "/OK.BIN").unwrap()
        expect(h0.offset).to_equal(h0.file_size)
        fat32_fd_register(1, 20, h0)
        val w = fat32_fd_write_from(1, 20, _fdt_bytes("ok"))
        assert_true(w.is_ok())
        fat32_mount_clear()

    it "overwrites from a reopened file cursor instead of silently appending":
        fat32_mount_clear()
        fat32_fd_clear_for_test()
        val dev = _fdt_make_dev()
        val fs = _fdt_fs_from(dev)
        fat32_mount_publish(fs, dev)

        step("hand-construct a handle the way a reopened non-empty file would look: offset 0, file_size > 0")
        val fake = FileHandle(
            fd: 0u64, start_cluster: 15u32, current_cluster: 15u32,
            offset: 0u64, file_size: 11u64, is_open: true,
            dirent_sector: 0u64, dirent_offset: 0
        )
        fat32_fd_register(1, 21, fake)
        val w = fat32_fd_write_from(1, 21, _fdt_bytes("clobber"))
        assert_true(w.is_ok())
        expect(w.unwrap()).to_equal(7u64)
        val object_id = fat32_fd_object_id(1, 21)
        var first = [0u8]
        val positioned = fat32_fd_read_object_at_into(object_id, 0u64, first)
        assert_true(positioned.is_ok())
        expect(positioned.unwrap()).to_equal(1u64)
        expect(first[0]).to_equal(0x63u8)
        fat32_mount_clear()
