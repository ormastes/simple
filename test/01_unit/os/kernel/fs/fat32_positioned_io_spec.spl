# @req: REQ-OS-KERNEL-001

"""
# FAT32 positioned I/O

Focused evidence for cursor-independent `read_at` and `write_at` primitives.
The mock returns poison for absent data sectors so hole zero-fill cannot pass by
accident. Tests cover cross-cluster reads, in-place overwrite, extension,
zero-filled holes, FAT32 size limits, cursor preservation, and dirent metadata.
"""

use std.spec.{describe, it, expect, step, assert_true}
use os.kernel.fs.fat32.{Fat32Filesystem, FileHandle}

struct PositionedSector:
    lba: u64
    data: [u8]

class PositionedDev:
    sectors: [PositionedSector]
    write_count: i32
    fat_read_count: i32
    mutate_fat_on_data_read: bool

impl PositionedDev:
    static fn new() -> PositionedDev:
        PositionedDev(sectors: [], write_count: 0, fat_read_count: 0, mutate_fat_on_data_read: false)

    me fn with_sector(lba: u64, data: [u8]) -> PositionedDev:
        self.sectors.push(PositionedSector(lba: lba, data: data))
        self

    me fn with_fat_mutation_on_data_read() -> PositionedDev:
        self.mutate_fat_on_data_read = true
        self

    fn read_sector(lba: u64) -> Result<[u8], text>:
        if lba == 32u64:
            self.fat_read_count = self.fat_read_count + 1
        if lba == 64u64 and self.mutate_fat_on_data_read:
            var fi = 0
            while fi < self.sectors.len():
                if self.sectors[fi].lba == 32u64:
                    self.sectors[fi] = PositionedSector(
                        lba: 32u64, data: _poke32(self.sectors[fi].data, 8, 4u32))
                fi = fi + 1
            self.mutate_fat_on_data_read = false
        var i = 0
        while i < self.sectors.len():
            if self.sectors[i].lba == lba:
                return Ok(self.sectors[i].data)
            i = i + 1
        Ok(_filled_sector(0xAAu8))

    fn write_sector(lba: u64, data: [u8]) -> Result<(), text>:
        self.write_count = self.write_count + 1
        var i = 0
        while i < self.sectors.len():
            if self.sectors[i].lba == lba:
                self.sectors[i] = PositionedSector(lba: lba, data: data)
                return Ok(())
            i = i + 1
        self.sectors.push(PositionedSector(lba: lba, data: data))
        Ok(())

fn _filled_sector(value: u8) -> [u8]:
    var bytes: [u8] = []
    var i = 0
    while i < 512:
        bytes.push(value)
        i = i + 1
    bytes

fn _buffer(size: i32) -> [u8]:
    _filled_prefix(size, 0u8)

fn _filled_prefix(size: i32, value: u8) -> [u8]:
    var bytes: [u8] = []
    var i = 0
    while i < size:
        bytes.push(value)
        i = i + 1
    bytes

fn _poke32(buf: [u8], offset: i32, value: u32) -> [u8]:
    buf[offset] = (value & 0xFFu32).to_u8()
    buf[offset + 1] = ((value >> 8u32) & 0xFFu32).to_u8()
    buf[offset + 2] = ((value >> 16u32) & 0xFFu32).to_u8()
    buf[offset + 3] = ((value >> 24u32) & 0xFFu32).to_u8()
    buf

fn _fat_with_chain(second_cluster: bool) -> [u8]:
    var fat = _filled_sector(0u8)
    fat = _poke32(fat, 0, 0x0FFFFFF8u32)
    fat = _poke32(fat, 4, 0x0FFFFFFFu32)
    if second_cluster:
        fat = _poke32(fat, 8, 3u32)
        fat = _poke32(fat, 12, 0x0FFFFFFFu32)
    else:
        fat = _poke32(fat, 8, 0x0FFFFFFFu32)
    fat

fn _fat_with_entries(cluster_2: u32, cluster_3: u32) -> [u8]:
    var fat = _filled_sector(0u8)
    fat = _poke32(fat, 0, 0x0FFFFFF8u32)
    fat = _poke32(fat, 4, 0x0FFFFFFFu32)
    fat = _poke32(fat, 8, cluster_2)
    fat = _poke32(fat, 12, cluster_3)
    fat

fn _fs() -> Fat32Filesystem:
    Fat32Filesystem.make_for_alloc_test(32u32, 64u32, 512u32, 1u32, 32u32)

fn _handle(start_cluster: u32, size: u64, cursor: u64) -> FileHandle:
    FileHandle(
        fd: 17u64,
        start_cluster: start_cluster,
        current_cluster: start_cluster,
        offset: cursor,
        file_size: size,
        is_open: true,
        dirent_sector: 0u64,
        dirent_offset: 0
    )

fn _root_dir_for_empty_file() -> [u8]:
    var root = _filled_sector(0u8)
    root[0] = 0x54u8
    root[1] = 0x45u8
    root[2] = 0x53u8
    root[3] = 0x54u8
    root[4] = 0x20u8
    root[5] = 0x20u8
    root[6] = 0x20u8
    root[7] = 0x20u8
    root[8] = 0x42u8
    root[9] = 0x49u8
    root[10] = 0x4Eu8
    root[11] = 0x20u8
    root

fn _peek32(buf: [u8], offset: i32) -> u32:
    buf[offset].to_u32() |
        (buf[offset + 1].to_u32() << 8u32) |
        (buf[offset + 2].to_u32() << 16u32) |
        (buf[offset + 3].to_u32() << 24u32)

describe "FAT32 positioned I/O":

    it "reads across a cluster boundary without advancing the handle cursor":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(true))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        dev = dev.with_sector(65u64, _filled_sector(0x22u8))
        val fs = _fs()
        val h = _handle(2u32, 1024u64, 91u64)
        var out = _buffer(4)
        step("read two bytes on each side of the 512-byte boundary")
        val result = fs.read_at(dev, h, 510u64, out)
        assert_true(result.is_ok())
        expect(result.unwrap()).to_equal(4u64)
        expect(out[0]).to_equal(0x11u8)
        expect(out[1]).to_equal(0x11u8)
        expect(out[2]).to_equal(0x22u8)
        expect(out[3]).to_equal(0x22u8)
        expect(h.offset).to_equal(91u64)

    it "streams a second-cluster positioned read without a full-chain array":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(true))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        dev = dev.with_sector(65u64, _filled_sector(0x22u8))
        val fs = _fs()
        val h = _handle(2u32, 1024u64, 37u64)
        var out = _buffer(2)
        step("walk exactly one FAT link to the explicit second-cluster offset")
        val result = fs.read_at(dev, h, 512u64, out)
        assert_true(result.is_ok())
        expect(result.unwrap()).to_equal(2u64)
        expect(out[0]).to_equal(0x22u8)
        expect(out[1]).to_equal(0x22u8)
        expect(dev.fat_read_count).to_equal(2)
        expect(h.offset).to_equal(37u64)

    it "rejects a truncated chain before reading a requested later cluster":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        val fs = _fs()
        val h = _handle(2u32, 1024u64, 0u64)
        var out = _buffer(1)
        step("request bytes beyond an early end-of-chain marker")
        val result = fs.read_at(dev, h, 512u64, out)
        assert_true(result.is_err())
        expect(result.unwrap_err()).to_equal(-5)

    it "rejects first-cluster corruption before copying caller memory":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_entries(0u32, 0x0FFFFFFFu32))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        val fs = _fs()
        val h = _handle(2u32, 1u64, 0u64)
        var out = _filled_prefix(1, 0x7Cu8)
        val result = fs.read_at(dev, h, 0u64, out)
        assert_true(result.is_err())
        expect(result.unwrap_err()).to_equal(-5)
        expect(out[0]).to_equal(0x7Cu8)

    it "validates a later bad cluster before a cross-boundary copy":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_entries(3u32, 0x0FFFFFF7u32))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        dev = dev.with_sector(65u64, _filled_sector(0x22u8))
        val fs = _fs()
        val h = _handle(2u32, 1024u64, 0u64)
        var out = _filled_prefix(4, 0x7Cu8)
        val result = fs.read_at(dev, h, 510u64, out)
        assert_true(result.is_err())
        expect(result.unwrap_err()).to_equal(-5)
        expect(out[0]).to_equal(0x7Cu8)
        expect(out[3]).to_equal(0x7Cu8)

    it "rejects reserved and out-of-volume start clusters":
        # @req: REQ-OS-KERNEL-001
        val dev = PositionedDev.new()
        val fs = _fs()
        var out = _filled_prefix(1, 0x7Cu8)
        val reserved = fs.read_at(dev, _handle(0x0FFFFFF0u32, 1u64, 0u64), 0u64, out)
        val outside = fs.read_at(dev, _handle(34u32, 1u64, 0u64), 0u64, out)
        assert_true(reserved.is_err())
        assert_true(outside.is_err())
        expect(reserved.unwrap_err()).to_equal(-5)
        expect(outside.unwrap_err()).to_equal(-5)
        expect(out[0]).to_equal(0x7Cu8)

    it "copies through the validated request snapshot when the FAT changes later":
        # @req: REQ-OS-KERNEL-001
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(true))
        dev = dev.with_sector(64u64, _filled_sector(0x11u8))
        dev = dev.with_sector(65u64, _filled_sector(0x22u8))
        dev = dev.with_sector(66u64, _filled_sector(0x44u8))
        dev = dev.with_fat_mutation_on_data_read()
        val fs = _fs()
        val h = _handle(2u32, 1024u64, 0u64)
        var out = _buffer(4)
        step("change cluster 2's FAT link after validation but before boundary copy")
        val result = fs.read_at(dev, h, 510u64, out)
        assert_true(result.is_ok())
        expect(out[0]).to_equal(0x11u8)
        expect(out[1]).to_equal(0x11u8)
        expect(out[2]).to_equal(0x22u8)
        expect(out[3]).to_equal(0x22u8)

    it "overwrites in place without changing file size cursor or adjacent bytes":
        # @req: REQ-OS-KERNEL-001
        step("Verify: overwrites in place without changing file size cursor or adjacent bytes")
        var data = _filled_sector(0x31u8)
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        dev = dev.with_sector(64u64, data)
        val fs = _fs()
        val h = _handle(2u32, 512u64, 77u64)
        val result = fs.write_at(dev, h, 100u64, [0x41u8, 0x42u8, 0x43u8])
        assert_true(result.is_ok())
        val updated = result.unwrap()
        expect(updated.file_size).to_equal(512u64)
        expect(updated.offset).to_equal(77u64)
        val stored = dev.read_sector(64u64).unwrap()
        expect(stored[99]).to_equal(0x31u8)
        expect(stored[100]).to_equal(0x41u8)
        expect(stored[102]).to_equal(0x43u8)
        expect(stored[103]).to_equal(0x31u8)

    it "extends a write across a cluster boundary and returns the new size":
        # @req: REQ-OS-KERNEL-001
        step("Verify: extends a write across a cluster boundary and returns the new size")
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        dev = dev.with_sector(64u64, _filled_sector(0x55u8))
        val fs = _fs()
        val h = _handle(2u32, 512u64, 29u64)
        val result = fs.write_at(dev, h, 510u64, [1u8, 2u8, 3u8, 4u8])
        assert_true(result.is_ok())
        val updated = result.unwrap()
        expect(updated.start_cluster).to_equal(2u32)
        expect(updated.file_size).to_equal(514u64)
        expect(updated.offset).to_equal(29u64)
        val first = dev.read_sector(64u64).unwrap()
        val second = dev.read_sector(65u64).unwrap()
        expect(first[510]).to_equal(1u8)
        expect(first[511]).to_equal(2u8)
        expect(second[0]).to_equal(3u8)
        expect(second[1]).to_equal(4u8)

    it "zero fills an extending hole even when new storage reads as poison":
        # @req: REQ-OS-KERNEL-001
        var first = _filled_sector(0xCCu8)
        first[0] = 9u8
        first[1] = 8u8
        first[2] = 7u8
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        dev = dev.with_sector(64u64, first)
        val fs = _fs()
        val h = _handle(2u32, 3u64, 44u64)
        step("leave a 512-byte hole, then place two bytes in cluster 3")
        val result = fs.write_at(dev, h, 515u64, [0xD1u8, 0xD2u8])
        assert_true(result.is_ok())
        val updated = result.unwrap()
        expect(updated.file_size).to_equal(517u64)
        expect(updated.offset).to_equal(44u64)
        val c2 = dev.read_sector(64u64).unwrap()
        val c3 = dev.read_sector(65u64).unwrap()
        expect(c2[0]).to_equal(9u8)
        expect(c2[2]).to_equal(7u8)
        expect(c2[3]).to_equal(0u8)
        expect(c2[511]).to_equal(0u8)
        expect(c3[0]).to_equal(0u8)
        expect(c3[2]).to_equal(0u8)
        expect(c3[3]).to_equal(0xD1u8)
        expect(c3[4]).to_equal(0xD2u8)

    it "rejects overflowing and over-FAT32-size ranges before device mutation":
        # @req: REQ-OS-KERNEL-001
        step("Verify: rejects overflowing and over-FAT32-size ranges before device mutation")
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        val fs = _fs()
        val h = _handle(2u32, 1u64, 5u64)
        val writes_before = dev.write_count
        val overflow = fs.write_at(dev, h, 0xFFFFFFFFFFFFFFFFu64, [1u8, 2u8])
        assert_true(overflow.is_err())
        expect(overflow.unwrap_err()).to_equal(-27)  # oracle: -27 — named expected value from the requirement
        val too_large = fs.write_at(dev, h, 0xFFFFFFFFu64, [1u8])
        assert_true(too_large.is_err())
        expect(too_large.unwrap_err()).to_equal(-27)  # oracle: -27 — named expected value from the requirement
        expect(dev.write_count).to_equal(writes_before)

    it "persists the allocated start cluster and positioned file size in the dirent":
        # @req: REQ-OS-KERNEL-001
        step("Verify: persists the allocated start cluster and positioned file size in the dirent")
        val root = _root_dir_for_empty_file()
        val fs = Fat32Filesystem.make_for_dirent_test(32u32, 64u32, 512u32, 1u32, 32u32, root)
        var dev = PositionedDev.new()
        dev = dev.with_sector(32u64, _fat_with_chain(false))
        dev = dev.with_sector(64u64, root)
        val opened = fs.open("/TEST.BIN")
        assert_true(opened.is_ok())
        val h = opened.unwrap()
        val result = fs.write_at(dev, h, 4u64, [0x5Au8])
        assert_true(result.is_ok())
        val updated = result.unwrap()
        expect(updated.start_cluster).to_equal(3u32)
        expect(updated.file_size).to_equal(5u64)
        expect(updated.offset).to_equal(0u64)
        val dirent = dev.read_sector(64u64).unwrap()
        expect(dirent[26]).to_equal(3u8)
        expect(dirent[27]).to_equal(0u8)
        expect(_peek32(dirent, 28)).to_equal(5u32)
        val data = dev.read_sector(65u64).unwrap()
        expect(data[0]).to_equal(0u8)
        expect(data[3]).to_equal(0u8)
        expect(data[4]).to_equal(0x5Au8)
