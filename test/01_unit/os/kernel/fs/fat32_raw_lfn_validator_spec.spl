"""Static correctness coverage for the bounded raw FAT32 LFN trust boundary."""

use std.spec.{describe, it, expect}
use os.kernel.fs.fat32.{fat32_dir_find_entry, fat32_dir_list_entries,
    fat32_short_field, fat32_lfn_checksum, fat32_make_lfn_slot, fat32_make_dirent}

fn _append_slot(buf: [u8], slot: [u8]) -> [u8]:
    var out = buf
    var i = 0
    while i < slot.len():
        out.push(slot[i])
        i = i + 1
    out

fn _valid_two_slot_dir() -> [u8]:
    val field = fat32_short_field("HELLO~1.TXT")
    val checksum = fat32_lfn_checksum(field)
    var out: [u8] = []
    out = _append_slot(out, fat32_make_lfn_slot("hello-world.txt", 2, 2, checksum))
    out = _append_slot(out, fat32_make_lfn_slot("hello-world.txt", 1, 2, checksum))
    out = _append_slot(out, fat32_make_dirent(field, 0x20u8, 4u32, 7u32))
    out.push(0u8)
    out

describe "raw FAT32 LFN association validator":
    it "accepts an ordered checksummed chain and its canonical alias":
        val raw = _valid_two_slot_dir()
        expect(fat32_dir_find_entry(raw, "hello-world.txt")).to_equal(64)
        expect(fat32_dir_find_entry(raw, "HELLO~1.TXT")).to_equal(64)
        expect(fat32_dir_list_entries(raw)).to_equal(["hello-world.txt"])

    it "rejects ordinal gaps and does not expose the following alias":
        var raw = _valid_two_slot_dir()
        raw[32] = 0x02u8
        expect(fat32_dir_find_entry(raw, "hello-world.txt")).to_equal(-1)
        expect(fat32_dir_find_entry(raw, "HELLO~1.TXT")).to_equal(-1)
        expect(fat32_dir_list_entries(raw)).to_equal([])

    it "rejects checksum type and cluster-field corruption":
        var checksum_bad = _valid_two_slot_dir()
        checksum_bad[13] = (checksum_bad[13].to_u32() + 1u32).to_u8()
        expect(fat32_dir_find_entry(checksum_bad, "HELLO~1.TXT")).to_equal(-1)
        var type_bad = _valid_two_slot_dir()
        type_bad[12] = 1u8
        expect(fat32_dir_find_entry(type_bad, "HELLO~1.TXT")).to_equal(-1)
        var cluster_bad = _valid_two_slot_dir()
        cluster_bad[26] = 1u8
        expect(fat32_dir_find_entry(cluster_bad, "HELLO~1.TXT")).to_equal(-1)

    it "does not resynchronize a corrupt intermediate slot as a bare alias":
        var raw = _valid_two_slot_dir()
        raw[43] = 0x0Eu8
        expect(fat32_dir_find_entry(raw, "HELLO~1.TXT")).to_equal(-1)
        expect(fat32_dir_list_entries(raw)).to_equal([])

    it "rejects invalid LAST placement and reserved ordinal bits":
        var missing_last = _valid_two_slot_dir()
        missing_last[0] = 0x02u8
        expect(fat32_dir_find_entry(missing_last, "HELLO~1.TXT")).to_equal(-1)
        var duplicate_last = _valid_two_slot_dir()
        duplicate_last[32] = 0x41u8
        expect(fat32_dir_find_entry(duplicate_last, "HELLO~1.TXT")).to_equal(-1)
        var reserved = _valid_two_slot_dir()
        reserved[0] = (reserved[0].to_u32() | 0x80u32).to_u8()
        expect(fat32_dir_find_entry(reserved, "HELLO~1.TXT")).to_equal(-1)

    it "rejects malformed terminator padding and forbidden characters":
        var padding_bad = _valid_two_slot_dir()
        padding_bad[7] = 0x41u8
        padding_bad[8] = 0u8
        expect(fat32_dir_find_entry(padding_bad, "HELLO~1.TXT")).to_equal(-1)
        var slash_bad = _valid_two_slot_dir()
        slash_bad[33] = 0x2Fu8
        slash_bad[34] = 0u8
        expect(fat32_dir_find_entry(slash_bad, "HELLO~1.TXT")).to_equal(-1)

    it "accepts a paired surrogate and rejects lone surrogates":
        var paired = _valid_two_slot_dir()
        paired[33] = 0x3Du8
        paired[34] = 0xD8u8
        paired[35] = 0x00u8
        paired[36] = 0xDEu8
        expect(fat32_dir_find_entry(paired, "HELLO~1.TXT")).to_equal(64)
        var lone = _valid_two_slot_dir()
        lone[33] = 0x3Du8
        lone[34] = 0xD8u8
        lone[35] = 0x41u8
        lone[36] = 0u8
        expect(fat32_dir_find_entry(lone, "HELLO~1.TXT")).to_equal(-1)

    it "accepts a surrogate pair split across adjacent slots":
        var split = _valid_two_slot_dir()
        split[60] = 0x3Du8
        split[61] = 0xD8u8
        split[1] = 0x00u8
        split[2] = 0xDEu8
        expect(fat32_dir_find_entry(split, "HELLO~1.TXT")).to_equal(64)

    it "rejects a chain whose declared size exceeds the twenty-slot bound":
        var raw: [u8] = []
        var slot_index = 0
        while slot_index < 21:
            var slot: [u8] = []
            var byte_index = 0
            while byte_index < 32:
                slot.push(0u8)
                byte_index = byte_index + 1
            slot[0] = (21 - slot_index).to_u8()
            if slot_index == 0:
                slot[0] = (slot[0].to_u32() | 0x40u32).to_u8()
            slot[11] = 0x0Fu8
            raw = _append_slot(raw, slot)
            slot_index = slot_index + 1
        raw = _append_slot(raw, fat32_make_dirent(fat32_short_field("TOOL.TXT"), 0x20u8, 4u32, 7u32))
        raw.push(0u8)
        expect(fat32_dir_find_entry(raw, "TOOL.TXT")).to_equal(-1)

    it "rejects noncanonical short-name padding even without an LFN":
        val field = fat32_short_field("HELLO.TXT")
        var raw = fat32_make_dirent(field, 0x20u8, 4u32, 7u32)
        raw[1] = 0x20u8
        raw[2] = 0x41u8
        raw.push(0u8)
        expect(fat32_dir_find_entry(raw, "HAT.TXT")).to_equal(-1)

    it "preserves OEM bytes and the raw 0x05 first-byte checksum association":
        var field = fat32_short_field("EFILE.TXT")
        field[0] = 0x05u8
        field[1] = 0x80u8
        val checksum = fat32_lfn_checksum(field)
        var raw: [u8] = []
        raw = _append_slot(raw, fat32_make_lfn_slot("long-name.txt", 1, 1, checksum))
        raw = _append_slot(raw, fat32_make_dirent(field, 0x20u8, 4u32, 7u32))
        raw.push(0u8)
        expect(fat32_dir_find_entry(raw, "long-name.txt")).to_equal(32)

    it "does not Unicode-fold distinct opaque OEM short-name bytes":
        var upper_field = fat32_short_field("AFILE.TXT")
        upper_field[0] = 0xC0u8
        var lower_field = fat32_short_field("BFILE.TXT")
        lower_field[0] = 0xE0u8
        var raw: [u8] = []
        raw = _append_slot(raw, fat32_make_dirent(upper_field, 0x20u8, 4u32, 7u32))
        raw = _append_slot(raw, fat32_make_dirent(lower_field, 0x20u8, 5u32, 8u32))
        raw.push(0u8)
        val upper_query = upper_field[0].chr() + "FILE.TXT"
        val lower_query = lower_field[0].chr() + "FILE.TXT"
        expect(fat32_dir_find_entry(raw, upper_query)).to_equal(0)
        expect(fat32_dir_find_entry(raw, lower_query)).to_equal(32)

    it "rejects reserved attr and NTRes bits and honors lowercase flags":
        val field = fat32_short_field("HELLO.TXT")
        var attr_bad = fat32_make_dirent(field, 0x60u8, 4u32, 7u32)
        attr_bad.push(0u8)
        expect(fat32_dir_find_entry(attr_bad, "HELLO.TXT")).to_equal(-1)
        var nt_bad = fat32_make_dirent(field, 0x20u8, 4u32, 7u32)
        nt_bad[12] = 0x01u8
        nt_bad.push(0u8)
        expect(fat32_dir_find_entry(nt_bad, "HELLO.TXT")).to_equal(-1)
        var lowercase = fat32_make_dirent(field, 0x20u8, 4u32, 7u32)
        lowercase[12] = 0x18u8
        lowercase.push(0u8)
        expect(fat32_dir_list_entries(lowercase)).to_equal(["hello.txt"])
        var opaque_oem = fat32_make_dirent(field, 0x20u8, 4u32, 7u32)
        opaque_oem[0] = 0xC0u8
        opaque_oem[12] = 0x08u8
        opaque_oem.push(0u8)
        val names = fat32_dir_list_entries(opaque_oem)
        expect(names.len()).to_equal(1)
        expect(names[0].char_code_at(0)).to_equal(0xC0)

    it "keeps canonical dot entries and rejects dot metadata flags":
        var dot = fat32_make_dirent(fat32_short_field("."), 0x10u8, 2u32, 0u32)
        dot.push(0u8)
        expect(fat32_dir_list_entries(dot)).to_equal(["."])
        var flagged_dot = fat32_make_dirent(fat32_short_field(".."), 0x10u8, 2u32, 0u32)
        flagged_dot[12] = 0x08u8
        flagged_dot.push(0u8)
        expect(fat32_dir_list_entries(flagged_dot)).to_equal([])
        var archive_dot = fat32_make_dirent(fat32_short_field("."), 0x20u8, 2u32, 0u32)
        archive_dot.push(0u8)
        expect(fat32_dir_list_entries(archive_dot)).to_equal([])
        var sized_dot = fat32_make_dirent(fat32_short_field(".."), 0x10u8, 2u32, 1u32)
        sized_dot.push(0u8)
        expect(fat32_dir_list_entries(sized_dot)).to_equal([])
