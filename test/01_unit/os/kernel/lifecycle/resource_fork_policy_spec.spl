# @req REQ-001 REQ-003 REQ-010 NFR-001 NFR-002 NFR-003
# @cover src/os/kernel/lifecycle/resource_fork_policy.spl 80%
# @tag: unit, simpleos, kernel, lifecycle, device, dma, fork

use std.spec.*
use os.kernel.lifecycle.resource_fork_policy.*

describe "task resource fork inheritance policy":
    it "allows empty, notification, and IRQ ownership":
        # @covers RFP_KIND:true
        expect(resource_fork_inheritable(FORK_RES_NONE)).to_be(true)
        expect(resource_fork_inheritable(FORK_RES_NOTIFICATION)).to_be(true)
        expect(resource_fork_inheritable(FORK_RES_IRQ_ROUTE)).to_be(true)

    it "denies DMA buffers and BAR mappings":
        # @covers RFP_KIND:false
        expect(resource_fork_inheritable(FORK_RES_DMA_BUFFER)).to_be(false)
        expect(resource_fork_inheritable(FORK_RES_BAR_MAPPING)).to_be(false)

    it "denies unknown future resource kinds conservatively":
        expect(resource_fork_inheritable(255u8)).to_be(false)

    it "allows an empty or entirely inheritable resource set":
        # @covers RFP_SET:true
        expect(resource_set_fork_allowed([])).to_be(true)
        expect(resource_set_fork_allowed([FORK_RES_NOTIFICATION,
            FORK_RES_IRQ_ROUTE])).to_be(true)

    it "denies a DMA resource at any position":
        # @covers RFP_SET:false
        expect(resource_set_fork_allowed([FORK_RES_DMA_BUFFER,
            FORK_RES_NOTIFICATION])).to_be(false)
        expect(resource_set_fork_allowed([FORK_RES_NOTIFICATION,
            FORK_RES_DMA_BUFFER])).to_be(false)

    it "denies a BAR mapping mixed with otherwise inheritable resources":
        expect(resource_set_fork_allowed([FORK_RES_NOTIFICATION,
            FORK_RES_BAR_MAPPING, FORK_RES_IRQ_ROUTE])).to_be(false)
