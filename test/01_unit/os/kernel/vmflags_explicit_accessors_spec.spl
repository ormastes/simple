# @req REQ-VMFLAGS-ACCESSOR-BIT-IDENTITY
# Native acceptance is UNRUN. Calls the real canonical owner; no property fallback.
use std.spec.{describe, it, expect}
use os.kernel.types.memory_types.{VmFlags}

describe "VmFlags explicit accessor bit identity":
    it "keeps all permissions absent for zero bits":
        val flags = VmFlags(bits: 0u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)

    it "keeps present independent of writable and user":
        val flags = VmFlags(bits: 1u32)
        expect(flags.present()).to_be(true)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)

    it "keeps writable independent of present and user":
        val flags = VmFlags(bits: 2u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(true)
        expect(flags.user()).to_be(false)

    it "keeps user independent of present and writable":
        val flags = VmFlags(bits: 4u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(true)

    it "keeps present and user set while writable stays absent":
        val flags = VmFlags(bits: 5u32)
        expect(flags.present()).to_be(true)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(true)

    it "keeps write through independent of every other permission":
        val flags = VmFlags(bits: 8u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)
        expect(flags.write_through()).to_be(true)
        expect(flags.cache_disable()).to_be(false)
        expect(flags.no_execute()).to_be(false)

    it "keeps cache disable independent of every other permission":
        val flags = VmFlags(bits: 16u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)
        expect(flags.write_through()).to_be(false)
        expect(flags.cache_disable()).to_be(true)
        expect(flags.no_execute()).to_be(false)

    it "keeps no execute independent of every other permission":
        val flags = VmFlags(bits: 32u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)
        expect(flags.write_through()).to_be(false)
        expect(flags.cache_disable()).to_be(false)
        expect(flags.no_execute()).to_be(true)

    it "keeps all known permission bits set together":
        val flags = VmFlags(bits: 63u32)
        expect(flags.present()).to_be(true)
        expect(flags.writable()).to_be(true)
        expect(flags.user()).to_be(true)
        expect(flags.write_through()).to_be(true)
        expect(flags.cache_disable()).to_be(true)
        expect(flags.no_execute()).to_be(true)

    it "keeps a reserved bit separate from all known permissions":
        val flags = VmFlags(bits: 128u32)
        expect(flags.present()).to_be(false)
        expect(flags.writable()).to_be(false)
        expect(flags.user()).to_be(false)
        expect(flags.write_through()).to_be(false)
        expect(flags.cache_disable()).to_be(false)
        expect(flags.no_execute()).to_be(false)
