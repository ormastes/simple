use os.kernel.arch.arm64.compiler_filesystem_metadata_source_v2.{
    arm64_cfs_fw_cfg_field_plan_v2,
    arm64_cfs_collect_fw_cfg_reads_v2,
    arm64_cfs_read_fw_cfg_metadata_with_batch_reader_v2,
}
use os.kernel.fw_cfg.directory_batch_parser_v1.{FwCfgNamedLimitV1}
use os.kernel.fw_cfg.read_result_v1.{SimpleOsFwCfgReadV1}
use os.port.init.compiler_filesystem_metadata_v2.{
    SimpleOsCfsRawReadV2,
    SimpleOsCfsMetadataReadsV2,
}

fn metadata_read(value: text) -> SimpleOsCfsRawReadV2:
    SimpleOsCfsRawReadV2(ok: true, bytes: value.bytes(), reason: "ok")

var batch_reader_calls: i64 = 0
var batch_reader_request_count: i64 = 0

fn injected_batch_reader(
    requests: [FwCfgNamedLimitV1]
) -> [SimpleOsFwCfgReadV1]:
    batch_reader_calls = batch_reader_calls + 1
    batch_reader_request_count = requests.len()
    [
        SimpleOsFwCfgReadV1(ok: true, bytes: "nonce".bytes(), reason: "ok"),
        SimpleOsFwCfgReadV1(ok: true, bytes: "/cfs.img".bytes(), reason: "ok"),
        SimpleOsFwCfgReadV1(ok: true, bytes: "hash".bytes(), reason: "ok"),
        SimpleOsFwCfgReadV1(ok: true, bytes: "drive".bytes(), reason: "ok"),
    ]

fn short_batch_reader(
    requests: [FwCfgNamedLimitV1]
) -> [SimpleOsFwCfgReadV1]:
    [SimpleOsFwCfgReadV1(ok: true, bytes: [], reason: "ok")]

describe "ARM64 compiler-filesystem fw_cfg metadata source":
    it "plans only the four exact names with tight per-field bounds":
        val fields = arm64_cfs_fw_cfg_field_plan_v2()

        expect(fields.len()).to_equal(4)
        expect(fields[0].name).to_equal("opt/simpleos.cfs.nonce")
        expect(fields[0].max_bytes).to_equal(128u32)
        expect(fields[1].name).to_equal("opt/simpleos.cfs.image_path")
        expect(fields[1].max_bytes).to_equal(1024u32)
        expect(fields[2].name).to_equal("opt/simpleos.cfs.image_sha256")
        expect(fields[2].max_bytes).to_equal(64u32)
        expect(fields[3].name).to_equal("opt/simpleos.cfs.drive_arg")
        expect(fields[3].max_bytes).to_equal(1062u32)

    it "delegates injected reads to the shared metadata collector":
        val path = "/tmp/simpleos-cfs.img"
        val result = arm64_cfs_collect_fw_cfg_reads_v2(SimpleOsCfsMetadataReadsV2(
            nonce: metadata_read("nonce-7"),
            image_path: metadata_read(path),
            image_sha256: metadata_read(
                "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"),
            drive_arg: metadata_read(
                "file={path},if=none,id=cfsexecns1,format=raw"),
        ))

        expect(result.ok).to_equal(true)
        expect(result.metadata.nonce).to_equal("nonce-7")
        expect(result.metadata.image_path).to_equal(path)

    it "invokes one injected batch read for all four fixed requests":
        batch_reader_calls = 0
        batch_reader_request_count = 0
        val reads = arm64_cfs_read_fw_cfg_metadata_with_batch_reader_v2(
            injected_batch_reader
        )

        expect(batch_reader_calls).to_equal(1)
        expect(batch_reader_request_count).to_equal(4)
        expect(reads.nonce.bytes).to_equal("nonce".bytes())
        expect(reads.image_path.bytes).to_equal("/cfs.img".bytes())
        expect(reads.image_sha256.bytes).to_equal("hash".bytes())
        expect(reads.drive_arg.bytes).to_equal("drive".bytes())

    it "fails every field closed when an injected batch has wrong cardinality":
        val reads = arm64_cfs_read_fw_cfg_metadata_with_batch_reader_v2(
            short_batch_reader
        )

        expect(reads.nonce.ok).to_equal(false)
        expect(reads.image_path.ok).to_equal(false)
        expect(reads.image_sha256.ok).to_equal(false)
        expect(reads.drive_arg.reason).to_equal("invalid-batch-result-count")
