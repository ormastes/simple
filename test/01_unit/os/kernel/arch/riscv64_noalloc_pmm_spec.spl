# @cover src/os/kernel/boot/riscv_noalloc_pmm.spl

use std.spec.*
use os.kernel.boot.riscv_noalloc_pmm.{
    riscv_noalloc_pmm_reset,
    riscv_noalloc_pmm_init,
    riscv_noalloc_alloc_page,
    riscv_noalloc_pmm_is_ready,
    riscv_noalloc_pmm_free_pages,
    riscv_noalloc_pmm_total_pages,
    riscv_noalloc_pmm_base,
    riscv_noalloc_pmm_limit,
    riscv_noalloc_pmm_next
}
use os.kernel.boot.dtb_parser.{DtbDeviceInfo, dtb_device_info_empty}
use os.kernel.arch.riscv64.boot_info.{
    rv64_boot_initialize_from_dtb_info,
    rv64_boot_init_pmm_from_validated_dtb
}

fn valid_dtb_ram(base: u64, size: u64) -> DtbDeviceInfo:
    DtbDeviceInfo(
        uart_base: 0x10000000, uart_size: 0x100,
        plic_base: 0x0c000000, plic_size: 0x4000000,
        clint_base: 0x02000000, clint_size: 0x10000,
        ram_base: base, ram_size: size,
        hart_count: 2u32,
        first_enabled_riscv_isa: "rv64imafdc_zicbom",
        cbom_block_size: 64u32,
        valid: true
    )

describe "RV64 pure-Simple noalloc PMM policy":
    it "rejects every invalid C-oracle region branch without fabricating state":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0x80000000, 4096, 0x80200000, 0x80400000)).to_equal(false)
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80000000, 0x80400000)).to_equal(false)
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80200000)).to_equal(false)
        expect(riscv_noalloc_pmm_init(0xfffffffffffff000, 0x2000, 0xfffffffffffff100, 0xfffffffffffff800)).to_equal(false)
        expect(riscv_noalloc_pmm_init(0x80000000, 0x01000000, 0x80200000, 0x82000000)).to_equal(false)
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200001, 0x80201000)).to_equal(false)
        expect(riscv_noalloc_pmm_is_ready()).to_equal(false)
        expect(riscv_noalloc_pmm_total_pages()).to_equal(0)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(0)
        expect(riscv_noalloc_alloc_page()).to_equal(0)

    it "aligns the first page and exhausts the exact C-oracle window":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200001, 0x80203000)).to_equal(true)
        expect(riscv_noalloc_pmm_base()).to_equal(0x80201000)
        expect(riscv_noalloc_pmm_limit()).to_equal(0x80203000)
        expect(riscv_noalloc_pmm_total_pages()).to_equal(2)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80201000)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(1)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80202000)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(0)
        expect(riscv_noalloc_alloc_page()).to_equal(0)

    it "preserves the C short-window behavior where the page count is zero":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80200001)).to_equal(true)
        expect(riscv_noalloc_pmm_total_pages()).to_equal(0)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80200000)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(0)

    it "resets allocation progress on a valid reinitialization":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80203000)).to_equal(true)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80200000)
        expect(riscv_noalloc_pmm_next()).to_equal(0x80201000)
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80300000, 0x80302000)).to_equal(true)
        expect(riscv_noalloc_pmm_next()).to_equal(0x80300000)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(2)

    it "keeps prior valid state when a later invalid init is rejected":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0x80000000, 0x08000000, 0x80200000, 0x80202000)).to_equal(true)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80200000)
        expect(riscv_noalloc_pmm_init(0x80000000, 4096, 0x80200000, 0x80202000)).to_equal(false)
        expect(riscv_noalloc_pmm_is_ready()).to_equal(true)
        expect(riscv_noalloc_pmm_next()).to_equal(0x80201000)
        expect(riscv_noalloc_pmm_free_pages()).to_equal(1)

    it "normalizes sign-extended RV64 physical inputs like the C oracle":
        riscv_noalloc_pmm_reset()
        expect(riscv_noalloc_pmm_init(0xffffffff80000000, 0x08000000, 0xffffffff80200001, 0xffffffff80203000)).to_equal(true)
        expect(riscv_noalloc_pmm_base()).to_equal(0x80201000)
        expect(riscv_noalloc_alloc_page()).to_equal(0x80201000)

    it "consumes DTB RAM only after boot-info validation":
        riscv_noalloc_pmm_reset()
        rv64_boot_initialize_from_dtb_info(dtb_device_info_empty())
        expect(rv64_boot_init_pmm_from_validated_dtb(0x90200000, 0x90202000)).to_equal(false)
        expect(riscv_noalloc_pmm_is_ready()).to_equal(false)

        rv64_boot_initialize_from_dtb_info(valid_dtb_ram(0x90000000, 0x04000000))
        expect(rv64_boot_init_pmm_from_validated_dtb(0x90200001, 0x90203000)).to_equal(true)
        expect(riscv_noalloc_pmm_base()).to_equal(0x90201000)
        expect(riscv_noalloc_pmm_total_pages()).to_equal(2)
