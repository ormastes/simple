use std.spec
use os.kernel.arch.arch_context.{Riscv64Context}
use os.kernel.arch.riscv64.trap_model.{create_rv64_user_context}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.capability_types.{CapabilitySet}
use os.kernel.types.task_types.{TaskId, TaskPriority, UserLoadSegment, UserProcessImage}

fn rv64_switch_test_image() -> UserProcessImage:
    UserProcessImage(
        binary_path: "/system/services/rv64-switch-test",
        entry: 0x400000,
        stack_top: 0x4000000000,
        stack_size: 65536,
        argv: ["rv64-switch-test"],
        envp: [],
        segments: [UserLoadSegment(
            virt_addr: 0x400000, mem_size: 4, file_size: 4,
            flags: 5, align: 0x1000, data: [0x13.to_u8(), 0, 0, 0]
        )],
        segment_count: 1,
        file_bytes: [0x13.to_u8(), 0, 0, 0],
        initial_sp: 0x3fffffff80,
        initial_stack_bytes: [0x01.to_u8(), 0x02, 0x03, 0x04]
    )

describe "RV64 scheduler trap-frame ownership":
    it "persists a complete frame only with its task-owned supervisor stack":
        var sched = Scheduler.new()
        val pid = sched.create_user_task_pid(
            rv64_switch_test_image(), TaskPriority.Normal, CapabilitySet.full()
        )
        expect(pid).to_be_greater_than(0)
        val id = TaskId(id: pid)

        var frame = create_rv64_user_context(0x400000, 0x3fffffff80, 0)
        frame.fp_pad = 0x80204000
        expect(sched.rv64_install_user_execution_state(id, frame, frame.fp_pad, 4)).to_equal(true)

        var stopped = frame
        stopped.a0 = 91
        stopped.sepc = 0x400020
        expect(sched.rv64_save_user_trap_frame(id, stopped)).to_equal(true)

        val selected = sched.rv64_user_trap_frame(id)
        expect(selected).to_not_equal(nil)
        if selected != nil:
            expect(selected.unwrap().a0).to_equal(91)
            expect(selected.unwrap().sepc).to_equal(0x400020)
            expect(selected.unwrap().fp_pad).to_equal(0x80204000)

    it "rejects a frame whose claimed stack is not the task-owned stack":
        var sched = Scheduler.new()
        val pid = sched.create_user_task_pid(
            rv64_switch_test_image(), TaskPriority.Normal, CapabilitySet.full()
        )
        expect(pid).to_be_greater_than(0)
        val id = TaskId(id: pid)

        var initial = create_rv64_user_context(0x400000, 0x3fffffff80, 0)
        initial.fp_pad = 0x80208000
        expect(sched.rv64_install_user_execution_state(id, initial, initial.fp_pad, 4)).to_equal(true)

        var forged = initial
        forged.fp_pad = 0x8020C000
        expect(sched.rv64_save_user_trap_frame(id, forged)).to_equal(false)
