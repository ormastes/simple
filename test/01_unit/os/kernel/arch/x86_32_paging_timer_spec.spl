"""x86_32 paging and timer HAL parity tests.

These tests cover hosted-safe HAL contracts without invoking privileged CR3,
page-table, or PIT port I/O operations.
"""
# @req: REQ-TEST-ARCH_X86_32_PAGING_TIMER-001

use std.spec
use os.kernel.arch.x86_32.mod.{create_x86_32_hal}
use os.kernel.arch_adapt.x86_32.mod.{create_x86_32_hal_adapter}
use os.kernel.arch_adapt.x86_32.timer.{timer_current_ticks, timer_elapsed_us, timer_frequency, timer_ticks_per_second}
use os.kernel.arch.x86_32.timer.{pit_tick_handler}

describe "x86_32 paging and timer HAL parity":
    """Verifies hosted-safe x86_32 HAL geometry and timer state contracts."""

    it "exposes x86_32 paging geometry through the aggregate HAL":
        # @req: REQ-TEST-ARCH_X86_32_PAGING_TIMER-001
        step("Verify: exposes x86_32 paging geometry through the aggregate HAL")
        val hal = create_x86_32_hal()

        expect(hal.paging.page_size()).to_equal(4096)  # oracle: expected value pinned by spec
        expect(hal.paging.address_levels()).to_equal(2)  # oracle: expected value pinned by spec

    it "exposes x86_32 paging geometry through the adapter aggregate":
        # @req: REQ-TEST-ARCH_X86_32_PAGING_TIMER-001
        step("Verify: exposes x86_32 paging geometry through the adapter aggregate")
        val adapter = create_x86_32_hal_adapter()

        expect(adapter.paging.page_size()).to_equal(4096)  # oracle: expected value pinned by spec
        expect(adapter.paging.address_levels()).to_equal(2)  # oracle: expected value pinned by spec

    it "exposes hosted-safe timer defaults through the aggregate HAL":
        # @req: REQ-TEST-ARCH_X86_32_PAGING_TIMER-001
        step("Verify: exposes hosted-safe timer defaults through the aggregate HAL")
        val hal = create_x86_32_hal()

        expect(hal.timer.frequency()).to_equal(0)  # oracle: expected value pinned by spec
        expect(hal.timer.ticks_per_second()).to_equal(0)  # oracle: expected value pinned by spec
        expect(hal.timer.elapsed_us()).to_equal(0)  # oracle: expected value pinned by spec

    it "routes timer tick state through HAL and adapter wrappers":
        # @req: REQ-TEST-ARCH_X86_32_PAGING_TIMER-001
        step("Verify: routes timer tick state through HAL and adapter wrappers")
        val before = timer_current_ticks()
        pit_tick_handler()
        pit_tick_handler()

        val hal = create_x86_32_hal()
        expect(hal.timer.current_ticks()).to_equal(before + 2)  # oracle: expected value pinned by spec
        expect(timer_current_ticks()).to_equal(before + 2)  # oracle: expected value pinned by spec
        expect(timer_frequency()).to_equal(0)  # oracle: expected value pinned by spec
        expect(timer_ticks_per_second()).to_equal(0)  # oracle: expected value pinned by spec
        expect(timer_elapsed_us()).to_equal(0)  # oracle: expected value pinned by spec
