# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (riscv64 fs-exec kernel link): memset, rt_stdout_write and
# spl_thread_current_id were undefined at link.
# bug: doc/08_tracking/bug/riscv64_fs_exec_kernel_link_undefined_runtime_2026-11-19.md

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

val CORE = "examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_runtime_core.inc.c"

describe "riscv64 boot runtime link symbols":
    it "defines memset with a volatile store (no -fno-builtin in the boot C flags)":
        step("a plain byte loop can be lowered back into a recursive memset call")
        val src = file_read_text(CORE)
        expect(src.contains("void *memset(void *destination, int value, size_t count)")).to_equal(true)
        expect(src.contains("volatile unsigned char *out")).to_equal(true)

    it "defines rt_stdout_write over the serial string writer":
        val src = file_read_text(CORE)
        expect(src.contains("RuntimeValue rt_stdout_write(RuntimeValue data)")).to_equal(true)

    it "keeps the kernel thread shim in the fs-exec closure":
        step("spl_thread_current_id is exported by os.kernel.net.thread_shim")
        val src = file_read_text("examples/09_embedded/simple_os/arch/riscv64/fs_exec_hello_entry.spl")
        expect(src.contains("use os.kernel.net.thread_shim.{}")).to_equal(true)
