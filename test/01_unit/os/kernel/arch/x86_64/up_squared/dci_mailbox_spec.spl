use std.spec.{describe, it, expect}
use os.kernel.arch.x86_64.up_squared.dci_mailbox.{
    DciCommitState, DciMailboxDescriptor, DciMemoryRange, DciLoadSegment,
    DciElfPlan, DciStorageIdentity, DciStorageWrite,
    dci_admit_mailbox, dci_parse_x86_64_elf, dci_admit_load_plan,
    dci_storage_confirmation, dci_admit_storage_write
}

val TEST_HASH: text = "1840191f50d032d9c3b4af9b012d211ce01c1cd77b3315961a9e4b486c1c48f3"

fn mailbox(state: DciCommitState, generation: u64, nonce: u64) -> DciMailboxDescriptor:
    DciMailboxDescriptor(
        schema_version: 1u32,
        generation: generation,
        nonce: nonce,
        payload_size: 37280u64,
        payload_sha256: TEST_HASH,
        state: state
    )

fn up2_plan() -> DciElfPlan:
    DciElfPlan(
        entry: 0x08000038u64,
        segments: [
            DciLoadSegment(file_offset: 0x1000u64, file_size: 0x4b6fu64,
                physical_address: 0x08000000u64, memory_size: 0x4b6fu64,
                flags: 5u32, align: 0x1000u64),
            DciLoadSegment(file_offset: 0x6000u64, file_size: 0x01feu64,
                physical_address: 0x08005000u64, memory_size: 0x01feu64,
                flags: 4u32, align: 0x1000u64),
            DciLoadSegment(file_offset: 0x7000u64, file_size: 0x008au64,
                physical_address: 0x08006000u64, memory_size: 0x0180d000u64,
                flags: 6u32, align: 0x1000u64)
        ]
    )

fn allowed_ram() -> [DciMemoryRange]:
    [DciMemoryRange(start: 0x08000000u64, size: 0x02000000u64)]

fn identity(root: bool, mounted: bool, held: bool) -> DciStorageIdentity:
    DciStorageIdentity(
        model: "UP2-LAB-DISK",
        serial: "UP2-TEST-001",
        transport: "usb-uas",
        capacity: 1073741824u64,
        root_device: root,
        swap_device: false,
        mounted: mounted,
        held: held
    )

fn storage_write(observed: DciStorageIdentity, expected: DciStorageIdentity,
    confirmation: text, authorized: bool) -> DciStorageWrite:
    DciStorageWrite(
        observed: observed,
        expected: expected,
        byte_start: 1048576u64,
        byte_length: 268435456u64,
        image_size: 268435456u64,
        image_sha256: TEST_HASH,
        confirmation: confirmation,
        persistent_allowed: authorized
    )

fn push_u16(bytes: [u8], value: u64) -> [u8]:
    var out = bytes
    out.push((value & 0xffu64) as u8)
    out.push(((value >> 8) & 0xffu64) as u8)
    out

fn push_u32(bytes: [u8], value: u64) -> [u8]:
    var out = bytes
    var shift: u64 = 0u64
    while shift < 32u64:
        out.push(((value >> shift) & 0xffu64) as u8)
        shift = shift + 8u64
    out

fn push_u64(bytes: [u8], value: u64) -> [u8]:
    var out = bytes
    var shift: u64 = 0u64
    while shift < 64u64:
        out.push(((value >> shift) & 0xffu64) as u8)
        shift = shift + 8u64
    out

fn minimal_physical_elf() -> [u8]:
    var bytes: [u8] = [0x7fu8, 0x45u8, 0x4cu8, 0x46u8, 2u8, 1u8, 1u8, 0u8]
    while bytes.len() < 16: bytes.push(0u8)
    bytes = push_u16(bytes, 2u64)
    bytes = push_u16(bytes, 62u64)
    bytes = push_u32(bytes, 1u64)
    bytes = push_u64(bytes, 0x08000000u64)
    bytes = push_u64(bytes, 64u64)
    bytes = push_u64(bytes, 0u64)
    bytes = push_u32(bytes, 0u64)
    bytes = push_u16(bytes, 64u64)
    bytes = push_u16(bytes, 56u64)
    bytes = push_u16(bytes, 1u64)
    bytes = push_u16(bytes, 0u64)
    bytes = push_u16(bytes, 0u64)
    bytes = push_u16(bytes, 0u64)
    bytes = push_u32(bytes, 1u64)
    bytes = push_u32(bytes, 5u64)
    bytes = push_u64(bytes, 120u64)
    bytes = push_u64(bytes, 0x08000000u64)
    bytes = push_u64(bytes, 0x08000000u64)
    bytes = push_u64(bytes, 1u64)
    bytes = push_u64(bytes, 8u64)
    bytes = push_u64(bytes, 8u64)
    bytes.push(0xc3u8)
    bytes

describe "UP2 DCI mailbox admission":
    it "admits a fresh committed exact-digest payload":
        val result = dci_admit_mailbox(mailbox(DciCommitState.Committed, 2u64, 77u64), 1u64, 77u64, 37280u64, TEST_HASH)
        expect(result.accepted).to_equal(true)
        expect(result.reason).to_equal("admitted")

    it "rejects partial commit, replay, nonce mismatch, and digest mismatch":
        expect(dci_admit_mailbox(mailbox(DciCommitState.PayloadWritten, 2u64, 77u64), 1u64, 77u64, 37280u64, TEST_HASH).reason).to_equal("mailbox-not-committed")
        expect(dci_admit_mailbox(mailbox(DciCommitState.Committed, 1u64, 77u64), 1u64, 77u64, 37280u64, TEST_HASH).reason).to_equal("mailbox-generation-replayed")
        expect(dci_admit_mailbox(mailbox(DciCommitState.Committed, 2u64, 78u64), 1u64, 77u64, 37280u64, TEST_HASH).reason).to_equal("mailbox-nonce")
        expect(dci_admit_mailbox(mailbox(DciCommitState.Committed, 2u64, 77u64), 1u64, 77u64, 37280u64, "a" * 64).reason).to_equal("mailbox-payload-digest-mismatch")

describe "UP2 DCI physical ELF plan":
    it "parses p_paddr and zero-fill size from an x86-64 ELF":
        val parsed = dci_parse_x86_64_elf(minimal_physical_elf())
        expect(parsed.is_ok()).to_equal(true)
        val plan = parsed.unwrap()
        expect(plan.entry).to_equal(0x08000000u64)
        expect(plan.segments[0].physical_address).to_equal(0x08000000u64)
        expect(plan.segments[0].file_size).to_equal(1u64)
        expect(plan.segments[0].memory_size).to_equal(8u64)

    it "rejects malformed and truncated ELF input":
        expect(dci_parse_x86_64_elf([0u8]).is_err()).to_equal(true)
        var bad = minimal_physical_elf()
        bad[0] = 0u8
        expect(dci_parse_x86_64_elf(bad).unwrap_err()).to_equal("elf-magic")

    it "admits the exact current UP2 three-segment physical plan":
        val result = dci_admit_load_plan(37280u64, up2_plan(), allowed_ram())
        expect(result.accepted).to_equal(true)

    it "rejects W plus X and an entry outside executable file bytes":
        var wx = up2_plan()
        wx.segments[0].flags = 7u32
        expect(dci_admit_load_plan(37280u64, wx, allowed_ram()).reason).to_equal("load-write-execute")
        var bad_entry = up2_plan()
        bad_entry.entry = 0x08004fffu64
        expect(dci_admit_load_plan(37280u64, bad_entry, allowed_ram()).reason).to_equal("load-entry-not-executable")

    it "rejects file truncation, overlap, and non-allowlisted RAM":
        var truncated = up2_plan()
        truncated.segments[2].file_offset = 40000u64
        expect(dci_admit_load_plan(37280u64, truncated, allowed_ram()).reason).to_equal("load-file-range")
        var overlap = up2_plan()
        overlap.segments[1].physical_address = 0x08004000u64
        overlap.segments[1].align = 1u64
        expect(dci_admit_load_plan(37280u64, overlap, allowed_ram()).reason).to_equal("load-segment-overlap")
        expect(dci_admit_load_plan(37280u64, up2_plan(), [DciMemoryRange(start: 0x10000000u64, size: 0x1000u64)]).reason).to_equal("load-memory-not-allowed")

describe "UP2 DCI-staged storage admission":
    it "admits an exact idle identity with its bound challenge":
        val disk = identity(false, false, false)
        val challenge = dci_storage_confirmation(disk, 1048576u64, 268435456u64, TEST_HASH)
        val result = dci_admit_storage_write(storage_write(disk, disk, challenge, true))
        expect(result.accepted).to_equal(true)

    it "rejects missing authorization, system media, busy media, and wrong challenge":
        val disk = identity(false, false, false)
        val challenge = dci_storage_confirmation(disk, 1048576u64, 268435456u64, TEST_HASH)
        expect(dci_admit_storage_write(storage_write(disk, disk, challenge, false)).reason).to_equal("storage-persistent-not-authorized")
        val root = identity(true, false, false)
        expect(dci_admit_storage_write(storage_write(root, root, "", true)).reason).to_equal("storage-system-device")
        val mounted = identity(false, true, false)
        expect(dci_admit_storage_write(storage_write(mounted, mounted, "", true)).reason).to_equal("storage-device-busy")
        expect(dci_admit_storage_write(storage_write(disk, disk, "wrong", true)).reason).to_equal("storage-confirmation")

    it "rejects identity changes and ranges beyond capacity":
        val disk = identity(false, false, false)
        var changed = identity(false, false, false)
        changed.serial = "OTHER"
        expect(dci_admit_storage_write(storage_write(disk, changed, "", true)).reason).to_equal("storage-identity-mismatch")
        var request = storage_write(disk, disk, "", true)
        request.byte_start = disk.capacity - 1u64
        request.byte_length = 2u64
        request.image_size = 2u64
        expect(dci_admit_storage_write(request).reason).to_equal("storage-write-range")
