use os.kernel.arch.riscv64.starfive.boot.starfive_dtb_policy.{
    starfive_dtb_policy_select,
    STARFIVE_FDT_MAGIC,
    STARFIVE_FALLBACK_DTB_ADDRESS
}

describe "StarFive DTB selection policy":
    it "prefers a valid nonzero firmware candidate":
        expect(starfive_dtb_policy_select(
            0x12345000u64, STARFIVE_FDT_MAGIC, STARFIVE_FDT_MAGIC
        )).to_equal(0x12345000u64)

    it "uses the fixed fallback when the candidate is absent or invalid":
        expect(starfive_dtb_policy_select(
            0u64, STARFIVE_FDT_MAGIC, STARFIVE_FDT_MAGIC
        )).to_equal(STARFIVE_FALLBACK_DTB_ADDRESS)
        expect(starfive_dtb_policy_select(
            0x12345000u64, 0u64, STARFIVE_FDT_MAGIC
        )).to_equal(STARFIVE_FALLBACK_DTB_ADDRESS)

    it "fails closed when neither observation has FDT magic":
        expect(starfive_dtb_policy_select(
            0u64, 0u64, 0u64
        )).to_equal(0u64)
        expect(starfive_dtb_policy_select(
            0x12345000u64, 0u64, 0u64
        )).to_equal(0u64)
