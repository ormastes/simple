use std.spec.*
use os.kernel.arch.riscv64.platform.uart_baud_policy.{
    uart_baud_plan,
    uart_baud_plan_valid,
    uart_baud_status_code,
    uart_baud_apply_plan_with
}

extern fn rt_file_read_text(path: text) -> text?

val VECTOR_PATH = "test/fixtures/os/kernel/arch/riscv64/uart_baud_policy_vectors.sdn"

struct UartVector:
    name: text
    clock_hz: u64
    baud: u64
    status: i64
    divisor: u64
    dll: i64
    dlh: i64
    writes: i64

fn _parse_u64(value: text) -> u64:
    match value.trim().parse_i64():
        Some(parsed): parsed as u64
        None: 0u64

fn _load_vectors() -> [UartVector]:
    val content = rt_file_read_text(VECTOR_PATH) ?? ""
    var vectors: [UartVector] = []
    for raw_line in content.split("\n"):
        if raw_line.starts_with("    "):
            val parts = raw_line.trim().split(",")
            if parts.len() == 8:
                vectors.push(UartVector(
                    name: parts[0].trim(),
                    clock_hz: _parse_u64(parts[1]),
                    baud: _parse_u64(parts[2]),
                    status: _parse_u64(parts[3]) as i64,
                    divisor: _parse_u64(parts[4]),
                    dll: _parse_u64(parts[5]) as i64,
                    dlh: _parse_u64(parts[6]) as i64,
                    writes: _parse_u64(parts[7]) as i64
                ))
    vectors

fn _discard_write(address: u64, value: u8):
    val _address = address
    val _value = value

describe "RISC-V FPGA UART baud policy":
    it "matches every shared C and Simple policy vector":
        val vectors = _load_vectors()
        expect(vectors.len()).to_equal(8)
        for vector in vectors:
            val plan = uart_baud_plan(vector.clock_hz, vector.baud)
            expect(uart_baud_status_code(plan.status)).to_equal(vector.status)
            expect(plan.divisor).to_equal(vector.divisor)
            expect(plan.dll as i64).to_equal(vector.dll)
            expect(plan.dlh as i64).to_equal(vector.dlh)
            val writes = uart_baud_apply_plan_with(0u64, plan, _discard_write)
            expect(writes).to_equal(vector.writes)
            expect(uart_baud_plan_valid(plan)).to_equal(vector.status == 0)

    it "keeps invalid mutations on the zero-MMIO side of the boundary":
        val zero_baud = uart_baud_plan(1843200u64, 0u64)
        val overflow_shaped = uart_baud_plan(1843200u64, 0xFFFFFFFFFFFFFFFFu64)
        expect(uart_baud_apply_plan_with(0u64, zero_baud, _discard_write)).to_equal(0)
        expect(uart_baud_apply_plan_with(0u64, overflow_shaped, _discard_write)).to_equal(0)
