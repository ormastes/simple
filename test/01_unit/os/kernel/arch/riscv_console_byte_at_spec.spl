# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro: riscv_uart_write sent `msg.char_at(i)` then `ch as u8`. char_at
# yields a 1-char text (ANY in the seed), so the cast lowers to rt_any_to_int,
# which parses decimal like the hosted runtime: every non-digit character
# became 0 and the UART emitted NUL bytes. The raw byte comes from byte_at.

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

val CONSOLE = "src/os/kernel/arch/riscv/console_common.spl"

describe "riscv UART console byte path":
    it "byte_at yields the raw character byte":
        val msg = "Hi!"
        expect(msg.byte_at(0)).to_equal(72)
        expect(msg.byte_at(1)).to_equal(105)
        expect(msg.byte_at(2)).to_equal(33)

    it "riscv_uart_write sends byte_at, never a char_at cast":
        val src = file_read_text(CONSOLE)
        expect(src.contains("msg.byte_at(i) as u8")).to_equal(true)
        expect(src.contains("msg.char_at(i)")).to_equal(false)
