use std.spec.{describe, it, expect}
use os.kernel.arch.x86_32.privilege_abi.*
use os.kernel.arch.x86_32.user_prepare_contract.{x86_32_nonce_overlaps_load_segment}

extern fn rt_file_read_text(path: text) -> text

describe "x86_32 privilege-transition ABI v1":
    it "freezes owned selectors and TSS offsets":
        expect(X86_32_PRIVILEGE_ABI_VERSION).to_equal(0x00010008)
        expect(X86_32_GDT_USER_CODE).to_equal(0x1B)
        expect(X86_32_GDT_USER_DATA).to_equal(0x23)
        expect(X86_32_GDT_TSS).to_equal(0x28)
        expect(X86_32_TSS_BYTES).to_equal(104)
        expect(X86_32_TSS_ESP0_OFFSET).to_equal(4)

    it "freezes the complete CPL3 hardware frame":
        expect(X86_32_TRAP_FRAME_WORDS).to_equal(19)
        expect(X86_32_TF_EIP).to_equal(56)
        expect(X86_32_TF_USER_ESP).to_equal(68)
        expect(X86_32_TF_USER_SS).to_equal(72)
        expect(X86_32_TRAP_FRAME_BYTES).to_equal(76)
        expect(x86_32_privilege_abi_layout_valid()).to_equal(true)

    it "freezes token and explicit control-flow disposition sizes":
        expect(X86_32_TOKEN_TASK_ID_OFFSET).to_equal(16)
        expect(X86_32_TOKEN_GENERATION_OFFSET).to_equal(24)
        expect(X86_32_TOKEN_EXPECTED_CR3_OFFSET).to_equal(40)
        expect(X86_32_TOKEN_NONCE_USER_VA_OFFSET).to_equal(56)
        expect(X86_32_TOKEN_NONCE_DIGEST_OFFSET).to_equal(64)
        expect(X86_32_PRIVILEGE_TOKEN_BYTES).to_equal(96)
        expect(X86_32_TRAP_DISPOSITION_BYTES).to_equal(16)

    it "sabotage oracle rejects the old same-CPL short-frame assumption":
        # A same-CPL interrupt omits hardware-pushed user ESP and SS.
        val sabotaged_bytes = X86_32_TRAP_FRAME_BYTES - 8
        expect(sabotaged_bytes).to_equal(68)
        expect(sabotaged_bytes == X86_32_TRAP_FRAME_BYTES).to_equal(false)
        expect(X86_32_TF_USER_SS + 4 == sabotaged_bytes).to_equal(false)

    it "does not authorize a live entry symbol from the layout contract":
        val source = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi.spl")
        expect(source.contains("extern fn rt_x86_32_enter_user_first")).to_equal(false)
        expect(source).to_contain("X86_32_TRAP_ACTION_RESUME_KERNEL_EXIT")

    it "freezes one scalar raw-C dispatcher without weak probing":
        val header = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi_v1_8.h")
        expect(header).to_contain("simpleos_x86_32_privilege_dispatch_v1_1")
        expect(header).to_contain("SimpleOsX86_32TrapDispositionV1 *disposition_out")
        expect(header).to_contain("__attribute__((cdecl, visibility(\"hidden\")))")
        expect(header.contains("__attribute__((weak))")).to_equal(false)
        expect(header.contains("RuntimeValue")).to_equal(false)

    it "sabotage oracle makes a renamed canonical symbol unresolvable":
        val header = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi_v1_8.h")
        val sabotaged = header.replace(
            "simpleos_x86_32_privilege_dispatch_v1_1",
            "simpleos_x86_32_privilege_dispatch_wrong"
        )
        expect(sabotaged).to_contain("simpleos_x86_32_privilege_dispatch_wrong")
        expect(sabotaged.contains("simpleos_x86_32_privilege_dispatch_v1_1")).to_equal(false)

    it "freezes ordered first-entry publication and one-shot clearing":
        val header = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi_v1_8.h")
        expect(header).to_contain("simpleos_x86_32_privilege_enter_v1_2")
        expect(header).to_contain("kernel_stack_top")
        expect(header).to_contain("user_cr3")
        expect(header).to_contain("writes TSS.esp0 first")
        expect(header).to_contain("simpleos_x86_32_privilege_clear_active_v1_2")
        expect(X86_32_ENTRY_KERNEL_STACK_BYTES).to_equal(16384)
        expect(x86_32_privilege_entry_layout_valid()).to_equal(true)

    it "sabotage oracle rejects publish before TSS esp0":
        val header = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi_v1_8.h")
        val correct = "writes TSS.esp0 first,\n * release-publishes token second"
        val reversed = "release-publishes token first,\n * writes TSS.esp0 second"
        expect(header).to_contain(correct)
        expect(header.contains(reversed)).to_equal(false)

    it "binds entry and syscall 60 to one exact nonce range":
        val header = rt_file_read_text("src/os/kernel/arch/x86_32/privilege_abi_v1_8.h")
        expect(header).to_contain("expected_nonce_user_va")
        expect(header).to_contain("loads ECX from")
        expect(header).to_contain("EDX from token.nonce_length")
        expect(header).to_contain("EBX==expected_nonce_user_va")
        expect(header).to_contain("compares all 32 digest bytes")
        expect(x86_32_nonce_range_valid(0x40001000, 32)).to_equal(true)
        expect(x86_32_nonce_range_valid(0xBFFFFFF0, 32)).to_equal(false)
        expect(x86_32_nonce_range_valid(0xFFFFFFF0, 32)).to_equal(false)

    it "sabotage oracle rejects pointer substitution despite equal length":
        val expected: u32 = 0x40001000
        val supplied: u32 = 0x40002000
        val length: u32 = 32
        expect(length).to_equal(32)
        expect(supplied == expected).to_equal(false)

    it "freezes scheduler-owned nonce placement and bounded token registry":
        expect(X86_32_NONCE_USER_VA).to_equal(0x2FFFF000)
        expect(X86_32_NONCE_PAGE_BYTES).to_equal(4096)
        expect(X86_32_TOKEN_REGISTRY_SLOTS).to_equal(16)
        expect(x86_32_nonce_reserved_range_valid(0x2FFFF000, 32)).to_equal(true)
        expect(x86_32_nonce_reserved_range_valid(0x2FFFE000, 32)).to_equal(false)
        expect(x86_32_nonce_overlaps_load_segment(0x2FFFF000, 1)).to_equal(true)
        expect(x86_32_nonce_overlaps_load_segment(0x2FFFE000, 8192)).to_equal(true)
        expect(x86_32_nonce_overlaps_load_segment(0x2FFFD000, 4096)).to_equal(false)

    it "freezes the exclusive recursive PDE and kmap window":
        expect(X86_32_RECURSIVE_PDE_INDEX).to_equal(1023)
        expect(X86_32_RECURSIVE_PT_BASE).to_equal(0xFFC00000)
        expect(X86_32_RECURSIVE_PD_VA).to_equal(0xFFFFF000)
        expect(X86_32_KMAP_PDE_INDEX).to_equal(1022)
        expect(X86_32_KMAP_VA).to_equal(0xFFBFF000)
        expect(X86_32_KMAP_VA < X86_32_RECURSIVE_PT_BASE).to_equal(true)
        expect(X86_32_BOOT_PAGING_POOL_PAGES).to_equal(3)
        expect(X86_32_BOOT_PAGING_POOL_BYTES).to_equal(12288)

    it "freezes boot zero and self-map before Simple entry":
        val boot = rt_file_read_text("examples/09_embedded/simple_os/arch/x86_32/boot/crt0.s")
        val zero_at = boot.index_of("movl $__x86_32_boot_paging_start") ?? -1
        val self_at = boot.index_of("movl %eax, 4092(%edi)") ?? -1
        val call_at = boot.index_of("call _start") ?? -1
        expect(zero_at >= 0).to_equal(true)
        expect(self_at > zero_at).to_equal(true)
        expect(call_at > self_at).to_equal(true)

    it "freezes paging enable after identity-map and live-address checks":
        val boot = rt_file_read_text("examples/09_embedded/simple_os/arch/x86_32/boot/crt0.s")
        val map_at = boot.index_of(".identity_pde_loop:") ?? -1
        val live_at = boot.index_of("Current instruction and stack") ?? -1
        val cr3_at = boot.index_of("movl %eax, %cr3") ?? -1
        val pg_at = boot.index_of("orl $0x80010000") ?? -1
        expect(map_at >= 0).to_equal(true)
        expect(live_at > map_at).to_equal(true)
        expect(cr3_at > live_at).to_equal(true)
        expect(pg_at > cr3_at).to_equal(true)

    it "freezes a mapped PMM bitmap for the full supported physical ceiling":
        val linker = rt_file_read_text("examples/09_embedded/simple_os/arch/x86_32/linker.ld")
        expect(X86_32_PMM_MAX_PHYS_PAGES).to_equal(1048576)
        expect(X86_32_PMM_BITMAP_BYTES).to_equal(131072)
        expect(linker).to_contain("__x86_32_pmm_bitmap_start")
        expect(linker).to_contain(". = . + 128K")
        expect(linker).to_contain("_kernel_end = .")

    it "sabotage oracle rejects stale registry generations":
        val old_generation: u32 = 7
        val reused_generation: u32 = 8
        expect(old_generation == reused_generation).to_equal(false)

    it "routes physical access through recursive kmap leases":
        val paging = rt_file_read_text("src/os/kernel/arch/x86_32/paging.spl")
        val kmap = rt_file_read_text("src/os/kernel/arch/x86_32/kmap_owner.spl")
        val owner = rt_file_read_text("src/os/kernel/arch/x86_32/address_space_owner.spl")
        expect(paging).to_contain("X86_32_KMAP_PT_VA: u32 = 0xFFFFE000")
        expect(paging).to_contain("_invlpg(X86_32_KMAP_VA)")
        expect(kmap).to_contain("lease.generation == g_x86_32_kmap_generation")
        expect(kmap).to_contain("x86_32_kmap_revoke")
        expect(owner).to_contain("x86_32_create_address_space_owned")
        expect(owner).to_contain("x86_32_user_page_readonly_owned")

    it "sabotage oracle rejects raw physical child-table routing":
        val adapter = rt_file_read_text("src/os/kernel/memory/user_address_space.spl")
        val x86_at = adapter.index_of("@cfg(x86)\nfn create_user_address_space()") ?? -1
        expect(x86_at >= 0).to_equal(true)
        val x86 = adapter.substring(x86_at, adapter.len())
        expect(x86).to_contain("x86_32.address_space_owner")
        expect(x86.contains("x86_32_vmm_map_page_in")).to_equal(false)
