# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (riscv32 kernel link with the console/log seam, scripts/check/
# check-simpleos-riscv32-kernel-link.shs --link-only): the UART log path
# reached rt_volatile_read_u8, rt_volatile_write_u8, rt_string_len,
# rt_string_byte_at, rt_slice_text_bytes and rt_any_to_int, none defined on
# riscv32. The exported bodies need rv32 memory/MMIO, so they are proven by the
# link gate; the integer policy they use is tested directly here.

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}
use os.kernel.arch.riscv32.core_runtime_layout.{
    rv32_rt_clamp, rv32_rt_digit_value, rv32_rt_byte_index_ok
}

val RT = "src/os/kernel/arch/riscv32/core_runtime.spl"
val MMIO = "src/os/kernel/arch/riscv32/mmio_runtime.spl"
val ENTRY = "examples/09_embedded/simple_os/arch/riscv32/os_entry.spl"

describe "riscv32 console runtime policy":
    it "clamps slice bounds like the hosted rt_slice_text_bytes":
        expect(rv32_rt_clamp(-3, 0, 5)).to_equal(0)
        expect(rv32_rt_clamp(9, 0, 5)).to_equal(5)
        expect(rv32_rt_clamp(2, 0, 5)).to_equal(2)
        step("start is clamped to the already-clamped finish")
        expect(rv32_rt_clamp(4, 0, 2)).to_equal(2)

    it "accepts a byte index only inside the string":
        expect(rv32_rt_byte_index_ok(0, 3)).to_equal(1)
        expect(rv32_rt_byte_index_ok(2, 3)).to_equal(1)
        expect(rv32_rt_byte_index_ok(3, 3)).to_equal(0)
        expect(rv32_rt_byte_index_ok(-1, 3)).to_equal(0)

    it "maps ASCII digits for decimal parsing, -1 otherwise":
        expect(rv32_rt_digit_value(48)).to_equal(0)
        expect(rv32_rt_digit_value(57)).to_equal(9)
        expect(rv32_rt_digit_value(47)).to_equal(-1)
        expect(rv32_rt_digit_value(72)).to_equal(-1)

describe "riscv32 console runtime exports":
    it "exports the four text/any symbols from the asm-free provider":
        val src = file_read_text(RT)
        for name in ["rt_string_len(value: i64) -> i64",
                     "rt_string_byte_at(value: i64, index: i64) -> i64",
                     "rt_slice_text_bytes(value: i64, start: i64, end: i64, step: i64) -> i64",
                     "rt_any_to_int(value: i64) -> i64"]:
            expect(src.contains("@cfg(riscv32)\n@no_mangle\nfn " + name + ":")).to_equal(true)
        expect(src.contains("asm volatile")).to_equal(false)

    it "does byte MMIO with single lbu/sb instructions, never a word RMW":
        val src = file_read_text(MMIO)
        expect(src.contains("fn rt_volatile_read_u8(addr: i64) -> i64:")).to_equal(true)
        expect(src.contains("fn rt_volatile_write_u8(addr: i64, value: i64):")).to_equal(true)
        step("operand text avoids braces: spec strings interpolate braces")
        expect(src.contains("asm volatile(\"lbu ")).to_equal(true)
        expect(src.contains("\", v = out(reg) value, a = in(reg) addr)")).to_equal(true)
        expect(src.contains("asm volatile(\"sb ")).to_equal(true)
        expect(src.contains("\", v = in(reg) value, a = in(reg) addr)")).to_equal(true)
        step("brace-form asm drops operands silently (0dc7ea0ae48)")
        expect(src.contains("asm volatile:")).to_equal(false)
        expect(src.contains("probe_store32")).to_equal(false)

    it "keeps the MMIO runtime in the riscv32 kernel entry closure":
        val src = file_read_text(ENTRY)
        expect(src.contains("use os.kernel.arch.riscv32.mmio_runtime.{}")).to_equal(true)

    it "new exports never call another rt_* export (ANY result -> rt_value_truthy)":
        val src = file_read_text(RT)
        expect(src.contains("= rt_string_len(")).to_equal(false)
        expect(src.contains("rt_string_byte_at(s")).to_equal(false)
        expect(src.contains("return rt_")).to_equal(false)
