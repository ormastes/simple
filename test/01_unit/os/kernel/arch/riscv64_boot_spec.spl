# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step
use os.kernel.arch.riscv64.boot_info.{Rv64Boot}
use os.kernel.boot.dtb_parser.{DtbDeviceInfo}
use os.kernel.arch.riscv64.hal_smp.{hal_smp_cpu_count}
use os.kernel.arch.riscv64.hal_cache.{
    portable_numeric_capabilities_has_riscv_zicbom,
    current_cacheline_stride
}

fn rv64_test_dtb_info(hart_count: u32, isa: text, cbom_block_size: u32, valid: bool) -> DtbDeviceInfo:
    DtbDeviceInfo(
        uart_base: 0x10000000u64, uart_size: 0x100u64,
        plic_base: 0x0C000000u64, plic_size: 0x400000u64,
        clint_base: 0x02000000u64, clint_size: 0x10000u64,
        ram_base: 0x80000000u64, ram_size: 0x08000000u64,
        hart_count: hart_count,
        first_enabled_riscv_isa: isa,
        cbom_block_size: cbom_block_size,
        valid: valid
    )

describe "rv64 boot bootstrap trap runtime":
    # @manual scenario evidence
    it "records boot arguments":
        # @req REQ-SSPEC-OS
        step("records boot arguments")
        Rv64Boot.save_boot_args(3, 0x88000000)
        expect(Rv64Boot.hart_id()).to_equal(3)
        expect(Rv64Boot.dtb_address()).to_equal(0x88000000)

    it "keeps boot argument capture independent from trap runtime setup":
        # @req REQ-SSPEC-OS
        step("keeps boot argument capture independent from trap runtime setup")
        Rv64Boot.save_boot_args(0, 0x87000000)
        expect(Rv64Boot.hart_id()).to_equal(0)
        expect(Rv64Boot.dtb_address()).to_equal(0x87000000)

    it "keeps the fixed kernel load address":
        # @req REQ-SSPEC-OS
        step("keeps the fixed kernel load address")
        expect(Rv64Boot.kernel_load_address()).to_equal(0x80200000)

    it "initializes SMP and cache state from one parsed DTB snapshot":
        val info = rv64_test_dtb_info(4u32, "rv64gc_zicbom_zicboz", 128u32, true)
        Rv64Boot.initialize_from_dtb_info(info)
        expect(Rv64Boot.hart_count()).to_equal(4u32)
        expect(Rv64Boot.first_enabled_riscv_isa()).to_equal("rv64gc_zicbom_zicboz")
        expect(Rv64Boot.cbom_block_size()).to_equal(128u32)
        expect(hal_smp_cpu_count()).to_equal(4u32)
        expect(portable_numeric_capabilities_has_riscv_zicbom()).to_equal(true)
        expect(current_cacheline_stride()).to_equal(128u32)

    it "falls back safely when parsed DTB metadata is invalid":
        val info = rv64_test_dtb_info(7u32, "rv64gc_zicbom", 3u32, false)
        Rv64Boot.initialize_from_dtb_info(info)
        expect(Rv64Boot.hart_count()).to_equal(1u32)
        expect(Rv64Boot.first_enabled_riscv_isa()).to_equal("")
        expect(Rv64Boot.cbom_block_size()).to_equal(64u32)
        expect(hal_smp_cpu_count()).to_equal(1u32)
        expect(portable_numeric_capabilities_has_riscv_zicbom()).to_equal(false)
        expect(current_cacheline_stride()).to_equal(64u32)
