# @cover src/os/kernel/arch_adapt/x86_port_io.spl 100%
# Source-decision coverage for the compile-time x86 port-I/O boundary.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/x86_port_io.spl"
val BOOT_CPU_PATH = "src/os/kernel/boot/cpu.spl"
val FW_CFG_PATH = "src/os/kernel/fw_cfg/x86_64_named_reader_v1.spl"
val CONCRETE_OWNER = "os.kernel.arch.x86.port_io_owner"
val ADAPTER_OWNER = "os.kernel.arch_adapt.x86_port_io"
val EXACT_ADAPTER_EXPORT = "pub use {CONCRETE_OWNER}.{{\n" +
    "    x86_port_inb,\n" +
    "    x86_port_outb,\n" +
    "    x86_port_inw,\n" +
    "    x86_port_outw,\n" +
    "    x86_port_inl,\n" +
    "    x86_port_outl,\n" +
    "    x86_port_io_wait,\n" +
    "}}"
val EXACT_BOOT_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    x86_port_inb, x86_port_outb, x86_port_inw, x86_port_outw,\n" +
    "    x86_port_inl, x86_port_outl, x86_port_io_wait,\n" +
    "}}"
val EXACT_FW_CFG_IMPORT =
    "use {ADAPTER_OWNER}.{{x86_port_inb, x86_port_outw}}"

describe "x86 port-I/O compile-time architecture adapter":
    it "forwards every canonical owner operation by public re-export":
        step("Read the compile-time adapter source")
        val source = file_read_text(ADAPTER_PATH)

        step("Require the exact concrete-owner export block")
        expect(source.contains(EXACT_ADAPTER_EXPORT)).to_equal(true)
        expect(source.count("pub use ")).to_equal(1)
        expect(source.count(CONCRETE_OWNER)).to_equal(1)

        step("Exclude runtime dispatch, state, allocation, and foreign aliases")
        expect(source.contains("match ")).to_equal(false)
        expect(source.contains("var ")).to_equal(false)
        expect(source.contains("new ")).to_equal(false)
        expect(source.contains("extern fn")).to_equal(false)
        expect(source.contains("rt_")).to_equal(false)

    it "routes both portable consumers only through the adapter":
        step("Read the two owned consumer sources")
        val boot_cpu = file_read_text(BOOT_CPU_PATH)
        val fw_cfg = file_read_text(FW_CFG_PATH)

        step("Require their compile-time adapter imports")
        expect(boot_cpu.contains(EXACT_BOOT_IMPORT)).to_equal(true)
        expect(fw_cfg.contains(EXACT_FW_CFG_IMPORT)).to_equal(true)
        expect(boot_cpu.count(ADAPTER_OWNER)).to_equal(1)
        expect(fw_cfg.count(ADAPTER_OWNER)).to_equal(1)

        step("Reject direct concrete-owner imports from either consumer")
        expect(boot_cpu.contains(CONCRETE_OWNER)).to_equal(false)
        expect(fw_cfg.contains(CONCRETE_OWNER)).to_equal(false)
