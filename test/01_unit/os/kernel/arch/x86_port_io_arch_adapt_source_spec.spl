# @cover src/os/kernel/arch_adapt/x86_port_io.spl 100%
# Source-decision coverage for the compile-time x86 port-I/O boundary.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/x86_port_io.spl"
val OWNER_PATH = "src/os/kernel/arch/x86/port_io_owner.spl"
val BOOT_CPU_PATH = "src/os/kernel/boot/cpu.spl"
val FW_CFG_PATH = "src/os/kernel/fw_cfg/x86_64_named_reader_v1.spl"
val RAMFB_PATH = "src/os/drivers/framebuffer/ramfb.spl"
val PCI_PATH = "src/os/drivers/pci/pci.spl"
val RTC_PATH = "src/os/drivers/rtc/rtc.spl"
val WM_PATH = "src/os/services/wm/wm_host_2d_simpleos.spl"
val SOSIX_IO_PATH = "src/os/sosix/io.spl"
val SOSIX_IO_RW_PATH = "src/os/sosix/io_rw.spl"
val DESKTOP_E2E_PATH = "src/os/test/desktop_e2e_test.spl"
val CONCRETE_OWNER = "os.kernel.arch.x86.port_io_owner"
val ADAPTER_OWNER = "os.kernel.arch_adapt.x86_port_io"
val EXACT_ADAPTER_SOURCE = "# Compile-time x86 Port-I/O Adapter\n" +
    "#\n" +
    "# Portable kernel owners import this boundary instead of reaching into the\n" +
    "# concrete x86 architecture tree.  These public re-exports are resolved at\n" +
    "# compile time: there is no runtime dispatch, allocation, or copied state.\n" +
    "\n" +
    "pub use {CONCRETE_OWNER}.{{\n" +
    "    x86_port_inb,\n" +
    "    x86_port_outb,\n" +
    "    x86_port_inw,\n" +
    "    x86_port_outw,\n" +
    "    x86_port_inl,\n" +
    "    x86_port_outl,\n" +
    "    x86_port_io_wait,\n" +
    "}}\n"
val EXACT_BOOT_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    x86_port_inb, x86_port_outb, x86_port_inw, x86_port_outw,\n" +
    "    x86_port_inl, x86_port_outl, x86_port_io_wait,\n" +
    "}}"
val EXACT_FW_CFG_IMPORT =
    "use {ADAPTER_OWNER}.{{x86_port_inb, x86_port_outw}}"

describe "x86 port-I/O compile-time architecture adapter":
    it "is exactly the allocation-free whole-file forwarding contract":
        step("Read and pin the complete adapter source")
        val source = file_read_text(ADAPTER_PATH)
        expect(source).to_equal(EXACT_ADAPTER_SOURCE)

    it "keeps the owner's rt_port_* declarations matching the C ABI":
        # Rewritten 2026-09-06. The previous example asserted that nine named
        # consumers imported os.kernel.arch_adapt.x86_port_io and did NOT import
        # os.kernel.arch.x86.port_io_owner. That contract no longer describes the
        # tree, and it had been failing on main long enough for the decay to go
        # unnoticed: two of the nine consumers were deleted, two others stopped
        # doing port I/O entirely, and the rest moved onto the concrete owner --
        # which the old example forbade outright. Enumerating consumers by name
        # is also what let the rot spread quietly, because a consumer that
        # dropped the import merely joined an already-red check.
        #
        # The tree-wide invariant that replaces it -- exactly one file under
        # src/os may declare an rt_port_* extern, and it must be the owner --
        # belongs in a gate, not here: a spec reads files, a ratchet scans trees.
        # See scripts/check/check-port-io-single-owner.shs.
        #
        # What is checkable here is the thing that actually broke. While each
        # consumer carried its own declaration, cpu.spl declared
        # `rt_port_inb(port: u64) -> u64` while rtc.spl declared
        # `rt_port_inb(port: u16) -> u8`, against a C ABI of
        # `uint8_t rt_port_inb(uint16_t)`. Two files disagreeing about the ABI of
        # one symbol is precisely what one-by-one rt_ access produces. With a
        # single owner there is a single place to pin it.
        step("Read the single port-I/O owner")
        val owner = file_read_text(OWNER_PATH)

        step("Ports are u16, byte values u8, and nothing is widened to u64")
        expect(owner.contains("rt_port_inb(port: u16) -> u8")).to_equal(true)
        expect(owner.contains("rt_port_outb(port: u16, value: u8)")).to_equal(true)
        expect(owner.contains("-> u64")).to_equal(false)
