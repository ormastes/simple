# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (arm32 kernel link, examples/09_embedded/simple_os/arch/arm32/os_entry.spl):
# rt_pool_safepoint and rt_simple_sandbox_section_start/end had no definition.
# Source-contract spec: proven by scripts/check/check-simpleos-arm32-kernel-link.shs.

use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

val SHIMS = "src/os/kernel/arch/arm32/kernel_shims.spl"
val ENTRY = "examples/09_embedded/simple_os/arch/arm32/os_entry.spl"

describe "arm32 kernel shims":
    it "exports the pool safepoint with the caller's i64 signature":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_pool_safepoint() -> i64:")).to_equal(true)

    it "exports the sandbox section bounds as u64":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_simple_sandbox_section_start() -> u64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_simple_sandbox_section_end() -> u64:")).to_equal(true)

    it "keeps the shim module in the entry closure":
        val src = file_read_text(ENTRY)
        expect(src.contains("use os.kernel.arch.arm32.kernel_shims.{}")).to_equal(true)
