use std.test.{describe, it, expect}
use std.fs.{file_read}

describe "ARM32 authenticated explicit-root mapper static contract":
    it "keeps mapping and destruction behind the ARM32 owner":
        val owner = file_read("src/os/kernel/arch/arm32/user_page_table_owner_v1.spl")
        expect(owner).to_contain("executable_arm32_process_image_ready_v1")
        expect(owner).to_contain("arm32_user_root_create_v1")
        expect(owner).to_contain("arm32_user_unmap_page_in_v1")
        expect(owner).to_contain("arm32_user_root_destroy_v1")
        expect(owner).to_contain("execution_authorized: false")

    it "retains exact root and frame identities for reverse rollback":
        val owner = file_read("src/os/kernel/arch/arm32/user_page_table_owner_v1.spl")
        expect(owner).to_contain("root_phys: u64")
        expect(owner).to_contain("struct Arm32OwnedLeafV1")
        expect(owner).to_contain("var i = leaves.len() - 1")
        expect(owner).to_contain("remaining_leaves")
        expect(owner).to_contain("Arm32UserPageTableStateV1.Quarantined")

    it "uses exact expected-frame unmap and refuses global authorization":
        val paging = file_read("src/os/kernel/arch/arm32/paging.spl")
        val dispatch = file_read("src/os/kernel/loader/executable_target_dispatch_v1.spl")
        expect(paging).to_contain("expected_phys: PhysAddr")
        expect(paging).to_contain("arm32_user_root_destroy_v1")
        expect(dispatch).to_contain("Architecture.Arm32, \"arm\", 32, 0x00000000BFFFFFFFu64")
        expect(dispatch).to_contain("8u64, false")
