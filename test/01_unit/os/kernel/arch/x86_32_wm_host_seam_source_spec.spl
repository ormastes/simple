use std.spec.{describe, it, expect}
use app.io.mod.{file_read_text}

val ENTRY = "examples/09_embedded/simple_os/arch/x86_32/wm_host_seam_entry.spl"
val TARGETS = "src/os/port/_SimpleosMultiplatformBuild/x86_platform_targets.spl"
val BOOT = "examples/09_embedded/simple_os/arch/x86_32/boot/crt0.s"
val STUBS = "examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c"

describe "x86_32 WM host seam source ownership":
    it "uses the shared framebuffer and portable WM owners without copied rendering":
        val source = file_read_text(ENTRY)
        expect(source.contains("FramebufferDriver.from_scanout_raw")).to_equal(true)
        expect(source.contains("wm_host_2d_simpleos(framebuffer)")).to_equal(true)
        expect(source.contains("wm_host_2d_frame(routed")).to_equal(true)
        expect(source.contains("rt_x86_32_wm_scanout_read_pixel")).to_equal(true)
        expect(source.contains("framebuffer.read_pixel")).to_equal(false)
        expect(source.contains("draw_rect")).to_equal(false)
        expect(source.contains("input=unclaimed")).to_equal(true)
        expect(source.contains("input=ready")).to_equal(false)

    it "registers a distinct lane without replacing smoke or filesystem acceptance":
        val source = file_read_text(TARGETS)
        expect(source.contains("x86_32-smoke")).to_equal(true)
        expect(source.contains("x86_32-initrd-fat32-smf")).to_equal(true)
        expect(source.contains("x86_32-multiboot-wm-host-seam")).to_equal(true)
        expect(source.contains("simpleos_x86_32_wm_host_seam.elf")).to_equal(true)

    it "requests and captures Multiboot RGB scanout facts at the boot owner":
        val boot = file_read_text(BOOT)
        val stubs = file_read_text(STUBS)
        expect(boot.contains(".set MB_FLAGS, 0x00000007")).to_equal(true)
        expect(boot.contains(".long 0xE4524FF7")).to_equal(true)
        expect(stubs.contains("x86_32_capture_multiboot_framebuffer(multiboot_magic, multiboot_info)")).to_equal(true)
        expect(stubs.contains("flags & (1U << 12)")).to_equal(true)
        expect(stubs.contains("mbi[109U]")).to_equal(true)
        expect(stubs.contains("mbi[110U]")).to_equal(true)
        expect(stubs.contains("mbi[115U]")).to_equal(true)
        expect(stubs.contains("RuntimeValue rt_x86_32_wm_bind_scanout(uint64_t address, uint64_t width,")).to_equal(true)
        expect(stubs.contains("RuntimeValue rt_gui_fill4(uint64_t xy, uint64_t wh, uint64_t color, uint64_t unused)")).to_equal(true)
        expect(stubs.contains("RuntimeValue rt_x86_32_wm_scanout_read_pixel(uint64_t x, uint64_t y)")).to_equal(true)
        expect(stubs.contains("x >= x86_32_gui_fb_width || y >= x86_32_gui_fb_height")).to_equal(true)
        expect(stubs.contains("offset > x86_32_gui_fb_span - 4U")).to_equal(true)

    it "keeps generic kernel MMIO distinct from bounded WM readback":
        val stubs = file_read_text(STUBS)
        val raw_read = "RuntimeValue rt_volatile_read_u32(uint64_t address)\n" +
            "{\n" +
            "    return (RuntimeValue)*(volatile const uint32_t *)(uintptr_t)(uint32_t)address;\n" +
            "}"
        expect(stubs.contains(raw_read)).to_equal(true)
        expect(stubs.contains("RuntimeValue rt_x86_32_wm_scanout_read_pixel(uint64_t x, uint64_t y)")).to_equal(true)
        expect(raw_read.contains("x86_32_gui_fb_")).to_equal(false)

    it "revokes the retained scanout before accepting or rejecting a rebind":
        val stubs = file_read_text(STUBS)
        val bind_start = stubs.index_of("RuntimeValue rt_x86_32_wm_bind_scanout")
        val revoke = stubs.index_of_from("x86_32_gui_fb_span = 0;", bind_start)
        val first_reject = stubs.index_of_from("if (address == 0U", bind_start)
        val install = stubs.index_of_from("x86_32_gui_fb_addr = (uint32_t)address;", bind_start)
        expect(bind_start >= 0).to_equal(true)
        expect(revoke > bind_start).to_equal(true)
        expect(revoke < first_reject).to_equal(true)
        expect(first_reject < install).to_equal(true)
