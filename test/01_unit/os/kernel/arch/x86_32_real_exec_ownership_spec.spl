use std.io_runtime.{file_read}

describe "x86_32 truthful filesystem execution ownership":
    it "has real target instructions for bounded stdout and exit 37":
        val payload = file_read("examples/09_embedded/simple_os/arch/x86_32/user_fsexec_src/mounted_elf32.S")
        expect(payload).to_contain("movl    %ecx, %ebx")
        expect(payload).to_contain("movl    %edx, %ecx")
        expect(payload).to_contain("movl    $60, %eax")
        expect(payload).to_contain("movl    $37, %ebx")
        expect(payload.split("int     $0x80").len()).to_equal(3)

    it "keeps admitted filesystem evidence distinct from a CPL3 handoff":
        val runtime = file_read("examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c")
        val entry = file_read("examples/09_embedded/simple_os/arch/x86_32/initrd_fs_exec_probe_entry.spl")
        expect(runtime).to_contain("RuntimeValue rt_x86_32_fs_ls_sys_apps(void)")
        expect(runtime).to_contain("RuntimeValue rt_x86_32_fsexec_elf32_present(void)")
        expect(runtime.contains("rt_x86_32_enter_user_elf32")).to_equal(false)
        expect(entry).to_contain("rt_x86_32_fs_ls_sys_apps()")
        expect(entry).to_contain("rt_x86_32_report_fs_program_blocked()")
        expect(entry.contains("write_test_passed_marker")).to_equal(false)
        expect(entry.contains("rt_x86_32_trigger_int80(13u32")).to_equal(false)

    it "gates ELF32 machine, executable PT_LOAD, stdout, and exit opcodes":
        val gate = file_read("scripts/check/check-simpleos-x86-32-user-elf.shs")
        expect(gate).to_contain("--target=i386-unknown-none-elf")
        expect(gate).to_contain("Class:[[:space:]]+ELF32")
        expect(gate).to_contain("Machine:[[:space:]]+Intel 80386")
        expect(gate).to_contain("LOAD .* R E")
        expect(gate).to_contain("$0x3c,%eax")
        expect(gate).to_contain("$0x25,%ebx")
