# @cover src/os/kernel/arch_adapt/arm32_user_mapping.spl 100%
# Exact source-decision coverage for ARM32 scheduler mapping routing.

use std.spec.{describe, it, expect, step}
use app.io.mod.{file_read_text}

val ADAPTER_PATH = "src/os/kernel/arch_adapt/arm32_user_mapping.spl"
val MOVE_PATH = "src/os/kernel/scheduler/scheduler_arm32_mapping_move_v1.spl"
val ADOPTION_PATH = "src/os/kernel/scheduler/scheduler_arm32_executable_adoption_v1.spl"
val PAGE_OWNER = "os.kernel.arch.arm32.user_page_table_owner_v1"
val ENTRY_OWNER = "os.kernel.arch.arm32.user_entry_state_v1"
val ADAPTER_OWNER = "os.kernel.arch_adapt.arm32_user_mapping"

val EXACT_PAGE_EXPORT = "pub use {PAGE_OWNER}.{{\n" +
    "    Arm32UserPageTableReceiptV1,\n" +
    "    Arm32UserPageTableStateV1,\n" +
    "    Arm32UserPageTableErrorV1,\n" +
    "    arm32_user_page_table_rollback_adoption_v1,\n" +
    "    arm32_user_page_table_destroy_v1,\n" +
    "    arm32_scheduler_mapping_handle_admit_v1,\n" +
    "    arm32_scheduler_mapping_handle_rollback_v1,\n" +
    "    arm32_scheduler_mapping_handle_publish_v1,\n" +
    "    arm32_scheduler_mapping_handle_mark_terminal_v1,\n" +
    "    arm32_scheduler_mapping_handle_reap_v1,\n" +
    "    arm32_scheduler_mapping_entry_state_v1,\n" +
    "}}"
val EXACT_ENTRY_EXPORT =
    "pub use {ENTRY_OWNER}.{{Arm32UserEntryStateV1}}"
val EXACT_MOVE_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    Arm32UserPageTableReceiptV1,\n" +
    "    arm32_scheduler_mapping_handle_admit_v1,\n" +
    "    arm32_scheduler_mapping_handle_rollback_v1,\n" +
    "    arm32_scheduler_mapping_handle_publish_v1,\n" +
    "    arm32_scheduler_mapping_handle_mark_terminal_v1,\n" +
    "    arm32_scheduler_mapping_handle_reap_v1,\n" +
    "    arm32_scheduler_mapping_entry_state_v1,\n" +
    "    Arm32UserEntryStateV1\n" +
    "}}"
val EXACT_ADOPTION_IMPORT = "use {ADAPTER_OWNER}.{{\n" +
    "    Arm32UserPageTableReceiptV1, Arm32UserPageTableStateV1,\n" +
    "    Arm32UserPageTableErrorV1,\n" +
    "    arm32_user_page_table_rollback_adoption_v1,\n" +
    "    arm32_user_page_table_destroy_v1\n" +
    "}}"

describe "ARM32 user-mapping compile-time architecture adapter":
    it "re-exports the exact concrete owner surfaces without runtime work":
        step("Read the adapter source and pin both exact export decisions")
        val source = file_read_text(ADAPTER_PATH)
        expect(source.contains(EXACT_PAGE_EXPORT)).to_equal(true)
        expect(source.contains(EXACT_ENTRY_EXPORT)).to_equal(true)
        expect(source.count("pub use ")).to_equal(2)
        expect(source.count(PAGE_OWNER)).to_equal(1)
        expect(source.count(ENTRY_OWNER)).to_equal(1)

        step("Exclude dispatch, state, allocation, calls, and foreign aliases")
        expect(source.contains("fn ")).to_equal(false)
        expect(source.contains("match ")).to_equal(false)
        expect(source.contains("var ")).to_equal(false)
        expect(source.contains("new ")).to_equal(false)
        expect(source.contains("extern fn")).to_equal(false)
        expect(source.contains("rt_")).to_equal(false)

    it "routes both ARM32 scheduler consumers only through the adapter":
        step("Read and pin the exact consumer import blocks")
        val move = file_read_text(MOVE_PATH)
        val adoption = file_read_text(ADOPTION_PATH)
        expect(move.contains(EXACT_MOVE_IMPORT)).to_equal(true)
        expect(adoption.contains(EXACT_ADOPTION_IMPORT)).to_equal(true)
        expect(move.count(ADAPTER_OWNER)).to_equal(1)
        expect(adoption.count(ADAPTER_OWNER)).to_equal(1)

        step("Reject concrete ARM32 owner imports in either consumer")
        expect(move.contains(PAGE_OWNER)).to_equal(false)
        expect(move.contains(ENTRY_OWNER)).to_equal(false)
        expect(adoption.contains(PAGE_OWNER)).to_equal(false)
        expect(adoption.contains(ENTRY_OWNER)).to_equal(false)
