use std.spec.{describe, it, expect}
use os.kernel.arch.x86_32.wm_scanout_contract.{
    X86_32WmScanoutFacts, x86_32_wm_scanout_ready, x86_32_wm_scanout_rejection,
    x86_32_wm_scanout_span
}

fn facts(address: u64, width: u32, height: u32, pitch: u32, bpp: u32, kind: u32) -> X86_32WmScanoutFacts:
    X86_32WmScanoutFacts(
        address: address, width: width, height: height, pitch: pitch,
        bpp: bpp, framebuffer_type: kind,
        red_position: 16u32, red_mask_size: 8u32,
        green_position: 8u32, green_mask_size: 8u32,
        blue_position: 0u32, blue_mask_size: 8u32
    )

describe "x86_32 WM Multiboot scanout admission":
    it "accepts an exact i686 RGB8888 scanout":
        val scanout = facts(0xE0000000u64, 1024u32, 768u32, 4096u32, 32u32, 1u32)
        expect(x86_32_wm_scanout_ready(scanout)).to_equal(true)
        expect(x86_32_wm_scanout_rejection(scanout)).to_equal("")
        expect(x86_32_wm_scanout_span(scanout)).to_equal(3145728u64)

    it "rejects absent, non-i686, malformed, and non-RGB scanouts":
        expect(x86_32_wm_scanout_rejection(facts(0u64, 1u32, 1u32, 4u32, 32u32, 1u32))).to_equal("missing-address")
        expect(x86_32_wm_scanout_rejection(facts(0x100000000u64, 1u32, 1u32, 4u32, 32u32, 1u32))).to_equal("address-outside-i686")
        expect(x86_32_wm_scanout_rejection(facts(5u64, 1u32, 1u32, 4u32, 32u32, 1u32))).to_equal("unaligned-address")
        expect(x86_32_wm_scanout_rejection(facts(4u64, 0u32, 1u32, 4u32, 32u32, 1u32))).to_equal("empty-geometry")
        expect(x86_32_wm_scanout_rejection(facts(4u64, 1u32, 1u32, 4u32, 24u32, 1u32))).to_equal("unsupported-bpp")
        expect(x86_32_wm_scanout_rejection(facts(4u64, 1u32, 1u32, 4u32, 32u32, 2u32))).to_equal("unsupported-framebuffer-type")
        expect(x86_32_wm_scanout_rejection(facts(4u64, 2u32, 1u32, 4u32, 32u32, 1u32))).to_equal("unsupported-pitch")
        expect(x86_32_wm_scanout_rejection(facts(4u64, 1u32, 1u32, 8u32, 32u32, 1u32))).to_equal("unsupported-pitch")

    it "rejects channel layouts and spans that cannot be owned exactly":
        var wrong_red = facts(4u64, 1u32, 1u32, 4u32, 32u32, 1u32)
        wrong_red.red_position = 0u32
        expect(x86_32_wm_scanout_rejection(wrong_red)).to_equal("unsupported-red-layout")
        var wrong_green = facts(4u64, 1u32, 1u32, 4u32, 32u32, 1u32)
        wrong_green.green_mask_size = 7u32
        expect(x86_32_wm_scanout_rejection(wrong_green)).to_equal("unsupported-green-layout")
        var wrong_blue = facts(4u64, 1u32, 1u32, 4u32, 32u32, 1u32)
        wrong_blue.blue_position = 8u32
        expect(x86_32_wm_scanout_rejection(wrong_blue)).to_equal("unsupported-blue-layout")
        expect(x86_32_wm_scanout_rejection(facts(0xFFFFFFFCu64, 1u32, 2u32, 4u32, 32u32, 1u32))).to_equal("span-outside-i686")
