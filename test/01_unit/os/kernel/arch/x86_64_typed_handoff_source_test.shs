#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
python3 - "$root" <<'PY'
import pathlib
import sys
root = pathlib.Path(sys.argv[1])
bridge = (root / 'src/os/kernel/arch/x86_64/user_entry.spl').read_text()
loader = (root / 'src/os/kernel/loader/x86_64_fs_exec_spawn.spl').read_text()
lifecycle = (root / 'src/os/kernel/scheduler/_Scheduler/scheduler_lifecycle.spl').read_text()
def check(bridge, loader, lifecycle):
    assert 'rt_x86_exec_token_take_result_v2(validation.pid, validation.generation, validation.cr3, output as i64)' in bridge
    assert 'rt_ptr_read_i64' not in bridge
    assert 'rt_alloc(' not in bridge and 'rt_free(' not in bridge
    assert 'rc == -4096' not in bridge
    assert bridge.index('val output =') < bridge.index('if rt_x86_exec_token_install(')
    failed_take = bridge.split('if taken != 1:', 1)[1].split('    val bits =', 1)[0]
    assert 'rt_x86_exec_token_result_slot_release_v2(output)' in failed_take
    assert 'rt_x86_exec_token_cancel(' in failed_take
    assert 'return UserHandoffResultV2.Failed(' in failed_take
    assert bridge.index('if taken != 1:') < bridge.index('rt_volatile_read_u64(output)')
    failed_launch = loader.split('case UserHandoffResultV2.Failed(error):', 1)[1].split('    owner.exit_task_by_id', 1)[0]
    assert 'owner.quarantine_failed_user_handoff_v2(child)' in failed_launch
    assert 'return X86AuthenticatedRunResultV2(' in failed_launch
    assert 'scheduler: owner' in failed_launch
    assert 'exit_task_by_id(' not in failed_launch
    assert 'wait_for_collect(' not in failed_launch
    quarantine = lifecycle.split('pub me quarantine_failed_user_handoff_v2(', 1)[1].split('    me exit_task_by_id(', 1)[0]
    assert 'task.state = TaskState.PreparingExit' in quarantine
    assert 'self._remove_ready(id)' in quarantine
    assert 'scheduler_execution_observe_exit' not in quarantine
    assert 'wait_for_collect' not in quarantine
check(bridge, loader, lifecycle)
# Prove the source guard rejects the exact regression it is meant to detect.
sabotaged = loader.replace('val quarantined = owner.quarantine_failed_user_handoff_v2(child)',
                          'owner.exit_task_by_id(child, -22)\n            val quarantined = owner.quarantine_failed_user_handoff_v2(child)', 1)
try:
    check(bridge, sabotaged, lifecycle)
except AssertionError:
    pass
else:
    raise AssertionError('failed-handoff exit sabotage was not detected')
print('PASS typed x86 handoff source wiring and sabotage (not Simple execution)')
PY
