#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
work=$(mktemp -d "${TMPDIR:-/tmp}/x86-typed-handoff.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
bridge="$root/src/os/kernel/arch/x86_64/user_entry.spl"
loader="$root/src/os/kernel/loader/x86_64_fs_exec_spawn.spl"
lifecycle="$root/src/os/kernel/scheduler/_Scheduler/scheduler_lifecycle.spl"

has() { grep -qF -- "$2" "$1"; }
lacks() { ! grep -qF -- "$2" "$1"; }

# First line number containing a fixed marker, or empty when absent.
line_of() { grep -nF -- "$2" "$1" | head -n 1 | cut -d: -f1; }

before() {
    first_line=$(line_of "$1" "$2"); second_line=$(line_of "$1" "$3")
    [ -n "$first_line" ] && [ -n "$second_line" ] && [ "$first_line" -lt "$second_line" ]
}

# Write the lines strictly after the first line containing $2 up to (excluding)
# the next line containing $3 into $4. Markers are fixed strings; an absent
# start marker yields an empty region, which every containment check rejects.
region() {
    awk -v start="$2" -v stop="$3" '
        on && index($0, stop) { exit }
        on { print }
        !on && index($0, start) { on = 1 }
    ' "$1" > "$4"
}

check() {
    src_bridge=$1; src_loader=$2; src_lifecycle=$3
    has "$src_bridge" 'rt_x86_exec_token_take_result_v2(validation.pid, validation.generation, validation.cr3, output as i64)' || return 1
    lacks "$src_bridge" 'rt_ptr_read_i64' || return 1
    lacks "$src_bridge" 'rt_alloc(' || return 1
    lacks "$src_bridge" 'rt_free(' || return 1
    lacks "$src_bridge" 'rc == -4096' || return 1
    before "$src_bridge" 'val output =' 'if rt_x86_exec_token_install(' || return 1
    region "$src_bridge" 'if taken != 1:' '    val bits =' "$work/failed_take"
    has "$work/failed_take" 'rt_x86_exec_token_result_slot_release_v2(output)' || return 1
    has "$work/failed_take" 'rt_x86_exec_token_cancel(' || return 1
    has "$work/failed_take" 'return UserHandoffResultV2.Failed(' || return 1
    before "$src_bridge" 'if taken != 1:' 'rt_volatile_read_u64(output)' || return 1
    region "$src_loader" 'case UserHandoffResultV2.Failed(error):' '    owner.exit_task_by_id' "$work/failed_launch"
    has "$work/failed_launch" 'owner.quarantine_failed_user_handoff_v2(child)' || return 1
    has "$work/failed_launch" 'return X86AuthenticatedRunResultV2(' || return 1
    has "$work/failed_launch" 'scheduler: owner' || return 1
    lacks "$work/failed_launch" 'exit_task_by_id(' || return 1
    lacks "$work/failed_launch" 'wait_for_collect(' || return 1
    region "$src_lifecycle" 'pub me quarantine_failed_user_handoff_v2(' '    me exit_task_by_id(' "$work/quarantine"
    has "$work/quarantine" 'task.state = TaskState.PreparingExit' || return 1
    has "$work/quarantine" 'self._remove_ready(id)' || return 1
    lacks "$work/quarantine" 'scheduler_execution_observe_exit' || return 1
    lacks "$work/quarantine" 'wait_for_collect' || return 1
}

if ! check "$bridge" "$loader" "$lifecycle"; then
    echo 'FAIL typed x86 handoff source wiring' >&2
    exit 1
fi

# Prove the source guard rejects the exact regression it is meant to detect.
marker='val quarantined = owner.quarantine_failed_user_handoff_v2(child)'
grep -qF -- "$marker" "$loader"
awk -v m="$marker" '
    !done && index($0, m) { print "            owner.exit_task_by_id(child, -22)"; done = 1 }
    { print }
' "$loader" > "$work/sabotaged_loader.spl"
if check "$bridge" "$work/sabotaged_loader.spl" "$lifecycle"; then
    echo 'FAIL failed-handoff exit sabotage was not detected' >&2
    exit 1
fi
echo 'PASS typed x86 handoff source wiring and sabotage (not Simple execution)'
