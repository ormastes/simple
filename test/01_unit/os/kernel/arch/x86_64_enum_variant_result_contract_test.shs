#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
cd "$root"
work=$(mktemp -d "${TMPDIR:-/tmp}/x86-enum-variant.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

provider=examples/09_embedded/simple_os/arch/x86_64/boot/freestanding_value_registry.c
harness=test/01_unit/os/kernel/arch/x86_64_enum_variant_result_contract_test.c
include=examples/09_embedded/simple_os/arch/common/boot

"${CC:-cc}" -std=c11 -Wall -Wextra -Werror -I "$include" \
    "$provider" "$harness" -o "$work/enum_variant_test"
"$work/enum_variant_test"
echo 'PASS x86_64 freestanding Result/enum variant predicate'
