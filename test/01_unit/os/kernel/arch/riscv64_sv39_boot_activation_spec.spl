# codex-system-test
use std.spec.*
use std.io_runtime.{file_read}

describe "RV64 Sv39 boot activation contract":
    it "creates and verifies the root before PID1 preparation":
        val boot = file_read("src/os/kernel/arch/riscv64/boot.spl")
        val paging = file_read("src/os/kernel/arch/riscv64/paging.spl")

        step("Check that a failed Sv39 root or SATP activation enters serial recovery")
        val root_init = boot.index_of("if not vmm_init():")
        val activate = boot.index_of("if not vmm_activate():")
        val pid1_prepare = boot.index_of("val pid1 = os_main_prepare_pid1(boot_scheduler)")
        expect(root_init).to_be_greater_than(-1)
        expect(activate).to_be_greater_than(root_init)
        expect(pid1_prepare).to_be_greater_than(activate)
        val failure_paths = boot.slice(root_init, pid1_prepare)
        expect(failure_paths).to_contain("serial_shell_main(0)")
        expect(failure_paths).to_contain("riscv_noalloc_boot_idle()")

        step("Check that only a complete supervisor identity root can activate Sv39")
        expect(paging).to_contain("extern fn rt_riscv_noalloc_alloc_page() -> u64")
        expect(paging).to_contain("fn vmm_init() -> bool:")
        expect(paging).to_contain("fn _root_has_boot_identity_mappings(root_phys: u64) -> bool:")
        expect(paging).to_contain("fn vmm_activate() -> bool:")
        expect(paging).to_contain("if not g_vmm_ready or not _root_has_boot_identity_mappings(g_vmm.root_phys):")
        expect(paging).to_contain("val expected_satp = (SATP_MODE_SV39 << SATP_MODE_SHIFT) | g_vmm.root_ppn")
        expect(paging).to_contain("if csrr_satp() != expected_satp:")
        expect(paging).to_contain("csrw_satp(SATP_MODE_BARE)")
