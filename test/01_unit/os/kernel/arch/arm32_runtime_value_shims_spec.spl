# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (arm32 kernel link): rt_any_to_int, rt_value_truthy, rt_value_u64,
# rt_value_as_u64, rt_enum_check_variant, rt_enum_id, rt_is_present,
# rt_unwrap_or_trap, rt_for_iterable and rt_numeric_contains_u64 had no
# definition for the arm32 kernel. Source-contract spec; behaviour is proven by
# scripts/check/check-simpleos-arm32-kernel-link.shs.

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

val SHIMS = "src/os/kernel/arch/arm32/runtime_value_shims.spl"
val ENTRY = "examples/09_embedded/simple_os/arch/arm32/os_entry.spl"

describe "arm32 kernel runtime value shims":
    it "exports the value conversion helpers":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_value_truthy(v: i64) -> i8:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_any_to_int(v: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_value_u64(bits: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_value_as_u64(v: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_for_iterable(v: i64) -> i64:")).to_equal(true)

    it "exports the enum helpers":
        step("arm32 RuntimeEnum: {HeapHeader 8; u32 enum_id @8; u32 discriminant @12; payload @16}")
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_enum_id(v: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_enum_check_variant(v: i64, enum_id: i64, disc: i64) -> i8:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_is_present(v: i64) -> i8:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_unwrap_or_trap(v: i64) -> i64:")).to_equal(true)

    it "exports the numeric containment helper":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_numeric_contains_u64(array: i64, value: i64) -> i8:")).to_equal(true)

    it "traps instead of returning on a failed unwrap":
        val src = file_read_text(SHIMS)
        expect(src.contains("while true:")).to_equal(true)

    it "keeps the shim module in the arm32 entry closure":
        val src = file_read_text(ENTRY)
        expect(src.contains("use os.kernel.arch.arm32.runtime_value_shims.{}")).to_equal(true)
