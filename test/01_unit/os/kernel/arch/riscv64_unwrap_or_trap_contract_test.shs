#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
cd "$root"
work=$(mktemp -d "${TMPDIR:-/tmp}/rv64-unwrap-contract.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM

runtime="examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_runtime_core.inc.c"
harness="test/01_unit/os/kernel/arch/riscv64_unwrap_or_trap_contract_test.c"
provider="$work/rt_unwrap_provider.c"

cat > "$provider" <<'EOF'
#include <stddef.h>
#include <stdint.h>

typedef int64_t RuntimeValue;

#define TAG_MASK 0x7ULL
#define TAG_HEAP 0x1ULL
#define DECODE_PTR(v) ((void *)((uint64_t)(v) & ~TAG_MASK))
#define IS_HEAP(v) (((uint64_t)(v) & TAG_MASK) == TAG_HEAP)
#define NIL_VALUE ((RuntimeValue)0x3ULL)
#define HEAP_ENUM 7

typedef struct {
    uint32_t type;
    uint32_t size;
} HeapHeader;

typedef struct {
    HeapHeader hdr;
    uint32_t enum_id;
    uint32_t discriminant;
    RuntimeValue payload;
} RuntimeEnum;

_Static_assert(sizeof(HeapHeader) == 8, "HeapHeader must be 8 bytes");
_Static_assert(sizeof(((HeapHeader *)0)->type) == 4, "HeapHeader.type must match uint32_t in baremetal_runtime_core.inc.c");
_Static_assert(offsetof(HeapHeader, type) == 0, "HeapHeader.type must sit at offset 0");
_Static_assert(offsetof(HeapHeader, size) == 4, "HeapHeader.size must sit at offset 4");
_Static_assert(offsetof(RuntimeEnum, enum_id) == 8, "RuntimeEnum.enum_id must sit at offset 8");
_Static_assert(offsetof(RuntimeEnum, discriminant) == 12, "RuntimeEnum.discriminant must sit at offset 12");
_Static_assert(offsetof(RuntimeEnum, payload) == 16, "RuntimeEnum.payload must sit at offset 16");

extern void serial_puts(const char *s);
extern void rt_qemu_exit_failure(void);
EOF

awk '
    /^RuntimeValue rt_unwrap_or_trap\(/ { inside = 1; print; next }
    inside { print; if ($0 == "}") exit }
' "$runtime" | sed 's/__asm__ volatile("wfi");/((void)0);/g' >> "$provider"

"${CC:-clang}" -std=c11 -Wall -Wextra -Werror \
    "$provider" "$harness" -o "$work/rv64_unwrap_or_trap_contract_test"
"$work/rv64_unwrap_or_trap_contract_test"
