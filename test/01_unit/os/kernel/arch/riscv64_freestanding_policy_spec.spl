use std.spec.*
use os.kernel.arch.riscv64.freestanding_policy.{
    rv64_be16_from_bytes,
    rv64_be32_from_bytes,
    rv64_checksum_finish,
    rv64_pci_is_virtio_net,
    rv64_pci_is_virtio_gpu,
    rv64_pci_is_virtio_blk,
    rv64_pci_is_virtio_input
}

describe "RV64 freestanding pure policy":
    it "decodes big-endian scalar bytes without host-endian assumptions":
        expect(rv64_be16_from_bytes(0x00, 0xff)).to_equal(0x00ff)
        expect(rv64_be16_from_bytes(0xff, 0x00)).to_equal(0xff00)
        expect(rv64_be32_from_bytes(0x12, 0x34, 0x56, 0x78)).to_equal(0x12345678)
        expect(rv64_be32_from_bytes(0xff, 0xff, 0xff, 0xff)).to_equal(0xffffffff)

    it "folds checksum carries to the historical ones-complement result":
        expect(rv64_checksum_finish(0)).to_equal(0xffff)
        expect(rv64_checksum_finish(0x102ac)).to_equal(0xfd52)
        expect(rv64_checksum_finish(0xffffffff)).to_equal(0x0000)

    it "requires network class subclass vendor and an exact device id":
        expect(rv64_pci_is_virtio_net(2, 0, 0x1af4, 0x1000)).to_equal(1)
        expect(rv64_pci_is_virtio_net(2, 0, 0x1af4, 0x1041)).to_equal(1)
        expect(rv64_pci_is_virtio_net(1, 0, 0x1af4, 0x1000)).to_equal(0)
        expect(rv64_pci_is_virtio_net(2, 1, 0x1af4, 0x1000)).to_equal(0)
        expect(rv64_pci_is_virtio_net(2, 0, 0x1af5, 0x1000)).to_equal(0)
        expect(rv64_pci_is_virtio_net(2, 0, 0x1af4, 0x1001)).to_equal(0)

    it "preserves the GPU class-agnostic legacy and modern identity policy":
        expect(rv64_pci_is_virtio_gpu(-1, -1, 0x1af4, 0x1010)).to_equal(1)
        expect(rv64_pci_is_virtio_gpu(0xff, 0xff, 0x1af4, 0x1050)).to_equal(1)
        expect(rv64_pci_is_virtio_gpu(3, 0, 0x1af5, 0x1050)).to_equal(0)
        expect(rv64_pci_is_virtio_gpu(3, 0, 0x1af4, 0x104f)).to_equal(0)

    it "accepts only exact VirtIO block and input vendor-device pairs":
        expect(rv64_pci_is_virtio_blk(0x1af4, 0x1001)).to_equal(1)
        expect(rv64_pci_is_virtio_blk(0x1af4, 0x1042)).to_equal(1)
        expect(rv64_pci_is_virtio_blk(0x1af5, 0x1042)).to_equal(0)
        expect(rv64_pci_is_virtio_blk(0x1af4, 0x1043)).to_equal(0)
        expect(rv64_pci_is_virtio_input(0x1af4, 0x1012)).to_equal(1)
        expect(rv64_pci_is_virtio_input(0x1af4, 0x1052)).to_equal(1)
        expect(rv64_pci_is_virtio_input(0x1af5, 0x1052)).to_equal(0)
        expect(rv64_pci_is_virtio_input(0x1af4, 0x1053)).to_equal(0)
