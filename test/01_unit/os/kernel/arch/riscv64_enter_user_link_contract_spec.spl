# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (riscv64 fs-exec kernel link): `_rv64_enter_user` was emitted only under
# its mangled module name while user_entry.spl/context.spl reach it through
# `extern fn _rv64_enter_user`, so the bare symbol was undefined.
# bug: doc/08_tracking/bug/riscv64_fs_exec_kernel_link_undefined_runtime_2026-11-19.md

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

describe "riscv64 kernel link symbol contracts":
    it "exports the naked user-entry trampoline under its bare C name":
        step("trap_vector.spl: @export C name + i64 return matching the externs")
        val src = file_read_text("src/os/kernel/arch/riscv64/trap_vector.spl")
        expect(src.contains("@export(\"C\", name: \"_rv64_enter_user\")\n@section(\".text.trap\")\n@naked\nfn _rv64_enter_user(ctx_addr: u64) -> i64:")).to_equal(true)

