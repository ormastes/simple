# @cover src/os/kernel/arch/riscv64/boot_tcp_policy.spl

use std.spec.*
use os.kernel.arch.riscv64.boot_tcp_policy.{
    rv64_boot_tcp_policy_reset,
    rv64_boot_tcp_policy_coverage_reset,
    rv64_boot_tcp_policy_coverage_mask,
    rv64_boot_tcp_policy_coverage_required,
    rv64_boot_tcp_selected_port,
    rv64_boot_tcp_select_port,
    rv64_boot_tcp_select_explicit_port
}

describe "RV64 pure-Simple boot TCP port policy":
    it "preserves the backward C-oracle address scan":
        rv64_boot_tcp_policy_reset()
        expect(rv64_boot_tcp_select_port("")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("localhost")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("0.0.0.0:2222")).to_equal(2222)
        expect(rv64_boot_tcp_select_port("host:123tail")).to_equal(123)
        expect(rv64_boot_tcp_select_port("host:12x34")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("host:0")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("host:65536")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("1234")).to_equal(8080)

    it "retains the current port when an explicit update is invalid":
        rv64_boot_tcp_policy_reset()
        expect(rv64_boot_tcp_select_explicit_port(9090)).to_equal(9090)
        expect(rv64_boot_tcp_select_explicit_port(0)).to_equal(9090)
        expect(rv64_boot_tcp_select_explicit_port(65536)).to_equal(9090)
        expect(rv64_boot_tcp_selected_port()).to_equal(9090)

    it "derives complete scoped coverage from production policy instrumentation":
        rv64_boot_tcp_policy_reset()
        rv64_boot_tcp_policy_coverage_reset()
        expect(rv64_boot_tcp_select_port("")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("localhost")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("0.0.0.0:2222")).to_equal(2222)
        expect(rv64_boot_tcp_select_port("host:123tail")).to_equal(123)
        expect(rv64_boot_tcp_select_port("host:12x34")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("host:0")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("host:65536")).to_equal(8080)
        expect(rv64_boot_tcp_select_port("1234")).to_equal(8080)
        expect(rv64_boot_tcp_select_explicit_port(9090)).to_equal(9090)
        expect(rv64_boot_tcp_select_explicit_port(0)).to_equal(9090)
        expect(rv64_boot_tcp_policy_coverage_mask()).to_equal(rv64_boot_tcp_policy_coverage_required())
