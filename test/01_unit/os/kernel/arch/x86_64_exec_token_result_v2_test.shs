#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
work=$(mktemp -d "${TMPDIR:-/tmp}/x86-token-result-v2.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
source_c="$root/examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c"
extras_c="$root/examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c"
out="$work/token_test.c"

fail() {
    echo "FAIL x86_64 native token v2 lifecycle: $1" >&2
    exit 1
}

require_once() {
    # $1 file, $2 fixed marker; the marker must occur on exactly one line.
    n=$(grep -cF -- "$2" "$1" || true)
    [ "$n" = 1 ] || fail "marker occurs $n times, expected 1: $2"
}

# Emit the lines from the one starting with $2 up to (excluding) the one
# containing $3. Markers are fixed strings, never regexes.
section() {
    require_once "$1" "$2"
    require_once "$1" "$3"
    awk -v start="$2" -v stop="$3" '
        on && index($0, stop) { exit }
        !on && index($0, start) == 1 { on = 1 }
        on { print }
    ' "$1" > "$work/section.c"
    [ -s "$work/section.c" ] || fail "empty section: $2"
    cat "$work/section.c" >> "$out"
}

# Emit one function from its signature line through its first closing brace.
raw_function() {
    require_once "$1" "$2"
    awk -v start="$2" '
        !on && index($0, start) == 1 { on = 1 }
        on { print }
        on && /^}/ { exit }
    ' "$1" > "$work/function.c"
    [ -s "$work/function.c" ] || fail "empty function: $2"
    cat "$work/function.c" >> "$out"
}

# Compile the actual production state and transition functions. Exclude only
# privileged CR3 reads and the unrelated freestanding runtime dependencies.
printf '%s\n' '#include <stdint.h>' 'typedef int64_t RuntimeValue;' \
    'static int _bare_exec_mode;' 'static int _bare_exec_halt_on_exit;' > "$out"
section "$source_c" 'static uint64_t _x86_exec_token_task' 'static uint64_t _x86_current_cr3(void)'
section "$source_c" 'int64_t rt_x86_exec_token_install' 'static int _x86_exec_token_current_valid(void)'
section "$source_c" 'int64_t rt_x86_exec_token_cancel' 'extern void rt_x86_ring3_resume(int64_t rc);'
require_once "$source_c" '_x86_exec_token_complete_result((int64_t)a0);'
raw_function "$extras_c" 'RuntimeValue rt_volatile_read_u64('
cat "$root/test/01_unit/os/kernel/arch/x86_64_exec_token_result_v2_test.c" >> "$out"

"${CC:-cc}" -std=c11 -Wall -Wextra -Werror "$out" -o "$work/token_test"
"$work/token_test"
echo 'PASS x86_64 native token v2 lifecycle (serialized; no ring-3 execution)'
