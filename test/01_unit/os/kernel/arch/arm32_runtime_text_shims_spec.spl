# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# Repro (arm32 kernel link): rt_string_builder_{new,push,finish}, rt_string_byte_at,
# rt_string_char_code_at, rt_string_char_count, rt_string_from_byte_array,
# rt_string_parse_int, rt_text_cmp_any, rt_text_eq_any, rt_text_find,
# rt_text_is_ascii, rt_slice_text_bytes and rt_raw_i64_to_string had no
# definition for the arm32 kernel.
# Source-contract spec: there is no arm32 kernel unit harness; behaviour is
# proven by the link gate scripts/check/check-simpleos-arm32-kernel-link.shs.

use std.spec.step
use std.spec.{describe, it, expect}
use std.io_runtime.{file_read_text}

val SHIMS = "src/os/kernel/arch/arm32/runtime_text_shims.spl"
val ENTRY = "examples/09_embedded/simple_os/arch/arm32/os_entry.spl"

describe "arm32 kernel runtime text shims":
    it "exports the string builder":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_string_builder_new() -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_builder_push(handle: i64, value: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_builder_finish(handle: i64) -> i64:")).to_equal(true)

    it "exports the string accessors":
        step("arm32 RuntimeString: {u32 type=1; u32 size; u32 len @8; data @12}")
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_string_byte_at(value: i64, index: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_char_code_at(value: i64, index: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_char_count(value: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_from_byte_array(array: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_string_parse_int(value: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_raw_i64_to_string(raw: i64) -> i64:")).to_equal(true)

    it "exports the text comparison and search helpers":
        val src = file_read_text(SHIMS)
        expect(src.contains("@export(\"C\")\nfn rt_text_cmp_any(left: i64, right: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_text_eq_any(left: i64, right: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_text_find(value: i64, needle: i64, start: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_text_is_ascii(value: i64) -> i64:")).to_equal(true)
        expect(src.contains("@export(\"C\")\nfn rt_slice_text_bytes(value: i64, start: i64, end: i64, step: i64) -> i64:")).to_equal(true)

    it "gates every definition on arm32 and keeps the module in the kernel closure":
        val src = file_read_text(SHIMS)
        expect(src.contains("@cfg(arm32)\n@export(\"C\")")).to_equal(true)
        val entry = file_read_text(ENTRY)
        expect(entry.contains("use os.kernel.arch.arm32.runtime_text_shims.{}")).to_equal(true)
