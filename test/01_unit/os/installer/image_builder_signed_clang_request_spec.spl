use std.spec
use os.installer.image_builder.{
    run_image_builder, image_builder_signed_clang_bounds_valid_v1}

fn exact_signed_clang_args() -> [text]:
    [
        "create", "--arch=x86_64",
        "--signed-clang-root=/tmp/simpleos-signed-clang-request",
        "--signed-clang-sources=clang,lld,hello.elf,sysroot.merkle,simpleos.ld,crt0.o,libsimpleos_c.a,libsimple_runtime.a,libm.a",
        "--signed-clang-bundle=clang-toolchain",
        "--signed-clang-payload-leaves=clang,ld.lld,hello.elf,sysroot.merkle,simpleos.ld,crt0.o,libsimpleos_c.a,libsimple_runtime.a,libm.a",
        "--signed-clang-scr1-leaves=clang.scr1,ld.lld.scr1,hello.elf.scr1,sysroot.merkle.scr1,simpleos.ld.scr1,crt0.o.scr1,libsimpleos_c.a.scr1,libsimple_runtime.a.scr1,libm.a.scr1",
        "--signed-clang-sam1=clang.sam1,lld.sam1,hello.sam1,sysroot.sam1,linker.sam1,crt0.sam1,libc.sam1,runtime.sam1,libm.sam1",
        "--signed-clang-seed=signer.seed",
        "--signed-clang-trust=trust.sdn",
        "--signed-clang-descriptor-leaf=clang-catalog.ccrd",
        "--signed-clang-release-id=release-2026-08-25",
        "--signed-clang-canonical-paths=/usr/bin/clang,/usr/bin/ld.lld,/work/hello.elf,/usr/include/.simpleos-sysroot.merkle,/usr/share/simpleos/simpleos.ld,/usr/lib/crt0.o,/usr/lib/libsimpleos_c.a,/usr/lib/libsimple_runtime.a,/usr/lib/libm.a",
        "--signed-clang-max-bytes=1048576,1048576,1048576,1048576,1048576,1048576,1048576,1048576,1048576",
        "--signed-clang-target=x86_64-unknown-simpleos",
    ]

fn exact_primary_append_args() -> [text]:
    [
        "--signed-primary-root=/tmp/simpleos-signed-clang-request",
        "--signed-primary-sources=simplebox,sha256sum,md5sum,grep,ps",
        "--signed-primary-bundle=primary-tools",
        "--signed-primary-payload-leaves=simplebox,sha256sum,md5sum,grep,ps",
        "--signed-primary-scr1-sources=simplebox.scr1,sha256sum.scr1,md5sum.scr1,grep.scr1,ps.scr1",
        "--signed-primary-scr1-leaves=simplebox.scr1,sha256sum.scr1,md5sum.scr1,grep.scr1,ps.scr1",
        "--signed-primary-trust=trust.sdn",
        "--signed-primary-descriptor=primary-tool-release.external.ptrd",
        "--signed-primary-descriptor-leaf=primary-tool-release.ptrd",
        "--signed-primary-release-id=release-2026-08-25",
    ]

fn exact_signed_simplebox_args(root: text) -> [text]:
    [
        "--signed-catalog-root={root}",
        "--signed-catalog-artifact=simplebox",
        "--simplebox-receipt=simplebox.build-receipt",
        "--signed-catalog-sam1=simplebox.sam1",
        "--signed-catalog-identity-receipt=simplebox.identity",
        "--signed-catalog-seed=signer.seed",
        "--signed-catalog-trust=trust.sdn",
        "--signed-catalog-output=simplebox.scr1",
    ]

describe "image-builder signed Clang request admission":
    it "defines the complete exact-nine Clang/sysroot CLI shape":
        step("Include nine ordered rows plus the atomic release descriptor identity")
        val args = exact_signed_clang_args()
        expect(args).to_contain("--signed-clang-descriptor-leaf=clang-catalog.ccrd")
        expect(args).to_contain("--signed-clang-release-id=release-2026-08-25")
        expect(args).to_contain(
            "--signed-clang-canonical-paths=/usr/bin/clang,/usr/bin/ld.lld,/work/hello.elf,/usr/include/.simpleos-sysroot.merkle,/usr/share/simpleos/simpleos.ld,/usr/lib/crt0.o,/usr/lib/libsimpleos_c.a,/usr/lib/libsimple_runtime.a,/usr/lib/libm.a")

    it "rejects a partially specified exact-nine request":
        step("Provide one signed-Clang field without the remaining transaction fields")
        expect(run_image_builder([
            "create", "--arch=x86_64", "--signed-clang-root=missing-fields",
        ])).to_equal(1)

    it "rejects a target triple that is not bound to the selected image architecture":
        step("Change only the signed bundle target while retaining the exact role set")
        var args = exact_signed_clang_args()
        args[args.len() - 1] = "--signed-clang-target=aarch64-unknown-simpleos"
        expect(run_image_builder(args)).to_equal(1)

    it "rejects reordered canonical roles before reading hosted artifacts":
        step("Substitute the linker and compiler guest destinations")
        var args = exact_signed_clang_args()
        args[args.len() - 3] =
            "--signed-clang-canonical-paths=/usr/bin/ld.lld,/usr/bin/clang,/work/hello.elf,/usr/include/.simpleos-sysroot.merkle,/usr/share/simpleos/simpleos.ld,/usr/lib/crt0.o,/usr/lib/libsimpleos_c.a,/usr/lib/libsimple_runtime.a,/usr/lib/libm.a"
        expect(run_image_builder(args)).to_equal(1)

    it "rejects a per-artifact bound above the retained provider ceiling":
        step("Keep artifact bounds distinct from the 16 MiB transfer chunk")
        expect(image_builder_signed_clang_bounds_valid_v1([
            16777217, 1048576, 1048576, 1048576, 1048576,
            1048576, 1048576, 1048576, 1048576,
        ])).to_be(true)
        expect(image_builder_signed_clang_bounds_valid_v1([
            268435457, 1048576, 1048576, 1048576, 1048576,
            1048576, 1048576, 1048576, 1048576,
        ])).to_be(false)
        expect(image_builder_signed_clang_bounds_valid_v1([
            67108864, 67108864, 67108864, 67108864, 67108864,
            67108864, 67108864, 67108864, 67108864,
        ])).to_be(false)

    it "rejects simultaneous legacy and atomic signed bundle modes":
        step("Present both mutually exclusive Clang publication interfaces")
        var args = exact_signed_clang_args()
        args.push("--clang-bundle-root=legacy")
        expect(run_image_builder(args)).to_equal(1)

    it "rejects a partial primary append before retained-root publication":
        step("Present one field without the remaining five-row external media")
        var args = exact_signed_clang_args()
        for simplebox_arg in exact_signed_simplebox_args(
            "/tmp/simpleos-signed-clang-request"):
            args.push(simplebox_arg)
        args.push("--signed-primary-sources=simplebox,sha256sum,md5sum,grep,ps")
        expect(run_image_builder(args)).to_equal(1)

    it "rejects partial Clang alongside complete primary before any publication":
        var args: [text] = ["create", "--arch=x86_64"]
        for simplebox_arg in exact_signed_simplebox_args(
            "/tmp/simpleos-signed-clang-request"):
            args.push(simplebox_arg)
        for primary_arg in exact_primary_append_args(): args.push(primary_arg)
        args.push("--signed-clang-root=/tmp/simpleos-signed-clang-request")
        expect(run_image_builder(args)).to_equal(1)

    it "rejects orphan primary options instead of building an unsigned image":
        step("Request incomplete standalone primary media")
        expect(run_image_builder([
            "create", "--arch=x86_64",
            "--signed-primary-sources=simplebox,sha256sum,md5sum,grep,ps",
        ])).to_equal(1)

    it "requires the existing signed Simplebox payload and SCR1 for PTRD row zero":
        step("Present all five external rows without the signed Simplebox owner")
        var args = exact_signed_clang_args()
        for primary_arg in exact_primary_append_args(): args.push(primary_arg)
        expect(run_image_builder(args)).to_equal(1)

    it "keeps primary append identity ordered and descriptor-explicit":
        step("Name the exact five rows with Simplebox at row zero")
        val args = exact_primary_append_args()
        expect(args.len()).to_equal(10)
        expect(args[0]).to_equal(
            "--signed-primary-root=/tmp/simpleos-signed-clang-request")
        expect(args[1]).to_equal(
            "--signed-primary-sources=simplebox,sha256sum,md5sum,grep,ps")
        expect(args[9]).to_equal(
            "--signed-primary-release-id=release-2026-08-25")

    it "rejects split retained roots before either catalog producer runs":
        step("Bind complete Simplebox and combined rows to different roots")
        var args = exact_signed_clang_args()
        for simplebox_arg in exact_signed_simplebox_args("different-root"):
            args.push(simplebox_arg)
        for primary_arg in exact_primary_append_args(): args.push(primary_arg)
        expect(run_image_builder(args)).to_equal(1)

    it "rejects equal primary and Clang bundle outputs before publication":
        var args = exact_signed_clang_args()
        for simplebox_arg in exact_signed_simplebox_args(
            "/tmp/simpleos-signed-clang-request"):
            args.push(simplebox_arg)
        var primary = exact_primary_append_args()
        primary[2] = "--signed-primary-bundle=clang-toolchain"
        for primary_arg in primary: args.push(primary_arg)
        expect(run_image_builder(args)).to_equal(1)

    it "rejects a primary output overlapping a Clang input before publication":
        var args = exact_signed_clang_args()
        for simplebox_arg in exact_signed_simplebox_args(
            "/tmp/simpleos-signed-clang-request"):
            args.push(simplebox_arg)
        var primary = exact_primary_append_args()
        primary[2] = "--signed-primary-bundle=clang"
        for primary_arg in primary: args.push(primary_arg)
        expect(run_image_builder(args)).to_equal(1)
