use std.spec.{describe, it, expect}
use std.common.contracts.execution.simpleos_executable_v1.{ManifestTarget}
use std.common.crypto.sha256.{sha256_u8_hex}
use os.kernel.loader.executable_manifest_signature_verifier.{
    ExecutableManifestTrustedSignerV1}
use os.kernel.loader.primary_linux_tool_catalog_bundle_v1.{
    primary_linux_tool_catalog_required_paths_v1}
use os.kernel.loader.primary_tool_release_descriptor_v1.{
    PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
    PRIMARY_TOOL_RELEASE_SCR1_MAX_BYTES_V1,
    primary_tool_release_descriptor_verify_v1}
use os.kernel.loader.primary_tool_release_descriptor_codec_v1.{
    PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1,
    encode_primary_tool_release_descriptor_v1,
    decode_primary_tool_release_descriptor_v1}
use os.installer.primary_tool_release_descriptor_producer_v1.{
    PrimaryToolReleaseMediaObservationV1,
    PrimaryToolReleaseDescriptorProduceResultV1,
    produce_primary_tool_release_descriptor_v1}

fn _seed_v1() -> [u8]:
    [
        0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
        0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
        0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    ]

fn _expected_public_key_v1() -> [u8]:
    # RFC 8032 section 7.1, TEST 1.
    [
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    ]

fn _observations_v1() -> [PrimaryToolReleaseMediaObservationV1]:
    val paths = primary_linux_tool_catalog_required_paths_v1()
    var observations: [PrimaryToolReleaseMediaObservationV1] = []
    var index: i64 = 0
    while index < paths.len():
        observations.push(PrimaryToolReleaseMediaObservationV1(
            canonical_path: paths[index],
            payload_sha256: sha256_u8_hex([0x70u8, index.to_u8()]),
            payload_length: 1024 + index,
            scr1_sha256: sha256_u8_hex([0x73u8, index.to_u8()]),
            scr1_length: 256 + index))
        index = index + 1
    observations

fn _target_v1() -> ManifestTarget:
    ManifestTarget(os: "simpleos", arch: "riscv64", abi: "simpleos")

fn _expect_empty_failure_v1(
    result: PrimaryToolReleaseDescriptorProduceResultV1, reason: text
):
    expect(result.ok).to_equal(false)
    expect(result.reason).to_equal(reason)
    expect(result.descriptor_bytes).to_equal([])
    expect(result.public_key).to_equal([])
    expect(result.public_key_sha256).to_equal("")

describe "primary-tool release descriptor producer v1":
    it "produces canonical bounded PTRD bytes for an independently pinned root":
        val produced = produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-2026-08-25", "primary-tool-root",
            _expected_public_key_v1(), _observations_v1(), _seed_v1())
        expect(produced.ok).to_equal(true)
        expect(produced.reason).to_equal("")
        expect(produced.descriptor_bytes.len() > 0).to_equal(true)
        expect(produced.descriptor_bytes.len() <=
            PRIMARY_TOOL_RELEASE_DESCRIPTOR_MAX_WIRE_BYTES_V1).to_equal(true)
        expect(produced.public_key.len()).to_equal(32)
        expect(produced.public_key).to_equal(_expected_public_key_v1())
        expect(produced.public_key_sha256).to_equal(
            sha256_u8_hex(produced.public_key))
        val decoded = decode_primary_tool_release_descriptor_v1(
            produced.descriptor_bytes)
        expect(decoded.ok).to_equal(true)
        expect(primary_tool_release_descriptor_verify_v1(
            decoded.value, [ExecutableManifestTrustedSignerV1(
                key_id: "primary-tool-root",
                public_key: produced.public_key)],
            _target_v1(), "primary-tool-root").ok).to_equal(true)

    it "fails closed on count, path authority, digest, bounds, and key shape":
        val valid = _observations_v1()
        _expect_empty_failure_v1(
            produce_primary_tool_release_descriptor_v1(
                _target_v1(), "release-1", "primary-tool-root",
                _expected_public_key_v1(), [valid[0]], _seed_v1()),
            "media-row-count-invalid")
        var wrong_path = _observations_v1()
        wrong_path[0] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: "/bin/not-authoritative",
            payload_sha256: wrong_path[0].payload_sha256,
            payload_length: wrong_path[0].payload_length,
            scr1_sha256: wrong_path[0].scr1_sha256,
            scr1_length: wrong_path[0].scr1_length)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), wrong_path, _seed_v1()),
            "path-authority-invalid")
        var bad_digest = _observations_v1()
        bad_digest[2] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: bad_digest[2].canonical_path,
            payload_sha256: "bad", payload_length: bad_digest[2].payload_length,
            scr1_sha256: bad_digest[2].scr1_sha256,
            scr1_length: bad_digest[2].scr1_length)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), bad_digest, _seed_v1()),
            "payload-sha256-invalid")
        var bad_scr1 = _observations_v1()
        bad_scr1[1] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: bad_scr1[1].canonical_path,
            payload_sha256: bad_scr1[1].payload_sha256,
            payload_length: bad_scr1[1].payload_length,
            scr1_sha256: "F" * 64, scr1_length: bad_scr1[1].scr1_length)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), bad_scr1, _seed_v1()),
            "scr1-sha256-invalid")
        var bad_bounds = _observations_v1()
        bad_bounds[4] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: bad_bounds[4].canonical_path,
            payload_sha256: bad_bounds[4].payload_sha256, payload_length: 0,
            scr1_sha256: bad_bounds[4].scr1_sha256,
            scr1_length: bad_bounds[4].scr1_length)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), bad_bounds, _seed_v1()),
            "media-bounds-invalid")
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), valid, [1u8]), "signing-key-invalid")

    it "binds the independent RFC public key before signing":
        var wrong_public = _expected_public_key_v1()
        wrong_public[0] = wrong_public[0] ^ 1u8
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root", wrong_public,
            _observations_v1(), _seed_v1()), "signer-public-key-mismatch")
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root", [1u8],
            _observations_v1(), _seed_v1()), "signer-public-key-invalid")
        var wrong_seed = _seed_v1()
        wrong_seed[31] = wrong_seed[31] ^ 1u8
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), _observations_v1(), wrong_seed),
            "signer-public-key-mismatch")

    it "is deterministic and survives canonical decode and re-encode":
        val first = produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), _observations_v1(), _seed_v1())
        val second = produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), _observations_v1(), _seed_v1())
        expect(first.ok).to_equal(true)
        expect(second.ok).to_equal(true)
        expect(first.descriptor_bytes).to_equal(second.descriptor_bytes)
        val decoded = decode_primary_tool_release_descriptor_v1(
            first.descriptor_bytes)
        expect(decoded.ok).to_equal(true)
        val reencoded = encode_primary_tool_release_descriptor_v1(decoded.value)
        expect(reencoded.ok).to_equal(true)
        expect(reencoded.bytes).to_equal(first.descriptor_bytes)
        var tampered_bytes = first.descriptor_bytes
        tampered_bytes[tampered_bytes.len() - 1] =
            tampered_bytes[tampered_bytes.len() - 1] ^ 1u8
        val tampered = decode_primary_tool_release_descriptor_v1(tampered_bytes)
        expect(tampered.ok).to_equal(true)
        expect(primary_tool_release_descriptor_verify_v1(
            tampered.value, [ExecutableManifestTrustedSignerV1(
                key_id: "primary-tool-root",
                public_key: _expected_public_key_v1())],
            _target_v1(), "primary-tool-root").ok).to_equal(false)
        var mutated = _observations_v1()
        mutated[3] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: mutated[3].canonical_path,
            payload_sha256: sha256_u8_hex([0x6du8]),
            payload_length: mutated[3].payload_length,
            scr1_sha256: mutated[3].scr1_sha256,
            scr1_length: mutated[3].scr1_length)
        val changed = produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), mutated, _seed_v1())
        expect(changed.ok).to_equal(true)
        expect(changed.descriptor_bytes == first.descriptor_bytes).to_equal(false)

    it "accepts individual maxima but rejects aggregate overflow":
        var boundary = _observations_v1()
        boundary[0] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: boundary[0].canonical_path,
            payload_sha256: boundary[0].payload_sha256,
            payload_length: PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
            scr1_sha256: boundary[0].scr1_sha256,
            scr1_length: PRIMARY_TOOL_RELEASE_SCR1_MAX_BYTES_V1)
        expect(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), boundary, _seed_v1()).ok).to_equal(true)
        var payload_too_large = _observations_v1()
        payload_too_large[0] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: payload_too_large[0].canonical_path,
            payload_sha256: payload_too_large[0].payload_sha256,
            payload_length: PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1 + 1,
            scr1_sha256: payload_too_large[0].scr1_sha256,
            scr1_length: payload_too_large[0].scr1_length)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), payload_too_large, _seed_v1()),
            "media-bounds-invalid")
        var scr1_too_large = _observations_v1()
        scr1_too_large[0] = PrimaryToolReleaseMediaObservationV1(
            canonical_path: scr1_too_large[0].canonical_path,
            payload_sha256: scr1_too_large[0].payload_sha256,
            payload_length: scr1_too_large[0].payload_length,
            scr1_sha256: scr1_too_large[0].scr1_sha256,
            scr1_length: PRIMARY_TOOL_RELEASE_SCR1_MAX_BYTES_V1 + 1)
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), scr1_too_large, _seed_v1()),
            "media-bounds-invalid")
        var aggregate = _observations_v1()
        var index: i64 = 0
        while index < aggregate.len():
            aggregate[index] = PrimaryToolReleaseMediaObservationV1(
                canonical_path: aggregate[index].canonical_path,
                payload_sha256: aggregate[index].payload_sha256,
                payload_length: PRIMARY_TOOL_RELEASE_PAYLOAD_MAX_BYTES_V1,
                scr1_sha256: aggregate[index].scr1_sha256,
                scr1_length: 1)
            index = index + 1
        _expect_empty_failure_v1(produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release-1", "primary-tool-root",
            _expected_public_key_v1(), aggregate, _seed_v1()),
            "media-bounds-invalid")

    it "rejects malformed fixed release identity with empty output bytes":
        val rejected = produce_primary_tool_release_descriptor_v1(
            _target_v1(), "release id", "primary-tool-root",
            _expected_public_key_v1(), _observations_v1(), _seed_v1())
        _expect_empty_failure_v1(rejected, "release-id-invalid")
