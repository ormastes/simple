use std.spec
use os.installer.hosted_safe_artifact_io_v1.{
    HostedSafeArtifactBundleNGrantV1,
    hosted_safe_artifact_root_acquire_v1,
    hosted_safe_artifact_root_close_v1,
    hosted_safe_artifact_bundle_n_begin_v1,
    hosted_safe_artifact_bundle_n_add_slot_v1,
    hosted_safe_artifact_bundle_n_seal_v1,
    hosted_safe_artifact_bundle_n_read_stage_v1,
    hosted_safe_artifact_bundle_n_slot_complete_v1,
    hosted_safe_artifact_bundle_n_identity_v1,
    hosted_safe_artifact_bundle_n_stage_scr1_v1,
    hosted_safe_artifact_bundle_n_stage_descriptor_v1,
    hosted_safe_artifact_bundle_n_finish_v1,
}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_read_bytes(path: text) -> [u8]

fn bundle_n_source_leaf(slot: i64) -> text:
    "source-" + slot.to_text()

fn bundle_n_payload_leaf(slot: i64) -> text:
    "payload-" + slot.to_text()

fn bundle_n_scr1_leaf(slot: i64) -> text:
    "payload-" + slot.to_text() + ".scr1"

fn reset_bundle_n_fixture(root: text):
    var command = "rm -rf '" + root + "' && mkdir -p '" + root + "'"
    for slot in 0..9:
        command = command + " && printf row-" + slot.to_text() + " > '" +
            root + "/" + bundle_n_source_leaf(slot) + "'"
    val (_, _, status) = rt_process_run("/bin/sh", ["-c", command])
    expect(status).to_equal(0)

fn remove_bundle_n_fixture(root: text):
    val (_, _, status) = rt_process_run(
        "/bin/sh", ["-c", "rm -rf '" + root + "'"])
    expect(status).to_equal(0)

fn begin_bundle_n_fixture(root: text, bundle_leaf: text):
    val opened = hosted_safe_artifact_root_acquire_v1(root)
    expect(opened.is_ok()).to_be(true)
    val authority = opened.unwrap()
    val begun = hosted_safe_artifact_bundle_n_begin_v1(
        authority, bundle_leaf, "catalog.ccrd", 9, 65536)
    expect(begun.is_ok()).to_be(true)
    (authority, begun.unwrap())

fn add_all_bundle_n_rows(grant: HostedSafeArtifactBundleNGrantV1):
    for slot in 0..9:
        expect(hosted_safe_artifact_bundle_n_add_slot_v1(
            grant, slot, bundle_n_source_leaf(slot),
            bundle_n_payload_leaf(slot), bundle_n_scr1_leaf(slot)
        ).is_ok()).to_be(true)

describe "hosted safe-artifact bundle-N transaction":
    it "atomically publishes exactly nine catalog rows and one descriptor":
        step("Retain nine catalog sources and define all nineteen output leaves")
        val root = "build/test-artifacts/hosted-safe-bundle-n-nine"
        reset_bundle_n_fixture(root)
        defer remove_bundle_n_fixture(root)
        val (authority, grant) = begin_bundle_n_fixture(root, "clang-catalog")
        add_all_bundle_n_rows(grant)
        expect(hosted_safe_artifact_bundle_n_seal_v1(grant).is_ok()).to_be(true)

        step("Stage every payload and SCR1 without exposing a partial catalog")
        for slot in 0..9:
            val read = hosted_safe_artifact_bundle_n_read_stage_v1(grant, slot, 64)
            expect(read.is_ok()).to_be(true)
            expect(read.unwrap()).to_equal(("row-" + slot.to_text()).to_bytes())
            expect(hosted_safe_artifact_bundle_n_slot_complete_v1(
                grant, slot).unwrap()).to_be(true)
            val identity = hosted_safe_artifact_bundle_n_identity_v1(grant, slot)
            expect(identity.is_ok()).to_be(true)
            expect(identity.unwrap().len()).to_equal(6)
            expect(hosted_safe_artifact_bundle_n_stage_scr1_v1(
                grant, slot, [0x53u8, 0x43u8, 0x52u8, slot.to_u8()],
                64).is_ok()).to_be(true)
            expect(rt_file_exists("{root}/clang-catalog")).to_be(false)

        val descriptor = [0x43u8, 0x43u8, 0x52u8, 0x44u8, 0x01u8]
        expect(hosted_safe_artifact_bundle_n_stage_descriptor_v1(
            grant, descriptor, 64).is_ok()).to_be(true)
        expect(rt_file_exists("{root}/clang-catalog")).to_be(false)

        step("Commit once and observe all nine rows plus the mandatory descriptor")
        val finished = hosted_safe_artifact_bundle_n_finish_v1(grant, true)
        expect(finished.is_ok()).to_be(true)
        val receipt = finished.unwrap()
        expect(receipt.committed).to_be(true)
        expect(receipt.durable).to_be(true)
        expect(receipt.quarantined).to_be(false)
        expect(receipt.artifact_count).to_equal(9)
        for slot in 0..9:
            expect(rt_file_read_bytes("{root}/clang-catalog/" +
                bundle_n_payload_leaf(slot))).to_equal(
                    ("row-" + slot.to_text()).to_bytes())
            expect(rt_file_exists("{root}/clang-catalog/" +
                bundle_n_scr1_leaf(slot))).to_be(true)
        expect(rt_file_read_bytes(
            "{root}/clang-catalog/catalog.ccrd")).to_equal(descriptor)
        expect(hosted_safe_artifact_root_close_v1(authority).is_ok()).to_be(true)

    it "rejects a duplicate row leaf and rolls back before publication":
        step("Reuse one payload leaf for a second catalog row")
        val root = "build/test-artifacts/hosted-safe-bundle-n-duplicate"
        reset_bundle_n_fixture(root)
        defer remove_bundle_n_fixture(root)
        val (authority, grant) = begin_bundle_n_fixture(root, "clang-catalog")
        expect(hosted_safe_artifact_bundle_n_add_slot_v1(
            grant, 0, bundle_n_source_leaf(0), "payload-0", "payload-0.scr1"
        ).is_ok()).to_be(true)
        val duplicate = hosted_safe_artifact_bundle_n_add_slot_v1(
            grant, 1, bundle_n_source_leaf(1), "payload-0", "payload-1.scr1")
        expect(duplicate.is_err()).to_be(true)
        if val Err(receipt) = duplicate:
            expect(receipt.rolled_back).to_be(true)
            expect(receipt.detail).to_equal("hosted-safe-bundle-n-add-invalid")
        expect(rt_file_exists("{root}/clang-catalog")).to_be(false)
        expect(hosted_safe_artifact_root_close_v1(authority).is_ok()).to_be(true)

    it "rejects an incomplete nine-row commit and removes staged state":
        step("Seal nine rows but leave the last row and descriptor unstaged")
        val root = "build/test-artifacts/hosted-safe-bundle-n-incomplete"
        reset_bundle_n_fixture(root)
        defer remove_bundle_n_fixture(root)
        val (authority, grant) = begin_bundle_n_fixture(root, "clang-catalog")
        add_all_bundle_n_rows(grant)
        expect(hosted_safe_artifact_bundle_n_seal_v1(grant).is_ok()).to_be(true)
        for slot in 0..8:
            expect(hosted_safe_artifact_bundle_n_read_stage_v1(
                grant, slot, 64).is_ok()).to_be(true)
            expect(hosted_safe_artifact_bundle_n_identity_v1(
                grant, slot).is_ok()).to_be(true)
            expect(hosted_safe_artifact_bundle_n_stage_scr1_v1(
                grant, slot, [0x53u8, slot.to_u8()], 64).is_ok()).to_be(true)

        step("Request commit and require a complete rollback instead")
        val finished = hosted_safe_artifact_bundle_n_finish_v1(grant, true)
        expect(finished.is_ok()).to_be(true)
        val receipt = finished.unwrap()
        expect(receipt.committed).to_be(false)
        expect(receipt.rolled_back).to_be(true)
        expect(receipt.artifact_count).to_equal(0)
        expect(receipt.detail).to_equal("hosted-safe-bundle-n-incomplete-rollback")
        expect(rt_file_exists("{root}/clang-catalog")).to_be(false)
        expect(hosted_safe_artifact_root_close_v1(authority).is_ok()).to_be(true)

    it "rolls back an explicit cancellation without exposing any row":
        step("Define the nine-row transaction and cancel before sealing")
        val root = "build/test-artifacts/hosted-safe-bundle-n-cancel"
        reset_bundle_n_fixture(root)
        defer remove_bundle_n_fixture(root)
        val (authority, grant) = begin_bundle_n_fixture(root, "clang-catalog")
        add_all_bundle_n_rows(grant)
        val finished = hosted_safe_artifact_bundle_n_finish_v1(grant, false)
        expect(finished.is_ok()).to_be(true)
        val receipt = finished.unwrap()
        expect(receipt.committed).to_be(false)
        expect(receipt.rolled_back).to_be(true)
        expect(receipt.artifact_count).to_equal(0)
        expect(receipt.detail).to_equal("hosted-safe-bundle-n-caller-rollback")
        expect(rt_file_exists("{root}/clang-catalog")).to_be(false)
        expect(hosted_safe_artifact_root_close_v1(authority).is_ok()).to_be(true)
