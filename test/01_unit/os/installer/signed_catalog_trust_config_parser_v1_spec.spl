use std.spec
use std.fs_driver.bytes_util.{text_to_bytes_pure}
use os.installer.signed_catalog_record_producer_v1.{
    SIGNED_CATALOG_TRUST_CONFIG_MAX_BYTES_V1,
    signed_catalog_trusted_signer_parse_v1}

val KEY_HEX_V1: text =
    "000102030405060708090a0b0c0d0e0f" +
    "101112131415161718191a1b1c1d1e1f"

fn parse_v1(config: text):
    signed_catalog_trusted_signer_parse_v1(text_to_bytes_pure(config))

describe "signed catalog trust-config parser v1":
    it "returns the one configured signer and decoded Ed25519 key":
        val parsed = parse_v1(
            "key_id=release-key_1\npublic_key_ed25519_hex=" + KEY_HEX_V1 + "\n")
        expect(parsed.?).to_equal(true)
        expect(parsed.unwrap().key_id).to_equal("release-key_1")
        expect(parsed.unwrap().public_key.len()).to_equal(32)
        expect(parsed.unwrap().public_key[0]).to_equal(0u8)
        expect(parsed.unwrap().public_key[31]).to_equal(31u8)

    it "rejects duplicate or missing trust fields":
        expect(parse_v1(
            "key_id=first\nkey_id=second\npublic_key_ed25519_hex=" + KEY_HEX_V1).?).to_equal(false)
        expect(parse_v1("key_id=only-key\n").?).to_equal(false)
        expect(parse_v1(
            "key_id=release-key\npublic_key_ed25519_hex=" + KEY_HEX_V1 +
            "\npublic_key_ed25519_hex=" + KEY_HEX_V1).?).to_equal(false)

    it "rejects unknown trust-config fields":
        expect(parse_v1(
            "key_id=release-key\npublic_key_ed25519_hex=" + KEY_HEX_V1 +
            "\ncomment=not-part-of-the-contract\n").?).to_equal(false)

    it "rejects key ids outside the loader trust-root syntax":
        expect(parse_v1(
            "key_id=has:colon\npublic_key_ed25519_hex=" + KEY_HEX_V1).?).to_equal(false)
        expect(parse_v1(
            "key_id=has space\npublic_key_ed25519_hex=" + KEY_HEX_V1).?).to_equal(false)
        expect(parse_v1(
            "key_id=" + ("a" * 129) + "\npublic_key_ed25519_hex=" + KEY_HEX_V1).?).to_equal(false)

    it "rejects malformed or non-32-byte Ed25519 hex":
        expect(parse_v1(
            "key_id=release-key\npublic_key_ed25519_hex=" + ("0" * 62)).?).to_equal(false)
        expect(parse_v1(
            "key_id=release-key\npublic_key_ed25519_hex=" + ("g" * 64)).?).to_equal(false)

    it "rejects empty and oversized documents before parsing":
        expect(signed_catalog_trusted_signer_parse_v1([]).?).to_equal(false)
        var oversized: [u8] = []
        for _ in 0..SIGNED_CATALOG_TRUST_CONFIG_MAX_BYTES_V1 + 1:
            oversized.push(97u8)
        expect(signed_catalog_trusted_signer_parse_v1(oversized).?).to_equal(false)

    it "rejects NUL, control, and non-ASCII bytes before text conversion":
        val prefix = text_to_bytes_pure(
            "key_id=release-key\npublic_key_ed25519_hex=" + KEY_HEX_V1)
        var nul_bytes = prefix
        nul_bytes.push(0u8)
        expect(signed_catalog_trusted_signer_parse_v1(nul_bytes).?).to_equal(false)
        var control_bytes = prefix
        control_bytes.push(13u8)
        expect(signed_catalog_trusted_signer_parse_v1(control_bytes).?).to_equal(false)
        var non_ascii_bytes = prefix
        non_ascii_bytes.push(128u8)
        expect(signed_catalog_trusted_signer_parse_v1(non_ascii_bytes).?).to_equal(false)
