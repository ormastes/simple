use std.io_runtime.{read_file_text}
use std.spec

describe "NVFS retained staged-tree materializer v1 source contract":
    it "reuses the committed DBFS streaming bridge without retaining a tree":
        val source = read_file_text(
            "src/os/installer/nvfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain(
            "StagedTreePublicationSinkV1.Nvfs(driver: driver)")
        expect(source).to_contain(
            "materialize_retained_tree_with_sink_v1(")
        expect(source.contains("for entry in plan.entries")).to_equal(false)
        expect(source.contains("var payload: [u8]")).to_equal(false)
        val shared = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(shared).to_contain("NvfsStreamIngestLeaseV1")
        expect(shared).to_contain("driver.stream_ingest_begin_v1(")
        expect(shared).to_contain("driver.stream_ingest_append_v1(")
        expect(shared).to_contain("driver.stream_ingest_finish_outcome_v1(")
        expect(shared).to_contain("driver.stream_ingest_abort_v1(")

    it "reports the DBFS-backed NVFS identity and non-atomic tree counts":
        val source = read_file_text(
            "src/os/installer/nvfs_staged_tree_materializer_v1.spl")
        expect(source).to_contain("NVFS_STREAM_INGEST_PROVIDER_V1")
        expect(source).to_contain(
            "nvfs-dbfs-backed-per-entry-atomic-v1")
        expect(source).to_contain("tree_atomic: false")
        expect(source).to_contain("files_published: receipt.files_published")
        expect(source).to_contain(
            "directories_published: receipt.directories_published")
        expect(source).to_contain("bytes_published: receipt.bytes_published")

    it "preserves typed publication ambiguity in the NVFS adapter":
        val source = read_file_text(
            "src/lib/nogc_sync_mut/fs_driver/nvfs_driver.spl")
        expect(source).to_contain("enum NvfsPublicationStateV1")
        expect(source).to_contain("NotPublished")
        expect(source).to_contain("Published")
        expect(source).to_contain("Indeterminate")
        expect(source).to_contain("stream_ingest_finish_outcome_v1(")
        expect(source).to_contain("mkdir_publication_outcome_v1(")
        expect(source).to_contain(
            "provider: NVFS_STREAM_INGEST_PROVIDER_V1")

    it "inherits the bounded expected-SHA bridge instead of cloning it":
        val shared = read_file_text(
            "src/os/installer/dbfs_staged_tree_materializer_v1.spl")
        expect(shared).to_contain(
            "remaining < DBFS_STREAM_INGEST_MAX_CHUNK_BYTES")
        expect(shared).to_contain(
            "streamed_sha.unwrap() != entry.provider_digest_sha256")
        expect(shared).to_contain("sink, ingest_lease,")
        expect(shared).to_contain("entry.provider_digest_sha256")
        expect(shared).to_contain(
            "dbfs-materializer-unsupported-entry-kind")
        expect(shared).to_contain("tree_atomic: false")
