# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# i686 SimpleOS kernel link: codegen emits rt_string_new_literal for every string
# literal; the x86_32 freestanding stubs must define it (gate:
# scripts/check/check-simpleos-i686-kernel-link.shs --link-only).

use std.spec.step

use std.io_runtime.{file_read}

fn literal_body(source: text) -> text:
    val parts = source.split("RuntimeValue rt_string_new_literal(RuntimeValue data, RuntimeValue len_val)")
    if parts.len() < 2:
        return ""
    parts[1].split("}")[0]

describe "SimpleOS i686 string literal runtime":
    # @manual scenario evidence
    it "x86_32 stubs define rt_string_new_literal as a raw forward to rt_string_new":
        # @req REQ-SSPEC-OS
        step("x86_32 stubs define rt_string_new_literal as a raw forward to rt_string_new")
        val x86_32 = file_read("examples/09_embedded/simple_os/arch/x86_32/boot/baremetal_stubs.c")
        expect(literal_body(x86_32)).to_contain("return rt_string_new(data, len_val);")

    it "keeps the pure-Simple twin in core_string":
        # @req REQ-SSPEC-OS
        step("keeps the pure-Simple twin in core_string")
        val core = file_read("src/runtime/simple_core/core_string.spl")
        expect(core).to_contain("pub fn rt_string_new_literal(")
