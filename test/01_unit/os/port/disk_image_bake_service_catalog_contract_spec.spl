use std.spec.{describe, it, expect}
use std.io_runtime.{file_read}

describe "PID1 catalogue image contract":
    it "stages every opaque root-service target or fails the PID1 bake":
        val source = file_read("src/os/port/pid1_catalog_disk_bake.spl")
        expect(source).to_contain("SIMPLEOS_VFS_SERVICE_BINARY")
        expect(source).to_contain("SIMPLEOS_NET_SERVICE_BINARY")
        expect(source).to_contain("SIMPLEOS_HTTP_SERVICE_BINARY")
        expect(source).to_contain("/SYSTEM/INIT.SMF")
        expect(source).to_contain("/SYSTEM/SERVICES/VFS.SMF")
        expect(source).to_contain("/SYSTEM/SERVICES/NET.SMF")
        expect(source).to_contain("/SYSTEM/SERVICES/HTTP.SMF")
        expect(source).to_contain("/system/service_manager.smf")
        expect(source).to_contain("/system/services/vfs.smf")
        expect(source).to_contain("/system/services/net.smf")
        expect(source).to_contain("/system/services/http.smf")
        expect(source).to_contain("bake: PID1 requires")
        expect(source).to_contain("_target_elf_valid")
        expect(source).to_contain("little-endian target ELF")
        expect(source).to_contain("rt_exit(1)")
