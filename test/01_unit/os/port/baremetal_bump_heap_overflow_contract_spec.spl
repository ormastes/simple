use std.io_runtime.{file_read}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

describe "RISC-V baremetal bump heap overflow safety":
    it "shares checked allocation and calloc arithmetic across every RISC-V owner":
        val heap = file_read("examples/09_embedded/simple_os/arch/common/baremetal_bump_heap.h")
        val rv32 = file_read("examples/09_embedded/simple_os/arch/riscv32/boot/baremetal_stubs.c")
        val rv64 = file_read("examples/09_embedded/simple_os/arch/riscv64/boot/baremetal_stubs.c")
        val ghdl = file_read("examples/09_embedded/simple_os/arch/riscv64/boot/ghdl_boot_info_runtime.c")

        expect(heap).to_contain("rv_size_add")
        expect(heap).to_contain("rv_size_mul")
        expect(heap).to_contain("rv_size_align16")
        expect(heap).to_contain("aligned > sizeof(g_heap) - g_heap_off")
        expect(heap).to_contain("return rv_calloc(n, size);")
        expect(heap).to_contain("static inline void *rv_realloc(void *ptr, size_t size)")
        expect(heap).to_contain("if (ptr != 0) return 0;")
        expect(heap).to_contain("for (size_t i = 0; i < total; ++i) p[i] = 0;")
        expect(rv32).to_contain("#include \"../../common/baremetal_bump_heap.h\"")
        expect(rv64).to_contain("return rv_calloc(n, size);")
        expect(rv64).to_contain("return rv_realloc(ptr, size);")
        expect(ghdl).to_contain("#include \"../../common/baremetal_bump_heap.h\"")
        expect(ghdl).to_contain("return rv_calloc(n, size);")
        expect(ghdl).to_contain("return rv_realloc(ptr, size);")
        expect(ghdl.contains("static void *rv_alloc(size_t size)")).to_equal(false)

    it "compiles and executes the portable overflow boundary harness":
        val command = "out=/tmp/baremetal-bump-heap-overflow-test.$$; trap 'rm -f \"$out\"' EXIT; cc -std=gnu11 -O0 -I. test/01_unit/os/port/baremetal_bump_heap_overflow_test.c -o \"$out\" && \"$out\""
        val (_stdout, _stderr, exit_code) = rt_process_run_timeout("/bin/sh", ["-c", command], 15000)

        expect(exit_code).to_equal(0)
