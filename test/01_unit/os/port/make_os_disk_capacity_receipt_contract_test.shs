#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
src="$root/scripts/os/make_os_disk.c"
grep -q 'fat_capacity status=fail payload=%s bytes=%zu required_clusters=%d' "$src"
grep -q 'allocated_clusters=%u capacity_clusters=%u cluster_bytes=%zu' "$src"
grep -q 'minimum_image_mb=%llu' "$src"
grep -q 'alloc_payload("/USR/BIN/CLANG"' "$src"
grep -q 'alloc_payload("/SYS/APPS/simple_compiler.smf"' "$src"
grep -q 'Stage only the explicit validated choice' "$src"
! sed -n '/static struct bytes read_simpleos_simple_payload/,/^}/p' "$src" | grep -q 'build/bootstrap/stage3\|bin/release/x86_64'
count=$(grep -c 'alloc_payload("/.*SIMPLE\|alloc_payload("/.*simple' "$src")
[ "$count" -ge 10 ] || { echo "expected attributed duplicate Simple roles, got $count" >&2; exit 1; }
cc -std=c99 -Wall -Wextra -Werror -fsyntax-only "$src"
echo "PASS make_os_disk capacity receipt names payload and exposes Simple role amplification count=$count"
