use std.spec.{describe, it, expect}
use os.port.uno_q_native_2d_admission.{UnoQNative2dEvidence, uno_q_native_2d_admission}

fn evidence(platform: text, board: text, fallback: bool, animation_frames: i64,
            font_glyphs: i64, keyboard: bool, audio_non_silent: bool) -> UnoQNative2dEvidence:
    UnoQNative2dEvidence(
        board_id: board, platform: platform, arch: "aarch64",
        gpu_vendor_id: 0x5143, gpu_name: "Adreno 702", backend: "qualcomm-vulkan",
        draw_ir: true, draw_ir_op_count: 8, animation_frame_count: animation_frames,
        font_glyph_count: font_glyphs, device_executed: true, physical_device: true,
        fallback_used: fallback, submit_count: 1, fence_count: 1,
        readback_bytes: 4096, expected_checksum: 91, actual_checksum: 91,
        boot_id: "boot-1", frame_id: "frame-2", capture_frame_id: "frame-2",
        ctrl_left: true, ctrl_right: true, alt_left: true, alt_right: true,
        key_down: keyboard, key_up: keyboard,
        pointer_move: true, pointer_down: true, pointer_drag: true,
        pointer_up: true, pointer_wheel: true, audio_submitted: 2,
        audio_completed: 2, audio_non_silent: audio_non_silent)

describe "UNO Q QRB2210 native 2D admission":
    it "keeps complete evidence blocked while the canonical QRB2210 port is unavailable":
        val result = uno_q_native_2d_admission(evidence("simpleos", "qrb2210-uno-q", false, 2, 4, true, true))
        expect(result.status).to_equal("blocked")
        expect(result.reason).to_equal("qrb2210-simpleos-port-unavailable")
    it "classifies shipped Debian execution as readiness only":
        val result = uno_q_native_2d_admission(evidence("debian", "qrb2210-uno-q", false, 2, 4, true, true))
        expect(result.status).to_equal("ready")
        expect(result.reason).to_equal("vendor-os-readiness-is-not-simpleos-evidence")
    it "rejects the STM32U585 coprocessor as a desktop target":
        expect(uno_q_native_2d_admission(evidence("simpleos", "stm32u585-uno-q", false, 2, 4, true, true)).reason).to_equal("wrong-board-or-stm32-coprocessor")
    it "rejects any CPU fallback even with matching pixels":
        expect(uno_q_native_2d_admission(evidence("simpleos", "qrb2210-uno-q", true, 2, 4, true, true)).reason).to_equal("device-execution-or-no-fallback-not-proven")
    it "rejects a receipt without animation or font work":
        expect(uno_q_native_2d_admission(evidence("simpleos", "qrb2210-uno-q", false, 1, 0, true, true)).reason).to_equal("drawir-vulkan-route-not-proven")
    it "rejects missing ordinary keyboard delivery":
        expect(uno_q_native_2d_admission(evidence("simpleos", "qrb2210-uno-q", false, 2, 4, false, true)).reason).to_equal("input-receipts-incomplete")
    it "rejects silent audio completion":
        expect(uno_q_native_2d_admission(evidence("simpleos", "qrb2210-uno-q", false, 2, 4, true, false)).reason).to_equal("audio-completion-incomplete")
