# Reproduce guard: the host-staged NVFS volume must be openable by the exact
# driver entry the guest boot path uses.
#
# The nvfs OVMF gate stages a volume with src/os/port/nvfs_image.spl, which
# formats through NvfsPosixDriver, and the guest then mounts it through
# os.kernel.boot.nvfs_root_mount_transaction -> NvfsDriver.new_on_device
# (DbFsDriver.open_on_device). Until 2026-09-01 the guest side was a
# FABRICATED weak stub returning a non-error Result, so these two sides were
# NEVER exercised against each other and their agreement was never tested.
#
# This spec closes that hole host-side, in the interpreter, with no VM: it
# builds the same in-memory volume the image builder writes and then opens it
# exactly the way the boot transaction does. It is deliberately independent of
# QEMU so a format/open disagreement is caught in seconds instead of in a
# 10-minute OVMF run.

use std.spec.{describe, it, expect}
use os.port.nvfs_image.{
    NvfsImageConfig, NvfsImageSeed, _nvfs_image_mem_device
}
use std.fs_driver.nvfs_driver.{NvfsDriver}
use os.kernel.boot.nvfs_root_mount_transaction.{boot_nvfs_root_mount_transaction_v1}

val _SPEC_SECTORS: u64 = 8192u64
val _SPEC_FIRST_ARENA_LBA: i64 = 4
val _SPEC_PROVIDER: text = "nvfs-dbfs-backed-v1"

fn _spec_zero_sector() -> [u8]:
    var out: [u8] = []
    var i = 0
    while i < 512:
        out.push(0u8)
        i = i + 1
    out

fn _spec_staged_device():
    _nvfs_image_mem_device(NvfsImageConfig(
        size_sectors: _SPEC_SECTORS,
        seeds: [NvfsImageSeed(name: "/SEED.TXT", data: [104u8, 105u8])]))

fn main():
    describe("nvfs staged volume / boot open agreement", fn():
        it("stages a volume the image builder accepts", fn():
            val staged = _spec_staged_device()
            expect(staged.is_ok()).to_be_true()
        )

        it("opens the staged volume through the exact boot driver entry", fn():
            # This is the assertion the OVMF gate's L4 rung depends on. When
            # it fails, the guest reports
            #   'nvfs-root: driver-open-failed'
            # and no amount of serial scanning explains why.
            val staged = _spec_staged_device()
            expect(staged.is_ok()).to_be_true()
            val dev = staged.unwrap()
            val arena_blocks = (_SPEC_SECTORS as i64) - _SPEC_FIRST_ARENA_LBA
            val opened = NvfsDriver.new_on_device(
                _SPEC_PROVIDER, dev, _SPEC_FIRST_ARENA_LBA, arena_blocks)
            expect(opened.is_ok()).to_be_true()
        )

        it("runs the whole boot transaction against the staged volume", fn():
            # The guest does NOT compute the arena size — it reads it from the
            # on-disk DBFS backing superblock and passes an LBA bound derived
            # from the NVMe lease. Exercising the real entry point rather than
            # a hand-rolled approximation is what makes this a reproduce guard
            # for the OVMF gate's L4/L5 rungs.
            val staged = _spec_staged_device()
            expect(staged.is_ok()).to_be_true()
            val mounted = boot_nvfs_root_mount_transaction_v1(
                staged.unwrap(), (_SPEC_SECTORS - 4u64))
            expect(mounted.is_ok()).to_be_true()
        )

        it("refuses a volume whose DBFS backing superblock was destroyed", fn():
            # Permanent negative case. Without it the three assertions above
            # have never been observed RED, and a spec that cannot fail proves
            # nothing — which is precisely how this lane was previously
            # reported green off a weak stub. LBA 2-3 are the DBFS backing
            # superblock replicas; zeroing them must make the transaction
            # refuse, not silently succeed.
            val staged = _spec_staged_device()
            expect(staged.is_ok()).to_be_true()
            var dev = staged.unwrap()
            val zeros = _spec_zero_sector()
            val w2 = dev.write_sector(2u64, zeros)
            val w3 = dev.write_sector(3u64, zeros)
            expect(w2.is_ok()).to_be_true()
            expect(w3.is_ok()).to_be_true()
            val mounted = boot_nvfs_root_mount_transaction_v1(
                dev, (_SPEC_SECTORS - 4u64))
            expect(mounted.is_err()).to_be_true()
        )
    )
    return ()
