# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-OS
# arm32 SimpleOS kernel entry closure: os.kernel.arch.hal is x86_64-only (every
# body is @cfg(x86_64) and it imports arch_adapt.hal_current -> x86_64/acpi
# unconditionally), so the arm32 entry must bind the arm32 arch modules directly
# (gate: scripts/check/check-simpleos-arm32-kernel-link.shs --link-only).

use std.spec.step

use std.io_runtime.{file_read}

describe "SimpleOS arm32 kernel entry closure":
    # @manual scenario evidence
    it "does not import the x86_64-only generic HAL":
        # @req REQ-SSPEC-OS
        step("does not import the x86_64-only generic HAL")
        val entry = file_read("examples/09_embedded/simple_os/arch/arm32/os_entry.spl")
        expect(entry.contains("use os.kernel.arch.hal.")).to_equal(false)

    it "binds the arm32 console, cpu and boot modules":
        # @req REQ-SSPEC-OS
        step("binds the arm32 console, cpu and boot modules")
        val entry = file_read("examples/09_embedded/simple_os/arch/arm32/os_entry.spl")
        expect(entry).to_contain("use os.kernel.arch.arm32.console.")
        expect(entry).to_contain("use os.kernel.arch.arm32.cpu.")
        expect(entry).to_contain("use os.kernel.arch.arm32.boot.")
