"""
## Purpose and audience
Purpose: Prove that Crash policy runtime budgets.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-001 — stable requirement identity for this spec.

use std.spipe.*
use os.crash_policy.{
    _half_available_threads, AppWorkloadProfile, default_runtime_budget,
    is_heavy_workload_profile
}

use std.spec.step

describe "Crash policy runtime budgets":
    it "uses half the available threads with a floor of one":
        step("Verify: uses half the available threads with a floor of one")
        # @req: REQ-OS-001
        expect(_half_available_threads(1)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_half_available_threads(2)).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(_half_available_threads(7)).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(_half_available_threads(8)).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "caps dashboard session memory at 8 GiB":
        step("Verify: caps dashboard session memory at 8 GiB")
        val budget = default_runtime_budget(AppWorkloadProfile.DashboardSession)
        expect(budget.memory_limit_mb).to_equal(8192)  # oracle: 8192 — named expected value from the requirement
        expect(budget.max_fds).to_equal(256)  # oracle: 256 — named expected value from the requirement
        expect(budget.max_procs).to_equal(32)  # oracle: 32 — named expected value from the requirement
        expect(budget.quarantine_millis).to_equal(900000)  # oracle: 900000 — named expected value from the requirement

    it "marks compiler profile as heavy":
        step("Verify: marks compiler profile as heavy")
        expect(is_heavy_workload_profile(AppWorkloadProfile.CompilerHeavy)).to_equal(true)
        expect(is_heavy_workload_profile(AppWorkloadProfile.DashboardSession)).to_equal(false)

    it "keeps baremetal single threaded with no host limits":
        step("Verify: keeps baremetal single threaded with no host limits")
        val budget = default_runtime_budget(AppWorkloadProfile.BaremetalDomain)
        expect(budget.max_threads).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(budget.memory_limit_mb).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(budget.wall_timeout_ms).to_equal(0)  # oracle: 0 — named expected value from the requirement
