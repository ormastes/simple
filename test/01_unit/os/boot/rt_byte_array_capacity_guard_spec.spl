"""rt_byte_array_new honours its capacity argument — guard for 2175a16514bb.

As a SimpleOS boot maintainer, I need `rt_byte_array_new(cap)` in the
guest-only baremetal runtime to actually reserve `cap` bytes, so vfs-init
reading a pre-sized FAT32 boot asset makes one exact allocation instead of
doubling through the growth path and permanently leaking every intermediate
buffer on the bump-only heap ([PANIC] heap exhausted at ~191.8 MiB).

WHY GUARD-ONLY: rt_extras.c and baremetal_stubs.c are freestanding guest C
compiled only into the SimpleOS x86_64 boot image; they cannot be linked or
executed in the host interpreter, so this spec is a source-content regression
guard on the fixed definition lines rather than a behavioral test. The old
defect was one line: `RuntimeValue rt_byte_array_new(RuntimeValue capacity)
{ (void)capacity; return rt_bytes_alloc_packed_empty(); }`.
"""
# @req REQ-SIMPLEOS-BYTEARRAY-CAP-001

use std.spec.*
use std.io_runtime.{file_read}

describe "rt_byte_array_new capacity contract (guest boot runtime)":

    it "forwards the capacity argument to rt_bytes_alloc_packed_cap":
        step("Read the guest rt_extras.c source")
        val src = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c")
        step("Assert the fixed definition uses its parameter")
        expect(src).to_contain("RuntimeValue rt_byte_array_new(RuntimeValue capacity) {")
        expect(src).to_contain("RuntimeValue rv = rt_bytes_alloc_packed_cap(capacity);")
        expect(src).to_contain("extern RuntimeValue rt_bytes_alloc_packed_cap(RuntimeValue cap_val);")
        step("Assert the capacity-discarding one-liner is gone")
        expect(src).to_not_contain("(void)capacity; return rt_bytes_alloc_packed_empty();")

    it "keeps the empty-array fallback for invalid requests":
        step("Read the guest rt_extras.c source")
        val src = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/rt_extras.c")
        step("Assert the NIL fallback to the previous empty-array behaviour")
        expect(src).to_contain("if (rv == (RuntimeValue)3 /* NIL */) return rt_bytes_alloc_packed_empty();")

    it "defines the reserving allocator in baremetal_stubs.c":
        step("Read the guest baremetal_stubs.c source")
        val stubs = file_read("examples/09_embedded/simple_os/arch/x86_64/boot/baremetal_stubs.c")
        step("Assert rt_bytes_alloc_packed_cap is defined next to the packed layout")
        expect(stubs).to_contain("RuntimeValue rt_bytes_alloc_packed_cap(RuntimeValue cap_val)")
