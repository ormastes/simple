"""
## Purpose and audience
Purpose: Exercise the imported classes and module globals verified by class_fault_probe_entry.spl (ShortcutHandler, ProbeCounter, probe_events_len) on host interpreter.
Audience: SimpleOS GUI and entry-closure maintainers.
"""
# @req: REQ-OS-GUI-001
# @cover src/os/gui/shortcut.spl
# @cover src/os/gui/class_probe.spl
# @cover examples/09_embedded/simple_os/arch/x86_64/class_fault_probe_entry.spl

use std.spec.{describe, it, expect, step}
use os.gui.input_event.{WmAction}
use os.gui.shortcut.{ShortcutHandler}
use os.gui.class_probe.{ProbeCounter, probe_events_len}

describe "Baremetal imported-class probe contracts on host":
    it "instantiates ShortcutHandler and updates alt_held across press and release scancodes":
        step("Verify ShortcutHandler instantiation, Alt modifier state transition, and Alt+F4 shortcut dispatch")
        var h = ShortcutHandler.new()
        expect(h.alt_held).to_equal(false)

        val press_alt = h.handle_scancode(0x38)
        expect(press_alt).to_equal(WmAction.None)
        expect(h.alt_held).to_equal(true)

        val close_action = h.handle_scancode(0x3E)
        expect(close_action).to_equal(WmAction.Close)

        val release_alt = h.handle_scancode(0xB8)
        expect(release_alt).to_equal(WmAction.None)
        expect(h.alt_held).to_equal(false)

    it "tracks ProbeCounter scalar and heap-array module globals across instantiations and bump calls":
        step("Verify ProbeCounter.new reads scalar module global and bump pushes into module event array")
        val before_events = probe_events_len()
        var c1 = ProbeCounter.new()
        var c2 = ProbeCounter.new()
        expect(c2.count).to_equal(c1.count + 1)

        val bumped = c1.bump(5)
        expect(bumped).to_equal(c1.count)
        expect(probe_events_len()).to_equal(before_events + 1)
