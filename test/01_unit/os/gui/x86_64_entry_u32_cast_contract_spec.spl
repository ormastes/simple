"""
## Purpose and audience
Purpose: Guard x86_64 SimpleOS GUI entry files against scalar .to_u32() calls in entry-closure native builds.
Audience: SimpleOS kernel and native-build maintainers.
"""
# @req: REQ-OS-GUI-001
# @cover examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl
# @cover examples/09_embedded/simple_os/arch/x86_64/gui_entry_browser.spl
# @cover examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d.spl
# @cover examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d_virtio.spl
# @cover examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d_virtio_factory.spl

use std.spec.{describe, it, expect, step}
use std.io_runtime.{file_read}

describe "SimpleOS x86_64 GUI entry u32 cast contract":
    it "avoids scalar .to_u32() method calls in freestanding GUI entrypoints":
        step("Verify all five x86_64 GUI entrypoints use `as u32` casts rather than `.to_u32()`")
        val entry_files = [
            "examples/09_embedded/simple_os/arch/x86_64/gui_entry_desktop.spl",
            "examples/09_embedded/simple_os/arch/x86_64/gui_entry_browser.spl",
            "examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d.spl",
            "examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d_virtio.spl",
            "examples/09_embedded/simple_os/arch/x86_64/gui_entry_engine2d_virtio_factory.spl"
        ]
        for path in entry_files:
            val src = file_read(path)
            expect(src.len() > 0).to_equal(true)
            expect(src.contains(".to_u32()")).to_equal(false)
            expect(src.contains("as u32")).to_equal(true)
