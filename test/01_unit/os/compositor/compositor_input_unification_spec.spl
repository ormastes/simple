# Regression harness for WS-C C1 (input event-type unification).
#
# This spec exists to prove that routing backend input through ONE event type
# (`HostInputEvent`) and ONE queue produces the SAME observable compositor
# state as the pre-unification path, for a recorded input sequence. It was
# written and made green against the LEGACY `_handle_input_backend`
# (poll_key + poll_mouse read directly) BEFORE that function was rewritten, so
# a pass after the rewrite is an equivalence result and not a tautology.
#
# Observables asserted (everything the legacy body actually wrote):
#   cursor.x / cursor.y                      -- clamped absolute position
#   pending_wm_pointer_{x,y,button_code,kind_code}
#   focused_idx                              -- left-press focus hit test
#   pending_meta_key                         -- alt held during a key event
#   pending_shortcut                         -- ctrl+alt chord capture
#
# `ScriptedInput` yields at MOST ONE event per frame, so the spec behaves
# identically whether the compositor polls once per `handle_input()` (legacy)
# or drains in a bounded loop (unified).

use std.spec
use os.compositor.compositor.{Compositor}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use os.compositor.display_backend.{CompositorBackend}
use os.compositor.input_backend.{InputBackend}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.drivers.input.ps2_mouse.{MouseEvent}

class ScriptedInput:
    """Replays a fixed recorded script, one event per poll, then nothing.

    The script is loaded at CONSTRUCTION, never afterwards: assigning a class
    into the compositor's `input: InputBackend?` trait-object field does not
    keep the spec's handle aliased to it, so post-construction `load_*` calls
    mutate a copy the compositor never reads. (A first draft of this spec did
    exactly that and every assertion silently measured a compositor that had
    received no input at all.)"""
    keys: [KeyEvent]
    mice: [MouseEvent]
    key_idx: i64
    mouse_idx: i64
    shift: bool
    ctrl: bool
    alt: bool
    char_for_key: text

impl ScriptedInput:
    static fn mouse_script(evs: [MouseEvent]) -> ScriptedInput:
        ScriptedInput(
            keys: [], mice: evs, key_idx: 0, mouse_idx: 0,
            shift: false, ctrl: false, alt: false, char_for_key: "a"
        )

    static fn key_script(
        evs: [KeyEvent], ch: text, shift: bool, ctrl: bool, alt: bool
    ) -> ScriptedInput:
        ScriptedInput(
            keys: evs, mice: [], key_idx: 0, mouse_idx: 0,
            shift: shift, ctrl: ctrl, alt: alt, char_for_key: ch
        )

impl InputBackend for ScriptedInput:
    me poll_key() -> KeyEvent?:
        if self.key_idx >= self.keys.len():
            return nil
        val k = self.keys[self.key_idx]
        self.key_idx = self.key_idx + 1
        k

    me poll_mouse() -> MouseEvent?:
        if self.mouse_idx >= self.mice.len():
            return nil
        val m = self.mice[self.mouse_idx]
        self.mouse_idx = self.mouse_idx + 1
        m

    fn alt_held() -> bool:
        self.alt

    fn shift_held() -> bool:
        self.shift

    fn ctrl_held() -> bool:
        self.ctrl

    fn key_to_char(key: Key) -> text?:
        if self.char_for_key == "":
            return nil
        Some(self.char_for_key)

fn mouse_at(x: i64, y: i64) -> MouseEvent:
    MouseEvent(
        x: x, y: y, dx: 0, dy: 0,
        left_pressed: false, right_pressed: false, middle_pressed: false,
        left_just_pressed: false, right_just_pressed: false,
        left_just_released: false, wheel: 0
    )

fn compositor_with(input: ScriptedInput) -> Compositor:
    val backend: CompositorBackend = HeadlessHostCompositorBackend.new(200, 150)
    Compositor.with_backends(backend, input, 200, 150)

fn compositor_with_mice(evs: [MouseEvent]) -> Compositor:
    compositor_with(ScriptedInput.mouse_script(evs))

fn compositor_with_keys(
    evs: [KeyEvent], ch: text, shift: bool, ctrl: bool, alt: bool
) -> Compositor:
    compositor_with(ScriptedInput.key_script(evs, ch, shift, ctrl, alt))

fn drive(c: Compositor, frames: i64):
    """Run the input path `frames` times.

    Deliberately frame-count-insensitive: the legacy path consumed one event
    per call and the unified path drains in a bounded loop, so this is called
    with at least as many frames as there are scripted events and only the
    resulting END STATE is asserted. That is what makes the same spec a valid
    oracle on both sides of the migration."""
    var i = 0
    while i < frames:
        c.handle_input()
        i = i + 1

describe "compositor input path — recorded sequence equivalence":
    it "places the cursor at the reported absolute position":
        var c = compositor_with_mice([mouse_at(40, 30)])
        drive(c, 2)
        expect(c.cursor.x).to_equal(40)
        expect(c.cursor.y).to_equal(30)
        expect(c.pending_wm_pointer_valid).to_equal(true)
        expect(c.pending_wm_pointer_x).to_equal(40)
        expect(c.pending_wm_pointer_y).to_equal(30)
        # Pure motion: no button, "move" kind.
        expect(c.pending_wm_pointer_button_code).to_equal(0)
        expect(c.pending_wm_pointer_kind_code).to_equal(3)

    it "clamps the cursor below zero to the origin":
        var c = compositor_with_mice([mouse_at(-50, -50)])
        drive(c, 2)
        expect(c.cursor.x).to_equal(0)
        expect(c.cursor.y).to_equal(0)

    it "clamps the cursor past the screen to the last pixel":
        var c = compositor_with_mice([mouse_at(9999, 9999)])
        drive(c, 2)
        expect(c.cursor.x).to_equal(199)
        expect(c.cursor.y).to_equal(149)

    it "reports (button 1, kind 1) for a left press":
        var press = mouse_at(50, 50)
        press.left_pressed = true
        press.left_just_pressed = true
        var c = compositor_with_mice([press])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(1)
        expect(c.pending_wm_pointer_kind_code).to_equal(1)

    it "reports (button 3, kind 1) for a right press":
        var rpress = mouse_at(51, 51)
        rpress.right_pressed = true
        rpress.right_just_pressed = true
        var c = compositor_with_mice([rpress])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(3)
        expect(c.pending_wm_pointer_kind_code).to_equal(1)

    it "reports (button 1, kind 2) for a left release":
        var release = mouse_at(52, 52)
        release.left_just_released = true
        var c = compositor_with_mice([release])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(1)
        expect(c.pending_wm_pointer_kind_code).to_equal(2)

    it "reports (button 2, kind 3) for a held middle button":
        var middle = mouse_at(53, 53)
        middle.middle_pressed = true
        var c = compositor_with_mice([middle])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(2)
        expect(c.pending_wm_pointer_kind_code).to_equal(3)

    it "does not change focus on a bare move":
        var c = compositor_with_mice([mouse_at(20, 20)])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        expect(c.focused_idx).to_equal(1)
        drive(c, 2)
        expect(c.focused_idx).to_equal(1)

    it "focuses the window under a left press":
        var press = mouse_at(20, 20)
        press.left_pressed = true
        press.left_just_pressed = true
        var c = compositor_with_mice([press])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        expect(c.focused_idx).to_equal(1)
        drive(c, 2)
        expect(c.focused_idx).to_equal(0)

    it "leaves focus alone for a left press on empty desktop":
        var miss = mouse_at(190, 5)
        miss.left_pressed = true
        miss.left_just_pressed = true
        var c = compositor_with_mice([miss])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        drive(c, 2)
        expect(c.focused_idx).to_equal(1)

    it "raises pending_meta_key when alt is held during a key event":
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.A)], "a", false, false, true
        )
        expect(c.pending_meta_key).to_equal(0)
        drive(c, 2)
        expect(c.pending_meta_key).to_equal(1)

    it "captures a ctrl+alt chord into pending_shortcut":
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.T)], "t", false, true, true
        )
        expect(c.pending_shortcut).to_equal("")
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("t")

    it "does not capture a shortcut for a plain key press":
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.T)], "t", false, false, false
        )
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("")
        expect(c.pending_meta_key).to_equal(0)

    it "ignores a key release for shortcut purposes":
        var c = compositor_with_keys(
            [KeyEvent.Release(Key.T)], "t", false, true, true
        )
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("")
        # ...but alt-held still raises the meta flag, as it always did.
        expect(c.pending_meta_key).to_equal(1)

    it "replays a full recorded drag sequence to the same end state":
        var down = mouse_at(20, 20)
        down.left_pressed = true
        down.left_just_pressed = true
        var m1 = mouse_at(25, 25)
        m1.left_pressed = true
        var m2 = mouse_at(30, 30)
        m2.left_pressed = true
        var m3 = mouse_at(35, 35)
        m3.left_pressed = true
        var up = mouse_at(40, 40)
        up.left_just_released = true

        var c = compositor_with_mice([down, m1, m2, m3, up])
        val w = c.create_window("target", 10, 10, 60, 60)
        drive(c, 6)

        expect(c.cursor.x).to_equal(40)
        expect(c.cursor.y).to_equal(40)
        expect(c.pending_wm_pointer_button_code).to_equal(1)
        expect(c.pending_wm_pointer_kind_code).to_equal(2)
        expect(c.focused_idx).to_equal(0)
