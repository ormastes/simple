"""
## Purpose and audience
Purpose: Prove that compositor input path — recorded sequence equivalence.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# Regression harness for WS-C C1 (input event-type unification).
#
# This spec exists to prove that routing backend input through ONE event type
# (`HostInputEvent`) and ONE queue produces the SAME observable compositor
# state as the pre-unification path, for a recorded input sequence. It was
# written and made green against the LEGACY `_handle_input_backend`
# (poll_key + poll_mouse read directly) BEFORE that function was rewritten, so
# a pass after the rewrite is an equivalence result and not a tautology.
#
# Observables asserted (everything the legacy body actually wrote):
#   cursor.x / cursor.y                      -- clamped absolute position
#   pending_wm_pointer_{x,y,button_code,kind_code}
#   focused_idx                              -- left-press focus hit test
#   pending_meta_key                         -- alt held during a key event
#   pending_shortcut                         -- ctrl+alt chord capture
#
# `ScriptedInput` yields at MOST ONE event per frame, so the spec behaves
# identically whether the compositor polls once per `handle_input()` (legacy)
# or drains in a bounded loop (unified).

use std.spec
use os.compositor.compositor.{Compositor}
use os.compositor.wm_action_lifecycle.{
    wm_lifecycle_bounded_window_width,
    wm_lifecycle_bounded_window_height,
    wm_lifecycle_resize_grip_hit
}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use os.compositor.display_backend.{CompositorBackend}
use os.compositor.input_backend.{InputBackend, host_event_from_polled}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.drivers.input.ps2_mouse.{MouseEvent}
use common.ui.host_input_event.{HostInputEvent}

class ScriptedInput:
    """Replays a fixed recorded script, one event per poll, then nothing.

    The script is loaded at CONSTRUCTION, never afterwards: assigning a class
    into the compositor's `input: InputBackend?` trait-object field does not
    keep the spec's handle aliased to it, so post-construction `load_*` calls
    mutate a copy the compositor never reads. (A first draft of this spec did
    exactly that and every assertion silently measured a compositor that had
    received no input at all.)"""
    keys: [KeyEvent]
    mice: [MouseEvent]
    key_idx: i64
    mouse_idx: i64
    shift: bool
    ctrl: bool
    alt: bool
    char_for_key: text

impl ScriptedInput:
    static fn mouse_script(evs: [MouseEvent]) -> ScriptedInput:
        ScriptedInput(
            keys: [], mice: evs, key_idx: 0, mouse_idx: 0,
            shift: false, ctrl: false, alt: false, char_for_key: "a"
        )

    static fn key_script(
        evs: [KeyEvent], ch: text, shift: bool, ctrl: bool, alt: bool
    ) -> ScriptedInput:
        ScriptedInput(
            keys: evs, mice: [], key_idx: 0, mouse_idx: 0,
            shift: shift, ctrl: ctrl, alt: alt, char_for_key: ch
        )

impl InputBackend for ScriptedInput:

    me poll_event() -> HostInputEvent?:
        """The ONE trait-level ingress. Composes the inherent poll_key/poll_mouse
        pair through the shared helper, exactly as the real backends do."""
        val key_opt: KeyEvent? = self.poll_key()
        var ch = ""
        if val key_event = key_opt:
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return host_event_from_polled(
                key_opt, nil, ch,
                self.shift_held(), self.ctrl_held(), self.alt_held()
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        host_event_from_polled(
            nil, mouse_opt, "",
            self.shift_held(), self.ctrl_held(), self.alt_held()
        )
    me poll_key() -> KeyEvent?:
        if self.key_idx >= self.keys.len():
            return nil
        val k = self.keys[self.key_idx]
        self.key_idx = self.key_idx + 1
        k

    me poll_mouse() -> MouseEvent?:
        if self.mouse_idx >= self.mice.len():
            return nil
        val m = self.mice[self.mouse_idx]
        self.mouse_idx = self.mouse_idx + 1
        m

    fn alt_held() -> bool:
        self.alt

    fn shift_held() -> bool:
        self.shift

    fn ctrl_held() -> bool:
        self.ctrl

    fn key_to_char(key: Key) -> text?:
        if self.char_for_key == "":
            return nil
        Some(self.char_for_key)

fn mouse_at(x: i64, y: i64) -> MouseEvent:
    MouseEvent(
        x: x, y: y, dx: 0, dy: 0,
        left_pressed: false, right_pressed: false, middle_pressed: false,
        left_just_pressed: false, right_just_pressed: false,
        left_just_released: false, wheel: 0
    )

fn compositor_with(input: ScriptedInput) -> Compositor:
    val backend: CompositorBackend = HeadlessHostCompositorBackend.new(200, 150)
    Compositor.with_backends(backend, input, 200, 150)

fn compositor_with_mice(evs: [MouseEvent]) -> Compositor:
    compositor_with(ScriptedInput.mouse_script(evs))

fn compositor_with_keys(
    evs: [KeyEvent], ch: text, shift: bool, ctrl: bool, alt: bool
) -> Compositor:
    compositor_with(ScriptedInput.key_script(evs, ch, shift, ctrl, alt))

fn focused_id(c: Compositor) -> i32:
    """The focused window's ID, not its index.

    `focus_window` RAISES the chosen surface to the end of `surfaces` and then
    sets `focused_idx = len - 1`, so the index is a stacking artefact and is
    the same number whichever window you click. Only the ID identifies it."""
    if c.focused_idx < 0 or c.focused_idx >= c.surfaces.len():
        return -1
    c.surfaces[c.focused_idx].id

fn drive(c: Compositor, frames: i64):
    """Run the input path `frames` times.

    Deliberately frame-count-insensitive: the legacy path consumed one event
    per call and the unified path drains in a bounded loop, so this is called
    with at least as many frames as there are scripted events and only the
    resulting END STATE is asserted. That is what makes the same spec a valid
    oracle on both sides of the migration."""
    var i = 0
    while i < frames:
        c.handle_input()
        i = i + 1

describe "compositor input path — recorded sequence equivalence":
    it "places the cursor at the reported absolute position":
        step("Verify: places the cursor at the reported absolute position")
        # @req: REQ-OS-COMPOSITOR-001
        var c = compositor_with_mice([mouse_at(40, 30)])
        # Guard against the vacuous run: if the backend did not land in the
        # compositor's trait-object field, handle_input() falls through to the
        # PS/2 port path and every assertion below measures a compositor that
        # received nothing. A first draft of this spec failed exactly that way.
        expect(c.input != nil).to_equal(true)
        drive(c, 2)
        expect(c.cursor.x).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(c.cursor.y).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(c.pending_wm_pointer_valid).to_equal(true)
        expect(c.pending_wm_pointer_x).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(c.pending_wm_pointer_y).to_equal(30)  # oracle: 30 — named expected value from the requirement
        # Pure motion: no button, "move" kind.
        expect(c.pending_wm_pointer_button_code).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "clamps the cursor below zero to the origin":
        step("Verify: clamps the cursor below zero to the origin")
        var c = compositor_with_mice([mouse_at(-50, -50)])
        drive(c, 2)
        expect(c.cursor.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(c.cursor.y).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "clamps the cursor past the screen to the last pixel":
        step("Verify: clamps the cursor past the screen to the last pixel")
        var c = compositor_with_mice([mouse_at(9999, 9999)])
        drive(c, 2)
        expect(c.cursor.x).to_equal(199)  # oracle: 199 — named expected value from the requirement
        expect(c.cursor.y).to_equal(149)  # oracle: 149 — named expected value from the requirement

    it "reports (button 1, kind 1) for a left press":
        step("Verify: reports (button 1, kind 1) for a left press")
        var press = mouse_at(50, 50)
        press.left_pressed = true
        press.left_just_pressed = true
        var c = compositor_with_mice([press])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "reports (button 3, kind 1) for a right press":
        step("Verify: reports (button 3, kind 1) for a right press")
        var rpress = mouse_at(51, 51)
        rpress.right_pressed = true
        rpress.right_just_pressed = true
        var c = compositor_with_mice([rpress])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "reports (button 1, kind 2) for a left release":
        step("Verify: reports (button 1, kind 2) for a left release")
        var release = mouse_at(52, 52)
        release.left_just_released = true
        var c = compositor_with_mice([release])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "reports (button 2, kind 3) for a held middle button":
        step("Verify: reports (button 2, kind 3) for a held middle button")
        var middle = mouse_at(53, 53)
        middle.middle_pressed = true
        var c = compositor_with_mice([middle])
        drive(c, 2)
        expect(c.pending_wm_pointer_button_code).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "does not change focus on a bare move":
        step("Verify: does not change focus on a bare move")
        var c = compositor_with_mice([mouse_at(20, 20)])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        expect(focused_id(c)).to_equal(w2)
        drive(c, 2)
        expect(focused_id(c)).to_equal(w2)

    it "focuses the window under a left press":
        step("Verify: focuses the window under a left press")
        var press = mouse_at(20, 20)
        press.left_pressed = true
        press.left_just_pressed = true
        var c = compositor_with_mice([press])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        expect(focused_id(c)).to_equal(w2)
        drive(c, 2)
        expect(focused_id(c)).to_equal(w1)

    it "turns a held-left relative frame into the canonical drag step":
        step("Verify: turns a held-left relative frame into the canonical drag step")
        var down = mouse_at(20, 15)
        down.left_pressed = true
        down.left_just_pressed = true
        var drag = mouse_at(50, 40)
        drag.left_pressed = true
        var c = compositor_with_mice([down, drag])
        val w1 = c.create_window("one", 10, 10, 80, 60)
        drive(c, 3)
        expect(c.pending_wm_pointer_button_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(c.dragging).to_equal(true)
        var moved = c.surfaces[0]
        expect(moved.id).to_equal(w1)
        expect(moved.x).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(moved.y).to_equal(35)  # oracle: 35 — named expected value from the requirement

    it "resizes the topmost window from its canonical south-east grip":
        step("Verify: resizes the topmost window from its canonical south-east grip")
        var down = mouse_at(109, 89)
        down.left_pressed = true
        down.left_just_pressed = true
        var resize = mouse_at(190, 140)
        resize.left_pressed = true
        var up = mouse_at(190, 140)
        up.left_just_released = true
        var c = compositor_with_mice([down, resize, up])
        val window_id = c.create_window("resizable", 10, 10, 100, 80)
        drive(c, 4)
        val resized = c.surfaces[0]
        expect(resized.id).to_equal(window_id)
        expect(resized.width).to_equal(181)  # oracle: 181 — named expected value from the requirement
        expect(resized.height).to_equal(131)  # oracle: 131 — named expected value from the requirement
        expect(c.resizing).to_equal(false)
        expect(c.resize_window_id).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "keeps interactive resize geometry inside canonical min and desktop bounds":
        step("Verify: keeps interactive resize geometry inside canonical min and desktop bounds")
        expect(wm_lifecycle_bounded_window_width(20, 800)).to_equal(160)  # oracle: 160 — named expected value from the requirement
        expect(wm_lifecycle_bounded_window_height(20, 600)).to_equal(120)  # oracle: 120 — named expected value from the requirement
        expect(wm_lifecycle_bounded_window_width(900, 800)).to_equal(800)  # oracle: 800 — named expected value from the requirement
        expect(wm_lifecycle_bounded_window_height(700, 600)).to_equal(600)  # oracle: 600 — named expected value from the requirement
        expect(wm_lifecycle_resize_grip_hit(10, 20, 300, 200, 309, 219)).to_equal(true)
        expect(wm_lifecycle_resize_grip_hit(10, 20, 300, 200, 280, 180)).to_equal(false)

    it "scrolls only the topmost web surface under the pointer":
        step("Verify: scrolls only the topmost web surface under the pointer")
        var wheel = mouse_at(40, 50)
        wheel.wheel = 1
        var c = compositor_with_mice([wheel])
        val lower = c.create_window("lower", 10, 10, 150, 120)
        c.update_window_content(lower.to_u64(), "<p>lower</p>")
        val upper = c.create_window("upper", 20, 20, 150, 120)
        c.update_window_content(upper.to_u64(), "<p>upper</p>")
        drive(c, 2)
        expect(c.surfaces[0].id).to_equal(lower)
        expect(c.surfaces[0].scroll_y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(c.surfaces[1].id).to_equal(upper)
        expect(c.surfaces[1].scroll_y).to_equal(40)  # oracle: 40 — named expected value from the requirement

    it "bounds accumulated wheel scroll before it reaches layout rendering":
        step("Verify: bounds accumulated wheel scroll before it reaches layout rendering")
        var wheel = mouse_at(40, 50)
        wheel.wheel = 1000
        var c = compositor_with_mice([
            wheel, wheel, wheel, wheel, wheel, wheel, wheel
        ])
        val window_id = c.create_window("bounded", 10, 10, 150, 120)
        c.update_window_content(window_id.to_u64(), "<p>bounded</p>")
        drive(c, 8)
        expect(c.surfaces[0].scroll_y).to_equal(4000)  # oracle: 4000 — named expected value from the requirement

    it "leaves focus alone for a left press on empty desktop":
        step("Verify: leaves focus alone for a left press on empty desktop")
        var miss = mouse_at(190, 5)
        miss.left_pressed = true
        miss.left_just_pressed = true
        var c = compositor_with_mice([miss])
        val w1 = c.create_window("one", 10, 10, 40, 40)
        val w2 = c.create_window("two", 100, 60, 40, 40)
        drive(c, 2)
        expect(focused_id(c)).to_equal(w2)

    it "raises pending_meta_key when alt is held during a key event":
        step("Verify: raises pending_meta_key when alt is held during a key event")
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.A)], "a", false, false, true
        )
        expect(c.pending_meta_key).to_equal(0)  # oracle: 0 — named expected value from the requirement
        drive(c, 2)
        expect(c.pending_meta_key).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "captures a ctrl+alt chord into pending_shortcut":
        step("Verify: captures a ctrl+alt chord into pending_shortcut")
        # NOT a pure equivalence case: this was RED on the legacy path. The old
        # body matched `if val Press(pressed_key) = key_event` against an
        # `KeyEvent?` OPTIONAL without unwrapping it first, so the Press arm
        # never ran and no chord was ever captured from a backend. The unified
        # path unwraps the optional in `input_backend_poll_event` before
        # matching, which fixes it. Recorded here so the change in verdict is a
        # documented fix, not an unnoticed drift.
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.T)], "t", false, true, true
        )
        expect(c.pending_shortcut).to_equal("")
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("t")

    it "does not capture a shortcut for a plain key press":
        step("Verify: does not capture a shortcut for a plain key press")
        var c = compositor_with_keys(
            [KeyEvent.Press(Key.T)], "t", false, false, false
        )
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("")
        expect(c.pending_meta_key).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "ignores a key release for shortcut purposes":
        step("Verify: ignores a key release for shortcut purposes")
        var c = compositor_with_keys(
            [KeyEvent.Release(Key.T)], "t", false, true, true
        )
        drive(c, 2)
        expect(c.pending_shortcut).to_equal("")
        # ...but alt-held still raises the meta flag, as it always did.
        expect(c.pending_meta_key).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "applies exactly one event per frame so no pending WM step is lost":
        step("Verify: applies exactly one event per frame so no pending WM step is lost")
        # This is the property that makes the queue safe, and it is the one the
        # first draft of the migration got WRONG. `note_pending_wm_pointer_step`
        # writes a SINGLE slot, and the shell loop reads one step per frame
        # (`handle_input()` then `handle_pending_wm_pointer_step()`,
        # shell.spl:941-942). A batch that applied a whole drained burst in one
        # call would overwrite every step but the last: a press followed by a
        # move would leave button=0/kind=3 and the click would never reach the
        # WM. So a press must still be readable after ONE frame.
        var press = mouse_at(30, 30)
        press.left_pressed = true
        press.left_just_pressed = true
        var c = compositor_with_mice([press])
        drive(c, 1)
        expect(c.pending_wm_pointer_button_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.pending_wm_pointer_kind_code).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.cursor.x).to_equal(30)  # oracle: 30 — named expected value from the requirement

    # NOTE — a multi-frame drag is deliberately NOT asserted at this level.
    # A backend assigned into the compositor's `input: InputBackend?` field is
    # not aliased to the spec's handle, and a `me` poll that advances an index
    # does not persist across frames through it, so a scripted multi-event
    # backend replays its FIRST event forever. That is a harness property, not
    # a product one: it reproduces IDENTICALLY on the legacy compositor
    # (both sides fail such an example with "expected 1 to equal 2"), so it can
    # neither pass nor discriminate here. The drag sequence is covered where it
    # is actually decided instead -- the adapter mapping in
    # test/01_unit/os/drivers/input/host_input_adapt_spec.spl and the FIFO
    # ordering in input_event_queue_spec.spl.
