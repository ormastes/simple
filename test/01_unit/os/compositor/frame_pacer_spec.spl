"""
## Purpose and audience
Purpose: Prove that FramePacer.contract.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

"""
# Frame Pacer Contract Specification

**Feature IDs:** #OS-COMPOSITOR
**Category:** Infrastructure
**Difficulty:** 1/5

## Overview

Tests `FramePacer.contract()`, which returns the pacing snapshot as a
struct (target_fps, frame_budget_ms, frame_count, warm_startup_ms,
warm_startup_available) instead of only printing it. `report_contract()`
is a thin wrapper that prints the same values — the struct is now the
source of truth so gate scripts/specs can assert on values directly.
"""

use std.spec.{describe, it, expect, assert_false}
use os.compositor.frame_pacer.{FramePacer}

use std.spec.step

describe "FramePacer.contract":
    it "reports target_fps and frame_budget_ms for a fresh 60hz pacer":
        step("Verify: reports target_fps and frame_budget_ms for a fresh 60hz pacer")
        # @req: REQ-OS-COMPOSITOR-001
        val pacer = FramePacer.for_60hz()
        val c = pacer.contract()
        expect(c.target_fps).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(c.frame_budget_ms).to_equal(16)  # oracle: 16 — named expected value from the requirement

    it "reports frame_budget_ms for 30hz":
        step("Verify: reports frame_budget_ms for 30hz")
        val pacer = FramePacer.for_30hz()
        val c = pacer.contract()
        expect(c.target_fps).to_equal(30)  # oracle: 30 — named expected value from the requirement
        expect(c.frame_budget_ms).to_equal(33)  # oracle: 33 — named expected value from the requirement

    it "reports zero frame_count and unavailable warm_startup before any frame":
        step("Verify: reports zero frame_count and unavailable warm_startup before any frame")
        val pacer = FramePacer.for_60hz()
        val c = pacer.contract()
        expect(c.frame_count).to_equal(0)  # oracle: 0 — named expected value from the requirement
        assert_false(c.warm_startup_available)

    it "reports frame_count and available warm_startup after a frame completes":
        step("Verify: reports frame_count and available warm_startup after a frame completes")
        var pacer = FramePacer.for_60hz()
        pacer.mark_frame_start()
        pacer.mark_frame_end()
        val c = pacer.contract()
        expect(c.frame_count).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.warm_startup_available).to_equal(true)

    it "accumulates frame_count across repeated frames":
        step("Verify: accumulates frame_count across repeated frames")
        var pacer = FramePacer.for_60hz()
        pacer.mark_frame_start()
        pacer.mark_frame_end()
        pacer.mark_frame_start()
        pacer.mark_frame_end()
        pacer.mark_frame_start()
        pacer.mark_frame_end()
        val c = pacer.contract()
        expect(c.frame_count).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "custom fps target derives frame_budget_ms as 1000/fps":
        step("Verify: custom fps target derives frame_budget_ms as 1000/fps")
        val pacer = FramePacer.for_fps(25)
        val c = pacer.contract()
        expect(c.target_fps).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(c.frame_budget_ms).to_equal(40)  # oracle: 40 — named expected value from the requirement
