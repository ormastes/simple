"""
## Purpose and audience
Purpose: Prove that SimpleOS compositor content ownership.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

use std.spec
use common.ui.builder.{
    build_tree,
    column,
    label,
    button,
    text_field,
    with_height,
}
use os.compositor.compositor.{
    Compositor,
    WM_CONTENT_KIND_GUI_SESSION,
    WM_CONTENT_KIND_PIXEL_SURFACE,
    WM_CONTENT_KIND_WEB_DOCUMENT,
}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use os.compositor.display_backend.{CompositorBackend}
use os.compositor.input_backend.{InputBackend, host_event_from_polled}
use common.ui.host_input_event.{HostInputEvent}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.drivers.input.ps2_mouse.{MouseEvent}

class SingleAInput:
    delivered: bool

impl InputBackend for SingleAInput:

    me poll_event() -> HostInputEvent?:
        """The ONE trait-level ingress. Composes the inherent poll_key/poll_mouse
        pair through the shared helper, exactly as the real backends do."""
        val key_opt: KeyEvent? = self.poll_key()
        var ch = ""
        if val key_event = key_opt:
            if val Press(pressed_key) = key_event:
                if val Some(c) = self.key_to_char(pressed_key):
                    ch = c
            return host_event_from_polled(
                key_opt, nil, ch,
                self.shift_held(), self.ctrl_held(), self.alt_held()
            )
        val mouse_opt: MouseEvent? = self.poll_mouse()
        host_event_from_polled(
            nil, mouse_opt, "",
            self.shift_held(), self.ctrl_held(), self.alt_held()
        )
    me poll_key() -> KeyEvent?:
        if self.delivered:
            return nil
        self.delivered = true
        KeyEvent.Press(Key.A)

    me poll_mouse() -> MouseEvent?:
        nil

    fn alt_held() -> bool:
        false

    fn shift_held() -> bool:
        false

    fn ctrl_held() -> bool:
        false

    fn key_to_char(key: Key) -> text?:
        Some("a")

fn compositor_for_content_test() -> Compositor:
    val backend: CompositorBackend = HeadlessHostCompositorBackend.new(80, 60)
    Compositor.with_backends(backend, nil, 80, 60)

describe "SimpleOS compositor content ownership":
    it "uses scalar GUI handles and releases them on close":
        step("Verify: uses scalar GUI handles and releases them on close")
        # @req: REQ-OS-COMPOSITOR-001
        var compositor = compositor_for_content_test()
        val baseline = compositor.gui_content_count()
        val tree = build_tree(column("root", [label("label", "GUI")]))
        val window = compositor.create_window_with_tree(
            "GUI", 1, 1, 40, 40, tree
        )
        val surface = compositor.get_surface(window.value)
        expect(surface != nil).to_equal(true)
        if surface != nil:
            expect(surface.content_kind).to_equal(WM_CONTENT_KIND_GUI_SESSION)
            expect(surface.content_handle > 0).to_equal(true)
        expect(compositor.gui_content_count()).to_equal(baseline + 1)

        compositor.destroy_window(window.value.to_i32())
        expect(compositor.gui_content_count()).to_equal(baseline)

    it "switches a surface to explicit web ownership":
        step("Verify: switches a surface to explicit web ownership")
        var compositor = compositor_for_content_test()
        val tree = build_tree(column("root-web", [label("label-web", "GUI")]))
        val window = compositor.create_window_with_tree(
            "Web", 1, 1, 40, 40, tree
        )
        compositor.update_window_content(window.value, "<p>Web</p>")
        val surface = compositor.get_surface(window.value)
        if surface != nil:
            expect(surface.content_kind).to_equal(WM_CONTENT_KIND_WEB_DOCUMENT)
            expect(surface.content_handle).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(compositor.gui_content_count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "owns flat pixel content and releases it with the window":
        step("Verify: owns flat pixel content and releases it with the window")
        var compositor = compositor_for_content_test()
        val baseline = compositor.pixel_content_count()
        val window = compositor.create_window("Pixels", 1, 1, 40, 40)
        val handle = compositor.create_pixel_content(
            32, 4, 0xff102030u32
        )
        expect(handle > 0).to_equal(true)
        expect(compositor.attach_window_pixel_content(
            window.to_u64(), handle
        )).to_equal(true)
        var before: i64 = 0
        val initial = compositor.get_surface(window.to_u64())
        if initial != nil:
            before = initial.content_revision
        expect(compositor.set_pixel_content(
            handle, 5, 0xffffa000u32
        )).to_equal(true)
        val surface = compositor.get_surface(window.to_u64())
        if surface != nil:
            expect(surface.content_kind).to_equal(
                WM_CONTENT_KIND_PIXEL_SURFACE
            )
            expect(surface.content_revision).to_equal(before + 1)
        expect(compositor.pixel_content_color(handle, 5)).to_equal(
            0xffffa000u32
        )
        compositor.destroy_window(window)
        expect(compositor.pixel_content_count()).to_equal(baseline)

    it "retains GUI action state across local pointer events and revisions":
        step("Verify: retains GUI action state across local pointer events and revisions")
        var compositor = compositor_for_content_test()
        val tree = build_tree(column("root-action", [
            with_height(button("run-action", "Run", "demo.run"), 20)
        ]))
        val window = compositor.create_window_with_tree(
            "Action", 1, 1, 40, 40, tree
        )
        val before = compositor.get_surface(window.value).content_revision

        expect(compositor.dispatch_gui_pointer_event(
            window.value.to_i32(), 8, 34, "left", "down"
        )).to_be(true)
        expect(compositor.gui_pointer_capture_window_id).to_equal(
            window.value.to_i32()
        )
        expect(compositor.take_gui_content_action(
            window.value.to_i32()
        )).to_equal("demo.run")
        expect(compositor.take_gui_content_action(
            window.value.to_i32()
        )).to_equal("")
        expect(compositor.get_surface(
            window.value
        ).content_revision).to_equal(before + 1)
        expect(compositor.dispatch_gui_pointer_event(
            0, 79, 59, "left", "up"
        )).to_be(true)
        expect(compositor.gui_pointer_capture_window_id).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "routes physical keys separately from committed text":
        step("Verify: routes physical keys separately from committed text")
        var compositor = compositor_for_content_test()
        val tree = build_tree(column("root-input", [
            with_height(text_field("name", "", "Name"), 20)
        ]))
        val window = compositor.create_window_with_tree(
            "Input", 1, 1, 40, 40, tree
        )
        expect(compositor.dispatch_gui_pointer_event(
            window.value.to_i32(), 8, 34, "left", "down"
        )).to_be(true)
        expect(compositor.dispatch_gui_pointer_event(
            window.value.to_i32(), 8, 34, "left", "up"
        )).to_be(true)
        expect(compositor.dispatch_gui_text_event(
            window.value.to_i32(), "Simple123"
        )).to_be(true)
        expect(compositor.dispatch_gui_key_event(
            window.value.to_i32(), "a", true, false, false, false
        )).to_be(true)
        expect(compositor.dispatch_gui_key_event(
            window.value.to_i32(), "c", true, false, false, false
        )).to_be(true)
        expect(compositor.desktop_clipboard_text).to_equal("Simple123")
        expect(compositor.dispatch_gui_key_event(
            window.value.to_i32(), "x", true, false, false, false
        )).to_be(true)
        expect(compositor.dispatch_gui_key_event(
            window.value.to_i32(), "v", true, false, false, false
        )).to_be(true)
        val surface = compositor.get_surface(window.value)
        expect(surface != nil).to_equal(true)
        if surface != nil:
            val stored = compositor.gui_content_tree(surface.content_handle)
            expect(stored != nil).to_equal(true)
            if stored != nil:
                expect(stored.find_widget("name").get_prop("value")).to_equal(
                    "Simple123"
                )

    it "routes printable backend input to the focused GUI":
        step("Verify: routes printable backend input to the focused GUI")
        val backend: CompositorBackend = HeadlessHostCompositorBackend.new(
            80, 60
        )
        val input = SingleAInput(delivered: false)
        var compositor = Compositor.with_backends(
            backend, input, 80, 60
        )
        val tree = build_tree(column("root-backend-input", [
            with_height(text_field("backend-name", "", "Name"), 20)
        ]))
        val window = compositor.create_window_with_tree(
            "Input", 1, 1, 40, 40, tree
        )
        compositor.dispatch_gui_pointer_event(
            window.value.to_i32(), 8, 34, "left", "down"
        )
        compositor.dispatch_gui_pointer_event(
            window.value.to_i32(), 8, 34, "left", "up"
        )
        compositor.handle_input()
        expect(compositor.pending_shortcut).to_equal("")
        val surface = compositor.get_surface(window.value)
        expect(surface != nil).to_equal(true)
        if surface != nil:
            val stored = compositor.gui_content_tree(surface.content_handle)
            expect(stored != nil).to_equal(true)
            if stored != nil:
                expect(stored.find_widget(
                    "backend-name"
                ).get_prop("value")).to_equal("a")
