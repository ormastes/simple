# codex-system-test
use std.spec
use common.ui.draw_ir.{
    DRAW_IR_BACKEND_CPU, draw_ir_batch, draw_ir_composition,
    draw_ir_embedding_config, draw_ir_rect
}
use os.compositor.engine2d_wm_frame_executor.{
    engine2d_wm_draw_ir_backend_target,
    engine2d_wm_draw_ir_local_recompose_required,
    engine2d_wm_composition_unchanged
}

fn _wm_frame(revision: text, colour: u32):
    val embedding = draw_ir_embedding_config(
        "surface", "root", 0, 0, 100, 80, 0, 1000, false)
    draw_ir_composition(revision, "scene", DRAW_IR_BACKEND_CPU, [
        draw_ir_batch("first", DRAW_IR_BACKEND_CPU, embedding,
            [draw_ir_rect("first-box", 10, 10, 20, 15, 1u32)]),
        draw_ir_batch("second", DRAW_IR_BACKEND_CPU, embedding,
            [draw_ir_rect("second-box", 40, 10, 20, 15, colour)])
    ])

describe "Engine2D WM frame executor DrawIR target":
    it "should select scalar CPU when no host GPU or SIMD path is active":
        expect(engine2d_wm_draw_ir_backend_target(false, "", false)).to_equal("cpu")

    it "should select CPU SIMD when the bare-metal SIMD capability is enabled":
        expect(engine2d_wm_draw_ir_backend_target(false, "", true)).to_equal("cpu_simd")

    it "should retain the negotiated Vulkan or Metal host backend":
        expect(engine2d_wm_draw_ir_backend_target(true, "vulkan", false)).to_equal("vulkan")
        expect(engine2d_wm_draw_ir_backend_target(true, "metal", true)).to_equal("metal")

    it "should fall back when the host backend is inactive or empty":
        expect(engine2d_wm_draw_ir_backend_target(false, "vulkan", true)).to_equal("cpu_simd")
        expect(engine2d_wm_draw_ir_backend_target(true, "", false)).to_equal("cpu")

    it "should recompose only when the attempted host material target differs from local fallback":
        expect(engine2d_wm_draw_ir_local_recompose_required("cpu", "cpu")).to_equal(false)
        expect(engine2d_wm_draw_ir_local_recompose_required("cpu_simd", "cpu_simd")).to_equal(false)
        expect(engine2d_wm_draw_ir_local_recompose_required("metal", "cpu")).to_equal(true)
        expect(engine2d_wm_draw_ir_local_recompose_required("vulkan", "cpu_simd")).to_equal(true)

    it "should switch unchanged multi-batch frames without scanning image pixels":
        expect(engine2d_wm_composition_unchanged(
            _wm_frame("old", 1u32), _wm_frame("new", 1u32),
            [11u64, 22u64], [11u64, 22u64])).to_equal(true)
        expect(engine2d_wm_composition_unchanged(
            _wm_frame("old", 1u32), _wm_frame("new", 2u32),
            [11u64, 22u64], [11u64, 22u64])).to_equal(false)
        expect(engine2d_wm_composition_unchanged(
            _wm_frame("old", 1u32), _wm_frame("new", 1u32),
            [11u64, 22u64], [11u64, 23u64])).to_equal(false)
