# @cover src/lib/common/ui/window_scene.spl
# @cover src/os/compositor/host_compositor_core.spl
use std.spec.*
use common.window_protocol.geometry.{Size}
use common.ui.window_scene.{
    WM_CONTENT_DAMAGE_FULL,
    WM_CONTENT_DAMAGE_LOCAL,
    WM_CONTENT_DAMAGE_NONE,
    WM_CONTENT_ORIGIN_PIXEL_SURFACE,
    WmContentFrame,
    wm_content_frame_checksum,
    wm_content_frame_damage_plan_valid
}
use common.ui.window_scene_draw_ir.{WM_BROWSER_TOOLBAR_HEIGHT}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.simple_web_window_renderer.{
    simple_web_content_full_html_with_theme,
    simple_web_external_content_frame
}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result
}

fn _damage_pixels(width: i32, height: i32, color: u32) -> [u32]:
    [color; width * height]

fn _damage_frame(
    window_id: i64,
    width: i32,
    height: i32,
    pixels: [u32],
    content_revision: i64,
    producer_revision: i64,
    damage_mode: i64,
    damage_rects: [i64],
    resources_accepted: bool
) -> WmContentFrame:
    WmContentFrame(
        window_id: "{window_id}",
        scene_revision: content_revision,
        content_revision: content_revision,
        origin_kind: WM_CONTENT_ORIGIN_PIXEL_SURFACE,
        width: width,
        height: height,
        pixels: pixels,
        checksum: wm_content_frame_checksum(pixels),
        parent_window_id: "",
        offset_x: 0,
        offset_y: 0,
        producer_revision: producer_revision,
        damage_mode: damage_mode,
        damage_rects: damage_rects,
        damage_resources_accepted: resources_accepted
    )

fn _browser_damage_compositor() -> HostCompositor:
    var comp = HostCompositor.new_headless(Size.wh(320, 240))
    comp.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Damage Browser",
        20, 10, 180, 150, "", 99, "browser"
    )
    val window_id = comp.windows[0].id
    comp.require_external_content_frame(window_id)
    val width = comp.windows[0].w - 8
    val height = comp.windows[0].h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
    val pixels = _damage_pixels(width, height, 0xFF112233u32)
    comp.set_external_content_frame(
        window_id,
        _damage_frame(
            window_id, width, height, pixels, 1, 10,
            WM_CONTENT_DAMAGE_FULL,
            [0, 0, width as i64, height as i64], false
        )
    )
    comp.dirty.clear()
    comp

describe "external content damage boundary":
    it "accepts only canonical NONE LOCAL and FULL child plans":
        val pixels = _damage_pixels(8, 6, 0xFF010203u32)
        val full = _damage_frame(
            1, 8, 6, pixels, 1, -1,
            WM_CONTENT_DAMAGE_FULL, [0, 0, 8, 6], false)
        val local = _damage_frame(
            1, 8, 6, pixels, 2, 7,
            WM_CONTENT_DAMAGE_LOCAL, [1, 2, 3, 4], true)
        val none = _damage_frame(
            1, 8, 6, pixels, 3, 7,
            WM_CONTENT_DAMAGE_NONE, [], true)
        val unaccepted = _damage_frame(
            1, 8, 6, pixels, 4, 8,
            WM_CONTENT_DAMAGE_LOCAL, [1, 2, 3, 4], false)
        val outside = _damage_frame(
            1, 8, 6, pixels, 5, 8,
            WM_CONTENT_DAMAGE_LOCAL, [7, 0, 2, 1], true)
        val overlapping = _damage_frame(
            1, 8, 6, pixels, 6, 9,
            WM_CONTENT_DAMAGE_LOCAL, [1, 1, 4, 3, 4, 2, 3, 3], true)

        expect(wm_content_frame_damage_plan_valid(full)).to_be(true)
        expect(wm_content_frame_damage_plan_valid(local)).to_be(true)
        expect(wm_content_frame_damage_plan_valid(none)).to_be(true)
        expect(wm_content_frame_damage_plan_valid(unaccepted)).to_be(false)
        expect(wm_content_frame_damage_plan_valid(outside)).to_be(false)
        expect(wm_content_frame_damage_plan_valid(overlapping)).to_be(false)

    it "translates accepted LOCAL child rectangles to browser content coordinates":
        var comp = _browser_damage_compositor()
        val window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        val pixels = _damage_pixels(width, height, 0xFF334455u32)

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 2, 11,
                WM_CONTENT_DAMAGE_LOCAL, [3, 5, 7, 9], true
            )
        )).to_be(true)

        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].x).to_equal(window.x + 4 + 3)
        expect(comp.dirty.rects[0].y).to_equal(
            window.y + 32 + WM_BROWSER_TOOLBAR_HEIGHT + 5)
        expect(comp.dirty.rects[0].w).to_equal(7)
        expect(comp.dirty.rects[0].h).to_equal(9)

    it "fails skipped revisions and unaccepted resources closed to full parent damage":
        var comp = _browser_damage_compositor()
        val window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        val pixels = _damage_pixels(width, height, 0xFF556677u32)

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 2, 12,
                WM_CONTENT_DAMAGE_LOCAL, [1, 1, 2, 2], true
            )
        )).to_be(true)
        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].x).to_equal(0)
        expect(comp.dirty.rects[0].y).to_equal(0)
        expect(comp.dirty.rects[0].w).to_equal(comp.width)
        expect(comp.dirty.rects[0].h).to_equal(comp.height)

    it "fails overlapping LOCAL rectangles closed to one full parent damage":
        var comp = _browser_damage_compositor()
        val window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        val pixels = _damage_pixels(width, height, 0xFF667788u32)

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 2, 11,
                WM_CONTENT_DAMAGE_LOCAL, [1, 1, 6, 4, 5, 2, 6, 4], true
            )
        )).to_be(true)
        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].x).to_equal(0)
        expect(comp.dirty.rects[0].y).to_equal(0)
        expect(comp.dirty.rects[0].w).to_equal(comp.width)
        expect(comp.dirty.rects[0].h).to_equal(comp.height)

    it "clips parent translation in i64 before narrowing extreme coordinates":
        var comp = _browser_damage_compositor()
        var window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        val pixels = _damage_pixels(width, height, 0xFF778899u32)
        window.x = 2147483647
        window.y = 2147483647
        comp.windows[0] = window

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 2, 11,
                WM_CONTENT_DAMAGE_LOCAL, [0, 0, width as i64, height as i64],
                true
            )
        )).to_be(true)
        expect(comp.has_pending_damage()).to_be(false)

        window.x = -5
        window.y = -32 - WM_BROWSER_TOOLBAR_HEIGHT
        comp.windows[0] = window
        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 3, 12,
                WM_CONTENT_DAMAGE_LOCAL, [0, 0, 8, 8], true
            )
        )).to_be(true)
        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].x).to_equal(0)
        expect(comp.dirty.rects[0].y).to_equal(0)
        expect(comp.dirty.rects[0].w).to_equal(7)
        expect(comp.dirty.rects[0].h).to_equal(8)

        comp.dirty.clear()
        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 3, 13,
                WM_CONTENT_DAMAGE_LOCAL, [1, 1, 2, 2], false
            )
        )).to_be(true)
        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].w).to_equal(comp.width)
        expect(comp.dirty.rects[0].h).to_equal(comp.height)

        comp.dirty.clear()
        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 4, 14,
                WM_CONTENT_DAMAGE_LOCAL,
                [width as i64 - 1, 0, 2, 1], true
            )
        )).to_be(true)
        expect(comp.dirty.rects.len()).to_equal(1)
        expect(comp.dirty.rects[0].x).to_equal(0)
        expect(comp.dirty.rects[0].y).to_equal(0)
        expect(comp.dirty.rects[0].w).to_equal(comp.width)
        expect(comp.dirty.rects[0].h).to_equal(comp.height)

    it "keeps exact retained NONE frames clean":
        var comp = _browser_damage_compositor()
        val window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        val pixels = _damage_pixels(width, height, 0xFF112233u32)

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 2, 10,
                WM_CONTENT_DAMAGE_NONE, [], true
            )
        )).to_be(true)
        expect(comp.dirty.is_empty()).to_be(true)
        expect(comp.has_pending_damage()).to_be(false)

        expect(comp.set_external_content_frame(
            window.id,
            _damage_frame(
                window.id, width, height, pixels, 3, 11,
                WM_CONTENT_DAMAGE_NONE, [], true
            )
        )).to_be(true)
        expect(comp.dirty.is_empty()).to_be(true)
        expect(comp.has_pending_damage()).to_be(false)

    it "preserves effective Web metadata through raster frame and WM admission":
        var comp = HostCompositor.new_headless(Size.wh(320, 240))
        comp.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Boundary Web",
            20, 10, 72, 128, "", 99, "browser"
        )
        val window = comp.windows[0]
        val width = window.w - 8
        val height = window.h - 36 - WM_BROWSER_TOOLBAR_HEIGHT
        comp.require_external_content_frame(window.id)
        var raster = Engine2dCompositorBackend.create_named(
            width, height, "software")
        val initial_layout = simple_web_layout_render_html_draw_ir_result(
            simple_web_content_full_html_with_theme(
                "glass_dark", "Boundary", "<p>first</p>", width, height),
            width, height)
        val initial_render = raster.render_web_draw_ir_composition_resources_revision(
            initial_layout.composition, [], 5, 1)
        val initial_frame = simple_web_external_content_frame(
            "{window.id}", 1, "glass_dark", width, height, initial_render,
            initial_layout.material_witness.cpu_composited_count,
            initial_layout.material_witness.cpu_composited_sha256,
            initial_layout.material_witness.solid_material_count,
            initial_layout.material_witness.solid_material_sha256,
            1, WM_CONTENT_DAMAGE_FULL,
            [0, 0, width as i64, height as i64], false)
        expect(comp.set_external_content_frame(window.id, initial_frame)).to_be(true)
        comp.dirty.clear()

        val changed_layout = simple_web_layout_render_html_draw_ir_result(
            simple_web_content_full_html_with_theme(
                "glass_dark", "Boundary", "<p>second</p>", width, height),
            width, height)
        val changed_render = raster.render_web_draw_ir_composition_resources_revision(
            changed_layout.composition, [], 5, 2)
        val changed_frame = simple_web_external_content_frame(
            "{window.id}", 2, "glass_dark", width, height, changed_render,
            changed_layout.material_witness.cpu_composited_count,
            changed_layout.material_witness.cpu_composited_sha256,
            changed_layout.material_witness.solid_material_count,
            changed_layout.material_witness.solid_material_sha256,
            2, raster.web_effective_damage_mode,
            if raster.web_effective_damage_mode == WM_CONTENT_DAMAGE_NONE:
                []
            else:
                raster.damage_rects_to_i64(),
            raster.web_effective_damage_valid)
        expect(changed_frame.damage_mode).to_equal(
            raster.web_effective_damage_mode)
        expect(changed_frame.damage_rects).to_equal(
            raster.damage_rects_to_i64())
        expect(comp.set_external_content_frame(window.id, changed_frame)).to_be(true)
        expect(comp.has_pending_damage()).to_be(true)
        comp.dirty.clear()

        val retained_render = raster.render_web_draw_ir_composition_resources_revision(
            changed_layout.composition, [], 5, 2)
        expect(raster.web_effective_damage_mode).to_equal(
            WM_CONTENT_DAMAGE_NONE)
        expect(raster.damage_rects_to_i64()).to_equal([])
        val retained_frame = simple_web_external_content_frame(
            "{window.id}", 3, "glass_dark", width, height, retained_render,
            changed_layout.material_witness.cpu_composited_count,
            changed_layout.material_witness.cpu_composited_sha256,
            changed_layout.material_witness.solid_material_count,
            changed_layout.material_witness.solid_material_sha256,
            2, raster.web_effective_damage_mode, [], true)
        expect(retained_frame.producer_revision).to_equal(2)
        expect(retained_frame.damage_mode).to_equal(WM_CONTENT_DAMAGE_NONE)
        expect(retained_frame.damage_rects).to_equal([])
        expect(retained_frame.damage_resources_accepted).to_be(true)
        expect(comp.set_external_content_frame(window.id, retained_frame)).to_be(true)
        expect(comp.has_pending_damage()).to_be(false)
        raster.shutdown()
