use std.spec.*
use std.common.string_core.{char_from_code}
use std.nogc_async_mut_noalloc.baremetal.common.backend_render_receipt.{
    backend_render_receipt_header_wire_byte_at,
    backend_render_receipt_header_wire_byte_count,
    backend_render_receipt_event_wire_byte_at,
    backend_render_receipt_event_wire_byte_count,
    backend_render_receipt_trailer_wire_byte_at,
    backend_render_receipt_trailer_wire_byte_count
}
use common.renderdoc.backend_render_receipt_wire.{parse_backend_render_receipt_wire}
use os.compositor.baremetal_wm_present_owner.{
    WM_PRESENT_ARCH_X86_64,
    BaremetalWmPresentOwnerV1,
    BaremetalWmScanoutIdentityV1
}
use os.compositor.engine2d_render_evidence.{
    SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
    SimpleOsBuildIdentityV1
}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use os.compositor.backend_render_receipt_producer.{
    produce_backend_render_receipt_after_present_v1,
    produce_backend_render_receipt_from_scanout_v1,
    simpleos_build_identity_from_admission_v1,
    simpleos_boot_identity_from_admission_v1
}
use os.kernel.arch.x86.render_capture_ack.{
    RenderCaptureAckV1,
    render_capture_control_wire_byte_at,
    render_capture_control_wire_byte_count
}

fn scanout() -> BaremetalWmScanoutIdentityV1:
    BaremetalWmScanoutIdentityV1(
        architecture: WM_PRESENT_ARCH_X86_64,
        scanout_id: 29u64,
        width: 2u32,
        height: 1u32,
        stride: 8u32,
        bpp: 32u32)

fn valid_emission():
    var owner = BaremetalWmPresentOwnerV1.create(scanout())
    val presented = owner.commit_present(scanout(), 3u64, 7u64, 1u64, true)
    produce_backend_render_receipt_after_present_v1(
        WM_PRESENT_ARCH_X86_64,
        SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
        SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
        11u64,
        scanout(),
        presented,
        [0xff112233u32, 0xff445566u32])

fn receipt_wire() -> text:
    val emission = valid_emission()
    val receipt = emission.receipt!
    var wire = ""
    var i = 0
    while i < backend_render_receipt_header_wire_byte_count():
        wire = wire + char_from_code(backend_render_receipt_header_wire_byte_at(receipt.header, i).to_i64())
        i = i + 1
    i = 0
    while i < backend_render_receipt_event_wire_byte_count():
        wire = wire + char_from_code(backend_render_receipt_event_wire_byte_at(receipt.event, i).to_i64())
        i = i + 1
    i = 0
    while i < backend_render_receipt_trailer_wire_byte_count():
        wire = wire + char_from_code(backend_render_receipt_trailer_wire_byte_at(receipt.trailer, i).to_i64())
        i = i + 1
    wire

describe "SimpleOS backend render receipt producer":
    it "streams the production framebuffer while preserving scanout identity":
        var owner = BaremetalWmPresentOwnerV1.create(scanout())
        val presented = owner.commit_present(scanout(), 3u64, 7u64, 1u64, true)
        var framebuffer = FramebufferDriver.from_buffer(2u32, 1u32)
        val host_pixels = framebuffer.host_pixels()
        host_pixels[0] = 0xff112233u32
        host_pixels[1] = 0xff445566u32
        val emission = produce_backend_render_receipt_from_scanout_v1(
            WM_PRESENT_ARCH_X86_64,
            SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
            11u64,
            scanout(),
            presented,
            0u64,
            framebuffer)
        expect(emission.accepted).to_be(true)
        expect(emission.receipt!.header.surface_handle).to_equal(29u64)
        expect(emission.receipt!.header.stride).to_equal(8u32)
        expect(emission.receipt!.trailer.pixel_hash_word0).to_equal(
            valid_emission().receipt!.trailer.pixel_hash_word0)

    it "accepts only an exact admitted kernel SHA-256 identity":
        val identity = simpleos_build_identity_from_admission_v1(
            "schema=simpleos-wm-kernel-admission-v3\n" +
            "kernel_sha256=0000000000000001000000000000000200000000000000030000000000000004\n")
        expect(identity == nil).to_be(false)
        expect(identity!.word0).to_equal(1u64)
        expect(simpleos_build_identity_from_admission_v1("kernel_sha256=not-a-digest") == nil).to_be(true)

    it "rejects duplicate and prefixed admission digests":
        val schema = "schema=simpleos-wm-kernel-admission-v3\n"
        val digest = "kernel_sha256=0000000000000001000000000000000200000000000000030000000000000004\n"
        expect(simpleos_build_identity_from_admission_v1(schema + digest + digest) == nil).to_be(true)
        expect(simpleos_build_identity_from_admission_v1(schema + "wrong_" + digest) == nil).to_be(true)
        expect(simpleos_build_identity_from_admission_v1(digest) == nil).to_be(true)

    it "rejects a prior boot ACK even when clocks frame and scanout repeat":
        val admission = "schema=simpleos-wm-kernel-admission-v3\n" +
            "kernel_sha256=0000000000000001000000000000000200000000000000030000000000000004\n"
        val previous_boot = simpleos_boot_identity_from_admission_v1(
            admission + "capture_boot_nonce=1122334455667788\n")
        val current_boot = simpleos_boot_identity_from_admission_v1(
            admission + "capture_boot_nonce=1122334455667789\n")
        expect(previous_boot == nil).to_be(false)
        expect(current_boot == nil).to_be(false)
        # The API consumes no clock. Identical elapsed time cannot alias these
        # identities, even though both boots present frame 1 on scanout 29.
        expect(current_boot! == previous_boot!).to_be(false)
        var ack = RenderCaptureAckV1.create(current_boot!, 1u64)
        var index = 0
        while index < render_capture_control_wire_byte_count():
            ack.feed(render_capture_control_wire_byte_at(65u8, previous_boot!, 1u64, index))
            index = index + 1
        expect(ack.ack_accepted()).to_be(false)
        expect(ack.failed()).to_be(true)

    it "requires exactly one nonzero fixed-width launch nonce":
        val admission = "schema=simpleos-wm-kernel-admission-v3\n" +
            "kernel_sha256=0000000000000001000000000000000200000000000000030000000000000004\n"
        val nonce = "capture_boot_nonce=1122334455667788\n"
        expect(simpleos_boot_identity_from_admission_v1(admission) == nil).to_be(true)
        expect(simpleos_boot_identity_from_admission_v1(admission + nonce + nonce) == nil).to_be(true)
        expect(simpleos_boot_identity_from_admission_v1(admission + "capture_boot_nonce=0000000000000000\n") == nil).to_be(true)
        expect(simpleos_boot_identity_from_admission_v1(admission + "capture_boot_nonce=1122\n") == nil).to_be(true)
        expect(simpleos_boot_identity_from_admission_v1(admission + "capture_boot_nonce=112233445566778Z\n") == nil).to_be(true)

    it "rejects an admitted presentation reused for a different scanout":
        var owner = BaremetalWmPresentOwnerV1.create(scanout())
        val presented = owner.commit_present(scanout(), 3u64, 7u64, 1u64, true)
        val other = BaremetalWmScanoutIdentityV1(
            architecture: WM_PRESENT_ARCH_X86_64, scanout_id: 30u64,
            width: 2u32, height: 1u32, stride: 8u32, bpp: 32u32)
        val emission = produce_backend_render_receipt_from_scanout_v1(
            WM_PRESENT_ARCH_X86_64, SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
            11u64, other, presented, 0u64, FramebufferDriver.from_buffer(2u32, 1u32))
        expect(emission.accepted).to_be(false)
        expect(emission.reason).to_equal("presentation-scanout-mismatch")

    it "rejects a same-sized framebuffer at a different address before MMIO":
        var owner = BaremetalWmPresentOwnerV1.create(scanout())
        val presented = owner.commit_present(scanout(), 3u64, 7u64, 1u64, true)
        # Neither sentinel address is mapped. Rejection must precede read_pixel.
        val other = FramebufferDriver.from_scanout_raw(8192u64, 2u32, 1u32, 8u32, 32u32)
        val emission = produce_backend_render_receipt_from_scanout_v1(
            WM_PRESENT_ARCH_X86_64, SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
            11u64, scanout(), presented, 4096u64, other)
        expect(emission.accepted).to_be(false)
        expect(emission.reason).to_equal("scanout-framebuffer-mismatch")

    it "matches all digest words across a full scratch chunk and tail":
        val identity = BaremetalWmScanoutIdentityV1(
            architecture: WM_PRESENT_ARCH_X86_64, scanout_id: 31u64,
            width: 65u32, height: 1u32, stride: 260u32, bpp: 32u32)
        var owner = BaremetalWmPresentOwnerV1.create(identity)
        val presented = owner.commit_present(identity, 3u64, 7u64, 1u64, true)
        val firmware = SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64)
        var framebuffer = FramebufferDriver.from_buffer(65u32, 1u32)
        val pixels = framebuffer.host_pixels()
        var i = 0
        while i < 65:
            pixels[i] = 0xff000000u32 | (i + 1).to_u32()
            i = i + 1
        val streamed = produce_backend_render_receipt_from_scanout_v1(
            WM_PRESENT_ARCH_X86_64, SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            firmware, 11u64, identity, presented, 0u64, framebuffer)
        val reference = produce_backend_render_receipt_after_present_v1(
            WM_PRESENT_ARCH_X86_64, SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            firmware, 11u64, identity, presented, pixels)
        expect(streamed.accepted).to_be(true)
        expect(reference.accepted).to_be(true)
        expect(streamed.receipt!.trailer.pixel_hash_word0).to_equal(reference.receipt!.trailer.pixel_hash_word0)
        expect(streamed.receipt!.trailer.pixel_hash_word1).to_equal(reference.receipt!.trailer.pixel_hash_word1)
        expect(streamed.receipt!.trailer.pixel_hash_word2).to_equal(reference.receipt!.trailer.pixel_hash_word2)
        expect(streamed.receipt!.trailer.pixel_hash_word3).to_equal(reference.receipt!.trailer.pixel_hash_word3)

    it "rejects framebuffer metadata that does not match the admitted scanout":
        var owner = BaremetalWmPresentOwnerV1.create(scanout())
        val presented = owner.commit_present(scanout(), 3u64, 7u64, 1u64, true)
        val wrong_framebuffer = FramebufferDriver.from_buffer(3u32, 1u32)
        val emission = produce_backend_render_receipt_from_scanout_v1(
            WM_PRESENT_ARCH_X86_64,
            SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
            11u64,
            scanout(),
            presented,
            0u64,
            wrong_framebuffer)
        expect(emission.accepted).to_be(false)
        expect(emission.reason).to_equal("scanout-framebuffer-mismatch")

    it "binds admitted build boot frame scanout and committed pixels":
        val emission = valid_emission()
        expect(emission.accepted).to_be(true)
        expect(emission.boot_id).to_equal(11u64)
        expect(emission.frame_id).to_equal(7u64)
        val parsed = parse_backend_render_receipt_wire(receipt_wire())
        expect(parsed.valid).to_be(true)
        expect(parsed.header!.boot_id).to_equal(11u64)
        expect(parsed.header!.frame_id).to_equal(7u64)
        expect(parsed.header!.surface_handle).to_equal(29u64)

    it "rejects a frame that the WM presentation owner did not admit":
        var owner = BaremetalWmPresentOwnerV1.create(scanout())
        val rejected = owner.commit_present(scanout(), 3u64, 7u64, 1u64, false)
        val emission = produce_backend_render_receipt_after_present_v1(
            WM_PRESENT_ARCH_X86_64,
            SIMPLEOS_RENDER_BACKEND_VIRTIO_GPU,
            SimpleOsBuildIdentityV1(word0: 1u64, word1: 2u64, word2: 3u64, word3: 4u64),
            11u64,
            scanout(),
            rejected,
            [0xff112233u32, 0xff445566u32])
        expect(emission.accepted).to_be(false)
        expect(emission.reason).to_equal("presentation-not-admitted")

    it "replays malformed reordered and truncated receipt streams fail closed":
        val valid = receipt_wire()
        val event_start = valid.index_of("BRR1 E")
        val trailer_start = valid.index_of("BRR1 T")
        val header = valid[0:event_start]
        val event = valid[event_start:trailer_start]
        val trailer = valid[trailer_start:valid.len()]
        expect(parse_backend_render_receipt_wire("BRR1 Z\n").code).to_equal("unknown-record-kind")
        expect(parse_backend_render_receipt_wire(event + header + trailer).code).to_equal("event-out-of-order")
        expect(parse_backend_render_receipt_wire(header + event).code).to_equal("truncated-receipt")

    it "acknowledges only the exact boot and frame announced for capture":
        var ack = RenderCaptureAckV1.create(11u64, 7u64)
        var i = 0
        while i < render_capture_control_wire_byte_count():
            ack.feed(render_capture_control_wire_byte_at(65u8, 11u64, 7u64, i))
            i = i + 1
        expect(ack.ack_accepted()).to_be(true)
        expect(ack.confirmation_wire_byte_at(5)).to_equal(75u8)

        var wrong_frame = RenderCaptureAckV1.create(11u64, 7u64)
        i = 0
        while i < render_capture_control_wire_byte_count():
            wrong_frame.feed(render_capture_control_wire_byte_at(65u8, 11u64, 8u64, i))
            i = i + 1
        expect(wrong_frame.ack_accepted()).to_be(false)
        expect(wrong_frame.failed()).to_be(true)

    it "keeps repeated producer calls stateless and identity stable":
        var iteration = 0
        var accepted = 0
        while iteration < 256:
            val emission = valid_emission()
            if emission.accepted and emission.boot_id == 11u64 and emission.frame_id == 7u64:
                accepted = accepted + 1
            iteration = iteration + 1
        expect(accepted).to_equal(256)
