use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_entry.{HostCompositor}

fn main() -> i64:
    var compositor = HostCompositor.new_headless(Size.wh(160, 120))
    if not compositor.pin_taskbar_app(
        "/sys/apps/wm-demo", "WM Demo", "demo"
    ):
        return 1
    if not compositor.taskbar_app_is_pinned("/sys/apps/wm-demo"):
        return 2
    val pinned = compositor.taskbar_model().pinned
    if pinned.len() != 1:
        return 3
    if pinned[0].app_id != "/sys/apps/wm-demo":
        return 4
    compositor.handle_mouse_move(22, 80)
    compositor.handle_left_button(true)
    compositor.handle_left_button(false)
    if compositor.take_pending_taskbar_launch_app_id() != "/sys/apps/wm-demo":
        return 5
    if compositor.take_pending_taskbar_launch_app_id() != "":
        return 6
    if not compositor.unpin_taskbar_app("/sys/apps/wm-demo"):
        return 7
    if compositor.taskbar_model().pinned.len() != 0:
        return 8
    0
