use std.spec
use os.compositor.baremetal_wm_present_owner.{
    WM_PRESENT_ARCH_X86_64,
    WM_PRESENT_ARCH_AARCH64,
    WM_PRESENT_ARCH_RISCV64,
    BaremetalWmScanoutIdentityV1,
    BaremetalWmPresentOwnerV1,
    baremetal_wm_scanout_identity_valid_v1
}

fn scanout(architecture: u32) -> BaremetalWmScanoutIdentityV1:
    BaremetalWmScanoutIdentityV1(
        architecture: architecture,
        scanout_id: 7u64,
        width: 800u32,
        height: 600u32,
        stride: 3200u32,
        bpp: 32u32
    )

describe "baremetal WM present owner":
    it "admits the three production architecture identities":
        expect(baremetal_wm_scanout_identity_valid_v1(scanout(WM_PRESENT_ARCH_X86_64))).to_be(true)
        expect(baremetal_wm_scanout_identity_valid_v1(scanout(WM_PRESENT_ARCH_AARCH64))).to_be(true)
        expect(baremetal_wm_scanout_identity_valid_v1(scanout(WM_PRESENT_ARCH_RISCV64))).to_be(true)

    it "rejects malformed scanout geometry without becoming configured":
        var malformed = scanout(WM_PRESENT_ARCH_X86_64)
        malformed.stride = 800u32
        val owner = BaremetalWmPresentOwnerV1.create(malformed)
        expect(owner.is_configured()).to_be(false)
        expect(owner.snapshot().reason).to_equal("invalid-scanout-identity")

    it "commits an exact successful platform receipt":
        val identity = scanout(WM_PRESENT_ARCH_AARCH64)
        var owner = BaremetalWmPresentOwnerV1.create(identity)
        val receipt = owner.commit_present(identity, 5, 1u64, 1u64, true)
        expect(receipt.accepted).to_be(true)
        expect(owner.snapshot().scene_revision).to_equal(5u64)
        expect(owner.accepted_present_count()).to_equal(1u64)

    it "does not advance state for a failed or mismatched present":
        val identity = scanout(WM_PRESENT_ARCH_RISCV64)
        var owner = BaremetalWmPresentOwnerV1.create(identity)
        expect(owner.commit_present(identity, 5, 1u64, 1u64, false).accepted).to_be(false)
        var wrong = identity
        wrong.scanout_id = 8u64
        expect(owner.commit_present(wrong, 5, 1u64, 1u64, true).accepted).to_be(false)
        expect(owner.accepted_present_count()).to_equal(0u64)
        expect(owner.snapshot().frame_id).to_equal(0u64)

    it "rejects frame and output replay while preserving the last commit":
        val identity = scanout(WM_PRESENT_ARCH_X86_64)
        var owner = BaremetalWmPresentOwnerV1.create(identity)
        expect(owner.commit_present(identity, 5, 1u64, 3u64, true).accepted).to_be(true)
        expect(owner.commit_present(identity, 6, 1u64, 4u64, true).reason).to_equal("stale-frame-id")
        # Equal output epoch is valid on x86; a strictly older epoch is stale.
        expect(owner.commit_present(identity, 6, 2u64, 3u64, true).accepted).to_be(true)
        expect(owner.commit_present(identity, 7, 3u64, 2u64, true).reason).to_equal("stale-output-generation")
        expect(owner.snapshot().scene_revision).to_equal(6u64)
        expect(owner.accepted_present_count()).to_equal(2u64)

    it "rejects a scene rollback before mutating canonical state":
        val identity = scanout(WM_PRESENT_ARCH_RISCV64)
        var owner = BaremetalWmPresentOwnerV1.create(identity)
        expect(owner.commit_present(identity, 9, 1u64, 1u64, true).accepted).to_be(true)
        expect(owner.commit_present(identity, 8, 2u64, 2u64, true).reason).to_equal("stale-scene-revision")
        expect(owner.snapshot().scene_revision).to_equal(9u64)
