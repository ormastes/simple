"""
## Purpose and audience
Pins the compositor owner boundary for untrusted local, remote, and shared-scene
window requests. Maintainers should update these assertions whenever the
display-containment or retained-content contract changes.

## Evidence class
Source-contract unit coverage. These scenarios call the production compositor
APIs; they do not claim live framebuffer or guest evidence.
"""
# @manual: primary
# @req: REQ-OS-COMPOSITOR-001
# @cover src/os/compositor/compositor.spl 80%
# @tag: unit, simpleos, wm, compositor, admission

use std.spec.*
use os.compositor.compositor.{
    Compositor,
    WM_COMPOSITOR_MAX_WINDOWS,
    WM_WINDOW_TITLE_MAX_BYTES
}
use os.compositor.host_compositor_entry.{HeadlessHostCompositorBackend}
use common.ui.window_scene.{
    SharedWmWindow,
    WM_CHROME_KIND_TITLED,
    simple_gui_internal_window_scene
}
use common.web.browser_renderer_protocol.{BROWSER_RENDERER_MAX_PAYLOAD_BYTES}

fn _bounded_compositor() -> Compositor:
    Compositor.with_backends(
        HeadlessHostCompositorBackend.new(320, 240), nil, 320, 240
    )

fn _scene_window(title: text, html: text, z_index: i32) -> SharedWmWindow:
    SharedWmWindow(
        surface_id: "surface-{z_index}",
        window_id: "window-{z_index}",
        surface_kind: "simple_web",
        process_id: (z_index + 1).to_u64(),
        app_id: "app-{z_index}",
        title: title,
        language: "en",
        x: 12,
        y: 16,
        width: 180,
        height: 140,
        tree: nil,
        html: html,
        minimized: false,
        focused: z_index == 0,
        z_index: z_index,
        chrome_kind: WM_CHROME_KIND_TITLED
    )

describe "Compositor admission bounds":
    it "should contain hostile create geometry inside the display":
        step("Create a window with extreme position and dimensions")
        var compositor = _bounded_compositor()
        val id = compositor.create_window(
            "bounded", 2147483647, -2147483647, 2147483647, -2147483647
        )

        expect(id).to_equal(1)
        expect(compositor.surfaces.len()).to_equal(1)
        expect(compositor.surfaces[0].x).to_equal(0)
        expect(compositor.surfaces[0].y).to_equal(0)
        expect(compositor.surfaces[0].width).to_equal(320)
        expect(compositor.surfaces[0].height).to_equal(120)

    it "should clamp move and resize through the same display owner":
        step("Move a live window beyond both display edges")
        var compositor = _bounded_compositor()
        val id = compositor.create_window("mutable", 40, 30, 180, 140)
        compositor.move_window(id, 2147483647, -2147483647)
        expect(compositor.surfaces[0].x).to_equal(140)
        expect(compositor.surfaces[0].y).to_equal(0)

        step("Resize beyond the display and re-contain the retained origin")
        compositor.resize_window(id.to_u64(), 2147483647, 2147483647)
        expect(compositor.surfaces[0].x).to_equal(0)
        expect(compositor.surfaces[0].y).to_equal(0)
        expect(compositor.surfaces[0].width).to_equal(320)
        expect(compositor.surfaces[0].height).to_equal(240)

    it "should reject titles beyond the retained render-cost ceiling":
        step("Admit a title at the exact byte ceiling")
        var compositor = _bounded_compositor()
        val exact_title = "t".repeat(WM_WINDOW_TITLE_MAX_BYTES.to_i64())
        val accepted = compositor.create_window(exact_title, 0, 0, 180, 140)
        expect(accepted).to_equal(1)
        expect(compositor.surfaces[0].title.len()).to_equal(
            WM_WINDOW_TITLE_MAX_BYTES
        )

        step("Reject oversized create and update requests without mutation")
        val oversized_title = "t".repeat(
            WM_WINDOW_TITLE_MAX_BYTES.to_i64() + 1
        )
        val rejected = compositor.create_window(
            oversized_title, 0, 0, 180, 140
        )
        compositor.set_window_title(accepted.to_u64(), oversized_title)
        expect(rejected).to_equal(0)
        expect(compositor.surfaces.len()).to_equal(1)
        expect(compositor.surfaces[0].title).to_equal(exact_title)

    it "should reject retained HTML beyond the renderer payload ceiling":
        step("Retain an exact-ceiling document")
        var compositor = _bounded_compositor()
        val id = compositor.create_window("web", 0, 0, 180, 140)
        val exact_html = "h".repeat(BROWSER_RENDERER_MAX_PAYLOAD_BYTES)
        compositor.update_window_content(id.to_u64(), exact_html)
        expect(compositor.surfaces[0].content_html.len().to_i64()).to_equal(
            BROWSER_RENDERER_MAX_PAYLOAD_BYTES
        )

        step("Reject the oversized replacement and preserve the document epoch")
        val revision = compositor.surfaces[0].content_revision
        val oversized_html = "h".repeat(
            BROWSER_RENDERER_MAX_PAYLOAD_BYTES + 1
        )
        compositor.update_window_content(id.to_u64(), oversized_html)
        expect(compositor.surfaces[0].content_revision).to_equal(revision)
        expect(compositor.surfaces[0].content_html).to_equal(exact_html)

    it "should stop admitting surfaces at the compositor ceiling":
        step("Fill the compositor to its published surface ceiling")
        var compositor = _bounded_compositor()
        var index = 0
        while index < WM_COMPOSITOR_MAX_WINDOWS:
            val id = compositor.create_window(
                "window-{index}", 0, 0, 160, 120
            )
            expect(id).to_equal(index + 1)
            index = index + 1

        step("Reject one additional surface without consuming an id")
        val rejected = compositor.create_window("overflow", 0, 0, 160, 120)
        expect(rejected).to_equal(0)
        expect(compositor.surfaces.len()).to_equal(WM_COMPOSITOR_MAX_WINDOWS)
        expect(compositor.next_id).to_equal(WM_COMPOSITOR_MAX_WINDOWS + 1)

    it "should stop a shared-scene import at the first invalid entry":
        step("Place invalid retained HTML between two otherwise valid windows")
        val oversized_html = "h".repeat(
            BROWSER_RENDERER_MAX_PAYLOAD_BYTES + 1
        )
        val scene = simple_gui_internal_window_scene(
            320,
            240,
            "unit",
            [
                _scene_window("first", "<p>first</p>", 0),
                _scene_window("invalid", oversized_html, 1),
                _scene_window("must-not-scan", "<p>third</p>", 2)
            ]
        )
        var compositor = _bounded_compositor()

        val ids = compositor.create_windows_from_shared_scene(scene)

        expect(ids.len()).to_equal(1)
        expect(compositor.surfaces.len()).to_equal(1)
        expect(compositor.surfaces[0].title).to_equal("first")
        expect(compositor.next_id).to_equal(2)
