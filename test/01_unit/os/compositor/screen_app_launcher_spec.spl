# @tag: unit, os, simpleos, compositor, screen, shell
"""
# Boot Screen App Shells

**Feature IDs:** simpleos-config-screen-selection
**Category:** OS / Compositor / Screen Selection
**Status:** In Progress
**Plan:** doc/03_plan/os/simpleos/screens/ws_a_config_screen_selection_detail.md

## Overview

As an operator I want `screen_type=2d` to bring a real shell up, not just name
one. `launch_screen_app` dispatches a resolved `ScreenSelection` onto the
matching `screen_app_*` opener; these scenarios drive the dispatch with a nil
backend so shell identity, liveness and the boot marker are observable without
any device present.
"""

use std.spec.*
use os.compositor.backend_factory.{ScreenSelection}
use os.compositor.screen_app.{ScreenApp, screen_app_new}
use os.compositor.screen_app_2d.{screen_app_2d_open}
use os.compositor.screen_app_web.{screen_app_web_open}
use os.compositor.screen_app_gui.{screen_app_gui_open}
use os.compositor.screen_app_launcher.{launch_screen_app}
use os.compositor.display_backend_core.{CompositorBackend, CompositorGlassCapable}

# Recording surface. The whole A5 non-blank claim rests on `paint_boot_frame`
# emitting MORE THAN ONE colour, so that path must be executed, not merely
# compile-checked against a nil backend.
#
# The log is a MODULE-level var, not an instance field: the surface is handed
# to `ScreenApp` as a `CompositorBackend?` and the value is copied, so writes
# to instance fields are not observable from the spec. Module state is.
var g_recorded_colors: [u32] = []

fn reset_recorded_colors():
    g_recorded_colors = []
class RecordingSurface:
    w: i32
    h: i32
    colors: [u32]
    presents: i64

impl CompositorBackend for RecordingSurface:
    fn width() -> i32:
        self.w

    fn height() -> i32:
        self.h

    me clear(color: u32):
        g_recorded_colors.push(color)

    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        g_recorded_colors.push(color)

    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        g_recorded_colors.push(fg)

    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        g_recorded_colors.push(fg)

    me put_pixel(x: i32, y: i32, color: u32):
        g_recorded_colors.push(color)

    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        for p in pixels:
            g_recorded_colors.push(p)

    me present():
        self.presents = self.presents + 1

    me present_rect(x: i32, y: i32, w: i32, h: i32):
        self.presents = self.presents + 1

    fn as_glass_capable() -> CompositorGlassCapable?:
        nil

fn distinct_count(colors: [u32]) -> i64:
    var seen: [u32] = []
    for c in colors:
        var found = false
        for k in seen:
            if k == c:
                found = true
        if not found:
            seen.push(c)
    seen.len()

fn selection_for(shell: text, reason: text) -> ScreenSelection:
    ScreenSelection(
        requested: shell,
        effective: shell,
        reason: reason,
        backend: nil,
        shell: shell
    )

describe "screen app shells":

    it "opens a shell per screen type with the requested surface size":
        assert_equal(screen_app_2d_open(800, 600, nil, "none").shell, "2d")
        assert_equal(screen_app_web_open(800, 600, nil, "none").shell, "web")
        assert_equal(screen_app_gui_open(800, 600, nil, "none").shell, "gui")
        val app = screen_app_2d_open(1024, 768, nil, "none")
        assert_equal(app.width, 1024)
        assert_equal(app.height, 768)

    it "reports a shell with no surface as not live rather than blank":
        val app = screen_app_gui_open(640, 480, nil, "unsupported:gui:host-window-server")
        assert_true(not app.is_live())
        assert_equal(app.reason, "unsupported:gui:host-window-server")

    it "refuses to paint a boot frame without a surface":
        assert_true(not screen_app_new("2d", 320, 200, nil, "none").paint_boot_frame())

    it "paints a boot frame carrying more than one colour":
        reset_recorded_colors()
        val surface = RecordingSurface(w: 1024, h: 768, colors: [], presents: 0)
        val app = screen_app_2d_open(1024, 768, surface, "none")
        assert_true(app.is_live())
        assert_true(app.paint_boot_frame())
        # A uniform-colour frame is indistinguishable from a blank screen, so
        # >1 is the assertion, matching the A5 screendump rule exactly.
        assert_true(g_recorded_colors.len() >= 2)
        assert_true(distinct_count(g_recorded_colors) > 1)

    it "emits a greppable boot marker naming the effective type":
        val marker = screen_app_2d_open(1024, 768, nil, "none").marker()
        assert_true(marker.starts_with("[screen] effective=2d"))
        assert_true(marker.contains("res=1024x768"))

describe "screen app dispatch":

    it "routes each shell key to its own opener":
        assert_equal(launch_screen_app(selection_for("2d", ""), 800, 600).shell, "2d")
        assert_equal(launch_screen_app(selection_for("web", ""), 800, 600).shell, "web")
        assert_equal(launch_screen_app(selection_for("gui", ""), 800, 600).shell, "gui")
        assert_equal(launch_screen_app(selection_for("wm", ""), 800, 600).shell, "wm")

    it "falls through an unknown shell key to the wm floor":
        assert_equal(launch_screen_app(selection_for("quake", ""), 800, 600).shell, "wm")

    it "renders an empty fallback reason as none on the launched shell":
        assert_equal(launch_screen_app(selection_for("2d", ""), 800, 600).reason, "none")
        val fell_back = launch_screen_app(selection_for("wm", "unsupported:gui:framebuffer"), 800, 600)
        assert_equal(fell_back.reason, "unsupported:gui:framebuffer")
