# @tag: unit, contract, compositor
"""
# CompositorBackend has exactly one trait owner

`os.compositor.display_backend` redeclared `CompositorBackend` and
`CompositorGlassCapable` (twice, without `report_damage`). Every implementor that
imported them from there implemented a different native trait owner than the
shared executor in `common.ui.window_scene_draw_ir` accepts. Stage 2 rejected
`SharedMdiFramebufferBackend` with "missing native trait implementation:
lib.common.ui.compositor_backend_core::CompositorBackend" (bootstrap run 13).

Bug: doc/08_tracking/bug/compositor_backend_duplicate_trait_owner_2026-11-07.md
"""
use std.spec
use std.io_runtime.{file_read}
use os.compositor.display_backend.{CompositorBackend, CompositorGlassCapable}

class NoDamageBackend:
    w: i32

impl CompositorBackend for NoDamageBackend:
    fn width() -> i32:
        self.w
    fn height() -> i32:
        self.w
    me clear(color: u32):
        pass_dn
    me fill_rect(x: i32, y: i32, w: i32, h: i32, color: u32):
        pass_dn
    me draw_text(x: i32, y: i32, text_str: text, fg: u32, bg: u32):
        pass_dn
    me draw_char_8x16(x: i32, y: i32, ch: u8, fg: u32, bg: u32):
        pass_dn
    me put_pixel(x: i32, y: i32, color: u32):
        pass_dn
    me blit_pixels(x: i32, y: i32, w: i32, h: i32, pixels: [u32]):
        pass_dn
    me present():
        pass_dn
    me present_rect(x: i32, y: i32, w: i32, h: i32):
        pass_dn
    fn as_glass_capable() -> CompositorGlassCapable?:
        nil

describe "CompositorBackend trait owner":
    it "is declared only in common.ui.compositor_backend_core":
        val os_source = file_read("src/os/compositor/display_backend.spl")
        expect(os_source.contains("trait CompositorBackend")).to_equal(false)
        expect(os_source.contains("trait CompositorGlassCapable")).to_equal(false)
        expect(os_source).to_contain("export use common.ui.compositor_backend_core.{CompositorGlassCapable, CompositorBackend}")

    it "gives report_damage a no-op default so damage-free backends need not repeat it":
        var backend: CompositorBackend = NoDamageBackend(w: 4)
        backend.report_damage(0, 0, 1, 1)
        expect(backend.width()).to_equal(4)
