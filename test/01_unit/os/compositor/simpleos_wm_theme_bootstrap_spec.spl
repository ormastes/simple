# @tag: unit, simpleos, wm, theme
# @cover src/os/compositor/simpleos_wm_theme_bootstrap.spl 100%

use std.spec.*
use common.ui.generated.aetheric_dark_theme_snapshot.{aetheric_dark_theme_render_snapshot}
use common.ui.theme_render_snapshot.{theme_role_color}
use common.ui.wm_chrome_theme.{
    active_wm_theme_snapshot_present,
    active_wm_theme_snapshot_unchecked,
    reset_wm_chrome_theme,
    wm_chrome_theme
}
use nogc_sync_mut.ui.theme_package.{theme_package_render_snapshot}
use os.compositor.simpleos_wm_theme_bootstrap.{install_generated_simpleos_wm_theme}

describe "SimpleOS generated WM theme bootstrap":
    it "returns and applies the generated Aetheric snapshot":
        reset_wm_chrome_theme()
        val expected = aetheric_dark_theme_render_snapshot()
        val installed = install_generated_simpleos_wm_theme()
        expect(installed.id).to_equal(expected.id)
        expect(installed.source_manifest_sha256).to_equal(expected.source_manifest_sha256)
        expect(installed.material_sha256).to_equal(expected.material_sha256)
        expect(active_wm_theme_snapshot_present()).to_be(true)
        val active = active_wm_theme_snapshot_unchecked()
        expect(active.id).to_equal(expected.id)
        expect(active.material_sha256).to_equal(expected.material_sha256)
        expect(wm_chrome_theme().compositor_bg).to_equal(expected.material.desktop_fill_rgba)
        reset_wm_chrome_theme()

    it "preserves package semantic colors through the generated bootstrap snapshot":
        reset_wm_chrome_theme()
        val package_snapshot = theme_package_render_snapshot("aetheric_dark")
        val installed = install_generated_simpleos_wm_theme()

        expect(installed.semantic.info_rgba).to_equal(package_snapshot.semantic.info_rgba)
        expect(installed.semantic.success_rgba).to_equal(package_snapshot.semantic.success_rgba)
        expect(installed.semantic.warning_rgba).to_equal(package_snapshot.semantic.warning_rgba)
        expect(installed.semantic.error_rgba).to_equal(package_snapshot.semantic.error_rgba)
        expect(theme_role_color(installed, "semantic.info").rgba).to_equal(0xFF9BDCFFu32)
        expect(theme_role_color(installed, "semantic.error").rgba).to_equal(0xFFFFB4ABu32)
        reset_wm_chrome_theme()
