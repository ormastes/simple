use os.compositor.ps2_wm_key_decode.{
    ps2_wm_character,
    ps2_wm_key_name,
}

fn main() -> i64:
    if ps2_wm_character(0x1F, true) != "S":
        return 1
    if ps2_wm_character(0x17, false) != "i":
        return 2
    if ps2_wm_character(0x04, false) != "3":
        return 3
    if ps2_wm_character(0x02, true) != "!":
        return 4
    if ps2_wm_key_name(0x0F) != "tab":
        return 5
    if ps2_wm_key_name(0x1C) != "enter":
        return 6
    if ps2_wm_key_name(0x38) != "":
        return 7
    0
