# @tag: compositor, occlusion, ws-d6
# @cover src/os/compositor/compositor.spl 3%
#
# WS-D6 — exhaustive spec for the occlusion coverage PREDICATE.
#
# `wm_rect_covered` is the exact region-subtraction test that decides whether a
# window is provably invisible. It is a pure free function over `[i32]` arrays,
# so unlike `Compositor.render_all()` — which is interpreter-bound on this tree
# (see the `jit-fallback` note in
# `doc/08_tracking/bug/compositor_render_all_color_name_collapse_2026-08-06.md`)
# — it can be driven exhaustively and fast.
#
# SCOPE HONESTY: this is NOT the whole-framebuffer test. It proves the
# predicate, not the pre-pass's choice of occluder and footprint rects. That
# half lives in `compositor_occlusion_spec.spl` and is slow by nature.
#
# The direction of every failure matters: `wm_rect_covered` returning a FALSE
# TRUE drops real pixels (a stale-pixel bug), while a false FALSE only costs a
# missed optimisation. Cases below pin both directions.

use std.spec.{describe, context, it, expect, expect_not, assert_true, step}
use os.compositor.compositor.{wm_rect_covered, wm_set_occlusion_culling, wm_occlusion_culling_enabled}

fn _covered(rx: i32, ry: i32, rw: i32, rh: i32, occ: [i32]) -> bool:
    var ox: [i32] = []
    var oy: [i32] = []
    var ow: [i32] = []
    var oh: [i32] = []
    var i = 0
    while i + 3 < occ.len().to_i32():
        ox.push(occ[i])
        oy.push(occ[i + 1])
        ow.push(occ[i + 2])
        oh.push(occ[i + 3])
        i = i + 4
    wm_rect_covered(rx, ry, rw, rh, ox, oy, ow, oh, 0)


describe "WS-D6 occlusion coverage predicate":
    """wm_rect_covered must never claim coverage it cannot prove."""

    context "degenerate inputs":
        it "an empty or inverted rect is trivially covered":
            assert_true(_covered(10, 10, 0, 40, []))
            assert_true(_covered(10, 10, 40, 0, []))
            assert_true(_covered(10, 10, -5, 40, []))

        it "a real rect with NO occluders is never covered":
            step("this is the empty-desktop case; a true here culls everything")
            expect_not(_covered(10, 10, 40, 30, []))

    context "single occluder":
        it "exact same rect covers":
            assert_true(_covered(10, 10, 40, 30, [10, 10, 40, 30]))

        it "strictly larger occluder covers":
            assert_true(_covered(10, 10, 40, 30, [0, 0, 100, 100]))

        it "one pixel short on width does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [10, 10, 39, 30]))

        it "one pixel short on height does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [10, 10, 40, 29]))

        it "one pixel offset on x does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [11, 10, 40, 30]))

        it "one pixel offset on y does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [10, 11, 40, 30]))

        it "a disjoint occluder does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [200, 200, 40, 30]))

        it "an edge-adjacent occluder (touching, not overlapping) does NOT cover":
            step("half-open rects: x+w is exclusive")
            expect_not(_covered(10, 10, 40, 30, [50, 10, 40, 30]))

        it "a strictly contained occluder does NOT cover":
            expect_not(_covered(10, 10, 40, 30, [15, 15, 10, 10]))

    context "multiple occluders — the union cases":
        it "two halves that tile the rect exactly DO cover":
            step("neither alone covers; together they do")
            assert_true(_covered(10, 10, 40, 30, [10, 10, 20, 30, 30, 10, 20, 30]))

        it "two halves with a one-pixel gap do NOT cover":
            expect_not(_covered(10, 10, 40, 30, [10, 10, 19, 30, 30, 10, 20, 30]))

        it "overlapping halves still cover":
            assert_true(_covered(10, 10, 40, 30, [10, 10, 25, 30, 25, 10, 25, 30]))

        it "four quadrants tiling the rect DO cover":
            assert_true(_covered(0, 0, 20, 20, [0, 0, 10, 10, 10, 0, 10, 10, 0, 10, 10, 10, 10, 10, 10, 10]))

        it "three of four quadrants do NOT cover":
            expect_not(_covered(0, 0, 20, 20, [0, 0, 10, 10, 10, 0, 10, 10, 0, 10, 10, 10]))

        it "a donut of occluders leaving a centre hole does NOT cover":
            step("classic false-positive shape for a bounding-box test")
            expect_not(_covered(0, 0, 30, 30, [0, 0, 30, 10, 0, 20, 30, 10, 0, 0, 10, 30, 20, 0, 10, 30]))

        it "the same donut plus the centre patch DOES cover":
            val donut_plus_centre = [0, 0, 30, 10, 0, 20, 30, 10,
                                     0, 0, 10, 30, 20, 0, 10, 30, 10, 10, 10, 10]
            assert_true(_covered(0, 0, 30, 30, donut_plus_centre))

        it "three horizontal bands tiling the rect DO cover":
            assert_true(_covered(5, 5, 50, 30, [5, 5, 50, 10, 5, 15, 50, 10, 5, 25, 50, 10]))

        it "three horizontal bands with a middle gap do NOT cover":
            expect_not(_covered(5, 5, 50, 30, [5, 5, 50, 10, 5, 16, 50, 9, 5, 25, 50, 10]))

    context "the production toggle":
        it "defaults to enabled and round-trips":
            assert_true(wm_occlusion_culling_enabled())
            wm_set_occlusion_culling(false)
            expect_not(wm_occlusion_culling_enabled())
            wm_set_occlusion_culling(true)
            assert_true(wm_occlusion_culling_enabled())
