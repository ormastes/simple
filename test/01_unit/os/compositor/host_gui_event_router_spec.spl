"""
## Purpose and audience
Purpose: Prove that host scalar GUI event routing.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

use std.spec
use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_ACTION_RELEASE,
    WINDOW_EVENT_POINTER_BUTTON,
    WINDOW_EVENT_POINTER_MOVE,
    WINDOW_EVENT_TEXT,
}
use common.ui.builder.{build_tree, button, column, text_field, with_height}
use common.window_protocol.geometry.{Size}
use nogc_sync_mut.ui.session.{UISession}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.compositor.host_gui_event_router.{HostGuiEventRouter}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

describe "host scalar GUI event routing":
    it "captures pointer and commits text without an event aggregate":
        step("Verify: captures pointer and commits text without an event aggregate")
        # @req: REQ-OS-COMPOSITOR-001
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 24)
        ]))
        var session = UISession.new(tree)
        var compositor = HostCompositor.new_headless(Size.wh(160, 120))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Demo", 10, 10, 108, 96, "", 99, "demo"
        )
        var router = HostGuiEventRouter.new(1)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_MOVE,
            0, 0, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        compositor.dragging = true
        compositor.drag_window_id = 1
        compositor.drag_offset_x = 0
        compositor.drag_offset_y = 0
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.windows[0].x).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(compositor.windows[0].y).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(router.client_pointer_captured).to_equal(true)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_MOVE,
            0, 0, 0,
            150000, 110000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.last_local_x).to_equal(136)  # oracle: 136 — named expected value from the requirement
        expect(router.last_local_y).to_equal(68)  # oracle: 68 — named expected value from the requirement
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_RELEASE, 0,
            150000, 110000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.client_pointer_captured).to_equal(false)
        expect(compositor.pointer_x).to_equal(150)  # oracle: 150 — named expected value from the requirement
        expect(compositor.pointer_y).to_equal(110)  # oracle: 110 — named expected value from the requirement
        val access_count_before_right = session.access_events.len()
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            2, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.last_button).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(compositor.last_button_down).to_equal(true)
        expect(router.client_pointer_captured).to_equal(false)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            2, WINDOW_ACTION_RELEASE, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.last_button_down).to_equal(false)
        expect(session.access_events.len()).to_equal(access_count_before_right)
        expect(router.route_scalar(
            WINDOW_EVENT_TEXT,
            0, 0, 0,
            0, 0, 0, 0,
            compositor, session, "A"
        )).to_equal(true)
        expect(session.current_tree().find_widget(
            "name"
        ).get_prop("value")).to_equal("A")

    it "cancels client capture when another window receives focus":
        step("Verify: cancels client capture when another window receives focus")
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 24)
        ]))
        var session = UISession.new(tree)
        var compositor = HostCompositor.new_headless(Size.wh(320, 180))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "First", 10, 10, 108, 96, "", 99, "first"
        )
        compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Second", 160, 10, 108, 96, "", 100, "second"
        )
        var router = HostGuiEventRouter.new(1)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.client_pointer_captured).to_equal(true)
        compositor.focus_window(2)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_RELEASE, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(false)
        expect(router.client_pointer_captured).to_equal(false)

describe "hosted compositor GUI-session content dispatch":
    """As a hosted WM user I want pointer, wheel, key, and text input that
    reaches a GUI-session window's client area to drive the widget session,
    with the same focus gating, client-area translation, and pointer capture
    the baremetal compositor provides."""
    it "gates routing on GUI content kind and captures the pointer":
        step("Verify: gates routing on GUI content kind and captures the pointer")
        var compositor = HostCompositor.new_headless(Size.wh(320, 180))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Gui", 10, 10, 108, 96, "", 99, "gui-demo"
        )
        val window_id = compositor.windows[0].id
        expect_not(compositor.is_gui_content_window(window_id))
        expect_not(compositor.dispatch_gui_pointer_event(
            window_id, 20, 50, "left", "down"
        ))
        val tree = build_tree(column("root", [
            with_height(button("run-action", "Run", "demo.run"), 20)
        ]))
        assert_true(compositor.attach_window_gui_tree(window_id, tree))
        assert_true(compositor.is_gui_content_window(window_id))
        assert_true(compositor.dispatch_gui_pointer_event(
            window_id, 20, 50, "left", "down"
        ))
        expect(compositor.gui_pointer_capture_window_id).to_equal(window_id)
        expect(compositor.take_gui_content_action(
            window_id
        )).to_equal("demo.run")
        expect(compositor.take_gui_content_action(window_id)).to_equal("")
        assert_true(compositor.dispatch_gui_pointer_event(
            0, 300, 170, "left", "up"
        ))
        expect(compositor.gui_pointer_capture_window_id).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "delivers keys and committed text only to the focused GUI window":
        step("Verify: delivers keys and committed text only to the focused GUI window")
        var compositor = HostCompositor.new_headless(Size.wh(320, 180))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Gui", 10, 10, 108, 96, "", 99, "gui-demo"
        )
        val window_id = compositor.windows[0].id
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 20)
        ]))
        assert_true(compositor.attach_window_gui_tree(window_id, tree))
        assert_true(compositor.dispatch_gui_pointer_event(
            window_id, 20, 50, "left", "down"
        ))
        assert_true(compositor.dispatch_gui_pointer_event(
            window_id, 20, 50, "left", "up"
        ))
        assert_true(compositor.dispatch_gui_text_event(window_id, "Hi"))
        assert_true(compositor.dispatch_gui_key_event(
            window_id, "a", false, false, false, false
        ))
        val stored = compositor.gui_content_tree(window_id)
        assert_true(stored != nil)
        if stored != nil:
            expect(stored.find_widget("name").get_prop("value")).to_equal(
                "Hia"
            )
        compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Other", 160, 10, 108, 96, "", 100, "other"
        )
        val other_id = compositor.windows[1].id
        compositor.focus_window(other_id)
        expect_not(compositor.dispatch_gui_key_event(
            window_id, "b", false, false, false, false
        ))
        expect_not(compositor.dispatch_gui_text_event(window_id, "x"))

    it "scrolls inside the client area and releases GUI state on destroy":
        step("Verify: scrolls inside the client area and releases GUI state on destroy")
        var compositor = HostCompositor.new_headless(Size.wh(320, 180))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Gui", 10, 10, 108, 96, "", 99, "gui-demo"
        )
        val window_id = compositor.windows[0].id
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 20)
        ]))
        assert_true(compositor.attach_window_gui_tree(window_id, tree))
        assert_true(compositor.dispatch_gui_scroll_event(
            window_id, 20, 50, 0, 1000
        ))
        expect_not(compositor.dispatch_gui_scroll_event(
            window_id, 2, 2, 0, 1000
        ))
        compositor.destroy_window(window_id)
        expect(compositor.gui_content_window_ids.len()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect_not(compositor.is_gui_content_window(window_id))
