use std.spec
use common.io.window_event.{
    WINDOW_ACTION_PRESS,
    WINDOW_ACTION_RELEASE,
    WINDOW_EVENT_POINTER_BUTTON,
    WINDOW_EVENT_POINTER_MOVE,
    WINDOW_EVENT_TEXT,
}
use common.ui.builder.{build_tree, column, text_field, with_height}
use common.window_protocol.geometry.{Size}
use nogc_sync_mut.ui.session.{UISession}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.compositor.host_gui_event_router.{HostGuiEventRouter}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

describe "host scalar GUI event routing":
    it "captures pointer and commits text without an event aggregate":
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 24)
        ]))
        var session = UISession.new(tree)
        var compositor = HostCompositor.new_headless(Size.wh(160, 120))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Demo", 10, 10, 108, 96, "", 99, "demo"
        )
        var router = HostGuiEventRouter.new(1)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_MOVE,
            0, 0, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        compositor.dragging = true
        compositor.drag_window_id = 1
        compositor.drag_offset_x = 0
        compositor.drag_offset_y = 0
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.windows[0].x).to_equal(10)
        expect(compositor.windows[0].y).to_equal(10)
        expect(router.client_pointer_captured).to_equal(true)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_MOVE,
            0, 0, 0,
            150000, 110000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.last_local_x).to_equal(136)
        expect(router.last_local_y).to_equal(68)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_RELEASE, 0,
            150000, 110000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.client_pointer_captured).to_equal(false)
        expect(compositor.pointer_x).to_equal(150)
        expect(compositor.pointer_y).to_equal(110)
        val access_count_before_right = session.access_events.len()
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            2, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.last_button).to_equal(2)
        expect(compositor.last_button_down).to_equal(true)
        expect(router.client_pointer_captured).to_equal(false)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            2, WINDOW_ACTION_RELEASE, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(compositor.last_button_down).to_equal(false)
        expect(session.access_events.len()).to_equal(access_count_before_right)
        expect(router.route_scalar(
            WINDOW_EVENT_TEXT,
            0, 0, 0,
            0, 0, 0, 0,
            compositor, session, "A"
        )).to_equal(true)
        expect(session.current_tree().find_widget(
            "name"
        ).get_prop("value")).to_equal("A")

    it "cancels client capture when another window receives focus":
        val tree = build_tree(column("root", [
            with_height(text_field("name", "", "Name"), 24)
        ]))
        var session = UISession.new(tree)
        var compositor = HostCompositor.new_headless(Size.wh(320, 180))
        compositor.apply_bridge_request(
            1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "First", 10, 10, 108, 96, "", 99, "first"
        )
        compositor.apply_bridge_request(
            2, 10, COMP_CREATE_WINDOW.to_i64(), 0,
            "Second", 160, 10, 108, 96, "", 100, "second"
        )
        var router = HostGuiEventRouter.new(1)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_PRESS, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(true)
        expect(router.client_pointer_captured).to_equal(true)
        compositor.focus_window(2)
        expect(router.route_scalar(
            WINDOW_EVENT_POINTER_BUTTON,
            0, WINDOW_ACTION_RELEASE, 0,
            18000, 44000, 0, 0,
            compositor, session
        )).to_equal(false)
        expect(router.client_pointer_captured).to_equal(false)
