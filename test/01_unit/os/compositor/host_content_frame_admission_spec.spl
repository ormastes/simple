use std.spec
use common.window_protocol.geometry.{Size}
use common.ui.window_scene.{
    WM_CONTENT_ORIGIN_PIXEL_SURFACE,
    WmContentFrame,
    wm_content_frame_checksum,
}
use common.ui.wm_gui_content_frame.{wm_gui_content_frame_from_pixels}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.compositor.wm_action_lifecycle.{
    HOST_CONTENT_OWNER_GUI,
    HOST_CONTENT_OWNER_PIXEL,
    HOST_CONTENT_OWNER_REMOTE_WEB,
}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW, COMP_MOVE}

fn frame_pixels(width: i32, height: i32, color: u32) -> [u32]:
    var pixels: [u32] = []
    var i = 0
    while i < width * height:
        pixels.push(color)
        i = i + 1
    pixels

fn count_color(pixels: [u32], color: u32) -> i64:
    var count: i64 = 0
    for pixel in pixels:
        if pixel == color:
            count = count + 1
    count

describe "host compositor content-frame admission":
    it "accepts GUI and pixel frames through the production compositor":
        val comp = HostCompositor.new_headless(Size.wh(320, 240))
        comp.apply_bridge_request(1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Demo", 10, 20, 108, 96, "", 99, "demo")
        expect(comp.windows[0].content_owner).to_equal(
            HOST_CONTENT_OWNER_REMOTE_WEB
        )
        expect(comp.require_external_content_frame(1)).to_equal(true)
        expect(comp.requires_external_web_frame(1)).to_equal(true)

        val gui_pixels = frame_pixels(100, 60, 0xFF336699u32)
        val gui = wm_gui_content_frame_from_pixels("1", "", 0, 0, 100, 60, gui_pixels, 1, 1)
        expect(comp.set_external_content_frame(1, gui)).to_equal(true)
        expect(comp.windows[0].content_owner).to_equal(
            HOST_CONTENT_OWNER_GUI
        )
        expect(comp.requires_external_web_frame(1)).to_equal(false)
        comp.apply_bridge_request(
            2, 10, COMP_MOVE.to_i64(), 1, "",
            20, 30, 0, 0, "", 99, "demo"
        )
        expect(comp.windows[0].content_owner).to_equal(
            HOST_CONTENT_OWNER_GUI
        )
        val raster = Engine2dCompositorBackend.create_named(
            320, 240, "software"
        )
        expect(comp.render_frame_engine2d(raster)).to_equal(true)
        expect(count_color(
            comp.pure_simple_pixel_buffer(), 0xFF336699u32
        )).to_be_greater_than(5000)

        val pixel_pixels = frame_pixels(100, 60, 0xFFAA5500u32)
        val pixel = WmContentFrame(
            window_id: "1",
            scene_revision: 1,
            content_revision: 2,
            origin_kind: WM_CONTENT_ORIGIN_PIXEL_SURFACE,
            width: 100,
            height: 60,
            pixels: pixel_pixels,
            checksum: wm_content_frame_checksum(pixel_pixels),
            parent_window_id: "",
            offset_x: 0,
            offset_y: 0
        )
        expect(comp.set_external_content_frame(1, pixel)).to_equal(true)
        expect(comp.windows[0].content_owner).to_equal(
            HOST_CONTENT_OWNER_PIXEL
        )
        expect(comp.requires_external_web_frame(1)).to_equal(false)
        expect(comp.render_frame_engine2d(raster)).to_equal(true)
        expect(count_color(
            comp.pure_simple_pixel_buffer(), 0xFFAA5500u32
        )).to_be_greater_than(5000)
        expect(count_color(
            comp.pure_simple_pixel_buffer(), 0xFF336699u32
        )).to_equal(0)

        comp.release_external_web_frame(1)
        expect(comp.windows[0].content_owner).to_equal(
            HOST_CONTENT_OWNER_REMOTE_WEB
        )
        expect(comp.requires_external_web_frame(1)).to_equal(true)
        raster.shutdown()
