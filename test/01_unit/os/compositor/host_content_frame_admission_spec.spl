use std.spec
use common.window_protocol.geometry.{Size}
use common.ui.window_scene.{
    WM_CONTENT_ORIGIN_PIXEL_SURFACE,
    WmContentFrame,
    wm_content_frame_checksum,
}
use common.ui.wm_gui_content_frame.{wm_gui_content_frame_from_pixels}
use os.compositor.host_compositor_entry.{HostCompositor, HeadlessHostCompositorBackend}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

fn frame_pixels(width: i32, height: i32) -> [u32]:
    var pixels: [u32] = []
    var i = 0
    while i < width * height:
        pixels.push(0xFF336699u32)
        i = i + 1
    pixels

describe "host compositor content-frame admission":
    it "accepts GUI and pixel frames through the production compositor":
        val backend = HeadlessHostCompositorBackend.new(320, 240)
        val comp = HostCompositor.new(backend, Size.wh(320, 240))
        comp.apply_bridge_request(1, 10, COMP_CREATE_WINDOW.to_i64(), 0, "Demo", 10, 20, 108, 96, "", 99, "demo")
        expect(comp.require_external_web_frame(1)).to_equal(true)

        val pixels = frame_pixels(100, 60)
        val gui = wm_gui_content_frame_from_pixels("1", "", 0, 0, 100, 60, pixels, 1, 1)
        # Runtime-truth red gate: the current Web-only admission rejects this
        # real GUI frame. The production implementation must generalize the
        # seam instead of changing this expected outcome to false.
        expect(comp.set_external_web_frame(1, gui)).to_equal(true)

        val pixel = WmContentFrame(
            window_id: "1",
            scene_revision: 1,
            content_revision: 2,
            origin_kind: WM_CONTENT_ORIGIN_PIXEL_SURFACE,
            width: 100,
            height: 60,
            pixels: pixels,
            checksum: wm_content_frame_checksum(pixels),
            parent_window_id: "",
            offset_x: 0,
            offset_y: 0
        )
        expect(comp.set_external_web_frame(1, pixel)).to_equal(true)
