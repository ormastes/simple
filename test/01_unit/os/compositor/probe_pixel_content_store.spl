use os.compositor.pixel_content_store.{
    pixel_content_store_create,
    pixel_content_store_live_count,
    pixel_content_store_add,
    pixel_content_store_width,
    pixel_content_store_height,
    pixel_content_store_length,
    pixel_content_store_address,
    pixel_content_store_color,
    pixel_content_store_set,
    pixel_content_store_blit_argb32,
    pixel_content_store_release,
    pixel_content_store_destroy,
}

extern fn rt_alloc(size: i64) -> i64
extern fn rt_free(ptr: i64)
extern fn rt_memset(ptr: i64, value: i64, size: i64) -> i64
extern fn rt_ptr_read_i64(addr: i64, offset: i64) -> i64

fn main() -> i64:
    val registry = pixel_content_store_create()
    if registry == 0:
        return 1
    if not pixel_content_store_add(
        registry, 4294967297, 2, 2, 0x11223344u32
    ):
        return 2
    if (pixel_content_store_live_count(registry) != 1 or
        pixel_content_store_width(registry, 4294967297) != 2 or
        pixel_content_store_height(registry, 4294967297) != 2 or
        pixel_content_store_length(registry, 4294967297) != 4 or
        pixel_content_store_address(registry, 4294967297) == 0):
        return 3
    if not pixel_content_store_set(
        registry, 4294967297, 2, 0x55667788u32
    ):
        return 4
    if pixel_content_store_color(
        registry, 4294967297, 2
    ) != 0x55667788u32:
        return 5
    val scanout = rt_alloc(64)
    if scanout == 0:
        return 6
    rt_memset(scanout, 0, 64)
    if not pixel_content_store_blit_argb32(
        registry, 4294967297, scanout, 4, 4, 16, 1, 1
    ):
        return 7
    if (rt_ptr_read_i64(scanout, 20) != 0x1122334411223344 or
        rt_ptr_read_i64(scanout, 36) != 0x1122334455667788):
        return 8
    if pixel_content_store_blit_argb32(
        registry, 4294967297, scanout, 4, 4, 16, 3, 3
    ):
        return 9
    rt_free(scanout)
    if not pixel_content_store_release(registry, 4294967297):
        return 10
    if pixel_content_store_live_count(registry) != 0:
        return 11
    pixel_content_store_destroy(registry)
    0
