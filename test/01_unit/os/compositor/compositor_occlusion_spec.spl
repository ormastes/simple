# @tag: compositor, occlusion, ws-d6
# @cover src/os/compositor/compositor.spl 5%
#
# WS-D6 — compositor occlusion culling: WHOLE-FRAMEBUFFER equivalence.
#
# `Compositor.render_all()` now runs a top-down occlusion pre-pass and skips
# every window that is provably fully covered by the windows above it. A
# culling bug is INVISIBLE to a test that only samples the region it expects to
# change, so every correctness assertion here compares the ENTIRE framebuffer
# of the culled render against a full-redraw reference produced with culling
# switched off. That is the same oracle shape WS-D3 used for damage.
#
# The reference and the subject are rendered by two independent compositors
# over two independent Engine2D CPU backends, so a shared-buffer aliasing
# mistake cannot make the comparison pass vacuously.

use std.spec.{describe, context, it, expect, step}
use std.gc_async_mut.gpu.engine2d.engine.{Engine2D}
use os.compositor.compositor.{Compositor, wm_set_occlusion_culling, wm_occlusion_culling_enabled}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

val SW: i32 = 240
val SH: i32 = 180

fn _make_backend() -> Engine2dCompositorBackend:
    var engine = Engine2D.create_with_backend(SW, SH, "cpu")
    engine.clear(0xFF000000u32)
    engine.present()
    Engine2dCompositorBackend.create(engine)

# Renders the given window set and returns the FULL framebuffer.
# `layout` entries are (x, y, w, h) quadruples flattened into one array so the
# two renders are driven from literally the same data.
fn _render_frame(layout: [i32], culling: bool) -> [u32]:
    wm_set_occlusion_culling(culling)
    var backend = _make_backend()
    var comp = Compositor.with_backends(backend, nil, SW, SH)
    var i = 0
    while i + 3 < layout.len().to_i32():
        comp.create_window("w" + (i / 4).to_text(),
                           layout[i], layout[i + 1], layout[i + 2], layout[i + 3])
        i = i + 4
    comp.render_all()
    val px = backend.get_pixel_buffer()
    wm_set_occlusion_culling(true)
    px

# Counts differing pixels over the WHOLE buffer (not a sampled region).
fn _whole_framebuffer_mismatches(a: [u32], b: [u32]) -> i32:
    if a.len() != b.len():
        return -1
    var diff = 0
    var i = 0
    while i < a.len().to_i32():
        if a[i] != b[i]:
            diff = diff + 1
        i = i + 1
    diff

fn _assert_identical(layout: [i32]):
    val reference = _render_frame(layout, false)
    val culled = _render_frame(layout, true)
    expect(reference.len()).to_equal(SW.to_i64() * SH.to_i64())
    expect(culled.len()).to_equal(reference.len())
    expect(_whole_framebuffer_mismatches(reference, culled)).to_equal(0)


describe "WS-D6 compositor occlusion culling":
    """Culled frames must be pixel-identical to a full redraw."""

    context "toggle":
        """The reference switch itself must work, or every case is vacuous."""

        it "defaults to enabled and round-trips":
            step("default is on")
            expect(wm_occlusion_culling_enabled()).to_equal(true)
            step("switch off and back on")
            wm_set_occlusion_culling(false)
            expect(wm_occlusion_culling_enabled()).to_equal(false)
            wm_set_occlusion_culling(true)
            expect(wm_occlusion_culling_enabled()).to_equal(true)

    context "whole-framebuffer equivalence":
        """Every layout renders identically with and without culling."""

        it "fully covered window (exact same rect) — the cull case":
            step("two identical rects; the lower one is invisible")
            _assert_identical([30, 30, 120, 90, 30, 30, 120, 90])

        it "strictly contained window — the cull case":
            step("lower window sits entirely inside the upper one")
            _assert_identical([50, 50, 60, 40, 30, 30, 140, 100])

        it "covered by the UNION of two windows, by neither alone":
            step("exact region subtraction, not a bounding-box guess")
            _assert_identical([40, 40, 120, 80, 40, 40, 60, 80, 100, 40, 60, 80])

        it "partial overlap — must NOT be culled":
            step("a false cull here shows up as missing pixels")
            _assert_identical([30, 30, 120, 90, 90, 70, 120, 90])

        it "disjoint windows — nothing culled":
            _assert_identical([10, 10, 80, 60, 140, 100, 80, 60])

        it "occluder one pixel short of covering — must NOT be culled":
            step("off-by-one in the coverage test is caught whole-buffer")
            _assert_identical([40, 40, 100, 80, 40, 40, 100, 79])

        it "single window and empty desktop":
            _assert_identical([20, 20, 100, 70])
            _assert_identical([])
