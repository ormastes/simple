"""
## Purpose and audience
Purpose: Prove that cursor shape transitions.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# Cursor shape/hotspot pipeline tests
#
# Covers the cursor model grown from the former CursorState stub: shape
# transitions, per-shape hotspot offsets, Arrow/IBeam bitmaps, and the
# cursor_rect damage math consumed by the WM damage path.

use std.spec
use os.compositor.cursor.{
    CursorState, CursorShape, CursorHotspot, CursorRect,
    default_cursor_state, cursor_shape, cursor_hotspot,
    cursor_bitmap, cursor_rect, cursor_shape_code, cursor_shape_from_code,
    get_cursor_bitmap, get_cursor_mask,
    CURSOR_WIDTH, CURSOR_HEIGHT
}

fn count_nonzero(px: [u32]) -> i32:
    var n: i32 = 0
    for v in px:
        if v != 0:
            n = n + 1
    n

describe "cursor shape transitions":
    it "defaults to Arrow with a tip hotspot":
        step("Verify: defaults to Arrow with a tip hotspot")
        # @req: REQ-OS-COMPOSITOR-001
        val c = default_cursor_state()
        expect(cursor_shape_code(c.shape_of())).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(c.hotspot_x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(c.hotspot_y).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "set_shape updates the shape code and hotspot in place":
        step("Verify: set_shape updates the shape code and hotspot in place")
        val c = default_cursor_state()
        c.set_shape(CursorShape.IBeam)
        expect(cursor_shape_code(c.shape_of())).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(c.hotspot_x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(c.hotspot_y).to_equal(9)  # oracle: 9 — named expected value from the requirement

    it "with_shape returns a copy carrying the new shape, preserving position":
        step("Verify: with_shape returns a copy carrying the new shape, preserving position")
        val base = CursorState(x: 40, y: 60, visible: true, hotspot_x: 0, hotspot_y: 0)
        val hand = base.with_shape(CursorShape.Hand)
        expect(hand.x).to_equal(40)  # oracle: 40 — named expected value from the requirement
        expect(hand.y).to_equal(60)  # oracle: 60 — named expected value from the requirement
        expect(cursor_shape_code(hand.shape_of())).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(hand.hotspot_x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(hand.hotspot_y).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "round-trips every shape code through the enum":
        step("Verify: round-trips every shape code through the enum")
        expect(cursor_shape_code(cursor_shape_from_code(3))).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(cursor_shape_code(cursor_shape_from_code(7))).to_equal(7)  # oracle: 7 — named expected value from the requirement

describe "cursor hotspot table":
    it "gives Arrow a top-left hotspot":
        step("Verify: gives Arrow a top-left hotspot")
        val hs = cursor_hotspot(CursorShape.Arrow)
        expect(hs.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(hs.y).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "gives IBeam a centered hotspot":
        step("Verify: gives IBeam a centered hotspot")
        val hs = cursor_hotspot(CursorShape.IBeam)
        expect(hs.x).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(hs.y).to_equal(9)  # oracle: 9 — named expected value from the requirement

describe "per-pixel cursor bitmaps":
    it "Arrow bitmap is correctly sized and non-empty":
        step("Verify: Arrow bitmap is correctly sized and non-empty")
        val bmp = cursor_bitmap(CursorShape.Arrow)
        expect(bmp.len()).to_equal(CURSOR_WIDTH * CURSOR_HEIGHT)
        assert_true(count_nonzero(bmp) > 0)

    it "IBeam bitmap is correctly sized and non-empty":
        step("Verify: IBeam bitmap is correctly sized and non-empty")
        val bmp = cursor_bitmap(CursorShape.IBeam)
        expect(bmp.len()).to_equal(228)  # oracle: 228 — named expected value from the requirement
        assert_true(count_nonzero(bmp) > 0)

    it "top-left pixel of the Arrow bitmap is filled":
        step("Verify: top-left pixel of the Arrow bitmap is filled")
        val bmp = cursor_bitmap(CursorShape.Arrow)
        expect(bmp[0]).to_equal(0xFFFFFFFF)

    it "fallback shapes reuse the Arrow bitmap":
        step("Verify: fallback shapes reuse the Arrow bitmap")
        val arrow = cursor_bitmap(CursorShape.Arrow)
        val wait = cursor_bitmap(CursorShape.Wait)
        expect(wait.len()).to_equal(arrow.len())
        expect(count_nonzero(wait)).to_equal(count_nonzero(arrow))

describe "legacy row-encoded arrow":
    it "keeps the 12x19 arrow contract":
        step("Verify: keeps the 12x19 arrow contract")
        expect(CURSOR_WIDTH).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(CURSOR_HEIGHT).to_equal(19)  # oracle: 19 — named expected value from the requirement
        expect(get_cursor_bitmap().len()).to_equal(19)  # oracle: 19 — named expected value from the requirement
        expect(get_cursor_mask().len()).to_equal(19)  # oracle: 19 — named expected value from the requirement
        expect(get_cursor_bitmap()[0]).to_equal(2048)  # oracle: 2048 — named expected value from the requirement
        expect(get_cursor_mask()[0]).to_equal(3072)  # oracle: 3072 — named expected value from the requirement

    it "mask is a superset wider than the bitmap on the first row":
        step("Verify: mask is a superset wider than the bitmap on the first row")
        val wider = get_cursor_mask()[0] > get_cursor_bitmap()[0]
        expect(wider).to_equal(true)

describe "cursor damage rect":
    it "offsets the origin by the hotspot and uses the cursor extent":
        step("Verify: offsets the origin by the hotspot and uses the cursor extent")
        val c = CursorState(x: 30, y: 50, visible: true, hotspot_x: 5, hotspot_y: 9)
        val r = cursor_rect(c)
        expect(r.x).to_equal(25)  # oracle: 25 — named expected value from the requirement
        expect(r.y).to_equal(41)  # oracle: 41 — named expected value from the requirement
        expect(r.w).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(r.h).to_equal(19)  # oracle: 19 — named expected value from the requirement
