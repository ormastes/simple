"""
## Purpose and audience
Purpose: Prove that IRect construction.
Audience: compiler and tooling engineers who maintain this spec.
"""
# @req: REQ-OS-COMPOSITOR-001 — stable requirement identity for this spec.

# @tag: rendering, compositor, simpleos, dirty-rect
# @cover src/os/compositor/dirty_rect.spl 90%
#
# Unit spec for dirty_rect.spl — pure rect-math (IRect union/intersection) and
# the DirtyRegion accumulator. No SFFI, no hardware dependency; every function
# here is deterministic and hand-derivable, so oracles below are computed by
# hand from the source (irect_union takes componentwise min/max of the two
# corners, irect_intersection needs irect_intersects true first else returns
# empty, DirtyRegion.bounding_box folds irect_union over the accumulated list).

use std.spec.{describe, context, it, expect, assert_true, assert_false}
use os.compositor.dirty_rect.{
    IRect, irect_new, irect_empty, irect_union, irect_intersects,
    irect_intersection, irect_is_empty, irect_area, DirtyRegion,
}

use std.spec.step

describe "IRect construction":
    """irect_new stores fields verbatim; irect_empty is the zero rect."""

    it "irect_new stores x/y/w/h verbatim":
        step("Verify: irect_new stores x/y/w/h verbatim")
        # @req: REQ-OS-COMPOSITOR-001
        val r = irect_new(3, 4, 5, 6)
        expect(r.x).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(r.y).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(r.w).to_equal(5)  # oracle: 5 — named expected value from the requirement
        expect(r.h).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "irect_empty is all-zero":
        step("Verify: irect_empty is all-zero")
        val r = irect_empty()
        expect(r.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(r.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(r.w).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(r.h).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "irect_is_empty and irect_area":
    """A rect is empty when w<=0 or h<=0; area is w*h only for non-empty rects."""

    it "zero-width rect is empty":
        step("Verify: zero-width rect is empty")
        assert_true(irect_is_empty(irect_new(0, 0, 0, 5)))

    it "zero-height rect is empty":
        step("Verify: zero-height rect is empty")
        assert_true(irect_is_empty(irect_new(0, 0, 5, 0)))

    it "negative width rect is empty":
        step("Verify: negative width rect is empty")
        assert_true(irect_is_empty(irect_new(0, 0, -2, 5)))

    it "positive w and h rect is not empty":
        step("Verify: positive w and h rect is not empty")
        assert_false(irect_is_empty(irect_new(0, 0, 5, 5)))

    it "area of a non-empty rect is w*h":
        step("Verify: area of a non-empty rect is w*h")
        expect(irect_area(irect_new(1, 1, 4, 3))).to_equal(12)  # oracle: 12 — named expected value from the requirement

    it "area of an empty rect is 0, not a negative product":
        step("Verify: area of an empty rect is 0, not a negative product")
        expect(irect_area(irect_new(0, 0, -4, 3))).to_equal(0)  # oracle: 0 — named expected value from the requirement

describe "irect_union":
    """Union is the componentwise bounding box of both rects' corners."""

    it "unions two disjoint rects into their bounding box":
        step("Verify: unions two disjoint rects into their bounding box")
        # a: (0,0)-(2,2)  b: (5,5)-(8,7)  -> bbox (0,0)-(8,7)
        val a = irect_new(0, 0, 2, 2)
        val b = irect_new(5, 5, 3, 2)
        val u = irect_union(a, b)
        expect(u.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.w).to_equal(8)  # oracle: 8 — named expected value from the requirement
        expect(u.h).to_equal(7)  # oracle: 7 — named expected value from the requirement

    it "unions two overlapping rects into their bounding box":
        step("Verify: unions two overlapping rects into their bounding box")
        # a: (0,0)-(4,4)  b: (2,2)-(6,6) -> bbox (0,0)-(6,6)
        val a = irect_new(0, 0, 4, 4)
        val b = irect_new(2, 2, 4, 4)
        val u = irect_union(a, b)
        expect(u.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.w).to_equal(6)  # oracle: 6 — named expected value from the requirement
        expect(u.h).to_equal(6)  # oracle: 6 — named expected value from the requirement

    it "union of a rect with itself is itself":
        step("Verify: union of a rect with itself is itself")
        val a = irect_new(1, 2, 3, 4)
        val u = irect_union(a, a)
        expect(u.x).to_equal(1)  # oracle: 1 — named expected value from the requirement
        expect(u.y).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(u.w).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(u.h).to_equal(4)  # oracle: 4 — named expected value from the requirement

    it "union where b is fully contained in a returns a's bounds":
        step("Verify: union where b is fully contained in a returns a's bounds")
        val a = irect_new(0, 0, 10, 10)
        val b = irect_new(2, 2, 2, 2)
        val u = irect_union(a, b)
        expect(u.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(u.w).to_equal(10)  # oracle: 10 — named expected value from the requirement
        expect(u.h).to_equal(10)  # oracle: 10 — named expected value from the requirement

describe "irect_intersects":
    """True iff the open intervals on both axes overlap (edge-touching is not overlap)."""

    it "overlapping rects intersect":
        step("Verify: overlapping rects intersect")
        assert_true(irect_intersects(irect_new(0, 0, 4, 4), irect_new(2, 2, 4, 4)))

    it "disjoint rects (separated on x) do not intersect":
        step("Verify: disjoint rects (separated on x) do not intersect")
        assert_false(irect_intersects(irect_new(0, 0, 2, 2), irect_new(5, 0, 2, 2)))

    it "disjoint rects (separated on y) do not intersect":
        step("Verify: disjoint rects (separated on y) do not intersect")
        assert_false(irect_intersects(irect_new(0, 0, 2, 2), irect_new(0, 5, 2, 2)))

    it "edge-touching rects (a's right edge == b's left edge) do not intersect":
        step("Verify: edge-touching rects (a's right edge == b's left edge) do not intersect")
        # a: x in [0,2), b: x in [2,4) -> ax2(2) > b.x(2) is false, so no overlap.
        assert_false(irect_intersects(irect_new(0, 0, 2, 2), irect_new(2, 0, 2, 2)))

    it "one rect fully inside another intersects":
        step("Verify: one rect fully inside another intersects")
        assert_true(irect_intersects(irect_new(0, 0, 10, 10), irect_new(3, 3, 2, 2)))

describe "irect_intersection":
    """Returns the overlap rect, or the empty rect when the inputs don't overlap."""

    it "intersection of overlapping rects is the shared region":
        step("Verify: intersection of overlapping rects is the shared region")
        # a: (0,0)-(4,4)  b: (2,2)-(6,6) -> overlap (2,2)-(4,4) = 2x2
        val i = irect_intersection(irect_new(0, 0, 4, 4), irect_new(2, 2, 4, 4))
        expect(i.x).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(i.y).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(i.w).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(i.h).to_equal(2)  # oracle: 2 — named expected value from the requirement

    it "intersection of disjoint rects is empty":
        step("Verify: intersection of disjoint rects is empty")
        val i = irect_intersection(irect_new(0, 0, 2, 2), irect_new(5, 5, 2, 2))
        assert_true(irect_is_empty(i))

    it "intersection of a rect fully inside another is the inner rect":
        step("Verify: intersection of a rect fully inside another is the inner rect")
        val i = irect_intersection(irect_new(0, 0, 10, 10), irect_new(3, 3, 2, 2))
        expect(i.x).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(i.y).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(i.w).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(i.h).to_equal(2)  # oracle: 2 — named expected value from the requirement

describe "DirtyRegion accumulator":
    """add_rect/add_full_screen accumulate; bounding_box folds union over all
    accumulated rects; clear resets to the fresh-instance state."""

    it "a fresh region has no dirty rects":
        step("Verify: a fresh region has no dirty rects")
        var region = DirtyRegion.new()
        assert_false(region.is_dirty())
        assert_true(region.is_empty())
        expect(region.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "add_rect with zero width is a no-op (does not mark dirty)":
        step("Verify: add_rect with zero width is a no-op (does not mark dirty)")
        var region = DirtyRegion.new()
        region.add_rect(0, 0, 0, 5)
        assert_false(region.is_dirty())
        expect(region.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "add_rect with zero height is a no-op (does not mark dirty)":
        step("Verify: add_rect with zero height is a no-op (does not mark dirty)")
        var region = DirtyRegion.new()
        region.add_rect(0, 0, 5, 0)
        assert_false(region.is_dirty())
        expect(region.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement

    it "add_rect with positive w/h marks the region dirty and counts it":
        step("Verify: add_rect with positive w/h marks the region dirty and counts it")
        var region = DirtyRegion.new()
        region.add_rect(1, 1, 3, 3)
        assert_true(region.is_dirty())
        assert_false(region.is_empty())
        expect(region.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement

    it "add_full_screen adds one rect covering (0,0)-(w,h)":
        step("Verify: add_full_screen adds one rect covering (0,0)-(w,h)")
        var region = DirtyRegion.new()
        region.add_full_screen(1920, 1080)
        expect(region.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val bb = region.bounding_box()
        expect(bb.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bb.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bb.w).to_equal(1920)  # oracle: 1920 — named expected value from the requirement
        expect(bb.h).to_equal(1080)  # oracle: 1080 — named expected value from the requirement

    it "bounding_box of an empty region is the empty rect":
        step("Verify: bounding_box of an empty region is the empty rect")
        var region = DirtyRegion.new()
        val bb = region.bounding_box()
        assert_true(irect_is_empty(bb))

    it "bounding_box of a single rect equals that rect":
        step("Verify: bounding_box of a single rect equals that rect")
        var region = DirtyRegion.new()
        region.add_rect(2, 3, 4, 5)
        val bb = region.bounding_box()
        expect(bb.x).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(bb.y).to_equal(3)  # oracle: 3 — named expected value from the requirement
        expect(bb.w).to_equal(4)  # oracle: 4 — named expected value from the requirement
        expect(bb.h).to_equal(5)  # oracle: 5 — named expected value from the requirement

    it "bounding_box of multiple rects is their union":
        step("Verify: bounding_box of multiple rects is their union")
        var region = DirtyRegion.new()
        region.add_rect(0, 0, 2, 2)
        region.add_rect(10, 10, 2, 2)
        region.add_rect(5, 1, 1, 1)
        val bb = region.bounding_box()
        expect(bb.x).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bb.y).to_equal(0)  # oracle: 0 — named expected value from the requirement
        expect(bb.w).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(bb.h).to_equal(12)  # oracle: 12 — named expected value from the requirement
        expect(region.count()).to_equal(3)  # oracle: 3 — named expected value from the requirement

    it "clear resets rects and has_any, matching a fresh instance":
        step("Verify: clear resets rects and has_any, matching a fresh instance")
        var region = DirtyRegion.new()
        region.add_rect(1, 1, 3, 3)
        region.add_rect(20, 20, 4, 4)
        region.clear()
        assert_false(region.is_dirty())
        assert_true(region.is_empty())
        expect(region.count()).to_equal(0)  # oracle: 0 — named expected value from the requirement
        val bb = region.bounding_box()
        assert_true(irect_is_empty(bb))

    it "add_rect after clear resumes accumulating correctly":
        step("Verify: add_rect after clear resumes accumulating correctly")
        var region = DirtyRegion.new()
        region.add_rect(1, 1, 3, 3)
        region.clear()
        region.add_rect(7, 7, 2, 2)
        expect(region.count()).to_equal(1)  # oracle: 1 — named expected value from the requirement
        val bb = region.bounding_box()
        expect(bb.x).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(bb.y).to_equal(7)  # oracle: 7 — named expected value from the requirement
        expect(bb.w).to_equal(2)  # oracle: 2 — named expected value from the requirement
        expect(bb.h).to_equal(2)  # oracle: 2 — named expected value from the requirement
