use common.window_protocol.geometry.{Size}
use os.compositor.host_compositor_entry.{HostCompositor}
use os.userlib.ipc_protocol.{COMP_CREATE_WINDOW}

fn main() -> i64:
    var compositor = HostCompositor.new_headless(Size.wh(320, 240))
    compositor.apply_bridge_request(
        1, 10, COMP_CREATE_WINDOW.to_i64(), 0,
        "Window", 40, 50, 180, 140, "", 99, "/sys/apps/window"
    )
    compositor.handle_mouse_move(218, 188)
    if compositor.resize_window_id == 0 or compositor.resizing:
        return 1
    compositor.handle_mouse_move(100, 100)
    if compositor.resize_window_id != 0:
        return 2
    if compositor.windows[0].w != 180 or compositor.windows[0].h != 140:
        return 3
    compositor.handle_left_button(true)
    compositor.handle_mouse_move(130, 130)
    if compositor.windows[0].w != 180 or compositor.windows[0].h != 140:
        return 4
    compositor.handle_left_button(false)

    compositor.handle_mouse_move(218, 188)
    compositor.handle_left_button(true)
    if not compositor.resizing:
        return 5
    compositor.handle_mouse_move(238, 208)
    if compositor.windows[0].w != 200 or compositor.windows[0].h != 160:
        return 6
    compositor.handle_left_button(false)
    if compositor.resizing or compositor.resize_window_id != 0:
        return 7
    0
