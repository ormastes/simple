"""Classify named guest marker evidence independently of host process success.

Marker strings here are unit inputs to the canonical classifier. They are not
captured serial output and cannot qualify a real QEMU or CLI run.
"""
use std.spec.{describe, it, expect, step}
use os.qemu_runner.{
    scenario_by_name_direct, _scenario_required_marker_fragments,
    qemu_scenario_serial_acceptance_reason
}

describe "Represented named routes require their own guest markers":
    it "rejects host-only success and accepts each complete classifier input":
        # @req: REQ-014 REQ-016
        """A successful host command cannot replace the selected guest's
        nonempty completion contract."""
        for lane in ["x86_64-q35-pure-nvme-perf", "x86_32-initrd-fat32-smf", "riscv64-virtio-fat32-smf", "riscv32-virtio-fat32-smf"]:
            step("Resolve the selected named route's canonical completion contract")
            val scenario = scenario_by_name_direct(lane)
            expect(scenario.name).to_equal(lane)
            val required = _scenario_required_marker_fragments(scenario)
            expect(required.len()).to_be_greater_than(0)
            step("Reject empty serial and host-only success text")
            expect(qemu_scenario_serial_acceptance_reason(scenario, "off", "")).to_start_with("missing-marker:")
            expect(qemu_scenario_serial_acceptance_reason(scenario, "off", "CLI exit=0; SimpleOS host command completed")).to_start_with("missing-marker:")
            step("Classify complete marker input without claiming a live boot")
            expect(qemu_scenario_serial_acceptance_reason(scenario, "off", required.join("\n"))).to_equal("ready")
