use std.spec.{describe, it, expect, step}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.env_ops.{host_os}
use std.nogc_sync_mut.io.process_ops.{process_run_timeout}
use std.nogc_sync_mut.ffi.io.{file_write_text}
use os.qemu_runner.{desktop_uefi_disk_image_tool_app_validation_command}

fn shell_exit_code(cmd: text) -> i32:
    val (_stdout, _stderr, exit_code) = process_run_timeout("sh", ["-c", cmd], 5000)
    exit_code

fn shell_status_output(cmd: text) -> text:
    val wrapped = cmd + "\ncode=$?\nprintf '\\n__exit=%s\\n' \"$code\"\nexit 0"
    val (stdout, _stderr, _exit_code) = process_run_timeout("sh", ["-c", wrapped], 5000)
    stdout

fn desktop_tool_app_fallback_fixture() -> text:
    "SBROWSMF\n" +
        "SMUXSMF\n" +
        "info|src/app/info/main.spl|smoke|staged\n" +
        "SCOMPSMF\n" +
        "SINTSMF\n" +
        "SLOADSMF\n" +
        "SIMPLSTC\n" +
        "LLVMSMF\n" +
        "CLANGSMF\n" +
        "RUSTSMF\n" +
        "WINHLSMF\n" +
        "SimpleOS LLVM standalone app v1\n" +
        "clang version 20.0.0\n" +
        "SimpleOS Rust standalone app v1\n" +
        "mode=native-filesystem-app\n" +
        "lane=x86_64-uefi-hardware\n" +
        "status=standalone-required\n" +
        "SIMPLECLI.CAT\n" +
        "/sys/apps/simple_browser\n" +
        "/sys/apps/smux\n" +
        "/sys/apps/simple_compiler\n" +
        "/sys/apps/simple_interpreter\n" +
        "/sys/apps/simple_loader\n" +
        "/sys/apps/simple\n" +
        "/sys/apps/llvm\n" +
        "/sys/apps/clang\n" +
        "/sys/apps/rust\n" +
        "/sys/apps/wine_hello\n" +
        "/usr/share/simpleos/toolchain/clang/hello.c\n" +
        "/usr/share/simpleos/toolchain/clang/pipeline.step\n" +
        "/usr/share/simpleos/toolchain/llvm/hello.ll\n" +
        "/usr/share/simpleos/toolchain/llvm/pipeline.step\n" +
        "/usr/share/simpleos/toolchain/rust/hello.rs\n" +
        "/usr/share/simpleos/toolchain/rust/pipeline.step\n" +
        "SMF\n"

fn expect_tool_app_validation_reference(cmd: text, app_name: text, marker: text, app_path: text):
    val img_path = "build/os/fat32-x86_64.img"
    expect(cmd).to_contain("::/SYS/APPS/{app_name}")
    expect(cmd).to_contain("::/SYS/APPS/{app_name}.smf")
    expect(cmd).to_contain("grep -a -q '{marker}'")
    expect(cmd).to_contain("grep -a -q '{app_path}'")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name} 2>/dev/null | strings | grep -q '{app_path}'")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name}.smf 2>/dev/null | strings | grep -q '{app_path}'")
    expect(cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/{app_name}.smf 2>/dev/null | grep -a -q 'SMF'")

describe "QEMU raw-image catalog validator":
    it "rejects the raw-image fallback when the CLI catalog marker is missing":
        step("Verify catalog validation uses mdir/mtype FAT checks instead of diagnostic raw fallback")
        val root = "build/test-qemu-tool-app-validator-missing"
        val bin_dir = root + "/bin"
        val img_path = root + "/desktop-uefi-tools.raw"
        expect(dir_create_all(bin_dir)).to_equal(true)
        val without_catalog = desktop_tool_app_fallback_fixture().replace(
            "info|src/app/info/main.spl|smoke|staged\n", "")
        expect(file_write_text(img_path, without_catalog)).to_equal(true)

        val val_cmd = desktop_uefi_disk_image_tool_app_validation_command(img_path)
        expect(val_cmd).to_contain("mdir -i \"{img_path}\" ::/SYS/APPS/SIMPLECLI.CAT")
        expect(val_cmd).to_contain("mtype -i \"{img_path}\" ::/SYS/APPS/SIMPLECLI.CAT 2>/dev/null | grep -q '^info|src/app/info/main.spl|smoke|staged$'")
        expect(val_cmd).to_contain("desktop-uefi-validation: mdir required; raw-image scan is diagnostic-only")
        expect(val_cmd.contains("grep -a -q 'SIMPLECLI.CAT'")).to_equal(false)
        if host_os() != "windows":
            expect(shell_exit_code("ln -sf \"$(command -v grep)\" \"" + bin_dir + "/grep\"")).to_equal(0)
            expect(shell_exit_code("ln -sf \"$(command -v strings)\" \"" + bin_dir + "/strings\"")).to_equal(0)
            val cmd = "PATH=\"" + bin_dir + "\"; export PATH; " + val_cmd
            expect(shell_status_output(cmd)).to_contain("__exit=1")
