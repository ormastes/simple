# @req REQ-PTY-HOST-001
# @cover src/lib/sys/pty.spl 80%

use std.spec.*
use std.io_runtime.{platform_name}
use std.sys.pty.{
    open as pty_open,
    spawn as pty_spawn,
    write as pty_write,
    read as pty_read,
    close as pty_close,
    is_running as pty_is_running,
    platform_default_shell
}

describe "host PTY capability":
    it "selects the native default shell":
        val platform = platform_name().lower()
        val shell = platform_default_shell()
        if platform.contains("windows"):
            expect(shell).to_equal("cmd.exe")
        else:
            expect(shell).to_equal("/bin/sh")

    it "rejects invalid dimensions before entering the runtime provider":
        expect(pty_open(0, 80)).to_equal(-1)
        expect(pty_open(24, 0)).to_equal(-1)

    it "fails closed for invalid handles and programs":
        expect(pty_spawn(-1, platform_default_shell())).to_equal(-1)
        expect(pty_spawn(0, "")).to_equal(-1)
        expect(pty_write(-1, "hello")).to_equal(false)
        expect(pty_read(-1, 10)).to_equal("")
        expect(pty_read(0, -1)).to_equal("")
        expect(pty_close(-1)).to_equal(false)
        expect(pty_is_running(-1)).to_equal(false)

    it "round trips a command through the host PTY":
        val handle = pty_open(24, 80)
        expect(handle).to_be_greater_than(0)
        val pid = pty_spawn(handle, platform_default_shell())
        expect(pid).to_be_greater_than(0)
        val command = if platform_name().lower().contains("windows"): "echo SIMPLE_PTY_OK\r\nexit\r\n" else: "echo SIMPLE_PTY_OK\nexit\n"
        expect(pty_write(handle, command)).to_equal(true)
        var output = ""
        var attempts = 0
        while attempts < 20 and output.contains("SIMPLE_PTY_OK") == false:
            output = output + pty_read(handle, 100)
            attempts = attempts + 1
        expect(output).to_contain("SIMPLE_PTY_OK")
        expect(pty_close(handle)).to_equal(true)
        expect(pty_close(handle)).to_equal(false)
