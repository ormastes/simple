"""
## Purpose and audience
Purpose: Prove the `arm64-desktop-engine2d` QEMU scenario is registered and
dispatchable by name, so `simple os build --scenario=arm64-desktop-engine2d`
can reach the canonical ARM64 Engine2D desktop/WM target instead of failing
with `unknown scenario`.
Audience: SimpleOS runner and arm64 WM lane maintainers.
## Operator workflow
Run this spec with the test runner; a failure means the catalog registration
regressed and the whole arm64 desktop/WM lane (attested builder plus every
gate downstream of it) is dead on arrival again.
## Compatibility and limitations
Pure catalog/target wiring; builds nothing and boots nothing.
# @manual: primary
REQ-OS-001
doc/01_research/local/REQ-OS-001.md
doc/03_plan/sys_test/REQ-OS-001.md
doc/04_architecture/REQ-OS-001.md
doc/05_design/REQ-OS-001.md
"""
# @req: REQ-OS-001

use os._QemuRunner.runner_targets.*
use os._QemuRunner.scenario_catalog.*
use os._QemuRunner.scenario_disks.*

describe "arm64-desktop-engine2d scenario registration":

    it "resolves the scenario by name from the catalog":
        # @req: REQ-OS-001
        expect(scenario_exists("arm64-desktop-engine2d")).to_be(true)
        expect(scenario_by_name_direct("arm64-desktop-engine2d").name).to_equal("arm64-desktop-engine2d")

    it "routes the named scenario to the canonical Engine2D desktop target":
        # @req: REQ-OS-001
        val scenario = scenario_arm64_desktop_engine2d()
        expect(scenario.name).to_equal("arm64-desktop-engine2d")
        val target = scenario_target(scenario)
        expect(target.entry).to_equal("examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl")
        expect(target.output).to_equal("build/os/simpleos_arm64_desktop_engine2d.elf")
        expect(target.target_triple).to_equal("aarch64-unknown-none")

    it "keeps the pre-existing arm64-wm-ramfb lane on its own target":
        # @req: REQ-OS-001
        val ramfb = scenario_target(scenario_arm64_wm_ramfb())
        expect(ramfb.output).to_equal("build/os/simpleos_arm64_wm.elf")
