"""Pure-Simple Cosmos Cortex-A9 SMP/GIC scalar policy."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_smp_gic_policy.*

describe "Cosmos pure-Simple SMP/GIC policy":
    it "preserves scalar register derivation and generation wrap semantics":
        expect(cosmos_gic_words_from_typer(0u32)).to_equal(1u32)
        expect(cosmos_gic_words_from_typer(31u32)).to_equal(32u32)
        expect(cosmos_gic_target_for_word(0u32)).to_equal(0u32)
        expect(cosmos_gic_target_for_word(1u32)).to_equal(0x01010101u32)
        expect(cosmos_smp_next_generation(0u32)).to_equal(1u32)
        expect(cosmos_smp_next_generation(0xFFFFFFFFu32)).to_equal(1u32)
        expect(cosmos_gic_priority_offset(0xFFFFFFFFu32)).to_equal(0x3FCu32)
        expect(cosmos_gic_target_offset(0xFFFFFFFFu32)).to_equal(0x7FCu32)

    it "preserves mailbox, PCIe IRQ, EOIR, and quiesce policy":
        expect(cosmos_smp_release_request_valid(0u32, 0x00100000u32, 0x00200000u32)).to_equal(1)
        expect(cosmos_smp_release_request_valid(1u32, 0x00100000u32, 0x00200000u32)).to_equal(0)
        expect(cosmos_smp_ack_observed(3u32, 41u32, 41u32)).to_equal(1)
        expect(cosmos_smp_ack_observed(3u32, 40u32, 41u32)).to_equal(0)
        expect(cosmos_gic_pcie_irq_in_range(1u32)).to_equal(0)
        expect(cosmos_gic_pcie_irq_in_range(2u32)).to_equal(1)
        expect(cosmos_gic_eoir_required(61u32)).to_equal(1)
        expect(cosmos_gic_eoir_required(1020u32)).to_equal(0)
        expect(cosmos_gic_quiesce_kind(61u32, 0)).to_equal(0u32)
        expect(cosmos_gic_quiesce_kind(61u32, 1)).to_equal(2u32)
        expect(cosmos_gic_quiesce_kind(7u32, 4)).to_equal(1u32)
        expect(cosmos_gic_quiesce_kind(1020u32, 4)).to_equal(0u32)

    it "records the frozen C oracle's 34 branch outcomes for 17 decisions":
        cosmos_smp_gic_policy_coverage_reset()
        _ = cosmos_gic_limit_words(0u32)
        _ = cosmos_gic_limit_words(33u32)
        _ = cosmos_gic_target_for_word(0u32)
        _ = cosmos_gic_target_for_word(1u32)
        _ = cosmos_smp_next_generation(0u32)
        _ = cosmos_smp_next_generation(0xFFFFFFFFu32)
        _ = cosmos_smp_release_request_valid(0u32, 0x1000u32, 0x2000u32)
        _ = cosmos_smp_release_request_valid(1u32, 0x1000u32, 0x2000u32)
        _ = cosmos_smp_release_request_valid(0u32, 0u32, 0x2000u32)
        _ = cosmos_smp_release_request_valid(0u32, 0x1000u32, 0u32)
        _ = cosmos_smp_release_request_valid(0u32, 0x1002u32, 0x2000u32)
        _ = cosmos_smp_release_request_valid(0u32, 0x1000u32, 0x2004u32)
        _ = cosmos_smp_secondary_state(0)
        _ = cosmos_smp_secondary_state(1)
        _ = cosmos_smp_ack_observed(3u32, 7u32, 7u32)
        _ = cosmos_smp_ack_observed(2u32, 7u32, 7u32)
        _ = cosmos_smp_ack_observed(3u32, 6u32, 7u32)
        _ = cosmos_gic_pcie_irq_in_range(1u32)
        _ = cosmos_gic_pcie_irq_in_range(2u32)
        _ = cosmos_gic_quiesce_kind(61u32, 0)
        _ = cosmos_gic_quiesce_kind(61u32, 1)
        _ = cosmos_gic_quiesce_kind(7u32, 4)
        _ = cosmos_gic_quiesce_kind(1020u32, 4)
        expect(cosmos_smp_gic_policy_coverage_decisions()).to_equal(17u32)
        expect(cosmos_smp_gic_policy_coverage_mask()).to_equal(
            cosmos_smp_gic_policy_coverage_required())
