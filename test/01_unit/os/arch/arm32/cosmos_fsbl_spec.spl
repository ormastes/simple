"""
Pure-Simple Cosmos+ FSBL handoff policy.

The examples exercise every fail-closed predicate independently, the QEMU
unavailable boundary, accepted extra register bits, and the production
self-test. MMIO acquisition and ARM object linkage remain integration gates.
"""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_fsbl.{
    COSMOS_FSBL_OK,
    COSMOS_FSBL_UNAVAILABLE,
    COSMOS_FSBL_INVALID,
    COSMOS_FSBL_HW_ERROR,
    COSMOS_FSBL_SLCR_BASE,
    COSMOS_FSBL_DEVCFG_BASE,
    COSMOS_FSBL_LOCKSTA_OFFSET,
    COSMOS_FSBL_ARM_CLK_OFFSET,
    COSMOS_FSBL_DDR_CLK_OFFSET,
    COSMOS_FSBL_PSS_RST_OFFSET,
    COSMOS_FSBL_A9_RST_OFFSET,
    COSMOS_FSBL_DEVCFG_INT_STS_OFFSET,
    COSMOS_FSBL_SLCR_LOCKED,
    COSMOS_FSBL_ARM_CLK_ACTIVE,
    COSMOS_FSBL_DDR_CLK_ACTIVE,
    COSMOS_FSBL_PSS_PRIMARY_RESET,
    COSMOS_FSBL_A9_CPU0_STOPPED,
    COSMOS_FSBL_PCFG_DONE,
    cosmos_fsbl_handoff_status,
    cosmos_fsbl_validate_snapshot,
    cosmos_fsbl_selftest_result,
    cosmos_fsbl_selftest
}

fn status(
    locksta: u32,
    arm_clk: u32,
    ddr_clk: u32,
    pss_rst: u32,
    a9_rst: u32,
    pcfg: u32
) -> i32:
    cosmos_fsbl_handoff_status(
        locksta, arm_clk, ddr_clk, pss_rst, a9_rst, pcfg
    )

describe "pure-Simple Cosmos FSBL handoff policy":
    it "pins status values to the C ABI independently":
        expect(COSMOS_FSBL_OK).to_equal(0)
        expect(COSMOS_FSBL_UNAVAILABLE).to_equal(1)
        expect(COSMOS_FSBL_INVALID).to_equal(2)
        expect(COSMOS_FSBL_HW_ERROR).to_equal(4)

    it "pins every Zynq handoff address independently":
        expect(COSMOS_FSBL_SLCR_BASE).to_equal(0xF8000000u32)
        expect(COSMOS_FSBL_DEVCFG_BASE).to_equal(0xF8007000u32)
        expect(COSMOS_FSBL_LOCKSTA_OFFSET).to_equal(0x000Cu32)
        expect(COSMOS_FSBL_ARM_CLK_OFFSET).to_equal(0x0120u32)
        expect(COSMOS_FSBL_DDR_CLK_OFFSET).to_equal(0x0124u32)
        expect(COSMOS_FSBL_PSS_RST_OFFSET).to_equal(0x0200u32)
        expect(COSMOS_FSBL_A9_RST_OFFSET).to_equal(0x0244u32)
        expect(COSMOS_FSBL_DEVCFG_INT_STS_OFFSET).to_equal(0x000Cu32)

    it "pins every Zynq handoff mask independently":
        expect(COSMOS_FSBL_SLCR_LOCKED).to_equal(0x00000001u32)
        expect(COSMOS_FSBL_ARM_CLK_ACTIVE).to_equal(0x1F000000u32)
        expect(COSMOS_FSBL_DDR_CLK_ACTIVE).to_equal(0x00000003u32)
        expect(COSMOS_FSBL_PSS_PRIMARY_RESET).to_equal(0x00000001u32)
        expect(COSMOS_FSBL_A9_CPU0_STOPPED).to_equal(0x00000111u32)
        expect(COSMOS_FSBL_PCFG_DONE).to_equal(0x00000004u32)

    it "accepts the complete silicon handoff snapshot":
        expect(status(
            COSMOS_FSBL_SLCR_LOCKED,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            0u32,
            0u32,
            COSMOS_FSBL_PCFG_DONE
        )).to_equal(COSMOS_FSBL_OK)

    it "reports QEMU unavailable for both valid and invalid snapshots":
        expect(cosmos_fsbl_validate_snapshot(
            true, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        )).to_equal(COSMOS_FSBL_UNAVAILABLE)
        expect(cosmos_fsbl_validate_snapshot(
            true,
            COSMOS_FSBL_SLCR_LOCKED,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            0u32,
            0u32,
            COSMOS_FSBL_PCFG_DONE
        )).to_equal(COSMOS_FSBL_UNAVAILABLE)

    it "applies the policy to silicon snapshots":
        expect(cosmos_fsbl_validate_snapshot(
            false,
            COSMOS_FSBL_SLCR_LOCKED,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            0u32,
            0u32,
            COSMOS_FSBL_PCFG_DONE
        )).to_equal(COSMOS_FSBL_OK)
        expect(cosmos_fsbl_validate_snapshot(
            false, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32
        )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects an unlocked SLCR":
        expect(status(
            0u32,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            0u32,
            0u32,
            COSMOS_FSBL_PCFG_DONE
        )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects any missing active ARM clock bit":
        for keep_mask in [
            0xFEFFFFFFu32,
            0xFDFFFFFFu32,
            0xFBFFFFFFu32,
            0xF7FFFFFFu32,
            0xEFFFFFFFu32
        ]:
            expect(status(
                COSMOS_FSBL_SLCR_LOCKED,
                COSMOS_FSBL_ARM_CLK_ACTIVE & keep_mask,
                COSMOS_FSBL_DDR_CLK_ACTIVE,
                0u32,
                0u32,
                COSMOS_FSBL_PCFG_DONE
            )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects any missing active DDR clock bit":
        for keep_mask in [0xFFFFFFFEu32, 0xFFFFFFFDu32]:
            expect(status(
                COSMOS_FSBL_SLCR_LOCKED,
                COSMOS_FSBL_ARM_CLK_ACTIVE,
                COSMOS_FSBL_DDR_CLK_ACTIVE & keep_mask,
                0u32,
                0u32,
                COSMOS_FSBL_PCFG_DONE
            )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects an asserted primary PS reset":
        expect(status(
            COSMOS_FSBL_SLCR_LOCKED,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            COSMOS_FSBL_PSS_PRIMARY_RESET,
            0u32,
            COSMOS_FSBL_PCFG_DONE
        )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects any CPU0 stopped/reset bit":
        for stopped_bit in [0x00000001u32, 0x00000010u32, 0x00000100u32]:
            expect(status(
                COSMOS_FSBL_SLCR_LOCKED,
                COSMOS_FSBL_ARM_CLK_ACTIVE,
                COSMOS_FSBL_DDR_CLK_ACTIVE,
                0u32,
                stopped_bit,
                COSMOS_FSBL_PCFG_DONE
            )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "rejects a handoff without PCFG_DONE":
        expect(status(
            COSMOS_FSBL_SLCR_LOCKED,
            COSMOS_FSBL_ARM_CLK_ACTIVE,
            COSMOS_FSBL_DDR_CLK_ACTIVE,
            0u32,
            0u32,
            0u32
        )).to_equal(COSMOS_FSBL_HW_ERROR)

    it "accepts unrelated register bits without weakening required masks":
        expect(status(
            COSMOS_FSBL_SLCR_LOCKED | 0x80000000u32,
            COSMOS_FSBL_ARM_CLK_ACTIVE | 0x00000001u32,
            COSMOS_FSBL_DDR_CLK_ACTIVE | 0x80000000u32,
            0x80000000u32,
            0x80000000u32,
            COSMOS_FSBL_PCFG_DONE | 0x80000000u32
        )).to_equal(COSMOS_FSBL_OK)

    it "keeps the production self-test fail-closed and successful":
        expect(cosmos_fsbl_selftest()).to_equal(COSMOS_FSBL_OK)

    it "fails self-test for either offset or either inverted policy result":
        expect(cosmos_fsbl_selftest_result(
            0u32, 0x0124u32, COSMOS_FSBL_OK, COSMOS_FSBL_HW_ERROR
        )).to_equal(COSMOS_FSBL_INVALID)
        expect(cosmos_fsbl_selftest_result(
            0x0120u32, 0u32, COSMOS_FSBL_OK, COSMOS_FSBL_HW_ERROR
        )).to_equal(COSMOS_FSBL_INVALID)
        expect(cosmos_fsbl_selftest_result(
            0x0120u32, 0x0124u32, COSMOS_FSBL_HW_ERROR, COSMOS_FSBL_HW_ERROR
        )).to_equal(COSMOS_FSBL_INVALID)
        expect(cosmos_fsbl_selftest_result(
            0x0120u32, 0x0124u32, COSMOS_FSBL_OK, COSMOS_FSBL_OK
        )).to_equal(COSMOS_FSBL_INVALID)
