"""Pure-Simple Cosmos+ Tiger4NSC NFC policy and state decisions."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_nfc_policy.{
    COSMOS_NFC_POLICY_OK,
    COSMOS_NFC_POLICY_UNAVAILABLE,
    COSMOS_NFC_POLICY_INVALID,
    COSMOS_NFC_POLICY_TIMEOUT,
    COSMOS_NFC_POLICY_HW_ERROR,
    COSMOS_NFC_POLICY_RETRY,
    COSMOS_NFC_POLICY_CHANNEL0_BASE,
    COSMOS_NFC_POLICY_ROWS_PER_LUN,
    COSMOS_NFC_POLICY_LUN1_BASE_ROW,
    COSMOS_NFC_POLICY_TRANSFER_COMPLETE,
    cosmos_nfc_policy_channel_base,
    cosmos_nfc_policy_row_valid,
    cosmos_nfc_policy_target_valid,
    cosmos_nfc_policy_erase_row_valid,
    cosmos_nfc_policy_dma_range_valid,
    cosmos_nfc_policy_data_valid,
    cosmos_nfc_policy_raw_data_valid,
    cosmos_nfc_policy_spare_valid,
    cosmos_nfc_policy_completion_valid,
    cosmos_nfc_policy_status_report_valid,
    cosmos_nfc_policy_error_info_valid,
    cosmos_nfc_policy_toggle_valid,
    cosmos_nfc_policy_ranges_overlap,
    cosmos_nfc_policy_dma_reserve_args_valid,
    cosmos_nfc_policy_dma_finish_releases,
    cosmos_nfc_policy_channel_result_faults,
    cosmos_nfc_policy_nand_status,
    cosmos_nfc_policy_decode_status,
    cosmos_nfc_policy_io_valid,
    cosmos_nfc_policy_raw_io_valid,
    cosmos_nfc_policy_initialized_status,
    cosmos_nfc_policy_contract_status,
    cosmos_nfc_policy_locked_channel_status,
    cosmos_nfc_policy_init_state_status,
    cosmos_nfc_policy_init_selftest_status,
    cosmos_nfc_policy_init_contract_status,
    cosmos_nfc_policy_raw_completion_status,
    cosmos_nfc_policy_toggle_payload_word,
    cosmos_nfc_policy_decision_manifest
}

describe "pure-Simple Cosmos NFC policy":
    it "pins channel, target, row, and erase policy":
        expect(cosmos_nfc_policy_channel_base(0u32)).to_equal(
            COSMOS_NFC_POLICY_CHANNEL0_BASE
        )
        expect(cosmos_nfc_policy_channel_base(7u32)).to_equal(0x43C70000u32)
        expect(cosmos_nfc_policy_row_valid(0u32)).to_equal(1)
        expect(cosmos_nfc_policy_row_valid(
            COSMOS_NFC_POLICY_ROWS_PER_LUN - 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_row_valid(
            COSMOS_NFC_POLICY_ROWS_PER_LUN
        )).to_equal(0)
        expect(cosmos_nfc_policy_row_valid(
            COSMOS_NFC_POLICY_LUN1_BASE_ROW
        )).to_equal(1)
        expect(cosmos_nfc_policy_target_valid(7u32, 7u32, 0u32)).to_equal(1)
        expect(cosmos_nfc_policy_target_valid(8u32, 7u32, 0u32)).to_equal(0)
        expect(cosmos_nfc_policy_target_valid(7u32, 8u32, 0u32)).to_equal(0)
        expect(cosmos_nfc_policy_erase_row_valid(0u32)).to_equal(1)
        expect(cosmos_nfc_policy_erase_row_valid(1u32)).to_equal(0)
        expect(cosmos_nfc_policy_erase_row_valid(
            COSMOS_NFC_POLICY_LUN1_BASE_ROW
        )).to_equal(1)

    it "fails closed on unbound, unaligned, empty, and escaping DMA ranges":
        expect(cosmos_nfc_policy_dma_range_valid(
            0x1000u32, 4u32, 0x1000u32, 0x10FFu32, 4u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_dma_range_valid(
            0x1000u32, 4u32, 0x1000u32, 0x10FFu32, 4u32, 0u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_range_valid(
            0x1002u32, 4u32, 0x1000u32, 0x10FFu32, 4u32, 1u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_range_valid(
            0x10FCu32, 5u32, 0x1000u32, 0x10FFu32, 4u32, 1u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_range_valid(
            0x1000u32, 0u32, 0x1000u32, 0x10FFu32, 4u32, 1u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_data_valid(0x10000000u32, 1u32)).to_equal(1)
        expect(cosmos_nfc_policy_data_valid(0x10000004u32, 1u32)).to_equal(0)
        expect(cosmos_nfc_policy_raw_data_valid(
            0x10000000u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_spare_valid(
            0x11100000u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_completion_valid(
            0x17000000u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_status_report_valid(
            0x17000100u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_error_info_valid(
            0x17000200u32, 1u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_toggle_valid(
            0x17000D00u32, 1u32
        )).to_equal(1)

    it "preserves half-open overlap and bounded DMA reservation semantics":
        expect(cosmos_nfc_policy_ranges_overlap(
            0u32, 8u32, 4u32, 8u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_ranges_overlap(
            4u32, 8u32, 0u32, 8u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_ranges_overlap(
            0u32, 4u32, 4u32, 4u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_reserve_args_valid(
            0u32, 1u32, 5u32
        )).to_equal(1)
        expect(cosmos_nfc_policy_dma_reserve_args_valid(
            8u32, 1u32, 1u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_reserve_args_valid(
            0u32, 0u32, 1u32
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_reserve_args_valid(
            0u32, 1u32, 6u32
        )).to_equal(0)

    it "quarantines timeout state and preserves NAND status decoding":
        expect(cosmos_nfc_policy_dma_finish_releases(
            COSMOS_NFC_POLICY_TIMEOUT
        )).to_equal(0)
        expect(cosmos_nfc_policy_dma_finish_releases(
            COSMOS_NFC_POLICY_HW_ERROR
        )).to_equal(1)
        expect(cosmos_nfc_policy_channel_result_faults(
            COSMOS_NFC_POLICY_TIMEOUT
        )).to_equal(1)
        expect(cosmos_nfc_policy_channel_result_faults(
            COSMOS_NFC_POLICY_HW_ERROR
        )).to_equal(0)
        expect(cosmos_nfc_policy_nand_status(0xC1u32)).to_equal(0x60u32)
        expect(cosmos_nfc_policy_decode_status(0xC0u32)).to_equal(
            COSMOS_NFC_POLICY_INVALID
        )
        expect(cosmos_nfc_policy_decode_status(0x81u32)).to_equal(
            COSMOS_NFC_POLICY_UNAVAILABLE
        )
        expect(cosmos_nfc_policy_decode_status(0xC1u32)).to_equal(
            COSMOS_NFC_POLICY_OK
        )
        expect(cosmos_nfc_policy_decode_status(0xC3u32)).to_equal(
            COSMOS_NFC_POLICY_HW_ERROR
        )

    it "owns normal and raw IO composition without pointer transport":
        expect(cosmos_nfc_policy_io_valid(
            1, 1, 1, 1, 0, 0, 0
        )).to_equal(1)
        expect(cosmos_nfc_policy_io_valid(
            1, 1, 1, 1, 1, 1, 1
        )).to_equal(1)
        expect(cosmos_nfc_policy_io_valid(
            1, 1, 1, 1, 1, 1, 0
        )).to_equal(0)
        expect(cosmos_nfc_policy_raw_io_valid(1, 1, 1, 1)).to_equal(1)
        expect(cosmos_nfc_policy_raw_io_valid(1, 1, 0, 1)).to_equal(0)

    it "preserves operation, init, completion, and toggle state outcomes":
        expect(cosmos_nfc_policy_initialized_status(0u32)).to_equal(
            COSMOS_NFC_POLICY_UNAVAILABLE
        )
        expect(cosmos_nfc_policy_initialized_status(1u32)).to_equal(
            COSMOS_NFC_POLICY_OK
        )
        expect(cosmos_nfc_policy_contract_status(
            COSMOS_NFC_POLICY_HW_ERROR
        )).to_equal(COSMOS_NFC_POLICY_UNAVAILABLE)
        expect(cosmos_nfc_policy_locked_channel_status(
            1u32, COSMOS_NFC_POLICY_OK
        )).to_equal(COSMOS_NFC_POLICY_HW_ERROR)
        expect(cosmos_nfc_policy_init_state_status(0u32, 0u32)).to_equal(
            COSMOS_NFC_POLICY_RETRY
        )
        expect(cosmos_nfc_policy_init_state_status(1u32, 1u32)).to_equal(
            COSMOS_NFC_POLICY_OK
        )
        expect(cosmos_nfc_policy_init_state_status(0u32, 1u32)).to_equal(
            COSMOS_NFC_POLICY_HW_ERROR
        )
        expect(cosmos_nfc_policy_init_selftest_status(
            COSMOS_NFC_POLICY_TIMEOUT
        )).to_equal(COSMOS_NFC_POLICY_INVALID)
        expect(cosmos_nfc_policy_init_contract_status(
            COSMOS_NFC_POLICY_UNAVAILABLE
        )).to_equal(COSMOS_NFC_POLICY_UNAVAILABLE)
        expect(cosmos_nfc_policy_raw_completion_status(
            COSMOS_NFC_POLICY_TRANSFER_COMPLETE
        )).to_equal(COSMOS_NFC_POLICY_OK)
        expect(cosmos_nfc_policy_raw_completion_status(0u32)).to_equal(
            COSMOS_NFC_POLICY_TIMEOUT
        )
        expect(cosmos_nfc_policy_raw_completion_status(1u32)).to_equal(
            COSMOS_NFC_POLICY_HW_ERROR
        )
        expect(cosmos_nfc_policy_toggle_payload_word(0u32)).to_equal(6u32)
        expect(cosmos_nfc_policy_toggle_payload_word(1u32)).to_equal(8u32)
        expect(cosmos_nfc_policy_toggle_payload_word(2u32)).to_equal(32u32)
        expect(cosmos_nfc_policy_toggle_payload_word(3u32)).to_equal(0u32)

    it "executes both outcomes of every named production decision":
        val manifest = cosmos_nfc_policy_decision_manifest()
        expect(manifest.manifest_id).to_equal("cosmos-nfc-pure-policy-v1")
        expect(manifest.decisions_total).to_equal(29)
        expect(manifest.decisions_hit).to_equal(manifest.decisions_total)
        for decision in manifest.decisions:
            expect(decision.true_count).to_be_greater_than(0)
            expect(decision.false_count).to_be_greater_than(0)
        print("COSMOS_NFC_SIMPLE_DECISIONS " +
            manifest.decisions_hit.to_text() + "/" +
            manifest.decisions_total.to_text())
