"""Focused scalar contracts for the Cosmos NVMe/media Pure Simple owner."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_nvme_media_policy.{
    cosmos_nvme_media_policy_status_success,
    cosmos_nvme_media_policy_status_invalid_namespace,
    cosmos_nvme_media_policy_status_lba_range,
    cosmos_nvme_media_policy_status_data_transfer,
    cosmos_nvme_media_policy_rw_status,
    cosmos_nvme_media_policy_zeroes_status,
    cosmos_nvme_media_policy_dsm_status,
    cosmos_nvme_media_policy_post_status,
    cosmos_nvme_media_policy_command_span_status,
    cosmos_nvme_media_policy_page_action,
    cosmos_nvme_media_policy_dsm_range_valid,
    cosmos_nvme_media_policy_deallocate_valid
}

describe "Cosmos Pure Simple NVMe/media policy":
    it "preserves namespace, range, and transfer status precedence":
        expect(cosmos_nvme_media_policy_rw_status(1u32, 2u32, 0u32, 0u32, 0u32, 0u32, 0x1000u32, 0u32, 0u32, 0u32, 4096u32, 16u32, 0u32, 4096u32)).to_equal(cosmos_nvme_media_policy_status_invalid_namespace())
        expect(cosmos_nvme_media_policy_rw_status(1u32, 1u32, 16u32, 0u32, 0u32, 0u32, 0x1000u32, 0u32, 0u32, 0u32, 4096u32, 16u32, 0u32, 4096u32)).to_equal(cosmos_nvme_media_policy_status_lba_range())
        expect(cosmos_nvme_media_policy_rw_status(1u32, 1u32, 0u32, 0u32, 0u32, 0u32, 1u32, 0u32, 0u32, 0u32, 4096u32, 16u32, 0u32, 4096u32)).to_equal(cosmos_nvme_media_policy_status_data_transfer())
        expect(cosmos_nvme_media_policy_rw_status(1u32, 1u32, 0u32, 0u32, 0u32, 0u32, 0x1000u32, 0u32, 0u32, 0u32, 4096u32, 16u32, 0u32, 4096u32)).to_equal(cosmos_nvme_media_policy_status_success())

    it "preserves callback and completion terminal behavior":
        expect(cosmos_nvme_media_policy_zeroes_status(0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 0u32, 16u32, 0u32, 0u32)).to_equal(0x00010001u32)
        expect(cosmos_nvme_media_policy_dsm_status(0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 0u32, 1u32, 0x1000u32, 0u32, 0u32, 0u32, 16u32, 0u32)).to_equal(cosmos_nvme_media_policy_status_success())
        expect(cosmos_nvme_media_policy_dsm_status(0u32, 1u32, 0u32, 0u32, 0u32, 0u32, 4u32, 1u32, 0x1000u32, 0u32, 0u32, 0u32, 16u32, 0u32)).to_equal(0x00010001u32)
        expect(cosmos_nvme_media_policy_post_status(0u32)).to_equal(0)
        expect(cosmos_nvme_media_policy_post_status(1u32)).to_equal(5)
        expect(cosmos_nvme_media_policy_post_status(2u32)).to_equal(6)
        expect(cosmos_nvme_media_policy_post_status(3u32)).to_equal(4)

    it "rejects media spans at count, tag, and 64-bit capacity edges":
        expect(cosmos_nvme_media_policy_command_span_status(1u32, 1u32, 1u32, 257u32 * 4096u32, 0u32, 0u32, 0u32, 1024u32, 0u32)).to_equal(2)
        expect(cosmos_nvme_media_policy_command_span_status(1u32, 1u32, 1u32, 4096u32, 128u32, 0u32, 0u32, 16u32, 0u32)).to_equal(2)
        expect(cosmos_nvme_media_policy_command_span_status(1u32, 1u32, 1u32, 4096u32, 0u32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32)).to_equal(2)
        expect(cosmos_nvme_media_policy_command_span_status(1u32, 1u32, 1u32, 4096u32, 0u32, 15u32, 0u32, 16u32, 0u32)).to_equal(0)

    it "preserves page-transition and deallocate validation edges":
        expect(cosmos_nvme_media_policy_page_action(-1, 0u32, 0u32, 1u32)).to_equal(3u32)
        expect(cosmos_nvme_media_policy_page_action(4, 0u32, 0u32, 1u32)).to_equal(3u32)
        expect(cosmos_nvme_media_policy_page_action(0, 1u32, 0u32, 4u32)).to_equal(0u32)
        expect(cosmos_nvme_media_policy_page_action(0, 0u32, 1u32, 1u32)).to_equal(1u32)
        expect(cosmos_nvme_media_policy_page_action(1, 0u32, 1u32, 1u32)).to_equal(2u32)
        expect(cosmos_nvme_media_policy_dsm_range_valid(0u32, 1u32, 15u64, 16u32, 0u32)).to_equal(1)
        expect(cosmos_nvme_media_policy_dsm_range_valid(0u32, 2u32, 15u64, 16u32, 0u32)).to_equal(0)
        expect(cosmos_nvme_media_policy_deallocate_valid(1u32, 1u32, 1u32, 4u32, 1u32, 16u32, 0u32)).to_equal(1)
        expect(cosmos_nvme_media_policy_deallocate_valid(1u32, 1u32, 1u32, 4u32, 1u32, 15u32, 0u32)).to_equal(0)
