"""Pure-Simple Cosmos boot/UART orchestration policy."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_boot_policy.*

describe "Cosmos pure-Simple boot policy":
    it "keeps boot admission and platform verdicts fail closed":
        expect(cosmos_boot_policy_software_ready(0, 0, 0, 1)).to_equal(1)
        expect(cosmos_boot_policy_software_ready(0, 1, 0, 1)).to_equal(0)
        expect(cosmos_boot_policy_handoff_allows_devices(1, 1, 1)).to_equal(1)
        expect(cosmos_boot_policy_handoff_allows_devices(0, 1, 1)).to_equal(0)
        expect(cosmos_boot_policy_terminal_verdict(
            1, 1, 1, 1, 1, 1, 1)).to_equal(COSMOS_BOOT_VERDICT_SOFTWARE)
        expect(cosmos_boot_policy_terminal_verdict(
            0, 1, 0, 0, 0, 0, 0)).to_equal(COSMOS_BOOT_VERDICT_SILICON)
        expect(cosmos_boot_policy_terminal_verdict(
            0, 1, 0, 0, 0, 1, 0)).to_equal(COSMOS_BOOT_VERDICT_FAIL)

    it "owns UART, exception, IRQ, and storage state decisions":
        expect(cosmos_boot_policy_uart_should_attempt(3u32, 2u32)).to_equal(1)
        expect(cosmos_boot_policy_uart_next_enabled(3u32, 2u32, 3)).to_equal(1u32)
        expect(cosmos_boot_policy_exception_should_capture(0x434C4541u32)).to_equal(1)
        expect(cosmos_boot_policy_exception_message_kind(1u32)).to_equal(
            COSMOS_BOOT_EXCEPTION_PREFETCH)
        expect(cosmos_boot_policy_irq_enable_allowed(0)).to_equal(1)
        expect(cosmos_boot_policy_storage_poll_action(5)).to_equal(
            COSMOS_BOOT_POLL_CONTINUE)
        expect(cosmos_boot_policy_storage_poll_action(4)).to_equal(
            COSMOS_BOOT_POLL_FAIL)
