"""Pure-Simple Cosmos+ Tiger4NSC ECC decode policy."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_nfc_ecc.{
    COSMOS_NFC_ECC_OK,
    COSMOS_NFC_ECC_HW_ERROR,
    COSMOS_NFC_ECC_CRC_VALID,
    COSMOS_NFC_ECC_SPARE_VALID,
    COSMOS_NFC_ECC_WORST_SHIFT,
    COSMOS_NFC_ECC_WARNING_THRESHOLD,
    COSMOS_NFC_ECC_PAGE_VALID,
    cosmos_nfc_ecc_policy_crc_valid,
    cosmos_nfc_ecc_policy_spare_valid,
    cosmos_nfc_ecc_policy_page_valid,
    cosmos_nfc_ecc_worst_chunk_errors,
    cosmos_nfc_ecc_policy_needs_refresh,
    cosmos_nfc_ecc_policy_status,
    cosmos_nfc_ecc_policy_decision_manifest
}

fn first_word(errors: u32) -> u32:
    COSMOS_NFC_ECC_CRC_VALID | COSMOS_NFC_ECC_SPARE_VALID |
        (errors << COSMOS_NFC_ECC_WORST_SHIFT)

describe "pure-Simple Cosmos NFC ECC policy":
    it "pins the legacy C status and Tiger4NSC bit contract":
        expect(COSMOS_NFC_ECC_OK).to_equal(0)
        expect(COSMOS_NFC_ECC_HW_ERROR).to_equal(4)
        expect(COSMOS_NFC_ECC_CRC_VALID).to_equal(0x10000000u32)
        expect(COSMOS_NFC_ECC_SPARE_VALID).to_equal(0x01000000u32)
        expect(COSMOS_NFC_ECC_WARNING_THRESHOLD).to_equal(20u32)
        expect(COSMOS_NFC_ECC_PAGE_VALID).to_equal(0xFFFFFFFFu32)

    it "decodes every possible worst-chunk count without leakage":
        var errors: u32 = 0u32
        while errors < 256u32:
            val first = first_word(errors) | 0x80008001u32
            expect(cosmos_nfc_ecc_worst_chunk_errors(first)).to_equal(errors)
            errors = errors + 1u32

    it "preserves exact validity and fail-closed status semantics":
        val valid = first_word(0u32)
        expect(cosmos_nfc_ecc_policy_crc_valid(valid)).to_equal(1u32)
        expect(cosmos_nfc_ecc_policy_spare_valid(valid)).to_equal(1u32)
        expect(cosmos_nfc_ecc_policy_page_valid(
            COSMOS_NFC_ECC_PAGE_VALID
        )).to_equal(1u32)
        expect(cosmos_nfc_ecc_policy_status(
            valid, COSMOS_NFC_ECC_PAGE_VALID
        )).to_equal(COSMOS_NFC_ECC_OK)
        expect(cosmos_nfc_ecc_policy_status(
            valid & ~COSMOS_NFC_ECC_CRC_VALID,
            COSMOS_NFC_ECC_PAGE_VALID
        )).to_equal(COSMOS_NFC_ECC_HW_ERROR)
        expect(cosmos_nfc_ecc_policy_status(
            valid & ~COSMOS_NFC_ECC_SPARE_VALID,
            COSMOS_NFC_ECC_PAGE_VALID
        )).to_equal(COSMOS_NFC_ECC_HW_ERROR)
        expect(cosmos_nfc_ecc_policy_status(
            valid, COSMOS_NFC_ECC_PAGE_VALID - 1u32
        )).to_equal(COSMOS_NFC_ECC_HW_ERROR)

    it "refreshes strictly above the legacy threshold":
        expect(cosmos_nfc_ecc_policy_needs_refresh(
            first_word(19u32)
        )).to_equal(0u32)
        expect(cosmos_nfc_ecc_policy_needs_refresh(
            first_word(20u32)
        )).to_equal(0u32)
        expect(cosmos_nfc_ecc_policy_needs_refresh(
            first_word(21u32)
        )).to_equal(1u32)
        expect(cosmos_nfc_ecc_policy_needs_refresh(
            first_word(255u32)
        )).to_equal(1u32)

    it "emits owner-derived outcomes for every policy decision":
        val manifest = cosmos_nfc_ecc_policy_decision_manifest()
        expect(manifest.manifest_id).to_equal(
            "cosmos-nfc-ecc-pure-policy-v1"
        )
        expect(manifest.decisions_total).to_equal(5)
        expect(manifest.decisions_hit).to_equal(manifest.decisions_total)
        for decision in manifest.decisions:
            expect(decision.true_count).to_be_greater_than(0)
            expect(decision.false_count).to_be_greater_than(0)
        print("COSMOS_NFC_ECC_SIMPLE_DECISIONS " +
            manifest.decisions_hit.to_text() + "/" +
            manifest.decisions_total.to_text())
