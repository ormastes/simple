"""Pure-Simple Cosmos PCIe/NVMe queue/status policy."""

use std.spec.{describe, it, expect}
use os.kernel.arch.arm32.cosmos.cosmos_nvme_pcie_policy.{
    cosmos_nvme_pcie_status_fields_valid,
    cosmos_nvme_pcie_status_word_value,
    cosmos_nvme_pcie_queue_base_valid,
    cosmos_nvme_pcie_io_sq_valid,
    cosmos_nvme_pcie_io_sq_word1,
    cosmos_nvme_pcie_io_cq_valid,
    cosmos_nvme_pcie_io_cq_word1,
    cosmos_nvme_pcie_policy_decision_manifest
}

describe "Cosmos pure-Simple NVMe PCIe policy":
    it "encodes the exact NVMe completion status word":
        expect(cosmos_nvme_pcie_status_fields_valid(2u32, 0x81u32, 1u32)).to_be(true)
        expect(cosmos_nvme_pcie_status_word_value(2u32, 0x81u32, 1u32)).to_equal(0x8502u32)
        expect(cosmos_nvme_pcie_status_fields_valid(8u32, 0u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_status_fields_valid(0u32, 256u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_status_fields_valid(0u32, 0u32, 2u32)).to_be(false)

    it "accepts only complete enabled or empty disabled queue bases":
        expect(cosmos_nvme_pcie_queue_base_valid(1u32, 256u32, 0x1000u32, 15u32)).to_be(true)
        expect(cosmos_nvme_pcie_queue_base_valid(0u32, 0u32, 0u32, 0u32)).to_be(true)
        expect(cosmos_nvme_pcie_queue_base_valid(0u32, 1u32, 0u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_queue_base_valid(1u32, 257u32, 0x1000u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_queue_base_valid(1u32, 1u32, 0x1004u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_queue_base_valid(1u32, 1u32, 0x1000u32, 16u32)).to_be(false)

    it "derives exact SQ and CQ control words":
        expect(cosmos_nvme_pcie_io_sq_valid(1u32, 1u32, 2u32, 64u32, 0x12345000u32, 10u32)).to_be(true)
        expect(cosmos_nvme_pcie_io_sq_word1(1u32, 2u32, 64u32, 10u32)).to_equal(0x3F02800Au32)
        expect(cosmos_nvme_pcie_io_cq_valid(1u32, 1u32, 1u32, 0u32, 64u32, 0x12345000u32, 10u32)).to_be(true)
        expect(cosmos_nvme_pcie_io_cq_word1(1u32, 1u32, 0u32, 64u32, 10u32)).to_equal(0x3F08800Au32)

    it "fails closed on queue identity and binding errors":
        expect(cosmos_nvme_pcie_io_sq_valid(0u32, 1u32, 1u32, 1u32, 0x1000u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_io_sq_valid(1u32, 1u32, 0u32, 1u32, 0x1000u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_io_sq_valid(1u32, 0u32, 1u32, 0u32, 0u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_io_cq_valid(9u32, 1u32, 1u32, 0u32, 1u32, 0x1000u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_io_cq_valid(1u32, 0u32, 1u32, 0u32, 0u32, 0u32, 0u32)).to_be(false)
        expect(cosmos_nvme_pcie_io_cq_valid(1u32, 1u32, 1u32, 8u32, 1u32, 0x1000u32, 0u32)).to_be(false)

    it "emits owner-derived outcomes for every policy predicate":
        val manifest = cosmos_nvme_pcie_policy_decision_manifest()
        expect(manifest.manifest_id).to_equal("cosmos-nvme-pcie-queue-policy-v1")
        expect(manifest.decisions_total).to_equal(15)
        expect(manifest.decisions_hit).to_equal(manifest.decisions_total)
        for decision in manifest.decisions:
            expect(decision.true_count).to_be_greater_than(0)
            expect(decision.false_count).to_be_greater_than(0)
        print("COSMOS_NVME_PCIE_SIMPLE_DECISIONS " + manifest.decisions_hit.to_text() + "/" + manifest.decisions_total.to_text())
