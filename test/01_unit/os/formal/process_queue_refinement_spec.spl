use std.spec
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.flight_rules.{assurance_text_hash}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{ProofReceiptV1}
use compiler.common.assurance.replay_receipt.{ReplayCheckerClassV1,
    ReplayOutcomeV1, ReplayCheckerReceiptV1, close_independent_replay_v1}
use verification.simpleos_process_queue_refinement.{PROCESS_QUEUE_CASE_COUNT_V1,
    process_queue_cache_key_v1, validate_simpleos_process_queue_refinement_v1,
    promote_simpleos_process_queue_refinement_v2}

fn queue_axiom_report() -> text:
    "'ActorChannel.ProcessQueueExact.process_queue_refinement_bundle' depends on axioms: [propext, Quot.sound]"

fn queue_checker(class_: ReplayCheckerClassV1) -> ReplayCheckerReceiptV1:
    ReplayCheckerReceiptV1("ReplayCheckerReceipt-v1", class_,
        if class_ == ReplayCheckerClassV1.FreshLeanKernel: "leanchecker" else: "nanoda",
        "pinned", sha256_text(if class_ == ReplayCheckerClassV1.FreshLeanKernel: "fresh-lean-binary" else: "independent-kernel-binary"), "ProcessQueueExact", "ActorChannel.ProcessQueueExact.process_queue_refinement_bundle", sha256_text("queue-olean"), sha256_text("policy"),
        sha256_text("output"), ReplayOutcomeV1.Accepted, "")

describe "FV2 SimpleOS process queue refinement":
    it "executes FIFO handle backpressure close EOF and stale generation cases":
        val receipt = validate_simpleos_process_queue_refinement_v1(
            queue_axiom_report())
        expect(receipt.diagnostic).to_equal("")
        expect(receipt.checked_case_count).to_equal(PROCESS_QUEUE_CASE_COUNT_V1)
        expect(receipt.counterexample_count).to_equal(0)
        expect(receipt.killed_mutant_count).to_equal(4)
        expect(receipt.status).to_equal(FormalStatus.ModelProven)
        expect(receipt.permits_model_evidence(process_queue_cache_key_v1())).to_be(true)
        expect(receipt.permits_source_refinement(process_queue_cache_key_v1())).to_be(false)

    it "requires exact proof semantic dependencies and replay for promotion":
        val model = validate_simpleos_process_queue_refinement_v1(
            queue_axiom_report())
        val replay = close_independent_replay_v1(
            queue_checker(ReplayCheckerClassV1.FreshLeanKernel),
            queue_checker(ReplayCheckerClassV1.IndependentKernel))
        var proof = ProofReceiptV1(model.theorem_root, FormalStatus.ModelProven,
            "cache", sha256_text("queue-olean"), [
                "fv2-simpleos-source-semantics:" + model.source_semantics_hash,
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash],
            assurance_text_hash(queue_axiom_report()), model.trust_manifest_hash,
            "", replay.hash())
        val promoted = promote_simpleos_process_queue_refinement_v2(
            model, proof, replay)
        expect(promoted.status).to_equal(FormalStatus.SourceRefined)
        expect(promoted.permits_source_refinement(
            process_queue_cache_key_v1())).to_be(true)
        expect(promoted.status.permits_verified_release()).to_be(false)
        proof.theorem_dependencies = []
        expect(promote_simpleos_process_queue_refinement_v2(
            model, proof, replay).status).to_equal(FormalStatus.Failed)

    it "rejects an incomplete root audit":
        val receipt = validate_simpleos_process_queue_refinement_v1("")
        expect(receipt.status).to_equal(FormalStatus.Failed)
        expect(receipt.diagnostic).to_contain("AUDIT")
