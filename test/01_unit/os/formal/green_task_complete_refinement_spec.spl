use std.spec
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.flight_rules.{assurance_text_hash}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{ProofReceiptV1}
use compiler.common.assurance.replay_receipt.{ReplayCheckerClassV1,
    ReplayOutcomeV1, ReplayCheckerReceiptV1, close_independent_replay_v1}
use verification.simpleos_green_task_complete_refinement.{
    GREEN_TASK_COMPLETE_CASE_COUNT_V1,
    green_task_complete_verification_cache_key_v1,
    validate_simpleos_green_task_complete_refinement_v1,
    promote_simpleos_green_task_complete_refinement_v2}

fn scheduler_axiom_report() -> text:
    "'KernelScheduler.complete_refinement_bundle' depends on axioms: [propext]"

fn scheduler_checker(class_: ReplayCheckerClassV1) -> ReplayCheckerReceiptV1:
    ReplayCheckerReceiptV1("ReplayCheckerReceipt-v1", class_,
        if class_ == ReplayCheckerClassV1.FreshLeanKernel: "leanchecker" else: "nanoda",
        "pinned", sha256_text(if class_ == ReplayCheckerClassV1.FreshLeanKernel: "fresh-lean-binary" else: "independent-kernel-binary"), "KernelScheduler", "KernelScheduler.complete_refinement_bundle", sha256_text("scheduler-olean"), sha256_text("policy"),
        sha256_text("output"), ReplayOutcomeV1.Accepted, "")

describe "FV2 SimpleOS green-task completion refinement":
    it "executes every lifecycle class and boundary result sample":
        val receipt = validate_simpleos_green_task_complete_refinement_v1(
            scheduler_axiom_report())
        expect(receipt.diagnostic).to_equal("")
        expect(receipt.checked_case_count).to_equal(
            GREEN_TASK_COMPLETE_CASE_COUNT_V1)
        expect(receipt.counterexample_count).to_equal(0)
        expect(receipt.status).to_equal(FormalStatus.ModelProven)
        expect(receipt.permits_model_evidence(
            green_task_complete_verification_cache_key_v1())).to_be(true)
        expect(receipt.permits_source_refinement(
            green_task_complete_verification_cache_key_v1())).to_be(false)
        expect(receipt.status.permits_verified_release()).to_be(false)

    it "kills stale-park-metadata and overwrite-on-double-complete mutants":
        val receipt = validate_simpleos_green_task_complete_refinement_v1(
            scheduler_axiom_report())
        expect(receipt.preserve_reason_mutant_counterexamples).to_be_greater_than(0)
        expect(receipt.overwrite_done_mutant_counterexamples).to_be_greater_than(0)

    it "promotes only the composite theorem with exact replay and semantic dependencies":
        val model = validate_simpleos_green_task_complete_refinement_v1(
            scheduler_axiom_report())
        val replay = close_independent_replay_v1(
            scheduler_checker(ReplayCheckerClassV1.FreshLeanKernel),
            scheduler_checker(ReplayCheckerClassV1.IndependentKernel))
        var proof = ProofReceiptV1(model.theorem_roots[0],
            FormalStatus.ModelProven, "cache", sha256_text("scheduler-olean"), [
                "fv2-simpleos-source-semantics:" + model.source_semantics_hash,
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash],
            assurance_text_hash(scheduler_axiom_report()),
            model.trust_manifest_hash, "", replay.hash())
        val promoted = promote_simpleos_green_task_complete_refinement_v2(
            model, proof, replay)
        expect(promoted.status).to_equal(FormalStatus.SourceRefined)
        expect(promoted.permits_source_refinement(
            green_task_complete_verification_cache_key_v1())).to_be(true)
        proof.theorem_dependencies = []
        val detached = promote_simpleos_green_task_complete_refinement_v2(
            model, proof, replay)
        expect(detached.status).to_equal(FormalStatus.Failed)
        expect(detached.diagnostic).to_contain("DEPENDENCY")

    it "requires every exact theorem root":
        val missing = validate_simpleos_green_task_complete_refinement_v1(
            "'KernelScheduler.complete_marks_done' depends on axioms: [propext]")
        expect(missing.status).to_equal(FormalStatus.Failed)
        expect(missing.diagnostic).to_contain("AUDIT")

    it "rejects stale contract identity reuse":
        val receipt = validate_simpleos_green_task_complete_refinement_v1(
            scheduler_axiom_report())
        val stale = green_task_complete_verification_cache_key_v1()
        stale.contract_hash = "stale"
        expect(receipt.permits_model_evidence(stale)).to_be(false)
