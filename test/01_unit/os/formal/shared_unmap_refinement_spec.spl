use std.spec
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.flight_rules.{assurance_text_hash}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{ProofReceiptV1}
use compiler.common.assurance.replay_receipt.{ReplayCheckerClassV1,
    ReplayOutcomeV1, ReplayCheckerReceiptV1, close_independent_replay_v1}
use verification.simpleos_shared_unmap_refinement.{SHARED_UNMAP_CASE_COUNT_V1,
    shared_unmap_cache_key_v1, validate_simpleos_shared_unmap_refinement_v1,
    promote_simpleos_shared_unmap_refinement_v2}

fn shared_unmap_axiom_report() -> text:
    "'MemoryCapabilities.SharedUnmapExact.shared_unmap_refinement_bundle' depends on axioms: [propext]"

fn unmap_checker(class_: ReplayCheckerClassV1) -> ReplayCheckerReceiptV1:
    ReplayCheckerReceiptV1("ReplayCheckerReceipt-v1", class_,
        if class_ == ReplayCheckerClassV1.FreshLeanKernel: "leanchecker" else: "nanoda",
        "pinned", sha256_text(if class_ == ReplayCheckerClassV1.FreshLeanKernel: "fresh-lean-binary" else: "independent-kernel-binary"), "MemoryCapabilities", "MemoryCapabilities.SharedUnmapExact.shared_unmap_refinement_bundle", sha256_text("unmap-olean"), sha256_text("policy"),
        sha256_text("output"), ReplayOutcomeV1.Accepted, "")

describe "FV2 SimpleOS shared-memory unmap refinement":
    it "executes survivor last-dirty repeated and private unmap cases":
        val receipt = validate_simpleos_shared_unmap_refinement_v1(shared_unmap_axiom_report())
        expect(receipt.diagnostic).to_equal("")
        expect(receipt.checked_case_count).to_equal(SHARED_UNMAP_CASE_COUNT_V1)
        expect(receipt.counterexample_count).to_equal(0)
        expect(receipt.killed_mutant_count).to_equal(4)
        expect(receipt.status).to_equal(FormalStatus.ModelProven)
        expect(receipt.permits_model_evidence(shared_unmap_cache_key_v1())).to_be(true)
        expect(receipt.permits_source_refinement(shared_unmap_cache_key_v1())).to_be(false)

    it "requires every exact shared-unmap theorem root":
        val receipt = validate_simpleos_shared_unmap_refinement_v1(
            "'MemoryCapabilities.SharedUnmapExact.repeated_unmap_is_noop' depends on axioms: [propext]")
        expect(receipt.status).to_equal(FormalStatus.Failed)
        expect(receipt.diagnostic).to_contain("AUDIT")

    it "requires exact typed unmap proof and replay for source promotion":
        val model = validate_simpleos_shared_unmap_refinement_v1(
            shared_unmap_axiom_report())
        val replay = close_independent_replay_v1(
            unmap_checker(ReplayCheckerClassV1.FreshLeanKernel),
            unmap_checker(ReplayCheckerClassV1.IndependentKernel))
        var proof = ProofReceiptV1(model.theorem_roots[0],
            FormalStatus.ModelProven, "cache", sha256_text("unmap-olean"), [
                "fv2-simpleos-source-semantics:" + model.semantic_hash,
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash],
            assurance_text_hash(shared_unmap_axiom_report()),
            model.trust_manifest_hash, "", replay.hash())
        val promoted = promote_simpleos_shared_unmap_refinement_v2(
            model, proof, replay)
        expect(promoted.status).to_equal(FormalStatus.SourceRefined)
        expect(promoted.permits_source_refinement(
            shared_unmap_cache_key_v1())).to_be(true)
        proof.theorem_dependencies = []
        val detached = promote_simpleos_shared_unmap_refinement_v2(
            model, proof, replay)
        expect(detached.status).to_equal(FormalStatus.Failed)
        expect(detached.diagnostic).to_contain("DEPENDENCY")

    it "keeps bounded unmap evidence below artifact verification":
        val receipt = validate_simpleos_shared_unmap_refinement_v1(shared_unmap_axiom_report())
        expect(receipt.symbol_id).to_contain("@bounded-one-page-v1")
        expect(receipt.status.permits_verified_release()).to_be(false)
