use std.spec
use compiler.common.assurance.formal_status.{FormalStatus}
use compiler.common.assurance.flight_rules.{assurance_text_hash}
use std.common.crypto.sha256.{sha256_text}
use compiler.common.assurance.formal_receipt.{ProofReceiptV1}
use compiler.common.assurance.replay_receipt.{ReplayCheckerClassV1,
    ReplayOutcomeV1, ReplayCheckerReceiptV1, close_independent_replay_v1}
use verification.simpleos_process_wait_refinement.{PROCESS_WAIT_CASE_COUNT_V1,
    process_wait_cache_key_v1, validate_simpleos_process_wait_refinement_v1,
    promote_simpleos_process_wait_refinement_v2}

fn process_axiom_report() -> text:
    "'ProcessLifecycle.ProcessWaitExact.process_wait_refinement_bundle' depends on axioms: [propext]"

fn process_checker(class_: ReplayCheckerClassV1) -> ReplayCheckerReceiptV1:
    ReplayCheckerReceiptV1("ReplayCheckerReceipt-v1", class_,
        if class_ == ReplayCheckerClassV1.FreshLeanKernel: "leanchecker" else: "nanoda",
        "pinned", sha256_text(if class_ == ReplayCheckerClassV1.FreshLeanKernel: "fresh-lean-binary" else: "independent-kernel-binary"), "ProcessWaitExact", "ProcessLifecycle.ProcessWaitExact.process_wait_refinement_bundle", sha256_text("process-olean"), sha256_text("policy"),
        sha256_text("output"), ReplayOutcomeV1.Accepted, "")

describe "FV2 SimpleOS process wait/exit/collect refinement":
    it "executes live wait zombie publication collection and double-collect rejection":
        val receipt = validate_simpleos_process_wait_refinement_v1(
            process_axiom_report())
        expect(receipt.diagnostic).to_equal("")
        expect(receipt.checked_case_count).to_equal(PROCESS_WAIT_CASE_COUNT_V1)
        expect(receipt.counterexample_count).to_equal(0)
        expect(receipt.killed_mutant_count).to_equal(4)
        expect(receipt.status).to_equal(FormalStatus.ModelProven)
        expect(receipt.permits_model_evidence(process_wait_cache_key_v1())).to_be(true)
        expect(receipt.permits_source_refinement(process_wait_cache_key_v1())).to_be(false)

    it "requires exact typed proof semantic bindings and replay for promotion":
        val model = validate_simpleos_process_wait_refinement_v1(
            process_axiom_report())
        val replay = close_independent_replay_v1(
            process_checker(ReplayCheckerClassV1.FreshLeanKernel),
            process_checker(ReplayCheckerClassV1.IndependentKernel))
        var proof = ProofReceiptV1(model.theorem_root, FormalStatus.ModelProven,
            "cache", sha256_text("process-olean"), [
                "fv2-simpleos-source-semantics:" + model.source_semantics_hash,
                "fv2-simpleos-model-semantics:" + model.model_semantics_hash],
            assurance_text_hash(process_axiom_report()),
            model.trust_manifest_hash, "", replay.hash())
        val promoted = promote_simpleos_process_wait_refinement_v2(
            model, proof, replay)
        expect(promoted.status).to_equal(FormalStatus.SourceRefined)
        expect(promoted.permits_source_refinement(
            process_wait_cache_key_v1())).to_be(true)
        expect(promoted.status.permits_verified_release()).to_be(false)
        proof.theorem_dependencies = []
        val detached = promote_simpleos_process_wait_refinement_v2(
            model, proof, replay)
        expect(detached.status).to_equal(FormalStatus.Failed)
        expect(detached.diagnostic).to_contain("DEPENDENCY")

    it "rejects a different lifecycle theorem root":
        val receipt = validate_simpleos_process_wait_refinement_v1(
            "'ProcessLifecycle.wait_returns_only_exited' depends on axioms: [propext]")
        expect(receipt.status).to_equal(FormalStatus.Failed)
        expect(receipt.diagnostic).to_contain("AUDIT")
