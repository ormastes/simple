use std.spec.{describe, it, expect}
use os.kernel.ipc.cspace_spawn.{CapGrant, atten_identity}
use os.kernel.types.capability_types.{CapabilityKind}
use os.security.llm_profiles.profile_registry.{LlmProfile, LLM_RIGHT_FS_READ, LLM_RIGHT_FS_WRITE, LLM_RIGHT_PROCESS_SPAWN}
use os.security.llm_profiles.agent_workload_policy.{AgentPolicySpec, compile_agent_policy}
use os.services.workload.workload_manifest.{
    WorkloadIdentitySpec, ImageSpec, AuthorityRequest, IsolationSpec,
    ResourceBudget, LifecyclePolicy, ObservabilityPolicy, WorkloadManifest
}

fn _profile(rights: i64, read_roots: [text], write_roots: [text]) -> LlmProfile:
    LlmProfile(
        name: "agent", version: 1, rights: rights,
        fs_read_roots: read_roots, fs_write_roots: write_roots, fs_exec_roots: [],
        net_hosts: [], secrets_labels: [], max_cpu_pct: 100, max_mem_mb: 1024,
        max_wallclock_sec: 600, max_cost_cents: 100, max_tokens: 1000
    )

fn _workload(grants: [CapGrant]) -> WorkloadManifest:
    WorkloadManifest(
        identity: WorkloadIdentitySpec(
            principal_id: "agent:1", tenant_id: "tenant", image_hash: "blake3:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            signer: "test", parent_principal: "session:1", expires_at_ms: 1000u64
        ),
        image: ImageSpec(executable_path: "/workspace/agent.smf", content_hash: "blake3:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", signer: "test"),
        authority: AuthorityRequest(grants: grants),
        isolation: IsolationSpec(filesystem_view: "/workspace", process_view: "private", ipc_view: "private", network_view: "none", syscall_allowlist: [4u64]),
        resources: ResourceBudget(cpu_weight: 1u64, memory_pages: 1u64, process_limit: 1u64, io_weight: 1u64, network_bytes: 0u64, wall_time_ms: 1000u64),
        lifecycle: LifecyclePolicy(restart_policy: "never", max_restarts: 0u64, watchdog_timeout_ms: 0u64),
        observability: ObservabilityPolicy(audit_required: true, log_retention_ms: 1000u64)
    )

fn _spec(profile: LlmProfile, grants: [CapGrant]) -> AgentPolicySpec:
    AgentPolicySpec(workload: _workload(grants), profile: profile, allowed_child_depth: 1u64, model_token_budget: 100u64, tool_call_budget: 10u64, approval_policy: "human")

describe "agent workload policy compiler":
    it "compiles a workspace-bounded profile into the shared workload policy":
        val grant = CapGrant(label: "workspace.read", requested: CapabilityKind.FileRead(path_prefix: "/workspace/src"), atten: atten_identity())
        val result = compile_agent_policy(_spec(_profile(LLM_RIGHT_FS_READ, ["/workspace"], []), [grant]))
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap().execution.spawn_spec.grants.len()).to_equal(1)

    it "rejects a grant outside the effective profile roots":
        val grant = CapGrant(label: "etc.read", requested: CapabilityKind.FileRead(path_prefix: "/etc"), atten: atten_identity())
        val result = compile_agent_policy(_spec(_profile(LLM_RIGHT_FS_READ, ["/workspace"], []), [grant]))
        expect(result.is_err()).to_equal(true)

    it "rejects write authority absent from the effective profile":
        val grant = CapGrant(label: "workspace.write", requested: CapabilityKind.FileWrite(path_prefix: "/workspace/src"), atten: atten_identity())
        val result = compile_agent_policy(_spec(_profile(LLM_RIGHT_FS_READ, ["/workspace"], []), [grant]))
        expect(result.is_err()).to_equal(true)

    it "admits write authority only when the profile grants that same root":
        val grant = CapGrant(label: "workspace.write", requested: CapabilityKind.FileWrite(path_prefix: "/workspace/src"), atten: atten_identity())
        val result = compile_agent_policy(_spec(_profile(LLM_RIGHT_FS_READ | LLM_RIGHT_FS_WRITE, ["/workspace"], ["/workspace"]), [grant]))
        expect(result.is_ok()).to_equal(true)

    it "compiles declared child depth into the ProcessSpawn capability":
        val grant = CapGrant(label: "subagent", requested: CapabilityKind.ProcessSpawn, atten: atten_identity())
        val result = compile_agent_policy(_spec(_profile(LLM_RIGHT_PROCESS_SPAWN, [], []), [grant]))
        expect(result.is_ok()).to_equal(true)
        expect(result.unwrap().execution.spawn_spec.grants[0].atten.depth_limit).to_equal(1i64)
