"""
## Purpose and audience
Purpose: uses argv[0] as the default app identity
Audience: compiler and tooling engineers who maintain this spec

# Window Client Identity Specification

Verifies that window identity defaults to the launched binary path when
applications do not explicitly provide an app_id.
"""

# @req: REQ-OS-Wind-001

use std.spec
use os.userlib.window.{window_default_app_identity_from_args, WindowClient}

use std.spec.step
describe "Window client identity":
    it "uses argv[0] as the default app identity":
        step("Verify: uses argv[0] as the default app identity")
        # @req: REQ-OS-Wind-001
        val app_id = window_default_app_identity_from_args(["/sys/apps/hello_world"])
        expect(app_id).to_equal("/sys/apps/hello_world")

    it "returns empty identity when argv is missing":
        step("Verify: returns empty identity when argv is missing")
        # @req: REQ-OS-Wind-001
        expect(window_default_app_identity_from_args([])).to_equal("")
        expect(window_default_app_identity_from_args([""])).to_equal("")

describe "WindowClient primary window selection":
    it "starts without a primary window":
        step("Verify: starts without a primary window")
        # @req: REQ-OS-Wind-001
        val client = WindowClient.new()
        expect(client.get_window_id()).to_equal(0)  # oracle: value fixed by the spec contract

    it "updates the primary window used by convenience helpers":
        step("Verify: updates the primary window used by convenience helpers")
        # @req: REQ-OS-Wind-001
        var client = WindowClient.new()
        client.set_primary_window(42)
        expect(client.get_window_id()).to_equal(42)  # oracle: value fixed by the spec contract
        client.set_primary_window(9)
        expect(client.get_window_id()).to_equal(9)  # oracle: value fixed by the spec contract
