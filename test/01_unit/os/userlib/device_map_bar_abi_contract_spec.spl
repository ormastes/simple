use std.spec.{describe, it, expect}

describe "device map-bar user ABI":
    it "passes BDF, BAR index, and only an optional virtual hint":
        val source = file_read("src/os/userlib/device.spl")
        expect(source).to_contain("syscall(83, bdf, bar_index.to_u64(), 0, 0, 0)")
        expect(source).to_contain("syscall(83, bdf, bar_index.to_u64(), vaddr_hint, 0, 0)")

    it "does not retain the caller supplied physical-address ABI":
        val source = file_read("src/os/userlib/device.spl")
        expect(source).to_equal(source.replace("syscall(83, phys_addr, size", ""))
