"""Run supported named catalog scenarios through the sealed dispatch owner."""
use std.spec.{describe, it, expect, step}
use os.qemu_runner.{
    scenario_by_name_direct, scenario_sealed_run_supported_v1,
    run_scenario_sealed_v1
}

describe "Named catalog sealed dispatch":
    it "selects sealed execution for every represented named boot shape":
        # @req: REQ-001 REQ-014 REQ-016
        """I run the same named shape that the command inspection supports."""
        step("Select each supported catalog scenario")
        for name in ["x86_64-q35-pure-nvme-perf", "x86_32-initrd-fat32-smf", "riscv64-virtio-fat32-smf", "riscv32-virtio-fat32-smf"]:
            val scenario = scenario_by_name_direct(name)
            expect(scenario.name).to_equal(name)
            expect(scenario_sealed_run_supported_v1(scenario)).to_equal(true)

    it "refuses an unrepresented GUI shape before media preparation or launch":
        # @req: REQ-014 REQ-016
        """An unsupported shape cannot silently execute through a legacy fallback."""
        step("Select a GUI scenario outside the sealed shape contract")
        val scenario = scenario_by_name_direct("x64-gui")
        expect(scenario.name).to_equal("x64-gui")
        expect(scenario_sealed_run_supported_v1(scenario)).to_equal(false)
        step("Request sealed execution and observe refusal")
        expect(run_scenario_sealed_v1(scenario)).to_equal(false)
