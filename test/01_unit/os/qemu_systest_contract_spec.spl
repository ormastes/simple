# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/os/qemu_systest_contract_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/qemu_systest_contract_spec.md
# doc-path: doc/03_plan/sys_test/qemu_systest_contract_spec.md
# doc-path: doc/04_architecture/qemu_systest_contract_spec.md
# doc-path: doc/05_design/qemu_systest_contract_spec_oracles.md
# @manual: primary

"""
QEMU Systest Contract — Pure Classifier Unit Tests.

**Feature IDs:** #QEMU-SYSTEST-MULTIARCH-AC1
**Category:** OS system test infrastructure

Verifies classify_serial logic with no QEMU needed.
Tests all four classification outcomes:
  pass, boot-fail:fallback, boot-fail:<marker>, missing-media is not tested
  here (that requires file system — tested in system specs).
"""
use std.spec.step

use std.spec.*
use std.nogc_sync_mut.io_runtime.{
    dir_create_all,
    dir_remove_all,
    file_hash_sha256_or_empty,
    file_write
}
use os.qemu_systest_contract.{

    classify_serial,
    classify_serial_with_nonce,
    qemu_args_with_accelerator,
    qemu_args_with_run_image,
    qemu_nonce_serial_marker,
    x86_64_qemu_args,
    harden_target_triple,
    harden_entry_path,
    harden_linker_script_path,
    harden_builder_script,
    harden_builder_args,
    harden_kernel_path,
    harden_image_path,
    harden_payload_path,
    harden_payload_manifest_path,
    harden_firmware_vars_path,
    harden_firmware_esp_path,
    harden_media_receipt_path,
    harden_qemu_bin,
    harden_qemu_args,
    harden_qemu_args_with_media,
    harden_qemu_args_with_firmware,
    harden_media_receipt_format,
    harden_media_receipt_error,
    harden_media_first_missing_path,
    run_harden_qemu_systest_with_firmware,
    harden_cap_exec_markers,
    harden_malloc_markers,
    harden_pie_relro_markers,
    SYSTEST_PASS,
    SYSTEST_BOOT_FAIL_FALLBACK,
    riscv64_markers,
    arm32_markers,
    x86_32_markers
}

describe "qemu runner controls":
    it "appends the admitted accelerator to actual QEMU argv":
        expect(qemu_args_with_accelerator(["-machine", "virt"], "tcg")).to_equal(["-machine", "virt", "-accel", "tcg"])

    it "rejects unsupported accelerators before launch":
        expect(qemu_args_with_accelerator(["-machine", "virt"], "metadata-only").len()).to_equal(0)

    it "accepts only a transcript containing the requested nonce":
        expect(qemu_nonce_serial_marker("nonce-123")).to_equal("SIMPLEOS_QEMU_NONCE=nonce-123")
        expect(classify_serial_with_nonce("SIMPLEOS_QEMU_NONCE=nonce-123\nTEST PASSED\n", ["TEST PASSED"], "nonce-123")).to_equal(SYSTEST_PASS)
        expect(classify_serial_with_nonce("TEST PASSED\n", ["TEST PASSED"], "nonce-123")).to_equal("boot-fail:nonce-unsupported")

    it "rewrites exactly one descriptor image reference":
        val args = qemu_args_with_run_image(["-drive", "file=base.img,if=none", "-kernel", "kernel.elf"], "base.img", "run.img")
        expect(args).to_contain("file=run.img,if=none")
        expect(qemu_args_with_run_image(["-kernel", "kernel.elf"], "base.img", "run.img").len()).to_equal(0)

    it "reserves enough RAM for the x86_64 one-gibibyte baremetal heap":
        expect(x86_64_qemu_args()).to_contain("2G")

fn _clean_serial() -> text:
    "SimpleOS RV64 boot OK\nFS_LS_BEGIN path=/SYS/APPS\nFS_LS_ENTRY name=FSEXEC.ELF\nFS_LS_END status=pass\nRV64_ELF_ADMISSION_NEGATIVE_OK\nRV64_USER_ISOLATION_OK write_fault_cause=15\nRV64_SUPERVISOR_STATE_RESTORE_OK\nRV64_LEGACY_FSEXEC_DISABLED reason=missing-loader-authority-token\nTEST PASSED\n"

fn _fallback_serial_resident_active() -> text:
    "ELF_LOAD_OK\nSMF_CLI_LAUNCH_OK\n[desktop-e2e] resident-fallback:active\nTEST PASSED\n"

fn _fallback_serial_launcher() -> text:
    "ELF_LOAD_OK\n[launcher] fallback=resident-manifest\nSMF_WM_GUI_LAUNCH_OK\nTEST PASSED\n"

fn _missing_marker_serial() -> text:
    "ELF_LOAD_OK\nSMF_CLI_LAUNCH_OK\nSMF_WM_GUI_LAUNCH_OK\n"

fn _x86_32_clean_serial() -> text:
    "SimpleOS x86_32 boot OK\nX86_32_CONTEXT_SWITCH_ROUNDTRIP ecx=preserved edx=preserved status=pass\nX86_32_HOSTILE_ELF_POLICY status=pass\nX86_32_HOSTILE_ELF_BAD_EI_VERSION rejected=true\nX86_32_HOSTILE_FAT_BOUNDS large_skip=reject chain_bounds=reject bpb_overflow=reject canary=preserved status=pass\nFS_LS_BEGIN path=/SYS/APPS\nFS_LS_ENTRY name=HELLOSMF.SMF\nFS_LS_END status=pass\nFS_PROGRAM_BEGIN path=/FSEXEC.ELF arch=x86_32\nSIMPLEOS_FS_EXEC_OK arch=x86_32 nonce=unit\nFS_PROGRAM_END rc=37 reaped=true\nX86_32_CONTEXT_ROUNDTRIP status=pass\nX86_32_EXACT_REAP generation=2 stale_rejected=true pending_overwrite_rejected=true status=-13\nX86_32_WX_FAULT status=pass\nTEST PASSED\n"

fn _x86_32_legacy_probe_serial() -> text:
    "[x86_32 fs] initrd fat32 ok\n[x86_32 fs] hello_world smf ok\n[x86_32 fs] browser smf ok\n[x86_32 fs] x86_32 payload ok\n[x86_32 fs] app execution ok\nTEST PASSED\n"

fn _arm32_nvfs_smf_probe_serial() -> text:
    "SimpleOS ARM32 boot OK\n[arm32-nvfs] image read ok\nFS_MOUNT_OK\nSMF_DISCOVERY_OK\nELF_LOAD_OK arch=arm32 app=/sys/apps/hello_world.smf\nSMF_CLI_LAUNCH_OK app=/sys/apps/hello_world.smf\nSMF_WM_GUI_LAUNCH_OK app=/sys/apps/browser_demo.smf pid=1002\nNATIVE_GUI_PROCESS_RENDER_OK app=/sys/apps/browser_demo.smf pid=1002\nTEST PASSED\n"

# ---------------------------------------------------------------------------
# classify_serial — pass cases
# ---------------------------------------------------------------------------

describe "classify_serial — pass":
    # @manual scenario evidence

    it "returns pass when all riscv64 markers present and no fallback":
        # @req REQ-SSPEC-UNIT
        step("returns pass when all riscv64 markers present and no fallback")
        val markers = riscv64_markers()
        val result = classify_serial(_clean_serial(), markers)
        expect(result).to_equal(SYSTEST_PASS)

    it "returns pass when all x86_32 markers present and no fallback":
        # @req REQ-SSPEC-UNIT
        step("returns pass when all x86_32 markers present and no fallback")
        val markers = x86_32_markers()
        val result = classify_serial(_x86_32_clean_serial(), markers)
        expect(result).to_equal(SYSTEST_PASS)

    it "rejects the legacy same-CPL x86_32 initrd probe as fs-exec evidence":
        val markers = x86_32_markers()
        val result = classify_serial(_x86_32_legacy_probe_serial(), markers)
        expect(result).to_equal("boot-fail:SimpleOS x86_32 boot OK")

    it "rejects the ARM32 NVFS/SMF probe as filesystem-exec evidence":
        val markers = arm32_markers()
        val result = classify_serial(_arm32_nvfs_smf_probe_serial(), markers)
        expect(result).to_equal("boot-fail:FS_LS_BEGIN path=/SYS/APPS")

    it "returns pass for minimal one-marker list when marker present":
        # @req REQ-SSPEC-UNIT
        step("returns pass for minimal one-marker list when marker present")
        val markers = ["ELF_LOAD_OK"]
        val result = classify_serial("ELF_LOAD_OK\nTEST PASSED\n", markers)
        expect(result).to_equal(SYSTEST_PASS)

# ---------------------------------------------------------------------------
# classify_serial — fallback detection
# ---------------------------------------------------------------------------

describe "classify_serial — fallback":

    it "returns boot-fail:fallback when resident-fallback:active pattern present":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:fallback when resident-fallback:active pattern present")
        val markers = riscv64_markers()
        val result = classify_serial(_fallback_serial_resident_active(), markers)
        expect(result).to_equal(SYSTEST_BOOT_FAIL_FALLBACK)

    it "returns boot-fail:fallback when launcher fallback=resident-manifest present":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:fallback when launcher fallback=resident-manifest present")
        val markers = riscv64_markers()
        val result = classify_serial(_fallback_serial_launcher(), markers)
        expect(result).to_equal(SYSTEST_BOOT_FAIL_FALLBACK)

    it "fallback check precedes marker check":
        # @req REQ-SSPEC-UNIT
        step("fallback check precedes marker check")
        # serial has fallback pattern but also missing markers
        val markers = riscv64_markers()
        val serial = "[desktop-e2e] resident-fallback:active\nELF_LOAD_OK\n"
        val result = classify_serial(serial, markers)
        expect(result).to_equal(SYSTEST_BOOT_FAIL_FALLBACK)

# ---------------------------------------------------------------------------
# classify_serial — missing marker
# ---------------------------------------------------------------------------

describe "classify_serial — missing marker":

    it "returns boot-fail:<marker> for first missing riscv64 marker":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:<marker> for first missing riscv64 marker")
        val markers = riscv64_markers()
        val result = classify_serial(_missing_marker_serial(), markers)
        expect(result).to_equal("boot-fail:SimpleOS RV64 boot OK")

    it "returns boot-fail:<marker> for first missing x86_32 marker":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:<marker> for first missing x86_32 marker")
        val markers = x86_32_markers()
        val result = classify_serial("SimpleOS x86_32 boot OK\n", markers)
        expect(result).to_equal("boot-fail:X86_32_CONTEXT_SWITCH_ROUNDTRIP ecx=preserved edx=preserved status=pass")

    it "returns boot-fail:<marker> when no markers present":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:<marker> when no markers present")
        val markers = ["MARKER_A", "MARKER_B"]
        val result = classify_serial("", markers)
        expect(result).to_equal("boot-fail:MARKER_A")

    it "returns boot-fail:<marker> for empty serial with riscv64 markers":
        # @req REQ-SSPEC-UNIT
        step("returns boot-fail:<marker> for empty serial with riscv64 markers")
        val markers = riscv64_markers()
        val result = classify_serial("", markers)
        expect(result).to_equal("boot-fail:SimpleOS RV64 boot OK")

# ---------------------------------------------------------------------------
# classify_serial — edge cases
# ---------------------------------------------------------------------------

describe "classify_serial — edge cases":

    it "empty marker list with clean serial returns pass":
        # @req REQ-SSPEC-UNIT
        step("empty marker list with clean serial returns pass")
        val markers: [text] = []
        val result = classify_serial(_clean_serial(), markers)
        expect(result).to_equal(SYSTEST_PASS)

    it "empty marker list with fallback serial returns boot-fail:fallback":
        # @req REQ-SSPEC-UNIT
        step("empty marker list with fallback serial returns boot-fail:fallback")
        val markers: [text] = []
        val result = classify_serial(_fallback_serial_resident_active(), markers)
        expect(result).to_equal(SYSTEST_BOOT_FAIL_FALLBACK)

    it "partial marker match returns fail for first missing":
        # @req REQ-SSPEC-UNIT
        step("partial marker match returns fail for first missing")
        val markers = ["A", "B", "C"]
        val result = classify_serial("A\nB\n", markers)
        expect(result).to_equal("boot-fail:C")

# ---------------------------------------------------------------------------
# harden probe build target and OVMF media contract
# ---------------------------------------------------------------------------

describe "harden probe build target and firmware media contract":

    it "pins canonical harden-probe build target paths and builder selector":
        # @req REQ-SSPEC-UNIT
        step("pins canonical harden-probe build target paths and builder selector")
        expect(harden_target_triple()).to_equal("x86_64-unknown-none")
        expect(harden_entry_path()).to_equal("examples/09_embedded/simple_os/arch/x86_64/harden_probe_entry.spl")
        expect(harden_linker_script_path()).to_equal("examples/09_embedded/simple_os/arch/x86_64/linker.ld")
        expect(harden_builder_script()).to_equal("scripts/check/build-simpleos-nvfs-positioned-qemu.shs")
        expect(harden_builder_args()).to_equal(["--harden-probe"])
        expect(harden_kernel_path()).to_equal("build/os/simpleos_x86_64_harden_probe.elf")
        expect(harden_image_path()).to_equal("build/os/fat32-x86_64-harden.img")
        expect(harden_payload_path()).to_equal("build/os/harden/fsexec_nonce_probe.elf")
        expect(harden_payload_manifest_path()).to_equal("build/os/harden/fsexec_nonce_probe.manifest")
        expect(harden_firmware_vars_path()).to_equal("build/os/harden/firmware/OVMF_VARS_4M.fd")
        expect(harden_firmware_esp_path()).to_equal("build/os/harden/firmware/esp")
        expect(harden_media_receipt_path(harden_firmware_esp_path())).to_equal("build/os/harden/firmware/esp/../harden-media-receipt.env")

    it "builds OVMF real-firmware QEMU args without dev-harness shortcuts":
        # @req REQ-SSPEC-UNIT
        step("builds OVMF real-firmware QEMU args without dev-harness shortcuts")
        expect(harden_qemu_bin()).to_equal("qemu-system-x86_64")
        val default_args = harden_qemu_args()
        expect(default_args.contains("-kernel")).to_equal(false)
        expect(default_args.contains("isa-debug-exit,iobase=0xf4,iosize=0x04")).to_equal(false)
        expect(default_args.contains("if=pflash,format=raw,snapshot=on,file=build/os/harden/firmware/OVMF_VARS_4M.fd")).to_equal(true)
        val fw_args = harden_qemu_args_with_firmware("fixture.img", "/opt/ovmf/code.fd", "fixture-vars.fd", "fixture-esp")
        expect(fw_args.contains("if=pflash,format=raw,readonly=on,file=/opt/ovmf/code.fd")).to_equal(true)
        expect(fw_args.contains("file=fat:fixture-esp,format=raw,id=hardenesp,if=none")).to_equal(true)
        expect(fw_args.contains("file=fixture.img,if=none,id=hardennsd,format=raw")).to_equal(true)

    it "reports the first missing harden media path deterministically":
        # @req REQ-SSPEC-UNIT
        step("reports the first missing harden media path deterministically")
        expect(harden_media_first_missing_path("k.elf", false, "d.img", true, "v.fd", true, "BOOTX64.EFI", true)).to_equal("missing-media:k.elf")
        expect(harden_media_first_missing_path("k.elf", true, "d.img", false, "v.fd", true, "BOOTX64.EFI", true)).to_equal("missing-media:d.img")
        expect(harden_media_first_missing_path("k.elf", true, "d.img", true, "v.fd", false, "BOOTX64.EFI", true)).to_equal("missing-media:v.fd")
        expect(harden_media_first_missing_path("k.elf", true, "d.img", true, "v.fd", true, "BOOTX64.EFI", false)).to_equal("missing-media:BOOTX64.EFI")
        expect(harden_media_first_missing_path("k.elf", true, "d.img", true, "v.fd", true, "BOOTX64.EFI", true)).to_equal("")

    it "fails closed on missing firmware code or forged receipt before QEMU":
        # @req REQ-SSPEC-UNIT
        step("fails closed on missing firmware code or forged receipt before QEMU")
        val root = "build/os/systest/harden-contract-unit"
        dir_remove_all(root)
        val kernel = root + "/kernel.elf"
        val image = root + "/image.img"
        val vars = root + "/vars.fd"
        val code = root + "/code.fd"
        val esp = root + "/esp"
        val efi = esp + "/EFI/BOOT/BOOTX64.EFI"
        val receipt = harden_media_receipt_path(esp)
        expect(dir_create_all(esp + "/EFI/BOOT")).to_equal(true)
        expect(file_write(kernel, "harden-kernel")).to_equal(true)
        expect(file_write(image, "harden-image")).to_equal(true)
        expect(file_write(vars, "harden-vars")).to_equal(true)
        expect(file_write(efi, "harden-efi")).to_equal(true)

        expect(run_harden_qemu_systest_with_firmware(
            "harden_unit_missing_code", kernel, image, root + "/missing-code.fd",
            vars, esp, harden_cap_exec_markers()
        )).to_equal("missing-media:" + root + "/missing-code.fd")

        expect(file_write(code, "harden-code")).to_equal(true)
        expect(run_harden_qemu_systest_with_firmware(
            "harden_unit_missing_receipt", kernel, image, code,
            vars, esp, harden_cap_exec_markers()
        )).to_equal("missing-media:" + receipt)

        val valid_receipt = harden_media_receipt_format(
            file_hash_sha256_or_empty(kernel),
            file_hash_sha256_or_empty(efi),
            code,
            file_hash_sha256_or_empty(code))
        expect(file_write(receipt, valid_receipt)).to_equal(true)
        expect(harden_media_receipt_error(receipt, kernel, efi, code)).to_equal("")

        expect(file_write(receipt, valid_receipt + "tamper=1\n")).to_equal(true)
        expect(run_harden_qemu_systest_with_firmware(
            "harden_unit_bad_receipt", kernel, image, code,
            vars, esp, harden_cap_exec_markers()
        )).to_equal("invalid-media-receipt:" + receipt)
        dir_remove_all(root)

    it "classifies all harden capability, malloc, and PIE/RELRO/SSP marker sets":
        # @req REQ-SSPEC-UNIT
        step("classifies all harden capability, malloc, and PIE/RELRO/SSP marker sets")
        val cap_markers = harden_cap_exec_markers()
        expect(classify_serial(cap_markers.join("\n") + "\n", cap_markers)).to_equal(SYSTEST_PASS)
        expect(classify_serial("[exec] capability gate: ENFORCED\n", cap_markers)).to_equal("boot-fail:[exec] uncapable exec REJECTED")

        val malloc_markers = harden_malloc_markers()
        expect(classify_serial(malloc_markers.join("\n") + "\n", malloc_markers)).to_equal(SYSTEST_PASS)
        expect(classify_serial("[hmalloc] guard-page trap OK\n", malloc_markers)).to_equal("boot-fail:[hmalloc] double-free TRAPPED")

        val sec_markers = harden_pie_relro_markers()
        expect(classify_serial(sec_markers.join("\n") + "\n", sec_markers)).to_equal(SYSTEST_PASS)
        expect(classify_serial("[hardening] PIE=1\n[hardening] RELRO=1 BIND_NOW=1\n[hardening] NX=1 SMEP=1 SMAP=1\n", sec_markers)).to_equal("boot-fail:[hardening] STACK_CANARY=1")
