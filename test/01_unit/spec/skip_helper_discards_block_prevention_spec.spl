# @req REQ-SSPEC-UNIT
use std.spec.*
use std.io.{file_read}
use std.nogc_sync_mut.io.dir_ops.{dir_walk}
use std.spec.skip_helper_lint.{skip_helpers_discarding_block}

describe "local skip helper that discards its block is flagged":
    it "flags the false-green shape":
        val src = "fn skip_on_interpreter(name: text, block: fn()):\n    print \"    skipped\"\n\ndescribe \"x\":\n    pass\n"
        expect(skip_helpers_discarding_block(src)).to_equal(["skip_on_interpreter"])

    it "accepts a helper that runs its block":
        val src = "fn skip_on_interpreter(name: text, block: fn()):\n    block()\n\ndescribe \"x\":\n    pass\n"
        expect(skip_helpers_discarding_block(src).len()).to_equal(0)

    it "no spec file under test/ defines a skip helper that discards its block":
        var bad: [text] = []
        var scanned = 0
        for f in dir_walk("test"):
            if not f.ends_with(".spl"):
                continue
            val content = file_read(f) ?? ""
            if not content.contains("fn skip_"):
                continue
            scanned = scanned + 1
            if skip_helpers_discarding_block(content).len() > 0:
                bad.push(f)
        expect(scanned > 0).to_equal(true)
        expect(bad).to_equal([])
