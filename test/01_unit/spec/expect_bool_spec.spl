# @tag:unit, spec, expect

use std.spec.step

use std.spec.{describe, it, expect, expect_not}

describe "Concise boolean expectations":
    # @manual scenario evidence
    it "accepts bare true expectations":
        # @req REQ-SSPEC-SPEC
        step("accepts bare true expectations")
        assert_true(3 > 2)

    it "accepts bare false expectations through expect_not":
        # @req REQ-SSPEC-SPEC
        step("accepts bare false expectations through expect_not")
        expect_not(3 < 2)

    it "keeps non-boolean zero equality as a chained matcher":
        # @req REQ-SSPEC-SPEC
        step("keeps non-boolean zero equality as a chained matcher")
        # oracle: 7 - 7 is computed at runtime, so the matcher sees a real value, not a literal
        expect(7 - 7).to_equal(0)
