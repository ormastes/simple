use std.spec
use std.parser.treesitter.{Node, NodeArena, NodeId, Span, TreeSitterParser}

describe "tree-sitter facade compatibility":
    it "keeps arena handles stable and rejects stale generations":
        var arena = NodeArena.new()
        val span = Span(start_byte: 0, end_byte: 3, start_line: 1, end_line: 1, start_column: 1, end_column: 4)
        val id = arena.alloc(Node.create("identifier", "abc", span))
        expect(id.index).to_equal(0)
        expect(arena.get(id).unwrap().kind).to_equal("identifier")
        expect(arena.get(NodeId(owner: id.owner, index: id.index, generation: id.generation + 1)).is_none()).to_be(true)

        var other = NodeArena.new()
        other.alloc(Node.create("other", "xyz", span))
        expect(other.get(id).is_none()).to_be(true)

        arena.reset()
        arena.alloc(Node.create("replacement", "def", span))
        expect(arena.get(id).is_none()).to_be(true)

    it "rejects stale and foreign node values at the flat child-edge boundary":
        var parser = TreeSitterParser.new("simple").unwrap()
        val tree = parser.parse("1+2").unwrap()
        val root = tree.root().unwrap()
        val stale_children = tree.children(root)
        expect(stale_children.len()).to_equal(1)

        var other = NodeArena.new()
        expect(other.children(root).len()).to_equal(0)
        val leaf_id = other.alloc(Node.create("integer", "3", tree.span(root)))
        val parent_id = other.alloc_with_children(Node.create("module", "3", tree.span(root)), [leaf_id])
        val stale_parent = other.get(parent_id).unwrap()
        expect(other.children(stale_parent).len()).to_equal(1)
        other.reset()
        expect(other.children(stale_parent).len()).to_equal(0)

    it "fails closed without exposing malformed flat child edges":
        var arena = NodeArena.new()
        val span = Span(start_byte: 0, end_byte: 1, start_line: 1, end_line: 1, start_column: 1, end_column: 2)
        val valid = arena.alloc(Node.create("integer", "1", span))
        var foreign_arena = NodeArena.new()
        val foreign = foreign_arena.alloc(Node.create("integer", "2", span))
        val foreign_parent_id = arena.alloc_with_children(Node.create("module", "1", span), [valid, foreign])
        expect(arena.children(arena.get(foreign_parent_id).unwrap()).len()).to_equal(0)

        val stale = NodeId(owner: valid.owner, index: valid.index, generation: valid.generation + 1)
        val stale_parent_id = arena.alloc_with_children(Node.create("module", "1", span), [valid, stale])
        expect(arena.children(arena.get(stale_parent_id).unwrap()).len()).to_equal(0)

        val negative = NodeId(owner: valid.owner, index: -1, generation: valid.generation)
        val negative_parent_id = arena.alloc_with_children(Node.create("module", "1", span), [negative])
        expect(arena.children(arena.get(negative_parent_id).unwrap()).len()).to_equal(0)

        val out_of_range = NodeId(owner: valid.owner, index: 999, generation: valid.generation)
        val out_of_range_parent_id = arena.alloc_with_children(Node.create("module", "1", span), [out_of_range])
        expect(arena.children(arena.get(out_of_range_parent_id).unwrap()).len()).to_equal(0)

    it "treats copied arenas as snapshots with independent reset generations":
        var arena = NodeArena.new()
        val span = Span(start_byte: 0, end_byte: 1, start_line: 1, end_line: 1, start_column: 1, end_column: 2)
        val original_id = arena.alloc(Node.create("integer", "1", span))
        var snapshot = arena
        expect(snapshot.get(original_id).unwrap().text).to_equal("1")
        snapshot.reset()
        expect(snapshot.get(original_id).is_none()).to_be(true)
        expect(arena.get(original_id).unwrap().text).to_equal("1")
        val snapshot_id = snapshot.alloc(Node.create("integer", "2", span))
        expect(snapshot_id.owner).to_equal(original_id.owner)
        expect(snapshot_id.generation).to_equal(original_id.generation + 1)
        expect(arena.get(snapshot_id).is_none()).to_be(true)

    it "exposes root lookup and source text through the canonical tree owner":
        var parser = TreeSitterParser.new("simple").unwrap()
        val tree = parser.parse("val answer = 42").unwrap()
        val root = tree.root().unwrap()
        expect(root.kind).to_equal("module")
        expect(root.child_count()).to_equal(tree.children(root).len())
        expect(tree.get_text(root)).to_equal("val answer = 42")
        expect(root.child_count()).to_equal(1)
        val child = tree.get_node(tree.children(root)[0]).unwrap()
        expect(child.kind).to_equal("val_statement")
        expect(tree.get_text(child)).to_equal("val answer = 42")

    it "populates each top-level source line and skips indented lines":
        var parser = TreeSitterParser.new("simple").unwrap()
        val tree = parser.parse("fn answer():\n    42\nval ready = true\n").unwrap()
        val root = tree.root().unwrap()
        expect(root.child_count()).to_equal(2)
        expect(tree.get_node(tree.children(root)[0]).unwrap().kind).to_equal("function_def")
        expect(tree.get_node(tree.children(root)[1]).unwrap().kind).to_equal("val_statement")
        expect(tree.get_text(tree.get_node(tree.children(root)[0]).unwrap())).to_equal("fn answer():")
        expect(tree.get_text(tree.get_node(tree.children(root)[1]).unwrap())).to_equal("val ready = true")
        val root_span = tree.span(root)
        expect(root_span.start_byte).to_equal(0)
        expect(root_span.end_byte).to_equal(37)
        expect(root_span.start_line).to_equal(1)
        expect(root_span.end_line).to_equal(4)
        expect(root_span.end_column).to_equal(1)
        val second = tree.get_node(tree.children(root)[1]).unwrap()
        val second_span = tree.span(second)
        expect(second_span.start_byte).to_equal(20)
        expect(second_span.end_byte).to_equal(36)
        expect(second_span.start_line).to_equal(3)
        expect(second_span.end_line).to_equal(3)
        expect(second_span.start_column).to_equal(1)
        expect(second_span.end_column).to_equal(17)

    it "classifies complete top-level tokens without prefix collisions":
        var parser = TreeSitterParser.new("simple").unwrap()
        val source = "import alpha\nuse beta\npub fn visible():\nclass Widget:\ntrait Render:\n# note\nreturn\nreturn value\nreturning\n\n"
        val tree = parser.parse(source).unwrap()
        val root = tree.root().unwrap()
        expect(root.child_count()).to_equal(9)
        val children = tree.children(root)
        expect(tree.get_node(children[0]).unwrap().kind).to_equal("import_statement")
        expect(tree.get_node(children[1]).unwrap().kind).to_equal("use_statement")
        expect(tree.get_node(children[2]).unwrap().kind).to_equal("function_def")
        expect(tree.get_node(children[3]).unwrap().kind).to_equal("class_def")
        expect(tree.get_node(children[4]).unwrap().kind).to_equal("trait_def")
        expect(tree.get_node(children[5]).unwrap().kind).to_equal("comment")
        expect(tree.get_node(children[6]).unwrap().kind).to_equal("return_statement")
        expect(tree.get_node(children[7]).unwrap().kind).to_equal("return_statement")
        expect(tree.get_node(children[8]).unwrap().kind).to_equal("expression_statement")
        expect(tree.span(root).end_line).to_equal(11)
        expect(tree.span(root).end_column).to_equal(1)

    it "builds a recursively traversable binary CST without nested child arrays":
        var parser = TreeSitterParser.new("simple").unwrap()
        val tree = parser.parse("1+2").unwrap()
        val root = tree.root().unwrap()
        expect(root.child_count()).to_equal(1)
        val statement = tree.get_node(tree.children(root)[0]).unwrap()
        expect(statement.child_count()).to_equal(1)
        val binary = tree.get_node(tree.children(statement)[0]).unwrap()
        val binary_children = tree.children(binary)
        val left = tree.get_node(binary_children[0]).unwrap()
        val operator = tree.get_node(binary_children[1]).unwrap()
        val right = tree.get_node(binary_children[2]).unwrap()
        expect(statement.kind).to_equal("expression_statement")
        expect(binary.kind).to_equal("binary_expression")
        expect(binary.child_count()).to_equal(3)
        val root_span = tree.span(root)
        expect(root_span.start_byte).to_equal(0)
        expect(root_span.end_byte).to_equal(3)
        expect(root_span.start_line).to_equal(1)
        expect(root_span.end_line).to_equal(1)
        expect(root_span.start_column).to_equal(1)
        expect(root_span.end_column).to_equal(4)
        val statement_span = tree.span(statement)
        expect(statement_span.start_byte).to_equal(0)
        expect(statement_span.end_byte).to_equal(3)
        expect(statement_span.start_line).to_equal(1)
        expect(statement_span.end_line).to_equal(1)
        expect(statement_span.start_column).to_equal(1)
        expect(statement_span.end_column).to_equal(4)
        val binary_span = tree.span(binary)
        expect(binary_span.start_byte).to_equal(0)
        expect(binary_span.end_byte).to_equal(3)
        expect(binary_span.start_line).to_equal(1)
        expect(binary_span.end_line).to_equal(1)
        expect(binary_span.start_column).to_equal(1)
        expect(binary_span.end_column).to_equal(4)
        expect(left.kind).to_equal("integer")
        expect(left.text).to_equal("1")
        expect(tree.span(left).start_byte).to_equal(0)
        expect(tree.span(left).end_byte).to_equal(1)
        expect(operator.kind).to_equal("+")
        expect(operator.text).to_equal("+")
        expect(tree.span(operator).start_byte).to_equal(1)
        expect(tree.span(operator).end_byte).to_equal(2)
        expect(right.kind).to_equal("integer")
        expect(right.text).to_equal("2")
        expect(tree.span(right).start_byte).to_equal(2)
        expect(tree.span(right).end_byte).to_equal(3)
