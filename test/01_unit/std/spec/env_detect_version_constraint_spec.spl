use std.env.{env_set}
use std.spec.env_detect.{check_version_constraint}

describe "check_version_constraint":
    it "treats 0.9.0 as satisfying >= 0.10.0 requirement lexicographically (numeric segments needed)":
        env_set("SIMPLE_VERSION", "0.9.0")
        # Semantically 0.9.0 < 0.10.0, so this constraint should NOT be satisfied.
        expect(check_version_constraint(">= 0.10.0")).to_equal(false)
