# @req: REQ-LIB-STUB-950d

# stub behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

describe "stub stdlib behavior oracles":
    it "text concat slice reverse":
        # @req: REQ-LIB-STUB-950d
        step("Verify: text concat slice reverse")
        # oracle: "abcdef"/"bc"/"cba" — concat, slice from index 1, reverse
        expect("abc" + "def").to_equal("abcdef")
        expect("abc".slice(1)).to_equal("bc")
        expect("abc".reverse()).to_equal("cba")
    it "array sort":
        # @req: REQ-LIB-STUB-950d
        step("Verify: array sort")
        # oracle: [1, 2, 3] — sorted() returns ascending order
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
    it "array map filter":
        # @req: REQ-LIB-STUB-950d
        step("Verify: array map filter")
        # oracle: [4, 2, 3] — each element +1; [3, 2] — elements > 1 in order
        expect([3, 1, 2].map(fn (x: i64) -> i64: x + 1)).to_equal([4, 2, 3])
        expect([3, 1, 2].filter(fn (x: i64) -> bool: x > 1)).to_equal([3, 2])
    it "array membership and index":
        # @req: REQ-LIB-STUB-950d
        step("Verify: array membership and index")
        # oracle: true/2 — 2 is present at index 2
        expect([3, 1, 2].contains(2)).to_equal(true)
        expect([3, 1, 2].contains(9)).to_equal(false)
        expect([3, 1, 2].index_of(2)).to_equal(2)
    it "array append and len":
        # @req: REQ-LIB-STUB-950d
        step("Verify: array append and len")
        # oracle: 4 — append grows the owner list by one and returns it
        var arr = [1, 2, 3]
        arr.append(4)
        expect(arr.len()).to_equal(4)
        expect(arr[3]).to_equal(4)
    it "dict read":
        # @req: REQ-LIB-STUB-950d
        step("Verify: dict read")
        # oracle: 2/1/2 — two keys, value lookup, key count
        val d = {"a": 1, "b": 2}
        expect(d.len()).to_equal(2)
        expect(d["a"]).to_equal(1)
        expect(d.keys().len()).to_equal(2)
    it "dict write":
        # @req: REQ-LIB-STUB-950d
        step("Verify: dict write")
        # oracle: 3 — inserting a new key grows the dict by one
        val d = {"a": 1, "b": 2}
        d["c"] = 3
        expect(d.len()).to_equal(3)
        expect(d["c"]).to_equal(3)
    it "option map unwrap":
        # @req: REQ-LIB-STUB-950d
        step("Verify: option map unwrap")
        # oracle: Some(10)/5 — map doubles the payload; unwrap_or yields it
        val o = Some(5)
        expect(o.map(fn (x: i64) -> i64: x * 2)).to_equal(Some(10))
        expect(o.unwrap_or(0)).to_equal(5)
        expect(o.is_some()).to_equal(true)
