# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
#
# Reproduce spec for the class-(c) non-optional-return-contract defect in
# std.concurrent.thread. `ThreadHandle.join()` declared `-> i64`, but the
# runtime returns the spawned closure's result, which is legitimately nil for
# a closure with no value (see known_bugs C12). Pre-fix this aborts with
#   nil is forbidden by the non-optional return contract of 'join' [E-SFFI-016]
# Post-fix the declaration is widened to `-> i64?` so the nil path is declared.

use std.spec.step
use std.concurrent.thread.{thread_spawn, ThreadHandle}

describe "ThreadHandle.join nil-return contract":
    # @manual scenario evidence
    it "join returns nil for a closure that produces no value":
        # @req REQ-SSPEC-UNIT
        step("join returns nil for a closure that produces no value")
        val handle = thread_spawn(\: nil)
        val result = handle.join()
        expect(result).to_be_nil()
