# Local stub for cached
# (import not resolvable in interpreter mode)
fn cached(f):
    f

fn square(x):
    return x * x

describe "standalone cached wrapper":
    it "returns a callable that behaves like the wrapped function":
        val c = cached(square)
        expect(c(5)).to_equal(25)

    it "wraps without changing the function's results for other inputs":
        val c = cached(square)
        expect(c(0)).to_equal(0)
        expect(c(-3)).to_equal(9)
