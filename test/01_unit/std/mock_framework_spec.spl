# Mock Framework Module Tests
# Feature: Mock/CallRecorder/CallVerifier test doubles via std.spec.mock
# Category: Testing
# Status: Deduplicated
#
# std.spec.mock now lives in this tree (src/lib/nogc_sync_mut/spec/mock.spl)
# as a text-valued pure-Simple mock double — see
# doc/08_tracking/bug/std_suite_failures_are_unbuilt_features_2026-09-20.md
# (mock rows). Before the module landed, `use spec.{Mock}` /
# `use std.spec.mock.{Mock}` resolved to the Rust seed's bundled Any-valued
# mock.spl or failed outright ("variable `Mock` not found").

use spec.{describe, it, expect}
use std.spec.mock.{Mock, Spy, Stub, CallRecorder, CallVerifier}

describe "std.spec.mock Mock double":
    it "creates a named mock":
        val m = Mock.new("Service")
        expect m.name == "Service"

    it "returns the stubbed value for a method":
        val m = Mock.new("Repo")
        m.when("find").returns("42")
        expect m.call("find", []) == "42"

    it "returns different values for different methods":
        val m = Mock.new("Service")
        m.when("get_name").returns("ann")
        m.when("get_age").returns("30")
        expect m.call("get_name", []) == "ann"
        expect m.call("get_age", []) == "30"

    it "returns sequence values in order":
        val m = Mock.new("Queue")
        m.when("next").returns_sequence(["a", "b"])
        expect m.call("next", []) == "a"
        expect m.call("next", []) == "b"
        expect m.call("next", []) == ""

    it "records calls with arguments":
        val m = Mock.new("Service")
        m.when("get").returns("v")
        m.call("get", ["k"])
        m.call("get", ["k2"])
        expect m.call_count("get") == 2
        expect m.recorder.was_called_with("get", ["k2"])

    it "verifies a method was called":
        val m = Mock.new("Service")
        m.when("save").returns("ok")
        m.call("save", ["x"])
        m.verify("save").was_called().verify()

    it "verifies exact call count":
        val m = Mock.new("Service")
        m.call("ping", [])
        m.call("ping", [])
        m.verify("ping").was_called_n_times(2).verify()

    it "resets stubs and calls":
        val m = Mock.new("Service")
        m.when("get").returns("v")
        m.call("get", [])
        m.reset()
        expect m.call("get", []) == ""
        expect m.call_count("get") == 1
