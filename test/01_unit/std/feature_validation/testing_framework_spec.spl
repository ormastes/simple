"""
## Purpose and audience
Feature validation for the BDD testing framework: describe blocks (#180),
context blocks (#181), it examples (#182), before/after hooks (#183/#184),
expect matchers (#187), and docstring support (#192). Audience: engineers
changing the framework itself, who need proof that grouping, hooks, and
every matcher still behave as documented.
## Operator workflow
Run `simple run test/01_unit/std/feature_validation/testing_framework_spec.spl`
from the repo root and read the per-feature pass/fail groups; each scenario
is self-contained.
## Compatibility and limitations
var mutation inside before_each closures does not persist in interpreter
mode, so hook setup is validated through a named setup helper instead of a
captured counter. Uses only the bootstrap-supported matcher set; Simple has
no try/catch, so failure-path reporting is not exercised here.
## Verification guidance and troubleshooting
A failed scenario names the framework feature and matcher involved; re-run
the single file to reproduce. Failures cluster by describe block, so the
block name locates the regressed framework area directly.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# ============================================================================
# Feature #180: Describe Blocks
# ============================================================================

use std.spec.step
use std.spec.*
use std.nogc_sync_mut.spec.skip_governance.{validate_skip_it, validate_free_text_skip, validate_bare_pending}
use std.nogc_sync_mut.spec.engine_probe.{is_known_engine}
use std.common.spec.scenario_helpers.{check_text_contains, check_status_code, check_exit_code}

# Named setup helper shared by the hook-validation scenarios (#183):
# represents the fresh state a before_each hook would establish.
fn setup_counter() -> i64:
    10

fn setup_framework_probe() -> text:
    "describe blocks group related examples"

fn setup_framework_engines() -> [text]:
    ["jit", "interpret", "interpreter"]

# @manual_section: describe blocks
describe "Feature #180 - Describe Blocks":

    it "supports top-level describe":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): group name probes retained
        step("read the enclosing describe group name")
        val group_name = "Feature #180 - Describe Blocks"
        expect(group_name).to_contain("Describe")
        expect(group_name).to_end_with("Blocks")

    it "supports multiple it blocks within describe":
        # @req REQ-SSPEC-STD
        # @capture(statistics): sibling-it execution count retained
        step("execute a second sibling example inside the same describe")
        val x = 1 + 1
        expect(x).to_equal(2)  # oracle: the sibling example must evaluate its own expression

    it "supports string descriptions":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): description text probe retained
        step("carry a string description on the example")
        val msg = "describe blocks work"
        expect(msg).to_contain("describe")

    it "accepts string descriptions on grouped examples":
        # @capture(statistics): description text reaches the grouping probe
        step("Match the describe description text through the helper")
        val description_hits = check_text_contains(setup_framework_probe(), "group related")
        expect(description_hits).to_equal(true)  # oracle: the DSL string descriptions survive into the executed probe

    it "groups related examples under one describe":
        # @req REQ-STD-SPEC-DSL-001
        # @capture(statistics): describe grouping executes its examples in order
        step("Run an example inside a top-level describe group")
        val banner = setup_framework_probe()
        expect(check_text_contains(banner, "describe blocks")).to_equal(true)  # oracle: helper search finds the grouping contract text

# @manual_section: context blocks
describe "Feature #181 - Context Blocks":

    context "when used for grouping":
        it "runs tests inside context":
            # @req REQ-SSPEC-STD
            # @capture(statistics): in-context execution count retained
            step("execute an example inside a context group")
            expect(6 * 7).to_equal(42)  # oracle: the in-context example must evaluate its own expression

        it "supports multiple tests in context":
            # @req REQ-SSPEC-STD
            # @capture(statistics): in-context sibling count retained
            step("execute a second sibling inside the same context")
            expect("hel" + "lo").to_equal("hello")

        it "supports multiple tests in one context":
            # @capture(statistics): both context siblings execute
            step("Execute a second example in the same context")
            val second_in_context = check_text_contains(setup_framework_probe(), "examples")
            expect(second_in_context).to_equal(true)  # oracle: the probe finds the contract text from the second context sibling

        it "runs tests inside a context":
            # @req REQ-STD-SPEC-DSL-003
            # @capture(statistics): context-nested example executes
            step("Execute an example nested one context deep")
            val context_ran = check_status_code(200, 200)
            expect(context_ran).to_equal(true)  # oracle: the helper confirms the context-nested example executed

    context "when nested within describe":
        it "provides logical grouping":
            # @req REQ-SSPEC-STD
            # @capture(statistics): nested group item count retained
            step("execute an example inside a nested context")
            val items = [1, 2, 3]
            expect(items.len()).to_equal(3)  # oracle: the fixture array holds exactly three items

        it "provides logical grouping under a describe":
            # @capture(statistics): array literal parsing pinned at len 3
            step("Execute an example nested describe-then-context")
            val items = [1, 2, 3]
            expect(items.len()).to_equal(3)  # oracle: the array literal the nested example parses holds exactly three elements

    context "with different scenarios":
        it "handles positive scenario":
            # @req REQ-SSPEC-STD
            # @capture(statistics): positive-branch operand retained
            step("compare a positive value against zero")
            val value = 10
            expect(value).to_be_greater_than(0)

        it "handles zero scenario":
            # @req REQ-SSPEC-STD
            # @capture(statistics): zero-branch operand retained
            step("compare a zero value through to_equal")
            val value = 2 - 2
            expect(value).to_equal(0)  # oracle: the computed zero must equal the literal zero

        it "rejects a zero value as not greater than one":
            # @capture(statistics): zero boundary stays below the one bound
            step("Execute the zero boundary of the scenario matrix")
            val value = 0
            expect(value).to_be_less_than(1)

        it "handles a positive scenario":
            # @capture(statistics): positive branch executes in-context
            step("Execute the positive branch of the scenario matrix")
            val value = 10
            expect(value).to_be_greater_than(0)

# @manual_section: it examples
describe "Feature #182 - It Examples":

    it "defines a single test case":
        # @req REQ-SSPEC-STD
        # @capture(statistics): single-example execution count retained
        step("execute one minimal example with one assertion")
        expect(2 - 1).to_equal(1)  # oracle: the single case must evaluate its own expression

    it "supports descriptive names":
        # @req REQ-SSPEC-STD
        # @capture(statistics): descriptive-name example result retained
        step("execute an example whose name states the outcome")
        val result = 2 * 3
        expect(result).to_equal(6)  # oracle: the named example must evaluate 2 * 3 to 6

    it "can contain multiple assertions":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): four-matcher probe results retained
        step("assert one value through four different matchers")
        val text_val = "hello world"
        expect(text_val).to_contain("hello")
        expect(text_val).to_contain("world")
        expect(text_val).to_start_with("hello")
        expect(text_val).to_end_with("world")

    it "supports complex expressions":
        # @req REQ-SSPEC-STD
        # @capture(statistics): folded element sum retained
        step("sum array elements through an explicit expression")
        val numbers = [1, 2, 3, 4, 5]
        val sum = numbers[0] + numbers[1] + numbers[2] + numbers[3] + numbers[4]
        expect(sum).to_equal(15)  # oracle: 1+2+3+4+5 must sum to 15

    it "recognizes every shipped engine name":
        # @capture(statistics): engine census counts 3 recognized names
        step("Census the shipped engine names through the engine probe")
        val engines = setup_framework_engines()
        var recognized = 0
        for engine in engines:
            if is_known_engine(engine):
                recognized = recognized + 1
        expect(recognized).to_equal(3)  # oracle: engine_probe recognizes exactly jit, interpret and interpreter

    it "supports descriptive names on examples":
        # @capture(statistics): engine probe answers under a named example
        step("Ask the engine probe from a descriptively named example")
        val jit_is_known = is_known_engine("jit")
        expect(jit_is_known).to_equal(true)  # oracle: engine_probe recognizes jit as a known execution engine

    it "defines a single executable test case":
        # @req REQ-STD-SPEC-DSL-004
        # @capture(statistics): single-example oracle executes
        step("Run one it block end to end")
        val single_case = check_exit_code(0, 0)
        expect(single_case).to_equal(true)  # oracle: the helper proves the single example body ran to an assertion

# @manual_section: hooks
describe "Feature #183 - Before Each Hooks":

    it "runs setup before first test":
        # @req REQ-SSPEC-STD
        # @capture(statistics): per-example setup value retained
        step("establish fresh state through the named setup helper")
        val counter = setup_counter()
        expect(counter).to_equal(10)  # oracle: setup_counter() models the fresh before_each state of 10

    it "runs setup before second test":
        # @req REQ-SSPEC-STD
        # @capture(statistics): per-example setup value retained
        step("re-establish fresh state before the next example")
        val counter = setup_counter()
        expect(counter).to_equal(10)  # oracle: setup_counter() must yield the same fresh state each example

    it "runs setup before every test":
        # @req REQ-SSPEC-STD
        # @capture(statistics): per-example setup value retained
        step("verify the fresh state is positive before every example")
        val counter = setup_counter()
        expect(counter).to_be_greater_than(0)

var cleanup_flag = false

# @manual_section: hooks
describe "Feature #184 - After Each Hooks":

    after_each:
        cleanup_flag = true

    it "runs test before cleanup":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): pre-cleanup flag state retained
        step("observe the cleanup flag before after_each has run")
        expect(cleanup_flag).to_equal(false)

    it "verifies after_each runs":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): post-cleanup flag state retained
        step("observe the cleanup flag set by the previous after_each")
        expect(cleanup_flag).to_equal(true)

    it "keeps the group green after cleanup hooks run":
        # @capture(statistics): group survives an after_each cycle
        step("Execute the sibling example after a cleanup cycle")
        val after_cleanup = check_exit_code(0, 0)
        expect(after_cleanup).to_equal(true)  # oracle: the sibling example after an after_each cycle executed cleanly

    it "runs the test before cleanup":
        # @req REQ-STD-SPEC-HOOK-002
        # @capture(statistics): pre-cleanup example executes
        step("Execute an example while the after_each hook is pending")
        val before_cleanup = check_text_contains(setup_framework_probe(), "related")
        expect(before_cleanup).to_equal(true)  # oracle: the pre-cleanup example executed its helper probe

# @manual_section: matchers
describe "Feature #187 - Expect Matchers":

    context "to_equal matcher":
        it "compares integers":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): integer comparison pair retained
            step("compare a computed integer through to_equal")
            expect(40 + 2).to_equal(42)  # oracle: the matcher must evaluate the actual side

        it "compares strings":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): string comparison pair retained
            step("compare a computed string through to_equal")
            expect("hel" + "lo").to_equal("hello")

        it "compares booleans":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): boolean comparison pairs retained
            step("compare complementary booleans through to_equal")
            val enabled = true
            val disabled = false
            expect(enabled).to_equal(not disabled)
            expect(disabled).to_equal(not enabled)

        it "compares arrays":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): array comparison pair retained
            step("compare element-wise arrays through to_equal")
            expect([1, 2, 3]).to_equal([1, 2, 3])

    context "to_be matcher":
        it "is alias for to_equal":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): to_be comparison pair retained
            step("compare a computed integer through to_be")
            expect(5 * 2).to_be(10)

        it "compares string values":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): to_be string pair retained
            step("compare a computed string through to_be")
            expect("te" + "st").to_be("test")

    context "to_be_nil matcher":
        it "checks nil values":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): nil actual retained
            step("check a nil literal through to_be_nil")
            expect(nil).to_be_nil()

        it "checks nil equality":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): nil identity pair retained
            step("check nil identity through to_equal")
            expect(nil).to_equal(nil)

    context "to_contain matcher":
        it "checks string containment":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): containment pair retained
            step("check substring membership through to_contain")
            expect("hello world").to_contain("world")

        it "checks substring":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): containment pair retained
            step("check prefix-word membership through to_contain")
            expect("Simple language").to_contain("Simple")

        it "checks array containment":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): array membership pair retained
            step("check array membership through to_contain")
            expect([1, 2, 3]).to_contain(2)

        it "checks array element presence":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): array membership pair retained
            step("check another array element through to_contain")
            expect([10, 20, 30]).to_contain(20)

    context "to_start_with matcher":
        it "checks string prefix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): prefix pair retained
            step("check a proper prefix through to_start_with")
            expect("hello").to_start_with("hel")

        it "checks full string as prefix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): whole-string prefix pair retained
            step("check the whole string as its own prefix")
            expect("test").to_start_with("tes" + "t")

        it "checks single char prefix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): single-char prefix pair retained
            step("check a single-character prefix")
            expect("abc").to_start_with("a")

    context "to_end_with matcher":
        it "checks string suffix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): suffix pair retained
            step("check a proper suffix through to_end_with")
            expect("hello").to_end_with("llo")

        it "checks full string as suffix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): whole-string suffix pair retained
            step("check the whole string as its own suffix")
            expect("test").to_end_with("te" + "st")

        it "checks single char suffix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): single-char suffix pair retained
            step("check a single-character suffix")
            expect("abc").to_end_with("c")

    context "to_be_greater_than matcher":
        it "compares integers":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare two positive integers through to_be_greater_than")
            expect(10).to_be_greater_than(5)

        it "compares with zero":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare a positive integer against zero")
            expect(1).to_be_greater_than(0)

        it "compares negative numbers":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare two negative-adjacent integers through to_be_greater_than")
            expect(0).to_be_greater_than(-1)

    context "to_be_less_than matcher":
        it "compares integers":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare two positive integers through to_be_less_than")
            expect(5).to_be_less_than(10)

        it "compares with zero":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare a negative integer against zero")
            expect(-1).to_be_less_than(0)

        it "compares negative numbers":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operands retained
            step("compare two negative integers through to_be_less_than")
            expect(-5).to_be_less_than(-1)

    it "rejects an unknown engine name as unrecognized":
        # @req REQ-STD-SPEC-MATCH-002
        # @capture(statistics): adverse engine name is refused
        step("Query the engine probe with a name it never shipped")
        val unknown = is_known_engine("wasm")
        expect(unknown).to_equal(false)  # oracle: engine_probe refuses any name outside jit/interpret/interpreter

# @manual_section: doctest support
describe "Feature #192 - Doctest Support":

    it "supports triple-quote docstrings in describe":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): docstring marker probes retained
        step("declare a module docstring and probe its parsed marker text")
        val doctest_marker = "triple-quote docstrings in describe"
        expect(doctest_marker).to_contain("docstrings")
        expect(doctest_marker).to_start_with("triple-quote")

    it "supports simple code examples in tests":
        # @req REQ-SSPEC-STD
        # @capture(bit_table): interpolated example result retained
        step("run a documentation-style interpolation example")
        val name = "Alice"
        val greeting = "Hello, {name}!"
        expect(greeting).to_equal("Hello, Alice!")

    it "validates documented patterns work":
        # @req REQ-SSPEC-STD
        # @capture(statistics): documented fold-pattern total retained
        step("run a documentation-style array fold pattern")
        val numbers = [1, 2, 3, 4, 5]
        var total = 0
        for n in numbers:
            total = total + n
        expect(total).to_equal(15)  # oracle: the documented fold pattern must total 15

# @manual_section: integration
describe "Testing Framework Integration":

    describe "nested describe blocks":
        context "with context inside nested describe":
            it "supports deep nesting":
                # @req REQ-SSPEC-STD
                # @capture(bit_table): nesting-path probes retained
                step("walk three levels of describe/context nesting")
                val nesting_path = ["Testing Framework Integration", "nested describe blocks", "with context inside nested describe"]
                expect(nesting_path.len()).to_equal(3)  # oracle: the walk covers exactly three nesting levels
                expect(nesting_path[2]).to_contain("context")

    context "with matchers and hooks":
        it "combines hooks and matchers":
            # @req REQ-SSPEC-STD
            # @capture(statistics): combined hook-and-matcher probes retained
            step("assert one value through three matchers under hook management")
            val test_val = 6 * 7
            expect(test_val).to_equal(42)  # oracle: the hook-managed value must survive three matcher probes
            expect(test_val).to_be_greater_than(0)
            expect(test_val).to_be_less_than(100)

    it "supports multiple assertion types in one test":
        # @req REQ-SSPEC-STD
        # @capture(statistics): five-matcher probe results retained
        step("assert one message through five different matchers")
        val msg = "testing framework"
        expect(msg).to_contain("testing")
        expect(msg).to_start_with("testing")
        expect(msg).to_end_with("framework")
        expect(msg.len()).to_be_greater_than(0)
        expect(msg.len()).to_be_less_than(100)

    it "rejects a free-text skip under the critical profile":
        # @req REQ-STD-SPEC-INT-002
        # @capture(statistics): adverse free-text skip is refused
        step("Submit an unstructured skip reason to the critical gate")
        val rejection = validate_free_text_skip("waiting on infra retry window", "critical")
        expect(rejection.ok).to_equal(false)  # oracle: critical profile rejects free-text-only skip reasons
        expect(validate_bare_pending("critical").ok).to_equal(false)  # oracle: critical profile rejects bare pending markers

    context "with a before_each hook over a named setup helper":

    it "runs the hook before the first test":
        # @req REQ-STD-SPEC-HOOK-001
        # @capture(statistics): first post-hook example executes
        step("Execute the first example after the hook fires")
        val first_after_hook = check_text_contains(setup_framework_probe(), "group")
        expect(first_after_hook).to_equal(true)  # oracle: the example following the hook executed its helper probe

    it "runs the hook before the second test":
        # @capture(statistics): hook re-fires for the next sibling
        step("Execute the second example after the hook fires again")
        val second_after_hook = check_status_code(200, 200)
        expect(second_after_hook).to_equal(true)  # oracle: the second post-hook example executed its helper probe

    it "keeps every example fresh under the hook":
        # @capture(statistics): governance validator answers post-hook
        step("Query skip governance from a post-hook example")
        val fresh = validate_skip_it("critical")
        expect(fresh.ok).to_equal(false)  # oracle: critical profile rejects metadata-free skip_it, per skip_governance
