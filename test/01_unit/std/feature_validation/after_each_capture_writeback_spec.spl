"""
Regression for captured variable write-back from an after_each hook.

The module counter proves that the hook ran twice before either captured value
is inspected.  The flag and counter are checked in separate examples so one
failure cannot hide the other.
"""

use std.spec.*

var observed_hook_invocations = 0

describe "after_each captured variable write-back":
    var captured_flag = false
    var captured_counter = 0

    after_each:
        observed_hook_invocations += 1
        if observed_hook_invocations <= 2:
            captured_flag = true
            captured_counter += 1

    it "runs the first warm-up example":
        expect(observed_hook_invocations).to_equal(0)

    it "runs the second warm-up example":
        expect(observed_hook_invocations).to_equal(1)

    it "writes the captured flag after exactly two hook invocations":
        expect(observed_hook_invocations).to_equal(2)
        expect(captured_flag).to_equal(true)

    it "writes the captured counter twice":
        expect(captured_counter).to_equal(2)
