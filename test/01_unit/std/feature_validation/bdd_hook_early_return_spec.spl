"""
Regression coverage for local return semantics in BDD bodies and hooks.

A return exits only the current it/before_each/after_each block.  It must not
escape into the runner or prevent the next example from executing.
"""

use std.spec.*

var returned_body_count = 0
var returned_after_each_count = 0
var returned_before_each_count = 0

describe "BDD body and after_each local return":
    after_each:
        returned_after_each_count += 1
        return

    it "returns from the example body locally":
        returned_body_count += 1
        return

    it "continues after body and after_each returns":
        expect(returned_body_count).to_equal(1)
        expect(returned_after_each_count).to_equal(1)

describe "BDD before_each local return":
    before_each:
        returned_before_each_count += 1
        return

    it "continues into the example after before_each returns":
        expect(returned_before_each_count).to_equal(1)
