# Mock Library Tests (twin of test/unit/lib/common/mock_spec.spl)
# Feature: Mock/Spy/Stub framework for test doubles
# Category: Testing
# Status: Deduplicated
#
# This file used to be a near-byte-identical duplicate (593 lines) of
# test/unit/lib/common/mock_spec.spl (625 lines), each independently
# reimplementing CallInfo/CallRecorder/CallVerifier/StubEntry/Mock/Spy from
# scratch instead of importing the real `std.spec.mock` module — see
# doc/08_tracking/bug/mock_specs_shadow_callrecorder_callverifier_full_reimpl_2026-08-10.md.
#
# The full 41-case suite against the REAL Mock/Spy/Stub/CallRecorder/
# CallVerifier/ArgMatcher API now lives ONLY in
# test/unit/lib/common/mock_spec.spl (the canonical copy) to remove the
# duplicate-maintenance burden the bug doc flagged. This file keeps a small
# smoke test so the `test/unit/std/` mock coverage entry point still proves
# the real module loads and behaves from this location too.

use spec.{describe, it, expect}
use std.spec.mock.{Mock, Spy, Stub, CallRecorder, CallVerifier}

describe "Mock Library (std twin smoke test)":
    it "creates a mock, stubs it, and verifies the call was recorded":
        val m = Mock.new("Service")
        m.when("get").returns(42)
        expect m.call("get", []) == 42
        m.verify("get").was_called().verify()
        expect m.recorder.call_count("get") == 1

    it "creates a spy and records calls":
        val s = Spy.new("Service")
        s.record_call("ping", [])
        expect s.was_called("ping") == true

    it "creates a stub and stores values":
        val s = Stub.new("Config").set("k", 1)
        expect s.get("k") == 1

    it "records and verifies via CallRecorder/CallVerifier directly":
        var recorder = CallRecorder.new()
        recorder = recorder.record("m", [])
        val verifier = CallVerifier.new(recorder, "m")
        expect verifier.get_matching_calls().len() == 1
