"""
## Purpose and audience
Purpose: Verify Adler32 checksum behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/hash_3_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-HASH-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/hash_behavior.md
# doc-path: doc/03_plan/sys_test/hash_behavior.md
# doc-path: doc/04_architecture/lib/hash.md
# doc-path: doc/05_design/lib/hash_oracles.md
# @manual: primary

use std.spec
use std.hash.adler32.{adler32}
use std.spec.step

describe "Adler32 checksum behavior":
    it "adler32 empty-input identity and collision-free short inputs":
        step("Verify: adler32 empty-input identity and collision-free short inputs")
        # @req: REQ-LIB-HASH-001
        expect(adler32("")).to_equal(1)  # oracle: the adler32 checksum of the empty input is the standard identity 1
        expect((adler32("a") == adler32("b"))).to_equal(false)  # oracle: distinct inputs hash distinctly

