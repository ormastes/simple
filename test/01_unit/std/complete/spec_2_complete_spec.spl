use std.spec
use std.spec.step

describe "Spec matcher behavior":
    it "the expect matcher verifies equality and containment on real values":
        step("Verify: the expect matcher verifies equality and containment on real values")
        # @req: REQ-LIB-SPEC-001
        expect("Simple Language".contains("Language")).to_equal(true)
        expect("Simple Language").to_start_with("Simple")
        expect([1, 2, 3].len()).to_equal(3)  # oracle: the literal array has three elements

