# @req: REQ-LIB-TUPLE-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/tuple_behavior.md
# doc-path: doc/03_plan/sys_test/tuple_behavior.md
# doc-path: doc/04_architecture/lib/tuple.md
# doc-path: doc/05_design/lib/tuple_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Tuple positional access":
    it "tuple fields are accessed positionally and keep their types":
        step("Verify: tuple fields are accessed positionally and keep their types")
        # @req: REQ-LIB-TUPLE-001
        val pair = (1, "a")
        expect(pair[0]).to_equal(1)  # oracle: the first field is the integer
        expect(pair[1]).to_equal("a")  # oracle: the second field is the text

