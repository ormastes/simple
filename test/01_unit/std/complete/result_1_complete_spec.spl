"""
## Purpose and audience
Purpose: Verify Result carrier helpers through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/result_1_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-RESULT-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/result_behavior.md
# doc-path: doc/03_plan/sys_test/result_behavior.md
# doc-path: doc/04_architecture/lib/result.md
# doc-path: doc/05_design/lib/result_oracles.md
# @manual: primary

use std.spec
use std.result.{result_is_ok, result_is_err, result_unwrap_or}
use std.spec.step

describe "Result carrier helpers":
    it "result helpers distinguish the ok carrier from nil and unwrap with defaults":
        step("Verify: result helpers distinguish the ok carrier from nil and unwrap with defaults")
        # @req: REQ-LIB-RESULT-001
        expect(result_is_ok(42)).to_equal(true)  # oracle: a non-nil value is the ok carrier
        expect(result_is_ok(nil)).to_equal(false)  # oracle: nil is the error carrier
        expect(result_unwrap_or(7, 0)).to_equal(7)  # oracle: unwrapping ok keeps the value
        expect(result_unwrap_or(nil, 0)).to_equal(0)  # oracle: unwrapping the error carrier yields the default

