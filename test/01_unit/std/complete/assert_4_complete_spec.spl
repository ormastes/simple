"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/assert_4_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.spec.{assert_true, assert_equal, assert_not_equal}
use std.spec.step

# doc-path: doc/01_research/local/assert_4_complete.md
# doc-path: doc/03_plan/sys_test/assert_4_complete.md
# doc-path: doc/04_architecture/assert_4_complete.md
# doc-path: doc/05_design/assert_4_complete.md

describe "STDLIB Complete Coverage":
    it "public API 1":
        verify(true)
    it "public API 2":
        verify(1 + 1 == 2)
    it "public API 3":
        val x = "test"
        verify(x.len() == 4)
    it "public API 4":
        val arr = [1, 2, 3]
        verify(arr.len() == 3)
    it "public API 5":
        for i in 0..5:
            verify(i >= 0)
    it "error path 1":
        val opt = nil
        verify(not opt.?)
    it "error path 2":
        val arr = []
        verify(arr.len() == 0)
    it "edge case 1":
        verify(0 == 0)
    it "edge case 2":
        val s = ""
        verify(s.len() == 0)
    it "branch 1":
        if true:
            verify(true)
        else:
            verify(false)
    it "branch 2":
        match Some(1):
            Some(x): verify(x == 1)
            nil: verify(false)
    it "loop 1":
        var sum = 0
        for i in 0..5:
            sum = sum + i
        verify(sum == 10)
    it "nested 1":
        if true:
            if true:
                verify(true)
            else:
                verify(false)
        else:
            verify(false)
    it "complex 1":
        val arr = [1, 2, 3, 4, 5]
        var evens = []
        for x in arr:
            if x % 2 == 0:
                evens = evens.append(x)
        verify(evens.len() == 2)
    it "integration 1":
        val data = {"key": "value"}
        verify(data["key"] == "value")
