# @req: REQ-LIB-COLLECTIONS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/collections_behavior.md
# doc-path: doc/03_plan/sys_test/collections_behavior.md
# doc-path: doc/04_architecture/lib/collections.md
# doc-path: doc/05_design/lib/collections_oracles.md
# @manual: primary

use std.spec
use std.nogc_async_immut.persistent_set.{PersistentSet}
use std.spec.step

describe "Collection deduplication semantics":
    it "set-style collections keep one entry per distinct key":
        step("Verify: set-style collections keep one entry per distinct key")
        # @req: REQ-LIB-COLLECTIONS-001
        val s = PersistentSet.of(["a", "b", "a"])
        expect(s.to_array().len()).to_equal(2)  # oracle: only the distinct elements survive

