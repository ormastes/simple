use std.spec
use std.spec.step

describe "String interpolation":
    it "string interpolation renders embedded expressions":
        step("Verify: string interpolation renders embedded expressions")
        # @req: REQ-LIB-FORMAT-001
        val answer = 40
        expect(f"{answer} + 2").to_equal("40 + 2")  # oracle: the binding's value replaces the hole
        expect(f"{answer + 2}").to_equal("42")  # oracle: expressions are evaluated before rendering

