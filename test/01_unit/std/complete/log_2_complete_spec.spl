# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/log_2_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-LOG-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/log_behavior.md
# doc-path: doc/03_plan/sys_test/log_behavior.md
# doc-path: doc/04_architecture/lib/log.md
# doc-path: doc/05_design/lib/log_oracles.md
# @manual: primary

use std.spec
use std.log.{LOG_TRACE, LOG_INFO, LOG_ERROR, LOG_FATAL}
use std.spec.step

# doc-path: doc/01_research/local/log_2_complete.md
# doc-path: doc/03_plan/sys_test/log_2_complete.md
# doc-path: doc/04_architecture/log_2_complete.md
# doc-path: doc/05_design/log_2_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-STD-COMPLETE-001
        # @req: REQ-LIB-LOG-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])

    it "numeric comparison helpers":
        step("Verify: numeric comparison helpers")
        # @req: REQ-STD-COMPLETE-001
        expect(abs(-7)).to_equal(7)  # oracle: absolute value
        expect(max(3, 9)).to_equal(9)  # oracle: larger operand
        expect(min(3, 9)).to_equal(3)  # oracle: smaller operand

    it "integer arithmetic precedence":
        step("Verify: integer arithmetic precedence")
        # @req: REQ-STD-COMPLETE-001
        expect(2 + 3 * 4).to_equal(14)  # oracle: * binds tighter than +
        expect(10 - 2 * 3).to_equal(4)  # oracle: multiplication precedes subtraction
        expect((2 + 3) * 4).to_equal(20)  # oracle: parentheses force additive group first

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "truncating division and signed remainder":
        step("Verify: truncating division and signed remainder")
        # @req: REQ-STD-COMPLETE-001
        expect(7 / 2).to_equal(3)  # oracle: i64 division truncates toward zero
        expect(-7 / 2).to_equal(-3)  # oracle: truncation is toward zero
        expect(7 % 2).to_equal(1)  # oracle: remainder of positive dividend
        expect(-7 % 2).to_equal(-1)  # oracle: remainder keeps dividend sign

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-STD-COMPLETE-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-STD-COMPLETE-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right
