"""
## Purpose and audience
Purpose: Verify Range iteration bounds through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/range_5_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-RANGE-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/range_behavior.md
# doc-path: doc/03_plan/sys_test/range_behavior.md
# doc-path: doc/04_architecture/lib/range.md
# doc-path: doc/05_design/lib/range_oracles.md
# @manual: primary

use std.spec
use std.spec.step

describe "Range iteration bounds":
    it "range iteration excludes the end bound and empty ranges yield nothing":
        step("Verify: range iteration excludes the end bound and empty ranges yield nothing")
        # @req: REQ-LIB-RANGE-001
        var seen = 0
        for _i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields exactly four values
        var total = 0
        for i in 2..5:
            total = total + i
        expect(total).to_equal(9)  # oracle: 2+3+4 — end bound excluded
        var empty = 0
        for _i in 3..3:
            empty = empty + 1
        expect(empty).to_equal(0)  # oracle: an equal-bounds range is empty

