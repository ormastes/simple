# @req: REQ-LIB-FLAGS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/flags_behavior.md
# doc-path: doc/03_plan/sys_test/flags_behavior.md
# doc-path: doc/04_architecture/lib/flags.md
# doc-path: doc/05_design/lib/flags_oracles.md
# @manual: primary

use std.spec
use std.config_parser.{parse_sdn_config}
use std.spec.step

describe "Flag document parsing":
    it "a flags-style config document parses and retains its keys":
        step("Verify: a flags-style config document parses and retains its keys")
        # @req: REQ-LIB-FLAGS-001
        val cfg = parse_sdn_config("verbose = true\nlevel = 2")
        expect(cfg.?).to_equal(true)  # oracle: boolean and numeric flags both parse

