# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/iter_1_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-ITER-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/iter_behavior.md
# doc-path: doc/03_plan/sys_test/iter_behavior.md
# doc-path: doc/04_architecture/lib/iter.md
# doc-path: doc/05_design/lib/iter_oracles.md
# @manual: primary

use std.spec
use std.spec.step

# doc-path: doc/01_research/local/iter_1_complete.md
# doc-path: doc/03_plan/sys_test/iter_1_complete.md
# doc-path: doc/04_architecture/iter_1_complete.md
# doc-path: doc/05_design/iter_1_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-STD-COMPLETE-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "for-in accumulates array elements":
        step("Verify: for-in accumulates array elements")
        # @req: REQ-STD-COMPLETE-001
        var s = 0
        for x in [1, 2, 3]:
            s = s + x
        expect(s).to_equal(6)  # oracle: 1+2+3

    it "function calls and closure values":
        step("Verify: function calls and closure values")
        # @req: REQ-STD-COMPLETE-001
        fn add(a: i64, b: i64) -> i64: a + b
        expect(add(2, 3)).to_equal(5)  # oracle: 2+3
        val f = fn(x: i64) -> i64: x * x
        expect(f(4)).to_equal(16)  # oracle: 4 squared

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-STD-COMPLETE-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-STD-COMPLETE-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-STD-COMPLETE-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])
