"""
## Purpose and audience
Purpose: Verify Child process spawn and argv through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/process_3_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-PROCESS-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/process_behavior.md
# doc-path: doc/03_plan/sys_test/process_behavior.md
# doc-path: doc/04_architecture/lib/process.md
# doc-path: doc/05_design/lib/process_oracles.md
# @manual: primary

use std.spec
use std.io.{process_run}
use std.spec.step

describe "Child process spawn and argv":
    it "a spawned process receives argv and its exit status is reported":
        step("Verify: a spawned process receives argv and its exit status is reported")
        # @req: REQ-LIB-PROCESS-001
        val (stdout, _stderr, code) = process_run("/bin/echo", ["wave6"])
        expect(stdout).to_contain("wave6")  # oracle: the argument reaches the child's stdout
        expect(code).to_equal(0)  # oracle: a successful command exits 0

