# @req: REQ-STD-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/std/complete/list_4_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-LIST-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/list_behavior.md
# doc-path: doc/03_plan/sys_test/list_behavior.md
# doc-path: doc/04_architecture/lib/list.md
# doc-path: doc/05_design/lib/list_oracles.md
# @manual: primary

use std.spec
use std.spec.step

# doc-path: doc/01_research/local/list_4_complete.md
# doc-path: doc/03_plan/sys_test/list_4_complete.md
# doc-path: doc/04_architecture/list_4_complete.md
# doc-path: doc/05_design/list_4_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "sha256 known-answer vectors":
        step("Verify: sha256 known-answer vectors")
        # @req: REQ-STD-COMPLETE-001
        use std.common.crypto.sha256.{sha256_text}
        expect(sha256_text("abc")).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")  # oracle: FIPS 180-2 vector for "abc"
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")  # oracle: empty-input vector

    it "for-range iterates the half-open span":
        step("Verify: for-range iterates the half-open span")
        # @req: REQ-STD-COMPLETE-001
        var seen = 0
        for i in 0..4:
            seen = seen + 1
        expect(seen).to_equal(4)  # oracle: 0..4 yields four iterations

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-STD-COMPLETE-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-STD-COMPLETE-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")

    it "integer conversion helpers":
        step("Verify: integer conversion helpers")
        # @req: REQ-STD-COMPLETE-001
        expect(42.to_text()).to_equal("42")
        expect("42".parse_int()).to_equal(42)  # oracle: decimal parse

    it "var mutation is sequentially visible":
        step("Verify: var mutation is sequentially visible")
        # @req: REQ-STD-COMPLETE-001
        var acc = 1
        acc = acc + 1
        acc = acc * 10
        expect(acc).to_equal(20)  # oracle: (1+1)*10
