"""
## Purpose and audience
Purpose: Verify Async task lifecycle states through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/complete/async_4_complete_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-ASYNC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/async_behavior.md
# doc-path: doc/03_plan/sys_test/async_behavior.md
# doc-path: doc/04_architecture/lib/async.md
# doc-path: doc/05_design/lib/async_oracles.md
# @manual: primary

use std.spec
use std.async_core.{TaskState}
use std.spec.step

describe "Async task lifecycle states":
    it "task lifecycle states are distinct enum values":
        step("Verify: task lifecycle states are distinct enum values")
        # @req: REQ-LIB-ASYNC-001
        val st = TaskState.Pending
        expect((st == TaskState.Running)).to_equal(false)  # oracle: a pending task is not running
        expect((st == TaskState.Pending)).to_equal(true)  # oracle: enum equality is by value

