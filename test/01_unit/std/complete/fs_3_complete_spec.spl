# @manual: primary

use std.spec
use std.nogc_sync_mut.io.file_ops.{file_exists}
use std.spec.step

describe "Filesystem existence checks":
    it "file_exists distinguishes present paths from absent ones":
        step("Verify: file_exists distinguishes present paths from absent ones")
        # @req: REQ-LIB-FS-001
        expect(file_exists("src")).to_equal(true)  # oracle: the repo source tree exists relative to the runner cwd
        expect(file_exists("/no/such/path/wave6")).to_equal(false)  # oracle: an absent path reports false, no panic

