# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
#
# Reproduce spec for the command-word quoting defect in
# std.io.process_ops._process_run_with_limits (todo_db row 573).
#
# The limits path builds a `/bin/sh -c` string. Arguments were single-quote
# escaped but the COMMAND WORD was interpolated raw, so a command path
# containing a space word-split and the child exited 127 with empty stdout.
# The app mirror (src/app/io/process_ops.spl) already escaped it; the lib copy
# did not. Baseline `process_run` (execve, no shell) is unaffected.

use std.spec.step
use std.io.process_ops.{process_run_with_limits}
use std.io_runtime.{file_write, file_exists, dir_create_all}

fn _dir() -> text:
    "/tmp/simple_pruwl_repro/space dir"

fn _exe() -> text:
    "{_dir()}/echoer.sh"

fn _install():
    dir_create_all(_dir())
    file_write(_exe(), "#!/bin/sh\necho \"OUT=[$1]\"\n")
    process_run_with_limits("/bin/chmod", ["755", _exe()], 5000, 0, 0, 0, 0)

describe "process_run_with_limits command-word quoting":
    # @manual scenario evidence
    it "runs a command whose path contains a space and captures its stdout":
        # @req REQ-SSPEC-UNIT
        step("runs a command whose path contains a space and captures its stdout")
        _install()
        expect(file_exists(_exe())).to_be_true()
        val r = process_run_with_limits(_exe(), ["hello world"], 5000, 0, 0, 0, 0)
        expect(r.exit_code).to_equal(0)
        expect(r.stdout).to_contain("OUT=[hello world]")
