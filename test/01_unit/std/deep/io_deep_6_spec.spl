"""
## Purpose and audience
Purpose: Verify Wall-clock millisecond reads through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/io_deep_6_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-IO-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/io_behavior.md
# doc-path: doc/03_plan/sys_test/io_behavior.md
# doc-path: doc/04_architecture/lib/io.md
# doc-path: doc/05_design/lib/io_oracles.md
# @manual: primary

use std.spec
use std.io.{current_time_ms}
use std.spec.step

describe "Wall-clock millisecond reads":
    it "current_time_ms reports a positive wall clock":
        step("Verify: current_time_ms reports a positive wall clock")
        # @req: REQ-LIB-IO-001
        expect((current_time_ms() > 0)).to_equal(true)  # oracle: epoch milliseconds are positive

