"""
## Purpose and audience
Purpose: Verify JSON decode behavior through executable runtime oracles against the real implementation.
Audience: library and compiler engineers who run the spec suite.

## Operator workflow
Run `bin/simple test /tmp/mod13/test/unit/std/deep/json_deep_17_spec.spl` and require the final Results line to report 0 failed.

## Compatibility and limitations
Executed on the interpreter test lane; asserts observable values only and makes no performance claims.
"""

# @req: REQ-LIB-JSON-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/json_behavior.md
# doc-path: doc/03_plan/sys_test/json_behavior.md
# doc-path: doc/04_architecture/lib/json.md
# doc-path: doc/05_design/lib/json_oracles.md
# @manual: primary

use std.spec
use std.text.{escape_json}
use std.spec.step

describe "JSON decode behavior":
    it "JSON string escaping quotes, backslashes and control characters":
        step("Verify: JSON string escaping quotes, backslashes and control characters")
        # @req: REQ-LIB-JSON-001
        expect(escape_json("say \"hi\"")).to_contain("\\\"")  # oracle: double quotes become escaped quotes
        expect(escape_json("a\nb")).to_contain("\\n")  # oracle: newline becomes the two-character escape
        expect(escape_json("back\\slash")).to_contain("\\\\")  # oracle: a literal backslash is doubled

