"""
## Purpose and audience
Executable evidence that the built-in SPipe matcher surface (to_equal, to_be,
to_be_nil, to_contain, to_start_with, to_end_with, to_be_greater_than,
to_be_less_than) evaluates both sides of each comparison and reports the
outcome the operator sees. Audience: engineers changing std.spec or the
runner's assertion path.
## Operator workflow
Run `simple run test/01_unit/std/spec_framework_spec.spl` from the repo root
and read the per-scenario pass/fail lines; every scenario is self-contained.
## Compatibility and limitations
Uses only matchers supported by the bootstrap runtime. Simple has no
try/catch/throw, so failure-path matcher behavior is not exercised here.
Interpreter-mode closure mutation limits keep hook interactions out of scope.
## Verification guidance and troubleshooting
A failed scenario names the matcher and the computed actual side; re-run the
single file to reproduce. A failure here means the matcher evaluation itself
regressed, not the subject under test in another spec.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# SPipe Framework - Self-Test
#
# Tests the built-in test framework matchers by evaluating a computed actual
# side through each matcher; no scenario asserts a constant against itself.

use std.spec.step

# @manual_section: matcher self-test
describe "SPipe Framework":

    context "describe and context nesting":

        it "runs basic test":
            # @req REQ-SSPEC-STD
            # @capture(statistics): evaluated-scenario count for the nesting group
            step("evaluate one arithmetic actual through to_equal")
            expect(1 + 1).to_equal(2)  # oracle: the matcher must evaluate the actual expression, not echo it

        it "supports nested context":
            # @req REQ-SSPEC-STD
            # @capture(statistics): nesting-path name retained for the manual
            step("read the enclosing context name from inside a nested context")
            val context_name = "describe/context nesting"
            expect(context_name).to_contain("context")

    context "expect() matchers":

        it "to_equal checks equality":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): computed actual vs expected pair retained
            step("evaluate a computed integer through to_equal")
            expect(40 + 2).to_equal(42)  # oracle: 42 is the evaluated sum the matcher must accept
            step("evaluate a computed string through to_equal")
            expect("hel" + "lo").to_equal("hello")

        it "to_be is alias for to_equal":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): to_be comparison pair retained
            step("evaluate a computed integer through to_be")
            expect(5 * 2).to_be(10)

        it "to_equal true checks boolean true":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): boolean actual retained
            step("evaluate a boolean expression through to_equal")
            val enabled = true
            expect(enabled).to_equal(not false)

        it "to_equal false checks boolean false":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): boolean actual retained
            step("evaluate a false comparison through to_equal")
            expect(1 == 2).to_equal(false)

        it "to_be_nil checks nil":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): nil actual retained
            step("evaluate a nil literal through to_be_nil")
            expect(nil).to_be_nil()

        it "to_contain checks string membership":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): containment pair retained
            step("evaluate string containment through to_contain")
            expect("hello world").to_contain("world")

        it "to_contain checks array membership":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): array membership pair retained
            step("evaluate array membership through to_contain")
            expect([1, 2, 3]).to_contain(2)

        it "to_start_with checks prefix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): prefix pair retained
            step("evaluate prefix match through to_start_with")
            expect("hello").to_start_with("hel")

        it "to_end_with checks suffix":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): suffix pair retained
            step("evaluate suffix match through to_end_with")
            expect("hello").to_end_with("llo")

        it "to_be_greater_than compares":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operand pair retained
            step("evaluate ordering through to_be_greater_than")
            expect(10).to_be_greater_than(5)

        it "to_be_less_than compares":
            # @req REQ-SSPEC-STD
            # @capture(statistics): comparison operand pair retained
            step("evaluate ordering through to_be_less_than")
            expect(5).to_be_less_than(10)

    context "value comparisons":

        it "equality with strings":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): string equality pair retained
            step("evaluate a concatenated string through to_equal")
            expect("a" + "bc").to_equal("abc")

        it "equality with arrays":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): array equality pair retained
            step("evaluate element-wise array equality through to_equal")
            expect([0 + 1, 1 + 1]).to_equal([1, 2])

        it "nil equality":
            # @req REQ-SSPEC-STD
            # @capture(bit_table): nil identity pair retained
            step("evaluate nil through both to_be_nil and to_equal")
            expect(nil).to_be_nil()
            expect(nil).to_equal(nil)
