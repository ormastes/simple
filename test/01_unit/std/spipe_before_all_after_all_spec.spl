# @tag:unit, spec
"""
## Purpose and audience
Verifies that suite-scoped lifecycle hooks (`before_all`, `after_all`) work correctly when imported through
the `std.nogc_async_mut.spipe` alias module. Targets the hardware-lane spec author (t32_hw) who needs
these hooks to initialize and clean up shared test resources once per group.

## Operator workflow
Run the spec with `bin/simple test test/01_unit/std/spipe_before_all_after_all_spec.spl` and verify
that the suite executes all three examples and reports them in the test runner results without errors.

## Compatibility and limitations
Requires the test runner to support lifecycle hooks at the context scope. Works with the current
std.spec implementation. Does not test nested context scopes or multiple describe blocks with independent hooks.

## Verification guidance and troubleshooting
If the test fails, verify that `before_all` ran exactly once before the first scenario and `after_all`
ran exactly once after the entire group. The `order` array retains the execution sequence. Check the
runner's `Results:` line to confirm exactly 3 examples executed.
"""
# Lifecycle: doc/01_research/domain/spec_to_spipe_toolchain.md ;
# doc/03_plan/agent_tasks/spipe_knowledge_compiler.md ;
# doc/04_architecture/app/spec_to_spipe.md ;
# doc/05_design/app/spec_to_spipe_evidence_extension.md
# @manual_section: lifecycle_hooks

use std.nogc_async_mut.spipe

var order: [text] = []

describe "spipe before_all / after_all":
    before_all:
        order.push("before_all")

    after_all:
        order.push("after_all")

    it "sees before_all already executed":
        # @req REQ-SPIPE-001
        # @capture(bit_table): order array contents after first scenario
        step("Verify before_all executed exactly once")
        assert_equal(order.len(), 1)
        assert_equal(order[0], "before_all")

    it "does not re-run before_all for the second example":
        # @req REQ-SPIPE-002
        # @capture(bit_table): order array size remains 1
        step("Verify before_all did not run again")
        assert_equal(order.len(), 1)

describe "spipe after_all drain point (declared after the group above)":
    it "ran the previous group's after_all when that group ended":
        # @req REQ-SPIPE-003
        # @capture(bit_table): order array with before_all and after_all entries
        step("Verify after_all executed once after the first group")
        assert_contains(order.join(","), "after_all")
        assert_equal(order.len(), 2)  # oracle: before_all + after_all
        assert_equal(order[1], "after_all")
