# @tag:unit, spec
"""
# `before_all` / `after_all` Resolve Through the `std.spipe` Alias Module

As a hardware-lane spec author (t32_hw), I import the spec DSL through
`std.nogc_async_mut.spipe` and need suite-scoped `before_all` / `after_all`
hooks to resolve. They were absent from `std.spec` entirely, so the name was
unresolved, the file died at load, and the lane ran ZERO examples while
reporting no failures.

Oracle: `before_all` must have run before the first `it` in its group, and
`after_all` must run after the group's body -- observed through a
module-level marker list. Declaring exactly 3 examples, so the runner's
`Results:` line must report 3 total.
"""

use std.nogc_async_mut.spipe

var order: [text] = []

describe "spipe before_all / after_all":
    before_all:
        order.push("before_all")

    after_all:
        order.push("after_all")

    it "sees before_all already executed":
        assert_equal(order.len(), 1)
        assert_equal(order[0], "before_all")

    it "does not re-run before_all for the second example":
        assert_equal(order.len(), 1)

describe "spipe after_all drain point (declared after the group above)":
    it "ran the previous group's after_all when that group ended":
        assert_contains(order.join(","), "after_all")
        assert_equal(order.len(), 2)
        assert_equal(order[1], "after_all")
