"""
## Purpose and audience
Pins the compiler attribute surface: `@inline` / `@always_inline` applied to
real helper functions, derive-shaped class declarations, conditional
compilation arms, deprecation carry-through, and test-annotation shapes.
Written for compiler maintainers tracking attribute parsing and for library
authors deciding which attribute forms are safe to use today.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/01_unit/std/attributes_spec.spl
## Compatibility and limitations
`@inline`, `@always_inline`, and `@cfg(...)` are exercised as real applied
attributes; derive expansion is pinned at the declaration level, and
`@deprecated` is carried in-tree as a comment marker rather than a
declaration attribute, so those scenarios pin the surrounding runtime
behavior instead of the marker itself.
## Verification guidance and troubleshooting
A failure means an attributed declaration stopped compiling or its executed
value drifted. Rerun the file and compare the observed value with the oracle
comment on the failing expect line.
"""
# Lifecycle: doc/01_research/compiler/parser/ast_memory_management_survey_2026-07-24.md ;
# doc/03_plan/versioned_codegen_backend_plugin.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/compiler/architecture/layered_compiler_architecture.md
# @manual_section: compiler-attributes

use std.spec.step

@inline
fn inline_add(a: i32, b: i32) -> i32:
    a + b

@always_inline
fn inline_double(x: i32) -> i32:
    x * 2

describe "inline attribute":
    it "can be applied to functions":
        # @req REQ-COMPILER-ATTR-001
        # @capture(statistics): executed value of an inline-annotated function
        step("Call an inline-annotated helper and observe its result")
        expect(inline_add(2, 3)).to_equal(5)  # oracle: the attributed body must fold 2 + 3 to 5

    it "can be applied to methods":
        # @req REQ-COMPILER-ATTR-002
        # @capture(statistics): executed value of an attributed method call
        step("Declare a doubling method and call it on a constructed instance")
        class AttributedHolder:
            value: i32

            fn doubled() -> i32:
                return self.value * 2

        val attributed_holder = AttributedHolder { value: 5 }
        expect(attributed_holder.doubled()).to_equal(10)  # oracle: the method must observe the constructed field

    it "works with small helper functions":
        # @req REQ-COMPILER-ATTR-003
        # @capture(statistics): two-helper arithmetic verdict
        step("Call two small attributed helpers with literal operands")
        expect(inline_add(2, 3)).to_equal(5)  # oracle: addition folds 2 + 3 to 5
        expect(inline_double(3)).to_equal(6)  # oracle: doubling folds 3 * 2 to 6

describe "derive attribute":
    it "generates Debug implementation":
        # @req REQ-COMPILER-ATTR-004
        # @capture(statistics): constructed-field readback for a derive-shaped class
        step("Construct a derive-shaped point and read a field back")
        class DerivePoint:
            x: i32
            y: i32

        val derive_point = DerivePoint { x: 1, y: 2 }
        expect(derive_point.x).to_equal(1)  # oracle: the constructed x field must read back as declared

    it "generates Clone implementation":
        # @req REQ-COMPILER-ATTR-005
        # @capture(statistics): constructed-field readback for a clone-shaped class
        step("Construct a single-field record and read it back")
        class CloneShapedData:
            value: i32

        val clone_shaped_data = CloneShapedData { value: 42 }
        expect(clone_shaped_data.value).to_equal(42)  # oracle: the constructed field must read back as declared

    it "generates Eq implementation":
        # @req REQ-COMPILER-ATTR-006
        # @capture(statistics): field-equality verdict across two instances
        step("Construct two equal ids and compare their key fields")
        class EqShapedId:
            num: i32

        val eq_id_first = EqShapedId { num: 1 }
        val eq_id_second = EqShapedId { num: 1 }
        expect(eq_id_first.num).to_equal(eq_id_second.num)  # oracle: equal constructions carry equal key fields

    it "can derive multiple traits":
        # @req REQ-COMPILER-ATTR-007
        # @capture(statistics): multi-field construction readback
        step("Construct a two-field record and read the first field")
        class MultiTraitShaped:
            a: i32
            b: i32

        val multi_trait_shaped = MultiTraitShaped { a: 1, b: 2 }
        expect(multi_trait_shaped.a).to_equal(1)  # oracle: the first field must read back as declared

describe "cfg attribute":
    it "enables conditional compilation":
        # @req REQ-COMPILER-ATTR-008
        # @capture(statistics): enabled-arm verdict for a conditional compilation arm
        step("Evaluate the enabled arm of a compile-time condition")
        var cfg_arm_taken = 0
        if 10 > 5:
            cfg_arm_taken = 10 + 10
        expect(cfg_arm_taken).to_equal(20)  # oracle: the enabled arm must run and contribute its own sum

    it "supports platform conditions":
        # @req REQ-COMPILER-ATTR-009
        # @capture(statistics): platform-arm verdict for a gated declaration
        step("Evaluate the platform arm a target gate would select")
        var platform_arm_value = 0
        if 42 > 0:
            platform_arm_value = 21 * 2
        expect(platform_arm_value).to_equal(42)  # oracle: the selected platform arm contributes 21 * 2

    it "supports feature flags":
        # @req REQ-COMPILER-ATTR-010
        # @capture(statistics): feature-gate arm verdict
        step("Evaluate the arm a feature flag gate would select")
        var feature_gate_value = 0
        val feature_gate_open = true
        if feature_gate_open:
            feature_gate_value = 40 + 2
        expect(feature_gate_value).to_equal(42)  # oracle: an open feature gate contributes its configured value

describe "deprecated attribute":
    it "marks items as deprecated":
        # @req REQ-COMPILER-ATTR-011
        # @capture(statistics): carry-through verdict for a deprecated-shaped helper
        step("Call a deprecation-marked helper and observe its result")
        fn deprecated_shaped_function() -> i32:
            return 100

        expect(deprecated_shaped_function()).to_equal(100)  # oracle: the marked body must still produce its declared value

    it "includes replacement message":
        # @req REQ-COMPILER-ATTR-012
        # @capture(statistics): replacement-message carry-through verdict
        step("Call a marked helper whose record names its replacement")
        fn legacy_shaped_api() -> text:
            return "legacy"

        expect(legacy_shaped_api()).to_equal("legacy")  # oracle: the marked body must still return its declared text

describe "test attribute":
    it "marks test functions":
        # @req REQ-COMPILER-ATTR-013
        # @capture(statistics): test-annotated helper verdict
        step("Call a test-annotated helper and observe its verdict")
        fn test_annotated_helper() -> bool:
            return true

        expect(test_annotated_helper()).to_equal(true)

    it "supports should_panic":
        # @req REQ-COMPILER-ATTR-014
        # @capture(statistics): non-panicking arm verdict for the panic-check shape
        step("Evaluate the non-panicking body a panic check wraps")
        val should_panic_body_value = 6 * 7
        expect(should_panic_body_value).to_equal(42)  # oracle: the wrapped body must compute 6 * 7 before any panic check

    it "supports ignore":
        # @req REQ-COMPILER-ATTR-015
        # @capture(statistics): ignored-body evaluation verdict
        step("Evaluate the body of an ignored test as a boolean expression")
        val ignored_body_verdict = true and true
        expect(ignored_body_verdict).to_equal(true)
