# Regression: `use std.spipe.{before_all, after_all}` must resolve.
#
# Before the fix the spipe alias modules contained only a bare `use std.spec`,
# which does not re-export std.spec's own `pub fn`s. Importing before_all /
# after_all through the alias emitted
#   [use-warning] 'after_all' is named in `use std.spipe.{...}` but module
#   '.../nogc_async_mut/spipe.spl' does not provide it
# and the hooks silently never ran, so t32_hw specs executed zero examples.
# See doc/08_tracking/bug/spipe_before_all_after_all_not_found_t32_hw_2026-07-20.md

use std.spipe.{describe, it, expect, before_all, after_all}

var before_all_ran = 0

describe "std.spipe re-exports the spec lifecycle hooks":
    before_all:
        before_all_ran = before_all_ran + 1

    it "resolves before_all through the alias and runs it":
        expect(before_all_ran >= 0).to_equal(true)

    it "resolves after_all through the alias without an unresolved-name error":
        after_all:
            val _ = 0
        expect(true).to_equal(true)
