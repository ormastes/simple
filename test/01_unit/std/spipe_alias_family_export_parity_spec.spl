# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Class detection for the spipe-alias export gap.
#
# Every runtime-family alias module under src/lib/*/spipe.spl must actually
# re-export the std.spec lifecycle hooks, not merely `use std.spec`. A bare
# `use` is not a re-export, so a new alias family added without an explicit
# export list would silently reintroduce
# doc/08_tracking/bug/spipe_before_all_after_all_not_found_t32_hw_2026-07-20.md

use std.spec.step

use std.spec.{describe, it, expect}
use std.fs.{read_file}


fn _alias_reexports(path: text) -> bool:
    val src = read_file(path)
    # Either an explicit export list, or a star re-export facade.
    return src.contains("export before_all") or src.contains("export use ")

describe "spipe alias modules re-export lifecycle hooks":
    # @manual scenario evidence
    it "nogc_sync_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        step("nogc_sync_mut alias re-exports")
        expect(_alias_reexports("src/lib/nogc_sync_mut/spipe.spl")).to_equal(true)

    it "nogc_async_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        step("nogc_async_mut alias re-exports")
        expect(_alias_reexports("src/lib/nogc_async_mut/spipe.spl")).to_equal(true)

    it "gc_async_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        step("gc_async_mut alias re-exports")
        expect(_alias_reexports("src/lib/gc_async_mut/spipe.spl")).to_equal(true)

    it "gc_sync_mut alias re-exports":
        # @req REQ-SSPEC-UNIT
        step("gc_sync_mut alias re-exports")
        expect(_alias_reexports("src/lib/gc_sync_mut/spipe.spl")).to_equal(true)
