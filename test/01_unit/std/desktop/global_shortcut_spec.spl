# @manual: primary
# @req: REQ-TEST-DESKTOP_GLOBAL_SHORTCUT-001
# doc-path: doc/01_research/os/x86_desktop/x86_dual_arch_qemu_boot.md
# doc-path: doc/03_plan/os/misc/x86_64_desktop_driver_completion.md
# doc-path: doc/04_architecture/os/x86_64_desktop_driver_completion.md
# doc-path: doc/05_design/os/desktop/tmux_simpleos.md
# Desktop global shortcut API specification

use std.spec.step
use std.nogc_sync_mut.desktop.global_shortcut.{Shortcut}

describe "Desktop Global Shortcut API":
    it "creates Shortcut struct":
        # @req: REQ-TEST-DESKTOP_GLOBAL_SHORTCUT-001
        step("Verify: creates Shortcut struct")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val s = Shortcut(modifiers: ["ctrl", "shift"], key: "p")
        expect s.key == "p"
