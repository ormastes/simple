"""
# @manual: primary
# @req: REQ-TEST-DESKTOP_DISPLAY-001
# doc-path: doc/01_research/os/x86_desktop/x86_dual_arch_qemu_boot.md
# doc-path: doc/03_plan/sys_test/css_display_invalid_cascade.md
# doc-path: doc/04_architecture/os/x86_64_desktop_driver_completion.md
