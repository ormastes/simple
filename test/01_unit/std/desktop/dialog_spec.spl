"""
# @manual: primary
# @req: REQ-TEST-DESKTOP_DIALOG-001
# doc-path: doc/01_research/os/x86_desktop/x86_dual_arch_qemu_boot.md
# doc-path: doc/03_plan/os/misc/x86_64_desktop_driver_completion.md
# doc-path: doc/04_architecture/os/x86_64_desktop_driver_completion.md
# doc-path: doc/05_design/os/desktop/tmux_simpleos.md
# Desktop dialog API specification

use std.spec.step
use std.nogc_sync_mut.desktop.dialog.{DialogOptions, DialogFilter}

describe "Desktop Dialog API":
    it "creates DialogFilter struct":
        # @req: REQ-TEST-DESKTOP_DIALOG-001
        step("Verify: creates DialogFilter struct")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val f = DialogFilter(name: "Images", patterns: ["*.png", "*.jpg"])
        expect f.name == "Images"

    it "creates DialogOptions struct":
        # @req: REQ-TEST-DESKTOP_DIALOG-001
        step("Verify: creates DialogOptions struct")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        val opts = DialogOptions(title: "Open", default_path: "", filters: [], multiple: false)
        expect opts.title == "Open"
        expect opts.multiple == false
