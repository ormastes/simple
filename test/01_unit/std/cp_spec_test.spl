use std.config_parser.{parse_sdn_config}

# The describe block must live at module top level. It was previously nested
# inside a `fn test():` that nothing ever called, so no example was registered
# and the runner reported "no examples executed" — a dead entry point.
describe "config_parser":
    it "parses one section":
        val content = "section1:\n  key1: val1"
        val result = parse_sdn_config(content)
        expect(result.sections.len()).to_equal(1)

    it "parses two sections":
        val content = "s1:\n  k1: v1\ns2:\n  k2: v2"
        val result = parse_sdn_config(content)
        expect(result.sections.len()).to_equal(2)
