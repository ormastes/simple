# @cover src/lib/nogc_sync_mut/spec/evidence/counterpart/compress_gzip_provider.spl 85%
# @req REQ-COUNTERPART-P2-001
# @req REQ-COUNTERPART-Z1-001
"""
# Counterpart Conformance — gzip/DEFLATE vs the real system `gzip` CLI

**Category:** Infrastructure
**Status:** In Progress
**Plan:** doc/03_plan/infra/counterpart/counterpart_conformance_parallel_agent_plan_2026-08-09.md (Wave 2 P2 "DEFLATE provider", Wave 5 Z1)

## Purpose and Audience

Proves Simple's own gzip/DEFLATE codec
(`src/lib/nogc_sync_mut/compression/gzip/compress.spl`) against the real
`/usr/bin/gzip` CLI, genuinely executed as a process bridge. The audience is
an engineer deciding whether Simple's compressed output can be trusted to
interoperate with the rest of the world, and whether Simple's decoder is safe
to point at attacker-controlled input.

## Scope and Preconditions

One boundary (`compress.codec.gzip@1`), two independence groups:
`simple-gzip-native` (Simple's pure-Simple implementation) and
`gzip-cli-process` (the real system `gzip` binary). Compressed BYTES are never
compared byte-for-byte between the two — two correct encoders legitimately
choose different matches/strategies for the same input, so `byte_exact` on
compressed output would manufacture false failures. Instead this spec proves
the two relations that are actually true properties of a correct codec:

  * `cross_decode` — one side compresses, the OTHER decompresses, and the
    recovered bytes equal the original input, in BOTH directions.
  * `round_trip`   — Simple compresses then decompresses its own output and
    recovers the input exactly.

## Primary Workflow

`compress_gzip_provider` runs a fixed set of hostile test vectors (empty,
single byte, highly repetitive, mixed text, pseudo-random/incompressible)
through both directions of `cross_decode` plus `round_trip`, tallies real
executed/failed counts, and feeds them to the shared relation engine
(`RelationFacts` + `evaluate_relation`) exactly as the design's counted-relation
contract requires (design §7). Payload bytes cross the process boundary only
via files (`File.read_bytes`/`File.write_bytes`), never through `text`, because
`text` in Simple is UTF-8-constrained and an arbitrary compressed byte stream
is not valid UTF-8.

## What must never happen

A corrupted compressed stream must be REJECTED — a nonzero exit code from the
real `gzip` CLI, or `nil` from Simple's decoder — never silently accepted as a
truncated-but-successful decode. An unavailable `gzip` binary must never be
absorbed into a pass; it must show up in the run's rejection list.

## Related Specifications

- [Relation and matrix engine](relation_matrix_spec.spl)
- [Cipher counterpart compare (sibling lane)](cipher_counterpart_compare_spec.spl)

## Evidence and Provenance

Executable against
`src/lib/nogc_sync_mut/spec/evidence/counterpart/compress_gzip_provider.spl`.

## Compatibility and Limitations

Requires `/usr/bin/gzip` on the host running the spec (verified present on
this host). The unavailable-provider scenario proves the framework reacts
correctly when that binary is absent, rather than skipping silently.
"""

use std.spec.*
use std.common.spec.evidence.counterpart.model.{
    LogicalArtifact, ExecutionMode, ExecutionReceipt, ProvenanceReceipt,
    ProviderStatus, CounterpartRelation, ConversionLoss, SourceResult,
    CounterpartRun, logical_artifact, execution_receipt_cpu
}
use std.common.spec.evidence.counterpart.evidence_projection.{
    counterpart_run_to_evidence
}
use std.nogc_sync_mut.spec.evidence.counterpart.relation_engine.{
    RelationInput, RelationFacts, relation_input, relation_input_with_facts,
    evaluate_relation, relation_facts
}
use std.nogc_sync_mut.spec.evidence.counterpart.compress_gzip_provider.{
    COMPRESS_GZIP_BOUNDARY, GZIP_DEFAULT_PATH, gzip_binary_available,
    compress_gzip_artifact, cross_decode_candidate_to_counterpart,
    cross_decode_counterpart_to_candidate, round_trip_candidate,
    default_test_cases, case_repetitive, bytes_equal, flip_byte,
    counterpart_gzip_decompress_file, counterpart_gzip_compress_file,
    gzip_decode_checked, write_bytes_or_fail, read_bytes_or_empty
}
use std.nogc_sync_mut.compression.gzip.compress.{gzip_compress}

val TMP_DIR: text = "/tmp/simple_compress_counterpart"
val TIMEOUT_MS: i64 = 15000

# Module-qualified `fs.exists`/`fs.dir_create` calls hit the interpreter's
# cross-module name-resolution arity landmine (they resolve against the
# 0-argument `Path.exists()` methods); go through the runtime externs the way
# artifact_store.spl does.
extern fn rt_file_exists(path: text) -> bool
extern fn rt_dir_create(path: text, recursive: bool) -> bool

fn ensure_tmp_dir() -> bool:
    if not rt_file_exists(TMP_DIR):
        rt_dir_create(TMP_DIR, true)
    rt_file_exists(TMP_DIR)

fn counted_cell(relation: CounterpartRelation, facts: RelationFacts) -> bool:
    val left = compress_gzip_artifact(default_test_cases().len(), "left")
    val right = compress_gzip_artifact(default_test_cases().len(), "right")
    val base = relation_input(
        "simple", "gzip-cli", relation, ConversionLoss.identity, left, right)
    val input = relation_input_with_facts(base, facts)
    val cell = evaluate_relation(input)
    cell.matched

fn source_ok(source_id: text, provider_id: text, group: text) -> SourceResult:
    SourceResult(
        source_id: source_id,
        provider_id: provider_id,
        independence_group: group,
        status: ProviderStatus.executed,
        artifact: compress_gzip_artifact(5, source_id),
        execution: execution_receipt_cpu(provider_id),
        provenance: ProvenanceReceipt(
            package_manifest_hash: "compress-gzip-lane/no-package-manager",
            provider_manifest_hash: "compress-gzip-lane/descriptor-v1",
            input_hash: "default-cases",
            converter_route_hash: "identity",
            environment_profile: "host-cpu",
            run_id: source_id
        ),
        conversions: [],
        diagnostics: []
    )

fn source_unavailable(source_id: text, provider_id: text, group: text, reason: text) -> SourceResult:
    var result = source_ok(source_id, provider_id, group)
    result.status = ProviderStatus.unavailable
    result.artifact = logical_artifact(COMPRESS_GZIP_BOUNDARY, "", 0, 0, "", "")
    result.diagnostics = [reason]
    result


describe "gzip counterpart run: Simple vs the real gzip CLI":
    it "confirms the real gzip binary is genuinely present on this host":
        step("Check the pinned path")
        assert_true(gzip_binary_available(GZIP_DEFAULT_PATH))

    it "proves cross_decode in the Simple-compresses / gzip-decompresses direction":
        step("Ensure the working directory exists")
        assert_true(ensure_tmp_dir())

        step("Run every hostile test vector through Simple compress -> real gzip -d")
        val facts = cross_decode_candidate_to_counterpart(
            GZIP_DEFAULT_PATH, default_test_cases(), TMP_DIR, TIMEOUT_MS)

        step("All cases executed and none failed")
        assert_equal(facts.executed, default_test_cases().len())
        assert_equal(facts.failed, 0)

        step("The relation engine's counted evaluation agrees")
        assert_true(counted_cell(CounterpartRelation.cross_decode, facts))

    it "proves cross_decode in the real-gzip-compresses / Simple-decompresses direction":
        step("Run every hostile test vector through real gzip -> Simple decompress")
        val facts = cross_decode_counterpart_to_candidate(
            GZIP_DEFAULT_PATH, default_test_cases(), TMP_DIR, TIMEOUT_MS)

        step("All cases executed and none failed")
        assert_equal(facts.executed, default_test_cases().len())
        assert_equal(facts.failed, 0)

        step("The relation engine's counted evaluation agrees")
        assert_true(counted_cell(CounterpartRelation.cross_decode, facts))

    it "proves round_trip: Simple compresses then decompresses its own output":
        step("Run every hostile test vector through Simple compress -> Simple decompress")
        val facts = round_trip_candidate(default_test_cases())

        step("All cases executed and none failed")
        assert_equal(facts.executed, default_test_cases().len())
        assert_equal(facts.failed, 0)

        step("The relation engine's counted evaluation agrees")
        assert_true(counted_cell(CounterpartRelation.round_trip, facts))

    it "reports real, non-trivial compression on highly repetitive input":
        step("Compress 4000 repeated bytes with Simple's gzip codec")
        val original = case_repetitive(4000)
        val compressed = gzip_compress(original, 6)

        step("The compressed form is drastically smaller than the input")
        assert_true(compressed.len() < original.len())
        assert_true(compressed.len() > 0)


describe "gzip counterpart run: corruption must be rejected, never silently accepted":
    it "rejects a bit-flipped Simple-produced stream when the real gzip CLI decodes it":
        step("Ensure the working directory exists")
        assert_true(ensure_tmp_dir())

        step("Compress a real payload with Simple, then flip one byte inside the DEFLATE body")
        val original = case_repetitive(4000)
        val compressed = gzip_compress(original, 6)
        # Byte 10 is inside the deflate payload (gzip header is 10 bytes), so
        # this corrupts real compressed data, not just header metadata.
        val corrupted = flip_byte(compressed, 10)

        step("Feed the corrupted stream to the real gzip CLI")
        val in_path = TMP_DIR + "/corrupt_in.gz"
        val out_path = TMP_DIR + "/corrupt_out.bin"
        assert_true(write_bytes_or_fail(in_path, corrupted))
        val exit_code = counterpart_gzip_decompress_file(GZIP_DEFAULT_PATH, in_path, out_path, TIMEOUT_MS)

        step("The real gzip CLI must reject it, not silently emit a wrong-but-successful decode")
        val decoded = read_bytes_or_empty(out_path)
        var accepted_wrong_output = false
        if bytes_equal(decoded, original):
            accepted_wrong_output = true
        assert_true(exit_code != 0)
        assert_false(accepted_wrong_output)

        step("Restore: the UNCORRUPTED stream still decodes correctly (green after sabotage)")
        val restore_in = TMP_DIR + "/restore_in.gz"
        val restore_out = TMP_DIR + "/restore_out.bin"
        assert_true(write_bytes_or_fail(restore_in, compressed))
        val restore_exit = counterpart_gzip_decompress_file(GZIP_DEFAULT_PATH, restore_in, restore_out, TIMEOUT_MS)
        val restored_ok = bytes_equal(read_bytes_or_empty(restore_out), original)
        assert_equal(restore_exit, 0)
        assert_true(restored_ok)

    it "rejects a bit-flipped real-gzip-produced stream when Simple decodes it":
        step("Compress with the real gzip CLI, then flip one byte inside the payload")
        val original = case_repetitive(4000)
        val in_path = TMP_DIR + "/g2s_in.bin"
        val out_path = TMP_DIR + "/g2s_out.gz"
        assert_true(write_bytes_or_fail(in_path, original))
        val compress_exit = counterpart_gzip_compress_file(GZIP_DEFAULT_PATH, in_path, out_path, 6, TIMEOUT_MS)
        assert_equal(compress_exit, 0)
        val real_compressed = read_bytes_or_empty(out_path)
        assert_true(real_compressed.len() > 10)
        # Byte 10 is NOT inside the payload here: the real gzip CLI stores the
        # input FILENAME in its header (FLG.FNAME), so byte 10 is a name byte
        # and flipping it decodes clean. Flip the middle of the stream, which
        # is guaranteed to be inside the DEFLATE body for this payload.
        val corrupted = flip_byte(real_compressed, real_compressed.len() / 2)

        step("Simple's decoder must reject it: a failed decode, or a mismatch, never a silent wrong-but-clean success")
        val (decoded, decode_ok) = gzip_decode_checked(corrupted)
        var accepted_wrong_output = false
        if decode_ok:
            if bytes_equal(decoded, original):
                accepted_wrong_output = true
        assert_false(accepted_wrong_output)

        step("Restore: the UNCORRUPTED gzip-CLI stream still decodes correctly in Simple (green after sabotage)")
        val (restored, restore_ok) = gzip_decode_checked(real_compressed)
        assert_true(restore_ok)
        assert_true(bytes_equal(restored, original))


describe "gzip counterpart run: an unavailable provider is never a pass":
    it "reports ProviderStatus.unavailable and rejects the run, rather than skipping silently":
        step("Point the process bridge at a path that does not exist")
        val bogus_path = "/nonexistent/bin/gzip-does-not-exist"
        assert_false(gzip_binary_available(bogus_path))

        step("Build a run with the candidate executed and the counterpart unavailable")
        var run = CounterpartRun(
            plan_id: "compress-gzip-unavailable",
            boundary_id: COMPRESS_GZIP_BOUNDARY,
            environment_profile: "host-cpu",
            sources: [
                source_ok("simple", "simple-gzip-native", "simple-gzip-native"),
                source_unavailable("gzip-cli", "gzip-cli-process", "gzip-cli-process",
                    "gzip binary not found at '" + bogus_path + "'")
            ],
            matrix: [],
            rejections: []
        )

        step("Project it: fewer than two EXECUTED sources is a vacuity failure, never a clean pass")
        val evidence = counterpart_run_to_evidence(run)
        assert_false(evidence.parse_ok)
        assert_true(evidence.parse_error.contains("fewer than two sources executed")
            or evidence.parse_error.contains("zero comparisons"))

        step("The unavailable source's status is recorded as data, never absorbed into 'executed'")
        assert_equal(run.sources[1].status, ProviderStatus.unavailable)
        assert_true(run.sources[1].diagnostics[0].contains("not found"))
