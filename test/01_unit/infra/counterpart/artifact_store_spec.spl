# @cover src/lib/nogc_sync_mut/spec/evidence/counterpart/artifact_store.spl 80%
"""
# Counterpart Conformance — content-addressed artifact store

**Category:** Infrastructure
**Status:** In Progress
**Design:** doc/05_design/infra/counterpart/counterpart_conformance_infrastructure_design_2026-08-09.md

## Purpose and Audience

Large counterpart evidence blobs live in a content-addressed store keyed by
sha256. This scenario is for the engineer wiring a lane's evidence sidecar to
the store, and it exercises the fail-closed rules: every put and every get
re-hashes the bytes on disk, a malformed ref is refused, and a retention sweep
reports every record it cannot re-verify rather than silently dropping it.

## Scope and Preconditions

Runs against the real filesystem under `build/counterparts/artifacts/`. No
network, no adapters. Corruption scenarios tamper with the stored blob through
ordinary file writes and then confirm the store refuses to serve it.

## Evidence and Provenance

Every refusal asserted below is produced by the store at run time by re-hashing
actual bytes on disk, not restated from this document.
"""

use std.spec.*
use std.nogc_sync_mut.spec.evidence.counterpart.artifact_store.{
    ArtifactRecord,
    artifact_exists,
    artifact_get,
    artifact_manifest_lines,
    artifact_manifest_path,
    artifact_manifest_unverifiable,
    artifact_manifest_write,
    artifact_path,
    artifact_put,
    artifact_record,
    artifact_shard,
    is_sha256_ref
}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

val A_VALID_LOOKING_REF: text =
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# ============================================================================
# Refs and paths
# ============================================================================
# @manual_section: What counts as a content-addressed reference

describe "Counterpart artifact refs":
    it "accepts only a 64-character lowercase hex digest as a ref":
        step("Check a well-formed digest")
        assert_true(is_sha256_ref(A_VALID_LOOKING_REF))
        step("Refuse a short ref, a non-hex ref and an empty ref")
        assert_false(is_sha256_ref("abc"))
        assert_false(is_sha256_ref(""))
        assert_false(is_sha256_ref(
            "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"))

    it "shards blob paths by the first two digest characters":
        step("Shard a normal digest")
        expect(artifact_shard(A_VALID_LOOKING_REF)).to_equal("aa")
        expect(artifact_path(A_VALID_LOOKING_REF)).to_contain("/aa/")
        step("Fall back to a named shard for a degenerate digest")
        expect(artifact_shard("a")).to_equal("__")

# ============================================================================
# Put and get round trip
# ============================================================================
# @manual_section: Storing and serving evidence blobs

describe "Counterpart artifact put and get":
    it "stores content, addresses it by its own digest and serves it back":
        step("Put a small evidence blob")
        val put = artifact_put("counterpart evidence blob v1\n", "run-store-01")
        assert_true(put.ok)
        assert_true(is_sha256_ref(put.artifact.sha256))
        expect(put.artifact.byte_len).to_be_greater_than(0)
        step("Confirm existence and read it back through the verifying get")
        assert_true(artifact_exists(put.artifact.sha256))
        val got = artifact_get(put.artifact.sha256)
        assert_true(got.ok)
        expect(got.content).to_equal("counterpart evidence blob v1\n")

    it "treats a re-put of identical content as a verified no-op":
        step("Put the same content twice")
        val first = artifact_put("counterpart idempotent blob\n", "run-store-02")
        val second = artifact_put("counterpart idempotent blob\n", "run-store-02b")
        step("Confirm both succeed and address the same blob")
        assert_true(first.ok)
        assert_true(second.ok)
        expect(second.artifact.sha256).to_equal(first.artifact.sha256)

    it "refuses to serve a ref that is not a digest":
        step("Get with a fabricated non-hash ref")
        val got = artifact_get("not-a-hash")
        assert_false(got.ok)
        assert_true(got.error.contains("not a sha256 ref"))
        assert_false(artifact_exists("not-a-hash"))

    it "reports a digest that was never stored as missing, not empty":
        step("Get a well-formed ref no put ever produced")
        val got = artifact_get(A_VALID_LOOKING_REF)
        assert_false(got.ok)
        assert_true(got.error.contains("is not in the store"))

    it "refuses to serve a blob whose bytes no longer hash to its name":
        step("Put a blob, then corrupt the stored bytes in place")
        val put = artifact_put("counterpart corruptible blob\n", "run-store-03")
        assert_true(put.ok)
        assert_true(rt_file_write_text(put.artifact.path, "tampered bytes\n"))
        step("Confirm the get fails closed instead of serving the tampered bytes")
        val got = artifact_get(put.artifact.sha256)
        assert_false(got.ok)
        assert_true(got.error.contains("hashes to"))
        step("Confirm a re-put of the original content now reports store corruption")
        val reput = artifact_put("counterpart corruptible blob\n", "run-store-03b")
        assert_false(reput.ok)
        assert_true(reput.error.contains("store is corrupt"))
        step("Repair the store by removing the tampered blob")
        assert_true(rt_file_delete(put.artifact.path))

    it "fails a put whose staging file cannot be written":
        step("Put with a run id that points staging into a directory that does not exist")
        val put = artifact_put("unstageable\n", "no-such-dir/run")
        assert_false(put.ok)
        assert_true(put.error.contains("cannot stage artifact"))

# ============================================================================
# Manifest and retention
# ============================================================================
# @manual_section: The retention sweep fails closed

describe "Counterpart artifact manifest":
    it "renders a deterministic manifest and writes it to the store root":
        step("Record one stored artifact")
        val put = artifact_put("counterpart manifest blob\n", "run-store-04")
        assert_true(put.ok)
        val record = artifact_record(put.artifact, "run-store-04",
            "web.resolve.computed_style@1", "published_manual")
        step("Render the manifest lines in fixed field order")
        val lines = artifact_manifest_lines([record])
        expect(lines[0]).to_equal("schema: simple.counterpart.artifact_store.v1")
        expect(lines[2]).to_equal("record_count: 1")
        assert_true(lines.contains("  sha256: " + put.artifact.sha256))
        assert_true(lines.contains("  retention_class: published_manual"))
        step("Write it and confirm the file exists with the same content")
        assert_true(artifact_manifest_write([record]))
        assert_true(rt_file_exists(artifact_manifest_path()))
        assert_true(rt_file_read_text(artifact_manifest_path())
            .contains(put.artifact.sha256))

    it "reports every record a retention sweep cannot re-verify":
        step("Record a verifiable artifact as the control")
        val put = artifact_put("counterpart retention blob\n", "run-store-05")
        assert_true(put.ok)
        val good = artifact_record(put.artifact, "run-store-05",
            "web.resolve.computed_style@1", "scratch")
        step("Confirm the control produces no offenders")
        expect(artifact_manifest_unverifiable([good]).len()).to_equal(0)
        step("A record with a non-sha256 ref is an offender")
        val fake = ArtifactRecord(sha256: "not-a-hash", path: put.artifact.path,
            byte_len: 1, run_id: "run-store-05", boundary_id: "b@1",
            retention_class: "scratch")
        val bad_ref = artifact_manifest_unverifiable([fake])
        expect(bad_ref.len()).to_equal(1)
        assert_true(bad_ref[0].contains("non-sha256 ref"))
        step("A record whose blob is gone is an offender")
        val missing = ArtifactRecord(sha256: A_VALID_LOOKING_REF,
            path: artifact_path(A_VALID_LOOKING_REF), byte_len: 1,
            run_id: "run-store-05", boundary_id: "b@1", retention_class: "scratch")
        val no_blob = artifact_manifest_unverifiable([missing])
        expect(no_blob.len()).to_equal(1)
        assert_true(no_blob[0].contains("missing blob"))
        step("A record whose blob hashes differently is an offender")
        val swapped = ArtifactRecord(sha256: A_VALID_LOOKING_REF,
            path: put.artifact.path, byte_len: 1, run_id: "run-store-05",
            boundary_id: "b@1", retention_class: "scratch")
        val mismatch = artifact_manifest_unverifiable([swapped])
        expect(mismatch.len()).to_equal(1)
        assert_true(mismatch[0].contains("content mismatch"))
        step("A record with no retention class is an offender even when the blob verifies")
        val unclassed = artifact_record(put.artifact, "run-store-05", "b@1", "")
        val no_class = artifact_manifest_unverifiable([unclassed])
        expect(no_class.len()).to_equal(1)
        assert_true(no_class[0].contains("no retention class"))


# ============================================================================
# Real filesystem faults
# ============================================================================
# @manual_section: Filesystem faults

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "Counterpart artifact store under real filesystem faults":
    it "fails a put when the artifact root cannot be created":
        step("Make the store's parent directory read-only with the root absent")
        val parent = "build/counterparts"
        val root = "build/counterparts/artifacts"
        val (mk_out, mk_err, mk_code) = rt_process_run("/bin/mkdir", ["-p", parent])
        assert_equal(mk_code, 0)
        val (rm_out, rm_err, rm_code) = rt_process_run("/bin/rm", ["-rf", root])
        assert_equal(rm_code, 0)
        val (ro_out, ro_err, ro_code) = rt_process_run("/bin/chmod", ["555", parent])
        assert_equal(ro_code, 0)
        step("Attempt the put against the uncreatable root")
        val put = artifact_put("fault: uncreatable root", "run-fault-root")
        step("Restore the directory before judging, so a failure cannot poison other specs")
        val (rw_out, rw_err, rw_code) = rt_process_run("/bin/chmod", ["755", parent])
        assert_equal(rw_code, 0)
        assert_false(put.ok)
        assert_true(put.error.contains("cannot create artifact root"))

    it "fails a put when the final blob path cannot be written":
        step("Compute the content's digest and make ONLY its shard directory read-only")
        val content = "fault: unwritable shard 2026-08-15"
        val staged = artifact_put(content, "run-fault-shard-probe")
        assert_true(staged.ok)
        val digest = staged.artifact.sha256
        val shard_dir = "build/counterparts/artifacts/" + artifact_shard(digest)
        step("Remove the stored blob, then freeze the shard directory")
        assert_true(rt_file_delete(staged.artifact.path))
        val (ro_out, ro_err, ro_code) = rt_process_run("/bin/chmod", ["555", shard_dir])
        assert_equal(ro_code, 0)
        step("Re-put the same content: staging succeeds, the final write cannot")
        val put = artifact_put(content, "run-fault-shard")
        val (rw_out, rw_err, rw_code) = rt_process_run("/bin/chmod", ["755", shard_dir])
        assert_equal(rw_code, 0)
        assert_false(put.ok)
        assert_true(put.error.contains("cannot write artifact to"))
