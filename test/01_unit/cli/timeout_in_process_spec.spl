use std.spec.*
use std.io_runtime.{env_set, env_get}

describe "timeout in-process":
    it "respects --timeout on in-process example run":
        # Set a 2-second timeout via env var (simulating what run/main.spl does)
        env_set("SIMPLE_TIMEOUT_SECONDS", "2")

        # The timeout_probe.spl example runs an infinite loop
        # If the watchdog fires, we should see a timeout error
        # This test validates that the watchdog is active even when
        # SIMPLE_TIMEOUT_SECONDS is explicitly set

        val timeout_val = env_get("SIMPLE_TIMEOUT_SECONDS") ?? ""
        expect(timeout_val).to_equal("2")
