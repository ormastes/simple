"""
## Purpose and audience
Second of three sequential memory-leak measurement scenarios for the
parent-process memdiff harness. Operators running the mem-check lane over the
memleak tree use this file as the middle allocation workload; its assertions
pin the workload shape so a silent allocator regression (a loop that stops
allocating, or an RSS probe that reads nothing) fails instead of reporting a
fake-clean memdiff.
## Operator workflow
Run all three iteration files together in one invocation of the mem-check
test lane so the parent RSS printed by the first and last files brackets this
workload. The second scenario prints the VmRSS line this process reports.
## Compatibility and limitations
The RSS probe reads /proc/self/status, so on hosts without procfs (macOS)
the status read comes back empty and the scenario asserts only that no
malformed line was observed. The measurement itself is taken by the external
harness around this file, not by the assertions inside it.
## Verification guidance and troubleshooting
A failure of the length oracle means the workload loop changed shape, not
that memory leaked. If the VmRSS line never prints, check that the host
exposes procfs before trusting the memdiff; on macOS the absence is expected.
"""
# Lifecycle: doc/01_research/runtime/actor_runtime_policy.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/runtime/async_identity_owned_process_lease.md ;
# doc/05_design/infra/crash_containment_framework.md
# @manual_section: memleak-measurement

use std.spec.step

extern fn rt_file_read_text(path: text) -> text

describe "Memleak iteration 2":
    it "performs typical test workload":
        # @req REQ-MEMLEAK-HARNESS-002
        # @capture(statistics): parent RSS bracketing this workload is compared by the external mem-check harness
        step("Allocate a padded string array through the repeated workload loop")
        # Note: nested fn can't mutate outer closure vars, so we return the array
        fn do_work() -> [text]:
            var out: [text] = []
            var k = 0
            while k < 10:
                out.push("iteration2_string_{k}_with_padding")
                k = k + 1
            out
        val data = do_work()
        expect(data.len()).to_equal(10)  # oracle: the loop pushes exactly one padded string per iteration, ten times

    it "reads RSS for comparison":
        # @req REQ-MEMLEAK-HARNESS-002
        # @capture(statistics): the observed VmRSS line is printed for the parent-process memdiff comparison
        step("Read this process's VmRSS line for the harness baseline")
        val status = rt_file_read_text("/proc/self/status") ?? ""
        var rss_line = ""
        if status != "":
            val lines = status.split("\n")
            for line in lines:
                if line.starts_with("VmRSS:"):
                    rss_line = line
        if rss_line != "":
            print "  [RSS] {rss_line}"
        val rss_wellformed = status == "" or rss_line.starts_with("VmRSS:")
        expect(rss_wellformed).to_equal(true)  # oracle: a nonempty status must yield a VmRSS-prefixed line; no procfs means no status at all
