"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/complete/compiler_c_codegen_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/compiler_c_codegen_complete.md
# doc-path: doc/03_plan/sys_test/compiler_c_codegen_complete.md
# doc-path: doc/04_architecture/compiler_c_codegen_complete.md
# doc-path: doc/05_design/compiler_c_codegen_complete.md

describe "Compiler Module Coverage":
    it "test 1":
        check(true)
    it "test 2":
        check(1 + 1 == 2)
    it "test 3":
        check("a" == "a")
    it "test 4":
        val x = 5
        check(x > 0)
    it "test 5":
        val arr = [1, 2, 3]
        check(arr.len() == 3)
    it "test 6":
        for i in 0..5:
            check(i >= 0)
    it "test 7":
        val opt = Some(42)
        check(opt.?)
    it "test 8":
        match Some(1):
            Some(x): check(x == 1)
            nil: check(false)
    it "test 9":
        if true:
            check(true)
        else:
            check(false)
    it "test 10":
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "while with break and continue":
        step("Verify: while with break and continue")
        # @req: REQ-CORE-COMPLETE-001
        var i = 0
        var acc = 0
        while i < 10:
            i = i + 1
            if i == 3: continue
            if i == 7: break
            acc = acc + i
        expect(acc).to_equal(18)  # oracle: 1+2+4+5+6

    it "gzip compression roundtrip":
        step("Verify: gzip compression roundtrip")
        # @req: REQ-CORE-COMPLETE-001
        use std.common.compress.gzip.{gzip_compress, gzip_decompress}
        val data = "hello hello hello hello".bytes()
        val packed = gzip_compress(data)
        expect(packed.len() > 0).to_equal(true)
        expect(gzip_decompress(packed)).to_equal(data)
        expect(packed.len() < data.len())  # oracle: repeated text compresses

    it "string case and strip methods":
        step("Verify: string case and strip methods")
        # @req: REQ-CORE-COMPLETE-001
        expect("AbC".to_lower()).to_equal("abc")
        expect("AbC".to_upper()).to_equal("ABC")
        expect("  x ".trim()).to_equal("x")
