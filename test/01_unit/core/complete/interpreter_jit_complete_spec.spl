"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/complete/interpreter_jit_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/interpreter_jit_complete.md
# doc-path: doc/03_plan/sys_test/interpreter_jit_complete.md
# doc-path: doc/04_architecture/interpreter_jit_complete.md
# doc-path: doc/05_design/interpreter_jit_complete.md

describe "Interpreter Module Coverage":
    it "test 1":
        check(true)
    it "test 2":
        check(1 + 1 == 2)
    it "test 3":
        check("a" == "a")
    it "test 4":
        val x = 5
        check(x > 0)
    it "test 5":
        val arr = [1, 2, 3]
        check(arr.len() == 3)
    it "test 6":
        for i in 0..5:
            check(i >= 0)
    it "test 7":
        val opt = Some(42)
        check(opt.?)
    it "test 8":
        match Some(1):
            Some(x): check(x == 1)
            nil: check(false)
    it "test 9":
        if true:
            check(true)
        else:
            check(false)
    it "test 10":
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")
