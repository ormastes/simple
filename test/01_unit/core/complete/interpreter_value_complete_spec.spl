"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/complete/interpreter_value_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/interpreter_value_complete.md
# doc-path: doc/03_plan/sys_test/interpreter_value_complete.md
# doc-path: doc/04_architecture/interpreter_value_complete.md
# doc-path: doc/05_design/interpreter_value_complete.md

describe "Interpreter Module Coverage":
    it "test 1":
        check(true)
    it "test 2":
        check(1 + 1 == 2)
    it "test 3":
        check("a" == "a")
    it "test 4":
        val x = 5
        check(x > 0)
    it "test 5":
        val arr = [1, 2, 3]
        check(arr.len() == 3)
    it "test 6":
        for i in 0..5:
            check(i >= 0)
    it "test 7":
        val opt = Some(42)
        check(opt.?)
    it "test 8":
        match Some(1):
            Some(x): check(x == 1)
            nil: check(false)
    it "test 9":
        if true:
            check(true)
        else:
            check(false)
    it "test 10":
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "string predicates and slicing":
        step("Verify: string predicates and slicing")
        # @req: REQ-CORE-COMPLETE-001
        expect("test.spl".ends_with(".spl")).to_equal(true)
        expect("hello world".contains("lo w")).to_equal(true)
        expect("hello world".len()).to_equal(11)  # oracle: 11 ASCII characters
        expect("abc".slice(0, 2)).to_equal("ab")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "base64 RFC 4648 vectors and roundtrip":
        step("Verify: base64 RFC 4648 vectors and roundtrip")
        # @req: REQ-CORE-COMPLETE-001
        use std.common.base_encoding.base64.{base64_encode, base64_decode}
        expect(base64_encode("Man")).to_equal("TWFu")  # oracle: RFC 4648 illustration
        expect(base64_decode("TWFu")).to_equal("Man")
        expect(base64_decode(base64_encode("roundtrip"))).to_equal("roundtrip")

    it "sha256 known-answer vectors":
        step("Verify: sha256 known-answer vectors")
        # @req: REQ-CORE-COMPLETE-001
        use std.common.crypto.sha256.{sha256_text}
        expect(sha256_text("abc")).to_equal("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")  # oracle: FIPS 180-2 vector for "abc"
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")  # oracle: empty-input vector

    it "array filtering and membership":
        step("Verify: array filtering and membership")
        # @req: REQ-CORE-COMPLETE-001
        expect([1, 2, 3].filter(fn(x: i64): x > 1)).to_equal([2, 3])
        expect([1, 2, 3].contains(2)).to_equal(true)
        expect([1, 2].concat([3])).to_equal([1, 2, 3])
