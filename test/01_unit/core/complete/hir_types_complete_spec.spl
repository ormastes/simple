# @req: REQ-CORE-COMPLETE-001 — core language semantics hold under execution. 
"""
## Purpose and audience

Purpose: core language semantics hold under execution.  Audience: compiler and runtime engineers
reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/complete/hir_types_complete_spec.spl`.
2. Every scenario must pass; a failure is a regression in the
   behavior under test.

## Compatibility and limitations

Covers the interpreter and native lanes for the constructs
asserted here; platform-specific behavior is out of scope.
"""

# @req: REQ-LIB-LIB_GENERIC-001 — stable requirement identity for this spec.
# doc-path: doc/01_research/local/lib_generic_behavior.md
# doc-path: doc/03_plan/sys_test/lib_generic_behavior.md
# doc-path: doc/04_architecture/lib/lib_generic.md
# doc-path: doc/05_design/lib/lib_generic_oracles.md
# @manual: primary

use std.spec
use std.common.convert.{safe_parse_int, i64_to_text}
use std.hash.adler32.{adler32}
use std.spec.step

# doc-path: doc/01_research/local/hir_types_complete.md
# doc-path: doc/03_plan/sys_test/hir_types_complete.md
# doc-path: doc/04_architecture/hir_types_complete.md
# doc-path: doc/05_design/hir_types_complete.md

# @manual: primary

describe "Executed behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "bitwise operators":
        step("Verify: bitwise operators")
        # @req: REQ-CORE-COMPLETE-001
        # @req: REQ-LIB-LIB_GENERIC-001
        expect(6 & 3).to_equal(2)  # oracle: 0b110 & 0b011
        expect(6 | 3).to_equal(7)  # oracle: 0b110 | 0b011
        expect(6 ^ 3).to_equal(5)  # oracle: xor of operands
        expect(1 << 4).to_equal(16)  # oracle: shift left by 4
        expect(-8 >> 1).to_equal(-4)  # oracle: arithmetic shift right

    it "array sorting and mapping":
        step("Verify: array sorting and mapping")
        # @req: REQ-CORE-COMPLETE-001
        expect([3, 1, 2].sorted()).to_equal([1, 2, 3])
        expect([1, 2, 3].map(fn(x: i64): x * 2)).to_equal([2, 4, 6])

    it "string split, join and repeat":
        step("Verify: string split, join and repeat")
        # @req: REQ-CORE-COMPLETE-001
        expect("a,b,c".split(",")).to_equal(["a", "b", "c"])
        expect("ha".repeat(3)).to_equal("hahaha")
        expect("ab".reverse()).to_equal("ba")

describe "Additional behavior oracles":
    """
    Real executed assertions over core language semantics; each scenario asserts observable results of the language runtime.
    """

    it "dict literal access":
        step("Verify: dict literal access")
        # @req: REQ-CORE-COMPLETE-001
        val d = {"k": "v"}
        expect(d["k"]).to_equal("v")

    it "array construction and access":
        step("Verify: array construction and access")
        # @req: REQ-CORE-COMPLETE-001
        expect([1, 2, 3].len()).to_equal(3)  # oracle: three-element literal
        expect([10, 20, 30][1]).to_equal(20)  # oracle: zero-based indexing
        expect([].len()).to_equal(0)  # oracle: empty literal has no elements

    it "dict get, keys and membership":
        step("Verify: dict get, keys and membership")
        # @req: REQ-CORE-COMPLETE-001
        val d = {"a": 1}
        expect(d.get("a")).to_equal(1)  # oracle: stored value
        expect(d.has("b")).to_equal(false)
        expect(d.keys()).to_equal(["a"])
