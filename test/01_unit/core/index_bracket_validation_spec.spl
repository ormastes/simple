"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/01_unit/core/index_bracket_validation_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/index_bracket_validation_spec.md
# doc-path: doc/03_plan/sys_test/index_bracket_validation_spec.md
# doc-path: doc/04_architecture/index_bracket_validation_spec.md
# doc-path: doc/05_design/index_bracket_validation_spec_oracles.md
# @manual: primary

#!/usr/bin/env simple
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-UNIT
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md



use std.spec.step

use core.ast.{ast_reset}
use core.parser.{parse_module, parser_has_errors}


fn parse_fails(code: text) -> bool:
    ast_reset()
    parse_module(code, "index_bracket_validation_spec.spl")
    parser_has_errors()

describe "core bracket expression validation":
    # @manual scenario evidence
    it "rejects comparison in index position":
        # @req REQ-SSPEC-UNIT
        step("rejects comparison in index position")
        expect(parse_fails("fn main() -> i64:\n    val s = \"abc\"\n    return s[1 == 0]")).to_equal(true)

    it "rejects logical and in index position":
        # @req REQ-SSPEC-UNIT
        step("rejects logical and in index position")
        expect(parse_fails("fn main() -> i64:\n    val arr = [1, 2, 3]\n    return arr[true and false]")).to_equal(true)

    it "rejects logical not in index position":
        # @req REQ-SSPEC-UNIT
        step("rejects logical not in index position")
        expect(parse_fails("fn main() -> i64:\n    val arr = [1, 2, 3]\n    return arr[not false]")).to_equal(true)

    it "rejects comparison slice start":
        # @req REQ-SSPEC-UNIT
        step("rejects comparison slice start")
        expect(parse_fails("fn main() -> i64:\n    val s = \"abc\"\n    return len(s[1 < 2:2])")).to_equal(true)

    it "rejects comparison slice end":
        # @req REQ-SSPEC-UNIT
        step("rejects comparison slice end")
        expect(parse_fails("fn main() -> i64:\n    val s = \"abc\"\n    return len(s[0:1 == 1])")).to_equal(true)

    it "still allows arithmetic indexes":
        # @req REQ-SSPEC-UNIT
        step("still allows arithmetic indexes")
        expect(parse_fails("fn main() -> i64:\n    val arr = [1, 2, 3]\n    return arr[1 + 1]")).to_equal(false)
