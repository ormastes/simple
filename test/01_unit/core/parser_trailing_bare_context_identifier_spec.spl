#!/usr/bin/env simple
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-PARSER-TRAILING-CONTEXT
# research: doc/08_tracking/bug/bare_trailing_identifier_named_context_fails_to_parse_2026-08-09.md ; plan: doc/08_tracking/bug/bare_trailing_identifier_named_context_fails_to_parse_2026-08-09.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md





# Self-hosted parsing of a bare trailing identifier named `context` (P3 bug
# bare_trailing_identifier_named_context_fails_to_parse_2026-08-09).
#
# The pure-Simple core parser (src/compiler/10.frontend/core/) must treat
# `context` as an ordinary identifier in trailing-expression position: a
# function whose last statement is the bare identifier `context` parses to an
# EXPR_IDENT, exactly like any other identifier. `context` is not a reserved
# word in the pure-Simple grammar (it is only a spec-group helper name in
# test_analyzer), so no statement- or expression-start special case may reject
# it.

use std.spec.step

use core.ast.{
    ast_reset, module_get_decls, decl_get_tag, decl_get_name, decl_get_body,
    stmt_get_expr, expr_get_tag, expr_get_str,
    DECL_FN, EXPR_IDENT
}
use core.parser.{parse_module, parser_has_errors}


describe "bare trailing identifier named context":
    # @manual scenario evidence
    it "parses a trailing bare `context` as the implicit return expression":
        # @req REQ-SSPEC-PARSER-TRAILING-CONTEXT
        step("parses a trailing bare `context` as the implicit return expression")
        val source = "fn a_ctx(registry: ProviderRegistry) -> RunnerContext:\n" +
            "    var context = runner_context(registry, \"r\", \"h\", \"req\")\n" +
            "    context\n"

        ast_reset()
        parse_module(source, "parser_trailing_bare_context_identifier_spec.spl")
        expect(parser_has_errors()).to_equal(false)

        val decls = module_get_decls()
        expect(decls.len()).to_equal(1)
        expect(decl_get_tag(decls[0])).to_equal(DECL_FN)
        expect(decl_get_name(decls[0])).to_equal("a_ctx")
        val body = decl_get_body(decls[0])
        expect(body.len()).to_equal(2)
        val trailing = stmt_get_expr(body[1])
        expect(expr_get_tag(trailing)).to_equal(EXPR_IDENT)
        expect(expr_get_str(trailing)).to_equal("context")

    # @manual scenario evidence
    it "parses a trailing bare `context` inside a nested block":
        # @req REQ-SSPEC-PARSER-TRAILING-CONTEXT
        step("parses a trailing bare `context` inside a nested block")
        val source = "fn b_ctx(flag: i64) -> i64:\n" +
            "    var context = 41\n" +
            "    if flag == 1:\n" +
            "        context\n" +
            "    else:\n" +
            "        return 0\n"

        ast_reset()
        parse_module(source, "parser_trailing_bare_context_identifier_spec.spl")
        expect(parser_has_errors()).to_equal(false)

        val decls = module_get_decls()
        expect(decls.len()).to_equal(1)
        val body = decl_get_body(decls[0])
        expect(body.len()).to_equal(2)
