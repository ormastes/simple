# @bug nested_fn_in_spec_block_loses_captured_local_2026-08-04
# @req a nested `fn` declared inside a spec block must capture that block's locals
# Reproducing spec: arm A (silent zero) and arm B ("variable not found").

fn apply_reader(reader: (i64) -> i64, off: i64) -> i64:
    reader(off)

describe "nested fn inside an it block captures block locals":
    it "nested fn reads a block-local array":
        val buf: [i64] = [10, 20, 30, 40]
        fn read8(off: i64) -> i64:
            buf[off]
        expect(read8(2)).to_equal(30)

    it "nested fn passed as a callback reads a block-local array":
        val buf: [i64] = [10, 20, 30, 40]
        fn read8(off: i64) -> i64:
            buf[off]
        expect(apply_reader(read8, 1)).to_equal(20)

    it "nested fn reads a block-local scalar":
        val base: i64 = 4275044352
        fn get_base() -> i64:
            base
        expect(get_base()).to_equal(4275044352)

    it "nested fn composes two block locals":
        val lo: i64 = 0x1000
        val hi: i64 = 0x2
        fn combine() -> i64:
            lo + (hi * 0x10000)
        expect(combine()).to_equal(0x21000)
