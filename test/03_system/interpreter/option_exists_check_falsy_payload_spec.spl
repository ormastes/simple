# @bug seed_interp_option_match_falls_through_at_scale_2026-07-18
# @req `.?` in boolean context must decide PRESENCE, never payload truthiness
# Reproducing spec: Some(0) / Some(false) / Some("") are PRESENT.

fn describe_option_dot_check(opt: i64?) -> text:
    if opt.?:
        "some:" + opt.unwrap().to_text()
    else:
        "none"

fn describe_via_elif(a: i64?, b: i64?) -> text:
    if a.?:
        "a"
    elif b.?:
        "b"
    else:
        "none"

fn count_while(opt: i64?) -> i64:
    var n: i64 = 0
    var cur: i64? = opt
    while cur.?:
        n = n + 1
        cur = nil
    n

fn guarded(opt: i64?) -> text:
    match 1:
        case _ if opt.?: "present"
        case _: "absent"

fn expr_form(opt: i64?) -> text:
    val r = if opt.?: "present" else: "absent"
    r

describe "ExistsCheck in boolean context - falsy present payload":
    it "if opt.? takes the then-branch for Some(0)":
        expect(describe_option_dot_check(0)).to_equal("some:0")

    it "if opt.? takes the else-branch for nil":
        expect(describe_option_dot_check(nil)).to_equal("none")

    it "if opt.? still works for a non-zero payload":
        expect(describe_option_dot_check(7)).to_equal("some:7")

    it "elif opt.? sees Some(0) as present":
        expect(describe_via_elif(nil, 0)).to_equal("b")

    it "while opt.? sees Some(0) as present":
        expect(count_while(0)).to_equal(1)

    it "while opt.? sees nil as absent":
        expect(count_while(nil)).to_equal(0)

    it "match arm guard opt.? sees Some(0) as present":
        expect(guarded(0)).to_equal("present")

    it "match arm guard opt.? sees nil as absent":
        expect(guarded(nil)).to_equal("absent")

    it "expression-form if opt.? sees Some(0) as present":
        expect(expr_form(0)).to_equal("present")

    it "expression-form if opt.? sees nil as absent":
        expect(expr_form(nil)).to_equal("absent")
