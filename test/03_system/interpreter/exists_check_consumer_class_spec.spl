# @bug seed_interp_option_match_falls_through_at_scale_2026-07-18
# @req class-detection: EVERY boolean-context consumer of `.?` must decide
#      presence from the option, not from `Value::truthy()` of the payload.
# Generalizes the reproducing spec across:
#   - other falsy payload types (false, "", 0.0)
#   - other consumers (and / or / not / assert / collection predicates)

fn and_consumer(opt: i64?) -> bool:
    opt.? and true

fn or_consumer(opt: i64?) -> bool:
    opt.? or false

fn not_consumer(opt: i64?) -> bool:
    not opt.?

fn bool_payload(opt: bool?) -> text:
    if opt.?: "present" else: "absent"

fn text_payload(opt: text?) -> text:
    if opt.?: "present" else: "absent"

fn float_payload(opt: f64?) -> text:
    if opt.?: "present" else: "absent"

fn assert_consumer(opt: i64?) -> bool:
    assert opt.?
    true

fn filter_consumer(items: [i64?]) -> i64:
    var n: i64 = 0
    for it in items:
        if it.?:
            n = n + 1
    n

describe "ExistsCheck consumer class - falsy payloads across consumers":
    it "and consumer treats Some(0) as present":
        expect(and_consumer(0)).to_equal(true)

    it "and consumer treats nil as absent":
        expect(and_consumer(nil)).to_equal(false)

    it "or consumer treats Some(0) as present":
        expect(or_consumer(0)).to_equal(true)

    it "or consumer treats nil as absent":
        expect(or_consumer(nil)).to_equal(false)

    it "not consumer treats Some(0) as present":
        expect(not_consumer(0)).to_equal(false)

    it "not consumer treats nil as absent":
        expect(not_consumer(nil)).to_equal(true)

    it "Some(false) is present":
        expect(bool_payload(false)).to_equal("present")

    it "nil bool is absent":
        expect(bool_payload(nil)).to_equal("absent")

    it "Some(0.0) is present":
        expect(float_payload(0.0)).to_equal("present")

    it "nil float is absent":
        expect(float_payload(nil)).to_equal("absent")

    it "nil text is absent":
        expect(text_payload(nil)).to_equal("absent")

    it "assert accepts Some(0) as present":
        expect(assert_consumer(0)).to_equal(true)

    it "loop body counts falsy-but-present options":
        expect(filter_consumer([0, nil, 5, nil])).to_equal(2)
