# @bug nested_fn_in_spec_block_loses_captured_local_2026-08-04
# @req class-detection: a nested `fn` must capture enclosing locals in EVERY
#      block-closure context the interpreter has a separate executor for
#      (it / before_each-populated state / nested describe / lambda body /
#      plain function body), and must see mutations made before its call.

"""
## Purpose and audience
Purpose: nested fn inside a plain function body captures its local
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-INTERPRETER-NestFnCaptClas-001

fn call_thunk(t: () -> i64) -> i64:
    t()

fn outer_plain() -> i64:
    val x: i64 = 7
    fn inner() -> i64:
        x * 6
    inner()

use std.spec.step
describe "nested fn capture across block-closure executors":
    it "nested fn inside a plain function body captures its local":
        step("Verify: nested fn inside a plain function body captures its local")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        expect(outer_plain()).to_equal(42)  # oracle: value fixed by the spec contract

    it "nested fn inside a lambda body captures the lambda local":
        step("Verify: nested fn inside a lambda body captures the lambda local")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        val lam = () => {
            val y: i64 = 5
            fn inner() -> i64:
                y + 1
            inner()
        }
        expect(lam()).to_equal(6)  # oracle: value fixed by the spec contract

    it "nested fn sees a var mutated before the call":
        step("Verify: nested fn sees a var mutated before the call")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        var n: i64 = 1
        fn read_n() -> i64:
            n
        n = 99
        expect(read_n()).to_equal(99)  # oracle: value fixed by the spec contract

    it "nested fn captured as a value survives being passed out":
        step("Verify: nested fn captured as a value survives being passed out")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        val z: i64 = 12
        fn thunk() -> i64:
            z
        expect(call_thunk(thunk)).to_equal(12)  # oracle: value fixed by the spec contract

    it "two nested fns capture distinct locals in the same block":
        step("Verify: two nested fns capture distinct locals in the same block")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        val a: i64 = 3
        val b: i64 = 8
        fn get_a() -> i64:
            a
        fn get_b() -> i64:
            b
        expect(get_a() * get_b()).to_equal(24)  # oracle: value fixed by the spec contract

describe "nested describe block":
    it "nested fn captures a local declared in a nested describe's it":
        step("Verify: nested fn captures a local declared in a nested describe's it")
        # @req: REQ-INTERPRETER-NestFnCaptClas-001
        val k: text = "captured"
        fn get_k() -> text:
            k
        expect(get_k()).to_equal("captured")
