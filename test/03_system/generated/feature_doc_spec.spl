    it "registers Level 5 Async File I/O feature (#148)":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: registers Level 5 Async File I/O feature (#148)")
        val async_io_meta = FeatureMetadata {
            id: 148,
            name: "Async File I/O",
            category: "I/O and Files",
            difficulty: 5,
