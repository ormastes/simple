use std.spec
use std.spec.step
# @cover src/lib/nogc_sync_mut/spec/mod.spl 80%

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/generated/medium_nesting_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/medium_nesting_spec.md
# doc-path: doc/03_plan/sys_test/medium_nesting_spec.md
# doc-path: doc/04_architecture/medium_nesting_spec.md
# doc-path: doc/05_design/medium_nesting_spec_oracles.md
# @manual: primary

"""
Medium Nesting Test - 10 levels
Tests if hook caching scales to 10 levels.
"""

describe "Medium Nesting (10 levels)":
    context "L1":
        context "L2":
            context "L3":
                context "L4":
                    context "L5":
                        context "L6":
                            context "L7":
                                context "L8":
                                    context "L9":
                                        context "L10":
                                            it "recursion depth 10 yields the triangular sum":
                                                # @req: REQ-SSPEC-LOCAL-001
                                                step("Verify: recursion 10 levels deep returns 55")
                                                fn nest(n: i64, acc: i64) -> i64:
                                                    if n == 0:
                                                        acc
                                                    else:
                                                        nest(n - 1, acc + n)
                                                expect(nest(10, 0)).to_equal(55)
                                            it "array nesting 10 levels deep resolves inner access":
                                                # @req: REQ-SSPEC-LOCAL-001
                                                step("Verify: deep nested array access returns the leaf")
                                                val deep = [[[1, 2], 3], 4]
                                                expect(deep[0][0][1]).to_equal(2)
                                                expect(deep[1]).to_equal(4)
