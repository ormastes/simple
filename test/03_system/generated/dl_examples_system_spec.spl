    context "Stub mode graceful degradation":

        it "schedule helpers compute pure values without a linked torch runtime":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): linear warmup midpoint value
            step("run lr_warmup_linear at the warmup midpoint")
            val linear_mid = lr_warmup_linear(50, 100, 1000, 0.1)
            expect(linear_mid).to_be_greater_than(0.049)  # oracle: 0.1 * 50/100 = 0.05 at the warmup midpoint
            expect(linear_mid).to_be_less_than(0.051)  # oracle: 0.1 * 50/100 = 0.05 at the warmup midpoint

        it "cosine warmup decays toward min_lr after warmup completes":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): cosine decay value after warmup
            step("run lr_warmup_cosine one warmup window past the warmup phase")
            val cosine_decaying = lr_warmup_cosine(200, 100, 1000, 0.1, 0.01)
            expect(cosine_decaying).to_be_greater_than(0.089)  # oracle: progress 100/900 gives decay 8/9, so min_lr + 0.09 * 8/9 = 0.09
            expect(cosine_decaying).to_be_less_than(0.091)  # oracle: progress 100/900 gives decay 8/9, so min_lr + 0.09 * 8/9 = 0.09

        it "tensor ops are declared to return new tensors":
