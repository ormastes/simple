"""
## Purpose and audience
System-level evidence for the shipped PyTorch integration surface
(src/lib/gc_async_mut/torch/) — module structure, the Tensor/layer/optimizer
API, loss and schedule ops, the FFI facade layering, and stub-mode behavior
when no torch runtime is linked. Written for the ML-integration team that owns
the torch modules and for operators judging what works without libtorch.
## Operator workflow
Run `simple run test/03_system/generated/dl_examples_system_spec.spl` and
confirm the Results line reports 0 failed. Structural scenarios read the
shipped module sources through read_text and pin declaration contracts;
behavioral scenarios construct stub tensors and call the pure schedule helpers
directly.
## Compatibility and limitations
Scenarios that the pre-modernization draft aimed at example files
(01_tensor_creation.spl, mnist_classifier.spl, ...), a torch FFI shared
library, and a torch_ffi_integration.md guide were retitled: none of those
artifacts is shipped. The shipped documentation entry point is
doc/09_report/misc/stdlib/PYTORCH_INTEGRATION_STATUS.md and the module README.
torch_available/torch_version are runtime-extern-backed and are pinned as
source contracts only — this host has no torch library linked.
## Verification guidance and troubleshooting
Re-run the single spec file; each failing line's `# oracle:` comment names the
shipped file and declaration whose contract changed.
# @manual: primary
REQ-SSPEC-SYSTEM
doc/01_research/domain/sspec_documentization_maintenance.md
doc/03_plan/sspec_modernization_plan.md
doc/04_architecture/sspec_documentization_maintenance.md
doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# @req: REQ-SSPEC-SYSTEM
# @manual_section: deep learning examples

use std.spec.{describe, it, expect, step}
use std.gc_async_mut.torch.ops.{lr_warmup_linear, lr_warmup_cosine}
use app.io.mod.{file_read_text}

fn read_text(path: text) -> text:
    file_read_text(path) ?? ""

fn torch_mod_src() -> text:
    read_text("src/lib/gc_async_mut/torch/mod.spl")

fn torch_ops_src() -> text:
    read_text("src/lib/gc_async_mut/torch/ops.spl")

fn torch_optim_src() -> text:
    read_text("src/lib/gc_async_mut/torch/optim.spl")

fn torch_ffi_src() -> text:
    read_text("src/lib/gc_async_mut/torch/ffi.spl")

describe "Deep Learning PyTorch Examples":

    context "Module imports and structure":

        it "torch.ffi module exposes the no-GC async backend as a facade":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): ffi.spl facade contract
            step("read the ffi facade and pin its re-export of the async backend")
            val src = torch_ffi_src()
            expect(src).to_contain("export use std.nogc_async_mut.torch.ffi.*")  # oracle: ffi.spl is a compatibility facade over the no-GC async backend
            expect(src).to_contain("Compatibility facade")  # oracle: the facade docstring states its role

        it "torch.mod module exports Tensor class":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): Tensor class declaration contract
            step("pin the Tensor class declaration in mod.spl")
            val src = torch_mod_src()
            expect(src).to_contain("class Tensor:")  # oracle: mod.spl:80 declares the Tensor class

        it "torch.mod module exports TorchTensorWrapper alias":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): TorchTensorWrapper alias contract
            step("pin the backward-compatibility alias in mod.spl")
            val src = torch_mod_src()
            expect(src).to_contain("val TorchTensorWrapper = Tensor")  # oracle: mod.spl:545 aliases the old wrapper name to Tensor

        it "torch.mod module exports NN layers":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): NN layer class declarations
            step("pin the Linear, Conv2d, MaxPool2d, BatchNorm2d, and Dropout declarations")
            val src = torch_mod_src()
            expect(src).to_contain("class Linear:")  # oracle: mod.spl:346
            expect(src).to_contain("class Conv2d:")  # oracle: mod.spl:394
            expect(src).to_contain("class MaxPool2d:")  # oracle: mod.spl:438
            expect(src).to_contain("class BatchNorm2d:")  # oracle: mod.spl:463
            expect(src).to_contain("class Dropout:")  # oracle: mod.spl:506

        it "loss functions ship as tensor-handle ops in torch.ops":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): loss op declarations in ops.spl
            step("pin the mse and cross-entropy loss op declarations")
            val src = torch_ops_src()
            expect(src).to_contain("fn compute_mse_loss_tensor(pred: i64, target: i64) -> i64")  # oracle: ops.spl:68 — losses operate on raw tensor handles
            expect(src).to_contain("fn cross_entropy_loss_tensor(logits: i64, targets: i64) -> i64")  # oracle: ops.spl:44 — losses operate on raw tensor handles

        it "torch.optim module exports optimizers":
            # @req REQ-SSPEC-SYSTEM
            # @capture(statistics): optimizer class declarations
            step("pin the SGD and Adam optimizer declarations")
            val src = torch_optim_src()
            expect(src).to_contain("class SGDOptimizer:")  # oracle: optim.spl:71
            expect(src).to_contain("class AdamOptimizer:")  # oracle: optim.spl:152

    context "FFI function coverage":

