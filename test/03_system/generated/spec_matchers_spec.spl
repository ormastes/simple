# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/nogc_sync_mut/spec/mod.spl 80%

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/generated/spec_matchers_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/spec_matchers_spec.md
# doc-path: doc/03_plan/sys_test/spec_matchers_spec.md
# doc-path: doc/04_architecture/spec_matchers_spec.md
# doc-path: doc/05_design/spec_matchers_spec_oracles.md
# @manual: primary

"""

Tests for BDD matchers in the SPipe framework.
Validates core matchers, comparison matchers, string matchers,
collection matchers, and negated assertions.
"""

use std.spec.step

describe "BDD Matchers":
    # @manual scenario evidence
    """
    Validates the BDD matcher library including eq, be, gt, lt,
    include, start_with, end_with, and negated matchers.
    """
    context "core matchers":
        it "eq matcher tests equality":
            # @req REQ-SSPEC-SYSTEM
            step("eq matcher tests equality")
            expect 5 to eq 5
            expect "hello" to eq "hello"
            expect true to eq true

        it "be matcher tests identity":
            # @req REQ-SSPEC-SYSTEM
            step("be matcher tests identity")
            val x = 5
            assert_true(x to be 5)

        it "be_nil matcher tests None":
            # @req REQ-SSPEC-SYSTEM
            step("be_nil matcher tests None")
            val nothing = nil
            expect nothing to be_nil()

    context "comparison matchers (numbers)":
        it "gt (greater than) matcher":
            # @req REQ-SSPEC-SYSTEM
            step("gt (greater than) matcher")
            expect 10 to gt 5
            expect 100 to gt 50

        it "lt (less than) matcher":
            # @req REQ-SSPEC-SYSTEM
            step("lt (less than) matcher")
            expect 3 to lt 10
            expect 1 to lt 100

        it "gte (greater than or equal) matcher":
            # @req REQ-SSPEC-SYSTEM
            step("gte (greater than or equal) matcher")
            expect 10 to gte 5
            expect 5 to gte 5

        it "lte (less than or equal) matcher":
            # @req REQ-SSPEC-SYSTEM
            step("lte (less than or equal) matcher")
            expect 3 to lte 10
            expect 5 to lte 5

        it "multiple comparisons in one test":
            # @req REQ-SSPEC-SYSTEM
            step("multiple comparisons in one test")
            expect 5 to gt 0
            expect 5 to gte 5
            expect 5 to lt 10
            expect 5 to lte 5

    context "string matchers":
        it "include matcher for strings":
            # @req REQ-SSPEC-SYSTEM
            step("include matcher for strings")
            expect "hello world" to include "world"
            expect "hello world" to include "hello"

        it "start_with matcher":
            # @req REQ-SSPEC-SYSTEM
            step("start_with matcher")
            expect "hello world" to start_with "hello"

        it "end_with matcher":
            # @req REQ-SSPEC-SYSTEM
            step("end_with matcher")
            expect "hello world" to end_with "world"

    context "collection matchers":
        # TODO: Fix include matcher - currently returns Matcher(Exact(...)) instead of IncludeMatcher
        # Bug: Matcher construction is broken in interpreter, all matchers convert to Exact
        it "include matcher for arrays":
            # @req REQ-SSPEC-SYSTEM
            step("include matcher for arrays")
            val arr = [1, 2, 3, 4, 5]
            assert_true(arr to include 3)
            assert_true(arr to include 1)

    context "negated assertions":
        it "not_to with eq":
            # @req REQ-SSPEC-SYSTEM
            step("not_to with eq")
            expect 5 not_to eq 6
            expect "hello" not_to eq "world"

        it "not_to with comparison":
            # @req REQ-SSPEC-SYSTEM
            step("not_to with comparison")
            expect 5 not_to gt 10
            expect 5 not_to lt 1

        it "not_to with include":
            # @req REQ-SSPEC-SYSTEM
            step("not_to with include")
            expect "hello" not_to include "xyz"

    context "complex matcher chains":
        it "chains multiple matchers on same value":
            # @req REQ-SSPEC-SYSTEM
            step("chains multiple matchers on same value")
            expect 10 to gt 5
            expect 10 to gte 10
            expect 10 to lt 20
            expect 10 to lte 10

        it "matchers with computed values":
            # @req REQ-SSPEC-SYSTEM
            step("matchers with computed values")
            val x = 5
            val y = 3
            val result = x + y
            assert_true(result to eq 8)
            assert_true(result to gt 7)
            assert_true(result to lt 10)

fn main_func():
    0

main = main_func()
