use std.spec
use std.spec.step
# @cover src/lib/nogc_sync_mut/spec/mod.spl 80%

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/generated/simple_nesting_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/simple_nesting_spec.md
# doc-path: doc/03_plan/sys_test/simple_nesting_spec.md
# doc-path: doc/04_architecture/simple_nesting_spec.md
# doc-path: doc/05_design/simple_nesting_spec_oracles.md
# @manual: primary

"""
Simple Nesting Test - 5 levels only
Tests if hook caching fixes the performance issue.
"""

describe "Simple Nesting (5 levels)":
    context "L1":
        context "L2":
            context "L3":
                context "L4":
                    context "L5":
                        it "sums the five context levels":
                            # @req: REQ-SSPEC-LOCAL-001
                            step("Verify: levels 1..5 sum to 15")
                            var total = 0
                            for level in [1, 2, 3, 4, 5]:
                                total = total + level
                            expect(total).to_equal(15)
                        it "distinguishes sibling scenarios at depth 5":
                            # @req: REQ-SSPEC-LOCAL-001
                            step("Verify: sibling values stay distinct")
                            val a = 2 * 3
                            val b = 2 + 3
                            expect(a).to_equal(6)
                            expect(b).to_equal(5)
                        it "round-trips a value through each level":
                            # @req: REQ-SSPEC-LOCAL-001
                            step("Verify: increment chain from 1 gives 6")
                            var v = 1
                            for i in [1, 2, 3, 4, 5]:
                                v = v + 1
                            expect(v).to_equal(6)
