# ============================================================
# Inline Stubs - Minimal but functional async primitives
# No function-typed fields — all logic is inline or via named fns
# ============================================================

enum PromiseState:
    Pending
    Resolved(value)
    Rejected(error)

impl PromiseState:
    fn is_pending() -> bool:
        match self:
            case Pending: true
            case _: false

    fn is_resolved() -> bool:
        match self:
            case Resolved(_): true
            case _: false

    fn is_rejected() -> bool:
        match self:
            case Rejected(_): true
            case _: false

class Promise:
    state: PromiseState

    fn is_pending() -> bool:
        return self.state.is_pending()

    fn is_resolved() -> bool:
        return self.state.is_resolved()

    fn is_rejected() -> bool:
        return self.state.is_rejected()

    fn value():
        if val PromiseState.Resolved(v) = self.state:
            return v
        return nil

    fn error() -> text:
        if val PromiseState.Rejected(e) = self.state:
            return e
        return ""

    me resolve(value):
        self.state = PromiseState.Resolved(value)

    me reject(error):
        self.state = PromiseState.Rejected(error)

# ============================================================

enum FutureState:
    Pending
    Ready(value)
    Failed(error)

impl FutureState:
    fn is_pending() -> bool:
        match self:
            case Pending: true
            case _: false

    fn is_ready() -> bool:
        match self:
            case Ready(_): true
            case _: false

    fn is_failed() -> bool:
        match self:
            case Failed(_): true
            case _: false

class SimpleFuture:
    state: FutureState

    fn is_ready() -> bool:
        return self.state.is_ready()

    fn is_failed() -> bool:
        return self.state.is_failed()

    fn is_pending() -> bool:
        return self.state.is_pending()

    fn value():
        if val FutureState.Ready(v) = self.state:
            return v
        return nil

    fn error() -> text:
        if val FutureState.Failed(e) = self.state:
            return e
        return ""

    me complete(value):
        self.state = FutureState.Ready(value)

    me fail(error):
        self.state = FutureState.Failed(error)

# Helper constructors for SimpleFuture
fn future_ready(value) -> SimpleFuture:
    return SimpleFuture(state: FutureState.Ready(value))

fn future_pending() -> SimpleFuture:
    return SimpleFuture(state: FutureState.Pending)

fn future_failed(error) -> SimpleFuture:
    return SimpleFuture(state: FutureState.Failed(error))

# ============================================================

class Channel:
    buffer: [i64]
    closed: bool
    count: i64

    me send(value):
        if self.closed:
            return
        self.buffer = self.buffer + [value]
        self.count = self.count + 1

    me receive():
        if self.count == 0:
            return nil
        var item = self.buffer[0]
        var new_buffer: [i64] = []
        var i = 1
        while i < self.count:
            new_buffer = new_buffer + [self.buffer[i]]
            i = i + 1
        self.buffer = new_buffer
        self.count = self.count - 1
        return item

    fn is_empty() -> bool:
        return self.count == 0

    fn size() -> i64:
        return self.count

    me close():
        self.closed = true

# Channel that holds any type (text variant)
class TextChannel:
    buffer: [text]
    closed: bool
    count: i64

    me send(value):
        if self.closed:
            return
        self.buffer = self.buffer + [value]
        self.count = self.count + 1

    me receive():
        if self.count == 0:
            return nil
        var item = self.buffer[0]
        var new_buffer: [text] = []
        var i = 1
        while i < self.count:
            new_buffer = new_buffer + [self.buffer[i]]
            i = i + 1
        self.buffer = new_buffer
        self.count = self.count - 1
        return item

    fn is_empty() -> bool:
        return self.count == 0

    fn size() -> i64:
        return self.count

    me close():
        self.closed = true

# ============================================================

class WorkStealingQueue:
    q0: [i64]
    q1: [i64]
    q2: [i64]

    me push(worker_id: i64, task: i64):
        if worker_id == 0:
            self.q0 = self.q0 + [task]
        if worker_id == 1:
            self.q1 = self.q1 + [task]
        if worker_id == 2:
            self.q2 = self.q2 + [task]

    me pop(worker_id: i64):
        if worker_id == 0:
            if self.q0.len() == 0:
                return nil
            var item = self.q0[self.q0.len() - 1]
            var new_q: [i64] = []
            var i = 0
            while i < self.q0.len() - 1:
                new_q = new_q + [self.q0[i]]
                i = i + 1
            self.q0 = new_q
            return item
        if worker_id == 1:
            if self.q1.len() == 0:
                return nil
            var item = self.q1[self.q1.len() - 1]
            var new_q: [i64] = []
            var i = 0
            while i < self.q1.len() - 1:
                new_q = new_q + [self.q1[i]]
                i = i + 1
            self.q1 = new_q
            return item
        if self.q2.len() == 0:
            return nil
        var item = self.q2[self.q2.len() - 1]
        var new_q: [i64] = []
        var i = 0
        while i < self.q2.len() - 1:
            new_q = new_q + [self.q2[i]]
            i = i + 1
        self.q2 = new_q
        return item

    me steal(from_id: i64):
        if from_id == 0:
            if self.q0.len() == 0:
                return nil
            var item = self.q0[0]
            var new_q: [i64] = []
            var i = 1
            while i < self.q0.len():
                new_q = new_q + [self.q0[i]]
                i = i + 1
            self.q0 = new_q
            return item
        if from_id == 1:
            if self.q1.len() == 0:
                return nil
            var item = self.q1[0]
            var new_q: [i64] = []
            var i = 1
            while i < self.q1.len():
                new_q = new_q + [self.q1[i]]
                i = i + 1
            self.q1 = new_q
            return item
        if self.q2.len() == 0:
            return nil
        var item = self.q2[0]
        var new_q: [i64] = []
        var i = 1
        while i < self.q2.len():
            new_q = new_q + [self.q2[i]]
            i = i + 1
        self.q2 = new_q
        return item

    fn total_tasks() -> i64:
        return self.q0.len() + self.q1.len() + self.q2.len()

# ============================================================
# Combinators — free functions, no stored callbacks
# ============================================================

fn join_all_futures(futures) -> SimpleFuture:
    var results = []
    for f in futures:
        if f.is_failed():
            return future_failed(f.error())
        results = results + [f.value()]
    return future_ready(results)

fn select_first_future(futures) -> SimpleFuture:
    for f in futures:
        if f.is_ready():
            return f
    for f in futures:
        if f.is_failed():
            return f
    return future_pending()

# ============================================================
# Test Suites
# ============================================================

describe "Promise Creation and Resolution":
    it "should create a pending promise and resolve it":
        # @req REQ-STDLIB-001
        # @capture(statistics): promise state flags before and after resolve
        step("Verify: should create a pending promise and resolve it")
        # @req: REQ-STDLIB-AsynPromSyst-001
        var p = Promise(state: PromiseState.Pending)
        expect(p.is_pending()).to_equal(true)
        expect(p.is_resolved()).to_equal(false)

        p.resolve(42)
        expect(p.is_resolved()).to_equal(true)
        expect(p.is_pending()).to_equal(false)
        expect(p.value()).to_equal(42)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should create a pending promise and reject it":
        # @req REQ-STDLIB-001
        # @capture(statistics): promise state flags and error text after reject
        step("Reject a pending promise and read its error")
        var p = Promise(state: PromiseState.Pending)
        p.reject("something went wrong")
        expect(p.is_rejected()).to_equal(true)
        expect(p.error()).to_equal("something went wrong")

describe "Promise-to-Future Data Flow":
    it "should flow data from promise resolution through to future completion":
        # @req REQ-STDLIB-001
        # @capture(statistics): resolved value carried into the future
        step("Carry a resolved promise value into a pending future")
        var p = Promise(state: PromiseState.Resolved(42))
        var future = future_pending()

        expect(p.is_resolved()).to_equal(true)
        match p.state:
            case Resolved(v):
                future.complete(v)
            case _:
                expect("promise should already be resolved").to_equal("")
        expect(future.is_ready()).to_equal(true)
        expect(future.value()).to_equal(42)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should flow rejection from promise to failed future":
        # @req REQ-STDLIB-001
        # @capture(statistics): rejection error text carried into the future
        step("Carry a promise rejection into a failed future")
        var p = Promise(state: PromiseState.Pending)
        p.reject("upstream error")

        var future = future_failed(p.error())
        expect(future.is_failed()).to_equal(true)
        expect(future.error()).to_equal("upstream error")

describe "Channel Producer-Consumer":
    it "should deliver all messages from producer to consumer in order":
        # @req REQ-STDLIB-001
        # @capture(bit_table): receive order across the five queued messages
        step("Drain a five-message channel and check FIFO order")
        var ch = Channel(buffer: [0, 10, 20, 30, 40], closed: false, count: 5)

        expect(ch.size()).to_equal(5)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

        var r0 = ch.receive()
        var r1 = ch.receive()
        var r2 = ch.receive()
        var r3 = ch.receive()
        var r4 = ch.receive()
        expect(r0).to_equal(0)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r1).to_equal(10)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r2).to_equal(20)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r3).to_equal(30)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r4).to_equal(40)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(ch.is_empty()).to_equal(true)

    it "should return nil when receiving from empty channel":
        # @req REQ-STDLIB-001
        # @capture(statistics): receive result on an empty channel
        step("Receive from an empty channel")
        var ch = Channel(buffer: [], closed: false, count: 0)
        var result = ch.receive()
        expect(result).to_be_nil()

describe "Future Combinators - join_all and select":
    it "should join all ready futures into a single result list":
        # @req REQ-STDLIB-001
        # @capture(statistics): joined result list order
        step("Join three ready futures into one result list")
        var f1 = future_ready(10)
        var f2 = future_ready(20)
        var f3 = future_ready(30)

        var joined = join_all_futures([f1, f2, f3])
        expect(joined.is_ready()).to_equal(true)
        var vals = joined.value()
        expect(vals.len()).to_equal(3)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(vals[0]).to_equal(10)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(vals[1]).to_equal(20)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(vals[2]).to_equal(30)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should select the first ready future from a mixed set":
        # @req REQ-STDLIB-001
        # @capture(statistics): selected future value from a mixed set
        step("Select the ready future out of a pending/ready/pending set")
        var f1 = future_pending()
        var f2 = future_ready(99)
        var f3 = future_pending()

        var selected = select_first_future([f1, f2, f3])
        expect(selected.is_ready()).to_equal(true)
        expect(selected.value()).to_equal(99)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

describe "Error Propagation":
    it "should propagate rejection from promise through future to combinator":
        # @req REQ-STDLIB-001
        # @capture(statistics): error text propagated through the join combinator
        step("Propagate a promise rejection through a future into join_all")
        var p = Promise(state: PromiseState.Pending)
        p.reject("upstream failure")
        expect(p.is_rejected()).to_equal(true)

        var failed_future = future_failed(p.error())
        expect(failed_future.is_failed()).to_equal(true)
        expect(failed_future.error()).to_equal("upstream failure")

        var f_ok = future_ready(100)
        var joined = join_all_futures([f_ok, failed_future])
        expect(joined.is_failed()).to_equal(true)
        expect(joined.error()).to_equal("upstream failure")

describe "Work-Stealing Queue Distribution":
    it "should distribute and steal tasks across worker queues":
        # @req REQ-STDLIB-001
        # @capture(bit_table): task movement between worker queues
        step("Push tasks, steal across workers, and pop from the owner queue")
        var wsq = WorkStealingQueue(q0: [], q1: [], q2: [])

        wsq.push(0, 10)
        wsq.push(0, 20)
        wsq.push(0, 30)
        wsq.push(1, 40)

        expect(wsq.total_tasks()).to_equal(4)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

        # Worker 2 steals from worker 0 (takes from front)
        var stolen = wsq.steal(from_id: 0)
        expect(stolen).to_equal(10)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

        # Worker 0 pops from own queue (takes from back)
        var own = wsq.pop(worker_id: 0)
        expect(own).to_equal(30)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

        expect(wsq.total_tasks()).to_equal(2)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should return nil when stealing from empty queue":
        # @req REQ-STDLIB-001
        # @capture(statistics): steal result on an empty queue
        step("Steal from an empty worker queue")
        var wsq = WorkStealingQueue(q0: [], q1: [], q2: [])
        var result = wsq.steal(from_id: 0)
        expect(result).to_be_nil()

describe "Promise Chaining":
    it "should chain multiple promise resolutions producing correct final result":
        # @req REQ-STDLIB-001
        # @capture(bit_table): transformed values across the three-chain
        step("Chain three promises through additive and multiplicative transforms")
        # Without function-typed fields, we chain manually
        var p1 = Promise(state: PromiseState.Pending)
        var p2 = Promise(state: PromiseState.Pending)
        var p3 = Promise(state: PromiseState.Pending)

        # Step 1: resolve p1 with initial value
        p1.resolve(5)

        # Step 2: transform and resolve p2
        var v1 = p1.value()
        p2.resolve(v1 + 10)

        # Step 3: transform and resolve p3
        var v2 = p2.value()
        p3.resolve(v2 * 2)

        expect(p1.value()).to_equal(5)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(p2.value()).to_equal(15)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(p3.value()).to_equal(30)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(p3.is_resolved()).to_equal(true)

describe "Mixed Ready and Pending Futures":
    it "should handle join_all with all ready futures":
        # @req REQ-STDLIB-001
        # @capture(statistics): joined list length for all-ready input
        step("Join an all-ready future set")
        var futures = [
            future_ready(1),
            future_ready(2),
            future_ready(3)
        ]
        var joined = join_all_futures(futures)
        expect(joined.is_ready()).to_equal(true)
        var vals = joined.value()
        expect(vals.len()).to_equal(3)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should select first ready from mixed ready/pending set":
        # @req REQ-STDLIB-001
        # @capture(statistics): selected value from the mixed set
        step("Select the single ready future from a mostly-pending set")
        var futures = [
            future_pending(),
            future_pending(),
            future_ready(77),
            future_pending()
        ]
        var result = select_first_future(futures)
        expect(result.is_ready()).to_equal(true)
        expect(result.value()).to_equal(77)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

    it "should return pending when no futures are ready":
        # @req REQ-STDLIB-001
        # @capture(statistics): selector verdict on an all-pending set
        step("Select from an all-pending future set")
        var futures = [
            future_pending(),
            future_pending()
        ]
        var result = select_first_future(futures)
        expect(result.is_ready()).to_equal(false)
        expect(result.is_pending()).to_equal(true)

describe "Channel Close Semantics":
    it "should stop accepting messages after channel is closed":
        # @req REQ-STDLIB-001
        # @capture(statistics): channel size after post-close send
        step("Send after closing a text channel and check the size")
        var ch = TextChannel(buffer: [], closed: false, count: 0)
        ch.send("before")
        ch.close()
        ch.send("after")
        expect(ch.size()).to_equal(1)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(ch.receive()).to_equal("before")

    it "should drain remaining messages after close":
        # @req REQ-STDLIB-001
        # @capture(bit_table): drained message order after close
        step("Close a loaded channel and drain it in order")
        var ch = Channel(buffer: [], closed: false, count: 0)
        ch.send(1)
        ch.send(2)
        ch.send(3)
        ch.close()

        # Can still receive even after close
        var r1 = ch.receive()
        var r2 = ch.receive()
        var r3 = ch.receive()
        expect(r1).to_equal(1)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r2).to_equal(2)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(r3).to_equal(3)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(ch.is_empty()).to_equal(true)

describe "Full Pipeline Simulation":
    it "should run a complete pipeline with promises, futures, channel, and combinator":
        # @req REQ-STDLIB-001
        # @capture(protocol_json): end-to-end pipeline values joined from the channel
        step("Run promises through a channel into joined futures end to end")
        var ch = Channel(buffer: [], closed: false, count: 0)

        # Simulate 3 async tasks resolving promises and sending to channel
        var p1 = Promise(state: PromiseState.Pending)
        p1.resolve(100)
        ch.send(p1.value())

        var p2 = Promise(state: PromiseState.Pending)
        p2.resolve(200)
        ch.send(p2.value())

        var p3 = Promise(state: PromiseState.Pending)
        p3.resolve(300)
        ch.send(p3.value())

        # Collect channel results into futures
        var f1 = future_ready(ch.receive())
        var f2 = future_ready(ch.receive())
        var f3 = future_ready(ch.receive())

        expect(ch.is_empty()).to_equal(true)

        # Join all futures
        var joined = join_all_futures([f1, f2, f3])
        expect(joined.is_ready()).to_equal(true)
        var final_vals = joined.value()
        expect(final_vals[0]).to_equal(100)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(final_vals[1]).to_equal(200)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
        expect(final_vals[2]).to_equal(300)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario

        # Verify total sum
        var total = 0
        for v in final_vals:
            total = total + v
        expect(total).to_equal(600)  # oracle: expected value pinned by the constructed promise and channel inputs in this scenario
