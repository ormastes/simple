"""
## Purpose and audience
Pins the observable execution contract of the StdlibComprehensive subsystem spec lane
(stdlib_comprehensive_23_system_spec.spl): every scenario asserts a concrete language/stdlib outcome the runner
must report green for this subsystem spec to carry evidence weight.
Audience: compiler and test-infrastructure engineers triaging the StdlibComprehensive lane.
## Operator workflow
Run `bin/simple test test/03_system/stdlib/stdlib_comprehensive_23_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-StdlibComprehensive-001
doc/01_research/local/StdlibComprehensive_lane.md
doc/03_plan/sys_test/StdlibComprehensive_lane.md
doc/04_architecture/StdlibComprehensive_lane.md
doc/05_design/StdlibComprehensive_lane.md
"""
# @req: REQ-SYS-StdlibComprehensive-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "StdlibComprehensive subsystem spec execution contract":
    it "repetition via loop builds the expected run":
        step("Verify: repetition via loop builds the expected run")
        # @req: REQ-SYS-StdlibComprehensive-001
        var run = ""
        for i in 0..4:
            run = run + "ab"
        expect(run.len()).to_equal(8) # oracle: 4 iterations x 2 chars
        expect(run).to_equal("abababab")

    it "trim removes surrounding padding only":
        step("Verify: trim removes surrounding padding only")
        # @req: REQ-SYS-StdlibComprehensive-002
        val padded = "  payload  "
        expect(padded.trim()).to_equal("payload") # oracle: exact trimmed value
        expect(padded.trim().len()).to_equal(7) # oracle: "payload" has 7 chars

    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-StdlibComprehensive-003
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "integer division and remainder follow truncation":
        step("Verify: integer division and remainder follow truncation")
        # @req: REQ-SYS-StdlibComprehensive-004
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "arithmetic precedence binds multiplication before addition":
        step("Verify: arithmetic precedence binds multiplication before addition")
        # @req: REQ-SYS-StdlibComprehensive-005
        expect(2 + 3 * 4).to_equal(14) # oracle: precedence, not left-to-right (would be 20)
        expect((2 + 3) * 4).to_equal(20) # oracle: parenthesised grouping

