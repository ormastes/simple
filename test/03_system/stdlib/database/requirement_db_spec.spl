"""
## Purpose and audience
System tests for the RequirementDatabase module: CRUD operations, filtering,
ID generation, description storage, and persistence. Audience: std.database
maintainers and the requirement-tooling owners who rely on RequirementDB as
the backing store for bug/test/requirement tracking.
## Operator workflow
Run
`./src/compiler_rust/target/bootstrap/simple run test/03_system/stdlib/database/requirement_db_spec.spl`.
Each scenario creates a fresh in-memory RequirementDatabase, drives one CRUD
or query surface, and asserts the observed rows; persistence scenarios clean
their /tmp artifact first.
## Compatibility and limitations
Runs against the real `std.database.requirement` module. The persistence
scenario writes `/tmp/test_reqdb_save.sdn` and needs a writable /tmp;
filtering scenarios rely on the documented draft/approved/implemented status
vocabulary.
## Verification guidance and troubleshooting
A failure means the CRUD or query surface drifted: check the module's
`add_requirement`/`next_id`/`requirements_by_*` implementations before the
spec. Persistence failures usually mean the save path was left behind by a
concurrent run — remove the /tmp artifact and rerun.
"""
# @req REQ-SSPEC-SYSTEM
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: RequirementDB CRUD and query

# @cover src/lib/nogc_sync_mut/database/core.spl 80%
# RequirementDB System Tests
#
# @req REQ-DB
# tag: system

use std.database.requirement.{RequirementDatabase, Requirement}

# Direct extern declarations for file cleanup
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool

fn cleanup(path: text):
    if rt_file_exists(path):
        rt_file_delete(path)

# ============================================================================
# Creation and Basic Operations
# ============================================================================

use std.spec.step

describe "RequirementDatabase creation", tag: ["system"]:
    it "creates a new database":
        # @req REQ-SSPEC-SYSTEM
        # @req REQ-DB
        # @capture(statistics): row count of the fresh database retained
        step("Create a fresh requirement database and read its row count")
        val db_path = "/tmp/test_reqdb_create.sdn"
        cleanup(db_path)
        var db = RequirementDatabase.create()
        expect(db.all_requirements().len()).to_equal(0)  # oracle: a freshly created database holds no requirements

    it "adds a requirement and retrieves it":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): retrieved requirement fields retained
        step("Add one requirement and fetch it back by id")
        val db_path = "/tmp/test_reqdb_add.sdn"
        cleanup(db_path)
        var db = RequirementDatabase.create()

        val req = Requirement(
            id: "REQ-001",
            title: "Test requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "doc/requirement/req_001.md",
            plan_path: "doc/03_plan/plan_001.md",
            design_path: "doc/05_design/design_001.md",
            system_test: "test/system/req_001_spec.spl",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )

        db.add_requirement(req)

        val retrieved = db.get_requirement("REQ-001")
        expect(retrieved.id).to_equal("REQ-001")
        expect(retrieved.title).to_equal("Test requirement")
        expect(retrieved.category).to_equal("feature")
        expect(retrieved.status).to_equal("draft")
        expect(retrieved.priority).to_equal("high")
        expect(retrieved.doc_path).to_equal("doc/requirement/req_001.md")
        expect(retrieved.plan_path).to_equal("doc/03_plan/plan_001.md")
        expect(retrieved.design_path).to_equal("doc/05_design/design_001.md")
        expect(retrieved.system_test).to_equal("test/system/req_001_spec.spl")
        expect(retrieved.created_at).to_equal("2026-03-14")
        expect(retrieved.updated_at).to_equal("2026-03-14")
        expect(retrieved.valid).to_equal(true)

    it "returns empty requirement for unknown ID":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): unknown-id lookup verdict retained
        step("Fetch a requirement id that was never added")
        var db = RequirementDatabase.create()
        val retrieved = db.get_requirement("REQ-NONEXISTENT")
        expect(retrieved.id).to_equal("")
        expect(retrieved.valid).to_equal(false)


# ============================================================================
# ID Generation
# ============================================================================

describe "RequirementDatabase next_id", tag: ["system"]:
    it "generates REQ-001 for empty database":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): first generated id retained
        step("Generate the first id in an empty database")
        var db = RequirementDatabase.create()
        val id = db.next_id()
        expect(id).to_equal("REQ-001")

    it "generates sequential IDs":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): sequential id progression retained
        step("Add one requirement and generate the next id")
        var db = RequirementDatabase.create()

        val req1 = Requirement(
            id: "REQ-001",
            title: "First requirement",
            category: "feature",
            status: "draft",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req1)

        val next = db.next_id()
        expect(next).to_equal("REQ-002")

    it "generates REQ-003 after two entries":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): id after two entries retained
        step("Add two requirements and generate the next id")
        var db = RequirementDatabase.create()

        val req1 = Requirement(
            id: "REQ-001",
            title: "First",
            category: "feature",
            status: "draft",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val req2 = Requirement(
            id: "REQ-002",
            title: "Second",
            category: "improvement",
            status: "approved",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req1)
        db.add_requirement(req2)

        val next = db.next_id()
        expect(next).to_equal("REQ-003")


