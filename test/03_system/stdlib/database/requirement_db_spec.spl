describe "RequirementDatabase all_requirements", tag: ["system"]:
    it "returns all valid requirements":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): total row count retained
        step("Add two requirements and list them all")
        var db = RequirementDatabase.create()

        val req1 = Requirement(
            id: "REQ-001",
            title: "First",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val req2 = Requirement(
            id: "REQ-002",
            title: "Second",
            category: "bugfix",
            status: "implemented",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        db.add_requirement(req1)
        db.add_requirement(req2)

        val all = db.all_requirements()
        expect(all.len()).to_equal(2)  # oracle: 2 — pinned expected value for this behavior


describe "RequirementDatabase requirements_by_status", tag: ["system"]:
    it "filters requirements by status":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): per-status filter counts retained
        step("Filter three requirements by each status bucket")
        var db = RequirementDatabase.create()

        val draft_req = Requirement(
            id: "REQ-001",
            title: "Draft requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val approved_req = Requirement(
            id: "REQ-002",
            title: "Approved requirement",
            category: "feature",
            status: "approved",
            priority: "medium",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val impl_req = Requirement(
            id: "REQ-003",
            title: "Implemented requirement",
            category: "bugfix",
            status: "implemented",
            priority: "low",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )

        db.add_requirement(draft_req)
        db.add_requirement(approved_req)
        db.add_requirement(impl_req)

        val drafts = db.requirements_by_status("draft")
        expect(drafts.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(drafts[0].id).to_equal("REQ-001")

        val approved = db.requirements_by_status("approved")
        expect(approved.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(approved[0].id).to_equal("REQ-002")

        val implemented = db.requirements_by_status("implemented")
        expect(implemented.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(implemented[0].id).to_equal("REQ-003")

        val verified = db.requirements_by_status("verified")
        expect(verified.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior


describe "RequirementDatabase requirements_by_category", tag: ["system"]:
    it "filters requirements by category":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): per-category filter counts retained
        step("Filter three requirements by each category bucket")
        var db = RequirementDatabase.create()

        val feat_req = Requirement(
            id: "REQ-001",
            title: "Feature requirement",
            category: "feature",
            status: "draft",
            priority: "high",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
            created_at: "2026-03-14",
            updated_at: "2026-03-14",
            valid: true
        )
        val bugfix_req = Requirement(
            id: "REQ-002",
            title: "Bugfix requirement",
            category: "bugfix",
            status: "draft",
            priority: "critical",
            doc_path: "",
            plan_path: "",
            design_path: "",
            system_test: "",
