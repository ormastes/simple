# Stage 4 entry-closure regression for the real CLI lint handler.
# The handler's complete body must lower, including its lazy SIMD rule path.

use app.io.cli_lint_commands.{run_lint_command}
# Seed the command-only physical owners in this focused closure. The production
# Stage 4 scanner discovers these through `use lazy`; this narrow contract uses
# ordinary entry closure and therefore names each owner explicitly.
use compiler.tools.formatter.main.{make_formatter}
use compiler.tools.fix.main.{collect_fixes_from_source}
use compiler.tools.fix.rules.impl_.lint_simd.{check_simd_opportunities}
use compiler.tools.fix.rules.impl_.lint_short_grammar.{check_short_grammar_refactor}
use std.tooling.easy_fix.types.{easyfix_id, easyfix_description}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val status = run_lint_command(["lint", "--help"])
    if status != 0:
        rt_exit(41)
    rt_exit(30)
    0
