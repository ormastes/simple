# Stage 4 HIR regression for duplicate-check threshold parsing.

use compiler.tools.duplicate_check.main.{run_duplicate_check}

extern fn rt_exit(code: i32)

fn main() -> i64:
    # Importing the real tool entry lowers both split and equals threshold paths.
    # Invalid values must still take the bounded CLI-usage exit.
    val similarity_status = run_duplicate_check([
        "duplicate-check",
        "test/fixtures/duplication/clean_pair",
        "--similarity-threshold=nope"
    ])
    val semantic_status = run_duplicate_check([
        "duplicate-check",
        "test/fixtures/duplication/clean_pair",
        "--semantic-threshold",
        "12junk"
    ])
    if similarity_status != 2 or semantic_status != 2:
        rt_exit(41)
    rt_exit(30)
    0
