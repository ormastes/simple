# codex-system-test
# Actual native processes; source candidate, all scenarios UNRUN until qualified.
# @req REQ-MIR-SELECTIVE-001
# @evidence-display: links
use std.spec.*
use std.spec.step
use app.cli.native_mir_managed_process_owner_v1.{native_mir_managed_broker_preflight_v1}
use std.env.variables.{env_get}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io.file_ops.{file_read, file_write, file_exists, secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all, dir_remove_all, dir_exists}
use std.nogc_sync_mut.env.platform.{get_temp_dir}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded, process_pid_exists}
use std.nogc_sync_mut.io_runtime.{getpid, dir_list_optional}

fn mir_process_required(name: text) -> text:
    val value = env_get(name) ?? ""
    if value == "": panic("native MIR process evidence requires explicit " + name)
    value

fn mir_process_sha256(path: text, expected: text):
    expect(expected.len()).to_equal(64)
    expect(file_exists(path)).to_equal(true)
    val (output, errors, status) = process_run_bounded("sha256sum", ["--", path], 30000, 4096)
    expect(status).to_equal(0)
    expect(errors).to_equal("")
    expect(output.split(" ")[0]).to_equal(expected)

# @inline
fn mir_process_artifact_qualification():
    # This probe consumes operating-system PIDs, as do worker getpid receipts.
    # A self-PID sentinel refuses an unavailable or incorrectly bound probe.
    expect(process_pid_exists(getpid())).to_equal(true)
    val runner = mir_process_required("SIMPLE_TEST_BINARY")
    expect(mir_process_required("SIMPLE_BINARY")).to_equal(runner)
    mir_process_sha256(runner, mir_process_required("SIMPLE_TEST_BINARY_SHA256"))
    val producer = mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN")
    expect(producer.contains("compiler_rust")).to_equal(false)
    expect(producer.contains("/target/bootstrap/")).to_equal(false)
    mir_process_sha256(producer, mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN_SHA256"))
    expect(dir_exists(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_RUNTIME_PATH"))).to_equal(true)
    mir_process_sha256(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_RUNTIME_MANIFEST"),
        mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_RUNTIME_MANIFEST_SHA256"))
    for name in ["SIMPLE_MIR_SELECTIVE_PARENT_KIB", "SIMPLE_MIR_SELECTIVE_WORKER_KIB",
            "SIMPLE_MIR_SELECTIVE_BROKER_KIB", "SIMPLE_MIR_SELECTIVE_EXPORTER_KIB", "SIMPLE_MIR_SELECTIVE_PHASE_KIB",
            "SIMPLE_SHARD_TREE_MEMORY_BUDGET_KIB", "SIMPLE_MIR_SELECTIVE_DISK_BYTES",
            "SIMPLE_MIR_SELECTIVE_DISK_RESERVE_BYTES", "SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS",
            "SIMPLE_MIR_SELECTIVE_TEST_WORKER_TIMEOUT_MS"]:
        expect(mir_process_required(name).to_i64() ?? 0).to_be_greater_than(0)

    val worker_timeout = mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_WORKER_TIMEOUT_MS").to_i64() ?? 0
    expect(worker_timeout >= 1000 and worker_timeout <= 86400000).to_equal(true)
    val outer_timeout = mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0
    expect(outer_timeout > worker_timeout + 30000).to_equal(true)

# @inline
fn mir_process_qualification():
    mir_process_artifact_qualification()
    # Pins come from existing external qualification evidence. Hash equality
    # here never issues admission for an arbitrary or diagnostic-only image.
    mir_process_sha256(mir_process_required("SIMPLE_MIR_GROUP_BROKER_PROGRAM"),
        mir_process_required("SIMPLE_MIR_GROUP_BROKER_DIGEST"))
    val worker_timeout = mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_WORKER_TIMEOUT_MS").to_i64() ?? 0
    match native_mir_managed_broker_preflight_v1(worker_timeout):
        case Ok(_): ()
        case Err(reason): panic("native MIR fixture managed prerequisites unavailable before export: " + reason)

fn mir_process_args(backend: text, scope: text, jobs: i64) -> [text]:
    # Established parent policy forbids final-executable receipt reuse for
    # --no-incremental. The pure compile-target parser accepts this flag without
    # clearing the HIR/object stores: warm here means those stores remain warm,
    # while the real coordinator and worker lowering must execute again.
    ["--source", "test/fixtures/compiler/mir_selective", "--entry-closure", "--no-incremental",
        "--entry", "test/fixtures/compiler/mir_selective/main.spl", "--backend", backend,
        "--runtime-path", mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_RUNTIME_PATH"),
        "--cache-dir", scope + "/cache", "--output", scope + "/program",
        "--jobs", jobs.to_string(), "--timeout",
        ((mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_WORKER_TIMEOUT_MS").to_i64() ?? 0) / 1000).to_string()]

fn mir_process_base_env(selective: bool, profile: text) -> [text]:
    expect(["normal", "bootstrap-flat-explicit", "stage4"].contains(profile)).to_equal(true)
    # env argv contains data only; no shell interpolation or shared env mutation.
    var environment = ["-u", "SIMPLE_MIR_GROUP_BROKER_PROGRAM", "-u", "SIMPLE_MIR_GROUP_BROKER_DIGEST",
        "-u", "SIMPLE_MIR_SELECTIVE_BROKER_KIB", "-u", "SIMPLE_MIR_WORKER_PRIVATE_ROOT",
        "-u", "SIMPLE_MIR_WORKER_INVOCATION", "-u", "SIMPLE_MIR_WORKER_PRODUCER",
        "-u", "SIMPLE_MIR_WORKER_SOURCE", "-u", "SIMPLE_MIR_WORKER_CONTEXT",
        "-u", "SIMPLE_MIR_WORKER_MANIFEST", "-u", "SIMPLE_MIR_SELECTIVE_OBJECT_CONTEXT",
        "-u", "SIMPLE_MIR_SHARD", "-u", "SIMPLE_MIR_SHARD_LINK",
        "-u", "SIMPLE_MIR_SHARD_QUEUE", "-u", "SIMPLE_MIR_SHARD_OWNER",
        "-u", "SIMPLE_MIR_SHARD_EXPORT_DIR", "-u", "SIMPLE_MIR_SHARD_EXPORT_WRITE",
        "-u", "SIMPLE_HIR_SHARD", "-u", "SIMPLE_PARSE_SHARD",
        "-u", "SIMPLE_BOOTSTRAP_DIRECT_IR", "-u", "SIMPLE_BOOTSTRAP_SKIP_MONO",
        "-u", "SIMPLE_BOOTSTRAP_SKIP_MIR_LOWER", "-u", "SIMPLE_BOOTSTRAP_SKIP_MIR_OPT",
        "-u", "SIMPLE_STUB_HIR", "-u", "SIMPLE_UNSTUB_HIR",
        "-u", "SIMPLE_STAGE3_STREAMING_SURFACES", "-u", "SIMPLE_STAGE4_STREAMING_SURFACES",
        "SIMPLE_BOOTSTRAP=" + (if profile == "normal": "0" else: "1"),
        "SIMPLE_BOOTSTRAP_STAGE4=" + (if profile == "stage4": "1" else: "0"),
        "SIMPLE_BINARY=" + mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"),
        "SIMPLE_NO_STUB_FALLBACK=1", "SIMPLE_MIR_SELECTIVE=" + (if selective: "1" else: "0"),
        "SIMPLE_MIR_SHARDING=0", "SIMPLE_MIR_SHARD_EXPORT_SUMMARIES=0",
        "SIMPLE_HIR_SHARDING=0", "SIMPLE_PARSE_SHARDING=0"]
    environment

fn mir_process_env(selective: bool, profile: text) -> [text]:
    var environment = mir_process_base_env(selective, profile)
    if selective:
        for name in ["SIMPLE_MIR_GROUP_BROKER_PROGRAM", "SIMPLE_MIR_GROUP_BROKER_DIGEST",
                "SIMPLE_MIR_SELECTIVE_BROKER_KIB"]:
            environment.push(name + "=" + mir_process_required(name))
    environment

fn mir_process_build(backend: text, scope: text, jobs: i64, selective: bool, profile: text) -> (text, text, i64):
    var args = mir_process_env(selective, profile)
    args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
    args.push("native-build")
    for arg in mir_process_args(backend, scope, jobs): args.push(arg)
    process_run_bounded("env", args,
        mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 67108864)

fn mir_process_ledger(output: text) -> text:
    var queue = ""
    for line in output.split("\n"):
        if line.starts_with("[mir-shard] shards=") and line.contains(" ledger="):
            val fields = line.split(" ledger=")
            if fields.len() == 2: queue = fields[1]
    if queue == "": panic("actual MIR coordinator did not publish its ledger")
    queue

# Reads real PASS/link records, never inferred scheduler plans or source text.
# Returns context + ordered semantic link inputs, retaining actual object paths.
fn mir_process_receipt(queue: text, requested_jobs: i64) -> text:
    val inventory = file_read(queue + "/inventory").split("\n")
    expect(inventory.len()).to_be_greater_than(2)
    expect(inventory[0].len()).to_equal(64)
    expect(file_exists(queue + "/BLOCKED")).to_equal(false)
    var receipt = inventory[0] + "\n"
    var pids: [i64] = []
    var starts: [i64] = []
    var ends: [i64] = []
    var overlap = false
    var i = 1
    while i < inventory.len():
        val name = inventory[i]
        expect(name.len()).to_be_greater_than(0)
        val base = queue + "/" + sha256_text(name)
        val terminal = file_read(base + ".terminal").split("\n")
        expect(terminal.len()).to_equal(6)
        expect(terminal[0]).to_equal("PASS")
        expect(terminal[2]).to_equal(name)
        expect(terminal[3]).to_equal(inventory[0])
        val object = file_read(base + ".object").split("\n")
        expect(object.len()).to_equal(4)
        expect(object[1].to_i64() ?? -1).to_be_greater_than(-1)
        expect(object[2].to_i64() ?? -1).to_be_greater_than(-1)
        if object[0] != "": expect(file_exists(object[0])).to_equal(true)
        receipt = receipt + name + "\n" + object.join("\n")
        val interval = file_read(base + ".mir-interval").split("\n")
        expect(interval.len()).to_equal(8)
        expect(interval[0]).to_equal("native-mir-selective-interval-v1")
        expect(interval[1]).to_equal(inventory[0])
        expect(interval[2]).to_equal(name)
        expect(interval[6]).to_equal("lower-ok")
        val pid = interval[3].to_i64() ?? 0
        val start = interval[4].to_i64() ?? 0
        val end = interval[5].to_i64() ?? 0
        expect(pid).to_be_greater_than(0)
        expect(start).to_be_greater_than(0)
        expect(end >= start).to_equal(true)
        expect(pids.contains(pid)).to_equal(false)
        # process_is_running accepts owned-child runtime handles, not these
        # receipt OS PIDs. Use the arbitrary-PID kill(0)/ps owner instead.
        # PID reuse conservatively fails this absence check; never waive it as
        # proof that the original worker's handle was waited/reaped.
        expect(process_pid_exists(pid)).to_equal(false)
        var j = 0
        while j < pids.len():
            if start < ends[j] and starts[j] < end: overlap = true
            j = j + 1
        pids.push(pid)
        starts.push(start)
        ends.push(end)
        i = i + 1
    var peak = 0
    for point in starts:
        var active = 0
        var j = 0
        while j < starts.len():
            if starts[j] <= point and point < ends[j]: active = active + 1
            j = j + 1
        if active > peak: peak = active
    expect(peak <= requested_jobs).to_equal(true)
    if requested_jobs > 1: expect(overlap).to_equal(true)
    receipt

fn mir_process_program(scope: text) -> (text, text, i64):
    expect(file_exists(scope + "/program")).to_equal(true)
    process_run_bounded(scope + "/program", [], 30000, 1048576)

# Copy actual post-mono artifacts, corrupt one boundary, launch the actual worker.
# No production injection hook, marker compiler, or source-assert oracle is used.
fn mir_process_reject_corruption(backend: text, scope: text, good_queue: text, profile: text):
    val original = good_queue + ".export"
    val manifest = file_read(original + "/selective.manifest").split("\n")
    expect(manifest.len()).to_be_greater_than(11)
    expect(manifest[7].split("\t")[0]).to_equal("source-order")
    val first_provider = manifest[8].split("\t")
    expect(first_provider.len()).to_be_greater_than(8)
    val body_name = sha256_text(first_provider[0])
    val count = manifest[6].to_i64() ?? 0
    expect(count).to_be_greater_than(1)
    for fault in ["manifest-missing", "manifest-truncated", "source-stale", "context-stale",
            "declaration-missing", "declaration-truncated", "body-missing", "body-truncated"]:
        val copy = scope + "/corrupt-" + fault
        val (_, copy_errors, copied) = process_run_bounded("cp", ["-a", "--", original, copy], 30000, 4096)
        expect(copied).to_equal(0)
        expect(copy_errors).to_equal("")
        var target = copy + "/selective.manifest"
        if fault.starts_with("declaration-"): target = copy + "/" + body_name + ".hirdecl"
        if fault.starts_with("body-"): target = copy + "/" + body_name + ".hirbody"
        if fault.starts_with("body-"):
            # Workers claim in LPT order. Damage every actual provider body so
            # this test cannot accidentally target a body owned by another job.
            val providers = manifest[5].to_i64() ?? 0
            expect(providers).to_be_greater_than(0)
            var provider_index = 0
            while provider_index < providers:
                val row = manifest[8 + provider_index].split("\t")
                val body_path = copy + "/" + sha256_text(row[0]) + ".hirbody"
                if fault == "body-missing":
                    val (_, _, removed) = process_run_bounded("rm", ["--", body_path], 30000, 4096)
                    expect(removed).to_equal(0)
                else:
                    expect(file_write(body_path, "truncated\n")).to_equal(true)
                provider_index = provider_index + 1
        elif fault.ends_with("missing"):
            val (_, _, removed) = process_run_bounded("rm", ["--", target], 30000, 4096)
            expect(removed).to_equal(0)
        elif fault == "source-stale" or fault == "context-stale":
            var changed = manifest
            val index = if fault == "source-stale": 1 else: 2
            changed[index] = sha256_text("different-build-authority")
            expect(file_write(target, changed.join("\n"))).to_equal(true)
        else:
            expect(file_write(target, "truncated\n")).to_equal(true)
        val queue = scope + "/failed-" + fault
        expect(dir_create_all(queue)).to_equal(true)
        var args = mir_process_env(true, profile)
        args.push("SIMPLE_MIR_SHARD_EXPORT_DIR=" + copy)
        args.push("SIMPLE_MIR_SHARD_QUEUE=" + queue)
        args.push("SIMPLE_MIR_SHARD_OWNER=0/" + count.to_string() + "@0")
        args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
        args.push("run")
        args.push("src/app/cli/native_build_worker.spl")
        for arg in mir_process_args(backend, scope, 1): args.push(arg)
        args.push("--mir-shard=0/" + count.to_string())
        val (output, errors, status) = process_run_bounded("env", args,
            mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 67108864)
        expect(status != 0).to_equal(true)
        expect(output.contains("Artifact published:")).to_equal(false)
        expect(errors.contains("Artifact published:")).to_equal(false)
        expect(output + errors).to_contain("selective MIR")

# Same complete PASS terminal/object sidecars and context; alter only the frozen
# inventory. The production final worker must compare the producer's full
# physical schedule before it can trust these otherwise valid link objects.
fn mir_process_reject_ledger_inventory(backend: text, scope: text, good_queue: text, profile: text):
    val inventory = file_read(good_queue + "/inventory").split("\n")
    expect(inventory.len()).to_be_greater_than(3)
    for fault in ["truncated", "reordered"]:
        val queue = scope + "/link-" + fault
        val (_, copy_errors, copied) = process_run_bounded("cp", ["-a", "--", good_queue, queue], 30000, 4096)
        expect(copied).to_equal(0)
        expect(copy_errors).to_equal("")
        var changed: [text] = [inventory[0]]
        var index = 1
        while index < inventory.len():
            if fault == "reordered" and index == 1:
                changed.push(inventory[2])
            elif fault == "reordered" and index == 2:
                changed.push(inventory[1])
            elif fault != "truncated" or index < inventory.len() - 1:
                changed.push(inventory[index])
            index = index + 1
        expect(changed[0]).to_equal(inventory[0])
        expect(changed.join("\n") == inventory.join("\n")).to_equal(false)
        expect(file_write(queue + "/inventory", changed.join("\n"))).to_equal(true)
        val (_, _, removed) = process_run_bounded("rm", ["-f", "--", scope + "/program"], 30000, 4096)
        expect(removed).to_equal(0)
        var args = mir_process_env(true, profile)
        args.push("SIMPLE_MIR_SHARD_LINK=" + queue)
        args.push("SIMPLE_MIR_SHARD_EXPORT_DIR=" + good_queue + ".export")
        args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
        args.push("run")
        args.push("src/app/cli/native_build_worker.spl")
        for arg in mir_process_args(backend, scope, 1): args.push(arg)
        val (output, errors, status) = process_run_bounded("env", args,
            mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 67108864)
        expect(status != 0).to_equal(true)
        expect(output + errors).to_contain("selective MIR ledger inventory differs from the admitted manifest order")
        expect((output + errors).contains("Artifact published:")).to_equal(false)
        expect(file_exists(scope + "/program")).to_equal(false)
        expect(file_write(scope + "/link-" + fault + ".log", output + errors)).to_equal(true)

fn mir_process_matrix(backend: text, profile: text):
    step("Require an exact qualified pure-Simple runner, candidate and runtime artifact")
    mir_process_qualification()
    val scope = match secure_temp_dir(get_temp_dir(), "native-mir-selective-" + backend + "-" + profile + "-"):
        Ok(path): path
        Err(reason): panic(reason)
    step("Compile and execute the serial reference with the same backend and runtime ABI")
    val (serial_out, serial_err, serial_code) = mir_process_build(backend, scope, 1, false, profile)
    expect(serial_code).to_equal(0)
    expect(file_write(scope + "/serial.log", serial_out + serial_err)).to_equal(true)
    val (reference_out, reference_err, reference_code) = mir_process_program(scope)
    expect(reference_out).to_equal("mir-selective-native=pass\n")
    expect(reference_err).to_equal("")
    expect(reference_code).to_equal(0)
    val (warm_out, warm_err, warm_code) = mir_process_build(backend, scope, 1, false, profile)
    expect(warm_code).to_equal(0)
    expect(file_write(scope + "/serial-warm.log", warm_out + warm_err)).to_equal(true)
    val (warm_program_out, warm_program_err, warm_program_code) = mir_process_program(scope)
    expect(warm_program_out).to_equal(reference_out)
    expect(warm_program_err).to_equal(reference_err)
    expect(warm_program_code).to_equal(reference_code)
    # Profile flags participate in context authority. Compare only within this
    # single backend/profile, never across bootstrap semantics or backend ABI.
    var expected_receipt = ""
    step("Compare cold and warm selective jobs 1, 2 and 15 against the native reference")
    for jobs in [1, 2, 15]:
        expect(dir_remove_all(scope + "/cache")).to_equal(true)
        for temperature in ["cold", "warm"]:
            val (output, errors, status) = mir_process_build(backend, scope, jobs, true, profile)
            expect(file_write(scope + "/jobs-" + jobs.to_string() + "-" + temperature + ".log", output + errors)).to_equal(true)
            expect(status).to_equal(0)
            val (actual_out, actual_err, actual_code) = mir_process_program(scope)
            expect(actual_out).to_equal(reference_out)
            expect(actual_err).to_equal(reference_err)
            expect(actual_code).to_equal(reference_code)
            val queue = mir_process_ledger(output + "\n" + errors)
            val receipt = mir_process_receipt(queue, jobs)
            if expected_receipt == "": expected_receipt = receipt
            expect(receipt).to_equal(expected_receipt)
            expect(file_write(scope + "/jobs-" + jobs.to_string() + "-" + temperature + ".link-inputs", receipt)).to_equal(true)
            val evidence_dir = scope + "/ledger-" + jobs.to_string() + "-" + temperature
            val (_, _, evidence_status) = process_run_bounded("cp", ["-a", "--", queue, evidence_dir], 30000, 4096)
            expect(evidence_status).to_equal(0)
            if jobs == 1 and temperature == "warm":
                step("Refuse missing, stale and truncated actual bundle artifacts before publication")
                mir_process_reject_corruption(backend, scope, queue, profile)
                step("Reject truncated and reordered PASS ledgers before the final native link")
                mir_process_reject_ledger_inventory(backend, scope, queue, profile)
    # Retain logs and normalized semantic link receipts for review; no object-byte
    # equality assertion without an established debug/timestamp normalization ABI.
    print "native MIR evidence retained: " + scope

describe "native selective MIR actual process qualification", tag: ["only-compiled"]:
    slow_it "should reject missing managed broker setup before creating an export invocation":
        step("Use qualified artifacts but intentionally omit the selective broker input")
        mir_process_artifact_qualification()
        val scope = match secure_temp_dir(get_temp_dir(), "native-mir-selective-preflight-refusal-"):
            case Ok(path): path
            case Err(reason): panic(reason)
        val hir_root = scope + "/hir"
        expect(dir_create_all(hir_root)).to_equal(true)
        var args = mir_process_base_env(true, "normal")
        args.push("SIMPLE_MIR_SELECTIVE_BROKER_KIB=" + mir_process_required("SIMPLE_MIR_SELECTIVE_BROKER_KIB"))
        args.push("SIMPLE_HIR_CACHE_DIR=" + hir_root)
        args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
        args.push("native-build")
        for arg in mir_process_args("cranelift", scope, 1): args.push(arg)
        val (output, errors, status) = process_run_bounded("env", args,
            mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 67108864)
        expect(status != 0).to_equal(true)
        expect(output + errors).to_contain("pre-export managed capability refused")
        expect(output + errors).to_contain("SIMPLE_MIR_GROUP_BROKER_PROGRAM")
        expect(file_exists(scope + "/program")).to_equal(false)
        val entries = dir_list_optional(hir_root)
        expect(entries != nil).to_equal(true)
        for entry in entries.unwrap():
            # Both invocation and its sibling .export directory share this
            # prefix. Observe actual output absence, not a source-text oracle.
            expect(entry.starts_with("mir-queue-")).to_equal(false)
        expect(file_write(scope + "/preflight-refusal.log", output + errors)).to_equal(true)

    slow_it "should preserve normal LLVM native behavior and link order across jobs and cache states":
        mir_process_matrix("llvm", "normal")

    slow_it "should preserve normal Cranelift native behavior and link order across jobs and cache states":
        mir_process_matrix("cranelift", "normal")

    slow_it "should preserve explicit-entry bootstrap-flat LLVM behavior across jobs and cache states":
        mir_process_matrix("llvm", "bootstrap-flat-explicit")

    slow_it "should preserve explicit-entry bootstrap-flat Cranelift behavior across jobs and cache states":
        mir_process_matrix("cranelift", "bootstrap-flat-explicit")

    slow_it "should preserve Stage 4 LLVM behavior across jobs and cache states":
        mir_process_matrix("llvm", "stage4")

    slow_it "should preserve Stage 4 Cranelift behavior across jobs and cache states":
        mir_process_matrix("cranelift", "stage4")

    slow_it "should refuse the actual ordinary bootstrap entry before selective export or native link":
        step("Require qualified artifacts and select the real compiler bootstrap entry")
        mir_process_qualification()
        val scope = match secure_temp_dir(get_temp_dir(), "native-mir-selective-bootstrap-refusal-"):
            Ok(path): path
            Err(reason): panic(reason)
        var args = mir_process_env(true, "bootstrap-flat-explicit")
        args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
        args.push("native-build")
        for arg in ["--source", "src/compiler", "--source", "src/app", "--source", "src/lib",
                "--entry-closure", "--no-incremental", "--entry", "src/app/cli/bootstrap_main.spl",
                "--backend", "llvm", "--runtime-path", mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_RUNTIME_PATH"),
                "--cache-dir", scope + "/cache", "--output", scope + "/program", "--jobs", "2"]:
            args.push(arg)
        step("Require the production selective eligibility gate to refuse bootstrap shortcut authority")
        val (output, errors, status) = process_run_bounded("env", args,
            mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 67108864)
        expect(status != 0).to_equal(true)
        expect(output + errors).to_contain("selective MIR")
        expect((output + errors).contains("[mir-shard] shards=")).to_equal(false)
        expect((output + errors).contains("[mir-shard-export] bundle=")).to_equal(false)
        expect((output + errors).contains("Artifact published:")).to_equal(false)
        expect(file_exists(scope + "/program")).to_equal(false)
        expect(file_write(scope + "/bootstrap-refusal.log", output + errors)).to_equal(true)
        print "native MIR bootstrap refusal evidence retained: " + scope

    slow_it "should refuse an impossible phase envelope before spawning MIR workers":
        step("Require admitted binaries and isolate the resource refusal output")
        mir_process_qualification()
        val scope = match secure_temp_dir(get_temp_dir(), "native-mir-selective-refusal-"):
            Ok(path): path
            Err(reason): panic(reason)
        step("Request the real coordinator with a phase smaller than its parent envelope")
        var args = mir_process_env(true, "normal")
        args.push("SIMPLE_MIR_SELECTIVE_PHASE_KIB=1")
        args.push("SIMPLE_MIR_SELECTIVE_PARENT_KIB=2")
        args.push(mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_BIN"))
        args.push("native-build")
        for arg in mir_process_args("llvm", scope, 15): args.push(arg)
        val (output, errors, status) = process_run_bounded("env", args,
            mir_process_required("SIMPLE_MIR_SELECTIVE_TEST_TIMEOUT_MS").to_i64() ?? 0, 1048576)
        expect(status != 0).to_equal(true)
        expect(output + errors).to_contain("[mir-selective] admission refused:")
        expect((output + errors).contains("[mir-shard] shards=")).to_equal(false)
        expect(file_exists(scope + "/program")).to_equal(false)
        expect(file_write(scope + "/refusal.log", output + errors)).to_equal(true)
        print "native MIR refusal evidence retained: " + scope
