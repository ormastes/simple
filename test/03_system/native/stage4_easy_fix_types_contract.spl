# Stage 4 native regression for canonical EasyFix scalar and method ownership.

use std.tooling.easy_fix.types.{FixConfidence, Replacement, EasyFix, FixReport, fixreport_applied}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val replacement = Replacement.create("a.spl", 1, 3, 2, 4, "xy")
    if replacement.start != 1 or replacement.end != 3 or not replacement.format().contains("a.spl:2:4"):
        rt_exit(41)

    var fix = EasyFix.create("EF-1", "replace", FixConfidence.Safe)
    fix.add_replacement(replacement)
    if not fix.is_safe() or fix.replacements.len() != 1:
        rt_exit(42)

    val report = FixReport.empty()
    if fixreport_applied(report) != 0 or not report.format(true).contains("Would apply"):
        rt_exit(43)

    rt_exit(30)
    0
