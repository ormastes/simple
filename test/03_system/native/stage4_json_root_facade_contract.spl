use std.json.{
    json_parse as compatibility_json_parse,
    json_serialize as compatibility_json_serialize
}
use std.common.json.parser.{json_parse as canonical_json_parse}
use std.common.json.serializer.{json_serialize as canonical_json_serialize}
# Retain the JSON parser's unqualified core dependency in this focused entry.
use std.common.string_core.{char_from_code}

extern fn rt_exit(code: i32)

fn compatibility_roundtrip(document: text) -> text:
    compatibility_json_serialize(compatibility_json_parse(document))

fn canonical_roundtrip(document: text) -> text:
    canonical_json_serialize(canonical_json_parse(document))

fn main() -> i64:
    if char_from_code(65) != "A":
        rt_exit(41)
    if compatibility_roundtrip("null") != "null":
        rt_exit(42)
    if canonical_roundtrip("null") != "null":
        rt_exit(43)

    rt_exit(30)
    0
