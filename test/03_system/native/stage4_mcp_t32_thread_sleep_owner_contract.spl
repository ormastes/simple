# Stage 4 native regression for the T32 session sleep owner.

use app.mcp_t32.session_tools.{t32_block_contains_word}
use std.nogc_sync_mut.concurrent.thread.{thread_sleep}
use std.nogc_sync_mut.io_runtime.{exit}

fn main() -> i64:
    thread_sleep(0)
    if not t32_block_contains_word("RUNNING STOPPED", "STOPPED"):
        exit(41)
    exit(30)
    0
