fn chr(code: i64) -> text:
    "wrong-chr"

fn to_char(code: i64) -> text:
    "wrong-to-char"

struct CharOwner:
    marker: i64

impl CharOwner:
    fn chr(self) -> text:
        "owned-chr"

    fn to_char(self) -> text:
        "owned-to-char"

fn main() -> i64:
    val cp: i64 = 65
    val nul = 0.chr()
    val left_brace = (123 as char).to_text()
    val right_brace = (125 as char).to_text()
    val unicode_text = (128578 as char).to_text()
    val owner: CharOwner = CharOwner(marker: 1)
    if (cp.chr() == "A" and 90.to_char() == "Z" and 233.chr() == "é" and 128578.to_char() == "🙂" and
        left_brace == "{" and right_brace == "}" and unicode_text == "🙂" and
        nul.len() == 1 and nul.char_code_at(0) == 0 and
        owner.chr() == "owned-chr" and owner.to_char() == "owned-to-char"):
        return 42
    return 0
