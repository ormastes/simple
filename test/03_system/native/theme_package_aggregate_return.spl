# native_theme_package_aggregate_return_nil_2026-07-24
# A named-local class aggregate returned through a forwarding wrapper must keep
# all fields non-nil (snapshot, token_map-like array, css-like dict).
class Snapshot:
    id: i64
    name: text

class Package:
    snapshot: Snapshot
    tokens: [i64]
    css: Dict<text, text>

fn load_package() -> Package:
    val snap = Snapshot(id: 7, name: "dark")
    var css: Dict<text, text> = {}
    css["button"] = "x"
    val pkg = Package(snapshot: snap, tokens: [10, 20], css: css)
    return pkg

fn load_default() -> Package:
    return load_package()

fn main() -> i64:
    val p = load_default()
    var rc = p.snapshot.id
    rc = rc + p.tokens.len() + p.snapshot.name.len()
    rc = rc + p.tokens[1] + p.css.len()
    # 7 + 2 + 4 + 20 + 1 = 34 ; +8 -> 42
    return rc + 8
