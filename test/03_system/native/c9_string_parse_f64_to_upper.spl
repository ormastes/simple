fn main() -> i64:
    val s = "Hello"
    val upper = s.to_upper()
    var upper_ok = 0
    if upper == "HELLO":
        upper_ok = 20
    val f = "3.14".parse_f64()
    val zero = "0".parse_f64()
    val zero_copy = zero
    val invalid = "bad".parse_f64()
    val trailing = "12junk".parse_f64()
    if f == nil: return 1
    if f.unwrap_or(0.0) != 3.14: return 2
    if zero == nil: return 3
    if zero.unwrap_or(1.0) != 0.0: return 4
    if zero_copy.unwrap_or(1.0) != 0.0: return 5
    if invalid != nil: return 6
    if invalid.unwrap_or(7.5) != 7.5: return 7
    if trailing != nil: return 8
    if trailing.unwrap_or(8.5) != 8.5: return 9
    return upper_ok + 22
