use compiler.tools.lint.main.{
    LintLevel as CompilerLintLevel,
    LintCategory as CompilerLintCategory
}
use std.tooling.easy_fix.types.{
    LintLevel as SharedLintLevel,
    LintCategory as SharedLintCategory
}

extern fn rt_exit(code: i32)

fn accept_shared_level(value: SharedLintLevel) -> SharedLintLevel:
    value

fn accept_shared_category(value: SharedLintCategory) -> SharedLintCategory:
    value

fn main() -> i64:
    val level = accept_shared_level(CompilerLintLevel.Warn)
    if level != SharedLintLevel.Warn:
        rt_exit(70)

    val category = accept_shared_category(CompilerLintCategory.Correctness)
    if category != SharedLintCategory.Correctness:
        rt_exit(71)

    rt_exit(30)
    0
