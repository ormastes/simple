use app.cli.bootstrap_identity.{native_build_select_worker_runtime, native_build_worker_preflight_code}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val seed_only = native_build_select_worker_runtime(
        "src/compiler_rust/target/bootstrap/simple", true,
        "", false,
        "", false,
    )
    if seed_only != "":
        rt_exit(10)
    if native_build_worker_preflight_code(seed_only) != 1:
        rt_exit(11)

    val allowed = native_build_select_worker_runtime(
        "", false,
        "/opt/simple/self-hosted", true,
        "", false,
    )
    if allowed != "/opt/simple/self-hosted":
        rt_exit(12)
    if native_build_worker_preflight_code(allowed) != 0:
        rt_exit(13)

    println("render_cli_runtime_selection=pass")
    0
