use std.tui.terminal.{_terminal_fit_line, terminal_flush, terminal_write}

extern fn rt_exit(code: i32)

fn main() -> i64:
    # Exact Stage 4 blocker: truncation must not depend on unresolved global
    # `len`/`substring` helpers in the terminal module.
    if _terminal_fit_line("abcdef", 3) != "abc":
        rt_exit(41)

    # Adjacent behavior: short content remains padded to the requested width.
    if _terminal_fit_line("ab", 4) != "ab  ":
        rt_exit(42)
    if _terminal_fit_line("abc", 0) != "":
        rt_exit(43)
    if _terminal_fit_line("café", 4) != "café":
        rt_exit(44)

    # Exercise the same typed print_raw path used by terminal rendering.
    terminal_write(_terminal_fit_line("abcdef", 3))
    terminal_flush()
    rt_exit(30)
    0
