# Stage 4 ownership regression for the real leak-check module family.

use compiler.tools.leak_check.main.{run_leak_check}

extern fn rt_exit(code: i32)

fn main() -> i64:
    # Importing the entry lowers main plus its internal/external/runtime paths.
    # Execution is deliberately bounded; the contract is compilation ownership.
    rt_exit(30)
    0
