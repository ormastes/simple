# Stage 4 contract for the EasyFix module-boundary lint rule.
#
# Importing this implementation forces the complete real module through HIR,
# which is the exact Stage 4 failure boundary. Rule execution has a separately
# claimed native hang and is deliberately outside this type-resolution proof.

use compiler.tools.fix.rules.impl_.lint_module.{
    check_export_outside_init,
    check_init_boundary_violation,
    check_bypass_with_code_files
}

extern fn rt_exit(code: i32)

fn main() -> i64:
    rt_exit(30)
    0
