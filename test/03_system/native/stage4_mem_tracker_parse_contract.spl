use std.nogc_sync_mut.mem_tracker.mod.{parse_leak_dump}
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val path = "/tmp/simple_stage4_mem_tracker_parse_contract.txt"
    val content = "41 64 compiler\ninvalid 12 bad-id\n42 invalid bad-size\n43 128 runtime\n"
    if not file_write(path, content):
        rt_exit(70)

    val entries = parse_leak_dump(path)
    file_delete(path)

    if entries.len() != 2:
        rt_exit(71)
    if entries[0].alloc_id != 41 or entries[0].size != 64 or entries[0].tag != "compiler":
        rt_exit(72)
    if entries[1].alloc_id != 43 or entries[1].size != 128 or entries[1].tag != "runtime":
        rt_exit(73)

    rt_exit(30)
    0
