# Stage 4 native regression for the SBOM JSON builder owner.

use std.nogc_sync_mut.sbom.sbom_generator.{generate_sbom_document}
use std.nogc_sync_mut.io_runtime.{exit}

fn main() -> i64:
    val doc = generate_sbom_document(
        "",
        "stage4-owner-contract",
        "1.0.0-rc",
        [],
        [],
        ["Tool: Simple"],
        "2026-08-04T00:00:00Z"
    )
    if doc.spdx_version != "SPDX-2.3":
        exit(41)
    if doc.name != "stage4-owner-contract":
        exit(42)
    exit(30)
    0
