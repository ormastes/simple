# Stage 4 native regression: preserve JsonBuilder through a chained
# field-array receiver and dispatch the terminal build() to JsonBuilder.

use std.common.json.builder.{JsonArrayBuilder, JsonBuilder}
use std.nogc_sync_mut.sbom.sbom_generator.{generate_sbom_json}
use std.nogc_sync_mut.io_runtime.{exit}

fn main() -> i64:
    # JsonBuilder.object is genuinely static, but its chained build() symbol
    # is a Method even if recovery temporarily labels the call StaticMethod.
    val empty_object = JsonBuilder.object().build()
    if empty_object != "{}":
        exit(40)
    # Both builders expose build().  The final call must retain the object
    # builder receiver after field_array_raw(), rather than dispatching to the
    # array builder's identically named terminal method.
    val direct_json = JsonBuilder.object()
        .field("kind", "object")
        .field_array_raw("items", JsonArrayBuilder.new().item("x"))
        .build()
    if direct_json != "{\"kind\": \"object\",\"items\": [\"x\"]}":
        exit(41)
    val direct_array = JsonArrayBuilder.new().item("x").build()
    if direct_array != "[\"x\"]":
        exit(42)
    val json = generate_sbom_json(
        "",
        "stage4-owner-contract",
        "1.0.0-rc",
        [],
        [],
        ["Tool: Simple"],
        "2026-08-04T00:00:00Z"
    )
    if not json.contains("\"spdxVersion\": \"SPDX-2.3\""):
        exit(43)
    if not json.contains("\"relationships\": ["):
        exit(44)
    exit(30)
    0
