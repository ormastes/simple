# Stage 4 native regression for CLI utility physical IO ownership and behavior.

use std.cli.cli_util.{find_manifest_path, parse_csv_fields}
use std.nogc_sync_mut.io_runtime.{exit}

fn finish(code: i64):
    exit(code)

fn main() -> i64:
    val manifest = find_manifest_path()
    if manifest != "":
        finish(41)

    val fields = parse_csv_fields("alpha, \"beta,gamma\", delta")
    if fields.len() != 3:
        finish(42)
    if fields[0] != "alpha":
        finish(43)
    if fields[1] != "beta,gamma":
        finish(44)
    if fields[2] != "delta":
        finish(45)

    finish(30)
    0
