# Stage 4 native regression for the DevHub daily-debug time owner.

use app.devhub.cmd_daily_debug.{time_now_unix, triage_kind}
use std.nogc_sync_mut.io_runtime.{exit}

fn main() -> i64:
    if time_now_unix() <= 0:
        exit(41)
    if triage_kind("firmware.elf") != "fw":
        exit(42)
    exit(30)
    0
