use std.failsafe.core.{LogLevel}

enum OwnedLevel:
    Only

    fn to_i64() -> i64:
        71

trait SentinelConversion:
    fn to_i64() -> i64:
        73

struct TraitOwner:
    marker: i64

impl SentinelConversion for TraitOwner:
    fn to_i64() -> i64:
        79

class ReceiverProbe:
    calls: i64

    static fn new() -> ReceiverProbe:
        ReceiverProbe(calls: 0)

    fn next_u8() -> u8:
        self.calls = self.calls + 1
        255u8

fn main() -> i64:
    # Importing LogLevel is intentional: its same-named enum method previously
    # stole primitive conversions from native Engine2D call sites.
    val imported_owner = LogLevel.Info
    if imported_owner.to_i64() != 1: return 1

    val owned = OwnedLevel.Only
    if owned.to_i64() != 71: return 2

    val trait_owner = TraitOwner(marker: 1)
    if trait_owner.to_i64() != 79: return 3

    val probe = ReceiverProbe.new()
    if probe.next_u8().to_i64() != 255: return 4
    if probe.calls != 1: return 5

    val high: u64 = 9223372036854775808u64
    if high.to_i64() != -9223372036854775808: return 6
    if true.to_i64() != 1: return 7
    if false.to_i64() != 0: return 8
    val letter: char = 'A'
    if letter.to_i64() != 65: return 9

    val valid = "42".to_i64()
    val invalid = "not-a-number".to_i64()
    if valid == nil: return 10
    if valid.unwrap_or(0) != 42: return 11
    if invalid != nil: return 12
    42
