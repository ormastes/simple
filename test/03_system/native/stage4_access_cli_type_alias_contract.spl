# Stage 4 native regression for exported access CLI semantic aliases.

use common.ui.access_cli_grammar.{
    AccessOperation,
    AccessOutputMode,
    ACCESS_OPERATION_LIST,
    ACCESS_OUTPUT_JSON
}
use app.play.wm_access_cli.{wm_access_operation}
use std.nogc_sync_mut.io_runtime.{exit}

fn operation_for(mode: AccessOutputMode) -> AccessOperation:
    if mode == ACCESS_OUTPUT_JSON:
        ACCESS_OPERATION_LIST
    else:
        ""

fn main() -> i64:
    val operation = operation_for(ACCESS_OUTPUT_JSON)
    if operation != ACCESS_OPERATION_LIST:
        exit(41)
    if wm_access_operation("windows") != ACCESS_OPERATION_LIST:
        exit(42)
    exit(30)
    0
