use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfaceEnum, ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module, ParserTypeParam}
use compiler.frontend.parser_types_expr.{Type, TypeKind}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.diagnostics.span.{Span}
use compiler.common.config.{Logger}

extern fn rt_exit(code: i32)

fn surfaces_for(modules: Dict<text, Module>, sources: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(modules, sources):
        case Ok(value): value
        case Err(_):
            rt_exit(40)
            ModuleSurfacesByName.empty()

fn named(name: text) -> Type:
    Type(kind: TypeKind.Named(name, []), span: Span.empty())

fn main() -> i64:
    val log = Logger(level: 0)
    val support_source = "pub struct GpuBarrierScope:\n    value: i64\npub struct OtherBarrierScope:\n    value: i64\npub struct BoundPayload:\n    value: i64\npub struct DefaultPayload:\n    value: i64\npub trait TraitX:\n    fn trait_value() -> i64\npub trait OtherTraitX:\n    fn other_trait_value() -> i64"
    val owner_source = "use payload.support.\{GpuBarrierScope, BoundPayload, DefaultPayload, TraitX as AliasT\}\npub enum MirInstKind:\n    Barrier(scope: GpuBarrierScope)\npub enum GenericKind<T>:\n    Item(value: T)\npub enum TraitBoundKind<T>:\n    Item(value: T)"
    val facade_source = "export use exact.owner.\{MirInstKind, GenericKind, TraitBoundKind\}"
    val consumer_source = "use consumer.facade.\{MirInstKind\}\nfn consume(value: MirInstKind) -> MirInstKind:\n    value"
    val support = parse_full_frontend(support_source, "payload.support", "payload.support", log)
    val owner = parse_full_frontend(owner_source, "exact.owner", "exact.owner", log)
    val facade = parse_full_frontend(facade_source, "consumer.facade", "consumer.facade", log)
    val consumer = parse_full_frontend(consumer_source, "consumer.main", "consumer.main", log)
    var modules: Dict<text, Module> = {}
    modules["payload.support"] = support
    modules["exact.owner"] = owner
    modules["consumer.facade"] = facade
    modules["consumer.main"] = consumer
    val sources = [
        SourceFile(path: "payload/support.spl", content: support_source, module_name: "payload.support"),
        SourceFile(path: "exact/owner.spl", content: owner_source, module_name: "exact.owner"),
        SourceFile(path: "consumer/facade.spl", content: facade_source, module_name: "consumer.facade"),
        SourceFile(path: "consumer/main.spl", content: consumer_source, module_name: "consumer.main")
    ]
    val surfaces = surfaces_for(modules, sources)
    val facade_surface = surfaces.surfaces[surfaces.index_by_name["consumer.facade"]]
    val owner_surface = surfaces.surfaces[surfaces.index_by_name["exact.owner"]]
    val support_surface = surfaces.surfaces[surfaces.index_by_name["payload.support"]]

    # Reproduce declaration-only package prebinding followed by an explicit
    # facade materialization request. The payload is reachable only by closing
    # over MirInstKind's defining owner's private named import.
    var lowering = hirlowering_for_module("consumer.main", surfaces)
    lowering.register_package_sibling_symbols(facade_surface, "consumer.facade", Span.empty())
    if lowering.symbols.lookup("MirInstKind") == nil: rt_exit(41)
    if lowering.imported_enums.contains_key("MirInstKind"): rt_exit(42)
    if lowering.symbols.lookup("GpuBarrierScope") != nil: rt_exit(55)
    if lowering.symbols.lookup("BoundPayload") != nil: rt_exit(56)
    if lowering.symbols.lookup("DefaultPayload") != nil: rt_exit(57)
    lowering.register_imported_symbol(facade_surface.physical_index, "consumer.facade", "MirInstKind", "MirInstKind", Span.empty(), true)
    if lowering.errors.len() != 0: rt_exit(43)
    if not lowering.imported_enums.contains_key("MirInstKind"): rt_exit(44)
    if lowering.symbols.lookup("GpuBarrierScope") == nil: rt_exit(45)
    if lowering.symbols.lookup("OtherBarrierScope") != nil: rt_exit(46)
    if lowering.symbols.lookup("BoundPayload") != nil: rt_exit(58)
    if lowering.symbols.lookup("DefaultPayload") != nil: rt_exit(59)

    # Surface-retained generic bounds/defaults are dependencies, while the
    # enum's own parameter spelling is not a terminal declaration.
    var generic = owner_surface.enums["GenericKind"]
    generic.type_params = [ParserTypeParam(name: "T", bounds: [named("BoundPayload")],
        has_default: true, default: named("DefaultPayload"), span: Span.empty())]
    var generic_lowering = hirlowering_for_module("consumer.main", surfaces)
    generic_lowering.register_materialized_enum_payload_dependencies(owner_surface, "exact.owner", generic, Span.empty())
    if generic_lowering.errors.len() != 0: rt_exit(47)
    if generic_lowering.symbols.lookup("BoundPayload") == nil: rt_exit(48)
    if generic_lowering.symbols.lookup("DefaultPayload") == nil: rt_exit(49)
    if generic_lowering.symbols.lookup("T") != nil: rt_exit(50)

    # Freeze the trait bound directly in the retained surface, matching the
    # adjacent generic bounds/defaults probe above. The source parser does not
    # preserve this bound on the focused Stage3 path.
    var trait_bound = owner_surface.enums["TraitBoundKind"]
    trait_bound.type_params = [ParserTypeParam(name: "T", bounds: [named("AliasT")],
        has_default: false, default: named("T"), span: Span.empty())]

    # The same terminal trait prebound under the owner's lexical alias must be
    # accepted. Its stored name remains the physical declaration name so the
    # payload closure compares terminal identity rather than alias spelling.
    var trait_exact = hirlowering_for_module("consumer.main", surfaces)
    trait_exact.register_imported_symbol(support_surface.physical_index, "payload.support", "TraitX", "AliasT", Span.empty(), false)
    trait_exact.register_materialized_enum_payload_dependencies(owner_surface, "exact.owner", trait_bound, Span.empty())
    if trait_exact.errors.len() != 0: rt_exit(60)
    val trait_exact_id = trait_exact.symbols.lookup_or_invalid("AliasT")
    if not trait_exact_id.is_valid(): rt_exit(61)
    val trait_exact_raw = trait_exact_id.id
    if not trait_exact.symbols.symbols.has(trait_exact_raw): rt_exit(62)
    val trait_exact_symbol = trait_exact.symbols.symbols[trait_exact_raw]
    if trait_exact_symbol.name != "TraitX": rt_exit(63)

    # An adjacent binding with the same owner and local alias but a different
    # terminal trait must still fail closed and preserve the first binding.
    var trait_collision = hirlowering_for_module("consumer.main", surfaces)
    trait_collision.register_imported_symbol(support_surface.physical_index, "payload.support", "OtherTraitX", "AliasT", Span.empty(), false)
    trait_collision.register_materialized_enum_payload_dependencies(owner_surface, "exact.owner", trait_bound, Span.empty())
    if trait_collision.errors.len() == 0: rt_exit(64)
    val trait_collision_id = trait_collision.symbols.lookup_or_invalid("AliasT")
    if not trait_collision_id.is_valid(): rt_exit(65)
    val trait_collision_raw = trait_collision_id.id
    if not trait_collision.symbols.symbols.has(trait_collision_raw): rt_exit(66)
    val trait_collision_symbol = trait_collision.symbols.symbols[trait_collision_raw]
    if trait_collision_symbol.name != "OtherTraitX": rt_exit(67)

    # Same physical owner but different item must fail closed and preserve the
    # first lexical binding rather than treating owner equality as sufficient.
    var collision = hirlowering_for_module("consumer.main", surfaces)
    collision.register_imported_symbol(support_surface.physical_index, "payload.support", "OtherBarrierScope", "GpuBarrierScope", Span.empty(), false)
    collision.register_imported_symbol(facade_surface.physical_index, "consumer.facade", "MirInstKind", "MirInstKind", Span.empty(), true)
    if collision.errors.len() == 0: rt_exit(51)
    val collision_id = collision.symbols.lookup_or_invalid("GpuBarrierScope")
    if not collision_id.is_valid(): rt_exit(52)
    val collision_raw = collision_id.id
    if not collision.symbols.symbols.has(collision_raw): rt_exit(53)
    val collision_symbol = collision.symbols.symbols[collision_raw]
    if collision_symbol.name != "OtherBarrierScope": rt_exit(54)

    rt_exit(30)
    0
