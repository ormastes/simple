# Stage 4 contract for the compiled nogc async Future surface.
#
# Importing these owners forces their real declarations through the Stage 4
# closure. Future.map/then remain interpreter-only until native generic
# specialization exists; this fixture deliberately does not execute a generic
# Future value because native Future<T> value preservation has a separate bug.

use std.async.future.{Future}
use std.io.buffer.{AsyncBufferedReader, AsyncBufferedWriter}

extern fn rt_exit(code: i32)

fn retain_future(value: Future<i64>) -> Future<i64>:
    value

fn retain_reader(value: AsyncBufferedReader) -> AsyncBufferedReader:
    value

fn retain_writer(value: AsyncBufferedWriter) -> AsyncBufferedWriter:
    value

class NativeMethodControl:
    value: i64

    fn read() -> i64:
        self.value

fn main() -> i64:
    val control = NativeMethodControl(value: 30)
    if control.read() != 30:
        rt_exit(41)
    rt_exit(30)
    0
