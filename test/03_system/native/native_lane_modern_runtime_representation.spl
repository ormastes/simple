# native_spl_lane_runtime_c_legacy_value_representation_divergence (fix guard)
# Lane C (src/app/compile/native.spl compile_native) links the modern tagged-heap
# runtime (runtime_native.c + runtime_legacy_core.c), NOT legacy runtime.c.
# Enum payloads (incl. enums inside a generic array), Option<text> and text
# concat/len must round-trip identically to the seed interpreter.
enum Shape:
    Circle(r: i64)
    Rect(w: i64, h: i64)
    Empty

fn area(s: Shape) -> i64:
    match s:
        case Circle(r): return 3 * r * r
        case Rect(w, h): return w * h
        case Empty: return 0

fn find_text(xs: [text], want: text) -> text?:
    for x in xs:
        if x == want:
            return x
    return nil

fn main() -> i64:
    var shapes: [Shape] = [Shape.Circle(r: 2), Shape.Rect(w: 3, h: 5), Shape.Empty, Shape.Circle(r: 1)]
    var total = 0
    for s in shapes:
        total = total + area(s)
    if val v = find_text(["ab", "cd", "ef"], "cd"):
        total = total + v.len()
    val u = "ab" + "cd" + "ef"
    total = total + u.len()
    # areas: 12 + 15 + 0 + 3 = 30; +2 (len "cd"); +6 (len "abcdef") = 38; +4 -> 42
    return total + 4
