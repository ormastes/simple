# native_scalar_spill_clobber_loop_intervening_calls_2026-07-20
# Scalars bound before a call-bearing loop must keep their value on every iteration.
fn chan(v: i64, shift: i64) -> i64:
    return (v / shift) % 256

fn clamp(v: i64) -> i64:
    if v < 0:
        return 0
    if v > 255:
        return 255
    return v

fn mix(a: i64, b: i64, t: i64) -> i64:
    val x = clamp(chan(a, 1) + (chan(b, 1) - chan(a, 1)) * t / 4)
    val y = clamp(chan(a, 256) + (chan(b, 256) - chan(a, 256)) * t / 4)
    return x + y

fn main() -> i64:
    val top = 10 + 20 * 256
    val bottom = 30 + 40 * 256
    var i = 0
    var bad = 0
    while i < 5:
        val m = mix(top, bottom, i)
        # t=0 -> 30, t=4 -> 70; monotone and never 0 if scalars survive
        if m < 30 or m > 70:
            bad = bad + 1
        i = i + 1
    if bad == 0:
        return 42
    return bad
