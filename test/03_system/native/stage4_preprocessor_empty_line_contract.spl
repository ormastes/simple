use compiler.frontend.frontend.{preprocess_conditionals}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val trailing = preprocess_conditionals("@cfg(false)\nval hidden = 1\nval visible = 2\n")
    if trailing != "\n\nval visible = 2\n" or trailing.contains("nilnil"):
        rt_exit(70)

    val consecutive = preprocess_conditionals("@cfg(false)\nval a = 1\n@cfg(false)\nval b = 2\nval kept = 3\n")
    if consecutive != "\n\n\n\nval kept = 3\n" or consecutive.contains("nilnil"):
        rt_exit(71)

    val adjacent_blanks = preprocess_conditionals("@cfg(false)\n\n\nval hidden = 1\nval kept = 2\n")
    if adjacent_blanks != "\n\n\n\nval kept = 2\n" or adjacent_blanks.contains("nilnil"):
        rt_exit(72)

    val no_final_newline = preprocess_conditionals("@cfg(false)\nval hidden = 1\nval kept = 2")
    if no_final_newline != "\n\nval kept = 2" or no_final_newline.contains("nilnil"):
        rt_exit(73)

    rt_exit(30)
    0
