# native_spl_lane_runtime_c_legacy_value_representation_divergence
# Tagged enum payloads, Option and text must round-trip identically whichever
# runtime C lane (runtime.c vs runtime_native.c) the native build links.
enum Shape:
    Circle(r: i64)
    Rect(w: i64, h: i64)
    Empty

fn area(s: Shape) -> i64:
    match s:
        case Circle(r): return 3 * r * r
        case Rect(w, h): return w * h
        case Empty: return 0

fn find(xs: [i64], want: i64) -> i64?:
    for x in xs:
        if x == want:
            return x
    return nil

fn main() -> i64:
    var total = area(Shape.Circle(r: 2)) + area(Shape.Rect(w: 3, h: 5)) + area(Shape.Empty)
    if val v = find([1, 2, 3], 3):
        total = total + v
    val t = "ab" + "cd"
    total = total + t.len()
    # 12 + 15 + 0 + 3 + 4 = 34 ; +8 -> 42
    return total + 8
