use compiler.backend.backend_types.{
    BackendKind as LegacyBackendKind,
    CompiledSymbolKind as LegacyCompiledSymbolKind,
    CodegenTarget as FacadeCodegenTarget,
    OptimizationLevel as FacadeOptimizationLevel,
    CompiledModule as FacadeCompiledModule
}
use compiler.backend.backend.backend_types.{
    CodegenTarget as CanonicalCodegenTarget,
    OptimizationLevel as CanonicalOptimizationLevel,
    CompiledModule as CanonicalCompiledModule
}
use compiler.backend.codegen.{CodegenPipeline, CraneliftTarget}

extern fn rt_exit(code: i32)

fn accept_codegen_target(value: FacadeCodegenTarget) -> CanonicalCodegenTarget:
    value

fn accept_optimization_level(value: FacadeOptimizationLevel) -> CanonicalOptimizationLevel:
    value

fn accept_compiled_module(value: FacadeCompiledModule) -> CanonicalCompiledModule:
    value

fn main() -> i64:
    if LegacyBackendKind.Compiler != LegacyBackendKind.Compiler:
        rt_exit(41)

    if accept_codegen_target(FacadeCodegenTarget.X86_64) != CanonicalCodegenTarget.X86_64:
        rt_exit(42)
    if accept_optimization_level(FacadeOptimizationLevel.Speed) != CanonicalOptimizationLevel.Speed:
        rt_exit(43)

    # Retain both payload-bearing facade types in the real entry closure. The
    # function is intentionally not called because CompiledModule has no empty
    # value; its signature still proves facade/direct-owner type identity.
    val symbol_kind = LegacyCompiledSymbolKind.Const
    if symbol_kind != LegacyCompiledSymbolKind.Const:
        rt_exit(44)

    val pipeline = CodegenPipeline.aot(CraneliftTarget.Native)
    if pipeline.target != CraneliftTarget.Native:
        rt_exit(45)

    rt_exit(30)
    0
