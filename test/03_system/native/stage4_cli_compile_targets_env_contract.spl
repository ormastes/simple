# Stage 4 native regression for compile-target resolver and environment owners.

use app.io._CliCompile.compile_targets.{cli_native_build}
use compiler.driver.driver_source_loading.{_driver_entry_import_dirname}
use std.nogc_sync_mut.io.env_ops.{env_get}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val entry_dir = _driver_entry_import_dirname("test/03_system/native/fixture.spl")
    if entry_dir != "test/03_system/native":
        rt_exit(41)
    if env_get("SIMPLE_STAGE4_COMPILE_TARGETS_CONTRACT") != "present":
        rt_exit(42)
    if cli_native_build(["--help"]) != 0:
        rt_exit(43)
    rt_exit(30)
    0
