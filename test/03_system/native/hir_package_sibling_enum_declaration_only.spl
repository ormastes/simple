# Native HIR regression: directory-package siblings share enum declarations,
# but an unrelated sibling must not rematerialize the enum body in its own
# symbol context. Explicit user globs continue to materialize the definition.

use compiler.hir.hir_lowering.types.{hirlowering_for_module}
use compiler.hir.hir_lowering.items.*
use compiler.hir.hir_lowering.module_surface.{ModuleSurfacesByName, module_surfaces_from_modules}
use compiler.frontend.frontend.{parse_full_frontend}
use compiler.frontend.parser_types.{Module}
use compiler.common.driver_core_types.{SourceFile}
use compiler.common.config.{Logger}

extern fn rt_exit(code: i32)

fn build_surfaces(modules: Dict<text, Module>, sources: [SourceFile]) -> ModuleSurfacesByName:
    match module_surfaces_from_modules(modules, sources):
        case Ok(value): value
        case Err(_error):
            rt_exit(40)
            ModuleSurfacesByName.empty()

fn main() -> i64:
    val log = Logger(level: 0)
    val hidden_source = "struct NestedPayload:\n    value: i64"
    val sibling_a_source = "use hidden.defs.\{NestedPayload\}\nenum SiblingEvent:\n    Wrapped(value: NestedPayload)\nfn sibling_value() -> i64:\n    42"
    val sibling_b_source = "pub fn own_value() -> i64:\n    7"
    val explicit_source = "use shared_pkg.a.*\nfn accept(value: NestedPayload) -> NestedPayload:\n    value"

    val hidden = parse_full_frontend(hidden_source, "hidden.defs", "hidden.defs", log)
    val sibling_a = parse_full_frontend(sibling_a_source, "shared_pkg.a", "shared_pkg.a", log)
    val sibling_b = parse_full_frontend(sibling_b_source, "shared_pkg.b", "shared_pkg.b", log)
    val explicit_consumer = parse_full_frontend(explicit_source, "explicit.consumer", "explicit.consumer", log)

    var modules: Dict<text, Module> = {}
    modules["hidden.defs"] = hidden
    modules["shared_pkg.a"] = sibling_a
    modules["shared_pkg.b"] = sibling_b
    val sources = [
        SourceFile(path: "hidden/defs.spl", content: hidden_source, module_name: "hidden.defs"),
        SourceFile(path: "shared_pkg/a.spl", content: sibling_a_source, module_name: "shared_pkg.a"),
        SourceFile(path: "shared_pkg/b.spl", content: sibling_b_source, module_name: "shared_pkg.b")
    ]
    val surfaces = build_surfaces(modules, sources)

    var sibling_lowering = hirlowering_for_module("shared_pkg.b", surfaces)
    val sibling_hir = sibling_lowering.lower_module(sibling_b)
    if sibling_lowering.errors.len() != 0: rt_exit(41)
    if sibling_hir.symbols.lookup("NestedPayload") != nil: rt_exit(42)
    if sibling_hir.symbols.lookup("SiblingEvent") == nil: rt_exit(43)
    if sibling_hir.enums.keys().len() != 0: rt_exit(44)

    var explicit_lowering = hirlowering_for_module("explicit.consumer", surfaces)
    val explicit_hir = explicit_lowering.lower_module(explicit_consumer)
    if explicit_lowering.errors.len() != 0: rt_exit(45)
    if explicit_hir.symbols.lookup("NestedPayload") == nil: rt_exit(46)
    if explicit_hir.symbols.lookup("SiblingEvent") == nil: rt_exit(47)
    if explicit_hir.enums.keys().len() == 0: rt_exit(48)

    rt_exit(30)
    0
