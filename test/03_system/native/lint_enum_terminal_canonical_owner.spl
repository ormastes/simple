# Exact regression for stage4_lint_enum_terminal_collision_2026_08_03.
# The lint facade and easy-fix contract must expose the same physical enum
# terminals. Importing both routes under the same local spellings therefore
# must remain a valid compiled entry closure.
use compiler.tools.lint.main.{LintLevel, LintCategory}
use std.tooling.easy_fix.types.{LintLevel, LintCategory}

extern fn rt_exit(code: i32)

fn main() -> i64:
    val level = LintLevel.Deny
    val category = LintCategory.Correctness
    if level != LintLevel.Deny: rt_exit(41)
    if category != LintCategory.Correctness: rt_exit(42)
    rt_exit(30)
    0
