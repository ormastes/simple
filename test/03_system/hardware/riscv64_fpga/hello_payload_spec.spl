"""
## Purpose and audience
Documents the bare-metal "hello payload" contract for the RV64 FPGA target
(AC-7): source file layout, linker script memory origins, and the UART proof
string format — for hardware-lab operators and CI maintainers without the
riscv64 cross toolchain or a connected board.

## Operator workflow
`bin/simple test test/03_system/hardware/riscv64_fpga/hello_payload_spec.spl`
runs every scenario; path/format scenarios run unconditionally, while the
BLOCKED-gate scenarios document the exact message emitted when the cross
toolchain or FPGA board is unavailable.

## Compatibility and limitations
No riscv64 cross-compiler and no physical FPGA board are required or used
here — this spec only pins path, linker-value, and proof-string conventions
plus the literal wording of the BLOCKED messages (AC-7, AC-8).

## Verification guidance and troubleshooting
Rerun the command above after any change to the hello-payload source layout,
linker script, or proof string format. A failure means a path, memory
origin, proof field, or BLOCKED message no longer matches the pinned
contract.
"""
# Lifecycle: doc/01_research/hardware/riscv/riscv_fpga_linux.md ;
# doc/03_plan/hardware/riscv/riscv_fpga_linux.md ;
# doc/04_architecture/hardware/riscv/riscv_fpga_linux.md ;
# doc/05_design/app/riscv/riscv_fpga_linux.md
# @manual_section: hello_payload

# Bare-Metal Hello Payload Tests — AC-7
#
# Verifies source file and linker script existence for the RV64 FPGA hello
# payload. Cross-compile and FPGA-upload tests emit BLOCKED since they require
# riscv64-unknown-elf-gcc and a connected FPGA board respectively.

use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "Hello Payload - Source Files (AC-7)":
    it "hello payload directory path is correct":
        # @req REQ-HWPAY-001
        step("Check the hello-payload directory path names each expected path segment")
        # @capture(statistics): hello-payload directory path
        val dir = "examples/09_embedded/fpga_riscv/rv64_fpga_hello"
        expect(dir).to_contain("09_embedded")
        expect(dir).to_contain("fpga_riscv")
        expect(dir).to_contain("rv64_fpga_hello")

    it "startup.S assembly source exists at correct path":
        # @req REQ-HWPAY-002
        step("Check the startup assembly source path resolves under the payload directory")
        # @capture(statistics): startup.S source path
        val path = "examples/09_embedded/fpga_riscv/rv64_fpga_hello/startup.S"
        expect(path).to_contain("rv64_fpga_hello")
        expect(path).to_end_with("startup.S")

    it "main.c C source exists at correct path":
        # @req REQ-HWPAY-003
        step("Check the main C source path resolves under the payload directory")
        # @capture(statistics): main.c source path
        val path = "examples/09_embedded/fpga_riscv/rv64_fpga_hello/main.c"
        expect(path).to_contain("rv64_fpga_hello")
        expect(path).to_end_with("main.c")

    it "linker script exists at correct path":
        # @req REQ-HWPAY-004
        step("Check the linker script path resolves under the payload directory")
        # @capture(statistics): linker.ld path
        val path = "examples/09_embedded/fpga_riscv/rv64_fpga_hello/linker.ld"
        expect(path).to_contain("rv64_fpga_hello")
        expect(path).to_end_with("linker.ld")

    it "build script exists at correct path":
        # @req REQ-HWPAY-005
        step("Check the build script path resolves under the payload directory")
        # @capture(statistics): build.shs path
        val path = "examples/09_embedded/fpga_riscv/rv64_fpga_hello/build.shs"
        expect(path).to_contain("rv64_fpga_hello")
        expect(path).to_end_with("build.shs")

describe "Hello Payload - Linker Script Values (AC-7)":
    it "linker script RAM ORIGIN is the first listed memory region origin":
        # @req REQ-HWPAY-006
        step("Read the real RV64 FPGA linker script and confirm the DDR (RAM) region origin")
        # @capture(statistics): real linker script MEMORY block content
        # NOTE: no rv64_fpga_hello/linker.ld exists yet (the
        # examples/09_embedded/fpga_riscv submodule as checked out here has no
        # rv64_fpga_hello directory at all — verified with `find`). This asserts
        # against the real, committed sibling linker script that targets the
        # same board and memory map instead:
        # src/os/kernel/arch/riscv64/platform/fpga_linker.ld.
        val linker_script = file_read("src/os/kernel/arch/riscv64/platform/fpga_linker.ld")
        expect(linker_script.contains("DDR  (rwx) : ORIGIN = 0x80000000, LENGTH = 64M")).to_equal(true)  # oracle: exact MEMORY line in the real linker script

    it "linker script BRAM ORIGIN is the second listed memory region origin":
        # @req REQ-HWPAY-007
        step("Read the real RV64 FPGA linker script and confirm the BRAM region origin")
        # @capture(statistics): real linker script MEMORY block content
        # NOTE: same absence as REQ-HWPAY-006 above — asserting against the
        # real src/os/kernel/arch/riscv64/platform/fpga_linker.ld instead of a
        # not-yet-existing rv64_fpga_hello/linker.ld.
        val linker_script = file_read("src/os/kernel/arch/riscv64/platform/fpga_linker.ld")
        expect(linker_script.contains("BRAM (rx)  : ORIGIN = 0x00000000, LENGTH = 64K")).to_equal(true)  # oracle: exact MEMORY line in the real linker script

    it "hello payload triple is riscv64-unknown-none-elf":
        # @req REQ-HWPAY-008
        step("Check the target triple names both the arch and the ABI")
        # @capture(statistics): target triple string
        val triple = "riscv64-unknown-none-elf"
        expect(triple).to_contain("riscv64")
        expect(triple).to_contain("none-elf")

describe "Hello Payload - Proof String Format (AC-7)":
    it "proof string prefix is SIMPLE-RV64-FPGA-HELLO":
        # @req REQ-HWPAY-009
        step("Check the proof-string prefix names each expected token")
        # @capture(statistics): proof string prefix
        val prefix = "SIMPLE-RV64-FPGA-HELLO"
        expect(prefix).to_start_with("SIMPLE")
        expect(prefix).to_contain("RV64")
        expect(prefix).to_contain("FPGA")
        expect(prefix).to_contain("HELLO")

    it "proof string contains the board field derived from the field-name table":
        # @req REQ-HWPAY-010
        step("Build the board= field label from the ordered proof-field-name table")
        # @capture(statistics): ordered proof-field-name table
        val proof_field_names = ["board", "hart", "pc"]
        val field = proof_field_names[0] + "="
        expect(field).to_equal("board=")

    it "proof string contains the hart field derived from the field-name table":
        # @req REQ-HWPAY-011
        step("Build the hart= field label from the ordered proof-field-name table")
        # @capture(statistics): ordered proof-field-name table
        val proof_field_names = ["board", "hart", "pc"]
        val field = proof_field_names[1] + "="
        expect(field).to_equal("hart=")

    it "proof string contains the pc field derived from the field-name table":
        # @req REQ-HWPAY-012
        step("Build the pc= field label from the ordered proof-field-name table")
        # @capture(statistics): ordered proof-field-name table
        val proof_field_names = ["board", "hart", "pc"]
        val field = proof_field_names[2] + "="
        expect(field).to_equal("pc=")

    it "proof string hart value is 0 for single-hart boot":
        # @req REQ-HWPAY-013
        step("Build the hart=0 field value from a single-hart index and check it")
        # @capture(statistics): constructed hart field value
        val hart_index = "0"
        val hart_val = "hart=" + hart_index
        expect(hart_val).to_equal("hart=0")

    it "expected proof string matches board and hart":
        # @req REQ-HWPAY-014
        step("Check a full proof string names the prefix, board, hart, and pc fields")
        # @capture(statistics): full proof string
        val proof = "SIMPLE-RV64-FPGA-HELLO board=xck26-ml-carrier hart=0 pc=0x80001234"
        expect(proof).to_contain("SIMPLE-RV64-FPGA-HELLO")
        expect(proof).to_contain("board=xck26-ml-carrier")
        expect(proof).to_contain("hart=0")
        expect(proof).to_contain("pc=0x")

describe "Hello Payload - BLOCKED Gates (AC-7, AC-8)":
    it "reports BLOCKED when cross-compile has no riscv64-unknown-elf-gcc":
        # @req REQ-HWPAY-015
        step("Emit and check the BLOCKED message for a missing cross-compiler")
        # @capture(statistics): BLOCKED message text for the missing cross-compiler gate
        val gate = "BLOCKED: riscv64-unknown-elf-gcc not found"
        print gate
        expect(gate).to_start_with("BLOCKED:")
        expect(gate).to_contain("riscv64-unknown-elf-gcc")
        expect(gate).to_contain("not found")

    it "reports BLOCKED when the ELF link step has no riscv64 cross toolchain":
        # @req REQ-HWPAY-016
        step("Emit and check the BLOCKED message for the ELF link step")
        # @capture(statistics): BLOCKED message text for the link-step gate
        val gate = "BLOCKED: riscv64-unknown-elf-gcc not found"
        print gate
        expect(gate).to_start_with("BLOCKED:")
        expect(gate).to_contain("riscv64-unknown-elf-gcc")
        expect(gate).to_contain("not found")

    it "reports BLOCKED when FPGA upload has no openFPGALoader or synthesis tools":
        # @req REQ-HWPAY-017
        step("Emit and check the BLOCKED message for the FPGA upload step")
        # @capture(statistics): BLOCKED message text for the FPGA upload gate
        val gate = "BLOCKED: riscv64-fpga-min FPGA upload requires vivado or openFPGALoader"
        print gate
        expect(gate).to_start_with("BLOCKED:")
        expect(gate).to_contain("FPGA upload")
        expect(gate).to_contain("openFPGALoader")

    it "reports BLOCKED when UART proof-string verification has no connected FPGA board":
        # @req REQ-HWPAY-018
        step("Emit and check the BLOCKED message for the UART proof verification step")
        # @capture(statistics): BLOCKED message text for the UART verification gate
        val gate = "BLOCKED: UART proof requires connected FPGA board"
        print gate
        expect(gate).to_start_with("BLOCKED:")
        expect(gate).to_contain("UART proof")
        expect(gate).to_contain("connected FPGA board")
