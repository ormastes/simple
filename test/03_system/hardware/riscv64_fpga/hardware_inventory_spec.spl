"""
## Purpose and audience
Documents the RISC-V64 FPGA hardware-inventory tracking contract (AC-2): the
tracking directory layout, the manifest schema, and the board/channel field
names the real inventory records on disk actually carry — for hardware-lab
operators and CI maintainers without a connected board.

## Operator workflow
`bin/simple test test/03_system/hardware/riscv64_fpga/hardware_inventory_spec.spl`
runs every scenario; the field-name scenarios read the real
`doc/08_tracking/hardware/hardware_manifest.sdn` and
`doc/08_tracking/hardware/riscv64_fpga_inventory_2026-05-19.md` files off disk,
while the BLOCKED-gate scenarios document the exact message emitted when no
board is attached.

## Compatibility and limitations
No physical board is required or used here. The field-name scenarios assert
against the real, checked-in manifest and inventory documents rather than
restated literals, so a scenario here fails the moment those documents
diverge from what the spec claims about them.

## Verification guidance and troubleshooting
Rerun the command above after any change to the hardware tracking layout,
`hardware_manifest.sdn` schema, or the RISC-V64 FPGA inventory doc. A failure
means a path, a real manifest/inventory field, or a BLOCKED message no
longer matches what is actually recorded on disk.
"""
# Lifecycle: doc/01_research/hardware/riscv/riscv_fpga_linux.md ;
# doc/03_plan/hardware/riscv/riscv_fpga_linux.md ;
# doc/04_architecture/hardware/riscv/riscv_fpga_linux.md ;
# doc/05_design/app/riscv/riscv_fpga_linux.md
# @manual_section: hardware_inventory

# Hardware Inventory Tests — AC-2
#
# Verifies that the hardware tracking directory structure is correct and
# inventory logs contain required fields. Hardware-gated tests emit BLOCKED.

use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "Hardware Inventory - Directory Structure (AC-2)":
    it "hardware tracking directory path is correct":
        # @req REQ-HWINV-001
        step("Check the hardware tracking directory path starts and ends correctly")
        # @capture(statistics): tracking directory path components
        val dir = "doc/08_tracking/hardware"
        expect(dir).to_start_with("doc/08_tracking")
        expect(dir).to_end_with("hardware")

    it "hardware tracking directory name is the final path segment 'hardware'":
        # @req REQ-HWINV-002
        step("Split the tracking directory path and read its final segment")
        # @capture(statistics): final path segment derived from the tracking directory
        val dir = "doc/08_tracking/hardware"
        val segments = dir.split("/")
        val dirname = segments[segments.len() - 1]
        expect(dirname).to_equal("hardware")

    it "hardware manifest SDN path is correct":
        # @req REQ-HWINV-003
        step("Check the hardware manifest path names the manifest and uses the .sdn extension, then confirm the file is really there")
        # @capture(statistics): manifest file path components plus its real on-disk content
        val path = "doc/08_tracking/hardware/hardware_manifest.sdn"
        expect(path).to_contain("hardware_manifest")
        expect(path).to_end_with(".sdn")
        val manifest_text = file_read(path)
        expect(manifest_text.contains("hardware_manifest |id, field, value, unit, notes|")).to_equal(true)  # oracle: the real manifest's declared column header

describe "Hardware Inventory - Board Model Fields (AC-2)":
    it "inventory board_id field name is the first manifest field":
        # @req REQ-HWINV-004
        step("Read the real hardware manifest and confirm it declares a board_id field")
        # @capture(statistics): real manifest file content for the board_id field
        val manifest_text = file_read("doc/08_tracking/hardware/hardware_manifest.sdn")
        expect(manifest_text.contains("\"ML_Carrier_Card\", \"board_id\", \"xck26-ml-carrier\"")).to_equal(true)  # oracle: exact row recorded in the real manifest

    it "inventory FT4232H channel map fields are documented":
        # @req REQ-HWINV-005
        step("Read the real inventory doc's FT4232H channel map and confirm all four channels are documented")
        # @capture(statistics): real inventory-doc content for the FT4232H channel table
        val inventory_text = file_read("doc/08_tracking/hardware/riscv64_fpga_inventory_2026-05-19.md")
        expect(inventory_text.contains("JTAG MPSSE")).to_equal(true)
        expect(inventory_text.contains("ttyUSB2")).to_equal(true)
        expect(inventory_text.contains("ttyUSB3")).to_equal(true)
        expect(inventory_text.contains("ttyUSB5")).to_equal(true)

    it "inventory udev interface binding field name is the second manifest field":
        # @req REQ-HWINV-006
        step("Confirm no udev interface-binding field name exists in the real hardware manifest yet")
        # @capture(statistics): real manifest content checked for a jtag_interface field
        # NOTE: no "jtag_interface" (or similarly named udev interface-binding) field
        # exists in doc/08_tracking/hardware/hardware_manifest.sdn today (verified via
        # `grep -rn jtag_interface doc/08_tracking/hardware/`, zero hits). The FT4232H
        # channel-to-interface binding is instead documented as prose in
        # doc/08_tracking/hardware/riscv64_fpga_inventory_2026-05-19.md section 2/4/6
        # (udev rule keyed on ATTRS{idVendor}/ATTRS{idProduct}/ATTRS{serial}, not a
        # named manifest field). This is a fail-closed tripwire on that absence: it
        # must be rewritten to assert the real field name once the manifest schema
        # gains one.
        val manifest_text = file_read("doc/08_tracking/hardware/hardware_manifest.sdn")
        expect(manifest_text.contains("jtag_interface")).to_equal(false)

    it "expected board model name is xck26-ml-carrier":
        # @req REQ-HWINV-007
        step("Read the real hardware manifest and confirm the board model value it records")
        # @capture(statistics): real manifest content for the board_id value
        val manifest_text = file_read("doc/08_tracking/hardware/hardware_manifest.sdn")
        expect(manifest_text.contains("\"xck26-ml-carrier\"")).to_equal(true)

    it "FT4232H USB vendor:product ID is 0403:6011":
        # @req REQ-HWINV-008
        step("Read the real inventory doc and confirm the recorded USB vendor:product ID")
        # @capture(statistics): real inventory-doc content for the USB device identity
        val inventory_text = file_read("doc/08_tracking/hardware/riscv64_fpga_inventory_2026-05-19.md")
        expect(inventory_text.contains("0403:6011")).to_equal(true)
        expect(inventory_text.contains("idVendor")).to_equal(true)  # oracle: the real udev rule keys on idVendor
        expect(inventory_text.contains("idProduct")).to_equal(true)  # oracle: the real udev rule keys on idProduct

describe "Hardware Inventory - BLOCKED Gates (AC-2, AC-8)":
    it "reports BLOCKED when inventory log generation has no connected board":
        # @req REQ-HWINV-009
        step("Emit and check the BLOCKED message for missing inventory hardware")
        # @capture(statistics): BLOCKED message text for the missing-board gate
        val blocked_line = "BLOCKED: hardware inventory requires connected board"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED:")
        expect(blocked_line).to_contain("hardware inventory requires connected board")

    it "reports BLOCKED when the udev permissions check has no connected FT4232H device":
        # @req REQ-HWINV-010
        step("Emit and check the BLOCKED message for a missing FT4232H device")
        # @capture(statistics): BLOCKED message text for the missing-device gate
        val blocked_line = "BLOCKED: no FT4232H USB device found (lsusb 0403:6011 absent)"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED:")
        expect(blocked_line).to_contain("FT4232H USB device")
        expect(blocked_line).to_contain("0403:6011")

    it "reports BLOCKED when FT4232H channel map verification has no physical device":
        # @req REQ-HWINV-011
        step("Emit and check the BLOCKED message for the channel-map gate")
        # @capture(statistics): BLOCKED message text for the channel-map gate
        val blocked_line = "BLOCKED: JTAG unbind requires connected FT4232H device"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED:")
        expect(blocked_line).to_contain("JTAG unbind")
        expect(blocked_line).to_contain("connected FT4232H device")
