"""
## Purpose and audience
Executable evidence for the hardware manifest contract (AC-6): the
published `doc/08_tracking/hardware/hardware_manifest.sdn` must exist in
SDN form and carry every required board field with the documented xck26
ML-carrier defaults. Written for the hardware/bring-up team and the
preflight gate that loads this manifest before FPGA runs.

## Operator workflow
Run this file with the pure-Simple binary, e.g.
`./src/compiler_rust/target/bootstrap/simple run test/03_system/hardware/riscv64_fpga/manifest_format_spec.spl`
and read the per-scenario verdicts; no hardware is required — every
scenario reads the committed manifest from the repo tree.

## Compatibility and limitations
Static content contract only: this spec asserts what the manifest file
declares, not what the board actually implements. Hardware-side counters
are covered by the riscv64_fpga inventory and preflight specs.

## Verification guidance and troubleshooting
A failure here means the manifest schema or its defaults moved: re-run the
file, read the first failing expect, and compare the named field against
the manifest row it cites. A missing-file failure means the manifest was
moved without updating this contract and the preflight gate.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: hardware manifest format

use std.spec.*
use std.spec.step
use std.file_system.{file_exists, file_read_text}

describe "Hardware Manifest - File Location (AC-6)":
    it "publishes hardware_manifest.sdn under doc/08_tracking/hardware":
        # @req REQ-HWMANIFEST-001
        # @capture(bit_table): on-disk presence verdict for the manifest path
        step("Check the manifest path committed in the repo tree")
        val present = file_exists("doc/08_tracking/hardware/hardware_manifest.sdn")
        expect(present).to_equal(true)  # oracle: the preflight gate loads the manifest from exactly this path

    it "serves readable SDN content from the manifest path":
        # @req REQ-HWMANIFEST-001
        # @capture(bit_table): readability verdict for the manifest content
        step("Read the manifest and check it is non-empty SDN with a .sdn path")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("hardware_manifest |")).to_equal(true)  # oracle: the file opens with the SDN table header
        expect(manifest.len() > 200).to_equal(true)  # oracle: the published manifest carries 21 data rows, far past any stub length

    it "rejects JSON and YAML encodings for the manifest":
        # @req REQ-HWMANIFEST-002
        # @capture(bit_table): encoding-verdict checks against JSON/YAML markers
        step("Scan the manifest content for JSON and YAML encoding markers")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("{\"")).to_equal(false)  # oracle: an SDN manifest must not carry JSON object syntax
        expect(manifest.contains("---")).to_equal(false)  # oracle: an SDN manifest must not carry YAML document markers

describe "Hardware Manifest - Required Fields (AC-6)":
    it "manifest schema includes board_id field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for board_id
        step("Scan the manifest for the board_id schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"board_id\"")).to_equal(true)  # oracle: board identity is a required manifest field

    it "manifest schema includes reset_pc field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for reset_pc
        step("Scan the manifest for the reset_pc schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"reset_pc\"")).to_equal(true)  # oracle: the M-mode entry address is a required manifest field

    it "manifest schema includes ram_base field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for ram_base
        step("Scan the manifest for the ram_base schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"ram_base\"")).to_equal(true)  # oracle: the DDR origin is a required manifest field

    it "manifest schema includes ram_size field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for ram_size
        step("Scan the manifest for the ram_size schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"ram_size\"")).to_equal(true)  # oracle: the DDR size is a required manifest field

    it "manifest schema includes uart_base field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for uart_base
        step("Scan the manifest for the uart_base schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"uart_base\"")).to_equal(true)  # oracle: the console MMIO base is a required manifest field

    it "manifest schema includes uart_baud field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for uart_baud
        step("Scan the manifest for the uart_baud schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"uart_baud\"")).to_equal(true)  # oracle: the console baud is a required manifest field

    it "manifest schema includes timer_base field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for timer_base
        step("Scan the manifest for the timer_base schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"timer_base\"")).to_equal(true)  # oracle: the CLINT base is a required manifest field

    it "manifest schema includes plic_base field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for plic_base
        step("Scan the manifest for the plic_base schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"plic_base\"")).to_equal(true)  # oracle: the PLIC base is a required manifest field

    it "manifest schema includes hart_count field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for hart_count
        step("Scan the manifest for the hart_count schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"hart_count\"")).to_equal(true)  # oracle: the hart count is a required manifest field

    it "manifest schema includes timebase_hz field":
        # @req REQ-HWMANIFEST-003
        # @capture(bit_table): schema presence verdict for timebase_hz
        step("Scan the manifest for the timebase_hz schema row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"timebase_hz\"")).to_equal(true)  # oracle: the timebase frequency is a required manifest field

    it "manifest has exactly 10 required fields for the ML carrier card":
        # @req REQ-HWMANIFEST-004
        # @capture(bit_table): per-row count for the ML_Carrier_Card block
        step("Count the manifest rows belonging to the ML_Carrier_Card board")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        var carrier_rows = 0
        for line in manifest.split("\n"):
            if line.contains("ML_Carrier_Card"):
                carrier_rows = carrier_rows + 1
        expect(carrier_rows).to_equal(10)  # oracle: the xck26 ML-carrier block declares exactly one row per required field

describe "Hardware Manifest - Default Values (AC-6)":
    it "default ram_base for xck26 is 0x80000000":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for ram_base
        step("Check the ram_base default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"ram_base\", \"0x80000000\"")).to_equal(true)  # oracle: the published DDR origin default is pinned to 0x80000000

    it "default uart_base for xck26 ml-carrier is 0x10000000":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for uart_base
        step("Check the uart_base default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"uart_base\", \"0x10000000\"")).to_equal(true)  # oracle: the published 16550 MMIO default is pinned to 0x10000000

    it "default timer_base (CLINT) is 0x02000000":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for timer_base
        step("Check the timer_base default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"timer_base\", \"0x02000000\"")).to_equal(true)  # oracle: the published CLINT default is pinned to 0x02000000

    it "default plic_base is 0x0C000000":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for plic_base
        step("Check the plic_base default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"plic_base\", \"0x0C000000\"")).to_equal(true)  # oracle: the published PLIC default is pinned to 0x0C000000

    it "default uart_baud is 115200":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for uart_baud
        step("Check the uart_baud default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"uart_baud\", \"115200\"")).to_equal(true)  # oracle: the published console baud default is pinned to 115200

    it "default timebase_hz is 10000000 (10 MHz)":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for timebase_hz
        step("Check the timebase_hz default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"timebase_hz\", \"10000000\"")).to_equal(true)  # oracle: the published timebase default is pinned to 10 MHz

    it "default hart_count is 1":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for hart_count
        step("Check the hart_count default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"hart_count\", \"1\"")).to_equal(true)  # oracle: the published default boots a single hart

    it "default reset_pc for xck26 is the DDR entry 0x80000000":
        # @req REQ-HWMANIFEST-005
        # @capture(bit_table): default-value row for reset_pc
        step("Check the reset_pc default in the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("\"reset_pc\", \"0x80000000\"")).to_equal(true)  # oracle: M-mode entry is pinned to the DDR base 0x80000000

describe "Hardware Manifest - SDN Format (AC-6)":
    it "SDN table name is hardware_manifest":
        # @req REQ-HWMANIFEST-006
        # @capture(bit_table): table-header verdict for the manifest
        step("Check the SDN table header of the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("hardware_manifest |")).to_equal(true)  # oracle: the loader resolves rows under the hardware_manifest table name

    it "SDN format uses pipe-delimited column headers":
        # @req REQ-HWMANIFEST-006
        # @capture(bit_table): column-header verdict for the manifest
        step("Check the pipe-delimited column header row of the manifest")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("|id, field, value, unit, notes|")).to_equal(true)  # oracle: every manifest row is keyed by these five columns

    it "SDN board_id value for xck26 ml-carrier is correct":
        # @req REQ-HWMANIFEST-006
        # @capture(bit_table): board identity verdict for the manifest
        step("Check the board_id value of the ML_Carrier_Card row")
        val manifest = file_read_text("doc/08_tracking/hardware/hardware_manifest.sdn") ?? ""
        expect(manifest.contains("xck26-ml-carrier")).to_equal(true)  # oracle: the published board id must match the Kria K26 carrier identifier
