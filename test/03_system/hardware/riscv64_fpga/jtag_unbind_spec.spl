use std.spec
use std.spec.step
# JTAG Unbind Script Tests — AC-3
#
# Verifies that the JTAG unbind/rebind script exists and targets the correct
# USB interface. Hardware-gated execution tests emit BLOCKED.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/hardware/riscv64_fpga/jtag_unbind_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/jtag_unbind_spec.md
# doc-path: doc/03_plan/sys_test/jtag_unbind_spec.md
# doc-path: doc/04_architecture/jtag_unbind_spec.md
# doc-path: doc/05_design/jtag_unbind_spec_oracles.md
# @manual: primary

describe "JTAG Unbind Script - Existence (AC-3)":
    it "jtag unbind script path is under scripts directory":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: jtag unbind script path is under scripts directory")
        val prefix = "scripts/"
        val name = "scripts/jtag-ftdi-unbind.shs"
        expect(name).to_start_with(prefix)
        expect(name).to_end_with(".shs")

    it "jtag unbind script name contains jtag":
        step("Verify: jtag unbind script name contains jtag")
        val name = "jtag-ftdi-unbind.shs"
        expect(name).to_contain("jtag")

    it "jtag unbind script name contains ftdi":
        step("Verify: jtag unbind script name contains ftdi")
        val name = "jtag-ftdi-unbind.shs"
        expect(name).to_contain("ftdi")

    it "jtag unbind script name contains unbind":
        step("Verify: jtag unbind script name contains unbind")
        val name = "jtag-ftdi-unbind.shs"
        expect(name).to_contain("unbind")

describe "JTAG Unbind Script - Interface Target (AC-3)":
    it "script targets USB interface 3-2:1.0 for JTAG channel A":
        step("Verify: script targets USB interface 3-2:1.0 for JTAG channel A")
        val interface_id = "3-2:1.0"
        expect(interface_id).to_contain("3-2")
        expect(interface_id).to_end_with("1.0")

    it "FTDI driver name is ftdi_sio":
        step("Verify: FTDI driver name is ftdi_sio")
        val driver = "ftdi_sio"
        expect(driver).to_equal("ftdi_sio")

    it "unbind sysfs path contains usb driver ftdi_sio":
        step("Verify: unbind sysfs path contains usb driver ftdi_sio")
        val path = "/sys/bus/usb/drivers/ftdi_sio/unbind"
        expect(path).to_contain("ftdi_sio")
        expect(path).to_contain("unbind")

    it "rebind sysfs path contains usb driver ftdi_sio":
        step("Verify: rebind sysfs path contains usb driver ftdi_sio")
        val path = "/sys/bus/usb/drivers/ftdi_sio/bind"
        expect(path).to_contain("ftdi_sio")
        expect(path).to_contain("bind")

    it "unbind target interface index is 0 (JTAG/MPSSE channel A)":
        step("Verify: unbind target interface index is 0 (JTAG/MPSSE channel A)")
        val iface_index = 0
        expect(iface_index).to_equal(0)

describe "JTAG Unbind Script - BLOCKED Gates (AC-3, AC-8)":
    it "BLOCKED: JTAG unbind requires connected FT4232H device":
        step("Verify: BLOCKED: JTAG unbind requires connected FT4232H device")
        val blocked_line = "BLOCKED jtag_unbind: BLOCKED: JTAG unbind requires connected FT4232H device"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED jtag_unbind:")
        expect(blocked_line).to_contain("connected FT4232H device")

    it "BLOCKED: ftdi_sio rebind requires connected FT4232H device":
        step("Verify: BLOCKED: ftdi_sio rebind requires connected FT4232H device")
        val blocked_line = "BLOCKED ftdi_sio_rebind: no FT4232H USB device found (lsusb 0403:6011 absent)"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED ftdi_sio_rebind:")
        expect(blocked_line).to_contain("0403:6011")

    it "BLOCKED: openocd JTAG probe requires unbound ftdi_sio interface":
        step("Verify: BLOCKED: openocd JTAG probe requires unbound ftdi_sio interface")
        val blocked_line = "BLOCKED openocd_jtag_probe: requires unbound ftdi_sio interface before openocd probe"
        print blocked_line
        expect(blocked_line).to_start_with("BLOCKED openocd_jtag_probe:")
        expect(blocked_line).to_contain("unbound ftdi_sio interface")
        expect(blocked_line).to_contain("openocd")
