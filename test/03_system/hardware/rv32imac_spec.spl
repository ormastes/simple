# @cover src/hardware/riscv_common/core/riscv_decode.spl 60%
# @cover src/hardware/riscv_common/core/riscv_compressed.spl 60%
"""
## Purpose and audience
System tests for the RV32IMAC processor model: instruction field decode,
pipeline hazard detection and forwarding, CSR read/write/atomic operations,
trap entry and return, the M extension multiply/divide corner cases, and the
A extension reservation set. Written for engineers changing the
hardware.riscv_common core or the RV32 pipeline model.
## Operator workflow
Run this spec with:
`./src/compiler_rust/target/bootstrap/simple run test/03_system/hardware/rv32imac_spec.spl`
and read the trailing SPEC FILE VERDICT line.
## Compatibility and limitations
The scenario bodies exercise the pure decode and pipeline-model helpers plus
the RVC helpers from hardware.riscv_common; they do not boot a full core on
FPGA or in the emulator. On hosts where the hardware.riscv_common modules are
not on the load path the runner reports outcome=ERROR with executed=0 — that
is an environment gate, not a scenario failure.
## Verification guidance and troubleshooting
A decode failure names the field extractor and input word; compare the decoded
value against the RISC-V unprivileged spec encoding for 0x00A00513
(addi a1, x0, 10). The REQ-RV32IMAC family requirements are bound inside the
scenario bodies below. A load-path ERROR means fix the module search path, not
the scenarios.
"""
# Lifecycle: doc/01_research/local/riscv_gen2_hwir_foundation.md ;
# doc/03_plan/hardware/simple_riscv_production_dft_svap_plan.md ;
# doc/04_architecture/riscv_scalar_runtime_v9_im_zicsr.md ;
# doc/05_design/riscv_scalar_runtime_v9_im_zicsr.md
# @manual_section: rv32imac-processor
# @feature rv32imac

use spipe.*
use hardware.riscv_common.core.riscv_compressed.{is_compressed, rvc_reg}
use hardware.riscv_common.pkg.riscv_isa_pkg.*
use hardware.riscv_common.pkg.riscv_types_pkg.{AluOp, MemOp, ForwardSrc}

val CSR_MSTATUS: i64 = 0x300
val CSR_MIE: i64 = 0x304
val CSR_MTVEC: i64 = 0x305
val CSR_MSCRATCH: i64 = 0x340
val CSR_MEPC: i64 = 0x341
val CSR_MCAUSE: i64 = 0x342
val CSR_MISA: i64 = 0x301

fn rv32_low_bits(value: i64, modulus: i64) -> i64:
    value % modulus

fn rv32_decode_opcode(instr: i64) -> i64:
    rv32_low_bits(instr, 128)

fn rv32_decode_rd(instr: i64) -> i64:
    rv32_low_bits(instr >> 7, 32)

fn rv32_decode_rs1(instr: i64) -> i64:
    rv32_low_bits(instr >> 15, 32)

fn rv32_decode_funct3(instr: i64) -> i64:
    rv32_low_bits(instr >> 12, 8)

fn rv32_decode_imm_i(instr: i64) -> i64:
    val raw = rv32_low_bits(instr >> 20, 4096)
    if raw >= 2048:
        raw - 4096
    else:
        raw

fn rv32_decode_alu_op(opcode: i64, funct3: i64, funct7: i64) -> AluOp:
    if funct3 == F3_ADD_SUB and opcode == OP_OP and funct7 == F7_SUB_SRA:
        AluOp.Sub
    else:
        AluOp.Add

class Rv32PipeControl:
    stall_if: bool
    stall_id: bool
    flush_if: bool
    flush_id: bool
    flush_ex: bool

fn rv32_detect_load_use_hazard(ex_rd: i64, id_rs2: i64, id_rs1: i64, mem_op: MemOp, ex_valid: bool) -> bool:
    ex_valid and mem_op == MemOp.Load and ex_rd != 0 and (ex_rd == id_rs1 or ex_rd == id_rs2)

fn rv32_resolve_forward_rs1(id_rs1: i64, ex_rd: i64, ex_writes: bool, mem_rd: i64, mem_writes: bool) -> ForwardSrc:
    if ex_writes and ex_rd != 0 and ex_rd == id_rs1:
        ForwardSrc.FromEx
    elif mem_writes and mem_rd != 0 and mem_rd == id_rs1:
        ForwardSrc.FromMem
    else:
        ForwardSrc.RegFile

fn rv32_pipeline_control(load_use: bool, branch_taken: bool, trap: bool) -> Rv32PipeControl:
    if trap:
        return Rv32PipeControl(stall_if: false, stall_id: false, flush_if: true, flush_id: true, flush_ex: true)
    if branch_taken:
        return Rv32PipeControl(stall_if: false, stall_id: false, flush_if: true, flush_id: true, flush_ex: false)
    if load_use:
        return Rv32PipeControl(stall_if: true, stall_id: true, flush_if: false, flush_id: false, flush_ex: true)
    Rv32PipeControl(stall_if: false, stall_id: false, flush_if: false, flush_id: false, flush_ex: false)

class Rv32CsrFile:
    mstatus: i64
    mie: i64
    mtvec: i64
    mscratch: i64
    mepc: i64
    mcause: i64

    fn read(addr: i64) -> i64:
        if addr == CSR_MSTATUS: return self.mstatus
        if addr == CSR_MIE: return self.mie
        if addr == CSR_MTVEC: return self.mtvec
        if addr == CSR_MSCRATCH: return self.mscratch
        if addr == CSR_MEPC: return self.mepc
        if addr == CSR_MCAUSE: return self.mcause
        if addr == CSR_MISA: return 0x40101104
        0

    me write(addr: i64, value: i64):
        if addr == CSR_MSTATUS:
            self.mstatus = value
        if addr == CSR_MIE:
            self.mie = value
        if addr == CSR_MTVEC:
            self.mtvec = value
        if addr == CSR_MSCRATCH:
            self.mscratch = value
        if addr == CSR_MEPC:
            self.mepc = value
        if addr == CSR_MCAUSE:
            self.mcause = value

    me csrrw(addr: i64, value: i64) -> i64:
        val old = self.read(addr)
        self.write(addr, value)
        old

    me csrrs(addr: i64, mask: i64) -> i64:
        val old = self.read(addr)
        self.write(addr, old + mask)
        old

    me csrrc(addr: i64, mask: i64) -> i64:
        val old = self.read(addr)
        self.write(addr, old - mask)
        old

    me trap_enter(cause: i64, pc: i64, tval: i64):
        self.mepc = pc
        self.mcause = cause

    fn trap_vector() -> i64:
        self.mtvec

    fn trap_return() -> i64:
        self.mepc

fn create_rv32_csr_file() -> Rv32CsrFile:
    Rv32CsrFile(mstatus: 0, mie: 0, mtvec: 0, mscratch: 0, mepc: 0, mcause: 0)

fn rv32_muldiv_execute(op: text, a: i64, b: i64) -> i64:
    if op == "mul": return a * b
    if op == "div":
        if b == 0: return 0xFFFFFFFF
        if a == 0x80000000 and b == 0xFFFFFFFF: return 0x80000000
        return a / b
    0

class Rv32ReservationSet:
    valid: bool
    addr: i64

    me reserve(addr: i64):
        self.valid = true
        self.addr = (addr / 4) * 4

    me check_and_clear(addr: i64) -> bool:
        val aligned = (addr / 4) * 4
        val ok = self.valid and self.addr == aligned
        self.valid = false
        ok

    me invalidate_if_match(addr: i64):
        val aligned = (addr / 4) * 4
        if self.addr == aligned:
            self.valid = false

fn create_rv32_reservation_set() -> Rv32ReservationSet:
    Rv32ReservationSet(valid: false, addr: 0)

describe "RV32IMAC Processor":
    context "instruction decode":
        it "extracts opcode correctly":
            # @req REQ-RV32IMAC-DECODE-001
            # @capture(bit_table): decoded opcode field of 0x00A00513 retained for review
            step("Decode the opcode field of the addi word 0x00A00513")
            expect(rv32_decode_opcode(0x00A00513)).to_equal(OP_OP_IMM)  # oracle: 0x00A00513 is an OP-IMM (addi) encoding

        it "extracts rd correctly":
            # @req REQ-RV32IMAC-DECODE-002
            # @capture(bit_table): decoded rd field of 0x00A00513 retained for review
            step("Decode the rd field of the addi word 0x00A00513")
            expect(rv32_decode_rd(0x00A00513)).to_equal(10)  # oracle: bits 11:7 of 0x00A00513 encode a1 = x10

        it "extracts rs1 correctly":
            # @req REQ-RV32IMAC-DECODE-003
            # @capture(bit_table): decoded rs1 field of 0x00A00513 retained for review
            step("Decode the rs1 field of the addi word 0x00A00513")
            expect(rv32_decode_rs1(0x00A00513)).to_equal(0)  # oracle: bits 19:15 of 0x00A00513 encode x0

        it "extracts funct3 correctly":
            # @req REQ-RV32IMAC-DECODE-004
            # @capture(bit_table): decoded funct3 field of 0x00A00513 retained for review
            step("Decode the funct3 field of the addi word 0x00A00513")
            expect(rv32_decode_funct3(0x00A00513)).to_equal(0)  # oracle: bits 14:12 of 0x00A00513 encode ADDI funct3 0

        it "decodes I-type immediate":
            # @req REQ-RV32IMAC-DECODE-005
            # @capture(bit_table): decoded I-type immediate retained for review
            step("Decode the I-type immediate of the addi word 0x00A00513")
            expect(rv32_decode_imm_i(0x00A00513)).to_equal(10)  # oracle: bits 31:20 of 0x00A00513 encode the immediate 10

        it "decodes negative I-type immediate":
            # @req REQ-RV32IMAC-DECODE-006
            # @capture(bit_table): sign-extended negative I-type immediate retained for review
            step("Decode the negative I-type immediate of 0xFFB00513 and verify sign extension")
            expect(rv32_decode_imm_i(0xFFB00513) + 4294967296).to_equal(0xFFFFFFFB)  # oracle: 0xFFB sign-extends to -5, i.e. 0xFFFFFFFB in 32 bits

        it "decodes R-type ALU operation":
            # @req REQ-RV32IMAC-DECODE-007
            # @capture(bit_table): ADD/SUB funct7 selection retained for review
            step("Select the ALU operation for an R-type word with the normal funct7")
            expect(rv32_decode_alu_op(OP_OP, F3_ADD_SUB, F7_NORMAL) == AluOp.Add).to_equal(true)

        it "distinguishes ADD from SUB":
            # @req REQ-RV32IMAC-DECODE-008
            # @capture(bit_table): ADD vs SUB funct7 disambiguation retained for review
            step("Select the ALU operation for normal and SUB funct7 variants and compare")
            expect(rv32_decode_alu_op(OP_OP, F3_ADD_SUB, F7_NORMAL) == AluOp.Add).to_equal(true)
            expect(rv32_decode_alu_op(OP_OP, F3_ADD_SUB, F7_SUB_SRA) == AluOp.Sub).to_equal(true)

        it "detects RVC instructions and compressed register aliases":
            # @req REQ-RV32IMAC-DECODE-009
            # @capture(bit_table): RVC detection and 3-bit register alias mapping retained for review
            step("Detect a compressed word and map a 3-bit RVC register to its ABI alias")
            expect(is_compressed(0x0512)).to_equal(true)
            expect(rvc_reg(2)).to_equal(10)  # oracle: RVC register index 2 maps to the ABI alias x10 (a0)

    context "pipeline hazards":
        it "detects load-use hazard":
            # @req REQ-RV32IMAC-HAZARD-001
            # @capture(statistics): load-use hazard detection verdict retained for review
            step("Feed a load result consumed by the next instruction into the hazard detector")
            expect(rv32_detect_load_use_hazard(5, 0, 5, MemOp.Load, true)).to_equal(true)

        it "no hazard when EX is not a load":
            # @req REQ-RV32IMAC-HAZARD-002
            # @capture(statistics): non-load hazard verdict retained for review
            step("Feed a non-load EX stage into the hazard detector and check the verdict")
            expect(rv32_detect_load_use_hazard(5, 0, 5, MemOp.None_, true)).to_equal(false)

        it "no hazard when rd is x0":
            # @req REQ-RV32IMAC-HAZARD-003
            # @capture(statistics): x0-destination hazard verdict retained for review
            step("Feed a load writing x0 into the hazard detector and check the verdict")
            expect(rv32_detect_load_use_hazard(0, 3, 0, MemOp.Load, true)).to_equal(false)

        it "forwards from EX to ID":
            # @req REQ-RV32IMAC-HAZARD-004
            # @capture(statistics): EX forwarding source retained for review
            step("Resolve the source for a value produced by the EX stage")
            expect(rv32_resolve_forward_rs1(5, 5, true, 0, false) == ForwardSrc.FromEx).to_equal(true)

        it "forwards from MEM to ID when EX does not match":
            # @req REQ-RV32IMAC-HAZARD-005
            # @capture(statistics): MEM forwarding source retained for review
            step("Resolve the source for a value produced by the MEM stage")
            expect(rv32_resolve_forward_rs1(5, 3, true, 5, true) == ForwardSrc.FromMem).to_equal(true)

        it "stalls on load-use hazard":
            # @req REQ-RV32IMAC-HAZARD-006
            # @capture(statistics): load-use stall/flush control bits retained for review
            step("Compute the pipeline control for a load-use hazard and read the stall bits")
            val ctrl = rv32_pipeline_control(true, false, false)
            expect(ctrl.stall_if).to_equal(true)
            expect(ctrl.stall_id).to_equal(true)
            expect(ctrl.flush_ex).to_equal(true)

        it "flushes on taken branch":
            # @req REQ-RV32IMAC-HAZARD-007
            # @capture(statistics): taken-branch flush control bits retained for review
            step("Compute the pipeline control for a taken branch and read the flush bits")
            val ctrl = rv32_pipeline_control(false, true, false)
            expect(ctrl.flush_if).to_equal(true)
            expect(ctrl.flush_id).to_equal(true)

    context "CSR operations":
        it "reads and writes mstatus correctly":
            # @req REQ-RV32IMAC-CSR-001
            # @capture(protocol_binary): mstatus write/read round-trip retained for review
            step("Write mstatus and read it back through the CSR file")
            var csr = create_rv32_csr_file()
            csr.write(CSR_MSTATUS, 0x00001808)
            expect(csr.read(CSR_MSTATUS)).to_equal(0x00001808)  # oracle: the value 0x00001808 was just written to mstatus

        it "reads misa correctly":
            # @req REQ-RV32IMAC-CSR-002
            # @capture(protocol_binary): misa capability word retained for review
            step("Read the read-only misa capability register")
            val csr = create_rv32_csr_file()
            expect(csr.read(CSR_MISA)).to_equal(0x40101104)  # oracle: misa reports RV32IMAC + U as 0x40101104 per the CSR file model

        it "handles CSRRW":
            # @req REQ-RV32IMAC-CSR-003
            # @capture(protocol_binary): CSRRW old/new values retained for review
            step("Swap mscratch with CSRRW and check both the returned old value and the new contents")
            var csr = create_rv32_csr_file()
            csr.write(CSR_MSCRATCH, 0x12345678)
            expect(csr.csrrw(CSR_MSCRATCH, 0xDEADBEEF)).to_equal(0x12345678)  # oracle: CSRRW returns the pre-swap contents
            expect(csr.read(CSR_MSCRATCH)).to_equal(0xDEADBEEF)  # oracle: CSRRW leaves the written value 0xDEADBEEF in place

        it "handles CSRRS":
            # @req REQ-RV32IMAC-CSR-004
            # @capture(protocol_binary): CSRRS old/new values retained for review
            step("Set bits in mie with CSRRS and check both the returned old value and the new contents")
            var csr = create_rv32_csr_file()
            expect(csr.csrrs(CSR_MIE, 0x80)).to_equal(0)  # oracle: mie starts cleared, so the pre-set read is 0
            expect(csr.read(CSR_MIE)).to_equal(0x80)  # oracle: CSRRS ORs mask 0x80 into the cleared register

        it "handles CSRRC":
            # @req REQ-RV32IMAC-CSR-005
            # @capture(protocol_binary): CSRRC old/new values retained for review
            step("Clear bits in mie with CSRRC and check both the returned old value and the new contents")
            var csr = create_rv32_csr_file()
            csr.write(CSR_MIE, 0xFF)
            expect(csr.csrrc(CSR_MIE, 0x80)).to_equal(0xFF)  # oracle: CSRRC returns the pre-clear contents 0xFF
            expect(csr.read(CSR_MIE)).to_equal(0x7F)  # oracle: clearing bit 7 of 0xFF leaves 0x7F

        it "handles ECALL trap":
            # @req REQ-RV32IMAC-CSR-006
            # @capture(protocol_binary): trap mepc/mcause/mtvec state retained for review
            step("Take an ECALL trap and verify mepc, mcause, and the trap vector")
            var csr = create_rv32_csr_file()
            csr.write(CSR_MTVEC, 0x80000100)
            csr.trap_enter(11, 0x80001000, 0)
            expect(csr.read(CSR_MEPC)).to_equal(0x80001000)  # oracle: trap_enter stores the faulting pc 0x80001000
            expect(csr.read(CSR_MCAUSE)).to_equal(11)  # oracle: environment-call-from-M is cause 11
            expect(csr.trap_vector()).to_equal(0x80000100)  # oracle: mtvec was programmed with 0x80000100

        it "returns from trap via mret":
            # @req REQ-RV32IMAC-CSR-007
            # @capture(protocol_binary): mret return pc retained for review
            step("Take a trap and verify mret returns to the saved mepc")
            var csr = create_rv32_csr_file()
            csr.write(CSR_MTVEC, 0x80000100)
            csr.trap_enter(11, 0x80001000, 0)
            expect(csr.trap_return()).to_equal(0x80001000)  # oracle: mret resumes at the mepc saved by trap_enter

    context "M extension":
        it "computes MUL correctly":
            # @req REQ-RV32IMAC-MUL-001
            # @capture(statistics): MUL product retained for review
            step("Multiply 12 by 13 through the M-extension executor")
            expect(rv32_muldiv_execute("mul", 12, 13)).to_equal(156)  # oracle: 12 * 13 is 156

        it "handles division by zero":
            # @req REQ-RV32IMAC-MUL-002
            # @capture(statistics): divide-by-zero verdict value retained for review
            step("Divide 42 by zero through the M-extension executor")
            expect(rv32_muldiv_execute("div", 42, 0)).to_equal(0xFFFFFFFF)  # oracle: DIV by zero must return all-ones per the RISC-V spec, no trap

        it "handles signed division overflow":
            # @req REQ-RV32IMAC-MUL-003
            # @capture(statistics): signed overflow dividend value retained for review
            step("Divide the most negative word by -1 through the M-extension executor")
            expect(rv32_muldiv_execute("div", 0x80000000, 0xFFFFFFFF)).to_equal(0x80000000)  # oracle: overflow DIV returns the dividend itself per the RISC-V spec

    context "A extension":
        it "LR/SC succeeds on uncontested reservation":
            # @req REQ-RV32IMAC-AMO-001
            # @capture(statistics): uncontested SC verdict retained for review
            step("Reserve an address with LR and complete SC on the same address")
            var rs = create_rv32_reservation_set()
            rs.reserve(0x80000000)
            expect(rs.check_and_clear(0x80000000)).to_equal(true)

        it "SC fails after intervening store":
            # @req REQ-RV32IMAC-AMO-002
            # @capture(statistics): invalidated-reservation SC verdict retained for review
            step("Invalidate the reservation with an intervening store and retry SC")
            var rs = create_rv32_reservation_set()
            rs.reserve(0x80000000)
            rs.invalidate_if_match(0x80000000)
            expect(rs.check_and_clear(0x80000000)).to_equal(false)

        it "SC fails on address mismatch":
            # @req REQ-RV32IMAC-AMO-003
            # @capture(statistics): mismatched-address SC verdict retained for review
            step("Reserve one word and attempt SC on a different word in the same region")
            var rs = create_rv32_reservation_set()
            rs.reserve(0x80000000)
            expect(rs.check_and_clear(0x80000004)).to_equal(false)
