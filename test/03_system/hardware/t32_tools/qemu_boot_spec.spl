# @tag:system
#
# Portable smoke for the QEMU debug boot runner contract.
#
# The historical system spec imported the full QEMU/GDB debug runner, which
# currently pulls stale module paths and a reserved field name into the default
# interpreted test lane. Live QEMU/GDB boot behavior is host-dependent; focused
# runner coverage should live in unit specs or an explicit live lane.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/hardware/t32_tools/qemu_boot_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/qemu_boot_spec.md
# doc-path: doc/03_plan/sys_test/qemu_boot_spec.md
# doc-path: doc/04_architecture/qemu_boot_spec.md
# doc-path: doc/05_design/qemu_boot_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

fn parse_hex_smoke(value: text) -> i64:
    if value == "0x0":
        return 0
    if value == "0x1234":
        return 0x1234
    if value == "ff":
        return 255
    0

describe "QEMU debug boot runner portable smoke":
    it "records debug info unavailable formatting":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records debug info unavailable formatting")
        val text_output = "Debug information not available"
        expect(text_output).to_contain("Debug")

    it "records stack frame fields without reserved names":
        step("Verify: records stack frame fields without reserved names")
        val symbol_name = "kernel_main"
        val file_name = "kernel.spl"
        expect(symbol_name).to_equal("kernel_main")
        expect(file_name).to_end_with(".spl")

    it "parses representative hex values":
        step("Verify: parses representative hex values")
        expect(parse_hex_smoke("0x1234")).to_equal(0x1234)
        expect(parse_hex_smoke("ff")).to_equal(255)
