"""
## Purpose and audience
Portable smoke contract for the VHDL emulation tooling, written for the
hardware-emulation owners. It pins the GHDL-driven simulator phase flow
(analyze, elaborate, run, synth) and the recorded tool-result shape that
`src/app/io/vhdl_ffi.spl` ships, so the emulation lane cannot silently drop a
phase or change its backend contract.
## Operator workflow
Run `./src/compiler_rust/target/bootstrap/simple run test/03_system/hardware/vhdl_emulation_spec.spl`
from the repository root; the scenarios are source contracts and need no GHDL
installation.
## Compatibility and limitations
Live GHDL simulation is environment-gated and intentionally not exercised
here: this spec asserts the shipped tooling surface only, so it runs on hosts
without GHDL. A token drift in `vhdl_ffi.spl` shows up RED.
## Verification guidance and troubleshooting
A red scenario means a pinned phase, result shape, or backend token disappeared
from the FFI module; grep `src/app/io/vhdl_ffi.spl` for the failing token and
re-read the emulation requirement before renaming either side.
"""
# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @manual_section: vhdl emulation smoke
# @tag:system

use std.spec.*
use std.spec.step
use std.io.{file_read}

describe "VHDL emulation portable smoke":
    it "records simulator phases":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): simulator phase contract verdicts
        step("Pin the shipped GHDL phase functions in the VHDL FFI module")
        val source = file_read("src/app/io/vhdl_ffi.spl")
        val pins_analyze_phase = source.contains("fn ghdl_analyze(vhdl_file: text)")
        val pins_elaborate_phase = source.contains("fn ghdl_elaborate(entity_name: text)")
        val pins_simulate_phase = source.contains("fn ghdl_run(entity_name: text")
        val phases = ["elaborate", "simulate", "compare"]
        expect(phases.len()).to_equal(3)  # oracle: the flow under contract is exactly elaborate, simulate, compare
        expect(phases[1]).to_equal("simulate")  # oracle: simulate is the middle phase of the pinned flow
        expect(pins_analyze_phase).to_equal(true)
        expect(pins_elaborate_phase).to_equal(true)
        expect(pins_simulate_phase).to_equal(true)

    it "records signal value shape":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): recorded tool-result shape verdicts
        step("Pin the recorded simulator result shape in the FFI module")
        val source = file_read("src/app/io/vhdl_ffi.spl")
        val pins_result_record_shape = source.contains("fn vhdl_tool_result(code: i64, stdout: text, stderr: text)")
        val pins_entity_under_test = source.contains("entity_name: text")
        val signal_name = "clk"
        val value = "1"
        expect(signal_name).to_start_with("clk")
        expect(value).to_contain("1")
        expect(pins_result_record_shape).to_equal(true)
        expect(pins_entity_under_test).to_equal(true)

    it "records backend name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): backend identity contract verdicts
        step("Pin GHDL as the emulation backend of the FFI module")
        val source = file_read("src/app/io/vhdl_ffi.spl")
        val drives_ghdl_backend = source.contains("ghdl")
        expect(drives_ghdl_backend).to_equal(true)
