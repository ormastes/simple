"""
Real GHDL analysis, elaboration and simulation through the owned VHDL wrapper.
Requires GHDL on PATH on a POSIX host. A missing tool fails this explicit lane;
no constant-result or source-token check substitutes for simulator execution.
Each context is a private workspace shared across its three phases, including
native backend outputs. Source paths below stay relative to the caller's cwd.
"""
# @tag:system
# @cover src/lib/nogc_sync_mut/io/vhdl_sffi.spl 80%
use std.spec.*
use std.spec.step
use app.io.vhdl_ffi.{ghdl_available, ghdl_create_workspace,
    ghdl_analyze_in, ghdl_elaborate_in, ghdl_run_in,
    ghdl_analyze, ghdl_elaborate, ghdl_run, ghdl_close_default_workspace}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}

fn vhdl_test_workspace() -> text:
    val created = ghdl_create_workspace("/tmp")
    expect(created.is_ok()).to_equal(true)
    created.unwrap()

describe "VHDL emulation with owned GHDL workspaces":
    it "isolates the same entity in two work libraries and native output directories":
        step("Analyze, elaborate and simulate an inverter and a buffer in separate workspaces")
        expect(ghdl_available()).to_equal(true)
        val first = vhdl_test_workspace()
        val second = vhdl_test_workspace()
        expect(first == second).to_equal(false)
        expect(ghdl_analyze_in(first, "test/fixtures/vhdl/owned_workspace/inverter.vhd").success).to_equal(true)
        expect(ghdl_analyze_in(second, "test/fixtures/vhdl/owned_workspace/buffer.vhd").success).to_equal(true)
        expect(ghdl_elaborate_in(first, "simple_vhdl_probe").success).to_equal(true)
        expect(ghdl_elaborate_in(second, "simple_vhdl_probe").success).to_equal(true)
        val first_run = ghdl_run_in(first, "simple_vhdl_probe", Some("10ns"))
        expect(first_run.exit_code).to_equal(0)
        expect(first_run.stdout + first_run.stderr).to_contain("SIMPLE_GHDL_INVERTER_DONE")
        val second_run = ghdl_run_in(second, "simple_vhdl_probe", Some("10ns"))
        expect(second_run.exit_code).to_equal(0)
        expect(second_run.stdout + second_run.stderr).to_contain("SIMPLE_GHDL_BUFFER_DONE")
        expect(dir_remove_all(first)).to_equal(true)
        expect(dir_remove_all(second)).to_equal(true)

    it "propagates a real VHDL syntax rejection":
        step("Reject malformed source during analysis")
        expect(ghdl_available()).to_equal(true)
        val work = vhdl_test_workspace()
        val analysis = ghdl_analyze_in(work, "test/fixtures/vhdl/owned_workspace/syntax_error.vhd")
        expect(analysis.success).to_equal(false)
        expect(analysis.exit_code > 0).to_equal(true)
        expect((analysis.stdout + analysis.stderr).len() > 0).to_equal(true)
        expect(dir_remove_all(work)).to_equal(true)

    it "propagates a failed simulated signal assertion":
        step("Compile valid VHDL whose second signal expectation is deliberately wrong")
        expect(ghdl_available()).to_equal(true)
        val work = vhdl_test_workspace()
        expect(ghdl_analyze_in(work, "test/fixtures/vhdl/owned_workspace/wrong_expectation.vhd").success).to_equal(true)
        expect(ghdl_elaborate_in(work, "simple_vhdl_probe").success).to_equal(true)
        val simulation = ghdl_run_in(work, "simple_vhdl_probe", Some("10ns"))
        expect(simulation.success).to_equal(false)
        expect(simulation.exit_code > 0).to_equal(true)
        expect(simulation.stdout + simulation.stderr).to_contain("transition signal mismatch")
        expect((simulation.stdout + simulation.stderr).contains("UNREACHABLE_WRONG_EXPECTATION_DONE")).to_equal(false)
        expect(dir_remove_all(work)).to_equal(true)

    it "preserves the sequential compatibility workflow until explicit cleanup":
        step("The old analyze/elaborate/run API shares one private process-owned workspace")
        expect(ghdl_available()).to_equal(true)
        expect(ghdl_close_default_workspace()).to_equal(true)
        expect(ghdl_analyze("test/fixtures/vhdl/owned_workspace/inverter.vhd").success).to_equal(true)
        expect(ghdl_elaborate("simple_vhdl_probe").success).to_equal(true)
        val simulation = ghdl_run("simple_vhdl_probe", Some("10ns"))
        expect(simulation.exit_code).to_equal(0)
        expect(simulation.stdout + simulation.stderr).to_contain("SIMPLE_GHDL_INVERTER_DONE")
        expect(ghdl_close_default_workspace()).to_equal(true)
