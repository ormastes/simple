# @tag:system
#
# Portable smoke for VHDL emulation contracts.


# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/hardware/vhdl_emulation_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/vhdl_emulation_spec.md
# doc-path: doc/03_plan/sys_test/vhdl_emulation_spec.md
# doc-path: doc/04_architecture/vhdl_emulation_spec.md
# doc-path: doc/05_design/vhdl_emulation_spec_oracles.md
# @manual: primary

use std.spec.*
use std.spec.step

describe "VHDL emulation portable smoke":
    it "records simulator phases":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: records simulator phases")
        val phases = ["elaborate", "simulate", "compare"]
        expect(phases.len()).to_equal(3)
        expect(phases[1]).to_equal("simulate")

    it "records signal value shape":
        step("Verify: records signal value shape")
        val signal_name = "clk"
        val value = "1"
        expect(signal_name).to_equal("clk")
        expect(value).to_equal("1")

    it "records backend name":
        step("Verify: records backend name")
        val backend = "vhdl"
        expect(backend).to_equal("vhdl")
