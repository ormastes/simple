use std.spec.step
use std.spipe.*
use std.nogc_async_mut.sosix.{sosix_run_checked}

describe "Linux V4 unsupported strict admission [native host evidence]":
    """
    A V4 process owner rejects group or tree ownership and cgroup memory
    enforcement until an isolated provider can enforce them. Run on native
    Linux with a C compiler and timeout; other hosts cannot supply this evidence.
    """
    it "rejects unsupported policy combinations before acquiring the executable":
        # @req REQ-SOSIX-LINUX-V4-STRICT-ADMISSION-001
        # @capture(text): native V4 host selfcheck verdict
        step("Run the Linux V4 admission and lifecycle selfchecks")
        val result = sosix_run_checked("sh", ["scripts/check/check-process-v4-group-admission.shs"]).unwrap()
        step("Require the host admission matrix and lifecycle checks to pass")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("runtime_process_observation_v4_selfcheck: PASS")
