use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io_runtime.{env_get, process_run}

fn check_missing_group_broker(host: text):
    val runner = env_get("SIMPLE_BIN")
    expect(runner == "").to_equal(false)
    val fixture = "test/03_system/acceptance/fixtures/sosix_missing_group_broker/" + host + ".spl"
    val (out, err, code) = process_run(runner, [fixture])
    expect(code == 0).to_equal(false)
    expect(out + err).to_contain("assertion failed")
    expect(out + err).to_contain("SOSIX missing " + host + " grouped broker provider")
    expect((out + err).contains("SOSIX-MISSING-BROKER-RETURNED")).to_equal(false)

describe "Unimplemented SOSIX grouped broker development seams":
    """
    Missing grouped broker launchers retain the shared launcher signature so
    host owners can implement them independently. Calling one before its
    implementation must fail immediately and identify the missing host owner.
    These are explicit development seams, never installed by host composition.
    They do not qualify host execution, tree containment or memory enforcement.

    Set SIMPLE_BIN to the same admitted executable used to run this spec.
    Each case runs a real child fixture: a missing import, an ordinary Err
    return, or an accidental success cannot satisfy the diagnostic assertion.
    """

    it "fails immediately when the missing Darwin broker launcher is called":
        step("Call the Darwin placeholder in an isolated child")
        check_missing_group_broker("darwin")

    it "fails immediately when the missing FreeBSD broker launcher is called":
        step("Call the FreeBSD placeholder in an isolated child")
        check_missing_group_broker("freebsd")

    it "fails immediately when the missing illumos broker launcher is called":
        step("Call the illumos placeholder in an isolated child")
        check_missing_group_broker("illumos")
