use std.spec.step
use std.spipe.*
use std.nogc_async_mut.sosix.{sosix_run_checked}

describe "Linux group occupancy decoder [portable component evidence]":
    """
    As a process owner, I require complete, unambiguous occupancy evidence before
    treating a subtree as empty. This runs the production C decoder fixtures on
    the current C host. It does not execute Linux cgroups or qualify V4 Tree.
    Requires a C11 compiler and sh; Linux kernel admission is a separate gate.
    """
    it "rejects malformed and ambiguous records without changing the caller's evidence":
        # @req REQ-SOSIX-LINUX-GROUP-EVIDENCE-001
        # @capture(text): production decoder fixture verdict and exit status
        step("Compile and run production decoder fixtures including previously accepted malformed lines")
        val result = sosix_run_checked("sh", ["scripts/check/check-linux-cgroup-events-parser.shs"]).unwrap()
        step("Require every fixture to execute and no rejected observation to overwrite its output")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("27 checks, 0 failures")
