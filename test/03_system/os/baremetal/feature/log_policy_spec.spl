# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use os.baremetal.profile.log_policy.{BaremetalLogPolicy, baremetal_compile_log_allows, baremetal_runtime_log_allows, baremetal_log_policy_with_compile_level, baremetal_aop_function_calls_enabled, baremetal_aop_variable_assignments_enabled}

describe "baremetal log policy":
    # @manual scenario evidence
    it "defaults compile logging to debug and runtime logging to info":
        # @req REQ-SSPEC-SYSTEM
        step("defaults compile logging to debug and runtime logging to info")
        val policy = BaremetalLogPolicy.default_debug()
        expect(policy.compile_level).to_equal(1)
        expect(policy.runtime_level).to_equal(2)
        expect(baremetal_compile_log_allows(policy, 1)).to_equal(true)
        expect(baremetal_runtime_log_allows(policy, 1)).to_equal(false)
        expect(baremetal_runtime_log_allows(policy, 3)).to_equal(true)

    it "keeps AOP call and assignment logging independently switchable":
        # @req REQ-SSPEC-SYSTEM
        step("keeps AOP call and assignment logging independently switchable")
        val policy = BaremetalLogPolicy.with_aop(true, false)
        expect(baremetal_aop_function_calls_enabled(policy)).to_equal(true)
        expect(baremetal_aop_variable_assignments_enabled(policy)).to_equal(false)

    it "honors compile-time off for AOP logging":
        # @req REQ-SSPEC-SYSTEM
        step("honors compile-time off for AOP logging")
        val policy = baremetal_log_policy_with_compile_level(BaremetalLogPolicy.with_aop(true, true), 5)
        expect(baremetal_aop_function_calls_enabled(policy)).to_equal(false)
        expect(baremetal_aop_variable_assignments_enabled(policy)).to_equal(false)
