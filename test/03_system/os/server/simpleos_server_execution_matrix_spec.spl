# codex-system-test
# @req REQ-001 REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-009 REQ-010 REQ-011 REQ-012 NFR-001 NFR-002 NFR-003 NFR-004 NFR-005 NFR-006 NFR-007
# @evidence-display: links
"""# SimpleOS server execution matrix

Exercises the production evidence rows for ARM64 QEMU, physical UNO Q CPU,
physical UNO Q GPU, Linux CPU comparison, and Linux optional-GPU comparison.
Every live runner must return a provenance-bound
`SimpleOsServerExecutionReceiptV1`. Missing target runners fail explicitly;
source inspection, marker executables, hosted substitutes, and unavailable-row
skips receive no acceptance credit.

The bounded mounted database credential is input only. Its bytes are never a
receipt field and must be redacted from retained commands, transcripts, and logs.
"""

use std.spec.*
use test.system.simpleos_arm64_servers_qemu_helpers.{
    SimpleOsServerExecutionReceiptV1,
    run_arm_qemu_server_fixture
}

fn arm_qemu_server_fixture(mode: text) -> SimpleOsServerExecutionReceiptV1:
    run_arm_qemu_server_fixture(mode)

fn uno_q_server_fixture(mode: text) -> SimpleOsServerExecutionReceiptV1:
    fail("missing live uno_q_server_fixture: launch current filesystem server bytes on the physical UNO Q and retain identity, CPU/GPU selection, HTTP, database restart, submit, completion, and readback evidence in SimpleOsServerExecutionReceiptV1")

fn expect_http_file(receipt: SimpleOsServerExecutionReceiptV1) -> bool:
    (receipt.target_identity.starts_with("qemu-system-aarch64:virt:") and
        receipt.executable_sha256.len() == 64 and receipt.http_file_verified)

fn expect_db_reboot(receipt: SimpleOsServerExecutionReceiptV1) -> bool:
    receipt.image_sha256.len() == 64 and receipt.db_reboot_verified

fn expect_cpu_mode(receipt: SimpleOsServerExecutionReceiptV1) -> bool:
    ((receipt.mode == "qemu-arm64-cpu" or receipt.mode == "unoq-cpu") and
        not receipt.gpu_selected and not receipt.gpu_submit_completed and
        not receipt.device_readback_verified)

fn expect_gpu_receipt(receipt: SimpleOsServerExecutionReceiptV1) -> bool:
    fail("missing live expect_gpu_receipt: validate physical device identity, immutable input ownership, submit, completion or fence, device-origin readback, and deterministic parent commit")

use std.spec.step

describe "SimpleOS server execution matrix":
    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should filesystem-launch the ARM64 QEMU server and prove HTTP plus reboot persistence":
        # @req: REQ-OS-SERVER-EXECUTION-001
        # @req: REQ-001
        step("Verify: should filesystem-launch the ARM64 QEMU server and prove HTTP plus reboot persistence")
        step("Boot ARM QEMU server executable")
        val receipt = arm_qemu_server_fixture("qemu-arm64-cpu")
        expect(receipt.mode).to_equal("qemu-arm64-cpu")
        step("Serve a filesystem document over HTTP")
        expect(expect_http_file(receipt)).to_equal(true)
        step("Persist and reload a database value")
        expect(expect_db_reboot(receipt)).to_equal(true)
        expect(expect_cpu_mode(receipt)).to_equal(true)

    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should filesystem-launch the physical UNO Q server in forced CPU-only mode":
        # @req: REQ-OS-SERVER-EXECUTION-001
        step("Verify: should filesystem-launch the physical UNO Q server in forced CPU-only mode")
        step("Launch UNO Q server executable")
        val receipt = uno_q_server_fixture("unoq-cpu")
        expect(receipt.mode).to_equal("unoq-cpu")
        expect(expect_http_file(receipt)).to_equal(true)
        expect(expect_db_reboot(receipt)).to_equal(true)
        step("Verify UNO Q CPU-only path")
        expect(expect_cpu_mode(receipt)).to_equal(true)

    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should filesystem-launch the physical UNO Q server with verified GPU work":
        # @req: REQ-OS-SERVER-EXECUTION-001
        step("Verify: should filesystem-launch the physical UNO Q server with verified GPU work")
        step("Launch UNO Q server executable")
        val receipt = uno_q_server_fixture("unoq-gpu")
        expect(receipt.mode).to_equal("unoq-gpu")
        expect(expect_http_file(receipt)).to_equal(true)
        expect(expect_db_reboot(receipt)).to_equal(true)
        step("Verify UNO Q GPU-accelerated path")
        expect(expect_gpu_receipt(receipt)).to_equal(true)

    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should retain an equivalent Linux CPU comparison row":
        # @req: REQ-OS-SERVER-EXECUTION-001
        step("Verify: should retain an equivalent Linux CPU comparison row")
        step("Serve a filesystem document over HTTP")
        step("Persist and reload a database value")
        fail("missing live Linux CPU comparison helper: run equivalent Simple, nginx, PostgreSQL, and SQLite operations with fixed affinity, concurrency, durability, dataset, warmup, samples, p50, p95, throughput, and RSS controls")

    # @manual: show
    # @capture(exec)
    # @capture(log)
    # @capture(artifact)
    it "should retain an optional-GPU Linux comparison without moving mutable server state":
        # @req: REQ-OS-SERVER-EXECUTION-001
        step("Verify: should retain an optional-GPU Linux comparison without moving mutable server state")
        step("Serve a filesystem document over HTTP")
        step("Persist and reload a database value")
        fail("missing live Linux optional-GPU comparison helper: prove the exact immutable compute boundary, CUDA submit and validated result, parent-owned socket database and filesystem state, and absence of CUDA loading in the CPU-only row")

    # @manual: folded
    # @capture(log)
    it "should reject markers substitutions incomplete receipts and GPU fallback":
        # @req: REQ-OS-SERVER-EXECUTION-001
        step("Verify: should reject markers substitutions incomplete receipts and GPU fallback")
        step("Boot ARM QEMU server executable")
        fail("missing live deliberate-red receipt checker: reject marker apps, host or Linux substitution, stale or incomplete provenance, software-GPU fallback, unowned mutable state, and receiptless results")
