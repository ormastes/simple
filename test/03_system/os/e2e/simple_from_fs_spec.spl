# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

## E2E gate: filesystem-installed Simple interpreter and native compiler.
##
## THIS SPEC IS EXPECTED TO FAIL until the following tracks land:
##   - Track F  : kernel links with FAT32 + ELF loader + userspace exec
##   - Track B''': SMF format baked onto disk image at /usr/bin/simple
##                 (or /SIMPLSTC.SMF fallback at FAT32 root)
##
## When those tracks land, set SIMPLEOS_SIMPLE_FS_E2E=1 and supply a
## built disk image (SIMPLEOS_DISK_IMAGE or default build/os/simpleos_disk.img)
## to obtain end-to-end confirmation.
##
## Marker contract (for the bake/init agent that writes the disk init script):
##   After kernel boots, the init script MUST run, in order:
##     1. simple --version        → emit "Simple " followed by a version digit on COM1
##     2. simple /tmp/hello.spl   → emit "ok" on COM1
##   The init script pre-seeds /tmp/hello.spl with:
##     fn main(): print("ok\n")
##   No wrapper tags are needed; the spec matches natural substrings.
##
## Run (gated, env-driven):
##   bin/simple test test/system/os/e2e/simple_from_fs_spec.spl
##   SIMPLEOS_SIMPLE_FS_E2E=1 bin/simple test test/system/os/e2e/simple_from_fs_spec.spl
##
## @platform: baremetal(x86_64)
## @tag: os,qemu,e2e,simple-from-fs

use std.spec
use os.qemu_runner.{boot_disk_image_serial}

val MARKER_STARTED = "SIMPLEOS_SMOKE_INIT_STARTED"
val MARKER_VERSION = "SIMPLE_FROM_FS_VERSION_OK"
val MARKER_INTERPRETER = "TRIVIAL_INTERPRETER_OK"
val MARKER_NATIVE = "TRIVIAL_SELFHOST_OK"
val MARKER_DONE = "SIMPLEOS_SMOKE_INIT_DONE"
val VERSION_OUTPUT = "Simple v1.0.0-RC"
val HELLO_OUTPUT = "hello from self-host"

## Cached serial capture — QEMU boots once, all it-blocks share the result.
var _serial_cache: text = ""
var _boot_attempted: bool = false

fn _gate() -> text:
    """Return SIMPLEOS_SIMPLE_FS_E2E env var, or empty string if unset."""
    val v = rt_env_get("SIMPLEOS_SIMPLE_FS_E2E")
    if v == nil:
        ""
    else:
        v

fn _disk_image_path() -> text:
    val override = env_get("SIMPLEOS_DISK_IMAGE")
    if override == "":
        return "build/os/simpleos_disk.img"
    override

fn _marker_line_index(serial: text, marker: text) -> i64:
    var line_index: i64 = 0
    val normalized = serial.replace("\r", "")
    val lines = normalized.split("\n")
    for line in lines:
        if line == marker:
            return line_index
        line_index = line_index + 1
    -1

fn _line_index_after(serial: text, expected: text, after: i64) -> i64:
    var line_index: i64 = 0
    val normalized = serial.replace("\r", "")
    val lines = normalized.split("\n")
    for line in lines:
        if line_index > after and line == expected:
            return line_index
        line_index = line_index + 1
    -1

fn ensure_serial() -> text:
    """Boot QEMU once and cache serial output; subsequent calls return cache."""
    if _boot_attempted:
        return _serial_cache
    _boot_attempted = true
    val image = _disk_image_path()
    if not rt_file_exists(image):
        _serial_cache = "[boot-error: disk image not found: " + image + "]"
        return _serial_cache
    ## 240 s watchdog — matches @qemu per-test timeout (see commit 5687e84287).
    val (stdout, stderr, _exit) = boot_disk_image_serial(image, 240000)
    _serial_cache = stdout + stderr
    _serial_cache

describe "E2E: Simple compiler runs from FAT32 on SimpleOS":
    """
    Two-step end-to-end gate:
      step 1 — `simple --version` emits a version banner on COM1.
      step 2 — `simple /tmp/hello.spl` prints "ok" to COM1.

    Both steps are gated on SIMPLEOS_SIMPLE_FS_E2E=1 and a built disk image.
    All it-blocks skip cleanly (return a skip-reason string) when the gate
    env var is absent — this is intentional until Tracks F and B''' land.
    """

    it "should require an explicit live gate and disk image":
        # @req REQ-SSPEC-SYSTEM
        step("should require an explicit live gate and disk image")
        step("Require SIMPLEOS_SIMPLE_FS_E2E=1")
        expect(_gate()).to_equal("1")
        step("Require the selected SimpleOS disk image")
        expect(file_exists(_disk_image_path())).to_equal(true)

    it "should run the filesystem Simple version command":
        # @req REQ-SSPEC-SYSTEM
        step("should run the filesystem Simple version command")
        step("Boot the selected SimpleOS disk image once")
        val serial = ensure_serial()
        serial.to_contain("Simple ")

    it "should interpret before native-building and running the same source":
        # @req REQ-SSPEC-SYSTEM
        step("should interpret before native-building and running the same source")
        step("Reuse the live SimpleOS serial capture")
        val serial = ensure_serial()
        step("Observe the exact interpreter success marker")
        val interpreted_output_line = _line_index_after(serial, HELLO_OUTPUT, -1)
        expect(interpreted_output_line).to_be_greater_than(-1)
        val interpreter_line = _marker_line_index(serial, MARKER_INTERPRETER)
        expect(interpreter_line).to_be_greater_than(interpreted_output_line)
        step("Observe the exact native compile-and-run success marker")
        val native_output_line = _line_index_after(serial, HELLO_OUTPUT, interpreter_line)
        expect(native_output_line).to_be_greater_than(interpreter_line)
        val native_line = _marker_line_index(serial, MARKER_NATIVE)
        expect(native_line).to_be_greater_than(native_output_line)
        step("Observe the exact smoke-init completion marker")
        expect(_marker_line_index(serial, MARKER_DONE)).to_be_greater_than(native_line)
