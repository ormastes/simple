# codex-system-test
# @tag:system
# @evidence-display: links

"""# Toolchains, userland, and server protocols

Defines fail-closed live acceptance for target-native Simple and LLVM/C++, expanded userland, bounded lifecycle, HTTP/DB/RESP/SSH, and security policy.

This is an explicit BLOCKED traceability spec. Each checker validates a
structurally complete blocked candidate through the production capability-ledger
owner and reports its executable owner, exact expected receipt, and resume
command. A row cannot pass until that receipt is produced and admitted.
"""

use std.spec.*
use test.helpers.simpleos_complete_os_hardening_steps.{
    check_simpleos_server_protocols,
    check_simpleos_toolchain_fs,
    step_compile_and_run_hello,
    step_launch_from_filesystem,
    step_probe_protocol
}

use std.spec.step

describe "REQ-009: target-native Simple roles":
    # @capture(artifact)
    it "should accept complete live evidence for target-native Simple roles":
        # @req: REQ-OS-COMPLETE-OS-001 REQ-009 REQ-010 REQ-011 REQ-012 REQ-013 REQ-014 REQ-015 REQ-016
        # @req: REQ-OS-COMPLETE-OS-001
        # @req: REQ-009
        step("Verify: should accept complete live evidence for target-native Simple roles")
        step_compile_and_run_hello()
        check_simpleos_toolchain_fs("REQ-009", "happy")

    # @manual: folded
    it "should preserve the selected boundary for target-native Simple roles":
        # @req: REQ-OS-COMPLETE-OS-001
        step("Verify: should preserve the selected boundary for target-native Simple roles")
        step_compile_and_run_hello()
        check_simpleos_toolchain_fs("REQ-009", "boundary")

    # @manual: folded
    it "should reject missing stale substituted or invalid evidence for target-native Simple roles":
        # @req: REQ-OS-COMPLETE-OS-001
        step("Verify: should reject missing stale substituted or invalid evidence for target-native Simple roles")
        step_compile_and_run_hello()
        check_simpleos_toolchain_fs("REQ-009", "rejection")

