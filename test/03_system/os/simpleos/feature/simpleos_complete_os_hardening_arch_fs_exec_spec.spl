# codex-system-test
# @tag:system
# @evidence-display: links
# @req REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 NFR-006 NFR-011

"""# Architecture, filesystem, and authenticated execution

Defines fail-closed live acceptance for three architectures, FAT32/DBFS/NVFS, authenticated open-handle loading, and durability.

This is an explicit BLOCKED traceability spec. Each checker validates a
structurally complete blocked candidate through the production capability-ledger
owner and reports its executable owner, exact expected receipt, and resume
command. A row cannot pass until that receipt is produced and admitted.
"""

use std.spec.*
use test.helpers.simpleos_complete_os_hardening_steps.{
    check_simpleos_capability_matrix,
    check_simpleos_filesystem_conformance,
    check_simpleos_filesystem_exec,
    step_boot_target,
    step_launch_from_filesystem,
    step_mount_filesystem
}

describe "REQ-002: three-architecture system execution":
    # @capture(artifact)
    it "should accept complete live evidence for three-architecture system execution":
        step_boot_target()
        check_simpleos_capability_matrix("REQ-002", "happy")

    # @manual: folded
    it "should preserve the selected boundary for three-architecture system execution":
        step_boot_target()
        check_simpleos_capability_matrix("REQ-002", "boundary")

    # @manual: folded
    it "should reject missing stale substituted or invalid evidence for three-architecture system execution":
        step_boot_target()
        check_simpleos_capability_matrix("REQ-002", "rejection")

describe "REQ-003: shared filesystem contract":
    # @capture(artifact)
    it "should accept complete live evidence for shared filesystem contract":
        step_mount_filesystem()
        check_simpleos_filesystem_conformance("REQ-003", "happy")

    # @manual: folded
    it "should preserve the selected boundary for shared filesystem contract":
        step_mount_filesystem()
