# TLS 1.3 default peer verification — security oracles.
#
# This spec exists because the default TLS client used to verify NOTHING:
# `tls13_default_client_config()` shipped an empty `root_store` and the handshake
# ran chain (and, later, hostname) verification only `if root_store.len() > 0`.
# Every assertion below is an absolute oracle on the new fail-closed default; a
# green run here is the evidence that the default client refuses a MITM.
#
# Fixtures are real Ed25519 X.509 certificates generated by
# `build/tlsdef_fixtures/mk.sh` (openssl `ca` with pinned -startdate/-enddate):
#
#   root_ca      CN=TLSDEF Test Root,  self-signed, CA:TRUE
#   rogue_ca     CN=TLSDEF Rogue Root, self-signed, CA:TRUE  (NOT in the store)
#   leaf_good    CN/SAN good.example.com, issued by root_ca,  2020-01-01..2040-01-01
#   leaf_expired CN/SAN good.example.com, issued by root_ca,  2020-01-01..2021-01-01
#   leaf_future  CN/SAN good.example.com, issued by root_ca,  2090-01-01..2091-01-01
#   rogue_leaf   CN/SAN good.example.com, issued by rogue_ca, 2020-01-01..2040-01-01
#
# leaf_good/leaf_expired use UTCTime; leaf_future uses GeneralizedTime (year >=
# 2050), so both RFC 5280 encodings are exercised on real certificates.
#
# Time is PINNED (`NOW`), never read from the clock, so these oracles cannot rot.
#
# Deliberate-red calibration (each mutant applied ALONE, then reverted with a
# green re-verify) — see .spipe/tls_default_verification/state.md:
#   1. peer_policy.spl: empty root_store returns Ok instead of Err
#      -> exactly 4 reds (all four empty-store/default-config assertions).
#   2. validity.spl: the `now > not_after` branch disabled
#      -> exactly 4 reds (all four expiry assertions). Nothing else moved.

"""
## Purpose and audience
Purpose: decodes notBefore/notAfter to the exact epoch for both UTCTime and GeneralizedTime
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-OS-OsTlsDefaVeri-001

use std.spipe.*
use os.tls13.cert_verify.*
use os.tls13.downgrade.*
use os.tls13.tls13.{tls13_default_client_config, Tls13ClientConfig}

val _ASCII_PRINTABLE: text = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
val LEAF_GOOD_HEX = ""
val LEAF_EXPIRED_HEX = ""
val LEAF_FUTURE_HEX = ""
val ROGUE_LEAF_HEX = ""
val ROOT_CA_HEX = ""
val ROGUE_CA_HEX = ""

fn _hex_digit(c: text) -> i64:
    """Hex nibble via table lookup — NOT an if-chain.

    The `if c == "0": return 0 ... if c == "f": return 15` form used by the older
    TLS cert specs decodes every 'f' as 'e' on bin/simple as of 2026-07-28 (the
    last arm of a long single-line if-chain yields the PREVIOUS arm's value).
    See .spipe/tls_assessment/state.md §3(a). Fixture integrity is asserted
    below rather than assumed.
    """
    var i: i64 = 0
    while i < 16:
        if _HEX_DIGITS[i:i + 1] == c:
            return i
        i = i + 1
    -1

fn hex_to_bytes(s: text) -> [u8]:
    if (s.len() % 2) != 0:
        return []
    var out: [u8] = []
    var i: u64 = 0
    while i < s.len():
        val hi = _hex_digit(s[i])
        val lo = _hex_digit(s[i + 1])
        if hi < 0 or lo < 0:
            return []
        out.push((hi * 16 + lo).to_u8())
        i = i + 2
    out

fn is_ok(result: CertVerifyResult) -> bool:
    match result:
        CertVerifyResult.Ok:
            true
        CertVerifyResult.Err(msg):
            false

fn err_text(result: CertVerifyResult) -> text:
    match result:
        CertVerifyResult.Ok:
            ""
        CertVerifyResult.Err(msg):
            msg

fn bytes_of(hexes: text) -> [u8]:
    hex_to_bytes(hexes)

# Pinned "now": 2023-11-14T22:13:20Z. Inside leaf_good (2020-2040), after
# leaf_expired's notAfter (2021), before leaf_future's notBefore (2090).
val NOW: i64 = 1700000000
val EPOCH_2020: i64 = 1577836800
val EPOCH_2040: i64 = 2208988800
val EPOCH_2021: i64 = 1609459200
val EPOCH_2090: i64 = 3786912000
val EPOCH_2091: i64 = 3818448000

fn leaf_good() -> [u8]: hex_to_bytes(LEAF_GOOD_HEX)
fn leaf_expired() -> [u8]: hex_to_bytes(LEAF_EXPIRED_HEX)
fn leaf_future() -> [u8]: hex_to_bytes(LEAF_FUTURE_HEX)
fn rogue_leaf() -> [u8]: hex_to_bytes(ROGUE_LEAF_HEX)
fn root_ca() -> [u8]: hex_to_bytes(ROOT_CA_HEX)
fn rogue_ca() -> [u8]: hex_to_bytes(ROGUE_CA_HEX)

fn tb_ascii(s: text) -> [u8]:
    var out: [u8] = []
    val chars = s.split("")
    for ch in chars:
        if ch != "":
            var idx: i64 = 0
            var found = false
            while idx < _ASCII_PRINTABLE.len() and not found:
                if _ASCII_PRINTABLE[idx:idx + 1] == ch:
                    out.push((idx + 32).to_u8())
                    found = true
                idx = idx + 1
    out

fn utc_time_bytes(s: text) -> [u8]: tb_ascii(s)

fn sentinel_random(last: i64) -> [u8]:
    """32-byte ServerHello.random whose trailing 8 bytes are DOWNGRD || last."""
    var out: [u8] = []
    var i: i64 = 0
    while i < 24:
        out.push(0xAAu8)
        i = i + 1
    val d: [i64] = [0x44, 0x4F, 0x57, 0x4E, 0x47, 0x52, 0x44]
    var j: i64 = 0
    while j < 7:
        out.push(d[j.to_u64()].to_u8())
        j = j + 1
    out.push(last.to_u8())
    out

fn clean_random() -> [u8]:
    var out: [u8] = []
    var i: i64 = 0
    while i < 32:
        out.push(0x5Au8)
        i = i + 1
    out

fn is_sentinel_none(s: Tls13DowngradeSentinel) -> bool:
    match s:
        Tls13DowngradeSentinel.None: true
        Tls13DowngradeSentinel.Tls12: false
        Tls13DowngradeSentinel.Tls11OrBelow: false

fn is_sentinel_tls12(s: Tls13DowngradeSentinel) -> bool:
    match s:
        Tls13DowngradeSentinel.None: false
        Tls13DowngradeSentinel.Tls12: true
        Tls13DowngradeSentinel.Tls11OrBelow: false

fn is_sentinel_low(s: Tls13DowngradeSentinel) -> bool:
    match s:
        Tls13DowngradeSentinel.None: false
        Tls13DowngradeSentinel.Tls12: false
        Tls13DowngradeSentinel.Tls11OrBelow: true

fn good_chain() -> [[u8]]: [leaf_good()]
fn rogue_chain() -> [[u8]]: [rogue_leaf()]
fn store() -> [[u8]]: [root_ca()]
fn no_store() -> [[u8]]: []

use std.spec.step
describe "certificate validity period (RFC 5280 4.1.2.5)":
    it "decodes notBefore/notAfter to the exact epoch for both UTCTime and GeneralizedTime":
        step("Verify: decodes notBefore/notAfter to the exact epoch for both UTCTime and GeneralizedTime")
        # @req: REQ-OS-OsTlsDefaVeri-001
        # Fixture-integrity guard first: the neighbouring cert specs' `_hex_digit`
        # if-chain decodes 'f' as 'e' on this binary, so a green there proves
        # nothing. This spec's table lookup is asserted directly.
        expect(_hex_digit("f")).to_equal(15)  # oracle: value fixed by the spec contract
        val vg = parse_cert_validity(leaf_good())
        expect(vg.ok).to_equal(true)
        expect(vg.not_before).to_equal(EPOCH_2020)
        expect(vg.not_after).to_equal(EPOCH_2040)
        val vf = parse_cert_validity(leaf_future())
        expect(vf.ok).to_equal(true)
        expect(vf.not_before).to_equal(EPOCH_2090)
        expect(vf.not_after).to_equal(EPOCH_2091)
        expect(parse_cert_validity(leaf_expired()).not_after).to_equal(EPOCH_2021)

    it "accepts a certificate inside its window and REFUSES expired / not-yet-valid ones":
        step("Verify: accepts a certificate inside its window and REFUSES expired / not-yet-valid ones")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_cert_validity(leaf_good(), NOW))).to_equal(true)
        expect(is_ok(verify_cert_validity(leaf_expired(), NOW))).to_equal(false)
        expect(is_ok(verify_cert_validity(leaf_future(), NOW))).to_equal(false)
        expect(err_text(verify_cert_validity(leaf_expired(), NOW)).contains("expired")).to_equal(true)
        expect(err_text(verify_cert_validity(leaf_future(), NOW)).contains("not yet valid")).to_equal(true)

    it "fails closed with no clock, no certificate, or a truncated certificate":
        step("Verify: fails closed with no clock, no certificate, or a truncated certificate")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_cert_validity(leaf_good(), -1))).to_equal(false)
        expect(is_ok(verify_cert_validity([], NOW))).to_equal(false)
        expect(is_ok(verify_cert_validity(bytes_of("3082015330820105a0"), NOW))).to_equal(false)

    it "checks every certificate in the presented chain, not just the leaf":
        step("Verify: checks every certificate in the presented chain, not just the leaf")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_chain_validity([leaf_good()], NOW))).to_equal(true)
        expect(is_ok(verify_chain_validity([leaf_good(), leaf_expired()], NOW))).to_equal(false)
        expect(is_ok(verify_chain_validity([], NOW))).to_equal(false)

describe "ASN.1 Time decoding fails closed":
    it "accepts only the RFC 5280 Zulu forms":
        step("Verify: accepts only the RFC 5280 Zulu forms")
        # @req: REQ-OS-OsTlsDefaVeri-001
        val t1 = parse_der_time(0x17u8, utc_time_bytes("200101000000Z"))
        expect(t1.ok).to_equal(true)
        expect(t1.unix_seconds).to_equal(EPOCH_2020)
        val t2 = parse_der_time(0x18u8, utc_time_bytes("20900101000000Z"))
        expect(t2.ok).to_equal(true)
        expect(t2.unix_seconds).to_equal(EPOCH_2090)
        expect(parse_der_time(0x17u8, utc_time_bytes("2001010000000")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("200101000000+0100")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("2001010000Z")).ok).to_equal(false)
        expect(parse_der_time(0x18u8, utc_time_bytes("20900101000000.5Z")).ok).to_equal(false)
        expect(parse_der_time(0x16u8, utc_time_bytes("200101000000Z")).ok).to_equal(false)

    it "rejects out-of-range and non-numeric calendar fields":
        step("Verify: rejects out-of-range and non-numeric calendar fields")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(parse_der_time(0x17u8, utc_time_bytes("2001x1000000Z")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("201301000000Z")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("200100000000Z")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("200230000000Z")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("200229000000Z")).ok).to_equal(true)
        expect(parse_der_time(0x17u8, utc_time_bytes("210229000000Z")).ok).to_equal(false)
        expect(parse_der_time(0x17u8, utc_time_bytes("200101240000Z")).ok).to_equal(false)

    it "applies the RFC 5280 two-digit-year window":
        step("Verify: applies the RFC 5280 two-digit-year window")
        # @req: REQ-OS-OsTlsDefaVeri-001
        val t49 = parse_der_time(0x17u8, utc_time_bytes("490101000000Z"))
        val t50 = parse_der_time(0x17u8, utc_time_bytes("500101000000Z"))
        expect(t49.ok).to_equal(true)
        expect(t49.unix_seconds > EPOCH_2040).to_equal(true)
        expect(t50.ok).to_equal(true)
        expect(t50.unix_seconds < EPOCH_2020).to_equal(true)

describe "peer verification policy — the security default":
    it "ACCEPTS a valid chain to a supplied trust anchor":
        step("Verify: ACCEPTS a valid chain to a supplied trust anchor")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_peer_certificate(good_chain(), store(), "good.example.com", NOW, false))).to_equal(true)

    it "REFUSES a chain that does not reach a trust anchor":
        step("Verify: REFUSES a chain that does not reach a trust anchor")
        # @req: REQ-OS-OsTlsDefaVeri-001
        val r = verify_peer_certificate(rogue_chain(), store(), "good.example.com", NOW, false)
        expect(is_ok(r)).to_equal(false)
        expect(err_text(r).contains("trust anchor")).to_equal(true)

    it "treats an EMPTY root store as an ERROR, never as a silent bypass":
        step("Verify: treats an EMPTY root store as an ERROR, never as a silent bypass")
        # @req: REQ-OS-OsTlsDefaVeri-001
        val r = verify_peer_certificate(good_chain(), no_store(), "good.example.com", NOW, false)
        expect(is_ok(r)).to_equal(false)
        expect(err_text(r).contains("root_store is empty")).to_equal(true)
        expect(err_text(r).contains("insecure_disable_certificate_verification")).to_equal(true)

    it "REFUSES a hostname mismatch even when the chain is fully trusted":
        step("Verify: REFUSES a hostname mismatch even when the chain is fully trusted")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_peer_certificate(good_chain(), store(), "evil.example.com", NOW, false))).to_equal(false)
        expect(is_ok(verify_peer_certificate(good_chain(), store(), "", NOW, false))).to_equal(false)

    it "REFUSES expired and not-yet-valid leaves even with a good anchor":
        step("Verify: REFUSES expired and not-yet-valid leaves even with a good anchor")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_peer_certificate([leaf_expired()], store(), "good.example.com", NOW, false))).to_equal(false)
        expect(is_ok(verify_peer_certificate([leaf_future()], store(), "good.example.com", NOW, false))).to_equal(false)

    it "REFUSES an empty chain and a missing clock":
        step("Verify: REFUSES an empty chain and a missing clock")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_peer_certificate([], store(), "good.example.com", NOW, false))).to_equal(false)
        expect(is_ok(verify_peer_certificate(good_chain(), store(), "good.example.com", -1, false))).to_equal(false)

describe "the insecure opt-out is explicit and load-bearing":
    it "accepts anything ONLY when the flag is set":
        step("Verify: accepts anything ONLY when the flag is set")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_ok(verify_peer_certificate(rogue_chain(), no_store(), "good.example.com", NOW, true))).to_equal(true)
        expect(is_ok(verify_peer_certificate([leaf_expired()], no_store(), "anything", NOW, true))).to_equal(true)
        # Same inputs, flag not set -> refused. This pair is the whole design.
        expect(is_ok(verify_peer_certificate(rogue_chain(), no_store(), "good.example.com", NOW, false))).to_equal(false)
        expect(is_ok(verify_peer_certificate([leaf_expired()], no_store(), "anything", NOW, false))).to_equal(false)

describe "tls13_default_client_config is a VERIFYING config":
    it "has verification enabled and reads the system clock":
        step("Verify: has verification enabled and reads the system clock")
        # @req: REQ-OS-OsTlsDefaVeri-001
        val cfg = tls13_default_client_config()
        expect(cfg.insecure_disable_certificate_verification).to_equal(false)
        expect(cfg.verify_time_unix).to_equal(-1)  # oracle: value fixed by the spec contract

    it "REFUSES a real chain because it ships no trust anchors":
        step("Verify: REFUSES a real chain because it ships no trust anchors")
        # @req: REQ-OS-OsTlsDefaVeri-001
        # The regression this lane exists to prevent: with the old gate this
        # returned Ok and the client connected to anyone.
        val cfg = tls13_default_client_config()
        expect(cfg.root_store.len()).to_equal(0)  # oracle: value fixed by the spec contract
        val r = verify_peer_certificate(good_chain(), cfg.root_store, "good.example.com", NOW,
                                        cfg.insecure_disable_certificate_verification)
        expect(is_ok(r)).to_equal(false)

describe "RFC 8446 4.1.3 downgrade sentinel":
    it "classifies both defined sentinels and nothing else":
        step("Verify: classifies both defined sentinels and nothing else")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(is_sentinel_tls12(tls13_downgrade_sentinel(sentinel_random(1)))).to_equal(true)
        expect(is_sentinel_low(tls13_downgrade_sentinel(sentinel_random(0)))).to_equal(true)
        expect(is_sentinel_none(tls13_downgrade_sentinel(sentinel_random(2)))).to_equal(true)
        expect(is_sentinel_none(tls13_downgrade_sentinel(clean_random()))).to_equal(true)
        expect(is_sentinel_none(tls13_downgrade_sentinel([]))).to_equal(true)

    it "produces an abort reason for a sentinel and none for a clean random":
        step("Verify: produces an abort reason for a sentinel and none for a clean random")
        # @req: REQ-OS-OsTlsDefaVeri-001
        expect(tls13_downgrade_reason(sentinel_random(1)) != "").to_equal(true)
        expect(tls13_downgrade_reason(sentinel_random(0)) != "").to_equal(true)
        expect(tls13_downgrade_reason(clean_random())).to_equal("")
