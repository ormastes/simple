# @req: REQ-OS-PHYSICAL-BOARD-001


# codex-system-test
# @req REQ-018 REQ-019
# @evidence-display: links
"""# SimpleOS Physical Board Render Evidence

Defines the portable board qualification record and prevents QEMU, static
catalog, stale firmware, or incomplete transcripts from becoming board PASS.
"""
use std.spec.*
use common.renderdoc.simpleos_render_target_evidence.{
    simpleos_render_target_status,
    validate_simpleos_render_target_evidence
}
use test.helpers.simpleos_render_evidence_fixture.{
    SIMPLEOS_EVIDENCE_HASH,
    simpleos_target_evidence
}

fn require_live_physical_board_evidence():
    expect("blocked: physical board identity, flashed firmware, transcript, and capture artifacts are required").to_equal("available")

use std.spec.step

describe "SimpleOS physical-board rendering":
    # @capture(log)
    # @capture(artifact)
    it "should correlate board identity firmware boot receipt and exact capture":
        # @req: REQ-OS-PHYSICAL-BOARD-001
        # @req: REQ-018
        step("Verify: should correlate board identity firmware boot receipt and exact capture")
        step("Prepare a real board and flashed SimpleOS image")
        step("Boot and capture the guest render receipt")
        step("Capture the matching physical display or framebuffer")
        step("Verify exact pixels and transcript identity")
        require_live_physical_board_evidence()
    # @manual: folded
    it "should reject a static board catalog entry without a live boot":
        # @req: REQ-OS-PHYSICAL-BOARD-001
        step("Verify: should reject a static board catalog entry without a live boot")
        step("Submit source-present catalog metadata")
        val evidence = simpleos_target_evidence(
            "physical-board", "aarch64", "", "", "boot-1", "frame-1",
            SIMPLEOS_EVIDENCE_HASH, 0)
        expect(validate_simpleos_render_target_evidence(evidence).code).to_equal(
            "missing-board-identity")
    # @manual: folded
    it "should reject stale firmware and mismatched capture identity":
        # @req: REQ-OS-PHYSICAL-BOARD-001
        step("Verify: should reject stale firmware and mismatched capture identity")
        step("Pair a board transcript with another firmware or frame")
        val evidence = simpleos_target_evidence(
            "physical-board", "aarch64", "kv260-1", SIMPLEOS_EVIDENCE_HASH,
            "boot-1", "frame-2", SIMPLEOS_EVIDENCE_HASH, 0)
        expect(validate_simpleos_render_target_evidence(evidence).code).to_equal(
            "frame-correlation-mismatch")
    # @manual: folded
    it "should keep QEMU evidence classified as QEMU verified":
        # @req: REQ-OS-PHYSICAL-BOARD-001
        step("Verify: should keep QEMU evidence classified as QEMU verified")
        step("Submit complete QEMU evidence without a physical board")
        val evidence = simpleos_target_evidence(
            "qemu", "aarch64", "", "", "boot-1", "frame-1",
            SIMPLEOS_EVIDENCE_HASH, 0)
        expect(simpleos_render_target_status(evidence)).to_equal("qemu-verified")
