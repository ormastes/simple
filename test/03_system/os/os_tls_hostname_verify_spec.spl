"""
## Purpose and audience
Purpose: extracts exactly the fixture's dNSName entries, ASCII-folded, IP SAN excluded
Audience: compiler and tooling engineers who maintain this spec

# TLS Hostname (Identity) Verification Specification

Exercises `os.tls13.cert_verify.verify_hostname` / `extract_san_dns_names` /
`dns_name_matches` — the RFC 6125 check that a chain-valid certificate was
actually issued for the host we asked for.

Fixtures are real openssl-generated X.509 certificates embedded as DER hex:
- SAN_LEAF_DER_HEX: CN="Simple SAN Leaf", SAN = DNS:example.com,
  DNS:*.wild.example.com, DNS:UPPER.Example.NET, IP:192.0.2.1
- NOSAN_LEAF_DER_HEX: CN="nosan.example.com", NO subjectAltName at all

Oracles are absolute: the exact SAN set of the fixture is known, so the expected
name list is written out literally rather than recomputed from the parser.

tag: slow, system, tls, crypto, security
"""

# @req: REQ-OS-OsTlsHostVeri-001

use std.spipe.*
use os.tls13.cert_verify.{
    verify_hostname, extract_san_dns_names, dns_name_matches, CertVerifyResult
}

val _SPEC_ASCII_PRINTABLE: text = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

val _HEX_DIGITS: text = "0123456789abcdef"

fn _hex_digit(c: text) -> i64:
    """Hex nibble via table lookup.

    Deliberately NOT the `if c == "0": return 0 ... if c == "f": return 15`
    if-chain used by the neighbouring cert specs: on bin/simple as of
    2026-07-28 the LAST arm of that chain yields the previous arm's value, so
    `_hex_digit("f")` returns 14 and every 'f' nibble in a DER fixture decodes
    as 'e'. Filed in .spipe/tls_assessment/state.md.
    """
    var i: i64 = 0
    while i < 16:
        if _HEX_DIGITS[i:i + 1] == c:
            return i
        i = i + 1
    -1

fn hex_to_bytes(s: text) -> [u8]:
    if (s.len() % 2) != 0:
        return []
    var out: [u8] = []
    var i: u64 = 0
    while i < s.len():
        val hi = _hex_digit(s[i])
        val lo = _hex_digit(s[i + 1])
        if hi < 0 or lo < 0:
            return []
        out.push((hi * 16 + lo).to_u8())
        i = i + 2
    out

fn tb(s: text) -> [u8]:
    """Printable-ASCII text to raw bytes (spec-local, no case folding)."""
    var out: [u8] = []
    val chars = s.split("")
    for ch in chars:
        if ch != "":
            var idx: i64 = 0
            var found = false
            while idx < _SPEC_ASCII_PRINTABLE.len() and not found:
                if _SPEC_ASCII_PRINTABLE[idx:idx + 1] == ch:
                    out.push((idx + 32).to_u8())
                    found = true
                idx = idx + 1
    out

fn same_bytes(a: [u8], b: [u8]) -> bool:
    if a.len() != b.len():
        return false
    var i: u64 = 0
    var eq = true
    while i < a.len():
        if a[i] != b[i]:
            eq = false
        i = i + 1
    eq

fn name_at_is(names: [[u8]], idx: u64, expected: text) -> bool:
    """True when `names[idx]` is exactly `expected` (absolute positional oracle)."""
    if idx >= names.len():
        return false
    same_bytes(names[idx], tb(expected))

fn is_ok(result: CertVerifyResult) -> bool:
    match result:
        CertVerifyResult.Ok:
            true
        CertVerifyResult.Err(msg):
            false

fn err_text(result: CertVerifyResult) -> text:
    match result:
        CertVerifyResult.Ok:
            ""
        CertVerifyResult.Err(msg):
            msg

# Real cert: CN="Simple SAN Leaf",
# SAN = DNS:example.com, DNS:*.wild.example.com, DNS:UPPER.Example.NET, IP:192.0.2.1
val SAN_LEAF_DER_HEX = ""

# Real cert: CN="nosan.example.com", NO subjectAltName extension.
val NOSAN_LEAF_DER_HEX = ""

use std.spec.step
describe "extract_san_dns_names":
    it "extracts exactly the fixture's dNSName entries, ASCII-folded, IP SAN excluded":
        step("Verify: extracts exactly the fixture's dNSName entries, ASCII-folded, IP SAN excluded")
        # @req: REQ-OS-OsTlsHostVeri-001
        val cert = hex_to_bytes(SAN_LEAF_DER_HEX)
        expect(cert.len()).to_equal(864)  # oracle: value fixed by the spec contract
        val names = extract_san_dns_names(cert)
        # Absolute oracle: the fixture's SAN is known literally. The IP entry
        # (192.0.2.1) must NOT appear, and UPPER.Example.NET must be folded.
        expect(names.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(name_at_is(names, 0, "example.com")).to_equal(true)
        expect(name_at_is(names, 1, "*.wild.example.com")).to_equal(true)
        expect(name_at_is(names, 2, "upper.example.net")).to_equal(true)

    it "returns an empty list for a certificate with no subjectAltName":
        step("Verify: returns an empty list for a certificate with no subjectAltName")
        # @req: REQ-OS-OsTlsHostVeri-001
        val cert = hex_to_bytes(NOSAN_LEAF_DER_HEX)
        expect(cert.len()).to_equal(791)  # oracle: value fixed by the spec contract
        expect(extract_san_dns_names(cert).len()).to_equal(0)  # oracle: value fixed by the spec contract

describe "dns_name_matches":
    it "accepts an exact literal name and rejects a different one":
        step("Verify: accepts an exact literal name and rejects a different one")
        # @req: REQ-OS-OsTlsHostVeri-001
        expect(dns_name_matches(tb("example.com"), tb("example.com"))).to_equal(true)
        expect(dns_name_matches(tb("example.com"), tb("evil.com"))).to_equal(false)
        expect(dns_name_matches(tb("example.com"), tb("notexample.com"))).to_equal(false)
        expect(dns_name_matches(tb("example.com"), tb("example.com.evil.com"))).to_equal(false)

    it "matches a leftmost wildcard against exactly one label":
        step("Verify: matches a leftmost wildcard against exactly one label")
        # @req: REQ-OS-OsTlsHostVeri-001
        expect(dns_name_matches(tb("*.wild.example.com"), tb("a.wild.example.com"))).to_equal(true)
        expect(dns_name_matches(tb("*.wild.example.com"), tb("longer.wild.example.com"))).to_equal(true)
        # A wildcard covers one label, never zero and never two.
        expect(dns_name_matches(tb("*.wild.example.com"), tb("wild.example.com"))).to_equal(false)
        expect(dns_name_matches(tb("*.wild.example.com"), tb("a.b.wild.example.com"))).to_equal(false)

    it "rejects over-broad and malformed wildcards (RFC 6125 6.4.3)":
        step("Verify: rejects over-broad and malformed wildcards (RFC 6125 6.4.3)")
        # @req: REQ-OS-OsTlsHostVeri-001
        # Public-suffix wildcard: "*.com" must never match "example.com".
        expect(dns_name_matches(tb("*.com"), tb("example.com"))).to_equal(false)
        expect(dns_name_matches(tb("*"), tb("com"))).to_equal(false)
        # Partial-label wildcards are not honoured.
        expect(dns_name_matches(tb("w*.example.com"), tb("www.example.com"))).to_equal(false)
        expect(dns_name_matches(tb("*w.example.com"), tb("ww.example.com"))).to_equal(false)
        # Wildcard outside the leftmost label is not honoured.
        expect(dns_name_matches(tb("www.*.example.com"), tb("www.a.example.com"))).to_equal(false)
        # Empty labels are invalid names.
        expect(dns_name_matches(tb("a..com"), tb("a..com"))).to_equal(false)
        expect(dns_name_matches(tb(".example.com"), tb(".example.com"))).to_equal(false)

describe "verify_hostname":
    it "accepts every name the fixture certificate was actually issued for":
        step("Verify: accepts every name the fixture certificate was actually issued for")
        # @req: REQ-OS-OsTlsHostVeri-001
        val cert = hex_to_bytes(SAN_LEAF_DER_HEX)
        expect(is_ok(verify_hostname(cert, "example.com"))).to_equal(true)
        # Reference-name matching is case-insensitive in both directions.
        expect(is_ok(verify_hostname(cert, "EXAMPLE.COM"))).to_equal(true)
        expect(is_ok(verify_hostname(cert, "upper.example.net"))).to_equal(true)
        expect(is_ok(verify_hostname(cert, "UPPER.EXAMPLE.NET"))).to_equal(true)
        expect(is_ok(verify_hostname(cert, "sub.wild.example.com"))).to_equal(true)
        # A single trailing root dot is stripped, not treated as an empty label.
        expect(is_ok(verify_hostname(cert, "example.com."))).to_equal(true)

    it "rejects hosts the fixture certificate was not issued for":
        step("Verify: rejects hosts the fixture certificate was not issued for")
        # @req: REQ-OS-OsTlsHostVeri-001
        val cert = hex_to_bytes(SAN_LEAF_DER_HEX)
        expect(is_ok(verify_hostname(cert, "attacker.com"))).to_equal(false)
        expect(is_ok(verify_hostname(cert, "wild.example.com"))).to_equal(false)
        expect(is_ok(verify_hostname(cert, "a.b.wild.example.com"))).to_equal(false)
        expect(is_ok(verify_hostname(cert, "example.com.attacker.com"))).to_equal(false)
        # The IP SAN is present in the certificate but is not a dNSName.
        expect(is_ok(verify_hostname(cert, "192.0.2.1"))).to_equal(false)
        expect(err_text(verify_hostname(cert, "attacker.com"))).to_equal(
            "hostname verification: no subjectAltName dNSName matched the requested host")

    it "fails closed when the certificate has no SAN, even if the CN matches":
        step("Verify: fails closed when the certificate has no SAN, even if the CN matches")
        # @req: REQ-OS-OsTlsHostVeri-001
        # RFC 6125 6.4.4 / CA-Browser Forum: the Subject CN must not be a fallback.
        # This certificate's CN is exactly "nosan.example.com".
        val cert = hex_to_bytes(NOSAN_LEAF_DER_HEX)
        expect(is_ok(verify_hostname(cert, "nosan.example.com"))).to_equal(false)
        expect(err_text(verify_hostname(cert, "nosan.example.com"))).to_equal(
            "hostname verification: certificate has no subjectAltName dNSName")

    it "fails closed on empty, non-ASCII, and malformed reference names":
        step("Verify: fails closed on empty, non-ASCII, and malformed reference names")
        # @req: REQ-OS-OsTlsHostVeri-001
        val cert = hex_to_bytes(SAN_LEAF_DER_HEX)
        expect(is_ok(verify_hostname(cert, ""))).to_equal(false)
        expect(is_ok(verify_hostname(cert, "."))).to_equal(false)
        expect(is_ok(verify_hostname(cert, "exa\tmple.com"))).to_equal(false)
        expect(is_ok(verify_hostname([], "example.com"))).to_equal(false)
