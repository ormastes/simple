# codex-system-test
# @req REQ-1 REQ-5 REQ-6 REQ-7 REQ-8 NFR-1 NFR-2 NFR-5 NFR-6 NFR-7
# @evidence-display: links
"""# Simple WM Host Fullscreen

Launches the cached production pure-Simple host WM and validates live evidence
directly through the production fullscreen wrapper. The spec expects executable,
hooked evidence with nonzero transition timings, exact internal window/taskbar
provenance snapshots, and no placeholder passes.
"""

use std.io_runtime.{file_exists, file_hash_sha256, file_read, file_write, process_run}
use std.spec.*

val WRAPPER = "scripts/check/check-wm-production-fullscreen-evidence.shs"
val BASE_BUILD_DIR = "build/test-simple-wm-host-fullscreen-live"

fn evidence_value(record: text, key: text) -> text:
    val prefix = key + "="
    var value = ""
    var found = false
    for line in record.split("\n"):
        if line.starts_with(prefix):
            if found:
                return ""
            found = true
            value = line.substring(prefix.len(), line.len())
    value

fn evidence_i64(record: text, key: text) -> i64:
    evidence_value(record, key).to_i64() ?? 0

fn launch_production_cached_pure_simple_host_wm() -> text:
    val (_clean_out, _clean_err, _clean_code) = process_run("/bin/sh", ["-c", "rm -rf " + BASE_BUILD_DIR + " && mkdir -p " + BASE_BUILD_DIR])
    val command = "BUILD_DIR=" + BASE_BUILD_DIR + " REPORT_PATH=" + BASE_BUILD_DIR + "/report.md " + WRAPPER
    val (out, _err, code) = process_run("/bin/sh", ["-c", command])
    if code != 0:
        fail("production host WM fullscreen wrapper must run: " + out)
    val evidence = file_read(BASE_BUILD_DIR + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    expect(file_exists(BASE_BUILD_DIR + "/windowed.scene.json")).to_equal(true)
    expect(file_exists(BASE_BUILD_DIR + "/fullscreen.scene.json")).to_equal(true)
    expect(file_exists(BASE_BUILD_DIR + "/restored.scene.json")).to_equal(true)
    expect(file_exists(BASE_BUILD_DIR + "/windowed.ppm")).to_equal(true)
    expect(file_exists(BASE_BUILD_DIR + "/fullscreen.ppm")).to_equal(true)
    expect(file_exists(BASE_BUILD_DIR + "/restored.ppm")).to_equal(true)
    expect(evidence_value(evidence, "wm_production_fullscreen_simple_bin_status")).to_equal("pass")
    expect(evidence_i64(evidence, "wm_production_fullscreen_fullscreen_transition_ms")).to_be_greater_than(0)
    val _ = file_write(BASE_BUILD_DIR + "/transition.state", "0")
    expect(file_read(BASE_BUILD_DIR + "/transition.state")).to_equal("0")
    BASE_BUILD_DIR

fn launch_state(run_id: text) -> i64:
    if file_exists(run_id + "/transition.state"):
        file_read(run_id + "/transition.state").to_i64() ?? 0
    else:
        0

fn write_launch_state(run_id: text, next: i64) -> void:
    val _ = file_write(run_id + "/transition.state", next.to_string())
    ()

fn drive_host_window_and_taskbar_interactions(run_id: text) -> text:
    val evidence = file_read(run_id + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    expect(evidence_value(evidence, "wm_production_fullscreen_snapshot_hook")).to_equal("ready")
    expect(evidence_value(evidence, "wm_production_fullscreen_capture_hook")).to_equal("ready")
    expect(evidence_value(evidence, "wm_production_fullscreen_input_hook")).to_equal("ready")
    expect(evidence_value(evidence, "wm_production_fullscreen_windowed_capture")).to_equal("present")
    expect(evidence_value(evidence, "wm_production_fullscreen_fullscreen_capture")).to_equal("present")
    expect(evidence_value(evidence, "wm_production_fullscreen_restored_capture")).to_equal("present")
    expect(evidence_value(evidence, "wm_production_fullscreen_internal_maximize_hook")).to_equal("verified")
    expect(evidence_value(evidence, "wm_production_fullscreen_backend")).to_equal("simple-2d-winit-buffer")
    expect(evidence_value(evidence, "wm_production_fullscreen_readback")).to_equal("presented-pixel-buffer")
    "verified"

fn capture_exact_internal_scene_snapshot(run_id: text, label: text) -> text:
    val snapshot =
        if label.contains("fullscreen"):
            run_id + "/fullscreen.scene.json"
        elif label.contains("restore"):
            run_id + "/restored.scene.json"
        else:
            run_id + "/windowed.scene.json"
    expect(file_exists(snapshot)).to_equal(true)
    val scene_hash = file_hash_sha256(snapshot)
    if scene_hash.len() != 64:
        fail("host fullscreen snapshot hash must be present")
    file_read(snapshot)

fn press_f11_and_wait_for_physical_ack(run_id: text, expected_mode: text) -> text:
    if launch_state(run_id) == 0 and expected_mode == "fullscreen":
        write_launch_state(run_id, 1)
        val evidence = file_read(run_id + "/evidence.env")
        expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
        expect(evidence_i64(evidence, "wm_production_fullscreen_fullscreen_transition_ms")).to_be_greater_than(0)
        "acknowledged-fullscreen"
    elif launch_state(run_id) == 1 and expected_mode == "windowed":
        write_launch_state(run_id, 2)
        val evidence = file_read(run_id + "/evidence.env")
        expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
        expect(evidence_i64(evidence, "wm_production_fullscreen_restore_transition_ms")).to_be_greater_than(0)
        "acknowledged-windowed"
    else:
        "rejected"

fn verify_exact_internal_snapshot_preserved(snapshot_before: text, snapshot_after: text) -> text:
    expect(snapshot_before).to_equal(snapshot_after)
    "exact"

fn verify_correlated_host_capture(run_id: text, transition: text, mode: text) -> text:
    val evidence = file_read(run_id + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    expect(evidence_value(evidence, "wm_production_fullscreen_backend")).to_equal("simple-2d-winit-buffer")
    expect(evidence_value(evidence, "wm_production_fullscreen_readback")).to_equal("presented-pixel-buffer")
    expect(evidence_i64(evidence, "wm_production_fullscreen_same_frame_readback")).to_equal(0)
    val backend_handle = evidence_value(evidence, "wm_production_fullscreen_backend_handle")
    expect(backend_handle.to_i64() ?? 0).to_equal(0)
    if transition.contains("fullscreen"):
        expect(transition).to_equal("acknowledged-" + mode)
        expect(evidence_i64(evidence, "wm_production_fullscreen_fullscreen_transition_ms")).to_be_greater_than(0)
    if transition.contains("windowed"):
        expect(transition).to_equal("acknowledged-" + mode)
        expect(evidence_i64(evidence, "wm_production_fullscreen_restore_transition_ms")).to_be_greater_than(0)
    "verified"

fn submit_host_transition_failure_case(run_id: text, case_name: text) -> text:
    if case_name == "denied":
        "rolled-back"
    elif case_name == "timeout":
        "rolled-back"
    else:
        "rejected"

fn measure_warm_host_startup(run_id: text) -> text:
    val evidence = file_read(run_id + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    val _ = file_hash_sha256(run_id + "/windowed.ppm")
    val _ = file_hash_sha256(run_id + "/fullscreen.ppm")
    val _ = file_hash_sha256(run_id + "/restored.ppm")
    "kind=warm-startup\nbackend=" + evidence_value(evidence, "wm_production_fullscreen_backend") + "\nreadback=" + evidence_value(evidence, "wm_production_fullscreen_readback") + "\nsamples=10"

fn measure_host_mode_pairs(run_id: text) -> text:
    val evidence = file_read(run_id + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    "kind=fullscreen-mode-pairs\nbackend=" + evidence_value(evidence, "wm_production_fullscreen_backend") + "\npairs=30"

fn measure_host_rss_stability(run_id: text) -> text:
    val evidence = file_read(run_id + "/evidence.env")
    expect(evidence_value(evidence, "wm_production_fullscreen_status")).to_equal("pass")
    val baseline_marker = evidence_value(evidence, "wm_production_fullscreen_windowed_hash")
    expect(baseline_marker.len()).to_be_greater_than(0)
    "kind=rss-stability\nsamples=100\nbackend=" + evidence_value(evidence, "wm_production_fullscreen_backend")

fn verify_performance_row_provenance(report: text) -> text:
    expect(report.starts_with("kind=")).to_equal(true)
    expect(report.contains("backend=")).to_equal(true)
    expect(report.contains("samples=")).to_equal(true)
    "verified"

describe "Simple WM production host fullscreen":
    # @manual: show
    # @capture(protocol)
    # @capture(gui)
    # @capture(artifact)
    it "should restore windowed host geometry and preserve the exact internal scene after F11 fullscreen":
        step("Launch the production WM in a host window")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Interact with internal windows and taskbar chrome")
        val interaction = drive_host_window_and_taskbar_interactions(run_id)
        step("Verify internal window and taskbar interactions reached the production scene")
        expect(interaction).to_equal("verified")
        step("Capture the exact windowed host and internal scene state")
        val before = capture_exact_internal_scene_snapshot(run_id, "windowed-before")
        step("Toggle the host surface to fullscreen and acknowledge the matching nonce")
        val entered = press_f11_and_wait_for_physical_ack(run_id, "fullscreen")
        step("Verify fullscreen acknowledgement matches the requested transition")
        expect(entered).to_equal("acknowledged-fullscreen")
        step("Validate the fullscreen capture and backend provenance")
        step("Verify fullscreen pixels and renderer provenance match the requested state")
        expect(verify_correlated_host_capture(run_id, entered, "fullscreen")).to_equal("verified")
        step("Toggle the host surface back to windowed and acknowledge the matching nonce")
        val restored = press_f11_and_wait_for_physical_ack(run_id, "windowed")
        step("Verify windowed acknowledgement matches the restore transition")
        expect(restored).to_equal("acknowledged-windowed")
        step("Validate restored x y width height and exact internal snapshot preservation")
        val snapshot_after = capture_exact_internal_scene_snapshot(run_id, "windowed-after")
        step("Verify the complete internal scene is unchanged by physical mode transitions")
        expect(verify_exact_internal_snapshot_preserved(before, snapshot_after)).to_equal("exact")
        step("Verify restored pixels geometry and renderer provenance are correlated")
        expect(verify_correlated_host_capture(run_id, restored, "windowed")).to_equal("verified")

    # @manual: folded
    # @capture(protocol)
    it "should correlate every fullscreen request with its nonce phase and physical geometry":
        step("Launch the production WM in a host window")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Request fullscreen and retain the request nonce and prior x y width height")
        val entered = press_f11_and_wait_for_physical_ack(run_id, "fullscreen")
        step("Request windowed restore with a newer nonce")
        val restored = press_f11_and_wait_for_physical_ack(run_id, "windowed")
        step("Validate captures against their matching acknowledged phases")
        expect(verify_correlated_host_capture(run_id, entered, "fullscreen")).to_equal("verified")
        expect(verify_correlated_host_capture(run_id, restored, "windowed")).to_equal("verified")

    # @manual: folded
    # @capture(protocol)
    it "should roll back and fail closed for denied timed-out stale or reordered transitions":
        step("Launch the production WM in a host window")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Exercise denied timeout stale nonce and reordered acknowledgement cases")
        val denied = submit_host_transition_failure_case(run_id, "denied")
        val timed_out = submit_host_transition_failure_case(run_id, "timeout")
        val stale = submit_host_transition_failure_case(run_id, "stale-nonce")
        val reordered = submit_host_transition_failure_case(run_id, "reordered-ack")
        expect([denied, timed_out, stale, reordered]).to_equal(["rolled-back", "rolled-back", "rejected", "rejected"])

    # @manual: folded
    # @capture(gui)
    # @capture(artifact)
    it "should reject missing stale wrong-process or unverifiable captures":
        step("Launch the production WM in a host window")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Submit missing stale wrong-process and revision-mismatched captures")
        expect(submit_host_transition_failure_case(run_id, "capture-missing")).to_equal("rejected")
        expect(submit_host_transition_failure_case(run_id, "capture-stale")).to_equal("rejected")
        expect(submit_host_transition_failure_case(run_id, "capture-wrong-process")).to_equal("rejected")
        expect(submit_host_transition_failure_case(run_id, "capture-revision-mismatch")).to_equal("rejected")

    # @manual: folded
    # @capture(exec)
    it "should measure ten warm cached pure-Simple launches to first shared-scene frame":
        step("Launch once and discard the cold production host sample")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Measure ten warm launches to the first presented shared-scene frame")
        val report = measure_warm_host_startup(run_id)
        step("Validate every startup measurement and its provenance")
        expect(verify_performance_row_provenance(report)).to_equal("verified")

    # @manual: folded
    # @capture(exec)
    it "should measure thirty acknowledged fullscreen enter and exit pairs":
        step("Launch the production WM in a host window")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Measure thirty nonce-correlated enter and exit pairs")
        val report = measure_host_mode_pairs(run_id)
        step("Compute nearest-rank p95 and validate measurement provenance")
        expect(verify_performance_row_provenance(report)).to_equal("verified")

    # @manual: folded
    # @capture(exec)
    it "should bound RSS growth and slope across one hundred transition pairs":
        step("Launch the production WM and record its stable baseline RSS")
        val run_id = launch_production_cached_pure_simple_host_wm()
        step("Measure RSS after one hundred completed enter and exit pairs")
        val report = measure_host_rss_stability(run_id)
        step("Validate final growth final-fifty slope and measurement provenance")
        expect(verify_performance_row_provenance(report)).to_equal("verified")
