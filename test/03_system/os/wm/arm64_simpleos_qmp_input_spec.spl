# codex-system-test
# @req REQ-7
# @evidence-display: links
"""# ARM64 SimpleOS QMP input

Fails closed until the canonical ARM64 Engine2D desktop owns a real
VirtIO-MMIO input transport. PL011 character actions are explicitly excluded
from keyboard press/release and pointer evidence.
"""
use std.spec.*
use app.io.mod.{file_read_text}

fn require_arm64_live_qmp_input_evidence():
    fail("ARM64 source wiring is present, but production admission still requires a host-green QEMU run with QMP key/button edges, guest device-to-WM-to-frame sequence correlation, and distinct baseline/post-input RAMFB captures")

describe "ARM64 SimpleOS QMP input":
    it "wires capability-discovered VirtIO-MMIO keyboard and pointer event queues":
        step("Inspect the canonical ARM64 desktop, runtime owner, and QEMU target")
        val entry = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"
        )
        val targets = file_read_text("src/os/_QemuRunner/runner_targets.spl")
        val translation = file_read_text(
            "src/os/drivers/virtio/virtio_input_ops.spl"
        )
        val facade = file_read_text("src/os/kernel/arch/arm64/virtio_input.spl")
        val runtime = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
        )

        expect(entry).to_contain("arm64_virtio_input_init()")
        expect(entry).to_contain("arm64_virtio_input_poll()")
        expect(entry).to_contain("VirtioMouseAccum.create")
        expect(entry).to_contain("[virtio-input-device] input_seq=")
        expect(entry).to_contain("[wm-pointer-frame] input_seq=")
        expect(translation).to_contain("fn virtio_input_key_event(")
        expect(translation).to_contain("class VirtioMouseAccum:")
        expect(facade).to_contain("rt_arm64_virtio_input_init")
        expect(facade).to_contain("rt_arm64_virtio_input_poll")
        expect(runtime).to_contain("ARM64_VIRTIO_INPUT_DEVICE_ID 18U")
        expect(runtime).to_contain("VIRTIO_INPUT_CFG_EV_BITS")
        expect(runtime).to_contain("arm64_virtio_input_kind")
        expect(runtime).to_contain("VIRTQ_DESC_F_WRITE")
        expect(runtime).to_contain("dev->avail.idx = ARM64_VIRTIO_QUEUE_SIZE")
        expect(runtime).to_contain("dev->last_used_idx++")
        expect(runtime).to_contain("VMMIO_QUEUE_NOTIFY")
        expect(targets).to_contain("fn get_arm64_desktop_engine2d_target()")
        expect(targets).to_contain("virtio-keyboard-device")
        expect(targets).to_contain("virtio-mouse-device")

    # @capture(protocol)
    # @capture(gui)
    # @capture(artifact)
    it "correlates QMP key edges and pointer events with guest state and frames":
        step("Boot the canonical ARM64 Engine2D production desktop")
        step("Inject keyboard down and up through QMP VirtIO input")
        step("Inject pointer move and button down and up through QMP VirtIO input")
        step("Observe guest-owned device receipt sequences")
        step("Correlate handled input with WM state and later framebuffer revisions")
        step("Capture baseline and post-input RAMFB images")
        require_arm64_live_qmp_input_evidence()
