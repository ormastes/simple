"""
## Purpose and audience
Purpose: Prove that ARM64 SimpleOS QMP input.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-OS-ARM64-QMP-001
doc/01_research/os/REQ-OS-ARM64-QMP-001.md
doc/03_plan/os/REQ-OS-ARM64-QMP-001.md
doc/04_architecture/os/REQ-OS-ARM64-QMP-001.md
doc/05_design/os/REQ-OS-ARM64-QMP-001.md
"""
# @req: REQ-OS-ARM64-QMP-001


# codex-system-test
# @req REQ-007
# @req REQ-AQMP-001
# @req REQ-AQMP-002
# @req REQ-AQMP-003
# @evidence-display: links
"""# ARM64 SimpleOS QMP input

The canonical ARM64 Engine2D desktop already owns the real VirtIO-MMIO input
transport. Production admission remains fail-closed only until a host-green
live QMP run correlates device, WM, frame, and distinct RAMFB capture evidence.
PL011 character actions are explicitly excluded from that evidence.
"""
use std.spec.*
use app.io.mod.{file_read_text, process_run_timeout}

fn require_arm64_live_qmp_input_evidence():
    val result = process_run_timeout(
        "sh",
        ["scripts/check/check-simpleos-arm64-qmp-input-evidence.shs"],
        240000
    )
    expect(result[2]).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(result[0]).to_contain("arm64_qmp_input_status=pass")
    expect(result[0]).to_contain(
        "arm64_qmp_input_reason=live-qmp-guest-frame-ramfb-correlation-pass"
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_transport=input-send-event"
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_capture_origin=qemu-ramfb-screendump"
    )
    expect(result[0]).to_contain("arm64_qmp_input_simd_arch=aarch64")
    expect(result[0]).to_contain("arm64_qmp_input_simd_isa=neon")
    expect(result[0]).to_contain("arm64_qmp_input_simd_enabled=1")
    expect(result[0]).to_contain("arm64_qmp_input_simd_native_hits=")
    expect(result[0]).to_contain("arm64_qmp_input_simd_vector_chunks=")
    expect(result[0]).to_contain(
        "arm64_qmp_input_simd_required_kernel_kinds=fill"
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_simd_executed_kernel_kinds=fill"
    )
    expect(result[0]).to_contain("arm64_qmp_input_simd_fallback=none")
    expect(result[0]).to_contain(
        "arm64_qmp_input_simd_scalar_parity=bit-exact"
    )
    expect(result[0]).to_contain("arm64_qmp_input_report=")
    expect(result[0]).to_contain("arm64_qmp_input_pointer_sequences=")
    expect(result[0]).to_contain("arm64_qmp_input_key_sequences=")
    expect(result[0]).to_contain("arm64_qmp_input_before_sha256=")
    expect(result[0]).to_contain("arm64_qmp_input_after_sha256=")
    expect(result[0]).to_contain("arm64_qmp_input_changed_rgb_bytes=")
    expect(result[0]).to_contain(
        "arm64_qmp_input_outside_damage_bound_pixels=0"
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_guest_source_revision="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_guest_source_fingerprint="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_guest_source_file_count="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_compiler_sha256="
    )
    expect(result[0]).to_contain("arm64_qmp_input_compiler_format=")
    expect(result[0]).to_contain("arm64_qmp_input_compiler_arch=")
    expect(result[0]).to_contain(
        "arm64_qmp_input_disk_producer_sha256="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_baseline_rendered_revision="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_after_rendered_revision="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_damage_bound_kind=conservative-full-frame"
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_peak_checksum_us="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_baseline_ramfb_checksum="
    )
    expect(result[0]).to_contain(
        "arm64_qmp_input_after_ramfb_checksum="
    )

use std.spec.step

describe "ARM64 SimpleOS QMP input":
    it "wires capability-discovered VirtIO-MMIO keyboard and pointer event queues":
        # @req: REQ-OS-ARM64-QMP-001
        # @req: REQ-007
        # @req: REQ-AQMP-001
        # @req: REQ-AQMP-002
        # @req: REQ-AQMP-003
        step("Verify: wires capability-discovered VirtIO-MMIO keyboard and pointer event queues")
        step("Inspect the canonical ARM64 desktop, runtime owner, and QEMU target")
        val entry = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"
        )
        val ramfb = file_read_text(
            "src/os/kernel/arch/arm64/ramfb.spl"
        )
        val targets = file_read_text("src/os/_QemuRunner/runner_targets.spl")
        val translation = file_read_text(
            "src/os/drivers/virtio/virtio_input_ops.spl"
        )
        val facade = file_read_text("src/os/kernel/arch/arm64/virtio_input.spl")
        val backend = file_read_text(
            "src/os/compositor/arm64_virtio_input_backend.spl"
        )
        val runtime = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
        )
        val live_wrapper = file_read_text(
            "scripts/check/check-simpleos-arm64-qmp-input-evidence.shs"
        )
        val build_wrapper = file_read_text(
            "scripts/check/build-simpleos-arm64-desktop-engine2d-attested.shs"
        )
        val bootstrap_manifest_writer = file_read_text(
            "scripts/check/lib/bootstrap-stage3/manifest-write.shs"
        )
        val source_fingerprint = file_read_text(
            "scripts/check/lib/simpleos-arm64-guest-source-fingerprint.shs"
        )
        val arm64_guide = file_read_text(
            "doc/07_guide/platform/simpleos/simpleos_arm64_wm_qemu.md"
        )
        val nul_find_contract =
            "find \"$snapshot_root\" \\( -type f -o -type l \\) -print0"
        val byte_sort_contract = "paths = " + "sorted(set(encoded_paths[:-1]))"
        val ramfb_checksum_contract =
            "simpleos_host_gpu_readback_checksum_" + "finalize(checksum)"

        expect(entry).to_contain("arm64_virtio_input_init()")
        expect(entry).to_contain("Arm64VirtioInputBackend.create")
        expect(entry).to_contain("input_compositor.handle_input()")
        expect(entry).to_contain("Compositor.with_backends(")
        expect(backend).to_contain("impl InputBackend for Arm64VirtioInputBackend:")
        expect(entry).to_contain("arm64_virtio_input_poll")
        expect(backend.contains("os.kernel.arch.arm64")).to_equal(false)
        expect(backend).to_contain("VirtioMouseAccum.create")
        expect(entry).to_contain("[virtio-input-device] input_seq=")
        expect(entry).to_contain("[wm-pointer-frame] input_seq=")
        expect(translation).to_contain("fn virtio_input_key_event(")
        expect(translation).to_contain("class VirtioMouseAccum:")
        expect(facade).to_contain("rt_arm64_virtio_input_init")
        expect(facade).to_contain("rt_arm64_virtio_input_poll")
        expect(runtime).to_contain("ARM64_VIRTIO_INPUT_DEVICE_ID 18U")
        expect(runtime).to_contain("VIRTIO_INPUT_CFG_EV_BITS")
        expect(runtime).to_contain("arm64_virtio_input_kind")
        expect(runtime).to_contain("VIRTQ_DESC_F_WRITE")
        expect(runtime).to_contain("dev->avail.idx = ARM64_VIRTIO_QUEUE_SIZE")
        expect(runtime).to_contain("dev->last_used_idx++")
        expect(runtime).to_contain("ARM64_DMA_READ_ONCE(dev->used.idx)")
        expect(runtime).to_contain("arm64_virtio_dma_acquire()")
        expect(runtime).to_contain("arm64_virtio_dma_release()")
        expect(runtime).to_contain("ARM64_DMA_WRITE_ONCE(dev->avail.idx")
        expect(runtime).to_contain("arm64_virtio_input_wait_reset")
        expect(runtime).to_contain("arm64_virtio_input_mark_failed")
        expect(runtime).to_contain("arm64_virtio_event_length_valid")
        expect(runtime).to_contain("arm64_virtio_queue_shape_valid")
        expect(runtime).to_contain("VIRTIO_STATUS_DEVICE_NEEDS_RESET")
        expect(runtime).to_contain("arm64_virtio_status_rejected(")
        val features_status = runtime.index_of("status = mmio[VMMIO_STATUS / 4U];", runtime.index_of("VIRTIO_STATUS_FEATURES_OK"))
        val features_reject = runtime.index_of("arm64_virtio_status_rejected(", features_status)
        val driver_status = runtime.index_of("status = mmio[VMMIO_STATUS / 4U];", runtime.index_of("VIRTIO_STATUS_DRIVER_OK", features_reject))
        val driver_reject = runtime.index_of("arm64_virtio_status_rejected(", driver_status)
        expect(features_reject).to_be_greater_than(features_status)
        expect(driver_reject).to_be_greater_than(driver_status)
        expect(runtime).to_contain("VMMIO_QUEUE_NOTIFY")
        expect(targets).to_contain("fn get_arm64_desktop_engine2d_target()")
        expect(targets).to_contain("virtio-keyboard-device")
        expect(targets).to_contain("virtio-mouse-device")
        expect(live_wrapper).to_contain("\"input-send-event\"")
        expect(live_wrapper).to_contain("qmp(\"screendump\"")
        expect(live_wrapper).to_contain("qemu-ramfb-screendump")
        expect(live_wrapper).to_contain("post-input RAMFB capture is identical")
        expect(live_wrapper).to_contain(
            "KERNEL=\"build/os/simpleos_arm64_desktop_engine2d.elf\""
        )
        expect(live_wrapper).to_contain(
            "DISK=\"build/os/fat32-arm64-desktop.img\""
        )
        expect(live_wrapper).to_contain(
            "BUILD_MANIFEST=\"build/os/simpleos_arm64_desktop_engine2d.build-manifest.env\""
        )
        expect(live_wrapper).to_contain(
            "MANIFEST_SOURCE_REVISION"
        )
        expect(live_wrapper).to_contain(
            "canonical-kernel-launch-sha256-mismatch"
        )
        expect(live_wrapper).to_contain(
            "canonical-desktop-disk-missing"
        )
        expect(live_wrapper).to_contain(
            "canonical-disk-launch-sha256-mismatch"
        )
        expect(live_wrapper).to_contain(
            "canonical-build-manifest-font-bundle-sha256-mismatch"
        )
        expect(live_wrapper).to_contain(
            "canonical-font-bundle-manifest-launch-sha256-mismatch"
        )
        expect(live_wrapper).to_contain(
            "canonical-font-bundle-manifest-mutated-during-run"
        )
        expect(live_wrapper).to_contain(
            "file=$DISK,if=none,id=armdesktop,format=raw,readonly=on"
        )
        expect(live_wrapper).to_contain(
            "guest-source-fingerprint-manifest-mismatch"
        )
        expect(live_wrapper).to_contain(
            "guest-source-fingerprint-changed-during-run"
        )
        expect(live_wrapper).to_contain(
            "[ramfb-visual-commit\\] input_seq="
        )
        expect(entry).to_contain(
            "[engine2d-simd] arch=aarch64 isa=neon enabled=1"
        )
        expect(entry).to_contain("scalar_parity=bit-exact")
        expect(live_wrapper).to_contain("def require_simd_receipt(text):")
        expect(live_wrapper).to_contain(
            "expected exactly one guest Engine2D SIMD receipt"
        )
        expect(live_wrapper).to_contain(
            "guest Engine2D SIMD receipt reports fallback or contract mismatch"
        )
        expect(live_wrapper).to_contain(
            "guest Engine2D SIMD receipt lacks native vector execution"
        )
        expect(live_wrapper).to_contain(
            "\"required_kernel_kinds\": \"fill\""
        )
        expect(live_wrapper).to_contain(
            "\"executed_kernel_kinds\": \"fill\""
        )
        expect(live_wrapper).to_contain("\"fallback\": \"none\"")
        expect(live_wrapper).to_contain(
            "final_simd_receipt = require_simd_receipt(serial_text())"
        )
        expect(live_wrapper).to_contain(
            "arm64_qmp_input_simd_scalar_parity=$(field simd_scalar_parity)"
        )
        val simd_gate = live_wrapper.index_of(
            "simd_receipt = require_simd_receipt(serial_text())"
        ) ?? -1
        val input_gate = live_wrapper.index_of(
            "event_backend=virtio-mmio keyboard=transport-ready"
        ) ?? -1
        expect(simd_gate).to_be_greater_than(-1)
        expect(input_gate).to_be_greater_than(simd_gate)
        expect(live_wrapper).to_contain(
            "QMP pixel delta is outside guest-declared damage bounds"
        )
        expect(live_wrapper).to_contain("def inject_and_wait(")
        expect(live_wrapper).to_contain(
            "Each logical input action"
        )
        expect(entry).to_contain("rendered_revision={rendered_revision}")
        expect(entry).to_contain(
            "damage_kind=conservative-full-frame"
        )
        expect(entry).to_contain("checksum_us={checksum_us}")
        expect(entry).to_contain(
            "checksum_finished_us <= checksum_started_us"
        )
        expect(live_wrapper).to_contain(
            "max-checksum-us-exceeds-release-ceiling"
        )
        expect(live_wrapper).to_contain(
            "pointer relative-motion receipt mismatch"
        )
        expect(live_wrapper).to_contain(
            "WM modifier state does not match raw producer edge"
        )
        expect(entry).to_contain(
            "fatal reason=multi-input-frame-attribution"
        )
        expect(live_wrapper).to_contain(
            "sequence=pointer_move,pointer_down,pointer_drag,pointer_up,pointer_wheel,"
        )
        expect(live_wrapper.contains("SIMPLEOS_ARM64_QMP_KERNEL")).to_be(false)
        expect(live_wrapper.contains("SIMPLEOS_ARM64_QMP_DISK")).to_be(false)
        expect(live_wrapper.contains("native-build")).to_be(false)
        expect(live_wrapper.contains("build_os")).to_be(false)
        expect(build_wrapper).to_contain(
            "\"$COMPILER\" os build --scenario=arm64-desktop-engine2d"
        )
        expect(build_wrapper).to_contain(
            "bin/release/aarch64-apple-darwin-macho/simple"
        )
        expect(build_wrapper).to_contain(
            "SIMPLE_OS_BUILD_BACKEND=llvm"
        )
        expect(build_wrapper).to_contain(
            "PRE_SOURCE_FINGERPRINT"
        )
        expect(build_wrapper).to_contain(
            "POST_SOURCE_FINGERPRINT"
        )
        expect(build_wrapper).to_contain(
            "source-revision-changed-during-build"
        )
        expect(build_wrapper).to_contain(
            "compiler-changed-during-build"
        )
        expect(build_wrapper).to_contain(
            "canonical-font-bundle-manifest-missing"
        )
        expect(build_wrapper).to_contain(
            "font-bundle-manifest-replaced-during-build"
        )
        expect(build_wrapper).to_contain(
            "font-bundle-manifest-changed-during-build"
        )
        expect(build_wrapper).to_contain("disk_profile=$DISK_PROFILE")
        expect(build_wrapper).to_contain("disk_access=$DISK_ACCESS")
        expect(build_wrapper).to_contain(
            "font_bundle_manifest_sha256=$POST_FONT_BUNDLE_MANIFEST_SHA256"
        )
        expect(build_wrapper).to_contain(
            "source_fingerprint=$PRE_SOURCE_FINGERPRINT"
        )
        expect(build_wrapper).to_contain(
            "source_file_count=$PRE_SOURCE_FILE_COUNT"
        )
        expect(source_fingerprint).to_contain(
            "scripts/os/make_os_disk.shs|scripts/os/make_os_disk.c"
        )
        expect(source_fingerprint).to_contain(
            "scripts/os/simpleos_font_bundle_companion.sha256|assets/fonts"
        )
        expect(source_fingerprint).to_contain(nul_find_contract)
        expect(source_fingerprint).to_contain(byte_sort_contract)
        expect(source_fingerprint).to_contain(
            "[ \"$arm64_guest_status_code\" -eq 0 ] || return 2"
        )
        expect(source_fingerprint).to_contain(
            "find \"$snapshot_root\""
        )
        expect(source_fingerprint).to_contain(
            "kind + b\"\\0\" + path + b\"\\0\""
        )
        expect(source_fingerprint).to_contain(
            "arm64_guest_validate_native_compiler"
        )
        expect(source_fingerprint).to_contain(
            "ARM64_GUEST_COMPILER_ADMISSION_REASON"
        )
        expect(source_fingerprint).to_contain(
            "arm64_guest_validate_compiler_version_output"
        )
        expect(source_fingerprint).to_contain(
            "^(Simple v|simple-bootstrap )"
        )
        expect(source_fingerprint.contains("grep -a -Eiq")).to_be(false)
        expect(source_fingerprint).to_contain(
            "arm64_guest_compiler_magic"
        )
        expect(source_fingerprint).to_contain(
            "ARM64_GUEST_COMPILER_FORMAT=mach-o-64"
        )
        expect(source_fingerprint).to_contain(
            "ARM64_GUEST_COMPILER_FORMAT=elf64"
        )
        expect(build_wrapper).to_contain(
            "compiler_format=$COMPILER_FORMAT"
        )
        expect(build_wrapper).to_contain(
            "compiler_arch=$COMPILER_ARCH"
        )
        expect(build_wrapper).to_contain(
            "run_compiler_admission_self_test"
        )
        expect(build_wrapper).to_contain(
            "arm64_compiler_admission_self_test_status=pass"
        )
        expect(bootstrap_manifest_writer).to_contain("status=pass")
        expect(bootstrap_manifest_writer).to_contain("stage2_sha256=")
        expect(bootstrap_manifest_writer).to_contain(
            "stage2_admitted_sha256="
        )
        expect(bootstrap_manifest_writer).to_contain(
            "stage2_sanity_status=pass"
        )
        expect(bootstrap_manifest_writer).to_contain("stage3_sha256=")
        expect(bootstrap_manifest_writer).to_contain(
            "stage3_sanity_status=pass"
        )
        expect(bootstrap_manifest_writer).to_contain("output_sha256=")
        expect(build_wrapper).to_contain(
