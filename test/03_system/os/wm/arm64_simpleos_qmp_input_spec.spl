# codex-system-test
# @req REQ-007
# @evidence-display: links
"""# ARM64 SimpleOS QMP input

The canonical ARM64 Engine2D desktop already owns the real VirtIO-MMIO input
transport. Production admission remains fail-closed only until a host-green
live QMP run correlates device, WM, frame, and distinct RAMFB capture evidence.
PL011 character actions are explicitly excluded from that evidence.
"""
use std.spec.*
use app.io.mod.{file_read_text}

fn require_arm64_live_qmp_input_evidence():
    fail("ARM64 source wiring is present, but production admission still requires a host-green QEMU run with QMP key/button edges, guest device-to-WM-to-frame sequence correlation, and distinct baseline/post-input RAMFB captures")

describe "ARM64 SimpleOS QMP input":
    it "wires capability-discovered VirtIO-MMIO keyboard and pointer event queues":
        step("Inspect the canonical ARM64 desktop, runtime owner, and QEMU target")
        val entry = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/gui_entry_desktop.spl"
        )
        val targets = file_read_text("src/os/_QemuRunner/runner_targets.spl")
        val translation = file_read_text(
            "src/os/drivers/virtio/virtio_input_ops.spl"
        )
        val facade = file_read_text("src/os/kernel/arch/arm64/virtio_input.spl")
        val backend = file_read_text(
            "src/os/compositor/arm64_virtio_input_backend.spl"
        )
        val runtime = file_read_text(
            "examples/09_embedded/simple_os/arch/arm64/boot/baremetal_stubs.c"
        )

        expect(entry).to_contain("arm64_virtio_input_init()")
        expect(entry).to_contain("Arm64VirtioInputBackend.create")
        expect(entry).to_contain("input_compositor.handle_input()")
        expect(entry).to_contain("Compositor.with_backends(")
        expect(backend).to_contain("impl InputBackend for Arm64VirtioInputBackend:")
        expect(backend).to_contain("arm64_virtio_input_poll()")
        expect(backend).to_contain("VirtioMouseAccum.create")
        expect(entry).to_contain("[virtio-input-device] input_seq=")
        expect(entry).to_contain("[wm-pointer-frame] input_seq=")
        expect(translation).to_contain("fn virtio_input_key_event(")
        expect(translation).to_contain("class VirtioMouseAccum:")
        expect(facade).to_contain("rt_arm64_virtio_input_init")
        expect(facade).to_contain("rt_arm64_virtio_input_poll")
        expect(runtime).to_contain("ARM64_VIRTIO_INPUT_DEVICE_ID 18U")
        expect(runtime).to_contain("VIRTIO_INPUT_CFG_EV_BITS")
        expect(runtime).to_contain("arm64_virtio_input_kind")
        expect(runtime).to_contain("VIRTQ_DESC_F_WRITE")
        expect(runtime).to_contain("dev->avail.idx = ARM64_VIRTIO_QUEUE_SIZE")
        expect(runtime).to_contain("dev->last_used_idx++")
        expect(runtime).to_contain("ARM64_DMA_READ_ONCE(dev->used.idx)")
        expect(runtime).to_contain("arm64_virtio_dma_acquire()")
        expect(runtime).to_contain("arm64_virtio_dma_release()")
        expect(runtime).to_contain("ARM64_DMA_WRITE_ONCE(dev->avail.idx")
        expect(runtime).to_contain("arm64_virtio_input_wait_reset")
        expect(runtime).to_contain("arm64_virtio_input_mark_failed")
        expect(runtime).to_contain("arm64_virtio_event_length_valid")
        expect(runtime).to_contain("arm64_virtio_queue_shape_valid")
        expect(runtime).to_contain("VIRTIO_STATUS_DEVICE_NEEDS_RESET")
        expect(runtime).to_contain("arm64_virtio_status_rejected(")
        val features_status = runtime.index_of("status = mmio[VMMIO_STATUS / 4U];", runtime.index_of("VIRTIO_STATUS_FEATURES_OK")) ?? -1
        val features_reject = runtime.index_of("arm64_virtio_status_rejected(", features_status) ?? -1
        val driver_status = runtime.index_of("status = mmio[VMMIO_STATUS / 4U];", runtime.index_of("VIRTIO_STATUS_DRIVER_OK", features_reject)) ?? -1
        val driver_reject = runtime.index_of("arm64_virtio_status_rejected(", driver_status) ?? -1
        expect(features_reject).to_be_greater_than(features_status)
        expect(driver_reject).to_be_greater_than(driver_status)
        expect(runtime).to_contain("VMMIO_QUEUE_NOTIFY")
        expect(targets).to_contain("fn get_arm64_desktop_engine2d_target()")
        expect(targets).to_contain("virtio-keyboard-device")
        expect(targets).to_contain("virtio-mouse-device")

        val used_observe = runtime.index_of("ARM64_DMA_READ_ONCE(dev->used.idx)") ?? -1
        val used_acquire = runtime.index_of("arm64_virtio_dma_acquire()", used_observe) ?? -1
        val payload_read = runtime.index_of("ARM64_DMA_READ_ONCE(dev->events[used_id].type)") ?? -1
        val avail_ring = runtime.index_of("ARM64_DMA_WRITE_ONCE(dev->avail.ring") ?? -1
        val avail_release = runtime.index_of("arm64_virtio_dma_release()", avail_ring) ?? -1
        val avail_publish = runtime.index_of("ARM64_DMA_WRITE_ONCE(dev->avail.idx", avail_release) ?? -1
        expect(used_acquire).to_be_greater_than(used_observe)
        expect(payload_read).to_be_greater_than(used_acquire)
        expect(avail_release).to_be_greater_than(avail_ring)
        expect(avail_publish).to_be_greater_than(avail_release)

        expect(backend).to_contain("pointer_frame_open")
        expect(backend).to_contain("pointer_frame_sequence")
        expect(backend).to_contain("pending_mouse_sequence = self.pointer_frame_sequence")
        expect(backend).to_contain("delivered_pointer_rel_x_seen")
        expect(backend).to_contain("delivered_pointer_rel_y_seen")
        expect(backend).to_contain("delivered_pointer_left_edge")
        expect(backend).to_contain("delivered_pointer_right_edge")
        expect(backend).to_contain("delivered_pointer_middle_edge")
        expect(entry).to_contain("input_compositor.input_sequence = pointer_sequence")
        val rel_x_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={EV_REL} code={REL_X} value={input_backend.delivered_pointer_rel_x} frame=raw-summary") ?? -1
        val rel_y_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={EV_REL} code={REL_Y} value={input_backend.delivered_pointer_rel_y} frame=raw-summary") ?? -1
        val left_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={EV_KEY} code={BTN_LEFT} value={input_backend.delivered_pointer_left_value} frame=raw-edge") ?? -1
        val right_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={EV_KEY} code={BTN_RIGHT} value={input_backend.delivered_pointer_right_value} frame=raw-edge") ?? -1
        val middle_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={EV_KEY} code={BTN_MIDDLE} value={input_backend.delivered_pointer_middle_value} frame=raw-edge") ?? -1
        val syn_receipt = entry.index_of("input_seq={pointer_sequence} device=pointer type={input_backend.delivered_pointer_type} code={input_backend.delivered_pointer_code} value={input_backend.delivered_pointer_value} frame=syn-report") ?? -1
        expect(rel_x_receipt).to_be_greater_than(-1)
        expect(rel_y_receipt).to_be_greater_than(-1)
        expect(left_receipt).to_be_greater_than(-1)
        expect(right_receipt).to_be_greater_than(-1)
        expect(middle_receipt).to_be_greater_than(-1)
        expect(syn_receipt).to_be_greater_than(-1)
        expect(rel_x_receipt).to_be_less_than(syn_receipt)
        expect(rel_y_receipt).to_be_less_than(syn_receipt)
        expect(left_receipt).to_be_less_than(syn_receipt)
        expect(right_receipt).to_be_less_than(syn_receipt)
        expect(middle_receipt).to_be_less_than(syn_receipt)
        expect(entry).to_contain("owner=InputBackend reason=live-qmp-evidence-pending")
        expect(entry.contains("[backend2d-event-ready]")).to_be(false)
        expect(entry.contains("reason=input-backend-trait-mouse-return-erased-to-any")).to_be(false)
        expect(entry).to_contain("[wm-pointer-poll] source=poll input_seq=")
        expect(entry).to_contain("[wm-key-state] input_seq=")
        expect(entry).to_contain("[wm-key-frame] input_seq=")
        expect(entry).to_contain("edge={key_edge}")
        expect(entry).to_contain("[theme-switch-blocker]")
        expect(entry.contains("[wm-pointer-irq]")).to_be(false)

    # @capture(protocol)
    # @capture(gui)
    # @capture(artifact)
    it "correlates QMP key edges and pointer events with guest state and frames":
        step("Boot the canonical ARM64 Engine2D production desktop")
        step("Inject keyboard down and up through QMP VirtIO input")
        step("Inject pointer move and button down and up through QMP VirtIO input")
        step("Observe guest-owned device receipt sequences")
        step("Require distinct press and release state/frame correlations")
        step("Correlate handled input with WM state and later framebuffer revisions")
        step("Capture baseline and post-input RAMFB images")
        require_arm64_live_qmp_input_evidence()
