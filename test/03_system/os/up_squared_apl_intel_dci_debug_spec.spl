"""
# UP Squared Apollo Lake DCI-safe load and storage policy

Executable contract coverage for REQ-006, REQ-007, REQ-009, and the admission
portion of REQ-010, plus REQ-013 free post-boot RAM access. Physical DCI
discovery, boot, and storage readback remain
hardware evidence gates and are not represented as passing assertions here.
"""

use std.spec.{describe, it, expect}
use os.kernel.arch.x86_64.up_squared.dci_mailbox.{
    DciCommitState, DciMailboxDescriptor, DciMemoryRange, DciLoadSegment,
    DciElfPlan, DciStorageIdentity, DciStorageWrite,
    dci_admit_mailbox, dci_admit_load_plan,
    dci_storage_confirmation, dci_admit_storage_write
}
use os.kernel.arch.x86_64.up_squared.gdb_rsp_monitor.{
    Up2RspOperation, up2_rsp_plan, up2_rsp_frame, up2_rsp_decode_frame
}
use std.fs_driver.block_device.{BlockDevice}
use std.fs_driver.mem_block_device.{MemBlockDevice}
use os.services.storage_image_provision.{
    storage_image_plan, storage_image_write_chunk, storage_image_flush,
    storage_image_verify_readback
}

val IMAGE_HASH: text = "31ce1fb45630f3442b9d789068fb13db8c66412428c71cee096e00ccc4e1fbdf"
val IMAGE_SIZE: u64 = 225152u64
val ZERO_SECTOR_HASH: text = "076a27c79e5ace2a3d47f9dd2e83e4ff6ea8872b3c2218f66c92b89b55f36560"
val ZERO_IMAGE_HASH: text = "5f70bf18a086007016e948b04aed3b82103a36bea41755b6cddfaf10ace3c6ef"

fn zero_sector() -> [u8]:
    var out: [u8] = []
    var index: i64 = 0
    while index < 512:
        out.push(0u8)
        index = index + 1
    out

fn descriptor(state: DciCommitState, generation: u64) -> DciMailboxDescriptor:
    DciMailboxDescriptor(
        schema_version: 1u32, generation: generation, nonce: 41u64,
        payload_size: IMAGE_SIZE, payload_sha256: IMAGE_HASH, state: state
    )

fn image_plan() -> DciElfPlan:
    DciElfPlan(entry: 0x08000038u64, segments: [
        DciLoadSegment(file_offset: 0x1000u64, file_size: 0x026719u64,
            physical_address: 0x08000000u64, memory_size: 0x026719u64,
            flags: 5u32, align: 0x1000u64),
        DciLoadSegment(file_offset: 0x28000u64, file_size: 0x001f9au64,
            physical_address: 0x08027000u64, memory_size: 0x001f9au64,
            flags: 4u32, align: 0x1000u64),
        DciLoadSegment(file_offset: 0x2a000u64, file_size: 0x00fau64,
            physical_address: 0x08029000u64, memory_size: 0x02fd7000u64,
            flags: 6u32, align: 0x1000u64)
    ])

fn disk(serial: text, mounted: bool) -> DciStorageIdentity:
    DciStorageIdentity(
        model: "UP2-LAB-DISK", serial: serial, transport: "usb-uas",
        capacity: 1073741824u64, root_device: false, swap_device: false,
        mounted: mounted, held: false
    )

describe "UP2 DCI RAM boot admission":
    it "accepts only a final replay-safe mailbox and the reviewed ELF layout":
        # @step: Stage payload bytes before publishing the final descriptor.
        val partial = dci_admit_mailbox(
            descriptor(DciCommitState.PayloadWritten, 2u64),
            1u64, 41u64, IMAGE_SIZE, IMAGE_HASH
        )
        expect(partial.accepted).to_equal(false)
        expect(partial.reason).to_equal("mailbox-not-committed")

        # @step: Commit the descriptor with a fresh generation, nonce, and hash.
        val committed = dci_admit_mailbox(
            descriptor(DciCommitState.Committed, 2u64),
            1u64, 41u64, IMAGE_SIZE, IMAGE_HASH
        )
        expect(committed.accepted).to_equal(true)

        # @step: Admit all physical ELF segments inside the published RAM window.
        val admitted = dci_admit_load_plan(
            IMAGE_SIZE,
            image_plan(),
            [DciMemoryRange(start: 0x08000000u64, size: 0x03000000u64)]
        )
        expect(admitted.accepted).to_equal(true)

describe "UP2 target-side storage admission":
    it "binds authorization to exact idle device identity and byte range":
        val observed = disk("UP2-TEST-001", false)
        val challenge = dci_storage_confirmation(
            observed, 1048576u64, 268435456u64, IMAGE_HASH
        )

        # @step: Reject a device whose exact serial changed after enumeration.
        val changed = disk("OTHER", false)
        val mismatch = dci_admit_storage_write(DciStorageWrite(
            observed: observed, expected: changed,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: challenge, persistent_allowed: true
        ))
        expect(mismatch.reason).to_equal("storage-identity-mismatch")

        # @step: Reject mounted media even when its identity and challenge match.
        val busy = disk("UP2-TEST-001", true)
        val busy_challenge = dci_storage_confirmation(
            busy, 1048576u64, 268435456u64, IMAGE_HASH
        )
        val busy_result = dci_admit_storage_write(DciStorageWrite(
            observed: busy, expected: busy,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: busy_challenge, persistent_allowed: true
        ))
        expect(busy_result.reason).to_equal("storage-device-busy")

        # @step: Admit the exact idle device only with persistent authorization.
        val accepted = dci_admit_storage_write(DciStorageWrite(
            observed: observed, expected: observed,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: challenge, persistent_allowed: true
        ))
        expect(accepted.accepted).to_equal(true)

    it "writes ordered image chunks and requires flush plus exact full readback":
        # @step: Create an isolated device and an aligned hash-bound image plan.
        val memory = MemBlockDevice.new(8u64, 512u32)
        val device: BlockDevice = memory
        val plan = storage_image_plan(
            512u32, 8u64, 512u64, 1024u64, ZERO_IMAGE_HASH).unwrap()
        var next_offset: u64 = 0u64

        # @step: Commit two ordered, independently hashed staging chunks.
        next_offset = storage_image_write_chunk(
            device, plan, next_offset, zero_sector(), ZERO_SECTOR_HASH).unwrap()
        next_offset = storage_image_write_chunk(
            device, plan, next_offset, zero_sector(), ZERO_SECTOR_HASH).unwrap()

        # @step: Cross the durability boundary and hash every byte from a fresh view.
        expect(storage_image_flush(device, plan, next_offset).unwrap()).to_equal(true)
        val fresh_device: BlockDevice = memory
        val proof = storage_image_verify_readback(fresh_device, plan).unwrap()
        expect(proof).to_contain("sha256=" + ZERO_IMAGE_HASH)
        expect(proof).to_contain("flush=pass fresh_readback=pass")

describe "UP2 free post-boot RAM loading":
    it "accepts only framed operations inside the loader-owned staging range":
        # @step: Establish an RSP session without advertising false run control.
        val supported = up2_rsp_plan("qSupported:multiprocess+")
        expect(supported.response).to_equal("PacketSize=1000")
        expect(up2_rsp_plan("g").response).to_equal("")
        expect(up2_rsp_plan("c").response).to_equal("")

        # @step: Decode one exact write inside the dedicated staging segment.
        val write_frame = up2_rsp_frame("M0a000000,4:53494d50")
        val decoded = up2_rsp_decode_frame(write_frame)
        expect(decoded.is_ok()).to_equal(true)
        val write = up2_rsp_plan(decoded.unwrap())
        expect(write.operation).to_equal(Up2RspOperation.WriteMemory)
        expect(write.data).to_equal([0x53u8, 0x49u8, 0x4du8, 0x50u8])

        # @step: Reject the same write outside loader-owned RAM.
        val outside = up2_rsp_plan("M09000000,4:53494d50")
        expect(outside.operation).to_equal(Up2RspOperation.Reply)
        expect(outside.response).to_equal("E02")
