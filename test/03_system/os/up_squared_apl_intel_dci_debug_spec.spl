"""
# UP Squared Apollo Lake DCI-safe load and storage policy

Executable contract coverage for REQ-006, REQ-007, REQ-009, and the admission
portion of REQ-010. Physical DCI discovery, boot, and storage readback remain
hardware evidence gates and are not represented as passing assertions here.
"""

use std.spec.{describe, it, expect}
use os.kernel.arch.x86_64.up_squared.dci_mailbox.{
    DciCommitState, DciMailboxDescriptor, DciMemoryRange, DciLoadSegment,
    DciElfPlan, DciStorageIdentity, DciStorageWrite,
    dci_admit_mailbox, dci_admit_load_plan,
    dci_storage_confirmation, dci_admit_storage_write
}

val IMAGE_HASH: text = "1840191f50d032d9c3b4af9b012d211ce01c1cd77b3315961a9e4b486c1c48f3"

fn descriptor(state: DciCommitState, generation: u64) -> DciMailboxDescriptor:
    DciMailboxDescriptor(
        schema_version: 1u32, generation: generation, nonce: 41u64,
        payload_size: 37280u64, payload_sha256: IMAGE_HASH, state: state
    )

fn image_plan() -> DciElfPlan:
    DciElfPlan(entry: 0x08000038u64, segments: [
        DciLoadSegment(file_offset: 0x1000u64, file_size: 0x4b6fu64,
            physical_address: 0x08000000u64, memory_size: 0x4b6fu64,
            flags: 5u32, align: 0x1000u64),
        DciLoadSegment(file_offset: 0x6000u64, file_size: 0x01feu64,
            physical_address: 0x08005000u64, memory_size: 0x01feu64,
            flags: 4u32, align: 0x1000u64),
        DciLoadSegment(file_offset: 0x7000u64, file_size: 0x008au64,
            physical_address: 0x08006000u64, memory_size: 0x0180d000u64,
            flags: 6u32, align: 0x1000u64)
    ])

fn disk(serial: text, mounted: bool) -> DciStorageIdentity:
    DciStorageIdentity(
        model: "UP2-LAB-DISK", serial: serial, transport: "usb-uas",
        capacity: 1073741824u64, root_device: false, swap_device: false,
        mounted: mounted, held: false
    )

describe "UP2 DCI RAM boot admission":
    it "accepts only a final replay-safe mailbox and the reviewed ELF layout":
        # @step: Stage payload bytes before publishing the final descriptor.
        val partial = dci_admit_mailbox(
            descriptor(DciCommitState.PayloadWritten, 2u64),
            1u64, 41u64, 37280u64, IMAGE_HASH
        )
        expect(partial.accepted).to_equal(false)
        expect(partial.reason).to_equal("mailbox-not-committed")

        # @step: Commit the descriptor with a fresh generation, nonce, and hash.
        val committed = dci_admit_mailbox(
            descriptor(DciCommitState.Committed, 2u64),
            1u64, 41u64, 37280u64, IMAGE_HASH
        )
        expect(committed.accepted).to_equal(true)

        # @step: Admit all physical ELF segments inside the published RAM window.
        val admitted = dci_admit_load_plan(
            37280u64,
            image_plan(),
            [DciMemoryRange(start: 0x08000000u64, size: 0x02000000u64)]
        )
        expect(admitted.accepted).to_equal(true)

describe "UP2 target-side storage admission":
    it "binds authorization to exact idle device identity and byte range":
        val observed = disk("UP2-TEST-001", false)
        val challenge = dci_storage_confirmation(
            observed, 1048576u64, 268435456u64, IMAGE_HASH
        )

        # @step: Reject a device whose exact serial changed after enumeration.
        val changed = disk("OTHER", false)
        val mismatch = dci_admit_storage_write(DciStorageWrite(
            observed: observed, expected: changed,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: challenge, persistent_allowed: true
        ))
        expect(mismatch.reason).to_equal("storage-identity-mismatch")

        # @step: Reject mounted media even when its identity and challenge match.
        val busy = disk("UP2-TEST-001", true)
        val busy_challenge = dci_storage_confirmation(
            busy, 1048576u64, 268435456u64, IMAGE_HASH
        )
        val busy_result = dci_admit_storage_write(DciStorageWrite(
            observed: busy, expected: busy,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: busy_challenge, persistent_allowed: true
        ))
        expect(busy_result.reason).to_equal("storage-device-busy")

        # @step: Admit the exact idle device only with persistent authorization.
        val accepted = dci_admit_storage_write(DciStorageWrite(
            observed: observed, expected: observed,
            byte_start: 1048576u64, byte_length: 268435456u64,
            image_size: 268435456u64, image_sha256: IMAGE_HASH,
            confirmation: challenge, persistent_allowed: true
        ))
        expect(accepted.accepted).to_equal(true)
