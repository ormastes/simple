"""# Catalog QEMU dispatch acceptance on a host process fixture

For SimpleOS maintainers checking the catalog planner and process seam: bind a
sealed plan from the production catalog, inspect its command, and dispatch it
through the production process owner. The child is an argv observer compiled
for this host. Its output proves the process received each ordered argument;
its exit and stderr prove the bounded facade returned the child's outcome.

This is `host-fixture` evidence. The observer is not QEMU, does not boot a guest,
and cannot satisfy CLI entrypoint, image-admission, live-guest, or QEMU timing
requirements.
The local C compiler and an admitted self-hosted Simple runner are prerequisites.
"""
# @tag: system, simpleos, qemu, host-fixture
# @manual_section: Sealed catalog command reaches the host process
# @evidence-display: links

use std.spec.*
use std.io_runtime.{cwd, getpid, mkdir_p, file_exists, file_write}
use app.io.mod.{process_run_timeout}
use os.qemu_cli_plan_v1.{
    qemu_cli_command_display_v1, qemu_cli_dispatch_command_v1,
    qemu_cli_dispatch_plan_v1
}
use os.qemu_launch_resources_v1.{qemu_launch_memory_mib_v1}
use os.port.simpleos_multiplatform_build.{simpleos_machine_target_projection}
use os.port.qemu_machine_plan_v1.{
    QemuAcceleratorV1, QemuAcceleratorRequestKindV1, QemuAcceleratorRequestV1,
    QemuHostResolutionV1, QemuLaunchPlanV1,
    qemu_machine_spec_from_lane_v1, qemu_machine_spec_from_named_lane_v1,
    qemu_launch_plan_bind_lane_parity_v1
}

val ARG_OBSERVER_SOURCE = "test/03_system/os/feature/qemu_argv_observer.c"
val IMAGE_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# @inline
fn compile_argv_observer_v1() -> text:
    val directory = cwd().replace("\\", "/") +
        "/build/test-artifacts/os/qemu-catalog-dispatch-" + getpid().to_text()
    if not mkdir_p(directory):
        fail("MissingEvidence: cannot create isolated QEMU host-fixture output " + directory)
        return ""
    val executable = directory + "/qemu-argv-observer.exe"
    val (_stdout, stderr, status) = process_run_timeout(
        "cc", ["-std=c11", "-O0", "-o", executable, ARG_OBSERVER_SOURCE], 30000)
    if status != 0 or not file_exists(executable):
        fail("MissingEvidence: host C argv observer did not compile: " + stderr)
        return ""
    executable

# @inline
fn setup_catalog_qemu_plan_for_target_v1(
    target_name: text, executable: text, require_native: bool
) -> QemuLaunchPlanV1:
    val target = simpleos_machine_target_projection(target_name)
    val request = QemuAcceleratorRequestV1(
        kind: if require_native: QemuAcceleratorRequestKindV1.Require else: QemuAcceleratorRequestKindV1.Auto,
        accelerator: if require_native: QemuAcceleratorV1.Kvm else: QemuAcceleratorV1.Tcg)
    val lane = target.default_qemu_lane()
    val spec = qemu_machine_spec_from_lane_v1(
        target, lane, IMAGE_DIGEST, qemu_launch_memory_mib_v1(lane.qemu_memory), request)
    val host = QemuHostResolutionV1(
        host_adapter_id: "host-process-fixture", executable_path: executable,
        firmware_path: "", available_accelerators: [QemuAcceleratorV1.Tcg])
    qemu_launch_plan_bind_lane_parity_v1(spec, host)

# @inline
fn setup_catalog_qemu_plan_v1(executable: text, require_native: bool) -> QemuLaunchPlanV1:
    setup_catalog_qemu_plan_for_target_v1("x86_64", executable, require_native)

# @inline
fn expected_observed_argv_v1(plan: QemuLaunchPlanV1) -> text:
    var result = ""
    var index = 0
    for arg in plan.argv_copy():
        result = result + "arg[{index}]={arg}\n"
        index = index + 1
    result

# @inline
fn setup_named_catalog_qemu_plan_v1(target_name: text, lane_name: text, executable: text) -> QemuLaunchPlanV1:
    val target = simpleos_machine_target_projection(target_name)
    val lane = target.qemu_lane_or_smoke(lane_name)
    val request = QemuAcceleratorRequestV1(
        kind: QemuAcceleratorRequestKindV1.Auto, accelerator: QemuAcceleratorV1.Tcg)
    val spec = qemu_machine_spec_from_named_lane_v1(
        target, lane, IMAGE_DIGEST, qemu_launch_memory_mib_v1(lane.qemu_memory), request)
    val host = QemuHostResolutionV1(
        host_adapter_id: "host-process-fixture", executable_path: executable,
        firmware_path: "", available_accelerators: [QemuAcceleratorV1.Tcg])
    qemu_launch_plan_bind_lane_parity_v1(spec, host)

describe "REQ-001 REQ-014 REQ-016 UP-AC-005: sealed catalog dispatch [host-fixture]":
    it "delivers each represented named lane's ordered argv to the actual host observer":
        # @req: REQ-001 REQ-014 REQ-016
        """The named-plan dispatch sends every catalog argument to a real
        child process. This fixture is neither QEMU nor guest boot evidence."""
        step("Compile one real argv observer for the named-route matrix")
        val executable = compile_argv_observer_v1()
        if executable != "":
            val target_names = ["x86_64", "x86_32", "riscv64", "riscv32"]
            val lane_names = ["x86_64-q35-pure-nvme-perf", "x86_32-initrd-fat32-smf", "riscv64-virtio-fat32-smf", "riscv32-virtio-fat32-smf"]
            for index in 0..lane_names.len():
                val lane = lane_names[index]
                step("Seal the named catalog command without reparsing display text")
                val plan = setup_named_catalog_qemu_plan_v1(target_names[index], lane, executable)
                expect(plan.admitted()).to_equal(true)
                expect(plan.sealed_valid()).to_equal(true)
                if plan.admitted() and plan.sealed_valid():
                    step("Dispatch and compare the child's actual ordered arguments")
                    val (stdout, stderr, status) = qemu_cli_dispatch_plan_v1(plan, 30000)
                    expect(file_write(executable + "." + lane + ".txt",
                        "plan_digest={plan.argv_digest()}\nexit={status}\nstdout:\n{stdout}\nstderr:\n{stderr}\n")).to_equal(true)
                    expect(status).to_equal(37)
                    expect(stderr.replace("\r\n", "\n")).to_equal("argv-observer: invoked\n")
                    expect(stdout.replace("\r\n", "\n")).to_equal(expected_observed_argv_v1(plan))

    it "should seal a dispatch command for every catalog default target":
        """Each advertised default architecture gives the dispatch owner a
        usable sealed command; the single child-process scenario below checks
        what one host process actually receives.
        """
        # @req REQ-001 REQ-014 REQ-016 UP-AC-005
        step("Resolve each catalog default QEMU lane")
        for target_name in ["x86_32", "x86_64", "arm32", "arm64", "riscv32", "riscv64"]:
            val plan = setup_catalog_qemu_plan_for_target_v1(
                target_name, "/host-fixture/qemu-argv-observer", false)
            expect(plan.admitted()).to_be(true)
            expect(plan.sealed_valid()).to_be(true)
            expect(plan.target_id()).to_equal(
                simpleos_machine_target_projection(target_name).canonical_name)
            val command = qemu_cli_dispatch_command_v1(plan)
            expect(command[0]).to_equal("/host-fixture/qemu-argv-observer")
            expect(command.slice(1)).to_equal(plan.argv_copy())
            expect(command).to_contain("-kernel")
            expect(command).to_contain("-smp")

    it "should deliver the inspected sealed argv to one real child process":
        """I can inspect the catalog launch and know which ordered argv the
        production process owner will give the child. The child's exit and
        stderr are checked as host-process evidence.
        """
        # @req REQ-001 REQ-014 REQ-016 UP-AC-005
        step("Build the isolated host argv observer")
        val executable = compile_argv_observer_v1()
        if executable != "":
            step("Resolve the catalog QEMU lane")
            val plan = setup_catalog_qemu_plan_v1(executable, false)
            expect(plan.admitted()).to_be(true)
            expect(plan.sealed_valid()).to_be(true)

            step("Inspect the sealed launch command")
            val command = qemu_cli_dispatch_command_v1(plan)
            expect(command[0]).to_equal(executable)
            expect(command.slice(1)).to_equal(plan.argv_copy())
            val posix_display = qemu_cli_command_display_v1(
                "linux", command[0], command.slice(1))
            val windows_display = qemu_cli_command_display_v1(
                "windows", command[0], command.slice(1))
            expect(posix_display).to_contain("'-kernel'")
            expect(windows_display).to_contain("\"-kernel\"")

            # @capture(exec): build/test-artifacts/os/qemu-catalog-dispatch-<pid>/qemu-argv-observer.exe.dispatch.txt
            step("Dispatch the sealed QEMU plan")
            val (stdout, stderr, status) = qemu_cli_dispatch_plan_v1(plan, 30000)
            step("Retain the child-observed argv, stderr, and exit status")
            val evidence = "plan_digest={plan.argv_digest()}\n" +
                "executable={executable}\nexit={status}\n" +
                "stdout:\n{stdout}\nstderr:\n{stderr}\n"
            expect(file_write(executable + ".dispatch.txt", evidence)).to_be(true)
            expect(status).to_equal(37)
            expect(stderr.replace("\r\n", "\n")).to_equal("argv-observer: invoked\n")
            expect(stdout.replace("\r\n", "\n")).to_equal(expected_observed_argv_v1(plan))

    it "should refuse an unsupported accelerator before process launch":
        """A native-only plan rejected by a TCG-only host has no command
        to dispatch, even when an executable path was supplied.
        """
        # @req REQ-014 REQ-016
        step("Resolve the catalog QEMU lane with an unavailable native accelerator")
        val plan = setup_catalog_qemu_plan_v1("/missing/qemu-system-x86_64", true)
        expect(plan.admitted()).to_be(false)
        step("Reject an unsupported launch shape")
        expect(qemu_cli_dispatch_command_v1(plan)).to_equal([])
        val (stdout, stderr, status) = qemu_cli_dispatch_plan_v1(plan, 1000)
        expect(stdout).to_equal("")
        expect(stderr).to_equal("QEMU dispatch rejected an unadmitted or invalid seal")
        expect(status).to_equal(-1)

    it "should reject an unbounded deadline before process launch":
        """The production process owner requires a finite deadline before
        it can dispatch a sealed command.
        """
        # @req REQ-014 REQ-016
        step("Resolve the catalog QEMU lane")
        val plan = setup_catalog_qemu_plan_v1("/missing/qemu-system-x86_64", false)
        expect(plan.admitted()).to_be(true)
        step("Reject a process deadline outside the allowed range")
        for timeout_ms in [0, 600001]:
            val (stdout, stderr, status) = qemu_cli_dispatch_plan_v1(plan, timeout_ms)
            expect(stdout).to_equal("")
            expect(stderr).to_equal("QEMU dispatch requires a timeout from 1 to 600000 ms")
            expect(status).to_equal(-1)
