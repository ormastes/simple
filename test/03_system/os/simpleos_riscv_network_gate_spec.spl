"""
## Purpose and audience
For SimpleOS RISC-V bring-up engineers verifying that the RV64/RV32 boot
handoff, packet/display/storage device gates, and the QEMU HTTP+DB smoke
scripts stay on the freestanding, Simple-owned code path rather than quietly
re-absorbing a hosted or fake-pass shortcut.
## Operator workflow
Run `bin/simple test test/03_system/os/simpleos_riscv_network_gate_spec.spl`
against a checked-out worktree; set `SIMPLEOS_RV64_HTTP_STORAGE_QEMU=1` to
additionally drive the live QEMU HTTP/storage/database gate end to end.
## Compatibility and limitations
The live QEMU scenario is skipped by default (no emulator on most hosts) and
only runs under the opt-in env var above; every other scenario is a static
source-contract check against the tracked kernel, runtime, and script files
and needs no emulator.
## Verification guidance and troubleshooting
A failure names the missing/changed source marker directly; re-run the single
scenario with `bin/simple run` to see the exact `expect(...)` that regressed,
and confirm the referenced file:line still carries the contract before
editing the assertion.
"""
# Lifecycle: doc/01_research/domain/riscv_gen2_hwir_foundation.md ;
# doc/03_plan/hardware/riscv/riscv_fpga_linux.md ;
# doc/04_architecture/os/kernel/riscv64_boot_dtb_capability_v1.md ;
# doc/05_design/os/loader/riscv32_sv32_tcb_transfer_owner_v1.md
# @manual_section: riscv_network_gate

extern fn rt_file_read_text(path: text) -> text
extern fn rt_env_get(key: text) -> text?
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

use std.nogc_sync_mut.http_server.{HttpResponse, HttpStatus, write_response, write_error}
use std.nogc_sync_mut.io.tcp.{TcpStream}

fn rv64_http_storage_live_enabled() -> bool:
    (rt_env_get("SIMPLEOS_RV64_HTTP_STORAGE_QEMU") ?? "") == "1"

describe "SimpleOS RISC-V network readiness gate":
    it "keeps the RV64 boot handoff freestanding and QEMU-memory explicit":
        # @req REQ-RISCV-NET-001
        # @capture(bit_table): boot.spl source markers for freestanding PMM wiring
        step("Inspect the RV64 boot source for freestanding PMM and heap wiring")
        val boot = rt_file_read_text("src/os/kernel/arch/riscv64/boot.spl")

        expect(boot).to_contain("extern fn log_raw_println(msg: text)")
        expect(boot).to_contain("use os.kernel.arch.riscv64.noalloc_pmm_runtime.{")
        expect(boot.index_of("extern fn rt_riscv_qemu_ram_base() -> u64")).to_equal(-1)  # oracle: index_of returns -1 for "not found"; the extern must be gone
        expect(boot.index_of("extern fn rt_riscv_noalloc_pmm_init(")).to_equal(-1)  # oracle: -1 = absent; PMM init must not be a raw extern anymore
        expect(boot).to_contain("rv64_noalloc_pmm_initialize(")
        expect(boot).to_contain("riscv_noalloc_heap_init(")
        expect(boot).to_contain("rv64_qemu_ram_base()")
        expect(boot).to_contain("rv64_qemu_heap_start()")
        expect(boot).to_contain("os_main()")
        expect(boot.index_of("use os.kernel.log.klog_api")).to_equal(-1)  # oracle: -1 = absent; hosted klog must not leak into the boot path
        expect(boot.index_of("riscv_boot_mem_init")).to_equal(-1)  # oracle: -1 = absent; the legacy memory-init helper must be fully replaced

    it "keeps hosted boot logging out of the HTTP handoff closure":
        # @req REQ-RISCV-NET-002
        # @capture(bit_table): os_main/services/http source markers for logging boundary
        step("Inspect boot, services, and HTTP source for the logging boundary")
        val os_main = rt_file_read_text("src/os/kernel/boot/os_main.spl")
        val services = rt_file_read_text("src/os/kernel/boot/riscv_services.spl")
        val http = rt_file_read_text("src/os/kernel/boot/http_baremetal.spl")

        expect(os_main).to_contain("extern fn log_raw_println(msg: text)")
        expect(services).to_contain("extern fn log_raw_println(msg: text)")
        expect(http).to_contain("extern fn log_raw_println(msg: text)")
        expect(os_main.index_of("use os.kernel.log.klog_api")).to_equal(-1)  # oracle: -1 = absent; os_main must not import the hosted logger
        expect(services.index_of("use os.kernel.log.klog_api")).to_equal(-1)  # oracle: -1 = absent; services must not import the hosted logger
        expect(http.index_of("use os.kernel.log.klog_api")).to_equal(-1)  # oracle: -1 = absent; the HTTP closure must not import the hosted logger

    it "keeps only the low-level C runtime bridge and Simple-owned PMM ABI":
        # @req REQ-RISCV-NET-003
        # @capture(bit_table): freestanding runtime + PMM source markers
        step("Inspect the freestanding C runtime and Simple-owned PMM ABI boundary")
        val runtime = rt_file_read_text("src/os/kernel/arch/riscv64/boot/freestanding_runtime.c")
        val pmm_runtime = rt_file_read_text("src/os/kernel/arch/riscv64/noalloc_pmm_runtime.spl")
        val pmm_policy = rt_file_read_text("src/os/kernel/boot/riscv_noalloc_pmm.spl")

        expect(runtime).to_contain("void unsafe(void)")
        expect(runtime).to_contain("spl_u64 rt_riscv_noalloc_alloc_page(void);")
        expect(runtime.contains("spl_i64 rt_riscv_noalloc_pmm_init(")).to_be(false)
        expect(runtime.contains("static spl_u64 g_riscv_pmm_base")).to_be(false)
        expect(pmm_runtime).to_contain("@export(\"C\", name: \"rt_riscv_noalloc_pmm_init\")\nfn rv64_noalloc_pmm_initialize(")
        expect(pmm_runtime).to_contain("@export(\"C\", name: \"rt_riscv_qemu_ram_base\")\nfn rv64_qemu_ram_base() -> u64:")
        expect(pmm_runtime).to_contain("@extern(\"runtime\", \"rt_riscv_uart_put\")\nfn _riscv_uart_put_raw(byte: u64)")
        expect(pmm_policy).to_contain("fn riscv_noalloc_pmm_init(")
        expect(runtime).to_contain("RT_PCI_IO_BASE")
        expect(runtime).to_contain("#define RT_PCI_MAX_DEVICES 32")
        expect(runtime).to_contain("RT_VIRTIO_NET_TX_QUEUE")
        expect(runtime).to_contain("rt_submit_tx_probe")
        expect(runtime).to_contain("RT_NET_RX_POST_COUNT")
        expect(runtime).to_contain("RT_VIRTIO_GPU_LEGACY_DEVICE_ID")
        expect(runtime).to_contain("RT_PCI_LEGACY_GPU_IO_PORT")
        expect(runtime).to_contain("RT_VIRTIO_BLK_LEGACY_DEVICE_ID")
        expect(runtime).to_contain("RT_PCI_LEGACY_BLK_IO_PORT")
        expect(runtime).to_contain("RT_NVFS_MAGIC")
        expect(runtime).to_contain("rt_gpu_cmd_get_display_info")
        expect(runtime).to_contain("rt_gpu_cmd_transfer_flush")
        expect(runtime).to_contain("spl_i64 rt_storage_init(void)")
        expect(runtime).to_contain("spl_i64 rt_storage_read_probe(void)")
        expect(runtime).to_contain("spl_i64 rt_time_now_unix_micros(void)")
        expect(runtime).to_contain("spl_u64 rt_riscv_seed(void)")
        expect(runtime).to_contain("static spl_u64 g_freestanding_heap_next = 0x87000000ULL;")
        expect(runtime).to_contain("static spl_u64 g_freestanding_heap_limit = 0x88000000ULL;")
        expect(runtime).to_contain("bytes = rt_align8((spl_u64)size);")
        expect(runtime).to_contain("if (next + bytes > g_freestanding_heap_limit)")
        expect(runtime).to_contain("g_freestanding_heap_next = next + bytes;")
        expect(runtime).to_contain("return (void *)next;")
        expect(runtime.contains("boot_alloc")).to_be(false)
        expect(runtime.contains("kernel__boot__riscv_noalloc_heap__riscv_noalloc_heap_alloc")).to_be(false)
        expect(runtime).to_contain("rt_entropy_hardware_ready(void)")
        expect(runtime).to_contain("return 0;")

    it "requires packet TX and RX readiness before reporting network ready":
        # @req REQ-RISCV-NET-004
        # @capture(bit_table): riscv_services.spl packet gate ordering markers
        step("Require every packet and socket facade gate before readiness")
        val services = rt_file_read_text("src/os/kernel/boot/riscv_services.spl")

        expect(services).to_contain("extern fn rt_net_tx_test() -> i64")
        expect(services).to_contain("extern fn rt_net_rx_ready() -> i64")
        expect(services).to_contain("val device_id = rt_pci_get_field(i, 6)")
        expect(services).to_contain("device_id == 0x1000 or device_id == 0x1041")
        expect(services).to_contain("val tx_rc = rt_net_tx_test()")
        expect(services).to_contain("val rx_rc = rt_net_rx_ready()")
        expect(services).to_contain("[net-riscv] Network packet TX unavailable rc=")
        expect(services).to_contain("[net-riscv] Network packet TX ready")
        expect(services).to_contain("[net-riscv] Network packet RX unavailable rc=")
        expect(services).to_contain("network_ok = 1")

        val tx_probe = services.find("val tx_rc = rt_net_tx_test()")
        val rx_probe = services.find("val rx_rc = rt_net_rx_ready()")
        val ready_set = services.find("network_ok = 1")
        expect(tx_probe).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the TX probe line must exist in the file
        expect(rx_probe).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the RX probe line must exist in the file
        expect(rx_probe).to_be_greater_than(tx_probe)
        expect(ready_set).to_be_greater_than(rx_probe)

    it "keeps the freestanding runtime on real virtio packet IO":
        # @req REQ-RISCV-NET-005
        # @capture(bit_table): freestanding runtime virtio packet IO markers
        step("Inspect the freestanding runtime for real virtio packet IO wiring")
        val runtime = rt_file_read_text("src/os/kernel/arch/riscv64/boot/freestanding_runtime.c")

        expect(runtime).to_contain("spl_i64 rt_net_tx_test(void)")
        expect(runtime).to_contain("spl_i64 rt_net_rx_ready(void)")
        expect(runtime).to_contain("RT_VIRTIO_NET_LEGACY_DEVICE_ID")
        expect(runtime).to_contain("RT_VIRTIO_NET_MODERN_DEVICE_ID")
        expect(runtime).to_contain("rt_pci_is_virtio_net")
        expect(runtime).to_contain("rt_poll_rx_once")
        expect(runtime).to_contain("rt_process_rx_frame")
        expect(runtime).to_contain("rt_process_tcp")
        expect(runtime).to_contain("rt_send_arp_reply")
        expect(runtime).to_contain("rt_send_tcp_packet")
        expect(runtime).to_contain("fallback_json_response")
        expect(runtime).to_contain("fallback_html_response")

    it "uses a real virtio-gpu control queue for display readiness":
        # @req REQ-RISCV-NET-006
        # @capture(bit_table): virtio-gpu control queue and display-service markers
        step("Inspect the virtio-gpu control queue and display service wiring")
        val runtime = rt_file_read_text("src/os/kernel/arch/riscv64/boot/freestanding_runtime.c")
        val services = rt_file_read_text("src/os/kernel/boot/riscv_services.spl")
        val script = rt_file_read_text("scripts/qemu/qemu_rv64_http_test.shs")

        expect(runtime).to_contain("spl_i64 rt_display_init(void)")
        expect(runtime).to_contain("rt_pci_is_virtio_gpu")
        expect(runtime).to_contain("RT_VIRTIO_GPU_MODERN_DEVICE_ID")
        expect(runtime).to_contain("rt_gpu_setup_modern")
        expect(runtime).to_contain("RT_VIRTIO_MODERN_QUEUE_DESC_LO")
        expect(runtime).to_contain("RT_GPU_CMD_GET_DISPLAY_INFO")
        expect(runtime).to_contain("RT_GPU_CMD_RESOURCE_CREATE_2D")
        expect(runtime).to_contain("RT_GPU_CMD_RESOURCE_ATTACH_BACKING")
        expect(runtime).to_contain("RT_GPU_CMD_SET_SCANOUT")
        expect(runtime).to_contain("RT_GPU_CMD_TRANSFER_TO_HOST_2D")
        expect(runtime).to_contain("RT_GPU_CMD_RESOURCE_FLUSH")
        expect(runtime).to_contain("rt_gpu_fill_test_pattern")
        expect(runtime).to_contain("return g_rt_display_ready ? RT_GPU_WIDTH : 0;")
        expect(runtime).to_contain("return g_rt_display_ready ? RT_GPU_HEIGHT : 0;")
        expect(runtime.contains("rt_gpu_fill_test_pattern")).to_be(false)
        expect(runtime.index_of("spl_i64 rt_display_init(void) {\n    return -1;")).to_equal(-1)  # oracle: -1 = absent; display init must not be a stub returning -1
        expect(services).to_contain("[display-riscv] Display unavailable")
        expect(services).to_contain("riscv_display_width = riscv64_display_width()")
        expect(services.contains("riscv64_display_present()")).to_equal(false)
        expect(services).to_contain("[display-riscv] Display service ready: {riscv_display_width}x{riscv_display_height} framebuffer")
        expect(script).to_contain("--with-display")
        expect(script).to_contain("virtio-gpu-pci,disable-modern=on,disable-legacy=off")
        expect(script).to_contain("Display service ready")

    it "uses a real virtio-blk queue, NVFS superblock, and arena payload for storage readiness":
        # @req REQ-RISCV-NET-007
        # @capture(bit_table): virtio-blk queue and NVFS storage-service markers
        step("Inspect the virtio-blk queue, NVFS superblock, and storage service wiring")
        val runtime = rt_file_read_text("src/os/kernel/arch/riscv64/boot/freestanding_runtime.c")
        val services = rt_file_read_text("src/os/kernel/boot/riscv_services.spl")
        val script = rt_file_read_text("scripts/qemu/qemu_rv64_http_test.shs")

        expect(runtime).to_contain("RT_VIRTIO_BLK_LEGACY_DEVICE_ID")
        expect(runtime).to_contain("RT_VIRTIO_BLK_MODERN_DEVICE_ID")
        expect(runtime).to_contain("RT_VIRTIO_BLK_QUEUE")
        expect(runtime).to_contain("VIRTIO_BLK_T_IN")
        expect(runtime).to_contain("rt_pci_is_virtio_blk")
        expect(runtime).to_contain("rt_storage_read_sector")
        expect(runtime).to_contain("rt_storage_probe_nvfs_superblock")
        expect(runtime).to_contain("rt_storage_sector_has_nvfs_superblock")
        expect(runtime).to_contain("RT_NVFS_MAGIC")
        expect(runtime).to_contain("RT_NVFS_VERSION")
        expect(runtime).to_contain("RT_VIRTQ_DESC_F_NEXT | RT_VIRTQ_DESC_F_WRITE")
        expect(runtime).to_contain("rt_io_write16(g_rt_blk_bar0, RT_VIRTIO_PCI_QUEUE_NOTIFY, RT_VIRTIO_BLK_QUEUE)")
        expect(runtime.index_of("spl_i64 rt_storage_init(void) {\n    return -1;")).to_equal(-1)  # oracle: -1 = absent; storage init must not be a stub returning -1
        expect(services).to_contain("extern fn rt_storage_init() -> i64")
        expect(services).to_contain("extern fn rt_storage_read_probe() -> i64")
        expect(services).to_contain("extern fn rt_storage_nvfs_ready() -> i64")
        expect(services).to_contain("[storage-riscv] Storage unavailable rc=")
        expect(services).to_contain("[storage-riscv] NVFS superblock probe passed")
        expect(services).to_contain("[storage-riscv] Storage service ready")
        expect(services).to_contain("fn riscv_storage_ready() -> bool")
        expect(services).to_contain("[fs-riscv] NVFS root superblock ready")
        expect(services).to_contain("[init] filesystem: nvfs-superblock-ready")
        expect(services).to_contain("fn riscv_filesystem_ready() -> bool")
        expect(script).to_contain("--with-storage")
        expect(script).to_contain("virtio-blk-pci,drive=blk0")
        expect(script).to_contain("\\123\\106\\126\\116\\002\\000\\000\\000")
        expect(script).to_contain("Storage service ready")
        expect(script).to_contain("NVFS root superblock ready")

    it "routes weak C TCP fallbacks through the boot packet provider":
        # @req REQ-RISCV-NET-008
        # @capture(bit_table): weak-symbol TCP fallback markers
        step("Inspect the weak-symbol TCP fallbacks for the boot packet provider route")
        val runtime = rt_file_read_text("src/os/kernel/arch/riscv64/boot/freestanding_runtime.c")

        expect(runtime).to_contain("__attribute__((weak)) spl_i64 rt_io_tcp_bind")
        expect(runtime).to_contain("__attribute__((weak)) spl_i64 rt_io_tcp_write_text")
        expect(runtime).to_contain("__attribute__((weak)) spl_i64 rt_io_tcp_close")
        expect(runtime.index_of("return text ? (spl_i64)text->len : -1;")).to_equal(-1)  # oracle: -1 = absent; the weak fallback must not fake a byte-count success
        expect(runtime).to_contain("return rt_boot_tcp_bind(addr);")
        expect(runtime).to_contain("return rt_boot_tcp_accept_timeout(fd, ms);")
        expect(runtime).to_contain("return rt_boot_tcp_write_text(fd, data);")
        expect(runtime).to_contain("return rt_boot_tcp_close(fd) == 0 ? 11 : 19;")

    it "keeps netstack init unavailable until packet TX and RX are ready":
        # @req REQ-RISCV-NET-009
        # @capture(bit_table): netstack_init.spl readiness gate ordering markers
        step("Require the netstack init readiness gate to sequence TX then RX")
        val net_init = rt_file_read_text("src/os/services/netstack/netstack_init.spl")

        expect(net_init).to_contain("extern fn rt_net_tx_test() -> i64")
        expect(net_init).to_contain("extern fn rt_net_rx_ready() -> i64")
        expect(net_init).to_contain("val tx_ready = rt_net_tx_test()")
        expect(net_init).to_contain("val rx_ready = rt_net_rx_ready()")
        expect(net_init).to_contain("[net-init] C network TX unavailable rc=")
        expect(net_init).to_contain("[net-init] C network RX unavailable rc=")
        expect(net_init).to_contain("g_net_initialized = true")

        val tx_probe = net_init.find("val tx_ready = rt_net_tx_test()")
        val rx_probe = net_init.find("val rx_ready = rt_net_rx_ready()")
        val ready_set = net_init.find("g_net_initialized = true")
        expect(tx_probe).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the TX probe line must exist
        expect(rx_probe).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the RX probe line must exist
        expect(rx_probe).to_be_greater_than(tx_probe)
        expect(ready_set).to_be_greater_than(rx_probe)

    it "fails closed in the baremetal IoDriver shim until packet TX and RX are ready":
        # @req REQ-RISCV-NET-010
        # @capture(bit_table): driver_shim.spl fail-closed IoDriver markers
        step("Require the baremetal IoDriver shim to fail closed until packets are ready")
        val shim = rt_file_read_text("src/os/kernel/net/driver_shim.spl")

        expect(shim).to_contain("extern fn rt_net_tx_test() -> i64")
        expect(shim).to_contain("extern fn rt_net_rx_ready() -> i64")
        expect(shim).to_contain("fn driver_shim_packet_io_ready() -> bool")
        expect(shim).to_contain("rt_net_tx_test() == 0 and rt_net_rx_ready() == 0")
        expect(shim).to_contain("rt_io_tcp_write_text(fd, data)")
        expect(shim).to_contain("if written < 0:\n        return -1")
        expect(shim).to_contain("result_val: written")
        expect(shim).to_contain("if not driver_shim_packet_io_ready():\n        return -1")
        expect(shim).to_contain("if not driver_shim_packet_io_ready():\n        return RT_LINK_STATE_UNKNOWN")
        expect(shim).to_contain("if not driver_shim_packet_io_ready():\n        return \"\"")
        expect(shim.index_of("data discarded")).to_equal(-1)  # oracle: -1 = absent; discarding data silently must not survive
        expect(shim.index_of("baremetal always reports UP")).to_equal(-1)  # oracle: -1 = absent; the shim must not hardcode a link-up lie

    it "does not let TCP shims fake listener or write success without netstack":
        # @req REQ-RISCV-NET-011
        # @capture(bit_table): tcp_shim.spl fake-success rejection markers
        step("Require the TCP shim to reject fake listener and write success")
        val shim = rt_file_read_text("src/os/kernel/net/tcp_shim.spl")

        expect(shim).to_contain("No fake listener is created")
        expect(shim).to_contain("if not net_tcp_available():\n        return -1")
        expect(shim.index_of("g_next_os_fd")).to_equal(-1)  # oracle: -1 = absent; a synthetic fd counter would be a fake listener
        expect(shim.index_of("data.len().to_i64()")).to_equal(-1)  # oracle: -1 = absent; echoing byte-count would fake a successful write
        expect(shim).to_contain("Returns -1 if the fd is invalid or the netstack is unavailable")

    it "lets the sync HTTP server serve inline when thread spawn is unavailable":
        # @req REQ-RISCV-NET-012
        # @capture(bit_table): sync HTTP server inline-fallback markers
        step("Require the sync HTTP server to fall back to inline handling")
        val server = rt_file_read_text("src/lib/nogc_sync_mut/http_server/server.spl")
        val response = rt_file_read_text("src/lib/nogc_sync_mut/http_server/response.spl")

        expect(server).to_contain("val handler = thread_spawn_with_args(stream, self")
        expect(server).to_contain("if handler.handle < 0:")
        expect(server).to_contain("if not self.admission.try_acquire():")
        expect(server).to_contain("SimpleHttpServer.handle_connection_admitted(self, stream)")
        expect(server).to_contain("defer server.admission.release()")
        expect(server).to_contain("if not write_response(stream, resp):")
        expect(response).to_contain("match stream.write_text(wire):")
        expect(server).to_contain("handler.free()")

    it "reports sync HTTP response write failure on fail-closed TCP streams":
        # @req REQ-RISCV-NET-013
        # @capture(bit_table): fail-closed TCP stream write-failure result
        step("Drive a write on a fail-closed TCP stream (fd: -1)")  # oracle: fd -1 is the fail-closed sentinel this scenario exercises
        val stream = TcpStream(fd: -1, open: true)

        expect(write_response(stream, HttpResponse.ok("hello"))).to_equal(false)
        expect(write_error(stream, HttpStatus.BadRequest, "bad request")).to_equal(false)

    it "keeps the boot-local TCP shim delegated to the packet provider":
        # @req REQ-RISCV-NET-014
        # @capture(bit_table): boot-local TCP shim delegation markers
        step("Inspect the boot-local TCP shim for packet-provider delegation")
        val boot_shim = rt_file_read_text("src/os/kernel/boot/tcp_baremetal_min.spl")

        expect(boot_shim).to_contain("extern fn rt_boot_tcp_bind(addr: text) -> i64")
        expect(boot_shim).to_contain("fn rt_io_tcp_bind(addr: text) -> i64:\n    rt_boot_tcp_bind(addr)")
        expect(boot_shim).to_contain("fn rt_io_tcp_write_text(fd: i64, data: text) -> i64:\n    rt_boot_tcp_write_text(fd, data)")

fn expect_qemu_deferred_script_contract(path: text):
    val script = rt_file_read_text(path)

    expect(script).to_contain("--expect-deferred")
    expect(script).to_contain("EXPECT_DEFERRED=true")
    expect(script).to_contain("HTTP server deferred")
    expect(script).to_contain("Entering boot idle loop")
    expect(script).to_contain("DEFERRED PASSED")
    expect(script).to_contain("network reached ready state in deferred mode")
    expect(script).to_contain("[http_baremetal] Listening on 0.0.0.0:8080")
    expect(script.index_of("Bootstrap TCP shim bound on 0.0.0.0:8080")).to_equal(-1)  # oracle: -1 = absent; the bootstrap shim banner must not leak into deferred mode

    val deferred_marker = script.find("--expect-deferred")
    val http_tests = script.find("Running HTTP smoke tests")
    expect(deferred_marker).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the deferred flag must exist in the script
    expect(http_tests).to_be_greater_than(deferred_marker)

describe "SimpleOS RISC-V QEMU HTTP scripts":
    it "requires live POST database state evidence beyond boot readiness":
        """A passing boot must use the canonical HTTP listener, preserve one
        database service across requests, execute CREATE then INSERT then
        SELECT in that order, retain every HTTP response, and reject evidence
        that contains only boot-readiness markers."""
        # @req REQ-RISCV-NET-015
        # @capture(bit_table): live POST database request/response ordering evidence
        step("Inspect the live guest request client")
        val smoke = rt_file_read_text("scripts/qemu/qemu_rv64_http_test.shs")
        val checker = rt_file_read_text("scripts/qemu/check_simpleos_rv64_db_server.shs")
        val service = rt_file_read_text("src/os/services/database/simple_db_service.spl")
        val listener = rt_file_read_text("src/os/kernel/boot/http_baremetal.spl")

        expect(smoke).to_contain("--with-db")
        expect(smoke).to_contain("WITH_DB=true\n      WITH_STORAGE=true")
        expect(smoke).to_contain("printf 'POST /db HTTP/1.0")
        expect(smoke).to_contain("printf '%s\\n' \"$DB_RESPONSE\" > \"$DB_QUERY_LOG\"")
        expect(smoke).to_contain("[ ! \"$BUILD_STAMP\" -nt \"$ELF\" ]")
        expect(smoke).to_contain("^simple_bin=.*(compiler_rust|simple_seed)")
        expect(checker).to_contain("[http_baremetal] Listening on 0.0.0.0:8080")
        expect(listener).to_contain("[http_baremetal] Listening on 0.0.0.0:8080")
        expect(checker.index_of("Bootstrap TCP shim bound on 0.0.0.0:8080")).to_equal(-1)  # oracle: -1 = absent; the bootstrap shim banner must not leak into the live-DB path
        expect(service).to_contain("var g_simple_db_service: SimpleDbService = SimpleDbService(tables: [], rows: [])")
        expect(listener).to_contain("simple_db_execute_http_request(request)")
        expect(listener.index_of("SimpleDbService.new()")).to_equal(-1)  # oracle: -1 = absent; the listener must reuse the shared service, not construct a fresh one per request

        step("Require CREATE INSERT and SELECT in one boot session")
        val create = smoke.find("db_request 'CREATE codex'")
        val insert = smoke.find("db_request 'INSERT codex answer codex-41'")
        val select = smoke.find("db_request 'SELECT codex answer'")
        expect(create).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; the CREATE request must exist in the script
        expect(insert).to_be_greater_than(create)
        expect(select).to_be_greater_than(insert)

        step("Reject readiness-only retained evidence")
        expect(checker).to_contain("[ -f \"$db_query_log\" ] || fail \"db_query_log_missing\"")
        expect(checker).to_contain("grep -c 'HTTP/1.1 200 OK' \"$db_query_log\"")
        expect(checker).to_contain("grep -q 'OK CREATE' \"$db_query_log\"")
        expect(checker).to_contain("grep -q 'OK INSERT' \"$db_query_log\"")
        expect(checker).to_contain("fail \"db_negative_content_length\"")
        val readiness = checker.find("pass \"serial_live_request_path_ready\"")
        val selected_value = checker.find("grep -q 'codex-41' \"$db_query_log\"")
        val connected = checker.find("pass \"simpleos_rv64_db_server_connected\"")
        expect(readiness).to_be_greater_than(-1)  # oracle: find() returns -1 on miss; readiness-only evidence must be present as a baseline marker
        expect(selected_value).to_be_greater_than(readiness)
        expect(connected).to_be_greater_than(selected_value)

    it "keeps the RV64 smoke script explicit about the deferred boundary":
        # @req REQ-RISCV-NET-016
        # @capture(bit_table): RV64 smoke script deferred-boundary markers
        step("Require the RV64 smoke script to state the deferred boundary explicitly")
        expect_qemu_deferred_script_contract("scripts/qemu/qemu_rv64_http_test.shs")
        val script = rt_file_read_text("scripts/qemu/qemu_rv64_http_test.shs")

        expect(script).to_contain("build/os/simpleos_riscv64.elf")
        expect(script).to_contain("--allow-prebuilt-artifact")
        expect(script).to_contain("current-source build stamp not found")
        expect(script).to_contain("as current-source RV64 QEMU evidence")
        expect(script).to_contain("Build it first through the SimpleOS runner with an LLVM-enabled compiler")
        expect(script).to_contain("bin/simple os build --arch=riscv64")
        expect(script).to_contain("backend=llvm")
        expect(script).to_contain("target=riscv64-unknown-none")
        expect(script).to_contain("entry=src/os/kernel/arch/riscv64/boot.spl")
        expect(script).to_contain("--expect-http-only")
        expect(script).to_contain("EXPECT_HTTP_ONLY=true")
        expect(script).to_contain("PMM OK")
        expect(script).to_contain("HEAP OK")
        expect(script).to_contain("Network packet TX ready")
        expect(script).to_contain("Network packet RX unavailable")
        expect(script).to_contain("RISC-V TLS not production-ready")
        expect(script.index_of("scripts/os/simpleos-native-build.shs --target riscv64gc-unknown-none")).to_equal(-1)  # oracle: -1 = absent; the stale gc-suffixed target string must be gone

    it "keeps the RV32 smoke script explicit about the deferred boundary":
        # @req REQ-RISCV-NET-017
        # @capture(bit_table): RV32 smoke script deferred-boundary markers
        step("Require the RV32 smoke script to state the deferred boundary explicitly")
        expect_qemu_deferred_script_contract("scripts/qemu/qemu_rv32_http_test.shs")

    it "documents the real LLVM-backed RV32 build prerequisite":
        # @req REQ-RISCV-NET-018
        # @capture(bit_table): RV32 LLVM build-prerequisite markers
        step("Inspect the RV32 smoke script for the LLVM build prerequisite")
        val script = rt_file_read_text("scripts/qemu/qemu_rv32_http_test.shs")

        expect(script).to_contain("Build it first with an LLVM-enabled compiler")
        expect(script).to_contain("--backend llvm")
        expect(script).to_contain("--target riscv32-unknown-none")
        expect(script.index_of("riscv32gc-unknown-none")).to_equal(-1)  # oracle: -1 = absent; the stale gc-suffixed target string must be gone

    it "maps current RV32 backend failures to actionable prerequisites":
        # @req REQ-RISCV-NET-019
        # @capture(bit_table): RV32 backend-failure prerequisite messages
        step("Inspect the QEMU runner for actionable RV32 backend-failure messages")
        val runner = rt_file_read_text("src/os/_QemuRunner/runner_targets.spl")

        expect(runner).to_contain("native backend 'llvm' is not available")
        expect(runner).to_contain("Cranelift native builds do not support hosted riscv32 yet")
        expect(runner).to_contain("LLVM backend unavailable: rebuild the selected Simple compiler")

    it "runs the RV64 HTTP, NVFS storage, and database QEMU gate when explicitly enabled":
        # @req REQ-RISCV-NET-020
        # @capture(bit_table): live RV64 HTTP/storage/database QEMU gate output
        step("Run the RV64 HTTP, NVFS storage, and database QEMU gate when opted in")
        val script = rt_file_read_text("scripts/qemu/qemu_rv64_http_test.shs")

        expect(script).to_contain("--expect-http-only")
        expect(script).to_contain("--with-storage")
        expect(script).to_contain("WARNING: --allow-prebuilt-artifact gives smoke-only evidence")
        expect(script).to_contain("Storage service ready")
        expect(script).to_contain("NVFS root superblock ready")

        if rv64_http_storage_live_enabled():
            val result = rt_process_run_timeout(
                "sh",
                ["scripts/qemu/qemu_rv64_http_test.shs", "--expect-http-only", "--with-storage"],
                90000,
            )
            val output = result[0] + result[1]

            expect(result[2]).to_equal(0)  # oracle: rt_process_run_timeout's 3rd tuple slot is the process exit code; 0 = success
            expect(output).to_contain("HTTP-only PASSED")
            expect(output).to_contain("Storage service verified")
            expect(output).to_contain("NVFS root superblock verified")
            expect(output).to_contain("GET /health (HTTP)... PASS (200)")
            expect(output).to_contain("GET / (HTTP)... PASS (200)")
            expect(output).to_contain("SKIP (HTTP-only gate; RISC-V TLS not production-ready)")
            expect(output).to_contain("GET /health content-type... PASS (JSON)")
            expect(output).to_contain("GET / content-type... PASS (HTML)")

            val checker_result = rt_process_run_timeout(
                "sh",
                [
                    "scripts/qemu/check_simpleos_rv64_db_server.shs",
                    "--artifacts", "build/test-artifacts/simpleos-rv64-http-db-live",
                ],
                10000,
            )
            val checker_output = checker_result[0] + checker_result[1]
            expect(checker_result[2]).to_equal(0)  # oracle: rt_process_run_timeout's 3rd tuple slot is the process exit code; 0 = success
            expect(checker_output).to_contain("PASS simpleos_rv64_db_server_connected")
        else:
            print "SKIP: set SIMPLEOS_RV64_HTTP_STORAGE_QEMU=1 to run live RV64 HTTP+NVFS QEMU gate"

fn expect_no_fake_network_pass(path: text):
    val source = rt_file_read_text(path)

    expect(source.index_of("_assert(true, \"Network")).to_equal(-1)  # oracle: -1 = absent; a hardcoded true is a no-crash placeholder, not a real check
    expect(source.index_of("_assert(true, \"TCP socket")).to_equal(-1)  # oracle: -1 = absent; a hardcoded true is a no-crash placeholder, not a real check
    expect(source.index_of("_assert(true, \"UDP socket")).to_equal(-1)  # oracle: -1 = absent; a hardcoded true is a no-crash placeholder, not a real check
    expect(source.index_of("_assert(true, \"Bind call")).to_equal(-1)  # oracle: -1 = absent; a hardcoded true is a no-crash placeholder, not a real check
    expect(source.index_of("_assert(true, \"TCP connect")).to_equal(-1)  # oracle: -1 = absent; a hardcoded true is a no-crash placeholder, not a real check
    expect(source).to_contain("_assert(tcp_fd >= 0")
    expect(source).to_contain("_assert(udp_fd >= 0")

describe "SimpleOS QEMU network entrypoint gates":
    it "does not report os_network success for query/no-crash socket placeholders":
        # @req REQ-RISCV-NET-021
        # @capture(bit_table): os_network_spec.spl real-assertion markers
        step("Require os_network_spec assertions to be real, not no-crash placeholders")
        expect_no_fake_network_pass("test/03_system/os/os_network_spec.spl")
        val source = rt_file_read_text("test/03_system/os/os_network_spec.spl")
        expect(source).to_contain("_assert(net_ready, \"Network stack initialized\")")
        expect(source).to_contain("_assert(bind_result >= 0")
        expect(source).to_contain("_assert(conn_result >= 0")

    it "does not report full-stack network success for no-crash socket placeholders":
        # @req REQ-RISCV-NET-022
        # @capture(bit_table): os_full_stack_spec.spl real-assertion markers
        step("Require os_full_stack_spec assertions to be real, not no-crash placeholders")
        val path = "test/03_system/os/os_full_stack_spec.spl"
        expect_no_fake_network_pass(path)
        expect(rt_file_read_text(path)).to_contain("_assert(services_network_ready()")
