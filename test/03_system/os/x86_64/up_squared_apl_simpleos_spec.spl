# @req REQ-001 REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-009 REQ-010 REQ-011 REQ-012 NFR-001 NFR-002 NFR-003 NFR-004 NFR-005 NFR-006 NFR-007 NFR-008 NFR-009 NFR-010
"""# SimpleOS on UP Squared Apollo Lake

Keep offline build/media contracts separate from one-session physical UART
acceptance. Missing physical prerequisites remain BLOCKED, never PASS.
"""

use std.spec.*
use app.io.mod.{process_run_timeout}

fn run_up2_check(mode: text) -> (text, text, i64):
    process_run_timeout(
        "/bin/sh",
        ["scripts/check/check-simpleos-up-squared-apollo-lake.shs", mode],
        150000
    )

fn classify_up2_result(out: text, code: i64) -> text:
    if code == 0 and out.contains("up2_status=pass"):
        return "pass"
    if code == 2 and out.contains("up2_status=blocked"):
        return "blocked"
    "fail"

fn require_up2_pass(out: text, code: i64, phase: text):
    val result = classify_up2_result(out, code)
    if result == "blocked":
        pending("BLOCKED: UP2 physical evidence unavailable ({phase})")
    if result != "pass":
        fail("FAIL: UP2 physical evidence ({phase})")

use std.spec.step

describe "SimpleOS UP Squared Apollo Lake removable UEFI boot":
    it "publishes the build, media, and VFS contracts":
        # @req: REQ-OS-UP-SQUARED-001
        step("Verify: publishes the build, media, and VFS contracts")
        val (out, err, code) = run_up2_check("--contract")
        expect(code).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(err).to_equal("")
        expect(out).to_contain("up2_contract_status=pass")
        expect(out).to_contain("board_target=x86_64-up-squared-apollo-lake")
        expect(out).to_contain("loader_contract=elf32-multiboot2-shim+elf64-module")
        expect(out).to_contain("runtime_execution=freestanding-ring0")
        expect(out).to_contain("hosted_syscall_symbols=0")
        expect(out).to_contain("persistent_writes=selected-removable-usb-or-identity-bound-nvme-only")
        expect(out).to_contain("ls_source=vfs")

    it "proves unsafe media and stale evidence fail closed":
        # @req: REQ-OS-UP-SQUARED-001
        step("Verify: proves unsafe media and stale evidence fail closed")
        val (out, err, code) = run_up2_check("--self-test")
        expect(code).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(err).to_equal("")
        expect(out).to_contain("up2_self_test_status=pass")
        expect(out).to_contain("root_or_swap_target=fail")
        expect(out).to_contain("identity_race=fail")
        expect(out).to_contain("stale_ls_output=fail")

    it "boots the admitted image through OVMF and runs VFS ls":
        # @req: REQ-OS-UP-SQUARED-001
        step("Verify: boots the admitted image through OVMF and runs VFS ls")
        val (out, err, code) = run_up2_check("--ovmf")
        expect(code).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(err).to_equal("")
        expect(out).to_contain("up2_ovmf_status=pass")
        expect(out).to_contain("marker_order=pass")
        expect(out).to_contain("ls_status=pass")
        expect(out).to_contain("ls_source=vfs")
        expect(out).to_contain("ls_entries=bin,etc,README.txt")

    it "provisions and reads a dedicated OVMF NVMe scratch disk":
        # @req: REQ-OS-UP-SQUARED-001
        step("Verify: provisions and reads a dedicated OVMF NVMe scratch disk")
        val (out, err, code) = run_up2_check("--ovmf-storage")
        expect(code).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(err).to_equal("")
        expect(out).to_contain("up2_ovmf_storage_status=pass")
        expect(out).to_contain("nvme_identify_writes=0")
        expect(out).to_contain("gpt_status=pass")
        expect(out).to_contain("fat32_status=pass")
        expect(out).to_contain("proof_readback=pass")

    # @capture(log)
    # @capture(artifact)
    it "boots the admitted removable image and runs VFS ls in one session":
        # @req: REQ-OS-UP-SQUARED-001
        step("Verify: boots the admitted removable image and runs VFS ls in one session")
        val (out, err, code) = run_up2_check("--live")
        expect(err).to_equal("")
        require_up2_pass(out, code, "physical-boot-and-ls")
        expect(out).to_contain("marker_order=pass")
        expect(out).to_contain("ls_status=pass")
        expect(out).to_contain("ls_entries=bin,etc,README.txt")
