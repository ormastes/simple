# codex-system-test
# @req REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
"""# CSS invalid display cascade

Invalid `display` declarations do not displace the previous valid declaration.
The scenario exercises both declaration application paths, then checks computed
style, canonical Draw IR command admission, and exact Engine2D pixels.

This bounded test covers the renderer's existing display keyword set plus the
CSS-wide values whose provenance is retained. `revert-layer` remains excluded
because the current parser flattens `@layer` provenance.
"""

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutDrawIrResult,
    simple_web_layout_render_html_draw_ir_result
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

val DISPLAY_INVALID_CASCADE_HTML = (
    "<style>" +
    "html,body{margin:0;width:8px;height:4px;background:#fff}" +
    ".probe{position:absolute;top:1px;width:2px;height:2px;" +
    "background:#ef4444}" +
    "#hidden-full{left:4px;display:none;display:bogus;visibility:visible}" +
    "#shown-full{left:6px;display:none;display:unset!important;" +
    "visibility:visible}" +
    "</style>" +
    "<div id='hidden-dispatch' style='display:none;display:bogus'></div>" +
    "<div id='initial-dispatch' style='display:none;display:initial'></div>" +
    "<div id='hidden-full' class='probe'></div>" +
    "<div id='shown-full' class='probe'></div>" +
    "<span id='inherit-parent' style='display:inline'>" +
    "<span id='inherit-important' style='display:none;" +
    "display:inherit!important'></span></span>" +
    "<span id='revert-important' style='display:none;" +
    "display:revert!important'></span>"
)

fn _display_node_index(
    result: SimpleWebLayoutDrawIrResult, id: text
) -> i32:
    var index = 0
    for node in result.hit_index.nodes:
        if node.id_attr == id:
            return index
        index = index + 1
    fail("missing HTML node: {id}")
    -1

fn _display_command(
    result: SimpleWebLayoutDrawIrResult, id: text
) -> DrawIrCommand?:
    for batch in result.composition.batches:
        for command in batch.commands:
            for prop in command.computed_style:
                if prop.key == "id" and prop.value == id:
                    return Some(command)
    nil

fn _required_display_command(
    result: SimpleWebLayoutDrawIrResult, id: text
) -> DrawIrCommand:
    if val Some(command) = _display_command(result, id):
        return command
    fail("missing Draw IR command: {id}")
    result.composition.batches[0].commands[0]

describe "REQ-WEB-BROWSER-003/004/021: invalid display cascade":
    it "should retain the last valid display through WebIR DrawIR and Engine2D":
        step("Resolve duplicate display declarations through both style paths")
        val result = simple_web_layout_render_html_draw_ir_result(
            DISPLAY_INVALID_CASCADE_HTML, 8, 4
        )
        val hidden_dispatch = _display_node_index(result, "hidden-dispatch")
        val initial_dispatch = _display_node_index(result, "initial-dispatch")
        val hidden_full = _display_node_index(result, "hidden-full")
        val shown_full = _display_node_index(result, "shown-full")
        val inherit_important = _display_node_index(result, "inherit-important")
        val revert_important = _display_node_index(result, "revert-important")
        expect(result.hit_index.styles[hidden_dispatch].display).to_equal("none")
        expect(result.hit_index.styles[initial_dispatch].display).to_equal("block")
        expect(result.hit_index.styles[hidden_full].display).to_equal("none")
        expect(result.hit_index.styles[shown_full].display).to_equal("block")
        expect(result.hit_index.styles[inherit_important].display).to_equal("inline")
        expect(result.hit_index.styles[revert_important].display).to_equal("inline")

        step("Keep hidden nodes out of canonical Draw IR")
        expect(_display_command(result, "hidden-dispatch")).to_be_nil()
        expect(_display_command(result, "hidden-full")).to_be_nil()
        val shown_full_command = _required_display_command(result, "shown-full")
        expect([
            shown_full_command.x, shown_full_command.y,
            shown_full_command.width, shown_full_command.height
        ]).to_equal([6, 1, 2, 2])

        step("Render exact visible-control Engine2D pixels")
        val raster = Engine2dCompositorBackend.create_named(8, 4, "software")
        val rendered = raster.render_draw_ir_composition(result.composition, [])
        raster.shutdown()
        expect(rendered.skipped_command_count).to_equal(0)
        expect(rendered.pixels).to_equal([
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFEF4444u32, 0xFFEF4444u32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFEF4444u32, 0xFFEF4444u32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32,
            0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32, 0xFFFFFFFFu32
        ])
