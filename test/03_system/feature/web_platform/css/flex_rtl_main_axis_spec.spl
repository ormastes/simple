# codex-system-test
# @req REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
"""# CSS Flex RTL Main Axis

This bounded integer-pixel scenario proves that `direction` reverses the row
flex main axis without changing DOM/order sorting, through canonical Web
semantics, layout, Draw IR, and Engine2D.
"""

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutDrawIrResult,
    simple_web_layout_render_html_draw_ir_result
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

val FLEX_RTL_RULES = (
    "html,body{margin:0;padding:0;width:8px}" +
    ".row{display:flex;width:8px;height:2px;background:#16a34a}" +
    ".item{width:2px;height:2px;flex:0 0 auto}" +
    "#first{{background:#dc2626}}#second{{background:#2563eb}}" +
    "#third{{background:#ca8a04}}#nested{width:1px;height:2px;" +
    "background:#111827}"
)

fn _flex_html(direction: text, flex_direction: text) -> text:
    "<style>" + FLEX_RTL_RULES + "#row{direction:" + direction +
    ";flex-direction:" + flex_direction + "}</style>" +
    "<div id='row' class='row'><div id='first' class='item'></div>" +
    "<div id='second' class='item'></div></div>"

fn _flex_flow_html() -> text:
    "<style>" + FLEX_RTL_RULES +
    "#row{direction:ltr;flex-flow:row-reverse nowrap}</style>" +
    "<div id='row' class='row'><div id='first' class='item'></div>" +
    "<div id='second' class='item'></div></div>"

fn _flex_wrap_html() -> text:
    "<style>" + FLEX_RTL_RULES +
    "#row{direction:rtl;width:4px;height:4px;flex-wrap:wrap}" +
    "#first{{order:2}}#second{{order:1}}#third{{order:3}}</style>" +
    "<div id='row' class='row'><div id='first' class='item'></div>" +
    "<div id='second' class='item'></div>" +
    "<div id='third' class='item'><div id='nested'></div></div></div>"

fn _flex_wrap_distribution_html(auto_margin: bool) -> text:
    val first_margin = if auto_margin: "#first{margin-left:auto}" else: ""
    val row_height = if auto_margin: "2px" else: "4px"
    val third = if auto_margin:
        ""
    else:
        "<div id='third' class='item'></div>"
    "<style>" + FLEX_RTL_RULES + "#row{direction:rtl;width:7px;height:" +
    row_height + ";flex-wrap:wrap;column-gap:1px;" +
    "justify-content:space-between}" + first_margin + "</style>" +
    "<div id='row' class='row'><div id='first' class='item'></div>" +
    "<div id='second' class='item'></div>" + third + "</div>"

fn _flex_node_index(
    result: SimpleWebLayoutDrawIrResult, component_id: text
) -> i32:
    var index = 0
    for node in result.hit_index.nodes:
        if node.id_attr == component_id:
            return index
        index = index + 1
    fail("missing flex semantic node: {component_id}")
    -1

fn _flex_command(
    result: SimpleWebLayoutDrawIrResult, component_id: text
) -> DrawIrCommand:
    for command in result.composition.batches[0].commands:
        if command.component_id == component_id:
            return command
    fail("missing flex Draw IR command: {component_id}")
    result.composition.batches[0].commands[0]

fn _flex_style(command: DrawIrCommand, key: text) -> text:
    for property in command.computed_style:
        if property.key == key:
            return property.value
    fail("missing flex computed style: {key}")
    ""

fn _render_pixels(
    result: SimpleWebLayoutDrawIrResult, width: i32, height: i32
) -> [u32]:
    val raster = Engine2dCompositorBackend.create_named(
        width, height, "software"
    )
    val rendered = raster.render_draw_ir_composition(result.composition, [])
    raster.shutdown()
    expect(rendered.skipped_command_count).to_equal(0)
    rendered.pixels

describe "REQ-WEB-BROWSER-003/004/021: CSS RTL row-flex main axis":
    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should place ordered children from main-start for RTL and LTR":
        # @req: REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
        step("Parse the styled document")
        val rtl = simple_web_layout_render_html_draw_ir_result(
            _flex_html("rtl", "row"), 8, 2
        )
        val ltr = simple_web_layout_render_html_draw_ir_result(
            _flex_html("ltr", "row"), 8, 2
        )
        val reverse_ltr = simple_web_layout_render_html_draw_ir_result(
            _flex_html("ltr", "row-reverse"), 8, 2
        )
        val reverse_rtl = simple_web_layout_render_html_draw_ir_result(
            _flex_html("rtl", "row-reverse"), 8, 2
        )
        val flow_reverse = simple_web_layout_render_html_draw_ir_result(
            _flex_flow_html(), 8, 2
        )
        val rtl_wrap = simple_web_layout_render_html_draw_ir_result(
            _flex_wrap_html(), 4, 4
        )
        val rtl_wrap_justify = simple_web_layout_render_html_draw_ir_result(
            _flex_wrap_distribution_html(false), 7, 4
        )
        val rtl_wrap_auto = simple_web_layout_render_html_draw_ir_result(
            _flex_wrap_distribution_html(true), 7, 2
        )
        val rtl_row_i = _flex_node_index(rtl, "row")
        val rtl_first_i = _flex_node_index(rtl, "first")
        val rtl_second_i = _flex_node_index(rtl, "second")
        val ltr_first_i = _flex_node_index(ltr, "first")
        val ltr_second_i = _flex_node_index(ltr, "second")
        val wrap_first_i = _flex_node_index(rtl_wrap, "first")
        val wrap_second_i = _flex_node_index(rtl_wrap, "second")
        val wrap_third_i = _flex_node_index(rtl_wrap, "third")
        val wrap_nested_i = _flex_node_index(rtl_wrap, "nested")
        expect(rtl.hit_index.nodes[rtl_row_i].tag).to_equal("div")
        expect(rtl.hit_index.nodes[rtl_first_i].tag).to_equal("div")
        expect(rtl.hit_index.nodes[rtl_second_i].tag).to_equal("div")

        step("Resolve the winning computed style")
        val rtl_row = _flex_command(rtl, "row")
        val ltr_row = _flex_command(ltr, "row")
        expect(rtl.hit_index.styles[rtl_row_i].direction_rtl).to_be(true)
        expect(_flex_style(rtl_row, "direction")).to_equal("rtl")
        expect(_flex_style(ltr_row, "direction")).to_equal("ltr")
        expect(reverse_ltr.hit_index.styles[
            _flex_node_index(reverse_ltr, "row")
        ].flex_direction).to_equal("row-reverse")
        expect(reverse_rtl.hit_index.styles[
            _flex_node_index(reverse_rtl, "row")
        ].flex_direction).to_equal("row-reverse")
        expect(flow_reverse.hit_index.styles[
            _flex_node_index(flow_reverse, "row")
        ].flex_direction).to_equal("row-reverse")
        expect(rtl_wrap.hit_index.styles[
            _flex_node_index(rtl_wrap, "row")
        ].direction_rtl).to_be(true)

        step("Emit canonical Draw IR geometry and paint")
        val rtl_first = _flex_command(rtl, "first")
        val rtl_second = _flex_command(rtl, "second")
        val ltr_first = _flex_command(ltr, "first")
        val ltr_second = _flex_command(ltr, "second")
        expect([
            rtl.hit_index.boxes.bx[rtl_first_i],
            rtl.hit_index.boxes.bx[rtl_second_i]
        ]).to_equal([6, 4])
        expect([rtl_first.x, rtl_first.y, rtl_first.width, rtl_first.height]).to_equal(
            [6, 0, 2, 2]
        )
        expect([rtl_second.x, rtl_second.y, rtl_second.width, rtl_second.height]).to_equal(
            [4, 0, 2, 2]
        )
        expect([
            ltr.hit_index.boxes.bx[ltr_first_i],
            ltr.hit_index.boxes.bx[ltr_second_i]
        ]).to_equal([0, 2])
        expect([ltr_first.x, ltr_second.x]).to_equal([0, 2])
        expect([
            rtl_wrap.hit_index.boxes.bx[wrap_first_i],
            rtl_wrap.hit_index.boxes.by[wrap_first_i],
            rtl_wrap.hit_index.boxes.bx[wrap_second_i],
            rtl_wrap.hit_index.boxes.by[wrap_second_i],
            rtl_wrap.hit_index.boxes.bx[wrap_third_i],
            rtl_wrap.hit_index.boxes.by[wrap_third_i],
            rtl_wrap.hit_index.boxes.bx[wrap_nested_i],
            rtl_wrap.hit_index.boxes.by[wrap_nested_i]
        ]).to_equal([0, 0, 2, 0, 2, 2, 2, 2])
        val wrap_nested = _flex_command(rtl_wrap, "nested")
        expect([
            wrap_nested.x, wrap_nested.y,
            wrap_nested.width, wrap_nested.height
        ]).to_equal([2, 2, 1, 2])
        expect([
            _flex_command(reverse_ltr, "first").x,
            _flex_command(reverse_ltr, "second").x,
            _flex_command(reverse_rtl, "first").x,
            _flex_command(reverse_rtl, "second").x
        ]).to_equal([6, 4, 0, 2])
        expect([
            _flex_command(flow_reverse, "first").x,
            _flex_command(flow_reverse, "second").x
        ]).to_equal([6, 4])
        expect([
            _flex_command(rtl_wrap_justify, "first").x,
            _flex_command(rtl_wrap_justify, "first").y,
            _flex_command(rtl_wrap_justify, "second").x,
            _flex_command(rtl_wrap_justify, "second").y,
            _flex_command(rtl_wrap_justify, "third").x,
            _flex_command(rtl_wrap_justify, "third").y
        ]).to_equal([5, 0, 0, 0, 5, 2])
        expect([
            _flex_command(rtl_wrap_auto, "first").x,
            _flex_command(rtl_wrap_auto, "second").x
        ]).to_equal([5, 0])

        step("Render exact Engine2D pixels")
        val green = 0xFF16A34Au32
        val blue = 0xFF2563EBu32
        val red = 0xFFDC2626u32
        val yellow = 0xFFCA8A04u32
        val near_black = 0xFF111827u32
        expect(_render_pixels(rtl, 8, 2)).to_equal([
            green, green, green, green, blue, blue, red, red,
            green, green, green, green, blue, blue, red, red
        ])
        expect(_render_pixels(ltr, 8, 2)).to_equal([
            red, red, blue, blue, green, green, green, green,
            red, red, blue, blue, green, green, green, green
        ])
        expect(_render_pixels(reverse_ltr, 8, 2)).to_equal([
            green, green, green, green, blue, blue, red, red,
            green, green, green, green, blue, blue, red, red
        ])
        expect(_render_pixels(reverse_rtl, 8, 2)).to_equal([
            red, red, blue, blue, green, green, green, green,
            red, red, blue, blue, green, green, green, green
        ])
        expect(_render_pixels(flow_reverse, 8, 2)).to_equal([
            green, green, green, green, blue, blue, red, red,
            green, green, green, green, blue, blue, red, red
        ])
        expect(_render_pixels(rtl_wrap, 4, 4)).to_equal([
            red, red, blue, blue,
            red, red, blue, blue,
            green, green, near_black, yellow,
            green, green, near_black, yellow
        ])
        expect(_render_pixels(rtl_wrap_justify, 7, 4)).to_equal([
            blue, blue, green, green, green, red, red,
            blue, blue, green, green, green, red, red,
            green, green, green, green, green, yellow, yellow,
            green, green, green, green, green, yellow, yellow
        ])
        expect(_render_pixels(rtl_wrap_auto, 7, 2)).to_equal([
            blue, blue, green, green, green, red, red,
            blue, blue, green, green, green, red, red
        ])
