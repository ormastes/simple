# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# codex-system-test
# @req REQ-WEB-BROWSER-002 REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/web_platform/css/pseudo_text_wpt_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/pseudo_text_wpt_spec.md
# doc-path: doc/03_plan/sys_test/pseudo_text_wpt_spec.md
# doc-path: doc/04_architecture/pseudo_text_wpt_spec.md
# doc-path: doc/05_design/pseudo_text_wpt_spec_oracles.md
# @manual: primary

"""# CSS Generated Content And Text Layout

Proves authored and generated text cross the production HTML/CSS semantic and
layout owner, preserve `::before`/element/`::after` order in canonical Draw IR,
and render from that same composition through Engine2D.

The remaining WPT-derived cases retain executable coverage for `attr()`,
generated-content suppression, overflow, wrapping, and alignment. They are
compatibility evidence, not substitutes for the canonical ordering scenario.
"""

use std.spec.step

use std.spec.*

use std.gc_async_mut.gpu.browser_engine.browser_renderer.{render_html_to_pixels_with_viewport}
use std.gc_async_mut.gpu.browser_engine.html_string_parser.{browser_renderer_normalize_style_rules}

val WIDTH: i32 = 80
val HEIGHT: i32 = 60

fn _count_color(pixels: [u32], color: u32) -> i32:
    var count: i32 = 0
    var idx: i32 = 0
    while idx < pixels.len():
        if pixels[idx] == color:
            count = count + 1
        idx = idx + 1
    count

fn _renders_color(style: text, body: text, color: u32) -> bool:
    val css = "body { margin: 0; background-color: #ffffff; } " + browser_renderer_normalize_style_rules(style)
    val html = "<html><head><style>" + css + "</style></head><body>" + body + "</body></html>"
    val result = render_html_to_pixels_with_viewport(html, WIDTH, HEIGHT)
    val pixels = result.pixel_data
    _count_color(pixels, color) > 0

fn _pixel_count(style: text, body: text, color: u32) -> i32:
    val css = "body { margin: 0; background-color: #ffffff; } " + browser_renderer_normalize_style_rules(style)
    val html = "<html><head><style>" + css + "</style></head><body>" + body + "</body></html>"
    val result = render_html_to_pixels_with_viewport(html, WIDTH, HEIGHT)
    val pixels = result.pixel_data
    _count_color(pixels, color)

fn _has_color_at_row(style: text, body: text, color: u32, row: i32) -> bool:
    val css = "body { margin: 0; background-color: #ffffff; } " + browser_renderer_normalize_style_rules(style)
    val html = "<html><head><style>" + css + "</style></head><body>" + body + "</body></html>"
    val result = render_html_to_pixels_with_viewport(html, WIDTH, HEIGHT)
    val pixels = result.pixel_data
    var x: i32 = 0
    while x < WIDTH:
        val idx = row * WIDTH + x
        if idx < pixels.len():
            if pixels[idx] == color:
                return true
        x = x + 1
    false

fn _has_color_at(style: text, body: text, color: u32, x: i32, y: i32) -> bool:
    val css = "body { margin: 0; background-color: #ffffff; } " + browser_renderer_normalize_style_rules(style)
    val html = "<html><head><style>" + css + "</style></head><body>" + body + "</body></html>"
    val result = render_html_to_pixels_with_viewport(html, WIDTH, HEIGHT)
    val idx = y * WIDTH + x
    if idx < 0 or idx >= result.pixel_data.len():
        return false
    result.pixel_data[idx] == color

describe "Production CSS generated content and text layout":
    # @manual: show
    # @capture(html)
    # @capture(artifact)
    # @capture(protocol)
    it "should order before authored and after text on one exact line":
        # @req REQ-SSPEC-SYSTEM
        step("should order before authored and after text on one exact line")
        val before_color = 0xFF2563EBu32
        val authored_color = 0xFF16A34Au32
        val after_color = 0xFFDC2626u32
        val html = _html(
            "#line{display:block;width:48px;height:8px;color:#16a34a;" +
            "font-size:8px;line-height:8px;white-space:nowrap}" +
            "#line::before{content:'A';color:#2563eb}" +
            "#line::after{content:'Z';color:#dc2626}",
            "<div id='line'>M</div>"
        )

    context "before pseudo-element content":

        it "renders before pseudo-element content text on empty div":
            val style = "div { color: #2563eb; } div::before { content: 'Hello'; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFF2563EBu32)).to_equal(true)

        it "renders before pseudo-element on empty element":
            val style = "div { color: #16a34a; } div::before { content: 'Generated'; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFF16A34Au32)).to_equal(true)

        it "renders before pseudo-element attr content":
            val style = "div { color: #2563eb; font-size: 8px; } div::before { content: attr(data-label); }"
            val body = "<div data-label='ABC'></div>"
            expect(_pixel_count(style, body, 0xFF2563EBu32)).to_equal(96)

    context "after pseudo-element content":

        it "renders after pseudo-element content text on empty div":
            val style = "div { color: #dc2626; } div::after { content: 'Suffix'; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFFDC2626u32)).to_equal(true)

        it "renders after pseudo-element on empty element":
            val style = "div { color: #7c3aed; } div::after { content: 'Only'; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFF7C3AEDu32)).to_equal(true)

        it "renders after pseudo-element attr content":
            val style = "div { color: #dc2626; font-size: 8px; } div::after { content: attr(data-label); }"
            val body = "<div data-label='XY'></div>"
            expect(_pixel_count(style, body, 0xFFDC2626u32)).to_equal(64)

        it "keeps missing attr pseudo content empty":
            val style = "div { color: #dc2626; font-size: 8px; } div::after { content: attr(data-label); }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFFDC2626u32)).to_equal(false)

    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should clip a nowrap line with an ellipsis":
        step("Verify: should clip a nowrap line with an ellipsis")
        val body = "<div>ThisIsAVeryLongWordThatOverflows</div>"

        it "does not render generated content for display none element":
            val style = "div { display: none; color: #0891b2; } div::before { content: 'Hidden'; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFF0891B2u32)).to_equal(false)

        it "does not render generated content when pseudo display is none":
            val style = "div { color: #0891b2; } div::before { content: 'Hidden'; display: none; }"
            val body = "<div></div>"
            expect(_renders_color(style, body, 0xFF0891B2u32)).to_equal(false)

    context "text-overflow ellipsis":

    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should wrap long words with break-all and break-word":
        step("Verify: should wrap long words with break-all and break-word")
        val body = "<div>ABCDEFGHIJKLMNOPQRST</div>"
        val second_line_row = 14

    context "word-break and overflow-wrap":

        it "break-all wraps long word onto second line":
            val style = "div { width: 40px; word-break: break-all; color: #4338ca; font-size: 8px; }"
            val body = "<div>ABCDEFGHIJKLMNOPQRST</div>"
            val second_row = 8 + 4 + 2
            expect(_has_color_at_row(style, body, 0xFF4338CAu32, second_row)).to_equal(true)

        it "overflow-wrap break-word wraps long word onto second line":
            val style = "div { width: 40px; overflow-wrap: break-word; color: #9333ea; font-size: 8px; }"
            val body = "<div>ABCDEFGHIJKLMNOPQRST</div>"
            val second_row = 8 + 4 + 2
            expect(_has_color_at_row(style, body, 0xFF9333EAu32, second_row)).to_equal(true)

    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should center and right-align short text in an exact block width":
        step("Verify: should center and right-align short text in an exact block width")
        val body = "<div>AB</div>"

        it "centers short text within the fallback block width":
            val style = "div { width: 40px; text-align: center; color: #ea580c; font-size: 8px; }"
            val body = "<div>AB</div>"
            expect(_has_color_at(style, body, 0xFFEA580Cu32, 15, 2)).to_equal(true)
            expect(_has_color_at(style, body, 0xFFEA580Cu32, 0, 2)).to_equal(false)

        it "right aligns short text within the fallback block width":
            val style = "div { width: 40px; text-align: right; color: #0d9488; font-size: 8px; }"
            val body = "<div>AB</div>"
            expect(_has_color_at(style, body, 0xFF0D9488u32, 30, 2)).to_equal(true)
            expect(_has_color_at(style, body, 0xFF0D9488u32, 0, 2)).to_equal(false)
