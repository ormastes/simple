# codex-system-test
"""# CSS Animation Frame Preservation

Proves fractional last-valid declaration selection and saturating i64 clock
boundaries, plus the supported keyframe subset at its start, negative-delay
seek, midpoint, and filled end through web semantics, layout, canonical Draw
IR, and exact expected-color Engine2D coverage/count. Web Animations
compositing and unsupported properties remain outside this bounded profile.
"""

use std.spec.*

use std.gc_async_mut.gpu.browser_engine.style.animation.{
    interpolate, ease_value, interpolate_length,
    CSSValue, BrowserCssAnimationInstance
}
use std.common.animation.timing.{TimingFunction}
use std.gc_async_mut.gpu.browser_engine.style_block.{extract_keyframes}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id,
    simple_web_layout_debug_style_by_id,
    simple_web_layout_render_html_draw_ir_result_at_time,
    simple_web_layout_render_html_draw_ir_result_at_time_with_animations,
    simple_web_layout_reconcile_animation_instances,
    simple_web_layout_animation_instances_next_ms
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession
}
use std.common.web.browser_renderer_protocol.{
    BrowserRendererMessage, browser_renderer_decoder_feed,
    browser_renderer_decoder_new, browser_renderer_frame_decode
}

val WIDTH: i32 = 32
val HEIGHT: i32 = 24

fn approx(a: f64, b: f64) -> bool:
    val diff = a - b
    val abs_diff = if diff < 0.0: diff * (-1.0) else: diff
    abs_diff < 0.01

fn _interp_number_half() -> bool:
    match interpolate(CSSValue.Number(v: 0.0), CSSValue.Number(v: 1.0), 0.5):
        CSSValue.Number(v): approx(v, 0.5)
        _: false

fn _animation_html() -> text:
    (
        "<style>html,body{{margin:0}}@keyframes preserve{" +
        "from{width:4px;height:4px;background-color:#dc2626}" +
        "to{width:12px;height:4px;background-color:#2563eb}}" +
        "#box{width:4px;height:4px;background-color:#dc2626;" +
        "animation:preserve 1000ms linear forwards}</style>" +
        "<div id='box'></div>"
    )

fn _single_midpoint_keyframe_html() -> text:
    (
        "<style>html,body{{margin:0}}@keyframes peak{" +
        "0%{{opacity:1}}50%{background-color:#2563eb;width:auto}" +
        "100%{{opacity:1}}" +
        "#box{width:8px;height:8px;background-color:#ef4444;" +
        "animation:peak 1000ms linear forwards}</style>" +
        "<div id='box'></div>"
    )

fn _negative_delay_animation_html(delay: text) -> text:
    (
        "<style>html,body{{margin:0}}@keyframes preserve{" +
        "from{width:4px;height:4px;background-color:#dc2626}" +
        "to{width:12px;height:4px;background-color:#2563eb}}" +
        "#box{width:4px;height:4px;background-color:#dc2626;" +
        "animation:preserve 1s linear {delay} forwards}</style>" +
        "<div id='box'></div>"
    )

fn _single_midpoint_animation_command_color(
    html: text, time_ms: i64
) -> u32:
    val result = simple_web_layout_render_html_draw_ir_result_at_time(
        html, WIDTH, HEIGHT, time_ms
    )
    for command in result.composition.batches[0].commands:
        if command.component_id == "box":
            return command.color
    0u32

