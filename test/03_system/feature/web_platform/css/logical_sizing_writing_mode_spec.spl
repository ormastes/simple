# codex-system-test
# @req REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
"""# CSS Logical Sizing And Writing Mode

This bounded integer-pixel scenario proves that logical size declarations map
to the physical axis selected by writing-mode before canonical Web layout,
Draw IR, and Engine2D execution.
"""

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutDrawIrResult,
    simple_web_layout_render_html_draw_ir_result
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

val LOGICAL_SIZE_BASE = (
    "<style>html,body{margin:0;padding:0;width:48px;height:48px;" +
    "overflow:hidden;background:#fff}.box{display:block;" +
    "box-sizing:content-box;background:#1d4ed8}</style>"
)

fn _logical_result(style: text) -> SimpleWebLayoutDrawIrResult:
    simple_web_layout_render_html_draw_ir_result(
        LOGICAL_SIZE_BASE + "<div id='box' class='box' style='" + style +
        "'></div>", 48, 48
    )

fn _logical_document(css: text, body: text) -> SimpleWebLayoutDrawIrResult:
    simple_web_layout_render_html_draw_ir_result(
        "<style>html,body{margin:0;padding:0;width:48px;height:48px;" +
        "overflow:hidden;background:#fff}.box{display:block;" +
        "box-sizing:content-box;background:#1d4ed8}" + css + "</style>" +
        body, 48, 48
    )

fn _logical_command(result: SimpleWebLayoutDrawIrResult) -> DrawIrCommand:
    for command in result.composition.batches[0].commands:
        if command.component_id == "box":
            return command
    fail("missing logical sizing Draw IR command")
    result.composition.batches[0].commands[0]

fn _logical_style_index(result: SimpleWebLayoutDrawIrResult) -> i32:
    var index = 0
    for node in result.hit_index.nodes:
        if node.id_attr == "box":
            return index
        index = index + 1
    fail("missing logical sizing semantic node")
    -1

fn _logical_pixels(result: SimpleWebLayoutDrawIrResult) -> [u32]:
    val raster = Engine2dCompositorBackend.create_named(48, 48, "software")
    val rendered = raster.render_draw_ir_composition(result.composition, [])
    raster.shutdown()
    expect(rendered.skipped_command_count).to_equal(0)
    rendered.pixels

describe "REQ-WEB-BROWSER-003/004/021: CSS logical sizing":
    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should map logical sizes through writing mode into exact pixels":
        # @req: REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
        step("Keep horizontal logical dimensions on width and height")
        val horizontal = _logical_result(
            "writing-mode:horizontal-tb;inline-size:12px;block-size:20px"
        )
        val horizontal_box = _logical_command(horizontal)
        expect(horizontal.composition.batches[0].source.source_kind).to_equal(
            "html_ast"
        )
        expect([
            horizontal_box.content_rect.width,
            horizontal_box.content_rect.height
        ]).to_equal([12, 20])

        step("Swap vertical inline and block dimensions before layout")
        val vertical = _logical_result(
            "writing-mode:vertical-rl;inline-size:12px;block-size:20px"
        )
        val vertical_box = _logical_command(vertical)
        expect([
            vertical_box.content_rect.width,
            vertical_box.content_rect.height
        ]).to_equal([20, 12])

        step("Map vertical and sideways logical min and max constraints")
        val minimum = _logical_result(
            "writing-mode:sideways-lr;width:4px;height:4px;min-height:100vh;" +
            "min-inline-size:10px;max-inline-size:14px;" +
            "min-block-size:18px;max-block-size:22px"
        )
        val maximum = _logical_result(
            "writing-mode:vertical-lr;width:30px;height:24px;" +
            "max-inline-size:14px;max-block-size:22px"
        )
        val minimum_index = _logical_style_index(minimum)
        val maximum_index = _logical_style_index(maximum)
        val minimum_style = minimum.hit_index.styles[minimum_index]
        val maximum_style = maximum.hit_index.styles[maximum_index]
        expect([
            minimum_style.min_width_px, minimum_style.max_width_px,
            minimum_style.min_height_px, minimum_style.max_height_px
        ]).to_equal([18, 22, 10, 14])
        expect(minimum_style.min_height_vh).to_equal(false)
        expect([
            _logical_command(minimum).content_rect.width,
            _logical_command(minimum).content_rect.height
        ]).to_equal([18, 10])
        expect([
            maximum_style.max_width_px, maximum_style.max_height_px,
            _logical_command(maximum).content_rect.width,
            _logical_command(maximum).content_rect.height
        ]).to_equal([22, 14, 22, 14])

        step("Preserve authored order between logical and physical axes")
        val ordered = _logical_result(
            "writing-mode:vertical-rl;width:7px;block-size:20px;" +
            "inline-size:12px;height:9px"
        )
        expect([
            _logical_command(ordered).content_rect.width,
            _logical_command(ordered).content_rect.height
        ]).to_equal([20, 9])

        step("Use the final inherited inline and important writing mode")
        val inline_winner = _logical_document(
            "#parent{writing-mode:vertical-rl}" +
            "#box{inline-size:12px;block-size:20px}",
            "<div id='parent'><div id='box' class='box' " +
            "style='writing-mode:horizontal-tb'></div></div>"
        )
        val stylesheet_important_winner = _logical_document(
            "#box{inline-size:12px;block-size:20px;" +
            "writing-mode:vertical-rl!important}",
            "<div id='box' class='box' " +
            "style='writing-mode:horizontal-tb'></div>"
        )
        val inline_important_winner = _logical_document(
            "#box{inline-size:12px;block-size:20px;" +
            "writing-mode:vertical-rl}",
            "<div id='box' class='box' " +
            "style='writing-mode:horizontal-tb!important'></div>"
        )
        expect([
            _logical_command(inline_winner).content_rect.width,
            _logical_command(inline_winner).content_rect.height
        ]).to_equal([12, 20])
        expect([
            _logical_command(stylesheet_important_winner).content_rect.width,
            _logical_command(stylesheet_important_winner).content_rect.height
        ]).to_equal([20, 12])
        expect([
            _logical_command(inline_important_winner).content_rect.width,
            _logical_command(inline_important_winner).content_rect.height
        ]).to_equal([12, 20])
        expect([
            inline_winner.hit_index.styles[
                _logical_style_index(inline_winner)
            ].writing_mode,
            stylesheet_important_winner.hit_index.styles[
                _logical_style_index(stylesheet_important_winner)
            ].writing_mode,
            inline_important_winner.hit_index.styles[
                _logical_style_index(inline_important_winner)
            ].writing_mode
        ]).to_equal(["horizontal-tb", "vertical-rl", "horizontal-tb"])

        step("Render discriminating horizontal and vertical Engine2D pixels")
        val horizontal_pixels = _logical_pixels(horizontal)
        val vertical_pixels = _logical_pixels(vertical)
        expect(horizontal_pixels[11 * 48 + 19]).to_equal(0xFFFFFFFFu32)
        expect(horizontal_pixels[19 * 48 + 11]).to_equal(0xFF1D4ED8u32)
        expect(vertical_pixels[11 * 48 + 19]).to_equal(0xFF1D4ED8u32)
        expect(vertical_pixels[19 * 48 + 11]).to_equal(0xFFFFFFFFu32)

    # @manual: show
    it "should preserve empty cell winners while pre-resolving writing mode":
        step("Let stylesheet-important hide beat inline-normal show")
        val stylesheet_important = _logical_document(
            "table{width:40px;background:#dbeafe}" +
            "td{display:block;width:20px;height:8px;background:#ef4444;" +
            "empty-cells:hide!important}",
            "<table><tr><td id='box' style='empty-cells:show'></td></tr></table>"
        )
        val stylesheet_important_pixels = _logical_pixels(
            stylesheet_important
        )
        expect(stylesheet_important.composition.batches[0].source.source_kind).to_equal(
            "html_ast"
        )
        expect(stylesheet_important_pixels[4 * 48 + 5]).to_equal(
            0xFFDBEAFEu32
        )

        step("Let inline-important show beat stylesheet-important hide")
        val inline_important = _logical_document(
            "table{width:40px;background:#dbeafe}" +
            "td{display:block;width:20px;height:8px;background:#ef4444;" +
            "empty-cells:hide!important}",
            "<table><tr><td id='box' " +
            "style='empty-cells:show!important'></td></tr></table>"
        )
        val inline_important_pixels = _logical_pixels(inline_important)
        expect(inline_important_pixels[4 * 48 + 5]).to_equal(0xFFEF4444u32)
