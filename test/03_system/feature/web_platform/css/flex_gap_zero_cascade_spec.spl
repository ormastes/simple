# codex-system-test
# @req REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
"""# CSS flex gap zero cascade

**Requirements:** doc/02_requirements/feature/simple_web_browser_engine_production_hardening.md
**Plan:** doc/03_plan/sys_test/css_gap_zero_cascade.md

## Overview

This scenario proves both that a later valid `gap:0` declaration resets an
earlier positive Flex gap and that a later malformed declaration does not
erase an earlier valid `gap:4px`. Both cases cross the dispatch and full Style
reconstruction paths; an invalid-only row remains the zero-gap control.

All rows lower through shared Web semantic/layout state into the existing
canonical `DrawIrComposition` and Engine2D executor. No private painter,
parallel Web IR, Draw IR command, or backend path is introduced.

## Standards contract

CSS Box Alignment admits zero as a non-negative gap. A valid later declaration
wins, while a malformed declaration is discarded before winner selection.
Malformed-only and negative gaps remain outside the accepted subset.

## Exact fixture

The viewport is 12 by 22 pixels. The first two 12-by-2 Flex rows reset a 4px
stylesheet gap to zero. The next two retain `gap:4px` before a malformed
duplicate through the dispatch and full reconstruction paths. Further rows
reject signed, decimal, foreign-unit, and trailing-junk values, reset
`initial`/`unset`, reset a positive class at terminal parent-default `inherit`
through both declaration paths, and keep invalid-only controls at zero.

General nonzero inherited gaps remain RED until computed parent gap state is
available. `revert` and `revert-layer` also remain RED until origin and layer
state is represented; this scenario does not approximate either keyword.

## Evidence boundary

The SSpec asserts parsed nodes, computed gap fields, exact semantic boxes,
canonical Draw IR rectangle geometry and color, zero skipped commands, and
all 264 framebuffer pixels. Runtime PASS is claimed only after a qualified
pure-Simple execution; static review alone is not runtime evidence.
"""

use std.spec.*
use std.common.ui.draw_ir.{DrawIrCommand}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    SimpleWebLayoutDrawIrResult,
    simple_web_layout_render_html_draw_ir_result
}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}

val FLEX_GAP_ZERO_CASCADE_HTML = (
    "<style>" +
    "html,body{margin:0;width:12px;height:22px;background:#fff}" +
    ".row{display:flex;width:12px;height:2px}" +
    ".positive{gap:4px}" +
    ".red{width:4px;height:2px;background:#dc2626}" +
    ".blue{width:4px;height:2px;background:#2563eb}" +
    "</style>" +
    "<div id='dispatch-row' class='row positive' style='gap:0'>" +
    "<div id='dispatch-red' class='red'></div>" +
    "<div id='dispatch-blue' class='blue'></div></div>" +
    "<div id='full-row' class='row positive' " +
    "style='gap:0;visibility:visible'>" +
    "<div id='full-red' class='red'></div>" +
    "<div id='full-blue' class='blue'></div></div>" +
    "<div id='duplicate-dispatch-row' class='row' " +
    "style='gap:4px;gap:bogus'>" +
    "<div id='duplicate-dispatch-red' class='red'></div>" +
    "<div id='duplicate-dispatch-blue' class='blue'></div></div>" +
    "<div id='duplicate-full-row' class='row' " +
    "style='gap:4px;gap:bogus;visibility:visible'>" +
    "<div id='duplicate-full-red' class='red'></div>" +
    "<div id='duplicate-full-blue' class='blue'></div></div>" +
    "<div id='invalid-only-row' class='row' style='gap:bogus'>" +
    "<div id='invalid-only-red' class='red'></div>" +
    "<div id='invalid-only-blue' class='blue'></div></div>" +
    "<div id='syntax-dispatch-row' class='row' style='gap:4px;" +
    "gap:-9px;gap:7.5px;gap:8em;gap:10pxjunk'>" +
    "<div id='syntax-dispatch-red' class='red'></div>" +
    "<div id='syntax-dispatch-blue' class='blue'></div></div>" +
    "<div id='syntax-full-row' class='row' style='gap:4px;gap:-9px;" +
    "gap:7.5px;gap:8em;gap:10pxjunk;visibility:visible'>" +
    "<div id='syntax-full-red' class='red'></div>" +
    "<div id='syntax-full-blue' class='blue'></div></div>" +
    "<div id='initial-row' class='row positive' style='gap:initial'>" +
    "<div id='initial-red' class='red'></div>" +
    "<div id='initial-blue' class='blue'></div></div>" +
    "<div id='unset-row' class='row positive' style='gap:unset'>" +
    "<div id='unset-red' class='red'></div>" +
    "<div id='unset-blue' class='blue'></div></div>" +
    "<div id='inherit-row' class='row positive' style='gap:inherit'>" +
    "<div id='inherit-red' class='red'></div>" +
    "<div id='inherit-blue' class='blue'></div></div>" +
    "<div id='inherit-full-row' class='row positive' " +
    "style='gap:inherit;visibility:visible'>" +
    "<div id='inherit-full-red' class='red'></div>" +
    "<div id='inherit-full-blue' class='blue'></div></div>"
)

fn _gap_zero_node_index(
    result: SimpleWebLayoutDrawIrResult, component_id: text
) -> i32:
    var index = 0
    for node in result.hit_index.nodes:
        if node.id_attr == component_id:
            return index
        index = index + 1
    fail("missing zero-gap semantic node: {component_id}")
    -1

fn _gap_zero_box(
    result: SimpleWebLayoutDrawIrResult, component_id: text
) -> [i32]:
    val index = _gap_zero_node_index(result, component_id)
    val boxes = result.hit_index.boxes
    [boxes.bx[index], boxes.by[index], boxes.bw[index], boxes.bh[index]]

fn _gap_zero_command(
    result: SimpleWebLayoutDrawIrResult, component_id: text
) -> DrawIrCommand:
    for command in result.composition.batches[0].commands:
        if command.component_id == component_id:
            return command
    fail("missing zero-gap Draw IR command: {component_id}")
    result.composition.batches[0].commands[0]

fn _expect_gap_command(
    result: SimpleWebLayoutDrawIrResult, component_id: text,
    x: i32, y: i32, color: u32
):
    val command = _gap_zero_command(result, component_id)
    expect([
        command.kind, command.x.to_text(), command.y.to_text(),
        command.width.to_text(), command.height.to_text(),
        command.color.to_text()
    ]).to_equal([
        "rect", x.to_text(), y.to_text(), "4", "2", color.to_text()
    ])

fn _expect_gap_row_pixels(pixels: [u32], y: i32, has_gap: bool):
    var row_y = y
    while row_y < y + 2:
        var x = 0
        while x < 12:
            val expected = if x < 4:
                0xFFDC2626u32
            elif (has_gap and x >= 8) or (not has_gap and x < 8):
                0xFF2563EBu32
            else:
                0xFFFFFFFFu32
            expect(pixels[x + row_y * 12]).to_equal(expected)
            x = x + 1
        row_y = row_y + 1

describe "REQ-WEB-BROWSER-003/004/021: CSS gap zero cascade":
    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "should reset positive Flex gaps through both declaration paths":
        # @req: REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-021
        step("Parse the split-cascade zero-gap fixture")
        val result = simple_web_layout_render_html_draw_ir_result(
            FLEX_GAP_ZERO_CASCADE_HTML, 12, 22
        )
        val dispatch_row_index = _gap_zero_node_index(result, "dispatch-row")
        val full_row_index = _gap_zero_node_index(result, "full-row")
        val duplicate_dispatch_index = _gap_zero_node_index(
            result, "duplicate-dispatch-row"
        )
        val duplicate_full_index = _gap_zero_node_index(
            result, "duplicate-full-row"
        )
        val invalid_only_index = _gap_zero_node_index(
            result, "invalid-only-row"
        )
        val syntax_dispatch_index = _gap_zero_node_index(
            result, "syntax-dispatch-row"
        )
        val syntax_full_index = _gap_zero_node_index(result, "syntax-full-row")
        val initial_index = _gap_zero_node_index(result, "initial-row")
        val unset_index = _gap_zero_node_index(result, "unset-row")
        val inherit_index = _gap_zero_node_index(result, "inherit-row")
        val inherit_full_index = _gap_zero_node_index(
            result, "inherit-full-row"
        )
        expect(result.hit_index.nodes[dispatch_row_index].tag).to_equal("div")
        expect(result.hit_index.nodes[full_row_index].tag).to_equal("div")
        expect(result.hit_index.nodes[duplicate_dispatch_index].tag).to_equal(
            "div"
        )
        expect(result.hit_index.nodes[duplicate_full_index].tag).to_equal("div")
        expect(result.hit_index.nodes[invalid_only_index].tag).to_equal("div")
        expect(result.hit_index.nodes[syntax_dispatch_index].tag).to_equal("div")
        expect(result.hit_index.nodes[syntax_full_index].tag).to_equal("div")
        expect(result.hit_index.nodes[initial_index].tag).to_equal("div")
        expect(result.hit_index.nodes[unset_index].tag).to_equal("div")
        expect(result.hit_index.nodes[inherit_index].tag).to_equal("div")
        expect(result.hit_index.nodes[inherit_full_index].tag).to_equal("div")
        expect(result.composition.batches[0].source.source_kind).to_equal(
            "html_ast"
        )

        step("Resolve zero-gap Web layout geometry")
        val dispatch_style = result.hit_index.styles[dispatch_row_index]
        val full_style = result.hit_index.styles[full_row_index]
        val duplicate_dispatch_style = (
            result.hit_index.styles[duplicate_dispatch_index]
        )
        val duplicate_full_style = result.hit_index.styles[duplicate_full_index]
        val invalid_only_style = result.hit_index.styles[invalid_only_index]
        val syntax_dispatch_style = result.hit_index.styles[syntax_dispatch_index]
        val syntax_full_style = result.hit_index.styles[syntax_full_index]
        val initial_style = result.hit_index.styles[initial_index]
        val unset_style = result.hit_index.styles[unset_index]
        val inherit_style = result.hit_index.styles[inherit_index]
        val inherit_full_style = result.hit_index.styles[inherit_full_index]
        expect([
            dispatch_style.gap_px, dispatch_style.row_gap_px,
            dispatch_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            full_style.gap_px, full_style.row_gap_px,
            full_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            duplicate_dispatch_style.gap_px,
            duplicate_dispatch_style.row_gap_px,
            duplicate_dispatch_style.column_gap_px
        ]).to_equal([4, 4, 4])
        expect([
            duplicate_full_style.gap_px, duplicate_full_style.row_gap_px,
            duplicate_full_style.column_gap_px
        ]).to_equal([4, 4, 4])
        expect([
            invalid_only_style.gap_px, invalid_only_style.row_gap_px,
            invalid_only_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            syntax_dispatch_style.gap_px, syntax_dispatch_style.row_gap_px,
            syntax_dispatch_style.column_gap_px
        ]).to_equal([4, 4, 4])
        expect([
            syntax_full_style.gap_px, syntax_full_style.row_gap_px,
            syntax_full_style.column_gap_px
        ]).to_equal([4, 4, 4])
        expect([
            initial_style.gap_px, initial_style.row_gap_px,
            initial_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            unset_style.gap_px, unset_style.row_gap_px,
            unset_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            inherit_style.gap_px, inherit_style.row_gap_px,
            inherit_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect([
            inherit_full_style.gap_px, inherit_full_style.row_gap_px,
            inherit_full_style.column_gap_px
        ]).to_equal([0, 0, 0])
        expect(_gap_zero_box(result, "dispatch-row")).to_equal([0, 0, 12, 2])
        expect(_gap_zero_box(result, "dispatch-red")).to_equal([0, 0, 4, 2])
        expect(_gap_zero_box(result, "dispatch-blue")).to_equal([4, 0, 4, 2])
        expect(_gap_zero_box(result, "full-row")).to_equal([0, 2, 12, 2])
        expect(_gap_zero_box(result, "full-red")).to_equal([0, 2, 4, 2])
        expect(_gap_zero_box(result, "full-blue")).to_equal([4, 2, 4, 2])
        expect(_gap_zero_box(result, "duplicate-dispatch-row")).to_equal(
            [0, 4, 12, 2]
        )
        expect(_gap_zero_box(result, "duplicate-dispatch-red")).to_equal(
            [0, 4, 4, 2]
        )
        expect(_gap_zero_box(result, "duplicate-dispatch-blue")).to_equal(
            [8, 4, 4, 2]
        )
        expect(_gap_zero_box(result, "duplicate-full-row")).to_equal(
            [0, 6, 12, 2]
        )
        expect(_gap_zero_box(result, "duplicate-full-red")).to_equal(
            [0, 6, 4, 2]
        )
        expect(_gap_zero_box(result, "duplicate-full-blue")).to_equal(
            [8, 6, 4, 2]
        )
        expect(_gap_zero_box(result, "invalid-only-row")).to_equal(
            [0, 8, 12, 2]
        )
        expect(_gap_zero_box(result, "invalid-only-red")).to_equal(
            [0, 8, 4, 2]
        )
        expect(_gap_zero_box(result, "invalid-only-blue")).to_equal(
            [4, 8, 4, 2]
        )
        expect(_gap_zero_box(result, "syntax-dispatch-row")).to_equal(
            [0, 10, 12, 2]
        )
        expect(_gap_zero_box(result, "syntax-dispatch-red")).to_equal(
            [0, 10, 4, 2]
        )
        expect(_gap_zero_box(result, "syntax-dispatch-blue")).to_equal(
            [8, 10, 4, 2]
        )
        expect(_gap_zero_box(result, "syntax-full-row")).to_equal(
            [0, 12, 12, 2]
        )
        expect(_gap_zero_box(result, "syntax-full-red")).to_equal(
            [0, 12, 4, 2]
        )
        expect(_gap_zero_box(result, "syntax-full-blue")).to_equal(
            [8, 12, 4, 2]
        )
        expect(_gap_zero_box(result, "initial-row")).to_equal([0, 14, 12, 2])
        expect(_gap_zero_box(result, "initial-red")).to_equal([0, 14, 4, 2])
        expect(_gap_zero_box(result, "initial-blue")).to_equal([4, 14, 4, 2])
        expect(_gap_zero_box(result, "unset-row")).to_equal([0, 16, 12, 2])
        expect(_gap_zero_box(result, "unset-red")).to_equal([0, 16, 4, 2])
        expect(_gap_zero_box(result, "unset-blue")).to_equal([4, 16, 4, 2])
        expect(_gap_zero_box(result, "inherit-row")).to_equal([0, 18, 12, 2])
        expect(_gap_zero_box(result, "inherit-red")).to_equal([0, 18, 4, 2])
        expect(_gap_zero_box(result, "inherit-blue")).to_equal([4, 18, 4, 2])
        expect(_gap_zero_box(result, "inherit-full-row")).to_equal(
            [0, 20, 12, 2]
        )
        expect(_gap_zero_box(result, "inherit-full-red")).to_equal(
            [0, 20, 4, 2]
        )
        expect(_gap_zero_box(result, "inherit-full-blue")).to_equal(
            [4, 20, 4, 2]
        )

        step("Emit adjacent canonical Draw IR rectangles")
        val dispatch_red = _gap_zero_command(result, "dispatch-red")
        val dispatch_blue = _gap_zero_command(result, "dispatch-blue")
        val full_red = _gap_zero_command(result, "full-red")
        val full_blue = _gap_zero_command(result, "full-blue")
        val duplicate_dispatch_red = _gap_zero_command(
            result, "duplicate-dispatch-red"
        )
        val duplicate_dispatch_blue = _gap_zero_command(
            result, "duplicate-dispatch-blue"
        )
        val duplicate_full_red = _gap_zero_command(
            result, "duplicate-full-red"
        )
        val duplicate_full_blue = _gap_zero_command(
            result, "duplicate-full-blue"
        )
        val invalid_only_red = _gap_zero_command(result, "invalid-only-red")
        val invalid_only_blue = _gap_zero_command(result, "invalid-only-blue")
        expect([
            dispatch_red.kind, dispatch_blue.kind,
            full_red.kind, full_blue.kind
        ]).to_equal(["rect", "rect", "rect", "rect"])
        expect([
            dispatch_red.x, dispatch_red.y,
            dispatch_red.width, dispatch_red.height
        ]).to_equal([0, 0, 4, 2])
        expect([
            dispatch_blue.x, dispatch_blue.y,
            dispatch_blue.width, dispatch_blue.height
        ]).to_equal([4, 0, 4, 2])
        expect([
            full_red.x, full_red.y, full_red.width, full_red.height
        ]).to_equal([0, 2, 4, 2])
        expect([
            full_blue.x, full_blue.y, full_blue.width, full_blue.height
        ]).to_equal([4, 2, 4, 2])
        expect([
            duplicate_dispatch_red.x, duplicate_dispatch_red.y,
            duplicate_dispatch_red.width, duplicate_dispatch_red.height
        ]).to_equal([0, 4, 4, 2])
        expect([
            duplicate_dispatch_blue.x, duplicate_dispatch_blue.y,
            duplicate_dispatch_blue.width, duplicate_dispatch_blue.height
        ]).to_equal([8, 4, 4, 2])
        expect([
            duplicate_full_red.x, duplicate_full_red.y,
            duplicate_full_red.width, duplicate_full_red.height
        ]).to_equal([0, 6, 4, 2])
        expect([
            duplicate_full_blue.x, duplicate_full_blue.y,
            duplicate_full_blue.width, duplicate_full_blue.height
        ]).to_equal([8, 6, 4, 2])
        expect([
            invalid_only_red.x, invalid_only_red.y,
            invalid_only_red.width, invalid_only_red.height
        ]).to_equal([0, 8, 4, 2])
        expect([
            invalid_only_blue.x, invalid_only_blue.y,
            invalid_only_blue.width, invalid_only_blue.height
        ]).to_equal([4, 8, 4, 2])
        expect([
            dispatch_red.color, dispatch_blue.color,
            full_red.color, full_blue.color,
            duplicate_dispatch_red.color, duplicate_dispatch_blue.color,
            duplicate_full_red.color, duplicate_full_blue.color,
            invalid_only_red.color, invalid_only_blue.color
        ]).to_equal([
            0xFFDC2626u32, 0xFF2563EBu32,
            0xFFDC2626u32, 0xFF2563EBu32,
            0xFFDC2626u32, 0xFF2563EBu32,
            0xFFDC2626u32, 0xFF2563EBu32,
            0xFFDC2626u32, 0xFF2563EBu32
        ])
        _expect_gap_command(
            result, "syntax-dispatch-red", 0, 10, 0xFFDC2626u32
        )
        _expect_gap_command(
            result, "syntax-dispatch-blue", 8, 10, 0xFF2563EBu32
        )
        _expect_gap_command(result, "syntax-full-red", 0, 12, 0xFFDC2626u32)
        _expect_gap_command(result, "syntax-full-blue", 8, 12, 0xFF2563EBu32)
        _expect_gap_command(result, "initial-red", 0, 14, 0xFFDC2626u32)
        _expect_gap_command(result, "initial-blue", 4, 14, 0xFF2563EBu32)
        _expect_gap_command(result, "unset-red", 0, 16, 0xFFDC2626u32)
        _expect_gap_command(result, "unset-blue", 4, 16, 0xFF2563EBu32)
        _expect_gap_command(result, "inherit-red", 0, 18, 0xFFDC2626u32)
        _expect_gap_command(result, "inherit-blue", 4, 18, 0xFF2563EBu32)
        _expect_gap_command(result, "inherit-full-red", 0, 20, 0xFFDC2626u32)
        _expect_gap_command(result, "inherit-full-blue", 4, 20, 0xFF2563EBu32)

        step("Render exact zero-gap Engine2D pixels")
        val raster = Engine2dCompositorBackend.create_named(12, 22, "software")
        val rendered = raster.render_draw_ir_composition(result.composition, [])
        raster.shutdown()
        expect(rendered.skipped_command_count).to_equal(0)
        expect(rendered.pixels.len()).to_equal(264)
        _expect_gap_row_pixels(rendered.pixels, 0, false)
        _expect_gap_row_pixels(rendered.pixels, 2, false)
        _expect_gap_row_pixels(rendered.pixels, 4, true)
        _expect_gap_row_pixels(rendered.pixels, 6, true)
        _expect_gap_row_pixels(rendered.pixels, 8, false)
        _expect_gap_row_pixels(rendered.pixels, 10, true)
        _expect_gap_row_pixels(rendered.pixels, 12, true)
        _expect_gap_row_pixels(rendered.pixels, 14, false)
        _expect_gap_row_pixels(rendered.pixels, 16, false)
        _expect_gap_row_pixels(rendered.pixels, 18, false)
        _expect_gap_row_pixels(rendered.pixels, 20, false)
