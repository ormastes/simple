"""
## Purpose and audience
Purpose: interpolate_length midpoint
Audience: compiler and tooling engineers who maintain this spec

# WPT CSS3 Scorecard

Aggregates CSS3 feature verification results across pure-function tests.
Render-based WPT tests (selector_color_subset, custom_properties, transforms,
sticky, @supports) require compiled-mode renderer pipeline and are tracked
separately.

Run with: bin/simple test test/feature/web_platform/css/wpt_scorecard_spec.spl
"""

# @req: REQ-FEATURE-WptScor-001

use std.spec

use std.gc_async_mut.gpu.browser_engine.style.animation.{
    interpolate, ease_value, interpolate_length, interpolate_keyframes,
    CSSValue, CSSDeclaration, Keyframe
}
use std.common.animation.timing.{TimingFunction}
use std.gc_async_mut.gpu.browser_engine.style.supports.{eval_supports_query}
use std.gc_async_mut.gpu.browser_engine.paint.{compute_object_fit, paint_scrollbar, PaintCommand}
use std.gc_async_mut.gpu.browser_engine.style.transform.{parse_transform, transforms_to_matrix, TransformFunction}
use std.gc_async_mut.gpu.browser_engine.style.custom_properties.{has_var_reference, parse_var_function}
use std.common.render_scene.matrix4.Matrix4

fn approx(a: f64, b: f64) -> bool:
    val diff = a - b
    val abs_diff = if diff < 0.0: -diff else: diff
    abs_diff < 0.01

fn cmd_at(cmds: [PaintCommand], idx: i64) -> PaintCommand:
    var result = PaintCommand.fill_rect(0, 0, 0, 0, 0u32)
    var i = 0
    for c in cmds:
        if i == idx:
            result = c
        i = i + 1
    result

use std.spec.step
describe "WPT CSS3 Scorecard — Pure Function Verification":

    context "Animations (5/5)":
        it "interpolate_length midpoint":
            step("Verify: interpolate_length midpoint")
            # @req: REQ-FEATURE-WptScor-001
            expect(approx(interpolate_length(0.0, 100.0, 0.5), 50.0)).to_equal(true)

        it "ease_value linear identity":
            step("Verify: ease_value linear identity")
            # @req: REQ-FEATURE-WptScor-001
            expect(approx(ease_value(0.5, TimingFunction.Linear), 0.5)).to_equal(true)

        it "ease_value ease-in starts slow":
            step("Verify: ease_value ease-in starts slow")
            # @req: REQ-FEATURE-WptScor-001
            expect(ease_value(0.5, TimingFunction.EaseIn) < 0.5).to_equal(true)

        it "interpolate Number values":
            step("Verify: interpolate Number values")
            # @req: REQ-FEATURE-WptScor-001
            val result = interpolate(CSSValue.Number(v: 0.0), CSSValue.Number(v: 1.0), 0.5)
            val is_half = match result:
                CSSValue.Number(v): approx(v, 0.5)
                _: false
            expect(is_half).to_equal(true)

        it "interpolate_length boundary values":
            step("Verify: interpolate_length boundary values")
            # @req: REQ-FEATURE-WptScor-001
            expect(approx(interpolate_length(10.0, 20.0, 0.0), 10.0)).to_equal(true)
            expect(approx(interpolate_length(10.0, 20.0, 1.0), 20.0)).to_equal(true)

    context "Object-Fit (4/4)":
        it "fill stretches to box":
            step("Verify: fill stretches to box")
            # @req: REQ-FEATURE-WptScor-001
            val r = compute_object_fit(100.0, 50.0, 200.0, 200.0, "fill", "50% 50%")
            expect(approx(r.dest_width, 200.0)).to_equal(true)

        it "contain preserves aspect ratio":
            step("Verify: contain preserves aspect ratio")
            # @req: REQ-FEATURE-WptScor-001
            val r = compute_object_fit(200.0, 100.0, 100.0, 100.0, "contain", "50% 50%")
            expect(approx(r.dest_width, 100.0)).to_equal(true)
            expect(approx(r.dest_height, 50.0)).to_equal(true)

        it "cover fills box":
            step("Verify: cover fills box")
            # @req: REQ-FEATURE-WptScor-001
            val r = compute_object_fit(200.0, 100.0, 100.0, 100.0, "cover", "50% 50%")
            expect(approx(r.dest_width, 200.0)).to_equal(true)

        it "none uses natural dimensions":
            step("Verify: none uses natural dimensions")
            # @req: REQ-FEATURE-WptScor-001
            val r = compute_object_fit(50.0, 30.0, 100.0, 100.0, "none", "50% 50%")
            expect(approx(r.dest_width, 50.0)).to_equal(true)

    context "Scrollbar (3/3)":
        it "track renders on overflow":
            step("Verify: track renders on overflow")
            # @req: REQ-FEATURE-WptScor-001
            val cmds = paint_scrollbar(0.0, 0.0, 200.0, 400.0, 800.0, 0.0)
            expect(cmds.len() >= 1).to_equal(true)

        it "thumb proportional to ratio":
            step("Verify: thumb proportional to ratio")
            # @req: REQ-FEATURE-WptScor-001
            val cmds = paint_scrollbar(0.0, 0.0, 200.0, 400.0, 800.0, 0.0)
            val thumb = cmd_at(cmds, 1)
            expect(thumb.height).to_equal(200)  # oracle: value fixed by the spec contract

        it "no thumb when content fits":
            step("Verify: no thumb when content fits")
            # @req: REQ-FEATURE-WptScor-001
            val cmds = paint_scrollbar(0.0, 0.0, 200.0, 400.0, 300.0, 0.0)
            expect(cmds.len()).to_equal(1)  # oracle: value fixed by the spec contract

    context "Transforms (3/3)":
        it "parse_transform produces functions":
            step("Verify: parse_transform produces functions")
            # @req: REQ-FEATURE-WptScor-001
            val fns = parse_transform("translate(10px, 20px)")
            expect(fns.len()).to_equal(1)  # oracle: value fixed by the spec contract

        it "transforms_to_matrix identity for none":
            step("Verify: transforms_to_matrix identity for none")
            # @req: REQ-FEATURE-WptScor-001
            val fns = parse_transform("none")
            val m = transforms_to_matrix(fns)
            expect(approx(m.get(0, 0), 1.0)).to_equal(true)

        it "scale(2) matrix diagonal":
            step("Verify: scale(2) matrix diagonal")
            # @req: REQ-FEATURE-WptScor-001
            val fns = parse_transform("scale(2)")
            val m = transforms_to_matrix(fns)
            expect(approx(m.get(0, 0), 2.0)).to_equal(true)
            expect(approx(m.get(1, 1), 2.0)).to_equal(true)

    context "@supports (8/8)":
        it "known property evaluates true":
            step("Verify: known property evaluates true")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(display: flex)")).to_equal(true)

        it "known property with invalid value evaluates false":
            step("Verify: known property with invalid value evaluates false")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(display: definitely-not-css)")).to_equal(false)

        it "unknown property evaluates false":
            step("Verify: unknown property evaluates false")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(nonexistent: value)")).to_equal(false)

        it "text-overflow support evaluates true":
            step("Verify: text-overflow support evaluates true")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(text-overflow: ellipsis)")).to_equal(true)

        it "text-overflow invalid keyword evaluates false":
            step("Verify: text-overflow invalid keyword evaluates false")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(text-overflow: definitely-not-css)")).to_equal(false)

        it "text-transform support evaluates true":
            step("Verify: text-transform support evaluates true")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("(text-transform: uppercase)")).to_equal(true)

        it "supported selector condition evaluates true":
            step("Verify: supported selector condition evaluates true")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("selector(div:has(.badge))")).to_equal(true)

        it "unsupported selector pseudo evaluates false":
            step("Verify: unsupported selector pseudo evaluates false")
            # @req: REQ-FEATURE-WptScor-001
            expect(eval_supports_query("selector(div:popover-open)")).to_equal(false)

    context "Custom Properties (2/2)":
        it "has_var_reference detects var()":
            step("Verify: has_var_reference detects var()")
            # @req: REQ-FEATURE-WptScor-001
            expect(has_var_reference("color: var(--main)")).to_equal(true)

        it "has_var_reference false for plain value":
            step("Verify: has_var_reference false for plain value")
            # @req: REQ-FEATURE-WptScor-001
            expect(has_var_reference("color: red")).to_equal(false)

    context "Overall Score":
        it "WPT CSS3 pure-function score >= 80%":
            step("Verify: WPT CSS3 pure-function score >= 80%")
            # @req: REQ-FEATURE-WptScor-001
            var passed = 0
            var total = 0

            total = total + 1
            if approx(interpolate_length(0.0, 100.0, 0.5), 50.0): passed = passed + 1
            total = total + 1
            if approx(ease_value(0.5, TimingFunction.Linear), 0.5): passed = passed + 1
            total = total + 1
            if ease_value(0.5, TimingFunction.EaseIn) < 0.5: passed = passed + 1

            val ofr = compute_object_fit(100.0, 50.0, 200.0, 200.0, "fill", "50% 50%")
            total = total + 1
            if approx(ofr.dest_width, 200.0): passed = passed + 1
            val ofr2 = compute_object_fit(200.0, 100.0, 100.0, 100.0, "contain", "50% 50%")
            total = total + 1
            if approx(ofr2.dest_width, 100.0): passed = passed + 1

            val sb = paint_scrollbar(0.0, 0.0, 200.0, 400.0, 800.0, 0.0)
            total = total + 1
            if sb.len() >= 1: passed = passed + 1
            total = total + 1
            if sb.len() == 2: passed = passed + 1

            val tfns = parse_transform("scale(2)")
            total = total + 1
            if tfns.len() == 1: passed = passed + 1
            total = total + 1
            if eval_supports_query("(display: flex)"): passed = passed + 1
            total = total + 1
            if not eval_supports_query("(display: definitely-not-css)"): passed = passed + 1
            total = total + 1
            if eval_supports_query("(text-overflow: ellipsis)"): passed = passed + 1
            total = total + 1
            if not eval_supports_query("(text-overflow: definitely-not-css)"): passed = passed + 1
            total = total + 1
            if eval_supports_query("selector(div:has(.badge))"): passed = passed + 1
            total = total + 1
            if has_var_reference("color: var(--x)"): passed = passed + 1

            val score = passed.to_f64() / total.to_f64()
            expect(score >= 0.8).to_equal(true)
