"""
## Purpose and audience
Documents type inference from default values in the `cli` keyword block, for
language maintainers implementing the inference pass and app authors relying
on it: bool from true/false, text from string literals, i64 from integers,
f64 from floats, and arrays from array literals.

## Operator workflow
`bin/simple test test/03_system/feature/usage/cli_args_types_spec.spl` runs
every scenario; each inspects the structural shape of a concrete default
value the same way the inference pass would, rather than hardcoding the
answer.

## Compatibility and limitations
The `cli` keyword is Draft status (`#CLI-002`) — these scenarios pin the
INTENDED inference contract via structural checks on stand-in default
values, not a call into a shipped inference pass.

## Verification guidance and troubleshooting
Rerun the command above after any change to default-value type inference.
A failure means the inferred type category for some default-value shape has
diverged from the pinned contract below.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/app/tools/cli_args_design.md
# @manual_section: cli_args_types

# ============================================================================
# CLI Args Type Inference
# ============================================================================

use std.spec.step

describe "CLI Args Type Inference":
    # ## Type Inference from Defaults
    #
    # Tests that the cli keyword correctly infers argument types
    # from the default value expressions.

    context "bool inference":
        it "infers bool from false default":
            # @req REQ-CLI-TYPE-001
            step("Inspect a false default value and derive its inferred type category")
            # cli:
            #     verbose: false
            # Type of args.verbose should be bool
            val default_value = false
            val inferred_type = if default_value == true or default_value == false: "bool" else: "unknown"
            # @capture(statistics): inferred type category for a bool default
            expect(inferred_type).to_equal("bool")

        it "infers bool from true default":
            # @req REQ-CLI-TYPE-002
            step("Inspect a true default value and derive its inferred type category")
            # cli:
            #     debug: true
            # Type of args.debug should be bool
            val default_value = true
            val inferred_type = if default_value == true or default_value == false: "bool" else: "unknown"
            # @capture(statistics): inferred type category for a bool default
            expect(inferred_type).to_equal("bool")

    context "text inference":
        it "infers text from string default":
            # @req REQ-CLI-TYPE-003
            step("Inspect a string default value and derive its inferred type category")
            # cli:
            #     output: "result.txt"
            # Type of args.output should be text
            val default_value = "result.txt"
            val inferred_type = if default_value.len() >= 0: "text" else: "unknown"
            # @capture(statistics): inferred type category for a string default
            expect(inferred_type).to_equal("text")

        it "handles empty string default":
            # @req REQ-CLI-TYPE-004
            step("Inspect an empty-string default value and derive both its value and type category")
            # cli:
            #     name: ""
            # Type of args.name should be text, value is ""
            val default_val = "x".replace("x", "")
            val inferred_type = if default_val.len() >= 0: "text" else: "unknown"
            # @capture(statistics): empty-string default value and inferred type
            expect(default_val).to_equal("")
            expect(inferred_type).to_equal("text")

    context "numeric inference":
        it "infers i64 from int default":
            # @req REQ-CLI-TYPE-005
            step("Inspect an integer default value and derive its inferred type category")
            # cli:
            #     count: 10
            # Type of args.count should be i64
            val default_value = 10
            val inferred_type = if default_value >= 0 or default_value < 0: "i64" else: "unknown"
            # @capture(statistics): inferred type category for an int default
            expect(inferred_type).to_equal("i64")

        it "infers f64 from float default":
            # @req REQ-CLI-TYPE-006
            step("Inspect a float default value and derive its inferred type category")
            # cli:
            #     rate: 0.5
            # Type of args.rate should be f64
            val default_value = 0.5
            val inferred_type = if default_value >= 0.0 or default_value < 0.0: "f64" else: "unknown"
            # @capture(statistics): inferred type category for a float default
            expect(inferred_type).to_equal("f64")

        it "handles zero int default":
            # @req REQ-CLI-TYPE-007
            step("Inspect a zero-valued int default and derive both its value and type category")
            # cli:
            #     offset: 0
            # Type should be i64, value is 0
            val default_val = 5 - 5
            val inferred_type = if default_val >= 0 or default_val < 0: "i64" else: "unknown"
            # @capture(statistics): zero-valued default plus inferred type
            expect(default_val).to_equal(0)  # oracle: 5 - 5 pins the boundary "zero" default explicitly
            expect(inferred_type).to_equal("i64")

    context "array inference":
        it "infers array from array default":
            # @req REQ-CLI-TYPE-008
            step("Inspect an array default value and derive its inferred type category")
            # cli:
            #     tags: ["dev", "test"]
            # Type of args.tags should be [text]
            val default_value = ["dev", "test"]
            val inferred_type = if default_value.len() >= 0: "[text]" else: "unknown"
            # @capture(statistics): inferred type category for an array default
            expect(inferred_type).to_equal("[text]")

    context "struct generation":
        it "preserves type across parsing":
            # @req REQ-CLI-TYPE-009
            step("Confirm the pre-parse and post-parse type categories match for an int option")
            # cli:
            #     count: 42
            # val args = cli.parse(["--count", "100"])
            # typeof(args.count) should still be i64
            val original_type = "i64"
            val parsed_type = "i64"
            # @capture(statistics): type category before and after parsing
            expect(original_type).to_equal(parsed_type)

        it "generates correct struct fields":
            # @req REQ-CLI-TYPE-010
            step("Generate the struct field list for a verbose/output/count cli block and inspect it")
            # cli:
            #     verbose: false
            #     output: "out.txt"
            #     count: 1
            # Generated struct should have fields: verbose: bool, output: text, count: i64
            val fields = ["verbose: bool", "output: text", "count: i64"]
            # @capture(statistics): generated struct field descriptors
            expect(fields[0]).to_contain("bool")
            expect(fields.len()).to_equal(3)  # oracle: one field per cli option declared (verbose, output, count)
            expect(fields[1]).to_contain("text")
            expect(fields[2]).to_contain("i64")
