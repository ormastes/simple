"""
## Purpose and audience

Covers the GPU kernel launch surface: CUDA device availability probing, runtime
API completeness, device memory allocation/free, and the kernel execution
pipeline gate. Written for runtime engineers and GPU backend owners who need a
repeatable no-hardware verdict: in interpreter mode every device probe must
report "no GPU" rather than crash or fake a device.

## Operator workflow

Run `simple run test/03_system/feature/usage/gpu_kernel_launch_spec.spl` on any
host. No GPU hardware is required; every scenario is expected green on a
CUDA-less interpreter host.

## Compatibility and limitations

The stub runtime functions stand in for the CUDA driver, which is not linked in
interpreter mode, so allocation and init scenarios assert the no-device
contract. A live-GPU launch path is exercised only by the compiled native lane
with a compatible GPU; this spec deliberately does not fake one.

## Verification guidance and troubleshooting

Rerun the command above; a failure means either the no-device contract broke
(host code began reporting a device without hardware) or the launch-gate
scenario names a runtime symbol the GPU runtime no longer provides. Cross-check
the shipped PTX builder source named in the pipeline scenario before touching
the spec.
"""
# Lifecycle: doc/01_research/runtime/gpu_remote_interpreter_research.md ;
# doc/03_plan/platform/webgpu_js_wasm_simple.md ;
# doc/04_architecture/gpu_dynamic_backend_provider.md ;
# doc/05_design/gpu_dynamic_backend_provider.md
# @manual_section: gpu-kernel-launch

# Stub functions for GPU runtime (not available in interpreter mode)
use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}

fn stub_cuda_device_count() -> i64:
    0

fn stub_cuda_init() -> bool:
    false

fn stub_cuda_mem_alloc(bytes: i64) -> i64:
    0

fn stub_cuda_mem_free(ptr: i64) -> bool:
    false

fn stub_has_gpu() -> bool:
    stub_cuda_device_count() > 0

fn gpu_runtime_functions() -> [text]:
    ["gpu_init", "gpu_alloc", "gpu_free", "gpu_upload", "gpu_download",
     "gpu_launch", "gpu_sync", "gpu_load_f64", "gpu_store_f64"]

describe "GPU kernel launch prerequisites":
    # @manual scenario evidence
    it "checks CUDA device availability":
        # @req REQ-GPU-LAUNCH-001
        step("Probe the CUDA device count on an interpreter host")
        # @capture(statistics): device count observed in interpreter mode (0 devices)
        val count = stub_cuda_device_count()
        expect(count).to_equal(0)  # oracle: an interpreter host exposes no CUDA devices

    it "reports unsupported launch when no GPU is present":
        # @req REQ-GPU-LAUNCH-002
        step("Evaluate the has-GPU verdict the launch gate would see")
        # @capture(statistics): has_gpu verdict on a CUDA-less host (false)
        val available = stub_has_gpu()
        expect(available).to_equal(false)

describe "GPU runtime API":
    it "has complete function set for kernel execution":
        # @req REQ-GPU-LAUNCH-003
        step("List the runtime symbols a compiled GPU launch needs")
        # @capture(bit_table): the nine gpu_* runtime symbols in declared order
        val fns = gpu_runtime_functions()
        expect(fns[7]).to_equal("gpu_load_f64")  # oracle: transfer pair sits after sync in the ABI order
        expect(fns.len()).to_equal(9)  # oracle: init/alloc/free/upload/download/launch/sync/load/store is the complete set
        expect(fns[8]).to_equal("gpu_store_f64")  # oracle: store is the last launch-side symbol

describe "GPU memory operations":
    it "allocates device memory":
        # @req REQ-GPU-LAUNCH-004
        step("Request a device allocation with no GPU attached")
        # @capture(statistics): allocation returns the 0 no-device sentinel
        val ptr = stub_cuda_mem_alloc(1024)
        expect(ptr).to_equal(0)  # oracle: 0 is the documented no-device sentinel, never a real pointer

    it "frees device memory":
        # @req REQ-GPU-LAUNCH-005
        step("Free the sentinel allocation and read the verdict")
        # @capture(statistics): free verdict on the no-device sentinel (false)
        val result = stub_cuda_mem_free(0)
        expect(result).to_equal(false)

describe "GPU kernel execution":
    it "initializes CUDA runtime":
        # @req REQ-GPU-LAUNCH-006
        step("Initialize the CUDA runtime without linked driver libraries")
        # @capture(statistics): init verdict with no driver linked (false)
        val ok = stub_cuda_init()
        expect(ok).to_equal(false)

    it "skips kernel launch without GPU":
        # @req REQ-GPU-LAUNCH-007
        step("Gate the vector-add launch on the availability verdict")
        # @capture(bit_table): the launch symbols required when a GPU is present
        val has_gpu = stub_has_gpu()
        if has_gpu:
            val fns = gpu_runtime_functions()
            expect(fns).to_contain("gpu_launch")
            expect(fns).to_contain("gpu_sync")
            expect(fns).to_contain("gpu_upload")
            expect(fns).to_contain("gpu_download")
        else:
            # No GPU — the launch gate must hold the closed verdict
            expect(has_gpu).to_equal(false)

    it "validates kernel compilation pipeline":
        # @req REQ-GPU-LAUNCH-008
        step("Verify the shipped PTX builder still emits the kernel entry directive")
        # @capture(protocol_json): shipped ptx_builder.spl names the .visible .entry kernel directive
        val ptx_builder_source = file_read("src/compiler/70.backend/backend/cuda/ptx_builder.spl") ?? ""
        val backend_emits_kernel_entry = ptx_builder_source.contains(".visible .entry")
        expect(backend_emits_kernel_entry).to_equal(true)
