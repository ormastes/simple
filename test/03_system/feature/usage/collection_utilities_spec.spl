"""
# Collection Utilities Specification


**Feature IDs:** #COLL-UTIL-001 to #COLL-UTIL-052
**Category:** Runtime | Collections
**Status:** Implemented

Tests collection utility functions including:
- Array sorting and reversing
- Array aggregation (sum, min, max, count)
- Array transformation (zip, enumerate, flatten, unique)
- Array slicing (take, drop)
- Array predicates (all_truthy, any_truthy)
- Tuple operations
- String operations
- Dictionary operations

## Array Utility Methods

```simple
# Sorting (returns new array)
use std.spec.step

val sorted = arr.sort()      # Returns new sorted array
val sorted = arr.sorted()    # Alias for sort

# Reversing (returns new array)
val rev = arr.reverse()      # Returns new reversed array
val rev = arr.reversed()     # Alias for reverse

# Access
arr.first()             # First element or nil
arr.last()              # Last element or nil
arr.index_of(value)     # Index or -1 if not found

# Aggregation
arr.sum()               # Sum of numeric elements
arr.min()               # Minimum value or nil
arr.max()               # Maximum value or nil
arr.count_of(value)     # Count occurrences of specific value

# Transformation
arr.concat(other)       # Concatenate arrays
arr.copy()              # Shallow copy
arr.zip(other)          # Zip into tuples
arr.enumerate()         # Add indices as tuples
arr.flatten()           # Flatten nested arrays
arr.unique()            # Remove duplicates
arr.take(n)             # First n elements
arr.drop(n)             # Skip first n elements

# Predicates
arr.all_truthy()        # All elements truthy?
arr.any_truthy()        # Any element truthy?
```
"""



# ============================================================================
# Test Group 1: Array Sorting
# ============================================================================

use std.spec.step

describe "Array Sorting":
    # @manual scenario evidence
    # ## Sorting Returns New Array
    #
    # Tests sort() and sorted() methods.

    it "sort returns new sorted array":
        val arr = [3, 1, 4, 1, 5]
        val s = arr.sort()
        expect(s[0]).to_equal(1)
        expect(s[1]).to_equal(1)
        expect(s[2]).to_equal(3)
        expect(s[3]).to_equal(4)
        expect(s[4]).to_equal(5)

    it "sorted returns new sorted array":
        val arr = [3, 1, 2]
        val s = arr.sorted()
        # Original unchanged
        expect(arr[0]).to_equal(3)
        # New array sorted
        expect(s[0]).to_equal(1)
        expect(s[1]).to_equal(2)
        expect(s[2]).to_equal(3)


# ============================================================================
# Test Group 2: Array Reversing
# ============================================================================

describe "Array Reversing":
    # ## Reversing Returns New Array
    #
    # Tests reverse() and reversed() methods.

    it "reverse returns new reversed array":
        val arr = [1, 2, 3]
        val r = arr.reverse()
        expect(r[0]).to_equal(3)
        expect(r[1]).to_equal(2)
        expect(r[2]).to_equal(1)

    it "reversed returns new reversed array":
        val arr = [1, 2, 3]
        val r = arr.reversed()
        # Original unchanged
        expect(arr[0]).to_equal(1)
        # New array reversed
        expect(r[0]).to_equal(3)
        expect(r[1]).to_equal(2)
        expect(r[2]).to_equal(1)


# ============================================================================
# Test Group 3: Array Access Methods
# ============================================================================

describe "Array Access Methods":
    # ## First, Last, Index Lookup
    #
    # Tests array element access methods.

    it "first returns first element":
        val arr = [10, 20, 30]
        expect(arr.first()).to_equal(10)

    it "last returns last element":
        val arr = [10, 20, 30]
        expect(arr.last()).to_equal(30)

    it "first returns nil for empty array":
        val arr: [i64] = []
        expect(arr.first()).to_equal(nil)

    it "last returns nil for empty array":
        val arr: [i64] = []
        expect(arr.last()).to_equal(nil)

    it "index_of finds element":
        val arr = [10, 20, 30, 20]
        expect(arr.index_of(20)).to_equal(1  # First occurrence)

    it "index_of returns -1 when not found":
        val arr = [10, 20, 30]
        expect(arr.index_of(99)).to_equal(-1)


# ============================================================================
# Test Group 4: Array Concatenation and Copy
# ============================================================================

describe "Array Concatenation and Copy":
    # ## Combining and Duplicating Arrays
    #
    # Tests concat() and copy() methods.

    it "concatenates two arrays":
        val a = [1, 2]
        val b = [3, 4]
        val c = a.concat(b)
        expect(c[0]).to_equal(1)
        expect(c.len()).to_equal(4)
        expect(c[2]).to_equal(3)
        expect(c[3]).to_equal(4)

    it "creates shallow copy":
        val arr = [1, 2, 3]
        val c = arr.copy()
        expect(c[0]).to_equal(1)
        expect(c.len()).to_equal(3)
        expect(c[1]).to_equal(2)
        expect(c[2]).to_equal(3)


# ============================================================================
# Test Group 5: Array Aggregation
# ============================================================================

describe "Array Aggregation":
    # ## Sum, Min, Max, Count
    #
    # Tests numeric aggregation methods.

    it "sums numeric array":
        val arr = [1, 2, 3, 4]
        expect(arr.sum()).to_equal(10)

    it "sum of empty array is zero":
        val arr: [i64] = []
        expect(arr.sum()).to_equal(0)

    it "finds minimum value":
        val arr = [3, 1, 4, 1, 5]
        expect(arr.min()).to_equal(1)

    it "finds maximum value":
        val arr = [3, 1, 4, 1, 5]
        expect(arr.max()).to_equal(5)

    it "min of empty array is nil":
        val arr: [i64] = []
        expect(arr.min()).to_equal(nil)

    it "max of empty array is nil":
        val arr: [i64] = []
        expect(arr.max()).to_equal(nil)

    it "counts occurrences":
        val arr = [1, 2, 1, 3, 1]
        expect(arr.count_of(1)).to_equal(3)
        expect(arr.count_of(2)).to_equal(1)
        expect(arr.count_of(99)).to_equal(0)


# ============================================================================
# Test Group 6: Array Transformation
# ============================================================================

describe "Array Transformation":
    # ## Zip, Enumerate, Flatten, Unique
    #
    # Tests array transformation methods.

    it "zips two arrays into tuples":
        val a = [1, 2, 3]
        val b = [10, 20, 30]
        val z = a.zip(b)
        expect(z[0]).to_equal((1, 10))
        expect(z.len()).to_equal(3)
        expect(z[1]).to_equal((2, 20))
        expect(z[2]).to_equal((3, 30))

    it "enumerates array with indices":
        val arr = [10, 20, 30]
        val e = arr.enumerate()
        expect(e[0]).to_equal((0, 10))
        expect(e.len()).to_equal(3)
        expect(e[1]).to_equal((1, 20))
        expect(e[2]).to_equal((2, 30))

    it "flattens nested arrays":
        val nested = [[1, 2], [3, 4], [5]]
        val result = nested.flatten()
        expect(result[0]).to_equal(1)
        expect(result.len()).to_equal(5)
        expect(result[2]).to_equal(3)
        expect(result[4]).to_equal(5)

    it "removes duplicates":
        val arr = [1, 2, 1, 3, 2, 1]
        val u = arr.unique()
        expect(u[0]).to_equal(1)
        expect(u.len()).to_equal(3)
        expect(u[1]).to_equal(2)
        expect(u[2]).to_equal(3)


# ============================================================================
# Test Group 7: Array Slicing Methods
# ============================================================================

describe "Array Slicing Methods":
    # ## Take and Drop
    #
    # Tests take() and drop() methods.

    it "takes first n elements":
        val arr = [1, 2, 3, 4, 5]
        val t = arr.take(3)
        expect(t[0]).to_equal(1)
        expect(t.len()).to_equal(3)
        expect(t[2]).to_equal(3)

    it "drops first n elements":
        val arr = [1, 2, 3, 4, 5]
        val d = arr.drop(2)
        expect(d[0]).to_equal(3)
        expect(d.len()).to_equal(3)
        expect(d[2]).to_equal(5)


# ============================================================================
# Test Group 8: Array Predicates
# ============================================================================

describe "Array Predicates":
    # ## All and Any Truthy
    #
    # Tests array truthiness predicates.

    it "all_truthy returns true when all truthy":
        val arr = [1, 2, 3]
        expect arr.all_truthy()

    it "all_truthy returns false with zero":
        val arr = [1, 0, 3]
        expect not arr.all_truthy()

    it "any_truthy returns true with some truthy":
        val arr = [0, 0, 1]
        expect arr.any_truthy()

    it "any_truthy returns false when all zero":
        val arr = [0, 0, 0]
        expect not arr.any_truthy()


# ============================================================================
# Test Group 9: Array Fill
# ============================================================================

describe "Array Fill":
    # ## Fill Array
    #
    # Tests fill() method.

    it "fills array with value":
        val arr = [1, 2, 3]
        val filled = arr.fill(0)
        expect(filled[0]).to_equal(0)
        expect(filled.len()).to_equal(3)
        expect(filled[1]).to_equal(0)
        expect(filled[2]).to_equal(0)


# ============================================================================
# Test Group 10: Tuple Operations
# ============================================================================

describe "Tuple Operations":
    # ## Tuple Creation and Access
    #
    # Tests tuple functionality.

    it "creates tuple with specified size":
        val t = (10, 20, 30)
        expect(t.len()).to_equal(3)

    it "gets tuple elements by index":
        val t = (10, 20, 30)
        expect(t[0]).to_equal(10)
        expect(t[1]).to_equal(20)
        expect(t[2]).to_equal(30)

    it "first and last on tuple":
        val t = (10, 20, 30)
        expect(t.first()).to_equal(10)
        expect(t.last()).to_equal(30)


# ============================================================================
# Test Group 11: String Operations
# ============================================================================

describe "String Operations":
    # ## String Creation and Manipulation
    #
    # Tests string functionality.

    it "creates string and gets length":
        val s = "Hello, World!"
        expect(s.len()).to_equal(13)

    it "concatenates strings":
        val a = "Hello"
        val b = " World"
        val c = a + b
        expect(c).to_equal("Hello World")
        expect(c.len()).to_equal(11)

    it "handles empty string":
        val s = ""
        expect(s.len()).to_equal(0)


# ============================================================================
# Test Group 12: Dictionary Operations
# ============================================================================

describe "Dictionary Operations":
    # ## Dictionary Creation and Manipulation
    #
    # Tests dictionary functionality.

    it "creates empty dict":
        val d = {}
        expect(d.len()).to_equal(0)

    it "sets and gets values":
        var d = {}
        d["name"] = "Alice"
        d["age"] = 30
        expect(d.len()).to_equal(2)
        expect(d["age"]).to_equal(30)

    it "overwrites existing key":
        var d = {"counter": 1}
        d["counter"] = 2
        expect(d.len()).to_equal(1)
        expect(d["counter"]).to_equal(2)

    it "returns nil for missing key":
        val d = {"a": 1}
        expect(d["missing"]).to_equal(nil)

