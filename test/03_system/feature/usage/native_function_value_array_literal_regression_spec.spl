# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Native Function Value Array Literal Regression

**Feature IDs:** #native-function-value-array-literal-regression
**Category:** Runtime / Native / Function Values
**Status:** Implemented

## Overview

This SSpec keeps the fixed lower native path green beneath the hosted
`multicore_green` resumable-stepper lane. A plain array literal containing
an inline lambda must preserve the function element type, keep the closure
unboxed in the array, and call through the array slot with the lambda body
return type.

## Requirements

**Requirements:** doc/02_requirements/feature/multicore_green.md

## Plan

**Plan:** doc/03_plan/sys_test/multicore_green.md

## Design

**Design:** doc/05_design/multicore_green.md

## Research

**Research:** doc/08_tracking/bug/native_function_value_array_literal_blocker_2026-06-11.md

## Syntax

```sh
src/compiler_rust/target/debug/simple test test/03_system/feature/usage/native_function_value_array_literal_regression_spec.spl --mode=interpreter --clean
```
"""

use std.spec.step

use std.spec.*


extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val SIMPLE_BIN: text = "src/compiler_rust/target/debug/simple"
val BUILD_DIR: text = "build/test/native_function_value_array_literal_regression"
val SOURCE_PATH: text = BUILD_DIR + "/function_value_array_literal_probe.spl"
val NATIVE_PATH: text = BUILD_DIR + "/function_value_array_literal_probe.bin"

fn shell(command: text) -> (text, i64):
    val (stdout, stderr, code) = rt_process_run("/bin/sh", ["-c", command])
    (stdout + stderr, code)

fn probe_source() -> text:
    [
        "fn main() -> i64:\n",
        "    println(\"before\")\n",
        "    val callbacks = [\\\\: 7]\n",
        "    val value = callbacks[0]()\n",
        "    println(\"value=\" + value.to_string())\n",
        "    if value != 7:\n",
        "        return 2\n",
        "    0\n"
    ].join("")

describe "native function value array literal regression":
    # @manual scenario evidence
    it "keeps inline lambda array literal native calls green":
        # @req REQ-SSPEC-SYSTEM
        step("keeps inline lambda array literal native calls green")
        step("Write the function-value array-literal probe")
        val _res_write_out = shell("mkdir -p " + BUILD_DIR + " && cat > " + SOURCE_PATH + " <<'EOF'\n" + probe_source() + "\nEOF")
        val write_out = _res_write_out.stdout
        val write_code = _res_write_out.exit_code
        expect(write_code).to_equal(0)

        step("Hosted native compile succeeds on the fixed lower path")
        val _res_compile_out = shell(SIMPLE_BIN + " compile " + SOURCE_PATH + " --native -o " + NATIVE_PATH)
        val compile_out = _res_compile_out.stdout
        val compile_code = _res_compile_out.exit_code
        expect(compile_code).to_equal(0)
        expect(compile_out).to_contain("Compiled")

        step("The native probe calls through the array literal and returns the lambda value")
        val _res_native_out = shell("sh -c '" + NATIVE_PATH + " >/tmp/native_fn_array_literal.out 2>&1; code=$?; cat /tmp/native_fn_array_literal.out; echo EXIT=$code'")
        val native_out = _res_native_out.stdout
        val native_code = _res_native_out.exit_code
        expect(native_code).to_equal(0)
        expect(native_out).to_contain("before")
        expect(native_out).to_contain("value=7")
        expect(native_out).to_contain("EXIT=0")

        step("The tracker records the closed lower blocker")
        val _res_blocker = shell("cat doc/08_tracking/bug/native_function_value_array_literal_blocker_2026-06-11.md")
        val blocker = _res_blocker.stdout
        val blocker_code = _res_blocker.exit_code
        expect(blocker_code).to_equal(0)
        expect(blocker).to_contain("Status: closed")
        expect(blocker).to_contain("array literal containing function values")
        expect(blocker).to_contain("value=7")
        expect(blocker).to_contain("EXIT=0")
