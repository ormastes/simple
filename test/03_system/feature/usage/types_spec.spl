"""
## Purpose and audience
Executable checks of the type-system basics for the language team: literal
typing, val/const mutability rules, var reassignment, generic array
containers, and basic Option-style nil handling. Scenarios embed the types
inline and read values back at runtime.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/types_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Advanced features (unit types,
capability effects, suspension operators) are not yet implemented and are
out of scope here.
## Verification guidance and troubleshooting
A failing scenario names the type feature that broke. If the file fails to
load at all, a type grammar rule stopped parsing and every scenario in this
file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: type-system-basics

describe "Types Spec":
    it "basic type literals":
        # @req REQ-TYPES-BASIC-001
        # @capture(bit_table): text, integer, and boolean literal round-trips
        step("Bind a string, an integer, and a boolean; read each back")
        val s = "hel" + "lo"
        val i = 6 * 7
        val b = 1 == 1
        val f = 3.14
        expect(s).to_equal("hello")  # oracle: the composed text matches the literal form
        expect(i).to_equal(42)  # oracle: the composed integer is 42
        expect(b).to_equal(true)  # oracle: the composed boolean is true
        expect(f > 3.0 and f < 4.0).to_equal(true)  # oracle: the float literal stays in (3,4)

    it "mutability rules - val and const":
        # @req REQ-TYPES-BASIC-002
        # @capture(bit_table): val and const bindings observed
        step("Bind through val and const and derive from each")
        val y = 4 * 5
        const MAX = 100
        expect(y).to_equal(20)  # oracle: the val binding holds the composed 20
        expect(MAX * 2).to_equal(200)  # oracle: the const value doubles to 200

    it "mutable variables":
        # @req REQ-TYPES-BASIC-003
        # @capture(bit_table): two reassignments observed
        step("Increment a var twice and read it")
        var count = 0
        count = count + 1
        count = count + 1
        expect(count).to_equal(2)  # oracle: two increments of zero

    it "generic container - array":
        # @req REQ-TYPES-BASIC-004
        # @capture(bit_table): typed array element reads
        step("Index into numeric and text arrays")
        val numbers = [1, 2, 3, 4, 5]
        val strings = ["a", "b", "c"]
        expect(numbers[0]).to_equal(1)  # oracle: element 0 of the numeric array
        expect(strings[1]).to_equal("b")  # oracle: element 1 of the text array

    it "option type basic usage":
        # @req REQ-TYPES-BASIC-005
        # @capture(bit_table): nil comparison on both bindings
        step("Distinguish a value binding from a nil binding")
        val some_val = 6 * 7
        val none_val = nil
        if some_val != nil:
            expect(some_val).to_equal(42)  # oracle: the value binding holds the composed 42
        expect(none_val == nil).to_equal(true)  # oracle: the nil binding equals nil
