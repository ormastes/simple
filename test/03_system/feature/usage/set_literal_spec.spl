"""
# Set Literal Syntax

**Feature ID:** #SYNTAX-003
**Category:** Syntax
**Status:** In Progress

## Overview

Tests the set type and its operations: creation with automatic duplicate
removal, empty sets, integer and string elements, trailing commas, single
elements, set operations (union, intersection, difference), conversion to
lists, functional operations (filter, map), and relational checks (subset,
disjoint).

The set TYPE and all of its OPERATIONS are implemented and exercised here
against the real `Set<T>`. The `s{...}` LITERAL form is not yet available on
the deployed compiler, so sets are constructed with `Set.from([...])`; the
remaining TODOs below mark exactly that gap and nothing else.

## Syntax

```simple
use std.nogc_sync_mut.src.set.{Set}

val nums = Set.from([1, 2, 3])
val union_set = a.union(b)
val evens = nums.filter(_1 % 2 == 0)
```
Set Literal Tests

Test set operations; set literal `s{1, 2, 3}` still pending.
"""

use std.nogc_sync_mut.src.set.{Set}


fn check(condition: bool):
    expect(condition).to_equal(true)

describe "Set Literals":
    # @manual scenario evidence
    it "creates empty set":
        # val empty = s{}  # TODO: Set literal syntax not yet implemented
        val empty: Set<i64> = Set.new()
        check empty.len() == 0

    it "creates set from integer elements":
        # val nums = s{1, 2, 3}  # TODO: Set literal syntax not yet implemented
        val nums = Set.from([1, 2, 3])
        check nums.len() == 3
        check nums.contains(1)
        check nums.contains(2)
        check nums.contains(3)

    it "removes duplicates automatically":
        # val nums = s{1, 2, 2, 3, 3, 3}  # TODO: Set literal syntax not yet implemented
        val nums = Set.from([1, 2, 2, 3, 3, 3])
        check nums.len() == 3
        check nums.contains(1)
        check nums.contains(2)
        check nums.contains(3)

    it "creates set from string elements":
        # val words = s{"hello", "world", "hello"}  # TODO: Set literal syntax not yet implemented
        val words = Set.from(["hello", "world", "hello"])
        check words.len() == 2
        check words.contains("hello")
        check words.contains("world")

    it "handles trailing comma":
        # val nums = s{1, 2, 3,}  # TODO: Set literal syntax not yet implemented
        val nums = Set.from([1, 2, 3,])
        check nums.len() == 3

    it "supports single element":
        # val single = s{42}  # TODO: Set literal syntax not yet implemented
        val single = Set.from([42])
        check single.len() == 1
        check single.contains(42)

    it "computes union":
        val a = Set.from([1, 2, 3])
        val b = Set.from([2, 3, 4])
        val union_ = a.union(b)
        check union_.len() == 4
        check union_.contains(1)
        check union_.contains(4)

    it "computes intersection":
        val a = Set.from([1, 2, 3])
        val b = Set.from([2, 3, 4])
        val common = a.intersect(b)
        check common.len() == 2
        check common.contains(2)
        check common.contains(3)

    it "computes difference":
        val a = Set.from([1, 2, 3])
        val b = Set.from([2, 3, 4])
        val diff = a.diff(b)
        check diff.len() == 1
        check diff.contains(1)

    it "supports filter":
        # val nums = s{1, 2, 3, 4, 5}  # TODO: Set literal syntax not yet implemented
        val nums = Set.from([1, 2, 3, 4, 5])
        val evens = nums.filter(_ % 2 == 0)
        check evens.len() == 2
        check evens.contains(2)
        check evens.contains(4)

    it "supports map":
        # val nums = s{1, 2, 3}  # TODO: Set literal syntax not yet implemented
        val nums = Set.from([1, 2, 3])
        val doubled = nums.map(_ * 2)
        check doubled.len() == 3
        check doubled.contains(2)
        check doubled.contains(4)
        check doubled.contains(6)

    it "checks subset":
        val small = Set.from([1, 2])
        val large = Set.from([1, 2, 3, 4])
        # All elements of small are in large
        check small.is_subset(large)
        # Not all elements of large are in small
        check not large.is_subset(small)

    it "checks disjoint":
        val a = Set.from([1, 2, 3])
        val b = Set.from([4, 5, 6])
        val c = Set.from([3, 4, 5])
        check a.is_disjoint(b)
        check not a.is_disjoint(c)
