# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Matrix Multiplication Operator (@)

**Feature ID:** OP-MATMUL
**Category:** Operators | Linear Algebra
**Status:** Implemented

The `@` operator performs matrix multiplication following NumPy semantics:
- Scalar @ Scalar: Element-wise multiplication
- 1D @ 1D: Dot product (inner product)
- 2D @ 2D: Matrix multiplication
- 2D @ 1D: Matrix-vector product
- 1D @ 2D: Vector-matrix product

## Implementation Details

Matrix multiplication is implemented in the interpreter with proper dimension checking
and automatic float/int promotion. Codegen mode delegates to the interpreter.

## Examples

```simple
# Scalars
use std.spec.step

val result = 3 @ 4  # 12

# Dot product
val v1 = [1, 2, 3]
val v2 = [4, 5, 6]
val dot = v1 @ v2  # 32

# Matrix multiplication
val a = [[1, 2], [3, 4]]
val b = [[5, 6], [7, 8]]
val c = a @ b  # [[19, 22], [43, 50]]

# Matrix-vector
val m = [[1, 2, 3], [4, 5, 6]]
val v = [7, 8, 9]
val result = m @ v  # [50, 122]
```
"""

describe "Matrix Multiplication - Scalar Operations":
    # @manual scenario evidence
    # Tests scalar @ scalar operations

    it "multiplies two integers":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies two integers")
        val result = 3 @ 4
        expect(result).to_equal(12)

    it "multiplies two floats":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies two floats")
        val result = 2.5 @ 4.0
        expect(result).to_equal(10.0)

    it "handles mixed int/float (int @ float)":
        # @req REQ-SSPEC-SYSTEM
        step("handles mixed int/float (int @ float)")
        val result = 3 @ 2.5
        expect(result).to_equal(7.5)

    it "handles mixed int/float (float @ int)":
        # @req REQ-SSPEC-SYSTEM
        step("handles mixed int/float (float @ int)")
        val result = 2.5 @ 3
        expect(result).to_equal(7.5)

    it "handles zero multiplication":
        # @req REQ-SSPEC-SYSTEM
        step("handles zero multiplication")
        val result = 0 @ 100
        expect(result).to_equal(0)

    it "handles negative numbers":
        # @req REQ-SSPEC-SYSTEM
        step("handles negative numbers")
        val result = (-3) @ 4
        expect(result).to_equal((-12))

    it "handles negative floats":
        # @req REQ-SSPEC-SYSTEM
        step("handles negative floats")
        val result = (-2.5) @ (-4.0)
        expect(result).to_equal(10.0)

describe "Matrix Multiplication - Dot Product (1D @ 1D)":
    # Tests 1D array dot products

    it "computes dot product of integer vectors":
        # @req REQ-SSPEC-SYSTEM
        step("computes dot product of integer vectors")
        val a = [1, 2, 3]
        val b = [4, 5, 6]
        val result = a @ b
        expect(result).to_equal(32  # 1*4 + 2*5 + 3*6 = 32)

    it "computes dot product of float vectors":
        # @req REQ-SSPEC-SYSTEM
        step("computes dot product of float vectors")
        val a = [1.0, 2.0, 3.0]
        val b = [4.0, 5.0, 6.0]
        val result = a @ b
        expect(result).to_equal(32.0)

    it "computes dot product with mixed int/float":
        # @req REQ-SSPEC-SYSTEM
        step("computes dot product with mixed int/float")
        val a = [1, 2, 3]
        val b = [1.5, 2.5, 3.5]
        val result = a @ b
        expect(result).to_equal(17.0  # 1*1.5 + 2*2.5 + 3*3.5)

    it "handles zero vector":
        # @req REQ-SSPEC-SYSTEM
        step("handles zero vector")
        val a = [1, 2, 3]
        val b = [0, 0, 0]
        val result = a @ b
        expect(result).to_equal(0)

    it "handles single element vectors":
        # @req REQ-SSPEC-SYSTEM
        step("handles single element vectors")
        val a = [5]
        val b = [3]
        val result = a @ b
        expect(result).to_equal(15)

    it "handles negative vectors":
        # @req REQ-SSPEC-SYSTEM
        step("handles negative vectors")
        val a = [1, -2, 3]
        val b = [-4, 5, -6]
        val result = a @ b
        expect(result).to_equal((-32)  # 1*(-4) + (-2)*5 + 3*(-6) = -32)

    it "handles orthogonal vectors (dot product = 0)":
        # @req REQ-SSPEC-SYSTEM
        step("handles orthogonal vectors (dot product = 0)")
        val a = [1, 0]
        val b = [0, 1]
        val result = a @ b
        expect(result).to_equal(0)

    it "computes dot product of longer vectors":
        # @req REQ-SSPEC-SYSTEM
        step("computes dot product of longer vectors")
        val a = [1, 2, 3, 4, 5]
        val b = [2, 3, 4, 5, 6]
        val result = a @ b
        expect(result).to_equal(70  # 2 + 6 + 12 + 20 + 30)

describe "Matrix Multiplication - 2D @ 2D":
    # Tests matrix @ matrix operations

    it "multiplies 2x2 matrices":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies 2x2 matrices")
        val a = [[1, 2], [3, 4]]
        val b = [[5, 6], [7, 8]]
        val c = a @ b
        expect(c).to_equal([[19, 22], [43, 50]])

    it "multiplies 2x3 and 3x2 matrices":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies 2x3 and 3x2 matrices")
        val a = [[1, 2, 3], [4, 5, 6]]
        val b = [[7, 8], [9, 10], [11, 12]]
        val c = a @ b
        expect(c[0].len()).to_equal(2)
        expect(c.len()).to_equal(2)
        expect(c[0][0]).to_equal(58)
        expect(c[0][1]).to_equal(64)
        expect(c[1][0]).to_equal(139)
        expect(c[1][1]).to_equal(154)

    it "multiplies identity matrix":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies identity matrix")
        val identity = [[1, 0], [0, 1]]
        val a = [[3, 4], [5, 6]]
        val result = identity @ a
        expect(result).to_equal(a)

    it "multiplies 3x3 identity":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies 3x3 identity")
        val a = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
        val b = [[2, 3, 4], [5, 6, 7], [8, 9, 10]]
        val c = a @ b
        expect(c).to_equal(b)

    it "handles 1x1 matrices":
        # @req REQ-SSPEC-SYSTEM
        step("handles 1x1 matrices")
        val a = [[5]]
        val b = [[3]]
        val c = a @ b
        expect(c).to_equal([[15]])

    it "handles rectangular matrices (tall @ wide)":
        # @req REQ-SSPEC-SYSTEM
        step("handles rectangular matrices (tall @ wide)")
        val a = [[1], [2], [3]]  # 3x1
        val b = [[4, 5, 6]]      # 1x3
        val c = a @ b            # 3x3
        expect(c).to_equal([[4, 5, 6], [8, 10, 12], [12, 15, 18]])

    it "handles zero matrix":
        # @req REQ-SSPEC-SYSTEM
        step("handles zero matrix")
        val a = [[1, 2], [3, 4]]
        val zero = [[0, 0], [0, 0]]
        val c = a @ zero
        expect(c).to_equal([[0, 0], [0, 0]])

    it "handles negative matrices":
        # @req REQ-SSPEC-SYSTEM
        step("handles negative matrices")
        val a = [[1, 2], [3, 4]]
        val b = [[-1, 0], [0, -1]]
        val c = a @ b
        expect(c).to_equal([[-1, -2], [-3, -4]])

describe "Matrix Multiplication - Matrix-Vector":
    # Tests matrix @ vector operations

    it "multiplies 2x3 matrix by 3x1 vector":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies 2x3 matrix by 3x1 vector")
        val a = [[1, 2, 3], [4, 5, 6]]
        val b = [7, 8, 9]
        val c = a @ b
        expect(c).to_equal([50, 122])

    it "multiplies 3x2 matrix by 2x1 vector":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies 3x2 matrix by 2x1 vector")
        val a = [[1, 2], [3, 4], [5, 6]]
        val b = [10, 20]
        val c = a @ b
        expect(c).to_equal([50, 110, 170])

    it "multiplies identity matrix by vector":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies identity matrix by vector")
        val identity = [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
        val v = [5, 10, 15]
        val result = identity @ v
        expect(result).to_equal(v)

    it "multiplies vector by matrix (1x2 @ 2x3)":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies vector by matrix (1x2 @ 2x3)")
        val a = [1, 2]
        val b = [[3, 4, 5], [6, 7, 8]]
        val c = a @ b
        expect(c).to_equal([15, 18, 21])

    it "multiplies vector by identity matrix":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies vector by identity matrix")
        val v = [5, 10]
        val identity = [[1, 0], [0, 1]]
        val result = v @ identity
        expect(result).to_equal(v)

    it "handles single column matrix":
        # @req REQ-SSPEC-SYSTEM
        step("handles single column matrix")
        val m = [[1], [2], [3]]
        val v = [4]
        val result = m @ v
        expect(result).to_equal([4, 8, 12])

describe "Matrix Multiplication - Float Promotion":
    # Tests automatic int/float promotion

    it "promotes int matrix to float when multiplied with float matrix":
        # @req REQ-SSPEC-SYSTEM
        step("promotes int matrix to float when multiplied with float matrix")
        val a = [[1, 2], [3, 4]]
        val b = [[1.5, 2.5], [3.5, 4.5]]
        val c = a @ b
        val expected = [[8.5, 11.5], [18.5, 25.5]]
        expect(c).to_equal(expected)

    it "promotes int vector to float when multiplied with float vector":
        # @req REQ-SSPEC-SYSTEM
        step("promotes int vector to float when multiplied with float vector")
        val a = [1, 2, 3]
        val b = [1.5, 2.5, 3.5]
        val result = a @ b
        expect(result).to_equal(17.0)

    it "handles mixed int/float matrix-vector":
        # @req REQ-SSPEC-SYSTEM
        step("handles mixed int/float matrix-vector")
        val m = [[1, 2], [3, 4]]
        val v = [1.5, 2.5]
        val result = m @ v
        expect(result).to_equal([6.5, 14.5])

describe "Matrix Multiplication - Special Matrices":
    # Tests special matrix properties

    it "multiplies diagonal matrices":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies diagonal matrices")
        val a = [[2, 0], [0, 3]]
        val b = [[4, 0], [0, 5]]
        val c = a @ b
        expect(c).to_equal([[8, 0], [0, 15]])

    it "multiplies upper triangular matrices":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies upper triangular matrices")
        val a = [[1, 2], [0, 3]]
        val b = [[4, 5], [0, 6]]
        val c = a @ b
        expect(c).to_equal([[4, 17], [0, 18]])

    it "multiplies symmetric matrix":
        # @req REQ-SSPEC-SYSTEM
        step("multiplies symmetric matrix")
        val a = [[1, 2], [2, 1]]
        val b = [[3, 4], [4, 3]]
        val c = a @ b
        expect(c).to_equal([[11, 10], [10, 11]])

describe "Matrix Multiplication - Mathematical Properties":
    # Tests that @ satisfies expected mathematical properties

    it "satisfies associativity: (A @ B) @ C == A @ (B @ C)":
        # @req REQ-SSPEC-SYSTEM
        step("satisfies associativity: (A @ B) @ C == A @ (B @ C)")
        val a = [[1, 2], [3, 4]]
        val b = [[5, 6], [7, 8]]
        val c = [[9, 10], [11, 12]]
        val left = (a @ b) @ c
        val right = a @ (b @ c)
        expect(left).to_equal(right)

    it "is NOT commutative: A @ B != B @ A (in general)":
        # @req REQ-SSPEC-SYSTEM
        step("is NOT commutative: A @ B != B @ A (in general)")
        val a = [[1, 2], [3, 4]]
        val b = [[5, 6], [7, 8]]
        val ab = a @ b
        val ba = b @ a
        assert_true(ab != ba)
