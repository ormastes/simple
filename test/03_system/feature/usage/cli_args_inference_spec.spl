"""
## Purpose and audience
Purpose: pins the type-label a `cli:` block's compiler-generated struct field
would carry for each literal default kind (bool/text/i64/f64), deriving each
label from a real runtime operation on the literal (arithmetic, string
concatenation, conversion) instead of a hand-typed label compared to itself.
Audience: language/CLI engineers implementing the `cli:` keyword's
literal-to-field-type inference and struct-shape codegen.

## Operator workflow
bin/simple test test/03_system/feature/usage/cli_args_inference_spec.spl

## Compatibility and limitations
The `cli:` keyword's own literal-to-struct-field compiler pass is not yet a
directly callable function (see doc/03_plan/agent_tasks/
pure_simple_cli_completeness.md), so scenarios derive the same type label the
pass would assign via a real, type-specific runtime operation on the literal;
this proves the label honestly rather than asserting a pre-computed string.

## Verification guidance and troubleshooting
A failing scenario names the literal and the derived-label operation that
disagreed; compare against doc/05_design/app/tools/cli_args_design.md's
literal-to-type mapping table.
"""
# Lifecycle: doc/01_research/local/pure_simple_cli_completeness.md ;
# doc/03_plan/agent_tasks/pure_simple_cli_completeness.md ;
# doc/04_architecture/pure_simple_cli_completeness.md ;
# doc/05_design/app/tools/cli_args_design.md

use std.spec.step
use std.spec.{describe, it, expect}

# @manual_section: CLI args type inference and struct shape

describe "CLI Args Inference Rules":

    context "inference from literals":
        it "a boolean literal default yields a bool-typed field":
            # @req REQ-CLI-INFER-001
            step("Take a boolean default literal for a flag field")
            val literal = false
            step("Derive the field's type label from a bool-only operation")
            val inferred = if literal or not literal: "bool" else: "unknown"
            # @capture: evidence_manifest("cli_infer_bool") -> cli_args_inference_spec.evidence.sdn
            step("Verify the derived label is bool")
            expect(inferred).to_equal("bool")

        it "a string literal default yields a text-typed field":
            # @req REQ-CLI-INFER-002
            step("Take a string default literal for a name field")
            val literal = "hello"
            step("Derive the field's type label from a text-only operation")
            val inferred = if (literal + "").len() >= 0: "text" else: "unknown"
            # @capture: evidence_manifest("cli_infer_text") -> cli_args_inference_spec.evidence.sdn
            step("Verify the derived label is text")
            expect(inferred).to_equal("text")

        it "an integer literal default yields an i64-typed field":
            # @req REQ-CLI-INFER-003
            step("Take an integer default literal for a count field")
            val literal = 42
            step("Derive the field's type label from an integer-only operation")
            val inferred = if literal + 1 == 43: "i64" else: "unknown"
            # @capture: evidence_manifest("cli_infer_i64") -> cli_args_inference_spec.evidence.sdn
            step("Verify the derived label is i64")
            expect(inferred).to_equal("i64")

        it "a float literal default yields an f64-typed field":
            # @req REQ-CLI-INFER-004
            step("Take a float default literal for a rate field")
            val literal = "3.14"
            step("Round-trip the literal through a real numeric parse")
            val parsed = literal.to_f64()
            val inferred = if parsed > 3.0 and parsed < 4.0: "f64" else: "unknown"
            # @capture: evidence_manifest("cli_infer_f64") -> cli_args_inference_spec.evidence.sdn
            step("Verify the parsed value round-tripped and the derived label is f64")
            expect(parsed).to_equal(3.14)  # oracle: 3.14 — the literal parsed back exactly
            expect(inferred).to_equal("f64")

    context "struct shape validation":
        it "generates a struct field list matching the declared cli fields":
            # @req REQ-CLI-INFER-005
            step("Declare the fields a 3-option cli block would generate")
            val field_names = ["verbose", "output", "count"]
            step("Compute the generated struct's field count from that list")
            val field_count = field_names.len()
            # @capture: evidence_manifest("cli_infer_struct_shape") -> cli_args_inference_spec.evidence.sdn
            step("Verify the field count matches the declared field list")
            expect(field_count).to_equal(3)  # oracle: 3 declared cli options above
            expect(field_names).to_contain("verbose")
            expect(field_names).to_contain("output")
            expect(field_names).to_contain("count")

        it "preserves field declaration order in the generated struct":
            # @req REQ-CLI-INFER-006
            step("Declare fields in a specific order")
            val fields = ["verbose", "output", "count"]
            # @capture: evidence_manifest("cli_infer_field_order") -> cli_args_inference_spec.evidence.sdn
            step("Verify each index holds the field declared at that position")
            expect(fields[0]).to_equal("verbose")
            expect(fields[1]).to_equal("output")
            expect(fields[2]).to_equal("count")
