    it "allows skip for test tagging preparation":
        step("Verify: allows skip for test tagging preparation")
        # Future: skip it "unimplemented test":
        #     expect false
        assert_true(true)

    it "parses skip with test metadata":
        step("Verify: parses skip with test metadata")
