use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_skip_keyword_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_skip_keyword_spec.md
# doc-path: doc/03_plan/sys_test/parser_skip_keyword_spec.md
# doc-path: doc/04_architecture/parser_skip_keyword_spec.md
# doc-path: doc/05_design/parser_skip_keyword_spec_oracles.md
# @manual: primary

"""
# Skip Keyword - Comprehensive

**Feature ID:** #PARSER-003
**Category:** Syntax
**Status:** Active

## Overview

Comprehensive tests for the `skip` keyword covering lexer token recognition,
statement parsing, control flow interactions (if, loop, break, continue, return),
function/method/lambda contexts, class/struct/impl blocks, async contexts,
match/pattern contexts, expression flow, error handling, edge cases
(nesting, comments, whitespace), and runtime semantics.

## Syntax

```simple
skip
skip:
val x = 1
fn with_skip(): skip; return 42
```
"""
describe "Skip keyword - lexer and token recognition":
    it "recognizes skip as a keyword token":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: recognizes skip as a keyword token")
        # Test that 'skip' is lexed as a keyword, not an identifier
        val keywords = ["break", "continue", "pass", "defer", "skip", "return"]
        expect(keywords.len()).to_equal(6)

    it "allows skip_func as function name":
        step("Verify: allows skip_func as function name")
        fn skip_func():
            return 42
        expect(skip_func()).to_equal(42)

    it "distinguishes skip keyword from skip variable name":
        step("Verify: distinguishes skip keyword from skip variable name")
        val skip_count = 10
        expect(skip_count).to_equal(10)

    it "allows skip in string literals":
        step("Verify: allows skip in string literals")
        val message = "Please skip this step"
        expect message.contains("skip")

describe "Skip keyword - basic statement parsing":
    it "parses skip as standalone statement":
        step("Verify: parses skip as standalone statement")
        var executed = true
        skip
        expect(executed).to_equal(true)

    it "parses skip with indented block":
        step("Verify: parses skip with indented block")
        skip:
            val x = 1
            val y = 2
        assert_true(true)

    it "parses multiple skip statements":
        step("Verify: parses multiple skip statements")
        skip
        skip
        skip
        assert_true(true)

describe "Skip keyword - control flow interactions":
    it "parses skip inside if block":
        step("Verify: parses skip inside if block")
        val condition = true
        if condition:
            skip
        assert_true(true)

    it "parses skip inside loop":
        step("Verify: parses skip inside loop")
        for i in 0..3:
            if i == 1:
                skip
        assert_true(true)

    it "parses skip with break in same function":
        step("Verify: parses skip with break in same function")
        for i in 0..5:
            if i == 2:
                break
            if i == 1:
                skip
        assert_true(true)

    it "parses skip with continue in same function":
        step("Verify: parses skip with continue in same function")
        var count = 0
        for i in 0..3:
            if i == 1:
                skip
            count = count + 1
        expect(count).to_equal(3)

    it "parses skip with return in same function":
        step("Verify: parses skip with return in same function")
        fn with_skip_and_return():
            skip
            return 42
        expect(with_skip_and_return()).to_equal(42)

describe "Skip keyword - function and method contexts":
    it "parses skip in function body":
        step("Verify: parses skip in function body")
        fn test_function():
            skip
            return "completed"
        expect(test_function()).to_equal("completed")

    it "parses skip in method body":
        step("Verify: parses skip in method body")
        class TestClass:
            fn test_method():
                skip
                return "method completed"

        val obj = TestClass()
        expect(obj.test_method()).to_equal("method completed")

    it "parses skip in static method":
        step("Verify: parses skip in static method")
        class StaticTest:
            static fn static_method():
                skip
                return "static completed"

        expect(StaticTest.static_method()).to_equal("static completed")

    it "parses skip in lambda":
        step("Verify: parses skip in lambda")
        val lambda_with_skip = \x:
            skip
            x * 2
        expect(lambda_with_skip(5)).to_equal(10)

describe "Skip keyword - class and struct contexts":
    it "parses skip in class method":
        step("Verify: parses skip in class method")
        class Container:
            value: i32

            fn process():
                skip
                return self.value

        val c = Container(value: 100)
        expect(c.process()).to_equal(100)

    it "parses skip in impl block method":
        step("Verify: parses skip in impl block method")
        struct Point:
            x: i64
            y: i64

        impl Point:
            fn distance():
                skip
                return 0.0

        val p = Point(x: 3, y: 4)
        expect(p.distance()).to_equal(0.0)

describe "Skip keyword - async contexts":
    it "parses skip in async function":
        step("Verify: parses skip in async function")
        async fn async_with_skip():
            skip
            return "async result"

        # Note: actual await testing requires async runtime
        assert_true(true)

    it "parses skip before await":
        step("Verify: parses skip before await")
        async fn skip_before_await():
            skip
            val result = 42
            return result

        assert_true(true)

describe "Skip keyword - match and pattern contexts":
    it "parses skip in match arm":
        step("Verify: parses skip in match arm")
        val x = 5
        val result = match x:
            case 1: "one"
            case 2:
                skip
                "two"
            case _: "other"
        expect(result).to_equal("other")

    it "parses skip in multiple match arms":
        step("Verify: parses skip in multiple match arms")
        val value = 10
        var count = 0
        match value:
            case 5:
                skip
            case 10:
                skip
                count = count + 1
            case _:
                skip
        expect(count).to_equal(1)

describe "Skip keyword - expression contexts":
    it "parses skip before expression":
        step("Verify: parses skip before expression")
        fn with_skip_expr():
            skip
            val result = 2 + 2
            return result
        expect(with_skip_expr()).to_equal(4)

    it "parses skip between declarations":
        step("Verify: parses skip between declarations")
        fn multi_decl():
            val a = 1
            skip
            val b = 2
            skip
            return a + b
        expect(multi_decl()).to_equal(3)

    it "parses skip in complex expression flow":
        step("Verify: parses skip in complex expression flow")
        fn complex_flow(x: i32):
            if x > 0:
                skip
                return x * 2
            else:
                skip
                return x
        expect(complex_flow(5)).to_equal(10)
        expect(complex_flow(-3)).to_equal(-3)

describe "Skip keyword - error handling contexts":
    it "parses skip in try-catch block":
        step("Verify: parses skip in try-catch block")
        fn with_try():
            # Note: actual error handling syntax may vary
            skip
            return "ok"
        expect(with_try()).to_equal("ok")

    it "parses skip before result return":
        step("Verify: parses skip before result return")
        fn result_with_skip() -> i32:
            skip
            return 42
        expect(result_with_skip()).to_equal(42)

describe "Skip keyword - edge cases and boundaries":
    it "parses skip at start of file":
        step("Verify: parses skip at start of file")
        skip
        assert_true(true)

    it "parses skip at end of function":
        step("Verify: parses skip at end of function")
        fn skip_at_end():
            val x = 1
            skip
        assert_true(true)

    it "parses skip with empty block":
        step("Verify: parses skip with empty block")
        skip:
            pass
        assert_true(true)

    it "parses nested skip statements":
        step("Verify: parses nested skip statements")
        if true:
            skip:
                skip
        assert_true(true)

    it "parses skip with comment":
        step("Verify: parses skip with comment")
        skip  # This is skipped
        assert_true(true)

    it "parses skip with multiline comment":
        step("Verify: parses skip with multiline comment")
        skip  /*
            Multiline comment
            about skipping
        */
        assert_true(true)

describe "Skip keyword - indentation and whitespace":
    it "parses skip with various indentation":
        step("Verify: parses skip with various indentation")
        fn indented():
            skip
            if true:
                skip
                for i in 0..1:
                    skip
        assert_true(true)

    it "parses skip with no trailing whitespace":
        step("Verify: parses skip with no trailing whitespace")
        skip
        val x = 1
        expect(x).to_equal(1)

    it "parses skip with blank lines after":
        step("Verify: parses skip with blank lines after")
        skip

        val y = 2
        expect(y).to_equal(2)

describe "Skip keyword - semantics and runtime behavior":
    it "skip statement does not prevent execution":
        step("Verify: skip statement does not prevent execution")
        var executed = false
        skip
        executed = true
        expect(executed).to_equal(true)

    it "skip does not affect variable scope":
        step("Verify: skip does not affect variable scope")
        skip
        val scoped = 100
        expect(scoped).to_equal(100)

    it "skip does not affect return value":
        step("Verify: skip does not affect return value")
        fn returns_with_skip():
            skip
            return "value"
        expect(returns_with_skip()).to_equal("value")

    it "skip does not affect loop iteration":
        step("Verify: skip does not affect loop iteration")
        var iterations = 0
        for i in 0..5:
            skip
            iterations = iterations + 1
        expect(iterations).to_equal(5)

