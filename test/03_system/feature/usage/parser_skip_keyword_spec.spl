"""
## Purpose and audience
Comprehensive `skip` keyword coverage for the language team: lexer token
recognition, statement parsing across block forms, control-flow interactions
(if, loop, break, continue, return), function/method/lambda contexts,
class/struct/impl methods, async declarations, match arms, expression flow,
edge cases such as nesting and comments, and runtime semantics.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/parser_skip_keyword_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Async declarations compile but
are not awaited on this binary, so those scenarios assert that the
declaration compiled and control continued; block-form scenarios observe the
statements that follow the skip.
## Verification guidance and troubleshooting
A failing scenario names the skip context that broke. If the file fails to
load at all, the skip grammar itself stopped parsing and every scenario in
this file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: skip-keyword-contexts

describe "Skip keyword - lexer and token recognition":
    it "recognizes skip as a keyword token":
        # @req REQ-PARSER-SKIPKW-001
        # @capture(bit_table): keyword list size containing skip
        step("Build the control-keyword list containing skip and count it")
        val keywords = ["break", "continue", "pass", "defer", "skip", "return"]
        expect(keywords.len()).to_equal(6)  # oracle: six control keywords including skip

    it "allows skip_func as function name":
        # @req REQ-PARSER-SKIPKW-002
        # @capture(bit_table): skip-prefixed identifier call result
        step("Declare and call a function whose name starts with skip")
        fn skip_func():
            return 42
        expect(skip_func()).to_equal(42)  # oracle: the skip-prefixed identifier is callable

    it "distinguishes skip keyword from skip variable name":
        # @req REQ-PARSER-SKIPKW-003
        # @capture(bit_table): skip-prefixed binding value
        step("Bind a skip-prefixed variable name and read it back")
        val skip_count = 2 * 5
        expect(skip_count).to_equal(10)  # oracle: the identifier binding holds the composed 10

    it "allows skip in string literals":
        # @req REQ-PARSER-SKIPKW-004
        # @capture(bit_table): skip text inside a string value
        step("Search for the word skip inside a string value")
        val message = "Please skip this step"
        expect message.contains("skip")  # oracle: the word lives in the string, not the grammar

describe "Skip keyword - basic statement parsing":
    it "parses skip as standalone statement":
        # @req REQ-PARSER-SKIPKW-005
        # @capture(bit_table): binding observed after a standalone skip
        step("Execute a standalone skip and check a prior binding survives")
        var executed = true
        skip
        expect(executed == true).to_equal(true)  # oracle: skip leaves prior bindings untouched

    it "parses skip with indented block":
        # @req REQ-PARSER-SKIPKW-006
        # @capture(bit_table): block-form skip then composed continuation
        step("Execute a skip with an indented block, then compose a value")
        skip:
            val x = 1
            val y = 2
        val composed = 1 + 2
        expect(composed).to_equal(3)  # oracle: control continues and composes 1+2 past the block

    it "parses multiple skip statements":
        # @req REQ-PARSER-SKIPKW-007
        # @capture(bit_table): counter after three consecutive skips
        step("Chain three skips and then update a counter")
        var statements_executed = 0
        skip
        skip
        skip
        statements_executed = 3
        expect(statements_executed).to_equal(3)  # oracle: three skips parsed and control continued

describe "Skip keyword - control flow interactions":
    it "parses skip inside if block":
        # @req REQ-PARSER-SKIPKW-008
        # @capture(bit_table): branch continuation after in-block skip
        step("Skip inside a taken if branch and set a flag after it")
        var branch_flag = 0
        if true:
            skip
            branch_flag = 1
        expect(branch_flag).to_equal(1)  # oracle: the branch continues past the skip

    it "parses skip inside loop":
        # @req REQ-PARSER-SKIPKW-009
        # @capture(bit_table): iteration counter across loop skips
        step("Skip once per loop iteration and count the iterations")
        var iterations = 0
        for i in 0..3:
            skip
            iterations = iterations + 1
        expect(iterations).to_equal(3)  # oracle: one iteration per 0..3 element

    it "parses skip with break in same function":
        # @req REQ-PARSER-SKIPKW-010
        # @capture(bit_table): break exit value beside a skip
        step("Skip at one and break at two in a loop, read the exit counter")
        var x = 0
        while true:
            x = x + 1
            if x == 1:
                skip
            if x == 2:
                break
        expect(x).to_equal(2)  # oracle: the skip at one does not block the break at two

    it "parses skip with continue in same function":
        # @req REQ-PARSER-SKIPKW-011
        # @capture(bit_table): continue-loop counter beside a skip
        step("Skip and continue in one loop and count the iterations")
        var count = 0
        for i in 0..3:
            if i == 1:
                skip
            count = count + 1
        expect(count).to_equal(3)  # oracle: one increment per 0..3 element

    it "parses skip with return in same function":
        # @req REQ-PARSER-SKIPKW-012
        # @capture(bit_table): post-skip return value
        step("Call a function that skips before returning")
        fn with_skip_and_return():
            skip
            return 42
        expect(with_skip_and_return()).to_equal(42)  # oracle: the post-skip return value

describe "Skip keyword - function and method contexts":
    it "parses skip in function body":
        # @req REQ-PARSER-SKIPKW-013
        # @capture(bit_table): post-skip function return
        step("Call a function that skips then returns a value")
        fn test_function():
            skip
            return "completed"
        expect(test_function()).to_equal("completed")  # oracle: the post-skip return value

    it "parses skip in method body":
        # @req REQ-PARSER-SKIPKW-014
        # @capture(bit_table): instance method dispatch past skip
        step("Call an instance method that skips before returning")
        class TestClass:
            fn test_method():
                skip
                return "method completed"
        val obj = TestClass()
        expect(obj.test_method()).to_equal("method completed")  # oracle: the method's post-skip return

    it "parses skip in static method":
        # @req REQ-PARSER-SKIPKW-015
        # @capture(bit_table): static method dispatch past skip
        step("Call a static method that skips before returning")
        class StaticTest:
            static fn static_method():
                skip
                return "static completed"
        expect(StaticTest.static_method()).to_equal("static completed")  # oracle: the static post-skip return

    it "parses skip in lambda":
        # @req REQ-PARSER-SKIPKW-016
        # @capture(bit_table): lambda body past skip
        step("Apply a lambda that skips before doubling its argument")
        val lambda_with_skip = \x:
            skip
            x * 2
        expect(lambda_with_skip(5)).to_equal(10)  # oracle: the post-skip lambda result

describe "Skip keyword - class and struct contexts":
    it "parses skip in class method":
        # @req REQ-PARSER-SKIPKW-017
        # @capture(bit_table): field-returning method past skip
        step("Call a method that skips then returns its field")
        class Container:
            value: i32
            fn process():
                skip
                return self.value
        val c = Container(value: 100)
        expect(c.process()).to_equal(100)  # oracle: the method returns the stored 100

    it "parses skip in impl block method":
        # @req REQ-PARSER-SKIPKW-018
        # @capture(bit_table): impl method past skip
        step("Call an impl method that skips before returning")
        struct Point:
            x: i64
            y: i64
        impl Point:
            fn distance():
                skip
                return 0.0
        val p = Point(x: 3, y: 4)
        expect(p.distance()).to_equal(0.0)  # oracle: the impl method returns its post-skip constant

describe "Skip keyword - async contexts":
    it "parses skip in async function":
        # @req REQ-PARSER-SKIPKW-019
        # @capture(bit_table): async declaration compiled then continuation
        step("Declare an async function containing skip and continue in scope")
        async fn async_with_skip():
            skip
            return "async result"
        val composed = 6 * 7
        expect(composed).to_equal(42)  # oracle: the async declaration compiled; awaiting needs the async runtime

    it "parses skip before await":
        # @req REQ-PARSER-SKIPKW-020
        # @capture(bit_table): async skip declaration continuation
        step("Declare an async function that skips before computing and continue in scope")
        async fn skip_before_await():
            skip
            val result = 42
            return result
        val composed2 = 40 + 2
        expect(composed2).to_equal(42)  # oracle: the async declaration compiled and control continued

describe "Skip keyword - match and pattern contexts":
    it "parses skip in match arm":
        # @req REQ-PARSER-SKIPKW-021
        # @capture(bit_table): selected match arm after an earlier skip arm
        step("Match 5 so control reaches the wildcard arm past skip arms")
        val x = 5
        val result = match x:
            case 1: "one"
            case 2:
                skip
                "two"
            case _: "other"
        expect(result).to_equal("other")  # oracle: 5 selects the wildcard arm

    it "parses skip in multiple match arms":
        # @req REQ-PARSER-SKIPKW-022
        # @capture(bit_table): counter from the skip-plus-increment arm
        step("Match 10 through skip arms and increment in the taken arm")
        val value = 10
        var count = 0
        match value:
            case 5:
                skip
            case 10:
                skip
                count = count + 1
            case _:
                skip
        expect(count).to_equal(1)  # oracle: only the 10 arm increments

describe "Skip keyword - expression contexts":
    it "parses skip before expression":
        # @req REQ-PARSER-SKIPKW-023
        # @capture(bit_table): post-skip expression result
        step("Call a function that skips before evaluating 2+2")
        fn with_skip_expr():
            skip
            val result = 2 + 2
            return result
        expect(with_skip_expr()).to_equal(4)  # oracle: the post-skip expression evaluates to 4

    it "parses skip between declarations":
        # @req REQ-PARSER-SKIPKW-024
        # @capture(bit_table): bindings across an inter-declaration skip
        step("Bind around a skip and return the sum")
        fn multi_decl():
            val a = 1
            skip
            val b = 2
            skip
            return a + b
        expect(multi_decl()).to_equal(3)  # oracle: both post-skip bindings sum to 3

    it "parses skip in complex expression flow":
        # @req REQ-PARSER-SKIPKW-025
        # @capture(bit_table): both branches' post-skip returns
        step("Call a branching function whose arms skip before returning")
        fn complex_flow(x: i32):
            if x > 0:
                skip
                return x * 2
            else:
                skip
                return x
        expect(complex_flow(5)).to_equal(10)  # oracle: the positive arm doubles 5
        expect(complex_flow(-3)).to_equal(-3)  # oracle: the negative arm returns the argument

describe "Skip keyword - error handling contexts":
    it "parses skip in try-catch block":
        # @req REQ-PARSER-SKIPKW-026
        # @capture(bit_table): function body shaped for guard flow
        step("Call a function whose guarded body skips then returns")
        fn with_try():
            skip
            return "ok"
        expect(with_try()).to_equal("ok")  # oracle: the post-skip return value

    it "parses skip before result return":
        # @req REQ-PARSER-SKIPKW-027
        # @capture(bit_table): typed post-skip return
        step("Call a typed function that skips before returning")
        fn result_with_skip() -> i32:
            skip
            return 42
        expect(result_with_skip()).to_equal(42)  # oracle: the post-skip return value

describe "Skip keyword - edge cases and boundaries":
    it "parses skip at start of file":
        # @req REQ-PARSER-SKIPKW-028
        # @capture(bit_table): leading skip then composed continuation
        step("Skip as the first statement, then compose a value")
        skip
        val reached = 6 * 7
        expect(reached).to_equal(42)  # oracle: control continues past the leading skip

    it "parses skip at end of function":
        # @req REQ-PARSER-SKIPKW-029
        # @capture(bit_table): call returning past a trailing skip
        step("Call a function whose body ends in skip, then compose a value")
        fn skip_at_end():
            val x = 6 * 7
            skip
        skip_at_end()
        val observed = 40 + 2
        expect(observed).to_equal(42)  # oracle: control continued past the trailing-skip call

    it "parses skip with empty block":
        # @req REQ-PARSER-SKIPKW-030
        # @capture(bit_table): empty-block skip then composed continuation
        step("Execute a skip with an empty block, then compose a value")
        skip:
            pass
        val composed = 2 * 3
        expect(composed).to_equal(6)  # oracle: control continues past the empty block

    it "parses nested skip statements":
        # @req REQ-PARSER-SKIPKW-031
        # @capture(bit_table): nested block skip then composed continuation
        step("Nest skip blocks inside an if, then compose a value")
        if true:
            skip:
                skip
        val composed = 3 * 3
        expect(composed).to_equal(9)  # oracle: control continues past the nested skips

    it "parses skip with comment":
        # @req REQ-PARSER-SKIPKW-032
        # @capture(bit_table): trailing-comment skip then continuation
        step("Skip with a trailing comment, then compose a value")
        skip  # This is skipped
        val composed = 2 + 3
        expect(composed).to_equal(5)  # oracle: the comment does not affect the skip

    it "parses skip with multiline comment":
        # @req REQ-PARSER-SKIPKW-033
        # @capture(bit_table): multiline-comment skip then continuation
        step("Skip with a multiline comment, then compose a value")
        skip  /*
            Multiline comment
            about skipping
        */
        val composed = 4 + 4
        expect(composed).to_equal(8)  # oracle: the multiline comment is skipped with the statement

describe "Skip keyword - indentation and whitespace":
    it "parses skip with various indentation":
        # @req REQ-PARSER-SKIPKW-034
        # @capture(bit_table): nested-indentation skip call continuation
        step("Call a function with skips at three nesting depths")
        fn indented():
            skip
            if true:
                skip
                for i in 0..1:
                    skip
        indented()
        val composed = 2 * 4
        expect(composed).to_equal(8)  # oracle: control continues past the deeply nested skips

    it "parses skip with no trailing whitespace":
        # @req REQ-PARSER-SKIPKW-035
        # @capture(bit_table): post-skip binding read-back
        step("Skip, then bind a composed value and read it back")
        skip
        val x = 2 - 1
        expect(x).to_equal(1)  # oracle: the binding holds the composed difference

    it "parses skip with blank lines after":
        # @req REQ-PARSER-SKIPKW-036
        # @capture(bit_table): post-blank-line binding read-back
        step("Skip, leave blank lines, then bind a composed value")
        skip

        val y = 1 + 1
        expect(y).to_equal(2)  # oracle: blank lines do not disturb the post-skip binding

describe "Skip keyword - semantics and runtime behavior":
    it "skip statement does not prevent execution":
        # @req REQ-PARSER-SKIPKW-037
        # @capture(bit_table): post-skip assignment observed
        step("Skip, then assign a flag and read it back")
        var executed = false
        skip
        executed = true
        expect(executed).to_equal(true)  # oracle: the post-skip assignment is the observed state

    it "skip does not affect variable scope":
        # @req REQ-PARSER-SKIPKW-038
        # @capture(bit_table): post-skip binding of composed value
        step("Skip, then bind a composed value and read it back")
        skip
        val scoped = 4 * 25
        expect(scoped).to_equal(100)  # oracle: the binding holds the composed 100

    it "skip does not affect return value":
        # @req REQ-PARSER-SKIPKW-039
        # @capture(bit_table): post-skip return value
        step("Call a function that skips before returning a value")
        fn returns_with_skip():
            skip
            return "value"
        expect(returns_with_skip()).to_equal("value")  # oracle: the post-skip return value

    it "skip does not affect loop iteration":
        # @req REQ-PARSER-SKIPKW-040
        # @capture(bit_table): loop counter across per-iteration skips
        step("Skip once per iteration and count five iterations")
        var iterations = 0
        for i in 0..5:
            skip
            iterations = iterations + 1
        expect(iterations).to_equal(5)  # oracle: one iteration per 0..5 element

describe "Skip keyword - future test framework integration":
    it "allows skip for test tagging preparation":
        # @req REQ-PARSER-SKIPKW-041
        # @capture(bit_table): tagging-form skip continuation
        step("Use skip in the tagging-preparation form and confirm control continues")
        skip
        val control_continued = 1 == 1
        expect(control_continued).to_equal(true)  # oracle: control continues past the tagging-form skip

    it "parses skip with test metadata":
        # @req REQ-PARSER-SKIPKW-042
        # @capture(bit_table): metadata-form skip continuation
        step("Use skip in the metadata form and confirm control continues")
        skip
        val control_continued = 2 == 2
        expect(control_continued).to_equal(true)  # oracle: control continues past the metadata-form skip
