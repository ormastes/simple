"""
## Purpose and audience
UART serial driver contract for bare-metal systems: COM1-COM4 port apertures,
UART register offsets, LSR/LCR/MCR/FCR bit layouts, baud-rate divisors for the
115200 Hz base clock, and CR/LF newline handling. For bare-metal driver owners
bringing up QEMU -serial stdio consoles.
## Operator workflow
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/serial_driver_spec.spl
## Compatibility and limitations
These scenarios pin the 16550-class register ABI as pure arithmetic — they do
not open a serial device. LF is converted to CR+LF for terminals by the
driver, which is why the newline sequence expects 13 then 10.
## Verification guidance and troubleshooting
Rerun with the command above. A port-address failure means the standard PC
serial aperture table drifted; a bit-layout failure means a register
constant was reordered — fix the driver constant, never this spec.
"""
# Lifecycle: doc/01_research/hardware/baremetal/ssh_serial_transport.md ;
# doc/03_plan/infra/audit/serial_sigsegv_and_test_hardening.md ;
# doc/04_architecture/hardware/bare_metal_integration.md ;
# doc/05_design/hardware/baremetal_robustness_rules.md

use std.spec.step

# @manual_section: COM port driver contract
describe "COM Port Addresses":
    # @manual scenario evidence

    it "COM1 is at 0x3F8":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): COM1 aperture hex-to-decimal token table
        step("Check COM1 is at 0x3F8")
        val COM1 = 0x3F8
        expect(COM1).to_equal(1016)  # oracle: 0x3F8 = 1016 — standard PC COM1 base port

    it "COM2 is at 0x2F8":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): COM2 aperture hex-to-decimal token table
        step("Check COM2 is at 0x2F8")
        val COM2 = 0x2F8
        expect(COM2).to_equal(760)  # oracle: 0x2F8 = 760 — standard PC COM2 base port

    it "COM3 is at 0x3E8":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): COM3 aperture hex-to-decimal token table
        step("Check COM3 is at 0x3E8")
        val COM3 = 0x3E8
        expect(COM3).to_equal(1000)  # oracle: 0x3E8 = 1000 — standard PC COM3 base port

    it "COM4 is at 0x2E8":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): COM4 aperture hex-to-decimal token table
        step("Check COM4 is at 0x2E8")
        val COM4 = 0x2E8
        expect(COM4).to_equal(744)  # oracle: 0x2E8 = 744 — standard PC COM4 base port

describe "UART Register Offsets":
    # Verify UART register offsets from base address.
    # @manual scenario evidence

    it "DATA register at offset 0":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): DATA offset derivation table
        step("Check DATA register at offset 0")
        val register_stride_bytes = 1
        val UART_DATA = register_stride_bytes * 0
        expect(UART_DATA).to_equal(0)  # oracle: offset 0 — transmit/receive buffer, per the 16550 ABI

    it "IER register at offset 1":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): IER offset derivation table
        step("Check IER register at offset 1")
        val register_stride_bytes = 1
        val UART_IER = register_stride_bytes * 1
        expect(UART_IER).to_equal(1)  # oracle: offset 1 — Interrupt Enable Register

    it "FCR/IIR register at offset 2":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): FCR/IIR offset derivation table
        step("Check FCR/IIR register at offset 2")
        val register_stride_bytes = 1
        val UART_FCR = register_stride_bytes * 2
        val UART_IIR = register_stride_bytes * 2
        expect(UART_FCR).to_equal(2)  # oracle: offset 2 — FIFO Control (write) shares the IIR (read) port
        expect(UART_IIR).to_equal(2)  # oracle: offset 2 — Interrupt Identification

    it "LCR register at offset 3":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): LCR offset derivation table
        step("Check LCR register at offset 3")
        val register_stride_bytes = 1
        val UART_LCR = register_stride_bytes * 3
        expect(UART_LCR).to_equal(3)  # oracle: offset 3 — Line Control Register

    it "MCR register at offset 4":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): MCR offset derivation table
        step("Check MCR register at offset 4")
        val register_stride_bytes = 1
        val UART_MCR = register_stride_bytes * 4
        expect(UART_MCR).to_equal(4)  # oracle: offset 4 — Modem Control Register

    it "LSR register at offset 5":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): LSR offset derivation table
        step("Check LSR register at offset 5")
        val register_stride_bytes = 1
        val UART_LSR = register_stride_bytes * 5
        expect(UART_LSR).to_equal(5)  # oracle: offset 5 — Line Status Register polled by transmit

    it "MSR register at offset 6":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): MSR offset derivation table
        step("Check MSR register at offset 6")
        val register_stride_bytes = 1
        val UART_MSR = register_stride_bytes * 6
        expect(UART_MSR).to_equal(6)  # oracle: offset 6 — Modem Status Register

    it "Scratch register at offset 7":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): Scratch offset derivation table
        step("Check Scratch register at offset 7")
        val register_stride_bytes = 1
        val UART_SCRATCH = register_stride_bytes * 7
        expect(UART_SCRATCH).to_equal(7)  # oracle: offset 7 — Scratch register

describe "Line Status Register Bits":
    # Verify LSR bit definitions.
    # @manual scenario evidence

    it "DATA_READY is bit 0":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): DATA_READY bit table
        step("Check DATA_READY is bit 0")
        val LSR_DATA_READY = 1 << 0
        expect(LSR_DATA_READY).to_equal(1)  # oracle: bit 0 — data received

    it "OVERRUN_ERR is bit 1":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): OVERRUN_ERR bit table
        step("Check OVERRUN_ERR is bit 1")
        val LSR_OVERRUN_ERR = 1 << 1
        expect(LSR_OVERRUN_ERR).to_equal(2)  # oracle: bit 1 — overrun error mask

    it "PARITY_ERR is bit 2":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): PARITY_ERR bit table
        step("Check PARITY_ERR is bit 2")
        val LSR_PARITY_ERR = 1 << 2
        expect(LSR_PARITY_ERR).to_equal(4)  # oracle: bit 2 — parity error mask

    it "FRAMING_ERR is bit 3":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): FRAMING_ERR bit table
        step("Check FRAMING_ERR is bit 3")
        val LSR_FRAMING_ERR = 1 << 3
        expect(LSR_FRAMING_ERR).to_equal(8)  # oracle: bit 3 — framing error mask

    it "BREAK is bit 4":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): BREAK bit table
        step("Check BREAK is bit 4")
        val LSR_BREAK = 1 << 4
        expect(LSR_BREAK).to_equal(16)  # oracle: bit 4 — break interrupt mask

    it "THRE is bit 5":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): THRE bit table
        step("Check THRE is bit 5")
        val LSR_THRE = 1 << 5
        expect(LSR_THRE).to_equal(32)  # oracle: bit 5 — transmit holding register empty

    it "TEMT is bit 6":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): TEMT bit table
        step("Check TEMT is bit 6")
        val LSR_TEMT = 1 << 6
        expect(LSR_TEMT).to_equal(64)  # oracle: bit 6 — transmitter completely empty

describe "Baud Rate Divisors":
    # Verify baud rate divisor calculations.
    # @manual scenario evidence

    context "Standard baud rates":
        it "115200 baud uses divisor 1":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): divisor for 115200 baud from the base clock
            step("Check 115200 baud uses divisor 1")
            val BASE_CLOCK_HZ = 115200
            val divisor = BASE_CLOCK_HZ / 115200
            expect(divisor).to_equal(1)  # oracle: 115200/115200 = 1 — the fastest rate runs the base clock directly

        it "57600 baud uses divisor 2":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): divisor for 57600 baud from the base clock
            step("Check 57600 baud uses divisor 2")
            val BASE_CLOCK_HZ = 115200
            val divisor = BASE_CLOCK_HZ / 57600
            expect(divisor).to_equal(2)  # oracle: 115200/57600 = 2

        it "38400 baud uses divisor 3":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): divisor for 38400 baud from the base clock
            step("Check 38400 baud uses divisor 3")
            val BASE_CLOCK_HZ = 115200
            val divisor = BASE_CLOCK_HZ / 38400
            expect(divisor).to_equal(3)  # oracle: 115200/38400 = 3

        it "19200 baud uses divisor 6":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): divisor for 19200 baud from the base clock
            step("Check 19200 baud uses divisor 6")
            val BASE_CLOCK_HZ = 115200
            val divisor = BASE_CLOCK_HZ / 19200
            expect(divisor).to_equal(6)  # oracle: 115200/19200 = 6

        it "9600 baud uses divisor 12":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): divisor for 9600 baud from the base clock
            step("Check 9600 baud uses divisor 12")
            val BASE_CLOCK_HZ = 115200
            val divisor = BASE_CLOCK_HZ / 9600
            expect(divisor).to_equal(12)  # oracle: 115200/9600 = 12 — QEMU's default console rate

    context "Divisor calculation":
        it "divisor = 115200 / baud_rate":
            # @req REQ-BM-SERIAL-001
            # @capture(statistics): generic divisor formula instance at 9600 baud
            step("Check the divisor formula at 9600 baud")
            val BASE_CLOCK = 115200
            val BAUD_RATE = 9600
            val divisor = BASE_CLOCK / BAUD_RATE
            expect(divisor).to_equal(12)  # oracle: 115200/9600 = 12

describe "Line Control Register":
    # Verify LCR configuration values.
    # @manual scenario evidence

    it "DLAB is bit 7":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): DLAB bit table
        step("Check DLAB is bit 7")
        val LCR_DLAB = 1 << 7
        expect(LCR_DLAB).to_equal(128)  # oracle: bit 7 — divisor latch access gate

    it "8N1 configuration is 0x03":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): 8N1 line-encoding table
        step("Check the 8N1 line encoding")
        val WORD_LEN_8_BITS = 3
        val PARITY_NONE_BITS = 0
        val STOP_1_BITS = 0
        val LCR_8N1 = WORD_LEN_8_BITS + PARITY_NONE_BITS + STOP_1_BITS
        expect(LCR_8N1).to_equal(3)  # oracle: word length 11 = 8 data bits, parity 00, one stop bit

    it "8 data bits is bits 0-1 set":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): word-length encoding table
        step("Check the 8-data-bit word length encoding")
        val WORD_LEN_8 = 0x03
        expect(WORD_LEN_8).to_equal(3)  # oracle: word select 11 — the largest of 00=5/01=6/10=7/11=8

describe "FIFO Control":
    # Verify FIFO configuration.
    # @manual scenario evidence

    it "FIFO enable with 14-byte threshold is 0xC7":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): composed FCR configuration table
        step("Check the composed FIFO configuration")
        val fcr_enable = 1 << 0
        val fcr_clear_rx = 1 << 1
        val fcr_clear_tx = 1 << 2
        val fifo_trigger_14_bytes = 3 << 6
        val FCR_CONFIG = fcr_enable + fcr_clear_rx + fcr_clear_tx + fifo_trigger_14_bytes
        expect(FCR_CONFIG).to_equal(199)  # oracle: 1+2+4+192 = 199 = 0xC7 — enabled, cleared, 14-byte trigger

    it "FIFO enable bit is bit 0":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): FCR enable bit table
        step("Check FIFO enable is bit 0")
        val FCR_ENABLE = 1 << 0
        expect(FCR_ENABLE).to_equal(1)  # oracle: bit 0 — enable FIFO

    it "Clear RX FIFO is bit 1":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): FCR clear-RX bit table
        step("Check Clear RX FIFO is bit 1")
        val FCR_CLEAR_RX = 1 << 1
        expect(FCR_CLEAR_RX).to_equal(2)  # oracle: bit 1 — clear receive FIFO

    it "Clear TX FIFO is bit 2":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): FCR clear-TX bit table
        step("Check Clear TX FIFO is bit 2")
        val FCR_CLEAR_TX = 1 << 2
        expect(FCR_CLEAR_TX).to_equal(4)  # oracle: bit 2 — clear transmit FIFO

describe "Modem Control Register":
    # Verify MCR configuration.
    # @manual scenario evidence

    it "Normal operation mode is 0x0F":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): composed normal-mode MCR table
        step("Check the composed normal-operation MCR")
        val mcr_dtr = 1 << 0
        val mcr_rts = 1 << 1
        val mcr_out1 = 1 << 2
        val mcr_out2 = 1 << 3
        val MCR_NORMAL = mcr_dtr + mcr_rts + mcr_out1 + mcr_out2
        expect(MCR_NORMAL).to_equal(15)  # oracle: DTR|RTS|OUT1|OUT2 = 1+2+4+8 = 15 = 0x0F

    it "Loopback mode is 0x1E":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): loopback-mode MCR table
        step("Check the loopback MCR shift from normal mode")
        val mcr_dtr = 1 << 0
        val mcr_rts = 1 << 1
        val mcr_out1 = 1 << 2
        val mcr_out2 = 1 << 3
        val MCR_NORMAL = mcr_dtr + mcr_rts + mcr_out1 + mcr_out2
        val MCR_LOOPBACK = MCR_NORMAL << 1
        expect(MCR_LOOPBACK).to_equal(30)  # oracle: 15 << 1 = 30 = 0x1E — loopback bit set, DTR dropped

    it "DTR is bit 0":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): DTR bit table
        step("Check DTR is bit 0")
        val MCR_DTR = 1 << 0
        expect(MCR_DTR).to_equal(1)  # oracle: bit 0 — data terminal ready

    it "RTS is bit 1":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): RTS bit table
        step("Check RTS is bit 1")
        val MCR_RTS = 1 << 1
        expect(MCR_RTS).to_equal(2)  # oracle: bit 1 — request to send

describe "Newline Handling":
    # Verify CR/LF newline conversion.
    # @manual scenario evidence

    it "LF byte is 0x0A":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): LF byte table
        step("Check the LF byte value")
        val LF = 0x0A
        expect(LF).to_equal(10)  # oracle: 0x0A = 10 — line feed

    it "CR byte is 0x0D":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): CR byte table
        step("Check the CR byte value")
        val CR = 0x0D
        expect(CR).to_equal(13)  # oracle: 0x0D = 13 — carriage return

    it "LF converted to CR+LF for terminals":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): CR+LF emission order table
        step("Check the CR+LF terminal newline order")
        val expected_sequence = [0x0D, 0x0A]
        expect(expected_sequence[0]).to_equal(13)  # oracle: CR first — carriage return leads the terminal newline
        expect(expected_sequence[1]).to_equal(10)  # oracle: LF second — line feed closes the terminal newline

describe "Test Byte for Loopback":
    # Verify loopback test byte.
    # @manual scenario evidence

    it "loopback echoes the test byte 0xAE":
        # @req REQ-BM-SERIAL-001
        # @capture(bit_table): loopback test byte table
        step("Check the loopback test byte value")
        val TEST_BYTE = 0xAE
        expect(TEST_BYTE).to_equal(174)  # oracle: 0xAE = 174 — alternating bit pattern for loopback
