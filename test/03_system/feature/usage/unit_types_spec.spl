"""
## Purpose and audience
Purpose: defines standalone unit type
Audience: compiler and tooling engineers who maintain this spec

# Unit Types Specification

**Feature ID:** #UNIT-001
**Category:** Language | Types
**Status:** Implemented

## Overview

Tests for semantic unit types that add compile-time dimensional safety
to numeric values.
"""

# @req: REQ-FEATURE-UnitType-001



# ============================================================================
# Test Group 1: Standalone Units
# ============================================================================

use std.spec.step
describe "Standalone Units":
    # ## Basic Unit Type Definition
    #
    # Tests for defining and using standalone unit types.

    it "defines standalone unit type":
        step("Verify: defines standalone unit type")
        # @req: REQ-FEATURE-UnitType-001
        unit UserId: i64 as uid
        val user_id = 42_uid
        expect user_id.value() == 42

    it "performs arithmetic with units":
        step("Verify: performs arithmetic with units")
        # @req: REQ-FEATURE-UnitType-001
        unit Score: i64 as pts
        val a = 100_pts
        val b = 50_pts
        expect (a + b).value() == 150

    it "gets value from unit":
        step("Verify: gets value from unit")
        # @req: REQ-FEATURE-UnitType-001
        val d = 42_km
        expect d.value() == 42

    it "gets suffix from unit":
        step("Verify: gets suffix from unit")
        # @req: REQ-FEATURE-UnitType-001
        val d = 100_bytes
        val s = d.suffix()
        expect s == "bytes"

    it "converts unit to string":
        step("Verify: converts unit to string")
        # @req: REQ-FEATURE-UnitType-001
        val d = 5_km
        val s = d.to_string()
        expect s == "5_km"


# ============================================================================
# Test Group 2: Unit Families
# ============================================================================

describe "Unit Families":
    # ## Unit Families with Conversions
    #
    # Tests for unit families with multiple related units and conversion factors.

    it "defines unit family":
        step("Verify: defines unit family")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0, km = 1000.0
        val d = 5000.0_m
        expect d.value() == 5000.0


# ============================================================================
# Test Group 3: Unit Arithmetic
# ============================================================================

describe "Unit Arithmetic":
    # ## Type-Safe Unit Arithmetic
    #
    # Tests for unit arithmetic with explicit allow rules.

    it "allows same-family addition":
        step("Verify: allows same-family addition")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0, km = 1000.0:
            allow add(length) -> length
            allow sub(length) -> length
        val a = 100_m
        val b = 50_m
        expect (a + b).value() == 150

    it "allows same-family subtraction":
        step("Verify: allows same-family subtraction")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0, km = 1000.0:
            allow sub(length) -> length
        val a = 100_m
        val b = 30_m
        expect (a - b).value() == 70

    it "allows scaling by scalar":
        step("Verify: allows scaling by scalar")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        val d = 10_m
        val scaled = d * 3
        expect scaled.value() == 30

    it "allows comparison always":
        step("Verify: allows comparison always")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        val a = 100_m
        val b = 50_m
        expect a > b


# ============================================================================
# Test Group 4: Compound Units
# ============================================================================

describe "Compound Units":
    # ## Compound Unit Definitions
    #
    # Tests for compound units derived from base units.

    it "defines compound unit":
        step("Verify: defines compound unit")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        unit time(base: f64): s = 1.0
        unit velocity = length / time
        expect 1 == 1

    it "computes velocity from division":
        step("Verify: computes velocity from division")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        unit time(base: f64): s = 1.0
        unit velocity = length / time
        val dist = 100_m
        val dur = 10_s
        val speed = dist / dur
        expect speed.value() == 10

    it "cancels same units in division":
        step("Verify: cancels same units in division")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        val dist1 = 100_m
        val dist2 = 20_m
        val ratio = dist1 / dist2
        expect ratio.value() == 5

    it "defines area from multiplication":
        step("Verify: defines area from multiplication")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        unit area = length * length
        val width = 10_m
        val height = 5_m
        val a = width * height
        expect a.value() == 50


# ============================================================================
# Test Group 5: SI Prefixes
# ============================================================================

describe "SI Prefixes":
    # ## SI Prefix Support
    #
    # Tests for SI prefixes (kilo, mega, milli, micro, etc.).

    it "uses kilo prefix":
        step("Verify: uses kilo prefix")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        val dist = 5_km
        expect dist.value() == 5000

    it "uses mega prefix":
        step("Verify: uses mega prefix")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0
        val dist = 2_Mm
        expect dist.value() == 2000000.0

    it "uses milli prefix":
        step("Verify: uses milli prefix")
        # @req: REQ-FEATURE-UnitType-001
        unit time(base: f64): s = 1.0
        val dur = 500_ms
        expect dur.value() < 1.0


# ============================================================================
# Test Group 6: Unit Type Inference
# ============================================================================

describe "Unit Type Inference":
    # ## Unit Type in Function Signatures
    #
    # Tests for unit types as function parameter and return types.

    it "accepts correct unit parameter":
        step("Verify: accepts correct unit parameter")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0, km = 1000.0
        fn double_distance(d: length) -> length:
            return d + d
        val dist = 5_km
        expect double_distance(dist).value() == 10

    it "returns correct unit type":
        step("Verify: returns correct unit type")
        # @req: REQ-FEATURE-UnitType-001
        unit length(base: f64): m = 1.0, km = 1000.0
        fn get_distance() -> length:
            return 10_m
        expect get_distance().value() == 10


# ============================================================================
# Test Group 7: Semantic Wrapper APIs
# ============================================================================

describe "Semantic Wrapper APIs":
    # ## Public API-Friendly Unit Wrappers
    #
    # Tests for the README claim that `unit` types support semantic wrapper
    # patterns for safer APIs.

    it "uses unit wrappers in public function signatures":
        step("Verify: uses unit wrappers in public function signatures")
        # @req: REQ-FEATURE-UnitType-001
        unit UserId: i64 as uid

        pub fn current_user() -> UserId:
            return 42_uid

        pub fn same_user(user_id: UserId) -> UserId:
            return user_id

        val user_id = current_user()
        expect(user_id.value()).to_equal(42)  # oracle: value fixed by the spec contract
        expect(same_user(user_id).value()).to_equal(42)  # oracle: value fixed by the spec contract

    it "supports helper functions around semantic wrapper units":
        step("Verify: supports helper functions around semantic wrapper units")
        # @req: REQ-FEATURE-UnitType-001
        unit Milliseconds: u64 as ms

        fn plus_two(value: Milliseconds) -> Milliseconds:
            return value + 2_ms

        val base = 42_ms
        val total = plus_two(base)

        expect(total.value()).to_equal(44)  # oracle: value fixed by the spec contract
        expect(total.suffix()).to_equal("ms")
