"""
## Purpose and audience
Purpose: AVR has correct properties
Audience: compiler and tooling engineers who maintain this spec

# Multi-Architecture Support

**Feature ID:** #ARCH-002
**Category:** Compiler
**Status:** In Progress

## Overview

Tests multi-architecture support across 8-bit, 16-bit, 32-bit, and 64-bit targets
including AVR, MCS51, MSP430, x86, ARM, RISC-V, x86_64, and AArch64. Validates
architecture properties (pointer size, stack alignment, FPU, endianness),
target triple generation for bare-metal and hosted environments, and
TargetConfig generation for each bit-width class.

## Syntax

```simple
val avr = TargetArch.AVR
expect(avr.bits()).to_equal(8)  # oracle: value fixed by the spec contract
val config = TargetConfig.for_arch(TargetArch.X86_64)
```
Architecture Support Specification

Tests multi-architecture support (8/16/32/64-bit) including:
- Target architecture properties
- Pointer-sized types (usize/isize)
- Calling conventions
- Type layout per architecture

Feature IDs: #BM-ARCH-001
Category: Bare-Metal
Status: In Progress

NOTE: parse tests use parse_target_arch() free function wrapper
instead of TargetArch.parse() static method (not supported in interpreter)
"""

# @req: REQ-FEATURE-Arch-001

use std.common.target.{TargetArch, PointerSize, Endian, TargetConfig, parse_target_arch}

use std.spec.step
describe "Target Architecture":
    describe "8-bit Architectures":
        it "AVR has correct properties":
            step("Verify: AVR has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val avr = TargetArch.AVR
            expect(avr.bits()).to_equal(8)  # oracle: value fixed by the spec contract
            expect(avr.pointer_bytes()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(avr.stack_align()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(avr.max_atomic_width()).to_equal(8)  # oracle: value fixed by the spec contract
            expect(avr.has_fpu()).to_equal(false)
            expect(avr.is_harvard()).to_equal(true)
            expect(avr.endianness()).to_equal(Endian.Little)

        it "MCS51 has correct properties":
            step("Verify: MCS51 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val mcs51 = TargetArch.MCS51
            expect(mcs51.bits()).to_equal(8)  # oracle: value fixed by the spec contract
            expect(mcs51.pointer_bytes()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(mcs51.stack_align()).to_equal(1)  # oracle: value fixed by the spec contract
            expect(mcs51.has_fpu()).to_equal(false)
            expect(mcs51.is_harvard()).to_equal(true)
            expect(mcs51.endianness()).to_equal(Endian.Big)

        it "AVR parses from string":
            step("Verify: AVR parses from string")
            # @req: REQ-FEATURE-Arch-001
            val parsed = parse_target_arch("avr")
            expect(parsed == nil).to_equal(false)
            expect(parsed.unwrap()).to_equal(TargetArch.AVR)

            val parsed2 = parse_target_arch("atmega")
            expect(parsed2 == nil).to_equal(false)
            expect(parsed2.unwrap()).to_equal(TargetArch.AVR)

    describe "16-bit Architectures":
        it "MSP430 has correct properties":
            step("Verify: MSP430 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val msp = TargetArch.MSP430
            expect(msp.bits()).to_equal(16)  # oracle: value fixed by the spec contract
            expect(msp.pointer_bytes()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(msp.stack_align()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(msp.max_atomic_width()).to_equal(16)  # oracle: value fixed by the spec contract
            expect(msp.has_fpu()).to_equal(false)
            expect(msp.is_harvard()).to_equal(false)
            expect(msp.endianness()).to_equal(Endian.Little)

        it "MSP430 parses from string":
            step("Verify: MSP430 parses from string")
            # @req: REQ-FEATURE-Arch-001
            val parsed = parse_target_arch("msp430")
            expect(parsed == nil).to_equal(false)
            expect(parsed.unwrap()).to_equal(TargetArch.MSP430)

    describe "32-bit Architectures":
        it "x86 has correct properties":
            step("Verify: x86 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val x86 = TargetArch.X86
            expect(x86.bits()).to_equal(32)  # oracle: value fixed by the spec contract
            expect(x86.pointer_bytes()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(x86.stack_align()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(x86.max_atomic_width()).to_equal(64)  # oracle: value fixed by the spec contract
            expect(x86.has_fpu()).to_equal(true)
            expect(x86.is_harvard()).to_equal(false)

        it "ARM has correct properties":
            step("Verify: ARM has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val arm = TargetArch.Arm
            expect(arm.bits()).to_equal(32)  # oracle: value fixed by the spec contract
            expect(arm.pointer_bytes()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(arm.stack_align()).to_equal(4)  # oracle: value fixed by the spec contract
            expect(arm.has_fpu()).to_equal(false)  # Cortex-M0/M3

        it "RISC-V 32 has correct properties":
            step("Verify: RISC-V 32 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val rv32 = TargetArch.Riscv32
            expect(rv32.bits()).to_equal(32)  # oracle: value fixed by the spec contract
            expect(rv32.pointer_bytes()).to_equal(4)  # oracle: value fixed by the spec contract

    describe "64-bit Architectures":
        it "x86_64 has correct properties":
            step("Verify: x86_64 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val x64 = TargetArch.X86_64
            expect(x64.bits()).to_equal(64)  # oracle: value fixed by the spec contract
            expect(x64.pointer_bytes()).to_equal(8)  # oracle: value fixed by the spec contract
            expect(x64.stack_align()).to_equal(16)  # oracle: value fixed by the spec contract
            expect(x64.max_atomic_width()).to_equal(128)  # oracle: value fixed by the spec contract
            expect(x64.has_fpu()).to_equal(true)

        it "AArch64 has correct properties":
            step("Verify: AArch64 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val arm64 = TargetArch.Aarch64
            expect(arm64.bits()).to_equal(64)  # oracle: value fixed by the spec contract
            expect(arm64.pointer_bytes()).to_equal(8)  # oracle: value fixed by the spec contract
            expect(arm64.stack_align()).to_equal(16)  # oracle: value fixed by the spec contract

        it "RISC-V 64 has correct properties":
            step("Verify: RISC-V 64 has correct properties")
            # @req: REQ-FEATURE-Arch-001
            val rv64 = TargetArch.Riscv64
            expect(rv64.bits()).to_equal(64)  # oracle: value fixed by the spec contract
            expect(rv64.pointer_bytes()).to_equal(8)  # oracle: value fixed by the spec contract

describe "Pointer Size":
    it "8-bit and 16-bit use 16-bit pointers":
        step("Verify: 8-bit and 16-bit use 16-bit pointers")
        # @req: REQ-FEATURE-Arch-001
        val avr = TargetArch.AVR
        val mcs51 = TargetArch.MCS51
        val msp430 = TargetArch.MSP430
        expect(avr.pointer_size()).to_equal(PointerSize.Bits16)
        expect(mcs51.pointer_size()).to_equal(PointerSize.Bits16)
        expect(msp430.pointer_size()).to_equal(PointerSize.Bits16)

    it "32-bit uses 32-bit pointers":
        step("Verify: 32-bit uses 32-bit pointers")
        # @req: REQ-FEATURE-Arch-001
        val x86 = TargetArch.X86
        val arm = TargetArch.Arm
        val rv32 = TargetArch.Riscv32
        expect(x86.pointer_size()).to_equal(PointerSize.Bits32)
        expect(arm.pointer_size()).to_equal(PointerSize.Bits32)
        expect(rv32.pointer_size()).to_equal(PointerSize.Bits32)

    it "64-bit uses 64-bit pointers":
        step("Verify: 64-bit uses 64-bit pointers")
        # @req: REQ-FEATURE-Arch-001
        val x64 = TargetArch.X86_64
        val arm64 = TargetArch.Aarch64
        val rv64 = TargetArch.Riscv64
        expect(x64.pointer_size()).to_equal(PointerSize.Bits64)
        expect(arm64.pointer_size()).to_equal(PointerSize.Bits64)
        expect(rv64.pointer_size()).to_equal(PointerSize.Bits64)

    it "PointerSize returns correct byte count":
        step("Verify: PointerSize returns correct byte count")
        # @req: REQ-FEATURE-Arch-001
        val p16 = PointerSize.Bits16
        val p32 = PointerSize.Bits32
        val p64 = PointerSize.Bits64
        expect(p16.bytes()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(p32.bytes()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(p64.bytes()).to_equal(8)  # oracle: value fixed by the spec contract

describe "Target Triple":
    it "generates correct bare-metal triples":
        step("Verify: generates correct bare-metal triples")
        # @req: REQ-FEATURE-Arch-001
        val avr = TargetArch.AVR
        val msp430 = TargetArch.MSP430
        val x86 = TargetArch.X86
        val arm = TargetArch.Arm
        val x64 = TargetArch.X86_64
        expect(avr.triple_str_baremetal()).to_equal("avr-unknown-unknown")
        expect(msp430.triple_str_baremetal()).to_equal("msp430-none-elf")
        expect(x86.triple_str_baremetal()).to_equal("i686-unknown-none")
        expect(arm.triple_str_baremetal()).to_equal("thumbv7m-none-eabi")
        expect(x64.triple_str_baremetal()).to_equal("x86_64-unknown-none")

    it "generates correct hosted triples":
        step("Verify: generates correct hosted triples")
        # @req: REQ-FEATURE-Arch-001
        val x86 = TargetArch.X86
        val x64 = TargetArch.X86_64
        val arm = TargetArch.Arm
        expect(x86.triple_str()).to_equal("i686-unknown-linux-gnu")
        expect(x64.triple_str()).to_equal("x86_64-unknown-linux-gnu")
        expect(arm.triple_str()).to_equal("armv7-unknown-linux-gnueabihf")

describe "Target Config":
    it "configures 8-bit correctly":
        step("Verify: configures 8-bit correctly")
        # @req: REQ-FEATURE-Arch-001
        val config = TargetConfig.for_arch(TargetArch.AVR)
        expect(config.pointer_bytes).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.value_bytes).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.tag_bits).to_equal(0)  # oracle: value fixed by the spec contract
        expect(config.heap_align).to_equal(1)  # oracle: value fixed by the spec contract
        expect(config.default_stack_size).to_equal(256)  # oracle: value fixed by the spec contract

    it "configures 16-bit correctly":
        step("Verify: configures 16-bit correctly")
        # @req: REQ-FEATURE-Arch-001
        val config = TargetConfig.for_arch(TargetArch.MSP430)
        expect(config.pointer_bytes).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.value_bytes).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.tag_bits).to_equal(1)  # oracle: value fixed by the spec contract
        expect(config.heap_align).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.default_stack_size).to_equal(512)  # oracle: value fixed by the spec contract

    it "configures 32-bit correctly":
        step("Verify: configures 32-bit correctly")
        # @req: REQ-FEATURE-Arch-001
        val config = TargetConfig.for_arch(TargetArch.X86)
        expect(config.pointer_bytes).to_equal(4)  # oracle: value fixed by the spec contract
        expect(config.value_bytes).to_equal(8)  # oracle: value fixed by the spec contract
        expect(config.tag_bits).to_equal(2)  # oracle: value fixed by the spec contract
        expect(config.heap_align).to_equal(4)  # oracle: value fixed by the spec contract

    it "configures 64-bit correctly":
        step("Verify: configures 64-bit correctly")
        # @req: REQ-FEATURE-Arch-001
        val config = TargetConfig.for_arch(TargetArch.X86_64)
        expect(config.pointer_bytes).to_equal(8)  # oracle: value fixed by the spec contract
        expect(config.value_bytes).to_equal(8)  # oracle: value fixed by the spec contract
        expect(config.tag_bits).to_equal(3)  # oracle: value fixed by the spec contract
        expect(config.heap_align).to_equal(8)  # oracle: value fixed by the spec contract

describe "Architecture Bit Width Helpers":
    it "is_8bit returns true for 8-bit":
        step("Verify: is_8bit returns true for 8-bit")
        # @req: REQ-FEATURE-Arch-001
        val avr = TargetArch.AVR
        val mcs51 = TargetArch.MCS51
        val x86 = TargetArch.X86
        expect(avr.is_8bit()).to_equal(true)
        expect(mcs51.is_8bit()).to_equal(true)
        expect(x86.is_8bit()).to_equal(false)

    it "is_16bit returns true for 16-bit":
        step("Verify: is_16bit returns true for 16-bit")
        # @req: REQ-FEATURE-Arch-001
        val msp430 = TargetArch.MSP430
        val avr = TargetArch.AVR
        expect(msp430.is_16bit()).to_equal(true)
        expect(avr.is_16bit()).to_equal(false)

    it "is_32bit returns true for 32-bit":
        step("Verify: is_32bit returns true for 32-bit")
        # @req: REQ-FEATURE-Arch-001
        val x86 = TargetArch.X86
        val arm = TargetArch.Arm
        val x64 = TargetArch.X86_64
        expect(x86.is_32bit()).to_equal(true)
        expect(arm.is_32bit()).to_equal(true)
        expect(x64.is_32bit()).to_equal(false)

    it "is_64bit returns true for 64-bit":
        step("Verify: is_64bit returns true for 64-bit")
        # @req: REQ-FEATURE-Arch-001
        val x64 = TargetArch.X86_64
        val arm64 = TargetArch.Aarch64
        val x86 = TargetArch.X86
        expect(x64.is_64bit()).to_equal(true)
        expect(arm64.is_64bit()).to_equal(true)
        expect(x86.is_64bit()).to_equal(false)

describe "Endianness":
    it "most architectures are little-endian":
        step("Verify: most architectures are little-endian")
        # @req: REQ-FEATURE-Arch-001
        val avr = TargetArch.AVR
        val msp430 = TargetArch.MSP430
        val x86 = TargetArch.X86
        val x64 = TargetArch.X86_64
        expect(avr.endianness()).to_equal(Endian.Little)
        expect(msp430.endianness()).to_equal(Endian.Little)
        expect(x86.endianness()).to_equal(Endian.Little)
        expect(x64.endianness()).to_equal(Endian.Little)

    it "MCS51 is big-endian":
        step("Verify: MCS51 is big-endian")
        # @req: REQ-FEATURE-Arch-001
        val mcs51 = TargetArch.MCS51
        expect(mcs51.endianness()).to_equal(Endian.Big)
