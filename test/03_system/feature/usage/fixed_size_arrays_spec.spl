"""
# Fixed-Size Array Types

**Feature ID:** #LANG-008
**Category:** Language
**Status:** Active

## Overview

Fixed-size arrays use the `[T; N]` syntax to declare arrays whose length is known at
declaration time and enforced at runtime. Unlike dynamic arrays, fixed-size arrays carry
their size as part of the type annotation, enabling stronger guarantees about buffer
lengths. This spec validates creation, indexing (including negative indices), read
operations like `first()`/`last()`/`contains()`, iteration with `for`, and functional
methods (`map`, `filter`, `reduce`) that return dynamic arrays.

## Syntax

```simple
use std.spec.step

val vec3: [f64; 3] = [1.0, 2.0, 3.0]
val arr: [i64; 5] = [1, 2, 3, 4, 5]
expect(arr[-1]).to_equal(5)
val doubled = vec3.map(_1 * 2)
val sum = arr.reduce(0, \acc, x: acc + x)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| `[T; N]` Syntax | Declares a fixed-size array of type T with exactly N elements |
| Runtime Size Check | Array size is validated at creation to match the declared N |
| Negative Indexing | `arr[-1]` accesses the last element, `arr[-2]` the second-to-last |
| Functional Methods | `map`, `filter`, `reduce` work on fixed arrays but return dynamic arrays |
"""

use std.spec.step

describe "Fixed-Size Arrays":
    # @manual scenario evidence

    context "Basic Syntax":
        it "creates fixed-size array with type annotation":
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect(vec3.len()).to_equal(3)

        it "creates fixed-size int array":
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            expect(arr.len()).to_equal(5)

        it "creates single element fixed-size array":
            val arr: [i64; 1] = [42]
            expect(arr[0]).to_equal(42)
            expect(arr.len()).to_equal(1)

    context "Indexing":
        it "allows indexing read":
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect(vec3[0]).to_equal(1.0)
            expect(vec3[1]).to_equal(2.0)
            expect(vec3[2]).to_equal(3.0)

        it "allows negative indexing":
            val arr: [i64; 3] = [10, 20, 30]
            expect(arr[-1]).to_equal(30)
            expect(arr[-2]).to_equal(20)
            expect(arr[-3]).to_equal(10)

    context "Read Operations":
        it "allows len":
            val vec3: [f64; 3] = [1.0, 2.0, 3.0]
            expect(vec3.len()).to_equal(3)

        it "allows first and last":
            val arr: [i64; 4] = [10, 20, 30, 40]
            expect(arr.first()).to_equal(10)
            expect(arr.last()).to_equal(40)

        it "allows contains":
            val arr: [i64; 3] = [1, 2, 3]
            expect arr.contains(2)
            expect not arr.contains(5)

        it "allows iteration":
            val vec3: [i64; 3] = [1, 2, 3]
            var sum = 0
            for x in vec3:
                sum = sum + x
            expect(sum).to_equal(6)

    context "Functional Operations":
        it "allows map (returns dynamic array)":
            val vec3: [i64; 3] = [1, 2, 3]
            val doubled = vec3.map(_ * 2)
            expect(doubled[0]).to_equal(2)
            expect(doubled[1]).to_equal(4)
            expect(doubled[2]).to_equal(6)

        it "allows filter (returns dynamic array)":
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            val evens = arr.filter(_ % 2 == 0)
            expect(evens[0]).to_equal(2)
            expect(evens.len()).to_equal(2)

        it "allows reduce":
            val arr: [i64; 4] = [1, 2, 3, 4]
            val sum = arr.reduce(0, \acc, x: acc + x)
            expect(sum).to_equal(10)

    context "Display Format":
        it "displays with size annotation":
            val vec3: [i64; 3] = [1, 2, 3]
            # FixedSizeArray displays as [items; size]
            expect(vec3.len()).to_equal(3)
