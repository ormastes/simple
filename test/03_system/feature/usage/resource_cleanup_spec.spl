describe "Feature #2304: with Statement":
    context "Basic with statement":
        skip_on_interpreter "closes resource after block", fn():
            # with MockResource.open("test") as res:
            #     # use resource
            # Would verify resource closed after block
            pass

        skip_on_interpreter "closes resource on exception", fn():
            # with MockResource.open("test") as res:
            #     # error occurs
            # Would verify resource still closed
            pass

    context "Usage examples":
        it "demonstrates defer pattern":
            # @req REQ-RES-CLEANUP-014
            # @capture(bit_table): manual close matches defer effect
            step("Apply the manual close pattern and read the open count")
            var open_count = 1
            open_count = open_count - 1
            expect(open_count).to_equal(0)  # oracle: the manual close reaches the closed count

        skip_on_interpreter "demonstrates with statement", fn():
            # with open_resource("file.txt") as res:
            #     # use resource
            # Would demonstrate automatic cleanup
            pass

        it "demonstrates leak detection in tests":
            # @req REQ-RES-CLEANUP-015
            # @capture(bit_table): leak then cleanup list lengths
            step("Leak one entry, observe it, clean up, observe again")
            var leaked_resources = ["leaked_resource"]
            expect(leaked_resources.len()).to_equal(1)  # oracle: the leak is observable before cleanup
            leaked_resources = []
            expect(leaked_resources.len()).to_equal(0)  # oracle: cleanup empties the leak list
