# @req: REQ-FEATURE-ARITHMETIC-001


"""
# Arithmetic Operations Specification


**Feature IDs:** #ARITH-001 to #ARITH-030
**Category:** Language | Operators
**Difficulty:** 1/5
**Status:** Implemented

## Overview

Arithmetic operations provide basic mathematical computations on numeric types.
Simple supports integer and floating-point arithmetic with standard operators
and correct operator precedence.

## Syntax

```simple
# Basic binary operators
2 + 3              # Addition
10 - 3             # Subtraction
4 * 5              # Multiplication
15 / 3             # Division
17 % 5             # Modulo (remainder)
2 ** 3             # Exponentiation (power)

# Unary operators
-x                 # Negation
+x                 # Positive (identity)

# Operator precedence (high to low)
# 1. Exponentiation (**)
# 2. Unary (-, +)
# 3. Multiplication, Division, Modulo (*, /, %)
# 4. Addition, Subtraction (+, -)
```

## Key Concepts

| Operator | Name | Operands | Result |
|----------|------|----------|--------|
| `+` | Addition | i64, f64 | Same type |
| `-` | Subtraction | i64, f64 | Same type |
| `*` | Multiplication | i64, f64 | Same type |
| `/` | Division | i64, f64 | Same type |
| `%` | Modulo | i64 | i64 |
| `**` | Power | i64, f64 | Same type |

## Behavior

- Integer division truncates toward zero
- Modulo has the sign of the dividend
- Type coercion follows standard rules
- Overflow behavior (wrapping, panic, or saturation) depends on context
- Division by zero is an error
"""



# ============================================================================
# Test Group 1: Basic Binary Operators
# ============================================================================

use std.spec.step

describe "Basic Binary Operators":
    # ## Basic Binary Operators
    #
    # Tests for fundamental arithmetic operators on integers.

    context "addition":
        it "adds positive integers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds positive integers")
            expect 2 + 3 == 5

        it "adds zero":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds zero")
            expect 5 + 0 == 5
            expect 0 + 5 == 5

        it "adds larger numbers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds larger numbers")
            expect 100 + 200 == 300

        it "adds negative integers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds negative integers")
            expect ((-5)) + 3 == -2

    context "subtraction":
        it "subtracts integers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: subtracts integers")
            expect 10 - 3 == 7

        it "subtracts zero":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: subtracts zero")
            expect 5 - 0 == 5

        it "subtracts from zero":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: subtracts from zero")
            expect 0 - 5 == -5

        it "subtracts resulting in negative":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: subtracts resulting in negative")
            expect 3 - 10 == -7

    context "multiplication":
        it "multiplies integers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: multiplies integers")
            expect 4 * 5 == 20

        it "multiplies by zero":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: multiplies by zero")
            expect 5 * 0 == 0
            expect 0 * 5 == 0

        it "multiplies by one":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: multiplies by one")
            expect 5 * 1 == 5

        it "multiplies negative numbers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: multiplies negative numbers")
            expect ((-4)) * 5 == -20
            expect ((-4)) * -5 == 20

    context "division":
        it "divides integers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides integers")
            expect 15 / 3 == 5

        it "divides with truncation":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides with truncation")
            expect 7 / 2 == 3

        it "divides by one":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides by one")
            expect 42 / 1 == 42

        it "divides zero by number":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides zero by number")
            expect 0 / 5 == 0

        it "divides negative numbers":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides negative numbers")
            expect ((-20)) / 4 == -5
            expect 20 / -4 == -5


# ============================================================================
# Test Group 2: Operator Precedence
# ============================================================================

describe "Operator Precedence":
    # ## Operator Precedence
    #
    # Tests that operators are evaluated in the correct order.

    it "evaluates multiplication before addition":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: evaluates multiplication before addition")
        expect 2 + 3 * 4 == 14

    it "evaluates multiplication before subtraction":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: evaluates multiplication before subtraction")
        expect 10 - 3 * 2 == 4

    it "evaluates division before addition":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: evaluates division before addition")
        expect 10 + 20 / 4 == 15

    it "handles chain of same precedence (left-to-right)":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: handles chain of same precedence (left-to-right)")
        expect 20 - 5 - 3 == 12
        expect 20 / 4 / 2 == 2

    it "respects multiple operations":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: respects multiple operations")
        expect 2 + 3 * 4 - 1 == 13

    it "handles complex expression":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: handles complex expression")
        expect 2 * 3 + 4 * 5 == 26


# ============================================================================
# Test Group 3: Parentheses and Grouping
# ============================================================================

describe "Parentheses and Expression Grouping":
    # ## Parentheses and Expression Grouping
    #
    # Tests that parentheses override default precedence.

    it "changes addition before multiplication":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: changes addition before multiplication")
        expect (2 + 3) * 4 == 20

    it "changes subtraction before division":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: changes subtraction before division")
        expect (20 - 4) / 2 == 8

    it "handles nested parentheses":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: handles nested parentheses")
        expect ((2 + 3) * 4) + 1 == 21

    it "handles deeply nested parentheses":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: handles deeply nested parentheses")
        expect (((10 + 5) * 2) - 5) / 3 == 6


# ============================================================================
# Test Group 4: Modulo Operation
# ============================================================================

describe "Modulo Operation":
    # ## Modulo Operation
    #
    # Tests remainder calculation via modulo operator.

    it "calculates simple modulo":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: calculates simple modulo")
        expect 17 % 5 == 2

    it "modulo of exact division":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: modulo of exact division")
        expect 20 % 5 == 0

    it "modulo with smaller divisor":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: modulo with smaller divisor")
        expect 3 % 7 == 3

    it "modulo with one":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: modulo with one")
        expect 5 % 1 == 0

    it "modulo with negative dividend":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: modulo with negative dividend")
        expect ((-17)) % 5 == -2

    it "modulo with negative divisor":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: modulo with negative divisor")
        expect 17 % -5 == 2


# ============================================================================
