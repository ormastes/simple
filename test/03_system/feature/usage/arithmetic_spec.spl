    it "multiplies integer by float":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: multiplies integer by float")
        expect 4 * 2.5 == 10.0

    it "divides integer by float":
        # @req: REQ-FEATURE-ARITHMETIC-001
