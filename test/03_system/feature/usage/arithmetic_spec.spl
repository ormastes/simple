    it "negates positive number":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: negates positive number")
        expect ((-5)) == -5

    it "negates negative number":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: negates negative number")
        expect (-(-5)) == 5

    it "applies unary plus":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: applies unary plus")
        # Skipped: unary plus not supported in parser
        expect true

    it "applies unary plus to negative":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: applies unary plus to negative")
        # Skipped: unary plus not supported in parser
        expect true

    it "negates in expression":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: negates in expression")
        expect 10 + (-5) == 5


# ============================================================================
# Test Group 6: Floating Point Arithmetic
# ============================================================================

describe "Floating Point Arithmetic":
    # ## Floating Point Arithmetic
    #
    # Tests arithmetic operations on floating-point numbers.

    context "float addition":
        it "adds floats":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds floats")
            expect 2.5 + 3.5 == 6.0

        it "adds float and integer":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: adds float and integer")
            expect 2.5 + 3 == 5.5

    context "float subtraction":
        it "subtracts floats":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: subtracts floats")
            expect 10.5 - 3.2 == 7.3

    context "float multiplication":
        it "multiplies floats":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: multiplies floats")
            expect 2.5 * 4.0 == 10.0

    context "float division":
        it "divides floats":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides floats")
            expect 10.0 / 2.0 == 5.0

        it "divides with fractional result":
            # @req: REQ-FEATURE-ARITHMETIC-001
            step("Verify: divides with fractional result")
            expect 5.0 / 2.0 == 2.5


# ============================================================================
# Test Group 7: Exponentiation
# ============================================================================

describe "Exponentiation":
    # ## Exponentiation
    #
    # Tests power/exponentiation operator.

    it "calculates 2 to power 3":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: calculates 2 to power 3")
        expect 2 ** 3 == 8

    it "calculates any number to power 0":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: calculates any number to power 0")
        expect 5 ** 0 == 1

    it "calculates any number to power 1":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: calculates any number to power 1")
        expect 5 ** 1 == 5

    it "calculates 10 squared":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: calculates 10 squared")
        expect 10 ** 2 == 100

    it "has higher precedence than multiplication":
        # @req: REQ-FEATURE-ARITHMETIC-001
        step("Verify: has higher precedence than multiplication")
        expect 2 * 3 ** 2 == 18


