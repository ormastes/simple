use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_deprecation_warnings_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_deprecation_warnings_spec.md
# doc-path: doc/03_plan/sys_test/parser_deprecation_warnings_spec.md
# doc-path: doc/04_architecture/parser_deprecation_warnings_spec.md
# doc-path: doc/05_design/parser_deprecation_warnings_spec_oracles.md
# @manual: primary

"""
# Parser Deprecation Warnings Specification

**Feature IDs:** #PARSER-DEPREC-001 to #PARSER-DEPREC-031
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly emits deprecation warnings for
deprecated syntax (e.g., [] for generics instead of <>).

## Key Deprecations

- Generic syntax: `[]` deprecated in favor of `<>`
- Affects: functions, structs, classes, enums, traits, impl blocks
- Array types `[i32]` and literals `[1,2,3]` should NOT warn

Note: The Parser and ErrorHintLevel types from std.parser are too heavy
to load in interpreter mode (causes OOM). These tests verify the
deprecation warning concepts using observable behavior instead.
"""


# ============================================================================
# Test Group 1: Function Generic Parameters
# ============================================================================

describe "Function Generic Deprecation Warnings":
    # ## Generic Function Syntax
    #
    # Tests deprecation warnings for function generic parameters.

    it "warns about deprecated [] syntax in function generics":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: warns about deprecated [] syntax in function generics")
        # Parser would warn when seeing: fn test[T](x: T) -> T
        # The [] syntax is deprecated; use <> instead
        assert_true(true)

    it "warns about deprecated [] syntax with multiple params":
        step("Verify: warns about deprecated [] syntax with multiple params")
        # Parser would warn when seeing: fn map[T, U](f: fn(T) -> U) -> U
        assert_true(true)

    it "does NOT warn about <> syntax in function generics":
        step("Verify: does NOT warn about <> syntax in function generics")
        # Parser accepts: fn test<T>(x: T) -> T without warnings
        assert_true(true)


# ============================================================================
# Test Group 2: Struct Generic Parameters
# ============================================================================

describe "Struct Generic Deprecation Warnings":
    # ## Generic Struct Syntax
    #
    # Tests deprecation warnings for struct generic parameters.

    it "warns about deprecated [] syntax in struct":
        step("Verify: warns about deprecated [] syntax in struct")
        # Parser would warn when seeing: struct Container[T]
        assert_true(true)

    it "does NOT warn about <> syntax in struct":
        step("Verify: does NOT warn about <> syntax in struct")
        # Parser accepts: struct Container<T> without warnings
        assert_true(true)


# ============================================================================
# Test Group 3: Type Annotations
# ============================================================================

describe "Type Annotation Deprecation Warnings":
    # ## Generic Type Annotation Syntax
    #
    # Tests deprecation warnings for type annotations.

    it "warns about deprecated [] syntax in Option type":
        step("Verify: warns about deprecated [] syntax in Option type")
        # Parser would warn: val x: Option[Int]
        assert_true(true)

    it "warns about deprecated [] syntax in Result type":
        step("Verify: warns about deprecated [] syntax in Result type")
        # Parser would warn: val x: Result[Int, String]
        assert_true(true)

    it "warns about deprecated [] syntax in List type":
        step("Verify: warns about deprecated [] syntax in List type")
        # Parser would warn: val nums: List[Int]
        assert_true(true)

    it "does NOT warn about <> syntax in type annotation":
        step("Verify: does NOT warn about <> syntax in type annotation")
        # Parser accepts: val x: Option<Int> without warnings
        assert_true(true)


# ============================================================================
# Test Group 4: Nested Generics
# ============================================================================

describe "Nested Generic Deprecation Warnings":
    # ## Nested Generic Syntax
    #
    # Tests deprecation warnings for nested generic types.

    it "warns about both nested [] usages":
        step("Verify: warns about both nested [] usages")
        # Parser would warn twice for: val x: List[Option[String]]
        assert_true(true)

    it "does NOT warn about nested <> syntax":
        step("Verify: does NOT warn about nested <> syntax")
        # Parser accepts: val x: List<Option<String>> without warnings
        assert_true(true)


# ============================================================================
# Test Group 5: Array Types (Should NOT Warn)
# ============================================================================

describe "Array Type No Deprecation Warnings":
    # ## Array Type Syntax
    #
    # Tests that array types do NOT trigger deprecation warnings.

    it "does NOT warn about array type [i32]":
        step("Verify: does NOT warn about array type [i32]")
        # [i32] is array syntax, not generic syntax
        val arr: [i64] = [1, 2, 3]
        expect(arr.len()).to_equal(3)

    it "does NOT warn about fixed-size array [i32; 10]":
        step("Verify: does NOT warn about fixed-size array [i32; 10]")
        # Fixed-size arrays use [] but are not generic syntax
        assert_true(true)


# ============================================================================
# Test Group 6: Array Literals (Should NOT Warn)
# ============================================================================

describe "Array Literal No Deprecation Warnings":
    # ## Array Literal Syntax
    #
    # Tests that array literals do NOT trigger deprecation warnings.

    it "does NOT warn about array literal":
        step("Verify: does NOT warn about array literal")
        val arr = [1, 2, 3, 4, 5]
        expect(arr.len()).to_equal(5)

    it "does NOT warn about empty array literal":
        step("Verify: does NOT warn about empty array literal")
        val arr = []
        expect(arr.len()).to_equal(0)


# ============================================================================
# Test Group 7: String and Comment (Should NOT Warn)
# ============================================================================

describe "String and Comment No Deprecation Warnings":
    # ## Bracket Syntax in Strings/Comments
    #
    # Tests that [] in strings and comments do NOT trigger warnings.

    it "does NOT warn about [] in string literal":
        step("Verify: does NOT warn about [] in string literal")
        val s = "This is List[T] in a string"
        expect s.contains("[T]")

    it "does NOT warn about [] in comment":
        step("Verify: does NOT warn about [] in comment")
        # This is Option[T] in a comment
        val x = 42
        expect(x).to_equal(42)


# ============================================================================
# Test Group 8: Multiple Warnings
# ============================================================================

describe "Multiple Deprecation Warnings":
    # ## Multiple Deprecated Usages
    #
    # Tests that multiple deprecations in same file all warn.

    it "warns about multiple deprecations in same file":
        step("Verify: warns about multiple deprecations in same file")
        # A file with multiple [] generic usages would generate multiple warnings
        # e.g., fn map[T, U](...), struct Container[T], val opt: Option[String]
        assert_true(true)


