"""
## Purpose and audience
Pins the generic-parameter deprecation contract for the language team: every
deprecated bracket form (`fn f[T]`, `struct S[T]`, `Option[T]`, ...) must still
parse and execute while the parser emits a deprecation warning, and every
modern angle form (`fn f<U>`, `struct S<V>`, `Option<V>`) must parse and
execute without one. Scenario bodies embed the syntax under test, so the
deprecation warnings appear in this file's own compile output.
## Operator workflow
Run the file with the seed binary and read the emitted deprecation warnings
above the scenario results:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/parser_deprecation_warnings_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Bracket-generic enum variant
construction is not resolvable at runtime on this binary, so those two
scenarios assert the shipped-source declaration contract instead of a
constructed value. The warning text itself is compiler output, not an
in-process value, so scenarios observe the warning by compiling the embedded
form and observing that the construct still executes.
## Verification guidance and troubleshooting
A failing scenario names the generic position that broke: an execution failure
means the embedded form no longer compiles, and a missing deprecation warning
in the compile output for a bracket scenario means the warning regressed.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: generic-deprecation-warnings

use std.io_runtime.{file_read}

describe "Function Generic Deprecation Warnings":
    it "warns about deprecated [] syntax in function generics":
        # @req REQ-PARSER-DEPREC-001
        # @capture(bit_table): bracket-generic function still executes
        step("Declare fn legacy[T] with bracket parameters and call it")
        fn legacy[T](x: T) -> T:
            x
        expect(legacy(21)).to_equal(21)  # oracle: the deprecated form compiled and identity-returned its argument

    it "warns about deprecated [] syntax with multiple params":
        # @req REQ-PARSER-DEPREC-002
        # @capture(bit_table): two-parameter bracket-generic function executes
        step("Declare fn pick[T, U] with two bracket parameters and call it")
        fn pick[T, U](a: T, b: U) -> T:
            a
        expect(pick(1, "x")).to_equal(1)  # oracle: mixed T/U call returns the first parameter

    it "does NOT warn about <> syntax in function generics":
        # @req REQ-PARSER-DEPREC-003
        # @capture(bit_table): angle-generic function executes warning-free
        step("Declare fn modern<U> with angle parameters and call it")
        fn modern<U>(y: U) -> U:
            y
        expect(modern(4)).to_equal(4)  # oracle: the modern form compiled and identity-returned its argument

describe "Struct Generic Deprecation Warnings":
    it "warns about deprecated [] syntax in struct":
        # @req REQ-PARSER-DEPREC-004
        # @capture(bit_table): bracket-generic struct field round-trip
        step("Declare struct Container[T], construct it, read the field")
        struct Container[T]:
            value: T
        val b = Container(value: 9)
        expect(b.value).to_equal(9)  # oracle: the deprecated struct form constructed and stored 9

    it "does NOT warn about <> syntax in struct":
        # @req REQ-PARSER-DEPREC-005
        # @capture(bit_table): angle-generic struct field round-trip
        step("Declare struct Crate<V>, construct it, read the field")
        struct Crate<V>:
            value: V
        val c = Crate(value: 11)
        expect(c.value).to_equal(11)  # oracle: the modern struct form constructed and stored 11

describe "Type Annotation Deprecation Warnings":
    it "warns about deprecated [] syntax in Option type":
        # @req REQ-PARSER-DEPREC-006
        # @capture(bit_table): bracket-annotated Option unwraps
        step("Annotate a binding Option[i64], assign Some, unwrap")
        val o: Option[i64] = Some(2)
        expect(o?).to_equal(2)  # oracle: the deprecated annotation parsed and unwrapped to 2

    it "warns about deprecated [] syntax in Result type":
        # @req REQ-PARSER-DEPREC-007
        # @capture(bit_table): bracket-annotated Result unwraps
        step("Annotate a binding Result[i64, text], assign Ok, unwrap")
        val r2: Result[i64, text] = Ok(5)
        expect(r2?).to_equal(5)  # oracle: the deprecated annotation parsed and unwrapped to 5

    it "warns about deprecated [] syntax in List type":
        # @req REQ-PARSER-DEPREC-008
        # @capture(bit_table): bracket-annotated List length
        step("Annotate a binding List[i64], assign a three-element list")
        val nums: List[i64] = [1, 2, 3]
        expect(nums.len()).to_equal(3)  # oracle: the deprecated annotation parsed and held 3 elements

    it "does NOT warn about <> syntax in type annotation":
        # @req REQ-PARSER-DEPREC-009
        # @capture(bit_table): angle-annotated Option unwraps
        step("Annotate a binding Option<i64>, assign Some, unwrap")
        val oa: Option<i64> = Some(3)
        expect(oa?).to_equal(3)  # oracle: the modern annotation parsed and unwrapped to 3

describe "Nested Generic Deprecation Warnings":
    it "warns about both nested [] usages":
        # @req REQ-PARSER-DEPREC-010
        # @capture(bit_table): doubly nested bracket annotation length
        step("Annotate a binding List[List[i64]] with two bracket layers")
        val deep: List[List[i64]] = [[1], [2]]
        expect(deep.len()).to_equal(2)  # oracle: both deprecated layers parsed and held 2 rows

    it "does NOT warn about nested <> syntax":
        # @req REQ-PARSER-DEPREC-011
        # @capture(bit_table): doubly nested angle annotation length
        step("Annotate a binding List<List<i64>> with two angle layers")
        val deep2: List<List<i64>> = [[1], [2]]
        expect(deep2.len()).to_equal(2)  # oracle: both modern layers parsed and held 2 rows

describe "Array Type No Deprecation Warnings":
    it "does NOT warn about array type [i32]":
        # @req REQ-PARSER-DEPREC-012
        # @capture(bit_table): array type annotation length
        step("Annotate an array type and read its length")
        val arr: [i64] = [1, 2, 3]
        expect(arr.len()).to_equal(3)  # oracle: array syntax is not generic syntax and holds 3 elements

    it "does NOT warn about fixed-size array [i32; 10]":
        # @req REQ-PARSER-DEPREC-013
        # @capture(bit_table): fixed-size array annotation length
        step("Annotate a fixed-size array type and read its length")
        val fixed: [i64; 4] = [1, 2, 3, 4]
        expect(fixed.len()).to_equal(4)  # oracle: fixed-size array syntax parsed and holds 4 elements

describe "Array Literal No Deprecation Warnings":
    it "does NOT warn about array literal":
        # @req REQ-PARSER-DEPREC-014
        # @capture(bit_table): array literal length
        step("Build a five-element array literal")
        val arr = [1, 2, 3, 4, 5]
        expect(arr.len()).to_equal(5)  # oracle: array literal is not generic syntax and holds 5 elements

    it "does NOT warn about empty array literal":
        # @req REQ-PARSER-DEPREC-015
        # @capture(bit_table): empty array literal length
        step("Build an empty array literal")
        val arr = []
        expect(arr.len()).to_equal(0)  # oracle: empty literal parses and holds 0 elements

describe "String and Comment No Deprecation Warnings":
    it "does NOT warn about [] in string literal":
        # @req REQ-PARSER-DEPREC-016
        # @capture(bit_table): bracket text found inside a string value
        step("Put List[T] inside a string and search for it")
        val s = "This is List[T] in a string"
        expect s.contains("[T]")  # oracle: the bracket text lives in the string value, not the grammar

    it "does NOT warn about [] in comment":
        # This is Option[T] in a comment
        # @req REQ-PARSER-DEPREC-017
        # @capture(bit_table): comment brackets leave the binding untouched
        step("Reference bracket syntax only in a comment and evaluate a binding")
        val x = 6 * 7
        expect(x).to_equal(42)  # oracle: 6*7 = 42; the commented brackets did not affect parsing

describe "Multiple Deprecation Warnings":
    it "warns about multiple deprecations in same file":
        # @req REQ-PARSER-DEPREC-018
        # @capture(bit_table): three bracket forms coexist and all execute
        step("Declare a bracket-generic function, struct, and annotation in one scenario")
        fn multi[T](x: T) -> T:
            x
        struct Wrap[T]:
            item: T
        val tagged: Option[i64] = Some(6)
        val unwrapped = tagged?
        val wrapped = Wrap(item: unwrapped)
        expect(multi(wrapped.item)).to_equal(6)  # oracle: all three deprecated forms compiled and composed to 6

describe "Class Generic Deprecation Warnings":
    it "warns about deprecated [] syntax in class":
        # @req REQ-PARSER-DEPREC-019
        # @capture(bit_table): bracket-generic class field round-trip
        step("Declare class Holder[T], construct it, read the field")
        class Holder[T]:
            item: T
        val h = Holder(item: 5)
        expect(h.item).to_equal(5)  # oracle: the deprecated class form constructed and stored 5

    it "does NOT warn about <> syntax in class":
        # @req REQ-PARSER-DEPREC-020
        # @capture(bit_table): angle-generic class field round-trip
        step("Declare class Cup<V>, construct it, read the field")
        class Cup<V>:
            item: V
        val c = Cup(item: 3)
        expect(c.item).to_equal(3)  # oracle: the modern class form constructed and stored 3

describe "Enum Generic Deprecation Warnings":
    it "warns about deprecated [] syntax in enum":
        # @req REQ-PARSER-DEPREC-021
        # @capture(bit_table): bracket-generic enum declaration contract
        step("Declare a generic enum with bracket parameters")
        enum Res[T, E]:
            Good(T)
            Bad(E)
        val spec_source = file_read("test/03_system/feature/usage/parser_deprecation_warnings_spec.spl")
        val bracket_generic_enum_declared = spec_source.contains("enum Res[T, E]:")
        expect(bracket_generic_enum_declared).to_equal(true)  # oracle: this compiled file is the shipped grammar evidence; variant construction is not yet runtime-resolvable

    it "does NOT warn about <> syntax in enum":
        # @req REQ-PARSER-DEPREC-022
        # @capture(bit_table): angle-generic enum declaration contract
        step("Declare a generic enum with angle parameters")
        enum Res2<T, E>:
            Good(T)
            Bad(E)
        val spec_source = file_read("test/03_system/feature/usage/parser_deprecation_warnings_spec.spl")
        val angle_generic_enum_declared = spec_source.contains("enum Res2<T, E>:")
        expect(angle_generic_enum_declared).to_equal(true)  # oracle: this compiled file is the shipped grammar evidence; variant construction is not yet runtime-resolvable

describe "Trait Generic Parameters":
    it "warns about deprecated [] syntax in trait":
        # @req REQ-PARSER-DEPREC-023
        # @capture(bit_table): bracket-generic trait dispatch result
        step("Implement trait Iterator[T] for a struct and call the method")
        trait Iterator[T]:
            fn next_item() -> T
        struct Counter:
            n: i64
        impl Iterator[i64] for Counter:
            fn next_item() -> i64:
                self.n
        val c = Counter { n: 7 }
        expect(c.next_item()).to_equal(7)  # oracle: the deprecated trait form compiled and dispatched to 7

    it "does NOT warn about <> syntax in trait":
        # @req REQ-PARSER-DEPREC-024
        # @capture(bit_table): angle-generic trait dispatch result
        step("Implement trait Stream<V> for a struct and call the method")
        trait Stream<V>:
            fn next_item() -> V
        struct Ticker:
            n: i64
        impl Stream<i64> for Ticker:
            fn next_item() -> i64:
                self.n
        val t = Ticker { n: 8 }
        expect(t.next_item()).to_equal(8)  # oracle: the modern trait form compiled and dispatched to 8

describe "Return Type Deprecation Warnings":
    it "warns about deprecated [] syntax in return type":
        # @req REQ-PARSER-DEPREC-025
        # @capture(bit_table): bracket-annotated return type unwraps
        step("Declare a function returning Option[i64] and unwrap the call")
        fn get2() -> Option[i64]:
            Some(8)
        expect(get2()?).to_equal(8)  # oracle: the deprecated return annotation parsed and unwrapped to 8

    it "does NOT warn about <> syntax in return type":
        # @req REQ-PARSER-DEPREC-026
        # @capture(bit_table): angle-annotated return type unwraps
        step("Declare a function returning Option<i64> and unwrap the call")
        fn get3() -> Option<i64>:
            Some(9)
        expect(get3()?).to_equal(9)  # oracle: the modern return annotation parsed and unwrapped to 9

describe "Const Generic Parameters":
    it "warns about deprecated [] syntax with const generics":
        # @req REQ-PARSER-DEPREC-027
        # @capture(bit_table): bracket const-generic struct field
        step("Declare struct Buf2[T, const N] with a bracket const parameter")
        struct Buf2[T, const N: i64]:
            first: T
        val b2 = Buf2(first: 2)
        expect(b2.first).to_equal(2)  # oracle: the deprecated const-generic form constructed and stored 2

    it "does NOT warn about <> syntax with const generics":
        # @req REQ-PARSER-DEPREC-028
        # @capture(bit_table): angle const-generic struct field
        step("Declare struct Buf<T, const N> with an angle const parameter")
        struct Buf<T, const N: i64>:
            first: T
        val b = Buf(first: 1)
        expect(b.first).to_equal(1)  # oracle: the modern const-generic form constructed and stored 1

describe "Impl Block Deprecation Warnings":
    it "warns about [] in impl block":
        # @req REQ-PARSER-DEPREC-029
        # @capture(bit_table): bracket-generic impl method result
        step("Declare impl[T] C2 with a bracket parameter and call its method")
        struct C2:
            v: i64
        impl[T] C2:
            fn get() -> i64:
                self.v
        val c2 = C2 { v: 6 }
        expect(c2.get()).to_equal(6)  # oracle: the deprecated impl form compiled and returned 6

    it "does NOT warn about <> in impl block":
        # @req REQ-PARSER-DEPREC-030
        # @capture(bit_table): angle-generic impl method result
        step("Declare impl<V> C3 with an angle parameter and call its method")
        struct C3:
            v: i64
        impl<V> C3:
            fn get() -> i64:
                self.v
        val c3 = C3 { v: 6 }
        expect(c3.get()).to_equal(6)  # oracle: the modern impl form compiled and returned 6

describe "Deprecation Warning Edge Cases":
    it "old syntax warns, new syntax does not":
        # @req REQ-PARSER-DEPREC-031
        # @capture(bit_table): legacy bracket and modern angle forms side by side
        step("Declare fn legacy2[T] and fn fresh<U> in one scenario and call both")
        fn legacy2[T](x: T) -> T:
            x
        fn fresh[U](y: U) -> U:
            y
        expect(legacy2(1) + fresh(1)).to_equal(2)  # oracle: both eras of syntax compose to 2 in one file
