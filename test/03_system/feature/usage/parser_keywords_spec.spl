use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_keywords_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_keywords_spec.md
# doc-path: doc/03_plan/sys_test/parser_keywords_spec.md
# doc-path: doc/04_architecture/parser_keywords_spec.md
# doc-path: doc/05_design/parser_keywords_spec_oracles.md
# @manual: primary

"""
# Parser Keywords Specification

**Feature IDs:** #PARSER-KW-001 to #PARSER-KW-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that all Simple language keywords are correctly recognized and
parsed in their appropriate contexts.
"""


# Module-level test type definitions
struct TestPoint:
    x: i64
    y: i64

impl TestPoint:
    fn get_x() -> i64:
        self.x

    fn get_y() -> i64:
        self.y


# ============================================================================
# Test Group 1: Variable Keywords
# ============================================================================

describe "Variable Keyword Parsing":
    it "val declares immutable variable":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: val declares immutable variable")
        val x = 42
        expect(x).to_equal(42)

    it "var declares mutable variable":
        step("Verify: var declares mutable variable")
        var x = 0
        x = 42
        expect(x).to_equal(42)


# ============================================================================
# Test Group 2: Control Flow Keywords
# ============================================================================

describe "Control Flow Keyword Parsing":
    it "parses if statement":
        step("Verify: parses if statement")
        val result = if true:
            1
        else:
            0
        expect(result).to_equal(1)

    it "parses elif statement":
        step("Verify: parses elif statement")
        val x = 2
        val result = if x == 1:
            "one"
        elif x == 2:
            "two"
        else:
            "other"
        expect(result).to_equal("two")

    it "parses while loop":
        step("Verify: parses while loop")
        var x = 0
        while x < 3:
            x = x + 1
        expect(x).to_equal(3)

    it "parses for loop":
        step("Verify: parses for loop")
        var sum = 0
        for i in [1, 2, 3]:
            sum = sum + i
        expect(sum).to_equal(6)

    it "parses break in loop":
        step("Verify: parses break in loop")
        var x = 0
        while true:
            x = x + 1
            if x >= 5:
                break
        expect(x).to_equal(5)

    it "parses continue in loop":
        step("Verify: parses continue in loop")
        var sum = 0
        for i in [1, 2, 3, 4, 5]:
            if i == 3:
                continue
            sum = sum + i
        expect(sum).to_equal(12)

    it "parses return statement":
        step("Verify: parses return statement")
        fn early_return(x: i64) -> i64:
            if x < 0:
                return 0
            x
        expect(early_return(-1)).to_equal(0)
        expect(early_return(5)).to_equal(5)

    it "parses match expression":
        step("Verify: parses match expression")
        val result = match 42:
            case 0 => "zero"
            case 42 => "forty-two"
            case _ => "other"
        expect(result).to_equal("forty-two")


# ============================================================================
# Test Group 3: Logic Keywords
# ============================================================================

describe "Logic Keyword Parsing":
    it "parses and operator":
        step("Verify: parses and operator")
        expect((true and true)).to_equal(true)
        expect((true and false)).to_equal(false)
        expect((false and true)).to_equal(false)

    it "parses or operator":
        step("Verify: parses or operator")
        expect((true or true)).to_equal(true)
        expect((true or false)).to_equal(true)
        expect((false or false)).to_equal(false)

    it "parses not operator":
        step("Verify: parses not operator")
        expect((not false)).to_equal(true)
        expect((not true)).to_equal(false)

    it "parses in operator":
        step("Verify: parses in operator")
        assert_true(2 in [1, 2, 3])
        expect not (5 in [1, 2, 3])


# ============================================================================
# Test Group 4: Special Keywords
# ============================================================================

describe "Special Keyword Parsing":
    it "parses true":
        step("Verify: parses true")
        val x = true
        assert_true(x)

    it "parses false":
        step("Verify: parses false")
        val x = false
        assert_true(not x)

    it "parses nil":
        step("Verify: parses nil")
        val x = nil
        expect(x).to_equal(nil)

    it "parses self in method":
        step("Verify: parses self in method")
        val p = TestPoint(x: 42, y: 10)
        expect(p.get_x()).to_equal(42)
        expect(p.get_y()).to_equal(10)


# ============================================================================
# Test Group 5: Function Keywords
# ============================================================================

describe "Function Keyword Parsing":
    it "parses fn declaration":
        step("Verify: parses fn declaration")
        fn add(a: i64, b: i64) -> i64:
            a + b
        expect(add(3, 4)).to_equal(7)

    it "parses nested function":
        step("Verify: parses nested function")
        fn outer(x: i64) -> i64:
            fn inner(y: i64) -> i64:
                y * 2
            inner(x) + 1
        expect(outer(5)).to_equal(11)

    it "parses lambda expression":
        step("Verify: parses lambda expression")
        val double = \x: x * 2
        expect(double(5)).to_equal(10)

    it "parses higher-order function":
        step("Verify: parses higher-order function")
        fn apply(f: fn(i64) -> i64, x: i64) -> i64:
            f(x)
        expect(apply(\n: n + 1, 5)).to_equal(6)
