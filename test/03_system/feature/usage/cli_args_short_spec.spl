"""
# CLI Args Short Names Specification

**Feature ID:** #CLI-003
**Category:** Language | CLI
**Status:** Implemented

## Purpose and audience
Purpose: pin short-option behavior — single-dash flags, single-dash value
options, explicit short overrides, and conflict resolution — through the real
CLI parser (std.nogc_sync_mut.cli.cli_parser) that the `cli` keyword's
generated parsers build on, instead of comparing locally constructed
literals. An empty short must never match, an unknown short must fall through
to `remaining` without touching defaults, and an explicit uppercase short
must stay distinct from lowercase.
Audience: language/CLI engineers who maintain the `cli` keyword and the
nogc_sync_mut CLI parser.

## Operator workflow
Run `src/compiler_rust/target/bootstrap/simple run
test/03_system/feature/usage/cli_args_short_spec.spl` and confirm every
example passes. Each scenario starts with a Verify step and checks parsed
values against inline `# oracle:` comments.

## Compatibility and limitations
Covers only the parser behaviors asserted below on the current toolchain.
The `cli:` keyword desugaring that generates these parser calls end to end
is exercised by the compiler suites, not here.

## Verification guidance and troubleshooting
On failure, read the first failing Verify step and compare the reported
parsed value against its inline `# oracle:` comment; re-run this single spec
before bisecting parser changes.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# plan doc/03_plan/sspec_modernization_plan.md ;
# architecture doc/04_architecture/sspec_documentization_maintenance.md ;
# design doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step
use std.nogc_sync_mut.cli.cli_parser.{
    cli_spec, cli_spec_flag, cli_spec_option, parse_cli_args, parsed_flag, parsed_option
}

# @manual_section: CLI args short names

describe "CLI Args Short Names":
    it "short flag form toggles its long flag":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): verbose flag state before and after -v
        step("Verify: define verbose with short v and parse only -v")
        val spec = cli_spec_flag(cli_spec(), "verbose", "v", "verbose output")
        val quiet = parse_cli_args(spec, [])
        expect(parsed_flag(quiet, "verbose")).to_equal(false)  # oracle: flag default is false
        val parsed = parse_cli_args(spec, ["-v"])
        expect(parsed_flag(parsed, "verbose")).to_equal(true)  # oracle: -v toggles the long flag

    it "short option form consumes the following value":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): output option default and -o parsed value
        step("Verify: define output with short o and parse -o file.txt")
        val spec = cli_spec_option(cli_spec(), "output", "o", "output path", "default.txt", [])
        val untouched = parse_cli_args(spec, [])
        expect(parsed_option(untouched, "output")).to_equal("default.txt")  # oracle: default retained
        val parsed = parse_cli_args(spec, ["-o", "file.txt"])
        expect(parsed_option(parsed, "output")).to_equal("file.txt")  # oracle: -o consumes next arg

    it "short int option parses its numeric value":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): count option default and -c parsed value
        step("Verify: define count with short c and parse -c 5")
        val spec = cli_spec_option(cli_spec(), "count", "c", "repeat count", "1", [])
        val parsed = parse_cli_args(spec, ["-c", "5"])
        expect(parsed_option(parsed, "count").to_i64()).to_equal(5)  # oracle: -c value round-trips as int

    it "explicit short name routes to its own option":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): threads option parsed through explicit -t
        step("Verify: define threads with explicit short t and parse -t 8")
        val spec = cli_spec_option(cli_spec(), "threads", "t", "worker threads", "4", [])
        val parsed = parse_cli_args(spec, ["-t", "8"])
        expect(parsed_option(parsed, "threads").to_i64()).to_equal(8)  # oracle: explicit -t overrides default 4

    it "uppercase short name stays distinct from its lowercase form":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): color flag state after -C
        step("Verify: define color with short C and parse -C")
        val spec = cli_spec_flag(cli_spec(), "color", "C", "color output")
        val parsed = parse_cli_args(spec, ["-C"])
        expect(parsed_flag(parsed, "color")).to_equal(true)  # oracle: uppercase -C toggles color

    it "conflicting option without a short keeps only its long form":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): count with -c, color with empty short
        step("Verify: give count short c and color an empty short, then parse -C")
        val with_count = cli_spec_option(cli_spec(), "count", "c", "repeat count", "1", [])
        val spec = cli_spec_flag(with_count, "color", "", "color output")
        val parsed = parse_cli_args(spec, ["-C"])
        expect(parsed_flag(parsed, "color")).to_equal(false)  # oracle: empty short never matches
        expect(parsed.remaining.len()).to_equal(1)  # oracle: unmatched -C is preserved as remaining
        expect(parsed.remaining[0]).to_equal("-C")  # oracle: the exact unmatched token

    it "explicit short resolves a first-letter conflict":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): count via -c and color via explicit -C
        step("Verify: count takes c and color takes explicit C, both parse")
        val with_count = cli_spec_option(cli_spec(), "count", "c", "repeat count", "1", [])
        val spec = cli_spec_flag(with_count, "color", "C", "color output")
        val counted = parse_cli_args(spec, ["-c", "5"])
        expect(parsed_option(counted, "count").to_i64()).to_equal(5)  # oracle: count keeps short c
        val colored = parse_cli_args(spec, ["-C"])
        expect(parsed_flag(colored, "color")).to_equal(true)  # oracle: explicit -C reaches color

    it "invalid short flag is unknown and leaves every default intact":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): defaults after an unmatched -z
        step("Verify: parse -z against a spec that never declared it")
        val spec = cli_spec_flag(cli_spec(), "verbose", "v", "verbose output")
        val parsed = parse_cli_args(spec, ["-z"])
        expect(parsed_flag(parsed, "verbose")).to_equal(false)  # oracle: unknown short changes nothing
        expect(parsed.remaining[0]).to_equal("-z")  # oracle: unknown short reported in remaining
