# Purpose and audience: executable parser-branch evidence for the compiler team —
# every scenario observes one disambiguation outcome a reviewer checks when the
# contextual-keyword lookahead changes.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Contextual Keyword Disambiguation

**Feature ID:** #PARSER-012
**Category:** Syntax
**Status:** Active

## Purpose and audience

For parser engineers working on keyword lookahead: this spec pins all six
disambiguation branches (keyword vs identifier for `skip`, `static`, `default`)
plus the coexistence and keyword-prefixed-identifier edges, so a lookahead
regression fails here with a named outcome.

## Overview

Simple treats `skip`, `static`, and `default` as contextual keywords rather than
fully reserved words. This means each token can serve as either a keyword or an
ordinary identifier depending on syntactic context -- specifically, whether it is
followed by `(`. The spec validates all six disambiguation branches (keyword vs
identifier for each of the three tokens), confirms that multiple contextual
keywords can coexist as method names within a single class, and ensures that
identifiers merely prefixed with a keyword name (e.g., `skip_all`) are never
misinterpreted.

## Syntax

```simple
# skip as identifier (followed by '(')
use std.spec.step

fn skip(n):
return n * 2
val result = skip(5)

# skip as keyword (standalone statement)
skip

# static as keyword in method declaration
class Math:
static fn add(a, b):
return a + b
Math.add(3, 7)

# default as identifier on a class method
class Settings:
fn default():
return 200
settings.default()
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Contextual keyword | A token that acts as a keyword or identifier based on surrounding syntax |
| Lookahead disambiguation | The parser checks for a following `(` to decide identifier vs keyword |
| Branch coverage | All six branches (keyword/identifier x three tokens) are exercised |
| Coexistence | A single class can define methods named `skip`, `static`, and `default` |
"""

use std.spec.step

# Branch subjects declared at module scope: each scenario below observes the
# outcome of parsing these declarations rather than re-declaring them inline.
fn skip(n):
    return n * 2

fn exercise_skip_as_identifier(n):
    # Calls the identifier `skip` with an argument — the branch-1 lookahead case.
    return skip(n)

class MyClass:
    fn skip(n):
        return n + 1

class Multi:
    fn skip():
        return 1

    fn static():
        return 2

    fn default():
        return 3

# Branch 1: skip as Identifier (followed by '(')
describe "skip as identifier":
    # @manual scenario evidence
    it "works as function name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-1 call result for the identifier reading of skip
        step("call an identifier named skip with an argument")
        expect(exercise_skip_as_identifier(5)).to_equal(10)  # oracle: the identifier skip doubles its argument — 2 * 5

    it "works as method name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-1 method dispatch result for a skip-named method
        step("dispatch a method named skip on an instance")
        val obj = MyClass()
        val result = obj.skip(10)
        expect(result).to_equal(11)  # oracle: MyClass.skip adds one to its argument — 10 + 1

# Branch 2: skip as Keyword (NOT followed by '(')
describe "skip as keyword":
    it "works as standalone statement":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): bare-statement parse continuation after the skip keyword
        step("parse a bare skip statement")
        skip
        assert_true(true)

    it "works in function body":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): post-keyword return value from the function body
        step("run a function whose body holds the skip keyword")
        fn test():
            skip
            return 42
        expect(test()).to_equal(42)  # oracle: the body skips the keyword statement and returns 42

# Branch 3: static as Identifier (followed by '(')
describe "static as identifier":
    it "works as function name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-3 call result for the identifier reading of static
        step("call an identifier named static")
        fn static():
            return "static func"
        expect(static()).to_equal("static func")

    it "works as method name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-3 method dispatch result for a static-named method
        step("dispatch a method named static on an instance")
        class Config:
            fn static():
                return 100

        val cfg = Config()
        expect(cfg.static()).to_equal(100)  # oracle: Config.static returns the fixed constant 100

# Branch 4: static as Keyword (NOT followed by '(')
describe "static as keyword":
    it "works in static method declaration":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): static-method call result from the keyword reading
        step("invoke a static method declared with the keyword form")
        class Math:
            static fn add(a, b):
                return a + b

        expect(Math.add(3, 7)).to_equal(10)  # oracle: the static method sums its arguments — 3 + 7

# Branch 5: default as Identifier (followed by '(')
describe "default as identifier":
    it "works as function name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-5 call result for the identifier reading of default
        step("call an identifier named default")
        fn default():
            return "default val"
        expect(default()).to_equal("default val")

    it "works as method name":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): branch-5 method dispatch result for a default-named method
        step("dispatch a method named default on an instance")
        class Settings:
            fn default():
                return 200

        val settings = Settings()
        expect(settings.default()).to_equal(200)  # oracle: Settings.default returns the fixed constant 200

# Branch 6: default as Keyword (NOT followed by '(')
describe "default as keyword":
    it "parses in match context":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): match-arm selection with the default reading in play
        step("match a value with no matching case arm")
        val x = 5
        val result = match x:
            case 1: "one"
            case _: "other"
        expect(result).to_equal("other")

# Edge Cases
describe "edge cases":
    it "allows all three keywords as method names in same class":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): three-method dispatch table for the coexistence edge
        step("dispatch all three keyword-named methods on one instance")
        val obj = Multi()
        expect(obj.skip()).to_equal(1)  # oracle: Multi.skip returns the constant 1
        expect(obj.static()).to_equal(2)  # oracle: Multi.static returns the constant 2
        expect(obj.default()).to_equal(3)  # oracle: Multi.default returns the constant 3

    it "distinguishes keywords from underscored identifiers":
        # @req REQ-SSPEC-SYSTEM
        # @capture(bit_table): combined identifier values proving no keyword split
        step("read the three keyword-prefixed identifiers together")
        val skip_all = 10
        val static_var = 20
        val default_value = 30
        expect(skip_all + static_var + default_value).to_equal(60)  # oracle: 10 + 20 + 30 — each keyword-prefixed name lexes as one identifier
        expect(static_var - skip_all).to_equal(10)  # oracle: 20 - 10 — pins which identifier holds which value

print "✅ All contextual keyword tests passed!"
print "Branch Coverage: 6/6 (100%)"
