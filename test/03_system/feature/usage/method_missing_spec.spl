use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/method_missing_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/method_missing_spec.md
# doc-path: doc/03_plan/sys_test/method_missing_spec.md
# doc-path: doc/04_architecture/method_missing_spec.md
# doc-path: doc/05_design/method_missing_spec_oracles.md
# @manual: primary

"""
# Method Missing Handler Specification

**Feature ID:** #TBD
**Category:** Language
**Difficulty:** 3/5
**Status:** Planned

## Overview

Tests for the method_missing dynamic dispatch mechanism that allows objects
to handle calls to undefined methods at runtime through a catch-all handler.

## Syntax

```simple
class DynamicHandler:
fn method_missing(name: text, args: List) -> Any:
# Handle undefined method calls
print "Called {name} with {args}"
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Dynamic Dispatch | Runtime method resolution for undefined methods |
| Method Missing | Catch-all handler for unimplemented methods |
| Reflection | Access to method name and arguments at runtime |
| Fallback Behavior | Default handling when method doesn't exist |

## Behavior

- method_missing is called when a method is not found on an object
- Receives method name and argument list as parameters
- Allows runtime behavior customization and dynamic APIs
- Can raise errors or provide default implementations
- Integration with reflection and introspection

## Related Specifications

- Dynamic Typing - Runtime type behavior
- Reflection - Introspection capabilities
- Error Handling - Exception propagation from method_missing
"""


# ============================================================================
# Test Group 1: Basic Method Missing Handling
# ============================================================================

describe "Method Missing Basic Handling":
    # ## Basic Usage
    #
    # Verifies that method_missing is called for undefined methods
    # and handles arguments correctly.

    it "routes an unknown call to method_missing":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: unknown method reaches method_missing and returns its value")
        class Router:
            fn method_missing(self, name, args, block):
                return 42
        val r = Router {}
        expect r.unknown_method() == 42


# ============================================================================
# Test Group 2: Method Missing with Arguments
# ============================================================================

describe "Method Missing with Arguments":
    # ## Argument Handling
    #
    # Tests that method_missing correctly receives and processes
    # method name, arguments, and block parameters.

    it "forwards call arguments into method_missing":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: args[0] flows through method_missing to the product")
        class Multiplier:
            factor: i64 = 10
            fn method_missing(self, name, args, block):
                return self.factor * args[0]
        val m = Multiplier { factor: 7 }
        expect m.any_method(6) == 42


# ============================================================================
# Test Group 3: Advanced Method Missing Features
# ============================================================================

describe "Method Missing Advanced Features":
    # ## Complex Scenarios
    #
    # Tests error handling, performance implications, integration
    # with other features, and advanced reflection capabilities.

    it "method_missing observes the called method name":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: the hook receives the unknown method name as text")
        class Recorder:
            fn method_missing(self, name, args, block):
                return name
        val rec = Recorder {}
        expect rec.shouted_name() == :shouted_name
