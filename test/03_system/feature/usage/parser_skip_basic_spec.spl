use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_skip_basic_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_skip_basic_spec.md
# doc-path: doc/03_plan/sys_test/parser_skip_basic_spec.md
# doc-path: doc/04_architecture/parser_skip_basic_spec.md
# doc-path: doc/05_design/parser_skip_basic_spec_oracles.md
# @manual: primary

"""
# Skip Keyword - Basic Functionality

**Feature ID:** #PARSER-002
**Category:** Syntax
**Status:** Active

## Overview

Tests basic parsing and runtime behavior of the `skip` keyword as a standalone
statement. Verifies that skip can be used in various contexts (if blocks,
function bodies, loops), that it does not prevent subsequent code execution,
does not affect return values, and does not alter variable scope.

## Syntax

```simple
skip
fn test_function():
skip
return "completed"
```
"""
describe "Skip keyword - basic functionality":
    it "parses skip as standalone statement":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: parses skip as standalone statement")
        var executed = true
        skip
        expect(executed).to_equal(true)

    it "parses skip with pass":
        step("Verify: parses skip with pass")
        skip
        pass
        assert_true(true)

    it "parses skip in if block":
        step("Verify: parses skip in if block")
        val condition = true
        if condition:
            skip
        assert_true(true)

    it "parses skip in function body":
        step("Verify: parses skip in function body")
        fn test_function():
            skip
            return "completed"
        expect(test_function()).to_equal("completed")

    it "parses multiple skip statements":
        step("Verify: parses multiple skip statements")
        skip
        skip
        skip
        assert_true(true)

    it "parses skip before expression":
        step("Verify: parses skip before expression")
        skip
        val result = 2 + 2
        expect(result).to_equal(4)

    it "parses skip in loop":
        step("Verify: parses skip in loop")
        var count = 0
        for i in 0..3:
            skip
            count = count + 1
        expect(count).to_equal(3)

    it "skip does not prevent execution":
        step("Verify: skip does not prevent execution")
        var executed = false
        skip
        executed = true
        expect(executed).to_equal(true)

    it "skip does not affect return value":
        step("Verify: skip does not affect return value")
        fn returns_with_skip():
            skip
            return "value"
        expect(returns_with_skip()).to_equal("value")

    it "skip does not affect variable scope":
        step("Verify: skip does not affect variable scope")
        skip
        val scoped = 100
        expect(scoped).to_equal(100)
