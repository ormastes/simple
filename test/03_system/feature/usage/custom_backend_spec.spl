"""
## Purpose and audience
Purpose: should create ArrayList from array literal
Audience: compiler and tooling engineers who maintain this spec

# Custom Collection Backends

**Feature ID:** #COLL-001
**Category:** Runtime
**Status:** Active

## Overview

Tests custom collection backend implementations including ArrayList and HashMap.
Validates that array literals can be typed as ArrayList with push/pop/get
operations, and that dictionary literals can be typed as HashMap with
key-based access and insertion.

## Syntax

```simple
val arr: ArrayList = [1, 2, 3]
arr.push(3)
val map: HashMap = {"a": 1, "b": 2}
map["b"] = 2
```
Custom Collection Backends - SPipe Tests
"""

# @req: REQ-FEATURE-CustBack-001

use std.spec.step
describe "Custom Collection Backends":

    context "ArrayList Implementation":
        it "should create ArrayList from array literal":
            step("Verify: should create ArrayList from array literal")
            # @req: REQ-FEATURE-CustBack-001
            val arr: ArrayList = [1, 2, 3]
            expect(arr.len()).to_equal(3)  # oracle: value fixed by the spec contract

        it "should support push":
            step("Verify: should support push")
            # @req: REQ-FEATURE-CustBack-001
            var arr: ArrayList = [1, 2]
            arr.push(3)
            expect(arr.len()).to_equal(3)  # oracle: value fixed by the spec contract

        it "should support pop":
            step("Verify: should support pop")
            # @req: REQ-FEATURE-CustBack-001
            var arr: ArrayList = [1, 2, 3]
            val last = arr.pop()
            expect last == 3
            expect arr.len() == 2

        it "should support get":
            step("Verify: should support get")
            # @req: REQ-FEATURE-CustBack-001
            val arr: ArrayList = [10, 20, 30]
            expect(arr.get(0)).to_equal(10)  # oracle: value fixed by the spec contract
            expect(arr.get(2)).to_equal(30)  # oracle: value fixed by the spec contract

    context "HashMap Implementation":
        it "should create HashMap from dict literal":
            step("Verify: should create HashMap from dict literal")
            # @req: REQ-FEATURE-CustBack-001
            val map: HashMap = {"a": 1, "b": 2}
            expect(map.len()).to_equal(2)  # oracle: value fixed by the spec contract

        it "should support get":
            step("Verify: should support get")
            # @req: REQ-FEATURE-CustBack-001
            val map: HashMap = {"a": 1, "b": 2}
            expect map["a"] == 1
            expect map["b"] == 2

        it "should support insert":
            step("Verify: should support insert")
            # @req: REQ-FEATURE-CustBack-001
            var map: HashMap = {"a": 1}
            map["b"] = 2
            expect map["b"] == 2
