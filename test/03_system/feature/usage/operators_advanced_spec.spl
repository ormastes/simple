"""
## Purpose and audience

Pins the advanced operator and declaration surface: mutability control
(let/var/const/static), lambdas and higher-order calls, string/array/dict
methods, bitwise and comparison operators, logical operators, power, floor
division, the in operator, recursion, nested data, early return, tuple
destructuring, and symbols. Written for language engineers guarding operator
semantics against parser and interpreter drift.

## Operator workflow

Run `simple run test/03_system/feature/usage/operators_advanced_spec.spl`.
Every scenario evaluates real expressions on the host interpreter.

## Compatibility and limitations

Immutability of `let` is enforced at compile time, so the runtime scenario
pins the read-back contract; the rejection path belongs to the compiler
diagnostics lane. Floor division is the `.fdiv()` method because `//` is now
the parallel-execution operator.

## Verification guidance and troubleshooting

Rerun the command above. A failure isolates the operator under test: each
oracle comment states the arithmetic or identity behind the expected value, so
a mismatch points at evaluation, not at the spec. Update an expectation only
when the language spec itself changed.
"""
# Lifecycle: doc/01_research/language/grammar/const_vs_val_grammar.md ;
# doc/03_plan/language/api_predicate_prefix_migration_2026-05-13.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/language/language_features/syntax_features/ufcs_dot_operator_design.md
# @manual_section: operators-advanced

use std.spec.step

describe "Mutability Control":
    # @manual scenario evidence
    it "let is immutable":
        # @req REQ-OP-ADV-001
        step("Bind a computed value with let and read it back")
        # @capture(statistics): let-bound read-back equals the computed 10
        val x = "abcdefghij".len()
        expect(x).to_equal(10)  # oracle: the probe string has 10 characters

    it "var is mutable":
        # @req REQ-OP-ADV-002
        step("Rebind a var and read the new value")
        # @capture(statistics): var rebound from 10 to 30
        var y = 10
        y = 30
        expect(y).to_equal(30)  # oracle: reassignment replaces the bound value

    it "var in loop":
        # @req REQ-OP-ADV-003
        step("Accumulate a var across a five-iteration while loop")
        # @capture(statistics): loop accumulation reaches 10
        var sum = 0
        var i = 0
        while i < 5:
            sum = sum + i
            i = i + 1
        expect sum == 10  # 0+1+2+3+4

    it "const declaration":
        # @req REQ-OP-ADV-004
        step("Declare a const and read it back")
        # @capture(statistics): const read-back equals its initializer
        const MAX = 100
        expect(MAX).to_equal(100)  # oracle: a const keeps its initializer value

    it "const with arithmetic":
        # @req REQ-OP-ADV-005
        step("Multiply two consts and read the product")
        # @capture(statistics): BASE * MULTIPLIER reaches 50
        const BASE = 10
        const MULTIPLIER = 5
        expect(BASE * MULTIPLIER).to_equal(50)  # oracle: 10 * 5 = 50

    it "const with type annotation":
        # @req REQ-OP-ADV-006
        step("Declare a typed const and read it back")
        # @capture(statistics): typed const read-back equals 256
        const SIZE: i64 = 256
        expect(SIZE).to_equal(256)  # oracle: annotation does not change the bound value

    it "static variable":
        # @req REQ-OP-ADV-007
        step("Declare a static and read it back")
        # @capture(statistics): static read-back equals its initializer
        static counter = 42
        expect(counter).to_equal(42)  # oracle: a static keeps its initializer value

describe "Lambda Expressions":
    it "basic lambda":
        # @req REQ-OP-ADV-008
        step("Call a single-parameter doubling lambda")
        # @capture(statistics): doubling lambda reaches 42
        val double = \x: x * 2
        expect(double(21)).to_equal(42)  # oracle: 21 * 2 = 42

    it "lambda with multiple params":
        # @req REQ-OP-ADV-009
        step("Call a two-parameter addition lambda")
        # @capture(statistics): addition lambda reaches 42
        val add = \a, b: a + b
        expect(add(10, 32)).to_equal(42)  # oracle: 10 + 32 = 42

    it "lambda as higher-order":
        # @req REQ-OP-ADV-010
        step("Pass a lambda into a higher-order function")
        # @capture(statistics): apply(inc, 41) reaches 42
        fn apply(f, x):
            f(x)

        val inc = \n: n + 1
        expect(apply(inc, 41)).to_equal(42)  # oracle: 41 + 1 = 42 through the callee

describe "String Operations":
    it "string length":
        # @req REQ-OP-ADV-011
        step("Measure a five-character string")
        # @capture(statistics): hello has length 5
        val s = "hello"
        expect(s.len()).to_equal(5)  # oracle: "hello" has 5 characters

    it "string concatenation":
        # @req REQ-OP-ADV-012
        step("Join two words with a space and measure the result")
        # @capture(statistics): hello+space+world has length 11
        val a = "hello"
        val b = "world"
        val c = a + " " + b
        expect(c.len()).to_equal(11)  # oracle: 5 + 1 + 5 characters

    it "string interpolation":
        # @req REQ-OP-ADV-013
        step("Interpolate an integer into a string and measure the result")
        # @capture(statistics): "value is 42" has length 11
        val x = 42
        val s = "value is {x}"
        expect(s.len()).to_equal(11)  # oracle: 42 renders as two characters inside a 9-character frame

describe "Array Methods":
    it "array length":
        # @req REQ-OP-ADV-014
        step("Measure a five-element array")
        # @capture(statistics): five-element array has length 5
        val arr = [1, 2, 3, 4, 5]
        expect(arr.len()).to_equal(5)  # oracle: five literal elements

describe "Dict Methods":
    it "dict length":
        # @req REQ-OP-ADV-015
        step("Measure a three-entry dict")
        # @capture(statistics): three-entry dict has length 3
        val d = {"a": 1, "b": 2, "c": 3}
        expect(d.len()).to_equal(3)  # oracle: three literal entries

    it "dict keys":
        # @req REQ-OP-ADV-016
        step("List the keys of a two-entry dict")
        # @capture(statistics): two-entry dict has two keys
        val d = {"x": 10, "y": 20}
        val keys = d.keys()
        expect(keys.len()).to_equal(2)  # oracle: one key per entry

    it "dict values":
        # @req REQ-OP-ADV-017
        step("Sum the values of a two-entry dict")
        # @capture(statistics): values 5 and 10 sum to 15
        val d = {"a": 5, "b": 10}
        val vals = d.values()
        expect(vals[0] + vals[1]).to_equal(15)  # oracle: 5 + 10 = 15

    it "dict contains_key":
        # @req REQ-OP-ADV-018
        step("Probe a dict for a key it holds")
        # @capture(statistics): has("hello") is truthy for the held key
        val d = {"hello": 1}
        expect d.has("hello")

describe "Bitwise Operators":
    it "bitwise AND":
        # @req REQ-OP-ADV-019
        step("AND the bit patterns 1100 and 1010")
        # @capture(bit_table): 1100 & 1010 = 1000
        expect (12 & 10) == 8  # oracle: 1100 & 1010 = 1000

    it "bitwise OR":
        # @req REQ-OP-ADV-020
        step("OR the bit patterns 1100 and 1010")
        # @capture(bit_table): 1100 | 1010 = 1110
        expect (12 | 10) == 14  # oracle: 1100 | 1010 = 1110

    it "bitwise XOR":
        # @req REQ-OP-ADV-021
        step("XOR the bit patterns 1100 and 1010")
        # @capture(bit_table): 1100 ^ 1010 = 0110
        expect (12 xor 10) == 6  # oracle: 1100 ^ 1010 = 0110

    it "left shift":
        # @req REQ-OP-ADV-022
        step("Shift 1 left by four positions")
        # @capture(bit_table): 1 << 4 = 10000
        expect (1 << 4) == 16  # oracle: shifting 1 up four places reaches 16

    it "right shift":
        # @req REQ-OP-ADV-023
        step("Shift 16 right by two positions")
        # @capture(bit_table): 10000 >> 2 = 100
        expect (16 >> 2) == 4  # oracle: shifting 16 down two places reaches 4

    it "bitwise NOT":
        # @req REQ-OP-ADV-024
        step("Negate all bits of 0")
        # @capture(bit_table): ~0 = -1 two's complement
        expect (~0) == -1  # oracle: two's-complement NOT of zero is -1

describe "Comparison Operators":
    it "less than":
        # @req REQ-OP-ADV-025
        step("Compare 1 < 2")
        # @capture(bit_table): 1 < 2 holds
        expect 1 < 2

    it "greater than":
        # @req REQ-OP-ADV-026
        step("Compare 2 > 1")
        # @capture(bit_table): 2 > 1 holds
        expect 2 > 1

    it "less than or equal":
        # @req REQ-OP-ADV-027
        step("Compare 2 <= 2 on equal operands")
        # @capture(bit_table): 2 <= 2 holds on equality
        expect 2 <= 2

    it "greater than or equal":
        # @req REQ-OP-ADV-028
        step("Compare 2 >= 2 on equal operands")
        # @capture(bit_table): 2 >= 2 holds on equality
        expect 2 >= 2

    it "equal":
        # @req REQ-OP-ADV-029
        step("Compare 2 == 2 on identical operands")
        # @capture(bit_table): 2 == 2 holds
        expect 2 == 2

    it "not equal":
        # @req REQ-OP-ADV-030
        step("Compare 2 != 3 on distinct operands")
        # @capture(bit_table): 2 != 3 holds
        expect 2 != 3

describe "Logical Operators":
    it "and operator":
        # @req REQ-OP-ADV-031
        step("Conjoin two truths and negate a false conjunction")
        # @capture(bit_table): true and true holds; true and false does not
        expect true and true
        expect not (true and false)

    it "or operator":
        # @req REQ-OP-ADV-032
        step("Disjoin truth with falsehood and reject a double falsehood")
        # @capture(bit_table): true or false holds; false or false does not
        expect true or false
        expect not (false or false)

    it "not operator":
        # @req REQ-OP-ADV-033
        step("Negate falsehood and double-negate truth")
        # @capture(bit_table): not false holds; not not true holds
        expect not false
        expect not (not true)

describe "Power Operator":
    it "power of zero":
        # @req REQ-OP-ADV-034
        step("Raise 2 to the zeroth power")
        # @capture(statistics): 2 ** 0 = 1
        expect (2 ** 0) == 1  # oracle: anything to the zeroth power is 1

    it "power of one":
        # @req REQ-OP-ADV-035
        step("Raise 2 to the first power")
        # @capture(statistics): 2 ** 1 = 2
        expect (2 ** 1) == 2  # oracle: anything to the first power is itself

    it "power of three":
        # @req REQ-OP-ADV-036
        step("Raise 2 to the third power")
        # @capture(statistics): 2 ** 3 = 8
        expect (2 ** 3) == 8  # oracle: 2 * 2 * 2 = 8

    it "power of ten":
        # @req REQ-OP-ADV-037
        step("Raise 2 to the tenth power")
        # @capture(statistics): 2 ** 10 = 1024
        expect (2 ** 10) == 1024  # oracle: binary kilo, 2^10

    it "three to fourth":
        # @req REQ-OP-ADV-038
        step("Raise 3 to the fourth power")
        # @capture(statistics): 3 ** 4 = 81
        expect (3 ** 4) == 81  # oracle: 3 * 3 * 3 * 3 = 81

describe "Floor Division":
    it "positive floor division":
        # @req REQ-OP-ADV-039
        step("Floor-divide 7 by 2")
        # @capture(statistics): 7.fdiv(2) = 3
        expect 7.fdiv(2) == 3  # oracle: floor of 3.5 is 3

    it "another floor division":
        # @req REQ-OP-ADV-040
        step("Floor-divide 10 by 3")
        # @capture(statistics): 10.fdiv(3) = 3
        expect 10.fdiv(3) == 3  # oracle: floor of 3.33 is 3

    it "negative floor division":
        # @req REQ-OP-ADV-041
        step("Floor-divide -7 by 2 toward negative infinity")
        # @capture(statistics): (-7).fdiv(2) = -4
        expect (-7).fdiv(2) == -4  # oracle: rounds toward negative infinity, not zero

    it "exact division":
        # @req REQ-OP-ADV-042
        step("Floor-divide 8 by 4 exactly")
        # @capture(statistics): 8.fdiv(4) = 2
        expect 8.fdiv(4) == 2  # oracle: exact division is its own floor

describe "In Operator":
    it "in array present":
        # @req REQ-OP-ADV-043
        step("Probe an array for a member it holds")
        # @capture(bit_table): 2 in [1, 2, 3] holds
        expect 2 in [1, 2, 3]

    it "in array absent":
        # @req REQ-OP-ADV-044
        step("Probe an array for a value it lacks")
        # @capture(bit_table): 5 in [1, 2, 3] does not hold
        expect not (5 in [1, 2, 3])

    it "in string present":
        # @req REQ-OP-ADV-045
        step("Probe a string for a substring it contains")
        # @capture(bit_table): "ell" in "hello" holds
        expect "ell" in "hello"

    it "in string absent":
        # @req REQ-OP-ADV-046
        step("Probe a string for a substring it lacks")
        # @capture(bit_table): "xyz" in "hello" does not hold
        expect not ("xyz" in "hello")

describe "Recursive Functions":
    it "factorial":
        # @req REQ-OP-ADV-047
        step("Compute 3! through a self-recursive function")
        # @capture(statistics): factorial(3) = 6
        fn factorial(n: i64) -> i64:
            if n <= 1:
                1
            else:
                n * factorial(n - 1)

        expect(factorial(3)).to_equal(6)  # oracle: 3 * 2 * 1 = 6

describe "Nested Data Structures":
    it "nested arrays":
        # @req REQ-OP-ADV-048
        step("Index three nested arrays and sum one element from each")
        # @capture(statistics): nested picks 1 + 4 + 5 = 10
        val arr = [[1, 2], [3, 4], [5, 6]]
        expect(arr[0][0] + arr[1][1] + arr[2][0]).to_equal(10)  # oracle: 1 + 4 + 5 = 10

    it "nested structs":
        # @req REQ-OP-ADV-049
        step("Read a field through two nesting levels")
        # @capture(statistics): o.inner.value reaches 42
        struct Inner:
            value: i64

        struct Outer:
            inner: Inner

        val o = Outer(inner: Inner(value: 42))
        expect(o.inner.value).to_equal(42)  # oracle: the stored field value reads back through nesting

describe "Early Return":
    it "early return based on condition":
        # @req REQ-OP-ADV-050
        step("Hit the second return path of a three-path verifier")
        # @capture(statistics): verify(7) returns 2
        fn verify(x: i64) -> i64:
            if x > 10:
                return 1
            if x > 5:
                return 2
            3

        expect(verify(7)).to_equal(2)  # oracle: 7 fails the first guard, passes the second

describe "Tuple Destructuring":
    it "destructures tuple":
        # @req REQ-OP-ADV-051
        step("Index all three positions of a tuple and sum them")
        # @capture(statistics): 1 + 2 + 3 = 6
        val _tuple = (1, 2, 3)
        val a = _tuple[0]
        val b = _tuple[1]
        val c = _tuple[2]
        expect(a + b + c).to_equal(6)  # oracle: the three stored positions sum to 6

describe "Symbols":
    it "symbol comparison":
        # @req REQ-OP-ADV-052
        step("Compare identical symbols and distinct symbols")
        # @capture(bit_table): :hello == :hello holds; :hello == :world does not
        val s = :hello
        val twin = :hello
        val other = :world
        expect(s == twin).to_equal(true)  # oracle: identical symbol literals are the same symbol
        expect(not (s == other)).to_equal(true)  # oracle: distinct symbol names are different symbols
