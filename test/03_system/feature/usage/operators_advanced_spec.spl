use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/operators_advanced_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/operators_advanced_spec.md
# doc-path: doc/03_plan/sys_test/operators_advanced_spec.md
# doc-path: doc/04_architecture/operators_advanced_spec.md
# doc-path: doc/05_design/operators_advanced_spec_oracles.md
# @manual: primary

"""
# Advanced Operators Specification


**Feature IDs:** #OP-ADV-001 to #OP-ADV-030
**Category:** Language | Operators
**Status:** Implemented

Tests advanced operators and language features including:
- Mutability control (let, let mut, var, const, static)
- Lambda expressions
- String operations
- Array and dict methods
- Bitwise operators
- Comparison and logical operators
- Power and floor division
- In operator
- Symbols

## Syntax

```simple
# Mutability
let x = 10       # immutable
let mut y = 10   # mutable with let mut
var z = 10       # mutable with var
const MAX = 100  # constant
static counter = 0  # static variable

# Operators
val a = 12 & 10    # bitwise AND
val b = 2 ** 10    # power
val c = 7.fdiv(2)  # floor division (// is now parallel operator)
val d = "ell" in "hello"  # in operator
```
"""



# ============================================================================
# Test Group 1: Mutability Control
# ============================================================================

describe "Mutability Control":
    # ## let, let mut, var, const, static
    #
    # Tests variable mutability declarations.

    it "let is immutable":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: let is immutable")
        val x = 10
        # x = 20  # Would be error
        expect(x).to_equal(10)

    it "var is mutable":
        step("Verify: var is mutable")
        var y = 10
        y = 30
        expect(y).to_equal(30)

    it "var in loop":
        step("Verify: var in loop")
        var sum = 0
        var i = 0
        while i < 5:
            sum = sum + i
            i = i + 1
        expect(sum).to_equal(10)  # 0+1+2+3+4

    it "const declaration":
        step("Verify: const declaration")
        const MAX = 100
        expect(MAX).to_equal(100)

    it "const with arithmetic":
        step("Verify: const with arithmetic")
        const BASE = 10
        const MULTIPLIER = 5
        expect(BASE * MULTIPLIER).to_equal(50)

    it "const with type annotation":
        step("Verify: const with type annotation")
        const SIZE: i64 = 256
        expect(SIZE).to_equal(256)

    it "static variable":
        step("Verify: static variable")
        static counter = 42
        expect(counter).to_equal(42)


# ============================================================================
# Test Group 2: Lambda Expressions
# ============================================================================

describe "Lambda Expressions":
    # ## Lambda Syntax
    #
    # Tests lambda creation and usage.

    it "basic lambda":
        step("Verify: basic lambda")
        val double = \x: x * 2
        expect(double(21)).to_equal(42)

    it "lambda with multiple params":
        step("Verify: lambda with multiple params")
        val add = \a, b: a + b
        expect(add(10, 32)).to_equal(42)

    it "lambda as higher-order":
        step("Verify: lambda as higher-order")
        fn apply(f, x):
            f(x)

        val inc = \n: n + 1
        expect(apply(inc, 41)).to_equal(42)


# ============================================================================
# Test Group 3: String Operations
# ============================================================================

describe "String Operations":
    # ## String Methods
    #
    # Tests string length, concatenation, interpolation.

    it "string length":
        step("Verify: string length")
        val s = "hello"
        expect(s.len()).to_equal(5)

    it "string concatenation":
        step("Verify: string concatenation")
        val a = "hello"
        val b = "world"
        val c = a + " " + b
        expect(c.len()).to_equal(11)

    it "string interpolation":
        step("Verify: string interpolation")
        val x = 42
        val s = "value is {x}"
        expect(s.len()).to_equal(11)


# ============================================================================
# Test Group 4: Array Methods
# ============================================================================

describe "Array Methods":
    # ## Array Operations
    #
    # Tests array length and access.

    it "array length":
        step("Verify: array length")
        val arr = [1, 2, 3, 4, 5]
        expect(arr.len()).to_equal(5)


# ============================================================================
# Test Group 5: Dict Methods
# ============================================================================

describe "Dict Methods":
    # ## Dictionary Operations
    #
    # Tests dict length, keys, values, contains_key.

    it "dict length":
        step("Verify: dict length")
        val d = {"a": 1, "b": 2, "c": 3}
        expect(d.len()).to_equal(3)

    it "dict keys":
        step("Verify: dict keys")
        val d = {"x": 10, "y": 20}
        val keys = d.keys()
        expect(keys.len()).to_equal(2)

    it "dict values":
        step("Verify: dict values")
        val d = {"a": 5, "b": 10}
        val vals = d.values()
        expect(vals[0] + vals[1]).to_equal(15)

    it "dict contains_key":
        step("Verify: dict contains_key")
        val d = {"hello": 1}
        expect d.has("hello")


# ============================================================================
# Test Group 6: Bitwise Operators
# ============================================================================

describe "Bitwise Operators":
    # ## &, |, ^, <<, >>, ~
    #
    # Tests bitwise operations.

    it "bitwise AND":
        step("Verify: bitwise AND")
        expect((12 & 10)).to_equal(8)  # 1100 & 1010 = 1000

    it "bitwise OR":
        step("Verify: bitwise OR")
        expect((12 | 10)).to_equal(14)  # 1100 | 1010 = 1110

    it "bitwise XOR":
        step("Verify: bitwise XOR")
        expect((12 xor 10)).to_equal(6)  # 1100 ^ 1010 = 0110

    it "left shift":
        step("Verify: left shift")
        expect(1 << 4).to_equal(16)

    it "right shift":
        step("Verify: right shift")
        expect(16 >> 2).to_equal(4)

    it "bitwise NOT":
        step("Verify: bitwise NOT")
        expect((~0)).to_equal(-1)


# ============================================================================
# Test Group 7: Comparison Operators
# ============================================================================

describe "Comparison Operators":
    # ## <, >, <=, >=, ==, !=
    #
    # Tests comparison operations.

    it "less than":
        step("Verify: less than")
        expect(1).to_be_less_than(2)

    it "greater than":
        step("Verify: greater than")
        expect(2).to_be_greater_than(1)

    it "less than or equal":
        step("Verify: less than or equal")
        assert_true(2 <= 2)

    it "greater than or equal":
        step("Verify: greater than or equal")
        assert_true(2 >= 2)

    it "equal":
        step("Verify: equal")
        expect(2).to_equal(2)

    it "not equal":
        step("Verify: not equal")
        assert_true(2 != 3)


# ============================================================================
# Test Group 8: Logical Operators
# ============================================================================

describe "Logical Operators":
    # ## and, or, not
    #
    # Tests logical operations.

    it "and operator":
        step("Verify: and operator")
        assert_true(true and true)
        expect not (true and false)

    it "or operator":
        step("Verify: or operator")
        assert_true(true or false)
        expect not (false or false)

    it "not operator":
        step("Verify: not operator")
        assert_true(not false)
        expect not (not true)


# ============================================================================
# Test Group 9: Power Operator
# ============================================================================

describe "Power Operator":
    # ## ** Exponentiation
    #
    # Tests power operator.

    it "power of zero":
        step("Verify: power of zero")
        expect((2 ** 0)).to_equal(1)

    it "power of one":
        step("Verify: power of one")
        expect((2 ** 1)).to_equal(2)

    it "power of three":
        step("Verify: power of three")
        expect((2 ** 3)).to_equal(8)

    it "power of ten":
        step("Verify: power of ten")
        expect((2 ** 10)).to_equal(1024)

    it "three to fourth":
        step("Verify: three to fourth")
        expect((3 ** 4)).to_equal(81)


# ============================================================================
# Test Group 10: Floor Division
# ============================================================================

describe "Floor Division":
    # ## .fdiv() Method
    #
    # Tests floor division method (// operator is now for parallel execution).

    it "positive floor division":
        step("Verify: positive floor division")
        expect(7.fdiv(2)).to_equal(3)

    it "another floor division":
        step("Verify: another floor division")
        expect(10.fdiv(3)).to_equal(3)

    it "negative floor division":
        step("Verify: negative floor division")
        expect((-7).fdiv(2)).to_equal(-4)  # rounds toward negative infinity

    it "exact division":
        step("Verify: exact division")
        expect(8.fdiv(4)).to_equal(2)


# ============================================================================
# Test Group 11: In Operator
# ============================================================================

describe "In Operator":
    # ## x in collection
    #
    # Tests membership operator.

    it "in array present":
        step("Verify: in array present")
        assert_true(2 in [1, 2, 3])

    it "in array absent":
        step("Verify: in array absent")
        expect not (5 in [1, 2, 3])

    it "in string present":
        step("Verify: in string present")
        assert_true("ell" in "hello")

    it "in string absent":
        step("Verify: in string absent")
        expect not ("xyz" in "hello")


# ============================================================================
# Test Group 12: Recursive Functions
# ============================================================================

describe "Recursive Functions":
    # ## Function Recursion
    #
    # Tests recursive function calls.

    it "factorial":
        step("Verify: factorial")
        fn factorial(n: i64) -> i64:
            if n <= 1:
                1
            else:
                n * factorial(n - 1)

        expect(factorial(3)).to_equal(6)


# ============================================================================
# Test Group 13: Nested Data Structures
# ============================================================================

describe "Nested Data Structures":
    # ## Nested Arrays and Structs
    #
    # Tests nested data access.

    it "nested arrays":
        step("Verify: nested arrays")
        val arr = [[1, 2], [3, 4], [5, 6]]
        expect(arr[0][0] + arr[1][1] + arr[2][0]).to_equal(10)

    it "nested structs":
        step("Verify: nested structs")
        struct Inner:
            value: i64

        struct Outer:
            inner: Inner

        val o = Outer(inner: Inner(value: 42))
        expect(o.inner.value).to_equal(42)


# ============================================================================
# Test Group 14: Early Return
# ============================================================================

describe "Early Return":
    # ## Multiple Return Paths
    #
    # Tests functions with multiple returns.

    it "early return based on condition":
        step("Verify: early return based on condition")
        fn verify(x: i64) -> i64:
            if x > 10:
                return 1
            if x > 5:
                return 2
            3

        expect(verify(7)).to_equal(2)


# ============================================================================
# Test Group 15: Tuple Destructuring
# ============================================================================

describe "Tuple Destructuring":
    # ## Multiple Assignment
    #
    # Tests tuple unpacking.

    it "destructures tuple":
        step("Verify: destructures tuple")
        val _tuple = (1, 2, 3)
        val a = _tuple[0]
        val b = _tuple[1]
        val c = _tuple[2]
        expect(a + b + c).to_equal(6)


# ============================================================================
# Test Group 16: Symbols
# ============================================================================

describe "Symbols":
    # ## :symbol Syntax
    #
    # Tests symbol literals.

    it "symbol comparison":
        step("Verify: symbol comparison")
        val s = :hello
        expect(s).to_equal(:hello)

