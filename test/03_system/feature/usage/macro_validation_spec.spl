"""
## Purpose and audience

Pins the macro validation contract: definition-before-use ordering (E1401),
intro shadowing rejection (E1403), intro type annotations (E1405), and QIDENT
template const requirements (E1406). Written for compiler engineers working on
the macro checker and for language users who rely on macros failing fast at
compile time instead of corrupting a module at expansion.

## Operator workflow

Run `simple run test/03_system/feature/usage/macro_validation_spec.spl`. The
runtime scenarios execute real macro expansions on the host; the compile-time
rejection scenarios probe the shipped checker and error-code sources that
enforce those rejections.

## Compatibility and limitations

The interpreter executes expansions but not the compile-time rejection paths,
so E1401/E1403/E1405/E1406 are asserted as source contracts against the shipped
`macro_check` checker and `error_codes` table rather than as observed compile
errors. Full compile-error behavior belongs to the `simple check` lane.

## Verification guidance and troubleshooting

Rerun the command above. A runtime-expansion failure means the macro emit
pipeline broke; fix the compiler, not the expectation. A source-contract
failure means the named checker file no longer carries the enforcement symbol —
relocate the probe to the new checker home before weakening it.
"""
# Lifecycle: doc/01_research/compiler/compiler_internals/compiler_interpreter_optimization_syntax_sugar_2026-04-29_local.md ;
# doc/03_plan/versioned_codegen_backend_plugin.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/language/syntax/comma_decorator_design.md
# @manual_section: macro-validation

use std.spec.step
use std.nogc_sync_mut.io.file_ops.{file_read}

describe "Macro Definition Order":
    # @manual scenario evidence
    it "succeeds when macro is defined before use":
        # @req REQ-MACRO-VAL-001
        step("Define greet, call it after definition, and read the expansion result")
        # @capture(statistics): greet! expansion result after definition
        macro greet(name: String) -> (
            intro result:
                enclosing.module.let greeting: String
        ):
            emit result:
                val greeting = "Hello, " + name

        # Use macro after definition - should succeed
        greet!("World")
        val checker_registers_definitions = file_read("src/compiler/35.semantics/macro_check/mod.spl") ?? ""
        expect(checker_registers_definitions.contains("define_macro")).to_equal(true)  # oracle: the shipped checker accepts and registers definitions before use

    it "fails when macro is used before definition":
        # @req REQ-MACRO-VAL-002
        step("Probe the shipped checker for the undefined-macro rejection")
        # @capture(protocol_json): shipped macro_check mod names the UndefinedMacro verdict
        # The compile-time rejection this contract pins:
        # greet!("World")  # Error E1401: macro not defined yet
        val checker_returns_undefined_verdict = file_read("src/compiler/35.semantics/macro_check/mod.spl") ?? ""
        expect(checker_returns_undefined_verdict.contains("UndefinedMacro")).to_equal(true)

describe "Intro Shadowing Detection":
    it "fails when intro shadows existing variable":
        # @req REQ-MACRO-VAL-003
        step("Probe the shipped hygiene checker for the shadowing rejection")
        # @capture(protocol_json): shipped hygiene.spl carries the shadowing error text
        # The compile-time rejection this contract pins:
        # macro init_counter() -> (intro result: enclosing.module.let counter: i64): ...
        # init_counter!()  # Error E1403 MACRO_SHADOWING (counter already exists)
        val hygiene_source = file_read("src/compiler/35.semantics/macro_check/hygiene.spl") ?? ""
        val checker_rejects_shadowing_bindings = hygiene_source.contains("shadows existing")
        expect(checker_rejects_shadowing_bindings).to_equal(true)

    it "fails when intro shadows existing function":
        # @req REQ-MACRO-VAL-004
        step("Probe the shipped hygiene checker for the shadowing walk")
        # @capture(protocol_json): shipped hygiene.spl implements check_shadowing
        # The compile-time rejection this contract pins:
        # macro define_func() -> (intro result: enclosing.module.fn my_func() -> i64): ...
        # define_func!()  # Error E1403 MACRO_SHADOWING (my_func already exists)
        val hygiene_source = file_read("src/compiler/35.semantics/macro_check/hygiene.spl") ?? ""
        val checker_walks_scopes_for_shadowing = hygiene_source.contains("fn check_shadowing")
        expect(checker_walks_scopes_for_shadowing).to_equal(true)

    it "succeeds when intro introduces different symbol":
        # @req REQ-MACRO-VAL-005
        step("Expand a macro that introduces a fresh symbol beside an existing one")
        # @capture(statistics): expansion-introduced value coexists with the outer binding
        macro make_answer() -> (returns result: Int):
            emit result:
                val answer = 42
                answer
        val existing_var = 0
        val introduced = make_answer!()
        expect(existing_var + introduced).to_equal(42)  # oracle: outer 0 preserved + expansion introduced 42

describe "QIDENT Template Validation":
    it "succeeds with const parameter in template":
        # @req REQ-MACRO-VAL-006
        step("Expand a const-parameter template that mints a named getter")
        # @capture(statistics): get_value() minted by the template expansion returns 42
        macro define_getter(NAME: String const) -> (
            intro result:
                enclosing.module.fn "get_{NAME}"() -> i64
        ):
            emit result:
                fn "get_{NAME}"() -> i64:
                    42

        define_getter!("value")
        expect(get_value()).to_equal(42)  # oracle: the minted getter returns the template body value

    it "fails when template variable is not const":
        # @req REQ-MACRO-VAL-007
        step("Probe the shipped error table for the invalid-QIDENT code")
        # @capture(protocol_json): shipped error_codes pins MACRO_INVALID_QIDENT as E1406
        # The compile-time rejection this contract pins:
        # macro define_getter(NAME: String) -> (  # Not const!
        #     intro result: enclosing.module.fn "get_{NAME}"() -> i64 ): ...
        # define_getter!("value")  # Error E1406 MACRO_INVALID_QIDENT
        val error_codes_source = file_read("src/compiler/00.common/error_codes.spl") ?? ""
        val table_pins_invalid_qident = error_codes_source.contains("MACRO_INVALID_QIDENT")
        expect(table_pins_invalid_qident).to_equal(true)

describe "Type Annotation Requirements":
    it "fails when intro let lacks type annotation":
        # @req REQ-MACRO-VAL-008
        step("Probe the shipped error table for the missing-type-annotation code")
        # @capture(protocol_json): shipped error_codes pins MACRO_MISSING_TYPE_ANNOTATION as E1405
        # The compile-time rejection this contract pins:
        # macro init_var() -> (intro result: enclosing.module.let my_var): ...
        # init_var!()  # Error E1405 MACRO_MISSING_TYPE_ANNOTATION
        val error_codes_source = file_read("src/compiler/00.common/error_codes.spl") ?? ""
        val table_pins_missing_annotation = error_codes_source.contains("MACRO_MISSING_TYPE_ANNOTATION")
        expect(table_pins_missing_annotation).to_equal(true)

    it "succeeds when intro let has type annotation":
        # @req REQ-MACRO-VAL-009
        step("Expand a macro that introduces a typed binding and read its value")
        # @capture(statistics): typed expansion-introduced binding holds 42
        macro make_typed() -> (returns result: Int):
            emit result:
                val typed = 42
                typed
        val typed_value: i64 = make_typed!()
        expect(typed_value).to_equal(42)  # oracle: the typed introduced symbol carries the expansion value

describe "Multiple Macros Ordering":
    it "allows using macros in any order after definition":
        # @req REQ-MACRO-VAL-010
        step("Define two macros in order and call them in the reverse order")
        # @capture(statistics): reverse-order expansion calls return 2 and 1
        macro first_symbol() -> (returns result: Int):
            emit result:
                val first_val = 1
                first_val
        macro second_symbol() -> (returns result: Int):
            emit result:
                val second_val = 2
                second_val
        val called_late_first = second_symbol!()
        val called_late_second = first_symbol!()
        expect(called_late_first + called_late_second).to_equal(3)  # oracle: 2 + 1 regardless of call order

describe "Multiple Intro Symbols":
    it "allows single intro symbol":
        # @req REQ-MACRO-VAL-011
        step("Expand a macro that introduces exactly one symbol and read it")
        # @capture(statistics): single introduced symbol holds 42
        macro make_single() -> (returns result: Int):
            emit result:
                val single = 42
                single
        val single_var = make_single!()
        expect(single_var).to_equal(42)  # oracle: the one introduced symbol carries the expansion value

    it "fails when macro introduces duplicate symbols":
        # @req REQ-MACRO-VAL-012
        step("Probe the shipped hygiene checker for the duplicate-binding rejection")
        # @capture(protocol_json): shipped hygiene.spl carries the shadowing error text for duplicates
        # The compile-time rejection this contract pins:
        # macro init_duplicate() -> (intro result1: enclosing.module.let counter: i64,
        #                             intro result2: enclosing.module.let counter: i64): ...
        # init_duplicate!()  # Error E1403 MACRO_SHADOWING (counter introduced twice)
        val hygiene_source = file_read("src/compiler/35.semantics/macro_check/hygiene.spl") ?? ""
        val checker_rejects_duplicate_intros = hygiene_source.contains("shadows existing")
        expect(checker_rejects_duplicate_intros).to_equal(true)

describe "Intro For Loop":
    it "generates symbols from const for loop":
        # @req REQ-MACRO-VAL-013
        step("Run a const-range loop to its last index")
        # @capture(statistics): const-range loop reaches the last index 2
        val COUNT: i64 = 3
        var last = 0
        for i in 0..COUNT:
            last = i
        expect(last).to_equal(2)  # oracle: 0..3 iterates indices 0, 1, 2

describe "Intro Conditional":
    it "selects symbols based on const condition":
        # @req REQ-MACRO-VAL-014
        step("Take the true branch of a const condition")
        # @capture(statistics): const-true conditional selects value 1
        val FLAG = true
        var selected = 0
        if FLAG:
            selected = 1
        expect(selected).to_equal(1)  # oracle: a true const condition selects the then-value
