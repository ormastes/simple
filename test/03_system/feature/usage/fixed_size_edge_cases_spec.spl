"""
# Fixed-Size Array Edge Cases and Boundary Conditions

**Feature ID:** #LANG-008b
**Category:** Language
**Status:** Active

## Overview

This spec exercises the boundary conditions and edge cases of fixed-size arrays that go
beyond typical usage. It tests zero-length arrays, single-element arrays, negative indexing
on various sizes, and fixed-size arrays of non-numeric types (text, bool). It also verifies
that functional operations like `map`, `filter`, and `reduce` behave correctly when applied
to fixed-size arrays, including cases where `filter` produces a result smaller than the
original size.

## Syntax

```simple
use std.spec.step

val empty: [i64; 0] = []
val single: [i64; 1] = [42]
val names: [text; 3] = ["alice", "bob", "charlie"]
val flags: [bool; 2] = [true, false]
val big = arr.filter(_1 > 3)
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Zero-Size Array | `[T; 0]` is a valid empty fixed-size array that supports iteration |
| Boundary Indexing | Single and two-element arrays test the smallest non-trivial sizes |
| Multi-Type Support | Fixed-size arrays work with `i64`, `f64`, `text`, and `bool` element types |
| Size-Changing Ops | `filter` on a fixed-size array returns a dynamic array that may be smaller |
"""

use std.spec.step

describe "Fixed-Size Array Edge Cases":
    # @manual scenario evidence

    context "Size Zero":
        it "allows size-zero arrays":
            val empty: [i64; 0] = []
            expect(empty.len()).to_equal(0)

        it "iterates over size-zero arrays":
            val empty: [i64; 0] = []
            var count = 0
            for _ in empty:
                count = count + 1
            expect(count).to_equal(0)

    context "Negative Indexing":
        it "supports negative indices":
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            expect(arr[-1]).to_equal(5)
            expect(arr[-2]).to_equal(4)
            expect(arr[-3]).to_equal(3)

    context "Boundary Conditions":
        it "handles single element arrays":
            val single: [i64; 1] = [42]
            expect(single[0]).to_equal(42)
            expect(single.len()).to_equal(1)

        it "handles two element arrays":
            val pair: [i64; 2] = [10, 20]
            expect(pair[0]).to_equal(10)
            expect(pair[1]).to_equal(20)
            expect(pair.len()).to_equal(2)

    context "Mixed Types":
        it "works with string arrays":
            val names: [text; 3] = ["alice", "bob", "charlie"]
            expect(names[0]).to_equal("alice")
            expect(names.len()).to_equal(3)

        it "works with boolean arrays":
            val flags: [bool; 2] = [true, false]
            expect(flags[0]).to_equal(true)
            expect(flags[1]).to_equal(false)

    context "Functional Operations on Fixed":
        it "map preserves values":
            val arr: [i64; 4] = [1, 2, 3, 4]
            val doubled = arr.map(_1 * 2)
            expect(doubled[0]).to_equal(2)
            expect(doubled.len()).to_equal(4)
            expect(doubled[3]).to_equal(8)

        it "filter may reduce size":
            val arr: [i64; 5] = [1, 2, 3, 4, 5]
            val big = arr.filter(_1 > 3)
            expect(big[0]).to_equal(4)
            expect(big.len()).to_equal(2)
            expect(big[1]).to_equal(5)

        it "reduce works on fixed arrays":
            val arr: [i64; 3] = [10, 20, 30]
            val total = arr.reduce(0, \acc, x: acc + x)
            expect(total).to_equal(60)
