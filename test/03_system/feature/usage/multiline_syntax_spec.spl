# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Multi-line Syntax Specification


**Feature ID:** #MULTI-001
**Category:** Language | Syntax
**Status:** Implemented

## Overview

Tests for multi-line syntax patterns including function calls spanning
multiple lines, array literals, and continuation lines.

## Syntax

```simple
# Multi-line function call
use std.spec.step

val result = function_name(
arg1,
arg2,
arg3
)

# Multi-line array
val items = [
1,
2,
3
]

# Line continuation with backslash
val sum = 1 + 2 + \
3 + 4
```
"""



# ============================================================================
# Multi-line Function Calls
# ============================================================================

describe "Multi-line Function Calls":
    # @manual scenario evidence
    # ## Function Calls Spanning Multiple Lines
    #
    # Tests for calling functions with arguments on separate lines.

    context "basic multi-line calls":
        it "calls function with arguments on multiple lines":
            # @req REQ-SSPEC-SYSTEM
            step("calls function with arguments on multiple lines")
            fn add(a, b):
                return a + b

            val result = add(
                1,
                2
            )
            expect(result).to_equal(3)

        it "calls function with named arguments on multiple lines":
            # @req REQ-SSPEC-SYSTEM
            step("calls function with named arguments on multiple lines")
            fn greet(name, msg):
                return 42

            val result = greet(
                name: "test",
                msg: "hello"
            )
            expect(result).to_equal(42)

    context "nested function calls":
        it "nests function calls on single line":
            # @req REQ-SSPEC-SYSTEM
            step("nests function calls on single line")
            fn inner(x):
                return x * 2

            fn outer(a, b):
                return a + b

            expect(outer(inner(5), inner(3))).to_equal(16)

        it "nests function calls on multiple lines":
            # @req REQ-SSPEC-SYSTEM
            step("nests function calls on multiple lines")
            fn inner(x):
                return x * 2

            fn outer(a, b):
                return a + b

            val result = outer(
                inner(5),
                inner(3)
            )
            expect(result).to_equal(16)


# ============================================================================
# Multi-line Arrays and Structs
# ============================================================================

describe "Multi-line Literals":
    # ## Array and Struct Literals Spanning Lines
    #
    # Tests for multi-line array and struct initialization.

    it "creates multi-line array literal":
        # @req REQ-SSPEC-SYSTEM
        step("creates multi-line array literal")
        val arr = [
            1,
            2,
            3
        ]
        expect(arr[0] + arr[1] + arr[2]).to_equal(6)

    it "creates multi-line struct initialization":
        # @req REQ-SSPEC-SYSTEM
        step("creates multi-line struct initialization")
        struct Config:
            name: str
            value: i64

        fn Config_new(name, value):
            return Config { name: name, value: value }

        val c = Config_new(
            "test",
            42
        )
        expect(c.value).to_equal(42)


# ============================================================================
# Continuation Lines
# ============================================================================

describe "Continuation Lines":
    # ## Line Continuation with Implicit Join
    #
    # Tests for implicit line continuation inside brackets/parens.

    it "continues function call to next line":
        # @req REQ-SSPEC-SYSTEM
        step("continues function call to next line")
        fn match_exception(a, b, c):
            return 42

        val result = match_exception("ValueError", "some message",
                           "expected")
        expect(result).to_equal(42)

    it "continues call at same indent level":
        # @req REQ-SSPEC-SYSTEM
        step("continues call at same indent level")
        fn match_exception(a, b, c):
            return 42

        val result = match_exception("ValueError", "some message",
"expected")
        expect(result).to_equal(42)


# ============================================================================
# Tuple Destructuring
# ============================================================================

describe "Tuple Destructuring in Assignments":
    # ## Multi-line Tuple Patterns
    #
    # Tests for tuple destructuring assignments.

    it "destructures tuple from array element":
        # @req REQ-SSPEC-SYSTEM
        step("destructures tuple from array element")
        val arr = [(10, 20)]
        val _pair = arr[0]
        val a = _pair[0]
        val b = _pair[1]
        expect(a + b).to_equal(30)

    it "accesses tuple elements with dot notation":
        # @req REQ-SSPEC-SYSTEM
        step("accesses tuple elements with dot notation")
        val arr = [(10, 20)]
        expect(arr[0].0 + arr[0].1).to_equal(30)

    it "destructures nested tuple data":
        # @req REQ-SSPEC-SYSTEM
        step("destructures nested tuple data")
        val docstrings = [("content", 1), ("other", 2)]
        val _pair = docstrings[0]
        val content = _pair[0]
        val line = _pair[1]
        expect(line).to_equal(1)
