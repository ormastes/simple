"""
# Negative Slice Step Is Not Supported

**Feature IDs:** #RANGE-STEP-NEGATIVE-ERROR
**Category:** Syntax
**Status:** Implemented

## Overview

Negative slice **step** (Python-style `s[::-1]`, `s[9:0:-1]`) is
deliberately **not** part of the language. Reversal is always the explicit
`.reversed()` method call, never an index trick -- this repo follows
Ruby's model, not Python's. Negative slice **indices** (Ruby-style, count
from the end, e.g. `s[-3:]`, `s[0:-1]`) remain a completely different,
fully-supported feature and are unaffected by this decision.

## Design

**ADR:** doc/04_architecture/language/slicing/+adr/negative_step_not_supported_2026-07-30.md

## Syntax

```simple
s[9:0:-1]   # errors: use .reversed()
s[::-1]     # errors: use .reversed()
s.reversed() # correct way to reverse
s[-3:]      # still legal -- negative INDEX, not step
```

## Traceability Expectations

- Every negative-step slice form (bare `[::-1]`, bounded `[9:0:-1]`,
  step -1 and other negative steps, negative step combined with negative
  indices) must produce a real, non-zero-exit, diagnosable error naming
  `.reversed()` under BOTH the default (JIT/native) engine and the
  interpreter -- a divergence where one engine errors and the other
  silently returns something is treated as a bug, not an acceptable gap.
- Negative-index-only slices (no step, or step omitted) must keep working
  identically to before this change under both engines.
"""

use std.spec.*
use app.io.mod.{env_get, process_run}

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BIN") ?? ""
    if configured.len() > 0:
        return configured
    "bin/simple"

fn fixture(path: text) -> text:
    "test/fixtures/negative_step_slice/" + path

# Runs a fixture under the DEFAULT (JIT/native) engine via `simple run`.
# Negative step aborts the process (SIGABRT via the native runtime's
# established `rt_panic`-style abort idiom, exit code 134 on Linux) --
# still a real, non-zero, diagnosable failure with the error message on
# stderr before the abort, which is what this asserts.
fn run_default(path: text) -> (text, i64):
    val (stdout, stderr, code) = process_run(simple_binary(), ["run", fixture(path)])
    (stdout + stderr, code)

# Runs the same fixture under the interpreter, which raises a clean
# `CompileError` (exit code 1) instead of aborting. `process_run` has no
# env-var parameter, so the env var is set via a shell wrapper, matching
# the established idiom in
# test/03_system/feature/usage/concurrency_api_misuse_spec.spl's
# `run_profile_contract`.
fn run_interpreted(path: text) -> (text, i64):
    val command = "SIMPLE_EXECUTION_MODE=interpret " + simple_binary() + " run " + fixture(path)
    val (stdout, stderr, code) = process_run("/bin/sh", ["-c", command])
    (stdout + stderr, code)

fn expect_negative_step_error(path: text):
    step("Run under the default (JIT/native) engine")
    val (default_output, default_code) = run_default(path)
    expect(default_code).to_be_greater_than(0)
    expect(default_output).to_contain("negative slice step is not supported")
    expect(default_output).to_contain(".reversed()")

    step("Run under the interpreter")
    val (interp_output, interp_code) = run_interpreted(path)
    expect(interp_code).to_be_greater_than(0)
    expect(interp_output).to_contain("negative slice step is not supported")
    expect(interp_output).to_contain(".reversed()")

fn expect_no_error(path: text, expected_stdout: text):
    step("Run under the default (JIT/native) engine -- must still succeed")
    val (default_output, default_code) = run_default(path)
    expect(default_code).to_equal(0)
    expect(default_output).to_contain(expected_stdout)

    step("Run under the interpreter -- must still succeed")
    val (interp_output, interp_code) = run_interpreted(path)
    expect(interp_code).to_equal(0)
    expect(interp_output).to_contain(expected_stdout)

describe "Negative slice step is a hard error in both engines":
    it "errors on bare negative step s[::-1]":
        expect_negative_step_error("bare_reverse.spl")

    it "errors on bounded negative step s[9:0:-1]":
        expect_negative_step_error("bounded_reverse.spl")

    it "errors on step -1 via s[::-1] on a string":
        expect_negative_step_error("string_bare_reverse.spl")

    it "errors on step other than -1 (e.g. s[::-2])":
        expect_negative_step_error("step_negative_two.spl")

    it "errors when negative step is combined with negative indices":
        # The most confusable case: negative INDICES remain legal
        # (`s[-1:-5:...]` alone would be fine), but the STEP of -1 here
        # must still be rejected.
        expect_negative_step_error("negative_index_and_negative_step.spl")

    it "keeps negative-index-only slices (no negative step) working":
        expect_no_error("negative_index_only.spl", "OK:789:012345678:World")

describe "Negative index specs still pass unmodified (regression guard)":
    it "runs the existing negative-index coverage end to end":
        step("Confirm advanced_indexing_spec.spl's negative-index cases were not touched by this change")
        val (source, _stderr, code) = process_run("/bin/sh", ["-c", "cat test/03_system/feature/usage/advanced_indexing_spec.spl"])
        expect(code).to_equal(0)
        expect(source).to_contain("arr[-3:]")
        expect(source).to_contain("arr[:-2]")
        expect(source).to_contain("arr[-4:-1]")
        expect(source).to_contain("s[-5:-1]")
