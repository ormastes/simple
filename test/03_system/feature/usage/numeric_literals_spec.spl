# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Numeric Literals Specification

**Feature ID:** #NUM-001
**Category:** Language | Literals
**Status:** Implemented

## Overview

Tests for various numeric literal formats including hexadecimal, binary,
octal, and numeric separators with underscores.

## Syntax

```simple
use std.spec.step

val hex = 0xFF         # Hexadecimal (255)
val bin = 0b1010       # Binary (10)
val oct = 0o755        # Octal (493)
val sep = 1_000_000    # Underscores for readability
```
"""



# ============================================================================
# Test Group 1: Hexadecimal Literals
# ============================================================================

describe "Hexadecimal Literals":
    # @manual scenario evidence
    # ## Hex Numeric Literals
    #
    # Tests for hexadecimal numeric literals using 0x prefix.

    it "parses basic hex literal":
        # @req REQ-SSPEC-SYSTEM
        step("parses basic hex literal")
        val x = 0xFF
        expect(x).to_equal(255)

    it "parses lowercase hex":
        # @req REQ-SSPEC-SYSTEM
        step("parses lowercase hex")
        val x = 0xff
        expect(x).to_equal(255)

    it "parses mixed case hex":
        # @req REQ-SSPEC-SYSTEM
        step("parses mixed case hex")
        val x = 0xAb
        expect(x).to_equal(171)

    it "performs hex arithmetic":
        # @req REQ-SSPEC-SYSTEM
        step("performs hex arithmetic")
        val x = 0x10 + 0x20
        expect(x).to_equal(48  # 16 + 32)

    it "compares hex and decimal":
        # @req REQ-SSPEC-SYSTEM
        step("compares hex and decimal")
        expect 0x10 == 16
        expect 0x100 == 256


# ============================================================================
# Test Group 2: Binary Literals
# ============================================================================

describe "Binary Literals":
    # ## Binary Numeric Literals
    #
    # Tests for binary numeric literals using 0b prefix.

    it "parses basic binary literal":
        # @req REQ-SSPEC-SYSTEM
        step("parses basic binary literal")
        val x = 0b1010
        expect(x).to_equal(10)

    it "parses binary with underscores":
        # @req REQ-SSPEC-SYSTEM
        step("parses binary with underscores")
        val x = 0b1111_0000
        expect(x).to_equal(240)

    it "performs binary arithmetic":
        # @req REQ-SSPEC-SYSTEM
        step("performs binary arithmetic")
        val x = 0b1000 + 0b0100
        expect(x).to_equal(12  # 8 + 4)

    it "uses binary for bit patterns":
        # @req REQ-SSPEC-SYSTEM
        step("uses binary for bit patterns")
        val flags = 0b0101
        expect(flags).to_equal(5)


# ============================================================================
# Test Group 3: Octal Literals
# ============================================================================

describe "Octal Literals":
    # ## Octal Numeric Literals
    #
    # Tests for octal numeric literals using 0o prefix.

    it "parses basic octal literal":
        # @req REQ-SSPEC-SYSTEM
        step("parses basic octal literal")
        val x = 0o755
        expect(x).to_equal(493  # 7*64 + 5*8 + 5)

    it "parses small octal":
        # @req REQ-SSPEC-SYSTEM
        step("parses small octal")
        val x = 0o10
        expect(x).to_equal(8)

    it "performs octal arithmetic":
        # @req REQ-SSPEC-SYSTEM
        step("performs octal arithmetic")
        val x = 0o10 + 0o10
        expect(x).to_equal(16  # 8 + 8)


# ============================================================================
# Test Group 4: Numeric Separators
# ============================================================================

describe "Numeric Separators":
    # ## Underscore Separators
    #
    # Tests for using underscores as separators in numeric literals.

    it "parses decimal with separators":
        # @req REQ-SSPEC-SYSTEM
        step("parses decimal with separators")
        val x = 1_000_000
        expect(x).to_equal(1000000)

    it "parses hex with separators":
        # @req REQ-SSPEC-SYSTEM
        step("parses hex with separators")
        val x = 0xFF_FF
        expect(x).to_equal(65535)

    it "parses binary with separators":
        # @req REQ-SSPEC-SYSTEM
        step("parses binary with separators")
        val x = 0b1010_1010
        expect(x).to_equal(170)

    it "allows multiple underscores":
        # @req REQ-SSPEC-SYSTEM
        step("allows multiple underscores")
        val x = 100__000
        expect(x).to_equal(100000)

