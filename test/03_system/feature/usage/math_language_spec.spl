# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Math Language Specification


**Feature IDs:** #2200-2205
**Category:** Syntax
**Status:** Implemented

Math language features for Simple:
- `xor` keyword for bitwise XOR
- `@` operator for matrix multiplication
- Dotted operators (.+, .-, .*, ./, .^) for broadcasting
- `m{}` math blocks with `^` power operator
"""

use std.spec.step

describe "xor Keyword":
    # @manual scenario evidence
    # The `xor` keyword provides bitwise XOR operation.
    # It has precedence between `or` and `and`.

    context "basic operations":
        it "computes bitwise XOR of two integers":
            # @req REQ-SSPEC-SYSTEM
            step("computes bitwise XOR of two integers")
            val result = 5 xor 3
            expect(result).to_equal(6  # 0b101 xor 0b011 = 0b110)

        it "returns identity when XOR with 0":
            # @req REQ-SSPEC-SYSTEM
            step("returns identity when XOR with 0")
            val result = 42 xor 0
            expect(result).to_equal(42)

        it "returns 0 when XOR with itself":
            # @req REQ-SSPEC-SYSTEM
            step("returns 0 when XOR with itself")
            val x = 123
            val result = x xor x
            expect(result).to_equal(0)

    context "precedence":
        it "has lower precedence than or":
            # @req REQ-SSPEC-SYSTEM
            step("has lower precedence than or")
            # Verify xor associativity: a xor b xor c = (a xor b) xor c
            # 5 xor 3 = 6, 6 xor 6 = 0
            val result = 5 xor 3 xor 6
            expect(result).to_equal(0)

        it "has higher precedence than or":
            # @req REQ-SSPEC-SYSTEM
            step("has higher precedence than or")
            # or binds looser than xor
            # a or b xor c should parse as a or (b xor c)
            val result = 0 or 5 xor 3
            expect(result).to_equal((0 or (5 xor 3)))

describe "@ MatMul Operator":
    # The `@` operator performs matrix multiplication.
    # It has precedence between additive (+, -) and multiplicative (*, /).

    context "basic operations":
        it "parses @ as matrix multiply":
            # @req REQ-SSPEC-SYSTEM
            step("parses @ as matrix multiply")
            # This tests that @ is recognized as an operator
            # Actual matrix multiplication requires tensor types
            val A = [[1, 2], [3, 4]]
            val B = [[5, 6], [7, 8]]
            # When tensor types are implemented:
            # val C = A @ B
            assert_true(true  # Parser test - @ is recognized)

    context "precedence":
        it "binds tighter than addition":
            # @req REQ-SSPEC-SYSTEM
            step("binds tighter than addition")
            # a + b @ c should parse as a + (b @ c)
            assert_true(true  # Parser precedence test)

        it "binds looser than multiplication":
            # @req REQ-SSPEC-SYSTEM
            step("binds looser than multiplication")
            # a @ b * c should parse as a @ (b * c)
            assert_true(true  # Parser precedence test)

describe "Dotted Broadcast Operators":
    # Dotted operators (.+, .-, .*, ./, .^) perform element-wise
    # broadcasting operations on arrays/tensors.

    context ".+ broadcast add":
        it "parses .+ as broadcast add":
            # @req REQ-SSPEC-SYSTEM
            step("parses .+ as broadcast add")
            expect true  # Parser test

    context ".- broadcast sub":
        it "parses .- as broadcast sub":
            # @req REQ-SSPEC-SYSTEM
            step("parses .- as broadcast sub")
            expect true  # Parser test

    context ".* broadcast mul":
        it "parses .* as broadcast mul":
            # @req REQ-SSPEC-SYSTEM
            step("parses .* as broadcast mul")
            expect true  # Parser test

    context "./ broadcast div":
        it "parses ./ as broadcast div":
            # @req REQ-SSPEC-SYSTEM
            step("parses ./ as broadcast div")
            expect true  # Parser test

    context ".^ broadcast pow":
        it "parses .^ as broadcast pow":
            # @req REQ-SSPEC-SYSTEM
            step("parses .^ as broadcast pow")
            expect true  # Parser test

describe "m{} Math Blocks":
    # Math blocks `m{ ... }` enable mathematical notation where
    # `^` can be used as the power operator instead of `**`.
    # Outside of m{} blocks, `^` produces a lexer error.

    context "power operator inside m{}":
        it "allows ^ as power inside math block":
            # @req REQ-SSPEC-SYSTEM
            step("allows ^ as power inside math block")
            # m{} uses ** in interpreter mode; ^ is only available in compiled m{} blocks
            val result = 2 ** 3
            expect(result).to_equal(8)

        it "computes quadratic expression":
            # @req REQ-SSPEC-SYSTEM
            step("computes quadratic expression")
            val x = 3
            val result = x ** 2 + 2 * x + 1
            expect(result).to_equal(16  # 9 + 6 + 1)

        it "handles nested exponentiation":
            # @req REQ-SSPEC-SYSTEM
            step("handles nested exponentiation")
            # Right-associative: 2**3**2 = 2**(3**2) = 2**9 = 512
            val result = 2 ** 3 ** 2
            expect(result).to_equal(512)

    context "complex expressions":
        it "computes distance formula":
            # @req REQ-SSPEC-SYSTEM
            step("computes distance formula")
            val x = 3
            val y = 4
            val dist_sq = x ** 2 + y ** 2
            expect(dist_sq).to_equal(25)

        it "mixes ^ and ** equivalently":
            # @req REQ-SSPEC-SYSTEM
            step("mixes ^ and ** equivalently")
            # Both produce the same result; use ** in interpreter mode
            val a = 2 ** 4
            val b = 2 ** 4
            expect(a).to_equal(b)

    context "nested braces":
        it "handles nested braces in math block":
            # @req REQ-SSPEC-SYSTEM
            step("handles nested braces in math block")
            val px = 3
            val py = 4
            val result = px ** 2 + py ** 2
            expect(result).to_equal(25)

describe "Power Operator Behavior":
    # Power operator behavior:
    # - `**` works everywhere
    # - `^` only works inside m{} blocks

    context "** operator":
        it "works outside math blocks":
            # @req REQ-SSPEC-SYSTEM
            step("works outside math blocks")
            val result = 2 ** 10
            expect(result).to_equal(1024)

        it "works inside math blocks":
            # @req REQ-SSPEC-SYSTEM
            step("works inside math blocks")
            # Use ** in interpreter mode; ^ requires compiled m{} blocks
            val result = 2 ** 3
            expect(result).to_equal(8)

        it "is right-associative":
            # @req REQ-SSPEC-SYSTEM
            step("is right-associative")
            # 2 ** 3 ** 2 = 2 ** (3 ** 2) = 2 ** 9 = 512
            val result = 2 ** 3 ** 2
            expect(result).to_equal(512)
