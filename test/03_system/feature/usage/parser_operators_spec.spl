use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_operators_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_operators_spec.md
# doc-path: doc/03_plan/sys_test/parser_operators_spec.md
# doc-path: doc/04_architecture/parser_operators_spec.md
# doc-path: doc/05_design/parser_operators_spec_oracles.md
# @manual: primary

"""
# Parser Operator Specification

**Feature IDs:** #PARSER-OP-001 to #PARSER-OP-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly tokenizes and parses all operators
including arithmetic, comparison, logical, bitwise, and special operators.

## Syntax

```simple
# Arithmetic: + - * / % ** //
# Comparison: < > <= >= == !=
# Logical: and or not
# Bitwise: & | ^ ~ << >>
# Pipeline: |> >> <<
# Optional: ?. ?? .?
```
"""



# ============================================================================
# Test Group 1: Arithmetic Operators
# ============================================================================

describe "Arithmetic Operator Parsing":
    # ## Basic Arithmetic
    #
    # Tests parsing of arithmetic operators with correct precedence.

    it "parses addition":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: parses addition")
        expect(2 + 3).to_equal(5)

    it "parses subtraction":
        step("Verify: parses subtraction")
        expect(5 - 3).to_equal(2)

    it "parses multiplication":
        step("Verify: parses multiplication")
        expect(3 * 4).to_equal(12)

    it "parses division":
        step("Verify: parses division")
        expect(10 / 2).to_equal(5)

    it "parses modulo":
        step("Verify: parses modulo")
        expect(10 % 3).to_equal(1)

    it "parses power":
        step("Verify: parses power")
        expect(2 ** 3).to_equal(8)

    it "parses integer division":
        step("Verify: parses integer division")
        expect(7.fdiv(2)).to_equal(3)


# ============================================================================
# Test Group 2: Comparison Operators
# ============================================================================

describe "Comparison Operator Parsing":
    # ## Relational Operators
    #
    # Tests parsing of comparison operators.

    it "parses less than":
        step("Verify: parses less than")
        expect(1).to_be_less_than(2)

    it "parses greater than":
        step("Verify: parses greater than")
        expect(2).to_be_greater_than(1)

    it "parses less than or equal":
        step("Verify: parses less than or equal")
        assert_true(2 <= 2)
        assert_true(1 <= 2)

    it "parses greater than or equal":
        step("Verify: parses greater than or equal")
        assert_true(2 >= 2)
        assert_true(3 >= 2)

    it "parses equality":
        step("Verify: parses equality")
        expect(2).to_equal(2)

    it "parses inequality":
        step("Verify: parses inequality")
        assert_true(1 != 2)


# ============================================================================
# Test Group 3: Logical Operators
# ============================================================================

describe "Logical Operator Parsing":
    # ## Boolean Logic
    #
    # Tests parsing of logical operators.

    it "parses and":
        step("Verify: parses and")
        expect((true and true)).to_equal(true)
        expect((true and false)).to_equal(false)

    it "parses or":
        step("Verify: parses or")
        expect((true or false)).to_equal(true)
        expect((false or false)).to_equal(false)

    it "parses not":
        step("Verify: parses not")
        expect((not false)).to_equal(true)
        expect((not true)).to_equal(false)

    it "parses combined logical":
        step("Verify: parses combined logical")
        expect((true and false or true)).to_equal(true)
        expect((not (true and false))).to_equal(true)


# ============================================================================
# Test Group 4: Bitwise Operators
# ============================================================================

describe "Bitwise Operator Parsing":
    # ## Bit Manipulation
    #
    # Tests parsing of bitwise operators.

    it "parses bitwise and":
        step("Verify: parses bitwise and")
        expect((0b1100 & 0b1010)).to_equal(0b1000)

    it "parses bitwise or":
        step("Verify: parses bitwise or")
        expect((0b1100 | 0b1010)).to_equal(0b1110)

    it "parses bitwise xor":
        step("Verify: parses bitwise xor")
        expect((5 xor 3)).to_equal(6)

    it "parses bitwise not":
        step("Verify: parses bitwise not")
        expect((~0)).to_equal(-1)

    it "parses left shift":
        step("Verify: parses left shift")
        expect(1 << 4).to_equal(16)

    it "parses right shift":
        step("Verify: parses right shift")
        expect(16 >> 2).to_equal(4)


# ============================================================================
# Test Group 5: Assignment Operators
# ============================================================================

describe "Assignment Operator Parsing":
    # ## Assignment and Compound Assignment
    #
    # Tests parsing of assignment operators.

    it "parses simple assignment":
        step("Verify: parses simple assignment")
        var x = 0
        x = 42
        expect(x).to_equal(42)

    it "parses add-assign":
        step("Verify: parses add-assign")
        var x = 10
        x += 5
        expect(x).to_equal(15)

    it "parses sub-assign":
        step("Verify: parses sub-assign")
        var x = 10
        x -= 3
        expect(x).to_equal(7)

    it "parses mul-assign":
        step("Verify: parses mul-assign")
        var x = 5
        x *= 2
        expect(x).to_equal(10)

    it "parses div-assign":
        step("Verify: parses div-assign")
        var x = 20
        x /= 4
        expect(x).to_equal(5)

    it "parses mod-assign":
        step("Verify: parses mod-assign")
        var x = 10
        x %= 3
        expect(x).to_equal(1)

    it "parses suspend-assign":
        step("Verify: parses suspend-assign")
        fn async_val() -> i64:
            42
        var x = 0
        x ~= async_val()
        expect(x).to_equal(42)


# ============================================================================
# Test Group 6: Pipeline Operators
# ============================================================================

describe "Pipeline Operator Parsing":
    # ## Function Composition and Piping
    #
    # Tests parsing of pipeline operators.

    it "parses pipe forward":
        step("Verify: parses pipe forward")
        fn double(x: i64) -> i64:
            x * 2
        val result = 21 |> double
        expect(result).to_equal(42)


# ============================================================================
# Test Group 7: Optional Operators
# ============================================================================

describe "Optional Operator Parsing":
    # ## Safe Navigation and Coalescing
    #
    # Tests parsing of optional chaining operators.

    it "parses optional chaining":
        step("Verify: parses optional chaining")
        val opt: Option<text> = Some("hello")
        val len = opt?.len()
        expect(len).to_equal(Some(5))

    it "parses null coalescing":
        step("Verify: parses null coalescing")
        val opt: Option<i64> = None
        val value = opt ?? 42
        expect(value).to_equal(42)

    it "parses existence check":
        step("Verify: parses existence check")
        val opt = Some(42)
        assert_true(opt.?)

    it "parses negated existence":
        step("Verify: parses negated existence")
        val opt: Option<i64> = None
        assert_true(not opt.?)

    it "parses try operator":
        step("Verify: parses try operator")
        fn may_fail() -> Result<i64, text>:
            Ok(42)
        fn use_result() -> Result<i64, text>:
            val x = may_fail()?
            Ok(x * 2)
        expect(use_result().unwrap()).to_equal(84)


# ============================================================================
# Test Group 8: Range Operators
# ============================================================================

describe "Range Operator Parsing":
    # ## Range Syntax
    #
    # Tests parsing of range operators.

    it "parses exclusive range":
        step("Verify: parses exclusive range")
        var sum = 0
        for i in 0..5:
            sum = sum + i
        expect(sum).to_equal(10)

    it "parses inclusive range":
        step("Verify: parses inclusive range")
        var sum = 0
        for i in 0..=5:
            sum = sum + i
        expect(sum).to_equal(15)

    it "parses range in slice":
        step("Verify: parses range in slice")
        val arr = [0, 1, 2, 3, 4]
        val sliced = arr[1..4]
        expect(sliced.len()).to_equal(3)


# ============================================================================
# Test Group 9: Operator Precedence
# ============================================================================

describe "Operator Precedence Parsing":
    # ## Correct Precedence Handling
    #
    # Tests that operators are parsed with correct precedence.

    it "power before multiplication":
        step("Verify: power before multiplication")
        expect(2 ** 3 * 2).to_equal(16)

    it "multiplication before addition":
        step("Verify: multiplication before addition")
        expect(2 + 3 * 4).to_equal(14)

    it "comparison after arithmetic":
        step("Verify: comparison after arithmetic")
        expect((2 + 3).to_be_less_than(10) == true)

    it "logical after comparison":
        step("Verify: logical after comparison")
        expect((1).to_be_less_than(2 and 3 < 4) == true)

    it "parentheses override precedence":
        step("Verify: parentheses override precedence")
        expect((2 + 3) * 4).to_equal(20)

    it "complex expression precedence":
        step("Verify: complex expression precedence")
        expect(2 + 3 * 4 ** 2 / 8).to_equal(8)


