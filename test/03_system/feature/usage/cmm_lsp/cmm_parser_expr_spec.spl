# Test Group 17: Complex Expressions
# ============================================================================

describe "CMM Expression Parser - Complex":
    it "parses complex arithmetic with macros":
        step("parses complex arithmetic with macros through the real expression parser")
        val source = "  &total=&a*&b+&c/&d\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(Mul(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses function call result in arithmetic":
        step("parses function call result in arithmetic through the real expression parser")
        val source = "  &next=Register(PC)+4\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(Call(Register,")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses braced subexpression in range":
        step("parses braced subexpression in range through the real expression parser")
        val lbrace = "{"
        val rbrace = "}"
        val source = "  Data.dump " + lbrace + "&base" + rbrace + "--" + lbrace + "&base+0xFF" + rbrace + "\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "RangeTo(Braced(MacroRef),Braced(Add(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses comparison with hex in IF":
        step("parses comparison with hex in IF through the real expression parser")
        val source = "  IF Register(PC)==0xDEAD\n    PRINT \"found\"\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Eq(Call(Register,")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses string concat with plus":
        step("parses string concat with plus through the real expression parser")
        val source = "  &msg=\"hello\"+\" \"+\"world\"\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(Add(Str,Str),Str)")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

