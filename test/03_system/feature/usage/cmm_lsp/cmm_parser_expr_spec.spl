        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(Register,")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses CPU function":
        step("parses CPU function through the real expression parser")
        val source = "  &cpu=CPU()\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(CPU,")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses TRUE function":
        step("parses TRUE function through the real expression parser")
        val source = "  WHILE TRUE()\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "BoolTrue")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses FALSE function":
        step("parses FALSE function through the real expression parser")
        val source = "  IF FALSE()\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "BoolFalse")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses dot-path function call":
        step("parses dot-path function call through the real expression parser")
        val source = "  &upper=STRing.UPpeR(\"hello\")\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(STRing.UPpeR,")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses function with multiple arguments":
        step("parses function with multiple arguments through the real expression parser")
        val source = "  &result=FORMAT.DECIMAL(0, 10)\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(FORMAT.DECIMAL,PlainInt,PlainInt)")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses function with macro argument":
        step("parses function with macro argument through the real expression parser")
        val source = "  &len=STRing.LENgth(&name)\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(STRing.LENgth,MacroRef)")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses nested function calls":
        step("parses nested function calls through the real expression parser")
        val source = "  &x=Register(Register(PC))\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Call(Register,Call(Register,Ident))")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

# ============================================================================
# Test Group 9: Parenthesized and Braced Expressions
# ============================================================================

describe "CMM Expression Parser - Grouping":
    it "parses parenthesized expression":
        step("parses parenthesized expression through the real expression parser")
        val source = "  &x=(1+2)*3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Mul(Group(Add(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses nested parentheses":
        step("parses nested parentheses through the real expression parser")
        val source = "  &x=((1+2))\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Group(Group(Add(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses braced expression for constant conversion":
        step("parses braced expression for constant conversion through the real expression parser")
        # {expr} in CMM freezes value to a constant
        val lbrace = "{"
        val rbrace = "}"
        val source = "  Data.dump " + lbrace + "&start" + rbrace + "--" + lbrace + "&end" + rbrace + "\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "RangeTo(Braced(MacroRef),Braced(MacroRef))")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

