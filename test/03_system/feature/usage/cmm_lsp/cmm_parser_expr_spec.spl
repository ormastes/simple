# Feature CMM-EXPR: production AST assertions, with every historical scenario retained.
use std.spec
use app.cmm_lsp.cmm_parser_source.{parse_cmm_source}
use app.cmm_lsp.cmm_ast.{CmmProgram, CmmStmt, CmmExpr, CmmLiteral, CmmBinOp, CmmUnaryOp}

fn expr_spec_binary_name(op: CmmBinOp) -> text:
    match op:
        case CmmBinOp.Add: "Add"
        case CmmBinOp.Sub: "Sub"
        case CmmBinOp.Mul: "Mul"
        case CmmBinOp.Div: "Div"
        case CmmBinOp.Mod: "Mod"
        case CmmBinOp.Shl: "Shl"
        case CmmBinOp.Shr: "Shr"
        case CmmBinOp.Eq: "Eq"
        case CmmBinOp.NotEq: "NotEq"
        case CmmBinOp.Lt: "Lt"
        case CmmBinOp.Gt: "Gt"
        case CmmBinOp.LtEq: "LtEq"
        case CmmBinOp.GtEq: "GtEq"
        case CmmBinOp.BitAnd: "BitAnd"
        case CmmBinOp.BitXor: "BitXor"
        case CmmBinOp.BitOr: "BitOr"
        case CmmBinOp.LogAnd: "LogAnd"
        case CmmBinOp.LogXor: "LogXor"
        case CmmBinOp.LogOr: "LogOr"
        case CmmBinOp.RangeTo: "RangeTo"
        case CmmBinOp.RangeOffset: "RangeOffset"
        case CmmBinOp.RangeDots: "RangeDots"
        case CmmBinOp.Concat: "Concat"

fn expr_spec_unary_name(op: CmmUnaryOp) -> text:
    match op:
        case CmmUnaryOp.Neg: "Neg"
        case CmmUnaryOp.BitNot: "BitNot"
        case CmmUnaryOp.LogNot: "LogNot"

fn expr_spec_literal_name(value: CmmLiteral) -> text:
    match value:
        case CmmLiteral.HexInt(_): "HexInt"
        case CmmLiteral.BinInt(_): "BinInt"
        case CmmLiteral.DecInt(_): "DecInt"
        case CmmLiteral.Float(_): "Float"
        case CmmLiteral.PlainInt(_): "PlainInt"
        case CmmLiteral.HexMask(_): "HexMask"
        case CmmLiteral.BinMask(_): "BinMask"
        case CmmLiteral.Time(_): "Time"
        case CmmLiteral.Str(_): "Str"
        case CmmLiteral.Char(_): "Char"
        case CmmLiteral.BoolTrue: "BoolTrue"
        case CmmLiteral.BoolFalse: "BoolFalse"

fn expr_spec_shape(expr: CmmExpr) -> text:
    match expr:
        case CmmExpr.Lit(value): expr_spec_literal_name(value)
        case CmmExpr.MacroRef(_): "MacroRef"
        case CmmExpr.MacroRecRef(_): "MacroRecRef"
        case CmmExpr.FunctionCall(name, args):
            var shapes: [text] = []
            for arg in args: shapes = shapes.push(expr_spec_shape(arg))
            "Call(" + name + "," + shapes.join(",") + ")"
        case CmmExpr.Binary(op, lhs, rhs): expr_spec_binary_name(op) + "(" + expr_spec_shape(lhs) + "," + expr_spec_shape(rhs) + ")"
        case CmmExpr.Unary(op, value): expr_spec_unary_name(op) + "(" + expr_spec_shape(value) + ")"
        case CmmExpr.Address(access, value): "Address(" + access + "," + expr_spec_shape(value) + ")"
        case CmmExpr.Parenthesized(value): "Group(" + expr_spec_shape(value) + ")"
        case CmmExpr.Braced(value): "Braced(" + expr_spec_shape(value) + ")"
        case CmmExpr.Ident(_): "Ident"
        case CmmExpr.DotPath(_): "DotPath"
        case CmmExpr.FileChannel(_): "FileChannel"
        case CmmExpr.OptionFlag(_): "OptionFlag"
        case CmmExpr.MacroExpand(_, value): "MacroExpand(" + expr_spec_shape(value) + ")"
        case CmmExpr.ExprEmpty: "Empty"

fn expr_spec_program_expressions(program: CmmProgram) -> [CmmExpr]:
    var expressions: [CmmExpr] = []
    for statement in program.statements:
        match statement:
            case CmmStmt.MacroAssign(_, value, _): expressions = expressions.push(value)
            case CmmStmt.MacroRecAssign(_, value, _): expressions = expressions.push(value)
            case CmmStmt.IfElse(condition, _, _, _): expressions = expressions.push(condition)
            case CmmStmt.WhileLoop(condition, _, _): expressions = expressions.push(condition)
            case CmmStmt.Command(_, args, _):
                for arg in args: expressions = expressions.push(arg)
            case CmmStmt.PrintStmt(args, _):
                for arg in args: expressions = expressions.push(arg)
            case CmmStmt.OpenFile(channel, file, _, _):
                expressions = expressions.push(channel)
                expressions = expressions.push(file)
            case CmmStmt.WriteFile(channel, args, _):
                expressions = expressions.push(channel)
                for arg in args: expressions = expressions.push(arg)
            case CmmStmt.ReadFile(channel, _, _): expressions = expressions.push(channel)
            case _: ()
    expressions

fn expr_spec_has_shape(program: CmmProgram, expected: text) -> bool:
    for expr in expr_spec_program_expressions(program):
        if expr_spec_shape(expr).starts_with(expected): return true
    false

fn expr_spec_has_option(program: CmmProgram, expected: text) -> bool:
    for statement in program.statements:
        match statement:
            case CmmStmt.OpenFile(_, _, mode, _):
                if mode == expected: return true
            case CmmStmt.Command(_, args, _):
                for arg in args:
                    match arg:
                        case CmmExpr.OptionFlag(value):
                            if value == expected: return true
                        case _: ()
            case _: ()
    false

# ============================================================================
# Test Group 1: Arithmetic Expressions
# ============================================================================

describe "CMM Expression Parser - Arithmetic":
    it "parses addition":
        step("parses addition through the real expression parser")
        val source = "  &x=1+2\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses subtraction":
        step("parses subtraction through the real expression parser")
        val source = "  &x=10-3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Sub(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses multiplication":
        step("parses multiplication through the real expression parser")
        val source = "  &x=4*5\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Mul(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses division":
        step("parses division through the real expression parser")
        val source = "  &x=100/10\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Div(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses modulo":
        step("parses modulo through the real expression parser")
        val source = "  &x=17%5\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Mod(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses chained addition":
        step("parses chained addition through the real expression parser")
        val source = "  &x=1+2+3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(Add(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses mixed arithmetic":
        step("parses mixed arithmetic through the real expression parser")
        val source = "  &x=1+2*3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Add(PlainInt,Mul(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

