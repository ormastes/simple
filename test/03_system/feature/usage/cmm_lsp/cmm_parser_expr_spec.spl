# ============================================================================
# Test Group 6: Unary Expressions
# ============================================================================

describe "CMM Expression Parser - Unary":
    it "parses unary minus":
        step("parses unary minus through the real expression parser")
        val source = "  &x=-1\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Neg(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses bitwise NOT":
        step("parses bitwise NOT through the real expression parser")
        val source = "  &x=~0xFF\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "BitNot(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses logical NOT":
        step("parses logical NOT through the real expression parser")
        val source = "  IF !&flag\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "LogNot(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses double unary minus":
        step("Preserve the original compact nested-negation requirement with a real AST assertion")
        # Open grammar issue: cmm_prefix_range_token_unary_negation_2026_10_26.
        # The lexer currently reserves -- as RangeTo; do not turn this original
        # positive scenario into a green negative test without a grammar decision.
        val source = "  &x=--1\n"
        val program = parse_cmm_source(source)
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "Neg(Neg(PlainInt))")).to_equal(true)


