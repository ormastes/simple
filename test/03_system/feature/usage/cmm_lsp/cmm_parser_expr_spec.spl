    it "parses less-than-or-equal":
        step("parses less-than-or-equal through the real expression parser")
        val source = "  IF &i<=100.\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "LtEq(")).to_equal(true)
        expect(program.errors.len()).to_equal(0)

    it "parses greater-than-or-equal":
        step("parses greater-than-or-equal through the real expression parser")
        val source = "  IF &addr>=0x1000\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(expr_spec_has_shape(program, "GtEq(")).to_equal(true)
