# ============================================================================
# Test Group 16: Operator Precedence
# ============================================================================

describe "CMM Expression Parser - Precedence":
    it "multiplication has higher precedence than addition":
        step("multiplication has higher precedence than addition through the real expression parser")
        # 1 + 2 * 3 should parse as 1 + (2 * 3)
        val source = "  &x=1+2*3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("Add(PlainInt,Mul(PlainInt,PlainInt))")
        expect(program.errors.len()).to_equal(0)

    it "comparison has lower precedence than addition":
        step("comparison has lower precedence than addition through the real expression parser")
        # &a + 1 == &b + 2 should parse as (&a + 1) == (&b + 2)
        val source = "  IF &a+1==&b+2\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("Eq(Add(MacroRef,PlainInt),Add(MacroRef,PlainInt))")
        expect(program.errors.len()).to_equal(0)

    it "logical AND has lower precedence than comparison":
        step("logical AND has lower precedence than comparison through the real expression parser")
        # &a == 1 && &b == 2 should parse as (&a == 1) && (&b == 2)
        val source = "  IF &a==1&&(&b==2)\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("LogAnd(Eq(MacroRef,PlainInt),Group(Eq(MacroRef,PlainInt)))")
        expect(program.errors.len()).to_equal(0)

    it "logical OR has lower precedence than logical AND":
        step("logical OR has lower precedence than logical AND through the real expression parser")
        val source = "  IF &a&&(&b)||&c\n    Step\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("LogOr(LogAnd(MacroRef,Group(MacroRef)),MacroRef)")
        expect(program.errors.len()).to_equal(0)

    it "shift has higher precedence than addition":
        step("shift has higher precedence than addition through the real expression parser")
        val source = "  &x=&a<<2+1\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("Add(Shl(MacroRef,PlainInt),PlainInt)")
        expect(program.errors.len()).to_equal(0)

    it "parentheses override precedence":
        step("parentheses override precedence through the real expression parser")
        val source = "  &x=(1+2)*3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        val expressions = expr_spec_program_expressions(program)
        expect(expressions.len()).to_equal(1)
        expect(expr_spec_shape(expressions[0])).to_equal("Mul(Group(Add(PlainInt,PlainInt)),PlainInt)")
        expect(program.errors.len()).to_equal(0)

