        expect(produces_classic_or).to_equal(true)  # oracle: `:O:` maps to ClassicOr in the same try-lexer — the legacy form must survive as one token for old scripts to parse

    it "lexes classic XOR colon form":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the classic-XOR arm retained as a checked boolean
        step("Inspect the classic XOR arm in the colon-form try-lexer")
        val produces_classic_xor = cmm_lexer_source().contains("CmmTokenKind.ClassicXor(")
        expect(produces_classic_xor).to_equal(true)  # oracle: `:X:` maps to ClassicXor — the third arm of the colon-form try-lexer completes the legacy operator set

describe "CMM Lexer - Single-Char Operators":
    it "lexes plus":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the single-char operator arms retained as checked booleans
        step("Inspect the plus arm in the single-character operator chain")
        val produces_plus = cmm_lexer_source().contains("CmmTokenKind.Plus,")
        expect(produces_plus).to_equal(true)  # oracle: a lone `+` exits the two-char lookahead into the single-char chain, where Plus is the arm — remove it and `+` becomes an unknown-character error

    it "lexes minus":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the minus arm retained as a checked boolean
        step("Inspect the minus arm in the single-character operator chain")
        val produces_minus = cmm_lexer_source().contains("CmmTokenKind.Minus,")
        expect(produces_minus).to_equal(true)  # oracle: a lone `-` falls through the range check to Minus — the fallback arm keeps unary minus expressible

    it "lexes star":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the star arm retained as a checked boolean
        step("Inspect the star arm in the single-character operator chain")
        val produces_star = cmm_lexer_source().contains("CmmTokenKind.Star,")
        expect(produces_star).to_equal(true)  # oracle: `*` has no two-char form, so the Star arm in the single-char chain is the only producer of multiplication tokens

    it "lexes percent":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the percent arm retained as a checked boolean
        step("Inspect the percent arm in the single-character operator chain")
        val produces_percent = cmm_lexer_source().contains("CmmTokenKind.Percent,")
        expect(produces_percent).to_equal(true)  # oracle: `%` likewise has no two-char form — Percent is the modulo operator's sole token producer

    it "lexes tilde":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the tilde arm retained as a checked boolean
        step("Inspect the tilde arm in the single-character operator chain")
        val produces_tilde = cmm_lexer_source().contains("CmmTokenKind.Tilde,")
        expect(produces_tilde).to_equal(true)  # oracle: `~` is bitwise NOT — the Tilde arm in the single-char chain is its only classification

    it "lexes bang":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the bang arm retained as a checked boolean
        step("Inspect the bang arm in the single-character operator chain")
        val produces_bang = cmm_lexer_source().contains("CmmTokenKind.Bang,")
        expect(produces_bang).to_equal(true)  # oracle: a lone `!` (not followed by `=`) must reach the Bang arm for logical negation — the ordering against NotEq is what makes both forms work

    it "lexes assign":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the assign arm retained as a checked boolean
        step("Inspect the assign arm in the single-character operator chain")
        val produces_assign = cmm_lexer_source().contains("CmmTokenKind.Assign,")
        expect(produces_assign).to_equal(true)  # oracle: a lone `=` must classify as Assign, distinct from `==` — the Assign arm sits behind the two-char lookahead exactly for that split

