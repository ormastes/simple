describe "CMM Lexer - Comparison Operators":
    it "lexes equality operator":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the two-char comparison arms retained as checked booleans
        step("Inspect the equality arm in the operator-or-delimiter scanner")
        val lexes_two_char_ops = cmm_lexer_source().contains("fn lex_operator_or_delimiter(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_eq = cmm_lexer_source().contains("CmmTokenKind.Eq,")
        expect(lexes_two_char_ops and produces_eq).to_equal(true)  # oracle: `==` must consume two characters as one Eq token — the two-char lookahead in lex_operator_or_delimiter is what separates it from assignment `=`

    it "lexes not-equal operator":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the not-equal arm retained as a checked boolean
        step("Inspect the not-equal arm in the operator scanner")
        val produces_not_eq = cmm_lexer_source().contains("CmmTokenKind.NotEq,")
        expect(produces_not_eq).to_equal(true)  # oracle: `!=` is one comparison token — the NotEq arm in the same two-char lookahead chain covers it

    it "lexes less-than-or-equal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the less-or-equal arm retained as a checked boolean
        step("Inspect the less-or-equal arm in the operator scanner")
        val produces_lt_eq = cmm_lexer_source().contains("CmmTokenKind.LtEq,")
        expect(produces_lt_eq).to_equal(true)  # oracle: `<=` must beat the single-char `<` arm, which only happens through the two-char lookahead emitting LtEq

    it "lexes greater-than-or-equal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the greater-or-equal arm retained as a checked boolean
        step("Inspect the greater-or-equal arm in the operator scanner")
        val produces_gt_eq = cmm_lexer_source().contains("CmmTokenKind.GtEq,")
        expect(produces_gt_eq).to_equal(true)  # oracle: `>=` likewise outranks the bare `>` arm only via the same lookahead chain emitting GtEq

describe "CMM Lexer - Range Operators":
    it "lexes range-to operator":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the range-to arm retained as a checked boolean
        step("Inspect the range-to arm in the operator scanner")
        val produces_range_to = cmm_lexer_source().contains("CmmTokenKind.RangeTo,")
        expect(produces_range_to).to_equal(true)  # oracle: `--` is the PRACTICE range-to operator, distinct from two minus tokens — the RangeTo arm is the shipped two-char classification

    it "lexes range-offset operator":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the range-offset arm retained as a checked boolean
        step("Inspect the range-offset arm in the operator scanner")
        val produces_range_offset = cmm_lexer_source().contains("CmmTokenKind.RangeOffset,")
        expect(produces_range_offset).to_equal(true)  # oracle: `++` is range-offset for the same reason — the RangeOffset arm keeps it from splitting into two Plus tokens

    it "lexes range-dots operator":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the range-dots arm retained as a checked boolean
        step("Inspect the range-dots arm in the operator scanner")
        val produces_range_dots = cmm_lexer_source().contains("CmmTokenKind.RangeDots,")
        expect(produces_range_dots).to_equal(true)  # oracle: `..` must outrank the float-dot handling — the RangeDots arm in the two-char chain is what stops a range from lexing as a malformed decimal

describe "CMM Lexer - Logical Operators":
    it "lexes logical AND":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the logical-AND operator arm retained as a checked boolean
