        # @capture(bit_table): the brace delimiters retained as checked booleans
        step("Inspect the left-brace arm in the delimiter chain")
        val produces_lbrace = cmm_lexer_source().contains("CmmTokenKind.LBrace,")
        expect(produces_lbrace).to_equal(true)  # oracle: `{` opens PRACTICE blocks and symbol forms — LBrace is the token the block parser keys on

