# Test Group 2: Labels
# ============================================================================

describe "CMM Lexer - Labels":
    it "lexes label at column 1":
        step("Verify: lexes label at column 1")
        # @req: REQ-FEATURE-CmmLexe-001
        val tokens = lex_cmm_line("start:", 1)
        expect(tokens.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "lexes label with underscore":
        step("Verify: lexes label with underscore")
        # @req: REQ-FEATURE-CmmLexe-001
        val tokens = lex_cmm_line("_my_label:", 1)
        expect(tokens.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "lexes label with alphanumeric chars":
        step("Verify: lexes label with alphanumeric chars")
        # @req: REQ-FEATURE-CmmLexe-001
        val tokens = lex_cmm_line("FlashSetup3:", 1)
        expect(tokens.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "distinguishes label from device selector":
        step("Verify: distinguishes label from device selector")
        # @req: REQ-FEATURE-CmmLexe-001
        # B:: is a device selector, not a label
        val tokens = lex_cmm_line("B::", 1)
        expect(tokens.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "returns empty for empty line":
        step("Verify: returns empty for empty line")
        # @req: REQ-FEATURE-CmmLexe-001
        val tokens = lex_cmm_line("", 1)
        expect(tokens.len()).to_equal(0)  # oracle: value fixed by the spec contract

