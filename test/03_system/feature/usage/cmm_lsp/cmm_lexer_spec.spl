        val produces_classic_and = cmm_lexer_source().contains("CmmTokenKind.ClassicAnd(")
        expect(lexes_classic_forms and produces_classic_and).to_equal(true)  # oracle: `:A:` is the legacy spelling of logical AND — the colon-form try-lexer claims the whole three-character form so the colons do not lex as separators

    it "lexes classic OR colon form":
