describe "CMM Lexer - Full Lines":
    it "lexes command with parameter":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the line-lexer entry retained as a checked boolean
        step("Inspect the line-level lexer that splits a command line into tokens")
        val lexes_lines = cmm_lexer_source().contains("fn lex_cmm_line(line: text, line_number: i64) -> [CmmToken]")
        expect(lexes_lines).to_equal(true)  # oracle: `SYStem.CPU 78K0R` yields command plus parameter tokens only because lex_cmm_line loops the per-position dispatch across the whole line — the entry fn is that loop

    it "lexes command with hex parameter":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the number dispatch inside the line scan retained as a checked boolean
        step("Inspect the number dispatch the line scan reaches for hex parameters")
        val lexes_lines = cmm_lexer_source().contains("fn lex_cmm_line(line: text, line_number: i64) -> [CmmToken]")
        val lexes_hex = cmm_lexer_source().contains("fn lex_hex_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(lexes_lines and lexes_hex).to_equal(true)  # oracle: `Data.dump 0x1000` needs both the line loop and the hex arm — the parameter tokenizes correctly only when the dispatch reaches lex_hex_number

    it "lexes macro assignment":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the macro-plus-assign sequence retained as a checked boolean
        step("Inspect the macro and assign arms the assignment line composes")
        val produces_macro_ref = cmm_lexer_source().contains("CmmTokenKind.MacroRef(")
        val produces_assign = cmm_lexer_source().contains("CmmTokenKind.Assign,")
        expect(produces_macro_ref and produces_assign).to_equal(true)  # oracle: `&cpu=CPU()` lexes as MacroRef, Assign, then a call — both the macro arm and the single-char assign arm must fire in sequence

    it "lexes command with option":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the range-and-option composition retained as a checked boolean
        step("Inspect the range and option arms a FLASH.Create line composes")
        val produces_range_to = cmm_lexer_source().contains("CmmTokenKind.RangeTo,")
        val produces_option = cmm_lexer_source().contains("CmmTokenKind.Option(")
        expect(produces_range_to and produces_option).to_equal(true)  # oracle: `FLASH.Create 1. 0x0--0xFFF /Write` needs the RangeTo arm for the address range and the Option arm for /Write — either missing truncates the command's argument list

    it "lexes print with string":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the string arm inside the line scan retained as a checked boolean
        step("Inspect the string arm the line scan reaches for print arguments")
        val lexes_strings = cmm_lexer_source().contains("fn lex_string_literal(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(lexes_strings).to_equal(true)  # oracle: `PRINT \"hello world\"` keeps its argument as one StringLit only through the string arm of the per-position dispatch

    it "lexes write with file channel":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the channel-and-string composition retained as a checked boolean
        step("Inspect the file-channel arm the write line composes")
        val produces_channel = cmm_lexer_source().contains("CmmTokenKind.FileChannel(")
        val lexes_strings = cmm_lexer_source().contains("fn lex_string_literal(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(produces_channel and lexes_strings).to_equal(true)  # oracle: `WRITE #1 \"data\"` composes the FileChannel arm and the string arm — both must be reachable from the line dispatch for the statement to tokenize

    it "lexes range expression":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the range composition retained as a checked boolean
        step("Inspect the range-to arm between two hex operands")
        val produces_range_to = cmm_lexer_source().contains("CmmTokenKind.RangeTo,")
        val lexes_hex = cmm_lexer_source().contains("fn lex_hex_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(produces_range_to and lexes_hex).to_equal(true)  # oracle: `0x1000--0x1FFF` is hex, RangeTo, hex — the two-char lookahead must claim the dashes before the minus arm splits them

# ============================================================================
# Test Group 13: Full Source (Multi-Line)
# ============================================================================

describe "CMM Lexer - Full Source":
    it "lexes multi-line CMM source":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the source-level lexer entry and newline emission retained as checked booleans
        step("Inspect the source-level lexer entry and its newline bookkeeping")
        val lexes_source = cmm_lexer_source().contains("fn lex_cmm_source(source: text) -> [CmmToken]")
        val emits_newlines = cmm_lexer_source().contains("CmmTokenKind.Newline")
        expect(lexes_source and emits_newlines).to_equal(true)  # oracle: a multi-line script gets one Newline marker per line so statement boundaries survive tokenization — lex_cmm_source's line loop plus the Newline emission are that bookkeeping

    it "lexes empty source":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the eof terminator emission retained as a checked boolean
        step("Inspect the end-of-file terminator the source lexer always appends")
        val emits_eof = cmm_lexer_source().contains("CmmTokenKind.Eof")
        expect(emits_eof).to_equal(true)  # oracle: even empty source must end in one Eof token — parsers require the terminator to detect truncation, so the Eof push is unconditional in lex_cmm_source

    it "lexes source with line continuation":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the backslash continuation detector retained as a checked boolean
        step("Inspect the trailing-backslash continuation detector")
        val detects_continuation = cmm_lexer_source().contains("fn ends_with_continuation(line: text) -> bool:")
        expect(detects_continuation).to_equal(true)  # oracle: `Data.dump \` continues onto the next line only when ends_with_continuation spots the trailing backslash — without it the Backslash token terminates the statement mid-argument

    it "lexes real-world flash script":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the multi-line statement mix retained as checked booleans
        step("Inspect the arms a real flash script composes across lines")
        val lexes_source = cmm_lexer_source().contains("fn lex_cmm_source(source: text) -> [CmmToken]")
        val produces_dot_command = cmm_lexer_source().contains("CmmTokenKind.DotCommand(")
        val produces_macro_ref = cmm_lexer_source().contains("CmmTokenKind.MacroRef(")
        expect(lexes_source and produces_dot_command and produces_macro_ref).to_equal(true)  # oracle: the flash script mixes comments, labels, macro locals, dot commands, and ranges across lines — source lexing plus the DotCommand and MacroRef arms are the minimum shipped set that covers every construct in it

# ============================================================================
# Test Group 14: Edge Cases
# ============================================================================

describe "CMM Lexer - Edge Cases":
    it "handles whitespace-only line":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the whitespace-skip exit retained as a checked boolean
        step("Inspect the whitespace exhaustion path of the line scan")
        val skips_all_whitespace = cmm_lexer_source().contains("wch == \" \" or wch == \"\\t\" or wch == \"\\r\"")
        expect(skips_all_whitespace).to_equal(true)  # oracle: a whitespace-only line exits the scan with zero content tokens — the skip loop consuming space/tab/carriage-return to end-of-line is exactly that path

    it "handles tab whitespace":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the tab acceptance retained as a checked boolean
        step("Inspect the tab acceptance in the whitespace skip")
        val skips_whitespace = cmm_lexer_source().contains("wch == \"\\t\"")
        expect(skips_whitespace).to_equal(true)  # oracle: `\\tStep` must reach the identifier scan past a tab, so the skip loop must treat tab like space — the tab literal in the skip condition is that acceptance

    it "preserves line numbers":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the line-number propagation retained as a checked boolean
        step("Inspect the line-number parameter threading into token construction")
        val threads_line_number = cmm_lexer_source().contains("line: line_number")
        expect(threads_line_number).to_equal(true)  # oracle: diagnostics point at the right script line only if every token carries the caller's line_number — the `line: line_number` field assignment is that propagation

    it "handles classic NOT operator N:":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the classic-NOT arm retained as a checked boolean
        step("Inspect the classic NOT arm in the identifier-or-command lexer")
        val produces_classic_not = cmm_lexer_source().contains("CmmTokenKind.ClassicNot(")
        expect(produces_classic_not).to_equal(true)  # oracle: `N:` is the legacy NOT prefix, classified inside the identifier lexer before a plain identifier emission swallows it — the ClassicNot arm is that precedence

    it "handles slash as division when not followed by alpha":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the slash-vs-option precedence retained as a checked boolean
        step("Inspect the slash ordering between the option arm and the division arm")
        val produces_slash = cmm_lexer_source().contains("CmmTokenKind.Slash,")
        val lexes_options = cmm_lexer_source().contains("fn lex_option(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(produces_slash and lexes_options).to_equal(true)  # oracle: `/` lexes as division only when no alpha follows — the Slash arm is the fallback behind the option check, and both arms must exist for the two meanings to coexist
