        val produces_shift_right = cmm_lexer_source().contains("CmmTokenKind.ShiftRight,")
        expect(produces_shift_right).to_equal(true)  # oracle: `>>` mirrors shift-left — the ShiftRight arm prevents two Gt tokens where one shift belongs

describe "CMM Lexer - Classic Operators":
    it "lexes classic AND colon form":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the classic colon-operator try-lexer retained as a checked boolean
