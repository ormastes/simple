        val produces_rparen = cmm_lexer_source().contains("CmmTokenKind.RParen,")
        expect(produces_rparen).to_equal(true)  # oracle: `)` closes what LParen opens — the RParen arm is the matching half of the balance contract

    it "lexes left brace":
