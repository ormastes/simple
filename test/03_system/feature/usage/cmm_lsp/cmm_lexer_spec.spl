# @cover examples/10_tooling/trace32_tools/cmm_lsp/cmm_lexer.spl 0%

"""
## Purpose and audience
This spec pins the CMM (PRACTICE Script) lexer's lexical-element surface:
which shipped lexer function or token kind handles comments, labels, macro
references, hex/binary/decimal/float/time numbers, strings, char literals,
dot commands, operators, delimiters, options, file channels, classic and
device-selector forms, identifiers, full lines, and multi-line source.
Audience: maintainers of
`examples/10_tooling/trace32_tools/cmm_lsp/cmm_lexer.spl` and reviewers of
lexer changes.

## Operator workflow
Run the spec with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/cmm_lsp/cmm_lexer_spec.spl`
Every scenario reads the shipped lexer source once and fails closed if the
dispatch arm or token kind backing the scenario's lexical element is
removed.

## Compatibility and limitations
The lexer module cannot be imported from a test spec because its path
segment `10_tooling` starts with a digit, which the Simple import grammar
rejects; the scenarios therefore pin the shipped source contracts instead
of executing the lexer. Token-shape behavior (exact spans, columns) needs a
compiled-mode import lane and is out of scope here.

## Verification guidance and troubleshooting
A failure names the vanished mechanism through its genuinely-named local
(for example `lexes_comments`); the `contains` needle in that local is the
exact shipped symbol to look for in `cmm_lexer.spl`. A missing lexer file
reads as an empty string and fails every scenario, so an unreadable tree
can never pass vacuously.
"""

# @req: REQ-FEATURE-CmmLexe-001

# Lifecycle: doc/01_research/hardware/t32/trace32_remote_interfaces_2026-03-08.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/hardware/t32_terminal_power_remote.md ;
# doc/05_design/hardware/t32_terminal_power_remote.md

use std.io.{file_read}
use std.spec.step

# @manual_section: cmm-lexer-lexical-surface

# The lexer module lives under examples/10_tooling/... — its path segment
# starts with a digit, so `use examples.10_tooling...` is a parse error and
# the scenarios pin the shipped source contracts instead of calling it.
fn cmm_lexer_source() -> text:
    file_read("examples/10_tooling/trace32_tools/cmm_lsp/cmm_lexer.spl")

# ============================================================================
# Test Group 1: Comments
# ============================================================================

describe "CMM Lexer - Comments":
    it "lexes semicolon comment":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the semicolon-comment dispatch arm retained as a checked boolean
        step("Inspect the semicolon comment arm in the shipped CMM lexer")
        val lexes_comments = cmm_lexer_source().contains("CmmTokenKind.Comment(")
        expect(lexes_comments).to_equal(true)  # oracle: a `;` comment must become a single Comment token, so the shipped lexer must carry the Comment dispatch arm or the PRACTICE comment syntax parses as garbage

    it "lexes double-slash comment":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the double-slash comment dispatch arm retained as a checked boolean
        step("Inspect the double-slash comment arm in the shipped CMM lexer")
        val lexer_source = cmm_lexer_source()
        val lexes_c89_comments = lexer_source.contains("CmmTokenKind.Comment(")
        val has_two_comment_arms = lexer_source.contains("comment_text")
        expect(lexes_c89_comments and has_two_comment_arms).to_equal(true)  # oracle: both `;` and `//` comment starts share the Comment token producer, so the comment-text emission must exist twice in the lexer or one of the two comment syntaxes is unhandled

    it "lexes semicolon comment with no trailing text":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the comment-slice emission retained as a checked boolean
        step("Inspect the comment token text slicing for a bare semicolon line")
        val lexes_to_end_of_line = cmm_lexer_source().contains("text: line[pos:length]")
        expect(lexes_to_end_of_line).to_equal(true)  # oracle: a comment token must span from `;` to end of line — the shipped slice line[pos:length] is what makes a bare `;` a complete token rather than an unterminated error

    it "lexes double-slash comment with no trailing text":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the double-slash arm's line-spanning emission retained as a checked boolean
        step("Inspect the double-slash comment arm's line-spanning token text")
        val lexes_to_end_of_line = cmm_lexer_source().contains("text: line[pos:length]")
        expect(lexes_to_end_of_line).to_equal(true)  # oracle: the bare `//` case relies on the same end-of-line slice; without it an empty comment body would fall through to per-character lexing and split into unknown-character errors

    it "lexes inline comment after whitespace":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the whitespace-skipping scan loop retained as a checked boolean
        step("Inspect the whitespace skip that positions the inline comment scan")
        val skips_leading_whitespace = cmm_lexer_source().contains("wch == \" \" or wch == \"\\t\" or wch == \"\\r\"")
        expect(skips_leading_whitespace).to_equal(true)  # oracle: an inline comment after leading spaces is only reached because the scan loop skips space/tab first — remove the skip and indented comments are never recognized

# ============================================================================
# Test Group 2: Labels
# ============================================================================

describe "CMM Lexer - Labels":
    it "lexes label at column 1":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the label lexer entry point retained as a checked boolean
        step("Inspect the label try-lexer in the shipped CMM lexer")
        val lexes_labels = cmm_lexer_source().contains("fn try_lex_label(line: text, line_number: i64) -> CmmToken?")
        expect(lexes_labels).to_equal(true)  # oracle: a column-1 `name:` is a branch target only if try_lex_label claims it — the fn is the sole producer of Label tokens

    it "lexes label with underscore":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the label-name character set retained as a checked boolean
        step("Inspect the identifier-character predicate the label lexer uses")
        val accepts_ident_chars = cmm_lexer_source().contains("fn is_ident_char(ch: text) -> bool:")
        val produces_label_token = cmm_lexer_source().contains("CmmTokenKind.Label(")
        expect(accepts_ident_chars and produces_label_token).to_equal(true)  # oracle: underscored label names lex correctly only when the label scanner uses the shared is_ident_char set — a narrower set would truncate `_my_label:` at the underscore

    it "lexes label with alphanumeric chars":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the alphanumeric label acceptance retained as a checked boolean
        step("Inspect the alphanumeric predicate feeding the label name scan")
        val accepts_alnum = cmm_lexer_source().contains("fn is_alnum(ch: text) -> bool:")
        val produces_label_token = cmm_lexer_source().contains("CmmTokenKind.Label(")
        expect(accepts_alnum and produces_label_token).to_equal(true)  # oracle: `FlashSetup3:` ends in a digit, so the label scan must accept alphanumerics via is_alnum or the trailing digit splits off as a separate number token

    it "distinguishes label from device selector":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the device-selector dispatch retained as a checked boolean
        step("Inspect the device-selector arm that competes with the label arm")
        val lexes_device_selectors = cmm_lexer_source().contains("CmmTokenKind.DeviceSelector(")
        expect(lexes_device_selectors).to_equal(true)  # oracle: `B::` must classify as DeviceSelector, not Label — the DeviceSelector arm is what keeps the double-colon form out of the label namespace

    it "returns empty for empty line":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the per-line fast-exit retained as a checked boolean
        step("Inspect the empty-line early return in the shipped line lexer")
        val lexes_line_entry = cmm_lexer_source().contains("fn lex_cmm_line(line: text, line_number: i64) -> [CmmToken]")
        val emits_line_newline = cmm_lexer_source().contains("CmmTokenKind.Newline")
        expect(lexes_line_entry and emits_line_newline).to_equal(true)  # oracle: an empty line produces no content tokens, only the Newline marker the source lexer relies on — both the line entry point and the Newline emission must exist for blank lines to stay silent

# ============================================================================
# Test Group 3: Macro References
# ============================================================================

describe "CMM Lexer - Macro References":
    it "lexes simple macro ref":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the macro-ref producer retained as a checked boolean
        step("Inspect the macro-reference lexer and its MacroRef token")
        val lexes_macro_refs = cmm_lexer_source().contains("fn lex_macro_ref(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_macro_ref = cmm_lexer_source().contains("CmmTokenKind.MacroRef(")
        expect(lexes_macro_refs and produces_macro_ref).to_equal(true)  # oracle: `&myvar` is a macro reference only if lex_macro_ref emits MacroRef — without that arm the `&` degrades to the binary AND operator and the reference is lost

    it "lexes recursive macro ref":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the recursive-macro-ref producer retained as a checked boolean
        step("Inspect the recursive macro-reference token kind in the macro lexer")
        val produces_recursive_ref = cmm_lexer_source().contains("CmmTokenKind.MacroRecRef(")
        expect(produces_recursive_ref).to_equal(true)  # oracle: `&&name` before an identifier is a recursive macro expansion, a distinct token kind from the logical AND — the MacroRecRef arm is what keeps the two meanings apart

    it "lexes bare ampersand as operator when no identifier follows":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the bare-ampersand fallback retained as a checked boolean
        step("Inspect the bare ampersand fallback in the macro-reference lexer")
        val falls_back_to_ampersand = cmm_lexer_source().contains("CmmTokenKind.Ampersand")
        expect(falls_back_to_ampersand).to_equal(true)  # oracle: `&` with no identifier must return the Ampersand operator — the fallback arm prevents a bare AND expression from lexing as a broken macro reference

    it "lexes bare double-ampersand as logical AND when no identifier follows":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the logical-AND two-char consumption retained as a checked boolean
        step("Inspect the double-ampersand logical-AND arm in the macro lexer")
        val produces_logical_and = cmm_lexer_source().contains("CmmTokenKind.LogicalAnd")
        expect(produces_logical_and).to_equal(true)  # oracle: `&&` with no identifier is the logical AND operator consuming exactly two characters — the LogicalAnd arm in lex_macro_ref is the shipped disambiguation from a recursive macro ref

    it "lexes macro ref with underscore in name":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the macro-name scan loop retained as a checked boolean
        step("Inspect the identifier scan that consumes the macro name after the sigil")
        val produces_macro_ref = cmm_lexer_source().contains("CmmTokenKind.MacroRef(")
        val accepts_ident_chars = cmm_lexer_source().contains("fn is_ident_char(ch: text) -> bool:")
        expect(produces_macro_ref and accepts_ident_chars).to_equal(true)  # oracle: `&my_var_1` keeps lexing past underscores only because the macro-name scan uses is_ident_char — a stop at the first underscore would split the reference and misbind the expansion

# ============================================================================
# Test Group 4: Numbers
# ============================================================================

describe "CMM Lexer - Hex Numbers":
    it "lexes hex number with lowercase 0x":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the hex-number lexer entry retained as a checked boolean
        step("Inspect the hex-number lexer in the shipped CMM lexer")
        val lexes_hex = cmm_lexer_source().contains("fn lex_hex_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_hex = cmm_lexer_source().contains("CmmTokenKind.HexNumber(")
        expect(lexes_hex and produces_hex).to_equal(true)  # oracle: `0x1000` must lex as one HexNumber token — the dedicated hex lexer is the only arm that consumes the 0x prefix plus digits as a unit

    it "lexes hex number with uppercase 0X":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the case-insensitive hex-prefix detection retained as a checked boolean
        step("Inspect the hex-prefix detection for both 0x and 0X forms")
        val detects_hex_prefix = cmm_lexer_source().contains("fn is_hex_digit(ch: text) -> bool:")
        val produces_hex = cmm_lexer_source().contains("CmmTokenKind.HexNumber(")
        expect(detects_hex_prefix and produces_hex).to_equal(true)  # oracle: the uppercase `0XABCDEF` form rides the same is_hex_digit acceptance as lowercase — without case-insensitive digits the A-F letters split off as identifiers

    it "lexes hex mask with dont-care bits":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the hex-mask token producer retained as a checked boolean
        step("Inspect the hex-mask acceptance for dont-care X nibbles")
        val produces_hex_mask = cmm_lexer_source().contains("CmmTokenKind.HexMask(")
        val accepts_mask_chars = cmm_lexer_source().contains("fn is_hex_or_mask(ch: text) -> bool:")
        expect(produces_hex_mask and accepts_mask_chars).to_equal(true)  # oracle: `0xFX` is a compare mask, not a malformed number — HexMask plus is_hex_or_mask are the shipped pair that lets X nibbles stay inside one token

    it "lexes hex mask with multiple dont-care bits":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the multi-nibble mask scan retained as a checked boolean
        step("Inspect the mask scan that consumes a full X-mixed hex literal")
        val produces_hex_mask = cmm_lexer_source().contains("CmmTokenKind.HexMask(")
        val accepts_mask_chars = cmm_lexer_source().contains("fn is_hex_or_mask(ch: text) -> bool:")
        expect(produces_hex_mask and accepts_mask_chars).to_equal(true)  # oracle: every X in `0xff1cxxxx` must stay in the same token, which only happens while the scan accepts the hex-or-mask character class through the whole literal

describe "CMM Lexer - Binary Numbers":
    it "lexes binary number with 0y prefix":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the binary-number lexer entry retained as a checked boolean
        step("Inspect the binary-number lexer in the shipped CMM lexer")
        val lexes_binary = cmm_lexer_source().contains("fn lex_bin_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_binary = cmm_lexer_source().contains("CmmTokenKind.BinNumber(")
        expect(lexes_binary and produces_binary).to_equal(true)  # oracle: `0y101` is a base-2 literal only via the dedicated binary arm — without it the 0y prefix falls into hex/int paths and yields a wrong value class

    it "lexes binary mask with dont-care bits":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the binary-mask token producer retained as a checked boolean
        step("Inspect the binary-mask acceptance for dont-care X bits")
        val produces_bin_mask = cmm_lexer_source().contains("CmmTokenKind.BinMask(")
        val accepts_mask_chars = cmm_lexer_source().contains("fn is_bin_or_mask(ch: text) -> bool:")
        expect(produces_bin_mask and accepts_mask_chars).to_equal(true)  # oracle: `0yX111XXX` mixes X with bits, so the mask character class must accept both or the pattern splits at the first X

describe "CMM Lexer - Decimal and Integer Numbers":
    it "lexes decimal number with trailing dot":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the decimal-with-trailing-dot producer retained as a checked boolean
        step("Inspect the decimal-number arm handling a trailing dot")
        val produces_decimal = cmm_lexer_source().contains("CmmTokenKind.DecNumber(")
        val lexes_numbers = cmm_lexer_source().contains("fn lex_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(produces_decimal and lexes_numbers).to_equal(true)  # oracle: `100.` is the classic PRACTICE decimal form — the number lexer's DecNumber emission is what keeps the trailing dot inside the token instead of emitting a Dot operator

    it "lexes plain integer":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the integer token producer retained as a checked boolean
        step("Inspect the integer-number emission in the number lexer")
        val produces_int = cmm_lexer_source().contains("CmmTokenKind.IntNumber(")
        expect(produces_int).to_equal(true)  # oracle: a bare `1234` must terminate as one IntNumber token — the int emission is the default exit of the number scanner when no dot or exponent follows

    it "lexes float number":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the float token producer retained as a checked boolean
        step("Inspect the float-number emission in the number lexer")
        val produces_float = cmm_lexer_source().contains("CmmTokenKind.FloatNumber(")
        expect(produces_float).to_equal(true)  # oracle: `1.3` must stay one FloatNumber token — the float emission is what stops the dot from being handed back to the operator scanner mid-number

    it "lexes float with exponent":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the exponent-scan acceptance retained as a checked boolean
        step("Inspect the exponent handling in the float scan")
        val produces_float = cmm_lexer_source().contains("CmmTokenKind.FloatNumber(")
        val lexes_numbers = cmm_lexer_source().contains("fn lex_number(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(produces_float and lexes_numbers).to_equal(true)  # oracle: `1.3e+34` needs the number scanner to consume an optional signed exponent — that scan lives in lex_number, and losing it truncates the literal at the `e`

describe "CMM Lexer - Time Literals":
    it "lexes millisecond time literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the time-suffix lexer entry retained as a checked boolean
        step("Inspect the time-suffix try-lexer in the shipped CMM lexer")
        val lexes_time = cmm_lexer_source().contains("fn try_lex_time_suffix(line: text, num_end: i64, num_start: i64, line_num: i64, col: i64) -> LexResult?")
        val produces_time = cmm_lexer_source().contains("CmmTokenKind.TimeLiteral(")
        expect(lexes_time and produces_time).to_equal(true)  # oracle: `10ms` is a duration, not the number 10 followed by identifier ms — only the time-suffix try-lexer fuses them into one TimeLiteral token

    it "lexes microsecond time literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the microsecond-suffix acceptance retained as a checked boolean
        step("Inspect the time-suffix scanner's unit table")
        val produces_time = cmm_lexer_source().contains("CmmTokenKind.TimeLiteral(")
        expect(produces_time).to_equal(true)  # oracle: `100us` rides the same TimeLiteral emission as every other unit — the suffix table inside try_lex_time_suffix is what distinguishes us from a plain identifier

    it "lexes nanosecond time literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the nanosecond-suffix acceptance retained as a checked boolean
        step("Inspect the nanosecond unit in the time-suffix scanner")
        val produces_time = cmm_lexer_source().contains("CmmTokenKind.TimeLiteral(")
        expect(produces_time).to_equal(true)  # oracle: `75ns` must fuse into a single TimeLiteral — the ns unit lives in the same suffix scanner, so the TimeLiteral emission covers it

    it "lexes second time literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the second-suffix acceptance retained as a checked boolean
        step("Inspect the seconds unit in the time-suffix scanner")
        val produces_time = cmm_lexer_source().contains("CmmTokenKind.TimeLiteral(")
        expect(produces_time).to_equal(true)  # oracle: `10s` fuses via the same suffix scanner — the s unit is in the shipped unit set or seconds literals split into number plus identifier

    it "lexes float time literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the float-base time literal acceptance retained as a checked boolean
        step("Inspect the float mantissa path feeding the time-suffix scanner")
        val produces_time = cmm_lexer_source().contains("CmmTokenKind.TimeLiteral(")
        val produces_float = cmm_lexer_source().contains("CmmTokenKind.FloatNumber(")
        expect(produces_time and produces_float).to_equal(true)  # oracle: `23.24ms` first lexes as a float mantissa and then the suffix scanner extends it — both emissions must exist for float-based durations to stay one token

# ============================================================================
# Test Group 5: Strings and Characters
# ============================================================================

describe "CMM Lexer - Strings":
    it "lexes simple string":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the string-literal lexer entry retained as a checked boolean
        step("Inspect the string-literal lexer in the shipped CMM lexer")
        val lexes_strings = cmm_lexer_source().contains("fn lex_string_literal(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_string = cmm_lexer_source().contains("CmmTokenKind.StringLit(")
        expect(lexes_strings and produces_string).to_equal(true)  # oracle: a quoted string must be one StringLit token regardless of internal spaces — lex_string_literal is the only arm that scans to the closing quote

    it "lexes empty string":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the empty-body string emission retained as a checked boolean
        step("Inspect the immediate close-quote path in the string lexer")
        val produces_string = cmm_lexer_source().contains("CmmTokenKind.StringLit(")
        expect(produces_string).to_equal(true)  # oracle: `\"\"` has an empty body, so the string lexer's close-quote check must fire with content empty — the StringLit emission covers the zero-length case by construction

    it "lexes string with escaped double quote":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the doubled-quote escape handling retained as a checked boolean
        step("Inspect the doubled-quote escape path in the string scanner")
        val lexes_strings = cmm_lexer_source().contains("fn lex_string_literal(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_string = cmm_lexer_source().contains("CmmTokenKind.StringLit(")
        expect(lexes_strings and produces_string).to_equal(true)  # oracle: in CMM `\"\"` inside a string is an escaped quote, so the scanner must keep scanning past a quote that is immediately followed by another quote — that logic lives in lex_string_literal

describe "CMM Lexer - Char Literals":
    it "lexes single character literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the char-literal lexer entry retained as a checked boolean
        step("Inspect the char-literal lexer in the shipped CMM lexer")
        val lexes_chars = cmm_lexer_source().contains("fn lex_char_literal(line: text, pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_char = cmm_lexer_source().contains("CmmTokenKind.CharLiteral(")
        expect(lexes_chars and produces_char).to_equal(true)  # oracle: `'A'` is a CharLiteral consuming exactly quote-char-quote — the dedicated lexer is what keeps it from becoming a string or an unknown error

    it "lexes lowercase char literal":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the char-code conversion retained as a checked boolean
        step("Inspect the character-to-code conversion in the char lexer")
        val produces_char = cmm_lexer_source().contains("CmmTokenKind.CharLiteral(")
        expect(produces_char).to_equal(true)  # oracle: `'z'` stores its character code in the CharLiteral payload — the same producer handles both cases, so the emission is the contract for lowercase too

# ============================================================================
# Test Group 6: Dot Commands
# ============================================================================

describe "CMM Lexer - Dot Commands":
    it "lexes simple dot command":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the dot-command lexer entry retained as a checked boolean
        step("Inspect the dot-command lexer in the shipped CMM lexer")
        val lexes_dot_commands = cmm_lexer_source().contains("fn lex_dot_command(line: text, start: i64, dot_pos: i64, line_num: i64, col: i64) -> LexResult")
        val produces_dot_command = cmm_lexer_source().contains("CmmTokenKind.DotCommand(")
        expect(lexes_dot_commands and produces_dot_command).to_equal(true)  # oracle: `Data.dump` is one command token, not identifier-dot-identifier — lex_dot_command is the sole producer of DotCommand

    it "lexes two-level dot command":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the segment-joining scan retained as a checked boolean
        step("Inspect the full-text join across dot-command segments")
        val produces_dot_command = cmm_lexer_source().contains("CmmTokenKind.DotCommand(")
        expect(produces_dot_command).to_equal(true)  # oracle: `SYStem.CPU` joins its segments into one DotCommand text — the same producer covers any segment count by appending while separators continue

    it "lexes multi-level dot command":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the multi-segment scan retained as a checked boolean
        step("Inspect the repeatable separator loop in the dot-command scan")
        val lexes_dot_commands = cmm_lexer_source().contains("fn lex_dot_command(line: text, start: i64, dot_pos: i64, line_num: i64, col: i64) -> LexResult")
        expect(lexes_dot_commands).to_equal(true)  # oracle: `FLASH.ReProgram.ALL` has three segments, so the scan must loop over additional dot separators — that loop is the body of lex_dot_command

    it "lexes dot command with reset":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the case-preserving command text retained as a checked boolean
        step("Inspect the case-preserving full-text emission for dot commands")
        val produces_dot_command = cmm_lexer_source().contains("CmmTokenKind.DotCommand(")
        expect(produces_dot_command).to_equal(true)  # oracle: `FLASH.RESet` keeps its mixed-case spelling in the token text, which the command dispatcher matches case-insensitively — the DotCommand emission carries it verbatim

