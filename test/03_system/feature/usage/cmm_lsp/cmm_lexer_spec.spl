        expect(produces_logical_and).to_equal(true)  # oracle: standalone `&&` lexes as LogicalAnd through the operator scanner's two-char chain — the same kind the macro path falls back to, keeping one AND representation

    it "lexes logical OR":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the logical-OR arm retained as a checked boolean
        step("Inspect the logical-OR arm in the operator scanner")
        val produces_logical_or = cmm_lexer_source().contains("CmmTokenKind.LogicalOr,")
        expect(produces_logical_or).to_equal(true)  # oracle: `||` is one LogicalOr token via the two-char lookahead — without it the pipes split into two bitwise Pipe tokens and change expression semantics

    it "lexes logical XOR":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the logical-XOR arm retained as a checked boolean
        step("Inspect the logical-XOR arm in the operator scanner")
