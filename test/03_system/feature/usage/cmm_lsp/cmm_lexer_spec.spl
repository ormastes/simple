        # @capture(bit_table): the right-brace arm retained as a checked boolean
        step("Inspect the right-brace arm in the delimiter chain")
        val produces_rbrace = cmm_lexer_source().contains("CmmTokenKind.RBrace,")
        expect(produces_rbrace).to_equal(true)  # oracle: `}` closes what LBrace opens — the RBrace arm completes the block-delimiter pair

    it "lexes comma":
        # @req REQ-FEATURE-CmmLexe-001
        # @capture(bit_table): the comma arm retained as a checked boolean
        step("Inspect the comma arm in the delimiter chain")
        val produces_comma = cmm_lexer_source().contains("CmmTokenKind.Comma,")
        expect(produces_comma).to_equal(true)  # oracle: `,` separates arguments and parameters — the Comma arm is what argument-list parsing splits on

