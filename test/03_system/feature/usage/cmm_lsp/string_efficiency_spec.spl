# @cover src/lib/common/js/builtins/string.spl 0%

"""
## Purpose and audience
This spec pins the correctness of the segment-based string operations used
across the CMM LSP toolchain — join_parts, to_upper_cmm, escape_json,
json_string/json_array/json_object, and split_lines — after their rewrite
from O(n²) character-by-character concatenation to O(n log n) batching.
Audience: maintainers of `examples/10_tooling/trace32_tools/cmm_lsp/` and
of the stdlib string builtins these helpers mirror.

## Operator workflow
Run the spec with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/cmm_lsp/string_efficiency_spec.spl`
Each scenario executes the helper under test on a constructed input and
compares against the behavior of the original naive implementation,
including large inputs that would have been noticeably slow before the
rewrite.

## Compatibility and limitations
The helpers here are faithful reimplementations of the shipped
`cmm_parser.spl`, `lsp_json.spl`, and `cmm_lexer.spl` functions, kept
in-file because the `examples.10_tooling` path segment cannot be imported
from a test spec (digit-leading identifier). A drift between a
reimplementation and its shipped original is therefore not caught here;
the large-input scenarios exist to catch algorithmic (quadratic-vs-batched)
regressions in the reimplemented logic itself.

## Verification guidance and troubleshooting
A failure in a small-input case means the reimplementation diverged from
the original naive behavior — diff the helper against its `# --- from ...`
origin comment. A failure in a "large input" case is the regression signal
the rewrite exists for: batching lost, duplicated, or reordered a segment.
An oracle comment on a length assertion states the exact arithmetic the
expected length encodes.
"""

# @req: REQ-FEATURE-StriEffi-001

# Lifecycle: doc/01_research/hardware/t32/trace32_remote_interfaces_2026-03-08.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/hardware/t32_terminal_power_remote.md ;
# doc/05_design/hardware/t32_terminal_power_remote.md

# @manual_section: cmm-string-efficiency

# tag: []

import std.spec

# ---------------------------------------------------------------------------
# Stubs — reimplemented helper functions matching the optimized versions
# ---------------------------------------------------------------------------

# --- join_parts (from cmm_parser.spl) ---
fn join_parts(parts: [text]) -> text:
    val n = parts.len()
    if n == 0: return ""
    if n == 1: return parts[0]
    if n == 2: return parts[0] + parts[1]
    if n == 3: return parts[0] + parts[1] + parts[2]
    if n == 4: return parts[0] + parts[1] + parts[2] + parts[3]
    var merged: [text] = []
    var i = 0
    while i + 7 < n:
        merged.push(parts[i] + parts[i+1] + parts[i+2] + parts[i+3] + parts[i+4] + parts[i+5] + parts[i+6] + parts[i+7])
        i = i + 8
    var tail = ""
    while i < n:
        tail = tail + parts[i]
        i = i + 1
    if tail.len() > 0:
        merged.push(tail)
    join_parts(merged)

# --- char_to_upper (from cmm_parser.spl) ---
fn char_to_upper(ch: text) -> text:
    if ch == "a": return "A"
    if ch == "b": return "B"
    if ch == "c": return "C"
    if ch == "d": return "D"
    if ch == "e": return "E"
    if ch == "f": return "F"
    if ch == "g": return "G"
    if ch == "h": return "H"
    if ch == "i": return "I"
    if ch == "j": return "J"
    if ch == "k": return "K"
    if ch == "l": return "L"
    if ch == "m": return "M"
    if ch == "n": return "N"
    if ch == "o": return "O"
    if ch == "p": return "P"
    if ch == "q": return "Q"
    if ch == "r": return "R"
    if ch == "s": return "S"
    if ch == "t": return "T"
    if ch == "u": return "U"
    if ch == "v": return "V"
    if ch == "w": return "W"
    if ch == "x": return "X"
    if ch == "y": return "Y"
    if ch == "z": return "Z"
    ch

# --- to_upper_cmm (from cmm_parser.spl) ---
fn to_upper_cmm(s: text) -> text:
    var needs_conversion = false
    var i = 0
    while i < s.len():
        val ch = s[i:i + 1]
        if ch >= "a" and ch <= "z":
            needs_conversion = true
            break
        i = i + 1
    if not needs_conversion:
        return s
    var parts: [text] = []
    i = 0
    while i < s.len():
        val ch = s[i:i + 1]
        parts.push(char_to_upper(ch))
        i = i + 1
    join_parts(parts)

# --- escape_json (from lsp_json.spl) ---
fn escape_json(s: text) -> text:
    val len = s.len()
    var has_special = false
    var scan = 0
    while scan < len:
        val ch = s[scan:scan + 1]
        if ch == "\\" or ch == "\"" or ch == "\n" or ch == "\r" or ch == "\t":
            has_special = true
            break
        scan = scan + 1
    if not has_special:
        return s
    var parts: [text] = []
    var seg_start = 0
    var i = 0
    while i < len:
        val ch = s[i:i + 1]
        if ch == "\\":
            if i > seg_start: parts.push(s[seg_start:i])
            parts.push("\\\\")
            i = i + 1
            seg_start = i
        else if ch == "\"":
            if i > seg_start: parts.push(s[seg_start:i])
            parts.push("\\\"")
            i = i + 1
            seg_start = i
        else if ch == "\n":
            if i > seg_start: parts.push(s[seg_start:i])
            parts.push("\\n")
            i = i + 1
            seg_start = i
        else if ch == "\r":
            if i > seg_start: parts.push(s[seg_start:i])
            parts.push("\\r")
            i = i + 1
            seg_start = i
        else if ch == "\t":
            if i > seg_start: parts.push(s[seg_start:i])
            parts.push("\\t")
            i = i + 1
            seg_start = i
        else:
            i = i + 1
    if seg_start < len:
        parts.push(s[seg_start:len])
    join_parts(parts)

# --- json helpers ---
fn json_string(s: text) -> text:
    val escaped = escape_json(s)
    val q = "\""
    q + escaped + q

struct JsonPair:
    key: text
    value: text

fn json_array(items: [text]) -> text:
    val n = items.len()
    if n == 0: return "[]"
    if n == 1: return "[" + items[0] + "]"
    var parts: [text] = []
    parts.push("[")
    var i = 0
    while i < n:
        if i > 0:
            parts.push(",")
        parts.push(items[i])
        i = i + 1
    parts.push("]")
    join_parts(parts)

fn json_object(pairs: [JsonPair]) -> text:
    val n = pairs.len()
    if n == 0: return "{}"
    var parts: [text] = []
    parts.push("{")
    var i = 0
    while i < n:
        if i > 0:
            parts.push(",")
        parts.push(json_string(pairs[i].key))
        parts.push(":")
        parts.push(pairs[i].value)
        i = i + 1
    parts.push("}")
    join_parts(parts)

# --- split_lines (from cmm_lexer.spl) ---
fn split_lines(source: text) -> [text]:
    var lines: [text] = []
    var start = 0
    var i = 0
    while i < source.len():
        if source[i:i + 1] == "\n":
            lines.push(source[start:i])
            start = i + 1
        i = i + 1
    if start <= source.len():
        lines.push(source[start:source.len()])
    lines

# Helper: build a string of N repeated characters
fn repeat_char(ch: text, n: i64) -> text:
    var parts: [text] = []
    var i = 0
    while i < n:
        parts.push(ch)
        i = i + 1
    join_parts(parts)


# ============================================================================
# Test Group 1: join_parts — the core batch-concat helper
# ============================================================================

describe "join_parts":
    """
    ## Batch String Joining

    The core helper used by all optimized string operations.
    Uses recursive batch-of-8 concatenation for O(n log n) performance.
    """

    context "basic cases":
        it "joins empty array":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins empty array")
            expect(join_parts([])).to_equal("")

        it "joins single element":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins single element")
            expect(join_parts(["hello"])).to_equal("hello")

        it "joins two elements":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins two elements")
            expect(join_parts(["hello", " world"])).to_equal("hello world")

        it "joins three elements":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins three elements")
            expect(join_parts(["a", "b", "c"])).to_equal("abc")

        it "joins four elements":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins four elements")
            expect(join_parts(["1", "2", "3", "4"])).to_equal("1234")

    context "batch path (more than 4 elements)":
        it "joins 5 elements":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 5 elements")
            expect(join_parts(["a", "b", "c", "d", "e"])).to_equal("abcde")

        it "joins 8 elements — exact batch":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 8 elements — exact batch")
            expect(join_parts(["1", "2", "3", "4", "5", "6", "7", "8"])).to_equal("12345678")

        it "joins 9 elements — batch + remainder":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 9 elements — batch + remainder")
            expect(join_parts(["a", "b", "c", "d", "e", "f", "g", "h", "i"])).to_equal("abcdefghi")

        it "joins 16 elements — two full batches":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 16 elements — two full batches")
            var parts: [text] = []
            var i = 0
            while i < 16:
                parts.push("x")
                i = i + 1
            expect(join_parts(parts)).to_equal("xxxxxxxxxxxxxxxx")

    context "large inputs — would be slow with O(n²)":
        it "joins 100 single-char parts":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 100 single-char parts")
            var parts: [text] = []
            var i = 0
            while i < 100:
                parts.push("a")
                i = i + 1
            val result = join_parts(parts)
            expect(result.len()).to_equal(100)  # oracle: 100 single-char parts joined must yield exactly 100 characters — batching may not drop or duplicate a part

        it "joins 500 single-char parts":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins 500 single-char parts")
            var parts: [text] = []
            var i = 0
            while i < 500:
                parts.push("b")
                i = i + 1
            val result = join_parts(parts)
            expect(result.len()).to_equal(500)  # oracle: 500 single-char parts must all survive the batch-of-8 recursion — 500 = 62 full batches plus a 4-part tail, exercising both paths

    context "mixed-length segments":
        it "joins segments of varying length":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins segments of varying length")
            expect(join_parts(["hello", " ", "world", "!", " ", "foo"])).to_equal("hello world! foo")

        it "joins with empty segments":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("joins with empty segments")
            expect(join_parts(["a", "", "b", "", "c"])).to_equal("abc")


# ============================================================================
# Test Group 2: to_upper_cmm — fast-path and batch conversion
# ============================================================================

describe "to_upper_cmm":
    """
    ## Case-Insensitive CMM Keyword Matching

    Tests the optimized uppercase conversion that uses a fast-path check
    and array-join for the slow path.
    """

    context "fast path — already uppercase":
        it "returns uppercase string unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns uppercase string unchanged")
            expect(to_upper_cmm("IF")).to_equal("IF")

        it "returns uppercase keyword unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns uppercase keyword unchanged")
            expect(to_upper_cmm("WHILE")).to_equal("WHILE")

        it "returns numbers/symbols unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns numbers/symbols unchanged")
            expect(to_upper_cmm("123_ABC")).to_equal("123_ABC")

    context "conversion cases":
        it "converts lowercase to uppercase":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts lowercase to uppercase")
            expect(to_upper_cmm("if")).to_equal("IF")

        it "converts mixed case":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts mixed case")
            expect(to_upper_cmm("While")).to_equal("WHILE")

        it "converts all lowercase keyword":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts all lowercase keyword")
            expect(to_upper_cmm("repeat")).to_equal("REPEAT")

        it "converts long keyword":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts long keyword")
            expect(to_upper_cmm("globalon")).to_equal("GLOBALON")

        it "converts single char":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts single char")
            expect(to_upper_cmm("a")).to_equal("A")

    context "edge cases":
        it "handles empty string":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("handles empty string")
            expect(to_upper_cmm("")).to_equal("")

        it "preserves underscores and digits":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("preserves underscores and digits")
            expect(to_upper_cmm("my_var_123")).to_equal("MY_VAR_123")

    context "large input — would be slow with O(n²)":
        it "converts 200 lowercase chars":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("converts 200 lowercase chars")
            val input = repeat_char("a", 200)
            val result = to_upper_cmm(input)
            expect(result.len()).to_equal(200)  # oracle: uppercasing 200 chars is 1:1 — the conversion must not grow or shrink the string, only recode it
            expect(result[0:1]).to_equal("A")
            expect(result[199:200]).to_equal("A")


# ============================================================================
# Test Group 3: escape_json — segment-based escaping
# ============================================================================

describe "escape_json":
    """
    ## JSON String Escaping

    Tests the optimized escape_json that uses segment collection instead
    of character-by-character concatenation.
    """

    context "fast path — no special characters":
        it "returns plain string unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns plain string unchanged")
            expect(escape_json("hello world")).to_equal("hello world")

        it "returns empty string unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns empty string unchanged")
            expect(escape_json("")).to_equal("")

        it "returns alphanumeric unchanged":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("returns alphanumeric unchanged")
            expect(escape_json("abc123XYZ")).to_equal("abc123XYZ")

    context "escaping individual special characters":
        it "escapes backslash":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes backslash")
            expect(escape_json("a\\b")).to_equal("a\\\\b")

        it "escapes double quote":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes double quote")
            val input = "say \"hello\""
            val expected = "say \\\"hello\\\""
            expect(escape_json(input)).to_equal(expected)

        it "escapes newline":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes newline")
            expect(escape_json("line1\nline2")).to_equal("line1\\nline2")

        it "escapes carriage return":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes carriage return")
            expect(escape_json("line1\rline2")).to_equal("line1\\rline2")

        it "escapes tab":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes tab")
            expect(escape_json("col1\tcol2")).to_equal("col1\\tcol2")

    context "multiple special characters":
        it "escapes string with multiple specials":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes string with multiple specials")
            expect(escape_json("a\nb\\c\"d")).to_equal("a\\nb\\\\c\\\"d")

        it "escapes only-specials string":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes only-specials string")
            expect(escape_json("\n\t\\")).to_equal("\\n\\t\\\\")

    context "special at boundaries":
        it "escapes special at start":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes special at start")
            expect(escape_json("\nhello")).to_equal("\\nhello")

        it "escapes special at end":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes special at end")
            expect(escape_json("hello\n")).to_equal("hello\\n")

        it "escapes consecutive specials":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes consecutive specials")
            expect(escape_json("\n\n\n")).to_equal("\\n\\n\\n")

    context "large input — would be slow with O(n²)":
        it "escapes 500 chars with scattered specials":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("escapes 500 chars with scattered specials")
            # Build a string with a newline every 50 chars
            var parts: [text] = []
            var i = 0
            while i < 10:
                parts.push(repeat_char("x", 49))
                parts.push("\n")
                i = i + 1
            val input = join_parts(parts)
            val result = escape_json(input)
            # Each \n becomes \\n (2 chars), so result is 10*49 + 10*2 = 510
            expect(result.len()).to_equal(510)  # oracle: 10 lines of 49 literal chars (490) plus 10 newlines each expanding 1->2 (20) = 510 — segment splicing may not lose a boundary segment


# ============================================================================
# Test Group 4: json_array — segment-based array building
# ============================================================================

describe "json_array":
    """
    ## JSON Array Builder

    Tests the optimized json_array that collects segments instead of
    repeatedly concatenating.
    """

    context "basic arrays":
        it "builds empty array":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds empty array")
            expect(json_array([])).to_equal("[]")

        it "builds single-element array":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds single-element array")
            expect(json_array(["1"])).to_equal("[1]")

        it "builds two-element array":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds two-element array")
            expect(json_array(["1", "2"])).to_equal("[1,2]")

        it "builds multi-element array":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds multi-element array")
            expect(json_array(["1", "2", "3", "4"])).to_equal("[1,2,3,4]")

    context "with string values":
        it "builds array of JSON strings":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds array of JSON strings")
            val items = [json_string("a"), json_string("b")]
            expect(json_array(items)).to_equal("[\"a\",\"b\"]")

    context "large array — would be slow with O(n²)":
        it "builds array with 100 elements":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds array with 100 elements")
            var items: [text] = []
            var i = 0
            while i < 100:
                items.push("0")
                i = i + 1
            val result = json_array(items)
            expect(result[0:1]).to_equal("[")
            expect(result[result.len() - 1:result.len()]).to_equal("]")


