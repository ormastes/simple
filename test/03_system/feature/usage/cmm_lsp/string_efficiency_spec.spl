            step("builds single-pair object")
            val pairs = [JsonPair(key: "a", value: "1")]
            expect(json_object(pairs)).to_equal("{\"a\":1}")

        it "builds multi-pair object":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds multi-pair object")
            val pairs = [
                JsonPair(key: "x", value: "1"),
                JsonPair(key: "y", value: "2")
            ]
            expect(json_object(pairs)).to_equal("{\"x\":1,\"y\":2}")

    context "with string values":
        it "builds object with string values":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds object with string values")
            val pairs = [JsonPair(key: "name", value: json_string("test"))]
            expect(json_object(pairs)).to_equal("{\"name\":\"test\"}")

    context "large object — would be slow with O(n²)":
        it "builds object with 50 pairs":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("builds object with 50 pairs")
            var pairs: [JsonPair] = []
            var i = 0
            while i < 50:
                pairs.push(JsonPair(key: "k", value: "0"))
                i = i + 1
            val result = json_object(pairs)
            expect(result[0:1]).to_equal("{")
            expect(result[result.len() - 1:result.len()]).to_equal("}")


# ============================================================================
# Test Group 6: split_lines — line splitting
# ============================================================================

describe "split_lines":
    """
    ## Line Splitting

    Tests the split_lines function used by the lexer.
    """

    context "basic splitting":
        it "splits empty string into one empty line":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits empty string into one empty line")
            val result = split_lines("")
            expect(result.len()).to_equal(1)  # oracle: an empty source is one empty line, not zero lines — the trailing-segment push must fire even with no newline seen
            expect(result[0]).to_equal("")

        it "splits single line without newline":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits single line without newline")
            val result = split_lines("hello")
            expect(result.len()).to_equal(1)  # oracle: text with no newline is a single line — no separator, no split
            expect(result[0]).to_equal("hello")

        it "splits two lines":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits two lines")
            val result = split_lines("line1\nline2")
            expect(result.len()).to_equal(2)  # oracle: one newline separates exactly two lines
            expect(result[0]).to_equal("line1")
            expect(result[1]).to_equal("line2")

        it "splits three lines":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits three lines")
            val result = split_lines("a\nb\nc")
            expect(result.len()).to_equal(3)  # oracle: two separators delimit three lines — the count is separators-plus-one
            expect(result[0]).to_equal("a")
            expect(result[1]).to_equal("b")
            expect(result[2]).to_equal("c")

    context "trailing newline":
        it "splits with trailing newline — produces empty last line":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits with trailing newline — produces empty last line")
            val result = split_lines("hello\n")
            expect(result.len()).to_equal(2)  # oracle: a trailing newline terminates the last line AND starts an empty final line — both segments are pushed
            expect(result[0]).to_equal("hello")
            expect(result[1]).to_equal("")

    context "empty lines":
        it "handles consecutive newlines":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("handles consecutive newlines")
            val result = split_lines("a\n\nb")
            expect(result.len()).to_equal(3)  # oracle: consecutive newlines produce a genuinely empty middle line — dropping it would corrupt line numbering
            expect(result[0]).to_equal("a")
            expect(result[1]).to_equal("")
            expect(result[2]).to_equal("b")

        it "handles only newlines":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("handles only newlines")
            val result = split_lines("\n\n")
            expect(result.len()).to_equal(3)  # oracle: two newlines delimit three empty lines — leading, middle, and trailing segments all push
            expect(result[0]).to_equal("")
            expect(result[1]).to_equal("")
            expect(result[2]).to_equal("")

    context "CMM-like content":
        it "splits typical CMM script":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits typical CMM script")
            val source = "; Setup\nSYStem.CPU CortexM4\nSYStem.Up\n; Done"
            val result = split_lines(source)
            expect(result.len()).to_equal(4)  # oracle: the script body has exactly four lines and no trailing newline, so four segments and nothing more
            expect(result[0]).to_equal("; Setup")
            expect(result[1]).to_equal("SYStem.CPU CortexM4")
            expect(result[2]).to_equal("SYStem.Up")
            expect(result[3]).to_equal("; Done")

    context "large input":
        it "splits 200 lines":
            # @req REQ-FEATURE-StriEffi-001
            # @capture(bit_table): the scenario output retained as checked evidence
            step("splits 200 lines")
            var parts: [text] = []
            var i = 0
            while i < 200:
                parts.push("line")
                i = i + 1
            val source = join_parts_with_sep(parts, "\n")
            val result = split_lines(source)
            expect(result.len()).to_equal(200)  # oracle: 200 newline-joined lines must round-trip to exactly 200 — join-with-separator then split is a lossless inverse at scale

# Helper: join with separator
fn join_parts_with_sep(parts: [text], sep: text) -> text:
    val n = parts.len()
    if n == 0: return ""
    if n == 1: return parts[0]
    var segments: [text] = []
    var i = 0
    while i < n:
        if i > 0:
            segments.push(sep)
        segments.push(parts[i])
        i = i + 1
    join_parts(segments)
