# ============================================================================
# Test Group 16: Real-World CMM Scripts
# ============================================================================

describe "CMM Parser - Real-World Flash Programming":
    it "parses flash setup subroutine":
        step("parses flash setup subroutine using the real CMM parser")
        val source = "; Flash setup\nFlashSetup:\n  LOCAL &FlashSize\n  ENTRY &FlashSize\n  FLASH.RESet\n  FLASH.Create 1. 0x0--0xFFF\n  RETURN\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(3)

    it "parses CPU setup script":
        step("parses CPU setup script using the real CMM parser")
        val source = "; CPU init\n  SYStem.RESet\n  SYStem.CPU ARM\n  SYStem.Up\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("Command")
        expect(program.errors.len()).to_equal(0)

    it "parses script with macro loop":
        step("parses script with macro loop using the real CMM parser")
        val source = "  LOCAL &i\n  &i=0\n  WHILE &i<10\n  (\n    PRINT \"iter: \" &i\n    &i=&i+1\n  )\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LocalDecl")
        expect(program.errors.len()).to_equal(0)

    it "parses script with conditional and subroutine":
        step("parses script with conditional and subroutine using the real CMM parser")
        val source = "  IF &auto_run\n    GOSUB AutoStart\n  ELSE\n    PRINT \"Manual mode\"\n  ENDDO\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("IfElse")
        expect(program.errors.len()).to_equal(0)

    it "parses script with DO call":
        step("parses script with DO call using the real CMM parser")
        val source = "; Main entry\n  DO init.cmm\n  DO flash_program.cmm 0x10000\n  ENDDO\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("DoCall")
        expect(program.errors.len()).to_equal(0)

    it "parses script with file I/O":
        step("parses script with file I/O using the real CMM parser")
        val source = "  OPEN #1 \"results.txt\" /Create\n  WRITE #1 \"Test Results\"\n  WRITE #1 \"Pass: \" &passed\n  CLOSE #1\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("OpenFile")
        expect(program.errors.len()).to_equal(0)

    it "parses script with multiple labels and gotos":
        step("parses script with multiple labels and gotos using the real CMM parser")
        val source = "start:\n  GOTO check\ncheck:\n  IF &done\n    GOTO finish\n  Step\n  GOTO check\nfinish:\n  ENDDO\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(5)

    it "parses data dump and load commands":
        step("parses data dump and load commands using the real CMM parser")
        val source = "  Data.LOAD.auto sieve.elf\n  Data.dump 0x20000000--0x2000FFFF\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("Command")
        expect(program.errors.len()).to_equal(0)

