# Feature CMM-PARSE: executable scenarios import the production parser.
# Historical local parser stubs were removed; every original scenario remains.
use std.spec
use app.cmm_lsp.cmm_parser_source.{parse_cmm_source}
use app.cmm_lsp.cmm_ast.{CmmProgram, CmmStmt}

fn parser_spec_statement_kind(statement: CmmStmt) -> text:
    match statement:
        case CmmStmt.Command(_, _, _): "Command"
        case CmmStmt.DeviceCommand(_, _, _, _): "DeviceCommand"
        case CmmStmt.MacroAssign(_, _, _): "MacroAssign"
        case CmmStmt.MacroRecAssign(_, _, _): "MacroRecAssign"
        case CmmStmt.LabelDef(_, _): "LabelDef"
        case CmmStmt.CommentLine(_, _): "CommentLine"
        case CmmStmt.IfElse(_, _, _, _): "IfElse"
        case CmmStmt.WhileLoop(_, _, _): "WhileLoop"
        case CmmStmt.RepeatLoop(_, _, _): "RepeatLoop"
        case CmmStmt.Goto(_, _): "Goto"
        case CmmStmt.Gosub(_, _, _): "Gosub"
        case CmmStmt.ReturnStmt(_, _): "ReturnStmt"
        case CmmStmt.JumpTo(_, _): "JumpTo"
        case CmmStmt.DoCall(_, _, _): "DoCall"
        case CmmStmt.Enddo(_, _): "Enddo"
        case CmmStmt.RunCall(_, _, _): "RunCall"
        case CmmStmt.EndStmt(_): "EndStmt"
        case CmmStmt.StopStmt(_): "StopStmt"
        case CmmStmt.ContinueCmd(_): "ContinueCmd"
        case CmmStmt.LocalDecl(_, _): "LocalDecl"
        case CmmStmt.GlobalDecl(_, _): "GlobalDecl"
        case CmmStmt.PrivateDecl(_, _): "PrivateDecl"
        case CmmStmt.EntryDecl(_, _): "EntryDecl"
        case CmmStmt.OnEvent(_, _, _): "OnEvent"
        case CmmStmt.GlobalOnEvent(_, _, _): "GlobalOnEvent"
        case CmmStmt.OpenFile(_, _, _, _): "OpenFile"
        case CmmStmt.CloseFile(_, _): "CloseFile"
        case CmmStmt.ReadFile(_, _, _): "ReadFile"
        case CmmStmt.WriteFile(_, _, _): "WriteFile"
        case CmmStmt.WriteBFile(_, _, _): "WriteBFile"
        case CmmStmt.AppendFile(_, _, _): "AppendFile"
        case CmmStmt.PrintStmt(_, _): "PrintStmt"
        case CmmStmt.WaitStmt(_, _): "WaitStmt"
        case CmmStmt.DialogBlock(_, _, _): "DialogBlock"
        case CmmStmt.Block(_, _): "Block"
        case CmmStmt.EmptyLine(_): "EmptyLine"
        case CmmStmt.ErrorNode(_, _): "ErrorNode"

fn parser_spec_first_kind(program: CmmProgram, skip_layout: bool = true) -> text:
    for statement in program.statements:
        val kind = parser_spec_statement_kind(statement)
        if not skip_layout or (kind != "EmptyLine" and kind != "CommentLine"):
            return kind
    ""

# ============================================================================
# Test Group 1: Empty and Comment Inputs
# ============================================================================

describe "CMM Parser - Empty and Comments":
    it "parses empty source":
        step("parses empty source using the real CMM parser")
        val program = parse_cmm_source("")
        expect(program.errors.len()).to_equal(0)

    it "parses single comment line":
        step("parses single comment line using the real CMM parser")
        val program = parse_cmm_source("; a comment\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program, false)).to_equal("CommentLine")
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(0)

    it "parses double-slash comment":
        step("parses double-slash comment using the real CMM parser")
        val program = parse_cmm_source("// double-slash comment\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program, false)).to_equal("CommentLine")
        expect(program.errors.len()).to_equal(0)

    it "parses multiple comment lines":
        step("parses multiple comment lines using the real CMM parser")
        val source = "; comment 1\n; comment 2\n; comment 3\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program, false)).to_equal("CommentLine")
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(2)

    it "parses blank lines":
        step("parses blank lines using the real CMM parser")
        val program = parse_cmm_source("\n\n\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program, false)).to_equal("EmptyLine")
        expect(program.errors.len()).to_equal(0)

# ============================================================================
# Test Group 2: Labels
# ============================================================================

describe "CMM Parser - Labels":
    it "parses simple label":
        step("parses simple label using the real CMM parser")
        val program = parse_cmm_source("start:\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)

    it "parses label with underscore":
        step("parses label with underscore using the real CMM parser")
        val program = parse_cmm_source("_my_label:\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)

    it "parses label with alphanumeric name":
        step("parses label with alphanumeric name using the real CMM parser")
        val program = parse_cmm_source("FlashSetup3:\n")
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)

    it "parses label followed by commands":
        step("parses label followed by commands using the real CMM parser")
        val source = "setup:\n  SYStem.CPU ARM\n"
        val program = parse_cmm_source(source)
        expect(program.statements.len()).to_be_greater_than(0)
        expect(parser_spec_first_kind(program)).to_equal("LabelDef")
        expect(program.errors.len()).to_equal(0)
        expect(program.statements.len()).to_be_greater_than(1)

