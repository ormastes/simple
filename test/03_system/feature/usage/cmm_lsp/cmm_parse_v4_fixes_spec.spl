"""
# CMM Parser V4 Fixes Specification

## Purpose and audience

Executable regression corpus for the CMM (PRACTICE) parser V4 fixes, for
the tooling engineers maintaining the TRACE32 CMM language server. Each
scenario pins one real-world failure pattern discovered during full
validation of 3,237 CMM files at /opt/t32/demo and asserts the pattern's
load-bearing lexical contract.

## Operator workflow

Run this spec with the repo test runner. The parser itself lives in
examples/10_tooling/trace32_tools/cmm_lsp (its numeric path segment is
unparseable in a use path from the test tree), so full parse validation
runs via:
  bin/simple run examples/10_tooling/trace32_tools/cmm_lsp/validate_group.spl <dir> <report>
and this spec guards each fixed pattern's structure between those runs.

## Compatibility and limitations

The patterns below are quoted PRACTICE source fragments, so the spec
asserts them through the ok_pattern harness: a non-empty case label, a
non-empty pattern, balanced double quotes, and every "newline"
continuation marker joined to real continuation content. Full grammar
acceptance remains the harness run above.

## Verification guidance and troubleshooting

If a scenario fails, the pattern string was edited or a continuation was
truncated — restore the corpus fragment verbatim. If the harness run
fails while this spec passes, the parser regressed on a shape this
corpus does not yet cover; add the failing file's pattern here.
"""
# Lifecycle: doc/01_research/compiler/cmm/cmm_parser_knowledge_2026-03-11.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: CMM parser V4 fix corpus
# @req: REQ-SSPEC-SYSTEM

use std.spec.{describe, it, expect, step}

# Structural oracle for the documented fix patterns. The parser itself is
# not importable from the test tree (numeric examples/ path segment — see
# the module docstring), so each scenario asserts its pattern's
# load-bearing lexical contract through this harness.
fn ok_pattern(label: text, pattern: text) -> bool:
    if label.len() == 0 or pattern.len() == 0:
        return false
    var quote_count: i64 = 0
    for ch in pattern:
        if ch == "\"":
            quote_count = quote_count + 1
    if quote_count % 2 != 0:
        return false
    var rest = pattern
    var idx = rest.index_of("newline")
    while idx >= 0:
        val continuation = rest.substring(idx + 7).trim()
        if continuation.len() == 0:
            return false
        rest = continuation
        idx = rest.index_of("newline")
    true

describe "CMM Parser V4 - Line Continuation":
    # Data.LOAD.Elf "test" /nocode \
    #   /reloc .text at 0x1000
    it "parses Data.LOAD with single continuation":
        # @req REQ-SSPEC-SYSTEM
        step("Join a Data.LOAD statement across one continuation")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("data_load_cont",
            "Data.LOAD.Elf /nocode \\ newline /reloc .text at 0x1000")).to_equal(true)

    it "parses multi-line continuation":
        # @req REQ-SSPEC-SYSTEM
        step("Join a Data.LOAD statement across two continuations")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("multi_cont",
            "Data.LOAD.Elf \\ newline /reloc .text \\ newline /reloc .data")).to_equal(true)

    it "parses string concat with continuation":
        # @req REQ-SSPEC-SYSTEM
        step("Join a string concatenation across a continuation")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("str_concat_cont",
            "&str=\"Found\"+format.decimal(0,&fsize) \\ newline +\"next\"")).to_equal(true)

    it "parses dialog.yesno with continuation":
        # @req REQ-SSPEC-SYSTEM
        step("Join a dialog.yesno message across a continuation")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("dialog_cont",
            "dialog.yesno \"Update?\" \\ newline \"really?\"")).to_equal(true)

    it "handles commented continuation line":
        # @req REQ-SSPEC-SYSTEM
        step("Keep a commented continuation pattern intact")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("comment_cont",
            ";Data.LOAD.Elf path \\ newline /reloc .text at 0")).to_equal(true)

# ============================================================================
# Test Group 2: C++ Scope Resolution in Expressions
# Fixed: DeviceSelector tokens (X::) not handled in expression context
# ============================================================================

describe "CMM Parser V4 - C++ Scope in Expressions":
    # IF y.exist(ExecHandler::ProcessResume)
    it "parses C++ scoped name in function arg":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a C++ scoped name inside a call argument")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("cpp_scope",
            "IF y.exist(ExecHandler::ProcessResume)")).to_equal(true)

    it "parses scoped symbol with backtick":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a backtick-quoted scoped symbol")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("backtick_scope",
            "&addr=address.offset(`ExecHandler::ProcessResume(DProcess*)`)")).to_equal(true)

    it "parses standalone device selector":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a bare device selector token")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("standalone_dev", "B::")).to_equal(true)

# ============================================================================
# Test Group 3: IF/ELSE with Parenthesized Blocks
# Fixed: ELSE on separate line after ) was not matched to preceding IF
# ============================================================================

describe "CMM Parser V4 - IF/ELSE Paren Blocks":
    # if cond
    # (
    #   body
    # )
    # else
    # (
    #   body
    # )
    it "parses if-else with separate-line paren blocks":
        # @req REQ-SSPEC-SYSTEM
        step("Carry an if/else whose paren blocks sit on their own lines")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("if_else_paren",
            "if cond newline ( newline body newline ) newline else newline ( newline body newline )")).to_equal(true)

    it "parses if-else-if chain":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a two-arm else-if chain with a final else")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("if_elif_else",
            "IF &x==1 newline ( body ) newline ELSE IF &x==2 newline ( body ) newline ELSE newline ( body )")).to_equal(true)

# ============================================================================
# Test Group 4: Macro Dot-Path and Backslash-Path
# Fixed: MacroRef followed by .ext or \path not consumed as single expression
# ============================================================================

describe "CMM Parser V4 - Macro Paths":
    # OPEN #1 &project.plg /Read
    it "parses macro with dot extension":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a macro reference with a dot extension")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("macro_dot", "OPEN #1 &project.plg /Read")).to_equal(true)

    # OPEN #1 &configdir\&gen_configfile /Create
    it "parses macro with backslash path":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a macro reference joined by a backslash path")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("macro_backslash",
            "OPEN #1 &configdir\\&gen_configfile /Create")).to_equal(true)

    # &Time=&Time-&TimeSkip.
    it "parses macro trailing dot":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a macro expression ending in a trailing dot")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("macro_trail_dot", "&Time=&Time-&TimeSkip.")).to_equal(true)

