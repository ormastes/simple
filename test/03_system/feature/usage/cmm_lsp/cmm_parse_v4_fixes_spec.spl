# ============================================================================

describe "CMM Parser V4 - Question Marks":
    # &patchloc1=0x0e60 ???
    it "parses triple question mark after assignment":
        # @req REQ-SSPEC-SYSTEM
        step("Carry a triple question-mark wildcard after an assignment")
        # @capture(bit_table): pattern verdict per parser-fix case retained
        expect(ok_pattern("triple_qmark", "&patchloc1=0x0e60 ???")).to_equal(true)

