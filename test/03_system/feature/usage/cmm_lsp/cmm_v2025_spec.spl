"""
## Purpose and audience
Purpose: config_for_version recognizes 2025
Audience: compiler and tooling engineers who maintain this spec

# CMM v2025 Version Support

**Category:** Tooling
**Status:** In Progress

## Overview

Tests for CMM v2025 version support and command database updates.
"""

# @req: REQ-FEATURE-CmmV202-001

# Tests for CMM v2025 version support and command database updates

# use cmm_version.{CmmVersion, CmmParserConfig, default_config, config_for_version, has_feature, version_name}
# use cmm_commands.{build_command_db, lookup_command, get_completions, get_group_commands}
# use cmm_parser_runtime.{parse_cmm_source}
# use cmm_analyzer.{analyze_program_with_config}

use std.spec.{describe, it, expect}

# ---------------------------------------------------------------------------
# Version enum tests
# ---------------------------------------------------------------------------

use std.spec.step
describe "CmmVersion V2025", tag: ["only-compiled"]:
    it "config_for_version recognizes 2025":
        step("Verify: config_for_version recognizes 2025")
        # @req: REQ-FEATURE-CmmV202-001
        val cfg = config_for_version("2025")
        expect(version_name(cfg.version)).to_equal("2025")

    it "V2025 has all features":
        step("Verify: V2025 has all features")
        # @req: REQ-FEATURE-CmmV202-001
        val cfg = config_for_version("2025")
        expect(has_feature(cfg, "GLOBALON")).to_equal(true)
        expect(has_feature(cfg, "PRIVATE")).to_equal(true)
        expect(has_feature(cfg, "WRITEB")).to_equal(true)
        expect(has_feature(cfg, "LUA")).to_equal(true)
        expect(has_feature(cfg, "OBJAPI")).to_equal(true)
        expect(has_feature(cfg, "I2C")).to_equal(true)

    it "V2013 does not have V2025 features":
        step("Verify: V2013 does not have V2025 features")
        # @req: REQ-FEATURE-CmmV202-001
        val cfg = config_for_version("2013")
        expect(has_feature(cfg, "LUA")).to_equal(false)
        expect(has_feature(cfg, "OBJAPI")).to_equal(false)
        expect(has_feature(cfg, "I2C")).to_equal(false)

    it "V2012 does not have V2025 or V2013 features":
        step("Verify: V2012 does not have V2025 or V2013 features")
        # @req: REQ-FEATURE-CmmV202-001
        val cfg = config_for_version("2012")
        expect(has_feature(cfg, "GLOBALON")).to_equal(false)
        expect(has_feature(cfg, "LUA")).to_equal(false)
        expect(has_feature(cfg, "I2C")).to_equal(false)

    it "Latest has all features":
        step("Verify: Latest has all features")
        # @req: REQ-FEATURE-CmmV202-001
        val cfg = default_config()
        expect(has_feature(cfg, "LUA")).to_equal(true)
        expect(has_feature(cfg, "OBJAPI")).to_equal(true)

# ---------------------------------------------------------------------------
# Command database tests
# ---------------------------------------------------------------------------

describe "CMM v2025 commands in DB", tag: ["only-compiled"]:
    it "Lua commands are in database":
        step("Verify: Lua commands are in database")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val cmd = lookup_command(db, "LUA.RUN")
        expect(cmd == nil).to_equal(false)

    it "I2C commands are in database":
        step("Verify: I2C commands are in database")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val cmd = lookup_command(db, "I2C.Read")
        expect(cmd == nil).to_equal(false)

    it "Object API commands are in database":
        step("Verify: Object API commands are in database")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val cmd = lookup_command(db, "Obj.Buffer.Create")
        expect(cmd == nil).to_equal(false)

    it "API lock commands are in database":
        step("Verify: API lock commands are in database")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val cmd = lookup_command(db, "API.LOCK")
        expect(cmd == nil).to_equal(false)

    it "Lua commands have min_version 2025":
        step("Verify: Lua commands have min_version 2025")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val cmd = lookup_command(db, "LUA.RUN")
        if cmd.?:
            val c = cmd.unwrap()
            expect(c.min_version).to_equal("2025")

    it "Lua group has multiple commands":
        step("Verify: Lua group has multiple commands")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val lua_cmds = get_group_commands(db, "Lua")
        expect(lua_cmds.len()).to_be_greater_than(3)

    it "ObjectAPI group has multiple commands":
        step("Verify: ObjectAPI group has multiple commands")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val obj_cmds = get_group_commands(db, "ObjectAPI")
        expect(obj_cmds.len()).to_be_greater_than(5)

    it "completion suggests Lua commands":
        step("Verify: completion suggests Lua commands")
        # @req: REQ-FEATURE-CmmV202-001
        val db = build_command_db()
        val matches = get_completions(db, "LUA.")
        expect(matches.len()).to_be_greater_than(0)

# ---------------------------------------------------------------------------
# Parser integration tests
# ---------------------------------------------------------------------------

describe "CMM v2025 parsing", tag: ["only-compiled"]:
    it "parses Lua commands without errors":
        step("Verify: parses Lua commands without errors")
        # @req: REQ-FEATURE-CmmV202-001
        val source = "LUA.RUN \"test.lua\"\nENDDO"
        val program = parse_cmm_source(source, "<test>")
        expect(program.errors.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "parses Object API commands":
        step("Verify: parses Object API commands")
        # @req: REQ-FEATURE-CmmV202-001
        val source = "Obj.Buffer.Create mybuf 1024.\nENDDO"
        val program = parse_cmm_source(source, "<test>")
        expect(program.errors.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "parses I2C commands":
        step("Verify: parses I2C commands")
        # @req: REQ-FEATURE-CmmV202-001
        val source = "I2C.Read 0x50 0x00 8.\nENDDO"
        val program = parse_cmm_source(source, "<test>")
        expect(program.errors.len()).to_equal(0)  # oracle: value fixed by the spec contract
