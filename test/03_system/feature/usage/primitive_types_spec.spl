"""
## Purpose and audience
Covers the type system surface for the language team: enum comparison and
matching, union-typed parameters, type aliases, optional parameters, generic
functions and structs, Option operations, numeric type suffixes and unit
literals, and @strong exhaustive enum matching.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/primitive_types_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Type-based pattern matching on
union types is not yet implemented, so only the union-parameter acceptance
path is exercised. Unit-typed values expose their magnitude via .value().
## Verification guidance and troubleshooting
A failing scenario names the type feature that broke. If the file fails to
load at all, a type grammar rule stopped parsing and every scenario in this
file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: primitive-type-features

describe "Enum Types":
    it "compares enum variants":
        # @req REQ-TYPES-PRIM-001
        # @capture(bit_table): enum variant comparison arm selection
        step("Take the Green variant and branch on a Red comparison")
        enum Color:
            Red
            Green
        val c = Color.Green
        var result = 0
        if c == Color.Red:
            result = 1
        else:
            result = 0
        expect(result).to_equal(0)  # oracle: Green must not equal Red, so the else arm runs

describe "Union Types":
    it "accepts union type parameter":
        # @req REQ-TYPES-PRIM-002
        # @capture(bit_table): union-typed parameter call result
        step("Call a function whose parameter is a union type")
        fn test(x: i64 | str) -> i64:
            return 42
        expect(test(10)).to_equal(42)  # oracle: the union signature accepts 10 and returns 42

describe "Type Aliases":
    it "uses simple type alias":
        # @req REQ-TYPES-PRIM-003
        # @capture(bit_table): alias-typed function result
        step("Alias Number to i64 and run a doubling function over it")
        type Number = i64
        fn double(x: Number) -> Number:
            return x * 2
        expect(double(21)).to_equal(42)  # oracle: the alias-typed call doubles 21

describe "Optional Types":
    it "accepts optional parameter":
        # @req REQ-TYPES-PRIM-004
        # @capture(bit_table): optional-typed parameter call result
        step("Call a function whose parameter is an optional type")
        fn maybe_value(x: i64?) -> i64:
            return 5
        expect(maybe_value(10)).to_equal(5)  # oracle: the optional signature accepts 10 and returns 5

describe "Generic Functions":
    it "defines identity function":
        # @req REQ-TYPES-PRIM-005
        # @capture(bit_table): generic identity instantiation result
        step("Instantiate identity at i64 and call it")
        fn identity<T>(x: T) -> T:
            return x
        expect(identity(42)).to_equal(42)  # oracle: identity returns its argument unchanged

    it "uses two type parameters":
        # @req REQ-TYPES-PRIM-006
        # @capture(bit_table): two-parameter generic selections
        step("Select the first and second arguments through two generic functions")
        fn first<A, B>(a: A, b: B) -> A:
            return a
        fn second<A, B>(a: A, b: B) -> B:
            return b
        val x = first(10, 20)
        val y = second(30, 40)
        expect(x + y).to_equal(50)  # oracle: first picks 10 and second picks 40

describe "Generic Structs":
    it "creates generic struct":
        # @req REQ-TYPES-PRIM-007
        # @capture(bit_table): generic struct field round-trip
        step("Declare Box<T>, construct it, read the field")
        struct Box<T>:
            value: T
        val b = Box { value: 42 }
        expect(b.value).to_equal(42)  # oracle: the generic field stores the constructed 42

describe "Option Type Operations":
    it "unwraps Some value":
        # @req REQ-TYPES-PRIM-008
        # @capture(bit_table): Some unwrap result
        step("Unwrap a Some value")
        val opt = Some(42)
        expect(opt.unwrap()).to_equal(42)  # oracle: unwrap returns the contained 42

    it "unwraps None with default":
        # @req REQ-TYPES-PRIM-009
        # @capture(bit_table): None unwrap_or default
        step("Apply unwrap_or to a None value")
        val opt = None
        expect(opt.unwrap_or(99)).to_equal(99)  # oracle: None falls back to the default 99

    it "checks is_some":
        # @req REQ-TYPES-PRIM-010
        # @capture(bit_table): is_some predicate branch
        step("Branch on is_some for a Some value")
        val opt = Some(1)
        var result = 0
        if opt.is_some():
            result = 1
        expect(result).to_equal(1)  # oracle: is_some holds for Some(1)

    it "checks is_none":
        # @req REQ-TYPES-PRIM-011
        # @capture(bit_table): is_none predicate branch
        step("Branch on is_none for a None value")
        val opt = None
        var result = 0
        if opt.is_none():
            result = 1
        expect(result).to_equal(1)  # oracle: is_none holds for None

    it "maps Some value":
        # @req REQ-TYPES-PRIM-012
        # @capture(bit_table): Option map then unwrap result
        step("Double a contained value with map and unwrap")
        val opt = Some(10)
        val res = opt.map(_1 * 2)
        expect(res.unwrap()).to_equal(20)  # oracle: map doubles 10 inside the Option

describe "Type Suffixes":
    it "uses i32 suffix":
        # @req REQ-TYPES-PRIM-013
        # @capture(bit_table): i32-suffixed literal round-trip
        step("Bind an i32-suffixed literal and read it back")
        val x = 42i32
        expect(x).to_equal(42)  # oracle: the suffixed literal holds 42

    it "uses i64 suffix":
        # @req REQ-TYPES-PRIM-014
        # @capture(bit_table): i64-suffixed literal round-trip
        step("Bind an i64-suffixed literal and read it back")
        val x = 100i64
        expect(x).to_equal(100)  # oracle: the suffixed literal holds 100

    it "uses u32 suffix":
        # @req REQ-TYPES-PRIM-015
        # @capture(bit_table): u32-suffixed literal round-trip
        step("Bind a u32-suffixed literal and read it back")
        val x = 255u32
        expect(x).to_equal(255)  # oracle: the suffixed literal holds 255

    it "uses unit suffix km":
        # @req REQ-TYPES-PRIM-016
        # @capture(bit_table): unit-typed literal magnitude
        step("Bind a kilometre unit literal and read its magnitude")
        val distance = 100_km
        expect(distance.value()).to_equal(100)  # oracle: the unit literal carries magnitude 100

    it "uses unit suffix in expression":
        # @req REQ-TYPES-PRIM-017
        # @capture(bit_table): unit-typed addition magnitude
        step("Add two metre unit literals and read the magnitude")
        val a = 50_m
        val b = 30_m
        expect((a + b).value()).to_equal(80)  # oracle: 50m plus 30m is 80m

    it "uses f64 suffix":
        # @req REQ-TYPES-PRIM-018
        # @capture(bit_table): f64-suffixed literal comparison
        step("Bind an f64-suffixed literal and compare it")
        val x = 3.15f64
        expect(x > 3.0).to_equal(true)  # oracle: the parsed literal is strictly above 3.0

    it "uses f32 suffix":
        # @req REQ-TYPES-PRIM-019
        # @capture(bit_table): f32-suffixed literal comparison
        step("Bind an f32-suffixed literal and compare it")
        val x = 1.5f32
        expect(x > 1.0).to_equal(true)  # oracle: the parsed literal is strictly above 1.0

describe "Strong Enums":
    it "matches exhaustively without wildcard":
        # @req REQ-TYPES-PRIM-020
        # @capture(bit_table): @strong exhaustive match arm selection
        step("Match every variant of a @strong enum with no wildcard")
        @strong
        enum Status:
            Active
            Inactive
            Waiting
        val s = Status.Active
        var r = 0
        match s:
            case Status.Active:
                r = 1
            case Status.Inactive:
                r = 2
            case Status.Waiting:
                r = 3
        expect(r).to_equal(1)  # oracle: the Active arm sets 1

    it "allows wildcard in weak enum":
        # @req REQ-TYPES-PRIM-021
        # @capture(bit_table): weak enum wildcard arm selection
        step("Match a plain enum using a wildcard arm")
        enum Status:
            Active
            Inactive
            Waiting
        val s = Status.Active
        var result = 0
        match s:
            case Status.Active:
                result = 1
            case _:
                result = 0
        expect(result).to_equal(1)  # oracle: the Active arm sets 1
