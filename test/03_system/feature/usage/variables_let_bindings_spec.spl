"""
## Purpose and audience
Executable checks of variable binding for the language team: val (immutable)
and var (mutable) declarations, shadowing, expression-valued bindings, block
and loop scoping, tuple destructuring, type inference over primitives, the
global len() helper, and Option-typed bindings.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/variables_let_bindings_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. The interpreter leaks if/for
block scopes, so the scoping scenarios isolate shadowing and loop variables
inside module-level functions; `let` remains a deprecated alias for `val`.
## Verification guidance and troubleshooting
A failing scenario names the binding behavior that broke. If the file fails
to load at all, a declaration grammar rule stopped parsing and every scenario
in this file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: variable-binding-rules

# Module-level helpers for scope-isolation tests.
# Function scopes are isolated in the interpreter, unlike if/for block scopes.

fn shadow_x() -> i64:
    val x = 2
    x

fn loop_sum_0_to_4() -> i64:
    var sum = 0
    for i in 0..5:
        sum = sum + i
    sum

describe "Variables and Bindings":
    context "val bindings":
        it "creates immutable binding":
            # @req REQ-VARS-BIND-001
            # @capture(bit_table): immutable binding of composed value
            step("Bind 6*7 immutably and read it back")
            val x = 6 * 7
            expect(x).to_equal(42)  # oracle: the binding holds the evaluated 42

        it "allows shadowing with new val":
            # @req REQ-VARS-BIND-002
            # @capture(bit_table): shadowed binding value
            step("Shadow x with a fresh val and read the newest binding")
            val x = 1
            val x = 1 + 1
            expect(x).to_equal(2)  # oracle: the shadowing binding is the observed value

        it "binds expression results":
            # @req REQ-VARS-BIND-003
            # @capture(bit_table): precedence-honoring expression result
            step("Bind 10+20*2 and read the precedence-correct result")
            val result = 10 + 20 * 2
            expect(result).to_equal(50)  # oracle: multiplication binds before addition

        it "binds complex expressions":
            # @req REQ-VARS-BIND-004
            # @capture(bit_table): parenthesized arithmetic result
            step("Bind (5+3)*4-10/2 and read the result")
            val result = (5 + 3) * 4 - 10 / 2
            expect(result).to_equal(27)  # oracle: parens then precedence give 27

    context "var bindings":
        it "creates mutable binding":
            # @req REQ-VARS-BIND-005
            # @capture(bit_table): reassigned binding value
            step("Declare var, reassign once, read it back")
            var x = 0
            x = 10
            expect(x).to_equal(10)  # oracle: the reassignment is the observed state

        it "allows multiple reassignments":
            # @req REQ-VARS-BIND-006
            # @capture(bit_table): thrice-assigned binding value
            step("Declare var and reassign it twice")
            var x = 1
            x = 2
            x = 3
            expect(x).to_equal(3)  # oracle: the last reassignment is the observed state

describe "Scoping and Nesting":
    context "nested scopes":
        it "inner scope shadows outer":
            # @req REQ-VARS-BIND-007
            # @capture(bit_table): isolated shadow result beside outer value
            step("Read the shadowed value from a function scope and the outer value after")
            val x = 1
            val inner_x = shadow_x()
            expect(inner_x).to_equal(2)  # oracle: the function-local x shadows to 2
            expect(x == 1).to_equal(true)  # oracle: the outer x is untouched

        it "inner scope can read outer":
            # @req REQ-VARS-BIND-008
            # @capture(bit_table): outer read from inner block
            step("Read an outer binding inside an if block")
            val x = 10
            var result = 0
            if true:
                result = x + 5
            expect(result).to_equal(15)  # oracle: the inner block read the outer 10

    context "loop scoping":
        it "loop variable isolated to loop":
            # @req REQ-VARS-BIND-009
            # @capture(bit_table): loop isolation sum beside outer value
            step("Sum 0..4 inside an isolated function scope")
            val i = 100
            val sum = loop_sum_0_to_4()
            expect(i == 100).to_equal(true)  # oracle: the outer i is untouched by the loop
            expect(sum).to_equal(10)  # oracle: 0+1+2+3+4 accumulates to 10

describe "Additional val/var Patterns":
    context "val with different types":
        it "creates immutable boolean":
            # @req REQ-VARS-BIND-010
            # @capture(bit_table): boolean binding of comparison
            step("Bind a comparison result immutably and read it back")
            val flag = 1 == 1
            expect(flag).to_equal(true)  # oracle: the binding holds the evaluated truth

        it "creates immutable float":
            # @req REQ-VARS-BIND-011
            # @capture(bit_table): float binding bound in range
            step("Bind 3.14 and bound it above 3")
            val pi = 3.14
            expect(pi).to_be_greater_than(3.0)  # oracle: the float literal is strictly above 3

    context "var initialization patterns":
        it "initializes var with expression":
            # @req REQ-VARS-BIND-012
            # @capture(bit_table): expression-initialized then reassigned var
            step("Initialize var from 5*2, add 10, read it")
            var x = 5 * 2
            x = x + 10
            expect(x).to_equal(20)  # oracle: 10 then +10 gives 20

        it "modifies var in loop":
            # @req REQ-VARS-BIND-013
            # @capture(bit_table): loop-accumulated var
            step("Accumulate 1..3 into a var in a loop")
            var sum = 0
            for i in 1..4:
                sum = sum + i
            expect(sum).to_equal(6)  # oracle: 1+2+3 accumulates to 6

describe "Tuple Destructuring Bindings":
    context "var with tuples":
        it "destructures tuple into mutable bindings":
            # @req REQ-VARS-BIND-014
            # @capture(bit_table): destructured then reassigned pair
            step("Destructure a tuple into vars, reassign both, sum them")
            var (a, b) = (1, 2)
            a = 10
            b = 20
            expect(a + b).to_equal(30)  # oracle: the reassigned pair sums to 30

    context "val with tuples":
        it "destructures tuple into immutable bindings":
            # @req REQ-VARS-BIND-015
            # @capture(bit_table): destructured immutable pair
            step("Destructure a tuple into vals and sum them")
            val (x, y) = (3, 4)
            expect(x + y).to_equal(7)  # oracle: the destructured pair sums to 7

describe "Type Inference":
    context "primitive type inference":
        it "infers integer type":
            # @req REQ-VARS-BIND-016
            # @capture(bit_table): inferred-integer arithmetic
            step("Bind a literal integer and use it in integer arithmetic")
            val x = 42
            expect(x + 8).to_equal(50)  # oracle: the inferred integer adds to 50

        it "infers string type":
            # @req REQ-VARS-BIND-017
            # @capture(bit_table): inferred-string length
            step("Bind a text literal and read its length")
            val s = "hello"
            expect(s.len()).to_equal(5)  # oracle: the inferred text has five characters

        it "infers array type":
            # @req REQ-VARS-BIND-018
            # @capture(bit_table): inferred-array length
            step("Bind an array literal and read its length")
            val arr = [1, 2, 3]
            expect(arr.len()).to_equal(3)  # oracle: the inferred array holds three elements

describe "Global Functions with Bindings":
    context "len function":
        it "gets length of array":
            # @req REQ-VARS-BIND-019
            # @capture(bit_table): global len result
            step("Measure a five-element array with the global len()")
            val arr = [1, 2, 3, 4, 5]
            expect(len(arr)).to_equal(5)  # oracle: the global helper counts five elements

        it "gets length using method syntax":
            # @req REQ-VARS-BIND-020
            # @capture(bit_table): method-syntax len result
            step("Measure a three-element array with method len()")
            val arr = [1, 2, 3]
            expect(arr.len()).to_equal(3)  # oracle: the method form counts three elements

describe "Option Type Bindings":
    context "Some bindings":
        it "binds Some value":
            # @req REQ-VARS-BIND-021
            # @capture(bit_table): Some binding presence
            step("Bind a Some value and check its presence")
            val opt: Option<i64> = Some(42)
            assert_true(opt.?)  # oracle: the Some binding is present

        it "unwraps Some value":
            # @req REQ-VARS-BIND-022
            # @capture(bit_table): Some unwrap result
            step("Bind a Some value and unwrap it")
            val opt: Option<i64> = Some(99)
            expect(opt.unwrap()).to_equal(99)  # oracle: unwrap returns the contained 99

    context "None bindings":
        it "binds None value":
            # @req REQ-VARS-BIND-023
            # @capture(bit_table): None binding absence
            step("Bind None and check its absence")
            val opt: Option<i64> = None
            assert_true(not opt.?)  # oracle: the None binding is absent
