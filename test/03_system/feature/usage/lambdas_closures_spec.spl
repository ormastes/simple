# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Lambdas and Closures Specification


**Feature IDs:** #2300
**Category:** Language
**Status:** Implemented

Lambdas (anonymous functions) and closures enable functional programming patterns.

## Key Concepts

| Concept | Description |
|---------|-------------|
| Lambda | Anonymous function defined inline with `\` syntax |
| Closure | Function that captures variables from enclosing scope |
| Higher-Order Function | Function taking or returning other functions |
"""



# ============================================================================
# Test Group 1: Basic Lambdas
# ============================================================================

use std.spec.step

describe "Basic Lambdas":
    # @manual scenario evidence
    # ## Basic Lambda Definition
    #
    # Tests simple lambda creation and invocation.

    it "creates simple lambda":
        # @req REQ-SSPEC-SYSTEM
        step("creates simple lambda")
        val double = \x: x * 2
        expect(double(21)).to_equal(42)

    it "creates lambda with multiple params":
        # @req REQ-SSPEC-SYSTEM
        step("creates lambda with multiple params")
        val add = \x, y: x + y
        expect(add(15, 27)).to_equal(42)

    it "creates lambda with no params":
        # @req REQ-SSPEC-SYSTEM
        step("creates lambda with no params")
        val answer = \: 42
        expect(answer()).to_equal(42)

    it "invokes lambda immediately":
        # @req REQ-SSPEC-SYSTEM
        step("invokes lambda immediately")
        val result = (\x: x + 5)(37)
        expect(result).to_equal(42)


# ============================================================================
# Test Group 2: Closures
# ============================================================================

describe "Closures":
    # ## Closure Variable Capture
    #
    # Tests closures capturing variables from outer scope.

    it "captures outer variable":
        # @req REQ-SSPEC-SYSTEM
        step("captures outer variable")
        val multiplier = 10
        val multiply = \x: x * multiplier
        expect(multiply(4)).to_equal(40)

    it "captures multiple variables":
        # @req REQ-SSPEC-SYSTEM
        step("captures multiple variables")
        val a = 10
        val b = 5
        val calc = \x: x * a + b
        expect(calc(3)).to_equal(35)

    it "nested lambda calls":
        # @req REQ-SSPEC-SYSTEM
        step("nested lambda calls")
        val double = \x: x * 2
        val add_one = \x: x + 1
        expect(add_one(double(20))).to_equal(41)


# ============================================================================
# Test Group 3: Lambdas with Collections
# ============================================================================

describe "Lambdas with Collections":
    # ## Higher-Order Functions
    #
    # Tests lambdas with collection methods.

    it "maps with lambda":
        # @req REQ-SSPEC-SYSTEM
        step("maps with lambda")
        val numbers = [1, 2, 3]
        val doubled = numbers.map(_ * 2)
        expect(doubled[0]).to_equal(2)
        expect(doubled[1]).to_equal(4)
        expect(doubled[2]).to_equal(6)

    it "filters with lambda":
        # @req REQ-SSPEC-SYSTEM
        step("filters with lambda")
        val numbers = [1, 2, 3, 4, 5, 6]
        val evens = numbers.filter(_ % 2 == 0)
        expect(evens.len()).to_equal(3)

    it "reduces with lambda":
        # @req REQ-SSPEC-SYSTEM
        step("reduces with lambda")
        val numbers = [1, 2, 3, 4]
        val sum = numbers.reduce(0, \acc, x: acc + x)
        expect(sum).to_equal(10)


# ============================================================================
# Test Group 4: Lambda Edge Cases
# ============================================================================

describe "Lambda Edge Cases":
    # ## Special Cases
    #
    # Tests edge cases for lambda behavior.

    it "lambda returning lambda":
        # @req REQ-SSPEC-SYSTEM
        step("lambda returning lambda")
        fn make_adder(n):
            return \x: x + n
        val add_five = make_adder(5)
        expect(add_five(10)).to_equal(15)

    it "lambda as function parameter":
        # @req REQ-SSPEC-SYSTEM
        step("lambda as function parameter")
        fn apply(f, x):
            return f(x)
        expect(apply(\x: x * 2, 21)).to_equal(42)

    it "lambda with conditional":
        # @req REQ-SSPEC-SYSTEM
        step("lambda with conditional")
        val abs = \x: if x < 0: -x else: x
        expect(abs(-5)).to_equal(5)
        expect(abs(5)).to_equal(5)
