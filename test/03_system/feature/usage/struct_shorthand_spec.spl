# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Struct Field Shorthand Specification

**Feature IDs:** #STRUCT-SHORTHAND
**Category:** Syntax
**Status:** Implemented

Struct field shorthand allows omitting the field name when the variable name
matches. This reduces boilerplate when constructing structs from local variables.

## Syntax

```simple
# Without shorthand (verbose)
use std.spec.step

val point = Point(x: x, y: y)

# With shorthand (when variable names match field names)
val point = Point(x, y)

# Mixed shorthand and explicit
val point = Point(x, y: computed_y)
```

## Key Behaviors

- Variable name must exactly match the field name
- Order must match the struct definition
- Can mix shorthand and explicit field names
- Works with any struct type
"""

describe "Struct Field Shorthand":
    # @manual scenario evidence
    # ## Struct Construction Shorthand Specification
    #
    # Struct shorthand syntax reduces verbosity when constructing structs from
    # variables with matching names. This test suite verifies:
    # - Basic shorthand when variable matches field name
    # - Mixed shorthand and explicit field syntax
    # - Shorthand with different field types
    # - Interaction with nested structs
    # - Error cases (mismatched names still require explicit syntax)

    context "basic struct shorthand":
        it "uses shorthand for matching variable names":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand for matching variable names")
            struct Point:
                x: i64
                y: i64
            val x = 10
            val y = 20
            val point = Point(x, y)
            expect(point.x).to_equal(10)
            expect(point.y).to_equal(20)

        it "constructs struct with all shorthand fields":
            # @req REQ-SSPEC-SYSTEM
            step("constructs struct with all shorthand fields")
            struct Person:
                name: text
                age: i64
            val name = "Alice"
            val age = 30
            val person = Person(name, age)
            expect(person.name).to_equal("Alice")
            expect(person.age).to_equal(30)

    context "mixed shorthand and explicit":
        it "mixes shorthand with explicit named argument":
            # @req REQ-SSPEC-SYSTEM
            step("mixes shorthand with explicit named argument")
            struct Point:
                x: i64
                y: i64
            val x = 10
            val point = Point(x, y: 20)
            expect(point.x).to_equal(10)
            expect(point.y).to_equal(20)

        it "uses explicit then shorthand":
            # @req REQ-SSPEC-SYSTEM
            step("uses explicit then shorthand")
            struct Point:
                x: i64
                y: i64
            val y = 20
            val point = Point(x: 10, y)
            expect(point.x).to_equal(10)
            expect(point.y).to_equal(20)

        it "mixes in complex struct":
            # @req REQ-SSPEC-SYSTEM
            step("mixes in complex struct")
            struct Config:
                host: text
                port: i64
                timeout: i64
            val host = "localhost"
            val timeout = 30
            val config = Config(host, port: 8080, timeout)
            expect(config.host).to_equal("localhost")
            expect(config.port).to_equal(8080)
            expect(config.timeout).to_equal(30)

    context "shorthand with computed values":
        it "uses shorthand after computation":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand after computation")
            struct Rectangle:
                width: i64
                height: i64
            val width = 5 * 2
            val height = 3 * 2
            val rect = Rectangle(width, height)
            expect(rect.width).to_equal(10)
            expect(rect.height).to_equal(6)

        it "uses shorthand from function return":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand from function return")
            struct Point:
                x: i64
                y: i64
            fn get_x() -> i64:
                100
            fn get_y() -> i64:
                200
            val x = get_x()
            val y = get_y()
            val point = Point(x, y)
            expect(point.x).to_equal(100)
            expect(point.y).to_equal(200)

    context "shorthand with different types":
        it "handles text fields":
            # @req REQ-SSPEC-SYSTEM
            step("handles text fields")
            struct Message:
                sender: text
                content: text
            val sender = "Alice"
            val content = "Hello!"
            val msg = Message(sender, content)
            expect(msg.sender).to_equal("Alice")
            expect(msg.content).to_equal("Hello!")

        it "handles boolean fields":
            # @req REQ-SSPEC-SYSTEM
            step("handles boolean fields")
            struct Flags:
                enabled: bool
                visible: bool
            val enabled = true
            val visible = false
            val flags = Flags(enabled, visible)
            expect(flags.enabled).to_equal(true)
            expect(flags.visible).to_equal(false)

        it "handles mixed types":
            # @req REQ-SSPEC-SYSTEM
            step("handles mixed types")
            struct Record:
                id: i64
                name: text
                active: bool
            val id = 42
            val name = "Test"
            val active = true
            val record = Record(id, name, active)
            expect(record.id).to_equal(42)
            expect(record.name).to_equal("Test")
            expect(record.active).to_equal(true)

    context "shorthand in nested structs":
        it "uses shorthand when nesting":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand when nesting")
            struct Point:
                x: i64
                y: i64
            struct Line:
                start: Point
                endpoint: Point
            val x = 0
            val y = 0
            val start = Point(x, y)
            val x2 = 10
            val y2 = 10
            val endpoint = Point(x: x2, y: y2)
            val line = Line(start, endpoint)
            expect(line.start.x).to_equal(0)
            expect(line.endpoint.x).to_equal(10)

    context "explicit syntax still works":
        it "allows fully explicit construction":
            # @req REQ-SSPEC-SYSTEM
            step("allows fully explicit construction")
            struct Point:
                x: i64
                y: i64
            val a = 100
            val b = 200
            val point = Point(x: a, y: b)
            expect(point.x).to_equal(100)
            expect(point.y).to_equal(200)

        it "allows equals syntax explicitly":
            # @req REQ-SSPEC-SYSTEM
            step("allows equals syntax explicitly")
            struct Point:
                x: i64
                y: i64
            val point = Point(x=30, y=40)
            expect(point.x).to_equal(30)
            expect(point.y).to_equal(40)

    context "shorthand in collections":
        it "uses shorthand in list of structs":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand in list of structs")
            struct Point:
                x: i64
                y: i64
            var points: [Point] = []
            for i in 0..3:
                val x = i * 10
                val y = i * 20
                points = points.append(Point(x, y))
            expect(points[0].x).to_equal(0)
            expect(points[1].x).to_equal(10)
            expect(points[2].x).to_equal(20)

        it "uses shorthand with map":
            # @req REQ-SSPEC-SYSTEM
            step("uses shorthand with map")
            struct Point:
                x: i64
                y: i64
            # Build points manually since multi-line lambda with destructuring
            # is not supported in interpreter mode
            val x1 = 1
            val y1 = 2
            val x2 = 3
            val y2 = 4
            val points = [Point(x: x1, y: y1), Point(x: x2, y: y2)]
            expect(points[0].x).to_equal(1)
            expect(points[1].y).to_equal(4)
