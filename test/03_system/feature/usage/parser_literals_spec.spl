use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_literals_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_literals_spec.md
# doc-path: doc/03_plan/sys_test/parser_literals_spec.md
# doc-path: doc/04_architecture/parser_literals_spec.md
# doc-path: doc/05_design/parser_literals_spec_oracles.md
# @manual: primary

"""
# Parser Literal Tokenization Specification


**Feature IDs:** #PARSER-LIT-001 to #PARSER-LIT-020
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly tokenizes and parses various literal types
including integers, floats, strings, booleans, symbols, and nil.

## Syntax

```simple
42              # Integer
0xFF            # Hex integer
0b1010          # Binary integer
0o77            # Octal integer
3.14            # Float
1.0e10          # Scientific notation
"hello"         # Interpolated string
'raw'           # Raw string
r"raw\n"        # Raw string (r prefix)
true false      # Booleans
nil             # Nil value
:symbol         # Symbol literal
```
"""



# ============================================================================
# Test Group 1: Integer Literals
# ============================================================================

describe "Integer Literal Parsing":
    # ## Decimal, Hex, Binary, Octal
    #
    # Tests that integer literals in various bases are correctly parsed.

    context "decimal integers":
        it "parses simple decimal":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: parses simple decimal")
            val x = 42
            expect(x).to_equal(42)

        it "parses zero":
            step("Verify: parses zero")
            val x = 0
            expect(x).to_equal(0)

        it "parses with underscores":
            step("Verify: parses with underscores")
            val x = 1_000_000
            expect(x).to_equal(1000000)

        it "parses large numbers":
            step("Verify: parses large numbers")
            val x = 9_223_372_036_854_775_807
            expect(x).to_be_greater_than(0)

    context "hexadecimal integers":
        it "parses hex with lowercase":
            step("Verify: parses hex with lowercase")
            val x = 0xff
            expect(x).to_equal(255)

        it "parses hex with uppercase":
            step("Verify: parses hex with uppercase")
            val x = 0xFF
            expect(x).to_equal(255)

        it "parses complex hex":
            step("Verify: parses complex hex")
            val x = 0x1A2B
            expect(x).to_equal(6699)

    context "binary integers":
        it "parses simple binary":
            step("Verify: parses simple binary")
            val x = 0b1010
            expect(x).to_equal(10)

        it "parses binary with underscores":
            step("Verify: parses binary with underscores")
            val x = 0b1111_0000
            expect(x).to_equal(240)

        it "parses single bit":
            step("Verify: parses single bit")
            val x = 0b1
            expect(x).to_equal(1)

    context "octal integers":
        it "parses octal":
            step("Verify: parses octal")
            val x = 0o77
            expect(x).to_equal(63)

        it "parses octal with zeros":
            step("Verify: parses octal with zeros")
            val x = 0o755
            expect(x).to_equal(493)


# ============================================================================
# Test Group 2: Float Literals
# ============================================================================

describe "Float Literal Parsing":
    # ## Decimal and Scientific Notation
    #
    # Tests floating point literal parsing including scientific notation.

    context "simple floats":
        it "parses decimal float":
            step("Verify: parses decimal float")
            val x = 3.14
            expect(x).to_be_greater_than(3.0)
            expect(x).to_be_less_than(4.0)

        it "parses float with leading zero":
            step("Verify: parses float with leading zero")
            val x = 0.5
            expect(x).to_equal(0.5)

        it "parses whole number float":
            step("Verify: parses whole number float")
            val x = 1.0
            expect(x).to_equal(1.0)

    context "scientific notation":
        it "parses positive exponent":
            step("Verify: parses positive exponent")
            val x = 1.0e10
            expect(x).to_equal(10000000000.0)

        it "parses negative exponent":
            step("Verify: parses negative exponent")
            val x = 2.5e-3
            expect(x).to_be_less_than(0.003)

        it "parses uppercase E":
            step("Verify: parses uppercase E")
            val x = 1.5E5
            expect(x).to_equal(150000.0)


# ============================================================================
# Test Group 3: String Literals
# ============================================================================

describe "String Literal Parsing":
    # ## Interpolated, Raw, and Triple-Quoted Strings
    #
    # Tests string literal parsing with escape sequences and interpolation.

    context "double-quoted strings (interpolated)":
        it "parses simple string":
            step("Verify: parses simple string")
            val s = "hello"
            expect(s).to_equal("hello")

        it "parses escape sequences":
            step("Verify: parses escape sequences")
            val s = "hello\nworld"
            expect s.contains("\n")

        it "parses tab escape":
            step("Verify: parses tab escape")
            val s = "tab\there"
            expect s.contains("\t")

        it "interpolates variables":
            step("Verify: interpolates variables")
            val name = "Alice"
            val s = "hello {name}"
            expect(s).to_equal("hello Alice")

        it "interpolates expressions":
            step("Verify: interpolates expressions")
            val x = 6
            val y = 7
            val s = "result: {x * y}"
            expect(s).to_equal("result: 42")

        it "escapes braces":
            step("Verify: escapes braces")
            val s = "literal {{braces}}"
            expect(s).to_equal(r"literal {braces}")

    context "single-quoted strings (raw)":
        it "parses raw string":
            step("Verify: parses raw string")
            val s = 'hello'
            expect(s).to_equal("hello")

        it "does not process escapes":
            step("Verify: does not process escapes")
            val s = 'hello\nworld'
            expect s.contains("\\n")

        it "does not interpolate":
            step("Verify: does not interpolate")
            val s = '{name}'
            expect(s).to_equal(r"{name}")

    context "raw prefix strings":
        it "parses r-prefix string":
            step("Verify: parses r-prefix string")
            val s = r"hello"
            expect(s).to_equal("hello")

        it "keeps backslashes literal":
            step("Verify: keeps backslashes literal")
            val s = r"hello\nworld"
            expect s.contains("\\n")

        it "keeps braces literal":
            step("Verify: keeps braces literal")
            val s = r"{name}"
            expect(s).to_equal(r"{name}")

    context "triple-quoted strings":
        it "parses triple-quoted":
            step("Verify: parses triple-quoted")
            val s = """hello"""
            expect(s).to_equal("hello")

        it "preserves newlines":
            step("Verify: preserves newlines")
            val s = """line1
line2"""
            expect s.contains("\n")

        it "does not interpolate by default":
            step("Verify: does not interpolate by default")
            val s = """{name}"""
            expect(s).to_equal(r"{name}")

    context "triple-quoted f-strings":
        it "parses f-prefix triple-quoted":
            step("Verify: parses f-prefix triple-quoted")
            val s = f"""hello"""
            expect(s).to_equal("hello")

        it "interpolates in f-strings":
            step("Verify: interpolates in f-strings")
            val name = "world"
            val s = f"""hello {name}"""
            expect(s).to_equal("hello world")


# ============================================================================
# Test Group 4: Boolean Literals
# ============================================================================

describe "Boolean Literal Parsing":
    # ## true and false Keywords
    #
    # Tests that boolean literals are correctly parsed.

    it "parses true":
        step("Verify: parses true")
        val x = true
        expect(x).to_equal(true)

    it "parses false":
        step("Verify: parses false")
        val x = false
        expect(x).to_equal(false)

    it "uses booleans in conditions":
        step("Verify: uses booleans in conditions")
        val condition = true
        if condition:
            assert_true(true)
        else:
            assert_true(false)  # Should not reach


# ============================================================================
# Test Group 5: Nil Literal
# ============================================================================

describe "Nil Literal Parsing":
    # ## nil Keyword
    #
    # Tests that the nil literal is correctly parsed.

    it "parses nil":
        step("Verify: parses nil")
        val x = nil
        expect(x).to_equal(nil)

    it "nil equals nil":
        step("Verify: nil equals nil")
        expect(nil).to_equal(nil)


# ============================================================================
# Test Group 6: Symbol Literals
# ============================================================================

describe "Symbol Literal Parsing":
    # ## :symbol Syntax
    #
    # Tests that symbol literals with colon prefix are correctly parsed.

    it "parses simple symbol":
        step("Verify: parses simple symbol")
        val s = :ok
        expect(s).to_equal(:ok)

    it "parses symbol with underscore":
        step("Verify: parses symbol with underscore")
        val s = :error_code
        expect(s).to_equal(:error_code)

    it "symbols are comparable":
        step("Verify: symbols are comparable")
        expect(:ok).to_equal(:ok)
        assert_true(:ok != :error)


# ============================================================================
# Test Group 7: Collection Literals
# ============================================================================

describe "Collection Literal Parsing":
    # ## Arrays, Tuples, and Dictionaries
    #
    # Tests parsing of collection literal syntax.

    context "array literals":
        it "parses array":
            step("Verify: parses array")
            val arr = [1, 2, 3]
            expect(arr.len()).to_equal(3)

        it "parses empty array":
            step("Verify: parses empty array")
            val arr = []
            expect(arr.len()).to_equal(0)

        it "parses nested array":
            step("Verify: parses nested array")
            val arr = [[1, 2], [3, 4]]
            expect(arr[0][1]).to_equal(2)

    context "tuple literals":
        it "parses tuple":
            step("Verify: parses tuple")
            val t = (1, 2, 3)
            expect(t.0).to_equal(1)

        it "parses unit tuple":
            step("Verify: parses unit tuple")
            val t = ()
            assert_true(true)  # Compiles successfully

        it "parses two-element tuple":
            step("Verify: parses two-element tuple")
            val t = (42, "hello")
            expect(t.0).to_equal(42)

    context "dictionary literals":
        it "parses dictionary":
            step("Verify: parses dictionary")
            val d = {"a": 1, "b": 2}
            expect(d["a"]).to_equal(1)

        it "parses empty dictionary":
            step("Verify: parses empty dictionary")
            val d = {}
            expect(d.len()).to_equal(0)


# ============================================================================
# Test Group 8: Numeric Literal Edge Cases
# ============================================================================

describe "Numeric Literal Edge Cases":
    # ## Special Cases and Boundaries
    #
    # Tests edge cases in numeric literal parsing.

    it "parses negative integers":
        step("Verify: parses negative integers")
        val x = -42
        expect(x).to_equal(-42)

    it "parses negative floats":
        step("Verify: parses negative floats")
        val x = -3.14
        expect(x).to_be_less_than(0.0)

    it "parses very small float":
        step("Verify: parses very small float")
        val x = 0.000001
        expect(x).to_be_greater_than(0.0)

    it "parses integer with many underscores":
        step("Verify: parses integer with many underscores")
        val x = 1_2_3_4_5
        expect(x).to_equal(12345)
