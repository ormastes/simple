describe "Integer Literals - Hexadecimal":
    # ## Hexadecimal Integer Literals
    #
    # Hexadecimal (base 16) uses `0x` or `0X` prefix.
    # Digits: 0-9, a-f, A-F (case insensitive).

    context "basic hex literals":
        # ### Scenario: Basic Hexadecimal
        #
        # Hex literals start with 0x prefix.
        #
        # ```simple
        # val x = 0xFF
        # val y = 0x10
        # ```

        it "parses lowercase hex":
            # @req REQ-LIT-008
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_008") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xff
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

        it "parses uppercase hex":
            # @req REQ-LIT-009
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_009") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xFF
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

        it "parses mixed case":
            # @req REQ-LIT-010
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_010") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xAb
            expect(x).to_equal(171)  # oracle: 171 — pinned expected value for this behavior

        it "parses single hex digit":
            # @req REQ-LIT-011
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_011") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xF
            expect(x).to_equal(15)  # oracle: 15 — pinned expected value for this behavior

        it "parses multi-digit hex":
            # @req REQ-LIT-012
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_012") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0x1A2B
            expect(x).to_equal(6699)  # oracle: 6699 — pinned expected value for this behavior

    context "with underscore separators":
        # ### Scenario: Hex with Underscores
        #
        # Underscores can group hex digits.
        #
        # ```simple
        # val color = 0xFF_00_FF
        # val addr = 0x7F00_0001
        # ```

        it "parses hex with underscores":
            # @req REQ-LIT-013
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_013") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xFF_00
            expect(x).to_equal(65280)  # oracle: 65280 — pinned expected value for this behavior

        it "parses byte grouping":
            # @req REQ-LIT-014
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_014") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xFF_FF_FF_FF
            expect(x).to_equal(4294967295)  # oracle: 4294967295 — pinned expected value for this behavior


