describe "Integer Literals - Type Suffixes":
    # ## Type Suffixes
    #
    # Explicit type suffixes specify integer size and signedness.
    # Signed: i8, i16, i32, i64
    # Unsigned: u8, u16, u32, u64

    context "signed type suffixes":
        # ### Scenario: Signed Type Suffixes
        #
        # Signed integers with explicit size.
        #
        # ```simple
        # val byte = 127i8
        # val short = 1000i16
        # val int = 100000i32
        # val long = 1000000000i64
        # ```

        it "parses i32 suffix":
            # @req REQ-LIT-026
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_026") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 42i32
            expect(x).to_equal(42)  # oracle: 42 — pinned expected value for this behavior

        it "parses i64 suffix":
            # @req REQ-LIT-027
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_027") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 1000i64
            expect(x).to_equal(1000)  # oracle: 1000 — pinned expected value for this behavior

    context "unsigned type suffixes":
        # ### Scenario: Unsigned Type Suffixes
        #
        # Unsigned integers with explicit size.
        #
        # ```simple
        # val byte = 255u8
        # val port = 8080u16
        # val count = 4294967295u32
        # ```

        it "parses u8 suffix":
            # @req REQ-LIT-028
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_028") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 255u8
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

        it "parses u16 suffix":
            # @req REQ-LIT-029
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_029") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 1000u16
            expect(x).to_equal(1000)  # oracle: 1000 — pinned expected value for this behavior

        it "parses u32 suffix":
            # @req REQ-LIT-030
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_030") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 12345u32
            expect(x).to_equal(12345)  # oracle: 12345 — pinned expected value for this behavior


# ============================================================================
# Mixed Formats
# ============================================================================

describe "Integer Literals - Mixed Formats":
    # ## Mixed Format Expressions
    #
    # Different integer literal formats can be used in the same expression.

    context "combining formats":
        # ### Scenario: Multiple Formats
        #
        # Mix decimal, hex, binary, octal in calculations.
        #
        # ```simple
        # val result = 10 + 0xA + 0b1010 + 0o12
        # ```

        it "combines decimal and hex":
            # @req REQ-LIT-031
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_031") -> basic_types_integer_literals_spec.evidence.sdn
            val result = 10 + 0xA
            expect(result).to_equal(20)  # oracle: 20 — pinned expected value for this behavior

        it "combines decimal and binary":
            # @req REQ-LIT-032
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_032") -> basic_types_integer_literals_spec.evidence.sdn
            val result = 5 + 0b101
            expect(result).to_equal(10)  # oracle: 10 — pinned expected value for this behavior

        it "combines all formats":
            # @req REQ-LIT-033
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_033") -> basic_types_integer_literals_spec.evidence.sdn
            val result = 1 + 0xF + 0b1111 + 0o17
            expect(result).to_equal(46)  # oracle: 46 — pinned expected value for this behavior


# ============================================================================
# Edge Cases
# ============================================================================

describe "Integer Literals - Edge Cases":
    # ## Edge Case Handling
    #
    # Special cases and boundary conditions.

    context "with zero":
        # ### Scenario: Zero in Different Bases
        #
        # Zero can be represented in any base.
        #
        # ```simple
        # val dec_zero = 0
        # val hex_zero = 0x0
        # val bin_zero = 0b0
        # val oct_zero = 0o0
        # ```

        it "parses decimal zero":
            # @req REQ-LIT-034
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_034") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses hex zero":
            # @req REQ-LIT-035
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_035") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0x0
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses binary zero":
            # @req REQ-LIT-036
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_036") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b0
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses octal zero":
            # @req REQ-LIT-037
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_037") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0o0
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

    context "with one":
        # ### Scenario: One in Different Bases
        #
        # One is represented the same in all bases.

        it "parses decimal one":
            # @req REQ-LIT-038
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_038") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 1
            val independently_parsed = "1".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses hex one":
            # @req REQ-LIT-039
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_039") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0x1
            expect(x).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        it "parses binary one":
            # @req REQ-LIT-040
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_040") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1
            expect(x).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        it "parses octal one":
            # @req REQ-LIT-041
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_041") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0o1
            expect(x).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

    context "with maximum values":
        # ### Scenario: Large Integer Values
        #
        # Large numbers within i64 range.

        it "parses large decimal":
            # @req REQ-LIT-042
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_042") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 2147483647
            val independently_parsed = "2147483647".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses large hex":
            # @req REQ-LIT-043
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_043") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0x7FFFFFFF
            expect(x).to_equal(2147483647)  # oracle: 2147483647 — pinned expected value for this behavior


# ============================================================================
# Uppercase vs Lowercase Prefixes
# ============================================================================

describe "Integer Literals - Case Insensitivity":
    # ## Case Insensitivity
    #
    # Hex, binary, and octal prefixes are case-insensitive.

    context "hex prefix case":
        # ### Scenario: Hex Prefix Case Variations
        #
        # Both 0x and 0X are valid.

        it "accepts lowercase 0x":
            # @req REQ-LIT-044
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_044") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0xff
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

        it "accepts uppercase 0X":
            # @req REQ-LIT-045
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_045") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0XFF
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

    context "binary prefix case":
        # ### Scenario: Binary Prefix Case Variations
        #
        # Both 0b and 0B are valid.

        it "accepts lowercase 0b":
            # @req REQ-LIT-046
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_046") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1010
            expect(x).to_equal(10)  # oracle: 10 — pinned expected value for this behavior

        it "accepts uppercase 0B":
            # @req REQ-LIT-047
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_047") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0B1010
            expect(x).to_equal(10)  # oracle: 10 — pinned expected value for this behavior

    context "octal prefix case":
