describe "Integer Literals - Binary":
    # ## Binary Integer Literals
    #
    # Binary (base 2) uses `0b` or `0B` prefix.
    # Digits: 0 and 1 only.

    context "basic binary literals":
        # ### Scenario: Basic Binary
        #
        # Binary literals start with 0b prefix.
        #
        # ```simple
        # val x = 0b1010
        # val y = 0b1111
        # ```

        it "parses simple binary":
            # @req REQ-LIT-015
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_015") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1010
            expect(x).to_equal(10)  # oracle: 10 — pinned expected value for this behavior

        it "parses all ones":
            # @req REQ-LIT-016
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_016") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1111
            expect(x).to_equal(15)  # oracle: 15 — pinned expected value for this behavior

        it "parses all zeros":
            # @req REQ-LIT-017
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_017") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b0000
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses single bit":
            # @req REQ-LIT-018
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_018") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1
            expect(x).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        it "parses byte value":
            # @req REQ-LIT-019
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_019") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b11111111
            expect(x).to_equal(255)  # oracle: 255 — pinned expected value for this behavior

    context "with underscore separators":
        # ### Scenario: Binary with Underscores
        #
        # Underscores can group binary digits (nibbles, bytes).
        #
        # ```simple
        # val byte = 0b1111_0000
        # val word = 0b1111_1111_0000_0000
        # ```

        it "parses nibble grouping":
            # @req REQ-LIT-020
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_020") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1111_0000
            expect(x).to_equal(240)  # oracle: 240 — pinned expected value for this behavior

        it "parses byte pairs":
            # @req REQ-LIT-021
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_021") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0b1010_1010
            expect(x).to_equal(170)  # oracle: 170 — pinned expected value for this behavior


