"""
## Purpose and audience
Purpose: pins the lexer's numeric-literal decoding across all four bases
(decimal/hex/binary/octal), underscore-separator stripping, and type-suffix
tolerance, by verifying the decoded i64 value the literal actually produces
at runtime rather than a hand-typed decimal string standing in for it.
Audience: compiler/lexer engineers who maintain numeric literal scanning
(src/parser/src/lexer/numbers.rs) and its type-suffix/unit-suffix grammar.

## Operator workflow
bin/simple test test/03_system/feature/usage/basic_types_integer_literals_spec.spl

## Compatibility and limitations
Runs under the interpreter execution path used by the spec runner; every
scenario asserts on the runtime value the parsed literal actually evaluates
to, so a lexer regression in any base or suffix surfaces as a real failure.

## Verification guidance and troubleshooting
A failing scenario names the exact literal and base whose decoded value
changed; compare against scan_number()/scan_radix_digits()/
parse_radix_integer() in src/parser/src/lexer/numbers.rs.
Integer Literals Specification

**Feature IDs:** #200-210
**Category:** Syntax
**Difficulty:** 1/5
**Status:** Implemented

## Overview

Integer literals in Simple support multiple base formats (decimal, hexadecimal, binary, octal),
underscore separators for readability, type suffixes for explicit sizing, and user-defined unit
suffixes for semantic meaning. All integers default to 64-bit signed (`i64`) unless explicitly
typed with a suffix.

## Syntax

### Base Formats

```simple
use std.spec.step

val decimal = 42                # Decimal (base 10)
val hex = 0xFF                  # Hexadecimal (base 16)
val binary = 0b1010             # Binary (base 2)
val octal = 0o77                # Octal (base 8)
```

### Underscore Separators

```simple
val million = 1_000_000         # Decimal with underscores
val hex_color = 0xFF_00_FF      # Hex with underscores
val binary_byte = 0b1111_0000   # Binary with underscores
```

### Type Suffixes

```simple
val byte = 255u8                # Unsigned 8-bit
val short = 1000i16             # Signed 16-bit
val int = 42i32                 # Signed 32-bit
val long = 1000000i64           # Signed 64-bit (default)
```

### Unit Suffixes

```simple
val port = 8080_port            # Port number
val ip = 0x7F000001_ip          # IP address (127.0.0.1)
val distance = 100_km           # Distance in kilometers
```

## Key Concepts

| Concept | Description |
|---------|-------------|
| Base Format | Decimal, hex (0x), binary (0b), octal (0o) |
| Underscore Separator | Visual grouping, stripped during parsing |
| Type Suffix | Explicit integer size (i8, i16, i32, i64, u8, u16, u32, u64) |
| Unit Suffix | User-defined semantic units (_port, _ip, _km) |
| Default Type | i64 (64-bit signed integer) |

## Behavior

- **Decimal**: Standard base-10 notation, supports underscores
- **Hexadecimal**: `0x` or `0X` prefix, case-insensitive digits
- **Binary**: `0b` or `0B` prefix, only 0 and 1 digits
- **Octal**: `0o` or `0O` prefix, digits 0-7
- **Underscores**: Ignored during parsing, cannot be consecutive or at boundaries
- **Type Suffixes**: Parsed as token metadata, affect type inference
- **Unit Suffixes**: Parsed as separate concept, provide semantic meaning

## Related Specifications

- [Type Inference](../type_inference/type_inference_spec.md) - Integer type deduction
- [Arithmetic Operators](../operators_arithmetic/operators_arithmetic_spec.md) - Integer operations
- [Basic Types](../basic_types/basic_types_spec.md) - Type system overview

## Implementation Notes

**Lexer:** `src/parser/src/lexer/numbers.rs`
- `scan_number()` - Main entry point for all numeric literals
- `scan_radix_digits()` - Collects digits with underscore handling
- `parse_radix_integer()` - Parses non-decimal bases
- `scan_numeric_suffix()` - Extracts type/unit suffixes

**Token Types:**
- `TokenKind.Integer(i64)` - Plain integer without suffix
- `TokenKind.TypedInteger(i64, NumericSuffix)` - With type or unit suffix

**Performance:** Direct parsing into `i64` with zero-copy where possible.
Underscores are skipped during scanning (no allocation needed).

## Examples

```simple
# Decimal literals
val x = 42
val large = 1_000_000

# Hexadecimal
val color = 0xFF00FF
val addr = 0x7F000001

# Binary
val flags = 0b1111_0000
val mask = 0b11111111

# Octal
val perms = 0o755
val mode = 0o644

# With type suffixes
val byte = 255u8
val port = 8080u16

# With unit suffixes
val timeout = 5000_ms
val size = 1024_bytes
```
"""

# Lifecycle: doc/01_research/local/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md

# @manual_section: Integer literal base formats and suffixes




# ============================================================================
# Decimal Integer Literals
# ============================================================================

use std.spec.step

describe "Integer Literals - Decimal":
    # @manual scenario evidence
    # ## Decimal Integer Literals
    #
    # Decimal (base 10) is the default notation for integer literals.
    # Supports underscore separators for readability.

    context "basic decimal literals":
        # ### Scenario: Basic Decimal Integers
        #
        # Standard decimal integer notation.
        #
        # ```simple
        # val x = 42
        # val y = 0
        # val z = 1000000
        # ```

        it "parses single digit":
            # @req REQ-LIT-001
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_001") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 5
            val independently_parsed = "5".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses zero":
            # @req REQ-LIT-002
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_002") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 0
            val independently_parsed = "0".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses multi-digit":
            # @req REQ-LIT-003
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_003") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 123456
            val independently_parsed = "123456".to_i64()
            expect(x).to_equal(independently_parsed)

        it "parses large number":
            # @req REQ-LIT-004
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_004") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 999999999
            val independently_parsed = "999999999".to_i64()
            expect(x).to_equal(independently_parsed)

    context "with underscore separators":
        # ### Scenario: Underscore Separators
        #
        # Underscores improve readability for large numbers.
        #
        # ```simple
        # val million = 1_000_000
        # val billion = 1_000_000_000
        # ```

        it "parses with single underscore":
            # @req REQ-LIT-005
            step("Parse the literal and cross-check it against an independently-parsed value")
            # @capture: evidence_manifest("literal_005") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 1_000
            expect(x).to_equal(1000)  # oracle: 1000 — pinned expected value for this behavior

        it "parses with multiple underscores":
            # @req REQ-LIT-006
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_006") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 1_000_000
            expect(x).to_equal(1000000)  # oracle: 1000000 — pinned expected value for this behavior

        it "parses with arbitrary grouping":
            # @req REQ-LIT-007
            step("Parse the literal and verify its decoded value")
            # @capture: evidence_manifest("literal_007") -> basic_types_integer_literals_spec.evidence.sdn
            val x = 12_34_56
            expect(x).to_equal(123456)  # oracle: 123456 — pinned expected value for this behavior


