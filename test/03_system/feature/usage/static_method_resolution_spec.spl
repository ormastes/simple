"""
## Purpose and audience
Purpose: resolves simple static method call
Audience: compiler and tooling engineers who maintain this spec

# Static Method Resolution

**Feature ID:** #RESOLVE-001
**Category:** Compiler
**Status:** Active

## Overview

Tests static method resolution and calling in interpreter mode.
Uses ClassName.method() dot-access syntax which works in closures.

## Syntax

```simple
class Point:
    x: i64
    y: i64
    static fn origin() -> Point:
        Point(x: 0, y: 0)
val p = Point.origin()
```
"""

# @req: REQ-FEATURE-StatMethReso-001

class Calculator:
    value: i64
    static fn add(a: i64, b: i64) -> i64:
        a + b
    static fn multiply(a: i64, b: i64) -> i64:
        a * b
    static fn zero() -> Calculator:
        Calculator(value: 0)
    static fn from_value(v: i64) -> Calculator:
        Calculator(value: v)
    fn get_value() -> i64:
        self.value

class MathUtils:
    x: i64
    static fn max(a: i64, b: i64) -> i64:
        if a > b:
            a
        else:
            b
    static fn min(a: i64, b: i64) -> i64:
        if a < b:
            a
        else:
            b
    static fn abs(n: i64) -> i64:
        if n < 0:
            0 - n
        else:
            n
    static fn clamp(v: i64, lo: i64, hi: i64) -> i64:
        if v < lo:
            lo
        else:
            if v > hi:
                hi
            else:
                v

use std.spec.step
describe "Static Method Resolution":
    context "Basic static method resolution":
        it "resolves simple static method call":
            step("Verify: resolves simple static method call")
            # @req: REQ-FEATURE-StatMethReso-001
            val result = Calculator.add(3, 4)
            expect(result).to_equal(7)  # oracle: value fixed by the spec contract

        it "resolves static method with parameters":
            step("Verify: resolves static method with parameters")
            # @req: REQ-FEATURE-StatMethReso-001
            val result = Calculator.multiply(5, 6)
            expect(result).to_equal(30)  # oracle: value fixed by the spec contract

        it "resolves static method returning object":
            step("Verify: resolves static method returning object")
            # @req: REQ-FEATURE-StatMethReso-001
            val calc = Calculator.zero()
            expect(calc.get_value()).to_equal(0)  # oracle: value fixed by the spec contract

    context "Static vs instance method distinction":
        it "correctly resolves static method vs instance method":
            step("Verify: correctly resolves static method vs instance method")
            # @req: REQ-FEATURE-StatMethReso-001
            val calc = Calculator.from_value(42)
            expect(calc.get_value()).to_equal(42)  # oracle: value fixed by the spec contract

        it "allows same name for static and instance methods":
            step("Verify: allows same name for static and instance methods")
            # @req: REQ-FEATURE-StatMethReso-001
            # Static returns i64, instance returns field
            val sum = Calculator.add(10, 20)
            val calc = Calculator.from_value(100)
            expect(sum).to_equal(30)  # oracle: value fixed by the spec contract
            expect(calc.get_value()).to_equal(100)  # oracle: value fixed by the spec contract

    context "Static method chaining":
        it "chains static method call with instance method":
            step("Verify: chains static method call with instance method")
            # @req: REQ-FEATURE-StatMethReso-001
            val result = Calculator.from_value(10).get_value()
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract

        it "calls multiple static methods in sequence":
            step("Verify: calls multiple static methods in sequence")
            # @req: REQ-FEATURE-StatMethReso-001
            val a = Calculator.add(1, 2)
            val b = Calculator.multiply(3, 4)
            expect(a + b).to_equal(15)  # oracle: value fixed by the spec contract

    context "Static methods calling other methods":
        it "static method calls another static method":
            step("Verify: static method calls another static method")
            # @req: REQ-FEATURE-StatMethReso-001
            val m = MathUtils.max(10, 20)
            val n = MathUtils.min(10, 20)
            expect(m).to_equal(20)  # oracle: value fixed by the spec contract
            expect(n).to_equal(10)  # oracle: value fixed by the spec contract

        it "static method creates object and calls instance method":
            step("Verify: static method creates object and calls instance method")
            # @req: REQ-FEATURE-StatMethReso-001
            val calc = Calculator.from_value(99)
            val v = calc.get_value()
            expect(v).to_equal(99)  # oracle: value fixed by the spec contract

    context "Static method in structs":
        it "resolves static method on struct":
            step("Verify: resolves static method on struct")
            # @req: REQ-FEATURE-StatMethReso-001
            val a = MathUtils.abs(0 - 42)
            expect(a).to_equal(42)  # oracle: value fixed by the spec contract

        it "resolves multiple static methods on struct":
            step("Verify: resolves multiple static methods on struct")
            # @req: REQ-FEATURE-StatMethReso-001
            val clamped = MathUtils.clamp(150, 0, 100)
            expect(clamped).to_equal(100)  # oracle: value fixed by the spec contract
