# @req: REQ-FEATURE-HashBasi-001

# HashSet Basic Operations System Test
#
# **Feature:** Collections.HashSet
# **Category:** System/Collections
# **Status:** Active
#
# ## Description
#
# Tests for HashSet basic operations using self-contained implementation.
#
# Tests cover:
# - Set creation and initialization
# - Element insertion and deduplication
# - Membership testing (contains/remove)
# - Collection mutations (clear)
# - Array conversion

# Self-contained HashSet implementation for testing
class HashSet:
    items: [text]

    static fn new() -> HashSet:
        HashSet(items: [])

    me insert(value: text) -> bool:
        # Check if already exists
        var i = 0
        while i < self.items.len():
            if self.items[i] == value:
                return false
            i = i + 1
        self.items.push(value)
        true

    fn contains(value: text) -> bool:
        var i = 0
        while i < self.items.len():
            if self.items[i] == value:
                return true
            i = i + 1
        false

    me remove(value: text) -> bool:
        var new_items: [text] = []
        var found = false
        var i = 0
        while i < self.items.len():
            if self.items[i] == value:
                found = true
            else:
                new_items.push(self.items[i])
            i = i + 1
        self.items = new_items
        found

    me clear():
        self.items = []

    fn len() -> i64:
        self.items.len()

    fn is_empty() -> bool:
        self.items.len() == 0

    fn to_vec() -> [text]:
        self.items


use std.spec.step
describe "HashSet basic operations":
    context "Creation and insertion":
        it "creates new HashSet":
            step("Verify: creates new HashSet")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            expect(set.len()).to_equal(0)  # oracle: value fixed by the spec contract
            expect(set.is_empty()).to_equal(true)

        it "inserts elements":
            step("Verify: inserts elements")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("apple")
            set.insert("banana")
            set.insert("cherry")

            expect(set.len()).to_equal(3)  # oracle: value fixed by the spec contract
            expect(set.contains("apple")).to_equal(true)
            expect(set.contains("banana")).to_equal(true)

        it "handles duplicate insertions":
            step("Verify: handles duplicate insertions")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("cat")
            set.insert("dog")
            set.insert("cat")
            expect(set.len()).to_equal(2)  # oracle: value fixed by the spec contract
            expect(set.contains("cat")).to_equal(true)
            expect(set.contains("dog")).to_equal(true)

    context "Membership testing":
        it "checks if element exists":
            step("Verify: checks if element exists")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("exists")

            expect(set.contains("exists")).to_equal(true)
            expect(set.contains("missing")).to_equal(false)

        it "removes elements":
            step("Verify: removes elements")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("temp")

            val removed = set.remove("temp")
            expect(removed).to_equal(true)
            expect(set.contains("temp")).to_equal(false)

    context "Collection operations":
        it "clears all elements":
            step("Verify: clears all elements")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("a")
            set.insert("b")
            set.insert("c")

            set.clear()
            expect(set.is_empty()).to_equal(true)
            expect(set.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "converts to vector":
            step("Verify: converts to vector")
            # @req: REQ-FEATURE-HashBasi-001
            var set = HashSet.new()
            set.insert("x")
            set.insert("y")
            set.insert("z")

            val items = set.to_vec()
            expect(items.len()).to_equal(3)  # oracle: value fixed by the spec contract
