"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/packed_struct_bitfield_syntax_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""
use std.spec.step

# doc-path: doc/01_research/local/packed_struct_bitfield_syntax_spec.md
# doc-path: doc/03_plan/sys_test/packed_struct_bitfield_syntax_spec.md
# doc-path: doc/04_architecture/packed_struct_bitfield_syntax_spec.md
# doc-path: doc/05_design/packed_struct_bitfield_syntax_spec_oracles.md
# @manual: primary

describe "FR-DRIVER-0003 packed struct bitfield syntax":
    val requested_syntax = "struct Foo @packed { a: u16:4 }"
    val current_status = "parser diagnostic only"
    val fallback = "bitfield FooBits(u16): a: 4"

    it "documents requested native syntax":
        step("Verify: documents requested native syntax")
        # @req: REQ-SSPEC-LOCAL-001
        expect(requested_syntax).to_contain("@packed")
        expect(requested_syntax).to_contain("u16:4")

    it "documents current implementation boundary":
        step("Verify: documents current implementation boundary")
        # @req: REQ-SSPEC-LOCAL-001
        expect(current_status).to_equal("parser diagnostic only")
        expect(fallback).to_start_with("bitfield")
