# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
## Purpose and audience
Purpose: declarative CLI argument parsing (bool flags, string options, int
options, defaults) is exercised through the real parser
(std.nogc_sync_mut.cli.cli_parser) instead of commented-out pseudo-code.
Audience: language/CLI engineers who maintain the cli keyword's parser.
"""

use std.spec.step

use std.spec.{describe, it, expect}
use std.nogc_sync_mut.cli.cli_parser.{
    cli_spec, cli_spec_program, cli_spec_flag, cli_spec_option, cli_spec_positional,
    parse_cli_args, parsed_flag, parsed_option, parsed_positional
}

# @manual_section: CLI args basic parsing

describe "CLI Args Basic":
    # @manual scenario evidence
    it "bool flag defaults to false and --verbose sets it true":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: flag default false, long form sets true, short form sets true")
        val spec = cli_spec_flag(cli_spec(), "verbose", "v", "verbose output")
        val off = parse_cli_args(spec, [])
        expect(parsed_flag(off, "verbose")).to_equal(false)  # oracle: unset flag is false
        val on_long = parse_cli_args(spec, ["--verbose"])
        expect(parsed_flag(on_long, "verbose")).to_equal(true)  # oracle: long form sets flag
        val on_short = parse_cli_args(spec, ["-v"])
        expect(parsed_flag(on_short, "verbose")).to_equal(true)  # oracle: short form sets flag

    it "string option falls back to its default and accepts --key=value and --key value":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: option default, = form, and space form")
        val spec = cli_spec_option(cli_spec(), "output", "o", "output path", "out.txt", [])
        val dflt = parse_cli_args(spec, [])
        expect(parsed_option(dflt, "output")).to_equal("out.txt")  # oracle: default retained
        val eq_form = parse_cli_args(spec, ["--output=a.txt"])
        expect(parsed_option(eq_form, "output")).to_equal("a.txt")  # oracle: = form parsed
        val space_form = parse_cli_args(spec, ["--output", "b.txt"])
        expect(parsed_option(space_form, "output")).to_equal("b.txt")  # oracle: space form parsed

    it "int option parses as a numeric string with default":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: count option default 1 and parsed value round-trips to int")
        val spec = cli_spec_option(cli_spec(), "count", "c", "repeat count", "1", [])
        val dflt = parse_cli_args(spec, [])
        expect(parsed_option(dflt, "count").to_i64()).to_equal(1)  # oracle: default is numeric 1
        val got = parse_cli_args(spec, ["--count=3"])
        expect(parsed_option(got, "count").to_i64()).to_equal(3)  # oracle: parsed int option

    it "choice-restricted options reject out-of-set values":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: invalid choice keeps the default")
        val spec = cli_spec_option(cli_spec(), "mode", "m", "run mode", "fast", ["fast", "slow"])
        val bad = parse_cli_args(spec, ["--mode=warp"])
        expect(parsed_option(bad, "mode")).to_equal("fast")  # oracle: out-of-choice value ignored
        val good = parse_cli_args(spec, ["--mode=slow"])
        expect(parsed_option(good, "mode")).to_equal("slow")  # oracle: in-choice value accepted

    it "positional arguments collect in order":
        # @req REQ-SSPEC-SYSTEM
        step("Verify: bare words become positionals, unknown dashes become remaining")
        val spec = cli_spec_positional(cli_spec(), "file", "input file", true)
        val parsed = parse_cli_args(spec, ["a.spl", "--unknown", "b.spl"])
        expect(parsed_positional(parsed, 0)).to_equal("a.spl")  # oracle: first positional
        expect(parsed_positional(parsed, 1)).to_equal("b.spl")  # oracle: second positional
        expect(parsed.remaining.len()).to_equal(1)  # oracle: unrecognized flag kept in remaining
        expect(parsed.remaining[0]).to_equal("--unknown")
