use std.spec
use std.spec.step

# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/usage/parser_expressions_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/parser_expressions_spec.md
# doc-path: doc/03_plan/sys_test/parser_expressions_spec.md
# doc-path: doc/04_architecture/parser_expressions_spec.md
# doc-path: doc/05_design/parser_expressions_spec_oracles.md
# @manual: primary

"""
# Parser Expression Specification


**Feature IDs:** #PARSER-EXPR-001 to #PARSER-EXPR-030
**Category:** Infrastructure | Parser
**Status:** Implemented

Tests that the parser correctly parses various expression forms including
arithmetic, logical, comparison, indexing, method calls, and more.

## Syntax

```simple
# Arithmetic
x + y, x - y, x * y, x / y, x % y, x ** y, x // y

# Comparison
x < y, x > y, x <= y, x >= y, x == y, x != y

# Logical
x and y, x or y, not x

# Method/Field access
obj.method(), obj.field

# Indexing
arr[0], arr[i], arr[1:3]
```
"""



# ============================================================================
# Test Group 1: Arithmetic Expressions
# ============================================================================

describe "Arithmetic Expression Parsing":
    # ## Binary Arithmetic Operators
    #
    # Tests parsing of addition, subtraction, multiplication, division, etc.

    context "basic operations":
        it "parses addition":
            # @req: REQ-SSPEC-LOCAL-001
            step("Verify: parses addition")
            val x = 1 + 2
            expect(x).to_equal(3)

        it "parses subtraction":
            step("Verify: parses subtraction")
            val x = 5 - 3
            expect(x).to_equal(2)

        it "parses multiplication":
            step("Verify: parses multiplication")
            val x = 4 * 5
            expect(x).to_equal(20)

        it "parses division":
            step("Verify: parses division")
            val x = 10 / 2
            expect(x).to_equal(5)

        it "parses modulo":
            step("Verify: parses modulo")
            val x = 7 % 3
            expect(x).to_equal(1)

        it "parses power":
            step("Verify: parses power")
            val x = 2 ** 3
            expect(x).to_equal(8)

        it "parses integer division":
            step("Verify: parses integer division")
            val x = 7.fdiv(3)
            expect(x).to_equal(2)

    context "operator precedence":
        it "multiplication before addition":
            step("Verify: multiplication before addition")
            val x = 2 + 3 * 4
            expect(x).to_equal(14)

        it "parentheses override precedence":
            step("Verify: parentheses override precedence")
            val x = (2 + 3) * 4
            expect(x).to_equal(20)

        it "nested parentheses":
            step("Verify: nested parentheses")
            val x = ((1 + 2) * 3)
            expect(x).to_equal(9)

    context "unary operations":
        it "parses unary minus":
            step("Verify: parses unary minus")
            val x = -5
            expect(x).to_equal(-5)

        it "parses bitwise not":
            step("Verify: parses bitwise not")
            val x = ~0
            expect(x).to_equal(-1)


# ============================================================================
# Test Group 2: Comparison Expressions
# ============================================================================

describe "Comparison Expression Parsing":
    # ## Comparison Operators
    #
    # Tests parsing of comparison operators for equality and ordering.

    it "parses less than":
        step("Verify: parses less than")
        expect((1).to_be_less_than(2) == true)

    it "parses greater than":
        step("Verify: parses greater than")
        expect((2).to_be_greater_than(1) == true)

    it "parses less than or equal":
        step("Verify: parses less than or equal")
        assert_true((2 <= 2) == true)

    it "parses greater than or equal":
        step("Verify: parses greater than or equal")
        assert_true((3 >= 2) == true)

    it "parses equals":
        step("Verify: parses equals")
        expect((2).to_equal(2) == true)

    it "parses not equals":
        step("Verify: parses not equals")
        assert_true((1 != 2) == true)


# ============================================================================
# Test Group 3: Logical Expressions
# ============================================================================

describe "Logical Expression Parsing":
    # ## Logical Operators
    #
    # Tests parsing of boolean logic operators.

    it "parses and":
        step("Verify: parses and")
        val x = true and false
        expect(x).to_equal(false)

    it "parses or":
        step("Verify: parses or")
        val x = true or false
        expect(x).to_equal(true)

    it "parses not":
        step("Verify: parses not")
        val x = not true
        expect(x).to_equal(false)

    it "parses combined logical":
        step("Verify: parses combined logical")
        val x = (true and false) or true
        expect(x).to_equal(true)


# ============================================================================
# Test Group 4: Method and Field Access
# ============================================================================

describe "Method and Field Access Parsing":
    # ## Dot Notation for Members
    #
    # Tests parsing of method calls and field access on objects.

    context "method calls":
        it "parses no-arg method call":
            step("Verify: parses no-arg method call")
            val arr = [1, 2, 3]
            val len = arr.len()
            expect(len).to_equal(3)

        it "parses method call with args":
            step("Verify: parses method call with args")
            val arr = [1, 2, 3]
            expect arr.contains(2)

        it "parses chained method calls":
            step("Verify: parses chained method calls")
            val arr = [1, 2, 3]
            # NOTE: Using intermediate vars as workaround for interpreter chaining limitation
            val mapped = arr.map(_1 * 2)
            val result = mapped.filter(_1 > 2)
            expect(result.len()).to_equal(2)

    context "field access":
        it "parses field access":
            step("Verify: parses field access")
            class Point:
                x: i64
                y: i64
            val p = Point(x: 10, y: 20)
            expect(p.x).to_equal(10)

        it "parses nested field access":
            step("Verify: parses nested field access")
            class Inner:
                value: i64
            class Outer:
                inner: Inner
            val o = Outer(inner: Inner(value: 42))
            expect(o.inner.value).to_equal(42)


# ============================================================================
# Test Group 5: Indexing Expressions
# ============================================================================

describe "Indexing Expression Parsing":
    # ## Square Bracket Indexing
    #
    # Tests parsing of array/collection indexing and slicing.

    context "simple indexing":
        it "parses integer index":
            step("Verify: parses integer index")
            val arr = [10, 20, 30]
            expect(arr[0]).to_equal(10)

        it "parses variable index":
            step("Verify: parses variable index")
            val arr = [10, 20, 30]
            val i = 1
            expect(arr[i]).to_equal(20)

        it "parses expression index":
            step("Verify: parses expression index")
            val arr = [10, 20, 30]
            expect(arr[1 + 1]).to_equal(30)

        it "parses negative index":
            step("Verify: parses negative index")
            val arr = [10, 20, 30]
            expect(arr[-1]).to_equal(30)

    context "slicing":
        it "parses start end slice":
            step("Verify: parses start end slice")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[1:4]
            expect(sliced.len()).to_equal(3)

        it "parses end slice":
            step("Verify: parses end slice")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[:3]
            expect(sliced.len()).to_equal(3)

        it "parses start slice":
            step("Verify: parses start slice")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[2:]
            expect(sliced.len()).to_equal(3)


# ============================================================================
# Test Group 6: Function Call Expressions
# ============================================================================

describe "Function Call Expression Parsing":
    # ## Function Invocation Syntax
    #
    # Tests parsing of function calls with various argument styles.

    context "positional arguments":
        it "parses no-arg call":
            step("Verify: parses no-arg call")
            fn get_value() -> i64:
                42
            expect(get_value()).to_equal(42)

        it "parses single arg call":
            step("Verify: parses single arg call")
            fn double(x: i64) -> i64:
                x * 2
            expect(double(21)).to_equal(42)

        it "parses multi-arg call":
            step("Verify: parses multi-arg call")
            fn add(a: i64, b: i64, c: i64) -> i64:
                a + b + c
            expect(add(10, 20, 12)).to_equal(42)

    context "named arguments":
        it "parses named arguments":
            step("Verify: parses named arguments")
            fn greet(name: text, greeting: text) -> text:
                "{greeting}, {name}!"
            val result = greet(name = "World", greeting = "Hello")
            expect(result).to_equal("Hello, World!")


# ============================================================================
# Test Group 7: Path Expressions
# ============================================================================

describe "Path Expression Parsing":
    # ## Double Colon Path Syntax
    #
    # Tests parsing of module paths and enum variants.

    it "parses enum variant":
        step("Verify: parses enum variant")
        enum Color:
            Red
            Green
            Blue
        val c = Color.Red
        expect(c).to_equal(Color.Red)

    it "parses nested path":
        step("Verify: parses nested path")
        # Module path syntax - using function call instead
        fn get_value() -> i64:
            42
        expect(get_value()).to_equal(42)


# ============================================================================
# Test Group 8: Conditional Expressions
# ============================================================================

describe "Conditional Expression Parsing":
    # ## Inline If Expressions
    #
    # Tests parsing of if expressions that return values.

    it "parses if-else expression":
        step("Verify: parses if-else expression")
        val x = if true: 1 else: 0
        expect(x).to_equal(1)

    it "parses conditional comparison":
        step("Verify: parses conditional comparison")
        val a = 10
        val b = 5
        val max = if a > b: a else: b
        expect(max).to_equal(10)


# ============================================================================
# Test Group 9: Lambda Expressions
# ============================================================================

describe "Lambda Expression Parsing":
    # ## Backslash Lambda Syntax
    #
    # Tests parsing of lambda/anonymous function expressions.

    it "parses single parameter lambda":
        step("Verify: parses single parameter lambda")
        val f = \x: x + 1
        expect(f(41)).to_equal(42)

    it "parses multi-parameter lambda":
        step("Verify: parses multi-parameter lambda")
        val f = \a, b: a + b
        expect(f(20, 22)).to_equal(42)

    it "parses no-parameter lambda":
        step("Verify: parses no-parameter lambda")
        val f = \: 42
        expect(f()).to_equal(42)

    it "uses lambda with map":
        step("Verify: uses lambda with map")
        val arr = [1, 2, 3]
        val doubled = arr.map(_1 * 2)
        expect(doubled[0]).to_equal(2)


# ============================================================================
# Test Group 10: is/in Expressions
# ============================================================================

describe "is/in Expression Parsing":
    # ## Type and Membership Tests
    #
    # Tests parsing of is (type check) and in (membership) operators.

    it "parses is expression":
        step("Verify: parses is expression")
        val opt: Option<i64> = Some(42)
        if let Some(x) = opt:
            expect(x).to_equal(42)

    it "parses in expression":
        step("Verify: parses in expression")
        val list = [1, 2, 3]
        assert_true(2 in list)

    it "parses not in expression":
        step("Verify: parses not in expression")
        val list = [1, 2, 3]
        expect not (5 in list)


# ============================================================================
# Test Group 11: Nested Expressions
# ============================================================================

describe "Nested Expression Parsing":
    # ## Complex Nested Expressions
    #
    # Tests parsing of deeply nested and complex expressions.

    it "parses deeply nested arithmetic":
        step("Verify: parses deeply nested arithmetic")
        val x = ((1 + 2) * (3 + 4)) - ((5 - 6) * (7 - 8))
        expect(x).to_equal(21 - 1)

    it "parses nested collections":
        step("Verify: parses nested collections")
        val arr = [[1, 2], [3, 4]]
        expect(arr[0][1]).to_equal(2)

    it "parses nested method chains":
        step("Verify: parses nested method chains")
        # NOTE: Using intermediate vars as workaround for interpreter chaining limitation
        val arr = [1, 2, 3, 4, 5]
        val filtered1 = arr.filter(_1 > 2)
        val mapped = filtered1.map(_1 * 2)
        val result = mapped.filter(_1 < 10)
        expect(result.len()).to_equal(2)


# ============================================================================
# Test Group 12: Optional Chaining
# ============================================================================

describe "Optional Chaining Expression Parsing":
    # ## Safe Navigation with ?.
    #
    # Tests parsing of optional chaining and null coalescing.

    it "parses optional chaining":
        step("Verify: parses optional chaining")
        val opt: Option<text> = Some("hello")
        val len = opt?.len()
        expect(len).to_equal(Some(5))

    it "parses null coalescing":
        step("Verify: parses null coalescing")
        val opt: Option<i64> = None
        val value = opt ?? 42
        expect(value).to_equal(42)

    it "parses chained optional access":
        step("Verify: parses chained optional access")
        struct User:
            name: Option<text>
        val user: Option<User> = Some(User { name: Some("Alice") })
        val name = user?.name ?? "Unknown"
        expect(name).to_equal("Alice")
