"""
## Purpose and audience
Pins expression-form parsing for the language team: arithmetic with
precedence and unary operators, comparison and logical operators, method and
field access, indexing and slicing, function calls with positional and named
arguments, enum paths, if expressions, lambdas, is/in tests, nested
expressions, and optional chaining with null coalescing.
## Operator workflow
Run the file with the seed binary:
src/compiler_rust/target/bootstrap/simple run test/03_system/feature/usage/parser_expressions_spec.spl
## Compatibility and limitations
Verified against the 2026-09-05 seed binary. Chained method calls use
intermediate variables because the interpreter cannot chain on erased
receivers; `if let Some(x) = opt` is the shipped pattern-match form exercised
by the is-expression scenario.
## Verification guidance and troubleshooting
A failing scenario names the expression form that broke. If the file fails
to load at all, an expression grammar rule stopped parsing and every
scenario in this file is the reproduction.
"""
# Lifecycle: doc/01_research/domain/parser_framework.md ;
# doc/03_plan/agent_tasks/parser_framework.md ;
# doc/04_architecture/parser_framework.md ;
# doc/05_design/parser_framework.md
# @manual_section: expression-parsing

describe "Arithmetic Expression Parsing":
    context "basic operations":
        it "parses addition":
            # @req REQ-PARSER-EXPR-001
            # @capture(bit_table): addition result
            step("Evaluate 1+2 and read the sum")
            val x = 1 + 2
            expect(x).to_equal(3)  # oracle: the addition evaluates to 3

        it "parses subtraction":
            # @req REQ-PARSER-EXPR-002
            # @capture(bit_table): subtraction result
            step("Evaluate 5-3 and read the difference")
            val x = 5 - 3
            expect(x).to_equal(2)  # oracle: the subtraction evaluates to 2

        it "parses multiplication":
            # @req REQ-PARSER-EXPR-003
            # @capture(bit_table): multiplication result
            step("Evaluate 4*5 and read the product")
            val x = 4 * 5
            expect(x).to_equal(20)  # oracle: the multiplication evaluates to 20

        it "parses division":
            # @req REQ-PARSER-EXPR-004
            # @capture(bit_table): division result
            step("Evaluate 10/2 and read the quotient")
            val x = 10 / 2
            expect(x).to_equal(5)  # oracle: the division evaluates to 5

        it "parses modulo":
            # @req REQ-PARSER-EXPR-005
            # @capture(bit_table): modulo remainder
            step("Evaluate 7%3 and read the remainder")
            val x = 7 % 3
            expect(x).to_equal(1)  # oracle: 7 modulo 3 leaves 1

        it "parses power":
            # @req REQ-PARSER-EXPR-006
            # @capture(bit_table): exponentiation result
            step("Evaluate 2**3 and read the power")
            val x = 2 ** 3
            expect(x).to_equal(8)  # oracle: two cubed is 8

        it "parses integer division":
            # @req REQ-PARSER-EXPR-007
            # @capture(bit_table): fdiv method quotient
            step("Evaluate 7.fdiv(3) and read the quotient")
            val x = 7.fdiv(3)
            expect(x).to_equal(2)  # oracle: 7 divided by 3 truncates to 2

    context "operator precedence":
        it "multiplication before addition":
            # @req REQ-PARSER-EXPR-008
            # @capture(bit_table): precedence-sensitive result
            step("Evaluate 2+3*4 and read the precedence-correct result")
            val x = 2 + 3 * 4
            expect(x).to_equal(14)  # oracle: multiplication binds first: 2+12

        it "parentheses override precedence":
            # @req REQ-PARSER-EXPR-009
            # @capture(bit_table): paren-overridden result
            step("Evaluate (2+3)*4 and read the result")
            val x = (2 + 3) * 4
            expect(x).to_equal(20)  # oracle: the parens force 5*4

        it "nested parentheses":
            # @req REQ-PARSER-EXPR-010
            # @capture(bit_table): nested-paren result
            step("Evaluate ((1+2)*3) and read the result")
            val x = ((1 + 2) * 3)
            expect(x).to_equal(9)  # oracle: inner parens evaluate first: 3*3

    context "unary operations":
        it "parses unary minus":
            # @req REQ-PARSER-EXPR-011
            # @capture(bit_table): unary-minus literal equivalence
            step("Bind the unary-minus literal -5 and compare it against subtraction")
            val x = -5
            expect(x == 0 - 5).to_equal(true)  # oracle: unary minus equals the negation of 5

        it "parses bitwise not":
            # @req REQ-PARSER-EXPR-012
            # @capture(bit_table): bitwise-not result
            step("Evaluate ~0 and read the complement")
            val x = ~0
            expect(x).to_equal(-1)  # oracle: the complement of 0 is all bits set: -1

describe "Comparison Expression Parsing":
    it "parses less than":
        # @req REQ-PARSER-EXPR-013
        # @capture(bit_table): less-than truth
        step("Compare 1<2")
        expect (1 < 2) == true  # oracle: one is less than two

    it "parses greater than":
        # @req REQ-PARSER-EXPR-014
        # @capture(bit_table): greater-than truth
        step("Compare 2>1")
        expect (2 > 1) == true  # oracle: two is greater than one

    it "parses less than or equal":
        # @req REQ-PARSER-EXPR-015
        # @capture(bit_table): less-or-equal truth
        step("Compare 2<=2")
        expect (2 <= 2) == true  # oracle: two equals two, so the bound holds

    it "parses greater than or equal":
        # @req REQ-PARSER-EXPR-016
        # @capture(bit_table): greater-or-equal truth
        step("Compare 3>=2")
        expect (3 >= 2) == true  # oracle: three exceeds two

    it "parses equals":
        # @req REQ-PARSER-EXPR-017
        # @capture(bit_table): equality truth
        step("Compare 2==2")
        expect (2 == 2) == true  # oracle: equal operands compare true

    it "parses not equals":
        # @req REQ-PARSER-EXPR-018
        # @capture(bit_table): inequality truth
        step("Compare 1!=2")
        expect (1 != 2) == true  # oracle: distinct operands compare true

describe "Logical Expression Parsing":
    it "parses and":
        # @req REQ-PARSER-EXPR-019
        # @capture(bit_table): conjunction result
        step("Evaluate true and false")
        val x = true and false
        expect(x).to_equal(false)  # oracle: one false operand falsifies the conjunction

    it "parses or":
        # @req REQ-PARSER-EXPR-020
        # @capture(bit_table): disjunction result
        step("Evaluate true or false")
        val x = true or false
        expect(x).to_equal(true)  # oracle: one true operand makes the disjunction true

    it "parses not":
        # @req REQ-PARSER-EXPR-021
        # @capture(bit_table): negation result
        step("Evaluate not true")
        val x = not true
        expect(x).to_equal(false)  # oracle: negating true yields false

    it "parses combined logical":
        # @req REQ-PARSER-EXPR-022
        # @capture(bit_table): grouped logical composition
        step("Evaluate (true and false) or true")
        val x = (true and false) or true
        expect(x).to_equal(true)  # oracle: the false conjunction leaves the true disjunct

describe "Method and Field Access Parsing":
    context "method calls":
        it "parses no-arg method call":
            # @req REQ-PARSER-EXPR-023
            # @capture(bit_table): no-arg method result
            step("Call len() on a three-element array")
            val arr = [1, 2, 3]
            val len = arr.len()
            expect(len).to_equal(3)  # oracle: the method counts three elements

        it "parses method call with args":
            # @req REQ-PARSER-EXPR-024
            # @capture(bit_table): argument-bearing method result
            step("Call contains(2) on a three-element array")
            val arr = [1, 2, 3]
            expect arr.contains(2)  # oracle: the array holds the probed element

        it "parses chained method calls":
            # @req REQ-PARSER-EXPR-025
            # @capture(bit_table): two-stage transform element count
            step("Map then filter an array through intermediate variables")
            val arr = [1, 2, 3]
            val mapped = arr.map(_1 * 2)
            val result = mapped.filter(_1 > 2)
            expect(result.len()).to_equal(2)  # oracle: doubling then filtering keeps 4 and 6

    context "field access":
        it "parses field access":
            # @req REQ-PARSER-EXPR-026
            # @capture(bit_table): direct field read
            step("Read the x field of a constructed Point")
            class Point:
                x: i64
                y: i64
            val p = Point(x: 10, y: 20)
            expect(p.x).to_equal(10)  # oracle: the field stores the constructed 10

        it "parses nested field access":
            # @req REQ-PARSER-EXPR-027
            # @capture(bit_table): two-level field chain
            step("Read through an Outer.inner.value chain")
            class Inner:
                value: i64
            class Outer:
                inner: Inner
            val o = Outer(inner: Inner(value: 42))
            expect(o.inner.value).to_equal(42)  # oracle: the chain reaches the stored 42

describe "Indexing Expression Parsing":
    context "simple indexing":
        it "parses integer index":
            # @req REQ-PARSER-EXPR-028
            # @capture(bit_table): literal-index read
            step("Index element 0 of a literal array")
            val arr = [10, 20, 30]
            expect(arr[0]).to_equal(10)  # oracle: element 0 stores 10

        it "parses variable index":
            # @req REQ-PARSER-EXPR-029
            # @capture(bit_table): variable-index read
            step("Index element i=1 of a literal array")
            val arr = [10, 20, 30]
            val i = 1
            expect(arr[i]).to_equal(20)  # oracle: element 1 stores 20

        it "parses expression index":
            # @req REQ-PARSER-EXPR-030
            # @capture(bit_table): computed-index read
            step("Index with the expression 1+1")
            val arr = [10, 20, 30]
            expect(arr[1 + 1]).to_equal(30)  # oracle: the index evaluates to 2, element 30

        it "parses negative index":
            # @req REQ-PARSER-EXPR-031
            # @capture(bit_table): negative-index read
            step("Index element -1 of a literal array")
            val arr = [10, 20, 30]
            expect(arr[-1]).to_equal(30)  # oracle: the last element is reached from the end

    context "slicing":
        it "parses start end slice":
            # @req REQ-PARSER-EXPR-032
            # @capture(bit_table): bounded slice length
            step("Slice elements 1..4 of a five-element array")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[1:4]
            expect(sliced.len()).to_equal(3)  # oracle: elements 1,2,3 are three items

        it "parses end slice":
            # @req REQ-PARSER-EXPR-033
            # @capture(bit_table): open-start slice length
            step("Slice up to index 3 from the start")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[:3]
            expect(sliced.len()).to_equal(3)  # oracle: elements 0,1,2 are three items

        it "parses start slice":
            # @req REQ-PARSER-EXPR-034
            # @capture(bit_table): open-end slice length
            step("Slice from index 2 to the end")
            val arr = [0, 1, 2, 3, 4]
            val sliced = arr[2:]
            expect(sliced.len()).to_equal(3)  # oracle: elements 2,3,4 are three items

describe "Function Call Expression Parsing":
    context "positional arguments":
        it "parses no-arg call":
            # @req REQ-PARSER-EXPR-035
            # @capture(bit_table): zero-argument call result
            step("Call a zero-argument function")
            fn get_value() -> i64:
                42
            expect(get_value()).to_equal(42)  # oracle: the callee body returns 42

        it "parses single arg call":
            # @req REQ-PARSER-EXPR-036
            # @capture(bit_table): single-argument call result
            step("Call a doubling function with 21")
            fn double(x: i64) -> i64:
                x * 2
            expect(double(21)).to_equal(42)  # oracle: the callee doubles its argument

        it "parses multi-arg call":
            # @req REQ-PARSER-EXPR-037
            # @capture(bit_table): three-argument call result
            step("Call a three-argument sum with 10, 20, 12")
            fn add(a: i64, b: i64, c: i64) -> i64:
                a + b + c
            expect(add(10, 20, 12)).to_equal(42)  # oracle: the three arguments sum to 42

    context "named arguments":
        it "parses named arguments":
            # @req REQ-PARSER-EXPR-038
            # @capture(bit_table): named-argument binding order
            step("Call greet with both arguments named at the call site")
            fn greet(name: text, greeting: text) -> text:
                "{greeting}, {name}!"
            val result = greet(name = "World", greeting = "Hello")
            expect(result).to_equal("Hello, World!")  # oracle: names bind values regardless of order

describe "Path Expression Parsing":
    it "parses enum variant":
        # @req REQ-PARSER-EXPR-039
        # @capture(bit_table): enum path identity
        step("Take Color.Red via its path and compare identity")
        enum Color:
            Red
            Green
            Blue
        val c = Color.Red
        expect(c == Color.Red).to_equal(true)  # oracle: the taken variant is the declared Red

    it "parses nested path":
        # @req REQ-PARSER-EXPR-040
        # @capture(bit_table): callable path resolution
        step("Resolve a callable by name and invoke it")
        fn get_value() -> i64:
            42
        expect(get_value()).to_equal(42)  # oracle: the resolved callee returns 42

describe "Conditional Expression Parsing":
    it "parses if-else expression":
        # @req REQ-PARSER-EXPR-041
        # @capture(bit_table): inline if arm selection
        step("Evaluate an inline if-else on a true condition")
        val x = if true: 1 else: 0
        expect(x).to_equal(1)  # oracle: the true arm produces 1

    it "parses conditional comparison":
        # @req REQ-PARSER-EXPR-042
        # @capture(bit_table): guard-selected maximum
        step("Select the maximum through an if-else expression")
        val a = 10
        val b = 5
        val max = if a > b: a else: b
        expect(max).to_equal(10)  # oracle: the guard selects the larger operand

describe "Lambda Expression Parsing":
    it "parses single parameter lambda":
        # @req REQ-PARSER-EXPR-043
        # @capture(bit_table): single-parameter lambda result
        step("Apply an incrementing lambda to 41")
        val f = \x: x + 1
        expect(f(41)).to_equal(42)  # oracle: the lambda adds one

    it "parses multi-parameter lambda":
        # @req REQ-PARSER-EXPR-044
        # @capture(bit_table): two-parameter lambda result
        step("Apply an adding lambda to 20 and 22")
        val f = \a, b: a + b
        expect(f(20, 22)).to_equal(42)  # oracle: the lambda sums its parameters

    it "parses no-parameter lambda":
        # @req REQ-PARSER-EXPR-045
        # @capture(bit_table): zero-parameter lambda result
        step("Call a constant lambda")
        val f = \: 42
        expect(f()).to_equal(42)  # oracle: the lambda yields its constant

    it "uses lambda with map":
        # @req REQ-PARSER-EXPR-046
        # @capture(bit_table): map-lambda transformed element
        step("Double the first element through map with a lambda")
        val arr = [1, 2, 3]
        val doubled = arr.map(_1 * 2)
        expect(doubled[0]).to_equal(2)  # oracle: the placeholder lambda doubles element 0

describe "is/in Expression Parsing":
    it "parses is expression":
        # @req REQ-PARSER-EXPR-047
        # @capture(bit_table): Some-pattern bound payload
        step("Match a Some value with the if-let form and read the payload")
        val opt: Option<i64> = Some(42)
        if let Some(x) = opt:
            expect(x).to_equal(42)  # oracle: the pattern binds the contained 42

    it "parses in expression":
        # @req REQ-PARSER-EXPR-048
        # @capture(bit_table): membership hit
        step("Probe membership of 2 in the list")
        val list = [1, 2, 3]
        assert_true(2 in list)  # oracle: 2 is a member of the list

    it "parses not in expression":
        # @req REQ-PARSER-EXPR-049
        # @capture(bit_table): membership miss
        step("Probe membership of 5 in the list")
        val list = [1, 2, 3]
        expect not (5 in list)  # oracle: 5 is not a member of the list

describe "Nested Expression Parsing":
    it "parses deeply nested arithmetic":
        # @req REQ-PARSER-EXPR-050
        # @capture(bit_table): four-group nested result
        step("Evaluate a four-group nested arithmetic expression")
        val x = ((1 + 2) * (3 + 4)) - ((5 - 6) * (7 - 8))
        expect(x).to_equal(21 - 1)  # oracle: 3*7 minus minus-one-times-minus-one is 20

    it "parses nested collections":
        # @req REQ-PARSER-EXPR-051
        # @capture(bit_table): double-index collection read
        step("Index a nested array twice")
        val arr = [[1, 2], [3, 4]]
        expect(arr[0][1]).to_equal(2)  # oracle: row 0 element 1 stores 2

    it "parses nested method chains":
        # @req REQ-PARSER-EXPR-052
        # @capture(bit_table): three-stage transform element count
        step("Filter, map, then filter an array through intermediate variables")
        val arr = [1, 2, 3, 4, 5]
        val filtered1 = arr.filter(_1 > 2)
        val mapped = filtered1.map(_1 * 2)
        val result = mapped.filter(_1 < 10)
        expect(result.len()).to_equal(2)  # oracle: 3,4 double to 6,8 and both survive the bound

describe "Optional Chaining Expression Parsing":
    it "parses optional chaining":
        # @req REQ-PARSER-EXPR-053
        # @capture(bit_table): chained length wrapped in Some
        step("Chain len through an optional text")
        val opt: Option<text> = Some("hello")
        val len = opt?.len()
        expect(len).to_equal(Some(5))  # oracle: chaining wraps the length 5 back into Some

    it "parses null coalescing":
        # @req REQ-PARSER-EXPR-054
        # @capture(bit_table): None coalesced to default
        step("Coalesce a None optional to a default")
        val opt: Option<i64> = None
        val value = opt ?? 42
        expect(value).to_equal(42)  # oracle: None falls through to the default 42

    it "parses chained optional access":
        # @req REQ-PARSER-EXPR-055
        # @capture(bit_table): chained optional field with fallback
        step("Chain into a struct field through an optional and coalesce")
        struct User:
            name: Option<text>
        val user: Option<User> = Some(User { name: Some("Alice") })
        val name = user?.name ?? "Unknown"
        expect(name).to_equal("Alice")  # oracle: the present name survives the chain
