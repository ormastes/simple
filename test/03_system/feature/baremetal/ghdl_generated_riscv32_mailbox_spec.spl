"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/baremetal/ghdl_generated_riscv32_mailbox_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/ghdl_generated_riscv32_mailbox_spec.md
# doc-path: doc/03_plan/sys_test/ghdl_generated_riscv32_mailbox_spec.md
# doc-path: doc/04_architecture/ghdl_generated_riscv32_mailbox_spec.md
# doc-path: doc/05_design/ghdl_generated_riscv32_mailbox_spec_oracles.md
# @manual: primary

#!/usr/bin/env simple
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md


use std.spec.step

use std.spec.*


val GENERATED_MAILBOX_RUNNER = "src/lib/nogc_async_mut_noalloc/baremetal/ghdl_generated_rv32_mailbox_runner.shs"
val GENERATED_MAILBOX_SMOKE = "examples/09_embedded/fpga_riscv/sw/generated_rv32_mailbox.s"

extern fn rt_file_exists(path: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn runner_tools_available() -> bool:
    val result = rt_process_run("bash", ["-lc", "command -v ghdl >/dev/null && command -v riscv64-linux-gnu-as >/dev/null && command -v riscv64-linux-gnu-ld >/dev/null && command -v riscv64-linux-gnu-objcopy >/dev/null"])
    result[2] == 0

describe "Generated RV32 GHDL mailbox":
    # @manual scenario evidence
    it "runner script exists and is syntax-valid":
        # @req REQ-SSPEC-SYSTEM
        step("runner script exists and is syntax-valid")
        expect(rt_file_exists(GENERATED_MAILBOX_RUNNER)).to_equal(true)
        val result = rt_process_run("bash", ["-n", GENERATED_MAILBOX_RUNNER])
        expect(result[2]).to_equal(0)

    slow_it "runs a generated RV32 mailbox shell-contract smoke":
        # @req REQ-SSPEC-SYSTEM
        step("runs a generated RV32 mailbox shell-contract smoke")
        if not runner_tools_available():
            return "skip: ghdl or riscv binutils not available"
        val result = rt_process_run_timeout("bash", [GENERATED_MAILBOX_RUNNER, GENERATED_MAILBOX_SMOKE, "--timeout=30"], 120000)
        val output = result[0] + result[1]
        expect(result[2]).to_equal(0)
        expect(output).to_contain("OK")
        expect(output).to_contain("RESULT: pass=1 value=42")
        expect(output).to_contain("[GHDL-GEN-MB] PASS")
