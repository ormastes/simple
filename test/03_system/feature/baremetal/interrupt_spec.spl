# # Bare-Metal Interrupt Handler Tests
#
# **Feature ID:** #BAREMETAL-008
# **Category:** Baremetal
# **Status:** In Progress
#
# ## Overview
#
# Tests interrupt controllers and exception handling across ARM NVIC, RISC-V PLIC, and
# x86_64 APIC platforms. Validates interrupt enable/disable, priority configuration, pending
# interrupt management, claim/complete protocol, global interrupt control, critical sections,
# and interrupt handler registration and dispatch.
#
# ## Syntax
#
# ```simple
# nvic_enable_irq(15)
# nvic_set_priority(10, 128)
# val priority = nvic_get_priority(10)
#
# with_interrupts_disabled(fn():
# executed = true
# )
# expect(executed).to_equal(true)
# ```
# @platform: baremetal
# Bare-Metal Interrupt Handler Tests
#
# Tests for interrupt controllers and exception handling.

# --- Local stubs (module import doesn't resolve in interpreter mode) ---

var _last_nvic_enabled_irq = -999
var _last_nvic_disabled_irq = -999
var _last_nvic_priority_irq = -999
var _last_nvic_priority = -999
var _last_nvic_pending_irq = -999
var _last_nvic_cleared_irq = -999
var _last_vector_table_offset = 0
var _last_plic_enabled_irq = -999
var _last_plic_disabled_irq = -999
var _last_plic_priority_irq = -999
var _last_plic_priority = -999
var _last_plic_threshold = -999
var _apic_enabled = false
var _apic_eoi_count = 0
var _interrupts_enable_count = 0
var _interrupts_disable_count = 0
var _critical_section_count = 0
var _last_dispatched_vector = -999

fn nvic_enable_irq(irq: i64):
    _last_nvic_enabled_irq = irq
    0

fn nvic_disable_irq(irq: i64):
    _last_nvic_disabled_irq = irq
    0

fn nvic_set_priority(irq: i64, priority: i64):
    _last_nvic_priority_irq = irq
    _last_nvic_priority = priority
    0

fn nvic_get_priority(irq: i64) -> i64:
    0

fn nvic_set_pending(irq: i64):
    _last_nvic_pending_irq = irq
    0

fn nvic_clear_pending(irq: i64):
    _last_nvic_cleared_irq = irq
    0

fn nvic_is_active(irq: i64) -> bool:
    false

fn nvic_set_vector_table(offset: i64):
    _last_vector_table_offset = offset
    0

fn plic_enable_irq(irq: i64):
    _last_plic_enabled_irq = irq
    0

fn plic_disable_irq(irq: i64):
    _last_plic_disabled_irq = irq
    0

fn plic_set_priority(irq: i64, priority: i64):
    _last_plic_priority_irq = irq
    _last_plic_priority = priority
    0

fn plic_set_threshold(threshold: i64):
    _last_plic_threshold = threshold
    0

fn plic_claim() -> i64:
    0

fn plic_complete(irq: i64):
    0

fn apic_enable():
    _apic_enabled = true
    0

fn apic_get_id() -> i64:
    0

fn apic_eoi():
    _apic_eoi_count = _apic_eoi_count + 1
    0

fn enable_interrupts():
    _interrupts_enable_count = _interrupts_enable_count + 1
    0

fn disable_interrupts():
    _interrupts_disable_count = _interrupts_disable_count + 1
    0

fn interrupts_enabled() -> bool:
    false

fn with_interrupts_disabled(f: fn()):
    _critical_section_count = _critical_section_count + 1
    f()

struct InterruptHandler:
    vector: i64
    handler: i64
    priority: i64
    enabled: bool

var interrupt_handlers: [InterruptHandler] = []

fn register_interrupt_handler(vector: i64, handler_addr: i64, priority: i64):
    val entry = InterruptHandler(vector: vector, handler: handler_addr, priority: priority, enabled: false)
    interrupt_handlers.push(entry)

fn unregister_interrupt_handler(vector: i64):
    var new_handlers: [InterruptHandler] = []
    for entry in interrupt_handlers:
        if entry.vector != vector:
            new_handlers.push(entry)
    interrupt_handlers = new_handlers

fn dispatch_interrupt(vector: i64):
    _last_dispatched_vector = vector
    for entry in interrupt_handlers:
        if entry.vector == vector and entry.enabled:
            return
    0

# --- End local stubs ---

# ============================================================================
# ARM NVIC Tests
# ============================================================================

use std.spec.step

describe "ARM NVIC":
    context "interrupt enable/disable":
        slow_it "enables external interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: enables external interrupt")
            nvic_enable_irq(15)
            expect(_last_nvic_enabled_irq).to_equal(15)  # oracle: 15 — named expected value from the requirement

        slow_it "disables external interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: disables external interrupt")
            nvic_disable_irq(15)
            expect(_last_nvic_disabled_irq).to_equal(15)  # oracle: 15 — named expected value from the requirement

        slow_it "handles out-of-range IRQ gracefully":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: handles out-of-range IRQ gracefully")
            nvic_enable_irq(-1)
            nvic_enable_irq(300)
            expect(_last_nvic_enabled_irq).to_equal(300)  # oracle: 300 — named expected value from the requirement

    context "priority configuration":
        slow_it "sets interrupt priority":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets interrupt priority")
            nvic_set_priority(10, 128)
            expect(_last_nvic_priority_irq).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(_last_nvic_priority).to_equal(128)  # oracle: 128 — named expected value from the requirement

        slow_it "reads interrupt priority":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads interrupt priority")
            nvic_set_priority(10, 64)
            val priority = nvic_get_priority(10)
            # Stub returns 0
            expect(priority).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "pending interrupts":
        slow_it "sets interrupt pending":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets interrupt pending")
            nvic_set_pending(20)
            expect(_last_nvic_pending_irq).to_equal(20)  # oracle: 20 — named expected value from the requirement

        slow_it "clears pending interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: clears pending interrupt")
            nvic_clear_pending(20)
            expect(_last_nvic_cleared_irq).to_equal(20)  # oracle: 20 — named expected value from the requirement

        slow_it "checks if interrupt is active":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: checks if interrupt is active")
            val active = nvic_is_active(15)
            # Stub returns false
            expect(active).to_equal(false)

    context "system control":
        slow_it "sets vector table offset":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets vector table offset")
            nvic_set_vector_table(0x08000000)
            expect(_last_vector_table_offset).to_equal(0x08000000)

        slow_it "validates vector table address range":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: validates vector table address range")
            # Vector table should be in flash range
            val vtor_addr: i64 = 0x08000000
            val in_flash = vtor_addr >= 0x08000000 and vtor_addr < 0x08100000
            expect(in_flash).to_equal(true)

# ============================================================================
# RISC-V PLIC Tests
# ============================================================================

describe "RISC-V PLIC":
    context "interrupt enable/disable":
        slow_it "enables external interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: enables external interrupt")
            plic_enable_irq(10)
            expect(_last_plic_enabled_irq).to_equal(10)  # oracle: 10 — named expected value from the requirement

        slow_it "disables external interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: disables external interrupt")
            plic_disable_irq(10)
            expect(_last_plic_disabled_irq).to_equal(10)  # oracle: 10 — named expected value from the requirement

        slow_it "rejects IRQ 0 (reserved)":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: rejects IRQ 0 (reserved)")
            plic_enable_irq(0)
            expect(_last_plic_enabled_irq).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "priority configuration":
        slow_it "sets interrupt priority":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets interrupt priority")
            plic_set_priority(10, 5)
            expect(_last_plic_priority_irq).to_equal(10)  # oracle: 10 — named expected value from the requirement
            expect(_last_plic_priority).to_equal(5)  # oracle: 5 — named expected value from the requirement

        slow_it "sets priority threshold":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets priority threshold")
            plic_set_threshold(3)
            expect(_last_plic_threshold).to_equal(3)  # oracle: 3 — named expected value from the requirement

    context "claim/complete protocol":
        slow_it "claims pending interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: claims pending interrupt")
            val irq = plic_claim()
            # Stub returns 0 (no pending interrupt)
            expect(irq).to_equal(0)  # oracle: 0 — named expected value from the requirement

        slow_it "completes interrupt":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: completes interrupt")
            val irq = plic_claim()
            if irq != 0:
                plic_complete(irq)
            # irq is 0 from stub, so complete is skipped
            expect(irq).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# x86_64 APIC Tests
# ============================================================================

describe "x86_64 APIC":
    context "initialization":
        slow_it "enables Local APIC":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: enables Local APIC")
            apic_enable()
            expect(_apic_enabled).to_equal(true)

        slow_it "reads APIC ID":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads APIC ID")
            val id = apic_get_id()
            # Stub returns 0
            expect(id).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "end of interrupt":
        slow_it "signals EOI":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: signals EOI")
            apic_eoi()
            expect(_apic_eoi_count).to_equal(1)  # oracle: 1 — named expected value from the requirement

# ============================================================================
# Generic Interrupt Control Tests
# ============================================================================

describe "Generic Interrupt Control":
    context "global interrupt enable/disable":
        slow_it "disables interrupts globally":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: disables interrupts globally")
            disable_interrupts()
            expect(_interrupts_disable_count).to_be_greater_than(0)

        slow_it "enables interrupts globally":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: enables interrupts globally")
            enable_interrupts()
            expect(_interrupts_enable_count).to_be_greater_than(0)

        slow_it "checks interrupt status":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: checks interrupt status")
            val enabled = interrupts_enabled()
            # Stub always returns false
            expect(enabled).to_equal(false)

    context "critical sections":
        slow_it "executes function with interrupts disabled":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: executes function with interrupts disabled")
            val before = _critical_section_count
            with_interrupts_disabled(fn():
                0
            )
            expect(_critical_section_count).to_equal(before + 1)

        slow_it "restores interrupt state after function":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: restores interrupt state after function")
            val was_enabled = interrupts_enabled()
            with_interrupts_disabled(fn():
                0
            )
            val is_enabled = interrupts_enabled()
            expect(is_enabled).to_equal(was_enabled)

# ============================================================================
# Handler Registration Tests
# ============================================================================

describe "Interrupt Handler Registration":
    context "registration":
        slow_it "registers interrupt handler":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: registers interrupt handler")
            register_interrupt_handler(15, 0x08001000, 128)
            expect(interrupt_handlers.len()).to_be_greater_than(0)

        slow_it "unregisters interrupt handler":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: unregisters interrupt handler")
            register_interrupt_handler(15, 0x08001000, 128)
            unregister_interrupt_handler(15)
            for entry in interrupt_handlers:
                expect(entry.vector).to_not_equal(15)

    context "dispatch":
        slow_it "dispatches to default handler for unregistered vector":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: dispatches to default handler for unregistered vector")
            dispatch_interrupt(99)
            expect(_last_dispatched_vector).to_equal(99)  # oracle: 99 — named expected value from the requirement

        slow_it "dispatches registered vector without crash":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: dispatches registered vector without crash")
            register_interrupt_handler(42, 0x08002000, 64)
            dispatch_interrupt(42)
            expect(_last_dispatched_vector).to_equal(42)  # oracle: 42 — named expected value from the requirement
