# # Bare-Metal Syscall and Peripheral Tests
#
# **Feature ID:** #BAREMETAL-011
# **Category:** Baremetal
# **Status:** In Progress
#
# ## Overview
#
# Tests bare-metal syscall wrappers including semihosting operations (debug console output,
# file I/O, timing), UART configuration and byte transmission, timer initialization and delay
# functions, and memory-mapped I/O register access with bit manipulation. All tests operate
# on hardware register addresses and verify peripheral interaction patterns.
#
# ## Syntax
#
# ```simple
# semi_write_string("Test message\n")
# uart_init(0x40011000, 115200)
# timer_delay_ms(0x40000000, 10)
# mem_write_u32(0x40020000, 0x12345678)
# mem_set_bit(0x40020000, 5)
# ```
# @platform: baremetal
# Bare-Metal Syscall Tests
#
# Tests for syscall wrappers (semihosting, UART, timers, MMIO).

# --- Local stubs (module import doesn't resolve in interpreter mode) ---

val MODE_READ: i64 = 0
val MODE_WRITE: i64 = 4
val MODE_APPEND: i64 = 8
var _semi_last_message = ""
var _uart_last_base = 0
var _uart_last_baudrate = 0
var _timer_last_base = 0
var _timer_last_frequency = 0
var _timer_last_delay_ms = 0
var _timer_last_delay_us = 0
var _last_set_bit = -1
var _last_clear_bit = -1
var _last_modify_clear_mask = 0
var _last_modify_set_mask = 0

fn semi_write_string(message: text):
    _semi_last_message = message
    0

fn semi_clock() -> i64:
    0

fn semi_time() -> i64:
    0

fn semi_open(path: text, mode: i64) -> i64:
    -1

fn semi_write(fd: i64, buffer: [i64], length: i64) -> i64:
    0

fn semi_close(fd: i64) -> bool:
    false

fn uart_init(base_addr: i64, baudrate: i64):
    _uart_last_base = base_addr
    _uart_last_baudrate = baudrate
    0

fn uart_write_ready(base_addr: i64) -> bool:
    false

fn uart_read_available(base_addr: i64) -> bool:
    false

fn timer_init(base_addr: i64, frequency: i64):
    _timer_last_base = base_addr
    _timer_last_frequency = frequency
    0

fn timer_read(base_addr: i64) -> i64:
    0

fn timer_delay_ms(base_addr: i64, milliseconds: i64):
    _timer_last_base = base_addr
    _timer_last_delay_ms = milliseconds
    0

fn timer_delay_us(base_addr: i64, microseconds: i64):
    _timer_last_base = base_addr
    _timer_last_delay_us = microseconds
    0

fn mem_read_u32(addr: i64) -> i64:
    0

fn mem_write_u32(addr: i64, value: i64):
    0

fn mem_read_u8(addr: i64) -> i64:
    0

fn mem_write_u8(addr: i64, value: i64):
    0

fn mem_set_bit(addr: i64, bit: i64):
    _last_set_bit = bit
    0

fn mem_clear_bit(addr: i64, bit: i64):
    _last_clear_bit = bit
    0

fn mem_test_bit(addr: i64, bit: i64) -> bool:
    false

fn mem_modify_bits(addr: i64, clear_mask: i64, set_mask: i64):
    _last_modify_clear_mask = clear_mask
    _last_modify_set_mask = set_mask
    0

# --- End local stubs ---

# ============================================================================
# Semihosting Tests
# ============================================================================

use std.spec.step

describe "Semihosting":
    context "basic operations":
        slow_it "writes string to debug console":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: writes string to debug console")
            semi_write_string("Test message\n")
            expect(_semi_last_message).to_equal("Test message\n")

        slow_it "reads clock in centiseconds":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads clock in centiseconds")
            val time1 = semi_clock()
            # Stub returns 0
            expect(time1).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "file I/O":
        slow_it "opens file for reading":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: opens file for reading")
            val fd = semi_open("test.txt", MODE_READ)
            # Stub returns -1 (no host filesystem)
            expect(fd).to_equal(-1)  # oracle: -1 — named expected value from the requirement

        slow_it "writes to file":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: writes to file")
            val fd = semi_open("output.txt", MODE_WRITE)
            # fd is -1, so write is skipped
            if fd >= 0:
                semi_write(fd, [], 0)
                semi_close(fd)
            expect(fd).to_equal(-1)  # oracle: -1 — named expected value from the requirement

    context "timing":
        slow_it "reads time since epoch":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads time since epoch")
            val t = semi_time()
            # Stub returns 0
            expect(t).to_equal(0)  # oracle: 0 — named expected value from the requirement

# ============================================================================
# UART Tests
# ============================================================================

describe "UART":
    context "initialization":
        slow_it "configures UART with baud rate":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: configures UART with baud rate")
            uart_init(0x40011000, 115200)
            expect(_uart_last_base).to_equal(0x40011000)
            expect(_uart_last_baudrate).to_equal(115200)  # oracle: 115200 — named expected value from the requirement

    context "status checking":
        slow_it "checks if UART ready to write":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: checks if UART ready to write")
            val ready = uart_write_ready(0x40011000)
            # Stub returns false
            expect(ready).to_equal(false)

        slow_it "checks if data available to read":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: checks if data available to read")
            val available = uart_read_available(0x40011000)
            # Stub returns false
            expect(available).to_equal(false)

# ============================================================================
# Timer Tests
# ============================================================================

describe "Timer":
    context "initialization":
        slow_it "configures timer frequency":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: configures timer frequency")
            timer_init(0x40000000, 1000000)
            expect(_timer_last_base).to_equal(0x40000000)
            expect(_timer_last_frequency).to_equal(1000000)  # oracle: 1000000 — named expected value from the requirement

    context "counter access":
        slow_it "reads current counter value":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads current counter value")
            val count = timer_read(0x40000000)
            # Stub returns 0
            expect(count).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "delays":
        slow_it "delays for milliseconds":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: delays for milliseconds")
            timer_delay_ms(0x40000000, 10)
            expect(_timer_last_delay_ms).to_equal(10)  # oracle: 10 — named expected value from the requirement

        slow_it "delays for microseconds":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: delays for microseconds")
            timer_delay_us(0x40000000, 100)
            expect(_timer_last_delay_us).to_equal(100)  # oracle: 100 — named expected value from the requirement

# ============================================================================
# Memory-Mapped I/O Tests
# ============================================================================

describe "Memory-Mapped I/O":
    context "register access":
        slow_it "reads and writes 32-bit registers":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads and writes 32-bit registers")
            mem_write_u32(0x40020000, 0x12345678)
            val value = mem_read_u32(0x40020000)
            # Stub: write is no-op, read returns 0
            expect(value).to_equal(0)  # oracle: 0 — named expected value from the requirement

        slow_it "reads and writes 8-bit registers":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: reads and writes 8-bit registers")
            mem_write_u8(0x40020000, 0xAB)
            val value = mem_read_u8(0x40020000)
            # Stub: write is no-op, read returns 0
            expect(value).to_equal(0)  # oracle: 0 — named expected value from the requirement

    context "bit manipulation":
        slow_it "sets specific bit":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: sets specific bit")
            mem_set_bit(0x40020000, 5)
            expect(_last_set_bit).to_equal(5)  # oracle: 5 — named expected value from the requirement

        slow_it "clears specific bit":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: clears specific bit")
            mem_clear_bit(0x40020000, 3)
            expect(_last_clear_bit).to_equal(3)  # oracle: 3 — named expected value from the requirement

        slow_it "tests specific bit":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: tests specific bit")
            val is_set = mem_test_bit(0x40020000, 7)
            # Stub returns false
            expect(is_set).to_equal(false)

        slow_it "modifies bits with mask":
            # @req: REQ-FEATURE-BAREMETAL-001
            step("Verify: modifies bits with mask")
            mem_modify_bits(0x40020000, 0x0F, 0xA0)
            expect(_last_modify_clear_mask).to_equal(0x0F)
            expect(_last_modify_set_mask).to_equal(0xA0)
