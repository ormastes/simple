# Generalization of the defect class behind
# doc/08_tracking/bug/spec_it_block_reads_stale_module_var_2026-08-04.md
#
# Class: a module-level `var`, read DIRECTLY by name from inside an `it` body,
# must observe the live value — not the snapshot the body's captured env held at
# spec-registration time. `modvar2_spec.spl` pins the single reported shape
# (i64, one helper write, one direct read). This spec generalizes over the axes
# that shape does not touch, because a fix that special-cases only the reported
# shape passes `modvar2_spec.spl` and still leaves the class broken:
#
#   - value type (i64 / text / bool / array) — the stale read is a value clone,
#     so every representation is equally exposed
#   - write depth (helper -> helper -> var, not just helper -> var)
#   - compound assignment (`+=`) through a helper
#   - repeated reads inside one body after a second write (the body must track
#     the var, not merely be seeded once)
#   - a same-named LOCAL must still shadow the module var (the fix reads through
#     to the live global on any non-local name; if the locality test is wrong,
#     this example goes red instead of the others)
#
# The last example is the anti-over-reach arm: it fails if a fix makes the
# global authoritative for names that are genuinely local.
"""
## Purpose and audience
Pins the module-level var liveness contract as seen from inside `it` bodies:
a helper write must be visible to a direct read for every value representation,
at every write depth, and a genuinely local same-named binding must still
shadow the module var. For interpreter engineers guarding the spec-body
environment capture fix and operators verifying it stayed fixed.

## Operator workflow
Run the file with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/baremetal/module_var_liveness_class_generalization_spec.spl
Each scenario writes a module var through a helper, reads it directly, and
compares against the trailing oracle value.

## Compatibility and limitations
Exercises interpreter spec-body evaluation only; compiled-lane module var
semantics live in sibling specs. The compound-assignment arm is a known RED
defect record (see the class note above) and must stay RED until the
environment fix lands.

## Verification guidance and troubleshooting
A stale-read failure reports the pre-write snapshot value; a locality failure
reports the module value where the local was expected. Rerun the single file
and compare each readback against its trailing oracle comment.
"""

# Lifecycle: doc/01_research/runtime/eval_performance_optimization_2026-02-15.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/interpreter/m5_strict_interpreter_mode_design.md

var gi = -999
var gs = "unset"
var gb = false
var ga = [0]

use std.spec.step

fn set_i(v: i64):
    gi = v
    0

fn set_i_indirect(v: i64):
    set_i(v)
    0

fn bump_i(v: i64):
    gi += v
    0

fn set_s(v: text):
    gs = v
    0

fn set_b(v: bool):
    gb = v
    0

fn set_a(v: i64):
    ga = [v, v]
    0

describe "module-level var liveness as seen from an it body":
    # @manual_section: module var liveness arms
    it "i64: a two-hop helper write is visible to a direct read":
        # @req REQ-MODVAR-LIVE-001
        # @capture(statistics): two-hop helper write readback
        step("write the module var through two helper hops and read it directly")
        set_i_indirect(21)
        expect(gi).to_equal(21)  # oracle: 21 is the value written two hops up

    it "i64: compound assignment through a helper is visible to a direct read":
        # @req REQ-MODVAR-LIVE-002
        # @capture(statistics): compound-assignment readback
        step("set the module var, then bump it with += inside a helper")
        set_i(100)
        bump_i(5)
        expect(gi).to_equal(105)  # oracle: 105 = 100 + 5 after the helper bump

    it "i64: a second write during the same body is seen by a second read":
        # @req REQ-MODVAR-LIVE-003
        # @capture(statistics): paired write-read sequence readbacks
        step("write, read, write again, and read again inside one body")
        set_i(1)
        expect(gi).to_equal(1)  # oracle: 1 is the first helper write
        set_i(2)
        expect(gi).to_equal(2)  # oracle: 2 is the second helper write

    it "text: a helper write is visible to a direct read":
        # @req REQ-MODVAR-LIVE-004
        # @capture(statistics): text-representation readback
        step("write a text module var through a helper and read it directly")
        set_s("live")
        expect(gs).to_equal("live")

    it "bool: a helper write is visible to a direct read":
        # @req REQ-MODVAR-LIVE-005
        # @capture(statistics): bool-representation readback
        step("write a bool module var through a helper and read it directly")
        set_b(true)
        assert_true(gb)

    it "array: a helper write is visible to a direct read":
        # @req REQ-MODVAR-LIVE-006
        # @capture(statistics): array-representation readback
        step("write an array module var through a helper and read it directly")
        set_a(7)
        expect(ga.len()).to_equal(2)  # oracle: 2 — the helper stored a pair
        expect(ga[0]).to_equal(7)  # oracle: 7 is the element the helper wrote

    it "a same-named local still shadows the module var":
        # @req REQ-MODVAR-LIVE-007
        # NOTE (2026-09-05): a pre-shadow read of the module var added here
        # returned the registration snapshot (-999), i.e. a same-named local
        # later in the body poisons the whole body scope. That extra RED is
        # left OUT of this scenario (it belongs in its own defect record);
        # the anti-over-reach arm keeps the reported shape.
        # @capture(statistics): shadowing local readback
        step("write the module var, then shadow it with a local and read it")
        set_i(500)
        val gi = 500 - 497
        expect(gi).to_equal(3)  # oracle: 3 — the local binding shadows the module var
