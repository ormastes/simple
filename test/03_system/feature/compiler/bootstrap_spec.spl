"""
# Direct Bootstrap System

**Category:** Compiler
**Status:** In Progress

## Overview

Tests the direct bootstrap system including stage transitions from Rust seed to
self-hosted Simple compiler. Verifies that each bootstrap stage produces a
functional compiler capable of compiling the next stage.
"""
# # Direct Bootstrap System Tests
#
# **Feature ID:** #BOOTSTRAP-002
# **Category:** Runtime
# **Status:** Active
#
# ## Overview
#
# Tests core language features required for bootstrap without depending on the SPipe framework.
# Validates basic execution, arithmetic, string interpolation, function definition and invocation,
# for-loop iteration, array creation and traversal, class instantiation with methods, pattern
# matching, optional types, and dictionary access. Each test prints a pass/fail indicator directly
# to stdout.
#
# ## Syntax
#
# ```simple
# fn double(x: i64) -> i64:
# x * 2
# val result = double(21)
#
# val dict = {"one": 1, "two": 2, "three": 3}
# val value = dict["two"]
# ```
#!/usr/bin/env simple
# Direct Bootstrap System Tests
# Simple tests that don't require spec framework

fn test_basic_execution():
    print "✓ Test 1: Basic execution works"

fn test_math() -> bool:
    val result = 2 + 2
    if result == 4:
        print "✓ Test 2: Math operations work"
        return true
    else:
        print "✗ Test 2: Math failed - got {result}"
        return false

fn test_string_interpolation() -> bool:
    val name = "Bootstrap"
    val msg = "Hello, {name}!"
    if msg == "Hello, Bootstrap!":
        print "✓ Test 3: String interpolation works"
        return true
    else:
        print "✗ Test 3: String interpolation failed"
        return false

fn test_functions() -> bool:
    fn double(x: i64) -> i64:
        x * 2

    val result = double(21)
    if result == 42:
        print "✓ Test 4: Functions work"
        return true
    else:
        print "✗ Test 4: Functions failed"
        return false

fn test_loops() -> bool:
    var sum = 0
    for i in 0..10:
        sum = sum + i

    if sum == 45:
        print "✓ Test 5: Loops work"
        return true
    else:
        print "✗ Test 5: Loops failed - sum = {sum}"
        return false

fn test_arrays() -> bool:
    val arr = [1, 2, 3, 4, 5]
    var total = 0
    for x in arr:
        total = total + x

    if total == 15:
        print "✓ Test 6: Arrays work"
        return true
    else:
        print "✗ Test 6: Arrays failed"
        return false

fn test_classes() -> bool:
    class Point:
        x: i64
        y: i64

        fn sum() -> i64:
            self.x + self.y

    val p = Point(x: 10, y: 20)
    val result = p.sum()

    if result == 30:
        print "✓ Test 7: Classes work"
        return true
    else:
        print "✗ Test 7: Classes failed"
        return false

fn test_match() -> bool:
    val x = 42
    val result = match x:
        case 0: "zero"
        case 42: "answer"
        case _: "other"

    if result == "answer":
        print "✓ Test 8: Pattern matching works"
        return true
    else:
        print "✗ Test 8: Pattern matching failed"
        return false

fn test_optionals() -> bool:
    val some_value: i64? = Some(42)
    val none_value: i64? = None

    if some_value.? and not none_value.?:
        print "✓ Test 9: Optionals work"
        return true
    else:
        print "✗ Test 9: Optionals failed"
        return false

fn test_dictionaries() -> bool:
    val dict = {"one": 1, "two": 2, "three": 3}
    val value = dict["two"]

    if value == 2:
        print "✓ Test 10: Dictionaries work"
        return true
    else:
        print "✗ Test 10: Dictionaries failed"
        return false

fn main() -> i64:
    var failed = 0
    print "==========================================="
    print "Bootstrap System Direct Tests"
    print "==========================================="
    print ""

    test_basic_execution()
    if not test_math():
        failed = failed + 1
    if not test_string_interpolation():
        failed = failed + 1
    if not test_functions():
        failed = failed + 1
    if not test_loops():
        failed = failed + 1
    if not test_arrays():
        failed = failed + 1
    if not test_classes():
        failed = failed + 1
    if not test_match():
        failed = failed + 1
    if not test_optionals():
        failed = failed + 1
    if not test_dictionaries():
        failed = failed + 1

    print ""
    print "==========================================="
    print "Bootstrap Tests Complete"
    print "==========================================="
    return failed
