# @req: REQ-FEATURE-STORAGE-LAYOUT-001


use std.spec.{describe, it, assert_equal, assert_true, assert_false}
use std.common.structural.storage_layout.storage_layout_contracts.{
    StorageConversionPolicy, StorageLayoutKind, storage_layout_plan_v1
}
use compiler.mir_opt.mir_opt.storage_projection_lowering.{
    MIR_STORAGE_PROJECT_ADDRESS_V1, mir_storage_address_recipe_v1,
    mir_storage_field_binding_v1, mir_storage_view_binding_v1
}
use compiler.mir.mir_data.*
use compiler.backend.native.isel_x86_64.{isel_module}
use compiler.backend.native.regalloc.{regalloc_module}
use compiler.backend.native.encode_x86_64.{encode_module}
use compiler.backend.native.mach_inst.{
    X86_OP_ADD, X86_OP_ADD_IMM, X86_OP_IMUL, X86_OP_MOV_MEM_REG,
    X86_OP_MOV_REG_MEM, X86_OP_NOP
}
use compiler.loader.loader.smf_mmap_native.{
    native_alloc_rw_memory, native_write_exec_memory, native_make_executable,
    native_flush_icache, native_get_function_pointer, native_call_function_3,
    native_mmap_read_bytes, native_free_exec_memory, native_munmap
}
use compiler.common.diagnostics.span.{Span}
use compiler.hir.hir_types.{SymbolId}

extern fn rt_ptr_write_i64(address: i64, offset: i64, value: i64) -> i64

fn execution_plan(layout: StorageLayoutKind):
    storage_layout_plan_v1(7201, layout, 1, 8, false,
        StorageConversionPolicy.Cached, "wp22-native-exec-v1", "typed-host-view")

fn execution_recipe(layout: StorageLayoutKind):
    mir_storage_address_recipe_v1(
        mir_storage_view_binding_v1(7201, 4, 5, 128, 24, false,
            execution_plan(layout), [
                mir_storage_field_binding_v1(0, 0, 8, 0),
                mir_storage_field_binding_v1(1, 8, 8, 40),
                mir_storage_field_binding_v1(2, 16, 8, 80)
            ]), 1)

fn execution_module(scale: i64, base_offset: i64) -> MirModule:
    val i64_type = MirType(kind: MirTypeKind.I64)
    val ptr_type = MirType(kind: MirTypeKind.Ptr(pointee: i64_type, mutable: true))
    val locals = [
        MirLocal(id: LocalId(id: 0), name: Some("base"), type_: ptr_type, kind: LocalKind.Arg(0)),
        MirLocal(id: LocalId(id: 1), name: Some("index"), type_: i64_type, kind: LocalKind.Arg(1)),
        MirLocal(id: LocalId(id: 2), name: Some("value"), type_: i64_type, kind: LocalKind.Arg(2)),
        MirLocal(id: LocalId(id: 3), name: Some("address"), type_: ptr_type, kind: LocalKind.Temp),
        MirLocal(id: LocalId(id: 4), name: Some("loaded"), type_: i64_type, kind: LocalKind.Temp)
    ]
    val instructions = [
        MirInst(kind: MirInstKind.Intrinsic(
            Some(LocalId(id: 3)), MIR_STORAGE_PROJECT_ADDRESS_V1, [
                MirOperand.copy(LocalId(id: 0)), MirOperand.copy(LocalId(id: 1)),
                MirOperand.const_int(scale), MirOperand.const_int(base_offset)
            ]), span: nil),
        MirInst(kind: MirInstKind.Store(
            MirOperand.copy(LocalId(id: 3)), MirOperand.copy(LocalId(id: 2))), span: nil),
        MirInst(kind: MirInstKind.Load(
            LocalId(id: 4), MirOperand.copy(LocalId(id: 3))), span: nil)
    ]
    val function = MirFunction(
        symbol: SymbolId.new(0), name: "storage_project_store_load",
        signature: MirSignature(params: [ptr_type, i64_type, i64_type],
            return_type: i64_type, is_variadic: false),
        locals: locals, blocks: [MirBlock(
            id: BlockId.new(0), label: Some("entry"), instructions: instructions,
            terminator: MirTerminator.Ret(Some(MirOperand.copy(LocalId(id: 4)))))],
        entry_block: BlockId.new(0),
        span: Span(start: 0, end: 0, line: 1, col: 1), generic_params: [],
        is_generic_template: false, specialization_of: nil, type_bindings: {})
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[SymbolId.new(0)] = function
    MirModule(name: "storage_projection_execution", functions: functions,
        statics: {}, constants: {}, types: {})

fn assert_selected_operations(module: MirModule):
    val selected = isel_module(module)
    var saw_mul = false
    var saw_add = false
    var saw_offset = false
    var saw_store = false
    var saw_load = false
    for block in selected.functions[0].blocks:
        for instruction in block.insts:
            if instruction.opcode == X86_OP_IMUL: saw_mul = true
            if instruction.opcode == X86_OP_ADD: saw_add = true
            if instruction.opcode == X86_OP_ADD_IMM: saw_offset = true
            if instruction.opcode == X86_OP_MOV_MEM_REG: saw_store = true
            if instruction.opcode == X86_OP_MOV_REG_MEM: saw_load = true
            assert_false(instruction.opcode == X86_OP_NOP)
    assert_true(saw_mul and saw_add and saw_offset and saw_store and saw_load)

fn encoded_execution_bytes(module: MirModule) -> [u8]:
    val encoded = encode_module(regalloc_module(isel_module(module)))[0].code
    var bytes: [u8] = []
    for byte in encoded: bytes.push(byte as u8)
    bytes

fn assert_value_bytes(bytes: [u8], offset: i64):
    val expected: [i64] = [0x88, 0x77, 0x66, 0x55, 0x44, 0x33, 0x22, 0x11]
    for index in 0..8:
        assert_equal(bytes[offset + index] as i64, expected[index])

fn execute_projection(layout: StorageLayoutKind, expected_scale: i64,
                      expected_base: i64, expected_offset: i64,
                      untouched_offset: i64):
    val recipe = execution_recipe(layout)
    assert_true(recipe.ok)
    assert_equal(recipe.scale, expected_scale)
    assert_equal(recipe.base_offset, expected_base)
    val module = execution_module(recipe.scale, recipe.base_offset)
    assert_selected_operations(module)
    val code = encoded_execution_bytes(module)
    assert_true(code.len() > 0)
    val code_address = native_alloc_rw_memory(code.len())
    val data_address = native_alloc_rw_memory(128)
    assert_true(code_address != 0 and data_address != 0)
    _ = rt_ptr_write_i64(data_address, expected_offset - 8, 0x0102030405060708)
    _ = rt_ptr_write_i64(data_address, expected_offset + 8, 0x2122232425262728)
    assert_equal(native_write_exec_memory(code_address, code, 0), code.len())
    assert_true(native_make_executable(code_address, code.len()))
    native_flush_icache(code_address, code.len())
    val result = native_call_function_3(native_get_function_pointer(code_address),
        data_address, 3, 0x1122334455667788)
    assert_equal(result, 0x1122334455667788)
    val bytes = native_mmap_read_bytes(data_address, 0, 128)
    assert_equal(bytes.len(), 128)
    assert_value_bytes(bytes, expected_offset)
    for index in 0..8:
        assert_equal(bytes[untouched_offset + index], 0)
    val before_expected: [i64] = [0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01]
    for index in 0..8:
        assert_equal(bytes[expected_offset - 8 + index] as i64, before_expected[index])
    val after_expected: [i64] = [0x28, 0x27, 0x26, 0x25, 0x24, 0x23, 0x22, 0x21]
    for index in 0..8:
        assert_equal(bytes[expected_offset + 8 + index] as i64, after_expected[index])
    assert_true(native_free_exec_memory(code_address, code.len()))
    assert_true(native_munmap(data_address, 128))

use std.spec.step

describe "custom-native typed storage projection execution":
    it "stores and loads through distinct AoS and SoA addresses":
        # @req: REQ-FEATURE-STORAGE-LAYOUT-001
        step("Verify: stores and loads through distinct AoS and SoA addresses")
        execute_projection(StorageLayoutKind.AoS, 24, 8, 80, 64)
        execute_projection(StorageLayoutKind.SoA, 8, 40, 64, 80)
        print "STORAGE_LAYOUT_NATIVE_PARITY_PASS aos_offset=80 soa_offset=64"
