"""
## Purpose and audience
Purpose: creates new builder with empty state
Audience: compiler and tooling engineers who maintain this spec

# GOT/PLT Builder for Native Backend

**Category:** Compiler
**Status:** In Progress

## Overview

Tests the GOT (Global Offset Table) and PLT (Procedure Linkage Table) generation
for the native backend. Verifies that dynamic symbol references are correctly
resolved through GOT/PLT entries for position-independent executables.
"""

# @req: REQ-FEATURE-GotPlt-001
# # GOT/PLT Builder for Native Backend
#
# **Feature ID:** #COMPILER-002
# **Category:** Compiler
# **Status:** Active
#
# ## Overview
#
# Tests the Global Offset Table (GOT) and Procedure Linkage Table (PLT) builder for the native
# x86_64 backend. Validates basic structure creation, GOT/PLT size calculations (8 bytes per GOT
# entry, 16 bytes per PLT entry), x86_64 PLT stub generation including JMP opcode encoding and
# RIP-relative addressing, symbol management with deduplication, sequential index assignment,
# correct GOT offset allocation, and little-endian i32 encoding for the helper functions.
#
# ## Syntax
#
# ```simple
# var builder = GotPltBuilder(got_entries: [], plt_entries: [], got_size: 0, plt_size: 0, next_got_offset: 0, next_plt_index: 0)
# val index = builder.add_symbol("printf")
# expect(builder.got_entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
#
# val stub = generate_plt_stub_x86_64(0, 0)
# expect(stub[0]).to_equal(0xFF)
# expect(stub.len()).to_equal(16)  # oracle: value fixed by the spec contract
# ```
use compiler.backend.native.got_plt_builder.{GotPltBuilder, generate_plt_stub_x86_64, encode_i32_le, create_plt_section_data}

use std.spec.step
describe "GOT/PLT Builder - Basic Structure":
    it "creates new builder with empty state":
        step("Verify: creates new builder with empty state")
        # @req: REQ-FEATURE-GotPlt-001
        val builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        expect(builder.got_entries.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(builder.plt_entries.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(builder.next_got_offset).to_equal(0)  # oracle: value fixed by the spec contract
        expect(builder.next_plt_index).to_equal(0)  # oracle: value fixed by the spec contract

    it "calculates GOT size correctly":
        step("Verify: calculates GOT size correctly")
        # @req: REQ-FEATURE-GotPlt-001
        val builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 24,  # 3 entries * 8 bytes
            next_plt_index: 0
        )
        expect(builder.get_got_size()).to_equal(24)  # oracle: value fixed by the spec contract

    it "calculates PLT size correctly":
        step("Verify: calculates PLT size correctly")
        # @req: REQ-FEATURE-GotPlt-001
        val builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 3  # 3 entries
        )
        expect(builder.get_plt_size()).to_equal(64)  # (3 + 1 PLT[0]) * 16 bytes

describe "GOT/PLT Builder - PLT Size Matches Actual Section Data":
    it "get_plt_size() equals the real create_plt_section_data() byte length":
        step("Verify: get_plt_size() equals the real create_plt_section_data() byte length")
        # @req: REQ-FEATURE-GotPlt-001
        # create_plt_section_data() always prepends the 16-byte PLT[0]
        # resolver entry before the per-symbol stubs (see create_plt0_entry).
        # get_plt_size() must therefore be (next_plt_index + 1) * 16, not
        # next_plt_index * 16 -- otherwise callers who size-allocate the PLT
        # section from get_plt_size() under-allocate by one entry (16 bytes).
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        builder.add_symbol("printf")
        builder.add_symbol("malloc")
        builder.add_symbol("free")
        val actual_data = create_plt_section_data(builder)
        expect(builder.get_plt_size()).to_equal(actual_data.len())

describe "GOT/PLT Builder - PLT Stub Generation":
    it "generates valid x86_64 PLT stub":
        step("Verify: generates valid x86_64 PLT stub")
        # @req: REQ-FEATURE-GotPlt-001
        val stub = generate_plt_stub_x86_64(0, 0)
        # Should be 16 bytes
        expect(stub.len()).to_equal(16)  # oracle: value fixed by the spec contract
        # First byte should be 0xFF (JMP opcode)
        expect(stub[0]).to_equal(0xFF)
        # Second byte should be 0x25 (ModRM for RIP-relative)
        expect(stub[1]).to_equal(0x25)

    it "includes PLT index in stub":
        step("Verify: includes PLT index in stub")
        # @req: REQ-FEATURE-GotPlt-001
        val stub = generate_plt_stub_x86_64(42, 0)
        # Byte 6 should be 0x68 (PUSH opcode)
        expect(stub[6]).to_equal(0x68)
        # Bytes 7-10 should encode 42 in little-endian
        expect(stub[7]).to_equal(42)  # oracle: value fixed by the spec contract
        expect(stub[8]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stub[9]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stub[10]).to_equal(0)  # oracle: value fixed by the spec contract

    it "includes GOT offset in stub":
        step("Verify: includes GOT offset in stub")
        # @req: REQ-FEATURE-GotPlt-001
        val stub = generate_plt_stub_x86_64(0, 256)
        # Bytes 2-5 encode GOT offset (256) in little-endian
        expect(stub[2]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stub[3]).to_equal(1)  # 256 = 0x0100
        expect(stub[4]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stub[5]).to_equal(0)  # oracle: value fixed by the spec contract

describe "GOT/PLT Builder - Symbol Management":
    it "adds first symbol correctly":
        step("Verify: adds first symbol correctly")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        val index = builder.add_symbol("printf")
        expect(index).to_equal(0)  # oracle: value fixed by the spec contract
        expect(builder.got_entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(builder.plt_entries.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "allocates GOT entry with correct offset":
        step("Verify: allocates GOT entry with correct offset")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        builder.add_symbol("malloc")
        val entry = builder.got_entries[0]
        expect(entry.symbol).to_equal("malloc")
        expect(entry.offset).to_equal(0)  # oracle: value fixed by the spec contract

    it "increments GOT offset by 8 bytes per symbol":
        step("Verify: increments GOT offset by 8 bytes per symbol")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        builder.add_symbol("printf")
        builder.add_symbol("malloc")
        expect(builder.next_got_offset).to_equal(16)  # oracle: value fixed by the spec contract

    it "reuses existing symbol without duplication":
        step("Verify: reuses existing symbol without duplication")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        val idx1 = builder.add_symbol("printf")
        val idx2 = builder.add_symbol("printf")
        expect(idx1).to_equal(idx2)
        expect(builder.plt_entries.len()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(builder.got_entries.len()).to_equal(1)  # oracle: value fixed by the spec contract

describe "GOT/PLT Builder - Multiple Symbols":
    it "handles multiple unique symbols":
        step("Verify: handles multiple unique symbols")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        builder.add_symbol("printf")
        builder.add_symbol("malloc")
        builder.add_symbol("free")
        expect(builder.plt_entries.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(builder.got_entries.len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(builder.get_got_size()).to_equal(24)  # 3 * 8 bytes
        expect(builder.get_plt_size()).to_equal(64)  # (3 + 1 PLT[0]) * 16 bytes

    it "assigns sequential indices to symbols":
        step("Verify: assigns sequential indices to symbols")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        val idx0 = builder.add_symbol("printf")
        val idx1 = builder.add_symbol("malloc")
        val idx2 = builder.add_symbol("free")
        expect(idx0).to_equal(0)  # oracle: value fixed by the spec contract
        expect(idx1).to_equal(1)  # oracle: value fixed by the spec contract
        expect(idx2).to_equal(2)  # oracle: value fixed by the spec contract

    it "assigns correct GOT offsets":
        step("Verify: assigns correct GOT offsets")
        # @req: REQ-FEATURE-GotPlt-001
        var builder = GotPltBuilder(
            got_entries: [],
            plt_entries: [],
            got_size: 0,
            plt_size: 0,
            next_got_offset: 0,
            next_plt_index: 0
        )
        builder.add_symbol("printf")
        builder.add_symbol("malloc")
        builder.add_symbol("free")
        expect(builder.got_entries[0].offset).to_equal(0)  # oracle: value fixed by the spec contract
        expect(builder.got_entries[1].offset).to_equal(8)  # oracle: value fixed by the spec contract
        expect(builder.got_entries[2].offset).to_equal(16)  # oracle: value fixed by the spec contract

describe "GOT/PLT Builder - Helper Functions":
    it "encodes i32 in little-endian":
        step("Verify: encodes i32 in little-endian")
        # @req: REQ-FEATURE-GotPlt-001
        val bytes = encode_i32_le(0x12345678)
        expect(bytes[0]).to_equal(0x78)
        expect(bytes.len()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(bytes[1]).to_equal(0x56)
        expect(bytes[2]).to_equal(0x34)
        expect(bytes[3]).to_equal(0x12)

    it "encodes zero correctly":
        step("Verify: encodes zero correctly")
        # @req: REQ-FEATURE-GotPlt-001
        val bytes = encode_i32_le(0)
        expect(bytes[0]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(bytes.len()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(bytes[1]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(bytes[2]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(bytes[3]).to_equal(0)  # oracle: value fixed by the spec contract

    it "encodes small positive number":
        step("Verify: encodes small positive number")
        # @req: REQ-FEATURE-GotPlt-001
        val bytes = encode_i32_le(42)
        expect(bytes[0]).to_equal(42)  # oracle: value fixed by the spec contract
        expect(bytes.len()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(bytes[1]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(bytes[2]).to_equal(0)  # oracle: value fixed by the spec contract
        expect(bytes[3]).to_equal(0)  # oracle: value fixed by the spec contract
