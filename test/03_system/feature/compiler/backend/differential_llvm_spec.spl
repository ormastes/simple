"""
## Purpose and audience
Purpose: computes 2 + 3 correctly
Audience: compiler and tooling engineers who maintain this spec

# LLVM Backend Differential Testing

**Category:** Compiler
**Status:** In Progress

## Overview

Tests differential correctness between the LLVM backend and other compilation
backends. Verifies that LLVM-generated code produces identical results to the
reference backend across a suite of test programs and edge cases.
"""

# @req: REQ-FEATURE-DiffLlvm-001
# # LLVM Backend Differential Testing
#
# **Feature ID:** #COMPILER-001
# **Category:** Compiler
# **Status:** Active
#
# ## Overview
#
# Compares LLVM backend output with Cranelift and Interpreter backends to ensure all produce
# identical results for identical inputs. Tests cover arithmetic operations (addition, subtraction,
# multiplication, division, modulo, negation), bitwise operations (AND, OR, XOR, shifts, NOT),
# comparison operators, control flow (if/else, for/while loops), function calls including recursion,
# variable mutability, boolean logic, complex nested expressions, edge cases with zero and boundary
# values, type conversions, aggregates (tuples), and string operations.
#
# ## Syntax
#
# ```simple
# fn factorial(n: i64) -> i64:
# if n <= 1: 1
# else: n * factorial(n - 1)
# val result = factorial(5)
# expect(result).to_equal(120)  # oracle: value fixed by the spec contract
#
# val result = (2 + 3) * (4 + 5)
# expect(result).to_equal(45)  # oracle: value fixed by the spec contract
# ```
# LLVM Backend Differential Testing
#
# Compares LLVM backend output with Cranelift and Interpreter.
# Ensures all backends produce the same results for identical inputs.


# ============================================================================
# Arithmetic Operation Tests
# ============================================================================

use std.spec.step
describe "Differential Testing - Arithmetic":
    context "integer addition":
        it "computes 2 + 3 correctly":
            step("Verify: computes 2 + 3 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 2
            val b = 3
            val result = a + b
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract

        it "computes large numbers":
            step("Verify: computes large numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 1000000
            val b = 2000000
            val result = a + b
            expect(result).to_equal(3000000)  # oracle: value fixed by the spec contract

        it "handles negative numbers":
            step("Verify: handles negative numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = -5
            val b = 3
            val result = a + b
            expect(result).to_equal(-2)  # oracle: value fixed by the spec contract

    context "integer subtraction":
        it "computes 10 - 4 correctly":
            step("Verify: computes 10 - 4 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 4
            val result = a - b
            expect(result).to_equal(6)  # oracle: value fixed by the spec contract

        it "handles negative results":
            step("Verify: handles negative results")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 3
            val b = 7
            val result = a - b
            expect(result).to_equal(-4)  # oracle: value fixed by the spec contract

    context "integer multiplication":
        it "computes 6 * 7 correctly":
            step("Verify: computes 6 * 7 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 6
            val b = 7
            val result = a * b
            expect(result).to_equal(42)  # oracle: value fixed by the spec contract

        it "handles zero":
            step("Verify: handles zero")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 100
            val b = 0
            val result = a * b
            expect(result).to_equal(0)  # oracle: value fixed by the spec contract

    context "integer division":
        it "computes 20 / 4 correctly":
            step("Verify: computes 20 / 4 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 20
            val b = 4
            val result = a / b
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract

        it "truncates toward zero":
            step("Verify: truncates toward zero")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 7
            val b = 2
            val result = a / b
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract

    context "modulo operation":
        it "computes 10 % 3 correctly":
            step("Verify: computes 10 % 3 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 3
            val result = a % b
            expect(result).to_equal(1)  # oracle: value fixed by the spec contract

    context "negation":
        it "negates positive number":
            step("Verify: negates positive number")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 42
            val result = -a
            expect(result).to_equal(-42)  # oracle: value fixed by the spec contract

        it "negates negative number":
            step("Verify: negates negative number")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = -17
            val result = -a
            expect(result).to_equal(17)  # oracle: value fixed by the spec contract

# ============================================================================
# Bitwise Operation Tests
# ============================================================================

describe "Differential Testing - Bitwise":
    context "bitwise AND":
        it "computes 12 & 10 correctly":
            step("Verify: computes 12 & 10 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 12  # 1100
            val b = 10  # 1010
            val result = a & b  # 1000 = 8
            expect(result).to_equal(8)  # oracle: value fixed by the spec contract

    context "bitwise OR":
        it "computes 12 | 10 correctly":
            step("Verify: computes 12 | 10 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 12  # 1100
            val b = 10  # 1010
            val result = a | b  # 1110 = 14
            expect(result).to_equal(14)  # oracle: value fixed by the spec contract

    context "bitwise XOR":
        it "computes 12 xor 10 correctly":
            step("Verify: computes 12 xor 10 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 12  # 1100
            val b = 10  # 1010
            val result = a xor b  # 0110 = 6
            expect(result).to_equal(6)  # oracle: value fixed by the spec contract

    context "left shift":
        it "computes 5 << 2 correctly":
            step("Verify: computes 5 << 2 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 5  # 101
            val result = a << 2  # 10100 = 20
            expect(result).to_equal(20)  # oracle: value fixed by the spec contract

    context "right shift":
        it "computes 20 >> 2 correctly":
            step("Verify: computes 20 >> 2 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 20  # 10100
            val result = a >> 2  # 101 = 5
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract

    context "bitwise NOT":
        it "computes ~0 correctly":
            step("Verify: computes ~0 correctly")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 0
            val result = ~a
            expect(result).to_equal(-1)  # oracle: value fixed by the spec contract

# ============================================================================
# Comparison Operation Tests
# ============================================================================

describe "Differential Testing - Comparisons":
    context "equality":
        it "compares equal numbers":
            step("Verify: compares equal numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 42
            val b = 42
            val result = a == b
            expect(result).to_equal(true)

        it "compares unequal numbers":
            step("Verify: compares unequal numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 20
            val result = a == b
            expect(result).to_equal(false)

    context "inequality":
        it "compares different numbers":
            step("Verify: compares different numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 5
            val b = 10
            val result = a != b
            expect(result).to_equal(true)

    context "less than":
        it "compares smaller to larger":
            step("Verify: compares smaller to larger")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 5
            val b = 10
            val result = a < b
            expect(result).to_equal(true)

        it "compares larger to smaller":
            step("Verify: compares larger to smaller")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 5
            val result = a < b
            expect(result).to_equal(false)

    context "less than or equal":
        it "compares equal numbers":
            step("Verify: compares equal numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 10
            val result = a <= b
            expect(result).to_equal(true)

        it "compares smaller to larger":
            step("Verify: compares smaller to larger")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 5
            val b = 10
            val result = a <= b
            expect(result).to_equal(true)

    context "greater than":
        it "compares larger to smaller":
            step("Verify: compares larger to smaller")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 15
            val b = 10
            val result = a > b
            expect(result).to_equal(true)

    context "greater than or equal":
        it "compares equal numbers":
            step("Verify: compares equal numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val a = 10
            val b = 10
            val result = a >= b
            expect(result).to_equal(true)

# ============================================================================
# Control Flow Tests
# ============================================================================

describe "Differential Testing - Control Flow":
    context "if statements":
        it "executes then branch":
            step("Verify: executes then branch")
            # @req: REQ-FEATURE-DiffLlvm-001
            var result = 0
            if 5 > 3:
                result = 1
            else:
                result = 2
            expect(result).to_equal(1)  # oracle: value fixed by the spec contract

        it "executes else branch":
            step("Verify: executes else branch")
            # @req: REQ-FEATURE-DiffLlvm-001
            var result = 0
            if 3 > 5:
                result = 1
            else:
                result = 2
            expect(result).to_equal(2)  # oracle: value fixed by the spec contract

    context "loops":
        it "executes for loop":
            step("Verify: executes for loop")
            # @req: REQ-FEATURE-DiffLlvm-001
            var sum = 0
            for i in 0..5:
                sum = sum + i
            expect(sum).to_equal(10)  # 0+1+2+3+4 = 10

        it "executes while loop":
            step("Verify: executes while loop")
            # @req: REQ-FEATURE-DiffLlvm-001
            fn run_while() -> i64:
                var count = 0
                var i = 0
                while i < 5:
                    count = count + 1
                    i = i + 1
                count
            expect(run_while()).to_equal(5)  # oracle: value fixed by the spec contract

# ============================================================================
# Function Call Tests
# ============================================================================

describe "Differential Testing - Functions":
    context "simple functions":
        it "calls function with no parameters":
            step("Verify: calls function with no parameters")
            # @req: REQ-FEATURE-DiffLlvm-001
            fn get_value() -> i64:
                42
            val result = get_value()
            expect(result).to_equal(42)  # oracle: value fixed by the spec contract

        it "calls function with parameters":
            step("Verify: calls function with parameters")
            # @req: REQ-FEATURE-DiffLlvm-001
            fn add(a: i64, b: i64) -> i64:
                a + b
            val result = add(10, 20)
            expect(result).to_equal(30)  # oracle: value fixed by the spec contract

        it "calls function multiple times":
            step("Verify: calls function multiple times")
            # @req: REQ-FEATURE-DiffLlvm-001
            fn square(x: i64) -> i64:
                x * x
            val r1 = square(3)
            val r2 = square(4)
            expect(r1).to_equal(9)  # oracle: value fixed by the spec contract
            expect(r2).to_equal(16)  # oracle: value fixed by the spec contract

    context "recursive functions":
        it "computes factorial":
            step("Verify: computes factorial")
            # @req: REQ-FEATURE-DiffLlvm-001
            fn factorial(n: i64) -> i64:
                if n <= 1:
                    1
                else:
                    n * factorial(n - 1)
            val result = factorial(5)
            expect(result).to_equal(120)  # oracle: value fixed by the spec contract

# ============================================================================
# Variable and Assignment Tests
# ============================================================================

describe "Differential Testing - Variables":
    context "immutable variables":
        it "reads immutable variable":
            step("Verify: reads immutable variable")
            # @req: REQ-FEATURE-DiffLlvm-001
            val x = 10
            val y = x + 5
            expect(y).to_equal(15)  # oracle: value fixed by the spec contract

    context "mutable variables":
        it "updates mutable variable":
            step("Verify: updates mutable variable")
            # @req: REQ-FEATURE-DiffLlvm-001
            var x = 10
            x = x + 5
            expect(x).to_equal(15)  # oracle: value fixed by the spec contract

        it "updates multiple times":
            step("Verify: updates multiple times")
            # @req: REQ-FEATURE-DiffLlvm-001
            var x = 1
            x = x + 1
            x = x + 1
            x = x + 1
            expect(x).to_equal(4)  # oracle: value fixed by the spec contract

# ============================================================================
# Boolean Logic Tests
# ============================================================================

describe "Differential Testing - Boolean Logic":
    context "logical AND":
        it "computes true && true":
            step("Verify: computes true && true")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = true and true
            expect(result).to_equal(true)

        it "computes true && false":
            step("Verify: computes true && false")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = true and false
            expect(result).to_equal(false)

    context "logical OR":
        it "computes false || true":
            step("Verify: computes false || true")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = false or true
            expect(result).to_equal(true)

        it "computes false || false":
            step("Verify: computes false || false")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = false or false
            expect(result).to_equal(false)

    context "logical NOT":
        it "computes !true":
            step("Verify: computes !true")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = not true
            expect(result).to_equal(false)

        it "computes !false":
            step("Verify: computes !false")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = not false
            expect(result).to_equal(true)

# ============================================================================
# Complex Expression Tests
# ============================================================================

describe "Differential Testing - Complex Expressions":
    context "nested arithmetic":
        it "evaluates (2 + 3) * (4 + 5)":
            step("Verify: evaluates (2 + 3) * (4 + 5)")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = (2 + 3) * (4 + 5)
            expect(result).to_equal(45)  # oracle: value fixed by the spec contract

        it "respects operator precedence":
            step("Verify: respects operator precedence")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = 2 + 3 * 4
            expect(result).to_equal(14)  # oracle: value fixed by the spec contract

    context "mixed operations":
        it "combines arithmetic and bitwise":
            step("Verify: combines arithmetic and bitwise")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = (5 + 3) & 7
            expect(result).to_equal(0)  # oracle: value fixed by the spec contract

        it "combines comparisons and logic":
            step("Verify: combines comparisons and logic")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = (5 > 3) and (10 < 20)
            expect(result).to_equal(true)

