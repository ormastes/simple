        it "handles zero in addition":
            step("Verify: handles zero in addition")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = 0 + 0
            expect(result).to_equal(0)  # oracle: value fixed by the spec contract

        it "handles zero in multiplication":
            step("Verify: handles zero in multiplication")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = 100 * 0
            expect(result).to_equal(0)  # oracle: value fixed by the spec contract

    context "boundary values":
        it "handles small positive number":
            step("Verify: handles small positive number")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = 1 + 1
            expect(result).to_equal(2)  # oracle: value fixed by the spec contract

        it "handles negative numbers":
            step("Verify: handles negative numbers")
            # @req: REQ-FEATURE-DiffLlvm-001
            val result = -10 + 5
            expect(result).to_equal(-5)  # oracle: value fixed by the spec contract

