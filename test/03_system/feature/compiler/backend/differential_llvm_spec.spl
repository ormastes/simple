describe "Differential Testing - Strings":
    context "string operations":
        it "works with string literals":
            step("Verify: works with string literals")
            # @req: REQ-FEATURE-DiffLlvm-001
            val s = "hello"
            expect(s.len()).to_equal(5)  # oracle: value fixed by the spec contract

# ============================================================================
# Summary Test
# ============================================================================

describe "Differential Testing - Summary":
    context "comprehensive smoke test":
        it "runs comprehensive computation":
            step("Verify: runs comprehensive computation")
            # @req: REQ-FEATURE-DiffLlvm-001
            # This test combines multiple operations
            var result = 0

            # Arithmetic
            result = result + (10 + 5)  # 15
            result = result * 2          # 30

            # Bitwise
            result = result | 1          # 31

            # Comparison and branching
            if result > 20:
                result = result - 1      # 30

            # Loop
            for i in 0..3:
                result = result + 1      # 33

            expect(result).to_equal(33)  # oracle: value fixed by the spec contract
