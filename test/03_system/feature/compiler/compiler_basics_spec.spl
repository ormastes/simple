"""
# Compiler Basics

**Feature IDs:** #COMPILER-BASICS-001
**Category:** Compiler | Core
**Status:** Implemented

## Purpose and audience
Verifies that the compiler pipeline (HIR -> MIR -> execution) evaluates the
foundational language surface correctly: integer literals, arithmetic with
standard precedence, comparisons, logical short-circuiting, boolean literals,
variable bindings, and function definition/call. For compiler engineers
guarding the core evaluation contract and operators confirming basic
compilation on a deployed binary.

## Operator workflow
Run the file with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/compiler/compiler_basics_spec.spl
Each scenario compiles a construct, executes it, and pins the produced value
with a trailing oracle comment on the same line.

## Compatibility and limitations
Exercises integer/bool/text scalar evaluation only; strings, collections, and
type inference live in dedicated suites. All comparisons are expressed as
branch selectors (if cond: 1 else: 0) because that is the surface under test.
Requires a binary that parses current-source syntax.

## Verification guidance and troubleshooting
A failure names the construct that mis-evaluated; rerun the single file above
and compare the produced value with the trailing oracle comment. A wrong
branch selector points at comparison lowering; a wrong function result points
at call-frame or return-path lowering.
"""

# Lifecycle: doc/01_research/compiler/compiler_mdsoc_design.md ;
# doc/03_plan/compiler/native_pattern_match_staging.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/architecture/layered_compiler_architecture.md

use std.spec.step

describe "Integer Literals":
    # @manual_section: literal compilation
    # ## Integer Literal Compilation
    #
    # Tests that integer literals compile correctly.

    it "compiles zero":
        # @req REQ-COMPILER-BASICS-001
        # @capture(statistics): zero-literal additive-identity readback
        step("bind the zero literal and probe it as an additive identity")
        val result = 0
        expect(result + 1).to_equal(1)  # oracle: 1 — proves the bound literal evaluates as 0

    it "compiles positive integer":
        # @req REQ-COMPILER-BASICS-002
        # @capture(statistics): positive-literal decrement readback
        step("bind the positive literal 42 and probe it with a decrement")
        val result = 42
        expect(result - 1).to_equal(41)  # oracle: 41 — proves the bound literal evaluates as 42

    it "compiles negative integer":
        # @req REQ-COMPILER-BASICS-003
        # @capture(statistics): negative-literal readback
        step("bind the negative literal -5 and probe it with an offset")
        val result = -5
        expect(result + 5).to_equal(0)  # oracle: 0 — proves the bound literal evaluates as -5

describe "Arithmetic Operations":
    # @manual_section: arithmetic compilation
    # ## Arithmetic Compilation
    #
    # Tests that arithmetic operations compile and execute correctly.

    it "compiles addition":
        # @req REQ-COMPILER-BASICS-004
        # @capture(statistics): addition readback
        step("compile and execute 10 + 32")
        val result = 10 + 32
        expect(result).to_equal(42)  # oracle: 42 = 10 + 32

    it "compiles subtraction":
        # @req REQ-COMPILER-BASICS-005
        # @capture(statistics): subtraction readback
        step("compile and execute 50 - 8")
        val result = 50 - 8
        expect(result).to_equal(42)  # oracle: 42 = 50 - 8

    it "compiles multiplication":
        # @req REQ-COMPILER-BASICS-006
        # @capture(statistics): multiplication readback
        step("compile and execute 6 * 7")
        val result = 6 * 7
        expect(result).to_equal(42)  # oracle: 42 = 6 * 7

    it "compiles division":
        # @req REQ-COMPILER-BASICS-007
        # @capture(statistics): division readback
        step("compile and execute 84 / 2")
        val result = 84 / 2
        expect(result).to_equal(42)  # oracle: 42 = 84 / 2

    it "compiles modulo":
        # @req REQ-COMPILER-BASICS-008
        # @capture(statistics): modulo readback
        step("compile and execute 47 % 5")
        val result = 47 % 5
        expect(result).to_equal(2)  # oracle: 2 = 47 mod 5

    it "compiles nested arithmetic":
        # @req REQ-COMPILER-BASICS-009
        # @capture(statistics): precedence-aware readback
        step("compile and execute (10 + 20) * 2 - 18 with standard precedence")
        val result = (10 + 20) * 2 - 18
        expect(result).to_equal(42)  # oracle: 42 = (10 + 20) * 2 - 18

describe "Comparison Operations":
    # @manual_section: comparison compilation
    # ## Comparison Compilation
    #
    # Tests that comparison operations compile correctly.

    it "compiles less than - true case":
        # @req REQ-COMPILER-BASICS-010
        # @capture(statistics): less-than branch selector
        step("select the branch for 1 < 2")
        val result = if 1 < 2: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — the true branch was taken

    it "compiles less than - false case":
        # @req REQ-COMPILER-BASICS-011
        # @capture(statistics): less-than-false branch selector
        step("select the branch for 2 < 1")
        val result = if 2 < 1: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — the false branch was taken

    it "compiles greater than - true case":
        # @req REQ-COMPILER-BASICS-012
        # @capture(statistics): greater-than branch selector
        step("select the branch for 2 > 1")
        val result = if 2 > 1: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — the true branch was taken

    it "compiles greater than - false case":
        # @req REQ-COMPILER-BASICS-013
        # @capture(statistics): greater-than-false branch selector
        step("select the branch for 1 > 2")
        val result = if 1 > 2: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — the false branch was taken

    it "compiles less than or equal - equal case":
        # @req REQ-COMPILER-BASICS-014
        # @capture(statistics): lte-equal branch selector
        step("select the branch for 1 <= 1")
        val result = if 1 <= 1: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — equal operands satisfy <=

    it "compiles less than or equal - false case":
        # @req REQ-COMPILER-BASICS-015
        # @capture(statistics): lte-false branch selector
        step("select the branch for 2 <= 1")
        val result = if 2 <= 1: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — the false branch was taken

    it "compiles greater than or equal - equal case":
        # @req REQ-COMPILER-BASICS-016
        # @capture(statistics): gte-equal branch selector
        step("select the branch for 2 >= 2")
        val result = if 2 >= 2: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — equal operands satisfy >=

    it "compiles greater than or equal - false case":
        # @req REQ-COMPILER-BASICS-017
        # @capture(statistics): gte-false branch selector
        step("select the branch for 1 >= 2")
        val result = if 1 >= 2: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — the false branch was taken

    it "compiles equals - true case":
        # @req REQ-COMPILER-BASICS-018
        # @capture(statistics): equality branch selector
        step("select the branch for 42 == 42")
        val result = if 42 == 42: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — equal operands satisfy ==

    it "compiles equals - false case":
        # @req REQ-COMPILER-BASICS-019
        # @capture(statistics): inequality branch selector
        step("select the branch for 42 == 43")
        val result = if 42 == 43: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — distinct operands fail ==

    it "compiles not equals - true case":
        # @req REQ-COMPILER-BASICS-020
        # @capture(statistics): not-equals-true branch selector
        step("select the branch for 42 != 43")
        val result = if 42 != 43: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — distinct operands satisfy !=

    it "compiles not equals - false case":
        # @req REQ-COMPILER-BASICS-021
        # @capture(statistics): not-equals-false branch selector
        step("select the branch for 42 != 42")
        val result = if 42 != 42: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — equal operands fail !=

describe "Logical Operations":
    # @manual_section: logical compilation
    # ## Logical Operation Compilation
    #
    # Tests that logical operations compile correctly.

    it "compiles logical and - true case":
        # @req REQ-COMPILER-BASICS-022
        # @capture(statistics): and-true branch selector
        step("select the branch for true and true")
        val result = if true and true: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — conjunction of truths is true

    it "compiles logical and - false case":
        # @req REQ-COMPILER-BASICS-023
        # @capture(statistics): and-false branch selector
        step("select the branch for true and false")
        val result = if true and false: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — conjunction with a false is false

    it "compiles logical or - true case":
        # @req REQ-COMPILER-BASICS-024
        # @capture(statistics): or-true branch selector
        step("select the branch for false or true")
        val result = if false or true: 1 else: 0
        expect(result).to_equal(1)  # oracle: 1 — disjunction with a truth is true

    it "compiles logical or - false case":
        # @req REQ-COMPILER-BASICS-025
        # @capture(statistics): or-false branch selector
        step("select the branch for false or false")
        val result = if false or false: 1 else: 0
        expect(result).to_equal(0)  # oracle: 0 — disjunction of falses is false

describe "Boolean Literals":
    # @manual_section: literal compilation
    # ## Boolean Literal Compilation
    #
    # Tests that boolean literals compile correctly.

    it "compiles true literal":
        # @req REQ-COMPILER-BASICS-026
        # @capture(statistics): true-literal branch value
        step("select the branch value guarded by the true literal")
        val result = if true: 42 else: 0
        expect(result).to_equal(42)  # oracle: 42 — the then-branch value

    it "compiles false literal":
        # @req REQ-COMPILER-BASICS-027
        # @capture(statistics): false-literal branch value
        step("select the branch value guarded by the false literal")
        val result = if false: 0 else: 42
        expect(result).to_equal(42)  # oracle: 42 — the else-branch value

describe "Variable Bindings":
    # @manual_section: binding compilation
    # ## Variable Binding Compilation
    #
    # Tests that variable bindings compile correctly.

    it "compiles single let binding":
        # @req REQ-COMPILER-BASICS-028
        # @capture(statistics): single-binding readback
        step("bind a computed initializer and read the binding back")
        val x = 6 * 7
        expect(x).to_equal(42)  # oracle: 42 = 6 * 7 evaluated initializer

    it "compiles multiple let bindings":
        # @req REQ-COMPILER-BASICS-029
        # @capture(statistics): two-binding combination readback
        step("bind two values and combine them in a third binding")
        val a = 10
        val b = 32
        val result = a + b
        expect(result).to_equal(42)  # oracle: 42 = 10 + 32 across bindings

    it "compiles binding with expression":
        # @req REQ-COMPILER-BASICS-030
        # @capture(statistics): expression-initializer readback
        step("bind an arithmetic expression and read the evaluated result")
        val x = 10 + 32
        expect(x).to_equal(42)  # oracle: 42 = 10 + 32

describe "Function Definitions":
    # @manual_section: function compilation
    # ## Function Definition Compilation
    #
    # Tests that function definitions compile correctly.

    it "compiles simple function":
        # @req REQ-COMPILER-BASICS-031
        # @capture(statistics): zero-arg call readback
        step("define a zero-argument function and call it")
        fn get_value():
            return 42
        expect(get_value()).to_equal(42)  # oracle: 42 — the function's return value

    it "compiles function with parameters":
        # @req REQ-COMPILER-BASICS-032
        # @capture(statistics): two-arg call readback
        step("define a two-parameter function and call it")
        fn add(a, b):
            return a + b
        expect(add(10, 32)).to_equal(42)  # oracle: 42 = 10 + 32 through the call

    it "compiles function with multiple statements":
        # @req REQ-COMPILER-BASICS-033
        # @capture(statistics): multi-statement body readback
        step("define a function with a local binding and call it")
        fn calc(x, y):
            val sum = x + y
            return sum
        expect(calc(10, 32)).to_equal(42)  # oracle: 42 = the local sum returned

    it "compiles nested function call":
        # @req REQ-COMPILER-BASICS-034
        # @capture(statistics): nested-call readback
        step("define two functions where one calls the other twice")
        fn double(x):
            return x * 2
        fn add_doubled(a, b):
            return double(a) + double(b)
        expect(add_doubled(10, 11)).to_equal(42)  # oracle: 42 = 20 + 22 through nested calls
