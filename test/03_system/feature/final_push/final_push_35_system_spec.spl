# @req: REQ-SYS-FINAL-PUSH-ae9a

# final_push behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

fn verify(condition: bool):
    expect(condition).to_equal(true)

describe "Final System Test":
    slow_it "complete system check 1":
        val result = 1 + 1
        verify(result == 2)
        
    slow_it "complete system check 2":
        val arr = [1, 2, 3, 4, 5]
        var sum = 0
        for x in arr:
            sum = sum + x
        verify(sum == 15)
        
    slow_it "complete system check 3":
        val opt = Some(100)
        match opt:
            Some(x): verify(x == 100)
            nil: verify(false)
            
    slow_it "complete system check 4":
        var state = "start"
        if state == "start":
            state = "processing"
        if state == "processing":
            state = "done"
        verify(state == "done")
        
    slow_it "complete system check 5":
        val dict = {"a": 1, "b": 2, "c": 3}
        val keys = dict.keys()
        verify(keys.len() == 3)
        
    slow_it "complete system check 6":
        var count = 0
        for i in 0..20:
            if i % 2 == 0:
                count = count + 1
        verify(count == 10)
        
    slow_it "complete system check 7":
        val nested = [[1, 2], [3, 4], [5, 6]]
        verify(nested.len() == 3)
        verify(nested[0].len() == 2)
        
    slow_it "complete system check 8":
        val s = "test string"
        verify(s.len() == 11)
        verify(s.contains("test"))
        
    slow_it "complete system check 9":
        val a = 10
        val b = 20
        verify(a < b)
        verify(b > a)
        verify(a + b == 30)
        
    slow_it "complete system check 10":
        var sum = 0
        for i in 0..5:
            sum = sum + i
        expect(sum).to_equal(10)
    it "match destructures Some":
        # @req: REQ-SYS-FINAL-PUSH-ae9a
        step("Verify: match destructures Some")
        # oracle: 1 — the Some arm binds the payload
        match Some(1):
            Some(x):
                expect(x).to_equal(1)
            nil:
                expect(false).to_equal(true)
    it "string length and emptiness":
        # @req: REQ-SYS-FINAL-PUSH-ae9a
        step("Verify: string length and emptiness")
        # oracle: 4/0 — len counts chars; only the empty string is empty
        expect("test".len()).to_equal(4)
        expect("".len()).to_equal(0)
        expect("".is_empty()).to_equal(true)
