"""
## Purpose and audience
Purpose: LP64 helpers return expected values
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-FEATURE-FortAbiSmok-001

use std.spipe.*
use std.common.science_math.fortran_abi.*

use std.spec.step
describe "fortran_abi smoke":
    it "LP64 helpers return expected values":
        step("Verify: LP64 helpers return expected values")
        # @req: REQ-FEATURE-FortAbiSmok-001
        expect(fortran_int_bytes()).to_equal(8)  # oracle: value fixed by the spec contract
        expect(fortran_int_is_lp64()).to_equal(true)

    it "index converters are correct":
        step("Verify: index converters are correct")
        # @req: REQ-FEATURE-FortAbiSmok-001
        expect(rc_to_rm_index(1, 2, 4)).to_equal(6)  # oracle: value fixed by the spec contract
        expect(rc_to_cm_index(1, 2, 3)).to_equal(7)  # oracle: value fixed by the spec contract

    it "symbol names are canonical":
        step("Verify: symbol names are canonical")
        # @req: REQ-FEATURE-FortAbiSmok-001
        expect(blas_symbol_name("gemm", "d")).to_equal("rt_blas_dgemm")
        expect(lapack_symbol_name("gesv")).to_equal("rt_lapack_dgesv")
        expect(cuda_symbol_name("malloc")).to_equal("rt_cuda_malloc")

    it "operand swap needed for row-major layout":
        step("Verify: operand swap needed for row-major layout")
        # @req: REQ-FEATURE-FortAbiSmok-001
        expect(operand_swap_needed(LAYOUT_ROW_MAJOR)).to_equal(true)
        expect(operand_swap_needed(LAYOUT_COL_MAJOR)).to_equal(false)
