# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# DataFrame Value Counts / Unique / Nunique Specification

**Feature IDs:** T-DF-32, science-math-lib-set-pandas-core-value-counts
**Plan:** doc/03_plan/agent_tasks/scilib_port_df.md
**Design:** doc/05_design/science_math_lib_set.md

Validates Series.unique_f64, unique_i64, nunique, and value_counts.
"""

use std.spec.step

use std.spipe.*
use std.df.*
use std.ndarray.*
use std.common.binary_io.{f64_from_bits}


describe "Series unique_i64":
    # @manual scenario evidence
    it "returns deduplicated Int64 values in order of first appearance":
        # @req REQ-SSPEC-SYSTEM
        step("returns deduplicated Int64 values in order of first appearance")
        val ms = Series.from_i64_masked(
            Symbol.from("group"),
            [Int64.new(3), Int64.new(1), Int64.new(3), Int64.new(2), Int64.new(1)],
            [Bool.new(false), Bool.new(false), Bool.new(false), Bool.new(false), Bool.new(false)]
        )
        val s = ms.unwrap()
        val u = s.unique_i64()
        expect(u.len()).to_equal(Index.new(3))
        expect(u.values.flat_i64(Index.new(0))).to_equal(Int64.new(3))
        expect(u.values.flat_i64(Index.new(1))).to_equal(Int64.new(1))
        expect(u.values.flat_i64(Index.new(2))).to_equal(Int64.new(2))

    it "returns single-element series for constant column":
        # @req REQ-SSPEC-SYSTEM
        step("returns single-element series for constant column")
        val ms = Series.from_i64_masked(
            Symbol.from("c"),
            [Int64.new(7), Int64.new(7), Int64.new(7)],
            [Bool.new(false), Bool.new(false), Bool.new(false)]
        )
        val s = ms.unwrap()
        val u = s.unique_i64()
        expect(u.len()).to_equal(Index.new(1))

    it "keeps first-seen order when integer index slots collide":
        step("Deduplicate colliding integer keys without dropping a distinct value")
        val series = Series.from_i64_values(Symbol.from("key"),
            [Int64.new(1), Int64.new(17), Int64.new(1), Int64.new(-15)])
        val unique = series.unique_i64()
        expect(unique.len()).to_equal(Index.new(3))
        expect(unique.get(Index.new(0))).to_equal(Int64.new(1))
        expect(unique.get(Index.new(1))).to_equal(Int64.new(17))
        expect(unique.get(Index.new(2))).to_equal(Int64.new(-15))

describe "Series nunique":
    it "returns count of distinct non-missing values for I64 series":
        # @req REQ-SSPEC-SYSTEM
        step("returns count of distinct non-missing values for I64 series")
        val s = Series.from_values(
            name: Symbol.from("x"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0), Float64.new(3.0)]
        )
        expect(s.nunique()).to_equal(Index.new(3))

    it "returns 1 for constant series":
        # @req REQ-SSPEC-SYSTEM
        step("returns 1 for constant series")
        val s = Series.from_values(
            name: Symbol.from("k"),
            values: [Float64.new(5.0), Float64.new(5.0)]
        )
        expect(s.nunique()).to_equal(Index.new(1))

    it "returns 0 for empty series":
        # @req REQ-SSPEC-SYSTEM
        step("returns 0 for empty series")
        val empty: [Float64] = []
        val s = Series.from_values(name: Symbol.from("empty"), values: empty)
        expect(s.nunique()).to_equal(Index.new(0))

    it "keeps missing and zero distinct while excluding missing from nunique":
        step("Preserve real zero after a missing placeholder in both numeric dtypes")
        val floating = Series.from_f64_masked(Symbol.from("f"),
            [Float64.new(0.0), Float64.new(0.0)],
            [Bool.new(true), Bool.new(false)]).unwrap()
        val integer = Series.from_i64_masked(Symbol.from("i"),
            [Int64.new(0), Int64.new(0)],
            [Bool.new(true), Bool.new(false)]).unwrap()
        val floating_unique = floating.unique_f64()
        val integer_unique = integer.unique_i64()
        expect(floating_unique.len()).to_equal(Index.new(2))
        expect(integer_unique.len()).to_equal(Index.new(2))
        expect(floating_unique.is_missing(Index.new(0)).unwrap()).to_equal(true)
        expect(floating_unique.is_missing(Index.new(1)).unwrap()).to_equal(false)
        expect(integer_unique.is_missing(Index.new(0)).unwrap()).to_equal(true)
        expect(integer_unique.is_missing(Index.new(1)).unwrap()).to_equal(false)
        expect(floating.nunique()).to_equal(Index.new(1))
        expect(integer.nunique()).to_equal(Index.new(1))

describe "value_counts":
    it "returns a two-column DataFrame with value and count columns":
        # @req REQ-SSPEC-SYSTEM
        step("returns a two-column DataFrame with value and count columns")
        val s = Series.from_values(
            name: Symbol.from("color"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0), Float64.new(3.0), Float64.new(2.0), Float64.new(2.0)]
        )
        val vc = value_counts(s)
        expect(vc.num_cols()).to_equal(Index.new(2))
        expect(vc.num_rows()).to_equal(Index.new(3))

    it "count column is named 'count'":
        # @req REQ-SSPEC-SYSTEM
        step("count column is named 'count'")
        val s = Series.from_values(
            name: Symbol.from("grp"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0)]
        )
        val vc = value_counts(s)
        val schema = vc.columns()
        expect(schema[1]).to_equal(Symbol.from("count"))

    it "count values are correct":
        # @req REQ-SSPEC-SYSTEM
        step("count values are correct")
        val s = Series.from_values(
            name: Symbol.from("g"),
            values: [Float64.new(1.0), Float64.new(2.0), Float64.new(1.0), Float64.new(1.0)]
        )
        val vc = value_counts(s)
        val counts = vc.col(Symbol.from("count")).unwrap()
        expect(counts.get(Index.new(0))).to_equal(Int64.new(3))
        expect(counts.get(Index.new(1))).to_equal(Int64.new(1))

    it "ignores missing values in count":
        # @req REQ-SSPEC-SYSTEM
        step("ignores missing values in count")
        val s = Series.from_f64_masked(
            Symbol.from("v"),
            [Float64.new(1.0), Float64.new(0.0), Float64.new(1.0)],
            [Bool.new(false), Bool.new(true), Bool.new(false)]
        ).unwrap()
        val vc = value_counts(s)
        expect(vc.num_rows()).to_equal(Index.new(1))
        val counts = vc.col(Symbol.from("count")).unwrap()
        expect(counts.get(Index.new(0))).to_equal(Int64.new(2))

    it "counts signed zero together and leaves NaNs unmerged":
        step("Apply floating equality semantics to unique and value counts")
        val nan = Float64.new(f64_from_bits(0x7FF8000000000001u64))
        val negative_zero = Float64.new(f64_from_bits(0x8000000000000000u64))
        val series = Series.from_f64_values(Symbol.from("key"),
            [Float64.new(0.0), negative_zero, nan, nan])
        expect(series.unique_f64().len()).to_equal(Index.new(3))
        val counts = value_counts(series).col(Symbol.from("count")).unwrap()
        expect(counts.len()).to_equal(Index.new(3))
        expect(counts.get(Index.new(0))).to_equal(Int64.new(2))
        expect(counts.get(Index.new(1))).to_equal(Int64.new(1))
        expect(counts.get(Index.new(2))).to_equal(Int64.new(1))
