# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/nogc_sync_mut/df/mod.spl 80%
"""
# DataFrame Merge Specification

**Feature IDs:** T-DF-24, T-DF-25, T-DF-26, science-math-lib-set-pandas-core-inner-merge
**Plan:** doc/03_plan/agent_tasks/scilib_port_df.md

Validates numeric-key merge/join behavior, including missing-value masks for
unmatched rows in left/right/outer joins.
"""
use std.spec.step

use std.spec.step

use std.spipe.*
use std.df.*
use std.ndarray.*
use std.common.binary_io.{f64_from_bits}
use std.nogc_sync_mut.df.numeric_index.{numeric_f64_key, numeric_index_slot}



describe "DataFrame merge":
    # @manual scenario evidence
    it "keeps only matching rows and appends right non-key columns":
        # @req REQ-SSPEC-SYSTEM
        step("keeps only matching rows and appends right non-key columns")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1), Int64.new(2), Int64.new(3)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("price"), [Float64.new(10.0), Float64.new(20.0), Float64.new(30.0)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(2), Int64.new(3), Int64.new(4)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("discount"), [Float64.new(0.2), Float64.new(0.3), Float64.new(0.4)])),
        ]).unwrap()
        val out = merge(left, right, Symbol.from("id"), JoinHow.Inner).unwrap()
        expect(out.num_rows()).to_equal(Index.new(2))
        expect(out.num_cols()).to_equal(Index.new(3))
        expect(out.col(Symbol.from("id")).unwrap().get(Index.new(0))).to_equal(Int64.new(2))
        expect(out.col(Symbol.from("price")).unwrap().get(Index.new(1))).to_equal(Float64.new(30.0))
        expect(out.col(Symbol.from("discount")).unwrap().get(Index.new(1))).to_equal(Float64.new(0.3))

    it "supports the DataFrame.join method wrapper":
        # @req REQ-SSPEC-SYSTEM
        step("supports the DataFrame.join method wrapper")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1), Int64.new(2)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(2)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("score"), [Float64.new(9.0)])),
        ]).unwrap()
        val out = left.join(right, Symbol.from("id"), JoinHow.Inner).unwrap()
        expect(out.num_rows()).to_equal(Index.new(1))
        expect(out.col(Symbol.from("score")).unwrap().get(Index.new(0))).to_equal(Float64.new(9.0))

    it "left join preserves left rows and marks missing right values":
        # @req REQ-SSPEC-SYSTEM
        step("left join preserves left rows and marks missing right values")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1), Int64.new(2)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("price"), [Float64.new(10.0), Float64.new(20.0)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(2)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("discount"), [Float64.new(0.2)])),
        ]).unwrap()
        val out = merge(left, right, Symbol.from("id"), JoinHow.Left).unwrap()
        expect(out.num_rows()).to_equal(Index.new(2))
        expect(out.col(Symbol.from("id")).unwrap().get(Index.new(0))).to_equal(Int64.new(1))
        expect(out.col(Symbol.from("discount")).unwrap().is_missing(Index.new(0)).unwrap()).to_equal(true)
        expect(out.col(Symbol.from("discount")).unwrap().is_missing(Index.new(1)).unwrap()).to_equal(false)

    it "right join preserves right rows and fills missing left columns":
        # @req REQ-SSPEC-SYSTEM
        step("right join preserves right rows and fills missing left columns")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("price"), [Float64.new(10.0)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1), Int64.new(2)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("discount"), [Float64.new(0.1), Float64.new(0.2)])),
        ]).unwrap()
        val out = merge(left, right, Symbol.from("id"), JoinHow.Right).unwrap()
        expect(out.num_rows()).to_equal(Index.new(2))
        expect(out.col(Symbol.from("id")).unwrap().get(Index.new(1))).to_equal(Int64.new(2))
        expect(out.col(Symbol.from("price")).unwrap().is_missing(Index.new(1)).unwrap()).to_equal(true)
        expect(out.col(Symbol.from("discount")).unwrap().is_missing(Index.new(1)).unwrap()).to_equal(false)

    it "outer join includes unmatched rows from both sides":
        # @req REQ-SSPEC-SYSTEM
        step("outer join includes unmatched rows from both sides")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1), Int64.new(2)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("price"), [Float64.new(10.0), Float64.new(20.0)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(2), Int64.new(3)])),
            SeriesErased.F64Series(Series.from_values(Symbol.from("discount"), [Float64.new(0.2), Float64.new(0.3)])),
        ]).unwrap()
        val out = merge(left, right, Symbol.from("id"), JoinHow.Outer).unwrap()
        expect(out.num_rows()).to_equal(Index.new(3))
        expect(out.col(Symbol.from("id")).unwrap().get(Index.new(2))).to_equal(Int64.new(3))
        expect(out.col(Symbol.from("price")).unwrap().is_missing(Index.new(2)).unwrap()).to_equal(true)
        expect(out.col(Symbol.from("discount")).unwrap().is_missing(Index.new(0)).unwrap()).to_equal(true)

    it "returns errors for missing keys":
        # @req REQ-SSPEC-SYSTEM
        step("returns errors for missing keys")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("id"), [Int64.new(1)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(Symbol.from("other_id"), [Int64.new(1)])),
        ]).unwrap()
        expect(merge(left, right, Symbol.from("id"), JoinHow.Inner).is_err()).to_equal(true)

    it "preserves duplicate match order through colliding integer slots":
        step("Preserve row order for duplicate integer keys and hash collisions")
        val key = Symbol.from("id")
        val left = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(key, [Int64.new(1), Int64.new(33), Int64.new(1)])),
        ]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.I64Series(Series.from_values(key, [Int64.new(1), Int64.new(33), Int64.new(1)])),
            SeriesErased.I64Series(Series.from_values(Symbol.from("ordinal"), [Int64.new(10), Int64.new(20), Int64.new(30)])),
        ]).unwrap()
        val out = left.join(right, key, JoinHow.Inner).unwrap()
        expect(out.num_rows()).to_equal(Index.new(5))
        val ordinal = out.col(Symbol.from("ordinal")).unwrap()
        expect(ordinal.get(Index.new(0))).to_equal(Int64.new(10))
        expect(ordinal.get(Index.new(1))).to_equal(Int64.new(30))
        expect(ordinal.get(Index.new(2))).to_equal(Int64.new(20))
        expect(ordinal.get(Index.new(3))).to_equal(Int64.new(10))
        expect(ordinal.get(Index.new(4))).to_equal(Int64.new(30))

    it "keeps unmatched and missing integer keys in outer and right joins":
        step("Keep missing keys unmatched and preserve outer/right rows")
        val key = Symbol.from("id")
        val left_key = Series.from_i64_masked(key, [Int64.new(1), Int64.new(0)], [Bool.new(false), Bool.new(true)]).unwrap()
        val right_key = Series.from_i64_masked(key, [Int64.new(1), Int64.new(0), Int64.new(2)], [Bool.new(false), Bool.new(true), Bool.new(false)]).unwrap()
        val left = DataFrame.from_columns([SeriesErased.I64Series(left_key)]).unwrap()
        val right = DataFrame.from_columns([SeriesErased.I64Series(right_key)]).unwrap()
        val outer = left.join(right, key, JoinHow.Outer).unwrap()
        expect(outer.num_rows()).to_equal(Index.new(4))
        expect(outer.col(key).unwrap().is_missing(Index.new(1)).unwrap()).to_equal(true)
        expect(outer.col(key).unwrap().is_missing(Index.new(2)).unwrap()).to_equal(true)
        expect(outer.col(key).unwrap().get(Index.new(3))).to_equal(Int64.new(2))
        val right_join = left.join(right, key, JoinHow.Right).unwrap()
        expect(right_join.num_rows()).to_equal(Index.new(3))
        expect(right_join.col(key).unwrap().is_missing(Index.new(1)).unwrap()).to_equal(true)
        expect(right_join.col(key).unwrap().get(Index.new(2))).to_equal(Int64.new(2))

    it "matches signed floating zero and never matches NaN":
        step("Canonicalize signed zero while excluding NaN from equijoin matches")
        val key = Symbol.from("value")
        val negative_zero = Float64.new(f64_from_bits(0x8000000000000000u64))
        val nan = Float64.new(f64_from_bits(0x7FF8000000000001u64))
        val left_key = Series.from_f64_masked(key,
            [Float64.new(0.0), nan, negative_zero],
            [Bool.new(false), Bool.new(false), Bool.new(false)]).unwrap()
        val right_key = Series.from_f64_masked(key,
            [negative_zero, nan, Float64.new(0.0)],
            [Bool.new(false), Bool.new(false), Bool.new(false)]).unwrap()
        val left = DataFrame.from_columns([SeriesErased.F64Series(left_key)]).unwrap()
        val right = DataFrame.from_columns([
            SeriesErased.F64Series(right_key),
            SeriesErased.I64Series(Series.from_values(Symbol.from("ordinal"),
                [Int64.new(10), Int64.new(20), Int64.new(30)])),
        ]).unwrap()
        val joined = left.join(right, key, JoinHow.Inner).unwrap()
        expect(joined.num_rows()).to_equal(Index.new(4))
        val ordinal = joined.col(Symbol.from("ordinal")).unwrap()
        expect(ordinal.get(Index.new(0))).to_equal(Int64.new(10))
        expect(ordinal.get(Index.new(1))).to_equal(Int64.new(30))
        expect(ordinal.get(Index.new(2))).to_equal(Int64.new(10))
        expect(ordinal.get(Index.new(3))).to_equal(Int64.new(30))

    it "spreads ordinary floating keys across index slots":
        step("Keep whole-number float keys from forming one long probe chain")
        var occupied: [Bool] = []
        var slot_index = 0
        while slot_index < 2048:
            occupied.push(Bool.new(false))
            slot_index = slot_index + 1
        var distinct = 0
        var value = 1
        while value <= 1000:
            val slot = numeric_index_slot(
                numeric_f64_key(value as f64).unwrap(), 2047)
            if not occupied[slot].value:
                occupied[slot] = Bool.new(true)
                distinct = distinct + 1
            value = value + 1
        expect(distinct).to_be_greater_than(500)
