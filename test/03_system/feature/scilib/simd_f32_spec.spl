# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @cover src/lib/nogc_sync_mut/simd.spl 80%
"""
# SIMD f32 Intrinsics Specification

**Feature IDs:** REQ-SCILIB-C-001, REQ-SCILIB-C-004, NFR-SCILIB-C-001, NFR-SCILIB-C-002

Validates the interpreter-visible f32 SIMD facade used by the science backend
extension plan. These are explicit SIMD probes, not automatic ndarray backend
dispatch.
"""

use std.spec.step

use std.spipe.*
use std.simd.*



describe "SIMD f32x4 arithmetic":
    # @manual scenario evidence
    it "computes lane-wise add/sub/mul/div":
        # @req REQ-SCILIB-C-001
        # @req REQ-SSPEC-SYSTEM
        step("computes lane-wise add/sub/mul/div")
        val a = Vec4f(x: 8.0, y: 9.0, z: 10.0, w: 12.0)
        val b = Vec4f(x: 2.0, y: 3.0, z: 5.0, w: 6.0)
        val added = simd_add_f32x4(a, b)
        val subbed = simd_sub_f32x4(a, b)
        val multiplied = simd_mul_f32x4(a, b)
        val divided = simd_div_f32x4(a, b)
        expect(added.x).to_equal(10.0)  # oracle: 10.0 — pinned expected value for this behavior
        expect(added.w).to_equal(18.0)  # oracle: 18.0 — pinned expected value for this behavior
        expect(subbed.y).to_equal(6.0)  # oracle: 6.0 — pinned expected value for this behavior
        expect(multiplied.z).to_equal(50.0)  # oracle: 50.0 — pinned expected value for this behavior
        expect(divided.x).to_equal(4.0)  # oracle: 4.0 — pinned expected value for this behavior
        expect(divided.w).to_equal(2.0)  # oracle: 2.0 — pinned expected value for this behavior

    it "computes lane-wise fma":
        # @req REQ-SSPEC-SYSTEM
        step("computes lane-wise fma")
        val a = Vec4f(x: 1.0, y: 2.0, z: 3.0, w: 4.0)
        val b = Vec4f(x: 10.0, y: 10.0, z: 10.0, w: 10.0)
        val c = Vec4f(x: 1.0, y: 0.0, z: -1.0, w: 2.0)
        val result = simd_fma_f32x4(a, b, c)
        expect(result.x).to_equal(11.0)  # oracle: 11.0 — pinned expected value for this behavior
        expect(result.y).to_equal(20.0)  # oracle: 20.0 — pinned expected value for this behavior
        expect(result.z).to_equal(29.0)  # oracle: 29.0 — pinned expected value for this behavior
        expect(result.w).to_equal(42.0)  # oracle: 42.0 — pinned expected value for this behavior

describe "SIMD f32x8 arithmetic":
    it "computes lane-wise add/sub/mul/div across eight lanes":
        # @req REQ-SCILIB-C-004
        # @req REQ-SSPEC-SYSTEM
        step("computes lane-wise add/sub/mul/div across eight lanes")
        val a = Vec8f(e0: 8.0, e1: 9.0, e2: 10.0, e3: 12.0, e4: 14.0, e5: 15.0, e6: 16.0, e7: 18.0)
        val b = Vec8f(e0: 2.0, e1: 3.0, e2: 5.0, e3: 6.0, e4: 7.0, e5: 5.0, e6: 4.0, e7: 3.0)
        val added = simd_add_f32x8(a, b)
        val subbed = simd_sub_f32x8(a, b)
        val multiplied = simd_mul_f32x8(a, b)
        val divided = simd_div_f32x8(a, b)
        expect(added.e0).to_equal(10.0)  # oracle: 10.0 — pinned expected value for this behavior
        expect(added.e7).to_equal(21.0)  # oracle: 21.0 — pinned expected value for this behavior
        expect(subbed.e1).to_equal(6.0)  # oracle: 6.0 — pinned expected value for this behavior
        expect(multiplied.e2).to_equal(50.0)  # oracle: 50.0 — pinned expected value for this behavior
        expect(divided.e0).to_equal(4.0)  # oracle: 4.0 — pinned expected value for this behavior
        expect(divided.e7).to_equal(6.0)  # oracle: 6.0 — pinned expected value for this behavior

    it "computes lane-wise fma across eight lanes":
        # @req REQ-SSPEC-SYSTEM
        step("computes lane-wise fma across eight lanes")
        val a = Vec8f(e0: 1.0, e1: 2.0, e2: 3.0, e3: 4.0, e4: 5.0, e5: 6.0, e6: 7.0, e7: 8.0)
        val b = Vec8f(e0: 8.0, e1: 7.0, e2: 6.0, e3: 5.0, e4: 4.0, e5: 3.0, e6: 2.0, e7: 1.0)
        val c = Vec8f.splat(1.0)
        val fused = simd_fma_f32x8(a, b, c)
        expect(fused.e0).to_equal(9.0)  # oracle: 9.0 — pinned expected value for this behavior
        expect(fused.e3).to_equal(21.0)  # oracle: 21.0 — pinned expected value for this behavior
        expect(fused.e7).to_equal(9.0)  # oracle: 9.0 — pinned expected value for this behavior
