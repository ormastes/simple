"""
## Purpose and audience
Purpose: pins typed bulk-allocation ergonomics (TypedBuffer/IntBuffer/
ByteBuffer zeros/fill/alloc helpers) that the scilib perf-sugar port relies
on, verifying each helper's real constructed buffer content and length under
the interpreter rather than an unexplained magic number.
Audience: scilib port engineers who maintain the perf-sugar typed
bulk-allocation helpers (doc/03_plan/lib/scilib/ports/scilib_port_perf_sugar.md).

## Operator workflow
bin/simple test test/03_system/feature/scilib/perf_sugar_spec.spl

## Compatibility and limitations
Runs under interpreter mode; ByteBuffer.alloc depends on the rt_bytes_alloc
extern being registered on the executing binary.

## Verification guidance and troubleshooting
A failing scenario names the exact buffer size/value pair that diverged;
compare against doc/05_design/lib/science_math/scilib_port_architecture.md.
"""
# Lifecycle: doc/01_research/lib/scilib/05_perf_sugar_wedges.md ;
# doc/03_plan/lib/scilib/ports/scilib_port_perf_sugar.md ;
# doc/04_architecture/sspec_documentization_maintenance.md ;
# doc/05_design/lib/science_math/scilib_port_architecture.md
# @manual_section: Typed bulk-allocation buffers (f64/int/byte)

# PERF-SUGAR-001 smoke spec
# Verifies typed bulk-allocation patterns work in interpreter mode.

extern fn rt_bytes_alloc(len: int) -> [int]

class TypedBuffer:
    data: [float]
    length: int

    me get(idx: int) -> float:
        return self.data[idx]

    me size() -> int:
        return self.length

    static fn zeros(n: int) -> TypedBuffer:
        var arr: [float] = []
        var i = 0
        while i < n:
            arr = arr + [0.0]
            i = i + 1
        return TypedBuffer(data: arr, length: n)

    static fn fill(n: int, v: float) -> TypedBuffer:
        var arr: [float] = []
        var i = 0
        while i < n:
            arr = arr + [v]
            i = i + 1
        return TypedBuffer(data: arr, length: n)

class IntBuffer:
    data: [int]
    length: int

    me get(idx: int) -> int:
        return self.data[idx]

    me size() -> int:
        return self.length

    static fn zeros(n: int) -> IntBuffer:
        var arr: [int] = []
        var i = 0
        while i < n:
            arr = arr + [0]
            i = i + 1
        return IntBuffer(data: arr, length: n)

class ByteBuffer:
    data: [int]
    length: int

    me get(idx: int) -> int:
        return self.data[idx]

    me size() -> int:
        return self.length

    static fn alloc(n: int) -> ByteBuffer:
        val d = rt_bytes_alloc(n)
        return ByteBuffer(data: d, length: n)

describe "perf_sugar typed array allocation":
    it "f64 zeros creates correct length":
        # @req REQ-PERF-SUGAR-001
        step("Allocate an 8-element f64 zero buffer")
        val buf = TypedBuffer.zeros(8)
        # @capture: evidence_manifest("perf_sugar_f64_zeros_length") -> perf_sugar_spec.evidence.sdn
        step("Verify the buffer reports the requested length")
        expect(buf.size()).to_equal(8)  # oracle: 8 — the length passed to zeros()

    it "f64 zeros fills with zero":
        # @req REQ-PERF-SUGAR-002
        step("Allocate a 4-element f64 zero buffer")
        val buf = TypedBuffer.zeros(4)
        # @capture: evidence_manifest("perf_sugar_f64_zeros_fill") -> perf_sugar_spec.evidence.sdn
        step("Verify both the first and last element are zero-filled")
        expect(buf.get(0)).to_equal(0.0)  # oracle: 0.0 — zeros() fill value
        expect(buf.get(3)).to_equal(0.0)  # oracle: 0.0 — zeros() fill value

    it "f64 fill creates uniform buffer":
        # @req REQ-PERF-SUGAR-003
        step("Allocate a 5-element f64 buffer filled with 3.14")
        val buf = TypedBuffer.fill(5, 3.14)
        # @capture: evidence_manifest("perf_sugar_f64_fill_uniform") -> perf_sugar_spec.evidence.sdn
        step("Verify the length and both endpoints hold the fill value")
        expect(buf.size()).to_equal(5)  # oracle: 5 — the length passed to fill()
        expect(buf.get(0)).to_equal(3.14)  # oracle: 3.14 — the fill value passed to fill()
        expect(buf.get(4)).to_equal(3.14)  # oracle: 3.14 — the fill value passed to fill()

    it "int zeros creates correct length":
        # @req REQ-PERF-SUGAR-004
        step("Allocate a 6-element int zero buffer")
        val buf = IntBuffer.zeros(6)
        # @capture: evidence_manifest("perf_sugar_int_zeros_length") -> perf_sugar_spec.evidence.sdn
        step("Verify the length and both endpoints are zero-filled")
        expect(buf.size()).to_equal(6)  # oracle: 6 — the length passed to zeros()
        expect(buf.get(0)).to_equal(0)  # oracle: 0 — zeros() fill value
        expect(buf.get(5)).to_equal(0)  # oracle: 0 — zeros() fill value

    it "byte alloc via rt_bytes_alloc":
        # @req REQ-PERF-SUGAR-005
        step("Allocate a 16-byte buffer via the rt_bytes_alloc extern")
        val buf = ByteBuffer.alloc(16)
        # @capture: evidence_manifest("perf_sugar_byte_alloc") -> perf_sugar_spec.evidence.sdn
        step("Verify the buffer reports the requested length")
        expect(buf.size()).to_equal(16)  # oracle: 16 — the length passed to alloc()

    it "empty buffer has zero length":
        # @req REQ-PERF-SUGAR-006
        step("Allocate a zero-length f64 buffer")
        val buf = TypedBuffer.zeros(0)
        # @capture: evidence_manifest("perf_sugar_empty_buffer") -> perf_sugar_spec.evidence.sdn
        step("Verify the buffer reports zero length")
        expect(buf.size()).to_equal(0)  # oracle: 0 — the length passed to zeros()

    it "single element buffer":
        # @req REQ-PERF-SUGAR-007
        step("Allocate a single-element f64 buffer filled with 42.0")
        val buf = TypedBuffer.fill(1, 42.0)
        # @capture: evidence_manifest("perf_sugar_single_element") -> perf_sugar_spec.evidence.sdn
        step("Verify the length and sole element match the fill call")
        expect(buf.size()).to_equal(1)  # oracle: 1 — the length passed to fill()
        expect(buf.get(0)).to_equal(42.0)  # oracle: 42.0 — the fill value passed to fill()

    it "int buffer preserves values":
        # @req REQ-PERF-SUGAR-008
        step("Allocate a 3-element int zero buffer")
        val buf = IntBuffer.zeros(3)
        # @capture: evidence_manifest("perf_sugar_int_preserves_values") -> perf_sugar_spec.evidence.sdn
        step("Verify every element stays at the zero fill value")
        expect(buf.get(0)).to_equal(0)  # oracle: 0 — zeros() fill value
        expect(buf.get(1)).to_equal(0)  # oracle: 0 — zeros() fill value
        expect(buf.get(2)).to_equal(0)  # oracle: 0 — zeros() fill value

    it "moderate size allocation":
        # @req REQ-PERF-SUGAR-009
        step("Allocate a 100-element f64 zero buffer")
        val buf = TypedBuffer.zeros(100)
        # @capture: evidence_manifest("perf_sugar_moderate_size") -> perf_sugar_spec.evidence.sdn
        step("Verify the buffer reports the requested length")
        expect(buf.size()).to_equal(100)  # oracle: 100 — the length passed to zeros()
