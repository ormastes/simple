//! Tagged scalar FFI runtime smoke
//!
//! Exercises only the minimal runtime contracts backed in both registry lanes.

use compiler.ffi_minimal as ffi

fn main():
    val integer = ffi.value_int(10)
    val floating = ffi.value_float(2.5)
    val boolean = ffi.value_bool(true)
    val nothing = ffi.value_nil()

    assert ffi.value_is_int(integer)
    assert ffi.value_is_float(floating)
    assert ffi.value_is_bool(boolean)
    assert ffi.value_is_nil(nothing)
    assert ffi.value_as_int(integer) == 10
    assert ffi.value_as_float(floating) == 2.5
    assert ffi.value_as_bool(boolean)
