# codex-system-test
# @req REQ-PAR-002 REQ-PAR-006 NFR-PAR-002 NFR-PAR-003

"""
# Scheduler-owned actor channel authority

This system specification exercises the public scalar-text actor compatibility
surface through one explicit scheduler owner. It proves finite mailbox and
reply admission, admission-time argument copying, copied-reference routing,
one terminal scheduler removal, and fail-closed owner-domain queries over
populated state. The owner-domain scenario deterministically injects an
identity mismatch; it does not claim synchronized cross-thread ActorRef safety,
typed heap payload transport, or C/interpreter provider parity.

Run only with a qualified pure-Simple self-hosted test surface:

    SIMPLE_LIB=src bin/release/simple test test/03_system/feature/language/actor_channel_authority_spec.spl --mode=native

The Rust bootstrap seed is not acceptance evidence.
"""

use std.spec.*
use std.actor.actor.{Actor, HandlerTable}
use std.actor.mailbox.{ActorMailbox}
use std.actor.scheduler.{ActorScheduler}
use std.actor.spawn.{ActorRef}
use std.common.spec.evidence.model.{
    EvidenceStatus,
    canonical_evidence,
    evidence_node,
    oracle_spec,
    check_exact
}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

fn authority_echo(args: [text]) -> text:
    if args.is_empty():
        return ""
    args[0]

fn actor_ref_with_authority(scheduler: ActorScheduler,
                            mailbox: ActorMailbox) -> ActorRef:
    var handlers = HandlerTable.new()
    handlers.register("echo", authority_echo)
    val actor = Actor.with_mailbox(handlers, mailbox)
    val actor_id = scheduler.register_actor(actor)
    ActorRef(actor_id: actor_id, _scheduler: scheduler)

describe "scheduler-owned actor channel authority":
    it "should preserve bounded copied-reference authority through terminal stop":
        step("Create one scheduler-owned bounded actor channel")
        val scheduler = ActorScheduler.with_reply_capacity(1)
        val mailbox = ActorMailbox.new(1)
        val original = actor_ref_with_authority(scheduler, mailbox)
        val copied = original
        expect(original.get_id()).to_be_greater_than(0)
        expect(scheduler.reply_capacity()).to_equal(1)

        step("Admit copied arguments through one actor reference")
        var args = ["before"]
        val reply_id = original.ask("echo", args)
        expect(reply_id).to_be_greater_than(0)
        args[0] = "after"
        expect(copied.has_messages()).to_equal(true)

        step("Observe finite mailbox and reply backpressure")
        expect(copied.send("echo", ["mailbox-full"])).to_equal(false)
        expect(copied.ask("echo", ["reply-full"])).to_equal(-1)
        expect(scheduler.outstanding_reply_count()).to_equal(1)
        expect(mailbox.pending_high_water_count()).to_equal(1)

        step("Dispatch and consume the isolated result")
        scheduler.run_until_idle()
        var observed_reply = "missing"
        if val reply = scheduler.consume_reply(reply_id):
            observed_reply = reply
            expect(reply).to_equal("before")
        else:
            fail("the admitted actor reply must remain available")
        expect(scheduler.outstanding_reply_count()).to_equal(0)
        expect(copied.has_messages()).to_equal(false)

        step("Stop once through the owning scheduler")
        val first_stop = copied.stop()
        val second_stop = original.stop()
        val late_send = original.send("echo", ["late"])
        val late_ask = copied.ask("echo", ["late"])
        expect(first_stop).to_equal(true)
        expect(second_stop).to_equal(false)
        expect(late_send).to_equal(false)
        expect(late_ask).to_equal(-1)
        expect(original.has_messages()).to_equal(false)

        val evidence = canonical_evidence(
            "protocol",
            "actor-channel-authority/v1",
            [
                evidence_node("mailbox.high_water", "{mailbox.pending_high_water_count()}"),
                evidence_node("reply.capacity", "{scheduler.reply_capacity()}"),
                evidence_node("reply.value", observed_reply),
                evidence_node("reply.outstanding_after_consume", "{scheduler.outstanding_reply_count()}"),
                evidence_node("lifecycle.first_stop", "{first_stop}"),
                evidence_node("lifecycle.second_stop", "{second_stop}"),
                evidence_node("lifecycle.late_send", "{late_send}"),
                evidence_node("lifecycle.late_ask", "{late_ask}")
            ]
        )
        val oracle = oracle_spec(
            "actor-channel-authority/v1",
            [
                check_exact("mailbox.high_water", "1"),
                check_exact("reply.capacity", "1"),
                check_exact("reply.value", "before"),
                check_exact("reply.outstanding_after_consume", "0"),
                check_exact("lifecycle.first_stop", "true"),
                check_exact("lifecycle.second_stop", "false"),
                check_exact("lifecycle.late_send", "false"),
                check_exact("lifecycle.late_ask", "-1")
            ]
        )
        val comparison = compare_evidence(evidence, oracle)
        expect(comparison.status).to_equal(EvidenceStatus.passed)
        expect(comparison.summary).to_equal("8 check(s) passed")

    # @manual: fold
    it "should reject an unknown actor without publishing work or reply credit":
        step("Create an actor reference whose ID is absent from the scheduler")
        val scheduler = ActorScheduler.with_reply_capacity(1)
        val unknown = ActorRef(actor_id: 999999, _scheduler: scheduler)

        step("Reject every operation at the scheduler-owned registry boundary")
        expect(unknown.send("echo", ["unknown"])).to_equal(false)
        expect(unknown.ask("echo", ["unknown"])).to_equal(-1)
        expect(unknown.has_messages()).to_equal(false)
        expect(unknown.stop()).to_equal(false)
        expect(scheduler.outstanding_reply_count()).to_equal(0)

    # @req REQ-PAR-006 NFR-PAR-003
    it "should hide and preserve populated scheduler state outside its owner domain":
        step("Seed reply actor pending-message and error state in the owner domain")
        val scheduler = ActorScheduler.with_reply_capacity(2)
        var handlers = HandlerTable.new()
        handlers.register("echo", authority_echo)
        val actor_id = scheduler.register_actor(Actor.new(handlers))
        val reply_id = scheduler.ask_message(actor_id, "echo", ["retained"])
        scheduler.run_until_idle()
        expect(scheduler.send_message(actor_id, "missing", [])).to_equal(true)
        scheduler.run_once()
        expect(scheduler.send_message(actor_id, "echo", ["pending"])).to_equal(true)
        val owner_thread_id = scheduler.owner_thread_id
        expect(scheduler.outstanding_reply_count()).to_equal(1)
        expect(scheduler.actor_count()).to_equal(1)
        expect(scheduler.pending_message_count()).to_equal(1)
        expect(scheduler.actor_error_count(actor_id)).to_equal(1)

        step("Reject every query and reply lifecycle operation outside the owner domain")
        scheduler.owner_thread_id = -1
        val hidden_reply = scheduler.get_reply(reply_id)
        val hidden_capacity = scheduler.reply_capacity()
        val hidden_outstanding = scheduler.outstanding_reply_count()
        val rejected_consume = scheduler.consume_reply(reply_id)
        val rejected_cancel = scheduler.cancel_reply(reply_id)
        val hidden_actors = scheduler.actor_count()
        val hidden_pending = scheduler.pending_message_count()
        val hidden_errors = scheduler.actor_error_count(actor_id)
        val hidden_last_error = scheduler.actor_last_error(actor_id)
        val hidden_stats = scheduler.stats_string()
        expect(hidden_reply).to_be_nil()
        expect(hidden_capacity).to_equal(0)
        expect(hidden_outstanding).to_equal(0)
        expect(rejected_consume).to_be_nil()
        expect(rejected_cancel).to_equal(false)
        expect(hidden_actors).to_equal(0)
        expect(hidden_pending).to_equal(0)
        expect(hidden_errors).to_equal(0)
        expect(hidden_last_error).to_equal("")
        expect(hidden_stats).to_equal("Scheduler(unavailable: wrong thread)")

        step("Restore owner authority and prove rejected access changed no retained state")
        scheduler.owner_thread_id = owner_thread_id
        var restored_reply = "missing"
        if val completed = scheduler.get_reply(reply_id):
            restored_reply = completed
        else:
            fail("off-domain rejection must preserve the completed reply")
        expect(restored_reply).to_equal("retained")
        expect(scheduler.reply_capacity()).to_equal(2)
        expect(scheduler.outstanding_reply_count()).to_equal(1)
        expect(scheduler.actor_count()).to_equal(1)
        expect(scheduler.pending_message_count()).to_equal(1)
        expect(scheduler.actor_error_count(actor_id)).to_equal(1)
        expect(scheduler.actor_last_error(actor_id)).to_equal("method not found: missing")

        val evidence = canonical_evidence(
            "protocol",
            "actor-owner-domain-rejection/v1",
            [
                evidence_node("off_domain.reply_visible", "{hidden_reply.?}"),
                evidence_node("off_domain.reply_capacity", "{hidden_capacity}"),
                evidence_node("off_domain.reply_outstanding", "{hidden_outstanding}"),
                evidence_node("off_domain.cancel_accepted", "{rejected_cancel}"),
                evidence_node("off_domain.actor_count", "{hidden_actors}"),
                evidence_node("off_domain.pending_count", "{hidden_pending}"),
                evidence_node("off_domain.error_count", "{hidden_errors}"),
                evidence_node("restored.reply", restored_reply),
                evidence_node("restored.pending_count", "{scheduler.pending_message_count()}"),
                evidence_node("restored.error_count", "{scheduler.actor_error_count(actor_id)}")
            ]
        )
        val oracle = oracle_spec(
            "actor-owner-domain-rejection/v1",
            [
                check_exact("off_domain.reply_visible", "false"),
                check_exact("off_domain.reply_capacity", "0"),
                check_exact("off_domain.reply_outstanding", "0"),
                check_exact("off_domain.cancel_accepted", "false"),
                check_exact("off_domain.actor_count", "0"),
                check_exact("off_domain.pending_count", "0"),
                check_exact("off_domain.error_count", "0"),
                check_exact("restored.reply", "retained"),
                check_exact("restored.pending_count", "1"),
                check_exact("restored.error_count", "1")
            ]
        )
        val comparison = compare_evidence(evidence, oracle)
        expect(comparison.status).to_equal(EvidenceStatus.passed)
        expect(comparison.summary).to_equal("10 check(s) passed")
        expect(scheduler.cancel_reply(reply_id)).to_equal(true)
