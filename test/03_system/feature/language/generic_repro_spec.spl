# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec
use std.spec.step


class ReproMyVec:
    var items: [i64]

    fn push(item: i64):
        me.items.push(item)

    fn length() -> i64:
        me.items.length

type ReproIntVec = ReproMyVec

class ReproBox<T>:
    val value: T

    fn get() -> T:
        me.value

fn repro_identity<T>(x: T) -> T:
    x

describe "generic syntax repros":
    # @manual scenario evidence
    it "dispatches methods through a generic type alias":
        # @req REQ-SSPEC-SYSTEM
        step("dispatches methods through a generic type alias")
        val values = ReproIntVec(items: [])
        values.push(10)
        expect(values.length()).to_equal(1)

    it "parses generic instance method calls":
        # @req REQ-SSPEC-SYSTEM
        step("parses generic instance method calls")
        val box = ReproBox<i64>(value: 42)
        expect(box.get()).to_equal(42)

    it "parses explicit generic function calls":
        # @req REQ-SSPEC-SYSTEM
        step("parses explicit generic function calls")
        expect(repro_identity<i64>(42)).to_equal(42)
