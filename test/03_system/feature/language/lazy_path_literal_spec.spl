use std.spec.*
use std.nogc_sync_mut.env.system_location.{LazyPathTemplate, SystemLocationInputs}

fn accept_path(value: LazyPathTemplate) -> LazyPathTemplate:
    value

fn linux_inputs() -> SystemLocationInputs:
    SystemLocationInputs(
        platform: "linux", home: "/home/alice", user_profile: "",
        local_app_data: "", app_data: "", xdg_cache: "", xdg_config: "",
        xdg_data: "", xdg_state: "", xdg_runtime: "", temp_dir: "/tmp",
        simple_home: "", simple_user_local: "", simple_user_cache: "",
        simple_user_config: "", simple_user_data: "", simple_user_state: "",
        simple_runtime: "", simple_temp: "", simple_cache: "/cache/simple")

describe "lazy path literal language surface":
    it "lowers _path to an inert strong value":
        val path = accept_path('{sys:compiler_cache}/objects'_path)
        expect(path.resolved_once).to_equal(false)
        expect(path.resolve_from(linux_inputs()).unwrap()).to_equal("/cache/simple/objects")
        expect(path.resolved_once).to_equal(true)

    it "uses the expected LazyPathTemplate parameter type":
        val path: LazyPathTemplate = '{sys:temp}/artifact'_path
        expect(accept_path(path).resolve_from(linux_inputs()).unwrap())
            .to_equal("/tmp/artifact")
