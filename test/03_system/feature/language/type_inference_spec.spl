"""
# Type Inference Specification - Test Specification

**Status:** Partial Implementation (Hindley-Milner scaffold working)
**Feature IDs:** #13
**Source:** type_inference.md
**Type:** Extracted Examples (Category B)
**Last Updated:** 2026-02-08
**Migrated From:** doc/06_spec/feature/language/type_inference_spec.md

## Overview

Simple uses a Hindley-Milner-style type inference system that automatically deduces types
for expressions, variables, and functions without requiring explicit type annotations.

This test file covers basic type inference rules that work in the current runtime.

## Syntax

Type annotations are optional when the type can be inferred:

    val x = 42          # inferred: i64
    val y = 3.14        # inferred: f64
    val s = "hello"     # inferred: text
    val b = true        # inferred: bool

Function return types are inferred from the body:

    fn double(x: i64) -> _:   # _ = inferred i64
        x * 2

Generic instantiation inferred from arguments:

    fn identity<T>(x: T) -> T: x

    val a = identity(5)     # T inferred as i64
    val b = identity("hi")  # T inferred as text

Bidirectional inference from expected type:

    val nums: [i64] = [1, 2, 3]  # list element type inferred

## Examples

    val x = 42
    val y = x + 8    # => 50  (i64 propagated through arithmetic)

    val flag = x > 10    # => true  (bool from comparison)

    fn square(n: i64) -> i64: n * n
    square(7)   # => 49  (no annotation needed at call site)

    val words = ["a", "b", "c"]
    words.len()  # => 3  (list type inferred as [text])

## Key Concepts

**Hindley-Milner (HM)** — Simple's inference algorithm is based on HM with
extensions. Every expression has a principal type that is uniquely inferred
without programmer annotations (except at module boundaries for public APIs).

**Unification** — the inference engine collects equality constraints between
type variables and solves them. A conflict (e.g., using an `i64` where
`text` is expected) is caught at unification, not at run time.

**Generalization** — at let-bindings, free type variables are generalised
into universally quantified type schemes, enabling reuse with different
concrete types.

**Bidirectional inference** — expected types (from context) flow inward;
synthesised types (from expressions) flow outward. This reduces annotation
burden on lambda arguments and collection literals.

**Annotation escapes** — public API boundaries require explicit type
annotations so that library consumers get stable, documented types instead
of inferred internals that could change across versions.

**Rank-1 polymorphism** — Simple infers rank-1 (prenex) types by default.
Higher-rank types require explicit annotations and are rare in practice.

## Common Patterns

Let-bound generics (inferred at each use site):

    val id = |x| x         # type: <T> (T) -> T
    id(5)                   # => 5  (T = i64)
    id("hi")                # => "hi" (T = text)

Inference through `match`:

    val result = match flag:
        true  => 1
        false => 0
    # result: i64 (both branches unify)

Collection literal with inferred element type:

    val nums = [1, 2, 3]    # [i64]
    val tags = ["a", "b"]   # [text]

Closure return type inferred from body:

    val square = |x: i64| x * x   # (i64) -> i64 — no annotation needed
"""

use std.spec
use std.spec.{expect}

use std.spec.step

describe "Type Inference Spec":
    it "inference rules - literals":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - literals")
        # Integer, float, string, boolean literals infer their types
        val x = 42
        val y = 3.14
        val s = "hello"
        val b = true
        expect(x).to_equal(42)  # oracle: 42 — pinned expected value for this behavior
        expect(y).to_equal(3.14)  # oracle: 3.14 — pinned expected value for this behavior
        expect(s).to_equal("hello")
        expect(b).to_equal(true)

    it "inference rules - arithmetic":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - arithmetic")
        # Operators infer types from operands
        val a = 1 + 2
        val b = 3.0 * 1.5
        expect(a).to_equal(3)  # oracle: 3 — pinned expected value for this behavior

    it "inference rules - comparison":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - comparison")
        # Comparison operators return bool
        val cmp = 1 < 2
        expect(cmp).to_equal(true)

    it "inference rules - logical":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - logical")
        # Logical operators return bool
        val logic = true and false
        expect(logic).to_equal(false)

    it "inference rules - bitwise":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - bitwise")
        # Bitwise operators work on integers
        val bits = 5 << 2
        expect(bits).to_equal(20)  # oracle: 20 — pinned expected value for this behavior

    it "inference rules - arrays":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - arrays")
        # Arrays infer element type from literals
        val arr = [1, 2, 3]
        expect(arr[0]).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

    it "inference rules - tuples":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - tuples")
        # Tuples can have mixed types
        val t = (1, "hi", true)
        expect(t.0).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(t.1).to_equal("hi")
        expect(t.2).to_equal(true)

    it "inference rules - dictionaries":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - dictionaries")
        # Dictionaries infer key/value types
        val dict = {"a": 1, "b": 2}
        expect(dict["a"]).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect(dict["b"]).to_equal(2)  # oracle: 2 — pinned expected value for this behavior

    it "inference rules - functions with explicit types":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - functions with explicit types")
        # Functions can have explicit return types
        fn add(a: i64, b: i64) -> i64:
            a + b
        val result = add(3, 4)
        expect(result).to_equal(7)  # oracle: 7 — pinned expected value for this behavior

    it "inference rules - lambda types":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - lambda types")
        # Lambda expressions infer from context
        val double = _1 * 2
        val result = double(5)
        expect(result).to_equal(10)  # oracle: 10 — pinned expected value for this behavior

    it "inference rules - higher-order functions":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - higher-order functions")
        # Functions can take functions as arguments
        fn apply(f: fn(i64) -> i64, x: i64) -> i64:
            f(x)

        val square = _1 * _1
        val result = apply(square, 5)
        expect(result).to_equal(25)  # oracle: 25 — pinned expected value for this behavior

    it "inference rules - if expressions":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - if expressions")
        # If-else expressions infer unified type
        val x = 1
        val v = if x > 0:
            1
        else:
            2
        expect(v).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

    it "inference rules - loops":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: inference rules - loops")
        # Loops with type-stable variables
        # Note: Closure variable capture has known limitations
        var i = 0
        while i < 3:
            i = i + 1
        expect(i).to_equal(3)  # oracle: 3 — pinned expected value for this behavior

    it "examples - basic iteration":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: examples - basic iteration")
        # For loop with array inference
        val numbers = [1, 2, 3, 4, 5]
        var sum = 0
        for n in numbers:
            sum = sum + n
        expect(sum).to_equal(15)  # oracle: 15 — pinned expected value for this behavior

    it "examples - map function":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: examples - map function")
        # Higher-order function with generics
        fn map_simple(arr: [i64], f: fn(i64) -> i64) -> [i64]:
            var result = []
            for x in arr:
                result = result + [f(x)]
            result

        val numbers = [1, 2, 3]
        val doubled = map_simple(numbers, _1 * 2)
        expect(doubled[0]).to_equal(2)  # oracle: 2 — pinned expected value for this behavior
        expect(doubled[1]).to_equal(4)  # oracle: 4 — pinned expected value for this behavior
        expect(doubled[2]).to_equal(6)  # oracle: 6 — pinned expected value for this behavior

    it "examples - option type with match":
        # @req: REQ-FEATURE-TYPE-INFERENCE-001
        step("Verify: examples - option type with match")
        # Option type with pattern matching
        fn find_first(arr: [i64], target: i64) -> i64:
            for x in arr:
                if x == target:
                    return x
            return -1

        val numbers = [10, 20, 30]
        val found = find_first(numbers, 20)
        val not_found = find_first(numbers, 99)

        expect(found).to_equal(20)  # oracle: 20 — pinned expected value for this behavior
        expect(not_found).to_equal(-1)  # oracle: -1 — pinned expected value for this behavior
