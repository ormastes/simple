# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# GC-Mode Module Resolution

**Feature IDs:** N/A
**Category:** Infrastructure
**Difficulty:** 4/5
**Status:** Implemented
**Requirements:** N/A
**Plan:** N/A
**Design:** N/A
**Research:** N/A

## Overview

Verifies that the module loader resolves modules from the correct
variant directories. Tests that common/ modules are accessible
and that the fallback chain works after migration.
"""

use std.spec
use std.spec.step

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

fn _spl_file_count(path: text) -> i64:
    val (stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", "find " + path + " -type f -name '*.spl' | wc -l"])
    if code != 0:
        return -1
    stdout.trim().to_i64() ?? -1

fn _gc_sync_mut_mirror_is_synced() -> bool:
    val (_stdout, _stderr, code) = rt_process_run("/bin/sh", ["-c", "diff -qr src/lib/gc_sync_mut src/std/gc_sync_mut >/dev/null"])
    code == 0

# ============================================================================
# Module Resolution Verification
# ============================================================================

describe "Module Resolution Fallback":
    # @manual scenario evidence
    """
    ## Fallback Chain

    Modules in common/ should be accessible from any variant context.
    Modules migrated from nogc_sync_mut to common/ must still resolve.
    """

    context "when importing array utilities from common":
        """
        ### Migrated Module Access

        array.spl was moved from nogc_sync_mut to common/.
        It should still be importable via the standard path.
        """

        it "accesses array utilities after migration":
            # @req REQ-SSPEC-SYSTEM
            step("accesses array utilities after migration")
            """
            Basic array operations should work after migration.
            """
            val items = [3, 1, 2]
            expect(items[0]).to_equal(3)
            expect(items.len()).to_equal(3)

    context "when verifying the sync GC family":
        """
        ### Realized Variant Directory

        gc_sync_mut/ is a realized runtime family. Its source tree must remain
        substantial and mirrored into the std resolution root.
        """

        it "exposes gc_sync_mut as a realized variant family":
            # @req REQ-SSPEC-SYSTEM
            step("exposes gc_sync_mut as a realized variant family")
            """
            A missing or placeholder directory must fail this architecture gate.
            """
            expect(_spl_file_count("src/lib/gc_sync_mut")).to_be_greater_than(100)

        it "mirrors gc_sync_mut into the std resolution root":
            # @req REQ-SSPEC-SYSTEM
            step("mirrors gc_sync_mut into the std resolution root")
            """
            The std import root must contain the same files and contents as src/lib.
            """
            expect(_gc_sync_mut_mirror_is_synced()).to_equal(true)
