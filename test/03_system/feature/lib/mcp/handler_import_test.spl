# Handler-path import checks for std.nogc_async_mut.mcp.helpers
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use std.nogc_async_mut.mcp.helpers.{jp, js, make_tool_result, make_error_response}

describe "MCP handler import paths":
    it "builds a JSON pair with jp":
        val pair = jp("key", "value")
        expect(pair.contains("key")).to_equal(true)
        expect(pair.contains("value")).to_equal(true)

    it "builds a tool result carrying the content":
        val result = make_tool_result("1", "test content")
        expect(result.contains("result")).to_equal(true)
        expect(result.contains("test content")).to_equal(true)

    it "builds an error response carrying the code":
        val error = make_error_response("2", -32601, "test error")
        expect(error.contains("error")).to_equal(true)
        expect(error.contains("-32601")).to_equal(true)
