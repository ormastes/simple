# Schema module checks for std.nogc_async_mut.mcp.schema
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# The runner now refuses to synthesize a pass for output with no parseable
# pass/fail summary; the checks below are the SAME checks, now asserted.

use std.nogc_async_mut.mcp.schema.{get_all_tool_schemas, get_tool_count, init_core_schemas}

describe "MCP schema module":
    it "initializes the core schemas and reports the expected tool count":
        init_core_schemas()
        expect(get_tool_count()).to_equal(8)

    it "returns all tool schemas as a JSON array":
        init_core_schemas()
        val schemas = get_all_tool_schemas()
        expect(schemas.starts_with("[")).to_equal(true)
        expect(schemas.ends_with("]")).to_equal(true)

    it "includes the expected core tools in the schema payload":
        init_core_schemas()
        val schemas = get_all_tool_schemas()
        expect(schemas.contains("read_code")).to_equal(true)
        expect(schemas.contains("list_files")).to_equal(true)
