# Similar-bug-class detection: print-only test files that can never go RED.
#
# Class definition. A file under a test tree that is a plain `fn main()` script
# whose checks are `if ok: print("...") else: print("...")` has NO oracle: the
# failure branch prints and the process still exits 0, emitting no `Results:`
# line. On the command every session uses as evidence (`bin/simple test <file>`)
# such a file is indistinguishable from a file that passed. This is the exact
# shape of two separately-filed bugs:
#
#   doc/08_tracking/bug/legacy_mcp_feature_tests_target_removed_api_and_assert_nothing_2026-08-04.md
#   doc/08_tracking/bug/mcp_bootstrap_protocol_dead_main_optimized_subject_2026-07-20.md
#
# Both were in test/**/feature/lib/mcp/. A reproducing spec for either one only
# pins that ONE file; this spec pins the CLASS across the directory, so a third
# file reintroducing the shape goes red here instead of shipping silent-green.
#
# The rule enforced: every *_test.spl / *_spec.spl in the scanned directories
# must contain at least one real oracle token (`expect(`, `assert_true`,
# `assert_false`, `assert_equal`, `assert_not_equal`, `assert_contains`,
# `assert_nil`). A file with zero oracle tokens is vacuous by construction,
# regardless of how many `print` lines it has.
#
# @tag: mcp,testing,vacuous-green,meta

"""
## Purpose and audience
This spec pins the vacuous-green bug CLASS across the MCP feature test
trees: a print-only `fn main()` script can never fail, so its green exit
proves nothing. Audience: maintainers of the MCP feature tests and reviewers
of new test files landing under `test/03_system/feature/lib/mcp/` and
`test/feature/lib/mcp/`.

## Operator workflow
Run the spec with the seed runner:
`./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/lib/mcp/vacuous_print_only_test_detection_spec.spl`
The scan walks both directories, reads every `*_test.spl` / `*_spec.spl`,
and fails if any file carries zero oracle tokens.

## Compatibility and limitations
The scan is textual: a file whose only oracle token sits inside a string
literal or a comment would pass the token census while still being vacuous;
closing that gap needs a parser-grade scan and is out of scope here. Files
in scanned directories that use none of the seven oracle tokens but are
legitimately assertion-free (pure fixtures) would false-positive; none exist
today.

## Verification guidance and troubleshooting
A failure of "finds no test file lacking any assertion" names the vacuous
file through `bad` — add a real oracle to that file (or delete it if it
tests nothing). If the non-empty-scan control fails, both scanned
directories vanished or became unreadable; check the checkout before
trusting any green.
"""

# Lifecycle: doc/01_research/app/mcp/mcp_feature_analysis_2026-02-05.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/app/mcp/mcp_performance_regression_enforcement.md ;
# doc/05_design/app/mcp/mcpgdb.md

use std.spec.step

use app.io.mod (dir_entries, file_exists, file_read)

# @manual_section: vacuous-green-class-guards

val SCANNED_DIRS: [text] = [
    "test/03_system/feature/lib/mcp",
    "test/feature/lib/mcp"
]

val ORACLE_TOKENS: [text] = [
    "expect(",
    "assert_true",
    "assert_false",
    "assert_equal",
    "assert_not_equal",
    "assert_contains",
    "assert_nil"
]

fn has_oracle(source: text) -> bool:
    for token in ORACLE_TOKENS:
        if source.contains(token):
            return true
    false

fn test_files_in(dir: text) -> [text]:
    var found: [text] = []
    if not file_exists(dir):
        return found
    for name in dir_entries(dir):
        if name.ends_with("_test.spl") or name.ends_with("_spec.spl"):
            found.push(dir + "/" + name)
    found

fn vacuous_files() -> [text]:
    var bad: [text] = []
    for dir in SCANNED_DIRS:
        for path in test_files_in(dir):
            if not has_oracle(file_read(path)):
                bad.push(path)
    bad

describe "no vacuous print-only test files in the MCP feature trees":
    it "scans a non-empty set of test files (guards against a vacuous scan)":
        # @req REQ-MCP-VACUOUS-001
        # @capture(statistics): the scanned-directory file counts retained as a checked total
        step("Count the test files in both scanned MCP feature directories")
        # A scan that finds nothing may have scanned nothing. This control MUST
        # produce hits, otherwise the absence check below proves nothing.
        var total = 0
        for dir in SCANNED_DIRS:
            total = total + test_files_in(dir).len()
        expect(total).to_be_greater_than(0)

    it "detects that the oracle-token rule itself can fail":
        # @req REQ-MCP-VACUOUS-002
        # @capture(statistics): the predicate's positive and negative controls retained as checked booleans
        step("Run the oracle-token predicate against a print-only body and an asserting body")
        # Positive control for the predicate: a print-only body has no oracle.
        val print_only = "fn main():\n    if ok:\n        print(\"ok\")\n    else:\n        print(\"fail\")\n"
        expect(has_oracle(print_only)).to_equal(false)  # oracle: a body whose only branches print must not satisfy any oracle token, or the class guard admits vacuous files
        val asserted = "describe \"x\":\n    it \"y\":\n        assert_true(cond)\n"
        expect(has_oracle(asserted)).to_equal(true)  # oracle: assert_true is one of the seven oracle tokens, so an asserting body must flip the predicate to true

    it "finds no test file lacking any assertion":
        # @req REQ-MCP-VACUOUS-003
        # @capture(statistics): the vacuous-file offender list retained as a checked empty set
        step("Scan both MCP feature trees for files with zero oracle tokens")
        val bad = vacuous_files()
        expect(bad.len()).to_equal(0)  # oracle: zero offenders is the contract — every checked-in MCP feature test file carries a real oracle today
