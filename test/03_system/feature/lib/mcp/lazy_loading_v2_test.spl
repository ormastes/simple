# MCP Lazy Loading v2 registry + category-loader checks
#
# Converted 2026-08-17 from a print-only script whose "✗" branches printed and
# then exited 0, so every check was vacuous and the file could never go RED.
# Same checks, now asserted.

use std.nogc_async_mut.mcp.lazy_registry_v2.{
    init_registry,
    register_handler_metadata,
    get_tool_category,
    is_category_loaded,
    mark_category_loaded,
    get_registry_stats
}
use std.nogc_async_mut.mcp.category_loaders_v2.{
    load_category,
    load_fileio_category,
    reset_loaders,
    is_fileio_loaded,
    is_edit_loaded
}

describe "MCP lazy loading v2":
    it "initializes the registry empty":
        init_registry()
        expect(get_registry_stats().contains("0 handlers")).to_equal(true)

    it "registers a handler and reflects it in the stats":
        init_registry()
        register_handler_metadata("test_tool", "test_cat")
        expect(get_registry_stats().contains("1 handlers")).to_equal(true)

    it "looks up a registered tool's category":
        init_registry()
        register_handler_metadata("test_tool", "test_cat")
        expect(get_tool_category("test_tool")).to_equal("test_cat")

    it "tracks category loaded state":
        init_registry()
        register_handler_metadata("test_tool", "test_cat")
        expect(is_category_loaded("test_cat")).to_equal(false)
        mark_category_loaded("test_cat")
        expect(is_category_loaded("test_cat")).to_equal(true)

    it "loads the fileio category and marks it in the registry":
        init_registry()
        reset_loaders()
        register_handler_metadata("simple_read", "fileio")
        expect(is_fileio_loaded()).to_equal(false)
        load_fileio_category()
        expect(is_fileio_loaded()).to_equal(true)
        expect(is_category_loaded("fileio")).to_equal(true)

    it "loads a category by name":
        init_registry()
        reset_loaders()
        expect(is_edit_loaded()).to_equal(false)
        load_category("edit")
        expect(is_edit_loaded()).to_equal(true)

    it "reports 'unknown' for an unregistered tool":
        init_registry()
        expect(get_tool_category("nonexistent")).to_equal("unknown")

    it "registers multiple handlers across categories":
        init_registry()
        register_handler_metadata("tool1", "cat1")
        register_handler_metadata("tool2", "cat1")
        register_handler_metadata("tool3", "cat2")
        expect(get_registry_stats().contains("3 handlers")).to_equal(true)
        expect(get_tool_category("tool1")).to_equal("cat1")
        expect(get_tool_category("tool2")).to_equal("cat1")
        expect(get_tool_category("tool3")).to_equal("cat2")
