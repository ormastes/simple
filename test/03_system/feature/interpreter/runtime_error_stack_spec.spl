"""
# Interpreter Runtime Error Stack Trace

**Category:** Runtime
**Status:** In Progress

## Overview

Tests runtime error stack trace generation in the interpreter including error
message formatting, source location reporting, and call chain display. Verifies
that runtime errors produce actionable diagnostics with accurate file and line info.
"""
# # Interpreter Runtime Error Stack Trace
#
# **Feature ID:** #RUNTIME-002
# **Category:** Runtime
# **Status:** Active
#
# ## Overview
#
# System test that runs the interpreter CLI against a sample script to verify that runtime errors
# include a full call stack section. Validates that when calling nested functions that trigger an
# undefined function error, the output includes the "Runtime error" header, the specific error
# message, a "Call stack:" section, and frame entries for each function in the call chain
# (level1, level2, level3).
#
# ## Syntax
#
# ```simple
# val result = run_interpreter(["run", "src/app/interpreter/main.spl", script])
# expect result.exit_code != 0
# expect result.stderr.contains("Call stack:")
# expect result.stderr.contains("level1")
# ```
# Interpreter Runtime Error Stack Trace - System Test
#
# Runs the interpreter CLI against a sample script to verify
# that runtime errors include a call stack section.
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

struct ProcResult:
    stdout: text
    stderr: text
    exit_code: i64

fn run_interpreter(args: [text]) -> ProcResult:
    val result = rt_process_run(find_simple_binary(), ["run"] + args)
    ProcResult(stdout: result[0], stderr: result[1], exit_code: result[2])

fn find_simple_binary() -> text:
    if rt_file_exists("src/compiler_rust/target/release/simple"):
        return "src/compiler_rust/target/release/simple"
    if rt_file_exists("src/compiler_rust/target/bootstrap/simple"):
        return "src/compiler_rust/target/bootstrap/simple"
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    if rt_file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if rt_file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if rt_file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if rt_file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if rt_file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

describe "Interpreter Runtime Error Stack Trace":
    it "includes call stack for nested functions":
        # REPOINTED 2026-08-17, twice over, and this spec is KNOWN-RED by design.
        #
        # 1. Vehicle: this used to spawn `src/app/interpreter/main.spl`. That
        #    whole tree was deleted (declared REMOVED in `src/app/__init__.spl`
        #    since 2026-02, still on disk, did not parse, zero importers --
        #    doc/08_tracking/bug/app_interpreter_tree_declared_removed_but_still_on_disk_2026-08-10.md).
        #    The behaviour under test -- a runtime error carrying a call stack --
        #    is a property of the live compiler, not of that dead tree, so the
        #    spec now runs the fixture directly on `bin/simple run`.
        # 2. Fixture path: the old `test/system/interpreter/sample/...` path does
        #    not exist and has not for some time, so this spec could never have
        #    passed even before the tree was deleted -- it failed on a missing
        #    file, not on the assertion. Corrected to the real tracked location.
        #
        # It is left RED rather than weakened: on the live path `missing_fn` is
        # caught at SEMANTIC analysis (`error[E1002]: function 'missing_fn' not
        # found`), so there is no "Runtime error" header and no "Call stack:"
        # section. That is a genuine gap in runtime-error reporting, tracked in
        # doc/08_tracking/bug/runtime_error_stack_absent_on_live_interpreter_2026-08-17.md.
        # Unblock condition: the interpreter emits a "Call stack:" section with
        # per-frame entries for runtime errors. Do NOT soften these assertions.
        val script = "test/03_system/feature/interpreter/sample/runtime_error_stack.spl"
        val result = run_interpreter([script])
        expect result.exit_code != 0
        expect result.stderr.contains("Runtime error")
        expect result.stderr.contains("undefined function 'missing_fn'")
        expect result.stderr.contains("Call stack:")
        expect result.stderr.contains("level1")
        expect result.stderr.contains("level2")
        expect result.stderr.contains("level3")
