# @req: REQ-FEATURE-BASIC-EXPRESSIONS-001


"""
# Basic Expressions (Interpreter)

**Category:** Runtime
**Status:** In Progress

## Overview

Tests basic expression evaluation in the interpreter including arithmetic, string
operations, and type coercion. Verifies that the interpreter correctly computes
expression results matching the compiled output behavior.
"""
# # Basic Expressions Specification
#
# **Feature IDs:** #BASIC-EXPRESSIONS
# **Category:** Core
# **Status:** Implemented
#
# Tests Python-inspired expression evaluation in Simple.
# Covers arithmetic, comparison, logical, and string expressions.

use std.spec.step

describe "Basic Expressions":
    # ## Expression Evaluation
    #
    # Verifies Python-like expression semantics:
    # - Arithmetic operators (+, -, *, /, %)
    # - Comparison operators (==, !=, <, >, <=, >=)
    # - Logical operators (and, or, not)
    # - String operations and interpolation

    context "arithmetic expressions":
        it "evaluates addition":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates addition")
            expect 2 + 3 == 5

        it "evaluates subtraction":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates subtraction")
            expect 10 - 4 == 6

        it "evaluates multiplication":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates multiplication")
            expect 6 * 7 == 42

        it "evaluates division":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates division")
            expect 20 / 4 == 5

        it "evaluates modulo":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates modulo")
            expect 17 % 5 == 2

        it "respects operator precedence":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: respects operator precedence")
            expect 2 + 3 * 4 == 14

    context "comparison expressions":
        it "compares equality":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: compares equality")
            expect (5 == 5) == true
            expect (5 == 6) == false

        it "compares inequality":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: compares inequality")
            expect (5 != 6) == true

        it "compares less than":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: compares less than")
            expect (3 < 5) == true
            expect (5 < 3) == false

        it "compares greater than":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: compares greater than")
            expect (5 > 3) == true

    context "logical expressions":
        it "evaluates and":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates and")
            expect (true && true) == true
            expect (true && false) == false

        it "evaluates or":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates or")
            expect (false || true) == true
            expect (false || false) == false

        it "evaluates not":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: evaluates not")
            expect (not true) == false
            expect (not false) == true

    context "string expressions":
        it "concatenates strings":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: concatenates strings")
            val result = "hello" + " " + "world"
            expect result == "hello world"

        it "interpolates values":
            # @req: REQ-FEATURE-BASIC-EXPRESSIONS-001
            step("Verify: interpolates values")
            val x = 42
            val msg = "value is {x}"
            expect msg == "value is 42"
