"""
# Variables and Assignment (Interpreter)

**Feature IDs:** #VARIABLES-ASSIGNMENT
**Category:** Language
**Status:** Implemented

## Purpose and audience
Exercises val/var binding semantics as the interpreter executes them: immutable
and mutable declarations, type inference from computed initializers, and
reassignment of mutable bindings. Written for language engineers verifying
interpreter binding behavior and for operators confirming that Python-inspired
variable semantics still hold on a deployed binary.

## Operator workflow
Run the file with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/interpreter/sample/python_inspired_sample/variables_assignment_spec.spl
Every scenario binds a value, reads the binding back, and compares it against a
pinned oracle value on the same line.

## Compatibility and limitations
Covers scalar i64/text/bool bindings and plain reassignment only; collection
bindings and walrus-style assignment live in sibling specs. Requires a binary
that parses current-source syntax — the Jul-25 stage4 binary rejects this file.

## Verification guidance and troubleshooting
A failure names the binding form that mis-executed; rerun the single file above
and compare the reported value against the trailing oracle comment. A binding
that reads back a stale or coerced value means the interpreter's environment
handling regressed.
"""

# Lifecycle: doc/01_research/language/const_val/var_val_unification_2026-01-17.md ;
# doc/03_plan/sspec_modernization_plan.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/interpreter/m5_strict_interpreter_mode_design.md

use std.spec.step

describe "Variables and Assignment":
    # @manual_section: variable binding semantics
    # ## Variable Declaration and Assignment
    #
    # Verifies Python-like variable semantics:
    # - val for immutable bindings (like Python's convention for constants)
    # - var for mutable bindings
    # - Type inference from assigned values
    # - Multiple assignment patterns

    context "val declarations":
        it "creates immutable binding with inferred type":
            # @req REQ-VARASSIGN-001
            # @capture(statistics): bound value read back from the val binding
            step("bind 40 + 2 as an immutable val and read it back")
            val x = 40 + 2
            expect(x).to_equal(42)  # oracle: 42 is the evaluated initializer

        it "creates immutable binding with explicit type":
            # @req REQ-VARASSIGN-002
            # @capture(statistics): annotated binding read back unchanged
            step("bind a text value under an explicit type annotation")
            val name: text = "Al" + "ice"
            expect(name).to_equal("Alice")

    context "var declarations":
        it "allows reassignment of mutable binding":
            # @req REQ-VARASSIGN-003
            # @capture(statistics): post-reassignment readback
            step("reassign a mutable var binding and read the new value")
            var count = 0
            count = count + 1
            expect(count).to_equal(1)  # oracle: 1 is the reassigned value

        it "supports compound assignment":
            # @req REQ-VARASSIGN-004
            # @capture(statistics): accumulate-then-read readback
            step("accumulate into a var across statements and read the total")
            var total = 10
            total = total + 5
            expect(total).to_equal(15)  # oracle: 15 is the accumulated total

    context "type inference":
        it "infers integer type":
            # @req REQ-VARASSIGN-005
            # @capture(statistics): inferred-integer binding readback
            step("bind a computed integer and read it back")
            val num = 64 + 36
            expect(num).to_equal(100)  # oracle: 100 is the evaluated initializer

        it "infers string type":
            # @req REQ-VARASSIGN-006
            # @capture(statistics): inferred-text binding readback
            step("bind a computed text value and read it back")
            val msg = "hell" + "o"
            expect(msg).to_equal("hello")

        it "infers boolean type":
            # @req REQ-VARASSIGN-007
            # @capture(statistics): inferred-bool binding readback
            step("bind a computed boolean and read it back")
            val flag = 1 < 2
            expect(flag).to_equal(true)
