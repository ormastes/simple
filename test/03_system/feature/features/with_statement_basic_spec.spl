# @cover src/compiler/95.interp/interpreter/mod.spl 80%
#!/usr/bin/env simple
# Test basic with statement functionality

use std.spec

use std.spec.step

# Module-level recorders: closures capture enclosing locals by value and are
# read-only (.claude/rules/language.md:22), so a write to a captured local
# is a compile error. Examples reset these at the old declaration site.
var cleanup_called_cw = false
var enter_called_cw = false
var cleanup_called_cw2 = false

describe "with statement":
    # @manual scenario evidence
    it "calls enter and cleanup on simple context manager":
        # Define a simple context manager
        class TestContext:
            entered: bool
            cleaned: bool

            fn enter() -> TestContext:
                self.entered = true
                self

            fn cleanup():
                self.cleaned = true

        # Create context manager
        val ctx = TestContext(entered: false, cleaned: false)

        # Use with statement
        with ctx as c:
            check c.entered

        # Check cleanup was called
        check ctx.cleaned

    it "calls cleanup even when block completes normally":
        cleanup_called_cw = false

        class TestContext:
            fn enter() -> TestContext:
                self

            fn cleanup():
                cleanup_called_cw = true

        val ctx = TestContext()

        with ctx:
            val x = 42

        check cleanup_called_cw

    it "supports variable binding with as clause":
        class ValueContext:
            value: text

            fn enter() -> text:
                self.value

            fn cleanup():
                ()

        val ctx = ValueContext(value: "hello")

        with ctx as val_:
            check val_ == "hello"

    it "supports with statement without variable binding":
        enter_called_cw = false
        cleanup_called_cw2 = false

        class NoBindContext:
            fn enter() -> NoBindContext:
                enter_called_cw = true
                self

            fn cleanup():
                cleanup_called_cw2 = true

        val ctx = NoBindContext()

        with ctx:
            check enter_called_cw

        check cleanup_called_cw2
