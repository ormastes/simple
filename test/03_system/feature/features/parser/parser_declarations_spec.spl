            # @req REQ-PARSER-DECL-031
            step("Construct or compile the fixture and inspect the parsed/compiled result")
            # @capture: evidence_manifest("parser_decl_031") -> parser_declarations_spec.evidence.sdn
            let x = 42
            expect(x).to_equal(42)  # oracle: 42 — pinned expected value for this behavior

        it "parses let with destructuring":
            # @req REQ-PARSER-DECL-032
            step("Construct or compile the fixture and inspect the parsed/compiled result")
            # @capture: evidence_manifest("parser_decl_032") -> parser_declarations_spec.evidence.sdn
            let (a, b) = (1, 2)
