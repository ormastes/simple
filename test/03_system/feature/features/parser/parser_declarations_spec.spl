        it "parses var with type annotation":
            # @req REQ-PARSER-DECL-030
            step("Construct or compile the fixture and inspect the parsed/compiled result")
            # @capture: evidence_manifest("parser_decl_030") -> parser_declarations_spec.evidence.sdn
            var x: i64 = 0
            x = 42
            expect(x).to_equal(42)  # oracle: 42 — pinned expected value for this behavior

    context "let bindings":
