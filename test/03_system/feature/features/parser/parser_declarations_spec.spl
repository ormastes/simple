describe "Import Declaration Parsing":
    it "parses simple import":
        # @req REQ-PARSER-DECL-021
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_021") -> parser_declarations_spec.evidence.sdn
        expect(parser_declaration_source_status("use_simple", "use std.spec")).to_equal("pass")

    it "parses specific import":
        # @req REQ-PARSER-DECL-022
        # NOTE: genuinely RED on this host (2026-09-06, line 356) — the seed
        # compiler this fixture shells out to cannot compile the fixture to
        # standalone SMF ("28 function(s) contain constructs that require the
        # interpreter", e.g. TryOperator/CollectionOps in file_ops.spl), so
        # `parser_declaration_source_status` never reaches "pass". This is a
        # seed-compile-environment limitation, not a parser defect in the
        # `use std.spec.{expect}` grammar itself. Same root cause as the
        # sibling failure below ("parses multiple imports").
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_022") -> parser_declarations_spec.evidence.sdn
        expect(parser_declaration_source_status("use_specific", "use std.spec." + "{" + "expect" + "}")).to_equal("pass")

    it "parses multiple imports":
        # @req REQ-PARSER-DECL-023
        # NOTE: genuinely RED on this host (2026-09-06) — same seed-compile
        # environment limitation as "parses specific import" above
        # (parser_declarations_spec.spl:22): the fixture cannot be compiled to
        # standalone SMF by the seed compiler this helper shells out to.
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_023") -> parser_declarations_spec.evidence.sdn
        expect(parser_declaration_source_status("use_multiple", "use std.spec." + "{" + "describe, expect" + "}")).to_equal("pass")


describe "Type Alias Declaration Parsing":
    it "parses simple type alias":
        # @req REQ-PARSER-DECL-024
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_024") -> parser_declarations_spec.evidence.sdn
        val boxed = ParserDeclIntBox.create(11)
        expect(boxed.value).to_equal(11)  # oracle: 11 — pinned expected value for this behavior

    it "parses generic type alias":
        # @req REQ-PARSER-DECL-025
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_025") -> parser_declarations_spec.evidence.sdn
        val aliased = ParserDeclBox<text>.create("typed")
        expect(aliased.value).to_equal("typed")

    it "parses complex type alias":
        # @req REQ-PARSER-DECL-026
        step("Construct or compile the fixture and inspect the parsed/compiled result")
        # @capture: evidence_manifest("parser_decl_026") -> parser_declarations_spec.evidence.sdn
        val pair = ParserDeclTextPoint(key: "origin", value: ParserDeclPoint(x: 0, y: 0))
        expect(pair.value.sum()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior


