            val x = 42
            expect(x + 0).to_equal(42)  # oracle: 42 — pinned expected value for this behavior

        it "parses val with type annotation":
            # @req REQ-PARSER-DECL-028
            step("Construct or compile the fixture and inspect the parsed/compiled result")
            # @capture: evidence_manifest("parser_decl_028") -> parser_declarations_spec.evidence.sdn
            val x: i64 = 42
            expect(x).to_equal(42)  # oracle: 42 — pinned expected value for this behavior

    context "mutable variables":
        it "parses var declaration":
            # @req REQ-PARSER-DECL-029
            step("Construct or compile the fixture and inspect the parsed/compiled result")
            # @capture: evidence_manifest("parser_decl_029") -> parser_declarations_spec.evidence.sdn
