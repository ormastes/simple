# @cover src/compiler/35.semantics/macro_check/hygiene.spl 80%
"""
## Purpose and audience
Purpose: prevents variable capture from outer scope
Audience: compiler and tooling engineers who maintain this spec

Macro hygiene specification.

Tests that macro-generated variables are properly isolated through
gensym renaming, preventing unintended variable capture from outer scopes.
"""

# @req: REQ-FEATURE-MacrHygi-001

# ============================================================================
# Module-level macro definitions
# ============================================================================

macro hyg_make_ten() -> (returns result: Int):
    emit result:
        let x = 10
        x

macro hyg_increment() -> (returns result: Int):
    emit result:
        let temp = 1
        temp

macro hyg_shadow_test() -> (returns result: Int):
    emit result:
        let x = 10
        let x = x + 5
        let x = x * 2
        x

macro hyg_multi_vars() -> (returns result: Int):
    emit result:
        let a = 1
        let b = 2
        let c = 3
        a + b + c

macro hyg_inner() -> (returns result: Int):
    emit result:
        let x = 5
        x

macro hyg_outer() -> (returns result: Int):
    emit result:
        let x = 10
        x + hyg_inner!()

macro hyg_make_pair() -> (returns result: Int):
    emit result:
        let (x, y) = (10, 20)
        x + y

macro hyg_swap_values() -> (returns result: Int):
    emit result:
        let (a, b) = (5, 10)
        b - a

macro hyg_complex() -> (returns result: Int):
    emit result:
        let temp = 1
        let sum1 = if true: 2 else: 0
        let sum2 = if true: 3 else: 0
        let sum3 = if true: 4 else: 0
        sum1 + sum2 + sum3 + temp

# ============================================================================
# Tests
# ============================================================================

use std.spec.step
describe "Macro Hygiene":
    """
    Tests macro hygiene ensuring variables defined in macros are isolated
    from the surrounding scope through automatic gensym renaming.
    """

    it "prevents variable capture from outer scope":
        step("Verify: prevents variable capture from outer scope")
        # @req: REQ-FEATURE-MacrHygi-001
        let x = 5
        val result = hyg_make_ten!()
        # Should be 5 + 10 = 15, not 10 + 10 = 20
        expect(x + result).to_equal(15)  # oracle: value fixed by the spec contract

    it "generates unique names for repeated expansions":
        step("Verify: generates unique names for repeated expansions")
        # @req: REQ-FEATURE-MacrHygi-001
        val a = hyg_increment!()
        val b = hyg_increment!()
        expect(a + b).to_equal(2)  # oracle: value fixed by the spec contract

    it "allows explicit shadowing with different values":
        step("Verify: allows explicit shadowing with different values")
        # @req: REQ-FEATURE-MacrHygi-001
        val result = hyg_shadow_test!()
        # ((10 + 5) * 2) = 30
        expect(result).to_equal(30)  # oracle: value fixed by the spec contract

    it "isolates macro-generated variables":
        step("Verify: isolates macro-generated variables")
        # @req: REQ-FEATURE-MacrHygi-001
        let x = 10
        let y = 20
        let z = 30
        val result = hyg_multi_vars!()
        # 10 + 20 + 30 + 6 = 66
        expect(x + y + z + result).to_equal(66)  # oracle: value fixed by the spec contract

    it "maintains hygiene with nested macro calls":
        step("Verify: maintains hygiene with nested macro calls")
        # @req: REQ-FEATURE-MacrHygi-001
        val result = hyg_outer!()
        # Should be 10 + 5 = 15
        expect(result).to_equal(15)  # oracle: value fixed by the spec contract

    it "isolates pattern matching variables":
        step("Verify: isolates pattern matching variables")
        # @req: REQ-FEATURE-MacrHygi-001
        let x = 100
        let y = 200
        val result = hyg_make_pair!()
        # 100 + 200 + 30 = 330
        expect(x + y + result).to_equal(330)  # oracle: value fixed by the spec contract

    it "isolates tuple destructuring":
        step("Verify: isolates tuple destructuring")
        # @req: REQ-FEATURE-MacrHygi-001
        let a = 1
        let b = 2
        val result = hyg_swap_values!()
        # 1 + 2 + 5 = 8
        expect(a + b + result).to_equal(8)  # oracle: value fixed by the spec contract

    it "handles complex macro with multiple scopes":
        step("Verify: handles complex macro with multiple scopes")
        # @req: REQ-FEATURE-MacrHygi-001
        let x = 100
        let y = 200
        let z = 300
        val result = hyg_complex!()
        expect(result).to_equal(10)  # oracle: value fixed by the spec contract
