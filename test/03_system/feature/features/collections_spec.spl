    it "iterates dictionary values":
        step("Verify: iterates dictionary values")
        # @req: REQ-FEATURE-Coll-001
        val dict = {"a": 10, "b": 20, "c": 30}
        var sum = 0
        for value in dict.values():
            sum = sum + value
        expect(sum).to_equal(60)  # oracle: value fixed by the spec contract


