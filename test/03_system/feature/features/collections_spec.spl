    it "creates set from array":
        step("Verify: creates set from array")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 2, 1]
        val unique_count = arr.len()
        # Note: set operations may vary
        expect(unique_count).to_equal(5)  # oracle: value fixed by the spec contract

    it "checks set membership":
        step("Verify: checks set membership")
        # @req: REQ-FEATURE-Coll-001
        val items = [1, 2, 3, 4, 5]
        var found = false
        for item in items:
            if item == 3: found = true
        expect(found).to_equal(true)


