describe "Array Ordering":
    """
    ## Array Ordering

    Tests sorting and ordering operations.
    """

    it "sorts numeric array":
        step("Verify: sorts numeric array")
        # @req: REQ-FEATURE-Coll-001
        val arr = [3, 1, 4, 1, 5, 9]
        val sorted = arr.sorted()
        expect(sorted).to_equal([1, 1, 3, 4, 5, 9])

    it "reverses array":
        step("Verify: reverses array")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        val reversed = arr.reversed()
        expect(reversed).to_equal([5, 4, 3, 2, 1])


