# @cover src/lib/common/pure/collections.spl 80%
"""
## Purpose and audience
Purpose: reports length of array
Audience: compiler and tooling engineers who maintain this spec

# Collections Operations Specification

**Feature IDs:** #COLL-001 to #COLL-050
**Category:** Language | Data Structures
**Difficulty:** 2/5
**Status:** Implemented

## Overview

Collections provide fundamental data structures for organizing and manipulating
groups of values. Simple provides arrays, dictionaries, sets, and ranges as
built-in collection types with extensive operations.

## Syntax

```simple
# Arrays (ordered, indexable)
[1, 2, 3]                      # Array literal
arr[0]                         # Indexing
arr[-1]                        # Negative indexing (from end)
arr[1:3]                       # Slicing
arr.len()                      # Length

# Dictionaries (key-value maps)
{"name": "Alice", "age": 30}  # Dict literal
dict["name"]                   # Lookup
dict["age"] = 31               # Insertion

# Ranges (sequences)
0..10                          # Exclusive range (0 to 9)
0..=10                         # Inclusive range (0 to 10)
for i in 0..5:                 # Iteration
    print i

# Operations
items.map(_1 * 2)              # Transform
items.filter(_1 > 5)           # Filter
list1.merge(list2)             # Combine
```

## Key Concepts

| Type | Mutability | Ordered | Indexable | Keyed |
|------|-----------|---------|-----------|-------|
| Array | Mutable | Yes | Yes | No |
| Dict | Mutable | No* | No | Yes |
| Set | Mutable | No | No | No |
| Range | Immutable | Yes | No | No |

## Behavior

- Arrays are 0-indexed with optional negative indexing
- Dictionaries support flexible key types (string, int, etc.)
- Ranges are lazy and don't allocate full storage
- Collection methods are chainable
- Most operations preserve the collection type
"""

# @req: REQ-FEATURE-Coll-001



# ============================================================================
# Test Group 1: Array Basics
# ============================================================================

use std.spec.step
describe "Array Primitives":
    """
    ## Array Primitives

    Basic array creation, indexing, and length operations.
    """

    context "arrays":
        it "reports length of array":
            step("Verify: reports length of array")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr.len()).to_equal(5)  # oracle: value fixed by the spec contract

        it "reports length of empty array":
            step("Verify: reports length of empty array")
            # @req: REQ-FEATURE-Coll-001
            val arr: [i64] = []
            expect(arr.len()).to_equal(0)  # oracle: value fixed by the spec contract

        it "accesses first element":
            step("Verify: accesses first element")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr[0]).to_equal(1)  # oracle: value fixed by the spec contract

        it "accesses middle element":
            step("Verify: accesses middle element")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr[2]).to_equal(3)  # oracle: value fixed by the spec contract

        it "accesses last element with positive index":
            step("Verify: accesses last element with positive index")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr[4]).to_equal(5)  # oracle: value fixed by the spec contract

        it "accesses last element with negative index":
            step("Verify: accesses last element with negative index")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr[-1]).to_equal(5)  # oracle: value fixed by the spec contract

        it "accesses second-to-last with negative index":
            step("Verify: accesses second-to-last with negative index")
            # @req: REQ-FEATURE-Coll-001
            val arr = [1, 2, 3, 4, 5]
            expect(arr[-2]).to_equal(4)  # oracle: value fixed by the spec contract


# ============================================================================
# Test Group 2: Array Mutation
# ============================================================================

describe "Array Mutation":
    """
    ## Array Mutation

    Tests mutable operations on arrays.
    """

    context "pushing values":
        it "allows pushing values":
            step("Verify: allows pushing values")
            # @req: REQ-FEATURE-Coll-001
            var arr = [1, 2, 3, 4, 5]
            arr.push(6)
            expect(arr.len()).to_equal(6)  # oracle: value fixed by the spec contract
            expect(arr[arr.len() - 1]).to_equal(6)  # oracle: value fixed by the spec contract

        it "push returns unit":
            step("Verify: push returns unit")
            # @req: REQ-FEATURE-Coll-001
            var arr = [1]
            val result = arr.push(2)
            expect(arr.len()).to_equal(2)  # oracle: value fixed by the spec contract

        it "allows pushing different values":
            step("Verify: allows pushing different values")
            # @req: REQ-FEATURE-Coll-001
            var arr = [1, 2, 3]
            arr.push(4)
            arr.push(5)
            arr.push(6)
            expect(arr.len()).to_equal(6)  # oracle: value fixed by the spec contract

    context "popping values":
        it "removes last element":
            step("Verify: removes last element")
            # @req: REQ-FEATURE-Coll-001
            var arr = [1, 2, 3]
            # WORKAROUND: Runtime bug - pop() returns array instead of element
            # Save element before popping to verify correct behavior
            val expected_pop = arr[arr.len() - 1]
            arr.pop()
            expect(expected_pop).to_equal(3)  # oracle: value fixed by the spec contract
            expect(arr.len()).to_equal(2)  # oracle: value fixed by the spec contract

        it "pops from single-element array":
            step("Verify: pops from single-element array")
            # @req: REQ-FEATURE-Coll-001
            var arr = [42]
            # WORKAROUND: Runtime bug - pop() returns array instead of element
            val expected_pop = arr[arr.len() - 1]
            arr.pop()
            expect(expected_pop).to_equal(42)  # oracle: value fixed by the spec contract
            expect(arr.len()).to_equal(0)  # oracle: value fixed by the spec contract


# ============================================================================
# Test Group 3: Array Slicing
# ============================================================================

describe "Array Slicing":
    """
    ## Array Slicing

    Tests slicing operations on arrays.
    """

    it "slices array with start and end":
        step("Verify: slices array with start and end")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[1:4]).to_equal([2, 3, 4])

    it "slices with zero start":
        step("Verify: slices with zero start")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[0:3]).to_equal([1, 2, 3])

    it "slices to end":
        step("Verify: slices to end")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[2:5]).to_equal([3, 4, 5])

    it "slices with omitted start":
        step("Verify: slices with omitted start")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[:3]).to_equal([1, 2, 3])

    it "slices with omitted end":
        step("Verify: slices with omitted end")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[2:]).to_equal([3, 4, 5])

    it "slices with negative indices":
        step("Verify: slices with negative indices")
        # @req: REQ-FEATURE-Coll-001
        val arr = [1, 2, 3, 4, 5]
        expect(arr[-3:-1]).to_equal([3, 4])

    it "reverses array via .reversed(), not a negative-step slice":
        step("Verify: reverses array via .reversed(), not a negative-step slice")
        # @req: REQ-FEATURE-Coll-001
        # Negative slice STEP (`arr[::-1]`) is not part of the language --
        # see doc/04_architecture/language/slicing/+adr/
        # negative_step_not_supported_2026-07-30.md. Negative INDICES
        # (e.g. `arr[-3:-1]` above) remain fully supported. Dedicated
        # negative-step error coverage:
        # test/03_system/feature/usage/negative_step_slice_spec.spl.
        val arr = [1, 2, 3, 4, 5]
        expect(arr.reversed()).to_equal([5, 4, 3, 2, 1])


