    it "merges non-empty with empty":
        step("Verify: merges non-empty with empty")
        # @req: REQ-FEATURE-Coll-001
        val arr1 = [1, 2]
        val arr2: [i64] = []
        expect(arr1.merge(arr2)).to_equal([1, 2])


# ============================================================================
# Test Group 8: Range Operations
# ============================================================================

describe "Range Operations":
    """
    ## Range Operations

    Tests range creation and iteration.
    """

    it "iterates exclusive range":
        step("Verify: iterates exclusive range")
        # @req: REQ-FEATURE-Coll-001
        var sum = 0
        for i in 0..5:
            sum = sum + i
        expect(sum).to_equal(10)  # 0+1+2+3+4

    it "iterates inclusive range":
        step("Verify: iterates inclusive range")
        # @req: REQ-FEATURE-Coll-001
        var sum = 0
        for i in 0..=5:
            sum = sum + i
        expect(sum).to_equal(15)  # 0+1+2+3+4+5

    it "handles single-element range":
        step("Verify: handles single-element range")
        # @req: REQ-FEATURE-Coll-001
        var count = 0
        for _ in 5..6:
            count = count + 1
        expect(count).to_equal(1)  # oracle: value fixed by the spec contract

    it "handles empty range":
        step("Verify: handles empty range")
        # @req: REQ-FEATURE-Coll-001
        var count = 0
        for _ in 5..5:
            count = count + 1
        expect(count).to_equal(0)  # oracle: value fixed by the spec contract


