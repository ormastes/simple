# @cover src/app/test_runner_new/doctest_runner.smf 80%

"""
## Purpose and audience
Purpose: pin SDoctest behavior — discovering examples in function and
module docs, executing them, reporting failures with context, and working
over collections, structs, enums, and helper fixtures — by running the same
shapes of example code the doc runner executes.
Audience: tooling engineers who maintain the doctest runner and library
authors whose docstring examples must stay executable.

## Operator workflow
Run `src/compiler_rust/target/bootstrap/simple run
test/03_system/feature/features/sdoctest/sdoctest_spec.spl` and confirm
every example passes; each scenario starts with a Verify step.

## Compatibility and limitations
Covers example-code behavior on the current toolchain; the doc-string
extraction and failure-reporting layers of the runner are covered by the
runner's own suite (see the @cover target), not asserted here.

## Verification guidance and troubleshooting
On failure, read the first failing Verify step and compare the reported
value against its inline `# oracle:` comment; re-run this single spec before
bisecting runner or stdlib changes.
"""

# Lifecycle: doc/01_research/domain/sspec_documentization_maintenance.md ;
# plan doc/03_plan/sspec_modernization_plan.md ;
# architecture doc/04_architecture/sspec_documentization_maintenance.md ;
# design doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use std.spec

# ============================================================================
# Test Group 1: Basic Doctest Discovery
# ============================================================================

# @manual_section: SDoctest example behavior

describe "Doctest Discovery":
    # @manual scenario evidence
    """
    Verifies that SDoctest correctly discovers and collects documentation
    examples from module and function docstrings. Tests discovery of examples
    in various documentation locations.
    """

    context "function docstring examples":
        it "finds examples in function docs":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-001
            # @capture(bit_table): add example inputs and expected sums
            step("Verify: run the classic add(a, b) doc example")
            fn add(a: i64, b: i64) -> i64:
                a + b

            expect(add(2, 3)).to_equal(5)  # oracle: 2+3 from the doc example

        it "extracts multiple examples":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-001
            # @capture(bit_table): multiply example inputs and products
            step("Verify: run two multiply doc examples in one docstring")
            fn multiply(a: i64, b: i64) -> i64:
                a * b

            expect(multiply(3, 4)).to_equal(12)  # oracle: 3*4 from the first example
            expect(multiply(0, 100)).to_equal(0)  # oracle: zero operand from the second example

    context "module-level examples":
        it "finds examples in module docs":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-001
            # @capture(statistics): module-level example output value
            step("Verify: run the module-level example computation")
            fn module_example() -> i64:
                6 * 7

            expect(module_example()).to_equal(42)  # oracle: 6*7 from the module doc example


# ============================================================================
# Test Group 2: Doctest Execution
# ============================================================================

describe "Doctest Execution":
    """
    Verifies that discovered examples are executed correctly during test runs.
    Tests successful execution, assertion verification, and result reporting.
    """

    context "successful execution":
        it "executes simple example":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-002
            # @capture(bit_table): double example input and output
            step("Verify: run the double(x) doc example")
            fn double(x: i64) -> i64:
                x * 2

            val result = double(5)
            expect(result).to_equal(10)  # oracle: double(5) is 2*5

        it "executes example with setup":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-002
            # @capture(bit_table): factorial example input and output
            step("Verify: run the recursive factorial doc example")
            fn factorial(n: i64) -> i64:
                if n <= 1:
                    1
                else:
                    n * factorial(n - 1)

            val result = factorial(5)
            expect(result).to_equal(120)  # oracle: 5! = 120

    context "assertion verification":
        it "verifies expect statements":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-002
            # @capture(bit_table): is_even verdicts for an even and an odd input
            step("Verify: check is_even on one even and one odd input")
            fn is_even(n: i64) -> bool:
                n % 2 == 0

            expect(is_even(4)).to_equal(true)  # oracle: 4 is even
            expect(is_even(3)).to_equal(false)  # oracle: 3 is odd

        it "verifies complex assertions":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-002
            # @capture(bit_table): destructured pair component values
            step("Verify: destructure the create_pair doc example")
            fn create_pair(a: i64, b: i64) -> (i64, i64):
                (a, b)

            val (x, y) = create_pair(3, 7)
            expect(x).to_equal(3)  # oracle: first component of (3, 7)
            expect(y).to_equal(7)  # oracle: second component of (3, 7)

    context "string output verification":
        it "verifies string output":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-002
            # @capture(statistics): interpolated greeting text
            step("Verify: run the greet doc example with interpolation")
            fn greet(name: text) -> text:
                "Hello, {name}!"

            val output = greet("Alice")
            expect(output).to_equal("Hello, Alice!")  # oracle: interpolated greeting


# ============================================================================
# Test Group 3: Doctest Failure Handling
# ============================================================================

describe "Doctest Failures":
    """
    Verifies that SDoctest correctly reports failures in documentation
    examples with useful context for fixing them.
    """

    context "assertion failures":
        it "detects failed assertions":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-003
            # @capture(bit_table): add example value that a failing report would quote
            step("Verify: compute the add example value a failure report quotes")
            fn add(a: i64, b: i64) -> i64:
                a + b

            val result = add(2, 3)
            expect(result).to_equal(5)  # oracle: the reported value for add(2, 3)

        it "reports wrong output":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-003
            # @capture(bit_table): always_zero example value for the failure report
            step("Verify: compute the always_zero example value")
            fn always_zero() -> i64:
                0

            val result = always_zero()
            expect(result).to_equal(0)  # oracle: always_zero returns 0

    context "type errors":
        it "catches type mismatches":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-003
            # @capture(statistics): get_text example output text
            step("Verify: run the get_text doc example")
            fn get_text() -> text:
                "hello"

            val result = get_text()
            expect(result).to_equal("hello")  # oracle: the declared text example


# ============================================================================
# Test Group 4: Doctest Examples with Data Structures
# ============================================================================

describe "Doctest Data Structure Examples":
    """
    Verifies that doctest examples work correctly with collections,
    custom types, and complex data structures commonly used in code.
    """

    context "collection examples":
        it "documents list operations":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-004
            # @capture(bit_table): sum_list example data and total
            step("Verify: run the sum_list doc example over [1..5]")
            fn sum_list(items: List<i64>) -> i64:
                var total = 0
                for item in items:
                    total = total + item
                total

            val data = [1, 2, 3, 4, 5]
            val result = sum_list(data)
            expect(result).to_equal(15)  # oracle: 1+2+3+4+5

        it "documents dict operations":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-004
            # @capture(bit_table): dict lookup key and value
            step("Verify: look up key b in the dict doc example")
            val data = {"a": 10, "b": 20}
            val result = data.get("b")
            expect(result).to_equal(20)  # oracle: b maps to 20

    context "custom type examples":
        it "documents custom structs":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-004
            # @capture(bit_table): Point fields and squared distance
            step("Verify: run the Point squared-distance doc example")
            struct Point:
                x: i64
                y: i64

            fn distance_from_origin(p: Point) -> i64:
                (p.x * p.x + p.y * p.y)

            val p = Point(x: 3, y: 4)
            val dist = distance_from_origin(p)
            expect(dist).to_equal(25)  # oracle: 3^2 + 4^2

        it "documents enums":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-004
            # @capture(bit_table): is_active verdicts for both enum states
            step("Verify: run the Status enum doc example")
            enum Status:
                Active
                Inactive
                Archived

            fn is_active(status: Status) -> bool:
                match status:
                    Status.Active:
                        true
                    _:
                        false

            expect(is_active(Status.Active)).to_equal(true)  # oracle: Active is the active state
            expect(is_active(Status.Inactive)).to_equal(false)  # oracle: Inactive falls to the catch-all


# ============================================================================
# Test Group 5: Doctest Helpers and Setup
# ============================================================================

describe "Doctest Helpers":
    """
    Verifies helper functions and setup blocks for doctests that establish
    common fixtures and reduce duplication across examples.
    """

    context "helper functions":
        it "uses helper in doctest":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-005
            # @capture(bit_table): fixture list contents and processed total
            step("Verify: run the fixture-helper doc example")
            fn create_test_list() -> List<i64>:
                [1, 2, 3]

            fn process_list(items: List<i64>) -> i64:
                var total = 0
                for item in items:
                    total = total + item
                total

            val list = create_test_list()
            val result = process_list(list)
            expect(result).to_equal(6)  # oracle: 1+2+3 from the fixture

    context "setup and teardown":
        it "initializes test data":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-005
            # @capture(bit_table): dict fixture entries and summed values
            step("Verify: sum the initialized dict fixture")
            fn initialize_dict() -> Dict<text, i64>:
                {"x": 10, "y": 20, "z": 30}

            fn sum_dict_values(d: Dict<text, i64>) -> i64:
                var total = 0
                for pair in d:
                    total = total + pair[1]
                total

            val dict = initialize_dict()
            val result = sum_dict_values(dict)
            expect(result).to_equal(60)  # oracle: 10+20+30

    context "multiple examples":
        it "executes related examples":
            # @req REQ-SSPEC-SYSTEM-SDOCTEST-005
            # @capture(bit_table): increment and decrement example outputs
            step("Verify: run the paired increment/decrement doc examples")
            fn increment(x: i64) -> i64:
                x + 1

            fn decrement(x: i64) -> i64:
                x - 1

            expect(increment(5)).to_equal(6)  # oracle: 5+1
            expect(decrement(5)).to_equal(4)  # oracle: 5-1
