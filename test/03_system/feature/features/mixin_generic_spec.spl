# @cover src/compiler/25.traits/traits.spl 60%
"""
# Generic Mixins with Type Parameters

**Feature IDs:** #TBD
**Category:** Language
**Difficulty:** 4/5
**Status:** Planned (generic mixins not yet runtime-implemented)

## Overview

Support generic type parameters in mixins for reusable generic behavior.
Generic mixins allow parameterized field types and method signatures.

## Syntax (Planned)

```simple
mixin Container<T>:
    items: [T]

    fn add(item: T):
        self.items.push(item)
```
"""

use std.spec.step

describe "Generic Mixins":
    """
    ## Generic Mixin Support

    Tests generic mixin support with type parameters. These features
    are planned but not yet runtime-implemented.
    """

    mixin Box<T>:
        value: T

        fn get() -> T:
            return self.value

    context "Mixin with single type parameter":
        it "declares generic mixin Box<T> and returns its typed field":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: Box<i64>.get returns the stored i64")
            class IntBox:
                use Box<i64>
            val b = IntBox(value: 41)
            expect b.get() == 41

        it "applies to class with a different concrete type":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: Box<text>.get returns the stored text")
            class NameBox:
                use Box<text>
            val n = NameBox(value: "ada")
            expect n.get() == "ada"

    context "Mixin with multiple type parameters":
        it "mixin with two type parameters carries both fields":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: Pair<i64, text> holds and returns both")
            mixin Pair<A, B>:
                left: A
                right: B

                fn left_value() -> A:
                    return self.left
            class Tagged:
                use Pair<i64, text>
            val t = Tagged(left: 7, right: "seven")
            expect t.left_value() == 7
            expect t.right == "seven"

        it "type parameters resolve per application site":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: same mixin instantiated at two types stays distinct")
            class OtherTagged:
                use Pair<text, i64>
            val o = OtherTagged(left: "key", right: 3)
            expect o.left == "key"
            expect o.right == 3

    context "Generic mixin methods":
        it "generic mixin methods compute over the typed field":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: Box<i64> method result derives from stored value")
            class CountBox:
                use Box<i64>
            val c = CountBox(value: 20)
            expect c.get() + 1 == 21

        it "return type matches the applied parameter":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: Box<text> method returns text equality")
            class WordBox:
                use Box<text>
            val w = WordBox(value: "mix")
            expect w.get() == "mix"

    context "Constraints on generic mixins":
        it "instantiated mixin composes with class-owned methods":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: class method and mixin method coexist on one object")
            class Shelf:
                use Box<i64>
                fn describe() -> text:
                    return "shelf"
            val sh = Shelf(value: 5)
            expect sh.get() == 5
            expect sh.describe() == "shelf"

        it "constraint-checked application stays executable":
            # @req: REQ-FEATURE-MIXIN-GENERIC-001
            step("Verify: nested generic use inside another class still runs")
            class Outer:
                use Box<i64>
                fn total() -> i64:
                    return self.get() * 2
            val out = Outer(value: 6)
            expect out.total() == 12
