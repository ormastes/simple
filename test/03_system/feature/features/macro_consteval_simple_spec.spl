# @cover src/compiler/35.semantics/const_eval.spl 80%
"""
## Purpose and audience
Purpose: evaluates expressions
Audience: compiler and tooling engineers who maintain this spec

Simplified const-eval engine specification.

Tests basic compile-time evaluation scenarios including arithmetic operations,
conditional expressions, loop evaluation, and string template processing.
"""

# @req: REQ-FEATURE-MacrConsSimp-001

# ============================================================================
# Module-level macro definitions
# ============================================================================

# Arithmetic macros
macro simple_add(a: Int, b: Int) -> (returns result: Int):
    emit result:
        a + b

macro simple_mul(a: Int, b: Int) -> (returns result: Int):
    emit result:
        a * b

# Conditional macros
macro simple_max(a: Int, b: Int) -> (returns result: Int):
    emit result:
        if a > b:
            return a
        else:
            return b

macro simple_min(a: Int, b: Int) -> (returns result: Int):
    emit result:
        if a < b:
            return a
        else:
            return b

# Loop macros
macro simple_sum_range(n: Int const) -> (returns result: Int):
    emit result:
        var sum = 0
        for i in 0..n:
            sum = sum + i
        sum

macro simple_gen_indexed(N: Int const) -> (
    intro funcs:
        for i in 0..N:
            enclosing.module.fn "simple_idx_{i}"() -> Int
):
    emit funcs:
        for i in 0..N:
            fn "simple_idx_{i}"() -> Int:
                return i

# String template macros
macro simple_make_getter(name: Str const) -> (
    intro getter: enclosing.module.fn "simple_get_{name}"() -> Int
):
    emit getter:
        fn "simple_get_{name}"() -> Int:
            return 42

# ============================================================================
# Invoke macros that generate functions at module level
# ============================================================================
simple_gen_indexed!(2)
simple_make_getter!("test")

# ============================================================================
# Tests
# ============================================================================

use std.spec.step
describe "Const-Eval Engine":
    """
    Tests the simplified const-eval engine covering arithmetic operations,
    conditional evaluation, loop iteration, and string concatenation.
    """

    describe "Arithmetic":
        it "evaluates expressions":
            step("Verify: evaluates expressions")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_add!(20, 22)).to_equal(42)  # oracle: value fixed by the spec contract

        it "evaluates multiplication":
            step("Verify: evaluates multiplication")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_mul!(6, 7)).to_equal(42)  # oracle: value fixed by the spec contract

    describe "Conditionals":
        it "evaluates max":
            step("Verify: evaluates max")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_max!(10, 50)).to_equal(50)  # oracle: value fixed by the spec contract
            expect(simple_max!(100, 5)).to_equal(100)  # oracle: value fixed by the spec contract

        it "evaluates min":
            step("Verify: evaluates min")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_min!(10, 50)).to_equal(10)  # oracle: value fixed by the spec contract

    describe "Loops":
        it "sums ranges":
            step("Verify: sums ranges")
            # @req: REQ-FEATURE-MacrConsSimp-001
            # 0 + 1 + 2 + 3 = 6
            expect(simple_sum_range!(4)).to_equal(6)  # oracle: value fixed by the spec contract

        it "generates indexed functions":
            step("Verify: generates indexed functions")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_idx_0() + simple_idx_1()).to_equal(1)  # oracle: value fixed by the spec contract

    describe "Strings":
        it "concatenates in template":
            step("Verify: concatenates in template")
            # @req: REQ-FEATURE-MacrConsSimp-001
            expect(simple_get_test()).to_equal(42)  # oracle: value fixed by the spec contract
