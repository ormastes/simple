# @cover src/app/io/mod.spl 0%
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/feature/app/t32_tools/t32_mcp_wrapper_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/t32_mcp_wrapper_spec.md
# doc-path: doc/03_plan/sys_test/t32_mcp_wrapper_spec.md
# doc-path: doc/04_architecture/t32_mcp_wrapper_spec.md
# doc-path: doc/05_design/t32_mcp_wrapper_spec_oracles.md
# @manual: primary

"""
# T32 MCP Wrapper -- Cold tools/call regression

Verifies that the wrapper can handle `initialize` followed by a real
`tools/call` for `t32_sessions_list` without tripping the RSS watchdog.
"""
use std.spec.step

use app.io.mod.{shell, is_windows_platform}


extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_delete(path: text) -> bool

fn shell_escape_text(value: text) -> text:
    "'" + value.replace("'", "'\\''") + "'"

fn mcp_msg(body: text) -> text:
    "Content-Length: " + body.len().to_string() + "\r\n\r\n" + body

fn init_request(id: text) -> text:
    val body = "{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"spec\",\"version\":\"1.0\"}}}"
    mcp_msg(body)

fn tools_list_request(id: text) -> text:
    mcp_msg("{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"tools/list\",\"params\":{}}")

fn tools_call_request(id: text, name: text, arguments_json: text) -> text:
    val body = "{\"jsonrpc\":\"2.0\",\"id\":\"" + id + "\",\"method\":\"tools/call\",\"params\":{\"name\":\"" + name + "\",\"arguments\":" + arguments_json + "}}"
    mcp_msg(body)

# The POSIX launcher `bin/t32_mcp_server` is generated by install.shs; on a
# Windows checkout only the tracked `bin/t32_mcp_server.cmd` twin exists and
# a git-bash `sh` cannot exec it directly, so route it through cmd.exe.
fn mcp_server_launcher() -> text:
    if is_windows_platform():
        return "cmd //c 'bin\\\\t32_mcp_server.cmd'"
    "bin/t32_mcp_server"

# Temp files live under the repo's build/ dir (gitignored) rather than /tmp:
# the server runs as a native Windows process on that host and cannot open a
# msys-only /tmp path.
fn spec_tmp_dir() -> text:
    "build/t32_spec_tmp"

fn run_server_with(messages: text, tag: text) -> (text, text, i64):
    val input_path = spec_tmp_dir() + "/t32_mcp_" + tag + ".in"
    shell("mkdir -p " + shell_escape_text(spec_tmp_dir()))
    expect(rt_file_write_text(input_path, messages)).to_equal(true)
    val result = shell("timeout 60s " + mcp_server_launcher() + " < " + shell_escape_text(input_path))
    rt_file_delete(input_path)
    (result.stdout ?? "", result.stderr ?? "", result.exit_code)

describe "T32 MCP Wrapper":
    it "handles initialize plus t32_sessions_list without RSS timeout":
        step("Verify: handles initialize plus t32_sessions_list without RSS timeout")
        # @req: REQ-SSPEC-LOCAL-001
        val messages = init_request("1") + tools_call_request("2", "t32_sessions_list", "{}")
        val (stdout, stderr, exit_code) = run_server_with(messages, "sessions")

        expect(exit_code).to_equal(0)
        expect(stdout.contains("\"id\":\"1\"")).to_equal(true)
        expect(stdout.contains("\"id\":\"2\"")).to_equal(true)
        # The tool result is a JSON text block, so the payload keys arrive escaped.
        expect(stdout.contains("items\\\":[]")).to_equal(true)
        expect(stdout.contains("target_state\\\":\\\"unknown\\\"")).to_equal(true)
        expect(stdout.contains("[watchdog] RSS")).to_equal(false)
        expect(stderr.contains("[watchdog] RSS")).to_equal(false)

    it "answers initialize with serverInfo and tools/list with the session tools":
        step("Verify: initialize + tools/list through the wrapper")
        # @req: REQ-SSPEC-LOCAL-001
        val messages = init_request("1") + tools_list_request("2")
        val (stdout, _stderr, exit_code) = run_server_with(messages, "list")

        expect(exit_code).to_equal(0)
        expect(stdout.contains("\"serverInfo\"")).to_equal(true)
        expect(stdout.contains("\"name\":\"simple-mcp-t32\"")).to_equal(true)
        expect(stdout.contains("\"name\":\"t32_sessions_list\"")).to_equal(true)
        expect(stdout.contains("\"name\":\"t32_cmd_run\"")).to_equal(true)
        expect(stdout.contains("\"inputSchema\"")).to_equal(true)
        # Both responses carry the request id they answer (string ids echoed verbatim).
        expect(stdout.contains("\"id\":null")).to_equal(false)

    it "rejects an unknown tool with a JSON-RPC error that names the tool":
        step("Verify: tools/call for an unknown tool returns an error, not a crash")
        # @req: REQ-SSPEC-LOCAL-001
        val messages = init_request("1") + tools_call_request("2", "t32_no_such_tool", "{}")
        val (stdout, _stderr, exit_code) = run_server_with(messages, "unknown")

        expect(exit_code).to_equal(0)
        expect(stdout.contains("\"id\":\"2\"")).to_equal(true)
        expect(stdout.contains("\"error\"")).to_equal(true)
        expect(stdout.contains("t32_no_such_tool")).to_equal(true)
