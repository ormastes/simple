"""
## Purpose and audience
Purpose: pins BuildConfig defaults, LLVM/SMF backend selection, generated
entry-point IR, runtime-stub content, and build-pipeline path derivation for
native executable generation, asserting on values genuinely constructed by
the spec's local operations (unwrap, string concat, match) rather than a
literal compared against itself.
Audience: compiler backend engineers who maintain the native build pipeline
(LLVM and SMF backends) and its CLI flag/entry-point/runtime-stub codegen.

## Operator workflow
bin/simple test test/03_system/feature/app/native_exe_spec.spl

## Compatibility and limitations
Most scenarios model BuildConfig/codegen shapes with local fixtures rather
than invoking the real native-build pipeline end-to-end (that pipeline needs
llc/cc on the host); each fixture mirrors the real function's logic
(concatenation, replace(), match) so the check stays genuine.

## Verification guidance and troubleshooting
A failing scenario names the exact config field or generated IR/stub
fragment that diverged; compare against
doc/04_architecture/compiler/backend/LLVM_BACKEND_ARCHITECTURE.md.

# Native Executable Generation

**Category:** Application
**Status:** In Progress

## Overview

Tests the native executable generation pipeline from Simple source to platform
binary. Verifies that the compiler produces correct ELF/PE executables, handles
linking, and that generated binaries execute with expected behavior.
"""
# Lifecycle: doc/01_research/os/simpleos/simpleos_native_build_entry_closure.md ;
# doc/03_plan/compiler/backend/native_build_open_bugs_plan_2026-07-15.md ;
# doc/04_architecture/compiler/backend/LLVM_BACKEND_ARCHITECTURE.md ;
# doc/05_design/native_build_env_timeout.md
# @manual_section: BuildConfig, backend flags, entry-point IR, runtime stub

# # Native Executable Generation Specification
#
#
# **Feature IDs:** #5000
# **Category:** Infrastructure
# **Difficulty:** 4/5
# **Status:** In Progress
#
# ## Overview
#
# The native executable generation pipeline compiles Simple source files into
# standalone native binaries. It supports two backends:
# - **SMF pipeline**: Source -> SMF -> native via mold (existing)
# - **LLVM pipeline**: Source -> MIR -> LLVM IR -> .o -> native via linker
#
# ## Key Concepts
#
# | Concept | Description |
# |---------|-------------|
# | BuildConfig | Configuration for native builds (entry point, output, backend) |
# | LLVM Backend | Compiles via MIR -> LLVM IR -> object code -> linked binary |
# | SMF Backend | Compiles via SMF format -> native linking |
# | Entry Point | Generated LLVM IR that bridges OS entry to Simple main |
# | Runtime Stub | C stub providing __simple_runtime_init/shutdown + main |
#
# ## Behavior
#
# - BuildConfig.backend selects the compilation pipeline ("llvm" or nil/smf)
# - --backend=llvm CLI flag activates LLVM backend in handle_build_command
# - Entry point IR generates proper main() or _start() functions
# - Runtime stub compiles a C file with init/shutdown wrappers
# - Object files are placed in .build/ directory
#
# ## Implementation Notes
#
# - LLVM backend requires llc to be installed
# - Runtime stub requires cc (gcc/clang) for compilation
# - Entry point supports both hosted (main) and bare-metal (_start) modes

use compiler.backend.build_native_types.{BuildConfig}
use compiler.backend.backend.entry_point.{generate_entry_point_ir, generate_start_ir}
use std.io_runtime.{file_read}

# ============================================================================
# BuildConfig Tests
# ============================================================================

describe "BuildConfig":
    # @manual scenario evidence
    # ## BuildConfig Specification
    #
    # Verifies build configuration defaults and the backend field.

    context "default configuration":
        it "creates config with entry point and output":
            # @req REQ-NATIVE-EXE-001
            step("Ask the real BuildConfig.default() constructor to build a config")
            val cfg = BuildConfig.default("src/main.spl", "my_program")
            # @capture: evidence_manifest("native_exe_config_entry_output") -> native_exe_spec.evidence.sdn
            step("Verify the constructor stored the entry point and output it was given")
            expect(cfg.entry_point).to_equal("src/main.spl")
            expect(cfg.output).to_equal("my_program")

        it "defaults to nil backend (SMF pipeline)":
            # @req REQ-NATIVE-EXE-002
            step("Ask BuildConfig.default() to build a config with no backend specified")
            val cfg = BuildConfig.default("src/main.spl", "my_program")
            # @capture: evidence_manifest("native_exe_config_nil_backend") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor left backend unset")
            expect(cfg.backend).to_be_nil()

        it "defaults to PIE enabled":
            # @req REQ-NATIVE-EXE-003
            step("Ask BuildConfig.default() to build a config")
            val cfg = BuildConfig.default("src/main.spl", "my_program")
            # @capture: evidence_manifest("native_exe_config_pie_default") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor enabled PIE by default")
            assert_true(cfg.pie)

        it "defaults to optimization level 0":
            # @req REQ-NATIVE-EXE-004
            step("Ask BuildConfig.default() to build a config")
            val cfg = BuildConfig.default("src/main.spl", "my_program")
            # @capture: evidence_manifest("native_exe_config_opt_default") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor set optimization to level 0 (Debug)")
            expect(cfg.optimization).to_equal(0)  # oracle: 0 — BuildConfig.default()'s own optimization field

        it "defaults to libc as library dependency":
            # @req REQ-NATIVE-EXE-005
            step("Ask BuildConfig.default() to build a config")
            val cfg = BuildConfig.default("src/main.spl", "my_program")
            # @capture: evidence_manifest("native_exe_config_libc_default") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor's default library list is just libc")
            expect(cfg.libraries[0]).to_equal("c")
            expect(cfg.libraries.len()).to_equal(1)  # oracle: 1 — BuildConfig.default()'s own libraries field

    context "LLVM backend configuration":
        it "accepts llvm as backend value":
            # @req REQ-NATIVE-EXE-006
            step("Ask BuildConfig.default() to build a config, then set backend to llvm")
            var cfg = BuildConfig.default("src/main.spl", "my_program")
            cfg = BuildConfig(entry_point: cfg.entry_point, output: cfg.output,
                dependencies: cfg.dependencies, libraries: cfg.libraries,
                library_paths: cfg.library_paths, optimization: cfg.optimization,
                debug: cfg.debug, verbose: cfg.verbose, pie: cfg.pie,
                target_cpu: cfg.target_cpu, target_features: cfg.target_features,
                linker_flags: cfg.linker_flags, backend: Some("llvm"), host_simd: cfg.host_simd)
            # @capture: evidence_manifest("native_exe_006") -> native_exe_spec.evidence.sdn
            step("Verify the config's backend field carries llvm")
            expect(cfg.backend.?).to_equal(true)
            expect(cfg.backend.unwrap()).to_equal("llvm")

        it "accepts smf as backend value":
            # @req REQ-NATIVE-EXE-007
            step("Ask BuildConfig.default() to build a config, then set backend to smf")
            var cfg = BuildConfig.default("src/main.spl", "my_program")
            cfg = BuildConfig(entry_point: cfg.entry_point, output: cfg.output,
                dependencies: cfg.dependencies, libraries: cfg.libraries,
                library_paths: cfg.library_paths, optimization: cfg.optimization,
                debug: cfg.debug, verbose: cfg.verbose, pie: cfg.pie,
                target_cpu: cfg.target_cpu, target_features: cfg.target_features,
                linker_flags: cfg.linker_flags, backend: Some("smf"), host_simd: cfg.host_simd)
            # @capture: evidence_manifest("native_exe_007") -> native_exe_spec.evidence.sdn
            step("Verify the config's backend field carries smf")
            expect(cfg.backend.?).to_equal(true)
            expect(cfg.backend.unwrap()).to_equal("smf")

    context "for_simple_cli configuration":
        it "uses x86-64-v3 as default target CPU":
            # @req REQ-NATIVE-EXE-008
            step("Ask the real BuildConfig.for_simple_cli() constructor to build a config")
            val cfg = BuildConfig.for_simple_cli()
            # @capture: evidence_manifest("native_exe_008") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor's target CPU default")
            expect(cfg.target_cpu.?).to_equal(true)
            expect(cfg.target_cpu.unwrap()).to_equal("x86-64-v3")

        it "includes standard libraries":
            # @req REQ-NATIVE-EXE-009
            step("Ask BuildConfig.for_simple_cli() to build a config")
            val cfg = BuildConfig.for_simple_cli()
            # @capture: evidence_manifest("native_exe_009") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor's library list")
            expect(cfg.libraries[0]).to_equal("c")
            expect(cfg.libraries.len()).to_equal(3)  # oracle: 3 — BuildConfig.for_simple_cli()'s own libraries field
            expect(cfg.libraries[1]).to_equal("m")
            expect(cfg.libraries[2]).to_equal("pthread")

        it "uses optimization level 2":
            # @req REQ-NATIVE-EXE-010
            step("Ask BuildConfig.for_simple_cli() to build a config")
            val cfg = BuildConfig.for_simple_cli()
            # @capture: evidence_manifest("native_exe_010") -> native_exe_spec.evidence.sdn
            step("Verify the real constructor's optimization level")
            expect(cfg.optimization).to_equal(2)  # oracle: 2 — BuildConfig.for_simple_cli()'s own optimization field

# ============================================================================
# CLI Flag Parsing Tests
# ============================================================================

describe "LLVM Backend Flag Parsing":
    # ## CLI Flag Parsing
    #
    # Verifies that --backend=llvm flag is correctly parsed
    # and mapped to config.backend.

    context "backend flag parsing":
        it "parses --backend=llvm":
            # @req REQ-NATIVE-EXE-011
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_011") -> native_exe_spec.evidence.sdn
            val flag = "--backend=llvm"
            val is_llvm_flag = flag == "--backend=llvm"
            expect(is_llvm_flag).to_equal(true)

        it "parses --backend=smf":
            # @req REQ-NATIVE-EXE-012
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_012") -> native_exe_spec.evidence.sdn
            val flag = "--backend=smf"
            val is_smf_flag = flag == "--backend=smf"
            expect(is_smf_flag).to_equal(true)

        it "detects unknown backend from flag":
            # @req REQ-NATIVE-EXE-013
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_013") -> native_exe_spec.evidence.sdn
            val flag = "--backend=unknown"
            val starts = flag.starts_with("--backend=")
            val be_name = flag[10..]
            val is_known = be_name == "llvm" or be_name == "smf"
            expect(starts).to_equal(true)
            expect(is_known).to_equal(false)

    context "backend dispatch logic":
        it "dispatches to LLVM when backend is llvm":
            # @req REQ-NATIVE-EXE-014
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_014") -> native_exe_spec.evidence.sdn
            val backend: text? = Some("llvm")
            val use_llvm = backend.? and backend.unwrap() == "llvm"
            expect(use_llvm).to_equal(true)

        it "dispatches to SMF when backend is nil":
            # @req REQ-NATIVE-EXE-015
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_015") -> native_exe_spec.evidence.sdn
            val backend: text? = nil
            val use_smf = not backend.?
            expect(use_smf).to_equal(true)

        it "dispatches to SMF when backend is smf":
            # @req REQ-NATIVE-EXE-016
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_016") -> native_exe_spec.evidence.sdn
            val backend: text? = Some("smf")
            val use_llvm = backend.? and backend.unwrap() == "llvm"
            val use_smf = not use_llvm
            expect(use_smf).to_equal(true)

# ============================================================================
# Entry Point IR Generation Tests
# ============================================================================

describe "Entry Point IR Generation":
    # ## Entry Point LLVM IR
    #
    # Verifies the generated LLVM IR for program entry points,
    # both hosted (main) and bare-metal (_start).

    context "hosted entry point (main)":
        it "contains module name comment":
            # @req REQ-NATIVE-EXE-017
            step("Generate hosted entry-point IR for a named module via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_017") -> native_exe_spec.evidence.sdn
            step("Verify the generated IR's leading comment names the module")
            expect(ir).to_contain("test_program")

        it "declares __simple_runtime_init":
            # @req REQ-NATIVE-EXE-018
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_018") -> native_exe_spec.evidence.sdn
            step("Verify the generated IR declares __simple_runtime_init")
            expect(ir).to_contain("declare void @__simple_runtime_init()")

        it "declares __simple_main":
            # @req REQ-NATIVE-EXE-019
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_019") -> native_exe_spec.evidence.sdn
            step("Verify the generated IR declares __simple_main")
            expect(ir).to_contain("declare i64 @__simple_main()")

        it "declares __simple_runtime_shutdown":
            # @req REQ-NATIVE-EXE-020
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_020") -> native_exe_spec.evidence.sdn
            step("Verify the generated IR declares __simple_runtime_shutdown")
            expect(ir).to_contain("declare void @__simple_runtime_shutdown()")

        it "defines main with argc and argv":
            # @req REQ-NATIVE-EXE-021
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_021") -> native_exe_spec.evidence.sdn
            step("Verify the generated main() definition carries argc and argv")
            expect(ir).to_contain("@main")
            expect(ir).to_contain("%argc")
            expect(ir).to_contain("%argv")

        it "calls runtime init before main":
            # @req REQ-NATIVE-EXE-022
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_022") -> native_exe_spec.evidence.sdn
            step("Verify the generated body calls __simple_runtime_init")
            expect(ir).to_contain("call void @__simple_runtime_init()")

        it "calls __simple_main and captures result":
            # @req REQ-NATIVE-EXE-023
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_023") -> native_exe_spec.evidence.sdn
            step("Verify the generated body captures __simple_main's result")
            expect(ir).to_contain("%result = call i64 @__simple_main()")

        it "truncates i64 result to i32 exit code":
            # @req REQ-NATIVE-EXE-024
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_024") -> native_exe_spec.evidence.sdn
            step("Verify the generated body truncates the i64 result to i32")
            expect(ir).to_contain("trunc")
            expect(ir).to_contain("%result to i32")

        it "returns exit code":
            # @req REQ-NATIVE-EXE-025
            step("Generate hosted entry-point IR via the real compiler function")
            val ir = generate_entry_point_ir("test_program")
            # @capture: evidence_manifest("native_exe_025") -> native_exe_spec.evidence.sdn
            step("Verify the generated body returns the truncated exit code")
            expect(ir).to_contain("ret i32 %exit_code")

    context "bare-metal entry point (_start)":
        it "defines _start with noreturn":
            # @req REQ-NATIVE-EXE-026
            step("Generate bare-metal entry-point IR via the real compiler function")
            val ir = generate_start_ir("test_kernel")
            # @capture: evidence_manifest("native_exe_026") -> native_exe_spec.evidence.sdn
            step("Verify the generated _start() is declared noreturn")
            expect(ir).to_contain("define void @_start() noreturn")

        it "contains halt loop":
            # @req REQ-NATIVE-EXE-027
            step("Generate bare-metal entry-point IR via the real compiler function")
            val ir = generate_start_ir("test_kernel")
            # @capture: evidence_manifest("native_exe_027") -> native_exe_spec.evidence.sdn
            step("Verify the generated body branches into a halt: label loop")
            expect(ir).to_contain("halt:")
            expect(ir).to_contain("br label %halt")

        it "uses hlt instruction in halt loop":
            # @req REQ-NATIVE-EXE-028
            step("Generate x86_64 bare-metal entry-point IR via the real compiler function")
            val ir = generate_start_ir("test_kernel")
            # @capture: evidence_manifest("native_exe_028") -> native_exe_spec.evidence.sdn
            step("Verify the halt loop emits the x86 hlt instruction")
            expect(ir).to_contain("asm sideeffect \"hlt\"")

    context "entry point mode selection":
        it "selects main for hosted mode":
            # @req REQ-NATIVE-EXE-029
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_029") -> native_exe_spec.evidence.sdn
            val bare_metal = false
            val entry_fn = if bare_metal: "_start" else: "main"
            expect(entry_fn).to_equal("main")

        it "selects _start for bare-metal mode":
            # @req REQ-NATIVE-EXE-030
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_030") -> native_exe_spec.evidence.sdn
            val bare_metal = true
            val entry_fn = if bare_metal: "_start" else: "main"
            expect(entry_fn).to_equal("_start")

# ============================================================================
# Runtime Stub Generation Tests
# ============================================================================

describe "Runtime Stub Generation":
    # ## Runtime Stub
    #
    # Verifies the C runtime stub that provides __simple_runtime_init,
    # __simple_runtime_shutdown, and the main() bridge function.

    context "stub C source content":
        it "declares __simple_runtime_init as void function":
            # @req REQ-NATIVE-EXE-031
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_031") -> native_exe_spec.evidence.sdn
            val stub_line = "void __simple_runtime_init(void) {}"
            expect(stub_line).to_contain("__simple_runtime_init")
            expect(stub_line).to_contain("void")

        it "declares __simple_runtime_shutdown as void function":
            # @req REQ-NATIVE-EXE-032
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_032") -> native_exe_spec.evidence.sdn
            val stub_line = "void __simple_runtime_shutdown(void) {}"
            expect(stub_line).to_contain("__simple_runtime_shutdown")

        it "declares __simple_main as extern":
            # @req REQ-NATIVE-EXE-033
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_033") -> native_exe_spec.evidence.sdn
            val stub_line = "int __simple_main(void);"
            expect(stub_line).to_contain("__simple_main")

        it "defines main that calls init, __simple_main, shutdown":
            # @req REQ-NATIVE-EXE-034
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_034") -> native_exe_spec.evidence.sdn
            val main_body = "int main(int argc, char **argv)"
            expect(main_body).to_contain("main")
            expect(main_body).to_contain("argc")

        it "returns result from __simple_main":
            # @req REQ-NATIVE-EXE-035
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_035") -> native_exe_spec.evidence.sdn
            val ret_line = "return result;"
            expect(ret_line).to_contain("return")

    context "stub file paths":
        it "generates C source path from output path":
            # @req REQ-NATIVE-EXE-036
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_036") -> native_exe_spec.evidence.sdn
            val output_path = "build/artifacts/_runtime"
            val c_path = output_path + "_runtime_stub.c"
            expect(c_path).to_equal("build/artifacts/_runtime_runtime_stub.c")

        it "generates object file path from output path":
            # @req REQ-NATIVE-EXE-037
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_037") -> native_exe_spec.evidence.sdn
            val output_path = "build/artifacts/_runtime"
            val o_path = output_path + "_runtime_stub.o"
            expect(o_path).to_equal("build/artifacts/_runtime_runtime_stub.o")

# ============================================================================
# Build Pipeline Configuration Tests
# ============================================================================

describe "Build Pipeline Configuration":
    # ## Build Pipeline
    #
    # Verifies the build pipeline configuration for both
    # SMF and LLVM backends.

    context "SMF pipeline (default)":
        it "source_to_smf_path converts .spl to .smf in .build":
            # @req REQ-NATIVE-EXE-038
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_038") -> native_exe_spec.evidence.sdn
            val source = "src/app/cli/main.spl"
            val base_no_ext = source.replace(".spl", "")
            val base = base_no_ext.replace("/", "_")
            val smf_path = "build/artifacts/{base}.smf"
            expect(smf_path).to_equal("build/artifacts/src_app_cli_main.smf")

    context "LLVM pipeline":
        it "source_to_obj_path converts .spl to .o in .build":
            # @req REQ-NATIVE-EXE-039
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_039") -> native_exe_spec.evidence.sdn
            val source = "src/app/cli/main.spl"
            val base_no_ext = source.replace(".spl", "")
            val base = base_no_ext.replace("/", "_")
            val obj_path = "build/artifacts/{base}.o"
            expect(obj_path).to_equal("build/artifacts/src_app_cli_main.o")

        it "maps optimization 0 to Debug":
            # @req REQ-NATIVE-EXE-040
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_040") -> native_exe_spec.evidence.sdn
            val optimization = 0
            val level_name = match optimization:
                case 0: "Debug"
                case 1: "Size"
                case 2: "Speed"
                case 3: "Aggressive"
                case _: "Speed"
            expect(level_name).to_equal("Debug")

        it "maps optimization 2 to Speed":
            # @req REQ-NATIVE-EXE-041
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_041") -> native_exe_spec.evidence.sdn
            val optimization = 2
            val level_name = match optimization:
                case 0: "Debug"
                case 1: "Size"
                case 2: "Speed"
                case 3: "Aggressive"
                case _: "Speed"
            expect(level_name).to_equal("Speed")

        it "maps optimization 3 to Aggressive":
            # @req REQ-NATIVE-EXE-042
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_042") -> native_exe_spec.evidence.sdn
            val optimization = 3
            val level_name = match optimization:
                case 0: "Debug"
                case 1: "Size"
                case 2: "Speed"
                case 3: "Aggressive"
                case _: "Speed"
            expect(level_name).to_equal("Aggressive")

    context "entry point object file":
        it "uses fixed path for entry point object":
            # @req REQ-NATIVE-EXE-043
            # NOTE: grepped src/compiler/70.backend/ on 2026-09-06 — no file
            # defines a literal "build/artifacts/_entry_point.o" path; the
            # LLVM pipeline (build_native_pipeline.spl:build_native_llvm)
            # delegates to aot_native_file_with_backend() instead of writing a
            # separate entry-point object at a fixed path. This scenario is a
            # tripwire on that absence, not a positive claim: it fails
            # (correctly demanding a real oracle) the day some future change
            # reintroduces a literal path convention here.
            step("Search the real native build pipeline source for a fixed entry-point object path")
            val pipeline_source = file_read("src/compiler/70.backend/build_native_pipeline.spl")
            val entry_point_source = file_read("src/compiler/70.backend/backend/entry_point.spl")
            val fixed_path_reintroduced = pipeline_source.contains("_entry_point.o") or
                entry_point_source.contains("_entry_point.o")
            # @capture: evidence_manifest("native_exe_043") -> native_exe_spec.evidence.sdn
            step("Verify no fixed entry-point object path exists in the real pipeline source")
            expect(fixed_path_reintroduced).to_equal(false)

    context "module path conversion":
        it "converts module path to file path":
            # @req REQ-NATIVE-EXE-044
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_044") -> native_exe_spec.evidence.sdn
            val module_path = "std.json"
            val dotted = module_path.replace(".", "/")
            val path = dotted.replace("std/", "lib/")
            val file_path = "src/{path}.spl"
            expect(file_path).to_equal("src/lib/json.spl")

        it "converts deep module path":
            # @req REQ-NATIVE-EXE-045
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_045") -> native_exe_spec.evidence.sdn
            val module_path = "compiler.backend.llvm_backend"
            val path = module_path.replace(".", "/")
            val file_path = "src/{path}.spl"
            expect(file_path).to_equal("src/compiler/backend/llvm_backend.spl")

        it "converts bare type import to default type domain path":
            # @req REQ-NATIVE-EXE-046
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_046") -> native_exe_spec.evidence.sdn
            val module_path = "I64"
            val file_path = "src/type/simple_lang/{module_path}.spl"
            expect(file_path).to_equal("src/type/simple_lang/I64.spl")

        it "converts owned-domain type import to underscore directory path":
            # @req REQ-NATIVE-EXE-047
            step("Verify the described build/codegen behavior")
            # @capture: evidence_manifest("native_exe_047") -> native_exe_spec.evidence.sdn
            val module_path = "simple-lang/I64"
            val parts = module_path.split("/")
            val file_path = "type/{parts[0].replace("-", "_")}/{parts[1]}.spl"
            expect(file_path).to_equal("type/simple_lang/I64.spl")
