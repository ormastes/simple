"""
# EasyFix Auto-Fix System

**Feature IDs:** #2200-2210
**Category:** Tooling
**Status:** Implemented

## Purpose and audience
Verifies the EasyFix data model and application engine end to end: fix and
replacement construction, confidence levels and their auto-apply policy,
end-to-start replacement application with overlap conflict detection,
confidence/ID filtering, report formatting, and the EasyFixLint integration.
For tooling engineers guarding the fix pipeline and operators confirming
that machine-applicable fixes stay correct on a deployed binary.

## Operator workflow
Run the file with the seed runner:
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/app/easy_fix_spec.spl
Each scenario builds fixes or replacements through the EasyFix types, applies
or filters them through FixApplicator, and pins the produced artifact with a
trailing oracle value on the same line.

## Compatibility and limitations
Exercises the in-memory applicator over synthetic source registries only; the
interactive prompt mode and CLI flags are covered by the lint suites. One
scenario is a known RED defect record: EasyFixLintResult.has_easy_fix()
reports false for a lint carrying a fix, and must stay RED until fixed.
Requires a binary that parses current-source syntax.

## Verification guidance and troubleshooting
A failure names the fix operation that mis-applied; rerun the single file
above and compare the produced value with the trailing oracle comment. An
overlap-detection failure points at span sorting; a wrong applied text points
at end-to-start offset preservation.
"""

# Lifecycle: doc/01_research/local/simple_compiler_linter_performance_memory_bug_detection.md ;
# doc/03_plan/infra/agent_sessions/lint_spec.md ;
# doc/04_architecture/compiler/00_compiler_architecture.md ;
# doc/05_design/compiler/architecture/layered_compiler_architecture.md

use std.spec.step

use std.nogc_sync_mut.tooling.easy_fix.types.*

describe "EasyFix Data Structures":
    # @manual_section: easyfix data model
    # ## Core Data Model
    #
    # Validates the EasyFix, Replacement, and FixConfidence types
    # that form the foundation of the auto-fix system.

    context "FixConfidence enum":
        # ### Scenario: Confidence Levels
        #
        # Three levels of confidence determine auto-apply behavior:
        # Safe (auto), Likely (review), Uncertain (human required).

        it "has Safe level":
            # @req REQ-EASYFIX-001
            # @capture(statistics): Safe-confidence constructor readback
            step("construct a fix at Safe confidence and read the policy back")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            expect(fix.confidence).to_equal(FixConfidence.Safe)
            expect(fix.is_safe()).to_equal(true)  # oracle: true — Safe is the auto-apply level

        it "has Likely level":
            # @req REQ-EASYFIX-002
            # @capture(statistics): Likely-confidence constructor readback
            step("construct a fix at Likely confidence and read the policy back")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Likely)
            expect(fix.confidence).to_equal(FixConfidence.Likely)
            expect(fix.is_safe()).to_equal(false)  # oracle: false — Likely requires review

        it "has Uncertain level":
            # @req REQ-EASYFIX-003
            # @capture(statistics): Uncertain-confidence constructor readback
            step("construct a fix at Uncertain confidence and read the policy back")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Uncertain)
            expect(fix.confidence).to_equal(FixConfidence.Uncertain)
            expect(fix.is_safe()).to_equal(false)  # oracle: false — Uncertain needs human review

        it "Safe != Likely":
            # @req REQ-EASYFIX-004
            # @capture(statistics): Safe/Likely distinctness readback
            step("compare the Safe and Likely enum variants for distinctness")
            expect FixConfidence.Safe != FixConfidence.Likely

        it "Safe != Uncertain":
            # @req REQ-EASYFIX-005
            # @capture(statistics): Safe/Uncertain distinctness readback
            step("compare the Safe and Uncertain enum variants for distinctness")
            expect FixConfidence.Safe != FixConfidence.Uncertain

        it "Likely != Uncertain":
            # @req REQ-EASYFIX-006
            # @capture(statistics): Likely/Uncertain distinctness readback
            step("compare the Likely and Uncertain enum variants for distinctness")
            expect FixConfidence.Likely != FixConfidence.Uncertain

    context "Replacement creation":
        # ### Scenario: Text Replacement Records
        #
        # Each replacement specifies a file, byte span, and new text.

        it "creates a replacement with all fields":
            # @req REQ-EASYFIX-007
            # @capture(statistics): five-field replacement readback
            step("construct a replacement with every field and read each back")
            val rep = Replacement.create(
                file: "test.spl",
                start: 10,
                end: 15,
                line: 2,
                column: 5,
                new_text: "new_value"
            )
            expect(rep.file).to_equal("test.spl")
            expect(rep.start).to_equal(10)  # oracle: 10 — the span start passed in
            expect(rep.end).to_equal(15)  # oracle: 15 — the span end passed in
            expect(rep.line).to_equal(2)  # oracle: 2 — the line passed in
            expect(rep.column).to_equal(5)  # oracle: 5 — the column passed in
            expect(rep.new_text).to_equal("new_value")

        it "creates a zero-length insertion":
            # @req REQ-EASYFIX-008
            # @capture(statistics): zero-length span readback
            step("construct an insertion whose span start equals its end")
            val rep = Replacement.create(
                file: "test.spl",
                start: 10,
                end: 10,
                line: 1,
                column: 11,
                new_text: "inserted "
            )
            expect(rep.start).to_equal(rep.end)
            expect(rep.new_text).to_equal("inserted ")

        it "creates a deletion (empty new_text)":
            # @req REQ-EASYFIX-009
            # @capture(statistics): deletion span width readback
            step("construct a deletion with empty new text and measure its span")
            val rep = Replacement.create(
                file: "test.spl",
                start: 5,
                end: 10,
                line: 1,
                column: 6,
                new_text: ""
            )
            expect(rep.new_text).to_equal("")
            expect(rep.end - rep.start).to_equal(5)  # oracle: 5 — the deletion span width

        it "formats for display":
            # @req REQ-EASYFIX-010
            # @capture(statistics): formatted replacement text readback
            step("format a replacement and check the rendered text")
            val rep = Replacement.create(
                file: "src/main.spl",
                start: 0,
                end: 5,
                line: 1,
                column: 1,
                new_text: "hello"
            )
            val formatted = rep.format()
            expect formatted.contains("src/main.spl")
            expect formatted.contains("hello")

    context "EasyFix creation":
        # ### Scenario: Building Fix Objects
        #
        # EasyFix objects aggregate replacements with metadata.

        it "creates an empty fix":
            # @req REQ-EASYFIX-011
            # @capture(statistics): empty-fix aggregate readback
            step("construct a fix with no replacements and read its fields")
            val fix = EasyFix.create(
                id: "L:test:1",
                description: "test fix",
                confidence: FixConfidence.Safe
            )
            expect(fix.id).to_equal("L:test:1")
            expect(fix.description).to_equal("test fix")
            expect(fix.replacements.len()).to_equal(0)  # oracle: 0 — no replacements added yet

        it "adds replacements":
            # @req REQ-EASYFIX-012
            # @capture(statistics): single-replacement aggregate readback
            step("add one replacement to a fix and count the aggregate")
            var fix = EasyFix.create(
                id: "L:test:1",
                description: "test fix",
                confidence: FixConfidence.Safe
            )
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 5, line: 1, column: 1, new_text: "hello"
            ))
            expect(fix.replacements.len()).to_equal(1)  # oracle: 1 — one replacement added

        it "adds multiple replacements":
            # @req REQ-EASYFIX-013
            # @capture(statistics): two-replacement aggregate readback
            step("add two replacements to one fix and count the aggregate")
            var fix = EasyFix.create(
                id: "L:test:1",
                description: "multi-replacement fix",
                confidence: FixConfidence.Likely
            )
            fix.add_replacement(Replacement.create(
                file: "a.spl", start: 0, end: 3, line: 1, column: 1, new_text: "xxx"
            ))
            fix.add_replacement(Replacement.create(
                file: "b.spl", start: 10, end: 15, line: 2, column: 1, new_text: "yyy"
            ))
            expect(fix.replacements.len()).to_equal(2)  # oracle: 2 — two replacements added

        it "reports safe confidence":
            # @req REQ-EASYFIX-014
            # @capture(statistics): Safe is-safe readback
            step("query is_safe on a Safe-confidence fix")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            expect(fix.is_safe()).to_equal(true)  # oracle: true — Safe auto-applies

        it "reports non-safe for Likely":
            # @req REQ-EASYFIX-015
            # @capture(statistics): Likely is-safe readback
            step("query is_safe on a Likely-confidence fix")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Likely)
            expect(fix.is_safe()).to_equal(false)  # oracle: false — Likely needs review

        it "reports non-safe for Uncertain":
            # @req REQ-EASYFIX-016
            # @capture(statistics): Uncertain is-safe readback
            step("query is_safe on an Uncertain-confidence fix")
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Uncertain)
            expect(fix.is_safe()).to_equal(false)  # oracle: false — Uncertain needs a human

        it "formats confidence as string":
            # @req REQ-EASYFIX-017
            # @capture(statistics): three-level confidence-string readback
            step("render all three confidence levels as strings")
            val safe = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            val likely = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Likely)
            val uncertain = EasyFix.create(id: "f3", description: "d", confidence: FixConfidence.Uncertain)
            expect(safe.confidence_str()).to_equal("safe")
            expect(likely.confidence_str()).to_equal("likely")
            expect(uncertain.confidence_str()).to_equal("uncertain")

describe "FixApplicator Engine":
    # @manual_section: fix application engine
    # ## Fix Application Logic
    #
    # Tests the core engine that applies text replacements to source files,
    # including sorting, conflict detection, and multi-file support.

    context "single replacement":
        # ### Scenario: Applying One Fix
        #
        # The simplest case: one replacement in one file.

        it "replaces text at the beginning":
            # @req REQ-EASYFIX-018
            # @capture(statistics): prefix-replacement applied text
            step("apply one fix over the first five bytes and read the file back")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello world"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 5, line: 1, column: 1, new_text: "goodbye"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("goodbye world")
                case Err(e):
                    assert_true(false)

        it "replaces text at the end":
            # @req REQ-EASYFIX-019
            # @capture(statistics): suffix-replacement applied text
            step("apply one fix over the last five bytes and read the file back")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello world"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 6, end: 11, line: 1, column: 7, new_text: "earth"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("hello earth")
                case Err(e):
                    assert_true(false)

        it "replaces text in the middle":
            # @req REQ-EASYFIX-020
            # @capture(statistics): middle-replacement applied text
            step("apply one fix over the middle token and read the file back")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "aaa bbb ccc"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 4, end: 7, line: 1, column: 5, new_text: "xxx"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("aaa xxx ccc")
                case Err(e):
                    assert_true(false)

        it "inserts text (zero-length span)":
            # @req REQ-EASYFIX-021
            # @capture(statistics): zero-span insertion applied text
            step("insert text at a zero-length span between the words")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello world"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 5, end: 5, line: 1, column: 6, new_text: " beautiful"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("hello beautiful world")
                case Err(e):
                    assert_true(false)

        it "deletes text (empty new_text)":
            # @req REQ-EASYFIX-022
            # @capture(statistics): deletion applied text
            step("delete the middle word via an empty replacement text")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello beautiful world"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 5, end: 15, line: 1, column: 6, new_text: ""
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("hello world")
                case Err(e):
                    assert_true(false)

    context "multiple non-overlapping replacements":
        # ### Scenario: Multiple Fixes in One File
        #
        # When multiple fixes target different parts of the same file,
        # they must be sorted and applied from end-to-start.

        it "applies two fixes in same file":
            # @req REQ-EASYFIX-023
            # @capture(statistics): two-fix applied text
            step("apply two disjoint fixes to one file and read the result")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "aaa bbb ccc"

            var fix1 = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix1.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 3, line: 1, column: 1, new_text: "xxx"
            ))

            var fix2 = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Safe)
            fix2.add_replacement(Replacement.create(
                file: "test.spl", start: 8, end: 11, line: 1, column: 9, new_text: "zzz"
            ))

            val result = FixApplicator.apply([fix1, fix2], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("xxx bbb zzz")
                case Err(e):
                    assert_true(false)

        it "applies three fixes preserving order":
            # @req REQ-EASYFIX-024
            # @capture(statistics): three-fix ordered applied text
            step("apply three fixes and confirm end-to-start order preservation")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "111 222 333 444"

            var fix1 = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix1.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 3, line: 1, column: 1, new_text: "aaa"
            ))
            var fix2 = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Safe)
            fix2.add_replacement(Replacement.create(
                file: "test.spl", start: 4, end: 7, line: 1, column: 5, new_text: "bbb"
            ))
            var fix3 = EasyFix.create(id: "f3", description: "d", confidence: FixConfidence.Safe)
            fix3.add_replacement(Replacement.create(
                file: "test.spl", start: 12, end: 15, line: 1, column: 13, new_text: "ddd"
            ))

            val result = FixApplicator.apply([fix1, fix2, fix3], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("aaa bbb 333 ddd")
                case Err(e):
                    assert_true(false)

    context "conflicting replacements":
        # ### Scenario: Overlapping Spans
        #
        # When two replacements overlap in the same file, the applicator
        # must detect the conflict and return an error.

        it "detects overlapping spans":
            # @req REQ-EASYFIX-025
            # @capture(statistics): overlap-conflict error message
            step("apply two overlapping fixes and expect the conflict error")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello world"

            var fix1 = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix1.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 8, line: 1, column: 1, new_text: "xxx"
            ))
            var fix2 = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Safe)
            fix2.add_replacement(Replacement.create(
                file: "test.spl", start: 5, end: 11, line: 1, column: 6, new_text: "yyy"
            ))

            val result = FixApplicator.apply([fix1, fix2], sources)
            match result:
                case Ok(_):
                    expect false  # Should have failed
                case Err(e):
                    expect e.contains("overlap") or e.contains("Conflicting")

    context "multi-file fixes":
        # ### Scenario: Fixes Across Multiple Files
        #
        # Fixes can span multiple files; each file is processed independently.

        it "applies fixes to different files":
            # @req REQ-EASYFIX-026
            # @capture(statistics): two-file applied texts
            step("apply one fix per file across two registry entries")
            var sources: Dict<String, String> = {}
            sources["a.spl"] = "file_a content"
            sources["b.spl"] = "file_b content"

            var fix1 = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix1.add_replacement(Replacement.create(
                file: "a.spl", start: 0, end: 6, line: 1, column: 1, new_text: "alpha"
            ))
            var fix2 = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Safe)
            fix2.add_replacement(Replacement.create(
                file: "b.spl", start: 0, end: 6, line: 1, column: 1, new_text: "beta"
            ))

            val result = FixApplicator.apply([fix1, fix2], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["a.spl"]).to_equal("alpha content")
                    expect(new_sources["b.spl"]).to_equal("beta content")
                case Err(e):
                    assert_true(false)

    context "missing file":
        # ### Scenario: File Not in Source Registry
        #
        # If a replacement references a file not in the source registry,
        # an error is returned.

        it "returns error for missing file":
            # @req REQ-EASYFIX-027
            # @capture(statistics): missing-file error message
            step("apply a fix naming a file absent from the registry")
            var sources: Dict<String, String> = {}
            sources["exists.spl"] = "content"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "missing.spl", start: 0, end: 5, line: 1, column: 1, new_text: "x"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(_):
                    assert_true(false)
                case Err(e):
                    expect e.contains("not found") or e.contains("File not found")

describe "Fix Filtering":
    # @manual_section: fix filtering
    # ## Filtering Fixes by Criteria
    #
    # Tests confidence-based and ID-based filtering of fix collections.

    context "confidence filtering":
        # ### Scenario: Filter by Confidence Level
        #
        # Only fixes meeting the minimum confidence threshold are included.

        it "Safe filter returns only safe fixes":
            # @req REQ-EASYFIX-028
            # @capture(statistics): Safe-filter membership readback
            step("filter a three-level collection down to Safe fixes only")
            val safe = EasyFix.create(id: "safe", description: "d", confidence: FixConfidence.Safe)
            val likely = EasyFix.create(id: "likely", description: "d", confidence: FixConfidence.Likely)
            val uncertain = EasyFix.create(id: "uncertain", description: "d", confidence: FixConfidence.Uncertain)
            val fixes = [safe, likely, uncertain]

            val filtered = FixApplicator.filter_by_confidence(fixes, FixConfidence.Safe)
            expect(filtered[0].id).to_equal("safe")
            expect(filtered.len()).to_equal(1)  # oracle: 1 — only the Safe fix survives

        it "Likely filter returns safe and likely":
            # @req REQ-EASYFIX-029
            # @capture(statistics): Likely-filter membership readback
            step("filter the collection at the Likely threshold")
            val safe = EasyFix.create(id: "safe", description: "d", confidence: FixConfidence.Safe)
            val likely = EasyFix.create(id: "likely", description: "d", confidence: FixConfidence.Likely)
            val uncertain = EasyFix.create(id: "uncertain", description: "d", confidence: FixConfidence.Uncertain)
            val fixes = [safe, likely, uncertain]

            val filtered = FixApplicator.filter_by_confidence(fixes, FixConfidence.Likely)
            expect(filtered.len()).to_equal(2)  # oracle: 2 — Safe and Likely pass the threshold

        it "Uncertain filter returns all":
            # @req REQ-EASYFIX-030
            # @capture(statistics): Uncertain-filter membership readback
            step("filter the collection at the all-inclusive Uncertain threshold")
            val safe = EasyFix.create(id: "safe", description: "d", confidence: FixConfidence.Safe)
            val likely = EasyFix.create(id: "likely", description: "d", confidence: FixConfidence.Likely)
            val uncertain = EasyFix.create(id: "uncertain", description: "d", confidence: FixConfidence.Uncertain)
            val fixes = [safe, likely, uncertain]

            val filtered = FixApplicator.filter_by_confidence(fixes, FixConfidence.Uncertain)
            expect(filtered.len()).to_equal(3)  # oracle: 3 — every fix passes

        it "returns empty list when no fixes match":
            # @req REQ-EASYFIX-031
            # @capture(statistics): empty-filter readback
            step("filter a single Uncertain fix at the Safe threshold")
            val uncertain = EasyFix.create(id: "u1", description: "d", confidence: FixConfidence.Uncertain)
            val filtered = FixApplicator.filter_by_confidence([uncertain], FixConfidence.Safe)
            expect(filtered.len()).to_equal(0)  # oracle: 0 — nothing meets the Safe bar

    context "ID prefix filtering":
        # ### Scenario: Filter by Fix ID
        #
        # Select fixes whose IDs start with a given prefix.

        it "filters by prefix":
            # @req REQ-EASYFIX-032
            # @capture(statistics): prefix-filter membership readback
            step("filter three fixes by the L:todo_format id prefix")
            val f1 = EasyFix.create(id: "L:todo_format:1", description: "d", confidence: FixConfidence.Safe)
            val f2 = EasyFix.create(id: "L:bare_bool:1", description: "d", confidence: FixConfidence.Safe)
            val f3 = EasyFix.create(id: "L:todo_format:2", description: "d", confidence: FixConfidence.Safe)

            val filtered = FixApplicator.filter_by_id([f1, f2, f3], "L:todo_format")
            expect(filtered.len()).to_equal(2)  # oracle: 2 — the two todo_format ids match

        it "returns empty when no match":
            # @req REQ-EASYFIX-033
            # @capture(statistics): empty prefix-filter readback
            step("filter by a prefix no fix id carries")
            val f1 = EasyFix.create(id: "L:todo:1", description: "d", confidence: FixConfidence.Safe)
            val filtered = FixApplicator.filter_by_id([f1], "E:type")
            expect(filtered.len()).to_equal(0)  # oracle: 0 — no id carries the E:type prefix

        it "matches exact prefix":
            # @req REQ-EASYFIX-034
            # @capture(statistics): exact-prefix membership readback
            step("filter by a prefix that one id equals exactly")
            val f1 = EasyFix.create(id: "L:abc", description: "d", confidence: FixConfidence.Safe)
            val f2 = EasyFix.create(id: "L:abcdef", description: "d", confidence: FixConfidence.Safe)
            val filtered = FixApplicator.filter_by_id([f1, f2], "L:abc")
            expect filtered.len() == 2  # Both start with "L:abc"

describe "FixReport":
    # @manual_section: fix reporting
    # ## Fix Application Reporting
    #
    # After fixes are applied, a report summarizes what was done.

    context "empty report":
        it "starts with zero counts":
            # @req REQ-EASYFIX-035
            # @capture(statistics): empty-report counter readback
            step("build an empty report and read every counter")
            val report = FixReport.empty()
            expect(report.applied).to_equal(0)  # oracle: 0 — nothing applied yet
            expect(report.skipped).to_equal(0)  # oracle: 0 — nothing skipped yet
            expect(report.modified_files.len()).to_equal(0)  # oracle: 0 — no files touched
            expect(report.details.len()).to_equal(0)  # oracle: 0 — no detail lines

    context "report formatting":
        it "formats dry-run report":
            # @req REQ-EASYFIX-036
            # @capture(statistics): dry-run report text
            step("format a two-fix report in dry-run mode")
            var report = FixReport.empty()
            report.applied = 2
            report.modified_files = ["a.spl", "b.spl"]
            report.details = ["[f1] fix one", "[f2] fix two"]

            val output = report.format(true)
            expect output.contains("Would apply")
            expect output.contains("2 fix(es)")

        it "formats applied report":
            # @req REQ-EASYFIX-037
            # @capture(statistics): applied report text
            step("format a one-fix report in applied mode")
            var report = FixReport.empty()
            report.applied = 1
            report.modified_files = ["test.spl"]
            report.details = ["[f1] fixed issue"]

            val output = report.format(false)
            expect output.contains("Applied")
            expect output.contains("1 fix(es)")

describe "EasyFixLint-EasyFix Integration":
    # @manual_section: lint integration
    # ## Integration with EasyFixLint System
    #
    # Tests that lint diagnostics can carry EasyFix data and that
    # the fix hint and easy_fix fields work together.

    context "EasyFixLint with EasyFix":
        it "creates lint with easy_fix":
            # @req REQ-EASYFIX-038
            # @capture(statistics): lint-with-fix presence readback
            step("attach a fix and a hint to a lint diagnostic")
            var fix = EasyFix.create(
                id: "L:todo_format:1",
                description: "add format tags",
                confidence: FixConfidence.Uncertain
            )
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 10, end: 10, line: 1, column: 11, new_text: "[runtime][P2] "
            ))

            # WRONG-CONSTRUCTOR FIX (2026-08-04): `EasyFixLint` declares no
            # `static fn new` (src/lib/nogc_sync_mut/tooling/easy_fix/types.spl:240)
            # — its siblings Replacement/EasyFix use `static fn create`, and the
            # language rule is `Point(x: 3, y: 4)`, not `.new()`. `EasyFixLint.new(...)`
            # therefore died with "semantic: unknown static method new on class
            # EasyFixLint". Use the field constructor with all six declared fields.
            val lint = EasyFixLint(code: "T001", level: LintLevel.Warn, category: LintCategory.Style,
                message: "TODO/FIXME missing [area][priority] format",
                fix_hint: nil, easy_fix: nil)
                .with_fix("Use: TODO: [area][P0-P3] description")
                .with_easy_fix(fix)

            expect lint.easy_fix.? == true
            expect lint.fix_hint.? == true

        it "creates lint without easy_fix":
            # @req REQ-EASYFIX-039
            # @capture(statistics): bare-lint absence readback
            step("build a lint diagnostic with no fix attached")
            val lint = EasyFixLint(code: "W001", level: LintLevel.Warn, category: LintCategory.Warning,
                message: "unused variable", fix_hint: nil, easy_fix: nil)
            expect lint.easy_fix == nil
            expect lint.fix_hint == nil

    context "EasyFixLintResult with EasyFix":
        it "reports has_easy_fix true when present":
            # @req REQ-EASYFIX-040
            # KNOWN RED defect record: EasyFixLintResult.has_easy_fix() returns
            # false for a lint that carries a fix. Left failing on purpose —
            # see doc/06_spec/03_system/feature/app/easy_fix_spec.md history.
            # @capture(statistics): result has-fix presence readback
            step("wrap a fix-carrying lint in a result and probe has_easy_fix")
            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            val lint = EasyFixLint(code: "T001", level: LintLevel.Warn, category: LintCategory.Style,
                message: "msg", fix_hint: nil, easy_fix: nil)
                .with_easy_fix(fix)
            # Same wrong-constructor fix: EasyFixLintResult declares no `static fn new`
            # (types.spl:277); use the field constructor.
            val result = EasyFixLintResult(file_path: "test.spl", line: 1, column: 1, lint: lint)
            expect result.has_easy_fix() == true

        it "reports has_easy_fix false when absent":
            # @req REQ-EASYFIX-041
            # @capture(statistics): bare result absence readback
            step("wrap a fix-less lint in a result and probe has_easy_fix")
            val lint = EasyFixLint(code: "W001", level: LintLevel.Warn, category: LintCategory.Warning,
                message: "msg", fix_hint: nil, easy_fix: nil)
            # Same wrong-constructor fix: EasyFixLintResult declares no `static fn new`
            # (types.spl:277); use the field constructor.
            val result = EasyFixLintResult(file_path: "test.spl", line: 1, column: 1, lint: lint)
            expect result.has_easy_fix() == false

        it "includes fix info in formatted output":
            # @req REQ-EASYFIX-042
            # @capture(statistics): formatted result fix line
            step("format a fix-carrying result and check the fix line")
            var fix = EasyFix.create(id: "L:test:1", description: "d", confidence: FixConfidence.Safe)
            val lint = EasyFixLint(code: "T001", level: LintLevel.Warn, category: LintCategory.Style,
                message: "msg", fix_hint: nil, easy_fix: nil)
                .with_easy_fix(fix)
            # Same wrong-constructor fix: EasyFixLintResult declares no `static fn new`
            # (types.spl:277); use the field constructor.
            val result = EasyFixLintResult(file_path: "test.spl", line: 1, column: 1, lint: lint)
            val formatted = result.format()
            expect formatted.contains("fix: available")
            expect formatted.contains("L:test:1")

describe "EasyFix Edge Cases":
    # @manual_section: edge cases
    # ## Edge Cases and Boundary Conditions
    #
    # Tests unusual inputs and boundary conditions in the fix system.

    context "empty inputs":
        it "handles empty fix list":
            # @req REQ-EASYFIX-043
            # @capture(statistics): empty-fix-list applied readback
            step("apply an empty fix list over a populated registry")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello"
            val result = FixApplicator.apply([], sources)
            match result:
                case Ok(new_sources):
                    expect new_sources.len() == 0  # No files modified
                case Err(_):
                    assert_true(false)

        it "handles fix with no replacements":
            # @req REQ-EASYFIX-044
            # @capture(statistics): replacement-free fix applied readback
            step("apply a fix carrying no replacements")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello"
            val fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect new_sources.len() == 0  # No changes needed
                case Err(_):
                    assert_true(false)

    context "replacement at file boundaries":
        it "replaces entire file content":
            # @req REQ-EASYFIX-045
            # @capture(statistics): whole-file replacement readback
            step("replace the entire file content with one span")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "old"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 3, line: 1, column: 1, new_text: "new content"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("new content")
                case Err(_):
                    assert_true(false)

        it "inserts at beginning of file":
            # @req REQ-EASYFIX-046
            # @capture(statistics): file-start insertion readback
            step("insert text at offset zero of the file")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "world"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 0, line: 1, column: 1, new_text: "hello "
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("hello world")
                case Err(_):
                    assert_true(false)

        it "appends at end of file":
            # @req REQ-EASYFIX-047
            # @capture(statistics): file-end insertion readback
            step("insert text at the offset just past the last byte")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "hello"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 5, end: 5, line: 1, column: 6, new_text: " world"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("hello world")
                case Err(_):
                    assert_true(false)

    context "replacement size changes":
        it "handles replacement longer than original":
            # @req REQ-EASYFIX-048
            # @capture(statistics): expanding replacement readback
            step("apply a replacement that grows the file")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "ab"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 2, line: 1, column: 1, new_text: "abcdef"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("abcdef")
                case Err(_):
                    assert_true(false)

        it "handles replacement shorter than original":
            # @req REQ-EASYFIX-049
            # @capture(statistics): shrinking replacement readback
            step("apply a replacement that shrinks the file")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "abcdef"

            var fix = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 6, line: 1, column: 1, new_text: "ab"
            ))

            val result = FixApplicator.apply([fix], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("ab")
                case Err(_):
                    assert_true(false)

    context "adjacent replacements":
        it "applies adjacent non-overlapping fixes":
            # @req REQ-EASYFIX-050
            # @capture(statistics): adjacent-fix applied text
            step("apply three back-to-back fixes over adjacent spans")
            var sources: Dict<String, String> = {}
            sources["test.spl"] = "aabbcc"

            var fix1 = EasyFix.create(id: "f1", description: "d", confidence: FixConfidence.Safe)
            fix1.add_replacement(Replacement.create(
                file: "test.spl", start: 0, end: 2, line: 1, column: 1, new_text: "xx"
            ))
            var fix2 = EasyFix.create(id: "f2", description: "d", confidence: FixConfidence.Safe)
            fix2.add_replacement(Replacement.create(
                file: "test.spl", start: 2, end: 4, line: 1, column: 3, new_text: "yy"
            ))
            var fix3 = EasyFix.create(id: "f3", description: "d", confidence: FixConfidence.Safe)
            fix3.add_replacement(Replacement.create(
                file: "test.spl", start: 4, end: 6, line: 1, column: 5, new_text: "zz"
            ))

            val result = FixApplicator.apply([fix1, fix2, fix3], sources)
            match result:
                case Ok(new_sources):
                    expect(new_sources["test.spl"]).to_equal("xxyyzz")
                case Err(_):
                    assert_true(false)
