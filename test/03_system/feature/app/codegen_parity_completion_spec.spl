describe "Core Arithmetic":
    # ## Binary Arithmetic Operations
    #
    # Addition, subtraction, multiplication, division, modulo.

    it "addition":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'addition' and compare the computed value against the pinned constant")
        expect(30 + 12).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "subtraction":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'subtraction' and compare the computed value against the pinned constant")
        expect(50 - 8).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "multiplication":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'multiplication' and compare the computed value against the pinned constant")
        expect(6 * 7).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "division":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'division' and compare the computed value against the pinned constant")
        expect(84 / 2).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "modulo":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'modulo' and compare the computed value against the pinned constant")
        expect(47 % 5).to_equal(2)  # oracle: pinned expected constant for this codegen parity check
    it "nested arithmetic":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'nested arithmetic' and compare the computed value against the pinned constant")
        expect((10 + 20) * 2 - 18).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "copy operation":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'copy operation' and compare the computed value against the pinned constant")
        val x = 42
        val y = x
        expect(y).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
