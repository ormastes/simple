# ============================================================================
# Test Group 11: String Operations
# ============================================================================

describe "String Operations":
    # ## String Literals and Interpolation
    #
    # Const strings, interpolation with different types.

    it "const string":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'const string' and compare the computed value against the pinned constant")
        val s = "hel" + "lo"
        expect(s).to_equal("hello")
    it "string interpolation with int":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'string interpolation with int' and compare the computed value against the pinned constant")
        val x = 42
        val s = "value: {x}"
        expect(s).to_equal("value: 42")
    it "string interpolation with float":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'string interpolation with float' and compare the computed value against the pinned constant")
        val f = 3.14
