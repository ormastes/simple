# Test Group 34: Loop Statement (lowering_stmt.rs - HirStmt.Loop)
# ============================================================================

describe "Loop Statement":
    # ## Infinite Loop
    #
    # Loop with explicit break, distinct from while.

    it "loop with break":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'loop with break' and compare the computed value against the pinned constant")
        var i = 0
        loop:
            if i == 5:
                break
            i = i + 1
        expect(i).to_equal(5)  # oracle: pinned expected constant for this codegen parity check
    it "loop with early return":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'loop with early return' and compare the computed value against the pinned constant")
        fn find_first_even() -> i64:
            var i = 1
            loop:
                if i % 2 == 0:
                    return i
                i = i + 1
        expect(find_first_even()).to_equal(2)  # oracle: pinned expected constant for this codegen parity check
