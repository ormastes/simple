describe "Struct and Field Operations":
    # ## Struct Initialization and Field Access
    #
    # Construction, field get, nested structs.

    it "struct init and field access":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'struct init and field access' and compare the computed value against the pinned constant")
        val p = Point(x: 40, y: 2)
        expect(p.x + p.y).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "nested struct":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'nested struct' and compare the computed value against the pinned constant")
        val inner = Inner(v: 10)
        val outer = Outer(a: inner.v, b: 32)
        expect(outer.a + outer.b).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "deeply nested field access":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'deeply nested field access' and compare the computed value against the pinned constant")
        val c = C(b: B(a: A(val_: 42)))
        expect(c.b.a.val_).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
