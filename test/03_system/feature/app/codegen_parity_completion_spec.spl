describe "Comparison Operations":
    # ## Relational Operators
    #
    # All six comparison operators: ==, !=, <, <=, >, >=.

    it "equal - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'equal - true' and compare the computed value against the pinned constant")
        expect((if 5 == 5: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "equal - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'equal - false' and compare the computed value against the pinned constant")
        expect((if 5 == 3: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "not equal - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'not equal - true' and compare the computed value against the pinned constant")
        expect((if 5 != 3: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "not equal - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'not equal - false' and compare the computed value against the pinned constant")
        expect((if 5 != 5: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "less than - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'less than - true' and compare the computed value against the pinned constant")
        expect((if 3 < 5: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "less than - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'less than - false' and compare the computed value against the pinned constant")
        expect((if 5 < 3: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "less than or equal - equal":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'less than or equal - equal' and compare the computed value against the pinned constant")
        expect((if 5 <= 5: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "less than or equal - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'less than or equal - false' and compare the computed value against the pinned constant")
        expect((if 6 <= 5: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "greater than - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'greater than - true' and compare the computed value against the pinned constant")
        expect((if 7 > 3: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "greater than - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'greater than - false' and compare the computed value against the pinned constant")
        expect((if 3 > 7: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "greater than or equal - equal":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'greater than or equal - equal' and compare the computed value against the pinned constant")
        expect((if 5 >= 5: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "greater than or equal - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'greater than or equal - false' and compare the computed value against the pinned constant")
        expect((if 3 >= 5: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
