    it "logical and - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'logical and - true' and compare the computed value against the pinned constant")
        expect((if true and true: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "logical and - false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'logical and - false' and compare the computed value against the pinned constant")
        expect((if true and false: 1 else: 0)).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
    it "logical or - true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'logical or - true' and compare the computed value against the pinned constant")
        expect((if false or true: 1 else: 0)).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
