"""
## Purpose and audience
Purpose: Pin codegen behavior with real computed-value oracles so regressions in the
stdlib surface this spec covers fail loudly instead of passing vacuously.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-SYS-CODEGEN-9bc0
doc/01_research/local/REQ-SYS-CODEGEN-9bc0.md
doc/03_plan/sys_test/REQ-SYS-CODEGEN-9bc0.md
doc/04_architecture/REQ-SYS-CODEGEN-9bc0.md
doc/05_design/REQ-SYS-CODEGEN-9bc0.md
"""
# @req: REQ-SYS-CODEGEN-9bc0

# codegen behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

# ============================================================================
# Top-level type definitions (must be outside describe blocks)
# ============================================================================

fn check(condition: bool):
    expect(condition).to_equal(true)
fn check_msg(condition: bool, message: text):
    if not condition:
        expect(message).to_equal("")
struct Point:
    x: i64
    y: i64

struct Inner:
    v: i64

struct Outer:
    a: i64
    b: i64

struct A:
    val_: i64

struct B:
    a: A

struct C:
    b: B

struct Counter:
    count: i64

impl Counter:
    me increment():
        self.count = self.count + 1

struct BigStruct:
    a: i64
    b: i64
    c: i64
    d: i64

enum Color:
    Red
    Green
    Blue

enum Shape:
    Circle(i64)
    Rect(i64, i64)

enum Op:
    Add
    Sub
    Mul

enum Wrapper:
    Val(i64)
    None_

fn shape_area(s: Shape) -> i64:
    # Multi-field enum destructuring (w, h) not supported in interpreter
    match s:
        Shape.Circle(r): r
        _: 0

fn helper_add(a, b):
    return a + b

fn helper_double(x):
    return x * 2

fn helper_add_doubled(a, b):
    return helper_double(a) + helper_double(b)

fn apply_op(op: Op, a: i64, b: i64) -> i64:
    match op:
        Op.Add: a + b
        Op.Sub: a - b
        Op.Mul: a * b

fn factorial(n: i64) -> i64:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

fn classify(x: i64) -> i64:
    if x > 100:
        return 1
    if x > 50:
        return 2
    return 3

fn f1() -> i64:
    val a = 10
    val b = 20
    return a + b

fn f2() -> i64:
    val c = 12
    return c

fn implicit_value() -> i64:
    42

fn scoped_work() -> i64:
    val x: i64 = 10
    val y: i64 = 32
    return x + y

fn do_nothing():
    return

fn side_effect() -> i64:
    val _ = 10 + 20
    42

val GLOBAL_ANSWER = 42

fn ensure_positive(x: i64) -> i64:
    # ensures: result > 0
    return x

fn with_precondition(x: i64) -> i64:
    # requires: x > 0
    return x * 2

fn future_harness(value: i64) -> i64:
    value

fn generator_harness() -> [i64]:
    [1, 2, 3]

fn actor_harness() -> i64:
    42

fn gpu_intrinsic_harness() -> i64:
    42


# ============================================================================
# Test Group 1: Constants
# ============================================================================

# @manual_section: codegen parity

describe "Constants":
    # ## Constant Values
    #
    # Compile-time constant literals: integer, float, boolean.

    it "integer constant":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'integer constant' and compare the computed value against the pinned constant")
        val result = 42
        val doubled = result + result
        expect(doubled).to_equal(84)  # oracle: pinned expected constant for this codegen parity check
    it "float constant cast to int":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'float constant cast to int' and compare the computed value against the pinned constant")
        val x: f64 = 3.7
        val result = x as i64
        expect(result).to_equal(3)  # oracle: pinned expected constant for this codegen parity check
    it "boolean true":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'boolean true' and compare the computed value against the pinned constant")
        val result = if true: 1 else: 0
        expect(result).to_equal(1)  # oracle: pinned expected constant for this codegen parity check
    it "boolean false":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'boolean false' and compare the computed value against the pinned constant")
        val result = if false: 1 else: 0
        expect(result).to_equal(0)  # oracle: pinned expected constant for this codegen parity check
