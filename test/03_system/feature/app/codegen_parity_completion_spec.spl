describe "Cast Operations":
    # ## Type Casting
    #
    # Integer to float and float to integer conversions.

    it "int to float to int roundtrip":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'int to float to int roundtrip' and compare the computed value against the pinned constant")
        val x: i64 = 42
        val f: f64 = x as f64
        val back: i64 = f as i64
        expect(back).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "float truncation":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'float truncation' and compare the computed value against the pinned constant")
        val f: f64 = 3.9
        val i: i64 = f as i64
        expect(i).to_equal(3)  # oracle: pinned expected constant for this codegen parity check
# ============================================================================
# Test Group 7: Control Flow
# ============================================================================

describe "Control Flow":
    # ## Branching and Loops
    #
    # If-else, while, for, break, continue.

    it "if-else true branch":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'if-else true branch' and compare the computed value against the pinned constant")
        val result = if true: 42 else: 0
        expect(result).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "if-else false branch":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'if-else false branch' and compare the computed value against the pinned constant")
        val result = if false: 0 else: 42
        expect(result).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
    it "nested if-else":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'nested if-else' and compare the computed value against the pinned constant")
        val x = 15
        val result = if x > 20: 1 else: if x > 10: 2 else: 3
        expect(result).to_equal(2)  # oracle: pinned expected constant for this codegen parity check
    it "while loop accumulation":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'while loop accumulation' and compare the computed value against the pinned constant")
        var sum = 0
        var i = 1
        while i <= 10:
            sum = sum + i
            i = i + 1
        expect(sum).to_equal(55)  # oracle: pinned expected constant for this codegen parity check
    it "while with break":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'while with break' and compare the computed value against the pinned constant")
        var i = 0
        while true:
            if i == 5:
                break
            i = i + 1
        expect(i).to_equal(5)  # oracle: pinned expected constant for this codegen parity check
    it "while with continue":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'while with continue' and compare the computed value against the pinned constant")
        var sum = 0
        var i = 0
        while i < 10:
            i = i + 1
            if i % 2 == 0:
                continue
            sum = sum + i
        expect(sum).to_equal(25)  # oracle: pinned expected constant for this codegen parity check
    it "for range exclusive":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'for range exclusive' and compare the computed value against the pinned constant")
        var sum = 0
        for i in 0..5:
            sum = sum + i
        expect(sum).to_equal(10)  # oracle: pinned expected constant for this codegen parity check
    it "for range inclusive":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'for range inclusive' and compare the computed value against the pinned constant")
        var sum = 0
        for i in 0..=5:
            sum = sum + i
        expect(sum).to_equal(15)  # oracle: pinned expected constant for this codegen parity check
    it "if expression without else":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'if expression without else' and compare the computed value against the pinned constant")
        val x = 5 + 5
        if x > 100:
            val _ = 0
        expect(x).to_equal(10)  # oracle: pinned expected constant for this codegen parity check
    it "while that does not execute":
        # @req REQ-SYS-CODEGEN-9bc0
        # @capture(statistics): computed value pinned against the expected constant
        step("run 'while that does not execute' and compare the computed value against the pinned constant")
        var x = 42
        while false:
            x = 0
        expect(x).to_equal(42)  # oracle: pinned expected constant for this codegen parity check
