# Configuration and Environment Access Specification
#
# **Feature:** Environment variables and configuration access
# **Category:** System Integration
# **Status:** Implemented
#
# Tests for accessing environment variables, configuration files in SDN format,
# and system configuration. Verifies proper integration with the OS environment
# and configuration file parsing.

use std.spec.step

extern fn rt_env_get(key: text) -> text?
extern fn rt_env_set(key: text, value: text) -> bool

describe "Configuration and Environment Access":
    it "round-trips an environment variable through set and get":
        # @req: REQ-FEATURE-CONFIG-ENV-001
        step("Set SIMPLE_CONFIG_ENV_PROBE then read it back")
        expect(rt_env_set("SIMPLE_CONFIG_ENV_PROBE", "probe-value")).to_equal(true)
        expect(rt_env_get("SIMPLE_CONFIG_ENV_PROBE")).to_equal("probe-value")

    it "reads an existing platform environment variable":
        # @req: REQ-FEATURE-CONFIG-ENV-001
        step("Read PATH from the host environment")
        val path = rt_env_get("PATH") ?? ""
        expect(path.contains("/")).to_equal(true)

    it "returns nil for a missing environment variable":
        # @req: REQ-FEATURE-CONFIG-ENV-001
        step("Read a variable that was never set")
        expect(rt_env_get("SIMPLE_CONFIG_ENV_DEFINITELY_MISSING_20260822")).to_be_nil()
