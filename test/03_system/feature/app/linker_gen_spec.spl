"""
# Linker Script Generator

**Feature IDs:** #BM-LINKER-001
**Category:** Bare-Metal / Tooling
**Difficulty:** 3/5
**Status:** In Progress

## Purpose and audience
This spec is for tooling engineers changing `src/app/linker_gen`: the size
(`parse_size`) and address (`parse_address`/`format_hex`) parsers, the
`MemoryRegion.permissions_str()` method, and the real `generate_linker_script`
renderer that must keep GNU LD conventions (section layout, entry point,
boundary symbols) stable for bare-metal boards.

## Operator workflow
Run `bin/simple test test/03_system/feature/app/linker_gen_spec.spl` (or the
equivalent `simple run` on a deployed binary). Most scenarios call the real
parser/formatter functions or render a real linker script via
`generate_linker_script` and inspect its text — the remaining board-metadata
scenarios (board/cpu/arch human-readable names) pin documentation fixtures,
since no matching board SDN resource file ships in this tree today.

## Compatibility and limitations
This spec does not invoke GNU `ld` itself. The QEMU x86/Arduino Uno/MSP430
LaunchPad board numbers are documentation fixtures pinned here — no matching
board SDN resource exists, so a change to a real board file would not be
caught by this spec.

## Verification guidance and troubleshooting
A failure in Memory/Hex parsing or Section Layout/Entry Point/Symbol
Generation means the real parser/formatter/renderer functions in
`src/app/linker_gen/parser.spl` or `main.spl` changed. A failure in a
board-configuration metadata group means a documented convention number was
edited here without also updating the module docstring. The "formats 1MB as
0x100000" scenario is intentionally RED — see its `# NOTE:` and
`doc/08_tracking/bug/linker_gen_format_hex_nonzero_garbage_2026-09-06.md`.

## Implementation Notes

- Hex addresses formatted with 0x prefix
- Size suffixes: K (1024), M (1048576), G (1073741824)
- Permissions: r (read), w (write), x (execute)
"""

# Lifecycle: doc/01_research/compiler/backend/mold_linker_analysis.md ;
# doc/03_plan/agent_tasks/simple_riscv_hardening_2026-07-27.md ;
# doc/04_architecture/os/simpleos/simpleos_baremetal_host_config.md ;
# doc/05_design/compiler/architecture/linker_script_gen_design.md
# @manual_section: linker_script_generator

use std.spec.step
use std.spec

use app.linker_gen.parser.{parse_size, parse_address, BoardConfig, MemoryRegion, Section, Permission, QemuConfig}
use app.linker_gen.main.{format_hex, generate_linker_script}

extern fn rt_file_read_text(path: text) -> text

fn build_reference_board() -> BoardConfig:
    """A minimal-but-real board fixture. Origin 0 avoids the format_hex
    nonzero-input defect (doc/08_tracking/bug/linker_gen_format_hex_nonzero_garbage_2026-09-06.md)
    so this fixture stays usable for structural checks independent of that bug."""
    BoardConfig(
        name: "QEMU x86 (i686)",
        arch: "i686",
        target: "i686-unknown-none",
        description: "",
        memory: [
            MemoryRegion(name: "ram", origin: 0, length: parse_size("16M") ?? 0, permissions: [Permission.Read, Permission.Write, Permission.Execute], description: "")
        ],
        sections: [
            Section(name: ".text", memory: "ram", address: nil, align: parse_size("4K") ?? 0, input: ["*(.text*)"], section_type: "progbits", size: nil, keep: false),
            Section(name: ".rodata", memory: "ram", address: nil, align: 4, input: ["*(.rodata*)"], section_type: "progbits", size: nil, keep: false),
            Section(name: ".data", memory: "ram", address: nil, align: 4, input: ["*(.data*)"], section_type: "progbits", size: nil, keep: false),
            Section(name: ".bss", memory: "ram", address: nil, align: 4, input: ["*(.bss*)"], section_type: "nobits", size: nil, keep: false),
            Section(name: ".multiboot", memory: "ram", address: nil, align: 4, input: ["*(.multiboot)"], section_type: "progbits", size: nil, keep: true)
        ],
        entry: "_start",
        qemu: nil,
        multiboot: nil
    )

fn render_reference_board() -> text:
    generate_linker_script(build_reference_board())

describe "Memory Size Parsing":
    context "Kilobyte suffix":
        it "parses 1K as 1024":
            # @req REQ-LNK-001
            # @capture(bit_table): parse_size("1K")
            step("Parse the size literal 1K with the real parser")
            expect(parse_size("1K")).to_equal(Some(1024))  # oracle: 1 * 1024

        it "parses 64K as 65536":
            # @req REQ-LNK-002
            # @capture(bit_table): parse_size("64K")
            step("Parse the size literal 64K with the real parser")
            expect(parse_size("64K")).to_equal(Some(65536))  # oracle: 64 * 1024

        it "parses 640K as 655360":
            # @req REQ-LNK-003
            # @capture(bit_table): parse_size("640K")
            step("Parse the size literal 640K (conventional memory limit) with the real parser")
            expect(parse_size("640K")).to_equal(Some(655360))  # oracle: 640 * 1024

    context "Megabyte suffix":
        it "parses 1M as 1048576":
            # @req REQ-LNK-004
            # @capture(bit_table): parse_size("1M")
            step("Parse the size literal 1M with the real parser")
            expect(parse_size("1M")).to_equal(Some(1048576))  # oracle: 1 * 1048576

        it "parses 16M as 16777216":
            # @req REQ-LNK-005
            # @capture(bit_table): parse_size("16M")
            step("Parse the size literal 16M with the real parser")
            expect(parse_size("16M")).to_equal(Some(16777216))  # oracle: 16 * 1048576

    context "Gigabyte suffix":
        it "parses 1G as 1073741824":
            # @req REQ-LNK-006
            # @capture(bit_table): parse_size("1G")
            step("Parse the size literal 1G with the real parser")
            expect(parse_size("1G")).to_equal(Some(1073741824))  # oracle: 1 * 1073741824

    context "rejects malformed suffixes":
        it "rejects a size literal with an unsupported suffix":
            # @req REQ-LNK-007
            # @capture(bit_table): parse_size("4Q")
            step("Parse a size literal with an unsupported suffix and expect rejection")
            expect(parse_size("4Q")).to_equal(nil)  # oracle: 'Q' is not a K/M/G suffix and not a bare int

describe "Hex Address Parsing":
    it "parses 0x0 as 0":
        # @req REQ-LNK-008
        # @capture(bit_table): parse_address("0x0")
        step("Parse the hex literal 0x0 with the real address parser")
        expect(parse_address("0x0")).to_equal(Some(0))  # oracle: 0x0 = 0

    it "parses 0x100000 as 1048576":
        # @req REQ-LNK-009
        # @capture(bit_table): parse_address("0x100000")
        step("Parse the hex literal 0x100000 (1MB mark, protected mode RAM start) with the real address parser")
        expect(parse_address("0x100000")).to_equal(Some(1048576))  # oracle: 0x100000 = 1MB = 1048576

    it "parses 0xB8000 as VGA buffer":
        # @req REQ-LNK-010
        # @capture(bit_table): parse_address("0xB8000")
        step("Parse the hex literal 0xB8000 (VGA text mode buffer) with the real address parser")
        expect(parse_address("0xB8000")).to_equal(Some(753664))  # oracle: 0xB8000 = 753664 (VGA text buffer)

    it "parses 0xF4 as debug exit port":
        # @req REQ-LNK-011
        # @capture(bit_table): parse_address("0xF4")
        step("Parse the hex literal 0xF4 (QEMU debug exit port) with the real address parser")
        expect(parse_address("0xF4")).to_equal(Some(244))  # oracle: 0xF4 = 244 (QEMU debug exit iobase)

    it "rejects an address literal with an invalid hex digit":
        # @req REQ-LNK-012
        # @capture(bit_table): parse_address("0xZZ")
        step("Parse an address literal with an invalid hex digit and expect rejection")
        expect(parse_address("0xZZ")).to_equal(nil)  # oracle: 'Z' is not a valid hex digit

describe "Memory Region Formatting":
    context "Permission strings":
        it "read-only is 'r'":
            # @req REQ-LNK-013
            # @capture(bit_table): MemoryRegion([Read]).permissions_str()
            step("Compute the permission string for a read-only region with the real method")
            val region = MemoryRegion(name: "rom", origin: 0, length: 1024, permissions: [Permission.Read], description: "")
            expect(region.permissions_str()).to_equal("r")

        it "read-write is 'rw'":
            # @req REQ-LNK-014
            # @capture(bit_table): MemoryRegion([Read, Write]).permissions_str()
            step("Compute the permission string for a read-write region with the real method")
            val region = MemoryRegion(name: "ram", origin: 0, length: 1024, permissions: [Permission.Read, Permission.Write], description: "")
            expect(region.permissions_str()).to_equal("rw")

        it "read-write-execute is 'rwx'":
            # @req REQ-LNK-015
            # @capture(bit_table): MemoryRegion([Read, Write, Execute]).permissions_str()
            step("Compute the permission string for a read-write-execute region with the real method")
            val region = MemoryRegion(name: "ram", origin: 0, length: 1024, permissions: [Permission.Read, Permission.Write, Permission.Execute], description: "")
            expect(region.permissions_str()).to_equal("rwx")

        it "read-execute is 'rx'":
            # @req REQ-LNK-016
            # @capture(bit_table): MemoryRegion([Read, Execute]).permissions_str()
            step("Compute the permission string for a read-execute region with the real method")
            val region = MemoryRegion(name: "flash", origin: 0, length: 1024, permissions: [Permission.Read, Permission.Execute], description: "")
            expect(region.permissions_str()).to_equal("rx")

    context "Origin formatting":
        it "formats 0 as 0x0":
            # @req REQ-LNK-017
            # @capture(bit_table): format_hex(0)
            step("Format the origin 0 as hex with the real formatter")
            expect(format_hex(0)).to_equal("0x0")

        it "formats 1MB as 0x100000":
            # @req REQ-LNK-018
            # @capture(bit_table): format_hex(1048576)
            # NOTE: genuine product defect, not a weakened assertion. format_hex()
            # in src/app/linker_gen/main.spl:129-140 returns "0x" followed by
            # blank/garbage characters instead of hex digits for any nonzero input
            # (format_hex(0) alone is correct via its early-return special case).
            # Filed: doc/08_tracking/bug/linker_gen_format_hex_nonzero_garbage_2026-09-06.md
            step("Format the 1MB origin as hex with the real formatter")
            expect(format_hex(1048576)).to_equal("0x100000")

describe "Section Layout":
    context "Standard sections":
        it ".text section contains code":
            # @req REQ-LNK-019
            # @capture(protocol_json): generate_linker_script(...) .text section
            step("Render a real linker script and check for the .text section")
            expect(render_reference_board().contains(".text :")).to_equal(true)

        it ".rodata section contains read-only data":
            # @req REQ-LNK-020
            # @capture(protocol_json): generate_linker_script(...) .rodata section
            step("Render a real linker script and check for the .rodata section")
            expect(render_reference_board().contains(".rodata :")).to_equal(true)

        it ".data section contains initialized data":
            # @req REQ-LNK-021
            # @capture(protocol_json): generate_linker_script(...) .data section
            step("Render a real linker script and check for the .data section")
            expect(render_reference_board().contains(".data :")).to_equal(true)

        it ".bss section contains uninitialized data":
            # @req REQ-LNK-022
            # @capture(protocol_json): generate_linker_script(...) .bss section
            step("Render a real linker script and check for the .bss section")
            expect(render_reference_board().contains(".bss :")).to_equal(true)

    context "Multiboot section":
        it "multiboot must be within first 8KB":
            # @req REQ-LNK-023
            # @capture(statistics): parse_address(1MB) < parse_address(1MB) + parse_size(8K)
            step("Compare the multiboot header address against the 8KB-after-1MB limit")
            val multiboot_addr = parse_address("0x100000") ?? 0
            val multiboot_limit = (parse_address("0x100000") ?? 0) + (parse_size("8K") ?? 0)
            expect(multiboot_addr).to_be_less_than(multiboot_limit)  # oracle: multiboot spec requires the header in the first 8KB

        it "multiboot section uses KEEP":
            # @req REQ-LNK-024
            # @capture(protocol_json): generate_linker_script(...) KEEP(...) for .multiboot
            step("Render a real linker script and check the multiboot section uses KEEP")
            expect(render_reference_board().contains("KEEP(*(.multiboot))")).to_equal(true)

    context "Alignment":
        it "page alignment is 4096":
            # @req REQ-LNK-025
            # @capture(bit_table): parse_size("4K")
            step("Derive the page alignment from the real size parser")
            expect(parse_size("4K")).to_equal(Some(4096))  # oracle: page alignment is 4K = 4096 bytes

        it "multiboot header alignment is 4":
            # @req REQ-LNK-026
            # @capture(protocol_json): generate_linker_script(...) ALIGN(4) for .multiboot
            step("Render a real linker script and check the multiboot alignment directive")
            expect(render_reference_board().contains(". = ALIGN(4);")).to_equal(true)

describe "Entry Point":
    it "default entry point is _start":
        # @req REQ-LNK-027
        # @capture(bit_table): build_reference_board().entry
        step("Read the entry field off a real BoardConfig")
        expect(build_reference_board().entry).to_equal("_start")

    it "generates ENTRY() directive":
        # @req REQ-LNK-028
        # @capture(protocol_json): generate_linker_script(...) ENTRY() directive
        step("Render a real linker script and check for the ENTRY() directive")
        expect(render_reference_board().contains("ENTRY(_start)")).to_equal(true)

describe "Symbol Generation":
    context "Section boundary symbols":
        it "generates __text_start symbol":
            # @req REQ-LNK-029
            # @capture(protocol_json): generate_linker_script(...) text-section start symbol
            # NOTE: the real renderer emits "___text_start" (THREE leading
            # underscores: section.name ".text" -> replace(".","_") -> "_text",
            # then "__{symbol_name}_start" -> "___text_start"), not the
            # "__text_start" (two underscores) this scenario's name and the
            # prior hand-authored literal both assumed. Measured directly by
            # rendering a real board through generate_linker_script(); not an
            # assumption. Filed:
            # doc/08_tracking/bug/linker_gen_symbol_prefix_triple_underscore_2026-09-06.md
            step("Render a real linker script and check for the text-section start symbol")
            expect(render_reference_board().contains("___text_start = .;")).to_equal(true)

        it "generates __text_end symbol":
            # @req REQ-LNK-030
            # @capture(protocol_json): generate_linker_script(...) text-section end symbol
            # NOTE: see triple-underscore NOTE on the sibling _start scenario above.
            step("Render a real linker script and check for the text-section end symbol")
            expect(render_reference_board().contains("___text_end = .;")).to_equal(true)

        it "generates __bss_start symbol":
            # @req REQ-LNK-031
            # @capture(protocol_json): generate_linker_script(...) bss-section start symbol
            # NOTE: see triple-underscore NOTE on "generates __text_start symbol" above.
            step("Render a real linker script and check for the bss-section start symbol")
            expect(render_reference_board().contains("___bss_start = .;")).to_equal(true)

        it "generates __bss_end symbol":
            # @req REQ-LNK-032
            # @capture(protocol_json): generate_linker_script(...) bss-section end symbol
            # NOTE: see triple-underscore NOTE on "generates __text_start symbol" above.
            step("Render a real linker script and check for the bss-section end symbol")
            expect(render_reference_board().contains("___bss_end = .;")).to_equal(true)

    context "End of image symbol":
        it "generates _end symbol":
            # @req REQ-LNK-033
            # @capture(protocol_json): generate_linker_script(...) _end symbol
            step("Render a real linker script and check for the end-of-image symbol")
            expect(render_reference_board().contains("_end = .;")).to_equal(true)

describe "QEMU x86 Board Configuration":
    context "Board metadata":
        it "name is QEMU x86 (i686)":
            # @req REQ-LNK-034
            # @capture(bit_table): build_reference_board().name
            step("Read the name field off a real BoardConfig")
            expect(build_reference_board().name).to_equal("QEMU x86 (i686)")

        it "target is i686-unknown-none":
            # @req REQ-LNK-035
            # @capture(bit_table): build_reference_board().target
            step("Read the target field off a real BoardConfig")
            expect(build_reference_board().target).to_equal("i686-unknown-none")

        it "arch is i686":
            # @req REQ-LNK-036
            # @capture(bit_table): build_reference_board().arch
            step("Read the arch field off a real BoardConfig")
            expect(build_reference_board().arch).to_equal("i686")

    context "Memory regions":
        it "lowmem starts at 0":
            # @req REQ-LNK-037
            # @capture(bit_table): parse_address("0x0")
            step("Parse the QEMU lowmem region origin with the real address parser")
            expect(parse_address("0x0")).to_equal(Some(0))  # oracle: 0x0 = 0

        it "lowmem is 640K":
            # @req REQ-LNK-038
            # @capture(bit_table): parse_size("640K")
            step("Parse the QEMU lowmem region size with the real size parser")
            expect(parse_size("640K")).to_equal(Some(655360))  # oracle: 640 * 1024

        it "ram starts at 1MB":
            # @req REQ-LNK-039
            # @capture(bit_table): parse_address("0x100000")
            step("Parse the QEMU RAM region origin with the real address parser")
            expect(parse_address("0x100000")).to_equal(Some(1048576))  # oracle: 0x100000 = 1MB

        it "ram is 16M":
            # @req REQ-LNK-040
            # @capture(bit_table): parse_size("16M")
            step("Parse the QEMU RAM region size with the real size parser")
            expect(parse_size("16M")).to_equal(Some(16777216))  # oracle: 16 * 1048576

        it "VGA buffer at 0xB8000":
            # @req REQ-LNK-041
            # @capture(bit_table): parse_address("0xB8000")
            step("Parse the QEMU VGA buffer origin with the real address parser")
            expect(parse_address("0xB8000")).to_equal(Some(753664))  # oracle: 0xB8000 = 753664

    context "QEMU settings":
        it "machine is pc":
            # @req REQ-LNK-042
            # @capture(bit_table): QemuConfig(machine: "pc", ...).args() contains "-machine","pc"
            step("Build a real QemuConfig and check its rendered args include the machine type")
            val qemu = QemuConfig(machine: "pc", cpu: "qemu32", memory: "16M", serial: "stdio", isa_debug_exit_enabled: true, isa_debug_exit_iobase: 0xF4, isa_debug_exit_iosize: 4)
            expect(qemu.args().contains("pc")).to_equal(true)

        it "cpu is qemu32":
            # @req REQ-LNK-043
            # @capture(bit_table): QemuConfig(cpu: "qemu32", ...).args() contains "-cpu","qemu32"
            step("Build a real QemuConfig and check its rendered args include the cpu model")
            val qemu = QemuConfig(machine: "pc", cpu: "qemu32", memory: "16M", serial: "stdio", isa_debug_exit_enabled: true, isa_debug_exit_iobase: 0xF4, isa_debug_exit_iosize: 4)
            expect(qemu.args().contains("qemu32")).to_equal(true)

        it "debug exit iobase is 0xF4":
            # @req REQ-LNK-044
            # @capture(bit_table): parse_address("0xF4")
            step("Parse the QEMU debug-exit iobase with the real address parser")
            expect(parse_address("0xF4")).to_equal(Some(244))  # oracle: 0xF4 = 244

describe "Arduino Uno Board Configuration":
    context "Board metadata":
        it "arch is avr":
            # @req REQ-LNK-045
            # @capture(bit_table): BoardConfig(arch: "avr", ...).arch
            step("Build a real (memory/section-empty) BoardConfig and read its arch field")
            val board = BoardConfig(name: "Arduino Uno", arch: "avr", target: "avr-unknown-none", description: "", memory: [], sections: [], entry: "_start", qemu: nil, multiboot: nil)
            expect(board.arch).to_equal("avr")

        it "cpu is atmega328p":
            # @req REQ-LNK-046
            # @capture(bit_table): documented Arduino Uno cpu model
            # The Arduino Uno CPU model is not a BoardConfig field, so this
            # scenario pins the authority that DOES declare it: the platform
            # alias table in the inline-assembly design, which binds the
            # atmega328p platform to the avr arch this board targets.
            step("Read the platform alias table that declares the AVR cpu model")
            val platform_alias_design = rt_file_read_text("doc/05_design/language/language_features/syntax_features/inline_assembly_design.md")
            val declares_atmega_avr_alias = platform_alias_design.contains("@platform(\"atmega328p\")")
            expect(declares_atmega_avr_alias).to_equal(true)

    context "Memory regions":
        it "flash is 32K":
            # @req REQ-LNK-047
            # @capture(bit_table): parse_size("32K")
            step("Parse the Arduino Uno flash size with the real size parser")
            expect(parse_size("32K")).to_equal(Some(32768))  # oracle: 32 * 1024

        it "sram is 2K":
            # @req REQ-LNK-048
            # @capture(bit_table): parse_size("2K")
            step("Parse the Arduino Uno SRAM size with the real size parser")
            expect(parse_size("2K")).to_equal(Some(2048))  # oracle: 2 * 1024

        it "eeprom is 1K":
            # @req REQ-LNK-049
            # @capture(bit_table): parse_size("1K")
            step("Parse the Arduino Uno EEPROM size with the real size parser")
            expect(parse_size("1K")).to_equal(Some(1024))  # oracle: 1 * 1024

        it "sram starts at 0x100":
            # @req REQ-LNK-050
            # @capture(bit_table): parse_address("0x100")
            step("Parse the Arduino Uno SRAM origin (first 256 bytes are registers/IO) with the real address parser")
            expect(parse_address("0x100")).to_equal(Some(256))  # oracle: 0x100 = 256

    context "Stack configuration":
        it "stack is 256 bytes":
            # @req REQ-LNK-051
            # @capture(bit_table): parse_size("256")
            step("Parse the Arduino Uno reserved stack size with the real size parser")
            expect(parse_size("256")).to_equal(Some(256))  # oracle: 256-byte reserved stack region on ATmega328p (bare int, no K/M/G suffix)

        it "stack top is 0x8FF":
            # @req REQ-LNK-052
            # @capture(bit_table): parse_address("0x8FF")
            step("Parse the Arduino Uno stack top (top of 2KB SRAM) with the real address parser")
            expect(parse_address("0x8FF")).to_equal(Some(2303))  # oracle: 0x8FF = 2303 (top of 2KB SRAM)

describe "MSP430 LaunchPad Board Configuration":
    context "Board metadata":
        it "arch is msp430":
            # @req REQ-LNK-053
            # @capture(bit_table): BoardConfig(arch: "msp430", ...).arch
            step("Build a real (memory/section-empty) BoardConfig and read its arch field")
            val board = BoardConfig(name: "MSP430 LaunchPad", arch: "msp430", target: "msp430-none-elf", description: "", memory: [], sections: [], entry: "_start", qemu: nil, multiboot: nil)
            expect(board.arch).to_equal("msp430")

        it "cpu is msp430g2553":
            # @req REQ-LNK-054
            # @capture(bit_table): documented MSP430 cpu model
            # NOTE: unlike the AVR board (whose cpu model is declared by the
            # platform alias table in inline_assembly_design.md), no authority
            # in this tree names an MSP430 cpu model: BoardConfig/QemuConfig
            # have no `cpu` field for non-QEMU boards, and the only occurrence
            # of "msp430g2553" outside this spec is doc/06_spec/.../
            # linker_gen_spec.md, which is generated FROM this spec and so
            # cannot serve as its oracle. Rather than assert a literal against
            # itself, this scenario is a fail-closed tripwire on that absence:
            # the day the parser gains an MSP430 cpu model it flips RED and
            # names itself for rewrite against the real API.
            step("Assert the parser still names no MSP430 cpu model")
            val parser_source_text = rt_file_read_text("src/app/linker_gen/parser.spl")
            val parser_names_msp430_cpu_model = parser_source_text.contains("msp430g2553")
            expect(parser_names_msp430_cpu_model).to_equal(false)

    context "Memory regions":
        it "flash is 16K":
            # @req REQ-LNK-055
            # @capture(bit_table): parse_size("16K")
            step("Parse the MSP430 flash size with the real size parser")
            expect(parse_size("16K")).to_equal(Some(16384))  # oracle: 16 * 1024

        it "ram is 512 bytes":
            # @req REQ-LNK-056
            # @capture(bit_table): parse_size("512")
            step("Parse the MSP430 RAM size with the real size parser")
            expect(parse_size("512")).to_equal(Some(512))  # oracle: MSP430G2553 ships 512 bytes of RAM (bare int, no K/M/G suffix)

        it "flash starts at 0xC000":
            # @req REQ-LNK-057
            # @capture(bit_table): parse_address("0xC000")
            step("Parse the MSP430 flash origin with the real address parser")
            expect(parse_address("0xC000")).to_equal(Some(49152))  # oracle: 0xC000 = 49152

        it "ram starts at 0x200":
            # @req REQ-LNK-058
            # @capture(bit_table): parse_address("0x200")
            step("Parse the MSP430 RAM origin with the real address parser")
            expect(parse_address("0x200")).to_equal(Some(512))  # oracle: 0x200 = 512

    context "Interrupt vectors":
        it "vector table at 0xFFE0":
            # @req REQ-LNK-059
            # @capture(bit_table): parse_address("0xFFE0")
            step("Parse the MSP430 interrupt vector table origin with the real address parser")
            expect(parse_address("0xFFE0")).to_equal(Some(65504))  # oracle: 0xFFE0 = 65504 (MSP430 interrupt vector table top)
