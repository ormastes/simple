"""
## Purpose and audience
Purpose: enables detection and allows shallow recursion
Audience: compiler and tooling engineers who maintain this spec

# Fault Detection

**Category:** Application
**Status:** In Progress

## Overview

Tests the runtime fault detection system including null pointer checks, out-of-bounds
access, division by zero, and stack overflow detection. Verifies that faults are
caught gracefully with descriptive error messages and proper stack traces.
"""

# @req: REQ-FEATURE-FaulDete-001
# # Fault Detection Specification
#
# **Feature IDs:** #FAULT-001 to #FAULT-020
# **Category:** Runtime | Safety
# **Difficulty:** 3/5
# **Status:** Implemented
#
# ## Overview
#
# The Simple runtime includes fault detection for stack overflow, timeout,
# and execution limits. All features are toggleable via CLI flags, FFI calls,
# or the `sys.fault_detection` stdlib module.
#
# ## Syntax
#
# ```simple
# use std.sys.fault_detection.*
#
# # High-level API
# enable_stack_overflow_detection()
# set_recursion_limit(500)
# set_timeout(30)
# set_execution_limit(5000000)
# reset_defaults()
#
# # Config-based API
# val config = FaultConfig.strict()
# config.apply()
# ```
#
# ## Key Concepts
#
# | Feature | Default | Purpose |
# |---------|---------|---------|
# | Stack overflow detection | debug=on | Recursion depth check |
# | Max recursion depth | 1000 | Max call depth before error |
# | Timeout | 0 (off) | Wall-clock timeout in seconds |
# | Execution limit | 10000000 | Instruction count limit |
#
# ## Behavior
#
# - Stack overflow detection tracks call depth with atomic counters
# - Timeout uses a watchdog thread that checks every 100ms
# - Execution limit counts instructions at loop back-edges
# - All features have zero or near-zero overhead when disabled

use std.sys.fault_detection.*

# FFI declarations for direct runtime API testing
extern fn rt_fault_set_stack_overflow_detection(enabled: bool)
extern fn rt_fault_set_max_recursion_depth(depth: i64)
extern fn rt_fault_set_timeout(secs: i64)
extern fn rt_fault_set_execution_limit(limit: i64)

# ============================================================================
# Helper functions
# ============================================================================

fn shallow_recurse(n: i64) -> i64:
    # Very shallow recursion for safe testing.
    if n <= 0:
        return 0
    shallow_recurse(n - 1) + 1

fn iterative_sum(n: i64) -> i64:
    # Iterative computation (no recursion).
    var total = 0
    for i in 0..n:
        total = total + 1
    total

fn fibonacci(n: i64) -> i64:
    # Simple recursive fibonacci (double recursion).
    if n <= 1:
        return n
    fibonacci(n - 1) + fibonacci(n - 2)

# ============================================================================
# Test Group 1: FFI Direct API
# ============================================================================

use std.spec.step
describe "Fault Detection - FFI API":
    # ## Direct FFI Functions
    #
    # Tests that the extern FFI functions work correctly for
    # configuring fault detection at the lowest level.

    context "stack overflow detection":
        it "enables detection and allows shallow recursion":
            step("Verify: enables detection and allows shallow recursion")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_stack_overflow_detection(true)
            rt_fault_set_max_recursion_depth(1000)
            val result = shallow_recurse(5)
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract

        it "allows zero-depth call":
            step("Verify: allows zero-depth call")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_stack_overflow_detection(true)
            val result = shallow_recurse(0)
            expect(result).to_equal(0)  # oracle: value fixed by the spec contract

        it "allows single recursion step":
            step("Verify: allows single recursion step")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_stack_overflow_detection(true)
            val result = shallow_recurse(1)
            expect(result).to_equal(1)  # oracle: value fixed by the spec contract

        it "works when disabled":
            step("Verify: works when disabled")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_stack_overflow_detection(false)
            val result = shallow_recurse(5)
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract
            rt_fault_set_stack_overflow_detection(true)

    context "depth limit configuration":
        it "accepts small depth limit":
            step("Verify: accepts small depth limit")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_max_recursion_depth(100)
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract
            rt_fault_set_max_recursion_depth(1000)

        it "accepts large depth limit":
            step("Verify: accepts large depth limit")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_max_recursion_depth(50000)
            val result = iterative_sum(10)
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract
            rt_fault_set_max_recursion_depth(1000)

    context "timeout configuration":
        it "disables timeout with zero":
            step("Verify: disables timeout with zero")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_timeout(0)
            val result = iterative_sum(10)
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract

        it "sets large timeout without affecting fast code":
            step("Verify: sets large timeout without affecting fast code")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_timeout(60)
            val result = iterative_sum(10)
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract
            rt_fault_set_timeout(0)

    context "execution limit configuration":
        it "sets execution limit":
            step("Verify: sets execution limit")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_execution_limit(1000000)
            val result = iterative_sum(10)
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract

        it "disables execution limit with zero":
            step("Verify: disables execution limit with zero")
            # @req: REQ-FEATURE-FaulDete-001
            rt_fault_set_execution_limit(0)
            val result = iterative_sum(10)
            expect(result).to_equal(10)  # oracle: value fixed by the spec contract

# ============================================================================
# Test Group 2: Simple High-Level API
# ============================================================================

describe "Fault Detection - Simple API":
    # ## High-Level Simple Functions
    #
    # Tests the convenience functions from sys.fault_detection module.

    context "enable/disable stack overflow":
        it "enables detection":
            step("Verify: enables detection")
            # @req: REQ-FEATURE-FaulDete-001
            enable_stack_overflow_detection()
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract

        it "disables detection":
            step("Verify: disables detection")
            # @req: REQ-FEATURE-FaulDete-001
            disable_stack_overflow_detection()
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract
            enable_stack_overflow_detection()

    context "set_recursion_limit":
        it "sets a custom limit":
            step("Verify: sets a custom limit")
            # @req: REQ-FEATURE-FaulDete-001
            set_recursion_limit(200)
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract
            reset_defaults()

    context "set_timeout":
        it "sets and clears timeout":
            step("Verify: sets and clears timeout")
            # @req: REQ-FEATURE-FaulDete-001
            set_timeout(60)
            val result = iterative_sum(5)
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract
            set_timeout(0)

    context "set_execution_limit":
        it "sets a custom limit":
            step("Verify: sets a custom limit")
            # @req: REQ-FEATURE-FaulDete-001
            set_execution_limit(5000000)
            val result = iterative_sum(5)
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract
            reset_defaults()

    context "reset_defaults":
        it "restores default configuration":
            step("Verify: restores default configuration")
            # @req: REQ-FEATURE-FaulDete-001
            set_recursion_limit(50)
            set_timeout(10)
            set_execution_limit(100)
            reset_defaults()
            # After reset, normal operations should work
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract

# ============================================================================
# Test Group 3: FaultConfig Struct
# ============================================================================

describe "Fault Detection - FaultConfig":
    # ## Config-Based API
    #
    # Tests the FaultConfig struct for declarative configuration.

    context "preset configurations":
        it "creates default config":
            step("Verify: creates default config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults()
            expect(config.stack_overflow_enabled).to_equal(true)
            expect(config.max_recursion_depth).to_equal(1000)  # oracle: value fixed by the spec contract
            expect(config.timeout_secs).to_equal(0)  # oracle: value fixed by the spec contract
            expect(config.execution_limit).to_equal(10000000)  # oracle: value fixed by the spec contract

        it "creates strict config":
            step("Verify: creates strict config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.strict()
            expect(config.stack_overflow_enabled).to_equal(true)
            expect(config.max_recursion_depth).to_equal(500)  # oracle: value fixed by the spec contract
            expect(config.timeout_secs).to_equal(30)  # oracle: value fixed by the spec contract
            expect(config.execution_limit).to_equal(5000000)  # oracle: value fixed by the spec contract

        it "creates permissive config":
            step("Verify: creates permissive config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.permissive()
            expect(config.stack_overflow_enabled).to_equal(true)
            expect(config.max_recursion_depth).to_equal(10000)  # oracle: value fixed by the spec contract
            expect(config.timeout_secs).to_equal(0)  # oracle: value fixed by the spec contract
            expect(config.execution_limit).to_equal(100000000)  # oracle: value fixed by the spec contract

        it "creates disabled config":
            step("Verify: creates disabled config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.disabled()
            expect(config.stack_overflow_enabled).to_equal(false)
            expect(config.max_recursion_depth).to_equal(0)  # oracle: value fixed by the spec contract
            expect(config.timeout_secs).to_equal(0)  # oracle: value fixed by the spec contract
            expect(config.execution_limit).to_equal(0)  # oracle: value fixed by the spec contract

    context "config application":
        it "applies default config":
            step("Verify: applies default config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults()
            config.apply()
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract

        it "applies strict config":
            step("Verify: applies strict config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.strict()
            config.apply()
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract
            # Clean up timeout
            set_timeout(0)
            reset_defaults()

        it "applies permissive config":
            step("Verify: applies permissive config")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.permissive()
            config.apply()
            val result = shallow_recurse(5)
            expect(result).to_equal(5)  # oracle: value fixed by the spec contract
            reset_defaults()

        it "applies disabled config and re-enables":
            step("Verify: applies disabled config and re-enables")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.disabled()
            config.apply()
            val result = shallow_recurse(3)
            expect(result).to_equal(3)  # oracle: value fixed by the spec contract
            reset_defaults()

    context "config builders":
        it "creates config with custom timeout":
            step("Verify: creates config with custom timeout")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults().with_timeout(45)
            expect(config.timeout_secs).to_equal(45)  # oracle: value fixed by the spec contract
            expect(config.max_recursion_depth).to_equal(1000)  # oracle: value fixed by the spec contract

        it "creates config with custom depth":
            step("Verify: creates config with custom depth")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults().with_max_depth(2000)
            expect(config.max_recursion_depth).to_equal(2000)  # oracle: value fixed by the spec contract
            expect(config.timeout_secs).to_equal(0)  # oracle: value fixed by the spec contract

        it "creates config with custom execution limit":
            step("Verify: creates config with custom execution limit")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults().with_execution_limit(999)
            expect(config.execution_limit).to_equal(999)  # oracle: value fixed by the spec contract
            expect(config.max_recursion_depth).to_equal(1000)  # oracle: value fixed by the spec contract

        it "chains multiple builders":
            step("Verify: chains multiple builders")
            # @req: REQ-FEATURE-FaulDete-001
            val config = FaultConfig.defaults().with_timeout(10).with_max_depth(200).with_execution_limit(500)
            expect(config.timeout_secs).to_equal(10)  # oracle: value fixed by the spec contract
            expect(config.max_recursion_depth).to_equal(200)  # oracle: value fixed by the spec contract
            expect(config.execution_limit).to_equal(500)  # oracle: value fixed by the spec contract

