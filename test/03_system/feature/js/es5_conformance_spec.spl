# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# ES5 ECMAScript Conformance Tests
# @cover src/lib/nogc_sync_mut/js/engine/interpreter.spl

use std.spec.step

use std.js.engine.js_error.{Logger, LogLevel}
use std.js.engine.parser.{JsParser}
use std.nogc_sync_mut.js.engine.interpreter.{JsInterpreter}
use std.js.types.js_types.{JsValue}


fn _run_js(source: text) -> text:
    """Helper: parse and execute JS, return string result."""
    val logger = Logger(level: LogLevel.Error)
    val parser = JsParser.new(source, logger)
    val program = parser.parse_program()
    match program:
        Ok(stmts):
            val interp = JsInterpreter.new(logger)
            val result = interp.execute(stmts)
            match result:
                Ok(value):
                    return _display(value)
                Err(e):
                    return "Error: {e.message}"
        Err(e):
            return "SyntaxError: {e.message}"

fn _display(v: JsValue) -> text:
    match v:
        JsValue.Undefined: "undefined"
        JsValue.Null: "null"
        JsValue.Boolean(b): if b: "true" else: "false"
        JsValue.Number(n):
            var s = "{n}"
            if s.ends_with(".0"):
                s = s.slice(0, s.len() - 2)
            s
        JsValue.String(s): s
        JsValue.Object(id): "[object Object]"
        JsValue.Array(id): "[object Array]"
        JsValue.Function(id): "[Function]"
        JsValue.Symbol(id): "Symbol()"

describe "ES5 Conformance":
    # @manual scenario evidence
    describe "Types and typeof":
        it "typeof undefined":
            # @req REQ-SSPEC-SYSTEM
            step("typeof undefined")
            expect(_run_js("typeof undefined")).to_equal("undefined")
        it "typeof null returns object":
            # @req REQ-SSPEC-SYSTEM
            step("typeof null returns object")
            expect(_run_js("typeof null")).to_equal("object")
        it "typeof number":
            # @req REQ-SSPEC-SYSTEM
            step("typeof number")
            expect(_run_js("typeof 42")).to_equal("number")
        it "typeof string":
            # @req REQ-SSPEC-SYSTEM
            step("typeof string")
            expect(_run_js("typeof 'hello'")).to_equal("string")
        it "typeof boolean":
            # @req REQ-SSPEC-SYSTEM
            step("typeof boolean")
            expect(_run_js("typeof true")).to_equal("boolean")
        it "typeof function":
            # @req REQ-SSPEC-SYSTEM
            step("typeof function")
            expect(_run_js("typeof function(){}")).to_equal("function")

    describe "Arithmetic":
        it "addition":
            # @req REQ-SSPEC-SYSTEM
            step("addition")
            expect(_run_js("1 + 2")).to_equal("3")
        it "subtraction":
            # @req REQ-SSPEC-SYSTEM
            step("subtraction")
            expect(_run_js("10 - 3")).to_equal("7")
        it "multiplication":
            # @req REQ-SSPEC-SYSTEM
            step("multiplication")
            expect(_run_js("6 * 7")).to_equal("42")
        it "division":
            # @req REQ-SSPEC-SYSTEM
            step("division")
            expect(_run_js("15 / 3")).to_equal("5")
        it "modulo":
            # @req REQ-SSPEC-SYSTEM
            step("modulo")
            expect(_run_js("10 % 3")).to_equal("1")
        it "exponentiation":
            # @req REQ-SSPEC-SYSTEM
            step("exponentiation")
            expect(_run_js("2 ** 10")).to_equal("1024")
        it "unary minus":
            # @req REQ-SSPEC-SYSTEM
            step("unary minus")
            expect(_run_js("-5")).to_equal("-5")
        it "unary plus":
            # @req REQ-SSPEC-SYSTEM
            step("unary plus")
            expect(_run_js("+'3'")).to_equal("3")
        it "increment":
            # @req REQ-SSPEC-SYSTEM
            step("increment")
            expect(_run_js("var x=5; ++x")).to_equal("6")

    describe "String operations":
        it "concatenation":
            # @req REQ-SSPEC-SYSTEM
            step("concatenation")
            expect(_run_js("'hello' + ' ' + 'world'")).to_equal("hello world")
        it "string + number":
            # @req REQ-SSPEC-SYSTEM
            step("string + number")
            expect(_run_js("'count: ' + 5")).to_equal("count: 5")
        it "string length":
            # @req REQ-SSPEC-SYSTEM
            step("string length")
            expect(_run_js("'test'.length")).to_equal("4")

    describe "Type coercion":
        it "null == undefined":
            # @req REQ-SSPEC-SYSTEM
            step("null == undefined")
            expect(_run_js("null == undefined")).to_equal("true")
        it "null !== undefined":
            # @req REQ-SSPEC-SYSTEM
            step("null !== undefined")
            expect(_run_js("null === undefined")).to_equal("false")
        it "boolean to number":
            # @req REQ-SSPEC-SYSTEM
            step("boolean to number")
            expect(_run_js("true + 1")).to_equal("2")
        it "empty string is falsy":
            # @req REQ-SSPEC-SYSTEM
            step("empty string is falsy")
            expect(_run_js("!''")).to_equal("true")
        it "0 is falsy":
            # @req REQ-SSPEC-SYSTEM
            step("0 is falsy")
            expect(_run_js("!0")).to_equal("true")

    describe "Comparison":
        it "strict equality":
            # @req REQ-SSPEC-SYSTEM
            step("strict equality")
            expect(_run_js("1 === 1")).to_equal("true")
        it "strict inequality":
            # @req REQ-SSPEC-SYSTEM
            step("strict inequality")
            expect(_run_js("1 === '1'")).to_equal("false")
        it "abstract equality coercion":
            # @req REQ-SSPEC-SYSTEM
            step("abstract equality coercion")
            expect(_run_js("1 == '1'")).to_equal("true")
        it "less than":
            # @req REQ-SSPEC-SYSTEM
            step("less than")
            expect(_run_js("3 < 5")).to_equal("true")
        it "greater than":
            # @req REQ-SSPEC-SYSTEM
            step("greater than")
            expect(_run_js("5 > 3")).to_equal("true")

    describe "Logical operators":
        it "and short circuit":
            # @req REQ-SSPEC-SYSTEM
            step("and short circuit")
            expect(_run_js("true && 42")).to_equal("42")
        it "or short circuit":
            # @req REQ-SSPEC-SYSTEM
            step("or short circuit")
            expect(_run_js("false || 'hello'")).to_equal("hello")
        it "not":
            # @req REQ-SSPEC-SYSTEM
            step("not")
            expect(_run_js("!false")).to_equal("true")

    describe "Variables":
        it "var declaration":
            # @req REQ-SSPEC-SYSTEM
            step("var declaration")
            expect(_run_js("var x = 10; x")).to_equal("10")
        it "assignment":
            # @req REQ-SSPEC-SYSTEM
            step("assignment")
            expect(_run_js("var x = 1; x = 5; x")).to_equal("5")
        it "multiple vars":
            # @req REQ-SSPEC-SYSTEM
            step("multiple vars")
            expect(_run_js("var a = 1; var b = 2; a + b")).to_equal("3")

    describe "Control flow":
        it "if true":
            # @req REQ-SSPEC-SYSTEM
            step("if true")
            expect(_run_js("var r; if (true) { r = 'yes'; } else { r = 'no'; } r")).to_equal("yes")
        it "if false":
            # @req REQ-SSPEC-SYSTEM
            step("if false")
            expect(_run_js("var r; if (false) { r = 'yes'; } else { r = 'no'; } r")).to_equal("no")
        it "while loop":
            # @req REQ-SSPEC-SYSTEM
            step("while loop")
            expect(_run_js("var i=0; while(i<3){i=i+1;} i")).to_equal("3")
        it "for loop":
            # @req REQ-SSPEC-SYSTEM
            step("for loop")
            expect(_run_js("var s=0; for(var i=0;i<5;i=i+1){s=s+i;} s")).to_equal("10")
        it "ternary":
            # @req REQ-SSPEC-SYSTEM
            step("ternary")
            expect(_run_js("true ? 'a' : 'b'")).to_equal("a")
        it "switch":
            # @req REQ-SSPEC-SYSTEM
            step("switch")
            expect(_run_js("var r; switch(2){case 1:r='a';break;case 2:r='b';break;default:r='c';} r")).to_equal("b")

    describe "Functions":
        it "declaration and call":
            # @req REQ-SSPEC-SYSTEM
            step("declaration and call")
            expect(_run_js("function f(x){return x*2;} f(5)")).to_equal("10")
        it "multiple params":
            # @req REQ-SSPEC-SYSTEM
            step("multiple params")
            expect(_run_js("function add(a,b){return a+b;} add(3,4)")).to_equal("7")
        it "closure":
            # @req REQ-SSPEC-SYSTEM
            step("closure")
            expect(_run_js("function f(){var x=10;return function(){return x;};} f()()")).to_equal("10")
        it "arguments.length":
            # @req REQ-SSPEC-SYSTEM
            step("arguments.length")
            expect(_run_js("function f(){return arguments.length;} f(1,2,3)")).to_equal("3")
        it "recursion":
            # @req REQ-SSPEC-SYSTEM
            step("recursion")
            expect(_run_js("function fib(n){if(n<=1)return n;return fib(n-1)+fib(n-2);} fib(6)")).to_equal("8")

    describe "Objects":
        it "object literal":
            # @req REQ-SSPEC-SYSTEM
            step("object literal")
            expect(_run_js("var o={a:1,b:2}; o.a+o.b")).to_equal("3")
        it "property assignment":
            # @req REQ-SSPEC-SYSTEM
            step("property assignment")
            expect(_run_js("var o={}; o.x=42; o.x")).to_equal("42")
        it "in operator":
            expect(_run_js("'a' in {a:1}")).to_equal("true")
        it "delete":
            expect(_run_js("var o={a:1}; delete o.a; typeof o.a")).to_equal("undefined")

    describe "Arrays":
        it "array literal":
            # @req REQ-SSPEC-SYSTEM
            step("array literal")
            expect(_run_js("[1,2,3].length")).to_equal("3")
        it "index access":
            # @req REQ-SSPEC-SYSTEM
            step("index access")
            expect(_run_js("var a=[10,20,30]; a[1]")).to_equal("20")

    describe "Error handling":
        it "try-catch":
            # @req REQ-SSPEC-SYSTEM
            step("try-catch")
            expect(_run_js("try{throw 'err';}catch(e){e}")).to_equal("err")
        it "try-finally":
            # @req REQ-SSPEC-SYSTEM
            step("try-finally")
            expect(_run_js("var x=0; try{x=1;}finally{x=2;} x")).to_equal("2")

    describe "Void and typeof":
        it "void operator":
            # @req REQ-SSPEC-SYSTEM
            step("void operator")
            expect(_run_js("typeof void 0")).to_equal("undefined")
