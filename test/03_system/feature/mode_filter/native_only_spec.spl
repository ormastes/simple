"""
## Purpose and audience
Pins the `# @mode: native` annotation contract: this spec declares
native-only execution and must be discovered, executed, and reported by the
runner's mode filter instead of being silently dropped. Audience: test-runner
and codegen engineers verifying mode-filtered spec handling.
## Operator workflow
Run the spec directly and expect one executed, passing example:
./src/compiler_rust/target/bootstrap/simple run test/03_system/feature/mode_filter/native_only_spec.spl
## Compatibility and limitations
The scenario asserts a stdlib product call rather than a literal
self-comparison, so the pass is a real executed oracle. The annotation
governs discovery and filtering; the assertion itself runs in both
interpreter and native modes.
## Verification guidance and troubleshooting
A healthy run reports outcome=OK, executed=1, passed=1. A drop to
executed=0 means the mode filter skipped the file — check the
`# @mode: native` annotation and the runner's mode-filter discovery path.
"""
# Lifecycle: doc/01_research/infra/sspec/modern_sspec_typed_evidence_research_2026-08-08.md ;
# doc/03_plan/infra/testing/sspec_prevention_mock_plan_2026-08-07.md ;
# doc/04_architecture/test/00_test_architecture.md ;
# doc/05_design/infra/test_runner/unstable_mode_scope_finding_2026-08-17.md
# @mode: native

use std.spec.step
use std.spec.*
use std.math.{abs_i64}

# @manual_section: native-only mode filter
describe "Native-only features":
    it "runs a stdlib product call under the native-only mode filter":
        # @req REQ-SSPEC-SYSTEM
        # @capture(statistics): executed-example count proving mode-filtered discovery
        step("evaluate std.math.abs_i64 on a negative input while the file declares native-only mode")
        val magnitude = abs_i64(-42)
        expect(magnitude).to_equal(42)  # oracle: std.math.abs_i64(-42) is pinned to 42
