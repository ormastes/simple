# System test: Simple web browser rendered headless in Docker over the
# Vulkan backend (lavapipe). Drives
# scripts/check/check-simple-web-browser-docker-vulkan.shs and asserts its
# fail-closed verdict line. Availability-guarded on docker and on a
# vulkan-featured seed binary (the deployed seed lacks the vulkan feature —
# see doc/08_tracking/bug/browser_has_no_vulkan_render_lane_2026-08-15.md).
use std.spec.{describe, it, expect}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

fn docker_usable() -> bool:
    val (stdout, stderr, code) = rt_process_run("docker", ["info"])
    code == 0

fn vulkan_seed_path() -> text:
    "build/browser-vulkan/simple"

describe "browser in docker over Vulkan (lavapipe)":
    it "renders a page through the browser lane and reads it back from a Vulkan device in a container":
        if not docker_usable():
            print "SKIP: docker not available"
            return
        if not rt_file_exists(vulkan_seed_path()):
            print "SKIP: vulkan-featured seed not built at {vulkan_seed_path()} (see check script header)"
            return
        if not rt_file_exists("scripts/check/check-simple-web-browser-docker-vulkan.shs"):
            print "SKIP: check script missing"
            return
        val (stdout, stderr, code) = rt_process_run("sh", ["scripts/check/check-simple-web-browser-docker-vulkan.shs"])
        # Verdict is the last stdout line; PASS exit 0 / FAIL 1 / ERROR 2.
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS — ")
        expect(stdout).to_contain("read back on Vulkan (lavapipe)")
