# System test: Simple web browser rendered headless in Docker over the
# Vulkan backend (lavapipe). Drives
# scripts/check/check-simple-web-browser-docker-vulkan.shs and asserts its
# fail-closed verdict line. Missing Docker or a qualified Vulkan-capable
# pure-Simple self-hosted CLI is an untested/error verdict, never a pass.
use std.spec.{describe, it, expect}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "browser in docker over Vulkan (lavapipe)":
    it "renders a page through the browser lane and reads it back from a Vulkan device in a container":
        val (stdout, stderr, code) = rt_process_run("sh", ["scripts/check/check-simple-web-browser-docker-vulkan.shs"])
        # Verdict is the last stdout line; PASS exit 0 / FAIL 1 /
        # untested ERROR 2. Every nonzero result fails this spec.
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS — ")
        expect(stdout).to_contain("read back on Vulkan (lavapipe)")
