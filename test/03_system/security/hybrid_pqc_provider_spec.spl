# @cover src/lib/common/crypto/x25519_mlkem768/protocol_profile.spl 0%
# @req REQ-009 REQ-010 REQ-011 REQ-012 NFR-001 NFR-002 NFR-006 NFR-009

"""Pure-Simple X25519 plus ML-KEM-768 hybrid provider acceptance."""

use std.spec.*
use lib.common.crypto.x25519_mlkem768.protocol_profile.{
    X25519MlKem768ProtocolPolicy,
    x25519_mlkem768_tls13_protocol_profile,
    x25519_mlkem768_ssh2_protocol_profile,
    x25519_mlkem768_validate_protocol_profile,
    x25519_mlkem768_validate_protocol_policy,
    x25519_mlkem768_validate_protocol_admission
}
use os.tls13.hybrid_negotiation_policy.{
    tls13_admit_x25519_mlkem768_selection,
    tls13_reject_retry_after_x25519_mlkem768_failure
}
use os.crypto.x25519_mlkem768.self_test.{
    x25519_mlkem768_pure_simple_self_test
}
use lib.common.crypto.x25519_mlkem768.contract.{
    X25519MlKem768Backend, X25519MlKem768SelectionMode,
    X25519MlKem768VerificationPolicy, X25519MlKem768Config,
    X25519_MLKEM768_IMPLEMENTATION_VERSION,
    X25519_MLKEM768_PROFILE_VERSION
}
use os.crypto.x25519_mlkem768.execution_policy.{
    x25519_mlkem768_resolve_backend
}
use std.sffi.io.{file_read_text}

fn required_hybrid_policy() -> X25519MlKem768ProtocolPolicy:
    X25519MlKem768ProtocolPolicy(require_hybrid: true,
        authentication_enabled: true, aead_enabled: true,
        allow_classical_retry_after_hybrid_failure: false)

fn check_fail_closed():
    fail("UNRESOLVED ORACLE: ML-KEM implicit rejection malformed input and downgrade corpus")

fn check_interop_oracle():
    fail("UNRESOLVED ORACLE: independent X25519 ML-KEM-768 hybrid implementation")

fn check_pure_simple_ownership():
    fail("UNRESOLVED ORACLE: pure-Simple X25519 ML-KEM and transcript orchestration audit")

fn check_gpu_admission():
    val receipt = file_read_text(
        "build/evidence/x25519mlkem768/cuda/cuda_ntt_perf_receipt.txt")
    expect(receipt).to_contain("CUDA_NTT_PERF_DRIVER cuda_driver_version=13000 device_count=2")
    expect(receipt).to_contain(
        "backend=cuda device=0 name=NVIDIA RTX A6000 capability=8.6 compile=1 forward=1 inverse=1 submit=1 complete=1 readback=1 oracle_match=1")
    expect(receipt).to_contain(
        "backend=cuda device=1 name=NVIDIA TITAN RTX capability=7.5 compile=1 forward=1 inverse=1 submit=1 complete=1 readback=1 oracle_match=1")
    expect(receipt).to_contain(
        "backend=cuda device=0 capability=8.6 samples=30 canonical_minimum_speedup_milli=1250 minimum_speedup_milli=1250 first_gpu_win_batch=3 promotion_batch=3 promotion_supported_max_batch=1024 sustained_promotion=true")
    expect(receipt).to_contain(
        "backend=cuda device=1 capability=7.5 samples=30 canonical_minimum_speedup_milli=1250 minimum_speedup_milli=1250 first_gpu_win_batch=8 promotion_batch=8 promotion_supported_max_batch=1024 sustained_promotion=true")
    expect(receipt).to_contain(
        "CUDA_NTT_PERF_GAPS pure_simple=false inverse_perf=false full_mlkem=false rss=false")
    expect(receipt).to_contain("production_promotion=false")

fn check_cpu_fallback_selected():
    val config = X25519MlKem768Config(
        implementation_version: X25519_MLKEM768_IMPLEMENTATION_VERSION,
        profile_version: X25519_MLKEM768_PROFILE_VERSION,
        requested_backend: X25519MlKem768Backend.Cuda,
        selection_mode: X25519MlKem768SelectionMode.Suggest,
        verification_policy: X25519MlKem768VerificationPolicy.AbsoluteAndScalar,
        minimum_batch: 3, batch_size: 3)
    val result = x25519_mlkem768_resolve_backend(config, "ntt-forward")
    expect(result.is_ok()).to_equal(true)
    val evidence = match result:
        case Ok(value): value
        case Err(reason):
            fail(reason)
            return
    expect(evidence.selected_backend).to_equal(X25519MlKem768Backend.ScalarCpu)
    expect(evidence.fallback_used).to_equal(true)
    expect(evidence.fallback_reason).to_equal(
        "requested specialized backend is not promoted")

describe "hybrid post-quantum provider":
    describe "REQ-009: pinned TLS and SSH hybrid profiles":
        it "should pin wire lengths ordering authentication AEAD and combiners":
            step("Validate pinned hybrid protocol profiles")
            val tls = x25519_mlkem768_tls13_protocol_profile()
            val ssh = x25519_mlkem768_ssh2_protocol_profile()
            val policy = required_hybrid_policy()
            expect(x25519_mlkem768_validate_protocol_profile(tls).is_ok()).to_equal(true)
            expect(x25519_mlkem768_validate_protocol_profile(ssh).is_ok()).to_equal(true)
            expect(x25519_mlkem768_validate_protocol_policy(policy).is_ok()).to_equal(true)
            expect(tls.named_group).to_equal(0x11EC)
            expect(tls.client_share_bytes).to_equal(1216)
            expect(tls.server_share_bytes).to_equal(1120)
            expect(tls.combined_secret_bytes).to_equal(64)
            expect(ssh.algorithm_name).to_equal("mlkem768x25519-sha256")
            expect(ssh.combined_secret_bytes).to_equal(32)
            expect(tls.secret_component_order).to_equal(
                "mlkem768-shared-secret||x25519-shared-secret")

        it "should reject wrong share lengths and unauthenticated policy":
            step("Reject malformed, unauthenticated, downgraded, or replayed input")
            val tls = x25519_mlkem768_tls13_protocol_profile()
            val policy = required_hybrid_policy()
            expect(x25519_mlkem768_validate_protocol_admission(
                tls, policy, 1216, 1120).is_ok()).to_equal(true)
            expect(x25519_mlkem768_validate_protocol_admission(
                tls, policy, 1215, 1120).is_err()).to_equal(true)
            val unauthenticated = X25519MlKem768ProtocolPolicy(
                require_hybrid: true, authentication_enabled: false,
                aead_enabled: true,
                allow_classical_retry_after_hybrid_failure: false)
            expect(x25519_mlkem768_validate_protocol_policy(
                unauthenticated).is_err()).to_equal(true)
            expect(tls13_admit_x25519_mlkem768_selection(
                tls, policy, 0x11ECu16).is_ok()).to_equal(true)
            expect(tls13_admit_x25519_mlkem768_selection(
                tls, policy, 0x001Du16).is_err()).to_equal(true)
            expect(tls13_reject_retry_after_x25519_mlkem768_failure(
                tls, policy, "decapsulation rejected").is_err()).to_equal(true)

    describe "REQ-009 REQ-010: pinned pure-Simple hybrid establishment":
        it "should match the pinned ML-KEM-768 oracle exchange":
            step("Exercise the pinned pure-Simple ML-KEM oracle")
            val result = x25519_mlkem768_pure_simple_self_test()
            expect(result.is_ok()).to_equal(true)
            val receipt = match result:
                case Ok(value): value
                case Err(reason):
                    fail(reason)
                    return
            expect(receipt.encapsulation_key_bytes).to_equal(1184)
            expect(receipt.decapsulation_key_bytes).to_equal(2400)
            expect(receipt.ciphertext_bytes).to_equal(1088)
            expect(receipt.shared_secret_bytes).to_equal(32)
            expect(receipt.encapsulation_key_sha256).to_equal(
                "c45a699a9efcb1a799578ce95f24b063b0b9ddc0879afdb3967fd9e1e3e8c247")
            expect(receipt.decapsulation_key_sha256).to_equal(
                "1dc4ab0188bfd90b41bbd91884e40a41ccd0f46e5d3754b615373c9656f6af39")
            expect(receipt.ciphertext_sha256).to_equal(
                "0b99b2af81971943e4ef6e6f17f42be4f3caa9fea18da0f63df1d43639a74743")
            expect(receipt.shared_secret_sha256).to_equal(
                "340f07be0ffe3d996f44bb05f10eecaca6f494c77a3c353cb1872cacb834f596")

        it "should match an independent hybrid protocol implementation":
            step("Exercise the independent interoperability oracle")
            check_interop_oracle()
            check_pure_simple_ownership()

        it "should reject malformed downgraded and invalid decapsulation inputs":
            step("Reject malformed, unauthenticated, downgraded, or replayed input")
            check_fail_closed()

    describe "REQ-011 REQ-012: accelerator admission":
        it "should select GPU only after physical parity and measured crossover evidence":
            step("Compare CPU, SIMD, and physical-GPU providers")
            check_gpu_admission()
            step("Keep CPU selected when accelerator admission fails")
            check_cpu_fallback_selected()
