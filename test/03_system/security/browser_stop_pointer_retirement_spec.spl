# @req: REQ-SECURITY-BROWSER-STOP-001


# codex-system-test
# @req REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-009 REQ-WEB-BROWSER-014 REQ-WEB-BROWSER-018 REQ-WEB-BROWSER-021
# @evidence-display: links
"""# Hosted Stop pointer retirement

Proves that deferred Stop activation preserves the committed page and retained
resources while retiring pointer ownership in both hosted parent and worker.
A release from the pre-Stop press is rejected before it can emit pointer-up or
reach the worker click path.
"""

use std.spec.*
use std.common.gpu.simpleos_host_gpu_draw_ir.{
    SimpleOsHostGpuImageResource
}
use std.common.web.browser_renderer_protocol.{
    browser_renderer_decoder_feed,
    browser_renderer_decoder_new,
    browser_renderer_navigation_decode
}
use os.hosted.hosted_browser_renderer_process.{
    HostedBrowserRendererProcess
}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession
}

class HostedStopPressedFixture:
    parent: HostedBrowserRendererProcess
    worker: HostedBrowserRendererWorkerSession
    stop_wire: text
    committed_url: text
    committed_html: text

fn _retained_stop_image() -> SimpleOsHostGpuImageResource:
    SimpleOsHostGpuImageResource(
        image_uri: "https://stop.test/committed.png",
        width: 1,
        height: 1,
        pixels: [0xFF224466u32],
        pixel_checksum: 1
    )

fn setup_hosted_stop_pressed_fixture() -> HostedStopPressedFixture:
    var parent = HostedBrowserRendererProcess.create(17, 96, 64)
    parent.state = "active"
    parent.document_url = "https://stop.test/committed"
    parent.document_origin = "https://stop.test"
    parent.retained_image_resources = [_retained_stop_image()]
    parent.pointer_pressed = true
    parent.pending_pointer_cancel_event_id = 41
    parent.command_deadline_ms = 9000000000000
    parent.pending_operation = "navigation"
    parent.pending_wire = "partially-written-navigation"
    parent.pending_wire_offset = 1
    parent.pending_wire_reply_to_request_id = 2
    parent.pending_wire_is_command = true

    var worker = HostedBrowserRendererWorkerSession.create(96, 64)
    val committed_html = "<button id='held'>Committed</button>"
    val opened = worker.browser.open_html(
        "https://stop.test/committed", committed_html
    )
    expect(opened.is_ok()).to_be(true)
    val loading = worker.browser.begin_network_navigation(
        "https://stop.test/pending", "GET", "", "", ""
    )
    expect(loading.is_ok()).to_be(true)
    worker.pressed_target_id = "held"
    worker.pressed_pointer_default_prevented = true
    worker.pressed_chrome_control = "content"
    worker.chrome_focus = "content"

    HostedStopPressedFixture(
        parent: parent,
        worker: worker,
        stop_wire: "",
        committed_url: "https://stop.test/committed",
        committed_html: committed_html
    )

fn submit_stop_with_pressed_pointer(fixture: HostedStopPressedFixture):
    val scheduled = fixture.parent.begin_stop(1000)
    expect(scheduled.is_ok()).to_be(true)
    expect(scheduled.unwrap()).to_be(true)
    expect(fixture.parent.stop_after_write).to_be(true)
    expect(fixture.parent.pointer_pressed).to_be(true)
    expect(fixture.parent.pending_pointer_cancel_event_id).to_equal(41)  # oracle: 41 — pinned expected value for this behavior

    fixture.parent.expected_reply_to_request_id = 2
    fixture.parent.next_request_id = 3
    fixture.parent.pending_wire = ""
    fixture.parent.pending_wire_offset = 0
    fixture.parent.pending_wire_reply_to_request_id = 0
    fixture.parent.pending_wire_is_command = false
    expect(fixture.parent._begin_stop_after_write()).to_equal("")
    expect(fixture.parent.stop_after_write).to_be(false)
    expect(fixture.parent.pending_operation).to_equal("stop")
    expect(fixture.parent.pointer_pressed).to_be(false)
    expect(fixture.parent.pending_pointer_cancel_event_id).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    fixture.stop_wire = fixture.parent.pending_wire

fn complete_hosted_stop(fixture: HostedStopPressedFixture):
    val decoded = browser_renderer_decoder_feed(
        browser_renderer_decoder_new(17), fixture.stop_wire
    )
    expect(decoded.status).to_equal("message")
    expect(browser_renderer_navigation_decode(
        decoded.message
    ).action).to_equal("stop")
    expect(fixture.worker._dispatch_navigation(
        decoded.message
    )).to_equal("")
    expect(fixture.worker.pressed_target_id).to_equal("")
    expect(fixture.worker.pressed_pointer_default_prevented).to_be(false)
    expect(fixture.worker.pressed_chrome_control).to_equal("")
    expect(fixture.worker.chrome_focus).to_equal("")
    expect(fixture.worker.browser.current_url).to_equal(
        fixture.committed_url
    )
    expect(fixture.worker.browser.source_html).to_equal(
        fixture.committed_html
    )

fn check_stop_retires_pointer_state(fixture: HostedStopPressedFixture):
    expect(fixture.parent.document_url).to_equal(fixture.committed_url)
    expect(fixture.parent.retained_image_resources.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    val stop_wire = fixture.parent.pending_wire
    val next_request_id = fixture.parent.next_request_id
    val stale_release = fixture.parent.begin_pointer(
        42, 12, 9, false, 1000
    )
    expect(stale_release.is_err()).to_be(true)
    expect(stale_release.unwrap_err()).to_equal(
        "pointer-release-target-mismatch"
    )
    expect(fixture.parent.pending_wire).to_equal(stop_wire)
    expect(fixture.parent.next_request_id).to_equal(next_request_id)
    expect(fixture.worker.pressed_target_id).to_equal("")

use std.spec.step

describe "Hosted Stop pointer retirement":
    it "should reject a pre-Stop release without losing committed content":
        # @req: REQ-SECURITY-BROWSER-STOP-001
        step("Verify: should reject a pre-Stop release without losing committed content")
        step("Prime a completed content pointer press")
        val fixture = setup_hosted_stop_pressed_fixture()

        step("Dispatch Stop through the hosted parent")
        submit_stop_with_pressed_pointer(fixture)

        step("Acknowledge Stop in the renderer worker")
        complete_hosted_stop(fixture)

        step("Reject the stale post-Stop release")
        check_stop_retires_pointer_state(fixture)
