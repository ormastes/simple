# @req: REQ-SECURITY-BROWSER-RENDERER-001


# codex-system-test
# @req REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-010 REQ-WEB-BROWSER-012 REQ-WEB-BROWSER-021
# @evidence-display: links
"""# Browser renderer script MIME boundary

Exercises final classic-script and module responses through the real
capability-bound SBR2 worker boundary. Rejected response bodies must not gain
script, cache, redirect-alias, DOM, global, or cookie authority.
"""

use std.spec.*
use common.web.browser_renderer_protocol.{
    BrowserRendererCapabilityMessage,
    browser_renderer_capability_bind_encoded,
    browser_renderer_capability_decoder_feed,
    browser_renderer_capability_decoder_new,
    browser_renderer_capability_payload_message,
    browser_renderer_fetch_request_decode,
    browser_renderer_network_response_encode
}
use std.gc_async_mut.web.browser_session.{BrowserRequest}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.js.types.js_types.{JsValue}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession
}

class ScriptMimeBoundaryFixture:
    worker: HostedBrowserRendererWorkerSession
    request: BrowserRequest
    capability: text
    root_request_id: i64

fn make_script_mime_boundary_fixture(
    module_script: bool = false
) -> ScriptMimeBoundaryFixture:
    var worker = HostedBrowserRendererWorkerSession.create(96, 48)
    val script_tag = if module_script:
        "<script type='module' src='/entry.js'></script>"
    else:
        "<script src='/entry.js'></script>"
    expect(worker.browser.open_html(
        "https://mime.test/index.html",
        "<main id='mime-safe'>safe</main>{script_tag}"
    ).is_ok()).to_be(true)
    val request = match worker.browser.take_pending_request():
        nil: fail("expected an external script request")
        Some(value): value
    val capability = "11111111111111111111111111111111"
    worker.active_root_command_request_id = 1
    worker.active_command_capability = capability
    ScriptMimeBoundaryFixture(
        worker: worker,
        request: request,
        capability: capability,
        root_request_id: 1
    )

fn encode_script_mime_network_response(
    fixture: ScriptMimeBoundaryFixture,
    status: i32,
    headers: text,
    body: text
) -> BrowserRendererCapabilityMessage:
    val legacy = browser_renderer_network_response_encode(
        7, fixture.worker.expected_request_id,
        fixture.request.id, fixture.request.kind, fixture.request.url,
        status, headers, body, ""
    )
    expect(legacy.ok).to_be(true)
    val bound = browser_renderer_capability_bind_encoded(
        legacy, 7, fixture.worker.expected_request_id,
        fixture.root_request_id, fixture.capability
    )
    expect(bound.ok).to_be(true)
    expect(bound.wire).to_start_with("SBR2\t")
    val decoded = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(7), bound.wire
    )
    expect(decoded.status).to_equal("message")
    decoded.message

fn accept_script_mime_network_response(
    fixture: ScriptMimeBoundaryFixture,
    message: BrowserRendererCapabilityMessage
):
    val accepted = fixture.worker.handle(message)
    expect(accepted.ok).to_be(true)
    val decoded = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(7), accepted.wire
    )
    if decoded.status == "message":
        val payload = browser_renderer_capability_payload_message(
            decoded.message
        )
        if payload.kind == "fetch_request":
            val fetch = browser_renderer_fetch_request_decode(payload)
            expect(fetch.ok).to_be(true)
            fixture.request = BrowserRequest.create(
                fetch.request_id, fetch.kind, fetch.url, fetch.method,
                fetch.headers, fetch.body, fetch.content_type
            )

fn expect_script_mime_state_unchanged(
    fixture: ScriptMimeBoundaryFixture,
    cookie_before: text,
    module_cache_count: i64,
    redirect_count: i64
):
    expect(fixture.worker.browser.current_body_html).to_contain("mime-safe")
    expect(fixture.worker.browser.current_body_html).not.to_contain(
        "mime-mutated"
    )
    expect(fixture.worker.browser.document_cookie()).to_equal(cookie_before)
    expect(fixture.worker.browser.module_source_cache.len()).to_equal(
        module_cache_count
    )
    expect(fixture.worker.browser.module_redirect_urls.len()).to_equal(
        redirect_count
    )
    match fixture.worker.browser.eval_script("typeof mimeMutation"):
        Ok(JsValue.String(value)):
            expect(value).to_equal("undefined")
        Ok(_):
            fail("expected the rejected response global to remain undefined")
        Err(reason):
            fail("expected global-state inspection to evaluate: {reason}")

use std.spec.step

describe "Browser renderer script MIME boundary":
    # @manual: show
    # @capture(protocol)
    it "admits only response MIME types authorized for the script mode":
        # @req: REQ-SECURITY-BROWSER-RENDERER-001
        step("Verify: admits only response MIME types authorized for the script mode")
        step("Admit canonical JavaScript MIME")
        val admitted = make_script_mime_boundary_fixture()
        accept_script_mime_network_response(
            admitted,
            encode_script_mime_network_response(
                admitted, 200,
                "Content-Type: Text/JavaScript; Charset=UTF-8",
                "document.body.innerHTML = '<p id=\"mime-admitted\">yes</p>'"
            )
        )
        expect(admitted.worker.browser.current_body_html).to_contain(
            "mime-admitted"
        )
        val sniffed = make_script_mime_boundary_fixture()
        accept_script_mime_network_response(
            sniffed,
            encode_script_mime_network_response(
                sniffed, 200, "Content-Type: text/plain",
                "document.body.innerHTML = '<p id=\"mime-sniffed\">yes</p>'"
            )
        )
        expect(sniffed.worker.browser.current_body_html).to_contain(
            "mime-sniffed"
        )
        val admitted_module = make_script_mime_boundary_fixture(true)
        accept_script_mime_network_response(
            admitted_module,
            encode_script_mime_network_response(
                admitted_module, 200,
                "Content-Type: APPLICATION/JAVASCRIPT; version=1",
                "document.body.innerHTML = " +
                "'<p id=\"mime-module-admitted\">yes</p>'"
            )
        )
        expect(admitted_module.worker.browser.current_body_html).to_contain(
            "mime-module-admitted"
        )

        step("Reject nosniff classic-script MIME")
        val classic = make_script_mime_boundary_fixture()
        val classic_cookie = classic.worker.browser.document_cookie()
        accept_script_mime_network_response(
            classic,
            encode_script_mime_network_response(
                classic, 200,
                "Content-Type: text/plain; charset=utf-8\n" +
                "X-Content-Type-Options: NoSniff\n" +
                "Set-Cookie: header=mutated",
                "document.body.innerHTML = 'mime-mutated'; " +
                "document.cookie = 'mime=mutated'; " +
                "globalThis.mimeMutation = 'yes'"
            )
        )
        expect(classic.worker.browser.warnings).to_contain(
            "external script error: blocked response MIME type"
        )
        expect_script_mime_state_unchanged(classic, classic_cookie, 0, 0)

        step("Reject redirected module MIME")
        val module = make_script_mime_boundary_fixture(true)
        accept_script_mime_network_response(
            module,
            encode_script_mime_network_response(
                module, 302,
                "Location: https://mime.test/final.js", ""
            )
        )
        expect(module.request.url).to_equal("https://mime.test/final.js")
        val module_cookie = module.worker.browser.document_cookie()
        accept_script_mime_network_response(
            module,
            encode_script_mime_network_response(
                module, 200,
                "Content-Type: text/html\nSet-Cookie: header=mutated",
                "document.body.innerHTML = 'mime-mutated'; " +
                "document.cookie = 'mime=mutated'; " +
                "globalThis.mimeMutation = 'yes'"
            )
        )
        expect(module.worker.browser.warnings).to_contain(
            "module load error: blocked response MIME type"
        )

        step("Preserve runtime state after MIME rejection")
        expect_script_mime_state_unchanged(module, module_cookie, 0, 0)
