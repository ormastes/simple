# @req: REQ-SECURITY-BROWSER-RENDERER-001


# codex-system-test
# @req REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-010 REQ-WEB-BROWSER-012 REQ-WEB-BROWSER-021
# @evidence-display: links
"""# Browser renderer attachment boundary

Top-level attachment responses remain parent-owned download candidates. Until
a download subsystem exists, the hosted parent and BrowserSession independently
reject them without activating HTML or changing the committed page.
"""

use std.spec.*
use std.common.web.browser_renderer_protocol.{
    BrowserRendererNetworkDecodeResult,
    browser_renderer_capability_decoder_feed,
    browser_renderer_capability_decoder_new,
    browser_renderer_capability_payload_message,
    browser_renderer_network_response_decode
}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{
    FetchRequest, FetchResponse, RequestMode
}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url}
use std.gc_async_mut.web.browser_session.{
    BrowserRequest, BrowserResponse
}
use std.gc_async_mut.web.browser_session_runtime.*
use std.js.types.js_types.{JsValue}
use os.hosted.hosted_browser_renderer_policy.{
    HostedBrowserRequestPolicy
}
use os.hosted.hosted_browser_renderer_process.{
    HostedBrowserRendererProcess
}
use os.hosted.hosted_browser_renderer_worker.{
    HostedBrowserRendererWorkerSession
}

extern fn rt_text_to_bytes(value: text) -> [u8]

class HostedAttachmentNavigationFixture:
    broker: HostedBrowserRendererProcess
    worker: HostedBrowserRendererWorkerSession
    request: BrowserRequest
    safe_url: text
    attachment_url: text
    safe_html: text
    safe_title: text
    safe_cookie: text
    safe_history_len: i64
    safe_worker_outbound_id: i64
    safe_broker_frame_count: i64
    navigation_wire: text
    broker_rejection: text
    session_rejection: text

fn setup_hosted_attachment_navigation_fixture(
) -> HostedAttachmentNavigationFixture:
    val safe_url = "https://safe.test/retained"
    val attachment_url = "https://safe.test/probe.html"
    val safe_html = (
        "<main id='retained'>retained page</main>" +
        "<script>var retainedGlobal = 'safe'</script>"
    )
    var worker = HostedBrowserRendererWorkerSession.create(96, 48)
    expect(worker.browser.open_html(safe_url, safe_html).is_ok()).to_be(true)
    worker.browser.apply_set_cookie_header(
        "retained=safe; Secure; Path=/", safe_url, safe_url
    )
    var broker = HostedBrowserRendererProcess.create(17, 96, 48)
    broker.state = "active"
    broker.document_url = safe_url
    broker.document_origin = "https://safe.test"
    broker.site_lock = "https://safe.test"
    broker.document_csp_policy = "default-src 'self'; script-src 'self'"
    broker.document_csp_ready = true
    broker.history_urls = [safe_url]
    broker.history_csp_policies = [broker.document_csp_policy]
    broker.history_csp_ready = [true]
    broker.history_index = 0
    broker.history_current_url = safe_url
    HostedAttachmentNavigationFixture(
        broker: broker,
        worker: worker,
        request: BrowserRequest.create(
            "", "document", attachment_url, "GET", "", "", ""
        ),
        safe_url: safe_url,
        attachment_url: attachment_url,
        safe_html: worker.browser.current_body_html,
        safe_title: worker.browser.current_title,
        safe_cookie: worker.browser.document_cookie(),
        safe_history_len: worker.browser.history.len(),
        safe_worker_outbound_id: worker.next_outbound_id,
        safe_broker_frame_count: broker.retained_image_resources.len(),
        navigation_wire: "",
        broker_rejection: "",
        session_rejection: ""
    )

fn submit_attachment_navigation(
    fixture: HostedAttachmentNavigationFixture
):
    expect(fixture.broker.begin_navigate(
        fixture.attachment_url, "GET", "", "", "", 2000
    ).is_ok()).to_be(true)
    fixture.navigation_wire = fixture.broker.pending_wire
    expect(fixture.navigation_wire).to_start_with("SBR2\t")
    fixture.broker.active_command_capability = (
        fixture.broker.staged_command_capability
    )
    fixture.broker.active_root_command_request_id = (
        fixture.broker.staged_root_command_request_id
    )
    fixture.broker.pending_wire = ""
    fixture.broker.pending_wire_offset = 0
    fixture.broker.pending_wire_reply_to_request_id = 0
    fixture.broker.pending_wire_is_command = false
    expect(fixture.worker.browser.begin_network_navigation(
        fixture.attachment_url, "GET", "", "", ""
    ).is_ok()).to_be(true)
    fixture.request = match fixture.worker.browser.take_pending_request():
        nil: fail("expected the attachment document request")
        Some(request): request

fn _hosted_attachment_fetch(
    fixture: HostedAttachmentNavigationFixture
) -> BrowserRendererNetworkDecodeResult:
    BrowserRendererNetworkDecodeResult(
        ok: true,
        reason: "ok",
        reply_to_request_id: 1,
        request_id: fixture.request.id,
        kind: "document",
        url: fixture.attachment_url,
        method: "GET",
        headers: "",
        body: "",
        content_type: "",
        credentials: "include",
        script_cookie_writes: [],
        status: 0,
        error: "",
        initiator_origin: "https://safe.test"
    )

fn deliver_attachment_document_response(
    fixture: HostedAttachmentNavigationFixture
):
    val headers = (
        "Content-Type: text/html\r\n" +
        "Content-Disposition: inline\r\n" +
        "cOnTeNt-DisPoSiTiOn: \tAttachment ; filename=\"probe.html\""
    )
    val body = (
        "<title>activated</title>" +
        "<script>attachmentActivated = true; " +
        "document.cookie = 'activated=yes; Secure; Path=/'</script>"
    )
    val response = fixture.broker._finalize_network(
        "document",
        FetchRequest(
            url: Url.parse_or_opaque(fixture.attachment_url),
            method: "GET",
            headers: "",
            body: [],
            mode: RequestMode.Navigate,
            credentials: "include"
        ),
        FetchResponse(
            status: 200,
            headers: headers,
            body: rt_text_to_bytes(body)
        )
    )
    expect(fixture.broker._write_network_response(
        _hosted_attachment_fetch(fixture),
        HostedBrowserRequestPolicy(
            ok: true,
            reason: "ok",
            mode: RequestMode.Navigate,
            credentials: "include",
            canonical_url: fixture.attachment_url,
            sanitized_headers: "",
            consumes_navigation: true
        ),
        response,
        0
    )).to_equal("")
    val decoded = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(17),
        fixture.broker.pending_wire
    )
    expect(decoded.status).to_equal("message")
    val rejected = browser_renderer_network_response_decode(
        browser_renderer_capability_payload_message(decoded.message)
    )
    expect(rejected.ok).to_be(true)
    expect(rejected.status).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(rejected.body).to_equal("")
    fixture.broker_rejection = rejected.error
    val session_result = fixture.worker.browser.commit_network_response(
        BrowserResponse.create(
            fixture.request.id,
            "document",
            fixture.attachment_url,
            200,
            headers,
            body,
            ""
        )
    )
    fixture.session_rejection = match session_result:
        Err(reason):
            fail("attachment rejection became fatal: {reason}")
        Ok(_):
            expect(
                fixture.worker.browser.warnings.len()
            ).to_be_greater_than(0)
            fixture.worker.browser.warnings[
                fixture.worker.browser.warnings.len() - 1
            ]

fn check_attachment_navigation_not_activated(
    fixture: HostedAttachmentNavigationFixture
):
    expect(fixture.broker_rejection).to_equal(
        "document-attachment-unsupported"
    )
    expect(fixture.session_rejection).to_equal(
        "document-attachment-unsupported"
    )
    expect(fixture.broker.document_url).to_equal(fixture.safe_url)
    expect(fixture.broker.history_urls).to_equal([fixture.safe_url])
    expect(fixture.broker.document_csp_policy).to_equal(
        "default-src 'self'; script-src 'self'"
    )
    expect(fixture.broker.pending_document_commit_url).to_equal("")
    expect(fixture.broker.provisional_document_origin).to_equal("")
    expect(fixture.broker.pending_document_csp_policy).to_equal("")
    expect(fixture.broker.pending_history_action).to_equal("")
    expect(fixture.broker.pending_wire).to_start_with("SBR2\t")
    expect(fixture.broker.pending_wire).not.to_equal(
        fixture.navigation_wire
    )
    expect(fixture.broker.retained_image_resources.len()).to_equal(
        fixture.safe_broker_frame_count
    )
    expect(fixture.worker.browser.current_url).to_equal(fixture.safe_url)
    expect(fixture.worker.browser.current_body_html).to_equal(
        fixture.safe_html
    )
    expect(fixture.worker.browser.current_title).to_equal(fixture.safe_title)
    expect(fixture.worker.browser.history.len()).to_equal(
        fixture.safe_history_len
    )
    expect(fixture.worker.browser.document_cookie()).to_equal(
        fixture.safe_cookie
    )
    expect(fixture.worker.next_outbound_id).to_equal(
        fixture.safe_worker_outbound_id
    )
    match fixture.worker.browser.eval_script("typeof attachmentActivated"):
        Ok(JsValue.String(value)):
            expect(value).to_equal("undefined")
        Ok(_):
            fail("expected the attachment global to remain undefined")
        Err(reason):
            fail("expected global-state inspection to evaluate: {reason}")

use std.spec.step

describe "Browser renderer attachment boundary":
    # @manual: show
    # @capture(protocol)
    it "should preserve the committed document when navigation is an attachment":
        # @req: REQ-SECURITY-BROWSER-RENDERER-001
        step("Verify: should preserve the committed document when navigation is an attachment")
        step("Install a safe document and attachment authority")
        val fixture = setup_hosted_attachment_navigation_fixture()

        step("Navigate through the hosted parent")
        submit_attachment_navigation(fixture)

        step("Deliver an attachment document response")
        deliver_attachment_document_response(fixture)

        step("Preserve the committed document and reject activation")
        check_attachment_navigation_not_activated(fixture)
