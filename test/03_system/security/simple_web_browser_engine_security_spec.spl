# codex-system-test
# @req REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-010 REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-012 REQ-WEB-BROWSER-013 REQ-WEB-BROWSER-014 REQ-WEB-BROWSER-015 REQ-WEB-BROWSER-016 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018 REQ-WEB-BROWSER-019 REQ-WEB-BROWSER-020 REQ-WEB-BROWSER-021 NFR-WEB-BROWSER-009 NFR-WEB-BROWSER-010 NFR-WEB-BROWSER-011 NFR-WEB-BROWSER-012 NFR-WEB-BROWSER-013
# @evidence-display: links
"""# Production Simple Browser Security Envelope

Treats pages, scripts, URLs, redirects, responses, and renderer messages as
hostile. Proves HTTPS, origin/storage policy, bounded IPC, and an OS-sandboxed
renderer without ambient host capabilities.
"""
use std.spec.*
use std.env.variables.{env_get}
use std.io_runtime.{file_hash_sha256}
use os.hosted.hosted_browser_renderer_process.{HostedBrowserRendererProcess}

# @inline
fn _two_origin_https_fixture():
    step("Navigate through verified HTTPS")

# @inline
fn _hostile_page_fixture():
    step("Reject hostile origin and scheme requests")

# @inline
fn _check_security_denial():
    step("Reject renderer host capability access")

# @inline
fn _platform_evidence_row():
    step("Bind platform sandbox evidence to the production renderer binary")

fn _require_platform_renderer_sandbox_evidence():
    val artifact = env_get("HOSTED_WM_ARTIFACT")
    val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
    if artifact == "":
        fail("HOSTED_WM_ARTIFACT is required for platform renderer sandbox evidence")
    if expected_artifact_sha.len() != 64 or
        file_hash_sha256(artifact) != expected_artifact_sha:
        fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")

    var renderer = HostedBrowserRendererProcess.create(41, 64, 48)
    val started = renderer.start(artifact, 2000)
    if not started.ok:
        fail("production renderer sandbox start failed: {started.reason}")
    expect(started.ok).to_be(true)
    expect(started.reason).to_equal("ok")

    val frame = renderer.render(
        "init",
        "<div style='width:16px;height:16px;background:#224466'>sandbox</div>",
        2000
    )
    if not frame.ok:
        fail("production renderer sandbox protocol failed: {frame.reason}")
    val closed = renderer.close()
    if not closed:
        fail("production renderer sandbox close failed")
    expect(frame.ok).to_be(true)
    expect(frame.reason).to_equal("ok")
    expect(frame.composition.batches.len()).to_be_greater_than(0)
    expect(closed).to_be(true)

fn _require_production_file_scheme_denial():
    val artifact = env_get("HOSTED_WM_ARTIFACT")
    val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
    if artifact == "":
        fail("HOSTED_WM_ARTIFACT is required for production scheme denial")
    if expected_artifact_sha.len() != 64 or
        file_hash_sha256(artifact) != expected_artifact_sha:
        fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")

    var renderer = HostedBrowserRendererProcess.create(42, 64, 48)
    val started = renderer.start(artifact, 2000)
    if not started.ok:
        val closed = renderer.close()
        if not closed:
            fail("production renderer cleanup failed after start denial")
        fail("production renderer start failed: {started.reason}")
    val initialized = renderer.render(
        "init", "<div>scheme-denial</div>", 2000
    )
    if not initialized.ok:
        val closed = renderer.close()
        if not closed:
            fail("production renderer cleanup failed after init denial")
        fail("production renderer init failed: {initialized.reason}")
    val denied = renderer.begin_navigate(
        "file:///etc/passwd", "GET", "", "", "", 2000
    )
    val closed = renderer.close()
    if not closed:
        fail("production renderer cleanup failed after scheme denial")
    match denied:
        Err(reason):
            expect(reason).to_equal("invalid-navigation")
        Ok(_):
            fail("file navigation was accepted by the production broker")

fn _require_production_oversized_text_denial():
    val artifact = env_get("HOSTED_WM_ARTIFACT")
    val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
    if artifact == "":
        fail("HOSTED_WM_ARTIFACT is required for protocol denial")
    if expected_artifact_sha.len() != 64 or
        file_hash_sha256(artifact) != expected_artifact_sha:
        fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")

    var renderer = HostedBrowserRendererProcess.create(44, 64, 48)
    val started = renderer.start(artifact, 2000)
    if not started.ok:
        val closed = renderer.close()
        if not closed:
            fail("production renderer cleanup failed after protocol start")
        fail("production renderer start failed: {started.reason}")
    val initialized = renderer.render(
        "init", "<input id='bounded' value=''>", 2000
    )
    if not initialized.ok:
        val closed = renderer.close()
        if not closed:
            fail("production renderer cleanup failed after protocol init")
        fail("production renderer init failed: {initialized.reason}")
    var oversized = ""
    var bytes: i64 = 0
    while bytes < 4097:
        oversized = oversized + "x"
        bytes = bytes + 1
    val denied = renderer.begin_text_input(1, oversized, 2000)
    val closed = renderer.close()
    if not closed:
        fail("production renderer cleanup failed after protocol denial")
    match denied:
        Err(reason):
            expect(reason).to_equal("invalid-action")
        Ok(_):
            fail("oversized renderer text action was accepted")

fn _require_production_node_native_denial():
    val artifact = env_get("HOSTED_WM_ARTIFACT")
    val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
    if artifact == "":
        fail("HOSTED_WM_ARTIFACT is required for Node API denial")
    if expected_artifact_sha.len() != 64 or
        file_hash_sha256(artifact) != expected_artifact_sha:
        fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")

    var renderer = HostedBrowserRendererProcess.create(43, 64, 48)
    val started = renderer.start(artifact, 2000)
    if not started.ok:
        val closed = renderer.close()
        if not closed:
            fail("production renderer cleanup failed after Node start denial")
        fail("production renderer start failed: {started.reason}")
    val frame = renderer.render(
        "init",
        "<div style='width:32px;height:24px;background:#224466'>" +
        "Node APIs denied</div>" +
        "<script>require('fs').readFileSync('/etc/passwd')</script>" +
        "<script>require('child_process').exec('id')</script>" +
        "<script>require('net').connect(1)</script>" +
        "<script>process.env.PATH</script>" +
        "<script>process.send('denied')</script>" +
        "<script type='text/simple'>native.host.exec</script>",
        2000
    )
    val closed = renderer.close()
    if not closed:
        fail("production renderer cleanup failed after Node API denial")
    if not frame.ok:
        fail("production renderer Node API denial frame failed: {frame.reason}")
    expect(frame.composition.batches.len()).to_be_greater_than(0)
    expect(frame.diagnostics).to_contain(
        "browser native globals: undefined:undefined:undefined"
    )
    expect(frame.diagnostics.split("inline script error:").len()).to_equal(6)
    expect(frame.diagnostics).to_contain(
        "simple script unsupported command: native.host.exec"
    )

fn _require_production_renderer_fault_containment():
    val artifact = env_get("HOSTED_WM_ARTIFACT")
    val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
    if artifact == "":
        fail("HOSTED_WM_ARTIFACT is required for renderer fault containment")
    if expected_artifact_sha.len() != 64 or
        file_hash_sha256(artifact) != expected_artifact_sha:
        fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")

    var crashed_renderer = HostedBrowserRendererProcess.create(45, 64, 48)
    val crashed_started = crashed_renderer.start(artifact, 2000)
    if not crashed_started.ok:
        fail("production renderer crash start failed: {crashed_started.reason}")
    val crashed_initialized = crashed_renderer.render(
        "init", "<div>crash containment</div>", 2000
    )
    if not crashed_initialized.ok:
        fail("production renderer crash init failed: {crashed_initialized.reason}")
    step("Crash the admitted renderer after ready")
    val crashed = crashed_renderer.test_crash_after_ready(2000)
    expect(crashed.ok).to_be(false)
    expect(crashed.reason).to_equal("renderer-crashed")

    var crash_restarted = HostedBrowserRendererProcess.create(46, 64, 48)
    val crash_restart_started = crash_restarted.start(artifact, 2000)
    if not crash_restart_started.ok:
        fail("renderer did not restart after crash: {crash_restart_started.reason}")
    val crash_restart_frame = crash_restarted.render(
        "init", "<div>crash restart</div>", 2000
    )
    val crash_restart_closed = crash_restarted.close()
    expect(crash_restart_frame.ok).to_be(true)
    expect(crash_restart_frame.composition.batches.len()).to_be_greater_than(0)
    expect(crash_restart_closed).to_be(true)

    var hung_renderer = HostedBrowserRendererProcess.create(47, 64, 48)
    val hung_started = hung_renderer.start(artifact, 2000)
    if not hung_started.ok:
        fail("production renderer hang start failed: {hung_started.reason}")
    val hung_initialized = hung_renderer.render(
        "init", "<div>timeout containment</div>", 2000
    )
    if not hung_initialized.ok:
        fail("production renderer hang init failed: {hung_initialized.reason}")
    step("Hang the admitted renderer after ready")
    val hung = hung_renderer.test_hang_after_ready(500)
    expect(hung.ok).to_be(false)
    expect(hung.reason).to_equal("renderer-timeout")

    var hang_restarted = HostedBrowserRendererProcess.create(48, 64, 48)
    val hang_restart_started = hang_restarted.start(artifact, 2000)
    if not hang_restart_started.ok:
        fail("renderer did not restart after timeout: {hang_restart_started.reason}")
    val hang_restart_frame = hang_restarted.render(
        "init", "<div>timeout restart</div>", 2000
    )
    val hang_restart_closed = hang_restarted.close()
    expect(hang_restart_frame.ok).to_be(true)
    expect(hang_restart_frame.composition.batches.len()).to_be_greater_than(0)
    expect(hang_restart_closed).to_be(true)

fn _require_production_security_evidence():
    fail("REQ-WEB-BROWSER-010..019: production security evidence not implemented")

describe "Production Simple browser security envelope":
    # @manual: show
    # @capture(protocol)
    # @capture(log)
    it "should navigate trusted HTTPS and reject invalid certificate identities":
        _two_origin_https_fixture()
        step("Inspect TLS chain service identity HSTS and failure evidence")
        _require_production_security_evidence()

    # @manual: show
    # @capture(protocol)
    it "should enforce origin CORS CSP redirect and mixed-content policy":
        _two_origin_https_fixture()
        _hostile_page_fixture()
        _check_security_denial()
        _require_production_security_evidence()

    # @manual: folded
    it "should partition cookies and storage and enforce cookie attributes":
        _two_origin_https_fixture()
        step("Exercise host-only Secure HttpOnly SameSite path and expiry")
        _require_production_security_evidence()

    # @manual: show
    # @capture(exec)
    # @capture(protocol)
    it "should deny Node native filesystem process socket environment and IPC access":
        _hostile_page_fixture()
        _check_security_denial()
        _require_production_node_native_denial()

    # @manual: folded
    it "should deny unaudited file navigation through the production broker":
        _hostile_page_fixture()
        step("Reject file navigation before it reaches the sandboxed worker")
        _require_production_file_scheme_denial()

    # @manual: show
    # @capture(exec)
    # @capture(binary)
    # @capture(log)
    it "should run the site renderer in the required platform sandbox":
        _platform_evidence_row()
        _check_security_denial()
        _require_platform_renderer_sandbox_evidence()

    # @manual: folded
    it "should reject oversized renderer text through the production protocol":
        _hostile_page_fixture()
        step("Reject a 4,097-byte text action before it reaches the worker")
        _require_production_oversized_text_denial()

    # @manual: folded
    it "should contain admitted renderer crash and timeout failures":
        _platform_evidence_row()
        _require_production_renderer_fault_containment()

    # @manual: folded
    it "should bound renderer memory and restart-rate failures":
        _platform_evidence_row()
        step("Bound renderer memory exhaustion and restart rate")
        _require_production_security_evidence()

    # @manual: folded
    it "should account for pinned conformance and fuzz corpora":
        step("Load pinned WPT Test262 and fuzz manifests")
        step("Retain minimized reproducers for every failure")
        _require_production_security_evidence()
