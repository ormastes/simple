# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag:system
# @cover src/os/crypto/chacha20_poly1305.spl 80%
"""
# ChaCha20-Poly1305 RFC 8439 Known-Answer Specification

**Category:** Testing
**Plan:** doc/03_plan/agent_tasks/pure_simple_crypto_tls_remains_2026-04-16.md

## Overview

Validates the pure-Simple ChaCha20-Poly1305 AEAD (src/os/crypto/chacha20_poly1305.spl)
against the published RFC 8439 test vectors, embedded as fixed constants:
block function (2.3.2), encryption (2.4.2), Poly1305 MAC (2.5.2), AEAD (2.8.2).
The RFC is the independent oracle; no external tool or source text is consulted.
Also covers the pure-Simple roundtrip and tampered-tag rejection.
"""

use std.spec.step

use std.spipe.*
use os.crypto.chacha20.{chacha20_encrypt}
use os.crypto.poly1305.{poly1305_mac}
use os.crypto.chacha20_poly1305.{
    chacha20_poly1305_encrypt, chacha20_poly1305_decrypt, Chacha20Poly1305Result
}
use test.system.os_crypto_ref_helpers.{hex_to_bytes, bytes_to_hex}

val SEQ_KEY_HEX: text = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
val LADIES_PT_HEX: text = "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"

val AEAD_KEY_HEX:   text = "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
val AEAD_NONCE_HEX: text = "070000004041424344454647"
val AEAD_AAD_HEX:   text = "50515253c0c1c2c3c4c5c6c7"
val AEAD_CT_HEX:    text = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"

fn _split_ct_tag(ct_and_tag: [u8]) -> ([u8], [u8]):
    var cipher: [u8] = []
    var tag: [u8] = []
    val n = ct_and_tag.len()
    var i: u64 = 0
    while i < n - 16:
        cipher.push(ct_and_tag[i])
        i = i + 1
    while i < n:
        tag.push(ct_and_tag[i])
        i = i + 1
    (cipher, tag)

fn _zeros(n: u64) -> [u8]:
    var z: [u8] = []
    var i: u64 = 0
    while i < n:
        z.push(0)
        i = i + 1
    z

fn _decrypt_ok(key: [u8], nonce: [u8], cipher: [u8], aad: [u8], tag: [u8]) -> [u8]:
    match chacha20_poly1305_decrypt(key, nonce, cipher, aad, tag):
        Chacha20Poly1305Result.Ok(data): data
        Chacha20Poly1305Result.Err(_):   []

fn _decrypt_is_err(key: [u8], nonce: [u8], cipher: [u8], aad: [u8], tag: [u8]) -> bool:
    match chacha20_poly1305_decrypt(key, nonce, cipher, aad, tag):
        Chacha20Poly1305Result.Ok(_):  false
        Chacha20Poly1305Result.Err(_): true

describe "chacha_poly: RFC 8439 known-answer vectors":
    it "RFC 8439 2.3.2 block keystream (counter 1) matches the published bytes":
        # @req REQ-SSPEC-SYSTEM
        step("RFC 8439 2.3.2 block keystream (counter 1) matches the published bytes")
        val key = hex_to_bytes(SEQ_KEY_HEX)
        val nonce = hex_to_bytes("000000090000004a00000000")
        # keystream = encrypt of 64 zero bytes
        val ks = chacha20_encrypt(key, 1, nonce, _zeros(64))
        expect(bytes_to_hex(ks)).to_equal("10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")

    it "RFC 8439 2.4.2 encryption yields the published ciphertext":
        # @req REQ-SSPEC-SYSTEM
        step("RFC 8439 2.4.2 encryption yields the published ciphertext")
        val key = hex_to_bytes(SEQ_KEY_HEX)
        val nonce = hex_to_bytes("000000000000004a00000000")
        val ct = chacha20_encrypt(key, 1, nonce, hex_to_bytes(LADIES_PT_HEX))
        expect(bytes_to_hex(ct)).to_equal("6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d")

    it "RFC 8439 2.5.2 Poly1305 tag matches the published value":
        # @req REQ-SSPEC-SYSTEM
        step("RFC 8439 2.5.2 Poly1305 tag matches the published value")
        val key = hex_to_bytes("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
        val msg = "Cryptographic Forum Research Group".bytes()
        expect(bytes_to_hex(poly1305_mac(key, msg))).to_equal("a8061dc1305136c6c22b8baf0c0127a9")

    it "RFC 8439 2.8.2 AEAD encrypt yields the published ciphertext||tag":
        # @req REQ-SSPEC-SYSTEM
        step("RFC 8439 2.8.2 AEAD encrypt yields the published ciphertext||tag")
        val out = chacha20_poly1305_encrypt(hex_to_bytes(AEAD_KEY_HEX), hex_to_bytes(AEAD_NONCE_HEX), hex_to_bytes(LADIES_PT_HEX), hex_to_bytes(AEAD_AAD_HEX))
        expect(bytes_to_hex(out)).to_equal(AEAD_CT_HEX)

    it "RFC 8439 2.8.2 AEAD decrypt recovers the published plaintext":
        # @req REQ-SSPEC-SYSTEM
        step("RFC 8439 2.8.2 AEAD decrypt recovers the published plaintext")
        val split = _split_ct_tag(hex_to_bytes(AEAD_CT_HEX))
        val pt = _decrypt_ok(hex_to_bytes(AEAD_KEY_HEX), hex_to_bytes(AEAD_NONCE_HEX), split.0, hex_to_bytes(AEAD_AAD_HEX), split.1)
        expect(bytes_to_hex(pt)).to_equal(LADIES_PT_HEX)

    it "a flipped tag bit is rejected on decrypt":
        # @req REQ-SSPEC-SYSTEM
        step("a flipped tag bit is rejected on decrypt")
        val split = _split_ct_tag(hex_to_bytes(AEAD_CT_HEX))
        var tag = split.1
        tag[15] = (tag[15].to_i64() ^ 0xff).to_u8()
        val bad = _decrypt_is_err(hex_to_bytes(AEAD_KEY_HEX), hex_to_bytes(AEAD_NONCE_HEX), split.0, hex_to_bytes(AEAD_AAD_HEX), tag)
        expect(bad).to_equal(true)
