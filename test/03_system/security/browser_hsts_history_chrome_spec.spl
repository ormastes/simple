# codex-system-test
# @req REQ-WEB-BROWSER-009 REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-014 REQ-WEB-BROWSER-021
# @evidence-display: links
"""# HSTS-safe hosted history chrome

Back and Forward bind the HSTS-upgraded traversal ledger to the SBR2 command
capability. The parent publishes that off-side ledger only after validating
the final renderer proposal; Stop, replacement, and rejection preserve the
previously committed ledger.
"""
use std.spec.*
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_browser_renderer_process.{
    HostedBrowserRendererProcess
}
use os.hosted.hosted_browser_renderer_registry.{
    HostedBrowserRendererEntry, HostedBrowserRendererRegistry
}
use std.common.web.browser_renderer_history_protocol.{
    browser_renderer_history_proposal_decode,
    browser_renderer_history_proposal_encode
}
use std.common.web.browser_renderer_protocol.{
    browser_renderer_capability_decoder_feed,
    browser_renderer_capability_decoder_new,
    browser_renderer_capability_payload_message,
    browser_renderer_navigation_decode
}

val HSTS_WINDOW_ID: i64 = 901
val HSTS_HTTP_URL = "http://secure.test/legacy"
val HSTS_HTTPS_URL = "https://secure.test/legacy"
val HSTS_CURRENT_URL = "https://current.test/page"

fn setup_hsts_history_chrome_fixture(
) -> HostedBrowserRendererRegistry:
    var renderer = HostedBrowserRendererProcess.create(91, 96, 64)
    renderer.state = "active"
    renderer.document_url = HSTS_CURRENT_URL
    renderer.document_origin = "https://current.test"
    renderer.document_csp_policy = "default-src 'self'"
    renderer.document_csp_ready = true
    renderer.history_urls = [HSTS_HTTP_URL, HSTS_CURRENT_URL]
    renderer.history_csp_policies = [
        "default-src 'self'", "default-src 'self'"
    ]
    renderer.history_csp_ready = [true, true]
    renderer.history_index = 1
    renderer.home_url = "https://home.test/"
    renderer._sync_history_neighbors_from_ledger()
    expect(renderer._commit_validated_https_hsts(
        "https://secure.test/policy",
        "Strict-Transport-Security: max-age=600"
    )).to_equal(true)

    var entry = HostedBrowserRendererEntry.create(
        HSTS_WINDOW_ID, renderer,
        Engine2dCompositorBackend.create_named(96, 64, "software"),
        0, ""
    )
    entry.ready = true
    var registry = HostedBrowserRendererRegistry.create(
        "", "https://home.test/"
    )
    registry.entries = [entry]
    registry

fn _assert_committed_history(
    registry: HostedBrowserRendererRegistry,
    first_url: text, index: i64
):
    val renderer = registry.entries[0].renderer
    expect(renderer.history_urls).to_equal(
        [first_url, HSTS_CURRENT_URL]
    )
    expect(renderer.history_index).to_equal(index)

fn _shutdown_history_registry(
    registry: HostedBrowserRendererRegistry
):
    var entry = registry.entries[0]
    entry.raster.shutdown()
    registry.entries[0] = entry

fn _assert_forward_pending_wire(
    registry: HostedBrowserRendererRegistry
):
    val renderer = registry.entries[0].renderer
    val envelope = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(renderer.generation),
        renderer.pending_wire
    )
    expect(envelope.status).to_equal("message")
    expect(envelope.message.command_capability).to_equal(
        renderer.active_command_capability
    )
    val navigation = browser_renderer_navigation_decode(
        browser_renderer_capability_payload_message(envelope.message)
    )
    expect(navigation.ok).to_equal(true)
    expect(navigation.action).to_equal("forward")
    expect(navigation.url).to_equal(HSTS_CURRENT_URL)
    val snapshot = browser_renderer_history_proposal_decode(
        navigation.history_snapshot
    )
    expect(snapshot.ok).to_equal(true)
    expect(snapshot.action).to_equal("N")
    expect(snapshot.current_index).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(snapshot.urls).to_equal(
        [HSTS_HTTPS_URL, HSTS_CURRENT_URL]
    )
    expect(snapshot.authority_capability).to_equal(
        envelope.message.command_capability
    )
    expect(snapshot.authority_capability).to_equal(
        renderer.active_command_capability
    )

fn activate_back_through_hosted_chrome(
    registry: HostedBrowserRendererRegistry
):
    val down = registry.dispatch_chrome_pointer(
        100, HSTS_WINDOW_ID, "back", true
    )
    val up = registry.dispatch_chrome_pointer(
        101, HSTS_WINDOW_ID, "back", false
    )
    expect(down.reason).to_equal("chrome-pressed")
    expect(down.callback_count).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(up.reason).to_equal("")
    expect(up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

    val renderer = registry.entries[0].renderer
    val envelope = browser_renderer_capability_decoder_feed(
        browser_renderer_capability_decoder_new(renderer.generation),
        renderer.pending_wire
    )
    expect(envelope.status).to_equal("message")
    val navigation = browser_renderer_navigation_decode(
        browser_renderer_capability_payload_message(envelope.message)
    )
    expect(navigation.ok).to_equal(true)
    expect(navigation.action).to_equal("back")
    expect(navigation.url).to_equal(HSTS_HTTPS_URL)
    val snapshot = browser_renderer_history_proposal_decode(
        navigation.history_snapshot
    )
    expect(snapshot.ok).to_equal(true)
    expect(snapshot.action).to_equal("N")
    expect(snapshot.current_index).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    expect(snapshot.urls).to_equal(
        [HSTS_HTTPS_URL, HSTS_CURRENT_URL]
    )
    expect(snapshot.authority_capability).to_equal(
        renderer.active_command_capability
    )
    expect(renderer.navigation_permit.url).to_equal(HSTS_HTTPS_URL)
    expect(renderer.pending_history_index).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(renderer.pending_history_target_url).to_equal(HSTS_HTTPS_URL)
    _assert_committed_history(registry, HSTS_HTTP_URL, 1)

fn check_upgraded_history_commit(
    registry: HostedBrowserRendererRegistry
):
    var renderer = registry.entries[0].renderer
    val capability = renderer.active_command_capability
    renderer.pending_document_commit_url = HSTS_HTTPS_URL
    renderer.pending_document_csp_policy = "default-src 'self'"
    renderer.pending_document_csp_ready = true
    renderer.expected_reply_to_request_id = 111
    renderer.admitted_history_authority = renderer._history_authority(
        capability, 101, 111
    )
    val proposal_wire = match browser_renderer_history_proposal_encode(
        "T", "O", "", HSTS_HTTPS_URL, capability, 0,
        [HSTS_HTTPS_URL, HSTS_CURRENT_URL]
    ):
        Err(reason):
            fail(reason)
        Ok(value):
            value
    val candidate = renderer._history_candidate_with_proposal(
        renderer._stage_history_candidate(),
        browser_renderer_history_proposal_decode(proposal_wire),
        renderer.generation, 111
    )
    expect(candidate.ok).to_equal(true)
    expect(candidate.document_url).to_equal(HSTS_HTTPS_URL)
    expect(candidate.urls).to_equal(
        [HSTS_HTTPS_URL, HSTS_CURRENT_URL]
    )
    renderer._commit_history_candidate(candidate)
    expect(renderer._cancel_pending_for_stop()).to_equal(true)
    registry.entries[0].renderer = renderer

    val committed = registry.entries[0].renderer
    expect(committed.document_url).to_equal(HSTS_HTTPS_URL)
    expect(committed.history_current_url).to_equal(HSTS_HTTPS_URL)
    expect(committed.history_back_url).to_equal("")
    expect(committed.history_forward_url).to_equal(HSTS_CURRENT_URL)
    expect(committed.pending_history_index).to_equal(-1)  # oracle: -1 — pinned expected value for this behavior
    expect(committed.pending_history_target_url).to_equal("")
    _assert_committed_history(registry, HSTS_HTTPS_URL, 0)

fn _check_rejected_candidate_preserves_commit():
    var registry = setup_hsts_history_chrome_fixture()
    activate_back_through_hosted_chrome(registry)
    var renderer = registry.entries[0].renderer
    val capability = renderer.active_command_capability
    renderer.pending_document_commit_url = HSTS_HTTPS_URL
    renderer.pending_document_csp_policy = "default-src 'self'"
    renderer.pending_document_csp_ready = true
    renderer.expected_reply_to_request_id = 121
    renderer.admitted_history_authority = renderer._history_authority(
        capability, 101, 121
    )
    val hostile_wire = match browser_renderer_history_proposal_encode(
        "T", "O", "", HSTS_HTTPS_URL, capability, 0,
        [HSTS_HTTP_URL, HSTS_CURRENT_URL]
    ):
        Err(reason):
            fail(reason)
        Ok(value):
            value
    val rejected = renderer._history_candidate_with_proposal(
        renderer._stage_history_candidate(),
        browser_renderer_history_proposal_decode(hostile_wire),
        renderer.generation, 121
    )
    expect(rejected.ok).to_equal(false)
    expect(rejected.reason).to_equal("history-ledger-mismatch")
    registry.entries[0].renderer = renderer
    _assert_committed_history(registry, HSTS_HTTP_URL, 1)
    _shutdown_history_registry(registry)

fn _check_replacement_preserves_commit():
    var registry = setup_hsts_history_chrome_fixture()
    activate_back_through_hosted_chrome(registry)
    val home_down = registry.dispatch_chrome_pointer(
        130, HSTS_WINDOW_ID, "home", true
    )
    val home_up = registry.dispatch_chrome_pointer(
        131, HSTS_WINDOW_ID, "home", false
    )
    expect(home_down.reason).to_equal("chrome-pressed")
    expect(home_up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    val renderer = registry.entries[0].renderer
    expect(renderer.pending_history_index).to_equal(-1)  # oracle: -1 — pinned expected value for this behavior
    expect(renderer.pending_history_target_url).to_equal("")
    expect(renderer.navigation_permit.url).to_equal(
        "https://home.test/"
    )
    _assert_committed_history(registry, HSTS_HTTP_URL, 1)
    _shutdown_history_registry(registry)

fn check_stop_retry_forward_projection(
    registry: HostedBrowserRendererRegistry
):
    val forward_down = registry.dispatch_chrome_pointer(
        140, HSTS_WINDOW_ID, "forward", true
    )
    val forward_up = registry.dispatch_chrome_pointer(
        141, HSTS_WINDOW_ID, "forward", false
    )
    expect(forward_down.reason).to_equal("chrome-pressed")
    expect(forward_up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    val forward_renderer = registry.entries[0].renderer
    expect(forward_renderer.pending_history_index).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    expect(forward_renderer.pending_history_target_url).to_equal(
        HSTS_CURRENT_URL
    )
    _assert_forward_pending_wire(registry)
    _assert_committed_history(registry, HSTS_HTTPS_URL, 0)

    val stop_down = registry.dispatch_chrome_pointer(
        142, HSTS_WINDOW_ID, "stop", true
    )
    val stop_up = registry.dispatch_chrome_pointer(
        143, HSTS_WINDOW_ID, "stop", false
    )
    expect(stop_down.reason).to_equal("chrome-pressed")
    expect(stop_up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    val stopped = registry.entries[0].renderer
    expect(stopped.pending_history_index).to_equal(-1)  # oracle: -1 — pinned expected value for this behavior
    expect(stopped.pending_history_target_url).to_equal("")
    expect(stopped.history_forward_url).to_equal(HSTS_CURRENT_URL)
    _assert_committed_history(registry, HSTS_HTTPS_URL, 0)

    val retry_down = registry.dispatch_chrome_pointer(
        144, HSTS_WINDOW_ID, "forward", true
    )
    val retry_up = registry.dispatch_chrome_pointer(
        145, HSTS_WINDOW_ID, "forward", false
    )
    expect(retry_down.reason).to_equal("chrome-pressed")
    expect(retry_up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    val retried = registry.entries[0].renderer
    expect(retried.pending_history_index).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    expect(retried.pending_history_target_url).to_equal(
        HSTS_CURRENT_URL
    )
    _assert_forward_pending_wire(registry)
    _assert_committed_history(registry, HSTS_HTTPS_URL, 0)

    val cleanup_down = registry.dispatch_chrome_pointer(
        146, HSTS_WINDOW_ID, "stop", true
    )
    val cleanup_up = registry.dispatch_chrome_pointer(
        147, HSTS_WINDOW_ID, "stop", false
    )
    expect(cleanup_down.reason).to_equal("chrome-pressed")
    expect(cleanup_up.callback_count).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    expect(
        registry.entries[0].renderer.pending_history_index
    ).to_equal(-1)  # oracle: -1 — pinned expected value for this behavior
    _assert_committed_history(registry, HSTS_HTTPS_URL, 0)

    _check_replacement_preserves_commit()
    _check_rejected_candidate_preserves_commit()
    _shutdown_history_registry(registry)

use std.spec.step

describe "Hosted HSTS history chrome":
    # @manual: show
    # @capture(protocol)
    # @req REQ-WEB-BROWSER-009 REQ-WEB-BROWSER-011 REQ-WEB-BROWSER-014 REQ-WEB-BROWSER-021
    it "should bind upgraded traversal history to hosted chrome":
        # @req: REQ-SECURITY-BROWSER-HSTS-001
        step("Verify: should bind upgraded traversal history to hosted chrome")
        step("Commit HTTP history before learning HSTS")
        var fixture = setup_hsts_history_chrome_fixture()

        step("Learn HSTS and activate Back through hosted chrome")
        activate_back_through_hosted_chrome(fixture)

        step("Commit one upgraded traversal ledger atomically")
        check_upgraded_history_commit(fixture)

        step("Preserve Stop retry and Forward projections")
        check_stop_retry_forward_projection(fixture)
