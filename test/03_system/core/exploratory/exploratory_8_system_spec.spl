# @req: REQ-SYS-EXPLORATORY-56f3

# exploratory behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

describe "exploratory stdlib behavior oracles":
    it "option map unwrap":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: option map unwrap")
        # oracle: Some(10)/5 — map doubles the payload; unwrap_or yields it
        val o = Some(5)
        expect(o.map(fn (x: i64) -> i64: x * 2)).to_equal(Some(10))
        expect(o.unwrap_or(0)).to_equal(5)
        expect(o.is_some()).to_equal(true)
    it "option none default":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: option none default")
        # oracle: 0 — a nil option falls back to the supplied default
        expect(nil.unwrap_or(0)).to_equal(0)
    it "result ok err":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: result ok err")
        # oracle: true/7 — Ok is ok and unwraps; Err is err
        expect(Ok(7).is_ok()).to_equal(true)
        expect(Err("e").is_err()).to_equal(true)
        expect(Ok(7).unwrap_or(0)).to_equal(7)
    it "char code roundtrip":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: char code roundtrip")
        # oracle: 97/"b" — 'a' is codepoint 97; code 98 decodes to 'b'
        expect(char_code("a")).to_equal(97)
        expect(char_from_code(98)).to_equal("b")
    it "loop accumulates in order":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: loop accumulates in order")
        # oracle: 10 — sum of 0..5 exclusive end
        var sum = 0
        for i in 0..5:
            sum = sum + i
        expect(sum).to_equal(10)
    it "match destructures Some":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: match destructures Some")
        # oracle: 1 — the Some arm binds the payload
        match Some(1):
            Some(x):
                expect(x).to_equal(1)
            nil:
                expect(false).to_equal(true)
    it "string length and emptiness":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: string length and emptiness")
        # oracle: 4/0 — len counts chars; only the empty string is empty
        expect("test".len()).to_equal(4)
        expect("".len()).to_equal(0)
        expect("".is_empty()).to_equal(true)
    it "comparison ordering":
        # @req: REQ-SYS-EXPLORATORY-56f3
        step("Verify: comparison ordering")
        # oracle: transitive i64 ordering as written
        expect(1 < 2).to_equal(true)
        expect(2 <= 2).to_equal(true)
        expect(3 > 4).to_equal(false)
        expect(5 == 5).to_equal(true)
