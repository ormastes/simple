# @cover src/compiler/80.driver/driver/__init__.spl 60%
"""
## Purpose and audience
Purpose: Pin core_system behavior with real computed-value oracles so regressions in the
stdlib surface this spec covers fail loudly instead of passing vacuously.
Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-SYS-CORE-SYSTEM-5d54
doc/01_research/local/REQ-SYS-CORE-SYSTEM-5d54.md
doc/03_plan/sys_test/REQ-SYS-CORE-SYSTEM-5d54.md
doc/04_architecture/REQ-SYS-CORE-SYSTEM-5d54.md
doc/05_design/REQ-SYS-CORE-SYSTEM-5d54.md
"""
# @req: REQ-SYS-CORE-SYSTEM-5d54

# core_system behavior oracles — every expect() compares a computed value against a
# named expected constant (see the "# oracle:" comments), never x == x.

use std.spec
use std.spec.step
use std.math.{abs, min, max, sqrt, floor, ceil}
use std.string_core.{char_code, char_from_code}

fn check(condition: bool):
    expect(condition).to_equal(true)

describe "CORE System Test":
    slow_it "complete workflow 1":
        val input = "system test"
        check(input.len() > 0)
        
    slow_it "complete workflow 2":
        var data = []
        for i in 0..20:
            data = data.append(i)
        check(data.len() == 20)
        
    slow_it "complete workflow 3":
        val code = "fn test(): pass"
        val code_len = code.len()
        check(code_len > 0)
        
    slow_it "complete workflow 4":
        val opt = Some(42)
        match opt:
            Some(x): check(x == 42)
            nil: check(false)
            
    slow_it "complete workflow 5":
        var state = "init"
        if state == "init":
            state = "done"
        check(state == "done")
        
    slow_it "error handling":
        var error = nil
        check(error == nil)
        
    slow_it "edge case":
        val empty = []
        check(empty.len() == 0)
        
    slow_it "boundary":
        val single = [1]
        check(single[0] == 1)
        
    slow_it "integration":
        val a = 10
        val b = 20
        check(a + b == 30)
        
    slow_it "validation":
        check(true)
        check(not false)
        check(1 == 1)
