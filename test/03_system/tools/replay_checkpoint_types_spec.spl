"""
## Purpose and audience
Purpose: File to_i32 returns 0
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplChecType-001

use std.spec
use os.kernel.replay.checkpoint.checkpoint_types.{ContainerCheckpoint, ProcessSnapshot, IpcSnapshot, FdKind, FdEntry}

use std.spec.step
describe "FdKind to_i32":
    it "File to_i32 returns 0":
        step("Verify: File to_i32 returns 0")
        # @req: REQ-TOOLS-ReplChecType-001
        val f = FdKind.File
        expect(f.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "Pipe to_i32 returns 1":
        step("Verify: Pipe to_i32 returns 1")
        # @req: REQ-TOOLS-ReplChecType-001
        val p = FdKind.Pipe
        expect(p.to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "Socket to_i32 returns 2":
        step("Verify: Socket to_i32 returns 2")
        # @req: REQ-TOOLS-ReplChecType-001
        val p = FdKind.Socket
        expect(p.to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

describe "ProcessSnapshot create":
    it "create sets task_id":
        step("Verify: create sets task_id")
        # @req: REQ-TOOLS-ReplChecType-001
        val ps = ProcessSnapshot.create(10, 0)
        expect(ps.task_id).to_equal(10)  # oracle: value fixed by the spec contract

    it "create sets parent_id":
        step("Verify: create sets parent_id")
        # @req: REQ-TOOLS-ReplChecType-001
        val ps = ProcessSnapshot.create(10, 5)
        expect(ps.parent_id).to_equal(5)  # oracle: value fixed by the spec contract

    it "create starts with empty fd_table":
        step("Verify: create starts with empty fd_table")
        # @req: REQ-TOOLS-ReplChecType-001
        val ps = ProcessSnapshot.create(1, 0)
        expect(ps.fd_table.len()).to_equal(0)  # oracle: value fixed by the spec contract

describe "ContainerCheckpoint create":
    it "create stores container_id":
        step("Verify: create stores container_id")
        # @req: REQ-TOOLS-ReplChecType-001
        val cp = ContainerCheckpoint.create("ctr-001", 1)
        expect(cp.container_id).to_equal("ctr-001")

    it "create stores checkpoint_id":
        step("Verify: create stores checkpoint_id")
        # @req: REQ-TOOLS-ReplChecType-001
        val cp = ContainerCheckpoint.create("ctr-001", 7)
        expect(cp.checkpoint_id).to_equal(7)  # oracle: value fixed by the spec contract

    it "process_count starts at 0":
        step("Verify: process_count starts at 0")
        # @req: REQ-TOOLS-ReplChecType-001
        val cp = ContainerCheckpoint.create("ctr-x", 0)
        expect(cp.process_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "add_process increments process_count":
        step("Verify: add_process increments process_count")
        # @req: REQ-TOOLS-ReplChecType-001
        val cp = ContainerCheckpoint.create("ctr-y", 2)
        val ps = ProcessSnapshot.create(99, 0)
        cp.add_process(ps)
        expect(cp.process_count()).to_equal(1)  # oracle: value fixed by the spec contract
