# @tag:system
# @req REQ-SSPEC-SYSTEM
# @cover src/app/test_daemon/session_broker.spl 80%
# @cover src/app/test_daemon/session_adapter.spl 80%
# @cover src/app/test_daemon/session_types.spl 80%
# Coverage percentages are targets, not measured results.
# Default adapters exercise broker bookkeeping and failure reporting only.
# No QEMU process, container, or live session is started by these scenarios.

use std.spec.{describe, it, expect, step, fail}
use app.test_daemon.session_types.{TestSessionMeta, SESSION_KIND_QEMU_VM, SESSION_KIND_CONTAINER, REUSE_SHARED_READ_ONLY, REUSE_FRESH_PER_TEST, RESET_NONE, LEASE_IDLE}
use app.test_daemon.session_broker.{session_broker_new}
use app.test_daemon.session_adapter.{session_adapter_new}
use app.test_daemon.types.{TRESP_FAILED}

fn _multi_session_meta(kind: i64, target: text, reuse: i64) -> TestSessionMeta:
    TestSessionMeta(
        file_path: "test/03_system/tools/test_daemon/test_daemon_multi_session_system_spec.spl",
        session_kind: kind,
        target: target,
        reuse_mode: reuse,
        reset_policy: RESET_NONE,
        artifact: "",
        startup_cmd: "",
        healthcheck: ""
    )

describe "Test daemon multi-session broker coordination":
    it "should isolate session kinds and architectures while reporting unavailable execution honestly":
        step("Register QEMU and container adapter descriptors with one broker")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        broker.register_adapter(session_adapter_new(SESSION_KIND_CONTAINER, "container-descriptor"))
        step("Acquire independent ARM64, RISC-V, x86-64, and container leases")
        val arm = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_SHARED_READ_ONLY))
        val riscv = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "riscv64", REUSE_SHARED_READ_ONLY))
        val x86 = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "x86_64", REUSE_SHARED_READ_ONLY))
        val container = broker.acquire(_multi_session_meta(SESSION_KIND_CONTAINER, "arm64", REUSE_SHARED_READ_ONLY))
        expect(broker.total_count()).to_equal(4)
        expect(broker.count_by_kind(SESSION_KIND_QEMU_VM)).to_equal(3)
        expect(broker.count_by_kind(SESSION_KIND_CONTAINER)).to_equal(1)
        expect(arm.session_id != riscv.session_id).to_equal(true)
        expect(arm.session_id != x86.session_id).to_equal(true)
        expect(riscv.session_id != x86.session_id).to_equal(true)
        expect(arm.session_id != container.session_id).to_equal(true)
        expect(arm.key.target).to_equal("arm64")
        expect(riscv.key.target).to_equal("riscv64")
        expect(x86.key.target).to_equal("x86_64")
        expect(container.key.kind).to_equal(SESSION_KIND_CONTAINER)
        expect(arm.pid).to_equal(0)
        expect(arm.status).to_equal(LEASE_IDLE)
        expect(broker.active_count()).to_equal(0)
        step("Require unimplemented execution to report failure rather than a passing test")
        val result = broker.execute_in_session(container.session_id, "test/container_probe_spec.spl", 1000)
        expect(result.test_path).to_equal("test/container_probe_spec.spl")
        expect(result.status).to_equal(TRESP_FAILED)
        expect(result.passed).to_equal(0)
        expect(result.failed).to_equal(1)
        expect(result.output).to_contain("no adapter implementation")
        step("Stop only the container lease and preserve all architecture leases")
        expect(broker.stop_session(container.session_id)).to_equal(true)
        expect(broker.total_count()).to_equal(3)
        expect(broker.count_by_kind(SESSION_KIND_QEMU_VM)).to_equal(3)
        expect(broker.count_by_kind(SESSION_KIND_CONTAINER)).to_equal(0)
        broker.shutdown_all()
        expect(broker.total_count()).to_equal(0)

    it "should reuse a released matching lease without changing another architecture's bookkeeping":
        step("Acquire two architecture leases through the default adapter descriptor")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        val meta = _multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_SHARED_READ_ONLY)
        val arm = broker.acquire(meta)
        val riscv = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "riscv64", REUSE_SHARED_READ_ONLY))
        expect(arm.test_count).to_equal(1)
        step("Release and reacquire only the ARM64 lease")
        broker.release(arm.session_id)
        val reused = broker.acquire(meta)
        expect(reused.session_id).to_equal(arm.session_id)
        expect(reused.test_count).to_equal(2)
        expect(broker.total_count()).to_equal(2)
        var found_riscv = false
        for lease in broker.leases:
            if lease.session_id == riscv.session_id:
                found_riscv = true
                expect(lease.test_count).to_equal(1)
                expect(lease.key.target).to_equal("riscv64")
        expect(found_riscv).to_equal(true)
        step("Remove the reused lease without removing its neighbor")
        expect(broker.stop_session(reused.session_id)).to_equal(true)
        if broker.leases.len() == 1:
            expect(broker.leases[0].session_id).to_equal(riscv.session_id)
        else:
            fail("Expected one remaining architecture lease, got {broker.leases.len()}")
        broker.shutdown_all()
        expect(broker.total_count()).to_equal(0)

    it "should give identical fresh-per-test requests independently addressable leases":
        step("Acquire a fresh lease, release it, and acquire the identical request again")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        val meta = _multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_FRESH_PER_TEST)
        val first = broker.acquire(meta)
        broker.release(first.session_id)
        val second = broker.acquire(meta)
        expect(broker.total_count()).to_equal(2)
        expect(first.session_id != second.session_id).to_equal(true)
        expect(first.test_count).to_equal(1)
        expect(second.test_count).to_equal(1)
        step("Stop the first fresh instance while preserving the second instance")
        expect(broker.stop_session(first.session_id)).to_equal(true)
        if broker.leases.len() == 1:
            expect(broker.leases[0].session_id).to_equal(second.session_id)
        else:
            fail("Stopping one fresh instance must leave the other; got {broker.leases.len()} leases")
        broker.shutdown_all()
        expect(broker.total_count()).to_equal(0)

    it "should enforce the per-kind session cap for fresh-per-test requests":
        step("Limit QEMU leases to one while retaining an independent container slot")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        broker.register_adapter(session_adapter_new(SESSION_KIND_CONTAINER, "container-descriptor"))
        broker.max_sessions["qemu_vm"] = 1
        val meta = _multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_FRESH_PER_TEST)
        broker.acquire(meta)
        expect(broker.count_by_kind(SESSION_KIND_QEMU_VM)).to_equal(1)
        step("Request a second fresh instance without allowing the pool to exceed its cap")
        broker.acquire(meta)
        expect(broker.count_by_kind(SESSION_KIND_QEMU_VM)).to_equal(1)
        # An idle lease may be replaced, or admission may be refused. Neither
        # policy permits exceeding the configured per-kind maximum.
        step("Admit the independent container kind within its own budget")
        broker.acquire(_multi_session_meta(SESSION_KIND_CONTAINER, "arm64", REUSE_FRESH_PER_TEST))
        expect(broker.count_by_kind(SESSION_KIND_CONTAINER)).to_equal(1)
        expect(broker.total_count()).to_equal(2)
        broker.shutdown_all()
        expect(broker.total_count()).to_equal(0)

    it "should refuse new leases when the session kind has zero capacity":
        step("Disable QEMU admission and request a fresh lease")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        broker.max_sessions["qemu_vm"] = 0
        val refused = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_FRESH_PER_TEST))
        expect(broker.total_count()).to_equal(0)
        expect(refused.pid).to_equal(0)
        expect(refused.test_count).to_equal(0)

    it "should preserve an occupied lease when a fresh request reaches an all-active cap":
        step("Acquire and reuse one lease to exercise the broker active bookkeeping path")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        broker.max_sessions["qemu_vm"] = 1
        val shared = _multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_SHARED_READ_ONLY)
        val initial = broker.acquire(shared)
        broker.release(initial.session_id)
        val occupied = broker.acquire(shared)
        expect(broker.active_count()).to_equal(1)
        step("Request fresh capacity and require the existing active lease to survive")
        val refused = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_FRESH_PER_TEST))
        expect(broker.total_count()).to_equal(1)
        expect(broker.active_count()).to_equal(1)
        expect(refused.test_count).to_equal(0)
        if broker.leases.len() == 1:
            expect(broker.leases[0].session_id).to_equal(occupied.session_id)
            expect(broker.leases[0].test_count).to_equal(2)
        else:
            fail("Capacity refusal must preserve exactly the occupied lease")
        broker.shutdown_all()

    it "should refuse extra admission when the configured cap is below the existing pool size":
        step("Acquire two architecture leases before lowering their shared kind limit")
        var broker = session_broker_new()
        broker.register_adapter(session_adapter_new(SESSION_KIND_QEMU_VM, "qemu-descriptor"))
        broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "arm64", REUSE_FRESH_PER_TEST))
        broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "riscv64", REUSE_FRESH_PER_TEST))
        expect(broker.total_count()).to_equal(2)
        broker.max_sessions["qemu_vm"] = 1
        step("Refuse a third architecture without replacing existing leases above capacity")
        val refused = broker.acquire(_multi_session_meta(SESSION_KIND_QEMU_VM, "x86_64", REUSE_FRESH_PER_TEST))
        expect(broker.total_count()).to_equal(2)
        expect(refused.test_count).to_equal(0)
        for lease in broker.leases:
            expect(lease.key.target != "x86_64").to_equal(true)
        broker.shutdown_all()
