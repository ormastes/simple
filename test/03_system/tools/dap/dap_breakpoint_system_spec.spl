# @cover src/lib/nogc_sync_mut/dap/breakpoints.spl 80%
# @cover src/lib/nogc_sync_mut/dap/server.spl 60%
# @cover src/app/dap/hooks.spl 60%
# DAP System Test: Breakpoint Set/Resolve
# tag: slow, system
#
# Tests that DAP breakpoint modules can be loaded and that running programs
# with breakpoint-representative patterns doesn't crash.
# Verifies DAP module parsing via lint and samples app files for execution safety.

extern fn rt_dir_list(path: text) -> [text]
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64

fn find_simple_binary() -> text:
    if rt_file_exists("src/compiler_rust/target/release/simple"):
        return "src/compiler_rust/target/release/simple"
    if rt_file_exists("src/compiler_rust/target/bootstrap/simple"):
        return "src/compiler_rust/target/bootstrap/simple"
    if rt_file_exists("bin/simple"):
        return "bin/simple"
    if rt_file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if rt_file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if rt_file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if rt_file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if rt_file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

fn _check_release_binary() -> bool:
    val simple_bin = find_simple_binary()
    if simple_bin == "" or not rt_file_exists(simple_bin):
        print "SKIP: Simple runtime not found"
        false
    else:
        val (stdout, stderr, code) = rt_process_run(simple_bin, ["--version"])
        if code > 1:
            print "SKIP: Simple runtime not executable on this platform"
            false
        else:
            true

val _can_run = _check_release_binary()

fn find_spl_files(dir: text) -> [text]:
    var result: [text] = []
    val entries = rt_dir_list(dir) ?? []
    var i = 0
    while i < entries.len():
        val name = entries[i]
        val full = "{dir}/{name}"
        if name.ends_with(".spl"):
            result.push(full)
        elif not name.starts_with("."):
            val subs = find_spl_files(full)
            var j = 0
            while j < subs.len():
                result.push(subs[j])
                j = j + 1
        i = i + 1
    result

fn tmp_dir() -> text:
    val pid = rt_getpid()
    val ts = rt_time_now_unix_micros()
    "/tmp/dap_test_{pid}_{ts}"

fn run_file(file: text) -> i64:
    val (stdout, stderr, code) = rt_process_run(find_simple_binary(), ["run", file])
    code

fn run_file_with_timeout(file: text) -> i64:
    # Run a .spl file; if it takes too long, it may hang (timeout handled by test runner)
    val (stdout, stderr, code) = rt_process_run(find_simple_binary(), ["run", file])
    code

fn report_crashes(label: text, crashes: [text]) -> i64:
    if crashes.len() == 0:
        print "  PASS: {label} — 0 crashes"
    else:
        print "  FAIL: {label} — {crashes.len()} crashes:"
        var k = 0
        while k < crashes.len():
            print "    - {crashes[k]}"
            k = k + 1
    crashes.len()

# Collect DAP module files to verify they parse
var dap_files = find_spl_files("src/lib/nogc_sync_mut/dap")
print "DAP System: breakpoints — found {dap_files.len()} DAP module files"

# `simple check` costs ~100 seconds of CPU PER FILE (measured 2026-08-09 on
# x86_64-unknown-linux-gnu: one file = 1m42s wall, and `simple check <dir>`
# spawns one worker process per file). A whole-tree target is therefore not a
# slow test, it is an unbounded one: `check src/app` is 2,544 files ~= 70 hours,
# which is why this spec previously never terminated. Every target here must be
# a FILE LIST capped by MAX_CHECK_FILES so the worst-case runtime is stated up
# front. See doc/08_tracking/bug/
# dap_breakpoint_system_spec_never_terminates_blocks_five_specs_2026-08-09.md
val MAX_CHECK_FILES = 2

fn capped_files(dir: text) -> [text]:
    val all = find_spl_files(dir)
    var picked: [text] = []
    var idx = 0
    while idx < all.len() and picked.len() < MAX_CHECK_FILES:
        picked.push(all[idx])
        idx = idx + 1
    picked

fn check_parse_files(files: [text]) -> [text]:
    var crashes: [text] = []
    var idx = 0
    while idx < files.len():
        val (stdout, stderr, code) = rt_process_run(find_simple_binary(), ["check", files[idx]])
        if code > 1:
            crashes.push(files[idx])
        idx = idx + 1
    crashes

describe "DAP System: breakpoint resolution":
    slow_it "DAP library modules parse without crashes":
        if _can_run:
            val targets = capped_files("src/lib/nogc_sync_mut/dap")
            val crashes = check_parse_files(targets)
            report_crashes("DAP module parse ({targets.len()} file(s))", crashes)
            expect(crashes.len()).to_equal(0)
        else:
            print "SKIP: Simple runtime not available"

    slow_it "DAP app modules parse without crashes":
        if _can_run:
            # Scoped to src/app/dap — the `@cover` subject of this spec. The
            # previous `src/app` whole-tree target was both out of scope for a
            # DAP spec and unbounded.
            val targets = capped_files("src/app/dap")
            val crashes = check_parse_files(targets)
            report_crashes("DAP app parse ({targets.len()} file(s))", crashes)
            expect(crashes.len()).to_equal(0)
        else:
            print "SKIP: Simple runtime not available"
