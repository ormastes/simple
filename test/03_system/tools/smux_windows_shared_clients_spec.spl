# @cover src/lib/nogc_async_mut/sosix/host_facade.spl 80%
"""
## Purpose and audience
Canonical live-host SSpec admission for the actual native same-session smux
client fixture. Maintainers supply real prebuilt fixture and product executables
through SMUX_SHARED_CLIENTS_FIXTURE and SMUX_TEST_BINARY. Nothing builds here.
## Evidence boundary
UNEXECUTED: Windows, both admitted producer cohorts, native configured owners,
and an external process-tree/Job watchdog remain required execution gates.
The facade timeout is 180000 ms; it cannot by itself prove whole-tree teardown
if a native provider fails to return. The fixture must finish all owned cleanup
before printing its exact PASS line and exiting zero. Golden stdout is never
read as observed evidence. Console mode restoration has a separate fixture.
The shared fixture observes client resize and production frame dimensions;
child-computed console dimensions and Unicode delivery retain separate gates.
**Execution Captures:** build/test-artifacts/03_system/tools/smux_windows_shared_clients/fixture_exec.txt
**Log Captures:** build/test-artifacts/03_system/tools/smux_windows_shared_clients/fixture_process.log
# @manual: primary
# @capture: exec
# @evidence-display: links
"""

# codex-system-test
use std.spec.{describe, it, expect, step}
use std.nogc_async_mut.sosix.{sosix_platform}
use app.io.mod.{env_get, file_exists, file_read, file_write, dir_create_all, process_run_timeout}
use std.common.spec.scenario_helpers.{capture_exec_detailed, capture_log}

# @inline
fn shared_clients_binary(name: text) -> text:
    val path = env_get(name)
    expect(path.len()).to_be_greater_than(0)
    expect(path.ends_with(".exe")).to_equal(true)
    expect(file_exists(path)).to_equal(true)
    return path

describe "smux Windows actual shared-session terminal clients":
    it "should preserve local selections and shared resize while detach leaves the sibling functional":
        # @req REQ-SMUX-INTERACTIVE-003
        # @req REQ-SMUX-INTERACTIVE-006
        # @req REQ-SMUX-INTERACTIVE-002
        # @req REQ-SMUX-WIN-003
        # @req REQ-SMUX-WIN-005
        step("Require native Windows and the actual prebuilt fixture and smux product")
        expect(sosix_platform()).to_equal("windows")
        val fixture = shared_clients_binary("SMUX_SHARED_CLIENTS_FIXTURE")
        val product = shared_clients_binary("SMUX_TEST_BINARY")
        expect(fixture == product).to_equal(false)
        step("Run the real fixture with the real product argument and a finite process timeout")
        val (stdout, stderr, code) = process_run_timeout(fixture, [product], 180000)
        step("Attach execution and process-log evidence from the actual process result")
        val execution = capture_exec_detailed(
            "Actual native shared-session client fixture",
            fixture,
            product,
            "Native fixture launches real owner and two same-session interactive clients",
            stdout,
            stderr,
            code as i64)
        val process_log = capture_log("Actual fixture stdout and stderr", [
            "fixture: " + fixture,
            "product: " + product,
            "timeout-ms: 180000",
            "exit: " + code.to_text(),
            "stdout:", stdout,
            "stderr:", stderr])
        val configured = env_get("SMUX_SHARED_CLIENTS_EVIDENCE_DIR")
        val evidence_dir = if configured == "": "build/test-artifacts/03_system/tools/smux_windows_shared_clients" else: configured
        val directory_ready = dir_create_all(evidence_dir)
        val exec_path = evidence_dir + "/fixture_exec.txt"
        val log_path = evidence_dir + "/fixture_process.log"
        val exec_written = file_write(exec_path, execution.body)
        val log_written = file_write(log_path, process_log.body)
        step("Require observed successful exit and the exact cleanup-qualified PASS output")
        expect(code).to_equal(0)
        expect(stdout.replace("\r\n", "\n")).to_equal("Windows smux shared clients PASS\n")
        expect(stderr).to_equal("")
        step("Verify the linked execution and log artifacts preserve the observed result")
        expect(directory_ready).to_equal(true)
        expect(exec_written).to_equal(true)
        expect(log_written).to_equal(true)
        expect(file_read(exec_path)).to_equal(execution.body)
        expect(file_read(log_path)).to_equal(process_log.body)
