# 4. ChaosScheduler — all strategies
# ============================================================
describe "ChaosScheduler - empty runnable returns -1":
    it "Random returns -1 for empty list":
        step("Verify: Random returns -1 for empty list")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.Random, 42)
        val chosen = s.pick_next([])
        expect(chosen).to_equal(-1)  # oracle: value fixed by the spec contract

    it "RoundRobin returns -1 for empty list":
        step("Verify: RoundRobin returns -1 for empty list")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.RoundRobin, 42)
        val chosen = s.pick_next([])
        expect(chosen).to_equal(-1)  # oracle: value fixed by the spec contract

    it "StarveLast returns -1 for empty list":
        step("Verify: StarveLast returns -1 for empty list")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.StarveLast, 42)
        val chosen = s.pick_next([])
        expect(chosen).to_equal(-1)  # oracle: value fixed by the spec contract

    it "PrioritizeNew returns -1 for empty list":
        step("Verify: PrioritizeNew returns -1 for empty list")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.PrioritizeNew, 42)
        val chosen = s.pick_next([])
        expect(chosen).to_equal(-1)  # oracle: value fixed by the spec contract

describe "ChaosScheduler - single thread list":
    it "Random picks the only thread":
        step("Verify: Random picks the only thread")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.Random, 1)
        val chosen = s.pick_next([99])
        expect(chosen).to_equal(99)  # oracle: value fixed by the spec contract

    it "RoundRobin picks the only thread":
        step("Verify: RoundRobin picks the only thread")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.RoundRobin, 1)
        val chosen = s.pick_next([99])
        expect(chosen).to_equal(99)  # oracle: value fixed by the spec contract

    it "StarveLast picks the only thread":
        step("Verify: StarveLast picks the only thread")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.StarveLast, 1)
        val chosen = s.pick_next([99])
        expect(chosen).to_equal(99)  # oracle: value fixed by the spec contract

    it "PrioritizeNew picks the only thread":
        step("Verify: PrioritizeNew picks the only thread")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.PrioritizeNew, 1)
        val chosen = s.pick_next([99])
        expect(chosen).to_equal(99)  # oracle: value fixed by the spec contract

describe "ChaosScheduler - schedule_log grows":
    it "Random pick grows schedule_log by 1":
        step("Verify: Random pick grows schedule_log by 1")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.Random, 7)
        s.pick_next([1, 2, 3])
        expect(s.schedule_log.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "RoundRobin two picks grows schedule_log to 2":
        step("Verify: RoundRobin two picks grows schedule_log to 2")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var s = ChaosScheduler.create(ChaosStrategy.RoundRobin, 7)
        s.pick_next([10, 20])
        s.pick_next([10, 20])
        expect(s.schedule_log.len()).to_equal(2)  # oracle: value fixed by the spec contract

