describe "PageCheckpoint creation":
    it "create stores checkpoint_id":
        step("Verify: create stores checkpoint_id")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(5, 100)
        expect(c.checkpoint_id).to_equal(5)  # oracle: value fixed by the spec contract

    it "create stores event_seq":
        step("Verify: create stores event_seq")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(5, 100)
        expect(c.event_seq).to_equal(100)  # oracle: value fixed by the spec contract

    it "create sets pid to zero":
        step("Verify: create sets pid to zero")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(5, 100)
        expect(c.pid).to_equal(0)  # oracle: value fixed by the spec contract

    it "create starts with empty register_state":
        step("Verify: create starts with empty register_state")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(5, 100)
        expect(c.register_state.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "create starts with empty dirty_pages":
        step("Verify: create starts with empty dirty_pages")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(5, 100)
        expect(c.dirty_pages.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "create_for_pid stores pid":
        step("Verify: create_for_pid stores pid")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create_for_pid(1, 50, 9876)
        expect(c.pid).to_equal(9876)  # oracle: value fixed by the spec contract

    it "create_for_pid stores event_seq":
        step("Verify: create_for_pid stores event_seq")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create_for_pid(1, 50, 9876)
        expect(c.event_seq).to_equal(50)  # oracle: value fixed by the spec contract

    it "summary returns non-empty text":
        step("Verify: summary returns non-empty text")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(3, 200)
        val s = c.summary()
        expect(s.len()).to_be_greater_than(0)

    it "get_register returns None for unknown name":
        step("Verify: get_register returns None for unknown name")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val c = PageCheckpoint.create(1, 10)
        val found = c.get_register("rip")
        match found:
            case None: expect(found.is_none()).to_equal(true)
            case Some(x): expect(false).to_equal(true)

