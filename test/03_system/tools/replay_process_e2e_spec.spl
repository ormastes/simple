describe "ThreadRecorder on_thread_create":
    it "adds parent and child to active_threads":
        step("Verify: adds parent and child to active_threads")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_create(1000, 1001, 9999)
        expect(tr.thread_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "records creates entry":
        step("Verify: records creates entry")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_create(1000, 1001, 9999)
        expect(tr.creates.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "second child does not double-add parent":
        step("Verify: second child does not double-add parent")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_create(1000, 1001, 9999)
        tr.on_thread_create(1000, 1002, 10000)
        expect(tr.thread_count()).to_equal(3)  # oracle: value fixed by the spec contract

describe "ThreadRecorder on_thread_switch":
    it "records a switch event":
        step("Verify: records a switch event")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_switch(1000, 1001, 0, 5000)
        expect(tr.switch_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "get_schedule_order returns to_tid sequence":
        step("Verify: get_schedule_order returns to_tid sequence")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_switch(10, 20, 0, 100)
        tr.on_thread_switch(20, 30, 0, 200)
        val order = tr.get_schedule_order()
        expect(order.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(order[0]).to_equal(20)  # oracle: value fixed by the spec contract
        expect(order[1]).to_equal(30)  # oracle: value fixed by the spec contract

describe "ThreadRecorder on_thread_exit":
    it "removes thread from active set":
        step("Verify: removes thread from active set")
        # @req: REQ-TOOLS-ReplProcE2e-001
        var tr = ThreadRecorder.create()
        tr.on_thread_create(1000, 1001, 100)
        tr.on_thread_exit(1001, 200)
        expect(tr.thread_count()).to_equal(1)  # oracle: value fixed by the spec contract

