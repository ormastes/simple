describe "ProcessReplayEvent constructors":
    it "syscall_entry sets kind to SyscallEntry":
        step("Verify: syscall_entry sets kind to SyscallEntry")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 0, 0)
        expect(ev.kind).to_equal(ProcessEventKind.SyscallEntry.to_i32())

    it "syscall_entry stores seq":
        step("Verify: syscall_entry stores seq")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(7, 100, 999, 60, 0, 0)
        expect(ev.seq).to_equal(7)  # oracle: value fixed by the spec contract

    it "syscall_entry stores tid":
        step("Verify: syscall_entry stores tid")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(1, 42, 999, 60, 0, 0)
        expect(ev.tid).to_equal(42)  # oracle: value fixed by the spec contract

    it "syscall_entry stores syscall_nr in payload_a":
        step("Verify: syscall_entry stores syscall_nr in payload_a")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 3, 4)
        expect(ev.payload_a).to_equal(60)  # oracle: value fixed by the spec contract

    it "syscall_exit sets kind to SyscallExit":
        step("Verify: syscall_exit sets kind to SyscallExit")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_exit(2, 100, 999, 0)
        expect(ev.kind).to_equal(ProcessEventKind.SyscallExit.to_i32())

    it "syscall_exit stores retval in payload_a":
        step("Verify: syscall_exit stores retval in payload_a")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_exit(2, 100, 999, 42)
        expect(ev.payload_a).to_equal(42)  # oracle: value fixed by the spec contract

    it "signal_event sets kind to Signal":
        step("Verify: signal_event sets kind to Signal")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.signal_event(3, 100, 999, 11)
        expect(ev.kind).to_equal(ProcessEventKind.Signal.to_i32())

    it "signal_event stores signum in payload_a":
        step("Verify: signal_event stores signum in payload_a")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.signal_event(3, 100, 999, 11)
        expect(ev.payload_a).to_equal(11)  # oracle: value fixed by the spec contract

    it "exit_event sets kind to ProcessExit":
        step("Verify: exit_event sets kind to ProcessExit")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.exit_event(4, 100, 999, 0)
        expect(ev.kind).to_equal(ProcessEventKind.ProcessExit.to_i32())

    it "exit_event stores exit_code in payload_a":
        step("Verify: exit_event stores exit_code in payload_a")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.exit_event(4, 100, 999, 1)
        expect(ev.payload_a).to_equal(1)  # oracle: value fixed by the spec contract

    it "event_kind returns correct kind for syscall_entry event":
        step("Verify: event_kind returns correct kind for syscall_entry event")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 0, 0)
        val k = ev.event_kind()
        expect(k.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "summary returns non-empty text":
        step("Verify: summary returns non-empty text")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val ev = ProcessReplayEvent.syscall_entry(1, 100, 999, 60, 0, 0)
        val s = ev.summary()
        expect(s.len()).to_be_greater_than(0)

