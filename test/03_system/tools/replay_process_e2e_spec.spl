# SReplay Process Recording E2E Spec
# Tests recorder/replayer/checkpoint at mock level (no live ptrace).
# tag: system

"""
## Purpose and audience
Purpose: events list is empty
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplProcE2e-001

use std.nogc_sync_mut.replay.process.event_types.{ProcessEventKind, ProcessReplayEvent}
use std.nogc_sync_mut.replay.process.recorder.{ProcessRecorder}
use std.nogc_sync_mut.replay.process.replayer.{ProcessReplayer}
use std.nogc_sync_mut.replay.process.checkpoint.{PageCheckpoint, CheckpointManager, DirtyPage, RegisterEntry}
use std.nogc_sync_mut.replay.process.chaos_scheduler.{ChaosScheduler, ChaosStrategy}
use std.nogc_sync_mut.replay.process.thread_recorder.{ThreadRecorder}

# ============================================================
# 1. ProcessRecorder — initial state
# ============================================================
use std.spec.step
describe "ProcessRecorder initial state":
    it "events list is empty":
        step("Verify: events list is empty")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.events.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "next_seq starts at zero":
        step("Verify: next_seq starts at zero")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.next_seq).to_equal(0)  # oracle: value fixed by the spec contract

    it "pid starts at zero":
        step("Verify: pid starts at zero")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.pid).to_equal(0)  # oracle: value fixed by the spec contract

    it "strace_path is empty":
        step("Verify: strace_path is empty")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.strace_path).to_equal("")

    it "pending_syscall_id is -1":
        step("Verify: pending_syscall_id is -1")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.pending_syscall_id).to_equal(-1)  # oracle: value fixed by the spec contract

    it "command field is stored":
        step("Verify: command field is stored")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.command).to_equal("echo hello")

    it "trace_dir field is stored":
        step("Verify: trace_dir field is stored")
        # @req: REQ-TOOLS-ReplProcE2e-001
        val r = ProcessRecorder.create("echo hello", "/tmp/traces")
        expect(r.trace_dir).to_equal("/tmp/traces")

