# AUTHORED_NOT_RUN. Requires an administrator-prepared disposable Linux host,
# running on the dedicated nonroot service UID's actual main thread. It does
# not install policy, create the fixed private tree, elevate or run Podman.
# Existing binding may be created; never point this fixture at a live ledger.
# @req REQ-LINUX-MACHINE-STORAGE-001
# @req REQ-LINUX-MACHINE-STORAGE-002
# @req REQ-LINUX-MACHINE-STORAGE-003
use std.spec.{describe, it, expect, step}
use std.common.crypto.sha256.sha256_text
use std.common.text_bytes.{bytes_to_text, utf8_bytes_valid}
use std.common.contracts.container.machine_policy_v1.machine_container_policy_decode_v1
use std.nogc_async_mut.container.providers.linux.engine_policy_v1.linux_oci_engine_policy_decode_v1
use std.nogc_sync_mut.io.linux_machine_policy_owner_v1.*
use std.nogc_sync_mut.database.wal.{WalEntry, WalEntryType}

# Failed acquisition/transfer owners are retained before reporting failures.
# A copied snapshot or a caller path cannot manufacture these private owners.
var linux_storage_readers_v1: [LinuxMachinePolicyOwnerV1] = []
var linux_storage_stores_v1: [LinuxMachineStorageV1] = []

fn linux_storage_reader_v1() -> Result<LinuxMachinePolicyOwnerV1, text>:
    match linux_machine_policy_open_v1():
        case LinuxMachinePolicyOpenV1.Ready(reader):
            linux_storage_readers_v1.push(reader)
            Ok(reader)
        case LinuxMachinePolicyOpenV1.CleanupRequired(reader, reason):
            linux_storage_readers_v1.push(reader)
            Err(reason + ":cleanup=" + reader.close_v1())
        case LinuxMachinePolicyOpenV1.Rejected(reason): Err(reason)

fn linux_storage_transfer_v1(reader: LinuxMachinePolicyOwnerV1) -> Result<LinuxMachineStorageV1, text>:
    match reader.open_storage_v1():
        case LinuxMachineStorageOpenV1.Ready(store):
            linux_storage_stores_v1.push(store)
            Ok(store)
        case LinuxMachineStorageOpenV1.CleanupRequired(store, reason):
            linux_storage_stores_v1.push(store)
            Err(reason + ":cleanup=" + store.close_v1())
        case LinuxMachineStorageOpenV1.Rejected(reason): Err(reason + ":reader-cleanup=" + reader.close_v1())

fn linux_storage_competitor_v1() -> Result<(bool, text), text>:
    val reader = linux_storage_reader_v1()?
    match reader.open_storage_v1():
        case LinuxMachineStorageOpenV1.Ready(store):
            linux_storage_stores_v1.push(store)
            Ok((false, store.close_v1()))
        case LinuxMachineStorageOpenV1.CleanupRequired(store, reason):
            linux_storage_stores_v1.push(store)
            Ok((reason != "", store.close_v1()))
        case LinuxMachineStorageOpenV1.Rejected(reason): Ok((reason != "", reader.close_v1()))

describe "Actual installed Linux machine storage v1":
    it "binds one native service process and one shared writer without resetting an uncertain ledger":
        step("Read actual administrator policy and current native process identity")
        val reader = linux_storage_reader_v1().unwrap()
        val context = reader.actual_process_context_v1().unwrap()
        val principal = reader.actual_process_principal_v1().unwrap()
        expect(context.real_uid).to_equal(context.effective_uid)
        expect(context.effective_uid).to_be_greater_than(0)
        expect(context.thread_id).to_equal(context.process_id)
        expect(principal.platform).to_equal("linux")
        expect(principal.principal_id).to_equal("linux:uid:" + str(context.effective_uid))
        expect(principal.identity_digest).to_equal(context.identity_digest)
        expect(principal.authority_namespace_id).to_equal(context.authority_namespace_id)
        expect(context.identity_digest.byte_len()).to_equal(64)
        expect(context.authority_namespace_id.byte_len()).to_equal(64)
        val bytes = reader.read_policy_v1().unwrap()
        expect(utf8_bytes_valid(bytes)).to_equal(true)
        val source = bytes_to_text(bytes)
        val policy = machine_container_policy_decode_v1(source).unwrap()
        var matched_provider = false
        for provider in policy.providers:
            if provider.backend == "linux-podman":
                val installed = linux_oci_engine_policy_decode_v1(provider.policy_bytes).unwrap()
                expect(installed.expected_uid).to_equal(context.effective_uid)
                matched_provider = true
        expect(matched_provider).to_equal(true)

        step("Transfer the reader into the fixed delegated state and retain its sole writer")
        val store = linux_storage_transfer_v1(reader).unwrap()
        expect(reader.read_policy_v1().is_err()).to_equal(true)
        expect(reader.actual_process_context_v1().is_err()).to_equal(true)
        expect(reader.close_v1()).to_equal("retained")
        val bound = store.bind_policy_v1(source).unwrap()
        expect(bound).to_equal(sha256_text(source))
        val different = store.bind_policy_v1(source + "\n")
        expect(different.is_err()).to_equal(true)
        expect(different.unwrap_err()).to_equal("linux-machine-policy-binding-exact-bytes-differ")
        val physical = store.physical_capacity_v1().unwrap()
        expect(physical.0).to_be_greater_than(0)
        expect(physical.1).to_be_greater_than(0)
        val head = store.wal_head_v1().unwrap()

        step("Reject a competing actual writer and close all of its returned owners")
        val competitor = linux_storage_competitor_v1().unwrap()
        expect(competitor.0).to_equal(true)
        expect(competitor.1).to_equal("released")

        step("Refuse a new charge without the actual migration fence and preserve the current head")
        val entries = [WalEntry(0, WalEntryType.Insert, "fixture-request", "charge", "must-not-publish", 1)]
        val refused = store.wal_commit_v1("", entries)
        expect(refused.is_err()).to_equal(true)
        expect(refused.unwrap_err()).to_equal("machine-container-migration-fence-unavailable")
        expect(store.wal_head_v1().unwrap()).to_equal(head)

        step("Consume the exact native owners once and reject all closed aliases")
        expect(store.close_v1()).to_equal("released")
        expect(store.wal_head_v1().is_err()).to_equal(true)
        expect(store.close_v1()).to_equal("stale")
        expect(reader.close_v1()).to_equal("stale")

        step("Reopen after every capsule closes while keeping the same process-lifetime origin")
        val next = linux_storage_reader_v1().unwrap()
        val next_context = next.actual_process_context_v1().unwrap()
        expect(next_context.identity_digest).to_equal(context.identity_digest)
        expect(next_context.generation).to_be_greater_than(context.generation)
        expect(next.close_v1()).to_equal("released")
