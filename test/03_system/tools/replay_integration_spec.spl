"""
## Purpose and audience
Purpose: create sets session_id and trace_dir
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplInte-001

use std.spec
use std.nogc_sync_mut.replay.integration.{ReplayTrack, IntegratedSession}

use std.spec.step
describe "IntegratedSession create":
    it "create sets session_id and trace_dir":
        step("Verify: create sets session_id and trace_dir")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-001", "/tmp/traces/sess-001")
        expect(s.session_id).to_equal("sess-001")
        expect(s.trace_dir).to_equal("/tmp/traces/sess-001")

    it "create starts with no active tracks":
        step("Verify: create starts with no active tracks")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-002", "/tmp/t")
        expect(s.track_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "create starts not recording and not replaying":
        step("Verify: create starts not recording and not replaying")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-003", "/tmp/t")
        expect(s.recording).to_equal(false)
        expect(s.replaying).to_equal(false)

describe "IntegratedSession enable_track and disable_track":
    it "enable_track adds a track":
        step("Verify: enable_track adds a track")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-004", "/tmp/t")
        s.enable_track(ReplayTrack.QEMU)
        expect(s.track_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "enable_track is idempotent":
        step("Verify: enable_track is idempotent")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-005", "/tmp/t")
        s.enable_track(ReplayTrack.ProcessRR)
        s.enable_track(ReplayTrack.ProcessRR)
        expect(s.track_count()).to_equal(1)  # oracle: value fixed by the spec contract

    it "enable_track multiple distinct tracks":
        step("Verify: enable_track multiple distinct tracks")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-006", "/tmp/t")
        s.enable_track(ReplayTrack.QEMU)
        s.enable_track(ReplayTrack.SemanticTrace)
        s.enable_track(ReplayTrack.VmReplay)
        expect(s.track_count()).to_equal(3)  # oracle: value fixed by the spec contract

    it "disable_track removes a track":
        step("Verify: disable_track removes a track")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-007", "/tmp/t")
        s.enable_track(ReplayTrack.QEMU)
        s.enable_track(ReplayTrack.KernelEventLog)
        s.disable_track(ReplayTrack.QEMU)
        expect(s.track_count()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(s.is_track_enabled(ReplayTrack.QEMU)).to_equal(false)
        expect(s.is_track_enabled(ReplayTrack.KernelEventLog)).to_equal(true)

describe "IntegratedSession is_track_enabled":
    it "returns false when track is not active":
        step("Verify: returns false when track is not active")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-008", "/tmp/t")
        expect(s.is_track_enabled(ReplayTrack.ContainerCheckpoint)).to_equal(false)

    it "returns true after enabling a track":
        step("Verify: returns true after enabling a track")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-009", "/tmp/t")
        s.enable_track(ReplayTrack.SemanticTrace)
        expect(s.is_track_enabled(ReplayTrack.SemanticTrace)).to_equal(true)

describe "IntegratedSession start_recording and stop_recording":
    it "start_recording sets recording flag":
        step("Verify: start_recording sets recording flag")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-010", "/tmp/t")
        s.enable_track(ReplayTrack.QEMU)
        val r = s.start_recording()
        expect(s.recording).to_equal(true)

    it "stop_recording clears recording flag":
        step("Verify: stop_recording clears recording flag")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-011", "/tmp/t")
        s.enable_track(ReplayTrack.QEMU)
        s.start_recording()
        val r = s.stop_recording()
        expect(s.recording).to_equal(false)

describe "IntegratedSession start_replay and stop_replay":
    it "start_replay sets replaying flag":
        step("Verify: start_replay sets replaying flag")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-012", "/tmp/t")
        val r = s.start_replay()
        expect(s.replaying).to_equal(true)

    it "stop_replay clears replaying flag":
        step("Verify: stop_replay clears replaying flag")
        # @req: REQ-TOOLS-ReplInte-001
        var s = IntegratedSession.create("sess-013", "/tmp/t")
        s.start_replay()
        val r = s.stop_replay()
        expect(s.replaying).to_equal(false)

describe "IntegratedSession status":
    it "status contains session_id":
        step("Verify: status contains session_id")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-014", "/tmp/t")
        val out = s.status()
        expect(out).to_contain("sess-014")

    it "status contains trace_dir":
        step("Verify: status contains trace_dir")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-015", "/tmp/traces/x")
        val out = s.status()
        expect(out).to_contain("/tmp/traces/x")

    it "status shows idle when not recording or replaying":
        step("Verify: status shows idle when not recording or replaying")
        # @req: REQ-TOOLS-ReplInte-001
        val s = IntegratedSession.create("sess-016", "/tmp/t")
        val out = s.status()
        expect(out).to_contain("idle")

describe "ReplayTrack to_i32 ordinals":
    it "QEMU is 0":
        step("Verify: QEMU is 0")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.QEMU.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "VmReplay is 5":
        step("Verify: VmReplay is 5")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.VmReplay.to_i32()).to_equal(5)  # oracle: value fixed by the spec contract

    it "ContainerCheckpoint is 4":
        step("Verify: ContainerCheckpoint is 4")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.ContainerCheckpoint.to_i32()).to_equal(4)  # oracle: value fixed by the spec contract

describe "ReplayTrack to_text":
    it "QEMU to_text returns QEMU":
        step("Verify: QEMU to_text returns QEMU")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.QEMU.to_text()).to_equal("QEMU")

    it "SemanticTrace to_text":
        step("Verify: SemanticTrace to_text")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.SemanticTrace.to_text()).to_equal("SemanticTrace")

    it "KernelEventLog to_text":
        step("Verify: KernelEventLog to_text")
        # @req: REQ-TOOLS-ReplInte-001
        expect(ReplayTrack.KernelEventLog.to_text()).to_equal("KernelEventLog")
