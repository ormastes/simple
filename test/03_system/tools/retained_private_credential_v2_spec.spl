# AUTHORED_NOT_RUN. Native cases require independently installed protected
# Windows fixture files. No fake owners, raw-path reads, unsupported skip PASS,
# build, runtime execution or generated-doc evidence is claimed here.
use std.spec.*
use std.nogc_sync_mut.io.retained_private_credential_v2.*
use std.nogc_sync_mut.io.retained_private_credential_protocol_v2.*
use std.nogc_sync_mut.io.retained_file.retained_private_credential_open_v1
use std.nogc_sync_mut.io.windows_retained_private_credential_v2.windows_retained_private_credential_open_v2
use std.nogc_sync_mut.io.windows_private_file_v1.*
use std.nogc_sync_mut.io.windows_private_read_v2.*
use std.nogc_sync_mut.io.windows_private_stage_discard_v2.*
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.sysinfo_ops.getpid
use std.nogc_sync_mut.io.tcp.TcpListener
use std.nogc_sync_mut.sosix.entropy.sosix_random_hex
use std.common.text_bytes.{bytes_to_text, text_to_utf8_bytes}

# These are actual capabilities retained for diagnosis if an assertion fails;
# neither their secret bytes nor their token/descriptor values are printed.
var credential_fixture_owners_v2: [RetainedPrivateCredentialV2] = []
var credential_fixture_roots_v2: [WindowsPrivateRootV1] = []
var credential_fixture_files_v2: [WindowsPrivateFileV1] = []

fn credential_actual_fixture_v2(variable: text) -> RetainedPrivateCredentialV2:
    if host_os() != "windows": fail("actual protected Windows credential fixture required")
    val path = env_get(variable)
    if path == "": fail("mandatory protected credential fixture variable: " + variable)
    val opened = retained_private_credential_open_v2(path)
    if opened.owner != nil: credential_fixture_owners_v2.push(opened.owner.unwrap())
    expect(opened.owner != nil).to_equal(true)
    expect(opened.error == "").to_equal(true)
    expect(opened.state).to_equal("open")
    opened.owner.unwrap()

fn credential_ready_fixture_v2(initial: [u8], address: text) -> [u8]:
    expect(retained_credential_initial_valid_v2(initial)).to_equal(true)
    val fields = bytes_to_text(initial).trim().split(" ")
    val incarnation = sosix_random_hex(16)
    expect(incarnation != nil).to_equal(true)
    text_to_utf8_bytes(fields[0] + " " + address + " " + fields[1] + " " + getpid().to_text() + " " + incarnation.unwrap() + "\n")

fn credential_stage_root_v2(parent: WindowsPrivateRootV1) -> WindowsPrivateRootV1:
    val created = parent.child_directory("stage-discard-" + sosix_random_hex(16).unwrap(), true)
    if created.is_err():
        val failure = created.unwrap_err()
        if failure.cleanup_root != nil: credential_fixture_roots_v2.push(failure.cleanup_root.unwrap())
        fail("native private stage fixture admission failed")
    val root = created.unwrap()
    credential_fixture_roots_v2.push(root)
    root

describe "Common retained credential V2 exact protocol":
    it "should reject changed identity wrong endpoint malformed pid and malformed ready framing":
        step("Exercise actual pure protocol validation with explicitly synthetic nonsecret wire examples")
        val nonce = "a".repeat(32)
        val initial = text_to_utf8_bytes(nonce + " synthetic-token\n")
        val incarnation = "b".repeat(32)
        val good = nonce + " 127.0.0.1:12345 synthetic-token 1 " + incarnation + "\n"
        expect(retained_credential_initial_valid_v2(initial)).to_equal(true)
        expect(retained_credential_ready_matches_v2(initial, text_to_utf8_bytes(good))).to_equal(true)
        for invalid in [good.replace("127.0.0.1:", "0.0.0.0:"), good.replace(":12345", ":012345"),
            good.replace(":12345", ":65536"), good.replace(" 1 ", " 0 "),
            good.replace("synthetic-token", "changed-token"), good.replace("\n", " \n"),
            good.replace("\n", "\r\n"), good + "\n"]:
            expect(retained_credential_ready_matches_v2(initial, text_to_utf8_bytes(invalid))).to_equal(false)
        expect(retained_credential_initial_valid_v2(text_to_utf8_bytes(" " + bytes_to_text(initial)))).to_equal(false)
        expect(retained_credential_initial_valid_v2(text_to_utf8_bytes(nonce + " token with spaces\n"))).to_equal(false)

    it "should preserve the unchanged legacy opening result on nonWindows targets":
        step("Reject invalid input without acquiring any owner")
        val observed = retained_private_credential_open_v2("")
        expect(observed.owner == nil).to_equal(true)
        @when(os="windows"):
        expect(observed.error).to_equal("private-credential-path-rejected")
        @else:
        val legacy = retained_private_credential_open_v1("")
        expect(observed.state).to_equal(legacy.state)
        expect(observed.error).to_equal(legacy.error)
        @end

    it "should treat a None Windows owner as absent without unwrapping it":
        step("Open an empty path directly so the Windows opening turn carries owner None")
        val direct = windows_retained_private_credential_open_v2("")
        expect(direct.owner.is_none()).to_equal(true)
        expect(direct.owner.is_some()).to_equal(false)
        expect(direct.state).to_equal("unavailable")
        expect(direct.error == "").to_equal(false)
        step("Open through the common entrypoint, which must not unwrap that None owner")
        val wrapped = retained_private_credential_open_v2("")
        expect(wrapped.owner == nil).to_equal(true)
        expect(wrapped.error == "").to_equal(false)

describe "Actual native Windows retained credential V2 lifecycle":
    it "should publish an exact ready sibling once and reject copied generations after confirmed close":
        step("Open the real protected initial credential and bind an actual loopback listener")
        val owner = credential_actual_fixture_v2("RETAINED_PRIVATE_CREDENTIAL_V2_WINDOWS_PATH")
        val copied = owner
        val initial = retained_private_credential_read_v2(owner)
        expect(initial.error == "").to_equal(true)
        val listener = TcpListener.bind("127.0.0.1:0").unwrap()
        val ready = credential_ready_fixture_v2(initial.bytes, listener.local_addr().unwrap())
        step("Publish and read back through the actual retained native stage and ready reader")
        val published = retained_private_credential_publish_v2(owner, initial.bytes, ready)
        expect(published.completed).to_equal(true)
        expect(published.consumed).to_equal(false)
        expect(published.state).to_equal("published")
        expect(published.publication_state).to_equal("published")
        expect(published.error == "").to_equal(true)
        val duplicate = retained_private_credential_publish_v2(copied, initial.bytes, ready)
        expect(duplicate.completed).to_equal(false)
        expect(duplicate.consumed).to_equal(false)
        val rechecked = retained_private_credential_read_v2(copied)
        expect(rechecked.error == "").to_equal(true)
        expect(retained_credential_bytes_equal_v2(rechecked.bytes, initial.bytes)).to_equal(true)
        step("Consume only confirmed native cleanup and keep later copied close from fabricating completion")
        val closed = retained_private_credential_close_v2(owner)
        expect(closed.completed).to_equal(true)
        expect(closed.consumed).to_equal(true)
        expect(closed.state).to_equal("closed")
        expect(closed.publication_state).to_equal("published")
        val stale = retained_private_credential_close_v2(copied)
        expect(stale.completed).to_equal(false)
        expect(stale.consumed).to_equal(false)
        expect(retained_private_credential_read_v2(copied).bytes.len()).to_equal(0)
        val socket_closed = listener.close()

    it "should retain a rejected ready owner and expose one uncertain phase to copied values":
        val owner = credential_actual_fixture_v2("RETAINED_PRIVATE_CREDENTIAL_V2_WINDOWS_INVALID_READY_PATH")
        val copied = owner
        val initial = retained_private_credential_read_v2(owner)
        expect(initial.error == "").to_equal(true)
        step("Reject malformed readiness before creating a stage and keep the actual owner for cleanup")
        val refused = retained_private_credential_publish_v2(owner, initial.bytes, text_to_utf8_bytes("not readiness\n"))
        expect(refused.completed).to_equal(false)
        expect(refused.consumed).to_equal(false)
        expect(refused.state).to_equal("uncertain")
        expect(refused.publication_state).to_equal("not-published")
        expect(refused.error).to_equal("private-credential-ready-rejected")
        expect(retained_private_credential_state_v2(copied).state).to_equal("uncertain")
        expect(retained_private_credential_read_v2(copied).bytes.len()).to_equal(0)
        val closed = retained_private_credential_close_v2(refused.owner)
        expect(closed.completed).to_equal(true)
        expect(closed.consumed).to_equal(true)
        expect(closed.publication_state).to_equal("not-published")

    it "should preserve an existing ready winner and discard only its newly created losing stage":
        val owner = credential_actual_fixture_v2("RETAINED_PRIVATE_CREDENTIAL_V2_WINDOWS_CONFLICT_PATH")
        val initial = retained_private_credential_read_v2(owner)
        expect(initial.error == "").to_equal(true)
        val listener = TcpListener.bind("127.0.0.1:0").unwrap()
        val ready = credential_ready_fixture_v2(initial.bytes, listener.local_addr().unwrap())
        step("Attempt actual kernel NO_REPLACE against the independently provisioned ready sibling")
        val conflict = retained_private_credential_publish_v2(owner, initial.bytes, ready)
        expect(conflict.completed).to_equal(false)
        expect(conflict.consumed).to_equal(false)
        expect(conflict.error).to_equal("private-credential-publication-conflict")
        expect(conflict.publication_state).to_equal("collision")
        step("Discard the actual private temporary generation without deleting the existing ready record")
        val closed = retained_private_credential_close_v2(conflict.owner)
        expect(closed.completed).to_equal(true)
        expect(closed.consumed).to_equal(true)
        expect(closed.publication_state).to_equal("collision")
        val socket_closed = listener.close()

    it "should retain actual acquired roots on a denied initial read without returning secret bytes":
        if host_os() != "windows": fail("actual protected Windows denied credential fixture required")
        val path = env_get("RETAINED_PRIVATE_CREDENTIAL_V2_WINDOWS_DENIED_PATH")
        if path == "": fail("mandatory actual denied initial credential fixture")
        val denied = retained_private_credential_open_v2(path)
        if denied.owner != nil: credential_fixture_owners_v2.push(denied.owner.unwrap())
        expect(denied.owner != nil).to_equal(true)
        expect(denied.state).to_equal("uncertain")
        expect(denied.error == "").to_equal(false)
        expect(retained_private_credential_read_v2(denied.owner.unwrap()).bytes.len()).to_equal(0)
        val closed = retained_private_credential_close_v2(denied.owner.unwrap())
        expect(closed.completed).to_equal(true)
        expect(closed.consumed).to_equal(true)

    it "should discard only an original stage and preserve a renamed ready target and replacement generation":
        if host_os() != "windows": fail("actual protected Windows stage discard fixture required")
        val path = env_get("RETAINED_PRIVATE_CREDENTIAL_V2_WINDOWS_STAGE_PARENT")
        if path == "": fail("mandatory actual protected native stage parent")
        val parent_turn = windows_private_root_open_v1(path)
        if parent_turn.is_err():
            val failure = parent_turn.unwrap_err()
            if failure.cleanup_root != nil: credential_fixture_roots_v2.push(failure.cleanup_root.unwrap())
            fail("actual protected stage parent rejected")
        var parent = parent_turn.unwrap()
        credential_fixture_roots_v2.push(parent)
        var root = credential_stage_root_v2(parent)
        var other = credential_stage_root_v2(parent)
        step("Refuse a different real root then delete only the captured original stage generation")
        var stage = root.create_private_stage(".credential-fixture-original", 512u64).unwrap()
        credential_fixture_files_v2.push(stage)
        val copied = stage
        expect(stage.write(text_to_utf8_bytes("synthetic-stage"))).to_equal(Ok(true))
        expect(stage.seal()).to_equal(Ok(true))
        val wrong = windows_private_stage_discard_v2(other, stage)
        expect(wrong.completed).to_equal(false)
        expect(wrong.stage.is_some()).to_equal(true)
        val discarded = windows_private_stage_discard_v2(root, wrong.stage.unwrap())
        expect(discarded.completed).to_equal(true)
        expect(discarded.consumed).to_equal(true)
        expect(discarded.discarded).to_equal(true)
        expect(discarded.state).to_equal("discarded")
        # Successful exclusive creation of the SAME name proves actual removal.
        var replacement = root.create_private_stage(".credential-fixture-original", 512u64).unwrap()
        credential_fixture_files_v2.push(replacement)
        val stale = windows_private_stage_discard_v2(root, copied)
        expect(stale.completed).to_equal(false)
        expect(stale.consumed).to_equal(false)
        expect(stale.stage.is_some()).to_equal(true)
        expect(stale.state).to_equal("stale")
        # The credential owner stores this exact stage projection on failure.
        # Repeating it cannot erase the unproven cleanup slot or produce a
        # positive close receipt on a later attempt.
        val repeated = windows_private_stage_discard_v2(root, stale.stage.unwrap())
        expect(repeated.completed).to_equal(false)
        expect(repeated.consumed).to_equal(false)
        expect(repeated.stage.is_some()).to_equal(true)
        expect(replacement.security_current()).to_equal(true)
        expect(windows_private_stage_discard_v2(root, replacement).completed).to_equal(true)
        step("Publish another exact native stage then retire its handle without deleting the ready artifact")
        var published = root.create_private_stage(".credential-fixture-published", 512u64).unwrap()
        credential_fixture_files_v2.push(published)
        val public_bytes = text_to_utf8_bytes("synthetic-nonsecret-ready")
        expect(published.write(public_bytes)).to_equal(Ok(true))
        expect(published.seal()).to_equal(Ok(true))
        expect(root.publish_no_replace(published, "preserved.ready")).to_equal(Ok(true))
        val retired = windows_private_stage_discard_v2(root, published)
        expect(retired.completed).to_equal(true)
        expect(retired.consumed).to_equal(true)
        expect(retired.discarded).to_equal(false)
        expect(retired.state).to_equal("published-preserved")
        var actual = root.open_private_file("preserved.ready", 512u64).unwrap()
        credential_fixture_files_v2.push(actual)
        expect(retained_credential_bytes_equal_v2(actual.read_all_bounded(512).unwrap(), public_bytes)).to_equal(true)
        expect(actual.close()).to_equal(true)
        expect(other.close()).to_equal(true)
        expect(root.close()).to_equal(true)
        expect(parent.close()).to_equal(true)
