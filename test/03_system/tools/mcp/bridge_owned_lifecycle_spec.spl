"""
## Purpose and audience
Run the actual Node stdio bridge with owned synthetic process children.
Audience: MCP lifecycle maintainers. This host-fixture gate does not qualify a
native Simple LSP server or explain the historical 48-process observation.
## Evidence
The underlying Node suite has observed RED then GREEN. This SSpec wrapper itself
is AUTHORED_UNRUN until an admitted self-hosted Simple runtime executes it.
"""
use std.spec.*
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

# @req REQ-MCP-BRIDGE-LIFECYCLE-001
# @req REQ-MCP-BRIDGE-LIFECYCLE-002
# @req REQ-MCP-BRIDGE-LIFECYCLE-003
# @req REQ-MCP-BRIDGE-LIFECYCLE-004
describe "Owned bridge child lifecycle":
    it "should pass normal close, failed start, bounded EOF and repeated-session process gates":
        step("Run the real bridge against owned fixture children")
        val (stdout, stderr, code) = process_run_bounded("node", [
            "--test", "--test-reporter=tap",
            "test/02_integration/app/mcp/bridge_lifecycle_test.cjs"
        ], 30000, 262144)
        step("Require all four concrete lifecycle scenarios and no skipped or cancelled cases")
        expect(code).to_equal(0)
        expect(stdout).to_contain("normal close waits for the owned child to exit")
        expect(stdout).to_contain("start failure exits even while client stdin remains open")
        expect(stdout).to_contain("client EOF bounds shutdown of a child that ignores EOF")
        expect(stdout).to_contain("three independent sessions leave none of their owned children alive")
        expect(stdout).to_contain("# tests 4")
        expect(stdout).to_contain("# pass 4")
        expect(stdout).to_contain("# fail 0")
        expect(stdout).to_contain("# skipped 0")
        expect(stdout).to_contain("# cancelled 0")
