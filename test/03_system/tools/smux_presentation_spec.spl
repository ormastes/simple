"""
REQ-CMUX-004/005/008/010: owner-backed pane presentation and sized geometry.
Source-authored NOT_RUN. These state/render controls do not prove native effects.
# @manual: primary
# @capture: text
"""
# codex-system-test
use std.spec.{describe, it, expect, step}
use std.common.contracts.mux.execution_v1.{MuxBorderV1, MuxBorderStatusV1, MuxSplitSizeV1}
use os.apps.smux.contract.{MuxSession, MuxWindow, MuxPane}
use os.apps.smux.service.{ServiceState, PaneRecord}
use os.apps.smux.mux_rects.{MuxRect}
use os.apps.smux.pane_presentation.{pane_presentation, pane_is_hidden, pane_title_cells}
use os.apps.smux.pane_presentation_service.{set_pane_title_plan, set_pane_border_plan,
    set_pane_border_status_plan, hide_pane_plan, show_pane_plan, rebalance_window_plan}
use os.apps.smux.window_layout_service.{window_base_rects, window_layout_rects,
    window_content_rects, window_viewport_rects, split_window_plan, split_window_sized_plan,
    resize_pane_plan, arrange_window_plan, focus_window_plan, toggle_zoom_plan}
use os.apps.smux.frame_snapshot.{smux_frame_from_state, smux_frame_validate}
use os.apps.smux.split_checkpoint.{split_checkpoint_capture, split_checkpoint_restore}
use os.apps.smux.pane_lifecycle.{remove_closed_pane_state}

fn presentation_setup() -> ServiceState:
    val rects = [MuxRect(pane_id: "p1", col: 0, row: 0, cols: 39, rows: 24),
        MuxRect(pane_id: "p2", col: 40, row: 0, cols: 40, rows: 24)]
    var st = ServiceState.empty().with_next_id(30)
    st = st.add_session(MuxSession.create("s", "presentation"))
    st = st.add_window(MuxWindow.create("w", "s", "window").with_geometry(rects, 80, 24))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p1", "w", "s")).resize(39, 24).with_focus(true).feed_screen("CONTENT_A"))
    st = st.add_pane(PaneRecord.create(MuxPane.create("p2", "w", "s")).resize(40, 24).feed_screen("CONTENT_B"))
    return st

fn presentation_check_rect(rect: MuxRect, col: i64, row: i64, cols: i64, rows: i64):
    expect(rect.col).to_equal(col)
    expect(rect.row).to_equal(row)
    expect(rect.cols).to_equal(cols)
    expect(rect.rows).to_equal(rows)

describe "authoritative pane presentation and content geometry":
    it "preserves legacy borderless viewports and Equal split behavior":
        step("Read default presentation and split the original allocation")
        val state = presentation_setup()
        val entry = pane_presentation(state.get_window(0), "p1")
        expect(entry.border).to_equal(MuxBorderV1.Hidden)
        expect(entry.status).to_equal(MuxBorderStatusV1.Hidden)
        expect(entry.hidden).to_equal(false)
        presentation_check_rect(window_content_rects(state, "s", "w")[0], 0, 0, 39, 24)
        val split = split_window_plan(state, "p3", "s", "w", "p1", "horizontal").unwrap()
        expect(split.get_pane(0).pane.rows).to_equal(11)
        expect(split.get_pane(2).pane.rows).to_equal(12)

    it "stores literal Unicode titles through every ordinary window constructor":
        step("Persist combining and wide title text without normalizing it")
        val title = "Agent e\u{301} \u{4e2d}"
        val state = set_pane_title_plan(presentation_setup(), "s", "w", "p1", title).unwrap()
        val window = state.get_window(0)
        for changed in [window.with_active(true), window.with_canvas(100, 30),
            window.with_layout("tiled", 80, 24), window.with_zoom("p1"),
            window.with_geometry(window.manual_rects, 80, 24)]:
            expect(pane_presentation(changed, "p1").title).to_equal(title)
            expect(changed.presentation.len()).to_equal(1)
        val again = set_pane_title_plan(state, "s", "w", "p1", "next").unwrap()
        expect(again.get_window(0).presentation.len()).to_equal(1)

    it "refuses oversized or control-bearing titles before changing metadata":
        step("Reject escape injection and UTF-8 byte overflow at the owner")
        val before = presentation_setup()
        for title in ["bad\x1b]0;title", "bad\nline", "bad\u{85}"]:
            expect(set_pane_title_plan(before, "s", "w", "p1", title).is_err()).to_equal(true)
        var maximum = ""
        for i in 0..512: maximum = maximum + "\u{e9}"
        expect(set_pane_title_plan(before, "s", "w", "p1", maximum).is_ok()).to_equal(true)
        expect(set_pane_title_plan(before, "s", "w", "p1", maximum + "a").is_err()).to_equal(true)
        expect(before.get_window(0).presentation.len()).to_equal(0)

    it "renders single and double borders while resizing the content grid":
        step("Draw independent pane perimeters around the existing content")
        val single = set_pane_border_plan(presentation_setup(), "s", "w", "p1", MuxBorderV1.Single).unwrap()
        presentation_check_rect(window_content_rects(single, "s", "w")[0], 1, 1, 37, 22)
        expect(single.get_pane(0).pane.cols).to_equal(37)
        expect(single.get_pane(0).screen.rows).to_equal(22)
        val frame = smux_frame_from_state(single, "s", "w").unwrap()
        expect(frame).to_contain("\u{250c}")
        expect(frame).to_contain("\u{2502}CONTENT_A")
        val double = set_pane_border_plan(single, "s", "w", "p1", MuxBorderV1.Double).unwrap()
        expect(smux_frame_from_state(double, "s", "w").unwrap()).to_contain("\u{2554}")
        presentation_check_rect(window_content_rects(double, "s", "w")[0], 1, 1, 37, 22)
        val removed = set_pane_border_plan(double, "s", "w", "p1", MuxBorderV1.Hidden).unwrap()
        presentation_check_rect(window_content_rects(removed, "s", "w")[0], 0, 0, 39, 24)

    it "renders top and bottom title rows with the correct content origin and cursor":
        step("Move the status row without changing the literal title")
        var state = set_pane_title_plan(presentation_setup(), "s", "w", "p1", "Agent One").unwrap()
        state = set_pane_border_plan(state, "s", "w", "p1", MuxBorderV1.Single).unwrap()
        val top = set_pane_border_status_plan(state, "s", "w", "p1", MuxBorderStatusV1.Top).unwrap()
        presentation_check_rect(window_content_rects(top, "s", "w")[0], 1, 2, 37, 21)
        val top_frame = smux_frame_from_state(top, "s", "w", "p1").unwrap()
        expect(top_frame).to_contain("\x1b[2;1H\u{2502}Agent One")
        expect(top_frame).to_end_with("\x1b[3;11H\x1b[?25h")
        val bottom = set_pane_border_status_plan(top, "s", "w", "p1", MuxBorderStatusV1.Bottom).unwrap()
        presentation_check_rect(window_content_rects(bottom, "s", "w")[0], 1, 1, 37, 21)
        expect(smux_frame_from_state(bottom, "s", "w").unwrap()).to_contain("\x1b[23;1H\u{2502}Agent One")
        val hidden = set_pane_border_status_plan(bottom, "s", "w", "p1", MuxBorderStatusV1.Hidden).unwrap()
        expect(smux_frame_from_state(hidden, "s", "w").unwrap().contains("Agent One")).to_equal(false)
        expect(pane_presentation(hidden.get_window(0), "p1").title).to_equal("Agent One")

    it "clips wide title cells and keeps combining marks with their base glyph":
        step("Project Unicode by cells without splitting wide glyphs")
        val clipped = pane_title_cells("A\u{4e2d}Z", 2)
        expect(clipped.len()).to_equal(1)
        expect(clipped[0]).to_equal("A")
        val complete = pane_title_cells("e\u{301}\u{4e2d}", 3)
        expect(complete.len()).to_equal(3)
        expect(complete[0]).to_equal("e\u{301}")
        expect(complete[1]).to_equal("\u{4e2d}")
        expect(complete[2]).to_equal("")

    it "rejects decorations or canvas shrink that would erase child content":
        step("Validate the unzoomed restore geometry before accepting styles")
        val small = resize_pane_plan(presentation_setup(), "s", "w", "p1", 2, 2).unwrap()
        expect(set_pane_border_plan(small, "s", "w", "p1", MuxBorderV1.Single).is_err()).to_equal(true)
        val zoom = toggle_zoom_plan(small, "s", "w", "p1").unwrap()
        expect(set_pane_border_plan(zoom, "s", "w", "p1", MuxBorderV1.Double).is_err()).to_equal(true)
        val bordered = set_pane_border_plan(presentation_setup(), "s", "w", "p1", MuxBorderV1.Single).unwrap()
        expect(arrange_window_plan(bordered, "s", "w", "even-horizontal", 4, 3).is_err()).to_equal(true)

    it "hides only presentation while preserving owner handles output and dimensions":
        step("Pure ownership control: retain modeled handles without performing native effects")
        var before = presentation_setup()
        before = before.replace_pane(0, before.get_pane(0).with_pty(123, 456))
        val hidden = hide_pane_plan(before, "s", "w", "p1").unwrap()
        expect(hidden.get_pane(0).pty_fd).to_equal(456)
        expect(hidden.get_pane(0).child_pid).to_equal(123)
        expect(hidden.get_pane(0).pane.cols).to_equal(39)
        expect(hidden.get_pane(0).screen.cells).to_equal(before.get_pane(0).screen.cells)
        expect(hidden.get_pane(0).focus).to_equal(false)
        expect(hidden.get_pane(1).focus).to_equal(true)
        expect(window_base_rects(hidden, "s", "w").len()).to_equal(2)
        expect(window_viewport_rects(hidden, "s", "w").len()).to_equal(2)
        expect(window_layout_rects(hidden, "s", "w")[0].pane_id).to_equal("p2")
        expect(smux_frame_from_state(hidden, "s", "w").unwrap().contains("CONTENT_A")).to_equal(false)

    it "rejects hiding the last visible pane and rejects hidden interactive targets":
        step("Preserve one reachable focus target and reject stale input selection")
        val hidden = hide_pane_plan(presentation_setup(), "s", "w", "p1").unwrap()
        expect(hide_pane_plan(hidden, "s", "w", "p2").unwrap_err()).to_equal("cannot hide last visible pane")
        expect(pane_is_hidden(hidden, "s", "w", "p1")).to_equal(true)
        expect(focus_window_plan(hidden, "s", "w", "p1").is_err()).to_equal(true)
        expect(toggle_zoom_plan(hidden, "s", "w", "p1").is_err()).to_equal(true)
        expect(split_window_plan(hidden, "p3", "s", "w", "p1", "vertical").is_err()).to_equal(true)
        expect(smux_frame_validate(hidden, "s", "w", "p1")).to_equal("cursor pane is missing or explicitly hidden: p1")

    it "restores zoom when hiding its target and shows without stealing focus":
        step("Restore saved child sizes and show the original allocation hole")
        val zoom = toggle_zoom_plan(presentation_setup(), "s", "w", "p1").unwrap()
        val hidden = hide_pane_plan(zoom, "s", "w", "p1").unwrap()
        expect(hidden.get_window(0).zoom_pane).to_equal("")
        expect(hidden.get_pane(0).pane.cols).to_equal(39)
        val shown = show_pane_plan(hidden, "s", "w", "p1").unwrap()
        expect(shown.get_pane(1).focus).to_equal(true)
        expect(shown.get_pane(0).focus).to_equal(false)
        presentation_check_rect(window_content_rects(shown, "s", "w")[0], 0, 0, 39, 24)
        expect(smux_frame_from_state(shown, "s", "w").unwrap()).to_contain("CONTENT_A")

    it "assigns Cells to the new child and accounts for existing decoration costs":
        step("Split below a bordered pane with a top status row")
        var before = set_pane_border_plan(presentation_setup(), "s", "w", "p1", MuxBorderV1.Single).unwrap()
        before = set_pane_border_status_plan(before, "s", "w", "p1", MuxBorderStatusV1.Top).unwrap()
        val split = split_window_sized_plan(before, "p3", "s", "w", "p1", "horizontal", MuxSplitSizeV1.Cells(7)).unwrap()
        expect(split.get_pane(2).pane.rows).to_equal(7)
        expect(split.get_pane(0).pane.rows).to_equal(13)
        presentation_check_rect(window_base_rects(split, "s", "w")[2], 0, 17, 39, 7)
        expect(pane_presentation(split.get_window(0), "p3").border).to_equal(MuxBorderV1.Hidden)

    it "computes Percent from content remaining after separator and decoration costs":
        step("Split 38 available cells into a nine-cell new pane at 25 percent")
        val split = split_window_sized_plan(presentation_setup(), "p3", "s", "w", "p1", "vertical", MuxSplitSizeV1.Percent(25)).unwrap()
        expect(split.get_pane(2).pane.cols).to_equal(9)
        expect(split.get_pane(0).pane.cols).to_equal(29)
        val before = set_pane_border_plan(presentation_setup(), "s", "w", "p1", MuxBorderV1.Double).unwrap()
        val decorated = split_window_sized_plan(before, "p3", "s", "w", "p1", "vertical", MuxSplitSizeV1.Percent(50)).unwrap()
        expect(decorated.get_pane(2).pane.cols).to_equal(18)
        expect(decorated.get_pane(0).pane.cols).to_equal(18)

    it "rejects nonfitting sizes and duplicate identities before state changes":
        step("Reject zero full-width huge and invalid-percent split requests")
        val before = presentation_setup()
        for size in [MuxSplitSizeV1.Cells(0), MuxSplitSizeV1.Cells(38),
            MuxSplitSizeV1.Cells(9223372036854775807), MuxSplitSizeV1.Percent(0), MuxSplitSizeV1.Percent(100)]:
            expect(split_window_sized_plan(before, "p3", "s", "w", "p1", "vertical", size).is_err()).to_equal(true)
        expect(split_window_plan(before, "p2", "s", "w", "p1", "vertical").is_err()).to_equal(true)
        expect(before.pane_count).to_equal(2)
        expect(before.next_id).to_equal(30)

    it "resizes pane content dimensions independently of border and status costs":
        step("Request a ten by eight content viewport inside its allocation")
        var before = set_pane_border_plan(presentation_setup(), "s", "w", "p1", MuxBorderV1.Single).unwrap()
        before = set_pane_border_status_plan(before, "s", "w", "p1", MuxBorderStatusV1.Bottom).unwrap()
        val resized = resize_pane_plan(before, "s", "w", "p1", 10, 8).unwrap()
        expect(resized.get_pane(0).pane.cols).to_equal(10)
        expect(resized.get_pane(0).pane.rows).to_equal(8)
        presentation_check_rect(window_base_rects(resized, "s", "w")[0], 0, 0, 12, 11)

    it "retains a named layout on rebalance and gives Manual an explicit equal layout":
        step("Preserve leader layout while refreshing its allocation")
        val before = presentation_setup()
        expect(rebalance_window_plan(before, "s", "w").unwrap().get_window(0).layout).to_equal("even-horizontal")
        var named = arrange_window_plan(before, "s", "w", "main-vertical", 80, 24).unwrap()
        named = set_pane_title_plan(named, "s", "w", "p1", "leader").unwrap()
        val balanced = rebalance_window_plan(named, "s", "w").unwrap()
        expect(balanced.get_window(0).layout).to_equal("main-vertical")
        expect(pane_presentation(balanced.get_window(0), "p1").title).to_equal("leader")

    it "prunes removed presentation entries even through an old-window geometry replacement":
        step("Close the last visible pane and reveal a surviving background pane")
        var before = set_pane_title_plan(presentation_setup(), "s", "w", "p1", "closed").unwrap()
        before = set_pane_title_plan(before, "s", "w", "p2", "survivor").unwrap()
        before = hide_pane_plan(before, "s", "w", "p2").unwrap()
        val closed = remove_closed_pane_state(before, "s", "w", "p1").unwrap()
        expect(closed.pane_count).to_equal(1)
        expect(closed.get_window(0).presentation.len()).to_equal(1)
        expect(closed.get_window(0).presentation[0].pane_id).to_equal("p2")
        expect(closed.get_pane(0).focus).to_equal(true)
        expect(pane_is_hidden(closed, "s", "w", "p2")).to_equal(false)
        expect(pane_presentation(closed.get_window(0), "p2").title).to_equal("survivor")

    it "refuses split rollback after an independent title change":
        step("Protect new metadata from a stale whole-window checkpoint")
        val before = presentation_setup()
        val split = split_window_plan(before, "p3", "s", "w", "p1", "vertical").unwrap()
        val checkpoint = split_checkpoint_capture(before, split, "s", "w", "p3")
        val updated = set_pane_title_plan(split, "s", "w", "p1", "newer title").unwrap()
        val refused = split_checkpoint_restore(updated, checkpoint)
        expect(refused.unwrap_err()).to_equal("split rollback presentation changed")
        expect(refused.state.pane_count).to_equal(3)
        expect(pane_presentation(refused.state.get_window(0), "p1").title).to_equal("newer title")
