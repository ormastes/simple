# @cover src/os/apps/smux/api.spl 80%
"""
## Purpose and audience
Named layouts through the actual smux service owner, for operators and service
maintainers. Rectangles, window metadata and pane sizes come from production
state rather than a test-local service replica.
## Evidence boundary
These scenarios allocate no child. They prove service geometry, ownership and
state transitions only after admitted native execution. Live child survival
across layout changes belongs to smux_windows_conpty_features_spec.spl.
# @manual: primary
# @capture: text
Plan: doc/03_plan/sys_test/smux_windows_phase3_features.md
"""
# codex-system-test
use std.spec.{describe, it, expect, step}
use os.apps.smux.api.{
    smux_reset_for_test, smux_create_session, smux_list_sessions, smux_list_windows, smux_new_window,
    smux_active_window, smux_focus_window, smux_list_panes, smux_split_pane,
    smux_focus_pane, smux_focused_pane, smux_resize, smux_close_pane,
    smux_select_layout, smux_window_layout, smux_window_rects,
    smux_arrange_window, smux_rollback_split, smux_metrics
}
use os.apps.smux.service.{ServiceState}
use os.apps.smux.contract.{MuxSession, MuxWindow}
use os.apps.smux.window_layout_service.{arrange_window_state, window_layout_name, window_layout_rects}

# @inline
fn layout_service_session(name: text) -> [text]:
    val session = smux_create_session(name)
    expect(session.id.len()).to_be_greater_than(0)
    val windows = smux_list_windows(session.id)
    expect(windows.len()).to_equal(1)
    val panes = smux_list_panes(session.id, windows[0].id)
    expect(panes.len()).to_equal(1)
    return [session.id, windows[0].id, panes[0].id]

# @inline
fn layout_service_three() -> [text]:
    smux_reset_for_test()
    val ids = layout_service_session("layouts")
    expect(smux_split_pane(ids[0], ids[1], ids[2], "vertical").is_ok()).to_equal(true)
    expect(smux_split_pane(ids[0], ids[1], ids[2], "horizontal").is_ok()).to_equal(true)
    expect(smux_list_panes(ids[0], ids[1]).len()).to_equal(3)
    return ids

describe "smux production service named layouts":
    describe "REQ-SMUX-CORE-005: select and expose actual window geometry":
        it "should select all five layouts and publish matching pane dimensions":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            step("Replace manual splits with a named canvas plan")
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("manual")
            expect(smux_window_rects(ids[0], ids[1]).len()).to_equal(3)
            for name in ["even-horizontal", "even-vertical", "main-horizontal", "main-vertical", "tiled"]:
                val selected = smux_select_layout(ids[0], ids[1], name, 79, 23)
                expect(selected.is_ok()).to_equal(true)
                val rects = selected.unwrap()
                val current = smux_window_rects(ids[0], ids[1])
                val panes = smux_list_panes(ids[0], ids[1])
                expect(rects.len()).to_equal(3)
                expect(current.len()).to_equal(3)
                expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal(name)
                var i = 0
                while i < 3:
                    expect(rects[i].pane_id).to_equal(panes[i].id)
                    expect(current[i].pane_id).to_equal(rects[i].pane_id)
                    expect(current[i].col).to_equal(rects[i].col)
                    expect(current[i].row).to_equal(rects[i].row)
                    expect(current[i].cols).to_equal(panes[i].cols)
                    expect(current[i].rows).to_equal(panes[i].rows)
                    i = i + 1

        it "should retain pane focus while updating the selected canvas dimensions":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            val focused = smux_list_panes(ids[0], ids[1])[1].id
            expect(smux_focus_pane(ids[0], ids[1], focused)).to_equal(true)
            step("Stack three panes on an odd-height canvas")
            val vertical = smux_select_layout(ids[0], ids[1], "even-vertical", 79, 23)
            expect(vertical.is_ok()).to_equal(true)
            val rects = vertical.unwrap()
            expect(rects[0].rows).to_equal(7)
            expect(rects[1].row).to_equal(7)
            expect(rects[2].row).to_equal(14)
            expect(rects[2].rows).to_equal(9)
            expect(smux_focused_pane(ids[0], ids[1]).unwrap().id).to_equal(focused)
            step("Reapply another layout at a new canvas size")
            val changed = smux_select_layout(ids[0], ids[1], "main-vertical", 103, 31)
            expect(changed.is_ok()).to_equal(true)
            expect(changed.unwrap()[0].cols).to_equal(51)
            expect(changed.unwrap()[1].col).to_equal(51)
            expect(changed.unwrap()[2].rows).to_equal(16)
            val window = smux_list_windows(ids[0])[0]
            expect(window.canvas_cols).to_equal(103)
            expect(window.canvas_rows).to_equal(31)
            expect(smux_focused_pane(ids[0], ids[1]).unwrap().id).to_equal(focused)

        it "should refuse invalid layouts canvases and addresses without changing the prior plan":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            expect(smux_select_layout(ids[0], ids[1], "even-vertical", 79, 23).is_ok()).to_equal(true)
            step("Submit unknown names, invalid sizes, insufficient space and wrong ownership")
            expect(smux_select_layout(ids[0], ids[1], "diagonal", 79, 23).is_ok()).to_equal(false)
            expect(smux_select_layout(ids[0], ids[1], "tiled", 0, 23).is_ok()).to_equal(false)
            expect(smux_select_layout(ids[0], ids[1], "tiled", 79, -1).is_ok()).to_equal(false)
            expect(smux_select_layout(ids[0], ids[1], "even-vertical", 79, 2).is_ok()).to_equal(false)
            expect(smux_select_layout("missing", ids[1], "tiled", 79, 23).is_ok()).to_equal(false)
            expect(smux_select_layout(ids[0], "missing", "tiled", 79, 23).is_ok()).to_equal(false)
            expect(smux_window_layout(ids[0], "missing").is_ok()).to_equal(false)
            expect(smux_window_rects("missing", ids[1]).len()).to_equal(0)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("even-vertical")
            val rects = smux_window_rects(ids[0], ids[1])
            expect(rects[2].row).to_equal(14)
            expect(rects[2].rows).to_equal(9)
            expect(smux_list_panes(ids[0], ids[1])[0].cols).to_equal(79)
            expect(smux_list_windows(ids[0])[0].canvas_rows).to_equal(23)

        it "should preserve layouts across window focus changes and isolate other sessions":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            val second = smux_new_window(ids[0], "second")
            expect(second.id.len()).to_be_greater_than(0)
            val other = layout_service_session("other-session")
            step("Apply a named layout to an inactive window")
            expect(smux_select_layout(ids[0], second.id, "tiled", 101, 37).is_ok()).to_equal(true)
            expect(smux_active_window(ids[0]).unwrap().id).to_equal(ids[1])
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("manual")
            expect(smux_window_layout(other[0], other[1]).unwrap()).to_equal("manual")
            expect(smux_list_panes(other[0], other[1])[0].cols).to_equal(80)
            step("Focus away and back without discarding metadata")
            expect(smux_focus_window(ids[0], second.id)).to_equal(true)
            expect(smux_focus_window(ids[0], ids[1])).to_equal(true)
            expect(smux_window_layout(ids[0], second.id).unwrap()).to_equal("tiled")
            expect(smux_window_rects(ids[0], second.id)[0].cols).to_equal(101)

        it "should persist manual geometry after successful split close or explicit pane resize":
            # @req REQ-SMUX-CORE-005
            smux_reset_for_test()
            val ids = layout_service_session("manual-transitions")
            expect(smux_select_layout(ids[0], ids[1], "tiled", 80, 24).is_ok()).to_equal(true)
            step("A directional split establishes manual pane geometry")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "vertical").is_ok()).to_equal(true)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("manual")
            val split_rects = smux_window_rects(ids[0], ids[1])
            expect(split_rects.len()).to_equal(2)
            expect(split_rects[0].pane_id).to_equal(ids[2])
            expect(split_rects[0].cols).to_equal(39)
            expect(split_rects[1].col).to_equal(40)
            expect(split_rects[1].cols).to_equal(40)
            expect(smux_select_layout(ids[0], ids[1], "even-horizontal", 80, 24).is_ok()).to_equal(true)
            val other = smux_list_panes(ids[0], ids[1])[1].id
            step("Pane removal retains surviving rectangles without auto-grow")
            expect(smux_close_pane(ids[0], ids[1], other)).to_equal(true)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("manual")
            expect(smux_window_rects(ids[0], ids[1]).len()).to_equal(1)
            expect(smux_window_rects(ids[0], ids[1])[0].cols).to_equal(40)
            expect(smux_select_layout(ids[0], ids[1], "tiled", 80, 24).is_ok()).to_equal(true)
            step("Arbitrary pane resizing also switches explicitly to manual mode")
            expect(smux_resize(ids[0], ids[1], ids[2], 50, 10).is_ok()).to_equal(true)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("manual")
            expect(smux_window_rects(ids[0], ids[1]).len()).to_equal(1)
            expect(smux_window_rects(ids[0], ids[1])[0].cols).to_equal(50)
            expect(smux_window_rects(ids[0], ids[1])[0].rows).to_equal(10)

        it "should restore nested reference boundaries after resize and refuse invalid geometry atomically":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            val before = smux_window_rects(ids[0], ids[1])
            step("Shrink nested splits then restore the reference canvas exactly")
            expect(smux_arrange_window(ids[0], ids[1], 40, 12).is_ok()).to_equal(true)
            val small = smux_window_rects(ids[0], ids[1])
            expect(small[0].cols).to_equal(19)
            expect(small[0].rows).to_equal(5)
            expect(small[1].col).to_equal(20)
            expect(small[1].rows).to_equal(12)
            expect(small[2].row).to_equal(6)
            expect(smux_arrange_window(ids[0], ids[1], 80, 24).is_ok()).to_equal(true)
            val restored = smux_window_rects(ids[0], ids[1])
            var i = 0
            while i < before.len():
                expect(restored[i].pane_id).to_equal(before[i].pane_id)
                expect(restored[i].col).to_equal(before[i].col)
                expect(restored[i].row).to_equal(before[i].row)
                expect(restored[i].cols).to_equal(before[i].cols)
                expect(restored[i].rows).to_equal(before[i].rows)
                i = i + 1
            val metrics = smux_metrics()
            step("Refuse collapse and overlapping pane resize before any metadata commit")
            expect(smux_arrange_window(ids[0], ids[1], 1, 1).is_err()).to_equal(true)
            expect(smux_resize(ids[0], ids[1], ids[2], 80, 24).is_err()).to_equal(true)
            val retained = smux_window_rects(ids[0], ids[1])
            val panes = smux_list_panes(ids[0], ids[1])
            expect(retained.len()).to_equal(3)
            i = 0
            while i < retained.len():
                expect(retained[i].pane_id).to_equal(before[i].pane_id)
                expect(retained[i].col).to_equal(before[i].col)
                expect(retained[i].row).to_equal(before[i].row)
                expect(retained[i].cols).to_equal(before[i].cols)
                expect(retained[i].rows).to_equal(before[i].rows)
                expect(panes[i].cols).to_equal(before[i].cols)
                expect(panes[i].rows).to_equal(before[i].rows)
                i = i + 1
            expect(smux_list_windows(ids[0])[0].canvas_cols).to_equal(80)
            expect(smux_list_windows(ids[0])[0].canvas_rows).to_equal(24)
            expect(smux_metrics().resize_count).to_equal(metrics.resize_count)
            expect(smux_metrics().capture_count).to_equal(metrics.capture_count)

        it "should roll back a split with the exact reference canvas rather than reanchoring rounded boundaries":
            # @req REQ-SMUX-CORE-005
            smux_reset_for_test()
            val ids = layout_service_session("split-rollback")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "vertical").is_ok()).to_equal(true)
            val reference = smux_window_rects(ids[0], ids[1])
            expect(reference[0].cols).to_equal(39)
            expect(smux_arrange_window(ids[0], ids[1], 40, 12).is_ok()).to_equal(true)
            val before = smux_window_rects(ids[0], ids[1])
            expect(before[0].cols).to_equal(19)
            step("Roll back through the same service transaction used after child spawn refusal")
            val split = smux_split_pane(ids[0], ids[1], ids[2], "horizontal")
            expect(split.is_ok()).to_equal(true)
            val added = split.unwrap()
            expect(smux_rollback_split(ids[0], ids[1], added.id).is_ok()).to_equal(true)
            expect(smux_list_panes(ids[0], ids[1]).len()).to_equal(2)
            val restored = smux_window_rects(ids[0], ids[1])
            var i = 0
            while i < before.len():
                expect(restored[i].pane_id).to_equal(before[i].pane_id)
                expect(restored[i].col).to_equal(before[i].col)
                expect(restored[i].row).to_equal(before[i].row)
                expect(restored[i].cols).to_equal(before[i].cols)
                expect(restored[i].rows).to_equal(before[i].rows)
                i = i + 1
            step("Expand back to 80 columns and recover 39 rather than the rounded 38")
            expect(smux_arrange_window(ids[0], ids[1], 80, 24).is_ok()).to_equal(true)
            val expanded = smux_window_rects(ids[0], ids[1])
            i = 0
            while i < reference.len():
                expect(expanded[i].pane_id).to_equal(reference[i].pane_id)
                expect(expanded[i].col).to_equal(reference[i].col)
                expect(expanded[i].row).to_equal(reference[i].row)
                expect(expanded[i].cols).to_equal(reference[i].cols)
                expect(expanded[i].rows).to_equal(reference[i].rows)
                i = i + 1
            expect(smux_rollback_split(ids[0], ids[1], added.id).is_err()).to_equal(true)

        it "should refuse a stale split checkpoint without replacing newer geometry":
            # @req REQ-SMUX-CORE-005
            smux_reset_for_test()
            val ids = layout_service_session("stale-rollback")
            val added = smux_split_pane(ids[0], ids[1], ids[2], "vertical").unwrap()
            expect(smux_select_layout(ids[0], ids[1], "even-vertical", 80, 24).is_ok()).to_equal(true)
            step("A later layout selection cannot be undone by an old split rollback")
            expect(smux_rollback_split("wrong-session", ids[1], added.id).is_err()).to_equal(true)
            expect(smux_rollback_split(ids[0], ids[1], added.id).is_err()).to_equal(true)
            val current = smux_window_rects(ids[0], ids[1])
            expect(current.len()).to_equal(2)
            expect(current[0].pane_id).to_equal(ids[2])
            expect(current[0].cols).to_equal(80)
            expect(current[0].rows).to_equal(12)
            expect(current[1].pane_id).to_equal(added.id)
            expect(current[1].row).to_equal(12)
            expect(current[1].cols).to_equal(80)
            expect(current[1].rows).to_equal(12)

        it "should preserve named geometry when split close or resize is refused":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_three()
            expect(smux_select_layout(ids[0], ids[1], "tiled", 79, 23).is_ok()).to_equal(true)
            step("Refused mutations cannot invalidate the selected plan")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "diagonal").is_ok()).to_equal(false)
            expect(smux_close_pane(ids[0], ids[1], "missing")).to_equal(false)
            expect(smux_resize(ids[0], ids[1], ids[2], 0, 0).is_ok()).to_equal(false)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("tiled")
            expect(smux_window_rects(ids[0], ids[1]).len()).to_equal(3)

        it "should remove the final window and session when the final pane closes":
            # @req REQ-SMUX-CORE-005
            smux_reset_for_test()
            val ids = layout_service_session("empty")
            expect(smux_close_pane(ids[0], ids[1], ids[2])).to_equal(true)
            step("A deleted window cannot acquire or expose a pane plan")
            expect(smux_select_layout(ids[0], ids[1], "tiled", 80, 24).is_ok()).to_equal(false)
            expect(smux_window_layout(ids[0], ids[1]).unwrap_err()).to_equal("unknown window: " + ids[1])
            expect(smux_window_rects(ids[0], ids[1]).len()).to_equal(0)
            expect(smux_list_windows(ids[0]).len()).to_equal(0)
            expect(smux_list_sessions().len()).to_equal(0)

        it "should independently refuse layout on a pure empty-window snapshot":
            # @req REQ-SMUX-CORE-005
            var snapshot = ServiceState.empty()
            snapshot = snapshot.add_session(MuxSession.create("empty-session", "empty"))
            snapshot = snapshot.add_window(MuxWindow.create("empty-window", "empty-session", "empty"))
            step("Exercise the empty-state guard without pretending pane deletion leaves a live window")
            val result = arrange_window_state(snapshot, "empty-session", "empty-window", "tiled", 80, 24)
            expect(result.unwrap_err()).to_equal("no panes in window: empty-window")
            expect(window_layout_name(snapshot, "empty-session", "empty-window").unwrap()).to_equal("manual")
            expect(window_layout_rects(snapshot, "empty-session", "empty-window").len()).to_equal(0)
            expect(snapshot.window_count).to_equal(1)
            expect(snapshot.pane_count).to_equal(0)

        it "should reject oversized geometry before narrowing native dimensions or changing state":
            # @req REQ-SMUX-CORE-005
            val ids = layout_service_session("native-dimension-bounds")
            expect(smux_select_layout(ids[0], ids[1], "tiled", 80, 24).is_ok()).to_equal(true)
            step("Reject a positive width that would wrap to one in a 32 bit ABI slot")
            val narrowed = smux_resize(ids[0], ids[1], ids[2], 4294967297, 24)
            expect(narrowed.is_err()).to_equal(true)
            expect(narrowed.unwrap_err()).to_equal("pane dimensions exceed service limit")
            step("Reject oversized canvases and areas before allocation or backend calls")
            expect(smux_select_layout(ids[0], ids[1], "tiled", 4294967297, 24).is_err()).to_equal(true)
            expect(smux_resize(ids[0], ids[1], ids[2], 1000, 1000).is_err()).to_equal(true)
            expect(smux_select_layout(ids[0], ids[1], "tiled", 1000, 1000).is_err()).to_equal(true)
            expect(smux_window_layout(ids[0], ids[1]).unwrap()).to_equal("tiled")
            val rects = smux_window_rects(ids[0], ids[1])
            expect(rects.len()).to_equal(1)
            expect(rects[0].cols).to_equal(80)
            expect(rects[0].rows).to_equal(24)
            expect(smux_list_panes(ids[0], ids[1])[0].cols).to_equal(80)
