"""
## Purpose and audience
Purpose: stores address, size, data_offset
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplContChec-001

use std.spec
use std.replay.container.checkpoint_format.{
    DirtyPage, FdEntry, ProcessSnapshot, IpcMessage, IpcSnapshot,
    ContainerCheckpoint, encode_checkpoint, decode_checkpoint,
    encode_i64, decode_i64, encode_text, decode_text
}
use std.replay.container.container_replay.ContainerReplayDriver

# ============================================================================
# DirtyPage / FdEntry Construction
# ============================================================================

use std.spec.step
describe "DirtyPage construction":
    it "stores address, size, data_offset":
        step("Verify: stores address, size, data_offset")
        # @req: REQ-TOOLS-ReplContChec-001
        val page = DirtyPage(address: 4096, size: 4096, data_offset: 0)
        expect(page.address).to_equal(4096)  # oracle: value fixed by the spec contract
        expect(page.size).to_equal(4096)  # oracle: value fixed by the spec contract
        expect(page.data_offset).to_equal(0)  # oracle: value fixed by the spec contract

    it "stores large address values":
        step("Verify: stores large address values")
        # @req: REQ-TOOLS-ReplContChec-001
        val page = DirtyPage(address: 1099511627776, size: 4096, data_offset: 8192)
        expect(page.address).to_equal(1099511627776)  # oracle: value fixed by the spec contract
        expect(page.data_offset).to_equal(8192)  # oracle: value fixed by the spec contract

describe "FdEntry construction":
    it "stores fd, path, offset, flags":
        step("Verify: stores fd, path, offset, flags")
        # @req: REQ-TOOLS-ReplContChec-001
        val entry = FdEntry(fd: 3, path: "/tmp/test.txt", offset: 1024, flags: 2)
        expect(entry.fd).to_equal(3)  # oracle: value fixed by the spec contract
        expect(entry.path).to_equal("/tmp/test.txt")
        expect(entry.offset).to_equal(1024)  # oracle: value fixed by the spec contract
        expect(entry.flags).to_equal(2)  # oracle: value fixed by the spec contract

# ============================================================================
# ProcessSnapshot
# ============================================================================

describe "ProcessSnapshot":
    it "create sets empty collections":
        step("Verify: create sets empty collections")
        # @req: REQ-TOOLS-ReplContChec-001
        val snap = ProcessSnapshot.create(42)
        expect(snap.pid).to_equal(42)  # oracle: value fixed by the spec contract
        expect(snap.registers.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(snap.memory_pages.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(snap.fd_count).to_equal(0)  # oracle: value fixed by the spec contract

    it "add_fd increments fd_count":
        step("Verify: add_fd increments fd_count")
        # @req: REQ-TOOLS-ReplContChec-001
        var snap = ProcessSnapshot.create(10)
        snap.add_fd(FdEntry(fd: 0, path: "/dev/stdin", offset: 0, flags: 0))
        snap.add_fd(FdEntry(fd: 1, path: "/dev/stdout", offset: 0, flags: 1))
        expect(snap.fd_count).to_equal(2)  # oracle: value fixed by the spec contract
        expect(snap.fd_table.len()).to_equal(2)  # oracle: value fixed by the spec contract

# ============================================================================
# ContainerCheckpoint
# ============================================================================

describe "ContainerCheckpoint":
    it "create sets id and timestamp":
        step("Verify: create sets id and timestamp")
        # @req: REQ-TOOLS-ReplContChec-001
        val cp = ContainerCheckpoint.create(1, 5000)
        expect(cp.id).to_equal(1)  # oracle: value fixed by the spec contract
        expect(cp.timestamp).to_equal(5000)  # oracle: value fixed by the spec contract
        expect(cp.processes.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(cp.ipc.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "process_count returns number of added processes":
        step("Verify: process_count returns number of added processes")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(2, 100)
        cp.add_process(ProcessSnapshot.create(10))
        cp.add_process(ProcessSnapshot.create(20))
        expect(cp.process_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "total_pages sums across processes":
        step("Verify: total_pages sums across processes")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(3, 200)
        var p1 = ProcessSnapshot.create(10)
        p1.add_page(DirtyPage(address: 4096, size: 4096, data_offset: 0))
        p1.add_page(DirtyPage(address: 8192, size: 4096, data_offset: 4096))
        cp.add_process(p1)
        var p2 = ProcessSnapshot.create(20)
        p2.add_page(DirtyPage(address: 16384, size: 4096, data_offset: 8192))
        cp.add_process(p2)
        expect(cp.total_pages()).to_equal(3)  # oracle: value fixed by the spec contract

    it "summary contains id and timestamp":
        step("Verify: summary contains id and timestamp")
        # @req: REQ-TOOLS-ReplContChec-001
        val cp = ContainerCheckpoint.create(7, 999)
        val s = cp.summary()
        expect(s).to_contain("id=7")
        expect(s).to_contain("ts=999")

# ============================================================================
# encode / decode round-trip
# ============================================================================

describe "encode_checkpoint / decode_checkpoint round-trip":
    it "empty checkpoint round-trips":
        step("Verify: empty checkpoint round-trips")
        # @req: REQ-TOOLS-ReplContChec-001
        val cp = ContainerCheckpoint.create(1, 100)
        val data = encode_checkpoint(cp)
        match decode_checkpoint(data):
            case Ok(got):
                expect(got.id).to_equal(1)  # oracle: value fixed by the spec contract
                expect(got.timestamp).to_equal(100)  # oracle: value fixed by the spec contract
                expect(got.process_count()).to_equal(0)  # oracle: value fixed by the spec contract
            case Err(msg):
                expect(msg).to_equal("")

    it "checkpoint with process round-trips pid":
        step("Verify: checkpoint with process round-trips pid")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(2, 200)
        var proc = ProcessSnapshot.create(42)
        proc.add_register(100)
        proc.add_register(200)
        cp.add_process(proc)
        val data = encode_checkpoint(cp)
        match decode_checkpoint(data):
            case Ok(got):
                expect(got.processes.len()).to_equal(1)  # oracle: value fixed by the spec contract
                expect(got.processes[0].pid).to_equal(42)  # oracle: value fixed by the spec contract
                expect(got.processes[0].registers.len()).to_equal(2)  # oracle: value fixed by the spec contract
            case Err(msg):
                expect(msg).to_equal("")

    it "checkpoint with fd_table round-trips entries":
        step("Verify: checkpoint with fd_table round-trips entries")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(5, 500)
        var proc = ProcessSnapshot.create(77)
        proc.add_fd(FdEntry(fd: 3, path: "/tmp/log", offset: 512, flags: 2))
        cp.add_process(proc)
        val data = encode_checkpoint(cp)
        match decode_checkpoint(data):
            case Ok(got):
                expect(got.processes[0].fd_table.len()).to_equal(1)  # oracle: value fixed by the spec contract
                expect(got.processes[0].fd_table[0].fd).to_equal(3)  # oracle: value fixed by the spec contract
                expect(got.processes[0].fd_table[0].path).to_equal("/tmp/log")
            case Err(msg):
                expect(msg).to_equal("")

    it "checkpoint with no fd_table round-trips empty":
        step("Verify: checkpoint with no fd_table round-trips empty")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(3, 300)
        var proc = ProcessSnapshot.create(10)
        cp.add_process(proc)
        val data = encode_checkpoint(cp)
        match decode_checkpoint(data):
            case Ok(got):
                expect(got.processes[0].fd_table.len()).to_equal(0)  # oracle: value fixed by the spec contract
                expect(got.processes[0].pid).to_equal(10)  # oracle: value fixed by the spec contract
            case Err(msg):
                expect(msg).to_equal("")

    it "checkpoint with dirty page round-trips address":
        step("Verify: checkpoint with dirty page round-trips address")
        # @req: REQ-TOOLS-ReplContChec-001
        var cp = ContainerCheckpoint.create(4, 400)
        var proc = ProcessSnapshot.create(99)
        proc.add_page(DirtyPage(address: 65536, size: 4096, data_offset: 0))
        cp.add_process(proc)
        val data = encode_checkpoint(cp)
        match decode_checkpoint(data):
            case Ok(got):
                expect(got.processes[0].memory_pages.len()).to_equal(1)  # oracle: value fixed by the spec contract
                expect(got.processes[0].memory_pages[0].address).to_equal(65536)  # oracle: value fixed by the spec contract
                expect(got.processes[0].memory_pages[0].size).to_equal(4096)  # oracle: value fixed by the spec contract
            case Err(msg):
                expect(msg).to_equal("")

    it "decode rejects short data":
        step("Verify: decode rejects short data")
        # @req: REQ-TOOLS-ReplContChec-001
        val data: [i32] = [1, 2]
        match decode_checkpoint(data):
            case Ok(_):
                expect("should not reach").to_equal("")
            case Err(msg):
                expect(msg).to_contain("too short")

    it "decode rejects bad magic":
        step("Verify: decode rejects bad magic")
        # @req: REQ-TOOLS-ReplContChec-001
        val data: [i32] = [0, 1, 0, 0, 0, 0, 0]
        match decode_checkpoint(data):
            case Ok(_):
                expect("should not reach").to_equal("")
            case Err(msg):
                expect(msg).to_contain("invalid checkpoint magic")

# ============================================================================
# ContainerReplayDriver.find_checkpoint_before
# ============================================================================

describe "ContainerReplayDriver.find_checkpoint_before":
    it "returns None when no checkpoints exist":
        step("Verify: returns None when no checkpoints exist")
        # @req: REQ-TOOLS-ReplContChec-001
        val driver = ContainerReplayDriver.create("record", "ctr-1")
        val result = driver.find_checkpoint_before(100)
        expect(result.is_none()).to_equal(true)

    it "returns the latest checkpoint at or before timestamp":
        step("Verify: returns the latest checkpoint at or before timestamp")
        # @req: REQ-TOOLS-ReplContChec-001
        var driver = ContainerReplayDriver.create("record", "ctr-2")
        driver.save_checkpoint(0)
        driver.advance_event()
        driver.advance_event()
        driver.advance_event()
        driver.save_checkpoint(1)
        val found = driver.find_checkpoint_before(5)
        match found:
            case Some(cp):
                expect(cp.id).to_equal(1)  # oracle: value fixed by the spec contract
            case None:
                expect("should have found checkpoint").to_equal("")

    it "returns None when all checkpoints are after timestamp":
        step("Verify: returns None when all checkpoints are after timestamp")
        # @req: REQ-TOOLS-ReplContChec-001
        var driver = ContainerReplayDriver.create("record", "ctr-3")
        driver.advance_event()
        driver.advance_event()
        driver.save_checkpoint(0)
        val found = driver.find_checkpoint_before(0)
        expect(found.is_none()).to_equal(true)
