"""
# Simple Lab robustness evidence (Stream H, task H3)

Drives `src/app/simple_lab/lab_server.spl` as a **separate OS process** over a
**real TCP socket**, the same real-loopback subprocess pattern as
`lab_http_api_spec.spl` (L3) and `lab_hardening_spec.spl` (H1) — no mocks, no
in-process shim. Per the crash-safe execution rules referenced by the plan
(no parallel QEMU/bootstrap, loopback only, recorded limits), everything here
runs sequentially, one lab_server subprocess per example, on 127.0.0.1.

Three pieces of evidence, per design §8.5:
  1. **Load smoke** — a bounded run of sequential authenticated
     `GET /api/lab/status` requests, timed, all must return 200.
  2. **100-cell soak** — one session, 100 sequential real
     `POST .../cells/:cid/execute` calls (the real functional path, not
     `/api/test/click` — see the filed gap
     `doc/08_tracking/bug/lab_test_api_click_does_not_invoke_simple_lab_app_add_cell_2026-08-07.md`),
     all must return `ok:true`, panic-free.
  3. **Fuzz-lite corpus** — malformed JSON bodies (already covered by H1's
     spec; re-asserted here as part of the combined evidence run), an
     oversized header line, a too-many-headers request, and a WS handshake
     request truncated mid-write — every one of these must produce a 4xx
     response or a clean connection close, never a crash/hang, and the
     server must still answer the next request afterward.

Numbers this spec measures are recorded verbatim into
`doc/09_report/notebook_lanes_robustness_evidence_2026-08-07.md` (H3 verify
requirement: "perf/robustness report checked into doc/09_report/ with
commands + numbers; zero panics").

Design: doc/05_design/app/tools/notebook_lanes_architecture.md §8.5
Plan:   doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream H, H3)
"""

# tag: slow, system

use std.spec.*
use std.nogc_sync_mut.io.tcp.{TcpStream}

extern fn rt_process_spawn_async(cmd: text, args: [text]) -> i64
extern fn rt_process_kill(pid: i64) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_env_get(key: text) -> text
extern fn rt_env_cwd() -> text
extern fn rt_sleep_ms(ms: i64)
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

val SERVER_ENTRYPOINT = "src/app/simple_lab/lab_server.spl"
val TEST_TOKEN = "h3-robustness-test-token"

# ============================================================================
# Subprocess driver — copied from lab_hardening_spec.spl (H1) rather than
# imported: system specs in this repo are self-contained single files (no
# cross-spec `use`), same pattern L3/H1 already established.
# ============================================================================

fn env_or(key: text, fallback: text) -> text:
    val v = rt_env_get(key)
    if v == nil or v == "":
        fallback
    else:
        v

fn scratch_dir() -> text:
    val t = rt_env_get("SIMPLE_TEST_SCRATCH_DIR")
    if t != nil and t != "":
        return t
    val tmp = rt_env_get("TMPDIR")
    if tmp != nil and tmp != "" and tmp.starts_with("/"):
        return tmp
    return "/tmp"

fn repo_root() -> text:
    val r = rt_env_get("SIMPLE_REPO_ROOT")
    if r != nil and r != "":
        return r
    val c = rt_env_cwd()
    if c == nil:
        return "."
    return c

class LabServerProc:
    pid: i64
    addr: text
    port: i64
    portfile: text
    notebook_root: text
    started: bool

    me stop():
        if self.pid > 0:
            val _ = rt_process_kill(self.pid)
            self.pid = -1
        if self.portfile != "":
            val _ = rt_file_delete(self.portfile)

fn start_lab_server_with_env(max_requests: i64, extra_env: [text]) -> LabServerProc:
    val root = repo_root()
    val stamp = rt_time_now_unix_micros()
    val me_pid = rt_getpid()
    val dir = scratch_dir()
    val base = "{dir}/simple_lab_robustness_{me_pid}_{stamp}"
    val portfile = "{base}.port"
    val notebook_root = "{base}_notebooks"

    var server = LabServerProc(pid: -1, addr: "", port: -1, portfile: portfile, notebook_root: notebook_root, started: false)

    if rt_file_exists(portfile):
        val _ = rt_file_delete(portfile)

    var args = [
        "SIMPLE_EXECUTION_MODE=interpreter",
        "SIMPLE_LAB_HTTP_PORT=0",
        "SIMPLE_LAB_HTTP_MAX={max_requests}",
        "SIMPLE_LAB_HTTP_PORTFILE={portfile}",
        "SIMPLE_LAB_HTTP_ACCEPT_TIMEOUT_MS=30000",
        "SIMPLE_LAB_NOTEBOOK_ROOT={notebook_root}"
    ]
    for pair in extra_env:
        args.push(pair)
    args.push("{root}/bin/simple")
    args.push("run")
    args.push("{root}/{SERVER_ENTRYPOINT}")

    val pid = rt_process_spawn_async("env", args)
    if pid <= 0:
        return server
    server.pid = pid

    # 150s budget: bin/simple run's cold-start compile+lint pass alone can
    # take ~50s in this environment before the server subprocess even begins
    # listening (measured live; see lab_http_api_spec.spl / lab_hardening_spec.spl).
    var waited = 0
    var bound = ""
    while waited < 150000:
        if rt_file_exists(portfile):
            val t = rt_file_read_text(portfile)
            if t != nil and t.trim() != "":
                bound = t.trim()
                waited = 150000
        if bound == "":
            rt_sleep_ms(50)
            waited = waited + 50

    if bound == "":
        server.stop()
        return server

    server.addr = bound
    server.started = true
    val colon = bound.last_index_of(":")
    if colon >= 0:
        server.port = bound.substring(colon + 1, bound.len()).to_i64()
    return server

fn start_lab_server(max_requests: i64) -> LabServerProc:
    start_lab_server_with_env(max_requests, ["SIMPLE_LAB_TOKEN={TEST_TOKEN}"])

# ============================================================================
# Minimal real HTTP/1.1 client over TcpStream (no mocks).
# ============================================================================

struct HttpProbe:
    ok: bool
    status: i64
    headers: text
    body: text

fn http_request_ex(addr: text, method: text, path: text, body: text, extra_headers: text) -> HttpProbe:
    val stream_res = TcpStream.connect(addr)
    if stream_res.is_err():
        return HttpProbe(ok: false, status: -1, headers: "", body: "connect failed")
    var stream = stream_res.unwrap()

    val clen = body.len()
    var req = "{method} {path} HTTP/1.1\r\nHost: {addr}\r\nContent-Length: {clen}\r\nContent-Type: application/json\r\n{extra_headers}Connection: close\r\n\r\n{body}"
    val w = stream.write_text(req)
    if w.is_err():
        val _ = stream.close()
        return HttpProbe(ok: false, status: -1, headers: "", body: "write failed")
    val _f = stream.flush()

    val read_res = stream.read_text()
    val _c = stream.close()
    if read_res.is_err():
        return HttpProbe(ok: false, status: -1, headers: "", body: "read failed")
    val raw = read_res.unwrap()

    val split = raw.index_of("\r\n\r\n")
    if split < 0:
        return HttpProbe(ok: false, status: -1, headers: raw, body: "")
    val head = raw.slice(0, split)
    val resp_body = raw.slice(split + 4, raw.len())

    var status: i64 = -1
    val first_nl = head.index_of("\r\n")
    val status_line = if first_nl > 0: head.slice(0, first_nl) else: head
    val sp1 = status_line.index_of(" ")
    if sp1 > 0:
        val rest = status_line.slice(sp1 + 1, status_line.len())
        val sp2 = rest.index_of(" ")
        val code_text = if sp2 > 0: rest.slice(0, sp2) else: rest
        status = code_text.to_i64()

    HttpProbe(ok: status > 0, status: status, headers: head, body: resp_body)

fn http_request(addr: text, method: text, path: text, body: text) -> HttpProbe:
    http_request_ex(addr, method, path, body, "Authorization: Bearer {TEST_TOKEN}\r\n")

fn json_field(body: text, key: text) -> text:
    val needle = "\"{key}\":\""
    val idx = body.index_of(needle)
    if idx < 0:
        return ""
    val start = idx + needle.len()
    val rest = body.slice(start, body.len())
    val endq = rest.index_of("\"")
    if endq < 0:
        return ""
    rest.slice(0, endq)

fn repeat_char(ch: text, n: i64) -> text:
    var out = ""
    var i: i64 = 0
    while i < n:
        out = "{out}{ch}"
        i = i + 1
    out

# ============================================================================
# Evidence recorder — every example appends a plain-text line here; the last
# example writes the accumulated buffer to a file this agent reads back to
# fill in `doc/09_report/notebook_lanes_robustness_evidence_2026-08-07.md`
# with real, not fabricated, numbers.
# ============================================================================

val EVIDENCE_PATH = "doc/09_report/_h3_robustness_evidence.raw.txt"

var EVIDENCE: [text] = []

fn record(line: text):
    EVIDENCE.push(line)
    print "H3-EVIDENCE {line}"

fn flush_evidence():
    var out = ""
    for line in EVIDENCE:
        out = "{out}{line}\n"
    val _w = rt_file_write_text(EVIDENCE_PATH, out)

# ============================================================================
# Spec
# ============================================================================

describe "Simple Lab robustness evidence (H3: load smoke + 100-cell soak + fuzz-lite, real loopback)":

    it "load smoke: 200 sequential authenticated GET /api/lab/status requests, all 200, panic-free":
        val n: i64 = 200
        val server = start_lab_server(n + 5)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        step("fire {n} sequential authenticated status requests and time each")
        var ok_count: i64 = 0
        var min_us: i64 = -1
        var max_us: i64 = -1
        var total_us: i64 = 0
        var i: i64 = 0
        while i < n:
            val t0 = rt_time_now_unix_micros()
            val resp = http_request(server.addr, "GET", "/api/lab/status", "")
            val t1 = rt_time_now_unix_micros()
            val dt = t1 - t0
            if resp.status == 200:
                ok_count = ok_count + 1
            total_us = total_us + dt
            if min_us < 0 or dt < min_us:
                min_us = dt
            if dt > max_us:
                max_us = dt
            i = i + 1

        val avg_us = total_us / n
        record("load_smoke requests={n} ok={ok_count} min_us={min_us} max_us={max_us} avg_us={avg_us}")
        expect(ok_count).to_equal(n)
        # Generous ceiling (5s/req) — this asserts "no pathological stall",
        # not a tight perf budget; see the report for the actual numbers.
        expect(max_us).to_be_less_than(5000000)

        step("the server is still alive after the load smoke")
        val final_status = http_request(server.addr, "GET", "/api/lab/status", "")
        expect(final_status.status).to_equal(200)

        server.stop()

    it "100-cell soak: one session, 100 sequential real cell executions, all ok, panic-free":
        val n: i64 = 100
        val server = start_lab_server(n + 10)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        step("create one real session")
        val create_resp = http_request(server.addr, "POST", "/api/lab/sessions", "{\"default_mode\":\"interpreter\"}")
        expect(create_resp.status).to_equal(201)
        val session_id = json_field(create_resp.body, "id")
        expect(session_id).to_start_with("sess_")

        step("execute {n} cells sequentially through the real .../execute route (not /api/test/click — see the filed gap for that path)")
        var ok_count: i64 = 0
        var min_us: i64 = -1
        var max_us: i64 = -1
        var total_us: i64 = 0
        var i: i64 = 0
        while i < n:
            val cell_id = "c{i}"
            val exec_path = "/api/lab/sessions/{session_id}/cells/{cell_id}/execute"
            val source_json = "{\"source\":\"print(\\\"cell-{i}\\\")\"}"
            val t0 = rt_time_now_unix_micros()
            val resp = http_request(server.addr, "POST", exec_path, source_json)
            val t1 = rt_time_now_unix_micros()
            val dt = t1 - t0
            if resp.status == 200 and resp.body.contains("\"ok\":true"):
                ok_count = ok_count + 1
            total_us = total_us + dt
            if min_us < 0 or dt < min_us:
                min_us = dt
            if dt > max_us:
                max_us = dt
            i = i + 1

        val avg_us = total_us / n
        record("cell_soak cells={n} ok={ok_count} min_us={min_us} max_us={max_us} avg_us={avg_us}")
        expect(ok_count).to_equal(n)

        step("the server is still alive and correct after the soak")
        val final_status = http_request(server.addr, "GET", "/api/lab/status", "")
        expect(final_status.status).to_equal(200)
        expect(final_status.body).to_contain("\"session_count\":1")

        server.stop()

    it "fuzz-lite corpus: malformed JSON, oversized header, too-many-headers, and a truncated WS handshake all get 4xx/close, never a panic":
        val server = start_lab_server(30)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        var fuzz_ok: i64 = 0
        var fuzz_total: i64 = 0

        step("malformed JSON body corpus on POST /api/lab/sessions")
        val bad_bodies = [
            "not json at all",
            "{{{{",
            "{\"default_mode\":}",
            "[1,2,",
            "␀binary-garbage",
            "{\"default_mode\":\"interpreter\"" # missing closing brace
        ]
        for bad in bad_bodies:
            fuzz_total = fuzz_total + 1
            val resp = http_request(server.addr, "POST", "/api/lab/sessions", bad)
            if resp.ok and resp.status >= 400 and resp.status < 500:
                fuzz_ok = fuzz_ok + 1
            else:
                record("fuzz_fail malformed_json body={bad} status={resp.status}")

        step("oversized single header line (20000 bytes, well over the 8192-byte cap)")
        val fuzz_x = "x"
        val huge_header = "X-Fuzz-Oversized: {repeat_char(fuzz_x, 20000)}\r\n"
        fuzz_total = fuzz_total + 1
        val oversized_resp = http_request_ex(server.addr, "GET", "/api/lab/status", "", "Authorization: Bearer {TEST_TOKEN}\r\n{huge_header}")
        if oversized_resp.ok and oversized_resp.status >= 400 and oversized_resp.status < 500:
            fuzz_ok = fuzz_ok + 1
        else:
            record("fuzz_fail oversized_header status={oversized_resp.status} ok={oversized_resp.ok}")

        step("too-many-headers request (110 headers, over the 100-header cap)")
        var many_headers = "Authorization: Bearer {TEST_TOKEN}\r\n"
        var h: i64 = 0
        while h < 110:
            many_headers = "{many_headers}X-Fuzz-{h}: v\r\n"
            h = h + 1
        fuzz_total = fuzz_total + 1
        val many_resp = http_request_ex(server.addr, "GET", "/api/lab/status", "", many_headers)
        if many_resp.ok and many_resp.status >= 400 and many_resp.status < 500:
            fuzz_ok = fuzz_ok + 1
        else:
            record("fuzz_fail too_many_headers status={many_resp.status} ok={many_resp.ok}")

        step("WS handshake request truncated mid-write (connection closed before the terminating CRLFCRLF) — must not hang or crash the server")
        fuzz_total = fuzz_total + 1
        val trunc_stream_res = TcpStream.connect(server.addr)
        var trunc_survived = false
        if trunc_stream_res.is_ok():
            var trunc_stream = trunc_stream_res.unwrap()
            # Deliberately incomplete: request line + one header, no blank
            # line, then close — simulates a client that dies mid-handshake.
            val partial = "GET /api/lab/sessions/nonexistent/events HTTP/1.1\r\nUpgrade: websocket\r\n"
            val _w = trunc_stream.write_text(partial)
            val _f2 = trunc_stream.flush()
            val _c2 = trunc_stream.close()
            trunc_survived = true
        if trunc_survived:
            fuzz_ok = fuzz_ok + 1
        else:
            record("fuzz_fail truncated_ws_handshake connect_failed")

        record("fuzz_lite total={fuzz_total} ok_or_4xx={fuzz_ok}")
        expect(fuzz_ok).to_equal(fuzz_total)

        step("the server survived the entire fuzz-lite corpus and still answers correctly")
        val final_status = http_request(server.addr, "GET", "/api/lab/status", "")
        expect(final_status.ok).to_equal(true)
        expect(final_status.status).to_equal(200)
        expect(final_status.headers.to_lower()).to_contain("x-lab-protocol-version: 1")

        server.stop()
        flush_evidence()
