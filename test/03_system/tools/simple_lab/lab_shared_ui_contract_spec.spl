"""
## Purpose and audience
Purpose: GET /api/test/ready reports the shared protocol version header and body
Audience: compiler and tooling engineers who maintain this spec

# Simple Lab shared UI contract — real loopback system spec (Stream L, task L4)

Drives `src/app/simple_lab/lab_server.spl` as a separate OS process over a
real TCP socket (same subprocess driver as
`test/03_system/tools/simple_lab/lab_http_api_spec.spl`, L3) and exercises the
`/api/test/...` routes L4 mounts via the shared
`app.ui.test_api.handler.handle_test_request` handler — the same handler
`app.ui.web` and `app.ui.tui_web` mount (see
`src/app/ui.test_api/mount.spl`).

Design: doc/04_architecture/ui/shared_ui_contract.md
Plan:   doc/03_plan/agent_tasks/notebook_lanes_parallel_plan_2026-08-07.md (Stream L, L4)

`bin/simple run`'s cold-start compile+lint pass alone measures ~50s in this
environment before a subprocess starts listening, so the boot poll budget
here is 150s (matching L3's `start_lab_server`) and this whole spec run is
expected to take multiple minutes; a slow-but-eventually-successful boot is
not a bug.
"""

# @req: REQ-TOOLS-LabSharUiCont-001

# tag: slow, system

use std.spec.*
use std.nogc_sync_mut.io.tcp.{TcpStream}

extern fn rt_process_spawn_async(cmd: text, args: [text]) -> i64
extern fn rt_process_kill(pid: i64) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_env_get(key: text) -> text
extern fn rt_env_cwd() -> text
extern fn rt_sleep_ms(ms: i64)
extern fn rt_time_now_unix_micros() -> i64
extern fn rt_getpid() -> i64

val SERVER_ENTRYPOINT = "src/app/simple_lab/lab_server.spl"

# ============================================================================
# Subprocess driver — copied from lab_http_api_spec.spl (L3) rather than
# imported, so this file stays independently runnable and matches the repo's
# existing pattern of per-spec self-contained drivers
# (test/helpers/browser_h1_loopback_driver.spl callers do the same).
# ============================================================================

fn env_or(key: text, fallback: text) -> text:
    val v = rt_env_get(key)
    if v == nil or v == "":
        fallback
    else:
        v

fn scratch_dir() -> text:
    val t = rt_env_get("SIMPLE_TEST_SCRATCH_DIR")
    if t != nil and t != "":
        return t
    val tmp = rt_env_get("TMPDIR")
    if tmp != nil and tmp != "" and tmp.starts_with("/"):
        return tmp
    return "/tmp"

fn repo_root() -> text:
    val r = rt_env_get("SIMPLE_REPO_ROOT")
    if r != nil and r != "":
        return r
    val c = rt_env_cwd()
    if c == nil:
        return "."
    return c

class LabServerProc:
    pid: i64
    addr: text
    port: i64
    portfile: text
    notebook_root: text
    started: bool

    me stop():
        if self.pid > 0:
            val _ = rt_process_kill(self.pid)
            self.pid = -1
        if self.portfile != "":
            val _ = rt_file_delete(self.portfile)

fn start_lab_server(max_requests: i64) -> LabServerProc:
    val root = repo_root()
    val stamp = rt_time_now_unix_micros()
    val me_pid = rt_getpid()
    val dir = scratch_dir()
    val base = "{dir}/simple_lab_contract_{me_pid}_{stamp}"
    val portfile = "{base}.port"
    val notebook_root = "{base}_notebooks"

    var server = LabServerProc(pid: -1, addr: "", port: -1, portfile: portfile, notebook_root: notebook_root, started: false)

    if rt_file_exists(portfile):
        val _ = rt_file_delete(portfile)

    # SIMPLE_EXECUTION_MODE=interpreter pins the server subprocess off the
    # JIT: this repo's own notes document named-function-as-value route
    # handlers (exactly what lab_server.spl's Router registration does)
    # returning garbage under the JIT (`bin/simple run` bare default).
    val args = [
        "SIMPLE_EXECUTION_MODE=interpreter",
        "SIMPLE_LAB_HTTP_PORT=0",
        "SIMPLE_LAB_HTTP_MAX={max_requests}",
        "SIMPLE_LAB_HTTP_PORTFILE={portfile}",
        "SIMPLE_LAB_HTTP_ACCEPT_TIMEOUT_MS=20000",
        "SIMPLE_LAB_NOTEBOOK_ROOT={notebook_root}",
        "{root}/bin/simple",
        "run",
        "{root}/{SERVER_ENTRYPOINT}"
    ]
    val pid = rt_process_spawn_async("env", args)
    if pid <= 0:
        return server
    server.pid = pid

    # 150s budget: bin/simple run's cold-start compile+lint pass alone took
    # ~50s in this environment before the subprocess even began listening
    # (see lab_http_api_spec.spl's identical note).
    var waited = 0
    var bound = ""
    while waited < 150000:
        if rt_file_exists(portfile):
            val t = rt_file_read_text(portfile)
            if t != nil and t.trim() != "":
                bound = t.trim()
                waited = 150000
        if bound == "":
            rt_sleep_ms(50)
            waited = waited + 50

    if bound == "":
        server.stop()
        return server

    server.addr = bound
    server.started = true
    val colon = bound.last_index_of(":")
    if colon >= 0:
        server.port = bound.substring(colon + 1, bound.len()).to_i64()
    return server

# ============================================================================
# Minimal real HTTP/1.1 client over TcpStream (no mocks, no in-process shim).
# ============================================================================

struct HttpProbe:
    ok: bool
    status: i64
    headers: text
    body: text

fn http_request(addr: text, method: text, path: text, body: text) -> HttpProbe:
    val stream_res = TcpStream.connect(addr)
    if stream_res.is_err():
        return HttpProbe(ok: false, status: -1, headers: "", body: "connect failed")
    var stream = stream_res.unwrap()

    val clen = body.len()
    var req = "{method} {path} HTTP/1.1\r\nHost: {addr}\r\nContent-Length: {clen}\r\nContent-Type: application/json\r\nConnection: close\r\n\r\n{body}"
    val w = stream.write_text(req)
    if w.is_err():
        val _ = stream.close()
        return HttpProbe(ok: false, status: -1, headers: "", body: "write failed")
    val _f = stream.flush()

    val read_res = stream.read_text()
    val _c = stream.close()
    if read_res.is_err():
        return HttpProbe(ok: false, status: -1, headers: "", body: "read failed")
    val raw = read_res.unwrap()

    val split = raw.index_of("\r\n\r\n")
    if split < 0:
        return HttpProbe(ok: false, status: -1, headers: raw, body: "")
    val head = raw.slice(0, split)
    val resp_body = raw.slice(split + 4, raw.len())

    var status: i64 = -1
    val first_nl = head.index_of("\r\n")
    val status_line = if first_nl > 0: head.slice(0, first_nl) else: head
    val sp1 = status_line.index_of(" ")
    if sp1 > 0:
        val rest = status_line.slice(sp1 + 1, status_line.len())
        val sp2 = rest.index_of(" ")
        val code_text = if sp2 > 0: rest.slice(0, sp2) else: rest
        status = code_text.to_i64()

    HttpProbe(ok: status > 0, status: status, headers: head, body: resp_body)

# ============================================================================
# Spec
# ============================================================================

describe "Simple Lab shared UI contract (/api/test/..., real loopback)":

    it "GET /api/test/ready reports the shared protocol version header and body":
        step("Verify: GET /api/test/ready reports the shared protocol version header and body")
        # @req: REQ-TOOLS-LabSharUiCont-001
        val server = start_lab_server(20)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        step("GET /api/test/ready carries X-UI-Protocol-Version and the ready body")
        val resp = http_request(server.addr, "GET", "/api/test/ready", "")
        expect(resp.ok).to_equal(true)
        expect(resp.status).to_equal(200)  # oracle: value fixed by the spec contract
        expect(resp.headers.to_lower()).to_contain("x-ui-protocol-version: 1")
        expect(resp.body).to_contain("\"ready\":true")
        expect(resp.body).to_contain("\"protocol_version\":1")

        server.stop()

    it "GET /api/test/elements lists Simple Lab's stable element ids":
        step("Verify: GET /api/test/elements lists Simple Lab's stable element ids")
        # @req: REQ-TOOLS-LabSharUiCont-001
        val server = start_lab_server(20)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        step("GET /api/test/elements returns the L2 widget tree (lab_root, toolbar, cell_0)")
        val resp = http_request(server.addr, "GET", "/api/test/elements", "")
        expect(resp.ok).to_equal(true)
        expect(resp.status).to_equal(200)  # oracle: value fixed by the spec contract
        expect(resp.body).to_contain("lab_add_cell")
        expect(resp.body).to_contain("cell_0_editor")
        expect(resp.body).to_contain("cell_0_run")

        server.stop()

    it "POST /api/test/click on lab_add_cell adds a cell — read-after-write via GET /api/test/elements":
        step("Verify: POST /api/test/click on lab_add_cell adds a cell — read-after-write via GET /api/test/elements")
        # @req: REQ-TOOLS-LabSharUiCont-001
        val server = start_lab_server(20)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        step("baseline: only cell_0 exists, no cell_1")
        val before = http_request(server.addr, "GET", "/api/test/elements", "")
        expect(before.body).to_contain("cell_0")
        expect(before.body).to_not_contain("cell_1_editor")

        step("POST /api/test/click {id: lab_add_cell}")
        val click_resp = http_request(server.addr, "POST", "/api/test/click", "{\"id\":\"lab_add_cell\"}")
        expect(click_resp.ok).to_equal(true)
        expect(click_resp.status).to_equal(200)  # oracle: value fixed by the spec contract
        expect(click_resp.body).to_contain("\"ok\":true")

        step("read-after-write: GET /api/test/elements now includes cell_1")
        val after = http_request(server.addr, "GET", "/api/test/elements", "")
        expect(after.body).to_contain("cell_1_editor")

        server.stop()

    it "GET /api/test/element?id=X on an unknown id returns the structured error shape":
        step("Verify: GET /api/test/element?id=X on an unknown id returns the structured error shape")
        # @req: REQ-TOOLS-LabSharUiCont-001
        val server = start_lab_server(20)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        val resp = http_request(server.addr, "GET", "/api/test/element?id=does_not_exist", "")
        expect(resp.ok).to_equal(true)
        expect(resp.status).to_equal(404)  # oracle: value fixed by the spec contract
        expect(resp.body).to_contain("\"error\":\"element_not_found\"")

        server.stop()

    it "unknown /api/test/... route returns 404 not_found":
        step("Verify: unknown /api/test/... route returns 404 not_found")
        # @req: REQ-TOOLS-LabSharUiCont-001
        val server = start_lab_server(20)
        if not server.started:
            fail("lab_server subprocess did not start listening")

        val resp = http_request(server.addr, "GET", "/api/test/nope", "")
        expect(resp.ok).to_equal(true)
        expect(resp.status).to_equal(404)  # oracle: value fixed by the spec contract
        expect(resp.body).to_contain("\"error\":\"not_found\"")

        server.stop()
