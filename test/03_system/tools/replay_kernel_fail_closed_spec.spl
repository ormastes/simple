# @cover src/os/kernel/replay/hooks.spl 40%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-DHR-05
# plan: doc/03_plan/app/debug/dhr_debug_spy_replay_recovery_plan_2026-11-17.md

# RR-02: kernel replay must fail closed. A Replay-mode timer/random read that
# meets an exhausted log or a mismatched event reports a divergence instead of
# silently returning the live value. P6: in Replay the scheduler dispatches the
# logged tid; an exhausted log or non-runnable logged tid dispatches nothing.
# P6: syscall results replay the logged retval, and IRQ/IPC events are
# accepted only when they match the log — never the live value on divergence.

use std.spec.*
use os.kernel.replay.mode.{KernelReplayMode, replay_set_mode}
use os.kernel.replay.log_buffer.{replay_buffer_reset, replay_window_complete, replay_event_count}
use os.kernel.replay.divergence.{clear_divergences, get_divergence_count}
use std.replay.portable_replay.{portable_replay_pending, PR_FAIL_CLOSED_VALUE, PR_SCOPE_KERNEL}
use os.kernel.replay.hooks.{
    replay_hook_timer_read, replay_hook_random_read, replay_hook_schedule,
    replay_hook_syscall_exit, replay_hook_irq, replay_hook_ipc_send, replay_hook_ipc_recv
}
use os.kernel.scheduler.scheduler.{Scheduler}
use os.kernel.types.task_types.{TaskPriority}
use os.kernel.types.capability_types.{CapabilitySet}

fn _reset():
    replay_set_mode(KernelReplayMode.Off)
    replay_buffer_reset()
    clear_divergences()

describe "kernel replay fail-closed (RR-02)":
    it "a freshly reset log is a complete replay window (RR-05)":
        _reset()
        expect(replay_window_complete()).to_equal(true)

    it "timer replay returns the recorded value with no divergence":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_timer_read(3, 1)).to_equal(777)
        expect(get_divergence_count()).to_equal(0)

    it "timer replay at end-of-log reports a divergence":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        replay_hook_timer_read(3, 1)
        expect(get_divergence_count()).to_equal(1)

    it "timer replay from a different source reports a divergence":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_set_mode(KernelReplayMode.Replay)
        replay_hook_timer_read(4, 1)
        expect(get_divergence_count()).to_equal(1)

    it "random replay meeting a timer event reports a divergence":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_set_mode(KernelReplayMode.Replay)
        replay_hook_random_read(1, 5)
        expect(get_divergence_count()).to_equal(1)

    it "timer replay divergence returns the fail-closed value, not the live read (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_timer_read(4, 1234)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(replay_hook_timer_read(3, 1234)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(get_divergence_count()).to_equal(2)

    it "random replay returns the recorded value with no divergence (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_random_read(1, 55)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_random_read(1, 9)).to_equal(55)
        expect(get_divergence_count()).to_equal(0)

    it "random replay at end-of-log diverges and fails closed (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_random_read(1, 9)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(get_divergence_count()).to_equal(1)

    it "timer verify returns the live read and reports a changed value (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_set_mode(KernelReplayMode.Verify)
        expect(replay_hook_timer_read(3, 778)).to_equal(778)
        expect(get_divergence_count()).to_equal(1)

    it "timer and random reads are logged by the portable core, not the kernel ring (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_timer_read(3, 777)
        replay_hook_random_read(1, 55)
        expect(portable_replay_pending(PR_SCOPE_KERNEL)).to_equal(2)
        expect(replay_event_count()).to_equal(0)

    it "syscall exit replay returns the logged result, not the live one (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_syscall_exit(0, 7, 42)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_syscall_exit(0, 7, 99)).to_equal(42)
        expect(get_divergence_count()).to_equal(0)

    it "syscall exit replay of a different syscall diverges and fails closed with -EIO (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_syscall_exit(0, 7, 42)
        replay_set_mode(KernelReplayMode.Replay)
        val r = replay_hook_syscall_exit(0, 8, 42)
        expect(r).to_equal(-5)  # -EIO (os.kernel.errno EIO = 5)
        expect(r != 0).to_equal(true)
        expect(get_divergence_count()).to_equal(1)

    it "syscall exit replay at end-of-log diverges and fails closed with -EIO (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        val r = replay_hook_syscall_exit(0, 7, 99)
        expect(r).to_equal(-5)  # -EIO (os.kernel.errno EIO = 5)
        expect(r != 0).to_equal(true)
        expect(get_divergence_count()).to_equal(1)

    it "irq replay accepts the logged vector (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_irq(33, 0, 0)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_irq(33, 0, 0)).to_equal(true)
        expect(get_divergence_count()).to_equal(0)

    it "irq replay of a different vector diverges and is not delivered (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_irq(33, 0, 0)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_irq(34, 0, 0)).to_equal(false)
        expect(get_divergence_count()).to_equal(1)

    it "irq replay at end-of-log diverges and is not delivered (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_irq(33, 0, 0)).to_equal(false)
        expect(get_divergence_count()).to_equal(1)

    it "ipc send replay accepts the logged port and length (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_ipc_send(0, 5, 16)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_send(0, 5, 16)).to_equal(true)
        expect(get_divergence_count()).to_equal(0)

    it "ipc send replay to a different port or with a different length diverges (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_ipc_send(0, 5, 16)
        replay_hook_ipc_send(0, 5, 16)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_send(0, 6, 16)).to_equal(false)
        expect(replay_hook_ipc_send(0, 5, 17)).to_equal(false)
        expect(get_divergence_count()).to_equal(2)

    it "ipc send replay at end-of-log diverges and is rejected (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_send(0, 5, 16)).to_equal(false)
        expect(get_divergence_count()).to_equal(1)

    it "ipc recv replay accepts the logged port and length (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_ipc_recv(0, 5, 16)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_recv(0, 5, 16)).to_equal(true)
        expect(get_divergence_count()).to_equal(0)

    it "ipc recv replay meeting a logged send diverges and is rejected (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_ipc_send(0, 5, 16)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_recv(0, 5, 16)).to_equal(false)
        expect(get_divergence_count()).to_equal(1)

    it "ipc recv replay at end-of-log diverges and is rejected (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_ipc_recv(0, 5, 16)).to_equal(false)
        expect(get_divergence_count()).to_equal(1)

    it "syscall result, irq and ipc events are logged by the portable core, not the kernel ring (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_syscall_exit(0, 7, 42)
        replay_hook_irq(33, 0, 0)
        replay_hook_ipc_send(0, 5, 16)
        replay_hook_ipc_recv(0, 5, 16)
        expect(portable_replay_pending(PR_SCOPE_KERNEL)).to_equal(4)
        expect(replay_event_count()).to_equal(0)

    it "schedule replay that matches the log reports no divergence":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_schedule(1, 2, 10)
        replay_set_mode(KernelReplayMode.Replay)
        replay_hook_schedule(1, 2, 10)
        expect(get_divergence_count()).to_equal(0)

    it "schedule replay returns the logged tid, not the live pick (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_schedule(1, 2, 10)
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_schedule(1, 3, 10)).to_equal(2)
        expect(get_divergence_count()).to_equal(0)

    it "schedule replay at end-of-log is a divergence, not the live pick (P6)":
        _reset()
        replay_set_mode(KernelReplayMode.Replay)
        expect(replay_hook_schedule(1, 3, 10)).to_equal(-1)
        expect(get_divergence_count()).to_equal(1)

    it "scheduler in replay dispatches the logged tid over its live pick (P6)":
        _reset()
        var probe = Scheduler.new()
        val pa = probe.create_task(0x1000, TaskPriority.Normal, CapabilitySet.empty())
        probe.create_task(0x2000, TaskPriority.Normal, CapabilitySet.empty())
        probe.schedule()
        val live = probe.get_current().id
        var s = Scheduler.new()
        val a = s.create_task(0x1000, TaskPriority.Normal, CapabilitySet.empty())
        val b = s.create_task(0x2000, TaskPriority.Normal, CapabilitySet.empty())
        var target = a.id
        if live == pa.id:
            target = b.id
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_schedule(0, target as i64, 0)
        replay_set_mode(KernelReplayMode.Replay)
        s.schedule()
        expect(s.get_current().id).to_equal(target)
        expect(get_divergence_count()).to_equal(0)

    it "scheduler in replay with a non-runnable logged tid diverges and dispatches nothing (P6)":
        _reset()
        var s = Scheduler.new()
        s.create_task(0x1000, TaskPriority.Normal, CapabilitySet.empty())
        val before = s.get_current().id
        replay_set_mode(KernelReplayMode.Record)
        replay_hook_schedule(0, 999, 0)
        replay_set_mode(KernelReplayMode.Replay)
        s.schedule()
        expect(get_divergence_count()).to_equal(1)
        expect(s.get_current().id).to_equal(before)

    it "scheduler in replay with an exhausted log diverges and dispatches nothing (P6)":
        _reset()
        var s = Scheduler.new()
        s.create_task(0x1000, TaskPriority.Normal, CapabilitySet.empty())
        val before = s.get_current().id
        replay_set_mode(KernelReplayMode.Replay)
        s.schedule()
        expect(get_divergence_count()).to_equal(1)
        expect(s.get_current().id).to_equal(before)
        replay_set_mode(KernelReplayMode.Off)

# RR-04: hardware reverse operations must not report success when the
# target executor did not move backward.
use std.nogc_sync_mut.debug.remote.replay.hardware_replay_controller.{HardwareReplayController}

fn _rd_reg(i: i32) -> Result<i64, text>:
    Ok(0)

fn _wr_reg(i: i32, v: i64) -> Result<text, text>:
    Ok("ok")

fn _rd_mem(a: i64, n: i32) -> Result<[i32], text>:
    Ok([])

fn _wr_mem(a: i64, d: [i32]) -> Result<text, text>:
    Ok("ok")

describe "hardware reverse ops are truthful (RR-04)":
    it "reverse_step reports unsupported":
        var c = HardwareReplayController.create(4, _rd_reg, _wr_reg, _rd_mem, _wr_mem)
        expect(c.reverse_step().is_err()).to_equal(true)

    it "reverse_continue reports unsupported":
        var c = HardwareReplayController.create(4, _rd_reg, _wr_reg, _rd_mem, _wr_mem)
        expect(c.reverse_continue().is_err()).to_equal(true)
