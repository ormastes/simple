"""
## Purpose and audience
Purpose: default is Off
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplKernEven-001

use std.spec
use os.kernel.replay.mode.{KernelReplayMode, replay_mode, replay_set_mode, replay_is_off, replay_is_recording}
use os.kernel.replay.event_kinds.{EventKind, ReplayEntry}
use os.kernel.replay.log_buffer.{replay_buffer_init, replay_log_event, replay_event_count, replay_buffer_reset, replay_read_next}

use std.spec.step
describe "KernelReplayMode":
    it "default is Off":
        step("Verify: default is Off")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Off)
        expect(replay_mode().to_i32()).to_equal(KernelReplayMode.Off.to_i32())

    it "replay_is_off default true":
        step("Verify: replay_is_off default true")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Off)
        expect(replay_is_off()).to_equal(true)

    it "replay_set_mode to Record — replay_is_recording returns true":
        step("Verify: replay_set_mode to Record — replay_is_recording returns true")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Record)
        expect(replay_is_recording()).to_equal(true)
        replay_set_mode(KernelReplayMode.Off)

    it "replay_set_mode to Off — replay_is_off true again":
        step("Verify: replay_set_mode to Off — replay_is_off true again")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Record)
        replay_set_mode(KernelReplayMode.Off)
        expect(replay_is_off()).to_equal(true)

    it "replay_is_recording is false when Off":
        step("Verify: replay_is_recording is false when Off")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Off)
        expect(replay_is_recording()).to_equal(false)

    it "ChaosRecord also counts as recording":
        step("Verify: ChaosRecord also counts as recording")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.ChaosRecord)
        expect(replay_is_recording()).to_equal(true)
        replay_set_mode(KernelReplayMode.Off)

describe "EventKind to_i32 round-trip":
    it "Schedule round-trips":
        step("Verify: Schedule round-trips")
        # @req: REQ-TOOLS-ReplKernEven-001
        val v = EventKind.Schedule.to_i32()
        expect(v).to_equal(0)  # oracle: value fixed by the spec contract
        expect(EventKind.from_i32(v).to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "SyscallEnter round-trips":
        step("Verify: SyscallEnter round-trips")
        # @req: REQ-TOOLS-ReplKernEven-001
        val v = EventKind.SyscallEnter.to_i32()
        expect(v).to_equal(1)  # oracle: value fixed by the spec contract
        expect(EventKind.from_i32(v).to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "SyscallExit round-trips":
        step("Verify: SyscallExit round-trips")
        # @req: REQ-TOOLS-ReplKernEven-001
        val v = EventKind.SyscallExit.to_i32()
        expect(v).to_equal(2)  # oracle: value fixed by the spec contract
        expect(EventKind.from_i32(v).to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

    it "InterruptDeliver round-trips":
        step("Verify: InterruptDeliver round-trips")
        # @req: REQ-TOOLS-ReplKernEven-001
        val v = EventKind.InterruptDeliver.to_i32()
        expect(v).to_equal(3)  # oracle: value fixed by the spec contract
        expect(EventKind.from_i32(v).to_i32()).to_equal(3)  # oracle: value fixed by the spec contract

    it "TimerRead round-trips":
        step("Verify: TimerRead round-trips")
        # @req: REQ-TOOLS-ReplKernEven-001
        val v = EventKind.TimerRead.to_i32()
        expect(v).to_equal(6)  # oracle: value fixed by the spec contract
        expect(EventKind.from_i32(v).to_i32()).to_equal(6)  # oracle: value fixed by the spec contract

describe "EventKind to_text":
    it "Schedule to_text":
        step("Verify: Schedule to_text")
        # @req: REQ-TOOLS-ReplKernEven-001
        expect(EventKind.Schedule.to_text()).to_equal("schedule")

    it "SyscallEnter to_text":
        step("Verify: SyscallEnter to_text")
        # @req: REQ-TOOLS-ReplKernEven-001
        expect(EventKind.SyscallEnter.to_text()).to_equal("syscall-enter")

    it "SyscallExit to_text":
        step("Verify: SyscallExit to_text")
        # @req: REQ-TOOLS-ReplKernEven-001
        expect(EventKind.SyscallExit.to_text()).to_equal("syscall-exit")

    it "InterruptDeliver to_text":
        step("Verify: InterruptDeliver to_text")
        # @req: REQ-TOOLS-ReplKernEven-001
        expect(EventKind.InterruptDeliver.to_text()).to_equal("interrupt")

    it "TimerRead to_text":
        step("Verify: TimerRead to_text")
        # @req: REQ-TOOLS-ReplKernEven-001
        expect(EventKind.TimerRead.to_text()).to_equal("timer-read")

describe "ReplayEntry creation":
    it "create sets kind field":
        step("Verify: create sets kind field")
        # @req: REQ-TOOLS-ReplKernEven-001
        val entry = ReplayEntry.create(EventKind.SyscallEnter, 42, 1, 0)
        expect(entry.kind).to_equal(EventKind.SyscallEnter.to_i32())

    it "create sets thread_id field":
        step("Verify: create sets thread_id field")
        # @req: REQ-TOOLS-ReplKernEven-001
        val entry = ReplayEntry.create(EventKind.Schedule, 99, 2, 0)
        expect(entry.thread_id).to_equal(99)  # oracle: value fixed by the spec contract

    it "create sets process_id field":
        step("Verify: create sets process_id field")
        # @req: REQ-TOOLS-ReplKernEven-001
        val entry = ReplayEntry.create(EventKind.Schedule, 1, 77, 0)
        expect(entry.process_id).to_equal(77)  # oracle: value fixed by the spec contract

    it "create sets event_id to 0":
        step("Verify: create sets event_id to 0")
        # @req: REQ-TOOLS-ReplKernEven-001
        val entry = ReplayEntry.create(EventKind.TimerRead, 1, 1, 0)
        expect(entry.event_id).to_equal(0)  # oracle: value fixed by the spec contract

    it "event_kind() returns correct kind":
        step("Verify: event_kind() returns correct kind")
        # @req: REQ-TOOLS-ReplKernEven-001
        val entry = ReplayEntry.create(EventKind.SyscallExit, 1, 1, 0)
        expect(entry.event_kind()).to_equal(EventKind.SyscallExit)

describe "replay ring buffer":
    it "replay_buffer_init — event_count is 0":
        step("Verify: replay_buffer_init — event_count is 0")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Off)
        replay_buffer_reset()
        replay_buffer_init()
        expect(replay_event_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "replay_log_event — event_count becomes 1":
        step("Verify: replay_log_event — event_count becomes 1")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_buffer_reset()
        replay_set_mode(KernelReplayMode.Record)
        val entry = ReplayEntry.create(EventKind.Schedule, 1, 1, 0)
        replay_log_event(entry)
        expect(replay_event_count()).to_equal(1)  # oracle: value fixed by the spec contract
        replay_set_mode(KernelReplayMode.Off)
        replay_buffer_reset()

    it "replay_log_event multiple — count matches":
        step("Verify: replay_log_event multiple — count matches")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_buffer_reset()
        replay_set_mode(KernelReplayMode.Record)
        val e0 = ReplayEntry.create(EventKind.Schedule, 0, 1, 0)
        val e1 = ReplayEntry.create(EventKind.Schedule, 1, 1, 0)
        val e2 = ReplayEntry.create(EventKind.Schedule, 2, 1, 0)
        val e3 = ReplayEntry.create(EventKind.Schedule, 3, 1, 0)
        val e4 = ReplayEntry.create(EventKind.Schedule, 4, 1, 0)
        replay_log_event(e0)
        replay_log_event(e1)
        replay_log_event(e2)
        replay_log_event(e3)
        replay_log_event(e4)
        expect(replay_event_count()).to_equal(5)  # oracle: value fixed by the spec contract
        replay_set_mode(KernelReplayMode.Off)
        replay_buffer_reset()

    it "replay_buffer_reset — count returns to 0":
        step("Verify: replay_buffer_reset — count returns to 0")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_set_mode(KernelReplayMode.Record)
        val entry = ReplayEntry.create(EventKind.TimerRead, 1, 1, 0)
        replay_log_event(entry)
        replay_buffer_reset()
        expect(replay_event_count()).to_equal(0)  # oracle: value fixed by the spec contract
        replay_set_mode(KernelReplayMode.Off)

    it "replay_read_next — returns logged entry fields":
        step("Verify: replay_read_next — returns logged entry fields")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_buffer_reset()
        replay_set_mode(KernelReplayMode.Record)
        var entry = ReplayEntry.create(EventKind.SyscallEnter, 55, 7, 2)
        entry.payload_a = 123
        replay_log_event(entry)
        replay_set_mode(KernelReplayMode.Replay)
        match replay_read_next():
            case Some(got):
                expect(got.kind).to_equal(EventKind.SyscallEnter.to_i32())
                expect(got.thread_id).to_equal(55)  # oracle: value fixed by the spec contract
                expect(got.payload_a).to_equal(123)  # oracle: value fixed by the spec contract
            case None:
                expect("read_next returned None").to_equal("expected Some")
        replay_set_mode(KernelReplayMode.Off)
        replay_buffer_reset()

    it "replay_read_next on empty buffer returns None":
        step("Verify: replay_read_next on empty buffer returns None")
        # @req: REQ-TOOLS-ReplKernEven-001
        replay_buffer_reset()
        replay_set_mode(KernelReplayMode.Replay)
        match replay_read_next():
            case Some(_):
                expect("expected None but got Some").to_equal("None")
            case None:
                expect(replay_mode().to_i32()).to_equal(KernelReplayMode.Replay.to_i32())
        replay_set_mode(KernelReplayMode.Off)
        replay_buffer_reset()
