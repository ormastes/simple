# @cover src/os/realtime/replay/hooks.spl 60%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-DHR-05
# plan: doc/03_plan/app/debug/dhr_debug_spy_replay_recovery_plan_2026-11-17.md

# DHR P6 portability proof: the realtime random hook runs on the portable
# semantic replay core (std.replay.portable_replay). These pins were taken on
# the pre-P6 ring implementation and must hold unchanged on the core, except
# the divergence return value: P6 removed the live fallback, so a diverging
# Replay read now returns the core's fail-closed value (the routing and
# fail-closed examples are P6-only).

use std.spec.*
use std.replay.bm_replay_core.{bm_ring_init, bm_ring_count}
use std.replay.portable_replay.{portable_replay_reset, portable_replay_pending, PR_FAIL_CLOSED_VALUE}
use os.realtime.replay.mode.{rtos_replay_set_mode, rtos_replay_next_seq}
use os.realtime.replay.hooks.{rr_hook_random, rr_hook_io_read, rr_hook_schedule, rr_hook_timer_tick, rr_hook_irq,
    rr_divergence_count, rr_reset_divergences, rr_event_count}

val OFF: i32 = 0
val RECORD: i32 = 1
val REPLAY: i32 = 2
val VERIFY: i32 = 3
val CHAOS: i32 = 4

fn _reset():
    rtos_replay_set_mode(OFF)
    bm_ring_init()
    portable_replay_reset()
    rr_reset_divergences()

describe "realtime random hook on the portable replay core":
    it "Off returns the live value and logs nothing":
        _reset()
        expect(rr_hook_random(17)).to_equal(17)
        expect(rr_event_count()).to_equal(0)

    it "Record returns the live value, logs one event and consumes one seq":
        _reset()
        rtos_replay_set_mode(RECORD)
        expect(rr_hook_random(42)).to_equal(42)
        expect(rr_event_count()).to_equal(1)
        expect(rtos_replay_next_seq()).to_equal(2)

    it "ChaosRecord records like Record":
        _reset()
        rtos_replay_set_mode(CHAOS)
        expect(rr_hook_random(5)).to_equal(5)
        expect(rr_event_count()).to_equal(1)

    it "Replay returns the recorded values in order with no divergence":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        rr_hook_random(43)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_random(900)).to_equal(42)
        expect(rr_hook_random(901)).to_equal(43)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_event_count()).to_equal(0)

    it "Replay of an exhausted log counts a divergence and fails closed":
        # Changed contract (DHR P6 "no live fallback"): this example used to
        # pin the live value 77 being returned on divergence. Replay must never
        # hand the live value back, so it now returns the core's fail-closed value.
        _reset()
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_random(77)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay past the recorded values fails closed, never live (P6)":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_random(900)).to_equal(42)
        expect(rr_hook_random(901)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)
        expect(rr_event_count()).to_equal(0)

    it "Verify returns the live value without divergence or consumption":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        rtos_replay_set_mode(VERIFY)
        expect(rr_hook_random(8)).to_equal(8)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_event_count()).to_equal(1)

    it "random reads are logged by the portable core, not the bare-metal ring":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        expect(portable_replay_pending()).to_equal(1)
        expect(bm_ring_count()).to_equal(0)

# DHR P6: io reads moved off the bare-metal ring onto the portable core in
# the same realtime scope. Replay has no live fallback; Verify keeps its
# contract (live value + divergence report), reading the log from the core.
describe "realtime io read hook on the portable replay core":
    it "Record returns the live value and logs it on the core, not the ring":
        _reset()
        rtos_replay_set_mode(RECORD)
        expect(rr_hook_io_read(0x40, 10)).to_equal(10)
        expect(portable_replay_pending()).to_equal(1)
        expect(bm_ring_count()).to_equal(0)

    it "Replay returns the logged values in order, not the live ones":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_io_read(0x40, 10)
        rr_hook_io_read(0x44, 11)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_io_read(0x40, 900)).to_equal(10)
        expect(rr_hook_io_read(0x44, 901)).to_equal(11)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_event_count()).to_equal(0)

    it "Replay against a logged random read fails closed, never live":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_io_read(0x40, 77)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay of an exhausted log fails closed, never live":
        _reset()
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_io_read(0x40, 77)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)

    it "Verify returns live, consumes the logged value and reports a mismatch":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_io_read(0x40, 10)
        rr_hook_io_read(0x44, 11)
        rtos_replay_set_mode(VERIFY)
        expect(rr_hook_io_read(0x40, 10)).to_equal(10)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_hook_io_read(0x44, 12)).to_equal(12)
        expect(rr_divergence_count()).to_equal(1)
        expect(rr_event_count()).to_equal(0)
        expect(rr_hook_io_read(0x48, 13)).to_equal(13)
        expect(rr_divergence_count()).to_equal(2)

# DHR P6: the realtime schedule, timer and IRQ hooks moved off the bare-metal
# ring onto the portable core in the same realtime scope. Replay follows the
# log (logged tid / logged tick / only the logged vector) and fails closed on a
# wrong event or an exhausted log; it never hands back the live decision.
describe "realtime schedule hook on the portable replay core":
    it "Record returns the live pick and logs it on the core, not the ring":
        _reset()
        rtos_replay_set_mode(RECORD)
        expect(rr_hook_schedule(0, 3, 10)).to_equal(3)
        expect(portable_replay_pending()).to_equal(1)
        expect(bm_ring_count()).to_equal(0)

    it "Replay returns the logged tid, not the live pick":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_schedule(0, 3, 10)
        rr_hook_schedule(3, 5, 11)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_schedule(0, 7, 10)).to_equal(3)
        expect(rr_hook_schedule(3, 7, 11)).to_equal(5)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_event_count()).to_equal(0)

    it "Replay against a logged random read fails closed, dispatching nothing":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_random(42)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_schedule(0, 3, 10)).to_equal(-1)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay of an exhausted log fails closed, dispatching nothing":
        _reset()
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_schedule(0, 3, 10)).to_equal(-1)
        expect(rr_divergence_count()).to_equal(1)

    it "Verify returns the live pick and reports a different one":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_schedule(0, 3, 10)
        rr_hook_schedule(3, 5, 11)
        rtos_replay_set_mode(VERIFY)
        expect(rr_hook_schedule(0, 3, 10)).to_equal(3)
        expect(rr_divergence_count()).to_equal(0)
        expect(rr_hook_schedule(3, 6, 11)).to_equal(6)
        expect(rr_divergence_count()).to_equal(1)

describe "realtime timer tick hook on the portable replay core":
    it "Record returns the live tick and logs it on the core, not the ring":
        _reset()
        rtos_replay_set_mode(RECORD)
        expect(rr_hook_timer_tick(100)).to_equal(100)
        expect(portable_replay_pending()).to_equal(1)
        expect(bm_ring_count()).to_equal(0)

    it "Replay returns the logged ticks in order, not the live ones":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_timer_tick(100)
        rr_hook_timer_tick(101)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_timer_tick(900)).to_equal(100)
        expect(rr_hook_timer_tick(901)).to_equal(101)
        expect(rr_divergence_count()).to_equal(0)

    it "Replay against a logged schedule decision fails closed, never live":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_schedule(0, 3, 10)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_timer_tick(900)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay of an exhausted log fails closed, never live":
        _reset()
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_timer_tick(900)).to_equal(PR_FAIL_CLOSED_VALUE)
        expect(rr_divergence_count()).to_equal(1)

describe "realtime IRQ hook on the portable replay core":
    it "Record delivers and logs the vector on the core, not the ring":
        _reset()
        rtos_replay_set_mode(RECORD)
        expect(rr_hook_irq(32, 10)).to_equal(true)
        expect(portable_replay_pending()).to_equal(1)
        expect(bm_ring_count()).to_equal(0)

    it "Replay delivers only the logged vector":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_irq(32, 10)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_irq(32, 99)).to_equal(true)
        expect(rr_divergence_count()).to_equal(0)

    it "Replay rejects a different vector and counts a divergence":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_irq(32, 10)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_irq(33, 10)).to_equal(false)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay against a logged timer tick rejects the interrupt":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_timer_tick(100)
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_irq(32, 10)).to_equal(false)
        expect(rr_divergence_count()).to_equal(1)

    it "Replay of an exhausted log rejects the interrupt":
        _reset()
        rtos_replay_set_mode(REPLAY)
        expect(rr_hook_irq(32, 10)).to_equal(false)
        expect(rr_divergence_count()).to_equal(1)

    it "Verify delivers and reports a different vector":
        _reset()
        rtos_replay_set_mode(RECORD)
        rr_hook_irq(32, 10)
        rtos_replay_set_mode(VERIFY)
        expect(rr_hook_irq(33, 10)).to_equal(true)
        expect(rr_divergence_count()).to_equal(1)
