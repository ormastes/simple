"""
## Purpose and audience
Purpose: should render welcome and LSP recommendation decisions
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Markdown, Managed Settings, and MCP Components

Modern SSpec coverage for the medium/small parity batch after LogoV2.
"""

# @req: REQ-TOOLS-MarkManaMcp-001

use std.spec.*
use app.llm_caret.claude_full.components.LogoV2.WelcomeV2.*
use app.llm_caret.claude_full.components.LspRecommendation.LspRecommendationMenu.*
use app.llm_caret.claude_full.components.ManagedSettingsSecurityDialog.utils.*
use app.llm_caret.claude_full.components.ManagedSettingsSecurityDialog.ManagedSettingsSecurityDialog.*
use app.llm_caret.claude_full.components.Markdown.*
use app.llm_caret.claude_full.components.MarkdownTable.*
use app.llm_caret.claude_full.components.mcp.CapabilitiesSection.*
use app.llm_caret.claude_full.components.mcp.index.*

describe "Claude full markdown managed settings and MCP parity":
    it "should render welcome and LSP recommendation decisions":
        step("Verify: should render welcome and LSP recommendation decisions")
        # @req: REQ-TOOLS-MarkManaMcp-001
        step("Render Apple terminal light welcome")
        val welcome = WelcomeV2State.new("light", "Apple_Terminal", "2.0.0", "")
        expect(welcomeV2Palette(welcome)).to_equal("apple-light")
        expect(welcomeV2Summary(welcome)).to_contain("Welcome to Claude Code")

        step("Render LSP recommendation options")
        val lsp = LspRecommendationState.new("simple-lsp", "Simple language", ".spl", "yes")
        expect(lspRecommendationOptions(lsp.plugin_name).len()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(lspRecommendationResponseForSelect("disable")).to_equal("disable")
        expect(lspRecommendationAutoDismissResponse()).to_equal("no")

    it "should detect and format managed settings risk":
        step("Verify: should detect and format managed settings risk")
        # @req: REQ-TOOLS-MarkManaMcp-001
        step("Extract dangerous managed settings")
        val oldSettings = ManagedSettingsInput.new("", ["PATH"], 0)
        val newSettings = ManagedSettingsInput.new("/bin/sh", ["PATH", "LD_PRELOAD"], 1)
        val dangerous = extractDangerousSettings(newSettings)
        expect(hasDangerousSettings(dangerous)).to_equal(true)
        expect(formatDangerousSettingsList(dangerous).len()).to_equal(3)  # oracle: value fixed by the spec contract
        expect(hasDangerousSettingsChanged(oldSettings, newSettings)).to_equal(true)

        step("Render managed settings dialog")
        val dialog = ManagedSettingsSecurityDialogState.new(newSettings, true, "Ctrl-C", "exit")
        expect(managedSettingsDialogChoiceResponse(dialog.selected_value)).to_equal("reject")
        expect(managedSettingsDialogSummary(dialog)).to_contain("items=3")

    it "should render markdown table and MCP summaries":
        step("Verify: should render markdown table and MCP summaries")
        # @req: REQ-TOOLS-MarkManaMcp-001
        step("Render markdown modes")
        val md = MarkdownRenderState.new("<prompt>| A | B |</prompt>", false, false, "dark")
        expect(markdownRenderMode(md)).to_equal("table")
        expect(markdownSummary(md)).to_contain("table")

        step("Render markdown table layout")
        val table = MarkdownTableState.new(["Name", "Value"], [["alpha", "beta"]], 80)
        expect(markdownTableShouldUseVertical(table)).to_equal(false)
        expect(markdownTableSummary(table)).to_contain("grid")

        step("Render MCP capabilities")
        val capabilities = CapabilitiesCounts.new(2, 1, 0)
        expect(capabilitiesSummary(capabilities)).to_contain("tools")
        expect(mcpComponentExports().len()).to_equal(8)  # oracle: value fixed by the spec contract
        expect(mcpTypeExports().len()).to_equal(3)  # oracle: value fixed by the spec contract

    it "should check modeled TypeScript source floors":
        step("Verify: should check modeled TypeScript source floors")
        # @req: REQ-TOOLS-MarkManaMcp-001
        step("Read source line helpers")
        expect(welcomeV2SourceLinesModeled()).to_equal(432)  # oracle: value fixed by the spec contract
        expect(lspRecommendationSourceLinesModeled()).to_equal(87)  # oracle: value fixed by the spec contract
        expect(managedSettingsSecurityDialogSourceLinesModeled()).to_equal(148)  # oracle: value fixed by the spec contract
        expect(managedSettingsUtilsSourceLinesModeled()).to_equal(144)  # oracle: value fixed by the spec contract
        expect(markdownTableSourceLinesModeled()).to_equal(321)  # oracle: value fixed by the spec contract
        expect(markdownSourceLinesModeled()).to_equal(235)  # oracle: value fixed by the spec contract
        expect(capabilitiesSectionSourceLinesModeled()).to_equal(60)  # oracle: value fixed by the spec contract
        expect(mcpIndexSourceLinesModeled()).to_equal(9)  # oracle: value fixed by the spec contract
