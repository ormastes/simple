"""
## Purpose and audience
Purpose: should normalize wizard selections
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Agent Wizard Step Components

Checks modern SSpec parity for the remaining agent wizard step models.
"""

# @req: REQ-TOOLS-AgenWizaStep-001

use std.spec.*
use app.llm_caret.claude_full.components.agents.types.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.LocationStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.MemoryStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.MethodStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.ModelStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.PromptStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.ToolsStep.*
use app.llm_caret.claude_full.components.agents.new_agent_creation.wizard_steps.TypeStep.*

describe "Claude full agent wizard step components":
    it "should normalize wizard selections":
        step("Verify: should normalize wizard selections")
        # @req: REQ-TOOLS-AgenWizaStep-001
        step("Resolve location memory method model and type")
        expect(normalizeAgentLocation("GLOBAL")).to_equal("global")
        expect(normalizeMemoryMode("none")).to_equal("none")
        expect(normalizeAgentMethod("generate")).to_equal("generate")
        expect(normalizeModelStep("opus")).to_equal("opus")
        expect(normalizeAgentKind("reviewer")).to_equal("reviewer")
        expect(typeStepSummary("specialist")).to_contain("specialist")

    it "should validate prompt and tools steps":
        step("Verify: should validate prompt and tools steps")
        # @req: REQ-TOOLS-AgenWizaStep-001
        step("Check prompt details")
        expect(promptStepCanContinue("short")).to_equal(false)
        expect(promptStepCanContinue("review all pull requests")).to_equal(true)
        expect(promptStepHint("review all pull requests")).to_contain("ready")

        step("Check tool selection")
        expect(toolsStepCanContinue([])).to_equal(false)
        expect(toolsStepCanContinue(["read", "edit"])).to_equal(true)
        expect(toolsStepSummary(["read", "edit"])).to_contain("2")

    it "should summarize shared agent type data":
        step("Verify: should summarize shared agent type data")
        # @req: REQ-TOOLS-AgenWizaStep-001
        step("Render a shared type summary")
        val summary = AgentTypeSummary.new("reviewer", "sonnet", "blue")
        expect(agentTypeSummaryLabel(summary)).to_contain("reviewer")
        expect(agentTypeSummaryLabel(summary)).to_contain("sonnet")

    it "should check modeled TypeScript source floors":
        step("Verify: should check modeled TypeScript source floors")
        # @req: REQ-TOOLS-AgenWizaStep-001
        step("Read source line helpers")
        expect(agentTypesSourceLinesModeled()).to_equal(27)  # oracle: value fixed by the spec contract
        expect(locationStepSourceLinesModeled()).to_equal(79)  # oracle: value fixed by the spec contract
        expect(memoryStepSourceLinesModeled()).to_equal(112)  # oracle: value fixed by the spec contract
        expect(methodStepSourceLinesModeled()).to_equal(79)  # oracle: value fixed by the spec contract
        expect(modelStepSourceLinesModeled()).to_equal(51)  # oracle: value fixed by the spec contract
        expect(promptStepSourceLinesModeled()).to_equal(127)  # oracle: value fixed by the spec contract
        expect(toolsStepSourceLinesModeled()).to_equal(60)  # oracle: value fixed by the spec contract
        expect(typeStepSourceLinesModeled()).to_equal(102)  # oracle: value fixed by the spec contract
