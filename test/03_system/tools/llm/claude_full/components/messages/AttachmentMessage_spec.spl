# @req: REQ-TOOLS-ATTACHMENTMESSAGE-001


# codex-system-test
"""
# Claude Full AttachmentMessage Skill Discovery

Exercises the production `AttachmentMessage.spl` dispatcher for ordered skill
discovery metadata, demo feedback suppression, and fail-closed hidden states.

REQ-LLM-CARET-HIDDEN-008

Claim boundary: this is supporting parts-bin render-model evidence. It proves
`AttachmentRender` metadata returned by the production dispatcher, not shipped
CLI/TUI reachability, hosted UI behavior, widgets, or pixels.
"""

use std.spec.*
use app.llm_caret.claude_full.components.messages.AttachmentMessage.{AttachmentModel, AttachmentSkill, AttachmentRender, attachmentMessageRender}

fn setup_attachment_skill_discovery_fixture() -> AttachmentModel:
    val attachment = AttachmentModel.empty("skill_discovery")
    attachment.skills = [
        AttachmentSkill.new("search", "sk-1"),
        AttachmentSkill.new("deploy", ""),
        AttachmentSkill.new("review", "sk-3")
    ]
    attachment

fn check_attachment_skill_discovery_render(render: AttachmentRender, expectedDetail: text) -> text:
    expect(render.visible).to_be(true)
    expect(render.kind).to_equal("skill_discovery")
    expect(render.label).to_equal("3 relevant skills")
    expect(render.detail).to_equal(expectedDetail)
    expect(render.count).to_equal(3)  # oracle: 3 — pinned expected value for this behavior
    expect(render.color).to_equal("")
    expect(render.children.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    "complete"

fn check_hidden_attachment_render(render: AttachmentRender) -> text:
    expect(render.visible).to_be(false)
    expect(render.kind).to_equal("hidden")
    expect(render.label).to_equal("")
    expect(render.detail).to_equal("")
    expect(render.count).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    expect(render.color).to_equal("")
    expect(render.children.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
    "complete"

use std.spec.step

describe "Claude full AttachmentMessage":
    describe "REQ-LLM-CARET-HIDDEN-008: supporting skill-discovery render metadata":
        it "should render ordered plural skill discovery through AttachmentMessage":
            # @req: REQ-TOOLS-ATTACHMENTMESSAGE-001
            step("Verify: should render ordered plural skill discovery through AttachmentMessage")
            step("Load the skill-discovery attachment fixture")
            val attachment = setup_attachment_skill_discovery_fixture()
            step("Render skill discovery through AttachmentMessage")
            val render = attachmentMessageRender(attachment, false, false, false, false, true, false)
            step("Check skill-discovery content and redaction")
            expect(check_attachment_skill_discovery_render(render, "search [sk-1], deploy, review [sk-3] /skill-feedback sk-1")).to_equal("complete")

        it "should suppress first-skill feedback in demo without changing ordered content":
            # @req: REQ-TOOLS-ATTACHMENTMESSAGE-001
            step("Verify: should suppress first-skill feedback in demo without changing ordered content")
            step("Load the skill-discovery attachment fixture")
            val attachment = setup_attachment_skill_discovery_fixture()
            step("Render skill discovery through AttachmentMessage")
            val render = attachmentMessageRender(attachment, true, true, true, true, true, true)
            step("Check skill-discovery content and redaction")
            expect(check_attachment_skill_discovery_render(render, "search [sk-1], deploy, review [sk-3]")).to_equal("complete")

        it "should hide disabled empty and wrong-type skill discovery without leaking content":
            # @req: REQ-TOOLS-ATTACHMENTMESSAGE-001
            step("Verify: should hide disabled empty and wrong-type skill discovery without leaking content")
            step("Load the skill-discovery attachment fixture")
            val disabledAttachment = setup_attachment_skill_discovery_fixture()
            val emptyAttachment = AttachmentModel.empty("skill_discovery")
            val wrongTypeAttachment = AttachmentModel.empty("unsupported_skill_discovery")
            wrongTypeAttachment.skills = [AttachmentSkill.new("private-skill", "secret-short-id")]
            step("Render skill discovery through AttachmentMessage")
            val disabledRender = attachmentMessageRender(disabledAttachment, false, false, false, false, false, false)
            val emptyRender = attachmentMessageRender(emptyAttachment, false, false, false, false, true, false)
            val wrongTypeRender = attachmentMessageRender(wrongTypeAttachment, false, false, false, false, true, false)
            step("Check skill-discovery content and redaction")
            expect(check_hidden_attachment_render(disabledRender)).to_equal("complete")
            expect(check_hidden_attachment_render(emptyRender)).to_equal("complete")
            expect(check_hidden_attachment_render(wrongTypeRender)).to_equal("complete")
