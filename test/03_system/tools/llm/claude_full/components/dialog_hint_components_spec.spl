"""
## Purpose and audience
Purpose: should render progress and permission dialogs
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Dialog and Hint Components

Checks modern SSpec parity for dialog, hint, and compact summary components.
"""

# @req: REQ-TOOLS-DialHintComp-001

use std.spec.*
use app.llm_caret.claude_full.components.BashModeProgress.*
use app.llm_caret.claude_full.components.BypassPermissionsModeDialog.*
use app.llm_caret.claude_full.components.ChannelDowngradeDialog.*
use app.llm_caret.claude_full.components.ClaudeCodeHint.PluginHintMenu.*
use app.llm_caret.claude_full.components.ClaudeInChromeOnboarding.*
use app.llm_caret.claude_full.components.ClaudeMdExternalIncludesDialog.*
use app.llm_caret.claude_full.components.ClickableImageRef.*
use app.llm_caret.claude_full.components.CompactSummary.*
use app.llm_caret.claude_full.components.ConfigurableShortcutHint.*

describe "Claude full dialog and hint components":
    it "should render progress and permission dialogs":
        step("Verify: should render progress and permission dialogs")
        # @req: REQ-TOOLS-DialHintComp-001
        step("Render bash progress")
        expect(bashModeProgressLabel("npm test", true)).to_contain("Running")
        expect(bashModeProgressPercent(2, 4)).to_equal(50)  # oracle: value fixed by the spec contract

        step("Render bypass and channel dialogs")
        val bypass = BypassPermissionsState.new(true, false)
        expect(bypassPermissionsDialogVisible(bypass)).to_equal(true)
        expect(bypassPermissionsDialogMessage(bypass)).to_contain("confirmation")
        expect(channelDowngradeRequiresConfirm("beta", "stable")).to_equal(true)
        expect(channelDowngradeMessage("stable", "stable")).to_contain("No channel")

    it "should render hint onboarding and include dialogs":
        step("Verify: should render hint onboarding and include dialogs")
        # @req: REQ-TOOLS-DialHintComp-001
        step("Render plugin hint")
        expect(pluginHintMenuTitle()).to_contain("Plugin")
        expect(pluginHintMenuItem("search", true)).to_contain("enabled")

        step("Render Chrome and include dialogs")
        val chrome = ChromeOnboardingState.new(true, true)
        expect(chromeOnboardingCanContinue(chrome)).to_equal(true)
        expect(chromeOnboardingStep(chrome)).to_contain("ready")
        expect(externalIncludesRequiresApproval(2)).to_equal(true)
        expect(externalIncludesDialogMessage(0)).to_contain("No external")

    it "should render image summary and shortcut state":
        step("Verify: should render image summary and shortcut state")
        # @req: REQ-TOOLS-DialHintComp-001
        step("Render clickable image")
        expect(clickableImageRefEnabled("image.png")).to_equal(true)
        expect(clickableImageRefLabel("image.png")).to_contain("image.png")

        step("Render compact summary and shortcut")
        expect(compactSummaryNeedsWarning(95, 90)).to_equal(true)
        expect(compactSummaryMessage(10, 90)).to_contain("within")
        expect(shortcutHintVisible("ctrl+x")).to_equal(true)
        expect(shortcutHintLabel("Cut", "ctrl+x")).to_contain("ctrl+x")

    it "should check modeled TypeScript source floors":
        step("Verify: should check modeled TypeScript source floors")
        # @req: REQ-TOOLS-DialHintComp-001
        step("Read source line helpers")
        expect(bashModeProgressSourceLinesModeled()).to_equal(55)  # oracle: value fixed by the spec contract
        expect(bypassPermissionsModeDialogSourceLinesModeled()).to_equal(86)  # oracle: value fixed by the spec contract
        expect(channelDowngradeDialogSourceLinesModeled()).to_equal(101)  # oracle: value fixed by the spec contract
        expect(pluginHintMenuSourceLinesModeled()).to_equal(77)  # oracle: value fixed by the spec contract
        expect(claudeInChromeOnboardingSourceLinesModeled()).to_equal(120)  # oracle: value fixed by the spec contract
        expect(claudeMdExternalIncludesDialogSourceLinesModeled()).to_equal(136)  # oracle: value fixed by the spec contract
        expect(clickableImageRefSourceLinesModeled()).to_equal(72)  # oracle: value fixed by the spec contract
        expect(compactSummarySourceLinesModeled()).to_equal(117)  # oracle: value fixed by the spec contract
        expect(configurableShortcutHintSourceLinesModeled()).to_equal(56)  # oracle: value fixed by the spec contract
