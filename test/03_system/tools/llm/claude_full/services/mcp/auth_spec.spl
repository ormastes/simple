# codex-system-test
"""
## Purpose and audience
Purpose: should revoke one server token through revokeToken
Audience: compiler and tooling engineers who maintain this spec

# Claude Full MCP Auth Mutations

Checks six isolated credential mutation owners through deterministic,
server-scoped state and effect traces.

Requirements: N/A. These scenarios are supporting Claude-full parts-bin
evidence. They do not claim shipped CLI/TUI reachability, keychain access,
browser flow, network access, process execution, or upstream-exact behavior
while the pinned upstream source tree is absent.
"""

# @req: REQ-TOOLS-Auth-001

use std.spec.*
use app.llm_caret.claude_full.services.mcp.auth.*

fn mcp_auth_fixture_config(serverName: text) -> McpServerConfig:
    McpServerConfig.new("http", "https://mcp.example/" + serverName)

fn setup_mcp_auth_fixture() -> McpAuthMutationModel:
    val storage = AuthStorage.new()
    val alphaConfig = mcp_auth_fixture_config("alpha")
    val betaConfig = mcp_auth_fixture_config("beta")
    val alphaKey = getServerKey("alpha", alphaConfig)
    val betaKey = getServerKey("beta", betaConfig)
    storage.setToken(alphaKey, OAuthTokens.new("alpha-access", "alpha-refresh", 1000, "read"))
    storage.setToken(betaKey, OAuthTokens.new("beta-access", "beta-refresh", 2000, "write"))
    storage.saveClientSecret(alphaKey, "alpha-secret")
    storage.saveClientSecret(betaKey, "beta-secret")
    McpAuthMutationModel.new(storage)

fn run_mcp_auth_mutation(model: McpAuthMutationModel, operation: text, serverName: text, clientSecret: text) -> McpAuthMutationTrace:
    model.apply(operation, serverName, mcp_auth_fixture_config(serverName), clientSecret)

fn check_mcp_auth_mutation(trace: McpAuthMutationTrace, expectedOwner: text, expectedSuccess: bool, expectedTokenChanged: bool, expectedClientSecretChanged: bool, expectedEffects: [text], expectedError: text):
    expect(trace.owner).to_equal(expectedOwner)
    expect(trace.success).to_equal(expectedSuccess)
    expect(trace.tokenChanged).to_equal(expectedTokenChanged)
    expect(trace.clientSecretChanged).to_equal(expectedClientSecretChanged)
    expect(trace.effects).to_equal(expectedEffects)
    expect(trace.error).to_equal(expectedError)

describe "Claude full MCP auth credential mutations":
    it "should revoke one server token through revokeToken":
        step("Verify: should revoke one server token through revokeToken")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "revoke-token", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "revokeToken", true, true, false, ["clear-token:" + trace.serverKey], "")
        expect([trace.accessTokenBefore, trace.refreshTokenBefore]).to_equal(["alpha-access", "alpha-refresh"])
        expect([trace.accessTokenAfter, trace.refreshTokenAfter]).to_equal(["", ""])
        val betaToken = model.storage.getToken(getServerKey("beta", mcp_auth_fixture_config("beta")))
        expect([betaToken.accessToken, betaToken.refreshToken]).to_equal(["beta-access", "beta-refresh"])

    it "should revoke one server credential set through revokeServerTokens":
        step("Verify: should revoke one server credential set through revokeServerTokens")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "revoke-server-tokens", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "revokeServerTokens", true, true, false, ["clear-token:" + trace.serverKey], "")
        expect(trace.accessTokenAfter).to_equal("")
        expect(trace.refreshTokenAfter).to_equal("")
        expect(trace.clientSecretAfter).to_equal("alpha-secret")

    it "should clear only local tokens through clearServerTokensFromLocalStorage":
        step("Verify: should clear only local tokens through clearServerTokensFromLocalStorage")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "clear-local-tokens", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "clearServerTokensFromLocalStorage", true, true, false, ["clear-token:" + trace.serverKey], "")
        expect(trace.accessTokenAfter).to_equal("")
        expect(trace.refreshTokenAfter).to_equal("")
        expect(trace.clientSecretAfter).to_equal("alpha-secret")

    it "should save one server secret through saveMcpClientSecret":
        step("Verify: should save one server secret through saveMcpClientSecret")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "save-client-secret", "alpha", "alpha-secret-next")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "saveMcpClientSecret", true, false, true, ["client-secret:" + trace.serverKey], "")
        expect(trace.clientSecretBefore).to_equal("alpha-secret")
        expect(trace.clientSecretAfter).to_equal("alpha-secret-next")
        val betaKey = getServerKey("beta", mcp_auth_fixture_config("beta"))
        expect(model.storage.getClientSecret(betaKey)).to_equal("beta-secret")

    it "should clear one server secret through clearMcpClientConfig":
        step("Verify: should clear one server secret through clearMcpClientConfig")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "clear-client-config", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "clearMcpClientConfig", true, false, true, ["clear-client-config:" + trace.serverKey], "")
        expect(trace.clientSecretBefore).to_equal("alpha-secret")
        expect(trace.clientSecretAfter).to_equal("")
        expect(trace.accessTokenAfter).to_equal("alpha-access")

    it "should invalidate one server token and secret through the provider owner":
        step("Verify: should invalidate one server token and secret through the provider owner")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "invalidate-all", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(
            trace,
            "ClaudeAuthProvider.invalidateCredentials",
            true,
            true,
            true,
            ["clear-token:" + trace.serverKey, "clear-client-config:" + trace.serverKey],
            "",
        )
        expect([trace.accessTokenAfter, trace.refreshTokenAfter, trace.clientSecretAfter]).to_equal(["", "", ""])
        val betaKey = getServerKey("beta", mcp_auth_fixture_config("beta"))
        val betaToken = model.storage.getToken(betaKey)
        expect(model.storage.getClientSecret(betaKey)).to_equal("beta-secret")
        expect(betaToken.accessToken).to_equal("beta-access")

    it "should preserve exact server isolation across sequential mutations":
        step("Verify: should preserve exact server isolation across sequential mutations")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        val betaKey = getServerKey("beta", mcp_auth_fixture_config("beta"))
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "save-client-secret", "alpha", "alpha-only")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "saveMcpClientSecret", true, false, true, ["client-secret:" + trace.serverKey], "")
        val betaToken = model.storage.getToken(betaKey)
        expect(model.storage.getClientSecret(betaKey)).to_equal("beta-secret")
        expect(betaToken.accessToken).to_equal("beta-access")
        expect(model.storage.tokenKeys).to_equal([
            getServerKey("alpha", mcp_auth_fixture_config("alpha")),
            betaKey,
        ])

    it "should make repeated identical credential mutations idempotent":
        step("Verify: should make repeated identical credential mutations idempotent")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val first = run_mcp_auth_mutation(model, "clear-client-config", "alpha", "")
        val repeated = run_mcp_auth_mutation(model, "clear-client-config", "alpha", "")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(first, "clearMcpClientConfig", true, false, true, ["clear-client-config:" + first.serverKey], "")
        check_mcp_auth_mutation(repeated, "clearMcpClientConfig", true, false, false, [], "")
        expect(repeated.clientSecretBefore).to_equal("")
        expect(repeated.clientSecretAfter).to_equal("")

    it "should reject unsupported credential mutations without storage effects":
        step("Verify: should reject unsupported credential mutations without storage effects")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP authentication storage")
        val model = setup_mcp_auth_fixture()
        step("Apply one credential mutation")
        val trace = run_mcp_auth_mutation(model, "unknown-operation", "alpha", "ignored")
        step("Check exact server-scoped storage effects")
        check_mcp_auth_mutation(trace, "", false, false, false, [], "unsupported credential mutation: unknown-operation")
        expect(trace.accessTokenAfter).to_equal("alpha-access")
        expect(trace.refreshTokenAfter).to_equal("alpha-refresh")
        expect(trace.clientSecretAfter).to_equal("alpha-secret")

fn setup_mcp_oauth_fixture() -> ClaudeAuthProvider:
    val storage = AuthStorage.new()
    val config = McpServerConfig.new("http", "https://mcp.example/oauth")
    config.headers = ["x-fixture=isolated"]
    ClaudeAuthProvider.new("oauth-owner", config, "http://127.0.0.1/callback", storage)

fn run_mcp_oauth_flow(provider: ClaudeAuthProvider, authorizationCodeValue: text, stateValue: text) -> text:
    performMCPOAuthFlow(provider, authorizationCodeValue, stateValue)

fn check_mcp_oauth_flow(provider: ClaudeAuthProvider, result: text, expectedResult: text, expectedState: text, expectedAuthorizationUrl: text):
    expect(result).to_equal(expectedResult)
    expect(provider.stateValue).to_equal(expectedState)
    expect(provider.authorizationUrlValue).to_equal(expectedAuthorizationUrl)

describe "Claude full MCP OAuth direct owner boundaries":
    it "should redact every sensitive URL parameter including repeats and the final value":
        step("Verify: should redact every sensitive URL parameter including repeats and the final value")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val redacted = redactSensitiveUrlParams(
            "https://auth.example/callback?upstate=public&state=first&nonce=n-1&state=second&code_challenge=challenge&code=final",
        )
        step("Check exact response and provider state")
        expect(redacted).to_equal(
            "https://auth.example/callback?upstate=public&state=[REDACTED]&nonce=[REDACTED]&state=[REDACTED]&code_challenge=[REDACTED]&code=[REDACTED]",
        )
        expect(provider.logs).to_equal([])

    it "should normalize successful OAuth error bodies and pass other responses through":
        step("Verify: should normalize successful OAuth error bodies and pass other responses through")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val refreshError = createAuthFetch(AuthResponse.new(200, "{\"error\":\"expired_refresh_token\"}"))
        val oauthError = normalizeOAuthErrorBody(AuthResponse.new(201, "{\"error\":\"invalid_client\"}"))
        val nonSuccess = createAuthFetch(AuthResponse.new(401, "{\"error\":\"invalid_token\"}"))
        val success = normalizeOAuthErrorBody(AuthResponse.new(204, ""))
        step("Check exact response and provider state")
        expect([refreshError.status, oauthError.status, nonSuccess.status, success.status]).to_equal([400, 400, 401, 204])
        expect(refreshError.body).to_equal("{\"error\":\"invalid_grant\"}")
        expect(oauthError.body).to_equal("{\"error\":\"invalid_client\"}")
        expect(nonSuccess.body).to_equal("{\"error\":\"invalid_token\"}")
        expect(success.body).to_equal("")
        expect(provider.logs).to_equal([])

    it "should return deterministic cancellation cleanup and metadata fallback values":
        step("Verify: should return deterministic cancellation cleanup and metadata fallback values")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val cancelled = abort()
        val cleaned = cleanup(["listener-open"])
        val discovered = fetchAuthServerMetadata("oauth-owner", "https://mcp.example/oauth", true)
        val legacy = fetchAuthServerMetadata("oauth-owner", "https://mcp.example/oauth", false)
        val rootFallback = fetchAuthServerMetadata("oauth-owner", "https://mcp.example/", false)
        step("Check exact response and provider state")
        expect([cancelled.name, cancelled.message]).to_equal([
            "AuthenticationCancelledError",
            "Authentication was cancelled",
        ])
        expect(cleaned).to_equal(["listener-open", "cleanup"])
        expect([discovered, legacy, rootFallback]).to_equal([
            "metadata:https://mcp.example/oauth",
            "legacy-metadata:/oauth",
            "",
        ])
        expect(provider.logs).to_equal([])

    it "should derive a stable server key and distinguish discovery from token state":
        step("Verify: should derive a stable server key and distinguish discovery from token state")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val key = getServerKey(provider.serverName, provider.serverConfig)
        provider.storage.discoveryKeys.push(key)
        step("Evaluate one OAuth owner boundary")
        val discoveredWithoutToken = hasMcpDiscoveryButNoToken(
            provider.storage,
            provider.serverName,
            provider.serverConfig,
            false,
        )
        provider.storage.setToken(key, OAuthTokens.new("access", "", 1000, "read"))
        val discoveredWithToken = hasMcpDiscoveryButNoToken(
            provider.storage,
            provider.serverName,
            provider.serverConfig,
            false,
        )
        provider.serverConfig.oauthXaa = true
        val xaaBypass = hasMcpDiscoveryButNoToken(
            provider.storage,
            provider.serverName,
            provider.serverConfig,
            true,
        )
        step("Check exact response and provider state")
        expect(key).to_equal(
            "oauth-owner|http|https://mcp.example/oauth|x-fixture=isolated",
        )
        expect([discoveredWithoutToken, discoveredWithToken, xaaBypass]).to_equal([true, false, false])

    it "should expose provider metadata URLs and persisted client information":
        step("Verify: should expose provider metadata URLs and persisted client information")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val metadata = OAuthMetadata.new()
        metadata.scopesSupported = ["read", "write"]
        provider.setMetadata(metadata)
        step("Evaluate one OAuth owner boundary")
        val clientMetadataValue = provider.clientMetadata()
        val defaultMetadataUrl = provider.clientMetadataUrl("")
        val overrideMetadataUrl = provider.clientMetadataUrl("https://tenant.example/client.json")
        provider.saveClientInformation(OAuthClientInfo.new("stored-client", "stored-secret"))
        val stored = provider.clientInformation()
        step("Check exact response and provider state")
        expect(clientMetadataValue).to_equal(
            "Claude Code (oauth-owner)|http://127.0.0.1/callback|authorization_code,refresh_token|code|none|scope=read write",
        )
        expect([defaultMetadataUrl, overrideMetadataUrl]).to_equal([
            "https://claude.ai/api/mcp/client_metadata",
            "https://tenant.example/client.json",
        ])
        expect([stored.clientId, stored.clientSecret]).to_equal(["stored-client", "stored-secret"])
        expect(provider.storage.updates).to_equal([
            "client-info:" + getServerKey(provider.serverName, provider.serverConfig),
        ])
        expect(provider.logs).to_equal([
            "Using scope from metadata: read write",
            "Using CIMD URL from env: https://tenant.example/client.json",
        ])

    it "should fall back to configured client identity and apply token expiry and step-up rules":
        step("Verify: should fall back to configured client identity and apply token expiry and step-up rules")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val key = getServerKey(provider.serverName, provider.serverConfig)
        provider.serverConfig.oauthClientId = "configured-client"
        provider.storage.saveClientSecret(key, "configured-secret")
        provider.nowMs = 1000
        provider.storage.setToken(key, OAuthTokens.new("access", "refresh", 11000, "read"))
        step("Evaluate one OAuth owner boundary")
        val configured = provider.clientInformation()
        val current = provider.tokens()
        provider.markStepUpPending("write")
        val steppedUp = provider.tokens()
        provider.storage.setToken(key, OAuthTokens.new("expired", "", 500, "read"))
        val expired = provider.tokens()
        step("Check exact response and provider state")
        expect([configured.clientId, configured.clientSecret]).to_equal([
            "configured-client",
            "configured-secret",
        ])
        expect([current.accessToken, current.refreshToken, current.scope]).to_equal([
            "access",
            "refresh",
            "read",
        ])
        expect([steppedUp.accessToken, steppedUp.refreshToken, steppedUp.scope]).to_equal([
            "access",
            "",
            "read",
        ])
        expect([expired.accessToken, expired.refreshToken, expired.scope]).to_equal([
            "",
            "",
            "",
        ])
        expect(expired.expiresAt).to_equal(0)  # oracle: value fixed by the spec contract
        expect(provider.logs).to_equal([
            "Marked step-up pending: write",
            "Step-up pending (write), omitting refresh_token",
            "Token expired without refresh token",
        ])

    it "should exchange a cached XAA identity token into stored MCP access state":
        step("Verify: should exchange a cached XAA identity token into stored MCP access state")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        provider.serverConfig.oauthXaa = true
        provider.nowMs = 500
        step("Evaluate one OAuth owner boundary")
        val missingIdentity = performMCPXaaAuth(provider, false)
        val exchanged = performMCPXaaAuth(provider, true)
        val stored = provider.storage.getToken(getServerKey(provider.serverName, provider.serverConfig))
        step("Check exact response and provider state")
        expect([missingIdentity.accessToken, missingIdentity.refreshToken]).to_equal(["", ""])
        expect([exchanged.accessToken, exchanged.refreshToken, exchanged.scope]).to_equal([
            "xaa-access",
            "",
            "openid",
        ])
        expect(exchanged.expiresAt).to_equal(3600500)  # oracle: value fixed by the spec contract
        expect([stored.accessToken, stored.scope]).to_equal([
            "xaa-access",
            "openid",
        ])
        expect(stored.expiresAt).to_equal(3600500)  # oracle: value fixed by the spec contract

    it "should cancel an OAuth flow before generating state":
        step("Verify: should cancel an OAuth flow before generating state")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val result = run_mcp_oauth_flow(provider, "", "ignored")
        step("Check exact response and provider state")
        check_mcp_oauth_flow(provider, result, "AuthenticationCancelledError", "", "")

    it "should reject an OAuth flow with a mismatched state":
        step("Verify: should reject an OAuth flow with a mismatched state")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val result = run_mcp_oauth_flow(provider, "authorization-code", "wrong-state")
        step("Check exact response and provider state")
        check_mcp_oauth_flow(provider, result, "state_mismatch", "generated-state", "")

    it "should mutate authorization state after a successful OAuth flow":
        step("Verify: should mutate authorization state after a successful OAuth flow")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val result = run_mcp_oauth_flow(provider, "authorization-code", "generated-state")
        step("Check exact response and provider state")
        check_mcp_oauth_flow(provider, result, "token_exchange", "generated-state", "authorized")

    it "should source client secrets and edit prompt data without external input":
        step("Verify: should source client secrets and edit prompt data without external input")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        step("Evaluate one OAuth owner boundary")
        val fromEnvironment = readClientSecret("env-secret", false, "ignored")
        val withoutTty = readClientSecret("", false, "ignored")
        val typed = readClientSecret("", true, "typed-secret")
        val appended = onData("ab", "c")
        val deleted = onData("abc", "\u007F")
        val emptyDelete = onData("", "\b")
        step("Check exact response and provider state")
        expect([fromEnvironment, typed, appended, deleted, emptyDelete]).to_equal([
            "env-secret",
            "typed-secret",
            "abc",
            "ab",
            "",
        ])
        expect(withoutTty).to_equal(
            "No TTY available to prompt for client secret. Set MCP_CLIENT_SECRET env var instead.",
        )
        expect(provider.logs).to_equal([])

    it "should resolve OAuth scope metadata in explicit default and supported order":
        step("Verify: should resolve OAuth scope metadata in explicit default and supported order")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val explicitMetadata = OAuthMetadata.new()
        explicitMetadata.scope = "explicit"
        explicitMetadata.defaultScope = "default"
        explicitMetadata.scopesSupported = ["read", "write"]
        val fallback = OAuthMetadata.new()
        fallback.defaultScope = "default"
        fallback.scopesSupported = ["read", "write"]
        val supported = OAuthMetadata.new()
        supported.scopesSupported = ["read", "write"]
        step("Evaluate one OAuth owner boundary")
        val explicitScope = getScopeFromMetadata(explicitMetadata)
        val defaultScope = getScopeFromMetadata(fallback)
        val supportedScope = getScopeFromMetadata(supported)
        val emptyScope = getScopeFromMetadata(OAuthMetadata.new())
        step("Check exact response and provider state")
        expect([explicitScope, defaultScope, supportedScope, emptyScope]).to_equal([
            "explicit",
            "default",
            "read write",
            "",
        ])
        expect(provider.logs).to_equal([])

    it "should mark step-up state for a 403 insufficient-scope response with scope":
        step("Verify: should mark step-up state for a 403 insufficient-scope response with scope")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val response = AuthResponse.new(403, "forbidden")
        response.wwwAuthenticate = "Bearer error=\"insufficient_scope\", scope=\"read write\""
        step("Evaluate one OAuth owner boundary")
        val returned = wrapFetchWithStepUpDetection(response, provider)
        step("Check exact response and provider state")
        expect(returned).to_be(response)
        expect(provider.pendingStepUpScope).to_equal("read write")
        expect(provider.logs).to_equal(["Marked step-up pending: read write"])

    it "should preserve provider state for a 403 insufficient-scope response without scope":
        step("Verify: should preserve provider state for a 403 insufficient-scope response without scope")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val response = AuthResponse.new(403, "forbidden")
        response.wwwAuthenticate = "Bearer error=\"insufficient_scope\""
        step("Evaluate one OAuth owner boundary")
        val returned = wrapFetchWithStepUpDetection(response, provider)
        step("Check exact response and provider state")
        expect(returned).to_be(response)
        expect(provider.pendingStepUpScope).to_equal("")
        expect(provider.logs).to_equal([])

    it "should preserve provider state for a non-403 response with scope metadata":
        step("Verify: should preserve provider state for a non-403 response with scope metadata")
        # @req: REQ-TOOLS-Auth-001
        step("Set up isolated MCP OAuth state")
        val provider = setup_mcp_oauth_fixture()
        val response = AuthResponse.new(401, "unauthorized")
        response.wwwAuthenticate = "Bearer error=\"insufficient_scope\", scope=\"read\""
        step("Evaluate one OAuth owner boundary")
        val returned = wrapFetchWithStepUpDetection(response, provider)
        step("Check exact response and provider state")
        expect(returned).to_be(response)
        expect(provider.pendingStepUpScope).to_equal("")
        expect(provider.logs).to_equal([])
