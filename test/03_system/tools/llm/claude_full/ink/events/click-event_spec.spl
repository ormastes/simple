"""
## Purpose and audience
Purpose: should preserve screen coordinates and blank-cell state
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Click Event

Mirrors the Ink mouse click event payload and immediate propagation flag.
"""

# @req: REQ-TOOLS-ClicEven-001

use std.spec.*
use app.llm_caret.claude_full.ink.events.click_event.clickEventNew

describe "Claude full click event":
    it "should preserve screen coordinates and blank-cell state":
        step("Verify: should preserve screen coordinates and blank-cell state")
        # @req: REQ-TOOLS-ClicEven-001
        step("Create a click event at absolute screen coordinates")
        val event = clickEventNew(12, 7, true)
        expect(event.col).to_equal(12)  # oracle: value fixed by the spec contract
        expect(event.row).to_equal(7)  # oracle: value fixed by the spec contract
        expect(event.localCol).to_equal(0)  # oracle: value fixed by the spec contract
        expect(event.localRow).to_equal(0)  # oracle: value fixed by the spec contract
        expect(event.isBlankCellClick()).to_equal(true)
        expect(event.positionText()).to_equal("12,7")

    it "should recompute local coordinates for each handler box":
        step("Verify: should recompute local coordinates for each handler box")
        # @req: REQ-TOOLS-ClicEven-001
        step("Compute coordinates relative to a parent box")
        val event = clickEventNew(12, 7, false)
        event.setLocalFromBox(10, 3)
        expect(event.localCol).to_equal(2)  # oracle: value fixed by the spec contract
        expect(event.localRow).to_equal(4)  # oracle: value fixed by the spec contract
        expect(event.isBlankCellClick()).to_equal(false)

    it "should stop immediate propagation like the base event":
        step("Verify: should stop immediate propagation like the base event")
        # @req: REQ-TOOLS-ClicEven-001
        step("Stop bubbling to ancestor click handlers")
        val event = clickEventNew(1, 2, false)
        expect(event.didStopImmediatePropagation()).to_equal(false)
        event.stopImmediatePropagation()
        expect(event.didStopImmediatePropagation()).to_equal(true)
