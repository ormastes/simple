    _expect_feature_gate_probe(bridge_version, "current", false, true, "")
    _expect_feature_gate_probe(bridge_version, "empty-min", false, true, "")
    _expect_feature_gate_probe(bridge_version, "zero-min", false, true, "")
    _expect_feature_gate_probe(bridge_version, "mode-off", false, true, "")
    val bridge_auto = _expect_feature_gate_record(records, "bridge-auto-connect", "enabled", false, false, false, 4)
    _expect_feature_gate_probe(bridge_auto, "both-off", false, false, "")
    _expect_feature_gate_probe(bridge_auto, "gate-only", false, false, "")
    _expect_feature_gate_probe(bridge_auto, "build-only", false, false, "")
    _expect_feature_gate_probe(bridge_auto, "enabled", false, true, "")

    val bridge_mirror = _expect_feature_gate_record(records, "bridge-ccr-mirror", "enabled", true, false, false, 4)
    _expect_feature_gate_probe(bridge_mirror, "default", false, false, "")
    _expect_feature_gate_probe(bridge_mirror, "build-off", false, false, "")
    _expect_feature_gate_probe(bridge_mirror, "env-enabled", false, true, "")
    _expect_feature_gate_probe(bridge_mirror, "gate-enabled", false, true, "")
    val bridge_command = _expect_feature_gate_record(records, "bridge-command-admission", "hidden+enabled", true, false, true, 5)
    _expect_feature_gate_probe(bridge_command, "default", false, true, "")
    _expect_feature_gate_probe(bridge_command, "disabled", true, false, "")
    _expect_feature_gate_probe(bridge_command, "mode-off", true, false, "")
    _expect_feature_gate_probe(bridge_command, "gate-off", true, false, "")
    _expect_feature_gate_probe(bridge_command, "enabled", false, true, "")
    "complete"

