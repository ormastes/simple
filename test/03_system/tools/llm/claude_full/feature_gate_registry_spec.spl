# @req: REQ-TOOLS-FEATURE-GATE-001


# codex-system-test
"""
# Claude Full Feature-Gate Registry

REQ-LLM-CARET-HIDDEN-008

Validates a bounded cross-map from Claude-full feature-gate owners to focused
or aggregate system-test evidence. It preserves the known distinction between
root command metadata and leaf conditional behavior.

This is parts-bin evidence. It does not prove shipped Caret admission, future
unimported gate discovery, or complete current-upstream Claude parity.
"""

use std.spec.*
use std.nogc_sync_mut.sffi.io.{file_read_text}
use app.llm_caret.claude_full.commands.{findRootCommand}
use app.llm_caret.claude_full.feature_gate_registry.{ClaudeFeatureGateProbe, ClaudeFeatureGateRecord, claudeFeatureGateRegistry}
use app.llm_caret.claude_full.components.messages.AttachmentMessage.{AttachmentModel, AttachmentSkill, attachmentMessageRenderSkillDiscovery}
use app.llm_caret.claude_full.services.api.withRetry.{isPersistentRetryEnabled}

val FEATURE_GATE_REGISTRY_SOURCE = "src/app/llm_caret/claude_full/feature_gate_registry.spl"
val FEATURE_GATE_SOURCE_PREFIX = "src/app/llm_caret/claude_full/"

class ClaudeFeatureGateSource:
    source_file: text
    gate_owner: text

fn _feature_gate_contains_text(values: [text], wanted: text) -> bool:
    for value in values:
        if value == wanted:
            return true
    false

fn _feature_gate_source_key(source_file: text, gate_owner: text) -> text:
    source_file + "|" + gate_owner

fn discover_feature_gate_sources() -> [ClaudeFeatureGateSource]:
    var discovered: [ClaudeFeatureGateSource] = []
    val registry_source = file_read_text(FEATURE_GATE_REGISTRY_SOURCE)

    for raw_line in registry_source.split("\n"):
        val line = raw_line.trim()
        if line.starts_with("use app.llm_caret.claude_full.") and line.contains(".{") and line.ends_with("}"):
            val import_parts = line.split(".{")
            if import_parts.len() == 2:
                val module_import = import_parts[0].substring(4, import_parts[0].len())
                val source_file = "src/" + module_import.replace(".", "/") + ".spl"
                val source = file_read_text(source_file)
                val imported_symbols = import_parts[1].substring(0, import_parts[1].len() - 1)
                for raw_symbol in imported_symbols.split(","):
                    val symbol = raw_symbol.trim()
                    if source.contains("fn " + symbol + "("):
                        discovered.push(ClaudeFeatureGateSource(
                            source_file: source_file,
                            gate_owner: symbol
                        ))
    discovered

fn check_feature_gate_source_completeness(
    records: [ClaudeFeatureGateRecord],
    discovered: [ClaudeFeatureGateSource]
) -> [text]:
    var diagnostics: [text] = []
    var discovered_keys: [text] = []
    var registered_keys: [text] = []

    for source in discovered:
        val key = _feature_gate_source_key(source.source_file, source.gate_owner)
        if _feature_gate_contains_text(discovered_keys, key):
            diagnostics.push("duplicate-discovered-source-owner:" + key)
        else:
            discovered_keys.push(key)

    for record in records:
        for owner in record.gate_owner.split("/"):
            val key = _feature_gate_source_key(record.source_file, owner)
            if not _feature_gate_contains_text(registered_keys, key):
                registered_keys.push(key)

    for source_key in discovered_keys:
        if not _feature_gate_contains_text(registered_keys, source_key):
            diagnostics.push("unregistered-source-owner:" + source_key)

    for registered_key in registered_keys:
        if not _feature_gate_contains_text(discovered_keys, registered_key):
            diagnostics.push("registry-owner-not-discovered:" + registered_key)

    diagnostics

fn _feature_gate_drifted_source_fixture() -> [ClaudeFeatureGateSource]:
    val discovered = discover_feature_gate_sources()
    var drifted: [ClaudeFeatureGateSource] = []

    for source in discovered:
        if source.gate_owner != "isCcrMirrorEnabled":
            drifted.push(source)
    drifted.push(ClaudeFeatureGateSource(
        source_file: FEATURE_GATE_SOURCE_PREFIX + "future/newGate.spl",
        gate_owner: "newGateEnabled"
    ))
    if discovered.len() > 0:
        drifted.push(discovered[0])
    drifted

fn _feature_gate_ids(records: [ClaudeFeatureGateRecord]) -> [text]:
    var ids: [text] = []
    for record in records:
        ids.push(record.source_id)
    ids

fn _feature_gate_bool_text(value: bool) -> text:
    if value:
        return "true"
    "false"

fn _feature_gate_contract_signature(record: ClaudeFeatureGateRecord) -> text:
    record.source_id + "|" +
        record.source_file + "|" +
        record.owner_spec + "|" +
        record.surface + "|" +
        record.state_shape + "|" +
        record.gate_owner + "|" +
        record.root_command + "|" +
        _feature_gate_bool_text(record.root_hidden) + "|" +
        _feature_gate_bool_text(record.root_enabled) + "|" +
        _feature_gate_bool_text(record.default_known) + "|" +
        _feature_gate_bool_text(record.hidden_by_default) + "|" +
        _feature_gate_bool_text(record.enabled_by_default) + "|" +
        record.gate_kind

fn _feature_gate_contract_signatures(records: [ClaudeFeatureGateRecord]) -> [text]:
    var signatures: [text] = []
    for record in records:
        signatures.push(_feature_gate_contract_signature(record))
    signatures

fn _feature_gate_record(records: [ClaudeFeatureGateRecord], source_id: text) -> ClaudeFeatureGateRecord:
    if records.len() == 0:
        fail("feature-gate registry is empty while looking up " + source_id)
    for record in records:
        if record.source_id == source_id:
            return record
    fail("feature-gate record not found: " + source_id)
    records[0]

fn _feature_gate_probe(record: ClaudeFeatureGateRecord, case_id: text) -> ClaudeFeatureGateProbe:
    if record.probes.len() == 0:
        fail("feature-gate record has no probes: " + record.source_id)
    for probe in record.probes:
        if probe.case_id == case_id:
            return probe
    fail("feature-gate probe not found: " + record.source_id + ":" + case_id)
    record.probes[0]

fn _feature_gate_has_probe(record: ClaudeFeatureGateRecord, case_id: text) -> bool:
    for probe in record.probes:
        if probe.case_id == case_id:
            return true
    false

fn _feature_gate_hidden_relevant(state_shape: text) -> bool:
    state_shape == "hidden" or state_shape == "hidden+enabled"

fn _feature_gate_enabled_relevant(state_shape: text) -> bool:
    state_shape == "enabled" or state_shape == "hidden+enabled" or state_shape == "outcome"

fn _feature_gate_valid_state_shape(state_shape: text) -> bool:
    state_shape == "hidden" or state_shape == "enabled" or state_shape == "hidden+enabled" or state_shape == "outcome" or state_shape == "metadata"

fn _feature_gate_valid_kind(gate_kind: text) -> bool:
    gate_kind == "static" or gate_kind == "conditional" or gate_kind == "environment" or gate_kind == "context" or gate_kind == "metadata-only"

fn _feature_gate_has_distinct_behavior(record: ClaudeFeatureGateRecord) -> bool:
    if record.probes.len() < 2:
        return false
    val first = record.probes[0]
    var i = 1
    while i < record.probes.len():
        val probe = record.probes[i]
        val hidden_differs = _feature_gate_hidden_relevant(record.state_shape) and probe.hidden != first.hidden
        val enabled_differs = _feature_gate_enabled_relevant(record.state_shape) and probe.enabled != first.enabled
        if hidden_differs or enabled_differs or probe.outcome != first.outcome:
            return true
        i = i + 1
    false

fn setup_claude_feature_gate_fixture() -> [ClaudeFeatureGateRecord]:
    val records = claudeFeatureGateRegistry()
    expect(records.len()).to_be_greater_than(0)
    records

fn check_claude_feature_gate_registry(records: [ClaudeFeatureGateRecord]) -> [text]:
    var diagnostics: [text] = []
    var source_ids: [text] = []
    var root_commands: [text] = []
    var compact_valid = false

    for record in records:
        if _feature_gate_contains_text(source_ids, record.source_id):
            diagnostics.push("duplicate-source-id:" + record.source_id)
        else:
            source_ids.push(record.source_id)

        if record.root_command != "":
            if _feature_gate_contains_text(root_commands, record.root_command):
                diagnostics.push("duplicate-root-command:" + record.root_command)
            else:
                root_commands.push(record.root_command)
        elif record.root_hidden or record.root_enabled:
            diagnostics.push("root-metadata-without-command:" + record.source_id)

        if record.gate_owner == "":
            diagnostics.push("ownerless-record:" + record.source_id)

        if record.source_id == "" or record.source_file == "" or record.owner_spec == "" or record.surface == "" or record.state_shape == "" or record.gate_kind == "" or record.probes.len() == 0:
            diagnostics.push("incomplete-record:" + record.source_id)

        if not _feature_gate_valid_kind(record.gate_kind):
            diagnostics.push("invalid-gate-kind:" + record.source_id)
        if not _feature_gate_valid_state_shape(record.state_shape):
            diagnostics.push("invalid-state-shape:" + record.source_id)

        var probe_ids: [text] = []
        for probe in record.probes:
            if probe.case_id == "":
                diagnostics.push("empty-probe-id:" + record.source_id)
            elif _feature_gate_contains_text(probe_ids, probe.case_id):
                diagnostics.push("duplicate-probe-id:" + record.source_id + ":" + probe.case_id)
            else:
                probe_ids.push(probe.case_id)
            if probe.condition == "":
                diagnostics.push("empty-probe-condition:" + record.source_id + ":" + probe.case_id)

        if record.default_known:
            if not _feature_gate_has_probe(record, "default"):
                diagnostics.push("default-probe-mismatch:" + record.source_id)
            else:
                val default_probe = _feature_gate_probe(record, "default")
                val hidden_mismatch = _feature_gate_hidden_relevant(record.state_shape) and default_probe.hidden != record.hidden_by_default
                val enabled_mismatch = _feature_gate_enabled_relevant(record.state_shape) and default_probe.enabled != record.enabled_by_default
                if hidden_mismatch or enabled_mismatch:
                    diagnostics.push("default-probe-mismatch:" + record.source_id)
        elif _feature_gate_has_probe(record, "default"):
            diagnostics.push("unknown-default-labeled:" + record.source_id)

        val conditional = record.gate_kind == "conditional" or record.gate_kind == "environment" or record.gate_kind == "context"
        if conditional and not _feature_gate_has_distinct_behavior(record):
            diagnostics.push("conditional-probes-incomplete:" + record.source_id)

        if record.source_id == "compact":
            val has_default = _feature_gate_has_probe(record, "default")
            val has_disabled = _feature_gate_has_probe(record, "disabled-by-env")
            if record.root_command == "/compact" and record.root_enabled and not record.root_hidden and has_default and has_disabled:
                val default_probe = _feature_gate_probe(record, "default")
                val disabled_probe = _feature_gate_probe(record, "disabled-by-env")
                compact_valid = default_probe.enabled and not disabled_probe.enabled

    if not compact_valid:
        diagnostics.push("compact-drift-missing")
    diagnostics

fn _expect_feature_gate_record(
    records: [ClaudeFeatureGateRecord],
    source_id: text,
    state_shape: text,
    default_known: bool,
    hidden_by_default: bool,
    enabled_by_default: bool,
    probe_count: i64
) -> ClaudeFeatureGateRecord:
    val record = _feature_gate_record(records, source_id)
    expect(record.state_shape).to_equal(state_shape)
    expect(record.default_known).to_be(default_known)
    expect(record.hidden_by_default).to_be(hidden_by_default)
    expect(record.enabled_by_default).to_be(enabled_by_default)
    expect(record.probes.len()).to_equal(probe_count)
    record

fn _expect_feature_gate_probe(record: ClaudeFeatureGateRecord, case_id: text, hidden: bool, enabled: bool, outcome: text) -> nil:
    val probe = _feature_gate_probe(record, case_id)
    expect(probe.hidden).to_be(hidden)
    expect(probe.enabled).to_be(enabled)
    expect(probe.outcome).to_equal(outcome)

