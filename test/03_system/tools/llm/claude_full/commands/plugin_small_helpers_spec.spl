"""
## Purpose and audience
Purpose: should parse plugin args and expose command names
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Plugin Small Helpers

Checks modern SSpec parity for small plugin helpers.
"""

# @req: REQ-TOOLS-PlugSmalHelp-001

use std.spec.*
use app.llm_caret.claude_full.commands.plugin.index.*
use app.llm_caret.claude_full.commands.plugin.plugin.*
use app.llm_caret.claude_full.commands.plugin.parseArgs.*
use app.llm_caret.claude_full.commands.plugin.pluginDetailsHelpers.*
use app.llm_caret.claude_full.commands.plugin.PluginErrors.*
use app.llm_caret.claude_full.commands.plugin.PluginOptionsFlow.*
use app.llm_caret.claude_full.commands.plugin.PluginTrustWarning.*
use app.llm_caret.claude_full.commands.plugin.ValidatePlugin.*

describe "Claude full plugin small helpers":
    it "should parse plugin args and expose command names":
        step("Verify: should parse plugin args and expose command names")
        # @req: REQ-TOOLS-PlugSmalHelp-001
        expect(pluginIndexCommandName()).to_equal("plugin")
        expect(pluginCommandName()).to_equal("plugin")
        val args = parsePluginArgs("install foo --trust")
        expect(args.action).to_equal("install")
        expect(args.target).to_equal("foo")
        expect(pluginArgsHasFlag(args, "--trust")).to_equal(true)

    it "should format details errors options and validation":
        step("Verify: should format details errors options and validation")
        # @req: REQ-TOOLS-PlugSmalHelp-001
        val details = PluginDetails.new("p", "1.0.0", "desc", true)
        expect(pluginDetailsSummary(details)).to_contain("trusted")
        expect(pluginErrorView("network", "down").recoverable).to_equal(true)
        expect(choosePluginOption(startPluginOptionsFlow(), "enabled").step).to_equal("confirm")
        expect(pluginTrustWarningMessage("p")).to_contain("Trust")
        expect(validatePluginName("bad name")).to_equal("invalid-name")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-PlugSmalHelp-001
        expect(pluginIndexSourceLinesModeled()).to_equal(10)  # oracle: value fixed by the spec contract
        expect(parseArgsSourceLinesModeled()).to_equal(103)  # oracle: value fixed by the spec contract
        expect(pluginDetailsHelpersSourceLinesModeled()).to_equal(116)  # oracle: value fixed by the spec contract
        expect(pluginErrorsSourceLinesModeled()).to_equal(123)  # oracle: value fixed by the spec contract
        expect(pluginOptionsFlowSourceLinesModeled()).to_equal(134)  # oracle: value fixed by the spec contract
        expect(pluginTrustWarningSourceLinesModeled()).to_equal(31)  # oracle: value fixed by the spec contract
        expect(validatePluginSourceLinesModeled()).to_equal(97)  # oracle: value fixed by the spec contract
