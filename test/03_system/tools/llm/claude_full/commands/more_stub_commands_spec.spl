# @req: REQ-TOOLS-MORE-STUB-001


"""
# Claude Full More Stub Commands

Mirrors another batch of one-line Claude command index files that export hidden
disabled stub commands.
"""

use std.spec.*
use app.llm_caret.claude_full.commands.break_cache.index.breakCacheCommand
use app.llm_caret.claude_full.commands.ctx_viz.index.ctxVizCommand
use app.llm_caret.claude_full.commands.good_claude.index.goodClaudeCommand
use app.llm_caret.claude_full.commands.mock_limits.index.mockLimitsCommand
use app.llm_caret.claude_full.commands.oauth_refresh.index.oauthRefreshCommand
use app.llm_caret.claude_full.commands.perf_issue.index.perfIssueCommand

fn assert_stub(name: text, hidden: bool, enabled: bool):
    expect(name).to_equal("stub")
    expect(hidden).to_equal(true)
    expect(enabled).to_equal(false)

use std.spec.step

describe "Claude full additional stub command indexes":
    it "should expose hidden disabled cache, context, and good-claude commands":
        # @req: REQ-TOOLS-MORE-STUB-001
        step("Verify: should expose hidden disabled cache, context, and good-claude commands")
        step("Load the first additional stub command batch")
        val break_cache = breakCacheCommand()
        val ctx = ctxVizCommand()
        val good = goodClaudeCommand()

        assert_stub(break_cache.name, break_cache.isHidden, break_cache.isEnabled())
        assert_stub(ctx.name, ctx.isHidden, ctx.isEnabled())
        assert_stub(good.name, good.isHidden, good.isEnabled())

    it "should expose hidden disabled limit, oauth, and perf commands":
        # @req: REQ-TOOLS-MORE-STUB-001
        step("Verify: should expose hidden disabled limit, oauth, and perf commands")
        step("Load the second additional stub command batch")
        val mock_limits = mockLimitsCommand()
        val oauth = oauthRefreshCommand()
        val perf = perfIssueCommand()

        assert_stub(mock_limits.name, mock_limits.isHidden, mock_limits.isEnabled())
        assert_stub(oauth.name, oauth.isHidden, oauth.isEnabled())
        assert_stub(perf.name, perf.isHidden, perf.isEnabled())
