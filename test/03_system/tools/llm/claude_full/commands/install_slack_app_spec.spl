# @req: REQ-APP-CLAFULL-004
"""
# Claude Full Install Slack App Command

Checks modern SSpec parity for install-slack-app descriptors.
"""

use std.spec.*
use app.llm_caret.claude_full.commands.install_slack_app.install_slack_app.*
use app.llm_caret.claude_full.commands.install_slack_app.index.*

describe "Claude full install slack app command":
    it "should expose install slack command metadata":
        # @req: REQ-APP-CLAFULL-004
        step("Verify: should expose install slack command metadata")
        expect(installSlackAppCommandName()).to_equal("install-slack-app")
        expect(installSlackAppCommand().description).to_contain("Slack")
        expect(installSlackAppCommand().url).to_contain("slack.com")

    it "should format workspace messages":
        # @req: REQ-APP-CLAFULL-004
        step("Verify: should format workspace messages")
        expect(installSlackAppMessage("")).to_contain("installation")
        expect(installSlackAppMessage("eng")).to_contain("eng")

    it "should expose source sizes":
        # @req: REQ-APP-CLAFULL-004
        step("Verify: should expose source sizes")
        expect(installSlackAppSourceLinesModeled()).to_equal(30) # oracle: pinned expected value documenting the asserted outcome
        expect(installSlackAppIndexSourceLinesModeled()).to_equal(12) # oracle: pinned expected value documenting the asserted outcome
