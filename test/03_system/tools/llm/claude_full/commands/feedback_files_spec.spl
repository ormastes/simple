"""
## Purpose and audience
Purpose: should expose feedback command metadata
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Feedback and Files Commands

Checks modern SSpec parity for feedback and files command descriptors.
"""

# @req: REQ-TOOLS-FeedFile-001

use std.spec.*
use app.llm_caret.claude_full.commands.feedback.feedback.*
use app.llm_caret.claude_full.commands.feedback.index.*
use app.llm_caret.claude_full.commands.files.files.*
use app.llm_caret.claude_full.commands.files.index.*

describe "Claude full feedback files commands":
    it "should expose feedback command metadata":
        step("Verify: should expose feedback command metadata")
        # @req: REQ-TOOLS-FeedFile-001
        expect(feedbackCommandName()).to_equal("feedback")
        expect(feedbackCommandDescription()).to_contain("feedback")
        expect(feedbackCommandUrl()).to_contain("github.com")
        expect(feedbackCommandMessage()).to_contain("Opening feedback")

    it "should expose files command metadata":
        step("Verify: should expose files command metadata")
        # @req: REQ-TOOLS-FeedFile-001
        expect(filesCommandName()).to_equal("files")
        expect(filesCommand().description).to_contain("current conversation")
        expect(filesCommand().typeName).to_equal("local-jsx")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-FeedFile-001
        expect(feedbackCommandSourceLinesModeled()).to_equal(24)  # oracle: value fixed by the spec contract
        expect(feedbackIndexSourceLinesModeled()).to_equal(26)  # oracle: value fixed by the spec contract
        expect(filesCommandSourceLinesModeled()).to_equal(19)  # oracle: value fixed by the spec contract
        expect(filesIndexSourceLinesModeled()).to_equal(12)  # oracle: value fixed by the spec contract
