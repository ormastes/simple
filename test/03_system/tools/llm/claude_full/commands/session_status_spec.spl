"""
## Purpose and audience
Purpose: should model session display
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Session and Status Commands

Checks modern SSpec parity for session, skills, stats, status, statusline, and stickers.
"""

# @req: REQ-TOOLS-SessStat-001

use std.spec.*
use app.llm_caret.claude_full.commands.session.session.*
use app.llm_caret.claude_full.commands.session.index.*
use app.llm_caret.claude_full.commands.skills.skills.*
use app.llm_caret.claude_full.commands.skills.index.*
use app.llm_caret.claude_full.commands.stats.stats.*
use app.llm_caret.claude_full.commands.stats.index.*
use app.llm_caret.claude_full.commands.status.status.*
use app.llm_caret.claude_full.commands.status.index.*
use app.llm_caret.claude_full.commands.statusline.*
use app.llm_caret.claude_full.commands.stickers.index.*

describe "Claude full session status commands":
    it "should model session display":
        step("Verify: should model session display")
        # @req: REQ-TOOLS-SessStat-001
        val summary = SessionSummary.new("s1", "Build", 4)
        expect(sessionIndexName()).to_equal("session")
        expect(sessionDisplay(summary)).to_contain("Build")
        expect(sessionDisplay(summary)).to_contain("4")

    it "should expose small command names":
        step("Verify: should expose small command names")
        # @req: REQ-TOOLS-SessStat-001
        expect(skillsIndexName()).to_equal("skills")
        expect(statsIndexName()).to_equal("stats")
        expect(statusIndexName()).to_equal("status")
        expect(statuslineText("model", "/tmp")).to_contain("/tmp")
        expect(stickersIndexName()).to_equal("stickers")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-SessStat-001
        expect(sessionSourceLinesModeled()).to_equal(139)  # oracle: value fixed by the spec contract
        expect(sessionIndexSourceLinesModeled()).to_equal(16)  # oracle: value fixed by the spec contract
        expect(skillsSourceLinesModeled()).to_equal(7)  # oracle: value fixed by the spec contract
        expect(skillsIndexSourceLinesModeled()).to_equal(10)  # oracle: value fixed by the spec contract
        expect(statsSourceLinesModeled()).to_equal(6)  # oracle: value fixed by the spec contract
        expect(statsIndexSourceLinesModeled()).to_equal(10)  # oracle: value fixed by the spec contract
        expect(statusSourceLinesModeled()).to_equal(7)  # oracle: value fixed by the spec contract
        expect(statusIndexSourceLinesModeled()).to_equal(12)  # oracle: value fixed by the spec contract
        expect(statuslineSourceLinesModeled()).to_equal(23)  # oracle: value fixed by the spec contract
        expect(stickersIndexSourceLinesModeled()).to_equal(11)  # oracle: value fixed by the spec contract
