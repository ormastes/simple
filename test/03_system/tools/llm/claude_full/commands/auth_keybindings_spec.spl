"""
## Purpose and audience
Purpose: should model keybindings lookup
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Auth and Keybindings Commands

Checks modern SSpec parity for keybindings, login, and logout.
"""

# @req: REQ-TOOLS-AuthKeyb-001

use std.spec.*
use app.llm_caret.claude_full.commands.keybindings.keybindings.*
use app.llm_caret.claude_full.commands.keybindings.index.*
use app.llm_caret.claude_full.commands.login.login.*
use app.llm_caret.claude_full.commands.login.index.*
use app.llm_caret.claude_full.commands.logout.logout.*
use app.llm_caret.claude_full.commands.logout.index.*

describe "Claude full auth keybindings commands":
    it "should model keybindings lookup":
        step("Verify: should model keybindings lookup")
        # @req: REQ-TOOLS-AuthKeyb-001
        expect(keybindingsIndexCommandName()).to_equal("keybindings")
        expect(keybindingsFindAction("tab")).to_equal("complete")
        expect(keybindingsFindAction("missing")).to_equal("")

    it "should model login and logout decisions":
        step("Verify: should model login and logout decisions")
        # @req: REQ-TOOLS-AuthKeyb-001
        expect(loginIndexCommandName()).to_equal("login")
        expect(runLoginCommand("anthropic", false).shouldOpenBrowser).to_equal(true)
        expect(runLoginCommand("anthropic", true).message).to_contain("Already")
        expect(logoutIndexCommandName()).to_equal("logout")
        expect(runLogoutCommand(true).clearedCredentials).to_equal(true)
        expect(runLogoutCommand(false).message).to_contain("Not logged")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-AuthKeyb-001
        expect(keybindingsSourceLinesModeled()).to_equal(53)  # oracle: value fixed by the spec contract
        expect(keybindingsIndexSourceLinesModeled()).to_equal(13)  # oracle: value fixed by the spec contract
        expect(loginSourceLinesModeled()).to_equal(103)  # oracle: value fixed by the spec contract
        expect(loginIndexSourceLinesModeled()).to_equal(14)  # oracle: value fixed by the spec contract
        expect(logoutSourceLinesModeled()).to_equal(81)  # oracle: value fixed by the spec contract
        expect(logoutIndexSourceLinesModeled()).to_equal(10)  # oracle: value fixed by the spec contract
