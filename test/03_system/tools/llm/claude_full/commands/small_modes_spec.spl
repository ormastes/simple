"""
## Purpose and audience
Purpose: should expose small descriptor names
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Small Mode Commands

Checks modern SSpec parity for output-style, passes, permissions, and plan.
"""

# @req: REQ-TOOLS-SmalMode-001

use std.spec.*
use app.llm_caret.claude_full.commands.output_style.output_style.*
use app.llm_caret.claude_full.commands.output_style.index.*
use app.llm_caret.claude_full.commands.passes.passes.*
use app.llm_caret.claude_full.commands.passes.index.*
use app.llm_caret.claude_full.commands.permissions.permissions.*
use app.llm_caret.claude_full.commands.permissions.index.*
use app.llm_caret.claude_full.commands.plan.plan.*
use app.llm_caret.claude_full.commands.plan.index.*

describe "Claude full small mode commands":
    it "should expose small descriptor names":
        step("Verify: should expose small descriptor names")
        # @req: REQ-TOOLS-SmalMode-001
        expect(outputStyleIndexCommandName()).to_equal("output-style")
        expect(passesIndexCommandName()).to_equal("passes")
        expect(permissionsIndexCommandName()).to_equal("permissions")

    it "should model plan state changes":
        step("Verify: should model plan state changes")
        # @req: REQ-TOOLS-SmalMode-001
        val state = PlanCommandState.new("default", false)
        expect(planIndexCommandName()).to_equal("plan")
        expect(enterPlanMode(state).readonly).to_equal(true)
        expect(planModeMessage(enterPlanMode(state))).to_contain("enabled")
        expect(leavePlanMode(enterPlanMode(state)).mode).to_equal("default")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-SmalMode-001
        expect(outputStyleIndexSourceLinesModeled()).to_equal(11)  # oracle: value fixed by the spec contract
        expect(passesSourceLinesModeled()).to_equal(23)  # oracle: value fixed by the spec contract
        expect(passesIndexSourceLinesModeled()).to_equal(22)  # oracle: value fixed by the spec contract
        expect(permissionsSourceLinesModeled()).to_equal(9)  # oracle: value fixed by the spec contract
        expect(permissionsIndexSourceLinesModeled()).to_equal(11)  # oracle: value fixed by the spec contract
        expect(planSourceLinesModeled()).to_equal(121)  # oracle: value fixed by the spec contract
        expect(planIndexSourceLinesModeled()).to_equal(11)  # oracle: value fixed by the spec contract
