"""
## Purpose and audience
Purpose: should paginate plugin rows
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Plugin Followup Commands

Checks modern SSpec parity for pagination and command followups.
"""

# @req: REQ-TOOLS-PlugFollComm-001

use std.spec.*
use app.llm_caret.claude_full.commands.plugin.usePagination.*
use app.llm_caret.claude_full.commands.pr_comments.index.*
use app.llm_caret.claude_full.commands.privacy_settings.privacy_settings.*
use app.llm_caret.claude_full.commands.privacy_settings.index.*
use app.llm_caret.claude_full.commands.rate_limit_options.rate_limit_options.*
use app.llm_caret.claude_full.commands.rate_limit_options.index.*
use app.llm_caret.claude_full.commands.release_notes.release_notes.*
use app.llm_caret.claude_full.commands.release_notes.index.*
use app.llm_caret.claude_full.commands.reload_plugins.reload_plugins.*
use app.llm_caret.claude_full.commands.reload_plugins.index.*

describe "Claude full plugin followup commands":
    it "should paginate plugin rows":
        step("Verify: should paginate plugin rows")
        # @req: REQ-TOOLS-PlugFollComm-001
        val page = PaginationState.new(2, 10, 21)
        expect(paginationTotalPages(page)).to_equal(3)  # oracle: value fixed by the spec contract
        expect(paginationCanNext(page)).to_equal(true)
        expect(paginationCanPrevious(page)).to_equal(true)

    it "should expose command behavior":
        step("Verify: should expose command behavior")
        # @req: REQ-TOOLS-PlugFollComm-001
        expect(prCommentsSummary(3)).to_contain("3")
        expect(privacySettingsSummary(PrivacySettings.new(true, false))).to_contain("telemetry=true")
        expect(rateLimitOptionLabel(defaultRateLimitOptions()[0])).to_equal("wait:60")
        expect(releaseNotesUrl("v1")).to_contain("v1")
        expect(reloadPluginsResult(2).message).to_contain("2")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-PlugFollComm-001
        expect(usePaginationSourceLinesModeled()).to_equal(171)  # oracle: value fixed by the spec contract
        expect(prCommentsIndexSourceLinesModeled()).to_equal(50)  # oracle: value fixed by the spec contract
        expect(privacySettingsSourceLinesModeled()).to_equal(57)  # oracle: value fixed by the spec contract
        expect(privacySettingsIndexSourceLinesModeled()).to_equal(14)  # oracle: value fixed by the spec contract
        expect(rateLimitOptionsSourceLinesModeled()).to_equal(209)  # oracle: value fixed by the spec contract
        expect(rateLimitOptionsIndexSourceLinesModeled()).to_equal(19)  # oracle: value fixed by the spec contract
        expect(releaseNotesSourceLinesModeled()).to_equal(50)  # oracle: value fixed by the spec contract
        expect(releaseNotesIndexSourceLinesModeled()).to_equal(11)  # oracle: value fixed by the spec contract
        expect(reloadPluginsSourceLinesModeled()).to_equal(61)  # oracle: value fixed by the spec contract
        expect(reloadPluginsIndexSourceLinesModeled()).to_equal(18)  # oracle: value fixed by the spec contract
