"""
## Purpose and audience
Purpose: should expose MCP command metadata
Audience: compiler and tooling engineers who maintain this spec

# Claude Full MCP and Memory Commands

Checks modern SSpec parity for MCP command surface and memory descriptors.
"""

# @req: REQ-TOOLS-McpMemo-001

use std.spec.*
use app.llm_caret.claude_full.commands.mcp.mcp.*
use app.llm_caret.claude_full.commands.mcp.index.*
use app.llm_caret.claude_full.commands.memory.memory.*
use app.llm_caret.claude_full.commands.memory.index.*

describe "Claude full mcp memory commands":
    it "should expose MCP command metadata":
        step("Verify: should expose MCP command metadata")
        # @req: REQ-TOOLS-McpMemo-001
        expect(mcpCommandName()).to_equal("mcp")
        expect(mcpCommand().description).to_contain("MCP")
        expect(summarizeMcpServer(McpServerStatus.new("fs", "connected", "stdio"))).to_equal("fs:connected:stdio")

    it "should expose memory command metadata":
        step("Verify: should expose memory command metadata")
        # @req: REQ-TOOLS-McpMemo-001
        expect(memoryCommandName()).to_equal("memory")
        expect(memoryTargetPath("project")).to_equal("CLAUDE.md")
        expect(memoryTargetPath("user")).to_contain(".claude")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-McpMemo-001
        expect(mcpSourceLinesModeled()).to_equal(84)  # oracle: value fixed by the spec contract
        expect(mcpIndexSourceLinesModeled()).to_equal(12)  # oracle: value fixed by the spec contract
        expect(memorySourceLinesModeled()).to_equal(89)  # oracle: value fixed by the spec contract
        expect(memoryIndexSourceLinesModeled()).to_equal(10)  # oracle: value fixed by the spec contract
