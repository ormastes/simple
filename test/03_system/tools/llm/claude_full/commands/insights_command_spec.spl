# codex-system-test
"""
# Claude Full Insights Command

Focused parity for upstream `commands/insights.ts`.

`REQ-LLM-CARET-HIDDEN-008` applies to the insights descriptor, enablement,
interactive-session admission, and rejection scenarios. This remains
parts-bin evidence and does not claim shipped Caret reachability.

This source-synchronized specification does not claim execution in the current
runtime-blocked tranche.
"""

use std.spec.*
use std.io_runtime.{file_read}
use app.llm_caret.claude_full.commands.insights.*

fn countLines(text_value: text) -> i64:
    var count = 0
    var i = 0
    while i < text_value.len():
        if text_value[i] == "\n":
            count = count + 1
        i = i + 1
    count

use std.spec.step

describe "Claude full insights command":
    describe "REQ-LLM-CARET-HIDDEN-008: descriptor and enablement":
        it "should keep command metadata and source parity floor":
            # @req: REQ-TOOLS-INSIGHTS-COMMAND-001
            step("Verify: should keep command metadata and source parity floor")
            step("Check insights command metadata and source parity")
            val command = insightsCommand(true)
            expect(command.typeName).to_equal("local-jsx")
            expect(command.name).to_equal("insights")
            expect(command.description).to_contain("usage")
            expect(command.argumentHint).to_equal("")
            expect(command.isHidden).to_equal(false)
            expect(command.enabled).to_equal(true)
            expect(command.supportsNonInteractive).to_equal(false)
            expect(insightsCommandName()).to_equal("insights")
            expect(insightsLookbackDays()).to_equal(30)  # oracle: 30 — pinned expected value for this behavior
            expect(insightsReportPath()).to_contain("report.html")

            val source = file_read("src/app/llm_caret/claude_full/commands/insights.spl") ?? ""
            expect(countLines(source)).to_be_greater_than(3199)
            expect(insightsCommandSourceLinesModeled()).to_equal(3200)  # oracle: 3200 — pinned expected value for this behavior

    describe "Supporting parts-bin summary and report mechanics":
        it "should summarize only the last thirty days of local sessions":
            # @req: REQ-TOOLS-INSIGHTS-COMMAND-001
            step("Verify: should summarize only the last thirty days of local sessions")
            step("Summarize sessions from the last thirty days")
            val metrics = summarizeInsightsSessions(InsightsState.sample().sessions)
            expect(metrics.sessionsAnalyzed).to_equal(2)  # oracle: 2 — pinned expected value for this behavior
            expect(metrics.messages).to_equal(20)  # oracle: 20 — pinned expected value for this behavior
            expect(metrics.inputTokens).to_equal(13200)  # oracle: 13200 — pinned expected value for this behavior
            expect(metrics.outputTokens).to_equal(2100)  # oracle: 2100 — pinned expected value for this behavior
            expect(metrics.totalTokens).to_equal(15300)  # oracle: 15300 — pinned expected value for this behavior
            expect(metrics.filesTouched).to_equal(8)  # oracle: 8 — pinned expected value for this behavior
            expect(metrics.toolCalls).to_equal(24)  # oracle: 24 — pinned expected value for this behavior
            expect(metrics.firstAttemptSuccesses).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(metrics.firstAttemptFailures).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(metrics.topTaskKind).to_equal("debugging")
            expect(insightSuccessRatePercent(metrics)).to_equal(50)  # oracle: 50 — pinned expected value for this behavior

            val dayThirty = InsightsSession.new("day-30", 30, 1, 10, 2, 1, 1, true, "review")
            val dayThirtyOne = InsightsSession.new("day-31", 31, 100, 1000, 200, 10, 10, true, "feature")
            val negativeDay = InsightsSession.new("negative-day", -1, 100, 1000, 200, 10, 10, true, "debugging")
            val boundaryMetrics = summarizeInsightsSessions([dayThirty, dayThirtyOne, negativeDay])
            expect(boundaryMetrics.sessionsAnalyzed).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(boundaryMetrics.messages).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(boundaryMetrics.totalTokens).to_equal(12)  # oracle: 12 — pinned expected value for this behavior
            expect(boundaryMetrics.topTaskKind).to_equal("review")

        it "should generate report HTML and handle browser fallback":
            # @req: REQ-TOOLS-INSIGHTS-COMMAND-001
            step("Verify: should generate report HTML and handle browser fallback")
            step("Generate the insights report and handle browser fallback")
            var state = InsightsState.sample()
            var result = runInsights(state)
            expect(result.typeName).to_equal("report")
            expect(result.reportPath).to_equal("~/.claude/usage-data/report.html")
            expect(result.openedBrowser).to_equal(true)
            expect(result.message).to_contain("opened")
            expect(insightsReportContainsCoreSections(result.html)).to_equal(true)
            expect(result.html).to_contain("sessions=2")
            expect(result.html).to_contain("tokens=15300")

            state.browserOpenFails = true
            result = runInsights(state)
            expect(result.openedBrowser).to_equal(false)
            expect(result.message).to_contain("Open it in your browser")

    describe "REQ-LLM-CARET-HIDDEN-008: rejections and admission":
        it "should reject no-data noninteractive and write-failure states":
            # @req: REQ-TOOLS-INSIGHTS-COMMAND-001
            step("Verify: should reject no-data noninteractive and write-failure states")
            step("Reject no-data noninteractive and write-failure states")
            val noData = runInsights(InsightsState.empty())
            expect(noData.typeName).to_equal("message")
            expect(noData.message).to_contain("No Claude Code sessions")
            expect(noData.reportPath).to_equal("")
            expect(noData.html).to_equal("")
            expect(noData.openedBrowser).to_be(false)
            expect(noData.metrics.sessionsAnalyzed).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.messages).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.inputTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.outputTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.totalTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.filesTouched).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.toolCalls).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.firstAttemptSuccesses).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.firstAttemptFailures).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(noData.metrics.topTaskKind).to_equal("")

            var state = InsightsState.sample()
            state.nonInteractive = true
            val nonInteractive = runInsights(state)
            expect(nonInteractive.typeName).to_equal("message")
            expect(nonInteractive.message).to_contain("interactive")
            expect(nonInteractive.reportPath).to_equal("")
            expect(nonInteractive.html).to_equal("")
            expect(nonInteractive.openedBrowser).to_be(false)
            expect(nonInteractive.metrics.sessionsAnalyzed).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.messages).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.inputTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.outputTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.totalTokens).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.filesTouched).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.toolCalls).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.firstAttemptSuccesses).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.firstAttemptFailures).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
            expect(nonInteractive.metrics.topTaskKind).to_equal("")

            state = InsightsState.sample()
            state.writeReportFails = true
            val writeFailure = runInsights(state)
            expect(writeFailure.typeName).to_equal("message")
            expect(writeFailure.message).to_contain("Failed to write")
            expect(writeFailure.reportPath).to_equal("")
            expect(writeFailure.html).to_equal("")
            expect(writeFailure.openedBrowser).to_be(false)
            expect(writeFailure.metrics.sessionsAnalyzed).to_equal(2)  # oracle: 2 — pinned expected value for this behavior
            expect(writeFailure.metrics.messages).to_equal(20)  # oracle: 20 — pinned expected value for this behavior
            expect(writeFailure.metrics.inputTokens).to_equal(13200)  # oracle: 13200 — pinned expected value for this behavior
            expect(writeFailure.metrics.outputTokens).to_equal(2100)  # oracle: 2100 — pinned expected value for this behavior
            expect(writeFailure.metrics.totalTokens).to_equal(15300)  # oracle: 15300 — pinned expected value for this behavior
            expect(writeFailure.metrics.filesTouched).to_equal(8)  # oracle: 8 — pinned expected value for this behavior
            expect(writeFailure.metrics.toolCalls).to_equal(24)  # oracle: 24 — pinned expected value for this behavior
            expect(writeFailure.metrics.firstAttemptSuccesses).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(writeFailure.metrics.firstAttemptFailures).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
            expect(writeFailure.metrics.topTaskKind).to_equal("debugging")
