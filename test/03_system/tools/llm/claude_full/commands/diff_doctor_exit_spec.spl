"""
## Purpose and audience
Purpose: should expose diff and doctor commands
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Diff, Doctor, and Exit Commands

Checks modern SSpec parity for the small command descriptors.
"""

# @req: REQ-TOOLS-DiffDoctExit-001

use std.spec.*
use app.llm_caret.claude_full.commands.diff.diff.*
use app.llm_caret.claude_full.commands.diff.index.*
use app.llm_caret.claude_full.commands.doctor.doctor.*
use app.llm_caret.claude_full.commands.doctor.index.*
use app.llm_caret.claude_full.commands.exit.exit.*
use app.llm_caret.claude_full.commands.exit.index.*

describe "Claude full diff doctor exit commands":
    it "should expose diff and doctor commands":
        step("Verify: should expose diff and doctor commands")
        # @req: REQ-TOOLS-DiffDoctExit-001
        expect(diffCommandTarget()).to_equal("diff")
        expect(diffCommandName()).to_equal("diff")
        expect(doctorCommandTarget()).to_equal("doctor")
        expect(doctorCommandDescription()).to_contain("health")

    it "should model exit behavior":
        step("Verify: should model exit behavior")
        # @req: REQ-TOOLS-DiffDoctExit-001
        expect(exitCommandName()).to_equal("exit")
        expect(exitCommand().aliases.len()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(runExitCommand().shouldExit).to_equal(true)
        expect(runExitCommand().display).to_equal("system")

    it "should expose source sizes":
        step("Verify: should expose source sizes")
        # @req: REQ-TOOLS-DiffDoctExit-001
        expect(diffCommandSourceLinesModeled()).to_equal(8)  # oracle: value fixed by the spec contract
        expect(diffIndexSourceLinesModeled()).to_equal(8)  # oracle: value fixed by the spec contract
        expect(doctorCommandSourceLinesModeled()).to_equal(6)  # oracle: value fixed by the spec contract
        expect(doctorIndexSourceLinesModeled()).to_equal(12)  # oracle: value fixed by the spec contract
        expect(exitCommandSourceLinesModeled()).to_equal(32)  # oracle: value fixed by the spec contract
        expect(exitIndexSourceLinesModeled()).to_equal(12)  # oracle: value fixed by the spec contract
