# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Claude Full config constants

Pure Simple coverage for dependency-free config constants.
"""

use std.spec.step

use std.spec.*
use app.llm_caret.claude_full.utils.configConstants.*

describe "Claude full config constants":
    # @manual scenario evidence
    it "exposes notification channels in TS order":
        # @req REQ-SSPEC-SYSTEM
        step("exposes notification channels in TS order")
        step("Check notification channel list")
        expect(notificationChannels()).to_equal(["auto", "iterm2", "iterm2_with_bell", "terminal_bell", "kitty", "ghostty", "notifications_disabled"])

    it "exposes supported editor modes without deprecated emacs":
        # @req REQ-SSPEC-SYSTEM
        step("exposes supported editor modes without deprecated emacs")
        step("Check editor modes")
        expect(editorModes()).to_equal(["normal", "vim"])

    it "exposes teammate spawn modes in TS order":
        # @req REQ-SSPEC-SYSTEM
        step("exposes teammate spawn modes in TS order")
        step("Check teammate modes")
        expect(teammateModes()).to_equal(["auto", "tmux", "in-process"])
