"""
## Purpose and audience
Purpose: should start authentication and emit status changes
Audience: compiler and tooling engineers who maintain this spec

# Claude Full AwsAuthStatusManager

Checks cloud auth refresh status state transitions.
"""

# @req: REQ-TOOLS-Awsa-001

use std.spec.*
use app.llm_caret.claude_full.utils.awsAuthStatusManager.*

describe "Claude full AwsAuthStatusManager":
    it "should start authentication and emit status changes":
        step("Verify: should start authentication and emit status changes")
        # @req: REQ-TOOLS-Awsa-001
        val manager = AwsAuthStatusManager.new().startAuthentication()
        val status = manager.getStatus()
        expect(status.isAuthenticating).to_equal(true)
        expect(status.output.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(manager.changeCount).to_equal(1)  # oracle: value fixed by the spec contract

    it "should retain output and error on failed authentication":
        step("Verify: should retain output and error on failed authentication")
        # @req: REQ-TOOLS-Awsa-001
        val manager = AwsAuthStatusManager.new().startAuthentication().addOutput("checking credentials").setError("denied").endAuthentication(false)
        val status = manager.getStatus()
        expect(status.isAuthenticating).to_equal(false)
        expect(status.output[0]).to_equal("checking credentials")
        expect(status.error).to_equal("denied")
        expect(manager.changeCount).to_equal(4)  # oracle: value fixed by the spec contract

    it "should clear status on success and reset for tests":
        step("Verify: should clear status on success and reset for tests")
        # @req: REQ-TOOLS-Awsa-001
        val manager = AwsAuthStatusManager.new().startAuthentication().addOutput("ok").endAuthentication(true)
        expect(manager.getStatus().output.len()).to_equal(0)  # oracle: value fixed by the spec contract
        expect(manager.getStatus().error).to_equal("")
        expect(AwsAuthStatusManager.reset().changeCount).to_equal(0)  # oracle: value fixed by the spec contract
        expect(awsAuthStatusManagerSourceLinesModeled()).to_equal(81)  # oracle: value fixed by the spec contract
