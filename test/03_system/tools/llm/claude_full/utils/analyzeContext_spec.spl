"""
## Purpose and audience
Purpose: should extract section names
Audience: compiler and tooling engineers who maintain this spec

# Claude Full analyzeContext Slice

Focused pure-Simple post-processing coverage for analyzeContext.
"""

# @req: REQ-TOOLS-Anal-001

use std.spec.*
use app.llm_caret.claude_full.components.ContextVisualization.*
use app.llm_caret.claude_full.utils.analyzeContext.*

describe "Claude full analyzeContext parity":
    it "should extract section names":
        step("Verify: should extract section names")
        # @req: REQ-TOOLS-Anal-001
        step("Check headings and fallback previews")
        expect(extractSectionNameRoute("intro\n## System Rules\nbody")).to_equal("System Rules")
        expect(extractSectionNameRoute("\nplain first line\nbody")).to_equal("plain first line")
        expect(extractSectionNameRoute("abcdefghijklmnopqrstuvwxyz0123456789EXTRA")).to_equal("abcdefghijklmnopqrstuvwxyz0123456789EXTR...")

    it "should compute reserves and actual usage":
        step("Verify: should compute reserves and actual usage")
        # @req: REQ-TOOLS-Anal-001
        step("Check deferred exclusion and reserve labels")
        val categories = [
            ContextCategory.new("System prompt", 100, "primary", false),
            ContextCategory.new("Deferred MCP tools", 500, "muted", true),
            ContextCategory.new("Messages", 50, "purple", false),
        ]
        expect(actualUsageTokensRoute(categories)).to_equal(150)  # oracle: value fixed by the spec contract
        expect(reserveCategoryNameRoute(true)).to_equal("Autocompact buffer")
        expect(reserveCategoryNameRoute(false)).to_equal("Compact buffer")
        expect(reserveTokensRoute(200000, 167000, true, false)).to_equal(33000)  # oracle: value fixed by the spec contract
        expect(reserveTokensRoute(200000, 0, false, false)).to_equal(3000)  # oracle: value fixed by the spec contract
        expect(reserveTokensRoute(200000, 167000, true, true)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(freeSpaceTokensRoute(1000, 900, 200)).to_equal(0)  # oracle: value fixed by the spec contract

    it "should prefer API usage totals":
        step("Verify: should prefer API usage totals")
        # @req: REQ-TOOLS-Anal-001
        step("Check total selection")
        expect(finalTotalTokensRoute(true, 10, 20, 30, 999)).to_equal(60)  # oracle: value fixed by the spec contract
        expect(finalTotalTokensRoute(false, 10, 20, 30, 999)).to_equal(999)  # oracle: value fixed by the spec contract

    it "should size context grids":
        step("Verify: should size context grids")
        # @req: REQ-TOOLS-Anal-001
        step("Check terminal-width grid rules")
        expect(gridWidthRoute(200000, 120)).to_equal(10)  # oracle: value fixed by the spec contract
        expect(gridHeightRoute(200000, 120)).to_equal(10)  # oracle: value fixed by the spec contract
        expect(gridWidthRoute(200000, 60)).to_equal(5)  # oracle: value fixed by the spec contract
        expect(gridHeightRoute(200000, 60)).to_equal(5)  # oracle: value fixed by the spec contract
        expect(gridWidthRoute(1000000, 120)).to_equal(20)  # oracle: value fixed by the spec contract
        expect(gridHeightRoute(1000000, 60)).to_equal(10)  # oracle: value fixed by the spec contract
        expect(roundedGridSquaresRoute(1, 200000, 100, false)).to_equal(1)  # oracle: value fixed by the spec contract
        expect(roundedGridSquaresRoute(0, 200000, 100, true)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(analyzeContextSourceLinesModeled()).to_equal(1382)  # oracle: value fixed by the spec contract
