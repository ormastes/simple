"""
## Purpose and audience
Purpose: should clamp offsets and compute wrapped positions
Audience: compiler and tooling engineers who maintain this spec

# Claude Full Cursor

Checks cursor, wrapped line, and measured text surfaces.
"""

# @req: REQ-TOOLS-Curs-001

use std.spec.*
use app.llm_caret.claude_full.utils.Cursor.*

describe "Claude full Cursor":
    it "should clamp offsets and compute wrapped positions":
        step("Verify: should clamp offsets and compute wrapped positions")
        # @req: REQ-TOOLS-Curs-001
        val measured = MeasuredText.new("abcdef", 3)
        val cursor = Cursor.new(measured, 99, 0)
        expect(cursor.offset).to_equal(6)  # oracle: value fixed by the spec contract
        expect(measured.getWrappedText()).to_equal(["abc", "def"])
        expect(measured.getPositionFromOffset(4).line).to_equal(1)  # oracle: value fixed by the spec contract
        expect(measured.getOffsetFromPosition(Position.new(1, 1))).to_equal(4)  # oracle: value fixed by the spec contract

    it "should move and edit text":
        step("Verify: should move and edit text")
        # @req: REQ-TOOLS-Curs-001
        var cursor = Cursor.fromText("abc", 4, 1, 0)
        expect(cursor.left().offset).to_equal(0)  # oracle: value fixed by the spec contract
        expect(cursor.right().offset).to_equal(2)  # oracle: value fixed by the spec contract
        cursor = cursor.insert("Z")
        expect(cursor.text()).to_equal("aZbc")
        expect(cursor.backspace().text()).to_equal("abc")
        expect(cursor.del().text()).to_equal("aZc")

    it "should expose viewport line and wrapped line helpers":
        step("Verify: should expose viewport line and wrapped line helpers")
        # @req: REQ-TOOLS-Curs-001
        val cursor = Cursor.fromText("abcdefghi", 4, 5, 0)
        expect(cursor.getViewportStartLine(2)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(cursor.getViewportCharEnd(2)).to_equal(6)  # oracle: value fixed by the spec contract
        val line = WrappedLine.new("abc", 0, false, true)
        expect(line.length()).to_equal(4)  # oracle: value fixed by the spec contract
        expect(line.text).to_equal("abc")

    it "should expose vim classification and source size":
        step("Verify: should expose vim classification and source size")
        # @req: REQ-TOOLS-Curs-001
        expect(isVimWordChar("_")).to_equal(true)
        expect(isVimWhitespace(" ")).to_equal(true)
        expect(isVimPunctuation("!")).to_equal(true)
        expect(cursorSourceLinesModeled()).to_equal(1530)  # oracle: value fixed by the spec contract
