"""
## Purpose and audience
Purpose: Random to_i32 returns 0
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplChaoSche-001

use std.spec
use std.nogc_sync_mut.replay.process.chaos_scheduler.{ChaosStrategy, ChaosScheduler}

use std.spec.step
describe "ChaosStrategy to_i32":
    it "Random to_i32 returns 0":
        step("Verify: Random to_i32 returns 0")
        # @req: REQ-TOOLS-ReplChaoSche-001
        val s = ChaosStrategy::Random
        expect(s.to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "RoundRobin to_i32 returns 1":
        step("Verify: RoundRobin to_i32 returns 1")
        # @req: REQ-TOOLS-ReplChaoSche-001
        val s = ChaosStrategy::RoundRobin
        expect(s.to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "StarveLast to_i32 returns 2":
        step("Verify: StarveLast to_i32 returns 2")
        # @req: REQ-TOOLS-ReplChaoSche-001
        val s = ChaosStrategy::StarveLast
        expect(s.to_i32()).to_equal(2)  # oracle: value fixed by the spec contract

    it "PrioritizeNew to_i32 returns 3":
        step("Verify: PrioritizeNew to_i32 returns 3")
        # @req: REQ-TOOLS-ReplChaoSche-001
        val s = ChaosStrategy::PrioritizeNew
        expect(s.to_i32()).to_equal(3)  # oracle: value fixed by the spec contract

describe "ChaosScheduler create and schedule_count":
    it "new scheduler has schedule_count 0":
        step("Verify: new scheduler has schedule_count 0")
        # @req: REQ-TOOLS-ReplChaoSche-001
        var sched = ChaosScheduler.create(ChaosStrategy::RoundRobin, 42)
        expect(sched.schedule_count()).to_equal(0)  # oracle: value fixed by the spec contract

    it "pick_next on empty tids returns -1":
        step("Verify: pick_next on empty tids returns -1")
        # @req: REQ-TOOLS-ReplChaoSche-001
        var sched = ChaosScheduler.create(ChaosStrategy::Random, 1)
        val chosen = sched.pick_next([])
        expect(chosen).to_equal(-1)  # oracle: value fixed by the spec contract

    it "pick_next with one tid always picks that tid":
        step("Verify: pick_next with one tid always picks that tid")
        # @req: REQ-TOOLS-ReplChaoSche-001
        var sched = ChaosScheduler.create(ChaosStrategy::Random, 99)
        val chosen = sched.pick_next([7])
        expect(chosen).to_equal(7)  # oracle: value fixed by the spec contract

    it "RoundRobin pick_next increments schedule_count":
        step("Verify: RoundRobin pick_next increments schedule_count")
        # @req: REQ-TOOLS-ReplChaoSche-001
        var sched = ChaosScheduler.create(ChaosStrategy::RoundRobin, 0)
        sched.pick_next([1, 2, 3])
        sched.pick_next([1, 2, 3])
        expect(sched.schedule_count()).to_equal(2)  # oracle: value fixed by the spec contract

    it "PrioritizeNew picks highest tid":
        step("Verify: PrioritizeNew picks highest tid")
        # @req: REQ-TOOLS-ReplChaoSche-001
        var sched = ChaosScheduler.create(ChaosStrategy::PrioritizeNew, 0)
        val chosen = sched.pick_next([10, 30, 20])
        expect(chosen).to_equal(30)  # oracle: value fixed by the spec contract
