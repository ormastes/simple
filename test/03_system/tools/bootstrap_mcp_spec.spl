"""
# Bootstrap MCP Server Native Build Specification

**Feature IDs:** #MCP-BOOT-001
**Category:** Tooling
**Difficulty:** 3/5
**Status:** Draft
**Requirements:** N/A
**Plan:** .sstack/native-mcp-build-bootstrap/state.md
**Design:** N/A
**Research:** N/A

## Overview

System tests for native MCP server compilation in the bootstrap pipeline.
Verifies that after bootstrap with --deploy, both MCP server binaries
(simple_mcp_server, simple_lsp_mcp_server) exist, are executable, and
respond to JSON-RPC initialize requests.

Shell-level integration tests (AC-1 through AC-4, AC-6, AC-7) are defined
as verification commands in the state file. This SPipe file covers AC-5:
runtime validation that MCP servers respond to JSON-RPC initialize.

## Key Concepts

| Concept              | Description                                             |
|----------------------|---------------------------------------------------------|
| native-build         | Compiler command that produces a platform-native binary  |
| MCP server           | JSON-RPC stdio server implementing Model Context Proto  |
| initialize           | First JSON-RPC request a client sends to an MCP server  |
| bootstrap pipeline   | Multi-stage build: Rust seed -> Simple compiler -> self  |
| platform triple      | Target identifier e.g. x86_64-unknown-linux-gnu         |

## Behavior

- After bootstrap --deploy, bin/simple_mcp_server is a symlink to a native binary
- After bootstrap --deploy, bin/simple_lsp_mcp_server is a symlink to a native binary
- Both servers accept JSON-RPC initialize on stdin and return capabilities
- The --no-mcp flag skips MCP server compilation entirely

## Related Specifications

- [CLI MCP Completeness](cli_mcp_completeness_spec.spl)
- [OS Compiler Bootstrap](os_compiler_bootstrap_spec.spl)
- [T32 MCP Lifecycle](t32_mcp_lifecycle_spec.spl)
"""

# @req REQ-MCP-BOOT-001
# @feature native_mcp_bootstrap
# tag: system, slow

use std.spec
use std.io_runtime.{file_exists, process_run}

struct ProcessOutput:
    out_text: text
    err_text: text
    exit_code: i64

# ============================================================================
# Helpers
# ============================================================================

fn detect_platform() -> text:
    val (uname_out, _, rc) = process_run("uname", ["-s"])
    if rc != 0:
        return "unknown"
    val os = uname_out.trim().lower()
    val (arch_out, _, rc2) = process_run("uname", ["-m"])
    if rc2 != 0:
        return "unknown"
    val arch = arch_out.trim()
    if os == "linux":
        return "{arch}-unknown-linux-gnu"
    elif os == "darwin":
        return "{arch}-apple-darwin-macho"
    "unknown"

fn mcp_binary_path(name: text) -> text:
    val triple = detect_platform()
    "bin/release/{triple}/{name}"

fn send_initialize_request(binary_path: text) -> ProcessOutput:
    # JSON-RPC initialize request with Content-Length header (MCP over stdio)
    val json_body = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"test\",\"version\":\"0.1.0\"}}}"
    val content_length = json_body.len()
    val request = "Content-Length: {content_length}\r\n\r\n{json_body}"
    # Use bash to echo the request into the MCP server stdin with a timeout
    val cmd = "echo -n '{request}' | timeout 10 {binary_path} 2>/dev/null || true"
    val (out_text, err_text, exit_code) = process_run("bash", ["-c", cmd])
    ProcessOutput(out_text: out_text, err_text: err_text, exit_code: exit_code)

fn send_tool_call_request(binary_path: text, tool_name: text, arguments_json: text) -> ProcessOutput:
    val json_body = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"{tool_name}\",\"arguments\":{arguments_json}}}"
    val content_length = json_body.len()
    val request = "Content-Length: {content_length}\r\n\r\n{json_body}"
    val cmd = "echo -n '{request}' | timeout 20 {binary_path} 2>/dev/null || true"
    val (out_text, err_text, exit_code) = process_run("bash", ["-c", cmd])
    ProcessOutput(out_text: out_text, err_text: err_text, exit_code: exit_code)


# ============================================================================
# Test Group 1: MCP Binary Existence (AC-1, AC-6)
# ============================================================================

use std.spec.step

describe "Bootstrap MCP — binary existence":
    """
    ## Binary Existence

    After bootstrap --deploy, native MCP server binaries must exist at
    bin/release/<triple>/ alongside the main CLI binary.
    """

    it "simple_mcp_server binary exists at platform release path":
        # @req REQ-MCP-CMD-002
        # @req REQ-MCP-CMD-002
        # @req REQ-SSPEC-SYSTEM
        step("simple_mcp_server binary exists at platform release path")
        val path = mcp_binary_path("simple_mcp_server")
        expect(file_exists(path)).to_equal(true)

    it "simple_lsp_mcp_server binary exists at platform release path":
        # @req REQ-SSPEC-SYSTEM
        step("simple_lsp_mcp_server binary exists at platform release path")
        val path = mcp_binary_path("simple_lsp_mcp_server")
        expect(file_exists(path)).to_equal(true)

    it "native MCP binaries have matching integrity sidecars":
        # @req REQ-SSPEC-SYSTEM
        step("native MCP binaries have matching integrity sidecars")
        for name in ["simple_mcp_server", "simple_lsp_mcp_server"]:
            val binary = mcp_binary_path(name)
            val sidecar = binary + ".sha256"
            expect(file_exists(sidecar)).to_equal(true)
            expect(file_read(sidecar).trim()).to_equal(file_hash_sha256(binary))


# ============================================================================
# Test Group 2: Symlinks (AC-3)
# ============================================================================

describe "Bootstrap MCP — symlinks":
    """
    ## Symlink Verification

    After setup.shs, bin/simple_mcp_server and bin/simple_lsp_mcp_server
    must be symlinks (or copies) that resolve to platform-specific binaries.
    """

    it "bin/simple_mcp_server launcher exists":
        # @req REQ-SSPEC-SYSTEM
        step("bin/simple_mcp_server launcher exists")
        expect(file_exists("bin/simple_mcp_server")).to_equal(true)

    it "bin/simple_lsp_mcp_server launcher exists":
        # @req REQ-SSPEC-SYSTEM
        step("bin/simple_lsp_mcp_server launcher exists")
        expect(file_exists("bin/simple_lsp_mcp_server")).to_equal(true)

    it "bin/simple_mcp_server is executable":
        # @req REQ-SSPEC-SYSTEM
        step("bin/simple_mcp_server is executable")
        val (_, _, rc) = process_run("test", ["-x", "bin/simple_mcp_server"])
        expect(rc).to_equal(0)

    it "bin/simple_lsp_mcp_server is executable":
        # @req REQ-SSPEC-SYSTEM
        step("bin/simple_lsp_mcp_server is executable")
        val (_, _, rc) = process_run("test", ["-x", "bin/simple_lsp_mcp_server"])
        expect(rc).to_equal(0)

    it "deployed MCP launcher passes its native startup probe":
        # @req REQ-SSPEC-SYSTEM
        step("deployed MCP launcher passes its native startup probe")
        val (out, err, rc) = process_run("bin/simple_mcp_server", ["--probe"])
        expect(rc).to_equal(0)
        expect(out + err).to_contain("probe ok")
        expect(out + err).to_contain("tools=163")

    it "deployed MCP launcher anchors real codebase requests at the repository":
        # @req REQ-SSPEC-SYSTEM
        step("deployed MCP launcher anchors real codebase requests at the repository")
        val wrapper = file_read("bin/simple_mcp_server")
        expect(wrapper.contains("script_dir=\"$(CDPATH= cd \"$\{script_dir}\" && pwd)\"")).to_equal(true)
        expect(wrapper.contains("repo_root=\"$(CDPATH= cd \"$\{script_dir}/..\" && pwd)\"")).to_equal(true)
        expect(wrapper.contains("cd \"$\{repo_root}\"")).to_equal(true)
        val initialize = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-mcp-initialize\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"bootstrap\",\"version\":\"1\"}}}"
        val search = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-mcp-search\",\"method\":\"tools/call\",\"params\":{\"name\":\"simple_search\",\"arguments\":{\"query\":\"compile_runtime_objects\",\"kind\":\"fn\",\"scope\":\"compiler\"}}}"
        val no_match = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-mcp-no-match\",\"method\":\"tools/call\",\"params\":{\"name\":\"simple_search\",\"arguments\":{\"query\":\"__PURE_SIMPLE_MCP_NO_SUCH_DECL__\",\"kind\":\"fn\",\"scope\":\"compiler\"}}}"
        val injection = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-mcp-injection\",\"method\":\"tools/call\",\"params\":{\"name\":\"simple_search\",\"arguments\":{\"query\":\"__NO_MATCH__; touch /tmp/simple_mcp_framed_injection\",\"scope\":\"compiler\"}}}"
        val command = "runner=; if command -v timeout >/dev/null 2>&1; then runner='timeout 10'; elif command -v gtimeout >/dev/null 2>&1; then runner='gtimeout 10'; elif command -v perl >/dev/null 2>&1; then runner=\"perl -e 'alarm shift; exec @ARGV' 10\"; else exit 127; fi; repo_root=\"$(pwd)\"; workdir=\"$(mktemp -d)\"; sentinel=/tmp/simple_mcp_framed_injection; rm -f \"$sentinel\"; trap 'rm -rf \"$workdir\"; rm -f \"$sentinel\"' EXIT; init='" + initialize + "'; positive='" + search + "'; negative='" + no_match + "'; injection='" + injection + "'; (cd \"$workdir\" && { for body in \"$init\" \"$positive\" \"$negative\" \"$injection\"; do printf 'Content-Length: %s\\r\\n\\r\\n%s' \"$\{#body}\" \"$body\"; done; } | $runner \"$repo_root/bin/simple_mcp_server\"); test ! -e \"$sentinel\""
        val (out, err, rc) = process_run("sh", ["-c", command])
        expect(rc).to_equal(0)
        val response = out + err
        expect(response.contains("\"id\":\"bootstrap-mcp-initialize\",\"result\"")).to_equal(true)
        expect(response.contains("\"id\":\"bootstrap-mcp-search\",\"result\"")).to_equal(true)
        expect(response.contains("runtime_compiler.spl")).to_equal(true)
        expect(response.contains("fn compile_runtime_objects")).to_equal(true)
        expect(response.contains("\"id\":\"bootstrap-mcp-no-match\",\"result\"")).to_equal(true)
        expect(response.contains("No results found.")).to_equal(true)
        expect(response.contains("\"id\":\"bootstrap-mcp-injection\",\"result\"")).to_equal(true)
        expect(response.contains("\"error\"")).to_equal(false)

    it "deployed LSP MCP launcher passes correlated symbols admission":
        # @req REQ-SSPEC-SYSTEM
        step("deployed LSP MCP launcher passes correlated symbols admission")
        val wrapper = file_read("bin/simple_lsp_mcp_server")
        expect(wrapper.contains("native_hash_is_valid")).to_equal(true)
        expect(wrapper.contains("cd \"$\{repo_root}\"")).to_equal(true)
        expect(wrapper.contains("probe_timeout \"$\{SIMPLE_LSP_MCP_NATIVE_PROBE_TIMEOUT:-3}\"")).to_equal(true)
        expect(wrapper.contains("&& ! grep -q '\"id\":\"3\".*\"error\"'")).to_equal(true)
        expect(wrapper.contains("&& ! grep -q '\"id\":\"3\".*\"isError\"'")).to_equal(true)
        expect(wrapper.contains("command failed with exit code")).to_equal(true)
        val initialize = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-lsp-initialize\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"bootstrap\",\"version\":\"1\"}}}"
        val tools_list = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-lsp-tools\",\"method\":\"tools/list\",\"params\":{}}"
        val symbols = "{\"jsonrpc\":\"2.0\",\"id\":\"bootstrap-lsp-symbols\",\"method\":\"tools/call\",\"params\":{\"name\":\"lsp_symbols\",\"arguments\":{\"file\":\"src/app/simple_lsp_mcp/main.spl\"}}}"
        val command = "runner=; if command -v timeout >/dev/null 2>&1; then runner='timeout 10'; elif command -v gtimeout >/dev/null 2>&1; then runner='gtimeout 10'; elif command -v perl >/dev/null 2>&1; then runner=\"perl -e 'alarm shift; exec @ARGV' 10\"; else exit 127; fi; repo_root=\"$(pwd)\"; workdir=\"$(mktemp -d)\"; trap 'rm -rf \"$workdir\"' EXIT; (cd \"$workdir\" && printf '%s\\n%s\\n%s\\n' '" + initialize + "' '" + tools_list + "' '" + symbols + "' | $runner \"$repo_root/bin/simple_lsp_mcp_server\")"
        val (out, err, rc) = process_run("sh", ["-c", command])
        expect(rc).to_equal(0)

    it "bin/simple --version output contains version string":
        val (stdout, _, _) = process_run("bin/simple", ["--version"])
        val has_version = stdout.contains("simple") or stdout.contains("Simple") or stdout.contains("0.")
        expect(has_version).to_equal(true)

    it "bin/simple help returns exit code 0":
        val (stdout, stderr, rc) = process_run("bin/simple", ["help"])
        # help may return 0 or 1 depending on implementation
        val ok = rc == 0 or rc == 1
        expect(ok).to_equal(true)
