"""
## Purpose and audience
Operator scenarios for the production smux service API: independent sessions,
windows, split geometry, resize refusal and client attachment persistence.
Audience: smux maintainers checking tmux-shaped core behavior on Windows.
## Evidence boundary
These scenarios import production API owners directly. They allocate no child
process and prove service state only. Live ConPTY execution is covered separately
by smux_windows_conpty_features_spec.spl. Geometry here does not prove that a
running child receives a terminal-size notification or that a frame is painted.
# @manual: primary
# @capture: text
Plan: doc/03_plan/sys_test/smux_windows_phase3_features.md
"""

# codex-system-test
use std.spec.{describe, it, expect, step}
use os.apps.smux.api.{
    smux_reset_for_test, smux_create_session, smux_list_sessions,
    smux_list_windows, smux_new_window, smux_focus_window, smux_active_window,
    smux_list_panes, smux_split_pane, smux_resize, smux_metrics,
    smux_focus_pane, smux_focused_pane, smux_close_pane,
    smux_attach, smux_detach, smux_send_text, smux_capture
}

# @inline
fn service_session(name: text) -> [text]:
    val session = smux_create_session(name)
    expect(session.id.len()).to_be_greater_than(0)
    val windows = smux_list_windows(session.id)
    expect(windows.len()).to_equal(1)
    val panes = smux_list_panes(session.id, windows[0].id)
    expect(panes.len()).to_equal(1)
    return [session.id, windows[0].id, panes[0].id]

describe "smux production service feature workflows":
    describe "REQ-SMUX-CORE-001: separate session and window ownership":
        it "should keep two sessions and their panes independent":
            # @req REQ-SMUX-CORE-001
            step("Create separate work and monitoring sessions")
            smux_reset_for_test()
            val work = service_session("work")
            val monitor = service_session("monitor")
            expect(smux_list_sessions().len()).to_equal(2)
            expect(work[0] == monitor[0]).to_equal(false)
            step("Splitting work leaves monitoring with its original pane")
            expect(smux_split_pane(work[0], work[1], work[2], "vertical").is_ok()).to_equal(true)
            expect(smux_list_panes(work[0], work[1]).len()).to_equal(2)
            expect(smux_list_panes(monitor[0], monitor[1]).len()).to_equal(1)
            expect(smux_list_panes(monitor[0], monitor[1])[0].id).to_equal(monitor[2])

        it "should switch windows while preserving the other session focus":
            # @req REQ-SMUX-CORE-001
            smux_reset_for_test()
            val work = service_session("work")
            val monitor = service_session("monitor")
            step("Open and focus a second window in work")
            val logs = smux_new_window(work[0], "logs")
            expect(logs.id.len()).to_be_greater_than(0)
            expect(smux_focus_window(work[0], logs.id)).to_equal(true)
            expect(smux_active_window(work[0]).unwrap().id).to_equal(logs.id)
            expect(smux_active_window(monitor[0]).unwrap().id).to_equal(monitor[1])
            step("Return to the initial window without losing either pane")
            expect(smux_focus_window(work[0], work[1])).to_equal(true)
            expect(smux_active_window(work[0]).unwrap().id).to_equal(work[1])
            expect(smux_list_windows(work[0]).len()).to_equal(2)
            expect(smux_list_panes(work[0], logs.id).len()).to_equal(1)

        it "should reject another session's window and pane without mutation":
            # @req REQ-SMUX-CORE-001
            smux_reset_for_test()
            val work = service_session("work")
            val monitor = service_session("monitor")
            step("Address monitoring resources using the work session")
            expect(smux_focus_window(work[0], monitor[1])).to_equal(false)
            expect(smux_split_pane(work[0], monitor[1], monitor[2], "vertical").is_ok()).to_equal(false)
            expect(smux_close_pane(work[0], monitor[1], monitor[2])).to_equal(false)
            expect(smux_capture(work[0], monitor[1], monitor[2], 20).is_ok()).to_equal(false)
            expect(smux_active_window(work[0]).unwrap().id).to_equal(work[1])
            expect(smux_list_panes(monitor[0], monitor[1])[0].id).to_equal(monitor[2])

    describe "REQ-SMUX-CORE-002: split orientation and geometry":
        it "should split columns vertically and retain one separator column":
            # @req REQ-SMUX-CORE-002
            smux_reset_for_test()
            val ids = service_session("columns")
            step("Split an 80 by 24 pane into side by side panes")
            val split = smux_split_pane(ids[0], ids[1], ids[2], "vertical")
            expect(split.is_ok()).to_equal(true)
            val panes = smux_list_panes(ids[0], ids[1])
            expect(panes.len()).to_equal(2)
            expect(panes[0].cols).to_equal(39)
            expect(panes[1].cols).to_equal(40)
            expect(panes[0].rows).to_equal(24)
            expect(panes[1].rows).to_equal(24)
            expect(panes[0].cols + panes[1].cols + 1).to_equal(80)

        it "should split rows horizontally and retain one separator row":
            # @req REQ-SMUX-CORE-002
            smux_reset_for_test()
            val ids = service_session("rows")
            step("Split an 80 by 24 pane into upper and lower panes")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "horizontal").is_ok()).to_equal(true)
            val panes = smux_list_panes(ids[0], ids[1])
            expect(panes.len()).to_equal(2)
            expect(panes[0].rows).to_equal(11)
            expect(panes[1].rows).to_equal(12)
            expect(panes[0].cols).to_equal(80)
            expect(panes[1].cols).to_equal(80)
            expect(panes[0].rows + panes[1].rows + 1).to_equal(24)

        it "should refuse an invalid direction without creating or resizing a pane":
            # @req REQ-SMUX-CORE-002
            smux_reset_for_test()
            val ids = service_session("invalid-direction")
            step("Request an unsupported diagonal split")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "diagonal").is_ok()).to_equal(false)
            val panes = smux_list_panes(ids[0], ids[1])
            expect(panes.len()).to_equal(1)
            expect(panes[0].cols).to_equal(80)
            expect(panes[0].rows).to_equal(24)

        it "should permit the smallest split and refuse an axis smaller than three":
            # @req REQ-SMUX-CORE-002
            smux_reset_for_test()
            val ids = service_session("minimum")
            expect(smux_resize(ids[0], ids[1], ids[2], 3, 2).is_ok()).to_equal(true)
            step("Three columns hold two one column panes and a separator")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "vertical").is_ok()).to_equal(true)
            val panes = smux_list_panes(ids[0], ids[1])
            expect(panes[0].cols).to_equal(1)
            expect(panes[1].cols).to_equal(1)
            step("Two rows cannot hold a horizontal split")
            expect(smux_split_pane(ids[0], ids[1], ids[2], "horizontal").is_ok()).to_equal(false)
            expect(smux_list_panes(ids[0], ids[1]).len()).to_equal(2)

    describe "REQ-SMUX-CORE-003: resize and pane focus":
        it "should resize only the addressed pane and retain focus":
            # @req REQ-SMUX-CORE-003
            smux_reset_for_test()
            val ids = service_session("resize")
            val other = smux_split_pane(ids[0], ids[1], ids[2], "vertical").unwrap()
            expect(smux_focus_pane(ids[0], ids[1], other.id)).to_equal(true)
            step("Resize the selected pane to 100 by 30")
            val resized = smux_resize(ids[0], ids[1], other.id, 100, 30)
            expect(resized.is_ok()).to_equal(true)
            expect(resized.unwrap().cols).to_equal(100)
            expect(resized.unwrap().rows).to_equal(30)
            expect(smux_list_panes(ids[0], ids[1])[0].cols).to_equal(39)
            expect(smux_focused_pane(ids[0], ids[1]).unwrap().id).to_equal(other.id)
            expect(smux_metrics().resize_count).to_equal(1)

        it "should refuse zero and negative sizes without changing dimensions or metrics":
            # @req REQ-SMUX-CORE-003
            smux_reset_for_test()
            val ids = service_session("invalid-size")
            step("Request invalid terminal dimensions")
            expect(smux_resize(ids[0], ids[1], ids[2], 0, 24).is_ok()).to_equal(false)
            expect(smux_resize(ids[0], ids[1], ids[2], 80, -1).is_ok()).to_equal(false)
            val pane = smux_list_panes(ids[0], ids[1])[0]
            expect(pane.cols).to_equal(80)
            expect(pane.rows).to_equal(24)
            expect(smux_metrics().resize_count).to_equal(0)

        it "should reject an unknown pane and preserve the existing focus":
            # @req REQ-SMUX-CORE-003
            smux_reset_for_test()
            val ids = service_session("unknown")
            step("Address a pane that does not exist")
            expect(smux_focus_pane(ids[0], ids[1], "missing")).to_equal(false)
            expect(smux_resize(ids[0], ids[1], "missing", 100, 30).is_ok()).to_equal(false)
            expect(smux_focused_pane(ids[0], ids[1]).unwrap().id).to_equal(ids[2])
            expect(smux_metrics().resize_count).to_equal(0)

    describe "REQ-SMUX-CORE-004: client attachment persistence":
        it "should reject invalid attachments without consuming a client slot":
            # @req REQ-SMUX-CORE-004
            smux_reset_for_test()
            val ids = service_session("admission")
            step("Refuse unknown sessions, empty client ids and invalid dimensions")
            expect(smux_attach("missing", "bad-session", 80, 24).attached).to_equal(false)
            expect(smux_attach(ids[0], "", 80, 24).attached).to_equal(false)
            expect(smux_attach(ids[0], "bad-size", 0, 24).attached).to_equal(false)
            expect(smux_attach(ids[0], "bad-rows", 80, -1).attached).to_equal(false)
            step("All four real client slots remain available")
            expect(smux_attach(ids[0], "a", 80, 24).attached).to_equal(true)
            expect(smux_attach(ids[0], "b", 80, 24).attached).to_equal(true)
            expect(smux_attach(ids[0], "c", 80, 24).attached).to_equal(true)
            expect(smux_attach(ids[0], "d", 80, 24).attached).to_equal(true)
            expect(smux_attach(ids[0], "overflow", 80, 24).attached).to_equal(false)
            expect(smux_detach("overflow")).to_equal(false)
            expect(smux_detach("b")).to_equal(true)
            expect(smux_attach(ids[0], "replacement", 80, 24).attached).to_equal(true)
            expect(smux_detach("a")).to_equal(true)
            expect(smux_detach("c")).to_equal(true)
            expect(smux_detach("d")).to_equal(true)

        it "should rebind an existing client to a different session and geometry":
            # @req REQ-SMUX-CORE-004
            smux_reset_for_test()
            val first = service_session("first")
            val second = service_session("second")
            expect(smux_attach(first[0], "screen", 80, 24).attached).to_equal(true)
            expect(smux_attach(first[0], "other-a", 80, 24).attached).to_equal(true)
            expect(smux_attach(first[0], "other-b", 80, 24).attached).to_equal(true)
            expect(smux_attach(first[0], "other-c", 80, 24).attached).to_equal(true)
            step("With all four slots occupied the same client changes session and size")
            val rebound = smux_attach(second[0], "screen", 132, 43)
            expect(rebound.attached).to_equal(true)
            expect(rebound.session_id).to_equal(second[0])
            expect(rebound.cols).to_equal(132)
            expect(rebound.rows).to_equal(43)
            expect(smux_attach(second[0], "fifth", 80, 24).attached).to_equal(false)
            step("An invalid rebind preserves the existing valid attachment")
            expect(smux_attach("missing", "screen", 80, 24).attached).to_equal(false)
            expect(smux_detach("screen")).to_equal(true)
            expect(smux_detach("screen")).to_equal(false)
            expect(smux_detach("other-a")).to_equal(true)
            expect(smux_detach("other-a")).to_equal(false)
            expect(smux_detach("other-b")).to_equal(true)
            expect(smux_detach("other-b")).to_equal(false)
            expect(smux_detach("other-c")).to_equal(true)
            expect(smux_detach("other-c")).to_equal(false)
            expect(smux_list_panes(first[0], first[1])[0].id).to_equal(first[2])
            expect(smux_list_panes(second[0], second[1])[0].id).to_equal(second[2])

        it "should allow two clients and detach each independently":
            # @req REQ-SMUX-CORE-004
            smux_reset_for_test()
            val ids = service_session("shared")
            step("Attach two clients at different screen dimensions")
            val first = smux_attach(ids[0], "screen-a", 80, 24)
            val second = smux_attach(ids[0], "screen-b", 120, 40)
            expect(first.attached).to_equal(true)
            expect(second.attached).to_equal(true)
            expect(second.cols).to_equal(120)
            expect(second.rows).to_equal(40)
            step("Detach each attachment independently")
            expect(smux_detach("screen-a")).to_equal(true)
            expect(smux_detach("screen-b")).to_equal(true)
            expect(smux_list_panes(ids[0], ids[1])[0].id).to_equal(ids[2])

        it "should reattach after every client leaves and preserve session resources":
            # @req REQ-SMUX-CORE-004
            smux_reset_for_test()
            val ids = service_session("persistent")
            expect(smux_attach(ids[0], "first", 80, 24).attached).to_equal(true)
            expect(smux_detach("first")).to_equal(true)
            step("Reattach the same session from a new client")
            val returned = smux_attach(ids[0], "returned", 132, 43)
            expect(returned.session_id).to_equal(ids[0])
            expect(returned.attached).to_equal(true)
            expect(smux_list_windows(ids[0])[0].id).to_equal(ids[1])
            expect(smux_list_panes(ids[0], ids[1])[0].id).to_equal(ids[2])
            expect(smux_list_sessions().len()).to_equal(1)

        it "should refuse repeated detach and refuse input without a child":
            # @req REQ-SMUX-CORE-004
            smux_reset_for_test()
            val ids = service_session("no-child")
            expect(smux_attach(ids[0], "client", 80, 24).attached).to_equal(true)
            expect(smux_detach("client")).to_equal(true)
            step("A missing attachment and absent child fail explicitly")
            expect(smux_detach("client")).to_equal(false)
            expect(smux_send_text(ids[0], ids[1], ids[2], "echo fabricated").is_ok()).to_equal(false)
            val captured = smux_capture(ids[0], ids[1], ids[2], 20)
            expect(captured.is_ok()).to_equal(true)
            expect(captured.unwrap().content).to_equal("")
