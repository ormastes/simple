        step("Verify: tx_buffer is empty after create")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        expect(serial.tx_buffer.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "rx_buffer is empty after create":
        step("Verify: rx_buffer is empty after create")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        expect(serial.rx_buffer.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "irq matches constructor arg":
        step("Verify: irq matches constructor arg")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        expect(serial.irq).to_equal(10)  # oracle: value fixed by the spec contract

    it "no pending irq after create":
        step("Verify: no pending irq after create")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        expect(serial.pending_irq()).to_equal(-1)  # oracle: value fixed by the spec contract

# ============================================================================
# VirtualSerial — mmio_write TX
# ============================================================================

describe "VirtualSerial mmio_write TX":
    it "write byte to offset 0x00 appends to tx_buffer":
        step("Verify: write byte to offset 0x00 appends to tx_buffer")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.mmio_write(0x00, 0x41, 1)
        expect(serial.tx_buffer.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "written byte value is in tx_buffer":
        step("Verify: written byte value is in tx_buffer")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.mmio_write(0x00, 0x41, 1)
        expect(serial.tx_buffer[0]).to_equal(0x41)

    it "multiple writes accumulate in tx_buffer":
        step("Verify: multiple writes accumulate in tx_buffer")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.mmio_write(0x00, 0x41, 1)
        serial.mmio_write(0x00, 0x42, 1)
        expect(serial.tx_buffer.len()).to_equal(2)  # oracle: value fixed by the spec contract

# ============================================================================
# VirtualSerial — mmio_read RX
# ============================================================================

describe "VirtualSerial mmio_read RX":
    it "reading offset 0x00 with no input returns 0":
        step("Verify: reading offset 0x00 with no input returns 0")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        val result = serial.mmio_read(0x00, 1)
        val byte_val = match result:
            case Ok(v): v
            case Err(_): -1
        expect(byte_val).to_equal(0)  # oracle: value fixed by the spec contract

    it "inject_input then read returns injected byte":
        step("Verify: inject_input then read returns injected byte")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.inject_input([0x48])
        val result = serial.mmio_read(0x00, 1)
        val byte_val = match result:
            case Ok(v): v
            case Err(_): -1
        expect(byte_val).to_equal(0x48)

    it "second inject_input byte readable after first consumed":
        step("Verify: second inject_input byte readable after first consumed")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.inject_input([0x41, 0x42])
        serial.mmio_read(0x00, 1)
        val result = serial.mmio_read(0x00, 1)
        val byte_val = match result:
            case Ok(v): v
            case Err(_): -1
        expect(byte_val).to_equal(0x42)

# ============================================================================
# VirtualSerial — get_output
# ============================================================================

describe "VirtualSerial get_output":
    it "get_output contains H from byte 72":
        step("Verify: get_output contains H from byte 72")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.mmio_write(0x00, 72, 1)   # H
        val out = serial.get_output()
        expect(out).to_contain("H")

    it "get_output contains Hello from bytes 72 101 108 108 111":
        step("Verify: get_output contains Hello from bytes 72 101 108 108 111")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        serial.mmio_write(0x00, 72, 1)   # H
        serial.mmio_write(0x00, 101, 1)  # e
        serial.mmio_write(0x00, 108, 1)  # l
        serial.mmio_write(0x00, 108, 1)  # l
        serial.mmio_write(0x00, 111, 1)  # o
        val out = serial.get_output()
        expect(out).to_contain("Hello")

    it "get_output is empty string when nothing written":
        step("Verify: get_output is empty string when nothing written")
        # @req: REQ-TOOLS-ReplVmDevi-001
        var serial = VirtualSerial.create("uart0", 10)
        val out = serial.get_output()
        expect(out).to_equal("")

