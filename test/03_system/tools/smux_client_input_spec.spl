"""
Interactive client default input decoder: pure state/action protocol only.
Controller execution, terminal reads, clipboard and visible screens require
separate live evidence. No test substitutes a process or terminal provider.
# @manual: primary
Execution and docgen pending TEST_BLOCKED.
"""
use std.spec.{describe, it, expect, step}
use os.apps.smux.client_input.{client_input_new, client_input_feed}
use std.common.text_bytes.{text_to_bytes, bytes_to_text}

describe "smux interactive default key state machine":
    it "should forward ordinary Unicode CR Ctrl-C and escape text exactly":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Feed literal shell input through the production decoder")
        val input = "echo 界😀\r\x03\x1b[A"
        val decoded = client_input_feed(client_input_new(), input)
        expect(decoded.state.prefix).to_equal(false)
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(input)

    it "should retain a prefix across chunks before detaching":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Read Ctrl-B separately from its detach binding")
        val first = client_input_feed(client_input_new(), "\x02")
        expect(first.state.prefix).to_equal(true)
        expect(first.actions.len()).to_equal(0)
        val second = client_input_feed(first.state, "d")
        expect(second.state.prefix).to_equal(false)
        expect(second.actions.len()).to_equal(1)
        expect(second.actions[0].kind).to_equal("detach")
        expect(second.actions[0].data).to_equal("")

    it "should preserve input ordering around a split binding in another chunk":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Buffer a trailing prefix after earlier shell input")
        val first = client_input_feed(client_input_new(), "before\x02")
        expect(first.state.prefix).to_equal(true)
        expect(first.actions.len()).to_equal(1)
        expect(first.actions[0].data).to_equal("before")
        step("Decode the split before forwarding subsequent text")
        val second = client_input_feed(first.state, "%after")
        expect(second.actions.len()).to_equal(2)
        expect(second.actions[0].kind).to_equal("split-vertical")
        expect(second.actions[1].kind).to_equal("input")
        expect(second.actions[1].data).to_equal("after")

    it "should map percent to columns and double quote to rows":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode both split directions without executing either effect")
        val decoded = client_input_feed(client_input_new(), "\x02%\x02\"")
        expect(decoded.actions.len()).to_equal(2)
        expect(decoded.actions[0].kind).to_equal("split-vertical")
        expect(decoded.actions[1].kind).to_equal("split-horizontal")
        expect(decoded.actions[0].data).to_equal("")
        expect(decoded.actions[1].data).to_equal("")

    it "should decode window pane layout and copy mode bindings in order":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode the complete default navigation and layout binding sequence")
        val decoded = client_input_feed(client_input_new(), "\x02c\x02n\x02o\x02 \x02[")
        val expected = ["new-window", "next-window", "next-pane", "cycle-layout", "copy-mode"]
        expect(decoded.actions.len()).to_equal(expected.len())
        var i = 0
        while i < expected.len():
            expect(decoded.actions[i].kind).to_equal(expected[i])
            expect(decoded.actions[i].data).to_equal("")
            i = i + 1
        expect(decoded.state.prefix).to_equal(false)

    it "should forward a doubled prefix as one literal Ctrl-B":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Quote Ctrl-B inside surrounding child input")
        val decoded = client_input_feed(client_input_new(), "left\x02\x02right")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal("left\x02right")
        expect(decoded.state.prefix).to_equal(false)

    it "should forward unknown bindings with their original prefix":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode an unsupported prefix binding transparently")
        val decoded = client_input_feed(client_input_new(), "left\x02zright")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal("left\x02zright")

    it "should retain a pending prefix across an empty read chunk":
        # @req REQ-SMUX-INTERACTIVE-001
        val first = client_input_feed(client_input_new(), "\x02")
        step("An empty text chunk must not discard an incomplete binding")
        val empty = client_input_feed(first.state, "")
        expect(empty.state.prefix).to_equal(true)
        expect(empty.actions.len()).to_equal(0)
        val completed = client_input_feed(empty.state, "o")
        expect(completed.actions.len()).to_equal(1)
        expect(completed.actions[0].kind).to_equal("next-pane")

    it "should keep prior decoder state immutable when completing a binding":
        # @req REQ-SMUX-INTERACTIVE-001
        val first = client_input_feed(client_input_new(), "\x02")
        step("Derive a completed binding without changing its input state")
        val completed = client_input_feed(first.state, "n")
        expect(first.state.prefix).to_equal(true)
        expect(completed.state.prefix).to_equal(false)
        expect(completed.actions[0].kind).to_equal("next-window")

    it "should preserve Unicode text and unknown Unicode bindings across text chunks":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Forward complete UTF-8 text values from separate reads")
        val first = client_input_feed(client_input_new(), "界\x02")
        val second = client_input_feed(first.state, "😀é")
        expect(first.actions.len()).to_equal(1)
        expect(first.actions[0].data).to_equal("界")
        expect(second.actions.len()).to_equal(1)
        expect(second.actions[0].kind).to_equal("input")
        expect(second.actions[0].data).to_equal("\x02😀é")
        expect(second.state.prefix).to_equal(false)

    it "should emit copy navigation and exit actions without assuming clipboard effects":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode the smux prefixed copy navigation defaults")
        val decoded = client_input_feed(client_input_new(), "\x02k\x02j\x02q")
        expect(decoded.actions.len()).to_equal(3)
        expect(decoded.actions[0].kind).to_equal("copy-up")
        expect(decoded.actions[1].kind).to_equal("copy-down")
        expect(decoded.actions[2].kind).to_equal("copy-exit")
        expect(decoded.state.prefix).to_equal(false)

    it "should leave plain copy navigation keys for the controller to interpret":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Keep copy mode policy outside the prefix-only decoder state")
        val input = "q\x1b[A\x1b[B\x1b[5~\x1b[6~\x1b"
        val decoded = client_input_feed(client_input_new(), input)
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(input)

    it "should keep three consecutive prefix bytes as a literal and pending prefix":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode a quoted prefix followed by a new unfinished binding")
        val decoded = client_input_feed(client_input_new(), "\x02\x02\x02")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].data).to_equal("\x02")
        expect(decoded.state.prefix).to_equal(true)
        val next = client_input_feed(decoded.state, "d")
        expect(next.actions[0].kind).to_equal("detach")

    it "should preserve UTF-8 byte fragments split inside a scalar":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("界😀")
        step("Feed actual raw-copy text fragments from inside a UTF-8 encoding")
        val first = client_input_feed(client_input_new(), bytes_to_text(bytes[0:1]))
        val second = client_input_feed(first.state, bytes_to_text(bytes[1:5]))
        val third = client_input_feed(second.state, bytes_to_text(bytes[5:]))
        expect(first.actions.len()).to_equal(1)
        expect(second.actions.len()).to_equal(1)
        expect(third.actions.len()).to_equal(1)
        expect(text_to_bytes(first.actions[0].data)).to_equal(bytes[0:1])
        expect(text_to_bytes(second.actions[0].data)).to_equal(bytes[1:5])
        expect(text_to_bytes(third.actions[0].data)).to_equal(bytes[5:])
        val assembled = first.actions[0].data + second.actions[0].data + third.actions[0].data
        expect(assembled).to_equal("界😀")

    it "should forward a prefixed unknown binding split inside its Unicode scalar":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("😀")
        val prefix = client_input_feed(client_input_new(), "\x02")
        step("Resolve an unknown non-ASCII binding without decoding partial UTF-8")
        val first = client_input_feed(prefix.state, bytes_to_text(bytes[0:1]))
        val second = client_input_feed(first.state, bytes_to_text(bytes[1:]))
        expect(first.state.prefix).to_equal(false)
        expect(text_to_bytes(first.actions[0].data)).to_equal([2, 240])
        expect(text_to_bytes(second.actions[0].data)).to_equal([159, 152, 128])
        expect(first.actions[0].data + second.actions[0].data).to_equal("\x02😀")
