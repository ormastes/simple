# @cover src/os/apps/smux/client_input.spl 80%
# @cover src/lib/common/text_bytes.spl 80%
"""
Interactive client default input decoder: pure state/action protocol only.
Controller execution, terminal reads, clipboard and visible screens require
separate live evidence. No test substitutes a process or terminal provider.
# @manual: primary
Execution and docgen pending TEST_BLOCKED.
"""
use std.spec.{describe, it, expect, step}
use os.apps.smux.client_input.{ClientInputState, ClientInputStep, client_input_new, client_input_feed}
use os.apps.smux.client_view.{client_input_wire_split}
use std.common.text_bytes.{text_to_bytes, bytes_to_text}

fn feed_text(state: ClientInputState, input: text) -> ClientInputStep:
    return client_input_feed(state, text_to_bytes(input))

fn joined_bytes(parts: [[u8]]) -> [u8]:
    var out: [u8] = []
    for part in parts:
        for byte in part: out.push(byte)
    return out

describe "smux interactive default key state machine":
    it "should forward ordinary Unicode CR Ctrl-C and escape text exactly":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Feed literal shell input through the production decoder")
        val input = "echo 界😀\r\x03\x1b[A"
        val decoded = feed_text(client_input_new(), input)
        expect(decoded.state.prefix).to_equal(false)
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(text_to_bytes(input))

    it "should retain a prefix across chunks before detaching":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Read Ctrl-B separately from its detach binding")
        val first = feed_text(client_input_new(), "\x02")
        expect(first.state.prefix).to_equal(true)
        expect(first.actions.len()).to_equal(0)
        val second = feed_text(first.state, "d")
        expect(second.state.prefix).to_equal(false)
        expect(second.actions.len()).to_equal(1)
        expect(second.actions[0].kind).to_equal("detach")
        expect(second.actions[0].data.len()).to_equal(0)

    it "should preserve input ordering around a split binding in another chunk":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Buffer a trailing prefix after earlier shell input")
        val first = feed_text(client_input_new(), "before\x02")
        expect(first.state.prefix).to_equal(true)
        expect(first.actions.len()).to_equal(1)
        expect(first.actions[0].data).to_equal(text_to_bytes("before"))
        step("Decode the split before forwarding subsequent text")
        val second = feed_text(first.state, "%after")
        expect(second.actions.len()).to_equal(2)
        expect(second.actions[0].kind).to_equal("split-vertical")
        expect(second.actions[1].kind).to_equal("input")
        expect(second.actions[1].data).to_equal(text_to_bytes("after"))

    it "should map percent to columns and double quote to rows":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode both split directions without executing either effect")
        val decoded = feed_text(client_input_new(), "\x02%\x02\"")
        expect(decoded.actions.len()).to_equal(2)
        expect(decoded.actions[0].kind).to_equal("split-vertical")
        expect(decoded.actions[1].kind).to_equal("split-horizontal")
        expect(decoded.actions[0].data.len()).to_equal(0)
        expect(decoded.actions[1].data.len()).to_equal(0)

    it "should decode window pane layout and copy mode bindings in order":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode the complete default navigation and layout binding sequence")
        val decoded = feed_text(client_input_new(), "\x02c\x02n\x02o\x02 \x02[")
        val expected = ["new-window", "next-window", "next-pane", "cycle-layout", "copy-mode"]
        expect(decoded.actions.len()).to_equal(expected.len())
        var i = 0
        while i < expected.len():
            expect(decoded.actions[i].kind).to_equal(expected[i])
            expect(decoded.actions[i].data.len()).to_equal(0)
            i = i + 1
        expect(decoded.state.prefix).to_equal(false)

    it "should forward a doubled prefix as one literal Ctrl-B":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Quote Ctrl-B inside surrounding child input")
        val decoded = feed_text(client_input_new(), "left\x02\x02right")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(text_to_bytes("left\x02right"))
        expect(decoded.state.prefix).to_equal(false)

    it "should forward unknown bindings with their original prefix":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode an unsupported prefix binding transparently")
        # `z` is the bound toggle-zoom key since window zoom landed; `y` is unbound.
        val decoded = feed_text(client_input_new(), "left\x02yright")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(text_to_bytes("left\x02yright"))

    it "should retain a pending prefix across an empty read chunk":
        # @req REQ-SMUX-INTERACTIVE-001
        val first = feed_text(client_input_new(), "\x02")
        step("An empty text chunk must not discard an incomplete binding")
        val empty = feed_text(first.state, "")
        expect(empty.state.prefix).to_equal(true)
        expect(empty.actions.len()).to_equal(0)
        val completed = feed_text(empty.state, "o")
        expect(completed.actions.len()).to_equal(1)
        expect(completed.actions[0].kind).to_equal("next-pane")

    it "should keep prior decoder state immutable when completing a binding":
        # @req REQ-SMUX-INTERACTIVE-001
        val first = feed_text(client_input_new(), "\x02")
        step("Derive a completed binding without changing its input state")
        val completed = feed_text(first.state, "n")
        expect(first.state.prefix).to_equal(true)
        expect(completed.state.prefix).to_equal(false)
        expect(completed.actions[0].kind).to_equal("next-window")

    it "should preserve Unicode text and unknown Unicode bindings across text chunks":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Forward complete UTF-8 text values from separate reads")
        val first = feed_text(client_input_new(), "界\x02")
        val second = feed_text(first.state, "😀é")
        expect(first.actions.len()).to_equal(1)
        expect(first.actions[0].data).to_equal(text_to_bytes("界"))
        expect(second.actions.len()).to_equal(1)
        expect(second.actions[0].kind).to_equal("input")
        expect(second.actions[0].data).to_equal(text_to_bytes("\x02😀é"))
        expect(second.state.prefix).to_equal(false)

    it "should emit copy navigation and exit actions without assuming clipboard effects":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode the smux prefixed copy navigation defaults")
        val decoded = feed_text(client_input_new(), "\x02k\x02j\x02q")
        expect(decoded.actions.len()).to_equal(3)
        expect(decoded.actions[0].kind).to_equal("copy-up")
        expect(decoded.actions[1].kind).to_equal("copy-down")
        expect(decoded.actions[2].kind).to_equal("copy-exit")
        expect(decoded.state.prefix).to_equal(false)

    it "should leave plain copy navigation keys for the controller to interpret":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Keep copy mode policy outside the prefix-only decoder state")
        val input = "q\x1b[A\x1b[B\x1b[5~\x1b[6~\x1b"
        val decoded = feed_text(client_input_new(), input)
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].kind).to_equal("input")
        expect(decoded.actions[0].data).to_equal(text_to_bytes(input))

    it "should keep three consecutive prefix bytes as a literal and pending prefix":
        # @req REQ-SMUX-INTERACTIVE-001
        step("Decode a quoted prefix followed by a new unfinished binding")
        val decoded = feed_text(client_input_new(), "\x02\x02\x02")
        expect(decoded.actions.len()).to_equal(1)
        expect(decoded.actions[0].data).to_equal(text_to_bytes("\x02"))
        expect(decoded.state.prefix).to_equal(true)
        val next = feed_text(decoded.state, "d")
        expect(next.actions[0].kind).to_equal("detach")

    it "should preserve UTF-8 byte fragments split inside a scalar":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("界😀")
        step("Feed raw read chunks split inside a UTF-8 encoding")
        val first = client_input_feed(client_input_new(), bytes[0:1])
        val second = client_input_feed(first.state, bytes[1:5])
        val third = client_input_feed(second.state, bytes[5:])
        expect(first.actions.len()).to_equal(1)
        expect(second.actions.len()).to_equal(1)
        expect(third.actions.len()).to_equal(1)
        expect(first.actions[0].data).to_equal(bytes[0:1])
        expect(second.actions[0].data).to_equal(bytes[1:5])
        expect(third.actions[0].data).to_equal(bytes[5:])
        val assembled = joined_bytes([first.actions[0].data, second.actions[0].data, third.actions[0].data])
        expect(assembled).to_equal(bytes)
        expect(bytes_to_text(assembled)).to_equal("界😀")

    it "should forward a prefixed unknown binding split inside its Unicode scalar":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("😀")
        val prefix = feed_text(client_input_new(), "\x02")
        step("Resolve an unknown non-ASCII binding without decoding partial UTF-8")
        val first = client_input_feed(prefix.state, bytes[0:1])
        val second = client_input_feed(first.state, bytes[1:])
        expect(first.state.prefix).to_equal(false)
        expect(first.actions[0].data).to_equal([2u8, 240u8])
        expect(second.actions[0].data).to_equal([159u8, 152u8, 128u8])
        expect(bytes_to_text(joined_bytes([first.actions[0].data, second.actions[0].data]))).to_equal("\x02😀")

    it "should flush a split scalar as input before a later binding takes effect":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("界")
        step("Split one scalar across three reads, the last ending in a prefix")
        val first = client_input_feed(client_input_new(), bytes[0:1])
        val second = client_input_feed(first.state, bytes[1:2])
        val third = client_input_feed(second.state, joined_bytes([bytes[2:], [2u8]]))
        val detach = feed_text(third.state, "d")
        expect(third.state.prefix).to_equal(true)
        expect(third.actions.len()).to_equal(1)
        expect(joined_bytes([first.actions[0].data, second.actions[0].data, third.actions[0].data])).to_equal(bytes)
        expect(detach.actions[0].kind).to_equal("detach")

    it "should frame split scalars so every wire chunk is complete UTF-8":
        # @req REQ-SMUX-INTERACTIVE-001
        val bytes = text_to_bytes("a界😀")
        step("Hold an incomplete tail back from the complete-UTF-8 input wire")
        val first = client_input_wire_split([], bytes[0:2])
        expect(first.0).to_equal(bytes[0:1])
        expect(first.1).to_equal(bytes[1:2])
        val second = client_input_wire_split(first.1, bytes[2:6])
        expect(second.0).to_equal(bytes[1:4])
        expect(second.1).to_equal(bytes[4:6])
        val third = client_input_wire_split(second.1, bytes[6:])
        expect(third.1.len()).to_equal(0)
        expect(joined_bytes([first.0, second.0, third.0])).to_equal(bytes)
        step("Never hold bytes that can no longer become a scalar")
        val stray = client_input_wire_split([], [97u8, 255u8])
        expect(stray.0).to_equal([97u8, 255u8])
        expect(stray.1.len()).to_equal(0)
