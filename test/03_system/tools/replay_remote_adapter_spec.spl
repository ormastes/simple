# @cover src/lib/nogc_sync_mut/replay/adapters/remote_replay.spl 60%
# System tests for the RemoteReplayAdapter layer.
#
# Verifies mode enum, adapter creation, event recording via on_register_read
# and on_step_complete, and event counting.
#
# **Feature IDs:** #REPLAY-REMOTE-001 to #REPLAY-REMOTE-005
# **Category:** System / Replay Adapters

"""
## Purpose and audience
Purpose: Off mode to_text returns off
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplRemoAdap-001

use std.replay.adapters.remote_replay.RemoteReplayMode
use std.replay.adapters.remote_replay.RemoteReplayAdapter
use std.replay.adapters.remote_replay.RemoteReplayEvent
use std.spec

use std.spec.step
describe "RemoteReplayAdapter":

    describe "RemoteReplayMode":
        it "Off mode to_text returns off":
            step("Verify: Off mode to_text returns off")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val m = RemoteReplayMode::Off
            expect(m.to_text()).to_equal("off")

        it "Record mode to_text returns record":
            step("Verify: Record mode to_text returns record")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val m = RemoteReplayMode::Record
            expect(m.to_text()).to_equal("record")

    describe "RemoteReplayAdapter lifecycle":
        it "create Off mode has zero events":
            step("Verify: create Off mode has zero events")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val adapter = RemoteReplayAdapter::create(RemoteReplayMode::Off)
            expect(adapter.event_count()).to_equal(0)  # oracle: value fixed by the spec contract

        it "create Record mode stores mode":
            step("Verify: create Record mode stores mode")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val adapter = RemoteReplayAdapter::create(RemoteReplayMode::Record)
            expect(adapter.mode.to_text()).to_equal("record")

        it "on_register_read in Record mode logs one event":
            step("Verify: on_register_read in Record mode logs one event")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val adapter = RemoteReplayAdapter::create(RemoteReplayMode::Record)
            adapter.on_register_read("pc", 0x1000)
            expect(adapter.event_count()).to_equal(1)  # oracle: value fixed by the spec contract

        it "on_step_complete in Record mode logs event":
            step("Verify: on_step_complete in Record mode logs event")
            # @req: REQ-TOOLS-ReplRemoAdap-001
            val adapter = RemoteReplayAdapter::create(RemoteReplayMode::Record)
            adapter.on_step_complete(0x2000, "main.spl", 10)
            expect(adapter.event_count()).to_equal(1)  # oracle: value fixed by the spec contract
