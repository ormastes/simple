# Live terminal-grid capture (E7-live): closes the fixture-only gap flagged
# in `interactive_surface_manual_spec.spl`'s HONESTY NOTE and tracked in
# `doc/08_tracking/todo/sspec_live_capture_infrastructure_2026-08-08.md`.
#
# That TODO originally proposed `SgttiTestDriver` as the live-TUI capture
# path. Research (2026-08-08) found that assumption wrong: `SgttiTestDriver`
# (`src/lib/nogc_sync_mut/ui_test/sgtti.spl`) is an in-process snapshot of an
# already-built `WinTextSnapshot`/`Compositor` state — it never launches an
# OS process or reads a real terminal. The correct, already-proven pattern
# for "capture from something actually running" in this codebase is
# `process_run` (used by `format/exec_capture.spl`, the system's first live
# provider) — a real process's real stdout rows fed into
# `terminal_snapshot_from_rows`, exactly as a real terminal-scraping capture
# provider would populate the same struct a fixture builds by hand.
#
# This is deliberately the smallest real slice: a real subprocess (`printf`)
# whose stdout becomes the terminal rows, not a constructed `[text]` literal.
# It does not claim to solve interactive/live TUI driving (keystrokes,
# settling, redraw) — that remains open per the TODO's per-domain scoping.
#
# @manual_section Live terminal capture (proof of the real-vs-fixture path)
# @req REQ-TODO-ADD-001
#
# ## Purpose and audience
# Audience: TUI/test-infrastructure developers. Purpose: prove the smallest
# real live-capture slice: a real subprocess stdout becomes TerminalSnapshot
# rows checked through the typed-evidence comparator, closing the
# fixture-only gap in interactive_surface_manual_spec.spl.

use std.spec.*
use std.nogc_sync_mut.sffi.system.{process_run}
use std.common.spec.evidence.format.terminal_grid.{
    TerminalRegion,
    terminal_snapshot_from_rows, terminal_snapshot_to_evidence
}
use std.common.spec.evidence.model.{EvidenceStatus, oracle_spec, check_exact}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

describe "live terminal-grid capture via a real subprocess":
    it "converts real printf stdout into a TerminalSnapshot and asserts on it through the typed-evidence comparator":
        # @req: REQ-TODO-ADD-001
        step("Capture real subprocess stdout as terminal rows")
        val (stdout, stderr, code) = process_run("printf", ["Todo App\\n\\n[ ] Ship release\\n"])
        expect(code).to_equal(0)

        val rows = stdout.split("\n")
        var snapshot = terminal_snapshot_from_rows(rows, 40)
        snapshot.semantic_regions = [
            TerminalRegion(node_id: "main#task_list", row: 2, col: 0, width: 16, height: 1)
        ]

        val evidence = terminal_snapshot_to_evidence(snapshot, "live_terminal_capture/printf-todo-screen")
        val comparison = compare_evidence(evidence, oracle_spec("live_terminal_capture/printf-todo-screen", [
            check_exact("terminal.columns", "40"),
            check_exact("terminal.rows", "4"),
            check_exact("terminal.width_profile", "explicit-table-v1"),
            check_exact("main#task_list", "[ ] Ship release")
        ]))
        expect(comparison.status).to_equal(EvidenceStatus.passed)
