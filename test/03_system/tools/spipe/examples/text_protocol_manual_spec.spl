# Modern SSpec reference example: text protocol evidence (E8b).
#
# ## Purpose and audience
# Audience: protocol/backend developers and QA. Purpose: demonstrate text
# protocol evidence end to end (frame adapter -> comparator -> QA manual
# table) on a project-listing request/response, with fixtures until a live
# service capture exists.
#
# @manual_section Listing projects
# @req REQ-SIMPLE-LIST-001

"""
A client asks a project-listing server for the current set of projects and
the server replies with a status line and one line per project name.

The request/response frames below are constructed fixtures that demonstrate
the typed-evidence contract end to end (format adapter -> comparator ->
manual projection). They are hand-built strings, not a live capture from a
running server or socket — no real "Simple List" service was driven to
produce them.
"""

use std.spec.*

use std.common.spec.evidence.model.{
    check_exact, check_full_pattern, check_ignore, check_multiset,
    check_bind, check_same_as, oracle_spec, EvidenceAudience
}
use std.common.spec.evidence.evidence_comparator.{
    compare_evidence, comparison_to_manual_blocks
}
use std.common.spec.evidence.format.text_protocol.{
    ProtocolDirection, ProtocolFrame, ProtocolTrace,
    protocol_frame, protocol_trace,
    trace_to_evidence, protocol_transcript_lines
}
use std.common.spec.evidence.manual_render.{render_blocks}

fn sample_request() -> text:
    "LIST /projects HTTP/1.1\r\n" +
    "Accept: text/plain\r\n" +
    "Correlation-Id: 4C73A91801D58F22\r\n" +
    "\r\n"

fn sample_response() -> text:
    "HTTP/1.1 200 OK\r\n" +
    "Request-Id: 4C73A91801D58F22\r\n" +
    "Date: Sat, 08 Aug 2026 00:00:00 GMT\r\n" +
    "Count: 2\r\n" +
    "Correlation-Id: 4C73A91801D58F22\r\n" +
    "\r\n" +
    "beta\r\n" +
    "alpha\r\n"

fn malformed_response() -> text:
    # No blank-line separator between the headers and the body: the header
    # section never closes, so the parser must reject this rather than guess
    # where headers end and the body begins.
    "HTTP/1.1 200 OK\r\n" +
    "Request-Id: 4C73A91801D58F22\r\n" +
    "beta\r\n"

fn sample_trace() -> ProtocolTrace:
    protocol_trace(
        "text",
        "conn-1",
        [
            protocol_frame(0, ProtocolDirection.client_to_server, "conn-1", "4C73A91801D58F22", sample_request(), "simple-list/1"),
            protocol_frame(1, ProtocolDirection.server_to_client, "conn-1", "4C73A91801D58F22", sample_response(), "simple-list/1")
        ]
    )

fn simple_list_oracle():
    oracle_spec(
        "simple-list/1",
        [
            check_exact("request.start_line", "LIST /projects HTTP/1.1"),
            check_exact("request.headers.accept", "text/plain"),
            check_bind("request.headers.correlation-id", "request_id"),
            check_exact("response.start_line", "HTTP/1.1 200 OK"),
            check_exact("response.status", "200"),
            check_full_pattern("response.headers.request-id", "hex:16"),
            check_ignore("response.headers.date", "server clock, not a stable value across runs"),
            check_exact("response.headers.count", "2"),
            check_same_as("response.headers.correlation-id", "request_id"),
            check_multiset("response.body.lines", ["alpha", "beta"])
        ]
    )

describe "Simple List protocol":
    """
    A client requests the current project list. The server returns a success
    status and one line per project.
    """

    it "returns the project list and preserves request correlation":
        # @req: REQ-SIMPLE-LIST-001
        step("Request the project list")
        val trace = sample_trace()
        val evidence = trace_to_evidence(trace, "simple-list/1")
        expect(evidence.parse_ok).to_equal(true)

        step("Verify the server returns the available projects")
        val result = compare_evidence(evidence, simple_list_oracle())
        expect(result.summary).to_equal("9 check(s) passed")

    it "fails a malformed response rather than partially parsing it":
        step("Attempt to parse a response with no blank-line separator")
        val bad_trace = protocol_trace(
            "text",
            "conn-2",
            [
                protocol_frame(0, ProtocolDirection.client_to_server, "conn-2", "4C73A91801D58F22", sample_request(), "simple-list/1"),
                protocol_frame(1, ProtocolDirection.server_to_client, "conn-2", "4C73A91801D58F22", malformed_response(), "simple-list/1")
            ]
        )
        val evidence = trace_to_evidence(bad_trace, "simple-list/1")

        step("Verify the trace is reported as a parse failure, not an empty document")
        expect(evidence.parse_ok).to_equal(false)
        expect(evidence.nodes.len()).to_equal(0)

    it "projects the transcript with a direction marker and retains the raw bytes":
        step("Project the captured trace as a directional transcript")
        val lines = protocol_transcript_lines(sample_trace())

        step("Verify each frame is marked C -> S / S -> C and the raw start line is kept")
        expect(lines[0]).to_equal("C -> S  LIST /projects HTTP/1.1")
        expect(lines.contains("S -> C  HTTP/1.1 200 OK")).to_equal(true)
        expect(lines.contains("        beta")).to_equal(true)
        expect(lines.contains("        alpha")).to_equal(true)

    it "renders a QA manual with the expected/actual verification table":
        step("Compare the trace and project the result into manual blocks")
        val evidence = trace_to_evidence(sample_trace(), "simple-list/1")
        val result = compare_evidence(evidence, simple_list_oracle())
        val blocks = comparison_to_manual_blocks("Simple List protocol verification", result)

        step("Verify the rendered QA manual contains the verification table and a PASS verdict")
        val rendered = render_blocks(blocks, EvidenceAudience.qa)
        var joined = ""
        for line in rendered:
            joined = joined + line + "\n"
        expect(joined.contains("Selector | Mode | Expected | Actual | Result")).to_equal(true)
        expect(joined.contains("response.status")).to_equal(true)
        expect(joined.contains("PASS")).to_equal(true)
