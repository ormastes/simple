# Lane T2a/T2b: LIVE in-process interactive TUI capture feeding the Modern
# SSpec typed-evidence pipeline, replacing the hand-built fixtures in
# interactive_surface_manual_spec.spl.
#
# Unlike that fixture spec (see its HONESTY NOTE), this spec drives a REAL
# `UIState` built from `common.ui.builder` + `common.ui.widget`: two
# interactions actually mutate the widget store (`WidgetNode.set_prop`,
# which upserts into the global `WidgetRecord` store keyed by widget id —
# see `src/lib/common/ui/widget_store_ops.spl`), and the terminal rows fed
# into `TerminalSnapshot` are read back from the mutated store via
# `ui_access_snapshot_from_state` + `SgttiTestDriver`, never typed in as a
# literal row array. The `SgttiTestDriver` in
# `src/lib/nogc_sync_mut/ui_test/sgtti.spl` is the in-process capture
# surface: `SgttiTestDriver.from_tui_state(...)` snapshots exactly this
# widget tree into a `WinTextSnapshot`.
#
# Expected literals in the oracles below are reasoned out independently from
# the render rule this spec implements ("[ ] " + typed task name), never
#
# ## Purpose and audience
# Audience: TUI feature developers and QA. Purpose: replace the hand-built
# fixtures of interactive_surface_manual_spec.spl with a REAL in-process
# capture: real interactions mutating the widget store, screen rows read
# back from the live store via SgttiTestDriver.
# read back out of the evidence/snapshot under test.

use std.spec.*
use common.ui.builder.{column, text_widget}
use common.ui.widget.{UIState, UITree, WidgetNode}
use std.ui_test.sgtti.{SgttiTestDriver}
use std.common.spec.evidence.model.{
    OracleSpec, EvidenceStatus,
    check_exact, oracle_spec
}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.common.spec.evidence.action_trace.{
    UiActionKind, SettleCondition, UiActionStep, ActionTrace,
    target_resolution, settle_condition, ui_action_step, action_trace,
    action_trace_is_valid, action_trace_to_evidence
}
use std.common.spec.evidence.format.terminal_grid.{
    TerminalSnapshot, TerminalRegion,
    terminal_snapshot_from_rows, terminal_snapshot_to_evidence
}

# ============================================================================
# Live surface: a real UIState, two real state-mutating interactions
# ============================================================================

fn settled(kind: text) -> SettleCondition:
    settle_condition(kind, "polled until stable", 1, false)

# Build a fresh widget tree for the Todo surface with unique ids per test
# (so parallel `it` blocks don't collide on the shared widget store).
fn build_todo_state(run_id: text) -> UIState:
    val status_id = "status_{run_id}"
    val input_id = "task_name_input_{run_id}"
    val list_id = "task_list_{run_id}"
    val root = column("root_{run_id}", [
        text_widget(status_id, "").set_prop("text", "Todo App"),
        text_widget(input_id, "").set_prop("text", ""),
        text_widget(list_id, "").set_prop("text", "(empty)")
    ])
    UIState.new(UITree.new(root))

# Drives two real interactions against the live widget store and returns the
# resulting ActionTrace plus the ids touched, so the caller can re-derive
# rows from the mutated store afterward.
fn drive_add_task(state: UIState, run_id: text, task_name: text) -> ActionTrace:
    val input_id = "task_name_input_{run_id}"
    val list_id = "task_list_{run_id}"

    # Interaction 1: type the task name into the real input widget. This
    # upserts the "text" prop for input_id in the global widget store.
    val input_node = state.tree.find_widget(input_id)
    input_node.set_prop("text", task_name)

    # Interaction 2: commit (Enter). Reads the just-typed value back OFF the
    # live widget store (not a literal) and appends it to the real list
    # widget's stored text.
    val committed_input = state.tree.find_widget(input_id)
    val typed_value = committed_input.get_prop("text")
    val list_node = state.tree.find_widget(list_id)
    list_node.set_prop("text", "[ ] " + typed_value)

    val add_target = target_resolution("Task name", "main#{input_id}", "role_and_name", "")
    val list_target = target_resolution("Task list", "main#{list_id}", "role_and_name", "")

    val type_step = ui_action_step(
        1, UiActionKind.type_text, add_target, task_name,
        "input empty", "typing", "input holds task name", settled("revision_stable"), 1
    )
    val commit_step = ui_action_step(
        2, UiActionKind.press_key, list_target, "Enter",
        "input holds task name", "committing", "task list updated", settled("revision_stable"), 2
    )
    action_trace("tui", [type_step, commit_step])

# Re-derives terminal rows from the LIVE post-interaction snapshot via
# SgttiTestDriver.from_tui_state -> WinTextSnapshot. Row text comes from
# `node.text_value` on the captured snapshot, never from a literal string.
fn capture_rows(state: UIState, run_id: text) -> ([text], text):
    val driver = SgttiTestDriver.from_tui_state(state, 1000, 5000, 1000)
    val status_node = driver.get_element("status_{run_id}").unwrap()
    val list_node = driver.get_element("task_list_{run_id}").unwrap()
    ([status_node.text_value, "", list_node.text_value, ""], list_node.canonical_id)

fn action_trace_oracle() -> OracleSpec:
    oracle_spec(
        "live_todo/add-task/action-trace/1",
        [
            check_exact("step.1.kind", "type_text"),
            check_exact("step.1.target.resolved", "main#task_name_input_t1"),
            check_exact("step.1.after_state", "input holds task name"),
            check_exact("step.1.settle.kind", "revision_stable"),
            check_exact("step.1.revision", "1"),
            check_exact("step.2.kind", "press_key"),
            check_exact("step.2.target.resolved", "main#task_list_t1"),
            check_exact("step.2.after_state", "task list updated"),
            check_exact("step.2.settle.kind", "revision_stable"),
            check_exact("step.2.revision", "2")
        ]
    )

# ============================================================================
# Scenario
# ============================================================================

describe "Live in-process interactive surface (T2a/T2b)":
    """
    Drives a real UIState through two real interactions (type a task name,
    press Enter to commit it) via the widget store, captures the resulting
    screen through SgttiTestDriver.from_tui_state, and verifies both the
    action trace and the resulting terminal grid against closed oracles.
    """

    it "records a live add-task trace that resolves cleanly against a closed oracle":
        val state = build_todo_state("t1")

        step("Type \"Ship release\" into the task name input")
        step("Press Enter to commit it")
        val trace = drive_add_task(state, "t1", "Ship release")

        step("Verify the trace is internally valid (settled, revision advances)")
        assert_true(action_trace_is_valid(trace))

        step("Verify every recorded step matches the closed action-trace oracle")
        val evidence = action_trace_to_evidence(trace, "live_todo/add-task/action-trace/1")
        val result = compare_evidence(evidence, action_trace_oracle())
        expect(result.status).to_equal(EvidenceStatus.passed)

    it "renders \"Ship release\" on the live-captured screen, read from the real widget store":
        val state = build_todo_state("t2")
        drive_add_task(state, "t2", "Ship release")

        step("Capture the resulting screen via SgttiTestDriver.from_tui_state")
        val (rows, list_canonical_id) = capture_rows(state, "t2")

        step("Verify the captured row text is not a literal: it equals the live widget store's content")
        val live_list_node = state.tree.find_widget("task_list_t2")
        val live_list_text = live_list_node.get_prop("text")
        expect(rows[2]).to_equal(live_list_text)

        var snapshot = terminal_snapshot_from_rows(rows, 40)
        snapshot.semantic_regions = [
            TerminalRegion(node_id: list_canonical_id, row: 2, col: 0, width: 16, height: 1)
        ]

        step("Verify the closed screen oracle: task list row reads \"[ ] Ship release\"")
        val evidence = terminal_snapshot_to_evidence(snapshot, "live_todo/add-task/screen/1")
        val oracle = oracle_spec(
            "live_todo/add-task/screen/1",
            [
                check_exact("terminal.columns", "40"),
                check_exact("terminal.rows", "4"),
                check_exact("terminal.width_profile", "explicit-table-v1"),
                check_exact(list_canonical_id, "[ ] Ship release")
            ]
        )
        val result = compare_evidence(evidence, oracle)
        expect(result.status).to_equal(EvidenceStatus.passed)
