"""
T2c: Live text-protocol capture with real subprocess stdout.

Captures real subprocess stdout as a protocol trace, parses it through the
text_protocol evidence adapter, and asserts field-level checks via
compare_evidence + oracle_spec. Every payload value is sourced from captured
output, not literal strings in the oracle construction.

Reference: doc/03_plan/infra/sspec/modern_sspec_completion_plan_2026-08-09.md § T2c
#
# ## Purpose and audience
# Audience: protocol test-infrastructure developers and QA. Purpose: prove
# the text_protocol evidence lane on REAL subprocess stdout, parsed and
# field-checked through compare_evidence with values taken from the
# captured output itself.
#
"""

use std.spec.*
use std.nogc_sync_mut.sffi.system.{process_run}

use std.common.spec.evidence.model.{
    check_exact, check_full_pattern, check_ignore, check_multiset,
    oracle_spec, EvidenceStatus
}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}
use std.common.spec.evidence.format.text_protocol.{
    ProtocolDirection, ProtocolFrame, ProtocolTrace,
    protocol_frame, protocol_trace,
    parse_http_like_frame, trace_to_evidence, protocol_transcript_lines
}

describe "Live text protocol capture":
    # @manual: show
    # @capture(text)
    it "captures real subprocess stdout and verifies it through typed evidence":
        step("Launch a subprocess that emits a simple HTTP-like response")
        val stdout_result = process_run("printf", [
            "HTTP/1.1 200 OK\\r\\n" +
            "Content-Type: text/plain\\r\\n" +
            "Server: test-v1\\r\\n" +
            "\\r\\n" +
            "response line one\\r\\n" +
            "response line two\\r\\n"
        ])

        step("Extract the captured stdout payload")
        val captured_output = stdout_result[0]
        expect(captured_output).to_contain("HTTP/1.1 200 OK")

        step("Split captured output into lines and build a protocol frame from the real output")
        # The adapter expects the full output including headers and body
        val response_frame = protocol_frame(
            sequence: 0,
            direction: ProtocolDirection.server_to_client,
            connection_id: "live-test",
            correlation_id: "",
            raw: captured_output,
            profile_id: "test-http/1"
        )

        step("Construct a protocol trace with the real-output frame")
        val trace = protocol_trace(
            transport: "stdio",
            connection_id: "live-test",
            frames: [response_frame]
        )

        step("Convert trace to canonical evidence")
        val evidence = trace_to_evidence(trace, "test-http/1")
        expect(evidence.parse_ok).to_equal(true)

        step("Extract field values from the parsed evidence for oracle construction")
        var start_line_value = ""
        var content_type_value = ""
        var server_value = ""
        var body_lines: [text] = []

        for node in evidence.nodes:
            if node.path == "response.start_line":
                start_line_value = node.value
            else if node.path == "response.headers.content-type":
                content_type_value = node.value
            else if node.path == "response.headers.server":
                server_value = node.value
            else if node.path == "response.body.lines":
                body_lines.push(node.value)

        step("Verify the extracted values against the real output")
        expect(start_line_value).to_equal("HTTP/1.1 200 OK")
        expect(content_type_value).to_equal("text/plain")
        expect(server_value).to_equal("test-v1")
        expect(body_lines.len()).to_equal(2)

        step("Build a closed oracle from KNOWN literals — never from the evidence under test")
        # Expected values are the known emitted content, stated independently;
        # deriving them from `evidence.nodes` would make the oracle tautological
        # (design rule: expected values never come from the actual under test).
        val spec = oracle_spec(
            "test-http/1",
            [
                check_exact("response.start_line", "HTTP/1.1 200 OK"),
                check_exact("response.status", "200"),
                check_exact("response.headers.content-type", "text/plain"),
                check_exact("response.headers.server", "test-v1"),
                check_multiset("response.body.lines", ["response line one", "response line two"])
            ]
        )

        step("Compare evidence against the oracle")
        val result = compare_evidence(evidence, spec)
        expect(result.summary).to_equal("5 check(s) passed")

        step("Verify the trace line projection shows correct directionality")
        val transcript = protocol_transcript_lines(trace)
        expect(transcript.len()).to_be_greater_than(0)
        expect(transcript[0]).to_start_with("S -> C")
