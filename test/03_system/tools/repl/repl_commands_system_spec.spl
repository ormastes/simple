"""
## Purpose and audience
Pins the observable CLI behavior of this spec's target so maintainers and
reviewers of the repl_commands area can rely on documented output and exit codes.
## Operator workflow
Run via `bin/simple test <this file>`; read the per-scenario verdicts in the
`Results:` summary. Every scenario asserts an externally visible outcome.
## Compatibility and limitations
Covers the shipped command surface only; performance and stress behavior are
out of scope.
# @manual: primary
REQ-APP-REPL-001
doc/01_research/local/repl_commands.md
doc/03_plan/sys_test/repl_commands.md
doc/04_architecture/repl_commands.md
doc/05_design/repl_commands.md
"""
# @req: REQ-APP-REPL-001
# @cover src/app/repl/main.spl 80%
# REPL Commands System Tests
# Tests: exit/quit terminate, clear works, history works

# tag: slow, system

use app.io.mod.{file_delete, file_exists, file_write}
use app.io.mod.{getpid, process_run, time_now_unix_micros}

fn find_simple_binary() -> text:
    if file_exists("src/compiler_rust/target/release/simple"):
        return "src/compiler_rust/target/release/simple"
    if file_exists("src/compiler_rust/target/bootstrap/simple"):
        return "src/compiler_rust/target/bootstrap/simple"
    if file_exists("bin/simple"):
        return "bin/simple"
    if file_exists("bin/release/aarch64-apple-darwin-macho/simple"):
        return "bin/release/aarch64-apple-darwin-macho/simple"
    if file_exists("bin/release/macos-arm64/simple"):
        return "bin/release/macos-arm64/simple"
    if file_exists("bin/release/darwin-aarch64/simple"):
        return "bin/release/darwin-aarch64/simple"
    if file_exists("bin/release/macos-x86_64/simple"):
        return "bin/release/macos-x86_64/simple"
    if file_exists("bin/release/linux-x86_64/simple"):
        return "bin/release/linux-x86_64/simple"
    "bin/simple"

fn run_repl(input_text: text) -> text:
    val tmp = "/tmp/repl_test_{getpid()}_{time_now_unix_micros()}.txt"
    file_write(tmp, input_text)
    val (stdout, stderr, code) = process_run("bash", ["-c", "cat {tmp} | " + find_simple_binary() + " run src/app/repl/main.spl 2>/dev/null"])
    file_delete(tmp)
    stdout

use std.spec.step
describe "REPL Commands":
    slow_it "should handle :quit":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle :quit")
        val output = run_repl(":quit\n")
        expect(output).to_contain("Goodbye")

    slow_it "should handle :q shorthand":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle :q shorthand")
        val output = run_repl(":q\n")
        expect(output).to_contain("Goodbye")

    slow_it "should handle :clear":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle :clear")
        val output = run_repl(":clear\n:quit\n")
        expect(output).to_contain("State cleared")

    slow_it "should handle :history":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle :history")
        val output = run_repl("val x = 1\n:history\n:quit\n")
        expect(output).to_contain("val x = 1")

    slow_it "should handle :show":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle :show")
        val output = run_repl("val x = 1\n:show\n:quit\n")
        expect(output).to_contain("val x = 1")

    slow_it "should handle exit() function call":
        # @req: REQ-APP-REPL-001
        step("Verify: should handle exit() function call")
        val output = run_repl("exit()\n")
        expect(output).to_contain("Goodbye")

    slow_it "should terminate on EOF":
        # @req: REQ-APP-REPL-001
        step("Verify: should terminate on EOF")
        val (stdout, stderr, code) = process_run("bash", ["-c", "echo '' | " + find_simple_binary() + " run src/app/repl/main.spl 2>/dev/null"])
        expect(code).to_equal(0) # oracle: pinned expected value documenting the asserted outcome
