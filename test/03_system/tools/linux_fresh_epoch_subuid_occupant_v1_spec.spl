# AUTHORED_NOT_RUN. Separate disposable administrator-prepared negative fixture.
# No provisioning, privilege change, process creation or engine invocation here.
# @req REQ-LINUX-FRESH-EPOCH-002
use std.spec.{describe, it, expect, step, fail}
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_owner_v1.*
use std.nogc_sync_mut.io.linux_installed_fresh_epoch_profile_v1.*
var retained_negative_epochs_v1: [LinuxInstalledFreshEpochOwnerV1] = []
var retained_negative_profiles_v1: [LinuxInstalledFreshEpochProfileV1] = []

describe "Actual fresh epoch refusal: mapped subordinate UID outside the partition":
    it "reaches the native refusal and retains every cleanup owner":
        step("Require the real installed service profile before the native negative observation")
        val profile = match linux_installed_fresh_epoch_profile_open_v1():
            case LinuxFreshEpochProfileOpenV1.Ready(owner): owner
            case LinuxFreshEpochProfileOpenV1.CleanupRequired(owner, reason):
                retained_negative_profiles_v1.push(owner)
                val turn = owner.close_v1()
                fail("installed negative profile unavailable:" + reason)
                return
            case LinuxFreshEpochProfileOpenV1.Rejected(reason):
                fail("installed negative profile unavailable:" + reason)
                return
        retained_negative_profiles_v1.push(profile)
        val snapshot = profile.current_v1().unwrap()
        expect(snapshot.process.effective_uid).to_equal(snapshot.profile.number_v1("serviceUid").unwrap())
        expect(profile.close_v1().closed).to_equal(true)
        step("Observe mapped subordinate UID outside the partition through the real factory; an unrelated failure cannot pass")
        match linux_installed_fresh_epoch_open_v1():
            case LinuxFreshEpochOpenV1.Ready(owner):
                retained_negative_epochs_v1.push(owner)
                val turn = owner.close_v1()
                fail("actual forbidden native fixture unexpectedly produced preparation")
                return
            case LinuxFreshEpochOpenV1.CleanupRequired(owner, reason):
                retained_negative_epochs_v1.push(owner)
                expect(reason).to_equal("fresh-epoch-native-preexisting-service-or-subuid-process")
                val turn = owner.close_v1()
                expect(turn.closed).to_equal(true)
                expect(owner.current_v1().is_err()).to_equal(true)
            case LinuxFreshEpochOpenV1.Rejected(reason):
                fail("negative fixture did not reach the required native branch:" + reason)
                return
