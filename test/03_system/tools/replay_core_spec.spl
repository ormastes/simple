"""
## Purpose and audience
Purpose: FunctionEnter to_i32 round-trip
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-TOOLS-ReplCore-001

use std.spec
use std.replay.core.replay_event.{ReplayEventKind, ReplayEvent}
use std.replay.core.replay_engine.{ReplayEngine, replay_init, replay_shutdown, replay_get}
use std.replay.core.noop_hook.NoopReplayHook

describe "ReplayEventKind":
    it "FunctionEnter to_i32 round-trip":
        step("Verify: FunctionEnter to_i32 round-trip")
        # @req: REQ-TOOLS-ReplCore-001
        val k = ReplayEventKind.FunctionEnter
        val v = k.to_i32()
        expect(v).to_equal(0)  # oracle: value fixed by the spec contract
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(0)  # oracle: value fixed by the spec contract

    it "FunctionExit to_i32 round-trip":
        step("Verify: FunctionExit to_i32 round-trip")
        # @req: REQ-TOOLS-ReplCore-001
        val k = ReplayEventKind.FunctionExit
        val v = k.to_i32()
        expect(v).to_equal(1)  # oracle: value fixed by the spec contract
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(1)  # oracle: value fixed by the spec contract

    it "Step to_i32 round-trip":
