        val v = k.to_i32()
        expect(v).to_equal(4)  # oracle: the replay ABI fixes BreakpointHit at ordinal 4
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(4)  # oracle: from_i32 must invert to_i32 exactly

    it "Syscall to_i32 round-trip":
        # @req REQ-REPLAYCORE-006
        # @capture(protocol_binary): Syscall ordinal round-trip retained for review
        step("Convert the Syscall kind to its ABI ordinal and back")
        val k = ReplayEventKind.Syscall
        val v = k.to_i32()
        expect(v).to_equal(5)  # oracle: the replay ABI fixes Syscall at ordinal 5
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(5)  # oracle: from_i32 must invert to_i32 exactly

    it "Interrupt to_i32 round-trip":
        # @req REQ-REPLAYCORE-007
        # @capture(protocol_binary): Interrupt ordinal round-trip retained for review
        step("Convert the Interrupt kind to its ABI ordinal and back")
        val k = ReplayEventKind.Interrupt
        val v = k.to_i32()
        expect(v).to_equal(6)  # oracle: the replay ABI fixes Interrupt at ordinal 6
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(6)  # oracle: from_i32 must invert to_i32 exactly

    it "TimerRead to_i32 round-trip":
        # @req REQ-REPLAYCORE-008
        # @capture(protocol_binary): TimerRead ordinal round-trip retained for review
