describe "ReplayEvent creation":
    it "ReplayEvent fields are accessible after construction":
        # @req REQ-REPLAYCORE-013
        # @capture(protocol_binary): full event record field dump retained for review
        step("Construct a tagged event record and read every field back")
        val ev = ReplayEvent(
            seq_id: 7,
            kind: ReplayEventKind.Step,
            timestamp: 1000,
            file_hash: 42,
            line: 99,
            name_hash: 0,
            value_a: 10,
            value_b: 20,
        )
        expect(ev.seq_id).to_equal(7)  # oracle: the record was constructed with seq_id 7
        expect(ev.kind.to_i32()).to_equal(2)  # oracle: the record was constructed with the Step kind, ordinal 2
        expect(ev.timestamp).to_equal(1000)  # oracle: the record was constructed with timestamp 1000
        expect(ev.file_hash).to_equal(42)  # oracle: the record was constructed with file_hash 42
        expect(ev.line).to_equal(99)  # oracle: the record was constructed with line 99
        expect(ev.value_a).to_equal(10)  # oracle: the record was constructed with value_a 10
        expect(ev.value_b).to_equal(20)  # oracle: the record was constructed with value_b 20

describe "NoopReplayHook":
    it "is_off returns true":
        # @req REQ-REPLAYCORE-014
        # @capture(statistics): noop hook off flag retained for review
        step("Create the noop hook and read its off flag")
        val hook = NoopReplayHook()
        expect(hook.is_off()).to_equal(true)

    it "is_recording returns false":
        # @req REQ-REPLAYCORE-015
        # @capture(statistics): noop hook recording flag retained for review
        step("Create the noop hook and read its recording flag")
        val hook = NoopReplayHook()
        expect(hook.is_recording()).to_equal(false)

    it "is_replaying returns false":
        # @req REQ-REPLAYCORE-016
        # @capture(statistics): noop hook replaying flag retained for review
        step("Create the noop hook and read its replaying flag")
        val hook = NoopReplayHook()
        expect(hook.is_replaying()).to_equal(false)

    it "timer_read passes value through":
        # @req REQ-REPLAYCORE-017
        # @capture(statistics): timer pass-through value retained for review
        step("Push a timer value through the noop hook and read the result")
        val hook = NoopReplayHook()
        val result = hook.on_timer_read(1, 42)
        expect(result).to_equal(42)  # oracle: the hook was handed 42 and must pass it through unchanged

    it "io_read passes value through":
        # @req REQ-REPLAYCORE-018
        # @capture(statistics): io pass-through value retained for review
        step("Push an io read value through the noop hook and read the result")
        val hook = NoopReplayHook()
        val result = hook.on_io_read(0x1000, 4, 99)
        expect(result).to_equal(99)  # oracle: the hook was handed 99 and must pass it through unchanged

describe "ReplayEngine record mode":
    it "record mode logs events on on_step":
        # @req REQ-REPLAYCORE-019
        # @capture(statistics): record-mode event counts before and after one step retained for review
        step("Start a record engine, emit one step event, and count the log")
        val eng = ReplayEngine.create("record")
        expect(eng.events.len()).to_equal(0)  # oracle: a fresh record engine has logged nothing yet
        eng.on_step("file.spl", 10, 0)
        expect(eng.events.len()).to_equal(1)  # oracle: exactly one on_step call was made

    it "record mode logs events on on_function_enter":
        # @req REQ-REPLAYCORE-020
        # @capture(statistics): record-mode function-enter event count retained for review
        step("Start a record engine, emit one function-enter event, and count the log")
        val eng = ReplayEngine.create("record")
        eng.on_function_enter("foo", "mymod")
        expect(eng.events.len()).to_equal(1)  # oracle: exactly one on_function_enter call was made

    it "record mode accumulates multiple events":
        # @req REQ-REPLAYCORE-021
        # @capture(statistics): accumulated multi-event count retained for review
        step("Emit step, function-enter, and io-write events, then count the log")
        val eng = ReplayEngine.create("record")
        eng.on_step("a.spl", 1, 0)
        eng.on_function_enter("bar", "mod")
        eng.on_io_write(0x10, 4, 255)
        expect(eng.events.len()).to_equal(3)  # oracle: three distinct emit calls were made

    it "record mode is_recording returns true":
        # @req REQ-REPLAYCORE-022
        # @capture(statistics): record-mode recording flag retained for review
        step("Start a record engine and read its recording flag")
        val eng = ReplayEngine.create("record")
        expect(eng.is_recording()).to_equal(true)

    it "record mode is_off returns false":
        # @req REQ-REPLAYCORE-023
        # @capture(statistics): record-mode off flag retained for review
        step("Start a record engine and read its off flag")
        val eng = ReplayEngine.create("record")
        expect(eng.is_off()).to_equal(false)

    it "record mode timer_read logs and returns value":
        # @req REQ-REPLAYCORE-024
        # @capture(statistics): record-mode timer value and event count retained for review
        step("Read a timer through a record engine and check value and log count")
        val eng = ReplayEngine.create("record")
        val v = eng.on_timer_read(0, 77)
        expect(v).to_equal(77)  # oracle: the engine was handed 77 and must return it unchanged
        expect(eng.events.len()).to_equal(1)  # oracle: the timer read must log exactly one event

    it "record mode io_read logs and returns value":
        # @req REQ-REPLAYCORE-025
        # @capture(statistics): record-mode io value and event count retained for review
        step("Read io through a record engine and check value and log count")
        val eng = ReplayEngine.create("record")
        val v = eng.on_io_read(0x20, 4, 55)
        expect(v).to_equal(55)  # oracle: the engine was handed 55 and must return it unchanged
        expect(eng.events.len()).to_equal(1)  # oracle: the io read must log exactly one event

describe "ReplayEngine off mode":
    it "off mode is zero cost — no events logged on on_step":
        # @req REQ-REPLAYCORE-026
        # @capture(statistics): off-mode event count after one step retained for review
        step("Start an off engine, emit one step event, and confirm nothing is logged")
        val eng = ReplayEngine.create("off")
        eng.on_step("file.spl", 1, 0)
        expect(eng.events.len()).to_equal(0)  # oracle: off mode is the zero-cost lane and must log nothing

    it "off mode is_off returns true":
        # @req REQ-REPLAYCORE-027
        # @capture(statistics): off-mode off flag retained for review
        step("Start an off engine and read its off flag")
        val eng = ReplayEngine.create("off")
        expect(eng.is_off()).to_equal(true)

    it "off mode is_recording returns false":
        # @req REQ-REPLAYCORE-028
        # @capture(statistics): off-mode recording flag retained for review
        step("Start an off engine and read its recording flag")
        val eng = ReplayEngine.create("off")
        expect(eng.is_recording()).to_equal(false)

    it "off mode timer_read passes value through":
        # @req REQ-REPLAYCORE-029
        # @capture(statistics): off-mode timer pass-through value retained for review
        step("Read a timer through an off engine and check the returned value")
        val eng = ReplayEngine.create("off")
        val v = eng.on_timer_read(0, 123)
        expect(v).to_equal(123)  # oracle: off mode must pass the handed value 123 through unchanged

describe "ReplayEngine seq_counter":
    it "seq_counter increments per event":
        # @req REQ-REPLAYCORE-030
        # @capture(statistics): first two sequence ids retained for review
        step("Emit two step events and read their sequence ids back in log order")
        val eng = ReplayEngine.create("record")
        eng.on_step("f.spl", 1, 0)
        eng.on_step("f.spl", 2, 0)
        expect(eng.events[0].seq_id).to_equal(0)  # oracle: the log is empty at engine creation, so the first seq is 0
        expect(eng.events[1].seq_id).to_equal(1)  # oracle: the counter increments once per logged event

describe "replay_init and replay_get":
    it "replay_init then replay_get returns non-None engine":
        # @req REQ-REPLAYCORE-031
        # @capture(statistics): global engine presence flag retained for review
        step("Initialise the global engine and confirm replay_get returns it")
        replay_init("record")
        val maybe = replay_get()
        var is_some = false
        if val Some(_) = maybe:
            is_some = true
        expect(is_some).to_equal(true)
        replay_shutdown()

    it "replay_get engine after init is in record mode":
        # @req REQ-REPLAYCORE-032
        # @capture(statistics): global engine recording flag retained for review
        step("Initialise the global engine in record mode and read its recording flag")
        replay_init("record")
        val maybe = replay_get()
        var is_recording = false
        if val Some(eng) = maybe:
            is_recording = eng.is_recording()
        expect(is_recording).to_equal(true)
        replay_shutdown()

describe "replay_shutdown":
    it "replay_shutdown clears engine — replay_get returns None":
        # @req REQ-REPLAYCORE-033
        # @capture(statistics): post-shutdown engine presence flag retained for review
        step("Initialise then shut down the global engine and confirm replay_get is empty")
        replay_init("record")
        replay_shutdown()
        val maybe = replay_get()
        var is_none = true
        if val Some(_) = maybe:
            is_none = false
        expect(is_none).to_equal(true)
