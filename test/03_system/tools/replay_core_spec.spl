"""
## Purpose and audience
Covers the replay core lane (std.replay.core): the ReplayEventKind ordinal ABI,
ReplayEvent field layout, the NoopReplayHook pass-through behaviour, and the
ReplayEngine record/off modes plus the global replay_init/replay_get/replay_shutdown
lifecycle. Written for engineers changing the event recorder or replay engine.
## Operator workflow
Run this spec with:
`./src/compiler_rust/target/bootstrap/simple run test/03_system/tools/replay_core_spec.spl`
and read the trailing SPEC FILE VERDICT line.
## Compatibility and limitations
Exercises the public replay-core API on the interpreter path only; no live
target trace source is attached. Ordinal values asserted here are the cross-tool
replay ABI and must not be renumbered casually.
## Verification guidance and troubleshooting
A failed scenario names the replay operation that misbehaved; compare the
observed event count or ordinal against the expected value in the failure
message. Baseline is 33/33 passing; a record-mode event-count regression
indicates the engine stopped logging, an off-mode regression indicates the
engine started logging (a zero-cost violation).
"""
# Lifecycle: doc/01_research/infra/dump_replay/simple_dump_replay_fw_spipe_devhub_design_plan_2026-09-05.md ;
# doc/03_plan/sys_test/simpleos_server_external_receipt_replay.md ;
# doc/04_architecture/app/compiler/pure_simple_profile_guided_executable_optimization_2026-06-01.md ;
# doc/05_design/runtime/memory_analysis/gc_gpu_instrumentation_design.md
# @manual_section: replay-core-engine

use std.spec
use std.replay.core.replay_event.{ReplayEventKind, ReplayEvent}
use std.replay.core.replay_engine.{ReplayEngine, replay_init, replay_shutdown, replay_get}
use std.replay.core.noop_hook.NoopReplayHook

describe "ReplayEventKind":
    it "FunctionEnter to_i32 round-trip":
        # @req REQ-REPLAYCORE-001
        # @capture(protocol_binary): FunctionEnter ordinal round-trip retained for review
        step("Convert the FunctionEnter kind to its ABI ordinal and back")
        val k = ReplayEventKind.FunctionEnter
        val v = k.to_i32()
        expect(v).to_equal(0)  # oracle: the replay ABI fixes FunctionEnter at ordinal 0
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(0)  # oracle: from_i32 must invert to_i32 exactly

    it "FunctionExit to_i32 round-trip":
        # @req REQ-REPLAYCORE-002
        # @capture(protocol_binary): FunctionExit ordinal round-trip retained for review
        step("Convert the FunctionExit kind to its ABI ordinal and back")
        val k = ReplayEventKind.FunctionExit
        val v = k.to_i32()
        expect(v).to_equal(1)  # oracle: the replay ABI fixes FunctionExit at ordinal 1
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(1)  # oracle: from_i32 must invert to_i32 exactly

    it "Step to_i32 round-trip":
        # @req REQ-REPLAYCORE-003
        # @capture(protocol_binary): Step ordinal round-trip retained for review
        step("Convert the Step kind to its ABI ordinal and back")
        val k = ReplayEventKind.Step
        val v = k.to_i32()
        expect(v).to_equal(2)  # oracle: the replay ABI fixes Step at ordinal 2
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(2)  # oracle: from_i32 must invert to_i32 exactly

    it "VariableWrite to_i32 round-trip":
        # @req REQ-REPLAYCORE-004
        # @capture(protocol_binary): VariableWrite ordinal round-trip retained for review
        step("Convert the VariableWrite kind to its ABI ordinal and back")
        val k = ReplayEventKind.VariableWrite
        val v = k.to_i32()
        expect(v).to_equal(3)  # oracle: the replay ABI fixes VariableWrite at ordinal 3
        expect(ReplayEventKind.from_i32(v).to_i32()).to_equal(3)  # oracle: from_i32 must invert to_i32 exactly

    it "BreakpointHit to_i32 round-trip":
