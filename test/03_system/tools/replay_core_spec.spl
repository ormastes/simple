describe "ReplayEvent creation":
    it "ReplayEvent fields are accessible after construction":
        step("Verify: ReplayEvent fields are accessible after construction")
        # @req: REQ-TOOLS-ReplCore-001
        val ev = ReplayEvent(
            seq_id: 7,
            kind: ReplayEventKind.Step,
            timestamp: 1000,
            file_hash: 42,
            line: 99,
            name_hash: 0,
            value_a: 10,
            value_b: 20,
        )
        expect(ev.seq_id).to_equal(7)  # oracle: value fixed by the spec contract
        expect(ev.kind.to_i32()).to_equal(2)  # oracle: value fixed by the spec contract
        expect(ev.timestamp).to_equal(1000)  # oracle: value fixed by the spec contract
        expect(ev.file_hash).to_equal(42)  # oracle: value fixed by the spec contract
        expect(ev.line).to_equal(99)  # oracle: value fixed by the spec contract
        expect(ev.value_a).to_equal(10)  # oracle: value fixed by the spec contract
        expect(ev.value_b).to_equal(20)  # oracle: value fixed by the spec contract

describe "NoopReplayHook":
    it "is_off returns true":
        step("Verify: is_off returns true")
        # @req: REQ-TOOLS-ReplCore-001
        val hook = NoopReplayHook()
        expect(hook.is_off()).to_equal(true)

    it "is_recording returns false":
        step("Verify: is_recording returns false")
        # @req: REQ-TOOLS-ReplCore-001
        val hook = NoopReplayHook()
        expect(hook.is_recording()).to_equal(false)

    it "is_replaying returns false":
        step("Verify: is_replaying returns false")
        # @req: REQ-TOOLS-ReplCore-001
        val hook = NoopReplayHook()
        expect(hook.is_replaying()).to_equal(false)

    it "timer_read passes value through":
        step("Verify: timer_read passes value through")
        # @req: REQ-TOOLS-ReplCore-001
        val hook = NoopReplayHook()
        val result = hook.on_timer_read(1, 42)
        expect(result).to_equal(42)  # oracle: value fixed by the spec contract

    it "io_read passes value through":
        step("Verify: io_read passes value through")
        # @req: REQ-TOOLS-ReplCore-001
        val hook = NoopReplayHook()
        val result = hook.on_io_read(0x1000, 4, 99)
        expect(result).to_equal(99)  # oracle: value fixed by the spec contract

describe "ReplayEngine record mode":
    it "record mode logs events on on_step":
        step("Verify: record mode logs events on on_step")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        expect(eng.events.len()).to_equal(0)  # oracle: value fixed by the spec contract
        eng.on_step("file.spl", 10, 0)
        expect(eng.events.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "record mode logs events on on_function_enter":
        step("Verify: record mode logs events on on_function_enter")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        eng.on_function_enter("foo", "mymod")
        expect(eng.events.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "record mode accumulates multiple events":
        step("Verify: record mode accumulates multiple events")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        eng.on_step("a.spl", 1, 0)
        eng.on_function_enter("bar", "mod")
        eng.on_io_write(0x10, 4, 255)
        expect(eng.events.len()).to_equal(3)  # oracle: value fixed by the spec contract

    it "record mode is_recording returns true":
        step("Verify: record mode is_recording returns true")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        expect(eng.is_recording()).to_equal(true)

    it "record mode is_off returns false":
        step("Verify: record mode is_off returns false")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        expect(eng.is_off()).to_equal(false)

    it "record mode timer_read logs and returns value":
        step("Verify: record mode timer_read logs and returns value")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        val v = eng.on_timer_read(0, 77)
        expect(v).to_equal(77)  # oracle: value fixed by the spec contract
        expect(eng.events.len()).to_equal(1)  # oracle: value fixed by the spec contract

    it "record mode io_read logs and returns value":
        step("Verify: record mode io_read logs and returns value")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        val v = eng.on_io_read(0x20, 4, 55)
        expect(v).to_equal(55)  # oracle: value fixed by the spec contract
        expect(eng.events.len()).to_equal(1)  # oracle: value fixed by the spec contract

describe "ReplayEngine off mode":
    it "off mode is zero cost — no events logged on on_step":
        step("Verify: off mode is zero cost — no events logged on on_step")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("off")
        eng.on_step("file.spl", 1, 0)
        expect(eng.events.len()).to_equal(0)  # oracle: value fixed by the spec contract

    it "off mode is_off returns true":
        step("Verify: off mode is_off returns true")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("off")
        expect(eng.is_off()).to_equal(true)

    it "off mode is_recording returns false":
        step("Verify: off mode is_recording returns false")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("off")
        expect(eng.is_recording()).to_equal(false)

    it "off mode timer_read passes value through":
        step("Verify: off mode timer_read passes value through")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("off")
        val v = eng.on_timer_read(0, 123)
        expect(v).to_equal(123)  # oracle: value fixed by the spec contract

describe "ReplayEngine seq_counter":
    it "seq_counter increments per event":
        step("Verify: seq_counter increments per event")
        # @req: REQ-TOOLS-ReplCore-001
        val eng = ReplayEngine.create("record")
        eng.on_step("f.spl", 1, 0)
        eng.on_step("f.spl", 2, 0)
        expect(eng.events[0].seq_id).to_equal(0)  # oracle: value fixed by the spec contract
        expect(eng.events[1].seq_id).to_equal(1)  # oracle: value fixed by the spec contract

describe "replay_init and replay_get":
    it "replay_init then replay_get returns non-None engine":
        step("Verify: replay_init then replay_get returns non-None engine")
        # @req: REQ-TOOLS-ReplCore-001
        replay_init("record")
        val maybe = replay_get()
        var is_some = false
        if val Some(_) = maybe:
            is_some = true
        expect(is_some).to_equal(true)
        replay_shutdown()

    it "replay_get engine after init is in record mode":
        step("Verify: replay_get engine after init is in record mode")
        # @req: REQ-TOOLS-ReplCore-001
        replay_init("record")
        val maybe = replay_get()
        var is_recording = false
        if val Some(eng) = maybe:
            is_recording = eng.is_recording()
        expect(is_recording).to_equal(true)
        replay_shutdown()

describe "replay_shutdown":
    it "replay_shutdown clears engine — replay_get returns None":
        step("Verify: replay_shutdown clears engine — replay_get returns None")
        # @req: REQ-TOOLS-ReplCore-001
        replay_init("record")
        replay_shutdown()
        val maybe = replay_get()
        var is_none = true
        if val Some(_) = maybe:
            is_none = false
        expect(is_none).to_equal(true)
