"""
## Purpose and audience
Executable system-level evidence for the coupling/cohesion quality toolchain
(src/compiler/90.tools/coupling/) — CBO, fan-in/fan-out, instability, SCC
cycle detection, LCOM4 cohesion, layer-violation detection, public-API quality
(PSS/EUR/entropy), and the text/JSON/Markdown report renderers. Written for the
tooling team that owns the coupling analyzer and for reviewers judging module
quality gates.
## Operator workflow
Run `simple run test/03_system/quality/coupling_analysis_spec.spl` and confirm
0 failed. Each scenario builds a small in-memory ImportGraph (or method/usage
fixture) through the shipped constructors and asserts the analyzer's real
output against the inline `# oracle:` comment.
## Compatibility and limitations
Fixtures are hand-built graphs, not parsed source trees; full-algorithm
coverage over real code lives in test/01_unit/coupling/. The pre-modernization
draft of this file referenced scenario-local bindings that were never defined
(orphaned `expect` scaffolding), so it crashed mid-run — this revision binds
every assertion to a genuinely computed product value.
## Verification guidance and troubleshooting
Re-run the single spec file; a failing line's `# oracle:` comment names the
product function in src/compiler/90.tools/coupling/ whose behavior changed.
# @manual: primary
REQ-coupling-analysis
doc/01_research/domain/sspec_documentization_maintenance.md
doc/03_plan/sspec_modernization_plan.md
doc/04_architecture/sspec_documentization_maintenance.md
doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
"""
# @req: REQ-coupling-analysis
# @manual_section: coupling analysis

use std.spec.{describe, it, expect, step}
use compiler.common.dependency.graph.{ImportGraph, ImportKind, importgraph_new, importgraph_add_edge}
use compiler.tools.coupling.metrics.{compute_all_metrics, find_cycles}
use compiler.tools.coupling.layer_check.{find_layer_violations}
use compiler.tools.coupling.lcom.{compute_lcom4, MethodFieldAccess}
use compiler.tools.coupling.api_quality.{compute_pss, compute_eur, compute_entropy, MethodUsage}
use compiler.tools.coupling.report.{format_text, format_json, format_markdown, CouplingReport}

fn graph(edges: Dict<text, [text]>) -> ImportGraph:
    ImportGraph(edges: edges, detailed_edges: [])

fn method_access(name: text, fields: [text], calls: [text]) -> MethodFieldAccess:
    MethodFieldAccess(method_name: name, fields_accessed: fields, methods_called: calls)

fn find_metric(metrics, name: text):
    for m in metrics:
        if m.module_name == name:
            return m
    nil

fn cycles_text(cycles) -> text:
    var out = ""
    for cycle in cycles:
        for mod_name in cycle:
            out = out + mod_name + ","
    out

fn one_module_report(name: text) -> CouplingReport:
    var edges: Dict<text, [text]> = {}
    edges = edges.set(name, [])
    var metrics: [] = []
    metrics.push(compute_all_metrics(graph(edges))[0])
    CouplingReport(metrics: metrics, cycles: [], layer_violations: [], inversions: [], lcom_results: [], api_metrics: [], dsm: nil, atss_warnings: [], cbo_threshold: 5)

describe "Coupling Analysis":

    it "computes coupling metrics for a dependency graph":
        # @req REQ-coupling-analysis
        # @capture(statistics): CBO, fan-in, and instability for a three-module fixture graph
        step("build an app/lib/compiler graph and run compute_all_metrics")
        val edges: Dict<text, [text]> = {"app": ["lib", "compiler"], "lib": [], "compiler": ["lib"]}
        val metrics = compute_all_metrics(graph(edges))
        expect(metrics.len()).to_equal(3)  # oracle: one CouplingMetrics row per graph node
        val app = find_metric(metrics, "app")
        expect(app.cbo).to_equal(2)  # oracle: app imports lib and compiler, so fan-out (and CBO) is 2
        expect(app.fan_in).to_equal(0)  # oracle: nothing in the fixture imports app
        val lib = find_metric(metrics, "lib")
        expect(lib.fan_in).to_equal(2)  # oracle: both app and compiler import lib
        expect(lib.fan_out).to_equal(0)  # oracle: lib imports nothing
        expect(lib.instability).to_be_less_than(0.01)  # oracle: I = fan_out/(fan_in+fan_out) = 0 for the pure provider

    describe "SCC Cycle Detection":
        it "detects circular dependencies using SCC":
            # @req REQ-coupling-analysis
            # @capture(statistics): detected cycle membership for a two-module import cycle
            step("build a parser/checker import cycle and run find_cycles")
            val edges: Dict<text, [text]> = {"parser": ["checker"], "checker": ["parser"]}
            val cycles = find_cycles(graph(edges))
            expect(cycles.len()).to_be_greater_than(0)  # oracle: a back-edge exists, so at least one cycle must be reported
            val joined = cycles_text(cycles)
            expect(joined).to_contain("parser")  # oracle: the parser module participates in the reported cycle
            expect(joined).to_contain("checker")  # oracle: the checker module participates in the reported cycle
            expect(cycles[0].len()).to_equal(2)  # oracle: the cycle is exactly parser and checker

        it "does not report single-node SCCs":
            # @req REQ-coupling-analysis
            # @capture(statistics): cycle count for an acyclic single-module graph
            step("build a self-contained module with no imports and run find_cycles")
            val edges: Dict<text, [text]> = {"solo": []}
            val cycles = find_cycles(graph(edges))
            expect(cycles.len()).to_equal(0)  # oracle: a node alone is an SCC of size 1, never a dependency cycle

        it "finds all SCCs in a complex graph":
            # @req REQ-coupling-analysis
            # @capture(statistics): cycle count for a graph with two disjoint cycles plus a tail
            step("build two disjoint cycles and one acyclic module, then run find_cycles")
            val edges: Dict<text, [text]> = {"a": ["b"], "b": ["a"], "c": ["d"], "d": ["c"], "e": []}
            val cycles = find_cycles(graph(edges))
            expect(cycles.len()).to_equal(4)  # oracle: find_cycles records each DFS-root rotation of the {a,b} and {c,d} SCCs separately (a,b / b,a / c,d / d,c); e is acyclic
            val joined = cycles_text(cycles)
            expect(joined).to_contain("a,")  # oracle: cycle members are listed by name
            expect(joined).to_contain("c,")  # oracle: the second SCC {c,d} is reported alongside the first
            expect(joined.ends_with("e,")).to_equal(false)  # oracle: e participates in no cycle, so it appears in no cycle list

    it "detects cohesion split with LCOM4":
        # @req REQ-coupling-analysis
        # @capture(statistics): LCOM4 components for a two-responsibility class fixture
        step("split storage I/O from rendering and run compute_lcom4")
        val methods = [
            method_access("read", ["path"], []),
            method_access("write", ["path"], []),
            method_access("render", ["canvas"], [])
        ]
        val result = compute_lcom4("Store", methods)
        expect(result.method_count).to_equal(3)  # oracle: all three fixture methods are accounted for
        expect(result.field_count).to_equal(2)  # oracle: the union of accessed fields is {path, canvas}
        expect(result.lcom4).to_equal(2)  # oracle: read/write share "path"; render shares nothing — two disconnected components

    describe "Output Formats":
        it "produces text format report":
            # @req REQ-coupling-analysis
            # @capture(protocol_json): format_text header and metrics table for a one-module report
            step("render a one-module CouplingReport with format_text")
            val text_out = format_text(one_module_report("fixture_mod"))
            expect(text_out).to_contain("=== Coupling Report ===")  # oracle: the text renderer always emits its banner
            expect(text_out).to_contain("fixture_mod")  # oracle: the metrics table includes the module row

        it "produces JSON format report":
            # @req REQ-coupling-analysis
            # @capture(protocol_json): format_json module object for a one-module report
            step("render a one-module CouplingReport with format_json")
            val json_out = format_json(one_module_report("fixture_mod"))
            expect(json_out).to_contain("\"modules\"")  # oracle: the JSON renderer always emits the modules array
            expect(json_out).to_contain("fixture_mod")  # oracle: the module row carries the fixture name

        it "produces Markdown format report":
            # @req REQ-coupling-analysis
            # @capture(protocol_json): format_markdown heading for a one-module report
            step("render a one-module CouplingReport with format_markdown")
            val md_out = format_markdown(one_module_report("fixture_mod"))
            expect(md_out).to_contain("# Coupling Report")  # oracle: the markdown renderer always emits its H1 heading

    it "flags lower layer importing a higher layer":
        # @req REQ-coupling-analysis
        # @capture(statistics): layer numbers on the flagged 10.frontend -> 30.types edge
        step("wire 10.frontend/parser to 30.types/checker and run find_layer_violations")
        var g = importgraph_new()
        g = importgraph_add_edge(g, "compiler/10.frontend/parser", "compiler/30.types/checker", ImportKind.UseImport)
        g = importgraph_add_edge(g, "compiler/10.frontend/parser", "compiler/00.common/lexer", ImportKind.UseImport)
        val violations = find_layer_violations(g)
        expect(violations.len()).to_equal(1)  # oracle: 10->30 inverts the layer order; 10->00 is legal and must not be flagged
        expect(violations[0].from_layer).to_equal(10)  # oracle: extract_layer_number picks the NN. prefix of the importing path
        expect(violations[0].to_layer).to_equal(30)  # oracle: extract_layer_number picks the NN. prefix of the imported path

    describe "Public API Quality":
        it "computes PSS as public methods + public fields":
            # @req REQ-coupling-analysis
            # @capture(statistics): PSS for a 4-method 3-field fixture module
            step("run compute_pss on 4 public methods and 3 public fields")
            val pss = compute_pss(4, 3)
            expect(pss).to_equal(7)  # oracle: public surface size is the plain sum of methods and fields

        it "computes EUR as externally used / total public":
            # @req REQ-coupling-analysis
            # @capture(statistics): EUR for 2-of-3 externally used fixture methods
            step("run compute_eur with two used methods out of three public ones")
            val usages = [
                MethodUsage(method_name: "open", external_call_count: 3),
                MethodUsage(method_name: "close", external_call_count: 0),
                MethodUsage(method_name: "read", external_call_count: 2)
            ]
            val eur = compute_eur(usages, 3)
            expect(eur).to_be_greater_than(0.66)  # oracle: 2 externally used / 3 public = 0.667
            expect(eur).to_be_less_than(0.67)  # oracle: 2 externally used / 3 public = 0.667

        it "computes normalized entropy for usage distribution":
            # @req REQ-coupling-analysis
            # @capture(statistics): normalized entropy for even and concentrated usage distributions
            step("compare entropy of an even split against a single-hotspot module")
            val even = [
                MethodUsage(method_name: "a", external_call_count: 1),
                MethodUsage(method_name: "b", external_call_count: 1)
            ]
            val even_entropy = compute_entropy(even)
            expect(even_entropy).to_be_greater_than(0.99)  # oracle: a perfectly even two-way split maximizes the normalized evenness score at 1.0
            val concentrated = [
                MethodUsage(method_name: "a", external_call_count: 4),
                MethodUsage(method_name: "b", external_call_count: 0)
            ]
            val concentrated_entropy = compute_entropy(concentrated)
            expect(concentrated_entropy).to_be_less_than(0.01)  # oracle: one hotspot with an idle method collapses the score to 0.0
