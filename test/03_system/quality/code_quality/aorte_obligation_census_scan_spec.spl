# aorte_obligation_census_scan_spec
#
# Unit-level proof that the WP-16 AoRTE obligation census scanner
# (src/compiler/90.tools/verify/aorte_obligation_census_scan.spl) plants and
# finds a known site with the right verdict for each of the 7 obligation
# categories, and does not fabricate sites on source with none. Drives
# `scan_single_file` directly over small synthetic source strings — no disk
# I/O, no dependency on the real repo tree's current state.
#
# Per the module header: 5 of 7 categories (init, globals, overflow, shift,
# cast) always classify "assumed" — there is no real detector in this tree
# for those axes. Those specs assert SITE ENUMERATION (positive count on a
# planted site, zero on a negative control with none), not state variation —
# asserting a constant-"assumed" classifier is vacuous, enumeration is not.
# div and bounds have real varying state (proved/checked/assumed for div;
# checked for bounds) and are additionally sabotage-verified with real runs.

"""
## Purpose and audience
Purpose: init: counts one assumed site per struct field, zero on a function-only file
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-QUALITY-AortObliCensScan-001

use std.spec
use compiler.tools.verify.aorte_obligation_census_scan.{scan_single_file, ObligationSite}

fn count_cat(sites: [ObligationSite], category: text, status: text) -> i64:
    var n = 0
    for site in sites:
        if site.category == category and site.status == status:
            n = n + 1
    n

fn total_cat(sites: [ObligationSite], category: text) -> i64:
    var n = 0
    for site in sites:
        if site.category == category:
            n = n + 1
    n

use std.spec.step
describe "AoRTE obligation census scan":

    it "init: counts one assumed site per struct field, zero on a function-only file":
        step("Verify: init: counts one assumed site per struct field, zero on a function-only file")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val struct_src = ("struct Point:\n"
            + "    x: i64\n"
            + "    y: i64\n")
        val sites = scan_single_file("fixture/init.spl", struct_src)
        expect(count_cat(sites, "init", "assumed")).to_equal(2)  # oracle: value fixed by the spec contract
        expect(total_cat(sites, "init")).to_equal(2)  # oracle: value fixed by the spec contract

        val fn_only_src = "fn add(a: i64, b: i64) -> i64:\n    a + b\n"
        val neg_sites = scan_single_file("fixture/init_neg.spl", fn_only_src)
        expect(total_cat(neg_sites, "init")).to_equal(0)  # oracle: value fixed by the spec contract

    it "globals: counts one assumed site per module-level binding, zero for function-local bindings":
        step("Verify: globals: counts one assumed site per module-level binding, zero for function-local bindings")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = ("val TOP_CONST = 1\n"
            + "var top_mutable = 2\n"
            + "fn f() -> i64:\n"
            + "    val local_binding = 3\n"
            + "    local_binding\n")
        val sites = scan_single_file("fixture/globals.spl", src)
        expect(count_cat(sites, "globals", "assumed")).to_equal(2)  # oracle: value fixed by the spec contract
        expect(total_cat(sites, "globals")).to_equal(2)  # oracle: value fixed by the spec contract

    it "overflow: counts one assumed site per arithmetic line, zero on a comment-only file":
        step("Verify: overflow: counts one assumed site per arithmetic line, zero on a comment-only file")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = "fn f(a: i64, b: i64) -> i64:\n    a + b\n"
        val sites = scan_single_file("fixture/overflow.spl", src)
        expect(total_cat(sites, "overflow")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(count_cat(sites, "overflow", "assumed")).to_equal(1)  # oracle: value fixed by the spec contract

        val neg_src = "# a + b is just a comment, not code\nfn f() -> i64:\n    0\n"
        val neg_sites = scan_single_file("fixture/overflow_neg.spl", neg_src)
        expect(total_cat(neg_sites, "overflow")).to_equal(0)  # oracle: value fixed by the spec contract

    it "shift: counts one assumed site per shift operator, zero when absent":
        step("Verify: shift: counts one assumed site per shift operator, zero when absent")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = "fn f(a: i64) -> i64:\n    a << 3\n"
        val sites = scan_single_file("fixture/shift.spl", src)
        expect(total_cat(sites, "shift")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(count_cat(sites, "shift", "assumed")).to_equal(1)  # oracle: value fixed by the spec contract

        val neg_src = "fn f(a: i64) -> i64:\n    a + 3\n"
        val neg_sites = scan_single_file("fixture/shift_neg.spl", neg_src)
        expect(total_cat(neg_sites, "shift")).to_equal(0)  # oracle: value fixed by the spec contract

    it "cast: counts one assumed site per narrowing cast, zero when absent":
        step("Verify: cast: counts one assumed site per narrowing cast, zero when absent")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = "fn f(v: i64) -> u8:\n    (v & 255) as u8\n"
        val sites = scan_single_file("fixture/cast.spl", src)
        expect(total_cat(sites, "cast")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(count_cat(sites, "cast", "assumed")).to_equal(1)  # oracle: value fixed by the spec contract

        val neg_src = "fn f(v: i64) -> i64:\n    v + 1\n"
        val neg_sites = scan_single_file("fixture/cast_neg.spl", neg_src)
        expect(total_cat(neg_sites, "cast")).to_equal(0)  # oracle: value fixed by the spec contract

    it "div: classifies a non-zero-literal divisor as proved":
        step("Verify: div: classifies a non-zero-literal divisor as proved")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = "fn f(a: i64) -> i64:\n    a / 7\n"
        val sites = scan_single_file("fixture/div_proved.spl", src)
        expect(count_cat(sites, "div", "proved")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(total_cat(sites, "div")).to_equal(1)  # oracle: value fixed by the spec contract

    it "div: classifies a variable divisor with an adjacent zero-guard as checked":
        step("Verify: div: classifies a variable divisor with an adjacent zero-guard as checked")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = ("fn f(a: i64, b: i64) -> i64:\n"
            + "    if b != 0:\n"
            + "        a / b\n")
        val sites = scan_single_file("fixture/div_checked.spl", src)
        expect(count_cat(sites, "div", "checked")).to_equal(1)  # oracle: value fixed by the spec contract

    it "div: classifies an unguarded variable divisor as assumed":
        step("Verify: div: classifies an unguarded variable divisor as assumed")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val src = "fn f(a: i64, b: i64) -> i64:\n    a / b\n"
        val sites = scan_single_file("fixture/div_assumed.spl", src)
        expect(count_cat(sites, "div", "assumed")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(count_cat(sites, "div", "proved")).to_equal(0)  # oracle: value fixed by the spec contract
        expect(count_cat(sites, "div", "checked")).to_equal(0)  # oracle: value fixed by the spec contract

    it "bounds: counts an index site as checked, and does not flag a slice or a type annotation":
        step("Verify: bounds: counts an index site as checked, and does not flag a slice or a type annotation")
        # @req: REQ-QUALITY-AortObliCensScan-001
        val index_src = "fn f(arr: [i64]) -> i64:\n    arr[0]\n"
        val sites = scan_single_file("fixture/bounds_index.spl", index_src)
        expect(count_cat(sites, "bounds", "checked")).to_equal(1)  # oracle: value fixed by the spec contract
        expect(total_cat(sites, "bounds")).to_equal(1)  # oracle: value fixed by the spec contract

        val slice_src = "fn f(arr: [i64]) -> [i64]:\n    arr[0:2]\n"
        val slice_sites = scan_single_file("fixture/bounds_slice.spl", slice_src)
        expect(total_cat(slice_sites, "bounds")).to_equal(0)  # oracle: value fixed by the spec contract

        val type_src = "fn f() -> [i64]:\n    val out: [i64] = []\n    out\n"
        val type_sites = scan_single_file("fixture/bounds_type.spl", type_src)
        expect(total_cat(type_sites, "bounds")).to_equal(0)  # oracle: value fixed by the spec contract
