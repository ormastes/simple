# noalloc_manifest_scan_spec
#
# Verifies the noalloc capability-manifest scan runs check_all_noalloc_fns for
# real against source text under src/lib/nogc_async_mut_noalloc, and that a
# genuine @noalloc violation (a real 'new' call) is caught end-to-end — not
# merely a cosmetic manifest that always passes.

"""
## Purpose and audience
Purpose: reports a clean run when no @noalloc violation exists
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-QUALITY-NoalManiScan-001

use std.spec
use std.nogc_sync_mut.io.file_ops.{file_write, file_delete}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

val PROBE_PATH = "src/lib/nogc_async_mut_noalloc/collections/_sabotage_probe_spec_fixture.spl"
val PROBE_SOURCE = "# spec-owned sabotage fixture — deleted after each run\n\n@noalloc\nfn probe_violates_noalloc_spec_fixture() -> i64:\n    val bad = new BadThing()\n    1\n"

# WP-12a regression fixture: proves NoallocViolationKind.FamilyImport is
# reachable THROUGH the real driver (scripts/audit/noalloc_manifest_scan.spl),
# not only through a spec that calls check_all_noalloc_fns directly. Calls the
# real `heap_init` function defined in
# src/lib/nogc_async_mut_noalloc/baremetal/allocator.spl, which
# RUNTIME_FAMILY_MANIFEST classifies `allocates: true` (WP-11). Before WP-12a,
# the driver never registered ANY callee's family_module (always ""), so this
# exact case was structurally unreachable regardless of the manifest fix —
# see doc/08_tracking/bug/noalloc_family_manifest_prefix_match_exempts_its_own_allocators_2026-08-07.md
# "New gap found while landing this fix".
val FAMILY_PROBE_PATH = "src/lib/nogc_async_mut_noalloc/collections/_family_import_probe_spec_fixture.spl"
val FAMILY_PROBE_SOURCE = "# spec-owned sabotage fixture — deleted after each run\n\n@noalloc\nfn probe_family_import_spec_fixture() -> i64:\n    heap_init(0, 0)\n    1\n"

# Follow-up to WP-12a: proves NoallocViolationKind.TransitiveCall is reachable
# THROUGH the real driver. Before this fix, `run_noalloc_manifest_scan`
# hardcoded `allocates: false` for every registered manifest entry — even
# though `scan_noalloc_functions` already computed each callee's own
# direct-alloc expr_tags ("new"/"interpolation") and simply dropped them at
# registration time. A non-@noalloc helper whose own body performs a direct
# `new` allocation must register `allocates: true`, so an @noalloc caller of
# that helper is flagged via TransitiveCall (noalloc_checker.spl:449), not
# only via the family-prefix FamilyImport path WP-12a already covered.
val TRANSITIVE_PROBE_PATH = "src/lib/nogc_async_mut_noalloc/collections/_transitive_call_probe_spec_fixture.spl"
val TRANSITIVE_PROBE_SOURCE = "# spec-owned sabotage fixture — deleted after each run\n\nfn helper_allocates_directly_spec_fixture() -> i64:\n    val bad = new BadThing()\n    1\n\n@noalloc\nfn probe_transitive_call_spec_fixture() -> i64:\n    helper_allocates_directly_spec_fixture()\n"

use std.spec.step
describe "noalloc manifest scan":

    it "reports a clean run when no @noalloc violation exists":
        step("Verify: reports a clean run when no @noalloc violation exists")
        # @req: REQ-QUALITY-NoalManiScan-001
        val result = rt_process_run("bin/simple", ["run", "scripts/audit/noalloc_manifest_scan.spl"])
        expect(result.2).to_equal(0)  # oracle: value fixed by the spec contract

    it "catches a real @noalloc violation (direct 'new' call) end-to-end":
        step("Verify: catches a real @noalloc violation (direct 'new' call) end-to-end")
        # @req: REQ-QUALITY-NoalManiScan-001
        file_write(PROBE_PATH, PROBE_SOURCE)
        val result = rt_process_run("bin/simple", ["run", "scripts/audit/noalloc_manifest_scan.spl"])
        file_delete(PROBE_PATH)

        expect(result.2).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.0).to_contain("direct-alloc")
        expect(result.0).to_contain("heap allocation via 'new'")

    it "catches a real FamilyImport violation (@noalloc fn calling into the allocating baremetal.allocator submodule) end-to-end (WP-12a)":
        step("Verify: catches a real FamilyImport violation (@noalloc fn calling into the allocating baremetal.allocator submodule) end-to-end (WP-12a)")
        # @req: REQ-QUALITY-NoalManiScan-001
        file_write(FAMILY_PROBE_PATH, FAMILY_PROBE_SOURCE)
        val result = rt_process_run("bin/simple", ["run", "scripts/audit/noalloc_manifest_scan.spl"])
        file_delete(FAMILY_PROBE_PATH)

        expect(result.2).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.0).to_contain("family-import")
        expect(result.0).to_contain("heap_init")
        expect(result.0).to_contain("allocating family")

    it "catches a real TransitiveCall violation (@noalloc fn calling a non-@noalloc helper that itself directly allocates) end-to-end":
        step("Verify: catches a real TransitiveCall violation (@noalloc fn calling a non-@noalloc helper that itself directly allocates) end-to-end")
        # @req: REQ-QUALITY-NoalManiScan-001
        file_write(TRANSITIVE_PROBE_PATH, TRANSITIVE_PROBE_SOURCE)
        val result = rt_process_run("bin/simple", ["run", "scripts/audit/noalloc_manifest_scan.spl"])
        file_delete(TRANSITIVE_PROBE_PATH)

        expect(result.2).to_equal(1)  # oracle: value fixed by the spec contract
        expect(result.0).to_contain("transitive-call")
        expect(result.0).to_contain("helper_allocates_directly_spec_fixture")
