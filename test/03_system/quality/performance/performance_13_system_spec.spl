"""
## Purpose and audience
Pins observable outcomes of the performance system lane
(performance_13_system_spec.spl): every scenario asserts a concrete language/stdlib result the runner
must report green before the lane can be trusted as a smoke signal.
Audience: compiler and test-infrastructure engineers triaging performance runs.
## Operator workflow
Run `bin/simple test test/03_system/quality/performance/performance_13_system_spec.spl` and read the per-scenario verdicts in the
`Results:` summary; each scenario asserts one externally visible outcome.
## Compatibility and limitations
Covers interpreter-path semantics exercised by this lane; native codegen
and performance envelopes are out of scope.
# @manual: primary
REQ-SYS-PERFORMANCE-001
doc/01_research/local/performance_lane.md
doc/03_plan/sys_test/performance_lane.md
doc/04_architecture/performance_lane.md
doc/05_design/performance_lane.md
"""
# @req: REQ-SYS-PERFORMANCE-001
# @cover src/lib/nogc_sync_mut/spec/mod.spl 60%

use std.spec

describe "performance system lane execution contract":
    it "option match binds the carried payload":
        step("Verify: option match binds the carried payload")
        # @req: REQ-SYS-PERFORMANCE-001
        val opt = Some(41)
        match opt:
            Some(v):
                expect(v + 1).to_equal(42) # oracle: payload is 41
            nil:
                expect(false).to_equal(true) # oracle: nil arm must not run

    it "nested collection read goes through both keys":
        step("Verify: nested collection read goes through both keys")
        # @req: REQ-SYS-PERFORMANCE-002
        val table = {"outer": {"inner": 9}}
        expect(table["outer"]["inner"]).to_equal(9) # oracle: nested lookup path

    it "string concatenation length is the sum of parts":
        step("Verify: string concatenation length is the sum of parts")
        # @req: REQ-SYS-PERFORMANCE-003
        val joined = "foo" + "bar"
        expect(joined).to_equal("foobar")
        expect(joined.len()).to_equal(6) # oracle: 3 + 3 chars

    it "integer division and remainder follow truncation":
        step("Verify: integer division and remainder follow truncation")
        # @req: REQ-SYS-PERFORMANCE-004
        expect(17 / 5).to_equal(3) # oracle: truncated quotient
        expect(17 % 5).to_equal(2) # oracle: remainder

    it "dict lookup returns the stored value per key":
        step("Verify: dict lookup returns the stored value per key")
        # @req: REQ-SYS-PERFORMANCE-005
        val d = {"alpha": 1, "beta": 2}
        expect(d["beta"]).to_equal(2) # oracle: value stored under "beta"
        expect(d["alpha"]).to_equal(1)

