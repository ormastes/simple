"""
## Purpose and audience
Verifies the processing metal msl backend behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-001 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-010 REQ-011
# doc-path: doc/01_research/local/gpu_renderer_processing_backends_metal.md
# doc-path: doc/03_plan/sys_test/gpu_renderer_processing_backends_metal.md
# doc-path: doc/04_architecture/gpu_renderer_processing_backends_metal.md
# doc-path: doc/05_design/gpu_renderer_processing_backends_metal.md
# @tag: system, gpu, processing-ir, metal, macos, readback
# @req REQ-001 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-010 REQ-011

use std.spec.step
use std.spec.{describe, it, expect, fail_test}
use std.nogc_sync_mut.env.platform.{is_macos}
use std.common.processing.processing_ir.{processing_ir_fill_u32, processing_ir_fill_rect_u32}
use std.common.processing.backend_contract.{ProcessingBackendTarget}
use std.gc_async_mut.processing.backend_pipeline.{
    processing_backend_host_probe, compile_processing_backend_artifact,
    validate_processing_backend_artifact, run_processing_backend_device_probe,
    check_processing_backend_oracle_parity
}
use std.gc_async_mut.processing.metal_msl_backend.{
    processing_metal_drawing_fill_rect, processing_metal_generate_drawing_artifact,
    processing_metal_drawing_cpu_oracle
}

val METAL_NATIVE_RESUME = "SIMPLE_LIB=src bin/simple test test/03_system/app/simple_2d/feature/processing_metal_msl_backend_spec.spl --mode=interpreter"

struct ProcessingMetalNativeRow:
    status: text
    reason: text
    resume_command: text
    target_host: text
    hardware: text
    libraries: text
    toolchain: text
    artifact_path: text
    event_path: text
    image_path: text
    log_path: text
    success_criteria: text
    owner: text
    final_reviewer: text

fn processing_metal_native_blocked_row() -> ProcessingMetalNativeRow:
    ProcessingMetalNativeRow(status: "blocked", reason: "macos-metal-host-required",
        resume_command: METAL_NATIVE_RESUME,
        target_host: "physical Metal-capable macOS host",
        hardware: "Apple Silicon or Intel Mac with a physical Metal compute-capable GPU",
        libraries: "Apple Metal.framework Foundation.framework CoreGraphics.framework objc2-metal runtime provider",
        toolchain: "Xcode Command Line Tools xcrun metal metallib and admitted source-matched pure-Simple bin/simple",
        artifact_path: "build/gpu_renderer_processing_backends/metal_msl/artifacts",
        event_path: "build/gpu_renderer_processing_backends/metal_msl/events/native-events.ndjson",
        image_path: "build/gpu_renderer_processing_backends/metal_msl/images/fill-rect-readback.rgba",
        log_path: "build/gpu_renderer_processing_backends/metal_msl/logs/system.log",
        success_criteria: "compiled exact MSL; positive device identity and handle; raw device readback exactly equals CPU oracle; mismatch count zero; no CPU fallback",
        owner: "prepared-macOS evidence operator",
        final_reviewer: "root Codex agent normal/highest-capability")

fn expect_metal_native_blocked_contract(row: ProcessingMetalNativeRow):
    expect(row.status).to_equal("blocked")
    expect(row.reason).to_equal("macos-metal-host-required")
    expect(row.resume_command).to_equal(METAL_NATIVE_RESUME)
    expect(row.target_host).to_contain("macOS")
    expect(row.hardware).to_contain("physical Metal")
    expect(row.libraries).to_contain("Metal.framework")
    expect(row.toolchain).to_contain("xcrun metal metallib")
    expect(row.toolchain).to_contain("pure-Simple")
    expect(row.artifact_path).to_end_with("/artifacts")
    expect(row.event_path).to_end_with("native-events.ndjson")
    expect(row.image_path).to_end_with("fill-rect-readback.rgba")
    expect(row.log_path).to_end_with("system.log")
    expect(row.success_criteria).to_contain("raw device readback exactly equals CPU oracle")
    expect(row.success_criteria).to_contain("no CPU fallback")
    expect(row.owner).to_equal("prepared-macOS evidence operator")
    expect(row.final_reviewer).to_contain("root Codex agent")

describe "Metal MSL renderer processing backend":
    it "should generate a deterministic host-independent ProcessingIR artifact":
        # @req: REQ-001 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-010 REQ-011
        step("Verify: should generate a deterministic host-independent ProcessingIR artifact")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        # @step: Select representative renderer processing kernels
        val ir = processing_ir_fill_u32(64, 0xA1B2C3D4u32)
        expect(processing_backend_host_probe(ProcessingBackendTarget.MetalMsl)).to_equal("metal-msl")

        # @step: Lower shared ProcessingIR for the selected backend
        val artifact = compile_processing_backend_artifact(ir, ProcessingBackendTarget.MetalMsl)
        expect(artifact.valid).to_equal(true)
        expect(artifact.source).to_contain("processing_fill_u32")

        # @step: Translate drawing access for the destination backend
        val draw = processing_metal_drawing_fill_rect(8, 8, 2, 2, 4, 3, 0xFF3366CCu32)
        val drawing_artifact = processing_metal_generate_drawing_artifact(draw)
        expect(drawing_artifact.valid).to_equal(true)
        expect(drawing_artifact.source).to_contain("processing_fill_rect")
        expect(processing_metal_drawing_cpu_oracle(draw).len()).to_equal(64)  # oracle: pinned constant asserted by this scenario

        # @step: Compile and validate the backend artifact
        val compilation = validate_processing_backend_artifact(ir, artifact)
        expect(compilation.artifact_valid).to_equal(true)
        expect(compilation.reason).to_equal("ok")

    it "should require native device-origin readback and exact CPU oracle parity":
        # @req: REQ-001 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-010 REQ-011
        step("Verify: should require native device-origin readback and exact CPU oracle parity")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        if not is_macos():
            # @step: Record unavailable native host evidence
            val blocked = processing_metal_native_blocked_row()
            expect_metal_native_blocked_contract(blocked)
            print("PROCESSING_METAL_NATIVE status={blocked.status} reason={blocked.reason} todo=652 resume={blocked.resume_command}\n")
            fail_test("BLOCKED Metal native FillU32 row: macOS Metal host required; resume under TODO 652")
            return

        val ir = processing_ir_fill_u32(64, 0xA1B2C3D4u32)
        val artifact = compile_processing_backend_artifact(ir, ProcessingBackendTarget.MetalMsl)

        # @step: Submit native work and capture device readback
        val evidence = run_processing_backend_device_probe(ir, artifact)
        expect(evidence.submitted).to_equal(true)
        expect(evidence.device_origin).to_equal(true)
        expect(evidence.device_identity).to_be_greater_than(0)

        # @step: Compare device readback with the CPU oracle
        expect(check_processing_backend_oracle_parity(ir, evidence)).to_equal(true)
        expect(evidence.reason).to_equal("ok")

    it "should preserve Metal-to-Metal fill rectangle coordinates and pixels":
        # @req: REQ-001 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-010 REQ-011
        step("Verify: should preserve Metal-to-Metal fill rectangle coordinates and pixels")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        if not is_macos():
            val blocked = processing_metal_native_blocked_row()
            expect_metal_native_blocked_contract(blocked)
            print("PROCESSING_METAL_DRAWING_NATIVE status={blocked.status} reason={blocked.reason} todo=652 resume={blocked.resume_command}\n")
            fail_test("BLOCKED Metal-to-Metal drawing row: macOS Metal host required; resume under TODO 652")
            return
        val draw = processing_ir_fill_rect_u32(8, 8, 8, 2, 2, 4, 3, 0xFF3366CCu32)
        val generated = compile_processing_backend_artifact(draw, ProcessingBackendTarget.MetalMsl)
        expect(generated.valid).to_equal(true)
        expect(generated.source).to_contain("p.stride")
        val readback = run_processing_backend_device_probe(draw, generated)
        expect(readback.submitted).to_equal(true)
        expect(readback.device_origin).to_equal(true)
        expect(readback.device_identity).to_be_greater_than(0)
        expect(check_processing_backend_oracle_parity(draw, readback)).to_equal(true)
