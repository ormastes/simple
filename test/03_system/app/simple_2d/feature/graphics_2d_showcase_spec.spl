# codex-system-test
# @tag: simple-2d, showcase, planes, events, vector-font, performance
# @req REQ-008, REQ-009, REQ-010, REQ-011, REQ-012
"""Source-contract guards for the executable 2D showcase.

Live UI evidence is a separate acceptance gate; these tests make required
owners explicit and prevent a static-present or raw-Winit regression.
"""

use std.spec.*
use std.io_runtime.{file_read}

val SHOWCASE = "examples/06_io/ui/graphics_2d_showcase.spl"

fn showcase_source() -> text:
    file_read(SHOWCASE) ?? ""

describe "graphics_2d_showcase hardening":
    it "REQ-008 composites actual ordered WM planes":
        val source = showcase_source()
        expect(source).to_contain("use std.gpu.engine2d.compositor.{Layer, Compositor}")
        expect(source).to_contain("fn showcase_wm_plane_pixels()")
        expect(source).to_contain("compositor.add_layer(taskbar)")
        expect(source).to_contain("e.draw_image_scaled")

    it "REQ-009 normalizes Winit input through the shared event loop":
        val source = showcase_source()
        expect(source).to_contain("WindowEventLoop.create(256, 16)")
        expect(source).to_contain("window_event_key")
        expect(source).to_contain("window_event_pointer")
        expect(source).to_contain("shared_events.poll()")

    it "REQ-010 and REQ-011 require vector proof and changed-frame performance":
        val source = showcase_source()
        expect(source).to_contain("selected_font_asset_identity")
        expect(source).to_contain("font_warm_hits")
        expect(source).to_contain("SHOWCASE_PERF_FRAMES")
        expect(source).to_contain("visible-overlay-redraw")
        expect(source).to_contain("final_frame.checksum != initial.checksum")
