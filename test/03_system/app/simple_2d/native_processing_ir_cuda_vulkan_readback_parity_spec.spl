# @tag: system, gpu, processing-ir, cuda, vulkan, readback, parity

use std.io_runtime.{file_exists, file_read, process_run}
use std.nogc_sync_mut.env.platform.{is_linux}
use std.spec.*

val CUDA_CHECK = "scripts/check/check-cuda-generated-2d-readback.shs"
val CUDA_BUILD = "build/native_processing_ir_cuda_vulkan_readback_parity/cuda"
val CUDA_REPORT = CUDA_BUILD + "/report.md"
val CUDA_RECEIPT = CUDA_BUILD + "/evidence.env"

val VULKAN_CHECK = "scripts/check/check-vulkan-engine2d-readback.shs"
val VULKAN_BUILD = "build/native_processing_ir_cuda_vulkan_readback_parity/vulkan"
val VULKAN_REPORT = VULKAN_BUILD + "/report.md"
val VULKAN_RECEIPT = VULKAN_BUILD + "/evidence.env"
val VULKAN_LOG = VULKAN_BUILD + "/evidence.log"
val PROCESSING_PARITY_CHECK = "scripts/check/check-processing-cuda-vulkan-native-parity.shs"

fn receipt_value(receipt: text, key: text) -> text:
    val prefix = key + "="
    for line in receipt.split("\n"):
        if line.starts_with(prefix):
            return line[prefix.len():]
    ""

fn positive_receipt_value(receipt: text, key: text) -> bool:
    val value = receipt_value(receipt, key)
    value != "" and value != "0" and value.to_i64() > 0

fn equal_positive_receipt_values(receipt: text, expected_key: text, actual_key: text) -> bool:
    val expected = receipt_value(receipt, expected_key)
    val actual = receipt_value(receipt, actual_key)
    positive_receipt_value(receipt, expected_key) and
        positive_receipt_value(receipt, actual_key) and expected == actual

fn json_has_count(path: text, count: text) -> bool:
    file_exists(path) and file_read(path).contains("\"count\":" + count + ",")

fn run_cuda_check() -> (text, text, i64):
    val command = "BUILD_DIR=" + CUDA_BUILD +
        " REPORT_PATH=" + CUDA_REPORT +
        " sh " + CUDA_CHECK
    process_run("/bin/sh", ["-c", command])

fn run_vulkan_check() -> (text, text, i64):
    val command = "SIMPLE_VULKAN_READBACK_CLEAN=0" +
        # "native" was never a valid SIMPLE_EXECUTION_MODE; it fell through the
        # parser's catch-all to the JIT. Now that unknown values are rejected
        # (exit 2), say "jit" explicitly -- same lane, no silent fallback.
        " SIMPLE_EXECUTION_MODE=jit" +
        " SIMPLE_LIB=src" +
        " SIMPLE_BIN=bin/simple" +
        " SIMPLE_VULKAN_READBACK_WORK_DIR=" + VULKAN_BUILD +
        " REPORT_PATH=" + VULKAN_REPORT +
        " sh " + VULKAN_CHECK
    process_run("/bin/sh", ["-c", command])

fn assert_cuda_receipt(receipt: text):
    expect(receipt_value(receipt, "cuda_generated_2d_readback_status")).to_equal("pass")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_backend_name")).to_equal("cuda")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_status")).to_equal("compiled_artifact_verified")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_candidate_compiled")).to_equal("true")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_artifact_validated")).to_equal("true")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_source_hash_equal")).to_equal("true")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_emitter_mode")).to_equal("source-cli")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_emitter_path")).to_end_with(
        "/src/app/portable_compute_emit/main.spl")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_compiler_requested")).to_equal("nvcc")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_compiler_version")).to_contain("NVIDIA")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_helper_exit_status")).to_equal("0")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_emitter_source_sha256")).to_equal(
        receipt_value(receipt, "cuda_generated_2d_readback_ptx_generated_source_sha256"))
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_toolchain_artifact")).to_equal(
        receipt_value(receipt, "cuda_generated_2d_readback_ptx_path"))
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_toolchain_artifact_sha256")).to_equal(
        receipt_value(receipt, "cuda_generated_2d_readback_ptx_sha256_before"))
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ptx_toolchain_artifact_sha256")).to_equal(
        receipt_value(receipt, "cuda_generated_2d_readback_ptx_sha256_after"))
    expect(receipt_value(receipt, "cuda_generated_2d_readback_submit_attempted")).to_equal("true")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_readback_available")).to_equal("true")
    expect(positive_receipt_value(receipt, "cuda_generated_2d_readback_device_identity")).to_equal(true)
    expect(positive_receipt_value(receipt, "cuda_generated_2d_readback_device_count")).to_equal(true)
    expect(receipt.contains("cpu_fallback")).to_equal(false)
    expect(receipt.contains("backend_name=cpu")).to_equal(false)
    expect(equal_positive_receipt_values(receipt,
        "cuda_generated_2d_readback_expected_checksum",
        "cuda_generated_2d_readback_actual_checksum")).to_equal(true)
    expect(receipt_value(receipt, "cuda_generated_2d_readback_mismatch_count")).to_equal("0")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_count")).to_equal("64")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_blur_or_tolerance_used")).to_equal("false")
    expect(receipt_value(receipt, "cuda_generated_2d_readback_ops")).to_equal("fill,copy,alpha,scroll")

    val expected_path = receipt_value(receipt, "cuda_generated_2d_readback_expected_pixels_path")
    val actual_path = receipt_value(receipt, "cuda_generated_2d_readback_actual_pixels_path")
    expect(json_has_count(expected_path, "256")).to_equal(true)
    expect(json_has_count(actual_path, "256")).to_equal(true)
    for op in ["fill", "copy", "alpha", "scroll"]:
        expect(equal_positive_receipt_values(receipt,
            "cuda_generated_2d_readback_" + op + "_expected_checksum",
            "cuda_generated_2d_readback_" + op + "_actual_checksum")).to_equal(true)
        expect(receipt_value(receipt, "cuda_generated_2d_readback_" + op + "_mismatch_count")).to_equal("0")

fn assert_vulkan_operation(receipt: text, operation: text):
    val prefix = "vulkan_engine2d_readback_" + operation + "_"
    expect(receipt_value(receipt, prefix + "status")).to_equal("pass")
    expect(receipt_value(receipt, prefix + "pixels")).to_equal("256")
    expect(equal_positive_receipt_values(receipt,
        prefix + "expected_checksum", prefix + "actual_checksum")).to_equal(true)
    expect(receipt_value(receipt, prefix + "mismatches")).to_equal("0")
    expect(receipt_value(receipt, prefix + "source")).to_equal("device_readback")
    expect(positive_receipt_value(receipt, prefix + "backend_handle")).to_equal(true)
    expect(positive_receipt_value(receipt, prefix + "device_identity")).to_equal(true)
    val expected_path = receipt_value(receipt, prefix + "expected_pixels_path")
    val actual_path = receipt_value(receipt, prefix + "actual_pixels_path")
    expect(json_has_count(expected_path, "256")).to_equal(true)
    expect(json_has_count(actual_path, "256")).to_equal(true)

describe "native ProcessingIR CUDA and Vulkan readback parity":
    it "uses canonical device-backed readback gates":
        val cuda_source = file_read(CUDA_CHECK)
        val vulkan_source = file_read(VULKAN_CHECK)
        val processing_source = file_read(PROCESSING_PARITY_CHECK)
        expect(cuda_source).to_contain("cuLaunchKernel")
        expect(cuda_source).to_contain("cuMemcpyDtoH")
        expect(cuda_source).to_contain("cuda_generated_2d_readback_backend_name=cuda")
        expect(vulkan_source).to_contain("read_pixels_with_source()")
        expect(vulkan_source).to_contain("not-device-readback")
        expect(vulkan_source).to_contain("backend-handle-missing")
        expect(vulkan_source).to_contain("device-identity-missing")
        expect(processing_source).to_contain("set -eu")
        expect(processing_source).to_contain("PROCESSING_CUDA_FILL_PROBE_BIN=\"$CUDA_PROBE_BIN\"")
        expect(processing_source).to_contain("PROCESSING_CUDA_FILL_TIMEOUT_SECONDS=\"$TIMEOUT_SECONDS\"")
        expect(processing_source).to_contain("PROCESSING_CUDA_FILL_MODE=parity")
        expect(processing_source).to_contain("PROCESSING_VULKAN_FAULT_PROBE_BIN=\"$VULKAN_PROBE_BIN\"")
        expect(processing_source).to_contain("PROCESSING_VULKAN_FAULT_TIMEOUT_SECONDS=\"$TIMEOUT_SECONDS\"")
        expect(processing_source).to_contain("check-processing-cuda-fill-native.shs")
        expect(processing_source).to_contain("check-processing-vulkan-fault-native.shs")
        expect(processing_source).to_contain("processing_cuda_vulkan_native_parity_status=pass")

    it "requires exact CUDA pixels and checksums when CUDA is available":
        if not is_linux():
            pending("CUDA native readback is gated to the Linux CUDA host")
        else:
            val (_stdout, _stderr, code) = run_cuda_check()
            if not file_exists(CUDA_RECEIPT):
                expect(file_exists(CUDA_RECEIPT)).to_equal(true)
            else:
                val receipt = file_read(CUDA_RECEIPT)
                expect(code).to_equal(0)
                assert_cuda_receipt(receipt)

    it "requires exact Vulkan pixels and checksums when Vulkan is available":
        if not is_linux():
            pending("Vulkan Engine2D readback is gated to the Linux Vulkan host")
        elif not file_exists("bin/simple"):
            expect(file_exists("bin/simple")).to_equal(true)
        else:
            val (stdout, _stderr, code) = run_vulkan_check()
            val evidence_log = if file_exists(VULKAN_LOG): file_read(VULKAN_LOG) else: stdout
            if evidence_log.contains("vulkan_available=false"):
                pending("Vulkan device unavailable; canonical receipt records an honest host gate")
            else:
                expect(code).to_equal(0)
                expect(file_exists(VULKAN_RECEIPT)).to_equal(true)
                val receipt = file_read(VULKAN_RECEIPT)
                expect(receipt_value(receipt, "vulkan_engine2d_readback_status")).to_equal("pass")
                expect(receipt_value(receipt, "vulkan_engine2d_readback_backend_name")).to_equal("vulkan")
                expect(receipt_value(receipt, "vulkan_engine2d_readback_present_exercised")).to_equal("true")
                expect(receipt_value(receipt, "vulkan_engine2d_readback_readback_exercised")).to_equal("true")
                expect(receipt.contains("cpu_fallback")).to_equal(false)
                expect(receipt.contains("backend_name=cpu")).to_equal(false)
                assert_vulkan_operation(receipt, "clear")
                assert_vulkan_operation(receipt, "rect")
