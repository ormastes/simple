# GdbMiClient real-subprocess-pipe transport system test.
#
# Spawns a real `gdb --interpreter=mi3` subprocess through the same
# process_spawn_piped/process_write_stdin/process_read_stdout facade
# GdbMiClient now uses (no fifos, no `sh -c`, no `timeout grep`), sets a
# conditional breakpoint through GDB MI, and asserts we get back a
# token-matched ^done result whose bkpt={...} fields were NOT thrown away
# (condition + hit count survive parsing into GdbBreakpoint).
#
# Skips cleanly (prints a reason, does not fail) if `gdb`/a C compiler
# isn't on PATH, or if this binary's interpreter doesn't have the
# rt_process_spawn_piped family of externs registered — see
# doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md.
# That capability can't be probed in-process: Simple has no try/catch (by
# design — see .claude/rules/language.md), and on the affected binary
# calling process_spawn_piped() directly is a hard "unknown extern
# function" semantic error that aborts the whole `it`, not a catchable
# Result. So the probe below runs a throwaway child `bin/simple run`
# process instead — under `run` (unlike `test`) that same failure is
# logged and degrades to a soft pid=0 return, which the child script
# reports back over stdout for us to check safely from here.

use std.io.{shell, shell_bool, shell_output_trimmed, file_write, file_delete, file_exists}
use std.nogc_sync_mut.io.{process_spawn_piped}
use app.debug.remote.protocol.gdb_mi.GdbMiClient
use app.debug.remote.protocol.gdb_mi_parser.{GdbBreakpoint}

# NOTE: uses shell_bool(), not shell(...).exit_code — under `bin/simple
# test`'s interpreter/module graph, ProcessResult field access on a
# std.io.shell() result resolves to the wrong `shell` overload (a name
# collision with other `fn shell(...)` definitions elsewhere in the tree)
# and throws "unknown property or method 'exit_code' on Tuple". This is a
# pre-existing test-runner-only defect (bin/simple run is unaffected);
# shell_bool() sidesteps it since it never exposes struct field access.
fn _gdb_available() -> bool:
    shell_bool("which gdb")

fn _gcc_available() -> bool:
    shell_bool("which gcc")

fn _piped_process_extern_available() -> bool:
    val probe_path = "/tmp/ds6_piped_capability_probe.spl"
    val probe_src = "use std.nogc_sync_mut.io.{process_spawn_piped}\n\nfn main():\n    val pid = process_spawn_piped(\"true\", [])\n    if pid > 0:\n        print \"PIPED_OK\"\n    else:\n        print \"PIPED_FAIL\"\n"
    file_write(probe_path, probe_src)
    val output = shell_output_trimmed("/home/ormastes/dev/pub/simple/bin/simple run {probe_path} 2>/dev/null", "")
    file_delete(probe_path)
    output.contains("PIPED_OK")

describe "GdbMiClient over a real gdb subprocess pipe":
    it "sets a conditional breakpoint via MI and gets a token-matched ^done with condition/hit-count preserved":
        if not _gdb_available():
            print "SKIP: gdb not available on PATH"
            return

        if not _gcc_available():
            print "SKIP: gcc not available on PATH (needed to build the MI fixture binary)"
            return

        if not _piped_process_extern_available():
            print "SKIP: rt_process_spawn_piped is not registered in this interpreter build's extern dispatch table (pre-existing gap, not caused by this change — see doc/08_tracking/bug/interpreter_sffi_missing_piped_process_externs_2026-07-29.md)"
            return

        val c_path = "/tmp/ds6_gdb_mi_fixture.c"
        val bin_path = "/tmp/ds6_gdb_mi_fixture"
        file_write(c_path, "int main(void) {\n    int x = 1;\n    return x;\n}\n")
        val compiled = shell_bool("gcc -g -o {bin_path} {c_path}")
        if not compiled:
            print "SKIP: gcc failed to build MI fixture binary"
            file_delete(c_path)
            return

        # Spawn gdb directly over the piped-subprocess facade, bypassing
        # GdbMiClient.connect()'s "target-select remote host:port" step —
        # this spec exercises the local MI transport/parser, not a live
        # remote-target connection (which needs a running gdbstub).
        val pid = process_spawn_piped("gdb", ["--interpreter=mi3", "-nx"])
        expect(pid).to_be_greater_than(0)

        var client = GdbMiClient(
            pid: pid,
            token_counter: 1,
            connected: false,
            program: bin_path,
            read_buf: "",
            pending_results: [],
            last_stop_data: {},
            saw_prompt: false,
            breakpoints: []
        )
        client.read_until_prompt()

        val exec_result = client.send_command("file-exec-and-symbols {bin_path}")
        match exec_result:
            Err(_):
                expect(true).to_equal(false)
            Ok(_):
                pass

        val bp_result = client.set_breakpoint_full("main", "x == 1", -1)
        match bp_result:
            Err(_):
                expect(true).to_equal(false)
            Ok(bp):
                # The token-matched ^done result decoded into a real
                # GdbBreakpoint — this is the "rich breakpoint fields no
                # longer discarded" assertion: condition and location
                # both survived the parse instead of only `number`.
                expect(bp.id).to_be_greater_than(0)
                expect(bp.func_name).to_equal("main")
                expect(bp.condition).to_equal("x == 1")
                expect(bp.enabled).to_equal(true)
                expect(bp.line).to_be_greater_than(0)

                val cached = client.get_breakpoint_info(bp.id)
                match cached:
                    Err(_):
                        expect(true).to_equal(false)
                    Ok(info):
                        expect(info.condition).to_equal("x == 1")

        client.disconnect()
        file_delete(c_path)
        if file_exists(bin_path):
            shell("rm -f {bin_path}")
