# Pure-Simple public CLI contract for lint diagnostics and fixes. Child runs
# use the same executable that launched this spec and are bounded fail-closed.

use std.spec.*
use std.spec.step
use std.sffi.cli.{cli_get_args}
use std.io_runtime.{env_get}
use lib.json.parser.{json_parse_with_error}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read, file_atomic_write, file_delete}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
# @req: REQ-SSPEC-LOCAL-001 — behavior under test holds under execution.
"""
## Purpose and audience

Purpose: the behavior asserted in this spec  Audience: engineers reading this spec to confirm the behavior still holds.

## Operator workflow

1. Run `bin/simple test test/03_system/app/lint_cli_contract_spec.spl`.
2. Every scenario must pass; a failure is a regression in the behavior under test.

## Compatibility and limitations

Covers the behavior asserted here; platform-specific behavior is out of scope.
"""

# doc-path: doc/01_research/local/lint_cli_contract_spec.md
# doc-path: doc/03_plan/sys_test/lint_cli_contract_spec.md
# doc-path: doc/04_architecture/lint_cli_contract_spec.md
# doc-path: doc/05_design/lint_cli_contract_spec_oracles.md
# @manual: primary


extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

val FIX_SOURCE = "describe \"fix probe\":\n    it \"uses boolean wrapper\":\n        expect(1 == 1).to_equal(true)\n"
val FIX_EXPECTED = "describe \"fix probe\":\n    it \"uses boolean wrapper\":\n        assert_true(1 == 1)\n"

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != nil and configured != "" and file_exists(configured):
        return configured
    if file_exists("/proc/self/exe"):
        return "/proc/self/exe"
    val args = cli_get_args()
    if args.len() > 0 and file_exists(args[0]) and (args[0].ends_with("/simple") or args[0].ends_with("simple.exe")):
        return args[0]
    ""

fn run_lint(args: [text]) -> (text, text, i32):
    var child_args = ["lint"]
    for arg in args:
        child_args.push(arg)
    rt_process_run_timeout(simple_binary(), child_args, 30000)

fn fix_fixture(kind: text) -> text:
    "/tmp/simple_lint_contract_{getpid()}_{kind}_spec.spl"

fn expect_json_lines(stdout: text):
    for line in stdout.split("\n"):
        if line.trim() != "":
            expect(json_parse_with_error(line).1).to_equal("")

describe "simple lint CLI contract":
    it "defers the theme package outside theme lint targets":
        step("Verify: defers the theme package outside theme lint targets")
        # @req: REQ-SSPEC-LOCAL-001
        val split_dir = "src/compiler/90.tools/lint/_LintMain/"
        val split_files = [
            "config_and_model.spl",
            "entry_and_fixes.spl",
            "lint_checks.spl",
            "traceability_and_assertions.spl",
        ]
        for file in split_files:
            expect(file_read(split_dir + file).contains(
                "use nogc_sync_mut.ui.theme_package")).to_equal(false)
        expect(file_read(split_dir + "lint_checks.spl")).to_contain(
            "use lazy nogc_sync_mut.ui.theme_package.{validate_default_theme_package}")

    it "loads the theme validator for a theme lint target":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: loads the theme validator for a theme lint target")
        val (stdout, stderr, code) = run_lint(["config/themes/theme.sdn"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("Lint passed: all files clean")

    it "exits 0 and reports clean on a violation-free file":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: exits 0 and reports clean on a violation-free file")
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/clean.spl"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("Lint passed: all files clean")

    it "exits nonzero and names real violations":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: exits nonzero and names real violations")
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/dirty.spl"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("W001")
        expect(stdout).to_contain("D001")
        expect(stdout).to_contain("PARSE001")
        expect(stdout).to_contain("Lint failed in 1 file(s)")

    it "reports an unparseable file as NOT LINTED, loudly and countably":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: reports an unparseable file as NOT LINTED, loudly and countably")
        # A file the parse gate rejects has been analysed LESS than a clean
        # file, not more: every AST-based lint is skipped for it. Reporting it
        # as one ordinary error made it read as checked. The run must name the
        # file, count the skips separately, and exit nonzero.
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/dirty.spl"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("PARSE001")
        expect(stdout).to_contain("NOT LINTED: test/fixtures/lint/dirty.spl")
        expect(stdout).to_contain("NOT LINTED: 1 file(s) could not be parsed and were never analysed")
        expect(stdout.contains("Lint passed")).to_equal(false)

    it "never summarises a run with a skipped file as passed":
        step("Verify: never summarises a run with a skipped file as passed")
        # @req: REQ-SSPEC-LOCAL-001
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/dirty.spl", "test/fixtures/lint/clean.spl"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("NOT LINTED: 1 file(s) could not be parsed and were never analysed")
        expect(stdout.contains("Lint passed: all files clean")).to_equal(false)

    it "counts skipped files in the JSON summary":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: counts skipped files in the JSON summary")
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/dirty.spl", "--json"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("\"type\":\"lint-not-linted\"")
        expect(stdout).to_contain("\"not_linted\":true")
        expect(stdout).to_contain("\"not_linted_files\":1")
        # The human-readable summary banner must stay out of JSON mode; the
        # phrase still appears inside the PARSE001 diagnostic message itself.
        expect(stdout.contains("NOT LINTED: 1 file(s)")).to_equal(false)
        expect_json_lines(stdout)

    it "reports zero skipped files on a clean run":
        step("Verify: reports zero skipped files on a clean run")
        # @req: REQ-SSPEC-LOCAL-001
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/clean.spl", "--json"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("\"not_linted_files\":0")
        expect(stdout.contains("lint-not-linted")).to_equal(false)
        expect_json_lines(stdout)

    it "deduplicates overlapping directory and file targets":
        step("Verify: deduplicates overlapping directory and file targets")
        # @req: REQ-SSPEC-LOCAL-001
        val (stdout, stderr, code) = run_lint([
            "./test/fixtures/pure_simple_tooling/lint_directory",
            "test/fixtures/pure_simple_tooling/lint_directory/nested/dirty.spl"
        ])
        expect(code).to_equal(1)
        expect(stdout.split("warning[W001]").len()).to_equal(2)
        expect(stdout).to_contain("Lint failed in 1 file(s)")

    it "emits JSON Lines without human summaries":
        step("Verify: emits JSON Lines without human summaries")
        # @req: REQ-SSPEC-LOCAL-001
        val (stdout, stderr, code) = run_lint(["test/fixtures/lint/dirty.spl", "--json"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("\"type\":\"lint-diagnostic\"")
        expect(stdout).to_contain("\"type\":\"lint-summary\",\"status\":\"failed\"")
        expect(stdout.contains("Lint failed in")).to_equal(false)
        expect_json_lines(stdout)

    it "emits one failed summary when an input file is missing":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: emits one failed summary when an input file is missing")
        val missing = "test/fixtures/lint/definitely_missing.spl"
        val (stdout, stderr, code) = run_lint([missing, "./" + missing, "--json"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("\"type\":\"lint-error\"")
        expect(stdout.split("\"type\":\"lint-error\"").len()).to_equal(2)
        expect(stdout).to_contain("\"type\":\"lint-summary\",\"status\":\"failed\",\"failed_files\":1")
        expect(stdout.split("\"type\":\"lint-summary\"").len()).to_equal(2)
        expect_json_lines(stdout)

    it "recursively expands a relative directory target":
        step("Verify: recursively expands a relative directory target")
        # @req: REQ-SSPEC-LOCAL-001
        val (stdout, stderr, code) = run_lint(["test/fixtures/pure_simple_tooling/lint_directory"])
        expect(code).to_equal(1)
        expect(stdout).to_contain("W001")
        expect(stdout).to_contain("D001")
        expect(stdout).to_contain("Lint failed in 1 file(s)")

    it "fails explicitly when a directory contains no Simple sources":
        # @req: REQ-SSPEC-LOCAL-001
        step("Verify: fails explicitly when a directory contains no Simple sources")
        val (stdout, stderr, code) = run_lint([
            "test/fixtures/pure_simple_tooling/lint_empty",
            "test/fixtures/pure_simple_tooling/lint_empty",
            "--json"
        ])
        expect(code).to_equal(1)
        expect(stdout).to_contain("\"type\":\"lint-error\"")
        expect(stdout).to_contain("\"message\":\"no Simple source files found\"")
        expect(stdout).to_contain("\"type\":\"lint-summary\",\"status\":\"failed\",\"failed_files\":1")
        expect_json_lines(stdout)

    it "runs fix-dry-run without mutating the input":
        step("Verify: runs fix-dry-run without mutating the input")
        # @req: REQ-SSPEC-LOCAL-001
        val fixture = fix_fixture("dry_human")
        expect(file_atomic_write(fixture, FIX_SOURCE)).to_equal(true)
        val (stdout, stderr, code) = run_lint([fixture, "--fix-dry-run"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("Dry run - would apply")
        expect(file_read(fixture)).to_equal(FIX_SOURCE)
        file_delete(fixture)

    it "keeps JSON fix-dry-run output as JSON Lines":
        step("Verify: keeps JSON fix-dry-run output as JSON Lines")
        # @req: REQ-SSPEC-LOCAL-001
        val fixture = fix_fixture("dry_json")
        expect(file_atomic_write(fixture, FIX_SOURCE)).to_equal(true)
        val (stdout, stderr, code) = run_lint([fixture, "--json", "--fix-dry-run"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("\"type\":\"lint-fix-summary\"")
        expect(stdout).to_contain("\"mode\":\"dry-run\"")
        expect(stdout.contains("Dry run - would apply")).to_equal(false)
        expect_json_lines(stdout)
        expect(file_read(fixture)).to_equal(FIX_SOURCE)
        file_delete(fixture)

    it "applies JSON fixes atomically without human output":
        step("Verify: applies JSON fixes atomically without human output")
        # @req: REQ-SSPEC-LOCAL-001
        val fixture = fix_fixture("apply_json")
        expect(file_atomic_write(fixture, FIX_SOURCE)).to_equal(true)
        val (stdout, stderr, code) = run_lint([fixture, "--json", "--fix"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("\"type\":\"lint-fix-summary\"")
        expect(stdout).to_contain("\"mode\":\"applied\"")
        expect(stdout.contains("Applied ")).to_equal(false)
        expect_json_lines(stdout)
        expect(file_read(fixture)).to_equal(FIX_EXPECTED)
        file_delete(fixture)
