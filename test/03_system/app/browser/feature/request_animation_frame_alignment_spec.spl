"""
## Purpose and audience
Verifies the request animation frame alignment behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-021
# doc-path: doc/01_research/local/layout_framework.md
# doc-path: doc/03_plan/lib/browser/common_compression_framework.md
# doc-path: doc/04_architecture/layout_framework.md
# doc-path: doc/05_design/layout_framework.md
# codex-system-test
# @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-021
"""# requestAnimationFrame Boundary Alignment

**Requirements:** doc/02_requirements/feature/simple_web_browser_engine_production_hardening.md
**Plan:** doc/03_plan/sys_test/simple_web_browser_engine_production_hardening.md
**Design:** doc/05_design/simple_web_browser_engine_production_hardening.md
**Research:** doc/01_research/local/simple_web_browser_engine_production_hardening.md

## Overview

BrowserSession and the canonical JavaScript timer owner align staggered
requestAnimationFrame registrations to one document-clock refresh boundary.
Callbacks registered during dispatch wait for the following boundary, canceled
handles stay inert, and both observable frames lower through Draw IR and
Engine2D without a private clock or painter.
"""

use std.spec.*

use common.ui.draw_ir.{DrawIrCommand}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_browser_renderer_worker.{
    hosted_browser_renderer_safe_wakeup_ms
}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images
}
use std.js.engine.runtime.{JsRuntime}
use std.js.engine.js_error.{Logger, LogLevel}
use std.js.types.js_types.{JsValue}

class RafAlignmentFrame:
    command: DrawIrCommand
    pixels: [u32]
    matching_pixels: i64
    rendered_commands: i32
    skipped_commands: i32
    source_kind: text

fn _count_color(pixels: [u32], color: u32) -> i64:
    var count: i64 = 0
    for pixel in pixels:
        if pixel == color:
            count = count + 1
    count

fn _read_js_text(session: BrowserSession, expression: text) -> text:
    match session.eval_script(expression):
        Ok(JsValue.String(value)): value
        Ok(_): fail("Expected JavaScript string result for {expression}")
        Err(reason): fail("JavaScript state read failed: {reason}")

fn _render_raf_alignment_frame(
    session: BrowserSession, expected_color: u32
) -> RafAlignmentFrame:
    val width = 64
    val height = 48
    val html = session.render_html_document()
    session.prepare_css_animation_instances_with_html(width, html)
    val result = (
        simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images(
            html, width, height,
            session.monotonic_time_ms - session.animation_start_time_ms,
            session.css_animation_instances, session.image_resources
        )
    )
    if result.composition.batches.len() == 0:
        fail("Expected the canonical HTML Draw IR batch")
    var stage: DrawIrCommand? = nil
    for command in result.composition.batches[0].commands:
        if command.component_id == "stage":
            stage = Some(command)
    val selected = match stage:
        Some(command): command
        nil: fail("Expected the aligned animation stage Draw IR command")
    val raster = Engine2dCompositorBackend.create_named(
        width, height, "software"
    )
    val rendered = raster.render_draw_ir_composition_resources(
        result.composition, session.image_resources
    )
    raster.shutdown()
    RafAlignmentFrame(
        command: selected,
        pixels: rendered.pixels,
        matching_pixels: _count_color(rendered.pixels, expected_color),
        rendered_commands: rendered.rendered_command_count,
        skipped_commands: rendered.skipped_command_count,
        source_kind: result.composition.batches[0].source.source_kind
    )

fn _expect_exact_raf_stage_buffer(
    frame: RafAlignmentFrame, stage_color: u32
):
    expect(frame.pixels.len()).to_equal(64 * 48)
    var mismatched_pixels = 0
    var y = 0
    while y < 48:
        var x = 0
        while x < 64:
            val expected = if x < 32 and y < 24:
                stage_color
            else:
                0xFFFFFFFFu32
            if frame.pixels[y * 64 + x] != expected:
                mismatched_pixels = mismatched_pixels + 1
            x = x + 1
        y = y + 1
    expect(mismatched_pixels).to_equal(0)  # oracle: pinned constant asserted by this scenario

# @inline
fn setup_raf_alignment_fixture() -> BrowserSession:
    var session = BrowserSession.new()
    val html = (
        "<!DOCTYPE html><html><head><style>" +
        "#stage{width:32px;height:24px;background-color:#ef4444}" +
        "</style></head><body><div id='stage'></div><script>" +
        "var frameLog='';" +
        "var stage=document.getElementById('stage');" +
        "var canceled=requestAnimationFrame(function(frameTime){" +
        "frameLog=frameLog+'canceled@'+frameTime+';';" +
        "stage.style.backgroundColor='#a855f7';});" +
        "cancelAnimationFrame(canceled);" +
        "requestAnimationFrame(function(frameTime){" +
        "frameLog=frameLog+'outer@'+frameTime+';';" +
        "stage.style.backgroundColor='#2563eb';" +
        "requestAnimationFrame(function(nestedTime){" +
        "frameLog=frameLog+'nested@'+nestedTime+';';" +
        "stage.style.backgroundColor='#16a34a';});});" +
        "setTimeout(function(){requestAnimationFrame(function(frameTime){" +
        "frameLog=frameLog+'staggered@'+frameTime+';';});},5);" +
        "</script></body></html>"
    )
    match session.open_html("https://example.test/raf-alignment", html):
        Ok(_): ()
        Err(reason): fail("rAF alignment fixture failed to open: {reason}")
    expect(session.advance_time(5)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    session

# @inline
fn check_shared_frame_deadline(session: BrowserSession):
    expect(_read_js_text(session, "typeof canceled")).to_equal("number")
    if val Some(state) = session.runtime_state:
        val tasks = state.runtime.interpreter.pending_timer_tasks
        expect(tasks.len()).to_equal(2)  # oracle: pinned constant asserted by this scenario
        for task in tasks:
            expect(task.is_animation_frame).to_equal(true)
            expect(task.scheduled_at_ms + task.delay_ms).to_equal(16)  # oracle: pinned constant asserted by this scenario
        return
    fail("Expected an active browser JavaScript runtime")

# @inline
fn check_nested_callback_deferred(session: BrowserSession):
    expect(_read_js_text(session, "frameLog")).to_equal(
        "outer@16;staggered@16;"
    )
    if val Some(state) = session.runtime_state:
        val tasks = state.runtime.interpreter.pending_timer_tasks
        expect(tasks.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(tasks[0].is_animation_frame).to_equal(true)
        expect(tasks[0].scheduled_at_ms + tasks[0].delay_ms).to_equal(32)  # oracle: pinned constant asserted by this scenario
        return
    fail("Expected the nested animation callback to remain document-owned")

# @inline
fn check_aligned_draw_ir_frames(session: BrowserSession):
    val first = _render_raf_alignment_frame(session, 0xFF2563EBu32)
    expect(first.source_kind).to_equal("html_ast")
    expect(first.command.component_id).to_equal("stage")
    expect(first.command.x).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(first.command.y).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(first.command.width).to_equal(32)  # oracle: pinned constant asserted by this scenario
    expect(first.command.height).to_equal(24)  # oracle: pinned constant asserted by this scenario
    expect(first.command.color).to_equal(0xFF2563EBu32)
    expect(first.matching_pixels).to_equal(32 * 24)
    expect(first.rendered_commands).to_be_greater_than(0)
    expect(first.skipped_commands).to_equal(0)  # oracle: pinned constant asserted by this scenario

    expect(session.advance_time(32)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    val second = _render_raf_alignment_frame(session, 0xFF16A34Au32)
    expect(second.source_kind).to_equal("html_ast")
    expect(second.command.component_id).to_equal("stage")
    expect(second.command.x).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(second.command.y).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(second.command.width).to_equal(32)  # oracle: pinned constant asserted by this scenario
    expect(second.command.height).to_equal(24)  # oracle: pinned constant asserted by this scenario
    expect(second.command.color).to_equal(0xFF16A34Au32)
    expect(second.matching_pixels).to_equal(32 * 24)
    expect(second.rendered_commands).to_be_greater_than(0)
    expect(second.skipped_commands).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(_read_js_text(session, "frameLog")).to_equal(
        "outer@16;staggered@16;nested@32;"
    )
    if val Some(state) = session.runtime_state:
        expect(state.runtime.interpreter.pending_timer_tasks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
    else:
        fail("Expected the aligned frame runtime to remain active")

# @inline
fn check_nonzero_origin_skipped_boundary():
    var session = BrowserSession.new()
    expect(session.advance_time(100)).to_equal(0)  # oracle: pinned constant asserted by this scenario
    val html = (
        "<html><body><script>var frameLog='';" +
        "requestAnimationFrame(function(frameTime){" +
        "frameLog=frameLog+'outer@'+frameTime+';';" +
        "requestAnimationFrame(function(nestedTime){" +
        "frameLog=frameLog+'nested@'+nestedTime+';';});});" +
        "setTimeout(function(){requestAnimationFrame(function(frameTime){" +
        "frameLog=frameLog+'staggered@'+frameTime+';';});},5);" +
        "</script></body></html>"
    )
    expect(session.open_html(
        "https://example.test/raf-nonzero-origin", html
    ).is_ok()).to_equal(true)
    expect(session.advance_time(105)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    if val Some(state) = session.runtime_state:
        val tasks = state.runtime.interpreter.pending_timer_tasks
        expect(tasks.len()).to_equal(2)  # oracle: pinned constant asserted by this scenario
        for task in tasks:
            expect(task.due_at_ms()).to_equal(116)  # oracle: pinned constant asserted by this scenario
    else:
        fail("Expected nonzero-origin rAF tasks")
    expect(session.advance_time(121)).to_equal(2)  # oracle: pinned constant asserted by this scenario
    expect(_read_js_text(session, "frameLog")).to_equal(
        "outer@21;staggered@21;"
    )
    if val Some(state) = session.runtime_state:
        val tasks = state.runtime.interpreter.pending_timer_tasks
        expect(tasks.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(tasks[0].due_at_ms()).to_equal(132)  # oracle: pinned constant asserted by this scenario
    else:
        fail("Expected skipped-boundary nested rAF task")
    expect(session.advance_time(132)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(_read_js_text(session, "frameLog")).to_equal(
        "outer@21;staggered@21;nested@32;"
    )

# @inline
fn check_overflow_safe_nested_frame():
    var runtime = JsRuntime.new_browser(
        Logger.new("raf-overflow", LogLevel.Error)
    )
    runtime.interpreter.timer_time_origin_ms = 9223372036854775791
    runtime.interpreter.timer_current_time_ms = 9223372036854775791
    expect(runtime.eval(
        "var frames=0;var stamp=-1;" +
        "function frame(frameTime){frames=frames+1;stamp=frameTime;" +
        "if(frames<2){requestAnimationFrame(frame);}}" +
        "requestAnimationFrame(frame);"
    ).is_ok()).to_equal(true)
    expect(runtime.drain_due_timers(9223372036854775807)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.pending_timer_tasks.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(
        runtime.interpreter.pending_timer_tasks[0].due_at_ms()
    ).to_equal(-1)  # oracle: pinned constant asserted by this scenario
    expect(runtime.drain_due_timers(9223372036854775807)).to_equal(0)  # oracle: pinned constant asserted by this scenario
    match runtime.eval("frames+':'+stamp"):
        Ok(JsValue.String(value)): expect(value).to_equal("1:16")
        Ok(_): fail("Expected overflow rAF state text")
        Err(reason): fail("Overflow rAF state read failed: {reason}")

# @inline
fn check_node_compatible_raf_refresh_metadata():
    var runtime = JsRuntime.new(
        Logger.new("raf-refresh-metadata", LogLevel.Error)
    )
    runtime.interpreter.timer_time_origin_ms = 100
    runtime.interpreter.timer_current_time_ms = 105
    expect(runtime.eval(
        "var frameTimes='';var handle=requestAnimationFrame(" +
        "function(frameTime){frameTimes=frameTimes+frameTime+';';});"
    ).is_ok()).to_equal(true)
    runtime.interpreter.timer_current_time_ms = 109
    match runtime.eval("handle.refresh()===handle"):
        Ok(JsValue.Boolean(value)): expect(value).to_equal(true)
        Ok(_): fail("Expected pending rAF refresh identity")
        Err(reason): fail("Pending rAF refresh failed: {reason}")
    match runtime.eval(
        "handle.delay+':'+handle.scheduledAt+':'+handle.dueAt+':'+" +
        "handle.refreshedAt"
    ):
        Ok(JsValue.String(value)): expect(value).to_equal("7:109:116:109")
        Ok(_): fail("Expected pending rAF refresh metadata text")
        Err(reason): fail("Pending rAF refresh metadata failed: {reason}")
    expect(runtime.drain_due_timers(116)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    match runtime.eval(
        "handle.active+':'+handle.completed+':'+handle.lastFiredAt"
    ):
        Ok(JsValue.String(value)): expect(value).to_equal("false:true:116")
        Ok(_): fail("Expected completed rAF metadata text")
        Err(reason): fail("Completed rAF metadata failed: {reason}")
    match runtime.eval("handle.refresh()===handle"):
        Ok(JsValue.Boolean(value)): expect(value).to_equal(true)
        Ok(_): fail("Expected completed rAF refresh identity")
        Err(reason): fail("Completed rAF refresh failed: {reason}")
    match runtime.eval(
        "handle.delay+':'+handle.scheduledAt+':'+handle.dueAt+':'+" +
        "handle.refreshedAt"
    ):
        Ok(JsValue.String(value)): expect(value).to_equal("16:116:132:116")
        Ok(_): fail("Expected completed rAF refresh metadata text")
        Err(reason): fail("Completed rAF refresh metadata failed: {reason}")
    expect(runtime.drain_due_timers(132)).to_equal(1)  # oracle: pinned constant asserted by this scenario
    match runtime.eval("frameTimes"):
        Ok(JsValue.String(value)): expect(value).to_equal("16;32;")
        Ok(_): fail("Expected refreshed rAF timestamp text")
        Err(reason): fail("Refreshed rAF timestamp read failed: {reason}")

# @inline
fn setup_cancel_domain_fixture() -> BrowserSession:
    var session = BrowserSession.new()
    val html = (
        "<!DOCTYPE html><html><head><style>" +
        "#stage{width:32px;height:24px;background-color:#ef4444}" +
        "</style></head><body><div id='stage'></div><script>" +
        "var callbackLog='';var clickCount=0;var frameStamp=-1;" +
        "var stage=document.getElementById('stage');" +
        "stage.addEventListener('click',function(){" +
        "clickCount=clickCount+1;},{once:true});" +
        "var frameHandle=requestAnimationFrame(function(frameTime){" +
        "callbackLog=callbackLog+'F';frameStamp=frameTime;" +
        "stage.style.backgroundColor='#2563eb';});" +
        "var timeoutHandle=setTimeout(function(){" +
        "callbackLog=callbackLog+'T';},16);" +
        "clearTimeout(frameHandle);cancelAnimationFrame(timeoutHandle);" +
        "var canceledFrame=requestAnimationFrame(function(){" +
        "callbackLog=callbackLog+'X';});" +
        "cancelAnimationFrame(canceledFrame);" +
        "var canceledTimeout=setTimeout(function(){" +
        "callbackLog=callbackLog+'Y';},16);" +
        "clearTimeout(canceledTimeout);" +
        "</script></body></html>"
    )
    expect(session.open_html(
        "https://example.test/raf-cancel-domain", html
    ).is_ok()).to_equal(true)
    session

# @inline
fn check_cancel_domain_registration(session: BrowserSession):
    expect(_read_js_text(
        session,
        "callbackLog+':'+clickCount+':'+frameStamp"
    )).to_equal(":0:-1")
    if val Some(state) = session.runtime_state:
        expect(state.runtime.interpreter.pending_timer_tasks.len()).to_equal(2)  # oracle: pinned constant asserted by this scenario
        expect(state.dom_callable_listeners.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(state.dom_callable_listeners[0].event_type).to_equal("click")
        return
    fail("Expected cancellation-domain callbacks to remain document-owned")

# @inline
fn check_node_cancel_domain_handle_metadata():
    var runtime = JsRuntime.new(
        Logger.new("raf-cancel-domain", LogLevel.Error)
    )
    expect(runtime.eval(
        "var log='';" +
        "var frame=requestAnimationFrame(function(){log+='F';});" +
        "var timer=setTimeout(function(){log+='T';},16);" +
        "clearTimeout(frame);clearImmediate(frame);" +
        "cancelAnimationFrame(timer);clearImmediate(timer);" +
        "var intervalControl=setInterval(function(){log+='I';},16);" +
        "clearTimeout(intervalControl);" +
        "var timeoutControl=setTimeout(function(){log+='X';},16);" +
        "clearInterval(timeoutControl);" +
        "var immediate=setImmediate(function(){log+='M';});" +
        "clearTimeout(immediate);cancelAnimationFrame(immediate);" +
        "var timerWrong=setTimeout(function(){log+='U';},16);" +
        "clearImmediate(timerWrong);" +
        "var immediateControl=setImmediate(function(){log+='C';});" +
        "clearImmediate(immediateControl);" +
        "var frameClose=requestAnimationFrame(function(){log+='Z';});" +
        "frameClose.close();" +
        "var immediateClose=setImmediate(function(){log+='Q';});" +
        "immediateClose.close();" +
        "process.nextTick(function(){log+='N';});"
    ).is_ok()).to_equal(true)
    var next_tick_timer_id: i64 = -1
    for task in runtime.interpreter.pending_timer_tasks:
        if task.is_next_tick:
            next_tick_timer_id = task.id
    expect(next_tick_timer_id).to_be_greater_than(0)
    for clear_name in [
        "clearTimeout", "clearInterval", "clearImmediate",
        "cancelAnimationFrame"
    ]:
        match runtime.eval(
            clear_name + "(" + next_tick_timer_id.to_text() + ");"
        ):
            Ok(_): ()
            Err(reason): fail("Public clear failed to evaluate: {reason}")
        expect(runtime.interpreter.pending_timer_tasks.len()).to_equal(5)  # oracle: pinned constant asserted by this scenario
        var next_tick_retained = false
        for task in runtime.interpreter.pending_timer_tasks:
            if task.id == next_tick_timer_id and task.is_next_tick:
                next_tick_retained = true
        expect(next_tick_retained).to_equal(true)
    match runtime.eval(
        "frame.active+':'+frame.closed+':'+frame.cleared+':'+" +
        "frame.clearedBy+':'+timer.active+':'+timer.closed+':'+" +
        "timer.cleared+':'+timer.clearedBy+':'+" +
        "immediate.active+':'+immediate.closed+':'+immediate.cleared+':'+" +
        "immediate.clearedBy+':'+timerWrong.active+':'+" +
        "timerWrong.closed+':'+timerWrong.cleared+':'+" +
        "timerWrong.clearedBy"
    ):
        Ok(JsValue.String(value)):
            expect(value).to_equal(
                "true:false:false::true:false:false::" +
                "true:false:false::true:false:false:"
            )
        Ok(_): fail("Expected wrong-kind handle metadata text")
        Err(reason): fail("Wrong-kind handle metadata read failed: {reason}")
    match runtime.eval(
        "intervalControl.clearedBy+':'+timeoutControl.clearedBy+':'+" +
        "immediateControl.clearedBy+':'+frameClose.clearedBy+':'+" +
        "immediateClose.clearedBy"
    ):
        Ok(JsValue.String(value)):
            expect(value).to_equal(
                "clearTimeout:clearInterval:clearImmediate:close:close"
            )
        Ok(_): fail("Expected same-kind and close metadata text")
        Err(reason): fail("Timer cancellation metadata read failed: {reason}")
    expect(runtime.interpreter.pending_timer_tasks.len()).to_equal(5)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_ids.len()).to_equal(4)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_object_ids.len()).to_equal(4)  # oracle: pinned constant asserted by this scenario
    var timeout_tasks = 0
    var immediate_tasks = 0
    var animation_frame_tasks = 0
    var next_tick_tasks = 0
    for task in runtime.interpreter.pending_timer_tasks:
        if task.is_next_tick:
            next_tick_tasks = next_tick_tasks + 1
        elif task.is_animation_frame:
            animation_frame_tasks = animation_frame_tasks + 1
        elif task.is_immediate:
            immediate_tasks = immediate_tasks + 1
        else:
            timeout_tasks = timeout_tasks + 1
    expect(timeout_tasks).to_equal(2)  # oracle: pinned constant asserted by this scenario
    expect(immediate_tasks).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(animation_frame_tasks).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(next_tick_tasks).to_equal(1)  # oracle: pinned constant asserted by this scenario
    expect(runtime.drain_due_timers(0)).to_equal(2)  # oracle: pinned constant asserted by this scenario
    match runtime.eval("log"):
        Ok(JsValue.String(value)): expect(value).to_equal("NM")
        Ok(_): fail("Expected nextTick and immediate callback order text")
        Err(reason): fail("Immediate callback order read failed: {reason}")
    expect(runtime.interpreter.pending_timer_tasks.len()).to_equal(3)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_ids.len()).to_equal(3)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_object_ids.len()).to_equal(3)  # oracle: pinned constant asserted by this scenario
    expect(runtime.drain_due_timers(16)).to_equal(3)  # oracle: pinned constant asserted by this scenario
    match runtime.eval("log"):
        Ok(JsValue.String(value)): expect(value).to_equal("NMFTU")
        Ok(_): fail("Expected wrong-kind Node callback order text")
        Err(reason): fail("Wrong-kind Node callback order read failed: {reason}")
    expect(runtime.interpreter.pending_timer_tasks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(runtime.interpreter.timer_handle_object_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario

# @inline
fn check_cancel_domain_pixels_and_resources(session: BrowserSession):
    val frame = _render_raf_alignment_frame(session, 0xFF2563EBu32)
    expect(frame.source_kind).to_equal("html_ast")
    expect(frame.command.component_id).to_equal("stage")
    expect(frame.command.x).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(frame.command.y).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(frame.command.width).to_equal(32)  # oracle: pinned constant asserted by this scenario
    expect(frame.command.height).to_equal(24)  # oracle: pinned constant asserted by this scenario
    expect(frame.command.color).to_equal(0xFF2563EBu32)
    expect(frame.matching_pixels).to_equal(32 * 24)
    expect(frame.rendered_commands).to_be_greater_than(0)
    expect(frame.skipped_commands).to_equal(0)  # oracle: pinned constant asserted by this scenario
    _expect_exact_raf_stage_buffer(frame, 0xFF2563EBu32)
    if val Some(state) = session.runtime_state:
        val interpreter = state.runtime.interpreter
        expect(interpreter.pending_timer_tasks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.timer_handle_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.timer_handle_object_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_ops.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_target_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_types.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_callbacks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_captures.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_once_flags.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        var active_listeners = 0
        for listener in state.dom_callable_listeners:
            if listener.event_type != "":
                active_listeners = active_listeners + 1
            else:
                match listener.callback:
                    JsValue.Undefined: ()
                    _: fail("Expected the once-listener callback to be released")
        expect(active_listeners).to_equal(0)  # oracle: pinned constant asserted by this scenario
        return
    fail("Expected cancellation-domain resources to remain observable")

# @inline
fn check_worker_wakeup_saturates_after_drain_cap():
    var session = BrowserSession.new()
    expect(session.advance_time(9223372036854775791)).to_equal(0)  # oracle: pinned constant asserted by this scenario
    expect(session.open_html(
        "https://example.test/raf-worker-wakeup-cap",
        "<html><body><script>function noop(){}" +
        "for(var i=0;i<1001;i=i+1){" +
        "requestAnimationFrame(noop);}</script></body></html>"
    ).is_ok()).to_equal(true)
    expect(session.advance_time(9223372036854775807)).to_equal(1000)  # oracle: pinned constant asserted by this scenario
    val remaining_due = session.next_script_timer_due_ms()
    expect(remaining_due).to_equal(9223372036854775807)  # oracle: pinned constant asserted by this scenario
    val wakeup = hosted_browser_renderer_safe_wakeup_ms(
        remaining_due, 9223372036854775807
    )
    expect(wakeup).to_equal(9223372036854775807)  # oracle: pinned constant asserted by this scenario
    expect(wakeup).to_be_greater_than(-1)
    if val Some(state) = session.runtime_state:
        expect(
            state.runtime.interpreter.pending_timer_tasks.len()
        ).to_equal(1)  # oracle: pinned constant asserted by this scenario
    else:
        fail("Expected one capped rAF task to remain document-owned")

