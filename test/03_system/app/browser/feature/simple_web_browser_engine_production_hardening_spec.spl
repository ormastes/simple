# codex-system-test
# @req REQ-WEB-BROWSER-001 REQ-WEB-BROWSER-002 REQ-WEB-BROWSER-003 REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-009 REQ-WEB-BROWSER-020 REQ-WEB-BROWSER-021 NFR-WEB-BROWSER-002 NFR-WEB-BROWSER-003 NFR-WEB-BROWSER-004 NFR-WEB-BROWSER-009
# @evidence-display: links
"""# Production Simple Browser User Flow

Proves the installed browser uses canonical HTML, CSS, JavaScript, DOM-event,
Draw IR, and Engine2D paths, then drives page controls and browser chrome
through structured UI access. Helpers fail closed until production evidence
exists.
"""
use std.spec.*
use std.env.variables.{env_get}
use std.io_runtime.{file_hash_sha256}
use app.io.mod.{thread_sleep_ms}
use common.ui.draw_ir.{DRAW_IR_COMMAND_TEXT}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_browser_renderer_process.{
    HostedBrowserRendererProcess, HostedBrowserRendererResult
}
use os.hosted.hosted_web_content_session.{
    HostedWebContentRegistry, HostedWebContentSession
}
use os.hosted.browser_profile_store.{BrowserBookmarkStore}
use std.gc_async_mut.web.browser_session.{BrowserResponse}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*

val SUBPROCESS_ANIMATION_HTML = (
    "<style>@keyframes Pulse{from{background-color:#ef4444}" +
    "to{background-color:#2563eb}}#stage{width:32px;height:24px;" +
    "animation:Pulse 16ms linear forwards}</style>" +
    "<script type='text/simple'>title \"SimpleReady\"\n" +
    "body_html '<div id=\"stage\"></div>'</script>" +
    "<script>requestAnimationFrame(function(){" +
    "var stage=document.getElementById('stage');" +
    "stage.style.backgroundColor='#2563eb';" +
    "document.title='Animated';});</script>"
)

fn _count_color(pixels: [u32], color: u32) -> i64:
    var count: i64 = 0
    for pixel in pixels:
        if pixel == color:
            count = count + 1
    count

fn _pixels_equal(left: [u32], right: [u32]) -> bool:
    if left.len() != right.len():
        return false
    var index: i64 = 0
    while index < left.len():
        if left[index] != right[index]:
            return false
        index = index + 1
    true

fn _await_browser_animation(
    renderer: HostedBrowserRendererProcess
) -> HostedBrowserRendererResult?:
    var attempts: i64 = 0
    while attempts < 250:
        match renderer.poll():
            Some(frame):
                return Some(frame)
            nil:
                thread_sleep_ms(1)
        attempts = attempts + 1
    nil

fn _close_browser_animation_evidence(
    renderer: HostedBrowserRendererProcess,
    raster: Engine2dCompositorBackend
):
    val closed = renderer.close()
    raster.shutdown()
    if not closed:
        fail("browser renderer cleanup failed")

# @inline
fn _production_browser_fixture():
    step("Launch the production Simple browser")

# @inline
fn _open_conformance_page():
    step("Open the conformance page")

# @inline
fn _check_canonical_draw_ir():
    step("Render HTML and CSS through canonical Draw IR")

# @inline
fn _advance_browser_clock():
    step("Run JavaScript and advance the browser clock")

# @inline
fn _operate_page_controls():
    step("Operate page controls")

# @inline
fn _operate_browser_navigation():
    step("Operate browser navigation controls")

fn _require_production_browser_evidence():
    fail("REQ-WEB-BROWSER-001..009: production browser evidence not implemented")

describe "Production Simple browser user flow":
    # @manual: show
    # @capture(html)
    # @capture(text)
    # @capture(artifact)
    # @capture(gui)
    it "should render the supported HTML and CSS profile through canonical Draw IR":
        _production_browser_fixture()
        _open_conformance_page()
        _check_canonical_draw_ir()
        val artifact = env_get("HOSTED_WM_ARTIFACT")
        val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
        if artifact == "":
            fail("HOSTED_WM_ARTIFACT must name the hosted_entry native binary")
        if expected_artifact_sha.len() != 64 or
            file_hash_sha256(artifact) != expected_artifact_sha:
            fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")
        var renderer = HostedBrowserRendererProcess.create(2, 64, 48)
        val raster = Engine2dCompositorBackend.create_named(
            64, 48, "software"
        )
        val started = renderer.start(artifact, 2000)
        if not started.ok:
            val closed = renderer.close()
            raster.shutdown()
            if not closed:
                fail("browser renderer cleanup failed after launch failure")
            fail("browser renderer launch failed: {started.reason}")
        val frame = renderer.render(
            "init",
            "<style>.card{position:absolute;left:4px;top:6px;width:48px;height:30px;background-color:#ef4444;color:#ffffff;font-size:8px}#stage{background-color:#2563eb}</style><section><div id='stage' class='card'>Cascade text</div></section>",
            2000
        )
        if not frame.ok:
            _close_browser_animation_evidence(renderer, raster)
            fail("browser renderer static frame failed: {frame.reason}")
        val rendered = raster.render_draw_ir_composition(frame.composition, [])
        var text_commands: i64 = 0
        for batch in frame.composition.batches:
            for command in batch.commands:
                if command.kind == DRAW_IR_COMMAND_TEXT and
                    command.text_value == "Cascade text":
                    text_commands = text_commands + 1
        val blue_pixels = _count_color(rendered.pixels, 0xFF2563EBu32)
        val red_pixels = _count_color(rendered.pixels, 0xFFEF4444u32)
        _close_browser_animation_evidence(renderer, raster)
        expect(frame.composition.batches.len()).to_be_greater_than(0)
        expect(frame.composition.batches[0].commands.len()).to_be_greater_than(0)
        expect(text_commands).to_be_greater_than(0)
        expect(rendered.fallback_required).to_equal(false)
        expect(rendered.rendered_command_count).to_be_greater_than(0)
        expect(rendered.pixels.len()).to_equal(64 * 48)
        expect(blue_pixels).to_be_greater_than(1000)
        expect(red_pixels).to_equal(0)
        expect(frame.next_animation_ms).to_equal(-1)

    # @manual: show
    # @capture(html)
    # @capture(artifact)
    # @capture(gui)
    it "should animate JavaScript timers requestAnimationFrame and CSS on one clock":
        _production_browser_fixture()
        _advance_browser_clock()
        _check_canonical_draw_ir()
        val artifact = env_get("HOSTED_WM_ARTIFACT")
        val expected_artifact_sha = env_get("HOSTED_WM_ARTIFACT_SHA256")
        if artifact == "":
            fail("HOSTED_WM_ARTIFACT must name the hosted_entry native binary")
        if expected_artifact_sha.len() != 64 or
            file_hash_sha256(artifact) != expected_artifact_sha:
            fail("HOSTED_WM_ARTIFACT does not match its admitted SHA-256")
        var renderer = HostedBrowserRendererProcess.create(1, 64, 48)
        val raster = Engine2dCompositorBackend.create_named(
            64, 48, "software"
        )
        val started = renderer.start(artifact, 2000)
        if not started.ok:
            raster.shutdown()
            fail("browser renderer launch failed: {started.reason}")
        val initial = renderer.render(
            "init", SUBPROCESS_ANIMATION_HTML, 2000
        )
        if not initial.ok:
            _close_browser_animation_evidence(renderer, raster)
            fail("browser renderer initial frame failed: {initial.reason}")
        val first = raster.render_draw_ir_composition(
            initial.composition, []
        )
        match renderer.begin_advance(16, 2000):
            Err(reason):
                _close_browser_animation_evidence(renderer, raster)
                fail("browser renderer animation start failed: {reason}")
            Ok(started_advance):
                if not started_advance:
                    _close_browser_animation_evidence(renderer, raster)
                    fail("browser renderer animation did not start")
        val advanced = match _await_browser_animation(renderer):
            Some(frame):
                frame
            nil:
                _close_browser_animation_evidence(renderer, raster)
                fail("browser renderer animation poll exhausted")
        if not advanced.ok:
            _close_browser_animation_evidence(renderer, raster)
            fail("browser renderer animation frame failed: {advanced.reason}")
        val second = raster.render_draw_ir_composition(
            advanced.composition, []
        )
        val initial_red = _count_color(first.pixels, 0xFFEF4444u32)
        val advanced_blue = _count_color(second.pixels, 0xFF2563EBu32)
        val changed = not _pixels_equal(first.pixels, second.pixels)
        _close_browser_animation_evidence(renderer, raster)
        expect(initial.next_animation_ms).to_equal(16)
        expect(initial.composition.batches.len()).to_be_greater_than(0)
        expect(
            initial.composition.batches[0].commands.len()
        ).to_be_greater_than(0)
        expect(first.rendered_command_count).to_be_greater_than(0)
        expect(first.pixels.len()).to_equal(64 * 48)
        expect(initial_red).to_be_greater_than(0)
        expect(second.rendered_command_count).to_be_greater_than(0)
        expect(second.pixels.len()).to_equal(64 * 48)
        expect(advanced_blue).to_be_greater_than(0)
        expect(changed).to_equal(true)
        expect(advanced.next_animation_ms).to_equal(-1)

    # @manual: show
    # @capture(text)
    # @capture(gui)
    it "should route hosted pointer focus key edges and text into a form control":
        _production_browser_fixture()
        _operate_page_controls()
        step("Verify semantic state event history and rendered output")
        var session = HostedWebContentSession.create(
            8,
            "<style>#name{display:block;width:40px;height:28px;" +
            "background-color:#ef4444}" +
            "#name[data-input=yes]{background-color:#2563eb}</style>" +
            "<form><input id='name' value='' " +
            "onfocus='set-attr:data-focus=yes' " +
            "onkeydown='set-attr:data-down=yes' " +
            "onbeforeinput='set-attr:data-before=yes' " +
            "oninput='set-attr:data-input=yes' " +
            "onkeyup='set-attr:data-up=yes'></form>",
            80, 40
        )
        expect(_count_color(
            session.render_to_pixels(), 0xFFEF4444u32
        )).to_be_greater_than(0)

        val press = session.dispatch_pointer_at(1, 5, 5, true)
        val release = session.dispatch_pointer_at(2, 5, 5, false)
        val key_down = session.dispatch_key(3, 87, true)
        val edited = session.dispatch_text(4, "Ada")
        val key_up = session.dispatch_key(5, 87, false)

        expect(press.semantic_target_id).to_equal("name")
        expect(release.semantic_target_id).to_equal("name")
        expect(session.last_target_id).to_equal("name")
        expect(key_down.semantic_target_id).to_equal("name")
        expect(edited.semantic_target_id).to_equal("name")
        expect(key_up.semantic_target_id).to_equal("name")
        expect(session.current_body_html()).to_contain("value=\"Ada\"")
        expect(session.current_body_html()).to_contain("data-focus=\"yes\"")
        expect(session.current_body_html()).to_contain("data-down=\"yes\"")
        expect(session.current_body_html()).to_contain("data-before=\"yes\"")
        expect(session.current_body_html()).to_contain("data-input=\"yes\"")
        expect(session.current_body_html()).to_contain("data-up=\"yes\"")
        expect(_count_color(
            session.render_to_pixels(), 0xFF2563EBu32
        )).to_be_greater_than(0)

    # @manual: folded
    it "should cancel a default action after capture target and bubble dispatch":
        _production_browser_fixture()
        step("Cancel a default action after capture target and bubble dispatch")
        _require_production_browser_evidence()

    # @manual: show
    # @capture(text)
    # @capture(protocol)
    # @capture(gui)
    it "should operate address back and forward through hosted structured UI access":
        _production_browser_fixture()
        _operate_browser_navigation()
        var session = HostedWebContentSession.create(
            7,
            "<style>#page{width:32px;height:24px;" +
            "background-color:#ef4444}</style>" +
            "<div id='page'>Start</div>",
            64, 48
        )
        session.browser.register_resource(
            "https://example.test/target",
            "<html><head><style>#page{width:32px;height:24px;" +
            "background-color:#2563eb}</style></head>" +
            "<body><div id='page'>Target</div></body></html>"
        )
        expect(_count_color(
            session.render_to_pixels(), 0xFFEF4444u32
        )).to_be_greater_than(0)

        val address_down = session.dispatch_chrome_pointer(
            1, "address", true
        )
        val address_up = session.dispatch_chrome_pointer(
            2, "address", false
        )
        val edited = session.dispatch_text(
            3, "https://example.test/target"
        )
        val submitted = session.dispatch_key(4, 13, true)
        expect(address_down.semantic_target_id).to_equal(
            "browser:session#address"
        )
        expect(address_up.reason).to_equal("address-focused")
        expect(edited.callback_count).to_equal(1)
        expect(submitted.callback_count).to_equal(1)
        expect(session.browser.current_url).to_equal(
            "https://example.test/target"
        )
        expect(session.current_body_html()).to_contain("Target")
        expect(_count_color(
            session.render_to_pixels(), 0xFF2563EBu32
        )).to_be_greater_than(0)

        val back_down = session.dispatch_chrome_pointer(5, "back", true)
        val back_up = session.dispatch_chrome_pointer(6, "back", false)
        expect(back_down.semantic_target_id).to_equal(
            "browser:session#back"
        )
        expect(back_up.callback_count).to_equal(1)
        expect(session.current_body_html()).to_contain("Start")
        expect(_count_color(
            session.render_to_pixels(), 0xFFEF4444u32
        )).to_be_greater_than(0)

        val forward_down = session.dispatch_chrome_pointer(
            7, "forward", true
        )
        val forward_up = session.dispatch_chrome_pointer(
            8, "forward", false
        )
        expect(forward_down.semantic_target_id).to_equal(
            "browser:session#forward"
        )
        expect(forward_up.callback_count).to_equal(1)
        expect(session.current_body_html()).to_contain("Target")
        expect(_count_color(
            session.render_to_pixels(), 0xFF2563EBu32
        )).to_be_greater_than(0)

    # @manual: show
    # @capture(text)
    # @capture(gui)
    it "should reload saved source and open registered Home through hosted chrome":
        var session = HostedWebContentSession.create(
            10,
            "<style>#page{width:32px;height:24px;" +
            "background-color:#ef4444}</style>" +
            "<div id='page'>Original</div>",
            64, 48
        )
        expect(session.browser.eval_script(
            "document.body.innerHTML='<div id=\"mutated\">Mutated</div>'"
        ).is_ok()).to_equal(true)
        expect(session.current_body_html()).to_contain("Mutated")

        val reload_down = session.dispatch_chrome_pointer(
            1, "reload", true
        )
        val reload_up = session.dispatch_chrome_pointer(
            2, "reload", false
        )
        expect(reload_down.semantic_target_id).to_equal(
            "browser:session#reload"
        )
        expect(reload_up.callback_count).to_equal(1)
        expect(session.current_body_html()).to_contain("Original")
        expect(_count_color(
            session.render_to_pixels(), 0xFFEF4444u32
        )).to_be_greater_than(0)

        session.browser.register_resource(
            "https://example.test/home",
            "<html><head><style>#home{width:32px;height:24px;" +
            "background-color:#16a34a}</style></head>" +
            "<body><div id='home'>Home</div></body></html>"
        )
        session.browser.set_home_url("https://example.test/home")
        val home_down = session.dispatch_chrome_pointer(3, "home", true)
        val home_up = session.dispatch_chrome_pointer(4, "home", false)
        expect(home_down.semantic_target_id).to_equal(
            "browser:session#home"
        )
        expect(home_up.callback_count).to_equal(1)
        expect(session.browser.current_url).to_equal(
            "https://example.test/home"
        )
        expect(session.current_body_html()).to_contain("Home")
        expect(_count_color(
            session.render_to_pixels(), 0xFF16A34Au32
        )).to_be_greater_than(0)

    # @manual: show
    # @capture(text)
    # @capture(gui)
    it "should hit a page link and render its registered target":
        var session = HostedWebContentSession.create(
            11,
            "<style>#next{display:block;width:32px;height:24px;" +
            "background-color:#ef4444}</style>" +
            "<a id='next' href='https://example.test/linked'>Open</a>",
            64, 48
        )
        session.browser.register_resource(
            "https://example.test/linked",
            "<html><head><style>#linked{width:32px;height:24px;" +
            "background-color:#2563eb}</style></head>" +
            "<body><div id='linked'>Linked</div></body></html>"
        )
        val before = session.render_to_pixels()
        expect(_count_color(before, 0xFFEF4444u32)).to_be_greater_than(0)

        val press = session.dispatch_pointer_at(1, 5, 5, true)
        val release = session.dispatch_pointer_at(2, 5, 5, false)
        expect(press.semantic_target_id).to_equal("next")
        expect(release.semantic_target_id).to_equal("next")
        expect(session.browser.current_url).to_equal(
            "https://example.test/linked"
        )
        expect(session.current_body_html()).to_contain("Linked")
        val after = session.render_to_pixels()
        expect(_pixels_equal(after, before)).to_equal(false)
        expect(_count_color(after, 0xFF2563EBu32)).to_be_greater_than(0)

    # @manual: show
    # @capture(text)
    it "should persist Favorite through the hosted profile registry":
        var registry = HostedWebContentRegistry.create_with_bookmark_store(
            BrowserBookmarkStore.memory()?
        )
        val _ = registry.advance_window(
            12, "<div>Browser</div>", 64, 48, 1000, true
        )
        var session = registry.sessions[0]
        val opened = session.browser.open_html(
            "https://example.test/saved",
            "<html><body><div>Saved</div></body></html>"
        ).is_ok()
        registry.sessions[0] = session

        val favorite_down = registry.dispatch_chrome_pointer(
            1, 12, "favorite", true
        )
        val favorite_up = registry.dispatch_chrome_pointer(
            2, 12, "favorite", false
        )
        val favorite_target = favorite_down.semantic_target_id
        val favorite_callbacks = favorite_up.callback_count
        val saved = registry.sessions[0].browser.is_favorite(
            "https://example.test/saved"
        )
        val bookmark_count = registry.profile_bookmarks.entries.len()
        val closed = registry.close()
        expect(opened).to_equal(true)
        expect(favorite_target).to_equal("browser:session#favorite")
        expect(favorite_callbacks).to_equal(1)
        expect(saved).to_equal(true)
        expect(bookmark_count).to_equal(1)
        expect(closed).to_equal(true)

    # @manual: folded
    it "should reject stale targets invalid addresses and late stopped navigation commits":
        _production_browser_fixture()
        step("Stop an in-flight navigation before it commits")
        var session = HostedWebContentSession.create(
            9,
            "<style>#prior{width:32px;height:24px;" +
            "background-color:#ef4444}</style>" +
            "<div id='prior'>Prior</div>",
            64, 48
        )
        val prior_body = session.current_body_html()
        val prior_pixels = session.render_to_pixels()

        val _ = session.dispatch_chrome_pointer(1, "address", true)
        val address_up = session.dispatch_chrome_pointer(
            2, "address", false
        )
        val address_edit = session.dispatch_text(
            3, "javascript:alert(1)"
        )
        val invalid_submit = session.dispatch_key(4, 13, true)
        expect(address_up.reason).to_equal("address-focused")
        expect(address_edit.callback_count).to_equal(1)
        expect(invalid_submit.callback_count).to_equal(0)
        expect(session.browser.current_url).to_equal("simple-wm://window/9")
        expect(session.browser.has_pending_requests()).to_equal(false)

        expect(session.browser.begin_network_navigation(
            "https://slow.example.test/page", "GET", "", "", ""
        ).is_ok()).to_equal(true)
        val pending = session.browser.take_pending_request()
        if pending == nil:
            fail("expected pending HTTPS document request")

        val _ = session.dispatch_chrome_pointer(5, "reload", true)
        val stale_release = session.dispatch_chrome_pointer(
            6, "stop", false
        )
        expect(stale_release.reason).to_equal(
            "chrome-release-target-mismatch"
        )
        expect(session.browser.can_stop_loading()).to_equal(true)

        val stop_down = session.dispatch_chrome_pointer(7, "stop", true)
        val stop_up = session.dispatch_chrome_pointer(8, "stop", false)
        expect(stop_down.semantic_target_id).to_equal(
            "browser:session#stop"
        )
        expect(stop_up.callback_count).to_equal(1)
        expect(session.browser.can_stop_loading()).to_equal(false)

        val request = pending.unwrap()
        val late = session.browser.commit_network_response(
            BrowserResponse.create(
                request_id: request.id,
                kind: request.kind,
                url: request.url,
                status: 200,
                headers: "",
                body: "<html><body>Late</body></html>",
                error: ""
            )
        )
        expect(late.is_err()).to_equal(true)
        expect(session.current_body_html()).to_equal(prior_body)
        val final_pixels = session.render_to_pixels()
        expect(_pixels_equal(final_pixels, prior_pixels)).to_equal(true)
        expect(_count_color(
            final_pixels, 0xFFEF4444u32
        )).to_be_greater_than(0)

    # @manual: folded
    it "should report unsupported content without fake success":
        _production_browser_fixture()
        step("Open unsupported and malformed compatibility fixtures")
        _require_production_browser_evidence()
