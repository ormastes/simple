"""
## Purpose and audience
Verifies the browser css animation equal replacement behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-021
# doc-path: doc/01_research/local/browser_wasm_webgpu_infra.md
# doc-path: doc/03_plan/sys_test/browser_wasm_webgpu_infra.md
# doc-path: doc/04_architecture/browser_wasm_webgpu_infra.md
# doc-path: doc/05_design/browser_wasm_webgpu_infra.md
# codex-system-test
# @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-021
"""# Equal innerHTML CSS Animation Restart

**Requirements:** doc/02_requirements/feature/simple_web_browser_engine_production_hardening.md
**Plan:** doc/03_plan/sys_test/html_css_spec_traceability.md
**Design:** doc/05_design/simple_web_browser_engine_production_hardening.md
**Research:** doc/01_research/local/simple_web_browser_engine_production_hardening.md

## Overview

An explicit body `innerHTML` replacement creates fresh descendant elements even
when the replacement bytes equal the current body markup. Their CSS animations
restart at the replacement epoch. Ordinary class and style mutations preserve
that epoch, and the resulting frame still lowers through canonical Draw IR.
"""

use std.spec.*

use common.ui.draw_ir.{DrawIrCommand}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use std.gc_async_mut.web.browser_session.{BrowserSession}
use std.gc_async_mut.web.browser_session_loading.*
use std.gc_async_mut.web.browser_session_runtime.*
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images
}
use std.js.types.js_types.{JsValue}

class EqualReplacementFrame:
    command: DrawIrCommand
    pixels: [u32]
    rendered_commands: i32
    skipped_commands: i32
    source_kind: text

fn _read_equal_replacement_text(
    session: BrowserSession, expression: text
) -> text:
    match session.eval_script(expression):
        Ok(JsValue.String(value)): value
        Ok(_): fail("Expected JavaScript string result for {expression}")
        Err(reason): fail("JavaScript state read failed: {reason}")

fn _render_equal_replacement_frame(
    session: BrowserSession
) -> EqualReplacementFrame:
    val width = 32
    val height = 24
    val html = session.render_html_document()
    session.prepare_css_animation_instances_with_html(width, html)
    val result = (
        simple_web_layout_render_html_draw_ir_result_at_time_with_animations_with_images(
            html, width, height,
            session.monotonic_time_ms - session.animation_start_time_ms,
            session.css_animation_instances, session.image_resources
        )
    )
    if result.composition.batches.len() == 0:
        fail("Expected the canonical HTML Draw IR batch")
    var stage: DrawIrCommand? = nil
    for command in result.composition.batches[0].commands:
        if command.component_id == "stage":
            stage = Some(command)
    val selected = match stage:
        Some(command): command
        nil: fail("Expected the replaced animation stage Draw IR command")
    val raster = Engine2dCompositorBackend.create_named(
        width, height, "software"
    )
    val rendered = raster.render_draw_ir_composition_resources(
        result.composition, session.image_resources
    )
    raster.shutdown()
    EqualReplacementFrame(
        command: selected,
        pixels: rendered.pixels,
        rendered_commands: rendered.rendered_command_count,
        skipped_commands: rendered.skipped_command_count,
        source_kind: result.composition.batches[0].source.source_kind
    )

fn _expect_exact_equal_replacement_buffer(frame: EqualReplacementFrame):
    expect(frame.pixels.len()).to_equal(32 * 24)
    var red_pixels = 0
    var white_pixels = 0
    var mismatched_pixels = 0
    var y = 0
    while y < 24:
        var x = 0
        while x < 32:
            val expected = if x < 8 and y < 16:
                0xFFEF4444u32
            else:
                0xFFFFFFFFu32
            val pixel = frame.pixels[y * 32 + x]
            if pixel == 0xFFEF4444u32:
                red_pixels = red_pixels + 1
            if pixel == 0xFFFFFFFFu32:
                white_pixels = white_pixels + 1
            if pixel != expected:
                mismatched_pixels = mismatched_pixels + 1
            x = x + 1
        y = y + 1
    expect(red_pixels).to_equal(8 * 16)
    expect(white_pixels).to_equal((32 * 24) - (8 * 16))
    expect(mismatched_pixels).to_equal(0)  # oracle: pinned constant asserted by this scenario

fn _expect_released_equal_replacement_callbacks(session: BrowserSession):
    if val Some(state) = session.runtime_state:
        val interpreter = state.runtime.interpreter
        expect(interpreter.pending_timer_tasks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.timer_handle_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.timer_handle_object_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_ops.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_target_ids.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_types.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_callbacks.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_captures.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(interpreter.pending_host_event_once_flags.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        var active_listeners = 0
        for listener in state.dom_callable_listeners:
            if listener.event_type != "":
                active_listeners = active_listeners + 1
            else:
                match listener.callback:
                    JsValue.Undefined: ()
                    _: fail("Expected the once-listener callback to be released")
        expect(active_listeners).to_equal(0)  # oracle: pinned constant asserted by this scenario
        return
    fail("Expected browser runtime resources to remain observable")

fn _open_equal_replacement_fixture() -> BrowserSession:
    var session = BrowserSession.new()
    val html = (
        "<!DOCTYPE html><html style='margin:0'><head><style>" +
        "html,body{{margin:0}}@keyframes EqualRestart{" +
        "from{{background-color:#ef4444}}" +
        "to{{background-color:#2563eb}}}" +
        "#stage{width:16px;height:16px;" +
        "animation:EqualRestart 100ms linear forwards}" +
        "</style></head><body style='margin:0'>" +
        "<div id='stage'></div></body></html>"
    )
    expect(session.open_html(
        "https://example.test/equal-inner-html-animation", html
    ).is_ok()).to_equal(true)
    session

describe "equal innerHTML CSS animation restart":

    # @manual: show
    # @capture(html)
    # @capture(artifact)
    # @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-021
    it "should restart fresh descendants without restarting style mutations":
        # @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-005 REQ-WEB-BROWSER-006 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-021
        step("Verify: should restart fresh descendants without restarting style mutations")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Register the browser callback")
        var session = _open_equal_replacement_fixture()
        val initial = _render_equal_replacement_frame(session)
        expect(initial.command.color).to_equal(0xFFEF4444u32)
        expect(session.css_animation_instances.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(session.css_animation_instances[0].start_time_ms).to_equal(0)  # oracle: pinned constant asserted by this scenario
        var initial_bridge_generation: i64 = -1
        if val Some(state) = session.runtime_state:
            initial_bridge_generation = (
                state.runtime.interpreter.host_dom_bridge_generation
            )
        else:
            fail("Expected an active browser JavaScript runtime")
        expect(session.eval_script(
            "var savedMarkup=document.body.innerHTML;" +
            "var callbackLog='';" +
            "requestAnimationFrame(function(frameTime){" +
            "callbackLog='F:'+frameTime;" +
            "document.body.innerHTML=savedMarkup;" +
            "var fresh=document.getElementById('stage');" +
            "fresh.addEventListener('click',function(){" +
            "callbackLog=callbackLog+':C';" +
            "fresh.style.width='8px';},{once:true});});"
        ).is_ok()).to_equal(true)
        if val Some(state) = session.runtime_state:
            expect(state.runtime.interpreter.pending_timer_tasks.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        else:
            fail("Expected the animation-frame callback to be document-owned")

        step("Advance the monotonic browser clock")
        expect(session.advance_time(100)).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(_read_equal_replacement_text(
            session, "callbackLog"
        )).to_equal("F:100")
        expect(session.css_animation_reconcile_pending).to_equal(true)
        expect(session.css_animation_instances[0].start_time_ms).to_equal(0)  # oracle: pinned constant asserted by this scenario
        var replacement_bridge_generation: i64 = -1
        var replacement_mutation_generation: i64 = -1
        if val Some(state) = session.runtime_state:
            replacement_bridge_generation = (
                state.runtime.interpreter.host_dom_bridge_generation
            )
            replacement_mutation_generation = (
                state.runtime.interpreter.host_dom_mutation_generation
            )
            expect(replacement_bridge_generation).to_be_greater_than(
                initial_bridge_generation
            )
            expect(state.dom_bridge_generation).to_equal(
                replacement_bridge_generation
            )
        else:
            fail("Expected the replaced browser DOM bridge")

        step("Dispatch events and animation frames")
        val restarted = _render_equal_replacement_frame(session)
        expect(session.css_animation_instances.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(session.css_animation_instances[0].start_time_ms).to_equal(100)  # oracle: pinned constant asserted by this scenario
        expect(restarted.command.color).to_equal(0xFFEF4444u32)
        val _ = session.dispatch_dom_event("stage", "click", true, true)
        expect(_read_equal_replacement_text(
            session, "callbackLog"
        )).to_equal("F:100:C")
        if val Some(state) = session.runtime_state:
            expect(
                state.runtime.interpreter.host_dom_bridge_generation
            ).to_equal(replacement_bridge_generation)
            expect(
                state.runtime.interpreter.host_dom_mutation_generation
            ).to_be_greater_than(replacement_mutation_generation)
        else:
            fail("Expected style mutation generation evidence")

        step("Observe updated canonical Draw IR pixels and released resources")
        val styled = _render_equal_replacement_frame(session)
        expect(session.css_animation_instances.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario
        expect(session.css_animation_instances[0].start_time_ms).to_equal(100)  # oracle: pinned constant asserted by this scenario
        expect(styled.source_kind).to_equal("html_ast")
        expect(styled.command.component_id).to_equal("stage")
        expect(styled.command.x).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(styled.command.y).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(styled.command.width).to_equal(8)  # oracle: pinned constant asserted by this scenario
        expect(styled.command.height).to_equal(16)  # oracle: pinned constant asserted by this scenario
        expect(styled.command.color).to_equal(0xFFEF4444u32)
        expect(styled.rendered_commands).to_be_greater_than(0)
        expect(styled.skipped_commands).to_equal(0)  # oracle: pinned constant asserted by this scenario
        _expect_exact_equal_replacement_buffer(styled)
        _expect_released_equal_replacement_callbacks(session)
        session.close()
        expect(session.runtime_state).to_be_nil()
        expect(session.css_animation_instances.len()).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(session.current_body_html).to_equal("")
