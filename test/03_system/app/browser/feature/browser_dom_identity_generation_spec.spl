val DOM_IDENTITY_INITIAL_HTML = (
    "<!DOCTYPE html><html style='margin:0'><head><style>" +
    "html,body{{margin:0}}button{display:block;margin:0;padding:0;border:0;" +
    "width:8px;height:8px;background-color:#ef4444}</style></head>" +
    "<body style='margin:0'>" +
    "<button id='replace' type='button'>Old</button>" +
    "<input id='external' form='later' type='radio' name='team'>" +
    "<label id='explicit-label' for='external'>External</label>" +
    "<label id='nested-label'>Nested<input id='nested'></label>" +
    "<form id='later'><input id='owned' type='radio' name='team'></form>" +
    "<input id='free-radio' type='radio' name='team'>" +
    "<div id='duplicate'></div><span id='duplicate'></span>" +
    "<script type='text/simple'>callback 91|title \"STALE_SIMPLE\"\n" +
    "timeout 91 1</script><script>" +
    "var old=document.getElementById('replace');" +
    "old.addEventListener('probe',function(){document.title='stable-probe';});" +
    "old.addEventListener('click',function(){document.title='stable-click';});" +
    "old.addEventListener('pointerdown',function(){" +
    "document.body.innerHTML=\"<button id='replace' type='button' " +
    "style='display:block;margin:0;padding:0;border:0;width:8px;" +
    "height:8px;background-color:#22c55e' " +
    "onclick='document.title=\\\"NEW_CLICK\\\"'>Survivor</button>\";" +
    "document.title='replaced';});</script></body></html>"
)

val DOM_IDENTITY_HOSTED_HTML = (
    "<style>html,body{{margin:0}}button{display:block;margin:0;padding:0;" +
    "border:0;width:8px;height:8px;background-color:#ef4444}</style>" +
    "<button id='replace' type='button'>Old</button><script>" +
    "var old=document.getElementById('replace');" +
    "old.addEventListener('pointerdown',function(){" +
    "document.body.innerHTML=\"<button id='replace' type='button' " +
    "style='display:block;margin:0;padding:0;border:0;width:8px;" +
    "height:8px;background-color:#22c55e' " +
    "onclick='document.title=\\\"NEW_CLICK\\\"'>Survivor</button>\";" +
    "document.title='replaced';});" +
    "old.addEventListener('click',function(){document.title='OLD_CLICK';});" +
    "</script>"
)

class DomIdentityGenerationFixture:
    session: BrowserSession
    generation: DomDocumentGeneration
    index: DomIdentityIndex
    target_route: DomNodeRoute
    target_ui_id: text
    external_route: DomNodeRoute
    form_route: DomNodeRoute
    explicit_label_route: DomNodeRoute
    nested_label_route: DomNodeRoute
    nested_control_route: DomNodeRoute
    free_radio_route: DomNodeRoute

class DomIdentityReplacementReceipt:
    generation: DomDocumentGeneration
    index: DomIdentityIndex
    route: DomNodeRoute

class DomIdentityRuntimeReceiptSchema:
    schema: text
    replacement_dispatch_cycles: i64
    build_p95_ms: i64
    input_to_paint_p95_ms: i64
    allocation_count: i64
    live_index_count: i64
    retired_index_count: i64
    index_bytes: i64
    post_warmup_rss_bytes: i64
    final_rss_bytes: i64
    max_rss_bytes: i64
    stale_reject_count: i64
    budget_reject_count: i64
    evidence_status: text

fn _dom_identity_route(index: DomIdentityIndex, author_id: text) -> DomNodeRoute:
    match index.route_for_author_id(author_id):
        Some(route): route
        nil: fail("Expected indexed route for #{author_id}")

fn _dom_identity_index(session: BrowserSession) -> DomIdentityIndex:
    match session.current_dom_identity_index():
        Some(index): index
        nil: fail("Expected BrowserSession document identity index")

fn _dom_identity_attr(
    session: BrowserSession, index: DomIdentityIndex,
    route: DomNodeRoute, name: text
) -> text:
    match be_dom_node_for_route(session.dom_root(), index, route):
        Some(node): be_dom_get_attr(node, name)
        nil: fail("Expected current DOM node for route")

fn setup_dom_identity_generation_fixture() -> DomIdentityGenerationFixture:
    var session = BrowserSession.new()
    expect(session.current_url).to_equal("about:blank")
    expect(session.document_generation().value).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    val initial_index = _dom_identity_index(session)
    expect(initial_index.generation.value).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(initial_index.counters.pass_count).to_equal(2)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    match session.open_html(
        "https://example.test/dom-identity", DOM_IDENTITY_INITIAL_HTML
    ):
        Ok(_): ()
        Err(reason): fail("DOM identity fixture failed to open: {reason}")
    val generation = session.document_generation()
    val index = _dom_identity_index(session)
    val target_route = _dom_identity_route(index, "replace")
    val nodes = ui_access_find_nodes(
        session.ui_access_snapshot(), "browser:session", "button", "Old", 1
    )
    expect(nodes.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    DomIdentityGenerationFixture(
        session: session,
        generation: generation,
        index: index,
        target_route: target_route,
        target_ui_id: nodes[0].canonical_id,
        external_route: _dom_identity_route(index, "external"),
        form_route: _dom_identity_route(index, "later"),
        explicit_label_route: _dom_identity_route(index, "explicit-label"),
        nested_label_route: _dom_identity_route(index, "nested-label"),
        nested_control_route: _dom_identity_route(index, "nested"),
        free_radio_route: _dom_identity_route(index, "free-radio")
    )

fn check_dom_identity_index_built(fixture: DomIdentityGenerationFixture):
    val index = fixture.index
    expect(index.generation.value).to_equal(fixture.generation.value)
    expect(index.counters.pass_count).to_equal(2)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(index.counters.build_visit_count).to_equal(
        index.counters.node_count * 2
    )
    expect(index.counters.duplicate_author_id_count).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(index.form_owner_for_route(fixture.external_route)).to_equal(
        Some(fixture.form_route)
    )
    expect(index.control_for_label_route(
        fixture.explicit_label_route
    )).to_equal(Some(fixture.external_route))
    expect(index.control_for_label_route(
        fixture.nested_label_route
    )).to_equal(Some(fixture.nested_control_route))
    val owned_group = match index.radio_group_for_route(
        fixture.external_route
    ):
        Some(group): group
        nil: fail("Expected form-owned radio group")
    val free_group = match index.radio_group_for_route(
        fixture.free_radio_route
    ):
        Some(group): group
        nil: fail("Expected ownerless radio group")
    expect(owned_group.form_owner).to_equal(Some(fixture.form_route))
    expect(index.radio_members(owned_group).len()).to_equal(2)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(free_group.form_owner).to_be_nil()
    expect(index.radio_members(free_group).len()).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(fixture.session.route_for_layout_target_key(
        "id:replace", fixture.generation
    )).to_equal(Ok(fixture.target_route))
    expect(fixture.session.layout_target_key_for_route(
        fixture.target_route, fixture.generation
    )).to_equal(Ok("path:0"))
    expect(fixture.session.author_id_for_route(
        fixture.target_route, fixture.generation
    )).to_equal(Some("replace"))

fn check_stable_route_dispatch(fixture: DomIdentityGenerationFixture):
    var session = fixture.session
    if val Some(state) = session.runtime_state:
        val target_object_id = state.object_id_for_route(fixture.target_route)
        expect(target_object_id).to_be_greater_than(0)
        var probe_listener_count = 0
        for listener in state.dom_callable_listeners:
            if listener.event_type == "probe":
                val listener_route = match listener.target_route:
                    Some(route): route
                    nil: fail("Expected callable listener typed route")
                expect(listener_route).to_equal(fixture.target_route)
                expect(listener.target_object_id).to_equal(target_object_id)
                probe_listener_count = probe_listener_count + 1
        expect(probe_listener_count).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    else:
        fail("Expected JavaScript runtime route state")
    val dispatch = match session.dispatch_dom_event_route(
        fixture.target_route, "probe", true, true
    ):
        Ok(value): value
        Err(reason): fail("Current typed route dispatch failed: {reason}")
    expect(dispatch.target_route).to_equal(fixture.target_route)
    expect(dispatch.current_targets).to_contain(fixture.target_route)
    expect(session.document_generation().value).to_equal(
        fixture.generation.value
    )
    expect(session.current_title).to_equal("stable-probe")
    expect(session.simple_script_executor.inject_dom_event_route(
        fixture.target_route, BeDomEvent.create("probe", "", true, true)
    )).to_equal(Ok(true))
    val acted = session.ui_access_act(WinTextActionRequest(
        target_id: fixture.target_ui_id,
        action: "click", text_value: "", x: 0, y: 0
    ))
    expect(acted.ok).to_equal(true)
    expect(session.current_title).to_equal("stable-click")
    expect(session.document_generation().value).to_equal(
        fixture.generation.value
    )

fn _open_dom_identity_session(url: text, html: text) -> BrowserSession:
    var session = BrowserSession.new()
    match session.open_html(url, html):
        Ok(_): session
        Err(reason): fail("DOM identity subfixture failed to open: {reason}")

fn _check_label_forwarding_and_rollback():
    var session = _open_dom_identity_session(
        "https://example.test/dom-label-routes",
        "<html><body>" +
        "<label id='sibling-label' for='sibling-control'>Sibling</label>" +
        "<input id='sibling-control' type='checkbox'>" +
        "<label id='nested-label-case'>Nested" +
        "<input id='nested-control-case' type='checkbox'></label>" +
        "<label id='interactive-label' for='interactive-control'>" +
        "<a id='interactive-link' href='#kept'>Interactive</a></label>" +
        "<input id='interactive-control' type='checkbox'>" +
        "<label id='canceled-label' for='canceled-control'>Canceled</label>" +
        "<input id='canceled-control' type='checkbox'>" +
        "<label id='rollback-label' for='rollback-control'>Rollback</label>" +
        "<input id='rollback-control' type='checkbox'>" +
        "<script>var trace='';" +
        "var sl=document.getElementById('sibling-label');" +
        "var sc=document.getElementById('sibling-control');" +
        "sl.addEventListener('click',function(){trace=trace+'label,';});" +
        "sc.addEventListener('click',function(){trace=trace+'control,';});" +
        "var nl=document.getElementById('nested-label-case');" +
        "var nc=document.getElementById('nested-control-case');" +
        "nl.addEventListener('click',function(){trace=trace+'label,';});" +
        "nc.addEventListener('click',function(){trace=trace+'control,';});" +
        "document.getElementById('interactive-link').addEventListener(" +
        "'click',function(event){trace=trace+'interactive,';" +
        "event.preventDefault();});" +
        "document.getElementById('canceled-label').addEventListener(" +
        "'click',function(event){trace=trace+'label,';event.preventDefault();});" +
        "document.getElementById('canceled-control').addEventListener(" +
        "'click',function(){trace=trace+'control,';});" +
        "document.getElementById('rollback-label').addEventListener(" +
        "'click',function(){trace=trace+'label,';});" +
        "document.getElementById('rollback-control').addEventListener(" +
        "'click',function(event){trace=trace+'control,';event.preventDefault();});" +
        "</script></body></html>"
    )
    var index = _dom_identity_index(session)
    val sibling_label = _dom_identity_route(index, "sibling-label")
    val sibling_control = _dom_identity_route(index, "sibling-control")
    val nested_label = _dom_identity_route(index, "nested-label-case")
    val nested_control = _dom_identity_route(index, "nested-control-case")
    val interactive_link = _dom_identity_route(index, "interactive-link")
    val interactive_control = _dom_identity_route(index, "interactive-control")
    val canceled_label = _dom_identity_route(index, "canceled-label")
    val canceled_control = _dom_identity_route(index, "canceled-control")
    val rollback_label = _dom_identity_route(index, "rollback-label")
    val rollback_control = _dom_identity_route(index, "rollback-control")

    match session.dispatch_dom_event_route(
        sibling_label, "click", true, true
    ):
        Ok(_): ()
        Err(reason): fail("Sibling label dispatch failed: {reason}")
    index = _dom_identity_index(session)
    expect(_dom_identity_attr(
        session, index, sibling_control, "checked"
    )).to_equal("checked")
    match session.eval_script("trace"):
        Ok(JsValue.String(value)): expect(value).to_equal("label,control,")
        Ok(_): fail("Sibling label trace returned a non-string")
        Err(reason): fail("Sibling label trace failed: {reason}")

    val _ = session.eval_script("trace='';")
    match session.dispatch_dom_event_route(
        nested_label, "click", true, true
    ):
        Ok(_): ()
        Err(reason): fail("Nested label dispatch failed: {reason}")
    index = _dom_identity_index(session)
    expect(_dom_identity_attr(
        session, index, nested_control, "checked"
    )).to_equal("checked")
    match session.eval_script("trace"):
        Ok(JsValue.String(value)):
            expect(value).to_equal("label,control,label,")
        Ok(_): fail("Nested label trace returned a non-string")
        Err(reason): fail("Nested label trace failed: {reason}")

    val _ = session.eval_script("trace='';")
    match session.dispatch_dom_event_route(
        interactive_link, "click", true, true
    ):
        Ok(_): ()
        Err(reason): fail("Interactive label dispatch failed: {reason}")
    index = _dom_identity_index(session)
    expect(_dom_identity_attr(
        session, index, interactive_control, "checked"
    )).to_equal("")
    match session.eval_script("trace"):
        Ok(JsValue.String(value)): expect(value).to_equal("interactive,")
        Ok(_): fail("Interactive label trace returned a non-string")
        Err(reason): fail("Interactive label trace failed: {reason}")

    val _ = session.eval_script("trace='';")
    match session.dispatch_dom_event_route(
        canceled_label, "click", true, true
    ):
        Ok(_): ()
        Err(reason): fail("Canceled label dispatch failed: {reason}")
    index = _dom_identity_index(session)
    expect(_dom_identity_attr(
        session, index, canceled_control, "checked"
    )).to_equal("")
    match session.eval_script("trace"):
        Ok(JsValue.String(value)): expect(value).to_equal("label,")
        Ok(_): fail("Canceled label trace returned a non-string")
        Err(reason): fail("Canceled label trace failed: {reason}")

    val _ = session.eval_script("trace='';")
    match session.dispatch_dom_event_route(
        rollback_label, "click", true, true
    ):
        Ok(_): ()
        Err(reason): fail("Rollback label dispatch failed: {reason}")
    index = _dom_identity_index(session)
    expect(_dom_identity_attr(
        session, index, rollback_control, "checked"
    )).to_equal("")
    match session.eval_script("trace"):
        Ok(JsValue.String(value)): expect(value).to_equal("label,control,")
        Ok(_): fail("Rollback label trace returned a non-string")
        Err(reason): fail("Rollback label trace failed: {reason}")
    session.close()

fn _check_generation_preserving_and_structural_mutations():
    var session = _open_dom_identity_session(
        "https://example.test/dom-mutation-generations",
        "<html><body><input id='stable-input' value='a'>" +
        "<div id='text-owner'><span>old</span></div><script>" +
        "var stable=document.getElementById('stable-input');</script>" +
        "</body></html>"
    )
    val generation = session.document_generation()
    val index = _dom_identity_index(session)
    val input_route = _dom_identity_route(index, "stable-input")
    val text_route = _dom_identity_route(index, "text-owner")
    val object_id = match session.runtime_state:
        Some(state): state.object_id_for_route(input_route)
        nil: fail("Expected mutation runtime state")
    expect(object_id).to_be_greater_than(0)
    match session.set_dom_text_input_route(input_route, "value-kept"):
        Ok(_): ()
        Err(reason): fail("Value mutation route failed: {reason}")
    match session.eval_script(
        "stable.style.width='7px';stable.focus();"
    ):
        Ok(_): ()
        Err(reason): fail("Style/focus mutation failed: {reason}")
    expect(session.document_generation().value).to_equal(generation.value)
    expect(_dom_identity_index(session)).to_be(index)
    match session.runtime_state:
        Some(state): expect(state.object_id_for_route(input_route)).to_equal(
            object_id
        )
        nil: fail("Expected retained mutation runtime state")
    match session.eval_script(
        "document.getElementById('text-owner').textContent='fresh';"
    ):
        Ok(_): ()
        Err(reason): fail("Structural text mutation failed: {reason}")
    expect(session.document_generation().value).to_equal(generation.value + 1)
    val replacement_index = _dom_identity_index(session)
    expect(replacement_index.contains_route(text_route)).to_equal(false)
    expect(_dom_identity_route(
        replacement_index, "text-owner"
    ).generation.value).to_equal(generation.value + 1)
    session.close()

fn _oversized_dom_identity_html() -> text:
    var pieces: [text] = ["<html><body>"]
    var node_count: i64 = 0
    while node_count <= HTML_MAX_NODES:
        pieces.push("<div></div>")
        node_count = node_count + 1
    pieces.push("</body></html>")
    pieces.join("")

fn _check_atomic_load_eval_and_index_rollback():
    var session = _open_dom_identity_session(
        "https://example.test/dom-atomic-before",
        "<html><body><button id='kept'>Kept</button><script>" +
        "<script type='text/simple'>callback 71|title \"simple-kept\"</script>" +
        "<script>var kept=document.getElementById('kept');" +
        "kept.addEventListener('click',function(){document.title='kept';});" +
        "</script></body></html>"
    )
    session.broker_network_policy = true
    val generation = session.document_generation()
    val index = _dom_identity_index(session)
    val kept_route = _dom_identity_route(index, "kept")
    val body_html = session.current_body_html
    val title = session.current_title
    val runtime_state = match session.runtime_state:
        Some(state): state
        nil: fail("Expected rollback runtime state")
    val runtime = runtime_state.runtime
    val object_id = runtime_state.object_id_for_route(kept_route)
    expect(runtime_state.dom_callable_listeners.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    val callable_listener = runtime_state.dom_callable_listeners[0]
    val simple_executor = session.simple_script_executor
    val simple_root = simple_executor.dom_root()
    val simple_runner_root = simple_executor._runner.dom_root
    val simple_runner_loop = simple_executor._runner.event_loop
    val simple_index = match simple_executor._dom_identity_index:
        Some(current): current
        nil: fail("Expected SimpleScript identity index")
    val simple_sources = simple_executor._callback_sources
    val pending_cookie_writes = session.pending_script_cookie_writes
    val staged_body = _oversized_dom_identity_html()
    val rejected_stage = session.eval_script(
        "document.cookie='stage=must-not-leak';" +
        "document.body.innerHTML='" + staged_body + "';"
    )
    expect(rejected_stage).to_equal(Err(
        "resource_limit: DOM node limit exceeded (65536)"
    ))
    expect(session.document_generation().value).to_equal(generation.value)
    expect(_dom_identity_index(session)).to_be(index)
    expect(session.current_dom).to_be(simple_root)
    expect(session.current_body_html).to_equal(body_html)
    expect(session.current_title).to_equal(title)
    match session.runtime_state:
        Some(state):
            expect(state).to_be(runtime_state)
            expect(state.runtime).to_be(runtime)
            expect(state.object_id_for_route(kept_route)).to_equal(object_id)
            expect(state.dom_callable_listeners.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
            expect(state.dom_callable_listeners[0].target_route).to_equal(
                callable_listener.target_route
            )
            expect(state.dom_callable_listeners[0].target_object_id).to_equal(
                callable_listener.target_object_id
            )
            expect(state.dom_callable_listeners[0].callback).to_equal(
                callable_listener.callback
            )
        nil: fail("Rejected script stage lost runtime state")
    expect(session.simple_script_executor).to_be(simple_executor)
    expect(session.simple_script_executor.dom_root()).to_be(simple_root)
    expect(session.simple_script_executor._runner.dom_root).to_be(
        simple_runner_root
    )
    expect(session.simple_script_executor._runner.event_loop).to_be(
        simple_runner_loop
    )
    match session.simple_script_executor._dom_identity_index:
        Some(current): expect(current).to_be(simple_index)
        nil: fail("Rejected script stage lost SimpleScript index")
    expect(session.simple_script_executor._callback_sources).to_equal(
        simple_sources
    )
    expect(session.simple_script_executor.has_callback(71)).to_equal(true)
    expect(session.pending_script_cookie_writes).to_equal(
        pending_cookie_writes
    )
    expect(session.open_html(
        "https://example.test/dom-atomic-rejected",
        _oversized_dom_identity_html()
    )).to_equal(Err("resource_limit: DOM node limit exceeded (65536)"))
    expect(session.document_generation().value).to_equal(generation.value)
    expect(_dom_identity_index(session)).to_be(index)
    expect(session.current_body_html).to_equal(body_html)
    expect(session.current_title).to_equal(title)
    match session.runtime_state:
        Some(state): expect(state.object_id_for_route(kept_route)).to_equal(
            object_id
        )
        nil: fail("Rejected load lost runtime state")
    var invalid = BeDomNode.element_with_id(1, "document")
    invalid.children.push(BeDomNode.element_with_id(2, "div"))
    invalid.children.push(BeDomNode.element_with_id(2, "button"))
    expect(session.publish_dom_snapshot(
        invalid, true, session.runtime_state
    )).to_equal(Err("duplicate_node_id"))
    expect(session.document_generation().value).to_equal(generation.value)
    expect(_dom_identity_index(session)).to_be(index)
    expect(session.current_body_html).to_equal(body_html)
    session.close()

fn _check_shared_nested_dispatch_budget():
    var session = _open_dom_identity_session(
        "https://example.test/dom-shared-dispatch-budget",
        "<html><body><input id='budget' type='checkbox' " +
        "oninput='set-attr:data-over-budget=yes'><script>" +
        "var budget=document.getElementById('budget');var i=0;" +
        "while(i<4096){budget.addEventListener('click',function(){});" +
        "i=i+1;}</script></body></html>"
    )
    val index = _dom_identity_index(session)
    val route = _dom_identity_route(index, "budget")
    match session.runtime_state:
        Some(state): expect(state.dom_callable_listeners.len()).to_equal(4096)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
        nil: fail("Expected dispatch-budget runtime state")
    val before_callbacks = session.dom_callback_count
    match session.dispatch_dom_event_route(route, "click", true, true):
        Ok(_): ()
        Err(reason): fail("Dispatch-budget route failed: {reason}")
    expect(session.dom_callback_count - before_callbacks).to_equal(4096)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    val current_index = _dom_identity_index(session)
    val current_route = _dom_identity_route(current_index, "budget")
    expect(_dom_identity_attr(
        session, current_index, current_route, "data-over-budget"
    )).to_equal("")
    session.close()

fn check_document_replacement_during_handler(
    fixture: DomIdentityGenerationFixture
) -> DomIdentityReplacementReceipt:
    var session = fixture.session
    expect(session.dispatch_dom_primary_pointer_down(
        fixture.target_route
    )).to_equal(Err("stale_target"))
    val generation = session.document_generation()
    val index = _dom_identity_index(session)
    val route = _dom_identity_route(index, "replace")
    expect(generation.value).to_equal(fixture.generation.value + 1)
    expect(route.generation.value).to_equal(generation.value)
    expect(route.node_id).to_equal(fixture.target_route.node_id)
    expect(session.current_title).to_equal("replaced")
    expect(session.current_body_html).to_contain("Survivor")
    expect(session.simple_script_executor.has_callback(91)).to_equal(false)
    expect(session.advance_time(1)).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(session.current_title).to_equal("replaced")
    DomIdentityReplacementReceipt(
        generation: generation, index: index, route: route
    )

fn _dom_identity_work_index(node_count: i64) -> DomIdentityIndex:
    var root = BeDomNode.element_with_id(1, "document")
    var node_id: i64 = 2
    while node_id <= node_count:
        var node = BeDomNode.element_with_id(node_id, "button")
        node.set_attr("id", "work-{node_id}")
        root.children.push(node)
        node_id = node_id + 1
    val generation = match DomDocumentGeneration.create(1):
        Ok(value): value
        Err(reason): fail("Expected work-fixture generation: {reason}")
    match dom_identity_index_build(root, generation):
        Ok(index): index
        Err(reason): fail("Expected work-fixture index: {reason}")

fn _held_dom_identity_runtime_receipt() -> DomIdentityRuntimeReceiptSchema:
    DomIdentityRuntimeReceiptSchema(
        schema: "dom-identity-runtime-receipt-v1",
        replacement_dispatch_cycles: 10000,
        build_p95_ms: -1,
        input_to_paint_p95_ms: -1,
        allocation_count: -1,
        live_index_count: -1,
        retired_index_count: -1,
        index_bytes: -1,
        post_warmup_rss_bytes: -1,
        final_rss_bytes: -1,
        max_rss_bytes: -1,
        stale_reject_count: -1,
        budget_reject_count: -1,
        evidence_status: "runtime-held"
    )

fn _check_dom_identity_work_and_receipt_schema():
    val n = _dom_identity_work_index(32)
    val two_n = _dom_identity_work_index(64)
    expect(n.counters.node_count).to_equal(32)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(two_n.counters.node_count).to_equal(64)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(n.counters.build_visit_count).to_equal(64)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(two_n.counters.build_visit_count).to_equal(128)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(two_n.counters.build_visit_count).to_equal(
        n.counters.build_visit_count * 2
    )
    val receipt = _held_dom_identity_runtime_receipt()
    expect(receipt.schema).to_equal("dom-identity-runtime-receipt-v1")
    expect(receipt.replacement_dispatch_cycles).to_equal(10000)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.build_p95_ms).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.input_to_paint_p95_ms).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.allocation_count).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.live_index_count).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.retired_index_count).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.index_bytes).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.post_warmup_rss_bytes).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.final_rss_bytes).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.max_rss_bytes).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.stale_reject_count).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.budget_reject_count).to_equal(-1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(receipt.evidence_status).to_equal("runtime-held")

fn _check_hosted_stale_press_release():
    var hosted = HostedWebContentSession.create(
        940, DOM_IDENTITY_HOSTED_HTML, 16, 8
    )
    val down = hosted.dispatch_pointer_at(1, 2, 2, true)
    expect(down.reason).to_equal("stale_target")
    expect(down.callback_count).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(hosted.pressed_target_route).to_be_nil()
    expect(hosted.browser.current_title).to_equal("replaced")
    val release = hosted.dispatch_pointer_at(2, 2, 2, false)
    expect(release.reason).to_equal("pointer-release-without-press")
    expect(release.callback_count).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(hosted.browser.current_title).to_equal("replaced")
    expect(hosted.browser.pending_request_count()).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    hosted.close()

    var worker = HostedBrowserRendererWorkerSession.create(16, 8)
    val initialized = worker.handle(BrowserRendererCapabilityMessage(
        kind: "init", generation: 7, request_id: 2,
        root_command_request_id: 2,
        command_capability: "11111111111111111111111111111111",
        payload: DOM_IDENTITY_HOSTED_HTML
    ))
    expect(initialized.ok).to_equal(true)
    val before_callbacks = worker.browser.dom_callback_count
    val worker_down = worker.handle(BrowserRendererCapabilityMessage(
        kind: "pointer", generation: 7, request_id: 3,
        root_command_request_id: 3,
        command_capability: "22222222222222222222222222222222",
        payload: "P1\t1\t2\t2\t1"
    ))
    expect(worker_down.reason).to_equal("stale_target")
    expect(worker.browser.dom_callback_count - before_callbacks).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.browser.current_title).to_equal("replaced")
    expect(worker.pressed_target_route).to_be_nil()
    expect(worker.last_hit_index).to_be_nil()
    expect(worker.last_hit_generation).to_be_nil()
    expect(worker.active_root_command_request_id).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.active_command_capability).to_equal("")
    val worker_release = worker.handle(BrowserRendererCapabilityMessage(
        kind: "pointer", generation: 7, request_id: 3,
        root_command_request_id: 3,
        command_capability: "33333333333333333333333333333333",
        payload: "P1\t2\t2\t2\t0"
    ))
    expect(worker_release.ok).to_equal(true)
    expect(worker_release.reason).to_equal("ok")
    expect(worker.browser.dom_callback_count - before_callbacks).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.browser.current_title).to_equal("replaced")
    expect(worker.pressed_target_route).to_be_nil()
    expect(worker.active_root_command_request_id).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.active_command_capability).to_equal("")

    val worker_down_current = worker.handle(BrowserRendererCapabilityMessage(
        kind: "pointer", generation: 7, request_id: 4,
        root_command_request_id: 4,
        command_capability: "44444444444444444444444444444444",
        payload: "P1\t3\t2\t2\t1"
    ))
    expect(worker_down_current.ok).to_equal(true)
    expect(worker.pressed_target_route != nil).to_equal(true)
    expect(worker.browser.open_html(
        "https://example.test/stale-worker-release",
        "<title>kept</title><style>html,body{{margin:0}}a{" +
        "display:block;margin:0;padding:0;border:0;width:8px;height:8px}" +
        "</style><a id='replace' href='https://example.test/stale-release' " +
        "onclick='document.body.innerHTML=\"MUTATED\";" +
        "document.title=\"STALE_RELEASE\"'>Kept</a>"
    ).is_ok()).to_equal(true)
    val kept_url = worker.browser.current_url
    val kept_history_len = worker.browser.history.len()
    val kept_history_index = worker.browser.current_index
    val kept_body = worker.browser.current_body_html
    val before_stale_release_callbacks = worker.browser.dom_callback_count
    val stale_worker_release = worker.handle(
        BrowserRendererCapabilityMessage(
            kind: "pointer", generation: 7, request_id: 5,
            root_command_request_id: 5,
            command_capability: "55555555555555555555555555555555",
            payload: "P1\t4\t2\t2\t0"
        )
    )
    expect(stale_worker_release.reason).to_equal("stale_target")
    expect(worker.browser.dom_callback_count).to_equal(
        before_stale_release_callbacks
    )
    expect(worker.browser.current_title).to_equal("kept")
    expect(worker.browser.current_body_html).to_equal(kept_body)
    expect(worker.browser.current_url).to_equal(kept_url)
    expect(worker.browser.history.len()).to_equal(kept_history_len)
    expect(worker.browser.current_index).to_equal(kept_history_index)
    expect(worker.browser.pending_request_count()).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.pressed_target_route).to_be_nil()
    expect(worker.last_hit_index).to_be_nil()
    expect(worker.last_hit_generation).to_be_nil()
    expect(worker.active_root_command_request_id).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(worker.active_command_capability).to_equal("")
    val worker_release_retry = worker.handle(
        BrowserRendererCapabilityMessage(
            kind: "pointer", generation: 7, request_id: 5,
            root_command_request_id: 5,
            command_capability: "66666666666666666666666666666666",
            payload: "P1\t5\t2\t2\t0"
        )
    )
    expect(worker_release_retry.ok).to_equal(true)
    expect(worker.browser.current_title).to_equal("kept")
    expect(worker.browser.current_body_html).to_equal(kept_body)
    expect(worker.browser.current_url).to_equal(kept_url)
    expect(worker.browser.history.len()).to_equal(kept_history_len)
    expect(worker.browser.current_index).to_equal(kept_history_index)
    expect(worker.browser.pending_request_count()).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    worker.close()

fn _check_surviving_control_draw_ir(
    session: BrowserSession, replacement: DomIdentityReplacementReceipt
):
    val result = simple_web_layout_render_html_draw_ir_result_with_images(
        session.render_html_document(), 16, 8, session.image_resources
    )
    expect(result.composition.batches.len()).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    val hit_key = simple_web_layout_hit_test_index(
        result.hit_index, 2, 2
    )
    expect(hit_key).to_equal("id:replace")
    expect(session.route_for_layout_target_key(
        hit_key, replacement.generation
    )).to_equal(Ok(replacement.route))
    var survivor_command = -1
    val commands = result.composition.batches[0].commands
    var command_index = 0
    while command_index < commands.len():
        if commands[command_index].component_id == "replace":
            survivor_command = command_index
        command_index = command_index + 1
    expect(survivor_command).to_be_greater_than(-1)
    expect(commands[survivor_command].component_id).to_equal("replace")
    expect(commands[survivor_command].x).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(commands[survivor_command].y).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(commands[survivor_command].width).to_equal(8)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(commands[survivor_command].height).to_equal(8)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(commands[survivor_command].color).to_equal(0xFF22C55Eu32)
    val raster = Engine2dCompositorBackend.create_named(16, 8, "software")
    val rendered = raster.render_draw_ir_composition_resources(
        result.composition, session.image_resources
    )
    raster.shutdown()
    expect(rendered.skipped_command_count).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    expect(rendered.pixels.len()).to_equal(16 * 8)
    expect(rendered.pixels[2 * 16 + 2]).to_equal(0xFF22C55Eu32)
    expect(rendered.pixels[2 * 16 + 12]).to_equal(0xFFFFFFFFu32)

fn check_stale_routes_and_index_release(
    fixture: DomIdentityGenerationFixture,
    replacement: DomIdentityReplacementReceipt
):
    var session = fixture.session
    expect(replacement.index.contains_route(
        fixture.target_route
    )).to_equal(false)
    expect(session.route_for_layout_target_key(
        "id:replace", fixture.generation
    )).to_equal(Err("stale_target"))
    expect(session.layout_target_key_for_route(
        fixture.target_route, replacement.generation
    )).to_equal(Err("stale_target"))
    expect(session.author_id_for_route(
        fixture.target_route, replacement.generation
    )).to_be_nil()
    expect(session.dispatch_dom_event_route(
        fixture.target_route, "click", true, true
    )).to_equal(Err("stale_target"))
    expect(session.simple_script_executor.inject_dom_event_route(
        fixture.target_route, BeDomEvent.create("click", "", true, true)
    )).to_equal(Err("stale_target"))
    val stale_ui = session.ui_access_act(WinTextActionRequest(
        target_id: fixture.target_ui_id,
        action: "click", text_value: "", x: 0, y: 0
    ))
    expect(stale_ui.ok).to_equal(false)
    expect(stale_ui.code).to_equal("target_not_found")
    expect(session.current_title).to_equal("replaced")
    expect(session.pending_request_count()).to_equal(0)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario
    _check_dom_identity_work_and_receipt_schema()
    _check_hosted_stale_press_release()
    _check_surviving_control_draw_ir(session, replacement)
    val closing_generation = session.document_generation().value
    session.close()
    expect(session.current_dom_identity_index()).to_be_nil()
    expect(session.document_generation().value).to_equal(
        closing_generation + 1
    )
    expect(session.simple_script_executor.inject_dom_event_route(
        replacement.route, BeDomEvent.create("click", "", true, true)
    )).to_equal(Err("invalid_document"))

describe "Generation-qualified browser DOM identity":

    # @manual: show
    # @capture(html)
    # @capture(protocol)
    # @capture(artifact)
    # @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018
    # @req NFR-WEB-BROWSER-004 NFR-WEB-BROWSER-005 NFR-WEB-BROWSER-006 NFR-WEB-BROWSER-008 NFR-WEB-BROWSER-014 NFR-WEB-BROWSER-015 NFR-WEB-BROWSER-016
    it "should retire stale routes across browser script UI and hosted rendering":
        # @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-007 REQ-WEB-BROWSER-008 REQ-WEB-BROWSER-017 REQ-WEB-BROWSER-018
        step("Verify: should retire stale routes across browser script UI and hosted rendering")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        step("Build the document identity index")
        val fixture = setup_dom_identity_generation_fixture()
        check_dom_identity_index_built(fixture)

        step("Dispatch through stable routes")
        check_stable_route_dispatch(fixture)
        _check_generation_preserving_and_structural_mutations()
        _check_label_forwarding_and_rollback()
        _check_shared_nested_dispatch_budget()

        step("Replace the document during a handler")
        _check_atomic_load_eval_and_index_rollback()
        val replacement = check_document_replacement_during_handler(fixture)

        step("Reject stale routes and release the index")
        check_stale_routes_and_index_release(fixture, replacement)
