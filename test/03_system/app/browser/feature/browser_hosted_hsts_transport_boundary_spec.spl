"""
## Purpose and audience
Verifies the browser hosted hsts transport boundary behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-WEB-BROWSER-007
# doc-path: doc/01_research/local/browser_wasm_webgpu_infra.md
# doc-path: doc/03_plan/sys_test/browser_renderer_attachment_boundary.md
# doc-path: doc/04_architecture/browser_wasm_webgpu_infra.md
# doc-path: doc/05_design/browser_wasm_webgpu_infra.md
# codex-system-test
# @req REQ-WEB-BROWSER-007 NFR-WEB-BROWSER-003
"""# Hosted HSTS Transport Boundary

Only a completed, authenticated hosted HTTPS transport may update HSTS.
Mock and cache responses remain useful page fixtures but never become
transport authority.
"""

use std.spec.*
use os.hosted.hosted_web_content_session.{HostedWebContentSession}
use std.gc_async_mut.gpu.browser_engine.net.h1_client.{
    MockResponseRegistry, set_mock_registry
}
use std.js.types.pair.{Pair}

extern fn rt_file_read_text(path: text) -> text
extern fn rt_text_to_bytes(value: text) -> [u8]

fn _hosted_hsts_source_has_runtime_owner() -> bool:
    val source = rt_file_read_text(
        "src/os/hosted/hosted_web_content_session.spl"
    ) ?? ""
    val poll_start = source.find("    me _poll_network_job():")
    val pump_start = source.find("    me _pump_network_once():", poll_start)
    val owner_start = source.find(
        "    me _apply_authenticated_runtime_https_hsts("
    )
    val filter_start = source.find("    fn _filtered_cors_response(", owner_start)
    if (poll_start < 0 or pump_start <= poll_start or owner_start < 0 or
        filter_start <= owner_start):
        return false
    val poll = source.slice(poll_start, pump_start)
    val owner = source.slice(owner_start, filter_start)
    source.contains("me _apply_authenticated_runtime_https_hsts(") and
        source.contains("hosted_browser_remove_response_header(") and
        poll.contains("elif phase == \"single\":") and
        poll.contains("self._apply_authenticated_runtime_https_hsts(") and
        owner.contains("if fetch_request.url.scheme != \"https\":") and
        owner.contains("self.browser._apply_hsts_header(")

describe "REQ-WEB-BROWSER-007: hosted HSTS transport boundary":
    it "keeps mock and cache headers out of the HSTS owner":
        # @req: REQ-WEB-BROWSER-007
        step("Verify: keeps mock and cache headers out of the HSTS owner")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Serve a mocked HTTPS document carrying HSTS")
        var mocks = MockResponseRegistry.create()
        mocks.register_with_headers(
            "https://mock-hsts.test/page", 200,
            [Pair("Strict-Transport-Security", "max-age=31536000")],
            "<main>mock</main>"
        )
        set_mock_registry(mocks)
        var mocked = HostedWebContentSession.create(951, "about:blank", 32, 16)
        expect(mocked.browser.begin_network_navigation(
            "https://mock-hsts.test/page", "GET", "", "", ""
        ).is_ok()).to_be(true)
        val _ = mocked.advance_at(1)
        expect(mocked.browser._hsts_upgrade_url(
            "http://mock-hsts.test/next"
        )).to_equal("http://mock-hsts.test/next")

        step("Replay a cached HTTPS header without extending HSTS")
        var cached = HostedWebContentSession.create(952, "about:blank", 32, 16)
        expect(cached.network.cache.store(
            "https://cache-hsts.test/page", rt_text_to_bytes("<main>cache</main>"),
            "Strict-Transport-Security: max-age=31536000\r\nCache-Control: max-age=60"
        ).is_ok()).to_be(true)
        expect(cached.browser.begin_network_navigation(
            "https://cache-hsts.test/page", "GET", "", "", ""
        ).is_ok()).to_be(true)
        val _ = cached.advance_at(1)
        expect(cached.browser._hsts_upgrade_url(
            "http://cache-hsts.test/next"
        )).to_equal("http://cache-hsts.test/next")

        step("Keep HSTS ownership in the completed runtime-job branch")
        expect(_hosted_hsts_source_has_runtime_owner()).to_be(true)
        mocked.close()
        cached.close()
        set_mock_registry(MockResponseRegistry.create())
