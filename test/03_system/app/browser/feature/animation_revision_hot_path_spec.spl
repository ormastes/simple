"""
## Purpose and audience
Verifies the animation revision hot path behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-006
# doc-path: doc/01_research/local/browser_wasm_webgpu_infra.md
# doc-path: doc/03_plan/ui/web_browser/simple_web_server_exe_path_2026-05-27.md
# doc-path: doc/04_architecture/browser_wasm_webgpu_infra.md
# doc-path: doc/05_design/simple_feature_module.md
# codex-system-test
# @req REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-006
"""# Revision-Driven Animation Advance

Proves that a hosted CSS animation advances through canonical Draw IR and
Engine2D pixels without copying the whole rendered document on every frame.
"""

use std.spec.*

use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.hosted.hosted_web_content_session.{
    HostedWebContentRegistry, HostedWebContentSession
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result_at_time_with_animations
}

extern fn rt_file_read_text(path: text) -> text

val WIDTH: i32 = 32
val HEIGHT: i32 = 24

fn _count_color(pixels: [u32], color: u32) -> i64:
    var count: i64 = 0
    for pixel in pixels:
        if pixel == color:
            count = count + 1
    count

fn _frame_receipt(
    session: HostedWebContentSession, color: u32
) -> text:
    val elapsed = (
        session.browser.monotonic_time_ms -
        session.browser.animation_start_time_ms
    )
    val animation_time_ms = if elapsed > 0: elapsed else: 0
    val layout = simple_web_layout_render_html_draw_ir_result_at_time_with_animations(
        session.browser.render_html_document(),
        WIDTH,
        HEIGHT,
        animation_time_ms,
        session.browser.css_animation_instances
    )
    if layout.composition.batches.len() == 0:
        return "missing-batch"
    var command_receipt = "missing"
    var stage_count: i64 = 0
    for batch in layout.composition.batches:
        for command in batch.commands:
            if command.component_id == "stage":
                stage_count = stage_count + 1
                command_receipt = (
                    command.kind + ":" + command.component_id + ":" +
                    command.x.to_string() + "," +
                    command.y.to_string() + "," +
                    command.width.to_string() + "," +
                    command.height.to_string() + ":" +
                    command.color.to_string()
                )
    val raster = Engine2dCompositorBackend.create_named(
        WIDTH, HEIGHT, "software"
    )
    val rendered = raster.render_draw_ir_composition(
        layout.composition, []
    )
    raster.shutdown()
    (
        animation_time_ms.to_string() + "|" +
        layout.composition.batches[0].source.source_kind + "|" +
        layout.composition.batches.len().to_string() + "|" +
        stage_count.to_string() + "|" + command_receipt + "|" +
        rendered.skipped_command_count.to_string() + "|" +
        _count_color(rendered.pixels, color).to_string()
    )

fn _production_body_read_uses_published_cache() -> bool:
    val source = rt_file_read_text(
        "src/os/hosted/hosted_web_content_session.spl"
    ) ?? ""
    val start = source.find("    fn current_body_html() -> text:")
    val stop = source.find("    fn render_to_pixels()", start)
    if start < 0 or stop <= start:
        return false
    val body = source.slice(start, stop)
    (
        body.contains("self.published_body_html") and
        not body.contains("current_style_html") and
        not body.contains("current_body_html +")
    )

describe "REQ-WEB-BROWSER-004/006: revision-driven animation advance":
    # @manual: show
    # @capture(html)
    # @capture(artifact)
    it "keeps document-sized text out of the frame hot path":
        # @req: REQ-WEB-BROWSER-004/006
        # @req: REQ-WEB-BROWSER-004 / REQ-006
        # @req: REQ-WEB-BROWSER-004 REQ-WEB-BROWSER-006
        step("Verify: keeps document-sized text out of the frame hot path")
        # evidence(expect(...) oracle verified): pinned constants below are authoritative values asserted by this scenario
        step("Open a CSS animation in the hosted BrowserSession")
        var registry = HostedWebContentRegistry.create()
        val html = (
            "<style>html,body{{margin:0}}@keyframes pulse{" +
            "from{{background-color:#dc2626}}" +
            "to{{background-color:#2563eb}}}" +
            "#stage{width:32px;height:24px;background-color:#dc2626;" +
            "animation:pulse 1000ms linear forwards}</style>" +
            "<div id='stage'></div>"
        )
        expect(registry.advance_window(
            901, html, WIDTH, HEIGHT, 1000, false
        )).to_be(false)
        expect(
            registry.sessions[0].browser.css_animation_instances.len()
        ).to_equal(1)  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario  # oracle: pinned constant asserted by this scenario

        step("Render the exact initial Draw IR and Engine2D frame")
        expect(_frame_receipt(
            registry.sessions[0], 0xFFDC2626u32
        )).to_equal(
            "0|html_ast|1|1|rect:stage:0,0,32,24:4292617766|0|768"
        )

        step("Advance CSS and render the exact midpoint frame")
        expect(registry.advance_window(
            901, html, WIDTH, HEIGHT, 1500, false
        )).to_be(true)
        expect(_frame_receipt(
            registry.sessions[0], 0xFF804488u32
        )).to_equal(
            "500|html_ast|1|1|rect:stage:0,0,32,24:4286596232|0|768"
        )

        step("Read the published frame through the production registry cache")
        expect(registry.body_html(901)).to_equal(
            registry.sessions[0].published_body_html
        )
        expect(_production_body_read_uses_published_cache()).to_be(true)
