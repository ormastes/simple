"""
## Purpose and audience
Purpose: Prove a binary body fetched over https reaches the browser byte for
byte. The TLS read used to go through text, and the interpreter decoded that
text as UTF-8, so every PNG/wasm body came back with U+FFFD (EF BF BD) in
place of its non-UTF-8 bytes and no https image ever rendered.
Audience: maintainers of the browser HTTP/1 transport and the TLS SFFI.
## Operator workflow
Run with the test runner on a host with internet access; it fetches two
public PNGs over https through the browser engine's own H1Client.
## Compatibility and limitations
Needs network. Bug record:
doc/08_tracking/bug/tls_binary_body_utf8_lossy_2026-10-05.md
"""
# @req: REQ-LIB-GC-ASYNC-MUT-001

use std.spec.*
use std.spec.step
use std.gc_async_mut.gpu.browser_engine.net.fetch.{FetchEngine}
use std.gc_async_mut.gpu.browser_engine.net.entity.request_types.{FetchRequest, RequestMode}
use std.gc_async_mut.gpu.browser_engine.net.entity.url_types.{Url}
use std.gc_async_mut.gpu.browser_engine.shared.logging.{Logger, BrowserLogLevel}

extern fn rt_text_to_bytes(s: text) -> [u8]

fn https_get_bytes(url_text: text) -> [u8]:
    """Fetch through the browser's FetchEngine (H1Client + TLS underneath).
    A failed fetch returns its error text as bytes, so the assertions below
    fail with the reason visible rather than on an empty body."""
    var engine = FetchEngine.new(Logger.new("https-binary", BrowserLogLevel.Error))
    val req = FetchRequest(
        method: "GET", url: Url.parse(url_text).unwrap(), headers: "", body: [],
        mode: RequestMode.NoCors, credentials: "omit"
    )
    match engine.fetch(req):
        Ok(resp): resp.body
        Err(e): rt_text_to_bytes("fetch failed: {e.message}")

fn has_png_signature(body: [u8]) -> bool:
    body.len() >= 8 and
        body[0] == 137u8 and body[1] == 80u8 and body[2] == 78u8 and body[3] == 71u8 and
        body[4] == 13u8 and body[5] == 10u8 and body[6] == 26u8 and body[7] == 10u8

fn has_replacement_char(body: [u8]) -> bool:
    var i: i64 = 0
    while i + 2 < body.len():
        if body[i] == 239u8 and body[i + 1] == 191u8 and body[i + 2] == 189u8:
            return true
        i = i + 1
    false

describe "binary bodies over https":
    it "delivers the google logo PNG unmodified":
        step("fetch the logo google.com's home page embeds")
        val body = https_get_bytes("https://www.google.com/images/branding/google_wordmark/v1/1x/googlelogo_color_white_background_272x92dp.png")
        step("the 0x89 PNG lead byte survives instead of becoming EF BF BD")
        assert_true(has_png_signature(body))
        assert_false(has_replacement_char(body))

    it "delivers the wikipedia globe PNG unmodified":
        val body = https_get_bytes("https://www.wikipedia.org/portal/wikipedia.org/assets/img/Wikipedia-logo-v2.png")
        assert_true(has_png_signature(body))
        assert_false(has_replacement_char(body))
