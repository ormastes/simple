# codex-system-test
# @req REQ-002, REQ-003, REQ-004, REQ-014
# Evidence class: live-host only with a complete administrator-provisioned fixture.
# @evidence-display: links
use std.spec.*
use app.io.mod.{env_get}
use std.nogc_sync_mut.io_runtime.{env_get_opt}
use app.build.scheduler.two_node_staged_qualification.{
    TwoNodeStagedFixtureV1, TwoNodeStagedQualificationV1,
    qualify_issued_two_node_staged_v1}

fn _staged_live_fixture_v1() -> TwoNodeStagedFixtureV1:
    TwoNodeStagedFixtureV1(
        env_get("SIMPLE_DIST_STAGED_QUAL_NATIVE") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_NATIVE_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_ISSUED_RECORD_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_PRODUCER_ACTION_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_PRODUCER_WORKER") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_LINK_WORKER") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_EXPORT_POLICY") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_EXPORT_POLICY_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_EXPORT_ROW_ID") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_VERIFIER") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_VERIFIER_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_VERIFIER_STDOUT_SHA256") ?? "",
        env_get("SIMPLE_DIST_STAGED_QUAL_VERIFIER_POLICY_SHA256") ?? "")

fn _staged_fixture_complete_v1(fixture: TwoNodeStagedFixtureV1) -> bool:
    fixture.native_path != "" and fixture.native_digest != "" and
    fixture.issued_record_digest != "" and
    fixture.producer_action_digest != "" and
    fixture.producer_worker_id != "" and fixture.link_worker_id != "" and
    fixture.export_policy_path != "" and
    fixture.export_policy_digest != "" and
    fixture.export_policy_row_id != "" and fixture.verifier_path != "" and
    fixture.verifier_digest != "" and
    fixture.verifier_stdout_digest != "" and fixture.verifier_policy_digest != ""

fn _staged_fixture_any_v1() -> bool:
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_NATIVE") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_NATIVE_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_ISSUED_RECORD_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_PRODUCER_ACTION_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_PRODUCER_WORKER") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_LINK_WORKER") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_EXPORT_POLICY") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_EXPORT_POLICY_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_EXPORT_ROW_ID") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_VERIFIER") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_VERIFIER_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_VERIFIER_STDOUT_SHA256") != nil or
    env_get_opt("SIMPLE_DIST_STAGED_QUAL_VERIFIER_POLICY_SHA256") != nil

fn _staged_partial_fixture_v1() -> TwoNodeStagedFixtureV1:
    TwoNodeStagedFixtureV1("configured-native-path", "", "", "", "", "",
        "", "", "", "", "", "", "")

fn _staged_result_v1(fixture: TwoNodeStagedFixtureV1) ->
        TwoNodeStagedQualificationV1:
    qualify_issued_two_node_staged_v1(fixture)

describe "issued staged distributed compile and link on two OCI workers":
    describe "REQ-004 and REQ-014: protected live execution evidence":
        it "should block a malformed partial qualification fixture":
            step("Load protected issued staged plan")
            val fixture = _staged_partial_fixture_v1()
            val result = _staged_result_v1(fixture)
            expect(result.status).to_equal("BLOCKED")
            expect(result.reason).to_equal("fixture-invalid-or-unpinned")

        it "should prove a cold staged compile, resolved link, pinned verifier receipt, and attempt-free repeat":
            val fixture = _staged_live_fixture_v1()
            if not _staged_fixture_any_v1():
                skip("should prove a cold staged compile, resolved link, pinned verifier receipt, and attempt-free repeat",
                    "administrator staged-plan, pinned binaries, export policy, and two-worker fixture are absent")
            else:
                step("Load protected issued staged plan")
                step("Probe both worker OCI capabilities")
                step("Run cold producer and resolved link")
                val result = _staged_result_v1(fixture)
                expect(_staged_fixture_complete_v1(fixture)).to_be(true)
                expect(result.status).to_equal("PASS")
                expect(result.reason).to_equal(
                    "cold-staged-link-pinned-verifier-receipt-and-repeat-qualified")
                expect(result.native_digest).to_equal(fixture.native_digest)
                expect(result.issued_record_digest).to_equal(
                    fixture.issued_record_digest)
                expect(result.producer_action_digest).to_equal(
                    fixture.producer_action_digest)
                expect(result.link_action_digest.len()).to_equal(64)
                expect(result.link_action_digest ==
                    fixture.producer_action_digest).to_be(false)
                step("Audit accepted bytes and cleanup")
                expect(result.producer_attempt_id != "").to_be(true)
                expect(result.link_attempt_id != "").to_be(true)
                expect(result.producer_attempt_id ==
                    result.link_attempt_id).to_be(false)
                expect(result.producer_output_digest.len()).to_equal(64)
                step("Load pinned verifier policy")
                step("Snapshot exact executable bytes")
                step("Run isolated OCI executable")
                step("Observe exact stdout and cleanup")
                step("Require exact verifier receipt")
                expect(result.executable_digest.len()).to_equal(64)
                expect(result.executable_path != "").to_be(true)
                expect(result.verifier_digest).to_equal(
                    fixture.verifier_digest)
                step("Repeat without new attempts")
                expect(result.attempt_count).to_equal(2)
                expect(result.accepted_count).to_equal(2)
