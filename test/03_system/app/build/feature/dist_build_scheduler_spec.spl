# Purpose and audience: executable parent-owner scenarios for build operators.
# @req REQ-003
# Evidence class: durable local scheduler; live remote execution is separate.
use std.spec.*
use app.build.scheduler.planner.{SchedulerActionV1}
use app.build.scheduler.ledger.{SchedulerCapacityV1}
use app.build.scheduler.owner.{scheduler_owner_open_v1,
    scheduler_owner_admit_v1, scheduler_owner_publish_v1,
    scheduler_owner_revoke_v1, scheduler_owner_close_v1}
use app.build.scheduler.broker.{FencedCandidateV1}
use compiler.common.build_contract.{ActionResultCandidate, BuildInputRef,
    BuildDependencyRef, SnapshotManifest, ToolchainManifest, InputManifest,
    ActionSpec, action_spec_digest_v1}
use std.common.crypto.sha256.{sha256_text}
use app.io.mod.{dir_create_all, time_now_unix_micros, getpid}

fn _dist_owner_root_v1(label: text) -> text:
    "build/test/dist-build-system-" + label + "-" + getpid().to_text() +
        "-" + time_now_unix_micros().to_text()

fn _dist_action_v1(name: text, dependencies: [text]) -> SchedulerActionV1:
    var outputs: [BuildDependencyRef] = []
    for digest in dependencies:
        outputs.push(BuildDependencyRef(digest, "lib.o",
            sha256_text("accepted-lib-" + digest)))
    val snapshot = sha256_text("system-snapshot")
    val spec = ActionSpec(1, "simple-compile",
        SnapshotManifest(1, snapshot, sha256_text("source-tree"),
            sha256_text("submodule-closure")),
        ToolchainManifest(1, sha256_text("tool"), sha256_text("behavior"),
            sha256_text("provider"), sha256_text("runtime"),
            sha256_text("sysroot"), "aarch64-apple-darwin"),
        InputManifest(1, snapshot,
            [BuildInputRef("src/" + name + ".spl", sha256_text(name))],
            [], dependencies, outputs, [], [], sha256_text("context"),
            true, false),
        ["simple", "build", name], "src", sha256_text("sandbox"),
        ["build/" + name + ".out"], sha256_text("resources"))
    SchedulerActionV1(action_spec_digest_v1(spec), spec, dependencies,
        0, 0, 1, 4096, 1)

fn _dist_candidate_v1(action: SchedulerActionV1, attempt_id: text,
        fence: i64, output_digest: text) -> FencedCandidateV1:
    FencedCandidateV1(ActionResultCandidate(1, action.action_digest,
        attempt_id, "worker-1", output_digest, sha256_text("diagnostics"),
        true), fence)

describe "distributed build parent owner — durable local evidence":
    describe "REQ-003: dependency, capacity and fence admission":
        it "should admit a consumer only after the producer is durably published":
            step("Select exact source and policy snapshot")
            val producer = _dist_action_v1("producer", [])
            val consumer = _dist_action_v1("consumer", [producer.action_digest])
            val actions = [producer, consumer]
            val capacity = SchedulerCapacityV1(2, 12288, 1024, 4)
            val root = _dist_owner_root_v1("dependency")
            expect(dir_create_all("build/test")).to_be(true)
            val owner = scheduler_owner_open_v1(root)
            expect(owner.error).to_equal("")
            step("Plan affected build and checks")
            val early = scheduler_owner_admit_v1(owner, actions,
                consumer.action_digest, "consumer-early", "worker-1",
                capacity, 0)
            expect(early.dispatch).to_be(false)
            expect(early.error).to_equal("scheduler-error: action-not-ready")
            step("Dispatch admitted actions")
            val first = scheduler_owner_admit_v1(owner, actions,
                producer.action_digest, "producer-1", "worker-1",
                capacity, 0)
            expect(first.dispatch).to_be(true)
            step("Validate and publish results")
            val output = sha256_text("verified-producer-output")
            val published = scheduler_owner_publish_v1(owner,
                _dist_candidate_v1(producer, "producer-1", first.fence,
                    output), output)
            expect(published.acknowledged).to_be(true)
            val second = scheduler_owner_admit_v1(owner, actions,
                consumer.action_digest, "consumer-1", "worker-1",
                capacity, 0)
            expect(second.dispatch).to_be(true)
            expect(scheduler_owner_close_v1(owner)).to_be(true)
            step("Verify current integration candidate")
            val recovered = scheduler_owner_open_v1(root)
            expect(recovered.error).to_equal("")
            expect(recovered.state.ledger.accepted[0].action_digest)
                .to_equal(producer.action_digest)
            expect(recovered.state.ledger.attempts.len()).to_equal(2)
            expect(scheduler_owner_close_v1(recovered)).to_be(true)

        it "should admit a new graph with prior history while charging active work":
            step("Select exact source and policy snapshot")
            val past = _dist_action_v1("past", [])
            val running = _dist_action_v1("running", [])
            val fresh = _dist_action_v1("fresh", [])
            val root = _dist_owner_root_v1("graph-history")
            val capacity = SchedulerCapacityV1(2, 12288, 1024, 4)
            expect(dir_create_all("build/test")).to_be(true)
            val owner = scheduler_owner_open_v1(root)
            expect(owner.error).to_equal("")
            step("Dispatch admitted actions")
            val first = scheduler_owner_admit_v1(owner, [past],
                past.action_digest, "past-1", "worker-1", capacity, 0)
            expect(first.dispatch).to_be(true)
            val output = sha256_text("verified-past-output")
            val published = scheduler_owner_publish_v1(owner,
                _dist_candidate_v1(past, "past-1", first.fence, output),
                output)
            expect(published.acknowledged).to_be(true)
            val other = scheduler_owner_admit_v1(owner, [running],
                running.action_digest, "running-1", "worker-1",
                capacity, 0)
            expect(other.dispatch).to_be(true)
            expect(scheduler_owner_close_v1(owner)).to_be(true)
            step("Plan affected build and checks")
            val recovered = scheduler_owner_open_v1(root)
            expect(recovered.error).to_equal("")
            val too_small = scheduler_owner_admit_v1(recovered, [fresh],
                fresh.action_digest, "fresh-too-small", "worker-1",
                SchedulerCapacityV1(1, 12288, 1024, 4), 0)
            expect(too_small.dispatch).to_be(false)
            expect(too_small.error).to_equal(
                "scheduler-error: capacity-exhausted")
            val admitted = scheduler_owner_admit_v1(recovered, [fresh],
                fresh.action_digest, "fresh-1", "worker-1", capacity, 0)
            expect(admitted.dispatch).to_be(true)
            step("Verify current integration candidate")
            expect(recovered.state.ledger.accepted[0].action_digest)
                .to_equal(past.action_digest)
            expect(recovered.state.ledger.attempts.len()).to_equal(3)
            expect(scheduler_owner_close_v1(recovered)).to_be(true)

        it "should refuse a late result after revocation and journal replay":
            step("Select exact source and policy snapshot")
            val action = _dist_action_v1("revoked", [])
            val root = _dist_owner_root_v1("late-result")
            expect(dir_create_all("build/test")).to_be(true)
            val owner = scheduler_owner_open_v1(root)
            expect(owner.error).to_equal("")
            step("Dispatch admitted actions")
            val first = scheduler_owner_admit_v1(owner, [action],
                action.action_digest, "revoked-1", "worker-1",
                SchedulerCapacityV1(1, 8192, 1024, 2), 0)
            expect(first.dispatch).to_be(true)
            val revoked = scheduler_owner_revoke_v1(owner, "revoked-1")
            expect(revoked.acknowledged).to_be(true)
            expect(revoked.fence).to_equal(first.fence + 1)
            expect(scheduler_owner_close_v1(owner)).to_be(true)
            step("Validate and publish results")
            val recovered = scheduler_owner_open_v1(root)
            expect(recovered.error).to_equal("")
            val output = sha256_text("late-output")
            val late = scheduler_owner_publish_v1(recovered,
                _dist_candidate_v1(action, "revoked-1", first.fence,
                    output), output)
            expect(late.acknowledged).to_be(false)
            expect(late.error).to_equal("scheduler-error: stale-fence")
            step("Verify current integration candidate")
            expect(recovered.state.ledger.accepted.len()).to_equal(0)
            expect(scheduler_owner_close_v1(recovered)).to_be(true)
