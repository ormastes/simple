# @req REQ-002, REQ-003, REQ-004, REQ-014
# Evidence class: live-host only when an administrator provisions the fixture.
# @evidence-display: links
use std.spec.*
use app.io.mod.{env_get}
use app.build.scheduler.two_node_qualification_live.{TwoNodeLiveFixtureV1,
    qualify_issued_two_node_graph_v1}

fn _two_node_live_fixture_v1() -> TwoNodeLiveFixtureV1:
    TwoNodeLiveFixtureV1(
        env_get("SIMPLE_DIST_QUAL_NATIVE") ?? "",
        env_get("SIMPLE_DIST_QUAL_NATIVE_SHA256") ?? "",
        env_get("SIMPLE_DIST_QUAL_ISSUED_RECORD") ?? "",
        env_get("SIMPLE_DIST_QUAL_PRODUCER_ACTION") ?? "",
        env_get("SIMPLE_DIST_QUAL_CONSUMER_ACTION") ?? "",
        env_get("SIMPLE_DIST_QUAL_PRODUCER_WORKER") ?? "",
        env_get("SIMPLE_DIST_QUAL_CONSUMER_WORKER") ?? "",
        env_get("SIMPLE_DIST_QUAL_PRODUCER_OUTPUT") ?? "",
        env_get("SIMPLE_DIST_QUAL_PRODUCER_OUTPUT_SHA256") ?? "",
        env_get("SIMPLE_DIST_QUAL_CONSUMER_OUTPUT") ?? "",
        env_get("SIMPLE_DIST_QUAL_CONSUMER_OUTPUT_SHA256") ?? "")

describe "issued distributed build on two authenticated Linux OCI workers":
    describe "REQ-004 and REQ-014: live remote graph evidence":
        it "should block when no pinned installed native controller exists":
            step("Select exact source and policy snapshot")
            val fixture = TwoNodeLiveFixtureV1("", "", "", "", "",
                "", "", "", "", "", "")
            step("Check installed controller admission")
            val result = qualify_issued_two_node_graph_v1(fixture)
            expect(result.status).to_equal("BLOCKED")
            expect(result.reason)
                .to_equal("issued-native-unavailable-or-unpinned")

        it "should publish and clean a cold producer and consumer on distinct workers":
            val fixture = _two_node_live_fixture_v1()
            if fixture.native_path == "":
                skip("should publish and clean a cold producer and consumer on distinct workers",
                    "administrator two-node native, issued record and OCI workers are not provisioned")
            else:
                step("Select exact source, issued record and native digest")
                expect(fixture.producer_worker != fixture.consumer_worker)
                    .to_be(true)
                step("Query both authenticated worker OCI capabilities")
                step("Dispatch a cold issued producer and consumer graph")
                val result = qualify_issued_two_node_graph_v1(fixture)
                step("Replay owner ledger and verify retained producer dependency bytes")
                expect(result.status).to_equal("PASS")
                expect(result.producer_attempt != "").to_be(true)
                expect(result.consumer_attempt != "").to_be(true)
                expect(result.attempt_count).to_equal(2)
                step("Confirm durable cleanup and no new attempts on repeat")
                expect(result.producer_provider).to_contain("linux-oci-v1")
                expect(result.consumer_provider).to_contain("linux-oci-v1")
                expect(result.native_digest).to_equal(fixture.native_digest)
                print("two-node-evidence native={result.native_digest} producer-worker={fixture.producer_worker} producer-attempt={result.producer_attempt} producer-provider={result.producer_provider} consumer-worker={fixture.consumer_worker} consumer-attempt={result.consumer_attempt} consumer-provider={result.consumer_provider} attempts={result.attempt_count} elapsed-ms={result.elapsed_ms}")
