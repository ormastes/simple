# Purpose and audience: executable specification evidence for the runtime and SFFI maintainers.
# @req REQ-SSPEC-APP
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md
# @cover scripts/check/check-rt-pointer-ref-map.py 90%
"""
# rt pointer map acceptance

## Purpose and audience

Runtime maintainers read this to confirm the shipped tree passes the pointer map gate end to end.

## Operator workflow

Run `python3 -I scripts/check/check-rt-pointer-ref-map.py`; the last stdout line is the verdict.

## Compatibility and limitations

The guard is a text scan, so it gives mapping evidence only. Compile and link stay UNTESTED on every host.

## Verification guidance and troubleshooting

A stale baseline row means a mismatch was fixed: delete that row. Never regenerate to hide a new row.
"""

use std.spec.step
use std.spec.*

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)

describe "rt pointer map gate on the real tree":
    it "reports a passing verdict with visible untested coverage":
        step("Run the gate over the repository")
        val (out, _err, code) = rt_process_run("python3", ["-I", "scripts/check/check-rt-pointer-ref-map.py"])

        step("Confirm the verdict and the coverage disclosure")
        expect(code).to_equal(0)
        expect(out).to_contain("PASS")
        expect(out).to_contain("compile=UNTESTED link=UNTESTED")

    it "accepts every built-in fixture case":
        step("Run the gate selftest")
        val (out, _err, code) = rt_process_run("python3", ["-I", "scripts/check/check-rt-pointer-ref-map.py", "--selftest"])

        step("Confirm all cases held")
        expect(code).to_equal(0)
        expect(out).to_contain("PASS — selftest")
