# Purpose and audience: prevention evidence for ft29-5 NVMe spec harness regressions.
# @req REQ-SSPEC-SYSTEM
"""
Prevention for two harness regressions:
1. A refactor removed `struct FsblVector` from the Cosmos boot spec while a
   use site remained (semantic error, child died by signal).
2. The base-spec example (~27 s interpreted) was killed by the seed's 10 s
   `examples/` watchdog because the spec never set SIMPLE_TIMEOUT_SECONDS.
"""

use std.spec.*
use app.io.mod.{file_read_text}

val BOOT_SPEC: text = "test/03_system/app/nvme_firmware/nvme_cosmos_openssd_boot_spec.spl"
val BASE_SPEC: text = "test/03_system/app/nvme_firmware/nvme_base_spec_commands_spec.spl"

describe "NVMe spec harness prevention":
    it "defines every FsblVector the Cosmos boot spec constructs":
        step("A constructed FsblVector requires its struct in the same file")
        val src = file_read_text(BOOT_SPEC)
        if src.contains("FsblVector("):
            expect(src).to_contain("struct FsblVector:")

    it "gives the base-spec example run an explicit watchdog budget":
        step("The runner must not rely on the 10 s default examples timeout")
        val src = file_read_text(BASE_SPEC)
        expect(src).to_contain("SIMPLE_TIMEOUT_SECONDS")
