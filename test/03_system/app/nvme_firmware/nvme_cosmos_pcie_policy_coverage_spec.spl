"""Cosmos PCIe/NVMe pure-policy parity and scoped coverage receipt."""

use std.spec.*
use std.io_runtime.{process_run}

describe "Cosmos PCIe/NVMe policy migration evidence":
    it "matches the C oracle and measures only the bridge/policy slice":
        step("Run exhaustive C-oracle parity and scoped instrumentation")
        val (out, err, code) = process_run(
            "/bin/sh", ["-c", "sh scripts/check/check-cosmos-nvme-pcie-policy.shs"]
        )
        expect(code).to_equal(0)
        expect(out).to_contain("cosmos_nvme_pcie_oracle_parity_vectors=")
        expect(out).to_contain("cosmos_nvme_pcie_c_bridge_branches=")
        expect(out).to_contain("cosmos_nvme_pcie_simple_policy_decisions=")
        expect(out).to_contain("cosmos_nvme_pcie_board_evidence=separate-unavailable")
        expect(out).to_contain("STATUS: PASS cosmos-nvme-pcie policy parity and scoped coverage")
        if out.contains("FAIL") or err.contains("FAIL"):
            fail("Cosmos PCIe/NVMe scoped gate emitted a failure marker")
