"""
Scoped Cosmos FSBL coverage receipt.

This host gate measures only the C acquisition bridge and pure-Simple FSBL
policy. Physical-board evidence stays separate, and the result never claims
coverage of the whole Cosmos HAL.
"""

use std.spec.*
use std.io_runtime.{process_run}

fn _run(cmd: text) -> (text, text, i64):
    process_run("/bin/sh", ["-c", cmd])

describe "Cosmos FSBL runtime branch evidence receipt":
    it "binds the C bridge and executed Simple policy object to exact sources":
        step("Build the policy with an admitted self-host and run it from C")
        val (out, err, code) = _run("sh scripts/check/check-cosmos-fsbl-coverage.shs")
        expect(code).to_equal(0)

        step("Keep C LLVM branches separate from Simple runtime outcomes")
        expect(out).to_contain("cosmos_fsbl_c_bridge_llvm_branches=2/2")
        expect(out).to_contain("cosmos_fsbl_simple_runtime_outcomes=24/24")
        expect(out).to_contain("cosmos_fsbl_simple_policy_object=")
        expect(out).to_contain("STATUS: PASS cosmos-fsbl scoped runtime branch evidence")

        step("Keep physical-board and whole-HAL claims out of the receipt")
        expect(out).to_contain("cosmos_fsbl_board_evidence=separate-not-included")

        step("Prove the validator bites when one executed outcome is removed")
        expect(out).to_contain("SABOTAGE c-zero-denominator REJECTED")
        expect(out).to_contain("SABOTAGE simple-removed-outcome REJECTED")
        expect(out).to_contain("SABOTAGE source-hash REJECTED")
        expect(out).to_contain("SABOTAGE board-blend REJECTED")
        if out.contains("FAIL") or err.contains("FAIL"):
            fail("Cosmos FSBL coverage gate emitted a failure marker")
