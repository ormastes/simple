        step("garbage for fn main() -> (), so the printed lines are the only sound signal")
        expect(log).to_contain("CSTS.RDY is 0 at power-on")
        expect(log).to_contain("CAP.MQES is 0-based and agrees with the queue depth")
        expect(log).to_contain("CAP.DSTRD decodes to the profile's doorbell stride")
        expect(log).to_contain("AQA.ASQS reads back what the host wrote")
        expect(log).to_contain("ACQ base reads back what the host wrote")
        expect(log).to_contain("RDY is not instant: still 0 immediately after the CC write")
        expect(log).to_contain("CSTS.RDY is now 1 -- the controller is enabled")
        expect(log).to_contain("bringup() drives the whole sequence through the registers")
        expect(log).to_contain("NVME REGISTERS OK")

