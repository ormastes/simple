        val log: text = out + err

        step("A silent exit is INCONCLUSIVE, not a pass: bin/simple run exit codes are")
        step("garbage for fn main() -> (), so the printed lines are the only sound signal")
        expect(log).to_contain("ASQ memory CDW0[7:0] holds the Identify opcode")
        expect(log).to_contain("device has NOT seen the admin command before the doorbell")
        expect(log).to_contain("device serviced the admin command only after the doorbell")
        expect(log).to_contain("ACQ slot 0 now carries phase 1")
        expect(log).to_contain("Identify produced a CONTROLLER structure")
        expect(log).to_contain("Create CQ + Create SQ for qid 1 succeeded over the doorbell path")
