# Fixture: TWO distinct multi-line loop headers whose FIRST line is the bare
# token `while (`. Keying on the first line alone collapses both into the single
# degenerate key `while (` with count=2, which cannot say which loop changed
# (recorded as §3.1 of
# doc/08_tracking/bug/cpu_hotloop_gate_red_key_churn_and_prose_scoring_2026-08-01.md).
# The gate must instead join each header through its closing `:` and emit TWO
# distinct keys, still totalling new=2 — refining keys must never change the
# scored total.
fn scan_left(a: i32, b: i32, n: i32):
    var i = 0
    while (
        i < n and a < b
    ):
        i = i + 1

fn scan_right(a: i32, b: i32, n: i32):
    var j = 0
    while (
        j < n and b > a
    ):
        j = j + 1
