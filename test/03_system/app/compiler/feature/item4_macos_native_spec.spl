"""ITEM4 Mach-O file adapter acceptance. UNRUN; image construction is not Darwin execution."""
use std.spec.*
use std.spec.step
use std.io_runtime.{dir_create_all, file_exists, file_read_bytes}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write_bytes, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use compiler.backend.linker.native_config.{NativeLinkConfig}
use compiler.backend.linker.macho.native_adapter.{native_macho_plan_v1, native_macho_link_files_v1}

fn item4_macos_native_config() -> NativeLinkConfig:
    var config = NativeLinkConfig.default()
    config.allow_duplicate_definitions = false
    config.allow_cc_fallback = false
    config.runtime_path = "none"
    config.extra_flags = ["-platform_version", "macos", "11.0", "11.0", "--macho-signing-identifier", "simple.item4.fixture", "-rpath", "@loader_path"]
    config

fn item4_macos_native_parent() -> Result<text, text>:
    if not dir_create_all("build"): return Err("Mach-O adapter test directory unavailable")
    secure_temp_dir("build", "item4-macos-native-")

fn item4_macos_native_read(bytes: [u8], offset: i64, width: i64 = 4) -> i64:
    val valid = width > 0 and width <= 8 and offset >= 0 and offset <= bytes.len() and width <= bytes.len() - offset
    expect(valid).to_equal(true)
    if not valid: return 0
    var value: i64 = 0
    for index in 0..width: value = value | ((bytes[offset + index] as i64) << (index * 8))
    value

fn item4_macos_native_command(bytes: [u8], kind: i64) -> i64:
    expect(bytes.len() >= 32).to_equal(true)
    if bytes.len() < 32: return -1
    val count = item4_macos_native_read(bytes, 16)
    val size = item4_macos_native_read(bytes, 20)
    expect(size >= 0 and size <= bytes.len() - 32 and count <= size / 8).to_equal(true)
    if size < 0 or size > bytes.len() - 32 or count > size / 8: return -1
    var at: i64 = 32
    for index in 0..count:
        if at > 32 + size - 8:
            expect(false).to_equal(true)
            return -1
        val length = item4_macos_native_read(bytes, at + 4)
        if length < 8 or length > 32 + size - at:
            expect(false).to_equal(true)
            return -1
        if item4_macos_native_read(bytes, at) == kind:
            val minimum = if kind == 0x80000022: 48 elif kind == 0x1d: 16 elif kind == 0xe or kind == 0x8000001c: 12 else: 24
            expect(length >= minimum).to_equal(true)
            if length < minimum: return -1
            return at
        at = at + length
    expect(false).to_equal(true)
    -1

fn item4_macos_native_check_image(bytes: [u8], arm: bool):
    expect(bytes.len() > 0xc010).to_equal(true)
    if bytes.len() <= 0xc010: return
    expect(item4_macos_native_read(bytes, 0)).to_equal(0xfeedfacf)
    expect(item4_macos_native_read(bytes, 4)).to_equal(if arm: 0x0100000c else: 0x01000007)
    expect(item4_macos_native_read(bytes, 12)).to_equal(2)
    expect(item4_macos_native_read(bytes, 24) & 0x200000).to_equal(0x200000)
    val main = item4_macos_native_command(bytes, 0x80000028)
    if main < 0: return
    expect(item4_macos_native_read(bytes, main + 8, 8)).to_equal(0x4000)
    val dyld = item4_macos_native_command(bytes, 0xe)
    if dyld < 0: return
    val signature = item4_macos_native_command(bytes, 0x1d)
    if signature < 0: return
    val signature_offset = item4_macos_native_read(bytes, signature + 8)
    val signature_size = item4_macos_native_read(bytes, signature + 12)
    val signature_valid = signature_size >= 12 and signature_offset >= 0 and signature_offset <= bytes.len() and signature_size <= bytes.len() - signature_offset
    expect(signature_valid).to_equal(true)
    if not signature_valid: return
    expect(item4_macos_native_read(bytes, signature_offset)).to_equal(0xc00cdefa)
    val version = item4_macos_native_command(bytes, 0x32)
    if version < 0: return
    expect(item4_macos_native_read(bytes, version + 8)).to_equal(1)
    expect(item4_macos_native_read(bytes, version + 12)).to_equal(0xb0000)
    expect(item4_macos_native_read(bytes, version + 16)).to_equal(0xb0000)
    expect(item4_macos_native_read(bytes, 0xc008, 8)).to_equal(0x100004000)

describe "explicit internal Mach-O native file adapter":
    it "ITEM4-REQ-006 resolves a bare library name through an actual configured search directory":
        step("Plan an explicitly selected Mach-O link")
        val created = item4_macos_native_parent()
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val parent = created.unwrap()
        val provider = file_read_bytes("test/fixtures/linker/macho/provider_x64.dylib")
        expect(provider.len() > 32).to_equal(true)
        if provider.len() <= 32:
            expect(dir_remove(parent)).to_equal(true)
            return
        val copied = file_write_bytes(parent + "/libitem4.dylib", provider)
        expect(copied).to_equal(true)
        if not copied:
            expect(dir_remove(parent)).to_equal(true)
            return
        var config = item4_macos_native_config()
        config.libraries = ["item4"]
        config.library_paths = [parent]
        config.extra_flags = config.extra_flags + ["--macho-max-image-bytes", "1048576"]
        val output = parent + "/app"
        val plan = native_macho_plan_v1("x86_64", config, output)
        expect(plan.is_ok()).to_equal(true)
        if plan.is_ok():
            expect(plan.unwrap().request.max_image_bytes).to_equal(1048576)
            step("Link real object and provider files")
            val linked = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o"], [], output)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                step("Inspect the published Mach-O commands and bytes")
                val bytes = file_read_bytes(output)
                item4_macos_native_check_image(bytes, false)
                expect(bytes.len() <= 1048576).to_equal(true)
                expect(item4_macos_native_command(bytes, 0xc) >= 0).to_equal(true)
                expect(item4_macos_native_read(bytes, 0xc000, 8)).to_equal(0)
            step("Refuse a selected SDK stub without falling through to a valid archive")
            val removed_dylib = file_remove(parent + "/libitem4.dylib")
            expect(removed_dylib).to_equal(true)
            val archive = file_read_bytes("test/fixtures/linker/macho/provider_x64.a")
            expect(archive.len() > 8).to_equal(true)
            val archive_written = if archive.len() > 8: file_write_bytes(parent + "/libitem4.a", archive) else: false
            val stub_written = file_write_bytes(parent + "/libitem4.tbd", [45u8, 45u8, 45u8, 10u8])
            val sentinel_written = file_write_bytes(output, [17u8, 0u8, 255u8])
            expect(archive_written and stub_written and sentinel_written).to_equal(true)
            if removed_dylib and archive_written and stub_written and sentinel_written:
                val refused = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o"], [], output)
                expect(refused.is_err()).to_equal(true)
                if refused.is_err(): expect(refused.unwrap_err()).to_contain("TBD")
                expect(file_read_bytes(output)).to_equal([17u8, 0u8, 255u8])
                val removed_stub = file_remove(parent + "/libitem4.tbd")
                expect(removed_stub).to_equal(true)
                if removed_stub:
                    val archived = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o"], [], output)
                    expect(archived.is_ok()).to_equal(true)
                    if archived.is_ok():
                        val bytes = file_read_bytes(output)
                        item4_macos_native_check_image(bytes, false)
                        expect(item4_macos_native_read(bytes, 0x4002)).to_equal(14)
                        expect(item4_macos_native_read(bytes, 0xc018, 8)).to_equal(0x10000c010)
        step("Remove owned fixture files")
        if file_exists(output): expect(file_remove(output)).to_equal(true)
        for name in ["libitem4.dylib", "libitem4.tbd", "libitem4.a"]:
            if file_exists(parent + "/" + name): expect(file_remove(parent + "/" + name)).to_equal(true)
        expect(dir_remove(parent)).to_equal(true)

    it "ITEM4-REQ-006 consumes real object and archive providers and preserves successful replacement semantics":
        for archived in [false, true]:
            step("Plan an explicitly selected Mach-O link")
            val created = item4_macos_native_parent()
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            val output = parent + "/app"
            val written = file_write_bytes(output, [17u8, 0u8, 255u8])
            expect(written).to_equal(true)
            if not written:
                expect(dir_remove(parent)).to_equal(true)
                return
            val plan = native_macho_plan_v1("x86_64", item4_macos_native_config(), output)
            expect(plan.is_ok()).to_equal(true)
            if plan.is_err():
                expect(file_remove(output)).to_equal(true)
                expect(dir_remove(parent)).to_equal(true)
                return
            val provider = if archived: "provider_x64.a" else: "provider_x64.o"
            step("Link real object and provider files")
            val linked = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o", "test/fixtures/linker/macho/{provider}"], [], output)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                step("Inspect the published Mach-O commands and bytes")
                val bytes = file_read_bytes(output)
                item4_macos_native_check_image(bytes, false)
                expect(item4_macos_native_read(bytes, 0x4002)).to_equal(14)
                expect(item4_macos_native_read(bytes, 0xc018, 8)).to_equal(0x10000c010)
                val fixups = item4_macos_native_command(bytes, 0x80000022)
                if fixups >= 0: expect(item4_macos_native_read(bytes, fixups + 20)).to_equal(1)
            step("Remove owned fixture files")
            expect(file_remove(output)).to_equal(true)
            expect(dir_remove(parent)).to_equal(true)

    it "ITEM4-REQ-006 rejects malformed flags unsupported policy and targets before reading input files":
        step("Reject unsupported configuration before input reads")
        val flag_sets: [[text]] = [
            [], ["-platform_version"], ["-platform_version", "ios", "11", "11"],
            ["-platform_version", "macos", "10.15", "11"],
            ["-platform_version", "macos", "11.256", "12"],
            ["-platform_version", "macos", "12", "11"],
            ["--macho-signing-identifier"],
            ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "x", "--unknown"],
            ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "x", "-e"],
            ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "x", "-e", "_main", "-e", "_main"],
            ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "x", "--macho-max-image-bytes", "invalid"],
            ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "x\0y"]]
        for flags in flag_sets:
            var config = item4_macos_native_config()
            config.extra_flags = flags
            expect(native_macho_plan_v1("x86_64", config, "build/never-read/app").is_err()).to_equal(true)
        for kind in 0..9:
            var config = item4_macos_native_config()
            if kind == 0: config.pie = false
            if kind == 1: config.debug = true
            if kind == 2: config.strip_output = true
            if kind == 3: config.prefer_size_linker = true
            if kind == 4: config.retained_symbols = ["_helper"]
            if kind == 5: config.libraries = ["bad\0lib"]
            if kind == 6: config.library_paths = ["bad\0path"]
            if kind == 7: config.target_triple = "aarch64-apple-darwin"
            if kind == 8: config.linker_abi = "elf"
            expect(native_macho_plan_v1("x86_64", config, "build/never-read/app").is_err()).to_equal(true)
        expect(native_macho_plan_v1("riscv64", item4_macos_native_config(), "build/never-read/app").is_err()).to_equal(true)
        expect(native_macho_plan_v1("x86_64", item4_macos_native_config(), "").is_err()).to_equal(true)

    it "ITEM4-REQ-007 preserves destination bytes on missing invalid incompatible and unresolved inputs":
        for kind in 0..6:
            step("Plan an explicitly selected Mach-O link")
            val created = item4_macos_native_parent()
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            val output = parent + "/app"
            val written = file_write_bytes(output, [17u8, 0u8, 255u8])
            expect(written).to_equal(true)
            if not written:
                expect(dir_remove(parent)).to_equal(true)
                return
            var config = item4_macos_native_config()
            if kind == 2: config.libraries = ["test/fixtures/linker/macho/provider_a64.dylib"]
            if kind == 5: config.runtime_path = parent + "/runtime"
            val plan = native_macho_plan_v1("x86_64", config, output)
            expect(plan.is_ok()).to_equal(true)
            if plan.is_err():
                expect(file_remove(output)).to_equal(true)
                expect(dir_remove(parent)).to_equal(true)
                return
            var inputs = ["test/fixtures/linker/macho/hosted_start_x64.o"]
            if kind == 0: inputs = [parent + "/missing.o"]
            if kind == 1:
                val invalid_written = file_write_bytes(parent + "/invalid.o", [1u8, 2u8, 3u8])
                expect(invalid_written).to_equal(true)
                if not invalid_written:
                    expect(file_remove(output)).to_equal(true)
                    expect(dir_remove(parent)).to_equal(true)
                    return
                inputs = [parent + "/invalid.o"]
            step("Preserve the existing destination on construction failure")
            val runtime_archives: [text] = if kind == 4: ["test/fixtures/linker/macho/provider_x64.a"] else: []
            val rejected = native_macho_link_files_v1(plan.unwrap(), inputs, runtime_archives, output)
            expect(rejected.is_err()).to_equal(true)
            if rejected.is_err():
                val tokens = ["cannot be read", "unsupported Mach-O input format", "CPU", "unresolved hosted import", "runtime archives with runtime path none", "runtime archives were not resolved"]
                expect(rejected.unwrap_err()).to_contain(tokens[kind])
            expect(file_read_bytes(output)).to_equal([17u8, 0u8, 255u8])
            step("Remove owned fixture files")
            if file_exists(parent + "/invalid.o"): expect(file_remove(parent + "/invalid.o")).to_equal(true)
            expect(file_remove(output)).to_equal(true)
            expect(dir_remove(parent)).to_equal(true)

    it "ITEM4-REQ-006 plans and constructs actual x64 and ARM64 dylib-linked executable images":
        for arm in [false, true]:
            step("Plan an explicitly selected Mach-O link")
            val created = item4_macos_native_parent()
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            val output = parent + "/app"
            val arch = if arm: "aarch64" else: "x86_64"
            val suffix = if arm: "a64" else: "x64"
            var config = item4_macos_native_config()
            if not arm: config.libraries = ["test/fixtures/linker/macho/provider_{suffix}.dylib"]
            val plan = native_macho_plan_v1(arch, config, output)
            expect(plan.is_ok()).to_equal(true)
            if plan.is_err():
                expect(dir_remove(parent)).to_equal(true)
                return
            expect(plan.unwrap().request.minimum_os).to_equal(0xb0000)
            expect(plan.unwrap().request.sdk).to_equal(0xb0000)
            expect(plan.unwrap().request.entry).to_equal("_main")
            step("Link real object and provider files")
            var inputs = ["test/fixtures/linker/macho/hosted_start_{suffix}.o"]
            if arm: inputs.push("test/fixtures/linker/macho/provider_{suffix}.dylib")
            val linked = native_macho_link_files_v1(plan.unwrap(), inputs, [], output)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                expect(linked.unwrap()).to_equal(output)
                step("Inspect the published Mach-O commands and bytes")
                val bytes = file_read_bytes(output)
                item4_macos_native_check_image(bytes, arm)
                val rpath = item4_macos_native_command(bytes, 0x8000001c)
                if rpath >= 0:
                    val rpath_size = item4_macos_native_read(bytes, rpath + 4)
                    val rpath_offset = item4_macos_native_read(bytes, rpath + 8)
                    val expected_path = "@loader_path"
                    val path_valid = rpath_offset >= 12 and rpath_offset <= rpath_size and expected_path.len() < rpath_size - rpath_offset
                    expect(path_valid).to_equal(true)
                    if path_valid:
                        for index in 0..expected_path.len(): expect(bytes[rpath + rpath_offset + index]).to_equal(expected_path.byte_at(index) as u8)
                        expect(bytes[rpath + rpath_offset + expected_path.len()]).to_equal(0u8)
                val provider = item4_macos_native_command(bytes, 0xc)
                expect(provider >= 0).to_equal(true)
                if provider >= 0:
                    val size = item4_macos_native_read(bytes, provider + 4)
                    val name_offset = item4_macos_native_read(bytes, provider + 8)
                    val expected_name = "@rpath/libitem4.dylib"
                    val name_valid = name_offset >= 24 and name_offset <= size and expected_name.len() < size - name_offset
                    expect(name_valid).to_equal(true)
                    if name_valid:
                        for index in 0..expected_name.len(): expect(bytes[provider + name_offset + index]).to_equal(expected_name.byte_at(index) as u8)
                        expect(bytes[provider + name_offset + expected_name.len()]).to_equal(0u8)
                val fixups = item4_macos_native_command(bytes, 0x80000022)
                if fixups >= 0: expect(item4_macos_native_read(bytes, fixups + 20) > 20).to_equal(true)
            step("Remove owned fixture files")
            if file_exists(output): expect(file_remove(output)).to_equal(true)
            expect(dir_remove(parent)).to_equal(true)

    it "ITEM4-REQ-006 rejects default unsupported configuration before input reads":
        step("Reject unsupported configuration before input reads")
        val rejected = native_macho_plan_v1("x86_64", NativeLinkConfig.default(), "build/item4-macos-never-created")
        expect(rejected.is_err()).to_equal(true)
