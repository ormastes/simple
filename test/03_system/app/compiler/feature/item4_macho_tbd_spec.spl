"""ITEM4-REQ-006 SDK TextAPI file acceptance. UNRUN; external LLVM fixture validation is separate."""
use std.spec.*
use std.spec.step
use std.io_runtime.{dir_create_all, file_read_bytes, file_exists}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write_bytes, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use compiler.backend.linker.native_config.{NativeLinkConfig}
use compiler.backend.linker.macho.native_adapter.{native_macho_plan_v1, native_macho_link_files_v1}
use compiler.backend.linker.reloc_engine.{RelocArch}
use compiler.backend.linker.macho.tbd_types.{MachOTbdTargetV1, macho_tbd_default_limits_v1}
use compiler.backend.linker.macho.tbd_reader.{macho_read_tbd_v1}
use compiler.backend.linker.macho.tbd_lower.{macho_tbd_main_provider_v1}
use compiler.backend.linker.macho.hosted_link.{MachOHostedRequest, macho_hosted_link_with_providers}

fn item4_macho_tbd_read(bytes: [u8], at: i64, width: i64) -> i64:
    val valid = width >= 1 and width <= 8 and at >= 0 and at <= bytes.len() and width <= bytes.len() - at
    expect(valid).to_equal(true)
    if not valid: return 0
    var value: i64 = 0
    for index in 0..width: value = value | ((bytes[at + index] as i64) << (index * 8))
    value

fn item4_macho_tbd_config() -> NativeLinkConfig:
    var config = NativeLinkConfig.default()
    config.runtime_path = "none"
    config.allow_cc_fallback = false
    config.extra_flags = ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "simple.item4.tbd", "-rpath", "@loader_path"]
    config

describe "actual TextAPI providers through the Mach-O file adapter":
    it "ITEM4-REQ-007 preserves output when a selected malformed stub precedes a valid archive":
        for name in ["duplicate_key_v4", "duplicate_key_v5", "truncated_v4", "truncated_v5"]:
            step("Plan an explicitly selected Mach-O link")
            val made = dir_create_all("build")
            expect(made).to_equal(true)
            if not made: return
            val created = secure_temp_dir("build", "item4-tbd-rejection-")
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            val output = parent + "/app"
            val stub = file_read_bytes("test/fixtures/linker/macho/tbd_{name}.tbd")
            val archive = file_read_bytes("test/fixtures/linker/macho/provider_x64.a")
            expect(stub.len() > 0 and archive.len() > 8).to_equal(true)
            if stub.len() == 0 or archive.len() <= 8:
                expect(dir_remove(parent)).to_equal(true)
                return
            val stub_written = file_write_bytes(parent + "/libitem4.tbd", stub)
            val archive_written = file_write_bytes(parent + "/libitem4.a", archive)
            val sentinel_written = file_write_bytes(output, [17u8, 0u8, 255u8])
            expect(stub_written and archive_written and sentinel_written).to_equal(true)
            if stub_written and archive_written and sentinel_written:
                var config = item4_macho_tbd_config()
                config.libraries = ["item4"]
                config.library_paths = [parent]
                val plan = native_macho_plan_v1("x86_64", config, output)
                expect(plan.is_ok()).to_equal(true)
                if plan.is_ok():
                    step("Preserve the existing destination on selected TextAPI failure")
                    val rejected = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o"], [], output)
                    expect(rejected.is_err()).to_equal(true)
                    if rejected.is_err(): expect(rejected.unwrap_err()).to_contain("TBD")
                    expect(file_read_bytes(output)).to_equal([17u8, 0u8, 255u8])
                    val removed = file_remove(parent + "/libitem4.tbd")
                    expect(removed).to_equal(true)
                    if removed:
                        step("Removing only the rejected stub allows the same plan to select its real archive")
                        val linked = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_x64.o"], [], output)
                        expect(linked.is_ok()).to_equal(true)
                        if linked.is_ok():
                            val image = file_read_bytes(output)
                            expect(item4_macho_tbd_read(image, 0, 4)).to_equal(0xfeedfacf)
                            expect(item4_macho_tbd_read(image, 0x4002, 4)).to_equal(14)
                            expect(item4_macho_tbd_read(image, 0xc018, 8)).to_equal(0x10000c010)
            step("Remove owned fixture files")
            for leaf in ["app", "libitem4.tbd", "libitem4.a"]:
                if file_exists(parent + "/" + leaf): expect(file_remove(parent + "/" + leaf)).to_equal(true)
            expect(dir_remove(parent)).to_equal(true)

    it "ITEM4-REQ-006 rejects duplicate keys malformed documents target misses and logical parser budget exhaustion":
        val target = MachOTbdTargetV1(arch: RelocArch.X86_64, platform: 1)
        step("Reject malformed TextAPI rather than normalizing ambiguous keys")
        for name in ["duplicate_key_v4", "duplicate_key_v5", "truncated_v4", "truncated_v5"]:
            val bytes = file_read_bytes("test/fixtures/linker/macho/tbd_{name}.tbd")
            expect(bytes.len() > 0).to_equal(true)
            if bytes.len() == 0: return
            val rejected = macho_read_tbd_v1(bytes, target, macho_tbd_default_limits_v1())
            expect(rejected.is_err()).to_equal(true)
            if rejected.is_err(): expect(rejected.unwrap_err()).to_contain("TBD")
        step("Apply byte token nesting library symbol and name limits to real documents")
        for format in ["v4", "v5"]:
            val bytes = file_read_bytes("test/fixtures/linker/macho/tbd_metadata_{format}.tbd")
            val baseline = macho_read_tbd_v1(bytes, target, macho_tbd_default_limits_v1())
            expect(baseline.is_ok()).to_equal(true)
            if baseline.is_err(): return
            for kind in 0..6:
                var limits = macho_tbd_default_limits_v1()
                if kind == 0: limits.max_bytes = bytes.len() - 1
                if kind == 1: limits.max_tokens = 1
                if kind == 2: limits.max_depth = 1
                if kind == 3: limits.max_libraries = 1
                if kind == 4: limits.max_symbols = 1
                if kind == 5: limits.max_name_bytes = 8
                val rejected = macho_read_tbd_v1(bytes, target, limits)
                expect(rejected.is_err()).to_equal(true)
                if rejected.is_err(): expect(rejected.unwrap_err()).to_contain("TBD")
            val missing = macho_read_tbd_v1(bytes, MachOTbdTargetV1(arch: RelocArch.X86_64, platform: 2), macho_tbd_default_limits_v1())
            expect(missing.is_err()).to_equal(true)
            if missing.is_err(): expect(missing.unwrap_err()).to_contain("TBD")

    it "ITEM4-REQ-006 preserves unmatched inline identity instead of inventing a selected install name":
        step("Read an independently validated TextAPI fixture")
        val parsed = macho_read_tbd_v1(file_read_bytes("test/fixtures/linker/macho/tbd_inline_unmatched_v5.tbd"),
            MachOTbdTargetV1(arch: RelocArch.X86_64, platform: 1), macho_tbd_default_limits_v1())
        expect(parsed.is_ok()).to_equal(true)
        if parsed.is_err(): return
        val document = parsed.unwrap()
        expect(document.main.install_name).to_equal(Some("/usr/lib/libitem4_main.dylib"))
        expect(document.libraries.len()).to_equal(1)
        if document.libraries.len() != 1: return
        val library = document.libraries[0]
        expect(library.selected).to_equal(false)
        expect(library.install_name.is_none()).to_equal(true)
        expect(library.install_names.len()).to_equal(1)
        if library.install_names.len() == 1:
            expect(library.install_names[0].targets).to_equal(["arm64-macos"])
            expect(library.install_names[0].name).to_equal("/usr/lib/libitem4_arm_only.dylib")

    it "ITEM4-REQ-006 lowers ObjC and TLV names into actual typed provider behavior in both formats":
        for variant in 0..4:
            val arm = variant % 2 == 1
            val format = if variant >= 2: "v5" else: "v4"
            val target = MachOTbdTargetV1(arch: if arm: RelocArch.AArch64 else: RelocArch.X86_64, platform: 1)
            val parsed = macho_read_tbd_v1(file_read_bytes("test/fixtures/linker/macho/tbd_leaf_metadata_{format}.tbd"), target, macho_tbd_default_limits_v1())
            expect(parsed.is_ok()).to_equal(true)
            if parsed.is_err(): return
            step("Lower the selected leaf provider without inventing SDK or virtual addresses")
            val lowered = macho_tbd_main_provider_v1(parsed.unwrap(), target)
            expect(lowered.is_ok()).to_equal(true)
            if lowered.is_err(): return
            val provider = lowered.unwrap()
            for name in ["_OBJC_CLASS_$_Item4Class", "_OBJC_METACLASS_$_Item4Class", "_OBJC_EHTYPE_$_Item4Exception", "_OBJC_IVAR_$_Item4Class.field"]:
                var found = false
                for symbol in provider.exports:
                    if symbol.name == name: found = true
                expect(found).to_equal(true)
            var weak = false
            var tls = false
            for symbol in provider.exports:
                if symbol.name == "_unused_weak" and (symbol.flags & 4) != 0: weak = true
                if symbol.name == "_tls" and (symbol.flags & 3) == 1: tls = true
            expect(weak and tls).to_equal(true)
            val suffix = if arm: "a64" else: "x64"
            val object = file_read_bytes("test/fixtures/linker/macho/hosted_tlv_{suffix}.o")
            expect(object.len() > 32).to_equal(true)
            if object.len() <= 32: return
            val request = MachOHostedRequest(target: target.arch, entry: "_main", minimum_os: 0xb0000,
                sdk: 0xb0000, max_image_bytes: 1048576, identifier: "simple.item4.tbd.tlv", rpaths: [])
            step("Link real TLV relocations against the lowered TextAPI provider")
            val linked = macho_hosted_link_with_providers([object], [], [provider], request)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                val image = linked.unwrap()
                if arm:
                    expect(item4_macho_tbd_read(image, 0x4004, 4)).to_equal(0x90000040)
                    expect(item4_macho_tbd_read(image, 0x4008, 4)).to_equal(0xf9400000)
                else:
                    expect(item4_macho_tbd_read(image, 0x4004, 4)).to_equal(0x7ff8)
                expect(item4_macho_tbd_read(image, 0xc000, 8)).to_equal(0)
    it "ITEM4-REQ-006 selects actual v4 and v5 targets and preserves literal version semantics":
        for variant in 0..4:
            val arm = variant % 2 == 1
            val v5 = variant >= 2
            val format = if v5: "v5" else: "v4"
            val target = MachOTbdTargetV1(arch: if arm: RelocArch.AArch64 else: RelocArch.X86_64, platform: 1)
            step("Read an independently validated TextAPI fixture")
            val bytes = file_read_bytes("test/fixtures/linker/macho/tbd_provider_multi_{format}.tbd")
            expect(bytes.len() > 32).to_equal(true)
            if bytes.len() <= 32: return
            val parsed = macho_read_tbd_v1(bytes, target, macho_tbd_default_limits_v1())
            expect(parsed.is_ok()).to_equal(true)
            if parsed.is_err(): return
            val document = parsed.unwrap()
            expect(document.format_version).to_equal(if v5: 5 else: 4)
            expect(document.main.selected).to_equal(true)
            expect(document.main.install_name).to_equal(Some("@rpath/libitem4.dylib"))
            expect(document.main.current_version).to_equal(0x020304)
            expect(document.main.compatibility_version).to_equal(0x010200)
            expect(document.main.minimum_os).to_equal(if v5: Some(if arm: 0xb0000 else: 0) else: nil)
            expect(document.main.symbols.len()).to_equal(2)
            step("Lower the selected leaf provider without inventing SDK or virtual addresses")
            val lowered = macho_tbd_main_provider_v1(document, target)
            expect(lowered.is_ok()).to_equal(true)
            if lowered.is_ok():
                expect(lowered.unwrap().install_name).to_equal("@rpath/libitem4.dylib")
                expect(lowered.unwrap().exports.len()).to_equal(2)
                expect(lowered.unwrap().sdk.is_none()).to_equal(true)

    it "ITEM4-REQ-006 retains target scoped ObjC weak TLV restrictions and inline reexport metadata":
        for variant in 0..4:
            val arm = variant % 2 == 1
            val format = if variant >= 2: "v5" else: "v4"
            val target = MachOTbdTargetV1(arch: if arm: RelocArch.AArch64 else: RelocArch.X86_64, platform: 1)
            step("Read an independently validated TextAPI fixture")
            val parsed = macho_read_tbd_v1(file_read_bytes("test/fixtures/linker/macho/tbd_metadata_{format}.tbd"), target, macho_tbd_default_limits_v1())
            expect(parsed.is_ok()).to_equal(true)
            if parsed.is_err(): return
            val document = parsed.unwrap()
            expect(document.main.allowable_clients).to_equal(["item4_client"])
            expect(document.main.parent_umbrella).to_equal(Some("Item4Framework"))
            expect(document.main.reexported_libraries).to_equal(["/usr/lib/libitem4_child.dylib"])
            expect(document.libraries.len()).to_equal(1)
            if document.libraries.len() == 1:
                expect(document.libraries[0].selected).to_equal(true)
                expect(document.libraries[0].install_name).to_equal(Some("/usr/lib/libitem4_child.dylib"))
                expect(document.libraries[0].symbols.len()).to_equal(1)
            var selected = false
            var wrong_target = false
            var weak = false
            var tls = false
            var objc = false
            var exception = false
            var ivar = false
            for symbol in document.main.symbols:
                if symbol.name == (if arm: "_arm64_only" else: "_x64_only"): selected = true
                if symbol.name == (if arm: "_x64_only" else: "_arm64_only"): wrong_target = true
                if symbol.name == "_weak": weak = symbol.weak_defined
                if symbol.name == "_tls": tls = symbol.thread_local
                if symbol.name == "Item4Class": objc = symbol.encoding == "objc_class"
                if symbol.name == "Item4Exception" and symbol.encoding == "objc_eh_type": exception = true
                if symbol.name == "Item4Class.field": ivar = symbol.encoding == "objc_ivar"
            expect(selected and not wrong_target).to_equal(true)
            expect(weak and tls and objc and exception and ivar).to_equal(true)
            step("Refuse unresolved transitive provider policy instead of flattening inline documents")
            val lowered = macho_tbd_main_provider_v1(document, target)
            expect(lowered.is_err()).to_equal(true)
            if lowered.is_err(): expect(lowered.unwrap_err()).to_contain("TBD")

    it "ITEM4-REQ-006 consumes both TextAPI formats through positional and named providers on both CPUs":
        for variant in 0..8:
            val arm = variant % 2 == 1
            val named = variant >= 4
            val version = if (variant / 2) % 2 == 0: "v4" else: "v5"
            val suffix = if arm: "a64" else: "x64"
            step("Plan an explicitly selected Mach-O link")
            val made = dir_create_all("build")
            expect(made).to_equal(true)
            if not made: return
            val created = secure_temp_dir("build", "item4-macho-tbd-")
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            val output = parent + "/app"
            val source = "test/fixtures/linker/macho/tbd_provider_multi_{version}.tbd"
            var config = item4_macho_tbd_config()
            var inputs = ["test/fixtures/linker/macho/hosted_start_{suffix}.o"]
            if named:
                val raw = file_read_bytes(source)
                expect(raw.len() > 32).to_equal(true)
                if raw.len() <= 32:
                    expect(dir_remove(parent)).to_equal(true)
                    return
                val written = file_write_bytes(parent + "/libitem4.tbd", raw)
                expect(written).to_equal(true)
                if not written:
                    expect(dir_remove(parent)).to_equal(true)
                    return
                config.libraries = ["item4"]
                config.library_paths = [parent]
            else:
                inputs.push(source)
            val plan = native_macho_plan_v1(if arm: "aarch64" else: "x86_64", config, output)
            expect(plan.is_ok()).to_equal(true)
            if plan.is_ok():
                step("Link real object and provider files")
                val linked = native_macho_link_files_v1(plan.unwrap(), inputs, [], output)
                expect(linked.is_ok()).to_equal(true)
                if linked.is_ok():
                    step("Inspect the published Mach-O commands and bytes")
                    val image = file_read_bytes(output)
                    expect(image.len() > 0xc010).to_equal(true)
                    if image.len() > 0xc010:
                        expect(item4_macho_tbd_read(image, 0, 4)).to_equal(0xfeedfacf)
                        expect(item4_macho_tbd_read(image, 4, 4)).to_equal(if arm: 0x0100000c else: 0x01000007)
                        expect(item4_macho_tbd_read(image, 12, 4)).to_equal(2)
                        expect(item4_macho_tbd_read(image, 0xc008, 8)).to_equal(0x100004000)
                        if arm:
                            expect(item4_macho_tbd_read(image, 0x4008, 4)).to_equal(0x14000ffe)
                            expect(item4_macho_tbd_read(image, 0x8008, 4)).to_equal(0xd61f0200)
                        else:
                            expect(item4_macho_tbd_read(image, 0x4002, 4)).to_equal(0x3ffa)
            step("Remove owned fixture files")
            if file_exists(output): expect(file_remove(output)).to_equal(true)
            if file_exists(parent + "/libitem4.tbd"): expect(file_remove(parent + "/libitem4.tbd")).to_equal(true)
            expect(dir_remove(parent)).to_equal(true)
