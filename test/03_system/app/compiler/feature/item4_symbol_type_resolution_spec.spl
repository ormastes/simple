"""ITEM4 RV64 TLS prerequisite: preserve the selected definition's type. UNRUN."""
use std.spec.*
use std.spec.step
use compiler.backend.linker.elf_inspect.{ElfHeader}
use compiler.backend.linker.elf_parser.{ElfSymbol, ElfObject, elf_make_empty_strtab}
use compiler.backend.linker.sym_resolver.{sym_entry_from_elf, sym_resolve_objects}

fn item4_riscv_ie_resolver_symbol(info: i64, section: i64, size: i64) -> ElfSymbol:
    ElfSymbol(st_name: 0, st_info: info, st_other: 0, st_shndx: section,
        st_value: 8, st_size: size, name: "selected")

fn item4_riscv_ie_resolver_object(symbol: ElfSymbol) -> ElfObject:
    ElfObject(header: ElfHeader(e_type: 1, e_machine: 243, e_entry: 0,
        e_phoff: 0, e_shoff: 0, e_shnum: 0, e_shstrndx: 0),
        sections: [], symbols: [symbol], relocations: [],
        strtab: elf_make_empty_strtab(), shstrtab: elf_make_empty_strtab(), raw: [])

describe "ITEM4 selected ELF definition type":
    it "preserves local and global TLS types without inferring them from binding":
        step("Convert actual ELF symbol type nibbles")
        expect(sym_entry_from_elf(item4_riscv_ie_resolver_symbol(6, 1, 8), 0).stype).to_equal(6)
        expect(sym_entry_from_elf(item4_riscv_ie_resolver_symbol(22, 1, 8), 1).stype).to_equal(6)
        expect(sym_entry_from_elf(item4_riscv_ie_resolver_symbol(17, 1, 8), 2).stype).to_equal(1)

    it "uses the strong definition type after replacing a weak definition":
        step("Resolve a weak ordinary object against a strong TLS definition")
        val weak = item4_riscv_ie_resolver_object(item4_riscv_ie_resolver_symbol(33, 1, 8))
        val strong = item4_riscv_ie_resolver_object(item4_riscv_ie_resolver_symbol(22, 1, 16))
        val result = sym_resolve_objects([weak, strong])
        expect(result.errors.len()).to_equal(0)
        expect(result.defined.has("selected")).to_equal(true)
        if not result.defined.has("selected"): return
        expect(result.defined["selected"].obj_idx).to_equal(1)
        expect(result.defined["selected"].stype).to_equal(6)
        step("Reverse object order without changing the winner")
        val reversed = sym_resolve_objects([strong, weak])
        expect(reversed.errors.len()).to_equal(0)
        expect(reversed.defined.has("selected")).to_equal(true)
        if not reversed.defined.has("selected"): return
        expect(reversed.defined["selected"].obj_idx).to_equal(0)
        expect(reversed.defined["selected"].stype).to_equal(6)

    it "retains object type when coalescing tentative definitions":
        step("Merge common storage while preserving its selected type")
        val first = item4_riscv_ie_resolver_object(item4_riscv_ie_resolver_symbol(17, 0xfff2, 8))
        val second = item4_riscv_ie_resolver_object(item4_riscv_ie_resolver_symbol(17, 0xfff2, 32))
        val result = sym_resolve_objects([first, second])
        expect(result.errors.len()).to_equal(0)
        expect(result.defined.has("selected")).to_equal(true)
        if not result.defined.has("selected"): return
        expect(result.defined["selected"].size).to_equal(32)
        expect(result.defined["selected"].stype).to_equal(1)
