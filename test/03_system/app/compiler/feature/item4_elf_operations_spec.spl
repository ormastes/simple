"""ITEM4-REQ-001/004/007 static operational ELF composition. UNRUN.

Real object inputs traverse the full linker. Custom callbacks delegate actual
production operations; independent wire assertions prove selected dispatch.
Static caller-trusted callbacks are not a sandbox or bounded-memory claim.
"""
use std.spec.*
use std.spec.step
use std.io_runtime.{file_read_bytes}
use compiler.backend.linker.elf.elf_operation_bindings.*
use compiler.backend.linker.elf.elf_static_link.{ElfLinkRequest, elf_link,
    elf_link_with_operations, ELF_LINK_STATIC_EXEC}
use compiler.backend.linker.elf.elf_exec_writer.{ElfOutSec, ElfExecPlan,
    elf_exec_plan, elf_write_image}
use compiler.backend.linker.elf_parser.{elf_parse_object, elf_section_name}
use compiler.backend.linker.reloc_engine.{RelocArch, reloc_apply, reloc_patch_bytes}

fn item4_elf_ops_fixture(name: text) -> [i64]:
    val raw = file_read_bytes("test/fixtures/linker/elf/" + name)
    expect(raw.len()).to_be_greater_than(64)
    var bytes: [i64] = []
    for byte in raw: bytes.push(byte as i64)
    bytes

fn item4_elf_ops_request() -> ElfLinkRequest:
    ElfLinkRequest(objects: [item4_elf_ops_fixture("abs_narrow_x64.o"),
        item4_elf_ops_fixture("abs_narrow_def_x64.o")], archives: [], shared: [],
        entry: "_start", target: RelocArch.X86_64, mode: ELF_LINK_STATIC_EXEC,
        interp: "", gc_sections: false)

fn item4_elf_ops_read(bytes: [i64], offset: i64, width: i64) -> i64:
    val valid = offset >= 0 and offset <= bytes.len() and width >= 1 and width <= 8 and width <= bytes.len() - offset
    expect(valid).to_equal(true)
    if not valid: return -1
    var value: i64 = 0
    for index in 0..width: value = value | (bytes[offset + index] << (index * 8))
    value

fn item4_elf_ops_check(image: [i64], word: i64, byte: i64):
    expect(item4_elf_ops_read(image, 0, 4)).to_equal(0x464c457f)
    expect(item4_elf_ops_read(image, 4, 1)).to_equal(2)
    expect(item4_elf_ops_read(image, 16, 2)).to_equal(2)
    expect(item4_elf_ops_read(image, 18, 2)).to_equal(62)
    val parsed = elf_parse_object(image)
    expect(parsed.is_ok()).to_equal(true)
    if parsed.is_err(): return
    val object = parsed.unwrap()
    var data_count = 0
    for index in 0..object.sections.len():
        if elf_section_name(object, index) == ".data":
            data_count = data_count + 1
            # Parsed sh_addr is the file offset, not virtual address.
            val offset = object.sections[index].sh_addr
            expect(object.sections[index].sh_size).to_equal(3)
            expect(item4_elf_ops_read(image, offset, 2)).to_equal(word)
            expect(item4_elf_ops_read(image, offset + 2, 1)).to_equal(byte)
    expect(data_count).to_equal(1)

fn item4_elf_ops_relocate(arch: RelocArch, bytes: [i64], offset: i64,
        rtype: i64, symbol: i64, addend: i64, place: i64) -> Result<[i64], text>:
    val checked = reloc_apply(arch, bytes, offset, rtype, symbol + 1, addend, place)
    if not checked.success: return Err(checked.error)
    Ok(reloc_patch_bytes(arch, bytes, offset, rtype, symbol + 1, addend, place))

fn item4_elf_ops_layout(secs: [ElfOutSec], base: i64, page: i64) -> Result<ElfExecPlan, text>:
    elf_exec_plan(secs, base + 4096, page)

fn item4_elf_ops_writer(kind: i64, machine: i64, entry: i64,
        plan: ElfExecPlan, contents: [[i64]]) -> Result<[i64], text>:
    var image = elf_write_image(kind, machine, entry, plan, contents)
    if image.len() < 64: return Err("item4 writer unexpectedly short")
    image[7] = 9
    Ok(image)

describe "Static ELF operational composition dispatch":
    it "preserves canonical wrapper bytes through the sealed default operations":
        step("Link real narrow-relocation objects through both canonical entrypoints")
        val request = item4_elf_ops_request()
        val legacy = elf_link(request)
        val operations = elf_builtin_operations_v1()
        expect(operations.is_ok()).to_equal(true)
        if operations.is_err(): return
        val linked = elf_link_with_operations(request, false, [], operations.unwrap())
        expect(legacy.is_ok()).to_equal(true)
        expect(linked.is_ok()).to_equal(true)
        if legacy.is_err() or linked.is_err(): return
        expect(linked.unwrap().image).to_equal(legacy.unwrap())
        item4_elf_ops_check(linked.unwrap().image, 0x1234, 0x7f)

    it "uses the selected relocation operation in actual emitted data bytes":
        step("Replace only the relocation callback with a checked production relocation using symbol plus one")
        var providers = elf_builtin_operation_providers_v1()
        expect(providers.len()).to_equal(3)
        if providers.len() != 3: return
        var provider = providers[0]
        provider.relocate = Some(item4_elf_ops_relocate)
        providers[0] = provider
        val sealed = elf_seal_operations_v1(providers, elf_operation_policy_v1())
        expect(sealed.is_ok()).to_equal(true)
        if sealed.is_err(): return
        val linked = elf_link_with_operations(item4_elf_ops_request(), false, [], sealed.unwrap())
        expect(linked.is_ok()).to_equal(true)
        if linked.is_err(): return
        item4_elf_ops_check(linked.unwrap().image, 0x1235, 0x80)

    it "uses the selected layout operation to move actual entry and load addresses":
        step("Delegate real layout with one additional page in the image base")
        var providers = elf_builtin_operation_providers_v1()
        expect(providers.len()).to_equal(3)
        if providers.len() != 3: return
        var provider = providers[1]
        provider.layout = Some(item4_elf_ops_layout)
        providers[1] = provider
        val sealed = elf_seal_operations_v1(providers, elf_operation_policy_v1())
        expect(sealed.is_ok()).to_equal(true)
        if sealed.is_err(): return
        val request = item4_elf_ops_request()
        val baseline = elf_link(request)
        val linked = elf_link_with_operations(request, false, [], sealed.unwrap())
        expect(baseline.is_ok()).to_equal(true)
        expect(linked.is_ok()).to_equal(true)
        if baseline.is_err() or linked.is_err(): return
        val image = linked.unwrap().image
        item4_elf_ops_check(image, 0x1234, 0x7f)
        expect(item4_elf_ops_read(image, 24, 8)).to_equal(item4_elf_ops_read(baseline.unwrap(), 24, 8) + 4096)

    it "uses the selected writer output without replacing it with the default image":
        step("Delegate real ELF writing and mark its OSABI byte")
        var providers = elf_builtin_operation_providers_v1()
        expect(providers.len()).to_equal(3)
        if providers.len() != 3: return
        var provider = providers[2]
        provider.write_image = Some(item4_elf_ops_writer)
        providers[2] = provider
        val sealed = elf_seal_operations_v1(providers, elf_operation_policy_v1())
        expect(sealed.is_ok()).to_equal(true)
        if sealed.is_err(): return
        val linked = elf_link_with_operations(item4_elf_ops_request(), false, [], sealed.unwrap())
        expect(linked.is_ok()).to_equal(true)
        if linked.is_err(): return
        item4_elf_ops_check(linked.unwrap().image, 0x1234, 0x7f)
        expect(item4_elf_ops_read(linked.unwrap().image, 7, 1)).to_equal(9)
