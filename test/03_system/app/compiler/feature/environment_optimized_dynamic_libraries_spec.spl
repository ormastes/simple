# codex-system-test
"""
## Purpose and audience
Environment-Optimized Dynamic Libraries is an operator-facing system-test
scaffold for compiler, loader, frontend, GPU, and verification owners. It
defines the evidence flow for the selected catalog/binding pilot.

## Operator workflow
Run `bin/simple test test/03_system/app/compiler/feature/environment_optimized_dynamic_libraries_spec.spl`
after the seven production helpers exist. The current run must fail closed.

## Compatibility and limitations
The Stage-1 V1 value contracts, bounded catalog envelope, and admission policy
now have focused unit evidence. The production catalog loader, binding owner,
frontend adapter, native/SMF/JIT execution, GPU execution, parser parity, and
performance evidence are not yet implemented by this system scaffold.

## Verification guidance and troubleshooting
Every helper and scenario currently calls `fail(...)`. A green result before
the implementation replaces those calls is invalid evidence.

Fail-fast integration scaffold for Feature A + NFR N2 with selected target
registry B and inspector input 1.
The scenarios define the operator flow and requirement traceability, but the
production catalog, binding, and execution owners are still being implemented.
No scenario in this file is executable evidence until its production helper
replaces the explicit fail(...).
"""
# @manual_section: primary

use std.spec.*

# These are the frozen system-test helper names.  Their signatures are kept
# intentionally small until the V1 contracts are available to the test lane.
# Each helper must remain fail-fast while its production owner is absent.
fn setup_environment_catalog() -> text:
    fail("environment optimized provider helper not implemented: setup_environment_catalog")

fn step_admit_variant(catalog: text) -> text:
    fail("environment optimized provider helper not implemented: step_admit_variant")

fn step_bind_provider(admitted: text) -> text:
    fail("environment optimized provider helper not implemented: step_bind_provider")

fn check_execution_receipt(bound: text):
    fail("environment optimized provider helper not implemented: check_execution_receipt")

fn setup_canonical_target_registry(case_name: text) -> text:
    fail("environment optimized provider helper not implemented: setup_canonical_target_registry")

fn step_start_atomic_inspector(case_name: text, input: [u8]) -> text:
    fail("environment optimized provider helper not implemented: step_start_atomic_inspector")

fn check_atomic_inspector_terminal(terminal: text, expected_count: i64):
    fail("environment optimized provider helper not implemented: check_atomic_inspector_terminal")

describe "Environment-Optimized Dynamic Libraries":

    describe "Selected feature requirements":

        it "should keep a baseline-safe core and select a sibling artifact without an executable ISA matrix":
            # @req REQ-001
            step("Inspect the bounded environment catalog and baseline-safe core")
            val catalog = setup_environment_catalog()
            step("Admit a compatible sibling artifact for the current environment")
            val admitted = step_admit_variant(catalog)
            step("Bind the selected provider for a new session")
            val bound = step_bind_provider(admitted)
            step("Verify the receipt distinguishes the selected sibling from the baseline")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-001 production catalog and execution oracle")

        it "should separate environment facts from generated-code target intent":
            # @req REQ-002
            step("Inspect the sealed EnvironmentSnapshotV1 fields")
            val catalog = setup_environment_catalog()
            step("Apply exact architecture, ABI, OS, policy, and vector-state admission")
            val admitted = step_admit_variant(catalog)
            step("Bind the environment-qualified provider")
            val bound = step_bind_provider(admitted)
            step("Verify environment and target identities are reported independently")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-002 EnvironmentSnapshotV1 oracle")

        it "should bind a complete descriptor and dependency closure before publication":
            # @req REQ-003
            step("Load a digest-addressed VariantDescriptorV1 candidate")
            val catalog = setup_environment_catalog()
            step("Admit its ABI, semantic, placement, resource, and dependency predicates")
            val admitted = step_admit_variant(catalog)
            step("Publish a provider only after the dependency closure is pinned")
            val bound = step_bind_provider(admitted)
            step("Verify the receipt carries the descriptor and closure identities")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-003 VariantDescriptorV1 oracle")

        it "should reject an incompatible or untrusted candidate before executable mapping":
            # @req REQ-004
            step("Load a candidate with an incompatible or untrusted predicate")
            val catalog = setup_environment_catalog()
            step("Apply trust, ABI, dependency, OS, and device admission before ranking")
            val admitted = step_admit_variant(catalog)
            step("Keep rejected native metadata unmapped and uncallable")
            val bound = step_bind_provider(admitted)
            step("Verify the rejection phase and stable reason code in the receipt")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-004 pre-map rejection oracle")

        it "should distinguish prefer, require, and max without manufacturing capability":
            # @req REQ-005
            step("Create a catalog containing preferred, required, and over-limit candidates")
            val catalog = setup_environment_catalog()
            step("Apply the requested policy only within admitted capabilities")
            val admitted = step_admit_variant(catalog)
            step("Bind the selected result or fail explicitly for an unsatisfied require")
            val bound = step_bind_provider(admitted)
            step("Verify fallback and required-failure receipts are not silent")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-005 policy semantics oracle")

        it "should publish a deterministic immutable generation-pinned binding plan":
            # @req REQ-006
            step("Build a bounded catalog with a locked dependency closure")
            val catalog = setup_environment_catalog()
            step("Admit candidates and collect bounded rejection reasons")
            val admitted = step_admit_variant(catalog)
            step("Publish and pin one dense BindingPlanV1 generation")
            val bound = step_bind_provider(admitted)
            step("Verify identical inputs produce the same plan and binding digest")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-006 BindingPlanV1 determinism oracle")

        it "should report metadata, mapping, callability, execution, completion, and retirement as distinct states":
            # @req REQ-007
            step("Admit the same logical provider through the supported placement adapters")
            val catalog = setup_environment_catalog()
            step("Validate metadata and publish a generation-scoped provider")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify each lifecycle state is represented separately in the receipt")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-007 placement lifecycle oracle")

        it "should expose a coarse frontend facet while retaining the independent legacy reference path":
            # @req REQ-008
            step("Create a parser session through the coarse FrontendFacetV1 boundary")
            val catalog = setup_environment_catalog()
            step("Admit the legacy adapter without exposing private AST or HIR layouts")
            val admitted = step_admit_variant(catalog)
            step("Bind the session generation and execute its batch contract")
            val bound = step_bind_provider(admitted)
            step("Verify the legacy reference path remains independently observable")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-008 FrontendFacetV1 oracle")

        it "should qualify the scalar parser before permitting a SIMD parser promotion":
            # @req REQ-009
            step("Admit the canonical scalar parser and its declared dialect coverage")
            val catalog = setup_environment_catalog()
            step("Reject an incomplete dialect or unqualified SIMD parser promotion")
            val admitted = step_admit_variant(catalog)
            step("Bind only a parser provider with canonical scalar parity evidence")
            val bound = step_bind_provider(admitted)
            step("Verify promotion state and parity evidence in the execution receipt")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-009 parser promotion oracle")

        it "should report requested, accepted, declared, emitted, selected, and executed target features separately":
            # @req REQ-010
            step("Create a target-codegen request independent of the host parser environment")
            val catalog = setup_environment_catalog()
            step("Admit only a backend-accepted artifact with matching declarations")
            val admitted = step_admit_variant(catalog)
            step("Bind the artifact and its exact target identity")
            val bound = step_bind_provider(admitted)
            step("Verify emitted and executed implementation facts are not inferred from labels")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-010 target-feature evidence oracle")

        it "should keep GPU providers as placement siblings with actual submission and retirement evidence":
            # @req REQ-011
            step("Inspect the existing GPU registry through its adapter boundary")
            val catalog = setup_environment_catalog()
            step("Admit enabled features, program, resources, fence, and retirement predicates")
            val admitted = step_admit_variant(catalog)
            step("Bind a GPU placement sibling without treating it as a SIMD tier")
            val bound = step_bind_provider(admitted)
            step("Verify submission, completion, and retirement are correlated")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-011 GPU placement oracle")

        it "should cut over new sessions and retain old generations until all pins drain":
            # @req REQ-012
            step("Bind the active provider generation for an initial session")
            val catalog = setup_environment_catalog()
            step("Admit and publish a replacement generation for new sessions")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify old CPU, callback, JIT, GPU, buffer, and completion pins drain before retirement")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-012 generation-drain oracle")

        it "should keep CPU-only help, version, and reference compilation free of optional GPU initialization":
            # @req REQ-013
            step("Start a CPU-only command through the production startup path")
            val catalog = setup_environment_catalog()
            step("Admit only baseline-safe providers without compiling a missing optimization")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify startup and GPU initialization receipts remain separate")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-013 startup-isolation oracle")

        it "should explain every selection, rejection, fallback, binding, execution, completion, quarantine, and rollback":
            # @req REQ-014
            step("Build a catalog containing selected, rejected, fallback, and quarantined candidates")
            val catalog = setup_environment_catalog()
            step("Admit candidates and bind the exact environment and artifact generations")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify every lifecycle outcome has a stable explainable receipt")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: REQ-014 explain-receipt oracle")

    describe "REQ-015: canonical target registry B":

        it "should normalize registered aliases to one versioned target identity":
            # @req REQ-015
            step("Install canonical and alias entries in the bounded target registry")
            val registry = setup_canonical_target_registry("registered_alias")
            step("Resolve both spellings through the repository-owned registry")
            val admitted = step_admit_variant(registry)
            step("Verify tuple, numeric IDs, registry version, and mapping digest agree")
            check_execution_receipt(admitted)
            fail("NOT IMPLEMENTED: REQ-015 registered-alias oracle")

        it "should change downstream identity when the registry version or mapping changes":
            # @req REQ-015
            step("Install two valid registry generations for the same canonical triple")
            val registry = setup_canonical_target_registry("changed_version")
            step("Resolve target profiles and cache plans under both generations")
            val admitted = step_admit_variant(registry)
            step("Verify mapping, profile, cache, plan, and receipt identities do not collide")
            check_execution_receipt(admitted)
            fail("NOT IMPLEMENTED: REQ-015 registry-version invalidation oracle")

        it "should reject unknown, ambiguous, or cross-format target triples":
            # @req REQ-015
            step("Install conflicting alias, unknown OS, and ABI/object-format mismatch fixtures")
            val registry = setup_canonical_target_registry("invalid_mapping")
            step("Attempt target resolution without consulting host identity")
            val admitted = step_admit_variant(registry)
            step("Verify every invalid row fails closed before cache or publication authority")
            check_execution_receipt(admitted)
            fail("NOT IMPLEMENTED: REQ-015 fail-closed mapping oracle")

    describe "REQ-016: atomic immutable inspector input 1":

        it "should bind one exact immutable input to the reaped inspector terminal receipt":
            # @req REQ-016
            step("Prepare one bounded immutable compiler artifact")
            val terminal = step_start_atomic_inspector("exact_input", [1u8, 2u8, 3u8, 4u8])
            step("Drain stdout and stderr while writing and closing stdin exactly once")
            step("Verify digest, count, tool identity, process generation, status, and reap")
            check_atomic_inspector_terminal(terminal, 4)
            fail("NOT IMPLEMENTED: REQ-016 exact atomic-input oracle")

        it "should complete empty and maximum-sized bounded inputs without deadlock":
            # @req REQ-016
            step("Start the owned inspector at both accepted input boundaries")
            val terminal = step_start_atomic_inspector("boundary_inputs", [])
            step("Apply bounded concurrent stdin, stdout, and stderr progress")
            step("Verify terminal evidence is issued only after close and reap")
            check_atomic_inspector_terminal(terminal, 0)
            fail("NOT IMPLEMENTED: REQ-016 bounded-progress oracle")

        it "should reject overflow, partial write, digest mismatch, or unreaped process":
            # @req REQ-016
            step("Inject each atomic-input and process-lifecycle failure independently")
            val terminal = step_start_atomic_inspector("invalid_terminal", [255u8])
            step("Prevent partial or mismatched input from authorizing inspection")
            step("Verify no terminal authority token exists before exact close and reap")
            check_atomic_inspector_terminal(terminal, 1)
            fail("NOT IMPLEMENTED: REQ-016 fail-closed terminal oracle")

    describe "Selected non-functional requirements":

        it "should fail closed for wrong-ISA, premature-publication, fallback, and retirement safety violations":
            # @req NFR-001
            step("Admit the supported fixture matrix with safety guards enabled")
            val catalog = setup_environment_catalog()
            step("Bind only candidates that pass admission and lifecycle checks")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify the safety receipt has no wrong-ISA or use-after-retire row")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-001 safety matrix oracle")

        it "should measure warm and cold selection latency against the balanced target":
            # @req NFR-002
            step("Load the named reference catalog fixture")
            val catalog = setup_environment_catalog()
            step("Admit candidates and record cold and warm selection samples")
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify p95 selection latency and retained sample identity")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-002 selection-latency oracle")

        it "should keep dense generation-pinned dispatch within the stated overhead envelope":
            # @req NFR-003
            step("Bind a dense provider batch beside its direct reference batch")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Execute representative batches without catalog or lifecycle work in the hot path")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-003 dispatch-overhead oracle")

        it "should require a measured provider speedup before promotion":
            # @req NFR-004
            step("Admit a declared parser/provider workload on a qualified machine")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify the retained benchmark meets the promotion threshold")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-004 performance-promotion oracle")

        it "should enforce the selected provider and catalog resident-memory budgets":
            # @req NFR-005
            step("Capture baseline and selected-provider max RSS on the named fixture")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify the memory receipt distinguishes selected and unselected cases")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-005 memory-budget oracle")

        it "should retain the complete workload and tail-boundary measurement matrix":
            # @req NFR-006
            step("Admit tiny, medium, large, Unicode-heavy, malformed, and tail-boundary fixtures")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify p50, p95, p99, RSS, identity, generation, and digest for each row")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-006 coverage-matrix oracle")

        it "should reject bounded-capacity overflow explicitly":
            # @req NFR-007
            step("Fill the catalog and lifecycle capacities to their configured bounds")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify overflow reports a typed rejection rather than truncating state")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-007 capacity oracle")

        it "should select the same variant and binding digest for identical valid inputs":
            # @req NFR-008
            step("Prepare identical environment, catalog, policy, request, lock, and calibration inputs")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify repeated selection produces identical identities and binding digest")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-008 determinism oracle")

        it "should keep optional GPU services uninitialized during CPU-only startup":
            # @req NFR-009
            step("Measure CPU-only cold and warm startup with mapped text recorded")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify no GPU initialization occurs in the CPU-only receipt")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-009 startup-isolation oracle")

        it "should keep unsupported host and device rows explicit and non-promoting":
            # @req NFR-010
            step("Enumerate unavailable host and device rows in the evidence matrix")
            val catalog = setup_environment_catalog()
            val admitted = step_admit_variant(catalog)
            val bound = step_bind_provider(admitted)
            step("Verify unsupported rows retain blocked or unsupported status with a resume plan")
            check_execution_receipt(bound)
            fail("NOT IMPLEMENTED: NFR-010 unsupported-row oracle")

        it "should keep canonical target lookup bounded and outside provider hot paths":
            # @req NFR-011
            step("Construct the bounded canonical registry once")
            val registry = setup_canonical_target_registry("lookup_overhead")
            step("Measure repeated canonical and alias lookup without reconstruction or network work")
            val admitted = step_admit_variant(registry)
            step("Verify allocation and hot-path counters remain within the selected limits")
            check_execution_receipt(admitted)
            fail("NOT IMPLEMENTED: NFR-011 registry-overhead oracle")

        it "should make bounded three-pipe progress and leak no failed process lease":
            # @req NFR-012
            step("Start an atomic inspector fixture that saturates stdin, stdout, and stderr")
            val terminal = step_start_atomic_inspector("three_pipe_progress", [1u8, 2u8])
            step("Inject short write, cancellation, timeout, early exit, and reap failure independently")
            step("Verify every failure is non-authoritative and every process lease retires")
            check_atomic_inspector_terminal(terminal, 2)
            fail("NOT IMPLEMENTED: NFR-012 inspector-progress oracle")
