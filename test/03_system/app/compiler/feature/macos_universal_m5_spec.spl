# @req MBH-REQ-001 MBH-REQ-007 MBH-REQ-008 MBH-REQ-009 MBH-NFR-004 MBH-NFR-005
use std.spec.*
use std.io.{file_read}
use std.io_runtime.{process_run}

describe "macOS reverse-reference M5 universal packaging and promotion":
    it "keeps portable qualification hermetic and distinct from native release proof":
        step("run M5 from a digest-bound immutable snapshot; leave native signing and promotion blocked")
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-macos-universal-m5-hermetic.shs"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("M5 hermetic portable qualification PASS")

    it "retains exact provenance and requires post-sign native CAS authority":
        step("inspect the release contract without claiming unavailable native execution")
        val release = file_read("scripts/release/macos-universal-m5.shs") ?? ""
        val workflow = file_read(".github/workflows/macos-reverse-reference-m5.yml") ?? ""
        expect(release).to_contain("validate_canonical_policy_receipt")
        expect(release).to_contain("SIMPLE_BINARY=\"$candidate_binary\"")
        expect(release).to_contain("macos-m5-post-sign-native-verification-v1")
        expect(release).to_contain("schema=macos-m5-promotion-v1")
        expect(release).to_contain("schema=macos-m5-rollback-v1")
        expect(workflow).to_contain("verify-signed-arm64")
        expect(workflow).to_contain("verify-signed-x86_64")
