# @req MBH-REQ-007 MBH-NFR-004
use std.spec.*
use std.io_runtime.{process_run}

describe "M5 hermetic portable qualification":
    it "executes the focused M5 checker only from an immutable snapshot":
        step("self-snapshot the driver, bind the exact three-file closure, and retain drift evidence")
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-macos-universal-m5-hermetic.shs"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("M5 hermetic portable qualification PASS")
