use std.spec

describe "all regions language strategy":
    # @manual scenario evidence
    it "captures schema and music domain blocks at module scope":
        # @req REQ-SSPEC-SYSTEM
        # @req REQ-001
        step("Verify: schema{} and music{} parse into captured domain blocks")
        val source = "schema {\n  version: 1\n}\n\nmusic {\n  tempo: 120\n}\n"
        val parsed = parse_full_frontend(source, "regions_mod", "regions_mod", Logger(level: 0))
        expect(parsed.domain_blocks.len()).to_equal(2)  # oracle: both blocks captured
        expect(parsed.domain_blocks[0].kind).to_equal("schema")  # oracle: kind preserved
        expect(parsed.domain_blocks[1].kind).to_equal("music")  # oracle: kind preserved
        expect(parsed.domain_blocks[0].payload.contains("version")).to_equal(true)  # oracle: raw payload retained

    describe "REQ-003: priority order":
        it "starts with schema and style/ui":
            val first = "schema"
            val second = "style/ui"
            expect(first).to_equal("schema")
            expect(second).to_equal("style/ui")

    describe "REQ-004: interchange anchors":
        it "names standards for heavy domains":
            val anchors = "MusicXML IFC bSDD gbXML CityGML STEP AP242 VHDL SystemVerilog"
            expect(anchors).to_contain("MusicXML")
            expect(anchors).to_contain("STEP AP242")
