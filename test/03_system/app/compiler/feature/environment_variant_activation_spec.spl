# codex-system-test
# E5-003/E5-004 acceptance: final gates, manuals, and canonical gap tracking.
# These checks intentionally remain unadmitted until the owner/runtime/reviewer
# receipt chain is available. They must not be converted into opt-in skips.
# @evidence-class integration

use std.spec.{describe, it, step, fail}

fn require_compiler_lib_mcp_lsp_gates():
    fail("MissingEvidence:E5-003:qualified compiler/lib/MCP/LSP/native gate receipts; resume with the admitted self-hosted runner")

fn require_zero_stub_manuals():
    fail("MissingEvidence:E5-003:zero-stub generated-manual review receipt; source/manual hashes are required")

fn require_startup_measurement_receipt():
    fail("MissingEvidence:E5-003:startup counters/warm latency/RSS receipt; no timing claim from an unqualified runner")

fn require_gap_row_authority():
    fail("MissingEvidence:E5-004:canonical feature/TODO row allocator and reviewer receipt; no fabricated tracking rows")

describe "E5-003 integrated verification evidence [importance=high; importance_weight=2]":
    it "E5-003 should pass required compiler library MCP and LSP gates together [importance=high; importance_weight=2]":
        # @req REQ-014
        step("Run the required compiler, library, MCP, and LSP gates")
        require_compiler_lib_mcp_lsp_gates()

    it "E5-003 should reject a stale or stubbed generated manual [importance=high; importance_weight=2]":
        # @req REQ-014
        step("Regenerate each manual and inspect its zero-stub receipt")
        require_zero_stub_manuals()

    it "E5-003 should retain startup counters and warm performance evidence [importance=high; importance_weight=2]":
        # @req REQ-013
        # @req REQ-014
        step("Capture startup probes, warm latency, RSS, and branch evidence")
        require_startup_measurement_receipt()

describe "E5-004 canonical gap tracking [importance=high; importance_weight=2]":
    it "E5-004 should record every excluded architecture and device gap exactly once [importance=high; importance_weight=2]":
        # @req REQ-002
        # @req REQ-011
        step("Allocate canonical feature and TODO rows for ARM, RISC-V, GPU, and x86-v4 gaps")
        require_gap_row_authority()

    it "E5-004 should link existing open work without duplicate tracking IDs [importance=high; importance_weight=2]":
        # @req REQ-014
        step("Reconcile existing x86, GPU, Vulkan, and backend TODO identities")
        require_gap_row_authority()

    it "E5-004 should keep unqualified gaps pending rather than claiming completion [importance=high; importance_weight=2]":
        # @req REQ-014
        step("Review pending state, evidence class, owner, and resume condition")
        require_gap_row_authority()
