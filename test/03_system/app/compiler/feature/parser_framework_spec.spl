# codex-system-test
# @tag: system, compiler, structural_compute, parse

"""
## Purpose and audience
Purpose: keeps scalar oracle determinism across repeated CPU-reference parses
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-APP-ParsFram-001

use std.spec
use std.common.structural.parse.*
use std.nogc_async_mut.structural.parse.runtime.{
    ParseRuntime,
    parse_request as runtime_parse_request,
    parse_result_fingerprint,
    parse_results_equal,
    parse_runtime,
    parse_runtime_with_mode
}

val D_NUMBER: i64 = 1
val D_SPACE: i64 = 2
val D_IDENT: i64 = 3

fn framework_byte_class() -> [u8]:
    var out: [u8] = []
    var b = 0
    while b < 256:
        var cls = 0
        if b >= 48 and b <= 57:
            cls = 1
        elif b == 32:
            cls = 2
        elif (b >= 97 and b <= 122) or (b >= 65 and b <= 90):
            cls = 3
        out = out.push(cls as u8)
        b = b + 1
    out

fn framework_transitions() -> [u32]:
    val no = PARSE_NO_ID
    [no, 1u32, 2u32, 3u32,
     no, 1u32, no, no,
     no, no, 2u32, no,
     no, 3u32, no, 3u32]

fn framework_dialect() -> ParseDialect:
    val program = parse_lex_program(
        7u32,
        4,
        4,
        0u32,
        framework_byte_class(),
        framework_transitions(),
        [0u16, D_NUMBER as u16, D_SPACE as u16, D_IDENT as u16],
        [PARSE_STATE_FLAG_NONE, PARSE_STATE_FLAG_NONE, PARSE_STATE_FLAG_SKIP, PARSE_STATE_FLAG_NONE]
    )
    parse_dialect_lexical(11u32, program)

fn framework_request(source: text, mode: text) -> ParseRequest:
    parse_request(
        parse_source_blob_from_text(source),
        0u32,
        PARSE_OUTPUT_TOKENS | PARSE_OUTPUT_DIAGNOSTICS,
        PARSE_TAG_DEMAND_OFF,
        mode,
        parse_capacity_manifest(4096, 256, 64)
    )

fn framework_runtime(mode: text) -> ParseRuntime:
    match parse_runtime(framework_dialect()):
        Ok(rt) -> rt
        Err(reason) -> {
            assert_true(reason == "")
            parse_runtime_with_mode(framework_dialect(), mode)
        }

use std.spec.step
describe "parser framework baseline":
    it "keeps scalar oracle determinism across repeated CPU-reference parses":
        step("Verify: keeps scalar oracle determinism across repeated CPU-reference parses")
        # @req: REQ-APP-ParsFram-001
        val dialect = framework_dialect()
        val first = parse_run(dialect, framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE))
        val second = parse_run(dialect, framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE))

        expect(first.receipt.deterministic_hash).to_equal(second.receipt.deterministic_hash)
        expect(first.receipt.item_count_out).to_equal(second.receipt.item_count_out)
        expect(second.receipt.fallback_count).to_equal(0)  # oracle: value fixed by the spec contract

    it "demotes unimplemented accelerated mode and keeps deterministic equality to CPU oracle":
        step("Verify: demotes unimplemented accelerated mode and keeps deterministic equality to CPU oracle")
        # @req: REQ-APP-ParsFram-001
        val dialect = framework_dialect()
        val base = parse_run(dialect, framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE))
        val accelerated = parse_run(dialect, framework_request("ab 12 cd", PARSE_MODE_HYBRID_VECTOR_GPU))

        expect(accelerated.receipt.candidate_backend).to_equal(PARSE_MODE_HYBRID_VECTOR_GPU)
        expect(accelerated.receipt.backend).to_equal(PARSE_BACKEND_CPU_REFERENCE)
        expect(accelerated.receipt.fallback_count).to_equal(1)  # oracle: value fixed by the spec contract
        expect(accelerated.receipt.deterministic_hash).to_equal(base.receipt.deterministic_hash)

    it "routes through parse_runtime as a Result-typed execution entrypoint":
        step("Verify: routes through parse_runtime as a Result-typed execution entrypoint")
        # @req: REQ-APP-ParsFram-001
        val runtime = framework_runtime(PARSE_MODE_CPU_REFERENCE)
        val base = parse_run(
            framework_dialect(),
            framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE))
        val wrapped = match runtime_parse_request(runtime, framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE)):
            Ok(value) -> value
            Err(reason) -> {
                assert_true(reason == "")
                parse_run(framework_dialect(), framework_request("ab 12 cd", PARSE_MODE_CPU_REFERENCE))
            }

        expect(parse_results_equal(wrapped, base)).to_equal(true)
        expect(parse_result_fingerprint(wrapped)).to_equal(parse_result_fingerprint(base))

    it "surface missing and unknown parse mode as explicit runtime errors":
        step("Verify: surface missing and unknown parse mode as explicit runtime errors")
        # @req: REQ-APP-ParsFram-001
        val runtime = framework_runtime(PARSE_MODE_CPU_REFERENCE)
        val missing_mode = match runtime_parse_request(runtime, framework_request("ab", "")):
            Ok(value) -> {
                assert_false(value.ok)
                "missing_mode_expected_err"
            }
            Err(reason) -> reason
        val unknown_mode = match runtime_parse_request(runtime, framework_request("ab", "wave-6-mirage")):
            Ok(value) -> {
                assert_false(value.ok)
                "unknown_mode_expected_err"
            }
            Err(reason) -> reason

        expect(missing_mode).to_equal("parse_request_missing_mode")
        expect(unknown_mode).to_equal("parse_request_unknown_mode: wave-6-mirage:" + PARSE_REJECT_UNKNOWN_MODE)

    it "honors output masking without changing source-order token metadata":
        step("Verify: honors output masking without changing source-order token metadata")
        # @req: REQ-APP-ParsFram-001
        val dialect = framework_dialect()
        val request = parse_request(
            parse_source_blob_from_text("ab 12 cd"),
            0u32,
            PARSE_OUTPUT_DIAGNOSTICS,
            PARSE_TAG_DEMAND_OFF,
            PARSE_MODE_CPU_REFERENCE,
            parse_capacity_manifest(4096, 256, 64))
        val result = parse_run(dialect, request)

        expect(result.ok).to_equal(true)
        expect(parse_token_arena_len(result.tokens)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(parse_diagnostic_arena_len(result.diagnostics)).to_equal(0)  # oracle: value fixed by the spec contract
        expect(result.receipt.item_count_in).to_equal(5)  # oracle: value fixed by the spec contract
        expect(result.receipt.item_count_out).to_equal(0)  # oracle: value fixed by the spec contract

    it "keeps tags off unless demand is enabled":
        step("Verify: keeps tags off unless demand is enabled")
        # @req: REQ-APP-ParsFram-001
        val no_tags = parse_sink_emit_tag(parse_action_sink_new(PARSE_TAG_DEMAND_OFF), 5u32)
        val all_tags = parse_sink_emit_tag(parse_action_sink_new(PARSE_TAG_DEMAND_ALL), 5u32)

        expect(no_tags.tags_emitted).to_equal(0)  # oracle: value fixed by the spec contract
        expect(all_tags.tags_emitted).to_equal(1)  # oracle: value fixed by the spec contract

    it "fails closed for malformed lex programs":
        step("Verify: fails closed for malformed lex programs")
        # @req: REQ-APP-ParsFram-001
        val bad = parse_lex_program(
            7u32,
            4,
            4,
            0u32,
            framework_byte_class(),
            [0u32, 1u32],
            [0u16, 1u16, 2u16, 3u16],
            [0u16, 0u16, 0u16, 0u16]
        )
        val dialect = parse_dialect_lexical(11u32, bad)
        val result = parse_run(dialect, framework_request("ab", PARSE_MODE_CPU_REFERENCE))

        expect(result.receipt.fallback_reason).to_equal("parse_lex_program_malformed")
        assert_false(result.ok)
