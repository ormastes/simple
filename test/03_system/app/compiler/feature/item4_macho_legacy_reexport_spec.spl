"""ITEM4-REQ-006 real legacy reexport selectors. Simple execution UNRUN."""
use std.spec.*
use std.spec.step
use std.io_runtime.{dir_create_all, file_read_bytes, file_exists, dir_exists}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_write_bytes, file_remove}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use compiler.backend.linker.native_config.{NativeLinkConfig}
use compiler.backend.linker.macho.native_adapter.{native_macho_plan_v1, native_macho_link_files_v1}
use compiler.backend.linker.reloc_engine.{RelocArch}
use compiler.backend.linker.macho.binary_provider.{macho_read_binary_provider_v1}
use compiler.backend.linker.macho.hosted_link.{MachOHostedRequest, macho_hosted_link, macho_hosted_link_with_providers}
fn item4_macho_legacy_read(bytes: [u8], at: i64, width: i64 = 4) -> i64:
    val valid = width >= 1 and width <= 8 and at >= 0 and at <= bytes.len() and width <= bytes.len() - at
    expect(valid).to_equal(true)
    if not valid: return 0
    var value: i64 = 0
    for index in 0..width: value = value | ((bytes[at + index] as i64) << (8 * index))
    value

fn item4_macho_legacy_check(image: [u8], arm: bool):
    expect(image.len() >= 0xc010).to_equal(true)
    if image.len() < 0xc010: return
    expect(item4_macho_legacy_read(image, 0)).to_equal(0xfeedfacf)
    expect(item4_macho_legacy_read(image, 4)).to_equal(if arm: 0x0100000c else: 0x01000007)
    expect(item4_macho_legacy_read(image, 12)).to_equal(2)
    expect(item4_macho_legacy_read(image, 0xc008, 8)).to_equal(0x100004000)
    val size = item4_macho_legacy_read(image, 20)
    val count = item4_macho_legacy_read(image, 16)
    val valid = size <= image.len() - 32 and count <= size / 8
    expect(valid).to_equal(true)
    if not valid: return
    var at: i64 = 32
    var loads: i64 = 0
    var bindings: i64 = 0
    for index in 0..count:
        if at > 32 + size - 8:
            expect(false).to_equal(true)
            return
        val kind = item4_macho_legacy_read(image, at)
        val length = item4_macho_legacy_read(image, at + 4)
        if length < 8 or length > 32 + size - at:
            expect(false).to_equal(true)
            return
        if kind == 0xc:
            loads = loads + 1
            expect(length >= 24).to_equal(true)
            if length < 24: return
            val name = "/usr/lib/liblegacy_root.dylib"
            val start = item4_macho_legacy_read(image, at + 8)
            val bounds = start >= 24 and start <= length and name.len() < length - start
            expect(bounds).to_equal(true)
            if not bounds: return
            for byte in 0..name.len(): expect(image[at + start + byte]).to_equal(name.byte_at(byte) as u8)
            expect(image[at + start + name.len()]).to_equal(0u8)
        if kind == 0x80000022:
            bindings = bindings + 1
            expect(length >= 48).to_equal(true)
            if length < 48: return
            val start = item4_macho_legacy_read(image, at + 16)
            val bytes = item4_macho_legacy_read(image, at + 20)
            val prefix: [u8] = [0x20, 1, 0x40, 95, 104, 101, 108, 112, 101, 114, 0]
            val bounds = start >= 0 and start <= image.len() and bytes <= image.len() - start and bytes >= prefix.len()
            expect(bounds).to_equal(true)
            if not bounds: return
            for byte in 0..prefix.len(): expect(image[start + byte]).to_equal(prefix[byte])
        at = at + length
    expect(loads).to_equal(1)
    expect(bindings).to_equal(1)

fn item4_macho_legacy_cleanup(parent: text):
    for name in ["app", "liblegacy.1.dylib", "liblegacy_x.dylib", "Leaf", "OldRoot", "Wrong"]:
        if file_exists(parent + "/" + name): expect(file_remove(parent + "/" + name)).to_equal(true)
    expect(dir_remove(parent)).to_equal(true)

fn item4_macho_legacy_link(parent: text, path: text, arm: bool) -> Result<text, text>:
    var config = NativeLinkConfig.default()
    config.runtime_path = "none"
    config.allow_cc_fallback = false
    config.library_paths = [parent]
    config.extra_flags = ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "item4.legacy"]
    val output = parent + "/app"
    val plan = native_macho_plan_v1(if arm: "aarch64" else: "x86_64", config, output)?
    val suffix = if arm: "a64" else: "x64"
    native_macho_link_files_v1(plan, ["test/fixtures/linker/macho/hosted_start_{suffix}.o", path], [], output)

fn item4_macho_legacy_command(bytes: [u8], wanted: i64) -> i64:
    if bytes.len() < 32:
        expect(false).to_equal(true)
        return -1
    var at: i64 = 32
    for index in 0..item4_macho_legacy_read(bytes, 16):
        val length = item4_macho_legacy_read(bytes, at + 4)
        if length < 8 or at > bytes.len() - length:
            expect(false).to_equal(true)
            return -1
        if item4_macho_legacy_read(bytes, at) == wanted: return at
        at = at + length
    expect(false).to_equal(true)
    -1

fn item4_macho_legacy_name(bytes: [u8], command: i64, name: text) -> [u8]:
    if command < 0: return bytes
    val length = item4_macho_legacy_read(bytes, command + 4)
    val offset = item4_macho_legacy_read(bytes, command + 8)
    val valid = offset >= 12 and offset <= length and name.len() < length - offset and command <= bytes.len() - length
    expect(valid).to_equal(true)
    if not valid: return bytes
    var changed = bytes
    for byte in offset..length: changed[command + byte] = 0u8
    for byte in 0..name.len(): changed[command + offset + byte] = name.byte_at(byte) as u8
    changed

describe "Legacy Mach-O whole-library reexport selectors":
    it "ITEM4-REQ-006 leaves an unmatched classic child with a higher deployment target inactive":
        val root = file_read_bytes("test/fixtures/linker/macho/legacy_classic_own_x64.dylib")
        val root_checked = macho_read_binary_provider_v1(root, RelocArch.X86_64)
        expect(root_checked.is_ok()).to_equal(true)
        if root_checked.is_err(): return
        expect(root_checked.unwrap().infer_subframeworks).to_equal(true)
        val original_child = file_read_bytes("test/fixtures/linker/macho/legacy_child_Different_x64.dylib")
        val checked = macho_read_binary_provider_v1(original_child, RelocArch.X86_64)
        expect(checked.is_ok()).to_equal(true)
        if checked.is_err(): return
        expect(checked.unwrap().parent_umbrella).to_equal(Some("Different"))
        val version = item4_macho_legacy_command(original_child, 0x32)
        if version < 0: return
        var child = original_child
        # Independent packed version mutation: major99, minor0, patch0.
        for byte in 0..4:
            child[version + 12 + byte] = ((0x630000 >> (8 * byte)) & 255) as u8
            child[version + 16 + byte] = ((0x630000 >> (8 * byte)) & 255) as u8
        val changed = macho_read_binary_provider_v1(child, RelocArch.X86_64)
        expect(changed.is_ok()).to_equal(true)
        if changed.is_err(): return
        expect(changed.unwrap().minimum_os).to_equal(Some(0x630000))
        val made = dir_create_all("build")
        expect(made).to_equal(true)
        if not made: return
        val created = secure_temp_dir("build", "item4-legacy-inactive-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val parent = created.unwrap()
        val root_written = file_write_bytes(parent + "/OldRoot", root)
        val child_written = file_write_bytes(parent + "/liblegacy.1.dylib", child)
        expect(root_written and child_written).to_equal(true)
        if not root_written or not child_written:
            item4_macho_legacy_cleanup(parent)
            return
        step("Resolve the classic root's own exports without activating its unmatched child")
        val linked = item4_macho_legacy_link(parent, parent + "/OldRoot", false)
        expect(linked.is_ok()).to_equal(true)
        if linked.is_ok(): item4_macho_legacy_check(file_read_bytes(parent + "/app"), false)
        item4_macho_legacy_cleanup(parent)

    it "ITEM4-REQ-006 validates selector strings even when the header suppresses legacy visibility":
        for suffix in ["x64", "a64"]:
            val arch = if suffix == "a64": RelocArch.AArch64 else: RelocArch.X86_64
            for family in ["library", "umbrella"]:
                val original = file_read_bytes("test/fixtures/linker/macho/legacy_{family}_{suffix}.dylib")
                val baseline = macho_read_binary_provider_v1(original, arch)
                expect(baseline.is_ok()).to_equal(true)
                if baseline.is_err(): return
                val command = item4_macho_legacy_command(original, if family == "library": 0x15 else: 0x13)
                if command < 0: return
                val length = item4_macho_legacy_read(original, command + 4)
                val offset = item4_macho_legacy_read(original, command + 8)
                for kind in 0..5:
                    var changed = original
                    if kind == 0 or kind == 3:
                        val value = if kind == 0: length else: 8
                        for byte in 0..4: changed[command + 8 + byte] = ((value >> (8 * byte)) & 255) as u8
                    elif kind == 1: changed[command + offset] = 0u8
                    else:
                        for byte in offset..length: changed[command + byte] = 65u8
                        if kind == 4: changed[26] = changed[26] | 16u8
                    step("Reject malformed bounded command strings independently of edge suppression")
                    expect(macho_read_binary_provider_v1(changed, arch).is_err()).to_equal(true)

    it "ITEM4-REQ-006 matches the library stem exactly across underscore variants and ignores near prefixes":
        val original = file_read_bytes("test/fixtures/linker/macho/legacy_library_x64.dylib")
        val baseline = macho_read_binary_provider_v1(original, RelocArch.X86_64)
        expect(baseline.is_ok()).to_equal(true)
        if baseline.is_err(): return
        val dependency = item4_macho_legacy_command(original, 12)
        val selector = item4_macho_legacy_command(original, 0x15)
        if dependency < 0 or selector < 0: return
        for mode in 0..3:
            val matching = mode == 0
            val made = dir_create_all("build")
            expect(made).to_equal(true)
            if not made: return
            val created = secure_temp_dir("build", "item4-legacy-stem-")
            expect(created.is_ok()).to_equal(true)
            if created.is_err(): return
            val parent = created.unwrap()
            var changed = item4_macho_legacy_name(original, dependency, "/usr/lib/liblegacy_x.dylib")
            if not matching: changed = item4_macho_legacy_name(changed, selector, if mode == 1: "liblega" else: "liblegacyX")
            val leaf_bytes = file_read_bytes("test/fixtures/linker/macho/legacy_leaf_x64.dylib")
            val leaf_checked = macho_read_binary_provider_v1(leaf_bytes, RelocArch.X86_64)
            expect(leaf_checked.is_ok()).to_equal(true)
            if leaf_checked.is_err():
                item4_macho_legacy_cleanup(parent)
                return
            val id_command = item4_macho_legacy_command(leaf_bytes, 0xd)
            if id_command < 0:
                item4_macho_legacy_cleanup(parent)
                return
            val leaf = item4_macho_legacy_name(leaf_bytes, id_command, "/usr/lib/liblegacy_x.dylib")
            val root_written = file_write_bytes(parent + "/OldRoot", changed)
            val leaf_written = file_write_bytes(parent + "/liblegacy_x.dylib", leaf)
            expect(root_written and leaf_written).to_equal(true)
            if not root_written or not leaf_written:
                item4_macho_legacy_cleanup(parent)
                return
            val linked = item4_macho_legacy_link(parent, parent + "/OldRoot", false)
            if matching:
                expect(linked.is_ok()).to_equal(true)
                if linked.is_ok(): item4_macho_legacy_check(file_read_bytes(parent + "/app"), false)
            else:
                expect(linked.is_err()).to_equal(true)
                if linked.is_err(): expect(linked.unwrap_err()).to_contain("unresolved hosted import")
                expect(file_exists(parent + "/app")).to_equal(false)
            item4_macho_legacy_cleanup(parent)

    it "ITEM4-REQ-006 admits dormant selectors and inference provenance without ordinary dependencies":
        for arm in [false, true]:
            val arch = if arm: RelocArch.AArch64 else: RelocArch.X86_64
            val suffix = if arm: "a64" else: "x64"
            val parsed = macho_read_binary_provider_v1(file_read_bytes("test/fixtures/linker/macho/legacy_leaf_{suffix}.dylib"), arch)
            expect(parsed.is_ok()).to_equal(true)
            if parsed.is_err(): return
            expect(parsed.unwrap().dependencies.len()).to_equal(0)
            if parsed.unwrap().dependencies.len() != 0: return
            val object = file_read_bytes("test/fixtures/linker/macho/hosted_start_{suffix}.o")
            val request = MachOHostedRequest(target: arch, entry: "_main", minimum_os: 0xb0000, sdk: 0xb0000,
                max_image_bytes: 1048576, identifier: "item4.legacy", rpaths: [])
            val baseline = macho_hosted_link_with_providers([object], [], [parsed.unwrap()], request)
            expect(baseline.is_ok()).to_equal(true)
            if baseline.is_err(): return
            for dormant in [false, true]:
                var provider = parsed.unwrap()
                provider.infer_subframeworks = true
                provider.no_reexported_dylibs = dormant
                if dormant:
                    provider.sub_libraries = ["unused"]
                    provider.sub_umbrellas = ["Unused"]
                val linked = macho_hosted_link_with_providers([object], [], [provider], request)
                expect(linked.is_ok()).to_equal(true)
                if linked.is_ok(): expect(linked.unwrap()).to_equal(baseline.unwrap())

    it "ITEM4-REQ-006 keeps ordinary and flag-suppressed dependencies hidden without altering the destination":
        for arm in [false, true]:
            val suffix = if arm: "a64" else: "x64"
            for family in ["library", "umbrella"]:
                val made = dir_create_all("build")
                expect(made).to_equal(true)
                if not made: return
                val created = secure_temp_dir("build", "item4-legacy-hidden-")
                expect(created.is_ok()).to_equal(true)
                if created.is_err(): return
                val parent = created.unwrap()
                val leaf = file_read_bytes(if family == "library": "test/fixtures/linker/macho/legacy_leaf_{suffix}.dylib" else:
                    "test/fixtures/linker/macho/legacy_framework_leaf_{suffix}.dylib")
                val stored = file_write_bytes(parent + (if family == "library": "/liblegacy.1.dylib" else: "/Leaf"), leaf)
                expect(stored and leaf.len() > 32).to_equal(true)
                if not stored or leaf.len() <= 32:
                    item4_macho_legacy_cleanup(parent)
                    return
                for suppressed in [false, true]:
                    val path = if suppressed: "test/fixtures/linker/macho/legacy_{family}_suppressed_{suffix}.dylib" else:
                        (if family == "library": "test/fixtures/linker/macho/legacy_ordinary_{suffix}.dylib" else:
                            "test/fixtures/linker/macho/legacy_framework_ordinary_{suffix}.dylib")
                    val sentinel: [u8] = [17, 83, 49, 2]
                    val written = file_write_bytes(parent + "/app", sentinel)
                    expect(written).to_equal(true)
                    if not written:
                        item4_macho_legacy_cleanup(parent)
                        return
                    step("Keep inactive dependencies hidden and preserve publication on unresolved imports")
                    val linked = item4_macho_legacy_link(parent, path, arm)
                    expect(linked.is_err()).to_equal(true)
                    if linked.is_err(): expect(linked.unwrap_err()).to_contain("unresolved hosted import")
                    expect(file_read_bytes(parent + "/app")).to_equal(sentinel)
                item4_macho_legacy_cleanup(parent)

    it "ITEM4-REQ-006 infers only classic subframework visibility from the physical parent basename":
        for arm in [false, true]:
            val suffix = if arm: "a64" else: "x64"
            val arch = if arm: RelocArch.AArch64 else: RelocArch.X86_64
            for mode in 0..4:
                val root_bytes = file_read_bytes(if mode == 3: "test/fixtures/linker/macho/legacy_modern_hidden_{suffix}.dylib" else:
                    "test/fixtures/linker/macho/legacy_classic_root_{suffix}.dylib")
                val parsed = macho_read_binary_provider_v1(root_bytes, arch)
                expect(parsed.is_ok()).to_equal(true)
                if parsed.is_err(): return
                expect(parsed.unwrap().infer_subframeworks).to_equal(mode != 3)
                expect(parsed.unwrap().install_name).to_equal("/usr/lib/liblegacy_root.dylib")
                val made = dir_create_all("build")
                expect(made).to_equal(true)
                if not made: return
                val created = secure_temp_dir("build", "item4-legacy-classic-")
                expect(created.is_ok()).to_equal(true)
                if created.is_err(): return
                val parent = created.unwrap()
                val physical = parent + (if mode == 2: "/Wrong" else: "/OldRoot")
                val child_name = if mode == 1: "Different" else: "OldRoot"
                val child = file_read_bytes("test/fixtures/linker/macho/legacy_child_{child_name}_{suffix}.dylib")
                val root_written = file_write_bytes(physical, root_bytes)
                val child_written = file_write_bytes(parent + "/liblegacy.1.dylib", child)
                val sentinel: [u8] = [17, 83, 49, 2]
                val output_written = file_write_bytes(parent + "/app", sentinel)
                val valid = root_written and child_written and output_written and child.len() > 32
                expect(valid).to_equal(true)
                if not valid:
                    item4_macho_legacy_cleanup(parent)
                    return
                step("Compare actual child umbrella metadata against the requesting binary physical name")
                val linked = item4_macho_legacy_link(parent, physical, arm)
                if mode == 0:
                    expect(linked.is_ok()).to_equal(true)
                    if linked.is_ok(): item4_macho_legacy_check(file_read_bytes(parent + "/app"), arm)
                else:
                    expect(linked.is_err()).to_equal(true)
                    if linked.is_err(): expect(linked.unwrap_err()).to_contain("unresolved hosted import")
                    expect(file_read_bytes(parent + "/app")).to_equal(sentinel)
                item4_macho_legacy_cleanup(parent)

    it "ITEM4-REQ-006 exposes selected ordinary dependencies through real legacy selector commands":
        for arm in [false, true]:
            val arch = if arm: RelocArch.AArch64 else: RelocArch.X86_64
            val suffix = if arm: "a64" else: "x64"
            for family in ["library", "umbrella"]:
                val path = "test/fixtures/linker/macho/legacy_{family}_{suffix}.dylib"
                val bytes = file_read_bytes(path)
                step("Read independently decoded legacy selectors from a real binary provider")
                val parsed = macho_read_binary_provider_v1(bytes, arch)
                expect(parsed.is_ok()).to_equal(true)
                if parsed.is_err(): return
                val provider = parsed.unwrap()
                expect(provider.dependencies.len()).to_equal(1)
                if provider.dependencies.len() != 1: return
                expect(provider.dependencies[0].command).to_equal(12)
                if family == "library": expect(provider.sub_libraries).to_equal(["liblegacy"])
                else: expect(provider.sub_umbrellas).to_equal(["Leaf"])
                val made = dir_create_all("build")
                expect(made).to_equal(true)
                if not made: return
                val created = secure_temp_dir("build", "item4-macho-legacy-")
                expect(created.is_ok()).to_equal(true)
                if created.is_err(): return
                val parent = created.unwrap()
                val leaf = file_read_bytes(if family == "library": "test/fixtures/linker/macho/legacy_leaf_{suffix}.dylib" else:
                    "test/fixtures/linker/macho/legacy_framework_leaf_{suffix}.dylib")
                val written = file_write_bytes(parent + (if family == "library": "/liblegacy.1.dylib" else: "/Leaf"), leaf)
                expect(written and leaf.len() > 32).to_equal(true)
                if not written or leaf.len() <= 32:
                    item4_macho_legacy_cleanup(parent)
                    return
                var config = NativeLinkConfig.default()
                config.runtime_path = "none"
                config.allow_cc_fallback = false
                config.library_paths = [parent]
                config.extra_flags = ["-platform_version", "macos", "11", "11", "--macho-signing-identifier", "item4.legacy"]
                val output = parent + "/app"
                val plan = native_macho_plan_v1(if arm: "aarch64" else: "x86_64", config, output)
                expect(plan.is_ok()).to_equal(true)
                if plan.is_ok():
                    step("Link real object imports through selector-derived whole-library edges")
                    val linked = native_macho_link_files_v1(plan.unwrap(), ["test/fixtures/linker/macho/hosted_start_{suffix}.o", path], [], output)
                    expect(linked.is_ok()).to_equal(true)
                    if linked.is_ok(): item4_macho_legacy_check(file_read_bytes(output), arm)
                item4_macho_legacy_cleanup(parent)

    it "ITEM4-REQ-006 refuses active legacy metadata in hosted APIs that do not build a closure":
        for arm in [false, true]:
            val arch = if arm: RelocArch.AArch64 else: RelocArch.X86_64
            val suffix = if arm: "a64" else: "x64"
            val object = file_read_bytes("test/fixtures/linker/macho/hosted_start_{suffix}.o")
            val request = MachOHostedRequest(target: arch, entry: "_main", minimum_os: 0xb0000, sdk: 0xb0000,
                max_image_bytes: 1048576, identifier: "item4.legacy", rpaths: [])
            for family in ["library", "umbrella"]:
                val bytes = file_read_bytes("test/fixtures/linker/macho/legacy_{family}_{suffix}.dylib")
                val parsed = macho_read_binary_provider_v1(bytes, arch)
                expect(parsed.is_ok()).to_equal(true)
                if parsed.is_err(): return
                step("Require a graph owner instead of silently ignoring active legacy visibility")
                val typed = macho_hosted_link_with_providers([object], [], [parsed.unwrap()], request)
                expect(typed.is_err()).to_equal(true)
                if typed.is_err(): expect(typed.unwrap_err()).to_contain("legacy")
                val raw = macho_hosted_link([object], [], [bytes], request)
                expect(raw.is_err()).to_equal(true)
                if raw.is_err(): expect(raw.unwrap_err()).to_contain("legacy")
