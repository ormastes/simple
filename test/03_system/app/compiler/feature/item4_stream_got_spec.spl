"""ITEM4-REQ-004/009 static x64 GOT stream acceptance. UNRUN.
Real ELF input/output bytes, no dynamic/TLS or measured memory admission claim.
"""
use std.spec.*
use std.spec.step
use std.io_runtime.{file_read_bytes, dir_create_all}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_remove, file_exists, file_write_bytes}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use compiler.backend.linker.elf.stream_types.{ElfStreamLimitsV1}
use compiler.backend.linker.elf.stream_link.{elf_stream_link_file_v1}
use compiler.backend.linker.elf.elf_static_link.{ElfLinkRequest, elf_link, ELF_LINK_STATIC_EXEC}
use compiler.backend.linker.reloc_engine.{RelocArch}
use compiler.backend.linker.elf.stream_inputs.{elf_stream_open_inputs_v1}
use compiler.backend.linker.elf.stream_got.*
use compiler.backend.linker.elf_parser.{elf_parse_object}

fn item4_stream_got_pc_slot(bytes: [u8], field: i64, width: i64, addend: i64) -> u64:
    val location = item4_stream_got_translate(bytes, field as u64, true)
    if location.len() != 3: return 0u64
    var value = item4_stream_got_read(bytes, field, width) as i64
    if width == 4 and value >= 2147483648: value = value - 4294967296
    (location[0] as i64 + value - addend) as u64

fn item4_stream_got_payload(bytes: [u8], slot: u64) -> u64:
    val location = item4_stream_got_translate(bytes, slot, false)
    if location.len() != 3: return 0u64
    expect(location[1]).to_equal(6u64)
    expect(location[2] >= 8u64).to_equal(true)
    if location[2] < 8u64: return 0u64
    item4_stream_got_read(bytes, location[0] as i64, 8)

fn item4_stream_got_family_check(bytes: [u8], streamed: bool):
    val table = item4_stream_got_marker(bytes, "GOTTABLE")
    if table < 0: return
    val base = item4_stream_got_read(bytes, table + 72, 8)
    expect(base % 8u64).to_equal(0u64)
    var offset32 = item4_stream_got_read(bytes, table + 8, 4) as i64
    if offset32 >= 2147483648: offset32 = offset32 - 4294967296
    val value_slot = (base as i64 + offset32) as u64
    expect((base as i64 + item4_stream_got_read(bytes, table + 16, 8) as i64) as u64).to_equal(value_slot)
    val function_slot = (base as i64 + item4_stream_got_read(bytes, table + 24, 8) as i64) as u64
    expect(function_slot == value_slot).to_equal(false)
    expect(item4_stream_got_pc_slot(bytes, table + 32, 4, 5)).to_equal(base)
    expect(item4_stream_got_pc_slot(bytes, table + 40, 8, 9)).to_equal(base)
    val value = item4_stream_got_payload(bytes, value_slot)
    val function = item4_stream_got_payload(bytes, function_slot)
    expect(item4_stream_got_read(bytes, table + 48, 8) as i64).to_equal(value as i64 - base as i64)
    expect(item4_stream_got_read(bytes, table + 56, 8) as i64).to_equal(function as i64 - base as i64)
    expect(item4_stream_got_pc_slot(bytes, table + 64, 8, 0)).to_equal(value_slot)
    expect(item4_stream_got_pc_slot(bytes, table + 80, 8, 7)).to_equal(value_slot)
    val weak_slot = item4_stream_got_pc_slot(bytes, table + 88, 8, 0)
    expect(item4_stream_got_payload(bytes, weak_slot)).to_equal(0u64)
    val common_slot = item4_stream_got_pc_slot(bytes, table + 96, 8, 0)
    val common = item4_stream_got_payload(bytes, common_slot)
    expect(common % 32u64).to_equal(0u64)
    val alias_slot = item4_stream_got_pc_slot(bytes, table + 104, 8, 0)
    expect(alias_slot == value_slot).to_equal(false)
    expect(item4_stream_got_payload(bytes, alias_slot)).to_equal(value)
    val target = item4_stream_got_translate(bytes, value, false)
    val code = item4_stream_got_translate(bytes, function, false)
    if target.len() != 3 or code.len() != 3: return
    expect(item4_stream_got_read(bytes, target[0] as i64, 8)).to_equal(0x0102030405060708u64)
    expect(item4_stream_got_read(bytes, code[0] as i64, 1)).to_equal(0xc3u64)
    var local_slots: [u64] = []
    for index in 0..2:
        val name = if index == 0: "GOTLOCAL1" else: "GOTLOCAL2"
        val marker = item4_stream_got_marker(bytes, name)
        if marker < 0: return
        val slot = item4_stream_got_pc_slot(bytes, marker + 9, 8, 0)
        local_slots.push(slot)
        expect(slot == value_slot or slot == alias_slot).to_equal(false)
        val location = item4_stream_got_translate(bytes, item4_stream_got_payload(bytes, slot), false)
        if location.len() != 3: return
        expect(item4_stream_got_read(bytes, location[0] as i64, 8)).to_equal(if index == 0: 111u64 else: 222u64)
    expect(local_slots[0] == local_slots[1]).to_equal(false)
    if streamed:
        expect(value_slot).to_equal(base)
        expect(function_slot).to_equal(base + 8u64)
        expect(weak_slot).to_equal(base + 16u64)
        expect(common_slot).to_equal(base + 24u64)
        expect(alias_slot).to_equal(base + 32u64)
        expect(local_slots[0]).to_equal(base + 40u64)
        expect(local_slots[1]).to_equal(base + 48u64)
        val extent = item4_stream_got_translate(bytes, base, false)
        if extent.len() != 3: return
        expect(extent[2]).to_equal(56u64)
        item4_stream_got_check(bytes)
        val marker = item4_stream_got_marker(bytes, "GOTCASE!")
        if marker < 0: return
        expect(item4_stream_got_read(bytes, marker + 29, 4)).to_equal(0x058b48d5u64)
        expect(item4_stream_got_pc_slot(bytes, marker + 33, 4, -4)).to_equal(value_slot)
        val location = item4_stream_got_translate(bytes, common, false)
        if location.len() != 3: return
        expect(location[2] >= 24u64).to_equal(true)
        for index in 0..24: expect(item4_stream_got_read(bytes, location[0] as i64 + index, 1)).to_equal(0u64)
        expect(base >= common + 24u64).to_equal(true)

fn item4_stream_got_family_inputs() -> [text]:
    ["test/fixtures/linker/elf/stream_got_families.o",
        "test/fixtures/linker/elf/stream_got_local_one.o",
        "test/fixtures/linker/elf/stream_got_local_two.o"]

fn item4_stream_got_fast(objects: [text], archives: [text]) -> Result<[u8], text>:
    var raw_objects: [[i64]] = []
    var raw_archives: [[i64]] = []
    for path in objects:
        var bytes: [i64] = []
        for byte in file_read_bytes(path): bytes.push(byte as i64)
        raw_objects.push(bytes)
    for path in archives:
        var bytes: [i64] = []
        for byte in file_read_bytes(path): bytes.push(byte as i64)
        raw_archives.push(bytes)
    val linked = elf_link(ElfLinkRequest(objects: raw_objects, archives: raw_archives,
        shared: [], entry: "_start", target: RelocArch.X86_64, mode: ELF_LINK_STATIC_EXEC,
        interp: "", gc_sections: false))?
    var output: [u8] = []
    for byte in linked: output.push(byte as u8)
    Ok(output)

fn item4_stream_got_mutate(kind: i64) -> [u8]:
    var bytes = file_read_bytes("test/fixtures/linker/elf/stream_got_refs.o")
    var widened: [i64] = []
    for byte in bytes: widened.push(byte as i64)
    val parsed = elf_parse_object(widened)
    expect(parsed.is_ok()).to_equal(true)
    if parsed.is_err(): return []
    for section in parsed.unwrap().sections:
        if section.sh_type == 4:
            val offset = section.sh_addr
            val valid = offset >= 0 and offset <= bytes.len() and 24 <= bytes.len() - offset
            expect(valid).to_equal(true)
            if not valid: return []
            expect(item4_stream_got_read(bytes, offset, 8)).to_equal(11u64)
            expect(item4_stream_got_read(bytes, offset + 8, 4)).to_equal(9u64)
            expect(item4_stream_got_read(bytes, offset + 16, 8) as i64).to_equal(-4)
            if item4_stream_got_read(bytes, offset, 8) != 11u64 or item4_stream_got_read(bytes, offset + 8, 4) != 9u64: return []
            if item4_stream_got_read(bytes, offset + 16, 8) as i64 != -4: return []
            var field = offset
            var width = 8
            var value = 28u64
            if kind == 0:
                field = offset + 12
                width = 4
                value = 2147483647u64
            elif kind == 1:
                val index = section.sh_info
                expect(index >= 0 and index < parsed.unwrap().sections.len()).to_equal(true)
                if index < 0 or index >= parsed.unwrap().sections.len(): return []
                value = (parsed.unwrap().sections[index].sh_size - 1) as u64
            elif kind == 2:
                field = offset + 16
                value = 2147483647u64
            else:
                field = offset + 8
                width = 4
                value = 22u64
            for byte in 0..width: bytes[field + byte] = ((value >> (byte * 8)) & 255u64) as u8
            return bytes
    expect(false).to_equal(true)
    []

fn item4_stream_got_limits() -> ElfStreamLimitsV1:
    ElfStreamLimitsV1(input_limit: 12, archive_member_limit: 64u64, metadata_bytes: 262144u64,
        read_window_bytes: 64, emit_window_bytes: 8, name_bytes: 64,
        output_bytes: 1048576u64, scratch_bytes: 4194304u64, scan_record_limit: 2000000u64)

fn item4_stream_got_cancelled() -> bool: false
fn item4_stream_got_stop() -> bool: true

fn item4_stream_got_read(bytes: [u8], offset: i64, width: i64) -> u64:
    val valid = offset >= 0 and offset <= bytes.len() and width >= 1 and width <= 8 and width <= bytes.len() - offset
    expect(valid).to_equal(true)
    if not valid: return 0u64
    var value = 0u64
    for index in 0..width: value = value | ((bytes[offset + index] as u64) << (index * 8))
    value

fn item4_stream_got_marker(bytes: [u8], marker: text) -> i64:
    var found = -1
    var count = 0
    if bytes.len() < marker.len():
        expect(false).to_equal(true)
        return -1
    for offset in 0..(bytes.len() - marker.len() + 1):
        var matched = true
        for index in 0..marker.len():
            if bytes[offset + index] != marker.byte_at(index) as u8: matched = false
        if matched:
            found = offset
            count = count + 1
    expect(count).to_equal(1)
    if count != 1: return -1
    found

fn item4_stream_got_translate(bytes: [u8], value: u64, from_file: bool) -> [u64]:
    expect(item4_stream_got_read(bytes, 54, 2)).to_equal(56u64)
    if item4_stream_got_read(bytes, 54, 2) != 56u64: return []
    val phoff = item4_stream_got_read(bytes, 32, 8)
    val count = item4_stream_got_read(bytes, 56, 2)
    val valid = phoff <= bytes.len() as u64 and count > 0u64 and count < 64u64 and count * 56u64 <= bytes.len() as u64 - phoff
    expect(valid).to_equal(true)
    if not valid: return []
    for index in 0..(count as i64):
        val at = phoff as i64 + index * 56
        if item4_stream_got_read(bytes, at, 4) == 1u64:
            val offset = item4_stream_got_read(bytes, at + 8, 8)
            val address = item4_stream_got_read(bytes, at + 16, 8)
            val size = item4_stream_got_read(bytes, at + 32, 8)
            val start = if from_file: offset else: address
            if value >= start and value - start < size:
                return [if from_file: address + value - offset else: offset + value - address,
                    item4_stream_got_read(bytes, at + 4, 4), size - (value - start)]
    expect(false).to_equal(true)
    []

fn item4_stream_got_check(bytes: [u8]):
    expect(item4_stream_got_read(bytes, 0, 4)).to_equal(0x464c457fu64)
    expect(item4_stream_got_read(bytes, 18, 2)).to_equal(62u64)
    val marker = item4_stream_got_marker(bytes, "GOTCASE!")
    if marker < 0: return
    expect(item4_stream_got_read(bytes, marker + 8, 3)).to_equal(0x058b48u64)
    expect(item4_stream_got_read(bytes, marker + 15, 2)).to_equal(0x15ffu64)
    expect(item4_stream_got_read(bytes, marker + 21, 3)).to_equal(0x058b48u64)
    var slots: [u64] = []
    val fields = [11, 17, 24]
    for index in 0..fields.len():
        val field = marker + fields[index]
        val address = item4_stream_got_translate(bytes, field as u64, true)
        if address.len() != 3: return
        var displacement = item4_stream_got_read(bytes, field, 4) as i64
        if displacement >= 2147483648: displacement = displacement - 4294967296
        val slot = (address[0] as i64 + 4 + displacement) as u64
        slots.push(slot)
        val location = item4_stream_got_translate(bytes, slot, false)
        if location.len() != 3: return
        expect(location[1]).to_equal(6u64)
        expect(location[2] >= 8u64).to_equal(true)
        if location[2] < 8u64: return
        val target = item4_stream_got_read(bytes, location[0] as i64, 8)
        val payload = item4_stream_got_translate(bytes, target, false)
        if payload.len() != 3: return
        if index == 1:
            expect(payload[1]).to_equal(5u64)
            expect(item4_stream_got_read(bytes, payload[0] as i64, 1)).to_equal(0xc3u64)
        else:
            expect(item4_stream_got_read(bytes, payload[0] as i64, 8)).to_equal(0x0102030405060708u64)
    expect(slots[0]).to_equal(slots[2])
    expect(slots[0] == slots[1]).to_equal(false)

describe "Streamed static x64 GOT relocation families":
    it "rejects malformed symbol patch range displacement and TLS demands without publishing":
        step("Mutate checked real GOT relocation records and retain a destination sentinel")
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-invalid-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        val input = directory + "/invalid.o"
        val output = directory + "/protected"
        val sentinel: [u8] = [17, 0, 255, 31]
        expect(file_write_bytes(output, sentinel)).to_equal(true)
        for kind in 0..4:
            val bytes = item4_stream_got_mutate(kind)
            expect(bytes.len()).to_be_greater_than(64)
            if bytes.len() > 64:
                expect(file_write_bytes(input, bytes)).to_equal(true)
                val linked = elf_stream_link_file_v1([input, "test/fixtures/linker/elf/stream_got_provider.o"], [],
                    [95, 115, 116, 97, 114, 116], output, directory, item4_stream_got_limits(), item4_stream_got_cancelled)
                expect(linked.is_err()).to_equal(true)
                if linked.is_err():
                    val errors = ["symbol", "patch exceeds input section", "signed 32-bit range", "unsupported TLS"]
                    expect(linked.unwrap_err()).to_contain(errors[kind])
                expect(file_read_bytes(output)).to_equal(sentinel)
        for path in [input, output]:
            if file_exists(path): expect(file_remove(path)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)

    it "rejects global and weak definitions of the synthetic anchor but preserves a local spelling":
        step("Distinguish reserved nonlocal anchor definitions from an actual local data reference")
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-reserved-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        for name in ["global", "weak", "local"]:
            val output = directory + "/" + name
            val sentinel: [u8] = [17, 0, 255, 31]
            if name != "local": expect(file_write_bytes(output, sentinel)).to_equal(true)
            val linked = elf_stream_link_file_v1(["test/fixtures/linker/elf/stream_got_anchor_" + name + ".o"], [],
                [95, 115, 116, 97, 114, 116], output, directory, item4_stream_got_limits(), item4_stream_got_cancelled)
            if name == "local":
                expect(linked.is_ok()).to_equal(true)
                if linked.is_ok():
                    expect(linked.unwrap().cleanup_pending).to_equal(false)
                    val image = file_read_bytes(output)
                    val marker = item4_stream_got_marker(image, "LOCALGOT")
                    if marker >= 0:
                        val address = item4_stream_got_read(image, marker + 8, 8)
                        val location = item4_stream_got_translate(image, address, false)
                        if location.len() == 3: expect(item4_stream_got_read(image, location[0] as i64, 8)).to_equal(77u64)
            else:
                expect(linked.is_err()).to_equal(true)
                if linked.is_err(): expect(linked.unwrap_err()).to_equal("stream reserved GOT anchor definition")
                expect(file_read_bytes(output)).to_equal(sentinel)
            if file_exists(output): expect(file_remove(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)

    it "enforces GOT-only output extent scan quota and cancellation without replacing a sentinel":
        step("Enter the actual GOT scan with real opened inputs and an exhausted quota")
        val objects = ["test/fixtures/linker/elf/stream_got_refs.o", "test/fixtures/linker/elf/stream_got_provider.o"]
        val opened = elf_stream_open_inputs_v1(objects, [], [95, 115, 116, 97, 114, 116],
            item4_stream_got_limits(), item4_stream_got_cancelled)
        expect(opened.is_ok()).to_equal(true)
        if opened.is_ok():
            var inputs = opened.unwrap()
            inputs.records_left = 0u64
            val exhausted = inputs.elf_stream_got_layout_v1(8200u64, None, item4_stream_got_cancelled)
            expect(exhausted.is_err()).to_equal(true)
            if exhausted.is_err(): expect(exhausted.unwrap_err()).to_contain("scan-work")
            inputs.records_left = 2000000u64
            val cancelled = inputs.elf_stream_got_layout_v1(8200u64, None, item4_stream_got_stop)
            expect(cancelled.is_err()).to_equal(true)
            if cancelled.is_err(): expect(cancelled.unwrap_err()).to_contain("cancelled")
            expect(inputs.elf_stream_close_inputs_v1()).to_equal(true)
            expect(inputs.closed).to_equal(true)
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-budget-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        val output = directory + "/protected"
        val sentinel: [u8] = [17, 0, 255, 31]
        expect(file_write_bytes(output, sentinel)).to_equal(true)
        for kind in 0..4:
            var limits = item4_stream_got_limits()
            # No RO input sections here: RW begins at 8192, then data[8]+GOT[16].
            if kind == 0: limits.output_bytes = 8215u64
            if kind == 1: limits.scratch_bytes = 1u64
            if kind == 2: limits.scan_record_limit = 1u64
            val linked = elf_stream_link_file_v1(objects, [], [95, 115, 116, 97, 114, 116],
                output, directory, limits, if kind == 3: item4_stream_got_stop else: item4_stream_got_cancelled)
            expect(linked.is_err()).to_equal(true)
            if linked.is_err():
                val names = ["GOT", "scratch", "scan-work", "cancelled"]
                expect(linked.unwrap_err()).to_contain(names[kind])
                if kind == 0: expect(linked.unwrap_err()).to_equal("stream GOT storage exceeds output budget")
            expect(file_read_bytes(output)).to_equal(sentinel)
        expect(file_remove(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)

    it "links all twelve ordinary families with global local common weak and archive identities":
        step("Decode full formula families and distinguish equal-address globals from same-spelling locals")
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-families-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        val base_objects = item4_stream_got_family_inputs()
        for archived in [false, true]:
            val objects = if archived: base_objects else: base_objects + ["test/fixtures/linker/elf/stream_got_provider.o"]
            val archives = if archived: ["test/fixtures/linker/elf/stream_got_provider.a"] else: []
            val output = directory + "/image-{archived}.elf"
            val linked = elf_stream_link_file_v1(objects, archives, [95, 115, 116, 97, 114, 116],
                output, directory, item4_stream_got_limits(), item4_stream_got_cancelled)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                expect(linked.unwrap().cleanup_pending).to_equal(false)
                item4_stream_got_family_check(file_read_bytes(output), true)
            val fast = item4_stream_got_fast(objects, archives)
            expect(fast.is_ok()).to_equal(true)
            if fast.is_ok(): item4_stream_got_family_check(fast.unwrap(), false)
            if file_exists(output): expect(file_remove(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)

    it "leaves inactive GOT unaligned while an active zero-slot anchor adds only alignment padding":
        step("Use an exact unaligned output cap with no demand and with an unused undefined anchor")
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-anchor-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        var baseline: [u8] = []
        for name in ["inactive", "unused_anchor", "nonallocated", "anchor", "base_only"]:
            var limits = item4_stream_got_limits()
            limits.output_bytes = if name == "anchor" or name == "base_only": 12296u64 else: 12289u64
            val output = directory + "/" + name
            val linked = elf_stream_link_file_v1(["test/fixtures/linker/elf/stream_got_" + name + ".o"], [],
                [95, 115, 116, 97, 114, 116], output, directory, limits, item4_stream_got_cancelled)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                expect(linked.unwrap().cleanup_pending).to_equal(false)
                val image = file_read_bytes(output)
                expect(image.len() as u64).to_equal(limits.output_bytes)
                if name == "inactive": baseline = image
                elif name == "unused_anchor" or name == "nonallocated": expect(image).to_equal(baseline)
                else:
                    val marker = item4_stream_got_marker(image, "GOTEMPTY")
                    if marker >= 0:
                        val anchor = 4194304u64 + 12296u64
                        if name == "anchor":
                            expect(item4_stream_got_read(image, marker + 8, 8)).to_equal(anchor)
                            expect(item4_stream_got_pc_slot(image, marker + 16, 8, 0)).to_equal(anchor)
                        else:
                            expect(item4_stream_got_pc_slot(image, marker + 8, 8, 0)).to_equal(anchor)
                            expect((item4_stream_got_read(image, marker + 16, 8) as i64 + anchor as i64) as u64).to_equal(item4_stream_got_read(image, 24, 8))
            if file_exists(output): expect(file_remove(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)

    it "emits actual GOTPCREL and unrelaxed GOTPCRELX slots across narrow windows":
        step("Link real types nine forty-one and forty-two and decode instruction to slot to target")
        expect(dir_create_all("build")).to_equal(true)
        val created = secure_temp_dir("build", "item4-stream-got-")
        expect(created.is_ok()).to_equal(true)
        if created.is_err(): return
        val directory = created.unwrap()
        var baseline: [u8] = []
        for window in [1, 3, 8, 64]:
            var limits = item4_stream_got_limits()
            limits.emit_window_bytes = window
            val output = directory + "/window-{window}.elf"
            val linked = elf_stream_link_file_v1(["test/fixtures/linker/elf/stream_got_refs.o",
                "test/fixtures/linker/elf/stream_got_provider.o"], [], [95, 115, 116, 97, 114, 116],
                output, directory, limits, item4_stream_got_cancelled)
            expect(linked.is_ok()).to_equal(true)
            if linked.is_ok():
                expect(linked.unwrap().cleanup_pending).to_equal(false)
                val image = file_read_bytes(output)
                item4_stream_got_check(image)
                if window == 1: baseline = image
                else: expect(image).to_equal(baseline)
            if file_exists(output): expect(file_remove(output)).to_equal(true)
        expect(dir_remove(directory, false)).to_equal(true)
