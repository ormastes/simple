# @tag:in-development
# Tracks: doc/08_tracking/bug/pr1870_pr1830_unreviewed_merge_fallout_2026-09-28.md
# @cover src/app/io/_CliCompile/native_collection_profile.spl
# @cover src/compiler/10.frontend/core/collection_feedback.spl
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_text_set.spl
# @cover src/lib/nogc_sync_mut/src/collections/adaptive_text_map.spl
"""
# Profile-switchable containers: captured workload reaches native storage

Run these scenarios with an admitted pure-Simple runtime. They compare text and
integer-key generic containers, replay paired collision evidence through both
engines, capture a workload, explain its matching sites, and check native
storage. A Rust bootstrap seed cannot satisfy the admission gate. Other key
families and typed optimizer requirements remain open in the system test plan.
"""

use std.spec.*
use std.spec.step
use std.io_runtime.{
    process_run, process_run_timeout, file_exists, file_delete, file_write,
    mkdir_p, getpid, read_file_text, env_get, env_set
}
use app.optimize.sprof_collection_profile.{
    SprofCollectionMetric, sprof_source_module_identity,
    sprof_source_module_identity_from_text,
    sprof_write_collection_profile_file_with_metrics
}
use app.optimize.collection_plan_cli.{collection_plan_source_sites}
use std.nogc_sync_mut.src.collections.adaptive_text_set.{AdaptiveSetWorkloadProfile}
use test.system.qualified_pure_simple_runtime.{admit_pure_simple_runtime}

val COLLECTION_SYSTEM_PROBE = "test/02_integration/compiler/probe_profile_switchable_cli_feedback.spl"
val COLLECTION_SEMANTICS_PROBE = "test/fixtures/profile_switchable/semantics_probe.spl"
val COLLECTION_GENERIC_PROBE = "test/fixtures/profile_switchable/generic_semantics_probe.spl"
val COLLECTION_TYPED_FACTORY_PROBE = "test/fixtures/profile_switchable/typed_factory_attribute_probe.spl"
val COLLECTION_UNSUPPORTED_KEY_PROBE = "test/fixtures/profile_switchable/unsupported_ordered_key_probe.spl"
val COLLECTION_EMBEDDED_MISMATCH_PROBE = "test/fixtures/profile_switchable/embedded_replay_mismatch_probe.spl"
val COLLECTION_FORCED_PRIOR_MISMATCH_PROBE = "test/fixtures/profile_switchable/forced_prior_mismatch_probe.spl"
val COLLECTION_COLLISION_PROBE = "test/02_integration/compiler/probe_profile_switchable_collision_replay.spl"

fn collection_system_field(output: text, prefix: text) -> text:
    for line in output.split("\n"):
        val trimmed = line.trim()
        if trimmed.starts_with(prefix):
            return trimmed.substring(prefix.len(), trimmed.len())
    ""

describe "profile-switchable collection system workflow":
    it "should preserve text set and map behavior across three physical algorithms":
        """My set and map contents stay the same when their physical storage changes."""
        # @req REQ-PSC-001 REQ-PSC-002 REQ-PSC-008
        step("Admit a source-matched pure-Simple compiler")
        val runtime = admit_pure_simple_runtime()
        if runtime == "":
            fail("MissingEvidence: source-matched pure-Simple runtime is unavailable")
            return
        val previous_no_stub = env_get("SIMPLE_NO_STUB_FALLBACK") ?? ""
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", "1")).to_be(true)
        step("Run the attributed semantics probe through the interpreter")
        val (interpreted_out, interpreted_err, interpreted_code) = process_run(
            runtime, ["run", COLLECTION_SEMANTICS_PROBE])
        expect(interpreted_code).to_equal(0)
        expect(interpreted_out + interpreted_err).to_contain("COLLECTION_SEMANTICS: PASS")
        step("Build and run the same source through LLVM native code")
        val binary_path = "build/collection_semantics_system_{getpid()}.exe"
        val (build_out, build_err, build_code) = process_run(runtime, [
            "native-build", "--backend=llvm", "--mode=one-binary",
            "--entry-closure", "--entry", COLLECTION_SEMANTICS_PROBE,
            "--source", "src/lib", "--output", binary_path
        ])
        expect(build_code).to_equal(0)
        expect(file_exists(binary_path)).to_be(true)
        val (native_out, native_err, native_code) = process_run(binary_path, [])
        file_delete(binary_path)
        expect(native_code).to_equal(0)
        expect(native_out + native_err).to_contain("COLLECTION_SEMANTICS: PASS")
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", previous_no_stub)).to_be(true)

    it "should preserve integer-key generic set and map behavior across three algorithms":
        """Integer-key collections keep their logical contents across storage choices."""
        # @req REQ-PSC-002 REQ-PSC-008
        step("Admit a source-matched pure-Simple compiler")
        val runtime = admit_pure_simple_runtime()
        if runtime == "":
            fail("MissingEvidence: source-matched pure-Simple runtime is unavailable")
            return
        val previous_no_stub = env_get("SIMPLE_NO_STUB_FALLBACK") ?? ""
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", "1")).to_be(true)
        step("Run the generic semantics probe through the interpreter")
        val (interpreted_out, interpreted_err, interpreted_code) = process_run(
            runtime, ["run", COLLECTION_GENERIC_PROBE])
        expect(interpreted_code).to_equal(0)
        expect(interpreted_out + interpreted_err).to_contain("COLLECTION_GENERIC_SEMANTICS: PASS")
        step("Build and run the generic source through LLVM native code")
        val binary_path = "build/collection_generic_semantics_system_{getpid()}.exe"
        val (build_out, build_err, build_code) = process_run(runtime, [
            "native-build", "--backend=llvm", "--mode=one-binary",
            "--entry-closure", "--entry", COLLECTION_GENERIC_PROBE,
            "--source", "src/lib", "--output", binary_path
        ])
        expect(build_code).to_equal(0)
        expect(file_exists(binary_path)).to_be(true)
        val (native_out, native_err, native_code) = process_run(binary_path, [])
        file_delete(binary_path)
        expect(native_code).to_equal(0)
        expect(native_out + native_err).to_contain("COLLECTION_GENERIC_SEMANTICS: PASS")
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", previous_no_stub)).to_be(true)

