        step("Admit a source-matched pure-Simple compiler")
        val runtime = admit_pure_simple_runtime()
        if runtime == "":
            fail("MissingEvidence: source-matched pure-Simple runtime is unavailable")
            return
        val previous_no_stub = env_get("SIMPLE_NO_STUB_FALLBACK") ?? ""
        expect(env_set("SIMPLE_NO_STUB_FALLBACK", "1")).to_be(true)
        step("Run the typed factory probe through the interpreter")
        val (interpreted_out, interpreted_err, interpreted_code) = process_run(
            runtime, ["run", COLLECTION_TYPED_FACTORY_PROBE])
        expect(interpreted_code).to_equal(0)
        expect(interpreted_out + interpreted_err).to_contain("COLLECTION_TYPED_FACTORY: PASS")
        step("Build and run the same factory source through LLVM native code")
        val binary_path = "build/collection_typed_factory_system_{getpid()}.exe"
        val (_build_out, _build_err, build_code) = process_run(runtime, [
            "native-build", "--backend=llvm", "--mode=one-binary",
