"""
# Item 4 ELF input bounds (ITEM4-REQ-006 ITEM4-REQ-007)

Real fixture mutations pass through the production parser and linker. Test-first
source is NOT RUN until an admitted SSpec runtime is available. No native
execution, RED/GREEN, or release admission is claimed.
"""
use std.spec.*
use std.spec.step
use std.io_runtime.{file_read_bytes}
use compiler.backend.linker.elf_parser.{elf_parse_object, elf_section_name}
use compiler.backend.linker.elf.elf_static_link.{elf_static_link}
use compiler.backend.linker.reloc_engine.{RelocArch}

fn item4_bounds_load(name: text) -> [i64]:
    val raw = file_read_bytes("test/fixtures/linker/elf/" + name)
    expect(raw.len()).to_be_greater_than(64)
    var bytes: [i64] = []
    for byte in raw:
        bytes = bytes.push(byte as i64)
    bytes

fn item4_bounds_write(bytes: [i64], offset: i64, value: i64) -> [i64]:
    val valid = offset >= 0 and offset <= bytes.len() and bytes.len() - offset >= 8
    expect(valid).to_equal(true)
    if not valid: return []
    var changed = bytes
    var index: i64 = 0
    while index < 8:
        changed[offset + index] = (value >> (index * 8)) & 255
        index = index + 1
    changed

fn item4_bounds_section_header(bytes: [i64], name: text, kind: i64) -> i64:
    val parsed = elf_parse_object(bytes)
    expect(parsed.is_ok()).to_equal(true)
    if parsed.is_err(): return -1
    val object = parsed.unwrap()
    expect(object.header.e_type).to_equal(1)
    expect(object.header.e_machine).to_equal(62)
    var index: i64 = 0
    while index < object.sections.len():
        if elf_section_name(object, index) == name:
            expect(object.sections[index].sh_type).to_equal(kind)
            expect(object.sections[index].sh_size).to_be_greater_than(0)
            if object.sections[index].sh_type != kind or object.sections[index].sh_size <= 0:
                return -1
            return object.header.e_shoff + index * 64
        index = index + 1
    fail("expected fixture section is missing")
    -1

fn item4_bounds_expect_error(bytes: [i64], diagnostic: text):
    val parsed = elf_parse_object(bytes)
    expect(parsed.is_err()).to_equal(true)
    if parsed.is_ok(): return
    expect(parsed.unwrap_err()).to_contain(diagnostic)
    val linked = elf_static_link([bytes], [], "_start", RelocArch.X86_64)
    expect(linked.is_err()).to_equal(true)
    if linked.is_ok(): return
    expect(linked.unwrap_err()).to_contain("object 0:")
    expect(linked.unwrap_err()).to_contain(diagnostic)

describe "Item 4 ELF input bounds":
    # @req ITEM4-REQ-006 ITEM4-REQ-007
    it "rejects a section-header offset whose end calculation would overflow":
        step("Verify a real x86_64 fixture has a nonempty section table")
        val original = item4_bounds_load("start_x64.o")
        val parsed = elf_parse_object(original)
        expect(parsed.is_ok()).to_equal(true)
        if parsed.is_err(): return
        expect(parsed.unwrap().header.e_shnum).to_be_greater_than(0)
        step("Replace only e_shoff with the largest signed 64-bit offset")
        val changed = item4_bounds_write(original, 40, 0x7fffffffffffffff)
        step("Require a bounded parser failure preserved by the production linker")
        item4_bounds_expect_error(changed, "Section header table extends beyond file end")

    # @req ITEM4-REQ-006 ITEM4-REQ-007
    it "rejects a file-backed section whose offset exceeds the input":
        step("Locate the actual nonempty text section in a valid object")
        val original = item4_bounds_load("start_x64.o")
        val header = item4_bounds_section_header(original, ".text", 1)
        if header < 0: return
        step("Move its file offset one byte past the fixture")
        val changed = item4_bounds_write(original, header + 24, original.len() + 1)
        step("Reject the invalid payload rather than substituting empty bytes")
        item4_bounds_expect_error(changed, "section data extends beyond file end")

    # @req ITEM4-REQ-006 ITEM4-REQ-007
    it "rejects a section size whose end calculation would overflow":
        step("Locate the actual text section without changing its valid file offset")
        val original = item4_bounds_load("start_x64.o")
        val header = item4_bounds_section_header(original, ".text", 1)
        if header < 0: return
        step("Replace its size with the largest signed 64-bit integer")
        val changed = item4_bounds_write(original, header + 32, 0x7fffffffffffffff)
        step("Require a range error before section contents are read")
        item4_bounds_expect_error(changed, "section data extends beyond file end")

    # @req ITEM4-REQ-006
    it "accepts NOBITS memory with no corresponding file payload":
        step("Locate the valid provider BSS and retain its type and memory size")
        val original = item4_bounds_load("lib_x64.o")
        val header = item4_bounds_section_header(original, ".bss", 8)
        if header < 0: return
        step("Move only the conceptual NOBITS file offset beyond the file")
        val changed = item4_bounds_write(original, header + 24, original.len() + 4096)
        expect(elf_parse_object(changed).is_ok()).to_equal(true)
        val entry = item4_bounds_load("start_x64.o")
        step("Require identical linked images because BSS has no file bytes")
        val baseline = elf_static_link([entry, original], [], "_start", RelocArch.X86_64)
        val result = elf_static_link([entry, changed], [], "_start", RelocArch.X86_64)
        expect(baseline.is_ok()).to_equal(true)
        expect(result.is_ok()).to_equal(true)
        if baseline.is_err() or result.is_err(): return
        expect(result.unwrap()).to_equal(baseline.unwrap())
