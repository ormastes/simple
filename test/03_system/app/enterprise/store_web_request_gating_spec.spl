"""
# Store Web Request-Gating — dispatcher CSRF + route-level write gate (W14-C)

Closes the two residuals recorded OPEN in
`doc/07_guide/app/enterprise/security_posture.md`:

1. **Route-level write gating (defense in depth).** Authorization for a
   mutating route lived only inside each command's frozen guarded sequence
   (session -> rbac -> validation -> idempotency). The dispatcher itself did
   no role/method authorization: an authenticated-but-unauthorized role
   reached the handler and the command, and was only rejected deep inside it.
   This spec fixes an authenticated `booking`-role session hitting
   `POST /fin/period/close`: it is now rejected AT DISPATCH — observably, the
   denial detail is `write-gate:finance.period.close`, not the command's own
   detail — while an authorized role still passes the gate. The in-command
   check is unchanged and still fires; the dispatcher gate is additional.

2. **CSRF token / cookie flow.** The app is bearer-token only, which sidesteps
   CSRF — until a request rides an AMBIENT cookie credential, the one shape a
   browser can be tricked into forging cross-site. Such a request must now
   echo the session's CSRF token in `X-CSRF-Token` (double-submit); without a
   valid token it is rejected 403 at dispatch, with it the request proceeds.
   A bearer-only request (no `Cookie` header) is exempt, so no bearer API
   client regresses.

## Red-first evidence
- Item 1: before the gate, the `booking` -> close denial detail is the
  command's (`forbidden: 0`), so the `write-gate:` assertion FAILS (red);
  after, it PASSES with 403.
- Item 2: before the check, an admin cookie-borne close WITHOUT a token
  reaches the command and returns 200 (the forgery succeeds — red); after, it
  is 403 without a token and 200 with the session's token.

**Requirements:** N/A
**Plan:** doc/03_plan/agent_tasks/simple_erp.md
**Design:** N/A
**Research:** doc/01_research/app/enterprise/simple_enterprise_suite_assessment_and_parallel_plan_2026-08-16.md

Lane: .spipe/simple_enterprise_suite (v2, W14-C).
"""

use std.spec.*
use std.io_runtime.{file_exists, file_delete, dir_create_all}
use std.nogc_sync_mut.enterprise_store.store.{store_open, store_close}
use std.nogc_sync_mut.enterprise_sale.foundation.{
    TenantContext, ActorContext, SessionContext
}
use std.nogc_sync_mut.enterprise_sale.goods_sale.{sale_setup}
use std.nogc_sync_mut.enterprise_outbox.outbox_worker.{outbox_worker_setup}
use std.nogc_sync_mut.enterprise_finance.finance.{fin_setup}
use std.nogc_sync_mut.http_server.types.{http_status_code}
use app.enterprise_store_app.main.{store_app_handle}
use app.enterprise_store_app.csrf.{csrf_token}

fn db_path(name: text) -> text:
    "build/test-artifacts/store_gating_" + name + ".db"

fn tenant_a() -> TenantContext:
    TenantContext(tenant_id: "tenant-a", name: "Alpha Trading")

fn admin_a() -> ActorContext:
    ActorContext(actor_id: "admin-1", role: "admin")

fn booking_a() -> ActorContext:
    ActorContext(actor_id: "agent-1", role: "booking")

fn session_for(who: ActorContext, tenant: TenantContext) -> SessionContext:
    SessionContext(token: "tok-" + who.actor_id, actor_id: who.actor_id, tenant_id: tenant.tenant_id, active: true)

fn bearer_headers() -> [(text, text)]:
    [("Host", "store.example"), ("Content-Length", "0")]

# cookie_headers simulates a browser: an ambient session Cookie, optionally a
# double-submit CSRF token header.
fn cookie_headers(csrf: text) -> [(text, text)]:
    if csrf == "":
        [("Host", "store.example"), ("Content-Length", "0"), ("Cookie", "sid=abc")]
    else:
        [("Host", "store.example"), ("Content-Length", "0"), ("Cookie", "sid=abc"), ("X-CSRF-Token", csrf)]

fn fresh_store(name: text):
    dir_create_all("build/test-artifacts")
    if file_exists(db_path(name)):
        file_delete(db_path(name))
    val store = store_open(db_path(name))
    sale_setup(store)
    fin_setup(store)
    outbox_worker_setup(store)
    store

describe "request-gating — route-level write gate at the dispatcher (item 1)":
    it "denies an authenticated booking role at DISPATCH on POST /fin/period/close":
        val store = fresh_store("writegate")
        val t = tenant_a()
        val agent = booking_a()
        val s = session_for(agent, t)
        step("A booking-role session may authenticate but must not close a period")
        val resp = store_app_handle(store, s, t, agent, "POST", "/fin/period/close", bearer_headers(), "end=1000&now=1001&idem=bk1")
        step("Rejected 403 — and the denial detail proves it was the dispatcher gate, not the command")
        expect(http_status_code(resp.status)).to_equal(403)
        expect(resp.body.contains("write-gate:finance.period.close")).to_be(true)
        store_close(store)

    it "lets an authorized admin role through the write gate to the guarded command":
        val store = fresh_store("writegate_ok")
        val t = tenant_a()
        val admin = admin_a()
        val s = session_for(admin, t)
        step("admin satisfies the same policy the command enforces -> passes the gate and closes")
        val resp = store_app_handle(store, s, t, admin, "POST", "/fin/period/close", bearer_headers(), "end=1000&now=1001&idem=ad1")
        expect(http_status_code(resp.status)).to_equal(200)
        expect(resp.body.contains("write-gate:")).to_be(false)
        store_close(store)

describe "request-gating — CSRF double-submit for cookie-borne writes (item 2)":
    it "rejects a cookie-borne state-changing request that carries no CSRF token":
        val store = fresh_store("csrf_missing")
        val t = tenant_a()
        val admin = admin_a()
        val s = session_for(admin, t)
        step("An admin who WOULD be authorized is still rejected 403 when the cookie flow lacks a CSRF token")
        val resp = store_app_handle(store, s, t, admin, "POST", "/fin/period/close", cookie_headers(""), "end=1000&now=1001&idem=cm1")
        expect(http_status_code(resp.status)).to_equal(403)
        expect(resp.body.contains("csrf")).to_be(true)
        store_close(store)

    it "rejects a cookie-borne request whose CSRF token does not match the session":
        val store = fresh_store("csrf_wrong")
        val t = tenant_a()
        val admin = admin_a()
        val s = session_for(admin, t)
        step("A forged/stale token is not the session's token -> 403")
        val resp = store_app_handle(store, s, t, admin, "POST", "/fin/period/close", cookie_headers("csrf.tok-someone-else"), "end=1000&now=1001&idem=cw1")
        expect(http_status_code(resp.status)).to_equal(403)
        store_close(store)

    it "admits a cookie-borne request that echoes the session's own CSRF token":
        val store = fresh_store("csrf_ok")
        val t = tenant_a()
        val admin = admin_a()
        val s = session_for(admin, t)
        step("The session's double-submit token in X-CSRF-Token clears the gate and the close runs")
        val resp = store_app_handle(store, s, t, admin, "POST", "/fin/period/close", cookie_headers(csrf_token(s)), "end=1000&now=1001&idem=co1")
        expect(http_status_code(resp.status)).to_equal(200)
        store_close(store)

    it "leaves bearer-only writes (no cookie) exempt so API clients do not regress":
        val store = fresh_store("csrf_bearer")
        val t = tenant_a()
        val admin = admin_a()
        val s = session_for(admin, t)
        step("No Cookie header -> no ambient credential -> CSRF not required")
        val resp = store_app_handle(store, s, t, admin, "POST", "/fin/period/close", bearer_headers(), "end=1000&now=1001&idem=cb1")
        expect(http_status_code(resp.status)).to_equal(200)
        store_close(store)
