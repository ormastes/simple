# codex-system-test
# REQ-001, REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-007,
# REQ-008, REQ-009, REQ-010, REQ-011, REQ-012.
# NFR-001, NFR-004, NFR-006, NFR-007, NFR-008, NFR-009, NFR-010, NFR-012.
use std.spec.*
use app.sspec_maintain.*

describe "SSpec documentization maintenance":
    it "should explain and gate a professional documentization score":
        step("Inspect the SSpec documentization baseline")
        val report = analyze_sspec_text("fixture_spec.spl", professional_fixture())
        expect(report.score.aggregate).to_be_greater_than(79)
        expect(report.score.oracle).to_be_greater_than(79)

        step("Review scored improvement findings")
        expect(report.findings.len()).to_equal(0)

    it "should preview decline apply and repeat safe improvements":
        step("Preview safe mechanical changes")
        val source = incomplete_fixture()
        val preview = preview_sspec_text("fixture_spec.spl", source)
        expect(preview.changed).to_equal(true)
        expect(source.contains("## Purpose and audience")).to_equal(false)

        step("Confirm selected maintenance changes")
        val applied = apply_sspec_text("fixture_spec.spl", source)
        expect(applied.content.contains("## Purpose and audience")).to_equal(true)
        expect(apply_sspec_text("fixture_spec.spl", applied.content).changed).to_equal(false)

    it "should scaffold traceable fail-fast scenarios from a reference specification":
        val scaffold = scaffold_reference_text("reference.md", reference_fixture())
        expect(scaffold.contains("REQ-001")).to_equal(true)
        expect(scaffold.contains("fail(\"TODO: replace generated placeholder with an executable assertion\")")).to_equal(true)

    it "should generate a complete zero-stub operator manual":
        step("Generate and inspect the professional specification manual")
        val manual = render_professional_manual(analyze_sspec_text("fixture_spec.spl", professional_fixture()))
        expect(manual).to_contain("## Purpose and audience")
        expect(manual).to_contain("## Scorecard")
        expect(manual).to_contain("## Evidence and provenance")
        expect(manual).to_contain("## Compatibility and limitations")

fn professional_fixture() -> text:
    "\"\"\"# Feature\n## Purpose and audience\n## Preconditions\n## Operator workflow\n## Scenario narratives\n## Evidence and provenance\n## Compatibility and limitations\nREQ-001\n\"\"\"\nuse std.spec.*\ndescribe \"feature\":\n    it \"works\":\n        step(\"act\")\n        expect(1).to_equal(1)\n"

fn incomplete_fixture() -> text:
    "use std.spec.*\ndescribe \"feature\":\n    it \"works\":\n        expect(1).to_equal(1)\n"

fn reference_fixture() -> text:
    "# Reference\n## REQ-001: visible behavior\nThe tool must report a score.\n"
