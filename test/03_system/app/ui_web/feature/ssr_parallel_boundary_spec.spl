"""# Hosted SSR ownership boundary contract

Hosted SSR dispatch remains synchronous through the canonical HTTP registry.
The process-global renderer state is serialized by one mutex and delegates to
the canonical web layout/Engine2D path; no removed async lifecycle is revived.
"""

use std.spec.*

describe "hosted SSR ownership boundary":
    extern fn rt_file_read_text(path: text) -> text

    it "routes requests through the synchronous HandlerRegistry callback":
        val source = rt_file_read_text(
            "src/lib/gc_async_mut/http_server/ssr_submitter.spl"
        ) ?? ""
        expect(source).to_contain("use std.http_server.handler.{HandlerRegistry}")
        expect(source).to_contain("registry.register(name, _registered_ssr_handler)")
        expect(source).to_contain("render_ssr_request(request, SSR_CONFIG)")

    it "serializes canonical renderer state behind one mutex":
        val source = rt_file_read_text(
            "src/lib/gc_async_mut/http_server/ssr_submitter.spl"
        ) ?? ""
        expect(source).to_contain("SSR_RENDER_GATE: Mutex = mutex_new(0)")
        expect(source).to_contain("mutex_with_lock_keeping(SSR_RENDER_GATE, 0,")
        expect(source).to_contain("simple_web_ssr_render_html_to_pixels(")

    it "delegates rendering to the canonical web layout and Engine2D owners":
        val renderer = rt_file_read_text(
            "src/lib/gc_async_mut/gpu/browser_engine/simple_web_ssr_renderer.spl"
        ) ?? ""
        expect(renderer).to_contain("simple_web_engine2d_resolved_backend_name")
        expect(renderer).to_contain("simple_web_layout_render_html_pixels_engine2d")

    it "does not revive the deleted asynchronous lifecycle":
        val source = rt_file_read_text(
            "src/lib/gc_async_mut/http_server/ssr_submitter.spl"
        ) ?? ""
        expect(source.contains("multicore_green_spawn")).to_equal(false)
        expect(source.contains("SSR_RENDERER_OWNER")).to_equal(false)
        expect(source.contains("SsrRenderJob")).to_equal(false)
        expect(source.contains("SSR_ASYNC_CONFIG")).to_equal(false)
