# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag: spec, app, startup_perf
#
# Minimal launch dispatcher gate (perf program 2026-08-10 §5.2 / §11.3):
# the no-op and --help paths of the app root must reach their handler WITHOUT
# initializing dynSMF. Observable: the level-gated trace line
# "dynsmf-trace: startup_session_init" (emitted only when SIMPLE_DYNSMF_TRACE=1)
# must be ABSENT on no-op/--help/--version output and PRESENT on both the
# status command and an ordinary production command.
# (the control run proving the trace mechanism itself works).

use std.spec.step

use std.spec.{describe, it, expect}
use app.io.mod.{file_write}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_env_get(name: text) -> text?
extern fn rt_getpid() -> i64

fn simple_bin() -> text:
    rt_env_get("SIMPLE_BIN") ?? "bin/simple"

fn run_app_root_traced(args: text) -> (text, text, i64):
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_BIN=\"" + simple_bin() + "\"; SIMPLE_DYNSMF_TRACE=1 SIMPLE_LIB=\"$REPO/src\" \"$SIMPLE_BIN\" run \"$REPO/src/app/main.spl\" " + args
    ])

fn run_app_root_traced_from(args: text, work_dir: text) -> (text, text, i64):
    rt_process_run("/bin/sh", [
        "-c",
        "REPO=$(pwd); SIMPLE_BIN=\"" + simple_bin() + "\"; case \"$SIMPLE_BIN\" in /*) ;; *) SIMPLE_BIN=\"$REPO/$SIMPLE_BIN\" ;; esac; cd \"" + work_dir + "\" && SIMPLE_DYNSMF_TRACE=1 SIMPLE_DYNSMF=0 SIMPLE_DYNSMF_DISABLE=poison_pack SIMPLE_DYNLOAD='malformed env poison' SIMPLE_LIB=\"$REPO/src\" \"$SIMPLE_BIN\" run \"$REPO/src/app/main.spl\" " + args
    ])

describe "app root minimal launch dispatcher":
    # @manual scenario evidence
    it "control: --dynsmf-status DOES initialize dynSMF (trace line present)":
        # @req REQ-SSPEC-SYSTEM
        step("control: --dynsmf-status DOES initialize dynSMF (trace line present)")
        val (out, err, code) = run_app_root_traced("--dynsmf-status")
        expect(code).to_equal(0)
        expect(out).to_contain("dynsmf-trace: startup_session_init")

    it "no-op startup does not initialize dynSMF":
        # @req REQ-SSPEC-SYSTEM
        step("no-op startup does not initialize dynSMF")
        val (out, err, code) = run_app_root_traced("")
        expect(code).to_equal(0)
        expect(out).to_equal("")

    it "--help does not initialize dynSMF":
        # @req REQ-SSPEC-SYSTEM
        step("--help does not initialize dynSMF")
        val (out, err, code) = run_app_root_traced("--help")
        expect(code).to_equal(0)
        expect(out).to_contain("USAGE:")
        expect(out.contains("dynsmf-trace: startup_session_init")).to_equal(false)

    it "--version does not initialize dynSMF":
        val (out, err, code) = run_app_root_traced("--version")
        expect(code).to_equal(0)
        expect(out).to_contain("Simple app root entrypoint")
        expect(out.contains("dynsmf-trace: startup_session_init")).to_equal(false)

    it "ordinary non-fast-path commands initialize config-aware dynSMF":
        val (out, err, code) = run_app_root_traced("ordinary-command")
        expect(code).to_equal(1)
        expect(out).to_contain("dynsmf-trace: startup_session_init")

    it "keeps the hard -- boundary ahead of component option interception":
        val (out, err, code) = run_app_root_traced("-- --component-status")
        expect(code).to_equal(1)
        expect(out).to_contain("error: unknown option: --")
        expect(out.contains("component startup error:config_file_not_configured")).to_equal(false)
