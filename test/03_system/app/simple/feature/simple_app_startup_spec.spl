# Purpose and audience: executable specification evidence for the owning engineering team.
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# codex-system-test
#
# Simple app startup policy system spec.

use std.spec.*
use app.startup.launch_metadata.{
    LaunchMetadata,
    launch_metadata_for_native_build,
    startup_detect_launch_kind,
    launch_metadata_for_simpleos_path,
    render_launch_metadata_sidecar,
    render_native_launch_metadata_trailer,
    parse_launch_metadata_sidecar,
    parse_launch_metadata_from_smf_bytes,
    retained_smf_launch_metadata_v1,
    parse_launch_metadata_from_native_bytes,
    has_native_launch_metadata_trailer,
    launch_metadata_sidecar_path,
    startup_normalize_program_args,
    startup_plan_from_metadata,
    startup_feature_summary
}
use app.startup.load_policy_wiring.{startup_load_policy_for_retained_smf_v1}
use compiler.driver.smf_writer.{SmfBuildOptions, Target, generate_smf_with_options}

fn _test_le_u64(bytes: [u8], offset: i64) -> i64:
    (bytes[offset] as i64) |
    ((bytes[offset + 1] as i64) << 8) |
    ((bytes[offset + 2] as i64) << 16) |
    ((bytes[offset + 3] as i64) << 24) |
    ((bytes[offset + 4] as i64) << 32) |
    ((bytes[offset + 5] as i64) << 40) |
    ((bytes[offset + 6] as i64) << 48) |
    ((bytes[offset + 7] as i64) << 56)

fn _test_write_le_u32(mut bytes: [u8], offset: i64, value: i64) -> [u8]:
    # concat([]) makes the mutation fixture-local even on runtimes where an
    # array argument aliases the caller's backing storage.
    var out = bytes.concat([])
    out[offset] = (value & 0xFF).to_u8()
    out[offset + 1] = ((value >> 8) & 0xFF).to_u8()
    out[offset + 2] = ((value >> 16) & 0xFF).to_u8()
    out[offset + 3] = ((value >> 24) & 0xFF).to_u8()
    out

fn _test_write_le_u64(mut bytes: [u8], offset: i64, value: i64) -> [u8]:
    var out = bytes.concat([])
    out[offset] = (value & 0xFF).to_u8()
    out[offset + 1] = ((value >> 8) & 0xFF).to_u8()
    out[offset + 2] = ((value >> 16) & 0xFF).to_u8()
    out[offset + 3] = ((value >> 24) & 0xFF).to_u8()
    out[offset + 4] = ((value >> 32) & 0xFF).to_u8()
    out[offset + 5] = ((value >> 40) & 0xFF).to_u8()
    out[offset + 6] = ((value >> 48) & 0xFF).to_u8()
    out[offset + 7] = ((value >> 56) & 0xFF).to_u8()
    out

fn _retained_smf_for_payload(payload: text) -> [u8]:
    var opts = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
    opts.launch_metadata_bytes = payload.bytes()
    generate_smf_with_options([0xC3], opts)

fn _metadata(kind: text, uses_args: bool, mmap_hint: bool, native_dynlibs: [text], smf_dynlibs: [text]) -> LaunchMetadata:
    LaunchMetadata(
        entry_kind: kind,
        target_os: "test-os",
        target_arch: "test-arch",
        target_abi: "test-abi",
        uses_arg_parser: uses_args,
        mmap_hint: mmap_hint,
        required_native_dynlibs: native_dynlibs,
        required_smf_dynlibs: smf_dynlibs
    )

describe "simple app startup metadata":
    describe "REQ-001: launch kind detection":
        it "should classify SMF files as SMF launches":
            # @req REQ-001
            step("should classify SMF files as SMF launches")
            expect(startup_detect_launch_kind("tool.smf")).to_equal("smf")
            expect(startup_detect_launch_kind("TOOL.SMF")).to_equal("smf")

        it "should classify Simple source files as script launches":
            # @req REQ-001
            step("should classify Simple source files as script launches")
            expect(startup_detect_launch_kind("main.spl")).to_equal("script")
            expect(startup_detect_launch_kind("run.shs")).to_equal("script")

        it "should classify other executable files as native launches":
            # @req REQ-001
            step("should classify other executable files as native launches")
            expect(startup_detect_launch_kind("simple")).to_equal("native")
            expect(startup_detect_launch_kind("app.bin")).to_equal("native")

    describe "REQ-002: file argument parsing":
        it "should add the entry path as argv zero when missing":
            # @req REQ-002
            step("should add the entry path as argv zero when missing")
            val args = startup_normalize_program_args("main.spl", ["one", "two"])
            expect(args[0]).to_equal("main.spl")
            expect(args[1]).to_equal("one")
            expect(args[2]).to_equal("two")

        it "should not duplicate argv zero when caller already passed it":
            # @req REQ-002
            step("should not duplicate argv zero when caller already passed it")
            val args = startup_normalize_program_args("main.spl", ["main.spl", "one"])
            expect(args.len()).to_equal(2)
            expect(args[0]).to_equal("main.spl")
            expect(args[1]).to_equal("one")

        it "should exclude app arg parser code when metadata says the app does not use it":
            # @req REQ-002
            step("should exclude app arg parser code when metadata says the app does not use it")
            val metadata = _metadata("native", false, false, [], [])
            val plan = startup_plan_from_metadata("native_app", ["--unused"], metadata, true, false)
            expect(plan.include_arg_parser).to_equal(false)
            expect(startup_feature_summary(plan)).to_contain("arg_parser=false")

    describe "REQ-003: mmap or cache strategy":
        it "should use host mmap when metadata requests cache and host supports mmap":
            # @req REQ-003
            step("should use host mmap when metadata requests cache and host supports mmap")
            val metadata = _metadata("script", true, true, [], [])
            val plan = startup_plan_from_metadata("main.spl", [], metadata, true, false)
            expect(plan.include_mmap_cache).to_equal(true)
            expect(plan.cache_strategy).to_equal("mmap")

        it "should use SimpleOS VFS prewarm when host mmap is unavailable":
            # @req REQ-003
            step("should use SimpleOS VFS prewarm when host mmap is unavailable")
            val metadata = _metadata("smf", true, true, [], [])
            val plan = startup_plan_from_metadata("app.smf", [], metadata, false, true)
            expect(plan.include_mmap_cache).to_equal(true)
            expect(plan.cache_strategy).to_equal("simpleos_vfs_prewarm")

        it "should make SimpleOS app metadata use the SimpleOS VFS prewarm lane":
            # @req REQ-003
            step("should make SimpleOS app metadata use the SimpleOS VFS prewarm lane")
            val metadata = launch_metadata_for_simpleos_path("/sys/apps/simple.smf")
            val plan = startup_plan_from_metadata("/sys/apps/simple.smf", [], metadata, false, true)
            expect(plan.target_os).to_equal("simpleos")
            expect(plan.include_mmap_cache).to_equal(true)
            expect(plan.cache_strategy).to_equal("simpleos_vfs_prewarm")
            expect(startup_feature_summary(plan)).to_contain("os=simpleos")

        it "should fall back to normal read when no cache support is available":
            # @req REQ-003
            step("should fall back to normal read when no cache support is available")
            val metadata = _metadata("script", true, true, [], [])
            val plan = startup_plan_from_metadata("main.spl", [], metadata, false, false)
            expect(plan.include_mmap_cache).to_equal(false)
            expect(plan.cache_strategy).to_equal("normal_read")

    describe "REQ-004: conditional dynlib loading":
        it "should include no dynlib loader when no dependencies are declared":
            # @req REQ-004
            step("should include no dynlib loader when no dependencies are declared")
            val metadata = _metadata("native", false, false, [], [])
            val plan = startup_plan_from_metadata("native_app", [], metadata, true, false)
            expect(plan.include_dynlib_loader).to_equal(false)
            expect(plan.load_native_dynlibs.len()).to_equal(0)
            expect(plan.load_smf_dynlibs.len()).to_equal(0)

        it "should load native dynlibs declared by native build metadata":
            # @req REQ-004
            step("should load native dynlibs declared by native build metadata")
            val metadata = _metadata("native", false, false, ["libsimple_gui.dylib"], [])
            val plan = startup_plan_from_metadata("native_app", [], metadata, true, false)
            expect(plan.include_dynlib_loader).to_equal(true)
            expect(plan.load_native_dynlibs[0]).to_equal("libsimple_gui.dylib")

        it "should load SMF dynlibs declared by SMF metadata":
            # @req REQ-004
            step("should load SMF dynlibs declared by SMF metadata")
            val metadata = _metadata("smf", true, true, [], ["/sys/lib/gui_hot.smf"])
            val plan = startup_plan_from_metadata("app.smf", ["app.smf"], metadata, true, false)
            expect(plan.include_dynlib_loader).to_equal(true)
            expect(plan.load_smf_dynlibs[0]).to_equal("/sys/lib/gui_hot.smf")
            expect(plan.program_args[0]).to_equal("app.smf")

    describe "REQ-005: build launch metadata sidecar":
        it "should preserve launch metadata field and dependency order":
            # @req: REQ-001 REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-007
            step("Verify: should preserve launch metadata field and dependency order")
            # evidence(pinned oracle): exact serialized bytes preserve the public sidecar format
            val metadata = _metadata(
                "smf",
                true,
                true,
                ["libfirst.so", "libsecond.so"],
                ["/sys/lib/first.smf", "/sys/lib/second.smf"]
            )
            val expected =
                "simple_launch_metadata:\n" +
                "  entry_kind: \"smf\"\n" +
                "  target_os: \"test-os\"\n" +
                "  target_arch: \"test-arch\"\n" +
                "  target_abi: \"test-abi\"\n" +
                "  uses_arg_parser: true\n" +
                "  mmap_hint: true\n" +
                "  load_policy: \"map_selected_segments\"\n" +
                "  native_dynlib: \"libfirst.so\"\n" +
                "  native_dynlib: \"libsecond.so\"\n" +
                "  smf_dynlib: \"/sys/lib/first.smf\"\n" +
                "  smf_dynlib: \"/sys/lib/second.smf\"\n"
            expect(render_launch_metadata_sidecar(metadata)).to_equal(expected)

        it "should render native build launch metadata as a sidecar":
            # @req REQ-005
            step("should render native build launch metadata as a sidecar")
            val metadata = launch_metadata_for_native_build("host", "x86_64", "native")
            val sidecar = render_launch_metadata_sidecar(metadata)
            expect(sidecar).to_contain("simple_launch_metadata:")
            expect(sidecar).to_contain("entry_kind: \"native\"")
            expect(sidecar).to_contain("uses_arg_parser: false")
            expect(sidecar).to_contain("mmap_hint: false")

        it "should parse sidecar metadata with native and SMF dynlib dependencies":
            # @req REQ-005
            step("should parse sidecar metadata with native and SMF dynlib dependencies")
            val sidecar =
                "simple_launch_metadata:\n" +
                "  entry_kind: \"smf\"\n" +
                "  target_os: \"simpleos\"\n" +
                "  target_arch: \"x86_64\"\n" +
                "  target_abi: \"simpleos\"\n" +
                "  uses_arg_parser: true\n" +
                "  mmap_hint: true\n" +
                "  native_dynlib: \"libhost_gui.dylib\"\n" +
                "  smf_dynlib: \"/sys/lib/gui_hot.smf\"\n"
            val metadata = parse_launch_metadata_sidecar(sidecar, "native")
            val plan = startup_plan_from_metadata("app.smf", ["app.smf"], metadata, false, true)
            expect(metadata.entry_kind).to_equal("smf")
            expect(metadata.target_os).to_equal("simpleos")
            expect(plan.include_dynlib_loader).to_equal(true)
            expect(plan.load_native_dynlibs[0]).to_equal("libhost_gui.dylib")
            expect(plan.load_smf_dynlibs[0]).to_equal("/sys/lib/gui_hot.smf")
            expect(plan.cache_strategy).to_equal("simpleos_vfs_prewarm")

        it "should name sidecars next to the artifact path":
            # @req REQ-005
            step("should name sidecars next to the artifact path")
            expect(launch_metadata_sidecar_path("build/app")).to_equal("build/app.simple_launch.sdn")

    describe "REQ-006: embedded SMF launch metadata":
        it "should parse embedded SMF metadata for SimpleOS startup":
            # @req REQ-006
            step("should parse embedded SMF metadata for SimpleOS startup")
            var opts = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
            val sidecar =
                "simple_launch_metadata:\n" +
                "  entry_kind: \"smf\"\n" +
                "  target_os: \"simpleos\"\n" +
                "  target_arch: \"multiarch\"\n" +
                "  target_abi: \"simpleos\"\n" +
                "  uses_arg_parser: true\n" +
                "  mmap_hint: true\n" +
                "  smf_dynlib: \"/sys/lib/gui_hot.smf\"\n"
            opts.launch_metadata_bytes = sidecar.bytes()

            val smf = generate_smf_with_options([0xC3], opts)
            val retained = retained_smf_launch_metadata_v1(smf, "smf")
            val metadata = parse_launch_metadata_from_smf_bytes(smf, "smf")
            val plan = startup_plan_from_metadata("/sys/apps/simple.smf", ["--open", "doc.spl"], metadata, false, true)

            expect(metadata.entry_kind).to_equal("smf")
            expect(retained.present).to_equal(true)
            expect(retained.ok).to_equal(true)
            expect(metadata.target_os).to_equal("simpleos")
            expect(plan.include_arg_parser).to_equal(true)
            expect(plan.include_mmap_cache).to_equal(true)
            expect(plan.cache_strategy).to_equal("simpleos_vfs_prewarm")
            expect(plan.include_dynlib_loader).to_equal(true)
            expect(plan.load_smf_dynlibs[0]).to_equal("/sys/lib/gui_hot.smf")
            expect(plan.program_args[0]).to_equal("/sys/apps/simple.smf")

            val policy = startup_load_policy_for_retained_smf_v1(
                smf, false, true)
            expect(policy.applicable).to_equal(true)
            expect(policy.ok).to_equal(true)
            expect(policy.decision.cache_strategy).to_equal("simpleos_vfs_prewarm")

        it "distinguishes absent metadata from malformed retained tables":
            val absent_bytes = generate_smf_with_options(
                [0xC3], SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu()))
            val absent = retained_smf_launch_metadata_v1(absent_bytes, "smf")
            expect(absent.present).to_equal(false)
            expect(absent.ok).to_equal(true)
            val absent_policy = startup_load_policy_for_retained_smf_v1(
                absent_bytes, true, false)
            expect(absent_policy.applicable).to_equal(false)
            expect(absent_policy.ok).to_equal(true)

            var opts = SmfBuildOptions.create(Target.x86_64_unknown_linux_gnu())
            opts.launch_metadata_bytes =
                "simple_launch_metadata:\n  entry_kind: \"smf\"\n  load_policy: \"normal\"\n".bytes()
            var malformed = generate_smf_with_options([0xC3], opts)
            val header = malformed.len() - 128
            malformed[header + 16] = 0xFF
            malformed[header + 17] = 0xFF
            val rejected = retained_smf_launch_metadata_v1(malformed, "smf")
            expect(rejected.ok).to_equal(false)
            val rejected_policy = startup_load_policy_for_retained_smf_v1(
                malformed, true, false)
            expect(rejected_policy.applicable).to_equal(true)
            expect(rejected_policy.ok).to_equal(false)
            expect(rejected_policy.reason).to_contain("section_count_invalid")

            var bad_magic = absent_bytes
            val bad_header = bad_magic.len() - 128
            bad_magic[bad_header] = 0
            expect(retained_smf_launch_metadata_v1(bad_magic, "smf").reason).to_equal(
                "smf_magic_invalid")

            var empty_payload = generate_smf_with_options([0xC3], opts)
            val empty_header = empty_payload.len() - 128
            val empty_table = _test_le_u64(empty_payload, empty_header + 20)
            val launch_entry = empty_table + 64
            var size_byte = 0
            while size_byte < 8:
                empty_payload[launch_entry + 16 + size_byte] = 0
                size_byte = size_byte + 1
            expect(retained_smf_launch_metadata_v1(empty_payload, "smf").reason).to_equal(
                "launch_metadata_payload_invalid")

        it "keeps the sidecar compatibility parser permissive but rejects malformed retained payload grammar":
            # Existing sidecars remain compatibility-parsed: unknown fields and
            # noncanonical booleans retain their pre-existing interpretation.
            val compat = parse_launch_metadata_sidecar(
                "ignored: true\nuses_arg_parser: yes\n", "smf")
            expect(compat.uses_arg_parser).to_equal(false)

            val bad_root = _retained_smf_for_payload(
                "launch_metadata:\n  uses_arg_parser: true\n")
            expect(retained_smf_launch_metadata_v1(bad_root, "smf").reason).to_equal(
                "launch_metadata_root_invalid")

            val bad_bool = _retained_smf_for_payload(
                "simple_launch_metadata:\n  uses_arg_parser: yes\n")
            expect(retained_smf_launch_metadata_v1(bad_bool, "smf").reason).to_equal(
                "launch_metadata_uses_arg_parser_invalid")

            val unknown_key = _retained_smf_for_payload(
                "simple_launch_metadata:\n  future_policy: \"yes\"\n")
            expect(retained_smf_launch_metadata_v1(unknown_key, "smf").reason).to_equal(
                "launch_metadata_key_unknown")

            val duplicate_scalar = _retained_smf_for_payload(
                "simple_launch_metadata:\n" +
                "  entry_kind: \"smf\"\n" +
                "  entry_kind: \"smf\"\n")
            expect(retained_smf_launch_metadata_v1(duplicate_scalar, "smf").reason).to_equal(
                "launch_metadata_entry_kind_invalid")

            val missing_required = _retained_smf_for_payload(
                "simple_launch_metadata:\n  entry_kind: \"smf\"\n")
            expect(retained_smf_launch_metadata_v1(missing_required, "smf").reason).to_equal(
                "launch_metadata_required_field_missing")

        it "rejects retained SMF header ambiguity and malformed canonical geometry":
            val canonical_payload = render_launch_metadata_sidecar(
                _metadata("smf", true, true, [], []))
            val valid = _retained_smf_for_payload(canonical_payload)
            expect(retained_smf_launch_metadata_v1(valid, "smf").ok).to_equal(true)
            val header = valid.len() - 128
            val table = _test_le_u64(valid, header + 20)

            var v10 = valid
            v10[header + 5] = 0
            expect(retained_smf_launch_metadata_v1(v10, "smf").reason).to_equal(
                "smf_version_unsupported")

            var ambiguous = valid
            ambiguous[0] = 83
            ambiguous[1] = 77
            ambiguous[2] = 70
            ambiguous[3] = 0
            expect(retained_smf_launch_metadata_v1(ambiguous, "smf").reason).to_equal(
                "smf_header_ambiguous")

            val bad_data_offset = _test_write_le_u32(valid, header + 56, 1)
            expect(retained_smf_launch_metadata_v1(bad_data_offset, "smf").reason).to_equal(
                "smf_data_offset_invalid")

            val bad_alignment = _test_write_le_u32(valid, table + 32, 3)
            expect(retained_smf_launch_metadata_v1(bad_alignment, "smf").reason).to_equal(
                "launch_metadata_section_alignment_invalid")

            val overlapping_symbol_table = _test_write_le_u64(valid, header + 28, table)
            expect(retained_smf_launch_metadata_v1(overlapping_symbol_table, "smf").reason).to_equal(
                "launch_metadata_symbol_table_overlap")

            val overlapping_section = _test_write_le_u64(valid, table + 64 + 8, 0)
            expect(retained_smf_launch_metadata_v1(overlapping_section, "smf").reason).to_equal(
                "launch_metadata_section_overlap")

    describe "REQ-007: embedded native launch metadata":
        it "should parse native launch metadata from the binary trailer":
            # @req REQ-007
            step("should parse native launch metadata from the binary trailer")
            val metadata = launch_metadata_for_native_build("macos", "aarch64", "macho")
            val binary = [0xCF, 0xFA, 0xED, 0xFE].concat(render_native_launch_metadata_trailer(metadata))
            val parsed = parse_launch_metadata_from_native_bytes(binary, "native")
            val plan = startup_plan_from_metadata("build/app", [], parsed, true, false)

            expect(has_native_launch_metadata_trailer(binary)).to_equal(true)
            expect(parsed.entry_kind).to_equal("native")
            expect(parsed.target_os).to_equal("macos")
            expect(parsed.target_arch).to_equal("aarch64")
            expect(parsed.target_abi).to_equal("macho")
            expect(plan.include_arg_parser).to_equal(false)
            expect(plan.include_mmap_cache).to_equal(false)
