use std.io_runtime.{file_read}

describe "native-build intermediate lifecycle contract":
    it "documents and wires explicit retention without cleaning reusable caches":
        val cli = file_read("src/app/io/_CliCompile/compile_targets.spl")
        val policy = file_read("src/app/io/_CliCompile/build_intermediate_policy.spl")
        expect(cli).to_contain("--keep-intermediates")
        expect(cli).to_contain("--print-intermediates")
        expect(cli).to_contain("SIMPLE_KEEP_BUILD_INTERMEDIATES")
        expect(cli).to_contain("native_build_cleanup_stale_intermediates(output)")
        expect(policy).to_contain("NATIVE_BUILD_STALE_INTERMEDIATE_AGE_SECONDS")
        expect(policy).to_contain(".simple-native-build-")
