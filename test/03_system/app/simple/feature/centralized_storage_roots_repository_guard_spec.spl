use std.spec.*

# @manual-title: Centralized Storage Roots Repository Guard
# @manual-summary: New production storage authorities fail before merge while central projections remain legal.
# @evidence-display: links

describe "Centralized storage roots repository guard":
    it "covers every forbidden authority class":
        val guard = file_read("scripts/audit/check-centralized-storage-roots.shs") ?? ""
        expect(guard).to_contain("direct-temp-literal")
        expect(guard).to_contain("direct-storage-environment-read")
        expect(guard).to_contain("ambient-mktemp")
        expect(guard).to_contain("third-storage-root")

    it "checks only new production lines in normal enforcement modes":
        val guard = file_read("scripts/audit/check-centralized-storage-roots.shs") ?? ""
        expect(guard).to_contain("--working|--staged|--changed-from REF|--all|--self-test")
        expect(guard).to_contain("git diff --cached --unified=0")
        expect(guard).to_contain("git diff HEAD --unified=0")
        expect(guard).to_contain("is_production_path")

    it "keeps the reviewed exception surface narrow":
        val guard = file_read("scripts/audit/check-centralized-storage-roots.shs") ?? ""
        expect(guard).to_contain("src/lib/common/storage_roots/*")
        expect(guard).to_contain("src/lib/nogc_sync_mut/storage_roots/*")
        expect(guard).to_contain("*/fixtures/*")
        expect(guard).to_contain("*/vendor/*")

    it "contains an executable mutation-sensitive self-test":
        val guard = file_read("scripts/audit/check-centralized-storage-roots.shs") ?? ""
        val shell_test = file_read("test/01_unit/scripts/centralized_storage_roots_guard_test.shs") ?? ""
        expect(guard).to_contain("--self-test")
        expect(guard).to_contain("expect_rule direct-temp-literal")
        expect(shell_test).to_contain("detector mutation survived self-test")
        expect(shell_test).to_contain("SIMPLE_USER_STORAGE_ROOT")
