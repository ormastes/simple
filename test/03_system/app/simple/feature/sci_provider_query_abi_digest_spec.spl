# codex-system-test
# @req REQ-005 REQ-006 REQ-014

use std.spec.*
use std.nogc_sync_mut.composition.provider_contract.{
    SIMPLE_PROVIDER_OK,
    SIMPLE_PROVIDER_QUERY_V1_SIZE,
    SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE,
    SIMPLE_CLI_COMMAND_V1_INTERFACE,
    SimpleProviderQueryV1,
    SimpleProviderQueryResultV1,
    simple_provider_digest_from_hex_v1,
    simple_provider_digest_to_hex_v1
}
use std.nogc_sync_mut.composition.cli_registry.{
    InProcessCliProviderV1,
    SimpleCliRegistryV1,
    simple_provider_query_in_process_v1
}
use compiler.driver.driver_provider_contract_v1.{
    SIMPLE_COMPILER_DRIVER_V1_INTERFACE,
    SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST,
    simple_compiler_driver_query_v1
}
use os.smf.provider_query_wire.{
    encode_provider_query_result_v1,
    decode_provider_query_result_v1
}
use os.smf.provider_loader.{provider_query_abi_validate_v1}

val ABI_DIGEST: text = "112233445566778899aabbccddeeff00010203040506070890abcdefdeadbeef"
val CLI_ABI_DIGEST: text = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn query_v1(interface_id: u64, host_abi: u64) -> SimpleProviderQueryV1:
    SimpleProviderQueryV1(
        descriptor_size: SIMPLE_PROVIDER_QUERY_V1_SIZE,
        interface_id: interface_id,
        minimum_major: 1,
        minimum_minor: 0,
        host_abi: host_abi,
        target_offset: 0,
        target_length: 0,
        requested_capability_bits: 0,
    )

fn result_v1() -> SimpleProviderQueryResultV1:
    SimpleProviderQueryResultV1(
        status: SIMPLE_PROVIDER_OK,
        provided_major: 1,
        provided_minor: 3,
        descriptor_size: 32,
        interface_handle: 0x0102030405060708,
        provider_context: 9,
        provider_identity_digest: 10,
        implementation_digest: 11,
        abi_digest: simple_provider_digest_from_hex_v1(ABI_DIGEST),
    )

describe "SCI provider-query ABI digest admission":
    # @manual_section: Admit one exact full-width ABI identity
    # @req REQ-005 REQ-006 REQ-014
    it "should round trip all 32 digest bytes and admit only the exact SCI identity":
        """The canonical result retains the original scalar prefix, carries the
        complete SHA-256 identity, and is accepted by the host comparison."""
        step("encode_provider_digest_result")
        val encoded = encode_provider_query_result_v1(result_v1())
        expect(encoded.ok).to_equal(true)
        expect(encoded.bytes.len()).to_equal(SIMPLE_PROVIDER_QUERY_RESULT_V1_SIZE as i64)
        step("verify_provider_digest_identity")
        val decoded = decode_provider_query_result_v1(encoded.bytes)
        expect(decoded.ok).to_equal(true)
        expect(simple_provider_digest_to_hex_v1(decoded.value.abi_digest)).to_equal(ABI_DIGEST)
        expect(provider_query_abi_validate_v1(ABI_DIGEST, decoded.value)).to_equal("")

    # @manual_section: Preserve scalar prefix and digest byte order
    # @req REQ-005 REQ-006
    it "should preserve the compatible scalar prefix and display-order digest endpoints":
        """Fixed offsets prevent a full digest from changing the established
        status, version, descriptor, handle, context, and scalar identities."""
        step("inspect_provider_digest_wire")
        val encoded = encode_provider_query_result_v1(result_v1())
        expect(encoded.ok).to_equal(true)
        expect(encoded.bytes[16]).to_equal(0x08)
        expect(encoded.bytes[23]).to_equal(0x01)
        expect(encoded.bytes[48]).to_equal(0x11)
        expect(encoded.bytes[79]).to_equal(0xef)
        expect(encoded.bytes[80]).to_equal(0)
        expect(encoded.bytes[83]).to_equal(0)

    # @manual_section: Query real provider-result producers
    # @req REQ-005 REQ-014
    it "should emit complete canonical digests from CLI and compiler-driver providers":
        """Both direct provider producers populate the same full-width result
        identity consumed by the loader admission boundary."""
        step("query_provider_digest_producers")
        var registry = SimpleCliRegistryV1.create()
        registry.register_in_process(InProcessCliProviderV1(
            provider_handle: 41,
            context_handle: 7,
            provider_identity_digest: 257,
            implementation_digest: 514,
            abi_digest: CLI_ABI_DIGEST,
            required_capability_bits: 0,
            command_name: "fmt",
            summary: "fixture",
        ))
        val cli = simple_provider_query_in_process_v1(
            registry, 41, query_v1(SIMPLE_CLI_COMMAND_V1_INTERFACE, 1),
        )
        val driver = simple_compiler_driver_query_v1(
            query_v1(SIMPLE_COMPILER_DRIVER_V1_INTERFACE, 0),
        )
        expect(cli.status).to_equal(SIMPLE_PROVIDER_OK)
        expect(simple_provider_digest_to_hex_v1(cli.abi_digest)).to_equal(CLI_ABI_DIGEST)
        expect(driver.status).to_equal(SIMPLE_PROVIDER_OK)
        expect(simple_provider_digest_to_hex_v1(driver.abi_digest)).to_equal(SIMPLE_COMPILER_DRIVER_V1_ABI_DIGEST)

    # @manual_section: Reject malformed or mismatched SCI identities
    # @req REQ-005 REQ-014
    it "should fail closed before admission for malformed and unequal SCI digests":
        """An invalid SCI digest is distinguished from a canonical digest that
        does not equal the provider result; neither diagnostic is success."""
        step("reject_provider_digest_identity")
        val result = result_v1()
        expect(provider_query_abi_validate_v1("not-a-sha256", result)).to_equal("interface-abi-digest-invalid")
        expect(provider_query_abi_validate_v1(
            "222233445566778899aabbccddeeff00010203040506070890abcdefdeadbeef",
            result,
        )).to_equal("provider-query-abi-digest-mismatch")

    # @manual_section: Reject legacy partial writes and dirty reserved bytes
    # @req REQ-006 REQ-014
    it "should reject poison-retaining legacy partial writes and nonzero reserved bytes":
        """The host-owned result buffer is poison-filled. A legacy producer
        that writes only 60 bytes cannot inherit zeroes and appear valid."""
        step("reject_legacy_partial_provider_result")
        val encoded = encode_provider_query_result_v1(result_v1())
        var legacy_partial = [165u8; 84]
        var index = 0
        while index < 60:
            legacy_partial[index] = encoded.bytes[index]
            index = index + 1
        expect(decode_provider_query_result_v1(legacy_partial).diagnostic).to_equal("result-reserved-not-zero")
        var dirty_reserved = encoded.bytes
        dirty_reserved[80] = 1
        expect(decode_provider_query_result_v1(dirty_reserved).diagnostic).to_equal("result-reserved-not-zero")

    # @manual_section: Reject noncanonical result lengths
    # @req REQ-006 REQ-014
    it "should reject legacy short truncated and trailing result records":
        """The decoder accepts exactly 84 bytes. Historical, one-byte-short,
        and trailing-material forms all produce the same stable size failure."""
        step("reject_noncanonical_provider_result_size")
        expect(decode_provider_query_result_v1([0u8; 60]).diagnostic).to_equal("result-wire-size-invalid")
        expect(decode_provider_query_result_v1([0u8; 83]).diagnostic).to_equal("result-wire-size-invalid")
        expect(decode_provider_query_result_v1([0u8; 85]).diagnostic).to_equal("result-wire-size-invalid")
