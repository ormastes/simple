# Public `simple check` directory-target contract.

"""
## Purpose and audience
Purpose: recursively checks every Simple source in a relative directory
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-APP-ChecCliDireCont-001

use std.spec.*
use std.sffi.cli.{cli_get_args}
use std.io_runtime.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != nil and configured != "" and file_exists(configured):
        return configured
    if file_exists("/proc/self/exe"):
        return "/proc/self/exe"
    val args = cli_get_args()
    if args.len() > 0 and file_exists(args[0]):
        return args[0]
    ""

fn run_check(args: [text]) -> (text, text, i32):
    var child_args = ["check"]
    for arg in args:
        child_args.push(arg)
    rt_process_run_timeout(simple_binary(), child_args, 30000)

describe "simple check directory targets":
    it "recursively checks every Simple source in a relative directory":
        step("Verify: recursively checks every Simple source in a relative directory")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check([
            "test/fixtures/pure_simple_tooling/lint_directory",
            "--json"
        ])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("\"status\":\"error\"")
        expect(stdout).to_contain("\"checked\":2")
        expect(stdout).to_contain("\"files\":2")
        expect(stdout).to_contain("\"files_with_errors\":1")

    it "deduplicates overlapping directory and file targets":
        step("Verify: deduplicates overlapping directory and file targets")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check([
            "./test/fixtures/pure_simple_tooling/lint_directory",
            "test/fixtures/pure_simple_tooling/lint_directory/nested/dirty.spl",
            "--json"
        ])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("\"checked\":2")
        expect(stdout).to_contain("\"files\":2")
        expect(stdout).to_contain("\"files_with_errors\":1")

    it "fails repeated empty-directory targets once without inventing files":
        step("Verify: fails repeated empty-directory targets once without inventing files")
        # @req: REQ-APP-ChecCliDireCont-001
        val empty = "test/fixtures/pure_simple_tooling/lint_empty"
        val (stdout, stderr, code) = run_check([empty, empty, "--json"])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("\"checked\":0")
        expect(stdout).to_contain("\"files\":0")
        expect(stdout).to_contain("\"errors\":1")
        expect(stdout).to_contain("\"files_with_errors\":0")

    it "rejects a missing target instead of reporting an empty success":
        step("Verify: rejects a missing target instead of reporting an empty success")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check(["--json"])
        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("\"status\":\"error\"")
        expect(stdout).to_contain("\"checked\":0")
        expect(stdout).to_contain("\"files\":0")
        expect(stdout).to_contain("\"errors\":1")

    it "rejects mixed help before target discovery":
        step("Verify: rejects mixed help before target discovery")
        # @req: REQ-APP-ChecCliDireCont-001
        val missing = "test/fixtures/check/definitely_missing_mixed_help.spl"
        val (stdout, stderr, code) = run_check(["--help", missing])
        expect(code).to_equal(2)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("help cannot be combined with files or other options")
        expect(stdout.contains("file not found")).to_equal(false)

    it "keeps sole help successful without launching a worker":
        step("Verify: keeps sole help successful without launching a worker")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check(["--help"])
        expect(code).to_equal(0)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("Usage: simple check")

    it "rejects help followed by a command-like target":
        step("Verify: rejects help followed by a command-like target")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check(["--help", "check"])
        expect(code).to_equal(2)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("help cannot be combined with files or other options")

    it "keeps zero-argument and direct-worker help semantics aligned":
        step("Verify: keeps zero-argument and direct-worker help semantics aligned")
        # @req: REQ-APP-ChecCliDireCont-001
        val (stdout, stderr, code) = run_check([])
        val worker = file_read("src/app/check/main.spl")
        val validation_pos = worker.find("val option_error = check_option_error(args)")
        val help_pos = worker.find('if args.contains("-h") or args.contains("--help")')

        expect(code).to_equal(1)  # oracle: value fixed by the spec contract
        expect(stdout).to_contain("Usage: simple check")
        expect(validation_pos).to_be_greater_than(-1)
        expect(help_pos).to_be_greater_than(validation_pos)
