use std.spec.{describe, it, expect, step}
use app.io.mod.{file_is_regular_no_follow, file_exists}
use test.fixtures.bootstrap_builder.phase4_acceptance_helpers.{require_phase4_binding, compile_phase4_fixture, phase4_output, run_bound_tool, assert_success_output, assert_failure_diagnostic}

describe "Phase4 loader acceptance":
    describe "REQ-P4-LOADER: produced CLI resolves only available source imports":
        it "should execute a value imported from a sibling source module":
            step("Compile an entry and its imported dependency through the produced full CLI")
            val binding = require_phase4_binding()
            val compile = compile_phase4_fixture(binding, "loader_positive", "loaded-positive")
            expect(compile.2).to_equal(0)
            step("Check the imported function contributes the executed result")
            assert_success_output(run_bound_tool(binding, "loaded-positive", []), "phase4-loader:42")

        it "should preserve an empty text result across two source imports":
            step("Compile the entry and two-level source dependency closure")
            val binding = require_phase4_binding()
            val compile = compile_phase4_fixture(binding, "loader_edge", "loaded-edge")
            expect(compile.2).to_equal(0)
            step("Check the empty imported value does not become a placeholder")
            assert_success_output(run_bound_tool(binding, "loaded-edge", []), "phase4-loader-empty:")

        it "should reject an unavailable import without publishing an executable":
            step("Compile an entry that names a missing dependency")
            val binding = require_phase4_binding()
            val compile = compile_phase4_fixture(binding, "loader_invalid", "loaded-invalid")
            step("Require the missing-import diagnostic and no executable")
            assert_failure_diagnostic(compile, "unresolved import")
            expect(compile.0 + compile.1).to_contain("phase4_missing_dependency_for_acceptance")
            expect(file_exists(phase4_output(binding, "loaded-invalid"))).to_equal(false)
