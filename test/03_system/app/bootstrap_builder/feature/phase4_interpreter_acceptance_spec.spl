use std.spec.{describe, it, expect, step}
use test.fixtures.bootstrap_builder.phase4_acceptance_helpers.{require_phase4_binding, eval_phase4_fixture, assert_success_output, assert_failure_diagnostic}

describe "Phase4 standalone interpreter acceptance":
    describe "REQ-P4-INTERPRETER: produced interpreter evaluates and rejects expressions":
        it "should evaluate multiplication through the produced interpreter":
            step("Bind the actual same-backend Phase4 interpreter executable")
            val binding = require_phase4_binding()
            step("Evaluate the positive expression fixture through its eval CLI")
            assert_success_output(eval_phase4_fixture(binding, "interpreter_positive"), "42")

        it "should preserve zero as a value rather than treating it as absence":
            step("Evaluate the zero-value edge fixture through the produced interpreter")
            val binding = require_phase4_binding()
            assert_success_output(eval_phase4_fixture(binding, "interpreter_edge"), "0")

        it "should reject an undefined name with a runtime diagnostic":
            step("Evaluate an undefined identifier through the produced interpreter")
            val binding = require_phase4_binding()
            step("Require a language error instead of successful placeholder output")
            val result = eval_phase4_fixture(binding, "interpreter_invalid")
            assert_failure_diagnostic(result, "Runtime error")
            expect(result.0 + result.1).to_contain("missing_phase4_binding")
