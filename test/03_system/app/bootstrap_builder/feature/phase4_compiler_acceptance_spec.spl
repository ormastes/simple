use std.spec.{describe, it, expect, step}
use app.io.mod.{file_is_regular_no_follow, file_exists}
use test.fixtures.bootstrap_builder.phase4_acceptance_helpers.{require_phase4_binding, compile_phase4_fixture, phase4_output, run_bound_tool, assert_success_output, assert_failure_diagnostic}

# Executed twice by the managed scope: once per admitted backend.
describe "Phase4 compiler acceptance":
    describe "REQ-P4-COMPILER: produced CLI compiles and rejects source":
        it "should compile and execute a function call with computed output":
            step("Bind the same-backend Phase4 tools and immutable source")
            val binding = require_phase4_binding()
            step("Compile the positive program through the produced full CLI")
            val compile = compile_phase4_fixture(binding, "compiler_positive", "compiled-positive")
            expect(compile.2).to_equal(0)
            expect(file_is_regular_no_follow(phase4_output(binding, "compiled-positive"))).to_equal(true)
            step("Execute the generated binary and check its computed result")
            assert_success_output(run_bound_tool(binding, "compiled-positive", []), "phase4-compiler:42")

        it "should compile and execute a minimal zero-returning entry":
            step("Compile the minimal entry through the produced full CLI")
            val binding = require_phase4_binding()
            val compile = compile_phase4_fixture(binding, "compiler_edge", "compiled-edge")
            expect(compile.2).to_equal(0)
            step("Check successful execution with empty output")
            assert_success_output(run_bound_tool(binding, "compiled-edge", []), "")

        it "should reject malformed source without publishing an executable":
            step("Submit malformed source to the produced full CLI")
            val binding = require_phase4_binding()
            val compile = compile_phase4_fixture(binding, "compiler_invalid", "compiled-invalid")
            step("Require a parser diagnostic rather than a crash or placeholder pass")
            assert_failure_diagnostic(compile, "parse error")
            expect(file_exists(phase4_output(binding, "compiled-invalid"))).to_equal(false)
