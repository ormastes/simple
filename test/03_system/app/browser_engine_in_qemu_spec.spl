# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# @tag:system
# @platform: composite
# @session:mutating
# @arch:x86_64
#
# System spec — directly built baremetal ELFs for browser-related lanes.
#
# This spec is intentionally about arbitrary native execution under QEMU:
# it builds entrypoint ELFs with `native-build` and boots them directly.
# Disk-backed packaged app launch is covered by
# `test/system/simpleos_desktop_disk_boot_spec.spl`.

use std.spec.step

use std.spec
use std.nogc_sync_mut.io.env_ops.{env_get}

extern fn rt_process_run(cmd: text, args: [text]) -> (text, text, i64)
extern fn rt_file_exists(path: text) -> bool

fn artifact_exists(path: text) -> bool:
    rt_file_exists(path)

fn _build_target(lane: text) -> bool:
    val result = rt_process_run("sh", ["scripts/check/build-simpleos-browser-qemu.shs", lane])
    if result[2] != 0:
        print result[0]
        print result[1]
        return false
    true

fn _run_qemu(kernel: text, memory: text, extra: [text], timeout_secs: text) -> text:
    var args = ["-k", "2s", timeout_secs, "qemu-system-x86_64",
        "-machine", "q35", "-cpu", "qemu64", "-serial", "stdio",
        "-display", "none", "-no-reboot", "-m", memory, "-kernel", kernel,
        "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04"]
    for argument in extra:
        args.push(argument)
    val result = rt_process_run("timeout", args)
    result[0] + result[1]

describe "Browser engine in QEMU baremetal ELF execution":
    # @manual scenario evidence

    it "boots the browser probe ELF":
        # @req REQ-SSPEC-SYSTEM
        step("boots the browser probe ELF")
        val output_path = "build/os/simpleos_browser_probe_32.elf"
        expect(_build_target("browser-probe")).to_equal(true)
        expect(artifact_exists(output_path)).to_equal(true)

        val output = _run_qemu(output_path, "384M", [], "5s")
        expect(output.contains("[probe] browser spl_start")).to_equal(true)
        expect(output.contains("FAULT @")).to_equal(false)

    it "boots the desktop probe ELF":
        # @req REQ-SSPEC-SYSTEM
        step("boots the desktop probe ELF")
        val output_path = "build/os/simpleos_desktop_probe_32.elf"
        expect(_build_target("desktop-probe")).to_equal(true)
        expect(artifact_exists(output_path)).to_equal(true)

        val output = _run_qemu(output_path, "384M", [], "5s")
        expect(output.contains("[probe] desktop spl_start")).to_equal(true)
        expect(output.contains("FAULT @")).to_equal(false)

    it "builds and boots the browser software smoke ELF":
        # @req REQ-SSPEC-SYSTEM
        step("builds and boots the browser software smoke ELF")
        val output_path = "build/os/simpleos_browser_soft_32.elf"
        expect(_build_target("browser-soft")).to_equal(true)
        expect(artifact_exists(output_path)).to_equal(true)

        val output = _run_qemu(output_path, "384M", ["-vga", "std"], "15s")
        expect(output.contains("[browser-soft] start")).to_equal(true)
        expect(output.contains("[PASS] browser_soft_entry")).to_equal(true)
        expect(output.contains("TEST PASSED")).to_equal(true)
        expect(output.contains("[FAIL]")).to_equal(false)

    it "runs the lean desktop wrapper through launcher and wm markers":
        # @req REQ-SSPEC-SYSTEM
        step("runs the lean desktop wrapper through launcher and wm markers")
        val output_path = "build/os/simpleos_desktop_e2e_32.elf"
        expect(_build_target("desktop-e2e")).to_equal(true)
        expect(artifact_exists(output_path)).to_equal(true)

        val disk = env_get("SIMPLEOS_BROWSER_DESKTOP_IMAGE") ?? ""
        expect(artifact_exists(disk)).to_equal(true)
        expect(disk.contains(",")).to_equal(false)
        val output = _run_qemu(output_path, "512M", [
            "-vga", "std",
            "-drive", "file={disk},if=none,format=raw,id=browserdisk,snapshot=on",
            "-device", "nvme,drive=browserdisk,serial=browser-e2e"
        ], "15s")
        expect(output.contains("[vfs] mount_failed")).to_equal(false)
        expect(output.contains("[desktop-e2e] spl_start")).to_equal(true)
        expect(output.contains("[desktop-e2e] launcher:ready")).to_equal(true)
        expect(output.contains("[desktop-e2e] shortcut:ok")).to_equal(true)
        expect(output.contains("[desktop-e2e] wm:ok")).to_equal(true)
        expect(output.contains("[desktop-e2e] resident fallback done")).to_equal(true)
        expect(output.contains("[desktop-e2e] remote-grouping:ok")).to_equal(true)
        expect(output.contains("TEST PASSED")).to_equal(true)
        expect(output.contains("TEST FAILED")).to_equal(false)
