"""
## Purpose and audience

Purpose: provide executable acceptance evidence for the inventory-complete,
accessible 4K Simple Web showcase before physical Vulkan and Chrome receipts
are admitted. Audience: renderer owners, release reviewers, and operators who
must distinguish live product behavior from narrower source-contract support.

## Operator workflow

Compose the canonical fixture with the production inventory, capture its live
HTML, select all seven tabs through HostedWebContentSession hit targets, and
exercise Arrow/Home/End plus Enter/Space through the native tab bridge.

## Verification guidance

Acceptance assertions observe the production inventory and BrowserSession DOM.
The retained HTML files are exact live serializations. Folded source-contract
scenarios only protect fail-closed wiring and never prove Vulkan or Chrome.

## Recovery and troubleshooting

For catalog failures, inspect the retained composed HTML and missing feature id.
For input failures, inspect the tab id, live layout rectangle, and DOM snapshot.
For Vulkan/Chrome acceptance, run the external receipt gates in the test plan;
source-contract checks cannot substitute for those measurements.

research: doc/01_research/local/web_renderer_vulkan_4k_showcase_hardening.md
plan: doc/03_plan/sys_test/web_renderer_vulkan_4k_showcase_hardening.md
architecture: doc/04_architecture/web_renderer_vulkan_4k_showcase_hardening.md
design: doc/05_design/web_renderer_vulkan_4k_showcase_hardening.md
"""

# @evidence-display: links

use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read, file_write}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.common.spec.scenario_helpers.{capture_html_text, capture_text}
use std.common.spec.scenario_evidence.{ScenarioCaptureKind}
use os.hosted.hosted_web_content_session.{HostedWebContentSession}
use os.hosted.web_showcase_native_tabs.{
    web_showcase_native_pointer, web_showcase_native_key}
use std.gc_async_mut.gpu.browser_engine.dom_accessors.{
    be_dom_find_by_tag, be_dom_get_attr, be_dom_has_attr}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_debug_layout_by_id}
use std.gc_async_mut.gpu.browser_engine.web_renderable_feature_inventory.*
use std.gc_async_mut.gpu.browser_engine.web_renderable_feature_witness.{
    web_feature_witness_markup}
use std.gc_async_mut.gpu.browser_engine.web_showcase_tabs.{
    WebShowcaseState, web_showcase_state}
use std.gc_async_mut.web.browser_session_runtime.*

val ACCEPTANCE_WIDTH: i32 = 3840
val ACCEPTANCE_HEIGHT: i32 = 2160
val ACCEPTANCE_CAPTURE_DIR = (
    "build/test-artifacts/03_system/app/ui.browser/feature/" +
    "web_renderer_vulkan_4k_showcase_hardening"
)
val NOT_FOUND: i64 = -1

fn acceptance_fixture() -> text:
    val source = file_read(
        "examples/06_io/ui/browser_common_elements_showcase.html") ?? ""
    if source == "":
        fail("canonical web showcase fixture is missing")
    web_renderable_feature_inventory_apply_to_showcase(
        source, web_renderable_feature_inventory())

fn acceptance_session() -> HostedWebContentSession:
    HostedWebContentSession.create_document(
        1701, "simple-showcase://web/standards", acceptance_fixture(),
        ACCEPTANCE_WIDTH, ACCEPTANCE_HEIGHT)

fn retain_html_capture(label: text, filename: text, html: text):
    if not dir_create_all(ACCEPTANCE_CAPTURE_DIR):
        fail("cannot create showcase acceptance capture directory")
    val path = ACCEPTANCE_CAPTURE_DIR + "/" + filename
    if not file_write(path, html):
        fail("cannot retain showcase HTML capture: " + path)
    expect(file_read(path) ?? "").to_equal(html)
    capture_html_text(label, html, path)

fn selected_tab_id(session: HostedWebContentSession) -> text:
    for node in be_dom_find_by_tag(session.browser.dom_root(), "button"):
        if be_dom_get_attr(node, "aria-selected") == "true":
            return be_dom_get_attr(node, "id")
    ""

fn focused_tab_id(session: HostedWebContentSession) -> text:
    for node in be_dom_find_by_tag(session.browser.dom_root(), "button"):
        if (be_dom_get_attr(node, "role") == "tab" and
                be_dom_get_attr(node, "tabindex") == "0"):
            return be_dom_get_attr(node, "id")
    ""

fn active_panel_id(session: HostedWebContentSession) -> text:
    var active = ""
    for node in be_dom_find_by_tag(session.browser.dom_root(), "section"):
        if (be_dom_get_attr(node, "role") == "tabpanel" and
                not be_dom_has_attr(node, "hidden")):
            if active != "":
                return "multiple-active-panels"
            active = be_dom_get_attr(node, "id")
    active

fn require_tab_state(result: Result<WebShowcaseState, text>) -> WebShowcaseState:
    match result:
        Ok(value): value
        Err(message): fail("native tab bridge rejected acceptance input: " + message)

fn select_tab_by_pointer(
    session: HostedWebContentSession, state: WebShowcaseState, tab_id: text
) -> WebShowcaseState:
    val html = session.browser.render_html_document()
    val x = simple_web_layout_debug_layout_by_id(
        html, ACCEPTANCE_WIDTH, ACCEPTANCE_HEIGHT, tab_id, "x").parse_i64() ?? -100
    val y = simple_web_layout_debug_layout_by_id(
        html, ACCEPTANCE_WIDTH, ACCEPTANCE_HEIGHT, tab_id, "y").parse_i64() ?? -100
    val width = simple_web_layout_debug_layout_by_id(
        html, ACCEPTANCE_WIDTH, ACCEPTANCE_HEIGHT, tab_id, "w").parse_i64() ?? 0
    val height = simple_web_layout_debug_layout_by_id(
        html, ACCEPTANCE_WIDTH, ACCEPTANCE_HEIGHT, tab_id, "h").parse_i64() ?? 0
    expect(width).to_be_greater_than(0)
    expect(height).to_be_greater_than(0)
    val px = (x + width / 2).to_i32()
    val py = (y + height / 2).to_i32()
    val pressed = session.dispatch_pointer_at(21, px, py, true)
    val released = session.dispatch_pointer_at(22, px, py, false)
    expect(pressed.semantic_target_id).to_equal(tab_id)
    expect(released.semantic_target_id).to_equal(tab_id)
    require_tab_state(web_showcase_native_pointer(
        session, state, released.semantic_target_id, true))

fn route_key(
    session: HostedWebContentSession, state: WebShowcaseState, keycode: i64
) -> WebShowcaseState:
    val dispatched = session.dispatch_key(31, keycode, true)
    require_tab_state(web_showcase_native_key(
        session, state, dispatched.semantic_target_id, keycode, true))

# @manual_section: Primary catalog acceptance
describe "Production showcase catalog":
    # @capture(html)
    it "should expose every typed HTML and CSS row in its owning tab":
        # @req REQ-WEB4K-001 REQ-WEB4K-002
        step("Compose the canonical showcase with the production inventory")
        val inventory = web_renderable_feature_inventory()
        val html = acceptance_fixture()
        val expected_rows = WEB_HTML_CANONICAL_COUNT + WEB_CSS_CANONICAL_COUNT
        expect(inventory.rows.len()).to_equal(expected_rows)
        expect(web_renderable_count_kind(
            inventory, WEB_FEATURE_HTML)).to_equal(WEB_HTML_CANONICAL_COUNT)
        expect(web_renderable_count_kind(
            inventory, WEB_FEATURE_CSS)).to_equal(WEB_CSS_CANONICAL_COUNT)

        step("Verify every classified row and safe witness in the composed fixture")
        for row in inventory.rows:
            expect(html).to_contain("data-feature-id=\"" + row.id + "\"")
            expect(html).to_contain("data-inventory-tab=\"" + row.showcase_tab + "\"")
            expect(web_feature_witness_markup(
                row.kind, row.name, row.status).len()).to_be_greater_than(0)
            if row.status == WEB_RENDERABLE:
                expect(row.production_owner).to_end_with(".spl")
            elif (row.status == WEB_PARTIAL or row.status == WEB_NONPAINT or
                    row.status == WEB_UNSUPPORTED):
                expect(web_feature_witness_markup(
                    row.kind, row.name, row.status)).to_contain("classification-only")
            else:
                fail("unknown inventory status for " + row.id)

        step("Retain a genuine HTML evidence artifact through the shared facade")
        val evidence = retain_html_capture(
            "Inventory-complete 4K showcase", "catalog.html", html)
        expect(evidence.kind).to_equal(ScenarioCaptureKind.html)
        expect(evidence.mime).to_equal("text/html")
        expect(evidence.body).to_contain("Feature examples and support")
        expect(evidence.path).to_end_with("/catalog.html")

# @manual_section: Native pointer acceptance
describe "Production showcase pointer switching":
    # @capture(html)
    it "should select all seven panels through live layout hit targets":
        # @req REQ-WEB4K-003 REQ-WEB4K-008
        step("Open the composed 3840 by 2160 showcase in the hosted browser")
        var session = acceptance_session()
        var state = web_showcase_state()
        expect(session.failure_reason).to_equal("")
        val generation = session.browser.document_generation().value

        step("Select each tab through pointer press and release")
        for id in [
            "overview", "html", "css-layout", "css-paint",
            "forms-media", "animation", "evidence"
        ]:
            state = select_tab_by_pointer(session, state, "tab-" + id)
            expect(selected_tab_id(session)).to_equal("tab-" + id)
            expect(active_panel_id(session)).to_equal("panel-" + id)
            expect(session.browser.document_generation().value).to_equal(generation)

        step("Retain the final live DOM without replacing the document")
        val evidence = retain_html_capture(
            "Pointer-selected Evidence panel", "pointer-evidence.html",
            session.browser.render_html_document())
        expect(evidence.body).to_contain("Evidence contract")
        expect(selected_tab_id(session)).to_equal("tab-evidence")
        session.close()

# @manual_section: Native keyboard acceptance
describe "Production showcase keyboard switching":
    # @capture(html)
    it "should move focus independently and activate with Enter and Space":
        # @req REQ-WEB4K-003 REQ-WEB4K-008
        step("Open the showcase with Overview focused and selected")
        var session = acceptance_session()
        var state = web_showcase_state()
        expect(selected_tab_id(session)).to_equal("tab-overview")

        step("Move ArrowRight and activate HTML with Enter")
        state = route_key(session, state, 39)
        expect(focused_tab_id(session)).to_equal("tab-html")
        expect(selected_tab_id(session)).to_equal("tab-overview")
        state = route_key(session, state, 13)
        expect(selected_tab_id(session)).to_equal("tab-html")

        step("Move End and activate Evidence with Space")
        state = route_key(session, state, 35)
        expect(focused_tab_id(session)).to_equal("tab-evidence")
        expect(selected_tab_id(session)).to_equal("tab-html")
        state = route_key(session, state, 32)
        val _ = session.dispatch_key(32, 32, false)
        expect(selected_tab_id(session)).to_equal("tab-evidence")
        expect(active_panel_id(session)).to_equal("panel-evidence")

        step("Move Home and ArrowLeft to verify bounded wraparound")
        state = route_key(session, state, 36)
        expect(focused_tab_id(session)).to_equal("tab-overview")
        state = route_key(session, state, 37)
        expect(focused_tab_id(session)).to_equal("tab-evidence")

        step("Retain the keyboard-selected live DOM")
        val evidence = retain_html_capture(
            "Keyboard-selected Evidence panel", "keyboard-evidence.html",
            session.browser.render_html_document())
        expect(evidence.mime).to_equal("text/html")
        expect(evidence.body).to_contain("aria-selected")
        session.close()

# @manual_section: Native publication adverse path
describe "Production showcase atomic publication":
    # @capture(html)
    it "should reject forbidden identity mutation without a partial DOM update":
        # @req REQ-WEB4K-003 REQ-WEB4K-008
        step("Open the showcase and retain the current DOM")
        var session = acceptance_session()
        val identity = match session.browser.current_dom_identity_index():
            Some(value): value
            nil: fail("showcase DOM identity index is missing")
        val route = match identity.route_for_author_id("tab-overview"):
            Some(value): value
            nil: fail("Overview route is missing")
        val before = session.browser.render_html_document()

        step("Publish a mixed valid and forbidden attribute batch")
        val result = session.browser.apply_dom_presentation_attributes([
            BrowserDomPresentationAttribute(
                route: route, name: "aria-selected", value: Some("false")),
            BrowserDomPresentationAttribute(
                route: route, name: "id", value: Some("changed"))
        ])
        match result:
            Ok(_): fail("identity mutation was unexpectedly accepted")
            Err(message):
                expect(message).to_equal("unsupported-presentation-attribute")

        step("Retain evidence that the valid prefix was not committed")
        val after = session.browser.render_html_document()
        val evidence = retain_html_capture(
            "Rejected atomic publication", "atomic-rejection.html", after)
        expect(after).to_equal(before)
        expect(evidence.mime).to_equal("text/html")
        session.close()

# @manual_section: Supporting source contracts, not acceptance
describe "Non-acceptance source-contract support":
    # @manual: folded
    # @capture(text)
    it "should keep the runner and receipt fail closed without claiming Vulkan acceptance":
        # @req REQ-WEB4K-004 REQ-WEB4K-005
        step("Inspect supporting runner and external receipt contracts")
        val runner = file_read("examples/06_io/ui/web_render_file_gui.spl") ?? ""
        val wrapper = file_read("scripts/check/check-web-showcase-4k-receipt.shs") ?? ""
        val evidence = capture_text(
            "Non-acceptance Vulkan source contracts",
            "runner bytes={runner.len()} receipt bytes={wrapper.len()}")
        expect(runner).to_contain("ShowcaseResolution(w: 3840, h: 2160)")
        expect(runner).to_contain("source != \"device_readback\"")
        expect(runner).to_contain("first_complete_frame_under_1s=")
        expect(runner.find("web_standards_showcase status=pass")).to_equal(NOT_FOUND)
        expect(wrapper).to_contain("unsupported-bootstrap-cli")
        expect(wrapper).to_contain("process_max_rss_bytes=")
        expect(wrapper).to_contain("comparison_admitted=false")
        expect(evidence.body).to_contain("runner bytes=")

    # @manual: folded
    # @capture(text)
    it "should keep incomplete Chrome evidence non-admitted":
        # @req REQ-WEB4K-006 REQ-WEB4K-007
        step("Inspect the supporting Chrome comparison contract")
        val chrome = file_read(
            "test/05_perf/web_render_chrome/chrome_runner.spl") ?? ""
        val evidence = capture_text(
            "Non-acceptance Chrome source contract", "runner bytes={chrome.len()}")
        expect(chrome).to_contain("source: \"synthetic\", status: \"PENDING\"")
        expect(chrome).to_contain("\"gpu_backend_status\":\"unverified\"")
        expect(chrome).to_contain("\"comparison_admitted\":false")
        expect(evidence.body).to_contain("runner bytes=")
