# @tag: system, gpu, scheduler, draw_ir
# @evidence-display: links
"""
## Purpose and audience
The production bounded DrawIR queue is what a browser/UI surface hands its
frames to. This manual is for the engineers accepting that surface: it shows
deferred admission, strict refusal with no CPU degrade, terminal routing, and
the retained compatibility dispatch. Feature IDs: gpu_scheduler_hardening.
Category: Application.
## Operator workflow
SIMPLE_LIB=src bin/simple test test/03_system/app/ui.browser/feature/gpu_scheduler_hardening_gpu_resident_rendering_spec.spl
## Compatibility and limitations
Runs on every host with no device attached. It proves deferred admission and
terminal routing behavior only. It does not claim a native fence, physical
device execution, presentation, or GPU residency.
## Verification guidance and troubleshooting
A RED here means the accepted queue contract changed. Queue routing is not
device-execution evidence; fix the seam or the caller, never the spec.
"""
# Lifecycle: doc/01_research/local/gpu_scheduler_hardening_gpu_resident_rendering.md ; doc/03_plan/ui/gpu_scheduler_hardening_gpu_resident_rendering.md ;
# doc/04_architecture/gpu_scheduler_hardening_gpu_resident_rendering.md ; doc/05_design/gpu_scheduler_hardening_gpu_resident_rendering.md
# @manual_section: primary

use std.spec.*
use common.ui.draw_ir.{DRAW_IR_BACKEND_GPU, draw_ir_batch, draw_ir_embedding_config, draw_ir_rect}
use std.nogc_async_mut.gpu.engine2d.draw_ir_runtime_queue.{engine2d_draw_ir_runtime_queue_dispatch_only, engine2d_draw_ir_runtime_queue_submit_deferred}
use std.nogc_async_mut.gpu.engine2d.host_gpu_event_queue.{engine2d_host_gpu_runtime_complete_pending, engine2d_host_gpu_runtime_drain, engine2d_host_gpu_runtime_queue_with_backend_handle, engine2d_host_gpu_runtime_reset, engine2d_host_gpu_runtime_submit_pending}

val GPU_SCHEDULER_GREEN: u32 = 0xff00ff00u32

fn scheduler_batch(id: text):
    draw_ir_batch(id, DRAW_IR_BACKEND_GPU,
        draw_ir_embedding_config("scheduler-surface", "scheduler-window", 0, 0, 64, 64, 10, 1000, false),
        [draw_ir_rect("scheduler-rect", 1, 1, 20, 20, GPU_SCHEDULER_GREEN)])

describe "GPU scheduler hardening acceptance":
    it "should reserve and submit deferred DrawIR work without waiting":
        # @req REQ-GPU-SCHED-ASYNC-001 REQ-GPU-SCHED-PROOF-001
        step("Reserve an epoch and its completion credit")
        engine2d_host_gpu_runtime_reset()
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)
        step("Submit the bounded draw routing metadata")
        val receipt = engine2d_draw_ir_runtime_queue_submit_deferred(scheduler_batch("pending"), true, queue)
        step("Observe pending work without waiting")
        expect(receipt.status).to_equal("queued")
        expect(receipt.packet_id).to_be_greater_than(0)
        expect(receipt.terminal).to_be(false)
        expect(receipt.device_execution_proven).to_be(false)

    it "should publish terminal routing once through the existing provider phase":
        # @req REQ-GPU-SCHED-LIFE-001
        step("Reserve an epoch and its completion credit")
        engine2d_host_gpu_runtime_reset()
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)
        val receipt = engine2d_draw_ir_runtime_queue_submit_deferred(scheduler_batch("terminal-once"), true, queue)
        step("Publish the provider completion")
        val submitted = engine2d_host_gpu_runtime_submit_pending(queue, 1)
        val completed = engine2d_host_gpu_runtime_complete_pending(queue, 1)
        val repeated = engine2d_host_gpu_runtime_complete_pending(queue, 1)
        expect(receipt.accepted).to_be(true)
        expect(submitted.count).to_equal(1)
        expect(completed.count).to_equal(1)
        expect(repeated.count).to_equal(0)

    it "should refuse a GPU route with no device rather than fall back to the CPU":
        # @req REQ-GPU-SCHED-PROFILE-001
        step("Reserve an epoch against a queue whose GPU runtime is unavailable")
        engine2d_host_gpu_runtime_reset()
        val unavailable = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, false, 4096)
        step("Submit the bounded draw routing metadata")
        val receipt = engine2d_draw_ir_runtime_queue_submit_deferred(scheduler_batch("strict-refusal"), true, unavailable)
        step("Read the refusal instead of a silent CPU degrade")
        expect(receipt.status).to_equal("rejected")
        expect(receipt.terminal).to_be(true)
        expect(receipt.accepted).to_be(false)
        expect(receipt.packet_id).to_equal(0)
        expect(receipt.diagnostic).to_contain("no CPU fallback")

    it "should preserve immediate dispatch only as compatibility routing":
        # @req REQ-GPU-SCHED-PAYLOAD-001
        # @req REQ-GPU-SCHED-ASYNC-001 REQ-GPU-SCHED-PROOF-001
        step("Submit the legacy compatibility dispatch")
        engine2d_host_gpu_runtime_reset()
        val queue = engine2d_host_gpu_runtime_queue_with_backend_handle("vulkan", 1, 7, true, 4096)
        val result = engine2d_draw_ir_runtime_queue_dispatch_only(scheduler_batch("compatibility"), true, queue)
        step("Retire resources after native ownership ends")
        val drained = engine2d_host_gpu_runtime_drain(queue, 1)
        expect(result.runtime_dispatch.status).to_equal("dispatched")
        expect(result.runtime_dispatch.dispatched).to_be(true)
        expect(drained.drained).to_equal(0)
        expect(result.runtime_dispatch.diagnostic).to_contain("runtime packet")
