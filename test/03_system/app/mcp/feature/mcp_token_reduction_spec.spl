# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# regression matrix for PR #1510 (fix/mcp-token-and-surface-bugs)

# @req REQ-SSPEC-SYSTEM
# codex-system-test
# @cover src/app/mcp/main_lazy_ctx_tools.spl 0%
# @cover src/app/mcp/main_lazy_query_tools.spl 0%
# @cover src/lib/common/ponytail/audit.spl 0%
"""
# MCP Token Reduction

## Purpose and audience

Release-blocking regression matrix for the six MCP token-reduction behaviors
fixed in PR #1510: capture truncation accounted in `simple_ctx_stats`, a
StrBytes-safe string-array parser for request bodies, `wc -l`-exact ponytail
line counts, kind-filtered search that stays non-empty on BSD grep, a bounded
context surface, and execute head/tail truncation annotated with the indexed
chunk count. It joins the unit-level specs (`ctx_capture_truncation_spec`,
`ctx_parse_string_array_spec`, `pipe_surfaces_spec`, `ponytail_lines_spec`)
with the same handlers driven in-proc — no MCP server is spawned.

## Preconditions

Run from the repository root so the fixture files under `test/` and `src/`
resolve. `bin/simple` (or a probed release binary) must exist for the context
surface scenario; without it that scenario skips itself.

## Operator workflow

Run this spec after ctx tool, query tool, ponytail audit, or telemetry
changes. Read the first failing step and then run the matching unit-level
spec for its retained diagnostics.

## Compatibility and limitations

The context surface scenario shells out to the `simple context` CLI and is
marked slow; every other scenario is fully in-proc. Stats scenarios point
`SIMPLE_CTX_DIR` at a scratch directory so the repo's own `.simple/ctx/` is
never written by a test run.
"""

use std.spec.step

use std.spec.{describe, it, slow_it, expect, step}
use std.io_runtime.{env_set, env_get, dir_create, dir_remove_all, file_exists, file_write, file_read, time_now_unix_micros}
use std.nogc_sync_mut.sffi.system.{process_run_timeout}
use app.mcp.main_lazy_ctx_tools.{handle_simple_ctx_batch_execute, handle_simple_ctx_execute, ctx_run_bounded, ctx_parse_string_array, ctx_stats_text}
use app.mcp.main_lazy_query_tools.{handle_simple_search, handle_simple_pipe}
use std.common.ponytail.audit.{ponytail_audit_source}

fn _fresh_store() -> text:
    var base = env_get("SIMPLE_TEST_TMP") ?? ""
    if base == "":
        base = "build/tmp"
    val dir = base + "/mcp_token_reduction_spec_" + str(time_now_unix_micros())
    dir_remove_all(dir)
    dir_create(dir, true)
    env_set("SIMPLE_CTX_DIR", dir)
    env_set("SIMPLE_CTX_CAPTURE_MAX_BYTES", "")
    dir

# Pull the `capture_truncations` counter out of the stats text.
fn _truncations() -> i64:
    for line in ctx_stats_text().split("\n"):
        if line.starts_with("capture_truncations: "):
            return line.substring(21).to_int() ?? -1
    -1

# Pull the `lines: N` counter out of a ponytail audit report.
fn _reported_lines(report: text) -> i64:
    for line in report.split("\n"):
        if line.starts_with("lines: "):
            return line.substring(7).to_int() ?? -1
    -1

describe "MCP token reduction matrix":
    describe "capture truncation accounting":
        it "should count capture truncations in simple_ctx_stats on both detection paths":
            # @req REQ-SSPEC-SYSTEM
            step("should count capture truncations in simple_ctx_stats on both detection paths")
            _fresh_store()
            step("Run a batch command whose output exceeds capture_bytes")
            val body = "{\"commands\":[\"yes abcdefgh | head -c 20000\"],\"queries\":[],\"source\":\"sys:trunc\",\"capture_bytes\":1024}"
            val r = handle_simple_ctx_batch_execute("1", body)
            expect(r).to_contain("[capture truncated at 1024 bytes]")
            step("Verify the receipt-flag path counts exactly one truncation")
            expect(_truncations()).to_equal(1)  # oracle: one capped capture asserted by this scenario
            step("Verify the runtime-marker fallback path also counts")
            val res = ctx_run_bounded("/bin/sh", ["-c", "yes zzzzzzzz | head -c 20000"], 15000, 512)
            expect(res.truncated).to_equal(true)
            expect(res.stdout).to_contain("[output truncated:")
            expect(_truncations()).to_equal(2)  # oracle: one capped capture per path

    describe "StrBytes-safe request parsing":
        it "should parse a request body carrying non-UTF-8 bytes without a StrBytes crash":
            # @req REQ-SSPEC-SYSTEM
            step("should parse a request body carrying non-UTF-8 bytes without a StrBytes crash")
            _fresh_store()
            step("Send a batch body whose command emits raw non-UTF-8 bytes")
            val body = "{\"commands\":[\"printf 'pre \\377\\376 post\\n'\",\"echo done\"],\"queries\":[],\"source\":\"sys:parse\"}"
            val r = handle_simple_ctx_batch_execute("2", body)
            expect(r).to_contain("[0] exit 0")
            expect(r).to_contain("[1] exit 0")
            step("Verify escaped quotes and backslashes still parse element-wise")
            val parsed = ctx_parse_string_array("[\"a\\\"b\", \"c\\\\d\"]")
            expect(parsed.len()).to_equal(2)
            expect(parsed[0]).to_equal("a\"b")
            expect(parsed[1]).to_equal("c\\d")

    describe "ponytail line counting":
        it "should report wc -l-exact line counts":
            # @req REQ-SSPEC-SYSTEM
            step("should report wc -l-exact line counts")
            val dir = _fresh_store()
            val path = dir + "/fixture.spl"
            val source = "fn a() -> i64:\n    1\n\nfn b() -> i64:\n    2\n"
            file_write(path, source)
            step("Cross-check the ponytail audit report against wc -l")
            val (wc_out, _wc_err, wc_code) = process_run_timeout("sh", ["-c", "wc -l < " + path], 10000)
            expect(wc_code).to_equal(0)
            val wc_lines = wc_out.trim().to_int() ?? -1
            val report = ponytail_audit_source(path, source)
            expect(_reported_lines(report)).to_equal(wc_lines)
            expect(wc_lines).to_be_greater_than(1)  # oracle: the fixture is multi-line

    describe "kind-filtered search on BSD grep":
        it "should keep kind-filtered search non-empty on BSD grep":
            # @req REQ-SSPEC-SYSTEM
            step("should keep kind-filtered search non-empty on BSD grep")
            step("Run a kind=import search over the test tree")
            val r = handle_simple_search("3", "{\"query\":\"ctx_normalize\",\"kind\":\"import\",\"scope\":\"test\"}")
            expect(r).to_contain("use app.mcp.main_lazy_ctx_tools")
            expect(r.contains("No results found")).to_equal(false)
            step("Run a kind=fn search over the app tree")
            val r2 = handle_simple_search("4", "{\"query\":\"ctx_bm25_search\",\"kind\":\"fn\",\"scope\":\"app\"}")
            expect(r2).to_contain("fn ctx_bm25_search")
            expect(r2.contains("No results found")).to_equal(false)

    describe "context surface bound":
        slow_it "should return a real context pack within the 20 second bound":
            # @req REQ-SSPEC-SYSTEM
            step("should return a real context pack within the 20 second bound")
            if not file_exists("bin/simple"):
                return
            step("Request the context surface through the pipe handler and measure the wall time")
            val t0 = time_now_unix_micros()
            val r = handle_simple_pipe("5", "{\"surface\":\"context\",\"file\":\"src/app/mcp/main_lazy_ctx_tools.spl\",\"format\":\"text\"}")
            val elapsed_ms = (time_now_unix_micros() - t0) / 1000
            step("Verify the surface stays bounded and returns a real pack")
            expect(elapsed_ms <= 20000).to_equal(true)  # oracle: 15s per-pass bound plus seed retry headroom
            expect(r).to_contain("context pack")
            expect(r.contains("context pack unavailable")).to_equal(false)

    describe "execute return-cap truncation":
        it "should annotate head/tail truncation with the indexed chunk count":
            # @req REQ-SSPEC-SYSTEM
            step("should annotate head/tail truncation with the indexed chunk count")
            _fresh_store()
            step("Execute a command whose output exceeds the return cap")
            val r = handle_simple_ctx_execute("6", "{\"language\":\"shell\",\"code\":\"seq 1 20000 | sed 's/^/padding-line /'\"}")
            expect(r).to_contain("exit: 0")
            step("Verify the elided middle names the full-output index source")
            expect(r).to_contain("omitted from the middle")
            expect(r).to_contain("indexed as ")
            expect(r).to_contain(" chunk(s): simple_ctx_search")
