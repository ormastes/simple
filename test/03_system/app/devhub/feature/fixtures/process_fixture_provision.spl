# Shared process-boundary fixture provisioning for DevHub system specs.
#
# WHY THIS EXISTS: several DevHub system specs launch the production
# `bin/devhub` wrapper or the mail-cli bash boundary, and both fail closed
# without an admitted environment:
#
#   * bin/devhub admits only a pure-Simple runtime carrying a
#     simple-runtime-provenance-v1 receipt (see
#     scripts/lib/simple-runtime-provenance.shs); the Rust seed is refused
#     by design. No admitted runtime exists on a fresh checkout, so the specs
#     provision an admitted TEST-DOUBLE runtime: a tiny sh executable plus a
#     generated provenance receipt. The wrapper performs its real
#     selection/admission logic; only the binary behind the receipt is a
#     fixture. Its `run` command forwards to the Simple binary executing the
#     spec (SIMPLE_BINARY), so DevHub source behavior under test is real.
#     The fixture is admitted through the wrapper's designed test hook:
#     SIMPLE_HOST_RESOLVER_FIXTURE_MODE=1 SIMPLE_BINARY=<fixture binary>.
#
#   * tools/mail-cli's SDN path requires the compiled production config-json
#     helper selected by MAIL_CONFIG_BIN (CI provisions it via
#     scripts/ci/prepare_mail_config_helper.py). When MAIL_CONFIG_BIN is not
#     already exported, the specs provision a helper fixture that runs the
#     same entrypoint (src/app/mail_credentials/main.spl) through the spec's
#     own Simple engine.
#
# Both provisioners are idempotent: repeated calls rewrite byte-identical
# files, so the provenance receipt's artifact hash stays valid.

use std.spec.{fail}
use app.io.mod.{env_get, cwd, process_run, dir_create_all, file_write}

val ADMITTED_RUNTIME_VERSION = "Simple v0.0.0-devhub-fixture"

fn _host_triple() -> text:
    val (sys_out, _sys_err, sys_code) = process_run("uname", ["-s"])
    val (arch_out, _arch_err, arch_code) = process_run("uname", ["-m"])
    if sys_code != 0 or arch_code != 0:
        return ""
    val sys = sys_out.trim()
    var arch = arch_out.trim()
    if arch == "amd64":
        arch = "x86_64"
    if arch == "arm64":
        arch = "aarch64"
    if arch != "x86_64" and arch != "aarch64":
        return ""
    if sys == "Linux":
        arch + "-unknown-linux-gnu"
    elif sys == "Darwin":
        arch + "-apple-darwin"
    elif sys == "FreeBSD":
        arch + "-unknown-freebsd"
    else:
        ""

fn _sha256(path: text) -> text:
    val (out, err, code) = process_run("sha256sum", [path])
    if code != 0:
        fail("cannot hash fixture artifact " + path + ": " + err)
        return ""
    out.trim().split(" ")[0]

fn _require_dir(path: text) -> bool:
    if dir_create_all(path):
        return true
    fail("cannot create fixture directory " + path)
    false

# Provisions (idempotently) an admitted test-double Simple runtime under
# `root` and returns its absolute binary path. The returned path must be
# exported as SIMPLE_BINARY together with
# SIMPLE_HOST_RESOLVER_FIXTURE_MODE=1 when invoking bin/devhub.
pub fn provision_admitted_runtime(root: text) -> text:
    val engine = env_get("SIMPLE_BINARY")
    if engine == "":
        fail("SIMPLE_BINARY is unset; cannot build the admitted test-double runtime without the Simple engine that executes this spec")
        return ""
    val triple = _host_triple()
    if triple == "":
        fail("unsupported host for the admitted test-double runtime (need uname -s/-m for Linux/Darwin/FreeBSD x86_64/aarch64)")
        return ""
    if not _require_dir(root):
        return ""
    val binary = root + "/simple"
    val script = "#!/bin/sh\n" +
        "# Admitted test-double runtime for bin/devhub system specs. The\n" +
        "# provenance receipt beside this file is generated by\n" +
        "# test/03_system/app/devhub/feature/fixtures/process_fixture_provision.spl.\n" +
        "# Only `run` touches the real engine; the probes answer directly.\n" +
        "case \"${1:-}\" in\n" +
        "  --version)\n" +
        "    printf '%s\\n' '" + ADMITTED_RUNTIME_VERSION + "' ;;\n" +
        "  --help)\n" +
        "    printf '%s\\n' 'Simple test-double runtime'\n" +
        "    printf '%s\\n' 'deployed commands: simple test, simple run' ;;\n" +
        "  run)\n" +
        "    shift\n" +
        "    unset SIMPLE_EXECUTION_MODE SIMPLE_RUNTIME_MODE SIMPLE_MCDC_MODE\n" +
        "    unset SIMPLE_MCDC_MODE_ERROR SIMPLE_DI_TEST SIMPLE_SYSTEM_TEST\n" +
        "    unset SIMPLE_TEST_BINARY SIMPLE_TEST_RESULT_FILE SIMPLE_TIMEOUT_SECONDS\n" +
        "    exec \"" + engine + "\" \"$@\" ;;\n" +
        "  *) exit 2 ;;\n" +
        "esac\n"
    if not file_write(binary, script):
        fail("cannot write test-double runtime " + binary)
        return ""
    val (_chmod_out, chmod_err, chmod_code) = process_run("chmod", ["+x", binary])
    if chmod_code != 0:
        fail("cannot chmod +x test-double runtime " + binary + ": " + chmod_err)
        return ""
    val sha = _sha256(binary)
    if sha == "":
        return ""
    val receipt = binary + ".provenance.env"
    if not file_write(receipt,
            "schema=simple-runtime-provenance-v1\n" +
            "status=admitted\n" +
            "implementation=pure-simple\n" +
            "artifact_sha256=" + sha + "\n" +
            "target_triple=" + triple + "\n" +
            "version_output=" + ADMITTED_RUNTIME_VERSION + "\n" +
            "producer=devhub-system-spec-fixture\n" +
            "evidence=test-double runtime forwarding run to the spec engine\n"):
        fail("cannot write provenance receipt " + receipt)
        return ""
    binary

# Returns MAIL_CONFIG_BIN when the environment already provides the compiled
# production helper; otherwise provisions (idempotently) a helper fixture
# under `root` that runs the same entrypoint through the spec's own Simple
# engine, and returns its absolute path.
pub fn provision_mail_config_helper(root: text) -> text:
    val existing = env_get("MAIL_CONFIG_BIN")
    if existing != "":
        return existing
    val engine = env_get("SIMPLE_BINARY")
    if engine == "":
        fail("MAIL_CONFIG_BIN is unset and SIMPLE_BINARY is unset; cannot provision the mail config-json helper fixture")
        return ""
    if not _require_dir(root):
        return ""
    val helper = root + "/mail-config-json"
    val script = "#!/bin/sh\n" +
        "# Test-double mail config-json helper: runs the production\n" +
        "# entrypoint src/app/mail_credentials/main.spl through the Simple\n" +
        "# engine that executed the spec. CI lanes export the natively\n" +
        "# compiled MAIL_CONFIG_BIN instead (see\n" +
        "# scripts/ci/prepare_mail_config_helper.py); a compiled helper is\n" +
        "# silent on stderr apart from its own error codes, so the fixture\n" +
        "# filters the engine's startup diagnostics and keeps everything\n" +
        "# else, and preserves the exit code.\n" +
        "# The test runner's SIMPLE_* control vars must not reach the engine:\n" +
        "# they select interpreter/test modes that change code generation.\n" +
        "unset SIMPLE_EXECUTION_MODE SIMPLE_RUNTIME_MODE SIMPLE_MCDC_MODE\n" +
        "unset SIMPLE_MCDC_MODE_ERROR SIMPLE_DI_TEST SIMPLE_SYSTEM_TEST\n" +
        "unset SIMPLE_TEST_BINARY SIMPLE_TEST_RESULT_FILE SIMPLE_TIMEOUT_SECONDS\n" +
        "# Keep the engine's compile cache out of the spec's fake HOME.\n" +
        "mkdir -p \"" + root + "/engine-cache\"\n" +
        "SIMPLE_CACHE=\"" + root + "/engine-cache\"\n" +
        "XDG_CACHE_HOME=\"" + root + "/engine-cache/xdg\"\n" +
        "export SIMPLE_CACHE XDG_CACHE_HOME\n" +
        "noise=$(mktemp \"${TMPDIR:-/tmp}/mail-config-json.XXXXXX\")\n" +
        "\"" + engine + "\" run \"" + cwd() + "/src/app/mail_credentials/main.spl\" \"$@\" 2>\"$noise\"\n" +
        "status=$?\n" +
        "grep -v -e '^warning' -e '^\\[gc-warning\\]' -e '^\\[engine-demotion\\]' \"$noise\" >&2 || true\n" +
        "rm -f \"$noise\"\n" +
        "exit $status\n"
    if not file_write(helper, script):
        fail("cannot write mail config-json helper " + helper)
        return ""
    val (_chmod_out, chmod_err, chmod_code) = process_run("chmod", ["+x", helper])
    if chmod_code != 0:
        fail("cannot chmod +x mail config-json helper " + helper + ": " + chmod_err)
        return ""
    helper
