default_account: work
accounts:
  work:
    provider: other
    protocol: pop3
    email: alice@example.test
    pop3_server: pop.example.test
    pop3_port: 995
    tls: implicit
    password_cmd: "printf fixture-password"
  personal:
    provider: other
    protocol: imap
    email: personal@example.test
    imap_server: imap.example.test
    imap_port: 993
    tls: implicit
    password_cmd: "printf personal-fixture"
