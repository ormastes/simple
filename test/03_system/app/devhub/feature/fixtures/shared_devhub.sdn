confluence:
  url: https://unrelated.example/wiki
  token_env: UNRELATED_CONFLUENCE_TOKEN
jira:
  project: UNRELATED
email:
  default_account: nested-work
  accounts:
    nested-work:
      provider: other
      protocol: pop3
      email: nested@example.test
      pop3_server: pop.example.test
      pop3_port: 995
      tls: implicit
      password_cmd: "printf nested-fixture-password"
