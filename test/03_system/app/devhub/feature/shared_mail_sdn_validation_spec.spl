# codex-system-test
# @req REQ-007
# Error scenarios extracted unchanged after their first successful Phase 1 run.
use std.spec.*
use std.spec.step
use app.devhub.email_config_sdn.{parse_email_sdn_json}

fn assert_config_error(source: text, expected: text):
    match parse_email_sdn_json(source):
        case Ok(_):
            fail("invalid SDN was accepted")
        case Err(code):
            expect(code).to_equal(expected)
            expect(code.contains("sensitive-fixture")).to_be(false)

describe "REQ-007: malformed shared mail configuration":
    it "should reject literal secrets with a stable redacted diagnostic":
        step("Load shared configuration")
        step("Resolve the requested service")
        step("Execute the request")
        assert_config_error("accounts:\n  work:\n    password: sensitive-fixture\n", "MAIL_CONFIG_SECRET_LITERAL")
        step("Check response and redaction")

    it "should reject malformed SDN instead of silently selecting another format":
        step("Load shared configuration")
        step("Resolve the requested service")
        step("Execute the request")
        assert_config_error("accounts:\n  work:\n    email: \"sensitive-fixture\n", "MAIL_CONFIG_SYNTAX")
        step("Check response and redaction")

    it "should reject an out of range port before account dispatch":
        step("Load shared configuration")
        step("Resolve the requested service")
        step("Execute the request")
        assert_config_error("accounts:\n  work:\n    protocol: pop3\n    pop3_port: 65536\n", "MAIL_CONFIG_PORT")
        step("Check response and redaction")
