# @cover src/lib/nogc_sync_mut/io/windows_process_owner.spl
# codex-system-test
# @req REQ-CLI-006
# @evidence-display: links
use std.spec.*
use std.spec.step
use std.process.run
use std.env.env_get

describe "DevHub native Windows process ownership":
    it "should preserve a child failure and prove the owned tree is empty":
        step("Select the source-matched production owner probe")
        val probe = env_get("DEVHUB_OWNED_PROCESS_PROBE_BIN")
        expect(probe == "").to_equal(false)
        expect(env_get("DEVHUB_PROCESS_PROBE_DIR") == "").to_equal(false)
        step("Launch a real child that exits seven through the production JobObject owner")
        val result = run(probe, [])
        step("Check the child status and authoritative collection evidence")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("leader_reaped=true tree_empty=true exit=7 timed_out=false cancelled=false")
        expect(result.stdout).to_contain("PASS native owned child exit=7 tree_empty=true")
