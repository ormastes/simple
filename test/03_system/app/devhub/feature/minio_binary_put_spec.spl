# @cover src/app/devhub/adapter_minio.spl
# codex-system-test
# @evidence-display: links
use std.spec.*
use std.spec.step
use std.env.env_get
use std.process.run

describe "DevHub binary object upload":
    it "should preserve binary bytes and authenticate real loopback PUT requests":
        step("Select the real compiled production-provider fixture and Python checker")
        val binary = env_get("DEVHUB_MINIO_BINARY_BIN")
        val python = env_get("DEVHUB_PYTHON_BIN")
        if binary == "":
            fail("required DEVHUB_MINIO_BINARY_BIN is unset; provision the source-matched test artifact before running this spec")
            return
        if python == "":
            fail("required DEVHUB_PYTHON_BIN is unset; configure the Python checker before running this spec")
            return
        step("Send binary, file and empty-body uploads to the independent loopback checker")
        val result = run(python, ["test/fixtures/devhub/native_minio_binary_put/verify_loopback.py", binary])
        step("Check exact bytes, hashes, signatures and missing-file refusal")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("PASS native MinIO binary, file, empty and missing-file contracts")
        expect(result.stdout).to_contain("PASS independent loopback byte-exact payload, SHA256, SigV4 and request-count checks")

    it "should retain failure status when health output is JSON":
        step("Select the source-matched DevHub executable and Python checker")
        val binary = env_get("DEVHUB_SYSTEM_BIN")
        val python = env_get("DEVHUB_PYTHON_BIN")
        if binary == "":
            fail("required DEVHUB_SYSTEM_BIN is unset; provision the source-matched test artifact before running this spec")
            return
        if python == "":
            fail("required DEVHUB_PYTHON_BIN is unset; configure the Python checker before running this spec")
            return
        step("Run JSON health against a real loopback HTTP 503 response")
        val result = run(python, ["test/fixtures/devhub/native_minio_binary_put/verify_health_cli.py", binary])
        step("Check the command returns failure together with valid JSON")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("PASS real DevHub unhealthy JSON result preserves nonzero exit")

    it "should send exact form and Unicode payloads through the real compatibility transport":
        step("Select the compiled common transport fixture and Python checker")
        val binary = env_get("DEVHUB_HTTP_CURL_BIN")
        val python = env_get("DEVHUB_PYTHON_BIN")
        if binary == "":
            fail("required DEVHUB_HTTP_CURL_BIN is unset; provision the source-matched test artifact before running this spec")
            return
        if python == "":
            fail("required DEVHUB_PYTHON_BIN is unset; configure the Python checker before running this spec")
            return
        step("Run actual form and UTF-8 POST requests against a local HTTP checker")
        val result = run(python, ["test/fixtures/devhub/native_http_curl/verify_loopback.py", binary])
        step("Check exact wire bytes and rejection of header injection")
        expect(result.exit_code).to_equal(0)
        expect(result.stdout).to_contain("PASS independent real POST form/UTF-8 and zero-request negative controls")
