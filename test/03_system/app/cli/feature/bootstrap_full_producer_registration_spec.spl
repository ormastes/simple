"""Run in a separate fresh process with the canonical full installer."""
use std.spec.{describe, it, expect, step}
use app.cli.bootstrap_backend_installer.{
    bootstrap_install_worker_backends_v1, bootstrap_backend_choices_v1,
    bootstrap_backend_request_error_v1}
use compiler.backend.static_backend_registry.{
    active_static_backend_table_v1, select_static_backend_v1}

describe "Canonical full bootstrap backend compatibility":
    it "retains full plugin registration and unrestricted request forwarding":
        step("Install selected K1 followed by the original full plugin table")
        expect(bootstrap_install_worker_backends_v1()).to_equal(true)
        expect(bootstrap_backend_choices_v1()).to_equal("llvm|cranelift")
        val table = active_static_backend_table_v1()
        expect(table.len()).to_be_greater_than(2)
        for backend in ["llvm", "vhdl", "c", "wasm"]:
            val selected_name = match select_static_backend_v1(backend, table):
                case Ok(entry): entry.plugin.describe().name
                case Err(failure): failure.code()
            expect(selected_name).to_equal(backend)
        step("Preserve full-entry backend and plugin request handling")
        expect(bootstrap_backend_request_error_v1(
            "vhdl", "custom.smf")).to_equal("")
