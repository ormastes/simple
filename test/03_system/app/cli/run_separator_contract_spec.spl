use std.spec.*
use std.io_runtime.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_exists}

extern fn rt_process_run_timeout(cmd: text, args: [text], timeout_ms: i64) -> (text, text, i32)

fn simple_binary() -> text:
    val configured = env_get("SIMPLE_BINARY")
    if configured != nil and configured != "" and file_exists(configured):
        return configured
    "/proc/self/exe"

fn run_probe(args: [text]) -> (text, text, i32):
    rt_process_run_timeout(simple_binary(), ["run", "test/fixtures/cli/run_separator_probe.spl"] + args, 30000)

describe "simple run separator":
    it "consumes evidence before -- and passes post-separator tokens literally":
        val (before_out, _before_err, before_code) = run_probe(["--test-result-file=before.json", "--", "--test-result-file=after.json"])
        expect(before_code).to_equal(0)
        expect(before_out).to_contain("evidence=before.json")
        expect(before_out).to_contain("args=--|--test-result-file=after.json")

    it "does not treat post-separator evidence as an internal option":
        val inherited = env_get("SIMPLE_TEST_RESULT_FILE") ?? ""
        val (after_out, _after_err, after_code) = run_probe(["--", "--test-result-file=after.json"])
        expect(after_code).to_equal(0)
        expect(after_out).to_contain("evidence=" + inherited + "\n")
        expect(after_out).to_contain("args=--|--test-result-file=after.json")
