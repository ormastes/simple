# @req: REQ-APP-X25519MLKEM768-EVIDE-001


# codex-system-test
"""Behavioral fail-closed contract for X25519MLKEM768 GPU evidence dispatch.

These scenarios call the public dispatch boundary. They do not inspect source
text and cannot turn an unavailable GPU backend into passing evidence.
"""

use std.spipe.*
use std.common.crypto.sha256.{sha256_text}
use app.test.x25519mlkem768_gpu_dispatch.{
    X25519MlKem768GpuDispatchRequest, X25519MlKem768GpuDispatchResult,
    x25519_mlkem768_dispatch_gpu}
use lib.common.crypto.x25519_mlkem768.evidence_contract.{
    X25519MlKem768EvidenceBackend, X25519MlKem768EvidenceMode,
    X25519MlKem768EvidenceScope, X25519MlKem768EvidenceStatus,
    X25519MlKem768EvidenceCli}

fn _request(backend: X25519MlKem768EvidenceBackend
        ) -> X25519MlKem768GpuDispatchRequest:
    val manifest = ""
    X25519MlKem768GpuDispatchRequest(
        evidence: X25519MlKem768EvidenceCli(
            fixture_manifest: "fixture.yaml",
            fixture_source: "fixture.spl",
            runner_source: "runner.spl",
            backend: backend,
            mode: X25519MlKem768EvidenceMode.Native,
            scope: X25519MlKem768EvidenceScope.FullOperation,
            batch_size: 1),
        compiler_artifact: "",
        compiler_provenance: "",
        runner_artifact: "",
        runner_source: "",
        runner_provenance: "",
        accelerator_binding: "",
        accelerator_source: "",
        accelerator_source_aux: "",
        accelerator_binary: "",
        accelerator_binary_aux: "",
        fixture_manifest: manifest,
        fixture_manifest_sha256: sha256_text(manifest),
        fixture_source_sha256: "1" * 64,
        runner_source_sha256: "2" * 64)

fn _expect_blocked(result: X25519MlKem768GpuDispatchResult, reason: text):
    expect(result.exit_code).to_equal(1)  # oracle: 1 — pinned expected value for this behavior
    expect(result.receipt.status).to_equal(
        X25519MlKem768EvidenceStatus.Blocked)
    expect(result.receipt.reason).to_equal(reason)
    expect(result.receipt.selected_backend).to_be_nil()
    expect(result.receipt.fallback_used).to_be(false)
    expect(result.receipt.absolute_oracle_match).to_be(false)
    expect(result.receipt.promotion_eligible).to_be(false)
    expect(result.receipt.kernel_invocations).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

use std.spec.step

describe "X25519MLKEM768 GPU evidence dispatch":
    it "should reject a manifest identity mismatch before artifact admission":
        # @req: REQ-APP-X25519MLKEM768-EVIDE-001
        step("Verify: should reject a manifest identity mismatch before artifact admission")
        step("Dispatch a CUDA request whose manifest digest is mismatched")
        var request = _request(X25519MlKem768EvidenceBackend.Cuda)
        request.fixture_manifest_sha256 = "0" * 64
        val result = x25519_mlkem768_dispatch_gpu(request)
        _expect_blocked(
            result, "gpu-fixture-manifest-content-sha256-mismatch")

    it "should reject missing exact-binary admission artifacts":
        # @req: REQ-APP-X25519MLKEM768-EVIDE-001
        step("Verify: should reject missing exact-binary admission artifacts")
        step("Dispatch a CUDA request without a compiler artifact")
        val result = x25519_mlkem768_dispatch_gpu(
            _request(X25519MlKem768EvidenceBackend.Cuda))
        _expect_blocked(result, "missing-compiler-artifact")

    it "should reject auxiliary artifacts on a CUDA row":
        # @req: REQ-APP-X25519MLKEM768-EVIDE-001
        step("Verify: should reject auxiliary artifacts on a CUDA row")
        step("Dispatch a CUDA request with an impossible auxiliary tuple")
        var request = _request(X25519MlKem768EvidenceBackend.Cuda)
        request.compiler_artifact = "compiler"
        request.compiler_provenance = "compiler.provenance.env"
        request.runner_artifact = "runner"
        request.accelerator_binding = "binding"
        request.accelerator_source = "source"
        request.accelerator_binary = "binary"
        request.accelerator_source_aux = "unexpected-source"
        val result = x25519_mlkem768_dispatch_gpu(request)
        _expect_blocked(result, "unexpected-auxiliary-accelerator-artifact")

    it "should require exact Vulkan artifacts before capability admission":
        # @req: REQ-APP-X25519MLKEM768-EVIDE-001
        step("Verify: should require exact Vulkan artifacts before capability admission")
        step("Dispatch a Vulkan row without its exact compiler artifact")
        val result = x25519_mlkem768_dispatch_gpu(
            _request(X25519MlKem768EvidenceBackend.Vulkan))
        _expect_blocked(result, "missing-compiler-artifact")

    it "should keep Metal unavailable without an unpinned binary":
        # @req: REQ-APP-X25519MLKEM768-EVIDE-001
        step("Verify: should keep Metal unavailable without an unpinned binary")
        step("Dispatch an unavailable Metal row")
        val result = x25519_mlkem768_dispatch_gpu(
            _request(X25519MlKem768EvidenceBackend.Metal))
        _expect_blocked(
            result, "metal-binary-digest-not-pinned-by-fixture-manifest")
