# codex-system-test
"""Behavior contract for fail-closed X25519MLKEM768 coverage receipts.

The scenarios call the exported parser, composer, and renderer APIs. They use
typed manifests plus measured decision/condition fixtures; implementation-text
inspection is deliberately outside this system contract.

**Requirements:** `doc/02_requirements/nfr/x25519mlkem768_acceleration.md`

**Plan:** `doc/03_plan/sys_test/x25519mlkem768_acceleration.md`

**Design:** `doc/05_design/x25519mlkem768_acceleration.md`
"""

use std.spipe.*
use app.test.x25519mlkem768_coverage_receipt.{
    X25519MlKem768CoverageReceiptCli,
    X25519MlKem768CoverageRunManifest,
    x25519_mlkem768_compose_coverage_receipt_from_text,
    x25519_mlkem768_parse_coverage_receipt_cli,
    x25519_mlkem768_parse_coverage_run_manifest,
    x25519_mlkem768_render_coverage_receipt,
    x25519_mlkem768_owner_coverage_reason}
use app.test.x25519mlkem768_coverage_contract.{
    x25519_mlkem768_coverage_owner_ids,
    x25519_mlkem768_coverage_owner_paths,
    x25519_mlkem768_coverage_spec_paths}

val _HASH_A: text =
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _owner_ids() -> [text]:
    x25519_mlkem768_coverage_owner_ids()

fn _owner_paths() -> [text]:
    x25519_mlkem768_coverage_owner_paths()

fn _spec_paths() -> [text]:
    x25519_mlkem768_coverage_spec_paths()

fn _critical_condition_count(owner_index: i64) -> i64:
    [1, 2, 2, 2, 3, 2, 4, 1, 28, 12, 2, 5, 1, 3, 1, 1, 1, 5,
     5, 1, 1, 2, 4, 4, 2, 5, 2, 68, 2, 1][owner_index]

fn _valid_cli() -> X25519MlKem768CoverageReceiptCli:
    X25519MlKem768CoverageReceiptCli(
        raw_coverage: "build/evidence/run/coverage.sdn",
        run_manifest: "build/evidence/run/run_manifest.env",
        critical_inventory: "build/evidence/run/critical.psv",
        compiler_artifact: "build/evidence/run/simple",
        runtime_artifact: "build/evidence/run/libsimple_runtime.a",
        output_dir: "build/evidence/run/receipt")

fn _valid_manifest() -> X25519MlKem768CoverageRunManifest:
    var sources: Dict<text, text> = {}
    for path in _owner_paths(): sources[path] = _HASH_A
    var specs: Dict<text, text> = {}
    var aot_paths: Dict<text, text> = {}
    var aot_hashes: Dict<text, text> = {}
    for path in _spec_paths():
        specs[path] = _HASH_A
        aot_paths[path] = "build/evidence/run/aot/" + path.replace("/", "_")
        aot_hashes[path] = _HASH_A
    X25519MlKem768CoverageRunManifest(
        raw_coverage_path: "build/evidence/run/coverage.sdn",
        raw_coverage_sha256: _HASH_A,
        compiler_artifact_path: "build/evidence/run/simple",
        compiler_artifact_sha256: _HASH_A,
        compiler_provenance_path: "build/evidence/run/simple.provenance.env",
        compiler_provenance_sha256: _HASH_A,
        compiler_source_revision: _HASH_A,
        compiler_version_path: "VERSION",
        compiler_version_sha256: _HASH_A,
        compiler_version: "1.0.0-RC",
        runtime_version: "simple-core-c-runtime-source-snapshot-v1",
        execution_environment: "linux-x86_64-llvm-native",
        runtime_artifact_path: "build/evidence/run/libsimple_runtime.a",
        runtime_artifact_sha256: _HASH_A,
        measurement_tool_version: "0.8.1",
        source_sha256: sources, spec_sha256: specs,
        spec_aot_path: aot_paths, spec_aot_sha256: aot_hashes)

fn _valid_manifest_text() -> text:
    var value = "schema=simple-native-coverage-run-v2\n" +
        "status=measured\ninstrumentation_active=true\nfallback_used=false\n" +
        "static_analysis=false\ncoverage_mode=llvm-native\n" +
        "runtime_bundle=core-c-bootstrap\n" +
        "raw_coverage_path=build/evidence/run/coverage.sdn\n" +
        "raw_coverage_sha256={_HASH_A}\n" +
        "compiler_artifact_path=build/evidence/run/simple\n" +
        "compiler_artifact_sha256={_HASH_A}\n" +
        "compiler_provenance_path=build/evidence/run/simple.provenance.env\n" +
        "compiler_provenance_sha256={_HASH_A}\n" +
        "compiler_provenance_schema=simple-bootstrap-stage4-provenance-v2\n" +
        "compiler_artifact_kind=pure-simple-full-cli\n" +
        "compiler_source_revision_kind=content-sha256\n" +
        "compiler_source_revision={_HASH_A}\n" +
        "compiler_source_roots=src/compiler:src/lib:src/app:src/runtime:examples/10_tooling\n" +
        "compiler_completed_gate=stage4-essential-tools-smoke\n" +
        "compiler_version_path=VERSION\ncompiler_version_sha256={_HASH_A}\n" +
        "compiler_version=1.0.0-RC\n" +
        "runtime_version=simple-core-c-runtime-source-snapshot-v1\n" +
        "execution_environment=linux-x86_64-llvm-native\n" +
        "runtime_artifact_path=build/evidence/run/libsimple_runtime.a\n" +
        "runtime_artifact_sha256={_HASH_A}\n" +
        "measurement_tool_version=0.8.1\nsource_count=30\nspec_count=18\n"
    val owners = _owner_paths()
    var owner_index: i64 = 0
    while owner_index < owners.len():
        value = value +
            "source_{owner_index + 1}_path={owners[owner_index]}\n" +
            "source_{owner_index + 1}_sha256={_HASH_A}\n"
        owner_index = owner_index + 1
    val specs = _spec_paths()
    var spec_index: i64 = 0
    while spec_index < specs.len():
        val number = spec_index + 1
        value = value + "spec_{number}_path={specs[spec_index]}\n" +
            "spec_{number}_sha256={_HASH_A}\n" +
            "spec_{number}_aot_path=build/evidence/run/aot/spec_{number}\n" +
            "spec_{number}_aot_sha256={_HASH_A}\n" +
            "spec_{number}_outcome=passed\n"
        spec_index = spec_index + 1
    value

fn _measured_raw(skip_owner: i64 = -1,
        hybrid_false_count: i64 = 1) -> text:
    var decisions = "# Coverage Report\nversion: 1.0\n" +
        "coverage_extension: decision-condition-v1\n\n" +
        "decisions |id, file, line, column, true_count, false_count|\n"
    var conditions = "\nconditions |decision_id, condition_id, file, line, column, true_count, false_count|\n"
    val paths = _owner_paths()
    var index: i64 = 0
    while index < paths.len():
        if index != skip_owner:
            val id = index + 1
            val line = index + 10
            decisions = decisions +
                "    {id}, {paths[index]}, {line}, 1, 1, 1\n"
            var condition_id: i64 = 0
            while condition_id < _critical_condition_count(index):
                val false_count = if index == 8 and condition_id == 0:
                    hybrid_false_count
                else:
                    1
                conditions = conditions +
                    "    {id}, {condition_id}, {paths[index]}, {line}, 1, 1, {false_count}\n"
                condition_id = condition_id + 1
        index = index + 1
    decisions + conditions +
        "\nsummary:\n    total_decisions: 30\n"

fn _critical_inventory() -> text:
    var value = "owner|source_path|line|decision_id|condition_id|outcome\n"
    val ids = _owner_ids()
    val paths = _owner_paths()
    var index: i64 = 0
    while index < ids.len():
        val line = index + 10
        val decision = index + 1
        var condition_id: i64 = 0
        while condition_id < _critical_condition_count(index):
            value = value +
                "{ids[index]}|{paths[index]}|{line}|{decision}|{condition_id}|true\n" +
                "{ids[index]}|{paths[index]}|{line}|{decision}|{condition_id}|false\n"
            condition_id = condition_id + 1
        index = index + 1
    value

describe "X25519MLKEM768 measured coverage receipt behavior":
    it "should accept only the exact provenance-bound CLI and run manifest":
        step("Parse the canonical typed CLI")
        val args = ["--raw-coverage", "build/evidence/run/coverage.sdn",
            "--run-manifest", "build/evidence/run/run_manifest.env",
            "--critical-inventory", "build/evidence/run/critical.psv",
            "--compiler-artifact", "build/evidence/run/simple",
            "--runtime-artifact", "build/evidence/run/libsimple_runtime.a",
            "--output-dir", "build/evidence/run/receipt"]
        expect(x25519_mlkem768_parse_coverage_receipt_cli(args).is_ok()).to_be(true)
        step("Reject duplicate and unbound caller-controlled switches")
        expect(x25519_mlkem768_parse_coverage_receipt_cli(
            args + ["--raw-coverage", "again"]).is_err()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_receipt_cli(
            args + ["--allow-unbound", "true"]).is_err()).to_be(true)
        step("Accept the complete v2 manifest and reject forged execution state")
        val manifest_text = _valid_manifest_text()
        expect(x25519_mlkem768_parse_coverage_run_manifest(
            manifest_text).is_ok()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_run_manifest(
            manifest_text.replace("fallback_used=false", "fallback_used=true")
        ).is_err()).to_be(true)
        expect(x25519_mlkem768_parse_coverage_run_manifest(
            manifest_text.replace("spec_4_outcome=passed", "spec_4_outcome=failed")
        ).is_err()).to_be(true)

    it "should compose measured owner outcomes and render bound provenance":
        step("Compose all thirty measured owners and critical outcomes")
        val result = x25519_mlkem768_compose_coverage_receipt_from_text(
            _valid_cli(), _valid_manifest(), _HASH_A, _measured_raw(),
            _critical_inventory(), _HASH_A)
        expect(result.is_ok()).to_be(true)
        val receipt = result.unwrap()
        expect(receipt.owners.len()).to_equal(30)
        expect(receipt.branch_outcome_total).to_equal(346)
        expect(receipt.branch_outcome_covered).to_equal(346)
        expect(receipt.branch_coverage_basis_points).to_equal(10000)
        expect(receipt.critical_outcome_total).to_equal(346)
        expect(receipt.composer_source_sha256.len()).to_equal(64)
        expect(receipt.contract_source_sha256.len()).to_equal(64)
        step("Render compiler runtime validator composer and contract identity")
        val rendered = x25519_mlkem768_render_coverage_receipt(
            receipt, "build/evidence/run/zero.psv", _HASH_A,
            "build/evidence/run/source.env", _HASH_A,
            "build/evidence/run/spec.env", _HASH_A, _HASH_A)
        expect(rendered).to_contain("measurement_status=measured")
        expect(rendered).to_contain("owner_count=30")
        expect(rendered).to_contain("compiler_provenance_sha256=" + _HASH_A)
        expect(rendered).to_contain("runner_sha256=" + _HASH_A)
        expect(rendered).to_contain(
            "coverage_composer_source_sha256=" + receipt.composer_source_sha256)
        expect(rendered).to_contain(
            "coverage_contract_source_sha256=" + receipt.contract_source_sha256)

    it "should reject a missing owner and an uncovered critical outcome":
        step("Reject a measured stream with an empty owner denominator")
        val missing = x25519_mlkem768_compose_coverage_receipt_from_text(
            _valid_cli(), _valid_manifest(), _HASH_A, _measured_raw(13),
            _critical_inventory(), _HASH_A)
        expect(missing.is_err()).to_be(true)
        expect(missing.unwrap_err().code).to_equal(
            "coverage-owner-denominator-empty")
        step("Reject a required condition outcome with a zero count")
        val uncovered = x25519_mlkem768_compose_coverage_receipt_from_text(
            _valid_cli(), _valid_manifest(), _HASH_A, _measured_raw(-1, 0),
            _critical_inventory(), _HASH_A)
        expect(uncovered.is_err()).to_be(true)
        expect(uncovered.unwrap_err().code).to_equal(
            "critical-branch-below-100-percent")

    it "should enforce the 98 percent threshold for every owner independently":
        step("Accept the boundary and reject a diluted low-coverage owner")
        expect(x25519_mlkem768_owner_coverage_reason(98, 100)).to_equal("")
        expect(x25519_mlkem768_owner_coverage_reason(97, 100)).to_equal(
            "branch-coverage-owner-below-98-percent:9700")
        expect(x25519_mlkem768_owner_coverage_reason(0, 0)).to_equal(
            "coverage-owner-outcome-count-invalid")

    it "should reject malformed measured input before rendering a receipt":
        step("Reject an absent decision-condition extension")
        val malformed = _measured_raw().replace(
            "coverage_extension: decision-condition-v1\n", "")
        val malformed_result = x25519_mlkem768_compose_coverage_receipt_from_text(
            _valid_cli(), _valid_manifest(), _HASH_A, malformed,
            _critical_inventory(), _HASH_A)
        expect(malformed_result.is_err()).to_be(true)
        expect(malformed_result.unwrap_err().code).to_equal(
            "raw-coverage-extension-invalid")
        step("Reject an unbound critical inventory digest")
        val unbound = x25519_mlkem768_compose_coverage_receipt_from_text(
            _valid_cli(), _valid_manifest(), _HASH_A, _measured_raw(),
            _critical_inventory(), "not-a-sha256")
        expect(unbound.is_err()).to_be(true)
        expect(unbound.unwrap_err().code).to_equal(
            "critical-branch-inventory-sha256-invalid")
