# @tag: system, gpu, processing-ir, fault-injection, source-contract

use std.io_runtime.{file_exists, file_read}
use std.spec.{describe, it, expect}

val FAULT_HELPER = "src/lib/gc_async_mut/processing/fault_injection.spl"
val CUDA_EXECUTOR = "src/lib/gc_async_mut/processing/cuda_fill_u32.spl"
val VULKAN_EXECUTOR = "src/lib/gc_async_mut/processing/vulkan_fill_u32.spl"
val METAL_EXECUTOR = "src/lib/gc_async_mut/processing/metal_fill_u32.spl"

val BACKENDS = [
    ["cuda", CUDA_EXECUTOR],
    ["vulkan", VULKAN_EXECUTOR],
    ["metal", METAL_EXECUTOR]
]
val PHASES = ["unavailable", "init", "submit", "readback", "mismatch"]
val FAULT_IMPORT = "use std.gc_async_mut.processing.fault_injection." + "{" + "processing_ir_fault_reason" + "}"

fn _assert_exists_and_read(path: text) -> text:
    expect(file_exists(path)).to_equal(true)
    file_read(path)

fn _phase_guard(backend: text, phase: text) -> text:
    if backend == "cuda" and phase == "readback":
        return "if synced and readback_fault != \"\""
    if backend == "cuda" and phase == "mismatch":
        return "if copied and mismatch_fault != \"\""
    if backend == "vulkan" and phase == "readback":
        return "if dispatch_status == 1 and readback_fault != \"\""
    if backend == "vulkan" and phase == "mismatch":
        return "if read and mismatch_fault != \"\""
    "if " + phase + "_fault != \"\""

fn _assert_guarded_phase(source: text, backend: text, phase: text):
    val call = "val " + phase + "_fault = processing_ir_fault_reason(\"" + backend + "\", \"" + phase + "\")"
    expect(source).to_contain(call + "\n    " + _phase_guard(backend, phase))

fn _assert_cleanup_before_return(source: text, branch_start: text, cleanup: text, return_text: text):
    val start = source.index_of(branch_start)
    expect(start).to_be_greater_than(0)
    val branch = source.slice(start, source.len())
    val cleanup_at = branch.index_of(cleanup)
    val return_at = branch.index_of(return_text)
    expect(cleanup_at).to_be_greater_than(0)
    expect(return_at).to_be_greater_than(cleanup_at)

describe "ProcessingIR GPU executor fault source contract":
    it "imports the shared fault reason helper in every executor":
        expect(file_read(CUDA_EXECUTOR)).to_contain(FAULT_IMPORT)
        for entry in BACKENDS:
            val source = _assert_exists_and_read(entry[1])
            expect(source).to_contain(FAULT_IMPORT)

    it "guards every init, submit, readback, and mismatch phase":
        expect(file_read(METAL_EXECUTOR)).to_contain(
            "processing_ir_fault_reason(\"metal\", \"mismatch\")")
        for entry in BACKENDS:
            val source = _assert_exists_and_read(entry[1])
            for phase in PHASES:
                _assert_guarded_phase(source, entry[0], phase)

    it "requires both the test gate and exact backend phase selection":
        val source = _assert_exists_and_read(FAULT_HELPER)
        expect(source).to_contain(
            "if env_get(\"SIMPLE_GPU_TEST\") != \"1\" or\n       env_get(\"SIMPLE_GPU_FAULT_INJECT\") != target:")
        expect(source).to_contain(
            "if _processing_ir_fault_target != target:\n        _processing_ir_fault_target = target\n        _processing_ir_fault_match_count = 0")
        expect(source).to_contain(
            "_processing_ir_fault_match_count = _processing_ir_fault_match_count + 1")
        expect(source).to_contain(
            "env_get(\"SIMPLE_GPU_FAULT_INJECT_SKIP_MATCHES\") != \"1\" or\n        _processing_ir_fault_match_count > 1")

    it "returns non-owning provenance after resource cleanup":
        val vulkan = file_read(VULKAN_EXECUTOR)
        val metal = file_read(METAL_EXECUTOR)
        expect(vulkan).to_contain("val handle = device_identity")
        expect(metal).to_contain("val handle = identity")
        expect(vulkan.contains("val handle = buffer.handle")).to_equal(false)
        expect(metal.contains("val handle = output")).to_equal(false)

    it "releases exactly the Metal resources owned at each failure boundary":
        val metal = file_read(METAL_EXECUTOR)
        expect(metal).to_contain("fn _processing_metal_cleanup")
        _assert_cleanup_before_return(metal, "if queue == 0:", "_processing_metal_cleanup(device, 0, 0, 0, 0, 0, 0, 0)", "return _processing_metal_failure(reason)")
        _assert_cleanup_before_return(metal, "if shader == 0:", "_processing_metal_cleanup(device, queue, 0, 0, 0, 0, 0, 0)", "return _processing_metal_failure(reason)")
        _assert_cleanup_before_return(metal, "if pipeline == 0:", "_processing_metal_cleanup(device, queue, shader, 0, 0, 0, 0, 0)", "return _processing_metal_failure(reason)")
        val full = "_processing_metal_cleanup(device, queue, shader, pipeline, output, dummy, host, byte_count)"
        _assert_cleanup_before_return(metal, "if output == 0 or dummy == 0 or host == 0:", full, "return _processing_metal_failure(reason)")
        _assert_cleanup_before_return(metal, "if submit_fault != \"\":", full, "return _processing_metal_failure(submit_fault)")
        _assert_cleanup_before_return(metal, "if not dispatched:", full, "return _processing_metal_failure(reason)")
        _assert_cleanup_before_return(metal, "if readback_fault != \"\":", full, "return _processing_metal_failure(readback_fault)")
        _assert_cleanup_before_return(metal, "if not copied:", full, "return _processing_metal_failure(reason)")
        _assert_cleanup_before_return(metal, "if values.len().to_i64() != ir.element_count:", full, "return _processing_metal_failure(\"metal-readback-size-mismatch\")")
        _assert_cleanup_before_return(metal, "if mismatch_fault != \"\":", full, "return _processing_metal_failure(mismatch_fault)")
        _assert_cleanup_before_return(metal, "val handle = identity", full, "ProcessingMetalResult(completed: true")

    it "keeps real CUDA dispatch and readback failures distinct":
        val cuda = file_read(CUDA_EXECUTOR)
        expect(cuda).to_contain("reason: \"cuda-dispatch-failed\"")
        expect(cuda).to_contain("reason: \"cuda-readback-failed\"")
        expect(cuda.contains("cuda-dispatch-or-readback-failed")).to_equal(false)
