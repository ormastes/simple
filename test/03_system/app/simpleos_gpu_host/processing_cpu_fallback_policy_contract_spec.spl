"""
## Purpose and audience
Freezes the SimpleOS GPU host's CPU-fallback policy for the gpu-host
owners: when device work is unavailable or below the calibrated offload
threshold, the daemon executes the processing IR on the CPU oracle, marks
the receipt with the distinct FALLBACK status and CPU readback source, and
never lets a CPU pass masquerade as device provenance. Source-contract
scenarios mediate every shipped-source assertion through genuinely-named
contract locals; validator scenarios drive the real ivshmem receipt
validator and the real measured offload thresholds.
## Operator workflow
src/compiler_rust/target/bootstrap/simple run test/03_system/app/simpleos_gpu_host/processing_cpu_fallback_policy_contract_spec.spl
## Compatibility and limitations
Reads the shipped daemon, protocol, bridge, and runtime sources, so it must
run from a repository checkout; the wrapper scenario documents that the qemu
wrapper does not yet inject --processing-verify-cpu and stays RED until it
does.
## Verification guidance and troubleshooting
A threshold failure means the measured offload calibration moved; a wire-code
failure means the protocol enums drifted; a validator failure means forged
CPU provenance could pass as device work, which is a security defect.
"""
# @tag: system, gpu, simpleos, processing-ir, cpu-fallback, source-contract
# Lifecycle: doc/01_research/domain/gpu_renderer_processing_backends_metal.md ;
# doc/03_plan/sys_test/gpu_renderer_processing_backends.md ;
# doc/04_architecture/compiler/backend/processing_backend.md ;
# doc/05_design/gpu_renderer_processing_backends_metal.md

# @manual_section: processing-cpu-fallback-policy

use std.spec.{describe, it, expect}
use app.io.mod.{file_read, file_exists}
use std.common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_STATUS_FAIL,
    SIMPLEOS_HOST_GPU_STATUS_FALLBACK,
    SIMPLEOS_HOST_GPU_READBACK_CPU,
    SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED,
    SIMPLEOS_HOST_GPU_REASON_OFFLOAD_OVERHEAD,
    SIMPLEOS_HOST_GPU_BACKEND_CUDA
}
use os.lib.gpu_bridge.host_gpu_ivshmem.{
    HostGpuIvshmemReceipt,
    host_gpu_ivshmem_fallback_receipt_valid
}
use app.simpleos_gpu_host.daemon_runner.{simpleos_gpu_processing_min_offload_elements}
use std.common.processing.processing_ir.{
    processing_ir_fill_u32, processing_ir_fill_rect_u32,
    processing_ir_validate, processing_ir_cpu_execute, processing_ir_outputs_equal
}

val HOST = "src/app/simpleos_gpu_host/daemon_runner.spl"
val PROTOCOL = "src/lib/common/gpu/simpleos_host_gpu_protocol.spl"
val RAW = "src/lib/nogc_sync_mut/ptr/raw.spl"
val RAW_RUNTIME = "src/compiler_rust/runtime/src/value/sffi/file_io/file_ops.rs"
val QEMU_WRAPPER = "scripts/os/run_simpleos_qemu.shs"
val GUEST_BRIDGE = "src/os/lib/gpu_bridge/host_gpu_ivshmem.spl"

fn fallback_receipt(status: i64, reason: i64, handle: i64, identity: i64, source: i64, run_id_hash: i64, frame_id: i64) -> HostGpuIvshmemReceipt:
    HostGpuIvshmemReceipt(
        completed: true,
        status: status,
        reason: reason,
        generation: 7,
        native_handle: handle,
        output_addr: 4096u64,
        output_bytes: 64,
        output_checksum: 17,
        elapsed_us: 12,
        readback_source: source,
        device_identity: identity,
        run_id_hash: run_id_hash,
        frame_id: frame_id,
        backend_code: SIMPLEOS_HOST_GPU_BACKEND_CUDA,
        submit_id: 0,
        fence_id: 0,
        fence_signaled: false,
        device_frame_id: 0
    )

describe "SimpleOS processing CPU fallback policy contract":
    it "defaults the CLI to none and accepts only none or cpu":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-CLI-001
        step("Read the daemon CLI parser and pin the fallback flag contract")
        val source = file_read(HOST)
        expect(file_exists(HOST)).to_be(true)
        # @capture: evidence_manifest("cpufallback_cli_contract") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("val processing_fallback = if requested_processing_fallback == \"\": \"none\" else: requested_processing_fallback")
        expect(source).to_contain("if processing_fallback != \"none\" and processing_fallback != \"cpu\":")
        expect(source).to_contain("--processing-fallback must be none or cpu")
        expect(source).to_contain("val processing_fallback_cpu = processing_fallback == \"cpu\"")

    it "passes the fallback boolean into both processing requests":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-PLUMBING-002
        step("Pin both _process_request call sites and the request signature")
        val source = file_read(HOST)
        # @capture: evidence_manifest("cpufallback_request_plumbing") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("_process_request(platform, base, processing_selector, processing_fallback_cpu, processing_verify_cpu, processing_min_offload_elements, [])")
        expect(source).to_contain("_process_request(platform, base, processing_selector, processing_fallback_cpu, processing_verify_cpu, processing_min_offload_elements, retained)")
        expect(source).to_contain("fn _process_request(platform: SimpleOsGpuHostPlatform, base: i64, processing_selector: text, processing_fallback_cpu: bool, processing_verify_cpu: bool, processing_min_offload_elements: i64")

    it "uses measured backend defaults and preserves explicit overrides":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-THRESHOLDS-003
        step("Query the measured offload thresholds and the explicit override handling")
        val source = file_read(HOST)
        # @capture: evidence_manifest("cpufallback_measured_thresholds") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(simpleos_gpu_processing_min_offload_elements("cuda", -1)).to_equal(536870912)  # oracle: measured CUDA crossover at 512M elements
        expect(simpleos_gpu_processing_min_offload_elements("vulkan", -1)).to_equal(65536)  # oracle: measured Vulkan crossover at 64K elements
        expect(simpleos_gpu_processing_min_offload_elements("metal", -1)).to_equal(536870912)  # oracle: measured Metal crossover matches the CUDA calibration
        expect(simpleos_gpu_processing_min_offload_elements("cuda", 0)).to_equal(0)  # oracle: an explicit zero disables the calibration gate
        expect(simpleos_gpu_processing_min_offload_elements("cuda", 123)).to_equal(123)  # oracle: explicit overrides pass through verbatim
        expect(source).to_contain("val effective_min_offload_elements = simpleos_gpu_processing_min_offload_elements(backend, processing_min_offload_elements)")
        expect(source).to_contain("use std.common.text." + "{" + "parse_i64" + "}")
        expect(source).to_contain("parse_i64(requested_processing_min_offload_elements)")
        expect(source).to_contain("not args.contains(\"--processing-min-offload-elements=\")")
        expect(source).to_contain("processing_min_offload_elements.to_text() == requested_processing_min_offload_elements")
        expect(source).to_contain("if not processing_min_offload_elements_valid:")
        expect(source).to_contain("--processing-min-offload-elements must be a non-negative integer")

    it "keeps fallback wire codes distinct and exported":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-WIRE-004
        step("Compare the live wire codes against the shipped protocol header")
        val source = file_read(PROTOCOL)
        expect(file_exists(PROTOCOL)).to_be(true)
        # @capture: evidence_manifest("cpufallback_wire_codes") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(SIMPLEOS_HOST_GPU_STATUS_FALLBACK).to_equal(4)  # oracle: STATUS_FALLBACK wire code frozen in the protocol header
        expect(SIMPLEOS_HOST_GPU_READBACK_CPU).to_equal(2)  # oracle: READBACK_CPU wire code frozen in the protocol header
        expect(SIMPLEOS_HOST_GPU_STATUS_FALLBACK != SIMPLEOS_HOST_GPU_READBACK_CPU).to_equal(true)  # oracle: status and readback namespaces never collide
        expect(source).to_contain("val SIMPLEOS_HOST_GPU_STATUS_FALLBACK: i64 = 4")
        expect(source).to_contain("val SIMPLEOS_HOST_GPU_READBACK_CPU: i64 = 2")
        expect(source).to_contain("export SIMPLEOS_HOST_GPU_STATUS_FALLBACK, SIMPLEOS_HOST_GPU_READBACK_DEVICE, SIMPLEOS_HOST_GPU_READBACK_CPU")
        expect(SIMPLEOS_HOST_GPU_REASON_OFFLOAD_OVERHEAD).to_equal(18)  # oracle: OFFLOAD_OVERHEAD reason code frozen in the protocol header
        expect(source).to_contain("val SIMPLEOS_HOST_GPU_REASON_OFFLOAD_OVERHEAD: i64 = 18")
        expect(source).to_contain("export SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, SIMPLEOS_HOST_GPU_REASON_OFFLOAD_OVERHEAD")

    it "writes the CPU oracle with zero native provenance and fallback status":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-ORACLE-005
        step("Pin the CPU fallback writer and its zero-provenance finish call")
        val source = file_read(HOST)
        # @capture: evidence_manifest("cpufallback_oracle_writer") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("val checksum = _write_pixels(base, oracle, ir.element_count)")
        expect(source).to_contain("_finish(base, generation, SIMPLEOS_HOST_GPU_STATUS_FALLBACK, reason, 0,")
        expect(source).to_contain("SIMPLEOS_HOST_GPU_READBACK_CPU, 0)")
        expect(source).to_contain("fn _processing_cpu_fallback(base: i64, generation: i64, reason: i64, ir: ProcessingIr)")
        expect(source).to_contain("val oracle = processing_ir_cpu_execute(ir)")

    it "bypasses device work only for calibrated CPU fallback":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-GATE-006
        step("Require the calibrated gate to precede the device start in the daemon source")
        val source = file_read(HOST)
        val policy = source.index_of("if processing_fallback_cpu and effective_min_offload_elements > 0 and element_count < effective_min_offload_elements:")
        val device = source.index_of("val device_started = time_now_nanos()")
        # @capture: evidence_manifest("cpufallback_gate_order") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(policy).to_be_greater_than(0)
        expect(policy).to_be_less_than(device)
        expect(source).to_contain("_processing_cpu_fallback(base, generation, SIMPLEOS_HOST_GPU_REASON_OFFLOAD_OVERHEAD")
        expect(source).to_contain("effective_min_offload_elements > 0")
        expect(source).to_contain("element_count < effective_min_offload_elements")

    it "keeps executor failure and mismatch fallback behavior":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-DEGRADED-007
        step("Pin the executor-failure and checksum-mismatch fallback arms")
        val source = file_read(HOST)
        # @capture: evidence_manifest("cpufallback_degraded_paths") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("if not completed or backend_handle <= 0 or device_identity <= 0:\n            val failure_reason = simpleos_host_gpu_processing_reason(executor_reason)\n            if processing_fallback_cpu:\n                return _loop_state(if _processing_cpu_fallback")
        expect(source).to_contain("if processing_verify_cpu and not processing_ir_outputs_equal(values, oracle):\n            if processing_fallback_cpu:\n                return _loop_state(if _processing_cpu_fallback")
        expect(source).to_contain("val checksum = _write_fill_pixels(base, values, element_count, ir.value)")
        expect(source).to_contain("if checksum <= 0:\n            if processing_fallback_cpu:")
        expect(source).to_contain("_finish(base, generation, SIMPLEOS_HOST_GPU_STATUS_FAIL, failure_reason, 0, 0, 0, 1, 0, 0)")
        expect(source).to_contain("_finish(base, generation, SIMPLEOS_HOST_GPU_STATUS_FAIL, SIMPLEOS_HOST_GPU_REASON_CHECKSUM_MISMATCH, 0, 0, 0, 1, 0, 0)")

    it "fuses production FillU32 validation with the wire copy":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-FUSED-COPY-008
        step("Pin the fused checksum copy across the daemon, raw layer, and runtime")
        val source = file_read(HOST)
        val raw = file_read(RAW)
        val runtime = file_read(RAW_RUNTIME)
        # @capture: evidence_manifest("cpufallback_fused_checksum") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        val bans_superseded_matcher = source.contains("processing_ir_output_matches")
        expect(bans_superseded_matcher).to_equal(false)  # oracle: the superseded separate matcher must not return
        expect(source).to_contain("raw_write_fill_u32s_checksum")
        expect(raw).to_contain("rt_write_fill_u32s_to_raw_checksum")
        expect(runtime).to_contain("count != rt_array_len(values)")
        expect(runtime).to_contain("expected > i64::from(u32::MAX)")
        expect(runtime).to_contain("exact &= value == expected")
        expect(runtime).to_contain("if !exact")
        expect(runtime).to_contain("test_write_fill_u32s_to_raw_checksum_fuses_exact_validation")

    it "runs the CPU oracle only for fallback or explicit verification":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-CPU-GATE-009
        step("Require the oracle call to sit after the verify gate and run at most once")
        val source = file_read(HOST)
        val wrapper = file_read(QEMU_WRAPPER)
        val request = source.slice(
            source.index_of("fn _process_request("),
            source.index_of("fn _arg_value("))
        val verify = request.index_of("if processing_verify_cpu:")
        val cpu = request.index_of("processing_ir_cpu_execute(ir)")
        # @capture: evidence_manifest("cpufallback_verify_gate") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("val processing_verify_cpu = args.contains(\"--processing-verify-cpu\")")
        expect(source).to_contain("if processing_verify_cpu:\n            val cpu_started = time_now_nanos()")
        expect(source).to_contain("if processing_verify_cpu:\n            val preference = _processing_preference")
        val bans_superseded_matcher = source.contains("processing_ir_output_matches")
        expect(bans_superseded_matcher).to_equal(false)  # oracle: the superseded separate matcher must not return
        expect(wrapper).to_contain("set -- \"$@\" --processing-verify-cpu")
        expect(verify).to_be_greater_than(0)
        expect(cpu).to_be_greater_than(verify)
        expect(request.slice(cpu + 1, request.len()).contains(
            "processing_ir_cpu_execute(ir)")).to_equal(false)

    it "exports a correlated fallback validator and rejects forged provenance":
        # @req REQ-SIMPLEOS-GPU-CPUFALLBACK-VALIDATOR-010
        step("Offer honest and forged receipts to the real ivshmem validator")
        val source = file_read(GUEST_BRIDGE)
        expect(file_exists(GUEST_BRIDGE)).to_be(true)
        # @capture: evidence_manifest("cpufallback_forged_provenance") -> processing_cpu_fallback_policy_contract_spec.evidence.sdn
        expect(source).to_contain("fn host_gpu_ivshmem_fallback_receipt_valid")
        expect(source).to_contain("receipt.status == SIMPLEOS_HOST_GPU_STATUS_FALLBACK and receipt.reason > 0")
        expect(source).to_contain("receipt.native_handle == 0 and receipt.device_identity == 0")
        expect(source).to_contain("receipt.readback_source == SIMPLEOS_HOST_GPU_READBACK_CPU")
        expect(source).to_contain("receipt.run_id_hash == expected_run_id_hash and receipt.frame_id == expected_frame_id")
        expect(source).to_contain("export host_gpu_ivshmem_device_receipt_valid, host_gpu_ivshmem_fallback_receipt_valid")

        val good = fallback_receipt(SIMPLEOS_HOST_GPU_STATUS_FALLBACK, SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, 0, 0, SIMPLEOS_HOST_GPU_READBACK_CPU, 31, 5)
        expect(host_gpu_ivshmem_fallback_receipt_valid(good, 7, 31, 5, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 64)).to_equal(true)  # oracle: honest CPU fallback receipt accepted
        val wrong_status = fallback_receipt(SIMPLEOS_HOST_GPU_STATUS_FAIL, SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, 0, 0, SIMPLEOS_HOST_GPU_READBACK_CPU, 31, 5)
        expect(host_gpu_ivshmem_fallback_receipt_valid(wrong_status, 7, 31, 5, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 64)).to_equal(false)  # oracle: non-fallback status rejected
        val native_handle = fallback_receipt(SIMPLEOS_HOST_GPU_STATUS_FALLBACK, SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, 41, 0, SIMPLEOS_HOST_GPU_READBACK_CPU, 31, 5)
        expect(host_gpu_ivshmem_fallback_receipt_valid(native_handle, 7, 31, 5, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 64)).to_equal(false)  # oracle: forged native provenance rejected
        val wrong_source = fallback_receipt(SIMPLEOS_HOST_GPU_STATUS_FALLBACK, SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, 0, 0, 1, 31, 5)
        expect(host_gpu_ivshmem_fallback_receipt_valid(wrong_source, 7, 31, 5, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 64)).to_equal(false)  # oracle: non-CPU readback source rejected
        val wrong_correlation = fallback_receipt(SIMPLEOS_HOST_GPU_STATUS_FALLBACK, SIMPLEOS_HOST_GPU_REASON_BACKEND_READBACK_FAILED, 0, 0, SIMPLEOS_HOST_GPU_READBACK_CPU, 0, 5)
        expect(host_gpu_ivshmem_fallback_receipt_valid(wrong_correlation, 7, 31, 5, SIMPLEOS_HOST_GPU_BACKEND_CUDA, 64)).to_equal(false)  # oracle: run-id correlation mismatch rejected
