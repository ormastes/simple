# @req: REQ-APP-BACKEND-SELECTOR-001


# @tag: system, gpu, simpleos, backend-selector, contract

use std.io_runtime.{file_read, file_exists}
use std.spec.*

val OWNER = "src/app/simpleos_gpu_host/daemon_runner.spl"
val PLATFORM = "src/app/simpleos_gpu_host/platform_all.spl"
val MACOS_PLATFORM = "src/app/simpleos_gpu_host/platform_macos.spl"
val MACOS_MAIN = "src/app/simpleos_gpu_host/main_macos.spl"

fn selector_rejection_guard_mentions(source: text, selector: text) -> bool:
    source.contains("processing_selector != \"" + selector + "\"")

use std.spec.step

describe "SimpleOS GPU host processing backend selector":
    it "keeps the contract on the production daemon owner":
        # @req: REQ-APP-BACKEND-SELECTOR-001
        step("Verify: keeps the contract on the production daemon owner")
        expect(file_exists(OWNER)).to_equal(true)
        val source = file_read(OWNER)
        expect(source).to_contain("--processing-backend=")
        expect(source).to_contain("_process_request(platform, base, processing_selector")
        expect(source).to_contain("processing_selector")

        for selector in ["auto", "cuda", "vulkan", "metal"]:
            expect(selector_rejection_guard_mentions(source, selector)).to_equal(true)

        expect(source).to_contain(
            "processing_selector != \"auto\" and processing_selector != \"cuda\" and processing_selector != \"vulkan\" and processing_selector != \"metal\""
        )

    it "rejects a selector outside the four production choices":
        # @req: REQ-APP-BACKEND-SELECTOR-001
        step("Verify: rejects a selector outside the four production choices")
        val source = file_read(OWNER)
        expect(source).to_contain("processing_backend")
        expect(source).to_contain("return 2")
        expect(source).to_contain("must be auto, cuda, vulkan, or metal")

    it "narrows explicit selectors before probing availability":
        # @req: REQ-APP-BACKEND-SELECTOR-001
        step("Verify: narrows explicit selectors before probing availability")
        val source = file_read(PLATFORM)
        expect(file_exists(PLATFORM)).to_equal(true)
        expect(source).to_contain(
            "if selector == \"cuda\":\n        return requested & SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA"
        )
        expect(source).to_contain(
            "if selector == \"vulkan\":\n        return requested & SIMPLEOS_HOST_GPU_BACKEND_MASK_VULKAN"
        )
        expect(source).to_contain(
            "if selector == \"metal\":\n        return 0"
        )
        expect(file_read(MACOS_PLATFORM)).to_contain(
            "requested & SIMPLEOS_HOST_GPU_BACKEND_MASK_METAL"
        )
        expect(file_read(MACOS_PLATFORM)).to_contain(
            "static fn create() -> SimpleOsGpuHostMacPlatform:"
        )
        expect(file_read(MACOS_MAIN)).to_contain(
            "SimpleOsGpuHostMacPlatform.create()"
        )
        val macos = file_read(MACOS_PLATFORM)
        expect(macos).to_contain("render_available: bool")
        expect(macos).to_contain("processing_available: bool")
        expect(macos).to_contain(
            "processing_available: _macos_processing_probe_available()"
        )
        expect(macos).to_contain("if self.processing_available:")
        expect(source).to_contain("_processing_selector_mask(")
        expect(source).to_contain(
            "SIMPLEOS_HOST_GPU_BACKEND_MASK_VULKAN | SIMPLEOS_HOST_GPU_BACKEND_MASK_CUDA"
        )
