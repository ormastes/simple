# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

"""
# Warning/Allow Root-Cause Cleanup Spec

Static contract over the repository workflow configuration and the runtime
primitive-sort module.
"""

use std.spec.*
use std.io_runtime.{file_exists, file_read}

describe "Warning/Allow root-cause cleanup":
    it "Rust strict lane targets the real workspace":
        # Given the repository workflow configuration
        val wf = file_read(".github/workflows/rust-tests.yml")
        # When the Rust warning gate runs
        # Then it uses `src/compiler_rust` as its workspace root
        expect(wf.contains("working-directory: src/compiler_rust")).to_equal(true)
        expect(wf.contains("-D warnings")).to_equal(true)

    it "Simple strict lane is authoritative":
        # Given the repository workflow configuration
        val wf = file_read(".github/workflows/simple-strict-lints.yml")
        # When the Simple strict lint lane runs
        # Then it executes `--deny-all` over the warning/allow cleanup canaries
        expect(wf.contains("test/03_system/quality/code_quality/warning_allow_root_cause_cleanup_spec.spl --deny-all")).to_equal(true)
        expect(file_exists("test/03_system/quality/code_quality/warning_allow_root_cause_cleanup_spec.spl")).to_equal(true)

    it "Primitive-sort strict Rust baseline compiles":
        # Given the runtime primitive-sort module
        val src = file_read("src/compiler_rust/runtime/src/value/primitive_sort.rs")
        # When strict Rust linting builds test targets
        # Then the module exposes the NEON threshold constants referenced by its tests
        expect(src.contains("const NEON_I64_RADIX_MIN_LEN")).to_equal(true)
        expect(src.contains("const NEON_F64_RADIX_MIN_LEN")).to_equal(true)
