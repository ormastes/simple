"""
## Purpose and audience
Maintainers of `itf minio get`: the ITF MinIO adapter must decode object bodies
strictly and report byte lengths, not character counts.
## Operator workflow
`SIMPLE_BINARY=<simple> SIMPLE_EXECUTION_MODE=interpret <simple> run test/03_system/app/itf/feature/itf_minio_get_decode_spec.spl`
then read the `SPEC FILE VERDICT:` line.
## Compatibility and limitations
Uses the DevHub S3 emulator (synthetic bodies) over a loopback socket.
## Verification guidance and troubleshooting
Mirrors the DevHub adapter scenarios for non-UTF-8 and multibyte GET bodies.
"""
# Lifecycle: doc/08_tracking/bug/itf_minio_get_object_lossy_decode_2026-11-16.md
# @manual_section: object-storage-s3

use std.spec.*
use std.spec.step
use app.itf.adapter_minio.{MinioConfig, minio_get_object}
use test.fixtures.devhub.emulated.emu_harness.{emu_start, emu_base, emu_row, emu_load, emu_problems}

val SIG = "@sigv4=SYNTHAK:synthsecret:us-east-1"

fn cfg() -> MinioConfig:
    MinioConfig(url: emu_base(), region: "us-east-1", access_key: "SYNTHAK", secret_key: "synthsecret", tls_skip_verify: false)

describe "itf minio get over an emulated S3":
    it "reports the byte length of a multibyte object body":
        step("Fetch an object whose UTF-8 bytes outnumber its characters")
        expect(emu_start("s3")).to_contain("127.0.0.1:")
        val gen_id = emu_load([emu_row("GET", "/widgets/uni.txt", SIG, "none", 200, "Content-Type: text/plain", "@s3/object_multibyte.txt")])
        val (ok, got, _raw) = minio_get_object(cfg(), "widgets", "uni.txt", "")
        expect(emu_problems(gen_id, 1)).to_equal("")
        expect(ok).to_equal(true)
        expect(got.body).to_equal("café ☃")
        expect(got.content_length).to_equal(9)  # oracle: c a f (2) space snowman(3) = 9 bytes

    it "refuses a non-UTF-8 object body instead of returning corrupted text":
        step("Serve bytes that are not valid UTF-8 (a PNG-like header)")
        val gen_id = emu_load([emu_row("GET", "/widgets/blob.bin", SIG, "none", 200, "Content-Type: application/octet-stream", "hex:89 50 4e 47 ff fe 00 80")])
        val (ok, got, message) = minio_get_object(cfg(), "widgets", "blob.bin", "")
        expect(emu_problems(gen_id, 1)).to_equal("")
        expect(ok).to_equal(false)
        expect(message).to_contain("invalid UTF-8")
        expect(got.body).to_equal("")
