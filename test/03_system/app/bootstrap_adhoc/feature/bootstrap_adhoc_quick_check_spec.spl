use std.spec.{describe, it, expect}
use app.bootstrap_adhoc.policy.{bootstrap_adhoc_decide, bootstrap_adhoc_pass_marker}

describe "worktree-local bootstrap ad-hoc quick check":
    it "routes a local compiler fix to the smallest safe phase capsule":
        val decision = bootstrap_adhoc_decide([
            "src/compiler/10.frontend/core/parser_preprocessor.spl"
        ], "auto")
        expect(decision.admitted).to_equal(true)
        expect(decision.lane).to_equal("frontend")
        expect(bootstrap_adhoc_pass_marker(decision.lane)).to_equal(
            "BOOTSTRAP_ADHOC_PASS lane=frontend"
        )

    it "escalates loader and weaving changes to exact full bootstrap":
        val loader = bootstrap_adhoc_decide([
            "src/compiler/99.loader/module_resolver/main.spl"
        ], "auto")
        val weaving = bootstrap_adhoc_decide([
            "src/compiler/85.mdsoc/weaver.spl"
        ], "backend")
        expect(loader.admitted).to_equal(false)
        expect(loader.lane).to_equal("full")
        expect(weaving.admitted).to_equal(false)
        expect(weaving.lane).to_equal("full")
