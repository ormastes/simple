# codex-system-test
# @evidence-display: embed_tui
"""# Office CLI, Calc TUI, and Semantic UI Access

## Overview

Runs the deployed pure-Simple CLI once and proves the selected F1/N1 Calc
workflow through the canonical semantic UI protocol. The gate retains fixed
124x37 TUI captures, protocol snapshots and history, command receipts, and
performance measurements.

**Requirement IDs:** REQ-OFFICE-CLI-UI-001 through REQ-OFFICE-CLI-UI-012;
NFR-OFFICE-CLI-UI-001 through NFR-OFFICE-CLI-UI-010
**Requirements:** doc/02_requirements/feature/office_cli_tui_ui_access.md and doc/02_requirements/nfr/office_cli_tui_ui_access.md
**Plan:** doc/03_plan/sys_test/office_cli_tui_ui_access.md
**Design:** doc/05_design/office_cli_tui_ui_access.md
**TUI Captures:** build/test-artifacts/03_system/app/office/feature/office_cli_tui_ui_access/tui/calc-before.txt, build/test-artifacts/03_system/app/office/feature/office_cli_tui_ui_access/tui/calc-after.txt

## Operator Flow

Launch `simple office calc [FILE] --tui`; discover `main`; locate the cell,
formula-input, and confirm nodes; enter A1=6, A2=8, B1=`=A1*A2`, and
C1=`=AVG(A1:A2)`; then inspect the independent snapshot, correlated history,
and retained TUI.

## Failure Triage

Inspect the last `scenario=...` receipt and the evidence root. Missing semantic
targets, rejected deployed commands, formula mismatches, stale revisions, or
absent captures are real failures and must not be replaced with helper probes.
"""

use std.spec.*
use std.io_runtime.{read_file, file_exists}

val OFFICE_UI_EVIDENCE: text = "build/test-artifacts/03_system/app/office/feature/office_cli_tui_ui_access"

describe "Office CLI, Calc TUI, formulas, and semantic UI access":
    # @manual: show
    # @capture(exec)
    # @capture(tui)
    # @capture(protocol)
    # @capture(artifact)
    # @req REQ-OFFICE-CLI-UI-001
    # @req REQ-OFFICE-CLI-UI-002
    # @req REQ-OFFICE-CLI-UI-003
    # @req REQ-OFFICE-CLI-UI-004
    # @req REQ-OFFICE-CLI-UI-005
    # @req REQ-OFFICE-CLI-UI-006
    # @req REQ-OFFICE-CLI-UI-007
    # @req REQ-OFFICE-CLI-UI-008
    # @req REQ-OFFICE-CLI-UI-009
    # @req REQ-OFFICE-CLI-UI-010
    # @req REQ-OFFICE-CLI-UI-011
    # @req REQ-OFFICE-CLI-UI-012
    # @troubleshooting(symptom: "The deployed Calc TUI or semantic formula workflow fails", fix: "Inspect the last scenario receipt and the retained command, protocol, TUI, and performance evidence")
    it "should pass the complete deployed F1/N1 Office workflow":
        step("Launch the deployed IDE and Calc commands")
        step("Discover the Calc main surface and stable semantic controls")
        step("Enter source values, multiplication, and AVG through UI actions")
        step("Inspect independent state, correlated history, and 124x37 TUI captures")
        step("Verify rejection, performance, isolation, and compatibility gates")
        expect(file_exists(OFFICE_UI_EVIDENCE + "/suite.txt")).to_be(true)
        expect(file_exists(OFFICE_UI_EVIDENCE + "/tui/calc-after.txt")).to_be(true)
        expect(file_exists(OFFICE_UI_EVIDENCE + "/protocol/snapshot-after.json")).to_be(true)
        expect(file_exists(OFFICE_UI_EVIDENCE + "/protocol/history.json")).to_be(true)
        val receipt = read_file(OFFICE_UI_EVIDENCE + "/suite.txt")
        val screen = read_file(OFFICE_UI_EVIDENCE + "/tui/calc-after.txt")
        expect(receipt).to_contain("B1_display=48")
        expect(receipt).to_contain("C1_display=7")
        expect(receipt).to_contain("capture_size=124x37")
        expect(receipt).to_contain("runtime=pure-simple-self-hosted")
        expect(receipt).to_contain("suite_status=pass")
        expect(screen.split("\n").len()).to_be_greater_than(36)
        expect(screen).to_contain("Simple Calc")
