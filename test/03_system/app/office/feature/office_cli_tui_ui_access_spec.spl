# codex-system-test
# @evidence-display: embed_tui
"""# Office CLI, Calc TUI, and Semantic UI Access

Run a unique deployed-runtime evidence gate. The scenario never reads a
shared or prior evidence directory: it creates one run id, invokes the gate,
then validates only that run's command, PTY, and protocol receipts.

**Requirements:** REQ-OFFICE-CLI-UI-001 through REQ-OFFICE-CLI-UI-012;
NFR-OFFICE-CLI-UI-001 through NFR-OFFICE-CLI-UI-010.

## Operator steps

1. Set `SIMPLE_BINARY` to a pure-Simple self-hosted executable.
2. Launch the deployed IDE and Calc CLI commands.
3. Start one deployed Calc process under a 124x37 PTY with UI access enabled.
4. Discover `main`, edit A1, A2, B1, C1 through `simple ui` structured
   actions, then capture that same process's final terminal frame.
5. Inspect independent snapshots, history, rejection diagnostics, and captures.

Missing runtime, a seed runtime, a stale run id, a non-PTY capture, a server
that does not answer the public protocol, or stale evidence is a failure.
"""

use std.spec.*
use std.io_runtime.{env_get, file_exists, file_read, getpid, process_run, time_now_unix_micros}

val OFFICE_UI_GATE: text = "scripts/check/check-office-cli-tui-ui-access.spl"
val OFFICE_UI_BASE: text = "build/test-artifacts/03_system/app/office/feature/office_cli_tui_ui_access/runs/"

fn _runtime() -> text:
    val runtime = env_get("SIMPLE_BINARY")
    if runtime == nil: "" else: runtime

fn _run_id() -> text:
    "sspec_" + getpid().to_text() + "_" + time_now_unix_micros().to_text()

describe "Office CLI, Calc TUI, formulas, and semantic UI access":
    # @manual: show
    # @capture(exec)
    # @capture(tui)
    # @capture(protocol)
    # @capture(artifact)
    # @req REQ-OFFICE-CLI-UI-001
    # @req REQ-OFFICE-CLI-UI-002
    # @req REQ-OFFICE-CLI-UI-003
    # @req REQ-OFFICE-CLI-UI-004
    # @req REQ-OFFICE-CLI-UI-005
    # @req REQ-OFFICE-CLI-UI-006
    # @req REQ-OFFICE-CLI-UI-007
    # @req REQ-OFFICE-CLI-UI-008
    # @req REQ-OFFICE-CLI-UI-009
    # @req REQ-OFFICE-CLI-UI-010
    # @req REQ-OFFICE-CLI-UI-011
    # @req REQ-OFFICE-CLI-UI-012
    # @req NFR-OFFICE-CLI-UI-002
    # @req NFR-OFFICE-CLI-UI-003
    # @req NFR-OFFICE-CLI-UI-004
    # @req NFR-OFFICE-CLI-UI-005
    # @req NFR-OFFICE-CLI-UI-006
    # @troubleshooting(symptom: "Calc deployed workflow fails", fix: "Read only the unique run directory named in the gate receipt; do not reuse an earlier capture")
    it "should execute a fresh deployed F1/N1 workflow without stale evidence":
        step("Create one unique evidence run id")
        val runtime = _runtime()
        expect(runtime == "").to_equal(false)
        expect(runtime.contains("compiler_rust")).to_equal(false)
        expect(file_exists(runtime)).to_equal(true)
        val run_id = _run_id()
        val root = OFFICE_UI_BASE + run_id
        expect(file_exists(root + "/suite.txt")).to_equal(false)

        step("Run the gate through the configured deployed runtime")
        val (stdout, stderr, code) = process_run(runtime, ["run", OFFICE_UI_GATE, "--scenario", "all", "--run-id", run_id])
        expect(code).to_equal(0)
        expect(stdout).to_contain("suite_status=pass")
        expect(stdout).to_contain("run_id=" + run_id)

        step("Inspect only this run's PTY and independent protocol evidence")
        expect(file_exists(root + "/suite.txt")).to_equal(true)
        expect(file_exists(root + "/tui/calc-after.ansi")).to_equal(true)
        expect(file_exists(root + "/tui/calc-after.txt")).to_equal(true)
        expect(file_exists(root + "/protocol/snapshot-before.json")).to_equal(true)
        expect(file_exists(root + "/protocol/snapshot-after.json")).to_equal(true)
        expect(file_exists(root + "/protocol/history.json")).to_equal(true)
        expect(file_exists(root + "/protocol/windows.json")).to_equal(true)
        expect(file_exists(root + "/protocol/surface-main.json")).to_equal(true)
        expect(file_exists(root + "/perf/warm-protocol.txt")).to_equal(true)
        expect(file_exists(root + "/perf/startup.txt")).to_equal(true)
        val receipt = file_read(root + "/suite.txt")
        val screen = file_read(root + "/tui/calc-after.txt")
        val b1 = file_read(root + "/protocol/find-b1.json")
        val c1 = file_read(root + "/protocol/find-c1.json")
        val warm = file_read(root + "/perf/warm-protocol.txt")
        val startup = file_read(root + "/perf/startup.txt")
        expect(receipt).to_contain("run_id=" + run_id)
        expect(receipt).to_contain("runtime=pure-simple-self-hosted")
        expect(receipt).to_contain("capture_size=124x37")
        expect(receipt).to_contain("B1_display=48")
        expect(receipt).to_contain("C1_display=7")
        expect(screen.split("\n").len()).to_equal(38)
        expect(screen).to_contain("Simple Calc")
        expect(b1).to_contain("main#cell_B1")
        expect(b1).to_contain("48")
        expect(c1).to_contain("main#cell_C1")
        expect(c1).to_contain("7")

        step("Retain measured warm public-CLI NFR evidence")
        expect(warm).to_contain("sample_count=20")
        expect(warm).to_contain("snapshot_p95_us=")
        expect(warm).to_contain("find_p95_us=")
        expect(warm).to_contain("action_post_p95_us=")
        expect(warm).to_contain("rss_delta_kib=")
        expect(warm).to_contain("rss_status=measured")
        expect(startup).to_contain("startup_us=")
