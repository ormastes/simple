# @cover src/os/kernel/loader/fs_exec_receipt.spl 0%
# @req REQ-001 REQ-002 REQ-012 NFR-007 NFR-008 NFR-010

"""SimpleOS filesystem launch, bounded lifecycle, and persistence acceptance.

The QEMU and live-socket collectors are intentionally unresolved.  This suite
must remain red until their receipts are supplied by the production runner.
"""

use std.spec.*
use os.kernel.loader.fs_exec_receipt.{
    fs_exec_receipt_exited, fs_exec_receipt_exited_registered
}
use os.port.server_artifact_catalog.*

fn lifecycle_hash() -> text:
    "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

fn unresolved_socket_receipt(artifact: SimpleOsServerArtifact, pid: i64) -> SimpleOsServerSocketReceipt:
    SimpleOsServerSocketReceipt(
        artifact_id: artifact.id, filesystem_path: artifact.filesystem_path,
        pid: pid, image_id: "policy-fixture-not-live-evidence",
        launch_id: "policy-fixture-launch", bind_address: "", port: 0,
        challenge: "", response: "",
        successful_exchanges: 0)

fn observed_staging_receipt(artifact: SimpleOsServerArtifact) -> SimpleOsServerArtifactReceipt:
    simpleos_server_artifact_observed_staging_receipt(
        artifact,
        SimpleOsServerStagingEvidence(
            filesystem_path: artifact.filesystem_path,
            host_sha256: artifact.sha256,
            filesystem_sha256: artifact.sha256,
            byte_size: 4096,
            image_id: "policy-fixture-not-live-evidence",
            image_sha256: lifecycle_hash()))

# @inline
fn setup_release_artifacts():
    fail("UNRESOLVED ORACLE: release artifact build and staging receipt")

# @inline
fn setup_simpleos_qemu():
    fail("UNRESOLVED ORACLE: SimpleOS QEMU boot receipt")

# @inline
fn launch_server_from_filesystem():
    fail("UNRESOLVED ORACLE: filesystem executable launch receipt")

# @inline
fn await_listener():
    fail("UNRESOLVED ORACLE: SimpleOS bound socket listener")

# @inline
fn stop_server_gracefully():
    fail("UNRESOLVED ORACLE: bounded drain and graceful shutdown receipt")

# @inline
fn restart_simpleos():
    fail("UNRESOLVED ORACLE: SimpleOS restart and persistent storage receipt")

fn check_artifact_receipt():
    fail("UNRESOLVED ORACLE: executable version and hash receipt")

fn check_bounded_lifecycle():
    fail("UNRESOLVED ORACLE: lifecycle timeout backpressure and drain counters")

fn check_persistence():
    fail("UNRESOLVED ORACLE: committed database restart persistence")

fn check_resource_counters():
    fail("UNRESOLVED ORACLE: bounded listener queue connection and shutdown counters")

describe "SimpleOS secure server lifecycle":
    describe "REQ-001: truthful filesystem artifact promotion":
        it "should pin both server paths and reject staging as runnable evidence":
            step("Build and stage release-native server artifacts")
            val web = simpleos_web_server_artifact(
                "1.0.0", lifecycle_hash(), "build/server/simple_web_server")
            val db = simpleos_db_server_artifact(
                "1.0.0", lifecycle_hash(), "build/server/postgres_mimic_server")
            val web_staged = simpleos_server_artifact_staged_receipt(web)
            val db_staged = simpleos_server_artifact_staged_receipt(db)
            expect(web.filesystem_path).to_equal("/SYS/APPS/WEBSRV.SMF")
            expect(db.filesystem_path).to_equal("/SYS/APPS/DBSRV.SMF")
            expect(web_staged.staged).to_equal(false)
            expect(db_staged.staged).to_equal(false)
            expect(web_staged.runnable).to_equal(false)
            expect(db_staged.runnable).to_equal(false)

        it "should require positive process identity and socket proof for promotion":
            step("Boot SimpleOS and launch the staged executable")
            val artifact = simpleos_web_server_artifact(
                "1.0.0", lifecycle_hash(), "build/server/simple_web_server")
            val staged = observed_staging_receipt(artifact)
            val no_process = simpleos_server_artifact_execution_receipt(
                artifact, staged,
                fs_exec_receipt_exited(artifact.filesystem_path, 0, 0),
                unresolved_socket_receipt(artifact, 0))
            expect(no_process.runnable).to_equal(false)
            expect(no_process.reason).to_equal("filesystem-execution-not-proven")
            val no_socket = simpleos_server_artifact_execution_receipt(
                artifact, staged,
                fs_exec_receipt_exited_registered(
                    artifact.filesystem_path, 71, 0),
                unresolved_socket_receipt(artifact, 71))
            expect(no_socket.runnable).to_equal(false)
            expect(no_socket.reason).to_equal("socket-capability-not-proven")
            # A production collector must supply the correlated challenge/response.
            # This system spec deliberately cannot manufacture a positive receipt.

    describe "REQ-001 REQ-002: filesystem execution and recovery":
        it "should build stage and launch both servers from the SimpleOS filesystem":
            step("build/stage release artifacts")
            setup_release_artifacts()
            step("boot SimpleOS and launch from filesystem")
            setup_simpleos_qemu()
            launch_server_from_filesystem()
            await_listener()
            check_artifact_receipt()

        it "should drain and stop both servers within bounded limits":
            step("drain/stop")
            stop_server_gracefully()
            check_bounded_lifecycle()
            check_resource_counters()

        it "should restart SimpleOS and preserve committed database data":
            step("restart and verify data")
            restart_simpleos()
            check_persistence()
