# @req: REQ-APP-WEB-CSS-001


# codex-system-test
# @tag: rendering, web, css, engine2d
# @req REQ-WEB-BROWSER-001 REQ-WEB-BROWSER-004
# @evidence-display: links

"""# Web rendering: CSS essentials used by the standards showcase

Renders a compact page exercising the exact CSS features the showcase page
(`examples/06_io/ui/browser_common_elements_showcase.html`) depends on —
element/id/class selectors, `background`, `color`, `padding`, `margin`,
`border: 0` — through the pure-Simple web renderer on the deterministic
cpu_simd engine2d lane, and asserts EXACT pixel anchors:

- `header { background: #173b7a }` — header band
- `body { background: #eef2ff }` — page ground
- `.card { background: white }` — class selector + white card
- `button { background: #4f46e5 }` — button fill
- `<mark>` — yellow highlight
- `a { color: #1d4ed8 }` — anchor text renders blue-dominant pixels

Anchors were measured from a reference render of the same page; exact-color
assertions are derived from the CSS values (no fitted tolerances), and the
anchor-text check tolerates antialiasing by testing blue dominance, not
equality.
"""

use std.spec.{describe, it, expect, step}
use std.gc_async_mut.gpu.browser_engine.simple_web_renderer.{
    simple_web_render_html_to_pixels_with_engine2d_backend
}

val W: i32 = 400
val H: i32 = 300

fn essentials_page() -> text:
    "<html><head><style>" +
        "body { margin: 0; background: #eef2ff; color: #172033; font: 16px/1.5 sans-serif; } " +
        "header { padding: 16px; color: white; background: #173b7a; } " +
        "button { color: white; background: #4f46e5; padding: 8px; border: 0; } " +
        "a { color: #1d4ed8; } " +
        ".card { background: white; padding: 12px; margin: 12px; } " +
        "</style></head><body>" +
        "<header><strong>Head</strong></header>" +
        "<div class='card'><p>plain <a href='#'>link</a> <mark>mark</mark></p>" +
        "<button>Go</button></div>" +
        "</body></html>"

fn pixel_at(pixels: [u32], x: i32, y: i32) -> u32:
    pixels[y * W + x]

fn has_blue_dominant_pixel(pixels: [u32], x0: i32, y0: i32, x1: i32, y1: i32) -> bool:
    """True when any pixel in the region is clearly blue (anchor text is
    antialiased, so exact equality would be a fitted tolerance)."""
    var y = y0
    while y < y1:
        var x = x0
        while x < x1:
            val p = pixels[y * W + x].to_i64()
            val r = (p >> 16) & 255
            val b = p & 255
            if b > 150 and b > r + 40:
                return true
            x = x + 1
        y = y + 1
    false

use std.spec.step

describe "Web CSS essentials — showcase feature set":
    it "renders header, body ground, card, button, mark, and anchor colors exactly":
        # @req: REQ-APP-WEB-CSS-001
        step("Verify: renders header, body ground, card, button, mark, and anchor colors exactly")
        step("Render the essentials page on the cpu_simd lane")
        val pixels = simple_web_render_html_to_pixels_with_engine2d_backend(essentials_page(), W, H, "cpu_simd")
        expect(pixels.len()).to_equal(W * H)
        step("Header band is exactly #173b7a")
        expect(pixel_at(pixels, 200, 10)).to_equal(0xFF173B7Au32)  # oracle: 0xFF173B7Au32 — pinned expected value for this behavior
        step("Body ground is exactly #eef2ff")
        expect(pixel_at(pixels, 380, 295)).to_equal(0xFFEEF2FFu32)  # oracle: 0xFFEEF2FFu32 — pinned expected value for this behavior
        step("Card background is white (class selector applied)")
        expect(pixel_at(pixels, 200, 90)).to_equal(0xFFFFFFFFu32)  # oracle: 0xFFFFFFFFu32 — pinned expected value for this behavior
        step("Button fill is exactly #4f46e5")
        expect(pixel_at(pixels, 40, 133)).to_equal(0xFF4F46E5u32)  # oracle: 0xFF4F46E5u32 — pinned expected value for this behavior
        step("Mark highlight is exactly yellow")
        expect(pixel_at(pixels, 117, 103)).to_equal(0xFFFFFF00u32)  # oracle: 0xFFFFFF00u32 — pinned expected value for this behavior
        step("Anchor text carries blue-dominant pixels")
        expect(has_blue_dominant_pixel(pixels, 60, 95, 120, 112)).to_equal(true)
