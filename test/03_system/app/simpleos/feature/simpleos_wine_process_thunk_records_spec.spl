# @req: REQ-APP-WINE-PROCESS-001


use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_process_session.{
    wine_process_plan_known_kernel32_thunk_patch_records,
    wine_process_session_plan,
    wine_process_session_request_new
}

fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

use std.spec.step

describe "SimpleOS Wine thunk patch records":
    describe "REQ-024: bounded thunk patch record planning":
        it "should plan concrete records for the known KERNEL32 import thunk slots":
            # @req: REQ-APP-WINE-PROCESS-001 REQ-024
            step("Verify: should plan concrete records for the known KERNEL32 import thunk slots")
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_plan_known_kernel32_thunk_patch_records(plan, wine_known_hello_exe_fixture_bytes(), 8)
            expect(result.ok).to_equal(true)
            expect(result.records.len()).to_equal(3)  # oracle: 3 — pinned expected value for this behavior
            expect(result.records[0].symbol).to_equal("GetStdHandle")
            expect(result.records[0].thunk_rva).to_equal(0x2060)  # oracle: 0x2060 — pinned expected value for this behavior
            expect(result.records[0].name_rva).to_equal(0x2080)  # oracle: 0x2080 — pinned expected value for this behavior
            expect(result.records[1].symbol).to_equal("WriteFile")
            expect(result.records[1].thunk_rva).to_equal(0x2068)  # oracle: 0x2068 — pinned expected value for this behavior
            expect(result.records[2].symbol).to_equal("ExitProcess")
            expect(result.records[2].thunk_rva).to_equal(0x2070)  # oracle: 0x2070 — pinned expected value for this behavior
            expect(result.evidence).to_contain("import-thunk-records-data-backed")
            expect(result.status).to_equal("thunk-records-planned")

        it "should reject thunk record planning before load-and-bind passes":
            # @req: REQ-APP-WINE-PROCESS-001
            step("Verify: should reject thunk record planning before load-and-bind passes")
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val result = wine_process_plan_known_kernel32_thunk_patch_records(plan, wine_known_hello_exe_fixture_bytes(), 0)
            expect(result.ok).to_equal(false)
            expect(result.error).to_equal("invalid-symbol-limit")
            expect(result.records.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
