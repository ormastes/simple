Audience: compiler and tooling engineers who maintain this spec.
## Operator workflow
Run this spec with the test runner and read the per-scenario verdict lines;
a failing scenario pinpoints the behavior that regressed.
## Compatibility and limitations
Covers the pinned behavior only; fixture data is local to this spec.
# @manual: primary
REQ-APP-WINE-PROCESS-001
doc/01_research/app/REQ-APP-WINE-PROCESS-001.md
doc/03_plan/app/REQ-APP-WINE-PROCESS-001.md
doc/04_architecture/app/REQ-APP-WINE-PROCESS-001.md
doc/05_design/app/REQ-APP-WINE-PROCESS-001.md
"""
# @req: REQ-APP-WINE-PROCESS-001


use common.wine_hello_fixture.{wine_known_hello_exe_fixture_bytes}
use common.wine_process_session.{
    wine_process_resolve_first_import_module,
    wine_process_session_plan,
    wine_process_session_request_new
}

fn _full_gates() -> text:
    "process=verified exec_env=verified vm=verified renderer=verified user32=verified " +
        "gdi32=verified kernel32_core=verified host=verified posix=verified registry=verified " +
        "pthread=verified dynload=verified audio=verified fonts=verified input=verified " +
        "pe_loader=verified async=verified nt_bridge=verified"

use std.spec.step

describe "SimpleOS Wine first-import module resolution":
    describe "REQ-021: first-import module loader bridge":
        it "should resolve a requested procedure against a validated first import module":
            # @req: REQ-APP-WINE-PROCESS-001
            step("Verify: should resolve a requested procedure against a validated first import module")
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val resolution = wine_process_resolve_first_import_module(plan, wine_known_hello_exe_fixture_bytes(), 8, "GetProcAddress")
            expect(resolution.ok).to_equal(true)
            expect(resolution.module_name).to_equal("KERNEL32.dll")
            expect(resolution.proc_name).to_equal("GetProcAddress")
            expect(resolution.operations).to_equal("GetModuleHandleW LoadLibraryExW GetProcAddress FreeLibrary")
            expect(resolution.status).to_equal("module-resolved")

        it "should reject first-import module resolution before import inspection passes":
            # @req: REQ-APP-WINE-PROCESS-001
            step("Verify: should reject first-import module resolution before import inspection passes")
            val plan = wine_process_session_plan(wine_process_session_request_new("game.exe", [], "C:\\Games"), _full_gates())
            val resolution = wine_process_resolve_first_import_module(plan, wine_known_hello_exe_fixture_bytes(), 0, "GetProcAddress")
            expect(resolution.ok).to_equal(false)
            expect(resolution.error).to_equal("invalid-symbol-limit")
            expect(resolution.status).to_equal("blocked")
