use std.spec.step

use std.spec.{describe, it, expect}
use std.io_runtime.{file_exists, file_read}

struct AcceptanceEvidence:
    criterion: text
    evidence_path: text
    blocker: text

fn unified_lifecycle_acceptance_evidence() -> [AcceptanceEvidence]:
    [
        AcceptanceEvidence(criterion: "AC-1", evidence_path: "test/01_unit/lib/scv/lifecycle_entity_codec_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-2", evidence_path: "test/01_unit/lib/scv/lifecycle_identity_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-3", evidence_path: "test/01_unit/lib/scv/lifecycle_review_sync_release_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-4", evidence_path: "test/01_unit/app/sj/lifecycle_policy_plan_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-5", evidence_path: "test/01_unit/app/sj/lifecycle_policy_plan_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-6", evidence_path: "test/03_system/app/scv/feature/scv_jj_git_devhub_spipe_unified_lifecycle_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-7", evidence_path: "test/01_unit/app/devhub/lifecycle_command_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-8", evidence_path: "test/01_unit/lib/scv/lifecycle_review_sync_release_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-9", evidence_path: "test/01_unit/app/devhub/version_manifest_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-10", evidence_path: "test/01_unit/lib/scv/lifecycle_review_sync_release_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-11", evidence_path: "test/01_unit/lib/scv/lifecycle_work_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-12", evidence_path: "test/03_system/app/scv/feature/scv_jj_git_devhub_spipe_unified_lifecycle_spec.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-13", evidence_path: "doc/06_spec/03_system/app/scv/feature/scv_jj_git_devhub_spipe_unified_lifecycle_spec.md", blocker: "authoritative sspec-maintain requires admitted pure-Simple Stage 4 CLI"),
        AcceptanceEvidence(criterion: "AC-14", evidence_path: "src/lib/scv/lifecycle/entity_codec.spl", blocker: "authoritative coverage and duplicate-check require admitted pure-Simple Stage 4 CLI"),
        AcceptanceEvidence(criterion: "AC-15", evidence_path: "src/app/devhub/provider/lifecycle_provider.spl", blocker: ""),
        AcceptanceEvidence(criterion: "AC-16", evidence_path: "doc/07_guide/app/tools/unified_lifecycle.md", blocker: ""),
        AcceptanceEvidence(criterion: "AC-17", evidence_path: ".spipe/scv_jj_git_devhub_spipe_unified_lifecycle/state.md", blocker: "final independent post-remediation operator-manual review remains required"),
        AcceptanceEvidence(criterion: "AC-18", evidence_path: "doc/09_report/verify_scv_jj_git_devhub_spipe_unified_lifecycle_2026-08-25.md", blocker: "production verify requires admitted pure-Simple Stage 4 CLI and unrelated working-tree guard owners")
    ]

describe "Unified lifecycle acceptance traceability":
    # @manual scenario evidence
    it "maps all eighteen criteria without invented PASS evidence":
        # @req REQ-SSPEC-SYSTEM
        step("maps all eighteen criteria without invented PASS evidence")
        val rows = unified_lifecycle_acceptance_evidence()
        expect(rows.len()).to_equal(18)
        var i = 0
        while i < rows.len():
            expect(rows[i].criterion).to_equal("AC-" + (i + 1).to_text())
            expect(file_exists(rows[i].evidence_path)).to_be(true)
            if rows[i].blocker == "":
                expect(file_read(rows[i].evidence_path)).to_contain("# @ac: " + rows[i].criterion)
            if rows[i].criterion == "AC-13" or rows[i].criterion == "AC-14" or rows[i].criterion == "AC-17" or rows[i].criterion == "AC-18":
                expect(rows[i].blocker == "").to_be(false)
            i = i + 1

export AcceptanceEvidence, unified_lifecycle_acceptance_evidence
