# @req REQ-SCV-GATEWAY-SNAPSHOT-REPLICATION-001
# @cover src/app/scv/gateway_draft_service_v1.spl 80%
# @cover src/app/scv/gateway_draft_client_v1.spl 80%
# Real loopback HTTP over the native bounded client and existing draft server.
use std.spec.*
use app.scv.gateway_draft_service_v1.*
use app.scv.gateway_draft_client_v1.*
use std.scv.gateway_snapshot_replication_v1.*
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use std.nogc_sync_mut.http_server.server.{SimpleHttpServer}
use std.nogc_sync_mut.io.tcp.{TcpListener}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir_raw, directory_fsync}
use std.nogc_sync_mut.io.dir_ops.{dir_remove_all}
use std.concurrent.thread.{thread_spawn_with_args}

val SCV_SNAPSHOT_LIVE_TOKEN = "abcdefghijklmnopqrstuvwxyz012345"

fn scv_snapshot_live_credential_v1() -> Result<text, text>:
    Ok(SCV_SNAPSHOT_LIVE_TOKEN)

fn scv_snapshot_live_manifest_v1(bytes: [u8]) -> ScvGatewaySnapshotManifestV1:
    val digest = sha256_u8_hex(bytes)
    val inventory = "src/main.spl|sha256_{digest}|{bytes.len()}"
    val inventory_digest = sha256_text(inventory)
    val tree_id = "scv-tree-v1-{inventory_digest}"
    val revision_id = scv_compile_snapshot_revision_id_v1(tree_id, inventory_digest)
    val commit_id = "scv-compile-v1-" + sha256_text("simple/scv-compile-commit/v1|{tree_id}|1")
    val provenance = scv_compile_snapshot_provenance_v1(revision_id, commit_id,
        tree_id, inventory_digest, 1)
    ScvGatewaySnapshotManifestV1(version: 1, repository: "repo-alpha", principal_id: "principal-1",
        source_domain: "compile-inventory-v1", config_digest: sha256_text("config"),
        revision_id: revision_id, commit_id: commit_id, tree_id: tree_id,
        inventory_digest: inventory_digest, inventory_count: 1, provenance: provenance,
        inventory: inventory,
        objects: [ScvGatewaySnapshotObjectRefV1(kind: "source_bytes", object_id: "sha256_" + digest,
            content_sha256: digest, byte_count: bytes.len() as i64)], structural_recipes: [])

fn scv_snapshot_live_config_v1(root: text) -> ScvGatewayDraftConfigV1:
    val grant = ScvGatewayDraftGrantConfigV1(repository: "repo-alpha", principal_id: "principal-1",
        bearer_token_env: "SCV_SNAPSHOT_LIVE_TOKEN", can_read: true, can_write: true)
    ScvGatewayDraftConfigV1(listen_host: "127.0.0.1", listen_port: 0, store_root: root, grants: [grant])

fn scv_snapshot_live_grant_v1() -> ScvGatewayDraftGrantV1:
    ScvGatewayDraftGrantV1(repository: "repo-alpha", principal_id: "principal-1",
        bearer_token: SCV_SNAPSHOT_LIVE_TOKEN, can_read: true, can_write: true)

fn scv_snapshot_live_exchange_v1(root: text, manifest: ScvGatewaySnapshotManifestV1,
        endpoint_path: text) -> Result<ScvGatewaySnapshotResponseV1, text>:
    var listener = match TcpListener.bind("127.0.0.1:0"):
        case Ok(value): value
        case Err(_): return Err("snapshot_live_bind_failed")
    val address = match listener.local_addr():
        case Ok(value): value
        case Err(_):
            val _ = listener.close()
            return Err("snapshot_live_address_failed")
    val port = address.split(":")[1]
    val config = scv_snapshot_live_config_v1(root)
    val grant = scv_snapshot_live_grant_v1()
    val router = scv_gateway_draft_router_v1(config, [grant])
    var server = SimpleHttpServer.new("127.0.0.1", 0, router)
    server = server.with_policy(scv_gateway_draft_server_policy_v1("snapshot replication system fixture")?)
    val worker = thread_spawn_with_args(server, listener, \server_value, listener_value:
        var owned_server: SimpleHttpServer = server_value
        var owned_listener: TcpListener = listener_value
        match owned_listener.accept_timeout(6000):
            case Err(_): -1
            case Ok(connection):
                if not owned_server.admission.try_acquire():
                    val _ = connection.close()
                    -1
                else:
                    SimpleHttpServer.handle_connection_admitted(owned_server, connection)
                    0
    )
    val client_config = ScvGatewaySnapshotClientConfigV1(endpoint:
        "http://127.0.0.1:{port}{endpoint_path}", repository: "repo-alpha",
        principal_id: "principal-1", allow_loopback_http: true, timeout_ms: 5000, tls_address: "")
    val result = scv_gateway_snapshot_client_publish_v1(client_config, "snapshot-live-1",
        "snapshot-live-request", manifest, scv_snapshot_live_credential_v1)
    val joined = worker.join()
    val _ = listener.close()
    if joined != 0: return Err("snapshot_live_server_failed")
    result

describe "SCV compile-source snapshot replication over loopback HTTP":
    # @manual scenario evidence
    it "reports missing source bytes, accepts a bounded PUT, and returns an idempotent durable root receipt":
        val root = secure_temp_dir_raw("/tmp", "scv-snapshot-live-v1-")
        expect(root.len()).to_be_greater_than(0)
        expect(directory_fsync(root)).to_equal(true)
        expect(directory_fsync("/tmp")).to_equal(true)
        val bytes: [u8] = [0u8, 255u8, 10u8]
        val manifest = scv_snapshot_live_manifest_v1(bytes)
        val pending = scv_snapshot_live_exchange_v1(root, manifest, "/scv/snapshot/v1").unwrap()
        expect(pending.status).to_equal("needs_inputs")
        expect(pending.missing_object_ids).to_equal(["sha256_{sha256_u8_hex(bytes)}"])
        val client_config = ScvGatewayDraftClientConfigV1(endpoint:
            "http://127.0.0.1:8811/scv/draft/v1", repository: "repo-alpha",
            principal_id: "principal-1", allow_loopback_http: true, timeout_ms: 5000, tls_address: "")
        val put = scv_gateway_draft_client_put_v1(client_config,
            "snapshot-source-{manifest.revision_id}", "snapshot-source-1", bytes,
            scv_snapshot_live_credential_v1)
        expect(put.is_ok()).to_equal(true)
        val receipt = scv_snapshot_live_exchange_v1(root, manifest, "/scv/snapshot/v1").unwrap()
        expect(receipt.status).to_equal("ok")
        expect(receipt.state).to_equal("snapshot_local_durable")
        expect(receipt.snapshot_id).to_equal(manifest.revision_id)
        expect(dir_remove_all(root)).to_equal(true)
