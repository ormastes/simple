"""Operator evidence for native history and persistent change lifecycle.
Uses an explicitly selected admitted runtime; never shells out to Git or jj.
"""
# @req REQ-SCV-HISTORY-001 REQ-SCV-HISTORY-002 REQ-SCV-HISTORY-003
use std.spec.{describe, it, expect, step}
use app.io.mod.{process_run_timeout}

fn native_history_script(lines: [text]) -> text:
    val (out, err, code) = process_run_timeout("/bin/sh", ["-c", lines.join("\n") + "\n"], 120000)
    "{out}{err}\nexit={code}\n"

fn native_history_setup() -> [text]:
    [
        "set -eu",
        "REPO=$(pwd)",
        "RUNTIME=$(printenv SIMPLE_SCV_TEST_RUNTIME) || { echo 'set SIMPLE_SCV_TEST_RUNTIME to an admitted pure-Simple runtime'; exit 1; }",
        "TMP=$(mktemp -d /tmp/scv-native-history-cli.XXXXXX)",
        "trap 'rm -rf \"$TMP\"' EXIT",
        "scv() { SIMPLE_LIB=\"$REPO/src\" \"$RUNTIME\" run \"$REPO/src/app/scv/main.spl\" \"$@\"; }",
        "cur_commit() { sed -n 's/^default: //p' .scv/meta/workspaces.sdn; }",
        "cur_change() { sed -n 's/^change: //p' \".scv/objects/commits/$(cur_commit).sdn\"; }",
        "cd \"$TMP\"",
        "printf 'base\\n' > a.txt",
        "scv init >/dev/null",
        "scv snapshot >/dev/null"
    ]

describe "Native SCV history CLI":
    it "reports reachable revisions of an explicitly selected closed change after starting another":
        step("Snapshot twice in one logical change, then close it and start another")
        var lines = native_history_setup()
        lines.push("C1=$(cur_commit); CH1=$(cur_change); FIRST_OP=$(cat .scv/HEAD_OP)")
        lines.push("printf 'second\\n' > a.txt; scv snapshot >/dev/null")
        lines.push("C2=$(cur_commit); test \"$(cur_change)\" = \"$CH1\"")
        lines.push("OPEN=$(scv change-log); printf '%s\\n' \"$OPEN\"")
        lines.push("printf '%s\\n' \"$OPEN\" | grep -F \"change_id $CH1 state=open latest=$C2\"")
        lines.push("test \"$(printf '%s\\n' \"$OPEN\" | grep -c '^commit_id ')\" -eq 2")
        lines.push("scv close-change >/dev/null; scv restore-op \"$FIRST_OP\" >/dev/null; scv new-change >/dev/null")
        lines.push("CH2=$(cur_change); test \"$CH1\" != \"$CH2\"")
        lines.push("CLOSED=$(scv change-log \"$CH1\"); printf '%s\\n' \"$CLOSED\"")
        lines.push("printf '%s\\n' \"$CLOSED\" | grep -F \"change_id $CH1 state=closed latest=$C2\"")
        lines.push("printf '%s\\n' \"$CLOSED\" | grep -F \"commit_id $C1 \"")
        lines.push("printf '%s\\n' \"$CLOSED\" | grep -F \"commit_id $C2 \"")
        lines.push("test \"$(printf '%s\\n' \"$CLOSED\" | grep -c '^commit_id ')\" -eq 2")
        lines.push("CURRENT=$(scv change-log); printf '%s\\n' \"$CURRENT\" | grep -F \"change_id $CH2 state=open \"")
        lines.push("test \"$(printf '%s\\n' \"$CURRENT\" | grep -c '^commit_id ')\" -eq 1")
        lines.push("test \"$(scv log | grep -c '^commit commit_')\" -eq 1")
        lines.push("printf 'logical-change-lifecycle=ok\\n'")
        val out = native_history_script(lines)
        expect(out).to_contain("logical-change-lifecycle=ok")
        expect(out).to_contain("exit=0")

    it "shows both parents of a real conflicting merge once and fails for a missing second parent":
        step("Build sibling snapshots and merge their conflicting edits with native SCV")
        var lines = native_history_setup()
        lines.push("BASE=$(cur_commit); BASE_OP=$(cat .scv/HEAD_OP)")
        lines.push("printf 'left\\n' > a.txt; scv snapshot >/dev/null; LEFT=$(cur_commit)")
        lines.push("scv restore-op \"$BASE_OP\" >/dev/null")
        lines.push("printf 'right\\n' > a.txt; scv snapshot >/dev/null; RIGHT=$(cur_commit)")
        lines.push("MERGE_OUT=$(scv merge-commits \"$BASE\" \"$LEFT\" \"$RIGHT\"); printf '%s\\n' \"$MERGE_OUT\"")
        lines.push("printf '%s\\n' \"$MERGE_OUT\" | grep 'conflicts=1'")
        lines.push("MERGE=$(cur_commit); scv bookmark-set merged >/dev/null")
        lines.push("LOG=$(scv log --all-parents merged)")
        lines.push("ACTUAL=$(printf '%s\\n' \"$LOG\" | awk '/^commit_id / {print $2}')")
        lines.push("EXPECTED=$(printf '%s\\n' \"$MERGE\" \"$LEFT\" \"$BASE\" \"$RIGHT\"); test \"$ACTUAL\" = \"$EXPECTED\"")
        lines.push("scv conflicts | grep 'conflict_'")
        lines.push("rm \".scv/objects/commits/$RIGHT.sdn\"")
        lines.push("if OUT=$(scv log --all-parents merged); then echo 'unexpected-success'; exit 1; fi")
        lines.push("printf '%s\\n' \"$OUT\" | grep -F \"ERROR cannot read history commit $RIGHT:\"")
        lines.push("if printf '%s\\n' \"$OUT\" | grep '^commit_id '; then exit 1; fi")
        lines.push("printf 'merge-history=ok\\n'")
        val out = native_history_script(lines)
        expect(out).to_contain("merge-history=ok")
        expect(out).to_contain("exit=0")

    it "rejects absent bookmarks and malformed command arguments with nonzero exit":
        step("Invoke invalid history commands through the real CLI")
        var lines = native_history_setup()
        lines.push("for ARGS in 'log --all-parents absent' 'log --all-parents one two' 'change-log one two'; do")
        lines.push("  if scv $ARGS; then echo 'unexpected-success'; exit 1; fi")
        lines.push("done")
        lines.push("printf 'invalid-history-args=ok\\n'")
        val out = native_history_script(lines)
        expect(out).to_contain("ERROR unknown history bookmark: absent")
        expect(out).to_contain("invalid-history-args=ok")
        expect(out).to_contain("exit=0")
