# @cover src/app/scv/main.spl 20%
# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

use std.spec.step

use app.io.mod (process_run, file_write, file_read, file_delete)
use std.scv.store.{scv_init_repo, scv_current_op, scv_restore_preflight}
use std.scv.working_copy.{scv_snapshot}

fn _scv_restore_doc_script(script: text) -> text:
    val (out, err, code) = process_run("/bin/sh", ["-c", script])
    "{out}{err}\nexit={code}\n"

describe "REQ-004 restore operation views":
    # @manual scenario evidence
    it "restores exact files and deletes tracked paths absent from the target tree":
        # @req REQ-SSPEC-SYSTEM
        # @req REQ-004
        # @req REQ-004
        # @req REQ-SSPEC-SYSTEM
        step("restores exact files and deletes tracked paths absent from the target tree")
        val script = "set -eu\nREPO=$(pwd)\nTMP=$(mktemp -d /tmp/scv-doc-restore.XXXXXX)\nprintf 'base\\n' > \"$TMP/a.txt\"\ncd \"$TMP\"\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" init >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nBASE_OP=$(cat .scv/HEAD_OP)\nprintf 'later\\n' > b.txt\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" snapshot >/dev/null\nSIMPLE_LIB=\"$REPO/src\" \"$REPO/bin/simple\" run \"$REPO/src/app/scv/main.spl\" restore-op \"$BASE_OP\"\ntest ! -e b.txt\nprintf 'a=%s\\n' \"$(cat a.txt | tr '\\n' '|')\"\n"
        val out = _scv_restore_doc_script(script)
        expect(out).to_contain("restored 1")
        expect(out).to_contain("a=base|")

describe "SCV restore preflight":
    # @manual scenario evidence
    it "validates a complete target without changing repository or worktree bytes":
        step("setup a target and a later working view")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-check.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(file_write("{root}/a", "base bytes")).to_equal(true)
        expect(scv_init_repo(root)).to_equal("initialized\n")
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        val target = scv_current_op(root)
        expect(file_write("{root}/a", "later bytes")).to_equal(true)
        expect(file_write("{root}/b", "later file")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        step("capture every user-visible subject")
        val before_head = file_read("{root}/.scv/HEAD_OP")
        val before_workspace = file_read("{root}/.scv/meta/workspaces.sdn")
        val before_bookmarks = file_read("{root}/.scv/meta/bookmarks.sdn")
        val before_index = file_read("{root}/.scv/meta/status_index.sdn")
        val before_a = file_read("{root}/a")
        val before_b = file_read("{root}/b")
        step("validate target without publishing it")
        val result = scv_restore_preflight(root, target)
        step("assert no state changed and no publication guarantee was implied")
        expect(result).to_contain("preflight complete")
        expect(result).to_contain("mutation=unsupported")
        expect(file_read("{root}/.scv/HEAD_OP")).to_equal(before_head)
        expect(file_read("{root}/.scv/meta/workspaces.sdn")).to_equal(before_workspace)
        expect(file_read("{root}/.scv/meta/bookmarks.sdn")).to_equal(before_bookmarks)
        expect(file_read("{root}/.scv/meta/status_index.sdn")).to_equal(before_index)
        expect(file_read("{root}/a")).to_equal(before_a)
        expect(file_read("{root}/b")).to_equal(before_b)

    it "rejects deleting a dirty tracked file while leaving it untouched":
        step("setup tracked file and target without it")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-dirty-delete.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(scv_init_repo(root)).to_equal("initialized\n")
        expect(file_write("{root}/a", "base")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        val target = scv_current_op(root)
        expect(file_write("{root}/b", "tracked before delete")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        expect(file_write("{root}/b", "unsaved user edit")).to_equal(true)
        step("check deletion target")
        val result = scv_restore_preflight(root, target)
        step("preserve the unsaved bytes and report the exact conflict")
        expect(result).to_contain("ERROR dirty tracked path absent from target: b")
        expect(file_read("{root}/b")).to_equal("unsaved user edit")
        expect(file_read("{root}/.scv/HEAD_OP")).to_equal(scv_current_op(root) + "\n")

    it "rejects an untracked destination collision without replacing the file":
        step("create a target containing a path absent from the current index")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-untracked.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(scv_init_repo(root)).to_equal("initialized\n")
        expect(file_write("{root}/a", "base")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        expect(file_write("{root}/b", "target bytes")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        val target = scv_current_op(root)
        expect(file_delete("{root}/b")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        expect(file_write("{root}/b", "untracked user data")).to_equal(true)
        step("check the target collision")
        val result = scv_restore_preflight(root, target)
        step("preserve the untracked bytes")
        expect(result).to_contain("ERROR untracked target collision: b")
        expect(file_read("{root}/b")).to_equal("untracked user data")

    it "refuses an unresolved WAL without replaying or changing repository state":
        step("setup and create an unresolved snapshot transaction")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-pending-wal.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(scv_init_repo(root)).to_equal("initialized\n")
        expect(file_write("{root}/a", "base")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        val target = scv_current_op(root)
        val head = file_read("{root}/.scv/HEAD_OP")
        val workspace = file_read("{root}/.scv/meta/workspaces.sdn")
        expect(file_write("{root}/.scv/journal/wal.log", "BEGIN op=interrupted\nSET path=HEAD_OP old={head.trim()}\nSET path=meta/workspaces.sdn old=default%3A%20base\nNEW commit=commit_missing\n")).to_equal(true)
        step("preflight without invoking WAL recovery")
        val result = scv_restore_preflight(root, target)
        step("keep the unresolved record and views unchanged")
        expect(result).to_contain("ERROR repository WAL pending")
        expect(file_read("{root}/.scv/HEAD_OP")).to_equal(head)
        expect(file_read("{root}/.scv/meta/workspaces.sdn")).to_equal(workspace)
        expect(file_read("{root}/.scv/journal/wal.log")).to_contain("BEGIN op=interrupted")

    it "rejects a missing target operation without touching the repository":
        step("setup an initialized repository")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-missing-op.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(scv_init_repo(root)).to_equal("initialized\n")
        val head = file_read("{root}/.scv/HEAD_OP")
        step("check an absent operation")
        val result = scv_restore_preflight(root, "op_missing")
        step("report the absence without changing the head")
        expect(result).to_equal("ERROR missing operation\n")
        expect(file_read("{root}/.scv/HEAD_OP")).to_equal(head)

    it "rejects corrupt target bytes before any worktree write":
        step("setup and save a target operation")
        val (out, _, code) = process_run("mktemp", ["-d", "/tmp/scv-restore-corrupt.XXXXXX"])
        expect(code).to_equal(0)
        val root = out.trim()
        expect(scv_init_repo(root)).to_equal("initialized\n")
        expect(file_write("{root}/a", "target bytes")).to_equal(true)
        expect(scv_snapshot(root)).to_start_with("snapshot ")
        val target = scv_current_op(root)
        val target_bytes = file_read("{root}/a")
        val target_op_content = file_read("{root}/.scv/HEAD_OP")
        val chunk = file_read("{root}/.scv/meta/status_index.sdn").split("|")[2]
        expect(file_delete("{root}/.scv/objects/chunks/{chunk}.blob")).to_equal(true)
        step("check a target whose immutable chunk is missing")
        val result = scv_restore_preflight(root, target)
        step("fail closed and preserve worktree bytes")
        expect(result).to_contain("ERROR missing chunk: {chunk}")
        expect(file_read("{root}/a")).to_equal(target_bytes)
        expect(file_read("{root}/.scv/HEAD_OP")).to_equal(target_op_content)
