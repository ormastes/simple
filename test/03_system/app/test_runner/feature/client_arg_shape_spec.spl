use std.spec.*
use app.test_runner_new.client_arg_shape.{client_flag_consumes_value}
use std.test_runner.test_runner_args.{test_args_validation_error}

describe "Explicit test path argument scanning":
    it "skips every public option value while counting explicit specs":
        val value_flags = [
            "--timeout", "--tag", "--format", "--mode", "--native-backend", "--native-source",
            "--library-mode", "--seed", "--max-mem", "--worker-memory-mb", "--max-procs",
            "--execution-mode", "--cpu-threshold", "--mem-threshold", "--resource-limit",
            "--max-workers", "--parallel-timeout", "--fuzz-time", "--fuzz-corpus",
            "--chaos-trials", "--chaos-fault-rate", "--deploy-platform", "--batch-size",
            "--session-kind", "--max-sessions", "--session-reset", "--sdoctest-env", "--profile"
        ]
        for flag in value_flags:
            expect(client_flag_consumes_value(flag)).to_equal(true)

    it "keeps booleans, inline values, and the option separator out of value-taking classification":
        expect(client_flag_consumes_value("--parallel")).to_equal(false)
        expect(client_flag_consumes_value("--no-session-daemon")).to_equal(false)
        expect(client_flag_consumes_value("--tag=slow")).to_equal(false)
        expect(client_flag_consumes_value("--worker-memory-mb=128")).to_equal(false)
        expect(client_flag_consumes_value("--")).to_equal(false)

    it "rejects an option token consumed where a separated value is required":
        expect(test_args_validation_error(["--tag", "--parallel"]) != "").to_equal(true)
        expect(test_args_validation_error(["--timeout", "--"]) != "").to_equal(true)
        expect(test_args_validation_error(["--tag", "fast"]) == "").to_equal(true)

    it "keeps a permitted negative decimal as the value of its numeric option":
        expect(client_flag_consumes_value("--cpu-threshold")).to_equal(true)
        expect(test_args_validation_error(["--cpu-threshold", "-1.5"]) == "").to_equal(true)
