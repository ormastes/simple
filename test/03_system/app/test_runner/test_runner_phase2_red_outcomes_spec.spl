"""
# Every red outcome is FAIL, per kind, with phase2 selected

For unit, integration, system and smoke fixtures run via
`simple test --compiler=phase2`, each failure mode must be reported as FAIL
with a non-zero exit, never PASS, never SKIP, never exit 0: phase2 CLI crash
(SIGSEGV), timeout, load error, and a CLI that exits 0 without any result
line (false-green guard). Assertion failures are covered by
test_runner_phase2_four_kinds_spec.spl. A sha256 mismatch between the
declared and the actual phase2 CLI must refuse to run (exit 2).

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use test.support.phase2_kinds_fixture.{KIND_NAMES, phase2_fixture_root, phase2_write_fixture, phase2_write_faulty_cli, phase2_write_load_error_fixture, phase2_write_recording_cli}

val SHA: text = "abababababababababababababababababababababababababababababababab"
val OTHER_SHA: text = "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd"

fn real_binary() -> text:
    val b = env_get("SIMPLE_BINARY")
    if b != "":
        return b
    "bin/simple"

fn run_with(cli: text, sha: text, extra: [text], target: text) -> (text, i64):
    var args = ["SIMPLE_PHASE2_FULL_CLI=" + cli, "SIMPLE_PHASE2_FULL_CLI_SHA256=" + sha, real_binary(), "test", "--compiler=phase2", "--no-session-daemon"]
    for a in extra:
        args.push(a)
    args.push(target)
    val (out, err, code) = process_run_bounded("env", args, 240000, 4194304)
    (out + err, code)

fn expect_red(report: text, code: i64):
    expect(code).to_be_greater_than(0)
    expect(report).to_contain("FAIL")
    expect(report.contains("PASS test")).to_equal(false)
    expect(report.contains("SKIP")).to_equal(false)

describe "red outcomes are FAIL for every kind":
    it "reports a phase2 CLI crash as FAIL":
        val root = phase2_fixture_root("phase2-red-crash-")
        val cli = phase2_write_faulty_cli(root, "crash")
        var i = 0
        while i < 4:
            step("crash, {KIND_NAMES[i]}")
            val (report, code) = run_with(cli, SHA, [], phase2_write_fixture(root, i, false))
            expect_red(report, code)
            i = i + 1

    it "reports a phase2 CLI timeout as FAIL":
        val root = phase2_fixture_root("phase2-red-hang-")
        val cli = phase2_write_faulty_cli(root, "hang")
        var i = 0
        while i < 4:
            step("timeout, {KIND_NAMES[i]}")
            val (report, code) = run_with(cli, SHA, ["--timeout", "3"], phase2_write_fixture(root, i, false))
            expect_red(report, code)
            i = i + 1

    it "reports a load error as FAIL":
        val root = phase2_fixture_root("phase2-red-load-")
        val cli = phase2_write_recording_cli(root, real_binary())
        var i = 0
        while i < 4:
            step("load error, {KIND_NAMES[i]}")
            val (report, code) = run_with(cli, SHA, [], phase2_write_load_error_fixture(root, i))
            expect_red(report, code)
            i = i + 1

    it "does not turn a result-less exit 0 into PASS":
        val root = phase2_fixture_root("phase2-red-garbage-")
        val cli = phase2_write_faulty_cli(root, "garbage")
        var i = 0
        while i < 4:
            step("no result line, {KIND_NAMES[i]}")
            val (report, code) = run_with(cli, SHA, [], phase2_write_fixture(root, i, false))
            expect_red(report, code)
            i = i + 1

describe "phase2 CLI identity":
    it "refuses a CLI whose sha256 does not match the declared one":
        val root = phase2_fixture_root("phase2-red-sha-")
        val cli = phase2_write_recording_cli(root, real_binary())
        val (report, code) = run_with(cli, OTHER_SHA, [], phase2_write_fixture(root, 0, false))
        expect(code).to_equal(2)
        expect(report).to_contain("sha256")
