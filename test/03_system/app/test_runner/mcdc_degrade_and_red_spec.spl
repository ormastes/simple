# @req REQ-MCDC-ENFORCEMENT-005
"""
# Instrumentation failure is an explicit degrade; a red spec stays FAIL

When the instrumented MC/DC compile cannot handle a spec, the runner may fall
back to the interpreter only if it says so on the verdict line and in the
output. It must never present that run as MC/DC-covered. A genuinely failing
spec must stay FAIL on every path, instrumented or degraded.
"""

use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_write}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.test_runner.test_runner_execute.{mcdc_compiler_lacks_probes, MCDC_UNAVAILABLE_DEGRADE_TOKEN}

# Same gate as mcdc_real_instrumentation_spec: only a pure-Simple-built
# compiler emits MC/DC probes; the Rust seed never does.
val MCDC_COMPILER_GATE_REASON = "requires SIMPLE_MCDC_COMPILER naming a self-hosted (pure-Simple-built) compiler that emits MC/DC probes; the Rust seed cannot"
val SEED_GATE_REASON = "SIMPLE_BINARY emits MC/DC probes, so the seed's mcdc-unavailable degrade does not apply"

val GREEN = "use std.spec\ndescribe \"g\":\n    it \"green\":\n        val a = 3\n        if a > 1 and a < 5:\n            expect(a).to_equal(3)\n"
val RED = "use std.spec\ndescribe \"r\":\n    it \"red\":\n        val a = 3\n        if a > 1 and a < 5:\n            expect(a).to_equal(4)\n"
val UNDEFINED = "use std.spec\ndescribe \"u\":\n    it \"calls an undefined function\":\n        val a = 3\n        if a > 1 and a < 5:\n            expect(mcdc_kind_undefined_fn_zz(a)).to_equal(3)\n"

# MC/DC variables the outer runner may have set; each child run starts clean
# so a CI waiver or mode cannot flip the default-profile examples.
val UNSET_MCDC_ENV = ["-u", "SIMPLE_MCDC_MODE", "-u", "SIMPLE_MCDC_MODE_ERROR", "-u", "SIMPLE_MCDC_OFF_WAIVER_REASON", "-u", "SIMPLE_MCDC_OFF_WAIVER_REVIEWER", "-u", "SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID", "-u", "SIMPLE_MCDC_OFF_WAIVER_VERSION"]
val NO_BINARY = "error: SIMPLE_BINARY is unset; set it to the compiler under test (no fallback to the deployed bin/simple)"

# The compiler under test. Deliberately no fallback to bin/simple, which is
# the deployed binary and may be stale.
fn real_binary() -> text:
    env_get("SIMPLE_BINARY")

fn make_case(case: text, name: text, body: text) -> text:
    val dir = "build/mcdc_kind/" + case
    process_run_bounded("rm", ["-rf", dir], 10000, 65536)
    process_run_bounded("mkdir", ["-p", dir], 10000, 65536)
    file_write(dir + "/" + name + "_spec.spl", body)
    dir

fn mcdc_compiler() -> text:
    env_get("SIMPLE_MCDC_COMPILER")

fn probe_capable_compiler_absent() -> bool:
    val compiler = mcdc_compiler()
    compiler == "" or mcdc_compiler_lacks_probes(compiler)

# An unset SIMPLE_BINARY is NOT a skip: the seed example then fails with NO_BINARY.
fn binary_emits_probes() -> bool:
    real_binary() != "" and not mcdc_compiler_lacks_probes(real_binary())

fn run_dir(dir: text, envs: [text], extra: [text]) -> (text, i64):
    run_dir_with(real_binary(), dir, envs, extra)

# The probe-capable lane forces MC/DC on, so "no degrade" cannot mean "MC/DC was off".
fn run_dir_mcdc(dir: text) -> (text, i64):
    run_dir_with(mcdc_compiler(), dir, ["SIMPLE_MCDC_MODE=on"], [])

fn run_dir_with(binary: text, dir: text, envs: [text], extra: [text]) -> (text, i64):
    if binary == "":
        return (NO_BINARY, 127)
    val argv = UNSET_MCDC_ENV + envs + ["SIMPLE_BINARY=" + binary, binary, "test", dir, "--no-db", "--no-cache", "--assert-ran"] + extra
    val (out, err, code) = process_run_bounded("env", argv, 600000, 8388608)
    (out + err, code)

fn verdict_line(output: text) -> text:
    for line in output.split("\n"):
        if line.starts_with("SPEC FILE VERDICT:"):
            return line
    ""

describe "instrumentation failure is explicit":
    it "marks a spec that cannot compile standalone with degraded= on the verdict line":
        step("Run a spec the standalone SMF compile cannot handle")
        val dir = make_case("degrade_undefined", "u", UNDEFINED)
        val (output, code) = run_dir(dir, [], [])
        val verdict = verdict_line(output)
        expect(verdict).to_contain("degraded=")
        expect(code == 0).to_equal(false)

    it "prints the [mcdc-fallback] line whenever it degrades":
        step("Look for the human-readable degrade line")
        val dir = make_case("degrade_line", "u", UNDEFINED)
        val (output, _code) = run_dir(dir, [], [])
        # The undefined-call fixture can never compile standalone, so this run
        # must degrade; both halves are asserted unconditionally.
        expect(verdict_line(output)).to_contain("degraded=")
        expect(output.contains("[mcdc-fallback]") or output.contains("[mcdc-unavailable]")).to_equal(true)

    it "never claims MC/DC evidence for a degraded run":
        step("A degraded run must not also print an MC/DC pass claim")
        val dir = make_case("degrade_no_claim", "u", UNDEFINED)
        val (output, _code) = run_dir(dir, [], [])
        expect(verdict_line(output)).to_contain("degraded=")
        expect(output.contains("evidence=present")).to_equal(false)
        expect(output.contains("MC/DC: all decisions covered")).to_equal(false)
        expect(output.contains("mcdc=covered")).to_equal(false)

    skip_if(fn(): probe_capable_compiler_absent(), MCDC_COMPILER_GATE_REASON)(
        "does not degrade a clean green spec",
        fn():
            step("A green spec instruments without a degrade on a probe-capable compiler")
            val dir = make_case("degrade_clean_green", "g", GREEN)
            val (output, _code) = run_dir_mcdc(dir)
            expect(verdict_line(output)).to_contain("passed=1")
            expect(verdict_line(output).contains("degraded=")).to_equal(false)
            expect(output.contains("[mcdc-fallback]")).to_equal(false)
            expect(output.contains("[mcdc-unavailable]")).to_equal(false)
    )

    skip_if(fn(): binary_emits_probes(), SEED_GATE_REASON)(
        "degrades a clean green spec explicitly as mcdc-unavailable on the seed",
        fn():
            step("The seed cannot emit probes, so the degrade is named, not silent")
            val dir = make_case("degrade_clean_green_seed", "g", GREEN)
            val (output, _code) = run_dir(dir, [], [])
            expect(verdict_line(output)).to_contain("passed=1")
            expect(verdict_line(output)).to_contain(MCDC_UNAVAILABLE_DEGRADE_TOKEN)
            expect(output).to_contain("MC/DC: NOT compliant")
    )

describe "a red spec stays FAIL under MC/DC":
    it "reports failed=1 and a non-zero exit":
        step("Run a failing spec through the directory lane")
        val dir = make_case("red_basic", "r", RED)
        val (output, code) = run_dir(dir, [], [])
        val verdict = verdict_line(output)
        expect(verdict).to_contain("failed=1")
        expect(verdict.contains("outcome=OK")).to_equal(false)
        expect(code == 0).to_equal(false)

    it "stays FAIL when the mode is explicitly on":
        step("Red under SIMPLE_MCDC_MODE=on")
        val dir = make_case("red_on", "r", RED)
        val (output, code) = run_dir(dir, ["SIMPLE_MCDC_MODE=on"], [])
        expect(verdict_line(output)).to_contain("failed=1")
        expect(code == 0).to_equal(false)

    it "stays FAIL when the mode is dynamic":
        step("Red under SIMPLE_MCDC_MODE=dynamic")
        val dir = make_case("red_dynamic", "r", RED)
        val (output, code) = run_dir(dir, ["SIMPLE_MCDC_MODE=dynamic"], [])
        expect(verdict_line(output)).to_contain("failed=1")
        expect(code == 0).to_equal(false)

    it "stays FAIL when the instrumented compile degrades":
        step("Red and uncompilable at once")
        val dir = make_case("red_degraded", "u", UNDEFINED.replace("to_equal(3)", "to_equal(4)"))
        val (output, code) = run_dir(dir, [], [])
        expect(verdict_line(output).contains("outcome=OK")).to_equal(false)
        expect(code == 0).to_equal(false)

    it "does not let a green sibling mask a red spec":
        step("Two specs in one directory, one red")
        val dir = make_case("red_sibling", "r", RED)
        file_write(dir + "/g_spec.spl", GREEN)
        val (output, code) = run_dir(dir, [], [])
        expect(output).to_contain("failed=1")
        expect(code == 0).to_equal(false)
