# @req REQ-MCDC-ENFORCEMENT-005
"""
# MC/DC under --no-session-daemon is applied or explicitly reported, never skipped silently

`simple test <spec> --no-session-daemon` routes to the single-file lane. That
lane must not quietly drop MC/DC: the run either instruments the spec and
reports decisions, or states an explicit degrade/skip. A directory target is
refused rather than passing silently.
"""

use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.file_ops.{file_write}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

val FIXTURE = "use std.spec\ndescribe \"conditions\":\n    it \"if and or\":\n        val a = 3\n        val b = 7\n        var hits = 0\n        if a > 1 and b < 10:\n            hits = hits + 1\n        if a > 5 or b > 5:\n            hits = hits + 1\n        expect(hits).to_equal(2)\n"

# MC/DC variables the outer runner may have set; each child run starts clean
# so a CI waiver or mode cannot flip the default-profile examples.
val UNSET_MCDC_ENV = ["-u", "SIMPLE_MCDC_MODE", "-u", "SIMPLE_MCDC_MODE_ERROR", "-u", "SIMPLE_MCDC_OFF_WAIVER_REASON", "-u", "SIMPLE_MCDC_OFF_WAIVER_REVIEWER", "-u", "SIMPLE_MCDC_OFF_WAIVER_REVIEW_ID", "-u", "SIMPLE_MCDC_OFF_WAIVER_VERSION"]
val NO_BINARY = "error: SIMPLE_BINARY is unset; set it to the compiler under test (no fallback to the deployed bin/simple)"

# The compiler under test. Deliberately no fallback to bin/simple, which is
# the deployed binary and may be stale.
fn real_binary() -> text:
    env_get("SIMPLE_BINARY")

fn make_case(case: text, name: text, body: text) -> text:
    val dir = "build/mcdc_kind/" + case
    process_run_bounded("rm", ["-rf", dir], 10000, 65536)
    process_run_bounded("mkdir", ["-p", dir], 10000, 65536)
    file_write(dir + "/" + name + "_spec.spl", body)
    dir

fn run_target(target: text, envs: [text], extra: [text]) -> (text, i64):
    if real_binary() == "":
        return (NO_BINARY, 127)
    val argv = UNSET_MCDC_ENV + envs + [real_binary(), "test", target, "--no-session-daemon", "--no-db", "--no-cache"] + extra
    val (out, err, code) = process_run_bounded("env", argv, 600000, 8388608)
    (out + err, code)

fn verdict_line(output: text) -> text:
    for line in output.split("\n"):
        if line.starts_with("SPEC FILE VERDICT:"):
            return line
    ""

fn mentions_mcdc(output: text) -> bool:
    var kept: [text] = []
    for line in output.split("\n"):
        if not line.contains("co-compiled") and not line.contains("[gc-warning]"):
            kept.push(line)
    val stripped = kept.join("\n").replace("mcdc_kind", "")
    stripped.contains("MC/DC") or stripped.contains("mcdc") or stripped.contains("MCDC")

# True only when an MC/DC report line names decisions. The case path is
# removed first so a fixture directory name can never satisfy the check.
fn mcdc_report_names_decisions(output: text, dir: text) -> bool:
    for line in output.replace(dir, "").split("\n"):
        if line.contains("MC/DC") and line.contains("decision"):
            return true
    false

# Body of the skipped "reports decisions" example. The case dir name must not
# contain "decision" (it used to, which made the old check vacuous).
fn check_nodaemon_reports_decisions():
    step("Require decisions in the single-file lane output")
    val dir = make_case("nodaemon_report", "cond", FIXTURE)
    val (output, _code) = run_target(dir + "/cond_spec.spl", [], [])
    expect(output.contains("[mcdc-fallback]")).to_equal(false)
    expect(mcdc_report_names_decisions(output, dir)).to_equal(true)

describe "simple test <file> --no-session-daemon":
    it "runs the fixture and reports it passed":
        step("Run the and/or fixture through the single-file lane")
        val dir = make_case("nodaemon_basic", "cond", FIXTURE)
        val (output, code) = run_target(dir + "/cond_spec.spl", [], [])
        expect(verdict_line(output)).to_contain("passed=1")
        expect(code).to_equal(0)

    it "does not skip MC/DC silently: the output mentions MC/DC or a degrade":
        step("Look for any MC/DC statement in the single-file lane output")
        val dir = make_case("nodaemon_not_silent", "cond", FIXTURE)
        val (output, _code) = run_target(dir + "/cond_spec.spl", [], [])
        expect(mentions_mcdc(output) or verdict_line(output).contains("degraded=")).to_equal(true)

    # RED until the runner reports decisions; restore as
    # `it "reports decisions for the instrumented single-file run": check_nodaemon_reports_decisions()`.
    skip("reports decisions for the instrumented single-file run", "red until fixed: doc/08_tracking/bug/mcdc_runner_never_finalizes_evidence_2026-10-30.md")

    it "still fails a red spec":
        step("Run a failing spec through the single-file lane")
        val dir = make_case("nodaemon_red", "red", "use std.spec\ndescribe \"r\":\n    it \"red\":\n        expect(1 + 1).to_equal(3)\n")
        val (output, code) = run_target(dir + "/red_spec.spl", [], [])
        expect(code == 0).to_equal(false)
        expect(verdict_line(output)).to_contain("failed=1")

    it "refuses to treat a directory as a single-file lane target, loudly":
        step("Pass a directory with --no-session-daemon")
        val dir = make_case("nodaemon_dir", "cond", FIXTURE)
        val (output, code) = run_target(dir, [], [])
        expect(code == 0).to_equal(false)
        expect(output).to_contain("expected .spl test file")
