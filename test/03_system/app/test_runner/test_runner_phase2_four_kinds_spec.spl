"""
# Test runner runs the 4 test kinds with the phase2 compiler

`simple test --compiler=phase2` over a tiny green and a tiny red fixture of
each kind (unit, integration, system, smoke): green gives PASS and exit 0,
red gives FAIL and exit 1. A recording stand-in for the phase2 CLI proves
phase2 was the compiler used.

# @req REQ-TESTRUNNER-PHASE2-4KINDS
"""

use std.spec.*
use std.spec.step
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use test.support.phase2_kinds_fixture.{KIND_NAMES, phase2_fixture_root, phase2_write_fixture, phase2_write_recording_cli, phase2_log, phase2_sha256_of}

fn real_binary() -> text:
    val b = env_get("SIMPLE_BINARY")
    if b != "":
        return b
    "bin/simple"

fn run_phase2(cli: text, target: text) -> (text, i64):
    val (out, err, code) = process_run_bounded("env", ["SIMPLE_PHASE2_FULL_CLI=" + cli, "SIMPLE_PHASE2_FULL_CLI_SHA256=" + phase2_sha256_of(cli), real_binary(), "test", "--compiler=phase2", "--no-session-daemon", target], 300000, 4194304)
    (out + err, code)

describe "simple test --compiler=phase2 over the 4 kinds":
    it "reports each green kind as PASS with exit 0":
        val root = phase2_fixture_root("phase2-kinds-sys-")
        val cli = phase2_write_recording_cli(root, real_binary())
        var i = 0
        while i < 4:
            step("Run the green {KIND_NAMES[i]} fixture")
            val (report, code) = run_phase2(cli, phase2_write_fixture(root, i, false))
            expect(code).to_equal(0)
            expect(report).to_contain("PASS")
            i = i + 1

    it "reports each red kind as FAIL with exit 1":
        val root = phase2_fixture_root("phase2-kinds-sys-red-")
        val cli = phase2_write_recording_cli(root, real_binary())
        var i = 0
        while i < 4:
            step("Run the red {KIND_NAMES[i]} fixture")
            val (report, code) = run_phase2(cli, phase2_write_fixture(root, i, true))
            expect(code).to_equal(1)
            expect(report).to_contain("FAIL")
            i = i + 1

    it "uses the phase2 CLI to run the fixtures":
        val root = phase2_fixture_root("phase2-kinds-sys-used-")
        val cli = phase2_write_recording_cli(root, real_binary())
        run_phase2(cli, phase2_write_fixture(root, 0, false))
        expect(phase2_log(cli)).to_contain("unit_green_spec.spl")
