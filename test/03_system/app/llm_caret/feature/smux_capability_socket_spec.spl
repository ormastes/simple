# AUTHORED_UNRUN. Real compiled CLI/socket acceptance, not Container binding.
use std.spec.{describe, it, expect, fail}
use test.helpers.smux_owned_process_fixture.owned_fixture_config_for
use test.helpers.smux_capability_socket_fixture.{SmuxCapabilitySocketFixture,
    smux_capability_fixture_start, smux_capability_fixture_stop, capability_socket_exercise}

var retained_smux_capability_fixture: SmuxCapabilitySocketFixture? = nil

describe "real compiled smux capability socket client":
    it "classifies capability discovery and explicit refusals through separate real CLI processes":
        val config = owned_fixture_config_for("SMUX_SOCKET_TEST_CONFIG", "smuxProgram", "smuxDigest")
        if config.is_err():
            fail(config.unwrap_err())
            return
        var fixture = smux_capability_fixture_start(config.unwrap())
        retained_smux_capability_fixture = fixture
        fixture = capability_socket_exercise(fixture)
        retained_smux_capability_fixture = fixture
        fixture = smux_capability_fixture_stop(fixture)
        retained_smux_capability_fixture = fixture
        if fixture.process.failure != "":
            fail(fixture.process.failure)
            return
        expect(fixture.stop_accepted).to_equal(true)
        expect(fixture.owner_stdout_eof).to_equal(true)
        expect(fixture.process.cleanup_attempted).to_equal(true)
        expect(fixture.process.helper_cleaned).to_equal(true)
