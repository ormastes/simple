# AUTHORED_UNRUN. Actual broker-backed helper scenario; no production host lease.
use std.spec.{describe, it, expect, fail}
use test.helpers.smux_owned_process_fixture.{SmuxOwnedFixture, smux_owned_fixture_config,
    smux_owned_fixture_start, smux_owned_fixture_adopt, smux_owned_fixture_poll, smux_owned_fixture_cleanup}

# Retain post-spawn authority even when an assertion fails in this isolated test.
var retained_smux_owned_fixture: SmuxOwnedFixture? = nil

describe "real owned helper transfer into smux":
    it "retains complete authority across observed output and one-shot helper cleanup":
        val configured = smux_owned_fixture_config()
        if configured.is_err():
            fail(configured.unwrap_err())
            return
        var fixture = smux_owned_fixture_start(configured.unwrap())
        retained_smux_owned_fixture = fixture
        fixture = smux_owned_fixture_adopt(fixture)
        retained_smux_owned_fixture = fixture
        fixture = smux_owned_fixture_poll(fixture)
        retained_smux_owned_fixture = fixture
        fixture = smux_owned_fixture_cleanup(fixture)
        retained_smux_owned_fixture = fixture
        if fixture.failure != "":
            fail(fixture.failure)
            return
        expect(fixture.launch_ready).to_equal(true)
        expect(fixture.adopted).to_equal(true)
        expect(fixture.cleanup_attempted).to_equal(true)
        expect(fixture.helper_cleaned).to_equal(true)
        # No HostHelperLease, reservation release or signed Container admission
        # was created. The pane/bundle remain pending a real host acknowledgement.
