# AUTHORED_UNRUN. Actual enrolled authority, compiled sockets and Container only.
use std.spec.{describe, it, expect, fail}
use test.helpers.smux_signed_binding_fixture_v3.{SignedBindingFixtureV3,
    signed_binding_fixture_config_v3, signed_binding_fixture_start_v3,
    signed_binding_fixture_exercise_v3, signed_binding_fixture_finish_v3}

# Remains available after every returned effect outcome, including retained
# nested authority requiring external reconciliation. Never serialize live refs.
var retained_signed_binding_fixture_v3: SignedBindingFixtureV3? = nil

describe "real signed configured smux binding":
    it "binds an actual running workload through signed helper admission and settles only the attachment":
        val config = signed_binding_fixture_config_v3()
        if config.is_err():
            fail(config.unwrap_err())
            return
        var fixture = signed_binding_fixture_start_v3(config.unwrap())
        retained_signed_binding_fixture_v3 = fixture
        fixture = signed_binding_fixture_exercise_v3(fixture)
        retained_signed_binding_fixture_v3 = fixture
        fixture = signed_binding_fixture_finish_v3(fixture)
        retained_signed_binding_fixture_v3 = fixture
        if fixture.failure != "":
            fail(fixture.failure)
            return
        if fixture.socket == nil:
            fail("actual retained socket fixture unavailable")
            return
        val socket = fixture.socket.unwrap()
        if socket.process.failure != "":
            fail(socket.process.failure)
            return
        expect(fixture.binding_attempted).to_equal(true)
        expect(fixture.marker_observed).to_equal(true)
        expect(fixture.released).to_equal(true)
        expect(fixture.workload_still_running).to_equal(true)
        expect(socket.stop_accepted).to_equal(true)
        expect(socket.owner_stdout_eof).to_equal(true)
        expect(socket.process.helper_cleaned).to_equal(true)
