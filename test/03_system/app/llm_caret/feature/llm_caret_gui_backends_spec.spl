# codex-system-test
# @evidence-display: links
# @capture gui
# @capture text
# @cover src/app/llm_caret/gui_native_model.spl 80%
# @cover src/app/llm_caret/gui.spl 80%
"""# LLM Caret GUI Backends

Exercises native prompt submission and the semantic HTML-to-Draw-IR contract
shared by the Electron and Engine2D Metal launch paths.

**Requirement IDs:** REQ-002, REQ-004, REQ-005, REQ-006
**Plan:** doc/03_plan/sys_test/llm_caret_cli_tui_hardening.md

## Evidence boundary

The in-process scenarios verify production GUI state, semantic HTML, and the
Draw-IR handoff. The live scenarios invoke the shipped cached artifacts and
fail closed unless browser, Electron, and the separate GPU companion each open
a real window and retain a screenshot plus protocol/process evidence.

**Screenshots:**
`build/test-artifacts/03_system/app/llm_caret/feature/llm_caret_gui_live/`
"""

use app.llm_caret.gui_native_model.{caret_native_state, caret_native_key,
    caret_native_apply_response}
use app.llm_caret.gui.{caret_gui_native_html}
use app.llm_caret.provider.{dispatch_send}
use app.io.mod.{process_run_timeout}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir}

struct CaretGuiLiveEvidence:
    stdout: text
    stderr: text
    exit_code: i32

fn run_caret_gui_live_case(case_name: text) -> CaretGuiLiveEvidence:
    val (stdout, stderr, exit_code) = process_run_timeout(
        "sh",
        ["scripts/check/check-llm-caret-gui-live.shs", "--case", case_name],
        120000)
    CaretGuiLiveEvidence(stdout: stdout, stderr: stderr, exit_code: exit_code)

describe "LLM Caret Electron and pure-Simple Metal GUI backends":
    it "REQ-002 and REQ-006 submit test to the dummy provider":
        step("Prepare the native Caret GUI state")
        var state = caret_native_state()
        for key in [84, 69, 83, 84]:
            state = caret_native_key(state, key).state

        step("Submit the visible prompt through the dummy provider")
        val submitted = caret_native_key(state, 13)
        expect(submitted.submit_prompt).to_equal("test")
        val response = dispatch_send("dummy", submitted.submit_prompt, "", "", "", "", "", "", 0, 0, "[]")
        val final_state = caret_native_apply_response(submitted.state, submitted.submit_prompt, response.content)

        step("Check the rendered conversation state")
        expect(final_state.assistant).to_equal("hello")

    it "REQ-004 lowers semantic Caret HTML through Draw IR":
        step("Prepare semantic Caret HTML")
        val html = caret_gui_native_html("", "test", "hello", "metal", "connected")
        expect(html).to_contain("You: test")
        expect(html).to_contain("Assistant: hello")

        step("Lower the GUI surface through Draw IR")
        val composition = simple_web_layout_render_html_draw_ir(html, 480, 320)

        step("Check the retained Draw IR evidence")
        expect(composition.scene_key).to_equal("simple-web-html-layout")
        expect(composition.batches.len()).to_be_greater_than(0)
        expect(composition.batches[0].source.source_kind).to_equal("html_ast")
        expect(composition.batches[0].commands.len()).to_be_greater_than(0)

    it "REQ-005 exposes explicit Metal and accessibility semantics":
        step("Prepare the Metal GUI semantic surface")
        val html = caret_gui_native_html("test", "", "", "metal", "connected")

        step("Inspect backend and accessibility attributes")
        expect(html).to_contain("aria-label=\"LLM Caret native chat\"")
        expect(html).to_contain("data-backend=\"metal\"")
        expect(html).to_contain("Message LLM Caret: test")

    it "should launch the browser GUI and complete a visible dummy-provider turn":
        step("Launch the provenance-qualified Caret browser GUI")
        val result = run_caret_gui_live_case("browser")
        step("Send test through the live loopback GUI and capture the visible window")
        expect(result.stdout).to_contain("case=browser-live status=PASS")
        expect(result.stdout).to_contain("browser.png")
        expect(result.stdout).to_contain("browser-chat.http")
        expect(result.stdout).to_contain("launch_cwd=/")
        step("Check the live browser evidence verdict")
        expect(result.stdout).to_contain("evidence_status=PASS")
        expect(result.exit_code).to_equal(0)

    it "should launch Electron with the live Caret page and retain a visible capture":
        step("Launch the provenance-qualified Caret Electron GUI")
        val result = run_caret_gui_live_case("electron")
        step("Observe the live Electron child and capture its visible window")
        expect(result.stdout).to_contain("case=electron-live status=PASS")
        expect(result.stdout).to_contain("electron.png")
        expect(result.stdout).to_contain("electron-devtools.http")
        expect(result.stdout).to_contain("launch_cwd=/")
        step("Check the live Electron evidence verdict")
        expect(result.stdout).to_contain("evidence_status=PASS")
        expect(result.exit_code).to_equal(0)

    it "should launch the Metal companion and present device-readback pixels":
        step("Launch the provenance-qualified Caret Metal companion")
        val result = run_caret_gui_live_case("metal")
        step("Observe a live Winit window after Metal device readback and present")
        expect(result.stdout).to_contain("case=metal-live status=PASS")
        expect(result.stdout).to_contain("metal.png")
        expect(result.stdout).to_contain("metal.events")
        step("Check the live Metal evidence verdict")
        expect(result.stdout).to_contain("evidence_status=PASS")
        expect(result.exit_code).to_equal(0)

    it "should fail closed when live GUI prerequisites are absent":
        step("Inspect cached runtime and host capture prerequisites")
        val result = run_caret_gui_live_case("prerequisites")
        step("Check that every prerequisite produced an executable verdict")
        expect(result.stdout).to_contain("artifact_root=")
        expect(result.stdout).to_contain("failed_cases=0")
        expect(result.stdout).to_contain("evidence_status=PASS")
        expect(result.exit_code).to_equal(0)
