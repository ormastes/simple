# codex-system-test
# @evidence-display: links
# @capture gui
# @capture text
# @cover src/app/llm_caret/gui_native_model.spl 80%
# @cover src/app/llm_caret/gui.spl 80%
"""# LLM Caret GUI Backends

Exercises native prompt submission and the semantic HTML-to-Draw-IR contract
shared by the Electron and Engine2D Metal launch paths.

**Requirement IDs:** REQ-002, REQ-004, REQ-005, REQ-006
**Plan:** doc/03_plan/sys_test/llm_caret_cli_tui_hardening.md

## Evidence boundary

This source-level system contract verifies the production GUI state, semantic
HTML, and Draw-IR handoff. A live GUI launch additionally requires the
GPU-companion artifact (`gui_metal.spl`) and its GPU-capable runtime lane; it
must not be substituted with the core CLI/TUI artifact.
"""

use app.llm_caret.gui_native_model.{caret_native_state, caret_native_key,
    caret_native_apply_response}
use app.llm_caret.gui.{caret_gui_native_html}
use app.llm_caret.provider.{dispatch_send}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir}

describe "LLM Caret Electron and pure-Simple Metal GUI backends":
    it "REQ-002 and REQ-006 submit test to the dummy provider":
        step("Prepare the native Caret GUI state")
        var state = caret_native_state()
        for key in [84, 69, 83, 84]:
            state = caret_native_key(state, key).state

        step("Submit the visible prompt through the dummy provider")
        val submitted = caret_native_key(state, 13)
        expect(submitted.submit_prompt).to_equal("test")
        val response = dispatch_send("dummy", submitted.submit_prompt, "", "", "", "", "", "", 0, 0, "[]")
        val final_state = caret_native_apply_response(submitted.state, submitted.submit_prompt, response.content)

        step("Check the rendered conversation state")
        expect(final_state.assistant).to_equal("hello")

    it "REQ-004 lowers semantic Caret HTML through Draw IR":
        step("Prepare semantic Caret HTML")
        val html = caret_gui_native_html("", "test", "hello", "metal", "connected")
        expect(html).to_contain("You: test")
        expect(html).to_contain("Assistant: hello")

        step("Lower the GUI surface through Draw IR")
        val composition = simple_web_layout_render_html_draw_ir(html, 480, 320)

        step("Check the retained Draw IR evidence")
        expect(composition.scene_key).to_equal("simple-web-html-layout")
        expect(composition.batches.len()).to_be_greater_than(0)
        expect(composition.batches[0].source.source_kind).to_equal("html_ast")
        expect(composition.batches[0].commands.len()).to_be_greater_than(0)

    it "REQ-005 exposes explicit Metal and accessibility semantics":
        step("Prepare the Metal GUI semantic surface")
        val html = caret_gui_native_html("test", "", "", "metal", "connected")

        step("Inspect backend and accessibility attributes")
        expect(html).to_contain("aria-label=\"LLM Caret native chat\"")
        expect(html).to_contain("data-backend=\"metal\"")
        expect(html).to_contain("Message LLM Caret: test")
