# AUTHORED_UNRUN. Missing real enrollment, policy or compiled products fails.
use std.spec.{describe, it, expect, fail}
use test.helpers.smux_signed_binding_fixture_v3.{SignedBindingFixtureV3,
    signed_binding_fixture_config_v3, signed_binding_fixture_start_v3,
    signed_binding_fixture_exercise_v3, signed_binding_fixture_finish_v3}
use test.helpers.smux_runtime_control_fixture_v1.{runtime_control_fixture_preflight_v1, runtime_control_fixture_exercise_v1}

var retained_runtime_control_fixture_v1: SignedBindingFixtureV3? = nil

describe "authenticated runtime Input and Geometry owner":
    it "issues and revokes distinct rights on an actual adopted binding without claiming unsupported effects":
        val configured = signed_binding_fixture_config_v3()
        if configured.is_err():
            fail(configured.unwrap_err())
            return
        val prerequisites = runtime_control_fixture_preflight_v1(configured.unwrap())
        if prerequisites.is_err():
            fail(prerequisites.unwrap_err())
            return
        var fixture = signed_binding_fixture_start_v3(configured.unwrap())
        retained_runtime_control_fixture_v1 = fixture
        fixture = signed_binding_fixture_exercise_v3(fixture)
        retained_runtime_control_fixture_v1 = fixture
        if fixture.failure == "":
            val controls = runtime_control_fixture_exercise_v1(fixture)
            if controls.is_err(): fixture.failure = controls.unwrap_err()
        retained_runtime_control_fixture_v1 = fixture
        fixture = signed_binding_fixture_finish_v3(fixture)
        retained_runtime_control_fixture_v1 = fixture
        if fixture.failure != "":
            fail(fixture.failure)
            return
        expect(fixture.marker_observed).to_equal(true)
        expect(fixture.released).to_equal(true)
        expect(fixture.workload_still_running).to_equal(true)
        expect(fixture.socket.unwrap().stop_accepted).to_equal(true)
