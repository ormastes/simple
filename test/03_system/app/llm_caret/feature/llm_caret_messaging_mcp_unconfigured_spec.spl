# @req REQ-LLM-MSG-013
"""# LLM Caret Messaging MCP before configuration

As an operator, calling a messaging tool before any server is configured must
return a structured not-configured result instead of panicking at module load.
"""

use std.spec
use std.mcp_sdk.server.app.{mcp_server_handle}
use app.llm_caret.messaging.mcp.protocol.{register_messaging_tools}

describe "LLM Caret messaging MCP before configuration":
    it "reports messaging_not_configured instead of panicking":
        # @req REQ-LLM-MSG-013
        step("call chat_who with no configured server")
        register_messaging_tools()
        val reply = mcp_server_handle("{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"chat_who\",\"arguments\":{}}}")
        val text_reply = match reply:
            Some(value): value
            nil: ""
        expect(text_reply).to_contain("messaging_not_configured")
