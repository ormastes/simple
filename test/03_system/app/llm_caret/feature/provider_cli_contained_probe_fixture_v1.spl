# AUTHORED_NOT_RUN fixture checker. The real admitted Host harness supplies
# these owner-bearing turns; this module neither installs a fixture nor starts
# a host/provider task. No positive native result is fabricated here.
use std.spec.{expect, step}
use app.llm_caret.provider_cli_adapter_types_v1.ProviderCliProviderV1
use app.llm_caret.provider_cli_container_probe_v1.{ProviderCliContainedProbeTurnV1,
    ProviderCliContainedProbeReceiptV1, provider_cli_container_probe_step_v1}

# One actual cooperative step, preserving the complete returned cleanup carrier.
# The Host harness retains the returned turn even when it reports an error.
pub fn advance_real_provider_probe_fixture_v1(turn: ProviderCliContainedProbeTurnV1,
        cancel: bool = false) -> ProviderCliContainedProbeTurnV1:
    if turn.probe == None: return turn
    provider_cli_container_probe_step_v1(turn.probe.unwrap(), cancel)

# Call only after actual begin/step reports a completed receipt. Keeping this
# separate from advancement ensures an assertion cannot discard a live capture.
pub fn check_real_provider_probe_receipt_v1(turn: ProviderCliContainedProbeTurnV1,
        expected_provider: ProviderCliProviderV1, expected_index: i64,
        expected_request_digest: text, expected_native_id: text) -> ProviderCliContainedProbeReceiptV1:
    step("Verify the retired real logs transaction and exact admitted primary identity")
    expect(turn.probe.is_none()).to_equal(true)
    expect(turn.error).to_equal("")
    expect(turn.receipt.is_some()).to_equal(true)
    val receipt = turn.receipt.unwrap()
    val observed = receipt.snapshot_v1()
    expect(observed.provider).to_equal(expected_provider)
    expect(observed.probe_index).to_equal(expected_index)
    expect(observed.configuration.request_digest).to_equal(expected_request_digest)
    expect(observed.configuration.runtime.native_id).to_equal(expected_native_id)
    expect(observed.transcript_bytes).to_be_greater_than(0)
    expect(observed.transcript_bytes).to_be_less_than(131073)
    expect(observed.transcript_digest.byte_len()).to_equal(64)
    expect(observed.program_binding_digest.byte_len()).to_equal(64)
    receipt
