# REQ-MC-008 B3 real source files; authored before implementation. UNRUN.
use std.spec.{describe, context, it, expect, step}
use app.llm_process_gen.main.{check_process_document_links_v1, GeneratedFile, generate_record}
use app.cli.doc_links.{doc_links_command_v1}
use app.io.cli_lint_commands.{run_lint_command, lint_option_error}
use compiler.tools.lint.main.{apply_semantic_markdown_lint_fix_v1}
use app.doc.semantic_link_lint.{SemanticMarkdownSourceV1, SemanticMarkdownDiagnosticV1, SemanticMarkdownPlanV1, semantic_markdown_process_failures_v1, plan_semantic_markdown_links_v1, apply_semantic_markdown_links_v1}
use compiler.semantics.symbol_id.semantic_link_source.{open_semantic_link_document_v1, semantic_link_document_uri_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write, file_read, file_delete, getpid, time_now_unix_micros}
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir}
use std.nogc_sync_mut.io.dir_ops.{dir_remove}
use compiler.semantics.symbol_id.semantic_link_source.{resolve_semantic_links_source_indexed_v1}
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkFailureV1}
use std.env.platform.{get_temp_dir}

fn robust_06_semantic_docs_setup(source: text) -> text:
    val file = get_temp_dir() + "/doc-link-{getpid()}-{time_now_unix_micros()}.spl"
    expect(file_write(file, source)).to_equal(true)
    file

fn robust_06_semantic_docs_assert_refusal<T, E>(result: Result<T, E>):
    val refused = match result:
        case Err(_): true
        case Ok(_): false
    expect(refused).to_equal(true)

describe "semantic Markdown source link lint and fix":
    context "explicit revision-bound source authority":
        it "should diagnose and fix local fragment colon and GitHub range destinations":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "https://github.com/org/repo/blob/rev/src/sample.spl", document: document)]
            val markdown = "[a](src/sample.spl#L1-L2) [b](src/sample.spl:2)\n[r]: https://github.com/org/repo/blob/rev/src/sample.spl#L2\n"
            step("Exercise the production boundary")
            val plan = plan_semantic_markdown_links_v1(markdown, bindings, false).unwrap()
            val fixed = apply_semantic_markdown_links_v1(markdown, plan).unwrap()
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(3)
            expect(plan.diagnostics[0].rule).to_equal("W-DOC-AST-001")
            expect(plan.diagnostics[0].severity).to_equal("warn")
            expect(fixed).to_contain("[a](spl:fn@sample.value~")
            expect(fixed).to_contain("[r]: spl:fn@sample.value~")
            step("Reject the negative control")
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1(markdown + "changed", plan))
            expect(file_delete(file)).to_equal(true)

        it "should protect fenced code inline code labels and escaped source examples":
            step("Prepare the production input")
            val markdown = "```spl\nsrc/sample.spl:2\n```\n``src/sample.spl:2`` [src/sample.spl:2](ordinary.md)\n\\src/sample.spl:2\n"
            step("Exercise the production boundary")
            val plan = plan_semantic_markdown_links_v1(markdown, [], true).unwrap()
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(0)
            step("Reject the negative control")
            expect(plan_semantic_markdown_links_v1("[x](src/sample.spl#L2)", [], true).unwrap().diagnostics.len()).to_equal(1)

        it "should deny critical unresolved links and refuse partial fixing":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "", document: document)]
            val markdown = "[a](src/sample.spl#L2) [b](src/missing.spl:9)"
            step("Exercise the production boundary")
            val plan = plan_semantic_markdown_links_v1(markdown, bindings, true).unwrap()
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(2)
            expect(plan.diagnostics[0].severity).to_equal("deny")
            step("Reject the negative control")
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1(markdown, plan))
            val malformed = "[a](src/sample.spl#Lbad)"
            val malformed_plan = plan_semantic_markdown_links_v1(malformed, bindings, true).unwrap()
            expect(malformed_plan.diagnostics.len()).to_equal(1)
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1(malformed, malformed_plan))
            expect(file_delete(file)).to_equal(true)

        it "should refuse wrong GitHub revision authority and changed source bytes":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "https://github.com/org/repo/blob/rev/src/sample.spl", document: document)]
            step("Exercise the production boundary")
            val wrong = "[a](https://github.com/org/repo/blob/other/src/sample.spl#L2)"
            val plan = plan_semantic_markdown_links_v1(wrong, bindings, false).unwrap()
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(1)
            step("Reject the negative control")
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1(wrong, plan))
            expect(file_write(file, source + "# edit\n")).to_equal(true)
            val stale = plan_semantic_markdown_links_v1("[a](src/sample.spl#L2)", bindings, false).unwrap()
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1("[a](src/sample.spl#L2)", stale))
            expect(file_delete(file)).to_equal(true)


        it "should expose check and fix through the doc command boundary":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val markdown = "[a](src/sample.spl#L2)"
            val document_file = robust_06_semantic_docs_setup(markdown)
            val options = ["--markdown", document_file, "--source-file", file, "--source-link", "src/sample.spl", "--package", "pkg", "--module", "sample", "--revision", sha256_text(source)]
            step("Exercise the production boundary")
            val checked = doc_links_command_v1(["check-links", "--critical"] + options).unwrap()
            val fixed = doc_links_command_v1(["fix-links"] + options).unwrap()
            step("Inspect the observed result")
            expect(checked.exit_code).to_equal(1)
            expect(checked.output).to_contain("deny W-DOC-AST-001")
            expect(fixed.output).to_start_with("[a](spl:fn@sample.value~")
            step("Reject the negative control")
            robust_06_semantic_docs_assert_refusal(doc_links_command_v1(["check-links"]))
            expect(file_delete(document_file)).to_equal(true)
            expect(file_delete(file)).to_equal(true)


        it "should reject externally forged edit replacements against actual source":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "", document: document)]
            val markdown = "[a](src/sample.spl#L2)"
            val plan = plan_semantic_markdown_links_v1(markdown, bindings, false).unwrap()
            val original = plan.diagnostics[0]
            step("Exercise the production boundary")
            val forged = SemanticMarkdownDiagnosticV1(rule: original.rule, severity: original.severity, start: original.start, end: original.end, target: original.target,
                replacement: "spl:fn@sample.invented~000000000000", message: original.message)
            val changed = SemanticMarkdownPlanV1(revision: plan.revision, diagnostics: [forged], sources: bindings)
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(1)
            step("Reject the negative control")
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_links_v1(markdown, changed))
            expect(file_delete(file)).to_equal(true)


        it "should validate existing semantic destinations through the common batch owner":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "", document: document)]
            val markdown = "[a](" + uri + ")\n[r]: " + uri + "\n"
            step("Exercise the production boundary")
            val plan = plan_semantic_markdown_links_v1(markdown, bindings, false).unwrap()
            step("Inspect the observed result")
            expect(plan.diagnostics.len()).to_equal(0)
            expect(apply_semantic_markdown_links_v1(markdown, plan).unwrap()).to_equal(markdown)
            val markdown_file = robust_06_semantic_docs_setup(markdown)
            val options = ["--markdown", markdown_file, "--source-file", file, "--source-link", "src/sample.spl", "--package", "pkg", "--module", "sample", "--revision", sha256_text(source)]
            expect(doc_links_command_v1(["check-links"] + options).unwrap().exit_code).to_equal(0)
            expect(doc_links_command_v1(["fix-links"] + options).unwrap().output).to_equal(markdown)
            step("Reject the negative control")
            expect(file_write(markdown_file, "[a](spl:fn@sample.value~bad)")).to_equal(true)
            robust_06_semantic_docs_assert_refusal(doc_links_command_v1(["check-links"] + options))
            robust_06_semantic_docs_assert_refusal(doc_links_command_v1(["fix-links"] + options))
            expect(file_delete(markdown_file)).to_equal(true)
            robust_06_semantic_docs_assert_refusal(plan_semantic_markdown_links_v1("[a](spl:fn@sample.missing~000000000000)", bindings, false))
            robust_06_semantic_docs_assert_refusal(plan_semantic_markdown_links_v1("[a](spl:fn@sample.value~bad)", bindings, false))
            robust_06_semantic_docs_assert_refusal(plan_semantic_markdown_links_v1("[a](spl:fn@sample.value~000000000000)", bindings, false))
            expect(file_write(file, source + "# edit\n")).to_equal(true)
            robust_06_semantic_docs_assert_refusal(plan_semantic_markdown_links_v1(markdown, bindings, false))
            expect(file_delete(file)).to_equal(true)

        it "should fail closed in the actual process document checker without an identity owner":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val uri = semantic_link_document_uri_v1(document, 0, false).unwrap()
            val markdown_file = get_temp_dir() + "/process-doc-{getpid()}-{time_now_unix_micros()}.md"
            val markdown = "[a](" + uri + ")"
            expect(file_write(markdown_file, markdown)).to_equal(true)
            step("Exercise the production boundary")
            val failures = check_process_document_links_v1(".", markdown_file, "")
            step("Inspect the observed result")
            expect(failures.len()).to_equal(1)
            expect(failures[0]).to_contain("explicit source identity/revision owner required")
            step("Reject the negative control")
            val example = "```md\n[a](" + uri + ")\n```\n`" + uri + "`"
            expect(file_write(markdown_file, example)).to_equal(true)
            expect(semantic_markdown_process_failures_v1(example, []).len()).to_equal(0)
            expect(check_process_document_links_v1(".", markdown_file, "").len()).to_equal(0)
            expect(file_delete(markdown_file)).to_equal(true)
            expect(file_delete(file)).to_equal(true)

        it "should reject invalid semantic candidate bodies before dry run or forced process publication":
            step("Prepare the production input")
            val root = secure_temp_dir(get_temp_dir(), "semantic-process-c4-").unwrap()
            val source = root + "/source.md"
            val target = root + "/generated.md"
            val previous = "previous process document\n"
            expect(file_write(source, "[bad](spl:fn@sample.value~bad)\n")).to_equal(true)
            expect(file_write(target, previous)).to_equal(true)
            val record = GeneratedFile(id: "semantic-c4", kind: "skill", owner: "test", stage: "impl",
                source_path: "source.md", target_path: "generated.md", mode: "managed")
            step("Reject the negative control")
            val dry_failures = generate_record(root, record, true, true)
            expect(dry_failures.len()).to_be_greater_than(0)
            expect(dry_failures.join("\n")).to_contain("semantic")
            expect(file_read(target)).to_equal(previous)
            val write_failures = generate_record(root, record, false, true)
            expect(write_failures.len()).to_be_greater_than(0)
            expect(write_failures.join("\n")).to_contain("semantic")
            expect(file_read(target)).to_equal(previous)
            step("Inspect the ordinary positive control")
            expect(file_write(source, "# Ordinary process document\n")).to_equal(true)
            expect(generate_record(root, record, false, true).len()).to_equal(0)
            expect(file_read(target)).to_contain("# Ordinary process document")
            expect(dir_remove(root, true)).to_equal(true)

        it "should report the exact later invalid URI and its original Markdown byte interval":
            step("Prepare the production input")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val revision = sha256_text(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, revision).unwrap()
            val good = semantic_link_document_uri_v1(document, 0, false).unwrap()
            val bad = good.replace(".value~", ".missing~")
            val first_prefix = "π [good]("
            val prefix = first_prefix + good + ")\n[bad]("
            val markdown = prefix + bad + ")\n"
            val bindings = [SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "", document: document)]
            step("Exercise the production boundary")
            match resolve_semantic_links_source_indexed_v1([good, bad], document, revision):
                case Err(error):
                    expect(error.row).to_equal(1)
                    expect(error.error.failure).to_equal(SemanticLinkFailureV1.UnresolvedTarget)
                case Ok(_): panic("the later unresolved URI must refuse the batch")
            step("Inspect the observed result")
            match plan_semantic_markdown_links_v1(markdown, bindings, false):
                case Err(error):
                    expect(error.message).to_contain("{prefix.len()}:{prefix.len() + bad.len()} " + bad)
                    expect(error.message.contains("{first_prefix.len()}:{first_prefix.len() + good.len()} " + good)).to_equal(false)
                case Ok(_): panic("invalid later Markdown target must refuse planning")
            expect(file_delete(file)).to_equal(true)

        it "should check semantic Markdown through the actual root lint command":
            step("Check semantic Markdown through root lint")
            val root = secure_temp_dir(get_temp_dir(), "semantic-root-lint-").unwrap()
            val file = root + "/source.spl"
            val markdown_file = root + "/guide.md"
            val source = "fn value() -> i64:\n    1\n"
            val markdown = "[value](src/sample.spl#L2)"
            expect(file_write(file, source)).to_equal(true)
            expect(file_write(markdown_file, markdown)).to_equal(true)
            val authority = ["--source-file", file, "--source-link", "src/sample.spl", "--package", "pkg", "--module", "sample", "--revision", sha256_text(source)]
            expect(lint_option_error(["lint", markdown_file] + authority)).to_equal("")
            expect(run_lint_command(["lint", markdown_file, "--profile=critical"])).to_equal(1)
            expect(run_lint_command(["lint", markdown_file] + authority)).to_equal(0)
            expect(run_lint_command(["lint", markdown_file, "--fix-dry-run"] + authority)).to_equal(0)
            expect(file_read(markdown_file)).to_equal(markdown)
            expect(run_lint_command(["lint", markdown_file, "--fix"] + authority)).to_equal(0)
            expect(file_read(markdown_file)).to_start_with("[value](spl:fn@sample.value~")
            expect(run_lint_command(["lint", markdown_file] + authority)).to_equal(0)
            step("Reject stale and duplicate authority without changing the document")
            expect(file_write(markdown_file, markdown)).to_equal(true)
            expect(run_lint_command(["lint", markdown_file, "--fix"] + authority + ["--revision", sha256_text(source)])).to_equal(2)
            expect(file_read(markdown_file)).to_equal(markdown)
            expect(file_write(file, source + "# changed\n")).to_equal(true)
            expect(run_lint_command(["lint", markdown_file, "--fix"] + authority)).to_equal(1)
            expect(file_read(markdown_file)).to_equal(markdown)
            expect(file_write(markdown_file, "[bad](spl:fn@sample.value~bad)")).to_equal(true)
            expect(run_lint_command(["lint", markdown_file])).to_equal(1)
            expect(file_read(markdown_file)).to_equal("[bad](spl:fn@sample.value~bad)")
            expect(dir_remove(root, true)).to_equal(true)

        it "should apply the existing root lint severity configuration to semantic diagnostics":
            step("Check semantic Markdown through root lint")
            val root = secure_temp_dir(get_temp_dir(), "semantic-root-config-").unwrap()
            val markdown_file = root + "/guide.md"
            val manifest = root + "/simple.sdn"
            expect(file_write(markdown_file, "[value](src/sample.spl:2)")).to_equal(true)
            expect(file_write(manifest, "lints:\n  semantic_markdown_links: deny\n")).to_equal(true)
            expect(run_lint_command(["lint", markdown_file])).to_equal(1)
            expect(file_write(manifest, "lints:\n  semantic_markdown_links: allow\n")).to_equal(true)
            expect(run_lint_command(["lint", markdown_file, "--fix"])).to_equal(0)
            expect(file_read(markdown_file)).to_equal("[value](src/sample.spl:2)")
            expect(file_write(manifest, "lints:\n  semantic_markdown_links: warn\n")).to_equal(true)
            expect(run_lint_command(["lint", markdown_file])).to_equal(0)
            expect(dir_remove(root, true)).to_equal(true)

        it "should preserve Markdown when a shared root fix receives duplicate source owners":
            step("Check semantic Markdown through root lint")
            val source = "fn value() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            val binding = SemanticMarkdownSourceV1(local_file: "src/sample.spl", remote_file: "", document: document)
            val markdown = "[value](src/sample.spl:2)"
            val markdown_file = get_temp_dir() + "/semantic-duplicate-{getpid()}-{time_now_unix_micros()}.md"
            expect(file_write(markdown_file, markdown)).to_equal(true)
            robust_06_semantic_docs_assert_refusal(apply_semantic_markdown_lint_fix_v1(markdown_file, markdown, [binding, binding], false))
            expect(file_read(markdown_file)).to_equal(markdown)
            expect(file_delete(markdown_file)).to_equal(true)
            expect(file_delete(file)).to_equal(true)

        it "should reject mixed generic and semantic fix publication before either edit":
            step("Check semantic Markdown through root lint")
            val root = secure_temp_dir(get_temp_dir(), "semantic-mixed-fix-").unwrap()
            val file = root + "/source.spl"
            val markdown_file = root + "/guide.md"
            val source = "fn value() -> i64:\n    1\n"
            val markdown = "[value](src/sample.spl:2)\nif let value = item:\n"
            expect(file_write(file, source)).to_equal(true)
            expect(file_write(markdown_file, markdown)).to_equal(true)
            val authority = ["--source-file", file, "--source-link", "src/sample.spl", "--package", "pkg", "--module", "sample", "--revision", sha256_text(source)]
            expect(run_lint_command(["lint", markdown_file, "--fix"] + authority)).to_equal(1)
            expect(file_read(markdown_file)).to_equal(markdown)
            expect(dir_remove(root, true)).to_equal(true)
