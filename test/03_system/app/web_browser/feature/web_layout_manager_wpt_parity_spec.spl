# codex-system-test
# @tag: system, web_browser, layout, wpt

"""
# WPT-derived web layout manager parity corpus

Runs the existing bounded Web Platform Test witnesses through the browser CPU
oracle and retained layout manager.  Each case requires exact full/incremental
boxes, fragments, line boxes, overflow, and dependency-closed dirty-island
receipts.

Fixture provenance is retained beside each case.  This corpus does not claim
the complete upstream WPT suite.
"""

use std.spec.*
use std.common.structural.layout.{layout_execution_profile}
use std.common.web.browser_renderer_protocol.{browser_text_input_overlay_empty}
use std.gc_async_mut.web.browser_session.{
    BrowserRenderRevisions,
    BrowserRenderSnapshot
}
use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_draw_ir_result
}
use std.gc_async_mut.gpu.browser_engine.simple_web_render_session.{
    SimpleWebRenderSession
}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.*

fn _wpt_system_change(node_id: i64) -> WebLayoutChange:
    web_layout_change(
        WebLayoutMutationKind.Style,
        StyleDifference.LayoutSelf,
        node_id,
        node_id,
        [], [], [], [], [], [], []
    )

fn _wpt_parent_id(nodes: [WebLayoutNodeSnapshot], node_id: i64) -> i64:
    for node in nodes:
        if node.id == node_id:
            return node.parent_id
    -1

fn _wpt_is_ancestor(
    nodes: [WebLayoutNodeSnapshot], ancestor_id: i64, node_id: i64
) -> bool:
    var current = node_id
    while current > 0:
        if current == ancestor_id:
            return true
        current = _wpt_parent_id(nodes, current)
    false

fn _wpt_target_id(nodes: [WebLayoutNodeSnapshot], profile_id: text) -> i64:
    for node in nodes:
        if node.profile_id == profile_id:
            return node.id
    0

fn _wpt_expected_visited(
    nodes: [WebLayoutNodeSnapshot], target_id: i64
) -> [i64]:
    var expected: [i64] = []
    for node in nodes:
        if (
            (node.parent_id == 0 or node.formatting_boundary or
             node.layout_contained) and
            _wpt_is_ancestor(nodes, node.id, target_id)
        ):
            expected.push(node.id)
    expected

fn _expect_wpt_layout_parity(
    html: text, generation: i64, target_profile: text
):
    val browser = simple_web_layout_render_html_draw_ir_result(html, 320, 240)
    val execution = layout_execution_profile(
        "serial_cpu", 50, 0, 0, 0, 0, 0, 0, 0
    )
    val adapted = web_layout_adapt_cpu_oracle(browser, generation, execution, 4)
    expect(adapted.fault).to_equal("")

    val target_id = _wpt_target_id(adapted.snapshot.nodes, target_profile)
    expect(target_id).to_be_greater_than(0)
    val expected_visited = _wpt_expected_visited(
        adapted.snapshot.nodes, target_id
    )
    val frontier = web_layout_dirty_frontier([
        _wpt_system_change(target_id)
    ])
    expect(frontier.invalidated_ids).to_equal([target_id])

    val full = web_layout_run_full(
        web_layout_manager(generation),
        adapted.snapshot,
        web_layout_dirty_frontier([])
    )
    val incremental = web_layout_run_incremental(
        full.manager, adapted.snapshot, frontier
    )
    expect(full.result.fault).to_equal("")
    expect(incremental.result.fault).to_equal("")
    expect(full.result.layout.boxes).to_equal(adapted.snapshot.oracle_boxes)
    expect(full.result.layout.fragments).to_equal(
        adapted.snapshot.oracle_fragments
    )
    expect(full.result.layout.line_boxes).to_equal(
        adapted.snapshot.oracle_line_boxes
    )
    expect(full.result.layout.overflows).to_equal(
        adapted.snapshot.oracle_overflows
    )
    expect(incremental.result.layout.boxes).to_equal(full.result.layout.boxes)
    expect(incremental.result.layout.fragments).to_equal(
        full.result.layout.fragments
    )
    expect(incremental.result.layout.line_boxes).to_equal(
        full.result.layout.line_boxes
    )
    expect(incremental.result.layout.overflows).to_equal(
        full.result.layout.overflows
    )
    expect(incremental.result.layout.receipt.visited_island_ids).to_equal(
        expected_visited
    )

fn _wpt_render_snapshot(
    generation: i64,
    document_revision: i64,
    style_revision: i64,
    resource_revision: i64,
    html: text?
) -> BrowserRenderSnapshot:
    BrowserRenderSnapshot(
        document_generation: generation,
        revisions: BrowserRenderRevisions(
            document_revision: document_revision,
            style_revision: style_revision,
            resource_revision: resource_revision
        ),
        document_html: html,
        resources_changed: false
    )

use std.spec.step

describe "REQ-WLM-003..REQ-WLM-005 WPT-derived parity corpus":
    # @manual: show
    it "should preserve exact block flex and grid layout artifacts":
        # @req: REQ-APP-WEB-LAYOUT-001 REQ-WLM-003 REQ-WLM-004 REQ-WLM-005 REQ-WLM-003..REQ-WLM-005
        # @req: REQ-APP-WEB-LAYOUT-001
        # @req: REQ-WLM-003
        # @req: REQ-WLM-004
        # @req: REQ-WLM-005
        step("Verify: should preserve exact block flex and grid layout artifacts")
        step("Run the existing block formatting witness")
        # Provenance: test/03_system/feature/web_platform/css/padding_shorthand_cascade_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}.box{display:block;box-sizing:" +
            "content-box;width:8px;height:8px;padding:2px}</style>" +
            "<div class='box'><span>A</span></div>",
            101,
            "block"
        )

        step("Run the existing zero-gap Flex witness")
        # Provenance: test/03_system/feature/web_platform/css/flex_gap_zero_cascade_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}.row{display:flex;width:12px;" +
            "height:2px;gap:0}.item{width:4px;height:2px}</style>" +
            "<div class='row'><div class='item'></div>" +
            "<div class='item'></div></div>",
            102,
            "flex"
        )

        step("Run the existing explicit-track Grid witness")
        # Provenance: test/03_system/feature/web_platform/css/grid_foundation_wpt_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}#grid{display:grid;width:18px;" +
            "grid-template-columns:6px 10px;column-gap:2px}" +
            ".item{height:5px}</style><main id='grid'>" +
            "<div class='item'>A</div><div class='item'>B</div></main>",
            103,
            "grid"
        )

    # @manual: show
    it "should preserve exact positioned overflow and wrapped Latin artifacts":
        # @req: REQ-APP-WEB-LAYOUT-001
        step("Verify: should preserve exact positioned overflow and wrapped Latin artifacts")
        step("Run the existing absolute-position witness")
        # Provenance: test/02_integration/rendering/simple_web_layout_child_index_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}#host{position:relative;width:32px;" +
            "height:24px}#item{position:absolute;left:4px;top:3px;" +
            "width:12px;height:8px}</style><div id='host'>" +
            "<div id='item'></div></div>",
            104,
            "absolute-sticky"
        )

        step("Run the existing scrolling-overflow witness")
        # Provenance: test/03_system/feature/web_platform/css/scrollbar_wpt_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}#clip{width:32px;height:16px;" +
            "overflow:auto}#inner{width:64px;height:32px}</style>" +
            "<div id='clip'><div id='inner'></div></div>",
            105,
            "scroll"
        )

        step("Run the existing wrapped Latin text witness")
        # Provenance: test/03_system/feature/web_platform/css/pseudo_text_wpt_spec.spl
        _expect_wpt_layout_parity(
            "<style>html,body{{margin:0}}#line{display:block;width:40px;" +
            "font-size:8px;white-space:normal}</style>" +
            "<div id='line'>alpha beta gamma delta</div>",
            106,
            "inline"
        )

    # @manual: show
    it "should retain paint-only epochs and limit layout-change receipts":
        # @req: REQ-APP-WEB-LAYOUT-001
        step("Verify: should retain paint-only epochs and limit layout-change receipts")
        val before_html = (
            "<style>html,body{{margin:0}}#flex{display:flex;width:24px}" +
            "#grid{display:grid;width:24px;grid-template-columns:12px 12px}" +
            ".item{width:8px;height:4px}</style>" +
            "<div id='flex'><div class='item'></div></div>" +
            "<div id='grid'><div class='item'></div></div>"
        )
        val after_html = before_html.replace(
            "#flex{display:flex;width:24px}",
            "#flex{display:flex;width:20px}"
        )
        val overlay = browser_text_input_overlay_empty()
        val session = SimpleWebRenderSession.create()

        step("Retain the initial production render and framework epoch")
        val initial = session.render(
            _wpt_render_snapshot(201, 1, 1, 1, Some(before_html)),
            320, 240, 0, 0, overlay, [], []
        )
        expect(initial.raw_boxes.bx.len()).to_be_greater_than(0)
        expect(session.current_web_layout_run.unwrap().epoch).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        step("Apply a paint-only scroll without advancing layout epoch")
        val painted = session.render(
            _wpt_render_snapshot(201, 1, 1, 1, nil),
            320, 240, 0, 1, overlay, [], []
        )
        expect(painted.raw_boxes.bx.len()).to_equal(initial.raw_boxes.bx.len())
        expect(session.current_web_layout_run.unwrap().epoch).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        step("Change only the Flex geometry and inspect the exact receipt")
        val changed = session.render(
            _wpt_render_snapshot(201, 1, 2, 1, Some(after_html)),
            320, 240, 0, 1, overlay, [], []
        )
        expect(changed.raw_boxes.bx.len()).to_equal(initial.raw_boxes.bx.len())
        val run = session.current_web_layout_run.unwrap()
        val snapshot = session.current_web_layout_snapshot.unwrap()
        val flex_id = _wpt_target_id(snapshot.nodes, "flex")
        expect(run.epoch).to_equal(2)  # oracle: 2 — pinned expected value for this behavior
        expect(run.layout.receipt.visited_island_ids).to_equal(
            _wpt_expected_visited(snapshot.nodes, flex_id)
        )
        expect(run.layout.receipt.visited_island_ids.len()).to_be_less_than(
            run.layout.islands.len()
        )
