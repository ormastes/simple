# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# codex-system-test
# @tag: system, web_browser, layout
# @req REQ-WLM-001
# @req REQ-WLM-002

"""
# Web layout manager

Freezes the concrete browser-to-structural layout interface before renderer
wiring. Implementation evidence extends this scenario without renaming its
four manual steps.
"""

use std.spec.step

use std.spec.*
use std.common.structural.layout.{layout_box, layout_execution_profile}
use std.gc_async_mut.gpu.browser_engine.gpu_web.layout.*

fn system_change(node_id: i64, context_id: i64) -> WebLayoutChange:
    web_layout_change(
        WebLayoutMutationKind.StyleMutation,
        StyleDifference.LayoutSelf,
        node_id,
        context_id,
        [], [], [], [], [], [], []
    )

describe "REQ-WLM-001..REQ-WLM-007 web layout manager":
    it "pre-rejects complex-script GPU line breaking before submission":
        # @req REQ-WLM-001..REQ-WLM-007
        # @req REQ-WLM-001..REQ-WLM-007
        # @req REQ-SSPEC-SYSTEM
        step("pre-rejects complex-script GPU line breaking before submission")
        val browser = simple_web_layout_render_html_draw_ir_result(
            "<div style='width:48px'>مرحبا بالعالم</div>", 320, 240
        )
        val execution = layout_execution_profile(
            "serial_cpu", 50, 0, 0, 0, 0, 0, 0, 0
        )
        val adapted = web_layout_adapt_cpu_oracle(browser, 6, execution, 4)
        expect(adapted.fault).to_equal("")
        val run = web_layout_run_full(
            web_layout_manager(6), adapted.snapshot,
            web_layout_dirty_frontier([])
        )
        expect(run.result.fault).to_equal("")
        expect(run.result.gpu_line_break.attempted).to_equal(true)
        expect(run.result.gpu_line_break.admitted).to_equal(false)
        expect(run.result.gpu_line_break.submitted).to_equal(false)
        expect(run.result.gpu_line_break.reason).to_equal(
            "cuda-line-break-complex-script"
        )

describe "REQ-WLM-001..REQ-WLM-002 web layout manager interface":
    # @manual: show
    it "preserves the browser oracle through incremental framework execution":
        # @req REQ-SSPEC-SYSTEM
        step("preserves the browser oracle through incremental framework execution")
        step("Capture the CPU layout oracle")
        val node = WebLayoutNodeSnapshot(
            id: 1,
            arena_index: 0,
            dom_route_id: 41,
            parent_id: 0,
            tag: "div",
            profile_id: "block",
            formatting_boundary: true,
            layout_contained: false,
            style: fingerprint("i", "p", "c", "m", "l", "s", "f"),
            text_metrics: WebLayoutResolvedTextMetrics(font_identity: "", advances: [], width: 0, line_height: 0),
            oracle_box: layout_box(1, 0, 0, 640, 480),
            estimated_work: 1,
            text_measure_required: false,
            required_fixed_point_iterations: 1
        )
        val snapshot = web_layout_snapshot(
            7,
            "640x480",
            [node],
            [],
            layout_execution_profile("serial_cpu", 10, 0, 0, 0, 0, 0, 0, 0),
            4
        )
        expect(snapshot.contract_version).to_equal(WEB_LAYOUT_CONTRACT_VERSION)
        expect(snapshot.nodes[0].oracle_box.width).to_equal(640)

        step("Classify browser layout islands")
        val base = fingerprint("i", "p", "c", "m", "l", "s", "f")
        expect(web_layout_classify_style(base, base)).to_equal(StyleDifference.NoChange)
        expect(web_layout_classify_style(base, fingerprint("I", "p", "c", "m", "l", "s", "f"))).to_equal(StyleDifference.InheritedOnly)
        expect(web_layout_classify_style(base, fingerprint("i", "P", "c", "m", "l", "s", "f"))).to_equal(StyleDifference.PaintOnly)
        expect(web_layout_classify_style(base, fingerprint("i", "p", "C", "m", "l", "s", "f"))).to_equal(StyleDifference.CompositeOnly)
        expect(web_layout_classify_style(base, fingerprint("i", "p", "c", "M", "l", "s", "f"))).to_equal(StyleDifference.IntrinsicMeasure)
        expect(web_layout_classify_style(base, fingerprint("i", "p", "c", "m", "L", "s", "f"))).to_equal(StyleDifference.LayoutSelf)
        expect(web_layout_classify_style(base, fingerprint("i", "p", "c", "m", "l", "S", "f"))).to_equal(StyleDifference.LayoutSubtree)
        expect(
            web_layout_classify_style(base, fingerprint("i", "p", "c", "m", "l", "s", "F"))
        ).to_equal(StyleDifference.RebuildFormattingContext)
        expect(web_layout_admit_profile("div", "none", false, false, false, false).profile_id).to_equal("block")
        expect(web_layout_admit_profile("div", "contents", false, false, false, false).profile_id).to_equal("block")
        expect(web_layout_admit_profile("td", "table-cell", false, false, false, false).profile_id).to_equal("table")
        expect(web_layout_admit_profile("div", "block", false, false, false, true).profile_id).to_equal("scroll")
        expect(web_layout_admit_profile("div", "mystery", false, false, false, false).supported).to_equal(false)
        expect(web_layout_admit_profile("img", "block", true, false, false, false).supported).to_equal(false)
        val change = web_layout_change(WebLayoutMutationKind.Style, StyleDifference.LayoutSelf, 1, 1, [], [], [], [], [], [])
        expect(change.node_id).to_equal(1)
        expect(change.containing_context_id).to_equal(1)

        step("Apply the invalidated frontier")
        val frontier = WebLayoutFrontier(dirty_nodes: [WebLayoutDirtyNode(id: 1, dirty_bits: 2)], invalidated_ids: [1], fault: "")
        expect(frontier.invalidated_ids).to_equal([1])
        expect(frontier.fault).to_equal("")

        step("Verify fragments mappings and hit index")
        expect(full.result.epoch).to_equal(1)
        expect(incremental.result.epoch).to_equal(2)
        expect(incremental.result.hit_regions.len()).to_equal(browser.raw_boxes.bx.len())
        expect(incremental.result.hit_regions[0].generation).to_equal(7)
        expect(incremental.result.hit_regions[0].epoch).to_equal(2)
        expect(incremental.result.hit_regions[0].structural_id).to_equal(1)
        expect(incremental.result.hit_regions[0].dom_route_id).to_equal(0)
        expect(incremental.result.layout.mappings[0].kind).to_equal("LayoutOf")
        expect(incremental.result.hit_mappings.len()).to_equal(
            incremental.result.hit_regions.len()
        )
        expect(incremental.result.hit_mappings[0].kind).to_equal("HitRegionOf")
        expect(incremental.result.hit_mappings[0].target_id).to_equal(
            incremental.result.hit_regions[0].dom_route_id
        )

        step("Restrict viewport invalidation to changed geometry")
        val viewport_change = web_layout_change(
            WebLayoutMutationKind.Viewport,
            StyleDifference.NoChange,
            0, 0, [], [], [], [], [], [], [flex_id]
        )
        expect(web_layout_dirty_frontier([viewport_change]).invalidated_ids).to_equal([flex_id])

        val stale = web_layout_run_full(
            web_layout_manager(8), adapted.snapshot, web_layout_dirty_frontier([])
        )
        expect(stale.result.stale).to_equal(true)
        expect(stale.result.fault).to_equal("stale-dom-generation")

        val seed = adapted.snapshot.nodes[0]
        val unsupported_node = WebLayoutNodeSnapshot(
            id: seed.id,
            arena_index: seed.arena_index,
            dom_route_id: seed.dom_route_id,
            parent_id: seed.parent_id,
            tag: seed.tag,
            profile_id: "mystery",
            formatting_boundary: seed.formatting_boundary,
            layout_contained: seed.layout_contained,
            style: seed.style,
            text_content: seed.text_content,
            font_family: seed.font_family,
            font_size: seed.font_size,
            language: seed.language,
            text_metrics: seed.text_metrics,
            semantics: seed.semantics,
            estimated_work: seed.estimated_work,
            text_measure_required: seed.text_measure_required
        )
        val unsupported_snapshot = web_layout_snapshot(
            7, adapted.snapshot.viewport_fingerprint, [unsupported_node],
            [], execution, 4,
            adapted.snapshot.viewport_width,
            adapted.snapshot.viewport_height,
            adapted.snapshot.grid_tracks,
            [adapted.snapshot.oracle_boxes[0]]
        )
        val unsupported = web_layout_run_full(
            web_layout_manager(7), unsupported_snapshot,
            web_layout_dirty_frontier([])
        )
        expect(unsupported.result.fault).to_equal("unsupported-profile:mystery")
        expect(unsupported.result.epoch).to_equal(0)

        val exhausted = web_layout_run_full(
            WebLayoutManager(generation: 7, epoch: WEB_LAYOUT_MAX_EPOCH),
            adapted.snapshot,
            web_layout_dirty_frontier([])
        )
        expect(exhausted.result.fault).to_equal("epoch-exhausted")

    # @manual: show
    it "preserves wrapped lines fragments and overflow extents exactly":
        # @req REQ-SSPEC-SYSTEM
        step("preserves wrapped lines fragments and overflow extents exactly")
        step("Capture wrapped text and clipped overflow from the CPU oracle")
        val browser = simple_web_layout_render_html_draw_ir_result(
            "<div style='width:48px;overflow:hidden'>alpha beta gamma delta</div>" +
            "<div style='width:40px;overflow:hidden'><div style='width:120px;height:12px'></div></div>",
            320,
            240
        )
        val execution = layout_execution_profile(
            "serial_cpu", 50, 0, 0, 0, 0, 0, 0, 0
        )
        val adapted = web_layout_adapt_cpu_oracle(browser, 11, execution, 4)
        expect(adapted.fault).to_equal("")

        var wrapped_node_id: i64 = 0
        var wrapped_line_count: i64 = 0
        for node in adapted.snapshot.nodes:
            if node.tag == "#text":
                var node_line_count: i64 = 0
                for line in adapted.snapshot.oracle_line_boxes:
                    if line.node_id == node.id:
                        node_line_count = node_line_count + 1
                        var exact_width: i64 = 0
                        var advance_index = line.text_start
                        while advance_index < line.text_end:
                            exact_width = exact_width + node.text_metrics.advances[advance_index]
                            advance_index = advance_index + 1
                        expect(line.box.width).to_equal(exact_width)
                if node_line_count > 1:
                    wrapped_node_id = node.id
                    wrapped_line_count = node_line_count
        expect(wrapped_node_id).to_be_greater_than(0)
        expect(wrapped_line_count).to_be_greater_than(1)

        var clipped_overflow_found = false
        for overflow in adapted.snapshot.oracle_overflows:
            if (overflow.scroll_width > overflow.clip_box.width or
                overflow.scroll_height > overflow.clip_box.height):
                clipped_overflow_found = true
        expect(clipped_overflow_found).to_equal(true)

        step("Run the framework with the exact oracle artifacts")
        val full = web_layout_run_full(
            web_layout_manager(11),
            adapted.snapshot,
            web_layout_dirty_frontier([])
        )
        expect(full.result.fault).to_equal("")
        expect(full.result.layout.fragments).to_equal(adapted.snapshot.oracle_fragments)
        expect(full.result.layout.line_boxes).to_equal(adapted.snapshot.oracle_line_boxes)
        expect(full.result.layout.overflows).to_equal(adapted.snapshot.oracle_overflows)
