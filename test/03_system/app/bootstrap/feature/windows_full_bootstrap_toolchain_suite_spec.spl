describe "Windows full bootstrap and toolchain suite":

    it "admits a conflict-free phase compiler with complete immutable provenance":
        # @req REQ-001 REQ-002 REQ-003 REQ-015
        # @capture(artifact): phase receipt and exact subject digest
        step("Admit the phase compiler and provenance")
        val setup_status = setup_windows_bootstrap_phase()
        val provenance_status = check_phase_provenance()
        expect(setup_status).to_equal("pass")
        expect(provenance_status).to_equal("pass")

    it "proves compiler and authenticated interpreter behavior on the exact phase subject":
        # @req REQ-004
        # @capture(exec): bounded compiler and interpreter command evidence
        step("Check compiler and interpreter behavior")
        val status = check_phase_compiler_interpreter()
        expect(status).to_equal("pass")

    it "runs essential tools through interpreter and native primary-feature paths":
        # @req REQ-004 REQ-008
        # @capture(binary): exact interpreter and native tool identities
        step("Run essential tools in interpreter and native modes")
        val status = check_phase_tool_matrix()
        expect(status).to_equal("pass")

    it "preserves immediate-parent admission through Stage 3 and unchanged Stage 4 acceptance":
        # @req REQ-006 REQ-007
        # @capture(artifact): Stage 2 Stage 3 and Stage 4 lineage receipts
        step("Admit the phase compiler and provenance")
        val status = check_phase_provenance()
        expect(status).to_equal("pass")

    it "verifies every named integrated suite with typed terminal evidence":
        # @req REQ-008
        # @capture(protocol): MCP LSP and tool-suite protocol evidence
        step("Verify integrated tool suites")
        val status = check_integrated_suite_matrix()
        expect(status).to_equal("pass")

    it "reviews and publishes only the exact passing phase head":
        # @req REQ-005 REQ-009 REQ-011
        # @capture(log): source invalidation review admission push and required-check evidence
        step("Review and publish the exact phase head")
        val status = check_review_and_publication()
        expect(status).to_equal("pass")

    it "deploys one immutable generation and restores its verified predecessor":
        # @req REQ-010
        # @capture(binary): deployed and restored executable digests
        step("Deploy and prove rollback")
        val status = check_local_deploy_and_rollback()
        expect(status).to_equal("pass")

    it "keeps all six bootstrap readiness gates and unavailable rows fail closed":
        # @req REQ-012
        # @capture(artifact): ordered platform handoff readiness receipt
        step("Verify integrated tool suites")
        val status = step_bootstrap_platform_handoff_readiness()
        expect(status).to_equal("pass")

    it "rejects duplicate attempts fourth fix cycles and stale process knowledge":
        # @req REQ-013 REQ-014
        # @capture(log): convergence and documentation synchronization audit
        step("Review and publish the exact phase head")
        val status = check_convergence_and_docs()
        expect(status).to_equal("pass")
