# codex-system-test
# REQ-002, REQ-003: small-PC bootstrap producer contract.

extern fn rt_file_read_text(path: text) -> text
use std.spec.{describe, it, expect}

describe "Small-PC incremental bootstrap":
    it "bounds every Cargo authority branch without global configuration":
        val source = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        expect(source.split("CARGO_BUILD_JOBS=\"${jobs}\"").len()).to_equal(5)
        expect(source).to_not_contain("cargo config set")

    it "gates Stage3 streaming explicitly in command and cache identity":
        val producer = rt_file_read_text("scripts/bootstrap/bootstrap-from-scratch.sh") ?? ""
        val hash_start = producer.find("stage3_build_args_sha256=$(" ) ?? -1
        val stage_start = producer.find("# Stage 3: stage2 recompiles bootstrap_main.spl") ?? -1
        val stage_end = producer.find("stage3_status=$?") ?? -1
        expect(hash_start).to_be_greater_than(-1)
        expect(stage_start).to_be_greater_than(hash_start)
        expect(stage_end).to_be_greater_than(stage_start)
        expect(producer.substring(hash_start, stage_start)).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES=1")
        expect(producer.substring(stage_start, stage_end)).to_contain("SIMPLE_STAGE3_STREAMING_SURFACES=1")
        expect(producer.substring(stage_start, stage_end)).to_contain("SIMPLE_NATIVE_ARENA_DECLS=1")
