# @req ORCH-02 HOST-02
# Actual public routing, before native or filesystem effects. NOT_RUN.
# Requires the real Host containment installer command; no fake owner.
use app.orchestrator.command.orchestrator_command_v1
use std.spec.{describe, it, expect, step}

describe "public signed containment configuration installation routing":
    it "routes missing containment installation arguments to the actual host domain":
        step("routes missing containment installation arguments to the actual host domain")
        val reply = orchestrator_command_v1(["host-containment-install"])
        expect(reply.exit_code).to_equal(1)
        expect(reply.output).to_contain("host-local-error")
        expect(reply.output).to_contain("host-local-argument-count")
        expect(reply.output).to_contain("host-containment-install")
        expect(reply.journal_cleanup == nil and reply.host_journal_cleanup == nil).to_equal(true)

    it "refuses extra containment arguments before opening either caller path":
        step("refuses extra containment arguments before opening either caller path")
        val reply = orchestrator_command_v1(["host-containment-install", "/unused-root", "/unused-packet", "extra"])
        expect(reply.exit_code).to_equal(1)
        expect(reply.output).to_contain("host-local-error")
        expect(reply.output).to_contain("host-local-argument-count")
        expect(reply.journal_cleanup == nil and reply.host_journal_cleanup == nil).to_equal(true)
