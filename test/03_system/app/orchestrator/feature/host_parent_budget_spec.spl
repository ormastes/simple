# @req HOST-HELPER-04
# NOT_RUN. Actual signatures/retained journal; no helper/native effects.
use test.fixtures.orchestration.host_parent_budget_fixture_v1.*
use test.fixtures.orchestration.host_helper_fixture_v1.host_helper_clock_v1
use test.fixtures.orchestration.host_local_resolver_fixture_v2.host_local_resolver_consumed_fixture_v2
use std.nogc_sync_mut.orchestration.host_parent_budget_v1.*
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.HostReservationAuthorizationContextV1
use std.common.contracts.orchestration.controller_parent_budget_v1.controller_parent_budget_digest_v1
use std.nogc_sync_mut.io.file_ops.{file_exists, file_read_regular_no_follow_bounded}
use std.nogc_sync_mut.sffi.fs.file_atomic_write_mode

fn parent_budget_expired_clock_v1() -> HostReservationAuthorizationContextV1:
    var value = host_helper_clock_v1()
    value.grant_clock = 190
    value.monotonic_ms = 20
    value

describe "Signed parent budget publication precedes helper construction":
    it "publishes and reloads exact current authority without a helper packet or native query":
        val fixture = host_parent_budget_fixture_v1()
        val sequence = fixture.local.capacity.journal.sequence
        val digest = host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), host_helper_clock_v1).unwrap()
        expect(digest).to_equal(controller_parent_budget_digest_v1(fixture.record.proof.budget).unwrap())
        val loaded = host_parent_budget_load_v1(fixture.local, digest,
            fixture.record.proof.budget.parent_operation_id, host_helper_clock_v1(), host_helper_clock_v1).unwrap()
        expect(host_parent_budget_record_encode_v1(loaded).unwrap()).to_equal(host_parent_budget_record_encode_v1(fixture.record).unwrap())
        expect(host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), host_helper_clock_v1).unwrap()).to_equal(digest)
        assert(not file_exists(fixture.local.capacity.journal.root + "/host-helper-requests"))
        expect(fixture.local.capacity.journal.sequence).to_equal(sequence)
        expect(host_local_resolver_consumed_fixture_v2(fixture.local.container)).to_equal(0)
        host_parent_budget_fixture_close_v1(fixture)

    it "revalidates current expiry and exact selected parent on every retained load":
        val fixture = host_parent_budget_fixture_v1()
        val digest = host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), host_helper_clock_v1).unwrap()
        expect(host_parent_budget_load_v1(fixture.local, digest, "different-parent",
            host_helper_clock_v1(), host_helper_clock_v1).unwrap_err()).to_equal("parent-budget-reference-mismatch")
        expect(host_parent_budget_load_v1(fixture.local, digest, fixture.record.proof.budget.parent_operation_id,
            host_helper_clock_v1(), parent_budget_expired_clock_v1).unwrap_err()).to_equal("APPROVAL_EXPIRED")
        var changed = fixture.local
        changed.scope.continuity_id = "different-boot"
        changed.scope.boot_id = "different-boot"
        expect(host_parent_budget_load_v1(changed, digest, fixture.record.proof.budget.parent_operation_id,
            host_helper_clock_v1(), host_helper_clock_v1).unwrap_err()).to_equal("helper-current-scope-mismatch")
        expect(host_local_resolver_consumed_fixture_v2(fixture.local.container)).to_equal(0)
        host_parent_budget_fixture_close_v1(fixture)

    it "rejects forged signatures and late expiry before producing a planning reference":
        val fixture = host_parent_budget_fixture_v1()
        var forged = fixture.record
        forged.proof.signed.signature = [0u8; 64]
        assert(host_parent_budget_store_v1(fixture.local, forged, host_helper_clock_v1(), host_helper_clock_v1).is_err())
        assert(not file_exists(fixture.local.capacity.journal.root + "/host-parent-budget-records"))
        expect(host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), parent_budget_expired_clock_v1).unwrap_err()).to_equal("APPROVAL_EXPIRED")
        assert(not file_exists(fixture.local.capacity.journal.root + "/host-parent-budget-records"))
        host_parent_budget_fixture_close_v1(fixture)

    it "rejects noncanonical or corrupt retained records without replacing their bytes":
        val fixture = host_parent_budget_fixture_v1()
        val bytes = host_parent_budget_record_encode_v1(fixture.record).unwrap()
        expect(host_parent_budget_record_encode_v1(host_parent_budget_record_decode_v1(bytes).unwrap()).unwrap()).to_equal(bytes)
        assert(host_parent_budget_record_decode_v1(bytes + "\n").is_err())
        assert(host_parent_budget_record_decode_v1("version: 1\nkind: host-parent-budget\nunknown: true\n").is_err())
        val digest = host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), host_helper_clock_v1).unwrap()
        val path = fixture.local.capacity.journal.root + "/host-parent-budget-records/" + digest + ".sdn"
        assert(file_atomic_write_mode(path, "corrupt protected record\n", 0o600))
        assert(host_parent_budget_load_v1(fixture.local, digest, fixture.record.proof.budget.parent_operation_id,
            host_helper_clock_v1(), host_helper_clock_v1).is_err())
        expect(host_parent_budget_store_v1(fixture.local, fixture.record, host_helper_clock_v1(), host_helper_clock_v1).unwrap_err()).to_equal("parent-budget-retained-record-mismatch")
        expect(file_read_regular_no_follow_bounded(path, 2097152).unwrap()).to_equal("corrupt protected record\n")
        host_parent_budget_fixture_close_v1(fixture)
