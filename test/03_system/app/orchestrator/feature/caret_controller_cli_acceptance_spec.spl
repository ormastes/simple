# codex-system-test
# @req CARET-01 DAE-03 OPS-01
# AUTHORED_UNRUN: public subprocess metadata persistence acceptance only.
# No execution, live Podman, smux, remote runner or producer admission claim.
# @evidence-display: links
# **Captures:** SIMPLE_ORCHESTRATOR_ACCEPTANCE_ARTIFACT_ROOT (exec/protocol/artifact logs)
use std.spec.*
use test.fixtures.orchestrator_acceptance.caret_controller_cli.*

describe "Caret public controller metadata CLI":
    it "should retain submitted source and inspect it through another public client process":
        step("Open an isolated controller with explicitly pinned compiled binaries")
        val fixture = caret_controller_cli_fixture("fresh-process")
        step("Submit one workload through the public Caret CLI")
        val submitted = caret_controller_cli_submit(fixture, "submit", fixture.source_path)
        val retained = expect_caret_controller_receipt(fixture, submitted, "intent-retained")
        expect(caret_controller_cli_text(retained, "sourceDigest")).to_equal(fixture.source_digest)
        step("Inspect retained metadata through a fresh Caret process")
        val observed = caret_controller_cli_inspect(fixture, "inspect", fixture.controller_id, fixture.request_uid)
        val metadata = expect_caret_controller_receipt(fixture, observed, "intent-retained")
        expect(caret_controller_cli_text(metadata, "assignmentState")).to_equal("unbound")
        expect(caret_controller_cli_text(metadata, "schedulingState")).to_equal("intent-retained")
        expect(caret_controller_cli_text(metadata, "runtimeState")).to_equal("unobserved")
        expect(caret_controller_cli_bool(metadata, "terminationObserved")).to_equal(false)
        expect(caret_controller_cli_text(metadata, "desiredState")).to_equal("active")
        step("Read the retained source independently from the private journal objects")
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)

    it "should replay identical submission without advancing the durable journal":
        step("Open an isolated controller and submit one immutable request")
        val fixture = caret_controller_cli_fixture("identical-replay")
        val original = caret_controller_cli_submit(fixture, "original", fixture.source_path)
        val receipt = expect_caret_controller_receipt(fixture, original, "intent-retained")
        expect(caret_controller_cli_text(receipt, "sourceDigest")).to_equal(fixture.source_digest)
        val pointer = caret_controller_cli_journal_pointer(fixture)
        expect(pointer.len()).to_be_greater_than(0)
        step("Replay the same UID and source through another Caret process")
        val replay = caret_controller_cli_submit(fixture, "replay", fixture.source_path)
        val replay_receipt = expect_caret_controller_receipt(fixture, replay, "intent-retained")
        expect(caret_controller_cli_text(replay_receipt, "sourceDigest")).to_equal(fixture.source_digest)
        expect(replay.stdout).to_equal(original.stdout)
        step("Compare the durable journal pointer and retained bytes")
        expect(caret_controller_cli_journal_pointer(fixture)).to_equal(pointer)
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)

    it "should refuse changed source under the same UID and preserve the original intent":
        step("Submit one immutable request and retain its journal pointer")
        val fixture = caret_controller_cli_fixture("changed-source")
        val original = caret_controller_cli_submit(fixture, "original", fixture.source_path)
        val receipt = expect_caret_controller_receipt(fixture, original, "intent-retained")
        expect(caret_controller_cli_text(receipt, "sourceDigest")).to_equal(fixture.source_digest)
        val pointer = caret_controller_cli_journal_pointer(fixture)
        step("Submit a different valid task reference with the original UID")
        val changed_path = caret_controller_cli_changed_source(fixture)
        val rejected = caret_controller_cli_submit(fixture, "changed", changed_path)
        expect(rejected.exit_code).to_equal(1)
        expect(caret_controller_cli_text(rejected.reply, "code")).to_equal("controller-error")
        expect(caret_controller_cli_bool(rejected.reply, "confirmed")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "status")).to_equal("unconfirmed")
        expect(caret_controller_cli_bool(rejected.reply, "reconciliationRequired")).to_equal(true)
        expect(caret_controller_cli_bool(rejected.reply, "executionAuthorized")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "requestUid")).to_equal(fixture.request_uid)
        step("Verify unchanged durable state and inspect the original intent again")
        expect(caret_controller_cli_journal_pointer(fixture)).to_equal(pointer)
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)
        val observed = caret_controller_cli_inspect(fixture, "after-conflict", fixture.controller_id, fixture.request_uid)
        val metadata = expect_caret_controller_receipt(fixture, observed, "intent-retained")
        expect(caret_controller_cli_text(metadata, "sourceDigest")).to_equal(fixture.source_digest)

    it "should refuse another controller identity without changing retained state":
        step("Submit one request to the initialized controller")
        val fixture = caret_controller_cli_fixture("wrong-controller")
        val original = caret_controller_cli_submit(fixture, "original", fixture.source_path)
        val receipt = expect_caret_controller_receipt(fixture, original, "intent-retained")
        expect(caret_controller_cli_text(receipt, "sourceDigest")).to_equal(fixture.source_digest)
        val pointer = caret_controller_cli_journal_pointer(fixture)
        step("Inspect the same UID using a different controller identity")
        val rejected = caret_controller_cli_inspect(fixture, "wrong-controller", "other-controller", fixture.request_uid)
        expect(caret_controller_cli_text(rejected.reply, "controllerId")).to_equal("other-controller")
        expect(rejected.exit_code).to_equal(1)
        expect(caret_controller_cli_text(rejected.reply, "code")).to_equal("controller-error")
        expect(caret_controller_cli_bool(rejected.reply, "confirmed")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "status")).to_equal("unconfirmed")
        expect(caret_controller_cli_bool(rejected.reply, "reconciliationRequired")).to_equal(true)
        expect(caret_controller_cli_bool(rejected.reply, "executionAuthorized")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "requestUid")).to_equal(fixture.request_uid)
        step("Compare the original journal pointer and source bytes")
        expect(caret_controller_cli_journal_pointer(fixture)).to_equal(pointer)
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)

    it "should reject a relative controller executable before invoking it":
        step("Submit one request and record its durable journal pointer")
        val fixture = caret_controller_cli_fixture("relative-executable")
        val original = caret_controller_cli_submit(fixture, "original", fixture.source_path)
        val receipt = expect_caret_controller_receipt(fixture, original, "intent-retained")
        expect(caret_controller_cli_text(receipt, "sourceDigest")).to_equal(fixture.source_digest)
        val pointer = caret_controller_cli_journal_pointer(fixture)
        step("Invoke public Caret inspect with an implicit relative executable")
        val rejected = caret_controller_cli_run(fixture, "relative-executable", ["orchestrator", "simple_orchestrator", "inspect", fixture.state_root, fixture.controller_id, fixture.request_uid])
        expect(rejected.exit_code).to_equal(2)
        expect(caret_controller_cli_text(rejected.reply, "code")).to_equal("path-invalid")
        expect(caret_controller_cli_bool(rejected.reply, "confirmed")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "status")).to_equal("unconfirmed")
        expect(caret_controller_cli_bool(rejected.reply, "reconciliationRequired")).to_equal(false)
        expect(caret_controller_cli_bool(rejected.reply, "executionAuthorized")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "controllerId")).to_equal(fixture.controller_id)
        expect(caret_controller_cli_text(rejected.reply, "requestUid")).to_equal(fixture.request_uid)
        step("Verify the preflight refusal did not alter durable metadata")
        expect(caret_controller_cli_journal_pointer(fixture)).to_equal(pointer)
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)

    it "should reject extra public CLI arguments without changing the journal":
        step("Submit one request and record its durable journal pointer")
        val fixture = caret_controller_cli_fixture("extra-argument")
        val original = caret_controller_cli_submit(fixture, "original", fixture.source_path)
        val receipt = expect_caret_controller_receipt(fixture, original, "intent-retained")
        expect(caret_controller_cli_text(receipt, "sourceDigest")).to_equal(fixture.source_digest)
        val pointer = caret_controller_cli_journal_pointer(fixture)
        step("Invoke public Caret inspect with an unexpected trailing argument")
        val rejected = caret_controller_cli_run(fixture, "extra-argument", ["orchestrator", fixture.controller_binary, "inspect", fixture.state_root, fixture.controller_id, fixture.request_uid, "unexpected"])
        expect(rejected.exit_code).to_equal(2)
        expect(caret_controller_cli_text(rejected.reply, "code")).to_equal("usage-invalid")
        expect(caret_controller_cli_bool(rejected.reply, "confirmed")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "status")).to_equal("unconfirmed")
        expect(caret_controller_cli_bool(rejected.reply, "reconciliationRequired")).to_equal(false)
        expect(caret_controller_cli_bool(rejected.reply, "executionAuthorized")).to_equal(false)
        expect(caret_controller_cli_text(rejected.reply, "controllerId")).to_equal(fixture.controller_id)
        expect(caret_controller_cli_text(rejected.reply, "requestUid")).to_equal(fixture.request_uid)
        step("Verify the usage refusal preserved the journal and source")
        expect(caret_controller_cli_journal_pointer(fixture)).to_equal(pointer)
        expect(caret_controller_cli_retained_source(fixture)).to_equal(fixture.source_text)
