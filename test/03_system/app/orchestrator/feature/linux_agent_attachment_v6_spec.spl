# AUTHORED_NOT_RUN. Dedicated enrolled Linux V6 Host, held agent and real smux required.
use std.spec.{describe, it, expect, step, fail, pending}
use std.sosix.time.{sosix_sleep_ms, sosix_time_now_monotonic_ms}
use std.common.crypto.sha256.sha256_text
use std.common.sdn.value.SdnValue
use std.common.sdn.strict_v1.sdn_parse_strict_v1
use std.common.sdn.strict_types_v1.SdnStrictLimitsV1
use std.common.contracts.container.execution_v2.{ContainerHostScopeV2, container_host_scope_bytes_v2,
    container_scope_fence_id_v2}
use std.common.contracts.container.primary_attach_v1.{HostAgentPaneBindingV4, host_agent_pane_binding_decode_v4,
    container_primary_attach_plan_decode_v1}
use std.common.contracts.orchestration.host_agent_pane_stream_v6.{HostAgentPaneStreamRequestV6, HostAgentPaneStreamReceiptV6,
    host_agent_pane_stream_request_encode_v6, host_agent_pane_stream_receipt_decode_v6,
    host_agent_pane_target_receipt_decode_v6}
use std.common.contracts.orchestration.host_control_operation_v6.{HostControlSubRequestV6, host_control_sub_encode_v6}
use std.common.contracts.orchestration.host_service_operation_v6.{HostServiceOperationRequestV6, host_service_operation_request_digest_v6}
use std.common.contracts.orchestration.host_service_operation_reply_v6.HostServiceOperationReplyV6
use std.nogc_sync_mut.orchestration.host_agent_attachment_v4.{host_agent_attach_request_decode_v4,
    host_agent_detach_request_decode_v4}
use std.nogc_sync_mut.orchestration.host_execution_observation_v2.host_execution_observation_decode_v2
use std.nogc_sync_mut.orchestration.host_linux_service_agent_v4.host_agent_invoke_request_decode_v4
use std.nogc_sync_mut.io.env_ops.env_get
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded
use test.fixtures.orchestration.host_authenticated_route_fixture_v6.{route_fixture_parse_v6, route_open_v6,
    route_status_v6, route_exchange_v6, route_cleanup_v6, route_client_released_v6}

struct LinuxAgentControlFixtureV6:
    route: Dict<text, text>
    operation_id: text
    binding: HostAgentPaneBindingV4
    attach: text
    invoke: text
    detach: text

fn attachment_fixture_read_v6(name: text, maximum: i64) -> Result<text, text>:
    val path = env_get(name)
    if path == "": return Err("BLOCKED: enrolled Linux V6 attachment fixture requires " + name)
    file_read_regular_no_follow_bounded(path, maximum)

fn attachment_fixture_load_v6() -> Result<LinuxAgentControlFixtureV6, text>:
    val route = route_fixture_parse_v6(attachment_fixture_read_v6("SIMPLE_LINUX_ATTACH_V6_READY", 32768)?)?
    val attach = attachment_fixture_read_v6("SIMPLE_LINUX_ATTACH_V6_ATTACH", 2097152)?
    val invoke = attachment_fixture_read_v6("SIMPLE_LINUX_ATTACH_V6_INVOKE", 2097152)?
    val detach = attachment_fixture_read_v6("SIMPLE_LINUX_ATTACH_V6_DETACH", 1048576)?
    val attached = host_agent_attach_request_decode_v4(attach)?
    val binding = host_agent_pane_binding_decode_v4(attached.pane_binding)?
    val invoked = host_agent_invoke_request_decode_v4(invoke)?
    val detached = host_agent_detach_request_decode_v4(detach)?
    val operation = attached.operation_id
    if (invoked.operation_id != operation or detached.operation_id != operation or
            detached.association_digest != attached.association_digest or detached.attach_digest != sha256_text(attach)):
        return Err("Linux V6 attachment fixture packet binding")
    Ok(LinuxAgentControlFixtureV6(route, operation, binding, attach, invoke, detach))

fn attachment_control_v6(incarnation: text, scope: text, operation: text, sub: text,
        frame: text) -> Result<HostServiceOperationReplyV6, text>:
    val body = host_control_sub_encode_v6(HostControlSubRequestV6(sub, frame))?
    val digest = host_service_operation_request_digest_v6(operation, body)?
    route_exchange_v6(HostServiceOperationRequestV6("host-control", incarnation, operation, scope, digest, body))

fn attachment_report_v6(reply: HostServiceOperationReplyV6, operation: text) -> Result<Dict<text, SdnValue>, text>:
    if reply.pending or reply.exit_code != 0 or reply.error != "":
        return Err("Linux V6 attachment report refused")
    val parsed = sdn_parse_strict_v1(reply.payload, SdnStrictLimitsV1(max_source_bytes: 65536,
        max_depth: 2, max_nodes: 32, max_rows: 0, max_cells: 0, max_columns: 16))
    if parsed.is_err(): return Err("Linux V6 attachment report SDN")
    match parsed.unwrap().value:
        case SdnValue.Dict(fields):
            if (not fields.contains_key("kind") or fields["kind"] != SdnValue.String("linux-host-agent-attachment") or
                    not fields.contains_key("version") or fields["version"] != SdnValue.Int(4) or
                    not fields.contains_key("operationId") or fields["operationId"] != SdnValue.String(operation) or
                    not fields.contains_key("attachStage")):
                return Err("Linux V6 attachment report binding mismatch")
            return Ok(fields)
        case _: return Err("Linux V6 attachment report must be an object")

fn attachment_observe_until_v6(incarnation: text, scope: text, fixture: LinuxAgentControlFixtureV6,
        release: bool) -> Result<Dict<text, SdnValue>, text>:
    val started = sosix_time_now_monotonic_ms()
    var polls = 0
    while started >= 0 and polls < 4000:
        val now = sosix_time_now_monotonic_ms()
        if now < started or now - started >= 80000: break
        val operation = fixture.operation_id
        val inspected = attachment_control_v6(incarnation, scope, operation, "agent-inspect", operation)?
        val report = attachment_report_v6(inspected, operation)?
        if not report.contains_key("attachDigest") or report["attachDigest"] != SdnValue.String(sha256_text(fixture.attach)):
            return Err("Linux V6 attachment archive identity changed")
        if release:
            if report["attachStage"] == SdnValue.String("returned"): return Ok(report)
        elif report.contains_key("terminalAuthority") and report["terminalAuthority"] == SdnValue.String("verified"):
            return Ok(report)
        if report["attachStage"] == SdnValue.String("release-blocked") or report["attachStage"] == SdnValue.String("failed"):
            return Err("Linux V6 attachment entered a failure stage")
        val advanced = attachment_control_v6(incarnation, scope, operation, "agent-invoke", fixture.invoke)?
        if advanced.pending or advanced.exit_code != 0 or advanced.error != "":
            return Err("Linux V6 agent progression refused")
        sosix_sleep_ms(10)
        polls = polls + 1
    Err("Linux V6 attachment terminal observation deadline")

fn attachment_pane_receipt_v6(reply: HostServiceOperationReplyV6, operation: text,
        request: HostAgentPaneStreamRequestV6) -> Result<HostAgentPaneStreamReceiptV6, text>:
    if reply.pending or reply.exit_code != 0 or reply.error != "":
        return Err("Linux V6 pane request refused: " + reply.error)
    val receipt = host_agent_pane_stream_receipt_decode_v6(reply.payload)?
    if (receipt.operation_id != operation or receipt.binding_uid != request.binding_uid or
            receipt.attach_digest != request.attach_digest or receipt.read_id != request.read_id or
            receipt.epoch < 0 or (request.read_id > 0 and receipt.epoch != request.epoch) or
            receipt.payload_digest != sha256_text(receipt.payload)):
        return Err("Linux V6 pane receipt identity or content digest mismatch")
    Ok(receipt)

fn attachment_pane_retry_v6(reply: HostServiceOperationReplyV6, original: HostServiceOperationReplyV6) -> bool:
    not reply.pending and reply.exit_code == 0 and reply.error == "" and reply.payload == original.payload

fn attachment_pane_refused_v6(reply: HostServiceOperationReplyV6, reason: text) -> bool:
    not reply.pending and reply.exit_code == 2 and reply.error == reason and reply.payload == ""

fn attachment_pane_trial_v6(incarnation: text, scope: text, fixture: LinuxAgentControlFixtureV6,
        other_operation: text) -> Result<bool, text>:
    val operation = fixture.operation_id
    val binding = fixture.binding.binding_uid
    val digest = sha256_text(fixture.attach)
    step("Claim the signed pane twice and require the same stream epoch and receipt")
    val claim = HostAgentPaneStreamRequestV6(binding, digest, 0, 0)
    val claim_frame = host_agent_pane_stream_request_encode_v6(claim)
    val claimed = attachment_control_v6(incarnation, scope, operation, "agent-pane-claim", claim_frame)?
    val claim_receipt = attachment_pane_receipt_v6(claimed, operation, claim)?
    val reclaimed = attachment_control_v6(incarnation, scope, operation, "agent-pane-claim", claim_frame)?
    if not attachment_pane_retry_v6(reclaimed, claimed):
        return Err("Linux V6 pane claim retry changed the receipt")

    step("Refuse mismatched operation and binding IDs and a read that skips the cursor")
    val first = HostAgentPaneStreamRequestV6(binding, digest, claim_receipt.epoch, 1)
    val first_frame = host_agent_pane_stream_request_encode_v6(first)
    val wrong_operation = attachment_control_v6(incarnation, scope, other_operation, "agent-pane-read", first_frame)?
    val other_binding = if binding == "sspec-different-pane": "sspec-another-pane" else: "sspec-different-pane"
    val wrong_binding_frame = host_agent_pane_stream_request_encode_v6(HostAgentPaneStreamRequestV6(other_binding, digest, claim_receipt.epoch, 1))
    val wrong_binding = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", wrong_binding_frame)?
    if not attachment_pane_refused_v6(wrong_operation, "runtime-agent-pane-operation-mismatch"):
        return Err("Linux V6 pane preflight did not refuse the wrong operation")
    if not attachment_pane_refused_v6(wrong_binding, "attach-binding-mismatch"):
        return Err("Linux V6 pane preflight did not refuse the wrong binding")
    val next = HostAgentPaneStreamRequestV6(binding, digest, claim_receipt.epoch, 2)
    val next_frame = host_agent_pane_stream_request_encode_v6(next)
    val future = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", next_frame)?
    if not attachment_pane_refused_v6(future, "runtime-agent-pane-read-out-of-order"):
        return Err("Linux V6 pane preflight did not refuse the future read ID")

    step("Read from the installed pane and retry the latest read with the same receipt")
    val read = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", first_frame)?
    val _first_receipt = attachment_pane_receipt_v6(read, operation, first)?
    val repeated = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", first_frame)?
    if not attachment_pane_retry_v6(repeated, read): return Err("Linux V6 duplicate pane read changed the receipt")

    step("Advance the pane read and require an explicit gap when replaying an older receipt")
    val advanced = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", next_frame)?
    val _next_receipt = attachment_pane_receipt_v6(advanced, operation, next)?
    val gap = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", first_frame)?
    if not attachment_pane_refused_v6(gap, "runtime-agent-pane-replay-gap"):
        return Err("Linux V6 older pane read did not report a replay gap")
    val retained = attachment_control_v6(incarnation, scope, operation, "agent-pane-read", next_frame)?
    if not attachment_pane_retry_v6(retained, advanced): return Err("Linux V6 replay gap changed the latest receipt")
    Ok(true)

fn attachment_trial_v6(fixture: LinuxAgentControlFixtureV6) -> Result<bool, text>:
    val incarnation = route_open_v6(fixture.route)?
    val status = route_status_v6(fixture.route, incarnation)?
    val scope = container_scope_fence_id_v2(status.scope)?
    val operation = fixture.operation_id
    step("Inspect the held Linux agent before the first attachment")
    val before = attachment_report_v6(attachment_control_v6(incarnation, scope, operation, "agent-inspect", operation)?, operation)?
    if before["attachStage"] != SdnValue.String("none"): return Err("Linux V6 fixture already has an attachment")
    step("Verify the held invocation returns the same vacant target bound into the signed attachment")
    val target = attachment_control_v6(incarnation, scope, operation, "agent-pane-target", fixture.invoke)?
    if target.pending or target.exit_code != 0 or target.error != "":
        return Err("Linux V6 pane target refused: " + target.error)
    val receipt = host_agent_pane_target_receipt_decode_v6(target.payload)?
    val binding = fixture.binding
    if (receipt.operation_id != operation or receipt.invoke_digest != sha256_text(fixture.invoke) or
            receipt.service_incarnation != status.scope.continuity_id or receipt.service_incarnation != binding.service_incarnation or
            receipt.service_epoch != binding.service_epoch or receipt.session_id != binding.session_id or
            receipt.window_id != binding.window_id or receipt.pane_id != binding.pane_id):
        return Err("Linux V6 pane target receipt differs from the held invocation or signed pane binding")
    val repeated = attachment_control_v6(incarnation, scope, operation, "agent-pane-target", fixture.invoke)?
    if not attachment_pane_retry_v6(repeated, target): return Err("Linux V6 pane target retry changed the receipt")
    step("Refuse a correctly authenticated envelope with the wrong operation ID")
    val other = if operation == "sspec-different-run": "sspec-another-run" else: "sspec-different-run"
    val wrong_observation = attachment_control_v6(incarnation, scope, other, "agent-runtime-inspect", fixture.invoke)?
    if not attachment_pane_refused_v6(wrong_observation, "linux-host-agent-pane-target-operation-mismatch"):
        return Err("Linux V6 runtime inspection returned evidence for the wrong run")
    step("Read the archived running observation and match the exact signed runtime")
    val observed = attachment_control_v6(incarnation, scope, operation, "agent-runtime-inspect", fixture.invoke)?
    if observed.pending or observed.exit_code != 0 or observed.error != "":
        return Err("Linux V6 runtime observation refused: " + observed.error)
    val native = host_execution_observation_decode_v2(observed.payload)?
    val attach = host_agent_attach_request_decode_v4(fixture.attach)?
    val plan = container_primary_attach_plan_decode_v1(attach.plan)?
    val workload = plan.workload
    val signed_scope = ContainerHostScopeV2(physical_host_id: workload.physical_host_id, service_scope_id: workload.service_scope_id,
        boot_id: workload.boot_id, provider_generation: workload.provider_generation, native_machine_id: workload.native_machine_id,
        continuity_mode: workload.continuity_mode, continuity_id: workload.continuity_id)
    if (native.scope == status.scope or native.scope.physical_host_id != status.scope.physical_host_id or
            container_host_scope_bytes_v2(native.scope)? != container_host_scope_bytes_v2(signed_scope)? or
            native.operation_id != operation or native.runtime != plan.runtime or
            native.request_digest != plan.workload.request_digest or native.provider_identity_digest != plan.provider_identity_digest or
            native.phase != "running" or native.inspect_status != "ok"):
        return Err("Linux V6 retained runtime differs from its signed attach plan")
    val wrong = attachment_control_v6(incarnation, scope, other, "agent-attach", fixture.attach)?
    if wrong.exit_code == 0 or not wrong.payload.contains("host-service-agent-attachment-operation-mismatch"):
        return Err("Linux V6 mismatched attachment envelope was not refused")
    val unchanged = attachment_report_v6(attachment_control_v6(incarnation, scope, operation, "agent-inspect", operation)?, operation)?
    if unchanged != before: return Err("Linux V6 refused envelope changed attachment state")
    step("Admit the genuine signed attachment and drive the same immutable agent invocation")
    val opened = attachment_report_v6(attachment_control_v6(incarnation, scope, operation, "agent-attach", fixture.attach)?, operation)?
    if (opened["attachStage"] != SdnValue.String("opening") or not opened.contains_key("attachDigest") or
            opened["attachDigest"] != SdnValue.String(sha256_text(fixture.attach))):
        return Err("Linux V6 did not retain the exact signed attachment")
    val ready = attachment_observe_until_v6(incarnation, scope, fixture, false)?
    if not [SdnValue.String("ready"), SdnValue.String("adopted")].contains(ready["attachStage"]):
        return Err("Linux V6 terminal authority lacks a held ready attachment")
    val _pane = attachment_pane_trial_v6(incarnation, scope, fixture, other)?
    step("Detach through the separately signed request and require exact attachment return")
    val _detached = attachment_report_v6(attachment_control_v6(incarnation, scope, operation, "agent-detach", fixture.detach)?, operation)?
    val returned = attachment_observe_until_v6(incarnation, scope, fixture, true)?
    if (not returned.contains_key("detachDigest") or returned["detachDigest"] != SdnValue.String(sha256_text(fixture.detach)) or
            returned.contains_key("terminalAuthority")):
        return Err("Linux V6 detached attachment returned stale terminal authority")
    Ok(true)

describe "Authenticated V6 signed Linux agent attachment":
    it "attaches, reads, and detaches the held exact agent using the installed smux owner":
        val fixture = attachment_fixture_load_v6()
        if fixture.is_err():
            # An unset fixture is BLOCKED (counted, exit 6); a malformed one is a failure.
            if fixture.unwrap_err().starts_with("BLOCKED:"):
                pending(fixture.unwrap_err())
            else:
                fail(fixture.unwrap_err())
            return
        val result = attachment_trial_v6(fixture.unwrap())
        step("Release the actual client exchange and ready reader before evaluating evidence")
        val closed = route_cleanup_v6()
        expect(closed).to_equal("")
        expect(route_client_released_v6()).to_equal(true)
        if result.is_err():
            fail(result.unwrap_err())
            return
        expect(result.unwrap()).to_equal(true)
