# @req HOST-LOCAL-01 HOST-LOCAL-04
# NOT_RUN. Real signatures, private filesystem and capacity journal.
use test.fixtures.daemon_sdk.distributed_authority_verification_fixture_v2.*
use std.nogc_sync_mut.orchestration.host_authorized_reservation_v1.*
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*
use std.common.contracts.orchestration.host_prepare_request_v1.*
use std.common.contracts.orchestration.host_capacity_v1.*
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.nogc_sync_mut.daemon_sdk.distributed_authority_snapshot_v2.*
use std.nogc_sync_mut.daemon_sdk.distributed_grant_verification_v2.*
use std.common.contracts.distributed_control_codec_v2.*
use std.common.crypto.ed25519.pure_ed25519_sign_from_seed_v1
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.io.file_ops.{secure_temp_dir, file_exists}
use std.nogc_sync_mut.io_runtime.dir_remove

struct SignedPrepareFixtureV1:
    owner: HostCapacityOwnerV1
    request: HostPrepareRequestV1
    snapshot: DistributedAuthoritySnapshotV2

fn signed_prepare_clock_v1() -> HostReservationAuthorizationContextV1:
    HostReservationAuthorizationContextV1(grant_clock: 100, monotonic_ms: 10,
        policy_revision: 4, revocation_epoch: 2, session_generation: 3)

fn signed_prepare_expired_v1() -> HostReservationAuthorizationContextV1:
    HostReservationAuthorizationContextV1(grant_clock: 190, monotonic_ms: 11,
        policy_revision: 4, revocation_epoch: 2, session_generation: 3)

fn signed_prepare_fixture_v1() -> SignedPrepareFixtureV1:
    val base = verification_fixture()
    val root = secure_temp_dir("/tmp", "host-signed-prepare").unwrap()
    val capacity = HostCapacityV1(physical_host_id: "worker_1", authority_id: "host-authority", boot_id: "boot-1",
        provider_generation: 1, cpu_millis: 2000, memory_bytes: 4096, exclusive_devices: [])
    val owner = host_capacity_owner_open_v1(root, capacity, "c".repeat(64), 50, true).unwrap()
    val row = HostReservationV1(id: "reservation", operation_id: base.request.id, payload_digest: "0".repeat(64),
        service_scope_id: "scope", assignment_generation: 1, nonce: "nonce", cpu_millis: 1000,
        memory_bytes: 512, exclusive_devices: [], prepare_deadline_ms: 1000, state: HostReservationStateV1.Prepared)
    val intent = host_reservation_bind_intent_v1(HostReservationIntentV1(physical_host_id: "worker_1",
        fence: HostLedgerFenceV1(authority_id: "host-authority", boot_id: "boot-1", provider_generation: 1, revision: 1),
        plan_digest: "a".repeat(64), reservation: row)).unwrap()
    var operation = base.request
    operation.operation = "host_reservation_v1"
    operation.payload_digest = intent.reservation.payload_digest
    var signed = base.signed
    signed.grant.operations = ["host_reservation_v1"]
    signed.signature = pure_ed25519_sign_from_seed_v1(verification_seed(1), distributed_grant_signature_message_v2(signed).unwrap()).signature
    var approval = base.approval
    approval.grant_digest = sha256_text(distributed_encode_grant_v2(signed.grant).unwrap())
    approval.request_digest = sha256_text(distributed_encode_operation_v2(operation).unwrap())
    approval.signature = pure_ed25519_sign_from_seed_v1(verification_seed(65), distributed_approval_signature_message_v2(approval).unwrap()).signature
    var issuer = base.issuer
    issuer.operations = ["host_reservation_v1"]
    var approver = base.approver
    approver.operations = ["host_reservation_v1"]
    val snapshot = distributed_authority_snapshot_create_v2([issuer, approver], 7, 4, 2).unwrap()
    SignedPrepareFixtureV1(owner: owner, request: HostPrepareRequestV1(intent: intent,
        operation: operation, signed: signed, approval: approval), snapshot: snapshot)

describe "Signed preparation through the actual host owner":
    it "opens over-capacity released history only as charged quarantine for actual reconciliation":
        val fixture = signed_prepare_fixture_v1()
        var owner = fixture.owner
        for index in [0, 1, 2]:
            var intent = fixture.request.intent
            intent.fence.revision = owner.ledger.revision
            intent.reservation.id = "history-reservation-{index}"
            intent.reservation.operation_id = "history-operation-{index}"
            intent.reservation.nonce = "history-nonce-{index}"
            intent.reservation.prepare_deadline_ms = (index + 1) * 1000
            intent = host_reservation_bind_intent_v1(intent).unwrap()
            var operation = fixture.request.operation
            operation.id = intent.reservation.operation_id
            operation.payload_digest = intent.reservation.payload_digest
            var context = signed_prepare_clock_v1()
            context.monotonic_ms = index * 1000 + 10
            # Trusted primitive fixture: public signed admission has real
            # signature cases below; no signature bypass claim is made here.
            owner = host_capacity_owner_prepare_v1(owner, intent, operation,
                fixture.request.signed.grant, context).unwrap()
            owner = host_capacity_owner_expire_prepared_v1(owner, operation.id,
                intent.reservation.prepare_deadline_ms).unwrap()
            expect(host_available_capacity_v1(owner.ledger).unwrap().cpu_millis).to_equal(2000)
        expect(owner.ledger.reservations.len()).to_equal(3)
        assert(host_capacity_owner_close_v1(owner).unwrap())
        var capacity = owner.ledger.capacity
        capacity.boot_id = "fresh-service-fence"
        val quarantined = host_capacity_owner_open_quarantined_v2(owner.journal.root,
            capacity, "e".repeat(64), 50).unwrap()
        assert(not quarantined.ledger.continuity_proven)
        expect(quarantined.ledger.reservations.len()).to_equal(3)
        for row in quarantined.ledger.reservations:
            expect(row.state).to_equal(HostReservationStateV1.Uncertain)
            expect(quarantined.journal.operations[row.operation_id].state).to_equal("cancelled")
        expect(host_available_capacity_v1(quarantined.ledger).unwrap_err()).to_equal("capacity-exceeded")
        assert(host_capacity_owner_close_v1(quarantined).unwrap())
        dir_remove(owner.journal.root, true)

    it "returns the same durable receipt across exact replay and a newly opened writer":
        val fixture = signed_prepare_fixture_v1()
        val payload = host_prepare_request_encode_v1(fixture.request).unwrap()
        val first = host_authorized_prepare_reply_v1(fixture.owner, payload, fixture.snapshot, 7,
            signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap()
        val replay = host_authorized_prepare_reply_v1(first.owner, payload, fixture.snapshot, 7,
            signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap()
        expect(replay.response).to_equal(first.response)
        expect(replay.owner.journal.sequence).to_equal(first.owner.journal.sequence)
        expect(host_available_capacity_v1(replay.owner.ledger).unwrap().cpu_millis).to_equal(1000)
        assert(host_capacity_owner_close_v1(replay.owner).unwrap())
        val reopened = host_capacity_owner_open_v1(fixture.owner.journal.root, fixture.owner.ledger.capacity,
            "d".repeat(64), 50, true).unwrap()
        val recovered = host_authorized_prepare_reply_v1(reopened, payload, fixture.snapshot, 7,
            signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap()
        expect(recovered.response).to_equal(first.response)
        assert(host_capacity_owner_close_v1(recovered.owner).unwrap())
        dir_remove(fixture.owner.journal.root, true)

    it "rejects corrupted signatures and expiry after verification before publishing a reservation":
        val fixture = signed_prepare_fixture_v1()
        var corrupted = fixture.request
        corrupted.approval.signature[0] = ((corrupted.approval.signature[0] as i64 + 1) % 256) as u8
        expect(host_authorized_prepare_reply_v1(fixture.owner, host_prepare_request_encode_v1(corrupted).unwrap(),
            fixture.snapshot, 7, signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap_err()).to_equal("APPROVAL_SIGNATURE_INVALID")
        expect(host_authorized_prepare_reply_v1(fixture.owner, host_prepare_request_encode_v1(fixture.request).unwrap(),
            fixture.snapshot, 7, signed_prepare_clock_v1(), signed_prepare_expired_v1).unwrap_err()).to_equal("APPROVAL_EXPIRED")
        expect(fixture.owner.journal.operations.len()).to_equal(0)
        assert(not file_exists(fixture.owner.journal.root + "/reservation-payloads"))
        expect(host_available_capacity_v1(fixture.owner.ledger).unwrap().cpu_millis).to_equal(2000)
        assert(host_capacity_owner_close_v1(fixture.owner).unwrap())
        dir_remove(fixture.owner.journal.root, true)

    it "rejects oversized UTF8 and noncanonical packets before owner mutation":
        val fixture = signed_prepare_fixture_v1()
        expect(host_prepare_request_decode_v1("😀".repeat(300000)).unwrap_err()).to_equal("host-prepare-request-too-large")
        val payload = host_prepare_request_encode_v1(fixture.request).unwrap()
        expect(host_authorized_prepare_reply_v1(fixture.owner, payload + "\n", fixture.snapshot, 7,
            signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap_err()).to_equal("host-prepare-request-not-canonical")
        expect(fixture.owner.journal.operations.len()).to_equal(0)
        assert(not file_exists(fixture.owner.journal.root + "/reservation-payloads"))
        assert(host_capacity_owner_close_v1(fixture.owner).unwrap())
        dir_remove(fixture.owner.journal.root, true)

    it "quarantines prior service fences without releasing prepared or executing resources":
        for mode in ["prepared", "executing"]:
            val fixture = signed_prepare_fixture_v1()
            val payload = host_prepare_request_encode_v1(fixture.request).unwrap()
            val reply = host_authorized_prepare_reply_v1(fixture.owner, payload, fixture.snapshot, 7,
                signed_prepare_clock_v1(), signed_prepare_clock_v1).unwrap()
            var retained = reply.owner
            if mode == "executing":
                # This tests the trusted capacity primitive, not a signature
                # bypass: the public signed executor has separate crypto specs.
                var grant = fixture.request.signed.grant
                grant.operations = ["host_execute_v1"]
                val receipt = host_reservation_receipt_v1(fixture.request.intent, fixture.request.operation).unwrap()
                val fence = HostLedgerFenceV1(authority_id: retained.ledger.capacity.authority_id,
                    boot_id: retained.ledger.capacity.boot_id, provider_generation: retained.ledger.capacity.provider_generation,
                    revision: retained.ledger.revision)
                retained = host_capacity_owner_begin_v1(retained, fixture.request.intent, fixture.request.operation,
                    receipt, fence, grant, signed_prepare_clock_v1()).unwrap()
            assert(host_capacity_owner_close_v1(retained).unwrap())
            var changed = retained.ledger.capacity
            changed.boot_id = "new-service-fence"
            expect(host_capacity_owner_open_v1(retained.journal.root, changed, "d".repeat(64), 50, true).unwrap_err()).to_equal("retained-reservation-host-fence-mismatch")
            val quarantined = host_capacity_owner_open_quarantined_v2(retained.journal.root, changed,
                "e".repeat(64), 50).unwrap()
            assert(not quarantined.ledger.continuity_proven)
            expect(quarantined.ledger.reservations[0].state).to_equal(HostReservationStateV1.Uncertain)
            expect(host_available_capacity_v1(quarantined.ledger).unwrap().cpu_millis).to_equal(1000)
            expect(host_available_capacity_v1(quarantined.ledger).unwrap().memory_bytes).to_equal(3584)
            expect(quarantined.journal.operations[fixture.request.operation.id].state).to_equal(
                if mode == "executing": "outcome-unknown" else: "admitted")
            expect(host_capacity_owner_prepared_receipt_v1(quarantined, fixture.request.intent,
                fixture.request.operation, fixture.request.signed.grant, signed_prepare_clock_v1()).unwrap_err()).to_equal("retained-reservation-host-fence-mismatch")
            assert(host_capacity_owner_close_v1(quarantined).unwrap())
            dir_remove(fixture.owner.journal.root, true)

    it "keeps helper action admission distinct and counts its allocation in the same ledger":
        val fixture = signed_prepare_fixture_v1()
        var operation = fixture.request.operation
        operation.operation = "host_helper_reservation_v1"
        var grant = fixture.request.signed.grant
        grant.operations = ["host_helper_reservation_v1"]
        # Capacity APIs are trusted internal primitives. The helper service
        # separately verifies signatures and retained parent-budget authority.
        expect(host_capacity_owner_prepare_v1(fixture.owner, fixture.request.intent, operation,
            grant, signed_prepare_clock_v1()).unwrap_err()).to_equal("reservation-operation-mismatch")
        assert(not file_exists(fixture.owner.journal.root + "/reservation-payloads"))
        val prepared = host_capacity_owner_prepare_helper_v1(fixture.owner, fixture.request.intent,
            operation, grant, signed_prepare_clock_v1()).unwrap()
        expect(host_available_capacity_v1(prepared.ledger).unwrap().cpu_millis).to_equal(1000)
        val receipt = host_capacity_owner_prepared_helper_receipt_v1(prepared, fixture.request.intent,
            operation, grant, signed_prepare_clock_v1()).unwrap()
        assert(host_reservation_receipt_v1(fixture.request.intent, operation).is_err())
        assert(host_helper_reservation_match_receipt_v1(receipt, fixture.request.intent, operation).unwrap())
        val fence = HostLedgerFenceV1(authority_id: prepared.ledger.capacity.authority_id,
            boot_id: prepared.ledger.capacity.boot_id, provider_generation: prepared.ledger.capacity.provider_generation,
            revision: prepared.ledger.revision)
        grant.operations = ["host_execute_v1"]
        assert(host_capacity_owner_begin_v1(prepared, fixture.request.intent, operation, receipt,
            fence, grant, signed_prepare_clock_v1()).is_err())
        grant.operations = ["host_helper_execute_v1"]
        val executing = host_capacity_owner_begin_helper_v1(prepared, fixture.request.intent, operation,
            receipt, fence, grant, signed_prepare_clock_v1()).unwrap()
        assert(host_capacity_owner_expire_prepared_v1(executing, operation.id, 1000).is_err())
        expect(host_available_capacity_v1(executing.ledger).unwrap().memory_bytes).to_equal(3584)
        assert(host_capacity_owner_close_v1(executing).unwrap())
        val recovered = host_capacity_owner_open_v1(executing.journal.root, executing.ledger.capacity,
            "f".repeat(64), 50, true).unwrap()
        expect(recovered.journal.operations[operation.id].state).to_equal("outcome-unknown")
        expect(host_available_capacity_v1(recovered.ledger).unwrap().cpu_millis).to_equal(1000)
        assert(host_capacity_owner_close_v1(recovered).unwrap())
        dir_remove(fixture.owner.journal.root, true)

    it "expires an unconsumed helper preparation without accepting a normal reservation on the helper route":
        val fixture = signed_prepare_fixture_v1()
        expect(host_capacity_owner_prepare_helper_v1(fixture.owner, fixture.request.intent,
            fixture.request.operation, fixture.request.signed.grant, signed_prepare_clock_v1()).unwrap_err()).to_equal("reservation-operation-mismatch")
        var operation = fixture.request.operation
        operation.operation = "host_helper_reservation_v1"
        var grant = fixture.request.signed.grant
        grant.operations = ["host_helper_reservation_v1"]
        val prepared = host_capacity_owner_prepare_helper_v1(fixture.owner, fixture.request.intent,
            operation, grant, signed_prepare_clock_v1()).unwrap()
        val expired = host_capacity_owner_expire_prepared_v1(prepared, operation.id, 1000).unwrap()
        expect(expired.journal.operations[operation.id].state).to_equal("cancelled")
        expect(host_available_capacity_v1(expired.ledger).unwrap().cpu_millis).to_equal(2000)
        expect(host_available_capacity_v1(expired.ledger).unwrap().memory_bytes).to_equal(4096)
        assert(host_capacity_owner_close_v1(expired).unwrap())
        val reopened = host_capacity_owner_open_v1(expired.journal.root, expired.ledger.capacity,
            "f".repeat(64), 50, true).unwrap()
        expect(host_available_capacity_v1(reopened.ledger).unwrap().cpu_millis).to_equal(2000)
        assert(host_capacity_owner_close_v1(reopened).unwrap())
        dir_remove(fixture.owner.journal.root, true)

    it "reopens mixed normal and helper rows in one ledger and refuses zero-budget helper admission":
        val fixture = signed_prepare_fixture_v1()
        val parent = host_authorized_prepare_reply_v1(fixture.owner,
            host_prepare_request_encode_v1(fixture.request).unwrap(), fixture.snapshot, 7,
            signed_prepare_clock_v1(), signed_prepare_clock_v1()).unwrap()
        var helper_intent = fixture.request.intent
        helper_intent.fence.revision = parent.owner.ledger.revision
        helper_intent.reservation.id = "helper-reservation"
        helper_intent.reservation.operation_id = "helper-operation"
        helper_intent.reservation.nonce = "helper-nonce"
        helper_intent.reservation.cpu_millis = 0
        helper_intent = host_reservation_bind_intent_v1(helper_intent).unwrap()
        var operation = fixture.request.operation
        operation.id = "helper-operation"
        operation.operation = "host_helper_reservation_v1"
        operation.payload_digest = helper_intent.reservation.payload_digest
        var grant = fixture.request.signed.grant
        grant.operations = ["host_helper_reservation_v1"]
        expect(host_capacity_owner_prepare_helper_v1(parent.owner, helper_intent, operation,
            grant, signed_prepare_clock_v1()).unwrap_err()).to_equal("helper-resource-budget-required")
        helper_intent.reservation.cpu_millis = 500
        helper_intent.reservation.memory_bytes = 0
        helper_intent = host_reservation_bind_intent_v1(helper_intent).unwrap()
        operation.memory_bytes = 0
        operation.payload_digest = helper_intent.reservation.payload_digest
        expect(host_capacity_owner_prepare_helper_v1(parent.owner, helper_intent, operation,
            grant, signed_prepare_clock_v1()).unwrap_err()).to_equal("helper-resource-budget-required")
        helper_intent.reservation.memory_bytes = 512
        operation.memory_bytes = 512
        helper_intent = host_reservation_bind_intent_v1(helper_intent).unwrap()
        operation.payload_digest = helper_intent.reservation.payload_digest
        val both = host_capacity_owner_prepare_helper_v1(parent.owner, helper_intent,
            operation, grant, signed_prepare_clock_v1()).unwrap()
        expect(both.journal.operations.len()).to_equal(2)
        expect(host_available_capacity_v1(both.ledger).unwrap().cpu_millis).to_equal(500)
        expect(host_available_capacity_v1(both.ledger).unwrap().memory_bytes).to_equal(3072)
        assert(host_capacity_owner_close_v1(both).unwrap())
        val reopened = host_capacity_owner_open_v1(both.journal.root, both.ledger.capacity,
            "f".repeat(64), 50, true).unwrap()
        expect(reopened.ledger.reservations.len()).to_equal(2)
        expect(host_available_capacity_v1(reopened.ledger).unwrap().cpu_millis).to_equal(500)
        assert(host_capacity_owner_prepared_receipt_v1(reopened, fixture.request.intent,
            fixture.request.operation, fixture.request.signed.grant, signed_prepare_clock_v1()).is_ok())
        assert(host_capacity_owner_prepared_helper_receipt_v1(reopened, helper_intent,
            operation, grant, signed_prepare_clock_v1()).is_ok())
        val expired = host_capacity_owner_expire_prepared_v1(reopened, operation.id, 1000).unwrap()
        expect(expired.journal.operations[fixture.request.operation.id].state).to_equal("admitted")
        expect(host_available_capacity_v1(expired.ledger).unwrap().cpu_millis).to_equal(1000)
        assert(host_capacity_owner_close_v1(expired).unwrap())
        dir_remove(fixture.owner.journal.root, true)
