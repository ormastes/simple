# @req CONTROLLER-WINDOWS-STORAGE-01
# Actual native protected-root fixture. NOT_RUN; missing fixtures fail, not skip.
use std.spec.{describe, it, expect, step, fail}
use std.nogc_sync_mut.orchestration.controller_dispatch_config_v3.*
use std.nogc_sync_mut.orchestration.controller_local_root_v3.*
use std.nogc_sync_mut.io.env_ops.{host_os, env_get}
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded
use std.common.crypto.sha256.sha256_text

fn controller_fixture_bytes_v3(name: text) -> text:
    val path = env_get(name) ?? ""
    assert(path != "")
    file_read_regular_no_follow_bounded(path, 1048576).unwrap()

fn controller_fixture_close_v3(owner: ControllerLocalRootV3):
    var pending = Some(owner)
    var steps = 0
    while pending.is_some() and steps < 8:
        val closed = controller_local_root_close_v3(pending.unwrap())
        pending = closed.owner
        # A native error is retained, never retried as an ordinary progress step.
        if closed.error != "": fail(closed.error)
        if closed.closed:
            assert(pending.is_none())
            return
        steps = steps + 1
    fail("controller fixture cleanup did not confirm native release")

describe "Protected Windows Controller root":
    it "installs immutable configuration, projects the real shared journal and invalidates a closed alias":
        step("Acquire the dedicated real private root and install canonical public configuration")
        expect(host_os()).to_equal("windows")
        val root = env_get("SIMPLE_WINDOWS_CONTROLLER_PRIVATE_ROOT") ?? ""
        assert(root != "")
        val config = controller_fixture_bytes_v3("SIMPLE_WINDOWS_CONTROLLER_CONFIG_FILE")
        val policy = controller_fixture_bytes_v3("SIMPLE_WINDOWS_CONTROLLER_POLICY_FILE")
        val expected = controller_dispatch_config_decode_v3(config).unwrap()
        val opened = controller_local_root_install_v3(root, config, policy)
        if not opened.ready or opened.owner.is_none():
            if opened.owner.is_some(): controller_fixture_close_v3(opened.owner.unwrap())
            fail(opened.error)
        val owner = opened.owner.unwrap()
        val context = owner.current_v3()
        val workload = owner.workload_v3()
        controller_fixture_close_v3(owner)
        expect(context.unwrap().config.controller_id).to_equal(expected.controller_id)
        expect(workload.unwrap().controller_id).to_equal(expected.controller_id)
        assert(workload.unwrap().journal.windows_store.is_some())
        assert(owner.current_v3().is_err())
        step("Reopen by the exact installed digest without replacing either record")
        val reopened = controller_local_root_open_v3(root, sha256_text(config))
        if not reopened.ready or reopened.owner.is_none():
            if reopened.owner.is_some(): controller_fixture_close_v3(reopened.owner.unwrap())
            fail(reopened.error)
        controller_fixture_close_v3(reopened.owner.unwrap())

    it "refuses a wrong installed digest while returning actual acquired cleanup":
        step("Open an existing native private fixture with a different public configuration pin")
        expect(host_os()).to_equal("windows")
        val root = env_get("SIMPLE_WINDOWS_CONTROLLER_PRIVATE_ROOT") ?? ""
        assert(root != "")
        val config = controller_fixture_bytes_v3("SIMPLE_WINDOWS_CONTROLLER_CONFIG_FILE")
        val wrong = if sha256_text(config) == "a".repeat(64): "b".repeat(64) else: "a".repeat(64)
        val opened = controller_local_root_open_v3(root, wrong)
        val retained = opened.owner.is_some()
        if retained: controller_fixture_close_v3(opened.owner.unwrap())
        assert(not opened.ready)
        expect(opened.error).to_equal("controller-local-config-pin")
        assert(retained)
