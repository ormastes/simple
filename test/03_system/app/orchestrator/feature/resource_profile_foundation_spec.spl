# ResourceProfile configuration and strict allocation proposals.
# @req CFG-01 CFG-02 ORCH-01
# Design: doc/05_design/orchestrator_resource_profile_foundation.md
# Runtime qualification: NOT_RUN until an admitted self-hosted runner exists.

use std.common.contracts.orchestration.profile_v1.*
use std.common.contracts.orchestration.resource_v1.{ObjectMetaV1, parse_cpu_millis, parse_memory_bytes, parse_resource_document, decode_resource_value, as_dict}
use std.io_runtime.{file_read}

fn profile_fixture() -> text:
    file_read("test/fixtures/orchestration/agent_cpu_profile.sdn") ?? ""

fn require_profile(source: text) -> ResourceProfileV1:
    match decode_resource_profile(source):
        case Ok(profile): return profile
        case Err(reason): fail("profile rejected: " + reason.path + ": " + reason.message)
    val empty_range = ResourceAmountRangeV1(minimum: 0, recommended: 0, preferred: 0, limit: 0)
    # Unreachable after fail; not a successful decoder fallback.
    ResourceProfileV1(meta: ObjectMetaV1(name: "", ns: "", labels: {}),
        cpu: empty_range, memory: empty_range, gpu_required: false, preserve_scarce_gpu_hosts: true)

fn require_proposal(profile: ResourceProfileV1, cpu: i64, memory: i64,
                    prefer: bool) -> ProfileAllocationProposalV1:
    match propose_profile_allocation(profile, cpu, memory, prefer):
        case Ok(proposal): return proposal
        case Err(reason): fail("proposal rejected: " + reason)
    ProfileAllocationProposalV1(cpu_millis: 0, memory_bytes: 0, cpu_cap_millis: 0,
        memory_cap_bytes: 0, below_recommendation: false, requires_gpu_resolution: false)

fn expect_profile_error(source: text, kind: text, path: text):
    match decode_resource_profile(source):
        case Ok(_): fail("invalid profile accepted")
        case Err(reason):
            expect(reason.kind).to_equal(kind)
            expect(reason.path).to_equal(path)

fn expect_proposal_error(profile: ResourceProfileV1, cpu: i64, memory: i64, reason: text):
    match propose_profile_allocation(profile, cpu, memory, false):
        case Ok(_): fail("infeasible proposal accepted")
        case Err(actual): expect(actual).to_equal(reason)

describe "ResourceProfile authoring and allocation proposals":
    it "decodes the CPU profile directly without unified resource loading":
        step("Read the CPU and memory configuration without authorizing execution")
        val profile = require_profile(profile_fixture())
        expect(profile.meta.name).to_equal("agent-cpu")
        expect(profile.meta.ns).to_equal("caret")
        expect(profile.cpu.minimum).to_equal(1000)
        expect(profile.cpu.recommended).to_equal(2000)
        expect(profile.cpu.preferred).to_equal(4000)
        expect(profile.memory.minimum).to_equal(2147483648)
        expect(profile.memory.limit).to_equal(8589934592)
        expect(profile.gpu_required).to_equal(false)
        expect(profile.preserve_scarce_gpu_hosts).to_equal(true)

    it "defaults recommend, prefer and limit from the preceding amount":
        step("Supply only the hard minimum for each resource")
        val source = "apiVersion: orchestration.simple/v1alpha1\nkind: ResourceProfile\nmetadata:\n    name: minimal\nspec:\n    cpu:\n        min: 1\n    memory:\n        min: 1024\n"
        val profile = require_profile(source)
        expect(profile.cpu.minimum).to_equal(1000)
        expect(profile.cpu.recommended).to_equal(1000)
        expect(profile.cpu.preferred).to_equal(1000)
        expect(profile.cpu.limit).to_equal(1000)
        expect(profile.memory.limit).to_equal(1024)
        expect(profile.gpu_required).to_equal(false)
        expect(profile.preserve_scarce_gpu_hosts).to_equal(true)

    it "rejects each inversion in the min-recommend-prefer-limit order":
        val source = profile_fixture()
        expect_profile_error(source.replace("recommend: \"2000m\"", "recommend: \"500m\""), "resource_order", "spec.cpu.recommend")
        expect_profile_error(source.replace("prefer: \"4000m\"", "prefer: \"1000m\""), "resource_order", "spec.cpu.prefer")
        expect_profile_error(source.replace("limit: \"4000m\"", "limit: \"2000m\""), "resource_order", "spec.cpu.limit")
        expect_profile_error(source.replace("limit: \"8Gi\"", "limit: \"4Gi\""), "resource_order", "spec.memory.limit")

    it "requires minima and rejects unknown resource fields":
        val source = profile_fixture()
        expect_profile_error(source.replace("        min: \"1000m\"\n", ""), "missing_field", "spec.cpu.min")
        expect_profile_error(source.replace("recommend: \"2000m\"", "recommended: \"2000m\""), "unknown_field", "spec.cpu.recommended")

    it "rejects invalid quantities and scaling overflow in profiles":
        val source = profile_fixture()
        for value in ["-1m", "1.5", "18446744073709551616m", "9223372036854776"]:
            expect_profile_error(source.replace("1000m", value), "quantity", "spec.cpu.min")
        for value in ["-1Gi", "unknown", "8589934592Gi", "18446744073709551616"]:
            expect_profile_error(source.replace("2Gi", value), "quantity", "spec.memory.min")

    it "keeps boolean policy strict and rejects unknown GPU sharing claims":
        val source = profile_fixture()
        expect_profile_error(source.replace("required: false", "required: \"false\""), "type", "spec.gpu.required")
        expect_profile_error(source.replace("required: false", "mode: shared"), "unknown_field", "spec.gpu.mode")
        expect_profile_error(source.replace("preserveScarceGpuHosts: true", "preserveScarceGpuHosts: 1"), "type", "spec.placement.preserveScarceGpuHosts")
        expect_profile_error(source.replace("preserveScarceGpuHosts: true", "preferGpu: true"), "unknown_field", "spec.placement.preferGpu")

    it "rejects another kind or API version at the profile entrypoint":
        val source = profile_fixture()
        expect_profile_error(source.replace("kind: ResourceProfile", "kind: Pod"), "unsupported_kind", "kind")
        expect_profile_error(source.replace("orchestration.simple/v1alpha1", "ci.simple/v1alpha1"), "unsupported_api_version", "apiVersion")

    it "selects recommendations before opportunistic preferences":
        step("Offer enough capacity for the full preference but select normal policy")
        val proposal = require_proposal(require_profile(profile_fixture()), 8000, 25769803776, false)
        expect(proposal.cpu_millis).to_equal(2000)
        expect(proposal.memory_bytes).to_equal(4294967296)
        expect(proposal.cpu_cap_millis).to_equal(proposal.cpu_millis)
        expect(proposal.memory_cap_bytes).to_equal(proposal.memory_bytes)
        expect(proposal.below_recommendation).to_equal(false)

    it "uses preferences only when explicitly allowed and caps at the selected amount":
        val profile = require_profile(profile_fixture())
        val proposal = require_proposal(profile, 8000, 25769803776, true)
        expect(proposal.cpu_millis).to_equal(4000)
        expect(proposal.memory_bytes).to_equal(8589934592)
        expect(proposal.cpu_cap_millis).to_equal(4000)
        expect(proposal.memory_cap_bytes).to_equal(8589934592)
        val partial = require_proposal(profile, 3000, 6442450944, true)
        expect(partial.cpu_millis).to_equal(3000)
        expect(partial.memory_bytes).to_equal(6442450944)

    it "never silently reduces a new allocation below either minimum":
        val profile = require_profile(profile_fixture())
        expect_proposal_error(profile, 999, 8589934592, "insufficient-cpu-minimum")
        expect_proposal_error(profile, 4000, 2147483647, "insufficient-memory-minimum")
        val constrained = require_proposal(profile, 1500, 3221225472, false)
        expect(constrained.cpu_millis).to_equal(1500)
        expect(constrained.memory_bytes).to_equal(3221225472)
        expect(constrained.cpu_cap_millis).to_equal(1500)
        expect(constrained.memory_cap_bytes).to_equal(3221225472)
        expect(constrained.below_recommendation).to_equal(true)

    it "accepts exactly the minima and refuses negative available capacity":
        val profile = require_profile(profile_fixture())
        val proposal = require_proposal(profile, 1000, 2147483648, false)
        expect(proposal.cpu_millis).to_equal(1000)
        expect(proposal.memory_bytes).to_equal(2147483648)
        expect_proposal_error(profile, -1, 2147483648, "invalid-available-capacity")
        expect_proposal_error(profile, 1000, -1, "invalid-available-capacity")

    it "does not treat a declared limit as spare reserved capacity":
        val cpu_ceiling = profile_fixture().replace("limit: \"4000m\"", "limit: \"16000m\"")
        val source = cpu_ceiling.replace("limit: \"8Gi\"", "limit: \"32Gi\"")
        val proposal = require_proposal(require_profile(source), 16000, 34359738368, false)
        expect(proposal.cpu_millis).to_equal(2000)
        expect(proposal.cpu_cap_millis).to_equal(2000)
        expect(proposal.memory_bytes).to_equal(4294967296)
        expect(proposal.memory_cap_bytes).to_equal(4294967296)

    it "retains required GPU intent as unresolved rather than inventing a grant":
        val profile = require_profile(profile_fixture().replace("required: false", "required: true"))
        val proposal = require_proposal(profile, 8000, 25769803776, false)
        expect(proposal.requires_gpu_resolution).to_equal(true)
        val cpu_only = require_proposal(require_profile(profile_fixture()), 8000, 25769803776, false)
        expect(cpu_only.requires_gpu_resolution).to_equal(false)

    it "validates directly constructed ranges before proposing capacity":
        var profile = require_profile(profile_fixture())
        profile.cpu = ResourceAmountRangeV1(minimum: 2000, recommended: 1000, preferred: 4000, limit: 4000)
        expect_proposal_error(profile, 8000, 25769803776, "invalid-resource-range")
        profile.cpu = ResourceAmountRangeV1(minimum: -1, recommended: 0, preferred: 0, limit: 0)
        expect_proposal_error(profile, 8000, 25769803776, "invalid-resource-range")

    it "checks integer boundaries before CPU scaling or decimal accumulation":
        expect(parse_cpu_millis("9223372036854775807m")).to_equal(9223372036854775807)
        expect(parse_cpu_millis("9223372036854775808m")).to_equal(-1)
        expect(parse_cpu_millis("18446744073709551616m")).to_equal(-1)
        expect(parse_cpu_millis("9223372036854775")).to_equal(9223372036854775000)
        expect(parse_cpu_millis("9223372036854776")).to_equal(-1)
        expect(parse_cpu_millis("0")).to_equal(0)

    it "checks byte and binary and decimal memory scaling boundaries":
        expect(parse_memory_bytes("9223372036854775807")).to_equal(9223372036854775807)
        expect(parse_memory_bytes("9223372036854775808")).to_equal(-1)
        expect(parse_memory_bytes("18446744073709551616")).to_equal(-1)
        expect(parse_memory_bytes("9007199254740991Ki")).to_equal(9223372036854774784)
        expect(parse_memory_bytes("9007199254740992Ki")).to_equal(-1)
        expect(parse_memory_bytes("8589934591Gi")).to_equal(9223372035781033984)
        expect(parse_memory_bytes("8589934592Gi")).to_equal(-1)
        expect(parse_memory_bytes("9223372036G")).to_equal(9223372036000000000)
        expect(parse_memory_bytes("9223372037G")).to_equal(-1)

    it "rejects duplicate SDN keys before any profile value is decoded":
        val duplicate = profile_fixture().replace("        min: \"1000m\"", "        min: \"1000m\"\n        min: \"2000m\"")
        match decode_resource_profile(duplicate):
            case Ok(_): fail("duplicate resource amount accepted")
            case Err(reason):
                expect(reason.kind).to_equal("duplicate_key")
                expect(reason.path).to_equal("spec.cpu.min")
                expect(reason.line).to_be_greater_than(0)
                expect(reason.col).to_be_greater_than(0)

    it "rejects directly constructed memory order and ceiling violations":
        var profile = require_profile(profile_fixture())
        profile.memory = ResourceAmountRangeV1(minimum: 1, recommended: 2, preferred: 3, limit: 2)
        expect_proposal_error(profile, 8000, 25769803776, "invalid-resource-range")
        profile.memory = ResourceAmountRangeV1(minimum: 1, recommended: 3, preferred: 2, limit: 4)
        expect_proposal_error(profile, 8000, 25769803776, "invalid-resource-range")

    it "retains nested Deployment selector mismatch paths and source coordinates":
        val original = file_read("test/fixtures/orchestration/echo_deployment.sdn") ?? ""
        val changed = original.replace("matchLabels:\n            app: echo-linux", "matchLabels:\n            app: other")
        var wrapped = "child:\n"
        for line in changed.trim().split("\n"):
            wrapped = wrapped + "    " + line + "\n"
        val parsed = parse_resource_document(wrapped).unwrap()
        val root = as_dict(parsed.0, "", parsed.1).unwrap()
        match decode_resource_value(root["child"], parsed.1, "child."):
            case Ok(_): fail("mismatched nested selector accepted")
            case Err(reason):
                expect(reason.kind).to_equal("selector_template_mismatch")
                expect(reason.path).to_equal("child.spec.template.metadata.labels")
                expect(reason.line).to_be_greater_than(0)
                expect(reason.col).to_be_greater_than(0)
