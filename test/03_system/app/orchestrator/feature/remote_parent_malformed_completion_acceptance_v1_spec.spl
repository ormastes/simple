"""
Released parent malformed remote completion acceptance.

AUTHORED_NOT_RUN. Actual parent files/WAL; synthetic signed remote
observations. Partial AT-RUN-02 parent-admission coverage only: not live
provider, installed authority, remote test execution, reset or native-reap
qualification.
"""
# doc-path: doc/06_spec/03_system/app/orchestrator/feature/remote_parent_malformed_completion_acceptance_v1_spec.md
# Lifecycle: doc/01_research/os/container/simple_orchestrator_and_container_2026-09-06.md
# @manual_section: remote-parent-admission
use std.spec.{describe, it, expect, step, after_each, fail}
use app.buildrunner.remote_container_session_v2.RemoteContainerDatabaseSessionV2
use app.buildrunner.remote_container_bundle_codec_v2.remote_container_bundle_encode_v2
use app.buildrunner.remote_container_authority_v2.remote_container_completion_encode_v2
use std.common.task_runner.distributed_operation_journal_v2.{distributed_operation_journal_lookup_v2,
    distributed_operation_journal_close_v2}
use std.common.task_runner.journal.{task_runner_journal_history_v2, task_runner_journal_release_v1}
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.io.file_ops.file_exists
use std.nogc_sync_mut.io.dir_ops.dir_remove_all
use app.io.file_ops.file_read_regular_no_follow_bounded_bytes
use test.fixtures.buildrunner.remote_container_parent_v2.{container_parent_fixture_v2, container_parent_open_v2}

# Published actual session custody and conclusive closes survive assertions.
# A stale/error result is never inferred to mean consumption.
# The released convenience setup has no partial-owner error carrier. If it
# fails before returning, setup_pending blocks all further effects/root removal;
# this fixture cannot recover an owner that the helper never returned.
var acceptance_remote_parent_session_v1: Option<RemoteContainerDatabaseSessionV2> = nil
var acceptance_remote_parent_task_closed_v1 = false
var acceptance_remote_parent_operation_closed_v1 = false
var acceptance_remote_parent_task_close_v1: Option<Result<bool, text>> = nil
var acceptance_remote_parent_operation_close_v1: Option<Result<bool, text>> = nil
var acceptance_remote_parent_cleanup_error_v1 = ""
var acceptance_remote_parent_root_v1 = ""
var acceptance_remote_parent_setup_pending_v1 = false

fn acceptance_remote_parent_close_v1() -> Result<bool, text>:
    # Result-only close has no replacement owner for an uncertain retry.
    if acceptance_remote_parent_cleanup_error_v1 != "":
        return Err(acceptance_remote_parent_cleanup_error_v1)
    if acceptance_remote_parent_session_v1.is_none(): return Ok(true)
    val session = acceptance_remote_parent_session_v1.unwrap()
    if acceptance_remote_parent_task_close_v1.is_none():
        val closed = task_runner_journal_release_v1(session.parent.database.journal)
        acceptance_remote_parent_task_close_v1 = Some(closed)
        if closed.is_ok() and closed.unwrap(): acceptance_remote_parent_task_closed_v1 = true
        else: acceptance_remote_parent_cleanup_error_v1 = "actual parent task journal cleanup unconfirmed"
    # This independent journal may be attempted once in the same cleanup turn.
    if acceptance_remote_parent_operation_close_v1.is_none():
        val closed = distributed_operation_journal_close_v2(session.parent.operations)
        acceptance_remote_parent_operation_close_v1 = Some(closed)
        if closed.is_ok() and closed.unwrap(): acceptance_remote_parent_operation_closed_v1 = true
        elif acceptance_remote_parent_cleanup_error_v1 == "":
            acceptance_remote_parent_cleanup_error_v1 = "actual parent operation journal cleanup unconfirmed"
    if acceptance_remote_parent_cleanup_error_v1 != "":
        return Err(acceptance_remote_parent_cleanup_error_v1)
    if not acceptance_remote_parent_task_closed_v1 or not acceptance_remote_parent_operation_closed_v1:
        acceptance_remote_parent_cleanup_error_v1 = "actual parent positive cleanup confirmation missing"
        return Err(acceptance_remote_parent_cleanup_error_v1)
    acceptance_remote_parent_session_v1 = nil
    Ok(true)

describe "Released parent malformed remote completion acceptance":
    after_each:
        if acceptance_remote_parent_setup_pending_v1:
            fail("actual setup did not return confirmed session custody; fixture root must remain retained")
            return
        val closed = acceptance_remote_parent_close_v1()
        if closed.is_err():
            fail("actual parent cleanup remains retained; fixture root must not be removed")
            return
        if acceptance_remote_parent_root_v1 != "":
            val removed = dir_remove_all(acceptance_remote_parent_root_v1)
            if not removed:
                fail("actual parent fixture root cleanup unconfirmed")
                return
            acceptance_remote_parent_root_v1 = ""

    it "should preserve the durable operation after truncated completion and accept one exact retry":
        # @req AT-RUN-02
        step("Open actual parent journals")
        if (acceptance_remote_parent_session_v1.is_some() or acceptance_remote_parent_root_v1 != "" or
                acceptance_remote_parent_setup_pending_v1 or acceptance_remote_parent_cleanup_error_v1 != ""):
            fail("prior actual parent fixture cleanup remains retained")
            return
        val fixture = container_parent_fixture_v2()
        acceptance_remote_parent_root_v1 = fixture.root
        acceptance_remote_parent_setup_pending_v1 = true
        var session = container_parent_open_v2(fixture)
        acceptance_remote_parent_session_v1 = Some(session)
        acceptance_remote_parent_setup_pending_v1 = false
        # Reset attempt records only after a newly returned actual owner.
        acceptance_remote_parent_task_close_v1 = nil
        acceptance_remote_parent_operation_close_v1 = nil
        acceptance_remote_parent_task_closed_v1 = false
        acceptance_remote_parent_operation_closed_v1 = false
        val identity = session.parent.journal_identities[fixture.task.id]
        val before = distributed_operation_journal_lookup_v2(session.parent.operations, fixture.policy.operation_id).unwrap()
        val history = task_runner_journal_history_v2(session.parent.database.journal, identity).unwrap()
        expect(history.len()).to_equal(0)
        val wire = remote_container_bundle_encode_v2(fixture.bundle).unwrap()
        val truncated = wire.substring(0, wire.byte_len() - 1)
        val completion_digest = sha256_text(remote_container_completion_encode_v2(fixture.bundle.completion).unwrap())
        val expected_artifact = session.parent.database.window_root + "/accepted-" + completion_digest + "/artifact/program.bin"

        # @capture(action_trace): truncated-wire refusal code, unchanged task history and absent artifact path
        step("Reject truncated wire before publication")
        val rejected = session.accept_wire(fixture.task, truncated, fixture.authority)
        acceptance_remote_parent_session_v1 = Some(session)
        if rejected.is_ok():
            fail("malformed completion was accepted by the actual parent")
            return
        expect(rejected.unwrap_err()).to_equal("REMOTE_CONTAINER_BUNDLE_WIRE_INVALID")
        expect(file_exists(expected_artifact)).to_equal(false)
        expect(task_runner_journal_history_v2(session.parent.database.journal, identity).unwrap()).to_equal(history)
        val closed = acceptance_remote_parent_close_v1()
        if closed.is_err():
            fail("actual parent cleanup remains retained before reopen")
            return

        step("Close/reopen and compare exact retained bindings/history/absence")
        acceptance_remote_parent_setup_pending_v1 = true
        session = container_parent_open_v2(fixture)
        acceptance_remote_parent_session_v1 = Some(session)
        acceptance_remote_parent_setup_pending_v1 = false
        # Prior helper returned only after complete positive cleanup.
        acceptance_remote_parent_task_close_v1 = nil
        acceptance_remote_parent_operation_close_v1 = nil
        acceptance_remote_parent_task_closed_v1 = false
        acceptance_remote_parent_operation_closed_v1 = false
        val reopened = distributed_operation_journal_lookup_v2(session.parent.operations, fixture.policy.operation_id).unwrap()
        expect(reopened.operation_id).to_equal(before.operation_id)
        expect(reopened.envelope_digest).to_equal(before.envelope_digest)
        expect(reopened.envelope).to_equal(before.envelope)
        expect(reopened.state).to_equal(before.state)
        expect(reopened.outcome_digest).to_equal(before.outcome_digest)
        expect(task_runner_journal_history_v2(session.parent.database.journal, identity).unwrap()).to_equal(history)
        expect(file_exists(expected_artifact)).to_equal(false)
        val reopened_artifact = session.parent.database.window_root + "/accepted-" + completion_digest + "/artifact/program.bin"
        expect(file_exists(reopened_artifact)).to_equal(false)

        # @capture(action_trace): accepted artifact bytes, one history row and the replay refusal code
        step("Accept original fixture once")
        val accepted = session.accept_wire(fixture.task, wire, fixture.authority)
        acceptance_remote_parent_session_v1 = Some(session)
        if accepted.is_err():
            fail("the original complete fixture was rejected after malformed input")
            return
        val actual_artifact = accepted.unwrap().outputs_root + "/artifact/program.bin"
        expect(actual_artifact).to_equal(reopened_artifact)
        expect(file_read_regular_no_follow_bounded_bytes(actual_artifact, 1024).unwrap()).to_equal(
            fixture.bundle.evidence.outputs[0].content)
        expect(task_runner_journal_history_v2(session.parent.database.journal, identity).unwrap().len()).to_equal(1)
        val replay = session.accept_wire(fixture.task, wire, fixture.authority)
        acceptance_remote_parent_session_v1 = Some(session)
        if replay.is_ok():
            fail("the actual parent accepted a duplicate completion")
            return
        expect(replay.unwrap_err()).to_equal("REMOTE_COMPLETION_REPLAY")
        expect(task_runner_journal_history_v2(session.parent.database.journal, identity).unwrap().len()).to_equal(1)

        step("Close exact owners")
        val final_close = acceptance_remote_parent_close_v1()
        expect(final_close.is_ok()).to_equal(true)
        expect(acceptance_remote_parent_session_v1.is_none()).to_equal(true)
