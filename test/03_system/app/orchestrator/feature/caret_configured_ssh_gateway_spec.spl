# AUTHORED_NOT_RUN. The fixture must name a real pinned SSH gateway.
use std.spec.{describe, it, expect, step, fail, pending}
use std.sosix.time.{sosix_time_now_monotonic_ms, sosix_sleep_ms}
use app.llm_caret.cs_orchestrator_v1.{cs_orchestrator_dispatch_v1, cs_orchestrator_remote_close_v1}
use app.orchestrator.controller_gateway_v1.{controller_gateway_request_decode_v1, controller_gateway_response_v1}
use test.fixtures.orchestration.host_acceptance_config_v1.host_acceptance_config_text_v1
use std.nogc_sync_mut.io.file_ops.file_read_regular_no_follow_bounded

describe "Caret configured SSH gateway":
    it "uses the Caret remote action to inspect the exact retained controller request":
        val config = host_acceptance_config_text_v1("caretSshConfig")
        val context = host_acceptance_config_text_v1("caretSshContext")
        val server = host_acceptance_config_text_v1("caretSshServer")
        val profile = host_acceptance_config_text_v1("caretSshProfile")
        val packet = host_acceptance_config_text_v1("caretSshRequest")
        if [config, context, server, profile, packet].contains("") or [config, context, server].contains("-"):
            pending("BLOCKED: explicit enrolled Caret SSH fixture required")
            return
        step("Require the configured fixture to be an exact read-only controller inspection")
        val read = file_read_regular_no_follow_bounded(packet, 2097152)
        if read.is_err():
            fail("protected Caret SSH inspection request unavailable")
            return
        val source = read.unwrap()
        val request = controller_gateway_request_decode_v1(source)
        if request.is_err() or request.unwrap().action != "inspect":
            fail("Caret SSH fixture must identify one retained intent without mutation")
            return
        step("Dispatch the normal Caret remote action using the named context and pinned identity profile")
        var response = cs_orchestrator_dispatch_v1("ssh-acceptance",
            ["remote", config, context, server, profile, packet])
        val started = sosix_time_now_monotonic_ms()
        var polls = 0
        while response == "orchestrator remote request is pending" and started >= 0 and polls < 3500:
            val now = sosix_time_now_monotonic_ms()
            if now < started or now - started >= 35000: break
            sosix_sleep_ms(10)
            response = cs_orchestrator_dispatch_v1("ssh-acceptance", ["remote-progress"])
            polls = polls + 1
        val cleanup = cs_orchestrator_remote_close_v1("ssh-acceptance")
        if cleanup != "":
            fail(cleanup)
            return
        step("Validate the correlated remote receipt for the original controller and UID")
        val validated = controller_gateway_response_v1(source, response)
        if validated.is_err():
            fail("configured Caret SSH route did not return a matching retained intent receipt")
            return
        expect(validated.unwrap()).to_contain("executionAuthorized: false")
        expect(validated.unwrap()).to_contain(request.unwrap().request_uid)
