# @req ORCH-02 HOST-02
# Actual configured API owners only; no fake provider or missing-runtime skip.
# Native lifecycle/nonces remain each platform owner's separate acceptance gate.
use test.fixtures.orchestrator_acceptance.simple_container_api_v2.*

describe "one actual Simple Container API for platform owners":
    it "refuses unsupported backend before reading provider policy or opening state":
        step("Reject an unknown backend at the portable dispatch boundary")
        simple_container_api_unsupported_checks_v2()

    it "preserves real Linux Podman owner on rejected action route and scope":
        step("Open actual configured Linux owner and exercise public API route guards")
        simple_container_configured_route_checks_v2("linux-podman", "build/simple-container-api/linux-case.sdn")

    it "preserves real Windows Docker process owner on rejected action route and scope":
        step("Open actual configured Windows owner without fabricating boot authority")
        simple_container_configured_route_checks_v2("windows-docker-process", "build/simple-container-api/windows-case.sdn")
