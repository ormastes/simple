# @req ORCH-02 HOST-02
# Actual public dispatcher refusal paths; no filesystem/provider fixture.
# Runtime NOT_RUN. Requires the actual Host installation command dependency.
use app.orchestrator.command.orchestrator_command_v1

describe "public signed exec control installation routing":
    it "routes missing installation arguments to the actual host domain before opening owners":
        step("routes missing installation arguments to the actual host domain before opening owners")
        val reply = orchestrator_command_v1(["host-exec-control-install"])
        expect(reply.exit_code).to_equal(1)
        expect(reply.output).to_contain("host-local-error")
        expect(reply.output).to_contain("host-local-argument-count")
        expect(reply.output).to_contain("host-exec-control-install")
        expect(reply.journal_cleanup == nil and reply.host_journal_cleanup == nil).to_equal(true)

    it "rejects extra installation arguments before reading caller paths":
        step("rejects extra installation arguments before reading caller paths")
        val reply = orchestrator_command_v1(["host-exec-control-install", "/unused-root", "/unused-packet", "extra"])
        expect(reply.exit_code).to_equal(1)
        expect(reply.output).to_contain("host-local-error")
        expect(reply.output).to_contain("host-local-argument-count")
        expect(reply.journal_cleanup == nil and reply.host_journal_cleanup == nil).to_equal(true)
