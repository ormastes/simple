# Windows provider lifecycle fixtures: source-only, no Windows qualification.
# @req REQ-WDP-001 REQ-WDP-002 REQ-WDP-004 REQ-WDP-005 REQ-WDP-006
# Runtime qualification and SPipe/docgen: NOT_RUN.
use std.spec.*
use std.common.contracts.container.runtime_v1.{RuntimeIntentV1, RuntimeProviderV1}
use std.nogc_async_mut.container.providers.windows.docker_contract_v1.*
use std.nogc_async_mut.container.providers.windows.docker_runtime_v1.WindowsDockerRuntimeProviderV1

fn runtime_policy() -> WindowsDockerPolicyV1:
    WindowsDockerPolicyV1(docker_executable: "C:\\Program Files\\Docker\\docker.exe",
        endpoint: "npipe:////./pipe/docker_engine", engine_id: "engine-a",
        node_boot_id: "boot-a", provider_generation: 4,
        expected_kernel_version: "10.0 20348 (20348.2402.amd64fre)",
        image_os_version: "10.0.20348.2402",
        expected_image_id: "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        timeout_ms: 5000, max_output_bytes: 8192,
        system_root: "C:\\Windows", temp_directory: "C:\\Temp")

fn runtime_request() -> WindowsDockerRequestV1:
    WindowsDockerRequestV1(pod_uid: "workload-a", attempt: 2, operation_id: "operation-a",
        image: "mcr.microsoft.com/windows/servercore@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        command: ["C:\\work\\fixture.exe", "--exit"], args: ["17"],
        cpu_count: 2, memory_limit_bytes: 536870912, network: "none")

fn runtime_id() -> text: "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"

fn response(operation: text, args: [text], output: text,
        code: i64 = 0, limited: bool = false) -> WindowsDockerScriptedResultV1:
    val policy = runtime_policy()
    WindowsDockerScriptedResultV1(operation: operation, program: policy.docker_executable,
        args: ["--host", policy.endpoint] + args, stdout: output, stderr: "",
        exit_code: code, limit_exceeded: limited)

fn engine_response() -> WindowsDockerScriptedResultV1:
    val policy = runtime_policy()
    response("engine-info", ["info", "--format", WINDOWS_DOCKER_INFO_FORMAT_V1],
        "windows|" + policy.engine_id + "|" + policy.expected_kernel_version + "\n")

fn image_response() -> WindowsDockerScriptedResultV1:
    val policy = runtime_policy()
    val request = runtime_request()
    response("image-inspect", ["image", "inspect", "--format", WINDOWS_DOCKER_IMAGE_FORMAT_V1, request.image],
        "windows|" + policy.expected_image_id + "|" + policy.image_os_version + "\n" + request.image + "\n")

fn observation(phase: text, exit_code: i64 = 0) -> text:
    val policy = runtime_policy()
    val request = runtime_request()
    val digest = windows_docker_request_digest_v1(policy, request).unwrap()
    runtime_id() + "|" + policy.expected_image_id + "|" + request.image +
        "|process|ContainerUser|none|2|536870912|windows-docker-process-v1|workload-a|2|operation-a|boot-a|4|" +
        digest + "|" + phase + "|" + exit_code.to_text() + "\n"

fn inspect_response(phase: text, exit_code: i64 = 0) -> WindowsDockerScriptedResultV1:
    response("inspect", ["container", "inspect", "--format", WINDOWS_DOCKER_INSPECT_FORMAT_V1, runtime_id()],
        observation(phase, exit_code))

fn create_response(code: i64 = 0, limited: bool = false) -> WindowsDockerScriptedResultV1:
    val command = windows_docker_create_command_v1(runtime_policy(), runtime_request()).unwrap()
    WindowsDockerScriptedResultV1(operation: "create", program: command.program,
        args: command.args, stdout: if code == 0: runtime_id() + "\n" else: "",
        stderr: "", exit_code: code, limit_exceeded: limited)

fn creation_script() -> [WindowsDockerScriptedResultV1]:
    [engine_response(), image_response(), engine_response(), image_response(),
        create_response(), engine_response(), inspect_response("created")]

fn retained_intent() -> RuntimeIntentV1:
    RuntimeIntentV1(pod_uid: "workload-a", attempt: 2, provider_generation: 4,
        operation_id: "operation-a", engine: "windows-docker-process-v1", native_id: runtime_id(),
        node_boot_id: "boot-a", phase: "created")

describe "Windows Docker engine admission":
    it "keeps a scripted healthy engine separate from live launch qualification":
        step("Observe the scripted engine and retain an unavailable launch capability")
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [engine_response()])
        val probe = provider.probe()
        expect(probe.healthy).to_equal(true)
        expect(probe.launch_capable).to_equal(false)
        expect(probe.reason).to_equal("scripted-contract-only-not-live-qualified")

    it "rejects Linux engines or replacement engine identities before image access":
        for output in ["linux|engine-a|10.0 20348 (20348.2402.amd64fre)",
                "windows|engine-b|10.0 20348 (20348.2402.amd64fre)"]:
            var engine = engine_response()
            engine.stdout = output
            var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [engine])
            val prepared = provider.prepare_pod(runtime_request())
            expect(prepared.status).to_equal("blocked")
            expect(prepared.reason).to_equal("docker-live-engine-identity-mismatch")
            expect(provider.retained_record_count()).to_equal(0)
            expect(provider.consumed_script_count()).to_equal(1)

    it "rejects Linux image metadata and missing exact repository digest":
        for output in ["linux|sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa|10.0.20348.2402\nimage@sha256:bbbb",
                "windows|sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa|10.0.20348.2402\nother@sha256:bbbb"]:
            var image = image_response()
            image.stdout = output
            var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [engine_response(), image])
            expect(provider.prepare_pod(runtime_request()).status).to_equal("blocked")
            expect(provider.retained_record_count()).to_equal(0)
            expect(provider.consumed_script_count()).to_equal(2)

    it "fails an unmatched or exhausted script without inventing execution success":
        var exhausted = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [])
        expect(exhausted.prepare_pod(runtime_request()).reason).to_equal("docker-script-exhausted")
        var wrong = engine_response()
        wrong.args = ["--version"]
        var mismatched = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [wrong])
        expect(mismatched.prepare_pod(runtime_request()).reason).to_equal("docker-script-command-mismatch")
        expect(mismatched.consumed_script_count()).to_equal(0)

describe "Windows Docker exact lifecycle":
    it "creates, starts and retains a chosen nonzero workload exit":
        step("Prepare the immutable request and retain the caller-owned durable intent")
        val request = runtime_request()
        val script = creation_script() + [engine_response(), inspect_response("created"),
            response("start", ["start", runtime_id()], runtime_id() + "\n"), engine_response(), inspect_response("running"),
            engine_response(), inspect_response("running"), response("wait", ["wait", runtime_id()], "17\n"),
            engine_response(), inspect_response("exited", 17)]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.prepare_pod(request).state.phase).to_equal("prepared")
        expect(provider.intent(request).unwrap().native_id).to_equal("")
        step("Create with process isolation and accept only the full inspected native ID")
        val created = provider.create(request)
        expect(created.status).to_equal("ok")
        expect(created.state.identity.native_id).to_equal(runtime_id())
        expect(provider.intent(request).unwrap().native_id).to_equal(runtime_id())
        expect(provider.start(request).state.phase).to_equal("running")
        step("Read the exact workload exit rather than the Docker CLI success code")
        val completed = provider.wait(request)
        expect(completed.status).to_equal("ok")
        expect(completed.state.phase).to_equal("exited")
        expect(completed.exit_code).to_equal(17)
        expect(provider.consumed_script_count()).to_equal(script.len())

    it "accepts an already exited short-lived process after a confirmed start":
        val script = creation_script() + [engine_response(), inspect_response("created"),
            response("start", ["start", runtime_id()], runtime_id()), engine_response(), inspect_response("exited", 17)]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.prepare_pod(runtime_request()).status).to_equal("ok")
        expect(provider.create(runtime_request()).status).to_equal("ok")
        val started = provider.start(runtime_request())
        expect(started.status).to_equal("ok")
        expect(started.state.phase).to_equal("exited")
        expect(started.exit_code).to_equal(17)

    it "retains ambiguous create and refuses a second native create":
        step("Lose the create response and keep the attempt unavailable for retry")
        val script = [engine_response(), image_response(), engine_response(), image_response(), create_response(-1, true)]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.prepare_pod(runtime_request()).status).to_equal("ok")
        val failed = provider.create(runtime_request())
        expect(failed.status).to_equal("blocked")
        expect(failed.state.phase).to_equal("prepared")
        expect(failed.reason).to_start_with("docker-create-ambiguous-exact-id-recovery-required:")
        expect(provider.create(runtime_request()).reason).to_equal("docker-create-reserved-no-retry-use-exact-id-recovery")
        expect(provider.consumed_script_count()).to_equal(5)
        expect(provider.intent(runtime_request()).unwrap().native_id).to_equal("")

    it "refuses Hyper-V or changed ownership after create without name cleanup":
        for replacement in ["|hyperv|", "|hostprocess|"]:
            var inspected = inspect_response("created")
            inspected.stdout = observation("created").replace("|process|", replacement)
            val script = [engine_response(), image_response(), engine_response(), image_response(),
                create_response(), engine_response(), inspected]
            var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
            expect(provider.prepare_pod(runtime_request()).status).to_equal("ok")
            val rejected = provider.create(runtime_request())
            expect(rejected.status).to_equal("blocked")
            expect(rejected.reason).to_equal("docker-inspect-ownership-or-isolation-mismatch")
            expect(rejected.state.phase).to_equal("prepared")
            expect(provider.intent(runtime_request()).unwrap().native_id).to_equal(runtime_id())
            expect(provider.intent(runtime_request()).unwrap().phase).to_equal("unknown")
            expect(provider.consumed_script_count()).to_equal(7)

    it "blocks a mutation when the daemon changes after native creation":
        var changed_engine = engine_response()
        changed_engine.stdout = "windows|replacement|10.0 20348 (20348.2402.amd64fre)"
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), creation_script() + [changed_engine])
        expect(provider.prepare_pod(runtime_request()).status).to_equal("ok")
        expect(provider.create(runtime_request()).status).to_equal("ok")
        val blocked = provider.start(runtime_request())
        expect(blocked.status).to_equal("blocked")
        expect(blocked.state.phase).to_equal("created")
        expect(provider.consumed_script_count()).to_equal(8)

    it "binds operation identity separately from the immutable request digest":
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [engine_response(), image_response()])
        val original = runtime_request()
        expect(provider.prepare_pod(original).status).to_equal("ok")
        var replay = original
        replay.operation_id = "other-operation"
        expect(windows_docker_request_digest_v1(runtime_policy(), replay).unwrap()).to_equal(
            windows_docker_request_digest_v1(runtime_policy(), original).unwrap())
        expect(windows_docker_name_v1(runtime_policy(), replay)).to_equal(windows_docker_name_v1(runtime_policy(), original))
        expect(provider.create(replay).reason).to_equal("docker-request-binding-mismatch")
        expect(provider.consumed_script_count()).to_equal(2)

describe "Windows Docker recovery and exact cleanup":
    it "recovers only the retained full ID after live engine, image and ownership inspection":
        step("Reopen a provider with the original request and exact retained identity")
        val script = [engine_response(), image_response(), inspect_response("running")]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        val result = provider.recover(runtime_request(), retained_intent())
        expect(result.status).to_equal("ok")
        expect(result.state.phase).to_equal("running")
        expect(result.state.identity.native_id).to_equal(runtime_id())
        expect(provider.retained_record_count()).to_equal(1)
        expect(provider.consumed_script_count()).to_equal(3)

    it "rejects stale generations and partial identities without accessing Docker":
        for native_id in ["workload-a", "cccccccccccc", ""]:
            var intent = retained_intent()
            intent.native_id = native_id
            var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [])
            expect(provider.recover(runtime_request(), intent).reason).to_equal("docker-recovery-intent-mismatch")
            expect(provider.consumed_script_count()).to_equal(0)
        var stale = retained_intent()
        stale.provider_generation = 3
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [])
        expect(provider.recover(runtime_request(), stale).reason).to_equal("docker-recovery-intent-mismatch")

    it "rejects copied ownership labels from another operation or request":
        for token in ["|operation-a|", "|boot-a|", "|process|", "|ContainerUser|", "|none|"]:
            var inspected = inspect_response("running")
            inspected.stdout = observation("running").replace(token, "|forged|")
            var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), [engine_response(), image_response(), inspected])
            val result = provider.recover(runtime_request(), retained_intent())
            expect(result.status).to_equal("blocked")
            expect(result.reason).to_equal("docker-inspect-ownership-or-isolation-mismatch")
            expect(provider.retained_record_count()).to_equal(0)

    it "requires a successful empty exact-ID query before marking destroyed":
        step("Remove only the owned native ID and independently confirm its absence")
        val script = [engine_response(), image_response(), inspect_response("exited", 17),
            engine_response(), inspect_response("exited", 17), response("destroy", ["rm", runtime_id()], runtime_id() + "\n"),
            engine_response(), response("verify-absence", ["container", "ls", "--all", "--no-trunc", "--filter", "id=" + runtime_id(), "--format", "{{{{.ID}}}}"], "")]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.recover(runtime_request(), retained_intent()).status).to_equal("ok")
        val destroyed = provider.destroy(runtime_request())
        expect(destroyed.status).to_equal("ok")
        expect(destroyed.state.phase).to_equal("destroyed")
        expect(destroyed.state.identity.native_id).to_equal(runtime_id())
        expect(provider.consumed_script_count()).to_equal(8)

    it "does not treat a failed absence query as destruction":
        val script = [engine_response(), image_response(), inspect_response("exited", 17),
            engine_response(), inspect_response("exited", 17), response("destroy", ["rm", runtime_id()], runtime_id()),
            engine_response(), response("verify-absence", ["container", "ls", "--all", "--no-trunc", "--filter", "id=" + runtime_id(), "--format", "{{{{.ID}}}}"], "", 1)]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.recover(runtime_request(), retained_intent()).status).to_equal("ok")
        val failed = provider.destroy(runtime_request())
        expect(failed.status).to_equal("blocked")
        expect(failed.state.phase).to_equal("exited")
        expect(failed.reason).to_equal("docker-command-failed-1")

    it "does not stop or remove a running workload without the required force choice":
        val script = [engine_response(), image_response(), inspect_response("running"), engine_response(), inspect_response("running")]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.recover(runtime_request(), retained_intent()).status).to_equal("ok")
        expect(provider.destroy(runtime_request()).reason).to_equal("docker-destroy-running-requires-force")
        expect(provider.consumed_script_count()).to_equal(5)

    it "rejects truncated logs even when Docker itself exits zero":
        step("Keep output-limit failure separate from successful complete log capture")
        val script = [engine_response(), image_response(), inspect_response("exited", 17),
            engine_response(), inspect_response("exited", 17), response("logs", ["logs", "--tail", "1000", runtime_id()], "prefix", 0, true)]
        var provider = WindowsDockerRuntimeProviderV1.scripted(runtime_policy(), script)
        expect(provider.recover(runtime_request(), retained_intent()).status).to_equal("ok")
        val result = provider.logs(runtime_request())
        expect(result.status).to_equal("blocked")
        expect(result.stdout).to_equal("")
        expect(result.reason).to_equal("docker-execution-limit-exceeded")
