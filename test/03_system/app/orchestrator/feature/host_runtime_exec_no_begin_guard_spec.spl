# @req HOST-EXEC-NO-BEGIN-QUALIFY-01 HOST-EXEC-NO-BEGIN-QUALIFY-02
# NOT_RUN: actual producer/SDK/owned WAL/private files. Parent native operations
# are explicitly scripted Common Container fixtures, not live teardown evidence.
use std.spec.{describe, it, expect, step}
use test.fixtures.orchestration.host_runtime_exec_no_begin_cancel_fixture_v3.*
use test.fixtures.orchestration.host_runtime_exec_cleanup_guard_fixture_v3.child_guard_cleanup_fixture_v3
use test.fixtures.orchestration.host_owned_journal_fixture_v2.{host_owned_journal_closed_v2, host_owned_journal_ready_v2}
use std.nogc_sync_mut.orchestration.host_runtime_exec_cleanup_guard_v3.*
use std.nogc_sync_mut.orchestration.host_capacity_owner_v1.*
use std.nogc_sync_mut.orchestration.host_local_root_v1.HostLocalRootV1
use std.nogc_sync_mut.orchestration.host_cleanup_v1.{host_cleanup_v1, host_cleanup_settled_v1}
use std.common.contracts.orchestration.host_runtime_exec_no_begin_cancel_v3.*
use std.common.contracts.orchestration.host_capacity_v1.{HostReservationStateV1, host_available_capacity_v1}
use std.common.contracts.orchestration.host_reservation_codec_v1.*
use std.common.contracts.distributed_control_codec_v2.distributed_decode_operation_v2
use std.nogc_sync_mut.daemon_sdk.operation_dispatch_v2.{daemon_operation_admit_v2, daemon_operation_begin_v2, daemon_operation_record_outcome_v2}
use std.common.task_runner.distributed_operation_journal_v2.distributed_operation_journal_recover_execution_v2
use std.common.crypto.sha256.sha256_text
use std.nogc_sync_mut.sffi.fs.file_atomic_write_mode

fn no_begin_guard_receipt_path_v3(local: HostLocalRootV1, id: text) -> text:
    local.capacity.journal.root + "/host-runtime-exec-no-begin-cancellations/" + sha256_text(id) + ".sdn"

fn no_begin_guard_charged_v3(local: HostLocalRootV1):
    expect(host_available_capacity_v1(local.capacity.ledger).unwrap().memory_bytes).to_equal(0)
    expect(local.capacity.ledger.reservations[0].state).to_equal(HostReservationStateV1.Executing)

describe "Qualified no-BEGIN child barrier projection":
    it "omits only an actual cancelled child but still requires original parent native completion":
        step("omits only an actual cancelled child but still requires original parent native completion")
        val fixture = no_begin_cancel_fixture_v3()
        val turn = no_begin_cancel_run_v3(fixture)
        expect(turn.error).to_equal("")
        expect(turn.cancelled).to_equal(true)
        val parent = fixture.begin.packet.parent_binding.host_operation
        val sequence = turn.local.capacity.journal.sequence
        val barriers = host_runtime_exec_cleanup_index_v3(turn.local.capacity.journal, turn.local.capacity.ledger.capacity).unwrap()
        assert(not barriers.contains_key(parent.id))
        assert(host_runtime_exec_parent_cleanup_guard_v3(turn.local.capacity.journal, turn.local.capacity.ledger.capacity, parent).unwrap())
        val settled = host_capacity_owner_settle_v1(turn.local.capacity, parent)
        expect(settled.settled).to_equal(false)
        assert(settled.error != "")
        var current = turn.local
        current.capacity = settled.owner
        expect(current.capacity.journal.sequence).to_equal(sequence)
        no_begin_guard_charged_v3(current)
        no_begin_cancel_fixture_close_v3(fixture, current)

    it "keeps a live sibling and uncommitted published cancellation as independent barriers":
        step("keeps a live sibling and uncommitted published cancellation as independent barriers")
        val fixture = no_begin_cancel_fixture_v3()
        val pending = no_begin_cancel_pending_v3(fixture)
        val parent = fixture.begin.packet.parent_binding.host_operation
        expect(host_runtime_exec_cleanup_index_v3(pending.local.capacity.journal, pending.local.capacity.ledger.capacity).unwrap()[parent.id]).to_equal(fixture.begin.packet.operation.id)
        # The actual original producer can resume only its identical immutable
        # proof with fresh context; no receipt is constructed as a permission.
        var resumed_fixture = fixture
        resumed_fixture.begin.local = pending.local
        val cancelled = no_begin_cancel_run_v3(resumed_fixture)
        expect(cancelled.error).to_equal("")
        var current = no_begin_cancel_sibling_v3(fixture, cancelled.local)
        val sibling = distributed_decode_operation_v2(current.capacity.journal.operations["sibling-child"].envelope).unwrap()
        current.capacity.journal = daemon_operation_begin_v2(current.capacity.journal, sibling).unwrap()
        current.capacity.ledger.revision = current.capacity.journal.sequence + 1
        val barriers = host_runtime_exec_cleanup_index_v3(current.capacity.journal, current.capacity.ledger.capacity).unwrap()
        expect(barriers[parent.id]).to_equal("sibling-child")
        assert(host_runtime_exec_parent_cleanup_guard_v3(current.capacity.journal, current.capacity.ledger.capacity, parent).is_err())
        no_begin_guard_charged_v3(current)
        no_begin_cancel_fixture_close_v3(fixture, current)

    it "never discharges executing or unknown origins even with a real retained receipt and matching outcome":
        step("never discharges executing or unknown origins even with a real retained receipt and matching outcome")
        for state in ["executing", "outcome-unknown"]:
            val fixture = no_begin_cancel_fixture_v3()
            val pending = no_begin_cancel_pending_v3(fixture)
            var current = pending.local
            val child = fixture.begin.packet.operation
            # Intentional trusted-protocol violation through actual canonical
            # WAL APIs; public BEGIN interlock would reject this pending final.
            current.capacity.journal = daemon_operation_begin_v2(current.capacity.journal, child).unwrap()
            if state == "outcome-unknown":
                current.capacity.journal = distributed_operation_journal_recover_execution_v2(current.capacity.journal, child.id).unwrap()
            val digest = host_runtime_exec_no_begin_cancel_receipt_digest_v3(pending.receipt.unwrap()).unwrap()
            current.capacity.journal = daemon_operation_record_outcome_v2(current.capacity.journal, child, "cancelled", digest).unwrap()
            current.capacity.ledger.revision = current.capacity.journal.sequence + 1
            expect(host_runtime_exec_cleanup_index_v3(current.capacity.journal, current.capacity.ledger.capacity).unwrap_err()).to_equal("host-exec-no-begin-origin-not-admitted")
            no_begin_guard_charged_v3(current)
            no_begin_cancel_fixture_close_v3(fixture, current)

    it "fails closed on malformed foreign-prefix and expired-origin receipt evidence":
        step("fails closed on malformed foreign-prefix and expired-origin receipt evidence")
        for mode in ["malformed", "foreign-prefix", "expired-origin"]:
            val fixture = no_begin_cancel_fixture_v3()
            val pending = no_begin_cancel_pending_v3(fixture)
            var current = pending.local
            var receipt = pending.receipt.unwrap()
            if mode == "foreign-prefix": receipt.before_commit_digest = "f".repeat(64)
            elif mode == "expired-origin": receipt.authorized_unix_ms = receipt.approval.expires_at
            val bytes = if mode == "malformed": "broken receipt" else: host_runtime_exec_no_begin_cancel_receipt_encode_v3(receipt).unwrap()
            # Explicit protected-file corruption fault followed by a real WAL
            # matching outcome; this is never a positive receipt constructor.
            assert(file_atomic_write_mode(no_begin_guard_receipt_path_v3(current, fixture.begin.packet.operation.id), bytes, 0o600))
            current.capacity.journal = daemon_operation_record_outcome_v2(current.capacity.journal, fixture.begin.packet.operation, "cancelled", sha256_text(bytes)).unwrap()
            current.capacity.ledger.revision = current.capacity.journal.sequence + 1
            assert(host_runtime_exec_cleanup_index_v3(current.capacity.journal, current.capacity.ledger.capacity).is_err())
            no_begin_guard_charged_v3(current)
            no_begin_cancel_fixture_close_v3(fixture, current)

    it "keeps cancelled labels without optional receipt charged and permits no label-only bypass":
        step("keeps cancelled labels without optional receipt charged and permits no label-only bypass")
        val fixture = no_begin_cancel_fixture_v3()
        var current = fixture.begin.local
        current.capacity.journal = daemon_operation_record_outcome_v2(current.capacity.journal, fixture.begin.packet.operation, "cancelled", "f".repeat(64)).unwrap()
        current.capacity.ledger.revision = current.capacity.journal.sequence + 1
        val parent = fixture.begin.packet.parent_binding.host_operation
        expect(host_runtime_exec_cleanup_index_v3(current.capacity.journal, current.capacity.ledger.capacity).unwrap()[parent.id]).to_equal(fixture.begin.packet.operation.id)
        no_begin_guard_charged_v3(current)
        no_begin_cancel_fixture_close_v3(fixture, current)

    it "reopens exact parent completion with qualified child and preserves unrelated no-effect release":
        step("reopens exact parent completion with qualified child and preserves unrelated no-effect release")
        val fixture = no_begin_cancel_fixture_v3(Some(9223372036854775807))
        val cancelled = no_begin_cancel_run_v3(fixture)
        expect(cancelled.error).to_equal("")
        val cleanup = child_guard_cleanup_fixture_v3(cancelled.local)
        val context = cleanup.context
        val refresh = fn() -> HostReservationAuthorizationContextV1:
            context
        val cleaned = host_cleanup_v1(cleanup.local, fixture.begin.packet.parent_binding.host_operation.id,
            cleanup.signed, cleanup.approval, context, refresh)
        expect(cleaned.error).to_equal("")
        expect(cleaned.recovery_required).to_equal(false)
        assert(host_cleanup_settled_v1(cleaned.local, cleaned.receipt.unwrap()).unwrap())
        var current = cleaned.local
        # Actual disjoint admitted->cancelled reservation history, not arbitrary
        # Released flags. Its no-effect release remains independent of children.
        var intent = fixture.begin.packet.parent_binding.host_intent
        intent.fence.revision = current.capacity.ledger.revision
        intent.reservation.id = "unrelated-reservation"
        intent.reservation.operation_id = "unrelated-parent"
        intent.reservation.nonce = "unrelated-nonce"
        intent.reservation.cpu_millis = 1
        intent.reservation.memory_bytes = 1
        intent = host_reservation_bind_intent_v1(intent).unwrap()
        var operation = fixture.begin.packet.parent_binding.host_operation
        operation.id = intent.reservation.operation_id
        operation.payload_digest = intent.reservation.payload_digest
        operation.memory_bytes = 1
        assert(file_atomic_write_mode(current.capacity.journal.root + "/reservation-payloads/" + operation.payload_digest + ".sdn",
            host_reservation_encode_intent_v1(intent).unwrap(), 0o600))
        current.capacity.journal = daemon_operation_admit_v2(current.capacity.journal, operation).unwrap().journal
        current.capacity.journal = daemon_operation_record_outcome_v2(current.capacity.journal, operation, "cancelled", sha256_text(host_reservation_abort_outcome_v1(intent, operation).unwrap())).unwrap()
        current.capacity.ledger.revision = current.capacity.journal.sequence + 1
        val capacity = current.capacity.ledger.capacity
        host_owned_journal_closed_v2(current.capacity)
        current.capacity = host_owned_journal_ready_v2(host_capacity_owner_open_quarantined_owned_v2(current.capacity.journal.root, capacity, "e".repeat(64), 100))
        var parent_released = false
        var unrelated_released = false
        for row in current.capacity.ledger.reservations:
            if row.operation_id == fixture.begin.packet.parent_binding.host_operation.id: parent_released = row.state == HostReservationStateV1.Released
            if row.operation_id == operation.id: unrelated_released = row.state == HostReservationStateV1.Released
        assert(parent_released)
        assert(unrelated_released)
        expect(host_available_capacity_v1(current.capacity.ledger).unwrap().memory_bytes).to_equal(capacity.memory_bytes)
        assert(host_cleanup_settled_v1(current, cleaned.receipt.unwrap()).unwrap())
        no_begin_cancel_fixture_close_v3(fixture, current)
