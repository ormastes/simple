# REQ-MC-008 B2 additive interval/command boundary. Runtime UNRUN.
use std.spec.{describe, context, it, expect, step}
use compiler.semantics.symbol_id.semantic_link.{SemanticLinkFailureV1, SemanticLinkErrorV1}
use compiler.semantics.symbol_id.semantic_link_source.{SemanticLinkDeclarationV1, SemanticLinkDocumentV1, open_semantic_link_document_v1, resolve_semantic_link_source_v1, resolve_semantic_links_source_v1}
use compiler.semantics.symbol_id.semantic_link_location.{semantic_link_from_line_v1}
use compiler.semantics.symbol_id.stable_id.{SymbolComponents, stable_symbol_id, format_short_link}
use compiler.semantics.symbol_id.index.{build_symbol_index}
use app.cli.ast_link.{ast_link_command_v1}
use std.common.crypto.sha256.{sha256_text}
use std.nogc_sync_mut.io_runtime.{file_write, file_delete, getpid, time_now_unix_micros}
use std.env.platform.{get_temp_dir}

fn robust_06_semantic_docs_setup(source: text) -> text:
    val file = get_temp_dir() + "/ast-link-{getpid()}-{time_now_unix_micros()}.spl"
    expect(file_write(file, source)).to_equal(true)
    file

fn robust_06_semantic_docs_exercise(file: text, source: text, first: i64, last: i64) -> text:
    val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
    semantic_link_from_line_v1(document, sha256_text(source), first, last, false).unwrap()

fn robust_06_semantic_docs_assert_failure<T>(result: Result<T, SemanticLinkErrorV1>, expected: SemanticLinkFailureV1):
    match result:
        case Err(error): expect(error.failure).to_equal(expected)
        case Ok(_): panic("negative control unexpectedly resolved")

describe "revision-bound ast-link commands":
    context "parsed function spans":
        it "should select a declaration start and its enclosing body owner":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n\nfn two() -> i64:\n    2\n"
            val file = robust_06_semantic_docs_setup(source)
            step("Exercise the production boundary")
            val header = robust_06_semantic_docs_exercise(file, source, 4, 4)
            val body = robust_06_semantic_docs_exercise(file, source, 5, 5)
            step("Inspect the observed result")
            expect(header).to_equal(body)
            expect(header).to_start_with("spl:fn@sample.two~")
            step("Reject the negative control")
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            robust_06_semantic_docs_assert_failure(semantic_link_from_line_v1(document, sha256_text(source), 1, 5, false), SemanticLinkFailureV1.UnresolvedTarget)
            expect(file_delete(file)).to_equal(true)

        it "should exercise both CLI operations through the shared resolver":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val revision = sha256_text(source)
            step("Exercise the production boundary")
            val uri = ast_link_command_v1(["from-line", file + "#L2", "--package", "pkg", "--module", "sample", "--revision", revision]).unwrap()
            val location = ast_link_command_v1(["resolve", uri, "--file", file, "--package", "pkg", "--module", "sample", "--revision", revision]).unwrap()
            step("Inspect the observed result")
            expect(location).to_equal(file + ":1:1")
            step("Reject the negative control")
            robust_06_semantic_docs_assert_failure(ast_link_command_v1(["from-line", file + "#L0", "--package", "pkg", "--module", "sample", "--revision", revision]), SemanticLinkFailureV1.InvalidSpan)
            expect(file_delete(file)).to_equal(true)

        it "should refuse stale snapshots and out of range positions":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            step("Exercise the production boundary")
            robust_06_semantic_docs_assert_failure(semantic_link_from_line_v1(document, sha256_text(source), 99, 99, false), SemanticLinkFailureV1.InvalidSpan)
            step("Inspect the observed result")
            expect(file_write(file, source + "# changed\n")).to_equal(true)
            step("Reject the negative control")
            robust_06_semantic_docs_assert_failure(semantic_link_from_line_v1(document, sha256_text(source), 1, 1, false), SemanticLinkFailureV1.RevisionChanged)
            expect(file_delete(file)).to_equal(true)


        it "should reauthenticate source instead of trusting duplicated snapshot intervals":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, sha256_text(source)).unwrap()
            step("Exercise the production boundary")
            document.declarations.push(document.declarations[0])
            step("Inspect the observed result")
            expect(document.declarations.len()).to_equal(2)
            step("Reject the negative control")
            expect(semantic_link_from_line_v1(document, sha256_text(source), 1, 1, false).unwrap()).to_start_with("spl:fn@sample.one~")
            expect(file_delete(file)).to_equal(true)

        it "should resolve a bounded ordered batch and refuse any stale member":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val revision = sha256_text(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, revision).unwrap()
            val uri = semantic_link_from_line_v1(document, revision, 1, 1, false).unwrap()
            step("Exercise the production boundary")
            val declarations = resolve_semantic_links_source_v1([uri, uri], document, revision).unwrap()
            step("Inspect the observed result")
            expect(declarations.len()).to_equal(2)
            expect(declarations[0].full_id).to_equal(declarations[1].full_id)
            step("Reject the negative control")
            robust_06_semantic_docs_assert_failure(resolve_semantic_links_source_v1([uri, "spl:fn@sample.one~000000000000"], document, revision), SemanticLinkFailureV1.StaleFingerprint)
            expect(file_delete(file)).to_equal(true)


        it "should reject invented identities and restore actual spans from source":
            step("Prepare the production input")
            val source = "fn one() -> i64:\n    1\n"
            val file = robust_06_semantic_docs_setup(source)
            val revision = sha256_text(source)
            val document = open_semantic_link_document_v1("pkg", "sample", file, revision).unwrap()
            val real_uri = semantic_link_from_line_v1(document, revision, 1, 1, false).unwrap()
            val real = document.declarations[0]
            val invented = SymbolComponents(package: "pkg", module_path: "sample", item_kind: "fn", owner_id: "", name: "invented", signature: "fn invented() -> i64")
            val forged_id = stable_symbol_id(invented)
            step("Exercise the production boundary")
            document.declarations = [SemanticLinkDeclarationV1(symbol: invented, full_id: forged_id, file: file, start: 0, end: source.len(), line: 99, column: 99)]
            document.fingerprints = build_symbol_index([invented]).unwrap()
            document.by_name = {"invented": [0]}
            val observed = resolve_semantic_link_source_v1(real_uri, document, revision).unwrap()
            step("Inspect the observed result")
            expect(observed.line).to_equal(1)
            expect(observed.column).to_equal(1)
            expect(observed.full_id).to_equal(real.full_id)
            expect(semantic_link_from_line_v1(document, revision, 2, 2, false).unwrap()).to_equal(real_uri)
            step("Reject the negative control")
            robust_06_semantic_docs_assert_failure(resolve_semantic_link_source_v1(format_short_link(invented, forged_id), document, revision), SemanticLinkFailureV1.UnresolvedTarget)
            expect(file_delete(file)).to_equal(true)
