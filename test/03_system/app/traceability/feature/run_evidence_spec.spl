# @tag:in-development
# @plan: doc/03_plan/sys_test/simple_traceability_sdn_slop.md
# @design: doc/05_design/simple_traceability_sdn_slop.md
"""
# Traceability execution, evidence, and report acceptance

**Purpose and audience:** As a maintainer or operator, I need the traceability feature to prove the exact acceptance behavior against a retained production candidate, so I can trust only the evidence that actually ran.

**Primary workflow:** Prepare an isolated candidate, declare the requirement and acceptance obligation, run the production traceability command, inspect retained SDN and Markdown, then verify the exact subject and obligation state.

**Limitations:** These scenarios are in development. The admitted production runner, isolated fixture builder, run artifact reader, and capture writer are not connected. A missing adapter fails with its exact reason; authored declarations and preview output never count as a pass.
"""
use std.spec.*
use std.spec.step
use test.system.app.traceability.feature.acceptance_helpers.{trc_fixture_create, trc_run_candidate, trc_read_run_artifacts, trc_assert_subject, trc_assert_obligation, trc_capture_result, trc_assert_artifact_integrity, trc_validate_criterion_oracle}
# @req REQ-TRC-001 REQ-TRC-002 REQ-TRC-003 REQ-TRC-004 REQ-TRC-005 REQ-TRC-006 REQ-TRC-007 REQ-TRC-011 REQ-TRC-012 REQ-TRC-013 REQ-TRC-014 REQ-TRC-017 REQ-TRC-018 REQ-TRC-019
# @manual_section: Execution and durable evidence workflows
describe "Traceability execution, evidence, and report acceptance":
    # @req REQ-TRC-012 REQ-TRC-013
    # @ac AC-TRC-021
    it "should record only the acceptance layer that actually ran":
        """
        Requirement: REQ-TRC-012 REQ-TRC-013; acceptance: AC-TRC-021.
        Purpose: As a feature maintainer, I need the system to record only the acceptance layer that actually ran, so that the evidence reflects the real candidate.
        Workflow: Prepare an isolated candidate, declare this obligation, run the production command, inspect retained artifacts, and verify the subject.
        Limitation: real feature obligation graph and acceptance-only runner; persisted SDN and Markdown layer states. Until its production adapter exists, this scenario must fail closed.
        """
        step("Prepare the isolated candidate")
        val fixture = match trc_fixture_create("AC-TRC-021", "native-acceptance", "real feature obligation graph and acceptance-only runner; persisted SDN and Markdown layer states"):
            case Ok(value): value
            case Err(reason):
                fail(reason)
                return
        step("Declare the requirement and acceptance obligation")
        val obligation_id = "AC-TRC-021"
        step("Run the production traceability command")
        val result = match trc_run_candidate(fixture, "native-acceptance"):
            case Ok(value): value
            case Err(reason):
                fail(reason)
                return
        step("Inspect the retained SDN result and Markdown report")
        val artifacts = match trc_read_run_artifacts(result.run_id):
            case Ok(value): value
            case Err(reason):
                fail(reason)
                return
        expect(artifacts.sdn.len()).to_be_greater_than(0)
        expect(artifacts.markdown.len()).to_be_greater_than(0)
        match trc_assert_artifact_integrity(artifacts):
            case Ok(()): ()
            case Err(reason):
                fail(reason)
                return
        match trc_capture_result("AC-TRC-021", result):
            case Ok(()): ()
            case Err(reason):
                fail(reason)
                return
        match trc_validate_criterion_oracle("AC-TRC-021"):
            case Ok(()): ()
            case Err(reason):
                fail(reason)
                return
        step("Verify the exact subject and obligation state")
        trc_assert_subject(result, fixture.expected_subject)
        trc_assert_obligation(result, obligation_id, "satisfied")
