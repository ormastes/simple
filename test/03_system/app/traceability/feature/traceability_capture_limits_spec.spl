# @cover src/app/traceability/_TraceabilityCore/config_and_analysis.spl 80%
# @cover src/app/traceability/capture_v1.spl 80%
# @cover src/app/traceability/cli_options_v1.spl 80%
"""Acceptance controls for bounded structural capture; no graph-admission claim.
Requirements: doc/02_requirements/feature/traceability_sdn_slop.md
Plan: doc/03_plan/sys_test/traceability_sdn_slop.md
Design: doc/05_design/app/traceability_cli_sdn_v1.md
"""
use std.spec.*
use std.spec.step
use std.common.base_encoding.utilities.{validated_utf8_bytes_to_text_linear}
use app.io.minimal_runtime_ops.{process_run_bounded}
use app.traceability.cli_options_v1.{TraceCliOptionsV1, trace_cli_options_parse_v1}
use app.traceability.capture_v1.{TraceCaptureLimitsV1, trace_capture_worktree_v1, trace_capture_enumeration_v1}
use app.traceability.structural_report_v1.{trace_qualification_infrastructure_v1}
use std.common.traceability.types_v1.{trace_qualification_codec_limits_v1}
use std.common.traceability.qualification_v1.{trace_qualification_encode_v1}
use app.traceability.core.{VirtualFile, TraceabilityConfig, default_traceability_config,
    traceability_config_validate_captured_v1, analyze_virtual_files_bounded_v1}

fn trace_fixture_nul_v1() -> text:
    var accepted = false
    var nul = ""
    match validated_utf8_bytes_to_text_linear([0u8]):
        case Ok(value):
            accepted = true
            nul = value
        case Err(_): pass
    expect(accepted).to_equal(true)
    expect(nul.len()).to_equal(1)
    expect(nul.bytes()).to_equal([0u8])
    nul

fn options_rejected(args: [text]) -> bool:
    match trace_cli_options_parse_v1(args):
        case Err(_): true
        case Ok(_): false

fn enumeration_rejected(out: text, err: text, code: i64, bytes: i64, entries: i64) -> bool:
    match trace_capture_enumeration_v1(out, err, code, bytes, entries):
        case Err(_): true
        case Ok(_): false

describe "Bound structural capture before accepting a completed snapshot":
    it "rejects constructed options and limits before creating an attempt subject":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Refuse unsupported options before capture")
        var rejected = false
        match trace_capture_worktree_v1(TraceCliOptionsV1(scope: "unknown"), TraceCaptureLimitsV1()):
            case Err(issue): rejected = issue.code == "TRC-CAPTURE-OPTIONS" and issue.snapshot_id == "worktree-attempt:unavailable"
            case Ok(_): pass
        expect(rejected).to_equal(true)
        step("Refuse invalid limits before capture")
        rejected = false
        match trace_capture_worktree_v1(TraceCliOptionsV1(), TraceCaptureLimitsV1(max_files: -1)):
            case Err(issue): rejected = issue.code == "TRC-CAPTURE-LIMIT" and issue.snapshot_id == "worktree-attempt:unavailable"
            case Ok(_): pass
        expect(rejected).to_equal(true)
        step("Encode unavailable identity as an incomplete report")
        val report = trace_qualification_infrastructure_v1("worktree-attempt:unavailable", false,
            TraceCliOptionsV1(), "TRC-CAPTURE-ROOT", "", "Working directory unavailable")
        var encoded = false
        match trace_qualification_encode_v1(report, trace_qualification_codec_limits_v1()):
            case Ok(wire): encoded = wire.contains("worktree-attempt:unavailable") and not report.snapshot.complete
            case Err(_): pass
        expect(encoded).to_equal(true)

    it "rejects NUL arguments and retains quiet regardless of flag order":
        # @req: REQ-TRC-007, REQ-TRC-010
        # @ac: AC-TRC-002, AC-TRC-015
        val nul = trace_fixture_nul_v1()
        expect(options_rejected(["test/" + nul + "hidden"])).to_equal(true)
        expect(options_rejected(["--scope"])).to_equal(true)
        var quiet = false
        match trace_cli_options_parse_v1(["--quiet", "--dots"]):
            case Ok(options): quiet = options.quiet and options.progress == "none"
            case Err(_): pass
        expect(quiet).to_equal(true)

    it "rejects incomplete enumeration even with successful process status":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Require complete framing, no stderr and retained byte bounds")
        val nul = trace_fixture_nul_v1()
        expect(enumeration_rejected("./test", "", 0, 100, 10)).to_equal(true)
        expect(enumeration_rejected("./test" + nul, "provider error", 0, 100, 10)).to_equal(true)
        expect(enumeration_rejected("./test" + nul, "", 0, 2, 10)).to_equal(true)
        expect(enumeration_rejected("./test" + nul, "", 0, 100, 0)).to_equal(true)
        expect(enumeration_rejected("./test" + nul + nul, "", 0, 100, 10)).to_equal(true)
        expect(enumeration_rejected("outside" + nul, "", 0, 100, 10)).to_equal(true)
        step("Preserve Unicode and newline names without interpreting marker text")
        var accepted = false
        val name = "test/λ\n[output truncated: legitimate filename]"
        match trace_capture_enumeration_v1("./" + name + nul, "", 0, 1000, 1):
            case Ok(paths): accepted = paths.len() == 1 and paths[0] == name
            case Err(_): pass
        expect(accepted).to_equal(true)

    it "refuses actual native find output truncated at successful exit":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Capture an existing long fixture path with a tiny native output cap")
        val (out, err, code) = process_run_bounded("find",
            ["-P", "./test/fixtures/traceability_sdn/empty", "-maxdepth", "0", "-print0"], 5000, 8)
        expect(code).to_equal(0)
        expect(enumeration_rejected(out, err, code, 8, 10)).to_equal(true)

    it "checks configuration members before manifest construction":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        var long_path = ""
        for index in 0..4097:
            long_path = long_path + "x"
        val config = TraceabilityConfig(generated_spec_root: long_path,
            legacy_requirement_root: "doc/requirement", warn_source_roots: [])
        var rejected = false
        match traceability_config_validate_captured_v1(config):
            case Err(_): rejected = true
            case Ok(_): pass
        expect(rejected).to_equal(true)

    it "refuses diagnostic construction while retaining full parsed context":
        # @req: REQ-TRC-007, REQ-TRC-010
        # @ac: AC-TRC-015
        val files = [VirtualFile(path: "src/example.spl", content: "fn example():\n    pass\n")]
        var rejected = false
        match analyze_virtual_files_bounded_v1(files, "all", default_traceability_config(), false, 5):
            case Err(_): rejected = true
            case Ok(_): pass
        expect(rejected).to_equal(true)
        var accepted = false
        match analyze_virtual_files_bounded_v1(files, "all", default_traceability_config(), false, 6):
            case Ok(warnings): accepted = warnings.len() == 0
            case Err(_): pass
        expect(accepted).to_equal(true)
