# @cover src/lib/common/traceability/graph_wire_v1.spl 80%
# @cover src/lib/common/traceability/conventions_resolve_v1.spl 80%
# @cover src/lib/common/traceability/conventions_types_v1.spl 80%
"""Conventional associations inspect immutable typed facts, not execution proof."""
use std.spec.*
use std.spec.step
use std.common.crypto.sha256.{sha256_text}
use std.common.traceability.envelope_types_v1.{TraceSnapshotV1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.conventions_v1.*
use std.common.traceability.graph_schema_v1.{trace_graph_validate_v1}
use std.common.traceability.graph_wire_v1.{trace_graph_tuple_key_v1}

fn convention_fixture_v1(target: bool = true, alternative: bool = false) -> TraceGraphV1:
    var graph = TraceGraphV1(snapshot: TraceSnapshotV1(id: "snapshot:one", kind: "worktree", complete: true),
        manifest: TraceGraphManifestV1(input_set_id: "inputs:one", extractor_version: "facts/v1", rules_version: "rules/v1", policy_id: "policy:one", complete: true),
        inputs: [TraceGraphInputV1(path: "src/app/tool.spl", sha256: sha256_text("fn tool(): 1\n"), bytes: "fn tool(): 1\n".len(), role: "source")],
        nodes: [TraceGraphNodeV1(id: "source:one", kind: "source_file", title: "tool")], test_definitions: [], edges: [], edge_origins: [],
        locators: [TraceGraphLocatorV1(entity_id: "source:one", path_available: true, path: "src/app/tool.spl", locator_kind: "file", locator: "")])
    if target:
        graph.inputs = graph.inputs + [TraceGraphInputV1(path: "test/01_unit/app/tool_spec.spl", sha256: sha256_text("it \"one\": expect(tool()).to_equal(1)\n"), bytes: "it \"one\": expect(tool()).to_equal(1)\n".len(), role: "test")]
        graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "suite:one", kind: "test_suite", title: "tool suite"), TraceGraphNodeV1(id: "case:one", kind: "test_case", title: "one")]
        graph.test_definitions = graph.test_definitions + [TraceGraphTestDefinitionV1(entity_id: "case:one", test_kind: "unit", identity_scope: "stable", definition_id: "case:one", parameter_digest_available: false, parameter_digest: "")]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "suite:one", path_available: true, path: "test/01_unit/app/tool_spec.spl", locator_kind: "file", locator: ""),
            TraceGraphLocatorV1(entity_id: "case:one", path_available: true, path: "test/01_unit/app/tool_spec.spl", locator_kind: "scenario", locator: "one")]
    if alternative:
        graph.inputs = graph.inputs + [TraceGraphInputV1(path: "test/legacy/app/tool_spec.spl", sha256: sha256_text("it \"two\": expect(tool()).to_equal(1)\n"), bytes: "it \"two\": expect(tool()).to_equal(1)\n".len(), role: "test")]
        graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "suite:two", kind: "test_suite", title: "legacy suite"), TraceGraphNodeV1(id: "case:two", kind: "test_case", title: "two")]
        graph.test_definitions = graph.test_definitions + [TraceGraphTestDefinitionV1(entity_id: "case:two", test_kind: "unit", identity_scope: "stable", definition_id: "case:two", parameter_digest_available: false, parameter_digest: "")]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "suite:two", path_available: true, path: "test/legacy/app/tool_spec.spl", locator_kind: "file", locator: ""),
            TraceGraphLocatorV1(entity_id: "case:two", path_available: true, path: "test/legacy/app/tool_spec.spl", locator_kind: "scenario", locator: "two")]
    var valid_graph = false
    match trace_graph_validate_v1(graph, trace_graph_codec_limits_v1()):
        case Ok(_): valid_graph = true
        case Err(issue): print "Invalid source fixture: {issue.code} {issue.path}"
    expect(valid_graph).to_equal(true)
    graph

fn convention_policy_v1(alternative: bool = false) -> TraceConventionPolicyV1:
    var rules = [TraceConventionRuleV1(id: "app-unit-v1", group_id: "unit:app", kind: "unit", source_root: "src/app/", target_root: "test/01_unit/app/", source_suffix: ".spl", target_suffix: "_spec.spl")]
    if alternative: rules = rules + [TraceConventionRuleV1(id: "legacy-unit-v1", group_id: "unit:app", kind: "unit", source_root: "src/app/", target_root: "test/legacy/app/", source_suffix: ".spl", target_suffix: "_spec.spl")]
    TraceConventionPolicyV1(id: "policy:one", version: "rules/v1", rules: rules, exclusions: [])

fn convention_result_v1(graph: TraceGraphV1, policy: TraceConventionPolicyV1) -> TraceConventionResolutionV1:
    var accepted = false
    var result = TraceConventionResolutionV1(snapshot_id: "", input_set_id: "", policy_id: "", rules_version: "", complete: false, claims: [], diagnostics: [], lookups: [])
    match trace_resolve_conventions_v1(graph, policy, trace_convention_limits_v1()):
        case Ok(value):
            accepted = true
            result = value
        case Err(issue): print "Unexpected convention refusal: {issue.code} {issue.path}"
    expect(accepted).to_equal(true)
    result

fn convention_manual_fixture_v1() -> TraceGraphV1:
    var graph = convention_fixture_v1()
    graph.inputs = graph.inputs + [TraceGraphInputV1(path: "doc/06_spec/app/tool_spec.md", sha256: sha256_text("manual\n"), bytes: "manual\n".len(), role: "document"),
        TraceGraphInputV1(path: "config/docgen.sdn", sha256: sha256_text("generator: docgen\n"), bytes: "generator: docgen\n".len(), role: "policy")]
    graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "manual:one", kind: "generated_document", title: "one manual")]
    graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "manual:one", path_available: true, path: "doc/06_spec/app/tool_spec.md", locator_kind: "file", locator: "")]
    graph

fn convention_manual_policy_v1(binding: bool = false) -> TraceConventionPolicyV1:
    var policy = TraceConventionPolicyV1(id: "policy:one", version: "rules/v1", rules: [TraceConventionRuleV1(id: "manual-v1", group_id: "manual:app", kind: "manual", source_root: "test/01_unit/app/", target_root: "doc/06_spec/app/", source_suffix: ".spl", target_suffix: ".md")], exclusions: [])
    if binding:
        policy.generator_bindings = [TraceConventionGeneratorBindingV1(id: "binding:one", suite_id: "suite:one", document_id: "manual:one", rule_id: "manual-v1", generator_id: "docgen/v1", manifest_path: "config/docgen.sdn", manifest_sha256: sha256_text("generator: docgen\n"))]
    policy

fn convention_diag_has_v1(result: TraceConventionResolutionV1, code: text) -> bool:
    for item in result.diagnostics:
        if item.code == code: return true
    false

fn convention_lookup_has_v1(result: TraceConventionResolutionV1, kind: text, path: text, found: bool) -> bool:
    for item in result.lookups:
        if item.kind == kind and item.path == path and item.found == found: return true
    false

fn convention_refusal_v1(graph: TraceGraphV1, policy: TraceConventionPolicyV1, limits: TraceConventionLimitsV1, code: text) -> bool:
    match trace_resolve_conventions_v1(graph, policy, limits):
        case Err(issue): issue.code == code
        case Ok(_): false

fn convention_rewrite_path_v1(graph: TraceGraphV1, old_path: text, new_path: text) -> TraceGraphV1:
    var result = graph
    var inputs: [TraceGraphInputV1] = []
    for input in graph.inputs:
        var item = input
        if item.path == old_path: item.path = new_path
        inputs.push(item)
    var locators: [TraceGraphLocatorV1] = []
    for locator in graph.locators:
        var item = locator
        if item.path == old_path: item.path = new_path
        locators.push(item)
    result.inputs = inputs
    result.locators = locators
    result

fn convention_signature_v1(result: TraceConventionResolutionV1) -> text:
    var parts = [trace_graph_tuple_key_v1([result.snapshot_id, result.input_set_id, result.policy_id, result.rules_version, result.complete.to_text()])]
    for item in result.claims: parts.push(trace_graph_tuple_key_v1([item.from_id, item.relation, item.to_id, item.rule_id, item.source_path, item.target_path]))
    for item in result.diagnostics:
        parts.push(trace_graph_tuple_key_v1([item.code, item.severity, item.entity, item.path, item.path_available.to_text(), item.span_available.to_text(), item.line.to_text(), item.column.to_text(), item.message, item.snapshot_id, item.rule_version, item.origin, item.repair]))
    for item in result.lookups: parts.push(trace_graph_tuple_key_v1([item.kind, item.entity_id, item.group_id, item.rule_id, item.path, item.found.to_text()] + item.candidate_ids))
    parts.join("\n")

fn convention_component_fixture_v1(kind: text) -> TraceGraphV1:
    var graph = convention_fixture_v1()
    graph = convention_rewrite_path_v1(graph, "src/app/tool.spl", "config/components/tool.sdn")
    graph = convention_rewrite_path_v1(graph, "test/01_unit/app/tool_spec.spl", "test/components/tool_spec.spl")
    var source = graph.nodes[0]
    source.kind = "component"
    graph.nodes = [source, graph.nodes[1], graph.nodes[2]]
    var input = graph.inputs[0]
    input.role = "policy"
    input.sha256 = sha256_text("component: tool\n")
    input.bytes = "component: tool\n".len()
    graph.inputs = [input, graph.inputs[1]]
    var definition = graph.test_definitions[0]
    definition.test_kind = kind
    graph.test_definitions = [definition]
    graph

fn convention_component_policy_v1(kind: text) -> TraceConventionPolicyV1:
    TraceConventionPolicyV1(id: "policy:one", version: "rules/v1", rules: [TraceConventionRuleV1(id: kind + "-v1", group_id: kind + ":components", kind: kind, source_root: "config/components/", target_root: "test/components/", source_suffix: ".sdn", target_suffix: "_spec.spl")], exclusions: [])

fn convention_two_manuals_v1() -> TraceGraphV1:
    var graph = convention_manual_fixture_v1()
    graph.inputs = graph.inputs + [TraceGraphInputV1(path: "doc/06_spec/legacy/tool_spec.md", sha256: sha256_text("second manual\n"), bytes: "second manual\n".len(), role: "document")]
    graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "manual:two", kind: "generated_document", title: "second manual")]
    graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "manual:two", path_available: true, path: "doc/06_spec/legacy/tool_spec.md", locator_kind: "file", locator: "")]
    graph

fn convention_two_manual_rules_v1() -> TraceConventionPolicyV1:
    var policy = convention_manual_policy_v1(true)
    policy.rules = policy.rules + [TraceConventionRuleV1(id: "manual-other-v1", group_id: "manual:app", kind: "manual", source_root: "test/01_unit/app/", target_root: "doc/06_spec/legacy/", source_suffix: ".spl", target_suffix: ".md")]
    var binding = policy.generator_bindings[0]
    binding.id = "binding:two"
    binding.document_id = "manual:two"
    binding.rule_id = "manual-other-v1"
    policy.generator_bindings = policy.generator_bindings + [binding]
    policy

describe "Snapshot-bound conventional association resolution":
    it "derives unit targets without a redundant authored declaration":
        # @req: REQ-TRC-004, REQ-TRC-005
        # @ac: AC-TRC-003
        step("Resolve one registered source-to-suite mapping from immutable facts")
        val result = convention_result_v1(convention_fixture_v1(), convention_policy_v1())
        expect(result.claims.len()).to_equal(1)
        expect(result.claims[0].from_id).to_equal("case:one")
        expect(result.claims[0].relation).to_equal("targets")
        expect(result.claims[0].to_id).to_equal("source:one")
        expect(result.claims[0].rule_id).to_equal("app-unit-v1")
        expect(result.diagnostics.len()).to_equal(0)

    it "records a missing target as a negative lookup and structural diagnostic":
        # @req: REQ-TRC-006, REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Retain the absent candidate dependency instead of treating it as no obligation")
        val result = convention_result_v1(convention_fixture_v1(false), convention_policy_v1())
        expect(result.claims.len()).to_equal(0)
        var missing = false
        for item in result.diagnostics:
            if item.code == "missing_conventional_target": missing = true
        expect(missing).to_equal(true)
        var negative = false
        for item in result.lookups:
            if item.kind == "target" and item.path == "test/01_unit/app/tool_spec.spl" and not item.found: negative = true
        expect(negative).to_equal(true)

    it "refuses to pick the first of two recognized alternatives":
        # @req: REQ-TRC-006, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Resolve changed membership as ambiguity while retaining both candidate queries")
        val result = convention_result_v1(convention_fixture_v1(true, true), convention_policy_v1(true))
        expect(result.claims.len()).to_equal(0)
        var ambiguous = false
        for item in result.diagnostics:
            if item.code == "ambiguous_conventional_target": ambiguous = true
        expect(ambiguous).to_equal(true)

    it "requires a generator manifest beyond a matching manual path":
        # @req: REQ-TRC-004, REQ-TRC-005, REQ-TRC-017
        # @ac: AC-TRC-003
        step("Keep a mirror-shaped document unresolved without a generator binding")
        val result = convention_result_v1(convention_manual_fixture_v1(), convention_manual_policy_v1())
        expect(result.claims.len()).to_equal(0)
        var missing = false
        for item in result.diagnostics:
            if item.code == "missing_generator_binding": missing = true
        expect(missing).to_equal(true)

    it "derives a manual link from the captured matching generator manifest":
        # @req: REQ-TRC-004, REQ-TRC-005
        # @ac: AC-TRC-003
        step("Check the explicit suite/output/rule binding and immutable manifest digest")
        val result = convention_result_v1(convention_manual_fixture_v1(), convention_manual_policy_v1(true))
        expect(result.claims.len()).to_equal(1)
        expect(result.claims[0].from_id).to_equal("manual:one")
        expect(result.claims[0].relation).to_equal("generated_from")
        expect(result.claims[0].to_id).to_equal("suite:one")
        expect(result.diagnostics.len()).to_equal(0)

    it "refuses a generator manifest digest from another captured input":
        # @req: REQ-TRC-017
        # @ac: AC-TRC-035
        step("A declared digest cannot replace the captured manifest bytes")
        var policy = convention_manual_policy_v1(true)
        var binding = policy.generator_bindings[0]
        binding.manifest_sha256 = sha256_text("another manifest")
        policy.generator_bindings = [binding]
        var refused = false
        match trace_resolve_conventions_v1(convention_manual_fixture_v1(), policy, trace_convention_limits_v1()):
            case Err(issue): refused = issue.code == "invalid_generator_binding"
            case Ok(_): ()
        expect(refused).to_equal(true)

    it "recognizes a bound manual while retaining an unbound mirror as a negative dependency":
        # @req: REQ-TRC-004, REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-003, AC-TRC-005
        step("Query generator bindings before alternative candidate cardinality")
        var graph = convention_manual_fixture_v1()
        graph.inputs = graph.inputs + [TraceGraphInputV1(path: "doc/06_spec/legacy/tool_spec.md", sha256: sha256_text("lookalike\n"), bytes: "lookalike\n".len(), role: "document")]
        graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "manual:unbound", kind: "generated_document", title: "unbound mirror")]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "manual:unbound", path_available: true, path: "doc/06_spec/legacy/tool_spec.md", locator_kind: "file", locator: "")]
        var policy = convention_manual_policy_v1(true)
        policy.rules = policy.rules + [TraceConventionRuleV1(id: "manual-other-v1", group_id: "manual:app", kind: "manual", source_root: "test/01_unit/app/", target_root: "doc/06_spec/legacy/", source_suffix: ".spl", target_suffix: ".md")]
        val result = convention_result_v1(graph, policy)
        expect(result.claims.len()).to_equal(1)
        if result.claims.len() == 1: expect(result.claims[0].from_id).to_equal("manual:one")
        var negative = false
        for item in result.lookups:
            if item.kind == "generator_binding" and item.rule_id == "manual-other-v1" and not item.found: negative = true
        expect(negative).to_equal(true)

    it "charges the complete indexed source and mapping group traversal at its work boundary":
        # @req: REQ-TRC-017
        # @ac: AC-TRC-035
        step("Count index records, node traversal, group traversal, queries and claim emission")
        var limits = trace_convention_limits_v1()
        limits.max_work = 27
        var refused = false
        match trace_resolve_conventions_v1(convention_fixture_v1(), convention_policy_v1(), limits):
            case Err(issue): refused = issue.code == "work_limit"
            case Ok(_): ()
        expect(refused).to_equal(true)
        limits.max_work = 28
        var exact = false
        match trace_resolve_conventions_v1(convention_fixture_v1(), convention_policy_v1(), limits):
            case Ok(result): exact = result.complete and result.claims.len() == 1
            case Err(_): ()
        expect(exact).to_equal(true)

    it "keeps an artifact positive and its wrong-role dependency negative":
        # @req: REQ-TRC-001, REQ-TRC-005, REQ-TRC-007
        # @ac: AC-TRC-005
        step("An acceptance case is never relabeled into a unit test")
        var graph = convention_fixture_v1()
        var definition = graph.test_definitions[0]
        definition.test_kind = "acceptance"
        graph.test_definitions = [definition]
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "unrecognized_conventional_target")).to_equal(true)
        expect(convention_lookup_has_v1(result, "artifact", "test/01_unit/app/tool_spec.spl", true)).to_equal(true)
        expect(convention_lookup_has_v1(result, "role", "test/01_unit/app/tool_spec.spl", false)).to_equal(true)
        expect(convention_lookup_has_v1(result, "target", "test/01_unit/app/tool_spec.spl", false)).to_equal(true)

    it "preserves every corroborating rule origin for one recognized target":
        # @req: REQ-TRC-004, REQ-TRC-017
        # @ac: AC-TRC-003
        step("Two corroborating mappings retain provenance without false ambiguity")
        var policy = convention_policy_v1()
        var rule = policy.rules[0]
        rule.id = "corroborating-unit-v1"
        policy.rules = policy.rules + [rule]
        val result = convention_result_v1(convention_fixture_v1(), policy)
        expect(result.claims.len()).to_equal(2)
        var first = false
        var second = false
        for claim in result.claims:
            if claim.rule_id == "app-unit-v1" and claim.to_id == "source:one": first = true
            if claim.rule_id == "corroborating-unit-v1" and claim.to_id == "source:one": second = true
        expect(first and second).to_equal(true)
        expect(result.diagnostics.len()).to_equal(0)

    it "keeps parameter identities separate within one suite artifact":
        # @req: REQ-TRC-001, REQ-TRC-004
        # @ac: AC-TRC-003
        step("A base case and parameter instance produce separate structural associations")
        var graph = convention_fixture_v1()
        graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "case:parameter", kind: "parameterized_case", title: "one[value]")]
        graph.test_definitions = graph.test_definitions + [TraceGraphTestDefinitionV1(entity_id: "case:parameter", test_kind: "unit", identity_scope: "stable", definition_id: "case:one", parameter_digest_available: true, parameter_digest: sha256_text("value=one"))]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "case:parameter", path_available: true, path: "test/01_unit/app/tool_spec.spl", locator_kind: "scenario", locator: "one[value]")]
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(2)
        var parameter = false
        for claim in result.claims:
            if claim.from_id == "case:parameter" and claim.to_id == "source:one": parameter = true
        expect(parameter).to_equal(true)
        expect(result.diagnostics.len()).to_equal(0)

    it "resolves integration and component roles from supplied component manifest facts":
        # @req: REQ-TRC-004, REQ-TRC-005
        # @ac: AC-TRC-003
        step("A classified component receives only its registered role association")
        for kind in ["integration", "component"]:
            val result = convention_result_v1(convention_component_fixture_v1(kind), convention_component_policy_v1(kind))
            expect(result.claims.len()).to_equal(1)
            expect(result.claims[0].from_id).to_equal("case:one")
            expect(result.claims[0].to_id).to_equal("source:one")
            expect(result.claims[0].relation).to_equal("targets")
            expect(result.claims[0].source_path).to_equal("config/components/tool.sdn")
            expect(result.diagnostics.len()).to_equal(0)

    it "honors explicit source exclusion and retains its dependency":
        # @req: REQ-TRC-004, REQ-TRC-007
        # @ac: AC-TRC-003
        step("An explicit scoped exclusion removes this mapping expectation")
        var policy = convention_policy_v1()
        policy.exclusions = [TraceConventionExclusionV1(group_id: "unit:app", root: "src/app/", reason: "explicit generated source exemption")]
        val result = convention_result_v1(convention_fixture_v1(false), policy)
        expect(result.claims.len()).to_equal(0)
        expect(result.diagnostics.len()).to_equal(0)
        expect(convention_lookup_has_v1(result, "exclusion", "src/app/tool.spl", true)).to_equal(true)
        expect(convention_lookup_has_v1(result, "target", "test/01_unit/app/tool_spec.spl", false)).to_equal(false)

    it "retains an excluded target artifact while refusing it as a candidate":
        # @req: REQ-TRC-004, REQ-TRC-007
        # @ac: AC-TRC-005
        step("Target exclusions do not erase the source mapping expectation")
        var policy = convention_policy_v1()
        policy.exclusions = [TraceConventionExclusionV1(group_id: "unit:app", root: "test/01_unit/app/", reason: "explicit obsolete test tree")]
        val result = convention_result_v1(convention_fixture_v1(), policy)
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "missing_conventional_target")).to_equal(true)
        expect(convention_lookup_has_v1(result, "artifact", "test/01_unit/app/tool_spec.spl", true)).to_equal(true)
        expect(convention_lookup_has_v1(result, "exclusion", "test/01_unit/app/tool_spec.spl", true)).to_equal(true)
        expect(convention_lookup_has_v1(result, "target", "test/01_unit/app/tool_spec.spl", false)).to_equal(true)

    it "keeps new vendor roots visible unless explicitly excluded":
        # @req: REQ-TRC-004, REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-005
        step("No implicit vendor or unregistered-root suppression is applied")
        val graph = convention_rewrite_path_v1(convention_fixture_v1(false), "src/app/tool.spl", "vendor/new/tool.spl")
        val visible = convention_result_v1(graph, convention_policy_v1())
        expect(convention_diag_has_v1(visible, "unregistered_conventional_source")).to_equal(true)
        var policy = convention_policy_v1()
        policy.exclusions = [TraceConventionExclusionV1(group_id: "unit:app", root: "vendor/", reason: "explicit registered external source")]
        val excluded = convention_result_v1(graph, policy)
        expect(excluded.diagnostics.len()).to_equal(0)
        expect(convention_lookup_has_v1(excluded, "exclusion", "vendor/new/tool.spl", true)).to_equal(true)

    it "maps exact Unicode bytes without changing source or target identity":
        # @req: REQ-TRC-004, REQ-TRC-017
        # @ac: AC-TRC-003
        step("Only registered prefix and suffix boundaries are removed")
        var graph = convention_rewrite_path_v1(convention_fixture_v1(), "src/app/tool.spl", "src/app/器具.spl")
        graph = convention_rewrite_path_v1(graph, "test/01_unit/app/tool_spec.spl", "test/01_unit/app/器具_spec.spl")
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(1)
        expect(result.claims[0].source_path).to_equal("src/app/器具.spl")
        expect(result.claims[0].target_path).to_equal("test/01_unit/app/器具_spec.spl")

    it "rejects basename, case and numeric-prefix heuristics":
        # @req: REQ-TRC-004, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Every unmatched root remains unregistered regardless of filename resemblance")
        for path in ["src/App/tool.spl", "src/01_app/tool.spl", "other/app/tool.spl"]:
            val graph = convention_rewrite_path_v1(convention_fixture_v1(false), "src/app/tool.spl", path)
            val result = convention_result_v1(graph, convention_policy_v1())
            expect(result.claims.len()).to_equal(0)
            expect(convention_diag_has_v1(result, "unregistered_conventional_source")).to_equal(true)

    it "refuses arbitrary selection among artifact identities at one target path":
        # @req: REQ-TRC-001, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Two suites at one physical path remain an identity ambiguity")
        var graph = convention_fixture_v1()
        graph.nodes = graph.nodes + [TraceGraphNodeV1(id: "suite:duplicate", kind: "test_suite", title: "conflicting suite")]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "suite:duplicate", path_available: true, path: "test/01_unit/app/tool_spec.spl", locator_kind: "file", locator: "")]
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "ambiguous_conventional_target")).to_equal(true)

    it "retains physical source ambiguity without inventing a diagnostic span":
        # @req: REQ-TRC-001, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Multiple source locators cannot choose a preferred mapping path")
        var graph = convention_fixture_v1()
        graph.inputs = graph.inputs + [TraceGraphInputV1(path: "src/app/alias.spl", sha256: sha256_text("alias\n"), bytes: "alias\n".len(), role: "source")]
        graph.locators = graph.locators + [TraceGraphLocatorV1(entity_id: "source:one", path_available: true, path: "src/app/alias.spl", locator_kind: "file", locator: "")]
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "ambiguous_conventional_source")).to_equal(true)
        expect(result.diagnostics[0].path_available).to_equal(false)
        expect(result.diagnostics[0].span_available).to_equal(false)
        expect(result.diagnostics[0].line).to_equal(0)
        expect(result.diagnostics[0].column).to_equal(0)

    it "keeps an unlocated source as a negative source lookup":
        # @req: REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Unavailable provenance remains explicit rather than choosing another entity path")
        var graph = convention_fixture_v1(false)
        graph.locators = []
        val result = convention_result_v1(graph, convention_policy_v1())
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "unlocated_conventional_source")).to_equal(true)
        expect(convention_lookup_has_v1(result, "source", "", false)).to_equal(true)

    it "records two bound manual candidates before refusing ambiguity":
        # @req: REQ-TRC-004, REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Binding membership is retained for both recognized output paths")
        val result = convention_result_v1(convention_two_manuals_v1(), convention_two_manual_rules_v1())
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "ambiguous_conventional_target")).to_equal(true)
        expect(convention_lookup_has_v1(result, "generator_binding", "doc/06_spec/app/tool_spec.md", true)).to_equal(true)
        expect(convention_lookup_has_v1(result, "generator_binding", "doc/06_spec/legacy/tool_spec.md", true)).to_equal(true)

    it "refuses several generator bindings for one otherwise unique manual":
        # @req: REQ-TRC-004, REQ-TRC-017
        # @ac: AC-TRC-005
        step("A distinct generator identity cannot be selected by arrival order")
        var policy = convention_manual_policy_v1(true)
        var binding = policy.generator_bindings[0]
        binding.id = "binding:another"
        binding.generator_id = "another-generator/v1"
        policy.generator_bindings = policy.generator_bindings + [binding]
        val result = convention_result_v1(convention_manual_fixture_v1(), policy)
        expect(result.claims.len()).to_equal(0)
        expect(convention_diag_has_v1(result, "ambiguous_generator_binding")).to_equal(true)

    it "refuses incomplete inventory and mismatched policy identities":
        # @req: REQ-TRC-017
        # @ac: AC-TRC-035
        step("Infrastructure refusal returns no partial successful resolution")
        var graph = convention_fixture_v1()
        graph.snapshot.complete = false
        expect(convention_refusal_v1(graph, convention_policy_v1(), trace_convention_limits_v1(), "incomplete_inventory")).to_equal(true)
        var policy = convention_policy_v1()
        policy.version = "rules/v2"
        expect(convention_refusal_v1(convention_fixture_v1(), policy, trace_convention_limits_v1(), "policy_mismatch")).to_equal(true)

    it "validates unique rules, closed groups, canonical roots and exclusions":
        # @req: REQ-TRC-017
        # @ac: AC-TRC-035
        step("Policy contradictions refuse before convention queries")
        var policy = convention_policy_v1()
        policy.rules = policy.rules + [policy.rules[0]]
        expect(convention_refusal_v1(convention_fixture_v1(), policy, trace_convention_limits_v1(), "duplicate_identifier")).to_equal(true)
        policy = convention_policy_v1()
        var rule = policy.rules[0]
        rule.id = "manual-conflict"
        rule.kind = "manual"
        policy.rules = policy.rules + [rule]
        expect(convention_refusal_v1(convention_fixture_v1(), policy, trace_convention_limits_v1(), "invalid_group")).to_equal(true)
        policy = convention_policy_v1()
        rule = policy.rules[0]
        rule.source_root = "src/app"
        policy.rules = [rule]
        expect(convention_refusal_v1(convention_fixture_v1(), policy, trace_convention_limits_v1(), "invalid_path")).to_equal(true)
        policy = convention_policy_v1()
        policy.exclusions = [TraceConventionExclusionV1(group_id: "unknown:group", root: "src/app/", reason: "unregistered exclusion")]
        expect(convention_refusal_v1(convention_fixture_v1(), policy, trace_convention_limits_v1(), "missing_reference")).to_equal(true)

    it "enforces record, output, field, text and hard work limits":
        # @req: REQ-TRC-017
        # @ac: AC-TRC-035
        step("Each bound fails closed with its specific refusal instead of a partial Ok")
        val graph = convention_fixture_v1()
        val policy = convention_policy_v1()
        var limits = trace_convention_limits_v1()
        limits.max_rules = -1
        expect(convention_refusal_v1(graph, policy, limits, "invalid_limits")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_rules = 0
        expect(convention_refusal_v1(graph, policy, limits, "record_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_work = 0
        expect(convention_refusal_v1(graph, policy, limits, "work_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_claims = 0
        expect(convention_refusal_v1(graph, policy, limits, "claim_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_diagnostics = 0
        expect(convention_refusal_v1(convention_fixture_v1(false), policy, limits, "diagnostic_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_lookups = 0
        expect(convention_refusal_v1(graph, policy, limits, "lookup_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_policy_text_bytes = 0
        expect(convention_refusal_v1(graph, policy, limits, "text_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_result_text_bytes = 0
        expect(convention_refusal_v1(graph, policy, limits, "text_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_field_bytes = 20
        expect(convention_refusal_v1(graph, policy, limits, "field_limit")).to_equal(true)
        limits = trace_convention_limits_v1()
        limits.max_bindings = 0
        expect(convention_refusal_v1(convention_manual_fixture_v1(), convention_manual_policy_v1(true), limits, "record_limit")).to_equal(true)

    it "returns identical full records for shuffled input and rule order":
        # @req: REQ-TRC-007, REQ-TRC-017
        # @ac: AC-TRC-005
        step("Compare every output field and ordered candidate ID rather than boxed object equality")
        val graph = convention_fixture_v1(true, true)
        val policy = convention_policy_v1(true)
        val expected = convention_result_v1(graph, policy)
        var shuffled = graph
        shuffled.inputs = [graph.inputs[2], graph.inputs[0], graph.inputs[1]]
        shuffled.nodes = [graph.nodes[4], graph.nodes[2], graph.nodes[0], graph.nodes[3], graph.nodes[1]]
        shuffled.test_definitions = [graph.test_definitions[1], graph.test_definitions[0]]
        shuffled.locators = [graph.locators[4], graph.locators[2], graph.locators[0], graph.locators[3], graph.locators[1]]
        var reordered = policy
        reordered.rules = [policy.rules[1], policy.rules[0]]
        val actual = convention_result_v1(shuffled, reordered)
        expect(convention_signature_v1(actual)).to_equal(convention_signature_v1(expected))
        expect(actual.snapshot_id).to_equal("snapshot:one")
        expect(actual.input_set_id).to_equal("inputs:one")
        expect(actual.policy_id).to_equal("policy:one")
        expect(actual.rules_version).to_equal("rules/v1")
        expect(actual.complete).to_equal(true)
