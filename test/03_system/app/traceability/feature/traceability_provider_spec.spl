# @cover src/lib/common/traceability/envelope_types_v1.spl 80%
# @cover src/lib/common/traceability/qualification_types_v1.spl 80%
# @cover src/app/io/minimal_runtime_ops.spl 80%
"""Actual Linux worktree-provider controls using the production native command.
Requirements: doc/02_requirements/feature/traceability_sdn_slop.md
Plan: doc/03_plan/sys_test/traceability_sdn_slop.md
Design: doc/05_design/app/traceability_cli_sdn_v1.md
The external harness creates exclusively owned cases beneath the fixed build
session root. GNU env changes only the child cwd; no shell or seed executes.
"""
use std.spec.*
use std.spec.step
use app.io.minimal_runtime_ops.{env_get, cwd, process_run_timeout}
use std.nogc_sync_mut.io.dir_ops.{is_dir}
use std.nogc_sync_mut.io.file_ops.{file_write}
use std.common.crypto.sha256.{sha256_text, sha256_stream_v1_new}
use std.common.traceability.types_v1.{TraceQualificationV1, TraceSnapshotV1,
    TraceSelectionV1, TraceEvaluationV1, trace_qualification_codec_limits_v1}
use std.common.traceability.qualification_v1.{trace_qualification_decode_v1, trace_qualification_encode_v1}

fn provider_fixture_root() -> text:
    val root = env_get("SIMPLE_TRACE_PROVIDER_FIXTURES")
    val expected = cwd() + "/build/session/traceability-provider-controls-20261011/cases"
    val valid = root == expected and is_dir(root)
    expect(valid).to_equal(true)
    if valid: root else: ""

fn run_provider_cli(case_name: text, selector: text) -> (text, text, i32):
    val root = provider_fixture_root()
    val binary = env_get("SIMPLE_TRACE_TEST_BINARY")
    val valid = root != "" and binary.starts_with(cwd() + "/build/native_probe/") and is_dir(root + "/" + case_name)
    expect(valid).to_equal(true)
    if not valid:
        return ("", "owned native provider fixture missing", 2)
    process_run_timeout("env", ["-C", root + "/" + case_name, binary, "--quiet", selector], 15000)

fn decode_provider_report(output: text) -> TraceQualificationV1:
    var accepted = false
    var report = TraceQualificationV1(snapshot: TraceSnapshotV1(id: "invalid-output", kind: "worktree", complete: false),
        selection: TraceSelectionV1(paths: [], full_repository: false),
        evaluation: TraceEvaluationV1(scope: "all", profile: "worktree", kind: "structural", complete: false,
            exit_code: 2, qualification: "incomplete"), diagnostics: [])
    match trace_qualification_decode_v1(output, trace_qualification_codec_limits_v1()):
        case Ok(value):
            accepted = true
            report = value
        case Err(_): pass
    expect(accepted).to_equal(true)
    var canonical = false
    match trace_qualification_encode_v1(report, trace_qualification_codec_limits_v1()):
        case Ok(wire): canonical = wire == output
        case Err(_): pass
    expect(canonical).to_equal(true)
    report

fn expect_provider_refusal(case_name: text, selector: text, expected_code: text):
    val (out, err, code) = run_provider_cli(case_name, selector)
    expect(code).to_equal(2)
    val report = decode_provider_report(out)
    expect(report.snapshot.complete).to_equal(false)
    expect(report.evaluation.complete).to_equal(false)
    expect(report.evaluation.exit_code).to_equal(2)
    expect(report.evaluation.qualification).to_equal("incomplete")
    expect(report.diagnostics.len()).to_equal(1)
    if report.diagnostics.len() == 1:
        expect(report.diagnostics[0].code).to_equal(expected_code)
        expect(report.diagnostics[0].snapshot_id).to_equal(report.snapshot.id)

describe "Exercise actual bounded worktree capture through the native CLI":
    it "rejects oversized captured configuration before selected-input materialization":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Read an oversized configuration member before resolving a missing selector")
        expect_provider_refusal("config-boundary", "test/missing.spl", "TRC-CONFIG-CAPTURE")

    it "refuses an actual symbolic file without claiming a complete snapshot":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Enumerate a directory containing a symbolic file")
        expect_provider_refusal("symlink", "test/data", "TRC-INPUT")

    it "refuses malformed UTF-8 in a real bounded file read":
        # @req: REQ-TRC-010
        # @ac: AC-TRC-015
        step("Read a regular file whose bytes contain an invalid UTF-8 lead byte")
        expect_provider_refusal("invalid-utf8", "test/data/invalid.spl", "TRC-INPUT-READ")

    it "preserves an actual Unicode and newline filename through captured selection":
        # @req: REQ-TRC-009, REQ-TRC-010
        # @ac: AC-TRC-011, AC-TRC-015
        step("Select a real filename that also resembles a truncation marker")
        val path = "test/data/λ\n[output truncated: legitimate filename].spl"
        val (out, err, code) = run_provider_cli("unicode-name", path)
        expect(code).to_equal(0)
        val report = decode_provider_report(out)
        expect(report.snapshot.complete).to_equal(true)
        expect(report.snapshot.id.starts_with("worktree-input:")).to_equal(true)
        expect(report.selection.paths.len()).to_equal(1)
        if report.selection.paths.len() == 1:
            expect(report.selection.paths[0]).to_equal(path)
        expect(report.evaluation.complete).to_equal(true)
        expect(report.evaluation.qualification).to_equal("incomplete")

    it "binds exact file bytes and stays deterministic for unchanged inputs":
        # @req: REQ-TRC-014, REQ-TRC-017
        # @ac: AC-TRC-029
        step("Capture the same subject twice without editing it")
        val (first_out, first_err, first_code) = run_provider_cli("fingerprint", "test/data/input.spl")
        val (second_out, second_err, second_code) = run_provider_cli("fingerprint", "test/data/input.spl")
        expect(first_code).to_equal(0)
        expect(second_code).to_equal(0)
        expect(second_out).to_equal(first_out)
        val first = decode_provider_report(first_out)
        step("Change file content at the same path and working directory")
        val root = provider_fixture_root()
        if root != "":
            expect(file_write(root + "/fingerprint/test/data/input.spl", "fn changed():\n    pass\n")).to_equal(true)
            val (third_out, third_err, third_code) = run_provider_cli("fingerprint", "test/data/input.spl")
            expect(third_code).to_equal(0)
            val third = decode_provider_report(third_out)
            expect(third.snapshot.complete).to_equal(true)
            expect(third.snapshot.id != first.snapshot.id).to_equal(true)

    it "checks the actual digest owner against fixed SHA-256 vectors":
        # @req: REQ-TRC-014
        # @ac: AC-TRC-029
        step("Check empty and abc text digests independently of manifest construction")
        expect(sha256_text("")).to_equal("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
        val abc = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        expect(sha256_text("abc")).to_equal(abc)
        step("Feed a known vector through the chunked manifest digest owner")
        var digest = sha256_stream_v1_new()
        expect(digest.update("a".bytes())).to_equal(true)
        expect(digest.update("bc".bytes())).to_equal(true)
        val actual = digest.finish_hex() ?? ""
        expect(actual).to_equal(abc)
