# @cover src/lib/common/traceability/graph_decode_v1.spl 80%
# @cover src/lib/common/traceability/graph_encode_v1.spl 80%
# @cover src/lib/common/traceability/graph_schema_v1.spl 80%
"""Graph-family contract acceptance: real typed payloads and precise refusals.
Component evidence for REQ-TRC-001/003/005/006/014/016, not full feature admission.
"""
use std.spec.*
use std.spec.step
use std.common.sdn.value.{SdnValue}
use std.common.sdn.encode.{sdn_encode_canonical, sdn_encoded_text_size_v1}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.traceability.types_v1.{TraceSnapshotV1}
use std.common.traceability.graph_types_v1.*
use std.common.traceability.graph_v1.{trace_graph_decode_v1, trace_graph_encode_v1, trace_graph_validate_v1}

fn graph_digest_v1() -> text:
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn graph_origin_v1(edge: text, identity: text) -> TraceGraphOriginV1:
    TraceGraphOriginV1(edge_id: edge, origin_kind: "explicit", origin_id: identity,
        declaration_path_available: true, declaration_path: "src/λ\nexample.spl",
        span_available: true, line: 2, column: 3, extractor_version: "extract/v1")

fn graph_fixture_v1() -> TraceGraphV1:
    TraceGraphV1(snapshot: TraceSnapshotV1(id: "snapshot:unit", kind: "worktree", complete: true),
        manifest: TraceGraphManifestV1(input_set_id: "input:unit", extractor_version: "extract/v1", rules_version: "rules/v1", policy_id: "policy:v1", complete: true),
        inputs: [TraceGraphInputV1(path: "src/λ\nexample.spl", sha256: graph_digest_v1(), bytes: 17, role: "source")],
        nodes: [TraceGraphNodeV1(id: "req:R", kind: "requirement", title: "λ, requirement"),
            TraceGraphNodeV1(id: "criterion:C", kind: "criterion", title: "Criterion"),
            TraceGraphNodeV1(id: "test:A", kind: "test_case", title: "Acceptance"),
            TraceGraphNodeV1(id: "test:P", kind: "parameterized_case", title: "Parameters"),
            TraceGraphNodeV1(id: "source:S", kind: "source_file", title: "Source")],
        test_definitions: [TraceGraphTestDefinitionV1(entity_id: "test:A", test_kind: "acceptance", identity_scope: "stable", definition_id: "test:A", parameter_digest_available: false, parameter_digest: ""),
            TraceGraphTestDefinitionV1(entity_id: "test:P", test_kind: "acceptance", identity_scope: "stable", definition_id: "test:A", parameter_digest_available: true, parameter_digest: graph_digest_v1())],
        edges: [TraceGraphEdgeV1(id: "edge:accept", from_id: "criterion:C", relation: "accepted_by", to_id: "test:P"),
            TraceGraphEdgeV1(id: "edge:target", from_id: "test:A", relation: "targets", to_id: "source:S")],
        edge_origins: [graph_origin_v1("edge:accept", "claim:one"), graph_origin_v1("edge:accept", "claim:two"), graph_origin_v1("edge:target", "claim:three")],
        locators: [TraceGraphLocatorV1(entity_id: "source:S", path_available: true, path: "src/λ\nexample.spl", locator_kind: "file", locator: ""),
            TraceGraphLocatorV1(entity_id: "test:A", path_available: true, path: "src/λ\nexample.spl", locator_kind: "scenario", locator: "it(\"λ, sample\")")])

fn graph_validation_code_v1(document: TraceGraphV1) -> text:
    match trace_graph_validate_v1(document, trace_graph_codec_limits_v1()):
        case Ok(_): "accepted"
        case Err(issue): issue.code

fn graph_encoded_v1(document: TraceGraphV1) -> text:
    var accepted = false
    var source = ""
    match trace_graph_encode_v1(document, trace_graph_codec_limits_v1()):
        case Ok(value):
            accepted = true
            source = value
        case Err(issue): print "Unexpected graph encode: {issue.code} at {issue.path}"
    expect(accepted).to_equal(true)
    source

fn graph_decoded_v1(source: text, limits: TraceGraphCodecLimitsV1) -> TraceGraphV1:
    var accepted = false
    var document = graph_fixture_v1()
    match trace_graph_decode_v1(source, limits):
        case Ok(value):
            accepted = true
            document = value
        case Err(issue): print "Unexpected graph decode: {issue.code} at {issue.path}"
    expect(accepted).to_equal(true)
    document

fn graph_decode_refusal_v1(source: text, code: text):
    var refused = false
    match trace_graph_decode_v1(source, trace_graph_codec_limits_v1()):
        case Ok(_): ()
        case Err(issue):
            refused = true
            expect(issue.code).to_equal(code)
    expect(refused).to_equal(true)

fn graph_encode_refusal_v1(document: TraceGraphV1, limits: TraceGraphCodecLimitsV1, code: text):
    var refused = false
    match trace_graph_encode_v1(document, limits):
        case Ok(_): ()
        case Err(issue):
            refused = true
            expect(issue.code).to_equal(code)
    expect(refused).to_equal(true)

fn graph_cycle_fixture_v1(relation: text) -> TraceGraphV1:
    var graph = graph_fixture_v1()
    graph.nodes = [TraceGraphNodeV1(id: "component:A", kind: "component", title: "A"), TraceGraphNodeV1(id: "component:B", kind: "component", title: "B")]
    graph.test_definitions = []
    graph.edges = [TraceGraphEdgeV1(id: "edge:A", from_id: "component:A", relation: relation, to_id: "component:B"),
        TraceGraphEdgeV1(id: "edge:B", from_id: "component:B", relation: relation, to_id: "component:A")]
    graph.edge_origins = [graph_origin_v1("edge:A", "claim:A"), graph_origin_v1("edge:B", "claim:B")]
    graph.locators = []
    graph

describe "Typed normalized graph codec acceptance":
    it "preserves all six typed collections, Unicode, counters and corroboration":
        # @req: REQ-TRC-001, REQ-TRC-003, REQ-TRC-005, REQ-TRC-016
        # @ac: AC-TRC-001, AC-TRC-005
        step("Round-trip named tables and inspect actual typed field payloads")
        val source = graph_encoded_v1(graph_fixture_v1())
        val graph = graph_decoded_v1(source, trace_graph_codec_limits_v1())
        expect(graph.snapshot.id).to_equal("snapshot:unit")
        expect(graph.manifest.policy_id).to_equal("policy:v1")
        expect(graph.inputs.len()).to_equal(1)
        expect(graph.inputs[0].bytes).to_equal(17)
        expect(graph.inputs[0].path).to_equal("src/λ\nexample.spl")
        expect(graph.inputs[0].sha256).to_equal(graph_digest_v1())
        expect(graph.inputs[0].role).to_equal("source")
        expect(graph.nodes.len()).to_equal(5)
        expect(graph.test_definitions.len()).to_equal(2)
        expect(graph.edges.len()).to_equal(2)
        expect(graph.edge_origins.len()).to_equal(3)
        expect(graph.locators.len()).to_equal(2)
        expect(source.contains("nodes |id, kind, title|\n")).to_equal(true)
        expect(source.contains("\"λ, requirement\"")).to_equal(true)
        var empty_file = false
        for item in graph.locators:
            if item.locator_kind == "file": empty_file = item.locator == ""
        expect(empty_file).to_equal(true)
        expect(source.ends_with("\n")).to_equal(true)
        var parameter_found = false
        for item in graph.test_definitions:
            if item.entity_id == "test:P":
                parameter_found = true
                expect(item.test_kind).to_equal("acceptance")
                expect(item.identity_scope).to_equal("stable")
                expect(item.definition_id).to_equal("test:A")
                expect(item.parameter_digest_available).to_equal(true)
                expect(item.parameter_digest).to_equal(graph_digest_v1())
        expect(parameter_found).to_equal(true)
        var edge_found = false
        for item in graph.edges:
            if item.id == "edge:accept":
                edge_found = true
                expect(item.from_id).to_equal("criterion:C")
                expect(item.relation).to_equal("accepted_by")
                expect(item.to_id).to_equal("test:P")
        expect(edge_found).to_equal(true)
        var origin_found = false
        for item in graph.edge_origins:
            if item.origin_id == "claim:two":
                origin_found = true
                expect(item.edge_id).to_equal("edge:accept")
                expect(item.origin_kind).to_equal("explicit")
                expect(item.declaration_path_available).to_equal(true)
                expect(item.declaration_path).to_equal("src/λ\nexample.spl")
                expect(item.span_available).to_equal(true)
                expect(item.line).to_equal(2)
                expect(item.column).to_equal(3)
                expect(item.extractor_version).to_equal("extract/v1")
        expect(origin_found).to_equal(true)
        var locator_found = false
        for item in graph.locators:
            if item.locator_kind == "scenario":
                locator_found = true
                expect(item.entity_id).to_equal("test:A")
                expect(item.path_available).to_equal(true)
                expect(item.path).to_equal("src/λ\nexample.spl")
                expect(item.locator).to_equal("it(\"λ, sample\")")
        expect(locator_found).to_equal(true)

    it "accepts reordered headers and rejects unknown fields and scalar coercion":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Decode columns by their exact names rather than positions")
        val source = graph_encoded_v1(graph_fixture_v1())
        val reordered = source.replace("inputs |path, sha256, bytes, role|", "inputs |sha256, path, role, bytes|").replace(
            "    \"src/λ\\nexample.spl\", " + graph_digest_v1() + ", 17, source", "    " + graph_digest_v1() + ", \"src/λ\\nexample.spl\", source, 17")
        expect(graph_decoded_v1(reordered, trace_graph_codec_limits_v1()).inputs[0].bytes).to_equal(17)
        graph_decode_refusal_v1(source + "experimental: true\n", "unknown_field")
        graph_decode_refusal_v1(source.replace("nodes |id, kind, title|", "nodes |id, kind, invented|"), "unknown_field")
        graph_decode_refusal_v1(source.replace(", 17, source", ", \"17\", source"), "wrong_type")
        graph_decode_refusal_v1(source.replace("simple.trace.graph", "simple.trace.receipt"), "unsupported_family")
        graph_decode_refusal_v1(source.replace("version: 1", "version: 2"), "schema_version")
        var deterministic = false
        match trace_graph_decode_v1(source + "zz: true\naa: true\n", trace_graph_codec_limits_v1()):
            case Err(issue): deterministic = issue.code == "unknown_field" and issue.path == "aa"
            case Ok(_): ()
        expect(deterministic).to_equal(true)

    it "rejects duplicate identities and normalized edge tuples":
        # @req: REQ-TRC-001, REQ-TRC-006
        # @ac: AC-TRC-002
        step("Preserve one node and one canonical endpoint relation")
        var graph = graph_fixture_v1()
        graph.nodes = [graph.nodes[0], graph.nodes[0]]
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_identifier")
        graph = graph_fixture_v1()
        graph.inputs = [graph.inputs[0], graph.inputs[0]]
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_identifier")
        graph = graph_fixture_v1()
        graph.edges = [graph.edges[0], TraceGraphEdgeV1(id: "edge:duplicate", from_id: "criterion:C", relation: "accepted_by", to_id: "test:P")]
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_edge")
        graph = graph_fixture_v1()
        graph.edge_origins = [graph.edge_origins[0], graph.edge_origins[0], graph.edge_origins[2]]
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_record")
        graph = graph_fixture_v1()
        graph.locators = [graph.locators[0], graph.locators[0]]
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_record")

    it "rejects dangling endpoints, origins and manifest locators":
        # @req: REQ-TRC-001, REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-002
        step("Resolve every reference without keeping a partial graph")
        val source = graph_encoded_v1(graph_fixture_v1())
        graph_decode_refusal_v1(source.replace("\"criterion:C\", accepted_by", "\"criterion:missing\", accepted_by"), "missing_reference")
        graph_decode_refusal_v1(source.replace("targets, \"source:S\"", "targets, \"source:missing\""), "missing_reference")
        graph_decode_refusal_v1(source.replace("\"edge:accept\", explicit", "\"edge:missing\", explicit"), "missing_reference")
        var graph = graph_fixture_v1()
        graph.inputs = []
        expect(graph_validation_code_v1(graph)).to_equal("missing_reference")
        graph = graph_fixture_v1()
        graph.edge_origins = []
        expect(graph_validation_code_v1(graph)).to_equal("missing_origin")

    it "keeps acceptance, supporting verification and parameter identities distinct":
        # @req: REQ-TRC-003, REQ-TRC-006
        # @ac: AC-TRC-005, AC-TRC-006
        step("Check declared roles rather than treating all test definitions alike")
        val source = graph_encoded_v1(graph_fixture_v1())
        graph_decode_refusal_v1(source.replace("acceptance, stable", "unit, stable"), "invalid_relation")
        graph_decode_refusal_v1(source.replace("accepted_by", "verified_by"), "invalid_relation")
        expect(graph_decoded_v1(source.replace("accepted_by", "verified_by").replace("acceptance, stable", "unit, stable"), trace_graph_codec_limits_v1()).test_definitions.len()).to_equal(2)
        var graph = graph_fixture_v1()
        graph.test_definitions = [graph.test_definitions[0]]
        expect(graph_validation_code_v1(graph)).to_equal("missing_reference")
        graph = graph_fixture_v1()
        graph.test_definitions = [graph.test_definitions[0], TraceGraphTestDefinitionV1(entity_id: "test:P", test_kind: "acceptance", identity_scope: "revision", definition_id: "test:A", parameter_digest_available: true, parameter_digest: graph_digest_v1())]
        expect(graph_validation_code_v1(graph)).to_equal("invalid_definition")

    it "uses base definition plus digest rather than globally unique digest":
        # @req: REQ-TRC-003, REQ-TRC-006
        # @ac: AC-TRC-006
        step("Two ordinary definitions may use the same canonical parameter set")
        var graph = graph_fixture_v1()
        graph.nodes.push(TraceGraphNodeV1(id: "test:B", kind: "test_case", title: "Second base"))
        graph.nodes.push(TraceGraphNodeV1(id: "test:Q", kind: "parameterized_case", title: "Second parameters"))
        graph.test_definitions.push(TraceGraphTestDefinitionV1(entity_id: "test:B", test_kind: "acceptance", identity_scope: "stable", definition_id: "test:B", parameter_digest_available: false, parameter_digest: ""))
        graph.test_definitions.push(TraceGraphTestDefinitionV1(entity_id: "test:Q", test_kind: "acceptance", identity_scope: "stable", definition_id: "test:B", parameter_digest_available: true, parameter_digest: graph_digest_v1()))
        expect(graph_validation_code_v1(graph)).to_equal("accepted")
        graph.test_definitions[3] = TraceGraphTestDefinitionV1(entity_id: "test:Q", test_kind: "acceptance", identity_scope: "stable", definition_id: "test:A", parameter_digest_available: true, parameter_digest: graph_digest_v1())
        expect(graph_validation_code_v1(graph)).to_equal("duplicate_parameter")

    it "rejects containment and alias cycles while permitting dependency cycles":
        # @req: REQ-TRC-006, REQ-TRC-016
        # @ac: AC-TRC-009
        step("Apply cycle policy to the relation rather than the entire graph")
        expect(graph_validation_code_v1(graph_cycle_fixture_v1("belongs_to"))).to_equal("cyclic_relation")
        expect(graph_validation_code_v1(graph_cycle_fixture_v1("aliases"))).to_equal("cyclic_relation")
        val source = graph_encoded_v1(graph_cycle_fixture_v1("depends_on"))
        expect(graph_decoded_v1(source, trace_graph_codec_limits_v1()).edges.len()).to_equal(2)
        var graph = graph_cycle_fixture_v1("aliases")
        graph.edges = [graph.edges[0], TraceGraphEdgeV1(id: "edge:B", from_id: "component:A", relation: "aliases", to_id: "component:A")]
        expect(graph_validation_code_v1(graph)).to_equal("alias_conflict")

    it "checks CAS and source-span availability without fabricating locations":
        # @req: REQ-TRC-001, REQ-TRC-005
        # @ac: AC-TRC-002
        step("Keep absent paths and coordinates separate from claimed provenance")
        var graph = graph_fixture_v1()
        graph.locators = [TraceGraphLocatorV1(entity_id: "source:S", path_available: false, path: "", locator_kind: "cas", locator: "sha256:" + graph_digest_v1())]
        expect(graph_decoded_v1(graph_encoded_v1(graph), trace_graph_codec_limits_v1()).locators[0].path_available).to_equal(false)
        graph.locators = [TraceGraphLocatorV1(entity_id: "source:S", path_available: true, path: "src/λ\nexample.spl", locator_kind: "cas", locator: "sha256:" + graph_digest_v1())]
        expect(graph_validation_code_v1(graph)).to_equal("invalid_location")
        graph = graph_fixture_v1()
        graph.edge_origins[0] = TraceGraphOriginV1(edge_id: "edge:accept", origin_kind: "explicit", origin_id: "claim:one", declaration_path_available: false, declaration_path: "", span_available: false, line: 1, column: 0, extractor_version: "extract/v1")
        expect(graph_validation_code_v1(graph)).to_equal("invalid_location")

    it "encodes deterministically across permutations of every collection":
        # @req: REQ-TRC-014
        # @ac: AC-TRC-025
        step("Compare complete byte output instead of boxed graph equality")
        var original = graph_fixture_v1()
        var permuted = graph_fixture_v1()
        val extra = TraceGraphInputV1(path: "doc/z.sdn", sha256: graph_digest_v1(), bytes: 9, role: "document")
        original.inputs.push(extra)
        permuted.inputs = [extra, original.inputs[0]]
        permuted.nodes = [original.nodes[4], original.nodes[3], original.nodes[2], original.nodes[1], original.nodes[0]]
        permuted.test_definitions = [original.test_definitions[1], original.test_definitions[0]]
        permuted.edges = [original.edges[1], original.edges[0]]
        permuted.edge_origins = [original.edge_origins[2], original.edge_origins[1], original.edge_origins[0]]
        permuted.locators = [original.locators[1], original.locators[0]]
        expect(graph_encoded_v1(permuted)).to_equal(graph_encoded_v1(original))

    it "uses exact shared scalar sizes including Unicode and escape characters":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Verify the bounded writer size before escaped allocation")
        for text_value in ["", "null", "true", "1", "1.5", "-12", "λ", "x\\\"\n\t\r", "safe/path.spl", "identity:one"]:
            expect(sdn_encoded_text_size_v1(text_value)).to_equal(sdn_encode_canonical(SdnValue.String(text_value)).len())

    it "enforces exact strict counts on the producer before materialization":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Use one semantic resource contract on encoding and strict decoding")
        val graph = graph_fixture_v1()
        val source = graph_encoded_v1(graph)
        var node_count = 0
        var row_count = 0
        var cell_count = 0
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(value):
                node_count = value.nodes
                row_count = value.rows
                cell_count = value.cells
            case Err(_): ()
        expect(node_count).to_equal(146)
        expect(row_count).to_equal(15)
        expect(cell_count).to_equal(76)
        var limits = trace_graph_codec_limits_v1()
        limits.sdn = SdnStrictLimitsV1(max_nodes: node_count, max_rows: row_count, max_cells: cell_count, max_depth: 3, max_columns: 9)
        var produced = false
        match trace_graph_encode_v1(graph, limits):
            case Ok(value):
                produced = true
                expect(graph_decoded_v1(value, limits).nodes.len()).to_equal(5)
            case Err(_): ()
        expect(produced).to_equal(true)
        limits.sdn.max_nodes = node_count - 1
        graph_encode_refusal_v1(graph, limits, "node_limit")
        limits = trace_graph_codec_limits_v1()
        limits.sdn.max_rows = row_count - 1
        graph_encode_refusal_v1(graph, limits, "row_limit")
        limits = trace_graph_codec_limits_v1()
        limits.sdn.max_cells = cell_count - 1
        graph_encode_refusal_v1(graph, limits, "cell_limit")
        limits = trace_graph_codec_limits_v1()
        limits.sdn.max_depth = 2
        graph_encode_refusal_v1(graph, limits, "depth_limit")
        limits = trace_graph_codec_limits_v1()
        limits.sdn.max_columns = 8
        graph_encode_refusal_v1(graph, limits, "column_limit")
        var empty = graph_fixture_v1()
        empty.inputs = []
        empty.nodes = []
        empty.test_definitions = []
        empty.edges = []
        empty.edge_origins = []
        empty.locators = []
        limits = trace_graph_codec_limits_v1()
        limits.max_records = 0
        limits.sdn = SdnStrictLimitsV1(max_nodes: 70, max_rows: 0, max_cells: 0, max_depth: 3, max_columns: 9)
        var empty_encoded = false
        match trace_graph_encode_v1(empty, limits):
            case Ok(value):
                empty_encoded = true
                expect(graph_decoded_v1(value, limits).nodes.len()).to_equal(0)
            case Err(_): ()
        expect(empty_encoded).to_equal(true)

    it "bounds output by the same input limit including final LF":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Admit exact-size roundtrip and reject one fewer byte")
        val graph = graph_fixture_v1()
        val source = graph_encoded_v1(graph)
        var limits = trace_graph_codec_limits_v1()
        limits.max_output_bytes = source.len()
        limits.sdn.max_source_bytes = source.len()
        var exact = false
        match trace_graph_encode_v1(graph, limits):
            case Ok(value):
                exact = value == source
                expect(graph_decoded_v1(value, limits).inputs[0].bytes).to_equal(17)
            case Err(_): ()
        expect(exact).to_equal(true)
        limits.sdn.max_source_bytes = source.len() - 1
        graph_encode_refusal_v1(graph, limits, "output_limit")
        limits = trace_graph_codec_limits_v1()
        limits.max_output_bytes = source.len() - 1
        graph_encode_refusal_v1(graph, limits, "output_limit")
        limits.max_output_bytes = 0
        graph_encode_refusal_v1(graph, limits, "output_limit")

    it "preflights typed record, text, field and hard-limit bounds":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Reject configured exhaustion without constructing canonical sort keys")
        val graph = graph_fixture_v1()
        var limits = trace_graph_codec_limits_v1()
        limits.max_records = 14
        graph_encode_refusal_v1(graph, limits, "record_limit")
        limits = trace_graph_codec_limits_v1()
        limits.max_text_bytes = 1
        graph_encode_refusal_v1(graph, limits, "text_limit")
        limits = trace_graph_codec_limits_v1()
        limits.max_field_bytes = 1
        graph_encode_refusal_v1(graph, limits, "field_limit")
        limits = trace_graph_codec_limits_v1()
        limits.max_records = 1000001
        graph_encode_refusal_v1(graph, limits, "invalid_limits")

    it "rejects contradictory complete manifests and unsafe path/digest data":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Validate data shape without claiming its capture or artifact trust")
        var graph = graph_fixture_v1()
        graph.manifest.complete = false
        expect(graph_validation_code_v1(graph)).to_equal("inconsistent_result")
        graph = graph_fixture_v1()
        graph.inputs[0] = TraceGraphInputV1(path: "src/../outside.spl", sha256: graph_digest_v1(), bytes: 17, role: "source")
        expect(graph_validation_code_v1(graph)).to_equal("invalid_path")
        graph.inputs[0] = TraceGraphInputV1(path: "src/example.spl", sha256: "ABC", bytes: 17, role: "source")
        expect(graph_validation_code_v1(graph)).to_equal("invalid_digest")
