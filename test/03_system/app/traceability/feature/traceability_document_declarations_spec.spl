# @cover src/lib/common/sdn/value.spl 80%
# @cover src/lib/common/traceability/encode_v1.spl 80%
# @cover src/lib/common/sdn/strict_types_v1.spl 80%
"""Actual family payloads, authored conflicts and bounded constructed adapters."""
use std.spec.*
use std.spec.step
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_types_v1.{SdnStrictLimitsV1, sdn_strict_limits_v1}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.traceability.document_types_v1.*
use std.common.traceability.declarations_types_v1.*
use std.common.traceability.declarations_v1.*
use std.common.traceability.graph_types_v1.{trace_graph_codec_limits_v1}
use std.common.traceability.graph_v1.{trace_graph_from_value_v1}
use std.common.traceability.qualification_types_v1.{trace_qualification_codec_limits_v1}
use std.common.traceability.qualification_v1.{trace_qualification_from_value_v1}
use std.common.traceability.encode_v1.{trace_document_decode_v1, trace_document_encode_v1}

fn declaration_fixture_v1() -> TraceDeclarationsV1:
    TraceDeclarationsV1(id: "declarations:one", namespace: "project/simple",
        claims: [TraceClaimV1(id: "claim:A", from_id: "req:R", relation: "implemented_by", to_id: "source:A", origin_id: "origin:A"),
            TraceClaimV1(id: "claim:B", from_id: "req:R", relation: "implemented_by", to_id: "source:B", origin_id: "origin:B")],
        aliases: [TraceAliasDeclarationV1(id: "alias:A", from_id: "feature:old", to_id: "feature:A", origin_id: "origin:A"),
            TraceAliasDeclarationV1(id: "alias:B", from_id: "feature:old", to_id: "feature:B", origin_id: "origin:B")],
        exceptions: [TraceExceptionDeclarationV1(id: "exception:A", scope_kind: "requirement", subject_id: "req:R", rule_id: "rule:coverage",
                reason: "λ, reviewed intent", owner: "owner:one", review_state: "reviewed", expires_available: true, expires_at: "2028-02-29T23:59:59Z", origin_id: "origin:A"),
            TraceExceptionDeclarationV1(id: "exception:B", scope_kind: "input_path", subject_id: "src/λ\ninput.spl", rule_id: "rule:scope", reason: "Pending review",
                owner: "owner:two", review_state: "proposed", expires_available: false, expires_at: "", origin_id: "origin:B")],
        origins: [TraceDeclarationOriginV1(id: "origin:A", origin_kind: "explicit", path: "doc/λ\nintent.sdn", span_available: true, line: 4, column: 5, extractor_version: "extract/v1"),
            TraceDeclarationOriginV1(id: "origin:B", origin_kind: "annotation", path: "src/input.spl", span_available: false, line: 0, column: 0, extractor_version: "extract/v1")])

fn declaration_source_v1(document: TraceDeclarationsV1) -> text:
    var accepted = false
    var source = ""
    match trace_declarations_encode_v1(document, trace_declarations_codec_limits_v1()):
        case Ok(value):
            accepted = true
            source = value
        case Err(issue): print "Unexpected declaration encode: {issue.code} {issue.path}"
    expect(accepted).to_equal(true)
    source

fn declaration_decoded_v1(source: text, limits: TraceDeclarationsCodecLimitsV1) -> TraceDeclarationsV1:
    var accepted = false
    var document = declaration_fixture_v1()
    match trace_declarations_decode_v1(source, limits):
        case Ok(value):
            accepted = true
            document = value
        case Err(issue): print "Unexpected declaration decode: {issue.code} {issue.path}"
    expect(accepted).to_equal(true)
    document

fn declaration_raw_v1(source: text) -> SdnValue:
    var accepted = false
    var value = SdnValue.Null
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(parsed):
            accepted = true
            value = parsed.value
        case Err(_): ()
    expect(accepted).to_equal(true)
    value

fn declaration_fields_v1() -> Dict<text, SdnValue>:
    var fields: Dict<text, SdnValue> = {}
    match declaration_raw_v1(declaration_source_v1(declaration_fixture_v1())):
        case Dict(value): fields = value
        case _: ()
    fields

fn declaration_raw_refusal_v1(value: SdnValue, limits: TraceDeclarationsCodecLimitsV1, code: text):
    var refused = false
    match trace_declarations_from_value_v1(value, limits):
        case Ok(_): ()
        case Err(issue):
            refused = true
            expect(issue.code).to_equal(code)
            expect(issue.location_available).to_equal(false)
            expect(issue.line).to_equal(0)
    expect(refused).to_equal(true)

fn declaration_encode_refusal_v1(document: TraceDeclarationsV1, limits: TraceDeclarationsCodecLimitsV1, code: text):
    var refused = false
    match trace_declarations_encode_v1(document, limits):
        case Ok(_): ()
        case Err(issue):
            refused = true
            expect(issue.code).to_equal(code)
    expect(refused).to_equal(true)

fn declaration_validation_code_v1(document: TraceDeclarationsV1) -> text:
    match trace_declarations_validate_v1(document, trace_declarations_codec_limits_v1()):
        case Ok(_): "accepted"
        case Err(issue): issue.code

fn generic_qualification_source_v1() -> text:
    "schema: {name: simple.trace.qualification, version: 1}\nsnapshot: {id: \"snapshot:one\", kind: index, complete: true}\n" +
    "selection: {paths: [], full_repository: true}\nevaluation: {scope: all, profile: commit, kind: structural, complete: true, exit_code: 0, qualification: incomplete}\ndiagnostics: []\n"

fn generic_graph_source_v1() -> text:
    "schema: {name: simple.trace.graph, version: 1}\nsnapshot: {id: \"snapshot:one\", kind: index, complete: true}\n" +
    "manifest: {input_set_id: \"input:one\", extractor_version: extract/v1, rules_version: rules/v1, policy_id: \"policy:one\", complete: true}\n" +
    "inputs |path, sha256, bytes, role|\nnodes |id, kind, title|\n" +
    "test_definitions |entity_id, test_kind, identity_scope, definition_id, parameter_digest_available, parameter_digest|\n" +
    "edges |id, from_id, relation, to_id|\nedge_origins |edge_id, origin_kind, origin_id, declaration_path_available, declaration_path, span_available, line, column, extractor_version|\n" +
    "locators |entity_id, path_available, path, locator_kind, locator|\n"

describe "Document dispatch and authored declarations acceptance":
    it "dispatches and canonically encodes actual payloads of all three supported variants":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        step("Read typed family payloads instead of constructing empty qualification summaries")
        val sources = [generic_qualification_source_v1(), generic_graph_source_v1(), declaration_source_v1(declaration_fixture_v1())]
        var index = 0
        for source in sources:
            var accepted = false
            match trace_document_decode_v1(source, trace_document_codec_limits_v1()):
                case Ok(document):
                    match document:
                        case Qualification(value):
                            accepted = index == 0
                            expect(value.snapshot.kind).to_equal("index")
                            expect(value.evaluation.qualification).to_equal("incomplete")
                        case Graph(value):
                            accepted = index == 1
                            expect(value.manifest.policy_id).to_equal("policy:one")
                            expect(value.nodes.len()).to_equal(0)
                        case Declarations(value):
                            accepted = index == 2
                            expect(value.namespace).to_equal("project/simple")
                            expect(value.claims.len()).to_equal(2)
                    var encoded = false
                    match trace_document_encode_v1(document, trace_document_codec_limits_v1()):
                        case Ok(output):
                            encoded = output.ends_with("\n")
                            var reread = false
                            match trace_document_decode_v1(output, trace_document_codec_limits_v1()):
                                case Ok(_): reread = true
                                case Err(_): ()
                            expect(reread).to_equal(true)
                        case Err(_): ()
                    expect(encoded).to_equal(true)
                case Err(issue): print "Unexpected generic dispatch: {issue.code}"
            expect(accepted).to_equal(true)
            index = index + 1

    it "preserves many-to-many and conflicting claims and aliases for the resolver":
        # @req: REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-007, AC-TRC-008
        step("Keep contradictory authored targets with both attributable origins")
        val document = declaration_decoded_v1(declaration_source_v1(declaration_fixture_v1()), trace_declarations_codec_limits_v1())
        expect(document.id).to_equal("declarations:one")
        expect(document.claims.len()).to_equal(2)
        expect(document.claims[0].from_id).to_equal("req:R")
        expect(document.claims[0].to_id).to_equal("source:A")
        expect(document.claims[0].relation).to_equal("implemented_by")
        expect(document.claims[0].origin_id).to_equal("origin:A")
        expect(document.claims[1].to_id).to_equal("source:B")
        expect(document.aliases.len()).to_equal(2)
        expect(document.aliases[0].from_id).to_equal("feature:old")
        expect(document.aliases[0].to_id).to_equal("feature:A")
        expect(document.aliases[1].to_id).to_equal("feature:B")
        expect(document.origins[0].path).to_equal("doc/λ\nintent.sdn")
        expect(document.origins[0].span_available).to_equal(true)
        expect(document.origins[0].line).to_equal(4)
        expect(document.origins[0].column).to_equal(5)
        expect(document.origins[1].origin_kind).to_equal("annotation")
        expect(document.origins[1].span_available).to_equal(false)

    it "preserves exception review and availability as untrusted authored facts":
        # @req: REQ-TRC-019
        # @ac: AC-TRC-030
        step("Represent review, owner, reason and expiry without granting applicability")
        val document = declaration_decoded_v1(declaration_source_v1(declaration_fixture_v1()), trace_declarations_codec_limits_v1())
        expect(document.exceptions[0].review_state).to_equal("reviewed")
        expect(document.exceptions[0].owner).to_equal("owner:one")
        expect(document.exceptions[0].reason).to_equal("λ, reviewed intent")
        expect(document.exceptions[0].expires_at).to_equal("2028-02-29T23:59:59Z")
        expect(document.exceptions[1].review_state).to_equal("proposed")
        expect(document.exceptions[1].subject_id).to_equal("src/λ\ninput.spl")
        expect(document.exceptions[1].expires_available).to_equal(false)
        expect(document.exceptions[1].expires_at).to_equal("")

    it "validates real UTC calendar dates and expiry availability":
        # @req: REQ-TRC-001, REQ-TRC-019
        # @ac: AC-TRC-002, AC-TRC-030
        step("Reject malformed expiry data without consulting or inventing the current time")
        var document = declaration_fixture_v1()
        for timestamp in ["2026-02-29T00:00:00Z", "1900-02-29T00:00:00Z", "2028-04-31T00:00:00Z", "0000-01-01T00:00:00Z", "2028-01-01T24:00:00Z", "2028-01-01T00:00:60Z", "2028-01-01T00:00:00+00:00"]:
            document.exceptions[0].expires_at = timestamp
            expect(declaration_validation_code_v1(document)).to_equal("invalid_expiry")
        document.exceptions[0].expires_at = "2000-02-29T00:00:00Z"
        expect(declaration_validation_code_v1(document)).to_equal("accepted")
        document.exceptions[0].expires_available = false
        expect(declaration_validation_code_v1(document)).to_equal("invalid_expiry")

    it "rejects duplicate identities, missing origins and invalid fields":
        # @req: REQ-TRC-001, REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-002
        step("Validate attributable claim data without silently dropping a bad member")
        var document = declaration_fixture_v1()
        document.claims[1].id = document.claims[0].id
        expect(declaration_validation_code_v1(document)).to_equal("duplicate_identifier")
        document = declaration_fixture_v1()
        document.aliases[1].id = document.aliases[0].id
        expect(declaration_validation_code_v1(document)).to_equal("duplicate_identifier")
        document = declaration_fixture_v1()
        document.exceptions[1].id = document.exceptions[0].id
        expect(declaration_validation_code_v1(document)).to_equal("duplicate_identifier")
        document = declaration_fixture_v1()
        document.origins[1].id = document.origins[0].id
        expect(declaration_validation_code_v1(document)).to_equal("duplicate_identifier")
        document = declaration_fixture_v1()
        document.claims[1].origin_id = "origin:missing"
        expect(declaration_validation_code_v1(document)).to_equal("missing_reference")
        document = declaration_fixture_v1()
        document.claims[0].relation = "aliases"
        expect(declaration_validation_code_v1(document)).to_equal("invalid_enum")
        document = declaration_fixture_v1()
        document.exceptions[0].reason = ""
        expect(declaration_validation_code_v1(document)).to_equal("empty_text")
        document = declaration_fixture_v1()
        document.origins[0].path = "../outside.sdn"
        expect(declaration_validation_code_v1(document)).to_equal("invalid_path")

    it "canonicalizes all four collection permutations by complete records":
        # @req: REQ-TRC-014
        # @ac: AC-TRC-025
        step("Compare full emitted bytes without boxed record equality")
        val original = declaration_fixture_v1()
        var permuted = declaration_fixture_v1()
        permuted.claims = [original.claims[1], original.claims[0]]
        permuted.aliases = [original.aliases[1], original.aliases[0]]
        permuted.exceptions = [original.exceptions[1], original.exceptions[0]]
        permuted.origins = [original.origins[1], original.origins[0]]
        expect(declaration_source_v1(permuted)).to_equal(declaration_source_v1(original))

    it "round-trips at exact strict and output limits including empty tables":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Use the same count and byte contracts on both sides of the writer")
        val document = declaration_fixture_v1()
        val source = declaration_source_v1(document)
        var nodes = 0
        var rows = 0
        var cells = 0
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(parsed):
                nodes = parsed.nodes
                rows = parsed.rows
                cells = parsed.cells
            case Err(_): ()
        expect(nodes).to_equal(97)
        expect(rows).to_equal(8)
        expect(cells).to_equal(52)
        var limits = trace_declarations_codec_limits_v1()
        limits.sdn = SdnStrictLimitsV1(max_source_bytes: source.len(), max_nodes: 97, max_rows: 8, max_cells: 52, max_depth: 3, max_columns: 10)
        limits.max_output_bytes = source.len()
        var exact = false
        match trace_declarations_encode_v1(document, limits):
            case Ok(output):
                exact = output == source
                expect(declaration_decoded_v1(output, limits).origins.len()).to_equal(2)
            case Err(_): ()
        expect(exact).to_equal(true)
        limits.sdn.max_source_bytes = source.len() - 1
        declaration_encode_refusal_v1(document, limits, "output_limit")
        var empty = declaration_fixture_v1()
        empty.claims = []
        empty.aliases = []
        empty.exceptions = []
        empty.origins = []
        limits = trace_declarations_codec_limits_v1()
        limits.max_records = 0
        limits.sdn = SdnStrictLimitsV1(max_nodes: 45, max_rows: 0, max_cells: 0, max_depth: 3, max_columns: 10)
        var empty_accepted = false
        match trace_declarations_encode_v1(empty, limits):
            case Ok(output):
                empty_accepted = true
                expect(declaration_decoded_v1(output, limits).claims.len()).to_equal(0)
            case Err(_): ()
        expect(empty_accepted).to_equal(true)

    it "preflights producer text, field, record, output and hard budgets":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Reject exhaustion before indexes, rows or canonical escaped keys")
        val document = declaration_fixture_v1()
        var limits = trace_declarations_codec_limits_v1()
        limits.max_records = 7
        declaration_encode_refusal_v1(document, limits, "record_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_text_bytes = 1
        declaration_encode_refusal_v1(document, limits, "text_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_field_bytes = 1
        declaration_encode_refusal_v1(document, limits, "field_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_output_bytes = 0
        declaration_encode_refusal_v1(document, limits, "output_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_records = 1000001
        declaration_encode_refusal_v1(document, limits, "invalid_limits")

    it "enforces constructed-value row, cell, node, column and nesting limits":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Call the public raw adapter independently of the strict text dispatcher")
        val raw = declaration_raw_v1(declaration_source_v1(declaration_fixture_v1()))
        var limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_rows = 7
        declaration_raw_refusal_v1(raw, limits, "row_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_cells = 51
        declaration_raw_refusal_v1(raw, limits, "cell_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_nodes = 96
        declaration_raw_refusal_v1(raw, limits, "node_limit")
        var fields = declaration_fields_v1()
        fields["claims"] = SdnValue.Table(["x"; 11], [])
        limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_columns = 10
        declaration_raw_refusal_v1(SdnValue.Dict(fields), limits, "column_limit")
        fields = declaration_fields_v1()
        fields["id"] = SdnValue.Array([SdnValue.Array([SdnValue.Int(1)])])
        limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_depth = 3
        declaration_raw_refusal_v1(SdnValue.Dict(fields), limits, "depth_limit")

    it "rejects malformed raw headers, nested field types and record exhaustion":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Do not trust caller-constructed SDN tables or coerce their cells")
        var fields = declaration_fields_v1()
        fields["claims"] = SdnValue.Table(["id", "id", "relation", "to_id", "origin_id"], [])
        declaration_raw_refusal_v1(SdnValue.Dict(fields), trace_declarations_codec_limits_v1(), "duplicate_field")
        fields = declaration_fields_v1()
        fields["id"] = SdnValue.Array([SdnValue.Int(1)])
        declaration_raw_refusal_v1(SdnValue.Dict(fields), trace_declarations_codec_limits_v1(), "wrong_type")
        var limits = trace_declarations_codec_limits_v1()
        limits.max_records = 7
        declaration_raw_refusal_v1(declaration_raw_v1(declaration_source_v1(declaration_fixture_v1())), limits, "record_limit")

    it "renews independent raw bounds for graph and qualification adapters":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Verify public adapters remain bounded when called without source parsing")
        var graph_limits = trace_graph_codec_limits_v1()
        graph_limits.sdn.max_nodes = 69
        var graph_refused = false
        match trace_graph_from_value_v1(declaration_raw_v1(generic_graph_source_v1()), graph_limits):
            case Err(issue): graph_refused = issue.code == "node_limit" and not issue.location_available
            case Ok(_): ()
        expect(graph_refused).to_equal(true)
        var qualification_limits = trace_qualification_codec_limits_v1()
        qualification_limits.sdn.max_nodes = 36
        var qualification_refused = false
        match trace_qualification_from_value_v1(declaration_raw_v1(generic_qualification_source_v1()), qualification_limits):
            case Err(issue): qualification_refused = issue.code == "node_limit" and not issue.location_available
            case Ok(_): ()
        expect(qualification_refused).to_equal(true)

    it "rejects pending families, unknown majors, unknown fields and common quotas":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Keep the supported family union closed without dummy adapters")
        val source = declaration_source_v1(declaration_fixture_v1())
        for family in ["simple.trace.policy", "simple.trace.run", "simple.trace.receipt", "simple.slop.message", "simple.slop.preferences"]:
            var refused = false
            match trace_document_decode_v1(source.replace("simple.trace.declarations", family), trace_document_codec_limits_v1()):
                case Err(issue): refused = issue.code == "unsupported_family"
                case Ok(_): ()
            expect(refused).to_equal(true)
        var major_refused = false
        match trace_document_decode_v1(source.replace("version: 1", "version: 3"), trace_document_codec_limits_v1()):
            case Err(issue): major_refused = issue.code == "schema_version"
            case Ok(_): ()
        expect(major_refused).to_equal(true)
        var unknown_refused = false
        match trace_document_decode_v1(source + "zz: true\naa: true\n", trace_document_codec_limits_v1()):
            case Err(issue): unknown_refused = issue.code == "unknown_field" and issue.path == "aa"
            case Ok(_): ()
        expect(unknown_refused).to_equal(true)
        var limits = trace_document_codec_limits_v1()
        limits.max_table_records = 7
        var quota_refused = false
        match trace_document_decode_v1(source, limits):
            case Err(issue): quota_refused = issue.code == "record_limit"
            case Ok(_): ()
        expect(quota_refused).to_equal(true)

    it "bounds raw key text before diagnostics in all public family adapters":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Accept controls then refuse injected oversized keys before diagnostic paths")
        var key = "abcdefghijklmnopqrstuvwxyz0123456789"
        for index in 0..7: key = key + key
        expect(key.len()).to_equal(4608)
        var fields = declaration_fields_v1()
        var declaration_limits = trace_declarations_codec_limits_v1()
        declaration_limits.sdn.max_source_bytes = 2048
        var declaration_control = false
        match trace_declarations_from_value_v1(SdnValue.Dict(fields), declaration_limits):
            case Ok(_): declaration_control = true
            case Err(_): ()
        expect(declaration_control).to_equal(true)
        fields[key] = SdnValue.Int(1)
        declaration_raw_refusal_v1(SdnValue.Dict(fields), declaration_limits, "text_limit")
        var graph_fields: Dict<text, SdnValue> = {}
        match declaration_raw_v1(generic_graph_source_v1()):
            case Dict(value): graph_fields = value
            case _: ()
        var graph_limits = trace_graph_codec_limits_v1()
        graph_limits.sdn.max_source_bytes = 2048
        var graph_control = false
        match trace_graph_from_value_v1(SdnValue.Dict(graph_fields), graph_limits):
            case Ok(_): graph_control = true
            case Err(_): ()
        expect(graph_control).to_equal(true)
        graph_fields[key] = SdnValue.Int(1)
        var graph_refused = false
        match trace_graph_from_value_v1(SdnValue.Dict(graph_fields), graph_limits):
            case Err(issue): graph_refused = issue.code == "text_limit" and not issue.location_available
            case Ok(_): ()
        expect(graph_refused).to_equal(true)
        var qualification_fields: Dict<text, SdnValue> = {}
        match declaration_raw_v1(generic_qualification_source_v1()):
            case Dict(value): qualification_fields = value
            case _: ()
        var qualification_limits = trace_qualification_codec_limits_v1()
        qualification_limits.sdn.max_source_bytes = 2048
        var qualification_control = false
        match trace_qualification_from_value_v1(SdnValue.Dict(qualification_fields), qualification_limits):
            case Ok(_): qualification_control = true
            case Err(_): ()
        expect(qualification_control).to_equal(true)
        qualification_fields[key] = SdnValue.Int(1)
        var qualification_refused = false
        match trace_qualification_from_value_v1(SdnValue.Dict(qualification_fields), qualification_limits):
            case Err(issue): qualification_refused = issue.code == "text_limit" and not issue.location_available
            case Ok(_): ()
        expect(qualification_refused).to_equal(true)
