# @cover src/lib/common/traceability/envelope_types_v1.spl 80%
# @cover src/lib/common/traceability/qualification_types_v1.spl 80%
# @cover src/app/io/minimal_runtime_ops.spl 80%
"""
# Read an SDN traceability verdict

Purpose: use the production traceability CLI to inspect an empty, tracked
fixture and reject obsolete or malformed options.
Audience: developers integrating the shared trace graph with everyday commands.

The qualification harness supplies SIMPLE_TRACE_TEST_BINARY as an admitted
general-tool runtime with validated source/producer receipts, or the explicitly
user-authorized Phase2-derived CLI with its actual stage recorded. A missing
selection fails; no Rust-seed substitution is permitted. These CLI contracts
cover SDN and input handling only. Graph, execution evidence, hooks and Slop
have additional acceptance cases in the complete test plan.

Requirements: doc/02_requirements/feature/traceability_sdn_slop.md
Plan: doc/03_plan/sys_test/traceability_sdn_slop.md
Architecture: doc/04_architecture/infra/traceability.md
Design: doc/05_design/infra/traceability_graph.md
"""

use std.spec.*
use std.spec.step
use app.io.minimal_runtime_ops.{env_get, cwd, process_run_timeout}
use std.nogc_sync_mut.io.dir_ops.{is_dir}
use std.common.traceability.types_v1.{TraceQualificationV1, TraceSnapshotV1,
    TraceSelectionV1, TraceEvaluationV1, trace_qualification_codec_limits_v1}
use std.common.traceability.qualification_v1.{trace_qualification_decode_v1, trace_qualification_encode_v1}

val EMPTY_TRACE_FIXTURE = "test/fixtures/traceability_sdn/empty"

fn run_trace_cli(options: [text]) -> (text, text, i32):
    val binary = env_get("SIMPLE_TRACE_TEST_BINARY")
    # The external harness admits the binary and binds source/producer receipts.
    # This assertion prevents a missing selection from silently finding a seed.
    expect(binary != "").to_equal(true)
    if binary == "":
        return ("", "traceability test runtime selection missing", 2)
    val root = env_get("SIMPLE_TRACE_TEST_ROOT")
    val fixture_valid = root != "" and cwd() == root and is_dir(EMPTY_TRACE_FIXTURE)
    expect(fixture_valid).to_equal(true)
    if not fixture_valid:
        return ("", "traceability test fixture scope invalid", 2)
    val entry_kind = env_get("SIMPLE_TRACE_TEST_ENTRY_KIND")
    val command_args = if entry_kind == "full-cli": ["traceability-check"] + options else: options
    val entry_valid = entry_kind == "full-cli" or entry_kind == "standalone"
    expect(entry_valid).to_equal(true)
    if not entry_valid:
        return ("", "traceability command entry kind missing", 2)
    # Standalone evidence covers the production command; full-cli dispatch is
    # a separate acceptance obligation and remains open until exercised.
    val result = process_run_timeout(binary, command_args, 15000)
    expect(result.1.contains("Rust-built Simple binary")).to_equal(false)
    result

fn decode_trace_result(output: text) -> TraceQualificationV1:
    var accepted = false
    var decoded = TraceQualificationV1(
        snapshot: TraceSnapshotV1(id: "invalid-output", kind: "worktree", complete: false),
        selection: TraceSelectionV1(paths: [], full_repository: false),
        evaluation: TraceEvaluationV1(scope: "all", profile: "worktree", kind: "structural",
            complete: false, exit_code: 2, qualification: "incomplete"), diagnostics: [])
    match trace_qualification_decode_v1(output, trace_qualification_codec_limits_v1()):
        case Ok(value):
            accepted = true
            decoded = value
        case Err(_): pass
    expect(accepted).to_equal(true)
    var canonical = false
    match trace_qualification_encode_v1(decoded, trace_qualification_codec_limits_v1()):
        case Ok(value): canonical = output == value
        case Err(_): pass
    expect(canonical).to_equal(true)
    decoded

fn expect_trace_usage_error(options: [text]) -> text:
    val (stdout, stderr, code) = run_trace_cli(options)
    expect(code).to_equal(2)
    expect(stderr).to_contain("traceability")
    val option_name = options[0].split("=")[0]
    expect(stderr).to_contain(option_name)
    expect(stdout).to_equal("")
    stderr

describe "Traceability SDN command contract":
    it "returns one parseable SDN verdict by default":
        # @manual: show
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        # @capture(protocol)
        step("Inspect a fixture with no trace declarations")
        val (stdout, stderr, code) = run_trace_cli([EMPTY_TRACE_FIXTURE])
        expect(code).to_equal(0)
        step("Read the schema and completed structural scope from SDN")
        val result = decode_trace_result(stdout)
        expect(result.evaluation.complete).to_equal(true)
        expect(result.evaluation.exit_code).to_equal(0)
        expect(result.evaluation.scope).to_equal("all")
        expect(result.evaluation.kind).to_equal("structural")
        expect(result.evaluation.profile).to_equal("worktree")
        expect(result.snapshot.kind).to_equal("worktree")
        expect(result.snapshot.complete).to_equal(true)
        expect(result.snapshot.id.starts_with("worktree-input:")).to_equal(true)
        expect(result.snapshot.id.len()).to_be_greater_than(15)
        expect(result.selection.paths.len()).to_equal(1)
        expect(result.selection.paths[0]).to_equal(EMPTY_TRACE_FIXTURE)
        expect(result.selection.full_repository).to_equal(false)
        expect(result.evaluation.qualification).to_equal("incomplete")
        expect(result.diagnostics.len()).to_equal(0)

    it "accepts explicit SDN and keeps progress outside the verdict":
        # @manual: show
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        # @capture(protocol)
        step("Request SDN output while showing dot progress")
        val (stdout, stderr, code) = run_trace_cli(["--format=sdn", "--progress=dot", EMPTY_TRACE_FIXTURE])
        expect(code).to_equal(0)
        step("Decode the entire stdout document and inspect stderr progress")
        val result = decode_trace_result(stdout)
        expect(result.evaluation.kind).to_equal("structural")
        expect(stderr).to_contain(".")
        expect(stdout.contains("traceability: clean")).to_equal(false)

    it "keeps quiet output parseable and retains the verdict":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Inspect the fixture with quiet reporting")
        val (stdout, stderr, code) = run_trace_cli(["--quiet", EMPTY_TRACE_FIXTURE])
        expect(code).to_equal(0)
        val result = decode_trace_result(stdout)
        expect(result.evaluation.complete).to_equal(true)
        expect(stderr).to_equal("")

    it "rejects each legacy JSON spelling":
        # @manual: show
        # @req: REQ-TRC-001, REQ-TRC-007
        # @ac: AC-TRC-002
        step("Reject format, shorthand and log-mode JSON flags")
        expect_trace_usage_error(["--format=json", EMPTY_TRACE_FIXTURE])
        expect_trace_usage_error(["--format", "json", EMPTY_TRACE_FIXTURE])
        val shorthand_error = expect_trace_usage_error(["--json", EMPTY_TRACE_FIXTURE])
        expect_trace_usage_error(["--log-mode=json", EMPTY_TRACE_FIXTURE])
        expect_trace_usage_error(["--log-mode", "json", EMPTY_TRACE_FIXTURE])
        step("Explain how to request the supported structured format")
        expect(shorthand_error).to_contain("SDN")

    it "rejects missing values, unknown options and unsupported scopes":
        # @manual: show
        # @req: REQ-TRC-007, REQ-TRC-010
        # @ac: AC-TRC-002, AC-TRC-015
        step("Reject incomplete format and scope options")
        expect_trace_usage_error(["--format"])
        expect_trace_usage_error(["--scope"])
        step("Reject unknown scope, format and option names")
        expect_trace_usage_error(["--scope=imaginary", EMPTY_TRACE_FIXTURE])
        expect_trace_usage_error(["--format=xml", EMPTY_TRACE_FIXTURE])
        expect_trace_usage_error(["--imaginary-option", EMPTY_TRACE_FIXTURE])

    it "documents SDN without advertising a removed JSON mode":
        # @manual: show
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        step("Read help before choosing a reporting format")
        val (stdout, stderr, code) = run_trace_cli(["--help"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("sdn")
        expect(stdout).to_contain("--progress")
        expect(stdout.contains("json")).to_equal(false)

    it "reports missing input as an incomplete SDN evaluation":
        # @manual: show
        # @req: REQ-TRC-007, REQ-TRC-010
        # @ac: AC-TRC-015
        step("Select an input that does not exist")
        val (stdout, stderr, code) = run_trace_cli([EMPTY_TRACE_FIXTURE + "/missing.spl"])
        expect(code).to_equal(2)
        step("Retain a parseable infrastructure reason without a completed snapshot claim")
        val result = decode_trace_result(stdout)
        expect(result.snapshot.complete).to_equal(false)
        expect(result.evaluation.complete).to_equal(false)
        expect(result.evaluation.exit_code).to_equal(2)
        expect(result.evaluation.qualification).to_equal("incomplete")
        expect(result.diagnostics.len()).to_be_greater_than(0)
