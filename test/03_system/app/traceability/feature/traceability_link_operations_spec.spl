# @cover src/lib/common/traceability/declarations_decode_v1.spl 80%
# @cover src/lib/common/traceability/declarations_encode_v1.spl 80%
# @cover src/lib/common/traceability/encode_v1.spl 80%
"""Real typed operations and scopes; resolver authorization is not inferred."""
use std.spec.*
use std.spec.step
use std.common.sdn.value.{SdnValue}
use std.common.sdn.strict_v1.{sdn_parse_strict_v1}
use std.common.sdn.strict_types_v1.{sdn_strict_limits_v1}
use std.common.traceability.declarations_types_v1.*
use std.common.traceability.declarations_v1.{trace_declarations_encode_v1, trace_declarations_decode_v1}
use std.common.traceability.declarations_v2.*
use std.common.traceability.document_types_v1.*
use std.common.traceability.encode_v1.{trace_document_decode_v1, trace_document_encode_v1}

fn link_fixture_v2() -> TraceDeclarationsV2:
    val base = TraceDeclarationsV1(id: "declarations:one", namespace: "project/simple", claims: [], aliases: [],
        exceptions: [TraceExceptionDeclarationV1(id: "exception:one", scope_kind: "entity", subject_id: "source:old", rule_id: "app-unit-v1", reason: "Requires policy review",
            owner: "owner:one", review_state: "proposed", expires_available: false, expires_at: "", origin_id: "origin:one")],
        origins: [TraceDeclarationOriginV1(id: "origin:one", origin_kind: "explicit", path: "doc/λ\nintent.sdn", span_available: false, line: 0, column: 0, extractor_version: "extract/v1")])
    TraceDeclarationsV2(base: base,
        explicit_links: [TraceExplicitLinkV2(id: "operation:add", owner: "owner:one", from_id: "test:shared", relation: "targets", to_id: "source:A", operation: "add", replaces_rule: "",
                reason: "Shared test, additional target", origin_id: "origin:one", exception_id: ""),
            TraceExplicitLinkV2(id: "operation:replace", owner: "owner:one", from_id: "test:shared", relation: "targets", to_id: "source:B", operation: "replace", replaces_rule: "app-unit-v1",
                reason: "λ, \"quoted\"\nreplacement", origin_id: "origin:one", exception_id: "exception:one"),
            TraceExplicitLinkV2(id: "operation:suppress", owner: "owner:one", from_id: "test:old", relation: "targets", to_id: "source:old", operation: "suppress", replaces_rule: "app-unit-v1",
                reason: "Suppress this structural expectation only", origin_id: "origin:one", exception_id: "exception:one")],
        replacement_scopes: [TraceReplacementScopeV2(operation_id: "operation:replace", from_id: "test:old", relation: "targets", to_id: "source:old")])

fn link_source_v2(document: TraceDeclarationsV2) -> text:
    var accepted = false
    var source = ""
    match trace_declarations_encode_v2(document, trace_declarations_codec_limits_v1()):
        case Ok(value):
            accepted = true
            source = value
        case Err(issue): print "Unexpected operation encode: {issue.code} {issue.path}"
    expect(accepted).to_equal(true)
    source

fn link_decoded_v2(source: text, limits: TraceDeclarationsCodecLimitsV1) -> TraceDeclarationsV2:
    var accepted = false
    var document = link_fixture_v2()
    match trace_declarations_decode_v2(source, limits):
        case Ok(value):
            accepted = true
            document = value
        case Err(issue): print "Unexpected operation decode: {issue.code} {issue.path}"
    expect(accepted).to_equal(true)
    document

fn link_encode_refusal_v2(document: TraceDeclarationsV2, limits: TraceDeclarationsCodecLimitsV1, code: text):
    var refused = false
    match trace_declarations_encode_v2(document, limits):
        case Err(issue):
            refused = true
            expect(issue.code).to_equal(code)
        case Ok(_): ()
    expect(refused).to_equal(true)

fn link_raw_v2(source: text) -> SdnValue:
    var accepted = false
    var raw = SdnValue.Null
    match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
        case Ok(parsed):
            accepted = true
            raw = parsed.value
        case Err(_): ()
    expect(accepted).to_equal(true)
    raw

fn link_authored_text_bytes_v2(source: text) -> i64:
    # Independent oracle sums actual parsed data cells, excluding syntax headers.
    var size = 0
    match link_raw_v2(source):
        case Dict(fields):
            for field in ["id", "namespace"]:
                match fields[field]:
                    case String(item): size = size + item.len()
                    case _: expect(false).to_equal(true)
            for section in ["claims", "aliases", "exceptions", "origins", "explicit_links", "replacement_scopes"]:
                if fields.contains_key(section):
                    match fields[section]:
                        case Table(_, rows):
                            for row in rows:
                                for cell in row:
                                    match cell:
                                        case String(item): size = size + item.len()
                                        case _: ()
                        case _: expect(false).to_equal(true)
        case _: expect(false).to_equal(true)
    size

describe "Targeted declarations major2 operation contract":
    it "dispatches the actual major2 payload and canonically reencodes it":
        # @req: REQ-TRC-001, REQ-TRC-005
        # @ac: AC-TRC-001
        step("Decode the explicit version into its own document variant")
        val source = link_source_v2(link_fixture_v2())
        var accepted = false
        match trace_document_decode_v1(source, trace_document_codec_limits_v1()):
            case Ok(document):
                match document:
                    case DeclarationsV2(value):
                        accepted = true
                        expect(value.explicit_links.len()).to_equal(3)
                        expect(value.replacement_scopes[0].from_id).to_equal("test:old")
                        match trace_document_encode_v1(document, trace_document_codec_limits_v1()):
                            case Ok(output): expect(output).to_equal(source)
                            case Err(_): expect(false).to_equal(true)
                    case _: ()
            case Err(_): ()
        expect(accepted).to_equal(true)

    it "preserves distinct addition, desired replacement and original suppression tuples":
        # @req: REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-001
        step("Inspect the replacement's original scope separately from its desired target")
        val decoded = link_decoded_v2(link_source_v2(link_fixture_v2()), trace_declarations_codec_limits_v1())
        var adds = 0
        var replacements = 0
        var suppressions = 0
        for item in decoded.explicit_links:
            if item.operation == "add":
                adds = adds + 1
                expect(item.to_id).to_equal("source:A")
                expect(item.replaces_rule).to_equal("")
                expect(item.exception_id).to_equal("")
            elif item.operation == "replace":
                replacements = replacements + 1
                expect(item.from_id).to_equal("test:shared")
                expect(item.to_id).to_equal("source:B")
                expect(item.reason).to_equal("λ, \"quoted\"\nreplacement")
                expect(item.replaces_rule).to_equal("app-unit-v1")
                expect(item.exception_id).to_equal("exception:one")
            else:
                suppressions = suppressions + 1
                expect(item.from_id).to_equal("test:old")
                expect(item.to_id).to_equal("source:old")
                expect(item.exception_id).to_equal("exception:one")
        expect([adds, replacements, suppressions]).to_equal([1, 1, 1])
        expect(decoded.replacement_scopes[0].to_id).to_equal("source:old")
        expect(decoded.replacement_scopes[0].relation).to_equal("targets")
        expect(decoded.replacement_scopes[0].operation_id).to_equal("operation:replace")

    it "retains provenance and proposed applicability without fabricating review":
        # @req: REQ-TRC-005, REQ-TRC-019
        # @ac: AC-TRC-001
        val decoded = link_decoded_v2(link_source_v2(link_fixture_v2()), trace_declarations_codec_limits_v1())
        expect(decoded.base.origins[0].path).to_equal("doc/λ\nintent.sdn")
        expect(decoded.base.exceptions[0].review_state).to_equal("proposed")
        expect(decoded.base.exceptions[0].expires_available).to_equal(false)
        expect(decoded.base.exceptions[0].expires_at).to_equal("")
        for item in decoded.explicit_links:
            expect(item.origin_id).to_equal("origin:one")
            expect(item.owner).to_equal("owner:one")

    it "rejects operation shape errors and absent exact original scope":
        # @req: REQ-TRC-001, REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-002
        var document = link_fixture_v2()
        document.explicit_links[0].replaces_rule = "app-unit-v1"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_operation")
        document = link_fixture_v2()
        document.explicit_links[0].exception_id = "exception:one"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_operation")
        document = link_fixture_v2()
        document.replacement_scopes = []
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "missing_reference")
        document = link_fixture_v2()
        document.explicit_links[1].operation = "ignore"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_enum")

    it "rejects duplicate operations, duplicate scopes and orphan references":
        # @req: REQ-TRC-001, REQ-TRC-006
        # @ac: AC-TRC-002
        var document = link_fixture_v2()
        document.explicit_links = document.explicit_links + [document.explicit_links[0]]
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "duplicate_identifier")
        document = link_fixture_v2()
        document.replacement_scopes = document.replacement_scopes + [document.replacement_scopes[0]]
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "duplicate_identifier")
        document = link_fixture_v2()
        document.replacement_scopes[0].operation_id = "operation:absent"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "missing_reference")
        document = link_fixture_v2()
        document.explicit_links[0].origin_id = "origin:absent"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "missing_reference")
        document = link_fixture_v2()
        document.explicit_links[1].exception_id = "exception:absent"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "missing_reference")

    it "rejects scopes on add or suppress and mismatched exception rules":
        # @req: REQ-TRC-005, REQ-TRC-006, REQ-TRC-019
        # @ac: AC-TRC-002
        for operation in ["operation:add", "operation:suppress"]:
            var document = link_fixture_v2()
            document.replacement_scopes[0].operation_id = operation
            link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_operation")
        var document = link_fixture_v2()
        document.base.exceptions[0].rule_id = "rule:other"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_override")
        document = link_fixture_v2()
        document.replacement_scopes[0].from_id = "*"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_identifier")
        document = link_fixture_v2()
        document.replacement_scopes[0].relation = "aliases"
        link_encode_refusal_v2(document, trace_declarations_codec_limits_v1(), "invalid_enum")

    it "preserves overlapping replacements for later conflict resolution":
        # @req: REQ-TRC-005, REQ-TRC-006
        # @ac: AC-TRC-001
        var document = link_fixture_v2()
        var replacement = document.explicit_links[1]
        replacement.id = "operation:conflict"
        replacement.to_id = "source:C"
        document.explicit_links = document.explicit_links + [replacement]
        document.replacement_scopes = document.replacement_scopes + [TraceReplacementScopeV2(operation_id: "operation:conflict", from_id: "test:old", relation: "targets", to_id: "source:old")]
        val decoded = link_decoded_v2(link_source_v2(document), trace_declarations_codec_limits_v1())
        expect(decoded.explicit_links.len()).to_equal(4)
        expect(decoded.replacement_scopes.len()).to_equal(2)
        var targets: [text] = []
        for item in decoded.explicit_links:
            if item.operation == "replace": targets.push(item.to_id)
        expect(targets).to_contain("source:B")
        expect(targets).to_contain("source:C")

    it "canonicalizes complete operation records and original scopes":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-001
        var document = link_fixture_v2()
        var replacement = document.explicit_links[1]
        replacement.id = "operation:second"
        replacement.to_id = "source:C"
        document.explicit_links = document.explicit_links + [replacement]
        document.replacement_scopes = document.replacement_scopes + [TraceReplacementScopeV2(operation_id: "operation:second", from_id: "test:other", relation: "targets", to_id: "source:old")]
        val source = link_source_v2(document)
        document.explicit_links = [document.explicit_links[3], document.explicit_links[2], document.explicit_links[1], document.explicit_links[0]]
        document.replacement_scopes = [document.replacement_scopes[1], document.replacement_scopes[0]]
        expect(link_source_v2(document)).to_equal(source)

    it "round-trips exact semantic and escaped output budgets":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-001
        val document = link_fixture_v2()
        val source = link_source_v2(document)
        var parsed = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(value):
                parsed = true
                expect(value.nodes).to_equal(114)
                expect(value.rows).to_equal(6)
                expect(value.cells).to_equal(51)
            case Err(_): ()
        expect(parsed).to_equal(true)
        var limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_nodes = 114
        limits.sdn.max_rows = 6
        limits.sdn.max_cells = 51
        limits.sdn.max_columns = 10
        limits.sdn.max_depth = 3
        limits.sdn.max_source_bytes = source.len()
        limits.max_output_bytes = source.len()
        expect(link_decoded_v2(source, limits).explicit_links.len()).to_equal(3)
        var exact = false
        match trace_declarations_encode_v2(document, limits):
            case Ok(output): exact = output == source
            case Err(_): ()
        expect(exact).to_equal(true)
        limits.sdn.max_source_bytes = source.len() - 1
        link_encode_refusal_v2(document, limits, "output_limit")

    it "enforces combined budgets before semantic indexes or rows":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        var document = link_fixture_v2()
        var limits = trace_declarations_codec_limits_v1()
        limits.max_records = 4
        var base_fits = false
        match trace_declarations_encode_v1(document.base, limits):
            case Ok(_): base_fits = true
            case Err(_): ()
        expect(base_fits).to_equal(true)
        expect(document.explicit_links.len() + document.replacement_scopes.len()).to_equal(4)
        link_encode_refusal_v2(document, limits, "record_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_nodes = 113
        link_encode_refusal_v2(document, limits, "node_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_field_bytes = 8
        link_encode_refusal_v2(document, limits, "field_limit")
        limits = trace_declarations_codec_limits_v1()
        limits.max_text_bytes = 0
        link_encode_refusal_v2(document, limits, "text_limit")
        document.explicit_links[0].origin_id = "origin:absent"
        limits = trace_declarations_codec_limits_v1()
        limits.max_output_bytes = 1
        link_encode_refusal_v2(document, limits, "output_limit")

    it "independently bounds caller-created values and exact headers":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        val source = link_source_v2(link_fixture_v2())
        var limits = trace_declarations_codec_limits_v1()
        limits.sdn.max_nodes = 113
        var refused = false
        match trace_declarations_from_value_v2(link_raw_v2(source), limits):
            case Err(issue): refused = issue.code == "node_limit" and not issue.location_available
            case Ok(_): ()
        expect(refused).to_equal(true)
        var fields: Dict<text, SdnValue> = {}
        match link_raw_v2(source):
            case Dict(value): fields = value
            case _: ()
        fields["explicit_links"] = SdnValue.Table(["id", "id", "from_id", "relation", "to_id", "operation", "replaces_rule", "reason", "origin_id", "exception_id"], [])
        refused = false
        match trace_declarations_from_value_v2(SdnValue.Dict(fields), trace_declarations_codec_limits_v1()):
            case Err(issue): refused = issue.code == "duplicate_field"
            case Ok(_): ()
        expect(refused).to_equal(true)

    it "keeps major1 data separate and rejects unknown interpretation fields":
        # @req: REQ-TRC-001
        # @ac: AC-TRC-002
        val source = link_source_v2(link_fixture_v2())
        var refused = false
        match trace_declarations_decode_v1(source, trace_declarations_codec_limits_v1()):
            case Err(issue): refused = issue.code == "schema_version"
            case Ok(_): ()
        expect(refused).to_equal(true)

        refused = false
        match trace_document_decode_v1(source.replace("version: 2", "version: 3"), trace_document_codec_limits_v1()):
            case Err(issue): refused = issue.code == "schema_version"
            case Ok(_): ()
        expect(refused).to_equal(true)
        refused = false
        match trace_declarations_decode_v2(source + "eligibility: verified\n", trace_declarations_codec_limits_v1()):
            case Err(issue): refused = issue.code == "unknown_field" and issue.path == "eligibility"
            case Ok(_): ()
        expect(refused).to_equal(true)

    it "round-trips empty major2 at exactly63 nodes and zero records":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-001
        step("Keep all six empty tables present at the exact structural boundary")
        var document = link_fixture_v2()
        document.base.exceptions = []
        document.base.origins = []
        document.explicit_links = []
        document.replacement_scopes = []
        val source = link_source_v2(document)
        var parsed = false
        match sdn_parse_strict_v1(source, sdn_strict_limits_v1()):
            case Ok(value):
                parsed = true
                expect(value.nodes).to_equal(63)
                expect(value.rows).to_equal(0)
                expect(value.cells).to_equal(0)
            case Err(_): ()
        expect(parsed).to_equal(true)
        var limits = trace_declarations_codec_limits_v1()
        limits.max_records = 0
        limits.sdn.max_nodes = 63
        limits.sdn.max_rows = 0
        limits.sdn.max_cells = 0
        limits.sdn.max_depth = 3
        limits.sdn.max_columns = 10
        expect(link_decoded_v2(source, limits).explicit_links.len()).to_equal(0)
        var exact = false
        match trace_declarations_encode_v2(document, limits):
            case Ok(output): exact = output == source
            case Err(_): ()
        expect(exact).to_equal(true)
        limits.sdn.max_nodes = 62
        link_encode_refusal_v2(document, limits, "node_limit")

    it "charges exact aggregate text and rejects individually fitting subsets":
        # @req: REQ-TRC-001, REQ-TRC-010
        # @ac: AC-TRC-002
        step("Measure parsed user cells independently of producer text preflight")
        val document = link_fixture_v2()
        val source = link_source_v2(document)
        val bytes = link_authored_text_bytes_v2(source)
        expect(bytes).to_be_greater_than(0)
        var limits = trace_declarations_codec_limits_v1()
        limits.max_text_bytes = bytes
        expect(link_decoded_v2(source, limits).explicit_links.len()).to_equal(3)
        var exact = false
        match trace_declarations_encode_v2(document, limits):
            case Ok(output): exact = output == source
            case Err(_): ()
        expect(exact).to_equal(true)
        limits.max_text_bytes = bytes - 1
        link_encode_refusal_v2(document, limits, "text_limit")
        var refused = false
        match trace_declarations_decode_v2(source, limits):
            case Err(issue): refused = issue.code == "text_limit"
            case Ok(_): ()
        expect(refused).to_equal(true)
        var base_source = ""
        match trace_declarations_encode_v1(document.base, trace_declarations_codec_limits_v1()):
            case Ok(output): base_source = output
            case Err(_): expect(false).to_equal(true)
        val base_bytes = link_authored_text_bytes_v2(base_source)
        val operation_bytes = bytes - base_bytes
        limits.max_text_bytes = if base_bytes > operation_bytes: base_bytes else: operation_bytes
        expect(limits.max_text_bytes < bytes).to_equal(true)
        expect(base_bytes <= limits.max_text_bytes and operation_bytes <= limits.max_text_bytes).to_equal(true)
        var base_fits = false
        match trace_declarations_encode_v1(document.base, limits):
            case Ok(_): base_fits = true
            case Err(_): ()
        expect(base_fits).to_equal(true)
        link_encode_refusal_v2(document, limits, "text_limit")
