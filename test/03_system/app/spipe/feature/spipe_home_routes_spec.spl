# Purpose: verify canonical SPipe home routes without touching real private data.
# @req REQ-001 REQ-002 REQ-007
# architecture: doc/04_architecture/spipe_local_knowledge_setup.md
# design: doc/05_design/spipe_local_knowledge_setup.md
use std.spec.*
use std.spec.step
use std.io_runtime.{process_run}

"""
# SPipe home deployment routes

Core belongs at ~/.spipe; private knowledge belongs at ~/spipe. This Unix
fixture verifies Simple bootstrap routing with a local core delegate. It does
not exercise SPipe's complete installer or claim native Windows execution.
"""
describe "SPipe home deployment routes":
    # @manual: show
    it "connects core and private homes while preserving occupied routes":
        # @req REQ-001 REQ-002 REQ-007
        # @capture(log)
        step("Create isolated core and project fixtures and run setup")
        val (stdout, stderr, code) = process_run("/bin/sh", ["test/03_system/app/spipe/feature/spipe_home_routes_contract_test.shs"])
        expect(code).to_equal(0)
        step("Verify default routes and repeat setup")
        expect(stdout).to_contain("PASS default-home-routes")
        expect(stdout).to_contain("PASS repeat-setup")
        step("Preserve conflicting private content and reject shared roots")
        expect(stdout).to_contain("PASS preserve-conflict")
        expect(stdout).to_contain("PASS reject-core-workspace-alias")
        step("Resolve explicit roots containing spaces and account for every scenario")
        expect(stdout).to_contain("PASS explicit-roots-with-spaces")
        expect(stdout).to_contain("scenarios=5")
        expect(stdout).to_contain("STATUS: PASS spipe-home-routes")

    it "rejects legacy and nested roots before writing routes":
        # @req REQ-007
        # @capture(log)
        step("Reject legacy core, nesting in either direction, and symlink aliases")
        val (stdout, stderr, code) = process_run("/bin/sh", ["test/03_system/app/spipe/feature/spipe_home_routes_contract_test.shs", "--migration-only"])
        expect(code).to_equal(0)
        expect(stdout).to_contain("migration_scenarios=4")
        expect(stdout).to_contain("STATUS: PASS spipe-home-migration-guards")

    it "expands literal home prefixes without executing path contents":
        # @req REQ-001 REQ-007
        # @capture(log)
        step("Launch setup with literal home paths in a home containing spaces")
        val (stdout, stderr, code) = process_run("/bin/sh", ["test/03_system/app/spipe/feature/spipe_home_routes_contract_test.shs", "--placeholder-only"])
        expect(code).to_equal(0)
        step("Keep shell-looking workspace contents literal and require both cases")
        expect(stdout).to_contain("placeholder_scenarios=2")
        expect(stdout).to_contain("STATUS: PASS spipe-home-placeholders")
