# @cover src/compiler/50.mir/__init__.spl 0%
# codex-system-test
# @manual_section RISC-V Gen2 V7 flattened IM runtime-M pipeline
"""# RISC-V Gen2 V7 flattened IM runtime-M pipeline

Exercises the public V7 IM-only product boundary for RV32IM and RV64IM.  It
proves structural elaboration, one tag-two runtime-M owner, every architectural
M row, protocol wiring, and deterministic strict lowering.  It intentionally
does not claim clocked arithmetic, GHDL, or self-hosted-runtime qualification.
"""
use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v7_flat.{strict_riscv_scalar_runtime_pipeline_v7_flat_direct}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v7_flat_to_vhdl.{compile_strict_riscv_scalar_runtime_pipeline_v7_flat}

fn runtime_v7_im_config(xlen: i32) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: if xlen == 32: 32 else: 56,
        register_count: 32, profile: "riscv-gen2-runtime-v7-im",
        isa_profile: if xlen == 32: "rv32im" else: "rv64im",
        compressed_decode_profile: "none")

fn runtime_v7_zmmul_config() -> CoreConfig:
    CoreConfig(xlen: 32, physical_address_bits: 32, register_count: 32,
        profile: "riscv-gen2-runtime-v7-zmmul-rejected", isa_profile: "rv32i_zmmul",
        compressed_decode_profile: "none")

describe "RISC-V Gen2 V7 flattened IM runtime-M pipeline":
    # @req REQ-G2-012 REQ-G2-013
    it "should elaborate RV32IM and RV64IM products with one unified tag-two runtime-M owner":
        step("Build the exact RV32IM and RV64IM V7 products")
        val rv32 = strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_rv32", runtime_v7_im_config(32),
            LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_rv64", runtime_v7_im_config(64),
            LsuConfig.rv64_product_default()).unwrap()
        step("Check closed topology and the single dynamic M owner")
        expect(rv32.diagnostic()).to_equal("")
        expect(rv64.diagnostic()).to_equal("")
        expect(rv32.muldiv.entity_name).to_equal("runtime_v7_system_rv32_muldiv")
        expect(rv64.muldiv.entity_name).to_equal("runtime_v7_system_rv64_muldiv")
        expect(rv32.muldiv.constants.any(_.name == "tag_muldiv" and _.value == 2)).to_equal(true)
        expect(rv64.muldiv.constants.any(_.name == "tag_muldiv" and _.value == 2)).to_equal(true)
        expect(rv32.muldiv.child_entity).to_equal("")
        expect(rv64.muldiv.child_entity).to_equal("")

    # @req REQ-G2-012 REQ-G2-013
    it "should represent every RV32 and RV64 M instruction row through that one owner":
        step("Build both exact IM plans")
        val rv32 = strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_rows32", runtime_v7_im_config(32),
            LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_rows64", runtime_v7_im_config(64),
            LsuConfig.rv64_product_default()).unwrap()
        step("Check all base M rows and RV64 word rows are frozen into the decoder plan")
        for id in ["rv.m.mul", "rv.m.mulh", "rv.m.mulhsu", "rv.m.mulhu", "rv.m.div", "rv.m.divu", "rv.m.rem", "rv.m.remu"]:
            expect(rv32.plan.entries.any(_.id == id)).to_equal(true)
            expect(rv64.plan.entries.any(_.id == id)).to_equal(true)
        for id in ["rv64.m.mulw", "rv64.m.divw", "rv64.m.divuw", "rv64.m.remw", "rv64.m.remuw"]:
            expect(rv64.plan.entries.any(_.id == id)).to_equal(true)
        expect(rv32.plan.entries.any(_.id == "rv64.m.divw")).to_equal(false)

    # @req REQ-G2-012
    it "should bind tag-two request acceptance held completion and fault containment":
        step("Build an RV64IM product for protocol-edge inspection")
        val pipeline = strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_edges", runtime_v7_im_config(64),
            LsuConfig.rv64_product_default()).unwrap()
        step("Trace the one pending-owner and runtime-M handshake")
        for edge in [("pending", "muldiv_request_valid", "muldiv", "request_valid", 1),
                ("pending", "muldiv_request_provider_tag", "muldiv", "request_provider_tag", 3),
                ("muldiv", "request_accept", "pending", "muldiv_request_accept", 1),
                ("muldiv", "completion_valid", "pending", "muldiv_completion_valid", 1),
                ("pending", "muldiv_completion_ready", "muldiv", "completion_ready", 1),
                ("muldiv", "provider_protocol_fault", "global_fault_gate", "muldiv_fault", 1)]:
            expect(pipeline.bindings.any(_.source_owner == edge[0] and _.source_port == edge[1] and
                _.destination_owner == edge[2] and _.destination_port == edge[3] and
                _.bit_width == edge[4])).to_equal(true)

    # @req REQ-G2-013 NFR-G2-003
    it "should emit deterministic strict VHDL for the IM-only V7 boundary":
        step("Compile the same RV32IM product twice through the public V7 route")
        val first = compile_strict_riscv_scalar_runtime_pipeline_v7_flat(
            "runtime_v7_system_vhdl", runtime_v7_im_config(32),
            LsuConfig.rv32_product_default())
        val second = compile_strict_riscv_scalar_runtime_pipeline_v7_flat(
            "runtime_v7_system_vhdl", runtime_v7_im_config(32),
            LsuConfig.rv32_product_default())
        step("Check route identity receipt determinism and the unified M instance")
        expect(first.is_success()).to_equal(true)
        expect(second.is_success()).to_equal(true)
        expect(first.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v7-flat-direct")
        expect(first.hwir_graph_sha256).to_equal(second.hwir_graph_sha256)
        expect(first.vhdl).to_equal(second.vhdl)
        expect(first.vhdl).to_contain("simple-hwir v7-flat-route-receipt=")
        expect(first.vhdl).to_contain("muldiv: entity work.runtime_v7_system_vhdl_muldiv")

    # @req REQ-G2-013
    it "should reject Zmmul CSR and combined profiles outside the IM-only V7 boundary":
        step("Attempt V7 construction with profiles belonging to other product milestones")
        expect(strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_zmmul_rejected", runtime_v7_zmmul_config(),
            LsuConfig.rv32_product_default()).is_err()).to_equal(true)
        expect(strict_riscv_scalar_runtime_pipeline_v7_flat_direct(
            "runtime_v7_system_zicsr_rejected", CoreConfig.rv32_zicsr_zifencei(),
            LsuConfig.rv32_product_default()).is_err()).to_equal(true)
