# @cover src/compiler/50.mir/__init__.spl 0%
"""Development-stage operator scenario for the typed RISC-V Gen2 Zicsr access
projection. This scenario proves projection semantics only. It does not claim
CSR state ownership, product composition, generated-RTL equivalence, or Zicsr
qualification; those remain blocked by the atomic CSR owner.
"""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.host_evaluator.{HwHostInput, prepare_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_csr_projection.{strict_riscv_scalar_csr_projection_hwir}
use compiler.mir.hwir.riscv_scalar_csr_owner.{strict_riscv_scalar_csr_owner}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_product_composition.{strict_riscv_scalar_product_composition}

describe "RISC-V Gen2 typed CSR projection":
    # @req REQ-G2-016 NFR-G2-017
    it "should elaborate one concrete CSR access for RV32 and RV64":
        step("Select the Zicsr-capable RV32 and RV64 product configurations")
        val rv32 = strict_riscv_scalar_csr_projection_hwir("csr_projection_rv32",
            CoreConfig.rv32_zicsr_zifencei(), 0x300092F3)
        val rv64 = strict_riscv_scalar_csr_projection_hwir("csr_projection_rv64",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3)
        step("Elaborate the same concrete CSRRW row without a runtime XLEN selector")
        expect(rv32.is_ok()).to_equal(true)
        expect(rv64.is_ok()).to_equal(true)
        expect(rv32.unwrap().config.xlen).to_equal(32)
        expect(rv64.unwrap().config.xlen).to_equal(64)

    # @req REQ-G2-016 NFR-G2-017
    it "should expose the exact typed CSR state seam":
        step("Build the RV64 machine-status CSR projection")
        val module = strict_riscv_scalar_csr_projection_hwir("csr_projection_ports",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3).unwrap()
        step("Inspect the explicit state-owner inputs and effect outputs")
        expect(module.port_direction("csr_present")).to_equal("in")
        expect(module.port_direction("csr_read_value")).to_equal("in")
        expect(module.port_direction("csr_lookup_address")).to_equal("out")
        expect(module.port_direction("csr_read_enable")).to_equal("out")
        expect(module.port_direction("csr_write_enable")).to_equal("out")
        expect(module.port_direction("csr_address")).to_equal("out")
        expect(module.port_direction("csr_write_value")).to_equal("out")

    # @req REQ-G2-016 NFR-G2-017
    it "should suppress every CSR effect when a read-only write is denied":
        step("Elaborate CSRRW against the read-only machine-vendor CSR")
        val module = strict_riscv_scalar_csr_projection_hwir("csr_projection_denied",
            CoreConfig.rv64_zicsr_zifencei(), 0xF11092F3).unwrap()
        val prepared = prepare_strict_comb_hwir(module).unwrap()
        step("Drive a present CSR from machine privilege with a matching source register")
        val result = prepared.evaluate([HwHostInput.bits("in_valid", 1),
            HwHostInput.bits("in_order", 1), HwHostInput.bits("in_privilege", 3),
            HwHostInput.bits("in_pc", 0x100), HwHostInput.bits("rs1_index", 1),
            HwHostInput.bits("rs1_value", 7), HwHostInput.bits("csr_present", 1),
            HwHostInput.bits("csr_read_value", 42)]).unwrap()
        step("Confirm illegal-instruction retirement and zero CSR side effects")
        expect(result.value_of("retire_trap").unwrap()).to_equal(1)
        expect(result.value_of("retire_cause").unwrap()).to_equal(2)
        expect(result.value_of("csr_read_enable").unwrap()).to_equal(0)
        expect(result.value_of("csr_write_enable").unwrap()).to_equal(0)

    # @req REQ-G2-012 REQ-G2-016 NFR-G2-017
    it "should hold CSR completion and commit only through accepted retirement":
        step("Build the sequential CSR owner around the frozen projection")
        val owner = strict_riscv_scalar_csr_owner("csr_owner_scenario",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3).unwrap()
        step("Confirm commit is guarded by occupancy completion-ready write intent and health")
        val commit = owner.plan.outputs.filter(fn(output): output.result == "csr_commit_valid")[0]
        expect(commit.guards.len()).to_equal(6)
        step("Compose the stateful provider through arbitration trap and sole retirement")
        val product = strict_riscv_scalar_product_composition("csr_product_scenario",
            CoreConfig.rv64_zicsr_zifencei(), 0x300092F3,
            LsuConfig.rv64_product_default()).unwrap()
        expect(product.provider_kind).to_equal("csr")
        expect(product.retirement_owner_count).to_equal(1)
        expect(product.binding_diagnostic()).to_equal("")
