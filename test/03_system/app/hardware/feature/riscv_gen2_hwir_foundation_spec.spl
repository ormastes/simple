"""
## Purpose and audience
Verifies the riscv gen2 hwir foundation behaviour end to end so maintainers of this
component and reviewers of its spec share one pinned definition.
## Operator workflow
Run `bin/simple test <this spec>`; read the per-scenario verdicts in
the `Results:` summary. Each scenario asserts an observable outcome.
## Compatibility and limitations
Covers the currently shipped behaviour only; performance, stress and
unrelated sibling features are out of scope.
"""
# @manual: primary
# @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-004 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
# doc-path: doc/01_research/local/riscv_gen2_hwir_foundation.md
# doc-path: doc/03_plan/sys_test/riscv_gen2_hwir_foundation.md
# doc-path: doc/04_architecture/riscv_gen2_hwir_foundation.md
# doc-path: doc/05_design/riscv_gen2_hwir_foundation.md
# codex-system-test
# @req REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-004 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 NFR-G2-001 NFR-G2-002 NFR-G2-003 NFR-G2-006 NFR-G2-008 NFR-G2-010 NFR-G2-011 NFR-G2-012
# @manual_section RISC-V Gen2 strict HWIR and stateful frontend
# @evidence-display: links
"""# RISC-V Gen2 HWIR Foundation

Exercises the fail-closed RV32/RV64 HWIR product boundary, selected compressed
predecode rows, and the bounded stateful C.EBREAK frontend. Every generated
VHDL claim remains development-stage. No qualification receipt exists yet:
only the provenance-admitted self-hosted qualification writer may create the
planned RV32/RV64 GHDL receipt set.
"""
use std.spec.*
use app.io.mod.{env_get}
use compiler.mir.hwir.types.{CoreConfig, HwClockDomain, HwCombOp, HwCompareOp, HwConstant, HwCostModel, HwModule, HwModuleDef, HwNodeId, HwOrigin, HwPort, HwSelectOp, HwSignal}
use compiler.mir.hwir.mir_to_hwir.{HwirLowerInput, lower_strict_hwir_and_module}
use compiler.mir.hwir.zca_rows.{strict_zca_cebreak_row_hwir, strict_zca_cj_predecode_row_hwir, strict_zca_cjal_rv32_predecode_row_hwir, strict_zca_caddiw_rv64_predecode_row_hwir, strict_zca_cbeqz_predecode_row_hwir, strict_zca_cbnez_predecode_row_hwir, strict_zca_addi4spn_row_hwir, strict_zca_cli_row_hwir, strict_zca_caddi_row_hwir, strict_zca_caddi16sp_row_hwir, strict_zca_clui_row_hwir, strict_zca_lw_row_hwir, strict_zca_sw_row_hwir, strict_zca_lwsp_row_hwir, strict_zca_swsp_row_hwir, strict_zca_slli_low_row_hwir, strict_zca_srli_low_row_hwir, strict_zca_srai_low_row_hwir, strict_zca_candi_row_hwir, strict_zca_csub_row_hwir, strict_zca_cxor_row_hwir, strict_zca_cor_row_hwir, strict_zca_cand_row_hwir, strict_zca_cjr_row_hwir, strict_zca_cmv_row_hwir, strict_zca_cjalr_row_hwir, strict_zca_cadd_row_hwir}
use compiler.mir.hwir.frontend.{strict_zca_control_predecode_hwir, strict_zca_migrating_predecode_hwir, strict_zca_rv32_cjal_migrating_predecode_hwir, strict_zca_rv64_addiw_migrating_predecode_hwir}
use compiler.mir.hwir.zca_outcomes.{strict_zca_addi4spn_outcome_hwir, strict_zca_lw_outcome_hwir, strict_zca_sw_outcome_hwir, strict_zca_lwsp_outcome_hwir}
use compiler.mir.hwir.trap_predecode.{strict_zca_cebreak_trap_predecode_hwir}
use compiler.backend.backend.hwir_to_vhdl.{render_strict_hwir_vhdl, compile_strict_zca_control_predecode_product, compile_strict_zca_single_outstanding_frontend_product, compile_strict_zca_trap_single_outstanding_frontend_product}
use std.hardware.riscv_common.isa.compressed.zca_seed.{COMPRESSED_REASON_NONE, CompressedCriticalSubsetManifest, riscv_zca_mission_critical_expand_hardware}
use std.hardware.riscv_common.isa.isa_database.{riscv_zca_critical_subset_entries, riscv_zca_critical_subset_entry_count}

extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_file_read_text(path: text) -> text
extern fn rt_file_exists(path: text) -> bool
extern fn rt_file_delete(path: text) -> bool
extern fn rt_env_set(key: text, value: text) -> bool
extern fn rt_process_run(command: text, args: [text]) -> (text, text, i64)

fn qualification_simple_binary() -> text:
    env_get("RISCV_GEN2_ADMITTED_SIMPLE") ?? "bin/simple"

fn strict_vhdl_write_file(path: text, content: text) -> bool:
    rt_file_write_text(path, content)

fn strict_remove_file_if_present(path: text):
    if rt_file_exists(path):
        rt_file_delete(path)

fn strict_ghdl_available() -> bool:
    val (_stdout, _stderr, code) = rt_process_run("ghdl", ["--version"])
    code == 0

fn strict_ghdl_workdir_ready() -> bool:
    val (_stdout, _stderr, code) = rt_process_run("mkdir", ["-p", "/tmp/ghdl_work"])
    code == 0

fn strict_ghdl_analyze(vhdl_file: text) -> bool:
    if not strict_ghdl_workdir_ready():
        return false
    val (_stdout, _stderr, code) = rt_process_run("ghdl", ["-a", "--std=08", "--workdir=/tmp/ghdl_work", vhdl_file])
    code == 0

fn strict_ghdl_elaborate(entity_name: text) -> bool:
    if not strict_ghdl_workdir_ready():
        return false
    val (_stdout, _stderr, code) = rt_process_run("ghdl", ["-e", "--std=08", "--workdir=/tmp/ghdl_work", entity_name])
    code == 0

fn strict_ghdl_run(entity_name: text, stop_time: text) -> bool:
    if not strict_ghdl_workdir_ready():
        return false
    val (_stdout, _stderr, code) = rt_process_run("ghdl", ["-r", "--std=08", "--workdir=/tmp/ghdl_work", entity_name, "--stop-time=" + stop_time])
    code == 0

# Retired pre-64-bit stateful frontend testbench; coverage is in trap_stateful_protocol_64_testbench and trap_stateful_reuse_reset_64_testbench.

fn addi4spn_outcome_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_addi4spn_outcome_tb is end entity;\narchitecture tb of strict_addi4spn_outcome_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"0000\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_addi4spn_outcome port map(original_parcel,fetch_pc,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n stim: process begin wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" report \"reserved zero immediate must be illegal\" severity failure; original_parcel<=x\"0044\"; wait for 1 ns; assert legal='1' and canonical_instruction/=x\"00000000\" and original_length_bytes=\"10\" and redirect_valid='0' report \"nonzero ADDI4SPN requires explicit normalized legal outcome\" severity failure; finish; end process;\nend architecture;\n"

fn lw_outcome_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_lw_outcome_tb is end entity;\narchitecture tb of strict_lw_outcome_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"4000\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_lw_outcome port map(original_parcel,fetch_pc,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n stim: process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00042403\" and original_length_bytes=\"10\" and next_pc=x\"00000102\" and redirect_valid='0' report \"C.LW explicit classifier outcome mismatch\" severity failure; original_parcel<=x\"0000\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" report \"non-C.LW must be explicitly illegal\" severity failure; finish; end process;\nend architecture;\n"

fn sw_outcome_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_sw_outcome_tb is end entity;\narchitecture tb of strict_sw_outcome_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"C000\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_sw_outcome port map(original_parcel,fetch_pc,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n stim: process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00842023\" and original_length_bytes=\"10\" and next_pc=x\"00000102\" and redirect_valid='0' report \"C.SW explicit classifier outcome mismatch\" severity failure; original_parcel<=x\"0000\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" report \"non-C.SW must be explicitly illegal\" severity failure; finish; end process;\nend architecture;\n"

fn lwsp_outcome_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_lwsp_outcome_tb is end entity;\narchitecture tb of strict_lwsp_outcome_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"4082\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_lwsp_outcome port map(original_parcel,fetch_pc,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n stim: process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00012083\" and original_length_bytes=\"10\" and redirect_valid='0' report \"C.LWSP explicit reserved chain valid outcome mismatch\" severity failure; original_parcel<=x\"4002\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" report \"C.LWSP rd=x0 must stay explicitly illegal\" severity failure; finish; end process;\nend architecture;\n"

fn migrating_predecode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_migrating_predecode_tb is end entity;\narchitecture tb of strict_migrating_predecode_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"4000\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal rs1_index: std_logic_vector(4 downto 0) := \"01000\"; signal rs1_value: std_logic_vector(31 downto 0) := (others=>'0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_migrating_predecode port map(original_parcel,fetch_pc,rs1_index,rs1_value,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n stim: process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00042403\" and original_length_bytes=\"10\" and next_pc=x\"00000102\" and redirect_valid='0' report \"migrating decoder must select admitted C.LW outcome\" severity failure; original_parcel<=x\"6105\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"02010113\" and next_pc=x\"00000102\" and redirect_valid='0' report \"migrating decoder must select C.ADDI16SP only through tag, x2, and nonzero-immediate legality\" severity failure; original_parcel<=x\"6101\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and next_pc=x\"00000102\" and redirect_valid='0' report \"reserved zero C.ADDI16SP must remain explicit illegal fallthrough\" severity failure; original_parcel<=x\"8082\"; rs1_index<=\"00001\"; rs1_value<=x\"00000205\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"00008067\" and redirect_valid='1' and redirect_target=x\"00000204\" and next_pc=x\"00000204\" report \"C.JR must use the matching rs1 read and clear JALR bit zero\" severity failure; original_parcel<=x\"9082\"; rs1_value<=x\"00000307\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"000080E7\" and redirect_valid='1' and redirect_target=x\"00000306\" and next_pc=x\"00000306\" report \"C.JALR must use the matching rs1 read and clear JALR bit zero\" severity failure; original_parcel<=x\"9002\"; rs1_index<=\"00000\"; rs1_value<=(others=>'0'); wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and redirect_valid='0' and redirect_target=x\"00000100\" and next_pc=x\"00000102\" report \"C.EBREAK must remain outside the non-trap product closure\" severity failure; original_parcel<=x\"8082\"; rs1_index<=\"00010\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and redirect_valid='0' and redirect_target=x\"00000100\" and next_pc=x\"00000102\" report \"C.JR index mismatch must fail closed\" severity failure; finish; end process;\nend architecture;\n"

fn migrating_predecode_rv64_partition_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_migrating_predecode_rv64_tb is end entity;\narchitecture tb of strict_migrating_predecode_rv64_tb is\n signal original_parcel: std_logic_vector(15 downto 0):=x\"8082\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(55 downto 0):=x\"00000000000100\"; signal rs1_index: std_logic_vector(4 downto 0):=\"00001\"; signal rs1_value: std_logic_vector(63 downto 0):=x\"0000000000000205\"; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_migrating_predecode_rv64 port map(original_parcel,fetch_pc,rs1_index,rs1_value,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target);\n process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00008067\" and redirect_valid='1' and redirect_target=x\"00000000000204\" report \"RV64 C.JR must win its disjoint rs2=x0 partition\" severity failure; original_parcel<=x\"9082\"; rs1_value<=x\"0000000000000307\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"000080E7\" and redirect_valid='1' and redirect_target=x\"00000000000306\" report \"RV64 C.JALR must win its disjoint rs2=x0 partition\" severity failure; original_parcel<=x\"9002\"; rs1_index<=\"00000\"; rs1_value<=(others=>'0'); wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and redirect_valid='0' and next_pc=x\"00000000000102\" and redirect_target=x\"00000000000100\" report \"RV64 non-trap closure must fail C.EBREAK closed\" severity failure; finish; end process;\nend architecture;\n"

fn cbreak_trap_predecode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity strict_cebreak_trap_predecode_tb is end entity;\narchitecture tb of strict_cebreak_trap_predecode_tb is\n signal original_parcel: std_logic_vector(15 downto 0) := x\"9002\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0) := x\"00000100\"; signal rs1_index: std_logic_vector(4 downto 0) := (others=>'0'); signal rs1_value: std_logic_vector(31 downto 0) := (others=>'0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid,trap_valid: std_logic; signal trap_cause,trap_tval: std_logic_vector(31 downto 0);\nbegin\n dut: entity work.strict_cebreak_trap_predecode port map(original_parcel,fetch_pc,rs1_index,rs1_value,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);\n stim: process begin wait for 1 ns; assert legal='1' and canonical_instruction=x\"00100073\" and original_length_bytes=\"10\" and next_pc=x\"00000102\" and redirect_valid='0' and trap_valid='1' and trap_cause=x\"00000003\" and trap_tval=x\"00000000\" report \"C.EBREAK must remain legal and request precise breakpoint cause three\" severity failure; original_parcel<=x\"0001\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and trap_valid='0' and trap_cause=x\"00000000\" and trap_tval=x\"00000000\" report \"non-C.EBREAK parcels must not fabricate a trap effect\" severity failure; finish; end process;\nend architecture;\n"


fn trap_stateful_protocol_64_testbench(entity_name: text, testbench_name: text, address_bits: i32,
    xlen: i32, pc_literal: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity " + testbench_name + " is end entity;\narchitecture tb of " + testbench_name + " is\n signal clk: std_logic := '0'; signal rst: std_logic := '1'; signal fetch_valid: std_logic := '0'; signal fetch_parcel: std_logic_vector(15 downto 0) := (others=>'0'); signal fetch_pc: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0) := (others=>'0'); signal rs1_index: std_logic_vector(4 downto 0) := (others=>'0'); signal rs1_value: std_logic_vector(" + (xlen - 1).to_text() + " downto 0) := (others=>'0'); signal dispatch_accept,retire_valid: std_logic := '0'; signal retire_lineage,dispatch_lineage: std_logic_vector(63 downto 0) := (others=>'0'); signal retire_original_parcel: std_logic_vector(15 downto 0) := x\"9002\"; signal retire_canonical_instruction: std_logic_vector(31 downto 0) := x\"00100073\"; signal retire_original_length_bytes: std_logic_vector(1 downto 0) := \"10\"; signal fetch_ready,dispatch_valid,protocol_fault: std_logic; signal original_parcel: std_logic_vector(15 downto 0); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid,trap_valid: std_logic; signal next_pc,redirect_target: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0); signal trap_cause,trap_tval: std_logic_vector(" + (xlen - 1).to_text() + " downto 0);\nbegin\n clk<=not clk after 5 ns;\n dut: entity work." + entity_name + " port map(clk,rst,fetch_valid,fetch_parcel,fetch_pc,rs1_index,rs1_value,dispatch_accept,retire_valid,retire_lineage,retire_original_parcel,retire_canonical_instruction,retire_original_length_bytes,fetch_ready,dispatch_valid,dispatch_lineage,protocol_fault,original_parcel,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);\n stim: process begin\n  wait until rising_edge(clk); rst<='0'; retire_valid<='1'; retire_lineage<=x\"0000000000000000\";\n  wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' and trap_valid='0' report \"early retirement must fault without an externally visible trap\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' and trap_valid='0' report \"reset must recover an early-retirement fault\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + "; wait until rising_edge(clk); fetch_valid<='1'; fetch_parcel<=x\"0001\";\n  wait for 1 ns; assert dispatch_valid='1' and fetch_ready='0' and original_parcel=x\"9002\" and canonical_instruction=x\"00100073\" and legal='1' and trap_valid='1' and trap_cause=std_logic_vector(to_unsigned(3," + xlen.to_text() + ")) and trap_tval=(trap_tval'range=>'0') report \"captured C.EBREAK must expose one precise stable dispatch effect\" severity failure;\n  wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert dispatch_valid='1' and original_parcel=x\"9002\" and canonical_instruction=x\"00100073\" and trap_valid='1' report \"backpressure must hold the captured C.EBREAK payload and trap effect stable\" severity failure;\n  dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; wait for 1 ns; assert dispatch_valid='0' and fetch_ready='0' and trap_valid='0' and trap_cause=(trap_cause'range=>'0') and trap_tval=(trap_tval'range=>'0') report \"accepted dispatch must block fetch and hide the retired C.EBREAK effect\" severity failure;\n  retire_valid<='1'; retire_lineage<=dispatch_lineage; wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' and trap_valid='0' report \"matching retirement must release exactly one frontend entry\" severity failure;\n  retire_valid<='1'; wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' and trap_valid='0' report \"repeated matching retirement must become a sticky fault\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' report \"reset must recover a repeated-retirement fault\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + "; wait until rising_edge(clk); fetch_valid<='0'; dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; wait for 1 ns;\n  retire_valid<='1'; retire_lineage<=std_logic_vector(unsigned(dispatch_lineage)+1); wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' and trap_valid='0' report \"mismatched retirement must make a sticky fault without stale C.EBREAK output\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"0001\"; wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' and original_parcel=(original_parcel'range=>'0') and trap_valid='0' report \"faulted frontend must refuse a new fetch and keep stale effects hidden\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' and trap_valid='0' report \"only reset may recover the protocol and clear all trap effects\" severity failure; finish; end process;\nend architecture;\n"

# This companion vector deliberately uses two clean transactions before the
# fault vector.  It makes lineage advancement and reset dominance observable
# in the generated RV32 and RV64 products, rather than inferring them from a
# single retirement.
fn trap_stateful_reuse_reset_64_testbench(entity_name: text, testbench_name: text, address_bits: i32,
    xlen: i32, pc_literal: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\nentity " + testbench_name + " is end entity;\narchitecture tb of " + testbench_name + " is\n signal clk: std_logic := '0'; signal rst: std_logic := '1'; signal fetch_valid: std_logic := '0'; signal fetch_parcel: std_logic_vector(15 downto 0) := (others=>'0'); signal fetch_pc: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0) := (others=>'0'); signal rs1_index: std_logic_vector(4 downto 0) := (others=>'0'); signal rs1_value: std_logic_vector(" + (xlen - 1).to_text() + " downto 0) := (others=>'0'); signal dispatch_accept,retire_valid: std_logic := '0'; signal retire_lineage,dispatch_lineage: std_logic_vector(63 downto 0) := (others=>'0'); signal retire_original_parcel: std_logic_vector(15 downto 0) := x\"9002\"; signal retire_canonical_instruction: std_logic_vector(31 downto 0) := x\"00100073\"; signal retire_original_length_bytes: std_logic_vector(1 downto 0) := \"10\"; signal fetch_ready,dispatch_valid,protocol_fault: std_logic; signal original_parcel: std_logic_vector(15 downto 0); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid,trap_valid: std_logic; signal next_pc,redirect_target: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0); signal trap_cause,trap_tval: std_logic_vector(" + (xlen - 1).to_text() + " downto 0);\nbegin\n clk<=not clk after 5 ns;\n dut: entity work." + entity_name + " port map(clk,rst,fetch_valid,fetch_parcel,fetch_pc,rs1_index,rs1_value,dispatch_accept,retire_valid,retire_lineage,retire_original_parcel,retire_canonical_instruction,retire_original_length_bytes,fetch_ready,dispatch_valid,dispatch_lineage,protocol_fault,original_parcel,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);\n stim: process\n  variable first_lineage: std_logic_vector(63 downto 0);\n  variable second_lineage: std_logic_vector(63 downto 0);\n begin\n  wait until rising_edge(clk); rst<='0'; fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + ";\n  wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert dispatch_valid='1' and trap_valid='1' and protocol_fault='0' report \"first clean dispatch must expose a precise C.EBREAK effect\" severity failure; first_lineage:=dispatch_lineage;\n  dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_valid<='1'; retire_lineage<=first_lineage;\n  wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert fetch_ready='1' and protocol_fault='0' and dispatch_valid='0' report \"first matching retirement must reopen the frontend without a fault\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + "; wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert dispatch_valid='1' and dispatch_lineage=std_logic_vector(unsigned(first_lineage)+1) and trap_valid='1' report \"second clean dispatch must reuse the frontend with an incremented 64-bit lineage\" severity failure; second_lineage:=dispatch_lineage;\n  dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_valid<='1'; retire_lineage<=second_lineage;\n  wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert fetch_ready='1' and protocol_fault='0' and dispatch_valid='0' report \"second matching retirement must prove consecutive clean reuse\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + "; wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert dispatch_valid='1' and protocol_fault='0' report \"identity-mismatch setup must hold one live dispatch\" severity failure;\n  dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_valid<='1'; retire_lineage<=dispatch_lineage; retire_canonical_instruction<=x\"00000013\";\n  wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' and dispatch_valid='0' and trap_valid='0' report \"same-lineage retirement with wrong canonical identity must become a sticky fault\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; retire_canonical_instruction<=x\"00100073\"; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' report \"reset must recover an identity-mismatch fault\" severity failure;\n  fetch_valid<='1'; fetch_parcel<=x\"9002\"; fetch_pc<=" + pc_literal + "; wait until rising_edge(clk); fetch_valid<='0'; wait for 1 ns; assert dispatch_valid='1' and protocol_fault='0' report \"reset-priority setup must hold one live dispatch\" severity failure;\n  dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_valid<='1'; retire_lineage<=dispatch_lineage; rst<='1';\n  wait until rising_edge(clk); rst<='0'; retire_valid<='0'; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' and dispatch_valid='0' and trap_valid='0' report \"reset must dominate a same-edge matching retirement and clear the frontend\" severity failure; finish; end process;\nend architecture;\n"

fn trap_stateful_identity_fault_testbench(entity_name: text, testbench_name: text,
    address_bits: i32, xlen: i32, pc_literal: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity " + testbench_name + " is end entity;\narchitecture tb of " + testbench_name + " is\n signal clk: std_logic := '0'; signal rst,fetch_valid,dispatch_accept,retire_valid: std_logic := '0'; signal fetch_parcel,retire_original_parcel,original_parcel: std_logic_vector(15 downto 0) := x\"9002\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0) := " + pc_literal + "; signal rs1_index: std_logic_vector(4 downto 0) := (others=>'0'); signal rs1_value,trap_cause,trap_tval: std_logic_vector(" + (xlen - 1).to_text() + " downto 0) := (others=>'0'); signal retire_lineage,dispatch_lineage: std_logic_vector(63 downto 0) := (others=>'0'); signal retire_canonical_instruction: std_logic_vector(31 downto 0) := x\"00100073\"; signal retire_original_length_bytes: std_logic_vector(1 downto 0) := \"10\"; signal fetch_ready,dispatch_valid,protocol_fault,legal,redirect_valid,trap_valid: std_logic; signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0);\nbegin\n clk<=not clk after 5 ns;\n dut: entity work." + entity_name + " port map(clk,rst,fetch_valid,fetch_parcel,fetch_pc,rs1_index,rs1_value,dispatch_accept,retire_valid,retire_lineage,retire_original_parcel,retire_canonical_instruction,retire_original_length_bytes,fetch_ready,dispatch_valid,dispatch_lineage,protocol_fault,original_parcel,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);\n stim: process begin\n  rst<='1'; wait until rising_edge(clk); rst<='0';\n  fetch_valid<='1'; wait until rising_edge(clk); fetch_valid<='0'; dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_lineage<=dispatch_lineage; retire_original_parcel<=x\"0001\"; retire_valid<='1'; wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' report \"same-lineage wrong parcel must fault\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; retire_original_parcel<=x\"9002\"; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' report \"reset must recover wrong parcel\" severity failure;\n  fetch_valid<='1'; wait until rising_edge(clk); fetch_valid<='0'; dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_lineage<=dispatch_lineage; retire_canonical_instruction<=x\"00000013\"; retire_valid<='1'; wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' report \"same-lineage wrong canonical instruction must fault\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; retire_canonical_instruction<=x\"00100073\"; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' report \"reset must recover wrong canonical instruction\" severity failure;\n  fetch_valid<='1'; wait until rising_edge(clk); fetch_valid<='0'; dispatch_accept<='1'; wait until rising_edge(clk); dispatch_accept<='0'; retire_lineage<=dispatch_lineage; retire_original_length_bytes<=\"00\"; retire_valid<='1'; wait until rising_edge(clk); retire_valid<='0'; wait for 1 ns; assert protocol_fault='1' and fetch_ready='0' report \"same-lineage wrong length must fault\" severity failure;\n  rst<='1'; wait until rising_edge(clk); rst<='0'; retire_original_length_bytes<=\"10\"; wait for 1 ns; assert protocol_fault='0' and fetch_ready='1' report \"reset must recover wrong length\" severity failure; finish; end process;\nend architecture;\n"

fn rv64_full_trap_decoder_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_rv64_full_trap_decoder_tb is end entity;\narchitecture tb of strict_rv64_full_trap_decoder_tb is\n signal original_parcel: std_logic_vector(15 downto 0):=x\"6480\"; signal fetch_pc,next_pc,redirect_target: std_logic_vector(55 downto 0):=x\"00000000000100\"; signal rs1_index: std_logic_vector(4 downto 0):=(others=>'0'); signal rs1_value: std_logic_vector(63 downto 0):=(others=>'0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid,trap_valid: std_logic; signal trap_cause,trap_tval: std_logic_vector(63 downto 0);\nbegin\n dut: entity work.riscv_gen2_zca_rv64_addiw_trap_migrating_predecode port map(original_parcel,fetch_pc,rs1_index,rs1_value,canonical_instruction,original_length_bytes,legal,next_pc,redirect_valid,redirect_target,trap_valid,trap_cause,trap_tval);\n process begin\n  wait for 1 ns; assert legal='1' and canonical_instruction=x\"0084B403\" and trap_valid='0' report \"C.LD must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"E880\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"0084B823\" report \"C.SD must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"6522\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"00813503\" report \"C.LDSP must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"E42A\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"00A13423\" report \"C.SDSP must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"9C21\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"0084043B\" report \"C.ADDW must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"9C01\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"4084043B\" report \"C.SUBW must participate in the RV64 product\" severity failure;\n  original_parcel<=x\"1082\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"02009093\" report \"RV64 C.SLLI must retain shamt bit five\" severity failure;\n  original_parcel<=x\"9002\"; wait for 1 ns; assert legal='1' and canonical_instruction=x\"00100073\" and trap_valid='1' and trap_cause=x\"0000000000000003\" report \"C.EBREAK must remain the sole trap row\" severity failure;\n  original_parcel<=x\"0000\"; wait for 1 ns; assert legal='0' and canonical_instruction=x\"00000000\" and trap_valid='0' report \"unadmitted parcel must fail closed\" severity failure; finish; end process;\nend architecture;\n"

fn parcel_field_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_parcel_field_tb is\nend entity strict_parcel_field_tb;\n\narchitecture tb of strict_parcel_field_tb is\n    signal parcel : std_logic_vector(31 downto 0) := std_logic_vector(to_unsigned(40960, 32));\n    signal field : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_parcel_field\n        port map (parcel => parcel, field => field);\n    stim: process\n    begin\n        wait for 1 ns;\n        assert field = std_logic_vector(to_unsigned(5, 32))\n            report \"expected parcel field 5\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn parcel_left_shift_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_parcel_left_shift_tb is\nend entity strict_parcel_left_shift_tb;\n\narchitecture tb of strict_parcel_left_shift_tb is\n    signal parcel : std_logic_vector(31 downto 0) := std_logic_vector(to_unsigned(19, 32));\n    signal shifted : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_parcel_left_shift\n        port map (parcel => parcel, shifted => shifted);\n    stim: process\n    begin\n        wait for 1 ns;\n        assert shifted = std_logic_vector(to_unsigned(2432, 32))\n            report \"expected parcel left shift by seven\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cbreak_decode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cebreak_decode_tb is\nend entity strict_cebreak_decode_tb;\n\narchitecture tb of strict_cebreak_decode_tb is\n    signal parcel : std_logic_vector(31 downto 0) := std_logic_vector(to_unsigned(36866, 32));\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cebreak_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n    begin\n        wait for 1 ns;\n        assert canonical_instruction = std_logic_vector(to_unsigned(1048691, 32))\n            report \"expected canonical EBREAK for parcel 0x9002\" severity failure;\n        parcel <= std_logic_vector(to_unsigned(1, 32));\n        wait for 1 ns;\n        assert canonical_instruction = std_logic_vector(to_unsigned(0, 32))\n            report \"expected illegal canonical value for a non-EBREAK parcel\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cbreak_leaf_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cebreak_leaf_tb is\nend entity strict_cebreak_leaf_tb;\n\narchitecture tb of strict_cebreak_leaf_tb is\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cebreak_leaf\n        port map (canonical_instruction => canonical_instruction);\n    stim: process\n    begin\n        wait for 1 ns;\n        assert canonical_instruction = std_logic_vector(to_unsigned(1048691, 32))\n            report \"expected canonical EBREAK\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn caddi_decode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_caddi_decode_tb is\nend entity strict_caddi_decode_tb;\n\narchitecture tb of strict_caddi_decode_tb is\n    signal parcel : std_logic_vector(31 downto 0) := x\"00000001\";\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_caddi_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n    begin\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000013\" report \"C.NOP must become ADDI x0,x0,0\" severity failure;\n        parcel <= x\"00000505\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00150513\" report \"C.ADDI x10,1 canonical value\" severity failure;\n        parcel <= x\"000010FD\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"FFF08093\" report \"negative C.ADDI immediate sign extension\" severity failure;\n        parcel <= x\"00000FFD\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"01FF8F93\" report \"positive C.ADDI immediate extraction\" severity failure;\n        parcel <= x\"00001585\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"FE158593\" report \"negative C.ADDI rd and immediate extraction\" severity failure;\n        parcel <= x\"00004001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"non-C.ADDI parcel must remain unclassified\" severity failure;\n        parcel <= x\"00000013\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"32-bit prefix must not decode as C.ADDI\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn caddi_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_caddi_decode_exhaustive_tb is\nend entity strict_caddi_decode_exhaustive_tb;\n\narchitecture tb of strict_caddi_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_caddi_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable imm12 : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for imm in 0 to 63 loop\n                parcel_word := to_unsigned(((imm / 32) * 4096) + (rd * 128) + ((imm mod 32) * 4) + 1, 32);\n                if imm >= 32 then\n                    imm12 := to_unsigned(imm + 4032, 32);\n                else\n                    imm12 := to_unsigned(imm, 32);\n                end if;\n                expected := shift_left(imm12, 20) or shift_left(to_unsigned(rd, 32), 15) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(19, 32);\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"C.ADDI exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        finish;\n    end process;\nend architecture tb;\n"

fn caddi16sp_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_caddi16sp_decode_exhaustive_tb is\nend entity strict_caddi16sp_decode_exhaustive_tb;\n\narchitecture tb of strict_caddi16sp_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_caddi16sp_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable imm12 : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for imm in 0 to 63 loop\n            parcel_word := to_unsigned(24577 + ((imm / 32) * 4096) + (((imm / 16) mod 2) * 64) + (((imm / 8) mod 2) * 32) + (((imm / 2) mod 4) * 8) + ((imm mod 2) * 4) + 256, 32);\n            imm12 := shift_left(to_unsigned(imm / 32, 32), 9) or shift_left(to_unsigned((imm / 4) mod 2, 32), 8) or shift_left(to_unsigned((imm / 2) mod 2, 32), 7) or shift_left(to_unsigned((imm / 8) mod 2, 32), 6) or shift_left(to_unsigned(imm mod 2, 32), 5) or shift_left(to_unsigned((imm / 16) mod 2, 32), 4);\n            if imm >= 32 then\n                imm12 := imm12 or to_unsigned(3072, 32);\n            end if;\n            if imm = 0 then\n                expected := to_unsigned(0, 32);\n            else\n                expected := shift_left(imm12, 20) or to_unsigned(65811, 32);\n            end if;\n            parcel <= std_logic_vector(parcel_word);\n            wait for 1 ns;\n            assert unsigned(canonical_instruction) = expected\n                report \"C.ADDI16SP exhaustive canonical mismatch\" severity failure;\n        end loop;\n        parcel <= x\"00006185\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.LUI must stay outside C.ADDI16SP\" severity failure;\n        parcel <= x\"00006001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"zero C.ADDI16SP immediate is reserved\" severity failure;\n        parcel <= x\"00000001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.ADDI must stay outside C.ADDI16SP\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn clui_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_clui_decode_exhaustive_tb is\nend entity strict_clui_decode_exhaustive_tb;\n\narchitecture tb of strict_clui_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_clui_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable imm20 : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for imm in 0 to 63 loop\n                parcel_word := to_unsigned(24577 + ((imm / 32) * 4096) + (rd * 128) + ((imm mod 32) * 4), 32);\n                imm20 := to_unsigned(imm, 32);\n                if imm >= 32 then\n                    imm20 := imm20 or to_unsigned(1048512, 32);\n                end if;\n                if rd = 0 or rd = 2 or imm = 0 then\n                    expected := to_unsigned(0, 32);\n                else\n                    expected := shift_left(imm20, 12) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(55, 32);\n                end if;\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"C.LUI exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00006101\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.ADDI16SP must stay outside C.LUI\" severity failure;\n        parcel <= x\"00006181\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"zero C.LUI immediate is reserved\" severity failure;\n        parcel <= x\"00006001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.LUI rd=x0 is reserved\" severity failure;\n        parcel <= x\"00000001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.ADDI must stay outside C.LUI\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn addi4spn_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_addi4spn_decode_exhaustive_tb is\nend entity strict_addi4spn_decode_exhaustive_tb;\n\narchitecture tb of strict_addi4spn_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_addi4spn_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable immediate : natural;\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rdp in 0 to 7 loop\n            for raw in 0 to 255 loop\n                parcel_word := to_unsigned((raw * 32) + (rdp * 4), 32);\n                immediate := (((raw / 4) mod 16) * 64) + ((raw / 64) * 16) + ((raw mod 2) * 8) + (((raw / 2) mod 2) * 4);\n                if immediate = 0 then\n                    expected := to_unsigned(0, 32);\n                else\n                    expected := shift_left(to_unsigned(immediate, 32), 20) or to_unsigned(65536, 32) or shift_left(to_unsigned(rdp + 8, 32), 7) or to_unsigned(19, 32);\n                end if;\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"C.ADDI4SPN exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00000001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"non-C.ADDI4SPN parcel must remain unclassified\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn lw_exhaustive_testbench() -> text:
