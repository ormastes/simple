    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cjr_decode_exhaustive_tb is\nend entity strict_cjr_decode_exhaustive_tb;\n\narchitecture tb of strict_cjr_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cjr_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rs1 in 0 to 31 loop\n            parcel_word := to_unsigned(32770 + (rs1 * 128), 32);\n            if rs1 = 0 then\n                expected := to_unsigned(0, 32);\n            else\n                expected := shift_left(to_unsigned(rs1, 32), 15) or to_unsigned(103, 32);\n            end if;\n            parcel <= std_logic_vector(parcel_word);\n            wait for 1 ns;\n            assert unsigned(canonical_instruction) = expected\n                report \"C.JR exhaustive canonical mismatch\" severity failure;\n        end loop;\n        parcel <= x\"00008002\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JR rd=x0 is reserved\" severity failure;\n        parcel <= x\"00008086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.MV must stay outside the C.JR row\" severity failure;\n        parcel <= x\"00009082\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"bit12-set C.JALR must stay outside the C.JR row\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

