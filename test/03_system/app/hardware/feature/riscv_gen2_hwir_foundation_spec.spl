    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cmv_decode_exhaustive_tb is\nend entity strict_cmv_decode_exhaustive_tb;\n\narchitecture tb of strict_cmv_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cmv_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for rs2 in 1 to 31 loop\n                parcel_word := to_unsigned(32770 + (rd * 128) + (rs2 * 4), 32);\n                if rd = 0 then\n                    expected := to_unsigned(19, 32);\n                else\n                    expected := shift_left(to_unsigned(rs2, 32), 20) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(51, 32);\n                end if;\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"C.MV exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00008082\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JR must stay outside the C.MV row\" severity failure;\n        parcel <= x\"00008002\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"reserved rd=x0/rs2=x0 must remain outside C.MV\" severity failure;\n        parcel <= x\"00009086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"bit12-set C.ADD must stay outside the C.MV row\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cjalr_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cjalr_decode_exhaustive_tb is\nend entity strict_cjalr_decode_exhaustive_tb;\n\narchitecture tb of strict_cjalr_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cjalr_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rs1 in 0 to 31 loop\n            parcel_word := to_unsigned(36866 + (rs1 * 128), 32);\n            if rs1 = 0 then\n                expected := to_unsigned(0, 32);\n            else\n                expected := shift_left(to_unsigned(rs1, 32), 15) or to_unsigned(231, 32);\n            end if;\n            parcel <= std_logic_vector(parcel_word);\n            wait for 1 ns;\n            assert unsigned(canonical_instruction) = expected\n                report \"C.JALR exhaustive canonical mismatch\" severity failure;\n        end loop;\n        parcel <= x\"00009002\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JALR rd=x0 is reserved\" severity failure;\n        parcel <= x\"00008082\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JR must stay outside the C.JALR row\" severity failure;\n        parcel <= x\"00008086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.MV must stay outside the C.JALR row\" severity failure;\n        parcel <= x\"00009086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.ADD must stay outside the C.JALR row\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cadd_rv32_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cadd_rv32_decode_exhaustive_tb is\nend entity strict_cadd_rv32_decode_exhaustive_tb;\n\narchitecture tb of strict_cadd_rv32_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cadd_rv32_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for rs2 in 1 to 31 loop\n                parcel_word := to_unsigned(36866 + (rd * 128) + (rs2 * 4), 32);\n                if rd = 0 then\n                    expected := to_unsigned(19, 32);\n                else\n                    expected := shift_left(to_unsigned(rs2, 32), 20) or shift_left(to_unsigned(rd, 32), 15) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(51, 32);\n                end if;\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"RV32 C.ADD exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00009082\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JALR must stay outside C.ADD\" severity failure;\n        parcel <= x\"00008086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.MV must stay outside C.ADD\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cadd_rv64_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cadd_rv64_decode_exhaustive_tb is\nend entity strict_cadd_rv64_decode_exhaustive_tb;\n\narchitecture tb of strict_cadd_rv64_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cadd_rv64_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for rs2 in 1 to 31 loop\n                parcel_word := to_unsigned(36866 + (rd * 128) + (rs2 * 4), 32);\n                expected := shift_left(to_unsigned(rs2, 32), 20) or shift_left(to_unsigned(rd, 32), 15) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(51, 32);\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"RV64 C.ADD exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00009082\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.JALR must stay outside C.ADD\" severity failure;\n        parcel <= x\"00008086\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"C.MV must stay outside C.ADD\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cli_exhaustive_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cli_decode_exhaustive_tb is\nend entity strict_cli_decode_exhaustive_tb;\n\narchitecture tb of strict_cli_decode_exhaustive_tb is\n    signal parcel : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cli_decode\n        port map (parcel => parcel, canonical_instruction => canonical_instruction);\n    stim: process\n        variable parcel_word : unsigned(31 downto 0);\n        variable imm12 : unsigned(31 downto 0);\n        variable expected : unsigned(31 downto 0);\n    begin\n        for rd in 0 to 31 loop\n            for imm in 0 to 63 loop\n                parcel_word := to_unsigned(16385 + ((imm / 32) * 4096) + (rd * 128) + ((imm mod 32) * 4), 32);\n                if imm >= 32 then\n                    imm12 := to_unsigned(imm + 4032, 32);\n                else\n                    imm12 := to_unsigned(imm, 32);\n                end if;\n                expected := shift_left(imm12, 20) or shift_left(to_unsigned(rd, 32), 7) or to_unsigned(19, 32);\n                parcel <= std_logic_vector(parcel_word);\n                wait for 1 ns;\n                assert unsigned(canonical_instruction) = expected\n                    report \"C.LI exhaustive canonical mismatch\" severity failure;\n            end loop;\n        end loop;\n        parcel <= x\"00000001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" report \"non-C.LI parcel must remain unclassified\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cj_predecode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cj_predecode_tb is\nend entity strict_cj_predecode_tb;\n\narchitecture tb of strict_cj_predecode_tb is\n    signal original_parcel : std_logic_vector(15 downto 0) := (others => '0');\n    signal fetch_pc : std_logic_vector(31 downto 0) := (others => '0');\n    signal canonical_instruction : std_logic_vector(31 downto 0);\n    signal original_length_bytes : std_logic_vector(1 downto 0);\n    signal legal : std_logic;\n    signal next_pc : std_logic_vector(31 downto 0);\n    signal redirect_valid : std_logic;\n    signal redirect_target : std_logic_vector(31 downto 0);\nbegin\n    dut: entity work.strict_cj_predecode\n        port map (original_parcel => original_parcel, fetch_pc => fetch_pc, canonical_instruction => canonical_instruction, original_length_bytes => original_length_bytes, legal => legal, next_pc => next_pc, redirect_valid => redirect_valid, redirect_target => redirect_target);\n    stim: process\n    begin\n        fetch_pc <= x\"00000100\";\n        original_parcel <= x\"A009\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"0020006F\" report \"C.J positive canonical mismatch\" severity failure;\n        assert legal = '1' and redirect_valid = '1' report \"C.J must be legal and redirect\" severity failure;\n        assert original_length_bytes = \"10\" report \"C.J parcel length mismatch\" severity failure;\n        assert next_pc = x\"00000102\" and redirect_target = x\"00000102\" report \"C.J positive redirect mismatch\" severity failure;\n        original_parcel <= x\"BFFD\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"FFFFF06F\" report \"C.J negative canonical mismatch\" severity failure;\n        assert next_pc = x\"000000FE\" and redirect_target = x\"000000FE\" report \"C.J negative redirect mismatch\" severity failure;\n        original_parcel <= x\"0001\";\n        wait for 1 ns;\n        assert canonical_instruction = x\"00000000\" and legal = '0' and redirect_valid = '0' report \"non-C.J must not redirect\" severity failure;\n        assert next_pc = x\"00000102\" and redirect_target = x\"00000100\" report \"non-C.J fallthrough mismatch\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cjal_rv32_predecode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_cjal_rv32_predecode_tb is end entity;\narchitecture tb of strict_cjal_rv32_predecode_tb is\n signal original_parcel: std_logic_vector(15 downto 0):=(others=>'0'); signal fetch_pc,next_pc,redirect_target: std_logic_vector(31 downto 0):=(others=>'0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_cjal_rv32_predecode port map(original_parcel=>original_parcel,fetch_pc=>fetch_pc,canonical_instruction=>canonical_instruction,original_length_bytes=>original_length_bytes,legal=>legal,next_pc=>next_pc,redirect_valid=>redirect_valid,redirect_target=>redirect_target);\n process begin fetch_pc<=x\"00000100\"; original_parcel<=x\"2009\"; wait for 1 ns; assert canonical_instruction=x\"002000EF\" and legal='1' and redirect_valid='1' and original_length_bytes=\"10\" and next_pc=x\"00000102\" and redirect_target=x\"00000102\" report \"RV32 C.JAL positive/link canonical mismatch\" severity failure; original_parcel<=x\"3FFD\"; wait for 1 ns; assert canonical_instruction=x\"FFFFF0EF\" and legal='1' and redirect_valid='1' and next_pc=x\"000000FE\" and redirect_target=x\"000000FE\" report \"RV32 C.JAL negative redirect mismatch\" severity failure; original_parcel<=x\"A009\"; wait for 1 ns; assert canonical_instruction=x\"00000000\" and legal='0' and redirect_valid='0' and next_pc=x\"00000102\" and redirect_target=x\"00000100\" report \"C.J must stay outside RV32 C.JAL row\" severity failure; finish; end process;\nend architecture;\n"

fn caddiw_rv64_predecode_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_caddiw_rv64_predecode_tb is end entity;\narchitecture tb of strict_caddiw_rv64_predecode_tb is\n signal original_parcel: std_logic_vector(15 downto 0):=(others=>'0'); signal fetch_pc,next_pc,redirect_target: std_logic_vector(55 downto 0):=(others=>'0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work.strict_caddiw_rv64_predecode port map(original_parcel=>original_parcel,fetch_pc=>fetch_pc,canonical_instruction=>canonical_instruction,original_length_bytes=>original_length_bytes,legal=>legal,next_pc=>next_pc,redirect_valid=>redirect_valid,redirect_target=>redirect_target);\n process begin fetch_pc<=x\"00000000000100\"; original_parcel<=x\"35FD\"; wait for 1 ns; assert canonical_instruction=x\"FFF5859B\" and legal='1' and redirect_valid='0' and original_length_bytes=\"10\" and next_pc=x\"00000000000102\" and redirect_target=x\"00000000000100\" report \"RV64 C.ADDIW signed canonical mismatch\" severity failure; original_parcel<=x\"2001\"; wait for 1 ns; assert canonical_instruction=x\"00000000\" and legal='0' and redirect_valid='0' and next_pc=x\"00000000000102\" and redirect_target=x\"00000000000100\" report \"RV64 C.ADDIW rd=x0 must remain illegal\" severity failure; original_parcel<=x\"2009\"; wait for 1 ns; assert canonical_instruction=x\"00000000\" and legal='0' report \"RV32 C.JAL class must not leak into RV64 C.ADDIW row\" severity failure; finish; end process;\nend architecture;\n"

fn control_predecode_testbench(entity_name: text, testbench_name: text, address_bits: i32,
    xlen: i32, pc_literal: text, plus_two_literal: text) -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity " + testbench_name + " is end entity;\narchitecture tb of " + testbench_name + " is\n signal original_parcel: std_logic_vector(15 downto 0) := (others => '0'); signal fetch_pc,next_pc,redirect_target: std_logic_vector(" + (address_bits - 1).to_text() + " downto 0) := (others => '0'); signal rs1_index: std_logic_vector(4 downto 0) := \"01000\"; signal rs1_value: std_logic_vector(" + (xlen - 1).to_text() + " downto 0) := (others => '0'); signal canonical_instruction: std_logic_vector(31 downto 0); signal original_length_bytes: std_logic_vector(1 downto 0); signal legal,redirect_valid: std_logic;\nbegin\n dut: entity work." + entity_name + " port map (original_parcel=>original_parcel,fetch_pc=>fetch_pc,canonical_instruction=>canonical_instruction,original_length_bytes=>original_length_bytes,legal=>legal,next_pc=>next_pc,redirect_valid=>redirect_valid,redirect_target=>redirect_target,rs1_index=>rs1_index,rs1_value=>rs1_value);\n process begin fetch_pc<=" + pc_literal + "; original_parcel<=x\"A009\"; wait for 1 ns; assert canonical_instruction=x\"0020006F\" and original_length_bytes=\"10\" and legal='1' and redirect_valid='1' and next_pc=" + plus_two_literal + " and redirect_target=" + plus_two_literal + " report \"C.J composition mismatch\" severity failure; original_parcel<=x\"C009\"; rs1_index<=\"01000\"; rs1_value<=(others=>'0'); wait for 1 ns; assert canonical_instruction=x\"00040163\" and legal='1' and redirect_valid='1' and next_pc=" + plus_two_literal + " report \"C.BEQZ composition mismatch\" severity failure; original_parcel<=x\"E009\"; rs1_value<=(others=>'1'); wait for 1 ns; assert canonical_instruction=x\"00041163\" and legal='1' and redirect_valid='1' and next_pc=" + plus_two_literal + " report \"C.BNEZ composition mismatch\" severity failure; original_parcel<=x\"C009\"; rs1_index<=\"01001\"; rs1_value<=(others=>'0'); wait for 1 ns; assert canonical_instruction=x\"00000000\" and legal='0' and redirect_valid='0' and next_pc=" + plus_two_literal + " and redirect_target=" + pc_literal + " report \"C.B index mismatch must fail closed\" severity failure; original_parcel<=x\"0001\"; wait for 1 ns; assert canonical_instruction=x\"00000000\" and legal='0' and redirect_valid='0' and original_length_bytes=\"10\" and next_pc=" + plus_two_literal + " and redirect_target=" + pc_literal + " report \"unsupported compressed parcel must fail closed\" severity failure; finish; end process;\nend architecture;\n"

fn cb_predecode_rv32_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cb_predecode_rv32_tb is\nend entity strict_cb_predecode_rv32_tb;\n\narchitecture tb of strict_cb_predecode_rv32_tb is\n    signal fetch_pc : std_logic_vector(31 downto 0) := (others => '0');\n    signal beqz_parcel : std_logic_vector(15 downto 0) := (others => '0');\n    signal bnez_parcel : std_logic_vector(15 downto 0) := (others => '0');\n    signal beqz_rs1_value : std_logic_vector(31 downto 0) := (others => '0');\n    signal bnez_rs1_value : std_logic_vector(31 downto 0) := (others => '0');\n    signal beqz_canonical_instruction : std_logic_vector(31 downto 0);\n    signal beqz_original_length_bytes : std_logic_vector(1 downto 0);\n    signal beqz_legal : std_logic;\n    signal beqz_next_pc : std_logic_vector(31 downto 0);\n    signal beqz_redirect_valid : std_logic;\n    signal beqz_redirect_target : std_logic_vector(31 downto 0);\n    signal bnez_canonical_instruction : std_logic_vector(31 downto 0);\n    signal bnez_original_length_bytes : std_logic_vector(1 downto 0);\n    signal bnez_legal : std_logic;\n    signal bnez_next_pc : std_logic_vector(31 downto 0);\n    signal bnez_redirect_valid : std_logic;\n    signal bnez_redirect_target : std_logic_vector(31 downto 0);\nbegin\n    beqz_dut: entity work.strict_cbeqz_predecode_rv32\n        port map (original_parcel => beqz_parcel, fetch_pc => fetch_pc, canonical_instruction => beqz_canonical_instruction, original_length_bytes => beqz_original_length_bytes, legal => beqz_legal, next_pc => beqz_next_pc, redirect_valid => beqz_redirect_valid, redirect_target => beqz_redirect_target, rs1_value => beqz_rs1_value);\n    bnez_dut: entity work.strict_cbnez_predecode_rv32\n        port map (original_parcel => bnez_parcel, fetch_pc => fetch_pc, canonical_instruction => bnez_canonical_instruction, original_length_bytes => bnez_original_length_bytes, legal => bnez_legal, next_pc => bnez_next_pc, redirect_valid => bnez_redirect_valid, redirect_target => bnez_redirect_target, rs1_value => bnez_rs1_value);\n    stim: process\n    begin\n        fetch_pc <= x\"00000100\";\n        beqz_parcel <= x\"C009\";\n        bnez_parcel <= x\"E009\";\n        beqz_rs1_value <= x\"00000000\";\n        bnez_rs1_value <= x\"00000001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"00040163\" and bnez_canonical_instruction = x\"00041163\" report \"RV32 positive C.B canonical mismatch\" severity failure;\n        assert beqz_original_length_bytes = \"10\" and bnez_original_length_bytes = \"10\" report \"RV32 C.B parcel length mismatch\" severity failure;\n        assert beqz_legal = '1' and bnez_legal = '1' and beqz_redirect_valid = '1' and bnez_redirect_valid = '1' report \"RV32 taken C.B rows must be legal and redirect\" severity failure;\n        assert beqz_next_pc = x\"00000102\" and bnez_next_pc = x\"00000102\" and beqz_redirect_target = x\"00000102\" and bnez_redirect_target = x\"00000102\" report \"RV32 positive C.B redirect mismatch\" severity failure;\n        beqz_rs1_value <= x\"00000001\";\n        bnez_rs1_value <= x\"00000000\";\n        wait for 1 ns;\n        assert beqz_redirect_valid = '0' and bnez_redirect_valid = '0' report \"RV32 opposite predicates must not redirect\" severity failure;\n        assert beqz_next_pc = x\"00000102\" and bnez_next_pc = x\"00000102\" and beqz_redirect_target = x\"00000100\" and bnez_redirect_target = x\"00000100\" report \"RV32 untaken C.B fallthrough mismatch\" severity failure;\n        beqz_parcel <= x\"DC7D\";\n        bnez_parcel <= x\"FC7D\";\n        beqz_rs1_value <= x\"00000000\";\n        bnez_rs1_value <= x\"00000001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"FE040FE3\" and bnez_canonical_instruction = x\"FE041FE3\" report \"RV32 negative C.B canonical mismatch\" severity failure;\n        assert beqz_redirect_valid = '1' and bnez_redirect_valid = '1' and beqz_next_pc = x\"000000FE\" and bnez_next_pc = x\"000000FE\" report \"RV32 negative C.B redirect mismatch\" severity failure;\n        fetch_pc <= x\"00000200\";\n        beqz_parcel <= x\"D001\";\n        bnez_parcel <= x\"F001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"F00400E3\" and bnez_canonical_instruction = x\"F00410E3\" report \"RV32 sign-extension C.B canonical mismatch\" severity failure;\n        assert beqz_redirect_valid = '1' and bnez_redirect_valid = '1' and beqz_next_pc = x\"00000100\" and bnez_next_pc = x\"00000100\" report \"RV32 sign-extension C.B redirect mismatch\" severity failure;\n        beqz_parcel <= x\"E009\";\n        bnez_parcel <= x\"C009\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"00000000\" and bnez_canonical_instruction = x\"00000000\" and beqz_legal = '0' and bnez_legal = '0' and beqz_redirect_valid = '0' and bnez_redirect_valid = '0' report \"RV32 cross-row parcels must fail closed\" severity failure;\n        assert beqz_next_pc = x\"00000202\" and bnez_next_pc = x\"00000202\" and beqz_redirect_target = x\"00000200\" and bnez_redirect_target = x\"00000200\" report \"RV32 non-row C.B fallthrough mismatch\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cb_predecode_rv64_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\nuse std.env.all;\n\nentity strict_cb_predecode_rv64_tb is\nend entity strict_cb_predecode_rv64_tb;\n\narchitecture tb of strict_cb_predecode_rv64_tb is\n    signal fetch_pc : std_logic_vector(55 downto 0) := (others => '0');\n    signal beqz_parcel : std_logic_vector(15 downto 0) := (others => '0');\n    signal bnez_parcel : std_logic_vector(15 downto 0) := (others => '0');\n    signal beqz_rs1_value : std_logic_vector(63 downto 0) := (others => '0');\n    signal bnez_rs1_value : std_logic_vector(63 downto 0) := (others => '0');\n    signal beqz_canonical_instruction : std_logic_vector(31 downto 0);\n    signal beqz_original_length_bytes : std_logic_vector(1 downto 0);\n    signal beqz_legal : std_logic;\n    signal beqz_next_pc : std_logic_vector(55 downto 0);\n    signal beqz_redirect_valid : std_logic;\n    signal beqz_redirect_target : std_logic_vector(55 downto 0);\n    signal bnez_canonical_instruction : std_logic_vector(31 downto 0);\n    signal bnez_original_length_bytes : std_logic_vector(1 downto 0);\n    signal bnez_legal : std_logic;\n    signal bnez_next_pc : std_logic_vector(55 downto 0);\n    signal bnez_redirect_valid : std_logic;\n    signal bnez_redirect_target : std_logic_vector(55 downto 0);\nbegin\n    beqz_dut: entity work.strict_cbeqz_predecode_rv64\n        port map (original_parcel => beqz_parcel, fetch_pc => fetch_pc, canonical_instruction => beqz_canonical_instruction, original_length_bytes => beqz_original_length_bytes, legal => beqz_legal, next_pc => beqz_next_pc, redirect_valid => beqz_redirect_valid, redirect_target => beqz_redirect_target, rs1_value => beqz_rs1_value);\n    bnez_dut: entity work.strict_cbnez_predecode_rv64\n        port map (original_parcel => bnez_parcel, fetch_pc => fetch_pc, canonical_instruction => bnez_canonical_instruction, original_length_bytes => bnez_original_length_bytes, legal => bnez_legal, next_pc => bnez_next_pc, redirect_valid => bnez_redirect_valid, redirect_target => bnez_redirect_target, rs1_value => bnez_rs1_value);\n    stim: process\n    begin\n        fetch_pc <= x\"00000000000100\";\n        beqz_parcel <= x\"C009\";\n        bnez_parcel <= x\"E009\";\n        beqz_rs1_value <= x\"0000000000000000\";\n        bnez_rs1_value <= x\"0000000000000001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"00040163\" and bnez_canonical_instruction = x\"00041163\" report \"RV64 positive C.B canonical mismatch\" severity failure;\n        assert beqz_original_length_bytes = \"10\" and bnez_original_length_bytes = \"10\" report \"RV64 C.B parcel length mismatch\" severity failure;\n        assert beqz_legal = '1' and bnez_legal = '1' and beqz_redirect_valid = '1' and bnez_redirect_valid = '1' report \"RV64 taken C.B rows must be legal and redirect\" severity failure;\n        assert beqz_next_pc = x\"00000000000102\" and bnez_next_pc = x\"00000000000102\" and beqz_redirect_target = x\"00000000000102\" and bnez_redirect_target = x\"00000000000102\" report \"RV64 positive C.B redirect mismatch\" severity failure;\n        beqz_rs1_value <= x\"0000000000000001\";\n        bnez_rs1_value <= x\"0000000000000000\";\n        wait for 1 ns;\n        assert beqz_redirect_valid = '0' and bnez_redirect_valid = '0' report \"RV64 opposite predicates must not redirect\" severity failure;\n        assert beqz_next_pc = x\"00000000000102\" and bnez_next_pc = x\"00000000000102\" and beqz_redirect_target = x\"00000000000100\" and bnez_redirect_target = x\"00000000000100\" report \"RV64 untaken C.B fallthrough mismatch\" severity failure;\n        beqz_parcel <= x\"DC7D\";\n        bnez_parcel <= x\"FC7D\";\n        beqz_rs1_value <= x\"0000000000000000\";\n        bnez_rs1_value <= x\"0000000000000001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"FE040FE3\" and bnez_canonical_instruction = x\"FE041FE3\" report \"RV64 negative C.B canonical mismatch\" severity failure;\n        assert beqz_redirect_valid = '1' and bnez_redirect_valid = '1' and beqz_next_pc = x\"000000000000FE\" and bnez_next_pc = x\"000000000000FE\" report \"RV64 negative C.B redirect mismatch\" severity failure;\n        fetch_pc <= x\"00000000000200\";\n        beqz_parcel <= x\"D001\";\n        bnez_parcel <= x\"F001\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"F00400E3\" and bnez_canonical_instruction = x\"F00410E3\" report \"RV64 sign-extension C.B canonical mismatch\" severity failure;\n        assert beqz_redirect_valid = '1' and bnez_redirect_valid = '1' and beqz_next_pc = x\"00000000000100\" and bnez_next_pc = x\"00000000000100\" report \"RV64 sign-extension C.B redirect mismatch\" severity failure;\n        beqz_parcel <= x\"E009\";\n        bnez_parcel <= x\"C009\";\n        wait for 1 ns;\n        assert beqz_canonical_instruction = x\"00000000\" and bnez_canonical_instruction = x\"00000000\" and beqz_legal = '0' and bnez_legal = '0' and beqz_redirect_valid = '0' and bnez_redirect_valid = '0' report \"RV64 cross-row parcels must fail closed\" severity failure;\n        assert beqz_next_pc = x\"00000000000202\" and bnez_next_pc = x\"00000000000202\" and beqz_redirect_target = x\"00000000000200\" and bnez_redirect_target = x\"00000000000200\" report \"RV64 non-row C.B fallthrough mismatch\" severity failure;\n        finish;\n    end process;\nend architecture tb;\n"

fn cb_index_binding_rv32_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_cb_index_binding_rv32_tb is end entity;\narchitecture tb of strict_cb_index_binding_rv32_tb is\n signal pc: std_logic_vector(31 downto 0) := (others => '0'); signal beqz_parcel,bnez_parcel: std_logic_vector(15 downto 0) := (others => '0'); signal beqz_index,bnez_index: std_logic_vector(4 downto 0) := \"01000\"; signal beqz_value,bnez_value: std_logic_vector(31 downto 0) := (others => '0'); signal beqz_insn,bnez_insn: std_logic_vector(31 downto 0); signal beqz_len,bnez_len: std_logic_vector(1 downto 0); signal beqz_legal,bnez_legal,beqz_redirect,bnez_redirect: std_logic; signal beqz_next,bnez_next,beqz_target,bnez_target: std_logic_vector(31 downto 0);\nbegin\n beqz: entity work.strict_cbeqz_predecode_rv32 port map (original_parcel=>beqz_parcel,fetch_pc=>pc,canonical_instruction=>beqz_insn,original_length_bytes=>beqz_len,legal=>beqz_legal,next_pc=>beqz_next,redirect_valid=>beqz_redirect,redirect_target=>beqz_target,rs1_index=>beqz_index,rs1_value=>beqz_value);\n bnez: entity work.strict_cbnez_predecode_rv32 port map (original_parcel=>bnez_parcel,fetch_pc=>pc,canonical_instruction=>bnez_insn,original_length_bytes=>bnez_len,legal=>bnez_legal,next_pc=>bnez_next,redirect_valid=>bnez_redirect,redirect_target=>bnez_target,rs1_index=>bnez_index,rs1_value=>bnez_value);\n process begin pc<=x\"00000100\"; beqz_parcel<=x\"C009\"; bnez_parcel<=x\"E009\"; beqz_value<=x\"00000000\"; bnez_value<=x\"00000001\"; wait for 1 ns; assert beqz_insn=x\"00040163\" and bnez_insn=x\"00041163\" and beqz_len=\"10\" and bnez_len=\"10\" and beqz_legal='1' and bnez_legal='1' and beqz_redirect='1' and bnez_redirect='1' report \"RV32 x8 index binding must admit both C.B rows\" severity failure; beqz_index<=\"01001\"; bnez_index<=\"01001\"; wait for 1 ns; assert beqz_insn=x\"00000000\" and bnez_insn=x\"00000000\" and beqz_legal='0' and bnez_legal='0' and beqz_redirect='0' and bnez_redirect='0' and beqz_next=x\"00000102\" and bnez_next=x\"00000102\" and beqz_target=x\"00000100\" and bnez_target=x\"00000100\" report \"RV32 mismatched rs1_index must fail closed\" severity failure; finish; end process;\nend architecture;\n"

fn cb_index_binding_rv64_testbench() -> text:
    "library ieee;\nuse ieee.std_logic_1164.all;\nuse std.env.all;\nentity strict_cb_index_binding_rv64_tb is end entity;\narchitecture tb of strict_cb_index_binding_rv64_tb is\n signal pc: std_logic_vector(55 downto 0) := (others => '0'); signal beqz_parcel,bnez_parcel: std_logic_vector(15 downto 0) := (others => '0'); signal beqz_index,bnez_index: std_logic_vector(4 downto 0) := \"01000\"; signal beqz_value,bnez_value: std_logic_vector(63 downto 0) := (others => '0'); signal beqz_insn,bnez_insn: std_logic_vector(31 downto 0); signal beqz_len,bnez_len: std_logic_vector(1 downto 0); signal beqz_legal,bnez_legal,beqz_redirect,bnez_redirect: std_logic; signal beqz_next,bnez_next,beqz_target,bnez_target: std_logic_vector(55 downto 0);\nbegin\n beqz: entity work.strict_cbeqz_predecode_rv64 port map (original_parcel=>beqz_parcel,fetch_pc=>pc,canonical_instruction=>beqz_insn,original_length_bytes=>beqz_len,legal=>beqz_legal,next_pc=>beqz_next,redirect_valid=>beqz_redirect,redirect_target=>beqz_target,rs1_index=>beqz_index,rs1_value=>beqz_value);\n bnez: entity work.strict_cbnez_predecode_rv64 port map (original_parcel=>bnez_parcel,fetch_pc=>pc,canonical_instruction=>bnez_insn,original_length_bytes=>bnez_len,legal=>bnez_legal,next_pc=>bnez_next,redirect_valid=>bnez_redirect,redirect_target=>bnez_target,rs1_index=>bnez_index,rs1_value=>bnez_value);\n process begin pc<=x\"00000000000100\"; beqz_parcel<=x\"C009\"; bnez_parcel<=x\"E009\"; beqz_value<=x\"0000000000000000\"; bnez_value<=x\"0000000000000001\"; wait for 1 ns; assert beqz_insn=x\"00040163\" and bnez_insn=x\"00041163\" and beqz_len=\"10\" and bnez_len=\"10\" and beqz_legal='1' and bnez_legal='1' and beqz_redirect='1' and bnez_redirect='1' report \"RV64 x8 index binding must admit both C.B rows\" severity failure; beqz_index<=\"01001\"; bnez_index<=\"01001\"; wait for 1 ns; assert beqz_insn=x\"00000000\" and bnez_insn=x\"00000000\" and beqz_legal='0' and bnez_legal='0' and beqz_redirect='0' and bnez_redirect='0' and beqz_next=x\"00000000000102\" and bnez_next=x\"00000000000102\" and beqz_target=x\"00000000000100\" and bnez_target=x\"00000000000100\" report \"RV64 mismatched rs1_index must fail closed\" severity failure; finish; end process;\nend architecture;\n"

describe "RISC-V Gen2 HWIR foundation":
    """A hardware product selects an XLEN during elaboration and emits a typed,
    deterministic module without reaching the legacy VHDL route."""

    # @req REQ-G2-007 REQ-G2-008 NFR-G2-007 NFR-G2-008 NFR-G2-009
    it "should expose the fixed-width critical compressed subset without a full-Zca claim":
        # @req: REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should expose the fixed-width critical compressed subset without a full-Zca claim")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Classify representative legal and illegal parcels through the text-free hardware boundary")
        val ebreak = riscv_zca_mission_critical_expand_hardware(0x9002)
        val illegal = riscv_zca_mission_critical_expand_hardware(0x0000)
        expect(ebreak.original_parcel).to_equal(0x9002)
        expect(ebreak.canonical_instruction).to_equal(0x00100073)
        expect(ebreak.length_bytes).to_equal(2)  # oracle: pinned constant asserted by this scenario
        expect(ebreak.legal).to_equal(true)
        expect(ebreak.reason_code).to_equal(COMPRESSED_REASON_NONE)
        expect(illegal.original_parcel).to_equal(0x0000)
        expect(illegal.canonical_instruction).to_equal(0)  # oracle: pinned constant asserted by this scenario
        expect(illegal.legal).to_equal(false)
        step("Derive the non-advertising capability boundary from the declarative ISA table")
        val manifest = CompressedCriticalSubsetManifest.mission_critical_common_zca_v1()
        expect(riscv_zca_critical_subset_entry_count()).to_equal(25)  # oracle: pinned constant asserted by this scenario
        expect(riscv_zca_critical_subset_entries().len()).to_equal(25)  # oracle: pinned constant asserted by this scenario
        expect(manifest.verified_entry_count).to_equal(25)  # oracle: pinned constant asserted by this scenario
        expect(manifest.advertises_extension).to_equal(false)
        expect(manifest.legacy_fallback_allowed).to_equal(false)
        expect(manifest.target_rtl_equivalence_verified).to_equal(false)
        expect(manifest.is_release_claimable()).to_equal(false)

    # @req REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-004 REQ-G2-005 NFR-G2-005
    # @capture exec
    # @capture artifact
    it "should emit an RV32 strict module":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-004 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should emit an RV32 strict module")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Select an RV32 Gen2 hardware product")
        val lower = lower_strict_hwir_and_module(HwirLowerInput.hardware("system_and", 2, 1, 0, 0), CoreConfig.rv32())
        expect(lower.is_success()).to_equal(true)
        if val module = lower.module:
            step("Emit the typed HWIR module without the legacy route")
            val emitted = render_strict_hwir_vhdl(module)
            expect(emitted.is_success()).to_equal(true)
            expect(emitted.vhdl.contains("std_logic_vector(31 downto 0)")).to_equal(true)
            expect(emitted.uses_legacy_fallback()).to_equal(false)
            step("Analyze strict HWIR VHDL with the VHDL-2008 target toolchain")
            expect(strict_ghdl_available()).to_equal(true)
            expect(strict_vhdl_write_file("/tmp/riscv_gen2_hwir_rv32.vhd", emitted.vhdl)).to_equal(true)
            expect(strict_ghdl_analyze("/tmp/riscv_gen2_hwir_rv32.vhd")).to_equal(true)
        else:
            expect(false).to_equal(true)

    # @req NFR-G2-001 NFR-G2-002 NFR-G2-003 NFR-G2-006
    it "should reject an invalid product deterministically":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should reject an invalid product deterministically")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Reject an invalid elaboration configuration before VHDL emission")
        val invalid = CoreConfig(xlen: 128, physical_address_bits: 0, register_count: 0,
            profile: "", isa_profile: "", compressed_decode_profile: "")
        val lower = lower_strict_hwir_and_module(HwirLowerInput.hardware("invalid", 2, 1, 0, 0), invalid)
        expect(lower.is_success()).to_equal(false)
        expect(lower.diagnostic).to_equal("HWIR-E-XLEN: expected 32 or 64")
        expect(lower.uses_legacy_fallback()).to_equal(false)

    # @req REQ-G2-004 NFR-G2-004
    # @capture exec
    # @capture artifact
    it "should emit and analyze a typed 16-bit parcel mask graph":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should emit and analyze a typed 16-bit parcel mask graph")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Construct a fixed-width parcel mask with no textual VHDL operand")
        val summary = HwModule(name: "strict_parcel_mask", profile: "rv32-zca",
            port_count: 2, signal_count: 0, register_count: 0, memory_count: 0,
            comb_op_count: 1, clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty())
        val module = HwModuleDef(summary: summary, config: CoreConfig.rv32_zca_integer(),
            node_id: HwNodeId.module_root("strict_parcel_mask"),
            origins: [HwOrigin(node_id: HwNodeId.child("strict_parcel_mask", "mask"), source_name: "strict_parcel_mask")],
            ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("masked", "Bits", 32)],
            signals: [], constants: [HwConstant.bits("low_16_mask", 32, 65535)],
            comb_ops: [HwCombOp.binary("and", "masked", "parcel", "low_16_mask", 32)],
            compare_ops: [], select_ops: [],
            clock_domains: [HwClockDomain.default_domain()])
        step("Emit and analyze the typed mask graph as VHDL-2008")
        val emitted = render_strict_hwir_vhdl(module)
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl.contains("to_unsigned(65535, 32)")).to_equal(true)
        expect(strict_vhdl_write_file("/tmp/riscv_gen2_hwir_parcel_mask.vhd", emitted.vhdl)).to_equal(true)
        expect(strict_ghdl_analyze("/tmp/riscv_gen2_hwir_parcel_mask.vhd")).to_equal(true)

    # @req REQ-G2-004
    # @capture exec
    # @capture artifact
    it "should emit and analyze a bounded typed parcel right shift graph":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should emit and analyze a bounded typed parcel right shift graph")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Construct a fixed-width parcel shift with a typed shift amount")
        val summary = HwModule(name: "strict_parcel_shift", profile: "rv32-zca",
            port_count: 2, signal_count: 0, register_count: 0, memory_count: 0,
            comb_op_count: 1, clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty())
        val module = HwModuleDef(summary: summary, config: CoreConfig.rv32_zca_integer(),
            node_id: HwNodeId.module_root("strict_parcel_shift"),
            origins: [HwOrigin(node_id: HwNodeId.child("strict_parcel_shift", "shift"), source_name: "strict_parcel_shift")],
            ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("shifted", "Bits", 32)],
            signals: [], constants: [HwConstant.bits("shift_amount", 32, 13)],
            comb_ops: [HwCombOp.binary("shr", "shifted", "parcel", "shift_amount", 32)],
            compare_ops: [], select_ops: [],
            clock_domains: [HwClockDomain.default_domain()])
        step("Emit and analyze the typed shift graph as VHDL-2008")
        val emitted = render_strict_hwir_vhdl(module)
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl.contains("shift_right(unsigned(parcel), to_integer(unsigned(shift_amount)))")).to_equal(true)
        expect(strict_vhdl_write_file("/tmp/riscv_gen2_hwir_parcel_shift.vhd", emitted.vhdl)).to_equal(true)
        expect(strict_ghdl_analyze("/tmp/riscv_gen2_hwir_parcel_shift.vhd")).to_equal(true)

    # @req REQ-G2-004
    # @capture exec
    # @capture artifact
    it "should emit and simulate a bounded typed parcel left shift graph":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should emit and simulate a bounded typed parcel left shift graph")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Construct a fixed-width left shift for canonical instruction fields")
        val summary = HwModule(name: "strict_parcel_left_shift", profile: "rv32-zca-critical",
            port_count: 2, signal_count: 0, register_count: 0, memory_count: 0,
            comb_op_count: 1, clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty())
        val module = HwModuleDef(summary: summary, config: CoreConfig.rv32_zca_mission_critical(),
            node_id: HwNodeId.module_root("strict_parcel_left_shift"),
            origins: [HwOrigin(node_id: HwNodeId.child("strict_parcel_left_shift", "shift"), source_name: "strict_parcel_left_shift")],
            ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("shifted", "Bits", 32)],
            signals: [], constants: [HwConstant.bits("shift_amount", 32, 7)],
            comb_ops: [HwCombOp.binary("shl", "shifted", "parcel", "shift_amount", 32)],
            compare_ops: [], select_ops: [],
            clock_domains: [HwClockDomain.default_domain()])
        step("Emit, analyze, and simulate a canonical-field shift as VHDL-2008")
        val emitted = render_strict_hwir_vhdl(module)
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl.contains("shift_left(unsigned(parcel), to_integer(unsigned(shift_amount)))")).to_equal(true)
        expect(strict_vhdl_write_file("/tmp/riscv_gen2_hwir_parcel_left_shift.vhd", emitted.vhdl)).to_equal(true)
        expect(strict_ghdl_analyze("/tmp/riscv_gen2_hwir_parcel_left_shift.vhd")).to_equal(true)
        expect(strict_vhdl_write_file("/tmp/riscv_gen2_hwir_parcel_left_shift_tb.vhd", parcel_left_shift_testbench())).to_equal(true)
        expect(strict_ghdl_analyze("/tmp/riscv_gen2_hwir_parcel_left_shift_tb.vhd")).to_equal(true)
        expect(strict_ghdl_elaborate("strict_parcel_left_shift_tb")).to_equal(true)
        expect(strict_ghdl_run("strict_parcel_left_shift_tb", "2ns")).to_equal(true)

    # @req REQ-G2-004
    # @capture exec
    # @capture artifact
    it "should emit and analyze a two-stage typed parcel field graph":
        # @req: REQ-G2-001 REQ-G2-002 REQ-G2-003 REQ-G2-005 REQ-G2-006 REQ-G2-009 REQ-G2-010 REQ-G2-011 REQ-G2-007 REQ-G2-008
        step("Verify: should emit and analyze a two-stage typed parcel field graph")
        # evidence(pinned oracle): expected values below are authoritative constants verified by this scenario
        step("Construct shift then mask through one typed internal signal")
        val summary = HwModule(name: "strict_parcel_field", profile: "rv32-zca",
            port_count: 2, signal_count: 1, register_count: 0, memory_count: 0,
            comb_op_count: 2, clock_domain_count: 1, fallback_function: "",
            cost: HwCostModel.empty())
        val module = HwModuleDef(summary: summary, config: CoreConfig.rv32_zca_integer(),
            node_id: HwNodeId.module_root("strict_parcel_field"),
            origins: [
                HwOrigin(node_id: HwNodeId.child("strict_parcel_field", "shift"), source_name: "strict_parcel_field"),
                HwOrigin(node_id: HwNodeId.child("strict_parcel_field", "mask"), source_name: "strict_parcel_field")
            ],
            ports: [HwPort.input("parcel", "Bits", 32), HwPort.output("field", "Bits", 32)],
