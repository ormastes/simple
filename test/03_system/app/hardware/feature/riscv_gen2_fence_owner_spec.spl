# @cover src/compiler/50.mir/__init__.spl 0%
"""Mission-critical FENCE/FENCE.I accepted-effect product contract.

This scenario proves typed construction and fail-closed product wiring. Cycle
behavior is exercised separately by the generated-VHDL GHDL integration lane;
until that lane runs under an admitted self-hosted CLI this is development
evidence, not qualification.
"""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_fence_owner.{strict_riscv_scalar_fence_owner}
use compiler.mir.hwir.riscv_scalar_product_composition.{
    strict_riscv_scalar_product_composition}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

describe "RISC-V Gen2 accepted-effect fence product":
    # @req REQ-G2-017 NFR-G2-018
    it "should hold FENCE fields behind one acknowledged effect boundary":
        step("Build the exact RV32 FENCE owner")
        val owner = strict_riscv_scalar_fence_owner(
            "system_fence_owner", CoreConfig.rv32(), 0x0FF0000F).unwrap()
        step("Check the pending effect and completion state ordering")
        expect(owner.plan.rules.map(fn(rule): rule.name)).to_equal([
            "consume", "effect_accept", "identity_fault",
            "capture_illegal_decode", "capture_effect"])
        expect(owner.plan.outputs.filter(
            fn(output): output.result == "fence_effect_valid")[0].source).to_equal("pending_reg")
        expect(owner.plan.outputs.filter(
            fn(output): output.result == "completion_valid")[0].source).to_equal("full_reg")

    # @req REQ-G2-017 NFR-G2-018
    it "should reject reserved and unprofiled instruction-stream fences":
        step("Build a reserved standard FENCE encoding")
        val reserved = strict_riscv_scalar_fence_owner(
            "system_fence_reserved", CoreConfig.rv64(), 0x1000000F).unwrap()
        expect(reserved.plan.rules.map(fn(rule): rule.name)).to_contain(
            "capture_illegal_encoding")
        step("Attempt FENCE.I without Zifencei")
        expect(strict_riscv_scalar_fence_owner("system_fence_i_unprofiled",
            CoreConfig.rv64(), 0x0000100F).is_err()).to_equal(true)

    # @req REQ-G2-012 REQ-G2-017 NFR-G2-018
    it "should compose through common arbitration trap fault and retirement owners":
        step("Compose the RV64 FENCE.I scalar product")
        val config = CoreConfig.rv64_zicsr_zifencei()
        val composition = strict_riscv_scalar_product_composition(
            "system_fence_i_product", config, 0x0000100F,
            LsuConfig.rv64_product_default()).unwrap()
        expect(composition.provider_kind).to_equal("fence")
        expect(composition.fence_provider != nil).to_equal(true)
        expect(composition.retirement_owner_count).to_equal(1)
        expect(composition.binding_diagnostic()).to_equal("")
        step("Emit the closed strict VHDL product")
        val emitted = compile_strict_riscv_scalar_product(
            "system_fence_i_product_emit", config, 0x0000100F,
            LsuConfig.rv64_product_default())
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl).to_contain("fence_effect_ready")
        expect(emitted.vhdl).to_contain("fault_aggregator: entity work")
