# @cover src/compiler/50.mir/__init__.spl 0%
# codex-system-test
# @manual_section RISC-V Gen2 V6 flattened Zmmul runtime pipeline
"""# RISC-V Gen2 V6 flattened Zmmul runtime pipeline

Exercises the public V6 product boundary for RV32 and RV64 Zmmul configurations.
The scenario proves elaboration and strict VHDL-route contracts only; the companion
clocked GHDL integration spec supplies cycle-level arithmetic evidence.
"""
use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_runtime_pipeline_v6_flat.{
    strict_riscv_scalar_runtime_pipeline_v6_flat_direct}
use compiler.backend.backend.riscv_scalar_runtime_pipeline_v6_flat_to_vhdl.{
    compile_strict_riscv_scalar_runtime_pipeline_v6_flat}

fn runtime_v6_zmmul_config(xlen: i32) -> CoreConfig:
    CoreConfig(xlen: xlen, physical_address_bits: if xlen == 32: 32 else: 56,
        register_count: 32, profile: "riscv-gen2-runtime-v6-zmmul",
        isa_profile: if xlen == 32: "rv32i_zmmul" else: "rv64i_zmmul",
        compressed_decode_profile: "none")

describe "RISC-V Gen2 V6 flattened Zmmul runtime pipeline":
    # @req REQ-G2-013
    it "should elaborate RV32 and RV64 Zmmul products with one dynamic tag-two owner":
        step("Build concrete RV32 and RV64 V6 Zmmul runtime pipelines")
        val rv32 = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_system_rv32", runtime_v6_zmmul_config(32),
            LsuConfig.rv32_product_default()).unwrap()
        val rv64 = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_system_rv64", runtime_v6_zmmul_config(64),
            LsuConfig.rv64_product_default()).unwrap()
        step("Check the closed public topology and multiply owner")
        expect(rv32.diagnostic()).to_equal("")
        expect(rv64.diagnostic()).to_equal("")
        expect(rv32.top_ports.len()).to_equal(61)
        expect(rv64.top_ports.len()).to_equal(61)
        expect(rv32.muldiv.entity_name).to_equal("runtime_v6_system_rv32_muldiv")
        expect(rv64.muldiv.entity_name).to_equal("runtime_v6_system_rv64_muldiv")
        expect(rv32.router.entity_name).to_equal("runtime_v6_system_rv32_router")
        expect(rv64.router.entity_name).to_equal("runtime_v6_system_rv64_router")

    # @req REQ-G2-013
    it "should bind request acceptance completion readiness and fault through tag two":
        step("Build the RV64 Zmmul product for protocol-edge inspection")
        val pipeline = strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_system_edges", runtime_v6_zmmul_config(64),
            LsuConfig.rv64_product_default()).unwrap()
        step("Trace the pending-owner tag-two request and held-completion paths")
        for edge in [("pending", "muldiv_request_valid", "muldiv", "request_valid", 1),
                ("pending", "muldiv_request_provider_tag", "muldiv", "request_provider_tag", 3),
                ("muldiv", "request_accept", "pending", "muldiv_request_accept", 1),
                ("muldiv", "completion_valid", "pending", "muldiv_completion_valid", 1),
                ("pending", "muldiv_completion_ready", "muldiv", "completion_ready", 1),
                ("muldiv", "provider_protocol_fault", "global_fault_gate", "muldiv_fault", 1)]:
            expect(pipeline.bindings.any(_.source_owner == edge[0] and _.source_port == edge[1] and
                _.destination_owner == edge[2] and _.destination_port == edge[3] and
                _.bit_width == edge[4])).to_equal(true)

    # @req REQ-G2-013 NFR-G2-013
    it "should emit a deterministic strict VHDL V6-flat product":
        step("Compile the same RV32 Zmmul product twice through the public route")
        val first = compile_strict_riscv_scalar_runtime_pipeline_v6_flat(
            "runtime_v6_system_vhdl", runtime_v6_zmmul_config(32),
            LsuConfig.rv32_product_default())
        val second = compile_strict_riscv_scalar_runtime_pipeline_v6_flat(
            "runtime_v6_system_vhdl", runtime_v6_zmmul_config(32),
            LsuConfig.rv32_product_default())
        step("Check route identity graph determinism and flattened multiply wiring")
        expect(first.is_success()).to_equal(true)
        expect(second.is_success()).to_equal(true)
        expect(first.route).to_equal("hwir-gen2-scalar-runtime-pipeline-v6-flat-direct")
        expect(first.hwir_graph_sha256).to_equal(second.hwir_graph_sha256)
        expect(first.vhdl).to_equal(second.vhdl)
        expect(first.vhdl).to_contain("simple-hwir v6-flat-route-receipt=")
        expect(first.vhdl).to_contain("muldiv: entity work.runtime_v6_system_vhdl_muldiv")

    # @req REQ-G2-013
    it "should reject IM profiles until a unified runtime-M owner exists":
        step("Attempt V6 elaboration with a profile that admits DIV and REM")
        expect(strict_riscv_scalar_runtime_pipeline_v6_flat_direct(
            "runtime_v6_system_im_rejected", CoreConfig.rv32im(),
            LsuConfig.rv32_product_default()).is_err()).to_equal(true)
