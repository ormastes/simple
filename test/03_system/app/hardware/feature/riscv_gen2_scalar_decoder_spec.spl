# @cover src/compiler/50.mir/__init__.spl 0%
"""Declarative scalar ISA database to strict HWIR decoder contract."""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.host_evaluator.{HwHostInput, evaluate_strict_comb_hwir}
use compiler.mir.hwir.riscv_scalar_decoder.{strict_riscv_scalar_decoder_hwir}
use compiler.mir.hwir.riscv_scalar_decoded_uop_interface.{
    strict_hw_scalar_decoded_uop_interface}
use compiler.mir.hwir.riscv_scalar_decode_dispatch_owner.{
    strict_riscv_scalar_decoded_uop_skid}
use compiler.backend.backend.riscv_scalar_decoder_to_vhdl.{
    compile_strict_riscv_scalar_decoder_product}
use lib.hardware.riscv_common.isa.scalar_database.{riscv_scalar_decoder_plan}

describe "RISC-V Gen2 declarative scalar decoder":
    # @req REQ-G2-001 REQ-G2-003 REQ-G2-004 NFR-G2-001 NFR-G2-003
    it "should generate deterministic concrete RV32 and RV64 decoder graphs":
        step("Freeze each decoder plan from the shared scalar ISA database")
        val rv32_plan = riscv_scalar_decoder_plan("rv32i").unwrap()
        val rv64_plan = riscv_scalar_decoder_plan("rv64i_zicsr_zifencei").unwrap()
        step("Lower each exact plan into fixed-XLEN strict HWIR")
        val rv32 = strict_riscv_scalar_decoder_hwir(
            "system_scalar_decoder_rv32", CoreConfig.rv32(), rv32_plan).unwrap()
        val rv64 = strict_riscv_scalar_decoder_hwir("system_scalar_decoder_rv64",
            CoreConfig.rv64_zicsr_zifencei(), rv64_plan).unwrap()
        expect(rv32.shape_diagnostic()).to_equal("")
        expect(rv64.shape_diagnostic()).to_equal("")
        expect(rv32.structural_sha256() == rv64.structural_sha256()).to_equal(false)
        expect(rv32.ports.map(_.name)).to_equal(["instruction", "decoded_valid",
            "decoded_row_index", "canonical_instruction", "decoded_execution_class",
            "decoded_memory_effect", "decoded_semantic_opcode",
            "decoded_operand_width_32", "instruction_rd_field",
            "instruction_rs1_field", "instruction_rs2_field"])

    # @req REQ-G2-003 REQ-G2-004 NFR-G2-002
    it "should fail closed for an undeclared instruction":
        step("Evaluate the exact RV32 decoder graph with an all-zero instruction")
        val decoder = strict_riscv_scalar_decoder_hwir("system_scalar_decoder_eval",
            CoreConfig.rv32(), riscv_scalar_decoder_plan("rv32i").unwrap()).unwrap()
        val result = evaluate_strict_comb_hwir(decoder,
            [HwHostInput.bits("instruction", 0)]).unwrap()
        expect(result.value_of("decoded_valid").unwrap()).to_equal(0)
        expect(result.value_of("decoded_row_index").unwrap()).to_equal(0)
        expect(result.value_of("canonical_instruction").unwrap()).to_equal(0)

    # @req REQ-G2-004 NFR-G2-001 NFR-G2-004
    it "should emit deterministic nonempty strict VHDL without legacy fallback":
        step("Compile the RV64 decoder through the compiler-owned product route")
        val emitted = compile_strict_riscv_scalar_decoder_product(
            "system_scalar_decoder_emit", CoreConfig.rv64_zicsr_zifencei())
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.uses_legacy_fallback()).to_equal(false)
        expect(emitted.route).to_equal("hwir-gen2-scalar-decoder-v1")
        expect(emitted.vhdl).to_contain("entity system_scalar_decoder_emit is")
        expect(emitted.hwir_graph_sha256.len()).to_equal(64)

    # @req REQ-G2-001 REQ-G2-003 NFR-G2-001 NFR-G2-002
    it "should freeze one runtime decoded-uop transaction under backpressure":
        step("Bind the exact RV32 decoder graph and plan to the decoded-uop schema")
        val config = CoreConfig.rv32()
        val plan = riscv_scalar_decoder_plan("rv32i").unwrap()
        val decoder = strict_riscv_scalar_decoder_hwir(
            "system_scalar_runtime_decoder", config, plan).unwrap()
        val descriptor = strict_hw_scalar_decoded_uop_interface(
            config, plan, decoder).unwrap()
        step("Build the sole one-entry owner for decoder, operand, PC, and event lineage")
        val owner = strict_riscv_scalar_decoded_uop_skid(
            "system_scalar_decode_dispatch", plan, decoder, descriptor).unwrap()
        expect(descriptor.diagnostic_for_decoder(decoder, plan)).to_equal("")
        expect(owner.diagnostic()).to_equal("")
        expect(owner.plan.rules.map(_.name)).to_equal(["consume", "capture"])
        expect(owner.plan.registers.any(
            _.name == "decoded_semantic_opcode_reg")).to_equal(true)
        expect(owner.plan.registers.any(_.name == "rs1_value_reg")).to_equal(true)
        expect(owner.plan.registers.any(_.name == "decode_event_id_reg")).to_equal(true)
