# @cover src/compiler/50.mir/__init__.spl 0%
"""Mission-critical ECALL/EBREAK scalar system-provider contract.

This scenario proves exact instruction admission, privilege-sensitive cause
selection, normalization, and closed-product ownership. Generated-product
cycle qualification remains a separate GHDL evidence gate.
"""

use std.spec.*
use compiler.mir.hwir.types.{CoreConfig}
use compiler.mir.hwir.riscv_lsu_config.{LsuConfig}
use compiler.mir.hwir.riscv_scalar_system_projection.{
    strict_riscv_scalar_system_projection_hwir}
use compiler.mir.hwir.riscv_scalar_product_composition.{
    strict_riscv_scalar_product_composition}
use compiler.backend.backend.riscv_scalar_product_to_vhdl.{
    compile_strict_riscv_scalar_product}

describe "RISC-V Gen2 precise system exceptions":
    # @req REQ-G2-014 NFR-G2-015
    it "should elaborate exact ECALL and EBREAK exception projections":
        step("Build RV32 ECALL and RV64 EBREAK projections")
        val ecall = strict_riscv_scalar_system_projection_hwir(
            "system_ecall", CoreConfig.rv32(), 0x00000073).unwrap()
        val ebreak = strict_riscv_scalar_system_projection_hwir(
            "system_ebreak", CoreConfig.rv64(), 0x00100073).unwrap()
        step("Require one normalized trap driver and no architectural side effects")
        expect(ecall.origins.map(fn(origin): origin.source_name)).to_contain("riscv.scalar.system.ecall")
        expect(ebreak.origins.map(fn(origin): origin.source_name)).to_contain("riscv.scalar.system.ebreak")
        expect(ecall.shape_diagnostic()).to_equal("")
        expect(ebreak.shape_diagnostic()).to_equal("")

    # @req REQ-G2-014 NFR-G2-015
    it "should reject instructions outside the exact system-provider scope":
        step("Attempt to elaborate an arithmetic instruction as a system exception")
        expect(strict_riscv_scalar_system_projection_hwir(
            "system_wrong_scope", CoreConfig.rv32(), 0x001080B3).is_err()).to_equal(true)

    # @req REQ-G2-012 REQ-G2-014 NFR-G2-015
    it "should close system exceptions through skid arbitration trap and sole retirement":
        step("Compose an RV64 ECALL product")
        val config = CoreConfig.rv64()
        val composition = strict_riscv_scalar_product_composition(
            "system_ecall_product", config, 0x00000073,
            LsuConfig.rv64_product_default()).unwrap()
        expect(composition.provider_kind).to_equal("system")
        expect(composition.completion_skid != nil).to_equal(true)
        expect(composition.retirement_owner_count).to_equal(1)
        expect(composition.binding_diagnostic()).to_equal("")
        step("Emit the closed strict VHDL product")
        val emitted = compile_strict_riscv_scalar_product(
            "system_ecall_product_emit", config, 0x00000073,
            LsuConfig.rv64_product_default())
        expect(emitted.is_success()).to_equal(true)
        expect(emitted.vhdl).to_contain("completion_skid: entity work")
        expect(emitted.vhdl).to_contain("retirement_owner: entity work")
        expect(emitted.vhdl).to_contain("fault_aggregator: entity work")
