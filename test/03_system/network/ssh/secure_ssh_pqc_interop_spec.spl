# @cover src/lib/common/crypto/x25519_mlkem768/protocol_profile.spl 0%
# @req REQ-007 REQ-008 REQ-009 REQ-012 NFR-001 NFR-002 NFR-009 NFR-011

"""Pure-Simple SSH client/server and hybrid-PQC interoperability acceptance."""

use std.spec.*
use lib.common.crypto.x25519_mlkem768.protocol_profile.{
    X25519MlKem768ProtocolPolicy,
    x25519_mlkem768_ssh2_protocol_profile
}
use os.apps.sshd.ssh_hybrid_negotiation_policy.{
    ssh_admit_x25519_mlkem768_selection,
    ssh_reject_retry_after_x25519_mlkem768_failure,
    ssh_x25519_mlkem768_wire_format_pinned
}

fn required_ssh_hybrid_policy() -> X25519MlKem768ProtocolPolicy:
    X25519MlKem768ProtocolPolicy(require_hybrid: true,
        authentication_enabled: true, aead_enabled: true,
        allow_classical_retry_after_hybrid_failure: false)

# @inline
fn setup_linux_fixture():
    fail("UNRESOLVED ORACLE: Linux Simple SSH and OpenSSH fixture")

# @inline
fn run_ssh_exchange():
    fail("UNRESOLVED ORACLE: live Simple SSH client and SimpleOS sshd exchange")

fn check_protocol_transcript():
    fail("UNRESOLVED ORACLE: SSH negotiation authentication exec and transfer transcript")

fn check_fail_closed():
    fail("UNRESOLVED ORACLE: SSH downgrade replay host-key authentication and hybrid failure")

fn check_interop_oracle():
    fail("UNRESOLVED ORACLE: current OpenSSH bidirectional interoperability")

fn check_pure_simple_ownership():
    fail("UNRESOLVED ORACLE: pure-Simple SSH protocol crypto orchestration ownership audit")

describe "secure SSH hybrid-PQC interoperability":
    describe "REQ-009: fail-closed SSH hybrid negotiation boundary":
        it "should refuse false advertisement downgrade and classical retry":
            step("Reject malformed, unauthenticated, downgraded, or replayed input")
            val profile = x25519_mlkem768_ssh2_protocol_profile()
            val policy = required_ssh_hybrid_policy()
            expect(ssh_admit_x25519_mlkem768_selection(
                profile, policy, "curve25519-sha256", true
            ).is_err()).to_equal(true)
            expect(ssh_admit_x25519_mlkem768_selection(
                profile, policy, "mlkem768x25519-sha256", false
            ).is_err()).to_equal(true)
            expect(ssh_admit_x25519_mlkem768_selection(
                profile, policy, "mlkem768x25519-sha256", true
            ).is_err()).to_equal(true)
            expect(ssh_x25519_mlkem768_wire_format_pinned()).to_equal(false)
            expect(ssh_reject_retry_after_x25519_mlkem768_failure(
                profile, policy, "decapsulation rejected"
            ).is_err()).to_equal(true)

    describe "REQ-007 REQ-009: Simple SSH and OpenSSH interoperability":
        it "should authenticate execute and transfer with Simple and OpenSSH peers":
            setup_linux_fixture()
            step("negotiate secure protocol")
            run_ssh_exchange()
            step("exercise independent oracle")
            check_protocol_transcript()
            check_interop_oracle()

        it "should reject malformed unauthenticated downgraded and replayed SSH input":
            step("reject malformed/unauthenticated/downgraded/replayed input")
            check_fail_closed()

    describe "REQ-008 REQ-012: auditable pure-Simple security ownership":
        it "should bind authenticated encryption and hybrid establishment to the SSH transcript":
            check_pure_simple_ownership()
