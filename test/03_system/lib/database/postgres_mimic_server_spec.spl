# @req: REQ-LIB-POSTGRES-MIMIC-001


"""# PostgreSQL mimic server

This executable scenario proves bounded PostgreSQL-like session/query semantics
over the pure-Simple database engine and the compiled-artifact deployment rule.
It does not claim PostgreSQL wire, TLS, SCRAM, COPY, or replication parity.
"""

use std.spec
use std.database.postgres_mimic.{PostgresMimicServer, PgResponseKind}
use std.database.deployment.{database_select_plan, database_plan_uses_compiled_artifact, DatabaseArtifactKind}

use std.spec.step

describe "REQ-PGM PostgreSQL mimic server":
    it "should execute a PostgreSQL-like session on PureDatabase":
        # @req: REQ-LIB-POSTGRES-MIMIC-001
        step("Verify: should execute a PostgreSQL-like session on PureDatabase")
        step("Start a PostgreSQL-like database session")
        var server = PostgresMimicServer.memory().unwrap()
        val session = server.startup("builder", "messaging", "sspec").unwrap()
        expect(server.startup_responses(session)[0].kind == PgResponseKind.AuthenticationOk).to_equal(true)

        step("Create, write, and query through the pure-Simple engine")
        expect(server.simple_query(session, "CREATE TABLE events (id INTEGER, body TEXT)").kind == PgResponseKind.CommandComplete).to_equal(true)
        expect(server.simple_query(session, "INSERT INTO events (id, body) VALUES (1, 'ready')").tag).to_start_with("INSERT")
        val rows = server.simple_query(session, "SELECT id, body FROM events")
        expect(rows.kind == PgResponseKind.RowSet).to_equal(true)
        expect(rows.rows.len()).to_equal(1)  # oracle: 1 — pinned expected value for this behavior

        step("Observe PostgreSQL transaction state and close isolation")
        expect(server.simple_query(session, "BEGIN").transaction_status).to_equal("T")
        expect(server.simple_query(session, "ROLLBACK").transaction_status).to_equal("I")
        expect(server.terminate(session)).to_equal(true)
        expect(server.simple_query(session, "SELECT 1").sqlstate).to_equal("08003")

    it "should select a compiled database artifact for interpreter callers":
        # @req: REQ-LIB-POSTGRES-MIMIC-001
        step("Verify: should select a compiled database artifact for interpreter callers")
        step("Resolve the production database execution plan")
        val plan = database_select_plan("interpreter", false)
        expect(plan.kind == DatabaseArtifactKind.SmfExecutable).to_equal(true)
        expect(plan.artifact_path).to_end_with(".smf")
        expect(database_plan_uses_compiled_artifact(plan)).to_equal(true)
        expect(plan.production_ready).to_equal(true)
