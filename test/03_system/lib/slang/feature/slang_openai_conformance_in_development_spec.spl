# @tag:in-development
# @cover src/app/slang_server/main.spl 40%
# @cover src/lib/gc_async_mut/slang/entrypoints/openai/api_server.spl 40%
# Purpose and audience: executable specification evidence for the owning engineering team.
# design: doc/00_llm_process/feature_expert/slang_local_inference/skill.md

"""
## Purpose and audience
Purpose: OpenAI-compatible behaviour the slang HTTP server does NOT implement yet.
Every case here is expected to FAIL today; each carries the exact assertion a
conforming server must satisfy, so none is weakened. Move a case to
slang_openai_conformance_live_spec.spl when it goes green.
Audience: maintainers of `src/app/slang_server/` and the OpenAI entrypoints.

## What is checked
max_tokens finish_reason "length", `stop` sequences, `stream:true` SSE chunks
ending in `data: [DONE]`.
Bug record: doc/08_tracking/bug/slang_openai_stop_stream_finish_reason_unimplemented_2026-11-15.md

## Compatibility and limitations
Same gating as slang_openai_conformance_live_spec.spl; port 47732.
Server output: build/probe/slang_openai_gaps.*.
"""

use std.spec.{describe, it, expect, step, skip, fail}
use std.io_runtime.{env_get, is_dir, file_exists, thread_sleep, time_now_monotonic_ms}
use std.nogc_sync_mut.io.tcp.{TcpStream}
use std.nogc_sync_mut.io.process_ops.{process_spawn_redirected, process_kill_tree, process_is_running}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{json_string_field}

val DEFAULT_MODEL = "Qwen2.5-1.5B-Instruct-Q4_K_M"
val PORT = 47732
val ADDR = "127.0.0.1:47732"
val OUT_PATH = "build/probe/slang_openai_gaps.out"
val ERR_PATH = "build/probe/slang_openai_gaps.err"
val START_TIMEOUT_S = 240

var SERVER_PID: i64 = -1

struct Probe:
    status: i64
    headers: text
    body: text

fn _model() -> text:
    val m = env_get("CARET_SLANG_MODEL") ?? ""
    if m == "":
        return DEFAULT_MODEL
    m

fn _root() -> text:
    env_get("SLANG_MODEL_ROOT") ?? ""

fn _missing() -> text:
    if (env_get("SLANG_LIVE") ?? "") != "1":
        return "SLANG_LIVE=1 not set"
    val bin = env_get("SIMPLE_BINARY") ?? ""
    if bin == "" or not file_exists(bin):
        return "SIMPLE_BINARY unset or missing: '" + bin + "'"
    if _root() == "" or not is_dir(_root() + "/" + _model()):
        return "model '" + _model() + "' not under SLANG_MODEL_ROOT '" + _root() + "'"
    if (env_get("SLANG_GGML_LIB") ?? "") == "":
        return "SLANG_GGML_LIB unset (build/sffi_openai/slang_ggml.dll)"
    ""

fn _request(method: text, path: text, body: text) -> text:
    method + " " + path + " HTTP/1.1\r\nHost: " + ADDR + "\r\nContent-Type: application/json\r\nContent-Length: " +
        body.len().to_text() + "\r\nConnection: close\r\n\r\n" + body

fn _parse(raw: text) -> Probe:
    val split = raw.index_of("\r\n\r\n")
    if split < 0:
        return Probe(status: -1, headers: "", body: raw)
    val first_sp = raw.index_of(" ")
    var status: i64 = -1
    if first_sp > 0:
        status = raw.slice(first_sp + 1, first_sp + 4).to_i64()
    Probe(status: status, headers: raw.slice(0, split), body: raw.slice(split + 4, raw.len()))

fn _http(method: text, path: text, body: text) -> Probe:
    val conn = TcpStream.connect(ADDR)
    if conn.is_err():
        return Probe(status: -1, headers: "", body: "connect failed")
    var stream = conn.unwrap()
    if stream.write_text(_request(method, path, body)).is_err():
        val _w = stream.close()
        return Probe(status: -1, headers: "", body: "write failed")
    val read = stream.read_text()
    val _c = stream.close()
    if read.is_err():
        return Probe(status: -1, headers: "", body: "read failed")
    _parse(read.unwrap())

fn _chat_body(extra: text, messages: text) -> text:
    "{\"model\":\"" + _model() + "\"," + extra + "\"messages\":[" + messages + "]}"

fn _user(text_content: text) -> text:
    "{\"role\":\"user\",\"content\":\"" + text_content + "\"}"

fn _chat(extra: text, messages: text) -> Probe:
    _http("POST", "/v1/chat/completions", _chat_body(extra, messages))

fn _wait_ready(pid: i64) -> bool:
    val deadline = time_now_monotonic_ms() + START_TIMEOUT_S * 1000
    while time_now_monotonic_ms() < deadline:
        if not process_is_running(pid):
            return false
        val p = _http("GET", "/v1/models", "")
        if p.status == 200:
            return true
        thread_sleep(2000)
    false

fn _ensure_server():
    if SERVER_PID >= 0:
        return
    val args = ["run", "src/app/slang_server/main.spl", "--", "--plaintext-development",
        "--models=" + _root(), "--model=" + _model(), "--port=" + PORT.to_text(), "--n-ctx=2048"]
    val pid = process_spawn_redirected(env_get("SIMPLE_BINARY") ?? "", args, OUT_PATH, ERR_PATH, 0, 1048576)
    if pid < 0:
        fail("could not start slang_server child (pid " + pid.to_text() + ")")
    SERVER_PID = pid
    if not _wait_ready(pid):
        val _k = process_kill_tree(pid)
        SERVER_PID = -1
        fail("server not ready; see " + OUT_PATH + " and " + ERR_PATH)

describe "slang OpenAI-compatible surface: not implemented yet":

    it "2. max_tokens 1 gives finish_reason length and a short completion":
        val gate = _missing()
        if gate != "":
            skip("2. max_tokens 1 gives finish_reason length and a short completion", gate)
        else:
            _ensure_server()
            val r = _chat("\"max_tokens\":1,", _user("Write a long essay about the ocean."))
            print "SLANG_OPENAI_GAP case2 status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(json_string_field(r.body, "finish_reason")).to_equal("length")
            expect(json_string_field(r.body, "content").len() < 12).to_equal(true)

    it "3. a stop sequence truncates the completion and finish_reason is stop":
        val gate = _missing()
        if gate != "":
            skip("3. a stop sequence truncates the completion and finish_reason is stop", gate)
        else:
            _ensure_server()
            val r = _chat("\"temperature\":0,\"max_tokens\":40,\"stop\":[\",\"],", _user("Count from 1 to 5 separated by commas, nothing else."))
            print "SLANG_OPENAI_GAP case3 status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(json_string_field(r.body, "content").contains(",")).to_equal(false)
            expect(json_string_field(r.body, "finish_reason")).to_equal("stop")

    it "5. stream true returns SSE chunks ending in [DONE], arriving before generation ends":
        val gate = _missing()
        if gate != "":
            skip("5. stream true returns SSE chunks ending in [DONE], arriving before generation ends", gate)
        else:
            _ensure_server()
            val conn = TcpStream.connect(ADDR)
            expect(conn.is_ok()).to_equal(true)
            var s = conn.unwrap()
            val body = _chat_body("\"stream\":true,\"temperature\":0,\"max_tokens\":24,", _user("Count from 1 to 10."))
            val t0 = time_now_monotonic_ms()
            val w = s.write_text(_request("POST", "/v1/chat/completions", body))
            expect(w.is_ok()).to_equal(true)
            var head = ""
            var chunks = 0
            var deltas = ""
            var finish = ""
            var done = false
            var first_ms: i64 = -1
            var guard = 0
            while guard < 400:
                guard = guard + 1
                val line = s.read_line_nullable()
                if line == nil:
                    break
                val l = line!.trim()
                if head == "" and l.starts_with("HTTP/"):
                    head = l
                if l.starts_with("data:"):
                    val payload = l.slice(5, l.len()).trim()
                    if payload == "[DONE]":
                        done = true
                        break
                    if first_ms < 0:
                        first_ms = time_now_monotonic_ms() - t0
                    chunks = chunks + 1
                    expect(payload).to_contain("\"object\":\"chat.completion.chunk\"")
                    expect(payload).to_contain("\"delta\"")
                    deltas = deltas + json_string_field(payload, "content")
                    val fr = json_string_field(payload, "finish_reason")
                    if fr != "":
                        finish = fr
                elif head == "":
                    pass
            val total_ms = time_now_monotonic_ms() - t0
            val _c = s.close()
            print "SLANG_OPENAI_GAP case5 head=" + head + " chunks=" + chunks.to_text() + " first_ms=" + first_ms.to_text() + " total_ms=" + total_ms.to_text() + " text=" + deltas
            expect(head).to_contain("200")
            expect(chunks > 1).to_equal(true)
            expect(deltas != "").to_equal(true)
            expect(finish == "stop" or finish == "length").to_equal(true)
            expect(done).to_equal(true)
            expect(first_ms < total_ms).to_equal(true)

    it "shuts the server child down":
        if SERVER_PID >= 0:
            val _k = process_kill_tree(SERVER_PID)
            expect(process_is_running(SERVER_PID)).to_equal(false)
            SERVER_PID = -1
