"""
## Purpose
Runs the native physical paged-KV provider conformance oracle under ASan and
UBSan. This proves the provider boundary's ownership and rollback behavior; it
does not claim production tensor kernels or real-model numerical parity.
"""

# @req REQ-002 REQ-003 REQ-004 REQ-007 REQ-009 REQ-011 REQ-012 REQ-014
use std.spec.*
use std.nogc_sync_mut.io.process_ops.{process_run}

describe "Slang physical paged-KV provider conformance":
    # @capture(protocol)
    it "passes the bounded native ownership and transaction oracle":
        step("Allocate bounded fixed-size pages with generation-safe identities")
        step("Prefill multiple pages and publish table, cursor, and logits atomically")
        step("Share sealed pages and copy a partial tail without cross-request mutation")
        step("Reject uncommitted page escape, gaps, stale handles, and overflow")
        step("Rollback injected writes and drain transactions during cancellation")
        val (out, err, code) = process_run(
            "sh", ["test/02_integration/lib/slang_paged_kv_provider_conformance_test.shs"])
        if code != 0:
            fail("physical paged-KV conformance failed: " + err)
        expect(code).to_equal(0)
        expect(out).to_contain("STATUS: PASS slang-paged-kv-provider-conformance")
