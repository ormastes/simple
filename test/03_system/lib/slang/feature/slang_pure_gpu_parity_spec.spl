# @cover src/lib/gc_async_mut/slang/model_executor/pure/llama_forward_gpu.spl 80%
# @cover src/lib/gc_async_mut/slang/model_executor/pure/compute_backend.spl 80%
# Purpose and audience: executable evidence that the pure-Simple Llama runner
# executes through the backend-neutral compute interface on the AMD Radeon GPU
# (slang -> pure runner -> compute_* -> ROCm): matvec / rmsnorm / attention equal
# to the CPU reference within 1e-4 relative, and same greedy token ids as the CPU runner for
# stories15M, the llama.cpp reference text, and prefix reuse that changes cost
# only. Prints a CPU-vs-GPU perf table to the log.
# Run with SLANG_GPU=rocm (default rocm; compute_open("auto") honours it and errors instead of
# falling back). Gate: runs only when the selected backend is present and the stories15M model directory
# exists (SLANG_PURE_MODEL, default C:/dev/model/llama2c-stories15M). The CPU
# leg is slow on the seed interpreter (minutes).

use std.spec.{describe, it, expect, skip}
use std.io_runtime.{env_get, is_dir, file_append_text, dir_create_all}
use std.nogc_sync_mut.io.time_ops.{time_now_nanos}
use std.gc_async_mut.gpu.rocm.hip_compute.{rocm_available_at, rocm_bin_default}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops.{PureTensor, tensor_from_values, tensor_matvec, tensor_rmsnorm, tensor_attention}
use std.gc_async_mut.slang.model_executor.pure.compute_backend.{compute_open, compute_kind_name, compute_device_name, compute_upload, compute_download, compute_matvec, compute_rmsnorm, compute_attention, compute_gpu_library_loaded}
use std.gc_async_mut.slang.model_executor.pure.llama_forward.{llama_load}
use std.gc_async_mut.slang.model_executor.pure.kv_cache.{kv_session_new, kv_generate_greedy}
use std.gc_async_mut.slang.model_executor.pure.tokenizer.{pure_tokenizer_load, pure_tokenizer_encode, pure_tokenizer_decode}
use std.gc_async_mut.slang.model_executor.pure.llama_forward_gpu.{gpu_llama_load, gpu_llama_free, gpu_kv_session_new, gpu_kv_session_free, gpu_generate_greedy, llama_logits_gpu}

# The runner does not keep stdout of passing examples and counts skip() as a
# pass, so evidence (and every skip reason) is also appended to a file.
fn _record(line: text):
    print line
    dir_create_all("build/probe")
    file_append_text("build/probe/pure_evidence.txt", line + "\n")

fn _skip(name: text, why: text):
    _record("SKIPPED: " + name + " -- " + why)
    skip(name, why)

# llama.cpp greedy continuation of "Once upon a time" for this model.
val REFERENCE = ", there was a little girl named Lily. She loved to play outside in the sun"
val N_GPU = 18
val N_CPU = 12

# Backend under test: SLANG_GPU (rocm), default rocm. The same
# assertions apply to every backend; compute_open("auto") honours SLANG_GPU and
# errors instead of falling back to another backend.
fn _want() -> text:
    val e = env_get("SLANG_GPU").lower()
    if e == "":
        return "rocm"
    e

fn _backend_present() -> bool:
    val w = _want()
    if w == "rocm":
        return rocm_available_at(rocm_bin_default())
    false

fn _model_dir() -> text:
    # env_get returns "" (not None) when unset.
    val env_dir = env_get("SLANG_PURE_MODEL")
    val d = if env_dir != "": env_dir else: "C:/dev/model/llama2c-stories15M"
    if is_dir(d):
        return d
    ""

fn _ms_since(t0: i64) -> i64:
    (time_now_nanos() - t0) / 1000000

fn _slice(xs: [i64], from: i64, to: i64) -> [i64]:
    var out: [i64] = []
    var i = from
    while i < to:
        out.push(xs[i])
        i = i + 1
    out

fn _first_diff(a: [i64], b: [i64]) -> i64:
    var i: i64 = 0
    while i < a.len() and i < b.len():
        if a[i] != b[i]:
            return i
        i = i + 1
    -1

# Divergence diagnostic: GPU argmax and top-2 logit margin after `ids`.
fn _gpu_margin(ops, m, ids: [i64]) -> text:
    val s = gpu_kv_session_new(ops, m).unwrap()
    val r = gpu_generate_greedy(ops, m, s, ids, 0).unwrap()
    val logits = compute_download(ops, llama_logits_gpu(ops, m, r.session.hidden).unwrap()).unwrap()
    var b1: i64 = 0
    var i: i64 = 1
    while i < logits.data.len():
        if logits.data[i] > logits.data[b1]:
            b1 = i
        i = i + 1
    var b2: i64 = if b1 == 0: 1 else: 0
    i = 0
    while i < logits.data.len():
        if i != b1 and logits.data[i] > logits.data[b2]:
            b2 = i
        i = i + 1
    "top1={b1} ({logits.data[b1]}) top2={b2} ({logits.data[b2]}) margin={logits.data[b1] - logits.data[b2]}"

fn _tps(n: i64, ms: i64) -> f64:
    if ms <= 0:
        return 0.0
    (n * 1000) as f64 / (ms as f64)

fn _rand(n: i64, seed: i64) -> [f64]:
    var out: [f64] = []
    var s = seed
    var i: i64 = 0
    while i < n:
        s = (s * 1103515245 + 12345) % 2147483648
        out.push(((s % 20001) as f64) / 10000.0 - 1.0)
        i = i + 1
    out

fn _rel_err(gpu: PureTensor, cpu: PureTensor) -> f64:
    var scale = 1.0
    var i: i64 = 0
    while i < cpu.data.len():
        val a = if cpu.data[i] < 0.0: -cpu.data[i] else: cpu.data[i]
        if a > scale:
            scale = a
        i = i + 1
    var worst = 0.0
    i = 0
    while i < cpu.data.len():
        val d0 = gpu.data[i] - cpu.data[i]
        val d = if d0 < 0.0: -d0 else: d0
        if d > worst:
            worst = d
        i = i + 1
    worst / scale

describe "slang pure runner op parity through the compute interface":
    it "matvec, rmsnorm and attention on the GPU equal the CPU reference":
        val name = "matvec, rmsnorm and attention on the GPU equal the CPU reference"
        if not _backend_present():
            _skip(name, "{_want()} backend not available on this host")
        else:
            val ops = compute_open("auto").unwrap()
            _record("OPS BACKEND: {compute_kind_name(ops.kind)} device={compute_device_name(ops)}")
            expect(compute_kind_name(ops.kind)).to_equal(_want())
            expect(compute_gpu_library_loaded()).to_equal(true)
            # matvec 288x288 (q_proj shape) and the rmsnorm over 288
            val w = tensor_from_values(_rand(288 * 288, 1), [288, 288])
            val x = tensor_from_values(_rand(288, 2), [288])
            val nw = tensor_from_values(_rand(288, 3), [288])
            val gw = compute_upload(ops, w).unwrap()
            val gx = compute_upload(ops, x).unwrap()
            val gnw = compute_upload(ops, nw).unwrap()
            val e_mv = _rel_err(compute_download(ops, compute_matvec(ops, gw, gx).unwrap()).unwrap(), tensor_matvec(w, x))
            val e_rn = _rel_err(compute_download(ops, compute_rmsnorm(ops, gx, gnw, 0.00001).unwrap()).unwrap(), tensor_rmsnorm(x, nw, 0.00001))
            # attention: 6 heads x 48, 5 positions of a [16, 288] KV buffer
            val q = tensor_from_values(_rand(288, 4), [288])
            val kb = tensor_from_values(_rand(16 * 288, 5), [16, 288])
            val vb = tensor_from_values(_rand(16 * 288, 6), [16, 288])
            val ga = compute_attention(ops, compute_upload(ops, q).unwrap(), compute_upload(ops, kb).unwrap(), compute_upload(ops, vb).unwrap(), 5, 6, 48).unwrap()
            val e_at = _rel_err(compute_download(ops, ga).unwrap(), tensor_attention(q, kb, vb, 5, 6, 48))
            _record("PARITY rel_err matvec={e_mv} rmsnorm={e_rn} attention={e_at}")
            expect(e_mv < 0.0001).to_equal(true)
            expect(e_rn < 0.0001).to_equal(true)
            expect(e_at < 0.0001).to_equal(true)

describe "slang pure runner forward pass on the AMD GPU via the compute interface":
    it "generates the same greedy ids as the CPU runner and reuses a shared prefix":
        val dir = _model_dir()
        _record("GATE: backend={_want()} present={_backend_present()} model_dir=[{dir}]")
        val name = "generates the same greedy ids as the CPU runner and reuses a shared prefix"
        if not _backend_present():
            _record("SKIPPED: ROCm DLLs not found in {rocm_bin_default()}")
            _skip(name, "{_want()} backend not available on this host")
        elif dir == "":
            _record("SKIPPED: stories15M model directory not present")
            _skip(name, "stories15M model directory not present")
        else:
            val ops = compute_open("auto").unwrap()
            _record("BACKEND: {compute_kind_name(ops.kind)} diag=[{ops.diag}]")
            expect(compute_kind_name(ops.kind)).to_equal(_want())
            val dev = compute_device_name(ops)
            _record("DEVICE: {dev}")
            expect(dev).to_contain("Radeon")

            val tok = pure_tokenizer_load(dir).unwrap()
            val prompt = pure_tokenizer_encode(tok, "Once upon a time", true)

            # GPU: weights once, then greedy generation (first run includes kernel compile).
            var t0 = time_now_nanos()
            val gm = gpu_llama_load(ops, dir).unwrap()
            val upload_ms = _ms_since(t0)
            t0 = time_now_nanos()
            val g1 = gpu_generate_greedy(ops, gm, gpu_kv_session_new(ops, gm).unwrap(), prompt, N_GPU).unwrap()
            val gpu_ms = _ms_since(t0)
            val gpu_text = pure_tokenizer_decode(tok, g1.generated)
            _record("gpu_ids={g1.generated}")
            _record("gpu_text=[{gpu_text}]")

            # CPU reference over the same prompt (N_CPU new tokens).
            val cm = llama_load(dir).unwrap()
            t0 = time_now_nanos()
            val c1 = kv_generate_greedy(cm, kv_session_new(cm), prompt, N_CPU)
            val cpu_ms = _ms_since(t0)
            _record("cpu_ids={c1.generated}")

            val gpu_head = _slice(g1.generated, 0, N_CPU)
            val d = _first_diff(gpu_head, c1.generated)
            if d >= 0:
                _record("DIVERGENCE at new-token index {d}: cpu={c1.generated[d]} gpu={gpu_head[d]}")
                _record("GPU logits there: {_gpu_margin(ops, gm, prompt + _slice(c1.generated, 0, d))}")

            # Request 2: shared prefix (prompt + first 3 generated), warm vs fresh session.
            val req2 = prompt + _slice(g1.generated, 0, 3)
            t0 = time_now_nanos()
            val before = g1.session.positions_evaluated
            val r2 = gpu_generate_greedy(ops, gm, g1.session, req2, 3).unwrap()
            val reuse_ms = _ms_since(t0)
            val reuse_positions = r2.session.positions_evaluated - before
            t0 = time_now_nanos()
            val r2f = gpu_generate_greedy(ops, gm, gpu_kv_session_new(ops, gm).unwrap(), req2, 3).unwrap()
            val fresh_ms = _ms_since(t0)
            val fresh_positions = r2f.session.positions_evaluated

            var tbl = "| run | new tokens | positions | ms | tokens/s |\n"
            tbl = tbl + "| model upload (F32 bytes, once) | - | - | {upload_ms} | - |\n"
            tbl = tbl + "| CPU greedy (incl. cache) | {c1.generated.len()} | {c1.session.positions_evaluated} | {cpu_ms} | {_tps(c1.generated.len(), cpu_ms)} |\n"
            tbl = tbl + "| GPU greedy, first run (incl. kernel compile) | {g1.generated.len()} | {g1.session.positions_evaluated} | {gpu_ms} | {_tps(g1.generated.len(), gpu_ms)} |\n"
            tbl = tbl + "| GPU request 2, prefix reuse ({r2.reused_positions} cached) | {r2.generated.len()} | {reuse_positions} | {reuse_ms} | {_tps(r2.generated.len(), reuse_ms)} |\n"
            tbl = tbl + "| GPU request 2, fresh session | {r2f.generated.len()} | {fresh_positions} | {fresh_ms} | {_tps(r2f.generated.len(), fresh_ms)} |"
            _record(tbl)

            # (b) GPU ids == CPU ids, and the text is the llama.cpp reference.
            expect(gpu_head).to_equal(c1.generated)
            expect(gpu_text).to_equal(REFERENCE)
            # (c) prefix reuse changes cost, not output.
            expect(r2.generated).to_equal(r2f.generated)
            expect(r2.generated).to_equal(_slice(g1.generated, 3, 6))
            expect(reuse_positions < fresh_positions).to_equal(true)

            gpu_kv_session_free(ops, r2.session).unwrap()
            gpu_kv_session_free(ops, r2f.session).unwrap()
            gpu_llama_free(ops, gm).unwrap()
