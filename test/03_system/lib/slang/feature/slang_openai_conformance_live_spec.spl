# @cover src/app/slang_server/main.spl 80%
# @cover src/lib/gc_async_mut/slang/entrypoints/openai/api_server.spl 80%
# @cover src/lib/gc_async_mut/slang/entrypoints/openai/protocol.spl 60%
# Purpose and audience: executable specification evidence for the owning engineering team.
# design: doc/00_llm_process/feature_expert/slang_local_inference/skill.md

"""
## Purpose and audience
Purpose: measure how much of the OpenAI-compatible surface the slang HTTP server
really serves on the llama.cpp lane. One server child (`src/app/slang_server/main.spl`)
is started once per file and reused by every case; each case talks HTTP/1.1 to it
over loopback with `TcpStream`.
Audience: maintainers of `src/app/slang_server/` and the OpenAI entrypoints.

## What is checked
Non-stream chat envelope, temperature 0 determinism, a system message, GET
/v1/models, error shapes (400 malformed / missing messages, 404 unknown model and
route, 405 wrong method), POST /v1/completions, GET /health and two concurrent
requests. Cases that the server does not implement yet (max_tokens
finish_reason, stop sequences, SSE streaming) live in slang_openai_conformance_in_development_spec.spl.
Token usage counts are NOT asserted (doc/08_tracking/bug/slang_openai_usage_counts_always_zero_2026-11-15.md).

## Compatibility and limitations
Runs only with SLANG_LIVE=1, SIMPLE_BINARY, SLANG_MODEL_ROOT and SLANG_GGML_LIB
(see slang_http_server_live_spec.spl). Port 47731 so it can run beside that spec.
Windows only for the child launch. Server output: build/probe/slang_openai_conformance.*.
"""

use std.spec.{describe, it, expect, step, skip, fail}
use std.io_runtime.{env_get, is_dir, file_exists, thread_sleep, time_now_monotonic_ms}
use std.nogc_sync_mut.io.tcp.{TcpStream}
use std.nogc_sync_mut.io.process_ops.{process_spawn_redirected, process_kill_tree, process_is_running}
use std.gc_async_mut.slang.entrypoints.openai.protocol.{json_string_field}

val DEFAULT_MODEL = "Qwen2.5-1.5B-Instruct-Q4_K_M"
val PORT = 47731
val ADDR = "127.0.0.1:47731"
val OUT_PATH = "build/probe/slang_openai_conformance.out"
val ERR_PATH = "build/probe/slang_openai_conformance.err"
val START_TIMEOUT_S = 240

var SERVER_PID: i64 = -1

struct Probe:
    status: i64
    headers: text
    body: text

fn _model() -> text:
    val m = env_get("CARET_SLANG_MODEL") ?? ""
    if m == "":
        return DEFAULT_MODEL
    m

fn _root() -> text:
    env_get("SLANG_MODEL_ROOT") ?? ""

fn _missing() -> text:
    if (env_get("SLANG_LIVE") ?? "") != "1":
        return "SLANG_LIVE=1 not set"
    val bin = env_get("SIMPLE_BINARY") ?? ""
    if bin == "" or not file_exists(bin):
        return "SIMPLE_BINARY unset or missing: '" + bin + "'"
    if _root() == "" or not is_dir(_root() + "/" + _model()):
        return "model '" + _model() + "' not under SLANG_MODEL_ROOT '" + _root() + "'"
    if (env_get("SLANG_GGML_LIB") ?? "") == "":
        return "SLANG_GGML_LIB unset (build/sffi_openai/slang_ggml.dll)"
    ""

fn _request(method: text, path: text, body: text) -> text:
    method + " " + path + " HTTP/1.1\r\nHost: " + ADDR + "\r\nContent-Type: application/json\r\nContent-Length: " +
        body.len().to_text() + "\r\nConnection: close\r\n\r\n" + body

fn _parse(raw: text) -> Probe:
    val split = raw.index_of("\r\n\r\n")
    if split < 0:
        return Probe(status: -1, headers: "", body: raw)
    val first_sp = raw.index_of(" ")
    var status: i64 = -1
    if first_sp > 0:
        status = raw.slice(first_sp + 1, first_sp + 4).to_i64()
    Probe(status: status, headers: raw.slice(0, split), body: raw.slice(split + 4, raw.len()))

# One HTTP/1.1 exchange over a fresh loopback connection; status -1 = transport failure.
fn _http(method: text, path: text, body: text) -> Probe:
    val conn = TcpStream.connect(ADDR)
    if conn.is_err():
        return Probe(status: -1, headers: "", body: "connect failed")
    var stream = conn.unwrap()
    if stream.write_text(_request(method, path, body)).is_err():
        val _w = stream.close()
        return Probe(status: -1, headers: "", body: "write failed")
    val read = stream.read_text()
    val _c = stream.close()
    if read.is_err():
        return Probe(status: -1, headers: "", body: "read failed")
    _parse(read.unwrap())

fn _chat_body(extra: text, messages: text) -> text:
    "{\"model\":\"" + _model() + "\"," + extra + "\"messages\":[" + messages + "]}"

fn _user(text_content: text) -> text:
    "{\"role\":\"user\",\"content\":\"" + text_content + "\"}"

fn _chat(extra: text, messages: text) -> Probe:
    _http("POST", "/v1/chat/completions", _chat_body(extra, messages))

fn _wait_ready(pid: i64) -> bool:
    val deadline = time_now_monotonic_ms() + START_TIMEOUT_S * 1000
    while time_now_monotonic_ms() < deadline:
        if not process_is_running(pid):
            return false
        val p = _http("GET", "/v1/models", "")
        if p.status == 200:
            return true
        thread_sleep(2000)
    false

# Start the server child once per spec file; later calls are no-ops.
fn _ensure_server():
    if SERVER_PID >= 0:
        return
    val args = ["run", "src/app/slang_server/main.spl", "--", "--plaintext-development",
        "--models=" + _root(), "--model=" + _model(), "--port=" + PORT.to_text(), "--n-ctx=2048"]
    val t0 = time_now_monotonic_ms()
    val pid = process_spawn_redirected(env_get("SIMPLE_BINARY") ?? "", args, OUT_PATH, ERR_PATH, 0, 1048576)
    if pid < 0:
        fail("could not start slang_server child (pid " + pid.to_text() + ")")
    SERVER_PID = pid
    val ready = _wait_ready(pid)
    print "SLANG_OPENAI ready=" + ready.to_text() + " startup_ms=" + (time_now_monotonic_ms() - t0).to_text()
    if not ready:
        val _k = process_kill_tree(pid)
        SERVER_PID = -1
        fail("server not ready; see " + OUT_PATH + " and " + ERR_PATH)

describe "slang OpenAI-compatible surface over loopback HTTP":

    it "1. chat completion (non-stream) has the OpenAI envelope":
        val gate = _missing()
        if gate != "":
            skip("1. chat completion (non-stream) has the OpenAI envelope", gate)
        else:
            _ensure_server()
            val r = _chat("\"max_tokens\":16,", _user("Say hello in one short sentence."))
            print "SLANG_OPENAI case1 status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(r.body).to_contain("\"id\":\"")
            expect(r.body).to_contain("\"object\":\"chat.completion\"")
            expect(json_string_field(r.body, "model")).to_equal(_model())
            expect(r.body).to_contain("\"role\":\"assistant\"")
            expect(json_string_field(r.body, "content") != "").to_equal(true)
            val fr = json_string_field(r.body, "finish_reason")
            expect(fr == "stop" or fr == "length").to_equal(true)

    it "4. temperature 0 twice gives identical content":
        val gate = _missing()
        if gate != "":
            skip("4. temperature 0 twice gives identical content", gate)
        else:
            _ensure_server()
            val a = _chat("\"temperature\":0,\"max_tokens\":16,", _user("Name three primary colors."))
            val b = _chat("\"temperature\":0,\"max_tokens\":16,", _user("Name three primary colors."))
            print "SLANG_OPENAI case4 a=" + json_string_field(a.body, "content") + " | b=" + json_string_field(b.body, "content")
            expect(a.status).to_equal(200)
            expect(b.status).to_equal(200)
            expect(json_string_field(a.body, "content") != "").to_equal(true)
            expect(json_string_field(a.body, "content")).to_equal(json_string_field(b.body, "content"))

    it "6. a system message is honoured in a multi-turn conversation":
        val gate = _missing()
        if gate != "":
            skip("6. a system message is honoured in a multi-turn conversation", gate)
        else:
            _ensure_server()
            val msgs = "{\"role\":\"system\",\"content\":\"You must reply with exactly the single word BLUE to every message, whatever is asked, and nothing else.\"}," +
                _user("What is the capital of France?") + "," +
                "{\"role\":\"assistant\",\"content\":\"BLUE\"}," + _user("And of Italy?")
            val r = _chat("\"temperature\":0,\"max_tokens\":8,", msgs)
            print "SLANG_OPENAI case6 status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(json_string_field(r.body, "content").to_lower()).to_contain("blue")

    it "7. GET /v1/models lists the served model; unknown routes give the 404 error shape":
        val gate = _missing()
        if gate != "":
            skip("7. GET /v1/models lists the served model; unknown routes give the 404 error shape", gate)
        else:
            _ensure_server()
            val m = _http("GET", "/v1/models", "")
            print "SLANG_OPENAI case7 models=" + m.body
            expect(m.status).to_equal(200)
            expect(m.body).to_contain("\"object\":\"list\"")
            expect(m.body).to_contain("\"id\":\"" + _model() + "\"")
            expect(m.body).to_contain("\"object\":\"model\"")
            val nf = _http("GET", "/v1/no_such_route", "")
            print "SLANG_OPENAI case7 notfound=" + nf.status.to_text() + " " + nf.body
            expect(nf.status).to_equal(404)
            expect(nf.body).to_contain("\"error\"")
            expect(json_string_field(nf.body, "type")).to_equal("invalid_request_error")
            expect(json_string_field(nf.body, "code")).to_equal("not_found")

    it "7b. POST /v1/completions serves legacy text completion":
        val gate = _missing()
        if gate != "":
            skip("7b. POST /v1/completions serves legacy text completion", gate)
        else:
            _ensure_server()
            val r = _http("POST", "/v1/completions", "{\"model\":\"" + _model() + "\",\"prompt\":\"The capital of France is\",\"max_tokens\":8,\"temperature\":0}")
            print "SLANG_OPENAI case7b status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(r.body).to_contain("\"object\":\"text_completion\"")
            expect(json_string_field(r.body, "text").to_lower()).to_contain("paris")
            expect(json_string_field(r.body, "finish_reason") != "").to_equal(true)

    it "7c. GET /health answers 200 and wrong methods get 405":
        val gate = _missing()
        if gate != "":
            skip("7c. GET /health answers 200 and wrong methods get 405", gate)
        else:
            _ensure_server()
            val r = _http("GET", "/health", "")
            print "SLANG_OPENAI case7c status=" + r.status.to_text() + " body=" + r.body
            expect(r.status).to_equal(200)
            expect(r.body).to_contain("\"status\":\"ok\"")
            val post = _http("POST", "/health", "")
            expect(post.status).to_equal(405)

    it "8. error shapes: malformed JSON, missing messages, unknown model, wrong method":
        val gate = _missing()
        if gate != "":
            skip("8. error shapes: malformed JSON, missing messages, unknown model, wrong method", gate)
        else:
            _ensure_server()
            val bad = _http("POST", "/v1/chat/completions", "{\"model\": \"x\", \"messages\": [")
            print "SLANG_OPENAI case8 malformed=" + bad.status.to_text() + " " + bad.body
            expect(bad.status).to_equal(400)
            expect(json_string_field(bad.body, "type")).to_equal("invalid_request_error")
            val nomsg = _http("POST", "/v1/chat/completions", "{\"model\":\"" + _model() + "\"}")
            print "SLANG_OPENAI case8 nomessages=" + nomsg.status.to_text() + " " + nomsg.body
            expect(nomsg.status).to_equal(400)
            expect(json_string_field(nomsg.body, "type")).to_equal("invalid_request_error")
            val unk = _http("POST", "/v1/chat/completions", "{\"model\":\"no-such-model-9f2\",\"messages\":[" + _user("hi") + "]}")
            print "SLANG_OPENAI case8 unknown=" + unk.status.to_text() + " " + unk.body
            expect(unk.status).to_equal(404)
            expect(json_string_field(unk.body, "code")).to_equal("model_not_found")
            val wrong = _http("GET", "/v1/chat/completions", "")
            print "SLANG_OPENAI case8 wrongmethod=" + wrong.status.to_text() + " " + wrong.body
            expect(wrong.status).to_equal(405)
            expect(json_string_field(wrong.body, "code")).to_equal("method_not_allowed")

    it "9. two concurrent requests on two connections both get correct answers":
        val gate = _missing()
        if gate != "":
            skip("9. two concurrent requests on two connections both get correct answers", gate)
        else:
            _ensure_server()
            val ca = TcpStream.connect(ADDR)
            val cb = TcpStream.connect(ADDR)
            expect(ca.is_ok() and cb.is_ok()).to_equal(true)
            var sa = ca.unwrap()
            var sb = cb.unwrap()
            val wa = sa.write_text(_request("POST", "/v1/chat/completions", _chat_body("\"temperature\":0,\"max_tokens\":8,", _user("What is the capital of France? Answer in one word."))))
            val wb = sb.write_text(_request("POST", "/v1/chat/completions", _chat_body("\"temperature\":0,\"max_tokens\":8,", _user("What is the capital of Japan? Answer in one word."))))
            expect(wa.is_ok() and wb.is_ok()).to_equal(true)
            val ra = sa.read_text()
            val rb = sb.read_text()
            val _x = sa.close()
            val _y = sb.close()
            expect(ra.is_ok() and rb.is_ok()).to_equal(true)
            val pa = _parse(ra.unwrap())
            val pb = _parse(rb.unwrap())
            print "SLANG_OPENAI case9 a=" + pa.body + " b=" + pb.body
            expect(pa.status).to_equal(200)
            expect(pb.status).to_equal(200)
            expect(json_string_field(pa.body, "content")).to_contain("Paris")
            expect(json_string_field(pb.body, "content")).to_contain("Tokyo")

    it "shuts the server child down":
        if SERVER_PID >= 0:
            val killed = process_kill_tree(SERVER_PID)
            expect(killed).to_equal(true)
            expect(process_is_running(SERVER_PID)).to_equal(false)
            SERVER_PID = -1
