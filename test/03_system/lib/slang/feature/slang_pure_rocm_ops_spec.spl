"""
## Purpose
Proves the pure runner's ROCm ops provider really executes on the AMD GPU:
device identity from HIP, GPU matvec equal to the CPU op, and a CPU-vs-GPU
timing table for the stories15M shapes (32000x288 head, 288x288 projection).
Skips with a reason when the ROCm DLLs are absent.
"""

use std.spec.*
use std.gc_async_mut.gpu.rocm.hip_compute.{rocm_available_at, rocm_bin_default}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops.{PureTensor, tensor_from_values, tensor_matvec}
use std.gc_async_mut.slang.model_executor.pure.tensor_ops_rocm.{rocm_ops_open, rocm_ops_device_name, rocm_tensor_upload, rocm_tensor_download, rocm_tensor_matvec, rocm_tensor_free, rocm_ops_sync}

extern fn rt_time_now_nanos() -> i64

fn rand_values(n: i64, seed: i64) -> [f64]:
    var out: [f64] = []
    var s = seed
    var i: i64 = 0
    while i < n:
        s = (s * 1103515245 + 12345) % 2147483648
        out.push(((s % 20001) as f64) / 10000.0 - 1.0)
        i = i + 1
    out

fn rel_err(gpu: PureTensor, cpu: PureTensor) -> f64:
    var scale = 1.0
    var i: i64 = 0
    while i < cpu.data.len():
        val a = if cpu.data[i] < 0.0: -cpu.data[i] else: cpu.data[i]
        if a > scale:
            scale = a
        i = i + 1
    var worst = 0.0
    i = 0
    while i < cpu.data.len():
        val d0 = gpu.data[i] - cpu.data[i]
        val d = if d0 < 0.0: -d0 else: d0
        if d > worst:
            worst = d
        i = i + 1
    worst / scale

# One shape: returns the relative error and prints a perf row.
fn bench_shape(ops, rows: i64, cols: i64, cpu_reps: i64, gpu_reps: i64) -> f64:
    val w = tensor_from_values(rand_values(rows * cols, 11), [rows, cols])
    val x = tensor_from_values(rand_values(cols, 12), [cols])
    val tu0 = rt_time_now_nanos()
    val dw = rocm_tensor_upload(ops, w).unwrap()
    val tu1 = rt_time_now_nanos()
    val dx = rocm_tensor_upload(ops, x).unwrap()
    # warm-up (kernel compile + first launch) outside the timings
    rocm_tensor_download(ops, rocm_tensor_matvec(ops, dw, dx).unwrap()).unwrap()
    var cpu = tensor_matvec(w, x)
    val tc0 = rt_time_now_nanos()
    var r: i64 = 0
    while r < cpu_reps:
        cpu = tensor_matvec(w, x)
        r = r + 1
    val tc1 = rt_time_now_nanos()
    # excluding transfer: launch + device sync only (weights and x resident)
    val tk0 = rt_time_now_nanos()
    r = 0
    while r < gpu_reps:
        val dy0 = rocm_tensor_matvec(ops, dw, dx).unwrap()
        rocm_ops_sync(ops).unwrap()
        rocm_tensor_free(ops, dy0).unwrap()
        r = r + 1
    val tk1 = rt_time_now_nanos()
    # including transfer: upload x, matvec, download y (weights resident)
    val tt0 = rt_time_now_nanos()
    var gpu = cpu
    r = 0
    while r < gpu_reps:
        val dxi = rocm_tensor_upload(ops, x).unwrap()
        val dyi = rocm_tensor_matvec(ops, dw, dxi).unwrap()
        gpu = rocm_tensor_download(ops, dyi).unwrap()
        rocm_tensor_free(ops, dyi).unwrap()
        rocm_tensor_free(ops, dxi).unwrap()
        r = r + 1
    val tt1 = rt_time_now_nanos()
    val cpu_ms = (tc1 - tc0) / cpu_reps / 1000
    val excl_us = (tk1 - tk0) / gpu_reps / 1000
    val incl_us = (tt1 - tt0) / gpu_reps / 1000
    print "PERF matvec {rows}x{cols}: cpu_ms={cpu_ms / 1000}.{cpu_ms % 1000} gpu_excl_transfer_us={excl_us} gpu_incl_x_up_y_down_us={incl_us} weight_upload_once_ms={(tu1 - tu0) / 1000000}"
    rel_err(gpu, cpu)

describe "slang pure runner ROCm provider (system)":
    it "runs matvec on the Radeon GPU and matches the CPU op":
        if not rocm_available_at(rocm_bin_default()):
            print "SKIP: ROCm DLLs not found in {rocm_bin_default()}"
        else:
            val ops = rocm_ops_open().unwrap()
            val name = rocm_ops_device_name(ops)
            print "DEVICE: {name}"
            expect(name).to_contain("Radeon")
            val e_small = bench_shape(ops, 288, 288, 20, 200)
            val e_head = bench_shape(ops, 32000, 288, 1, 20)
            print "PERF rel_err small={e_small} head={e_head}"
            expect(e_small < 0.0001).to_equal(true)
            expect(e_head < 0.0001).to_equal(true)
