"""
BLAKE3 specification gap checks. Proof class: production API, AUTHORED_UNRUN.
Official BLAKE3 vectors f55849f89cd85083c1c9daa2c5de20766f309c00,
SHA256 dcb91ea8accc77e6d6e632af7cdc1a99a9f3ae78cf648da595c7d064db32f624.
Input byte i = i modulo 251; expected digests are independent published bytes.
No runtime, branch percentage, or generated-manual completion is claimed.
"""
# codex-system-test
use std.spec.*
use std.common.crypto.blake3.{blake3_hash, blake3_hash_xof, blake3_keyed_hash, blake3_derive_key, blake3_hex, blake3_bytes}

# @inline
fn load_blake3_vectors(n: i64) -> [u8]:
    var data: [u8] = []
    for i in 0..n:
        data.push((i % 251).to_u8())
    data

use std.common.spec.evidence.model.{EvidenceStatus, canonical_evidence, evidence_node, check_exact, oracle_spec}
use std.common.spec.evidence.evidence_comparator.{compare_evidence}

# @inline
fn assert_blake3_digest(digest: [u8], expected: text):
    val evidence = canonical_evidence("binary", "blake3.digest/1", [evidence_node("digest.hex", blake3_hex(digest))])
    val oracle = oracle_spec("blake3.digest/1", [check_exact("digest.hex", expected)])
    expect(compare_evidence(evidence, oracle).status).to_equal(EvidenceStatus.passed)

describe "BLAKE3 domain and tree specification evidence":
    it "should match official keyed_hash at 63 bytes with a closed typed oracle":
        # @req REQ-HASH-BLAKE3-003
        step("Load the published vector")
        val data = load_blake3_vectors(63)
        step("Hash through the production API")
        val digest = blake3_keyed_hash("whats the Elvish word for friend".bytes(), data)
        step("Compare the expected digest")
        assert_blake3_digest(digest, "bb1eb5d4afa793c1ebdd9fb08def6c36d10096986ae0cfe148cd101170ce37ae")

    it "should match official derive_key at 63 bytes with a closed typed oracle":
        # @req REQ-HASH-BLAKE3-003
        step("Load the published vector")
        val data = load_blake3_vectors(63)
        step("Hash through the production API")
        val digest = blake3_derive_key("BLAKE3 2019-12-27 16:29:52 test vectors context", data)
        step("Compare the expected digest")
        assert_blake3_digest(digest, "b6451e30b953c206e34644c6803724e9d2725e0893039cfc49584f991f451af3")

    it "should match official keyed_hash at 3073 bytes with a closed typed oracle":
        # @req REQ-HASH-BLAKE3-003
        step("Load the published vector")
        val data = load_blake3_vectors(3073)
        step("Hash through the production API")
        val digest = blake3_keyed_hash("whats the Elvish word for friend".bytes(), data)
        step("Compare the expected digest")
        assert_blake3_digest(digest, "68dede9bef00ba89e43f31a6825f4cf433389fedae75c04ee9f0cf16a427c95a")

    it "should match official derive_key at 3073 bytes with a closed typed oracle":
        # @req REQ-HASH-BLAKE3-003
        step("Load the published vector")
        val data = load_blake3_vectors(3073)
        step("Hash through the production API")
        val digest = blake3_derive_key("BLAKE3 2019-12-27 16:29:52 test vectors context", data)
        step("Compare the expected digest")
        assert_blake3_digest(digest, "72613c9ec9ff7e40f8f5c173784c532ad852e827dba2bf85b2ab4b76f7079081")

    it "should reject corrupted digest evidence and missing digest nodes":
        # @req REQ-HASH-EVIDENCE-001
        step("Load the published vector")
        val expected = "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262"
        step("Hash through the production API")
        val digest = blake3_hash([])
        step("Compare the expected digest")
        assert_blake3_digest(digest, expected)
        val oracle = oracle_spec("blake3.digest/1", [check_exact("digest.hex", expected)])
        val corrupted = canonical_evidence("binary", "blake3.digest/1", [evidence_node("digest.hex", "00" + blake3_hex(digest)[2:64])])
        expect(compare_evidence(corrupted, oracle).status).to_equal(EvidenceStatus.failed)
        val absent = canonical_evidence("binary", "blake3.digest/1", [])
        expect(compare_evidence(absent, oracle).status).to_equal(EvidenceStatus.failed)
