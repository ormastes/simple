    AccessPattern, AffinityGroupId, AnyObject, ArenaResidency, ArtifactId,
    CostUnit, DeviceMask, ObjectRef, PersistencePolicy, PlacementBudget,
    PlacementRequest, ResidentView, ResidencyTier, ResidencyTierSet, StageEpoch,
    TransferReceipt, artifact_id, hash128, object_ref
}
