use common.structural.layout.types.{LayoutArena, layout_input_with_residency}
use common.ui.draw_ir_v3.{DrawIrV3Scene}
use common.ui.draw_ir_v3_emit.{draw_ir_v3_emit, draw_ir_v3_empty_request, draw_ir_v3_plan_emission}
