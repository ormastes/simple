# @cover src/lib/gc_async_mut/gpu/rocm/hip_reduce.spl
# @cover src/lib/nogc_async_mut/compute/backend_dispatch.spl
"""
## Purpose
Proves the std.compute HIP reduce offload really executes on the AMD GPU:
a kernel is compiled with hipRTC, launched, and its readback equals the CPU
fold for every reduce op; the same result arrives through
`dispatch_reduce_i64` on a HIP target. Also proves the absent-HIP contract:
with no ROCm libraries nothing is loaded, a required HIP target fails closed,
and a suggested one resolves to the CPU and computes there.

The device examples skip with a recorded reason when the ROCm libraries are
absent; the absent-HIP example runs on every host.
"""

use std.spec.*
use std.io_runtime.{file_append_text, dir_create_all, env_get, env_set}
use std.gc_async_mut.gpu.rocm.hip_compute.{rocm_available_at, rocm_bin_default}
use std.gc_async_mut.gpu.rocm.hip_reduce.{HipReduceOp, HipReduceRequest, HipReduceRun, hip_reduce_device, hip_reduce_device_at, hip_reduce_i64, hip_reduce_i64_at}
use std.nogc_async_mut.compute.exec_target.{ComputeDeviceClass, ComputeBackend, EnforceMode, BackendCaps, ExecTarget, resolve_exec_target}
use std.nogc_async_mut.compute.backend_dispatch.{gpu_payload_present, dispatch_reduce_i64, dispatch_requirement_met}

val MISSING_ROCM_DIR = "build/probe/no-rocm-here"

# The runner does not keep stdout of passing examples and counts skip() as a
# pass, so evidence (and every skip reason) is also appended to a file.
fn _record(line: text):
    print line
    dir_create_all("build/probe")
    file_append_text("build/probe/hip_reduce_evidence.txt", line + "\n")

val HIP_OPS = [HipReduceOp.Add, HipReduceOp.Mul, HipReduceOp.Min, HipReduceOp.Max, HipReduceOp.Xor, HipReduceOp.And, HipReduceOp.Or]

fn _hip(data: [i64], init: i64, op_kind: i64) -> HipReduceRun:
    hip_reduce_i64(HipReduceRequest(data: data, init: init, op: HIP_OPS[op_kind])).unwrap()

fn _add(a: i64, b: i64) -> i64:
    a + b

fn _max(a: i64, b: i64) -> i64:
    if b > a: b else: a

fn _cpu_fold(data: [i64], init: i64, op_kind: i64) -> i64:
    var acc = init
    for v in data:
        if op_kind == 0:
            acc = acc + v
        elif op_kind == 1:
            acc = acc * v
        elif op_kind == 2:
            acc = if v < acc: v else: acc
        elif op_kind == 3:
            acc = if v > acc: v else: acc
        elif op_kind == 4:
            acc = acc ^ v
        elif op_kind == 5:
            acc = acc & v
        else:
            acc = acc | v
    acc

# Signed values spread over about +-1e12; 1000 of them is not a multiple of
# the 256-thread block, so the strided fold and the tree both matter.
fn _signed_values(n: i64, seed: i64) -> [i64]:
    var out: [i64] = []
    var s = seed
    var i: i64 = 0
    while i < n:
        s = (s * 1103515245 + 12345) % 2147483648
        out.push((s - 1073741824) * 931)
        i = i + 1
    out

fn _hip_target() -> ExecTarget:
    ExecTarget.create(ComputeDeviceClass.Gpu, ComputeBackend.Hip, EnforceMode.Require, true, "hip-system-spec")

describe "std.compute HIP reduce offload (system)":
    it "runs the reduce kernel on the AMD GPU and matches the CPU fold for every op":
        if not rocm_available_at(rocm_bin_default()):
            _record("SKIPPED: ROCm DLLs not found in {rocm_bin_default()}")
        else:
            val data = _signed_values(1000, 7)
            val first = _hip(data, 5, 0)
            _record("HIP DEVICE: {first.device_name}")
            expect(first.device_name == "").to_equal(false)
            expect(hip_reduce_device().unwrap()).to_equal(first.device_name)
            val names = ["add", "mul", "min", "max", "xor", "and", "or"]
            var op: i64 = 0
            while op < 7:
                # mul uses a short input so the CPU oracle stays inside i64.
                val input = if op == 1: [3, -7, 11, 5, -2] else: data
                val init = if op == 5: -1 else: 5
                val cpu = _cpu_fold(input, init, op)
                val gpu = _hip(input, init, op)
                _record("HIP REDUCE {names[op]} n={input.len()} init={init} gpu={gpu.value} cpu={cpu}")
                expect(gpu.value).to_equal(cpu)
                op = op + 1
            # Edge sizes: no data returns init, one element folds once.
            expect(_hip([], 42, 0).value).to_equal(42)
            expect(_hip([-9], 4, 2).value).to_equal(-9)
            # The add result is not the init the buffer was seeded with.
            expect(first.value == 5).to_equal(false)
            expect(first.value).to_equal(_cpu_fold(data, 5, 0))

    it "dispatches a HIP target through std.compute to the device":
        if not rocm_available_at(rocm_bin_default()):
            _record("SKIPPED: ROCm DLLs not found in {rocm_bin_default()}")
        else:
            val data = _signed_values(513, 11)
            expect(gpu_payload_present("hip")).to_equal(true)
            expect(dispatch_requirement_met(_hip_target())).to_equal(true)
            val sum = dispatch_reduce_i64(data, 2, _add, _hip_target())
            _record("HIP DISPATCH add n=513 ok={sum.ok} value={sum.value} backend={sum.stats.backend} ran_on_cpu={sum.stats.ran_on_cpu} error={sum.error}")
            expect(sum.ok).to_equal(true)
            expect(sum.value).to_equal(_cpu_fold(data, 2, 0))
            expect(sum.stats.backend).to_equal("hip")
            expect(sum.stats.ran_on_cpu).to_equal(false)
            val top = dispatch_reduce_i64(data, -5, _max, _hip_target())
            expect(top.ok).to_equal(true)
            expect(top.value).to_equal(_cpu_fold(data, -5, 3))

    it "falls back to the CPU when HIP is absent and never claims the device":
        val prev = env_get("SLANG_ROCM_BIN")
        env_set("SLANG_ROCM_BIN", MISSING_ROCM_DIR)
        val available = rocm_available_at(rocm_bin_default())
        val present = gpu_payload_present("hip")
        val direct = hip_reduce_i64_at(MISSING_ROCM_DIR, HipReduceRequest(data: [1, 2, 3], init: 0, op: HipReduceOp.Add))
        val device = hip_reduce_device_at(MISSING_ROCM_DIR)
        val required = dispatch_reduce_i64([10, 20, 30], 0, _add, _hip_target())
        var caps = BackendCaps.none()
        caps.has_hip = present
        val suggested = resolve_exec_target(ComputeDeviceClass.Gpu, ComputeBackend.Hip, EnforceMode.Suggest, caps)
        val fallback = dispatch_reduce_i64([10, 20, 30], 0, _add, suggested)
        env_set("SLANG_ROCM_BIN", prev)
        _record("HIP ABSENT available={available} required_ok={required.ok} required_error={required.error} fallback_backend={fallback.stats.backend} fallback_value={fallback.value} fallback_ran_on_cpu={fallback.stats.ran_on_cpu}")
        expect(available).to_equal(false)
        expect(present).to_equal(false)
        expect(direct.is_err()).to_equal(true)
        expect(device.is_err()).to_equal(true)
        # Required HIP: fails closed, no value, no CPU run reported as device.
        expect(required.ok).to_equal(false)
        expect(required.value).to_equal(0)
        expect(required.error).to_equal("gpu-backend-unavailable:hip")
        expect(required.stats.ran_on_cpu).to_equal(false)
        # Suggested HIP: resolves to the CPU and the CPU computes the value.
        expect(suggested.is_cpu()).to_equal(true)
        expect(fallback.ok).to_equal(true)
        expect(fallback.value).to_equal(60)
        expect(fallback.stats.ran_on_cpu).to_equal(true)
