# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# Web/DB SIMD acceleration — system-level honesty gate.
#
# The claim under test is "the web/db server path has SIMD/GPU acceleration logic and
# it works". Two things have to be true for that claim to mean anything, and this spec
# separates them on purpose:
#
#   1. the accelerated scan returns the RIGHT ROWS (absolute oracle, not equality to
#      itself -- a scan compared only against another run of the same scan passes just
#      as happily when both are empty);
#   2. the capability report tells the TRUTH about whether SIMD actually ran.
#
# Measured 2026-08-11: `accel_capability_report()` in src/lib/nogc_sync_mut/db/accel.spl
# hard-codes `simd_active: false` and `scalar_fallback: true`. SIMD was DETECTED but
# never ACTIVATED on the db path.
#
# Wired 2026-09-16 (deliberate, with this evidence): the row-bitmap word kernels
# (`RowBitmap.and_with` / `or_with` / `and_not` -> `rt_db_bitmap_{and,or,andnot}_u32`)
# dispatch natively whenever the detected tier is non-scalar, so `simd_active` now
# tracks `simd_available` and `scalar_fallback` reports the complement. Evidence for
# the wiring: this spec, plus test/unit/lib/db/accel_spec.spl and
# test/unit/lib/db/native_accel_micro_spec.spl, all green on an AVX-512 host
# (tier_name=x86_64_avx512, simd_width_bits=512, report:
# available=true active=true fallback=false) on 2026-09-16.
#
# @manual_section Web/DB acceleration

use std.spec.step

use std.spipe.*
use std.db.accel.{
    accel_capability_report,
    collect_text_row_indices,
    ScanPredicate, ScanPredicateKind
}
use std.simd.{detect_profile, profile_name, SimdTier}

# A fixed corpus with a KNOWN answer. The oracle is the literal index list below, not a
# second computation over the same data -- that is what makes this a real check.
fn accel_corpus() -> [text]:
    ["src/app/main.spl", "doc/readme.md", "src/lib/db/accel.spl",
     "build/tmp.o", "src/os/kernel.spl", "doc/guide.md"]

# Rows 0, 2, 4 begin with "src/". Hand-verified against accel_corpus() above.
fn expected_src_rows() -> [i64]:
    [0, 2, 4]

describe "Web/DB server SIMD acceleration":
    """
    Verifies the web/db server's accelerated scan path returns correct rows
    against a hand-verified oracle, and that its capability report cannot
    silently overclaim SIMD acceleration it did not actually run.
    """

    it "returns exactly the rows matching the predicate, not merely a self-consistent set":
        # @req REQ-SSPEC-SYSTEM
        step("returns exactly the rows matching the predicate, not merely a self-consistent set")
        step("Load a fixed corpus whose matching rows are known by hand")
        val corpus = accel_corpus()
        expect(corpus.len()).to_equal(6)

        step("Run the accelerated prefix scan the server's query path uses")
        val predicate = ScanPredicate(
            kind: ScanPredicateKind.StartsWith,
            text_value: "src/",
            key_value: 0
        )
        val (rows, stats) = collect_text_row_indices(corpus, predicate)

        step("Compare against the absolute oracle, not against another scan")
        val expected = expected_src_rows()
        expect(rows.len()).to_equal(expected.len())
        expect(rows.len()).to_equal(3)
        var idx = 0
        while idx < expected.len():
            expect(rows[idx]).to_equal(expected[idx])
            idx = idx + 1

        step("Confirm the scan actually walked every row rather than short-circuiting")
        expect(stats.rows_scanned).to_equal(6)

    it "reports a capability set that cannot silently overclaim acceleration":
        # @req REQ-SSPEC-SYSTEM
        step("reports a capability set that cannot silently overclaim acceleration")
        step("Read the acceleration capability report the server exposes")
        val report = accel_capability_report()

        step("Confirm the reported SIMD tier agrees with what the host actually detects")
        expect(report.tier_name).to_equal(profile_name())
        val tier = detect_profile()
        val detected_available = match tier:
            case SimdTier.scalar: false
            case _: true
        expect(report.simd_available).to_be(detected_available)

        step("Confirm active-implies-available: claiming to run SIMD that is not there is the fraud")
        if report.simd_active:
            assert_true(report.simd_available)

        step("Confirm active and scalar_fallback are not both asserted at once")
        if report.simd_active:
            expect_not(report.scalar_fallback)

    it "records that db SIMD dispatch is wired to the detected tier":
        # @req REQ-SSPEC-SYSTEM
        step("records that db SIMD dispatch is wired to the detected tier")
        # Rewritten 2026-09-16 as the deliberate, evidenced flip of the boolean the
        # 2026-08-11 measurement pinned: native row-bitmap word kernels now dispatch
        # on any non-scalar tier, so active tracks available and scalar_fallback is
        # its complement. Evidence: this spec plus test/unit/lib/db/accel_spec.spl
        # and test/unit/lib/db/native_accel_micro_spec.spl green 2026-09-16.
        step("Read the capability report")
        val report = accel_capability_report()

        step("Assert active agrees with available on this host")
        val tier = detect_profile()
        val detected_available = match tier:
            case SimdTier.scalar: false
            case _: true
        expect(report.simd_active).to_be(detected_available)

        step("Assert scalar_fallback is the complement of simd_active")
        expect(report.scalar_fallback).to_be(not report.simd_active)

        step("Assert the width is still reported")
        expect(report.simd_width_bits).to_be_greater_than(0)
