# @manual_section: Authenticated Darwin image provisioning reaches the real owner and worker.
# @req REQ-DARWIN-IMAGE-BIND-003 REQ-DARWIN-IMAGE-BIND-004
use std.spec.{describe, it, expect, is_macos, pending}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

describe "Darwin authenticated image owner":
    it "should bind authenticated artifact bytes through provisioning and native launch":
        if is_macos():
            step("Provision from authenticated memory and compare private DER with Apple's serializer")
            val (out, err, code) = process_run_bounded("/bin/sh",
                ["scripts/check/check-sosix-darwin-bound-image.shs"], 30000, 65536)
            expect(code).to_equal(0)
            expect(out).to_contain("PASS: authenticated malformed load commands signatures and loader policies reject")
            expect(out).to_contain("PASS: authenticated in-memory signature provisions an executable accepted by AMFI")
            expect(out).to_contain("PASS: Apple strict validation accepts the provisioned in-memory signature")
            expect(out).to_contain("PASS: production LWCR encoding matches Apple serializer for zero and high-bit CDHashes")
            step("Attack the production image owner after its final userspace validation")
            expect(out).to_contain("PASS: wrong authenticated digest is rejected before image ownership")
            expect(out).to_contain("PASS: attacker sparse-file growth is rejected without unbounded rehash or spawn")
            expect(out).to_contain("PASS: authenticated source provisions and executes through the real process owner")
            expect(out).to_contain("PASS: post-validation replacement is killed before executable constructor and main entry")
            expect(out).to_contain("PASS: retained-FD mutation terminates without a successful child result")
            expect(out).to_contain("PASS: unconstrained source proves injected library can execute")
            expect(out).to_contain("PASS: provisioned owner denies direct and injected custom dependencies before constructors")
            step("Require a manifest digest at the worker boundary without granting strict tree authority")
            expect(out).to_contain("PASS: worker executes the explicit authenticated bound-image profile")
            expect(out).to_contain("PASS: worker refuses a mismatched manifest digest before execution")
            expect(out).to_contain("STATUS: PASS (kernel-bound image and cooperative group only; strict Tree/V4 unavailable)")
        else:
            pending("Native AMFI image owner evidence requires macOS")
