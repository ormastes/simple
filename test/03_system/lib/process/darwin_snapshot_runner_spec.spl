# @manual_section: Native Darwin trusted snapshot runner; strict V4 remains unavailable.
# @tag: system, process, macos, native
use std.spec.{describe, it, expect, pending, step}
use std.io_runtime.{process_run}
use std.nogc_sync_mut.env.platform.{is_macos}

describe "Darwin trusted snapshot runner":
    if not is_macos():
        it "reports unavailable on a non-Darwin host":
            # @req REQ-DARWIN-SNAPSHOT-001
            step("Require an actual macOS host for native evidence")
            pending("Native Darwin snapshot runner requires macOS")
        return

    val (stdout, stderr, code) = process_run("/bin/sh", ["scripts/check/check-sosix-darwin-snapshot-runner.shs"])

    it "reports the actual cooperative capabilities":
        # @req REQ-DARWIN-SNAPSHOT-001
        step("Query capabilities without claiming immutable images or escaped descendants")
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("PASS capabilities: strict V4 unavailable\n")

    it "rejects strict V4 before acquiring or spawning an executable":
        # @req REQ-DARWIN-SNAPSHOT-002
        step("Request sealed-v4 and prove the child marker was not created")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS strict profile: rejected before spawn\n")

    it "preserves exact child invocation and results":
        # @req REQ-DARWIN-SNAPSHOT-003
        step("Launch a real Mach-O with spaces in argv and explicit environment and cwd")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS capture: exact argv environment cwd streams exit\n")

    it "enforces a deadline against a TERM-ignoring child":
        # @req REQ-DARWIN-SNAPSHOT-004
        step("Escalate to KILL and retire the owned group before returning timeout")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS timeout: TERM KILL reap group retirement\n")

    it "drains overflow while preserving the retention bound":
        # @req REQ-DARWIN-SNAPSHOT-005
        step("Drain ten thousand output bytes while retaining one hundred twenty-eight")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS output: retained 128 of 10000 bytes\n")

    it "resolves relative temporary directories before changing the child cwd":
        # @req REQ-DARWIN-SNAPSHOT-006
        step("Launch with TMPDIR dot and a different descriptor-backed child cwd")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS relative TMPDIR: snapshot survives child cwd change\n")

    it "rejects a FIFO executable without blocking before spawn":
        # @req REQ-DARWIN-SNAPSHOT-007
        step("Open a FIFO candidate without a writer and require immediate provider failure")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS FIFO: rejected without blocking before spawn\n")
