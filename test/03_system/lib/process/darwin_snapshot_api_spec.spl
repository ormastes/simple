# @manual_section: Cooperative Darwin runtime API; no deployed P2 or V4 admission.
# @tag: system, process, macos, native
use std.spec.{describe, it, expect, pending, step}
use std.io_runtime.{process_run}
use std.nogc_sync_mut.env.platform.{is_macos}

describe "Darwin cooperative snapshot runtime API":
    if not is_macos():
        it "requires a native Darwin provider":
            step("Require macOS for native runtime API evidence")
            pending("Cooperative snapshot API requires macOS")
        return

    val (stdout, stderr, code) = process_run("/bin/sh", ["scripts/check/check-sosix-darwin-snapshot-api.shs"])

    it "advertises only qualified cooperative capabilities":
        # @req REQ-DARWIN-SNAPSHOT-API-001
        step("Query native capability words and verify seals and escaped containment remain unavailable")
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("PASS snapshot API capabilities: cooperative path snapshot group only")

    it "rejects a strict profile before acquiring process authority":
        # @req REQ-DARWIN-SNAPSHOT-API-002
        step("Call the runtime start API with strict profile and no executable input")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API admission: strict profile rejected before acquisition")

    it "preserves binary captures and consumes opaque authority exactly once":
        # @req REQ-DARWIN-SNAPSHOT-API-003
        step("Spawn an owned Mach-O with spaces, complete env and cwd; replay frozen NUL bytes; acknowledge and reject stale handle")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API lifecycle: argv env cwd binary capture replay ack stale handle")

    it "bounds retention while draining the entire stream":
        # @req REQ-DARWIN-SNAPSHOT-API-004
        step("Drain ten thousand child bytes while retaining one hundred twenty-eight")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API output: bounded retention and complete drain")

    it "owns timeout cleanup through TERM KILL and reap":
        # @req REQ-DARWIN-SNAPSHOT-API-005
        step("Expire a deadline against a TERM-ignoring child then retire the group")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API timeout: TERM KILL reap group retirement")

    it "keeps cancelled authority until the child has retired":
        # @req REQ-DARWIN-SNAPSHOT-API-006
        step("Cancel by opaque runtime handle, poll frozen result, then acknowledge")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API cancel: opaque owner retained until completion")

    it "rejects unsafe input and incompatible SIGCHLD before spawning":
        # @req REQ-DARWIN-SNAPSHOT-API-007
        step("Reject duplicate environment, ignored SIGCHLD, and a FIFO executable without blocking")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API preflight: duplicate environment SIGCHLD FIFO rejected")

    it "rejects fork-inherited process authority before touching the registry lock":
        # @req REQ-DARWIN-SNAPSHOT-API-008
        step("Fork the API caller; reject inherited cancel ack start output; verify parent still owns its live child")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS snapshot API fork: inherited authority rejected before registry lock")
