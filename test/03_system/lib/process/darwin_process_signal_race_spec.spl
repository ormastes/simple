# @manual_section: Cooperative Darwin process cleanup; no deployed P2 or sealed V4 qualification.
# @tag: system, process, macos, native
use std.spec.{describe, it, expect, pending, step}
use std.io_runtime.{process_run}
use std.nogc_sync_mut.env.platform.{is_macos}

describe "Darwin descendant signal retirement race":
    if not is_macos():
        it "requires native Darwin process observations":
            step("Require macOS for process group and signal evidence")
            pending("Darwin process cleanup requires macOS")
        return

    val (stdout, stderr, code) = process_run("/bin/sh", ["scripts/check/check-sosix-darwin-process.shs"])

    it "completes native descendant cleanup and retains authority across repeated EPERM":
        step("Run native descendant retirement and inject an exit between the group snapshot and repeated SIGKILL")
        expect(code).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("Darwin owned process snapshot component: PASS")
        expect(stdout).to_contain("PASS Darwin signal race: repeated EPERM retains process authority")
        expect(stdout).to_contain("PASS Darwin signal race: independent empty snapshot permits one reap and acknowledgement")

    it "bounds persistent denial and preserves an initial permission error":
        step("Keep a live descendant in the snapshot until the cleanup deadline, then deny the initial signal")
        expect(code).to_equal(0)
        expect(stdout).to_contain("PASS Darwin signal race: persistent denial reaches cleanup deadline")
        expect(stdout).to_contain("PASS Darwin signal race: initial permission denial remains an error")
