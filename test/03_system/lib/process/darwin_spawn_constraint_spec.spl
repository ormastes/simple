# @manual_section: Darwin AMFI image binding is native experimental evidence, not V4 admission.
# @req REQ-DARWIN-IMAGE-BIND-001 REQ-DARWIN-IMAGE-BIND-002
use std.spec.{describe, it, expect}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}

describe "Darwin kernel executable and dependency identity":
    it "should reject same-UID substitutions in the kernel and enforce signed dependency constraints":
        step("Compile native Mach-O fixtures and exercise the kernel launch constraint")
        val (out, err, code) = process_run_bounded("/bin/sh",
            ["scripts/check/check-sosix-darwin-spawn-constraint.shs"], 30000, 65536)
        expect(code).to_equal(0)
        step("Contrast unbound launch with exact identity and retained-descriptor mutation")
        expect(out).to_contain("PASS: negative control executes replacement without kernel binding")
        expect(out).to_contain("PASS: matching CDHash executes")
        expect(out).to_contain("PASS: same-UID rename after binding is rejected before constructors")
        expect(out).to_contain("PASS: retained writable descriptor mutation is rejected before constructors")
        step("Check direct and transitive dependencies and environment injection before constructors")
        expect(out).to_contain("PASS: signed allowlist permits the exact custom library")
        expect(out).to_contain("PASS: different custom library is rejected before its constructor")
        expect(out).to_contain("PASS: allowed library cannot load an unlisted transitive dependency")
        expect(out).to_contain("PASS: unlisted DYLD_INSERT_LIBRARIES code never executes")
        expect(out).to_contain("PASS: removing signed dependency constraints invalidates launch binding")
        step("Keep image evidence distinct from strict descendant ownership and provider admission")
        expect(out).to_contain("STATUS: PASS (experimental image binding only; no strict tree or V4 admission)")
