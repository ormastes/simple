# @tag:in-development
# @req REQ-XRAY-V1-API-01
"""
# XRay ("spy") backend differential — OUT (black-box) suite

Builds a tiny instrumented program, runs it, toggles tracing at runtime and
asserts on the EXTERNALLY observed edge transcript — the same assertions for
every backend (`assert_edges`): entries == exits > 0, no foreign/other edges,
nothing recorded after stop, timing field present on every record, traced
results equal the untraced baseline. The simple lane also prints one
`E2E <s> container initial=... lookups_before=... profiling_on=...
lookups_on=... profiling_off=... lookups_after_stop=...` line per session (an
AdaptiveMap flipped by XrayDataProfilingV1 after start / request_stop);
`xr_session_ok` requires false/0/true/2/false/2 under the dynamic aspect.

Why `@tag:in-development` (counted, never skipped, never a PASS claim):
  - simple: the lane `scripts/check/check-xray-native-inprocess-e2e.shs` is
    complete, but the deployed Rust seed on this host
    (`src/compiler_rust/target/bootstrap/simple`, 2026-11-05) returns 0 from
    `rt_host_dynlib_open` for EVERY library (even libm.so.6) while a C
    `dlopen` of the same `--xray` module succeeds — see
    doc/08_tracking/bug/seed_rt_host_dynlib_open_returns_zero_2026-11-13.md.
    A binary built from PR5b or later turns this describe green unchanged.
  - llvm: no Simple-compiled `--xray` LLVM binary can be traced yet (the
    `clang_rt.xray` link + handler shim of PR4 is not landed:
    `80.driver/driver_xray_link.spl:11`). Until then the LLVM transcript
    comes from the C harness of `check-xray-llvm-adapter-e2e.shs`, which
    prints no per-record timestamp, so that single check is skipped by
    passing None — stated here, not hidden.
  - simple-win64 (stage 3, Windows x64): the static half runs anywhere —
    `scripts/check/check-xray-native-win64-objects.shs` cross-compiles the
    resident Windows runtime with clang and compares trampoline + UNWIND_INFO
    with the Simple twins. The in-process half (load a `--xray` DLL, patch
    through VirtualProtect + FlushInstructionCache, drain events, walk the
    stack through the trampoline) needs a Windows x64 host and a lane that
    does not exist yet; the example fails with the exact resume command
    rather than skipping. The native backend's Windows COFF sled emission is
    also missing, so no Simple-compiled Windows `--xray` DLL can be built.
Each describe runs ONE capped native build; keep them serial.
"""
use std.spec.*
use std.nogc_sync_mut.io_runtime.{process_run_timeout, env_get, read_file_text, file_exists, host_os}

# Per-lane wall budget. XRAY_OUT_LANE_TIMEOUT_MS shortens it when only the
# spec's own parsing/verdict path is under test (the lanes then fail fast).
fn lane_timeout_ms() -> i64:
    val knob = env_get("XRAY_OUT_LANE_TIMEOUT_MS")
    if knob != "": knob.to_i64() else: 1500000

# The binary that BUILDS and HOSTS the traced module. XRAY_OUT_SIMPLE_BINARY
# lets a lane point at a newer self-hosted binary (or a fast-failing one when
# only the spec's own parsing is under test) without touching the runner's
# SIMPLE_BINARY identity check.
fn simple_binary() -> text:
    val lane = env_get("XRAY_OUT_SIMPLE_BINARY")
    if lane != "": return lane
    val explicit = env_get("SIMPLE_BINARY")
    if explicit != "": explicit else: "bin/simple"

# "key=value" scalar field of a transcript line ("" when absent).
fn field(line: text, key: text) -> text:
    val marker = " {key}="
    val at = line.index_of(marker)
    if at < 0: return ""
    val rest = line.substring(at + marker.len(), line.len())
    val stop = rest.index_of(" ")
    if stop < 0: rest else: rest.substring(0, stop)

# "key=[a, b, c]" list field of a transcript line.
fn list_field(line: text, key: text) -> [text]:
    val marker = " {key}=["
    val at = line.index_of(marker)
    if at < 0: return []
    val rest = line.substring(at + marker.len(), line.len())
    val stop = rest.index_of("]")
    if stop < 0: return []
    val inner = rest.substring(0, stop).trim()
    if inner == "": return []
    var out: [text] = []
    for item in inner.split(","): out.push(item.trim())
    out

fn lines_with(output: text, prefix: text, key: text) -> [text]:
    var out: [text] = []
    for line in output.split("\n"):
        if line.starts_with(prefix) and line.contains(" {key}="): out.push(line)
    out

fn to_i64(value: text) -> i64:
    if value == "": -1 else: value.to_i64()

# The ONE assertion set every backend must satisfy.
fn assert_edges(label: text, entries: i64, exits: i64, others: i64, after_stop: i64,
        timestamps_nonzero: i64?, total: i64):
    expect("{label} entries>0 {entries}" != "{label} entries>0 0").to_equal(true)
    expect(entries > 0).to_equal(true)
    expect(entries).to_equal(exits)
    expect(others).to_equal(0)
    expect(after_stop).to_equal(0)
    if val stamps = timestamps_nonzero:
        expect(stamps).to_equal(total)

fn elf_host_blocked(lane: text) -> bool:
    # BLOCKED, never a crash or a silent pass: ELF lanes need a Linux host + compiler-rt.
    if host_os() != "linux":
        fail("BLOCKED: {lane} is an ELF/Linux lane (needs a Linux host with clang + compiler-rt); host is " + host_os() + "; resume on Linux: sh {lane}")
        return true
    false

fn kept_dir(stderr: text) -> text:
    for line in stderr.split("\n"):
        if line.starts_with("kept: "): return line.substring(6, line.len()).trim()
    ""

fn cleanup(dir: text):
    if dir.starts_with("/tmp/xray-inproc-e2e."):
        process_run_timeout("rm", ["-rf", dir], 60000)

describe "XRay backend differential OUT — simple (pure-Simple sleds, in-process patch)":
    it "traces only the selected functions, toggles at runtime, matches the untraced baseline":
        if elf_host_blocked("scripts/check/check-xray-native-inprocess-e2e.shs"): return
        val (stdout, stderr, status) = process_run_timeout("sh",
            ["scripts/check/check-xray-native-inprocess-e2e.shs", "--simple", simple_binary(), "--keep"], lane_timeout_ms())
        val dir = kept_dir(stderr)
        val log_path = "{dir}/host.log"
        val transcript = if dir != "" and file_exists(log_path): read_file_text(log_path) else: ""
        cleanup(dir)
        # The lane verdict is the last stdout line; the transcript is the evidence.
        val verdict_lines = stdout.trim().split("\n")
        expect(verdict_lines[verdict_lines.len() - 1].starts_with("PASS")).to_equal(true)
        expect(status as i64).to_equal(0)
        val sessions = lines_with(transcript, "E2E ", "records")
        expect(sessions.len() >= 2).to_equal(true)
        for line in sessions:
            val label = line.split(" ")[1]
            val selected = list_field(line, "records")
            val selected_sites = list_field(lines_with(transcript, "E2E {label} ", "selected_sites")[0], "selected_sites")
            var entries = 0
            var exits = 0
            var others = 0
            for row in selected:
                val parts = row.split(":")
                val kind = to_i64(parts[0])
                if kind == 1: entries = entries + 1
                elif kind == 2: exits = exits + 1
                else: others = others + 1
                # every edge belongs to a selected site
                expect(selected_sites.contains(parts[2])).to_equal(true)
            val tail = lines_with(transcript, "E2E {label} ", "records_after_stop")[0]
            val results = lines_with(transcript, "E2E {label} ", "results_on")[0]
            expect(field(results, "results_on")).to_equal(field(results, "baseline"))
            assert_edges(label, entries, exits, others, to_i64(field(tail, "records_after_stop")),
                Some(to_i64(field(line, "timestamps_nonzero"))), selected.len())

describe "XRay backend differential OUT — llvm (compiler-rt sleds)":
    it "traces only the selected functions, toggles at runtime, matches the untraced baseline":
        if elf_host_blocked("scripts/check/check-xray-llvm-adapter-e2e.shs"): return
        val (stdout, _, status) = process_run_timeout("sh", ["scripts/check/check-xray-llvm-adapter-e2e.shs"], lane_timeout_ms())
        val verdict_lines = stdout.trim().split("\n")
        expect(verdict_lines[verdict_lines.len() - 1].starts_with("PASS")).to_equal(true)
        expect(status as i64).to_equal(0)
        val patched = lines_with(stdout, "INFO patched-A:", "entry")
        expect(patched.len()).to_equal(1)
        val line = patched[0]
        val entries = to_i64(field(line, "entry"))
        val exits = to_i64(field(line, "exit"))
        val others = to_i64(field(line, "other")) + to_i64(field(line, "bad"))
        # The C harness checks "quiescent no-fire" and "unpatch" itself (PASS lines);
        # after-stop is therefore 0 when the lane passed. No per-record timestamp
        # is printed by that harness: None, stated in the header.
        assert_edges("patched-A", entries, exits, others, 0, None, entries + exits)

# Resume (Windows x64 host with bin/simple, clang + lld-link):
#   sh scripts/check/check-xray-native-win64-objects.shs --simple bin/simple
#   then the in-process lane, still to be written:
#   sh scripts/check/check-xray-native-win64-inprocess-e2e.shs --simple bin/simple
val WIN64_INPROCESS_LANE: text = "scripts/check/check-xray-native-win64-inprocess-e2e.shs"

describe "XRay backend differential OUT — simple-win64 (Windows x64 PE, stage 3)":
    it "matches the resident Windows trampoline and its unwind data to the Simple twins":
        val (stdout, _, status) = process_run_timeout("sh",
            ["scripts/check/check-xray-native-win64-objects.shs", "--simple", simple_binary()], lane_timeout_ms())
        val verdict_lines = stdout.trim().split("\n")
        expect(verdict_lines[verdict_lines.len() - 1].starts_with("PASS")).to_equal(true)
        expect(status as i64).to_equal(0)

    it "traces a --xray DLL in-process on a Windows x64 host":
        # BLOCKED, never skipped: no Windows x64 host lane and no Windows COFF
        # sled emitter in the native backend yet. Resume command above.
        val lane_present = file_exists(WIN64_INPROCESS_LANE)
        if not lane_present:
            fail("BLOCKED: {WIN64_INPROCESS_LANE} does not exist (needs a Windows x64 host and the native backend's COFF sled emitter); resume: sh {WIN64_INPROCESS_LANE} --simple bin/simple on Windows x64")
        val (stdout, _, status) = process_run_timeout("sh", [WIN64_INPROCESS_LANE, "--simple", simple_binary()], lane_timeout_ms())
        val verdict_lines = stdout.trim().split("\n")
        expect(verdict_lines[verdict_lines.len() - 1].starts_with("PASS")).to_equal(true)
        expect(status as i64).to_equal(0)
