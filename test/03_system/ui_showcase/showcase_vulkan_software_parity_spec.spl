# @cover src/lib/gc_async_mut/gpu/engine2d/backend_vulkan.spl 20%
# @tag: system, gpu, engine2d, vulkan, text, parity
"""Vulkan vs Software parity on the shared widget showcase scene (200x150).

Regression spec for
`doc/08_tracking/bug/engine2d_vulkan_software_showcase_frame_divergence_2026-07-02.md`.
Vulkan availability is required evidence: a missing device fails closed.
"""

use std.spec.*
use std.gpu.engine2d.engine.{Engine2D}
use app.ui_showcase.showcase_core.{showcase_build_sized, showcase_scene}
use common.ui.draw_ir_v3.{
    draw_ir_v3_geometry_at, draw_ir_v3_paint_at, draw_ir_v3_text_run_at,
    draw_ir_v3_glyph_at, draw_ir_v3_has_flag,
    DRAW_IR_V3_KIND_RECT, DRAW_IR_V3_KIND_TEXT, DRAW_IR_V3_KIND_EDGE,
    DRAW_IR_V3_FLAG_HIDDEN, DRAW_IR_V3_NO_ID
}

val W: i32 = 200
val H: i32 = 150
val BG: u32 = 0xFF14141Cu32

fn _mismatches(left: [u32], right: [u32]) -> i32:
    if left.len() != right.len():
        return -1
    var mismatches = 0
    var i = 0
    while i < left.len():
        if left[i] != right[i]:
            mismatches = mismatches + 1
        i = i + 1
    mismatches


# ---------------------------------------------------------------------------
# The real shared showcase scene, walked into Engine2D exactly as
# examples/06_io/ui/widget_showcase_gui.spl `paint_scene_engine2d` does. This
# is the frame the bug record measured (1136/30000 px), not a hand replay.
# ---------------------------------------------------------------------------

val SCENE_CHARSET: text = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .,:;!?-_()[]/\\'\"+=#%&@*<>abcdefghijklmnopqrstuvwxyz"

fn _scene_glyph_char(gid: i32) -> text:
    if gid < 0 or gid >= SCENE_CHARSET.len():
        return "?"
    SCENE_CHARSET.substring(gid, gid + 1)

fn _showcase_engine_frame(backend_key: text) -> [u32]:
    var b = Engine2D.create_with_backend(W, H, backend_key)
    if b.backend_name() != backend_key:
        fail("requested backend " + backend_key + " but got " + b.backend_name())
        b.shutdown()
        var none: [u32] = []
        return none
    val ui = showcase_build_sized("vkparity_" + backend_key, 10, 6)
    val scene = showcase_scene(ui, W, H)
    b.clear(BG)
    var painted: i64 = 0
    var i: i64 = 0
    val n = scene.commands.len().to_i64()
    while i < n:
        val cmd = scene.commands[i]
        if not draw_ir_v3_has_flag(cmd, DRAW_IR_V3_FLAG_HIDDEN):
            if cmd.kind == DRAW_IR_V3_KIND_RECT or cmd.kind == DRAW_IR_V3_KIND_EDGE:
                if cmd.geometry_id != DRAW_IR_V3_NO_ID:
                    val geom = draw_ir_v3_geometry_at(scene.geometry, cmd.geometry_id)
                    val paint = draw_ir_v3_paint_at(scene.paint, cmd.paint_id)
                    if geom.present and paint.present and geom.width > 0 and geom.height > 0:
                        b.draw_rect_filled(geom.x, geom.y, geom.width, geom.height, paint.fill_color)
                        val stroke_px = paint.stroke_width_milli / 1000
                        if stroke_px > 0:
                            b.draw_rect(geom.x, geom.y, geom.width, geom.height, paint.stroke_color, stroke_px)
                        painted = painted + 1
            else if cmd.kind == DRAW_IR_V3_KIND_TEXT:
                if cmd.text_run_id != DRAW_IR_V3_NO_ID:
                    val run = draw_ir_v3_text_run_at(scene.text_runs, cmd.text_run_id)
                    if run.present and run.glyph_count != 0u32:
                        val start = run.glyph_start.to_i64()
                        val count = run.glyph_count.to_i64()
                        var s_out = ""
                        var first_x = run.baseline_x
                        var g: i64 = 0
                        while g < count:
                            val glyph = draw_ir_v3_glyph_at(scene.text_runs, (start + g) as u32)
                            if glyph.present:
                                if g == 0:
                                    first_x = glyph.x
                                s_out = s_out + _scene_glyph_char(glyph.glyph_id.to_i64() as i32)
                            g = g + 1
                        if s_out != "":
                            var fs = run.font_size_milli / 1000
                            if fs < 1:
                                fs = 1
                            b.draw_text(first_x, run.baseline_y - fs, s_out, run.color, fs)
                            painted = painted + 1
        i = i + 1
    b.present()
    val pixels = b.read_pixels()
    if backend_key == "vulkan":
        # Provenance, so a green run cannot be a CPU mirror compared with itself.
        val fallback = b.vulkan_cpu_fallback_reason()
        val submits = b.vulkan_accepted_compute_submit_count()
        print "showcase_parity vulkan_device={b.vulkan_device_name()} driver={b.vulkan_driver_identity()} cpu_fallback_reason={fallback} compute_submits={submits}"
        if fallback != "" or submits < 1:
            fail("Vulkan frame was not device-rendered: fallback=" + fallback)
    b.shutdown()
    print "showcase_parity backend={backend_key} commands={n} painted={painted} pixels={pixels.len()}"
    if painted < 10:
        var empty: [u32] = []
        return empty
    pixels

describe "Vulkan vs Software shared showcase scene parity (200x150)":
    it "renders the shared showcase scene identically on both backends":
        val sw = _showcase_engine_frame("software")
        val vk = _showcase_engine_frame("vulkan")
        expect(sw.len()).to_equal(30000)
        expect(_mismatches(vk, sw)).to_equal(0)
