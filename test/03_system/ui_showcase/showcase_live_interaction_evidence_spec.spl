# @req: REQ-SSPEC-SYSTEM
"""
# GUI and web showcase live interaction evidence

Strict live launchers may report PASS only after a real frame, click,
scrollbar drag, typed input, linked-panel scroll equality, and an unchanged
free-panel negative control are all present in one ShowcaseRunReport.
"""

use std.spec.*
use app.ui_showcase.showcase_core.{ShowcaseRunReport}
use app.ui_showcase.hosts.live_interaction_evidence.{
    showcase_live_interaction_complete, showcase_live_interaction_reason,
    showcase_wm_live_reason
}

fn _report(host: text, frames: i64, clicks: i64, drags: i64, typed: text,
           left: i32, right: i32, free: i32) -> ShowcaseRunReport:
    ShowcaseRunReport(
        host_name: host, frames: frames, clicks: clicks, drags: drags,
        typed_text: typed, left_offset: left, right_offset: right,
        free_offset: free)

describe "showcase live interaction evidence":

    it "accepts complete GUI and web internal-window interactions":
        step("Validate complete real-GUI and browser semantic receipts")
        val gui = _report("gui", 12, 1, 1, "abc", 24, 24, 0)
        val web = _report("web", 12, 1, 1, "abc", 24, 24, 0)
        expect(showcase_live_interaction_complete(gui)).to_equal(true)
        expect(showcase_live_interaction_complete(web)).to_equal(true)
        expect(showcase_live_interaction_reason(gui)).to_equal("")

    it "rejects missing or vacuous interaction evidence":
        step("Reject each missing live interaction dimension")
        expect(showcase_live_interaction_reason(_report("gui", 0, 1, 1, "abc", 24, 24, 0))).to_equal("no-presented-frame")
        expect(showcase_live_interaction_reason(_report("gui", 12, 0, 1, "abc", 24, 24, 0))).to_equal("internal-window-click-missing")
        expect(showcase_live_interaction_reason(_report("gui", 12, 1, 0, "abc", 24, 24, 0))).to_equal("scrollbar-drag-missing")
        expect(showcase_live_interaction_reason(_report("web", 12, 1, 1, "", 24, 24, 0))).to_equal("text-input-missing")
        expect(showcase_live_interaction_reason(_report("web", 12, 1, 1, "abc", 0, 0, 0))).to_equal("linked-panel-scroll-missing")
        expect(showcase_live_interaction_reason(_report("web", 12, 1, 1, "abc", 24, 12, 0))).to_equal("linked-panel-scroll-mismatch")
        expect(showcase_live_interaction_reason(_report("web", 12, 1, 1, "abc", 24, 24, 8))).to_equal("free-panel-negative-control-moved")

    it "requires a concrete exported WM frame receipt":
        step("Combine semantic interaction with exported pixel evidence")
        val report = _report("wm", 12, 1, 1, "abc", 24, 24, 0)
        expect(showcase_wm_live_reason(report, true, 4096, 12345, 2)).to_equal("")
        expect(showcase_wm_live_reason(report, false, 4096, 12345, 2)).to_equal("frame-export-disabled")
        expect(showcase_wm_live_reason(report, true, 0, 12345, 2)).to_equal("exported-pixels-missing")
        expect(showcase_wm_live_reason(report, true, 4096, 0, 2)).to_equal("exported-checksum-missing")
        expect(showcase_wm_live_reason(report, true, 4096, 12345, 0)).to_equal("exported-frame-sequence-missing")
