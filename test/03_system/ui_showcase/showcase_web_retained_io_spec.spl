# @req: REQ-SSPEC-SYSTEM
"""
# Web showcase retained document I/O

Repeated unchanged frames remain successful presentations but must not rewrite
the same HTML document. A changed scene must publish exactly one new document.
"""

use std.spec.*
use std.io_runtime.{mkdir_p, write_file}
use common.ui.host_input_event.{HostInputEvent, host_pointer_down, host_pointer_up}
use common.ui.wm_app_process_contract.{
    wm_fs_app_event, wm_fs_app_event_encode, wm_fs_app_event_seq_path
}
use app.ui_showcase.showcase_core.{
    showcase_apply, showcase_build, showcase_run, showcase_scene,
    showcase_scene_with_generation
}
use app.ui_showcase.hosts.host_web.{ScreenWebHost}

describe "web showcase retained document I/O":

    it "writes one document for repeated unchanged frames":
        step("Run three retained frames with no input")
        val root = "build/test-showcase-web-retained-io"
        mkdir_p(root)
        val host = ScreenWebHost.open(320, 240, root + "/showcase.html", "")!
        val report = showcase_run(host, "web_retained", 3)
        expect(report.frames).to_equal(3)
        expect(host.html_write_count).to_equal(1)
        expect(host.html_serialize_count).to_equal(1)
        expect(host.last_html_len > 0).to_equal(true)
        expect(host.last_scene_generation).to_equal(1u32)

    it "publishes a changed scene once":
        step("Present overview then change to the Shapes screen")
        val root = "build/test-showcase-web-retained-change"
        mkdir_p(root)
        val host = ScreenWebHost.open(320, 240, root + "/showcase.html", "")!
        var state = showcase_build("web_changed")
        expect(host.present_scene(showcase_scene(state, 320, 240))).to_equal(true)
        state = showcase_apply(state, host_pointer_down(140, 10, 1), 320, 240)
        state = showcase_apply(state, host_pointer_up(140, 10, 1), 320, 240)
        expect(host.present_scene(showcase_scene(state, 320, 240))).to_equal(true)
        expect(host.html_write_count).to_equal(2)

    it "commits identity after byte-identical regeneration":
        step("Advance generation without changing the rendered document")
        val root = "build/test-showcase-web-retained-identical"
        mkdir_p(root)
        val host = ScreenWebHost.open(320, 240, root + "/showcase.html", "")!
        val state = showcase_build("web_identical")
        val first = showcase_scene_with_generation(state, 320, 240, 1u32)
        val advanced = showcase_scene_with_generation(state, 320, 240, 2u32)
        expect(host.present_scene(first)).to_equal(true)
        expect(host.present_scene(advanced)).to_equal(true)
        expect(host.present_scene(advanced)).to_equal(true)
        expect(host.html_write_count).to_equal(1)
        expect(host.html_serialize_count).to_equal(2)

    it "advances retained generation after input mutation":
        step("Prove generation identity changes with reducer events")
        var state = showcase_build("web_generation")
        val before = showcase_scene_with_generation(state, 320, 240, 1u32)
        state = showcase_apply(state, host_pointer_down(140, 10, 1), 320, 240)
        state = showcase_apply(state, host_pointer_up(140, 10, 1), 320, 240)
        val after = showcase_scene_with_generation(state, 320, 240, 3u32)
        expect(before.generation).to_equal(1u32)
        expect(after.generation).to_equal(3u32)
        expect(before.scene_id).to_equal(after.scene_id)
        val other = showcase_scene_with_generation(
            showcase_build("web_generation_other"), 320, 240, 1u32)
        expect(other.scene_id != before.scene_id).to_equal(true)

    it "invalidates retained output and dimensions after a web resize":
        step("Post a resize through the browser event bridge")
        val root = "build/test-showcase-web-retained-resize"
        val events = root + "/events"
        mkdir_p(events)
        val host = ScreenWebHost.open(
            320, 240, root + "/showcase.html", events)!
        val state = showcase_build("web_resize")
        expect(host.present_scene(
            showcase_scene_with_generation(state, 320, 240, 1u32))).to_equal(true)
        write_file(
            wm_fs_app_event_seq_path(events + "/event", 1),
            wm_fs_app_event_encode(wm_fs_app_event(
                1, "resize", 640, 480, 0, false)))
        match host.poll_input():
            case Some(HostInputEvent.Resize(resize_w, resize_h)):
                expect(resize_w).to_equal(640)
                expect(resize_h).to_equal(480)
            case Some(_):
                fail("web resize bridge returned a non-resize event")
            case None:
                fail("web resize bridge dropped the event")
        val (host_w, host_h) = host.size()
        expect(host_w).to_equal(640)
        expect(host_h).to_equal(480)
        expect(host.present_scene(
            showcase_scene_with_generation(state, 640, 480, 1u32))).to_equal(true)
        expect(host.html_write_count).to_equal(2)
