# Purpose and audience: executable specification evidence for the rendering-showcases lane.
# @req REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-010 REQ-011
# research: doc/01_research/local/rendering_showcases.md ; plan: doc/03_plan/sys_test/rendering_showcases.md ; architecture: doc/04_architecture/rendering_showcases.md ; design: doc/05_design/rendering_showcases.md
# @cover examples/06_io/ui/rendering/ 90%
# @tag: system, ui, rendering, showcases, screen_host
"""
# Rendering showcases — canonical layout, sharing, and lane wiring

## Overview

Ten canonical showcase entries (tui/gui/wm brief+full, 2d/web core+extended)
plus a shared item list and a UI-base switch live under
`examples/06_io/ui/rendering/`. This spec verifies the structure that can be
wrong without a display: every entry exists with a lane/tier header, tiers
are import-based (extended imports core — the loading-overhead split), the
shared item list actually enumerates all rendering lanes with honest
`(no tui)` markers, the GUI full entry demonstrates internal windows
(`simple_gui_internal_window`, titled + borderless), the WM entries admit
showcase windows through the WM bridge (`apply_bridge_request` /
`COMP_CREATE_WINDOW`), the web extended entry carries the aqua-family theme
gallery, and the 2D entries wire shaped-text word spacing, pointer-event drag,
and compositor hit-testing.

Deliberately NOT asserted here: physical window appearance, browser pixels,
and frame consumption — those are artifact-captured by
`scripts/check/check-rendering-showcase-captures.shs` per NFR-002.

## Requirements

**Requirements:** REQ-002, REQ-003, REQ-004, REQ-005, REQ-006, REQ-010,
REQ-011 (doc/02_requirements/feature/rendering_showcases.md)

## Plan

**Plan:** doc/03_plan/sys_test/rendering_showcases.md

## Design

**Design:** doc/05_design/rendering_showcases.md

## Research

**Research:** doc/01_research/local/rendering_showcases.md

## Examples

The census step reads all ten entries and fails if any header lacks its
`lane:`/`tier:` marker; the item-list step requires lane tags tui/gui/wm/2d/web
and at least one `(no tui)` marker proving the unrendered WidgetKinds are
labeled, not dropped.
"""

use std.spec.step
use std.spec.*
use std.io_runtime.file_read

describe "rendering showcases canonical structure":

    it "censuses the ten entries with lane and tier headers":
        # @req REQ-002
        step("Read every canonical entry and require its lane/tier header")
        expect(file_read("examples/06_io/ui/rendering/rendering_tui_core.spl")).to_contain("lane: tui")
        expect(file_read("examples/06_io/ui/rendering/rendering_tui_full.spl")).to_contain("tier: full")
        expect(file_read("examples/06_io/ui/rendering/rendering_gui_core.spl")).to_contain("lane: gui")
        expect(file_read("examples/06_io/ui/rendering/rendering_gui_full.spl")).to_contain("tier: full")
        expect(file_read("examples/06_io/ui/rendering/rendering_wm_core.spl")).to_contain("lane: wm")
        expect(file_read("examples/06_io/ui/rendering/rendering_wm_full.spl")).to_contain("tier: full")
        expect(file_read("examples/06_io/ui/rendering/rendering_2d_core.spl")).to_contain("tier: core")
        expect(file_read("examples/06_io/ui/rendering/rendering_2d_extended.spl")).to_contain("tier: extended")
        expect(file_read("examples/06_io/ui/rendering/rendering_web_core.spl")).to_contain("lane: web")
        expect(file_read("examples/06_io/ui/rendering/rendering_web_extended.spl")).to_contain("tier: extended")
        expect(file_read("examples/06_io/ui/rendering/rendering_switch.spl")).to_contain("SIMPLE_RENDERING_UI")
        expect(file_read("examples/06_io/ui/rendering/doc.md")).to_contain("rendering_items.ui.sdn")

    it "keeps the tier split import-based":
        # @req REQ-003
        step("Require extended/full entries to import their lane core module")
        expect(file_read("examples/06_io/ui/rendering/rendering_2d_extended.spl")).to_contain("rendering_2d_core")
        expect(file_read("examples/06_io/ui/rendering/rendering_web_extended.spl")).to_contain("rendering_web_core")
        expect(file_read("examples/06_io/ui/rendering/rendering_gui_full.spl")).to_contain("rendering_widgets_full")
        expect(file_read("examples/06_io/ui/rendering/rendering_tui_full.spl")).to_contain("rendering_widgets_full")

    it "covers all rendering items in the shared item list":
        # @req REQ-004
        step("Read the shared item list and require every lane plus honest no-tui markers")
        val items = file_read("examples/06_io/ui/rendering/rendering_items.ui.sdn")
        expect(items).to_contain("tui")
        expect(items).to_contain("gui")
        expect(items).to_contain("wm")
        expect(items).to_contain("2d")
        expect(items).to_contain("web")
        expect(items).to_contain("(no tui)")
        expect(items).to_contain("panel")
        expect(items).to_contain("button")
        expect(items).to_contain("table")
        expect(items).to_contain("tree")
        expect(items).to_contain("tabs")
        expect(items).to_contain("dropdown")
        expect(items).to_contain("scrollbar")

    it "demonstrates internal windows in the gui full entry":
        # @req REQ-011
        step("Require the internal-window API with titled and borderless chrome")
        val gui_full = file_read("examples/06_io/ui/rendering/rendering_gui_full.spl")
        expect(gui_full).to_contain("simple_gui_internal_window")
        expect(gui_full).to_contain("titled")
        expect(gui_full).to_contain("borderless")

    it "admits showcase windows on the wm":
        # @req REQ-010
        step("Require the WM bridge admission path and taskbar tracking")
        val wm_full = file_read("examples/06_io/ui/rendering/rendering_wm_full.spl")
        expect(wm_full).to_contain("apply_bridge_request")
        expect(wm_full).to_contain("COMP_CREATE_WINDOW")
        expect(wm_full).to_contain("taskbar")

    it "carries the aqua-family theme gallery in web extended":
        # @req REQ-006
        step("Require the aqua themes and the extended tab set")
        val web_ext = file_read("examples/06_io/ui/rendering/rendering_web_extended.spl")
        expect(web_ext).to_contain("aqua_light")
        expect(web_ext).to_contain("aqua_dark")
        expect(web_ext).to_contain("glass_dark")
        expect(web_ext).to_contain("ios_light")

    it "wires 2d fonts spacing drag and click":
        # @req REQ-005
        step("Require shaped-text spacing, pointer drag state, and hit-testing")
        val core2d = file_read("examples/ui/rendering_2d_core/rendering_2d_core.spl")
        expect(core2d).to_contain("draw_shaped_text")
        expect(core2d).to_contain("word_spacing")
        val ext2d = file_read("examples/ui/rendering_2d_extended/rendering_2d_extended.spl")
        expect(ext2d).to_contain("host_pointer_down")
        expect(ext2d).to_contain("drag")
        expect(ext2d).to_contain("hit_rect")

    it "documents the webserver gui serving path":
        # @req REQ-001
        step("Require the ui web command in the per-directory run table")
        val doc = file_read("examples/06_io/ui/rendering/doc.md")
        expect(doc).to_contain("ui web")
        expect(doc).to_contain("8080")
