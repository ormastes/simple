# @req REQ-005 REQ-006 REQ-015
# @manual: primary
"""Exact completion and reason-bound MC/DC exclusion contract."""
use std.spec.*
use std.spec.step
use std.common.mcdc.model.*

fn exclusion(reason: text, reviewer: text = "safety-board", ordinal: i64 = 2) -> McdcExclusion:
    McdcExclusion(semantic_id: "mcdc:v1:flight/control:19", condition_ordinal: ordinal,
        whole_decision: false, reason: reason, reviewer: reviewer,
        review_id: "REV-204", expires_or_version: "v3")

describe "MC/DC enforcement and exclusions":
    it "should require exact one hundred percent rather than rounded coverage":
        step("validate reasoned exclusions")
        expect(mcdc_is_exact_complete(99, 100)).to_equal(false)
        expect(mcdc_is_exact_complete(100, 100)).to_equal(true)
        expect(mcdc_is_exact_complete(101, 100)).to_equal(false)

    it "should accept only a narrow reviewed technical exclusion":
        step("validate reasoned exclusions")
        expect(mcdc_exclusion_error(exclusion("physically unreachable after dual-channel interlock"))).to_equal("")
        expect(exclusion("physically unreachable after dual-channel interlock").whole_decision).to_equal(false)

    it "should reject blank reasons, stale identity, and broad invalid scope":
        step("validate reasoned exclusions")
        expect(mcdc_exclusion_error(exclusion(""))).to_equal("MCDC-E-EXCLUSION-REASON")
        val stale = McdcExclusion(semantic_id: "", condition_ordinal: 0, whole_decision: false,
            reason: "non-producible", reviewer: "board", review_id: "R-1", expires_or_version: "v3")
        expect(mcdc_exclusion_error(stale)).to_equal("MCDC-E-EXCLUSION-STALE")
        expect(mcdc_exclusion_error(exclusion("non-producible", ordinal: -1))).to_equal("MCDC-E-EXCLUSION-SCOPE")

