# @req NFR-001 NFR-002 NFR-003 NFR-004 NFR-005 NFR-006 NFR-007 NFR-008 NFR-009 NFR-010
# @capture artifact
# @manual: primary
"""Fail-closed schema for same-fixture MC/DC timing, RSS, allocation, and optimizer receipts."""
use std.spec.*
use std.spec.step
use std.common.mcdc.model.*

struct PerfReceipt:
    fixture: text
    baseline_ns: i64
    measured_ns: i64
    baseline_rss: i64
    measured_rss: i64
    allocations: i64
    optimizer_receipt: text

fn overhead_bp(r: PerfReceipt) -> i64:
    if r.baseline_ns <= 0: return 1000000
    (r.measured_ns - r.baseline_ns) * 10000 / r.baseline_ns

fn evidence_error(r: PerfReceipt) -> text:
    if r.fixture == "" or r.baseline_ns <= 0 or r.measured_ns <= 0: return "MCDC-PERF-E-FIXTURE"
    if r.baseline_rss <= 0 or r.measured_rss <= 0: return "MCDC-PERF-E-RSS"
    if r.allocations < 0: return "MCDC-PERF-E-ALLOC"
    if r.optimizer_receipt == "": return "MCDC-PERF-E-OPTIMIZER"
    ""

describe "MC/DC performance and memory contract":
    it "should require complete same-fixture evidence before judging overhead":
        step("capture same-fixture timing RSS allocation and optimizer evidence")
        val missing = PerfReceipt(fixture: "", baseline_ns: 0, measured_ns: 0,
            baseline_rss: 0, measured_rss: 0, allocations: -1, optimizer_receipt: "")
        expect(evidence_error(missing)).to_equal("MCDC-PERF-E-FIXTURE")

    it "should enforce exact static-on and dynamic basis-point boundaries":
        step("capture same-fixture timing RSS allocation and optimizer evidence")
        val at_five = PerfReceipt(fixture: "decision-loop-v1", baseline_ns: 100000,
            measured_ns: 105000, baseline_rss: 1000, measured_rss: 1050,
            allocations: 0, optimizer_receipt: "artifact:optimizer/mcdc-v1")
        expect(evidence_error(at_five)).to_equal("")
        expect(overhead_bp(at_five)).to_equal(500)
        expect(overhead_bp(at_five) <= 500).to_equal(true)

    it "should account fixed owner memory without per-record growth":
        step("check zero overhead evidence")
        val policy = mcdc_default_policy(McdcMode.StaticOn)
        expect(policy.owner_bytes).to_equal(1048576)
        expect(policy.global_bytes).to_equal(67108864)
        expect(mcdc_record_capacity(policy)).to_equal(6553)

