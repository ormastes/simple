# Cross-engine value-semantics probe P8: nested index assignment m[1][0] = 9.
# KNOWN divergent in ACCEPTED SYNTAX: the interpreter rejects this with
# "index assignment requires identifier or field access as container" while
# the JIT accepts and executes it. The harness must report the interpreter
# lane failure BY NAME, never as silent agreement.
fn main():
    print("PROBE|CONTROL={40 + 2}")
    var m = [[0, 0], [0, 0]]
    m[1][0] = 9
    print("PROBE|A2b m10={m[1][0]}")

main()
