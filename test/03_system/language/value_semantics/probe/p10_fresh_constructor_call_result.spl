# Cross-engine value-semantics probe P10: transfer a fresh constructor result
# through a call, then prove a later place-read binding still copies.
struct Flat:
    a: f64
    b: i64

fn relay(s: Flat) -> Flat:
    return s

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var got = relay(Flat(a: 11.0, b: 22))
    print("PROBE|S10 got.a={got.a} got.b={got.b}")
    var copy = got
    copy.a = 99.0
    print("PROBE|S10b got.a={got.a} copy.a={copy.a}")
    if got.a == 11.0 and got.b == 22 and copy.a == 99.0:
        print("PROBE|S10_VALUES=ok")
    else:
        print("PROBE|S10_VALUES=bad")

main()
