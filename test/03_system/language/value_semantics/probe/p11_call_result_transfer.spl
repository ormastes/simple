# Cross-engine value-semantics probe P11: transfer a fresh function result
# directly through another call, then verify subsequent copy isolation.
struct Flat:
    a: f64
    b: i64

fn make_flat() -> Flat:
    return Flat(a: 33.0, b: 44)

fn relay(s: Flat) -> Flat:
    return s

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var got = relay(make_flat())
    print("PROBE|S11 got.a={got.a} got.b={got.b}")
    var copy = got
    copy.b = 88
    print("PROBE|S11b got.b={got.b} copy.b={copy.b}")
    if got.a == 33.0 and got.b == 44 and copy.b == 88:
        print("PROBE|S11_VALUES=ok")
    else:
        print("PROBE|S11_VALUES=bad")

main()
