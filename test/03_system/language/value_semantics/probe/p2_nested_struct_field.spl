# Cross-engine value-semantics probe P2: nested struct field through a copy.
# KNOWN divergent even on a fresh post-F1 seed: AggregateCopy is SHALLOW, so
# copying the outer struct aliases the inner one (S2b position).
struct Flat:
    a: f64
    b: i64

struct Outer:
    inner: Flat

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var o = Outer(inner: Flat(a: 1.0, b: 2))
    o.inner.a = 99.0
    print("PROBE|S2 o.inner.a={o.inner.a}")
    var o2 = o
    o2.inner.a = 33.0
    print("PROBE|S2b o.inner.a={o.inner.a} o2.inner.a={o2.inner.a}")

main()
