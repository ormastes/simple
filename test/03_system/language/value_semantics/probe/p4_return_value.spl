# Cross-engine value-semantics probe P4: struct returned from a function,
# copied, then the copy mutated.
struct Flat:
    a: f64
    b: i64

fn make_flat() -> Flat:
    return Flat(a: 1.0, b: 2)

fn main():
    print("PROBE|CONTROL={40 + 2}")
    var r = make_flat()
    var r2 = r
    r2.a = 88.0
    print("PROBE|S4 r.a={r.a} r2.a={r2.a}")

main()
