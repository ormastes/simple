# Requirement: typed `if val` / `while val` on Option<T> binds the payload (val is T)
"""
# `if val v = opt` / `while val v = opt` bind the payload

Inside the body `v` has the payload type T, not Option<T>. Runtime scenarios
execute real code; the static scenario checks that the semantic checker agrees.

| Scenario | Status |
|----------|--------|
| if val binds i64 payload (Some) | passing |
| if val takes else on None | passing |
| if val binds text payload | passing |
| while val drains an Option source, v is i64 | in-development |
| while val skips body on immediate None | in-development |
| semantic checker has no diagnostics for `if val` over i64? | in-development |
"""
# @tag: system, language, policy, diag

use std.spec.*

fn bump(o: i64?) -> i64:
    if val v = o:
        v + 1
    else:
        -1

fn shout(o: text?) -> text:
    if val s = o:
        s + "!"
    else:
        "none"

describe "if val on Option<T>":
    it "binds the payload as T":
        expect(bump(Some(41))).to_equal(42)

    it "takes else for None":
        expect(bump(None)).to_equal(-1)

    it "binds a text payload usable as text":
        expect(shout(Some("hi"))).to_equal("hi!")
        expect(shout(None)).to_equal("none")
