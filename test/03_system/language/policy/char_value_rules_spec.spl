# Requirement: ADR-005 (char is a Unicode scalar value type; no implicit conversion to int)
# Scope: rules that hold today. Surrogate rejection is in char_value_rules_in_dev_spec.spl.
use std.spec.*

describe "char value rules":
    it "a digit char is not falsy":
        val c = "0"[0]
        var seen = false
        if c:
            seen = true
        expect(seen).to_be_true()
    it "a NUL char is not falsy":
        val c = "\u{0}"[0]
        var seen = false
        if c:
            seen = true
        expect(seen).to_be_true()
    it "a char is never equal to its code point":
        val c = "7"[0]
        expect(c == 55).to_be_false()
        expect(c == 7).to_be_false()
    it "explicit ord() is the only int view":
        val c = "7"[0]
        expect(c.ord()).to_equal(55)
    it "an astral char stays one scalar":
        val c = "\u{1F600}"[0]
        expect(c.ord()).to_equal(128512)
        expect(c.ord() > 0xFFFF).to_be_true()
