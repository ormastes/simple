# Requirement: Dict.get returns Option (Some/None)
# Engine-parity policy spec: Dict.get returns an Option matchable with case Some/None
# Mechanism: out-of-process probe under a NAMED engine (std.spec.engine_probe),
# scored by its PROBE| lines. Probe: test/03_system/language/policy/probe/dict_get_option_probe.spl
use std.spec.*
use std.spec.engine_probe.{engine_stdout}

val _PROBE = "test/03_system/language/policy/probe/dict_get_option_probe.spl"
val _INTERP = engine_stdout(_PROBE, "interpret")
val _JIT = engine_stdout(_PROBE, "jit")

describe "Dict.get returns an Option matchable with case Some/None (implemented)":
    it "interpreter lane reaches the probe":
        expect(_INTERP).to_contain("PROBE|CONTROL=42")
    it "JIT lane reaches the probe":
        expect(_JIT).to_contain("PROBE|CONTROL=42")
    it "interpreter: hit_is_some":
        expect(_INTERP).to_contain("PROBE|hit_is_some=ok")
    it "interpreter: stored_zero_is_some":
        expect(_INTERP).to_contain("PROBE|stored_zero_is_some=ok")
    it "interpreter: miss_is_none":
        expect(_INTERP).to_contain("PROBE|miss_is_none=ok")
    it "interpreter: inline_match_none":
        expect(_INTERP).to_contain("PROBE|inline_match_none=ok")
    it "interpreter: text_some":
        expect(_INTERP).to_contain("PROBE|text_some=ok")
    it "interpreter: text_none":
        expect(_INTERP).to_contain("PROBE|text_none=ok")
    it "interpreter: inline_match_some":
        expect(_INTERP).to_contain("PROBE|inline_match_some=ok")
    it "jit: hit_is_some":
        expect(_JIT).to_contain("PROBE|hit_is_some=ok")
    it "jit: stored_zero_is_some":
        expect(_JIT).to_contain("PROBE|stored_zero_is_some=ok")
    it "jit: miss_is_none":
        expect(_JIT).to_contain("PROBE|miss_is_none=ok")
    it "jit: inline_match_none":
        expect(_JIT).to_contain("PROBE|inline_match_none=ok")
    it "jit: text_some":
        expect(_JIT).to_contain("PROBE|text_some=ok")
    it "jit: text_none":
        expect(_JIT).to_contain("PROBE|text_none=ok")
