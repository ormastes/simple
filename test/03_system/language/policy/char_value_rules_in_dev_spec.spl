# @tag:in-development
# Requirement: ADR-005 section Decision.4 (char.from_code rejects non-scalar values)
# Expected to FAIL today: char.from_code does not exist yet.
use std.spec.*
use std.nogc_sync_mut.io_runtime.{env_get, process_run}

fn _lane(mode: text, probe: text) -> text:
    val runner = env_get("SIMPLE_BIN")
    val verb = if mode == "interpreter": "run " else: ""
    val (out, err, code) = process_run("sh", ["-c", "SIMPLE_EXECUTION_MODE={mode} '{runner}' {verb}'{probe}' 2>&1"])
    "{out}{err}\nexit={code}\n"

describe "char.from_code scalar validation (in development)":
    it "rejects a surrogate (0xD800) on the interpreter":
        val out = _lane("interpreter", "test/03_system/language/policy/probe/char_from_surrogate.spl")
        expect(out).to_contain("PROBE|CONTROL=42")
        expect(out.contains("PROBE|ACCEPTED=")).to_be_false()
        expect(out).to_contain("surrogate")
    it "rejects a surrogate (0xD800) on the JIT":
        val out = _lane("jit", "test/03_system/language/policy/probe/char_from_surrogate.spl")
        expect(out).to_contain("PROBE|CONTROL=42")
        expect(out.contains("PROBE|ACCEPTED=")).to_be_false()
        expect(out).to_contain("surrogate")
