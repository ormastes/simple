# @tag:in-development
# Tracks: src/compiler/35.semantics/match_exhaustiveness.spl (error only under critical today); query lint emits severity 2 for MEXH001
# Requirement: match exhaustiveness: error staged
"""
# Staged match-exhaustiveness error severity (staged, in-development)

Target behaviour not implemented yet: a default-profile missing-variant diagnostic is an error (LSP severity 1). Companion of match_exhaustive_spec.spl.
"""
# @tag: system, language, policy, diag

use std.spec.*
use app.cli.query_lint_checks.{_check_match_exhaustiveness_text}
use app.cli.query_rich_common.{_DIAG_COLLECT_MODE, _DIAG_COLLECTED}

fn mexh(lines: [text]) -> [text]:
    _DIAG_COLLECT_MODE = true
    _DIAG_COLLECTED = []
    val count = _check_match_exhaustiveness_text(lines, "policy.spl", "json")
    val result = _DIAG_COLLECTED
    _DIAG_COLLECTED = []
    _DIAG_COLLECT_MODE = false
    result

val enum_lines = ["enum Color:", "    Red", "    Green", "    Blue", ""]

fn missing_blue() -> [text]:
    mexh(enum_lines + ["fn f(c: Color) -> i64:", "    match c:", "        case Red: 1", "        case Green: 2"])

describe "staged error severity":
    it "makes the default-profile missing-variant diagnostic an error (severity 1)":
        val ds = missing_blue()
        expect(ds.len()).to_equal(1)
        expect(ds[0]).to_contain("\"severity\":1")
