# @tag:in-development
# Tracks: interpreter: `while val v = cur` over a var Option fails "cannot convert enum to int"; semantic checker raises E-TYPE-NIL-COMPARE on `if val v = o` for o: i64?
# Requirement: typed if val / while val bind the payload
"""
# Staged while-val binding and checker agreement (staged, in-development)

Target behaviour not implemented yet in the seed interpreter / semantic checker. Companion of option_if_while_bind_spec.spl.
"""
# @tag: system, language, policy, diag

use std.spec.*
use compiler.tools.lint.semantic_check.{simple_semantic_check_source}

fn next_item(xs: [i64], i: i64) -> i64?:
    if i < xs.len():
        Some(xs[i])
    else:
        None

fn sum_all(xs: [i64]) -> i64:
    var total = 0
    var i = 0
    var cur = next_item(xs, i)
    while val v = cur:
        total = total + v
        i = i + 1
        cur = next_item(xs, i)
    total

describe "while val on Option<T>":
    it "iterates while Some and binds the payload":
        expect(sum_all([1, 2, 3, 4])).to_equal(10)

    it "does not enter the body for an immediately-None source":
        val empty: [i64] = []
        expect(sum_all(empty)).to_equal(0)

describe "static view of if val":
    it "gives the semantic checker no diagnostics for if val over i64?":
        val src = "fn f(o: i64?) -> i64:\n    if val v = o:\n        v + 1\n    else:\n        0\n"
        val ds = simple_semantic_check_source(src, "policy.spl").diagnostics
        expect(ds.len()).to_equal(0)
