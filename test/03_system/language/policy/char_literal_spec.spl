# Requirement: ADR-005 section Decision.2 (char literals) + doc/07_guide/quick_reference/syntax_quick_reference.md (strings)
# Scope: literal forms that behave as documented today. Escape handling in
# single-quoted literals and literal diagnostics are in char_literal_in_dev_spec.spl.
use std.spec.*
use std.nogc_sync_mut.io_runtime.{env_get, process_run}

fn _lane(mode: text, probe: text) -> text:
    val runner = env_get("SIMPLE_BIN")
    val verb = if mode == "interpreter": "run " else: ""
    val (out, err, code) = process_run("sh", ["-c", "SIMPLE_EXECUTION_MODE={mode} '{runner}' {verb}'{probe}' 2>&1"])
    "{out}{err}\nexit={code}\n"

describe "literal forms":
    it "single-scalar 'x' has code point of x":
        val c = 'x'
        expect(c.ord()).to_equal(120)
    it "raw string r-prefix keeps backslashes verbatim":
        val r = r"a\nb"
        expect(r.len()).to_equal(4)
    it "string interpolation evaluates expressions":
        val k = 5
        expect("v={k + 1}").to_equal("v=6")
    it "triple-quoted string keeps the newline":
        val t = """x
y"""
        expect(t.len()).to_equal(3)
    it "string escape u-brace is one code point":
        val s = "\u{e9}\u{1F600}"
        expect(s.char_count()).to_equal(2)
        expect(s[0].ord()).to_equal(233)
    it "literal forms agree on interpreter and JIT":
        val probe = "test/03_system/language/policy/probe/char_lit_basic.spl"
        val i = _lane("interpreter", probe)
        val j = _lane("jit", probe)
        expect(i).to_contain("PROBE|LIT=120 RAW=4 TRI=3 INTERP=6")
        expect(j).to_contain("PROBE|LIT=120 RAW=4 TRI=3 INTERP=6")
