# Requirement: u64 fields hold unsigned values
# Engine-parity policy spec: declared u64 fields hold unsigned values
# Mechanism: out-of-process probe under a NAMED engine (std.spec.engine_probe),
# scored by its PROBE| lines. Probe: test/03_system/language/policy/probe/u64_field_probe.spl
use std.spec.*
use std.spec.engine_probe.{engine_stdout}

val _PROBE = "test/03_system/language/policy/probe/u64_field_probe.spl"
val _INTERP = engine_stdout(_PROBE, "interpret")
val _JIT = engine_stdout(_PROBE, "jit")

describe "declared u64 fields hold unsigned values (implemented)":
    it "interpreter lane reaches the probe":
        expect(_INTERP).to_contain("PROBE|CONTROL=42")
    it "JIT lane reaches the probe":
        expect(_JIT).to_contain("PROBE|CONTROL=42")
    it "interpreter: small_value_unchanged":
        expect(_INTERP).to_contain("PROBE|small_value_unchanged=ok")
    it "jit: small_value_unchanged":
        expect(_JIT).to_contain("PROBE|small_value_unchanged=ok")
    it "jit: class_store_high_bit_nonneg":
        expect(_JIT).to_contain("PROBE|class_store_high_bit_nonneg=ok")
    it "jit: class_store_minus1_nonneg":
        expect(_JIT).to_contain("PROBE|class_store_minus1_nonneg=ok")
    it "jit: struct_store_minus1_nonneg":
        expect(_JIT).to_contain("PROBE|struct_store_minus1_nonneg=ok")
    it "jit: ctor_minus1_nonneg":
        expect(_JIT).to_contain("PROBE|ctor_minus1_nonneg=ok")
    it "jit: field_equals_typed_local":
        expect(_JIT).to_contain("PROBE|field_equals_typed_local=ok")
