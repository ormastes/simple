# Probe: declared u64 fields hold unsigned values.
class Hdr:
    magic: u64
    size: u64

struct Trailer:
    tag: u64

fn report(name: text, ok: bool):
    if ok:
        print("PROBE|{name}=ok")
    else:
        print("PROBE|{name}=bad")

fn main() -> void:
    print("PROBE|CONTROL=42")
    val hi: i64 = (1 as i64) << 63
    val h = Hdr(magic: 0, size: 0)
    h.magic = hi | 0xDEADBEEF
    report("class_store_high_bit_nonneg", h.magic >= 0)
    h.size = -1
    report("class_store_minus1_nonneg", h.size >= 0)
    var t = Trailer(tag: 0)
    t.tag = -1
    report("struct_store_minus1_nonneg", t.tag >= 0)
    val c = Hdr(magic: -1, size: 5)
    report("ctor_minus1_nonneg", c.magic >= 0)
    report("small_value_unchanged", c.size == 5)
    var acc: u64 = 0
    acc = acc | hi
    acc = acc | 0xDEADBEEF
    report("field_equals_typed_local", h.magic == acc)
