# Probe: Dict.get returns an Option matchable with Some/None.
fn report(name: text, ok: bool):
    if ok:
        print("PROBE|{name}=ok")
    else:
        print("PROBE|{name}=bad")

fn some_value(d: Dict<text, i64>, k: text) -> i64:
    match d.get(k):
        case Some(v): v
        case None: -1

fn main() -> void:
    print("PROBE|CONTROL=42")
    var d: Dict<text, i64> = {}
    d["a"] = 7
    d["zero"] = 0
    report("hit_is_some", some_value(d, "a") == 7)
    report("stored_zero_is_some", some_value(d, "zero") == 0)
    report("miss_is_none", some_value(d, "zz") == -1)
    var hit_branch = false
    match d.get("a"):
        case Some(v):
            hit_branch = v == 7
        case None:
            hit_branch = false
    report("inline_match_some", hit_branch)
    var miss_branch = false
    match d.get("zz"):
        case Some(v):
            miss_branch = false
        case None:
            miss_branch = true
    report("inline_match_none", miss_branch)
    var t: Dict<text, text> = {}
    t["k"] = "yes"
    var tt = false
    match t.get("k"):
        case Some(v):
            tt = v == "yes"
        case None:
            tt = false
    report("text_some", tt)
    var tm = false
    match t.get("zz"):
        case Some(v):
            tm = false
        case None:
            tm = true
    report("text_none", tm)
