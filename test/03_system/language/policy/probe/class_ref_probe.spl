# Probe: class values are shared references (list, dict, field, param).
# Run under a named engine; the spec scores the `PROBE|` lines.
class Cell:
    n: i64

class Holder:
    cell: Cell

fn bump(c: Cell):
    c.n = c.n + 1

fn report(name: text, got: i64, want: i64):
    if got == want:
        print("PROBE|{name}=ok")
    else:
        print("PROBE|{name}=bad got={got} want={want}")

fn main() -> void:
    print("PROBE|CONTROL=42")
    # param
    val p = Cell(n: 1)
    bump(p)
    report("param", p.n, 2)
    # field: mutation through the original is visible through the holder
    val c1 = Cell(n: 10)
    val h1 = Holder(cell: c1)
    c1.n = 11
    report("field_orig_to_holder", h1.cell.n, 11)
    # field: mutation through the holder is visible through the original
    val c2 = Cell(n: 20)
    val h2 = Holder(cell: c2)
    h2.cell.n = 21
    report("field_holder_to_orig", c2.n, 21)
    # list
    val c3 = Cell(n: 40)
    val xs = [c3]
    xs[0].n = 41
    report("list_elem_to_orig", c3.n, 41)
    c3.n = 42
    report("list_orig_to_elem", xs[0].n, 42)
    # dict
    val c4 = Cell(n: 60)
    var d: Dict<text, Cell> = {}
    d["k"] = c4
    c4.n = 61
    report("dict_orig_to_value", d["k"].n, 61)
    # field re-assign
    val h5 = Holder(cell: Cell(n: 70))
    val c5 = Cell(n: 80)
    h5.cell = c5
    c5.n = 81
    report("field_reassign", h5.cell.n, 81)
    # plain alias
    val c6 = Cell(n: 90)
    val a6 = c6
    a6.n = 91
    report("alias", c6.n, 91)
