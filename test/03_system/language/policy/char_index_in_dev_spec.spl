# @tag:in-development
# Requirement: ADR-005 (s[i] returns char) -- staged items not yet implemented
# ADR: doc/04_architecture/adr/ADR-005-text-index-yields-char.md (Staging)
# Every scenario asserts the TARGET behaviour and is expected to FAIL today.
use std.spec.*
use std.nogc_sync_mut.io_runtime.{env_get, process_run}

fn _lane(mode: text, probe: text) -> text:
    val runner = env_get("SIMPLE_BIN")
    val verb = if mode == "interpreter": "run " else: ""
    val (out, err, code) = process_run("sh", ["-c", "SIMPLE_EXECUTION_MODE={mode} '{runner}' {verb}'{probe}' 2>&1"])
    "{out}{err}\nexit={code}\n"

describe "ADR-005 staged char behaviour (in development)":
    it "to_digit() returns Some(digit) for a digit char":
        val s = "7a"
        val d = s[0].to_digit()
        expect(d.unwrap()).to_equal(7)
    it "to_digit() returns None for a non-digit char":
        val s = "7a"
        expect(s[1].to_digit().is_none()).to_be_true()
    it "char.from_code(n) round-trips ord() on both lanes":
        val probe = "test/03_system/language/policy/probe/char_from_valid.spl"
        expect(_lane("interpreter", probe)).to_contain("PROBE|FC=65 233 128512")
        expect(_lane("jit", probe)).to_contain("PROBE|FC=65 233 128512")
    it "out-of-range index is index out of bounds on the JIT (today it yields empty text)":
        val j = _lane("jit", "test/03_system/language/policy/probe/char_oob.spl")
        expect(j).to_contain("index out of bounds")
        expect(j.contains("PROBE|OOB=")).to_be_false()
    it "byte_len() counts UTF-8 bytes":
        expect("a\u{e9}\u{20ac}\u{1F600}".byte_len()).to_equal(10)
    it "len() counts code points":
        expect("a\u{e9}\u{20ac}\u{1F600}".len()).to_equal(4)
    it "comparing an indexed char with text is a compile error":
        val probe = "test/03_system/language/policy/probe/char_eq_text.spl"
        val out = _lane("interpreter", probe)
        expect(out.contains("PROBE|EQ=")).to_be_false()
