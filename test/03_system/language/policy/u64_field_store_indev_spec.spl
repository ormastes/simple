# @tag:in-development
# Requirement: u64 fields hold unsigned values
# Engine-parity policy spec: declared u64 fields hold unsigned values
# Mechanism: out-of-process probe under a NAMED engine (std.spec.engine_probe),
# scored by its PROBE| lines. Probe: test/03_system/language/policy/probe/u64_field_probe.spl
use std.spec.*
use std.spec.engine_probe.{engine_stdout}

val _PROBE = "test/03_system/language/policy/probe/u64_field_probe.spl"
val _INTERP = engine_stdout(_PROBE, "interpret")
val _JIT = engine_stdout(_PROBE, "jit")

describe "declared u64 fields hold unsigned values (in development: expected to FAIL until fixed)":
    it "interpreter: class_store_high_bit_nonneg":
        expect(_INTERP).to_contain("PROBE|class_store_high_bit_nonneg=ok")
    it "interpreter: class_store_minus1_nonneg":
        expect(_INTERP).to_contain("PROBE|class_store_minus1_nonneg=ok")
    it "interpreter: struct_store_minus1_nonneg":
        expect(_INTERP).to_contain("PROBE|struct_store_minus1_nonneg=ok")
    it "interpreter: ctor_minus1_nonneg":
        expect(_INTERP).to_contain("PROBE|ctor_minus1_nonneg=ok")
    it "interpreter: field_equals_typed_local":
        expect(_INTERP).to_contain("PROBE|field_equals_typed_local=ok")
    it "interpreter and JIT print identical PROBE lines":
        expect(_INTERP.split("\n").filter(\l: l.starts_with("PROBE|"))).to_equal(_JIT.split("\n").filter(\l: l.starts_with("PROBE|")))
