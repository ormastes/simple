# @tag:in-development
# Tracks: src/compiler/30.types/type_infer/inference_expr.spl (E-TYPE-NIL-COMPARE covers `nil`, not `None`) and the semantic checker lacking NIL-UNSAFE-001
# Requirement: nil only in unsafe; case None on Option
"""
# Staged nil diagnostics (staged, in-development)

Target behaviour not implemented yet: `case None` on i64 gets a named code, `case None` on a genuine Option is accepted, and the semantic checker (not only the lint) reports `nil` outside unsafe. Companion of nil_unsafe_only_spec.spl.
"""
# @tag: system, language, policy, diag

use std.spec.*
use compiler.tools.lint.semantic_check.{simple_semantic_check_source}

fn check_diags(src: text) -> [text]:
    simple_semantic_check_source(src, "policy.spl").diagnostics

describe "staged nil diagnostics":
    it "accepts case None over a genuine Option":
        val ds = check_diags("fn f(o: i64?) -> i64:\n    match o:\n        case None: 1\n        case _: 0\n")
        expect(ds.len()).to_equal(0)

    it "gives case None on i64 a named E-TYPE-* code, not a raw type mismatch":
        val ds = check_diags("fn f(n: i64) -> i64:\n    match n:\n        case None: 1\n        case _: 0\n")
        expect(ds.len()).to_equal(1)
        expect(ds[0]).to_contain("E-TYPE-")

    it "reports nil outside unsafe from the semantic checker, not only the lint":
        val ds = check_diags("fn f() -> i64?:\n    val x: i64? = nil\n    x\n")
        expect(ds.len()).to_equal(1)
        expect(ds[0]).to_contain("nil")
