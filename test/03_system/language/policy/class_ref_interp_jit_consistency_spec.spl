# Requirement: ADR-004 (class values are shared references)
# Engine-parity policy spec: class values are shared references in list, dict, field and param
# Mechanism: out-of-process probe under a NAMED engine (std.spec.engine_probe),
# scored by its PROBE| lines. Probe: test/03_system/language/policy/probe/class_ref_probe.spl
use std.spec.*
use std.spec.engine_probe.{engine_stdout}

val _PROBE = "test/03_system/language/policy/probe/class_ref_probe.spl"
val _INTERP = engine_stdout(_PROBE, "interpret")
val _JIT = engine_stdout(_PROBE, "jit")

describe "class values are shared references in list, dict, field and param (implemented)":
    it "interpreter lane reaches the probe":
        expect(_INTERP).to_contain("PROBE|CONTROL=42")
    it "JIT lane reaches the probe":
        expect(_JIT).to_contain("PROBE|CONTROL=42")
    it "interpreter: param":
        expect(_INTERP).to_contain("PROBE|param=ok")
    it "jit: param":
        expect(_JIT).to_contain("PROBE|param=ok")
    it "jit: field_orig_to_holder":
        expect(_JIT).to_contain("PROBE|field_orig_to_holder=ok")
    it "jit: field_holder_to_orig":
        expect(_JIT).to_contain("PROBE|field_holder_to_orig=ok")
    it "jit: list_elem_to_orig":
        expect(_JIT).to_contain("PROBE|list_elem_to_orig=ok")
    it "jit: list_orig_to_elem":
        expect(_JIT).to_contain("PROBE|list_orig_to_elem=ok")
    it "jit: dict_orig_to_value":
        expect(_JIT).to_contain("PROBE|dict_orig_to_value=ok")
    it "jit: field_reassign":
        expect(_JIT).to_contain("PROBE|field_reassign=ok")
    it "jit: alias":
        expect(_JIT).to_contain("PROBE|alias=ok")
