# @tag:in-development
# Requirement: ADR-004 (class values are shared references)
# Engine-parity policy spec: class values are shared references in list, dict, field and param
# Mechanism: out-of-process probe under a NAMED engine (std.spec.engine_probe),
# scored by its PROBE| lines. Probe: test/03_system/language/policy/probe/class_ref_probe.spl
use std.spec.*
use std.spec.engine_probe.{engine_stdout}

val _PROBE = "test/03_system/language/policy/probe/class_ref_probe.spl"
val _INTERP = engine_stdout(_PROBE, "interpret")
val _JIT = engine_stdout(_PROBE, "jit")

describe "class values are shared references in list, dict, field and param (in development: expected to FAIL until fixed)":
    it "interpreter: field_orig_to_holder":
        expect(_INTERP).to_contain("PROBE|field_orig_to_holder=ok")
    it "interpreter: field_holder_to_orig":
        expect(_INTERP).to_contain("PROBE|field_holder_to_orig=ok")
    it "interpreter: list_elem_to_orig":
        expect(_INTERP).to_contain("PROBE|list_elem_to_orig=ok")
    it "interpreter: list_orig_to_elem":
        expect(_INTERP).to_contain("PROBE|list_orig_to_elem=ok")
    it "interpreter: dict_orig_to_value":
        expect(_INTERP).to_contain("PROBE|dict_orig_to_value=ok")
    it "interpreter: field_reassign":
        expect(_INTERP).to_contain("PROBE|field_reassign=ok")
    it "interpreter: alias":
        expect(_INTERP).to_contain("PROBE|alias=ok")
    it "interpreter and JIT print identical PROBE lines":
        expect(_INTERP.split("\n").filter(\l: l.starts_with("PROBE|"))).to_equal(_JIT.split("\n").filter(\l: l.starts_with("PROBE|")))
