# @tag: system, runtime, gpu, dynamic-load, vulkan, cuda, metal
# @evidence-display: embed_tui
"""## Purpose and audience
Proves that the host admits, dispatches through, unloads, and replaces
dynamically loaded GPU providers without a rebuild. Audience: engineers
changing the provider ABI registry or the dynload check scripts.
## Operator workflow
Run the spec from the repository root with the bootstrap binary; on Linux the
two provider fixtures also execute their `scripts/check/` checkers.
## Compatibility and limitations
The Vulkan/CUDA and Metal fixtures compile ELF shared providers with cc, so
non-Linux hosts execute only the fail-closed admission contract plus the host
gate assertion; no native macOS device execution is claimed.
## Verification guidance and troubleshooting
A failure names the contract line missing from the checker output. Rerun the
cited `scripts/check/check-*-provider-dynload-registry.shs` directly and
compare its stdout markers against the asserted values below.
"""
# Lifecycle: doc/01_research/domain/gpu_dynamic_backend_full_offload.md ;
# doc/03_plan/agent_tasks/gpu_dynamic_backend_full_offload.md ;
# doc/04_architecture/gpu_dynamic_backend_full_offload.md ;
# doc/05_design/gpu_dynamic_backend_full_offload.md

use std.io_runtime.{file_read, process_run}
use std.nogc_sync_mut.env.platform.{is_linux}
use std.spec.*

val GPU_PROVIDER_CHECK = "scripts/check/check-gpu-provider-dynload-registry.shs"
val METAL_PROVIDER_CHECK = "scripts/check/check-metal-provider-dynload-registry.shs"

fn run_checker(path: text) -> (text, text, i64):
    process_run("/bin/sh", [path])

# @manual_section: dynamic gpu providers
describe "dynamic GPU providers without rebuilding the Simple host":
    """Operators use these scenarios to verify that the host admits only a
    complete ABI-compatible provider, dispatches work through its local handle,
    and can load a replacement provider without relinking the host binary.

    The Metal scenario is host-independent: its fixture verifies byte and
    RuntimeValue adaptation without claiming native macOS device execution.
    """

    it "should expose one fail-closed provider admission contract":
        # @req REQ-GPU-DYNLOAD-001
        # @capture(protocol_json): admission contract markers retained from the checker source
        step("Inspect the dynamic provider admission checker")
        val source = file_read(GPU_PROVIDER_CHECK)

        step("Verify ABI capability and operation validation happen before use")
        expect(source).to_contain("rt_simple_gpu_provider_abi_version")
        expect(source).to_contain("rt_simple_gpu_provider_backend_bits")
        expect(source).to_contain("gpu_provider_incomplete_surface_rejected=true")
        expect(source).to_contain("cuda_provider_missing_operation_fails_closed=true")

        step("Verify replacement is exercised without rebuilding the harness")
        expect(source).to_contain("rt_gpu_provider_unload")
        expect(source).to_contain("gpu_provider_replacement_without_host_rebuild=true")

    it "should load reject dispatch unload and replace Vulkan and CUDA providers":
        # @req REQ-GPU-DYNLOAD-002
        # @capture(statistics): checker exit code and stdout contract markers
        if not is_linux():
            # NOTE: the focused fixture compiles ELF shared providers with cc
            # and runs only on Linux hosts; other hosts assert the gate itself.
            step("Assert the ELF-only host gate on this platform")
            expect(is_linux()).to_equal(false)  # oracle: this branch executes only where the ELF fixture cannot run
        else:
            step("Build two compatible providers and invalid adjacent fixtures")
            val (stdout, stderr, code) = run_checker(GPU_PROVIDER_CHECK)

            step("Require successful operation dispatch and fail-closed rejection")
            expect(code).to_equal(0)  # oracle: the checker exits 0 only when every provider scenario holds
            expect(stderr).to_equal("")
            expect(stdout).to_contain("gpu_provider_dynamic_load=true")
            expect(stdout).to_contain("cuda_provider_operation_dispatch=true")
            expect(stdout).to_contain("gpu_provider_wrong_abi_rejected=true")
            expect(stdout).to_contain("gpu_provider_incomplete_surface_rejected=true")

            step("Require unload and replacement through the unchanged host")
            expect(stdout).to_contain("gpu_provider_unload_reload=true")
            expect(stdout).to_contain("gpu_provider_replacement_without_host_rebuild=true")
            expect(stdout).to_contain("gpu_provider_concurrent_registry_access=true")
            expect(stdout).to_contain("gpu_provider_static_dependency=false")

    it "should preserve zero bytes across the Metal provider boundary":
        # @req REQ-GPU-DYNLOAD-003
        # @capture(statistics): Metal checker exit code and stdout contract markers
        if not is_linux():
            # NOTE: the host-independent Metal provider fixture uses ELF shared
            # libraries; other hosts assert the gate itself.
            step("Assert the ELF-only host gate on this platform")
            expect(is_linux()).to_equal(false)  # oracle: this branch executes only where the ELF fixture cannot run
        else:
            step("Build the complete wrong-ABI and incomplete Metal providers")
            val (stdout, stderr, code) = run_checker(METAL_PROVIDER_CHECK)

            step("Require core-owned RuntimeValue and length-delimited byte adaptation")
            expect(code).to_equal(0)  # oracle: the checker exits 0 only when every Metal scenario holds
            expect(stderr).to_equal("")
            expect(stdout).to_contain("metal_provider_runtime_values_decoded_by_core=true")
            expect(stdout).to_contain("metal_provider_raw_bytes_length_delimited=true")

            step("Require invalid Metal providers to remain unavailable")
            expect(stdout).to_contain("metal_provider_wrong_abi_rejected=true")
            expect(stdout).to_contain("metal_provider_incomplete_surface_rejected=true")
            expect(stdout).to_contain("metal_provider_static_dependency=false")
