# System spec: a native build that calls `rt_win_compare_object_handles`
# links against the C runtime and answers object identity sensibly.
#
# Needs SIMPLE_BINARY = a compiler that can `native-build`. Windows only:
# the probe compares Win32 pseudo-handles.

use std.spec.*
use std.io_runtime.{process_run_timeout, env_get, file_exists, file_delete, mkdir_p}

val CMP_FIXTURE = "test/fixtures/win_compare_object_handles/main.spl"
val CMP_BINARY = "build/win_compare_object_handles_native_spec.exe"

describe "native rt_win_compare_object_handles":
    """
    As a service author checking that two handles name the same kernel
    object, I want a native build to link the comparison and answer it the
    same way the interpreter does.
    """
    it "links and reports same-object handles as equal and others as different":
        val compiler = env_get("SIMPLE_BINARY") ?? ""
        expect(compiler.len() > 0).to_be(true)
        expect(mkdir_p("build")).to_be(true)
        if file_exists(CMP_BINARY):
            expect(file_delete(CMP_BINARY)).to_be(true)
        val (build_out, build_err, build_code) = process_run_timeout(compiler, [
            "native-build", CMP_FIXTURE, "-o", CMP_BINARY
        ], 1200000)
        expect(build_out + build_err).to_not_contain("have no implementation")
        expect(build_code).to_equal(0)
        val (run_out, _run_err, run_code) = process_run_timeout(CMP_BINARY, [], 60000)
        expect(run_code).to_equal(0)
        expect(run_out).to_contain("same -> true")
        expect(run_out).to_contain("different -> false")
