# codex-system-test
# E5-002 acceptance: GPU-local task lifecycle. Routing, enumeration, compiled
# device artifacts, and CPU/model fixtures never satisfy this physical class.
# @evidence-class physical_worker

use std.spec.{describe, it, step, fail}

fn admit_exact_provider():
    fail("MissingEvidence:E5-002:authenticated provider/image/device receipt; evidence-class=physical_worker")

fn pin_selected_generation():
    fail("MissingEvidence:E5-002:GPU generation/resource lease receipt; resume after E4 owner admission")

fn execute_bounded_region():
    fail("MissingEvidence:E5-002:actual device submission/readback; routing is not execution")

fn validate_completion_receipt():
    fail("MissingEvidence:E5-002:owner-issued fence/completion/readback receipt")

fn drain_and_retire():
    fail("MissingEvidence:E5-002:terminal fence and exactly-once retirement receipt")

describe "E5-002 GPU task infrastructure [importance=critical; importance_weight=3]":
    it "E5-002 should submit and retire one admitted bounded GPU task [importance=critical; importance_weight=3]":
        # @req REQ-011
        # @req REQ-012
        step("Admit the provider and pin its resource generation")
        admit_exact_provider()
        pin_selected_generation()
        execute_bounded_region()
        validate_completion_receipt()
        drain_and_retire()

    it "E5-002 should preserve resources through cancellation and device failure [importance=critical; importance_weight=3]":
        # @req REQ-011
        # @req REQ-012
        step("Cancel submitted work and wait for terminal fence retirement")
        admit_exact_provider()
        pin_selected_generation()
        fail("MissingEvidence:E5-002:cancellation/device-loss owner receipt; no CPU replay or double commit is admissible")
        drain_and_retire()

    it "E5-002 should keep parser GPU claims unavailable without a real device receipt [importance=high; importance_weight=2]":
        # @req REQ-011
        # @req REQ-013
        step("Attempt parser-GPU admission with no authenticated device evidence")
        fail("MissingEvidence:E5-002:GPU device/provider/fence/readback authority; parser GPU remains unavailable")
