# @req REQ-008 REQ-009 REQ-010 REQ-014
# @manual: supporting
"""Real external RT/HAL comparator build and exact scalar protocol contract."""
use std.spec.*
use std.spec.step
use std.common.env_access.model.*
use test.fixtures.rt_hal_external.fixture_plan.{
    RtHalExternalFixtureConfig, rt_hal_external_build_plan,
    rt_hal_external_provider_plan
}

val PIN_A = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
val PIN_B = "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"

fn fixture_config() -> RtHalExternalFixtureConfig:
    RtHalExternalFixtureConfig(
        repo: "/workspace/simple", cc: "/opt/toolchain/bin/cc",
        cc_hash: PIN_A, rustc: "/opt/toolchain/bin/rustc",
        rustc_hash: PIN_B,
        c_output: "/workspace/simple/build/rt-hal/rthal-c-v1",
        rust_output: "/workspace/simple/build/rt-hal/rthal-rust-v1"
    )

describe "external RT HAL scalar providers":
    it "should compile C and Rust fixtures only through pinned typed tools":
        step("admit pinned external provider toolchains")
        val plan = rt_hal_external_build_plan(fixture_config())
        expect(env_access_plan_error(plan)).to_equal("")
        expect(plan.instructions.len()).to_equal(2)
        expect(plan.allowed_tools.len()).to_equal(2)
        expect(plan.instructions[0].kind).to_equal(EnvAccessKind.RunAllowedTool)
        expect(plan.instructions[0].arguments[5]).to_equal("-static")
        expect(plan.instructions[0].arguments[6]).to_equal("-no-pie")
        expect(plan.instructions[1].arguments[6]).to_equal("target-feature=+crt-static")
        expect(plan.instructions[1].arguments[8]).to_equal("relocation-model=static")
        expect(plan.instructions[1].arguments[10]).to_equal("link-arg=-static")
        expect(plan.instructions[1].arguments[12]).to_equal("link-arg=-no-pie")
        expect(plan.allowed_tools[0].identity_hash).to_equal("sha256:" + PIN_A)
        expect(plan.allowed_tools[1].identity_hash).to_equal("sha256:" + PIN_B)

    it "should pin built provider identities before exact comparison":
        step("admit exact external provider executables")
        val plan = rt_hal_external_provider_plan(fixture_config(), PIN_A, PIN_B)
        expect(env_access_plan_error(plan)).to_equal("")
        expect(plan.instructions.len()).to_equal(0)
        expect(plan.max_processes).to_equal(2)
        expect(plan.max_total_bytes).to_equal(4096)
        expect(plan.allowed_tools[0].tool_id).to_equal("rthal-c-v1")
        expect(plan.allowed_tools[1].tool_id).to_equal("rthal-rust-v1")
        expect(plan.allowed_tools[0].identity_hash).to_equal("sha256:" + PIN_A)
