# @tag:in-development
# @tag:system,item5,not-implemented
# @status: NOT_IMPLEMENTED
# Intentional failing skeleton; no implementation or executed evidence is claimed.
use std.spec.*

describe "item 5 size and startup pending acceptance":
    it "should keep unstripped NoGC hello strictly below two MiB [I5-P06-AC01]":
        # @req NFR-001
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare the same allocation-free NoGC hello for every supported native target using a same-host admitted toolchain and preserve the unstripped artifact.")
        step("Act (planned): Measure its exact on-disk byte size and bind the measurement to target, source and binary identities.")
        step("Check (planned): Each unstripped executable is strictly below 2 MiB (2,097,152 bytes); a result equal to the threshold fails and no supported target is silently excluded.")
        fail("NOT_IMPLEMENTED I5-P06-AC01: keep unstripped NoGC hello strictly below two MiB")

    it "should meet the Linux ELF absolute release-small size limit [I5-P06-AC02]":
        # @req NFR-002
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare a Linux ELF release-small NoGC hello that prints the required bytes through the Simple print path, using the admitted strip policy.")
        step("Act (planned): Build and measure the stripped artifact with its map, section and identity evidence retained.")
        step("Check (planned): The executable is at most 15 KiB (15,360 bytes); the absolute limit is enforced independently of the matched-C ratio.")
        fail("NOT_IMPLEMENTED I5-P06-AC02: meet the Linux ELF absolute release-small size limit")

    it "should meet the matched C size ratio with identical runtime conditions [I5-P06-AC03]":
        # @req NFR-002
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare Simple and C hello on the same host and toolchain, sharing startup wrapper, required core runtime archive, linker options, section GC and strip policy; C uses puts and emits the same bytes.")
        step("Act (planned): Build both artifacts, compare output checksums and measure their byte sizes.")
        step("Check (planned): Simple is no larger than 1.05 times matched C, with no rounding that admits an over-limit result; mismatched inputs invalidate comparison, and bare C main is advisory only.")
        fail("NOT_IMPLEMENTED I5-P06-AC03: meet the matched C size ratio with identical runtime conditions")

    it "should bound non-ELF size using an admitted format allowance [I5-P06-AC04]":
        # @req NFR-003
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare matched same-host C and Simple release-small NoGC hello for each supported non-ELF target and obtain its admitted fixed format allowance in bytes.")
        step("Act (planned): Measure both artifacts and attribute every byte of the fixed allowance to format overhead.")
        step("Check (planned): Simple size is no greater than C size plus that target's admitted allowance; missing or unadmitted allowances reject the gate, and runtime features cannot be hidden inside the allowance.")
        fail("NOT_IMPLEMENTED I5-P06-AC04: bound non-ELF size using an admitted format allowance")

    it "should bound warm interpreter startup against same-host Python [I5-P06-AC05]":
        # @req NFR-004 NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare minimal interpreter hello and an admitted same-host Python hello with equivalent output, declared warm-cache conditions and a fixed measurement protocol.")
        step("Act (planned): Collect the required cohort of warm startup samples and compute p50 and p95 under the admitted comparison statistic.")
        step("Check (planned): The protocol's startup statistic is at most 1.10 times its matched Python baseline, with parity or better as the target; p50 and p95 and output checksums are reported, and the statistic is not chosen after observing results.")
        fail("NOT_IMPLEMENTED I5-P06-AC05: bound warm interpreter startup against same-host Python")

    it "should bound interpreter maximum RSS against same-host Python [I5-P06-AC06]":
        # @req NFR-004 NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Use the same hello fixtures, admitted Python baseline, host and declared process-tree RSS accounting used by the warm-startup cohort.")
        step("Act (planned): Measure maximum RSS for each run and apply the declared baseline comparison while retaining the individual samples.")
        step("Check (planned): Maximum RSS under the admitted comparison protocol is at most 1.10 times matched Python; aggregation, units and child-process scope match, with p50 and p95 reported and no omitted high-memory samples.")
        fail("NOT_IMPLEMENTED I5-P06-AC06: bound interpreter maximum RSS against same-host Python")

    it "should require at least thirty development samples [I5-P06-AC07]":
        # @req NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare a development measurement cohort with fixed host, toolchain, source, binary hashes, output checksums and sampling protocol.")
        step("Act (planned): Collect size/startup/RSS evidence for at least 30 valid runs and submit the cohort to the gate.")
        step("Check (planned): Fewer than 30 samples cannot qualify; the gate retains all sample identities and reports p50, p95 and RSS alongside hashes, toolchain identities and checksums.")
        fail("NOT_IMPLEMENTED I5-P06-AC07: require at least thirty development samples")

    it "should require at least one hundred release samples [I5-P06-AC08]":
        # @req NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare a release measurement cohort for the exact immutable candidate and matched baseline with the declared same-host protocol.")
        step("Act (planned): Collect at least 100 valid samples and submit the release evidence.")
        step("Check (planned): Fewer than 100 samples cannot qualify for release; development evidence is not relabeled, and p50, p95, RSS, binary hashes, toolchain identities and checksums remain traceable to the release candidate.")
        fail("NOT_IMPLEMENTED I5-P06-AC08: require at least one hundred release samples")

    it "should retain complete linker and measurement artifacts [I5-P06-AC09]":
        # @req REQ-014 NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare one native build with a unique candidate identity and an evidence directory intended to survive stripping and packaging.")
        step("Act (planned): Link, strip and collect the candidate's map, removed-section log, section sizes, symbol-size ranking, dynamic dependency list and both binary hashes.")
        step("Check (planned): All six required evidence categories are retained, refer to the exact unstripped/stripped pair, and remain connected to the measurement cohort; missing or inconsistent evidence rejects qualification.")
        fail("NOT_IMPLEMENTED I5-P06-AC09: retain complete linker and measurement artifacts")

    it "should reject incomparable or altered measurement cohorts [I5-P06-AC10]":
        # @req NFR-001 NFR-002 NFR-003 NFR-004 NFR-007
        # @status: NOT_IMPLEMENTED
        step("Arrange (planned): Prepare otherwise complete size/startup cohorts and separately vary host, toolchain, candidate hash, output checksum, baseline admission or declared strip/runtime conditions.")
        step("Act (planned): Submit each altered cohort through the same measurement gate used for valid evidence.")
        step("Check (planned): Each identity or comparability violation is rejected with the offending field; no favorable size, startup or RSS number can override the invalid cohort, and original samples remain available for audit.")
        fail("NOT_IMPLEMENTED I5-P06-AC10: reject incomparable or altered measurement cohorts")
