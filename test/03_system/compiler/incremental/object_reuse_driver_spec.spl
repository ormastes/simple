# @cover src/compiler/80.driver/driver_build/incremental.spl 80%
# @req REQ-IM-005 REQ-IM-008 REQ-IM-010 REQ-IM-016 NFR-IM-002 NFR-IM-008
# Actual driver generations and executable parity; caller supplies an admitted
# pure-Simple candidate plus exact digest. Native fixtures alone are subordinate.
use std.spec.*
use std.io_runtime.{dir_create_all, file_write, file_read, file_exists,
    file_delete, file_hash_sha256, env_get, getpid, host_os, process_run_bounded}
use compiler.driver.driver_build.incremental.{build_cache_open}
use std.nogc_sync_mut.io.file_ops.{file_read_regular_no_follow_bounded_bytes}

fn object_reuse_candidate() -> text:
    val candidate = env_get("SIMPLE_OBJECT_REUSE_CANDIDATE")
    val digest = env_get("SIMPLE_OBJECT_REUSE_CANDIDATE_SHA256")
    expect(candidate == "").to_equal(false)
    expect(digest.len()).to_equal(64)
    expect(file_exists(candidate)).to_equal(true)
    expect(file_hash_sha256(candidate)).to_equal(digest)
    candidate

fn object_reuse_root(label: text) -> text:
    val root = ".simple/storage/build/phase3-incremental-completion/object-reuse-spec/{getpid()}-{label}"
    expect(dir_create_all(root + "/src")).to_equal(true)
    expect(dir_create_all(root + "/frontend")).to_equal(true)
    expect(dir_create_all(root + "/hir")).to_equal(true)
    root

fn object_reuse_write(root: text, entry: text, provider: text):
    expect(file_write(root + "/src/main.spl", entry)).to_equal(true)
    expect(file_write(root + "/src/provider.spl", provider)).to_equal(true)

fn object_reuse_build(root: text, generation: text, fresh: bool,
    extra_args: [text] = [], expect_success: bool = true) -> text:
    val candidate = object_reuse_candidate()
    val cache_suffix = if fresh: "/native-reference" else: "/native"
    val native_cache = root + cache_suffix
    val frontend_suffix = if fresh: "/frontend-reference" else: "/frontend"
    val hir_suffix = if fresh: "/hir-reference" else: "/hir"
    val frontend_dir = root + frontend_suffix
    val hir_dir = root + hir_suffix
    expect(dir_create_all(frontend_dir)).to_equal(true)
    expect(dir_create_all(hir_dir)).to_equal(true)
    val env_args = [
        "-u", "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_READ",
        "-u", "SIMPLE_PHASE2_COMPATIBILITY_MANIFEST_WRITE",
        "-u", "SIMPLE_PHASE3_COMPATIBILITY_CACHE_ROOT",
        "-u", "SIMPLE_SHARED_PARSE_CAS_ROOT",
        "-u", "SIMPLE_NATIVE_NOOP_CACHE_ROOT",
        "-u", "SIMPLE_NATIVE_BUILD_EMIT_OBJECT",
        "-u", "SIMPLE_NATIVE_BUILD_MANAGED_SOURCE_AUTHORITY",
        "-u", "SIMPLE_NATIVE_BUILD_PROCESS_PROFILE",
        "-u", "SIMPLE_NATIVE_GROUP_MANIFEST", "-u", "SIMPLE_NATIVE_GROUP_RESULT",
        "-u", "SIMPLE_SCV_SNAPSHOT_ROOT", "-u", "SIMPLE_SCV_REVISION_ID",
        "-u", "SIMPLE_SCV_COMMIT_ID", "-u", "SIMPLE_SCV_TREE_ID",
        "-u", "SIMPLE_SCV_INVENTORY_DIGEST", "-u", "SIMPLE_SCV_SOURCE_INVENTORY_DIGEST",
        "-u", "SIMPLE_SCV_INVENTORY_GENERATION",
        "-u", "SIMPLE_BOOTSTRAP_STAGE3", "-u", "SIMPLE_MEM_SNAPSHOT_FILE",
        "-u", "SIMPLE_COMPILER_PHASE_PROFILE_FILE",
        "SIMPLE_NO_STUB_FALLBACK=1", "SIMPLE_COMPILER_ARTIFACT_SERVICE_AVAILABLE=0", "SIMPLE_FRONTEND_CACHE=1",
        "SIMPLE_FRONTEND_CACHE_DIR=" + frontend_dir,
        "SIMPLE_HIR_CACHE=1", "SIMPLE_HIR_CACHE_DIR=" + hir_dir,
        candidate, "native-build", "--source", root + "/src",
        "--entry-closure", "--threads", "1", "--low-memory",
        "--cache-dir", native_cache, "--entry", root + "/src/main.spl",
        "--output", root + "/program-" + generation]
    val (stdout, stderr, code) = process_run_bounded("/usr/bin/env",
        env_args + extra_args, 180000, 67108864)
    expect(file_write(root + "/build-" + generation + ".stdout", stdout)).to_equal(true)
    expect(file_write(root + "/build-" + generation + ".stderr", stderr)).to_equal(true)
    if expect_success:
        expect(code).to_equal(0)
        expect(file_exists(root + "/program-" + generation)).to_equal(true)
    else:
        expect(code == 0).to_equal(false)
        expect(file_exists(root + "/program-" + generation)).to_equal(false)
    stdout + stderr

fn object_reuse_run(root: text, generation: text) -> text:
    val (stdout, stderr, code) = process_run_bounded(
        root + "/program-" + generation, [], 10000, 1048576)
    expect(code).to_equal(0)
    expect(stderr).to_equal("")
    stdout

fn object_reuse_hits(log: text, leaf: text) -> i64:
    var hits = 0
    for line in log.split("\n"):
        if line.starts_with("[NATIVE] cache hit: ") and (line.ends_with("." + leaf) or
                line == "[NATIVE] cache hit: " + leaf):
            hits = hits + 1
    hits

fn object_reuse_provider_object(root: text, leaf: text = "provider.spl") -> text:
    val cache = build_cache_open(root + "/native/build_cache.sdn")
    var found = ""
    for source in cache.entries.keys():
        if source.replace("\\", "/").ends_with("/" + leaf):
            val entry = cache.entries[source]
            expect(entry.module_witness == "").to_equal(false)
            expect(entry.outputs.len()).to_equal(1)
            expect(found).to_equal("")
            found = entry.outputs[0]
    expect(found == "").to_equal(false)
    expect(file_exists(found)).to_equal(true)
    expect(file_exists(found + ".capsule-receipt")).to_equal(true)
    found

fn object_reuse_change_provider(label: text, before: text, after: text,
    entry: text, expected_before: text, expected_after: text):
    val root = object_reuse_root(label)
    object_reuse_write(root, entry, before)
    val baseline = object_reuse_build(root, "baseline", false)
    expect(object_reuse_run(root, "baseline")).to_equal(expected_before)
    val old_object = object_reuse_provider_object(root)
    val old_receipt = file_read(old_object + ".capsule-receipt")
    object_reuse_write(root, entry, after)
    val changed = object_reuse_build(root, "changed", false)
    expect(object_reuse_hits(changed, "provider")).to_equal(0)
    val current_object = object_reuse_provider_object(root)
    expect(file_read(current_object + ".capsule-receipt") == old_receipt).to_equal(false)
    val changed_output = object_reuse_run(root, "changed")
    expect(changed_output).to_equal(expected_after)
    val reference = object_reuse_build(root, "reference", true)
    val reference_output = object_reuse_run(root, "reference")
    expect(reference_output).to_equal(expected_after)
    expect(changed_output).to_equal(reference_output)

describe "native object reuse through the actual driver":
    slow_it "changes the entry and reuses its authenticated current-input provider object bytes":
        # @req REQ-IM-005 REQ-IM-008 REQ-IM-016 NFR-IM-002
        step("prepare dependency objects with a pinned admitted producer")
        val root = object_reuse_root("entry")
        val provider = "pub fn double(x: i64) -> i64:\n    x * 2\n"
        object_reuse_write(root, "use provider.double\nfn main() -> i64:\n    print double(21)\n    0\n", provider)
        val baseline = object_reuse_build(root, "baseline", false)
        expect(object_reuse_run(root, "baseline")).to_equal("42\n")
        val object = object_reuse_provider_object(root)
        val bytes = file_hash_sha256(object)
        val receipt = file_read(object + ".capsule-receipt")
        step("edit only the entry body; observe the production reuse branch")
        object_reuse_write(root, "use provider.double\nfn main() -> i64:\n    print double(22)\n    0\n", provider)
        val changed = object_reuse_build(root, "changed", false)
        expect(object_reuse_hits(changed, "provider")).to_be_greater_than(0)
        expect(changed).to_contain("rebuilt 1.")
        expect(object_reuse_provider_object(root)).to_equal(object)
        expect(file_hash_sha256(object)).to_equal(bytes)
        expect(file_read(object + ".capsule-receipt")).to_equal(receipt)
        expect(object_reuse_run(root, "changed")).to_equal("44\n")
        step("compare the executable with isolated frontend, HIR, and native caches")
        val reference = object_reuse_build(root, "reference", true)
        expect(object_reuse_run(root, "reference")).to_equal("44\n")

    slow_it "invalidates a provider body without linking stale bytes":
        object_reuse_change_provider("body",
            "pub fn value() -> i64:\n    21\n",
            "pub fn value() -> i64:\n    22\n",
            "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "21\n", "22\n")

    slow_it "invalidates a public return signature":
        object_reuse_change_provider("signature",
            "pub fn value() -> i64:\n    21\n",
            "pub fn value() -> text:\n    \"22\"\n",
            "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "21\n", "22\n")

    slow_it "invalidates an instantiated generic body":
        object_reuse_change_provider("generic",
            "pub fn value<T>(x: T) -> i64:\n    21\n",
            "pub fn value<T>(x: T) -> i64:\n    22\n",
            "use provider.value\nfn main() -> i64:\n    print value(1)\n    0\n", "21\n", "22\n")

    slow_it "invalidates a consumed default expression":
        object_reuse_change_provider("default",
            "pub fn value(x: i64 = 21) -> i64:\n    x\n",
            "pub fn value(x: i64 = 22) -> i64:\n    x\n",
            "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "21\n", "22\n")

    slow_it "invalidates a published constant":
        object_reuse_change_provider("constant",
            "pub val amount: i64 = 21\npub fn anchor() -> i64:\n    0\n",
            "pub val amount: i64 = 22\npub fn anchor() -> i64:\n    0\n",
            "use provider.amount\nfn main() -> i64:\n    print amount\n    0\n", "21\n", "22\n")

    slow_it "invalidates a module initializer":
        object_reuse_change_provider("initializer",
            "pub var amount: i64 = 21\n",
            "pub var amount: i64 = 22\n",
            "use provider.amount\nfn main() -> i64:\n    print amount\n    0\n", "21\n", "22\n")

    slow_it "rebuilds a missing or corrupted dependency object and receipt":
        # @req REQ-IM-008 REQ-IM-010 NFR-IM-008
        val root = object_reuse_root("missing-object")
        val entry = "use provider.value\nfn main() -> i64:\n    print value()\n    0\n"
        object_reuse_write(root, entry, "pub fn value() -> i64:\n    21\n")
        val baseline = object_reuse_build(root, "baseline", false)
        val object = object_reuse_provider_object(root)
        expect(file_delete(object)).to_equal(true)
        val missing = object_reuse_build(root, "missing", false)
        expect(object_reuse_hits(missing, ".provider")).to_equal(0)
        expect(object_reuse_run(root, "missing")).to_equal("21\n")
        expect(file_write(object_reuse_provider_object(root), "corrupt-object")).to_equal(true)
        val corrupt = object_reuse_build(root, "corrupt", false)
        expect(object_reuse_hits(corrupt, ".provider")).to_equal(0)
        expect(object_reuse_run(root, "corrupt")).to_equal("21\n")
        expect(file_write(object_reuse_provider_object(root) + ".capsule-receipt", "forged-receipt\n")).to_equal(true)
        val forged = object_reuse_build(root, "forged", false)
        expect(object_reuse_hits(forged, ".provider")).to_equal(0)
        expect(object_reuse_run(root, "forged")).to_equal("21\n")

    slow_it "invalidates an optimization configuration without erasing the old scope":
        # @req REQ-IM-008 REQ-IM-016
        val root = object_reuse_root("config")
        object_reuse_write(root, "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "pub fn value() -> i64:\n    21\n")
        val baseline = object_reuse_build(root, "baseline", false, ["--opt-level", "0"])
        val old_object = object_reuse_provider_object(root)
        val old_bytes = file_hash_sha256(old_object)
        val changed = object_reuse_build(root, "changed", false, ["--opt-level", "1"])
        expect(object_reuse_hits(changed, "provider")).to_equal(0)
        expect(object_reuse_provider_object(root) == old_object).to_equal(false)
        expect(file_hash_sha256(old_object)).to_equal(old_bytes)
        expect(object_reuse_run(root, "changed")).to_equal("21\n")

    slow_it "refuses changed invalid source before stale native publication":
        # @req REQ-IM-008 REQ-IM-010 REQ-IM-016 NFR-IM-008
        val root = object_reuse_root("invalid-source")
        val entry = "use provider.value\nfn main() -> i64:\n    print value()\n    0\n"
        object_reuse_write(root, entry, "pub fn value() -> i64:\n    21\n")
        val baseline = object_reuse_build(root, "baseline", false)
        val old_object = object_reuse_provider_object(root)
        val old_bytes = file_hash_sha256(old_object)
        val old_receipt = file_read(old_object + ".capsule-receipt")
        object_reuse_write(root, entry, "pub fn value() -> i64:\n    val broken =\n    22\n")
        val rejected = object_reuse_build(root, "rejected", false, [], false)
        val reference = object_reuse_build(root, "reference", true, [], false)
        expect(rejected).to_contain("provider.spl")
        expect(reference).to_contain("provider.spl")
        expect(file_hash_sha256(old_object)).to_equal(old_bytes)
        expect(file_read(old_object + ".capsule-receipt")).to_equal(old_receipt)

    slow_it "invalidates a referenced external record layout":
        # @req REQ-IM-008 REQ-IM-009 REQ-IM-016
        object_reuse_change_provider("layout",
            "pub class Box:\n    value: i64\npub fn make() -> Box:\n    Box(value: 21)\n",
            "pub class Box:\n    padding: i64\n    value: i64\npub fn make() -> Box:\n    Box(padding: 0, value: 22)\n",
            "use provider.{Box, make}\nfn main() -> i64:\n    val box = make()\n    print box.value\n    0\n", "21\n", "22\n")

    slow_it "invalidates a target-selected static guard":
        # @req REQ-IM-008 REQ-IM-016
        expect(host_os()).to_equal("linux")
        object_reuse_change_provider("static-guard",
            "@when(os=\"linux\"):\npub fn value() -> i64:\n    21\n@else:\npub fn value() -> i64:\n    22\n@end\n",
            "@when(os=\"windows\"):\npub fn value() -> i64:\n    21\n@else:\npub fn value() -> i64:\n    22\n@end\n",
            "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "21\n", "22\n")

    slow_it "invalidates a recorded negative import query when the preferred module appears":
        # @req REQ-IM-008 REQ-IM-016
        val root = object_reuse_root("negative-query")
        expect(dir_create_all(root + "/src/provider")).to_equal(true)
        expect(file_write(root + "/src/main.spl", "use provider.value\nfn main() -> i64:\n    print value()\n    0\n")).to_equal(true)
        expect(file_write(root + "/src/provider/__init__.spl", "pub fn value() -> i64:\n    21\n")).to_equal(true)
        val baseline = object_reuse_build(root, "baseline", false)
        expect(object_reuse_run(root, "baseline")).to_equal("21\n")
        val original = object_reuse_provider_object(root, "provider/__init__.spl")
        val original_bytes = file_hash_sha256(original)
        expect(file_write(root + "/src/provider.spl", "pub fn value() -> i64:\n    22\n")).to_equal(true)
        val changed = object_reuse_build(root, "changed", false)
        val changed_output = object_reuse_run(root, "changed")
        val reference = object_reuse_build(root, "reference", true)
        val reference_output = object_reuse_run(root, "reference")
        expect(changed_output).to_equal("22\n")
        expect(reference_output).to_equal(changed_output)
        expect(file_hash_sha256(original)).to_equal(original_bytes)

    slow_it "invalidates a visible overload candidate set":
        # @req REQ-IM-008 REQ-IM-016
        # This is a real language/backend gate. A cold compiler refusal is a
        # concrete unsupported-feature failure, never an object-cache PASS.
        object_reuse_change_provider("overload",
            "pub fn value(x: i64) -> i64:\n    21\n",
            "pub fn value(x: i64) -> i64:\n    21\npub fn value(x: text) -> i64:\n    22\n",
            "use provider.value\nfn main() -> i64:\n    print value(1)\n    0\n", "21\n", "21\n")

    slow_it "invalidates a selected trait implementation body":
        # @req REQ-IM-008 REQ-IM-016
        object_reuse_change_provider("impl",
            "pub trait Value:\n    fn value() -> i64\npub class Target:\n    n: i64\nimpl Value for Target:\n    fn value() -> i64:\n        21\npub fn make() -> Target:\n    Target(n: 0)\n",
            "pub trait Value:\n    fn value() -> i64\npub class Target:\n    n: i64\nimpl Value for Target:\n    fn value() -> i64:\n        22\npub fn make() -> Target:\n    Target(n: 0)\n",
            "use provider.{Value, Target, make}\nfn main() -> i64:\n    val target = make()\n    print target.value()\n    0\n", "21\n", "22\n")

    slow_it "invalidates an active aspect body before native publication":
        # @req REQ-IM-008 REQ-IM-016
        object_reuse_change_provider("aspect",
            "pub fn value() -> i64:\n    42\nfn notice():\n    print 21\non pc{execution(* *value(..)) & within(*provider*)} use notice before\n",
            "pub fn value() -> i64:\n    42\nfn notice():\n    print 22\non pc{execution(* *value(..)) & within(*provider*)} use notice before\n",
            "use provider.value\nfn main() -> i64:\n    print value()\n    0\n", "21\n42\n", "22\n42\n")

    slow_it "publishes only the entry object before linking and reuses prepared imports":
        # This exercises the ordinary full-source cache route. It does not claim
        # header omission, managed SCV publication or the latency target.
        expect(host_os()).to_equal("linux")
        val root = object_reuse_root("entry-cutoff")
        val provider = "pub fn double(x: i64) -> i64:\n    x * 2\n"
        object_reuse_write(root,
            "use provider.double\nfn main() -> i64:\n    print double(21)\n    0\n", provider)
        val baseline = object_reuse_build(root, "baseline", false)
        expect(object_reuse_run(root, "baseline")).to_equal("42\n")
        val imported = object_reuse_provider_object(root)
        val imported_digest = file_hash_sha256(imported)
        val imported_receipt = file_read(imported + ".capsule-receipt")
        object_reuse_write(root,
            "use provider.double\nfn main() -> i64:\n    print double(22)\n    0\n", provider)
        val changed = object_reuse_build(root, "entry-object", false, ["--emit-entry-object"])
        expect(object_reuse_hits(changed, "provider")).to_be_greater_than(0)
        expect(changed).to_contain("rebuilt 1.")
        expect(file_hash_sha256(imported)).to_equal(imported_digest)
        expect(file_read(imported + ".capsule-receipt")).to_equal(imported_receipt)
        val output = file_read_regular_no_follow_bounded_bytes(
            root + "/program-entry-object", 134217728).unwrap()
        expect(output.len()).to_be_greater_than(20)
        expect(output[0]).to_equal(127u8)
        expect(output[1]).to_equal(69u8)
        expect(output[2]).to_equal(76u8)
        expect(output[3]).to_equal(70u8)
        # ELF ET_REL is an actual relocatable object, unlike the baseline image.
        expect(output[16]).to_equal(1u8)
        expect(output[17]).to_equal(0u8)
        expect(file_delete(imported)).to_equal(true)
        val refused = object_reuse_build(root, "missing-import", false,
            ["--emit-entry-object"], false)
        expect(refused).to_contain("entry-object dependency ObjectReady unavailable")
        expect(file_exists(imported)).to_equal(false)
