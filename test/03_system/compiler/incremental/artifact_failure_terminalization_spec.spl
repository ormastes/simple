# @req REQ-IM-007
use std.spec.*
use compiler.driver.action_graph.artifact_service_bridge.{DemandArtifactRouteV1, demand_artifact_route_v1, demand_artifact_claim_owned_v1, demand_artifact_commit_owned_v1}
use compiler.driver.action_graph.build_action_v1.{BuildActionV1, BuildActionResultV1, BuildActionPoolV1, BuildActionStateV1}
use compiler.driver.action_graph.persisted_graph.{PersistedBuildGraphV1}
use compiler.driver.action_graph.coordinator.{BuildPoolBudgetV1, coordinator_new_v1}
use compiler.driver.action_graph.demand_compile_integration.{DemandCompileExecutionV1}
use compiler.driver.backend.native_promotion_queue.{NativePromotionQueueV1}
use compiler.driver.perf.demand_compile_counters.{demand_compile_counters_empty_v1}
use lib.compiler_artifact_service.profile.{artifact_service_profile_v1}
use lib.compiler_artifact_service.service.{ArtifactLeaseV1, ArtifactRequestStateV1}

fn terminal_failure_route() -> DemandArtifactRouteV1:
    val action = BuildActionV1("action", "compile", ["source"], [], ["object"], BuildActionPoolV1.parse, 1, "snapshot", 1024, "")
    val coordinator = coordinator_new_v1(PersistedBuildGraphV1("graph", "", "snapshot", [action]), [BuildPoolBudgetV1(BuildActionPoolV1.parse, 1, 1024)])
    val execution = DemandCompileExecutionV1(true, "ok", Some(coordinator), None,
        NativePromotionQueueV1([]), "action", demand_compile_counters_empty_v1(), None, None, 0, "", 0, 0)
    val route = demand_artifact_route_v1(execution, artifact_service_profile_v1("terminal", "compiler", ["parse"], 0, true), true, "owner", 7)
    val claimed = demand_artifact_claim_owned_v1(route, "action", "lease", 1024)
    expect(claimed.claim.valid).to_be(true)
    claimed.route

describe "REQ-IM-007: failed and cancelled actions release their reservation":
    it "should admit an empty-output failure or cancellation exactly once without CAS publication":
        for cancelled in [false, true]:
            step("Claim an action and return an unsuccessful result without an output artifact")
            val route = terminal_failure_route()
            val original = route.service.entries[0].lease
            val result = BuildActionResultV1("action", "snapshot", false, cancelled, "", "", ["worker failed"], 512)
            val finished = demand_artifact_commit_owned_v1(route, result, original)
            expect(finished.accepted).to_be(true)
            expect(finished.route.service.entries[0].state).to_equal(
                if cancelled: ArtifactRequestStateV1.cancelled else: ArtifactRequestStateV1.failed)
            expect(finished.route.execution.coordinator.unwrap().runtime[0].state).to_equal(
                if cancelled: BuildActionStateV1.cancelled else: BuildActionStateV1.failed)
            expect(finished.route.service.entries[0].cas_artifact_digest).to_equal("")
            expect(finished.route.service.entries[0].error_code).to_equal(if cancelled: "cancelled" else: "action-failed")
            expect(finished.route.execution.coordinator.unwrap().runtime[0].memory_reserved_bytes).to_equal(0)
            step("Reject duplicate terminal delivery and retain the original input reservation")
            expect(demand_artifact_commit_owned_v1(finished.route, result, original).accepted).to_be(false)
            expect(route.execution.coordinator.unwrap().runtime[0].memory_reserved_bytes).to_equal(1024)
            expect(route.service.entries[0].state).to_equal(ArtifactRequestStateV1.leased)

    it "should reject stale failure and cancellation before releasing the current reservation":
        for cancelled in [false, true]:
            step("Deliver a terminal result carrying an older dispatch generation")
            val route = terminal_failure_route()
            val stale = ArtifactLeaseV1("lease", "action", "owner", 6, false)
            val denied = demand_artifact_commit_owned_v1(route,
                BuildActionResultV1("action", "snapshot", false, cancelled, "", "", ["old worker"], 512), Some(stale))
            expect(denied.accepted).to_be(false)
            expect(denied.route.service.entries[0].state).to_equal(ArtifactRequestStateV1.leased)
            expect(denied.route.execution.coordinator.unwrap().runtime[0].state).to_equal(BuildActionStateV1.running)
            expect(denied.route.execution.coordinator.unwrap().runtime[0].memory_reserved_bytes).to_equal(1024)

    it "should keep successful empty-output results rejected":
        step("Attempt successful publication without an output identity")
        val route = terminal_failure_route()
        val denied = demand_artifact_commit_owned_v1(route,
            BuildActionResultV1("action", "snapshot", true, false, "", "", [], 512), route.service.entries[0].lease)
        expect(denied.accepted).to_be(false)
        expect(denied.route.service.entries[0].cas_artifact_digest).to_equal("")
        expect(denied.route.execution.coordinator.unwrap().runtime[0].memory_reserved_bytes).to_equal(1024)
