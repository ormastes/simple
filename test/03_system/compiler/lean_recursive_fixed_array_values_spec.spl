# codex-system-test
# @manual: show
# @req: C2, REQ-C2-RV-002
# Actual MIR/planner/emitter APIs; tests-first, execution and Lean checks UNRUN.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirInst, MirInstKind, AggregateKind, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirConstValue, MirTypeDef, MirTypeDefKind, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use compiler.mir.mir_json.{serialize_mir_module}
use plugins.backend_lean.lean_backend.{LeanBackend, VerificationLevel}
use compiler.backend.backend.lean_backend.{LeanBackend as CompilerLeanBackend, VerificationLevel as CompilerVerificationLevel}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations}
use plugins.backend_lean.lean_nominal_body.{translate_mir_nominal_body, lean_nominal_emitter_for_function_v1}

fn rv_value_ty(kind: MirTypeKind) -> MirType: MirType(kind: kind)
fn rv_value_tree() -> MirType: rv_value_ty(MirTypeKind.Enum(SymbolId(id: 2)))
fn rv_value_array(element: MirType, size: i64) -> MirType:
    rv_value_ty(MirTypeKind.Array(element, size))
fn rv_value_copy(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))
fn rv_value_move(id: i64) -> MirOperand:
    MirOperand(kind: MirOperandKind.Move(LocalId(id: id)))
fn rv_value_local(id: i64, type_: MirType, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: kind, is_ghost: false)
fn rv_value_inst(kind: MirInstKind) -> MirInst: MirInst(kind: kind, span: nil)
fn rv_value_aggregate(dest: i64, element: MirType, operands: [MirOperand]) -> MirInst:
    rv_value_inst(MirInstKind.Aggregate(LocalId(id: dest), AggregateKind.Array(element), operands))
fn rv_value_function(parameters: [MirType], locals: [MirLocal], instructions: [MirInst],
    result: MirType, returned: i64) -> MirFunction:
    MirFunction(symbol: SymbolId(id: 90), name: "arrayValues",
        signature: MirSignature(params: parameters, return_type: result, is_variadic: false, params_known: true),
        locals: locals, blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: instructions,
            terminator: MirTerminator.Ret(Some(rv_value_copy(returned))))],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)
fn rv_value_module(payload: MirType, function: MirFunction) -> MirModule:
    val definition = MirTypeDef(symbol: SymbolId(id: 2), name: "Tree",
        kind: MirTypeDefKind.Enum([
            MirVariantDef(name: "Done", discriminant: -5, payload: nil),
            MirVariantDef(name: "More", discriminant: 13, payload: Some(payload))]),
        is_export_c: false, export_name: "")
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[definition.symbol] = definition
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    MirModule(name: "RecursiveArrayValues", functions: functions, statics: {}, constants: {}, types: types)
fn rv_value_tree_name() -> text: "_root_.Simple.RecursiveArrayValues.__MirTypes.«Tree»"

# Expected text only; these helpers never invoke production mapping or policy.
fn rv_value_finite(element: text, size: i64) -> text:
    "(_root_.Fin " + size.to_text() + " → " + element + ")"
fn rv_value_vector(element: text, size: i64, terms: text) -> text:
    "(_root_.Vector.mk (#[" + terms + "] : _root_.Array (" + element +
        ")) (by rfl) : _root_.Vector (" + element + ") " + size.to_text() + ")"
fn rv_value_capture(element: text, size: i64, terms: text) -> text:
    "(let _rv_values := " + rv_value_vector(element, size, terms) +
        "; fun _rv_index : _root_.Fin " + size.to_text() + " => _rv_values.get _rv_index)"

fn rv_value_outputs(module: MirModule, function: MirFunction, expected: text):
    val before = serialize_mir_module(module)
    val context = lean_plan_type_declarations(module, "Simple.RecursiveArrayValues").unwrap().context
    expect(translate_mir_nominal_body(function, context).unwrap()).to_equal(expected)
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    val indented = expected.replace("\n", "\n  ")
    expect(plugin.export_module(module).unwrap().lean_code).to_contain(indented)
    expect(plugin.export_generated_module(module).unwrap().lean_code).to_contain(indented)
    expect(compiler.export_module(module).unwrap().lean_code).to_contain(indented)
    expect(compiler.export_generated_module(module).unwrap().lean_code).to_contain(indented)
    expect(serialize_mir_module(module)).to_equal(before)

fn rv_value_refusal(module: MirModule, function: MirFunction, reason: text):
    val before = serialize_mir_module(module)
    val context = lean_plan_type_declarations(module, "Simple.RecursiveArrayValues").unwrap().context
    match translate_mir_nominal_body(function, context):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)
    expect(serialize_mir_module(module)).to_equal(before)

describe "recursive fixed-array construction through the existing nominal emitter":
    it "captures ordered operands once outside the index lambda using disjoint local names":
        step("Construct and transport finite arrays")
        val tree = rv_value_tree()
        val array = rv_value_array(tree, 2)
        var first = rv_value_local(0, tree, LocalKind.Arg(0))
        var second = rv_value_local(1, tree, LocalKind.Arg(1))
        first.name = Some("_rv_values")
        second.name = Some("_rv_index")
        val function = rv_value_function([tree, tree], [first, second, rv_value_local(2, array, LocalKind.Temp)],
            [rv_value_aggregate(2, tree, [rv_value_copy(1), rv_value_move(0)])], array, 2)
        val expected = "let _l2 : " + rv_value_finite(rv_value_tree_name(), 2) + " := " +
            rv_value_capture(rv_value_tree_name(), 2, "_l1, _l0") + "\n_l2"
        rv_value_outputs(rv_value_module(array, function), function, expected)

    it "constructs both empty aggregate and empty constant without a nominal inhabitant":
        step("Construct and transport finite arrays")
        val tree = rv_value_tree()
        val empty = rv_value_array(tree, 0)
        val function = rv_value_function([], [rv_value_local(0, empty, LocalKind.Temp), rv_value_local(1, empty, LocalKind.Temp)], [
            rv_value_aggregate(0, tree, []),
            rv_value_inst(MirInstKind.Const(LocalId(id: 1), MirConstValue.Array([]), empty))], empty, 1)
        val line = rv_value_finite(rv_value_tree_name(), 0) + " := " + rv_value_capture(rv_value_tree_name(), 0, "")
        rv_value_outputs(rv_value_module(empty, function), function, "let _l0 : " + line + "\nlet _l1 : " + line + "\n_l1")

    it "constructs nested selected constants with independently scoped captures":
        step("Construct and transport finite arrays")
        val inner = rv_value_array(rv_value_tree(), 0)
        val outer = rv_value_array(inner, 2)
        val value = MirConstValue.Array([MirConstValue.Array([]), MirConstValue.Array([])])
        val function = rv_value_function([], [rv_value_local(0, outer, LocalKind.Temp)],
            [rv_value_inst(MirInstKind.Const(LocalId(id: 0), value, outer))], outer, 0)
        val child = rv_value_capture(rv_value_tree_name(), 0, "")
        val child_type = rv_value_finite(rv_value_tree_name(), 0)
        val expected = "let _l0 : " + rv_value_finite(child_type, 2) + " := " +
            rv_value_capture(child_type, 2, child + ", " + child) + "\n_l0"
        rv_value_outputs(rv_value_module(outer, function), function, expected)

    it "uses already constructed inner carrier locals without applying get or wrapping them again":
        step("Construct and transport finite arrays")
        val tree = rv_value_tree()
        val inner = rv_value_array(tree, 1)
        val outer = rv_value_array(inner, 2)
        val function = rv_value_function([tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, inner, LocalKind.Temp), rv_value_local(2, outer, LocalKind.Temp)], [
            rv_value_aggregate(1, tree, [rv_value_copy(0)]),
            rv_value_aggregate(2, inner, [rv_value_copy(1), rv_value_move(1)])], outer, 2)
        val child_type = rv_value_finite(rv_value_tree_name(), 1)
        val expected = "let _l1 : " + child_type + " := " + rv_value_capture(rv_value_tree_name(), 1, "_l0") +
            "\nlet _l2 : " + rv_value_finite(child_type, 2) + " := " + rv_value_capture(child_type, 2, "_l1, _l1") + "\n_l2"
        rv_value_outputs(rv_value_module(outer, function), function, expected)

    it "preserves byte-exact ordinary Vector output for an unselected nominal array length":
        step("Preserve source and declaration authority")
        val tree = rv_value_tree()
        val selected = rv_value_array(tree, 2)
        val ordinary = rv_value_array(tree, 1)
        val function = rv_value_function([tree], [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, ordinary, LocalKind.Temp)],
            [rv_value_aggregate(1, tree, [rv_value_copy(0)])], ordinary, 1)
        val expected = "let _l1 : _root_.Vector (" + rv_value_tree_name() + ") 1 := " +
            rv_value_vector(rv_value_tree_name(), 1, "_l0") + "\n_l1"
        rv_value_outputs(rv_value_module(selected, function), function, expected)

    it "charges selected aggregate root and operands before allocation or move consumption":
        step("Refuse malformed or over-budget export")
        val tree = rv_value_tree()
        val array = rv_value_array(tree, 2)
        val instruction = rv_value_aggregate(2, tree, [rv_value_move(0), rv_value_move(1)])
        val function = rv_value_function([tree, tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, tree, LocalKind.Arg(1)), rv_value_local(2, array, LocalKind.Temp)],
            [instruction], array, 2)
        val module = rv_value_module(array, function)
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrayValues").unwrap().context
        var exact = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        exact.constant_nodes_left = 3
        expect(exact.instruction(instruction).unwrap()).to_contain(rv_value_capture(rv_value_tree_name(), 2, "_l0, _l1"))
        expect(exact.constant_nodes_left).to_equal(0)
        expect(exact.live[0]).to_equal(false)
        expect(exact.live[1]).to_equal(false)
        var short = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        short.constant_nodes_left = 2
        match short.instruction(instruction):
            case Err(error): expect(error.message).to_contain("selected array term budget")
            case Ok(_): assert(false)
        expect(short.constant_nodes_left).to_equal(2)
        expect(short.live[0]).to_equal(true)
        expect(short.live[1]).to_equal(true)
        expect(short.assigned.has(2)).to_equal(false)

    it "retains the existing recursive constant budget without charging a selected constant twice":
        step("Refuse malformed or over-budget export")
        val inner = rv_value_array(rv_value_tree(), 0)
        val outer = rv_value_array(inner, 2)
        val value = MirConstValue.Array([MirConstValue.Array([]), MirConstValue.Array([])])
        val function = rv_value_function([], [rv_value_local(0, outer, LocalKind.Temp)], [], outer, 0)
        val module = rv_value_module(outer, function)
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrayValues").unwrap().context
        var exact = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        exact.constant_nodes_left = 3
        val child = rv_value_capture(rv_value_tree_name(), 0, "")
        expect(exact.composite_constant(value, outer, 1).unwrap()).to_equal(
            rv_value_capture(rv_value_finite(rv_value_tree_name(), 0), 2, child + ", " + child))
        expect(exact.constant_nodes_left).to_equal(0)
        var short = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        short.constant_nodes_left = 2
        match short.composite_constant(value, outer, 1):
            case Err(error): expect(error.message).to_contain("constant node budget")
            case Ok(_): assert(false)

    it "charges an empty selected aggregate once while leaving ordinary aggregate charging unchanged":
        step("Refuse malformed or over-budget export")
        val tree = rv_value_tree()
        val empty = rv_value_array(tree, 0)
        val instruction = rv_value_aggregate(0, tree, [])
        val function = rv_value_function([], [rv_value_local(0, empty, LocalKind.Temp)], [instruction], empty, 0)
        val module = rv_value_module(empty, function)
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrayValues").unwrap().context
        var exact = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        exact.constant_nodes_left = 1
        expect(exact.instruction(instruction).unwrap()).to_contain(rv_value_capture(rv_value_tree_name(), 0, ""))
        expect(exact.constant_nodes_left).to_equal(0)
        var short = lean_nominal_emitter_for_function_v1(function, context).unwrap()
        short.constant_nodes_left = 0
        expect(short.instruction(instruction).is_err()).to_equal(true)
        expect(short.assigned.has(0)).to_equal(false)
        val ordinary = rv_value_array(tree, 1)
        val ordinary_instruction = rv_value_aggregate(1, tree, [rv_value_copy(0)])
        val ordinary_function = rv_value_function([tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, ordinary, LocalKind.Temp)],
            [ordinary_instruction], ordinary, 1)
        var ordinary_emitter = lean_nominal_emitter_for_function_v1(ordinary_function, context).unwrap()
        ordinary_emitter.constant_nodes_left = 0
        expect(ordinary_emitter.instruction(ordinary_instruction).unwrap()).to_contain(rv_value_vector(rv_value_tree_name(), 1, "_l0"))
        expect(ordinary_emitter.constant_nodes_left).to_equal(0)

    it "keeps ordinary scalar constants byte-identical beside a selected recursive shape":
        step("Preserve source and declaration authority")
        val byte = rv_value_ty(MirTypeKind.U8)
        val array = rv_value_array(byte, 2)
        val value = MirConstValue.Array([MirConstValue.Int(1), MirConstValue.Int(255)])
        val function = rv_value_function([], [rv_value_local(0, array, LocalKind.Temp)],
            [rv_value_inst(MirInstKind.Const(LocalId(id: 0), value, array))], array, 0)
        val expected = "let _l0 : _root_.Vector (_root_.BitVec 8) 2 := " +
            rv_value_vector("_root_.BitVec 8", 2, "(BitVec.ofInt 8 1), (BitVec.ofInt 8 255)") + "\n_l0"
        rv_value_outputs(rv_value_module(rv_value_array(rv_value_tree(), 2), function), function, expected)

    it "rejects repeated Move through actual operand liveness before publishing a body":
        step("Refuse malformed or over-budget export")
        val tree = rv_value_tree()
        val array = rv_value_array(tree, 2)
        val function = rv_value_function([tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, array, LocalKind.Temp)],
            [rv_value_aggregate(1, tree, [rv_value_move(0), rv_value_move(0)])], array, 1)
        rv_value_refusal(rv_value_module(array, function), function, "use before definition or after move")

    it "refuses count mismatch and wrong nominal element kind rather than producing a carrier":
        step("Refuse malformed or over-budget export")
        val tree = rv_value_tree()
        val array = rv_value_array(tree, 2)
        val short = rv_value_function([tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, array, LocalKind.Temp)],
            [rv_value_aggregate(1, tree, [rv_value_copy(0)])], array, 1)
        rv_value_refusal(rv_value_module(array, short), short, "array length mismatch")
        val wrong = rv_value_ty(MirTypeKind.Struct(SymbolId(id: 2)))
        val wrong_function = rv_value_function([tree],
            [rv_value_local(0, tree, LocalKind.Arg(0)), rv_value_local(1, array, LocalKind.Temp)],
            [rv_value_aggregate(1, wrong, [rv_value_copy(0), rv_value_copy(0)])], array, 1)
        rv_value_refusal(rv_value_module(array, wrong_function), wrong_function, "nominal kind mismatch")
