# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# research: doc/01_research/domain/sspec_documentization_maintenance.md ; plan: doc/03_plan/sspec_modernization_plan.md ; architecture: doc/04_architecture/sspec_documentization_maintenance.md ; design: doc/05_design/infra/sspec/modern_sspec_typed_evidence_design.md

# codex-system-test
"""
# Native cross-module static error factory regression

Reproduces the Stage 3 call shape where `BackendError.runtime_error(...)` was
classified unresolved and its type-valued receiver crossed an aggregate native
call boundary. Acceptance requires a real native candidate and exact output.
"""

use std.spec.step

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

fn prepare_crossmodule_static_factory_fixture() -> (text, text, i64):
    rt_process_run("sh", [
        "scripts/check/check-native-crossmodule-static-error-factory.shs"
    ])

val _static_factory_gate = prepare_crossmodule_static_factory_fixture()

describe "REQ-BST-STATIC-001: native static-owner identity":
    # @manual scenario evidence
    it "should retain a type receiver across the native lowering boundary":
        # @req REQ-BST-STATIC-001
        # @req REQ-BST-STATIC-001
        # @req REQ-SSPEC-SYSTEM
        step("should retain a type receiver across the native lowering boundary")
        step("Compile an imported runtime_error-shaped static factory")
        expect(_static_factory_gate.2).to_equal(0)
        expect(_static_factory_gate.0).to_contain("STATUS: PASS native-crossmodule-static-factory")

    it "should preserve adjacent static methods on the same imported owner":
        # @req REQ-SSPEC-SYSTEM
        step("should preserve adjacent static methods on the same imported owner")
        step("Execute runtime_error and type_error shaped factories")
        expect(_static_factory_gate.0).to_contain("factories=2")

    it "should reject shortcuts and missing native evidence":
        # @req REQ-SSPEC-SYSTEM
        step("should reject shortcuts and missing native evidence")
        step("Require a pure-Simple compiler and an executed native candidate")
        expect(_static_factory_gate.1).to_equal("")
        expect(_static_factory_gate.0.contains("STATUS: FAIL")).to_equal(false)
