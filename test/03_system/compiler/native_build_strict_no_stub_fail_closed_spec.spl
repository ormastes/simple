# @req KPM-REQ-004 KPM-REQ-009 KPM-NFR-004
use std.spec.*
use std.io.{file_read}
use app.cli.native_build_main.{
    native_build_strict_stub_evidence,
    native_build_strict_stub_violation
}

describe "native-build strict no-stub publication guard":
    it "rejects the observed unresolved-symbol mutation in strict mode":
        val mutation = "Generating 327 stub functions for unresolved symbols...\nUnresolved symbol preview: missing_runtime"
        expect(native_build_strict_stub_evidence(mutation)).to_equal(true)
        expect(native_build_strict_stub_violation(true, mutation, "")).to_equal(true)

    it "does not change compatibility-mode verdicts or clean strict output":
        val mutation = "Generating 327 stub functions for unresolved symbols..."
        expect(native_build_strict_stub_violation(false, mutation, "")).to_equal(false)
        expect(native_build_strict_stub_violation(true, "Native executable written", "")).to_equal(false)

    it "wires rejection before cache promotion and removes a produced binary":
        val source = file_read("src/app/cli/native_build_main.spl") ?? ""
        val guard = source.find("if native_build_strict_stub_violation") ?? -1
        val deletion = source.find("file_delete(output_path)") ?? -1
        val promotion = source.find("native_build_warm_receipt_finish(") ?? -1
        expect(guard).to_be_greater_than(0)
        expect(deletion).to_be_greater_than(guard)
        expect(promotion).to_be_greater_than(deletion)
        expect(source).to_contain("return 1")
