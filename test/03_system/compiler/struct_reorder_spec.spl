# @tag:system
# @req REQ-SSPEC-SYSTEM
# @cover src/compiler/30.types/_TypeLayout/layout_core.spl 80%
# @cover src/compiler/30.types/_TypeLayout/arch_and_verify.spl 80%
# Targets are not measured coverage. These scenarios execute the public layout
# API with HIR inputs; Rust parity, parsing, and native ABI remain separate gates.

use std.spec.{describe, it, expect, step, fail}
use compiler.types.type_layout.{LayoutAttr, TypeLayoutKind, TypeLayout, reorder_fields_by_size, reorder_fields_by_size_for_arch, compute_struct_layout, compute_struct_layout_for_arch}
use compiler.hir.hir_definitions.{HirField, HirExpr, HirExprKind}
use compiler.hir.hir_types.{HirType, HirTypeKind, SymbolId}
use compiler.common.diagnostics.span.{Span}
use compiler.common.dependency.visibility.{Visibility}
use std.common.target.{TargetArch}

fn _sr_span() -> Span:
    Span(start: 0, end: 0, line: 1, col: 1)

fn _sr_type(kind: HirTypeKind) -> HirType:
    HirType(kind: kind, span: _sr_span())

fn _sr_int(bits: i64, signed: bool) -> HirType:
    _sr_type(HirTypeKind.Int(bits, signed))

fn _sr_field(name: text, id: i64, type_: HirType) -> HirField:
    val absent_default = HirExpr(kind: HirExprKind.UnitLit, has_type_: false, type_: _sr_type(HirTypeKind.Unit), span: _sr_span())
    HirField(
        symbol: SymbolId(id: id), name: name, type_: type_,
        has_default: false, default: absent_default,
        visibility: Visibility.Public, is_public: true, is_volatile: false,
        has_bits_attr: false, bits_width: 0,
        has_fixed_address: false, fixed_address: 0, span: _sr_span()
    )

fn _sr_fields() -> [HirField]:
    [_sr_field("byte", 1, _sr_int(8, false)),
     _sr_field("wide", 2, _sr_int(64, true)),
     _sr_field("half", 3, _sr_int(16, false)),
     _sr_field("word", 4, _sr_int(32, false))]

fn _sr_attr(kind: TypeLayoutKind, preserve: bool, compact: bool) -> LayoutAttr:
    LayoutAttr(layout_kind: kind, has_explicit_align: false, explicit_align: 0,
        is_packed: kind == TypeLayoutKind.Packed,
        is_preserve_order: preserve, is_compactq: compact)

fn _sr_expect_order(fields: [HirField], names: [text], ids: [i64]):
    if fields.len() != names.len():
        fail("Expected {names.len()} fields, got {fields.len()}")
        return
    for i in 0..names.len():
        expect(fields[i].name).to_equal(names[i])
        expect(fields[i].symbol.id).to_equal(ids[i])
        expect(fields[i].visibility).to_equal(Visibility.Public)

fn _sr_expect_layout(layout: TypeLayout, names: [text], offsets: [i64], sizes: [i64], field_aligns: [i64], total: i64, alignment: i64):
    expect(layout.size).to_equal(total)
    expect(layout.align).to_equal(alignment)
    expect(layout.stride).to_equal(total)
    if layout.fields.len() != names.len():
        fail("Expected {names.len()} layout fields, got {layout.fields.len()}")
        return
    for i in 0..names.len():
        expect(layout.fields[i].name).to_equal(names[i])
        expect(layout.fields[i].offset).to_equal(offsets[i])
        expect(layout.fields[i].size).to_equal(sizes[i])
        expect(layout.fields[i].align).to_equal(field_aligns[i])

describe "Struct field reorder through the production layout API":
    it "should reorder fields by descending size without altering the declaration input":
        step("Construct four HIR fields with independently known primitive sizes")
        val fields = _sr_fields()
        step("Reorder through the public API and preserve field identities")
        val ordered = reorder_fields_by_size(fields)
        _sr_expect_order(ordered, ["wide", "word", "half", "byte"], [2, 4, 3, 1])
        _sr_expect_order(fields, ["byte", "wide", "half", "word"], [1, 2, 3, 4])

    it "should preserve declaration order among equal-size fields":
        step("Interleave equal-size integer and boolean fields")
        val fields = [_sr_field("byte_a", 1, _sr_int(8, false)),
            _sr_field("word_a", 2, _sr_int(32, true)),
            _sr_field("word_b", 3, _sr_int(32, false)),
            _sr_field("bool_b", 4, _sr_type(HirTypeKind.Bool))]
        step("Require both equal-size groups to retain their original ordering")
        val ordered = reorder_fields_by_size(fields)
        _sr_expect_order(ordered, ["word_a", "word_b", "byte_a", "bool_b"], [2, 3, 1, 4])

    it "should compute a reordered naturally aligned Simple layout":
        step("Compute default Simple layout from the mixed-size declarations")
        val layout = compute_struct_layout(_sr_fields(), _sr_attr(TypeLayoutKind.Simple, false, false))
        _sr_expect_layout(layout, ["wide", "word", "half", "byte"], [0, 8, 12, 14], [8, 4, 2, 1], [8, 4, 2, 1], 16, 8)

    it "should preserve declaration order when Simple preserve_order is requested":
        step("Compute a Simple layout with the preserve-order attribute")
        val layout = compute_struct_layout(_sr_fields(), _sr_attr(TypeLayoutKind.Simple, true, false))
        _sr_expect_layout(layout, ["byte", "wide", "half", "word"], [0, 8, 16, 20], [1, 8, 2, 4], [1, 8, 2, 4], 24, 8)

    it "should preserve C declaration order independently of Simple-only flags":
        step("Select C layout even with preserve_order false and compactq true")
        val layout = compute_struct_layout(_sr_fields(), _sr_attr(TypeLayoutKind.C, false, true))
        _sr_expect_layout(layout, ["byte", "wide", "half", "word"], [0, 8, 16, 20], [1, 8, 2, 4], [1, 8, 2, 4], 24, 8)

    it "should reorder compactq fields and remove all alignment padding":
        step("Compute compactq Simple layout without preserve_order")
        val layout = compute_struct_layout(_sr_fields(), _sr_attr(TypeLayoutKind.Simple, false, true))
        _sr_expect_layout(layout, ["wide", "word", "half", "byte"], [0, 8, 12, 14], [8, 4, 2, 1], [1, 1, 1, 1], 15, 1)

    it "should combine compactq packing with explicit declaration-order preservation":
        step("Compute compactq Simple layout with preserve_order")
        val layout = compute_struct_layout(_sr_fields(), _sr_attr(TypeLayoutKind.Simple, true, true))
        _sr_expect_layout(layout, ["byte", "wide", "half", "word"], [0, 1, 9, 11], [1, 8, 2, 4], [1, 1, 1, 1], 15, 1)

    it "should change pointer ordering with the selected architecture while preserving equal-size ties":
        step("Place a pointer before a 64-bit integer in the declarations")
        val pointer = _sr_type(HirTypeKind.Ptr(inner: _sr_int(8, false), mutable: false))
        val fields = [_sr_field("pointer", 1, pointer), _sr_field("wide", 2, _sr_int(64, false)), _sr_field("byte", 3, _sr_int(8, false))]
        step("Require 32-bit sorting to move the wide integer before the pointer")
        val x86 = reorder_fields_by_size_for_arch(fields, TargetArch.X86)
        _sr_expect_order(x86, ["wide", "pointer", "byte"], [2, 1, 3])
        step("Require the 64-bit pointer/integer tie to retain declaration order")
        val x64 = reorder_fields_by_size_for_arch(fields, TargetArch.X86_64)
        _sr_expect_order(x64, ["pointer", "wide", "byte"], [1, 2, 3])

    it "should compute architecture-specific pointer offsets and integer alignment":
        step("Compute the same pointer-bearing declarations on 32-bit and 64-bit targets")
        val pointer = _sr_type(HirTypeKind.Ptr(inner: _sr_int(8, false), mutable: false))
        val fields = [_sr_field("pointer", 1, pointer), _sr_field("wide", 2, _sr_int(64, false)), _sr_field("byte", 3, _sr_int(8, false))]
        val attr = _sr_attr(TypeLayoutKind.Simple, false, false)
        val x86 = compute_struct_layout_for_arch(fields, attr, TargetArch.X86)
        _sr_expect_layout(x86, ["wide", "pointer", "byte"], [0, 8, 12], [8, 4, 1], [4, 4, 1], 16, 4)
        val x64 = compute_struct_layout_for_arch(fields, attr, TargetArch.X86_64)
        _sr_expect_layout(x64, ["pointer", "wide", "byte"], [0, 8, 16], [8, 8, 1], [8, 8, 1], 24, 8)

    it "should return empty zero-size layouts without inventing fields":
        step("Reorder and lay out an empty declaration on default and target-aware paths")
        val fields: [HirField] = []
        val ordered = reorder_fields_by_size(fields)
        _sr_expect_order(ordered, [], [])
        val attr = _sr_attr(TypeLayoutKind.Simple, false, false)
        val layout = compute_struct_layout(fields, attr)
        _sr_expect_layout(layout, [], [], [], [], 0, 1)
        val target_layout = compute_struct_layout_for_arch(fields, attr, TargetArch.X86)
        _sr_expect_layout(target_layout, [], [], [], [], 0, 1)
        val packed = compute_struct_layout(fields, _sr_attr(TypeLayoutKind.Packed, false, false))
        _sr_expect_layout(packed, [], [], [], [], 0, 1)

    it "should retain a singleton identity and distinguish natural from packed alignment":
        step("Reorder one 16-bit field and compute natural and explicitly packed layout")
        val fields = [_sr_field("only", 7, _sr_int(16, false))]
        val ordered = reorder_fields_by_size(fields)
        _sr_expect_order(ordered, ["only"], [7])
        val natural = compute_struct_layout(fields, _sr_attr(TypeLayoutKind.Simple, false, false))
        _sr_expect_layout(natural, ["only"], [0], [2], [2], 2, 2)
        val packed = compute_struct_layout(fields, _sr_attr(TypeLayoutKind.Packed, false, false))
        _sr_expect_layout(packed, ["only"], [0], [2], [1], 2, 1)
