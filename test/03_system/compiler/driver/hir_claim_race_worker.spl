# Helper process for hir_shard_recovery_spec: claim one shard, record the verdict.
# args: <queue> <owner> <path>
use compiler.driver.driver_hir_recovery.{hir_shard_recovery_claim}
use std.io_runtime.{get_args, file_write}

fn main():
    val args = get_args()
    val n = args.len()
    val queue = args[n - 3]
    val owner = args[n - 2]
    val path = args[n - 1]
    val verdict = hir_shard_recovery_claim(queue, owner, path, "race-key")
    file_write("{queue}/verdict-{owner}.txt", "{verdict}")

main()
