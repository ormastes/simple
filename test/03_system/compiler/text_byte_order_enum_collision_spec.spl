# Purpose and audience: executable specification evidence for the owning engineering team.
# @req REQ-SSPEC-SYSTEM
# design: doc/05_design/abstract_external_text.md ; doc/05_design/host_text_boundary_v1.md

"""The codec byte-order enum must not collide with `std.common.binary_io.ByteOrder`.

Both the seed interpreter and native lowering resolve enum variants by the
enum's bare name, so two modules declaring `enum ByteOrder` with different
variants made `text_session`'s then-`ByteOrder.NotApplicable` (now
`TextByteOrder`) fail whenever `binary_io` was also loaded — always, under
`native-build`, because the driver imports it.
"""

use std.spec.step

use std.spec.*
use std.io_runtime.{dir_create_all, remove_file_if_exists, shell}

val FIXTURE = "test/fixtures/native_text_byte_order_collision/main.spl"
val BUILD_DIR = "build/text_byte_order_enum_collision"
val BINARY_PATH = BUILD_DIR + "/main"

describe "codec byte order vs binary_io ByteOrder":
    # @manual scenario evidence
    it "interprets a program that loads both enums":
        # @req REQ-SSPEC-SYSTEM
        step("Run the io_runtime-then-binary_io probe in the interpreter")
        val ran = shell("bin/simple run " + FIXTURE)
        expect(ran.stderr.contains("unknown variant or method")).to_equal(false)
        expect(ran.exit_code).to_equal(0)
        expect(ran.stdout.trim()).to_equal("42")

    # @manual scenario evidence
    it "native-builds and runs a program that writes and reads a file":
        # @req REQ-SSPEC-SYSTEM
        step("Compile the probe natively")
        expect(dir_create_all(BUILD_DIR)).to_equal(true)
        expect(remove_file_if_exists(BINARY_PATH)).to_equal(true)
        val compiled = shell("bin/simple native-build " + FIXTURE + " -o " + BINARY_PATH)
        expect(compiled.stderr.contains("unknown variant or method")).to_equal(false)
        expect(compiled.exit_code).to_equal(0)
        step("Run the native artifact")
        val ran = shell(BINARY_PATH)
        expect(ran.exit_code).to_equal(0)
        expect(ran.stdout.trim()).to_equal("42")
