# Cross-engine MC/DC semantic-vector fixture.
# The fixed-width output is deliberately allocation-bounded and contains no
# engine-specific branch. The gate supplies and records engine/policy identity.

fn emit_and_or(a: bool, b: bool, c: bool):
    var evaluated = "1"
    var truths = if a: "1" else: "0"
    var outcome = false
    if a:
        evaluated = evaluated + "1"
        truths = truths + (if b: "1" else: "0")
        if b:
            evaluated = evaluated + "0"
            truths = truths + "0"
            outcome = true
        else:
            evaluated = evaluated + "1"
            truths = truths + (if c: "1" else: "0")
            outcome = c
    else:
        evaluated = evaluated + "00"
        truths = truths + "00"
    print "vector=0x8f613de1c5a90001|evaluated={evaluated}|true={truths}|outcome={if outcome: 1 else: 0}"

fn emit_or_and(a: bool, b: bool, c: bool):
    var evaluated = "1"
    var truths = if a: "1" else: "0"
    var outcome = true
    if a:
        evaluated = evaluated + "00"
        truths = truths + "00"
    else:
        evaluated = evaluated + "1"
        truths = truths + (if b: "1" else: "0")
        if not b:
            evaluated = evaluated + "0"
            truths = truths + "0"
            outcome = false
        else:
            evaluated = evaluated + "1"
            truths = truths + (if c: "1" else: "0")
            outcome = c
    print "vector=0x8f613de1c5a90002|evaluated={evaluated}|true={truths}|outcome={if outcome: 1 else: 0}"

print "schema=mcdc-cross-engine-vectors-v1"
print "decision=0x8f613de1c5a90001|conditions=3|expression=a&&(b||c)"
print "decision=0x8f613de1c5a90002|conditions=3|expression=a||(b&&c)"
emit_and_or(false, false, false)
emit_and_or(true, true, false)
emit_and_or(true, false, false)
emit_and_or(true, false, true)
emit_or_and(true, false, false)
emit_or_and(false, false, false)
emit_or_and(false, true, false)
emit_or_and(false, true, true)
