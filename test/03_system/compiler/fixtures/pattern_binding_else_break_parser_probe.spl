# Regression: a refutable `val Some(...)` binding accepts a diverging inline
# `else:` arm. The freestanding WM closure uses this exact grammar in its
# environment expansion path.

fn main():
    val value: i64? = 41
    while true:
        val Some(unwrapped) = value else: break
        print "PATTERN_BINDING_ELSE_BREAK_PASS {unwrapped}"
        break
