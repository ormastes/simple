use std.gc_async_mut.gpu.browser_engine.simple_web_html_layout_renderer.{
    simple_web_layout_render_html_software_result,
    simple_web_material_fallback_realized
}

fn fallback_valid(label: text, html: text) -> bool:
    print "WEB_MATERIAL_FALLBACK_CSS_STATE_STAGE {label} software-start"
    val software = simple_web_layout_render_html_software_result(html, 24, 16)
    print "WEB_MATERIAL_FALLBACK_CSS_STATE_STAGE {label} software-done"
    software.material_fallback.kind == "solid-material" and software.material_fallback.material_sha256.len() == 64

fn fallback_rejected(label: text, html: text) -> bool:
    print "WEB_MATERIAL_FALLBACK_CSS_STATE_STAGE {label} software-start"
    val software = simple_web_layout_render_html_software_result(html, 24, 16)
    print "WEB_MATERIAL_FALLBACK_CSS_STATE_STAGE {label} software-done"
    # An invalid declaration must produce neither a material kind nor a
    # digest. The renderer emits one bounded rejection receipt for this
    # declared node; callers must not turn that diagnostic into provenance.
    software.material_fallback.kind == "none" and software.material_fallback.material_sha256 == ""

fn main():
    val plain = "<div data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' data-wm-theme-fg='#FEDCBA' style='width:24px;height:16px;background:rgba(255,0,0,0.2);backdrop-filter:blur(12px)'>plain</div>"
    val multilayer = "<div data-wm-theme-fallback='solid-material' data-wm-theme-bg='#123456' data-wm-theme-fg='#FEDCBA' style='width:24px;height:16px;background:radial-gradient(circle,#FF0000,#0000FF),rgba(255,0,0,0.2);backdrop-filter:blur(12px)'>multilayer</div>"
    val malformed = "<div data-wm-theme-fallback='Solid-Material' data-wm-theme-bg='#123456' data-wm-theme-fg='#FEDCBA' style='width:24px;height:16px;background:#123456'>malformed</div>"
    val strict_contract = simple_web_material_fallback_realized(true, 0xFF123456u32, 0u32, 0u32, "") and
        not simple_web_material_fallback_realized(true, 0x7F123456u32, 0u32, 0u32, "") and
        not simple_web_material_fallback_realized(true, 0xFF123456u32, 0xFF000000u32, 0u32, "") and
        not simple_web_material_fallback_realized(true, 0xFF123456u32, 0u32, 0u32, "url(material.png)") and
        not simple_web_material_fallback_realized(false, 0xFF123456u32, 0u32, 0u32, "")
    if strict_contract and fallback_valid("plain", plain) and fallback_valid("multilayer", multilayer) and fallback_rejected("malformed", malformed):
        print "WEB_MATERIAL_FALLBACK_CSS_STATE_PASS"
    else:
        print "WEB_MATERIAL_FALLBACK_CSS_STATE_FAIL"
