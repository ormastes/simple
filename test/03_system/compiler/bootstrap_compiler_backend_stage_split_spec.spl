# @cover src/compiler/70.backend/backend/c_backend_bootstrap_guard.spl 0%
# codex-system-test
"""# Bootstrap compiler/backend stage split

This contract manual freezes the post-migration stage boundaries while the
current bootstrap remains canonical. It does not claim that the future runner
or its artifacts exist. Live artifact, sabotage, and equivalence acceptance
remain blocked until one legacy end-to-end bootstrap has an admitted receipt.
"""

use std.io.{file_read}
use std.spec.{describe, it, expect, step}

val REQUIREMENTS = "doc/02_requirements/feature/bootstrap_compiler_backend_stage_split.md"
val NFR = "doc/02_requirements/nfr/bootstrap_compiler_backend_stage_split.md"
val ARCHITECTURE = "doc/04_architecture/compiler/bootstrap_compiler_backend_stage_split.md"
val DESIGN = "doc/05_design/compiler/bootstrap_compiler_backend_stage_split.md"
val PLAN = "doc/03_plan/sys_test/bootstrap_compiler_backend_stage_split.md"
val LEGACY_PRODUCER = "scripts/bootstrap/bootstrap-from-scratch.sh"
val LEGACY_PROVENANCE = "scripts/check/lib/stage4-candidate-provenance.shs"

describe "Bootstrap compiler/backend stage split contract":
    describe "REQ-BSPLIT-001/002/003: unchanged canonical compiler stages":
        it "should bind the Rust seed to unchanged canonical Stage 2 and Stage 3 compiler builds":
            # @req: REQ-BSPLIT-001, REQ-BSPLIT-002, REQ-BSPLIT-003
            step("Inspect the selected compiler-stage chain")
            val requirements = file_read(REQUIREMENTS)
            val architecture = file_read(ARCHITECTURE)
            expect(requirements).to_contain("Stage 1: Rust builds the bootstrap Simple seed")
            expect(requirements).to_contain("Stage 2 preserves the pre-migration canonical pure-Simple")
            expect(requirements).to_contain("Stage 3 preserves the pre-migration canonical pure-Simple")
            expect(architecture).to_contain("Rust authority -> Stage 1 Simple seed")
            expect(architecture).to_contain("Stage 2 canonical pure-Simple compiler (unchanged configuration)")
            expect(architecture).to_contain("Stage 3 canonical pure-Simple compiler (unchanged configuration)")

        it "should require typed identity and hashes at every compiler boundary":
            # @req: REQ-BSPLIT-001, REQ-BSPLIT-002, REQ-BSPLIT-003
            step("Inspect the compiler receipt identity fields")
            val requirements = file_read(REQUIREMENTS)
            val design = file_read(DESIGN)
            expect(requirements).to_contain("source, producer, backend, target")
            expect(requirements).to_contain("compiler/runtime ABI")
            expect(requirements).to_contain("content hashes")
            expect(design).to_contain("compiler-core archive")
            expect(design).to_contain("public interface manifest")
            expect(design).to_contain("runtime archive")

        it "should fail closed rather than substitute a different backend or producer":
            # @req: REQ-BSPLIT-001, REQ-BSPLIT-002, REQ-BSPLIT-003
            step("Inspect backend and producer rejection obligations")
            val nfr = file_read(NFR)
            val architecture = file_read(ARCHITECTURE)
            expect(nfr).to_contain("mismatch fails before tool compilation")
            expect(architecture).to_contain("backend/target, and producer")
            expect(architecture).to_contain("invalidates Stage 3")

    describe "REQ-BSPLIT-004/005: tools-only Stage 4":
        it "should compile tool-owned modules and zero compiler-source units":
            # @req: REQ-BSPLIT-004, REQ-BSPLIT-005
            step("Inspect the tools-only compilation boundary")
            val requirements = file_read(REQUIREMENTS)
            val design = file_read(DESIGN)
            expect(requirements).to_contain("Stage 4 compiles only tool-owned modules")
            expect(requirements).to_contain("compiler-source compile units")
            expect(design).to_contain("stage4_compiler_files` (zero)")

        it "should link the exact versioned Stage 3 interface and archives":
            # @req: REQ-BSPLIT-004, REQ-BSPLIT-005
            step("Inspect exact artifact binding")
            val requirements = file_read(REQUIREMENTS)
            val architecture = file_read(ARCHITECTURE)
            expect(requirements).to_contain("versioned compiler archive/interface")
            expect(requirements).to_contain("stale cache hits are not authority")
            expect(architecture).to_contain("ToolingLinkReceiptV1")
            expect(architecture).to_contain("compiler_sources_compiled = 0")

        it "should reject compiler traversal and every mismatched authority":
            # @req: REQ-BSPLIT-004, REQ-BSPLIT-005
            step("Inspect Stage 4 fail-closed discovery and link checks")
            val architecture = file_read(ARCHITECTURE)
            val design = file_read(DESIGN)
            expect(architecture).to_contain("Stage 4 cannot traverse compiler sources")
            expect(architecture).to_contain("compiler, runtime, loader")
            expect(design).to_contain("rooted under `src/compiler`")
            expect(design).to_contain("Linking verifies all archive and interface hashes")

        it "should admit built tool execution only from the exact Stage 3 identity":
            # @req: REQ-BSPLIT-004, REQ-BSPLIT-005
            step("Inspect built-tool execution and compiler identity acceptance")
            val plan = file_read(PLAN)
            expect(plan).to_contain("exact Stage-3 compiler identity")
            expect(plan).to_contain("built tool executable")
            expect(plan).to_contain("ToolingLinkReceiptV1")
            expect(plan).to_contain("Rust seed, fake compiler, stale compiler")

    describe "REQ-BSPLIT-006/007: gated migration and audit equivalence":
        it "should keep the legacy pipeline canonical until an admitted success":
            # @req: REQ-BSPLIT-006, REQ-BSPLIT-007
            step("Inspect the migration admission gate")
            val requirements = file_read(REQUIREMENTS)
            val plan = file_read(PLAN)
            expect(requirements).to_contain("existing pipeline remains canonical")
            expect(requirements).to_contain("one admitted end-to-end success")
            expect(plan).to_contain("Migration stays fail-fast")

        it "should retain a full rebuild only as an audit equivalence lane":
            # @req: REQ-BSPLIT-006, REQ-BSPLIT-007
            step("Inspect normal-path and audit-path separation")
            val requirements = file_read(REQUIREMENTS)
            val architecture = file_read(ARCHITECTURE)
            expect(requirements).to_contain("clean full rebuild remains an audit/equivalence command")
            expect(architecture).to_contain("full rebuild remains a separate equivalence lane")

        it "should preserve legacy provenance gates until live split evidence exists":
            # @req: REQ-BSPLIT-006, REQ-BSPLIT-007
            step("Inspect the currently authoritative Stage 4 provenance checks")
            val producer = file_read(LEGACY_PRODUCER)
            val provenance = file_read(LEGACY_PROVENANCE)
            expect(producer).to_contain("stage4_write_candidate_provenance")
            expect(provenance).to_contain("bootstrap_stage3_verify_manifest")
            expect(provenance).to_contain("parent_compiler_sha256")
            expect(provenance).to_contain("build_log_sha256")
            expect(provenance).to_contain("essential_tools_log_sha256")

    describe "REQ-BSPLIT-008/009/010/011: complete runtime authority":
        it "should bind an exact runtime symbol manifest before tool linking":
            # @req: REQ-BSPLIT-008, REQ-BSPLIT-009
            step("Inspect runtime-authority manifest and missing-symbol behavior")
            val architecture = file_read(ARCHITECTURE)
            val design = file_read(DESIGN)
            expect(architecture).to_contain("canonical required-symbol manifest")
            expect(design).to_contain("RuntimeRequiredSymbolsV1")
            expect(design).to_contain("missing-required-runtime-symbol:<name>")

        it "should reject hosted or stub runtime substitution":
            # @req: REQ-BSPLIT-009, REQ-BSPLIT-010
            step("Inspect runtime fallback prohibition")
            val architecture = file_read(ARCHITECTURE)
            val design = file_read(DESIGN)
            expect(architecture).to_contain("Hosted providers, generated unresolved-symbol stubs")
            expect(design).to_contain("hosted fallback")
            expect(design).to_contain("unresolved-symbol fabrication")

        it "should probe tool identity only after successful link and receipt validation":
            # @req: REQ-BSPLIT-011
            step("Inspect post-link tool identity ordering")
            val requirements = file_read(REQUIREMENTS)
            val architecture = file_read(ARCHITECTURE)
            expect(requirements).to_contain("only after")
            expect(requirements).to_contain("runtime-authority receipt validation")
            expect(architecture).to_contain("probes run only")
            expect(architecture).to_contain("ToolingLinkReceiptV1")
