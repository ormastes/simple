# codex-system-test
# @manual: primary
# @evidence-display: links
# @req REQ-PARSE-OWNER-001
# @req REQ-PARSE-OWNER-002
# @req REQ-PARSE-OWNER-003
"""# Coverage-aware retained parser ownership

Compile the actual regression fixture once with the canonical source-matched
pure-Simple CLI, then run each policy in a fresh native process. Missing
producer provenance or a failed compile is a failure, never a skipped pass.
This is native ownership evidence; the whole-build RSS gate remains separate.
"""
use std.spec.{describe, it, expect, step, fail}
use std.nogc_sync_mut.io.process_ops.{process_run_bounded}
use std.nogc_sync_mut.io.file_ops.{file_exists, file_write, file_hash_sha256}
use std.nogc_sync_mut.io.dir_ops.{dir_create_all}
use std.nogc_sync_mut.io.env_ops.{env_get}
use std.nogc_sync_mut.io.sysinfo_ops.{getpid}
use std.nogc_sync_mut.io.time_ops.{time_now_unix_micros}
use test.system.qualified_pure_simple_runtime.{admit_source_matched_pure_simple_runtime}

val PROBE_SOURCE = "test/02_integration/compiler/coverage_retained_parse_owner_probe.spl"
var coverage_probe_attempted = false
var coverage_probe_binary = ""
var coverage_probe_digest = ""
var coverage_probe_artifacts = ""

# @inline
fn prepare_coverage_owner_probe() -> text:
    # A failed preparation is never retried by subsequent scenarios.
    if coverage_probe_attempted:
        if coverage_probe_binary == "": fail("native probe preparation previously failed")
        return coverage_probe_binary
    coverage_probe_attempted = true
    # This is an environment policy, not a native-build CLI option.
    if env_get("SIMPLE_NO_STUB_FALLBACK") != "1":
        fail("native ownership evidence requires SIMPLE_NO_STUB_FALLBACK=1")
        return ""
    val producer = admit_source_matched_pure_simple_runtime()
    if producer == "": return ""
    val producer_digest = file_hash_sha256(producer)
    val source_digest = file_hash_sha256(PROBE_SOURCE)
    val artifacts = "build/test-artifacts/coverage-retained-parse-owner-{getpid()}-{time_now_unix_micros()}"
    if not dir_create_all(artifacts):
        fail("cannot create private native probe artifacts")
        return ""
    val candidate = artifacts + "/coverage_retained_parse_owner_probe"
    val (out, err, code) = process_run_bounded(producer, [
        "native-build", "--source", "src/compiler", "--source", "src/lib",
        "--source", PROBE_SOURCE, "--entry", PROBE_SOURCE, "--entry-closure",
        "--backend=cranelift", "--mode=dynload", "--threads", "1",
        "--cache-dir", artifacts + "/cache", "--output", candidate
    ], 1200000, 8388608)
    expect(file_write(artifacts + "/compile.stdout.log", out)).to_equal(true)
    expect(file_write(artifacts + "/compile.stderr.log", err)).to_equal(true)
    expect(code).to_equal(0)
    if code != 0 or not file_exists(candidate):
        fail("native probe compile failed; retained logs: " + artifacts)
        return ""
    if producer_digest.len() != 64 or source_digest.len() != 64 or
            file_hash_sha256(producer) != producer_digest or
            file_hash_sha256(PROBE_SOURCE) != source_digest:
        fail("producer or probe source changed during native compilation")
        return ""
    val digest = file_hash_sha256(candidate)
    if digest.len() != 64:
        fail("cannot hash actual native probe")
        return ""
    expect(file_write(artifacts + "/identity.sdn",
        "schema: coverage-retained-parse-owner-evidence\n" +
        "producer_sha256: {producer_digest}\n" +
        "source_sha256: {source_digest}\n" +
        "probe_sha256: {digest}\ncompile_exit: {code}\n")).to_equal(true)
    coverage_probe_artifacts = artifacts
    coverage_probe_digest = digest
    coverage_probe_binary = candidate
    candidate

# @inline
fn check_coverage_owner_policy(mode: text):
    val candidate = prepare_coverage_owner_probe()
    expect(candidate.len()).to_be_greater_than(0)
    if candidate == "": return
    expect(file_hash_sha256(candidate)).to_equal(coverage_probe_digest)
    val (out, err, code) = process_run_bounded(candidate, [mode], 120000, 1048576)
    val label = mode.substring(2, mode.len())
    expect(file_write(coverage_probe_artifacts + "/" + label + ".stdout.log", out)).to_equal(true)
    expect(file_write(coverage_probe_artifacts + "/" + label + ".stderr.log", err)).to_equal(true)
    expect(file_write(coverage_probe_artifacts + "/" + label + ".sdn",
        "schema: coverage-retained-parse-owner-run\nmode: {label}\n" +
        "probe_sha256: {coverage_probe_digest}\nexit_code: {code}\n")).to_equal(true)
    expect(code).to_equal(0)
    expect(out).to_contain("coverage_retained_parse_owner=PASS mode={mode} modules=4 replay=1")
    expect(out.contains("coverage_retained_parse_owner=FAIL")).to_equal(false)
    expect(file_hash_sha256(candidate)).to_equal(coverage_probe_digest)

describe "Coverage-aware retained parser ownership":
    it "should retain coverage evidence and bodies after each source scope closes":
        # @req REQ-PARSE-OWNER-001
        # @req REQ-PARSE-OWNER-002
        # @req REQ-PARSE-OWNER-003
        step("Admit the source-matched producer and compile the native ownership probe once")
        step("Parse four coverage-enabled sources, replay the first, and recover from a malformed source")
        check_coverage_owner_policy("--coverage")

    # @prev("should retain coverage evidence and bodies after each source scope closes")
    it "should preserve MC/DC obligations and contexts across source reclamation":
        # @req REQ-PARSE-OWNER-001
        # @req REQ-PARSE-OWNER-002
        # @req REQ-PARSE-OWNER-003
        step("Run the same native probe in a fresh MC/DC-enabled process")
        step("Require original row survival, exact replay semantics, and diagnostic recovery")
        check_coverage_owner_policy("--mcdc")

    # @prev("should retain coverage evidence and bodies after each source scope closes")
    it "should retain full-inventory target receipts and reject missing source authority":
        # @req REQ-PARSE-OWNER-001
        # @req REQ-PARSE-OWNER-002
        # @req REQ-PARSE-OWNER-003
        step("Run the native probe with full-inventory target selection and MC/DC enabled")
        step("Validate retained target receipts, missing-authority rejection, and malformed-source recovery")
        check_coverage_owner_policy("--full-inventory")
