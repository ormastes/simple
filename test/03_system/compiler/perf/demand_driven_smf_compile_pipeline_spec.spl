# codex-system-test
# @manual: primary
# @req REQ-001 REQ-002 REQ-003 REQ-004 REQ-005 REQ-006 REQ-007 REQ-008 REQ-009 REQ-010 REQ-011 REQ-012 REQ-013 REQ-014 REQ-015 REQ-016 REQ-017 REQ-018 REQ-019 REQ-020 DDSM-PLAN-P0 DDSM-PLAN-P1 DDSM-PLAN-P2 DDSM-PLAN-P3 DDSM-PLAN-P4 DDSM-PLAN-P5 DDSM-PLAN-P6 DDSM-PLAN-P7 DDSM-PLAN-P8 DDSM-PLAN-P9 DDSM-STOP-001 DDSM-STOP-002 DDSM-STOP-003 DDSM-STOP-004 DDSM-STOP-005
# @evidence-display: links
use std.spec.*
use std.io_runtime.{process_run}

fn require_pipeline_evidence(scenario: text, marker: text):
    val (output, errors, status) = process_run(
        "/bin/sh", ["scripts/check/check-demand-driven-smf-compile-pipeline.shs", "--scenario", scenario])
    expect(status).to_equal(0)
    expect(errors).to_equal("")
    expect(output).to_contain("scenario=" + scenario)
    expect(output).to_contain(marker)

describe "demand-driven SMF compile pipeline":
    describe "canonical archives and package commands":
        it "should expose independently verified SMF sections for DDSM-REQ-001":
            step("Read and verify every canonical SMF section independently")
            require_pipeline_evidence("sectioned-archive", "independent_section_checks=true")

        it "should resolve package and explicit-file command forms for DDSM-REQ-002":
            step("Run build, check, run, and test through package and file forms")
            require_pipeline_evidence("package-command-resolution", "all_command_forms_compatible=true")

        it "should avoid recursive source scans on warm operations for DDSM-REQ-003":
            step("Run a warm package operation with unrelated roots unreadable")
            require_pipeline_evidence("warm-index-only", "recursive_scan_count=0")

        it "should bound import discovery before body parsing for DDSM-REQ-004":
            step("Resolve imports from an SMF header or bounded source head")
            require_pipeline_evidence("bounded-import-head", "body_parse_count=0")

        it "should preserve explicit single-file compatibility for DDSM-REQ-017":
            step("Compile a single file and reject ambiguous implicit discovery")
            require_pipeline_evidence("single-file-compatibility", "ambiguous_scan_started=false")

    describe "lazy semantic materialization":
        it "should materialize import facts only on semantic demand for DDSM-REQ-005":
            step("Request metadata, body, MIR, and native facts independently")
            require_pipeline_evidence("lazy-import-materialization", "unrequested_section_reads=0")

        it "should reject unresolved proxies before MIR for DDSM-REQ-006":
            step("Inject an unresolved metadata proxy at MIR admission")
            require_pipeline_evidence("mir-proxy-rejection", "mir_started=false")

        it "should close only requested HIR operations for DDSM-REQ-007":
            step("Concretize the minimum HIR demand closure")
            require_pipeline_evidence("hir-demand-closure", "unrequested_body_count=0")

        it "should share generic baseline bodies by ABI layout for DDSM-REQ-013":
            step("Compile equivalent generic layout shapes")
            require_pipeline_evidence("generic-shape-sharing", "duplicate_baseline_bodies=0")

    describe "shared scheduling and cache authority":
        it "should serve all compiler clients from one scheduler for DDSM-REQ-008":
            step("Submit compiler, test, MCP, LSP, and optimizer actions")
            require_pipeline_evidence("shared-artifact-service", "profiles_served=compiler,test,mcp,lsp,optimizer")

        it "should schedule persisted actions deterministically for DDSM-REQ-009":
            step("Exercise dynamic edges, SCCs, cancellation, budgets, and restat")
            require_pipeline_evidence("persisted-action-graph", "repeat_schedule_digest_match=true")

        it "should keep host-shared CAS as canonical authority for DDSM-REQ-010":
            step("Restart the daemon and resolve artifacts from project-namespaced CAS")
            require_pipeline_evidence("host-shared-cas-authority", "daemon_memory_authoritative=false")

        it "should precompile runtime and standard-library archives for DDSM-REQ-012":
            step("Reuse runtime and standard-library SMFs until ABI identity changes")
            require_pipeline_evidence("precompiled-runtime-stdlib", "unnecessary_rebuild_count=0")

        it "should isolate foreground snapshots from background work for DDSM-REQ-016":
            step("Fail and race background promotion against a warm foreground hit")
            require_pipeline_evidence("background-isolation", "foreground_digest_unchanged=true")

    describe "backend and I/O behavior":
        it "should return a low-latency development artifact for DDSM-REQ-011":
            step("Request development compilation without explicit LLVM promotion")
            require_pipeline_evidence("development-backend", "foreground_llvm_count=0")

        it "should preserve synchronous source semantics over asynchronous I/O for DDSM-REQ-014":
            step("Exercise asynchronous file and stdio completion ordering")
            require_pipeline_evidence("async-io-sync-semantics", "semantic_output_match=true")

        it "should admit SIMD and refuse unproven GPU parsing for DDSM-REQ-015":
            step("Compare scalar, SIMD, and transfer-inclusive GPU parser evidence")
            require_pipeline_evidence("parser-acceleration-admission", "gpu_default=false")

        it "should expose one portable asynchronous file view for DDSM-REQ-018":
            step("Read identical immutable ranges through mapped and buffered transports")
            require_pipeline_evidence("portable-file-view", "range_semantics_match=true")

        it "should compile without mapped-file support for DDSM-REQ-019":
            step("Disable mapping and compile through buffered fallback")
            require_pipeline_evidence("mapping-unavailable", "compile_result_match=true")

        it "should enforce all file-read policies for DDSM-REQ-020":
            step("Exercise auto_map, must_map, prefer_map, and buffered policies")
            require_pipeline_evidence("file-read-policy-matrix", "policy_matrix_pass=true")

    describe "implementation phase gates":
        it "should freeze evidence interfaces before optimization for DDSM-PLAN-P0":
            step("Validate phase counters, matched fixtures, and frozen interfaces")
            require_pipeline_evidence("phase-0-interface-freeze", "phase_gate=pass")

        it "should publish complete sectioned archives for DDSM-PLAN-P1":
            step("Validate archive versioning, corruption rejection, and partial reads")
            require_pipeline_evidence("phase-1-smf-archives", "phase_gate=pass")

        it "should preserve package command compatibility for DDSM-PLAN-P2":
            step("Validate package defaults, explicit files, sources, and recursive opt-in")
            require_pipeline_evidence("phase-2-package-commands", "phase_gate=pass")

        it "should survive artifact-service restart and concurrency for DDSM-PLAN-P3":
            step("Validate profiles, leases, cancellation, framing, and CAS authority")
            require_pipeline_evidence("phase-3-artifact-service", "phase_gate=pass")

        it "should commit deterministic action-graph results for DDSM-PLAN-P4":
            step("Validate SCC scheduling, pools, single-flight, budgets, and restat")
            require_pipeline_evidence("phase-4-action-graph", "phase_gate=pass")

        it "should admit only closed lazy materialization for DDSM-PLAN-P5":
            step("Validate bounded heads, proxies, HIR demand, and MIR rejection")
            require_pipeline_evidence("phase-5-lazy-hir", "phase_gate=pass")

        it "should isolate asynchronous native promotion for DDSM-PLAN-P6":
            step("Validate development artifacts, precompiled SMFs, and promotion failure")
            require_pipeline_evidence("phase-6-backends", "phase_gate=pass")

        it "should prove generic shape-sharing break-even for DDSM-PLAN-P7":
            step("Validate shape dictionaries, specialization, accounting, and parity")
            require_pipeline_evidence("phase-7-generic-shapes", "phase_gate=pass")

        it "should prove transport-equivalent accelerated parsing for DDSM-PLAN-P8":
            step("Validate file views, async adapters, SIMD, and GPU admission")
            require_pipeline_evidence("phase-8-io-parser", "phase_gate=pass")

        it "should route every compiler entrypoint through one pipeline for DDSM-PLAN-P9":
            step("Validate CLI, test, MCP, LSP, IDE, and compatibility release gates")
            require_pipeline_evidence("phase-9-cutover", "phase_gate=pass")

    describe "cutover stop gates":
        it "should block cutover when a proxy reaches MIR for DDSM-STOP-001":
            step("Inject an unresolved proxy")
            require_pipeline_evidence("stop-unresolved-proxy", "cutover_allowed=false")

        it "should block cutover when correctness depends on a daemon for DDSM-STOP-002":
            step("Remove the daemon during an admitted build")
            require_pipeline_evidence("stop-daemon-correctness", "cutover_allowed=false")

        it "should block cutover after a warm recursive scan for DDSM-STOP-003":
            step("Detect an implicit recursive scan on a warm request")
            require_pipeline_evidence("stop-warm-recursive-scan", "cutover_allowed=false")

        it "should block mismatched background publication for DDSM-STOP-004":
            step("Publish a background artifact with the wrong semantic identity")
            require_pipeline_evidence("stop-background-identity", "cutover_allowed=false")

        it "should block default GPU parsing without crossover proof for DDSM-STOP-005":
            step("Enable default GPU parsing without transfer-inclusive evidence")
            require_pipeline_evidence("stop-gpu-default", "cutover_allowed=false")
