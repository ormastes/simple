use std.test.*
use std.fs

describe "Bootstrap centralized storage projection":
    it "keeps reusable and worktree-scoped producers under their authorities":
        val source = fs.read_text("scripts/bootstrap/lib/centralized-storage.shs")
        expect(source).to_contain("SIMPLE_USER_STORAGE_ROOT}/cache/compiler/bootstrap/v1")
        expect(source).to_contain("SIMPLE_WORKTREE_STORAGE_ROOT}/build/bootstrap")
        expect(source).to_contain("SIMPLE_WORKTREE_STORAGE_ROOT}/evidence/bootstrap")

    it "keeps explicit legacy output overrides receipt-visible":
        val source = fs.read_text("scripts/bootstrap/lib/centralized-storage.shs")
        expect(source).to_contain("output_source=%s")
        expect(source).to_contain("legacy-explicit-override")
        expect(source).to_contain("legacy_override=%s")

    it "does not introduce a Rust seed or weaken bootstrap admission":
        val projection = fs.read_text("scripts/bootstrap/lib/centralized-storage.shs")
        val bootstrap = fs.read_text("scripts/bootstrap/bootstrap-from-scratch.sh")
        expect(projection.contains("compiler_rust/target/bootstrap/simple")).to_be(false)
        expect(bootstrap).to_contain("bootstrap-planner-admission-bound.shs")
        expect(bootstrap).to_contain("SIMPLE_NO_STUB_FALLBACK")

    it "places ordinary native-build caches under user storage":
        val native_output = fs.read_text("src/compiler/80.driver/driver_aot_native_output.spl")
        val native_pipeline = fs.read_text("src/compiler/80.driver/driver_aot_pipeline.spl")
        val hir_cache = fs.read_text("src/compiler/80.driver/driver_hir_cache.spl")
        expect(native_output).to_contain("machine_cache_root(), \"native-build/v1\"")
        expect(native_pipeline).to_contain("machine_cache_root() + \"/native-build/v1\"")
        expect(hir_cache).to_contain("machine_cache_root()}/native-build/v1")
