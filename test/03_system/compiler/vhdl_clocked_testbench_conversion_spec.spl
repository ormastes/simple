# VHDL Clocked Testbench Conversion System Tests
#
# System-level tests for the clocked-domain testbench conversion pipeline.
# Covers ClockConfig, ResetSequence, CycleAdvance, TimingConstraint, and
# ClockedBench model classes, plus clocked VHDL shape requirements.
#
# @cover src/compiler/70.backend/backend/vhdl/vhdl_testbench_clock.spl 70%
# @cover src/compiler/70.backend/backend/vhdl/vhdl_testbench.spl 60%

"""
# VHDL Clocked Testbench Conversion System Specification

**Feature IDs:** #VHDL-PARITY-012
**Category:** Tooling
**Difficulty:** 3/5
**Status:** In Progress

## Purpose and audience
This spec is for compiler/backend engineers changing the VHDL clocked
testbench pipeline: the clock/reset/cycle/timing model classes in
`vhdl_testbench_clock.spl` and the deterministic renderer in
`vhdl_testbench.spl`. It pins the contract those two files must keep so a
refactor cannot silently change generated VHDL shape or model arithmetic.

## Operator workflow
Run `bin/simple test test/03_system/compiler/vhdl_clocked_testbench_conversion_spec.spl`
(or the equivalent `simple run` invocation on a deployed binary). All 46
scenarios call the real `ClockConfig`, `ResetSequence`, `CycleAdvance`,
`TimingConstraint`, and `ClockedBench` classes, or render a real testbench via
`render_vhdl_testbench` and inspect the returned VHDL text — none of them
assert against a value the scenario only just constructed for itself.

## Compatibility and limitations
This is a pure-model/pure-renderer spec: it never invokes GHDL or another
external VHDL simulator, so it says nothing about simulator-level acceptance
of the generated file. It also does not cover multi-DUT/multi-phase suites —
`render_vhdl_testbench_suite` — only the single-DUT `render_vhdl_testbench`
entry point used here.

## Verification guidance and troubleshooting
A failure in Groups 1-4 means the model classes' field defaults or arithmetic
changed. A failure in Group 5 means the generated VHDL shape changed (clock
process, reset assignment, entity/architecture declarations, DUT instance,
stimulus process, or assert statement) — diff the printed `testbench_vhdl`
against the expected substrings named in the failing scenario. A failure in
Group 6 means the reset-duration/latency contract computed from the model
classes no longer matches the pinned oracle.
"""

# Lifecycle: doc/01_research/hardware/vhdl/vhdl_backend_linux_rtl.md ;
# doc/03_plan/hardware/fpga/vhdl_testbench_conversion.md ;
# doc/04_architecture/hardware/vhdl/vhdl_support_matrix.md ;
# doc/05_design/compiler/misc/VHDL_BACKEND_DESIGN.md
# @manual_section: vhdl_clocked_testbench_conversion

use std.spec.step
use std.spec

use compiler.backend.backend.vhdl.vhdl_testbench_clock.{ClockConfig, ResetSequence, CycleAdvance, TimingConstraint}
use compiler.backend.backend.vhdl.vhdl_testbench.{VhdlTestbenchCase, VhdlTestbenchPort, VhdlTestbenchAssignment, VhdlTestbenchAssertion, render_vhdl_testbench}
use compiler.backend.backend.vhdl.vhdl_testbench_render.{ClockedBench}

# ===========================================================================
# Module-level helpers
# ===========================================================================
#
# These two functions have no equivalent product API: the VHDL literal used
# for an asserted/deasserted reset signal (`'0'`/`'1'` by polarity) is a
# documented convention (see module docstring above and
# doc/04_architecture/hardware/vhdl/vhdl_support_matrix.md), not a method on
# ResetSequence. Every scenario below feeds them a real ResetSequence field
# rather than a bare literal, so the scenario still exercises the real class.

fn reset_asserted_value(polarity: text) -> text:
    """Return the documented VHDL literal when reset is asserted."""
    if polarity == "active_low":
        return "'0'"
    "'1'"

fn reset_deasserted_value(polarity: text) -> text:
    """Return the documented VHDL literal when reset is deasserted."""
    if polarity == "active_low":
        return "'1'"
    "'0'"

fn clk_vhdl_has_clock_process(vhdl: text) -> bool:
    """Detect clock generator process in generated VHDL."""
    vhdl.contains("clock_driver") or vhdl.contains("clk_gen")

fn clk_vhdl_has_wait_for(vhdl: text, ns: text) -> bool:
    """Detect 'wait for N ns' timing statement in generated VHDL."""
    vhdl.contains("wait for " + ns + " ns")

fn clk_vhdl_has_reset_signal(vhdl: text, signal_name: text) -> bool:
    """Detect reset signal assignment in generated VHDL."""
    vhdl.contains(signal_name + " <=")

fn clk_vhdl_has_loop(vhdl: text) -> bool:
    """Detect the clock loop construct in generated VHDL."""
    vhdl.contains("loop")

fn clk_vhdl_has_entity(vhdl: text, name: text) -> bool:
    """Check testbench entity declaration exists."""
    vhdl.contains("entity " + name + " is")

fn clk_vhdl_has_arch(vhdl: text, name: text) -> bool:
    """Check testbench architecture declaration exists."""
    vhdl.contains("architecture sim of " + name)

fn clk_vhdl_has_instance(vhdl: text, dut: text) -> bool:
    """Check DUT component instance exists."""
    vhdl.contains("entity work." + dut)

fn clk_vhdl_has_stimulus(vhdl: text) -> bool:
    """Check stimulus process exists."""
    vhdl.contains("stimulus") and vhdl.contains("process")

fn clk_vhdl_has_assert(vhdl: text) -> bool:
    """Check at least one assert statement exists."""
    vhdl.contains("assert ")

fn render_sample_testbench_vhdl() -> text:
    """Render one real testbench via the product renderer, reused by Group 5."""
    val tb = VhdlTestbenchCase(
        testbench_name: "tb_counter",
        dut_entity: "counter",
        test_name: "count_test",
        test_source_line: 1,
        ports: [VhdlTestbenchPort(name: "count", direction: "out", type_name: "std_logic_vector(7 downto 0)", source_line: 1)],
        stimuli: [],
        assertions: [VhdlTestbenchAssertion(actual: "s_count", expected: "\"00000001\"", test_name: "count_test", expectation_index: 1, source_line: 1)],
        clock_name: "clk",
        reset_name: "rst_n",
        reset_asserted: "'0'"
    )
    render_vhdl_testbench(tb).testbench_vhdl

# ===========================================================================
# Test Group 1: ClockConfig
# ===========================================================================

describe "VHDL Clocked Testbench - ClockConfig":
    it "default clock has 10 ns period":
        # @req REQ-VHDL-CLK-001
        # @capture(bit_table): ClockConfig.default_clock().period_ns
        step("Construct the default ClockConfig")
        val clock = ClockConfig.default_clock()
        expect(clock.period_ns).to_equal(10)  # oracle: default_clock() documents a 10ns period

    it "default clock edge is rising":
        # @req REQ-VHDL-CLK-002
        # @capture(bit_table): ClockConfig.default_clock().is_rising()
        step("Construct the default ClockConfig and read its edge")
        val clock = ClockConfig.default_clock()
        expect(clock.is_rising()).to_equal(true)

    it "default clock domain name is clk":
        # @req REQ-VHDL-CLK-003
        # @capture(bit_table): ClockConfig.default_clock().domain_name
        step("Construct the default ClockConfig and read its domain name")
        val clock = ClockConfig.default_clock()
        expect(clock.domain_name).to_equal("clk")

    it "half period is half of full period":
        # @req REQ-VHDL-CLK-004
        # @capture(bit_table): ClockConfig.default_clock().half_period()
        step("Compute the half period of the default 10ns clock")
        val clock = ClockConfig.default_clock()
        expect(clock.half_period()).to_equal(5)  # oracle: half_period() = period_ns / 2 = 10 / 2

    it "half period of 20 ns clock is 10 ns":
        # @req REQ-VHDL-CLK-005
        # @capture(bit_table): ClockConfig.custom(...).half_period()
        step("Compute the half period of a 20ns custom clock")
        val clock = ClockConfig.custom("clk", 20, "rising")
        expect(clock.half_period()).to_equal(10)  # oracle: half_period() = period_ns / 2 = 20 / 2

    it "custom clock has custom period":
        # @req REQ-VHDL-CLK-006
        # @capture(bit_table): ClockConfig.custom(...).period_ns
        step("Construct a custom ClockConfig with a 4ns period")
        val clock = ClockConfig.custom("sys_clk", 4, "rising")
        expect(clock.period_ns).to_equal(4)  # oracle: constructor was given a 4ns period

    it "falling edge clock is not rising":
        # @req REQ-VHDL-CLK-007
        # @capture(bit_table): ClockConfig.custom(...).is_rising()
        step("Construct a falling-edge ClockConfig and read its edge")
        val clock = ClockConfig.custom("clk", 10, "falling")
        expect(clock.is_rising()).to_equal(false)

    it "custom clock domain name is preserved":
        # @req REQ-VHDL-CLK-008
        # @capture(bit_table): ClockConfig.custom(...).domain_name
        step("Construct a custom ClockConfig and read its domain name")
        val clock = ClockConfig.custom("sys_clk", 4, "rising")
        expect(clock.domain_name).to_equal("sys_clk")

# ===========================================================================
# Test Group 2: ResetSequence
# ===========================================================================

describe "VHDL Clocked Testbench - ResetSequence":
    it "async active-low reset is async":
        # @req REQ-VHDL-RST-001
        # @capture(bit_table): ResetSequence.async_low(...).is_async()/is_sync()
        step("Construct an async active-low ResetSequence")
        val reset = ResetSequence.async_low("rst_n", 2)
        expect(reset.is_async()).to_equal(true)
        expect(reset.is_sync()).to_equal(false)

    it "sync active-high reset is sync":
        # @req REQ-VHDL-RST-002
        # @capture(bit_table): ResetSequence.sync_high(...).is_sync()/is_async()
        step("Construct a sync active-high ResetSequence")
        val reset = ResetSequence.sync_high("rst", 2)
        expect(reset.is_sync()).to_equal(true)
        expect(reset.is_async()).to_equal(false)

    it "active-low polarity is detected":
        # @req REQ-VHDL-RST-003
        # @capture(bit_table): ResetSequence.async_low(...).is_active_low()
        step("Construct an active-low ResetSequence and read its polarity")
        val reset = ResetSequence.async_low("rst_n", 2)
        expect(reset.is_active_low()).to_equal(true)

    it "active-high polarity is detected":
        # @req REQ-VHDL-RST-004
        # @capture(bit_table): ResetSequence.sync_high(...).is_active_low()
        step("Construct an active-high ResetSequence and read its polarity")
        val reset = ResetSequence.sync_high("rst", 2)
        expect(reset.is_active_low()).to_equal(false)

    it "active-low asserted value is logic zero":
        # @req REQ-VHDL-RST-005
        # @capture(bit_table): reset_asserted_value(ResetSequence.async_low(...).polarity)
        step("Read the asserted VHDL literal for an active-low reset")
        val reset = ResetSequence.async_low("rst_n", 2)
        val v = reset_asserted_value(reset.polarity)
        expect(v).to_equal("'0'")

    it "active-low deasserted value is logic one":
        # @req REQ-VHDL-RST-006
        # @capture(bit_table): reset_deasserted_value(ResetSequence.async_low(...).polarity)
        step("Read the deasserted VHDL literal for an active-low reset")
        val reset = ResetSequence.async_low("rst_n", 2)
        val v = reset_deasserted_value(reset.polarity)
        expect(v).to_equal("'1'")

    it "active-high asserted value is logic one":
        # @req REQ-VHDL-RST-007
        # @capture(bit_table): reset_asserted_value(ResetSequence.sync_high(...).polarity)
        step("Read the asserted VHDL literal for an active-high reset")
        val reset = ResetSequence.sync_high("rst", 2)
        val v = reset_asserted_value(reset.polarity)
        expect(v).to_equal("'1'")

    it "active-high deasserted value is logic zero":
        # @req REQ-VHDL-RST-008
        # @capture(bit_table): reset_deasserted_value(ResetSequence.sync_high(...).polarity)
        step("Read the deasserted VHDL literal for an active-high reset")
        val reset = ResetSequence.sync_high("rst", 2)
        val v = reset_deasserted_value(reset.polarity)
        expect(v).to_equal("'0'")

    it "reset duration is preserved in duration_cycles field":
        # @req REQ-VHDL-RST-009
        # @capture(bit_table): ResetSequence.async_low(...).duration_cycles
        step("Construct a ResetSequence with 3 duration cycles")
        val reset = ResetSequence.async_low("rst_n", 3)
        expect(reset.duration_cycles).to_equal(3)  # oracle: constructor was given 3 cycles

# ===========================================================================
# Test Group 3: CycleAdvance and TimingConstraint
# ===========================================================================

describe "VHDL Clocked Testbench - CycleAdvance":
    it "cycle span is to_step minus from_step":
        # @req REQ-VHDL-CYC-001
        # @capture(bit_table): CycleAdvance.create(...).span()
        step("Construct a CycleAdvance and compute its span")
        val advance = CycleAdvance.create(5, 2, 7)
        expect(advance.span()).to_equal(5)  # oracle: span() = to_step - from_step = 7 - 2

    it "zero span when from equals to":
        # @req REQ-VHDL-CYC-002
        # @capture(bit_table): CycleAdvance.create(...).span()
        step("Construct a CycleAdvance whose from and to steps are equal")
        val advance = CycleAdvance.create(0, 5, 5)
        expect(advance.span()).to_equal(0)  # oracle: span() = 5 - 5

    it "final advance flag is independent from cycle count":
        # @req REQ-VHDL-CYC-003
        # @capture(bit_table): CycleAdvance.final_advance(...).cycle_count/is_final
        step("Construct a final CycleAdvance and read its fields")
        val advance = CycleAdvance.final_advance(3, 0, 3)
        expect(advance.cycle_count).to_equal(3)  # oracle: constructor was given 3 cycles
        expect(advance.is_final).to_equal(true)

describe "VHDL Clocked Testbench - TimingConstraint":
    it "cycle count within range is accepted":
        # @req REQ-VHDL-TIM-001
        # @capture(bit_table): TimingConstraint.create(...).check(5).is_met
        step("Check a cycle count inside the timing range")
        val tc = TimingConstraint.create("t1", 3, 8).check(5)
        expect(tc.is_met).to_equal(true)

    it "cycle count at lower bound is accepted":
        # @req REQ-VHDL-TIM-002
        # @capture(bit_table): TimingConstraint.create(...).check(3).is_met
        step("Check a cycle count at the lower timing bound")
        val tc = TimingConstraint.create("t1", 3, 8).check(3)
        expect(tc.is_met).to_equal(true)

    it "cycle count at upper bound is accepted":
        # @req REQ-VHDL-TIM-003
        # @capture(bit_table): TimingConstraint.create(...).check(8).is_met
        step("Check a cycle count at the upper timing bound")
        val tc = TimingConstraint.create("t1", 3, 8).check(8)
        expect(tc.is_met).to_equal(true)

    it "cycle count below lower bound is rejected":
        # @req REQ-VHDL-TIM-004
        # @capture(bit_table): TimingConstraint.create(...).check(2).is_met
        step("Check a cycle count below the lower timing bound")
        val tc = TimingConstraint.create("t1", 3, 8).check(2)
        expect(tc.is_met).to_equal(false)

    it "cycle count above upper bound is rejected":
        # @req REQ-VHDL-TIM-005
        # @capture(bit_table): TimingConstraint.create(...).check(9).is_met
        step("Check a cycle count above the upper timing bound")
        val tc = TimingConstraint.create("t1", 3, 8).check(9)
        expect(tc.is_met).to_equal(false)

# ===========================================================================
# Test Group 4: ClockedBench
# ===========================================================================

describe "VHDL Clocked Testbench - ClockedBench":
    it "sim_time_ns is total_cycles multiplied by clock_period_ns":
        # @req REQ-VHDL-BCH-001
        # @capture(statistics): ClockedBench.create(...).sim_time_ns()
        step("Compute simulated time for a 10ns / 10-cycle bench")
        val bench = ClockedBench.create("my_tb", "counter", 10, 2, 10)
        expect(bench.sim_time_ns()).to_equal(100)  # oracle: sim_time_ns() = total_cycles * period_ns = 10 * 10

    it "sim_time_ns with 4 ns period and 20 cycles is 80 ns":
        # @req REQ-VHDL-BCH-002
        # @capture(statistics): ClockedBench.create(...).sim_time_ns()
        step("Compute simulated time for a 4ns / 20-cycle bench")
        val bench = ClockedBench.create("my_tb", "counter", 4, 2, 20)
        expect(bench.sim_time_ns()).to_equal(80)  # oracle: sim_time_ns() = total_cycles * period_ns = 20 * 4

    it "has_reset is true when reset_cycles > 0":
        # @req REQ-VHDL-BCH-003
        # @capture(bit_table): ClockedBench.create(...).has_reset()
        step("Construct a bench with a nonzero reset cycle count")
        val bench = ClockedBench.create("my_tb", "counter", 10, 3, 10)
        expect(bench.has_reset()).to_equal(true)

    it "has_reset is false when reset_cycles == 0":
        # @req REQ-VHDL-BCH-004
        # @capture(bit_table): ClockedBench.create(...).has_reset()
        step("Construct a bench with a zero reset cycle count")
        val bench = ClockedBench.create("my_tb", "counter", 10, 0, 10)
        expect(bench.has_reset()).to_equal(false)

    it "to_text includes bench_name and dut_entity":
        # @req REQ-VHDL-BCH-005
        # @capture(bit_table): ClockedBench.create(...).to_text()
        step("Render the bench summary text and check it names the bench and DUT")
        val bench = ClockedBench.create("my_tb", "counter", 10, 2, 20)
        val s = bench.to_text()
        expect(s.contains("my_tb")).to_equal(true)
        expect(s.contains("counter")).to_equal(true)

    it "to_text includes clock period":
        # @req REQ-VHDL-BCH-006
        # @capture(bit_table): ClockedBench.create(...).to_text()
        step("Render the bench summary text and check it names the clock period")
        val bench = ClockedBench.create("my_tb", "counter", 10, 2, 20)
        expect(bench.to_text().contains("10ns")).to_equal(true)

    it "to_text includes total cycle count":
        # @req REQ-VHDL-BCH-007
        # @capture(bit_table): ClockedBench.create(...).to_text()
        step("Render the bench summary text and check it names the total cycle count")
        val bench = ClockedBench.create("my_tb", "counter", 10, 2, 20)
        expect(bench.to_text().contains("20")).to_equal(true)

# ===========================================================================
# Test Group 5: Clocked VHDL Shape
# ===========================================================================

describe "VHDL Clocked Testbench - Generated VHDL Shape":
    it "clocked VHDL contains clock generator process":
        # @req REQ-VHDL-SHP-001
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl clock_driver process
        step("Render a real testbench and check for a clock generator process")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_clock_process(vhdl)
        expect(has).to_equal(true)

    it "clocked VHDL contains wait-for half-period timing":
        # @req REQ-VHDL-SHP-002
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl wait-for timing
        step("Render a real testbench and check for half-period wait-for statements")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_wait_for(vhdl, "5")
        expect(has).to_equal(true)

    it "clocked VHDL contains loop construct for clock generation":
        # @req REQ-VHDL-SHP-003
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl loop construct
        step("Render a real testbench and check for the clock loop construct")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_loop(vhdl)
        expect(has).to_equal(true)

    it "clocked VHDL contains reset signal assignment":
        # @req REQ-VHDL-SHP-004
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl reset assignment
        step("Render a real testbench and check for the reset signal assignment")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_reset_signal(vhdl, "rst_n")
        expect(has).to_equal(true)

    it "clocked VHDL contains testbench entity declaration":
        # @req REQ-VHDL-SHP-005
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl entity declaration
        step("Render a real testbench and check for its entity declaration")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_entity(vhdl, "tb_counter")
        expect(has).to_equal(true)

    it "clocked VHDL contains architecture sim declaration":
        # @req REQ-VHDL-SHP-006
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl architecture declaration
        step("Render a real testbench and check for its architecture declaration")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_arch(vhdl, "tb_counter")
        expect(has).to_equal(true)

    it "clocked VHDL contains DUT instance":
        # @req REQ-VHDL-SHP-007
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl DUT instance
        step("Render a real testbench and check for the DUT component instance")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_instance(vhdl, "counter")
        expect(has).to_equal(true)

    it "clocked VHDL contains stimulus process":
        # @req REQ-VHDL-SHP-008
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl stimulus process
        step("Render a real testbench and check for the stimulus process")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_stimulus(vhdl)
        expect(has).to_equal(true)

    it "clocked VHDL contains assert statement for expected output":
        # @req REQ-VHDL-SHP-009
        # @capture(protocol_json): render_vhdl_testbench(...).testbench_vhdl assert statement
        step("Render a real testbench and check for the expectation assert statement")
        val vhdl = render_sample_testbench_vhdl()
        val has = clk_vhdl_has_assert(vhdl)
        expect(has).to_equal(true)

# ===========================================================================
# Test Group 6: Reset Behavior Verification
# ===========================================================================

describe "VHDL Clocked Testbench - Reset Behavior":
    it "reset duration of 2 cycles covers at least 2 clock periods":
        # @req REQ-VHDL-BHV-001
        # @capture(statistics): ResetSequence.duration_cycles * ClockConfig.period_ns
        step("Compute reset time in ns from a real reset and a real default clock")
        val clock = ClockConfig.default_clock()
        val reset = ResetSequence.async_low("rst_n", 2)
        val reset_time_ns = reset.duration_cycles * clock.period_ns
        expect(reset_time_ns).to_equal(20)  # oracle: 2 duration_cycles * default 10ns period

    it "async reset asserted value differs from deasserted value":
        # @req REQ-VHDL-BHV-002
        # @capture(bit_table): reset_asserted_value/reset_deasserted_value(ResetSequence.async_low(...).polarity)
        step("Compare asserted and deasserted VHDL literals for an async reset")
        val reset = ResetSequence.async_low("rst_n", 2)
        val asserted = reset_asserted_value(reset.polarity)
        val deasserted = reset_deasserted_value(reset.polarity)
        expect(asserted != deasserted).to_equal(true)

    it "sync reset asserted value differs from deasserted value":
        # @req REQ-VHDL-BHV-003
        # @capture(bit_table): reset_asserted_value/reset_deasserted_value(ResetSequence.sync_high(...).polarity)
        step("Compare asserted and deasserted VHDL literals for a sync reset")
        val reset = ResetSequence.sync_high("rst", 2)
        val asserted = reset_asserted_value(reset.polarity)
        val deasserted = reset_deasserted_value(reset.polarity)
        expect(asserted != deasserted).to_equal(true)

    it "wrong latency detection: expected output at cycle 1 but output ready at cycle 2":
        # @req REQ-VHDL-BHV-004
        # @capture(statistics): CycleAdvance.create(...).span() mismatch
        step("Compare spans of a 1-cycle expected advance and a 2-cycle actual advance")
        val expected = CycleAdvance.create(1, 0, 1)
        val actual = CycleAdvance.create(2, 0, 2)
        expect(expected.span() == actual.span()).to_equal(false)

    it "correct latency detection: expected output at cycle 2 matches actual":
        # @req REQ-VHDL-BHV-005
        # @capture(statistics): CycleAdvance.create(...).span() match
        step("Compare spans of two matching 2-cycle advances")
        val expected = CycleAdvance.create(2, 0, 2)
        val actual = CycleAdvance.create(2, 0, 2)
        expect(expected.span() == actual.span()).to_equal(true)
