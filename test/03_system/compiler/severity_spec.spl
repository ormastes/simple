# @cover src/compiler/00.common/diagnostics/severity.spl 80%
# SPipe: Diagnostic Severity Levels
#
# Comprehensive behavioral specification for severity.spl
# Tests enum behavior, color codes, sorting, and parsing

"""
## Purpose and audience
Purpose: gets severity name for Error
Audience: compiler and tooling engineers who maintain this spec
"""

# @req: REQ-COMPILER-Seve-001

use std.spec.*
use std.tooling.compiler.severity.*

describe "Diagnostic Severity Levels":

    it "gets severity name for Error":
        step("Verify: gets severity name for Error")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val name = error.name()
        expect(name).to_equal("error")

    it "gets severity color for Error":
        step("Verify: gets severity color for Error")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val color = error.color()
        expect(color).to_equal("\x1b[1;31m")

    it "gets severity color for Warning":
        step("Verify: gets severity color for Warning")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val color = warning.color()
        expect(color).to_equal("\x1b[1;33m")

    it "gets severity color for Note":
        step("Verify: gets severity color for Note")
        # @req: REQ-COMPILER-Seve-001
        val note = Severity.Note
        val color = note.color()
        expect(color).to_equal("\x1b[1;36m")

    it "gets severity color for Help":
        step("Verify: gets severity color for Help")
        # @req: REQ-COMPILER-Seve-001
        val help = Severity.Help
        val color = help.color()
        expect(color).to_equal("\x1b[1;32m")

    it "gets severity color for Info":
        step("Verify: gets severity color for Info")
        # @req: REQ-COMPILER-Seve-001
        val info = Severity.Info
        val color = info.color()
        expect(color).to_equal("\x1b[1;34m")

    it "gets reset color code":
        step("Verify: gets reset color code")
        # @req: REQ-COMPILER-Seve-001
        val reset = Severity.reset_color()
        expect(reset).to_equal("\x1b[0m")

    it "formats colored severity":
        step("Verify: formats colored severity")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val colored = warning.colored()
        expect(colored).to_equal("\x1b[1;33mwarning\x1b[0m")

    it "checks if Error is an error":
        step("Verify: checks if Error is an error")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val result = error.is_error()
        expect(result).to_equal(true)

    it "checks if Warning is not an error":
        step("Verify: checks if Warning is not an error")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val result = warning.is_error()
        expect(result).to_equal(false)

    it "checks if Warning is a warning":
        step("Verify: checks if Warning is a warning")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val result = warning.is_warning()
        expect(result).to_equal(true)

    it "checks if Error blocks compilation":
        step("Verify: checks if Error blocks compilation")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val blocks = error.blocks_compilation()
        expect(blocks).to_equal(true)

    it "checks if Warning does not block compilation":
        step("Verify: checks if Warning does not block compilation")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val blocks = warning.blocks_compilation()
        expect(blocks).to_equal(false)

    it "gets severity order for Error":
        step("Verify: gets severity order for Error")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val order = error.order()
        expect(order).to_equal(0)  # oracle: value fixed by the spec contract

    it "gets severity order for Warning":
        step("Verify: gets severity order for Warning")
        # @req: REQ-COMPILER-Seve-001
        val warning = Severity.Warning
        val order = warning.order()
        expect(order).to_equal(1)  # oracle: value fixed by the spec contract

    it "gets severity order for Info":
        step("Verify: gets severity order for Info")
        # @req: REQ-COMPILER-Seve-001
        val info = Severity.Info
        val order = info.order()
        expect(order).to_equal(4)  # oracle: value fixed by the spec contract

    it "parses error string to severity":
        step("Verify: parses error string to severity")
        # @req: REQ-COMPILER-Seve-001
        val name = "error"
        val result = Severity.from_name(name)
        expect(result.is_some()).to_equal(true)
        val parsed = result.unwrap()
        expect(parsed.is_error()).to_equal(true)

    it "parses warning string to severity":
        step("Verify: parses warning string to severity")
        # @req: REQ-COMPILER-Seve-001
        val name = "warning"
        val result = Severity.from_name(name)
        expect(result.is_some()).to_equal(true)
        val parsed = result.unwrap()
        expect(parsed.is_warning()).to_equal(true)

    it "parses invalid string to severity":
        step("Verify: parses invalid string to severity")
        # @req: REQ-COMPILER-Seve-001
        val name = "invalid"
        val result = Severity.from_name(name)
        expect(result.is_none()).to_equal(true)

    it "gets all severity levels":
        step("Verify: gets all severity levels")
        # @req: REQ-COMPILER-Seve-001
        val all = Severity.all()
        expect(all.length()).to_equal(5)  # oracle: value fixed by the spec contract
        expect(all[0].is_error()).to_equal(true)
        expect(all[1].is_warning()).to_equal(true)

    it "severity ordering for sorting":
        step("Verify: severity ordering for sorting")
        # @req: REQ-COMPILER-Seve-001
        val error = Severity.Error
        val warning = Severity.Warning
        val info = Severity.Info
        expect(error.order() < warning.order()).to_equal(true)
        expect(warning.order() < info.order()).to_equal(true)

    it "all names are unique":
        step("Verify: all names are unique")
        # @req: REQ-COMPILER-Seve-001
        val all = Severity.all()
        val names = [for s in all: s.name()]
        expect(names.length()).to_equal(5)  # oracle: value fixed by the spec contract
        expect(names.filter(_1 == "error").length()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(names.filter(_1 == "warning").length()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(names.filter(_1 == "note").length()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(names.filter(_1 == "help").length()).to_equal(1)  # oracle: value fixed by the spec contract
        expect(names.filter(_1 == "info").length()).to_equal(1)  # oracle: value fixed by the spec contract

    it "parse round-trip for all severities":
        step("Verify: parse round-trip for all severities")
        # @req: REQ-COMPILER-Seve-001
        val all = Severity.all()
        for severity in all:
            val name = severity.name()
            val parsed = Severity.from_name(name)
            expect(parsed.is_some()).to_equal(true)
            val round_trip = parsed.unwrap()
            expect(round_trip.name()).to_equal(name)
