# Git history promotion fixtures — Semantic Incremental Build v2, Agent C7
#
# Design: doc/05_design/compiler/semantic_incremental_build_cache_aop_formal_2026-08-09.md
#   §21 "Tiering and promotion": fast-forward / normal-merge / rebase / squash /
#   cherry-pick / force-push-removes-commit / deleted-branch, each with an
#   expected promote/reject verdict.
# Freeze: doc/03_plan/compiler/cache/c0_schema_freeze_2026-08-09.md
#
# STATUS (2026-08-09, Agent C7): `PromotionReceipt` and the ancestry-verification
# consumer described in the design (§21: "A normally merged branch receipt
# promotes after ancestry verification", "A squash-merged branch receipt is
# rejected for direct promotion") do not exist anywhere in `src/compiler/` or
# `src/verification/cache_identity/` today — grep for `PromotionReceipt` and
# `AncestryVerif` returns zero hits outside doc/ and the frozen schema. There is
# no production function for this spec to call.
#
# So this spec tests the ONE thing that already exists and that promotion logic
# will have to be built on: real `git` ancestry facts on real fixture repos,
# built and inspected with actual `git` subprocess calls (not a re-implementation
# of git, and not the promotion logic under test — a different, external oracle).
# Every `it` below is real, executable, and independently checkable with `git
# log --graph` on the resulting fixture directory.
#
# The verdict column asserts what the FUTURE promotion policy documented in
# §21 must decide, given the real git facts measured here. Until
# `PromotionReceipt`/ancestry-verification land, the verdict assertions are
# necessarily descriptive placeholders (`# EXPECTED (blocked)` comments) rather
# than checks against production code — recorded, not invented, so C1-C4 have
# the literal fixture ready to wire against.
#
# **Category:** Infrastructure

use std.spec.*
use std.process.{process_run}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_write_text(path: text, content: text) -> bool
extern fn rt_getpid() -> i64
extern fn rt_time_now_unix_micros() -> i64

# ============================================================================
# Fixture repo builder
# ============================================================================

fn fresh_repo_dir(name: text) -> text:
    val dir = "build/tmp/git_history_fixtures/{name}-{rt_getpid()}-{rt_time_now_unix_micros()}"
    rt_dir_create_all(dir)
    dir

fn git_in(dir: text, args: [text]) -> (text, text, i64):
    var full: [text] = ["-C", dir]
    for a in args:
        full = full.push(a)
    process_run("git", full)

fn git_ok(dir: text, args: [text]) -> bool:
    val (_out, _err, code) = git_in(dir, args)
    code == 0

fn git_out(dir: text, args: [text]) -> text:
    val (out, _err, _code) = git_in(dir, args)
    out.trim()

fn init_repo(dir: text) -> bool:
    if not git_ok(dir, ["init", "-q", "-b", "main"]):
        return false
    git_ok(dir, ["config", "user.email", "c7@example.test"])
    git_ok(dir, ["config", "user.name", "C7 Fixture"])
    true

fn commit_file(dir: text, filename: text, content: text, message: text) -> bool:
    rt_file_write_text("{dir}/{filename}", content)
    if not git_ok(dir, ["add", filename]):
        return false
    git_ok(dir, ["commit", "-q", "-m", message])

fn head_sha(dir: text) -> text:
    git_out(dir, ["rev-parse", "HEAD"])

fn is_ancestor(dir: text, ancestor: text, descendant: text) -> bool:
    git_ok(dir, ["merge-base", "--is-ancestor", ancestor, descendant])

# ============================================================================
# Fast-forward merge — main advances to feature's tip with no merge commit
# ============================================================================

describe "Git history fixture: fast-forward merge":
    it "feature tip becomes an ancestor-verifiable descendant of pre-merge main (PROMOTE)":
        val dir = fresh_repo_dir("ff")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        val main_before = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "-b", "feature"])
        commit_file(dir, "a.txt", "base+feature", "feature commit")
        val feature_tip = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "main"])
        git_ok(dir, ["merge", "-q", "--ff-only", "feature"])
        val main_after = head_sha(dir)

        step("Verify main fast-forwarded to feature's exact tip")
        expect(main_after).to_equal(feature_tip)
        step("Verify pre-merge main is still an ancestor of the new tip")
        expect(is_ancestor(dir, main_before, main_after)).to_equal(true)
        # EXPECTED (blocked, no PromotionReceipt consumer yet): PROMOTE —
        # ancestry chain is linear and unbroken.

# ============================================================================
# Normal merge commit — two parents, both ancestors
# ============================================================================

describe "Git history fixture: normal merge commit":
    it "merge commit has both branch tips as ancestors (PROMOTE)":
        val dir = fresh_repo_dir("merge")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        val main_before = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "-b", "feature"])
        commit_file(dir, "b.txt", "feature-only", "feature commit")
        val feature_tip = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "main"])
        commit_file(dir, "a.txt", "main-only-change", "main commit")
        git_ok(dir, ["merge", "-q", "--no-ff", "-m", "merge feature", "feature"])
        val merge_sha = head_sha(dir)
        val parent_count = git_out(dir, ["rev-list", "--parents", "-n", "1", "HEAD"]).split(" ").len() - 1

        step("Verify the merge commit has exactly two parents")
        expect(parent_count).to_equal(2)
        step("Verify both branch tips are ancestors of the merge commit")
        expect(is_ancestor(dir, main_before, merge_sha)).to_equal(true)
        expect(is_ancestor(dir, feature_tip, merge_sha)).to_equal(true)
        # EXPECTED (blocked): PROMOTE — "normally merged branch receipt
        # promotes after ancestry verification" (§21).

# ============================================================================
# Rebase — original feature commits are NOT ancestors of the rebased tip's
# original SHAs (history rewritten); new commits ARE descendants of new main
# ============================================================================

describe "Git history fixture: rebase":
    it "rebased tip is a descendant of the new main base, original commit is orphaned":
        val dir = fresh_repo_dir("rebase")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        val base = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "-b", "feature"])
        commit_file(dir, "b.txt", "feature-v1", "feature commit")
        val original_feature_sha = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "main"])
        commit_file(dir, "a.txt", "main-advanced", "main advances")
        val new_main = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "feature"])
        git_ok(dir, ["rebase", "-q", "main"])
        val rebased_tip = head_sha(dir)

        step("Verify the rebase produced a different SHA than the original commit")
        expect(rebased_tip == original_feature_sha).to_equal(false)
        step("Verify the rebased tip descends from the new main")
        expect(is_ancestor(dir, new_main, rebased_tip)).to_equal(true)
        step("Verify the ORIGINAL feature commit is no longer reachable from any ref")
        val (_o, _e, reachable_code) = git_in(dir, ["merge-base", "--is-ancestor", original_feature_sha, rebased_tip])
        expect(reachable_code == 0).to_equal(false)
        # EXPECTED (blocked): a cache action keyed by the ORIGINAL feature SHA
        # must MISS after rebase — different ActionKey source content/ancestry.

# ============================================================================
# Squash merge — main gains one new commit whose tree matches feature's tip,
# but feature's tip SHA is NOT an ancestor of main (history not preserved)
# ============================================================================

describe "Git history fixture: squash merge":
    it "squashed commit reproduces feature's tree but feature tip is NOT an ancestor (REJECT direct promotion)":
        val dir = fresh_repo_dir("squash")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        git_ok(dir, ["checkout", "-q", "-b", "feature"])
        commit_file(dir, "b.txt", "feature-1", "feature commit 1")
        commit_file(dir, "c.txt", "feature-2", "feature commit 2")
        val feature_tip = head_sha(dir)
        val feature_tree = git_out(dir, ["show", "-s", "--format=%T", "HEAD"])
        git_ok(dir, ["checkout", "-q", "main"])
        git_ok(dir, ["merge", "-q", "--squash", "feature"])
        git_ok(dir, ["commit", "-q", "-m", "squash-merge feature"])
        val squash_sha = head_sha(dir)
        val squash_tree = git_out(dir, ["show", "-s", "--format=%T", "HEAD"])

        step("Verify the squash commit's tree matches feature's tree (content identical)")
        expect(squash_tree).to_equal(feature_tree)
        step("Verify feature's tip commit is NOT an ancestor of the squash commit")
        val (_o, _e, code) = git_in(dir, ["merge-base", "--is-ancestor", feature_tip, squash_sha])
        expect(code == 0).to_equal(false)
        # EXPECTED (blocked): REJECT direct promotion by ancestry — "A
        # squash-merged branch receipt is rejected for direct promotion" (§21),
        # even though content matches, because ancestry cannot be verified.

# ============================================================================
# Cherry-pick — new commit on main with an unrelated SHA, same diff content
# ============================================================================

describe "Git history fixture: cherry-pick":
    it "cherry-picked commit has a distinct SHA and is not an ancestor of the source branch":
        val dir = fresh_repo_dir("cherry")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        git_ok(dir, ["checkout", "-q", "-b", "feature"])
        commit_file(dir, "b.txt", "picked-content", "the commit to cherry-pick")
        val source_sha = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "main"])
        # Diverge main from feature's parent first — otherwise the
        # cherry-picked commit would share (parent, tree, author, message)
        # with the source and git would legitimately mint the SAME sha
        # (content-addressed objects), which is not what this fixture is
        # testing (that was verified as a real git property via a debug
        # probe, not assumed).
        commit_file(dir, "a.txt", "main-diverged-before-pick", "main diverges")
        val main_tip_before_pick = head_sha(dir)
        git_ok(dir, ["cherry-pick", source_sha])
        val picked_sha = head_sha(dir)

        step("Verify the cherry-picked commit has a different SHA than the source")
        expect(picked_sha == source_sha).to_equal(false)
        step("Verify the cherry-picked commit's parent is main's pre-pick tip, not the source commit")
        val parent_of_picked = git_out(dir, ["rev-parse", "HEAD^"])
        expect(parent_of_picked).to_equal(main_tip_before_pick)
        # EXPECTED (blocked): a cache action keyed by source_sha content
        # digest may still HIT on picked_sha (identical source_content field),
        # but any git-ancestry-based promotion path must not treat picked_sha
        # as verified via source_sha's provenance.

# ============================================================================
# Force-push removing a commit — old tip becomes unreachable from the new ref
# ============================================================================

describe "Git history fixture: force-push removes a commit":
    it "the removed commit is unreachable from the ref after a hard reset (simulating force-push)":
        val dir = fresh_repo_dir("forcepush")
        init_repo(dir)
        commit_file(dir, "a.txt", "v1", "commit 1")
        val keep_sha = head_sha(dir)
        commit_file(dir, "a.txt", "v2-to-be-removed", "commit 2 (will be force-removed)")
        val removed_sha = head_sha(dir)
        git_ok(dir, ["reset", "--hard", keep_sha])
        val new_tip = head_sha(dir)

        step("Verify the ref now points back at the earlier commit")
        expect(new_tip).to_equal(keep_sha)
        step("Verify the removed commit is unreachable from the ref (not in rev-list)")
        val reachable = git_out(dir, ["rev-list", "HEAD"])
        expect(reachable.contains(removed_sha)).to_equal(false)
        # EXPECTED (blocked): "A stale or unauthenticated origin/main snapshot
        # cannot authorize promotion" (§21) — a receipt naming removed_sha as
        # trusted-ref-tip must be rejected once the ref no longer points there.

# ============================================================================
# Deleted branch — the branch ref no longer resolves
# ============================================================================

describe "Git history fixture: deleted branch":
    it "a deleted branch ref no longer resolves to any commit":
        val dir = fresh_repo_dir("deletedbranch")
        init_repo(dir)
        commit_file(dir, "a.txt", "base", "base commit")
        git_ok(dir, ["checkout", "-q", "-b", "throwaway"])
        commit_file(dir, "b.txt", "throwaway content", "throwaway commit")
        val throwaway_sha = head_sha(dir)
        git_ok(dir, ["checkout", "-q", "main"])
        git_ok(dir, ["branch", "-D", "throwaway"])

        step("Verify the branch ref no longer resolves")
        val (_o, _e, code) = git_in(dir, ["rev-parse", "--verify", "throwaway"])
        expect(code == 0).to_equal(false)
        step("Verify the commit object itself is still reachable by raw SHA until GC (dangling, not deleted)")
        val (_o2, _e2, sha_code) = git_in(dir, ["cat-file", "-e", throwaway_sha])
        expect(sha_code == 0).to_equal(true)
        # EXPECTED (blocked): a namespace keyed on the deleted branch name
        # must not resolve for reads; entries under it are eligible for
        # expiry-before-retained-main-entries (§21 "Storage and GC").
