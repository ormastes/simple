"""
# Phase 4 compiler debug recovery

This fail-closed system specification qualifies one exact, admitted pure-Simple
Stage 4 compiler and its deployed toolchain. It must not be executed with the
Rust seed, a Stage 2/3 compiler, or a stale deployed wrapper.

The operator supplies absolute paths through the `PHASE4_DEBUG_*` environment
variables documented in the mirrored manual and test plan. Missing inputs,
seed identity, skipped DAP coverage, stub fallback, and hash substitution are
failures rather than skips.
"""
# codex-system-test
# @tag: system, compiler, bootstrap, phase4, debug, recovery
# @req: REQ-P4DBG-001, REQ-P4DBG-002, REQ-P4DBG-003, REQ-P4DBG-004, REQ-P4DBG-005, REQ-P4DBG-006, REQ-P4DBG-007
use std.spec.*
use std.io_runtime.{env_get, process_run}

fn required_env(name: text) -> text:
    val value = (env_get(name) ?? "").trim()
    expect(value.len()).to_be_greater_than(0)
    expect(value).to_start_with("/")
    value

fn shell_quote(value: text) -> text:
    "'" + value.replace("'", "'\"'\"'") + "'"

fn run_shell(command: text) -> (text, text, i32):
    process_run("/bin/sh", ["-c", command])

fn run_candidate(args: [text]) -> (text, text, i32):
    process_run(required_env("PHASE4_DEBUG_CANDIDATE"), args)

fn text_absent(value: text, forbidden: [text]) -> bool:
    for marker in forbidden:
        if value.contains(marker):
            return false
    true

fn expect_command_pass(label: text, command: text, required: [text]) -> text:
    val (stdout, stderr, code) = run_shell(command)
    val combined = stdout + stderr
    expect(code).to_equal(0)
    expect(text_absent(combined, ["FAILED FILES", "stub fallback", "Stub fallback", "Generating stub functions", "STATUS: FAIL"])).to_equal(true)
    for marker in required:
        expect(combined).to_contain(marker)
    combined

fn expect_command_rejected(label: text, command: text, marker: text) -> text:
    val (stdout, stderr, code) = run_shell(command)
    val combined = stdout + stderr
    expect(code).to_be_greater_than(0)
    expect(combined).to_contain(marker)
    combined

fn verify_stage4_admission() -> text:
    val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
    val provenance = required_env("PHASE4_DEBUG_PROVENANCE")
    expect_command_pass(
        "post-bootstrap Stage 4 admission",
        "SIMPLE_NO_STUB_FALLBACK=1 sh scripts/check/check-post-bootstrap-stage4-sspec.shs " +
            shell_quote(candidate) + " " + shell_quote(provenance),
        ["post_bootstrap_stage4_provenance=true", "post_bootstrap_stage4_source_binding=true", "post_bootstrap_stage4_acceptance=true"]
    )

fn verify_deployed_hash_binding() -> text:
    val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
    val deployed = required_env("PHASE4_DEBUG_DEPLOYED")
    expect_command_pass(
        "deployed hash binding",
        "test -x " + shell_quote(candidate) + " && test -x " + shell_quote(deployed) +
            " && candidate_sha=$(sha256sum " + shell_quote(candidate) + " | awk '{print $1}')" +
            " && deployed_sha=$(sha256sum " + shell_quote(deployed) + " | awk '{print $1}')" +
            " && test \"$candidate_sha\" = \"$deployed_sha\"" +
            " && printf 'phase4_debug_candidate_sha=%s\\nphase4_debug_deployed_sha=%s\\nphase4_debug_deployed_hash_binding=PASS\\n' \"$candidate_sha\" \"$deployed_sha\"",
        ["phase4_debug_deployed_hash_binding=PASS"]
    )

describe "Phase 4 compiler debug recovery":
    it "should admit only an exact pure-Simple Stage 4 candidate for REQ-P4DBG-001":
        step("Require the exact candidate, adjacent provenance, deployed path, and artifact root")
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        val _provenance = required_env("PHASE4_DEBUG_PROVENANCE")
        val _deployed = required_env("PHASE4_DEBUG_DEPLOYED")
        val _artifact_root = required_env("PHASE4_DEBUG_ARTIFACT_ROOT")

        step("Reject Rust-seed and stale bootstrap identities")
        val (stdout, stderr, code) = run_candidate(["--version"])
        val identity = stdout + stderr
        expect(code).to_equal(0)
        expect(candidate.len()).to_be_greater_than(0)
        expect(identity.len()).to_be_greater_than(0)
        expect(text_absent(identity, ["bootstrap seed", "Rust-built", "rust seed"])).to_equal(true)

        step("Prove the admission checker rejects substituted evidence")
        expect_command_rejected(
            "missing provenance rejection",
            "sh scripts/check/check-post-bootstrap-stage4-sspec.shs " + shell_quote(candidate) + " /dev/null",
            "post_bootstrap_stage4_reason="
        )

    it "should pass the canonical post-bootstrap admission checker for REQ-P4DBG-002":
        step("Verify content, lineage, Stage 3 parent, and retained tool-smoke evidence")
        val admission = verify_stage4_admission()
        expect(admission).to_contain("post_bootstrap_stage4_smoke_log_unchanged=true")
        expect(admission).to_contain("post_bootstrap_stage4_test_runner=true")
        expect(admission).to_contain("post_bootstrap_stage4_lint=true")
        expect(admission).to_contain("post_bootstrap_stage4_duplicate_check=true")

    it "should check compiler and library sources with the admitted candidate for REQ-P4DBG-003":
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        step("Check the compiler tree")
        expect_command_pass(
            "compiler check",
            "SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) + " check src/compiler",
            []
        )
        step("Check the library tree")
        expect_command_pass(
            "library check",
            "SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) + " check src/lib",
            []
        )

    it "should check MCP and LSP compiler surfaces with the admitted candidate for REQ-P4DBG-004":
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        step("Check the MCP server source")
        expect_command_pass(
            "MCP check",
            "SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) + " check src/app/mcp",
            []
        )
        step("Check the LSP MCP server source")
        expect_command_pass(
            "LSP MCP check",
            "SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) + " check src/app/simple_lsp_mcp",
            []
        )

    it "should execute the MCP stdio integration with the admitted candidate for REQ-P4DBG-005":
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        step("Run the real MCP protocol integration without seed or stub fallback")
        val output = expect_command_pass(
            "MCP stdio integration",
            "SIMPLE_LIB=src SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) +
                " test test/02_integration/app/mcp_stdio_integration_spec.spl --mode=interpreter --no-session-daemon --sequential --no-db --no-cache --assert-ran --fail-fast",
            []
        )
        expect(text_absent(output, ["no examples executed", "SKIP"])).to_equal(true)

    it "should compile and execute the native C5 character ABI probe for REQ-P4DBG-006":
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        val artifact_root = required_env("PHASE4_DEBUG_ARTIFACT_ROOT")
        val output_bin = artifact_root + "/c5_char_from_code"
        step("Create an isolated retained artifact directory")
        expect_command_pass("artifact directory", "mkdir -p " + shell_quote(artifact_root), [])
        step("Compile the C5 character probe with the admitted compiler")
        expect_command_pass(
            "C5 character native build",
            "SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) +
                " native-build --backend llvm --source src --source test/03_system/native --entry-closure" +
                " --entry test/03_system/native/c5_char_from_code.spl --strip --clean --output " + shell_quote(output_bin),
            []
        )
        step("Require the probe's exact success exit code")
        val (stdout, stderr, code) = run_shell(shell_quote(output_bin))
        expect(code).to_equal(42)
        expect(text_absent(stdout + stderr, ["stub fallback", "STATUS: FAIL"])).to_equal(true)

    it "should pass canonical DAP smoke and bind deployment to the admitted hash for REQ-P4DBG-007":
        val candidate = required_env("PHASE4_DEBUG_CANDIDATE")
        step("Drive the canonical live DAP protocol smoke through the admitted candidate")
        val dap = expect_command_pass(
            "DAP protocol smoke",
            "SIMPLE_BIN=" + shell_quote(candidate) + " SIMPLE_NO_STUB_FALLBACK=1 " + shell_quote(candidate) +
                " run scripts/smoke/dap_protocol_smoke.spl --mode=interpreter",
            ["STATUS: PASS dap_protocol_smoke"]
        )
        expect(text_absent(dap, ["STATUS: SKIP", "STATUS: FAIL"])).to_equal(true)
        step("Compare the deployed executable with the exact admitted candidate")
        val binding = verify_deployed_hash_binding()
        expect(binding).to_contain("phase4_debug_deployed_hash_binding=PASS")
