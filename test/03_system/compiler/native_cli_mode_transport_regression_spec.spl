"""Incremental native-build CLI mode transport regression."""

use std.spec.*
use std.io_runtime.{
    dir_create_all,
    env_get,
    file_exists,
    file_hash_sha256,
    file_read,
    file_write,
    process_run_bounded,
    remove_file_if_exists
}

val BUILD_DIR = "build/native_cli_mode_transport"
val ENTRY_PATH = BUILD_DIR + "/main.spl"
val BINARY_PATH = BUILD_DIR + "/main"
val DRIVER_PATH = BUILD_DIR + "/simple-driver"
val CACHE_DIR = BUILD_DIR + "/cache"
val BUILD_TIMEOUT_MS: i64 = 600000
val RUN_TIMEOUT_MS: i64 = 30000
val OUTPUT_LIMIT_BYTES: i64 = 16777216
val SPEC_PATH = "test/03_system/compiler/native_cli_mode_transport_regression_spec.spl"

fn write_cli_mode_transport_fixture() -> bool:
    val source = r"""fn main():
    print(73)
"""
    dir_create_all(BUILD_DIR) and
        file_write(ENTRY_PATH, source) and
        remove_file_if_exists(BINARY_PATH) and
        remove_file_if_exists(DRIVER_PATH)

fn prepared_inputs_valid(producer: text, runtime_path: text,
                         producer_sha256: text, backfill_sha256: text,
                         runtime_sha256: text) -> bool:
    val backfill = runtime_path + "/libsimple_compiler_backfill.a"
    val runtime = runtime_path + "/deps/libsimple_runtime.a"
    not producer.contains("compiler_rust/target/") and
        file_exists(producer) and file_exists(backfill) and file_exists(runtime) and
        producer_sha256.len() == 64 and backfill_sha256.len() == 64 and
        runtime_sha256.len() == 64 and
        file_hash_sha256(producer) == producer_sha256 and
        file_hash_sha256(backfill) == backfill_sha256 and
        file_hash_sha256(runtime) == runtime_sha256

fn run_cli_mode_transport_probe(producer: text, runtime_path: text) -> (i64, bool, i64, text):
    val (_driver_out, driver_err, driver_code) = process_run_bounded(
        "env",
        [
            "-u", "SIMPLE_BOOTSTRAP",
            "-u", "SIMPLE_RUNTIME_PATH",
            "SIMPLE_COMPILER_ENTRY_STAGE4=1",
            "SIMPLE_NO_STUB_FALLBACK=1",
            "SIMPLE_NO_DEPRECATED_WARNINGS=1",
            producer, "native-build",
            "--source", "src/compiler",
            "--source", "src/app",
            "--source", "src/lib",
            "--entry", "src/compiler/80.driver/main.spl",
            "--entry-closure",
            "--runtime-path", runtime_path,
            "--runtime-bundle", "core-c-bootstrap",
            "--cache-dir", CACHE_DIR,
            "-o", DRIVER_PATH
        ],
        BUILD_TIMEOUT_MS,
        OUTPUT_LIMIT_BYTES
    )
    if driver_code != 0:
        return (driver_code, false, -1, driver_err)
    val (_compiled_out, compiled_err, compiled_code) = process_run_bounded(
        "env",
        [
            "-u", "SIMPLE_BOOTSTRAP",
            "-u", "SIMPLE_RUNTIME_PATH",
            "SIMPLE_NO_STUB_FALLBACK=1",
            "SIMPLE_NO_DEPRECATED_WARNINGS=1",
            DRIVER_PATH, "--aot", "--output=" + BINARY_PATH, ENTRY_PATH
        ],
        RUN_TIMEOUT_MS,
        OUTPUT_LIMIT_BYTES
    )
    if compiled_code != 0:
        return (compiled_code, false, -1, compiled_err)
    if not file_exists(BINARY_PATH):
        return (compiled_code, false, -1, "")
    val (stdout, _run_err, run_code) = process_run_bounded(
        "env",
        [
            "-u", "SIMPLE_BOOTSTRAP",
            "-u", "SIMPLE_RUNTIME_PATH",
            "SIMPLE_NO_STUB_FALLBACK=1",
            BINARY_PATH
        ],
        RUN_TIMEOUT_MS,
        OUTPUT_LIMIT_BYTES)
    (compiled_code, true, run_code, stdout.trim())

describe "incremental native CLI mode transport":
    it "requires an exact bounded no-stub Stage4 producer":
        val source = file_read(SPEC_PATH)
        val start = source.index_of("fn write_cli_mode_transport_fixture()")
        val finish = source.index_of("describe \"incremental native CLI mode transport\"", start)
        val contract = source.slice(start, finish)
        expect(contract).to_contain("\"SIMPLE_COMPILER_ENTRY_STAGE4=1\"")
        expect(contract).to_contain("\"SIMPLE_NO_STUB_FALLBACK=1\"")
        expect(contract).to_contain("\"SIMPLE_NO_DEPRECATED_WARNINGS=1\"")
        expect(contract).to_contain("\"--runtime-bundle\", \"core-c-bootstrap\"")
        expect(contract).to_contain("process_run_bounded(")
        expect(contract).to_contain("BUILD_TIMEOUT_MS")
        expect(contract).to_contain("remove_file_if_exists(DRIVER_PATH)")
        expect(contract).to_contain("file_hash_sha256(producer) == producer_sha256")
        expect(contract).to_contain("not producer.contains(\"compiler_rust/target/\")")
        val native_build_source = file_read("src/app/io/_CliCompile/compile_targets.spl")
        expect(native_build_source).to_contain("options.cli_mode_text = \"aot\"")
        expect(native_build_source).to_contain("var discovered = _driver_text_bucket_set_new(512)")
        expect(native_build_source).to_contain("not _driver_text_bucket_set_has(discovered, rp)")
        expect(native_build_source).to_contain("discovered = _driver_text_bucket_set_add(discovered, rp)")
        expect(native_build_source.contains("discovered.has(")).to_equal(false)
        expect(native_build_source).to_contain("_nb_resolve_segs(segs, closure_source_dirs, f)")
        expect(native_build_source).to_contain('env_set("SIMPLE_NATIVE_BUILD_ENTRY_CLOSURE", "0")')
        expect(native_build_source.contains("val nb_closure_env =")).to_equal(false)
        val backend_io = file_read("src/compiler/70.backend/backend/io_compat.spl")
        expect(backend_io).to_contain("return process_run(\"cmd.exe\", [\"/c\", command])")
        expect(backend_io).to_contain("process_run(\"/bin/sh\", [\"-c\", command])")
        expect(backend_io.contains("val (shell_path, shell_args)")).to_equal(false)

    val producer = env_get("SIMPLE_GPU_COMPILER_PRODUCER") ?? ""
    val runtime_path = env_get("SIMPLE_GPU_COMPILER_RUNTIME_PATH") ?? ""
    val producer_sha256 = env_get("SIMPLE_GPU_COMPILER_PRODUCER_SHA256") ?? ""
    val backfill_sha256 = env_get("SIMPLE_GPU_COMPILER_BACKFILL_SHA256") ?? ""
    val runtime_sha256 = env_get("SIMPLE_GPU_COMPILER_RUNTIME_SHA256") ?? ""
    if (producer == "" or runtime_path == "" or producer_sha256 == "" or
        backfill_sha256 == "" or runtime_sha256 == ""):
        return

    it "builds and runs a one-file program through the cached native path":
        expect(prepared_inputs_valid(
            producer, runtime_path, producer_sha256,
            backfill_sha256, runtime_sha256)).to_equal(true)
        expect(write_cli_mode_transport_fixture()).to_equal(true)
        val (compile_code, binary_exists, run_code, stdout) =
            run_cli_mode_transport_probe(producer, runtime_path)
        expect(compile_code).to_equal(0)
        expect(binary_exists).to_equal(true)
        expect(run_code).to_equal(0)
        expect(stdout).to_equal("73")
