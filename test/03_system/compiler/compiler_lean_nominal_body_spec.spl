# codex-system-test
# @manual: show
# @req: REQ-MC-007, C2
# Real MIR -> admitted declaration plan -> emitted body/module. All execution UNRUN.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBody, MirInst, MirInstKind, AggregateKind, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator, MirBinOp, MirUnaryOp}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirConstValue, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use compiler.backend.backend.lean_backend.{LeanBackend, LeanBuilder, VerificationLevel}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations}
use plugins.backend_lean.lean_nominal_body.{translate_mir_nominal_body}

fn ty(kind: MirTypeKind) -> MirType: MirType(kind: kind)
fn packet_ty() -> MirType: ty(MirTypeKind.Struct(SymbolId(id: 7)))
fn state_ty() -> MirType: ty(MirTypeKind.Enum(SymbolId(id: 9)))
fn copy(id: i64) -> MirOperand: MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))
fn local(id: i64, type_: MirType, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: kind, is_ghost: false)
fn inst(kind: MirInstKind) -> MirInst: MirInst(kind: kind, span: nil)
fn ret(id: i64) -> MirTerminator: MirTerminator.Ret(Some(copy(id)))

fn fixture_function(parameters: [MirType], locals: [MirLocal], instructions: [MirInst], return_type: MirType, terminator: MirTerminator) -> MirFunction:
    MirFunction(symbol: SymbolId(id: 20), name: "nominalValue",
        signature: MirSignature(params: parameters, return_type: return_type, is_variadic: false, params_known: true),
        locals: locals,
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: instructions, terminator: terminator)],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)

fn fixture_module(function: MirFunction) -> MirModule:
    val packet = MirTypeDef(symbol: SymbolId(id: 7), name: "wire.Packet",
        kind: MirTypeDefKind.Struct([
            MirFieldDef(name: "byte", type_: ty(MirTypeKind.U8), offset: 0, has_bits_attr: false, bits_width: 0),
            MirFieldDef(name: "count", type_: ty(MirTypeKind.I32), offset: 4, has_bits_attr: false, bits_width: 0)]),
        is_export_c: false, export_name: "")
    val state = MirTypeDef(symbol: SymbolId(id: 9), name: "wire.State",
        kind: MirTypeDefKind.Enum([
            MirVariantDef(name: "Idle", discriminant: -3, payload: nil),
            MirVariantDef(name: "Packet", discriminant: 12, payload: Some(packet_ty()))]),
        is_export_c: false, export_name: "")
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[packet.symbol] = packet
    types[state.symbol] = state
    MirModule(name: "NominalBody", functions: functions, statics: {}, constants: {}, types: types)

fn packet_function() -> MirFunction:
    fixture_function([ty(MirTypeKind.U8), ty(MirTypeKind.I32)],
        [local(0, ty(MirTypeKind.U8), LocalKind.Arg(0)), local(1, ty(MirTypeKind.I32), LocalKind.Arg(1)), local(2, packet_ty(), LocalKind.Temp)],
        [inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [copy(0), copy(1)]))], packet_ty(), ret(2))

fn enum_function(discriminant: i64, operands: [MirOperand]) -> MirFunction:
    fixture_function([packet_ty()], [local(0, packet_ty(), LocalKind.Arg(0)), local(1, state_ty(), LocalKind.Temp)],
        [inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Enum(SymbolId(id: 9), discriminant), operands))], state_ty(), ret(1))

fn scalar_function(input_type: MirType, output_type: MirType, operation: MirInst) -> MirFunction:
    fixture_function([input_type, input_type],
        [local(0, input_type, LocalKind.Arg(0)), local(1, input_type, LocalKind.Arg(1)),
         local(2, output_type, LocalKind.Temp), local(3, packet_ty(), LocalKind.Temp), local(4, output_type, LocalKind.Temp)],
        [operation, inst(MirInstKind.Aggregate(LocalId(id: 3), AggregateKind.Struct(SymbolId(id: 7)), [copy(2)])),
         inst(MirInstKind.GetField(LocalId(id: 4), copy(3), 0))], output_type, ret(4))

fn scalar_module(function: MirFunction, field_type: MirType) -> MirModule:
    var module = fixture_module(function)
    val definition = MirTypeDef(symbol: SymbolId(id: 7), name: "wire.Packet", kind: MirTypeDefKind.Struct([
        MirFieldDef(name: "scalar", type_: field_type, offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
    module.types[definition.symbol] = definition
    module

fn expect_scalar_body(module: MirModule, type_name: text, expression: text):
    val expected = "let _l2 : " + type_name + " := " + expression + "\n  let _l3 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l2)\n  let _l4 : " + type_name + " := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».«scalar» (_l3)\n  _l4"
    val backend = LeanBackend.create(VerificationLevel.Contracts)
    expect(backend.export_module(module).unwrap().lean_code).to_contain(expected)
    expect(backend.export_generated_module(module).unwrap().lean_code).to_contain(expected)

fn expect_scalar_refusal(module: MirModule, reason: text):
    val backend = LeanBackend.create(VerificationLevel.Contracts)
    match backend.export_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)
    match backend.export_generated_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)

describe "compiler owner typed nominal MIR body export":
    it "emits the exact constructor body through both compiler module APIs":
        step("Exercise the retained compiler backend owner")
        val module = fixture_module(packet_function())
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val expected = "def nominalValue (_l0 : _root_.BitVec 8) (_l1 : _root_.BitVec 32) : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» :=\n  let _l2 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l0) (_l1)\n  _l2"
        expect(backend.export_module(module).unwrap().lean_code).to_contain(expected)
        expect(backend.export_generated_module(module).unwrap().lean_code).to_contain(expected)

    it "resolves a sparse enum discriminant through the actual compiler owner":
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val module = fixture_module(enum_function(12, [copy(0)]))
        val expected = "let _l1 : _root_.Simple.NominalBody.__MirTypes.«wire».«State» := _root_.Simple.NominalBody.__MirTypes.«wire».«State».«Packet» (_l0)\n  _l1"
        expect(backend.export_module(module).unwrap().lean_code).to_contain(expected)
        expect(backend.export_generated_module(module).unwrap().lean_code).to_contain(expected)

    it "fails both compiler APIs on an ordinal substituted for the retained tag":
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val module = fixture_module(enum_function(1, [copy(0)]))
        match backend.export_module(module):
            case Err(error): expect(error.message).to_contain("unknown enum discriminant 1")
            case Ok(_): assert(false)
        match backend.export_generated_module(module):
            case Err(error): expect(error.message).to_contain("unknown enum discriminant 1")
            case Ok(_): assert(false)

    it "indents every physical body line and preserves nested relative indentation":
        step("Preserve multiline target syntax at the actual builder boundary")
        var builder = LeanBuilder.create()
        builder.emit_def("nested", [("flag", "Bool")], "Bool", "let value := flag\nif value then\n  true\nelse\n  false")
        expect(builder.build()).to_equal("def nested (flag : Bool) : Bool :=\n  let value := flag\n  if value then\n    true\n  else\n    false")

    it "exports mixed typed scalar and nominal statements through both compiler APIs":
        step("Check mixed-body wiring in the retained compiler owner")
        val type_ = ty(MirTypeKind.I32)
        val function = scalar_function(type_, type_, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Mul, copy(0), copy(1))))
        expect_scalar_body(scalar_module(function, type_), "_root_.BitVec 32", "(_l0) * (_l1)")
        val boolean = scalar_function(type_, ty(MirTypeKind.Bool), inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Ne, copy(0), copy(1))))
        expect_scalar_body(scalar_module(boolean, ty(MirTypeKind.Bool)), "_root_.Bool", "(_l0) != (_l1)")

    it "rejects signedness mismatch in the retained compiler owner":
        val type_ = ty(MirTypeKind.U8)
        var function = scalar_function(type_, type_, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.BitAnd, copy(0), copy(1))))
        function.signature.params[1] = ty(MirTypeKind.I8)
        function.locals[1].type_ = ty(MirTypeKind.I8)
        expect_scalar_refusal(scalar_module(function, type_), "exact MIR type mismatch")

    it "preserves semantic Unicode scalar arguments through nominal construction and projection":
        step("Export typed Char values without asserting a physical character layout")
        val char_type = ty(MirTypeKind.Char)
        val function = fixture_function([char_type],
            [local(0, char_type, LocalKind.Arg(0)), local(1, packet_ty(), LocalKind.Temp), local(2, char_type, LocalKind.Temp)],
            [inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 7)), [copy(0)])),
             inst(MirInstKind.GetField(LocalId(id: 2), copy(1), 0))], char_type, ret(2))
        val module = scalar_module(function, char_type)
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val full = backend.export_module(module).unwrap().lean_code
        val generated = backend.export_generated_module(module).unwrap().lean_code
        val signature = "def nominalValue (_l0 : _root_.Char) : _root_.Char :="
        val projection = "let _l2 : _root_.Char := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».«scalar» (_l1)"
        expect(full).to_contain(signature)
        expect(generated).to_contain(signature)
        expect(full).to_contain(projection)
        expect(generated).to_contain(projection)

    it "refuses integer Char constants including invalid scalars without a representation adapter":
        step("Keep unsupported MIR integer-to-Char semantics fail closed in both module APIs")
        for value in [-1, 55296, 57343, 1114112, 65, 128512]:
            val char_type = ty(MirTypeKind.Char)
            val function = fixture_function([], [local(0, char_type, LocalKind.Temp), local(1, packet_ty(), LocalKind.Temp)],
                [inst(MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(value), char_type)),
                 inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 7)), [copy(0)]))], packet_ty(), ret(1))
            expect_scalar_refusal(scalar_module(function, char_type), "integer constant requires an exact fixed-width MIR integer type")
