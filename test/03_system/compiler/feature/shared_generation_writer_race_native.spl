use compiler.driver.cache.shared_generation_store.{shared_generation_publish_v1}
use std.concurrent.thread.{ThreadHandle, thread_spawn_with_args}
use std.nogc_sync_mut.atomic.{AtomicI64, MemoryOrdering, atomic_i64_new}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_dir_remove_all(path: text) -> bool

val ROOT: text = "/tmp/simple-shared-generation-writer-race"
var winners: AtomicI64 = atomic_i64_new(0)
var conflicts: AtomicI64 = atomic_i64_new(0)

fn increment(cell: AtomicI64):
    var complete = false
    while not complete:
        val prior = cell.load(MemoryOrdering.Acquire)
        complete = cell.compare_exchange(
            prior, prior + 1, MemoryOrdering.AcqRel, MemoryOrdering.Acquire)

fn writer(identity: i64, _unused: i64) -> i64:
    val result = shared_generation_publish_v1(
        ROOT, "", 1, "writer-{identity}")
    if result.len() == 64:
        increment(winners)
        return 1
    if result == "parent-generation-changed":
        increment(conflicts)
        return 1
    0

fn main() -> i64:
    val _removed = rt_dir_remove_all(ROOT)
    if not rt_dir_create_all(ROOT):
        return 70
    var handles: [ThreadHandle] = []
    var index = 0
    while index < 8:
        handles.push(thread_spawn_with_args(index, 0, writer))
        index = index + 1
    var completed = 0
    for handle in handles:
        completed = completed + handle.join()
    if completed != 8 or winners.load(MemoryOrdering.Acquire) != 1 or
            conflicts.load(MemoryOrdering.Acquire) != 7:
        return 71
    0
