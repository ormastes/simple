# @req REQ-GRR-001 REQ-GRR-002 REQ-GRR-003 REQ-GRR-004 REQ-GRR-005 REQ-GRR-006 REQ-GRR-007 REQ-GRR-008 REQ-GRR-009 NFR-GRR-001
"""
# Generic RR exactness and HIR-variant objects (system)

End-to-end over the public owners only: one target-neutral `HirCfgDeclV1`
list projected for linux and windows yields per-target object keys, RR
partitions and RR producers; generic template edits flow through facet
diffing, forward manifests, rebuilt RR shards and the generic invalidation
plan. Each scenario (body, signature, bound, caller, cfg-variant, unrelated,
concurrent rebuild, cache corruption, two keys per module) asserts the full
chain.

UNRUN: no self-hosted binary is available on the authoring host. NFR-GRR-001
is asserted on an in-memory receipt here; the live first-object timing is
measured only on the self-hosted binary.
"""

# @tag:system
# @tag:in-development
# @tag:compiler
# @tag:cache
# @tag:generics
# @cover src/compiler/00.common/cache_contract/generic_tldr_view_v1.spl 90%
# @cover src/compiler/80.driver/cache/reference/reverse_reference_coordinator_v1.spl 90%
# @cover src/compiler/80.driver/driver_build/hir_variant_object_key_v1.spl 90%

use std.spec.*
use std.spec.step
use std.common.crypto.sha256.{sha256_text, sha256_u8_hex}
use compiler.common.mir_target_context.{MirTargetContext}
use compiler.common.cache_contract.guard_id_v1.{active_guard_root_empty_v1}
use compiler.common.cache_contract.semantic_query_read_manifest_v1.{
    SemanticCoverageV1, SemanticQueryKeyV1, SemanticQueryReadV1,
    SemanticQueryReadManifestV1, semantic_query_read_manifest_encode_v1}
use compiler.common.cache_contract.reverse_reference_shard_v1.{
    ReverseReferenceShardV1, reverse_reference_shard_encode_v1, reverse_reference_shard_decode_v1}
use compiler.common.cache_contract.generic_tldr_view_v1.*
use compiler.frontend.cache_artifact.generic_tldr_projector.*
use compiler.driver.cache.reference.reverse_reference_coordinator_v1.{
    ChangedSemanticFacetV1, VerifiedSccGroupV1, VerifiedAffectedDomainV1,
    VerifiedForwardManifestV1, AffectedConsumerV1, GenericInvalidationPlanV1,
    affected_consumers_v1, plan_generic_invalidation_v1,
    verified_scc_group_receipt_v1, verified_affected_domain_receipt_v1,
    rebuild_reverse_shards_from_forward_v1, stage_reverse_shards_v1}
use compiler.driver.driver_build.hir_variant_object_key_v1.*
use compiler.driver.driver_build.native_file_worker_v1.{NativeFileWorkerReceiptV1}

val MODULE: text = "pkg_a.main"
val TOOLCHAIN: text = "simple-self-hosted/1.0.0"

fn digest(value: text) -> text: sha256_text(value)

# ---- two-target fixture ------------------------------------------------------

fn linux() -> MirTargetContext:
    MirTargetContext(arch: "x86_64", os: "linux", abi: "gnu", backend: "llvm", version: 1)

fn windows() -> MirTargetContext:
    MirTargetContext(arch: "x86_64", os: "windows", abi: "msvc", backend: "llvm", version: 1)

fn cfg_decls(w_body: text) -> [HirCfgDeclV1]:
    [HirCfgDeclV1(name: "a", kind: "fn", cfg: [], cfg_group: 0, cfg_arm: 0, content_digest: digest("a-v1")),
     HirCfgDeclV1(name: "w", kind: "fn", cfg: ["windows"], cfg_group: 0, cfg_arm: 0, content_digest: digest(w_body)),
     HirCfgDeclV1(name: "l", kind: "fn", cfg: ["linux"], cfg_group: 0, cfg_arm: 0, content_digest: digest("l-v1")),
     HirCfgDeclV1(name: "g_win", kind: "fn", cfg: ["os = \"windows\""], cfg_group: 7, cfg_arm: 0, content_digest: digest("g-win")),
     HirCfgDeclV1(name: "g_else", kind: "fn", cfg: [], cfg_group: 7, cfg_arm: -1, content_digest: digest("g-else"))]

fn projection(t: MirTargetContext, w_body: text) -> HirVariantProjectionV1:
    hir_variant_projection_v1(cfg_decls(w_body), t, [])

fn part(t: MirTargetContext) -> text:
    hir_variant_object_partition_v1("p", projection(t, "w-v1"))

# ---- template fixture --------------------------------------------------------

fn entry(second_type: text, bound_key: text, body: text) -> GenericTemplateEntryV1:
    val e = project_generic_template_v1(GenericDeclInputV1(module_path: "pkg_a", name: "Pair",
        params: ["First", "Second"], param_kinds: [GENERIC_PARAM_KIND_TYPE, GENERIC_PARAM_KIND_TYPE],
        fields: [GenericFieldInputV1(name: "first", type_text: "First"),
            GenericFieldInputV1(name: "second", type_text: second_type)],
        visibility_root: "vis:pub", active_guard_root: active_guard_root_empty_v1("").root_digest,
        source_digest: "src:pkg_a.Pair")).unwrap()
    GenericTemplateEntryV1(symbol_id: e.symbol_id, source_digest: e.source_digest,
        visibility_root: e.visibility_root, active_guard_root: e.active_guard_root,
        language_schema: e.language_schema, params: e.params, fields: e.fields,
        bounds: [GenericBoundV1(param_index: 0, bound_key: bound_key)], body_digest: digest(body))

fn old_entry() -> GenericTemplateEntryV1: entry("Second", "trait:pkg_a.Eq", "body-v1")

fn key(kind: text, label: text) -> SemanticQueryKeyV1:
    SemanticQueryKeyV1(kind: kind, stable_entity_id: label,
        semantic_profile_digest: digest("profile"), parameter_digest: digest(label))

fn template_t() -> SemanticQueryKeyV1: key("tldr.symbolic", "pkg_a.Pair")

fn read_at(producer: SemanticQueryKeyV1, consumer: SemanticQueryKeyV1, facet: text,
           fingerprint: text, ordinal: i64, partition: text) -> SemanticQueryReadV1:
    SemanticQueryReadV1(producer: producer, consumer: consumer, facet: facet, ordinal: ordinal,
        consumed_fingerprint: fingerprint, witness_digest: digest("witness"),
        partition_id: partition, completeness: SemanticCoverageV1.Complete)

fn template_manifest(consumer: SemanticQueryKeyV1, facets: [text], extra: [SemanticQueryReadV1]) -> SemanticQueryReadManifestV1:
    var reads: [SemanticQueryReadV1] = []
    var ordinal: i64 = 0
    for facet in facets:
        reads = reads.push(read_at(template_t(), consumer, facet, digest(facet + "-v1"), ordinal, part(linux())))
        ordinal = ordinal + 1
    for r in extra:
        reads = reads.push(read_at(r.producer, consumer, r.facet, r.consumed_fingerprint, ordinal, r.partition_id))
        ordinal = ordinal + 1
    SemanticQueryReadManifestV1(schema: 1, consumer: consumer, ordered_reads: reads)

fn c1_old() -> SemanticQueryReadManifestV1:
    template_manifest(key("tldr.concrete", "pkg_b.C1"), generic_caller_consumed_facets_v1(), [])

fn c1_new() -> SemanticQueryReadManifestV1:
    val view = read_at(key("tldr.concrete", "pkg_a.Pair<i64,f64>"), key("tldr.concrete", "pkg_b.C1"),
        GENERIC_FACET_SIGNATURE_V1, digest("args-i64-f64"), 0, part(linux()))
    template_manifest(key("tldr.concrete", "pkg_b.C1"), generic_caller_consumed_facets_v1(), [view])

fn variant_reads(t: MirTargetContext, w_body: text, user: text) -> SemanticQueryReadManifestV1:
    val producer = hir_variant_object_producer_v1(MODULE, digest("profile"), projection(t, w_body))
    val consumer = key("obj.link", user)
    SemanticQueryReadManifestV1(schema: 1, consumer: consumer, ordered_reads: [read_at(producer, consumer,
        GENERIC_FACET_BODY_V1, digest(user + "-obj"), 0, part(t))])

fn manifests() -> [SemanticQueryReadManifestV1]:
    [template_manifest(key("obj.emit", "pkg_a.Pair#object"), generic_template_consumed_facets_v1(), []),
     c1_old(),
     template_manifest(key("tldr.concrete", "pkg_b.C2"), generic_caller_consumed_facets_v1(), []),
     SemanticQueryReadManifestV1(schema: 1, consumer: key("obj.emit", "pkg_c.D"),
        ordered_reads: [read_at(key("tldr.concrete", "pkg_b.C1"), key("obj.emit", "pkg_c.D"),
            GENERIC_FACET_SIGNATURE_V1, digest("c1-sig"), 0, part(linux()))]),
     variant_reads(linux(), "w-v1", "app-linux"),
     variant_reads(windows(), "w-v1", "app-windows")]

fn domain() -> VerifiedAffectedDomainV1:
    var value = VerifiedAffectedDomainV1(dimension: GENERIC_FACET_DIMENSION_V1,
        candidate_root_digest: digest("candidate"), membership_root_digest: digest("membership"),
        absence_root_digest: digest("absence"), coverage: SemanticCoverageV1.Complete,
        receipt_digest: "")
    value.receipt_digest = verified_affected_domain_receipt_v1(value)
    value

fn verified_all() -> [VerifiedForwardManifestV1]:
    var out: [VerifiedForwardManifestV1] = []
    for m in manifests():
        val partition = m.ordered_reads[0].partition_id
        val gid = digest("group-" + m.consumer.stable_entity_id)
        out = out.push(VerifiedForwardManifestV1(
            manifest_digest: sha256_u8_hex(semantic_query_read_manifest_encode_v1(m)), manifest: m,
            scc_group: VerifiedSccGroupV1(partition_id: partition, group_identity: gid,
                member_queries: [m.consumer],
                receipt_digest: verified_scc_group_receipt_v1(partition, gid, [m.consumer])),
            affected_domains: [domain()]))
    out

fn shards() -> [ReverseReferenceShardV1]:
    rebuild_reverse_shards_from_forward_v1(manifests()).shards

fn plan_edit(new_entry: GenericTemplateEntryV1) -> GenericInvalidationPlanV1:
    plan_generic_invalidation_v1(template_t(),
        generic_template_changed_facets_v1(Some(old_entry()), Some(new_entry)), verified_all(), shards())

fn ids(affected: [AffectedConsumerV1]) -> [text]:
    var out: [text] = []
    for a in affected:
        out = out.push(a.consumer.stable_entity_id)
    out

fn encode_all(xs: [ReverseReferenceShardV1]) -> [[u8]]:
    var out: [[u8]] = []
    for s in xs:
        out = out.push(reverse_reference_shard_encode_v1(s))
    out

fn change(producer: SemanticQueryKeyV1, facet: text, old_fp: text, new_fp: text) -> ChangedSemanticFacetV1:
    ChangedSemanticFacetV1(producer: producer, facet: facet, dimension: GENERIC_FACET_DIMENSION_V1,
        old_fingerprint: Some(old_fp), new_fingerprint: Some(new_fp))

# ---- scenarios ---------------------------------------------------------------

describe "system: generic body edit":
    it "invalidates only the template object across both partitions (REQ-GRR-001)":
        step("Edit the Pair body and plan over the two-target shard set (REQ-GRR-001)")
        val plan = plan_edit(entry("Second", "trait:pkg_a.Eq", "body-v2"))
        expect(plan.accepted).to_equal(true)
        expect(plan.changed_facets).to_equal([GENERIC_FACET_BODY_V1])
        expect(ids(plan.affected)).to_equal(["pkg_a.Pair#object"])
        expect(plan.affected_partitions).to_equal([part(linux())])

describe "system: generic signature edit":
    it "invalidates the template object and every caller only (REQ-GRR-002)":
        step("Retype a Pair field and plan (REQ-GRR-002)")
        val plan = plan_edit(entry("i64", "trait:pkg_a.Eq", "body-v1"))
        expect(plan.accepted).to_equal(true)
        expect(plan.affected.len()).to_equal(3)
        expect(ids(plan.affected).contains("pkg_b.C1")).to_equal(true)
        expect(ids(plan.affected).contains("pkg_b.C2")).to_equal(true)
        expect(ids(plan.affected).contains("pkg_c.D")).to_equal(false)
        expect(ids(plan.affected).contains("app-windows")).to_equal(false)

describe "system: generic bound edit":
    it "invalidates the template object and every caller only (REQ-GRR-003)":
        step("Change the Pair bound and plan (REQ-GRR-003)")
        val plan = plan_edit(entry("Second", "trait:pkg_a.Ord", "body-v1"))
        expect(plan.accepted).to_equal(true)
        expect(plan.changed_facets).to_equal([GENERIC_FACET_BOUND_V1])
        expect(plan.affected.len()).to_equal(3)
        expect(ids(plan.affected).contains("app-linux")).to_equal(false)

describe "system: caller edit":
    it "restages only C1 and invalidates only C1's dependent (REQ-GRR-004)":
        step("Restage C1 with a new type-argument read and plan a C1 change (REQ-GRR-004)")
        val staged = stage_reverse_shards_v1(shards(), Some(c1_old()), c1_new(), true)
        expect(staged.accepted).to_equal(true)
        val result = affected_consumers_v1([change(key("tldr.concrete", "pkg_b.C1"),
            GENERIC_FACET_SIGNATURE_V1, digest("c1-sig"), digest("c1-sig-v2"))], [], verified_all(), staged.shards)
        expect(result.accepted).to_equal(true)
        expect(ids(result.affected)).to_equal(["pkg_c.D"])

describe "system: cfg-variant edit":
    it "moves the windows key and partition only (REQ-GRR-005)":
        step("Edit the windows-only decl and compare keys and affected partitions (REQ-GRR-005)")
        val kl_old = hir_variant_object_key_v1(MODULE, projection(linux(), "w-v1"), TOOLCHAIN)
        val kl_new = hir_variant_object_key_v1(MODULE, projection(linux(), "w-v2"), TOOLCHAIN)
        val kw_old = hir_variant_object_key_v1(MODULE, projection(windows(), "w-v1"), TOOLCHAIN)
        val kw_new = hir_variant_object_key_v1(MODULE, projection(windows(), "w-v2"), TOOLCHAIN)
        expect(kl_new).to_equal(kl_old)
        expect(kw_new == kw_old).to_equal(false)
        val pw_old = projection(windows(), "w-v1")
        val pw_new = projection(windows(), "w-v2")
        val result = affected_consumers_v1([change(hir_variant_object_producer_v1(MODULE, digest("profile"), pw_old),
            GENERIC_FACET_BODY_V1, pw_old.variant_digest, pw_new.variant_digest)], [], verified_all(), shards())
        expect(result.accepted).to_equal(true)
        expect(ids(result.affected)).to_equal(["app-windows"])
        expect(result.affected[0].partition_id).to_equal(part(windows()))
        expect(result.affected[0].partition_id == part(linux())).to_equal(false)

describe "system: unrelated edit":
    it "yields no changed facets and an accepted empty plan (REQ-GRR-006)":
        step("Plan an edit that leaves the template semantics unchanged (REQ-GRR-006)")
        val plan = plan_edit(old_entry())
        expect(plan.accepted).to_equal(true)
        expect(plan.changed_facets.len()).to_equal(0)
        expect(plan.affected.len()).to_equal(0)

describe "system: concurrent rebuild":
    it "stages identical canonical shards from the same prior and replays idempotently (REQ-GRR-007)":
        step("Stage the C1 edit twice concurrently from one prior, then replay (REQ-GRR-007)")
        val prior = shards()
        val a = stage_reverse_shards_v1(prior, Some(c1_old()), c1_new(), true)
        val b = stage_reverse_shards_v1(prior, Some(c1_old()), c1_new(), true)
        expect(a.accepted).to_equal(true)
        expect(encode_all(a.shards)).to_equal(encode_all(b.shards))
        expect(a.shards.len()).to_equal(2)
        val replay = stage_reverse_shards_v1(a.shards, Some(c1_new()), c1_new(), true)
        expect(encode_all(replay.shards)).to_equal(encode_all(a.shards))

describe "system: cache corruption":
    it "fails closed on corrupt shard bytes and a corrupt generic section (REQ-GRR-008)":
        step("Flip a shard byte and corrupt a generic section, then decode both (REQ-GRR-008)")
        val bytes = reverse_reference_shard_encode_v1(shards()[0])
        # Positive control first: the uncorrupted bytes decode, so the negative
        # result below is the corruption and not a vacuous decoder failure.
        expect(reverse_reference_shard_decode_v1(bytes).ok).to_equal(true)
        var bad = bytes
        if bytes[0] == 0:
            bad[0] = 1
        else:
            bad[0] = 0
        expect(reverse_reference_shard_decode_v1(bad).ok).to_equal(false)
        val section = generic_template_section_encode_v1(build_generic_template_section_v1([old_entry()]))
        val corrupt = section.replace(digest("body-v1"), digest("body-zz"))
        expect(generic_template_section_decode_v1(corrupt).ok).to_equal(false)
        expect(generic_template_section_decode_v1(section).ok).to_equal(true)

describe "system: one HIR, one object key per target":
    it "derives two distinct deterministic keys for one module (REQ-GRR-009)":
        step("Key the module for linux and windows from the same HIR, twice (REQ-GRR-009)")
        val kl = hir_variant_object_key_v1(MODULE, projection(linux(), "w-v1"), TOOLCHAIN)
        val kw = hir_variant_object_key_v1(MODULE, projection(windows(), "w-v1"), TOOLCHAIN)
        expect(kl.len()).to_equal(64)
        expect(kw.len()).to_equal(64)
        expect(kl == kw).to_equal(false)
        expect(hir_variant_object_key_v1(MODULE, projection(linux(), "w-v1"), TOOLCHAIN)).to_equal(kl)
        expect(hir_variant_object_key_v1(MODULE, projection(windows(), "w-v1"), TOOLCHAIN)).to_equal(kw)
        expect(part(linux()) == part(windows())).to_equal(false)

describe "system: first object latency":
    it "keeps first object within 10 s on a receipt (NFR-GRR-001)":
        step("Assert obj_done_ms - hir_start_ms <= 10000 on an in-memory receipt; the live measurement is self-hosted-only (NFR-GRR-001)")
        val receipt = NativeFileWorkerReceiptV1(module: MODULE, hir_start_ms: 1000, hir_done_ms: 1400,
            deps_ready_ms: 1500, mir_done_ms: 2600, obj_done_ms: 4200, status: "ok",
            object: "build/q/" + sha256_text(MODULE) + ".o")
        expect(receipt.status).to_equal("ok")
        expect(receipt.obj_done_ms - receipt.hir_start_ms).to_be_less_than(10001)
        expect(receipt.obj_done_ms).to_be_greater_than(receipt.mir_done_ms)
