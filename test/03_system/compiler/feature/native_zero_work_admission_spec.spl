use std.spec.*
use std.common.crypto.sha256.{sha256_text}
use compiler.driver.cache.native_noop_admission.{
    native_noop_request_v1, native_noop_admit_v1, native_noop_publish_v1,
    native_noop_admission_hit_v1, native_noop_admission_reason_v1,
    native_noop_admission_input_count_v1
}

extern fn rt_dir_create_all(path: text) -> bool
extern fn rt_file_write(path: text, content: text) -> bool
extern fn rt_file_read_regular_no_follow_bounded(path: text, max_bytes: i64) -> text?
extern fn rt_dir_remove_all(path: text) -> bool

fn zero_work_request(root: text, output: text):
    native_noop_request_v1(
        root, output, "llvm", "aarch64-apple-darwin", 2, true, false,
        false, "release", ["gc_sync_mut"], "", "rev-1", "tree-1",
        "inventory-1", "authority-1", sha256_text("env-1"),
        "invocation-1", ["main.spl"])

describe "MBH-NFR-002 native zero-work admission":
    it "admits unchanged bounded inputs before scheduler work":
        val root = "/tmp/simple-native-zero-work-admission-spec"
        val _removed = rt_dir_remove_all(root)
        expect(rt_dir_create_all(root)).to_equal(true)
        val source = "{root}/main.spl"
        val output = "{root}/app"
        expect(rt_file_write(source, "fn main():\n    print 1\n")).to_equal(true)
        expect(rt_file_write(output, "native-output-v1")).to_equal(true)
        val request = zero_work_request(root, output)
        expect(native_noop_publish_v1(request, [source])).to_equal("ok")
        val admitted = native_noop_admit_v1(request)
        expect(native_noop_admission_hit_v1(admitted)).to_equal(true)
        expect(native_noop_admission_reason_v1(admitted)).to_equal("ok")
        expect(native_noop_admission_input_count_v1(admitted)).to_equal(1)

    it "fails closed on source, output, provenance, and interrupted pointer publication":
        val root = "/tmp/simple-native-zero-work-mutation-spec"
        val _removed = rt_dir_remove_all(root)
        expect(rt_dir_create_all(root)).to_equal(true)
        val source = "{root}/main.spl"
        val output = "{root}/app"
        expect(rt_file_write(source, "fn main():\n    print 1\n")).to_equal(true)
        expect(rt_file_write(output, "native-output-v1")).to_equal(true)
        val request = zero_work_request(root, output)
        expect(native_noop_publish_v1(request, [source])).to_equal("ok")
        expect(rt_file_write(source, "fn main():\n    print 2\n")).to_equal(true)
        expect(native_noop_admission_hit_v1(native_noop_admit_v1(request))).to_equal(false)
        expect(rt_file_write(source, "fn main():\n    print 1\n")).to_equal(true)
        expect(rt_file_write(output, "corrupt-output")).to_equal(true)
        expect(native_noop_admission_hit_v1(native_noop_admit_v1(request))).to_equal(false)
        val wrong_provenance = native_noop_request_v1(
            root, output, "llvm", "aarch64-apple-darwin", 2, true, false,
            false, "release", ["gc_sync_mut"], "", "rev-1", "tree-2",
            "inventory-1", "authority-1", sha256_text("env-1"),
            "invocation-1", ["main.spl"])
        expect(native_noop_admission_hit_v1(native_noop_admit_v1(wrong_provenance))).to_equal(false)
        val interrupted_root = "/tmp/simple-native-zero-work-interrupted-spec"
        val _removed_interrupted = rt_dir_remove_all(interrupted_root)
        expect(rt_dir_create_all(interrupted_root)).to_equal(true)
        expect(rt_file_write("{interrupted_root}/CURRENT.tmp.999", "orphan")).to_equal(true)
        expect(native_noop_admission_hit_v1(native_noop_admit_v1(
            zero_work_request(interrupted_root, output)))).to_equal(false)
