# @req KPM-REQ-008 KPM-REQ-009 KPM-NFR-006
use std.spec.*
use std.io_runtime.{process_run}

describe "Phase 5 backend relocation and policy dispatch":
    it "admits the selected relocated backend table":
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-phase5-backend-dispatch.shs"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("KPM_PHASE5_POLICY_DISPATCH_RECEIPT case=llvm-cranelift state=BEGIN")
        expect(stdout).to_contain("KPM_PHASE5_POLICY_DISPATCH_RECEIPT case=llvm-cranelift state=PASS")
        expect(stdout).to_contain("KPM_PHASE5_BACKEND_RELOCATION_RECEIPT case=canonical-map state=PASS")
        expect(stdout).to_contain("KPM_PHASE5_COMPILER_PLUGIN_IMPORT_RECEIPT case=kernel-source state=PASS")
        expect(stdout).to_contain("backends are relocated")

    it "refuses direct, misplaced, and policy-unbound dispatch":
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-phase5-backend-dispatch.shs", "--selftest"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("KPM_PHASE5_BACKEND_RELOCATION_MUTATION_RECEIPT=FAIL_AT_EXACT_ASSERTION")
        expect(stdout).to_contain("KPM_PHASE5_POLICY_DISPATCH_MUTATION_RECEIPT=FAIL_AT_EXACT_ASSERTION")
        expect(stdout).to_contain("KPM_PHASE5_COMPILER_PLUGIN_IMPORT_MUTATION_RECEIPT=FAIL_AT_EXACT_ASSERTION")
        expect(stdout).to_contain("rejected 9/9 relocation, boundary, and dispatch mutations")

    it "is mutation-red at the identical policy dispatch checker":
        val (stdout, stderr, status) = process_run("sh", ["scripts/check/check-kernel-plugin-migration-evidence-matrix.shs", "--selftest"])
        expect(status).to_equal(0)
        expect(stderr).to_equal("")
        expect(stdout).to_contain("KPM_PHASE5_BACKEND_DISPATCH_STATUS=FAIL")
        expect(stdout).to_contain("KPM_PHASE5_POLICY_DISPATCH_MUTATION_RECEIPT=FAIL_AT_EXACT_ASSERTION")
