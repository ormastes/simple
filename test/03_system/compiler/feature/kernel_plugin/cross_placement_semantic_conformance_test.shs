#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../../../.." && pwd)
cd "$ROOT"
OUT=build/providers/kpf-semantic-conformance
mkdir -p "$OUT"
provider="$OUT/provider.so"
runtime=${SIMPLE_RUNTIME:-bin/simple}
[ -x "$runtime" ] || { echo "SIMPLE_RUNTIME must name an admitted Simple executable" >&2; exit 2; }
source=${KPF_PROVIDER_SOURCE:-src/runtime/test/cli_provider_v1_fixture.c}
cc -std=c11 -O2 -fPIC -shared "$source" -o "$provider"
output=$("$runtime" test --clean test/03_system/compiler/feature/kernel_plugin/cross_placement_semantic_conformance_spec.spl --mode=interpreter)
printf '%s\n' "$output"
printf '%s\n' "$output" | grep -q 'Passed: 2'
