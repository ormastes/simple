use std.spec.{describe, it, expect}
use std.spec.step
use std.nogc_sync_mut.io.file_ops.file_read_bytes
use os.smf.provider_loader.provider_artifact_digest_v1
use app.test.kpf_cross_placement_conformance.{kpf_cross_placement_conformance, kpf_cross_placement_sci_mutation_rejected}

val PROVIDER = "build/providers/kpf-semantic-conformance/provider.so"

describe "KPF semantic cross-placement conformance":
    it "executes one sealed operation through every supported placement":
        step("seal SCI and generation, then compare static native worker and Wasm results")
        val digest = provider_artifact_digest_v1(file_read_bytes(PROVIDER) ?? [])
        expect(kpf_cross_placement_conformance(PROVIDER, digest)).to_equal(0)

    it "rejects a mutated sealed composition before placement execution":
        step("change one authenticated SCI byte and require fail-closed decoding")
        val digest = provider_artifact_digest_v1(file_read_bytes(PROVIDER) ?? [])
        expect(kpf_cross_placement_sci_mutation_rejected(PROVIDER, digest)).to_equal(true)
