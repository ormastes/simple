# @tag:in-development
# Tracks: kernel_plugin_fabric migration Wave 0
"""# KPF K0g Import Closure

Runs the fail-closed closure verifier against both its mutation fixtures and
the production K0g roots. Missing roots and zero checked files are failures.
"""
use std.spec.*
use std.io.{shell_bool}

describe "KPF K0g import closure":
    it "should reject escaped imports, malformed manifests, and empty closures":
        step("Calibrate the K0g verifier with clean and deliberate-red fixtures")
        expect(shell_bool("sh scripts/check/kernel-plugin-fabric/check-k0g-import-closure.shs --selftest")).to_be(true)

    it "should classify a non-empty production K0g closure":
        step("Verify every production K0g source import against the declared closure")
        expect(shell_bool("sh scripts/check/kernel-plugin-fabric/check-k0g-import-closure.shs")).to_be(true)
