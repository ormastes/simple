# @req MBH-REQ-002 MBH-REQ-003 MBH-REQ-004 MBH-REQ-005 MBH-REQ-006 MBH-NFR-004
use std.spec.*
use std.io.{file_read}
use std.io_runtime.{process_run}

fn check_reverse_reference_key_v1_frame() -> text:
    file_read("src/compiler/00.common/cache/reverse_reference_key.spl") ?? ""

fn check_reverse_reference_projection_receipt() -> text:
    file_read("src/compiler/80.driver/cache/reverse_reference_receipt.spl") ?? ""

fn check_reverse_reference_owner_facts() -> text:
    file_read("src/compiler/00.common/cache/reverse_reference_facts.spl") ?? ""

fn check_macos_bootstrap_receipt_v1() -> text:
    file_read("scripts/check/check-macos-bootstrap-receipt.shs") ?? ""

fn check_phase_compatibility_manifest() -> text:
    file_read("src/compiler/00.common/cache/phase_compatibility_manifest.spl") ?? ""

fn check_native_macho_slice_receipt() -> text:
    file_read("scripts/check/check-macos-reverse-reference-m4.shs") ?? ""

fn check_full_cli_test_runner_build_receipt() -> text:
    file_read("scripts/check/check-macos-reverse-reference-m4.shs") ?? ""

fn check_producer_bound_cache_identity() -> text:
    file_read("src/app/build/targets/action_identity.spl") ?? ""

fn check_universal_promotion_without_rebuild() -> text:
    file_read("scripts/release/macos-universal-m5.shs") ?? ""

fn check_driver_hir_alias_registration() -> text:
    file_read("src/compiler/80.driver/driver_hir_pipeline_lowering.spl") ?? ""

fn check_trait_owner_publication() -> text:
    file_read("src/compiler/25.traits/trait_solver.spl") ?? ""

fn check_unresolved_method_owner_publication() -> text:
    file_read("src/compiler/35.semantics/resolve_strategies.spl") ?? ""

fn check_annotation_owner_publication() -> text:
    file_read("src/compiler/20.hir/hir_lowering/_Items/declaration_lowering.spl") ?? ""

fn check_generic_owner_publication() -> text:
    file_read("src/compiler/40.mono/monomorphize/note_sdn.spl") ?? ""

fn check_initializer_owner_publication() -> text:
    file_read("src/compiler/50.mir/_MirLowering/module_lowering.spl") ?? ""

fn check_runtime_provider_owner_publication() -> text:
    file_read("src/compiler/70.backend/backend/llvm_native_link_orchestrator.spl") ?? ""

fn check_relocation_owner_publication() -> text:
    file_read("src/compiler/70.backend/linker/symbol_analysis.spl") ?? ""

fn check_aop_owner_publication() -> text:
    file_read("src/compiler/85.mdsoc/aop_index/reverse_index.spl") ?? ""

fn run_script(path: text, args: [text]) -> (text, text, i64):
    process_run("/bin/sh", [path].concat(args))

describe "macOS bootstrap reverse-reference harmonization":
    it "keeps M0 and M1 structural evidence separate from native admission":
        step("Build the native thin compiler lane")
        val (output, errors, status) = process_run(
            "/bin/sh", ["scripts/check/check-macos-bootstrap-receipt.shs", "--portable"])
        expect(status).to_equal(0)
        expect(errors).to_equal("")
        expect(output).to_contain("STRUCTURAL_ONLY")
        expect(check_macos_bootstrap_receipt_v1()).to_contain("--portable")
        expect(check_producer_bound_cache_identity()).to_contain("NativeActionInputIdentityV1")

    it "binds M2 projection receipts to the canonical framed key":
        step("Publish ReverseReferenceKeyV1 projection receipts")
        expect(check_reverse_reference_key_v1_frame()).to_contain("ReverseReferenceKeyV1")
        expect(check_reverse_reference_projection_receipt()).to_contain("ReverseReferenceGenerationReceiptV1")
        expect(check_reverse_reference_owner_facts()).to_contain("reverse_reference_register_trait_candidate_v1")
        expect(check_reverse_reference_owner_facts()).to_contain("reverse_reference_register_runtime_provider_v1")
        expect(check_reverse_reference_projection_receipt()).to_contain("owner_generation")
        expect(check_reverse_reference_projection_receipt()).to_contain("root_generation")

    it "wires every production reverse-reference owner through source aliases":
        step("Audit the ten-family owner publication paths")
        expect(check_driver_hir_alias_registration()).to_contain(
            "reverse_reference_owner_register_source_alias_v1")
        expect(check_driver_hir_alias_registration()).to_contain(
            "driver_register_parser_module_source_aliases_v1")
        expect(check_trait_owner_publication()).to_contain(
            "reverse_reference_register_trait_candidate_v1")
        expect(check_trait_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"trait-type-implementation\")")
        expect(check_unresolved_method_owner_publication()).to_contain(
            "reverse_reference_register_unresolved_method_v1")
        expect(check_unresolved_method_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"unresolved-method-candidate\")")
        expect(check_annotation_owner_publication()).to_contain(
            "reverse_reference_register_annotation_v1")
        expect(check_annotation_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"annotation-consumer\")")
        expect(check_generic_owner_publication()).to_contain(
            "reverse_reference_register_generic_specialization_v1")
        expect(check_generic_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"generic-specialization\")")
        expect(check_aop_owner_publication()).to_contain(
            "reverse_reference_register_aop_v1")
        expect(check_aop_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"aop-consumer\")")
        expect(check_runtime_provider_owner_publication()).to_contain(
            "reverse_reference_register_runtime_provider_v1")
        expect(check_runtime_provider_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"runtime-provider\")")
        expect(check_initializer_owner_publication()).to_contain(
            "reverse_reference_register_initializer_v1")
        expect(check_initializer_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"initializer-dependent\")")
        expect(check_relocation_owner_publication()).to_contain(
            "reverse_reference_register_relocation_v1")
        expect(check_relocation_owner_publication()).to_contain(
            "reverse_reference_owner_mark_known_v1(\"emitted-symbol-relocation\")")

    it "drives the ten reverse-reference families through focused acceptance":
        step("Run the reverse-reference owner acceptance checker")
        val (output, errors, status) = run_script(
            "scripts/check/check-macos-reverse-reference-owner-publication.shs", [])
        expect(status == 0 or status == 2).to_equal(true)
        if status == 0:
            expect(errors).to_equal("")
            expect(output).to_contain("Results:")
        else:
            expect(errors).to_contain("BLOCKED: self-hosted runtime unavailable")

    it "fails the identical checker when any owner publication is bypassed":
        step("Mutate each publication and require acceptance to fail")
        val (output, errors, status) = run_script(
            "scripts/check/check-macos-reverse-reference-owner-publication-mutations.shs", [])
        expect(status == 0 or status == 2).to_equal(true)
        if status == 0:
            expect(errors).to_equal("")
            expect(output).to_contain("PASS: reverse-reference owner publication mutations rejected")
        else:
            expect(errors).to_contain("BLOCKED: self-hosted runtime unavailable")

    it "keeps M3 compatible reuse fail closed under receipt drift":
        step("Attempt compatible Phase 2 to Phase 3 reuse")
        val (output, errors, status) = process_run(
            "/bin/sh", ["scripts/check/check-m3-phase2-phase3-production.shs"])
        expect(status).to_equal(0)
        expect(errors).to_equal("")
        expect(output).to_contain("M3 production publication, admission, ownership, and materialization wiring")
        expect(check_phase_compatibility_manifest()).to_contain("reverse_reference_receipt_digest")

    it "keeps M4 and M5 native qualification blocked without retained native evidence":
        step("Compose and admit the universal candidate")
        val (m4_output, m4_errors, m4_status) = process_run(
            "/bin/sh", ["scripts/check/check-macos-reverse-reference-m4.shs", "--self-test"])
        expect(m4_status).to_equal(0)
        expect(m4_errors).to_equal("")
        expect(m4_output).to_contain("M4 structural self-test PASS: 8 fixtures")
        val (m5_output, m5_errors, m5_status) = process_run(
            "/bin/sh", ["scripts/check/check-macos-universal-m5.shs"])
        expect(m5_status).to_equal(0)
        expect(m5_errors).to_equal("")
        expect(m5_output).to_contain("M5 portable structural self-test PASS")
        expect(m5_output).to_contain("M5 native status: BLOCKED")
        expect(check_native_macho_slice_receipt()).to_contain("require_native_macho")
        expect(check_full_cli_test_runner_build_receipt()).to_contain("tool-builds.env")
        expect(check_universal_promotion_without_rebuild()).to_contain("pointer-only")
