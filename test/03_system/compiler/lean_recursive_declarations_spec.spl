# codex-system-test
# @manual: show
# @req: C2, REQ-C2-REC-001, REQ-C2-REC-002, REQ-C2-REC-003, REQ-C2-REC-004, REQ-C2-REC-005
# Tests authored before implementation; source-predicted RED, all execution UNRUN.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirInst, MirInstKind, AggregateKind, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use plugins.backend_lean.lean_backend.{LeanBackend, LeanBuilder, VerificationLevel}
use compiler.backend.backend.lean_backend.{LeanBackend as CompilerLeanBackend, LeanBuilder as CompilerLeanBuilder, VerificationLevel as CompilerVerificationLevel}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations}

fn rec_ty(kind: MirTypeKind) -> MirType: MirType(kind: kind)
fn rec_struct_ty(id: i64) -> MirType: rec_ty(MirTypeKind.Struct(SymbolId(id: id)))
fn rec_enum_ty(id: i64) -> MirType: rec_ty(MirTypeKind.Enum(SymbolId(id: id)))
fn rec_field(name: text, type_: MirType) -> MirFieldDef:
    MirFieldDef(name: name, type_: type_, offset: 0, has_bits_attr: false, bits_width: 0)
fn rec_struct(id: i64, name: text, fields: [MirFieldDef]) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Struct(fields), is_export_c: false, export_name: "")
fn rec_enum(id: i64, name: text, payload: MirType) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Enum([
        MirVariantDef(name: "Done", discriminant: -5, payload: nil),
        MirVariantDef(name: "More", discriminant: 13, payload: Some(payload))]), is_export_c: false, export_name: "")
fn rec_module(definitions: [MirTypeDef]) -> MirModule:
    var types: Dict<SymbolId, MirTypeDef> = {}
    for definition in definitions: types[definition.symbol] = definition
    MirModule(name: "RecFixture", functions: {}, statics: {}, constants: {}, types: types)

fn rec_outputs(module: MirModule) -> [text]:
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    [plugin.export_module(module).unwrap().lean_code,
     plugin.export_generated_module(module).unwrap().lean_code,
     compiler.export_module(module).unwrap().lean_code,
     compiler.export_generated_module(module).unwrap().lean_code]

fn rec_refusal(module: MirModule, reason: text):
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    for result in [plugin.export_module(module), plugin.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    for result in [compiler.export_module(module), compiler.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    var plugin_builder = LeanBuilder.create()
    plugin_builder.emit("retained")
    expect(plugin.export_types(plugin_builder, module).is_err()).to_equal(true)
    expect(plugin_builder.build()).to_equal("retained")
    var compiler_builder = CompilerLeanBuilder.create()
    compiler_builder.emit("retained")
    expect(compiler.export_types(compiler_builder, module).is_err()).to_equal(true)
    expect(compiler_builder.build()).to_equal("retained")

fn rec_copy(id: i64) -> MirOperand: MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))
fn rec_local(id: i64, type_: MirType, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: kind, is_ghost: false)
fn rec_roundtrip() -> MirFunction:
    val state = rec_enum_ty(2)
    MirFunction(symbol: SymbolId(id: 90), name: "roundtrip",
        signature: MirSignature(params: [state], return_type: state, is_variadic: false, params_known: true),
        locals: [rec_local(0, state, LocalKind.Arg(0)), rec_local(1, rec_struct_ty(1), LocalKind.Temp), rec_local(2, state, LocalKind.Temp)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: [
            MirInst(kind: MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 1)), [rec_copy(0)]), span: nil),
            MirInst(kind: MirInstKind.GetField(LocalId(id: 2), rec_copy(1), 0), span: nil)],
            terminator: MirTerminator.Ret(Some(rec_copy(2))))],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)

describe "recursive semantic declarations through both retained backend owners":
    it "exports a self-recursive enum through all four public module APIs":
        step("Export positive recursive declarations")
        for code in rec_outputs(rec_module([rec_enum(2, "Chain", rec_enum_ty(2))])):
            expect(code).to_contain("mutual\n  inductive __MirTypes.«Chain» where\n    | «Done»\n    | «More» : _root_.Simple.RecFixture.__MirTypes.«Chain» → __MirTypes.«Chain»\nend\n")
            expect(code).to_contain("(\"More\", 13, some \"{\\\"Enum\\\":2}\")")
            expect(code.contains("axiom ")).to_equal(false)
            expect(code.contains("sorry")).to_equal(false)

    it "exports direct self-recursive structs with exact constructor and projection names":
        val module = rec_module([rec_struct(1, "Node", [rec_field("next", rec_struct_ty(1))])])
        for code in rec_outputs(module):
            expect(code).to_contain("inductive __MirTypes.«Node» where\n    | mk : _root_.Simple.RecFixture.__MirTypes.«Node» → __MirTypes.«Node»")
            expect(code).to_contain("end\ndef __MirTypes.«Node».«next» (_value : _root_.Simple.RecFixture.__MirTypes.«Node») : _root_.Simple.RecFixture.__MirTypes.«Node» :=\n  match _value with\n  | _root_.Simple.RecFixture.__MirTypes.«Node».mk _field0 => _field0")

    it "groups mutual enum and struct declarations and retains real body construction and projection":
        step("Construct and project recursive values")
        var module = rec_module([rec_struct(1, "Left", [rec_field("right", rec_enum_ty(2))]), rec_enum(2, "Right", rec_struct_ty(1))])
        val function = rec_roundtrip()
        module.functions[function.symbol] = function
        for code in rec_outputs(module):
            expect(code).to_contain("mutual\n  inductive __MirTypes.«Left» where")
            expect(code).to_contain("  inductive __MirTypes.«Right» where")
            expect(code).to_contain("let _l1 : _root_.Simple.RecFixture.__MirTypes.«Left» := _root_.Simple.RecFixture.__MirTypes.«Left».mk (_l0)")
            expect(code).to_contain("let _l2 : _root_.Simple.RecFixture.__MirTypes.«Right» := _root_.Simple.RecFixture.__MirTypes.«Left».«right» (_l1)")
            expect(code).to_contain("\n  _l2\n")

    it "keeps same-short-name mutual enums and their metadata identities distinct":
        val module = rec_module([rec_enum(1, "alpha.Value", rec_enum_ty(2)), rec_enum(2, "beta.Value", rec_enum_ty(1))])
        for code in rec_outputs(module):
            expect(code).to_contain("| «More» : _root_.Simple.RecFixture.__MirTypes.«beta».«Value» → __MirTypes.«alpha».«Value»")
            expect(code).to_contain("| «More» : _root_.Simple.RecFixture.__MirTypes.«alpha».«Value» → __MirTypes.«beta».«Value»")
            expect(code).to_contain("def __MirTypeMetadata.t1 : Int × String × Bool × String := (1, \"alpha.Value\", false, \"\")")
            expect(code).to_contain("def __MirTypeMetadata.t2 : Int × String × Bool × String := (2, \"beta.Value\", false, \"\")")

    it "supports positive recursion nested through slice tuple and result":
        step("Inspect admitted positive wrappers")
        val nested = rec_ty(MirTypeKind.Slice(rec_ty(MirTypeKind.Tuple([
            rec_ty(MirTypeKind.Result(rec_enum_ty(2), rec_ty(MirTypeKind.U8))), rec_enum_ty(2)]))))
        for code in rec_outputs(rec_module([rec_enum(2, "Tree", nested)])):
            expect(code).to_contain("_root_.Array ((_root_.Except (_root_.BitVec 8) (_root_.Simple.RecFixture.__MirTypes.«Tree») × _root_.Simple.RecFixture.__MirTypes.«Tree»))")
            expect(code).to_contain("× _root_.Simple.RecFixture.__MirTypes.«Tree»")

    it "orders groups after dependencies and before their users independently of insertion":
        step("Compare deterministic component order")
        val z = rec_struct(9, "Z", [])
        val left = rec_struct(1, "Left", [rec_field("right", rec_enum_ty(2)), rec_field("z", rec_struct_ty(9))])
        val right = rec_enum(2, "Right", rec_struct_ty(1))
        val user = rec_struct(3, "AUser", [rec_field("left", rec_struct_ty(1))])
        val first = rec_module([user, right, z, left])
        val second = rec_module([left, z, right, user])
        val plan = lean_plan_type_declarations(first, "Simple.RecFixture").unwrap()
        expect(plan.declarations.map(_.symbol)).to_equal([9, 1, 2, 3])
        expect(plan.groups.len()).to_equal(3)
        expect(plan.groups[1].recursive).to_equal(true)
        expect(rec_outputs(first)).to_equal(rec_outputs(second))

    it "preserves byte-exact acyclic builder output and the old lexical ready selection":
        val dependency = rec_struct(2, "Z", [])
        val user = rec_struct(1, "A", [rec_field("z", rec_struct_ty(2))])
        val independent = rec_struct(3, "M", [])
        val module = rec_module([user, independent, dependency])
        var builder = LeanBuilder.create()
        LeanBackend.create(VerificationLevel.Contracts).export_types(builder, module).unwrap()
        expect(builder.build()).to_equal("-- MIR semantic types; retained metadata is not a native-layout proof\n\nstructure __MirTypes.«M» where\ndef __MirTypeMetadata.t3 : Int × String × Bool × String := (3, \"M\", false, \"\")\ndef __MirTypeMetadata.t3_fields : List (String × String × Int) := []\n\nstructure __MirTypes.«Z» where\ndef __MirTypeMetadata.t2 : Int × String × Bool × String := (2, \"Z\", false, \"\")\ndef __MirTypeMetadata.t2_fields : List (String × String × Int) := []\n\nstructure __MirTypes.«A» where\n  «z» : _root_.Simple.RecFixture.__MirTypes.«Z»\ndef __MirTypeMetadata.t1 : Int × String × Bool × String := (1, \"A\", false, \"\")\ndef __MirTypeMetadata.t1_fields : List (String × String × Int) := [(\"z\", \"{\\\"Struct\\\":2}\", 0)]")

    it "exports recursive finite arrays under outer wrappers while retaining acyclic vector fields":
        step("Export exact recursive finite arrays")
        val vector = rec_ty(MirTypeKind.Array(rec_enum_ty(2), 3))
        for code in rec_outputs(rec_module([rec_enum(2, "Fixed", rec_ty(MirTypeKind.Result(vector, rec_ty(MirTypeKind.Unit))))])):
            expect(code).to_contain("_root_.Except (_root_.Unit) ((_root_.Fin 3 → _root_.Simple.RecFixture.__MirTypes.«Fixed»))")
        val scalar_vector = rec_ty(MirTypeKind.Array(rec_ty(MirTypeKind.U8), 3))
        val module = rec_module([rec_struct(1, "Node", [rec_field("children", rec_ty(MirTypeKind.Slice(rec_struct_ty(1)))), rec_field("bytes", scalar_vector)])])
        for code in rec_outputs(module): expect(code).to_contain("_root_.Vector (_root_.BitVec 8) 3")

    it "rejects negative-position function pointer recursion instead of guessing positivity":
        val signature = MirSignature(params: [rec_struct_ty(1)], return_type: rec_ty(MirTypeKind.Bool), is_variadic: false, params_known: true)
        rec_refusal(rec_module([rec_struct(1, "Bad", [rec_field("apply", rec_ty(MirTypeKind.FuncPtr(signature)))])]), "has no faithful Lean 4 representation")

    it "rejects unknown and kind-mismatched recursive references before touching either builder":
        step("Reject malformed recursive identity")
        rec_refusal(rec_module([rec_enum(2, "Unknown", rec_enum_ty(99))]), "unresolved nominal symbol 99")
        rec_refusal(rec_module([rec_enum(2, "Wrong", rec_struct_ty(2))]), "nominal kind mismatch for symbol 2")

    it "rejects mismatched table keys duplicate names and reserved recursive members":
        var module = rec_module([rec_enum(2, "Chain", rec_enum_ty(2))])
        module.types[SymbolId(id: 1)] = rec_enum(3, "WrongKey", rec_enum_ty(2))
        rec_refusal(module, "type table key disagrees")
        rec_refusal(rec_module([rec_enum(1, "Same", rec_enum_ty(1)), rec_enum(2, "Same", rec_enum_ty(2))]), "duplicate type name")
        rec_refusal(rec_module([rec_struct(1, "Bad", [rec_field("rec", rec_struct_ty(1))])]), "reserved or duplicate field")
        rec_refusal(rec_module([rec_enum(2, "Injected\naxiom bad : False", rec_enum_ty(2))]), "invalid or duplicate type name")

    it "retains union refusal even when a valid recursive group precedes it":
        val union_definition = MirTypeDef(symbol: SymbolId(id: 4), name: "Union", kind: MirTypeDefKind.Union([rec_enum_ty(2)]), is_export_c: false, export_name: "")
        rec_refusal(rec_module([rec_enum(2, "Chain", rec_enum_ty(2)), union_definition]), "union declaration")

    it "rejects nested-recursion auxiliary names before emitting a recursive group":
        for name in ["rec_1", "below_1", "brecOn_1"]:
            val field = rec_field(name, rec_ty(MirTypeKind.Slice(rec_struct_ty(1))))
            rec_refusal(rec_module([rec_struct(1, "Nested", [field])]), "reserved recursive member")

    it "rejects generated SizeOf member families for recursive structs and enums atomically":
        step("Reject generated recursive SizeOf collisions")
        for name in ["_sizeOf_1", "_sizeOf_2", "_sizeOf_1_eq", "_sizeOf_inst"]:
            val field = rec_field(name, rec_ty(MirTypeKind.Slice(rec_struct_ty(1))))
            rec_refusal(rec_module([rec_struct(1, "Sized", [field])]), "reserved recursive member")
            val definition = MirTypeDef(symbol: SymbolId(id: 2), name: "SizedEnum",
                kind: MirTypeDefKind.Enum([
                    MirVariantDef(name: "Done", discriminant: 0, payload: nil),
                    MirVariantDef(name: name, discriminant: 1, payload: Some(rec_ty(MirTypeKind.Slice(rec_enum_ty(2)))))]),
                is_export_c: false, export_name: "")
            rec_refusal(rec_module([definition]), "reserved recursive member")

    it "retains valid recursive fields and variants adjacent to reserved SizeOf families":
        for name in ["_sizeOf_word", "_sizeOf_1_extra", "_sizeOf_word_eq"]:
            val field = rec_field(name, rec_ty(MirTypeKind.Slice(rec_struct_ty(1))))
            for code in rec_outputs(rec_module([rec_struct(1, "Valid", [field])])):
                expect(code).to_contain("def __MirTypes.«Valid».«{name}»")
            val definition = MirTypeDef(symbol: SymbolId(id: 2), name: "ValidEnum",
                kind: MirTypeDefKind.Enum([
                    MirVariantDef(name: "Done", discriminant: 0, payload: nil),
                    MirVariantDef(name: name, discriminant: 1, payload: Some(rec_ty(MirTypeKind.Slice(rec_enum_ty(2)))))]),
                is_export_c: false, export_name: "")
            for code in rec_outputs(rec_module([definition])):
                expect(code).to_contain("| «{name}» : _root_.Array (_root_.Simple.RecFixture.__MirTypes.«ValidEnum»)")
