# @cover src/app/test_runner_new/main.spl 0%
# codex-system-test
"""# Deployed test-runner ABI admission

This scenario proves that the production wrapper reaches a healthy deployed
pure-Simple test runner. A signal exit is a deployment failure; the Rust seed
is not an alternate runner.
"""

use std.spec.{describe, it, expect, step}
use app.io.mod.{process_run_timeout}

val DEPLOYED_SIMPLE = "bin/release/simple"

describe "Deployed pure-Simple test-runner ABI":
    it "should complete the production test help path without a signal exit":
        # @req: REQ-BSPLIT-006
        step("Run the deployed pure-Simple test ABI probe")
        val (stdout, stderr, code) = process_run_timeout(DEPLOYED_SIMPLE, ["test", "--help"], 15000)
        expect(code).to_equal(0)
        expect(stdout + stderr).to_contain("test")
