# codex-system-test
# @manual: show
# @req: REQ-MC-007, C2
# Authored executable contracts. Runner and generated Lean checking are UNRUN.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use plugins.backend_lean.lean_backend.{LeanBackend, VerificationLevel, LeanBuilder}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations, lean_context_type_to_lean}

fn field(name: text, kind: MirTypeKind, offset: i64) -> MirFieldDef:
    MirFieldDef(name: name, type_: MirType(kind: kind), offset: offset, has_bits_attr: false, bits_width: 0)

fn structure(id: i64, name: text, fields: [MirFieldDef]) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Struct(fields), is_export_c: false, export_name: "")

fn enumeration(id: i64, name: text, variants: [MirVariantDef]) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Enum(variants), is_export_c: false, export_name: "")

fn module_with_types(definitions: [MirTypeDef]) -> MirModule:
    var types: Dict<SymbolId, MirTypeDef> = {}
    for definition in definitions: types[definition.symbol] = definition
    MirModule(name: "DeclarationFixture", functions: {}, statics: {}, constants: {}, types: types)

fn export_code(module: MirModule) -> text:
    LeanBackend.create(VerificationLevel.Contracts).export_module(module).unwrap().lean_code

fn export_error(module: MirModule) -> text:
    match LeanBackend.create(VerificationLevel.Contracts).export_module(module):
        case Err(error): error.message
        case Ok(_):
            assert(false)
            "unexpected success"

fn packet_type() -> MirTypeDef:
    structure(7, "wire.Packet", [field("byte", MirTypeKind.U8, 0), field("count", MirTypeKind.I32, 4)])

fn state_type() -> MirTypeDef:
    enumeration(9, "wire.State", [
        MirVariantDef(name: "Idle", discriminant: -3, payload: nil),
        MirVariantDef(name: "Packet", discriminant: 12, payload: Some(MirType(kind: MirTypeKind.Struct(SymbolId(id: 7)))))])

fn identity_function() -> MirFunction:
    val type_ = MirType(kind: MirTypeKind.Struct(SymbolId(id: 7)))
    MirFunction(symbol: SymbolId(id: 20), name: "identityPacket",
        signature: MirSignature(params: [type_], return_type: type_, is_variadic: false, params_known: true),
        locals: [MirLocal(id: LocalId(id: 0), name: Some("packet"), type_: type_, kind: LocalKind.Arg(0), is_ghost: false)],
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: [], terminator: MirTerminator.Ret(Some(MirOperand(kind: MirOperandKind.Copy(LocalId(id: 0))))))],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)

describe "MIR structure and enum declaration export":
    it "exports exact fields, scalar widths and qualified enum payloads":
        step("Export registered structures and enums")
        val code = export_code(module_with_types([state_type(), packet_type()]))
        expect(code).to_contain("structure __MirTypes.«wire».«Packet» where\n  «byte» : _root_.BitVec 8\n  «count» : _root_.BitVec 32")
        expect(code).to_contain("inductive __MirTypes.«wire».«State» where\n  | «Idle»\n  | «Packet» : _root_.Simple.DeclarationFixture.__MirTypes.«wire».«Packet» → __MirTypes.«wire».«State»")
        expect(code).to_contain("def __MirTypeMetadata.t9_variants : List (String × Int × Option String) := [(\"Idle\", -3, none), (\"Packet\", 12, some \"{\\\"Struct\\\":7}\")]")

    it "orders dependencies before lexically earlier users independently of map insertion":
        step("Compare deterministic declaration order")
        val dependency = structure(2, "Z", [field("value", MirTypeKind.U16, 0)])
        val user = structure(1, "A", [field("nested", MirTypeKind.Struct(SymbolId(id: 2)), 0)])
        val first = module_with_types([user, dependency])
        val second = module_with_types([dependency, user])
        val plan = lean_plan_type_declarations(first, "Simple.DeclarationFixture").unwrap()
        expect(plan.declarations[0].symbol).to_equal(2)
        expect(plan.declarations[1].symbol).to_equal(1)
        expect(export_code(first)).to_equal(export_code(second))

    it "uses the same declarations in regeneration and full module exports":
        val module = module_with_types([packet_type()])
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val full = backend.export_module(module).unwrap().lean_code
        val generated = backend.export_generated_module(module).unwrap().lean_code
        val namespace_body = full.split("namespace Simple.DeclarationFixture")[1]
        expect(generated).to_end_with("namespace Simple.DeclarationFixture" + namespace_body)

    it "threads admitted nominal types into real function parameters and results":
        var module = module_with_types([packet_type()])
        val function = identity_function()
        module.functions[function.symbol] = function
        val code = export_code(module)
        expect(code).to_contain("def identityPacket (_l0 : _root_.Simple.DeclarationFixture.__MirTypes.«wire».«Packet») : _root_.Simple.DeclarationFixture.__MirTypes.«wire».«Packet» :=\n  _l0")

    it "preserves field order, offsets, signedness and explicit enum tags as data":
        step("Retain source layout identity")
        val original = export_code(module_with_types([packet_type()]))
        val changed = export_code(module_with_types([structure(7, "wire.Packet", [field("byte", MirTypeKind.I8, 0), field("count", MirTypeKind.I32, 8)])]))
        expect(original).to_contain("(\"byte\", \"\\\"U8\\\"\", 0), (\"count\", \"\\\"I32\\\"\", 4)")
        expect(changed).to_contain("(\"byte\", \"\\\"I8\\\"\", 0), (\"count\", \"\\\"I32\\\"\", 8)")
        expect(changed == original).to_equal(false)

    it "keeps same short names in distinct qualified namespaces distinct":
        val module = module_with_types([structure(1, "alpha.Value", []), structure(2, "beta.Value", [])])
        val context = lean_plan_type_declarations(module, "Simple.DeclarationFixture").unwrap().context
        expect(lean_context_type_to_lean(MirType(kind: MirTypeKind.Struct(SymbolId(id: 1))), context).unwrap()).to_equal("_root_.Simple.DeclarationFixture.__MirTypes.«alpha».«Value»")
        expect(lean_context_type_to_lean(MirType(kind: MirTypeKind.Struct(SymbolId(id: 2))), context).unwrap()).to_equal("_root_.Simple.DeclarationFixture.__MirTypes.«beta».«Value»")

    it "supports empty tables and empty semantic declarations without inventing fields":
        expect(lean_plan_type_declarations(module_with_types([]), "Simple.DeclarationFixture").unwrap().declarations.len()).to_equal(0)
        val code = export_code(module_with_types([structure(1, "Marker", []), enumeration(2, "Uninhabited", [])]))
        expect(code).to_contain("structure __MirTypes.«Marker» where\ndef __MirTypeMetadata.t1")
        expect(code).to_contain("inductive __MirTypes.«Uninhabited» where\ndef __MirTypeMetadata.t2")

    it "resolves nominal references nested inside existing composite representations":
        val nested = MirTypeKind.Result(MirType(kind: MirTypeKind.Struct(SymbolId(id: 7))), MirType(kind: MirTypeKind.Array(MirType(kind: MirTypeKind.U8), 3)))
        val code = export_code(module_with_types([structure(8, "Envelope", [field("result", nested, 0)]), packet_type()]))
        expect(code).to_contain("«result» : _root_.Except (_root_.Vector (_root_.BitVec 8) 3) (_root_.Simple.DeclarationFixture.__MirTypes.«wire».«Packet»)")

    it "rejects missing and kind-mismatched nominal references in both public exports":
        step("Reject incomplete or unsupported MIR")
        val missing = module_with_types([structure(1, "Missing", [field("field", MirTypeKind.Struct(SymbolId(id: 99)), 0)])])
        expect(export_error(missing)).to_contain("unresolved nominal symbol 99")
        expect(LeanBackend.create(VerificationLevel.Contracts).export_generated_module(missing).is_err()).to_equal(true)
        val mismatch = module_with_types([packet_type(), structure(2, "Wrong", [field("value", MirTypeKind.Enum(SymbolId(id: 7)), 0)])])
        expect(export_error(mismatch)).to_contain("nominal kind mismatch for symbol 7")

    it "emits self and mutual recursion as grouped inductive declarations":
        val self_ref = structure(1, "Node", [field("next", MirTypeKind.Struct(SymbolId(id: 1)), 0)])
        expect(export_code(module_with_types([self_ref]))).to_contain("mutual\n  inductive __MirTypes.«Node» where")
        val left = structure(1, "Left", [field("right", MirTypeKind.Enum(SymbolId(id: 2)), 0)])
        val right = enumeration(2, "Right", [MirVariantDef(name: "Left", discriminant: 0, payload: Some(MirType(kind: MirTypeKind.Struct(SymbolId(id: 1)))))])
        expect(export_code(module_with_types([left, right]))).to_contain("  inductive __MirTypes.«Right» where")

    it "rejects inconsistent symbol identity and duplicate nominal names":
        var wrong_key = module_with_types([])
        wrong_key.types[SymbolId(id: 1)] = packet_type()
        expect(export_error(wrong_key)).to_contain("type table key disagrees")
        expect(export_error(module_with_types([structure(1, "Same", []), structure(2, "Same", [])]))).to_contain("duplicate type name")

    it "rejects malformed names, duplicate members and colliding generated names":
        expect(export_error(module_with_types([structure(1, "bad.2name", [])]))).to_contain("invalid or duplicate type name")
        expect(export_error(module_with_types([structure(1, "Injected\naxiom bad : False", [])]))).to_contain("invalid or duplicate type name")
        expect(export_error(module_with_types([structure(1, "Pair", [field("x", MirTypeKind.U8, 0), field("x", MirTypeKind.U8, 1)])]))).to_contain("duplicate field")
        expect(export_error(module_with_types([structure(1, "Pair", [field("rec", MirTypeKind.U8, 0)])]))).to_contain("reserved or duplicate field")

    it "rejects duplicate discriminants without silently renumbering variants":
        val bad = enumeration(2, "Status", [MirVariantDef(name: "First", discriminant: 7, payload: nil), MirVariantDef(name: "Second", discriminant: 7, payload: nil)])
        expect(export_error(module_with_types([bad]))).to_contain("duplicate enum discriminant")

    it "rejects unions, bitfields, negative offsets and unsupported primitive models":
        val union_definition = MirTypeDef(symbol: SymbolId(id: 1), name: "Union", kind: MirTypeDefKind.Union([MirType(kind: MirTypeKind.U8)]), is_export_c: false, export_name: "")
        expect(export_error(module_with_types([union_definition]))).to_contain("union declaration")
        var bits = field("flags", MirTypeKind.U8, 0)
        bits.has_bits_attr = true
        bits.bits_width = 3
        expect(export_error(module_with_types([structure(1, "Flags", [bits])]))).to_contain("bit-field representation")
        expect(export_error(module_with_types([structure(1, "Negative", [field("x", MirTypeKind.U8, -1)])]))).to_contain("negative field offset")
        expect(export_error(module_with_types([structure(1, "FloatValue", [field("x", MirTypeKind.F64, 0)])]))).to_contain("exact format/rounding/NaN model")

    it "rejects negative array lengths and reserved namespace collisions":
        val array = MirTypeKind.Array(MirType(kind: MirTypeKind.U8), -1)
        expect(export_error(module_with_types([structure(1, "BadArray", [field("x", array, 0)])]))).to_contain("negative array length")
        expect(export_error(module_with_types([structure(1, "Outer", []), structure(2, "Outer.Inner", [])]))).to_contain("overlapping nominal namespaces")
        var module = module_with_types([packet_type()])
        var function = identity_function()
        function.name = "__MirTypes.injected"
        module.functions[function.symbol] = function
        expect(export_error(module)).to_contain("function collides")

    it "does not mutate the builder when any declaration fails validation":
        var builder = LeanBuilder.create()
        builder.emit("retained")
        val module = module_with_types([packet_type(), structure(8, "Bad", [field("x", MirTypeKind.F32, 0)])])
        expect(LeanBackend.create(VerificationLevel.Contracts).export_types(builder, module).is_err()).to_equal(true)
        expect(builder.build()).to_equal("retained")

    it "retains export metadata with quoted text and rejects root-escape names":
        var definition = packet_type()
        definition.is_export_c = true
        definition.export_name = "packet\"\\line\n"
        val code = export_code(module_with_types([definition]))
        expect(code).to_contain("true, \"packet\\\"\\\\line\\n\")")
        expect(export_error(module_with_types([structure(1, "_root_.Outside", [])]))).to_contain("invalid or duplicate type name")

    it "rejects duplicate enum members and unsupported raw references":
        val duplicate = enumeration(2, "State", [MirVariantDef(name: "Same", discriminant: 0, payload: nil), MirVariantDef(name: "Same", discriminant: 1, payload: nil)])
        expect(export_error(module_with_types([duplicate]))).to_contain("reserved or duplicate variant")
        val pointer = MirTypeKind.Ptr(MirType(kind: MirTypeKind.U8), false)
        expect(export_error(module_with_types([structure(1, "Raw", [field("pointer", pointer, 0)])]))).to_contain("explicit heap/capability semantics")

    it "rejects Lean constructor auxiliaries before emitting any declaration":
        step("Reject incomplete or unsupported MIR")
        for reserved_name in ["ctorIdx", "ctorElimType", "ctorElim"]:
            val collision = enumeration(9, "wire.TwoVariants", [
                MirVariantDef(name: reserved_name, discriminant: 0, payload: nil),
                MirVariantDef(name: "Other", discriminant: 1, payload: nil)])
            val module = module_with_types([packet_type(), collision])
            val backend = LeanBackend.create(VerificationLevel.Contracts)
            match backend.export_module(module):
                case Err(error): expect(error.message).to_contain("reserved or duplicate variant `wire.TwoVariants.{reserved_name}`")
                case Ok(_): assert(false)
            match backend.export_generated_module(module):
                case Err(error): expect(error.message).to_contain("reserved or duplicate variant `wire.TwoVariants.{reserved_name}`")
                case Ok(_): assert(false)
            var builder = LeanBuilder.create()
            builder.emit("retained")
            expect(backend.export_types(builder, module).is_err()).to_equal(true)
            expect(builder.build()).to_equal("retained")
