"""09-6 / SF6 documentary acceptance for exactly six selected documents.

This is a pinned documentary/source contract, not a safety-runtime, Lean,
performance, or whole-feature acceptance test. Run only after the ordinary
pure-Simple compiler/CLI and existing SSpec runner are qualified. Execution UNRUN.
Pin changes require reviewed rebinding, never automatic acceptance of new bytes.
"""
use std.spec.*
use std.nogc_sync_mut.io.file_ops.{file_read_text}
use std.common.crypto.sha256.{sha256_text}

fn sf6_pinned_text_v1(path: text, expected_sha256: text) -> text:
    val content = file_read_text(path)
    assert(content.len() > 0)
    assert(sha256_text(content) == expected_sha256)
    content

fn sf6_assert_document_qualification_v1(document: text):
    expect(document).to_contain("Evidence qualification (2026-10-21, SF6)")
    expect(document).to_contain("380200890ff030b34c68ff38f362b482e1276769")
    expect(document).to_contain("not a current execution result")
    expect(document).to_contain("ran no compiler, Lean, benchmark, or runtime tests")
    expect(document).to_contain("executable qualification is **UNRUN**")

fn sf6_assert_selected_boundary_authority_v1(document: text):
    val requirement = sf6_pinned_text_v1("doc/02_requirements/language/mission_critical_profile.md",
            "2e0dcb3d7f7ebb13b67230c64221a51017f42f46cd1de73bdafbf0a92af5da9d")
    expect(requirement).to_contain("unsafe:`/`danger:` blocks are capability-scoped, not blanket")
    expect(requirement).to_contain("boundary requires reason + reviewer manifest")
    expect(requirement).to_contain("warn baseline, deny here")
    expect(requirement).to_contain("blanket \"unsafe = all capabilities\" rule")
    expect(document).to_contain("REQ-MC-004")
    expect(document).to_contain("not evidence that every path enforces it")

fn sf6_assert_unsafe_source_anchors_v1(document: text):
    val unsafe_source = sf6_pinned_text_v1("src/compiler/35.semantics/unsafe.spl",
            "ba7ad94ceb25e135058096ff079932de35660d1948a492a4af03cf8a938ec0dc")
    val vocabulary = sf6_pinned_text_v1("src/compiler/00.common/assurance/unsafe_capabilities.spl",
            "cf516b22df108950b576cf1f2af0d396095aa9a6893451089f5ae9bb121cd2f3")
    expect(unsafe_source).to_contain("class UnsafeContext:")
    expect(unsafe_source).to_contain("fn is_sffi_function(callee: HirExpr) -> bool:")
    expect(unsafe_source).to_contain("case HirExprKind.Var(_):\n            # Cannot determine SFFI status from SymbolId alone (no name available here)\n            false")
    expect(unsafe_source).to_contain("Err(UnsafeError.RequiresUnsafe(op, span))")
    expect(vocabulary).to_contain("enum UnsafeCapability:")
    expect(vocabulary).to_contain("A capability is a PERMISSION, not an effect")
    expect(document).to_contain("src/compiler/35.semantics/unsafe.spl")
    expect(document).to_contain("src/compiler/00.common/assurance/unsafe_capabilities.spl")
    expect(document).to_contain("no blanket FFI-checker coverage is claimed")

describe "09-6 SF6 documentary truth for the six selected conflict documents":
    it "corrects the unsafe exclusion without inventing diagnostic equivalence":
        step("Read the exact selected document")
        val selection = sf6_pinned_text_v1("doc/03_plan/agent_tasks/mission_critical_robustness_parallel_agents_2026-07-27.md",
            "33bc7e68062db67f8df5ba73cc1c960b762320ea20a2e58ad6bc6952f575214a")
        expect(selection).to_contain("SF6 `doc-truth` (G10)")
        expect(selection).to_contain("the 6 conflict docs only")
        val document = sf6_pinned_text_v1("doc/05_design/compiler/rust_migration/rust_to_simple_error_mapping.md",
            "a336443ad6efe74e45e4be3e57d5e585b9637fdb28e9f69d72b8d63651f69cd8")
        sf6_assert_document_qualification_v1(document)
        step("Check the cited source contract")
        sf6_assert_unsafe_source_anchors_v1(document)
        sf6_assert_selected_boundary_authority_v1(document)
        expect(document).to_contain("Simple has unsafe-context machinery")
        expect(document).to_contain("diagnostic equivalence unqualified")
        expect(document).to_contain("Aggregate counts below remain historical estimates")

    it "qualifies the implementation and zero-overhead report as historical evidence":
        step("Read the exact selected document")
        val document = sf6_pinned_text_v1("doc/04_architecture/language/memory_model_implementation.md",
            "17fb8799d4669968a2f005694b562b3c02c06ff3b994ee52dfb536779b8e550b")
        sf6_assert_document_qualification_v1(document)
        sf6_assert_unsafe_source_anchors_v1(document)
        sf6_assert_selected_boundary_authority_v1(document)
        step("Keep source, model, and runtime evidence separate")
        expect(document).to_contain("Historical implementation summary; current end-to-end qualification unestablished")
        expect(document).to_contain("Historical test report (2025-12-23)")
        expect(document).to_contain("not rerun here")
        expect(document).to_contain("Type-size equality alone does not establish latency, allocation, or race-detector cost")
        expect(document).to_contain("source structure, model proofs, and runtime measurements require separate evidence")

    it "withdraws formal completeness and binds the stated reduced model theorems":
        step("Read the exact selected document")
        val document = sf6_pinned_text_v1("doc/09_report/misc/runtime/MEMORY_VERIFICATION_COMPLETE.md",
            "90c587050cc9654c48227b57a4092b4101f0855586e1795bb416cc11d6687d61")
        sf6_assert_document_qualification_v1(document)
        step("Check the cited source contract")
        val capabilities = sf6_pinned_text_v1("src/verification/memory_capabilities/src/MemoryCapabilities.lean",
            "bb6e11c4bbef209db1a4943989393d54192234e19ad3cef5f8707fd58c71ad3b")
        val drf = sf6_pinned_text_v1("src/verification/memory_model_drf/src/MemoryModelDRF.lean",
            "6ece8ba61719f44d0e02fe268828e4b0bdb963ec320e5f32e92b6a5cb28e9cac")
        expect(capabilities).to_contain("Reduced-valid model for reference capabilities")
        expect(capabilities).to_contain("def wellFormed (env : RefEnv) : Prop :=")
        expect(capabilities).to_contain("countRefsWithCapability refs RefCapability.Exclusive ≤ 1")
        expect(capabilities).to_contain("countRefsWithCapability refs RefCapability.Isolated ≤ 1")
        expect(capabilities).to_contain("theorem conversion_is_safe")
        expect(drf).to_contain("Reduced-valid DRF / SC model")
        expect(drf).to_contain("theorem scDRF (exec : Execution) :")
        expect(drf).to_contain("dataRaceFree exec → ∃ (_ : SequentiallyConsistent exec), True")
        step("Keep source, model, and runtime evidence separate")
        expect(document).to_contain("That conclusion is withdrawn")
        expect(document).to_contain("do not prove compiler refinement, actual runtime instrumentation coverage, native memory ordering, or production safety")
        expect(document).to_contain("Lean checking was not run for this correction")
        expect(document).to_contain("runtime race-freedom is not established here")
        expect(document).to_contain("Historical Safety Claims (not current runtime qualification)")

    it "marks capability unsafe-allows-all examples as superseded profile history":
        step("Read the exact selected document")
        val document = sf6_pinned_text_v1("doc/02_requirements/language/di/capability_system.md",
            "3f984e3d90b6c9c6a75662078c33f4abb1c45d08eb18820221376bcb00d6514e")
        sf6_assert_document_qualification_v1(document)
        sf6_assert_selected_boundary_authority_v1(document)
        sf6_assert_unsafe_source_anchors_v1(document)
        expect(document).to_contain("no blanket authorization")
        expect(document).to_contain("historical permissive mode example (superseded for the mission-critical profile)")
        expect(document).to_contain("not real enforcement or performance evidence")

    it "distinguishes effect examples from scoped unsafe permission and enforcement":
        step("Read the exact selected document")
        val document = sf6_pinned_text_v1("doc/02_requirements/language/effects/effect_system.md",
            "d39392456270ffd861996a4fcbc52c65ab93bd95f6c3770bdc70a8bd6df3b68d")
        sf6_assert_document_qualification_v1(document)
        sf6_assert_selected_boundary_authority_v1(document)
        sf6_assert_unsafe_source_anchors_v1(document)
        expect(document).to_contain("Effects and unsafe capabilities have distinct roles")
        expect(document).to_contain("capabilities as permissions, not effects")
        expect(document).to_contain("@unsafe` is not permission for arbitrary unchecked operations")
        expect(document).to_contain("not enforcement, FFI safety, or checker completeness")
        expect(document).to_contain("Legacy `expect true` examples are not current enforcement evidence")

    it "retains generated checked wrappers and explicit provider evidence obligations":
        step("Read the exact selected document")
        val document = sf6_pinned_text_v1("doc/02_requirements/language/extern/extern_functions.md",
            "d799ebcec6498829ad6207112c10ce7da5d680848fdb924b4cb3c0e070dd2a75")
        sf6_assert_document_qualification_v1(document)
        sf6_assert_unsafe_source_anchors_v1(document)
        val requirement = sf6_pinned_text_v1("doc/02_requirements/language/mission_critical_profile.md",
            "2e0dcb3d7f7ebb13b67230c64221a51017f42f46cd1de73bdafbf0a92af5da9d")
        expect(requirement).to_contain("`extern fn` raw signatures allowed only")
        expect(requirement).to_contain("beneath generated checked wrappers")
        expect(document).to_contain("REQ-MC-001")
        expect(document).to_contain("REQ-MC-004")
        expect(document).to_contain("allows raw extern signatures only beneath generated checked wrappers in that profile")
        expect(document).to_contain("do not certify providers or remove wrapper obligations")
        expect(document).to_contain("not a new language-wide ban on extern calls")
        expect(document).to_contain("must supply their own ABI, pointer, ownership, and lifecycle evidence")
        expect(document).to_contain("successful primitive return-value examples do not qualify that boundary")
