        # @capture(bit_table): two consecutive supports_jit_fn results compared for stability
        step("Call supports_jit_fn twice and compare the results")
        val svc = create_default_services()
        val jit_fn = svc.backend.supports_jit_fn
        val j1 = jit_fn()
        val j2 = jit_fn()
        expect(j1).to_equal(j2)

