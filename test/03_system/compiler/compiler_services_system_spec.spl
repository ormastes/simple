# doc/05_design/compiler/aspect_dynload/typed_facet_pipeline_2026-08-22.md
# @manual_section: compiler_services_pipeline_ports
# @cover src/compiler/compiler_services.spl 80%
# CompilerServices System Test
#
# System-level tests for Feature 2: Pipeline Stage Ports (CompilerServices).
# Demonstrates CompilerServices in a realistic compilation scenario:
# creating services, running through all pipeline stages, and verifying
# outputs at each stage boundary.
#
# Feature: Pipeline Stage Ports (Feature 2)
# Design: doc/09_report/compiler_mdsoc_impl_plan.md Phase 2
# Source: src/compiler/compiler_services.spl

use std.spec.{describe, it, expect, step}

use compiler.compiler_services.{
    create_default_services,
    LexerPort,
    ParserPort,
    DesugarPort,
    TypeCheckPort,
    HirLowerPort,
    MirLowerPort,
    LoggerPort,
    ModuleLoaderPort,
    CompilerServices
}

# ============================================================================
# System Test 1: Service container construction
# ============================================================================

describe "CompilerServices System: Service container construction":

    it "create_default_services produces a fully wired container":
        # @req REQ-CSVC-001
        # @capture(bit_table): the noop name of every port in the constructed container
        step("Construct the default services container and inspect every port name")
        val svc = create_default_services()
        expect(svc.lexer.name).to_equal("noop-lexer")
        expect(svc.parser.name).to_equal("noop-parser")
        expect(svc.desugarer.name).to_equal("noop-desugarer")
        expect(svc.type_checker.name).to_equal("noop-type-checker")
        expect(svc.hir_lowerer.name).to_equal("noop-hir-lowerer")
        expect(svc.mir_lowerer.name).to_equal("noop-mir-lowerer")
        expect(svc.backend.name).to_equal("noop-backend")
        expect(svc.logger.name).to_equal("noop-logger")
        expect(svc.module_loader.name).to_equal("noop-module-loader")

    it "service container can be created and immediately queried":
        # @req REQ-CSVC-002
        # @capture(bit_table): the lexer port name read immediately after construction
        step("Construct the default services container and read the lexer name without delay")
        val svc = create_default_services()
        val lexer_name = svc.lexer.name
        expect(lexer_name).to_start_with("noop")

    it "all port names follow the noop- naming convention":
        # @req REQ-CSVC-003
        # @capture(bit_table): the noop- prefix on every port name
        step("Verify every port name in the container carries the noop- prefix")
        val svc = create_default_services()
        expect(svc.lexer.name).to_start_with("noop")
        expect(svc.parser.name).to_start_with("noop")
        expect(svc.desugarer.name).to_start_with("noop")
        expect(svc.type_checker.name).to_start_with("noop")
        expect(svc.hir_lowerer.name).to_start_with("noop")
        expect(svc.mir_lowerer.name).to_start_with("noop")
        expect(svc.backend.name).to_start_with("noop")
        expect(svc.logger.name).to_start_with("noop")
        expect(svc.module_loader.name).to_start_with("noop")

# ============================================================================
# System Test 2: Real compilation scenario - lexer and parser stages
# ============================================================================

describe "CompilerServices System: Lexer and parser stages":

    it "lexer tokenizes a simple function declaration":
        # @req REQ-CSVC-004
        # @capture(bit_table): the token count returned by the noop lexer for a real function declaration
        step("Tokenize a function declaration through the port's tokenize_fn")
        val svc = create_default_services()
        val source = "fn add(a: i64, b: i64) -> i64: a + b"
        val tokenize = svc.lexer.tokenize_fn
        val tokens = tokenize(source)
        # noop returns empty - verifies stage boundary contract
        expect(tokens.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "parser receives token stream from lexer and returns no errors":
        # @req REQ-CSVC-005
        # @capture(bit_table): the parser error count when fed the lexer's real token stream
        step("Feed the lexer's real token output into the parser's parse_fn and inspect the error list")
        val svc = create_default_services()
        val source = "fn add(a: i64, b: i64) -> i64: a + b"
        val tokenize = svc.lexer.tokenize_fn
        val tokens = tokenize(source)
        val parse = svc.parser.parse_fn
        val parse_errors = parse(tokens, source)
        expect(svc.parser.name).to_equal("noop-parser")
        expect(parse_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "lexer handles multiline source without error":
        # @req REQ-CSVC-006
        # @capture(bit_table): the token count for a multi-line source string
        step("Tokenize a multi-line source string through tokenize_fn")
        val svc = create_default_services()
        val source = "fn foo():\n    val x = 1\n    x + 1"
        val tokenize = svc.lexer.tokenize_fn
        val tokens = tokenize(source)
        expect(tokens.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "parser returns empty error list for noop implementation":
        # @req REQ-CSVC-007
        # @capture(bit_table): the parser error count for an empty token/source pair
        step("Call parse_fn directly with an empty token stream and empty source")
        val svc = create_default_services()
        val parse = svc.parser.parse_fn
        val parse_errors = parse([], "")
        expect(svc.parser.name).to_start_with("noop")
        expect(parse_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

# ============================================================================
# System Test 3: Real compilation scenario - desugaring and type checking
# ============================================================================

describe "CompilerServices System: Desugaring and type checking stages":

    it "desugarer receives source and returns transformed output":
        # @req REQ-CSVC-008
        # @capture(bit_table): the desugarer's transformed output compared to its input
        step("Desugar a source string through desugar_fn")
        val svc = create_default_services()
        val source = "fn main(): print 1"
        val desugar = svc.desugarer.desugar_fn
        val transformed = desugar(source)
        # noop returns source unchanged
        expect(transformed).to_equal(source)

    it "desugarer preserves source structure for noop":
        # @req REQ-CSVC-009
        # @capture(bit_table): the desugarer's output for a class declaration
        step("Desugar a class declaration through desugar_fn and confirm structure is preserved")
        val svc = create_default_services()
        val source = "class Point:\n    x: i64\n    y: i64"
        val desugar = svc.desugarer.desugar_fn
        val result = desugar(source)
        expect(result).to_equal(source)

    it "type checker validates module by name":
        # @req REQ-CSVC-010
        # @capture(bit_table): the type-check error count for a named module
        step("Type-check a module by name through check_fn")
        val svc = create_default_services()
        val check = svc.type_checker.check_fn
        # NOTE: genuine pre-existing failure — invoking check_fn through the
        # `any`-typed TypeCheckPort field returns nil instead of executing
        # `_noop_check` (compiler_services.spl:158), unlike the structurally
        # identical HIR/MIR lower_fn fields which do dispatch correctly.
        # `errors.len()` then fails with "method `len` not found on type
        # `nil`". Confirmed 2026-09-06, same failure at baseline before this
        # modernization pass. Left RED per testing rules; do not weaken.
        val errors = check("my_module")
        expect(errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "type checker returns empty error list for unknown module in noop":
        # @req REQ-CSVC-011
        # @capture(bit_table): the type-check error count for an unknown module name
        step("Type-check a nonexistent module name through check_fn")
        val svc = create_default_services()
        val check = svc.type_checker.check_fn
        # NOTE: same genuine pre-existing check_fn dispatch defect as
        # compiler_services_system_spec.spl:182 above — see that NOTE.
        val errors = check("nonexistent_module")
        expect(errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

