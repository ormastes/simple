describe "CompilerServices System: HIR and MIR lowering stages":

    it "HIR lowerer lowers a module by name":
        # @req REQ-CSVC-012
        # @capture(bit_table): the HIR-lowering error count for a named module
        step("Lower a module to HIR through lower_fn")
        val svc = create_default_services()
        val lower = svc.hir_lowerer.lower_fn
        val errors = lower("main")
        expect(errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "MIR lowerer lowers a module by name":
        # @req REQ-CSVC-013
        # @capture(bit_table): the MIR-lowering error count for a named module
        step("Lower a module to MIR through lower_fn")
        val svc = create_default_services()
        val lower = svc.mir_lowerer.lower_fn
        val errors = lower("main")
        expect(errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "HIR and MIR lowering stages both succeed for same module":
        # @req REQ-CSVC-014
        # @capture(bit_table): HIR and MIR error counts for the same module name, side by side
        step("Lower the same module through both the HIR and MIR lowerers")
        val svc = create_default_services()
        val hir_lower = svc.hir_lowerer.lower_fn
        val mir_lower = svc.mir_lowerer.lower_fn
        val hir_errors = hir_lower("main")
        val mir_errors = mir_lower("main")
        expect(hir_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(mir_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "HIR lowerer handles multiple module names":
        # @req REQ-CSVC-015
        # @capture(bit_table): HIR-lowering error counts for two distinct module names
        step("Lower two distinct module names through the HIR lowerer")
        val svc = create_default_services()
        val lower = svc.hir_lowerer.lower_fn
        val e1 = lower("module_a")
        val e2 = lower("module_b")
        expect(e1.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(e2.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

