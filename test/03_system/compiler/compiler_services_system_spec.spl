# ============================================================================
# System Test 7: Module loader integration
# ============================================================================

describe "CompilerServices System: Module loader integration":

    it "module loader resolves import paths":
        # @req REQ-CSVC-023
        # @capture(bit_table): the module loader's resolve_fn output for a real import name
        step("Resolve an import name through the module loader's resolve_fn")
        val svc = create_default_services()
        val resolve = svc.module_loader.resolve_fn
        val resolved_path = resolve("compiler/driver.spl", "std.math")
        # noop resolve_fn returns the import name unchanged
        expect(resolved_path).to_equal("std.math")

    it "module loader loads resolved module content":
        # @req REQ-CSVC-024
        # @capture(bit_table): the module loader's load_fn output for a resolved path
        step("Load a resolved module path through the module loader's load_fn")
        val svc = create_default_services()
        val load = svc.module_loader.load_fn
        val resolved = "std.array"
        val content = load(resolved)
        # noop returns empty string
        expect(content).to_equal("")

    it "module loader returns import name unchanged for noop resolver":
        # @req REQ-CSVC-025
        # @capture(bit_table): resolve_fn output for two distinct import names
        step("Resolve two distinct import names through resolve_fn and compare each to its input")
        val svc = create_default_services()
        val resolve = svc.module_loader.resolve_fn
        val r1 = resolve("compiler/driver.spl", "compiler.driver")
        val r2 = resolve("compiler/other.spl", "compiler.driver")
        # noop resolve_fn ignores the current path and returns the import name unchanged
        expect(r1).to_equal("compiler.driver")
        expect(r2).to_equal("compiler.driver")

    it "module loader returns empty content for any path in noop":
        # @req REQ-CSVC-026
        # @capture(bit_table): load_fn output for two distinct module paths
        step("Load two distinct module paths through load_fn")
        val svc = create_default_services()
        val load = svc.module_loader.load_fn
        val c1 = load("src/compiler/driver.spl")
        val c2 = load("src/std/math.spl")
        expect(c1).to_equal("")
        expect(c2).to_equal("")

# ============================================================================
# System Test 8: Full end-to-end compilation pipeline
# ============================================================================

describe "CompilerServices System: Full end-to-end pipeline":

    it "simulates a complete compilation run through all 9 stages":
        # @req REQ-CSVC-027
        # @capture(bit_table): the result of every stage boundary call in one pipeline run
        step("Drive a source string through all nine pipeline stage ports in order")
        val svc = create_default_services()
        val src = "fn greet(msg: text): print msg"
        val module_name = "greet"

        # Stage 1: Lex
        val lex = svc.lexer.tokenize_fn
        val tokens = lex(src)
        expect(tokens.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        # Stage 2: Parse
        val parse = svc.parser.parse_fn
        val parse_errors = parse(tokens, src)
        expect(svc.parser.name).to_equal("noop-parser")
        expect(parse_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        # Stage 3: Desugar
        val desugar = svc.desugarer.desugar_fn
        val desugared = desugar(src)
        expect(desugared).to_equal(src)

        # Stage 4: Type check
        val check = svc.type_checker.check_fn
        # NOTE: same genuine pre-existing check_fn dispatch defect as
        # compiler_services_system_spec.spl:182 above — see that NOTE.
        val type_errs = check(module_name)
        expect(type_errs.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        # Stage 5: HIR lower
        val hir_lower = svc.hir_lowerer.lower_fn
        val hir_errs = hir_lower(module_name)
        expect(hir_errs.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        # Stage 6: MIR lower
        val mir_lower = svc.mir_lowerer.lower_fn
        val mir_errs = mir_lower(module_name)
        expect(mir_errs.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        # Stage 7: Backend capabilities check
        val jit_fn = svc.backend.supports_jit_fn
        val jit_ok = jit_fn()
        expect(jit_ok).to_equal(false)

        # Stage 8: Backend target
        val triple_fn = svc.backend.target_triple_fn
        val triple = triple_fn()
        expect(triple).to_equal("noop")

        # Stage 9: Verify logger
        expect(svc.logger.name).to_equal("noop-logger")

    it "pipeline can be run for multiple modules":
        # @req REQ-CSVC-028
        # @capture(bit_table): parse/type/HIR/MIR error counts for two independently driven modules
        step("Drive two distinct modules through the parser, type checker, and HIR/MIR lowerers")
        val svc = create_default_services()

        val lex = svc.lexer.tokenize_fn
        val parse = svc.parser.parse_fn
        val desugar = svc.desugarer.desugar_fn
        val check = svc.type_checker.check_fn
        # NOTE: same genuine pre-existing check_fn dispatch defect as
        # compiler_services_system_spec.spl:182 above — see that NOTE.
        val hir_lower = svc.hir_lowerer.lower_fn
        val mir_lower = svc.mir_lowerer.lower_fn

        val src_a = "fn foo(): 1"
        val tokens_a = lex(src_a)
        val parse_errs_a = parse(tokens_a, src_a)
        val desugared_a = desugar(src_a)
        # NOTE: same genuine pre-existing check_fn dispatch defect as
        # compiler_services_system_spec.spl:182 above — see that NOTE.
        val type_errs_a = check("module_a")
        val hir_errs_a = hir_lower("module_a")
        val mir_errs_a = mir_lower("module_a")

        val src_b = "fn bar(): 2"
        val tokens_b = lex(src_b)
        val parse_errs_b = parse(tokens_b, src_b)
        val desugared_b = desugar(src_b)
        val type_errs_b = check("module_b")
        val hir_errs_b = hir_lower("module_b")
        val mir_errs_b = mir_lower("module_b")

        expect(parse_errs_a.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(parse_errs_b.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(desugared_a).to_equal(src_a)
        expect(desugared_b).to_equal(src_b)
        expect(type_errs_a.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(type_errs_b.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(hir_errs_a.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(hir_errs_b.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(mir_errs_a.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
        expect(mir_errs_b.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

    it "module loader participates in full pipeline as module source provider":
        # @req REQ-CSVC-029
        # @capture(bit_table): the resolved path, loaded content, and downstream lex/parse results
        step("Resolve and load a module through the module loader, then feed its content into lex/parse")
        val svc = create_default_services()
        val resolve = svc.module_loader.resolve_fn
        val load = svc.module_loader.load_fn

        # Resolve module path
        val resolved = resolve("compiler/driver.spl", "std.string")
        expect(resolved).to_equal("std.string")

        # Load module content
        val content = load(resolved)
        expect(content).to_equal("")

        # Continue pipeline with loaded content
        val lex = svc.lexer.tokenize_fn
        val tokens = lex(content)
        expect(tokens.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior

        val parse = svc.parser.parse_fn
        val parse_errors = parse(tokens, content)
        expect(parse_errors.len()).to_equal(0)  # oracle: 0 — pinned expected value for this behavior
