# codex-system-test
# @manual: show
# @req: C2, REQ-C2-RV-001, REQ-C2-RV-002, REQ-C2-RV-003
# Tests first against PR4027 a4808e7; all execution and doc generation UNRUN.
# Positive recursive-array assertions are source-predicted RED; no runtime evidence.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirInst, MirInstKind, AggregateKind, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use plugins.backend_lean.lean_backend.{LeanBackend, LeanBuilder, VerificationLevel}
use compiler.backend.backend.lean_backend.{LeanBackend as CompilerLeanBackend, LeanBuilder as CompilerLeanBuilder, VerificationLevel as CompilerVerificationLevel}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations, lean_context_type_to_lean, LeanRecursiveArrayLimitsV1, lean_array_uses_finite_carrier_v1}
use compiler.mir.mir_json.{serialize_mir_module}

fn rv_ty(kind: MirTypeKind) -> MirType: MirType(kind: kind)
fn rv_struct_ty(id: i64) -> MirType: rv_ty(MirTypeKind.Struct(SymbolId(id: id)))
fn rv_enum_ty(id: i64) -> MirType: rv_ty(MirTypeKind.Enum(SymbolId(id: id)))
fn rv_field(name: text, type_: MirType) -> MirFieldDef:
    MirFieldDef(name: name, type_: type_, offset: 0, has_bits_attr: false, bits_width: 0)
fn rv_struct(id: i64, name: text, fields: [MirFieldDef]) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Struct(fields), is_export_c: false, export_name: "")
fn rv_enum(id: i64, name: text, payload: MirType) -> MirTypeDef:
    MirTypeDef(symbol: SymbolId(id: id), name: name, kind: MirTypeDefKind.Enum([
        MirVariantDef(name: "Done", discriminant: -5, payload: nil),
        MirVariantDef(name: "More", discriminant: 13, payload: Some(payload))]), is_export_c: false, export_name: "")
fn rv_module(definitions: [MirTypeDef]) -> MirModule:
    var types: Dict<SymbolId, MirTypeDef> = {}
    for definition in definitions: types[definition.symbol] = definition
    MirModule(name: "RecursiveArrays", functions: {}, statics: {}, constants: {}, types: types)

fn rv_outputs(module: MirModule) -> [text]:
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    [plugin.export_module(module).unwrap().lean_code,
     plugin.export_generated_module(module).unwrap().lean_code,
     compiler.export_module(module).unwrap().lean_code,
     compiler.export_generated_module(module).unwrap().lean_code]

fn rv_refusal(module: MirModule, reason: text):
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    for result in [plugin.export_module(module), plugin.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    for result in [compiler.export_module(module), compiler.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    var plugin_builder = LeanBuilder.create()
    plugin_builder.emit("retained")
    expect(plugin.export_types(plugin_builder, module).is_err()).to_equal(true)
    expect(plugin_builder.build()).to_equal("retained")
    var compiler_builder = CompilerLeanBuilder.create()
    compiler_builder.emit("retained")
    expect(compiler.export_types(compiler_builder, module).is_err()).to_equal(true)
    expect(compiler_builder.build()).to_equal("retained")

fn rv_copy(id: i64) -> MirOperand: MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))
fn rv_local(id: i64, type_: MirType, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: kind, is_ghost: false)

fn rv_array(element: MirType, size: i64) -> MirType: rv_ty(MirTypeKind.Array(element, size))
fn rv_name(name: text) -> text: "_root_.Simple.RecursiveArrays.__MirTypes.«" + name + "»"
fn rv_finite(element: text, size: i64) -> text: "(_root_.Fin " + size.to_text() + " → " + element + ")"
fn rv_inst(kind: MirInstKind) -> MirInst: MirInst(kind: kind, span: nil)
fn rv_function(parameters: [MirType], locals: [MirLocal], instructions: [MirInst], result: MirType, returned: i64) -> MirFunction:
    MirFunction(symbol: SymbolId(id: 90), name: "roundtrip",
        signature: MirSignature(params: parameters, return_type: result, is_variadic: false, params_known: true),
        locals: locals, blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: instructions,
            terminator: MirTerminator.Ret(Some(rv_copy(returned))))],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)

fn rv_body_refusal(module: MirModule, reason: text):
    val before = serialize_mir_module(module)
    val plugin = LeanBackend.create(VerificationLevel.Contracts)
    val compiler = CompilerLeanBackend.create(CompilerVerificationLevel.Contracts)
    for result in [plugin.export_module(module), plugin.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    for result in [compiler.export_module(module), compiler.export_generated_module(module)]:
        match result:
            case Err(error): expect(error.message).to_contain(reason)
            case Ok(_): assert(false)
    expect(serialize_mir_module(module)).to_equal(before)

describe "exact recursive fixed-array carriers through both retained backend owners":
    it "should export a self-recursive finite enum payload through all four module APIs":
        step("Plan exact recursive carriers")
        val module = rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(2), 2))])
        val before = serialize_mir_module(module)
        for code in rv_outputs(module):
            expect(code).to_contain("| «More» : " + rv_finite(rv_name("Tree"), 2) + " → __MirTypes.«Tree»")
            expect(code).to_contain("| «Done»")
            expect(code.contains("sorry")).to_equal(false)
            expect(code.contains("axiom ")).to_equal(false)
        expect(serialize_mir_module(module)).to_equal(before)

    it "should construct a zero-length recursive struct field without an element inhabitant":
        step("Construct and transport finite arrays")
        val node = rv_struct_ty(1)
        val empty = rv_array(node, 0)
        var module = rv_module([rv_struct(1, "Node", [rv_field("children", empty)])])
        val function = rv_function([], [rv_local(0, empty, LocalKind.Temp), rv_local(1, node, LocalKind.Temp), rv_local(2, empty, LocalKind.Temp)], [
            rv_inst(MirInstKind.Aggregate(LocalId(id: 0), AggregateKind.Array(node), [])),
            rv_inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 1)), [rv_copy(0)])),
            rv_inst(MirInstKind.GetField(LocalId(id: 2), rv_copy(1), 0))], empty, 2)
        module.functions[function.symbol] = function
        for code in rv_outputs(module):
            expect(code).to_contain("let _l0 : " + rv_finite(rv_name("Node"), 0))
            expect(code).to_contain("#[] : _root_.Array (" + rv_name("Node") + ")")
            expect(code).to_contain(rv_name("Node") + ".mk (_l0)")
            expect(code).to_contain(rv_name("Node") + ".«children» (_l1)")
            expect(code).to_contain("let _l2 : " + rv_finite(rv_name("Node"), 0))
            expect(code).to_contain("\n  _l2\n")

    it "should preserve ordered genuine nominal operands in singleton and multi-element arrays":
        for size in [1, 3]:
            val tree = rv_enum_ty(2)
            val array = rv_array(tree, size)
            var module = rv_module([rv_enum(2, "Tree", array)])
            var locals: [MirLocal] = []
            var parameters: [MirType] = []
            var operands: [MirOperand] = []
            var terms: [text] = []
            for index in 0..size:
                parameters.push(tree)
                locals.push(rv_local(index, tree, LocalKind.Arg(index)))
                operands.push(rv_copy(index))
                terms.push("_l" + index.to_text())
            locals.push(rv_local(size, array, LocalKind.Temp))
            val function = rv_function(parameters, locals, [rv_inst(MirInstKind.Aggregate(LocalId(id: size), AggregateKind.Array(tree), operands))], array, size)
            module.functions[function.symbol] = function
            for code in rv_outputs(module):
                expect(code).to_contain("#[" + terms.join(", ") + "]")
                expect(code).to_contain(rv_finite(rv_name("Tree"), size))
                expect(code).to_contain(".get ")

    it "should make mutual recursive representation independent of declaration insertion order":
        val left = rv_struct(1, "Left", [rv_field("children", rv_array(rv_enum_ty(2), 2))])
        val right = rv_enum(2, "Right", rv_struct_ty(1))
        val first = rv_outputs(rv_module([left, right]))
        val second = rv_outputs(rv_module([right, left]))
        expect(first).to_equal(second)
        for code in first:
            expect(code).to_contain("inductive __MirTypes.«Left»")
            expect(code).to_contain("inductive __MirTypes.«Right»")
            expect(code).to_contain(rv_finite(rv_name("Right"), 2))

    it "should use one exact carrier for unrelated fields parameters returns and locals":
        val array = rv_array(rv_enum_ty(2), 2)
        var module = rv_module([rv_enum(2, "Tree", array), rv_struct(7, "Holder", [rv_field("items", array)])])
        val function = rv_function([array], [rv_local(0, array, LocalKind.Arg(0))], [], array, 0)
        module.functions[function.symbol] = function
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrays").unwrap().context
        expect(lean_context_type_to_lean(array, context).unwrap()).to_equal(rv_finite(rv_name("Tree"), 2))
        for code in rv_outputs(module):
            expect(code).to_contain("«items» : " + rv_finite(rv_name("Tree"), 2))
            expect(code).to_contain("(_l0 : " + rv_finite(rv_name("Tree"), 2) + ")")
            expect(code).to_contain(") : " + rv_finite(rv_name("Tree"), 2) + " :=")
            expect(code).to_contain("\n  _l0\n")

    it "should select both nested recursive array shapes through positive wrappers":
        val tree = rv_enum_ty(2)
        val inner = rv_array(tree, 2)
        val outer = rv_array(inner, 3)
        val payload = rv_ty(MirTypeKind.Result(rv_ty(MirTypeKind.Tuple([outer, rv_ty(MirTypeKind.Slice(inner))])), rv_ty(MirTypeKind.U8)))
        val module = rv_module([rv_enum(2, "Tree", payload)])
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrays").unwrap().context
        expect(lean_context_type_to_lean(inner, context).unwrap()).to_equal(rv_finite(rv_name("Tree"), 2))
        expect(lean_context_type_to_lean(outer, context).unwrap()).to_equal(rv_finite(rv_finite(rv_name("Tree"), 2), 3))
        for code in rv_outputs(module):
            expect(code).to_contain(rv_finite(rv_finite(rv_name("Tree"), 2), 3))
            expect(code).to_contain("_root_.Array (" + rv_finite(rv_name("Tree"), 2) + ")")

    it "should retain ordinary Vector mapping for scalar and unselected nominal array lengths":
        val module = rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(2), 2)), rv_struct(7, "Holder", [rv_field("bytes", rv_array(rv_ty(MirTypeKind.U8), 3)), rv_field("other", rv_array(rv_enum_ty(2), 4))])])
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrays").unwrap().context
        expect(lean_context_type_to_lean(rv_array(rv_ty(MirTypeKind.U8), 3), context).unwrap()).to_equal("_root_.Vector (_root_.BitVec 8) 3")
        expect(lean_context_type_to_lean(rv_array(rv_enum_ty(2), 4), context).unwrap()).to_equal("_root_.Vector (" + rv_name("Tree") + ") 4")
        for code in rv_outputs(module):
            expect(code).to_contain("«bytes» : _root_.Vector (_root_.BitVec 8) 3")
            expect(code).to_contain("«other» : _root_.Vector (" + rv_name("Tree") + ") 4")

    it "should reject malformed nominal identity even under an empty array atomically":
        step("Refuse malformed or over-budget export")
        rv_refusal(rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(99), 0))]), "unresolved nominal symbol 99")
        rv_refusal(rv_module([rv_enum(2, "Tree", rv_array(rv_struct_ty(2), 0))]), "nominal kind mismatch")

    it "should reject negative recursive array lengths before builder mutation":
        rv_refusal(rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(2), -1))]), "negative array length")

    it "should reject aggregate element count mismatch without changing the borrowed module":
        val tree = rv_enum_ty(2)
        val array = rv_array(tree, 2)
        var module = rv_module([rv_enum(2, "Tree", array)])
        val function = rv_function([tree], [rv_local(0, tree, LocalKind.Arg(0)), rv_local(1, array, LocalKind.Temp)], [
            rv_inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Array(tree), [rv_copy(0)]))], array, 1)
        module.functions[function.symbol] = function
        rv_body_refusal(module, "array length mismatch")

    it "should reject repeated Move operands in a selected carrier":
        val tree = rv_enum_ty(2)
        val array = rv_array(tree, 2)
        val moved = MirOperand(kind: MirOperandKind.Move(LocalId(id: 0)))
        var module = rv_module([rv_enum(2, "Tree", array)])
        val function = rv_function([tree], [rv_local(0, tree, LocalKind.Arg(0)), rv_local(1, array, LocalKind.Temp)], [
            rv_inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Array(tree), [moved, moved]))], array, 1)
        module.functions[function.symbol] = function
        rv_body_refusal(module, "use before definition or after move")

    it "should admit exact depth and node boundaries through the actual planner":
        step("Refuse malformed or over-budget export")
        val module = rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(2), 2))])
        val before = serialize_mir_module(module)
        val limits = LeanRecursiveArrayLimitsV1(max_depth: 2, max_nodes: 8)
        expect(lean_plan_type_declarations(module, "Simple.RecursiveArrays", limits).unwrap().declarations.len()).to_equal(1)
        match lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_depth: 1)):
            case Err(error): expect(error.message).to_contain("type depth budget")
            case Ok(_): fail("depth boundary was not enforced")
        match lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_nodes: 7)):
            case Err(error): expect(error.message).to_contain("type node budget")
            case Ok(_): fail("node boundary was not enforced")
        expect(serialize_mir_module(module)).to_equal(before)

    it "should admit exact retained-key bytes and reject one byte less":
        val payload = rv_ty(MirTypeKind.Tuple([rv_array(rv_enum_ty(2), 2), rv_array(rv_enum_ty(2), 3)]))
        val module = rv_module([rv_enum(2, "Tree", payload)])
        # Actual canonical MIR identity bytes, not a hash or a compiler model.
        val two = "{\"Array\":{\"element\":{\"Enum\":2},\"size\":2}}"
        val three = "{\"Array\":{\"element\":{\"Enum\":2},\"size\":3}}"
        val exact = two.len() + three.len()
        expect(lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_key_bytes: exact)).unwrap().groups.len()).to_equal(1)
        match lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_key_bytes: exact - 1)):
            case Err(error): expect(error.message).to_contain("retained key byte budget")
            case Ok(_): fail("retained key-byte boundary was not enforced")

    it "should charge unique policy entries and reuse repeated exact shapes":
        val array = rv_array(rv_enum_ty(2), 2)
        val repeated = rv_module([rv_enum(2, "Tree", rv_ty(MirTypeKind.Tuple([array, array])))])
        expect(lean_plan_type_declarations(repeated, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_plans: 1)).unwrap().groups.len()).to_equal(1)
        val distinct = rv_module([rv_enum(2, "Tree", rv_ty(MirTypeKind.Tuple([array, rv_array(rv_enum_ty(2), 3)])))])
        match lean_plan_type_declarations(distinct, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_plans: 1)):
            case Err(error): expect(error.message).to_contain("policy entry budget")
            case Ok(_): fail("distinct lengths incorrectly reused a policy entry")

    it "should enforce work admission before final plan growth":
        val module = rv_module([rv_struct(1, "Empty", [])])
        expect(lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_work: 2)).unwrap().declarations.len()).to_equal(1)
        match lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_work: 1)):
            case Err(error): expect(error.message).to_contain("planning work budget")
            case Ok(_): fail("work boundary was not enforced")

    it "should reject invalid downward overrides and preserve the two-argument API":
        val module = rv_module([])
        expect(lean_plan_type_declarations(module, "Simple.RecursiveArrays").unwrap().declarations.len()).to_equal(0)
        for limits in [LeanRecursiveArrayLimitsV1(max_depth: 0), LeanRecursiveArrayLimitsV1(max_depth: 129),
            LeanRecursiveArrayLimitsV1(max_nodes: -1), LeanRecursiveArrayLimitsV1(max_nodes: 65537),
            LeanRecursiveArrayLimitsV1(max_work: 0), LeanRecursiveArrayLimitsV1(max_work: 1048577),
            LeanRecursiveArrayLimitsV1(max_key_bytes: 0), LeanRecursiveArrayLimitsV1(max_key_bytes: 1048577),
            LeanRecursiveArrayLimitsV1(max_plans: -1), LeanRecursiveArrayLimitsV1(max_plans: 4097)]:
            match lean_plan_type_declarations(module, "Simple.RecursiveArrays", limits):
                case Err(error): expect(error.message).to_contain("invalid recursive array")
                case Ok(_): fail("invalid limits were admitted")

    it "should charge repeated exact-policy lookups instead of providing an unbounded cache bypass":
        val module = rv_module([rv_enum(2, "Tree", rv_array(rv_enum_ty(2), 2))])
        val context = lean_plan_type_declarations(module, "Simple.RecursiveArrays", LeanRecursiveArrayLimitsV1(max_work: 1000)).unwrap().context
        var admitted = 0
        var refused = false
        for index in 0..16:
            match lean_array_uses_finite_carrier_v1(rv_enum_ty(2), 2, context):
                case Ok(selected):
                    expect(selected).to_equal(true)
                    admitted = admitted + 1
                case Err(error):
                    expect(error.message).to_contain("planning work budget")
                    refused = true
                    break
        expect(admitted).to_be_greater_than(0)
        expect(admitted).to_be_less_than(16)
        expect(refused).to_equal(true)
