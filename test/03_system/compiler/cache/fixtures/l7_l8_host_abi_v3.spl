"""P08 writer/journal/selected-head recovery adapters.

These adapters bind the acceptance rows to the frozen host-ABI helper names.
The reconciliation base contains the V3 declarations, but no qualified
descriptor-bound provider is available to this lane. Every adapter therefore
fails closed with MissingEvidence; it never turns a copied DTO or model value
into writer, journal, selected-head, or recovery authority.
"""

use std.spec.{fail}

fn _missing_p08_v3(scenario_id: text, boundary: text):
    fail("MissingEvidence: " + scenario_id + " requires " + boundary +
        " from an issuer-bound descriptor provider")

pub fn setup_l7_l8_host_namespace_fixture_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "a real temporary root, descriptor set, writer receipt, and reader pin")

pub fn open_l7_l8_descriptor_fixture_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "opened selected-head and journal descriptors bound to one root")

pub fn inject_l7_l8_host_fault_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "provider-internal fault injection at the named syscall boundary")

pub fn run_l7_l8_guarded_publish_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "serialized journal append and selected-head publication authority")

pub fn capture_l7_l8_durable_recovery_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "fresh-process recovery capture retaining exact root descriptors")

pub fn check_l7_l8_exact_operation_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "operation/generation/manifest resolution from durable journal evidence")

pub fn check_l7_l8_current_head_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "selected-head and journal-prefix comparison from the live owner")

pub fn check_l7_l8_descriptor_binding_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "same-descriptor identity and parent-directory synchronization receipt")

pub fn collect_l7_l8_complete_root_union_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "complete reader, lease, explicit-pin, journal, and recovery root union")

pub fn check_l7_l8_protected_candidate_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "owner-issued protected candidate receipt before unlink")

pub fn check_l7_l8_scope_cleanup_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "retained recovery scope cleanup after finish, abort, or process death")

pub fn check_l7_l8_authority_refusal_v3(scenario_id: text):
    _missing_p08_v3(scenario_id,
        "fail-closed refusal of copied diagnostics and stale handles")
