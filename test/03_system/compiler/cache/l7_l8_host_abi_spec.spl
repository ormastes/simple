"""P08 writer, journal, selected-head, and recovery acceptance.

The seven P08 rows are bound to the frozen HABI manifest. They require one
issuer-bound descriptor provider spanning the existing journal, selected-head,
writer epoch, and recovery owners. Until that provider is qualified, the
fixture adapters fail with MissingEvidence; no model or copied receipt is
treated as publication authority.
"""
# codex-system-test
# @tag: in-development, system, compiler-cache, writer, journal, recovery
# @manual_section: P08 writer journal selected-head recovery
# @req REQ-CSM-007 REQ-CSM-008 REQ-CSM-009 REQ-CSM-012

use std.spec.{describe, it, step}
use test.system.compiler.cache.fixtures.l7_l8_host_abi_v3.{
    inject_l7_l8_host_fault_v3,
    run_l7_l8_guarded_publish_v3,
    capture_l7_l8_durable_recovery_v3,
    check_l7_l8_current_head_v3,
    check_l7_l8_descriptor_binding_v3,
    collect_l7_l8_complete_root_union_v3,
    check_l7_l8_authority_refusal_v3
}

describe "P08 writer/journal/selected-head recovery [importance=critical; importance_weight=3]":
    # @req REQ-CSM-007, REQ-CSM-008
    it "should bind journal and parent-directory sync to the opened descriptors [scenario=HABI-01] [importance=critical; importance_weight=3]":
        step("Sync the same opened immutable descriptor and its parent directory")
        check_l7_l8_descriptor_binding_v3("HABI-01")

    # @req REQ-CSM-007, REQ-CSM-008
    it "should make post-rename directory-sync failure unknown [scenario=HABI-02] [importance=critical; importance_weight=3]":
        step("Distinguish selected-head replacement from directory durability")
        inject_l7_l8_host_fault_v3("HABI-02")

    # @req REQ-CSM-008
    it "should compare expected old head separately from the target head [scenario=HABI-04] [importance=critical; importance_weight=3]":
        step("Compare the expected old head separately from the target head")
        check_l7_l8_current_head_v3("HABI-04")

    # @req REQ-CSM-009
    it "should report a competing head without attributing its publication [scenario=HABI-05] [importance=critical; importance_weight=3]":
        step("Report a competing head without attributing its publication to this attempt")
        run_l7_l8_guarded_publish_v3("HABI-05")

    # @req REQ-CSM-007, REQ-CSM-008, REQ-CSM-009
    it "should resolve the exact committed operation after lost acknowledgement [scenario=HABI-06] [importance=critical; importance_weight=3]":
        step("Recover the exact committed operation after cancellation or lost acknowledgement")
        capture_l7_l8_durable_recovery_v3("HABI-06")

    # @req REQ-CSM-007, REQ-CSM-008
    it "should keep pruned, torn, or ambiguous history unknown [scenario=HABI-07] [importance=critical; importance_weight=3]":
        step("Keep pruned or ambiguous durable history outcomes unknown")
        check_l7_l8_authority_refusal_v3("HABI-07")

    # @req REQ-CSM-009, REQ-CSM-012
    it "should retain protection across failed finish, abort, and handle reuse [scenario=HABI-09] [importance=critical; importance_weight=3]":
        step("Preserve scope ownership across failed finish abort and handle reuse")
        collect_l7_l8_complete_root_union_v3("HABI-09")
