# codex-system-test
# @manual: show
# @req: REQ-MC-007, C2
# Real MIR -> admitted declaration plan -> emitted body/module. All execution UNRUN.
use std.spec
use std.spec.step
use compiler.hir.hir_types.{SymbolId}
use compiler.common.attributes.{vhdl_hardware_metadata_default, DriverManifestAttr, DriverManifestAttrKind}
use compiler.common.diagnostics.span.{Span}
use compiler.mir.mir_instructions.{MirModule, MirFunction, MirBody, MirInst, MirInstKind, AggregateKind, MirBlock, BlockId, MirOperand, MirOperandKind, MirTerminator, MirBinOp, MirUnaryOp}
use compiler.mir.mir_types.{MirType, MirTypeKind, MirConstValue, MirTypeDef, MirTypeDefKind, MirFieldDef, MirVariantDef, MirSignature, MirLocal, LocalId, LocalKind}
use plugins.backend_lean.lean_backend.{LeanBackend, LeanBuilder, VerificationLevel}
use plugins.backend_lean.lean_type_declarations.{lean_plan_type_declarations}
use plugins.backend_lean.lean_nominal_body.{translate_mir_nominal_body}

fn ty(kind: MirTypeKind) -> MirType: MirType(kind: kind)
fn packet_ty() -> MirType: ty(MirTypeKind.Struct(SymbolId(id: 7)))
fn state_ty() -> MirType: ty(MirTypeKind.Enum(SymbolId(id: 9)))
fn copy(id: i64) -> MirOperand: MirOperand(kind: MirOperandKind.Copy(LocalId(id: id)))
fn local(id: i64, type_: MirType, kind: LocalKind) -> MirLocal:
    MirLocal(id: LocalId(id: id), name: nil, type_: type_, kind: kind, is_ghost: false)
fn inst(kind: MirInstKind) -> MirInst: MirInst(kind: kind, span: nil)
fn ret(id: i64) -> MirTerminator: MirTerminator.Ret(Some(copy(id)))

fn fixture_function(parameters: [MirType], locals: [MirLocal], instructions: [MirInst], return_type: MirType, terminator: MirTerminator) -> MirFunction:
    MirFunction(symbol: SymbolId(id: 20), name: "nominalValue",
        signature: MirSignature(params: parameters, return_type: return_type, is_variadic: false, params_known: true),
        locals: locals,
        blocks: [MirBlock(id: BlockId(id: 0), label: nil, instructions: instructions, terminator: terminator)],
        entry_block: BlockId(id: 0), span: Span.default(), generic_params: [], is_generic_template: false,
        specialization_of: nil, type_bindings: {}, layout_phase: nil, is_kernel: false, gpu_target: "", gpu_backend_order: "", is_export_c: false,
        export_name: "", has_driver_manifest_attr: false, driver_manifest_attr: DriverManifestAttr(kind: DriverManifestAttrKind.Driver, driver_class: 0, vendor: 0, device_ids: [], version: "", abi: ""),
        has_vhdl_metadata: false, vhdl_metadata: vhdl_hardware_metadata_default(), has_fast_math: false, unroll_factor: 0, pipeline_ii: 0, memory_banks: 0, verification_contract: nil)

fn fixture_module(function: MirFunction) -> MirModule:
    val packet = MirTypeDef(symbol: SymbolId(id: 7), name: "wire.Packet",
        kind: MirTypeDefKind.Struct([
            MirFieldDef(name: "byte", type_: ty(MirTypeKind.U8), offset: 0, has_bits_attr: false, bits_width: 0),
            MirFieldDef(name: "count", type_: ty(MirTypeKind.I32), offset: 4, has_bits_attr: false, bits_width: 0)]),
        is_export_c: false, export_name: "")
    val state = MirTypeDef(symbol: SymbolId(id: 9), name: "wire.State",
        kind: MirTypeDefKind.Enum([
            MirVariantDef(name: "Idle", discriminant: -3, payload: nil),
            MirVariantDef(name: "Packet", discriminant: 12, payload: Some(packet_ty()))]),
        is_export_c: false, export_name: "")
    var functions: Dict<SymbolId, MirFunction> = {}
    functions[function.symbol] = function
    var types: Dict<SymbolId, MirTypeDef> = {}
    types[packet.symbol] = packet
    types[state.symbol] = state
    MirModule(name: "NominalBody", functions: functions, statics: {}, constants: {}, types: types)

fn packet_function() -> MirFunction:
    fixture_function([ty(MirTypeKind.U8), ty(MirTypeKind.I32)],
        [local(0, ty(MirTypeKind.U8), LocalKind.Arg(0)), local(1, ty(MirTypeKind.I32), LocalKind.Arg(1)), local(2, packet_ty(), LocalKind.Temp)],
        [inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [copy(0), copy(1)]))], packet_ty(), ret(2))

fn enum_function(discriminant: i64, operands: [MirOperand]) -> MirFunction:
    fixture_function([packet_ty()], [local(0, packet_ty(), LocalKind.Arg(0)), local(1, state_ty(), LocalKind.Temp)],
        [inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Enum(SymbolId(id: 9), discriminant), operands))], state_ty(), ret(1))

fn emitted_body(function: MirFunction) -> text:
    val module = fixture_module(function)
    val context = lean_plan_type_declarations(module, "Simple.NominalBody").unwrap().context
    translate_mir_nominal_body(function, context).unwrap()

fn expect_refusal(function: MirFunction, reason: text):
    val module = fixture_module(function)
    val backend = LeanBackend.create(VerificationLevel.Contracts)
    match backend.export_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)
    match backend.export_generated_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)

fn scalar_function(input_type: MirType, output_type: MirType, operation: MirInst) -> MirFunction:
    fixture_function([input_type, input_type],
        [local(0, input_type, LocalKind.Arg(0)), local(1, input_type, LocalKind.Arg(1)),
         local(2, output_type, LocalKind.Temp), local(3, packet_ty(), LocalKind.Temp), local(4, output_type, LocalKind.Temp)],
        [operation, inst(MirInstKind.Aggregate(LocalId(id: 3), AggregateKind.Struct(SymbolId(id: 7)), [copy(2)])),
         inst(MirInstKind.GetField(LocalId(id: 4), copy(3), 0))], output_type, ret(4))

fn scalar_module(function: MirFunction, field_type: MirType) -> MirModule:
    var module = fixture_module(function)
    val definition = MirTypeDef(symbol: SymbolId(id: 7), name: "wire.Packet", kind: MirTypeDefKind.Struct([
        MirFieldDef(name: "scalar", type_: field_type, offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
    module.types[definition.symbol] = definition
    module

fn expect_scalar_body(module: MirModule, type_name: text, expression: text):
    val expected = "let _l2 : " + type_name + " := " + expression + "\n  let _l3 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l2)\n  let _l4 : " + type_name + " := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».«scalar» (_l3)\n  _l4"
    val backend = LeanBackend.create(VerificationLevel.Contracts)
    expect(backend.export_module(module).unwrap().lean_code).to_contain(expected)
    expect(backend.export_generated_module(module).unwrap().lean_code).to_contain(expected)

fn expect_scalar_refusal(module: MirModule, reason: text):
    val backend = LeanBackend.create(VerificationLevel.Contracts)
    match backend.export_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)
    match backend.export_generated_module(module):
        case Err(error): expect(error.message).to_contain(reason)
        case Ok(_): assert(false)

describe "typed nominal MIR body export":
    it "constructs a struct with exact field order and qualified type through both APIs":
        step("Construct and project admitted nominal values")
        val function = packet_function()
        val body = "let _l2 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l0) (_l1)\n_l2"
        expect(emitted_body(function)).to_equal(body)
        val declaration = "def nominalValue (_l0 : _root_.BitVec 8) (_l1 : _root_.BitVec 32) : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» :=\n  " + body.replace("\n", "\n  ")
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        expect(backend.export_module(fixture_module(function)).unwrap().lean_code).to_contain(declaration)
        expect(backend.export_generated_module(fixture_module(function)).unwrap().lean_code).to_contain(declaration)

    it "projects the declaration field index with exact signed MIR destination":
        var function = packet_function()
        function.locals.push(local(3, ty(MirTypeKind.I32), LocalKind.Temp))
        function.blocks[0].instructions.push(inst(MirInstKind.GetField(LocalId(id: 3), copy(2), 1)))
        function.blocks[0].terminator = ret(3)
        function.signature.return_type = ty(MirTypeKind.I32)
        val expected = "let _l2 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l0) (_l1)\nlet _l3 : _root_.BitVec 32 := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».«count» (_l2)\n_l3"
        expect(emitted_body(function)).to_equal(expected)
        expect(LeanBackend.create(VerificationLevel.Contracts).export_module(fixture_module(function)).is_ok()).to_equal(true)

    it "selects enum constructors by explicit discriminant rather than position":
        val expected = "let _l1 : _root_.Simple.NominalBody.__MirTypes.«wire».«State» := _root_.Simple.NominalBody.__MirTypes.«wire».«State».«Packet» (_l0)\n_l1"
        val function = enum_function(12, [copy(0)])
        expect(emitted_body(function)).to_equal(expected)
        expect(LeanBackend.create(VerificationLevel.Contracts).export_generated_module(fixture_module(function)).is_ok()).to_equal(true)
        expect_refusal(enum_function(1, [copy(0)]), "unknown enum discriminant 1")

    it "emits negative-discriminant nullary constructors without fabricated payloads":
        expect(emitted_body(enum_function(-3, []))).to_equal("let _l1 : _root_.Simple.NominalBody.__MirTypes.«wire».«State» := _root_.Simple.NominalBody.__MirTypes.«wire».«State».«Idle»\n_l1")

    it "rejects field arity mismatch":
        step("Reject mismatched aggregate evidence")
        var function = packet_function()
        function.blocks[0].instructions[0] = inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [copy(0)]))
        expect_refusal(function, "struct field arity mismatch")

    it "distinguishes signed and unsigned fields with equal Lean widths":
        var function = packet_function()
        function.locals[0].type_ = ty(MirTypeKind.I8)
        function.signature.params[0] = ty(MirTypeKind.I8)
        expect_refusal(function, "exact MIR type mismatch")

    it "rejects constructor destination with the wrong nominal owner":
        var function = packet_function()
        function.locals[2].type_ = state_ty()
        expect_refusal(function, "exact MIR type mismatch")

    it "rejects absent or excessive enum payloads":
        expect_refusal(enum_function(12, []), "enum payload arity mismatch")
        expect_refusal(enum_function(12, [copy(0), copy(0)]), "enum payload arity mismatch")
        expect_refusal(enum_function(-3, [copy(0)]), "nullary enum has operands")

    it "rejects enum payload with a different retained type":
        var function = enum_function(12, [copy(0)])
        function.locals[0].type_ = ty(MirTypeKind.U8)
        function.signature.params[0] = ty(MirTypeKind.U8)
        expect_refusal(function, "exact MIR type mismatch")

    it "rejects out-of-range field indexes and a wrong projection destination":
        for index in [-1, 2]:
            var function = packet_function()
            function.locals.push(local(3, ty(MirTypeKind.I32), LocalKind.Temp))
            function.blocks[0].instructions.push(inst(MirInstKind.GetField(LocalId(id: 3), copy(2), index)))
            expect_refusal(function, "struct field index out of range")
        var mismatch = packet_function()
        mismatch.locals.push(local(3, ty(MirTypeKind.U32), LocalKind.Temp))
        mismatch.blocks[0].instructions.push(inst(MirInstKind.GetField(LocalId(id: 3), copy(2), 1)))
        expect_refusal(mismatch, "exact MIR type mismatch")

    it "rejects field projection on an enum without a variant proof":
        var function = enum_function(-3, [])
        function.locals.push(local(2, ty(MirTypeKind.U8), LocalKind.Temp))
        function.blocks[0].instructions.push(inst(MirInstKind.GetField(LocalId(id: 2), copy(1), 0)))
        expect_refusal(function, "requires an admitted struct value")

    it "rejects an undefined or missing operand local":
        var function = packet_function()
        function.locals[0].kind = LocalKind.Temp
        function.signature.params = [ty(MirTypeKind.I32)]
        function.locals[1].kind = LocalKind.Arg(0)
        expect_refusal(function, "use before definition or after move")
        var missing = packet_function()
        missing.blocks[0].instructions[0] = inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [copy(88), copy(1)]))
        expect_refusal(missing, "missing local 88")

    it "rejects duplicate local identities and redefinitions":
        var duplicate = packet_function()
        duplicate.locals.push(local(2, packet_ty(), LocalKind.Temp))
        expect_refusal(duplicate, "duplicate local identity")
        var redefined = packet_function()
        redefined.blocks[0].instructions.push(inst(MirInstKind.Copy(LocalId(id: 2), LocalId(id: 2))))
        expect_refusal(redefined, "local redefinition")

    it "tracks move consumption through constructor operands":
        var function = packet_function()
        function.blocks[0].instructions[0] = inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [MirOperand(kind: MirOperandKind.Move(LocalId(id: 0))), copy(1)]))
        function.locals.push(local(3, ty(MirTypeKind.U8), LocalKind.Temp))
        function.blocks[0].instructions.push(inst(MirInstKind.Copy(LocalId(id: 3), LocalId(id: 0))))
        expect_refusal(function, "use before definition or after move: 0")

    it "checks the returned value against the retained signature":
        var function = packet_function()
        function.signature.return_type = ty(MirTypeKind.I32)
        expect_refusal(function, "exact MIR type mismatch")
        var missing = packet_function()
        missing.blocks[0].terminator = MirTerminator.Ret(nil)
        expect_refusal(missing, "exact MIR type mismatch")

    it "rejects unsupported control flow and entry disagreement":
        step("Preserve unsupported-state boundaries")
        var function = packet_function()
        function.blocks[0].terminator = MirTerminator.Goto(BlockId(id: 0))
        expect_refusal(function, "cyclic linear flow")
        var entry = packet_function()
        entry.entry_block = BlockId(id: 99)
        expect_refusal(entry, "missing entry block")
        var multiple = packet_function()
        multiple.blocks.push(MirBlock(id: BlockId(id: 1), label: nil, instructions: [], terminator: ret(2)))
        expect_refusal(multiple, "unvisited block outside nominal flow")

    it "refuses mutation mixed into an otherwise supported nominal body":
        var function = packet_function()
        function.blocks[0].instructions.push(inst(MirInstKind.SetField(copy(2), 0, copy(0))))
        expect_refusal(function, "unsupported instruction in pure nominal body")

    it "requires authoritative fixed arity and argument type agreement":
        var unknown = packet_function()
        unknown.signature.params_known = false
        expect_refusal(unknown, "known nonvariadic signature")
        var mismatch = packet_function()
        mismatch.signature.params[0] = ty(MirTypeKind.I8)
        expect_refusal(mismatch, "argument local disagrees with signature")

    it "constructs a nested nominal value and returns its typed projection":
        var function = fixture_function([packet_ty()],
            [local(0, packet_ty(), LocalKind.Arg(0)), local(1, ty(MirTypeKind.Struct(SymbolId(id: 11))), LocalKind.Temp), local(2, packet_ty(), LocalKind.Temp)],
            [inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 11)), [copy(0)])),
             inst(MirInstKind.GetField(LocalId(id: 2), copy(1), 0))], packet_ty(), ret(2))
        var module = fixture_module(function)
        val outer = MirTypeDef(symbol: SymbolId(id: 11), name: "wire.Outer", kind: MirTypeDefKind.Struct([
            MirFieldDef(name: "inner", type_: packet_ty(), offset: 0, has_bits_attr: false, bits_width: 0)]), is_export_c: false, export_name: "")
        module.types[outer.symbol] = outer
        val context = lean_plan_type_declarations(module, "Simple.NominalBody").unwrap().context
        val body = "let _l1 : _root_.Simple.NominalBody.__MirTypes.«wire».«Outer» := _root_.Simple.NominalBody.__MirTypes.«wire».«Outer».mk (_l0)\nlet _l2 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Outer».«inner» (_l1)\n_l2"
        expect(translate_mir_nominal_body(function, context).unwrap()).to_equal(body)
        expect(LeanBackend.create(VerificationLevel.Contracts).export_generated_module(module).unwrap().lean_code).to_contain(body.replace("\n", "\n  "))

    it "preserves constant values and live copies and moves before a unit return":
        val function = fixture_function([], [local(0, ty(MirTypeKind.U8), LocalKind.Temp), local(1, ty(MirTypeKind.I32), LocalKind.Temp),
                local(2, packet_ty(), LocalKind.Temp), local(3, packet_ty(), LocalKind.Temp), local(4, packet_ty(), LocalKind.Temp)],
            [inst(MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(255), ty(MirTypeKind.U8))),
             inst(MirInstKind.Const(LocalId(id: 1), MirConstValue.Int(-7), ty(MirTypeKind.I32))),
             inst(MirInstKind.Aggregate(LocalId(id: 2), AggregateKind.Struct(SymbolId(id: 7)), [copy(0), copy(1)])),
             inst(MirInstKind.Copy(LocalId(id: 3), LocalId(id: 2))), inst(MirInstKind.Move(LocalId(id: 4), LocalId(id: 3)))],
            ty(MirTypeKind.Unit), MirTerminator.Ret(nil))
        val expected = "let _l0 : _root_.BitVec 8 := (BitVec.ofInt 8 255)\nlet _l1 : _root_.BitVec 32 := (BitVec.ofInt 32 (-7))\nlet _l2 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».mk (_l0) (_l1)\nlet _l3 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _l2\nlet _l4 : _root_.Simple.NominalBody.__MirTypes.«wire».«Packet» := _l3\n()"
        expect(emitted_body(function)).to_equal(expected)
        expect(LeanBackend.create(VerificationLevel.Contracts).export_module(fixture_module(function)).unwrap().lean_code).to_contain(expected.replace("\n", "\n  "))

    it "constructs an empty struct without a fabricated unit field":
        val empty_type = ty(MirTypeKind.Struct(SymbolId(id: 13)))
        val function = fixture_function([], [local(0, empty_type, LocalKind.Temp)],
            [inst(MirInstKind.Aggregate(LocalId(id: 0), AggregateKind.Struct(SymbolId(id: 13)), []))], empty_type, ret(0))
        var module = fixture_module(function)
        val empty = MirTypeDef(symbol: SymbolId(id: 13), name: "wire.Empty", kind: MirTypeDefKind.Struct([]), is_export_c: false, export_name: "")
        module.types[empty.symbol] = empty
        val context = lean_plan_type_declarations(module, "Simple.NominalBody").unwrap().context
        val expected = "let _l0 : _root_.Simple.NominalBody.__MirTypes.«wire».«Empty» := _root_.Simple.NominalBody.__MirTypes.«wire».«Empty».mk\n_l0"
        expect(translate_mir_nominal_body(function, context).unwrap()).to_equal(expected)
        expect(LeanBackend.create(VerificationLevel.Contracts).export_module(module).unwrap().lean_code).to_contain(expected.replace("\n", "\n  "))

    it "indents every physical body line and preserves nested relative indentation":
        step("Preserve multiline target syntax at the actual builder boundary")
        var builder = LeanBuilder.create()
        builder.emit_def("nested", [("flag", "Bool")], "Bool", "let value := flag\nif value then\n  true\nelse\n  false")
        expect(builder.build()).to_equal("def nested (flag : Bool) : Bool :=\n  let value := flag\n  if value then\n    true\n  else\n    false")

    it "mixes every existing modular arithmetic and bitwise operator with nominal flow at all widths":
        step("Preserve typed scalar computation across aggregate construction and projection")
        val operators = [(MirBinOp.Add, "+"), (MirBinOp.Sub, "-"), (MirBinOp.Mul, "*"), (MirBinOp.BitAnd, "&&&"), (MirBinOp.BitOr, "|||"), (MirBinOp.BitXor, "^^^")]
        val types = [(MirTypeKind.I8, 8), (MirTypeKind.U8, 8), (MirTypeKind.I16, 16), (MirTypeKind.U16, 16), (MirTypeKind.I32, 32), (MirTypeKind.U32, 32), (MirTypeKind.I64, 64), (MirTypeKind.U64, 64)]
        for (kind, width) in types:
            for (operator, spelling) in operators:
                val type_ = ty(kind)
                val function = scalar_function(type_, type_, inst(MirInstKind.BinOp(LocalId(id: 2), operator, copy(0), copy(1))))
                expect_scalar_body(scalar_module(function, type_), "_root_.BitVec {width}", "(_l0) " + spelling + " (_l1)")

    it "produces Bool from exact scalar equality and inequality before nominal construction":
        val types = [MirTypeKind.I8, MirTypeKind.U8, MirTypeKind.I16, MirTypeKind.U16, MirTypeKind.I32, MirTypeKind.U32, MirTypeKind.I64, MirTypeKind.U64, MirTypeKind.Bool, MirTypeKind.Char, MirTypeKind.Unit]
        for kind in types:
            for (operator, spelling) in [(MirBinOp.Eq, "=="), (MirBinOp.Ne, "!=")]:
                val function = scalar_function(ty(kind), ty(MirTypeKind.Bool), inst(MirInstKind.BinOp(LocalId(id: 2), operator, copy(0), copy(1))))
                expect_scalar_body(scalar_module(function, ty(MirTypeKind.Bool)), "_root_.Bool", "(_l0) " + spelling + " (_l1)")

    it "preserves modular negation and complement and boolean negation":
        for (kind, width) in [(MirTypeKind.I8, 8), (MirTypeKind.U8, 8), (MirTypeKind.I16, 16), (MirTypeKind.U16, 16), (MirTypeKind.I32, 32), (MirTypeKind.U32, 32), (MirTypeKind.I64, 64), (MirTypeKind.U64, 64)]:
            for (operator, spelling) in [(MirUnaryOp.Neg, "-"), (MirUnaryOp.BitNot, "~~~")]:
                val type_ = ty(kind)
                val function = scalar_function(type_, type_, inst(MirInstKind.UnaryOp(LocalId(id: 2), operator, copy(0))))
                expect_scalar_body(scalar_module(function, type_), "_root_.BitVec {width}", spelling + "(_l0)")
        val bool_type = ty(MirTypeKind.Bool)
        val boolean = scalar_function(bool_type, bool_type, inst(MirInstKind.UnaryOp(LocalId(id: 2), MirUnaryOp.Not, copy(0))))
        expect_scalar_body(scalar_module(boolean, bool_type), "_root_.Bool", "!(_l0)")

    it "rejects operand signedness and operation result type disagreement":
        val byte = ty(MirTypeKind.U8)
        var mismatch = scalar_function(byte, byte, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, copy(0), copy(1))))
        mismatch.signature.params[1] = ty(MirTypeKind.I8)
        mismatch.locals[1].type_ = ty(MirTypeKind.I8)
        expect_scalar_refusal(scalar_module(mismatch, byte), "exact MIR type mismatch")
        val wrong_result = scalar_function(byte, byte, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Eq, copy(0), copy(1))))
        expect_scalar_refusal(scalar_module(wrong_result, byte), "exact MIR type mismatch")

    it "rejects operation and type combinations without the required representation":
        val bool_type = ty(MirTypeKind.Bool)
        val arithmetic = scalar_function(bool_type, bool_type, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, copy(0), copy(1))))
        expect_scalar_refusal(scalar_module(arithmetic, bool_type), "require a fixed-width integer")
        val negated = scalar_function(bool_type, bool_type, inst(MirInstKind.UnaryOp(LocalId(id: 2), MirUnaryOp.Neg, copy(0))))
        expect_scalar_refusal(scalar_module(negated, bool_type), "require a fixed-width integer")
        val byte = ty(MirTypeKind.U8)
        val not_integer = scalar_function(byte, byte, inst(MirInstKind.UnaryOp(LocalId(id: 2), MirUnaryOp.Not, copy(0))))
        expect_scalar_refusal(scalar_module(not_integer, byte), "exact MIR type mismatch")
        val nominal = scalar_function(packet_ty(), bool_type, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Eq, copy(0), copy(1))))
        expect_scalar_refusal(scalar_module(nominal, bool_type), "equality requires an admitted scalar")

    it "preserves existing refusal for signedness-sensitive division ordering powers and shifts":
        val type_ = ty(MirTypeKind.I32)
        for operator in [MirBinOp.Div, MirBinOp.Rem, MirBinOp.Pow, MirBinOp.Lt, MirBinOp.Le, MirBinOp.Gt, MirBinOp.Ge, MirBinOp.Shl, MirBinOp.Shr]:
            val function = scalar_function(type_, type_, inst(MirInstKind.BinOp(LocalId(id: 2), operator, copy(0), copy(1))))
            expect_scalar_refusal(scalar_module(function, type_), "requires")

    it "tracks operand moves before the second operand and rejects result redefinition":
        val byte = ty(MirTypeKind.U8)
        val consumed = scalar_function(byte, byte, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, MirOperand(kind: MirOperandKind.Move(LocalId(id: 0))), copy(0))))
        expect_scalar_refusal(scalar_module(consumed, byte), "after move: 0")
        var duplicate = scalar_function(byte, byte, inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, copy(0), copy(1))))
        duplicate.blocks[0].instructions.push(inst(MirInstKind.UnaryOp(LocalId(id: 2), MirUnaryOp.BitNot, copy(4))))
        expect_scalar_refusal(scalar_module(duplicate, byte), "local redefinition")

    it "preserves the original scalar-only translator through actual module APIs":
        val byte = ty(MirTypeKind.U8)
        val function = fixture_function([byte, byte], [local(0, byte, LocalKind.Arg(0)), local(1, byte, LocalKind.Arg(1)), local(2, byte, LocalKind.Temp)],
            [inst(MirInstKind.BinOp(LocalId(id: 2), MirBinOp.Add, copy(0), copy(1)))], byte, ret(2))
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val expected = "def nominalValue (_l0 : _root_.BitVec 8) (_l1 : _root_.BitVec 8) : _root_.BitVec 8 :=\n  let _l2 := _l0 + _l1\n  _l2"
        expect(backend.export_module(fixture_module(function)).unwrap().lean_code).to_contain(expected)
        expect(backend.export_generated_module(fixture_module(function)).unwrap().lean_code).to_contain(expected)

    it "preserves semantic Unicode scalar arguments through nominal construction and projection":
        step("Export typed Char values without asserting a physical character layout")
        val char_type = ty(MirTypeKind.Char)
        val function = fixture_function([char_type],
            [local(0, char_type, LocalKind.Arg(0)), local(1, packet_ty(), LocalKind.Temp), local(2, char_type, LocalKind.Temp)],
            [inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 7)), [copy(0)])),
             inst(MirInstKind.GetField(LocalId(id: 2), copy(1), 0))], char_type, ret(2))
        val module = scalar_module(function, char_type)
        val backend = LeanBackend.create(VerificationLevel.Contracts)
        val full = backend.export_module(module).unwrap().lean_code
        val generated = backend.export_generated_module(module).unwrap().lean_code
        val signature = "def nominalValue (_l0 : _root_.Char) : _root_.Char :="
        val projection = "let _l2 : _root_.Char := _root_.Simple.NominalBody.__MirTypes.«wire».«Packet».«scalar» (_l1)"
        expect(full).to_contain(signature)
        expect(generated).to_contain(signature)
        expect(full).to_contain(projection)
        expect(generated).to_contain(projection)

    it "refuses integer Char constants including invalid scalars without a representation adapter":
        step("Keep unsupported MIR integer-to-Char semantics fail closed in both module APIs")
        for value in [-1, 55296, 57343, 1114112, 65, 128512]:
            val char_type = ty(MirTypeKind.Char)
            val function = fixture_function([], [local(0, char_type, LocalKind.Temp), local(1, packet_ty(), LocalKind.Temp)],
                [inst(MirInstKind.Const(LocalId(id: 0), MirConstValue.Int(value), char_type)),
                 inst(MirInstKind.Aggregate(LocalId(id: 1), AggregateKind.Struct(SymbolId(id: 7)), [copy(0)]))], packet_ty(), ret(1))
            expect_scalar_refusal(scalar_module(function, char_type), "integer constant requires an exact fixed-width MIR integer type")

    it "counts only validated unique argument rows before admitting a nominal body":
        step("Reject missing, repeated and out-of-range argument indices in the real body owner")
        for malformed_kind in [0, 1, 2]:
            var function = packet_function()
            if malformed_kind == 0:
                function.locals[1].kind = LocalKind.Temp
            elif malformed_kind == 1:
                function.locals[1].kind = LocalKind.Arg(0)
            else:
                function.locals[1].kind = LocalKind.Arg(2)
            val module = fixture_module(function)
            val context = lean_plan_type_declarations(module, "Simple.NominalBody").unwrap().context
            match translate_mir_nominal_body(function, context):
                case Err(error):
                    if malformed_kind == 0:
                        expect(error.message).to_contain("missing argument local")
                    else:
                        expect(error.message).to_contain("invalid or duplicate argument index")
                case Ok(_): assert(false)
            val backend = LeanBackend.create(VerificationLevel.Contracts)
            expect(backend.export_module(module).is_err()).to_equal(true)
            expect(backend.export_generated_module(module).is_err()).to_equal(true)
