# codex-system-test
"""REQ-BST-META-001: staged-native metadata copy keeps aggregates owner-local."""
extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

fn prepare_scalar_metadata_copy() -> (text, text, i64):
    rt_process_run("sh", ["scripts/check/check-native-scalar-metadata-copy.shs"])

val _metadata_gate = prepare_scalar_metadata_copy()

describe "REQ-BST-META-001: scalar metadata transport":
    it "should append metadata without an aggregate ABI argument":
        step("Copy aggregate metadata using scalar source and destination IDs")
        expect(_metadata_gate.2).to_equal(0)
        expect(_metadata_gate.0).to_contain("source=pass append=pass")

    it "should update aligned metadata and ignore missing sources":
        step("Update existing metadata and fail closed on an unknown source ID")
        expect(_metadata_gate.0).to_contain("update=pass missing-source=pass")

    it "should require a native pure-Simple candidate":
        step("Reject seed, compile failure, missing executable, and wrong output")
        expect(_metadata_gate.1).to_equal("")
        expect(_metadata_gate.0.contains("STATUS: FAIL")).to_equal(false)
