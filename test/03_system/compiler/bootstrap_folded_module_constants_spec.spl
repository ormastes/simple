# @cover src/app/cli/bootstrap_main.spl 0%
# codex-system-test
# @req bootstrap_stage3_folded_module_const_type_2026_08_14
use std.spec.*

extern fn rt_process_run(program: text, args: [text]) -> (text, text, i64)

describe "bootstrap folded module constants through a pure-Simple native compiler":
    it "compiles and executes the exact inferred scalar and binary matrix":
        val (out, err, code) = rt_process_run("sh", [
            "scripts/check/check-bootstrap-folded-module-constants.shs"
        ])
        expect(code).to_equal(0)
        expect(err).to_equal("")
        expect(out).to_contain("STATUS: PASS folded-module-constants")
        expect(out).to_contain("int,zero,float,bool,text,binary")

    it "fails closed instead of accepting a Rust seed as Stage 4 evidence":
        val (out, _err, code) = rt_process_run("sh", [
            "scripts/check/check-bootstrap-folded-module-constants.shs"
        ])
        if code == 2:
            expect(out).to_contain("reason=rust-seed-forbidden")
        else:
            expect(code).to_equal(0)
